{
  "name": "zena-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "test:quick": "./target/release/zena-cli test",
    "format": "npm run format:fix",
    "format:check": "prettier \"**/*.{cjs,html,js,json,md,ts}\" --check",
    "format:fix": "prettier \"**/*.{cjs,html,js,json,md,ts}\" --write",
    "ignore-sync": "ignore-sync .",
    "build:website": "npm run build -w @zena-lang/website",
    "serve:website": "npm run serve -w @zena-lang/website",
    "wasmtime:build": "./scripts/wasmtime-run.sh",
    "demo:cloudflare:build": "npm run zena -w @zena-lang/zena-cli -- build ../../examples/cloudflare-worker/hello.zena -o ../../examples/cloudflare-worker/hello.wasm --target js",
    "sloc": "./scripts/count-lines.sh",
    "bench": "./target/release/zena-cli run --allow-spawn --dir .::. benchmarks/zena/run.zena",
    "bench:build": "./target/release/zena-cli run --allow-spawn --dir .::. benchmarks/zena/build.zena",
    "bench:size": "./target/release/zena-cli run --allow-spawn --dir .::. benchmarks/zena/size.zena",
    "bench:speed": "./target/release/zena-cli run --allow-spawn --dir .::. benchmarks/zena/run.zena -- --speed",
    "bench:compile": "ZENA_TIME_JSON=1 ./target/release/zena-cli run --allow-spawn --dir .::. benchmarks/zena/compile.zena",
    "test:smoke": "wireit",
    "test:others": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "./packages/codemirror:build",
        "./packages/language-service:build",
        "./packages/playground:build",
        "./packages/runtime:build",
        "./packages/stdlib:build",
        "./packages/vscode-zena:build",
        "./packages/website:build",
        "./packages/website-client:build",
        "./packages/zena-cli:build",
        "./packages/zena-compiler:build",
        "./packages/zena-run:build",
        "./packages/zenafx:build"
      ]
    },
    "test": {
      "#": "The gate, and what CI runs: every package's tests, the compiler's fixpoint check included.",
      "dependencies": [
        "test:others",
        "./packages/zena-compiler:test"
      ]
    },
    "test:smoke": {
      "#": "Everything except the fixpoint check (stage B, then stage C, then a byte comparison), which is two compiler builds and the longest chain in a cold run. It catches the compiler miscompiling itself, which nothing else can see, so `npm test` keeps it and CI runs that on every PR \u2014 the window for finding such a bug stays one commit wide. This target is for the local loop, where paying it on every run is what hurts. See docs/design/bootstrapping.md, \"The invariant\".",
      "dependencies": [
        "test:others",
        "./packages/zena-compiler:test:smoke"
      ]
    },
    "test:others": {
      "#": "Every package but the compiler, so `test` and `test:smoke` differ only in which of the compiler's aggregates they name.",
      "dependencies": [
        "./packages/language-service:test",
        "./packages/playground:test",
        "./packages/runtime:test",
        "./packages/stdlib:test",
        "./packages/wit-parser:test",
        "./packages/website:test",
        "./packages/workflow:test",
        "./packages/zb:test",
        "./packages/zena-cli:test",
        "./packages/zena-formatter:test",
        "./packages/zena-run:test",
        "./packages/zenadoc:test",
        "./packages/zenafx:test"
      ]
    }
  },
  "devDependencies": {
    "assemblyscript": "^0.28.20",
    "ignore-sync": "^8.0.0",
    "prettier": "^3.6.2",
    "wireit": "^0.14.12"
  }
}
