{
  "name": "zena-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:quick": "./target/release/zena test",
    "check": "node scripts/check.js",
    "generate:logos": "node scripts/generate-logos.js",
    "versions": "./target/release/zena run --dir . packages/cli/dev/versions.zena",
    "changes": "./target/release/zena run --allow-spawn --dir . packages/changes/bin/changes.zena",
    "skill": "./target/release/zena run --dir . packages/cli/dev/sync-skill.zena",
    "watch-prs": "node scripts/watch-prs.js",
    "worktrees": "node scripts/worktrees.js",
    "prepare": "git config core.hooksPath scripts/git-hooks || true",
    "format": "npm run format:fix",
    "format:check": "prettier \"**/*.{cjs,html,js,json,md,ts}\" --check",
    "format:fix": "prettier \"**/*.{cjs,html,js,json,md,ts}\" --write",
    "ignore-sync": "ignore-sync .",
    "wasmtime:build": "./scripts/wasmtime-run.sh",
    "demo:cloudflare:build": "./target/release/zena build examples/cloudflare-worker/hello.zena -o examples/cloudflare-worker/hello.wasm --target zena-js",
    "sloc": "./scripts/count-lines.sh",
    "bench": "./target/release/zena run --allow-spawn --dir .::. benchmarks/zena/run.zena",
    "bench:build": "./target/release/zena run --allow-spawn --dir .::. benchmarks/zena/build.zena",
    "bench:size": "./target/release/zena run --allow-spawn --dir .::. benchmarks/zena/size.zena",
    "bench:speed": "./target/release/zena run --allow-spawn --dir .::. benchmarks/zena/run.zena -- --speed",
    "bench:compile": "ZENA_TIME_JSON=1 ./target/release/zena run --allow-spawn --dir .::. benchmarks/zena/compile.zena"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "assemblyscript": "^0.28.20",
    "ignore-sync": "^8.0.0",
    "prettier": "^3.6.2"
  }
}
