import { console } from 'zena:console';
import { getPreopens } from 'zena:fs';

export let main = (): i32 => {
  let preopens = getPreopens();
  for (var i = 0; i < preopens.length; i += 1) {
    let (descriptor, path) = preopens[i];
    console.log("Preopen mapped to OS: " + path);
  }
  return 0;
};
