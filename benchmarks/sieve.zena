// Sieve of Eratosthenes over a GC-backed array: allocation + repeated
// indexed reads/writes. The milestone uses core-wasm linear memory for the
// same algorithm — the substrate differs on purpose; a milestone is a
// frozen reference point, not an apples-to-apples codegen twin.
import { FixedArray } from 'zena:fixed-array';

export let main = (): i32 => {
  let n = 300000;
  let composite = new FixedArray<boolean>(n + 1, false);
  var count = 0;
  var i = 2;
  while (i <= n) {
    if (!composite[i]) {
      count += 1;
      var j = i + i;
      while (j <= n) {
        composite[j] = true;
        j += i;
      }
    }
    i += 1;
  }
  // 25997 primes below 300000; fold to a stable small exit code.
  return count % 256;
};
