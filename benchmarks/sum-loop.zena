// Iterative arithmetic loop: branch + integer codegen quality, no calls,
// no allocation. Matches milestones/sum-loop.wat and sum-loop-node.js.
export let main = (): i32 => {
  var sum = 0;
  var i = 0;
  while (i < 5000000) {
    if (i % 3 == 0) {
      sum += i % 7;
    } else {
      sum -= i % 5;
    }
    i += 1;
  }
  // Fold to a small stable exit code so all three variants can assert
  // the same value: sum for this loop is known and fixed.
  return sum % 256;
};
