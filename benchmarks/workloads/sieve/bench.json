{
  "suite": "sieve",
  "options": {
    "minSamples": 50,
    "extraSamples": 10,
    "warmupRuns": 5,
    "timeBudgetMs": 120000,
    "horizons": ["0%"]
  },
  "variants": [
    {"name": "zena", "wasm": "../../out/sieve/zena.wasm"},
    {"name": "asc-size", "wasm": "../../out/sieve/asc-size.wasm"},
    {"name": "asc-speed", "wasm": "../../out/sieve/asc-speed.wasm"},
    {"name": "rust-nostd", "wasm": "../../out/sieve/rust-nostd.wasm"},
    {"name": "rust-std", "wasm": "../../out/sieve/rust-std.wasm"},
    {"name": "milestone-wat", "wat": "milestones/sieve.wat"},
    {"name": "node", "command": ["node", "main-node.js"]}
  ]
}
