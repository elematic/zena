// Baseline for `record-ctor`: the same class and loop, constructed
// positionally with default parameters, so the only allocation per
// iteration is the node itself.

final class Node {
  kind: i32;
  left: Node | null;
  right: Node | null;
  weight: i32;
  depth: i32;
  flagged: boolean;
  label: String | null;

  new(
    this.kind,
    this.left,
    this.right,
    this.weight = 0,
    this.depth = 0,
    this.flagged = false,
    this.label = null);
}

export function main(): i32 {
  var last: Node | null = null;
  var total = 0;
  var i = 0;
  while (i < 2000000) {
    let n = new Node(i & 7, last, null, i);
    total = total + n.kind + n.weight - n.depth;
    last = n;
    i += 1;
  }
  return total & 0xFFFF;
}
