// The zip-protocol workload written as one index loop by hand: same
// arrays, same arithmetic, no iterators. zip-protocol compares itself
// against this build.
export function main(): i32 {
  let xs = new FixedArray<i32>(1024, 0);
  let ys = new FixedArray<i32>(1024, 0);
  var i = 0;
  while (i < 1024) {
    xs[i] = i;
    ys[i] = 1024 - i;
    i += 1;
  }
  var total = 0;
  var round = 0;
  while (round < 4000) {
    var sum = 0;
    var j = 0;
    while (j < 1024) {
      sum = (sum + xs[j] * ys[j] + round) & 16777215;
      j += 1;
    }
    total = (total + sum) & 16777215;
    round += 1;
  }
  return total & 255;
}
