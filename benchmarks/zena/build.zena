/**
 * Cross-language Wasm Benchmark Builder in Zena.
 *
 * Discovers workloads in `benchmarks/workloads/` and compiles them across
 * Zena, AssemblyScript, and Rust into `benchmarks/out/<workload>/<variant>.wasm`.
 */

import { getArguments } from 'zena:cli';
import { exists, mkdir } from 'zena:fs';
import { run } from 'zena:process';

let workloads = [
  'minimal',
  'hello-world',
  'array-sum',
  'fib',
  'sum-loop',
  'sieve',
  'map-fusion',
  'map-loop',
  'iter-protocol',
  'iter-loop',
  'zip-protocol',
  'zip-loop',
  'iface-param',
  'concrete-param',
  'immutable-param',
  'generic-param',
  'poly-param',
  'iface-test-anyref',
  'iface-test-anyref-many',
  'iface-test-class',
  'iface-test-chain',
];

async function ensureDir(path: String) {
  if (!await exists(path)) {
    await mkdir(path);
  }
}

async function execCommand(cmd: GrowableArray<String>, desc: String): Future<boolean> {
  let res = await run(cmd);
  if (res.exitCode != 0) {
    console.error(`❌ [FAILED] ${desc}`);
    if (res.stderr.length > 0) {
      console.error(res.stderr);
    }
    if (res.stdout.length > 0) {
      console.error(res.stdout);
    }
    return false;
  }
  console.log(`  ✓ ${desc}`);
  return true;
}

async function buildZena(workload: String): Future<boolean> {
  let src = `benchmarks/workloads/${workload}/main.zena`;
  let out = `benchmarks/out/${workload}/zena.wasm`;
  if (!await exists(src)) {
    return true;
  }
  let argv = new GrowableArray<String>();
  argv.push('./target/release/zena-cli');
  // Benchmarks measure the optimizing build (docs/design/optimization-pipeline.md).
  argv.push('-O2');
  argv.push('build');
  // A core module with nothing beneath it, like the AssemblyScript and
  // Rust builds it is compared with.
  argv.push('--target');
  argv.push('freestanding');
  argv.push(src);
  argv.push('-o');
  argv.push(out);
  return await execCommand(argv, `${workload}: Zena -> ${out}`);
}

async function buildAscSize(workload: String): Future<boolean> {
  let src = `benchmarks/workloads/${workload}/main.as.ts`;
  let out = `benchmarks/out/${workload}/asc-size.wasm`;
  if (!await exists(src)) {
    return true;
  }
  let argv = new GrowableArray<String>();
  argv.push('./node_modules/.bin/asc');
  argv.push(src);
  argv.push('-o');
  argv.push(out);
  argv.push('-O3z');
  argv.push('--runtime');
  argv.push('stub');
  argv.push('--converge');
  return await execCommand(argv, `${workload}: AssemblyScript (size) -> ${out}`);
}

async function buildAscSpeed(workload: String): Future<boolean> {
  let src = `benchmarks/workloads/${workload}/main.as.ts`;
  let out = `benchmarks/out/${workload}/asc-speed.wasm`;
  if (!await exists(src)) {
    return true;
  }
  let argv = new GrowableArray<String>();
  argv.push('./node_modules/.bin/asc');
  argv.push(src);
  argv.push('-o');
  argv.push(out);
  argv.push('-O3');
  argv.push('--runtime');
  argv.push('incremental');
  return await execCommand(argv, `${workload}: AssemblyScript (speed) -> ${out}`);
}

async function buildRustNostd(workload: String): Future<boolean> {
  var src = `benchmarks/workloads/${workload}/main_nostd.rs`;
  if (!await exists(src)) {
    src = `benchmarks/workloads/${workload}/main.rs`;
  }
  let out = `benchmarks/out/${workload}/rust-nostd.wasm`;
  if (!await exists(src)) {
    return true;
  }
  let argv = new GrowableArray<String>();
  argv.push('rustc');
  argv.push('--target');
  argv.push('wasm32-unknown-unknown');
  argv.push('--crate-type');
  argv.push('cdylib');
  argv.push('-C');
  argv.push('opt-level=z');
  argv.push('-C');
  argv.push('lto=fat');
  argv.push('-C');
  argv.push('panic=abort');
  argv.push('-C');
  argv.push('codegen-units=1');
  argv.push('-C');
  argv.push('strip=symbols');
  argv.push(src);
  argv.push('-o');
  argv.push(out);
  return await execCommand(argv, `${workload}: Rust (nostd) -> ${out}`);
}

async function buildRustStd(workload: String): Future<boolean> {
  var src = `benchmarks/workloads/${workload}/main_std.rs`;
  if (!await exists(src)) {
    src = `benchmarks/workloads/${workload}/main.rs`;
  }
  let out = `benchmarks/out/${workload}/rust-std.wasm`;
  if (!await exists(src)) {
    return true;
  }
  let argv = new GrowableArray<String>();
  argv.push('rustc');
  argv.push('--target');
  argv.push('wasm32-unknown-unknown');
  argv.push('--crate-type');
  argv.push('cdylib');
  argv.push('-C');
  argv.push('opt-level=z');
  argv.push('-C');
  argv.push('lto=fat');
  argv.push('-C');
  argv.push('panic=abort');
  argv.push('-C');
  argv.push('codegen-units=1');
  argv.push('-C');
  argv.push('strip=symbols');
  argv.push(src);
  argv.push('-o');
  argv.push(out);
  return await execCommand(argv, `${workload}: Rust (std) -> ${out}`);
}

async function buildWatMilestone(workload: String): Future<boolean> {
  let src = `benchmarks/workloads/${workload}/milestones/${workload}.wat`;
  let out = `benchmarks/out/${workload}/milestone.wasm`;
  if (!await exists(src)) {
    return true;
  }
  let argv = new GrowableArray<String>();
  argv.push('wasm-tools');
  argv.push('parse');
  argv.push(src);
  argv.push('-o');
  argv.push(out);
  return await execCommand(argv, `${workload}: WAT milestone -> ${out}`);
}

export async function main(): Future<i32> {
  console.log('=== Building Cross-Language Wasm Benchmarks ===\n');

  await ensureDir('benchmarks/out');

  let args = getArguments();
  let targetWorkloads = new GrowableArray<String>();
  if (args.length > 1) {
    var i = 1;
    while (i < args.length) {
      targetWorkloads.push(args[i]);
      i += 1;
    }
  } else {
    for (let w in workloads) {
      targetWorkloads.push(w);
    }
  }

  var failures = 0;

  for (let workload in targetWorkloads) {
    console.log(`Building workload [${workload}]...`);
    await ensureDir(`benchmarks/out/${workload}`);

    if (!await buildZena(workload)) { failures += 1; }
    if (!await buildAscSize(workload)) { failures += 1; }
    if (!await buildAscSpeed(workload)) { failures += 1; }
    if (!await buildRustNostd(workload)) { failures += 1; }
    if (!await buildRustStd(workload)) { failures += 1; }
    if (!await buildWatMilestone(workload)) { failures += 1; }

    console.log('');
  }

  if (failures > 0) {
    console.error(`\nBuild completed with ${failures} failure(s).`);
    return 1;
  }

  console.log('All benchmark binaries built successfully into benchmarks/out/!');
  return 0;
}
