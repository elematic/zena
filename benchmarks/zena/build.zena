/**
 * Cross-language Wasm Benchmark Builder in Zena.
 *
 * Discovers workloads in `benchmarks/workloads/` and compiles them across
 * Zena, AssemblyScript, and Rust into `benchmarks/out/<workload>/<variant>.wasm`.
 */

import { getArguments, exit } from 'zena:cli';
import { existsSync, mkdirSync } from 'zena:fs';
import { run } from 'zena:process';

let workloads = [
  'minimal',
  'hello-world',
  'array-sum',
  'fib',
  'sum-loop',
  'sieve',
  'map-fusion',
  'map-loop',
  'iter-protocol',
  'iter-loop',
  'iface-param',
  'concrete-param',
  'immutable-param',
  'generic-param',
  'poly-param',
];

function ensureDir(path: String) {
  if (!existsSync(path)) {
    mkdirSync(path);
  }
}

function execCommand(cmd: GrowableArray<String>, desc: String): boolean {
  let res = run(cmd);
  if (res.exitCode != 0) {
    console.error(`❌ [FAILED] ${desc}`);
    if (res.stderr.length > 0) {
      console.error(res.stderr);
    }
    if (res.stdout.length > 0) {
      console.error(res.stdout);
    }
    return false;
  }
  console.log(`  ✓ ${desc}`);
  return true;
}

function buildZena(workload: String): boolean {
  let src = `benchmarks/workloads/${workload}/main.zena`;
  let out = `benchmarks/out/${workload}/zena.wasm`;
  if (!existsSync(src)) {
    return true;
  }
  let argv = new GrowableArray<String>();
  argv.push('./target/release/zena-cli');
  // Benchmarks measure the optimizing build (docs/design/optimization-pipeline.md).
  argv.push('-O2');
  argv.push('build');
  // A core module with nothing beneath it, like the AssemblyScript and
  // Rust builds it is compared with.
  argv.push('--target');
  argv.push('freestanding');
  argv.push(src);
  argv.push('-o');
  argv.push(out);
  return execCommand(argv, `${workload}: Zena -> ${out}`);
}

function buildAscSize(workload: String): boolean {
  let src = `benchmarks/workloads/${workload}/main.as.ts`;
  let out = `benchmarks/out/${workload}/asc-size.wasm`;
  if (!existsSync(src)) {
    return true;
  }
  let argv = new GrowableArray<String>();
  argv.push('./node_modules/.bin/asc');
  argv.push(src);
  argv.push('-o');
  argv.push(out);
  argv.push('-O3z');
  argv.push('--runtime');
  argv.push('stub');
  argv.push('--converge');
  return execCommand(argv, `${workload}: AssemblyScript (size) -> ${out}`);
}

function buildAscSpeed(workload: String): boolean {
  let src = `benchmarks/workloads/${workload}/main.as.ts`;
  let out = `benchmarks/out/${workload}/asc-speed.wasm`;
  if (!existsSync(src)) {
    return true;
  }
  let argv = new GrowableArray<String>();
  argv.push('./node_modules/.bin/asc');
  argv.push(src);
  argv.push('-o');
  argv.push(out);
  argv.push('-O3');
  argv.push('--runtime');
  argv.push('incremental');
  return execCommand(argv, `${workload}: AssemblyScript (speed) -> ${out}`);
}

function buildRustNostd(workload: String): boolean {
  var src = `benchmarks/workloads/${workload}/main_nostd.rs`;
  if (!existsSync(src)) {
    src = `benchmarks/workloads/${workload}/main.rs`;
  }
  let out = `benchmarks/out/${workload}/rust-nostd.wasm`;
  if (!existsSync(src)) {
    return true;
  }
  let argv = new GrowableArray<String>();
  argv.push('rustc');
  argv.push('--target');
  argv.push('wasm32-unknown-unknown');
  argv.push('--crate-type');
  argv.push('cdylib');
  argv.push('-C');
  argv.push('opt-level=z');
  argv.push('-C');
  argv.push('lto=fat');
  argv.push('-C');
  argv.push('panic=abort');
  argv.push('-C');
  argv.push('codegen-units=1');
  argv.push('-C');
  argv.push('strip=symbols');
  argv.push(src);
  argv.push('-o');
  argv.push(out);
  return execCommand(argv, `${workload}: Rust (nostd) -> ${out}`);
}

function buildRustStd(workload: String): boolean {
  var src = `benchmarks/workloads/${workload}/main_std.rs`;
  if (!existsSync(src)) {
    src = `benchmarks/workloads/${workload}/main.rs`;
  }
  let out = `benchmarks/out/${workload}/rust-std.wasm`;
  if (!existsSync(src)) {
    return true;
  }
  let argv = new GrowableArray<String>();
  argv.push('rustc');
  argv.push('--target');
  argv.push('wasm32-unknown-unknown');
  argv.push('--crate-type');
  argv.push('cdylib');
  argv.push('-C');
  argv.push('opt-level=z');
  argv.push('-C');
  argv.push('lto=fat');
  argv.push('-C');
  argv.push('panic=abort');
  argv.push('-C');
  argv.push('codegen-units=1');
  argv.push('-C');
  argv.push('strip=symbols');
  argv.push(src);
  argv.push('-o');
  argv.push(out);
  return execCommand(argv, `${workload}: Rust (std) -> ${out}`);
}

function buildWatMilestone(workload: String): boolean {
  let src = `benchmarks/workloads/${workload}/milestones/${workload}.wat`;
  let out = `benchmarks/out/${workload}/milestone.wasm`;
  if (!existsSync(src)) {
    return true;
  }
  let argv = new GrowableArray<String>();
  argv.push('wasm-tools');
  argv.push('parse');
  argv.push(src);
  argv.push('-o');
  argv.push(out);
  return execCommand(argv, `${workload}: WAT milestone -> ${out}`);
}

export function main(): i32 {
  console.log('=== Building Cross-Language Wasm Benchmarks ===\n');

  ensureDir('benchmarks/out');

  let args = getArguments();
  let targetWorkloads = new GrowableArray<String>();
  if (args.length > 1) {
    var i = 1;
    while (i < args.length) {
      targetWorkloads.push(args[i]);
      i += 1;
    }
  } else {
    for (let w in workloads) {
      targetWorkloads.push(w);
    }
  }

  var failures = 0;

  for (let workload in targetWorkloads) {
    console.log(`Building workload [${workload}]...`);
    ensureDir(`benchmarks/out/${workload}`);

    if (!buildZena(workload)) { failures += 1; }
    if (!buildAscSize(workload)) { failures += 1; }
    if (!buildAscSpeed(workload)) { failures += 1; }
    if (!buildRustNostd(workload)) { failures += 1; }
    if (!buildRustStd(workload)) { failures += 1; }
    if (!buildWatMilestone(workload)) { failures += 1; }

    console.log('');
  }

  if (failures > 0) {
    console.error(`\nBuild completed with ${failures} failure(s).`);
    return 1;
  }

  console.log('All benchmark binaries built successfully into benchmarks/out/!');
  return 0;
}
