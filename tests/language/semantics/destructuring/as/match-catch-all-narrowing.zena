// @mode: check
// A catch-all case arm narrows the binding to the remaining type after
// earlier cases have been subtracted.

class Box {
  value: i32;
  new(this.value);
}

// After `case null:`, `b` should be narrowed to `Box`, not `Box | null`.
let unwrap = (x: Box | null): i32 => match (x) {
  case null: 0
  case let b: b.value
};

// Same with a String | null union.
let orEmpty = (s: String | null): String => match (s) {
  case null: ''
  case let s: s
};
