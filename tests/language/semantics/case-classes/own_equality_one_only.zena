// @mode: check
// A case class that writes its own `operator ==` or `hashCode()` writes
// both: deriving the other beside it would let equal values hash apart.

class OnlyEq(x: i32, y: i32) {
  operator ==(other: OnlyEq): boolean { // @error: declares 'operator ==' without 'hashCode()'
    return this.x == other.x;
  }
}

class OnlyHash(x: i32, y: i32) {
  hashCode(): i32 { // @error: declares 'hashCode()' without 'operator =='
    return this.x;
  }
}

class Both(x: i32, y: i32) {
  operator ==(other: Both): boolean {
    return this.x == other.x;
  }

  hashCode(): i32 {
    return this.x;
  }
}
