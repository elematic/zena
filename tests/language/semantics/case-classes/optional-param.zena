// @mode: check

class Person(name: String, email: String? = null, role: String = "user")

let p1 = new Person("Alice", "alice@example.com");
let p2 = new Person("Bob");

// @error: Type mismatch: 'String?' is not assignable to 'String'.
let a: String = p1.email;
let b: String | null = p1.email;
let n: String = p1.name;
let r: String = p2.role;

let p3 = new Person(); // @error: Expected 1-3 arguments

class BadDefault(name: String, count: i32 = "nope") // @error: Type mismatch: default value of type 'String' is not assignable to parameter type 'i32'.
