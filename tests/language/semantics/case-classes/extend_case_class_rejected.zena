// @mode: check
class Point(x: i32, y: i32)

// @error: Cannot extend final class 'Point'. Case classes are implicitly final.
class FakePoint extends Point {
  // @error: Constructors in derived classes must call super().
  new(x: i32, y: i32) {
    // @error: Type 'Point' is not callable.
    super(x, y);
  }
}
