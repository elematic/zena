// @mode: check
// An integer literal must fit the type it takes (#321). With no context
// that is i32. A decimal literal must fit the signed range; a hex literal
// may use every bit, as a bit pattern, so 0xFFFFFFFF is the i32 -1.

let a = 2147483647;
let b = -2147483648;
let c = 2147483648; // @error: Integer literal 2147483648 is out of range for type 'i32'.
let d = -2147483649; // @error: Integer literal -2147483649 is out of range for type 'i32'.
let e = 5000000000; // @error: Integer literal 5000000000 is out of range for type 'i32'.
let f: i32 = 3000000000; // @error: Integer literal 3000000000 is out of range for type 'i32'.
let g = 0xFFFFFFFF;
let h = 0x100000000; // @error: Integer literal 0x100000000 is out of range for type 'i32'.

let i: i64 = 9223372036854775807;
let j: i64 = -9223372036854775808;
let k: i64 = 9223372036854775808; // @error: Integer literal 9223372036854775808 is out of range for type 'i64'.
let l: i64 = 0xFFFFFFFFFFFFFFFF;
let m = 3000000000 as i64;

// A literal cast to a primitive is parsed at the cast's width, so it is
// measured against that width: 64 bits for i64 and u64, 32 bits, signed
// or unsigned, for the narrower integers (`-1 as u32` reinterprets), and
// anything for a float.
let n = 18446744073709551615 as u64;
let o = 18446744073709551616 as u64; // @error: Integer literal 18446744073709551616 is out of range for type 'u64'.
let p = -9223372036854775808 as i64;
let q = -1 as u32;
let r = 4294967295 as u32;
let s = 4294967296 as u32; // @error: Integer literal 4294967296 is out of range for type 'u32'.
let t = 100000000000000000000 as f64;

// A negated literal is measured as one in any context, a generic
// parameter's included.
let same = <T>(a: T, b: T): boolean => true;
let u = same(-2147483648, 0);
