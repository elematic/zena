// @mode: check
// Primitives are value types with no null representation, so `?` rejects them.

let a: i32? = null; // @error: 'i32' is not nullable: primitives cannot be null.
let b: boolean? = null; // @error: 'boolean' is not nullable: primitives cannot be null.
let c: f64? = null; // @error: 'f64' is not nullable: primitives cannot be null.
