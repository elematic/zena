// @mode: check
// A module-level value binding cannot cross an import cycle's back
// edge: this module evaluates last, so `magic` has no value yet when
// cyclic_value_first initializes (docs/design/import-cycles.md).
// @error: Cyclic import of value 'magic'
import { probe } from './cyclic_value_first.zena';

export let magic = 7;
export let touch = (): i32 => probe();
