import { TargetA } from './reexport_cycle_index.zena';

export let testFn = (): boolean => {
  let a = new TargetA();
  // We need to see if methodB() invocation fails due to lost type info
  if (let val = a.methodA()) {
      return val.methodB();
  }
  return false;
};
