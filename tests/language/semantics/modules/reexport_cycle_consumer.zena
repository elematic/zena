// @mode: check
import { TargetA, TargetB } from './reexport_cycle_index.zena';

export let testFn = (): boolean => {
  let a = new TargetA();
  // The re-export cycle must not lose type info: methodA's return
  // type (TargetB | null) and TargetB's members must both survive.
  let val = a.methodA();
  if (val == null) {
    return false;
  }
  return (val as TargetB).methodB();
};
