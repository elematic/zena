// @mode: check
// Control flow is a statement, so it is rejected at the top level of a
// module along with every other non-declaration.
var total: i32 = 0;

for (var i: i32 = 0; i < 10; i += 1) { // @error: may only contain declarations
  total += i;
}

if (total > 0) { // @error: may only contain declarations
  total = 0;
}
