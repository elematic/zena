// @mode: check
// Mutually recursive classes across an import cycle: each class
// references the other through a field and a method signature.
import { Node } from './cyclic_mutual_classes_first.zena';

export class Tree {
  var root: Node | null = null;

  attach(n: Node): void {
    this.root = n;
  }
}
export let touch = (): Tree => new Tree();
