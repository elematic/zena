// @mode: check
// A mixin crosses an import cycle's back edge: the importer applies an
// identity-bearing shell that the mixin's own registration fills in, and
// the application is rebuilt when the cycle registers again
// (docs/design/import-cycles.md, restriction lifted). No diagnostic: this
// file asserts the mixin `Greeter` and the cyclic import both check clean.
import { Host } from './cyclic_mixin_first.zena';

export interface Named {
  name: String;
}

export mixin Greeter on Named {
  greet(): String {
    return 'Hello, ' + this.name + '!';
  }
}

export let makeHost = (name: String): Host => new Host(name);
