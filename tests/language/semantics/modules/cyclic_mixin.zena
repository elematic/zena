// @mode: check
// A mixin cannot cross an import cycle's back edge (mixin members are
// copied at application time).
// @error: Cyclic import of mixin 'Greeter'
import { Host } from './cyclic_mixin_first.zena';

export interface Named {
  name: String;
}

export mixin Greeter on Named {
  greet(): String {
    return 'Hello, ' + this.name + '!';
  }
}

export let makeHost = (name: String): Host => new Host(name);

