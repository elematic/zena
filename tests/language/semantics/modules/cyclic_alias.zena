// @mode: check
// Type aliases cannot cross an import cycle's back edge (their
// resolution is transparent and pass-dependent; classes and
// interfaces, which have stable identity, can).
// @error: Cyclic import of type alias 'Pair'
import { probe } from './cyclic_alias_first.zena';

export type Pair = (i32, i32);
export let touch = (): i32 => probe();
