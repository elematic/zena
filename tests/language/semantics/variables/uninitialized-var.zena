// @mode: check
// Mutable `var` declarations of a nullable type may omit `= ...` and
// default to `null`. Non-nullable `var` declarations require an initializer.

class Widget {}

var topWidget: Widget?;
let checkTop: Widget | null = topWidget;

var topBad: i32; // @error: Variable of non-nullable type 'i32' must be initialized.

let check = (): void => {
  var name: String?;
  let copy: String | null = name;
  name = "ok";

  var count: i32; // @error: Variable of non-nullable type 'i32' must be initialized.
  var flag: boolean; // @error: Variable of non-nullable type 'boolean' must be initialized.
  var w: Widget; // @error: Variable of non-nullable type 'Widget' must be initialized.
};
