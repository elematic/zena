// @mode: check
// A literal with no contextual type takes its default: `i32` for an integer,
// `f64` for a float. Neither assignment below is allowed, and each names the
// inferred type in its message, so changing either default fails this test.
// docs/design/types.md#default-literal-types explains why the integer default
// is the narrow width and the float default the wide one.

let int = 10;
let float = 3.14;

// f64 does not narrow implicitly, so this reports the float literal's default.
let narrowed: f32 = float; // @error: 'f64' is not assignable to 'f32'

// Nor does i32 convert implicitly outside arithmetic.
let converted: f32 = int; // @error: 'i32' is not assignable to 'f32'
