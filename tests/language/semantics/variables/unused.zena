// @mode: check

export let main = (): void => {
  let unusedVal = 5;
// @warning: never read
  
  let usedVal = 10;

  var mutVal = 42;
// @warning: never written to
  
  var mutAndWritten = 50;
  mutAndWritten = 60;

  let x = usedVal + mutVal + mutAndWritten;
// @warning: never read

  // Unused but named '_' should not warn
  let _ = 10;
  var _mut = 20;

  // Unused mut
  var unusedMut = 100;
// @warning: never read

  // Mutated but never read? Zena only warns on UnusedVariable if it's never read.
  var writtenOnly = 1;
// @warning: never read
  writtenOnly = 2; // Write doesn't count as read!
};
