// @mode: check
// A try whose value is used joins its arms like an if or a match: a
// primitive and a reference type cannot share a union (#312).
let f = (): i32 => 3;
let a = try { f() } catch (e) { e.message }; // @error: Union types cannot mix primitive types with reference types
let b: i32 = try { f() } catch (e) { 0 };
let c = try { 'x' } catch (e) { null };
