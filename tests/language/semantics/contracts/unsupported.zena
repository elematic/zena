// @mode: check

// Where a clause parses and what it would mean is undecided
// (docs/design/contracts.md).

interface Shape {
  area(): f64 ensures (result >= 0.0); // @error: 'ensures' clauses on a method without a body are not supported yet.
}

abstract class Base {
  abstract size(): i32 ensures (result >= 0); // @error: 'ensures' clauses on a method without a body are not supported yet.
}

gen function count(n: i32): Iterator<i32> requires (n >= 0) { // @error: 'requires' clauses on a generator are not supported yet.
  yield n;
}
