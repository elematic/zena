// @mode: check

// Where a clause parses and cannot be used yet
// (docs/design/contracts.md).

interface Shape {
  area(): f64 ensures (result >= 0.0); // @error: 'ensures' clauses on a method without a body are not supported yet.
}

abstract class Base {
  abstract size(): i32 ensures (result >= 0); // @error: 'ensures' clauses on a method without a body are not supported yet.
}

// An inline tuple result is bound to `result`; an inline record is not yet.
type Point = {x: i32, y: i32};

function origin(): inline Point ensures (result.x == 0) { // @error: 'ensures' clauses on a function that returns an inline record are not supported yet.
  return {x: 0, y: 0};
}

function shift(p: inline (i32, i32)): inline (i32, i32)
  ensures (old(p)[0] == result[0]) // @error: 'old' of an inline value is not supported yet.
{
  return (p[0] + 1, p[1]);
}

class Counter {
  var count: i32;

  new(count: i32)
    ensures (this.count == old(count)) // @error: 'old' in a constructor's 'ensures' condition is not supported yet.
    : count = count {}
}

// A tail call discards the frame its postconditions would run in.
function countdown(n: i32): i32 ensures (result == 0) {
  if (n == 0) {
    return 0;
  }
  tail return countdown(n - 1); // @error: 'tail return' is not allowed in a function with 'ensures' clauses: the frame it would discard still owes the postconditions.
}
