// @mode: check

// A `debug` clause is checked like any other, in every build. It is
// compiled only in test and debug builds, so nothing after it can rely
// on what its condition would have narrowed.

function isSorted(items: FixedArray<i32>): boolean {
  return true;
}

function search(items: FixedArray<i32>, target: i32): i32
  requires (items.length > 0)
  debug requires (isSorted(items))
  debug ensures (result >= 0 && result == old(items.length) - items.length)
{
  var total = 0;
  for (let item in items) debug invariant (total >= 0) {
    total += item;
  }
  return 0;
}

function notBoolean(n: i32): i32 debug requires (n + 1) { // @error: Condition must be a boolean type, got 'i32'.
  return n;
}

function assigns(n: i32): i32 {
  var i = 0;
  while (i < n) debug invariant ((i = i + 1) > 0) { // @error: A 'invariant' condition cannot assign.
    i += 1;
  }
  return i;
}

// An unmarked clause narrows; a `debug` one does not.
function unmarked(text: String | null): i32 requires (text != null) {
  return text.length;
}

function marked(text: String | null): i32 debug requires (text != null) {
  return text.length; // @error: Object may be null when accessing 'length'.
}

// Nor in the clauses after it, or in a postcondition.
function later(text: String | null): i32
  debug requires (text != null)
  requires (text.contains('a')) // @error: Object may be null when accessing 'contains'.
  ensures (result == text.length) // @error: Object may be null when accessing 'length'.
{
  return 0;
}
