// @mode: check

// A postcondition holds on every path out of the body, so it knows only
// what was known on entry. Here the body ends with `text` narrowed to
// `String`, and one path returned while it was null.

function length(text: String | null): i32 ensures (result == text.length) { // @error: Object may be null when accessing 'length'.
  if (text == null) {
    return 0;
  }
  return text.length;
}

// The condition's own tests narrow as they do anywhere.
function lengthOrZero(text: String | null): i32
  ensures (text == null || result == text.length)
{
  if (text == null) {
    return 0;
  }
  return text.length;
}
