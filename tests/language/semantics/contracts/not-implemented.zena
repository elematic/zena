// @mode: check

// Contract clauses parse, and nothing checks or runs them yet. Each one
// is an error, so that a contract is never accepted and then not
// enforced.

function half(n: i32): i32
  requires (n % 2 == 0) // @error: 'requires' clauses are not implemented yet.
  ensures (result * 2 == n) // @error: 'ensures' clauses are not implemented yet.
{
  var i = 0;
  while (i < n) invariant (i >= 0) { // @error: 'invariant' clauses are not implemented yet.
    i += 2;
  }
  return i;
}

interface Shape {
  area(): f64 ensures (result >= 0.0); // @error: 'ensures' clauses are not implemented yet.
}
