// @mode: check

// A `static` clause is a specification: type-checked in every build by
// the rules every clause follows, never checked at run time, and so
// narrowing nothing.

function isSorted(items: FixedArray<i32>): boolean {
  return true;
}

function search(items: FixedArray<i32>, target: i32): i32
  requires (items.length > 0)
  static requires (isSorted(items))
  static ensures (result < 0 || items[result] == target)
{
  var total = 0;
  for (let item in items) static invariant (total >= 0) {
    total += item;
  }
  return 0;
}

function notBoolean(n: i32): i32 static requires (n + 1) { // @error: Condition must be a boolean type, got 'i32'.
  return n;
}

function unknownName(n: i32): i32 static ensures (result == expected) { // @error: Variable 'expected' not found.
  return n;
}

function assigns(n: i32): i32 {
  var i = 0;
  while (i < n) static invariant ((i = i + 1) > 0) { // @error: A 'invariant' condition cannot assign.
    i += 1;
  }
  return i;
}

function marked(text: String | null): i32 static requires (text != null) {
  return text.length; // @error: Object may be null when accessing 'length'.
}
