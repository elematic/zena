// @mode: check

// The other route to the same private member: name it with no symbol
// declared anywhere. The access side did not require the symbol to resolve
// to a binding at all, so this compiled and read the field.
import { Holder } from './lib.zena';

let test = (): void => {
  let h = new Holder(41);
  let forged: i32 = h.[secret]; // @error: Cannot find symbol
};
