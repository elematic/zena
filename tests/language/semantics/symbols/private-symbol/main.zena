// @mode: check

// An unexported symbol is out of reach even from a module that declares a
// symbol of the same NAME. Member keys are the mangled string ":secret" on
// both sides, so a forged symbol was indistinguishable from the real one
// until the access compared the symbol's identity.
import { Holder, shared } from './lib.zena';

// A symbol of this module's own. Same name, different symbol.
symbol secret;

let test = (): void => {
  let h = new Holder(41);

  // Allowed: the symbol is exported, and imported here.
  let ok: i32 = h.:shared;

  // Allowed: the library's own accessor.
  let alsoOk: i32 = h.reveal();

  // Not allowed: a same-named symbol is not the same symbol.
  let forged: i32 = h.:secret; // @error: different symbol
};
