// The symbol is deliberately NOT exported, which `docs/design/classes.md`
// §9.4 says is what makes the member unreachable from outside.
symbol secret;

export symbol shared;

export class Holder {
  var [secret]: i32;
  var [shared]: i32;

  new(s: i32) {
    this.[secret] = s;
    this.[shared] = s;
  }

  reveal(): i32 { return this.[secret]; }
}
