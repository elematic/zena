// The interface is deliberately NOT exported. `zena:core`'s resource
// lifecycle flag is arranged exactly this way: an unexported interface
// declaring the static symbols, so `docs/design/classes.md` §9.4's export
// rule is what puts the member out of reach.
interface Secret {
  static symbol peek;

  [Secret.peek](): i32;
}

export interface Shared {
  static symbol look;

  [Shared.look](): i32;
}

export class Holder implements Secret, Shared {
  n: i32;

  new(this.n);

  [Secret.peek](): i32 { return this.n; }
  [Shared.look](): i32 { return this.n; }

  reveal(): i32 { return this.[Secret.peek](); }
}
