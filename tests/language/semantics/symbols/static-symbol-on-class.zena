// @mode: check

// A symbol is an identity rather than storage, so it occupies nothing on
// the type that declares it — on an interface or on a class alike. A class
// body parses `static symbol` into a static field annotated `symbol`; the
// checker registers it as the class's static symbol and it has no cell.

class Holder {
  static symbol tag;

  n: i32 = 7;

  [Holder.tag](): i32 { return this.n; }
}

// The bare name is not in scope in a class body either.
class Bare {
  static symbol tag;

  [tag](): i32 { return 1; } // @error: is a static symbol of 'Bare'
}

let use = (h: Holder): i32 => h.[Holder.tag]();
