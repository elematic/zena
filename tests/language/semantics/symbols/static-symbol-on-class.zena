// @mode: check

// A class body parses `static symbol` — `syntax/symbols/class-static-symbol.zena`
// pins that — but a symbol is not storage, so a class has nothing to hold
// and nothing below the checker knows what to lay out for it. The
// declaration is reported here rather than reaching a backend that traps.

class Holder {
  static symbol tag; // @error: 'static symbol' is an interface declaration

  n: i32 = 7;
}

// The two forms that do work.
symbol topLevel;

interface Protocol {
  static symbol act;

  [Protocol.act](): void;
}

class Doer implements Protocol {
  [Protocol.act](): void {}
  [topLevel](): i32 { return 1; }
}
