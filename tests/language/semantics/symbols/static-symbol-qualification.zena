// @mode: check

// The name inside `[...]` is an ordinary expression — a name, or a static
// member read through its type — checked like any other, and it has to be
// a symbol.

interface Disposable {
  static symbol dispose;

  [Disposable.dispose](): void;
}

interface Bare {
  static symbol act;

  // Like any static member, a static symbol is not in scope under its bare
  // name, and the error is the ordinary one.
  [act](): void; // @error: Variable 'act' not found. Did you mean 'Bare.act'?
}

interface Unknown {
  static symbol real;

  // The qualifier resolves and the property does not. That it does not
  // exist at all is the problem, so that is what is reported.
  [Unknown.notDeclared](): void; // @error: Property 'notDeclared' does not exist on interface 'Unknown'
}

// A name nothing declares is the ordinary missing-name error.
interface Nothing {
  [nowhere](): void; // @error: Variable 'nowhere' not found
}

// A path that resolves has to resolve to a symbol — the one check that is
// particular to a member key.
class WithField {
  static count: i32 = 0;
}

interface NotASymbol {
  [WithField.count](): void; // @error: 'WithField.count' is not a symbol
}

class Impl implements Disposable {
  [Disposable.dispose](): void {}
}

let use = (d: Impl): void => {
  d.[Disposable.dispose]();
};
