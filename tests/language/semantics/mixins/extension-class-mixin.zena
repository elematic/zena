// @mode: check
mixin Printable on ClassWithPrint {
  printString(s: String): void {
    // console.log(s);
  }
}

interface ClassWithPrint {
  prefix: String;
}

export final extension class MyString on String with Printable implements ClassWithPrint {
  prefix: String {
    get {
      return "prefix";
    }
  }
}

let s = "hello" as MyString;
s.printString(s.prefix);
