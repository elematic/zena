// @mode: check

let s = "hello";
let r1 = s.startIndex..s.endIndex; // @type: BoundedStringRange
let r2 = s.startIndex..; // @type: FromStringRange
let r3 = ..s.endIndex; // @type: ToStringRange
let sub1 = s[r1]; // @type: String
let sub2 = s[r2]; // @type: String
let sub3 = s[r3]; // @type: String
let sub4 = s[..]; // @type: String
let mixed = 0..s.endIndex; // @error: Range bounds must have the same type
let badIntRange = s[0..2]; // @error: 'String' cannot be indexed by 'BoundedRange<i32>'
