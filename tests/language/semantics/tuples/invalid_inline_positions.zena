// @mode: check

class Point {
  coords: inline (i32, i32); // @error: An inline type can only be a function's result, a parameter or a 'let', not here.
  // @error: Field 'coords' must be initialized. Add an initializer or a constructor.
  new() {}
}

interface HasCoords {
  coords: inline (i32, i32); // @error: An inline type can only be a function's result, a parameter or a 'let', not here.
}

class Box<T> {
  value: T;
  new(this.value);
}

export let main = (): i32 => {
  // A `let` in a function body may be inline.
  let x: inline (i32, i32) = (1, 2);
  // @error: Type mismatch: 'ImmutableArray<(i32, i32)>' is not assignable to 'array<(i32, i32)>'.
  let arr: array<inline (i32, i32)> = []; // @error: An inline type can only be a function's result, a parameter or a 'let', not here.
  let f = (y: inline (i32, i32)): i32 => 0; // @error: An inline parameter is not supported on a function value, which cannot be adapted to a boxed parameter yet (#543).
  // @error: Type mismatch: 'Box<[i32, i32]>' is not assignable to 'Box<(i32, i32)>'.
  let b: Box<inline (i32, i32)> = new Box((1, 2)); // @error: An inline type can only be a function's result, a parameter or a 'let', not here.
  return 0;
};
