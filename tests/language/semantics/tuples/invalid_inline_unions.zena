// @mode: check
// `inline` takes the whole union to its right, so a union mixes inline and
// boxed members only when the modifier comes after the first member.

export let mixed = (flag: boolean): (i32, i32) | inline (i32, i32) => { // @error: cannot mix inline tuple types with other representations
  if (flag) {
    return (1, 2);
  } else {
    return (1, 2);
  }
};

export let primitive_mix = (): i32 | inline (i32, i32) => { // @error: cannot mix inline tuple types with other representations
  return 0;
};

// With the modifier first, a primitive member is part of its operand.
export let primitive_operand = (): inline (i32, i32) | i32 => { // @error: 'inline' applies to tuple types and unions of them, not 'i32'.
  return 0;
};
