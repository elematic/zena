// @mode: check

export let mixed = (flag: boolean): inline (i32, i32) | (i32, i32) => { // @error: cannot mix inline tuple types with other representations
  if (flag) {
    return (1, 2);
  } else {
    return (1, 2);
  }
};

export let primitive_mix = (): inline (i32, i32) | i32 => { // @error: cannot mix inline tuple types with other representations
  return 0;
};
