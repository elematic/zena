// @mode: check
// @warnUnnecessaryCasts: true

// @warning: never read
let foo = (x: i32) => {
  // @warning: Unnecessary cast: expression is already of type 'i32'.
  let y = x as i32;
  return y;
};

// Also verify that it doesn't warn for actual casts
// @warning: never read
let bar = (x: i32) => {
  let y = x as i64;
  return y;
};