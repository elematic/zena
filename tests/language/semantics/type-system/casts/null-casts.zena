// @mode: check

class Foo {
  x: i32;
  new(this.x);
}

export let main = () => {
  // Casting null to a non-nullable reference type must fail
  let f = null as Foo; // @error: Cannot cast 'null' to non-nullable type 'Foo'

  // Direct assignment of null to a nullable type is valid without cast
  let g: Foo | null = null;

  return 0;
};
