// @mode: check

export let main = () => {
  // Casting boolean to/from numbers is invalid in Zena
  let a = true as i32; // @error: Cannot cast primitive type
  let b = true as i64; // @error: Cannot cast primitive type
  let c = 1 as boolean; // @error: Cannot cast primitive type
  let d = 1.0 as boolean; // @error: Cannot cast primitive type
  
  // Casting boolean/numbers to reference types is also invalid
  let e = true as String; // @error: Cannot cast primitive type
  let f = 1 as String; // @error: Cannot cast primitive type

  return 0;
};
