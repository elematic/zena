// @mode: check

export let main = () => {
  // Casting boolean to/from numbers is invalid in Zena
  // @error: Cannot cast type 'true' to 'i32'.
  let a = true as i32;
  // @error: Cannot cast type 'true' to 'i64'.
  let b = true as i64;
  // @error: Cannot cast type 'i32' to 'boolean'.
  let c = 1 as boolean;
  // @error: Cannot cast type 'f64' to 'boolean'.
  let d = 1.0 as boolean;
  
  // Casting boolean/numbers to reference types is also invalid
  let e = true as String; // @error: Cannot cast primitive type
  let f = 1 as String; // @error: Cannot cast primitive type

  return 0;
};
