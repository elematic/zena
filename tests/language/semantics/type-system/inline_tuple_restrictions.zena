// @mode: check

export let ok1 = (): inline (i32, i32) => (1, 2);
export let ok2 = (): inline (true, i32) | inline (false, _) => (true, 42);

// Naming an inline tuple in an alias is legal — the alias is a name for the
// type, not a new position for it, and every *use* is still checked. See
// inline_tuple_alias.zena and inline_tuple_alias_restrictions.zena.
type Ok3 = inline (i32, i32);

// @error: Inline tuple types can only appear in function return types, not here.
type Bad2 = (x: inline (i32, i32)) => i32;

// @error: Inline tuple types can only appear in function return types, not here.
type Bad3 = Array<inline (i32, i32)>;

class Box<T> {}

// @error: Inline tuple types can only appear in function return types, not here.
type Bad4 = Box<inline (i32, i32)>;

// @error: Inline tuple types can only appear in function return types, not here.
type Bad5 = (String, inline (i32, i32));

// @error: Inline tuple types can only appear in function return types, not here.
type BadRecord = { a: inline (i32, i32) };

// Binding an inline tuple to a name boxes it: the name holds a stored
// `(i32, i32)`. A tuple pattern (`let (a, b) = ok1()`) takes the inline value
// apart instead.
let boxed = ok1();
