// @mode: check
// What `inline` cannot apply to. Each of these is an error rather than a
// silent no-op, so a reader can trust that `inline` always means "unboxed".

class Box<T> {
  value: T;
  new(this.value);
}

type Point = {x: i32, y: i32};

// A primitive is never boxed.
export let primitive = (): inline i32 => 0; // @error: 'inline' applies to tuple types and unions of them, not 'i32'.

// A class instance is a reference by definition.
export let klass = (): inline String => ''; // @error: 'inline' applies to tuple types and unions of them, not 'String'.

// `inline` requires the unboxed form, which an argument for a type
// parameter may not have (and, once classes can be inline, may not be
// allowed to have).
export let param = <T>(x: T): inline T => x; // @error: 'inline' cannot apply to type parameter 'T': its argument may not be inlinable. Write 'inline? T' to unbox it when it is a tuple.

// `inline? T` unboxes the argument when it can be and leaves it as it is
// otherwise (execution/tuples/inline_type_param.zena). It follows the
// placement rules of an inline type, it cannot be an inline union's
// member, which has to start with a literal, and on a known type there is
// nothing to decide.
export let paramIfPossible = <T>(x: T): inline? T => x;
export let paramStored = <T>(x: T): Box<inline? T> => { throw new Error('unreachable'); }; // @error: Inline tuple types can only appear in function return types, not here.
export let paramMember = <T>(x: T): inline (true, i32) | inline? T => (true, 1); // @error: Type parameter 'T' cannot be a member of an inline union.
export let knownIfPossible = (): inline? (i32, i32) => (1, 2); // @error: 'inline?' applies to a type parameter: write 'inline' to unbox a known type.

// Inline records are planned (#371).
export let record = (): inline Point => ({x: 1, y: 2}); // @error: Inline record types are not supported yet.

// An existential's shape is not known, so it has no layout to unbox.
export let existential = (): inline {x: i32, ...} => ({x: 1}); // @error: 'inline' cannot apply to an existential record type.

// `null` has no slots: an inline value is never absent.
export let nullable = (): inline (i32, i32)? => null; // @error: 'inline' applies to tuple types and unions of them, not 'null'.

// A type argument is storage, not a return position.
export let typeArg = (): Box<inline (i32, i32)> => { throw new Error('unreachable'); }; // @error: Inline tuple types can only appear in function return types, not here.

// A plain tuple's element is storage too: `inline` nests only inside an
// inline value.
export let nested = (): (String, inline (i32, i32)) => ('', (1, 2)); // @error: Inline tuple types can only appear in function return types, not here.

// A function type's parameter is not a return position.
export let callback = (): ((p: inline (i32, i32)) => i32) => (p) => 0; // @error: Inline tuple types can only appear in function return types, not here.

// An inline tuple nests inside an inline value, its slots part of the
// outer one's (execution/tuples/inline_nested.zena); an inline union does
// not yet.
export let nestedInline = (): inline (i32, inline (i32, i32)) => (1, (2, 3));
export let nestedUnion = (): inline (i32, inline (true, i32) | (false, String)) => (1, (true, 3)); // @error: An inline union inside an inline tuple is not supported yet.
