// @mode: check
// An `inline` record parameter or `let` follows the rule an inline tuple
// does (docs/design/inline-parameters.md): it is read through its fields
// or passed on to another inline position, and a use that would box it is
// an error there.

type Point = {x: i32, y: i32};

function sum(p: inline Point): i32 {
  let {x, y} = p;
  return x + y;
}

function boxed(p: Point): i32 {
  return p.x;
}

// Reads and forwards.
function reads(p: inline Point): i32 {
  let kept = p;
  let annotated: inline Point = {x: p.y, y: p.x};
  if (let {x} = kept) {
    return x + sum(annotated);
  }
  return sum(kept);
}

// A boxed record, and a record literal, are passed as their fields.
let fromBoxed = (p: Point): i32 => sum(p) + sum({x: 1, y: 2});

// Each of these would box it.
function escapes(p: inline Point): Point {
  boxed(p); // @error: 'p' is inline, so it is only read or passed on: passing it for a parameter that is not inline would box it.
  let all = [p]; // @error: 'p' is inline, so it is only read or passed on: putting it in an array would box it.
  let f = () => p.x; // @error: 'p' is inline, so it is only read or passed on: capturing it in a closure would box it.
  return p; // @error: 'p' is inline, so it is only read or passed on: returning it as a boxed result would box it.
}

// A boxed record is an inline tuple's slot like any reference.
function holds(t: inline (Point, i32)): i32 {
  return t[0].x + t[1];
}

// An inline result forwards it; a boxed one would box it.
function result(p: inline Point): inline Point {
  return p;
}

function escapesAsResult(p: inline Point): Point {
  return p; // @error: 'p' is inline, so it is only read or passed on: returning it as a boxed result would box it.
}

// Inside an inline tuple, its fields are the tuple's. A tuple literal
// passes it on to an inline position, and boxes it in a boxed one.
function nested(t: inline (inline Point, i32), p: inline Point): inline (inline Point, i32) {
  let (q, n) = t;
  return (p, q.x + n);
}

function nestedBoxed(p: inline Point): inline (Point, i32) {
  return (p, 1); // @error: 'p' is inline, so it is only read or passed on: putting it in a tuple would box it.
}

// Not yet: a nested inline record with optional fields, and a record
// whose fields are not known.
type Opts = {size: i32, scale?: i32};

function nestedOptional(t: inline (inline Opts, i32)): i32 { // @error: An inline record with optional fields inside an inline tuple is not supported yet.
  return t[1];
}

function existential(p: inline {x: i32, ...}): i32 { // @error: 'inline' cannot apply to an existential record type.
  return p.x;
}

function rowed<R extends record>(p: inline {x: i32, ...R}): i32 { // @error: 'inline' cannot apply to a record with a row: its fields are not known.
  return p.x;
}

// A field of an inline record may be inline too, and only there.
type Vec = {x: i32, y: i32};
type Sprite = inline {pos: inline Vec, span: inline (i32, i32), id: i32};
type Stored = {pos: inline Vec}; // @error: An inline type can only be a function's result, a parameter or a 'let', not here.

function readsFields(s: Sprite): i32 {
  let {pos} = s;
  let held: Vec = pos;
  return held.x + s.span[0] + s.id;
}

type Reply = (true, i32) | (false, String);

function badFields(
  a: inline {pos?: inline Vec}, // @error: An inline field cannot be optional: an inline value has no absent form.
  b: inline {r: inline Reply}, // @error: An inline union inside an inline record is not supported yet.
  c: inline {o: inline Opts}, // @error: An inline record with optional fields inside an inline record is not supported yet.
): i32 {
  return 0;
}

// An optional field beside an inline one has no slot for its presence
// word yet (#1094).
type Placed = inline {pos: inline Vec, id?: i32}; // @error: An inline record with inline fields cannot have optional fields yet: their presence has no slot.
