// @mode: check
// zena:time's Instant and Duration are nominal extension classes over
// i64: a bare number is not a duration, and adding two points in time
// is meaningless.
import { sleep, monotonic, milliseconds } from 'zena:time';

export let bad1 = sleep(100); // @error: Type mismatch: argument 'i32' is not assignable to parameter 'Duration'.
export let bad2 = monotonic() + monotonic(); // @error: Type mismatch in operator '+': expected 'Duration', got 'Instant'.
export let ok = monotonic() + milliseconds(5);
