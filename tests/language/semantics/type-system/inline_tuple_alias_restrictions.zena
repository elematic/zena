// @mode: check
// Naming an inline tuple with a type alias does not create a new position for
// it. Every restriction still applies at the *use* site, after expansion.

type Pair = inline (i32, i32);
type Result<T, E> = inline (true, T, _) | inline (false, _, E);

let makePair = (): Pair => (1, 2);

// @error: Inline tuple types can only appear in function return types, not here.
let bad1: Pair = makePair();

// @error: Inline tuple types can only appear in function return types, not here.
// @error: Inline tuple types can only appear in function return types, not here.
type Bad2 = (x: Pair) => i32;

// @error: Inline tuple types can only appear in function return types, not here.
// @error: Inline tuple types can only appear in function return types, not here.
type Bad3 = Array<Result<i32, String>>;

// @error: Inline tuple types can only appear in function return types, not here.
// @error: Inline tuple types can only appear in function return types, not here.
type Bad4 = { a: Pair };

class Holder {
  // @error: Inline tuple types can only appear in function return types, not here.
  field: Pair;
}
