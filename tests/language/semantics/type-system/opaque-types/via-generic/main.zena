// @mode: check
// The hole that made `opaque` decorative: a generic helper casting to its own
// bare type parameter forged a Token without ever naming one, so the
// declaring-file rule never got a chance to fire.

import { Token, mint } from './lib.zena';

// Rejected where the generic is *defined*, which is what makes the opaque
// guarantee hold -- there is no instantiation for the file check to inspect.
let launder = <T>(x: i32): T => x as T; // @error: Cannot cast type 'i32' to type parameter 'T'

// The honest route still works.
let real: Token = mint(7);
