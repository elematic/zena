// The declaring file: the only place values of these types can be minted.

export opaque type Token = i32;
export opaque type Handle = String;

export let mintToken = (raw: i32): Token => raw as Token;

export let tokenValue = (t: Token): i32 => t as i32;

export let widen = (h: Handle | null): Handle | null => h;

export let maybeHandle = (present: boolean): Handle | null => {
  if (present) {
    return 'h' as Handle;
  }
  return null;
};
