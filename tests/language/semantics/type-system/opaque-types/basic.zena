// @mode: check
// Inside its own file an opaque type behaves exactly like a distinct type:
// casting both into and out of it is unrestricted.

opaque type UserId = i32;

let mint = (raw: i32): UserId => raw as UserId;

let id: UserId = 42 as UserId;
let same: UserId = id;
let raw: i32 = id as i32;
let viaFn: UserId = mint(7);

// Still distinct — the underlying type is not assignable to it.
let bad: UserId = 42; // @error: Type mismatch
