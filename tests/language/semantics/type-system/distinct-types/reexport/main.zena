// @mode: check

// A distinct type imported through a re-export-only module must keep its
// distinctness: if the re-export chain degraded it to an ErrorType stub (or
// its backing type), these mismatches would be silently accepted.

import { Meters } from './index.zena';

let x: Meters = 42; // @error: Type mismatch
let ok: Meters = 42 as Meters;
let y: i32 = ok; // @error: Type mismatch
