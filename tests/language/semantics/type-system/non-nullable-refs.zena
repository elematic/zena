// @mode: check

class Person {
  name: String;
  new(this.name);
}

// 1. Assigning null to non-nullable reference type should fail
let p1: Person = null; // @error: Type mismatch

// 2. Assigning non-nullable value to non-nullable reference type should pass
let p2: Person = new Person("Alice");

// 3. Nullable reference types can be assigned null or non-null
let p3: Person | null = null;
let p4: Person | null = p2;

// 4. Mismatched assignment from nullable to non-nullable should fail
let p5: Person = p3; // @error: Type mismatch
