// @mode: check
// A reader of an inline union finds the member from a literal, so every
// member starts with one: of the same type, a different value in each.
// Members may put different types at the same position after it: each
// type gets a slot of its own.

export let ok = (s: String): inline (true, i32) | (false, String) => (true, 1);

export let three = (n: i32): inline (0, i32) | (1, f64) | (2, String) => (0, n);

// The literal must come first.
export let second = (): inline (i32, true) | (f64, false) => (1, true); // @error: Each tuple in a union must start with a literal of the same type, a different one in each, as in '(true, T) | (false, E)'.

// `true` and `1` are the same value at run time.
export let mixedTags = (): inline (true, i32) | (1, f64) => (true, 1); // @error: Each tuple in a union must start with a literal of the same type, a different one in each, as in '(true, T) | (false, E)'.

// `0x1` and `1` are the same tag.
export let sameValue = (): inline (0x1, i32) | (1, f64) => (1, 2); // @error: Each tuple in a union must start with a literal of the same type, a different one in each, as in '(true, T) | (false, E)'.

// A float literal is not a tag.
export let floatTag = (): inline (1.5, i32) | (2.5, f64) => (1.5, 2); // @error: Each tuple in a union must start with a literal of the same type, a different one in each, as in '(true, T) | (false, E)'.

export let noLiteral = (): inline (i32, i32) | (f64, f64) => (1, 2); // @error: Each tuple in a union must start with a literal of the same type, a different one in each, as in '(true, T) | (false, E)'.

export let sameLiteral = (): inline (true, i32) | (true, String) => (true, 1); // @error: Each tuple in a union must start with a literal of the same type, a different one in each, as in '(true, T) | (false, E)'.

export let lengths = (): inline (true, i32, i32) | (false, i32) => (false, 1); // @error: The tuples in a union must have the same length.

// Reading a position without narrowing gives it the union of the members'
// types there, which must be a type.
export let mixedRead = (): i32 => {
  let (tag, value) = ok('x'); // @error: The members of this inline union hold different kinds of values at position 1, so a pattern must match the literal that tells them apart to read it.
  if (let (true, n) = ok('y')) {
    return n;
  }
  return match (three(1)) {
    case (0, let n): n
    case (_, let other): 0 // @error: The members of this inline union hold different kinds of values at position 1, so a pattern must match the literal that tells them apart to read it.
  };
};

class Problem {}

// Two reference types read together are a union like any other.
export let refRead = (): i32 => {
  let (found, thing) = refs();
  return if (thing is Problem) 1 else 0;
};

export let refs = (): inline (true, String) | (false, Problem) => (true, 'x');
