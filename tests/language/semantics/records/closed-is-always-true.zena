// @mode: check
// @warnUnnecessaryCasts: true
// An `is` a closed type always passes is reported, like an unnecessary
// cast.

let x1 = {x: 1};
export let same = x1 is {x: i32}; // @warning: 'x1' is always a '{ x: i32 }'

let pair = (1, 'a');
export let samePair = pair is (i32, String); // @warning: 'pair' is always a '[i32, String]'
