// @mode: check

// A union of record types is read one record shape at a time: passing
// it where a record type is expected works, because the use names the
// shape to read and codegen picks the member (see
// execution/records/record-union-arm-adaptation.zena). A property
// access on the union names no shape, and is refused even for a field
// every member has.
type Named = {name: String};

let nameLength = (o: Named): i32 => o.name.length;

let check = (flag: boolean): i32 => {
  let o = if (flag) {
    {name: 'abc', rank: 1}
  } else {
    {name: 'ab'}
  };
  let direct = o.name; // @error: Property access not supported
  return nameLength(o);
};
