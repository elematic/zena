// @mode: check
// `?` on a record field means the field may be absent, but no
// assignability rule or runtime representation of absence exists, so
// the checker rejects it (docs/design/record-presence.md).
type Opts = {
  url: String,
  // A type alias resolves its target twice, so the error repeats.
  // @error: Optional record fields are not supported yet
  timeout?: i32, // @error: Optional record fields are not supported yet
};

let f = (opts: {retries?: i32}) => { // @error: Optional record fields are not supported yet
  return 0;
};

// A maybe-value is expressed as a value, e.g. Option<T> or a nullable
// reference type — the field itself is always present.
let g = (opts: {inner: String | null}) => {
  return 0;
};
