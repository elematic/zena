// @mode: check
// `array<var T>` spells the element slot's mutability explicitly. Until
// the bare default flips, `array<var T>` and `array<T>` are the same
// type, so the two spellings interchange freely.
import { FixedArray } from 'zena:fixed-array';

let a: array<var i32> = __array_new(3, 0);
let b: array<i32> = a;
let c: array<var i32> = b;

// The elements are mutable, so FixedArray's operators apply.
let fixed = a as FixedArray<i32>;

// `var` is part of the grammar of the builtin array type constructor,
// not a general type-argument modifier.
let bad: FixedArray<var i32> = __array_new(3, 0); // @error: The 'var' element modifier only applies to the builtin 'array' type constructor.
