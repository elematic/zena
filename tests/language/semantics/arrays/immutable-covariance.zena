// @mode: check
// An immutable array widens along its element's class chain and to
// anyref — the cases that keep the element representation and have a
// declared Wasm subtyping. A mutable array is invariant, an
// interface-typed element is a different representation, and nothing
// narrows.
import { FixedArray } from 'zena:core';

class Animal {}
class Cat extends Animal {}
interface Named {
  name: String { get; }
}
class Dog extends Animal implements Named {
  name: String {
    get { return 'dog'; }
  }
}

let cats: ImmutableArray<Cat> = [new Cat()];
let animals: ImmutableArray<Animal> = cats;
let refs: ImmutableArray<anyref> = cats;

let fixedCats: FixedArray<Cat> = [new Cat()];
let fixedAnimals: FixedArray<Animal> = fixedCats; // @error: Type mismatch

let dogs: ImmutableArray<Dog> = [new Dog()];
let named: ImmutableArray<Named> = dogs; // @error: Type mismatch

let back: ImmutableArray<Cat> = animals; // @error: Type mismatch

// An immutable array of tuples widens element by element along the class
// chain, nullable or not, and through nested tuples: tuple types that
// meet share a struct (#1137). A tuple element that would change
// representation does not widen, and a mutable array stays invariant.
let catPairs: ImmutableArray<(Cat, i32)> = [(new Cat(), 1)];
let animalPairs: ImmutableArray<(Animal, i32)> = catPairs;
let maybePairs: ImmutableArray<(Animal | null, i32)> = catPairs;
let nested: ImmutableArray<(i32, (Cat, Cat))> = [(1, (new Cat(), new Cat()))];
let nestedWide: ImmutableArray<(i32, (Animal, Cat))> = nested;
let refPairs: ImmutableArray<(anyref, i32)> = catPairs; // @error: Type mismatch
let fixedPairs: FixedArray<(Cat, i32)> = [(new Cat(), 1)];
let fixedWide: FixedArray<(Animal, i32)> = fixedPairs; // @error: Type mismatch
