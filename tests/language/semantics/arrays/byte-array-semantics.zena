// @mode: check
import { newByteArray } from 'zena:byte-array';

let arr = newByteArray(10);

// 1. Length access
let len: i32 = arr.length;
let lenErr: String = arr.length; // @error: Type mismatch

// 2. Index access
let val: i32 = arr[0];
let valErr: String = arr[0]; // @error: Type mismatch

// 3. Index assignment
arr[1] = 42;
arr[2] = "hello"; // @error: Type mismatch
