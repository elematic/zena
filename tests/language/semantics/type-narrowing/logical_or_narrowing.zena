// @mode: check

class Foo(val: String)
class Bar(val: String)
class Baz(val: String)

let testOr = (x: Foo | Bar | Baz): String => {
  if (x is Foo || x is Bar) {
    // x should be narrowed to Foo | Bar
    let y: Foo | Bar = x;
    return "Foo or Bar";
  }
  // Outside, x is Foo | Bar | Baz (or just Baz since it definitely exited)
  // Let's verify we can't assign x to Foo | Bar here
  let z: Foo | Bar = x; // @error: Type mismatch
  return "";
};
