// @mode: check

sealed class Shape {
  case Circle(radius: f64)
  case Rect(width: f64, height: f64)
}

class Holder(shape: Shape)

let testMatchIdentifier = (s: Shape): f64 => {
  match (s) {
    case Circle: {
      // s should be narrowed to Circle
      let c: Circle = s;
      return c.radius;
    }
    case Rect: {
      // s should be narrowed to Rect
      let r: Rect = s;
      return r.width;
    }
  }
};

let testMatchImmutablePath = (h: Holder): f64 => {
  match (h.shape) {
    case Circle: {
      // h.shape should be narrowed to Circle
      let c: Circle = h.shape;
      return c.radius;
    }
    case Rect: {
      // h.shape should be narrowed to Rect
      let r: Rect = h.shape;
      return r.width;
    }
  }
};

let testMatchAsPattern = (s: Shape): f64 => {
  match (s) {
    case Circle as c: {
      // both s and c should be narrowed to Circle
      let s2: Circle = s;
      let c2: Circle = c;
      return c2.radius;
    }
    case Rect as r: {
      let s2: Rect = s;
      let r2: Rect = r;
      return r2.width;
    }
  }
};
