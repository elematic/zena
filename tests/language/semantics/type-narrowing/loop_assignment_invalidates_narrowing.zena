// @mode: check
// Loops carry assignments back to the top: a narrowing that held on the
// first iteration must not be assumed on later ones, and a narrowing
// established inside a loop body must not survive past the loop, which
// may have run zero times.

class Box {
  var v: i32 = 42;
  new();
}

let mayBox = (): Box | null => null;

// The loop guard re-establishes the narrowing every iteration, so a use
// before any assignment is fine even though the body assigns later.
let guardedLoop = (b: Box | null): i32 => {
  var x = b;
  var sum = 0;
  while (x !== null) {
    sum += x.v;
    x = mayBox();
  }
  return sum;
};

// After an invalidating assignment, a use later in the same body is not
// narrowed: the guard has not been re-evaluated yet.
let useAfterAssignInBody = (b: Box | null): i32 => {
  var x = b;
  var sum = 0;
  while (x !== null) {
    x = mayBox();
    // @error: Object may be null when accessing 'v'.
    sum = x.v;
  }
  return sum;
};

// A narrowing established by a guard before the loop dies inside the
// body once a previous iteration may have reassigned the variable.
let outerGuardInnerAssign = (b: Box | null, n: i32): i32 => {
  var x = b;
  var sum = 0;
  if (x !== null) {
    var i = 0;
    while (i < n) {
      // @error: Object may be null when accessing 'v'.
      sum = x.v;
      x = mayBox();
      i += 1;
    }
  }
  return sum;
};

// An early exit inside a loop body must not narrow code after the loop:
// the loop may have run zero times.
let zeroIterationLeak = (b: Box | null, n: i32): i32 => {
  var x = b;
  var i = 0;
  while (i < n) {
    if (x == null) {
      return 0;
    }
    i += 1;
  }
  // @error: Object may be null when accessing 'v'.
  return x.v;
};

export let main = (): i32 => 0;
