// @mode: check

class Foo {
  foo: String | null = null;
  var bar: String | null = null;

  testLet(): String {
    if (this.foo == null) {
      return "null";
    }
    // this.foo should be narrowed to String
    return this.foo;
  }

  testVar(): i32 {
    if (this.bar == null) {
      return 0;
    }
    // this.bar is mutable, so it shouldn't be narrowed across statements
    // @error: Object may be null when accessing 'length'
    return this.bar.length;
  }
}
