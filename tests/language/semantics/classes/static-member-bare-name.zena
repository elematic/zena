// @mode: check

// A static member is named through its type, even inside that type. A bare
// name that the enclosing type declares as a static member is almost
// always that member written without its type, so the ordinary
// missing-name error says so.

class Counter {
  static count: i32 = 0;
  static reset(): void {}

  bump(): i32 {
    let a = Counter.count;
    let b = count; // @error: Variable 'count' not found. Did you mean 'Counter.count'?
    reset(); // @error: Variable 'reset' not found. Did you mean 'Counter.reset'?
    return a;
  }
}

// A name no enclosing type declares gets the plain message.
let outside = (): i32 => count; // @error: Variable 'count' not found.
