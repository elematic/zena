// @mode: check
class Plain {
  static var count: i32 = 0;
  static doubled: i32 {
    get { return Plain.count * 2; }
    set(v) { Plain.count = v - 2; }
  }
  static staticMethod(): i32 { return Plain.count; }

  instanceField: i32 = 10;
  instanceMethod(): i32 { return this.instanceField; }
  instanceAccessor: i32 {
    get { return this.instanceField; }
  }
}

// Valid static accesses
let x: i32 = Plain.doubled;
Plain.doubled = 20;
let m: i32 = Plain.staticMethod();

// Error: static access to instance members
let a = Plain.instanceField; // @error: Cannot access instance member
let b = Plain.instanceMethod(); // @error: Cannot access instance member
let c = Plain.instanceAccessor; // @error: Cannot access instance member

// Error: instance access to static members
let p = new Plain();
let d = p.count; // @error: Cannot access static member
let e = p.doubled; // @error: Cannot access static member
let f = p.staticMethod(); // @error: Cannot access static member

