// @mode: check
// Public fields with private setters
class Counter {
  // TODO: Fix this test!
  // var(#count) count: i32 = 0;
  var #count: i32 = 0;

  count: i32 {
    get {
      return this.#count;
    }
  }

  increment(): void {
    this.#count += 1;
  }
}
let c = new Counter();
let x = c.count; // Ok
c.count = 5; // @error: Cannot assign to read-only property
let y = c.#count; // @error: Private field
