// @mode: check
// Bitwise and shift operators on classes check parameter count and argument
// assignability, and reject classes that do not declare the operator.

class Bits {
  val: i32;
  new(this.val);

  operator &(other: Bits): Bits {
    return new Bits(this.val & other.val);
  }

  operator <<(shift: i32): Bits {
    return new Bits(this.val << shift);
  }
}

class Plain {
  new();
}

export let check = (): void => {
  let a = new Bits(1);
  let b = new Bits(2);
  let _ok1: Bits = a & b;
  let _ok2: Bits = a << 3;

  let _badArg1 = a & 3; // @error: Type mismatch in operator '&'
  let _badArg2 = a << b; // @error: Type mismatch in operator '<<'
  let _missing = a | b; // @error: Operator '|' cannot be applied
  let _plain = new Plain() ^ new Plain(); // @error: Operator '^' cannot be applied
};
