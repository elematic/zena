// @mode: check
// `Equatable` is satisfied by a type that declares its own equality: a class
// that implements it, a case class (which derives `==`), every hash key such as
// `String`, and primitives.
// Interfaces are nominal, so a class that declares `operator ==`
// without `implements Equatable` does not satisfy it, and neither does a class
// that relies on reference equality.

class Version implements Equatable {
  major: i32;
  new(this.major);
  operator ==(other: Version): boolean {
    return this.major == other.major;
  }
}

class Undeclared {
  v: i32;
  new(this.v);
  operator ==(other: Undeclared): boolean {
    return this.v == other.v;
  }
}

class Point(x: i32, y: i32)

class Plain {
  v: i32;
  new(this.v);
}

let same = <T extends Equatable>(a: T, b: T): boolean => a == b;

let a = same(new Version(1), new Version(1));
let b = same(new Undeclared(1), new Undeclared(1)); // @error: does not satisfy constraint
let c = same(new Point(1, 2), new Point(1, 2));
let d = same(1, 2);
let e = same('x', 'y');
let f = same(new Plain(1), new Plain(1)); // @error: does not satisfy constraint
