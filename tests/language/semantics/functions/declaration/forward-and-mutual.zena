// @mode: check
// Declarations are hoisted, so they can be referenced before their
// definition and can call each other.
let start: boolean = isEven(4);

function isEven(n: i32): boolean {
  if (n == 0) { return true; }
  return isOdd(n - 1);
}

function isOdd(n: i32): boolean {
  if (n == 0) { return false; }
  return isEven(n - 1);
}
