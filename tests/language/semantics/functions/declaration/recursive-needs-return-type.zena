// @mode: check
// Same rule as arrow bindings: a recursive cycle needs an explicit return
// type, since there is nothing to infer from.
function caller(n: i32) {
  helper(n);
}

function helper(n: i32) { // @error: Recursive function requires an explicit return type annotation
  if (n > 0) {
    caller(n - 1);
  }
}
