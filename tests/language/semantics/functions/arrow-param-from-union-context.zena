// @mode: check

// An arrow written where a union with exactly one function member is
// expected takes its parameter types from that member, as it would from
// a plain function type. A union with two function members, or none,
// gives no context.
type Handler = (event: String) => void;
type Value = String | Handler | null;

let accept = (v: Value): i32 => 0;

let passed = accept((e) => {
  let s: String = e;
});

let direct: Value = (e) => {};

type Ambiguous = ((a: i32) => void) | ((b: String) => void);
let two: Ambiguous = (x) => {}; // @error: Parameter 'x' has no type annotation and cannot be inferred from context.
