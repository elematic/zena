// @mode: check
// A forward reference to a function declared below resolves its
// signature from the annotations alone, defaults included: a call may
// omit a defaulted parameter.

let caller = (): i32 => {
  return later(1) + later(2, 5) + maybe(3) + maybe(4, "x");
};

let later = (a: i32, b: i32 = 10): i32 => a + b;

let maybe = (a: i32, b: String? = null): i32 => a;

let alsoWrong = (): i32 => later(); // @error: Expected 1-2 arguments, got 0
