// @mode: check
// Function parameters are immutable bindings and cannot be reassigned.

let f = (x: i32): void => {
  x = 10; // @error: Cannot assign to immutable variable 'x'.
};

function g(y: String): void {
  y = "hello"; // @error: Cannot assign to immutable variable 'y'.
}

let h = (x: i32): void => {
  x += 1; // @error: Cannot assign to immutable variable 'x'.
};

class Greeter {
  greet(name: String): void {
    name = "world"; // @error: Cannot assign to immutable variable 'name'.
  }
}

let destruct = ({a}: {a: i32}): void => {
  a = 42; // @error: Cannot assign to immutable variable 'a'.
};

