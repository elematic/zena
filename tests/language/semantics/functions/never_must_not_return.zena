// A `never` function promises it cannot complete: returning a value is
// a type mismatch, and completing normally is a missing return.

import { Error } from 'zena:error';

let bad = (): never => {
  return 3; // @error: Type mismatch: cannot return 'i32' from function expecting 'never'.
};

let alsoBad = (c: boolean): never => { // @error: A function with a non-void declared return type must return a value.
  if (c) {
    throw new Error("only sometimes");
  }
};
