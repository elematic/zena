// @mode: check
// The same rule applies to nested pattern positions: a field sub-pattern is a
// pattern, not a binding site, so a mistyped variant name there is an error too.
sealed class Shape {
  case Circle(r: i32)
  case Square(s: i32)
}

class Wrapper {
  shape: Shape;
  new(this.shape);
}

let describe = (w: Wrapper): String => match (w) {
  case Wrapper {shape: Squre}: 'square' // @error: does not name a class
};
