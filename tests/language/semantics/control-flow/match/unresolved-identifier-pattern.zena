// @mode: check
// A bare identifier in a pattern is a reference to a type, not a binding.
// A mistyped variant name must be reported rather than silently becoming a
// catch-all that swallows every remaining case.
sealed class Shape {
  case Circle(r: i32)
  case Square(s: i32)
}

let describe = (shape: Shape): String => match (shape) {
  case Circle: 'circle'
  case Squre: 'square' // @error: does not name a class
};
