// @mode: check
// Code after a loop that never completes is unreachable. It is not yet
// reported, because the checked-in bootstrap's checker demands a
// `return` there (#509).

export function deadReturn(n: i32): i32 {
  var i = 0;
  while (true) {
    i += 1;
    if (i == n) {
      return i;
    }
  }
  return 0; // @missing-error: Unreachable code detected.
}
