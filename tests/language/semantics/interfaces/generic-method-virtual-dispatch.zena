// @mode: check
// Generic methods dispatch through interface receivers: each solved
// type-argument list gets its own vtable slot (elematic/zena#116), so
// the call checks like any other interface method call.
import { Array } from 'zena:array';

let s: Array<i32> = [1, 2, 3];
let ok = s.map((x: i32): i32 => x + 1);
let okStrings = s.map((x: i32): String => 'n');

let okLength = s.length;
let okDirect = [1, 2, 3].map((x: i32): i32 => x + 1);

let bad = s.map((x: String): i32 => 0); // @error: Type mismatch: argument '(x: String) => i32' is not assignable to parameter '(i32, i32, Array<i32>) => i32'.
