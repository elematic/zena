// @mode: check
// Generic methods have no interface dispatch slot, so calling one
// through an interface receiver is rejected (it used to crash both
// compilers' codegen). Non-generic interface methods still dispatch,
// and the same generic method is fine on a concrete receiver.
import { Sequence } from 'zena:sequence';

let s: Sequence<i32> = [1, 2, 3];
let bad = s.map((x: i32): i32 => x + 1); // @error: Generic method 'map' cannot be called through interface 'Sequence'

let okContains = s.contains(2);
let okDirect = [1, 2, 3].map((x: i32): i32 => x + 1);
