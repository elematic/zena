// @mode: check
// A class implementing an interface with an overloaded method must
// implement every overload.
interface Measure {
  size(n: i32): i32;
  size(s: String): i32;
}
// @error: Class 'Partial' incorrectly implements interface 'Measure': Method 'size' has no overload of type '(String) => i32'.
class Partial implements Measure {
  size(n: i32): i32 { return n; }
}

class Complete implements Measure {
  size(n: i32): i32 { return n; }
  size(s: String): i32 { return s.length; }
}
