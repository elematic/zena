// @mode: check
//
// A class implements an interface's generic method whatever it calls
// the method's type parameter: `map<V>` satisfies `map<U>`. The class's
// parameter is inferred from the interface's through the callback's
// return type, and the signatures are then compared, never the
// parameters' names (issue #288).

interface Mapper {
  map<U>(f: (x: i32) => U): Array<U>;
}

class Doubler implements Mapper {
  map<V>(f: (x: i32) => V): FixedArray<V> {
    return [f(1), f(2)];
  }
}

export function main(): i32 {
  let m: Mapper = new Doubler();
  return m.map((x) => x + 1).length;
}
