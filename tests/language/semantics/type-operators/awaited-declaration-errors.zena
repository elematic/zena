// @mode: check

// Validation of the declared-operator form. Decorator errors report
// at the decorator; the arity error reports at the alias name, and a
// bodyless declaration without its operator decorator is meaningless.

@unknown('x') // @error: Unknown decorator '@unknown' on a type alias.
declare type A<T>;

@intrinsic('type.nope') // @error: Unknown type intrinsic 'type.nope'.
declare type B<T>;

@intrinsic('type.awaited')
declare type C<T, U>; // @error: The 'type.awaited' operator takes exactly one type parameter.

@intrinsic() // @error: Intrinsic decorator must have exactly one argument (the intrinsic name).
declare type D<T>;

declare type E<T>; // @error: A 'declare type' requires an @intrinsic type-operator decorator.
