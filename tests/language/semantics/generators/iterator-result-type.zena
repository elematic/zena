// @mode: check
// Calling a generator produces an Iterator<T> of the declared yield
// type; the value flows anywhere an Iterator<T> goes, including for-in.
import {Iterator} from 'zena:iterator';

let range = gen (start: i32, end: i32): Iterator<i32> => {
  var i = start;
  while (i < end) {
    yield i;
    i += 1;
  }
};

export let use = (): void => {
  let _it: Iterator<i32> = range(0, 3);
  for (let x in range(0, 3)) {
    let _y: i32 = x;
  }
};
