// @mode: check
// @skip: bootstrap
import {Iterator} from 'zena:iterator';

class Counter {
  limit: i32;
  new(this.limit);
  gen values(): i32 {
    var i = 0;
    while (i < this.limit) {
      yield i;
      i += 1;
    }
  }
}

export let use = (): void => {
  let c = new Counter(3);
  let _it: Iterator<i32> = c.values();
  for (let v in c.values()) {
    let _x: i32 = v;
  }
};
