// @mode: check
// Abstract field in a regular class should be rejected
// @error: Non-abstract class 'Foo' does not implement abstract field 'x'.
// @error: Non-abstract class 'Foo' does not implement abstract method 'get#x'.
class Foo {
  // @error: Abstract field 'x' can only appear within an abstract or sealed class.
  abstract x: i32;
}
