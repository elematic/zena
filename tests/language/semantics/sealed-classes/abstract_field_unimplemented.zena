// @mode: check
// Non-abstract subclass must implement abstract field
abstract class Node {
  abstract loc: i32;
}
// @error: Non-abstract class 'Literal' does not implement abstract method 'get#loc'.
class Literal extends Node { // @error: does not implement abstract field 'loc'
  value: i32;
  new(value: i32) : value = value, super() {}
}
