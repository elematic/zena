// @mode: check

import { Builder } from 'zena:core';

class MockEl {
  bind(prop: String): void {}
}

final class Box extends MockEl {
  var #gap: f32 = 0.0;
  static patch(inst: MockInst, idx: i32): Box { return new Box(); }
  addChild(child: MockEl): void {}
  gap: f32 {
    get { return this.#gap; }
    set(v) { this.#gap = v; }
  }
}

final class Text extends MockEl {
  var #content: String = '';
  new(content: String = '') : #content = content, super();
  static patch(inst: MockInst, idx: i32): Text { return new Text(); }
  content: String {
    get { return this.#content; }
    set(v) { this.#content = v; }
  }
}

final class MockTpl {
  instantiate(): MockInst { return new MockInst(); }
}

final class MockInst {
  react(fn: () => void): void {}
  setSlotChild(idx: i32, child: Widget): void {}
  bindSlot(idx: i32, fn: () => MockInst | null): void {}
}

final class MockUi {
  slot(): MockEl { return new MockEl(); }
  compile(root: MockEl): MockTpl { return new MockTpl(); }
}

class Widget {
  label: String;
  new(this.label);
}

let ui = new MockUi();
let notATag = 42;

function badBindingOutside(): i32 {
  return $(1 + 2); // @error: Binding expressions '$(...)' can only be used inside a staged '@' expression
}

final class PropKey<T> {
  name: String;
  new(this.name);
}

final class Entry {
  name: String;
  new(this.name);
}

final class OptedIn {
  x: f32;
  y: f32;

  static [Builder.entry]<T>(key: PropKey<T>, value: T): Entry {
    return new Entry(key.name);
  }

  new [Builder.construct]({ props, entries = [] }: {
    props: { x: f32, y: f32 },
    entries?: Array<Entry>,
  }) : x = props.x, y = props.y;
}

let colorKey = new PropKey<String>('color');

function badUntagged(): void {
  let a = Box { gap: 1.0 }; // @error: no 'new [Builder.construct]' constructor
  let b = OptedIn {
    x: $(1.0), // @error: Binding expressions '$(...)' can only be used inside a staged '@' expression
    y: 2.0,
  };
  let c = OptedIn {
    x: 1.0,
    y: 2.0,
    colorKey => 123, // @error: Type mismatch
  };
  let d = OptedIn { // @error: Field 'children' is not in
    x: 1.0,
    y: 2.0,
    OptedIn { x: 0.0 y: 0.0 }
  };
}

function badTag(): void {
  let _ = @notATag Box {}; // @error: is not a staged node-tree tag
}

function badProps(): MockInst {
  return @ui Box {
    unknownProp: 1, // @error: Property 'unknownProp' does not exist on type 'Box'
    gap: 'oops', // @error: Type mismatch in assignment
    gap: $('also oops'), // @error: Type mismatch in assignment
  };
}

function badLeafChildren(): MockInst {
  return @ui Text('hi') {
    Box {} // @error: 'Text' does not accept children
  };
}

function badWidgetPositionalBinding(s: String): MockInst {
  return @ui Box {
    Widget($(s)) // @error: cannot be passed as positional constructor arguments
  };
}
