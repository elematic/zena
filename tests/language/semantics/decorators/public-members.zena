// @mode: check
// A decorator adds nothing public to the host but the subject accessor.
decorator noisy<T>(var value: T) {
  var #value: T;
  reset(): void { // @error: only public member
  }
  other: i32 { // @error: only public member
    get { return 1; }
  }
  value: T {
    get { return this.#value; }
    set(v) { this.#value = v; }
  }
}
