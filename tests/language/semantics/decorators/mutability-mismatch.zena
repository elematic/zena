// @mode: check
decorator tracked<T>(var value: T) {
  var #value: T;
  value: T {
    get { return this.#value; }
    set(v) { this.#value = v; }
  }
}
decorator frozen<T>(value: T) {
  #value: T;
  value: T {
    get { return this.#value; }
  }
}
class C {
  @tracked count: i32 = 0; // @error: applies to 'var' fields
  @frozen var total: i32 = 0; // @error: applies to immutable fields
}
