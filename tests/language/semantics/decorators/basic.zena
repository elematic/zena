// @mode: check
decorator tracked<T>(var value: T) {
  var #value: T;
  var #version: i32 = 0;
  value: T {
    get { return this.#value; }
    set(v) {
      this.#value = v;
      this.#version += 1;
    }
  }
}

class Counter {
  @tracked var count: i32 = 0;
  @tracked var name: String = '';
}

let check = () => {
  let c = new Counter();
  let n: i32 = c.count;
  let s: String = c.name;
  c.count = n + 1;
  let bad: String = c.count; // @error: Type mismatch
};
