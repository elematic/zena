// @mode: check
class Reactive {
  requestUpdate(): void {}
}
decorator property<T>(var value: T) on Reactive {
  var #value: T;
  value: T {
    get { return this.#value; }
    set(v) {
      this.#value = v;
      this.requestUpdate();
    }
  }
}
class Plain {
  @property var count: i32 = 0; // @error: requires its class to extend or implement 'Reactive'
}
class Ok extends Reactive {
  @property var count: i32 = 0;
}
