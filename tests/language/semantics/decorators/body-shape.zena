// @mode: check
// A decorator's one public member is the subject accessor; its storage is
// the private field named after the subject.
decorator noAccessor<T>(var value: T) { // @error: must declare an accessor named 'value'
  var #value: T;
}
decorator noStorage<T>(var value: T) { // @error: must declare a private field '#value'
  value: T {
    get { return this.#other; }
    set(v) { this.#other = v; }
  }
  var #other: T;
}
decorator extraPublic<T>(var value: T) {
  var #value: T;
  extra: i32 = 0; // @error: only public member
  value: T {
    get { return this.#value; }
    set(v) { this.#value = v; }
  }
}
decorator missingSetter<T>(var value: T) {
  var #value: T;
  value: T { // @error: needs a setter
    get { return this.#value; }
  }
}
decorator unwantedSetter<T>(value: T) {
  #value: T;
  value: T { // @error: cannot have a setter
    get { return this.#value; }
    set(v) {}
  }
}
