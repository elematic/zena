// @mode: check
// `shared` members are private, are not the storage, and have types
// independent of the decorator's type parameters.
decorator bad<T>(var value: T) {
  shared var #value: T; // @error: cannot be 'shared'
  shared var #last: T; // @error: cannot mention the decorator's type parameters
  shared count: i32 = 0; // @error: only public member
  value: T {
    get { return this.#value; }
    set(v) { this.#value = v; }
  }
}
class C {
  shared var #x: i32 = 0; // @error: 'shared' applies only to a decorator's private members
  shared #m(): void {} // @error: 'shared' applies only to a decorator's private members
}
mixin M {
  shared var #y: i32 = 0; // @error: 'shared' applies only to a decorator's private members
}
