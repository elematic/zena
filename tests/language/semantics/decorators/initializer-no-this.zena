// @mode: check
// A decorator's field initializers run in the host's constructor before
// the body's `this` means anything, and may not read other fields. State
// derived from the decorated field's value is computed on first use
// instead. (Mixin field initializers have the same restriction.)
decorator doubled(var value: i32) {
  var #value: i32;
  var #initial: i32 = this.value; // @error: 'this' used outside of a class
  value: i32 {
    get { return this.#value + this.#initial; }
    set(v) { this.#value = v; }
  }
}
