// @mode: check
// A field named `shared` is still a field; `shared` is a modifier only
// when a member follows it.
decorator tracked<T>(var value: T) {
  var #value: T;
  shared var #writes: i32 = 0;
  shared #bump(): void { this.#writes += 1; }
  value: T {
    get { return this.#value; }
    set(v) {
      this.#value = v;
      this.#bump();
    }
  }
}
class C {
  shared: i32 = 1;
  @tracked var count: i32 = 0;
  @tracked var name: String = '';
}
let c = new C();
let n: i32 = c.shared + c.count;
