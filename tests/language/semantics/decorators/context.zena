// @mode: check

// `context` in a field decorator's body: the decorated field's name and
// its accessors as functions over the host. `set` exists only for a
// `var` subject, and the name is bound only inside a decorator body.
class Host {}

let noteName = (name: String): i32 => 0;
let noteGet = (get: (host: Host) => i32): i32 => 0;
let noteSet = (set: (host: Host, value: i32) => void): i32 => 0;

decorator counted(var value: i32) on Host {
  var #value: i32;
  var #a: i32 = noteName(context.name);
  var #b: i32 = noteGet(context.get);
  var #c: i32 = noteSet(context.set);
  var #d: i32 = context.name; // @error: Type mismatch
  value: i32 {
    get { return this.#value; }
    set(v) { this.#value = v; }
  }
}

decorator frozen(value: i32) on Host {
  #value: i32;
  var #a: i32 = noteGet(context.get);
  var #b: (host: Host, value: i32) => void = context.set; // @error: Property 'set' does not exist on record type
  value: i32 {
    get { return this.#value; }
  }
}

class Point extends Host {
  @counted var x: i32 = 1;
  @frozen y: i32 = 2;
}

let outside = context; // @error: Variable 'context' not found
