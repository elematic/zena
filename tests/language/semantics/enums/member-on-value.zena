// @mode: check
// An enum's members are read off the enum's name. A value of the enum
// has no members, and a name the enum does not declare is an error.
enum Color { Red, Green }
let c = Color.Red;
let d = c.Green; // @error: does not exist on type 'Color'
let e = Color.Purple; // @error: Enum 'Color' has no member 'Purple'
