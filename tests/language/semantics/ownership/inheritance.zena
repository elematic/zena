// @mode: check
// Resource-ness is inherited, and only from a resource. A mismatch in
// either direction lets a bare reference to a resource exist, which is
// the one thing the handle lattice is there to prevent.
import {Own, Disposable} from 'zena:ownership';

class Plain {
  v: i32;
  new(this.v);
  /** The leak: `this` is a spellable `Plain` inside `Plain`'s own body. */
  self(): Plain { return this; }
}

resource class Handle {
  var #n: i32;
  new(n: i32) : #n = n;
  value(): i32 { return this.#n; }
  :Disposable.dispose(): void {}
}

// A resource may extend a resource, and inherits its release action —
// naming a resource class in an extends clause is the one annotation
// position where the bare form is what is meant.
resource class Derived extends Handle {
  new() : super(2);
}

// A resource may also override the inherited one.
resource class Overriding extends Handle {
  new() : super(3);
  :Disposable.dispose(): void {}
}

// An ordinary superclass hands out bare aliases from inside its own
// methods, below the handle.
resource class OnPlain extends Plain {  // @error: cannot extend the ordinary class
  new() : super(1);
  :Disposable.dispose(): void {}
}

// An ordinary subclass of a resource has a spellable bare type.
class Escapee extends Handle {          // @error: must say so
  new() : super(4);
}
