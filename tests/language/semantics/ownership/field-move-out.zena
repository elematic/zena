// @mode: check
// Field move-out (ownership.md §Affine fields): inside a consuming
// method, `this.field` keeps its owner type. A dispose may move a
// non-null owner field out, at most once per path and on every path or
// none. Any other consuming method would leave the object without the
// field, so it may only take a nullable `var` one (field-take.zena).
// Everywhere else the read is a borrow.
import {Own, Borrow, Disposable} from 'zena:core';

resource class Res {
  id: i32;
  new(this.id);
  [Disposable.dispose](this: Own<this>): void {}
}

let sink = (r: Own<Res>): void => {};

// The blessed shape: dispose forwards a field; the glue skips it.
resource class Wrap {
  a: Own<Res>;
  b: Own<Res>;
  new(this.a, this.b);
  [Disposable.dispose](this: Own<this>): void {
    sink(this.a);
  }
}

// A second move on the same path is a use after move.
resource class Twice {
  a: Own<Res>;
  new(this.a);
  [Disposable.dispose](this: Own<this>): void {
    sink(this.a);
    sink(this.a); // @error: moved out
  }
}

// So is reading after the move.
resource class ReadAfter {
  a: Own<Res>;
  new(this.a);
  [Disposable.dispose](this: Own<this>): void {
    sink(this.a);
    let n = this.a.id; // @error: moved out
  }
}

// A conditional move has no single glue answer.
resource class Sometimes {
  a: Own<Res>;
  new(this.a);
  [Disposable.dispose](this: Own<this>): void {
    if (this.a.id > 0) {
      sink(this.a); // @error: on every path
    }
  }
}

// Outside dispose, moving a non-null field out would leave the object
// without it, and the object is released at the method's exit.
resource class Extract {
  a: Own<Res>;
  new(this.a);
  take(this: Own<this>): Own<Res> {
    return this.a; // @error: only a dispose
  }
  give(this: Own<this>): void {
    sink(this.a); // @error: only a dispose
  }
  [Disposable.dispose](this: Own<this>): void {}
}

// Outside a consuming method the read is still a borrow.
resource class Plainly {
  a: Own<Res>;
  new(this.a);
  peek(): void {
    sink(this.a); // @error: not assignable
  }
  [Disposable.dispose](this: Own<this>): void {}
}
