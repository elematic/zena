// @mode: check

// A `resource class` has no unwrapped form: every mention in a type position
// must be Own<T>, Borrow<T> or Unmanaged<T>. See docs/design/ownership.md
// §"Resource-ness and affineness are different properties".

import { Own, Borrow, Unmanaged, Disposable } from 'zena:ownership';

resource class Descriptor {
  [Disposable.dispose](this: Own<this>): void {}
}

// Ordinary classes are untouched.
class Plain {}

let takesOwn = (d: Own<Descriptor>): void => {};
let takesBorrow = (d: Borrow<Descriptor>): void => {};
let takesUnmanaged = (d: Unmanaged<Descriptor>): void => {};
let takesPlain = (p: Plain): void => {};

// @error: resource class
let bareParam = (d: Descriptor): void => {};

// @error: resource class
let bareReturn = (): Descriptor => {
  throw new Error('unreachable');
};

class Holder {
  // @error: resource class
  field: Descriptor;
  new(this.field);
}

// An *explicit type argument* may name a resource class bare — see
// ./resource-class-type-argument.zena — but the relaxation stops at the
// argument itself. Nested inside another generic it is an ordinary bare
// mention again: `Array<Descriptor>` is a container of unwrapped resources,
// which is exactly what has no spelling.
let takesNothing = <T>(): i32 => 0;

// @error: resource class
let nestedInArray = takesNothing<Array<Descriptor>>();

class Container<T> {
  new();
}

// @error: resource class
let nestedInNew = new Container<Array<Descriptor>>();
