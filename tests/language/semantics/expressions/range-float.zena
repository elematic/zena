// @mode: check
// Float and numeric range literals, mixed literal bounds, and rejected uses.
import {BoundedRange, FromRange, ToRange, FullRange, Range} from 'zena:core';

let r1: BoundedRange<f64> = 0.0..1.0;
let r2: BoundedRange<f64> = 0..1.0;
let r3: BoundedRange<f64> = 0.0..1;
let r4: BoundedRange<f32> = 0.0..1.0;
let r5: FromRange<f64> = 1.5..;
let r6: ToRange<f64> = ..2.5;
let r7: Range<f64> = 0.0..1.0;
let r8: Range<f64> = ..;
let r9: FullRange<f64> = ..;

let xi: i32 = 1;
let xf: f64 = 2.0;
let r10: BoundedRange<f64> = 0..xf;
let r11: BoundedRange<f64> = xf..10;

// Mismatched non-literal numeric types
let badMismatch = xi..xf; // @error: Range bounds must have the same type

// Non-numeric bounds
let badStart = 'a'..10; // @error: Range start must be a numeric type
let badEnd = 10..'z'; // @error: Range end must be a numeric type

// Float ranges are not iterable
export let main = (): void => {
  for (let x in 0.0..5.0) {} // @error: not iterable
  for (let x in 0.0..) {} // @error: not iterable
};
