// @mode: check
// Map literal creates HashMap with inferred key/value types
import { HashMap } from 'zena:collections';

interface Value {
  get(): i32;
}

class ConcreteValue implements Value {
  get(): i32 { return 42; }
}

let m: HashMap<String, i32> = {'a' => 1, 'b' => 2};

// Map literal with interface adaptation
let ifaceMap: HashMap<String, Value> = {'val' => new ConcreteValue()};


