// @mode: check

// `shielded` masks cancellation checkpoints, and sync code has none —
// the region is rejected there rather than accepted as dead ceremony.

let work = (): void => {};

let sync = (): i32 => {
  shielded { // @error: 'shielded' is only legal in an async function: it masks cancellation checkpoints, and sync code has none.
    work();
  }
  return 1;
};

let legal = async (): Future<i32> => {
  shielded {
    work();
  }
  return 0;
};
