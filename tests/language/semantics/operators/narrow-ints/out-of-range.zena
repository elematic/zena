// @mode: check
// An integer literal in a narrow context must fit that type. Narrow types
// exist to describe exact storage widths, so a literal that cannot be stored
// is a mistake worth reporting rather than silently wrapping.

let tooBigU8: u8 = 256; // @error: out of range
let negativeU8: u8 = -1; // @error: out of range
let tooBigU16: u16 = 65536; // @error: out of range
let tooBigI8: i8 = 128; // @error: out of range
let tooSmallI8: i8 = -129; // @error: out of range
let tooBigI16: i16 = 32768; // @error: out of range
let tooSmallI16: i16 = -32769; // @error: out of range

// The wider unsigned types are bounded the same way.
let tooBigU32: u32 = 4294967296; // @error: out of range
let negativeU32: u32 = -1; // @error: out of range
let negativeU64: u64 = -1; // @error: out of range
