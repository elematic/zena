// @mode: check
// Promotion happens within a signedness, never across it. u8 and i8 promote
// to u32 and i32 respectively, and those two do not combine — the same rule
// that already governs u32 with i32.

let addAcross = (a: u8, b: i8) => a + b; // @error: operator
let compareAcross = (a: u8, b: i8): boolean => a < b; // @error: operator
let addAcrossWide = (a: u8, b: i32) => a + b; // @error: operator
let addAcrossWideOther = (a: i8, b: u32) => a + b; // @error: operator
let mixNarrowWidths = (a: u16, b: i16) => a * b; // @error: operator
