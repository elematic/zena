// @mode: check
// `x == null` is the null test. A reference operand may always be
// tested — a redundant test is defensive, not wrong — but a value
// primitive has no null to find, so testing one is an error.

class Box {
  v: i32;
  new(this.v);
}

let maybe: Box | null = null;
let definitely = new Box(1);

// Nullable reference: the ordinary null test.
let a = maybe == null;
let b = maybe != null;

// Non-nullable reference: allowed. The static claim that it cannot be
// null is the thing being double-checked.
let c = definitely == null;
let d = definitely != null;

// null against null.
let e = null == null;

// Value primitives have no null representation.
let f = 42 == null; // @error: cannot apply operator
let g = null != 42; // @error: cannot apply operator
let h = true == null; // @error: cannot apply operator
let i = 1.5 != null; // @error: cannot apply operator
