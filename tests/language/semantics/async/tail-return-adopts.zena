// @mode: check

// tail return in an async body adopts: the operand must be the
// declared Future<T> itself, not the value type (async.md §8).

import { Future } from "zena:async";

async function good(): Future<i32> {
  tail return bad();
}

function seven(): i32 {
  return 7;
}

async function bad(): Future<i32> {
  tail return seven(); // @error: adopts
}
