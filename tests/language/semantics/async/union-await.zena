// @mode: check
// await on the maybe-async shape T | Future<T> (async.md §1).

let pick = (useFuture: boolean): String | Future<String> => {
  if (useFuture) {
    return Future.of('later');
  }
  return 'now';
};

let use = async (): Future<i32> => {
  let s: String = await pick(true);
  return s.length;
};
