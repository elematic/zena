// @mode: check
// @skip: bootstrap
import { Future, futureOf } from 'zena:async';

let outside = (): void => {
  let _x = await futureOf(1); // @error: 'await' is only valid inside the body of an 'async' function
};

let inTry = async (): Future<i32> => {
  try {
    let _y = await futureOf(1); // @error: 'await' may not appear inside 'try'
  } catch (e) {
    let _m = e;
  }
  return 0;
};

let nonFuture = async (): Future<i32> => {
  let _z = await 42; // @error: 'await' operand must be 'Future<T>' or 'T | Future<T>'
  return 0;
};

let inClosure = async (): Future<i32> => {
  let inner = (): void => {
    let _w = await futureOf(1); // @error: 'await' is only valid inside the body of an 'async' function
  };
  inner();
  return await futureOf(1);
};
