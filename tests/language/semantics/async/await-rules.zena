// @mode: check
import { Future } from 'zena:async';

let outside = (): void => {
  let _x = await Future.of(1); // @error: 'await' is only valid inside the body of an 'async' function
};

let nonFuture = async (): Future<i32> => {
  let _z = await 42; // @error: 'await' operand must be 'Future<T>' or a union with a 'Future' arm
  return 0;
};

let inClosure = async (): Future<i32> => {
  let inner = (): void => {
    let _w = await Future.of(1); // @error: 'await' is only valid inside the body of an 'async' function
  };
  inner();
  return await Future.of(1);
};
