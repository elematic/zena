// @mode: check
import { Future } from 'zena:async';

class Loader {
  async load(): Future<i32> {
    return await Future.of(1);
  }

  static async version(): Future<String> {
    return 'v1';
  }

  // @error: An async method requires a return type annotation of 'Future<T>'.
  async bare() { // @error: An async method requires a return type annotation of 'Future<T>'
    return 1;
  }
}

// Unannotated async functions infer T from the returns (no adoption
// while inferring: the returned expression's type is taken as-is).
let inferred = async () => {
  return 5;
};

let useInferred = async (): Future<i32> => {
  return await inferred();
};

let inferredVoid = async () => {};
