// @mode: check
// Future resolves from the standard prelude without explicit import.

async function compute(): Future<i32> {
  return 42;
}

let greet = async (name: String): Future<String> => {
  return 'Hello, ' + name;
};

export let test = async (): Future<i32> => {
  let f1: Future<i32> = Future.of(10);
  let f2 = compute();
  let results: Array<i32> = await Future.all([f1, f2]);
  let val: i32 = await compute();
  let msg: String = await greet('world');
  return val + results.length + msg.length;
};
