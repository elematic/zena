// @mode: check

class Holder<T> {
  value: T;
  new(this.value);
  static answer(): i32 { return 42; }
  static of(v: T): Holder<T> { return new Holder<T>(v); }
  static nothing(): Holder<T> | null { return null; }
}

class Plain {
  new();
  static answer(): i32 { return 1; }
}

// A static that cannot name T needs no binding.
let a: i32 = Holder.answer();

// The arguments determine T.
let b: Holder<i32> = Holder.of(7);

// ...or it is written on the receiver.
let c: Holder<String> = Holder<String>.of('hi');

// Nothing determines T, and the return type names it.
// @error: Cannot infer type argument 'T' for 'Holder' from the arguments; write 'Holder<...>.nothing(...)'.
let d = Holder.nothing();

// The written form fixes it.
let e: Holder<i32> | null = Holder<i32>.nothing();

// A non-generic class takes no type arguments.
// @error: 'Plain' is not generic, so it takes no type arguments here.
let f = Plain<i32>.answer();

// The arguments determine T, but not as the annotation says.
// @error: Type mismatch: 'Holder<String>' is not assignable to 'Holder<i32>'.
let g: Holder<i32> = Holder.of('nope');
