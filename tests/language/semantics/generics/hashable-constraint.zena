// @mode: check
import {HashMap} from 'zena:map';
import {HashSet} from 'zena:set';

class ExplicitKey implements Hashable {
  v: i32;
  new(this.v);
  hashCode(): i32 { return this.v; }
}

class CaseKey(a: i32, b: String)

class PlainClass {
  v: i32;
  new(this.v);
}

enum Color { Red, Green, Blue }

distinct type UserId = i32;
distinct type Tag = String;

// Satisfying key types: primitives, String, enums, distinct types,
// case classes, and classes that implement Hashable.
let m1 = new HashMap<String, i32>();
let m2 = new HashMap<i32, i32>();
let m3 = new HashMap<ExplicitKey, i32>();
let m4 = new HashMap<CaseKey, i32>();
let m5 = new HashMap<Color, i32>();
let m6 = new HashMap<UserId, i32>();
let m7 = new HashMap<Tag, i32>();
let m8 = new HashMap<i64, i32>();
let m9 = new HashMap<f64, i32>();
let s1 = new HashSet<boolean>();
let s2 = new HashSet<u32>();
let s3 = new HashSet<f32>();

// Case classes are assignable to Hashable without an implements clause.
let h: Hashable = new CaseKey(1, 'x');

// A constrained type parameter can propagate the constraint.
class Wrapper<T extends Hashable> {
  map = new HashMap<T, i32>();
}

let bad1 = new HashMap<PlainClass, i32>(); // @error: does not satisfy constraint
