// @mode: check
// Type arguments inferred from non-closure arguments give an untyped
// closure argument its contextual parameter types: T is Item from
// `items`, so `(a, b)` below is checked at `(Item, Item) => i32`.

class Item {
  name: String;
  new(this.name);
}

let sortBy = <T>(items: Array<T>, compare: (a: T, b: T) => i32): void => {};

let go = (items: Array<Item>): void => {
  sortBy(items, (a, b) => a.name.length - b.name.length);
};
