// @mode: check
// A closure is the only argument, so nothing fixes T before the closure
// is checked; its parameters stay typed as the bare type parameter and
// member access on them is an error.

class Thing {
  name: String;
  new(this.name);
}

let sortOnly = <T>(compare: (a: T, b: T) => i32): void => {};

let go = (): void => {
  sortOnly((a, b) => {
    return a.name.length; // @error: Property 'name' does not exist on type 'T'
  });
};
