// @mode: check
class Box<T> {
  value: T;
  new(this.value);
}

// @error: Type mismatch: argument 'FixedArray<i32>' is not assignable to parameter 'Sequence<T>'.
// @error: Type mismatch: 'Array<T>' is not assignable to 'Array<i32>'.
let arr: Array<i32> = Array.from([1, 2, 3]);
var b: Box<Array<i32>> = new Box<Array<i32>>(arr);
// @error: Type mismatch: argument 'FixedArray<String>' is not assignable to parameter 'Sequence<T>'.
// @error: Type mismatch: argument 'Array<T>' is not assignable to parameter 'Array<String>'.
let b2: Box<Array<String>> = new Box<Array<String>>(Array.from(["hi"]));

b = b2; // @error: Type mismatch
