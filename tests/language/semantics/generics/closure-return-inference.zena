// @mode: check
// A closure argument's return type participates in inference once its
// parameters are typed from the other arguments: T is Item from
// `items`, then U is i32 from the closure's body.

class Item {
  name: String;
  new(this.name);
}

let firstMapped = <T, U>(items: Array<T>, f: (x: T) => U): U => f(items[0]);

let go = (items: Array<Item>): void => {
  let n: i32 = firstMapped(items, (item) => item.name.length);
  let s: String = firstMapped(items, (item) => item.name.length); // @error: Type mismatch
};
