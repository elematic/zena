// @mode: check
class Box<T> {
  #val: T;
  // @error: Field '#val' must be initialized. Add an initializer or a constructor.
  new(val: T) {
    // @error: Cannot assign to read-only property '#val'.
    this.#val = val;
  }

  getVal(): T {
    return this.#val;
  }
}

let b = new Box<i32>(42);
let x: i32 = b.getVal();
let y: i32 = b.#val; // @error: can only be accessed within a class
