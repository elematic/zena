// @mode: check
// Index access resolves through a type parameter's bound; an
// unconstrained parameter still supports none.
import { Array } from 'zena:array';

function first<A extends Array<i32>>(arr: A): i32 {
  return arr[0];
}

function bad<T>(x: T): i32 {
  return x[0]; // @error: Index access not supported on type 'T'.
}
