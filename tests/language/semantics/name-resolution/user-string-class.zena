// @mode: check
//
// A program's own `String` is a class like any other: `__LOCATION__`
// and template literals are the standard library's `String`, not this
// one, so neither fits a slot annotated with it (issue #288).

class String {}

function located(where: String | null = __LOCATION__): i32 { // @error: not assignable
  return 0;
}

export function main(): i32 {
  let text: String = `one`; // @error: not assignable
  return located();
}
