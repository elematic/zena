// @mode: check
//
// Two modules' `distinct type Meters = i32` are two types: a distinct
// alias is the declaration, not the name (issue #288).

import { Meters as TheirMeters } from './distinct_alias_helper.zena';

distinct type Meters = i32;

export function main(): i32 {
  let mine: Meters = 3 as Meters;
  let theirs: TheirMeters = mine; // @error: Type mismatch
  let same: Meters = mine;
  return (theirs as i32) + (same as i32);
}
