// @target: module
abstract class Stack {
  var size: i32;

  new(this.size) requires (size >= 0);

  new filled(count: i32) requires (count > 0) : size = count {}

  pop(): i32
    requires (this.size > 0)
    ensures (this.size == old(this.size) - 1)
  {
    this.size -= 1;
    return 0;
  }

  static empty(): Stack ensures (result.size == 0) {
    return new Stack(0);
  }

  abstract peek(): i32 requires (this.size > 0);
}
