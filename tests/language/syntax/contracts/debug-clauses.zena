// @target: module
function search(items: FixedArray<i32>, target: i32): i32
  requires (items.length > 0)
  debug requires (isSorted(items))
  debug ensures (result < items.length)
{
  var lo = 0;
  while (lo < items.length)
    invariant (lo >= 0)
    debug invariant (isSorted(items))
  {
    lo += 1;
  }
  for (let item in items) debug invariant (lo >= 0) {
    lo += item;
  }
  return lo;
}

let half = (n: i32) debug requires (n % 2 == 0) => n >> 1;
