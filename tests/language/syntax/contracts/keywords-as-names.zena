// @target: module
// `requires`, `ensures` and `invariant` are contextual. As names they
// parse as before, and a loop whose body is a call to a function named
// `invariant` is still that call.
function check(requires: i32, ensures: i32, invariant: (x: i32) => void): i32 {
  while (requires < ensures) invariant(requires);
  let result = requires + ensures;
  invariant(result);
  return ensures(requires);
}
