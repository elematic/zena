// @target: module
// `debug` is contextual: a modifier only in front of a clause keyword.
// As a name it parses as before, and a loop whose body calls a function
// named `debug` is still that call.
function trace(debug: (x: i32) => void, requires: i32): i32 {
  while (requires > 0) debug(requires);
  debug(requires);
  let invariant = debug;
  return requires;
}
