// @target: module
function search(items: FixedArray<i32>, target: i32): i32
  requires (items.length > 0)
  static requires (isSorted(items))
  static ensures (result < 0 || items[result] == target)
{
  var lo = 0;
  while (lo < items.length)
    invariant (lo >= 0)
    static invariant (isSorted(items))
  {
    lo += 1;
  }
  for (let item in items) static invariant (lo >= 0) {
    lo += item;
  }
  return lo;
}

let half = (n: i32) static requires (n % 2 == 0) => n >> 1;

class Stack {
  var size: i32;
  new(this.size) static requires (size >= 0);
  pop(): i32 static ensures (this.size == old(this.size) - 1) {
    this.size -= 1;
    return 0;
  }
  // A `static` member after a method with a clause is still a member.
  static empty(): Stack {
    return new Stack(0);
  }
}
