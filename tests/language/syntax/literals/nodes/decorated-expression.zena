// @target: module
function render(): void {
  let a = @ui Box {
    gap: 8.0,
    Text('Hello')
  };
  let b = @ui Text('Hello');
  let c = @a @b Box {};
  let d = @mat[[1, 2], [3, 4]];
  let e = @Complex{re: 1.0, im: 2.0};
  let f = @retry(3) fetch(url);
  let g = @tag (a + b);
  let h = @memo (x: i32) => x * 2;
  @ui Box {
    Slot {}
  }
