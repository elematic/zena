// @target: statement
let tree = Column {
  style: panelStyle,
  gap: 8.0,

  Row {
    style: headerStyle,
    Text('Hello')
    Text(this.#title) { style: titleStyle }
    $(if (this.#badge != null) {
      @ui Badge(this.#badge)
    } else {
      null
    })
  }
  ui.Divider {}
  List<Item>(items) { gap: 4.0 }
  Slot {}
};
