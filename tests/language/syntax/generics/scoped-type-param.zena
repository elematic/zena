// @target: module
// The `scoped` type-parameter modifier is contextual: it binds only
// when another identifier follows, so a parameter named `scoped`
// still parses.
let keep = <scoped T>(x: T): T => {
  return x;
};

let bounded = <scoped T extends Disposable, U>(x: T, y: U): T => {
  return x;
};

let named = <scoped>(x: scoped): scoped => x;

class Channel<scoped T> {
  new();
}
