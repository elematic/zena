// @target: statement
// @skip: bootstrap
class Counter {
  limit: i32;
  new(this.limit);
  gen values(): i32 {
    var i = 0;
    while (i < this.limit) {
      yield i;
      i += 1;
    }
  }
  static gen upTo(n: i32): i32 {
    var i = 0;
    while (i < n) {
      yield i;
      i += 1;
    }
  }
}
