// @mode: run
// @result: 1236
// @skip: bootstrap
// Generator methods: instance state via this, static gen methods, and
// fields live across yields.
class Counter {
  limit: i32;
  new(this.limit);

  gen values(): Iterator<i32> {
    var i = 1;
    while (i <= this.limit) {
      yield i;
      i += 1;
    }
  }

  static gen twice(x: i32): Iterator<i32> {
    yield x;
    yield x * 2;
  }
}

export let main = (): i32 => {
  let c = new Counter(3);
  var acc = 0;
  for (let v in c.values()) {
    acc = acc * 10 + v;
  }
  var s = 0;
  for (let v in Counter.twice(2)) {
    s += v;
  }
  return acc * 10 + s;
};
