// @mode: run
// @stdout: alpha\nbeta\ngamma\ndone
// Reference yield type: the multi-value payload slot is nullable at the
// wasm level (the false arm carries no value), so binding must cast in
// the taken branch only.

let words = gen (): Iterator<String> => {
  yield 'alpha';
  yield 'beta';
  yield 'gamma';
};

export let main = (): void => {
  for (let w in words()) {
    console.log(w);
  }
  let it = words();
  match (it.next()) {
    // consume one, then drop the iterator (no disposal protocol).
    case (1, let _w, _): {}
    case _: {}
  }
  console.log('done');
};
