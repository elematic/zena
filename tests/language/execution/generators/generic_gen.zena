// @mode: run
// @result: 305
// Generic generators: each reached instantiation gets its own frame
// and Iterator<T> plumbing via the specialization machinery.
import { Iterator } from 'zena:iterator';

let pair = gen <T>(first: T, second: T): Iterator<T> => {
  yield first;
  yield second;
};

export let main = (): i32 => {
  var acc = 0;
  for (let v in pair(10, 20)) { acc += v; } // 30
  var len = 0;
  for (let s in pair('ab', 'cde')) { len += s.length; } // 2 + 3
  return acc * 10 + len; // 30 * 10 + 5 = 305
};
