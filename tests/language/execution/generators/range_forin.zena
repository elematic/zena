// @mode: run
// @result: 10
// The canonical generator: params live across the yield, consumed by
// for-in through the Iterator interface path.
let range = gen (start: i32, end: i32): Iterator<i32> => {
  var i = start;
  while (i < end) {
    yield i;
    i += 1;
  }
};

export let main = (): i32 => {
  var sum = 0;
  for (let i in range(0, 5)) {
    sum += i;
  }
  return sum;
};
