// @mode: run
// @result: 10

class A {
  x: i32;
  new(this.x);
}

class B {
  y: i32;
  new(this.y);
}

let testClassPattern = (obj: A | B): i32 => {
  return match (obj) {
    case A { x }: x
    case B { y }: y + 100
  };
};

let testClassPatternRename = (obj: A | B): i32 => {
  return match (obj) {
    case A { x as v }: v
    case B { y as v }: v + 100
  };
};

let testClassPatternWildcard = (obj: A): i32 => {
  return match (obj) {
    case A { x: _ }: 1
  };
};

export let main = (): i32 => {
  let objA = new A(10);
  let objB = new B(20);

  if (testClassPattern(objA) != 10) return 1;
  if (testClassPattern(objB) != 120) return 2;
  if (testClassPatternRename(objA) != 10) return 1;
  if (testClassPatternRename(objB) != 120) return 2;
  if (testClassPatternWildcard(objA) != 1) return 3;

  return 10;
};
