// @mode: run
// @result: 10

let testWildcard = (x: i32): i32 => {
  return match (x) {
    case _: 1
  };
};

let testBinding = (x: i32): i32 => {
  return match (x) {
    case y: y + 1
  };
};

let testNumberLiteral = (x: i32): i32 => {
  return match (x) {
    case 10: 100
    case _: 0
  };
};

let testBooleanLiteral = (x: boolean): i32 => {
  return match (x) {
    case true: 10
    case false: 20
  };
};

let testStringLiteral = (x: String): i32 => {
  return match (x) {
    case "hello": 1000
    case "world": 2000
    case _: 0
  };
};

export let main = (): i32 => {
  if (testWildcard(10) != 1) return 1;
  if (testBinding(10) != 11) return 2;
  if (testNumberLiteral(10) != 100) return 3;
  if (testNumberLiteral(5) != 0) return 4;
  if (testBooleanLiteral(true) != 10) return 5;
  if (testBooleanLiteral(false) != 20) return 6;
  if (testStringLiteral("hello") != 1000) return 7;
  if (testStringLiteral("world") != 2000) return 8;
  if (testStringLiteral("something") != 0) return 9;
  return 10;
};
