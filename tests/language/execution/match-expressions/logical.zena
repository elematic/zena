// @mode: run
// @result: 10

class Point {
  x: i32;
  y: i32;
  new(this.x, this.y);
}

let testLogicalOr = (x: i32): i32 => {
  return match (x) {
    case 1 | 2: 100
    case _: 0
  };
};

let testLogicalOrBinding = (x: i32): i32 => {
  return match (x) {
    case (10 as y) | (20 as y): y
    case _: 0
  };
};

let testLogicalAnd = (p: Point): i32 => {
  return match (p) {
    case Point { x: _ } & Point { x: 10 }: 1
    case _: 0
  };
};

let testLogicalAndBindings = (p: Point): i32 => {
  return match (p) {
    case Point { x } & Point { y }: x + y
    case _: 0
  };
};

export let main = (): i32 => {
  if (testLogicalOr(2) != 100) return 1;
  if (testLogicalOr(1) != 100) return 2;
  if (testLogicalOr(3) != 0) return 3;

  if (testLogicalOrBinding(10) != 10) return 4;
  if (testLogicalOrBinding(20) != 20) return 5;
  if (testLogicalOrBinding(30) != 0) return 6;

  let p1 = new Point(10, 20);
  let p2 = new Point(5, 20);
  if (testLogicalAnd(p1) != 1) return 7;
  if (testLogicalAnd(p2) != 0) return 8;

  if (testLogicalAndBindings(p1) != 30) return 9;

  return 10;
};
