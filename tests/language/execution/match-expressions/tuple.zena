// @mode: run
// @result: 10

let testTuplePattern = (t: (i32, i32)): i32 => {
  return match (t) {
    case let (10, y): y
    case _: 0
  };
};

let testTuplePatternNested = (t: (i32, (i32, i32))): i32 => {
  return match (t) {
    case let (10, (x, y)): x + y
    case _: 0
  };
};

export let main = (): i32 => {
  let t1 = (10, 20);
  let t2 = (5, 20);
  if (testTuplePattern(t1) != 20) return 1;
  if (testTuplePattern(t2) != 0) return 2;

  let tn1 = (10, (20, 30));
  let tn2 = (5, (20, 30));
  if (testTuplePatternNested(tn1) != 50) return 3;
  if (testTuplePatternNested(tn2) != 0) return 4;

  return 10;
};
