// @mode: run
// @skip: bootstrap
// @result: 10

let testR = (r: { a: i32, b: i32 }): i32 => {
  return match (r) {
    case { a: 10, b as y }: y
    case _: 0
  };
};

let testRn = (r: { a: { x: i32 }, b: i32 }): i32 => {
  return match (r) {
    case { a: { x: 10 }, b as y }: y
    case _: 0
  };
};

export let main = (): i32 => {
  let r1 = { a: 10, b: 20 };
  let r2 = { a: 5, b: 20 };

  if (testR(r1) != 20) return 1;
  if (testR(r2) != 0) return 2;

  let rn1 = { a: { x: 10 }, b: 30 };
  let rn2 = { a: { x: 5 }, b: 30 };

  if (testRn(rn1) != 30) return 3;
  if (testRn(rn2) != 0) return 4;

  return 10;
};

