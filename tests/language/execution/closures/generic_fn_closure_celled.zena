// @mode: run
// @result: 7

let counter = <T>(start: T, next: (v: T) => T): () => T => {
  var current = start;
  return () => {
    current = next(current);
    return current;
  };
};

export let main = (): i32 => {
  let tick = counter(1, (v: i32): i32 => v + 2);
  tick();
  tick();
  let last = tick();
  return last;
};
