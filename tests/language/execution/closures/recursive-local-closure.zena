// @mode: run
// @result: 63
// Local function expressions may reference their own binding (the
// closure captures the variable through a pre-allocated cell that the
// declaration writes through) and bindings declared later in the same
// scope (forward references between sibling closures). wit-parser's
// ast-json.zena uses recursive local `visit` closures for topological
// sorts; the bootstrap has always accepted both shapes.

export let main = (): i32 => {
  let fib = (n: i32): i32 => {
    if (n < 2) {
      return n;
    }
    return fib(n - 1) + fib(n - 2);
  };
  let a = (): i32 => b() + 1;
  let b = (): i32 => 7;
  return fib(10) + a();
};
