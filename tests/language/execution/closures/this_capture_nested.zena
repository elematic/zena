// @mode: run
// @result: 9

class Outer {
  value: i32 = 3;

  createNested(): () => i32 {
    // Outer closure captures this, inner returns value
    return () => this.value * this.value;
  }
}

export let main = () => {
  let o = new Outer();
  let inner = o.createNested();
  return inner();  // 3 * 3 = 9
};
