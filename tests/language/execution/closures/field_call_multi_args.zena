// @mode: run
// @result: 42

class Calculator {
  operation: (a: i32, b: i32) => i32;
  new(op: (a: i32, b: i32) => i32) : operation = op {}
  compute(a: i32, b: i32): i32 {
    return this.operation(a, b);
  }
}

export let main = (): i32 => {
  let add = (a: i32, b: i32): i32 => a + b;
  let calc = new Calculator(add);
  return calc.compute(20, 22);
};
