// @mode: run
// @result: 20

class Helper {
  var state: i32 = 5;

  #double() {
    this.state = this.state * 2;
  }

  makeDoubler(): () => i32 {
    // Returns a closure that captures 'this' and calls private method
    return () => {
      this.#double();
      return this.state;
    };
  }
}

export let main = () => {
  let h = new Helper();
  let doubler = h.makeDoubler();
  doubler();  // 5 * 2 = 10
  return doubler();  // 10 * 2 = 20
};
