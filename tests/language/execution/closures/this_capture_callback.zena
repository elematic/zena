// @mode: run
// @result: 10

class Parser {
  var count: i32 = 0;

  parse(): i32 {
    this.count = this.count + 10;
    return this.count;
  }
}

let runCallback = (cb: () => i32) => cb();

export let main = () => {
  let p = new Parser();
  // Create a closure that captures 'p' and calls a method on it
  let callback = () => p.parse();
  return runCallback(callback);
};
