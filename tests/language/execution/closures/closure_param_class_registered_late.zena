// @mode: run
// @result: 42
// A closure's wasm signature was computed from its parameter types when
// reachability first met it. A class those types name that nothing had
// registered yet, here GrowableArray<String>, mapped to a bare structref,
// while the closure's pair struct, made later from the registered class,
// was keyed by the class: lowering then found no pair struct for the
// closure ("closure pair struct not found", #322). Whether a program hit
// it depended on the order reachability walked it; this one, with the
// closures in an imported module, did.

import { Query } from './closure_param_class_registered_late_query.zena';

export let main = (): i32 => {
  let query = new Query().where(1).where(2).limit(10);
  return 42;
};
