// @mode: run
// @result: 3
// @skip: a closure does not see a module-level let declared below its function (#1106)

// A closure in a function reads a module-level `let` declared below the
// function, as a function's own body may.

export function main(): i32 {
  let read = () => LIMIT + 1;
  return read();
}

let LIMIT = 2;
