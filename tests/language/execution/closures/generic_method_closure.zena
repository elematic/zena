// @mode: run
// @result: 10

class Box<T> {
  item: T;
  new(item: T) : item = item {}
  mapped<R>(f: (v: T) => R): () => R {
    return () => f(this.item);
  }
}

export let main = (): i32 => {
  let b = new Box<i32>(3);
  let doubled = b.mapped((v: i32): i32 => v * 2);
  let named = b.mapped((v: i32): String => "wide");
  return doubled() + named().length;
};
