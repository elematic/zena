// @mode: run
// @result: 42

class Effect {
  action: (x: i32) => void;
  result: i32;
  new(action: (x: i32) => void) : action = action, result = 0 {}
  run(x: i32): void {
    this.action(x);
  }
}

var globalResult: i32 = 0;

export let main = (): i32 => {
  let setResult = (x: i32): void => { globalResult = x; };
  let effect = new Effect(setResult);
  effect.run(42);
  return globalResult;
};
