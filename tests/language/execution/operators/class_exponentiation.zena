// @mode: run
// @result: 42

class ModuloNumber {
  val: i32;
  new(this.val);

  operator **(exp: i32): ModuloNumber {
    var res = 1;
    var b = this.val;
    var e = exp;
    while (e > 0) {
      if ((e & 1) != 0) {
        res = (res * b) % 100;
      }
      b = (b * b) % 100;
      e = e >> 1;
    }
    return new ModuloNumber(res);
  }
}

export let main = (): i32 => {
  let num = new ModuloNumber(2);
  return (num ** 17).val - 30;
};

