// @mode: run
// @result: 654321
// Three shapes from one ZIR slice: reference `as` casts (upcast
// pass-through, trapping downcast, nullable-source downcast),
// identity == on classes with no operator== (including through
// `X | null`, where null == null must hold), and operators on numeric
// enums (i32 representation).

enum Color {
  Red,
  Green,
  Blue,
}

class Animal {
  legs: i32;
  new(this.legs);
}

class Dog extends Animal {
  new() : super(4);
}

export let main = (): i32 => {
  var acc = 0;
  let d = new Dog();
  let a: Animal = d;                    // upcast: no cast emitted
  let back = a as Dog;                  // downcast: ref.cast
  if (back.legs == 4) { acc += 1; }
  var maybe: Animal | null = d;
  if (maybe != null) {
    let d3 = maybe as Dog;              // nullable source, trapping cast
    if (d3.legs == 4) { acc += 20; }
  }
  let d2 = new Dog();
  if (d != d2 && d == d && !(d == d2)) { acc += 300; }   // identity ==
  var n1: Animal | null = null;
  var n2: Animal | null = null;
  if (n1 == n2) { acc += 4000; }        // null == null through X | null
  n1 = d;
  if (n1 != n2 && n1 == d) { acc += 50000; }
  let c = Color.Green;
  if (c == Color.Green && c != Color.Blue) { acc += 600000; }
  return acc;
};
