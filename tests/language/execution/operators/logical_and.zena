// @mode: run
// @result: 0

var sideEffect: i32 = 0;

let incrementSideEffect = (): boolean => {
  sideEffect += 1;
  return true;
};

export let main = (): i32 => {
  // 1. Basic behavior
  if (!(true && true)) return 1;
  if (true && false) return 2;
  if (false && true) return 3;
  if (false && false) return 4;

  // 2. Short-circuiting behavior: left is false, right should NOT run
  let r1 = false && incrementSideEffect();
  if (r1) return 5;
  if (sideEffect != 0) return 6;

  // 3. No short-circuiting: left is true, right should run
  let r2 = true && incrementSideEffect();
  if (!r2) return 7;
  if (sideEffect != 1) return 8;

  return 0;
};
