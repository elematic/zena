// @mode: run
// @result: 0

class Box<T> {
  value: T;
  new(this.value);
}

export let main = (): i32 => {
  let b1: anyref = new Box<i32>(42);
  let b2: anyref = new Box<String>('hello');

  if (!(b1 is Box<i32>)) return 1;
  if (b1 is Box<String>) return 2;
  
  if (!(b2 is Box<String>)) return 3;
  if (b2 is Box<i32>) return 4;

  let casted1 = b1 as Box<i32>;
  if (casted1.value != 42) return 5;

  let casted2 = b2 as Box<String>;
  if (casted2.value != 'hello') return 6;

  return 0;
};
