// @mode: run
// @result: 127
// Class operator members as method calls (member-lookup.md §5.5):
// String concat and equality through String.+ / String.==, custom
// operator + and == on a user class, and != as inverted ==.

final class Vec {
  x: i32;
  new(this.x);
  operator +(o: Vec): Vec {
    return new Vec(this.x + o.x);
  }
  operator ==(o: Vec): boolean {
    return this.x == o.x;
  }
}

export let main = (): i32 => {
  var acc = 0;
  let s = "ab" + "cd";
  if (s.length == 4) { acc += 1; }
  if (s == "abcd") { acc += 2; }
  if (s != "wxyz") { acc += 4; }
  let v = new Vec(3) + new Vec(4);
  if (v.x == 7) { acc += 8; }
  if (v == new Vec(7)) { acc += 16; }
  if (v != new Vec(9)) { acc += 32; }
  let t = s + "!";
  if (t == "abcd!") { acc += 64; }
  return acc;
};
