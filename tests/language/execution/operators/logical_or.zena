// @mode: run
// @result: 0

var sideEffect: i32 = 0;

let incrementSideEffect = (): boolean => {
  sideEffect += 1;
  return true;
};

export let main = (): i32 => {
  let t: boolean = true;
  let f: boolean = false;

  // 1. Basic behavior
  if (!(t || t)) return 1;
  if (!(t || f)) return 2;
  if (!(f || t)) return 3;
  if (f || f) return 4;

  // 2. Short-circuiting behavior: left is true, right should NOT run
  let r1 = t || incrementSideEffect();
  if (!r1) return 5;
  if (sideEffect != 0) return 6;

  // 3. No short-circuiting: left is false, right should run
  let r2 = f || incrementSideEffect();
  if (!r2) return 7;
  if (sideEffect != 1) return 8;

  return 0;
};
