// @mode: run
// @result: 42

// Opacity is a compile-time restriction only. Like `distinct`, an opaque type
// is erased before codegen, so casting into and out of it is free and the
// value that comes back out is the one that went in.
opaque type Meters = i32;

let scale = (m: Meters, by: i32): Meters => ((m as i32) * by) as Meters;

export let main = (): i32 => {
  let a = 21 as Meters;
  let b = scale(a, 2);
  return b as i32;
};
