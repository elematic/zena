// @mode: run
// @result: 1

// The record twin of member_null: primitive record members behind ?.
// coalesce immediately.

export let main = (): i32 => {
  let missing: {x: i32, y: i32} | null = null;
  let a = missing?.x ?? 7;

  let present: {x: i32, y: i32} | null = {x: 3, y: 4};
  let b = present?.x ?? 7;

  if (a == 7 && b == 3) { return 1; }
  return 0;
};
