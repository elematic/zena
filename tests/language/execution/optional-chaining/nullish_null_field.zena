// @mode: run
// @result: 0
// @skip: `p?.f ?? d` traps with a null reference when `p` is present and its field `f` is null (#1031)

// `p?.f ?? d` is `d` when `p` is null and when its field `f` is null, and
// `f` otherwise.

final class Profile {
  license: String | null;
  new(this.license);
}

function licenseOf(profile: Profile | null): String {
  return profile?.license ?? '-';
}

export function main(): i32 {
  if (licenseOf(null) != '-') {
    return 1;
  }
  if (licenseOf(new Profile('MIT')) != 'MIT') {
    return 2;
  }
  if (licenseOf(new Profile(null)) != '-') {
    return 3;
  }
  return 0;
}
