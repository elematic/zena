// @mode: run
// @result: 1

// Optional access to a primitive member requires immediate
// coalescence: the miss becomes the ?? arm, so `i32 | null` never
// exists as a value.

class Point {
  x: i32 = 0;
  y: i32 = 0;
  new(x: i32, y: i32) : x = x, y = y;
}

export let main = (): i32 => {
  let missing: Point | null = null;
  let a = missing?.x ?? 7;

  let present: Point | null = new Point(3, 4);
  let b = present?.x ?? 7;

  // a = 7 (miss), b = 3 (hit)
  if (a == 7 && b == 3) { return 1; }
  return 0;
};
