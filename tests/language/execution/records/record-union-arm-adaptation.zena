// @mode: run
// @invoke: main
// @result: 13

// An unannotated `if` with differently shaped record arms has the union
// of their types, and each member of that union has its own layout. A
// record-typed use picks the member the value is at run time and adapts
// that member to the shape it reads.
//
// optional_if_arms.zena covers the annotated form, where the arms are
// built in the declared shape and there is no union to adapt.

type Named = {name: String};
type MaybeRanked = {name: String, rank?: i32};

let nameLength = (o: Named): i32 => {
  return o.name.length;
};

let rankOf = (o: MaybeRanked): i32 => {
  let {rank = 9} = o;
  return rank;
};

/** The members differ in width; the target has neither field optional. */
let widthDiffers = (): i32 => {
  let o = if (nameLength({name: 'ab'}) == 2) {
    {name: 'abc', rank: 1}
  } else {
    {name: 'ab'}
  };
  return nameLength(o);
};

/** The same union, against a target that declares the extra field optional. */
let againstOptional = (taken: boolean): i32 => {
  let o = if (taken) {
    {name: 'abc', rank: 1}
  } else {
    {name: 'ab'}
  };
  return rankOf(o);
};

export let main = (): i32 => {
  // 3 + 1 + 9
  return widthDiffers() + againstOptional(true) + againstOptional(false);
};
