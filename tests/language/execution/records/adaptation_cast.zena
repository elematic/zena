// @mode: run
// @invoke: main
// @result: 7

type AdaptedRecord = { name: String, val: String | null };

let getAdapted = (n: String): AdaptedRecord => {
  return { name: n, val: null };
};

let processAdapted = (r: AdaptedRecord): i32 => {
  if (r.val == null) {
    return r.name.length;
  }
  return 0;
};

export let main = (): i32 => {
  let r1 = getAdapted("hello"); // length = 5
  
  let r2: AdaptedRecord = { name: "ab", val: null }; // length = 2
  
  return processAdapted(r1) + processAdapted(r2); // 5 + 2 = 7
};
