// @mode: run
// @result: 1
// A callee that keeps, returns or captures its record parameter needs
// the record itself, so its parameter is not passed as fields. Those
// callees still compute the same thing when called with literals.

type Point = {x: i32, y: i32};

var kept: Point | null = null;

let keep = (p: Point): i32 => {
  kept = p;
  return p.x;
};

let identity = (p: Point): Point => p;

let later = (p: Point): () => i32 => () => p.x + p.y;

let passOn = (p: Point): i32 => keep(p) + p.y;

export let main = (): i32 => {
  if (keep({x: 1, y: 2}) != 1) {
    return 0;
  }
  let k = kept;
  if (k == null || k.y != 2) {
    return 0;
  }
  if (identity({x: 3, y: 4}).y != 4) {
    return 0;
  }
  let f = later({x: 5, y: 6});
  if (f() != 11) {
    return 0;
  }
  if (passOn({x: 7, y: 8}) != 15) {
    return 0;
  }
  return 1;
};
