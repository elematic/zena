// @mode: run
// @result: 1
// A record passed on whole to a function that only reads its fields is
// itself only read for its fields, so it can travel through a chain of
// calls, recursive ones included, as fields. A chain that ends in a
// function that keeps the record needs it built. Every call shape must
// compute the same thing.

type Opts = {a: i32, b: i32, c?: i32};

let inner = (o: Opts): i32 => {
  var acc = 0;
  for (var i = 0; i < o.a; i += 1) {
    acc += if ((i & 1) == 0) o.b else o.c ?? 1;
  }
  return acc;
};

let outer = (o: Opts): i32 => inner(o) + o.a;

let twice = (o: Opts): i32 => outer(o) + outer(o);

let countDown = (o: Opts, k: i32): i32 =>
    if (k == 0) inner(o) else countDown(o, k - 1) + 1;

let isEven = (o: Opts, k: i32): boolean =>
    if (k == 0) o.a >= 0 else isOdd(o, k - 1);

let isOdd = (o: Opts, k: i32): boolean =>
    if (k == 0) o.a < 0 else isEven(o, k - 1);

var kept: Opts | null = null;

let keep = (o: Opts): i32 => {
  kept = o;
  return o.a;
};

let keepThrough = (o: Opts): i32 => keep(o) + o.b;

let mixed = (x: Opts, y: Opts): i32 => inner(x) * 100 + inner(y);

export let main = (): i32 => {
  let held: Opts = {a: 3, b: 2, c: 5};
  // inner({a: 3, b: 2, c: 5}) = 2 + 5 + 2 = 9
  if (outer({a: 3, b: 2, c: 5}) != 12 || outer(held) != 12) {
    return 0;
  }
  if (twice({c: 5, b: 2, a: 3}) != 24 || twice(held) != 24) {
    return 0;
  }
  if (countDown({a: 3, b: 2, c: 5}, 4) != 13 || countDown(held, 4) != 13) {
    return 0;
  }
  if (!isEven({a: 1, b: 0}, 10) || isOdd({a: 1, b: 0}, 10)) {
    return 0;
  }
  if (keepThrough({a: 7, b: 1}) != 8) {
    return 0;
  }
  let k = kept;
  if (k == null || k.a != 7) {
    return 0;
  }
  if (mixed({a: 3, b: 2, c: 5}, held) != 909 ||
      mixed(held, {a: 3, b: 2, c: 5}) != 909) {
    return 0;
  }
  return 1;
};
