// @mode: run
// @result: 1
// A `var` of a record type that is only read for its fields, and only
// assigned values that are fields already, is carried as its fields:
// through loops, both arms of an `if`, and nested loops. A var written
// a heap record, captured by a closure, returned whole, or assigned
// inside `try` keeps the record. Every shape must compute the same
// thing.

type V = {x: i32, y: i32};
type Opt = {n: i32, extra?: i32};

let step = (p: V): V => ({x: p.x + p.y, y: p.y + 1});

let flip = (p: V): V => ({x: p.y, y: p.x});

let total = (p: V): i32 => p.x + p.y;

let bump = (o: Opt): Opt => if (o.n > 2) ({n: o.n + 1, extra: o.n}) else ({n: o.n + 1});

var kept: V = {x: 0, y: 0};

let loop = (n: i32): i32 => {
  var pos: V = {x: 0, y: 1};
  for (var i = 0; i < n; i += 1) {
    pos = step(pos);
  }
  return pos.x;
};

let branches = (n: i32): i32 => {
  var pos: V = {x: 1, y: 2};
  var i = 0;
  while (i < n) {
    if ((i & 1) == 0) {
      pos = flip(pos);
    } else {
      pos = {x: pos.x + 10, y: pos.y};
    }
    i += 1;
  }
  return total(pos);
};

let nested = (): i32 => {
  var pos: V = {x: 0, y: 0};
  for (var a = 0; a < 3; a += 1) {
    for (var b = 0; b < 3; b += 1) {
      pos = step(pos);
    }
    pos = flip(pos);
  }
  let {x, y} = pos;
  return x * 1000 + y;
};

let optional = (): i32 => {
  var o: Opt = {n: 0};
  for (var i = 0; i < 5; i += 1) {
    o = bump(o);
  }
  let {n, extra = -1} = o;
  return n * 10 + extra;
};

let fromHeap = (): i32 => {
  var pos: V = {x: 1, y: 1};
  pos = kept;
  pos = step(pos);
  return pos.x + pos.y;
};

let captured = (): i32 => {
  var pos: V = {x: 2, y: 3};
  pos = step(pos);
  let read = () => pos.x;
  return read() + pos.y;
};

let returnedWhole = (): V => {
  var pos: V = {x: 4, y: 5};
  pos = step(pos);
  return pos;
};

let inTry = (): i32 => {
  var pos: V = {x: 1, y: 2};
  try {
    pos = step(pos);
    pos = step(pos);
  } finally {
    pos = flip(pos);
  }
  return pos.x * 100 + pos.y;
};

export let main = (): i32 => {
  // x: 0,1,3,6,10,15 with y: 1..6
  if (loop(5) != 15) {
    return 0;
  }
  // (1,2) flip (2,1) +10 (12,1) flip (1,12) +10 (11,12)
  if (branches(4) != 23) {
    return 0;
  }
  // Each outer round: three steps, then a flip.
  if (nested() != 18054) {
    return 0;
  }
  // n: 1, 2, 3, 4 (extra 3), 5 (extra 4)
  if (optional() != 54) {
    return 0;
  }
  kept = {x: 5, y: 7};
  if (fromHeap() != 20) {
    return 0;
  }
  if (captured() != 9) {
    return 0;
  }
  let whole = returnedWhole();
  if (whole.x != 9 || whole.y != 6) {
    return 0;
  }
  // (1,2) -> (3,3) -> (6,4) -> flip (4,6)
  if (inTry() != 406) {
    return 0;
  }
  return 1;
};
