// @mode: run
// @result: 1
// A constructor of a generic class takes a record parameter as its fields
// in each instantiation, including a record type that mentions the
// class's type parameter, and from a subclass's `super(...)` with a
// literal, its own record passed on, or a record from the heap. Every
// shape must build the same object and run each body once with the same
// values.

type Init = {x: i32, y?: i32};

var bodies = 0;

class Box<T> {
  value: T;
  x: i32;
  y: i32;

  new(value: T, init: Init) : value = value, x = init.x, y = init.y ?? 7 {
    bodies += init.x;
  }
}

final class Pair<T> {
  a: T;
  b: T;
  new(r: {a: T, b: T}) : a = r.a, b = r.b;
}

final class IntBox extends Box<i32> {
  new(v: i32) : super(v, {x: v, y: v + 1});
}

class Relay<T> extends Box<T> {
  new(value: T, init: Init) : super(value, init);
}

final class FromHeap extends Box<String> {
  new(held: Init) : super('h', held);
}

export let main = (): i32 => {
  let ints = new Box<i32>(1, {x: 2});
  let strings = new Box<String>('s', {x: 3, y: 4});
  if (ints.value != 1 || ints.x != 2 || ints.y != 7) {
    return 0;
  }
  if (strings.value != 's' || strings.x != 3 || strings.y != 4) {
    return 0;
  }
  let p = new Pair<i32>({a: 5, b: 6});
  let q = new Pair<String>({a: 'p', b: 'q'});
  if (p.a + p.b != 11 || q.a != 'p' || q.b != 'q') {
    return 0;
  }
  let ib = new IntBox(4);
  if (ib.value != 4 || ib.x != 4 || ib.y != 5) {
    return 0;
  }
  let r = new Relay<String>('r', {x: 5});
  if (r.value != 'r' || r.x != 5 || r.y != 7) {
    return 0;
  }
  let held: Init = {x: 6, y: 1};
  let fh = new FromHeap(held);
  if (fh.value != 'h' || fh.x != 6 || fh.y != 1) {
    return 0;
  }
  // 2 + 3 + 4 + 5 + 6: each Box body ran once.
  if (bodies != 20) {
    return 0;
  }
  return 1;
};
