// @mode: run
// @result: 0

class Point {
  x: i32;
  y: i32;
  new(this.x, this.y) {}
}

let test1 = (): i32 => {
  let p = { x: 10, y: 20 };
  let p2 = { ...p, z: 30 };
  return p2.x + p2.y + p2.z;
};

let test2 = (): i32 => {
  let p = { x: 10, y: 20 };
  let p2 = { x: 5, ...p };
  return p2.x;
};

let test3 = (): i32 => {
  let p = { x: 10, y: 20 };
  let p2 = { ...p, x: 5 };
  return p2.x;
};

let test4 = (): i32 => {
  let p1 = { x: 10 };
  let p2 = { y: 20 };
  let p3 = { ...p1, ...p2, z: 30 };
  return p3.x + p3.y + p3.z;
};

let test5 = (): i32 => {
  let pt = new Point(10, 20);
  let p = { ...pt, z: 30 };
  return p.x + p.y + p.z;
};

let test6 = (): i32 => {
  let pt = new Point(10, 20);
  let p = { ...pt, x: 5 };
  return p.x + p.y;
};

export let main = (): i32 => {
  if (test1() != 60) return 1;
  if (test2() != 10) return 2;
  if (test3() != 5) return 3;
  if (test4() != 60) return 4;
  if (test5() != 60) return 5;
  if (test6() != 25) return 6;
  return 0;
};
