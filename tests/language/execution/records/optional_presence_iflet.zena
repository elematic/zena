// @mode: run
// @result: 46
// @invoke: main

// Naming an optional field without a default in an if-let is a
// presence test: taken iff the field is present.
type Opts = {timeout?: i32};

let probe = (o: Opts): i32 => {
  if (let {timeout} = o) {
    return timeout;
  }
  return -1;
};

export let main = (): i32 => {
  let a = probe({timeout: 47});  // 47
  let b = probe({});             // -1
  return a + b;                  // 46
};
