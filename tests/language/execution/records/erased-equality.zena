// @mode: run
// @result: 1
// `==` on records whose type was erased compares them as values, by
// their shape and fields (#399; docs/design/equality.md, "The erased
// comparison"). A record converted to a narrower type is a value of that
// type, so it equals a record built with just those fields.

let same = (a: anyref, b: anyref): boolean => a == b;

type Opt = {x: i32, y?: i32};

export let main = (): i32 => {
  if (!same({x: 1}, {x: 1})) {
    return 10;
  }
  if (same({x: 1}, {x: 2})) {
    return 11;
  }
  // The same getter signatures, so the same fat pointer type, but a
  // different shape.
  if (same({a: 1}, {b: 1})) {
    return 12;
  }
  let wide = {x: 1, y: 2};
  let narrow: {x: i32} = wide;
  if (!same(narrow, {x: 1})) {
    return 13;
  }
  if (same(narrow, wide)) {
    return 14;
  }
  if (!same({s: 'a', n: {k: 1}}, {s: 'a', n: {k: 1}})) {
    return 15;
  }
  if (same({s: 'a', n: {k: 1}}, {s: 'a', n: {k: 2}})) {
    return 16;
  }
  if (same({s: 'a'}, {s: 'b'})) {
    return 17;
  }
  let withY: Opt = {x: 1, y: 2};
  let withoutY: Opt = {x: 1};
  if (same(withY, withoutY) || !same(withoutY, {x: 1} as Opt)) {
    return 18;
  }
  // A record is never equal to a non-record.
  if (same({x: 1}, 'x')) {
    return 19;
  }
  return 1;
};
