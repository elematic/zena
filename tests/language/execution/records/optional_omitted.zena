// @mode: run
// @result: 30208
// @invoke: main

// The option-bag pattern: call sites omit optional fields, the callee
// destructures with defaults.
let request = (opts: {url: String, timeout?: i32, retries?: i32}): i32 => {
  let {timeout = 30000, retries = 3} = opts;
  return timeout + retries;
};

export let main = (): i32 => {
  let a = request({url: 'x'});                            // 30003
  let b = request({url: 'x', timeout: 100});              // 103
  let c = request({url: 'x', timeout: 100, retries: 2});  // 102
  return a + b + c;                                       // 30208
};
