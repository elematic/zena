// @mode: run
// @result: 152
// @invoke: main

// Match arms over presence: a value sub-pattern tests presence and
// value, a bare name tests presence, the wildcard catches absence.
type Opts = {timeout?: i32};

let classify = (o: Opts): i32 => match (o) {
  case {timeout: 0}: 100
  case {timeout}: timeout
  case _: -1
};

export let main = (): i32 => {
  let a = classify({timeout: 0});    // 100
  let b = classify({timeout: 53});   // 53
  let c = classify({});              // -1
  return a + b + c;                  // 152
};
