// @mode: run
// @invoke: main
// @result: 2124

// The arm forms that reach a record-typed use as a union of record
// types. record-union-arm-adaptation.zena covers two record literals;
// here the arms are a variable already of a record type, a spread over
// one, `match` arms, a third member from a nested `if`, and a `null`
// arm. Each use adapts whichever member it gets, and two uses of one
// binding can read it by different shapes.

type Options = {path: String, limit: i32};
type WithRuntime = {path: String, limit: i32, runtime?: String};

/** Reads only the fields every member has. */
let limitOf = (o: Options): i32 => {
  return o.limit;
};

/** Reads the field one member adds, which the others leave absent. */
let runtimeLength = (o: WithRuntime): i32 => {
  let {runtime = ''} = o;
  return runtime.length;
};

/**
 * The shape this came from: a record built in one place, with one field
 * added to it in one branch (elematic/zena#229).
 */
let viaSpread = (withRuntime: boolean): i32 => {
  let base: Options = {path: 'main.zena', limit: 7};
  let o = if (withRuntime) {
    {...base, runtime: 'mem'}
  } else {
    base
  };
  return limitOf(o) * 100 + runtimeLength(o);
};

/** A `match` whose arms are records of different shapes. */
let viaMatch = (tag: i32): i32 => {
  let o = match (tag) {
    case 0: ({path: 'a', limit: 2})
    case _: ({path: 'a', limit: 2, runtime: 'js'})
  };
  return limitOf(o) * 100 + runtimeLength(o);
};

/** Three members, from an `if` whose alternate is another `if`. */
let threeMembers = (tag: i32): i32 => {
  let o = if (tag == 0) {
    {path: 'a', limit: 1}
  } else if (tag == 1) {
    {path: 'a', limit: 1, runtime: 'wasmtime'}
  } else {
    {path: 'a', limit: 1, extra: true}
  };
  return limitOf(o) * 100 + runtimeLength(o);
};

/**
 * A null arm beside the record arms. The union is read as
 * `Options | null`, so null passes the use instead of matching no
 * member.
 */
let withNullArm = (tag: i32): i32 => {
  let o = if (tag == 0) {
    {path: 'a', limit: 5}
  } else if (tag == 1) {
    {path: 'a', limit: 5, runtime: 'js'}
  } else {
    null
  };
  let picked: Options | null = o;
  if (picked == null) { return 1; }
  return limitOf(picked);
};

export let main = (): i32 => {
  // (703 + 700) + (200 + 202) + (100 + 108 + 100) + (5 + 5 + 1)
  return viaSpread(true) + viaSpread(false) +
      viaMatch(0) + viaMatch(1) +
      threeMembers(0) + threeMembers(1) + threeMembers(2) +
      withNullArm(0) + withNullArm(1) + withNullArm(2);
};
