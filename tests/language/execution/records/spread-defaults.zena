// @mode: run
// @result: 1
// A spread copies only the fields present in its record. Writing keys
// and then spreading an options record gives defaults: a field the
// options leave out keeps the value written before the spread, and a
// field they supply, even as zero, replaces it. Between two spreads, the
// later one's absent fields fall back to the earlier one's.

type Opts = {timeout?: i32, retries?: i32, name?: String};
type Resolved = {timeout: i32, retries: i32, name: String};

let resolve = (o: Opts): Resolved =>
    ({timeout: 30, retries: 3, name: 'none', ...o});

export let main = (): i32 => {
  let d = resolve({});
  if (d.timeout != 30 || d.retries != 3 || d.name != 'none') {
    return -1;
  }
  let s = resolve({retries: 5, name: 'x'});
  if (s.timeout != 30 || s.retries != 5 || s.name != 'x') {
    return -2;
  }
  let z = resolve({timeout: 0});
  if (z.timeout != 0 || z.retries != 3) {
    return -3;
  }

  let a: Opts = {timeout: 1, retries: 2};
  let b: Opts = {retries: 9};
  let merged = {...a, ...b};
  let {timeout = -1, retries = -1, name = '?'} = merged;
  if (timeout != 1 || retries != 9 || name != '?') {
    return -4;
  }
  return 1;
};
