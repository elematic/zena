// @mode: run
// @result: 105
// @invoke: main

// Record values flowing across optionality differences adapt: a
// required source field arrives present, a lacking source field
// arrives absent.
type Opt = {a: i32, b?: i32};

let sum = (o: Opt): i32 => {
  let {a, b = 100} = o;
  return a + b;
};

export let main = (): i32 => {
  let wide: {a: i32, b: i32} = {a: 1, b: 2};
  let viaRequired = sum(wide);       // b present: 1 + 2 = 3
  let narrow: {a: i32} = {a: 2};
  let viaNarrow = sum(narrow);       // b absent: 2 + 100 = 102
  return viaRequired + viaNarrow;    // 105
};
