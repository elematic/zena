// @mode: run
// @result: 1
// A function whose record result some call only reads for its fields
// returns the fields instead. Results are destructured, bound and read,
// read directly, returned on through another function, returned from
// several places (early, from a value block's tail, through `finally`),
// passed through unchanged from a parameter, and also used whole, through
// a function value, and with optional fields. Every shape must see the
// same record.

type V = {x: i32, y: i32};
type Opt = {a: i32, b?: i32};

var finalized = 0;

let make = (n: i32): V => ({x: n, y: n * 2});

let pick = (n: i32): V => {
  if (n < 0) {
    return {x: 0, y: 0};
  }
  let base = n + 1;
  ({x: base, y: base + 1})
};

let guarded = (n: i32): V => {
  try {
    return {x: n, y: -n};
  } finally {
    finalized += 1;
  }
};

let passThrough = (v: V): V => v;

let viaMake = (n: i32): V => make(n + 10);

let optional = (n: i32): Opt => if (n > 0) ({a: n, b: n}) else ({a: n});

let keep = (v: V): V => v;

var stored: V = {x: 0, y: 0};

export let main = (): i32 => {
  let {x, y} = make(3);
  if (x != 3 || y != 6) {
    return 0;
  }
  let bound = make(4);
  if (bound.x + bound.y != 12) {
    return 0;
  }
  if (make(5).y != 10) {
    return 0;
  }
  let early = pick(-1);
  let late = pick(2);
  if (early.x != 0 || late.x != 3 || late.y != 4) {
    return 0;
  }
  let g = guarded(7);
  if (g.x != 7 || g.y != -7 || finalized != 1) {
    return 0;
  }
  let p = passThrough({x: 8, y: 9});
  if (p.x != 8 || p.y != 9) {
    return 0;
  }
  let chained = viaMake(1);
  if (chained.x != 11 || chained.y != 22) {
    return 0;
  }
  let {a, b = -1} = optional(3);
  let {a: a2, b: b2 = -1} = optional(0);
  if (a != 3 || b != 3 || a2 != 0 || b2 != -1) {
    return 0;
  }
  // Used whole: stored, passed on, through a function value.
  stored = make(6);
  if (stored.y != 12 || keep(make(7)).x != 7) {
    return 0;
  }
  let asValue = make;
  if (asValue(8).y != 16) {
    return 0;
  }
  return 1;
};
