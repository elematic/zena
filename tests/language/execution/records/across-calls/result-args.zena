// @mode: run
// @result: 1
// A call's record result passed straight to another call is passed as
// its fields when the parameter only reads them: functions, methods,
// nested calls, and a method some subclass overrides, whose call
// dispatches and returns the record. Every shape must compute the same
// thing.

type V = {x: i32, y: i32};

let make = (n: i32): V => ({x: n, y: n * 2});

let bump = (r: V): V => ({x: r.x + 1, y: r.y + 1});

let use = (r: V): i32 => r.x * 100 + r.y;

let twice = (r: V): V => bump(bump(r));

class Grid {
  scale: i32;
  new(this.scale);

  shift(r: V, by: i32): V {
    return {x: r.x * this.scale + by, y: r.y + by};
  }

  shiftTwice(r: V): V {
    return this.shift(this.shift(r, 1), 1);
  }

  area(r: V): i32 {
    return r.x * r.y;
  }
}

class Shape {
  corner(n: i32): V {
    return {x: n, y: n};
  }
}

class Wide extends Shape {
  corner(n: i32): V {
    return {x: n * 10, y: n};
  }
}

export let main = (): i32 => {
  if (use(make(5)) != 510 || use(bump(make(1))) != 203) {
    return 0;
  }
  let t = twice({x: 1, y: 2});
  if (t.x != 3 || t.y != 4) {
    return 0;
  }
  let g = new Grid(2);
  // (1, 1) -> (3, 2) -> (7, 3)
  let s = g.shiftTwice({x: 1, y: 1});
  if (s.x != 7 || s.y != 3) {
    return 0;
  }
  if (g.area(g.shift({x: 1, y: 1}, 1)) != 6 || use(g.shift(make(2), 0)) != 404) {
    return 0;
  }
  let shapes = new GrowableArray<Shape>();
  shapes.push(new Shape());
  shapes.push(new Wide());
  var total = 0;
  for (let sh in shapes) {
    total = total * 10000 + use(sh.corner(3));
  }
  if (total != 3033003) {
    return 0;
  }
  return 1;
};
