// @mode: run
// @result: 7
// @invoke: main

// Presence is a bit, not a sentinel: an explicit 0 is present and must
// not trigger the default.
let f = (o: {t?: i32}): i32 => {
  let {t = 7} = o;
  return t;
};

export let main = (): i32 => {
  let absent = f({});     // 7 — the default applies
  let zero = f({t: 0});   // 0 — present, default must not apply
  return absent + zero;
};
