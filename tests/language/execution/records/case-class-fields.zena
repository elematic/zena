// @mode: run
// @result: 1
// A case class's derived `==` and `hashCode` compare and hash a record
// or tuple field by value, like any other `==` on it: two instances
// built from equal but separate records are equal and hash alike, so
// they find each other in a set. That holds through a generic case
// class instantiated with a record.
import { HashSet } from 'zena:collections';

type Pos = {x: i32, y: i32};

class Line(from: Pos, label: (i32, String))

class Box<T>(value: T)

let pos = (x: i32, y: i32): Pos => ({x, y});

export let main = (): i32 => {
  let a = new Line(pos(1, 2), (1, 'a'));
  let b = new Line(pos(1, 2), (1, 'a'));
  let c = new Line(pos(1, 3), (1, 'a'));
  let d = new Line(pos(1, 2), (2, 'a'));
  if (a != b || a == c || a == d) {
    return 10;
  }
  if (a.hashCode() != b.hashCode()) {
    return 11;
  }
  let lines = new HashSet<Line>();
  lines.add(a);
  lines.add(b);
  lines.add(c);
  if (lines.size != 2 || !lines.has(new Line(pos(1, 3), (1, 'a')))) {
    return 12;
  }
  let boxes = new HashSet<Box<Pos>>();
  boxes.add(new Box<Pos>(pos(5, 6)));
  boxes.add(new Box<Pos>(pos(5, 6)));
  if (boxes.size != 1 || new Box<Pos>(pos(5, 6)) != new Box<Pos>(pos(5, 6))) {
    return 13;
  }
  return 1;
};
