// @mode: run
// @result: 11
// @invoke: main

// An optional reference-typed field: the absent slot's placeholder is
// never observable; the default applies.
let nameLen = (o: {name?: String}): i32 => {
  let {name = 'default'} = o;
  return name.length;
};

export let main = (): i32 => {
  let absent = nameLen({});               // 'default'.length = 7
  let present = nameLen({name: 'four'});  // 4
  return absent + present;                // 11
};
