// @mode: run
// @result: 63

type P = {x: i32, y: i32};

export let main = (): i32 => {
  let r = {x: 1, y: 2, z: 3};
  var rNull: P | null = null;
  var rNull2: P | null = null;
  var rSome: P | null = r;
  let rPlain: P = r;
  var got = 0;

  // null vs null
  if (rNull === rNull2) { got += 1; }
  // null vs non-null adapted view
  if (rNull !== rSome) { got += 2; }
  // two separately adapted nullable views of one record
  if (rSome === rPlain) { got += 4; }
  // adapted nullable view vs the original wider record
  if (rSome === r) { got += 8; }
  // adapted non-null view vs the original wider record
  if (rPlain === r) { got += 16; }
  // plain ASSIGNMENT (not initializer) into the nullable slot
  rNull = r;
  if (rNull === rPlain) { got += 32; }
  return got;
};
