// @mode: run
// @result: 7
// @invoke: main
// @skip: a record alias that refers to itself through a type argument is not supported. Three places fail: `typesEqual` compares an alias reference only with an alias of the same name, so `Array<Tree>` never equals the `Array<{...}>` a literal produces; contextual typing does not see through the alias, so `[{label: 'b'}]` is not typed as `Array<Tree>`; and with the first fixed, codegen's `eraseTypeParameters` recurses without end on the cyclic type.

// A record alias that refers to itself through a type argument. Inside
// the declaration `Tree` is an alias reference; a literal's element type
// is the record it names. The two must compare equal as type arguments,
// or `kids: [{label: 'b'}]` is rejected against `Array<Tree>`.
import {HashMap} from 'zena:collections';

type Tree = {label: String, kids?: Array<Tree>};

type Value = {text?: String, map?: MapValue};
type MapValue = {fields?: Map<String, Value>};

let count = (t: Tree): i32 => {
  var c = 1;
  if (let {kids} = t) {
    for (let k in kids) {
      c += count(k);
    }
  }
  return c;
};

let depth = (v: Value): i32 => {
  if (let {map} = v) {
    var d = 0;
    if (let {fields} = map) {
      for (let k in fields.keys()) {
        let n = depth(fields[k]);
        if (n > d) {
          d = n;
        }
      }
    }
    return d + 1;
  }
  return 0;
};

export let main = (): i32 => {
  let t: Tree = {label: 'a', kids: [{label: 'b'}, {label: 'c', kids: [{label: 'd'}]}]};
  let fields: Map<String, Value> = new HashMap<String, Value>();
  fields['x'] = {map: {fields: new HashMap<String, Value>()}};
  let v: Value = {map: {fields}};
  return count(t) + depth(v) + 1;
};
