// @mode: run
// @result: 12
// @skip: the default is checked where `Side` is not found, "Variable 'Side' not found" (#1329)

// An optional field read with a default that names an enum member. The
// default is an expression like any other, so it sees the names its
// function sees.

enum Side {
  Left,
  Right
}

type Options = {side?: Side, width?: i32};

function widthOf(options: Options): i32 {
  let {side = Side.Right, width = 5} = options;
  return if (side == Side.Right) width * 2 else width;
}

export let main = (): i32 => {
  return widthOf({}) + widthOf({side: Side.Left, width: 2});
};
