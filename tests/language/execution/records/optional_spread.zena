// @mode: run
// @result: 22
// @invoke: main

// Spread propagates presence: a field present in the source stays
// present in the result, an absent one stays absent unless supplied.
type Opts = {t?: i32, r?: i32};

let get = (o: Opts): i32 => {
  let {t = 100, r = 10} = o;
  return t + r;
};

export let main = (): i32 => {
  let base: Opts = {t: 5};             // t present (5), r absent
  let merged: Opts = {...base, r: 2};  // t stays present, r now present
  return get(merged) + get(base);      // (5 + 2) + (5 + 10) = 22
};
