// @mode: run
// @result: 1235678
// A record literal evaluates its properties in the order they are written,
// whatever order the fields are stored in. A spread is evaluated where it
// is written, and a repeated key is evaluated each time, the last one
// supplying the field.

var log = 0;

let note = (n: i32): i32 => {
  log = log * 10 + n;
  return n;
};

let source = (n: i32): {b: i32} => {
  log = log * 10 + n;
  return {b: n};
};

export let main = (): i32 => {
  let r = {c: note(1), a: note(2), b: note(3)};
  if (r.a != 2 || r.b != 3 || r.c != 1) {
    return -1;
  }
  let s = {c: note(5), ...source(6), a: note(7), c: note(8)};
  if (s.a != 7 || s.b != 6 || s.c != 8) {
    return -2;
  }
  return log;
};
