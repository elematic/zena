// @mode: run
// @result: 1
// `as` from a closed record type to a narrower one projects: the result
// has the narrower type's fields, and compares as a value of that type
// (docs/design/row-types.md, Decisions: Operations per form).

export let main = (): i32 => {
  let xy = {x: 1, y: 2};
  let x = xy as {x: i32};
  if (x.x != 1) {
    return 10;
  }
  if (x != {x: 1}) {
    return 11;
  }
  let held: {x: i32} = xy;
  if (held != x) {
    return 12;
  }
  return 1;
};
