// @mode: run
// @result: 0

import { clz, ctz, popcnt, abs, neg, ceil, floor, trunc, nearest, sqrt, min, max, copysign } from 'zena:math';

export let main = (): i32 => {
  // Test i64 bitwise
  if (clz(1 as i64) != 63 as i64) return 1;
  if (ctz(8 as i64) != 3 as i64) return 2;
  if (popcnt(-1 as i64) != 64 as i64) return 3;

  // Test float abs & neg
  if (abs(-1.5 as f32) != 1.5 as f32) return 4;
  if (neg(1.5 as f32) != -1.5 as f32) return 5;
  if (abs(-1.5 as f64) != 1.5 as f64) return 6;
  if (neg(1.5 as f64) != -1.5 as f64) return 7;

  // Test float ceil & floor & trunc & nearest
  if (ceil(1.1 as f32) != 2.0 as f32) return 8;
  if (floor(1.9 as f32) != 1.0 as f32) return 9;
  if (trunc(-1.9 as f32) != -1.0 as f32) return 10;
  if (nearest(1.6 as f32) != 2.0 as f32) return 11;

  if (ceil(1.1 as f64) != 2.0 as f64) return 12;
  if (floor(1.9 as f64) != 1.0 as f64) return 13;
  if (trunc(-1.9 as f64) != -1.0 as f64) return 14;
  if (nearest(1.6 as f64) != 2.0 as f64) return 15;

  // Test float sqrt & min & max & copysign
  if (sqrt(4.0 as f32) != 2.0 as f32) return 16;
  if (min(1.0 as f32, 2.0 as f32) != 1.0 as f32) return 17;
  if (max(1.0 as f32, 2.0 as f32) != 2.0 as f32) return 18;
  if (copysign(1.0 as f32, -2.0 as f32) != -1.0 as f32) return 19;

  if (sqrt(4.0 as f64) != 2.0 as f64) return 20;
  if (min(1.0 as f64, 2.0 as f64) != 1.0 as f64) return 21;
  if (max(1.0 as f64, 2.0 as f64) != 2.0 as f64) return 22;
  if (copysign(1.0 as f64, -2.0 as f64) != -1.0 as f64) return 23;

  return 0;
};
