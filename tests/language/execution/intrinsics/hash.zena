// @mode: run
// @result: 100

@intrinsic('hash')
export declare function hash<T>(value: T): i32;

class CustomHash {
  val: i32;
  new(this.val);
  hashCode(): i32 {
    return this.val * 10;
  }
}

export let main = (): i32 => {
  // 1. Primitive hashing (returns the value itself)
  if (hash(42) != 42) return 1;
  if (hash(true) != 1) return 2;
  if (hash(false) != 0) return 3;

  // 2. String hashing
  let h1 = hash("hello");
  let h2 = hash("hello");
  let h3 = hash("world");
  if (h1 != h2) return 4;
  if (h1 == h3) return 5;

  // 3. Custom class hashing (calls hashCode method)
  let ch = new CustomHash(7);
  if (hash(ch) != 70) return 6;

  return 100;
};
