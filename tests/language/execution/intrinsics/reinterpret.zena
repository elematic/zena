// @mode: run
// @result: 0

import { i32_reinterpret_f32, f32_reinterpret_i32, i64_reinterpret_f64, f64_reinterpret_i64 } from 'zena:math';

export let main = (): i32 => {
  // Test i32 <-> f32
  let f1: f32 = f32_reinterpret_i32(1065353216); // 1.0f in IEEE 754
  let i1 = i32_reinterpret_f32(f1);
  if (i1 != 1065353216) return 1;

  // Test i64 <-> f64
  let f2: f64 = f64_reinterpret_i64(4607182418800017408 as i64); // 1.0 in IEEE 754
  let i2 = i64_reinterpret_f64(f2);
  if (i2 != 4607182418800017408 as i64) return 2;

  return 0;
};
