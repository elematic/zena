// @mode: run
// @invoke: main
// @result: 7

// `externref | null` holds a null of the extern hierarchy, so a host
// reference slot can start empty, be filled, and be emptied again.
class Token {
  new();
}

var slot: externref | null = null;

let isEmpty = (): boolean => slot == null;

let store = (t: Token): void => {
  slot = t as externref;
};

let clear = (): void => {
  slot = null;
};

export let main = (): i32 => {
  if (!isEmpty()) {
    return 1;
  }
  store(new Token());
  if (isEmpty()) {
    return 2;
  }
  clear();
  return if (isEmpty()) 7 else 3;
};
