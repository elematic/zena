// @mode: run
// @result: 100

@intrinsic('eq')
export declare function equals<T>(a: T, b: T): boolean;

class Dummy {
  val: i32;
  new(this.val);
}

export let main = (): i32 => {
  // 1. Primitive equality
  if (!equals(42, 42)) return 1;
  if (equals(42, 43)) return 2;

  let bTrue: boolean = true;
  let bFalse: boolean = false;
  if (!equals(bTrue, bTrue)) return 3;
  if (equals(bTrue, bFalse)) return 4;

  // 2. String equality
  let sHello: String = "hello";
  let sWorld: String = "world";
  if (!equals(sHello, sHello)) return 5;
  if (equals(sHello, sWorld)) return 6;

  // 3. Reference equality fallback
  let d1 = new Dummy(10);
  let d2 = new Dummy(10);
  if (!equals(d1, d1)) return 7;
  if (equals(d1, d2)) return 8; // distinct objects

  return 100;
};
