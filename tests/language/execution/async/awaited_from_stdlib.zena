// @mode: run
// @result: 42

// Awaited<T> imported from zena:async — the stdlib declaration of the
// type operator, usable like any exported type.

import { Future, Awaited, runFuture, drainMicrotasks } from 'zena:async';

let first = <T>(f: T, fallback: Awaited<T>): Awaited<T> => fallback;

let doubled = async (v: i32): Future<i32> => {
  return v * 2;
};

export let main = (): i32 => {
  let f = doubled(21);
  drainMicrotasks();
  let a: Awaited<Future<i32>> = first(f, runFuture(f));
  return a;
};
