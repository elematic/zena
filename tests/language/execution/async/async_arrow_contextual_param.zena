// @mode: run
// @result: 42
// An async arrow whose parameter takes its type from the parameter it
// is passed to.
import { Future, runFuture } from 'zena:async';

function apply(fn: (x: i32) => Future<i32>): Future<i32> {
  return fn(41);
}

export function main(): i32 {
  return runFuture(apply(async (x) => x + 1));
}
