// @mode: run
// @result: 42
// An async arrow whose parameter takes its type from the parameter it
// is passed to.
import { Future } from 'zena:async';

function apply(fn: (x: i32) => Future<i32>): Future<i32> {
  return fn(41);
}

export async function main(): Future<i32> {
  return await apply(async (x) => x + 1);
}
