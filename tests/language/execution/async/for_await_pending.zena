// @mode: run
// @result: 6
// `for await` over an iterator whose steps are sometimes Pending
// (docs/design/async-iteration.md, "Consuming"). A Ready step runs the
// body at once. A Pending step suspends the loop on its future: `Some`
// runs the body with the value, and `None` ends the loop — so the step
// after the second Pending is never asked for.

import { Future, Completer, AsyncStep, AsyncIterator, scheduleMicrotask } from 'zena:async';

/** A future that settles with `value` on a later turn of the queue. */
let later = (value: Option<i32>): Future<Option<i32>> => {
  let c = new Completer<Option<i32>>();
  scheduleMicrotask(() => {
    c.complete(value);
  });
  return c.future;
};

class Mixed implements AsyncIterator<i32> {
  var #calls = 0;

  next(): AsyncStep<i32> {
    this.#calls += 1;
    if (this.#calls == 1) {
      return (1, 1, _);
    }
    if (this.#calls == 2) {
      return (2, _, later(some(2)));
    }
    if (this.#calls == 3) {
      return (1, 3, _);
    }
    if (this.#calls == 4) {
      return (2, _, later(none));
    }
    // Never reached: the None above ended the loop.
    return (1, 100, _);
  }
}

export let main = async (): Future<i32> => {
  let it: AsyncIterator<i32> = new Mixed();
  var sum = 0;
  for await (let x in it) {
    sum += x;
  }
  return sum; // 1 + 2 + 3
};
