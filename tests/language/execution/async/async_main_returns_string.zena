// @mode: run
// @result: awaited 42
// An async `main` whose future carries a `String`: the entry returns
// it through a `task.return` typed `string` once the future settles.
import { Future } from 'zena:async';

async function answer(): Future<i32> {
  return 42;
}

export async function main(): Future<String> {
  let n = await answer();
  return `awaited ${n}`;
}
