// @mode: run
// @result: 135
// A `for` header variable that closures capture and the body assigns
// lives in a cell, and each iteration gets a fresh one. In an async
// body the loop carries that cell across each `await`.
import { Future, drainMicrotasks, runFuture } from 'zena:async';

let collect = async (): Future<i32> => {
  let fs = new GrowableArray<() => i32>();
  for (var i = 0; i < 6; i += 1) {
    fs.push(() => i);
    let step = await Future.of(1);
    i += step;
  }
  var acc = 0;
  for (let f in fs) {
    acc = acc * 10 + f();
  }
  // i is 1, 3 and 5 when each iteration ends.
  return acc;
};

export let main = (): i32 => {
  let f = collect();
  drainMicrotasks();
  if (!f.isCompleted) {
    return -1;
  }
  return runFuture(f);
};
