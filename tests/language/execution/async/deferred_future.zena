// @mode: run
// @result: 0

// A `DeferredFuture` runs its producer on the first subscription and
// never otherwise. `await` is a subscription like any other: the
// await site must reach the subclass's `[subscribe]`, so the future
// settles instead of parking the frame forever.

import { Future, DeferredFuture, drainMicrotasks } from 'zena:async';

var started = 0;

let make = (): Future<i32> => {
  return new DeferredFuture<i32>((): Future<i32> => {
    started += 1;
    return Future.of<i32>(21);
  });
};

let awaitIt = async (f: Future<i32>): Future<i32> => {
  return await f;
};

export async function main(): Future<i32> {
  // Never looked at: the producer never runs.
  let ignored = make();
  drainMicrotasks();
  if (started != 0) {
    return -1;
  }
  // Awaited: the producer runs exactly once.
  let awaited = awaitIt(make());
  let a = await awaited;
  if (started != 1 || a != 21) {
    return -2;
  }
  // Subscribed through `then`: the same.
  var viaThen = 0;
  make().then((v: i32): void => {
    viaThen = v;
  });
  drainMicrotasks();
  if (started != 2 || viaThen != 21) {
    return -3;
  }
  // Awaited twice: the second await finds it settled.
  let shared = make();
  let x = await awaitIt(shared);
  let y = await awaitIt(shared);
  if (started != 3 || x + y != 42) {
    return -4;
  }
  return 0;
}
