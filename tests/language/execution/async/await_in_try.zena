// @mode: run
// @result: 321
// await inside try/catch (async.md §6): a rejected future's failure
// surfaces at the resume point and must be catchable by an enclosing
// handler in the async body, not just propagate to the caller.
import { Future, Completer, drainMicrotasks } from 'zena:async';

let guarded = async (c: Completer<i32>): Future<i32> => {
  var v = 0;
  try {
    v = await c.future;
  } catch (e) {
    v = 0 - 1;
  }
  return v;
};

export async function main(): Future<i32> {
  // Success path through the try body.
  let ok = new Completer<i32>();
  let a = guarded(ok);
  ok.complete(3);
  drainMicrotasks();
  if (!a.isCompleted) {
    return -2;
  }

  // Failure path: the await throws and the handler runs.
  let bad = new Completer<i32>();
  let b = guarded(bad);
  bad.fail(new Error('nope'));
  drainMicrotasks();
  if (!b.isCompleted) {
    return -3;
  }

  if ((await a) != 3 || (await b) != -1) {
    return -4;
  }
  return 321;
}
