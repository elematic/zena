// @mode: run
// @result: 6

// `for await` over a synchronous iterable never awaits: every step is
// Ready, so it runs exactly like `for`. Here the iterable is an array
// (a fusion fast path that never calls next()); the loop must lower
// even though the enclosing function is async.

import { Future } from 'zena:async';

export let main = async (): Future<i32> => {
  var sum = 0;
  let xs = [1, 2, 3];
  for await (let x in xs) {
    sum = sum + x;
  }
  return sum;  // 1 + 2 + 3 = 6
};
