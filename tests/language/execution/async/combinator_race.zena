// @mode: run
// @result: 77
// `Future.race` — the first future to settle, value or failure (async.md §2).
import { Future, Completer } from 'zena:async';
import { Array } from 'zena:array';
import { Error } from 'zena:error';

/** Awaits `f` and reports how it settled, so the assertions below read
 * as plain comparisons. A helper rather than an inline try/catch
 * because a local living across a try that holds both an `await` and a
 * `return` miscompiles today (see BUGS.md) — nothing to do with the
 * combinators under test. */
let settlementOf = async (f: Future<i32>): Future<String> => {
  try {
    let value = await f;
    return 'value';
  } catch (e) {
    return e.message;
  }
};

/** `Future.race` refuses an empty array by throwing, which is synchronous
 * and so needs no async machinery to observe. */
let emptyRaceRefused = (): boolean => {
  try {
    let never = Future.race(new GrowableArray<Future<i32>>());
    return false;
  } catch (e) {
    return true;
  }
};

export async function main(): Future<i32> {
  // First to settle wins, whatever its position in the array. The
  // loser settling afterwards is ignored rather than throwing
  // "already completed" — losing a race is normal, not an error.
  let a = new Completer<i32>();
  let b = new Completer<i32>();
  // Pass fixed array literal directly:
  let first = Future.race([a.future, b.future]);
  b.complete(70);
  a.complete(1);
  let won = await first;
  if (!(won == 70)) {
    return 0 - 1;
  }

  // A failure wins a race exactly the way a value does.
  let c = new Completer<i32>();
  let d = new Completer<i32>();
  let raced = Future.race([c.future, d.future]);
  d.fail(new Error('lost'));
  c.complete(5);
  if (!(await settlementOf(raced) == 'lost')) {
    return 0 - 2;
  }

  // Growable array also works:
  let e = new Completer<i32>();
  let f = new Completer<i32>();
  let growable = new GrowableArray<Future<i32>>();
  growable.push(e.future);
  growable.push(f.future);
  let third = Future.race(growable);
  e.complete(42);
  f.complete(99);
  let growableWon = await third;
  if (!(growableWon == 42)) {
    return 0 - 4;
  }

  // An empty race can never settle, so it is refused where the mistake
  // is — at the call — rather than surfacing later as a deadlock.
  if (!emptyRaceRefused()) {
    return 0 - 3;
  }

  return won + 7;
}
