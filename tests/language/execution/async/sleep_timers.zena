// @mode: run
// @result: 1234
// Timers over WASI 0.3's `wasi:clocks` wait-for.
//
// Durations are kept short and only their ORDER is asserted. Asserting
// elapsed wall-clock would make this flaky on a loaded machine.
import { Future } from 'zena:async';
import { sleep, monotonic, milliseconds } from 'zena:time';

var log = 0;

let mark = (n: i32): void => {
  log = log * 10 + n;
};

/** Completes after its own delay, recording when it did. */
let after = async (ms: i64, n: i32): Future<void> => {
  await sleep(milliseconds(ms));
  mark(n);
};

export async function main(): Future<i32> {
  // Armed out of order; they must fire in deadline order, not call
  // order. This is the whole behaviour: without a park arm in the
  // drain loop, none of them would fire at all.
  let c = after(60, 3);
  let a = after(20, 1);
  let d = after(80, 4);
  let b = after(40, 2);

  await d;
  // Awaiting the last one to fire means all four have run.
  if (log != 1234) {
    return 0 - 1;
  }
  // The others are already settled.
  if (!a.isCompleted || !b.isCompleted || !c.isCompleted) {
    return 0 - 2;
  }

  // A timer really does advance the monotonic clock.
  let start = monotonic();
  await sleep(milliseconds(30));
  let elapsed = monotonic() - start;
  if (!elapsed.isPositive()) {
    return 0 - 3;
  }

  // A zero sleep is still asynchronous — it completes through the
  // queue, so this mark happens after the synchronous tail below.
  log = 0;
  let zero = after(0, 9);
  mark(8);
  await zero;
  if (log != 89) {
    return 0 - 4;
  }

  return 1234;
}
