// @mode: run
// @result: 7
// Failure propagation (async.md §3): awaiting a rejected future
// resurfaces as an ordinary throw at the resume point, unwinds into
// step()'s failure-capture region, and rejects the frame's own future.
// A throw before any suspension takes the same path.
import { Future, Completer } from 'zena:async';

let awaitsFailure = async (c: Completer<i32>): Future<i32> => {
  let v = await c.future;
  // Never reached: the await above throws.
  return v + 1;
};

let throwsEagerly = async (): Future<i32> => {
  throw new Error('eager');
};

export async function main(): Future<i32> {
  var score = 0;

  let c = new Completer<i32>();
  let f = awaitsFailure(c);
  c.fail(new Error('nope'));
  var fMsg = '';
  try {
    await f;
    fMsg = 'no throw';
  } catch (e) {
    fMsg = e.message;
  }
  if (fMsg == 'nope') {
    score += 1;
  }

  // The failure of an awaited future must not leak as a trap: the
  // program is still running, and the drain queue is still usable.
  let ok = new Completer<i32>();
  let g = awaitsFailure(ok);
  ok.complete(5);
  if ((await g) == 6) {
    score += 2;
  }

  // A body that throws before its first suspension rejects too — the
  // ramp runs that segment eagerly, inside the same region.
  let h = throwsEagerly();
  var hMsg = '';
  try {
    await h;
    hMsg = 'no throw';
  } catch (e) {
    hMsg = e.message;
  }
  if (hMsg == 'eager') {
    score += 4;
  }

  // 1 + 2 + 4 = 7
  return score;
}
