// @mode: run
// @result: 7
// A value whose static type is a subclass of Future, here a
// DeferredFuture<i32>, is awaited at its Future superclass. Only the
// Future class itself used to be accepted: "'await' operand must be
// 'Future<T>'".
import {DeferredFuture} from 'zena:async';

async function seven(): Future<i32> {
  return 7;
}

export async function main(): Future<i32> {
  let f = new DeferredFuture<i32>(() => seven());
  return await f;
}
