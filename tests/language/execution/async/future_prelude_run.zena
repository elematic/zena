// @mode: run
// @result: 42
// Verify that Future, Future.of, and Future.all execute without explicit Future import.

async function compute(x: i32): Future<i32> {
  return x * 2;
}

export async function main(): Future<i32> {
  let f1 = compute(10);
  let f2 = compute(11);
  let results = await Future.all([f1, f2]);
  let sum = results[0] + results[1];
  return sum; // 20 + 22 = 42
}
