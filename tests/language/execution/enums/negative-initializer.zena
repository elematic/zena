// @mode: run
// @result: -32601
// A member's value may be negative, like JSON-RPC's error codes. The
// member after one counts up from it.

enum ErrorCode {
  ParseError = -32700,
  MethodNotFound = -32601,
  InternalError = -32603,
  NextAfterInternal,
}

export let main = (): i32 => {
  if (ErrorCode.ParseError as i32 != -32700) {
    return 1;
  }
  if (ErrorCode.NextAfterInternal as i32 != -32602) {
    return 2;
  }
  return ErrorCode.MethodNotFound as i32;
};
