// @mode: run
// @invoke: main
// @result: 3

// A decorator from another module resolves names in its own module: this
// file never imports `bumpVersion`, and the decorator's setter calls it.
// The getter returns the stored value alone, so the version it bumps is
// not observable here; state-in-getter.zena covers that.
import {signal} from './signal-lib.zena';

class Store {
  @signal var total: i32 = 1;
}

export let main = (): i32 => {
  let s = new Store();
  s.total = s.total + 1;
  s.total = s.total + 1;
  return s.total;
};
