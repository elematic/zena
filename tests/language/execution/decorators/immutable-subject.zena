// @mode: run
// @invoke: main
// @result: 42

// A decorator with an immutable subject exposes only a getter, and
// applies to immutable fields.
decorator doubled(value: i32) {
  #value: i32;
  value: i32 {
    get { return this.#value * 2; }
  }
}

class Box {
  @doubled n: i32 = 21;
}

export let main = (): i32 => {
  let b = new Box();
  return b.n;
};
