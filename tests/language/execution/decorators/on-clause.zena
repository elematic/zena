// @mode: run
// @invoke: main
// @result: 42

// A decorator's `on` clause names the base its host must extend, and
// the body may call that base's API on `this`.
class Reactive {
  var updates: i32 = 0;
  requestUpdate(): void { this.updates += 1; }
}

decorator property<T>(var value: T) on Reactive {
  var #value: T;
  value: T {
    get { return this.#value; }
    set(v) {
      this.#value = v;
      this.requestUpdate();
    }
  }
}

class Element extends Reactive {
  @property var label: String = '';
  @property var count: i32 = 0;
}

export let main = (): i32 => {
  let e = new Element();
  e.label = 'a';
  e.count = 40;
  e.count = e.count + e.updates;   // 40 + 2
  return e.count;
};
