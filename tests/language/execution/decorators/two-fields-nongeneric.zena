// @mode: run
// @invoke: main
// @result: 213

// One non-generic decorator applied to two fields of one class.
decorator logged(var value: i32) {
  var #value: i32;
  var #writes: i32 = 0;
  value: i32 {
    get { return this.#value; }
    set(v) {
      this.#value = v;
      this.#writes += 1;
    }
  }
}

class Point {
  @logged var x: i32 = 1;
  @logged var y: i32 = 2;
}

export let main = (): i32 => {
  let p = new Point();
  p.x = 200;
  p.y = p.y + 11;
  return p.x + p.y;
};
