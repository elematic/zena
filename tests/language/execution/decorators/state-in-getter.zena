// @mode: run
// @invoke: main
// @result: 1007

// The getter can read the decorator's state: here the version is folded
// into the value, so two writes raise it by 2 * 500.
import {versioned} from './signal-lib.zena';

class Store {
  @versioned var total: i32 = 5;
}

export let main = (): i32 => {
  let s = new Store();
  s.total = 6;
  s.total = 7;
  return s.total;
};
