// @mode: run
// @result: 7

interface Runnable {
  run(): i32;
}

class W<T> implements Runnable {
  v: T;
  new(this.v);
  run(): i32 { return 7; }
}

/** A generic FUNCTION instantiating a class that implements an
 * interface. */
function make<A>(v: A): Runnable {
  return new W<A>(v);
}

export function main(): i32 {
  let r = make<i32>(1);
  return r.run();
}
