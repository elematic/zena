// The declaring file for a generic `opaque type`: the only place values of it
// can be minted. `wrap`/`unwrap` are the shape `disown`/`adopt` need — a
// generic function whose parameter and return type are both instantiations of
// a generic opaque alias. See docs/design/ownership.md.
//
// No `@result:`/`@stdout:` directive, so the runner treats this as a support
// module for ./generic_opaque_cell_use.zena rather than a test of its own.

export opaque type Cell<T> = T;

export let wrap = <T>(v: T): Cell<T> => v as Cell<T>;

export let unwrap = <T>(c: Cell<T>): T => c as T;

// Re-wrapping without leaving the alias: the parameter and the result are the
// same instantiation, which is `adopt`'s shape.
export let rewrap = <T>(c: Cell<T>): Cell<T> => (c as T) as Cell<T>;
