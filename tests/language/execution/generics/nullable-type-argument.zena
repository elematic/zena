// @mode: run
// @result: 3

// `T?` as a generic type argument: Array<String?> holds nulls and strings,
// and narrowing recovers the element.

let score = (s: String?): i32 => if (s == null) { 0 } else { s.length };

export let main = (): i32 => {
  let arr = new Array<String?>(0);
  arr.push(null);
  arr.push("abc");
  var total = 0;
  for (let s in arr) {
    total += score(s);
  }
  return total;
};
