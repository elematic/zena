// @mode: run
// @result: 136

// `Array.from` and friends are statics on generic classes whose only
// parameter is an INTERFACE of the class's own type parameter. They were
// declared in the stdlib with no call site anywhere, because neither the
// binding nor the inference existed.
export let main = (): i32 => {
  let grown: Array<i32> = Array.from([1, 2, 3]);
  let immutable = ImmutableArray.from([10, 20]);
  let fixed = FixedArray.from([100]);
  let written = Array<i32>.from([0]);
  return grown[0] + grown[1] + grown[2] +
      immutable[0] + immutable[1] + fixed[0] + written[0];
};
