// @mode: run
// @result: 44
// A generic function calling a generic function. The inner call names
// `fill<T>` with the OUTER template's type parameter, which is not a
// call site — every value it stands for belongs to some `fill<i32>` a
// real call site names. So nothing is emitted at the erasure, and this
// program's specializations are exactly the ones main asks for.
//
// `Full<i32>` stores an i32 field where `Full<erased>` would store a
// reference, which is why the erasure cannot stand in for the
// specialization: they are different structs, not one shared body.

class Full<T> { value: T; new(value: T) : value = value; }
class Empty {}
type Maybe<T> = Full<T> | Empty;

let fill = <T>(value: T): Maybe<T> => new Full(value);
let get = <T>(m: Maybe<T>, fallback: T): T =>
    if (m is Full<T>) (m as Full<T>).value else fallback;
let roundtrip = <T>(value: T, fallback: T): T => get(fill(value), fallback);

export let main = (): i32 => {
  // A PRIMITIVE through the same erased path: Full<i32> stores an i32
  // field, Full<erased> stores a reference — different structs.
  let n = roundtrip<i32>(42, 7);
  let s = roundtrip<String>('ok', 'no');
  return n + s.length;
};
