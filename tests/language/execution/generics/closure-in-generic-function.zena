// @mode: run
// @result: 7
// @skip: a closure created inside a generic FUNCTION does not lower —
// "zir unsupported: celled capture @twice_spec_i32". BUGS.md files the
// generic-CLASS-method case, which fails differently ("non-concrete
// function reached"); this is the same restriction reached by the other
// road, and it is why zena:async's combinators are waiter objects.

/** A closure created inside a generic function's body. */
function apply<T>(v: T, f: (x: T) => T): T {
  return f(v);
}

function twice<T>(v: T, f: (x: T) => T): T {
  let g = (x: T) => f(f(x));
  return apply<T>(v, g);
}

export function main(): i32 {
  return twice<i32>(3, (x: i32) => x + 2);
}
