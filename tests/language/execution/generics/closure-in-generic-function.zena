// @mode: run
// @result: 7

/** A closure created inside a generic function's body. */
function apply<T>(v: T, f: (x: T) => T): T {
  return f(v);
}

function twice<T>(v: T, f: (x: T) => T): T {
  let g = (x: T) => f(f(x));
  return apply<T>(v, g);
}

export function main(): i32 {
  return twice<i32>(3, (x: i32) => x + 2);
}
