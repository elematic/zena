// @mode: run
// @result: 4
// The BODY of a generic private method's specialization must be traversed
// by reachability: constructions inside it (an extension-class constructor
// here) register only through that walk.

import { FixedArray } from 'zena:array';

class P {
  #items<T>(n: i32, v: T): FixedArray<T> {
    return new FixedArray<T>(n, v);
  }

  go(): i32 {
    let words = "a,b".split(",");
    let copies = this.#items(2, "x");
    return words.length + copies.length;
  }
}

export let main = (): i32 => {
  let p = new P();
  return p.go();
};
