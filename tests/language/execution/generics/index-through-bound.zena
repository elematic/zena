// @mode: run
// @stdlib: true
// @result: 36

import { Array } from 'zena:array';
import { FixedArray } from 'zena:fixed-array';

// `<A extends Array<T>>` is the signature that accepts every array
// representation at no cost: each specialization's receiver is the
// concrete array, and both member and INDEX access resolve through the
// bound (docs/design/array-mutability.md, "Operator lookup through
// generic bounds").
function sum<A extends Array<i32>>(arr: A): i32 {
  var total = 0;
  for (var i = 0; i < arr.length; i += 1) {
    total += arr[i];
  }
  return total;
}

export let main = (): i32 => {
  let imm = [1, 2, 3];
  let fixed: FixedArray<i32> = [10, 20];
  return sum(imm) + sum(fixed);
};
