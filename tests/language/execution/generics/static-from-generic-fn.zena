// @mode: run
// @result: 7

// A generic static called from inside a generic function, its type
// argument fed by the callers own parameter: the specialized walk
// must resolve the solved arguments through its bindings before
// instantiating, or the static is minted at the erasure and the
// specialization fails to find it ("static method not found").

class Holder {
  static pick<A>(v: A): A { return v; }
}

let via = <T>(v: T): T => {
  return Holder.pick<T>(v);
};

export let main = (): i32 => {
  return via<i32>(7);
};
