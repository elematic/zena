// @mode: run
// @result: 1

class Node(value: i32, label: String? = null, weight: i32 = 10)

sealed class Expr {
  case Lit(value: i32, tag: String = "num", note: String? = null)
}

export let main = (): i32 => {
  let n1 = new Node(5);
  if (n1.value != 5 || n1.label != null || n1.weight != 10) {
    return 10;
  }

  let n2 = new Node(7, "seven");
  if (n2.value != 7 || n2.label != "seven" || n2.weight != 10) {
    return 20;
  }

  let n3 = new Node(9, null, 99);
  if (n3.value != 9 || n3.label != null || n3.weight != 99) {
    return 30;
  }

  let e1 = new Lit(42);
  if (e1.value != 42 || e1.tag != "num" || e1.note != null) {
    return 40;
  }

  let e2 = new Lit(42, "custom", "memo");
  if (e2.value != 42 || e2.tag != "custom" || e2.note != "memo") {
    return 50;
  }

  return 1;
};
