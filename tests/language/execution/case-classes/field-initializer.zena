// @mode: run
// @result: 0

var counter = 0;
let nextId = () => {
  counter += 1;
  return counter;
};

sealed class Node {
  var id: i32 = nextId();
  case Lit(value: i32)
}

export let main = () => {
  let a = new Lit(1);
  let b = new Lit(2);
  if (a.id == b.id) {
    return 1; // Error: IDs are the same
  }
  return 0; // Success
};
