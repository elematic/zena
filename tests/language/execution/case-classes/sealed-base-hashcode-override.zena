// @mode: run
// @result: true
// Regression test: a sealed base declares a concrete hashCode() and
// operator == above case-class leaves. The generated module must validate and
// dispatch through base-typed references without trapping.
//
// A case class that inherits a declared hashCode() or operator == derives
// neither, so the leaves hash by the base's uid
// (sealed-base-declares-equality.zena covers the rule).

var nextUid = 1;
let getUid = (): i32 => {
  let id = nextUid;
  nextUid += 1;
  return id;
};

sealed class Ty implements Hashable {
  uid: i32 = getUid();

  hashCode(): i32 {
    return this.uid;
  }

  operator ==(other: Ty): boolean {
    return this === other;
  }

  case IntTy
  case PairTy(a: i32, b: i32)
}

export let main = (): boolean => {
  let t1: Ty = new IntTy();
  let t2: Ty = new PairTy(3, 4);
  let a = t1.hashCode();
  let b = t2.hashCode();
  return a == t1.hashCode() && b == t2.hashCode() &&
      a == t1.uid && b == t2.uid;
};
