// @mode: run
// @result: 0
// Case classes nominally implement Hashable: they are assignable to the
// interface without an explicit implements clause, and hashCode() dispatches
// correctly through the interface.
import {Hashable} from 'zena:hashable';

class CaseKey(name: String, id: i32)

let hashOf = (h: Hashable): i32 => h.hashCode();

export let main = (): i32 => {
  let k = new CaseKey('x', 3);
  if (hashOf(k) != k.hashCode()) { return 1; }
  return 0;
};
