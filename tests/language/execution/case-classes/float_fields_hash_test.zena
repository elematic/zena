// @mode: run
// @invoke: main
// @result: 0

sealed class Shape {
  case Circle(radius: f64)
  case Rect(width: f64, height: f64)
}

let describe = (shape: Shape): String => match (shape) {
  case Circle {radius} if radius > 10.0: 'a large circle'
  case Circle: 'a circle'
  case Rect {width, height} if width == height: 'a square'
  case _: 'a rectangle'
};

export let main = (): i32 => {
  let c1 = new Circle(20.0);
  let c2 = new Circle(5.0);
  let r1 = new Rect(3.0, 3.0);
  let r2 = new Rect(4.0, 5.0);

  if (describe(c1) != 'a large circle') { return 1; }
  if (describe(c2) != 'a circle') { return 2; }
  if (describe(r1) != 'a square') { return 3; }
  if (describe(r2) != 'a rectangle') { return 4; }

  // Verify hashCode runs without error and is consistent
  let h1 = c1.hashCode();
  let h2 = c1.hashCode();
  if (h1 != h2) { return 5; }

  let hr1 = r1.hashCode();
  let hr2 = r1.hashCode();
  if (hr1 != hr2) { return 6; }

  return 0;
};
