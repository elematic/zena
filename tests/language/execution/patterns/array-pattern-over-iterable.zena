// @mode: run
// @result: 6
// @skip: an array pattern over an iterable type-checks and bails in lowering with "array element read" (elematic/zena#798)
//
// The checker admits an array pattern over anything in the synchronous
// iteration protocol; lowering reads an element only from an array, a
// buffer-backed class or an interface with an index read.

class Counter implements Iterator<i32> {
  var n: i32 = 0;
  next(): Step<i32> {
    this.n += 1;
    return (1, this.n, _);
  }
}

class Counting implements Iterable<i32> {
  [Iterable.iterator](): Iterator<i32> { return new Counter(); }
  contains(value: i32): boolean { return false; }
  all(predicate: (item: i32) => boolean): boolean { return false; }
  some(predicate: (item: i32) => boolean): boolean { return false; }
  fold<R>(initial: R, combine: (acc: R, item: i32) => R): R { return initial; }
  find(predicate: (item: i32) => boolean): inline (true, i32) | inline (false, _) { return (false, _); }
  filter(predicate: (item: i32) => boolean): Iterable<i32> { return this; }
}

export function main(): i32 {
  let [a, b, c] = new Counting();
  return a + b + c;
}
