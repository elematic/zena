// A symbol-keyed member whose symbol IS exported: reachable from another
// module, exactly as `docs/design/classes.md` §9.4 describes.
export symbol tag;

// ...and one whose symbol is not. Nothing outside this module can name it.
symbol secret;

export class Holder {
  var [tag]: i32;
  var [secret]: i32;

  new(t: i32, s: i32) {
    this.[tag] = t;
    this.[secret] = s;
  }

  /** The only legitimate way out for the private one. */
  reveal(): i32 { return this.[secret]; }
}
