// @mode: run
// @result: 42

// An EXPORTED symbol keys a member another module can read, which is the
// half that must keep working now that an unexported one cannot.
import { Holder, tag } from './lib.zena';

export let main = (): i32 => {
  let h = new Holder(10, 32);
  return h.:tag + h.reveal();
};
