// @mode: run
// @result: 142

function pick(x: i32): i32 {
  return x * 2;
}

function pick(a: i32, b: i32): i32 {
  return a + b;
}

function pick(r: BoundedRange): i32 {
  return pick(r.start, r.end) + 100;
}

export function main(): i32 {
  let a = pick(5);       // 10
  let b = pick(10, 12);  // 22
  let c = pick(4..6);    // 110
  return a + b + c;      // 142
}

