// @mode: run
// @result: 100
// @invoke: main

class Point {
  var x: i32;
  y: i32;
  new(x: i32, y: i32) : x = x, y = y {}
}

let destructRecordParam = ({x, y}: {x: i32, y: i32}): i32 => {
  return x + y;
};

let destructTupleParam = ((a, b): (i32, i32)): i32 => {
  return a + b;
};

let destructClassParam = ({x, y}: Point): i32 => {
  return x + y;
};

let mixedParams = (prefix: i32, {x, y}: {x: i32, y: i32}, suffix: i32): i32 => {
  return prefix + x + y + suffix;
};

export let main = (): i32 => {
  let res1 = destructRecordParam({x: 10, y: 20}); // 30
  let res2 = destructTupleParam((10, 20)); // 30
  let res3 = destructClassParam(new Point(10, 20)); // 30
  let res4 = mixedParams(5, {x: 10, y: 20}, 5); // 5 + 10 + 20 + 5 = 40

  if (res1 == 30 && res2 == 30 && res3 == 30 && res4 == 40) {
    return 100;
  }
  return 0;
};
