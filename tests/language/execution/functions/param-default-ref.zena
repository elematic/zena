// @mode: run
// @result: 40
// Test: Default parameters can reference earlier parameters
// This tests the "caller supplies default" strategy where defaults
// like `end = this.length - start` can access both `this` and `start`.

let foo = (a: i32 = 0, b: i32 = a + 1, c: i32 = a + b): i32 => {
  return a + b + c;
};

export let main = (): i32 => {  
  let r1 = foo(); // a=0, b=1, c=1, return 2
  let r2 = foo(5); // a=5, b=6, c=11, return 22
  let r3 = foo(2, 3); // a=2, b=3, c=5, return 10
  let r4 = foo(1, 2, 3); // a=1, b=2, c=3, return 6
  return r1 + r2 + r3 + r4; // 2 + 22 + 10 + 6 = 40
};
