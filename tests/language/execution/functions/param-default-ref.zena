// @mode: run
// @result: 0
// Test: Default parameters can reference earlier parameters
// This tests the "caller supplies default" strategy where defaults
// like `end = this.length - start` can access both `this` and `start`.

let foo = (a: i32 = 0, b: i32 = a + 1, c: i32 = a + b): i32 => {
  return a + b + c;
};

export let main = (): i32 => {  
  // Test 4: foo(5) -> a=5, b=5+1=6, c=5+6=11, return 5+6+11=22
  let r4 = foo(5);
  if (r4 != 22) return 4;
  
  // Test 5: foo() -> a=0, b=0+1=1, c=0+1=1, return 0+1+1=2
  let r5 = foo();
  if (r5 != 2) return 5;
  
  return 0;
};
