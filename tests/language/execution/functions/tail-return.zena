// @mode: run
// @result: 1000000
// `tail return` runs in constant stack: a million frames deep is a
// stack overflow without it (docs/design/tail-calls.md).

function down(n: i32, acc: i32): i32 {
  if (n == 0) {
    return acc;
  }
  tail return down(n - 1, acc + 1);
}

// Mutual recursion is a tail call too, and so is a method call.
function even(n: i32): i32 {
  if (n == 0) {
    return 1;
  }
  tail return odd(n - 1);
}

function odd(n: i32): i32 {
  if (n == 0) {
    return 0;
  }
  tail return even(n - 1);
}

class Counter {
  step: i32;
  new(this.step);

  countDown(n: i32): i32 {
    if (n <= 0) {
      return 0;
    }
    tail return this.countDown(n - this.step);
  }
}

// `tail` is a contextual keyword, so it is still a name.
let tail = 7;

export let main = (): i32 => {
  let c = new Counter(1);
  return down(1000000, 0) + even(999999) + odd(1000000) +
      c.countDown(500000) + tail - 7;
};
