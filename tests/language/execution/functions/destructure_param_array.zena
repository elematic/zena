// @mode: run
// @result: 100
// @invoke: main

let sumPair = ([a, b]: Array<i32>): i32 => a + b;
let headPlusTailLen = ([head, ...tail]: Array<i32>): i32 => head + tail.length;

export let main = (): i32 => {
  let pair: Array<i32> = [40, 60];
  let res1 = sumPair(pair); // 100

  let items: Array<i32> = [95, 1, 2, 3, 4, 5];
  let res2 = headPlusTailLen(items); // 95 + 5 = 100

  if (res1 == 100 && res2 == 100) {
    return 100;
  }
  return 0;
};
