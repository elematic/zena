// @mode: run
// @result: 221

// Overloads whose parameters differ only in a type argument are
// distinct overloads: each call runs the body it selected.

class Box<T> {
  value: T;
  new(value: T) : value = value {}
}

class Describe {
  static of(b: Box<i32>): i32 { return 1; }
  static of(b: Box<f64>): i32 { return 2; }

  kind(b: Box<i32>): i32 { return 10; }
  kind(b: Box<String>): i32 { return 20; }
}

export let main = (): i32 => {
  let d = new Describe();
  return Describe.of(new Box(1.5)) * 100 + d.kind(new Box('s')) +
      Describe.of(new Box(7));
};
