// @mode: run
// @result: 18
// A `gen function` is a generator, same as a `gen` arrow.
import { Iterator } from 'zena:iterator';

gen function counter(n: i32): Iterator<i32> {
  var i = 0;
  while (i < n) {
    yield i;
    i += 1;
  }
}

function sumOf(it: Iterator<i32>): i32 {
  var total = 0;
  for (let v in it) { total += v; }
  return total;
}

export function main(): i32 {
  return sumOf(counter(5)) + identity(7) + identity(1);
}

function identity<T>(x: T): T {
  return x;
}
