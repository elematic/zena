// @mode: run
// @result: 161
// `function` declarations are hoisted: forward references, self-recursion
// and mutual recursion all resolve without ordering the file by hand.

export function main(): i32 {
  return isEven(10) + apply(double, 20) + fact(5);
}

function isEven(n: i32): i32 {
  if (n == 0) { return 1; }
  return isOdd(n - 1);
}

function isOdd(n: i32): i32 {
  if (n == 0) { return 0; }
  return isEven(n - 1);
}

function fact(n: i32): i32 {
  if (n <= 1) { return 1; }
  return n * fact(n - 1);
}

// Passed as a function reference, not called directly.
function apply(f: (x: i32) => i32, v: i32): i32 {
  return f(v);
}

function double(x: i32): i32 {
  return x * 2;
}
