// @mode: run
// @result: 3
// @invoke: main

// Field defaults in a destructured record parameter (combined syntax)
// never apply — the argument record always has the full shape — but
// must compile and bind the passed values.
let getSum = ({x: i32 = 5, y: i32}) => x + y;

export let main = (): i32 => {
  return getSum({x: 1, y: 2});
};
