// @mode: run
// @result: 18
// Forwarding a callee's multi-value return as the caller's own
// return value (a 'return' whose expression is itself a
// multi-value call).

let pair = (): (i32, i32) => {
  return (30, 12);
};

let forward = (): (i32, i32) => {
  return pair();
};

export let main = (): i32 => {
  let (c, d) = forward();
  return c - d;
};
