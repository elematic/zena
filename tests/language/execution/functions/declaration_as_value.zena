// @mode: run
// @result: 30
// A `function` used as a value: stored in a binding, put in an array, and
// handed to a higher-order function.
import { Array } from 'zena:array';

function inc(x: i32): i32 {
  return x + 1;
}

function triple(x: i32): i32 {
  return x * 3;
}

function pipeline(fs: Array<(x: i32) => i32>, start: i32): i32 {
  var acc = start;
  for (let f in fs) { acc = f(acc); }
  return acc;
}

export function main(): i32 {
  let alias = inc;
  let fs = new Array<(x: i32) => i32>();
  fs.push(inc);
  fs.push(triple);
  // alias(1) = 2, then pipeline: (2+1)*3 = 9 ... plus 21 below.
  return pipeline(fs, alias(1)) + triple(7);
}
