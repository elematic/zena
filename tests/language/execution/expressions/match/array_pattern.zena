// @mode: run
// @result: 100
// @invoke: main

let evalArray = (arr: Array<i32>): i32 => {
  return match (arr) {
    case []: 0
    case let [a]: a * 10
    case let [a, b]: a + b
    case let [head, ...tail]: head + tail.length
  };
};

export let main = (): i32 => {
  let emptyArr: Array<i32> = [];
  let oneArr: Array<i32> = [5];
  let twoArr: Array<i32> = [10, 20];
  let fourArr: Array<i32> = [100, 1, 2, 3];

  let r0 = evalArray(emptyArr); // 0
  let r1 = evalArray(oneArr);   // 50
  let r2 = evalArray(twoArr);   // 30
  let r3 = evalArray(fourArr);  // 100 + 3 = 103

  if (r0 == 0 && r1 == 50 && r2 == 30 && r3 == 103) {
    return 100;
  }
  return 0;
};
