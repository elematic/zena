// @mode: run
// @result: true

export let main = (): boolean => {
  let arr: FixedArray<i32> = [10, 20, 30, 40, 50];

  // BoundedRange indexing
  let slice1 = arr[1..4];
  if (slice1.length != 3) { return false; }
  if (slice1[0] != 20 || slice1[1] != 30 || slice1[2] != 40) { return false; }

  // Dynamic BoundedRange indexing
  let start = 1;
  let end = 4;
  let slice1_dyn = arr[start..end];
  if (slice1_dyn.length != 3) { return false; }
  if (slice1_dyn[0] != 20 || slice1_dyn[1] != 30 || slice1_dyn[2] != 40) { return false; }

  // FromRange indexing
  let slice2 = arr[2..];
  if (slice2.length != 3) { return false; }
  if (slice2[0] != 30 || slice2[1] != 40 || slice2[2] != 50) { return false; }

  // Dynamic FromRange indexing
  let start_dyn = 2;
  let slice2_dyn = arr[start_dyn..];
  if (slice2_dyn.length != 3) { return false; }
  if (slice2_dyn[0] != 30 || slice2_dyn[1] != 40 || slice2_dyn[2] != 50) { return false; }

  // ToRange indexing
  let slice3 = arr[..3];
  if (slice3.length != 3) { return false; }
  if (slice3[0] != 10 || slice3[1] != 20 || slice3[2] != 30) { return false; }

  // Dynamic ToRange indexing
  let end_dyn = 3;
  let slice3_dyn = arr[..end_dyn];
  if (slice3_dyn.length != 3) { return false; }
  if (slice3_dyn[0] != 10 || slice3_dyn[1] != 20 || slice3_dyn[2] != 30) { return false; }

  // FullRange indexing
  let slice4 = arr[..];
  if (slice4.length != 5) { return false; }
  if (slice4[0] != 10 || slice4[1] != 20 || slice4[2] != 30 || slice4[3] != 40 || slice4[4] != 50) { return false; }

  return true;
};
