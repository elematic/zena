// @mode: run
// @result: 13

// An array literal returned where the signature says `Array<T>`: the
// literal is an immutable array, and the return adapts it to the
// `Array` interface the way a `let` with the same annotation does.
// Both shapes of function body, and a top-level `function` too.

class Node {
  v: i32;
  new(this.v);
}

let pair = (): Array<Node> => [new Node(1), new Node(2)];

let triple = (): Array<Node> => {
  return [new Node(1), new Node(2), new Node(3)];
};

function quad(): Array<Node> {
  return [new Node(1), new Node(2), new Node(3), new Node(4)];
}

export let main = (): i32 => {
  let a = pair();
  let b = triple();
  let c = quad();
  return a.length + b.length + c.length + a[0].v + b[2].v;
};
