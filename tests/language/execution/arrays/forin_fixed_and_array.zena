// @mode: run
// @result: 67
// for-in fast paths under ZENA_BACKEND=zir: FixedArray (wasm array
// via array.len/array.get) with break and continue, and Array
// (#buffer/#length struct) over reference elements.
import { GrowableArray } from 'zena:growable-array';

let sumFixed = (xs: FixedArray<i32>): i32 => {
  var acc = 0;
  for (let x in xs) {
    if (x == 3) {
      continue;
    }
    if (x == 9) {
      break;
    }
    acc += x;
  }
  return acc;
};

class Point {
  x: i32;
  new(this.x);
}

let sumArray = (points: Array<Point>): i32 => {
  var acc = 0;
  for (let p in points) {
    acc += p.x;
  }
  return acc;
};

export let main = (): i32 => {
  let fixed: FixedArray<i32> = [1, 2, 3, 4, 9, 5];
  var acc = sumFixed(fixed);
  let points = new GrowableArray<Point>();
  points.push(new Point(10));
  points.push(new Point(20));
  points.push(new Point(30));
  acc += sumArray(points);
  return acc;
};
