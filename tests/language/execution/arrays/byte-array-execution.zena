// @mode: run
// @result: 150
import { newByteArray } from 'zena:byte-array';

export let main = (): i32 => {
  let arr = newByteArray(5);
  arr[0] = 10;
  arr[1] = 20;
  arr[2] = 30;
  arr[3] = 40;
  arr[4] = 50;

  // A byte reads as `u8`, so combining it with an i32 accumulator needs
  // an explicit widening — mixed signedness is never implicit.
  var sum = 0;
  for (var i = 0; i < arr.length; i += 1) {
    sum = sum + (arr[i] as i32);
  }
  return sum;
};
