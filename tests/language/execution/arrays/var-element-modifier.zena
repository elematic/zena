// @mode: run
// @stdlib: true
// @result: 6

import { FixedArray } from 'zena:fixed-array';

// `array<var i32>` is today's mutable-element array under its explicit
// spelling: writes through it work, and it interchanges with the bare
// spelling.
let sum = (arr: array<var i32>): i32 => {
  var total = 0;
  for (let v in arr as FixedArray<i32>) {
    total += v;
  }
  return total;
};

export let main = (): i32 => {
  let arr: array<var i32> = __array_new(3, 0);
  arr[0] = 1;
  arr[1] = 2;
  arr[2] = 3;
  let bare: array<i32> = arr;
  return sum(bare);
};
