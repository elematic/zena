// @mode: run
// @stdlib: true
// @result: 6

import { FixedArray } from 'zena:fixed-array';

// `array<var i32>` is the mutable-element array: writes through it
// work, and FixedArray is its extension class.
let sum = (arr: array<var i32>): i32 => {
  var total = 0;
  for (let v in arr as FixedArray<i32>) {
    total += v;
  }
  return total;
};

export let main = (): i32 => {
  let arr: array<var i32> = __array_new(3, 0);
  arr[0] = 1;
  arr[1] = 2;
  arr[2] = 3;
  return sum(arr);
};
