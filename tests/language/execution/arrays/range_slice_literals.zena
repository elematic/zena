// @mode: run
// @result: 32
// Slicing a concrete array with each range literal form.
export let main = (): i32 => {
  let xs = [1, 2, 3, 4, 5] as FixedArray<i32>;
  let a = xs[1..3];   // 2, 3
  let b = xs[3..];    // 4, 5
  let c = xs[..2];    // 1, 2
  let d = xs[..];     // 1..5
  var total = 0;
  for (let x in a) { total += x; }
  for (let x in b) { total += x; }
  for (let x in c) { total += x; }
  for (let x in d) { total += x; }
  return total;  // 5 + 9 + 3 + 15
};
