// @mode: run
// @result: 42
// A `requires` clause is checked on every call. A call that fails it
// throws a ContractError and does not reach the body.

var bodyRuns = 0;

function half(n: i32): i32 requires (n % 2 == 0) {
  bodyRuns += 1;
  return n >> 1;
}

// 1 when `run` fails a contract, 0 when it returns, 2 on any other error.
function violates(run: () => i32): i32 {
  try {
    run();
    return 0;
  } catch (e) {
    return if (e is ContractError) 1 else 2;
  }
}

export function main(): i32 {
  var score = half(80); // 40
  score += violates(() => half(3)); // +1
  score += violates(() => half(4)); // +0
  // The failing call never ran the body: two calls did.
  score += bodyRuns - 1; // +1
  return score;
}
