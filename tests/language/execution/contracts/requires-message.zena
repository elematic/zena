// @mode: run
// @stdout: requires (amount > 0) does not hold
// The error's message is the clause as it was written.

function withdraw(balance: i32, amount: i32): i32
  requires (amount > 0)
  requires (balance >= amount)
{
  return balance - amount;
}

export function main(): void {
  try {
    withdraw(10, 0);
  } catch (e) {
    console.log(e.message);
  }
}
