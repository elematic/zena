// @mode: run
// @invoke: main
// @result: 42

mixin M {
  abstract value(): i32;
  foo(): i32 {
    return this.value() + 2;
  }
}

class Base {
  value(): i32 { return 40; }
  new();
}

class C extends Base with M {
  new() : super();
}

export let main = (): i32 => {
  let c = new C();
  return c.foo();
};
