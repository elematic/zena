// @mode: run
// @result: 6
// A final class with a mixin and no other superclass keeps no method
// table slots, since nothing can dispatch through it. A mixin method
// that calls a method the class overrides still reaches the override.

mixin Describe {
  describe(): i32 { return this.size() * 2; }
  size(): i32 { return 1; }
}

final class Tile with Describe {
  width: i32;
  new(width: i32) : width = width;
  size(): i32 { return this.width; }
}

export let main = (): i32 => {
  let b = new Tile(3);
  return b.describe();
};
