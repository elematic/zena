// @mode: run
// @invoke: main
// @result: 50

import {M as RemoteM} from './collision_helper.zena';

mixin M {
  var y: i32 = 5;
  bar(): i32 {
    return this.y + 3;
  }
}

class C with RemoteM, M {
  new();
}

// Test mixin name collision
export let main = (): i32 => {
  let c = new C();
  return c.foo() + c.bar();
};
