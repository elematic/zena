// @mode: run
// @result: 321
// A mixin that applies another mixin (`mixin B with A`) can override the
// other's methods, and a final class with B calls B's versions. A method
// only A declares is still reachable through B.

mixin A {
  hundreds(): i32 { return 900; }
  tens(): i32 { return 20; }
}

mixin B with A {
  hundreds(): i32 { return 300; }
  ones(): i32 { return 1; }
}

final class C with B {
  new();
}

export let main = (): i32 => {
  let c = new C();
  return c.hundreds() + c.tens() + c.ones();
};
