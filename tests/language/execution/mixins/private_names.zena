// @mode: run
// @result: 3120
// Mixin privates are lexically scoped to the MIXIN declaration and
// shared across applications — like classes, unlike the JS mixin
// pattern where each application mints fresh private names
// (docs/design/member-lookup.md §6). A host class's same-named
// private is a DIFFERENT field: mixin code sees the mixin's #count,
// host code sees the host's, and they never alias — so
// a.bump()x3 -> 3, b.bump()x2 on the mixin's counter -> 2, and
// b.hostCount() -> 100 (host state untouched by mixin code).

mixin Counter {
  var #count: i32 = 0;
  bump(): i32 {
    this.#count += 1;
    return this.#count;
  }
}

class HostA with Counter {
  new();
}

class HostB with Counter {
  var #count: i32 = 100;
  new();
  hostCount(): i32 {
    return this.#count;
  }
}

export let main = (): i32 => {
  let a = new HostA();
  a.bump();
  a.bump();
  let b = new HostB();
  b.bump();
  return a.bump() * 1000 + b.bump() * 10 + b.hostCount();
};
