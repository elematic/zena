// @mode: run
// @invoke: main
// @result: 1111

class Base {
  new();
  step(): i32 { return 1; }
}

mixin M1 on Base {
  step(): i32 { return super.step() + 10; }
}

mixin M2 on Base {
  step(): i32 { return super.step() + 100; }
}

class C extends Base with M1, M2 {
  new() : super();
  step(): i32 { return super.step() + 1000; }
}

export let main = (): i32 => {
  let c = new C();
  // 1 (Base) + 10 (M1) + 100 (M2) + 1000 (C) = 1111
  return c.step();
};
