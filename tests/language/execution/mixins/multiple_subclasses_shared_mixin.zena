// @mode: run
// @invoke: main
// @result: 55

class Animal {
  var age: i32;
  new(this.age);
}

mixin Greeter on Animal {
  greet(multiplier: i32): i32 {
    return this.age * multiplier;
  }
}

class Dog extends Animal with Greeter {
  new(age: i32) : super(age);
}

class Cat extends Animal with Greeter {
  new(age: i32) : super(age);
}

export let main = (): i32 => {
  let dog = new Dog(5);
  let cat = new Cat(3);
  // dog.greet(5) = 25; cat.greet(10) = 30; total = 55
  return dog.greet(5) + cat.greet(10);
};
