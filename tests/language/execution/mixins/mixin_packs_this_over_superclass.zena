// @mode: run
// @result: 3
// A mixin method that passes `this` on as the mixin's `on` interface works
// when the mixin is applied over a superclass, as it does without one.
interface Sized {
  size(): i32;
}

final class Holder {
  #item: Sized;

  new(item: Sized) : #item = item;

  read(): i32 {
    return this.#item.size();
  }
}

mixin Wrap on Sized {
  wrap(): Holder {
    return new Holder(this);
  }
}

class Base {}

final class Three extends Base with Wrap implements Sized {
  new() : super();

  size(): i32 {
    return 3;
  }
}

export let main = (): i32 => new Three().wrap().read();
