// @mode: run
// @invoke: main
// @result: 1042

mixin Hold<T> {
  calc(x: T): T {
    return x;
  }
}

class IntBox with Hold<i32> {
  new();
  run(x: i32): i32 {
    return this.calc(x);
  }
}

class StrBox with Hold<String> {
  new();
  run(s: String): String {
    return this.calc(s);
  }
}

export let main = (): i32 => {
  let ib = new IntBox();
  let sb = new StrBox();

  let iv = ib.run(42);
  let sv = sb.run("hello");
  // iv = 42, sv.length = 5. (5 * 200) + 42 = 1042
  return sv.length * 200 + iv;
};
