// @mode: run
// @result: 43
// A class that extends Base with a mixin is still a subclass of Base: a
// call through a Base-typed value reaches the subclass's override. The
// mixin application sits between the two classes, and Base's method
// table has to keep the slot anyway.

class Base {
  new();
  name(): i32 { return 1; }
}

mixin M {
  extra(): i32 { return 2; }
}

class C extends Base with M {
  new() : super();
  name(): i32 { return 40; }
}

let nameOf = (b: Base): i32 => b.name();

export let main = (): i32 => {
  let c = new C();
  return nameOf(c) + nameOf(new Base()) + c.extra();
};
