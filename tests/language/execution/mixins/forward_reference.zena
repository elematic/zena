// @mode: run
// @result: 42
// @skip: a mixin declared later in the same module is an empty shell when the class applying it registers, and a module registers once

// A class applying a mixin declared later in the same module.
interface Named {
  name: String;
}

class Host with Greeter implements Named {
  name: String;
  new(this.name);
}

mixin Greeter on Named {
  greet(): String {
    return 'Hello, ' + this.name + '!';
  }
}

export let main = (): i32 => {
  let h = new Host('world');
  return if (h.greet() == 'Hello, world!') 42 else 0;
};
