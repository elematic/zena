// @mode: run
// @result: 42

// A class applying a mixin declared later in the same module. The mixin
// is an empty shell when the class registers; the application reads the
// mixin's members by reference, so they are there once it registers.
interface Named {
  name: String;
}

class Host with Greeter implements Named {
  name: String;
  new(this.name);
}

mixin Greeter on Named {
  greet(): String {
    return 'Hello, ' + this.name + '!';
  }
}

export let main = (): i32 => {
  let h = new Host('world');
  return if (h.greet() == 'Hello, world!') 42 else 0;
};
