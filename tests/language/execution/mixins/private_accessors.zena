// @mode: run
// @result: 100900
// Mixin private accessors are lexically scoped to the mixin
// declaration (member-lookup.md §6), like mixin private fields and
// methods: a host class's same-named private accessor is a different
// member, and neither ever dispatches virtually.
mixin M {
  #v: i32 {
    get { return 10; }
  }
  mread(): i32 { return this.#v; }
}
class H with M {
  #v: i32 {
    get { return 900; }
  }
  new();
  hread(): i32 { return this.#v; }
}
export let main = (): i32 => {
  let h = new H();
  return h.mread() * 10000 + h.hread();  // lexical: 100900
};
