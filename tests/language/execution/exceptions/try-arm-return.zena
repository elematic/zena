// @mode: run
// @result: 42
// A try arm whose block ends in `return`. The arm supplies no value to
// the try expression at all — it leaves the function — so the try is
// `never` when both arms return and takes the other arm's type when
// only one does.

import { Error } from 'zena:error';

let mayThrow = (fail: boolean): i32 => {
  if (fail) {
    throw new Error("boom");
  }
  return 21;
};
let sink = (v: i32): void => {};

// Both arms return: the try is the whole (tail) body of the function.
let bothReturn = (fail: boolean): i32 => {
  try {
    return mayThrow(fail);
  } catch (e) {
    return 0 - 1;
  }
};

// Only the body returns; the handler falls through to the code after.
let bodyReturns = (fail: boolean): i32 => {
  try {
    return mayThrow(fail);
  } catch (e) {
    sink(1);
  }
  return 7;
};

// Only the body returns, and the handler supplies a value.
let handlerValues = (fail: boolean): i32 => {
  let v = try {
    return mayThrow(fail);
  } catch (e) {
    5
  };
  return v + 1;
};

export let main = (): i32 => {
  if (bothReturn(false) != 21) { return 0 - 1; }
  if (bothReturn(true) != 0 - 1) { return 0 - 2; }
  if (bodyReturns(false) != 21) { return 0 - 3; }
  if (bodyReturns(true) != 7) { return 0 - 4; }
  if (handlerValues(false) != 21) { return 0 - 5; }
  if (handlerValues(true) != 6) { return 0 - 6; }
  return 42;
};
