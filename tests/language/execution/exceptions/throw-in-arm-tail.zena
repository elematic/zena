// @mode: run
// @stdout: small\nbig\ncaught\ndone

let describe = (n: i32): String => {
  let label = if (n < 10) {
    'small'
  } else if (n < 100) {
    'big'
  } else {
    throw new Error('out of range');
  };
  return label;
};

export let main = (): void => {
  console.log(describe(5));
  console.log(describe(50));
  try {
    console.log(describe(500));
  } catch (e) {
    console.log('caught');
  };
  console.log('done');
};
