// @skip: bootstrap, self-hosted
// @mode: run
// @result: 42
// Neither compiler handles an assignment to an enclosing local as the last
// statement of a try block today: the bootstrap leaves the assignment's
// value on the stack, emitting invalid wasm ("values remaining on stack at
// end of block"), and ZIR bails loudly ("assignment to enclosing local in
// try body"). See BUGS.md. Whichever side gets fixed first should drop its
// skip marker and pass this test.

let mayThrow = (fail: boolean): i32 => {
  if (fail) {
    throw new Error("boom");
  }
  return 42;
};

export let main = (): i32 => {
  var result = 0;
  try {
    result = mayThrow(false);
  } catch (e) {
    result = 0 - 1;
  }
  return result;
};
