// @mode: run
// @result: 42
// An assignment to an enclosing local as the last statement of a try
// block. Enclosing locals a try body assigns live in heap cells, so
// the write survives the protected edge.

let mayThrow = (fail: boolean): i32 => {
  if (fail) {
    throw new Error("boom");
  }
  return 42;
};

export let main = (): i32 => {
  var result = 0;
  try {
    result = mayThrow(false);
  } catch (e) {
    result = 0 - 1;
  }
  return result;
};
