// @mode: run
// @result: 42
// A try used as a statement discards its value, so its arms may end in
// expressions of any types, primitive and reference alike (#312).

let f = (fail: boolean): i32 => {
  if (fail) {
    throw new Error('failed');
  }
  return 3;
};

let run = (fail: boolean): i32 => {
  var message = '';
  var result = 0;
  try {
    result = f(fail);
  } catch (e) {
    message = e.message;
  }
  return result + message.length;
};

let tail = (): i32 => {
  var count = 0;
  try {
    f(false);
  } catch (e) {
    count = -1;
  }
  try {
    count += 1;
    f(true);
  } catch (e) {
    e.message;
  }
  return count;
};

export let main = (): i32 => run(false) + run(true) + tail() * 33;
