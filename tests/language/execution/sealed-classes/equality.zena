// @mode: run
// @result: 1
// Each case of a sealed class derives a structural `==`. The sealed base
// declares none, so at the base type the only comparison is identity,
// spelled `===`.
sealed class Shape {
  case Circle(radius: i32)
  case Square(side: i32)
}

export let main = (): i32 => {
  let c1 = new Circle(5);
  let c2 = new Circle(5);
  let s1: Shape = c1;
  let s2: Shape = c2;
  var r = 0;
  if (c1 == c2) { r += 1; }
  if (s1 === s2) { r += 10; }
  return r;
};
