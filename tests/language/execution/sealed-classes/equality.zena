// @mode: run
// @result: true
// `==` on the sealed base calls the runtime class's operator: both are
// Circles with the same radius (docs/design/equality.md, "Virtual equality
// with an identity default").
sealed class Shape {
  case Circle(radius: i32)
  case Square(side: i32)
}

export let main = (): boolean => {
  let s1: Shape = new Circle(5);
  let s2: Shape = new Circle(5);
  return s1 == s2;
};
