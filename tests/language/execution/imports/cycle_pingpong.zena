// @mode: run
// @invoke: main
// @result: 42
// Mutually recursive functions across a two-module import cycle
// (docs/design/import-cycles.md).

import { pong } from './cycle_pingpong_b.zena';

export let ping = (n: i32): i32 => {
  if (n <= 0) { return 0; }
  return pong(n - 1) + 1;
};

export let main = (): i32 => {
  return ping(5) + 37;
};
