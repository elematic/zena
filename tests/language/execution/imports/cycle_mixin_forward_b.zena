// Support module for cycle_mixin_forward.zena: the mixin, and a function
// whose signature names the host class from the importing module.
import { Host } from './cycle_mixin_forward.zena';

export interface Named {
  name: String;
}

export mixin Greeter on Named {
  greet(): String {
    return 'Hello, ' + this.name + '!';
  }
}

export let describe = (h: Host): String => h.greet();
