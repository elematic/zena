import {Gen, StepId, makeStepId} from './default_param_gen_helper_types.zena';

// The default expression references Gen and StepId, which this module
// imported; the caller of takeStep does not import either.
export let takeStep = (g: Gen<StepId> = new Gen<StepId>()): i32 => {
  let step: StepId = makeStepId(g.next());
  return step as i32;
};
