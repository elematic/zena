export class Counter {
  var value: i32 = 0;
  next(): i32 {
    this.value += 1;
    return this.value;
  }
}

// The default expression references Counter, which is in scope here but not
// necessarily in the caller's module scope.
export let takeStep = (c: Counter = new Counter()): i32 => {
  return c.next();
};
