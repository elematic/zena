// @mode: run
// @invoke: main
// @result: 46

// An imported `function` declaration used as a value: handed straight to
// a higher-order function, and stored in a binding first.
import {addOne, tripleIt} from './function_decl_export_helper.zena';

let apply = (f: (x: i32) => i32, x: i32): i32 => f(x);

export function main(): i32 {
  let g = tripleIt;
  return apply(addOne, 9) + apply(g, 12);
}
