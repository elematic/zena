// @mode: run
// @result: 42

// A class applying a mixin from later in an import cycle. The mixin is
// an empty shell when the host's module first registers; the host's
// application is rebuilt when the cycle registers again, by which time
// the mixin's own registration has filled the shell.
import { Host, makeHost } from './cycle_mixin_b.zena';

export interface Named {
  name: String;
}

export mixin Greeter on Named {
  greet(): String {
    return 'Hello, ' + this.name + '!';
  }
}

export let main = (): i32 => {
  let h = makeHost('world');
  return if (h.greet() == 'Hello, world!') 42 else 0;
};
