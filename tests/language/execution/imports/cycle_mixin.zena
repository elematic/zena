// @mode: run
// @result: 42
// @skip: mixins cannot cross an import cycle yet (mixin members are copied at application time)

import { Host, makeHost } from './cycle_mixin_b.zena';

export interface Named {
  name: String;
}

export mixin Greeter on Named {
  greet(): String {
    return 'Hello, ' + this.name + '!';
  }
}

export let main = (): i32 => {
  let h = makeHost('world');
  return if (h.greet() == 'Hello, world!') 42 else 0;
};

