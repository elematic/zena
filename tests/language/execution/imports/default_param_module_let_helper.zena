let PRIVATE_BASE = 'https://private.test';
let PRIVATE_STEP = 7;

function makeTag(): String {
  return 'tag';
}

export class Config(base: String = PRIVATE_BASE, tag: String = makeTag())

export abstract class BaseClient {
  abstract url(path: String, base: String = PRIVATE_BASE): String;
}

export class SubClient extends BaseClient {
  url(path: String, base: String = 'https://sub.test'): String {
    return `${base}${path}`;
  }
}

export class SuperBase {
  step: i32;
  new(this.step = PRIVATE_STEP);
}
