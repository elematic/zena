// A distinct type through a re-export (export {T} from './dep'): annotation,
// casts, and a function typed in terms of it. The annotation must resolve to
// the real distinct type, not an ErrorType stub.

import {Meters, addMeters} from './reexport_type_alias_index.zena';

export let main = (): i32 => {
  let m: Meters = 40 as Meters;
  return addMeters(m, 2 as Meters) as i32;
};
