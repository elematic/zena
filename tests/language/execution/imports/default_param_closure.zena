// @mode: run
// @invoke: main
// @result: 4

// A call to an imported function that relies on its default-parameter
// expression, made from inside a closure. The default expression
// (new Counter()) must be resolved in the callee's module scope even though
// the call site sits in a closure scope that cannot resolve Counter.

import {takeStep} from './default_param_class_helper.zena';

let run = (f: () => void): void => { f(); };

export let main = (): i32 => {
  var n = 0;
  run((): void => {
    n = takeStep() + takeStep();
  });
  return n + 2;
};
