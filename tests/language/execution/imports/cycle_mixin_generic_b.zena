// Support module for cycle_mixin_generic.zena: the host class, whose
// import of the mixin is the cycle's back edge, and a function
// constructing it.
import { Tally, Holder } from './cycle_mixin_generic.zena';

export class Cell with Tally<i32> implements Holder<i32> {
  value: i32;
  new(this.value);
}

export let makeCell = (value: i32): Cell => new Cell(value);
