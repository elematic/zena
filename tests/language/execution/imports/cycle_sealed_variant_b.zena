// Support module for cycle_sealed_variant.zena: holds a value of the
// sealed class from the importing module and constructs one of its
// variants.
import { Shape, Line } from './cycle_sealed_variant.zena';

export class Wrap {
  shape: Shape;
  new(this.shape);
}

export let wrapLine = (n: i32): Wrap => new Wrap(new Line(n));
