// @mode: run
// @result: 42

// A sealed class and one of its variants imported from later in an
// import cycle: the variant is constructed across the back edge and
// matched on this side.
import { Wrap, wrapLine } from './cycle_sealed_variant_b.zena';

export sealed class Shape {
  case Dot
  case Line(len: i32)
}

export let main = (): i32 => {
  let w = wrapLine(42);
  return match (w.shape) {
    case Dot: 0
    case Line {len}: len
  };
};
