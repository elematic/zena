// Imports the transparent alias `Step2` across the back edge (this
// module is what `step.zena` imports `Thing` from). A `next()` returns
// the alias, exercising the shell-then-fill resolution. Support module.
import { Step2 } from './step.zena';

export class Thing {
  n: i32;
  new(this.n);
}

export class Counter {
  var #i: i32 = 0;
  new();

  next(): Step2 {
    if (this.#i < 3) {
      this.#i += 1;
      return (1, new Thing(this.#i));
    }
    return (0, _);
  }
}
