// @mode: run
// @invoke: main
// @result: 3

// An imported function's default-parameter expression must be resolved in the
// callee's module scope. Counter is deliberately NOT imported here; only the
// helper module can resolve it.

import {takeStep} from './default_param_class_helper.zena';

export let main = (): i32 => {
  let first = takeStep();
  let second = takeStep();
  return first + second + 1;
};
