// A function nothing calls calls a standard library function that reads
// one of its library's module variables. The variable is not in the
// module, so the module's start function must not initialize it.

import {pow} from 'zena:math';

function unused(x: f64): f64 {
  return pow(x, 2.0);
}

export let main = (): i32 => {
  let name = 'a';
  return name.length;
};
