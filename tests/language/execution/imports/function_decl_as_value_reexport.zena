// @mode: run
// @invoke: main
// @result: 46

// A `function` declaration reached through a re-exporting module, used as a
// value. The re-exporting module declares neither function, so looking the
// import's module up by name finds no exported symbol for it; the wrapper the
// value needs has to be keyed by the declaration the import resolves to.
import {addOne} from './function_decl_as_value_reexport_named.zena';
import {tripleIt} from './function_decl_as_value_reexport_star.zena';

let apply = (f: (x: i32) => i32, x: i32): i32 => f(x);

export function main(): i32 {
  let g = tripleIt;
  return apply(addOne, 9) + apply(g, 12);
}
