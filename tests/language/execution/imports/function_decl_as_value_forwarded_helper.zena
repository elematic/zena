// Takes imported `function` declarations as values and hands them on.
import {addOne, tripleIt} from './function_decl_export_helper.zena';

let applyTo = (x: i32, f: (x: i32) => i32): i32 => f(x);

export function addOneVia(x: i32): i32 {
  return applyTo(x, addOne);
}

export let tripleItVia = (x: i32): i32 => applyTo(x, tripleIt);
