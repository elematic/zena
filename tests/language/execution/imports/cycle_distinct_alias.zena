// A distinct type alias from later in an import cycle, used as a field
// type and constructed across the back edge. The alias is a shell when
// the importing module registers; its own registration fills the target.
import { Tagged, wrap } from './cycle_distinct_alias_b.zena';

export distinct type Id = i32;

export let main = (): i32 => {
  let t = wrap(41);
  return (t.id as i32) + 1;
};
