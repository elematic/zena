// @mode: run
// @invoke: main
// @result: 3

// An imported function's default-parameter type and expression must be
// resolved in the callee's module scope, including through the callee's own
// imports: Gen and StepId are imported by the helper from a third module and
// are not visible here.

import {takeStep} from './default_param_gen_helper.zena';

export let main = (): i32 => {
  let first = takeStep();
  let second = takeStep();
  return first + second + 1;
};
