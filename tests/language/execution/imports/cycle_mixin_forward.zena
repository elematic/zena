// @mode: run
// @result: 42

// A class applying a mixin from earlier in an import cycle. The mixin's
// module evaluates first, so the mixin is filled in when this module
// registers; what the cycle adds is that both modules register twice,
// so the mixin's registration and the application must be idempotent.
import { Greeter, Named, describe } from './cycle_mixin_forward_b.zena';

export class Host with Greeter implements Named {
  name: String;
  new(this.name);
}

export let main = (): i32 => {
  let h = new Host('world');
  return if (describe(h) == 'Hello, world!') 42 else 0;
};
