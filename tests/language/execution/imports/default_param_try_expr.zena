// @mode: run
// @invoke: main
// @result: 3

// Like default_param_class, but the omitted-default call sits inside a
// try EXPRESSION, whose arms are checked more than once. The re-check
// path must not re-resolve the spliced default initializer (new Counter())
// in this module's scope — Counter is deliberately not imported here.

import {takeStep} from './default_param_class_helper.zena';

export let main = (): i32 => {
  let first = try {
    takeStep()
  } catch (e) {
    0 - 1
  };
  let second = try {
    takeStep()
  } catch (e) {
    0 - 1
  };
  return first + second + 1;
};
