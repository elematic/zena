// A class through a re-export (export {C} from './dep'): construction, a
// method call, and use as a type annotation. Classes share one type/value
// binding, so this pins the export-finalize path where the fallback to the
// export TYPE is the correct behavior.

import {Counter} from './reexport_class_index.zena';

export let main = (): i32 => {
  let c: Counter = new Counter(40);
  c.bump();
  return c.bump();
};
