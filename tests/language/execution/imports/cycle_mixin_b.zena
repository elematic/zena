// Support module for cycle_mixin.zena: the host class, whose import of
// the mixin is the cycle's back edge, and a function constructing it.
import { Greeter, Named } from './cycle_mixin.zena';

export class Host with Greeter implements Named {
  name: String;
  new(this.name);
}

export let makeHost = (name: String): Host => {
  return new Host(name);
};
