// @mode: run
// @invoke: main
// @result: 21

// Enum member access through a re-export (export {E} from './dep'). The
// re-exporting module's export-finalize pass must preserve the enum's
// value-namespace binding (the member record); binding the enum TYPE instead
// shadows the origin's record and member access fails against the backing
// type (i32).

import {Color, colorCode} from './reexport_enum_index.zena';

export let main = (): i32 => {
  let c: Color = Color.Green;
  return colorCode(c) + (if (c == Color.Green) 1 else 0);
};
