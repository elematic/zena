// @mode: run
// @invoke: main
// @result: 15
// 6 from the ok arm (10 - 4), plus 9 for the length of "underflow".
// Result<T, E> comes from the stdlib as a type alias over a union of tuples,
// and `inline` applies across the module boundary: the defining module
// resolves the tuples, the importer only sees the name.

import { Result } from 'zena:core';

let checkedSub = (a: i32, b: i32): inline Result<i32, String> => {
  if (b > a) {
    return (false, "underflow");
  }
  return (true, a - b);
};

export let main = (): i32 => {
  var total = 0;

  // Ok arm binds the payload.
  if (let (true, v) = checkedSub(10, 4)) {
    total += v;
  }

  // Error arm binds the error.
  if (let (false, e) = checkedSub(1, 5)) {
    total += e.length;
  }

  return total;
};
