// @mode: run
// @invoke: main
// @result: 30

// Function and const values through a re-export (export {x} from './dep').
// Pins that the re-exporting module's export-finalize pass forwards value
// bindings from the origin module (importers must not depend on falling
// through to the origin model by lookup order).

import {double, base} from './reexport_function_index.zena';

export let main = (): i32 => {
  return double(base) + base * 4;
};
