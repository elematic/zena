// @mode: run
// @result: 3

// An array pattern on an Array-typed value reads `length` and `[]`
// through the interface's vtable, so those members need slots even
// though the source never names them. A method body is usually walked
// from the checker's dependency records, which do not record patterns.
class Pair {
  sum(xs: Array<i32>): i32 {
    let [a, b] = xs;
    return a + b;
  }
}

export let main = (): i32 => new Pair().sum([1, 2]);
