// @mode: run
// @invoke: main
// @result: 42

interface Calculator {
  add(a: i32, b: i32): i32;
}

class SimpleCalc implements Calculator {
  new();
  add(a: i32, b: i32): i32 {
    return a + b;
  }
}

export let main = (): i32 => {
  let calc: Calculator = new SimpleCalc();
  return calc.add(40, 2);
};
