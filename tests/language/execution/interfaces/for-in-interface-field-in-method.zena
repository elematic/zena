// @mode: run
// @result: 6

// A for-in over an Array-typed field calls `:iterator` and `next`
// through interface vtables. A method body is usually walked from the
// checker's dependency records, which do not record iteration, so the
// slots have to come from the body's for-in itself.
class Holder {
  values: Array<i32>;
  new(this.values);

  total(): i32 {
    var sum = 0;
    for (let v in this.values) {
      sum += v;
    }
    return sum;
  }
}

export let main = (): i32 => new Holder([1, 2, 3]).total();
