// @mode: run
// @invoke: main
// @result: 3

interface Counter {
  size(): i32;
}

class Counted implements Counter {
  count: i32;
  new(this.count);
  size(): i32 { return this.count; }
}

class Holder {
  items: Counted | null;
  new(this.items);
}

let sizeOf = (counter: Counter | null): i32 =>
  if (counter == null) { -1 } else { counter.size() };

export let main = (): i32 => sizeOf(new Holder(new Counted(3)).items);
