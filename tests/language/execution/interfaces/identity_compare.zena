// @mode: run
// @result: 11111

interface Shape {
  area(): i32;
}

class Circle implements Shape {
  area(): i32 {
    return 3;
  }
}

export let main = (): i32 => {
  let c = new Circle();
  let s1: Shape = c;
  let s2: Shape = c;
  var got = 0;
  // Two separately adapted views of one object are the same object.
  if (s1 === s2) {
    got += 1;
  }
  if (s1 === s1) {
    got += 10;
  }
  // Distinct objects stay distinct.
  let other: Shape = new Circle();
  if (s1 !== other) {
    got += 100;
  }
  // == without an operator== falls back to the same instance identity.
  if (s1 == s2) {
    got += 1000;
  }
  if (s1 != other) {
    got += 10000;
  }
  return got;
};
