// @mode: run
// @invoke: main
// @result: 100

interface Runnable {
  run(): i32;
}

interface Stoppable {
  stop(): i32;
}

class Task implements Runnable, Stoppable {
  new();
  run(): i32 {
    return 80;
  }
  stop(): i32 {
    return 20;
  }
}

export let main = (): i32 => {
  let task = new Task();
  let r: Runnable = task;
  let s: Stoppable = task;
  return r.run() + s.stop();
};
