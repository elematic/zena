// @mode: run
// @result: 36
// A class can implement an interface method with a narrower result: the
// interface declares `scaled(): Shape` and the class returns `Square`.
// A call through the interface gets the result as a `Shape`.
interface Shape {
  area(): i32;
  scaled(): Shape;
}

final class Square implements Shape {
  side: i32;
  new(side: i32) : side = side;
  area(): i32 { return this.side * this.side; }
  scaled(): Square { return new Square(this.side * 2); }
}

export let main = (): i32 => {
  let s: Shape = new Square(3);
  return s.scaled().area();
};
