// @mode: run
// @invoke: main
// @result: 33

// A `Class | null` reaching an `Interface | null` slot packs the fat
// pointer under a null guard: a present value dispatches, and a null
// one stays null rather than becoming a fat pointer around nothing.

interface Counter {
  size(): i32;
}

class Counted implements Counter {
  count: i32;
  new(this.count);
  size(): i32 { return this.count; }
}

class Holder {
  items: Counted | null;
  new(this.items);
}

class Box {
  var counter: Counter | null = null;
  new();
}

let sizeOf = (counter: Counter | null): i32 =>
  if (counter == null) { -1 } else { counter.size() };

// Return position: the declared return type is the interface union,
// the returned value's type is the class union.
let itemsOf = (holder: Holder): Counter | null => { return holder.items; };

export let main = (): i32 => {
  let present = new Holder(new Counted(3));
  let absent = new Holder(null);
  var total = 0;

  // Argument position, both arms of the guard.
  total += sizeOf(present.items); // 3
  total += sizeOf(absent.items); // -1

  // Binding with an explicit annotation.
  let bound: Counter | null = present.items;
  total += sizeOf(bound); // 3
  let boundNull: Counter | null = absent.items;
  total += if (boundNull == null) { 10 } else { 0 }; // 10

  // Field assignment.
  let box = new Box();
  box.counter = present.items;
  total += sizeOf(box.counter); // 3
  box.counter = absent.items;
  total += if (box.counter == null) { 10 } else { 0 }; // 10

  // Return position.
  total += sizeOf(itemsOf(present)); // 3
  total += sizeOf(itemsOf(absent)); // -1

  // A method call straight through the guard.
  let viaCall = itemsOf(present);
  total += if (viaCall == null) { 0 } else { viaCall.size() }; // 3

  return total; // 3 - 1 + 3 + 10 + 3 + 10 + 3 - 1 + 3 = 33
};
