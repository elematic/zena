// @mode: run
// @result: 0
//
// `is` and `as` against an interface with more implementers than a
// chain of class tests is allowed (sixteen): these read the class's
// type info through `Object` (docs/design/interface-type-tests.md).
// `is-means-implements.zena` covers the chained form.

interface Shape {
  area(): i32;
}

interface Named {
  name(): String;
}

final class S0 implements Shape { area(): i32 { return 0; } }
final class S1 implements Shape { area(): i32 { return 1; } }
final class S2 implements Shape { area(): i32 { return 2; } }
final class S3 implements Shape { area(): i32 { return 3; } }
final class S4 implements Shape { area(): i32 { return 4; } }
final class S5 implements Shape { area(): i32 { return 5; } }
final class S6 implements Shape { area(): i32 { return 6; } }
final class S7 implements Shape { area(): i32 { return 7; } }
final class S8 implements Shape { area(): i32 { return 8; } }
final class S9 implements Shape { area(): i32 { return 9; } }
final class S10 implements Shape { area(): i32 { return 10; } }
final class S11 implements Shape { area(): i32 { return 11; } }
final class S12 implements Shape { area(): i32 { return 12; } }
final class S13 implements Shape { area(): i32 { return 13; } }
final class S14 implements Shape { area(): i32 { return 14; } }
final class S15 implements Shape { area(): i32 { return 15; } }
final class S16 implements Shape { area(): i32 { return 16; } }
final class S17 implements Shape { area(): i32 { return 17; } }
final class S18 implements Shape { area(): i32 { return 18; } }
final class S19 implements Shape, Named {
  area(): i32 { return 19; }
  name(): String { return "nineteen"; }
}
class Plain {}

function makeValues() {
  let values = new FixedArray<anyref>(22, null);
  values[0] = new S0();
  values[1] = new S1();
  values[2] = new S2();
  values[3] = new S3();
  values[4] = new S4();
  values[5] = new S5();
  values[6] = new S6();
  values[7] = new S7();
  values[8] = new S8();
  values[9] = new S9();
  values[10] = new S10();
  values[11] = new S11();
  values[12] = new S12();
  values[13] = new S13();
  values[14] = new S14();
  values[15] = new S15();
  values[16] = new S16();
  values[17] = new S17();
  values[18] = new S18();
  values[19] = new S19();
  values[20] = new Plain();
  values[21] = "text";
  return values;
}

function describe(x: anyref): i32 {
  return match (x) {
    case Shape as s: s.area()
    case _: -1
  };
}

export function main(): i32 {
  let values = makeValues();
  var sum = 0;
  var i = 0;
  while (i < values.length) {
    let v = values[i];
    if (v is Shape) {
      sum += (v as Shape).area();
      if (describe(v) != v.area()) { return 1; }
    } else if (describe(v) != -1) {
      return 2;
    }
    i += 1;
  }
  // 0 + 1 + ... + 19
  if (sum != 190) { return 3; }
  if (values[20] is Shape) { return 4; }
  if (values[21] is Shape) { return 5; }

  // A fat pointer of another interface behind an anyref.
  let named: Named = new S19();
  let y: anyref = named;
  if (!(y is Shape)) { return 6; }
  if ((y as Shape).area() != 19) { return 7; }

  // Null answers false.
  let n: anyref = null;
  if (n is Shape) { return 8; }
  return 0;
}
