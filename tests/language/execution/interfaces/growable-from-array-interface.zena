// @mode: run
// @result: 6

// GrowableArray.from reads `length` and `[]` through the Array interface,
// so its specialization needs those slots in Array<Item>'s vtable even
// though nothing else in the program calls them through an interface.
class Item {
  v: i32;
  new(this.v);
}

export let main = (): i32 => {
  let items = GrowableArray.from([new Item(1), new Item(2), new Item(3)]);
  var sum = 0;
  for (let item in items) {
    sum += item.v;
  }
  return sum;
};
