// @mode: run
// @invoke: main
// @result: 3
// @skip: lowering bails with "zir unsupported: constructor field type" —
//   a field declared at an interface type whose default initializer is a
//   class value is never adapted to the interface's fat pointer.
//   https://code.rictic.com/justin/zena/issues/475

interface Counter {
  length: i32 { get; }
}

class Counted implements Counter {
  length: i32;
  new(this.length);
}

class Holder {
  var items: Counter = new Counted(3);
  new();
}

export let main = (): i32 => {
  let h = new Holder();
  return h.items.length;
};
