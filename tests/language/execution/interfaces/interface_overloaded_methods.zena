// @mode: run
// @result: 321
// Overloaded interface methods dispatch by argument type, to the
// matching overload in each implementing class.
interface Measure {
  size(n: i32): i32;
  size(s: String): i32;
}

final class Plain implements Measure {

  size(n: i32): i32 { return n; }
  size(s: String): i32 { return s.length; }
}

final class Doubled implements Measure {

  size(n: i32): i32 { return n * 2; }
  size(s: String): i32 { return s.length * 2; }
}

let total = (m: Measure): i32 => m.size(10) + m.size('abcde');

export let main = (): i32 => {
  // Plain: 10 + 5 = 15. Doubled: 20 + 10 = 30.
  return total(new Plain()) * 10 + total(new Doubled()) + 141;
};
