// @mode: run
// @skip: the function-adaptation wrapper cannot convert the class to the interface on the way back (#520)
// @result: 4
// A closure that returns a class instance, passed where a function that
// returns an interface is expected. The function value needs an adapter
// that turns the class reference into the interface's representation on
// the way back.

interface Shape {
  area(): i32;
}

class Square implements Shape {
  area(): i32 {
    return 4;
  }
}

function measure(make: () => Shape): i32 {
  return make().area();
}

export let main = (): i32 => measure(() => new Square());
