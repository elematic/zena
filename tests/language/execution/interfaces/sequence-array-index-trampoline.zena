// @mode: run
// @result: 42
// Indexing an array-backed class through its Sequence interface goes
// through a generated trampoline whose target is the
// @intrinsic('array.get') operator. The trampoline must inline the
// array op like direct call sites do, not trap.
// (Writes through MutableSequence are not covered here: lowering an
// index *write* through an interface is a separate unsupported path,
// "interface index write".)

import { Sequence } from 'zena:sequence';

class Node {
  value: i32;
  new(this.value);
}

let sumVia = (parts: Sequence<Node>): i32 => {
  var sum = 0;
  var i = parts.length - 1;
  while (i >= 0) {
    sum += parts[i].value;
    i -= 1;
  }
  return sum;
};

export let main = (): i32 => {
  let nodes = [new Node(30), new Node(12)];
  return sumVia(nodes);
};
