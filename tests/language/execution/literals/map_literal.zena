// @mode: run
// @result: true

import { HashMap } from 'zena:map';

export let main = (): boolean => {
  let m = {"a" => 1, "b" => 2};
  
  if (m.size != 2) return false;
  if (!m.has("a")) return false;
  if (!m.has("b")) return false;
  if (m.has("c")) return false;
  
  if (m["a"] != 1) return false;
  if (m["b"] != 2) return false;
  
  // Test with non-constant expressions as keys and values
  let k1 = "x";
  let v1 = 10;
  let m2 = {k1 => v1 + 5, "y" => v1 * 2};
  
  if (m2.size != 2) return false;
  if (m2[k1] != 15) return false;
  if (m2["y"] != 20) return false;
  
  return true;
};
