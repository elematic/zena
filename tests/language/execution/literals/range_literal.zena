// @mode: run
// @result: true

import { BoundedRange, FromRange, ToRange, FullRange } from 'zena:range';

export let main = (): boolean => {
  // Test basic BoundedRange
  let r1 = 1..10;
  if (!(r1 is BoundedRange)) { return false; }
  if (r1.start != 1 || r1.end != 10) { return false; }

  // Test dynamic BoundedRange
  let x = 5;
  let y = 15;
  let r2 = x..y;
  if (!(r2 is BoundedRange)) { return false; }
  if (r2.start != 5 || r2.end != 15) { return false; }

  // Test BoundedRange with expression bounds
  let r2_expr = (x + 1)..(y * 2);
  if (!(r2_expr is BoundedRange)) { return false; }
  if (r2_expr.start != 6 || r2_expr.end != 30) { return false; }

  // Test FromRange
  let r3 = 20..;
  if (!(r3 is FromRange)) { return false; }
  if (r3.start != 20) { return false; }

  // Test dynamic FromRange
  let r3_dyn = x..;
  if (!(r3_dyn is FromRange)) { return false; }
  if (r3_dyn.start != 5) { return false; }

  // Test ToRange
  let r4 = ..25;
  if (!(r4 is ToRange)) { return false; }
  if (r4.end != 25) { return false; }

  // Test dynamic ToRange
  let r4_dyn = ..y;
  if (!(r4_dyn is ToRange)) { return false; }
  if (r4_dyn.end != 15) { return false; }

  // Test FullRange
  let r5 = ..;
  if (!(r5 is FullRange)) { return false; }

  return true;
};
