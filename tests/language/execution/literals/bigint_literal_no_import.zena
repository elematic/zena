// @mode: run
// @result: 1

// Verifies that `n`-suffixed literals imply `BigInt` from `zena:bigint`
// without an explicit import in the source file.
let TOP = 100_000_000_000_000_000_000_000n;

export function main(): i32 {
  let a = TOP + 42;
  let b = match (a - TOP) {
    case 42n: 1
    case _: 0
  };
  return b;
}
