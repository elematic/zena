// @mode: run
// @result: 15

import { HashMap } from 'zena:collections';

interface Value {
  get(): i32;
}

class NumberValue implements Value {
  v: i32;
  new(this.v);
  get(): i32 { return this.v; }
}

export function main(): i32 {
  // Map literal with interface-adapted values
  let m: HashMap<String, Value> = {
    "first" => new NumberValue(5),
    "second" => new NumberValue(10)
  };

  if (m.size != 2) {
    return -2;
  }

  let first = m["first"];
  let second = m["second"];
  return first.get() + second.get();
}
