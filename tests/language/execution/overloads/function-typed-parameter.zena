// @mode: run
// @result: 4321

// Overloads whose parameters differ only in a function type are
// distinct overloads: each call runs the body it selected, whichever
// was declared first.

import { Future } from 'zena:async';

function measure(fn: (x: i32) => i32): i32 {
  return fn(1);
}

function measure(fn: (x: i32) => String): i32 {
  return fn(1).length;
}

function visit(fn: (x: i32) => void): i32 {
  fn(1);
  return 30;
}

async function visit(fn: (x: i32) => Future<void>): Future<i32> {
  await fn(1);
  return 300;
}

class Counter {
  count(fn: () => i32): i32 { return 1000; }
  count(fn: (x: i32) => i32): i32 { return 4000; }
}

var seen = 0;

export async function main(): Future<i32> {
  let first = measure((x) => x);
  let second = measure((x) => 'ab');
  if (first != 1 || second != 2) {
    return 0 - 1;
  }
  let synchronous = visit((x) => {
    seen = seen + x;
  });
  let asynchronous = await visit(async (x) => {
    seen = seen + x;
  });
  if (seen != 2 || synchronous != 30) {
    return 0 - 2;
  }
  let counter = new Counter();
  if (counter.count(() => 1) != 1000) {
    return 0 - 3;
  }
  return counter.count((x: i32) => x) + asynchronous + 20 + first;
}
