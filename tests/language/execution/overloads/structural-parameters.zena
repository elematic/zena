// @mode: run
// @result: 121212

// Overloads whose parameters differ only in a record, a tuple or a
// union are distinct overloads: each call runs the body it selected.

class A { v: i32 = 1; }
class B { v: i32 = 2; }

function record(a: {x: i32}): i32 { return 1; }
function record(a: {y: String}): i32 { return 2; }

function tuple(a: (i32, i32)): i32 { return 1; }
function tuple(a: (String, String)): i32 { return 2; }

function union(a: A | null): i32 { return 1; }
function union(a: B | null): i32 { return 2; }

export function main(): i32 {
  let p: {x: i32} = {x: 1};
  let q: {y: String} = {y: 'a'};
  let a: A | null = new A();
  let b: B | null = new B();
  let records = record(p) * 10 + record(q);
  let tuples = tuple((1, 2)) * 10 + tuple(('a', 'b'));
  let unions = union(a) * 10 + union(b);
  return records * 10000 + tuples * 100 + unions;
}
