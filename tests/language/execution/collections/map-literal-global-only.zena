// @mode: run
// @result: 42
// A module-level map literal must register its HashMap specialization's
// constructor and []= with reachability even when the program contains no
// `new HashMap(...)` anywhere — the literal IS the instantiation. This was
// the self-hosted 'map constructor missing @__start' bail: the tokenizer's
// KEYWORDS global reached from an external entry point.

import { Map } from 'zena:map';

let TABLE: Map<String, i32> = {
  'answer' => 40,
  'offset' => 2,
};

export let main = (): i32 => {
  return TABLE['answer'] + TABLE['offset'];
};
