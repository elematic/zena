// @mode: run
// @result: 2468
import { FixedArray } from 'zena:fixed-array';
import { GrowableArray } from 'zena:growable-array';

export let main = (): i32 => {
  let arr = [1, 2, 3, 4, 5, 6, 7, 8];
  let evens = arr.filter((x: i32) => x % 2 == 0);
  
  var acc = 0;
  for (let x in evens) {
    acc = acc * 10 + x;
  }
  return acc;
};

