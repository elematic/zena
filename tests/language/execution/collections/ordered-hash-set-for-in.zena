// @mode: run
// @result: 321
// for-in over OrderedHashSet resolves its element type through
// `OrderedHashSet implements Set<T>` where `Set<T> extends Iterable<T>`,
// and the values come back in insertion order. Re-adding a value that is
// already present must not move it.
import {OrderedHashSet} from 'zena:collections';

export let main = (): i32 => {
  let s = new OrderedHashSet<i32>();
  s.add(3);
  s.add(2);
  s.add(1);
  s.add(3);
  var digits = 0;
  for (let v in s) {
    digits = digits * 10 + v;
  }
  // Insertion order: 3, 2, 1.
  return digits;
};
