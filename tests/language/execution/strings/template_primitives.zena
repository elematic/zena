// @mode: run
// @stdout: 42, -123, true, false
// Asserted through stdout because a returned String is a GC reference,
// which `--invoke` cannot render.
import { console } from 'zena:console';

export let main = (): void => {
  let a: i32 = 42;
  let b: i32 = -123;
  let c: boolean = true;
  let d: boolean = false;
  console.log(`${a}, ${b}, ${c}, ${d}`);
};
