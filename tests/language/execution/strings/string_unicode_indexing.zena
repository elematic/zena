// @mode: run
// @stdout: café\n😀\n!👋🏽éfac\n4\n9\ntrue

export let main = () => {
  let s = "café😀";
  let i4 = if (let (true, idx) = s.indexOffsetBy(s.startIndex, 4)) idx else s.startIndex;
  console.log(s[..i4]);
  console.log(s[i4..]);

  let acute = String.fromCodePoint(0x0301);
  let complex = "cafe" + acute + "👋🏽!";
  console.log(complex.reverse());
  console.log(`${"e\r\na👨‍👩‍👧".graphemes.count()}`);
  console.log(`${"e\r\na👨‍👩‍👧".codePoints.count()}`);
  console.log(
    if ("hé".utf8[0] == (0x68 as u8) && "hé".utf8.length == 3 && "😀".utf16.length == 2 && "😀".utf16[0] == (0xD83D as u16))
      "true"
    else
      "false"
  );
};

