// @mode: run
// @stdout: ab\ntrue\nfalse\ntrue\ntrue\ntrue
import { console } from 'zena:console';

let btos = (b: boolean): String => if (b) "true" else "false";

export let main = () => {
  let a = "a";
  let b = "b";
  console.log(a + b);
  console.log(btos(a == "a"));
  console.log(btos(a == b));
  console.log(btos(a != b));
  console.log(btos(a === a));
  console.log(btos(a !== b));
};
