// @mode: run
// @result: 7

// A tagged template's segment with an escape in it: the tag sees the
// cooked text (the escape resolved, three bytes) through the array and
// the raw text (the backslash kept, four bytes) through `raw`. The raw
// strings are literals of their own, and a segment whose raw text
// differs from its cooked text once failed to compile at all.
import { TemplateStringsArray } from 'zena:core';

let both = (strings: TemplateStringsArray, values: FixedArray<i32>): i32 => {
  return strings.raw[0].length + strings[0].length;
};

export let main = (): i32 => {
  return both`a\`b`;
};
