// @mode: run
// @stdout: The point is Point(3, 4)\nvia iface: Point(3, 4)\nsubclass: Point3D(1, 2, 3)\nfallback: <Plain> <record> <tuple> null Point(3, 4)

class Point implements Stringable {
  x: i32;
  y: i32;
  new(this.x, this.y);
  [Stringable.toString](): String {
    return `Point(${this.x}, ${this.y})`;
  }
}

class Point3D extends Point {
  z: i32;
  new(x: i32, y: i32, this.z) : super(x, y);
  [Stringable.toString](): String {
    return `Point3D(${this.x}, ${this.y}, ${this.z})`;
  }
}

class Plain {
  toString(): String {
    return "ignored";
  }
}

export function main(): void {
  let p = new Point(3, 4);
  console.log(`The point is ${p}`);
  let s: Stringable = p;
  console.log(`via iface: ${s}`);
  let p3: Point = new Point3D(1, 2, 3);
  console.log(`subclass: ${p3}`);
  let maybeNull: Point | null = null;
  let maybePoint: Point | null = p;
  console.log(`fallback: ${new Plain()} ${{x: 1}} ${(1, 2)} ${maybeNull} ${toString(maybePoint)}`);
}
