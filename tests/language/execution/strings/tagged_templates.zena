// @mode: run
// @stdout: 1\n2\n4\n2\n42\n30\n1
import { console } from 'zena:console';
import { TemplateStringsArray } from 'zena:template-strings-array';

let tagLength = (strings: TemplateStringsArray, values: FixedArray<i32>): i32 => {
  return strings.length;
};

let tagValuesLength = (strings: TemplateStringsArray, values: FixedArray<i32>): i32 => {
  return values.length;
};

let tagFirstValue = (strings: TemplateStringsArray, values: FixedArray<i32>): i32 => {
  return values[0];
};

let tagSumValues = (strings: TemplateStringsArray, values: FixedArray<i32>): i32 => {
  return values[0] + values[1];
};

let captureStrings = (strings: TemplateStringsArray, values: FixedArray<i32>): TemplateStringsArray => {
  return strings;
};

let go = (): TemplateStringsArray => {
  return captureStrings`hello`;
};

export let main = () => {
  // 1. Tag length with no substitutions
  console.log(`${tagLength`hello world`}`);

  // 2. Tag length with single substitution
  let x = 42;
  console.log(`${tagLength`value is ${x}`}`);

  // 3. Tag length with multiple substitutions
  let a = 1;
  let b = 2;
  let c = 3;
  console.log(`${tagLength`${a} + ${b} = ${c}`}`);

  // 4. Tag values length
  console.log(`${tagValuesLength`${a} + ${b}`}`);

  // 5. First value
  console.log(`${tagFirstValue`value: ${x}`}`);

  // 6. Sum values
  let val1 = 10;
  let val2 = 20;
  console.log(`${tagSumValues`${val1} plus ${val2}`}`);

  // 7. Identity check
  let first = go();
  let second = go();
  if (first == second) {
    console.log("1");
  } else {
    console.log("0");
  }
};
