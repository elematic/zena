// @mode: run
// @stdlib: true
// @stdout: ab-cd

import { FixedArray } from 'zena:fixed-array';

// String.fromParts is generic over the array representation: an
// ImmutableArray (the literal default) and a FixedArray each get their
// own specialization reading the receiver directly.
export let main = (): void => {
  let imm = ["a", "b"];
  let fixed: FixedArray<String> = ["c", "d"];
  let joined = String.fromParts(imm) + "-" + String.fromParts(fixed);
  console.log(joined);
};
