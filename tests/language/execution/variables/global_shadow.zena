// @mode: run
// @invoke: main
// @result: 42

var value: i32 = 10;

export let testShadow = (): i32 => {
  var value: i32 = 20;
  value = 42;
  return value;
};

export let main = (): i32 => {
  let res = testShadow();
  // Simulate if (value != 10) return 999;
  return res + ((value - 10) * 100);
};
