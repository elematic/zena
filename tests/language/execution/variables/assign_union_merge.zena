// @mode: run
// @result: 10

// Assigning an if-expression whose arms produce different subclasses:
// the expression's merged value is wider than the binding's declared
// type, and the store must conform to the binding.

class Base3 {
  v: i32;
  new(this.v);
}

class Left3 extends Base3 {
  new(v: i32) : super(v);
}

class Right3 extends Base3 {
  new(v: i32) : super(v);
}

export let main = (): i32 => {
  var x: Base3 = new Base3(0);
  var total = 0;
  var i = 0;
  while (i < 2) {
    x = if (i == 0) new Left3(3) else new Right3(7);
    total += x.v;
    i += 1;
  }
  return total;
};
