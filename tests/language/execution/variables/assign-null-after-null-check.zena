// @mode: run
// @invoke: main
// @result: 7
// @skip: assigning null to a module-level var after a null check in the same function fails to lower ("zir unsupported: null without context"): the check narrows the variable, and the assignment's target is read at the narrowed type rather than the declared one

// Found while testing `externref | null`; the type does not matter.
class Token {
  new();
}

var slot: Token | null = null;

export let main = (): i32 => {
  slot = new Token();
  if (slot == null) {
    return 2;
  }
  slot = null;
  return if (slot == null) 7 else 3;
};
