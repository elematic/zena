// @mode: run
// @result: 5
var globalVar = 0;

export let main = (): i32 => {
  var a = 0;
  var b = 0;

  // Local chained assignment. Without local.tee or drop, 
  // 'b = 5' returns nothing to the outer 'a =' assignment, blowing up Wasm validation!
  a = b = 5;

  // Global chained assignment. Tests global.get/set interaction.
  var c = 0;
  c = globalVar = 10;

  if (a != 5) { return 1; }
  if (b != 5) { return 2; }
  if (c != 10) { return 3; }
  if (globalVar != 10) { return 4; }

  return 5;
};