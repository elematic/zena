// @mode: run
// @result: 100
// @invoke: main

class Point {
  var x: i32;
  y: i32;
  new(x: i32, y: i32) : x = x, y = y {}
}

class Rect {
  p1: Point;
  p2: Point;
  new(p1: Point, p2: Point) : p1 = p1, p2 = p2 {}
}

export let main = (): i32 => {
  // 1. Basic record destructuring
  let p = { x: 10, y: 20 };
  let { x, y } = p;
  let res1 = x + y; // 30

  // 2. Record renaming
  let { x as a, y as b } = p;
  let res2 = a + b; // 30

  // 3. Nested record destructuring
  let r = { p1: { x: 1, y: 2 }, p2: { x: 3, y: 4 } };
  let { p1: { x: rx1 }, p2: { y: ry2 } } = r;
  let res3 = rx1 + ry2; // 1 + 4 = 5

  // 4. Basic tuple destructuring
  let t = (10, 20);
  let (ta, tb) = t;
  let res4 = ta + tb; // 30

  // 5. Tuple destructuring with skipping
  let t3 = (10, 20, 30);
  let (t3a, , t3c) = t3;
  let res5 = t3a + t3c; // 40

  // 6. Class instance destructuring
  let cp = new Point(10, 20);
  let { x: cpx, y: cpy } = cp;
  let res6 = cpx + cpy; // 30

  // 7. Nested class instance destructuring
  let cr = new Rect(new Point(1, 2), new Point(3, 4));
  let { p1: { x: crx1 }, p2: { y: cry2 } } = cr;
  let res7 = crx1 + cry2; // 1 + 4 = 5

  if (res1 == 30 && res2 == 30 && res3 == 5 && res4 == 30 && res5 == 40 && res6 == 30 && res7 == 5) {
    return 100;
  }
  return 0;
};
