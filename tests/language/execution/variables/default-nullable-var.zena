// @mode: run
// @result: 42

class Box(value: i32)

var globalBox: Box?;

export let main = (): i32 => {
  if (globalBox != null) {
    return 1;
  }
  globalBox = new Box(20);

  var localText: String?;
  if (localText != null) {
    return 2;
  }
  localText = "hello";

  let b = globalBox;
  let t = localText;
  if (b != null && t != null && t == "hello") {
    return b.value + 22;
  }
  return 0;
};
