// @mode: run
// @result: 33
// @invoke: main

// A destructuring default never applies to a record field — record
// fields are always present — but the pattern must still compile and
// bind the field value.
export let main = (): i32 => {
  let {x = 100, y} = {x: 10, y: 20};

  // Nested pattern with a default on the inner field.
  let {p: {z = 100}} = {p: {z: 3}};

  return x + y + z; // 10 + 20 + 3
};
