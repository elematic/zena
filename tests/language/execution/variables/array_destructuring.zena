// @mode: run
// @result: 100
// @invoke: main

import { GrowableArray } from 'zena:growable-array';

export let main = (): i32 => {
  // 1. Basic array destructuring
  let [a, b] = [10, 20];
  let res1 = a + b; // 30

  // 2. Array destructuring with hole/skipping
  let [x, , z] = [10, 20, 30];
  let res2 = x + z; // 40

  // 3. Array destructuring with rest pattern
  let [head, ...tail] = [1, 2, 3, 4];
  let res3 = head + tail.length + tail[0] + tail[1] + tail[2]; // 1 + 3 + 2 + 3 + 4 = 13

  // 4. Full rest pattern
  let [...all] = [5, 6, 7];
  let res4 = all.length + all[0] + all[1] + all[2]; // 3 + 5 + 6 + 7 = 21

  // 5. Rest pattern with empty rest
  let [r0, r1, ...rem] = [100, 200];
  let res5 = r0 + r1 + rem.length; // 100 + 200 + 0 = 300

  // 6. Nested array destructuring
  let [[n0, n1], [n2, n3]] = [[1, 2], [3, 4]];
  let res6 = n0 + n1 + n2 + n3; // 10

  // 7. Destructuring a GrowableArray
  let ga = new GrowableArray<i32>();
  ga.push(50);
  ga.push(60);
  let [ga0, ga1] = ga;
  let res7 = ga0 + ga1; // 110

  if (res1 == 30 && res2 == 40 && res3 == 13 && res4 == 21 && res5 == 300 && res6 == 10 && res7 == 110) {
    return 100;
  }
  return 0;
};
