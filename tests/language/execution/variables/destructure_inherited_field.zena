// @mode: run
// @result: 42
// Object-pattern destructuring reads fields declared on a superclass
// through a subclass value.

class Base {
  x: i32;
  new(this.x);
}

class Sub extends Base {
  y: i32;
  new(this.y) : super(30);
}

export let main = (): i32 => {
  let { x, y } = new Sub(12);
  return x + y;
};
