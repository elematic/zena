// @mode: run
// @result: 42

// Inside `shielded`, checkpoints do not deliver: a frame parked inside
// the region resumes and runs even though its scope was cancelled
// while it waited. At the closing brace level-triggering resumes, and
// the next checkpoint — entering the following await — raises.

import {
  Future, Completer, CancelScope, drainMicrotasks,
} from 'zena:async';

var trace = '';
var fut: Future<i32> | null = null;

let work = async (bye: Future<i32>, never: Future<i32>): Future<i32> => {
  trace += 'a';
  shielded {
    trace += 's';
    let b = await bye;
    trace += 'g';
  }
  let v = await never;
  trace += 'X';
  return v;
};


/** With `state` gone, an outcome is observed by awaiting: the cancel
 * clause records the third settlement (and the probe's own frame then
 * completes cancelled, which is fine — the record survives). */
var probeLog = '';
let probeOutcome = async (pf: Future<i32>): Future<void> => {
  try {
    let v = await pf;
    probeLog = probeLog + 'v';
  } cancel {
    probeLog = probeLog + 'C';
  } catch (e) {
    probeLog = probeLog + 'e';
  }
};

export function main(): i32 {
  let bye = new Completer<i32>();
  let never = new Completer<i32>();
  let scope = new CancelScope();
  scope.run(() => {
    fut = work(bye.future, never.future);
  });
  trace += '1';
  scope.cancel();
  bye.complete(5);
  drainMicrotasks();
  if (trace != 'as1g') {
    return 2;
  }
  let f = fut;
  if (f == null) {
    return 3;
  }
  probeOutcome(f as Future<i32>);
  drainMicrotasks();
  if (probeLog != 'C') {
    return 4;
  }
  return 42;
}
