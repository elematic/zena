// @mode: run
// @result: 42

// Sync scope semantics: `spawn` installs the group's scope around the
// body's synchronous start and restores the previous scope after; a
// group created inside a spawned body is a child of the enclosing
// group and is marked when it cancels; the flag is level-triggered
// (it stays set); and the root scope, which belongs to no group, is
// never marked.

import { TaskGroup, CancelScope, currentScope, Future } from 'zena:async';

export function main(): i32 {
  let root = currentScope();
  let parent = new TaskGroup();
  var inner: CancelScope | null = null;
  var child: TaskGroup | null = null;
  var sawGroupScope = false;
  parent.spawn(() => {
    inner = currentScope();
    sawGroupScope = !(currentScope() === root);
    child = new TaskGroup();
    return Future.of(0);
  });
  if (!sawGroupScope) {
    return 2;
  }
  if (!(currentScope() === root)) {
    return 3;
  }
  let s = inner;
  if (s == null) {
    return 4;
  }
  let c = child;
  if (c == null) {
    return 5;
  }
  if ((s as CancelScope).isCancelled) {
    return 6;
  }
  parent.cancel();
  if (!parent.isCancelled) {
    return 7;
  }
  if (!(s as CancelScope).isCancelled) {
    return 8;
  }
  if (!(c as TaskGroup).isCancelled) {
    return 9;
  }
  parent.cancel();
  if (!parent.isCancelled) {
    return 10;
  }
  if (root.isCancelled) {
    return 11;
  }
  return 42;
}
