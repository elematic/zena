// @mode: run
// @result: 42

// A cancellation raises on its own tag (docs/design/cancellation.md):
// `catch (e)` cannot observe it, `finally` still runs its cleanup, and
// the unwind then continues. A finalizer that leaves on its own
// discards the pending exit — the language's existing rule, and the
// one legitimate way for this test to survive the unwind.
//
// The raise comes from checkCancellation() in sync code running as
// the synchronous start of a member of an already-cancelled group:
// the start runs even in a cancelled scope, and the check is the
// first place that observes the cancellation.

import { TaskGroup, Future, checkCancellation } from 'zena:async';

var trace = '';

let observe = (): i32 => {
  try {
    try {
      trace += 'a';
      checkCancellation();
      trace += 'X';
    } catch (e) {
      trace += 'C';
    } finally {
      trace += 'f';
    }
    trace += 'Y';
    return 9;
  } finally {
    return 7;
  }
};

export function main(): i32 {
  let group = new TaskGroup();
  group.cancel();
  var got = 0;
  group.spawn(() => {
    got = observe();
    return Future.of(0);
  });
  if (got != 7) {
    return 1;
  }
  if (trace != 'af') {
    return 2;
  }
  return 42;
}
