// @mode: run
// @result: 42

// The `cancel` clause runs on a cancellation unwind and the unwind
// then continues: the cancel block first, then the finalizer, and the
// frame still completes as cancelled — the clause observed, it did not
// suppress. `catch (e)` sees failures only and stays silent here.

import {
  Future, Completer, CancelScope, drainMicrotasks,
} from 'zena:async';

var trace = '';
var fut: Future<i32> | null = null;

let work = async (gate: Future<i32>): Future<i32> => {
  try {
    trace += 'a';
    let v = await gate;
    trace += 'X';
    return v;
  } cancel {
    trace += 'c';
  } catch (e) {
    trace += 'E';
  } finally {
    trace += 'f';
  }
  return 0;
};


/** With `state` gone, an outcome is observed by awaiting: the cancel
 * clause records the third settlement (and the probe's own frame then
 * completes cancelled, which is fine — the record survives). */
var probeLog = '';
let probeOutcome = async (pf: Future<i32>): Future<void> => {
  try {
    let v = await pf;
    probeLog = probeLog + 'v';
  } cancel {
    probeLog = probeLog + 'C';
  } catch (e) {
    probeLog = probeLog + 'e';
  }
};

export function main(): i32 {
  let c = new Completer<i32>();
  let scope = new CancelScope();
  scope.run(() => {
    fut = work(c.future);
  });
  scope.cancel();
  c.complete(9);
  drainMicrotasks();
  if (trace != 'acf') {
    return 2;
  }
  let f = fut;
  if (f == null) {
    return 3;
  }
  probeOutcome(f as Future<i32>);
  drainMicrotasks();
  if (probeLog != 'C') {
    return 4;
  }
  return 42;
}
