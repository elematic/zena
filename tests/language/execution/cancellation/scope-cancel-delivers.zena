// @mode: run
// @result: 42

// Cancelling a scope delivers at the parked frame's next checkpoint:
// the awaited future completes NORMALLY, but the resume tests the
// frame's scope first and raises — the finalizer runs, the value is
// never read, and the frame's future completes as cancelled. The
// scope that cancelled observes all of it as data.

import {
  Future, Completer, CancelScope, drainMicrotasks,
} from 'zena:async';

var trace = '';
var parked: Future<i32> | null = null;

let work = async (gate: Future<i32>): Future<i32> => {
  try {
    trace += 'a';
    let v = await gate;
    trace += 'X';
    return v;
  } finally {
    trace += 'f';
  }
};


/** With `state` gone, an outcome is observed by awaiting: the cancel
 * clause records the third settlement (and the probe's own frame then
 * completes cancelled, which is fine — the record survives). */
var probeLog = '';
let probeOutcome = async (pf: Future<i32>): Future<void> => {
  try {
    let v = await pf;
    probeLog = probeLog + 'v';
  } cancel {
    probeLog = probeLog + 'C';
  } catch (e) {
    probeLog = probeLog + 'e';
  }
};

export function main(): i32 {
  let c = new Completer<i32>();
  let scope = new CancelScope();
  scope.run(() => {
    parked = work(c.future);
  });
  trace += '1';
  scope.cancel();
  c.complete(9);
  drainMicrotasks();
  if (trace != 'a1f') {
    return 2;
  }
  let f = parked;
  if (f == null) {
    return 3;
  }
  probeOutcome(f as Future<i32>);
  drainMicrotasks();
  if (probeLog != 'C') {
    return 4;
  }
  return 42;
}
