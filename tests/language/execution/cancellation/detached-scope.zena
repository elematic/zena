// @mode: run
// @result: 42

// A group created with TaskGroup.detached() has no parent scope
// wherever it is created: cancelling the group that was current at
// its construction does not reach its members, while its holder still
// can cancel them. This is the group for work that must outlive its
// callers — a cache's shared fills, for example.

import {
  Future, Completer, TaskGroup, drainMicrotasks, runFuture,
} from 'zena:async';

var trace = '';
var fut: Future<i32> | null = null;
var held: TaskGroup | null = null;

let work = async (gate: Future<i32>): Future<i32> => {
  trace += 'a';
  let v = await gate;
  trace += 'b';
  return v;
};

export function main(): i32 {
  let outer = new TaskGroup();
  let g = new Completer<i32>();
  outer.spawn(() => {
    let detached = TaskGroup.detached();
    held = detached;
    fut = detached.spawn(() => work(g.future));
    return Future.of(0);
  });
  outer.cancel();
  g.complete(21);
  drainMicrotasks();
  let f = fut;
  if (f == null) {
    return 2;
  }
  if (runFuture(f as Future<i32>) != 21) {
    return 3;
  }
  if (trace != 'ab') {
    return 4;
  }
  let c = held;
  if (c == null) {
    return 5;
  }
  (c as TaskGroup).cancel();
  if (!(c as TaskGroup).isCancelled) {
    return 6;
  }
  return 42;
}
