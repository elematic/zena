// @mode: run
// @result: 42

// The unwind continues across frames without a shared stack: a
// cancelled frame's awaiters raise at their own resumes. The outer
// frame here is outside the cancelled group: its own scope is never
// cancelled, and it raises because the work it awaits completed as
// cancelled. Its own finalizer runs before its future completes as
// cancelled in turn.

import {
  Future, Completer, TaskGroup, drainMicrotasks,
} from 'zena:async';

var trace = '';
var innerFut: Future<i32> | null = null;

let inner = async (gate: Future<i32>): Future<i32> => {
  trace += 'i';
  let v = await gate;
  trace += 'X';
  return v;
};

let outer = async (of: Future<i32>): Future<i32> => {
  try {
    trace += 'o';
    let v = await of;
    trace += 'Y';
    return v;
  } finally {
    trace += 'f';
  }
};


/** With `state` gone, an outcome is observed by awaiting: the cancel
 * clause records the third settlement (and the probe's own frame then
 * completes cancelled, which is fine — the record survives). */
var probeLog = '';
let probeOutcome = async (pf: Future<i32>): Future<void> => {
  try {
    let v = await pf;
    probeLog = probeLog + 'v';
  } cancel {
    probeLog = probeLog + 'C';
  } catch (e) {
    probeLog = probeLog + 'e';
  }
};

export function main(): i32 {
  let c = new Completer<i32>();
  let group = new TaskGroup();
  innerFut = group.spawn(() => inner(c.future));
  let if_ = innerFut;
  if (if_ == null) {
    return 3;
  }
  let outerFut = outer(if_ as Future<i32>);
  trace += '1';
  group.cancel();
  c.complete(9);
  drainMicrotasks();
  if (trace != 'io1f') {
    return 2;
  }
  probeOutcome(if_ as Future<i32>);
  probeOutcome(outerFut);
  drainMicrotasks();
  if (probeLog != 'CC') {
    return 4;
  }
  return 42;
}
