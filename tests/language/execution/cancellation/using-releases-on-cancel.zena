// @mode: run
// @result: 42

// `using` releases on a cancellation unwind exactly as it does on an
// exception unwind, in reverse declaration order, and the unwind then
// continues past the block. The raise comes from checkCancellation()
// inside the synchronous start of a member of a cancelled group.

import { TaskGroup, Future, checkCancellation } from 'zena:async';
import { Disposable } from 'zena:core';

var trace = '';

class Guard implements Disposable {
  #name: String;
  new(name: String) : #name = name;
  [Disposable.dispose](): void { trace += this.#name; }
}

let work = (): void => {
  using a = new Guard('a');
  using b = new Guard('b');
  trace += 'r';
  checkCancellation();
  trace += 'X';
};

let run = (): i32 => {
  try {
    work();
    return 9;
  } finally {
    return 5;
  }
};

export function main(): i32 {
  let group = new TaskGroup();
  group.cancel();
  var got = 0;
  group.spawn(() => {
    got = run();
    return Future.of(0);
  });
  if (got != 5) {
    return 1;
  }
  if (trace != 'rba') {
    return 2;
  }
  return 42;
}
