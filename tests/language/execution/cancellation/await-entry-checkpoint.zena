// @mode: run
// @result: 42

// Eager start is unchanged: a call in a just-cancelled scope still
// runs its ramp segment — code between suspensions is never
// interrupted. Delivery happens at the first checkpoint, which is
// ENTERING the await: the frame never parks, the finalizer runs, and
// the future comes back already cancelled, all synchronously inside
// the ramp.

import {
  Future, Completer, CancelScope, drainMicrotasks,
} from 'zena:async';

var trace = '';
var fut: Future<i32> | null = null;

let work = async (gate: Future<i32>): Future<i32> => {
  try {
    trace += 'ramp';
    let v = await gate;
    trace += 'X';
    return v;
  } finally {
    trace += 'f';
  }
};


/** With `state` gone, an outcome is observed by awaiting: the cancel
 * clause records the third settlement (and the probe's own frame then
 * completes cancelled, which is fine — the record survives). */
var probeLog = '';
let probeOutcome = async (pf: Future<i32>): Future<void> => {
  try {
    let v = await pf;
    probeLog = probeLog + 'v';
  } cancel {
    probeLog = probeLog + 'C';
  } catch (e) {
    probeLog = probeLog + 'e';
  }
};

export function main(): i32 {
  let c = new Completer<i32>();
  let scope = new CancelScope();
  scope.cancel();
  scope.run(() => {
    fut = work(c.future);
  });
  if (trace != 'rampf') {
    return 2;
  }
  let f = fut;
  if (f == null) {
    return 3;
  }
  probeOutcome(f as Future<i32>);
  drainMicrotasks();
  if (probeLog != 'C') {
    return 4;
  }
  return 42;
}
