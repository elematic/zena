// @mode: run
// @result: 100
// @invoke: main

import { GrowableArray } from 'zena:growable-array';

export let main = (): i32 => {
  let pairs = new GrowableArray<Array<i32>>();
  let p1: Array<i32> = [10, 20];
  let p2: Array<i32> = [30, 40];
  pairs.push(p1);
  pairs.push(p2);

  var total = 0;
  for (let [x, y] in pairs) {
    total += x + y;
  }

  return total; // 10 + 20 + 30 + 40 = 100
};
