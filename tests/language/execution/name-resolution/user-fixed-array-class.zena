// @mode: run
// @result: 6
//
// A `for`-in over a program's own class called `FixedArray` drives the
// iteration protocol like any other class: the index loop is for the
// standard library's arrays, by identity (issue #288).

class Counter implements Iterator<i32> {
  var n: i32 = 0;
  limit: i32;
  new(this.limit);
  next(): Step<i32> {
    if (this.n < this.limit) {
      this.n += 1;
      return (1, this.n, _);
    }
    return (0, _, _);
  }
}

class FixedArray<T> implements Iterable<i32> {
  limit: i32;
  new(this.limit);
  [Iterable.iterator](): Iterator<i32> {
    return new Counter(this.limit);
  }

  contains(value: i32): boolean { return false; }
  all(predicate: (item: i32) => boolean): boolean { return false; }
  some(predicate: (item: i32) => boolean): boolean { return false; }
  fold<R>(initial: R, combine: (acc: R, item: i32) => R): R { return initial; }
  find(predicate: (item: i32) => boolean): inline (true, i32) | inline (false, _) { return (false, _); }
  filter(predicate: (item: i32) => boolean): Iterable<i32> { return this; }
}

export function main(): i32 {
  var sum = 0;
  for (let i in new FixedArray<i32>(3)) {
    sum += i;
  }
  return sum;
}
