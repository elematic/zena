// @mode: run
// @result: 3
//
// A range literal is the standard library's range class, whatever a
// `BoundedRange` or `StringIndex` in scope is (issue #288).

class BoundedRange<T> {
  bogus(): i32 {
    return 100;
  }
}

type StringIndex = i32;

export function main(): i32 {
  let own = new BoundedRange<i32>();
  var sum = 0;
  for (let i in 0..3) {
    sum += i;
  }
  return sum + own.bogus() - 100;
}
