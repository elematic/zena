// @mode: run
// @result: 103
//
// `Config.size` on an imported value is a member read, whichever other
// module exports a type called `Config`: whether an imported name is a
// type is the import's own target's answer (issue #288).

import { Config } from './config_value_helper.zena';
import { Config as ConfigClass } from './config_class_helper.zena';

export function main(): i32 {
  return Config.size + ConfigClass.size;
}
