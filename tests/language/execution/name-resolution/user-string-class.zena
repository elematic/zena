// @mode: run
// @result: 7
//
// A program's own `String` shadows the prelude's for the names it
// writes, and nothing else: a template literal is the standard
// library's `String` whatever the name resolves to here (issue #288).

class String {
  bogus(): i32 {
    return 100;
  }
}

export function main(): i32 {
  let own = new String();
  let n = 3;
  let text = `n is ${n}`;
  // 6 (the literal has the standard library's `length`) + 1 + 100 - 100
  return text.length + 1 + own.bogus() - 100;
}
