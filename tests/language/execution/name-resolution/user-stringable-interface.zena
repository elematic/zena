// @mode: run
// @result: 5
//
// A class implementing an interface that happens to be called
// `Stringable`, and the standard library's, converts to a string
// through the standard library's: the conversion finds it by identity,
// not by the name of the first interface it meets (issue #288).

import { Stringable as Labeled } from './user_iterator_helper.zena';

class Point implements Labeled, Stringable {
  label(): i32 { return 1; }
  [Stringable.toString](): String {
    return 'point';
  }
}

export function main(): i32 {
  let p = new Point();
  let text = `${p}`;
  return text.length;
}
