// @mode: run
// @result: 2
//
// A map literal builds the standard library's `HashMap`, whatever a
// `HashMap` in scope is (issue #288).

class HashMap<K, V> {
  bogus(): i32 {
    return 100;
  }
}

export function main(): i32 {
  let own = new HashMap<i32, i32>();
  let m = {1 => 10, 2 => 20};
  return m.size + own.bogus() - 100;
}
