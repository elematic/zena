// @mode: run
// @result: 1
// `Range.bounds(length)` gives each range form's start and end in a
// sequence of `length` elements.
let span = (r: Range, length: i32): i32 => {
  let (start, end) = r.bounds(length);
  return start * 100 + end;
};

export let main = (): i32 => {
  return if (span(2..5, 10) == 205 &&
      span(3.., 10) == 310 &&
      span(..4, 10) == 4 &&
      span(.., 10) == 10) 1 else 0;
};
