// @mode: run
// @stdout: 42\n3.14\ntrue\nhello\nPoint(1, 2)\n<Widget>\n<record>\n<tuple>\nnull

class Point implements Stringable {
  x: i32;
  y: i32;
  new(this.x, this.y);
  [Stringable.toString](): String {
    return `Point(${this.x}, ${this.y})`;
  }
}

class Widget {
  id: i32;
  new(this.id);
}

export function main(): void {
  console.log(42);
  console.log(3.14);
  console.log(true);
  console.log("hello");
  console.log(new Point(1, 2));
  console.log(new Widget(7));
  console.log({a: 1, b: 2});
  console.log((10, 20));
  console.log(null);
}
