// @mode: run
// @result: 92

// A static that carries its OWN type parameters, on a plain class.
class Utils {
  new();
  static identity<A>(a: A): A { return a; }
  static pick<A>(a: A, _b: A): A { return a; }
}

// A static on a GENERIC class. It is outside the class's generic scope,
// so the class name alone finds it — there is nothing to bind.
class Holder<T> {
  value: T;
  new(this.value);
  static answer(): i32 { return 42; }
  static describe(): String { return 'holder'; }
}

// A static that needs a type parameter declares its own. Its arguments
// solve it, exactly as a generic function's do.
class Boxed<T> {
  item: T;
  new(this.item);
  static of<A>(v: A): Boxed<A> { return new Boxed<A>(v); }
  static pair<A>(a: A, _b: A): Boxed<A> { return new Boxed<A>(a); }
}

// Where the arguments do not determine it, it is written at the call —
// the same syntax any generic function uses.
class Empty<T> {
  item: T;
  new(this.item);
  static none<A>(): Empty<A> | null { return null; }
}

// Two parameters of its own.
class Table<K, V> {
  key: K;
  value: V;
  new(this.key, this.value);
  static keyed<A, B>(k: A, v: B): Table<A, B> { return new Table<A, B>(k, v); }
}

// A static field on a generic class names no `T`, so it is one cell —
// and the class name is the only way to reach it.
class Counted<T> {
  item: T;
  new(this.item);
  static var count: i32 = 0;
  static bump(): i32 { Counted.count += 1; return Counted.count; }
}

class SubCounted<T> extends Counted<T> {
  new(v: T) : super(v);
}

export let main = (): i32 => {
  let a = Utils.identity(9);              // 9
  let b = Utils.pick(4, 5);               // 4
  let c = Holder.answer();                // 42
  let d = Holder.describe().length;       // 6
  let e = Boxed.of(11).item;              // 11
  let f = Boxed.pair(6, 7).item;          // 6
  let g = Table.keyed('k', 8).value;      // 8
  let h = if (Empty.none<String>() == null) 1 else 0;  // 1
  let i = Counted.bump();                 // 1
  let j = SubCounted.bump();              // 2 — inherited, the same cell
  let k = Counted.count;                  // 2
  return a + b + c + d + e + f + g + h + i + j + k;
};
