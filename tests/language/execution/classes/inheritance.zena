// @mode: run
// @result: 42

class Base {
  x: i32;
  new(this.x);
  
  getBaseX(): i32 {
    return this.x;
  }
}

class Derived extends Base {
  y: i32;
  new(x: i32, y: i32) : y = y, super(x);

  getSum(): i32 {
    return this.x + this.y;
  }
}

export let main = (): i32 => {
  let d = new Derived(20, 22);
  let base: Base = d; // Polymorphic reference (upcast)
  if (base.x != 20) {
    return 0;
  }
  return d.getSum();
};