// @mode: run
// @result: 30

class Base {
  var x: i32;
  new(this.x);
}

class Derived extends Base {
  new(x: i32) : super(x);

  doubled: i32 {
    get {
      return super.x * 2;
    }
    set(v) {
      super.x = v;
    }
  }
}

export let main = (): i32 => {
  let d = new Derived(1);
  d.doubled = 15;
  return d.doubled;
};
