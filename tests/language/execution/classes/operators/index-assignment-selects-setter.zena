// @mode: run
// @result: 7
//
// `recv[i] = v` runs the `operator []=` the index and value select,
// even when no `operator []` accepts that index (issue #121).

class Bag {
  var last: i32 = 0;
  operator [](i: i32): i32 {
    return this.last;
  }
  operator []=(i: String, v: i32): void {
    this.last = v;
  }
}

export function main(): i32 {
  let b = new Bag();
  b["k"] = 7;
  return b[0];
}
