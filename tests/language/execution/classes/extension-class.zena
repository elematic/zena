// @mode: run
// @result: 42

class Point {
  x: i32;
  y: i32;
  new(this.x, this.y);
}

extension class PointExt on Point {
  sum(): i32 {
    return this.x + this.y;
  }
  
  doubleSum: i32 {
    get { return (this as PointExt).sum() * 2; }
  }
}

export let main = (): i32 => {
  let p = new Point(11, 10);
  let ext = p as PointExt;
  return ext.doubleSum;
};
