import {CollisionClass as ClassA} from './class-collision-module-a.zena';
import {CollisionClass as ClassB} from './class-collision-module-b.zena';

export let main = (): i32 => {
  let a = new ClassA();
  let b = new ClassB();
  return a.getValue() + b.getValue();
};
