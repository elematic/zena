// @mode: run
// @result: 30

class Counter {
  static var #stored: i32 = 10;

  static value: i32 {
    get {
      return Counter.#stored;
    }
    set(v) {
      Counter.#stored = v;
    }
  }
}

export let main = (): i32 => {
  let initial = Counter.value; // 10
  Counter.value = 25;
  Counter.value += 5;
  return Counter.value; // 30
};

