// @mode: run
// @invoke: main
// @result: 42

// A method written without a return type is `void`, since methods do
// not infer from their bodies — unless it overrides a method, in which
// case it returns what the overridden method returns. Before this, the
// override checked as `void` and the `return` failed in lowering.
abstract class Shape {
  abstract area(): i32;

  describe(): String {
    return 'shape';
  }
}

class Square extends Shape {
  side: i32;

  new(this.side) : super();

  area() {
    return this.side * this.side;
  }

  describe() {
    return 'square';
  }
}

export let main = (): i32 => {
  let s: Shape = new Square(6);
  let base = s.area() + s.describe().length;   // 36 + 6
  let own: Square = new Square(1);
  return base - own.area() + 1;                // 42 - 1 + 1
};
