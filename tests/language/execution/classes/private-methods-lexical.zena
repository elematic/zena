// @mode: run
// @result: 12
// Private methods are lexically scoped, never virtual
// (member-lookup.md §6): when a subclass declares its own #m, the
// parent's body still calls the PARENT's #m directly — a private is
// never an override and never dispatches through the vtable.

class P {
  #m(): i32 {
    return 1;
  }
  call(): i32 {
    return this.#m();
  }
}

class C extends P {
  #m(): i32 {
    return 2;
  }
  callC(): i32 {
    return this.#m();
  }
}

export let main = (): i32 => {
  let c = new C();
  return c.call() * 10 + c.callC();
};
