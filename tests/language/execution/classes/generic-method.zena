// @mode: run
// @result: 12
// @skip: ZIR backend rejects the call with "zir unsupported: method not found"

// A generic method on a class. It parses, but the ZIR backend cannot lower
// the call yet. See BUGS.md.

class Box {
  identity<T>(value: T): T {
    return value;
  }

  run(): i32 {
    let a = this.identity(5);
    let b = this.identity<i32>(7);
    return a + b;
  }
}

export let main = (): i32 => {
  let it = new Box();
  return it.run();
};
