// @mode: run
// @result: 12

// A generic method on a non-generic class. Each call site mints its own
// specialization (`identity_spec_i32`); there is no body at the method's
// own erasure to find instead, which is what "method not found" was.

class Box {
  identity<T>(value: T): T {
    return value;
  }

  run(): i32 {
    let a = this.identity(5);
    let b = this.identity<i32>(7);
    return a + b;
  }
}

export let main = (): i32 => {
  let it = new Box();
  return it.run();
};
