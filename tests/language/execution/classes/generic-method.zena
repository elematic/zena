// @skip: self-hosted
// @mode: run
// @result: 12

// A generic method on a class. The bootstrap compiler handles this; the
// self-hosted compiler parses it but its ZIR backend rejects the call with
// "zir unsupported: method not found". See BUGS.md.

class Box {
  identity<T>(value: T): T {
    return value;
  }

  run(): i32 {
    let a = this.identity(5);
    let b = this.identity<i32>(7);
    return a + b;
  }
}

export let main = (): i32 => {
  let it = new Box();
  return it.run();
};
