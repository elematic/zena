// @skip: self-hosted
// @mode: run
// @result: 6

// A generic *private* method. The self-hosted compiler fails earlier than for
// the public case, in the parser: seeing `#collect` followed by `<`, it decides
// this is a private field and reports "Private field must have a type
// annotation or initializer (got '<')". See BUGS.md.
//
// This is what blocks the self-hosted compiler from building the WIT parser,
// whose `Parser.#parseList<T>` is declared this way and called six times.

class Collector {
  #collect<T>(make: () => T, count: i32): i32 {
    var total = 0;
    for (var i = 0; i < count; i += 1) {
      let produced = make();
      total += 2;
    }
    return total;
  }

  run(): i32 {
    return this.#collect<i32>(() => 1, 3);
  }
}

export let main = (): i32 => {
  let it = new Collector();
  return it.run();
};
