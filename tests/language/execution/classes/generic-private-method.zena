// @mode: run
// @result: 6

// A generic *private* method — `#collect<T>(…)`, the form the WIT parser's
// `Parser.#parseList<T>` uses.
//
// The self-hosted parser used to read `#collect` followed by `<` as a private
// *field* and reject it ("Private field must have a type annotation or
// initializer"). Fixed by 0e7effe4; both compilers run this now. Declaring a
// generic *public* method still works while calling one does not — see
// `generic-method.zena`.

class Collector {
  #collect<T>(make: () => T, count: i32): i32 {
    var total = 0;
    for (var i = 0; i < count; i += 1) {
      let produced = make();
      total += 2;
    }
    return total;
  }

  run(): i32 {
    return this.#collect<i32>(() => 1, 3);
  }
}

export let main = (): i32 => {
  let it = new Collector();
  return it.run();
};
