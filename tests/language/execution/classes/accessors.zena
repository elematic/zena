// @mode: run
// @result: 28

class Foo {
  var #x: i32;
  new(x: i32) : #x = x;
  
  x: i32 {
    get {
      return this.#x;
    }
    set(value) {
      this.#x = value;
    }
  }
}

export let main = (): i32 => {
  let foo = new Foo(13);
  let x1 = foo.x;
  foo.x = 15;
  let x2 = foo.x;
  return x1 + x2;
};
