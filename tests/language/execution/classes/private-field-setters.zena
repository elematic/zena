// @skip: bootstrap, 
// @mode: run
// @result: 320

class Point {
  var(#x) x: i32;
  var(#y) y: i32;

  new(x: i32, y: i32) : x = x, y = y;

  update(x: i32, y: i32) {
    this.#x = x;
    this.#y = y;
  }
}

export let main = (): i32 => {
  let p = new Point(0, 0);
  p.update(10, 32);
  return p.x * p.y;
};
