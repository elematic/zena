// @mode: run
// @result: 42

// A base method that calls one the subclass overrides — the template-method
// pattern, where the base owns the sequence and the subclass supplies a step.
//
// Dispatch has to reach the subclass even though the call site is in the base,
// which is the part that distinguishes this from `virtual-methods.zena`: there
// the virtual call is made from outside, through a `Base`-typed reference.

class Base {
  step(): i32 {
    return 1;
  }

  twice(): i32 {
    return this.step() * 2;
  }
}

class Derived extends Base {
  step(): i32 {
    return 21;
  }
}

export let main = (): i32 => {
  return new Derived().twice();
};
