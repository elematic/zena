// @mode: run
// @result: 100
class List<T> {
  value: T;
  new(this.value);

  operator [](index: i32): T {
    return this.value;
  }
}

let getElement = <T>(list: List<T>): T => {
  return list[0];
};

export let main = (): i32 => {
  let list = new List<i32>(100);
  return getElement<i32>(list);
};
