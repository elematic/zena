// @mode: run
// @result: 7
// A class's name does not change how it compiles. Reachability once kept a
// debugging check that threw for any specialized class named `Bare`.

class Bare<T> {
  value: T;
  new(this.value);
}

export let main = (): i32 => {
  let b = new Bare<i32>(7);
  return b.value;
};
