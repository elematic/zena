// @mode: run
// @result: 42

class Base {
  x: i32;
  new(this.x);
  
  getFoo(): i32 {
    return this.x;
  }
}

class Derived extends Base {
  y: i32;
  new(x: i32, y: i32) : y = y, super(x);

  getFoo(): i32 {
    return super.getFoo() + this.y;
  }
}

export let main = (): i32 => {
  let d = new Derived(20, 22);
  return d.getFoo();
};
