// @mode: run
// @result: 47
// A call to an abstract method through the abstract class dispatches to
// the subclass's override.
abstract class Shape {
  abstract area(): i32;

  /** A concrete method that calls the abstract one. */
  doubled(): i32 {
    return this.area() * 2;
  }
}

final class Square extends Shape {
  side: i32;

  new(side: i32) : side = side, super();

  area(): i32 {
    return this.side * this.side;
  }
}

final class Rect extends Shape {
  width: i32;
  height: i32;

  new(width: i32, height: i32) : width = width, height = height, super();

  area(): i32 {
    return this.width * this.height;
  }
}

let measure = (shape: Shape): i32 => shape.area();

export let main = (): i32 => {
  let big = new Square(4);
  // 9 + 6 + 2 * 16
  return measure(new Square(3)) + measure(new Rect(2, 3)) + big.doubled();
};
