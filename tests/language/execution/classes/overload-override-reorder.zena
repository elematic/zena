// @mode: run
// @result: 2020
// PINS most-specific selection's coherence across reference types
// (member-lookup.md §5.1/§5.3): Sub overrides only visit(Dog), and a
// Dog argument selects the visit(Dog) SLOT through both the
// base-typed and sub-typed references — same signature, Sub's body
// (20) both times. Under the retired declaration-order rule the two
// references disagreed (base picked visit(Animal)); overriding no
// longer changes which overload callers get.

class Animal {
  x: i32 = 0;
}
class Dog extends Animal {
  y: i32 = 0;
}

class Base {
  visit(a: Animal): i32 {
    return 1;
  }
  visit(d: Dog): i32 {
    return 2;
  }
}

class Sub extends Base {
  visit(d: Dog): i32 {
    return 20;
  }
}

export let main = (): i32 => {
  let dog = new Dog();
  let sub = new Sub();
  let base: Base = sub;
  return base.visit(dog) * 100 + sub.visit(dog);
};
