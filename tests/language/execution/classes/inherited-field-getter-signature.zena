// @mode: run
// @result: 42

class Payload {
  val: i32;
  new(this.val);
}

class Base {
  var(#payload) payload: Payload;
  new(this.payload);
}

class Sub extends Base {
  new(p: Payload) : super(p);
}

export let main = (): i32 => {
  let p = new Payload(42);
  let s = new Sub(p);
  return s.payload.val;
};
