// @mode: run
// @stdlib: true
// @result: 5

interface LengthHolder {
  length: i32 { get; }
}

extension class MyArray<T> on array<T> implements LengthHolder {
  @intrinsic('array.len')
  declare length: i32;
}

export let main = (): i32 => {
  let arr = __array_new(5, 42) as MyArray<i32>;
  let holder: LengthHolder = arr;
  return holder.length;
};
