// @mode: run
// @result: 2130
// PINS the ruled overload selection (member-lookup.md §5.1):
// MOST-SPECIFIC applicable candidate, declaration order carries no
// meaning. A Dog argument picks visit(Dog) in both classes
// regardless of which signature is declared first (v1 -> 2,
// v2 -> 10); an Animal argument only matches visit(Animal). The
// checker records its selection per call node
// (SemanticModel.setResolvedOverload) and codegen consumes it.
class Animal {
  new();
}

class Dog extends Animal {
  new() : super();
}

class VetAnimalFirst {
  new();
  visit(a: Animal): i32 { return 1; }
  visit(d: Dog): i32 { return 2; }
}

class VetDogFirst {
  new();
  visit(d: Dog): i32 { return 10; }
  visit(a: Animal): i32 { return 20; }
}

export let main = (): i32 => {
  let v1 = new VetAnimalFirst();
  let v2 = new VetDogFirst();
  let dog = new Dog();
  let animal = new Animal();
  // Encode all four call results.
  return v1.visit(dog) * 1000 + v1.visit(animal) * 100 +
      v2.visit(dog) + v2.visit(animal);
};
