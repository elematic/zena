// @mode: run
// @result: 238

class Base {
  static var value: i32 = 42;
  static method(x: i32): i32 {
    return Base.value + x;
  }
}

class Sub extends Base {
  static subValue: i32 = 10;
}

export let main = (): i32 => {
  let a = Base.value;         // 42
  let b = Base.method(5);     // 42 + 5 = 47
  
  // Test static inheritance / hierarchy
  let c = Sub.value;          // Inherited static field: 42
  let d = Sub.method(10);     // Inherited static method: 42 + 10 = 52
  
  // Test modifying a static field
  Base.value = 20;
  let e = Base.value;         // 20
  let f = Base.method(5);     // 20 + 5 = 25
  
  // Return some sum verifying the values
  return a + b + c + d + e + f + Sub.subValue;    // 42 + 47 + 42 + 52 + 20 + 25 + 10 = 238
};
