// @mode: run
// @result: 42

// The same shape as `base-calls-overridden-method.zena`, with the step declared
// abstract instead of given a default. The pair isolates that difference: an
// abstract declaration gives the call in `twice` nothing in the base to resolve
// against, so it has to reach the subclass through the method table.
//
// This is the whole of a framework base class — the base holds the state and the
// sequence, the subclass writes one method, and every call into the subclass
// comes from a base method — and `examples/zenafx/framework.zena` is built on it.

abstract class Base {
  abstract step(): i32;

  twice(): i32 {
    return this.step() * 2;
  }
}

class Derived extends Base {
  step(): i32 {
    return 21;
  }
}

export let main = (): i32 => {
  return new Derived().twice();
};
