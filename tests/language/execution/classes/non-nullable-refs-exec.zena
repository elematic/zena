// @mode: run
// @result: 55

class Element {
  value: i32;
  new(this.value);
}

class Node {
  elem: Element;
  next: Node | null;
  new(this.elem, this.next);
}

export let main = (): i32 => {
  let e1 = new Element(10);
  let e2 = new Element(45);
  
  // Node holds non-nullable Element, and nullable Node
  let n1 = new Node(e1, null);
  let n2 = new Node(e2, n1);
  
  // Verify field accesses and return
  let next = n2.next;
  let nextVal = if (next != null) next.elem.value else 0;
  return n2.elem.value + nextVal;
};
