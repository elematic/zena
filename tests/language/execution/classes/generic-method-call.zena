// @mode: run
// @result: 84
class Box<T> {
  value: T;
  new(this.value);
  
  getValue(): T {
    return this.value;
  }
}

class Mapper<A> {
  box: Box<A>;
  new(this.box);
  
  map<B>(f: (a: A) => B): Box<B> {
    let val = this.box.getValue();
    let newVal = f(val);
    let newBox = new Box<B>(newVal);
    let getAgain = newBox.getValue();
    return new Box<B>(getAgain);
  }
}

export let main = (): i32 => {
  let box = new Box<i32>(42);
  let mapper = new Mapper<i32>(box);
  let mapped = mapper.map<i32>((x: i32) => x * 2);
  return mapped.getValue();
};
