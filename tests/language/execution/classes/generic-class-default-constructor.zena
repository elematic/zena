// @mode: run
// @result: 42

// A field initializer inside a generic class may instantiate another generic
// class with the enclosing type parameter. The payload arrives through a
// method rather than `42 as T`, which is a forge the checker rejects.
class Box<T> {
  items: GrowableArray<T> = new GrowableArray<T>();
}

class Wrapper<T> {
  box: Box<T> = new Box<T>();
}

export let main = (): i32 => {
  let w = new Wrapper<i32>();
  w.box.items.push(42);
  return w.box.items[0];
};
