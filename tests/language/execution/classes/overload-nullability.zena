// @mode: run
// @result: 21
// Most-specific selection with nullability (member-lookup.md §5.1):
// T is more specific than T | null, so a Dog argument picks g(Dog)
// even though g(Dog | null) is also applicable; a null argument can
// only pick the nullable overload.

class Dog {
  y: i32 = 0;
}

class NullPref {
  g(x: Dog | null): i32 {
    return 1;
  }
  g(x: Dog): i32 {
    return 2;
  }
}

export let main = (): i32 => {
  let n = new NullPref();
  let d = new Dog();
  return n.g(d) * 10 + n.g(null);
};
