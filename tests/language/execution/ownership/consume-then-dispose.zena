// @mode: run
// @result: 11
// A consuming method that takes a field out and then releases the
// wrapper itself with an explicit dispose: the take left null in the
// field, so the glue skips it and the inner resource is released once.
import { Own, Disposable } from 'zena:core';

var innerDropped = 0;
var outerDropped = 0;

resource class Inner {
  new();
  [Disposable.dispose](this: Own<this>): void {
    innerDropped += 1;
  }
}

let sink = (inner: Own<Inner>): void => {};

resource class Outer {
  var #inner: Own<Inner> | null;
  new(inner: Own<Inner>) : #inner = inner;

  giveAway(this: Own<this>): void {
    let inner = this.#inner;
    if (inner != null) {
      sink(inner);
    }
    this.[Disposable.dispose]();
  }

  [Disposable.dispose](this: Own<this>): void {
    outerDropped += 10;
  }
}

export let main = (): i32 => {
  let o = new Outer(new Inner());
  o.giveAway();
  // 11: the inner released once (by sink's parameter drop), the outer
  // once. 12 would mean the dispose glue released the inner again.
  return innerDropped + outerDropped;
};
