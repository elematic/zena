// @mode: run
// @result: 21
// A pattern over a result holding an owner matches the member it holds:
// `if (let (true, value) = outcome)` on a `Result<Own<Res>, String>`.
// Written for the `Outcome` classes, whose class pattern once tested the
// template `Ok<T, E>`, which no value is, and matched neither arm
// (elematic/zena#270).
import { Own, Disposable, Result } from 'zena:core';

resource class Res {
  new();
  [Disposable.dispose](this: Own<this>): void {}
}

let open = (ok: boolean): Result<Own<Res>, String> => {
  if (ok) {
    return (true, new Res());
  }
  return (false, 'nope');
};

// One match, since a pattern moves the result: a second `if let` over it
// would read a moved value.
let armOf = (outcome: Result<Own<Res>, String>): i32 => match (outcome) {
  case (true, let value): 1
  case (false, let error): 20
};

export let main = (): i32 => {
  // 1 for the ok arm plus 20 for the err arm.
  return armOf(open(true)) + armOf(open(false));
};
