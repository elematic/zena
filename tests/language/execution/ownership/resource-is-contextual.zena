// @mode: run
// @result: 7

// `resource` is a contextual modifier, not a reserved word: it only means
// "resource class" when a class declaration follows. Ordinary uses as an
// identifier must keep working, because bindgen-generated and user code both
// plausibly name a variable `resource`.

import { Own, Disposable } from 'zena:ownership';

resource class Handle {
  :Disposable.dispose(this: Own<this>): void {}
}

export function main(): i32 {
  let resource = 3;
  var total = resource;
  let resourceCount = 4;
  total += resourceCount;
  return total;
}
