// @mode: run
// @result: 41
//
// A resource class imported from another module is constructed like
// one declared here: reachability roots its constructor through the
// module that declares it. The constructing file does not import
// `Own`; the owner it is handed is the standard library's by identity.

import { Handle, dropped } from './imported_resource_helper.zena';

function useOne(): i32 {
  let h = new Handle(40);
  return h.value;
}

export function main(): i32 {
  let v = useOne();
  return v + dropped;
}
