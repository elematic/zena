// @mode: run
// @result: 1835
// `isFirstClass<T>()` is a constant in each specialization: true where
// `T` is first-class, false where it may be restricted, so a `scoped T`
// body can branch on it and the branch folds away
// (owner-futures.md §"Specialization"). Each case is one bit of the
// result.
//
// An owner and a borrow, and a value holding one, are restricted. An
// `Unmanaged<R>` is unrestricted, as the checker treats it, and so is a
// value holding one, though all three handles are represented by the
// resource class. `Scoped<F>` is `F`'s answer: its restriction is the
// checker's to enforce.

import {Own, Borrow, Unmanaged, Scoped, Disposable, isFirstClass} from 'zena:core';

resource class Res {
  [Disposable.dispose](this: Own<this>): void {}
}

class Plain {}

class Slot<scoped T> {
  kind(): i32 {
    return if (isFirstClass<T>()) 1 else 0;
  }
}

let firstClass = <scoped T>(): i32 => if (isFirstClass<T>()) 1 else 0;

export let main = (): i32 => {
  var bits = 0;
  bits += firstClass<i32>() * 1;
  bits += firstClass<String>() * 2;
  bits += firstClass<Own<Res>>() * 4;
  bits += new Slot<Plain>().kind() * 8;
  bits += new Slot<Own<Res>>().kind() * 16;
  bits += firstClass<Scoped<Future<i32>>>() * 32;
  bits += firstClass<(i32, Own<Res>)>() * 64;
  bits += firstClass<Borrow<Res>>() * 128;
  bits += firstClass<Unmanaged<Res>>() * 256;
  bits += new Slot<Unmanaged<Res>>().kind() * 512;
  bits += firstClass<(i32, Unmanaged<Res>)>() * 1024;
  return bits;
};
