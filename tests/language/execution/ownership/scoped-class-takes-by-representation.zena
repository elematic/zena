// @mode: run
// @result: 111
// Each handle, and `Scoped<F>`, has a specialization of its own, but a
// take is decided from the representation: a handle is its resource
// class, and `Scoped<F>` is `F`. So the instantiation the compiler
// reaches first changes nothing (owner-futures.md §"Specialization").

import {Own, Unmanaged, Scoped, Disposable, WithDefault, defaultValue} from 'zena:core';

var released = 0;

resource class Res {
  [Disposable.dispose](this: Own<this>): void {
    released += 1;
  }
}

class Slot<scoped T> {
  var #value: WithDefault<T> = defaultValue<T>();
  put(value: T): void {
    this.#value = value;
  }
  take(): WithDefault<T> {
    return this.#value;
  }
}

let tick = async (): Future<i32> => 1;

export let main = (): i32 => {
  var result = 0;

  // `Unmanaged<Res>` reached first: the owner's slot still takes, so
  // the resource is released once.
  let unmanaged = new Slot<Unmanaged<Res>>();
  let none = unmanaged.take();
  if (true) {
    let s = new Slot<Own<Res>>();
    s.put(new Res());
    let a = s.take();
    let b = s.take();
    if (b == null) {
      result += 10;
    }
  }
  result += released;

  // `Scoped<Future<i32>>` reached first: a plain future's slot is
  // first-class, so the future stays readable.
  let scoped = new Slot<Scoped<Future<i32>>>();
  let empty = scoped.take();
  let f = new Slot<Future<i32>>();
  f.put(tick());
  let first = f.take();
  let second = f.take();
  if (first != null && second != null) {
    result += 100;
  }
  return result;
};
