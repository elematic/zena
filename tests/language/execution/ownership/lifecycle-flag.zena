// @mode: run
// @result: 604
// The `owned | disowned | moved | dropped` flag every resource object
// carries (ownership.md §"Disowning and adopting"). It is what stops a
// second `adopt` from silently minting a second owner, and a second
// `disown` from handing out two unmanaged aliases with one disposal
// obligation between them.
//
// The flag is an ordinary private field on `Resource`, the root every
// resource class extends, read and written through symbol-keyed
// accessors that no code outside zena:ownership can name.
//
// The flag lives on the resource OBJECT, not on the handle, because the
// handles are erased and an `Unmanaged<R>` alias and a later `adopt`
// have to observe the same one. `sharesFlagWithAlias` is the case that
// pins that down.
import { Own, Unmanaged, Disposable, disown, adopt, ResourceStateError } from 'zena:ownership';

resource class Counter {
  var #n: i32;
  new(n: i32) : #n = n;
  value(): i32 { return this.#n; }
  bump(by: i32): void { this.#n += by; }
  :Disposable.dispose(this: Own<this>): void {}
}

/** A second adopter loses, rather than becoming a second owner. */
let secondAdoptThrows = (): i32 => {
  let raw = disown(new Counter(1));
  let first = adopt(raw);
  try {
    // `raw` still names the resource — aliasability is the whole point
    // of the disowned state — but it is no longer disowned.
    let second = adopt(raw);
    return -1;
  } catch (e) {
    if (!(e is ResourceStateError)) {
      return -2;
    }
  }
  return first.value();
};

/** Disowning twice is caught by the flag when the checker cannot see it. */
let secondDisownThrows = (): i32 => {
  // Move checking rejects `disown(c); disown(c)` on a local statically,
  // and the affine-field rules closed the field-read route this test
  // used to take. A captured binding moved inside a closure is still
  // outside the checker's scope, so the double disown reaches the
  // object through one — the flag is what catches it.
  let c = new Counter(2);
  let grab = () => disown(c);
  let raw = grab();
  try {
    let again = grab();
    return -3;
  } catch (e) {
    if (!(e is ResourceStateError)) {
      return -4;
    }
  }
  return raw.value();
};

/**
 * Adopting through a different alias than the one disowned works, and
 * flips the state for every alias at once. Two handles to one object
 * must not disagree about whether it is owned.
 */
let sharesFlagWithAlias = (): i32 => {
  let raw = disown(new Counter(4));
  let alias = raw;
  let back = adopt(alias);
  try {
    // Adopting via the ORIGINAL alias must now fail: adopting through
    // `alias` moved the object, not a per-handle copy of the flag.
    let viaOther = adopt(raw);
    return -5;
  } catch (e) {
    if (!(e is ResourceStateError)) {
      return -6;
    }
  }
  return back.value();
};

/** A resource can cycle between the two regimes any number of times. */
let roundTripsRepeatedly = (): i32 => {
  var owned = new Counter(8);
  for (var i = 0; i < 3; i += 1) {
    let raw = disown(owned);
    raw.bump(1);
    owned = adopt(raw);
  }
  return owned.value();
};

// Not covered here: a flagless `T` reaching the accessors, which folds
// to "always owned". The `Resource` bound on disown/adopt makes that
// unreachable — they admit exactly the classes the field is injected
// into. See semantics/ownership/resource-constraint.zena for the bound.

export function main(): i32 {
  let a = secondAdoptThrows();       // 1
  if (a < 0) { return a; }
  let b = secondDisownThrows();      // 2
  if (b < 0) { return b; }
  let c = sharesFlagWithAlias();     // 4
  if (c < 0) { return c; }
  let d = roundTripsRepeatedly();    // 8 + 3 = 11
  if (d < 0) { return d; }
  // The distinct powers of two make a skipped case impossible to hide:
  // any subset sums to something else. 1 + 2 + 4 + 11 = 18.
  return (a + b + c + d) * 33 + 10;
}
