// @mode: run
// @result: 654321
// An owned parameter the body never moves is released at function
// exit: the function received ownership, so the function releases —
// on normal completion, early return, and unwind — unless the body
// moves it onward. A nullable owner skips when null, like any other
// release site.
import {Own, Disposable} from 'zena:ownership';

var released = 0;
var seen = 0;

resource class Res {
  id: i32;
  new(this.id);
  :Disposable.dispose(this: Own<this>): void { released += this.id; }
}

// Reads, never moves: releases at exit.
let observe = (r: Own<Res>): i32 => {
  seen += r.id;
  return r.id;
};

// Releases what it is handed.
let observe2 = (r: Own<Res>): void => {
  seen += r.id * 100;
};

// Moves onward: the callee owns it now; no release here.
let forward = (r: Own<Res>): void => {
  observe2(r);
};

// Early return still releases.
let early = (r: Own<Res>, c: boolean): i32 => {
  if (c) { return 1; }
  seen += r.id;
  return 0;
};

// Nullable owner: skipped when null.
let maybe = (r: Own<Res> | null): void => {
  if (r != null) { seen += r.id; }
};

// Unwind releases too.
let unwinds = (r: Own<Res>): void => {
  throw new Error('x');
};

export let main = (): i32 => {
  var score = 0;
  released = 0; observe(new Res(1));
  score += released;                  // 1
  released = 0; forward(new Res(2));
  score += released * 10;             // released once, by observe2: 20
  released = 0; early(new Res(3), true);
  score += released * 100;            // 300
  released = 0; early(new Res(4), false);
  score += released * 1000;           // 4000
  released = 0; maybe(null);
  score += released * 10000;          // null skipped: 0
  released = 0; maybe(new Res(5));
  score += released * 10000;          // 50000
  released = 0;
  try { unwinds(new Res(6)); } catch (e) {}
  score += released * 100000;         // 600000
  return score;                       // 654321
};
