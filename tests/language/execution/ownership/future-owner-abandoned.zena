// @mode: run
// @result: 11
// A future that holds an owner, released without being awaited, releases
// the owner: at once when it has settled, and when it settles otherwise.
import { Own, Disposable } from 'zena:core';
import { Completer, runFuture } from 'zena:async';

var released = 0;

resource class Res {
  n: i32;
  new(this.n);
  [Disposable.dispose](this: Own<this>): void {
    released += this.n;
  }
}

async function make(n: i32): Future<Own<Res>> {
  return new Res(n);
}

async function settledThenDropped(): Future<void> {
  let f = make(1);
  await Future.of(0);
}

async function droppedThenSettled(gate: Future<void>): Future<Own<Res>> {
  await gate;
  return new Res(10);
}

export let main = (): i32 => {
  runFuture(settledThenDropped());
  let gate = new Completer<void>();
  if (true) {
    let pending = droppedThenSettled(gate.future);
  }
  gate.complete();
  runFuture(gate.future);
  return released;
};
