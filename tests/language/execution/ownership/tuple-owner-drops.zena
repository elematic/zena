// @mode: run
// @result: 0
// A tuple holding an owner is released at scope exit unless something
// moves it, and so is an owner bound by destructuring (#495). Each file
// adds its number to `released` when it is disposed, so the total shows
// every owner was released exactly once.

import { Own, Disposable } from 'zena:core';

var released = 0;

resource class File {
  var #fd: i32;
  new(fd: i32) : #fd = fd;
  [Disposable.dispose](this: Own<this>): void {
    released += this.#fd;
  }
  fd(): i32 { return this.#fd; }
}

function open(fd: i32): Own<File> {
  return new File(fd);
}

type Opened = (true, Own<File>) | (false, String);

function openOrFail(ok: boolean, fd: i32): Opened {
  if (ok) {
    return (true, open(fd));
  }
  return (false, 'no');
}

// The parameter owns the tuple, so the function releases it.
function take(t: (true, Own<File>)): void {}

// Likewise for a plain owner.
function consume(f: Own<File>): void {}

function openInline(fd: i32): inline (true, Own<File>) | (false, String) {
  return (true, open(fd));
}

function tupleReleased(): void {
  let t = (true, open(1));
}

function destructured(): void {
  let (ok, f) = (true, open(2));
}

function moved(): void {
  let t = (true, open(4));
  take(t);
}

function unionReleased(): void {
  let r = openOrFail(true, 8);
}

function unionHoldsNothing(): void {
  let r = openOrFail(false, 1000);
}

function nested(): void {
  let t = (1, (true, open(16)));
}

function earlyExit(early: boolean): i32 {
  let t = (true, open(32));
  if (early) {
    return 1;
  }
  return 0;
}

function reassigned(): void {
  var t = (true, open(128));
  t = (true, open(256));
}

// An owner bound by a pattern is released at the end of its branch.
function ifLetReleased(): void {
  if (let (true, f) = openOrFail(true, 512)) {
    let n = f.fd();
  }
}

function ifLetMoved(): void {
  if (let (true, f) = openOrFail(true, 1024)) {
    consume(f);
  }
}

function ifLetEarlyExit(): i32 {
  if (let (true, f) = openOrFail(true, 2048)) {
    return 1;
  }
  return 0;
}

function matchReleased(): void {
  match (openOrFail(true, 4096)) {
    case (true, let f): {}
    case (false, let why): {}
  }
}

function ifLetInline(): void {
  if (let (true, f) = openInline(8192)) {}
}

// A discarded result is released where it is discarded.
function discarded(): void {
  openOrFail(true, 16384);
  open(32768);
  openInline(65536);
}

function borrowed(): i32 {
  let t = (true, open(64));
  return t[1].fd();
}

export let main = (): i32 => {
  tupleReleased();
  destructured();
  moved();
  unionReleased();
  unionHoldsNothing();
  nested();
  earlyExit(true);
  reassigned();
  ifLetReleased();
  ifLetMoved();
  ifLetEarlyExit();
  matchReleased();
  ifLetInline();
  discarded();
  let n = borrowed();
  return released - (1 + 2 + 4 + 8 + 16 + 32 + 64 + 128 + 256 + 512 + 1024 + 2048 +
      4096 + 8192 + 16384 + 32768 + 65536) + (n - 64);
};
