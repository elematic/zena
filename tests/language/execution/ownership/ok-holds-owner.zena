// @mode: run
// @result: 7
// An owner in a result's `true` member, the shape a WIT
// `result<own<r>, e>` lifts to: a pattern moves the owner out of the
// result, and the resource is released exactly once, at the end of the
// branch that bound it.
import { Own, Disposable, Result } from 'zena:core';

var released = 0;

resource class Res {
  id: i32;
  new(this.id);
  [Disposable.dispose](this: Own<this>): void {
    released += this.id;
  }
}

let open = (ok: boolean): Result<Own<Res>, String> => {
  if (ok) {
    return (true, new Res(7));
  }
  return (false, 'nope');
};

export let main = (): i32 => {
  var seen = 0;
  if (true) {
    let outcome = open(true);
    if (let (true, r) = outcome) {
      seen = r.id;
    }
  }
  // 7 if the value came out and the resource was released once.
  return if (released == 7) seen else released * 100 + seen;
};
