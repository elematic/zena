// @mode: run
// @result: 3
// A resource class wrapping an owned field, with borrowing methods
// that reach the inner resource and a consuming method that takes the
// inner one out and gives it to a background task. The take leaves
// null in the field, and the consumed wrapper is released at the
// method's exit, its glue skipping the field.
import { Own, Borrow, Disposable } from 'zena:core';
import { Completer, runFuture } from 'zena:async';

var innerDropped = 0;
var outerDropped = 0;

resource class Inner {
  n: i32;
  new(this.n);
  [Disposable.dispose](this: Own<this>): void {
    innerDropped += 1;
  }
}

async function closeLater(inner: Own<Inner>, done: Future<void>): Future<void> {
  await done;
}

resource class Outer {
  var #inner: Own<Inner> | null;
  new(inner: Own<Inner>) : #inner = inner;

  value(): i32 {
    let inner = this.#inner;
    return if (inner == null) 0 else inner.n;
  }

  /** Hands the inner resource to a task that releases it when `done`
   * settles; this wrapper is consumed. */
  readStream(this: Own<this>, done: Future<void>): i32 {
    let inner = this.#inner;
    if (inner == null) {
      return 0;
    }
    let n = inner.n;
    closeLater(inner, done);
    return n;
  }

  [Disposable.dispose](this: Own<this>): void {
    outerDropped += 1;
  }
}

export let main = (): i32 => {
  var total = 0;
  if (true) {
    let a = new Outer(new Inner(1));
    total += a.value();
  }
  // a released: inner glue ran once.
  if (innerDropped != 1 || outerDropped != 1) {
    return 0 - 1;
  }
  let c = new Completer<void>();
  if (true) {
    let b = new Outer(new Inner(2));
    let n = b.readStream(c.future);
    total += n;
  }
  // b consumed by readStream: outer disposed, inner handed on and NOT
  // released yet.
  if (innerDropped != 1 || outerDropped != 2) {
    console.log(`after readStream: inner ${innerDropped} outer ${outerDropped}`);
    return 0 - 2;
  }
  c.complete();
  runFuture(c.future);
  // Now the task's parameter release ran.
  if (innerDropped != 2) {
    return 0 - 3;
  }
  return total;
};
