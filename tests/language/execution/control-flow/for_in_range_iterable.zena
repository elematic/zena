// @mode: run
// @result: 1
// BoundedRange and FromRange are Iterable<i32>, so they work anywhere an
// iterable is expected, and have the Iterable methods.
let total = (items: Iterable<i32>): i32 => {
  var sum = 0;
  for (let i in items) {
    sum += i;
  }
  return sum;
};

export let main = (): i32 => {
  if (total(1..5) != 10) { return 0; }
  if (total(4..1) != 0) { return 0; }

  let r = 0..10;
  if (!r.contains(0) || !r.contains(9)) { return 0; }
  if (r.contains(10) || r.contains(-1)) { return 0; }
  let from = 10..;
  if (from.contains(9) || !from.contains(2147483647)) { return 0; }

  if (r.fold(0, (acc: i32, i: i32) => acc + i) != 45) { return 0; }
  if (!r.all((i: i32) => i < 10) || r.some((i: i32) => i > 9)) { return 0; }
  if (total(r.filter((i: i32) => i % 3 == 0)) != 18) { return 0; }
  let squares = 7..;
  if (let (true, found) = squares.find((i: i32) => i * i > 70)) {
    if (found != 9) { return 0; }
  } else {
    return 0;
  }

  // Driving the iterator by hand gives the same sequence.
  let small = 3..5;
  let it = small.[Iterable.iterator]();
  var sum = 0;
  for (let i in it) {
    sum += i;
  }
  if (sum != 7) { return 0; }
  return 1;
};
