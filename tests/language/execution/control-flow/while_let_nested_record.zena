// @mode: run
// @skip: bootstrap
// @result: 9

type Pair = {first: i32, second: i32};

class Counter {
  var value: i32;
  new() : value = 0 {}
  
  next(): inline (boolean, Pair) {
    this.value = this.value + 1;
    if (this.value <= 2) {
      return (true, {first: this.value, second: this.value * 2});
    }
    return (false, {first: 0, second: 0});
  }
}

export let main = (): i32 => {
  let counter = new Counter();
  var sum = 0;
  while (let (true, {first, second}) = counter.next()) {
    sum = sum + first + second;
  }
  return sum;
};
