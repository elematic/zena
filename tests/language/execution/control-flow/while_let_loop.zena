// @mode: run
// @result: 6

class Counter {
  var value: i32;
  new() : value = 0 {}
  
  next(): inline (boolean, i32) {
    this.value = this.value + 1;
    if (this.value <= 3) {
      return (true, this.value);
    }
    return (false, 0);
  }
}

export let main = (): i32 => {
  let counter = new Counter();
  var sum = 0;
  while (let (true, v) = counter.next()) {
    sum = sum + v;
  }
  return sum;  // 1 + 2 + 3 = 6
};
