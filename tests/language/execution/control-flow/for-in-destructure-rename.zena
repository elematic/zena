// @mode: run
// @result: 42
// Record-pattern destructuring with `as` renames in for-in — the
// pervasive `{key as k, value as v}` idiom.

import { HashMap } from 'zena:map';

export let main = (): i32 => {
  let map = new HashMap<String, i32>();
  map['a'] = 30;
  map['b'] = 12;
  var sum = 0;
  for (let {key as name, value as amount} in map) {
    if (name == 'a' || name == 'b') {
      sum += amount;
    }
  }
  return sum;
};
