// @mode: run
// @result: 42
// Functions that end in a loop that never completes, with no return
// after it: each leaves only through a `return` or a `throw` inside.

class Item(val: i32)

function firstSquareAbove(limit: i32): i32 {
  var i = 0;
  while (true) {
    if (i * i > limit) {
      return i;
    }
    i += 1;
  }
}

function indexOf(xs: FixedArray<i32>, x: i32): i32 {
  for (var i = 0; ; i += 1) {
    if (i == xs.length) {
      return -1;
    }
    if (xs[i] == x) {
      return i;
    }
  }
}

function valueOf(item: Item | null): i32 {
  if (item == null) {
    while (true) {
      throw new Error('no item');
    }
  }
  return item.val;
}

function thrown(): i32 {
  try {
    return valueOf(null);
  } catch (e) {
    return 1;
  }
}

export let main = (): i32 => {
  // 5 + 2 + 34 + 1
  return firstSquareAbove(20) + indexOf([4, 5, 6], 6) + valueOf(new Item(34)) + thrown();
};
