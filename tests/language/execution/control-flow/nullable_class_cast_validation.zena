// @mode: run
// @result: 42
// Verify that a nullable class union type (Wrapper | null) can be narrowed and safely assigned/returned

class Wrapper(value: i32)

let getVal = (x: Wrapper | null): i32 => {
  if (x != null) {
    let y: Wrapper = x;
    return y.value;
  }
  return 0;
};

let getValDirect = (x: Wrapper | null): Wrapper => {
  if (x != null) {
    return x;
  }
  return new Wrapper(0);
};

export let main = (): i32 => {
  let w = new Wrapper(42);
  let res1 = getVal(w);
  let res2 = getValDirect(w).value;
  return if (res1 == res2) res1 else 0;
};
