// @mode: run
// @result: 42

class Target(value: i32)

let runCast = (x: Target | null): i32 => {
  if (x != null) {
    // Narrowing is active. We cast x (static type Target, Wasm storage type Target|null)
    // to Target via 'as Target'. This must emit a ref.cast to satisfy Wasm validation.
    let t = x as Target;
    return t.value;
  }
  return 0;
};

export let main = (): i32 => {
  return runCast(new Target(42));
};
