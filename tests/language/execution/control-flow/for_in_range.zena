// @mode: run
// @result: 1
// A for-in over a range literal counts from start up to (excluding) end.
// A range held in a variable iterates the same way, an empty range runs
// no iterations, and the bounds are evaluated once, before the loop.
var boundCalls = 0;
let bound = (n: i32): i32 => {
  boundCalls += 1;
  return n;
};

export let main = (): i32 => {
  var sum = 0;
  for (let i in 0..5) {
    sum += i;
  }
  if (sum != 10) { return 0; }

  let r = 2..6;
  var product = 1;
  for (let i in r) {
    product *= i;
  }
  if (product != 120) { return 0; }

  var emptyRuns = 0;
  for (let i in 5..2) {
    emptyRuns += 1;
  }
  for (let i in 3..3) {
    emptyRuns += 1;
  }
  if (emptyRuns != 0) { return 0; }

  var negatives = 0;
  for (let i in -3..0) {
    negatives += i;
  }
  if (negatives != -6) { return 0; }

  var last = -1;
  for (let i in 0..bound(4)) {
    last = i;
  }
  if (last != 3 || boundCalls != 1) { return 0; }

  // break, continue, and nested loops.
  var picked = 0;
  for (let i in 0..100) {
    if (i == 7) { break; }
    if (i % 2 == 0) { continue; }
    for (let j in 0..i) {
      picked += 1;
    }
  }
  // i = 1, 3, 5 run 1 + 3 + 5 inner iterations.
  if (picked != 9) { return 0; }

  // Each iteration binds a fresh `i`: closures see their own value.
  let fns = new Array<() => i32>();
  for (let i in 0..3) {
    fns.push(() => i * 10);
  }
  if (fns[0]() + fns[1]() + fns[2]() != 30) { return 0; }

  return 1;
};
