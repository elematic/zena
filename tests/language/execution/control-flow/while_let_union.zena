// @mode: run
// @result: 6

class Iterator {
  var index: i32;
  new() : index = 0 {}
  
  next(): inline (true, i32) | inline (false, _) {
    this.index = this.index + 1;
    if (this.index <= 3) {
      return (true, this.index);
    }
    return (false, _);
  }
}

export let main = (): i32 => {
  let iter = new Iterator();
  var sum = 0;
  while (let (true, v) = iter.next()) {
    sum = sum + v;
  }
  return sum;  // 1 + 2 + 3 = 6
};
