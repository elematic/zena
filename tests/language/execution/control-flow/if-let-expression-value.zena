// @mode: run
// @result: 4

// Value-position if-let: the pattern binds in the then arm and the
// expression produces a value from either arm.

let probe = (ok: boolean): inline (boolean, i32) => (ok, 5);

export let main = (): i32 => {
  let a = if (let (true, v) = probe(true)) v else -1;
  let b = if (let (true, v) = probe(false)) v else -1;
  return a + b;
};
