// @mode: run
// @result: 15

import { Iterable, Iterator } from 'zena:iterator';

class StringIterator implements Iterator<String> {
  var count: i32 = 0;
  new();
  
  next(): inline (true, String) | inline (false, _) {
    if (this.count == 0) {
      this.count = 1;
      return (true, "hello");
    }
    return (false, _);
  }
}

class StringIterable implements Iterable<String> {
  new();
  
  :Iterable.iterator(): Iterator<String> {
    return new StringIterator();
  }
  
  contains(value: String): boolean { return false; }
  all(predicate: (item: String) => boolean): boolean { return false; }
  some(predicate: (item: String) => boolean): boolean { return false; }
  fold<R>(initial: R, combine: (acc: R, item: String) => R): R { return initial; }
  find(predicate: (item: String) => boolean): inline (true, String) | inline (false, _) { return (false, _); }
  filter(predicate: (item: String) => boolean): Iterable<String> { return this; }
}

export let main = (): i32 => {
  let iterable = new StringIterable();
  var result = 0;
  for (let x in iterable) {
    if (x == "hello") {
      result = 15;
    }
  }
  return result;
};
