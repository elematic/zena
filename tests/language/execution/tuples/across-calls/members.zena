// @mode: run
// @result: 0
// Boxed tuple parameters of constructors, `super(...)`, methods and
// generic functions explode as record ones do (#373,
// docs/design/argument-explosion.md): a literal argument is passed as its
// elements.

class Base {
  x: i32;
  y: i32;
  new(p: (i32, i32)) : x = p[0], y = p[1];
}

final class Sub extends Base {
  new(z: i32) : super((z, z + 1));
}

// Passes its own exploded parameter on to `super`.
final class Pass extends Base {
  new(p: (i32, i32)) : super(p);
}

final class Scale {
  k: i32;
  new(this.k);
  apply(p: (i32, i32)): i32 {
    return this.k * (p[0] + p[1]);
  }
}

function first<T>(p: (i32, T)): i32 {
  return p[0];
}

// Elements that are references, and a comparison of the whole tuple.
function same(a: (String, i32), b: (String, i32)): boolean {
  return a == b;
}

export let main = (): i32 => {
  var failures = 0;
  let b = new Base((1, 2));
  if (b.x != 1 || b.y != 2) { failures += 1; }
  let s = new Sub(3);
  if (s.x != 3 || s.y != 4) { failures += 2; }
  let p = new Pass((5, 6));
  if (p.y != 6) { failures += 4; }
  let k = new Scale(2);
  if (k.apply((5, 6)) != 22) { failures += 8; }
  if (first<i32>((7, 8)) != 7 || first<String>((9, 'x')) != 9) { failures += 16; }
  if (!same(('a', 1), ('a', 1)) || same(('a', 1), ('b', 1))) { failures += 32; }
  let held: (i32, i32) = (1, 1);
  if (k.apply(held) != 4 || new Pass(held).x != 1) { failures += 64; }
  return failures;
};
