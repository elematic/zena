// @mode: run
// @result: 1
// A function whose tuple result some call only reads for its elements
// returns the elements instead. Results are destructured, bound and read,
// indexed directly, matched, returned on through another function,
// returned from several places (early, from a value block's tail, through
// `finally`), passed through unchanged from a parameter, and also used
// whole, through a function value. Every shape must see the same tuple.

type V = (i32, i32);

var finalized = 0;

function make(n: i32): V {
  return (n, n * 2);
}

function pick(n: i32): V {
  if (n < 0) {
    return (0, 0);
  }
  let base = n + 1;
  (base, base + 1)
}

function guarded(n: i32): V {
  try {
    return (n, -n);
  } finally {
    finalized += 1;
  }
}

function passThrough(v: V): V {
  return v;
}

function viaMake(n: i32): V {
  return make(n + 10);
}

function mixed(n: i32): (String, i32) {
  return ('m', n);
}

function keep(v: V): V {
  return v;
}

// The result is stored whole, so the parameter is needed whole.
function same(v: V): V {
  return v;
}

function clampY(v: V): V {
  return if (v[1] > 10) (v[0], 10) else v;
}

var stored: V = (0, 0);

export let main = (): i32 => {
  let (x, y) = make(3);
  if (x != 3 || y != 6) {
    return 0;
  }
  let bound = make(4);
  if (bound[0] + bound[1] != 12) {
    return 0;
  }
  if (make(5)[1] != 10) {
    return 0;
  }
  let matched = match (make(6)) {
    case (0, _): -1
    case (let a, let b): a + b
  };
  if (matched != 18) {
    return 0;
  }
  let early = pick(-1);
  let late = pick(2);
  if (early[0] != 0 || late[0] != 3 || late[1] != 4) {
    return 0;
  }
  let g = guarded(7);
  if (g[0] != 7 || g[1] != -7 || finalized != 1) {
    return 0;
  }
  let p = passThrough((8, 9));
  if (p[0] != 8 || p[1] != 9) {
    return 0;
  }
  let chained = viaMake(1);
  if (chained[0] != 11 || chained[1] != 22) {
    return 0;
  }
  let (s, n) = mixed(2);
  if (s != 'm' || n != 2) {
    return 0;
  }
  let a = clampY((1, 20));
  let b = clampY((1, 5));
  if (a[1] != 10 || b[1] != 5 || b[0] != 1) {
    return 0;
  }
  // Used whole: stored, passed on, through a function value.
  stored = make(6);
  if (stored[1] != 12 || keep(make(7))[0] != 7) {
    return 0;
  }
  let asValue = make;
  if (asValue(8)[1] != 16) {
    return 0;
  }
  stored = same((9, 9));
  // A heap tuple passed to a function whose parameter explodes.
  let e = passThrough(stored);
  if (e[0] != 9 || e[1] != 9) {
    return 0;
  }
  return 1;
};
