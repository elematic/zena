// @mode: run
// @result: 1
// A `var` of a tuple type that is only read for its elements, and only
// assigned values that are elements already, is carried as its elements:
// through loops, both arms of an `if`, and nested loops. A var written a
// heap tuple, captured by a closure, returned whole, or assigned inside
// `try` keeps the tuple. Every shape must compute the same thing.

type V = (i32, i32);

function step(p: V): V {
  return (p[0] + p[1], p[1] + 1);
}

function flip(p: V): V {
  let (x, y) = p;
  return (y, x);
}

function total(p: V): i32 {
  return p[0] + p[1];
}

var kept: V = (0, 0);

function loop(n: i32): i32 {
  var pos: V = (0, 1);
  for (var i = 0; i < n; i += 1) {
    pos = step(pos);
  }
  return pos[0];
}

function branches(n: i32): i32 {
  var pos: V = (1, 2);
  var i = 0;
  while (i < n) {
    if ((i & 1) == 0) {
      pos = flip(pos);
    } else {
      pos = (pos[0] + 10, pos[1]);
    }
    i += 1;
  }
  return total(pos);
}

function nested(): i32 {
  var pos: V = (0, 0);
  for (var a = 0; a < 3; a += 1) {
    for (var b = 0; b < 3; b += 1) {
      pos = step(pos);
    }
    pos = flip(pos);
  }
  let (x, y) = pos;
  return x * 1000 + y;
}

function matched(n: i32): i32 {
  var pos: V = (0, 1);
  for (var i = 0; i < n; i += 1) {
    pos = step(pos);
  }
  return match (pos) {
    case (0, _): -1
    case (let x, let y): x * 100 + y
  };
}

function fromHeap(): i32 {
  var pos: V = (1, 1);
  pos = kept;
  pos = step(pos);
  return pos[0] + pos[1];
}

function captured(): i32 {
  var pos: V = (2, 3);
  pos = step(pos);
  let read = () => pos[0];
  return read() + pos[1];
}

function returnedWhole(): V {
  var pos: V = (4, 5);
  pos = step(pos);
  return pos;
}

function inTry(): i32 {
  var pos: V = (1, 2);
  try {
    pos = step(pos);
    pos = step(pos);
  } finally {
    pos = flip(pos);
  }
  return pos[0] * 100 + pos[1];
}

export let main = (): i32 => {
  // x: 0,1,3,6,10,15 with y: 1..6
  if (loop(5) != 15) {
    return 0;
  }
  // (1,2) flip (2,1) +10 (12,1) flip (1,12) +10 (11,12)
  if (branches(4) != 23) {
    return 0;
  }
  // Each outer round: three steps, then a flip.
  if (nested() != 18054) {
    return 0;
  }
  // (15, 6)
  if (matched(5) != 1506) {
    return 0;
  }
  kept = (5, 7);
  if (fromHeap() != 20) {
    return 0;
  }
  if (captured() != 9) {
    return 0;
  }
  let whole = returnedWhole();
  if (whole[0] != 9 || whole[1] != 6) {
    return 0;
  }
  // (1,2) -> (3,3) -> (6,4) -> flip (4,6)
  if (inTry() != 406) {
    return 0;
  }
  return 1;
};
