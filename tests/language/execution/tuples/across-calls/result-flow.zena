// @mode: run
// @result: 1
// A tuple result stays as its elements as it flows on: passed straight
// to another call whose parameter only reads it (functions, methods,
// nested calls), a method's result returned from a function or another
// method, and a `let`-bound result passed to a function. A method some
// subclass overrides dispatches and returns the tuple. Every shape must
// compute the same thing.

type V = (i32, i32);

function make(n: i32): V {
  return (n, n * 2);
}

function bump(p: V): V {
  return (p[0] + 1, p[1] + 1);
}

function use(p: V): i32 {
  return p[0] * 100 + p[1];
}

function twice(p: V): V {
  return bump(bump(p));
}

function chain(n: i32): i32 {
  let r = make(n);
  return use(r);
}

class Grid {
  scale: i32;
  new(this.scale);

  shift(p: V, by: i32): V {
    return (p[0] * this.scale + by, p[1] + by);
  }

  shiftTwice(p: V): V {
    return this.shift(this.shift(p, 1), 1);
  }

  area(p: V): i32 {
    return p[0] * p[1];
  }
}

function wrap(g: Grid, n: i32): V {
  return g.shift((n, n), 3);
}

class Shape {
  corner(n: i32): V {
    return (n, n);
  }
}

class Wide extends Shape {
  corner(n: i32): V {
    return (n * 10, n);
  }
}

export let main = (): i32 => {
  if (use(make(5)) != 510 || use(bump(make(1))) != 203) {
    return 0;
  }
  let t = twice((1, 2));
  if (t[0] != 3 || t[1] != 4) {
    return 0;
  }
  if (chain(5) != 510) {
    return 0;
  }
  let g = new Grid(2);
  let (x, y) = wrap(g, 4);
  if (x != 11 || y != 7) {
    return 0;
  }
  // (1, 1) -> (3, 2) -> (7, 3)
  let s = g.shiftTwice((1, 1));
  if (s[0] != 7 || s[1] != 3) {
    return 0;
  }
  if (g.area(g.shift((1, 1), 1)) != 6 || use(g.shift(make(2), 0)) != 404) {
    return 0;
  }
  let shapes = new GrowableArray<Shape>();
  shapes.push(new Shape());
  shapes.push(new Wide());
  var total = 0;
  for (let sh in shapes) {
    total = total * 10000 + use(sh.corner(3));
  }
  if (total != 3033003) {
    return 0;
  }
  return 1;
};
