// @mode: run
// @result: 1
// A callee that keeps, returns or captures its tuple parameter needs the
// tuple itself, so its parameter is not passed as elements. Those callees
// still compute the same thing when called with literals.

type Point = (i32, i32);

var kept: Point | null = null;

function keep(p: Point): i32 {
  kept = p;
  return p[0];
}

function identity(p: Point): Point {
  return p;
}

function later(p: Point): () => i32 {
  return () => p[0] + p[1];
}

function passOn(p: Point): i32 {
  return keep(p) + p[1];
}

export let main = (): i32 => {
  if (keep((1, 2)) != 1) {
    return 0;
  }
  let k = kept;
  if (k == null || k[1] != 2) {
    return 0;
  }
  if (identity((3, 4))[1] != 4) {
    return 0;
  }
  let f = later((5, 6));
  if (f() != 11) {
    return 0;
  }
  if (passOn((7, 8)) != 15) {
    return 0;
  }
  return 1;
};
