// @mode: run
// @result: 0
// `==` and `!=` on inline values compare slot by slot (#812): both
// operands in the inline one's layout, each slot with its own type's `==`,
// so neither side is boxed.

type Span = (i32, i32);

function same(a: inline Span, b: inline Span): boolean {
  return a == b;
}

function differs(a: inline Span): boolean {
  return a != (1, 2);
}

// A nested inline tuple, and a String compared by content.
function named(a: inline (String, inline (i32, i32))): boolean {
  return a == ('ab', (3, 4));
}

// A union: members differ by their literal, and a member's payload by
// its type's `==`.
type Reply = (true, i32) | (false, String);

function sameReply(a: inline Reply, b: inline Reply): boolean {
  return a == b;
}

// `is` tests the member's literal in its slot.
function isGood(r: inline Reply): boolean {
  return r is (true, i32);
}

function payload(r: inline Reply): i32 {
  if (r is (false, String)) {
    let (_, why) = r;
    return why.length;
  }
  return -1;
}

// An inline record compares by its fields.
type Point = {x: i32, y: i32};

function samePoint(p: inline Point, q: inline Point): boolean {
  return p == q;
}

function make(n: i32): inline Span {
  return (n, n + 1);
}

export let main = (): i32 => {
  var failures = 0;
  if (!same((1, 2), (1, 2)) || same((1, 2), (1, 3))) { failures += 1; }
  if (differs((1, 2)) || !differs((2, 1))) { failures += 2; }
  if (!named(('ab', (3, 4))) || named(('ab', (3, 5))) || named(('ba', (3, 4)))) {
    failures += 4;
  }
  if (!sameReply((true, 1), (true, 1)) || sameReply((true, 1), (true, 2))) { failures += 8; }
  if (sameReply((true, 1), (false, 'x')) || !sameReply((false, 'x'), (false, 'x'))) {
    failures += 16;
  }
  if (!samePoint({x: 1, y: 2}, {x: 1, y: 2}) || samePoint({x: 1, y: 2}, {x: 2, y: 1})) {
    failures += 32;
  }
  if (!isGood((true, 1)) || isGood((false, 'x'))) { failures += 128; }
  if (payload((false, 'abc')) != 3 || payload((true, 1)) != -1) { failures += 256; }
  // A boxed tuple and a call's inline result on either side.
  let stored: Span = (4, 5);
  if (!same(stored, make(4)) || make(1) != (1, 2)) { failures += 64; }
  return failures;
};
