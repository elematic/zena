// @mode: run
// @skip: a tuple element that converts from a class to an interface fails to lower with "call argument type" (#1132)
// @result: 4
// A tuple stands for a tuple whose element is an interface the
// element's class implements.

interface Named {
  name(): String;
}

class Bird implements Named {
  name(): String {
    return 'bird';
  }
}

function named(t: (Named, i32)): String {
  return t[0].name();
}

export let main = (): i32 => {
  let bird: (Bird, i32) = (new Bird(), 1);
  return named(bird).length;
};
