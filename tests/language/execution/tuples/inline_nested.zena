// @mode: run
// @skip: the checker rejects a nested inline tuple until codegen flattens its slots into the outer tuple's (#371)
// @result: 10
// `inline` nests inside an inline value: the inner tuple's slots are part of
// the outer one's, so nothing is allocated for either.

let nested = (n: i32): inline (i32, inline (i32, i32)) => (n, (n + 1, n + 2));

export let main = (): i32 => {
  let (a, (b, c)) = nested(2);
  return a + b + c + 1;
};
