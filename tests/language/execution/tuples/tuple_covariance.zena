// @mode: run
// @skip: a tuple of a subclass passed as a tuple of its superclass fails to lower with "call argument type" (#483)
// @result: 3
// The checker lets a tuple of a subclass stand for a tuple of its
// superclass, element by element.

class Animal {
  legs(): i32 {
    return 4;
  }
}

class Bird extends Animal {
  legs(): i32 {
    return 2;
  }
}

let count = (pair: (Animal, i32)): i32 => {
  let (animal, extra) = pair;
  return animal.legs() + extra;
};

export let main = (): i32 => {
  let bird: (Bird, i32) = (new Bird(), 1);
  return count(bird);
};
