// @mode: run
// @result: 0
// An inline union inside an inline tuple is distributed (#811):
// `inline (i32, inline Reply)` lays out as `inline (i32, (true, i32)) |
// (i32, (false, String))`, members sharing slots by path and type, each
// told apart by the nested union's own literal.

type Reply = (true, i32) | (false, String);

function make(n: i32, ok: boolean): inline (i32, inline Reply) {
  return if (ok) (n, (true, n * 2)) else (n, (false, 'no'));
}

// Patterns reach into the nested union.
function score(t: inline (i32, inline Reply)): i32 {
  return match (t) {
    case (let n, (true, let v)): n + v
    case (let n, (false, let why)): n * 100 + why.length
  };
}

// A name bound to the nested union holds it boxed.
function boxedInner(t: inline (i32, inline Reply)): i32 {
  let (n, r) = t;
  if (let (true, v) = r) {
    return n + v;
  }
  return -n;
}

// A nested union value forwarded into a nested position.
function relabel(n: i32, r: inline Reply): inline (i32, inline Reply) {
  return (n + 1, r);
}

// Two nested unions: four members.
function both(a: boolean, b: boolean): inline (inline Reply, inline Reply) {
  return (if (a) (true, 1) else (false, 'a'), if (b) (true, 2) else (false, 'bb'));
}

function sumBoth(t: inline (inline Reply, inline Reply)): i32 {
  return match (t) {
    case ((true, let x), (true, let y)): x + y
    case ((true, let x), (false, let s)): x * 10 + s.length
    case ((false, let s), (true, let y)): s.length * 10 + y
    case ((false, let s), (false, let u)): s.length * 100 + u.length
  };
}

export let main = (): i32 => {
  var failures = 0;
  if (score(make(3, true)) != 9 || score(make(3, false)) != 302) { failures += 1; }
  if (boxedInner(make(2, true)) != 6 || boxedInner(make(2, false)) != -2) { failures += 2; }
  if (score(relabel(1, (true, 5))) != 7 || score(relabel(1, (false, 'abc'))) != 203) {
    failures += 4;
  }
  if (sumBoth(both(true, true)) != 3 || sumBoth(both(true, false)) != 12 ||
      sumBoth(both(false, true)) != 12 || sumBoth(both(false, false)) != 102) {
    failures += 8;
  }
  // Stored: the boxed tuple holds the boxed union.
  let stored: (i32, Reply) = make(4, false);
  if (let (n, (false, why)) = stored) {
    if (n != 4 || why != 'no') { failures += 16; }
  } else {
    failures += 32;
  }
  if (score(stored) != 402) { failures += 64; }
  return failures;
};
