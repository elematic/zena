// @mode: run
// @result: 0
//
// What the coverage test cannot check.
//
// `all-instructions.zena` proves every instruction lowers and validates,
// and the opcode table is read back out of an assembled module, so a
// wrong NUMBER is not the risk. What is left is everything the operand
// shape decides: which argument reaches which wasm operand, where a lane
// immediate lands, and which end of a vector counts as lane zero. A
// swapped pair or an off-by-one lane still validates and still runs.
//
// Each check returns 0 when it holds and its own number when it does
// not, so a failure names itself.
import {
  v128Const, v128Load, v128Store, v128Load32Lane, v128Store32Lane,
  v128Not, v128AnyTrue, v128Bitselect,
  i8x16ExtractLaneU, i8x16ExtractLaneS, i8x16Shuffle, i8x16Swizzle,
  i8x16Splat, i8x16AllTrue,
  i16x8ExtendLowI8x16S, i16x8ExtendHighI8x16S,
  i32x4Splat, i32x4Add, i32x4Sub, i32x4Mul, i32x4Shl, i32x4ShrS, i32x4ShrU,
  i32x4ExtractLane, i32x4ReplaceLane, i32x4Bitmask, i32x4DotI16x8S,
  i64x2Splat, i64x2ExtractLane, i64x2ReplaceLane,
  f32x4Splat, f32x4Add, f32x4Sub, f32x4Div, f32x4ExtractLane,
  f64x2Splat, f64x2Div, f64x2ExtractLane, f64x2ReplaceLane,
} from 'zena:simd';
import {defaultAllocator} from 'zena:memory';

/** Bytes 0x00..0x0F in lane order, so every byte names its own index. */
let counting = (): v128 => v128Const(0x03020100, 0x07060504, 0x0B0A0908, 0x0F0E0D0C);

/** Bytes 0x10..0x1F, the second operand for shuffle and swizzle. */
let countingHigh = (): v128 => v128Const(0x13121110, 0x17161514, 0x1B1A1918, 0x1F1E1D1C);

export function main(): i32 {
  // 1. v128.const words land in lane order, low word first.
  let k = v128Const(10, 20, 30, 40);
  if (i32x4ExtractLane(k, 0) != 10) { return 1; }
  if (i32x4ExtractLane(k, 3) != 40) { return 2; }

  // 3. A splat reaches every lane; replace_lane changes exactly one.
  let r = i32x4ReplaceLane(i32x4Splat(7), 2, 99);
  if (i32x4ExtractLane(r, 2) != 99) { return 3; }
  if (i32x4ExtractLane(r, 0) != 7) { return 4; }
  if (i32x4ExtractLane(r, 3) != 7) { return 5; }

  // 6. Subtraction is not commutative: the first argument is the minuend.
  if (i32x4ExtractLane(i32x4Sub(i32x4Splat(10), i32x4Splat(3)), 0) != 7) { return 6; }
  if (i32x4ExtractLane(i32x4Add(i32x4Splat(10), i32x4Splat(3)), 0) != 13) { return 7; }
  if (i32x4ExtractLane(i32x4Mul(i32x4Splat(10), i32x4Splat(3)), 0) != 30) { return 8; }

  // 9. A shift takes the vector first and the count second — swapping
  // them would still be a (v128, i32) pair and still validate.
  if (i32x4ExtractLane(i32x4Shl(i32x4Splat(1), 4), 0) != 16) { return 9; }
  if (i32x4ExtractLane(i32x4ShrS(i32x4Splat(-16), 2), 0) != -4) { return 10; }
  if (i32x4ExtractLane(i32x4ShrU(i32x4Splat(-1), 28), 0) != 15) { return 11; }

  // 12. Byte lane 0 is the LOW byte of word 0: little-endian, and the
  // 16-lane immediate really does reach 15.
  let c = counting();
  if (i8x16ExtractLaneU(c, 0) != 0) { return 12; }
  if (i8x16ExtractLaneU(c, 5) != 5) { return 13; }
  if (i8x16ExtractLaneU(c, 15) != 15) { return 14; }
  // Signed extraction sign-extends; 0x8F in lane 0 reads as -113.
  if (i8x16ExtractLaneS(i8x16Splat(0x8F), 0) != -113) { return 15; }

  // 16. Shuffle selectors index the two operands end to end: 0..15 is
  // the first, 16..31 the second.
  let s = i8x16Shuffle(c, countingHigh(),
      16, 17, 18, 19, 0, 1, 2, 3, 20, 21, 22, 23, 4, 5, 6, 7);
  if (i32x4ExtractLane(s, 0) != 0x13121110) { return 16; }
  if (i32x4ExtractLane(s, 1) != 0x03020100) { return 17; }
  if (i32x4ExtractLane(s, 3) != 0x07060504) { return 18; }

  // 19. Swizzle takes the data first and the indices second.
  let sw = i8x16Swizzle(c, i8x16Splat(9));
  if (i8x16ExtractLaneU(sw, 0) != 9) { return 19; }

  // 20. low vs high halves of an extend are not interchangeable.
  let lo = i16x8ExtendLowI8x16S(c);
  let hi = i16x8ExtendHighI8x16S(c);
  if (i32x4ExtractLane(lo, 0) != 0x00010000) { return 20; }
  if (i32x4ExtractLane(hi, 0) != 0x00090008) { return 21; }

  // 22. bitmask reads one bit per lane, lane 0 in the low bit.
  let mask = i32x4ReplaceLane(i32x4ReplaceLane(i32x4Splat(0), 0, -1), 2, -1);
  if (i32x4Bitmask(mask) != 5) { return 22; }
  if (v128AnyTrue(mask) != 1) { return 23; }
  if (i8x16AllTrue(i8x16Splat(1)) != 1) { return 24; }
  if (i8x16AllTrue(mask) != 0) { return 25; }

  // 26. bitselect takes (ifTrue, ifFalse, selector) in that order.
  let sel = v128Bitselect(i32x4Splat(0xAAAAAAAA), i32x4Splat(0x55555555),
      i32x4ReplaceLane(i32x4Splat(0), 0, -1));
  if (i32x4ExtractLane(sel, 0) != 0xAAAAAAAA) { return 26; }
  if (i32x4ExtractLane(sel, 1) != 0x55555555) { return 27; }

  // 28. Two-lane shapes index 0 and 1, and carry a full 64 bits.
  let big = i64x2ReplaceLane(i64x2Splat(0 as i64), 1, 0x1122334455667788 as i64);
  if (i64x2ExtractLane(big, 1) != (0x1122334455667788 as i64)) { return 28; }
  if (i64x2ExtractLane(big, 0) != (0 as i64)) { return 29; }

  // 30. Floats are floats, not reinterpreted ints, and division picks
  // the right dividend.
  if (f32x4ExtractLane(f32x4Add(f32x4Splat(1.5 as f32), f32x4Splat(2.25 as f32)), 0)
      != (3.75 as f32)) { return 30; }
  if (f32x4ExtractLane(f32x4Sub(f32x4Splat(1.0 as f32), f32x4Splat(4.0 as f32)), 0)
      != (-3.0 as f32)) { return 31; }
  if (f32x4ExtractLane(f32x4Div(f32x4Splat(3.0 as f32), f32x4Splat(4.0 as f32)), 0)
      != (0.75 as f32)) { return 32; }
  if (f64x2ExtractLane(f64x2Div(f64x2Splat(3.0), f64x2Splat(4.0)), 0) != 0.75) { return 33; }
  if (f64x2ExtractLane(f64x2ReplaceLane(f64x2Splat(0.0), 1, 2.5), 1) != 2.5) { return 34; }

  // 35. dot_i16x8_s multiplies 16-bit lanes pairwise and adds adjacent
  // pairs into 32-bit lanes: two lanes of 3 against two of 4 make 24.
  if (i32x4ExtractLane(i32x4DotI16x8S(i32x4Splat(0x00030003), i32x4Splat(0x00040004)), 0)
      != 24) { return 35; }

  // 36. v128.not flips every bit.
  if (i32x4ExtractLane(v128Not(i32x4Splat(0)), 0) != -1) { return 36; }

  // 37. Memory: a store then a load is the identity, the address is the
  // first argument, and the lane forms touch exactly one lane.
  var buf = -1;
  if (let (true, ptr) = defaultAllocator.allocAligned(64, 16)) {
    buf = ptr;
  } else {
    return 37;
  }
  v128Store(buf, k);
  let back = v128Load(buf);
  if (i32x4ExtractLane(back, 0) != 10) { return 38; }
  if (i32x4ExtractLane(back, 3) != 40) { return 39; }

  // The buffer still holds `k`, so loading its first word into lane 2
  // must land 10 there and leave the other lanes alone.
  let lane = v128Load32Lane(buf, i32x4Splat(-1), 2);
  if (i32x4ExtractLane(lane, 2) != 10) { return 40; }
  if (i32x4ExtractLane(lane, 1) != -1) { return 41; }

  // Storing lane 3 of `k` writes 40 over the first word.
  v128Store32Lane(buf, k, 3);
  if (i32x4ExtractLane(v128Load(buf), 0) != 40) { return 42; }

  return 0;
}
