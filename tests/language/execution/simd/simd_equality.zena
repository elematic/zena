// @mode: run
// @result: 0

import { i32x4Splat, v128Const } from 'zena:simd';
import { GrowableArray } from 'zena:growable-array';

export function main(): i32 {
  let a = i32x4Splat(42);
  let b = i32x4Splat(42);
  let c = i32x4Splat(100);
  let d = v128Const(1, 2, 3, 4);
  let e = v128Const(1, 2, 3, 4);
  let f = v128Const(1, 2, 3, 5);

  // Equal vectors
  if (!(a == b)) { return 1; }
  if (a != b) { return 2; }

  // Unequal vectors (splat vs splat)
  if (a == c) { return 3; }
  if (!(a != c)) { return 4; }

  // Equal vectors (lane-distinct)
  if (!(d == e)) { return 5; }
  if (d != e) { return 6; }

  // Unequal vectors (lane-distinct)
  if (d == f) { return 7; }
  if (!(d != f)) { return 8; }

  // GrowableArray.contains with v128
  let list = new GrowableArray<v128>();
  list.push(a);
  list.push(d);

  if (!list.contains(b)) { return 9; }
  if (!list.contains(e)) { return 10; }
  if (list.contains(c)) { return 11; }
  if (list.contains(f)) { return 12; }

  return 0;
}

