{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch-vscode-extension",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build", "-w", "vscode-zena"],
      "options": {
        "env": {
          "WIREIT_LOGGER": "simple",
          "npm_config_watch": "true"
        }
      },
      "problemMatcher": [
        {
          "base": "$tsc",
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Running command",
            "endsPattern": "Watching for file changes"
          }
        }
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
