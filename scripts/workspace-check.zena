/**
 * Compiled, never run, by the root `check:workspace` script: once by the
 * checked-in bootstrap and once by stage A.
 *
 * Every compile reads all of the workspace's `zena-package.json` manifests
 * (`loadWorkspace`), and fails when one cannot be read: malformed JSON, a
 * missing manifest, two packages with one name. A compile's output depends
 * only on the manifests of the packages it reaches, though, so each wireit
 * script lists only those, and an edit to another package's manifest leaves
 * it fresh. This file imports nothing, so compiling it tests exactly what
 * those scripts leave out: that the workspace as a whole loads, with the
 * bootstrap that builds stage A and with the compiler everything else runs.
 */
export function main(): i32 {
  return 0;
}
