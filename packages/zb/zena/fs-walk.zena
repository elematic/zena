import {FileType, exists, isFile, listDir, readFileBytes} from 'zena:fs';
import { HashSet } from 'zena:collections';
import {compareStrings, sortBy} from 'workflow:canonical';
import {Fingerprint} from 'workflow:fingerprint';
import {StringBuilder} from 'zena:core';
import {GlobSet, hasMagic} from 'zena:glob';
import {isAbsolute} from 'zena:path';
import {joinWorkspace, withRoot} from './fs-util.zena';
import {sha256Hex} from './sha256.zena';
import {ConfigError} from './wireit-config.zena';

/**
 * A pattern split at its first segment with glob syntax in it: the
 * literal directory prefix to walk from, and the pattern for paths
 * relative to it. A fully literal pattern splits into its directory and
 * file name. `''` is the workspace root.
 */
export class GlobBase(base: String, rest: String)

export let splitBase = (pattern: String): GlobBase => {
  let segments = pattern.split('/');
  var literal = 0;
  while (literal < segments.length && !hasMagic(segments[literal])) {
    literal += 1;
  }
  if (literal == segments.length) {
    // Fully literal: the last segment is the file name.
    literal = segments.length - 1;
  }
  let base = new StringBuilder();
  for (var i = 0; i < literal; i += 1) {
    if (i > 0) {
      base.append('/');
    }
    base.append(segments[i]);
  }
  let rest = new StringBuilder();
  for (var i = literal; i < segments.length; i += 1) {
    if (i > literal) {
      rest.append('/');
    }
    rest.append(segments[i]);
  }
  return new GlobBase(base.toString(), rest.toString());
};

/** Directories never worth walking for build inputs or outputs. */
let skipDir = (name: String): boolean => {
  return name == 'node_modules' || name == '.git' || name == '.wireit' ||
    name == '.zb' || name == 'target';
};

let collectFiles = (
  root: String,
  dir: String,
  set: GlobSet,
  out: GrowableArray<String>,
  seen: HashSet<String>,
): void => {
  let full = withRoot(root, dir);
  if (!exists(full)) {
    return;
  }
  if (isFile(full)) {
    if (set.matches(dir) && seen.add(dir)) {
      out.push(dir);
    }
    return;
  }
  for (let entry in listDir(full)) {
    if (entry.name == '.' || entry.name == '..') {
      continue;
    }
    if (entry.fileType == FileType.Directory) {
      if (!skipDir(entry.name)) {
        collectFiles(root, joinWorkspace(dir, entry.name), set, out, seen);
      }
    } else {
      let path = joinWorkspace(dir, entry.name);
      if (set.matches(path) && seen.add(path)) {
        out.push(path);
      }
    }
  }
};

/**
 * Expands a package's glob list to sorted workspace-relative file
 * paths. Patterns are interpreted relative to `packageDir` and may
 * reach sibling packages with '../'; escaping the workspace, by climbing
 * out of it or by naming an absolute path, is an error. Negations apply
 * across the whole list in order.
 */
export let expandGlobs = (
  root: String,
  packageDir: String,
  globs: Array<String>,
): Array<String> => {
  let rewritten = new GrowableArray<String>();
  let bases = new GrowableArray<String>();
  let seenBases = new HashSet<String>();
  for (let raw in globs) {
    var pattern = raw;
    var negated = false;
    if (pattern.startsWith('!')) {
      negated = true;
      pattern = pattern.sliceBytes(1, pattern.length);
    }
    let workspaceRelative = joinWorkspace(packageDir, pattern);
    if (workspaceRelative.startsWith('..') || isAbsolute(workspaceRelative)) {
      throw new ConfigError(
        `glob "${raw}" in ${packageDir} escapes the workspace`,
      );
    }
    rewritten.push(if (negated) '!' + workspaceRelative else workspaceRelative);
    if (!negated) {
      let base = splitBase(workspaceRelative).base;
      if (seenBases.add(base)) {
        bases.push(base);
      }
    }
  }
  let set = new GlobSet(rewritten);
  let out = new GrowableArray<String>();
  let seen = new HashSet<String>();
  for (let base in bases) {
    collectFiles(root, base, set, out, seen);
  }
  sortBy(out, (a: String, b: String) => compareStrings(a, b));
  return out;
};

/** The content fingerprint zb uses everywhere: 'sha256:<hex>'. */
export let hashFile = (root: String, path: String): Fingerprint => {
  return new Fingerprint('sha256:' + sha256Hex(readFileBytes(withRoot(root, path))));
};

/** Hashes files into the snapshot map, skipping already-hashed paths. */
export let hashFilesInto = (
  root: String,
  files: Array<String>,
  into: HashMap<String, Fingerprint>,
): void => {
  for (let path in files) {
    if (!into.has(path)) {
      into[path] = hashFile(root, path);
    }
  }
};
