import {Future} from 'zena:async';
import {getArguments} from 'zena:cli';
import {BuildOutcome, buildTarget, reportBuild} from './runner.zena';
import {ScriptRef} from './wireit-config.zena';

/**
 * zb: a wireit-compatible incremental build runner.
 *
 *     zb [-C <workspace-root>] [-j <jobs>] <script>
 *     zb [-C <workspace-root>] [-j <jobs>] <package-dir> <script>
 *
 * The workspace root defaults to the current directory; -C points at a
 * nested workspace (a directory with its own package.json tree).
 */
let usage =
  'usage: zb [-C <workspace-root>] [-j <jobs>] [-f|--force] [--no-cache] [<package-dir>] <script>';

export async function main(): Future<i32> {
  let args = getArguments();
  var root = '';
  var jobs = 0;
  var force = false;
  var useCache = true;
  var next = 1;
  while (next < args.length && args[next].startsWith('-')) {
    let flag = args[next];
    if (flag == '-C') {
      if (next + 1 >= args.length) {
        console.log(usage);
        return 2;
      }
      root = args[next + 1];
      next += 2;
    } else if (flag == '-j' || flag == '--jobs') {
      if (next + 1 >= args.length) {
        console.log(usage);
        return 2;
      }
      if (let (true, n) = parseI32(args[next + 1])) {
        if (n >= 1) {
          jobs = n;
          next += 2;
          continue;
        }
      }
      console.log(`zb: invalid job count "${args[next + 1]}"`);
      return 2;
    } else if (flag == '-f' || flag == '--force') {
      force = true;
      next += 1;
    } else if (flag == '--no-cache') {
      useCache = false;
      next += 1;
    } else {
      console.log(usage);
      return 2;
    }
  }
  let rest = args.length - next;
  if (rest < 1 || rest > 2) {
    console.log(usage);
    return 2;
  }
  let entry = if (rest == 1)
    new ScriptRef('', args[next])
  else
    new ScriptRef(args[next], args[next + 1]);

  var outcome: BuildOutcome | null = null;
  try {
    outcome = await buildTarget(root, entry, jobs, force, useCache);
  } catch (e) {
    console.log('zb: ' + e.message);
    return 1;
  }
  if (outcome == null) {
    return 1;
  }
  return reportBuild(outcome);
}
