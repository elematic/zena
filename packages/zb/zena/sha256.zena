import {newByteArray} from 'zena:byte-array';
import {StringBuilder} from 'zena:string-builder';

/**
 * SHA-256, used for content fingerprints. Pure Zena; the stdlib has no
 * digest module. Verified against the FIPS 180-4 test vectors in
 * sha256_test.zena.
 */

// Casts cannot appear as binary operands, so they are wrapped in
// helper calls throughout.
let u = (x: i32): u32 => x as u32;
let ub = (x: u8): u32 => x as u32;
let b8 = (x: i32): u8 => x as u8;
let toI64 = (x: i32): i64 => x as i64;
let byteOf = (x: u32, shift: i32): u8 => ((x >>> u(shift)) & u(0xff)) as u8;
let i64Low8 = (x: i64): u8 => (x & 0xff) as u8;

let parseHexWords = (hex: String, count: i32): FixedArray<u32> => {
  let words = new FixedArray<u32>(count, u(0));
  var word = u(0);
  var digits = 0;
  var index = 0;
  for (var i = 0; i < hex.length; i += 1) {
    let b = hex.getByteAt(i);
    var value = -1;
    if (b >= 48 && b <= 57) {
      value = b - 48;
    }
    if (b >= 97 && b <= 102) {
      value = b - 87;
    }
    if (value >= 0) {
      word = (word << u(4)) | u(value);
      digits += 1;
      if (digits == 8) {
        words[index] = word;
        index += 1;
        word = u(0);
        digits = 0;
      }
    }
  }
  return words;
};

let roundConstants = parseHexWords(
  '428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5 ' +
  'd807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174 ' +
  'e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da ' +
  '983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967 ' +
  '27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85 ' +
  'a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070 ' +
  '19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3 ' +
  '748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2',
  64,
);

let initialState = parseHexWords(
  '6a09e667 bb67ae85 3c6ef372 a54ff53a 510e527f 9b05688c 1f83d9ab 5be0cd19',
  8,
);

let allOnes = parseHexWords('ffffffff', 1)[0];

let rotr = (x: u32, n: i32): u32 => (x >>> u(n)) | (x << u(32 - n));

/** The 32-byte SHA-256 digest of `data`. */
export let sha256 = (data: ByteArray): ByteArray => {
  let len = data.length;
  // Padded to a multiple of 64 bytes: data, 0x80, zeros, then the
  // 8-byte big-endian bit length.
  var paddedLen = len + 9;
  if (paddedLen % 64 != 0) {
    paddedLen += 64 - paddedLen % 64;
  }
  let padded = newByteArray(paddedLen);
  for (var i = 0; i < len; i += 1) {
    padded[i] = data[i];
  }
  padded[len] = b8(0x80);
  let bitLen = toI64(len) * 8;
  for (var i = 0; i < 8; i += 1) {
    padded[paddedLen - 1 - i] = i64Low8(bitLen >> toI64(8 * i));
  }

  let h = new FixedArray<u32>(8, u(0));
  for (var i = 0; i < 8; i += 1) {
    h[i] = initialState[i];
  }
  let w = new FixedArray<u32>(64, u(0));

  for (var block = 0; block < paddedLen; block += 64) {
    for (var t = 0; t < 16; t += 1) {
      let base = block + t * 4;
      w[t] = (ub(padded[base]) << u(24)) |
        (ub(padded[base + 1]) << u(16)) |
        (ub(padded[base + 2]) << u(8)) |
        ub(padded[base + 3]);
    }
    for (var t = 16; t < 64; t += 1) {
      let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >>> u(3));
      let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >>> u(10));
      w[t] = w[t - 16] + s0 + w[t - 7] + s1;
    }

    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    var e = h[4];
    var f = h[5];
    var g = h[6];
    var hh = h[7];

    for (var t = 0; t < 64; t += 1) {
      let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      let ch = (e & f) ^ ((e ^ allOnes) & g);
      let temp1 = hh + s1 + ch + roundConstants[t] + w[t];
      let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      let maj = (a & b) ^ (a & c) ^ (b & c);
      let temp2 = s0 + maj;
      hh = g;
      g = f;
      f = e;
      e = d + temp1;
      d = c;
      c = b;
      b = a;
      a = temp1 + temp2;
    }

    h[0] = h[0] + a;
    h[1] = h[1] + b;
    h[2] = h[2] + c;
    h[3] = h[3] + d;
    h[4] = h[4] + e;
    h[5] = h[5] + f;
    h[6] = h[6] + g;
    h[7] = h[7] + hh;
  }

  let digest = newByteArray(32);
  for (var i = 0; i < 8; i += 1) {
    let word = h[i];
    digest[i * 4] = byteOf(word, 24);
    digest[i * 4 + 1] = byteOf(word, 16);
    digest[i * 4 + 2] = byteOf(word, 8);
    digest[i * 4 + 3] = byteOf(word, 0);
  }
  return digest;
};

let hexDigits = '0123456789abcdef';

export let toHex = (bytes: ByteArray): String => {
  let sb = new StringBuilder(bytes.length * 2);
  for (var i = 0; i < bytes.length; i += 1) {
    let b = bytes[i] as i32;
    sb.appendByte(hexDigits.getByteAt((b >> 4) & 0xf));
    sb.appendByte(hexDigits.getByteAt(b & 0xf));
  }
  return sb.toString();
};

/** The digest as a lowercase hex string. */
export let sha256Hex = (data: ByteArray): String => toHex(sha256(data));

/** The digest of a string's bytes as a lowercase hex string. */
export let sha256HexOfString = (s: String): String => {
  let bytes = newByteArray(s.length);
  for (var i = 0; i < s.length; i += 1) {
    bytes[i] = b8(s.getByteAt(i));
  }
  return sha256Hex(bytes);
};
