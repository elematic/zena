import {suite, test} from 'zena:test';
import {equal, throws} from 'zena:assert';
import {writeFileSync} from 'zena:fs';
import {monotonic} from 'zena:time';
import {ensureDirSync, ensureParentDirSync, withRoot} from '../fs-util.zena';
import {expandGlobsSync} from '../fs-walk.zena';

export let tests = suite('fs-walk', () => {
  test('a glob may not leave the workspace', () => {
    // Both are refused before anything is walked, so no fixture is
    // needed.
    throws(() => {
      expandGlobsSync('.', 'packages/app', ['../../../outside/**']);
    });
    // An absolute glob names a path outside the workspace just as
    // surely; it used to be glued onto the package directory instead.
    throws(() => {
      expandGlobsSync('.', 'packages/app', ['/etc/**']);
    });
  });

  test('literal file patterns resolve directly at root and subpaths', () => {
    let root = '/tmp/zb-fswalk-' + i64ToString(monotonic() as i64);
    ensureDirSync(root);
    let rootManifest = withRoot(root, 'zena-package.json');
    ensureParentDirSync(rootManifest);
    writeFileSync(rootManifest, '{}\n');
    let sibling = withRoot(root, 'packages/other/ignore.txt');
    ensureParentDirSync(sibling);
    writeFileSync(sibling, 'unused\n');
    let local = withRoot(root, 'packages/app/local.txt');
    ensureParentDirSync(local);
    writeFileSync(local, 'ok\n');

    let matched = expandGlobsSync(root, 'packages/app', [
      '../../zena-package.json',
      'local.txt',
      'missing.txt',
    ]);
    equal(matched.length, 2);
    equal(matched[0], 'packages/app/local.txt');
    equal(matched[1], 'zena-package.json');
  });
});
