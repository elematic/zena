import {suite, test} from 'zena:test';
import {equal, fail, isFalse, isTrue} from 'zena:assert';
import {runFuture} from 'zena:async';
import {readFileSync, unlinkSync, writeFileSync} from 'zena:fs';
import {milliseconds, monotonic, sleep} from 'zena:time';
import {
  Failed,
  RunResult,
  StepSource,
  Succeeded,
} from 'workflow:engine';
import {StepKey} from 'workflow:step';
import {ensureDirSync, ensureParentDirSync, withRoot} from '../fs-util.zena';
import {FileHasher} from '../fs-walk.zena';
import {buildTarget} from '../runner.zena';
import {ScriptRef} from '../wireit-config.zena';

/**
 * End-to-end build of a two-package fixture workspace created under
 * /tmp (preopened by the test runner). Commands run through `sh`.
 */

function write(root: String, path: String, content: String) {
  let full = withRoot(root, path);
  ensureParentDirSync(full);
  writeFileSync(full, content);
}

function mkFixture(root: String) {
  ensureDirSync(root);
  write(root, 'package.json', `{
    "scripts": {"build": "wireit"},
    "wireit": {
      "build": {"dependencies": ["./packages/app:build"]}
    }
  }`);
  write(root, 'packages/lib/package.json', `{
    "scripts": {"build": "wireit"},
    "wireit": {
      "build": {
        "command": "mkdir -p out && cat src/in.txt > out/lib.txt",
        "files": ["src/**"],
        "output": ["out/**"]
      }
    }
  }`);
  write(root, 'packages/lib/src/in.txt', 'lib-v1\n');
  write(root, 'packages/app/package.json', `{
    "scripts": {"build": "wireit"},
    "wireit": {
      "build": {
        "command": "mkdir -p out && cat ../lib/out/lib.txt greeting.txt > out/app.txt",
        "files": ["greeting.txt"],
        "output": ["out/**"],
        "dependencies": ["../lib:build"]
      }
    }
  }`);
  write(root, 'packages/app/greeting.txt', 'hello-v1\n');
}

function sourceOf(result: RunResult, key: String): StepSource {
  let outcome = result.outcomeOf(new StepKey(key));
  if (outcome is Succeeded) {
    return outcome.source;
  }
  fail('step did not succeed: ' + key);
}

export let tests = suite('zb end to end', () => {
  test('build, rebuild fresh, incremental change, cache restore', () => {
    let root = '/tmp/zb-e2e-' + i64ToString(monotonic() as i64);
    mkFixture(root);
    let entry = new ScriptRef('', 'build');

    // First build runs everything.
    let first = buildTarget(root, entry);
    isTrue(first.result.allSucceeded);
    isTrue(sourceOf(first.result, 'packages/lib:build') == StepSource.Ran);
    isTrue(sourceOf(first.result, 'packages/app:build') == StepSource.Ran);
    equal(readFileSync(withRoot(root, 'packages/app/out/app.txt')), 'lib-v1\nhello-v1\n');

    // An identical second build is fully fresh.
    let second = buildTarget(root, entry);
    isTrue(second.result.allSucceeded);
    isTrue(sourceOf(second.result, 'packages/lib:build') == StepSource.Fresh);
    isTrue(sourceOf(second.result, 'packages/app:build') == StepSource.Fresh);

    // Changing app's input reruns app but not lib.
    write(root, 'packages/app/greeting.txt', 'hello-v2\n');
    let third = buildTarget(root, entry);
    isTrue(third.result.allSucceeded);
    isTrue(sourceOf(third.result, 'packages/lib:build') == StepSource.Fresh);
    isTrue(sourceOf(third.result, 'packages/app:build') == StepSource.Ran);
    equal(readFileSync(withRoot(root, 'packages/app/out/app.txt')), 'lib-v1\nhello-v2\n');

    // Losing the state files falls back to the cache, not to running.
    unlinkSync(withRoot(root, 'packages/lib/.zb/state.json'));
    unlinkSync(withRoot(root, 'packages/app/.zb/state.json'));
    let fourth = buildTarget(root, entry);
    isTrue(fourth.result.allSucceeded);
    isTrue(sourceOf(fourth.result, 'packages/lib:build') == StepSource.Cache);
    isTrue(sourceOf(fourth.result, 'packages/app:build') == StepSource.Cache);
    equal(readFileSync(withRoot(root, 'packages/app/out/app.txt')), 'lib-v1\nhello-v2\n');

    // A dependency change propagates: lib reruns, then app.
    write(root, 'packages/lib/src/in.txt', 'lib-v2\n');
    let fifth = buildTarget(root, entry);
    isTrue(fifth.result.allSucceeded);
    isTrue(sourceOf(fifth.result, 'packages/lib:build') == StepSource.Ran);
    isTrue(sourceOf(fifth.result, 'packages/app:build') == StepSource.Ran);
    equal(readFileSync(withRoot(root, 'packages/app/out/app.txt')), 'lib-v2\nhello-v2\n');
  });

  test('untracked scripts always run and poison dependents', () => {
    let root = '/tmp/zb-untracked-' + i64ToString(monotonic() as i64);
    write(root, 'package.json', `{
      "scripts": {"all": "wireit"},
      "wireit": {
        "all": {"dependencies": ["./use:build", "./steady:build"]}
      }
    }`);
    // A command with output but no files key: inputs unknown.
    write(root, 'gen/package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "command": "mkdir -p out && echo generated > out/g.txt",
          "output": ["out/**"]
        }
      }
    }`);
    // Fully tracked, but downstream of the untracked script.
    write(root, 'use/package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "command": "mkdir -p out && cat ../gen/out/g.txt > out/u.txt",
          "files": [],
          "output": ["out/**"],
          "dependencies": ["../gen:build"]
        }
      }
    }`);
    // Fully tracked control, with declared-empty files and output.
    write(root, 'steady/package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {"command": "true", "files": [], "output": []}
      }
    }`);
    let entry = new ScriptRef('', 'all');

    let first = buildTarget(root, entry);
    isTrue(first.result.allSucceeded);

    let second = buildTarget(root, entry);
    isTrue(second.result.allSucceeded);
    isTrue(sourceOf(second.result, 'gen:build') == StepSource.Ran);
    isTrue(sourceOf(second.result, 'use:build') == StepSource.Ran);
    isTrue(sourceOf(second.result, 'steady:build') == StepSource.Fresh);
  });

  test('independent scripts run concurrently and -j 1 serializes them', () => {
    let root = '/tmp/zb-parallel-' + i64ToString(monotonic() as i64);
    ensureDirSync(root);
    // Two independent scripts write their own start marker and wait up
    // to ~2s for the peer's marker: they succeed iff both are in flight
    // at the same time.
    write(root, 'package.json', `{
      "scripts": {"both": "wireit", "a": "wireit", "b": "wireit"},
      "wireit": {
        "both": {"dependencies": ["a", "b"]},
        "a": {
          "command": "touch a.started; i=0; while [ ! -f b.started ] && [ $i -lt 100 ]; do sleep 0.02; i=$((i+1)); done; [ -f b.started ]",
          "files": [],
          "output": ["a.started"]
        },
        "b": {
          "command": "touch b.started; i=0; while [ ! -f a.started ] && [ $i -lt 100 ]; do sleep 0.02; i=$((i+1)); done; [ -f a.started ]",
          "files": [],
          "output": ["b.started"]
        }
      }
    }`);
    let entry = new ScriptRef('', 'both');

    let parallel = buildTarget(root, entry, 2);
    isTrue(parallel.result.allSucceeded, 'a and b should overlap under -j 2');

    // Under -j 1 on a fresh workspace, independent scripts never overlap:
    // whichever acquires the single permit first finishes before the other starts.
    let serialRoot = '/tmp/zb-serial-' + i64ToString(monotonic() as i64);
    ensureDirSync(serialRoot);
    write(serialRoot, 'package.json', `{
      "scripts": {"both": "wireit", "a": "wireit", "b": "wireit"},
      "wireit": {
        "both": {"dependencies": ["a", "b"]},
        "a": {
          "command": "echo a-start >> order.log; sleep 0.08; echo a-end >> order.log; touch a.started",
          "files": [],
          "output": ["a.started"]
        },
        "b": {
          "command": "echo b-start >> order.log; sleep 0.08; echo b-end >> order.log; touch b.started",
          "files": [],
          "output": ["b.started"]
        }
      }
    }`);
    let serial = buildTarget(serialRoot, entry, 1);
    isTrue(serial.result.allSucceeded, 'serial build under -j 1 should succeed');
    let orderLog = readFileSync(withRoot(serialRoot, 'order.log'));
    isTrue(
      orderLog == 'a-start\na-end\nb-start\nb-end\n' ||
      orderLog == 'b-start\nb-end\na-start\na-end\n',
      'a and b should not interleave under -j 1, got: ' + orderLog,
    );
    isFalse(sourceOf(serial.result, ':a') == StepSource.Fresh);
  });

  test('services wait for readyWhen.lineMatches, share across dependents, skip when fresh, and tear down process groups', () => {
    let root = '/tmp/zb-service-' + i64ToString(monotonic() as i64);
    ensureDirSync(root);
    write(root, 'svc.cfg', 'port=8080\n');
    write(root, 'package.json', `{
      "scripts": {"all": "wireit", "svc": "wireit", "a": "wireit", "b": "wireit"},
      "wireit": {
        "all": {"dependencies": ["a", "b"]},
        "svc": {
          "command": "echo start >> svc.starts; sleep 30 & sleep 0.05; touch svc.ready; echo 'booting...'; echo 'Server ready on 8080'; wait",
          "service": {"readyWhen": {"lineMatches": "ready on [0-9]+"}},
          "files": ["svc.cfg"]
        },
        "a": {
          "command": "[ -f svc.ready ] && cat svc.cfg > a.out",
          "files": [],
          "output": ["a.out"],
          "dependencies": ["svc"]
        },
        "b": {
          "command": "[ -f svc.ready ] && cat svc.cfg > b.out",
          "files": [],
          "output": ["b.out"],
          "dependencies": ["svc"]
        }
      }
    }`);
    let entry = new ScriptRef('', 'all');

    let first = buildTarget(root, entry, 2);
    isTrue(first.result.allSucceeded, 'first build with shared service succeeds');
    isTrue(sourceOf(first.result, ':svc') == StepSource.Ran);
    isTrue(sourceOf(first.result, ':a') == StepSource.Ran);
    isTrue(sourceOf(first.result, ':b') == StepSource.Ran);
    equal(readFileSync(withRoot(root, 'svc.starts')), 'start\n');
    equal(readFileSync(withRoot(root, 'a.out')), 'port=8080\n');
    equal(readFileSync(withRoot(root, 'b.out')), 'port=8080\n');

    // Second build: dependents are fresh, so the service never starts.
    let second = buildTarget(root, entry, 2);
    isTrue(second.result.allSucceeded);
    isTrue(sourceOf(second.result, ':svc') == StepSource.Fresh);
    isTrue(sourceOf(second.result, ':a') == StepSource.Fresh);
    isTrue(sourceOf(second.result, ':b') == StepSource.Fresh);
    equal(readFileSync(withRoot(root, 'svc.starts')), 'start\n');

    // Changing the service's declared file invalidates dependents and restarts it.
    write(root, 'svc.cfg', 'port=9090\n');
    let third = buildTarget(root, entry, 2);
    isTrue(third.result.allSucceeded);
    isTrue(sourceOf(third.result, ':svc') == StepSource.Ran);
    isTrue(sourceOf(third.result, ':a') == StepSource.Ran);
    equal(readFileSync(withRoot(root, 'svc.starts')), 'start\nstart\n');
    equal(readFileSync(withRoot(root, 'a.out')), 'port=9090\n');
  });

  test('services fail loudly when exiting before readyWhen or crashing mid-run', () => {
    // 1. Exits before readyWhen.lineMatches ever matches.
    let earlyEofRoot = '/tmp/zb-svc-eof-' + i64ToString(monotonic() as i64);
    ensureDirSync(earlyEofRoot);
    write(earlyEofRoot, 'package.json', `{
      "scripts": {"all": "wireit", "svc": "wireit", "app": "wireit", "ok": "wireit"},
      "wireit": {
        "all": {"dependencies": ["app", "ok"]},
        "svc": {
          "command": "echo 'starting...'; exit 1",
          "service": {"readyWhen": {"lineMatches": "never-printed"}},
          "files": []
        },
        "app": {
          "command": "echo ran > app.out",
          "files": [],
          "output": ["app.out"],
          "dependencies": ["svc"]
        },
        "ok": {
          "command": "echo fine > ok.out",
          "files": [],
          "output": ["ok.out"]
        }
      }
    }`);
    let eofRun = buildTarget(earlyEofRoot, new ScriptRef('', 'all'));
    isFalse(eofRun.result.allSucceeded);
    isTrue(eofRun.result.outcomeOf(new StepKey(':svc')) is Failed);
    isTrue(eofRun.result.outcomeOf(new StepKey(':app')) is Failed);
    isTrue(eofRun.result.outcomeOf(new StepKey(':ok')) is Succeeded);

    // 2. service: true crashes while its dependent is running.
    let crashRoot = '/tmp/zb-svc-crash-' + i64ToString(monotonic() as i64);
    ensureDirSync(crashRoot);
    write(crashRoot, 'package.json', `{
      "scripts": {"app": "wireit", "svc": "wireit"},
      "wireit": {
        "svc": {
          "command": "sleep 0.02; exit 2",
          "service": true,
          "files": []
        },
        "app": {
          "command": "sleep 0.15; touch app.out",
          "files": [],
          "output": ["app.out"],
          "dependencies": ["svc"]
        }
      }
    }`);
    let crashRun = buildTarget(crashRoot, new ScriptRef('', 'app'));
    isFalse(crashRun.result.allSucceeded);
    isTrue(crashRun.result.outcomeOf(new StepKey(':svc')) is Failed);
  });

  test('invoking a service as the top-level target runs its dependencies and executes it in the foreground', () => {
    let root = '/tmp/zb-svc-fg-' + i64ToString(monotonic() as i64);
    ensureDirSync(root);
    write(root, 'src.txt', 'built-asset\n');
    write(root, 'package.json', `{
      "scripts": {"prep": "wireit", "serve": "wireit", "bad-serve": "wireit"},
      "wireit": {
        "prep": {
          "command": "cp src.txt asset.txt",
          "files": ["src.txt"],
          "output": ["asset.txt"]
        },
        "serve": {
          "command": "cat asset.txt >> served.log; echo 'server running'",
          "service": {"readyWhen": {"lineMatches": "server running"}},
          "files": ["asset.txt"],
          "dependencies": ["prep"]
        },
        "bad-serve": {
          "command": "echo 'wrong banner'",
          "service": {"readyWhen": {"lineMatches": "server running"}},
          "files": []
        }
      }
    }`);

    let first = buildTarget(root, new ScriptRef('', 'serve'));
    isTrue(first.result.allSucceeded);
    isTrue(sourceOf(first.result, ':prep') == StepSource.Ran);
    isTrue(sourceOf(first.result, ':serve') == StepSource.Ran);

    // Invoking the top-level service again leaves prep fresh, but runs serve again.
    let second = buildTarget(root, new ScriptRef('', 'serve'));
    isTrue(second.result.allSucceeded);
    isTrue(sourceOf(second.result, ':prep') == StepSource.Fresh);
    isTrue(sourceOf(second.result, ':serve') == StepSource.Ran);
    equal(readFileSync(withRoot(root, 'served.log')), 'built-asset\nbuilt-asset\n');

    // Exiting 0 without matching readyWhen.lineMatches still fails.
    let bad = buildTarget(root, new ScriptRef('', 'bad-serve'));
    isFalse(bad.result.allSucceeded);
  });

  test('env sets literal and default external variables and invalidates on change', () => {
    let root = '/tmp/zb-env-' + i64ToString(monotonic() as i64);
    ensureDirSync(root);
    let writePkg = (port: String) => {
      write(root, 'package.json', `{
        "scripts": {"run": "wireit"},
        "wireit": {
          "run": {
            "command": "printf '%s|%s' \\"$API_PORT\\" \\"$ZB_UNSET_EXT_TEST\\" > out.txt",
            "files": [],
            "output": ["out.txt"],
            "env": {
              "API_PORT": "${port}",
              "ZB_UNSET_EXT_TEST": {"external": true, "default": "fallback"}
            }
          }
        }
      }`);
    };
    writePkg('8080');
    let entry = new ScriptRef('', 'run');

    let first = buildTarget(root, entry);
    isTrue(first.result.allSucceeded);
    equal(readFileSync(withRoot(root, 'out.txt')), '8080|fallback');

    let second = buildTarget(root, entry);
    isTrue(sourceOf(second.result, ':run') == StepSource.Fresh);

    writePkg('9090');
    let third = buildTarget(root, entry);
    isTrue(sourceOf(third.result, ':run') == StepSource.Ran);
    equal(readFileSync(withRoot(root, 'out.txt')), '9090|fallback');
  });

  test('cascade: false orders untracked producers while fileset groups hash generated files lazily', () => {
    let root = '/tmp/zb-cascade-' + i64ToString(monotonic() as i64);
    ensureDirSync(root);
    write(root, 'desired.txt', 'bin-v1\n');
    // Mirrors zena-cli's build:cargo -> build:binary -> build -> app pattern:
    // build:cargo omits `files` (always runs, emits $volatile) and only
    // rewrites out/tool when desired.txt differs. build:binary names
    // out/tool in `files` with `cascade: false` on build:cargo (and out/tool
    // does not exist yet before the first run!).
    write(root, 'package.json', `{
      "scripts": {"app": "wireit", "build": "wireit", "build:binary": "wireit", "build:cargo": "wireit"},
      "wireit": {
        "build:cargo": {
          "command": "mkdir -p out && if [ ! -f out/tool ] || ! cmp -s desired.txt out/tool; then cp desired.txt out/tool; fi",
          "output": []
        },
        "build:binary": {
          "files": ["out/tool"],
          "dependencies": [{"script": "build:cargo", "cascade": false}]
        },
        "build": {
          "dependencies": ["build:binary"]
        },
        "app": {
          "command": "cat out/tool > app.out",
          "files": [],
          "output": ["app.out"],
          "dependencies": ["build"]
        }
      }
    }`);
    let entry = new ScriptRef('', 'app');

    // Clean run: out/tool is created by build:cargo, then hashed by build:binary.
    let first = buildTarget(root, entry);
    isTrue(first.result.allSucceeded);
    isTrue(sourceOf(first.result, ':build:cargo') == StepSource.Ran);
    isTrue(sourceOf(first.result, ':build:binary') == StepSource.Ran);
    isTrue(sourceOf(first.result, ':build') == StepSource.Ran);
    isTrue(sourceOf(first.result, ':app') == StepSource.Ran);
    equal(readFileSync(withRoot(root, 'app.out')), 'bin-v1\n');

    // No-op cargo rerun: build:cargo runs again, but out/tool is unchanged,
    // so build:binary, build, and app all stay fresh!
    let second = buildTarget(root, entry);
    isTrue(second.result.allSucceeded);
    isTrue(sourceOf(second.result, ':build:cargo') == StepSource.Ran);
    isTrue(sourceOf(second.result, ':build:binary') == StepSource.Fresh);
    isTrue(sourceOf(second.result, ':build') == StepSource.Fresh);
    isTrue(sourceOf(second.result, ':app') == StepSource.Fresh);

    // Real binary update: build:cargo rewrites out/tool, which cascades
    // through build:binary and build to rerun app.
    write(root, 'desired.txt', 'bin-v2\n');
    let third = buildTarget(root, entry);
    isTrue(third.result.allSucceeded);
    isTrue(sourceOf(third.result, ':build:cargo') == StepSource.Ran);
    isTrue(sourceOf(third.result, ':build:binary') == StepSource.Ran);
    isTrue(sourceOf(third.result, ':build') == StepSource.Ran);
    isTrue(sourceOf(third.result, ':app') == StepSource.Ran);
    equal(readFileSync(withRoot(root, 'app.out')), 'bin-v2\n');
  });

  test('persistent hash memo skips byte reads across runs and detects same-size edits', () => {
    let root = '/tmp/zb-memo-' + i64ToString(monotonic() as i64);
    mkFixture(root);
    let entry = new ScriptRef('', 'build');

    // First build populates .zb/hashes.json.
    let first = buildTarget(root, entry);
    isTrue(first.result.allSucceeded);

    // Immediate sub-millisecond same-size edit ("lib-v1\n" -> "lib-v2\n",
    // both 7 bytes): the racy-timestamp guard forces a byte re-hash so it
    // cannot slip past as a false memo hit.
    write(root, 'packages/lib/src/in.txt', 'lib-v2\n');
    let immediateEdit = buildTarget(root, entry);
    isTrue(immediateEdit.result.allSucceeded);
    isTrue(sourceOf(immediateEdit.result, 'packages/lib:build') == StepSource.Ran);
    isTrue(sourceOf(immediateEdit.result, 'packages/app:build') == StepSource.Ran);
    equal(readFileSync(withRoot(root, 'packages/app/out/app.txt')), 'lib-v2\nhello-v1\n');

    // Advance past the 20ms racy window, run once so .zb/hashes.json has a
    // post-window mtime, then verify the next warm run reads zero file bytes.
    runFuture(sleep(milliseconds(35)));
    let settle = buildTarget(root, entry);
    isTrue(settle.result.allSucceeded);
    isTrue(sourceOf(settle.result, 'packages/lib:build') == StepSource.Fresh);
    isTrue(sourceOf(settle.result, 'packages/app:build') == StepSource.Fresh);

    let warmHasher = new FileHasher(root);
    let warm = buildTarget(root, entry, 0, false, true, warmHasher);
    isTrue(warm.result.allSucceeded);
    isTrue(sourceOf(warm.result, 'packages/lib:build') == StepSource.Fresh);
    isTrue(sourceOf(warm.result, 'packages/app:build') == StepSource.Fresh);
    equal(warmHasher.hashReads, 0);
    isTrue(warmHasher.statHits > 0);

    // Same-size edit after memo warm-up advances mtime and triggers rebuild.
    runFuture(sleep(milliseconds(10)));
    write(root, 'packages/lib/src/in.txt', 'lib-v3\n');
    let edited = buildTarget(root, entry);
    isTrue(edited.result.allSucceeded);
    isTrue(sourceOf(edited.result, 'packages/lib:build') == StepSource.Ran);
    isTrue(sourceOf(edited.result, 'packages/app:build') == StepSource.Ran);
    equal(readFileSync(withRoot(root, 'packages/app/out/app.txt')), 'lib-v3\nhello-v1\n');
  });

  test('deleted or modified output files invalidate freshness and restore or rerun', () => {
    let root = '/tmp/zb-outputs-' + i64ToString(monotonic() as i64);
    mkFixture(root);
    let entry = new ScriptRef('', 'build');

    let first = buildTarget(root, entry);
    isTrue(first.result.allSucceeded);

    // Deleting an upstream output file makes that step non-fresh; it
    // restores from the disk blob cache while downstream stays fresh.
    unlinkSync(withRoot(root, 'packages/lib/out/lib.txt'));
    let afterDelete = buildTarget(root, entry);
    isTrue(afterDelete.result.allSucceeded);
    isTrue(sourceOf(afterDelete.result, 'packages/lib:build') == StepSource.Cache);
    isTrue(sourceOf(afterDelete.result, 'packages/app:build') == StepSource.Fresh);
    equal(readFileSync(withRoot(root, 'packages/lib/out/lib.txt')), 'lib-v1\n');

    // Corrupting a downstream output file restores the clean bytes from cache.
    runFuture(sleep(milliseconds(10)));
    write(root, 'packages/app/out/app.txt', 'corrupted-by-hand\n');
    let afterCorrupt = buildTarget(root, entry);
    isTrue(afterCorrupt.result.allSucceeded);
    isTrue(sourceOf(afterCorrupt.result, 'packages/lib:build') == StepSource.Fresh);
    isTrue(sourceOf(afterCorrupt.result, 'packages/app:build') == StepSource.Cache);
    equal(readFileSync(withRoot(root, 'packages/app/out/app.txt')), 'lib-v1\nhello-v1\n');

    // Deleting the output with --no-cache (`useCache = false`) reruns the step.
    unlinkSync(withRoot(root, 'packages/app/out/app.txt'));
    let rerunNoCache = buildTarget(root, entry, 0, false, false);
    isTrue(rerunNoCache.result.allSucceeded);
    isTrue(sourceOf(rerunNoCache.result, 'packages/lib:build') == StepSource.Fresh);
    isTrue(sourceOf(rerunNoCache.result, 'packages/app:build') == StepSource.Ran);
    equal(readFileSync(withRoot(root, 'packages/app/out/app.txt')), 'lib-v1\nhello-v1\n');
  });

  test('packageLocks fingerprints ancestor lockfiles by default and respects overrides', () => {
    let root = '/tmp/zb-locks-' + i64ToString(monotonic() as i64);
    ensureDirSync(root);
    write(root, 'package-lock.json', '{"lockfileVersion":3,"v":1}\n');
    write(root, 'pnpm-lock.yaml', 'lockfileVersion: 9.0\nv: 1\n');
    write(root, 'package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "dependencies": [
            "./packages/default-lock:build",
            "./packages/no-lock:build",
            "./packages/pnpm-lock:build"
          ]
        }
      }
    }`);
    write(root, 'packages/default-lock/src.txt', 'a\n');
    write(root, 'packages/default-lock/package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "command": "cat src.txt > out.txt",
          "files": ["src.txt", "../../package-lock.json"],
          "output": ["out.txt"]
        }
      }
    }`);
    write(root, 'packages/no-lock/src.txt', 'b\n');
    write(root, 'packages/no-lock/package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "command": "cat src.txt > out.txt",
          "files": ["src.txt"],
          "output": ["out.txt"],
          "packageLocks": []
        }
      }
    }`);
    write(root, 'packages/pnpm-lock/src.txt', 'c\n');
    write(root, 'packages/pnpm-lock/package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "command": "cat src.txt > out.txt",
          "files": ["src.txt"],
          "output": ["out.txt"],
          "packageLocks": ["pnpm-lock.yaml"]
        }
      }
    }`);
    // Also add a second default-lock package that does NOT list package-lock.json in `files`.
    write(root, 'packages/implicit-lock/src.txt', 'd\n');
    write(root, 'packages/implicit-lock/package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "command": "cat src.txt > out.txt",
          "files": ["src.txt"],
          "output": ["out.txt"]
        }
      }
    }`);
    write(root, 'package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "dependencies": [
            "./packages/default-lock:build",
            "./packages/implicit-lock:build",
            "./packages/no-lock:build",
            "./packages/pnpm-lock:build"
          ]
        }
      }
    }`);
    let entry = new ScriptRef('', 'build');

    let first = buildTarget(root, entry);
    isTrue(first.result.allSucceeded);
    isTrue(sourceOf(first.result, 'packages/default-lock:build') == StepSource.Ran);
    isTrue(sourceOf(first.result, 'packages/implicit-lock:build') == StepSource.Ran);
    isTrue(sourceOf(first.result, 'packages/no-lock:build') == StepSource.Ran);
    isTrue(sourceOf(first.result, 'packages/pnpm-lock:build') == StepSource.Ran);

    let second = buildTarget(root, entry);
    isTrue(second.result.allSucceeded);
    isTrue(sourceOf(second.result, 'packages/default-lock:build') == StepSource.Fresh);
    isTrue(sourceOf(second.result, 'packages/implicit-lock:build') == StepSource.Fresh);
    isTrue(sourceOf(second.result, 'packages/no-lock:build') == StepSource.Fresh);
    isTrue(sourceOf(second.result, 'packages/pnpm-lock:build') == StepSource.Fresh);

    // Updating root package-lock.json invalidates both explicit+default and
    // implicit default-lock packages (without duplicate-input collision),
    // while leaving packageLocks:[] and pnpm-lock packages fresh.
    write(root, 'package-lock.json', '{"lockfileVersion":3,"v":2}\n');
    let third = buildTarget(root, entry);
    isTrue(third.result.allSucceeded);
    isTrue(sourceOf(third.result, 'packages/default-lock:build') == StepSource.Ran);
    isTrue(sourceOf(third.result, 'packages/implicit-lock:build') == StepSource.Ran);
    isTrue(sourceOf(third.result, 'packages/no-lock:build') == StepSource.Fresh);
    isTrue(sourceOf(third.result, 'packages/pnpm-lock:build') == StepSource.Fresh);

    // Updating pnpm-lock.yaml invalidates only packages/pnpm-lock:build.
    write(root, 'pnpm-lock.yaml', 'lockfileVersion: 9.0\nv: 2\n');
    let fourth = buildTarget(root, entry);
    isTrue(fourth.result.allSucceeded);
    isTrue(sourceOf(fourth.result, 'packages/default-lock:build') == StepSource.Fresh);
    isTrue(sourceOf(fourth.result, 'packages/implicit-lock:build') == StepSource.Fresh);
    isTrue(sourceOf(fourth.result, 'packages/no-lock:build') == StepSource.Fresh);
    isTrue(sourceOf(fourth.result, 'packages/pnpm-lock:build') == StepSource.Ran);
  });

  test('force bypasses freshness and cache; no-cache skips disk cache restore', () => {
    let root = '/tmp/zb-force-' + i64ToString(monotonic() as i64);
    mkFixture(root);
    let entry = new ScriptRef('', 'build');

    let first = buildTarget(root, entry);
    isTrue(first.result.allSucceeded);

    let second = buildTarget(root, entry);
    isTrue(second.result.allSucceeded);
    isTrue(sourceOf(second.result, 'packages/lib:build') == StepSource.Fresh);
    isTrue(sourceOf(second.result, 'packages/app:build') == StepSource.Fresh);

    // force = true reruns every step even when fresh and cached.
    let forced = buildTarget(root, entry, 0, true, true);
    isTrue(forced.result.allSucceeded);
    isTrue(sourceOf(forced.result, 'packages/lib:build') == StepSource.Ran);
    isTrue(sourceOf(forced.result, 'packages/app:build') == StepSource.Ran);

    // Deleting lib's state.json with useCache = false reruns lib instead of
    // restoring from DiskCache, while app stays fresh via early cutoff.
    unlinkSync(withRoot(root, 'packages/lib/.zb/state.json'));
    let noCache = buildTarget(root, entry, 0, false, false);
    isTrue(noCache.result.allSucceeded);
    isTrue(sourceOf(noCache.result, 'packages/lib:build') == StepSource.Ran);
    isTrue(sourceOf(noCache.result, 'packages/app:build') == StepSource.Fresh);
  });
});
