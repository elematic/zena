import {suite, test} from 'zena:test';
import {equal, isFalse, isNotNull, isNull, isTrue, throws} from 'zena:assert';
import {joinWorkspace} from '../fs-util.zena';
import {
  EnvExternal,
  EnvLiteral,
  ScriptRef,
  ServiceConfig,
  WireitWorkspace,
  refKey,
  resolveDependency,
} from '../wireit-config.zena';

function fixture() {
  let files = {
    'package.json' => `{
    "scripts": {"build": "wireit"},
    "wireit": {
      "build": {
        "dependencies": ["./packages/app:build", "./packages/lib:build"]
      }
    }
  }`,
    'packages/app/package.json' => `{
    "scripts": {"build": "wireit", "build:codegen": "wireit", "lint": "eslint ."},
    "wireit": {
      "build": {
        "command": "tsc",
        "files": ["src/**/*.ts", "tsconfig.json"],
        "output": ["lib/**"],
        "clean": "if-file-deleted",
        "env": {
          "NODE_ENV": "production",
          "OPT_LEVEL": {"external": true, "default": "2"}
        },
        "dependencies": [
          "../lib:build",
          {"script": "build:codegen", "cascade": false}
        ]
      },
      "build:codegen": {
        "command": "node gen.js",
        "files": ["gen.js"],
        "output": ["src/gen/**"]
      },
      "build:dep-only": {
        "command": "true"
      }
    }
  }`,
    'packages/lib/package.json' => `{
    "scripts": {"build": "wireit", "serve": "wireit", "emulate": "wireit"},
    "wireit": {
      "build": {
        "command": "tsc",
        "files": ["src/**/*.ts"],
        "output": ["lib/**"],
        "clean": false
      },
      "serve": {
        "command": "node server.js",
        "service": true,
        "files": ["server.js"],
        "dependencies": ["build"]
      },
      "emulate": {
        "command": "node emu.js",
        "service": {"readyWhen": {"lineMatches": "Ready on [0-9]+"}}
      }
    }
  }`,
  };
  return new WireitWorkspace((path: String): String? => {
    if (let (true, content) = files.get(path)) {
      return content;
    }
    return null;
  });
}

export let tests = suite('wireit-config', () => {
  test('workspace paths normalize, with the root as the empty path', () => {
    equal(joinWorkspace('', 'package.json'), 'package.json');
    equal(joinWorkspace('packages/app', '../lib'), 'packages/lib');
    equal(joinWorkspace('', './a/b/'), 'a/b');
    // zena:path calls the root '.'; zb keys the root package by ''.
    equal(joinWorkspace('packages/app', '../..'), '');
    equal(joinWorkspace('', ''), '');
  });

  test('dependency references resolve', () => {
    let local = resolveDependency('packages/app', 'build:codegen');
    equal(local.packageDir, 'packages/app');
    equal(local.script, 'build:codegen');

    let sibling = resolveDependency('packages/app', '../lib:build');
    equal(sibling.packageDir, 'packages/lib');
    equal(sibling.script, 'build');

    let fromRoot = resolveDependency('', './packages/app:build');
    equal(fromRoot.packageDir, 'packages/app');

    // Script names may contain colons after the path's first colon.
    let colons = resolveDependency('', './packages/app:precompile:cli');
    equal(colons.packageDir, 'packages/app');
    equal(colons.script, 'precompile:cli');

    // A dependency on the root package resolves to the root's key.
    let root = resolveDependency('packages/app', '../..:build');
    equal(root.packageDir, '');
    equal(refKey(root), ':build');

    throws(() => {
      resolveDependency('', '../outside:build');
    });
  });

  test('wireit scripts, cascade flags, and env bindings parse', () => {
    let ws = fixture();
    let config = ws.scriptConfig(new ScriptRef('packages/app', 'build'));
    isTrue(config.isWireit);
    equal(config.command, 'tsc');
    equal(config.files.length, 2);
    equal(config.files[0], 'src/**/*.ts');
    equal(config.output.length, 1);
    equal(config.clean, 'if-file-deleted');
    isNull(config.service);
    equal(config.dependencies.length, 2);
    equal(refKey(config.dependencies[0].ref), 'packages/lib:build');
    isTrue(config.dependencies[0].cascade);
    equal(refKey(config.dependencies[1].ref), 'packages/app:build:codegen');
    isFalse(config.dependencies[1].cascade);

    // Env bindings are sorted by variable name.
    equal(config.env.length, 2);
    equal(config.env[0][0], 'NODE_ENV');
    let firstEnv = config.env[0][1];
    if (firstEnv is EnvLiteral) {
      equal(firstEnv.value, 'production');
    } else {
      throws(() => { throw new Error('expected EnvLiteral'); });
    }
    equal(config.env[1][0], 'OPT_LEVEL');
    let secondEnv = config.env[1][1];
    if (secondEnv is EnvExternal) {
      equal(secondEnv.defaultValue, '2');
    } else {
      throws(() => { throw new Error('expected EnvExternal'); });
    }
  });

  test('clean and service forms parse', () => {
    let ws = fixture();
    let lib = ws.scriptConfig(new ScriptRef('packages/lib', 'build'));
    equal(lib.clean, 'false');

    let serve = ws.scriptConfig(new ScriptRef('packages/lib', 'serve'));
    let serveSvc = serve.service;
    isNotNull(serveSvc);
    if (serveSvc != null) {
      isNull(serveSvc.readyWhenLineMatches);
    }
    equal(serve.dependencies.length, 1);

    let emulate = ws.scriptConfig(new ScriptRef('packages/lib', 'emulate'));
    let emuSvc = emulate.service;
    isNotNull(emuSvc);
    if (emuSvc != null) {
      equal(emuSvc.readyWhenLineMatches, 'Ready on [0-9]+');
    }
  });

  test('dependency-only wireit scripts need no scripts entry', () => {
    let ws = fixture();
    let config = ws.scriptConfig(new ScriptRef('packages/app', 'build:dep-only'));
    isTrue(config.isWireit);
    equal(config.command, 'true');
  });

  test('fingerprintability follows declared files and output (and files for services)', () => {
    let ws = fixture();
    // Command with files and output declared: fully tracked.
    isTrue(ws.scriptConfig(new ScriptRef('packages/app', 'build')).fingerprintable);
    // Command without files/output keys: unknown inputs, never fresh.
    isFalse(ws.scriptConfig(new ScriptRef('packages/app', 'build:dep-only')).fingerprintable);
    // Service with files declared: tracked identity.
    isTrue(ws.scriptConfig(new ScriptRef('packages/lib', 'serve')).fingerprintable);
    // Service without files declared: untracked identity.
    isFalse(ws.scriptConfig(new ScriptRef('packages/lib', 'emulate')).fingerprintable);
    // No command at all: a dependency group, always tracked.
    isTrue(ws.scriptConfig(new ScriptRef('', 'build')).fingerprintable);
    // Bare npm script: always runs.
    isFalse(ws.scriptConfig(new ScriptRef('packages/app', 'lint')).fingerprintable);
  });

  test('bare npm scripts always run', () => {
    let ws = fixture();
    let lint = ws.scriptConfig(new ScriptRef('packages/app', 'lint'));
    isFalse(lint.isWireit);
    equal(lint.command, 'eslint .');
    equal(lint.files.length, 0);
  });

  test('a dependency-only root script collects the closure', () => {
    let ws = fixture();
    let entry = new ScriptRef('', 'build');
    let configs = ws.collect([entry]);
    equal(configs.length, 4);
    equal(refKey(configs[0].ref), ':build');
    equal(refKey(configs[1].ref), 'packages/app:build');
    equal(refKey(configs[2].ref), 'packages/lib:build');
    equal(refKey(configs[3].ref), 'packages/app:build:codegen');
    isNull(configs[0].command);
  });

  test('missing packages and scripts fail loudly', () => {
    let ws = fixture();
    throws(() => {
      ws.scriptConfig(new ScriptRef('packages/ghost', 'build'));
    });
    throws(() => {
      ws.scriptConfig(new ScriptRef('packages/app', 'nope'));
    });
  });

  test('unsupported keys and invalid service/dependency/env shapes fail loudly', () => {
    let checkThrows = (json: String) => {
      let ws = new WireitWorkspace((path: String): String? => {
        return if (path == 'package.json') json else null;
      });
      throws(() => {
        ws.scriptConfig(new ScriptRef('', 'x'));
      });
    };

    // Unknown top-level wireit key.
    checkThrows(`{"scripts": {"x": "wireit"}, "wireit": {"x": {"command": "true", "bogus": 1}}}`);
    // Service declaring output.
    checkThrows(`{"scripts": {"x": "wireit"}, "wireit": {"x": {"command": "true", "service": true, "output": []}}}`);
    // Service without command.
    checkThrows(`{"scripts": {"x": "wireit"}, "wireit": {"x": {"service": true}}}`);
    // Invalid readyWhen key.
    checkThrows(`{"scripts": {"x": "wireit"}, "wireit": {"x": {"command": "true", "service": {"readyWhen": {"port": 8080}}}}}`);
    // Invalid dependency object key.
    checkThrows(`{"scripts": {"x": "wireit"}, "wireit": {"x": {"dependencies": [{"script": "y", "extra": 1}]}}}`);
    // Invalid env external: false.
    checkThrows(`{"scripts": {"x": "wireit"}, "wireit": {"x": {"command": "true", "env": {"FOO": {"external": false}}}}}`);
    // Invalid packageLocks containing path separator or empty string.
    checkThrows(`{"scripts": {"x": "wireit"}, "wireit": {"x": {"command": "true", "packageLocks": ["../package-lock.json"]}}}`);
    checkThrows(`{"scripts": {"x": "wireit"}, "wireit": {"x": {"command": "true", "packageLocks": [""]}}}`);
  });

  test('packageLocks defaults to package-lock.json and supports custom or empty lists', () => {
    let ws = new WireitWorkspace((path: String): String? => {
      if (path == 'package.json') {
        return `{
          "scripts": {"def": "wireit", "none": "wireit", "pnpm": "wireit"},
          "wireit": {
            "def": {"command": "true", "files": [], "output": []},
            "none": {"command": "true", "files": [], "output": [], "packageLocks": []},
            "pnpm": {"command": "true", "files": [], "output": [], "packageLocks": ["pnpm-lock.yaml"]}
          }
        }`;
      }
      return null;
    });
    let def = ws.scriptConfig(new ScriptRef('', 'def'));
    equal(def.packageLocks.length, 1);
    equal(def.packageLocks[0], 'package-lock.json');

    let none = ws.scriptConfig(new ScriptRef('', 'none'));
    equal(none.packageLocks.length, 0);

    let pnpm = ws.scriptConfig(new ScriptRef('', 'pnpm'));
    equal(pnpm.packageLocks.length, 1);
    equal(pnpm.packageLocks[0], 'pnpm-lock.yaml');
  });
});
