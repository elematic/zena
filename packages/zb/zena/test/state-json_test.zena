import {suite, test} from 'zena:test';
import {equal, isNull, isTrue, throws} from 'zena:assert';
import {ResolvedInput} from 'workflow:canonical';
import {CacheKey, Fingerprint} from 'workflow:fingerprint';
import {OutputEntry, OutputManifest} from 'workflow:manifest';
import {EngineState, StepRecord} from 'workflow:state';
import {StepKey} from 'workflow:step';
import {
  HashMemoEntry,
  hashesFromJson,
  hashesToJson,
  manifestFromJson,
  manifestToJson,
  stateFromJson,
  stateToJson,
} from '../state-json.zena';

function fp(value: String) {
  return new Fingerprint(value);
}

function sampleState() {
  let state = new EngineState();
  let inputs = new GrowableArray<ResolvedInput>();
  inputs.push(new ResolvedInput('leaf:src/a.ts', fp('f1')));
  inputs.push(new ResolvedInput('step:dep', fp('f2')));
  let outputs = new GrowableArray<OutputEntry>();
  outputs.push(new OutputEntry('out/a.js', fp('o1'), ['leaf:src/a.ts']));
  outputs.push(new OutputEntry('out/index.js', fp('o2')));
  state.setRecord(
    new StepKey('pkg:build'),
    new StepRecord(fp('cfg'), new CacheKey('key1'), new OutputManifest(outputs), inputs),
  );
  return state;
}

export let tests = suite('state-json', () => {
  test('state round-trips', () => {
    let text = stateToJson(sampleState());
    let state = stateFromJson(text);
    equal(state.size, 1);
    let record = state.recordOf(new StepKey('pkg:build'));
    if (record != null) {
      equal(record.config.value, 'cfg');
      equal(record.cacheKey.value, 'key1');
      equal(record.inputs.length, 2);
      equal(record.inputs[0].name, 'leaf:src/a.ts');
      equal(record.inputs[1].fingerprint.value, 'f2');
      equal(record.manifest.outputs.length, 2);
      let first = record.manifest.outputs[0];
      equal(first.name, 'out/a.js');
      let deps = first.dependsOn;
      if (deps != null) {
        equal(deps.length, 1);
        equal(deps[0], 'leaf:src/a.ts');
      } else {
        throws(() => {
          throw new Error('expected dependsOn to survive');
        });
      }
      isNull(record.manifest.outputs[1].dependsOn);
    } else {
      throws(() => {
        throw new Error('expected the record to survive');
      });
    }
  });

  test('serialization is stable', () => {
    equal(stateToJson(sampleState()), stateToJson(sampleState()));
  });

  test('manifests round-trip alone', () => {
    let outputs = new GrowableArray<OutputEntry>();
    outputs.push(new OutputEntry('a', fp('1')));
    let text = manifestToJson(new OutputManifest(outputs));
    let manifest = manifestFromJson(text);
    equal(manifest.outputs.length, 1);
    equal(manifest.outputs[0].fingerprint.value, '1');
  });

  test('malformed input is rejected', () => {
    throws(() => {
      stateFromJson('{}');
    });
    throws(() => {
      stateFromJson('{"version": 2, "steps": {}}');
    });
    throws(() => {
      stateFromJson('{"version": 1, "steps": {"x": {"config": 5}}}');
    });
  });

  test('hash memo preserves full 64-bit nanosecond timestamps across round-trip', () => {
    let entries = new HashMap<String, HashMemoEntry>();
    // 1794000000123456789 exceeds IEEE 754 f64 exact integer precision (2^53).
    let exactNanos = 1794000000123456789 as i64;
    entries['src/main.zena'] = new HashMemoEntry(exactNanos, 4096 as i64, fp('sha256:abc'));
    entries['virtual/zero'] = new HashMemoEntry(0 as i64, 10 as i64, fp('sha256:skip'));

    let decoded = hashesFromJson(hashesToJson(entries));
    equal(decoded.size, 1);
    if (let (true, entry) = decoded.get('src/main.zena')) {
      equal(entry.modified, exactNanos);
      equal(entry.size, 4096 as i64);
      equal(entry.fingerprint.value, 'sha256:abc');
    } else {
      throws(() => {
        throw new Error('expected src/main.zena in decoded hash memo');
      });
    }
  });
});
