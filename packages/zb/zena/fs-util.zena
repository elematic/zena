import {exists, isFile, mkdir, readFile, unlink} from 'zena:fs';
import {dirname, join2} from 'zena:path';

/**
 * Small filesystem helpers over zena:fs. Workspace paths are
 * slash-separated and relative to a root prefix; `withRoot` joins them
 * without normalizing, so the root may be absolute ('/tmp/x') or ''
 * for the current directory.
 */

/**
 * Joins and normalizes two workspace paths. The workspace root is `''`
 * throughout zb — it keys the root package and appears in `.zb/` state —
 * where zena:path spells it `'.'`, so `joinWorkspace('packages/zb',
 * '../..')` is `''`.
 */
export let joinWorkspace = (base: String, rel: String): String => {
  let joined = join2(base, rel);
  return if (joined == '.') '' else joined;
};

export let withRoot = (root: String, path: String): String => {
  if (root == '') {
    return if (path == '') '.' else path;
  }
  if (path == '') {
    return root;
  }
  return root + '/' + path;
};

export let readFileOrNull = (path: String): String? => {
  if (!isFile(path)) {
    return null;
  }
  return readFile(path);
};

/** Creates a directory and its ancestors; existing ones are fine. */
export let ensureDir = (path: String): void => {
  if (path == '' || path == '.' || exists(path)) {
    return;
  }
  ensureDir(dirname(path));
  mkdir(path);
};

/** Creates the directory a file will be written into. */
export let ensureParentDir = (path: String): void => {
  ensureDir(dirname(path));
};

export let deleteIfExists = (path: String): void => {
  if (isFile(path)) {
    unlink(path);
  }
};
