import {Box} from 'zena:core';
import { HashSet } from 'zena:collections';
import {
  JsonArray,
  JsonObject,
  JsonValue,
  parseJson,
} from 'zena:json';
import {compareStrings, sortBy} from 'workflow/canonical';
import {joinWorkspace} from './fs-util.zena';

/** Raised for malformed or unsupported build configuration. */
export class ConfigError extends Error {
  new(message: String) : super(message);
}

/** A script in a package, both repo-relative ('' is the root package). */
export class ScriptRef(packageDir: String, script: String)

/** The key steps derived from this script use, 'dir:script'. */
export function refKey(ref: ScriptRef): String {
  return `${ref.packageDir}:${ref.script}`;
}

/** A resolved dependency edge, with wireit's `cascade` flag (default true). */
export class DependencySpec(ref: ScriptRef, cascade: boolean)

/**
 * Service configuration: `readyWhenLineMatches` is null for `service: true`
 * (ready on spawn) or a regex pattern string for `readyWhen.lineMatches`.
 */
export class ServiceConfig(readyWhenLineMatches: String?)

/** One entry in a script's `env` map. */
export sealed class EnvBinding {
  case EnvLiteral, EnvExternal
}

/** Sets the environment variable to a fixed string value. */
export final class EnvLiteral(value: String) extends EnvBinding

/**
 * Fingerprints an environment variable from the caller's environment,
 * optionally falling back to `defaultValue` when unset.
 */
export final class EnvExternal(defaultValue: String?) extends EnvBinding

/**
 * One script's configuration. For a wireit script the fields come from
 * the wireit block; a bare npm script has only a command and always
 * runs.
 */
export class ScriptConfig {
  ref: ScriptRef;
  isWireit: boolean;
  command: String?;
  /** Globs relative to the package directory. */
  files: Array<String>;
  output: Array<String>;
  /**
   * Whether the config declared the key at all. Omitting `files` or
   * `output` on a task script means the inputs or outputs are unknown
   * (wireit semantics): the script is never fresh, never cached, and
   * its cascading dependents cannot be either. An explicit empty array
   * means "declared none" and tracks fully. Services forbid `output`
   * and track their identity whenever `files` is declared.
   */
  filesDeclared: boolean;
  outputDeclared: boolean;
  dependencies: Array<DependencySpec>;
  /** 'true', 'false', or 'if-file-deleted'. */
  clean: String;
  service: ServiceConfig?;
  /** Sorted by variable name. */
  env: Array<(String, EnvBinding)>;
  /**
   * Lockfile filenames searched upward from `ref.packageDir` to the
   * workspace root (wireit defaults to `['package-lock.json']` when
   * omitted; `[]` disables lockfile tracking).
   */
  packageLocks: Array<String>;
  /**
   * Explicit opt-out from freshness and caching (`"cache": false` in
   * `zebra.json` or `zena-package.json`). Defaults to `true`.
   */
  cacheEnabled: boolean;
  /**
   * True when this step is a pure fileset rule (`"filesets"` or the
   * synthesized `"source"` fileset of a `zena-package.json`) rather than
   * a runnable script.
   */
  isFileset: boolean;

  /**
   * True when freshness and caching apply to this script at all. A
   * command-less script or fileset always tracks (unless `cacheEnabled`
   * is false); a service tracks when `files` (or a fileset dependency) is
   * declared; a command task needs both `files` and `output` declared.
   */
  fingerprintable: boolean {
    get {
      if (!this.isWireit || !this.cacheEnabled) {
        return false;
      }
      if (this.service != null) {
        return this.filesDeclared;
      }
      if (this.command == null) {
        return true;
      }
      return this.filesDeclared && this.outputDeclared;
    }
  }

  new(
    this.ref,
    this.isWireit,
    this.command,
    this.files,
    this.output,
    this.filesDeclared,
    this.outputDeclared,
    this.dependencies,
    this.clean,
    this.service,
    this.env,
    this.packageLocks,
    this.cacheEnabled = true,
    this.isFileset = false,
  );
}

export function isCommentKey(key: String): boolean {
  return key == '//' || key.startsWith('#');
}

function isRecognizedKey(key: String) {
  return key == 'command' || key == 'files' || key == 'output' ||
    key == 'dependencies' || key == 'clean' || key == 'service' ||
    key == 'env' || key == 'packageLocks' || isCommentKey(key);
}

export function stringList(value: JsonValue, what: String): Array<String> {
  if (value == null) {
    return new GrowableArray<String>();
  }
  if (value is JsonArray) {
    let out = new GrowableArray<String>();
    for (var i = 0; i < value.length; i += 1) {
      let item = value[i];
      if (item is String) {
        out.push(item);
      } else {
        throw new ConfigError(what + ' must contain only strings');
      }
    }
    return out;
  }
  throw new ConfigError(what + ' must be an array');
}

/**
 * Resolves a wireit dependency string. A dependency starting with '.'
 * is '<path>:<script>' with the path relative to the referring
 * package; anything else is a script in the same package (script
 * names themselves may contain ':').
 */
export function resolveDependency(from: String, dep: String): ScriptRef {
  if (dep.startsWith('.')) {
    var colon = -1;
    for (var i = 0; i < dep.length; i += 1) {
      if (dep.getByteAt(i) == 58) {
        colon = i;
        break;
      }
    }
    if (colon < 0) {
      throw new ConfigError(
        `dependency "${dep}" of ${from} has a path but no script name`,
      );
    }
    let target = joinWorkspace(from, dep.sliceBytes(0, colon));
    if (target.startsWith('..')) {
      throw new ConfigError(
        `dependency "${dep}" of ${from} escapes the workspace`,
      );
    }
    return new ScriptRef(target, dep.sliceBytes(colon + 1, dep.length));
  }
  return new ScriptRef(from, dep);
}

export function parseDependency(
  packageDir: String,
  where: String,
  dep: JsonValue,
): DependencySpec {
  if (dep is String) {
    return new DependencySpec(resolveDependency(packageDir, dep), true);
  }
  if (dep is JsonObject) {
    dep.forEach((key, value) => {
      if (key != 'script' && key != 'cascade' && !isCommentKey(key)) {
        throw new ConfigError(
          `script "${where}": dependency object has unsupported key "${key}"`,
        );
      }
    });
    let rawScript = dep['script'];
    if (!(rawScript is String)) {
      throw new ConfigError(
        `script "${where}": dependency object requires a string "script"`,
      );
    }
    var cascade = true;
    let rawCascade = dep['cascade'];
    if (rawCascade != null) {
      if (rawCascade is Box<boolean>) {
        cascade = rawCascade.value;
      } else {
        throw new ConfigError(
          `script "${where}": dependency "cascade" must be a boolean`,
        );
      }
    }
    return new DependencySpec(resolveDependency(packageDir, rawScript), cascade);
  }
  throw new ConfigError(
    `script "${where}": dependencies entries must be strings or {script, cascade} objects`,
  );
}

export function parseService(where: String, rawService: JsonValue): ServiceConfig? {
  if (rawService == null) {
    return null;
  }
  if (rawService is Box<boolean>) {
    return if (rawService.value) new ServiceConfig(null) else null;
  }
  if (rawService is JsonObject) {
    rawService.forEach((key, value) => {
      if (key != 'readyWhen' && !isCommentKey(key)) {
        throw new ConfigError(
          `script "${where}": service has unsupported key "${key}"`,
        );
      }
    });
    let rawReady = rawService['readyWhen'];
    if (rawReady == null) {
      return new ServiceConfig(null);
    }
    if (!(rawReady is JsonObject)) {
      throw new ConfigError(
        `script "${where}": service.readyWhen must be an object`,
      );
    }
    rawReady.forEach((key, value) => {
      if (key != 'lineMatches' && !isCommentKey(key)) {
        throw new ConfigError(
          `script "${where}": service.readyWhen has unsupported key "${key}"`,
        );
      }
    });
    let lineMatches = rawReady['lineMatches'];
    if (!(lineMatches is String) || lineMatches == '') {
      throw new ConfigError(
        `script "${where}": service.readyWhen.lineMatches must be a non-empty string`,
      );
    }
    return new ServiceConfig(lineMatches);
  }
  throw new ConfigError(
    `script "${where}": service must be a boolean or an object`,
  );
}

export function parseEnv(
  where: String,
  rawEnv: JsonValue,
): Array<(String, EnvBinding)> {
  let out = new GrowableArray<(String, EnvBinding)>();
  if (rawEnv == null) {
    return out;
  }
  if (!(rawEnv is JsonObject)) {
    throw new ConfigError(`script "${where}": env must be an object`);
  }
  rawEnv.forEach((name, value) => {
    if (isCommentKey(name)) {
      return;
    }
    if (value is String) {
      out.push((name, new EnvLiteral(value)));
    } else if (value is JsonObject) {
      value.forEach((key, v) => {
        if (key != 'external' && key != 'default' && !isCommentKey(key)) {
          throw new ConfigError(
            `script "${where}": env.${name} has unsupported key "${key}"`,
          );
        }
      });
      let ext = value['external'];
      if (!(ext is Box<boolean>) || !ext.value) {
        throw new ConfigError(
          `script "${where}": env.${name} object must specify "external": true`,
        );
      }
      var defaultValue: String? = null;
      let rawDefault = value['default'];
      if (rawDefault != null) {
        if (rawDefault is String) {
          defaultValue = rawDefault;
        } else {
          throw new ConfigError(
            `script "${where}": env.${name}.default must be a string`,
          );
        }
      }
      out.push((name, new EnvExternal(defaultValue)));
    } else {
      throw new ConfigError(
        `script "${where}": env.${name} must be a string or {"external": true}`,
      );
    }
  });
  sortBy(
    out,
    (a: (String, EnvBinding), b: (String, EnvBinding)) => compareStrings(a[0], b[0]),
  );
  return out;
}

export function parseClean(where: String, rawClean: JsonValue): String {
  if (rawClean == null) {
    return 'true';
  }
  if (rawClean is Box<boolean>) {
    return if (rawClean.value) 'true' else 'false';
  }
  if (rawClean is String) {
    if (rawClean != 'if-file-deleted') {
      throw new ConfigError(
        `script "${where}": unsupported clean value "${rawClean}"`,
      );
    }
    return rawClean;
  }
  throw new ConfigError(`script "${where}": invalid clean value`);
}

export function validateLockFilenames(
  where: String,
  fieldName: String,
  locks: Array<String>,
): void {
  for (let lock in locks) {
    if (lock == '' || lock.contains('/')) {
      throw new ConfigError(
        `${where}: ${fieldName} entries must be filenames, got "${lock}"`,
      );
    }
  }
}

export function parseJsonObject(path: String, content: String): JsonObject {
  var parsed: JsonValue = null;
  try {
    parsed = parseJson(content, {allowComments: true, trackLocations: false});
  } catch (e) {
    throw new ConfigError(`${path}: ${e.message}`);
  }
  if (!(parsed is JsonObject)) {
    throw new ConfigError(`${path} is not a JSON object`);
  }
  return parsed;
}

/**
 * Extracts one `ScriptConfig` from a parsed `package.json` object using
 * Wireit's rules (`wireit[script]` or bare `scripts[script]`).
 */
export function parseWireitScriptFromPackage(
  ref: ScriptRef,
  pkg: JsonObject,
): ScriptConfig {
  let where = refKey(ref);

  var wireitEntry: JsonValue = null;
  let wireit = pkg['wireit'];
  if (wireit is JsonObject) {
    wireitEntry = wireit[ref.script];
  }
  var scriptsEntry: JsonValue = null;
  let scripts = pkg['scripts'];
  if (scripts is JsonObject) {
    scriptsEntry = scripts[ref.script];
  }

  if (wireitEntry is JsonObject) {
    // A script run via npm needs a "wireit" scripts entry; one that
    // exists only as a dependency of other wireit scripts has none.
    if (scriptsEntry != null && (!(scriptsEntry is String) || scriptsEntry != 'wireit')) {
      throw new ConfigError(
        `script "${where}" has a wireit config but its scripts entry is not "wireit"`,
      );
    }
    wireitEntry.forEach((key, value) => {
      if (!isRecognizedKey(key)) {
        throw new ConfigError(
          `script "${where}" has unsupported wireit key "${key}"`,
        );
      }
    });

    var command: String? = null;
    let rawCommand = wireitEntry['command'];
    if (rawCommand != null) {
      if (rawCommand is String) {
        command = rawCommand;
      } else {
        throw new ConfigError(`script "${where}": command must be a string`);
      }
    }

    let deps = new GrowableArray<DependencySpec>();
    let rawDeps = wireitEntry['dependencies'];
    if (rawDeps != null) {
      if (!(rawDeps is JsonArray)) {
        throw new ConfigError(`script "${where}": dependencies must be an array`);
      }
      for (var i = 0; i < rawDeps.length; i += 1) {
        deps.push(parseDependency(ref.packageDir, where, rawDeps[i]));
      }
    }

    let clean = parseClean(where, wireitEntry['clean']);

    let service = parseService(where, wireitEntry['service']);
    if (command == null && service != null) {
      throw new ConfigError(`script "${where}": a service needs a command`);
    }
    if (service != null && wireitEntry['output'] != null) {
      throw new ConfigError(`script "${where}": a service cannot declare output`);
    }

    let rawLocks = wireitEntry['packageLocks'];
    var packageLocks: Array<String> = ['package-lock.json'];
    if (rawLocks != null) {
      packageLocks = stringList(rawLocks, `script "${where}": packageLocks`);
      validateLockFilenames(`script "${where}"`, 'packageLocks', packageLocks);
    }

    return new ScriptConfig(
      ref,
      true,
      command,
      stringList(wireitEntry['files'], `script "${where}": files`),
      stringList(wireitEntry['output'], `script "${where}": output`),
      wireitEntry['files'] != null,
      wireitEntry['output'] != null,
      deps,
      clean,
      service,
      parseEnv(where, wireitEntry['env']),
      packageLocks,
    );
  }

  if (scriptsEntry is String) {
    if (scriptsEntry == 'wireit') {
      throw new ConfigError(
        `script "${where}" says "wireit" but has no wireit config`,
      );
    }
    // A bare npm script: always runs, produces nothing cacheable.
    return new ScriptConfig(
      ref,
      false,
      scriptsEntry,
      new GrowableArray<String>(),
      new GrowableArray<String>(),
      false,
      false,
      new GrowableArray<DependencySpec>(),
      'false',
      null,
      new GrowableArray<(String, EnvBinding)>(),
      new GrowableArray<String>(),
      false,
    );
  }

  let pkgLabel = if (ref.packageDir == '') 'the root package' else ref.packageDir;
  throw new ConfigError(`no script "${ref.script}" in ${pkgLabel}`);
}

/**
 * Reads wireit build configuration from package.json files, resolving
 * cross-package references. File access goes through the callback
 * (repo-relative path to content, or null when absent), so tests run
 * on in-memory fixtures.
 */
export class WireitWorkspace {
  #readFile: (path: String) => Future<String?>;
  #packages = new HashMap<String, JsonObject>();

  new(readFile: (path: String) => Future<String?>) : #readFile = readFile;

  async #packageJson(packageDir: String): Future<JsonObject> {
    if (let (true, cached) = this.#packages.get(packageDir)) {
      return cached;
    }
    let path = joinWorkspace(packageDir, 'package.json');
    let readFile = this.#readFile;
    let content = await readFile(path);
    if (content == null) {
      throw new ConfigError('no package.json at ' + path);
    }
    let parsed = parseJsonObject(path, content);
    this.#packages[packageDir] = parsed;
    return parsed;
  }

  async scriptConfig(ref: ScriptRef): Future<ScriptConfig> {
    let pkg = await this.#packageJson(ref.packageDir);
    return parseWireitScriptFromPackage(ref, pkg);
  }

  /** The transitive dependency closure, in discovery (BFS) order. */
  async collect(entries: Array<ScriptRef>): Future<Array<ScriptConfig>> {
    let seen = new HashSet<String>();
    let queue = new GrowableArray<ScriptRef>();
    let out = new GrowableArray<ScriptConfig>();
    for (let entry in entries) {
      queue.push(entry);
    }
    var next = 0;
    while (next < queue.length) {
      let ref = queue[next];
      next += 1;
      if (!seen.add(refKey(ref))) {
        continue;
      }
      let config = await this.scriptConfig(ref);
      out.push(config);
      for (let dep in config.dependencies) {
        queue.push(dep.ref);
      }
    }
    return out;
  }
}
