import {runFuture} from 'zena:async';
import {getEnv} from 'zena:cli';
import { HashSet } from 'zena:collections';
import {isFileSync, readFileSync, writeFileSync} from 'zena:fs';
import {monotonic} from 'zena:time';
import {
  Engine,
  Failed,
  RunOptions,
  RunResult,
  Skipped,
  StepSource,
  Succeeded,
} from 'workflow:engine';
import {Fingerprint} from 'workflow:fingerprint';
import {EngineState} from 'workflow:state';
import {StepKey} from 'workflow:step';
import {DiskCache, stateDirOf} from './disk-cache.zena';
import {planScripts} from './builder.zena';
import {ensureParentDirSync, readFileOrNullSync, withRoot} from './fs-util.zena';
import {FileHasher} from './fs-walk.zena';
import {sha256HexOfString} from 'zena:crypto';
import {stateFromJson, stateToJson} from './state-json.zena';
import {ScriptRef, WireitWorkspace, refKey} from './wireit-config.zena';

// State is stored per package ('<pkg>/.zb/state.json'), like wireit's
// .wireit/, so its location does not depend on the invocation
// directory.

function packageStatePath(root: String, stateDir: String) {
  return withRoot(root, stateDir + '/state.json');
}

function loadState(root: String, stateDirs: Array<String>) {
  let state = new EngineState();
  for (let stateDir in stateDirs) {
    let path = packageStatePath(root, stateDir);
    if (!isFileSync(path)) {
      continue;
    }
    stateFromJson(readFileSync(path)).forEach((key, record) => {
      state.setRecord(new StepKey(key), record);
    });
  }
  return state;
}

/**
 * Writes each package's records back, merged over what its state file
 * already holds — a run of one target must not drop a package's
 * records for scripts outside the run's closure.
 */
function saveState(root: String, result: RunResult, skipKey: String? = null) {
  let byDir = new HashMap<String, EngineState>();
  let dirs = new GrowableArray<String>();
  result.state.forEach((key, record) => {
    if (skipKey != null && key == skipKey) {
      return;
    }
    let stateDir = stateDirOf(key);
    if (!byDir.has(stateDir)) {
      let path = packageStatePath(root, stateDir);
      byDir[stateDir] = if (isFileSync(path))
        stateFromJson(readFileSync(path))
      else
        EngineState.empty();
      dirs.push(stateDir);
    }
    if (let (true, packageState) = byDir.get(stateDir)) {
      packageState.setRecord(new StepKey(key), record);
    }
  });
  for (let stateDir in dirs) {
    if (let (true, packageState) = byDir.get(stateDir)) {
      let path = packageStatePath(root, stateDir);
      ensureParentDirSync(path);
      writeFileSync(path, stateToJson(packageState));
    }
  }
}

/** How one step of a finished build went, as `reportBuild` prints it. */
function describeStep(result: RunResult, key: String) {
  let outcome = result.outcomeOf(new StepKey(key));
  if (outcome is Succeeded) {
    if (outcome.source == StepSource.Fresh) {
      return 'fresh';
    }
    if (outcome.source == StepSource.Cache) {
      return 'restored';
    }
    return 'ran';
  }
  if (outcome is Failed) {
    return 'FAILED: ' + outcome.error.message;
  }
  if (outcome is Skipped) {
    return `skipped (${outcome.reason})`;
  }
  return 'unknown';
}

/**
 * Prints each step of a finished build and whether the build succeeded,
 * and returns the exit status: 0 when every step succeeded, 1 otherwise.
 * `zb` and `zena build <target>` both report this way.
 */
export function reportBuild(outcome: BuildOutcome): i32 {
  let result = outcome.result;
  for (let key in outcome.stepKeys) {
    console.log(`${key}: ${describeStep(result, key)}`);
  }
  if (!result.allSucceeded) {
    console.log('build failed');
    return 1;
  }
  console.log('build succeeded');
  return 0;
}

/** A finished build: the engine result plus the step keys it ran. */
export class BuildOutcome {
  result: RunResult;
  stepKeys: Array<String>;

  new(this.result, this.stepKeys);
}

/** Default max concurrent script executions: ZENA_AVAILABLE_PARALLELISM, or 8. */
export function defaultParallelism(): i32 {
  let raw = getEnv('ZENA_AVAILABLE_PARALLELISM');
  if (raw != null) {
    if (let (true, n) = parseI32(raw)) {
      if (n >= 1) {
        return n;
      }
    }
  }
  return 8;
}

/**
 * One full build of a script and its transitive dependencies: load
 * config and prior state, snapshot inputs, run the engine with the
 * local disk cache, persist the new state.
 */
export function buildTarget(
  root: String,
  entry: ScriptRef,
  parallelism: i32 = 0,
): BuildOutcome {
  let jobs = if (parallelism > 0) parallelism else defaultParallelism();
  let workspace = new WireitWorkspace(
    (path: String) => readFileOrNullSync(withRoot(root, path)),
  );
  let configs = workspace.collect([entry]);
  let foregroundServiceKey = if (configs.length > 0 && configs[0].service != null)
    refKey(entry)
  else
    null;
  let hasher = new FileHasher(root);
  let plan = planScripts(
    root,
    configs,
    i64ToString(monotonic() as i64),
    hasher,
    foregroundServiceKey,
  );
  let stateDirs = new GrowableArray<String>();
  let seenDirs = new HashSet<String>();
  for (let config in configs) {
    let stateDir = stateDirOf(refKey(config.ref));
    if (seenDirs.add(stateDir)) {
      stateDirs.push(stateDir);
    }
  }
  let engine = new Engine(
    (data: String) => new Fingerprint('sha256:' + sha256HexOfString(data)),
    new DiskCache(root, () => {
      hasher.markMutated();
    }),
  );
  let result = runFuture(
    engine.run(
      plan.graph,
      plan.leaves,
      loadState(root, stateDirs),
      new RunOptions(jobs),
    ),
  );
  saveState(root, result, foregroundServiceKey);
  let stepKeys = new GrowableArray<String>();
  for (let config in configs) {
    stepKeys.push(refKey(config.ref));
  }
  return new BuildOutcome(result, stepKeys);
}
