{
  "name": "zb-example-site",
  "private": true,
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "command": "mkdir -p out && cat header.txt ../greeting/out/greeting.txt footer.txt > out/index.html",
      "files": [
        "header.txt",
        "footer.txt"
      ],
      "output": [
        "out/**"
      ],
      "dependencies": [
        "../greeting:build"
      ]
    }
  }
}
