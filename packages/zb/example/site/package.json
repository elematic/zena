{
  "name": "zb-example-site",
  "private": true,
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "command": "mkdir -p out && cat header.html ../greeting/out/greeting.txt footer.html > out/index.html",
      "files": [
        "header.html",
        "footer.html"
      ],
      "output": [
        "out/**"
      ],
      "dependencies": [
        "../greeting:build"
      ]
    }
  }
}
