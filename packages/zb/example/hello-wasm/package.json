{
  "name": "zb-example-hello-wasm",
  "private": true,
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "//": "Compiles a real Zena program. The path assumes this workspace sits inside the Zena repo checkout with zena-cli built.",
      "command": "mkdir -p out && ../../../../target/release/zena-cli build src/main.zena -o out/hello.wasm",
      "files": [
        "src/**/*.zena"
      ],
      "output": [
        "out/hello.wasm"
      ]
    }
  }
}
