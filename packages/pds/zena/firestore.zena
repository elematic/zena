/**
 * The PDS's storage in Firestore, with blob bytes in Cloud Storage, so
 * that every server of a deployment shares it. Everything is a tenant's
 * (docs/design/pds.md, "Accounts, organizations and tenants"): its
 * documents are under `tenants/{tenant}`, and its blobs' objects under
 * `{tenant}/`. Under `tenants/{tenant}`:
 *
 * - `accounts/{did}`: `handle` and `manager`, the DID of the App View
 *   that manages it (each absent for none), `kind`, `keyType`, and the
 *   repository signing key: `encryptedKey`, its bytes encrypted by the
 *   store's `KeyEncryption` for the account's DID, or, in a store with
 *   none, `privateKey`, its bytes.
 * - `handles/{handle}`: `did`.
 * - `reservedKeys/{did:key}`: `keyType`, `reservedFor`, the App View's
 *   DID, `expiresAt`, in seconds, and the key, as an account's is kept,
 *   encrypted for its `did:key`; until an account takes it.
 * - `heads/{did}`: `cid` and `rev`, the repository's current commit.
 * - `accounts/{did}/blocks/{cid}`: `bytes`.
 * - `accounts/{did}/collections/{nsid}`, written with the collection's
 *   first record so the collections can be listed; and under it
 *   `records/{rkey}`: `rkey` and `cid`. Lists order by the `rkey` field,
 *   which needs only the indexes Firestore makes itself.
 * - `accounts/{did}/blobs/{cid}`: `mimeType` and `size`. The bytes are
 *   the object `{tenant}/{did}/{cid}` in a `BlobBytes`: a Cloud Storage
 *   bucket, a directory, or memory in tests.
 * - Sessions' (`FirestoreCredentialStore`): `accounts/{did}/appPasswords/{name}`:
 *   `hash` and `createdAt`; and `sessions/{jti}`: `did`, `scope`,
 *   `expiresAt` and `appPassword`, a refresh token not yet spent.
 *
 * The App View's stores (`registry:firestore`) are under the same
 * `tenants/{tenant}`, and share the helpers this exports.
 *
 * Firestore keeps IDs of the form `__…__` for itself, and record keys may
 * take that form, so such a key's document ID is prefixed with `%`, which
 * no record key has.
 *
 * A commit is one transaction, checking the head it was built on. It
 * writes one document for each changed record and each collection a
 * record is put in, and the head; a transaction holds at most 500
 * writes, which the 200 writes `com.atproto.repo.applyWrites` allows fit
 * in. Blocks are written before it, in batches.
 */

import {Future} from 'zena:async';
import {HashMap} from 'zena:collections';
import {exists, mkdir, readFileBytes, rename, writeFileBytes} from 'zena:fs';
import {randomU64} from 'zena:random';
import {Fields, Firestore, Operator, Direction, DocumentReference, DocumentSnapshot, bytesValue, stringValue}
  from 'google-cloud:firestore';
import {Bucket} from 'google-cloud:storage';
import {BlockMap} from 'atproto:car';
import {Cid} from 'atproto:cid';
import {KeyType} from 'atproto:didkey';
import {compareKeys} from 'atproto:mst';
import {AppPassword, CredentialStore, RefreshSession} from './sessions.zena';
import {
  Account, AccountKind, AccountStore, EncryptedKey, Head, KeyEncryption, RecordChange, RecordEntry, ReservedKey,
  SigningKey, Storage, StoredBlob, sameHead, sortRecordEntries
} from './storage.zena';

/** The most writes one batch holds. */
export let BATCH_WRITES = 500;

/** Where blob bytes are kept, by object name. */
export interface BlobBytes {
  /** The bytes of object `name`, or null. */
  read(name: String): Future<FixedArray<u8> | null>;
  write(name: String, bytes: FixedArray<u8>, mimeType: String): Future<void>;
}

/** Blob bytes in a Cloud Storage bucket. */
export final class CloudStorageBlobs implements BlobBytes {
  #bucket: Bucket;

  new(bucket: Bucket) : #bucket = bucket;

  async read(name: String): Future<FixedArray<u8> | null> {
    let bytes = await this.#bucket.read(name);
    return if (bytes == null) null else bytes as FixedArray<u8>;
  }

  async write(name: String, bytes: FixedArray<u8>, mimeType: String): Future<void> {
    await this.#bucket.write(name, bytes as ByteArray, mimeType);
  }
}

/**
 * Blob bytes in files under `root`, one per object, for a server on one
 * machine. A write goes to a temporary file that is renamed into place,
 * so a reader never sees part of one.
 */
export final class DirectoryBlobs implements BlobBytes {
  #root: String;

  new(root: String) : #root = root;

  async read(name: String): Future<FixedArray<u8> | null> {
    let path = `${this.#root}/${name}`;
    return if (await exists(path)) await readFileBytes(path) else null;
  }

  async write(name: String, bytes: FixedArray<u8>, mimeType: String): Future<void> {
    let path = `${this.#root}/${name}`;
    await ensureDirectory(path.sliceBytes(0, lastSlash(path)));
    let temp = `${path}.tmp-${randomU64()}`;
    await writeFileBytes(temp, bytes);
    await rename(temp, path);
  }
}

/** Creates `path` and every directory above it that is missing. */
// TODO(#540): use zena:fs's, once it has one.
async function ensureDirectory(path: String): Future<void> {
  if (path.length == 0 || await exists(path)) {
    return;
  }
  await ensureDirectory(path.sliceBytes(0, lastSlash(path)));
  await mkdir(path);
}

/** The index of the last `/` in `path`, or 0 when there is none. */
function lastSlash(path: String): i32 {
  var i = path.length - 1;
  while (i > 0 && path.getByteAt(i) != 0x2F) {
    i -= 1;
  }
  return i;
}

/** Blob bytes in memory, for tests. */
export final class MemoryBlobs implements BlobBytes {
  #objects = new HashMap<String, FixedArray<u8>>();

  async read(name: String): Future<FixedArray<u8> | null> {
    if (let (true, bytes) = this.#objects.get(name)) {
      return bytes;
    }
    return null;
  }

  async write(name: String, bytes: FixedArray<u8>, mimeType: String): Future<void> {
    this.#objects[name] = bytes;
  }
}

/** The tenant document all of `tenant`'s documents are under. */
export function tenantRoot(db: Firestore, tenant: String) {
  return db.collection('tenants').doc(tenant);
}

/**
 * A tenant's accounts and repositories in `db`, and their blobs' bytes in
 * `blobs`. With `keys`, accounts' signing keys are written encrypted;
 * without, in the clear, and an account whose key is encrypted cannot be
 * read.
 */
export final class FirestoreStorage implements Storage {
  #db: Firestore;
  #root: DocumentReference;
  #tenant: String;
  #blobs: BlobBytes;
  #keys: KeyEncryption | null;

  new(db: Firestore, tenant: String, blobs: BlobBytes, keys: KeyEncryption | null = null)
    : #db = db, #root = tenantRoot(db, tenant), #tenant = tenant, #blobs = blobs, #keys = keys;

  async getAccount(did: String): Future<Account | null> {
    return accountFrom(did, await this.#root.collection('accounts').doc(did).get(), this.#keys);
  }

  async accountByHandle(handle: String): Future<Account | null> {
    let snapshot = await this.#root.collection('handles').doc(handle).get();
    if (let (true, did) = snapshot.getString('did')) {
      let account = await this.getAccount(did);
      // A handle the account has since left is not its.
      if (account != null && account.handle != null && account.handle as String == handle) {
        return account;
      }
    }
    return null;
  }

  /**
   * Stores `account`, and points its handle at it, giving up the handle it
   * had before. Throws when another account has the handle.
   */
  async putAccount(account: Account): Future<void> {
    let root = this.#root;
    let fields = await accountFields(account, this.#keys);
    await this.#db.runTransaction<boolean>(async (tx): Future<boolean> => {
      let ref = root.collection('accounts').doc(account.did);
      let handle = account.handle;
      let claim: DocumentReference | null = if (handle != null) {
        root.collection('handles').doc(handle)
      } else {
        null
      };
      let before = await tx.get(ref);
      let claimed = if (claim != null) await tx.get(claim) else null;
      if (claimed != null && claimed.exists) {
        if (let (true, owner) = claimed.getString('did')) {
          if (owner != account.did) {
            throw new Error(`${handle ?? ''} is the handle of ${owner}`);
          }
        }
      }
      if (let (true, previous) = before.getString('handle')) {
        if (handle == null || previous != handle) {
          tx.delete(root.collection('handles').doc(previous));
        }
      }
      tx.set(ref, fields);
      if (claim != null) {
        tx.set(claim, new Fields().string('did', account.did));
      }
      return true;
    });
  }

  store(did: String): AccountStore {
    return new FirestoreAccountStore(this.#db, this.#root, did, `${this.#tenant}/${did}`, this.#blobs);
  }

  // The private key is kept as an account's is, encrypted for the
  // `did:key` it was reserved under until an account takes it.
  async reserveKey(didKey: String, reserved: ReservedKey): Future<void> {
    let keys = this.#keys;
    let fields = new Fields()
      .string('keyType', keyTypeName(reserved.key.type))
      .string('reservedFor', reserved.reservedFor)
      .integer('expiresAt', reserved.expiresAt);
    if (keys != null) {
      fields.set('encryptedKey', bytesValue(await keys.encrypt(didKey, reserved.key.privateKey) as ByteArray));
    } else {
      fields.set('privateKey', bytesValue(reserved.key.privateKey as ByteArray));
    }
    await this.#root.collection('reservedKeys').doc(didKey).set(fields);
  }

  async takeReservedKey(didKey: String, reservedFor: String, nowSeconds: i64): Future<ReservedKey | null> {
    let ref = this.#root.collection('reservedKeys').doc(didKey);
    var taken: DocumentSnapshot | null = null;
    await this.#db.runTransaction<boolean>(async (tx): Future<boolean> => {
      let snapshot = await tx.get(ref);
      if (!snapshot.exists || stringAt(snapshot, 'reservedFor') != reservedFor) {
        return false;
      }
      tx.delete(ref);
      taken = snapshot;
      return true;
    });
    let snapshot = taken;
    if (snapshot == null) {
      return null;
    }
    let keyType = stringAt(snapshot, 'keyType');
    var expiresAt = 0 as i64;
    if (let (true, value) = snapshot.getInteger('expiresAt')) {
      expiresAt = value;
    }
    if (keyType == null || expiresAt <= nowSeconds) {
      return null;
    }
    var privateKey = bytesAt(snapshot, 'privateKey');
    let ciphertext = bytesAt(snapshot, 'encryptedKey');
    if (ciphertext != null) {
      let keys = this.#keys;
      if (keys == null) {
        throw new Error(`the key reserved as ${didKey} is encrypted, and the server has no key encryption to decrypt it`);
      }
      privateKey = await keys.decrypt(didKey, ciphertext);
    }
    if (privateKey == null) {
      return null;
    }
    return new ReservedKey(new SigningKey(keyTypeNamed(keyType), privateKey), reservedFor, expiresAt);
  }
}

/**
 * One account's repository and blobs in Firestore, under `root`, its
 * tenant's document, with its blobs' bytes under `blobPrefix` in `blobs`.
 */
export final class FirestoreAccountStore implements AccountStore {
  #db: Firestore;
  #root: DocumentReference;
  #did: String;
  #blobPrefix: String;
  #blobs: BlobBytes;

  new(db: Firestore, root: DocumentReference, did: String, blobPrefix: String, blobs: BlobBytes)
    : #db = db, #root = root, #did = did, #blobPrefix = blobPrefix, #blobs = blobs;

  #account(): DocumentReference {
    return this.#root.collection('accounts').doc(this.#did);
  }

  #head(): DocumentReference {
    return this.#root.collection('heads').doc(this.#did);
  }

  #collection(collection: String): DocumentReference {
    return this.#account().collection('collections').doc(collection);
  }

  #record(collection: String, rkey: String): DocumentReference {
    return this.#collection(collection).collection('records').doc(recordId(rkey));
  }

  async getBlock(cid: Cid): Future<FixedArray<u8> | null> {
    let snapshot = await this.#account().collection('blocks').doc(cid.toString()).get();
    return bytesAt(snapshot, 'bytes');
  }

  async putBlocks(blocks: BlockMap): Future<void> {
    let entries = new GrowableArray<(Cid, FixedArray<u8>)>();
    blocks.forEach((cid, bytes) => {
      entries.push((cid, bytes));
    });
    let collection = this.#account().collection('blocks');
    var i = 0;
    while (i < entries.length) {
      let batch = this.#db.batch();
      let end = if (entries.length - i > BATCH_WRITES) i + BATCH_WRITES else entries.length;
      for (var j = i; j < end; j += 1) {
        let (cid, bytes) = entries[j];
        batch.set(collection.doc(cid.toString()), new Fields().set('bytes', bytesValue(bytes as ByteArray)));
      }
      await batch.commit();
      i = end;
    }
  }

  async getRecord(collection: String, rkey: String): Future<Cid | null> {
    return cidAt(await this.#record(collection, rkey).get());
  }

  async listRecords(collection: String, after: String | null, limit: i32, descending: boolean)
      : Future<Array<RecordEntry>> {
    var query = this.#collection(collection).collection('records')
      .orderBy('rkey', if (descending) Direction.Descending else Direction.Ascending)
      .limit(limit);
    if (after != null) {
      query = query.where('rkey', if (descending) Operator.LessThan else Operator.GreaterThan,
          stringValue(after));
    }
    let entries = new GrowableArray<RecordEntry>();
    for (let snapshot in await query.get()) {
      let entry = entryFrom(collection, snapshot);
      if (entry != null) {
        entries.push(entry);
      }
    }
    return entries;
  }

  async allRecords(): Future<Array<RecordEntry>> {
    let entries = new GrowableArray<RecordEntry>();
    for (let collection in await this.#account().collection('collections').get()) {
      for (let snapshot in await this.#collection(collection.id).collection('records').get()) {
        let entry = entryFrom(collection.id, snapshot);
        if (entry != null) {
          entries.push(entry);
        }
      }
    }
    return sortRecordEntries(entries, (a, b) => compareKeys(a.key(), b.key()));
  }

  async getHead(): Future<Head | null> {
    return headFrom(await this.#head().get());
  }

  async commit(previous: Head | null, head: Head, changes: Array<RecordChange>): Future<boolean> {
    let db = this.#db;
    let headRef = this.#head();
    // The references are made before the transaction, whose body cannot
    // call this store's private methods.
    let records = new GrowableArray<DocumentReference>();
    let collections = new HashMap<String, DocumentReference>();
    for (let change in changes) {
      records.push(this.#record(change.collection, change.rkey));
      if (change.cid != null) {
        collections[change.collection] = this.#collection(change.collection);
      }
    }
    return await db.runTransaction<boolean>(async (tx): Future<boolean> => {
      if (!sameHead(headFrom(await tx.get(headRef)), previous)) {
        return false;
      }
      for (var i = 0; i < changes.length; i += 1) {
        let change = changes[i];
        let cid = change.cid;
        if (cid == null) {
          tx.delete(records[i]);
        } else {
          tx.set(records[i], new Fields().string('rkey', change.rkey).string('cid', cid.toString()));
        }
      }
      collections.forEach((name, ref) => {
        tx.set(ref, new Fields().string('name', name));
      });
      tx.set(headRef, new Fields().string('cid', head.cid.toString()).string('rev', head.rev));
      return true;
    });
  }

  async getBlob(cid: Cid): Future<StoredBlob | null> {
    let snapshot = await this.#account().collection('blobs').doc(cid.toString()).get();
    if (let (true, mimeType) = snapshot.getString('mimeType')) {
      let bytes = await this.#blobs.read(`${this.#blobPrefix}/${cid.toString()}`);
      if (bytes != null) {
        return new StoredBlob(mimeType, bytes);
      }
    }
    return null;
  }

  /** Writes the bytes first, so a blob's document always has bytes behind it. */
  async putBlob(cid: Cid, blob: StoredBlob): Future<void> {
    await this.#blobs.write(`${this.#blobPrefix}/${cid.toString()}`, blob.bytes, blob.mimeType);
    await this.#account().collection('blobs').doc(cid.toString())
      .set(new Fields().string('mimeType', blob.mimeType).integer('size', blob.bytes.length as i64));
  }
}

/** App passwords and refresh sessions in Firestore, for `tenant`. */
export final class FirestoreCredentialStore implements CredentialStore {
  #db: Firestore;
  #root: DocumentReference;

  new(db: Firestore, tenant: String) : #db = db, #root = tenantRoot(db, tenant);

  async appPasswords(did: String): Future<Array<AppPassword>> {
    let passwords = new GrowableArray<AppPassword>();
    for (let snapshot in await this.#root.collection('accounts').doc(did).collection('appPasswords').get()) {
      let hash = stringAt(snapshot, 'hash');
      if (hash != null) {
        passwords.push(new AppPassword(snapshot.id, hash, stringAt(snapshot, 'createdAt') ?? ''));
      }
    }
    return passwords;
  }

  async addAppPassword(did: String, password: AppPassword): Future<boolean> {
    return await claim(this.#db, this.#root.collection('accounts').doc(did).collection('appPasswords').doc(password.name),
        new Fields().string('hash', password.hash).string('createdAt', password.createdAt));
  }

  async putSession(session: RefreshSession): Future<void> {
    await this.#root.collection('sessions').doc(session.jti).set(new Fields().string('did', session.did)
      .string('scope', session.scope).integer('expiresAt', session.expiresAt).string('appPassword', session.appPassword));
  }

  async getSession(jti: String): Future<RefreshSession | null> {
    return sessionFrom(jti, await this.#root.collection('sessions').doc(jti).get());
  }

  async takeSession(jti: String): Future<RefreshSession | null> {
    let ref = this.#root.collection('sessions').doc(jti);
    var taken: RefreshSession | null = null;
    await this.#db.runTransaction<boolean>(async (tx): Future<boolean> => {
      taken = sessionFrom(jti, await tx.get(ref));
      if (taken != null) {
        tx.delete(ref);
      }
      return true;
    });
    return taken;
  }
}

/** The refresh session `snapshot` holds, or null. */
function sessionFrom(jti: String, snapshot: DocumentSnapshot): RefreshSession | null {
  let did = stringAt(snapshot, 'did');
  let scope = stringAt(snapshot, 'scope');
  if (did == null || scope == null) {
    return null;
  }
  var expiresAt = 0 as i64;
  if (let (true, value) = snapshot.getInteger('expiresAt')) {
    expiresAt = value;
  }
  return new RefreshSession(jti, did, scope, expiresAt, stringAt(snapshot, 'appPassword') ?? '');
}

/** Creates `ref` with `fields` unless it exists. Returns whether it did. */
export async function claim(db: Firestore, ref: DocumentReference, fields: Fields): Future<boolean> {
  return await db.runTransaction<boolean>(async (tx): Future<boolean> => {
    if ((await tx.get(ref)).exists) {
      return false;
    }
    tx.create(ref, fields);
    return true;
  });
}

/** Deletes `ref` if its `field` is `value`. */
export async function release(db: Firestore, ref: DocumentReference, field: String, value: String): Future<void> {
  await db.runTransaction<boolean>(async (tx): Future<boolean> => {
    if (stringAt(await tx.get(ref), field) == value) {
      tx.delete(ref);
    }
    return true;
  });
}

/** The document ID of record key `rkey`: itself, or `%` and itself when Firestore reserves it. */
export function recordId(rkey: String): String {
  return if (rkey.length >= 4 && rkey.startsWith('__') && rkey.endsWith('__')) `%${rkey}` else rkey;
}

/** The string at `field` in `snapshot`, or null. */
export function stringAt(snapshot: DocumentSnapshot, field: String): String | null {
  if (let (true, value) = snapshot.getString(field)) {
    return value;
  }
  return null;
}

/** The bytes at `field` in `snapshot`, or null. */
export function bytesAt(snapshot: DocumentSnapshot, field: String): FixedArray<u8> | null {
  let value = snapshot.get(field);
  if (value != null && value.hasBytesValue) {
    return value.bytesValue.toByteArray() as FixedArray<u8>;
  }
  return null;
}

/** The CID in `snapshot`'s `cid` field, or null. */
export function cidAt(snapshot: DocumentSnapshot): Cid | null {
  let text = stringAt(snapshot, 'cid');
  return if (text == null) null else Cid.parse(text);
}

function headFrom(snapshot: DocumentSnapshot): Head | null {
  let cid = cidAt(snapshot);
  let rev = stringAt(snapshot, 'rev');
  if (cid == null || rev == null) {
    return null;
  }
  return new Head(cid, rev);
}

function entryFrom(collection: String, snapshot: DocumentSnapshot): RecordEntry | null {
  let rkey = stringAt(snapshot, 'rkey');
  let cid = cidAt(snapshot);
  if (rkey == null || cid == null) {
    return null;
  }
  return new RecordEntry(collection, rkey, cid);
}

/**
 * `account`'s document: its signing key as it was read, if it was read
 * encrypted, or else encrypted with `keys`, or in the clear without.
 */
async function accountFields(account: Account, keys: KeyEncryption | null): Future<Fields> {
  let fields = new Fields().string('kind', kindName(account.kind));
  let encrypted = account.encryptedKey;
  if (encrypted != null) {
    fields.string('keyType', keyTypeName(encrypted.type))
      .set('encryptedKey', bytesValue(encrypted.ciphertext as ByteArray));
  } else {
    let key = await account.signingKey();
    fields.string('keyType', keyTypeName(key.type));
    if (keys != null) {
      fields.set('encryptedKey', bytesValue(await keys.encrypt(account.did, key.privateKey) as ByteArray));
    } else {
      fields.set('privateKey', bytesValue(key.privateKey as ByteArray));
    }
  }
  let handle = account.handle;
  if (handle != null) {
    fields.string('handle', handle);
  }
  let manager = account.manager;
  if (manager != null) {
    fields.string('manager', manager);
  }
  return fields;
}

/**
 * The account in `snapshot`, with its signing key encrypted by `keys`, or
 * in the clear; null when there is none. Throws for an encrypted key
 * without `keys`.
 */
function accountFrom(did: String, snapshot: DocumentSnapshot, keys: KeyEncryption | null): Account | null {
  let kind = stringAt(snapshot, 'kind');
  let keyType = stringAt(snapshot, 'keyType');
  if (kind == null || keyType == null) {
    return null;
  }
  let type = keyTypeNamed(keyType);
  let handle = stringAt(snapshot, 'handle');
  var account: Account | null = null;
  let ciphertext = bytesAt(snapshot, 'encryptedKey');
  if (ciphertext != null) {
    if (keys == null) {
      throw new Error(`${did}'s signing key is encrypted, and the server has no key encryption (PDS_KEY_ENCRYPTION_KMS_KEY) to decrypt it`);
    }
    account = new Account(did, handle, new EncryptedKey(type, ciphertext, keys), kindNamed(kind));
  } else {
    let privateKey = bytesAt(snapshot, 'privateKey');
    if (privateKey == null) {
      return null;
    }
    account = new Account(did, handle, new SigningKey(type, privateKey), kindNamed(kind));
  }
  account.manager = stringAt(snapshot, 'manager');
  return account;
}

/** How a document names `kind`. */
export function kindName(kind: AccountKind): String {
  return match (kind) {
    case AccountKind.Person: 'person'
    case AccountKind.Package: 'package'
    case AccountKind.Organization: 'organization'
    case AccountKind.Automation: 'automation'
  };
}

/** The kind of account a document names `name`. */
export function kindNamed(name: String): AccountKind {
  if (name == 'package') {
    return AccountKind.Package;
  }
  if (name == 'organization') {
    return AccountKind.Organization;
  }
  if (name == 'automation') {
    return AccountKind.Automation;
  }
  if (name == 'person') {
    return AccountKind.Person;
  }
  throw new Error(`an account of an unknown kind: ${name}`);
}

function keyTypeName(type: KeyType): String {
  return if (type == KeyType.P256) 'p256' else 'secp256k1';
}

function keyTypeNamed(name: String): KeyType {
  if (name == 'p256') {
    return KeyType.P256;
  }
  if (name == 'secp256k1') {
    return KeyType.Secp256k1;
  }
  throw new Error(`a signing key of an unknown type: ${name}`);
}
