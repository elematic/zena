/**
 * The PDS's storage in Firestore, with blob bytes in Cloud Storage, so
 * that every server of a deployment shares it. Everything is a tenant's
 * (docs/design/pds.md, "Accounts, organizations and tenants"): its
 * documents are under `tenants/{tenant}`, and its blobs' objects under
 * `{tenant}/`. Under `tenants/{tenant}`:
 *
 * - `accounts/{did}`: `handle` (absent for none), `kind`, `keyType`, and
 *   the repository signing key: `encryptedKey`, its bytes encrypted by
 *   the store's `KeyEncryption` for the account's DID, or, in a store
 *   with none, `privateKey`, its bytes.
 * - `handles/{handle}`: `did`.
 * - `heads/{did}`: `cid` and `rev`, the repository's current commit.
 * - `accounts/{did}/blocks/{cid}`: `bytes`.
 * - `accounts/{did}/collections/{nsid}`, written with the collection's
 *   first record so the collections can be listed; and under it
 *   `records/{rkey}`: `rkey` and `cid`. Lists order by the `rkey` field,
 *   which needs only the indexes Firestore makes itself.
 * - `accounts/{did}/blobs/{cid}`: `mimeType` and `size`. The bytes are
 *   the object `{tenant}/{did}/{cid}` in a `BlobBytes`: a Cloud Storage
 *   bucket, a directory, or memory in tests.
 * - A staging PLC directory's (`FirestorePlcLog`): `plc/{did}`: `length`,
 *   the number of operations; and under it `ops/{index}`: `json`, each
 *   operation, with indexes padded to eight digits so they list in order.
 * - The package host's (`FirestoreHostStore`): `scopes/{scope}`: `org`;
 *   `names/{name}.{scope}`: `did`, `scope` and `name`;
 *   `summaries/{did}`: a package's summary, `handle`, `scope`, `name`,
 *   `description`, `license` and `latest` (each absent for none),
 *   `releases`, and `rev`, the revision of the commit it was made from; and
 *   `entries/{did}/list/{id}`: `cbor`, a member entry's DAG-CBOR.
 * - Sessions' (`FirestoreCredentialStore`): `accounts/{did}/appPasswords/{name}`:
 *   `hash` and `createdAt`; and `sessions/{jti}`: `did`, `scope`,
 *   `expiresAt` and `appPassword`, a refresh token not yet spent.
 *
 * Firestore keeps IDs of the form `__…__` for itself, and record keys may
 * take that form, so such a key's document ID is prefixed with `%`, which
 * no record key has.
 *
 * A commit is one transaction, checking the head it was built on. It
 * writes one document for each changed record and each collection a
 * record is put in, and the head; a transaction holds at most 500
 * writes, which the 200 writes `com.atproto.repo.applyWrites` allows fit
 * in. Blocks are written before it, in batches.
 */

import {Future} from 'zena:async';
import {HashMap} from 'zena:collections';
import {existsSync, mkdirSync, readFileBytesSync, renameSync, writeFileBytesSync} from 'zena:fs';
import {randomU64} from 'zena:random';
import {CollectionReference, Fields, Firestore, Operator, Direction, DocumentReference, DocumentSnapshot, Transaction,
  bytesValue, stringValue} from 'google-cloud:firestore';
import {Bucket} from 'google-cloud:storage';
import {BlockMap} from 'atproto:car';
import {decodeCbor, encodeCbor} from 'atproto:cbor';
import {Cid} from 'atproto:cid';
import {KeyType} from 'atproto:didkey';
import {compareKeys} from 'atproto:mst';
import {MemberEntry} from 'package-manager:records';
import {JsonValue, parseJson, stringify} from 'zena:json';
import {PlcOperation} from 'atproto:plc';
import {ClaimedName, ClaimedScope, HostStore, PackageSummary, PendingChange, PendingRelease} from './host.zena';
import {PlcLog} from './plc-directory.zena';
import {AppPassword, CredentialStore, RefreshSession} from './sessions.zena';
import {
  Account, AccountKind, AccountStore, EncryptedKey, Head, KeyEncryption, RecordChange, RecordEntry, SigningKey,
  Storage, StoredBlob, sameHead, sortRecordEntries
} from './storage.zena';

/** The most writes one batch of blocks holds. */
let BATCH_WRITES = 500;

/** Where blob bytes are kept, by object name. */
export interface BlobBytes {
  /** The bytes of object `name`, or null. */
  read(name: String): Future<FixedArray<u8> | null>;
  write(name: String, bytes: FixedArray<u8>, mimeType: String): Future<void>;
}

/** Blob bytes in a Cloud Storage bucket. */
export final class CloudStorageBlobs implements BlobBytes {
  #bucket: Bucket;

  new(bucket: Bucket) : #bucket = bucket;

  async read(name: String): Future<FixedArray<u8> | null> {
    let bytes = await this.#bucket.read(name);
    return if (bytes == null) null else bytes as FixedArray<u8>;
  }

  async write(name: String, bytes: FixedArray<u8>, mimeType: String): Future<void> {
    await this.#bucket.write(name, bytes as ByteArray, mimeType);
  }
}

/**
 * Blob bytes in files under `root`, one per object, for a server on one
 * machine. A write goes to a temporary file that is renamed into place,
 * so a reader never sees part of one.
 */
export final class DirectoryBlobs implements BlobBytes {
  #root: String;

  new(root: String) : #root = root;

  async read(name: String): Future<FixedArray<u8> | null> {
    let path = `${this.#root}/${name}`;
    return if (existsSync(path)) readFileBytesSync(path) as FixedArray<u8> else null;
  }

  async write(name: String, bytes: FixedArray<u8>, mimeType: String): Future<void> {
    let path = `${this.#root}/${name}`;
    ensureDirectory(path.sliceBytes(0, lastSlash(path)));
    let temp = `${path}.tmp-${randomU64()}`;
    writeFileBytesSync(temp, bytes);
    renameSync(temp, path);
  }
}

/** Creates `path` and every directory above it that is missing. */
// TODO(#540): use zena:fs's, once it has one.
function ensureDirectory(path: String): void {
  if (path.length == 0 || existsSync(path)) {
    return;
  }
  ensureDirectory(path.sliceBytes(0, lastSlash(path)));
  mkdirSync(path);
}

/** The index of the last `/` in `path`, or 0 when there is none. */
function lastSlash(path: String): i32 {
  var i = path.length - 1;
  while (i > 0 && path.getByteAt(i) != 0x2F) {
    i -= 1;
  }
  return i;
}

/** Blob bytes in memory, for tests. */
export final class MemoryBlobs implements BlobBytes {
  #objects = new HashMap<String, FixedArray<u8>>();

  async read(name: String): Future<FixedArray<u8> | null> {
    if (let (true, bytes) = this.#objects.get(name)) {
      return bytes;
    }
    return null;
  }

  async write(name: String, bytes: FixedArray<u8>, mimeType: String): Future<void> {
    this.#objects[name] = bytes;
  }
}

/** The tenant document all of `tenant`'s documents are under. */
function tenantRoot(db: Firestore, tenant: String): DocumentReference {
  return db.collection('tenants').doc(tenant);
}

/**
 * A tenant's accounts and repositories in `db`, and their blobs' bytes in
 * `blobs`. With `keys`, accounts' signing keys are written encrypted;
 * without, in the clear, and an account whose key is encrypted cannot be
 * read.
 */
export final class FirestoreStorage implements Storage {
  #db: Firestore;
  #root: DocumentReference;
  #tenant: String;
  #blobs: BlobBytes;
  #keys: KeyEncryption | null;

  new(db: Firestore, tenant: String, blobs: BlobBytes, keys: KeyEncryption | null = null)
    : #db = db, #root = tenantRoot(db, tenant), #tenant = tenant, #blobs = blobs, #keys = keys;

  async getAccount(did: String): Future<Account | null> {
    return accountFrom(did, await this.#root.collection('accounts').doc(did).get(), this.#keys);
  }

  /**
   * Encrypts each signing key the tenant keeps in the clear, written
   * before the store had `keys`, and returns how many it encrypted.
   * Throws without `keys`.
   */
  async encryptKeys(): Future<i32> {
    let keys = this.#keys;
    if (keys == null) {
      throw new Error('there is no key encryption to encrypt signing keys with');
    }
    var encrypted = 0;
    let accounts = this.#root.collection('accounts');
    for (let listed in await accounts.get()) {
      if (bytesAt(listed, 'privateKey') == null) {
        continue;
      }
      let did = listed.id;
      let ref = listed.ref;
      // Read again in the transaction, so that a key another run or server
      // encrypted first is left as it is.
      let changed = await this.#db.runTransaction<boolean>(async (tx: Transaction): Future<boolean> => {
        let privateKey = bytesAt(await tx.get(ref), 'privateKey');
        if (privateKey == null) {
          return false;
        }
        let ciphertext = await keys.encrypt(did, privateKey as FixedArray<u8>);
        tx.update(ref, new Fields().set('encryptedKey', bytesValue(ciphertext as ByteArray)).deleteField('privateKey'));
        return true;
      });
      if (changed) {
        encrypted += 1;
      }
    }
    return encrypted;
  }

  async accountByHandle(handle: String): Future<Account | null> {
    let snapshot = await this.#root.collection('handles').doc(handle).get();
    if (let (true, did) = snapshot.getString('did')) {
      let account = await this.getAccount(did);
      // A handle the account has since left is not its.
      if (account != null && account.handle != null && account.handle as String == handle) {
        return account;
      }
    }
    return null;
  }

  /**
   * Stores `account`, and points its handle at it, giving up the handle it
   * had before. Throws when another account has the handle.
   */
  async putAccount(account: Account): Future<void> {
    let root = this.#root;
    let fields = await accountFields(account, this.#keys);
    await this.#db.runTransaction<boolean>(async (tx: Transaction): Future<boolean> => {
      let ref = root.collection('accounts').doc(account.did);
      let handle = account.handle;
      var claim: DocumentReference | null = null;
      if (handle != null) {
        claim = root.collection('handles').doc(handle);
      }
      let before = await tx.get(ref);
      let claimed = if (claim != null) await tx.get(claim) else null;
      if (claimed != null && claimed.exists) {
        if (let (true, owner) = claimed.getString('did')) {
          if (owner != account.did) {
            throw new Error(`${handle ?? ''} is the handle of ${owner}`);
          }
        }
      }
      if (let (true, previous) = before.getString('handle')) {
        if (handle == null || previous != handle as String) {
          tx.delete(root.collection('handles').doc(previous));
        }
      }
      tx.set(ref, fields);
      if (claim != null) {
        tx.set(claim, new Fields().string('did', account.did));
      }
      return true;
    });
  }

  store(did: String): AccountStore {
    return new FirestoreAccountStore(this.#db, this.#root, did, `${this.#tenant}/${did}`, this.#blobs);
  }
}

/**
 * One account's repository and blobs in Firestore, under `root`, its
 * tenant's document, with its blobs' bytes under `blobPrefix` in `blobs`.
 */
export final class FirestoreAccountStore implements AccountStore {
  #db: Firestore;
  #root: DocumentReference;
  #did: String;
  #blobPrefix: String;
  #blobs: BlobBytes;

  new(db: Firestore, root: DocumentReference, did: String, blobPrefix: String, blobs: BlobBytes)
    : #db = db, #root = root, #did = did, #blobPrefix = blobPrefix, #blobs = blobs;

  #account(): DocumentReference {
    return this.#root.collection('accounts').doc(this.#did);
  }

  #head(): DocumentReference {
    return this.#root.collection('heads').doc(this.#did);
  }

  #collection(collection: String): DocumentReference {
    return this.#account().collection('collections').doc(collection);
  }

  #record(collection: String, rkey: String): DocumentReference {
    return this.#collection(collection).collection('records').doc(recordId(rkey));
  }

  async getBlock(cid: Cid): Future<FixedArray<u8> | null> {
    let snapshot = await this.#account().collection('blocks').doc(cid.toString()).get();
    return bytesAt(snapshot, 'bytes');
  }

  async putBlocks(blocks: BlockMap): Future<void> {
    let entries = new GrowableArray<(Cid, FixedArray<u8>)>();
    blocks.forEach((cid, bytes) => {
      entries.push((cid, bytes));
    });
    let collection = this.#account().collection('blocks');
    var i = 0;
    while (i < entries.length) {
      let batch = this.#db.batch();
      let end = if (entries.length - i > BATCH_WRITES) i + BATCH_WRITES else entries.length;
      for (var j = i; j < end; j += 1) {
        let (cid, bytes) = entries[j];
        batch.set(collection.doc(cid.toString()), new Fields().set('bytes', bytesValue(bytes as ByteArray)));
      }
      await batch.commit();
      i = end;
    }
  }

  async getRecord(collection: String, rkey: String): Future<Cid | null> {
    return cidAt(await this.#record(collection, rkey).get());
  }

  async listRecords(collection: String, after: String | null, limit: i32, descending: boolean)
      : Future<Array<RecordEntry>> {
    var query = this.#collection(collection).collection('records')
      .orderBy('rkey', if (descending) Direction.Descending else Direction.Ascending)
      .limit(limit);
    if (after != null) {
      query = query.where('rkey', if (descending) Operator.LessThan else Operator.GreaterThan,
          stringValue(after as String));
    }
    let entries = new GrowableArray<RecordEntry>();
    for (let snapshot in await query.get()) {
      let entry = entryFrom(collection, snapshot);
      if (entry != null) {
        entries.push(entry as RecordEntry);
      }
    }
    return entries;
  }

  async allRecords(): Future<Array<RecordEntry>> {
    let entries = new GrowableArray<RecordEntry>();
    for (let collection in await this.#account().collection('collections').get()) {
      for (let snapshot in await this.#collection(collection.id).collection('records').get()) {
        let entry = entryFrom(collection.id, snapshot);
        if (entry != null) {
          entries.push(entry as RecordEntry);
        }
      }
    }
    return sortRecordEntries(entries, (a, b) => compareKeys(a.key(), b.key()));
  }

  async getHead(): Future<Head | null> {
    return headFrom(await this.#head().get());
  }

  async commit(previous: Head | null, head: Head, changes: Array<RecordChange>): Future<boolean> {
    let db = this.#db;
    let headRef = this.#head();
    // The references are made before the transaction, whose body cannot
    // call this store's private methods.
    let records = new GrowableArray<DocumentReference>();
    let collections = new HashMap<String, DocumentReference>();
    for (let change in changes) {
      records.push(this.#record(change.collection, change.rkey));
      if (change.cid != null) {
        collections[change.collection] = this.#collection(change.collection);
      }
    }
    return await db.runTransaction<boolean>(async (tx: Transaction): Future<boolean> => {
      if (!sameHead(headFrom(await tx.get(headRef)), previous)) {
        return false;
      }
      for (var i = 0; i < changes.length; i += 1) {
        let change = changes[i];
        let cid = change.cid;
        if (cid == null) {
          tx.delete(records[i]);
        } else {
          tx.set(records[i], new Fields().string('rkey', change.rkey).string('cid', cid.toString()));
        }
      }
      collections.forEach((name, ref) => {
        tx.set(ref, new Fields().string('name', name));
      });
      tx.set(headRef, new Fields().string('cid', head.cid.toString()).string('rev', head.rev));
      return true;
    });
  }

  async getBlob(cid: Cid): Future<StoredBlob | null> {
    let snapshot = await this.#account().collection('blobs').doc(cid.toString()).get();
    if (let (true, mimeType) = snapshot.getString('mimeType')) {
      let bytes = await this.#blobs.read(`${this.#blobPrefix}/${cid.toString()}`);
      if (bytes != null) {
        return new StoredBlob(mimeType, bytes as FixedArray<u8>);
      }
    }
    return null;
  }

  /** Writes the bytes first, so a blob's document always has bytes behind it. */
  async putBlob(cid: Cid, blob: StoredBlob): Future<void> {
    await this.#blobs.write(`${this.#blobPrefix}/${cid.toString()}`, blob.bytes, blob.mimeType);
    await this.#account().collection('blobs').doc(cid.toString())
      .set(new Fields().string('mimeType', blob.mimeType).integer('size', blob.bytes.length as i64));
  }
}

/** The package host's names and entries in Firestore, for `tenant`. */
export final class FirestoreHostStore implements HostStore {
  #db: Firestore;
  #root: DocumentReference;

  new(db: Firestore, tenant: String) : #db = db, #root = tenantRoot(db, tenant);

  async scopeOwner(scope: String): Future<String | null> {
    return stringAt(await this.#root.collection('scopes').doc(scope).get(), 'org');
  }

  async claimScope(scope: String, org: String): Future<boolean> {
    return await claim(this.#db, this.#root.collection('scopes').doc(scope), new Fields().string('org', org));
  }

  async releaseScope(scope: String, org: String): Future<void> {
    await release(this.#db, this.#root.collection('scopes').doc(scope), 'org', org);
  }

  async nameInScope(scope: String, name: String): Future<String | null> {
    return stringAt(await this.#root.collection('names').doc(`${name}.${scope}`).get(), 'did');
  }

  async claimName(scope: String, name: String, did: String): Future<boolean> {
    return await claim(this.#db, this.#root.collection('names').doc(`${name}.${scope}`),
        new Fields().string('did', did).string('scope', scope).string('name', name));
  }

  async releaseName(scope: String, name: String, did: String): Future<void> {
    await release(this.#db, this.#root.collection('names').doc(`${name}.${scope}`), 'did', did);
  }

  async allScopes(): Future<Array<ClaimedScope>> {
    let all = new GrowableArray<ClaimedScope>();
    for (let snapshot in await this.#root.collection('scopes').get()) {
      let org = stringAt(snapshot, 'org');
      if (org != null) {
        all.push(new ClaimedScope(snapshot.id, org as String));
      }
    }
    return all;
  }

  async allNames(): Future<Array<ClaimedName>> {
    let all = new GrowableArray<ClaimedName>();
    for (let snapshot in await this.#root.collection('names').get()) {
      let scope = stringAt(snapshot, 'scope');
      let name = stringAt(snapshot, 'name');
      let did = stringAt(snapshot, 'did');
      if (scope != null && name != null && did != null) {
        all.push(new ClaimedName(scope as String, name as String, did as String));
      }
    }
    return all;
  }

  async putSummary(summary: PackageSummary, rev: String): Future<void> {
    let ref = this.#root.collection('summaries').doc(summary.did);
    await this.#db.runTransaction<boolean>(async (tx: Transaction): Future<boolean> => {
      let kept = stringAt(await tx.get(ref), 'rev');
      if (kept != null && compareKeys(kept as String, rev) >= 0) {
        return false;
      }
      let fields = new Fields()
        .string('handle', summary.handle)
        .string('scope', summary.scope)
        .string('name', summary.name)
        .integer('releases', summary.releases as i64)
        .string('rev', rev);
      if (summary.description != null) {
        fields.string('description', summary.description as String);
      }
      if (summary.license != null) {
        fields.string('license', summary.license as String);
      }
      if (summary.latest != null) {
        fields.string('latest', summary.latest as String);
      }
      tx.set(ref, fields);
      return true;
    });
  }

  async summaries(scope: String | null): Future<Array<PackageSummary>> {
    let collection = this.#root.collection('summaries');
    let snapshots = if (scope != null) await collection.where('scope', Operator.Equal, stringValue(scope)).get()
        else await collection.get();
    let out = new GrowableArray<PackageSummary>();
    for (let snapshot in snapshots) {
      let handle = stringAt(snapshot, 'handle');
      let inScope = stringAt(snapshot, 'scope');
      let name = stringAt(snapshot, 'name');
      if (handle == null || inScope == null || name == null) {
        continue;
      }
      let summary = new PackageSummary(snapshot.id, handle as String, inScope as String, name as String);
      summary.description = stringAt(snapshot, 'description');
      summary.license = stringAt(snapshot, 'license');
      summary.latest = stringAt(snapshot, 'latest');
      if (let (true, releases) = snapshot.getInteger('releases')) {
        summary.releases = releases as i32;
      }
      out.push(summary);
    }
    return out;
  }

  async entries(account: String): Future<Array<MemberEntry>> {
    let entries = new GrowableArray<MemberEntry>();
    for (let snapshot in await this.#root.collection('entries').doc(account).collection('list').get()) {
      let bytes = bytesAt(snapshot, 'cbor');
      if (bytes != null) {
        entries.push(MemberEntry.fromValue(decodeCbor(bytes as FixedArray<u8>)));
      }
    }
    return entries;
  }

  /** Held releases, at `pending/<pkg>/releases/<version>`. */
  #held(pkg: String): CollectionReference {
    return this.#root.collection('pending').doc(pkg).collection('releases');
  }

  async holdRelease(pkg: String, release: PendingRelease): Future<boolean> {
    return await claim(this.#db, this.#held(pkg).doc(recordId(release.version)), new Fields()
        .set('cbor', bytesValue(release.record as ByteArray))
        .string('cid', release.cid.toString())
        .string('publisher', release.publisher)
        .integer('heldAt', release.heldAt));
  }

  async heldRelease(pkg: String, version: String): Future<PendingRelease | null> {
    return pendingAt(await this.#held(pkg).doc(recordId(version)).get(), version);
  }

  async heldReleases(pkg: String): Future<Array<PendingRelease>> {
    let held = new GrowableArray<PendingRelease>();
    for (let snapshot in await this.#held(pkg).get()) {
      let release = pendingAt(snapshot, null);
      if (release != null) {
        held.push(release as PendingRelease);
      }
    }
    return held;
  }

  async dropRelease(pkg: String, version: String): Future<void> {
    await this.#held(pkg).doc(recordId(version)).delete();
  }

  /** Held changes, at `pending/<account>/changes/<collection> <rkey>`. */
  #changes(account: String): CollectionReference {
    return this.#root.collection('pending').doc(account).collection('changes');
  }

  async holdChange(account: String, change: PendingChange): Future<void> {
    var fields = new Fields()
        .string('collection', change.collection)
        .string('rkey', change.rkey)
        .set('cbor', bytesValue(change.record as ByteArray))
        .string('cid', change.cid.toString())
        .string('proposer', change.proposer)
        .integer('heldAt', change.heldAt);
    let base = change.base;
    if (base != null) {
      fields = fields.string('base', base.toString());
    }
    await this.#changes(account).doc(changeId(change.collection, change.rkey)).set(fields);
  }

  async heldChange(account: String, collection: String, rkey: String): Future<PendingChange | null> {
    return changeAt(await this.#changes(account).doc(changeId(collection, rkey)).get());
  }

  async heldChanges(account: String): Future<Array<PendingChange>> {
    let held = new GrowableArray<PendingChange>();
    for (let snapshot in await this.#changes(account).get()) {
      let change = changeAt(snapshot);
      if (change != null) {
        held.push(change as PendingChange);
      }
    }
    return held;
  }

  async dropChange(account: String, collection: String, rkey: String, cid: Cid): Future<void> {
    await release(this.#db, this.#changes(account).doc(changeId(collection, rkey)), 'cid', cid.toString());
  }

  /** Adds `entries`, each under the base32 CID of its DAG-CBOR, its commitment. */
  async addEntries(account: String, entries: Array<MemberEntry>): Future<void> {
    let list = this.#root.collection('entries').doc(account).collection('list');
    let batch = this.#db.batch();
    for (let entry in entries) {
      let bytes = encodeCbor(entry.toValue());
      batch.set(list.doc(entry.commitment().toString()), new Fields().set('cbor', bytesValue(bytes as ByteArray)));
    }
    await batch.commit();
  }
}

/** App passwords and refresh sessions in Firestore, for `tenant`. */
export final class FirestoreCredentialStore implements CredentialStore {
  #db: Firestore;
  #root: DocumentReference;

  new(db: Firestore, tenant: String) : #db = db, #root = tenantRoot(db, tenant);

  async appPasswords(did: String): Future<Array<AppPassword>> {
    let passwords = new GrowableArray<AppPassword>();
    for (let snapshot in await this.#root.collection('accounts').doc(did).collection('appPasswords').get()) {
      let hash = stringAt(snapshot, 'hash');
      if (hash != null) {
        passwords.push(new AppPassword(snapshot.id, hash as String, stringAt(snapshot, 'createdAt') ?? ''));
      }
    }
    return passwords;
  }

  async addAppPassword(did: String, password: AppPassword): Future<boolean> {
    return await claim(this.#db, this.#root.collection('accounts').doc(did).collection('appPasswords').doc(password.name),
        new Fields().string('hash', password.hash).string('createdAt', password.createdAt));
  }

  async putSession(session: RefreshSession): Future<void> {
    await this.#root.collection('sessions').doc(session.jti).set(new Fields().string('did', session.did)
      .string('scope', session.scope).integer('expiresAt', session.expiresAt).string('appPassword', session.appPassword));
  }

  async getSession(jti: String): Future<RefreshSession | null> {
    return sessionFrom(jti, await this.#root.collection('sessions').doc(jti).get());
  }

  async takeSession(jti: String): Future<RefreshSession | null> {
    let ref = this.#root.collection('sessions').doc(jti);
    var taken: RefreshSession | null = null;
    await this.#db.runTransaction<boolean>(async (tx: Transaction): Future<boolean> => {
      taken = sessionFrom(jti, await tx.get(ref));
      if (taken != null) {
        tx.delete(ref);
      }
      return true;
    });
    return taken;
  }
}

/** The refresh session `snapshot` holds, or null. */
function sessionFrom(jti: String, snapshot: DocumentSnapshot): RefreshSession | null {
  let did = stringAt(snapshot, 'did');
  let scope = stringAt(snapshot, 'scope');
  if (did == null || scope == null) {
    return null;
  }
  var expiresAt = 0 as i64;
  if (let (true, value) = snapshot.getInteger('expiresAt')) {
    expiresAt = value;
  }
  return new RefreshSession(jti, did as String, scope as String, expiresAt, stringAt(snapshot, 'appPassword') ?? '');
}

/** A staging PLC directory's operations in Firestore, for `tenant`. */
export final class FirestorePlcLog implements PlcLog {
  #db: Firestore;
  #root: DocumentReference;

  new(db: Firestore, tenant: String) : #db = db, #root = tenantRoot(db, tenant);

  async operations(did: String): Future<Array<PlcOperation>> {
    let operations = new GrowableArray<PlcOperation>();
    for (let snapshot in await this.#root.collection('plc').doc(did).collection('ops').get()) {
      let text = stringAt(snapshot, 'json');
      if (text != null) {
        operations.push(PlcOperation.fromJson(parseJson(text as String)));
      }
    }
    return operations;
  }

  async append(did: String, index: i32, operation: PlcOperation): Future<boolean> {
    let head = this.#root.collection('plc').doc(did);
    let entry = head.collection('ops').doc(padIndex(index));
    let json = stringify(operation.toJson());
    return await this.#db.runTransaction<boolean>(async (tx: Transaction): Future<boolean> => {
      var length = 0 as i64;
      if (let (true, recorded) = (await tx.get(head)).getInteger('length')) {
        length = recorded;
      }
      if (length != index as i64) {
        return false;
      }
      tx.set(entry, new Fields().string('json', json));
      tx.set(head, new Fields().integer('length', (index + 1) as i64));
      return true;
    });
  }
}

/** `index` with zeros before it, to eight digits. */
function padIndex(index: i32): String {
  var text = `${index}`;
  while (text.length < 8) {
    text = `0${text}`;
  }
  return text;
}

/** Creates `ref` with `fields` unless it exists. Returns whether it did. */
async function claim(db: Firestore, ref: DocumentReference, fields: Fields): Future<boolean> {
  return await db.runTransaction<boolean>(async (tx: Transaction): Future<boolean> => {
    if ((await tx.get(ref)).exists) {
      return false;
    }
    tx.create(ref, fields);
    return true;
  });
}

/** Deletes `ref` if its `field` is `value`. */
async function release(db: Firestore, ref: DocumentReference, field: String, value: String): Future<void> {
  await db.runTransaction<boolean>(async (tx: Transaction): Future<boolean> => {
    if (stringAt(await tx.get(ref), field) == value) {
      tx.delete(ref);
    }
    return true;
  });
}

/** The document ID of record key `rkey`: itself, or `%` and itself when Firestore reserves it. */
export function recordId(rkey: String): String {
  return if (rkey.length >= 4 && rkey.startsWith('__') && rkey.endsWith('__')) `%${rkey}` else rkey;
}

function stringAt(snapshot: DocumentSnapshot, field: String): String | null {
  if (let (true, value) = snapshot.getString(field)) {
    return value;
  }
  return null;
}

function bytesAt(snapshot: DocumentSnapshot, field: String): FixedArray<u8> | null {
  let value = snapshot.get(field);
  if (value != null && value.hasBytesValue) {
    return value.bytesValue.toByteArray() as FixedArray<u8>;
  }
  return null;
}

/** The held release `snapshot` is, at `version` or its own ID's; null when it does not exist. */
function pendingAt(snapshot: DocumentSnapshot, version: String | null): PendingRelease | null {
  let record = bytesAt(snapshot, 'cbor');
  let cid = cidAt(snapshot);
  let publisher = stringAt(snapshot, 'publisher');
  if (record == null || cid == null || publisher == null) {
    return null;
  }
  var heldAt = 0 as i64;
  if (let (true, micros) = snapshot.getInteger('heldAt')) {
    heldAt = micros;
  }
  let id = snapshot.id;
  let key = version ?? (if (id.startsWith('%')) id.sliceBytes(1, id.length) else id);
  return new PendingRelease(key, record as FixedArray<u8>, cid as Cid, publisher as String, heldAt);
}

/** The document ID of the held change to the record at `collection/rkey`. */
function changeId(collection: String, rkey: String): String {
  return `${collection} ${rkey}`;
}

/** The held change `snapshot` is; null when it does not exist. */
function changeAt(snapshot: DocumentSnapshot): PendingChange | null {
  let collection = stringAt(snapshot, 'collection');
  let rkey = stringAt(snapshot, 'rkey');
  let record = bytesAt(snapshot, 'cbor');
  let cid = cidAt(snapshot);
  let proposer = stringAt(snapshot, 'proposer');
  if (collection == null || rkey == null || record == null || cid == null || proposer == null) {
    return null;
  }
  let base = stringAt(snapshot, 'base');
  var heldAt = 0 as i64;
  if (let (true, micros) = snapshot.getInteger('heldAt')) {
    heldAt = micros;
  }
  return new PendingChange(collection as String, rkey as String, record as FixedArray<u8>, cid as Cid,
      if (base == null) null else Cid.parse(base as String), proposer as String, heldAt);
}

function cidAt(snapshot: DocumentSnapshot): Cid | null {
  let text = stringAt(snapshot, 'cid');
  return if (text == null) null else Cid.parse(text as String);
}

function headFrom(snapshot: DocumentSnapshot): Head | null {
  let cid = cidAt(snapshot);
  let rev = stringAt(snapshot, 'rev');
  if (cid == null || rev == null) {
    return null;
  }
  return new Head(cid as Cid, rev as String);
}

function entryFrom(collection: String, snapshot: DocumentSnapshot): RecordEntry | null {
  let rkey = stringAt(snapshot, 'rkey');
  let cid = cidAt(snapshot);
  if (rkey == null || cid == null) {
    return null;
  }
  return new RecordEntry(collection, rkey as String, cid as Cid);
}

/**
 * `account`'s document: its signing key as it was read, if it was read
 * encrypted, or else encrypted with `keys`, or in the clear without.
 */
async function accountFields(account: Account, keys: KeyEncryption | null): Future<Fields> {
  let fields = new Fields().string('kind', kindName(account.kind));
  let encrypted = account.encryptedKey;
  if (encrypted != null) {
    fields.string('keyType', keyTypeName(encrypted.type))
      .set('encryptedKey', bytesValue(encrypted.ciphertext as ByteArray));
  } else {
    let key = await account.signingKey();
    fields.string('keyType', keyTypeName(key.type));
    if (keys != null) {
      fields.set('encryptedKey', bytesValue(await keys.encrypt(account.did, key.privateKey) as ByteArray));
    } else {
      fields.set('privateKey', bytesValue(key.privateKey as ByteArray));
    }
  }
  let handle = account.handle;
  if (handle != null) {
    fields.string('handle', handle);
  }
  return fields;
}

/**
 * The account in `snapshot`, with its signing key encrypted by `keys`, or
 * in the clear; null when there is none. Throws for an encrypted key
 * without `keys`.
 */
function accountFrom(did: String, snapshot: DocumentSnapshot, keys: KeyEncryption | null): Account | null {
  let kind = stringAt(snapshot, 'kind');
  let keyType = stringAt(snapshot, 'keyType');
  if (kind == null || keyType == null) {
    return null;
  }
  let type = keyTypeNamed(keyType as String);
  let handle = stringAt(snapshot, 'handle');
  let ciphertext = bytesAt(snapshot, 'encryptedKey');
  if (ciphertext != null) {
    if (keys == null) {
      throw new Error(`${did}'s signing key is encrypted, and the server has no key encryption (PDS_KEY_ENCRYPTION_KMS_KEY) to decrypt it`);
    }
    return new Account(did, handle, new EncryptedKey(type, ciphertext as FixedArray<u8>, keys as KeyEncryption),
        kindNamed(kind as String));
  }
  let privateKey = bytesAt(snapshot, 'privateKey');
  if (privateKey == null) {
    return null;
  }
  return new Account(did, handle, new SigningKey(type, privateKey as FixedArray<u8>), kindNamed(kind as String));
}

function kindName(kind: AccountKind): String {
  return match (kind) {
    case AccountKind.Person: 'person'
    case AccountKind.Package: 'package'
    case AccountKind.Organization: 'organization'
    case AccountKind.Automation: 'automation'
  };
}

function kindNamed(name: String): AccountKind {
  if (name == 'package') {
    return AccountKind.Package;
  }
  if (name == 'organization') {
    return AccountKind.Organization;
  }
  if (name == 'automation') {
    return AccountKind.Automation;
  }
  if (name == 'person') {
    return AccountKind.Person;
  }
  throw new Error(`an account of an unknown kind: ${name}`);
}

function keyTypeName(type: KeyType): String {
  return if (type == KeyType.P256) 'p256' else 'secp256k1';
}

function keyTypeNamed(name: String): KeyType {
  if (name == 'p256') {
    return KeyType.P256;
  }
  if (name == 'secp256k1') {
    return KeyType.Secp256k1;
  }
  throw new Error(`a signing key of an unknown type: ${name}`);
}
