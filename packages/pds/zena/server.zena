/**
 * The PDS's HTTP application. Its XRPC routes are in `xrpc/`, one module
 * for each namespace: `com.atproto.sync` (`xrpc/sync.zena`) and
 * `com.atproto.repo` (`xrpc/repo.zena`) for every account, and with
 * `Sessions`, password sessions (`xrpc/server.zena`) and an account's
 * writes to its own repository. With managed accounts (`Pds.managed`), it
 * creates them for the package hosts it trusts (`xrpc/managed.zena`) and
 * takes their writes from those hosts. With a `PackageHost`, it also serves the
 * host's methods (`xrpc/host/`), and the site: the web pages (`web/`) and
 * what their sign-in calls.
 *
 * The PDS and the site can each have a host name of their own
 * (docs/design/package-manager.md, "Names and addresses"), so an
 * application serves one part, `AppPart`, or both, as on one machine.
 *
 * `/` and `/xrpc/_health` follow pds.js's
 * `packages/core/src/handlers/server-meta.js`, at the revision
 * docs/design/pds.md pins.
 */

import {Future} from 'zena:async';
import {App, Router} from 'zena:http';
import {JsonBuilder} from 'zena:json';
import {PackageHost} from './host.zena';
import {Pds} from './pds.zena';
import {Sessions} from './sessions.zena';
import {notFound} from './web/pages/not-found.zena';
import {webPages} from './web/routes.zena';
import {contextOf} from './web/session.zena';
import {People} from './web/people.zena';
import {REQUEST_BODY_LIMIT} from './xrpc/common.zena';
import {resolveHandleRoute} from './xrpc/host/identity.zena';
import {hostRoutes} from './xrpc/host/routes.zena';
import {webSessionRoutes} from './xrpc/host/web.zena';
import {managedRoutes} from './xrpc/managed.zena';
import {repoRoutes} from './xrpc/repo.zena';
import {serverRoutes} from './xrpc/server.zena';
import {syncRoutes} from './xrpc/sync.zena';

/** The version `/xrpc/_health` reports. */
export let version = '0.0.1';

let banner = 'An AT Protocol PDS written in Zena\n';

/** Which of the server's parts an application serves. */
export enum AppPart {
  /** The PDS, with the host's methods: what its own host name serves. */
  Pds,
  /** The site: the pages, and what their sign-in calls, under the site's name. */
  Site,
  /** Both, under every name. */
  Both
}

/**
 * Returns the application that serves `part`, for the accounts in `pds`,
 * with the host's methods and the site when there is a `host`.
 */
export function createApp(pds: Pds, host: PackageHost | null = null, sessions: Sessions | null = null,
    part: AppPart = AppPart.Both): App {
  let app = new App();
  let router = new Router();
  // Before any route reads a body (`REQUEST_BODY_LIMIT`).
  app.use(async (req, res, next): Future<void> => {
    req.bodyLimit = REQUEST_BODY_LIMIT;
    await next(req);
  });

  if (part != AppPart.Site) {
    // The site's home page is `/` wherever the site is served.
    if (host == null || part == AppPart.Pds) {
      let text = if (host == null) banner else pdsBanner(host);
      router.get('/', async (req, res, next, params) => {
        res.type = 'text/plain; charset=utf-8';
        res.body = text;
      });
    }

    router.get('/xrpc/_health', async (req, res, next, params) => {
      res.type = 'application/json';
      res.body = new JsonBuilder()
        .beginObject()
        .key('version').string(version)
        .endObject()
        .toString();
    });

    syncRoutes(router, pds);
    repoRoutes(router, pds, sessions);
    if (sessions != null) {
      serverRoutes(router, sessions);
    }
    let managed = pds.managed;
    if (managed != null) {
      managedRoutes(router, pds, managed);
    }
  }
  if (host == null) {
    app.use(router.routes());
    return app;
  }
  let pages = host;
  if (part != AppPart.Site) {
    hostRoutes(router, pages);
  }
  if (part == AppPart.Pds) {
    app.use(router.routes());
    return app;
  }
  webSessionRoutes(router, pages);
  if (part == AppPart.Site) {
    // The sign-in resolves the handle a person types on the site's own
    // origin; the PDS's routes have it already.
    resolveHandleRoute(router, pages);
  }
  // One cache of the people the pages show, for every page.
  let people = People.forHost(pages);
  webPages(router, pages, people);
  app.use(router.routes());
  // A page path no route took: the web app's not-found page.
  app.use(async (req, res, next): Future<void> => {
    if (!res.statusCodeSet && res.body == null && (req.method == 'GET' || req.method == 'HEAD') &&
        !isApiPath(req.path) && !req.path.startsWith('/assets/')) {
      notFound(res, await contextOf(req, pages, people), `Nothing is at ${req.path}.`);
    }
  });
  return app;
}

/** What `/` answers under the PDS's own name: what it is, and where its pages are. */
function pdsBanner(host: PackageHost): String {
  return `The PDS of the Zena package host for ${host.config.domain}, written in Zena.\nIts pages are at ${host.config.siteOrigin}\n`;
}

/** Whether `path` is one of the server's APIs', which answer in JSON rather than with pages. */
function isApiPath(path: String): boolean {
  return path.startsWith('/xrpc/') || path.startsWith('/plc/') || path.startsWith('/.well-known/');
}
