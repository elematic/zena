/**
 * The PDS's HTTP application.
 *
 * The routes follow pds.js, at the revision pinned in docs/design/pds.md:
 * `/` and `/xrpc/_health` from `packages/core/src/handlers/server-meta.js`,
 * the `com.atproto.sync` reads from `handlers/xrpc-sync.js` and
 * `handlers/xrpc-blob.js`, and the `com.atproto.repo` reads from
 * `handlers/xrpc-repo.js`. pds.js serves one account and answers
 * `RepoNotFound` for any other; this finds the account each request names.
 *
 * With `Sessions`, it serves password sessions, from
 * `handlers/xrpc-server.js`: `com.atproto.server.createSession`,
 * `refreshSession`, `getSession`, `deleteSession` and `getServiceAuth`;
 * and an account's writes to its own repository, from
 * `handlers/xrpc-repo.js`: `com.atproto.repo.putRecord` and
 * `deleteRecord`.
 *
 * With a `PackageHost`, it also serves the `dev.zena-lang.host.*` methods
 * that host implements (`pds:host`).
 */

import {Future} from 'zena:async';
import {App, Request, Response, Router} from 'zena:http';
import {JsonArray, JsonBuilder, JsonObject, JsonValue, parseJson, stringify} from 'zena:json';
import {now} from 'wasi:clocks/system-clock';
import {parseI32} from 'zena:core';
import {div} from 'zena:math';
import {decodeCbor} from 'atproto:cbor';
import {Cid} from 'atproto:cid';
import {MapValue, Value, fromJson, toJson} from 'atproto:data';
import {Automation, Created, HostError, PackageHost} from './host.zena';
import {Pds} from './pds.zena';
import {CreateRecord, DeleteRecord, Repository, RepositoryError, UpdateRecord, Write} from './repository.zena';
import {SessionError, Sessions, Tokens} from './sessions.zena';
import {Account} from './storage.zena';
import {notFound, publicPages} from './web/pages.zena';
import {ServiceAuthClaims, createServiceAuthToken} from 'atproto:service-auth';
import {isValidDid} from 'atproto:syntax';
import {hex} from 'zena:encoding';
import {randomBytes} from 'zena:random';

/** The version `/xrpc/_health` reports. */
export let version = '0.0.1';

let banner = 'An AT Protocol PDS written in Zena\n';

/** `com.atproto.repo.listRecords`'s page size, when the request gives none, and its largest. */
let DEFAULT_LIMIT = 50;
let MAX_LIMIT = 100;

/** Answers `res` with the XRPC error `error`. */
function fail(res: Response, status: i32, error: String, message: String): void {
  res.statusCode = status;
  res.type = 'application/json';
  let body = new JsonObject();
  body['error'] = error;
  body['message'] = message;
  res.body = stringify(body);
}

function json(res: Response, body: JsonObject): void {
  res.type = 'application/json';
  res.body = stringify(body);
}

/**
 * The query parameters `names`, all of them present and not empty; null,
 * after answering `InvalidRequest`, when one is missing.
 */
function required(req: Request, res: Response, names: Array<String>): GrowableArray<String> | null {
  let params = req.url.searchParams();
  let values = new GrowableArray<String>();
  for (let name in names) {
    let value = params.get(name);
    if (value == null || value == '') {
      fail(res, 400, 'InvalidRequest', `Missing required parameter: ${name}`);
      return null;
    }
    values.push(value as String);
  }
  return values;
}

function parseCid(text: String): Cid | null {
  try {
    return Cid.parse(text);
  } catch (e) {
    return null;
  }
}

/** The account `identifier` names; null, after answering `RepoNotFound`, when there is none. */
async function accountFor(pds: Pds, identifier: String, res: Response): Future<Account | null> {
  let account = await pds.findAccount(identifier);
  if (account == null) {
    fail(res, 404, 'RepoNotFound', `Could not find repo: ${identifier}`);
  }
  return account;
}

/** The time, in microseconds since the Unix epoch. */
export function nowMicros(): i64 {
  let instant = now();
  return instant.seconds * (1000000 as i64) + div(instant.nanoseconds as i64, 1000 as i64);
}

/** The JSON object a request's body holds; null, after answering `InvalidRequest`, when it is not one. */
async function jsonBody(req: Request, res: Response): Future<JsonObject | null> {
  let text = await req.text();
  let parsed = parseBody(text);
  if (parsed == null) {
    fail(res, 400, 'InvalidRequest', 'the body is not a JSON object');
  }
  return parsed;
}

function parseBody(text: String): JsonObject | null {
  try {
    let json = parseJson(text);
    return if (json is JsonObject) json as JsonObject else null;
  } catch (e) {
    return null;
  }
}

/** The strings of a JSON array member, or null when it is not one. */
function strings(json: JsonObject, name: String): GrowableArray<String> | null {
  let value = json[name];
  if (!(value is JsonArray)) {
    return null;
  }
  let list = value as JsonArray;
  let out = new GrowableArray<String>();
  for (var i = 0; i < list.length; i += 1) {
    if (!(list[i] is String)) {
      return null;
    }
    out.push(list[i] as String);
  }
  return out;
}

/** The optional `recoveryKeys`: empty when absent, null when not a list of strings. */
function recoveryKeys(input: JsonObject): GrowableArray<String> | null {
  if (input['recoveryKeys'] == null) {
    return new GrowableArray<String>();
  }
  return strings(input, 'recoveryKeys');
}

function createdJson(created: Created, recordName: String): JsonObject {
  let ref = new JsonObject();
  ref['uri'] = created.uri;
  ref['cid'] = created.cid.toString();
  let body = new JsonObject();
  body['did'] = created.did;
  body['handle'] = created.handle;
  body[recordName] = ref;
  return body;
}

/**
 * Runs a host method: checks the caller's token for `method`, then calls
 * `call` with the caller's DID, answering with what it returns, or with
 * the error a `HostError` names.
 */
async function hostCall(host: PackageHost, req: Request, res: Response, method: String,
    call: (caller: String) => Future<JsonObject | null>): Future<void> {
  try {
    let caller = await host.authenticate(req.getHeader('authorization'), method,
        div(nowMicros(), 1000000 as i64));
    let answer = await call(caller);
    if (answer != null) {
      json(res, answer as JsonObject);
    }
  } catch (e) {
    if (e is HostError) {
      let error = e as HostError;
      fail(res, error.status, error.error, error.message);
      return;
    }
    throw e;
  }
}

/** Adds the routes of the `dev.zena-lang.host.*` methods `host` implements. */
function hostRoutes(router: Router, host: PackageHost): void {
  // What a client needs to call the host: its service DID, which tokens
  // are addressed to, and the domain its handles are under.
  // The host's own DID document, when its service DID is a `did:web`,
  // which resolves to `https://<host>/.well-known/did.json`. It names the
  // host as a PDS; the host signs nothing as itself, so the document has no
  // keys.
  if (host.config.serviceDid.startsWith('did:web:')) {
    router.get('/.well-known/did.json', async (req, res, next, params) => {
      let context = new JsonArray();
      context.push('https://www.w3.org/ns/did/v1');
      let service = new JsonObject();
      service['id'] = '#atproto_pds';
      service['type'] = 'AtprotoPersonalDataServer';
      service['serviceEndpoint'] = host.config.endpoint;
      let services = new JsonArray();
      services.push(service);
      let body = new JsonObject();
      body['@context'] = context;
      body['id'] = host.config.serviceDid;
      body['service'] = services;
      json(res, body);
    });
  }

  router.get('/xrpc/com.atproto.server.describeServer', async (req, res, next, params) => {
    let domains = new JsonArray();
    domains.push(`.${host.config.domain}`);
    let body = new JsonObject();
    body['did'] = host.config.serviceDid;
    body['availableUserDomains'] = domains;
    json(res, body);
  });

  router.post('/xrpc/dev.zena-lang.host.createOrganization', async (req, res, next, params) => {
    await hostCall(host, req, res, 'dev.zena-lang.host.createOrganization', async (caller): Future<JsonObject | null> => {
      let body = await jsonBody(req, res);
      if (body == null) {
        return null;
      }
      let input = body as JsonObject;
      let keys = recoveryKeys(input);
      if (!(input['name'] is String) || keys == null) {
        fail(res, 400, 'InvalidRequest', 'name is required, and recoveryKeys must be a list of strings');
        return null;
      }
      let created = await host.createOrganization(caller, input['name'] as String, keys as GrowableArray<String>,
          nowMicros());
      return createdJson(created, 'members');
    });
  });

  router.post('/xrpc/dev.zena-lang.host.createPackage', async (req, res, next, params) => {
    await hostCall(host, req, res, 'dev.zena-lang.host.createPackage', async (caller): Future<JsonObject | null> => {
      let body = await jsonBody(req, res);
      if (body == null) {
        return null;
      }
      let input = body as JsonObject;
      let keys = recoveryKeys(input);
      if (!(input['organization'] is String) || keys == null || input['profile'] == null ||
          input['maintainers'] == null) {
        fail(res, 400, 'InvalidRequest',
            'organization, profile and maintainers are required, and recoveryKeys must be a list of strings');
        return null;
      }
      let created = await host.createPackage(caller, input['organization'] as String,
          keys as GrowableArray<String>, fromJson(input['profile']), fromJson(input['maintainers']),
          entriesOf(input), nowMicros());
      return createdJson(created, 'maintainers');
    });
  });

  router.post('/xrpc/dev.zena-lang.host.uploadArtifact', async (req, res, next, params) => {
    await hostCall(host, req, res, 'dev.zena-lang.host.uploadArtifact', async (caller): Future<JsonObject | null> => {
      let pkg = req.url.searchParams().get('package');
      if (pkg == null || pkg == '') {
        fail(res, 400, 'InvalidRequest', 'Missing required parameter: package');
        return null;
      }
      let bytes = await req.bytes();
      let mimeType = req.getHeader('content-type') ?? 'application/octet-stream';
      let blob = await host.uploadArtifact(caller, pkg as String, mimeType, bytes);
      let body = new JsonObject();
      body['blob'] = toJson(blob.toValue());
      return body;
    });
  });

  router.post('/xrpc/dev.zena-lang.host.publish', async (req, res, next, params) => {
    await hostCall(host, req, res, 'dev.zena-lang.host.publish', async (caller): Future<JsonObject | null> => {
      let body = await jsonBody(req, res);
      if (body == null) {
        return null;
      }
      let input = body as JsonObject;
      if (!(input['package'] is String) || input['release'] == null) {
        fail(res, 400, 'InvalidRequest', 'package and release are required');
        return null;
      }
      let created = await host.publish(caller, input['package'] as String, fromJson(input['release']),
          nowMicros());
      return writtenJson(created);
    });
  });

  // Public: what a logged-out visitor browses.
  router.get('/xrpc/dev.zena-lang.host.listScopes', async (req, res, next, params) => {
    let list = new JsonArray();
    for (let scope in await host.listScopes()) {
      let item = new JsonObject();
      item['name'] = scope.name;
      item['did'] = scope.did;
      item['handle'] = scope.handle;
      item['packages'] = new Box<f64>(scope.packages as f64);
      list.push(item);
    }
    let answer = new JsonObject();
    answer['scopes'] = list;
    json(res, answer);
  });

  router.get('/xrpc/dev.zena-lang.host.listPackages', async (req, res, next, params) => {
    let scope = req.url.searchParams().get('scope');
    let list = new JsonArray();
    for (let summary in await host.listPackages(if (scope == null || scope == '') null else scope)) {
      let item = new JsonObject();
      item['did'] = summary.did;
      item['handle'] = summary.handle;
      item['scope'] = summary.scope;
      item['name'] = summary.name;
      if (summary.description != null) {
        item['description'] = summary.description as String;
      }
      if (summary.license != null) {
        item['license'] = summary.license as String;
      }
      if (summary.latest != null) {
        item['latest'] = summary.latest as String;
      }
      item['releases'] = new Box<f64>(summary.releases as f64);
      list.push(item);
    }
    let answer = new JsonObject();
    answer['packages'] = list;
    json(res, answer);
  });

  router.post('/xrpc/dev.zena-lang.host.createAutomationAccount', async (req, res, next, params) => {
    await hostCall(host, req, res, 'dev.zena-lang.host.createAutomationAccount', async (caller): Future<JsonObject | null> => {
      let input = await jsonBody(req, res);
      if (input == null) {
        return null;
      }
      if (!(input['organization'] is String) || !(input['name'] is String)) {
        fail(res, 400, 'InvalidRequest', 'organization and name are required');
        return null;
      }
      let made = await host.createAutomationAccount(caller, input['organization'] as String, input['name'] as String,
          nowMicros());
      let answer = new JsonObject();
      answer['did'] = made.did;
      answer['handle'] = made.handle;
      answer['appPassword'] = made.appPassword;
      return answer;
    });
  });

  router.post('/xrpc/dev.zena-lang.host.retract', async (req, res, next, params) => {
    await hostCall(host, req, res, 'dev.zena-lang.host.retract', async (caller): Future<JsonObject | null> => {
      let input = await jsonBody(req, res);
      if (input == null) {
        return null;
      }
      let reason = input['reason'];
      if (!(input['package'] is String) || !(input['version'] is String) || (reason != null && !(reason is String))) {
        fail(res, 400, 'InvalidRequest', 'package and version are required, and reason must be a string');
        return null;
      }
      return writtenJson(await host.retract(caller, input['package'] as String, input['version'] as String,
          if (reason is String) reason as String else null, nowMicros()));
    });
  });

  router.post('/xrpc/dev.zena-lang.host.putMembers', async (req, res, next, params) => {
    await hostCall(host, req, res, 'dev.zena-lang.host.putMembers', async (caller): Future<JsonObject | null> => {
      let input = await jsonBody(req, res);
      if (input == null) {
        return null;
      }
      if (!(input['organization'] is String) || input['members'] == null || !(input['entries'] is JsonArray)) {
        fail(res, 400, 'InvalidRequest', 'organization, members and entries are required');
        return null;
      }
      return writtenJson(await host.putMembers(caller, input['organization'] as String, fromJson(input['members']),
          entriesOf(input), swapOf(input), nowMicros()));
    });
  });

  router.post('/xrpc/dev.zena-lang.host.putTeam', async (req, res, next, params) => {
    await hostCall(host, req, res, 'dev.zena-lang.host.putTeam', async (caller): Future<JsonObject | null> => {
      let input = await jsonBody(req, res);
      if (input == null) {
        return null;
      }
      if (!(input['organization'] is String) || !(input['name'] is String) || input['team'] == null ||
          !(input['entries'] is JsonArray)) {
        fail(res, 400, 'InvalidRequest', 'organization, name, team and entries are required');
        return null;
      }
      return writtenJson(await host.putTeam(caller, input['organization'] as String, input['name'] as String,
          fromJson(input['team']), entriesOf(input), swapOf(input), nowMicros()));
    });
  });

  router.post('/xrpc/dev.zena-lang.host.deleteTeam', async (req, res, next, params) => {
    await hostCall(host, req, res, 'dev.zena-lang.host.deleteTeam', async (caller): Future<JsonObject | null> => {
      let input = await jsonBody(req, res);
      if (input == null) {
        return null;
      }
      if (!(input['organization'] is String) || !(input['name'] is String)) {
        fail(res, 400, 'InvalidRequest', 'organization and name are required');
        return null;
      }
      await host.deleteTeam(caller, input['organization'] as String, input['name'] as String, swapOf(input),
          nowMicros());
      return new JsonObject();
    });
  });

  router.post('/xrpc/dev.zena-lang.host.putMaintainers', async (req, res, next, params) => {
    await hostCall(host, req, res, 'dev.zena-lang.host.putMaintainers', async (caller): Future<JsonObject | null> => {
      let input = await jsonBody(req, res);
      if (input == null) {
        return null;
      }
      if (!(input['package'] is String) || input['maintainers'] == null) {
        fail(res, 400, 'InvalidRequest', 'package and maintainers are required');
        return null;
      }
      return writtenJson(await host.putMaintainers(caller, input['package'] as String,
          fromJson(input['maintainers']), entriesOf(input), swapOf(input), nowMicros()));
    });
  });

  router.get('/xrpc/dev.zena-lang.host.getEntries', async (req, res, next, params) => {
    await hostCall(host, req, res, 'dev.zena-lang.host.getEntries', async (caller): Future<JsonObject | null> => {
      let query = req.url.searchParams();
      let account = query.get('account');
      if (account == null || account == '') {
        fail(res, 400, 'InvalidRequest', 'Missing required parameter: account');
        return null;
      }
      let team = query.get('team');
      let entries = await host.getEntries(caller, account as String, if (team == '') null else team);
      let list = new JsonArray();
      for (let entry in entries) {
        list.push(toJson(entry.toValue()));
      }
      let answer = new JsonObject();
      answer['entries'] = list;
      return answer;
    });
  });
}

/** The time, in seconds since the Unix epoch. */
function nowSeconds(): i64 {
  return now().seconds;
}

/** Answers with `call`'s JSON, or with the error a session or repository refused with. */
async function sessionCall(res: Response, call: () => Future<JsonObject | null>): Future<void> {
  try {
    let answer = await call();
    if (answer != null) {
      json(res, answer as JsonObject);
    }
  } catch (e) {
    if (e is SessionError) {
      let error = e as SessionError;
      fail(res, error.status, error.error, error.message);
      return;
    }
    if (e is RepositoryError) {
      fail(res, 400, (e as RepositoryError).error, e.message);
      return;
    }
    throw e;
  }
}

/** A session's answer: its account and tokens. */
function sessionJson(tokens: Tokens): JsonObject {
  let answer = new JsonObject();
  answer['did'] = tokens.account.did;
  answer['handle'] = tokens.account.handle ?? 'handle.invalid';
  answer['accessJwt'] = tokens.accessJwt;
  answer['refreshJwt'] = tokens.refreshJwt;
  answer['active'] = new Box<boolean>(true);
  return answer;
}

/**
 * The account a write names as its `repo`, which must be the caller's:
 * an account writes its own repository only.
 */
async function ownRepository(pds: Pds, caller: Account, repo: JsonValue): Future<Account> {
  let named = if (repo is String) await pds.findAccount(repo as String) else null;
  if (named == null || named.did != caller.did) {
    throw new SessionError(403, 'Forbidden', `${caller.did} may write only its own repository`);
  }
  return caller;
}

/** Adds the routes of password sessions, and of writes to one's own repository. */
function sessionRoutes(router: Router, pds: Pds, sessions: Sessions): void {
  router.post('/xrpc/com.atproto.server.createSession', async (req, res, next, params) => {
    await sessionCall(res, async (): Future<JsonObject | null> => {
      let input = await jsonBody(req, res);
      if (input == null) {
        return null;
      }
      if (!(input['identifier'] is String) || !(input['password'] is String)) {
        fail(res, 400, 'InvalidRequest', 'identifier and password are required');
        return null;
      }
      return sessionJson(await sessions.create(input['identifier'] as String, input['password'] as String,
          nowSeconds()));
    });
  });

  router.post('/xrpc/com.atproto.server.refreshSession', async (req, res, next, params) => {
    await sessionCall(res, async (): Future<JsonObject | null> => {
      return sessionJson(await sessions.refresh(req.getHeader('authorization'), nowSeconds()));
    });
  });

  router.get('/xrpc/com.atproto.server.getSession', async (req, res, next, params) => {
    await sessionCall(res, async (): Future<JsonObject | null> => {
      let caller = await sessions.authenticate(req.getHeader('authorization'), nowSeconds());
      let answer = new JsonObject();
      answer['did'] = caller.account.did;
      answer['handle'] = caller.account.handle ?? 'handle.invalid';
      answer['active'] = new Box<boolean>(true);
      return answer;
    });
  });

  router.post('/xrpc/com.atproto.server.deleteSession', async (req, res, next, params) => {
    await sessionCall(res, async (): Future<JsonObject | null> => {
      await sessions.delete(req.getHeader('authorization'), nowSeconds());
      return new JsonObject();
    });
  });

  // A token for another service, signed with the account's own key, which
  // the service checks against the account's DID document. One bound to a
  // method lasts at most an hour, and one that is not, a minute, as the
  // reference PDS allows.
  router.get('/xrpc/com.atproto.server.getServiceAuth', async (req, res, next, params) => {
    await sessionCall(res, async (): Future<JsonObject | null> => {
      let caller = await sessions.authenticate(req.getHeader('authorization'), nowSeconds());
      let query = req.url.searchParams();
      let aud = query.get('aud');
      if (aud == null || !isValidDid(aud as String)) {
        fail(res, 400, 'InvalidRequest', 'aud must be a DID');
        return null;
      }
      let lxm = query.get('lxm');
      let method: String | null = if (lxm == null || lxm == '') null else lxm;
      let issued = nowSeconds();
      var exp = issued + (60 as i64);
      let expText = query.get('exp');
      if (expText != null && expText != '') {
        if (let (true, parsed) = parseI32(expText as String)) {
          exp = parsed as i64;
        } else {
          fail(res, 400, 'BadExpiration', 'exp is not a number');
          return null;
        }
      }
      let limit = if (method == null) (60 as i64) else (3600 as i64);
      if (exp <= issued || exp - issued > limit) {
        fail(res, 400, 'BadExpiration', `exp must be within ${limit} seconds from now`);
        return null;
      }
      let key = caller.account.key;
      let claims = new ServiceAuthClaims(caller.account.did, aud as String, exp, issued, method,
          hex.encode(randomBytes(16)));
      let answer = new JsonObject();
      answer['token'] = createServiceAuthToken(claims, key.type, key.privateKey);
      return answer;
    });
  });

  router.post('/xrpc/com.atproto.repo.putRecord', async (req, res, next, params) => {
    await sessionCall(res, async (): Future<JsonObject | null> => {
      let caller = await sessions.authenticate(req.getHeader('authorization'), nowSeconds());
      let input = await jsonBody(req, res);
      if (input == null) {
        return null;
      }
      if (!(input['collection'] is String) || !(input['rkey'] is String) || !(input['record'] is JsonObject)) {
        fail(res, 400, 'InvalidRequest', 'repo, collection, rkey and record are required');
        return null;
      }
      let account = await ownRepository(pds, caller.account, input['repo']);
      let collection = input['collection'] as String;
      let rkey = input['rkey'] as String;
      let record = fromJson(input['record']);
      if (!(record is MapValue)) {
        fail(res, 400, 'InvalidRequest', 'the record is not an object');
        return null;
      }
      let swap = swapCidOf(input);
      let store = pds.storage.store(account.did);
      let exists = (await store.getRecord(collection, rkey)) != null;
      if (!exists && swap != null) {
        fail(res, 400, 'InvalidSwap', `${collection}/${rkey} does not exist`);
        return null;
      }
      let write = if (exists) new UpdateRecord(collection, rkey, record as MapValue, swap) as Write
          else new CreateRecord(collection, rkey, record as MapValue) as Write;
      await pds.repositoryOf(account).applyWrites([write], nowMicros());
      let answer = new JsonObject();
      answer['uri'] = `at://${account.did}/${collection}/${rkey}`;
      answer['cid'] = ((await store.getRecord(collection, rkey)) as Cid).toString();
      return answer;
    });
  });

  router.post('/xrpc/com.atproto.repo.deleteRecord', async (req, res, next, params) => {
    await sessionCall(res, async (): Future<JsonObject | null> => {
      let caller = await sessions.authenticate(req.getHeader('authorization'), nowSeconds());
      let input = await jsonBody(req, res);
      if (input == null) {
        return null;
      }
      if (!(input['collection'] is String) || !(input['rkey'] is String)) {
        fail(res, 400, 'InvalidRequest', 'repo, collection and rkey are required');
        return null;
      }
      let account = await ownRepository(pds, caller.account, input['repo']);
      let collection = input['collection'] as String;
      let rkey = input['rkey'] as String;
      // Deleting a record that is not there is done already.
      if ((await pds.storage.store(account.did).getRecord(collection, rkey)) != null) {
        await pds.repositoryOf(account).applyWrites([new DeleteRecord(collection, rkey, swapCidOf(input))],
            nowMicros());
      }
      return new JsonObject();
    });
  });
}

/** The `swapRecord` CID a write gives, or null; one that is not a CID is refused. */
function swapCidOf(input: JsonObject): Cid | null {
  let swap = input['swapRecord'];
  if (!(swap is String)) {
    return null;
  }
  let cid = parseCid(swap as String);
  if (cid == null) {
    throw new SessionError(400, 'InvalidRequest', `swapRecord '${swap as String}' is not a CID`);
  }
  return cid;
}

/** The `entries` a call gives, as values; none when it gives none. */
function entriesOf(input: JsonObject): Array<Value> {
  let entries = new GrowableArray<Value>();
  let given = input['entries'];
  if (given is JsonArray) {
    let list = given as JsonArray;
    for (var i = 0; i < list.length; i += 1) {
      entries.push(fromJson(list[i]));
    }
  }
  return entries;
}

/** The `swapRecord` a call gives, or null. */
function swapOf(input: JsonObject): String | null {
  let swap = input['swapRecord'];
  return if (swap is String) swap as String else null;
}

/** The answer to a call that wrote a record: its AT-URI and CID. */
function writtenJson(created: Created): JsonObject {
  let answer = new JsonObject();
  answer['uri'] = created.uri;
  answer['cid'] = created.cid.toString();
  return answer;
}

/**
 * Returns the application that serves every route, for the accounts in
 * `pds`, and the host methods of `host` when there is one.
 */
export function createApp(pds: Pds, host: PackageHost | null = null, sessions: Sessions | null = null): App {
  let app = new App();
  let router = new Router();

  if (host == null) {
    router.get('/', async (req, res, next, params) => {
      res.type = 'text/plain; charset=utf-8';
      res.body = banner;
    });
  }

  router.get('/xrpc/_health', async (req, res, next, params) => {
    res.type = 'application/json';
    res.body = new JsonBuilder()
      .beginObject()
      .key('version').string(version)
      .endObject()
      .toString();
  });

  router.get('/xrpc/com.atproto.sync.getLatestCommit', async (req, res, next, params) => {
    let given = required(req, res, ['did']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    let head = await pds.storage.store(account.did).getHead();
    if (head == null) {
      fail(res, 404, 'RepoNotFound', `${account.did} has no commit`);
      return;
    }
    let body = new JsonObject();
    body['cid'] = head.cid.toString();
    body['rev'] = head.rev;
    json(res, body);
  });

  router.get('/xrpc/com.atproto.sync.getRecord', async (req, res, next, params) => {
    let given = required(req, res, ['did', 'collection', 'rkey']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    let car = await pds.repositoryOf(account).recordProof(given[1], given[2]);
    if (car == null) {
      fail(res, 404, 'RecordNotFound', 'Record not found');
      return;
    }
    res.type = 'application/vnd.ipld.car';
    res.body = car as FixedArray<u8>;
  });

  router.get('/xrpc/com.atproto.sync.getRepo', async (req, res, next, params) => {
    let given = required(req, res, ['did']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    res.type = 'application/vnd.ipld.car';
    res.body = await pds.repositoryOf(account).exportCar();
  });

  router.get('/xrpc/com.atproto.sync.getBlob', async (req, res, next, params) => {
    let given = required(req, res, ['did', 'cid']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    let cid = parseCid(given[1]);
    if (cid == null) {
      fail(res, 400, 'InvalidRequest', `'${given[1]}' is not a CID`);
      return;
    }
    let blob = await pds.storage.store(account.did).getBlob(cid as Cid);
    if (blob == null) {
      fail(res, 400, 'BlobNotFound', 'Blob not found');
      return;
    }
    res.type = blob.mimeType;
    res.body = blob.bytes;
  });

  router.get('/xrpc/com.atproto.repo.describeRepo', async (req, res, next, params) => {
    let given = required(req, res, ['repo']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    let collections = new JsonArray();
    var last = '';
    for (let entry in await pds.storage.store(account.did).allRecords()) {
      // Records come in key order, so a collection's records are together.
      if (entry.collection != last) {
        collections.push(entry.collection);
        last = entry.collection;
      }
    }
    let body = new JsonObject();
    body['handle'] = account.handle ?? account.did;
    body['did'] = account.did;
    body['didDoc'] = new JsonObject();
    body['collections'] = collections;
    body['handleIsCorrect'] = new Box<boolean>(account.handle != null);
    json(res, body);
  });

  router.get('/xrpc/com.atproto.repo.getRecord', async (req, res, next, params) => {
    let given = required(req, res, ['repo', 'collection', 'rkey']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    let store = pds.storage.store(account.did);
    let cid = await store.getRecord(given[1], given[2]);
    if (cid == null) {
      fail(res, 404, 'RecordNotFound', 'Record not found');
      return;
    }
    let found = cid as Cid;
    let bytes = await store.getBlock(found);
    let body = new JsonObject();
    body['uri'] = `at://${account.did}/${given[1]}/${given[2]}`;
    body['cid'] = found.toString();
    body['value'] = toJson(decodeCbor(bytes as FixedArray<u8>));
    json(res, body);
  });

  router.get('/xrpc/com.atproto.repo.listRecords', async (req, res, next, params) => {
    let given = required(req, res, ['repo', 'collection']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    let query = req.url.searchParams();
    var limit = DEFAULT_LIMIT;
    if (let (true, asked) = parseI32(query.get('limit') ?? '')) {
      limit = if (asked < 1) 1 else if (asked > MAX_LIMIT) MAX_LIMIT else asked;
    }
    // As the reference PDS does, newest record key first, unless `reverse`.
    let descending = query.get('reverse') != 'true';
    let store = pds.storage.store(account.did);
    let page = await store.listRecords(given[1], query.get('cursor'), limit, descending);
    let records = new JsonArray();
    for (let entry in page) {
      let record = new JsonObject();
      record['uri'] = `at://${account.did}/${entry.collection}/${entry.rkey}`;
      record['cid'] = entry.cid.toString();
      record['value'] = toJson(decodeCbor((await store.getBlock(entry.cid)) as FixedArray<u8>));
      records.push(record);
    }
    let body = new JsonObject();
    body['records'] = records;
    if (page.length == limit) {
      body['cursor'] = page[page.length - 1].rkey;
    }
    json(res, body);
  });

  if (host != null) {
    hostRoutes(router, host as PackageHost);
    publicPages(router, host as PackageHost);
  }
  if (sessions != null) {
    sessionRoutes(router, pds, sessions as Sessions);
  }
  app.use(router.routes());
  if (host != null) {
    let domain = (host as PackageHost).config.domain;
    // A page path no route took: the web app's not-found page.
    app.use(async (req, res, next): Future<void> => {
      if (!res.statusCodeSet && res.body == null && (req.method == 'GET' || req.method == 'HEAD') &&
          !isApiPath(req.path) && !req.path.startsWith('/assets/')) {
        notFound(res, domain, `Nothing is at ${req.path}.`);
      }
    });
  }
  return app;
}

/** Whether `path` is one of the server's APIs', which answer in JSON rather than with pages. */
function isApiPath(path: String): boolean {
  return path.startsWith('/xrpc/') || path.startsWith('/plc/') || path.startsWith('/.well-known/');
}
