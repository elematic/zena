/**
 * The PDS's HTTP application. Its XRPC routes are in `xrpc/`, one module
 * for each namespace: `com.atproto.sync` (`xrpc/sync.zena`) and
 * `com.atproto.repo` (`xrpc/repo.zena`) for every account, and with
 * `Sessions`, password sessions (`xrpc/server.zena`) and an account's
 * writes to its own repository. With managed accounts (`Pds.managed`), it
 * creates them for the App Views it trusts (`xrpc/managed.zena`) and
 * takes their writes from those App Views. `registry/server` serves these
 * routes beside the App View's, when the two run in one process.
 *
 * `/` and `/xrpc/_health` follow pds.js's
 * `packages/core/src/handlers/server-meta.js`, at the revision
 * docs/design/pds.md pins.
 */

import {Future} from 'zena:async';
import {App, Router} from 'zena:http';
import {JsonBuilder} from 'zena:json';
import {Pds} from './pds.zena';
import {Sessions} from './sessions.zena';
import {REQUEST_BODY_LIMIT} from './xrpc/common.zena';
import {managedRoutes} from './xrpc/managed.zena';
import {repoRoutes} from './xrpc/repo.zena';
import {describeServerRoute, serverRoutes} from './xrpc/server.zena';
import {syncRoutes} from './xrpc/sync.zena';

/** The version `/xrpc/_health` reports. */
export let version = '0.0.1';

let banner = 'An AT Protocol PDS written in Zena\n';

/** Returns the application of a PDS alone, for the accounts in `pds`. */
export function createApp(pds: Pds, sessions: Sessions | null = null): App {
  let app = limitedApp();
  let router = new Router();
  router.get('/', async (req, res, next, params) => {
    res.type = 'text/plain; charset=utf-8';
    res.body = banner;
  });
  pdsRoutes(router, pds, sessions);
  app.use(router.routes());
  return app;
}

/** An application that limits every request's body to `REQUEST_BODY_LIMIT`, before any route reads one. */
export function limitedApp(): App {
  let app = new App();
  app.use(async (req, res, next): Future<void> => {
    req.bodyLimit = REQUEST_BODY_LIMIT;
    await next(req);
  });
  return app;
}

/**
 * Adds the PDS's routes, all but `/`: `/xrpc/_health`, `describeServer`,
 * its repositories, password sessions when there are `sessions`, and its
 * managed accounts when it has any (`Pds.managed`).
 */
export function pdsRoutes(router: Router, pds: Pds, sessions: Sessions | null): void {
  healthRoute(router);
  describeServerRoute(router, pds);
  syncRoutes(router, pds);
  repoRoutes(router, pds, sessions);
  if (sessions != null) {
    serverRoutes(router, sessions);
  }
  let managed = pds.managed;
  if (managed != null) {
    managedRoutes(router, pds, managed);
  }
}

/** Adds `/xrpc/_health`, which answers with the server's version. */
export function healthRoute(router: Router): void {
  router.get('/xrpc/_health', async (req, res, next, params) => {
    res.type = 'application/json';
    res.body = new JsonBuilder()
      .beginObject()
      .key('version').string(version)
      .endObject()
      .toString();
  });
}
