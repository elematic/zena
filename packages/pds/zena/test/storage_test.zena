/** The storage conformance tests (`storage-conformance.zena`) in memory. */

import {suite} from 'zena:test';
import {HostStore, MemoryHostStore} from 'pds:host';
import {MemoryPlcLog, PlcLog} from 'pds:plc-directory';
import {CredentialStore, MemoryCredentialStore} from 'pds:sessions';
import {MemoryStorage, Storage} from 'pds:storage';
import {
  credentialStoreConformance, hostStoreConformance, plcLogConformance, storageConformance
} from './storage-conformance.zena';

export let tests = suite('in-memory storage', () => {
  // TODO(#520): drop the return types.
  storageConformance((): Storage => new MemoryStorage());
  hostStoreConformance((): HostStore => new MemoryHostStore());
  plcLogConformance((): PlcLog => new MemoryPlcLog());
  credentialStoreConformance((): CredentialStore => new MemoryCredentialStore());
});
