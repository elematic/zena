/**
 * `pds:service`: reading the configuration from the environment, and the
 * server it builds, in memory. `zena-cli`'s publish test runs the server
 * it builds with a package host, against `zena publish`.
 */

import {suite, test} from 'zena:test';
import {equal, isTrue} from 'zena:assert';
import {Future, runFuture} from 'zena:async';
import {HashMap} from 'zena:collections';
import {App, Request, Response, Server} from 'zena:http';
import {hex} from 'zena:encoding';
import {now} from 'wasi:clocks/system-clock';
import {KeyType, PublicKey, formatDidKey, publicKeyFor} from 'atproto:didkey';
import {didDocument, genesisOperation} from 'atproto:plc';
import {ServiceAuthClaims, createServiceAuthToken} from 'atproto:service-auth';
import {JsonObject, parseJson, stringify} from 'zena:json';
import {parseDidDocument} from 'atproto:did';
import {PackageHost} from 'pds:host';
import {
  ConfigError, HostSettings, InBucket, InCloudDns, InDirectory, InFirestore, InMemory, RecordsInMemory, ServiceConfig,
  buildService, configFromEnv
} from 'pds:service';

let KEY = 'c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721';

/** The environment `pairs` make. */
function envOf(pairs: Array<(String, String)>): (name: String) => String | null {
  let values = new HashMap<String, String>();
  for (let (name, value) in pairs) {
    values[name] = value;
  }
  // TODO(#520): the return type is only for the compiler.
  return (name: String): String | null => {
    if (let (true, value) = values.get(name)) {
      return value;
    }
    return null;
  };
}

/** The message `configFromEnv` refuses `pairs` with, or '' when it accepts them. */
function refusal(pairs: Array<(String, String)>): String {
  try {
    configFromEnv(envOf(pairs));
  } catch (e) {
    return if (e is ConfigError) e.message else `another error: ${e.message}`;
  }
  return '';
}

function get(app: App, path: String): Response {
  let res = new Response();
  runFuture((async () => {
    await app.handleRequest(new Request.fromUrl(`http://localhost${path}`, 'GET', new HashMap<String, String>()), res);
  })());
  return res;
}

export let tests = suite('pds:service', () => {
  test("serves the web app's assets and docs, beside its pages and APIs", (ctx) => {
    let service = runFuture(buildService(configFromEnv(envOf([('PDS_HOST_DOMAIN', 'pkg.test'),
        ('PDS_WEB_DIR', 'packages/pds/zena/test/fixtures/web')])), 'http://127.0.0.1:1'));
    let script = get(service.app, '/assets/app.js');
    equal(script.statusCode, 200, 'script');
    isTrue((script.type ?? '').contains('javascript'), script.type ?? 'no type');
    equal(get(service.app, '/assets/missing.js').statusCode, 404, 'a missing asset');
    let docs = get(service.app, '/docs/');
    equal(docs.statusCode, 200, 'docs index');
    isTrue((docs.type ?? '').contains('text/html'), docs.type ?? 'no type');
    equal(get(service.app, '/docs/missing/').statusCode, 404, 'a missing doc page');
    // The pages are the host's, rendered on the server.
    let home = get(service.app, '/');
    equal(home.statusCode, 200, 'home');
    isTrue((home.type ?? '').contains('text/html'), home.type ?? 'no type');
    let health = get(service.app, '/xrpc/_health');
    equal(health.statusCode, 200, `health: ${health.statusCode}`);
    isTrue((health.body as String).contains('version'), health.body as String);

    // A PDS with no package host has no pages: its banner is at /.
    let plain = runFuture(buildService(configFromEnv(envOf([])), 'http://127.0.0.1:1'));
    isTrue((get(plain.app, '/').body as String).contains('PDS'), 'the banner');
  });

  test('defaults to a PDS in memory on 2583', (ctx) => {
    let config = configFromEnv(envOf([]));
    equal(config.port as i32, 2583);
    isTrue(config.storage is InMemory, 'in memory');
    isTrue(config.host == null, 'no package host');
    equal(config.plcDirectory, 'https://plc.directory');
    isTrue(config.clockId >= 0 && config.clockId < 1024, `clock ${config.clockId}`);
  });

  test('reads a package host on Firestore', (ctx) => {
    let config = configFromEnv(envOf([
      ('PORT', '8080'),
      ('PDS_STORAGE', 'firestore'),
      ('PDS_JWT_SECRET', KEY),
      ('PDS_TENANT', 'pkg'),
      ('PDS_BLOB_BUCKET', 'zena-blobs'),
      ('PDS_FIRESTORE_DATABASE', 'pkg'),
      ('PDS_HOST_DOMAIN', 'pkg.example.dev'),
      ('PDS_ROTATION_KEY', KEY),
      ('PDS_RESERVED_SCOPES', 'std, core,,'),
      ('PDS_ADMIN_DIDS', 'did:plc:aaaa, did:web:ops.example.dev,did:plc:cccc  did:plc:dddd'),
      ('PDS_MAX_BLOB_BYTES', '1000'),
      ('PDS_CLOCK_ID', '7'),
      ('PDS_PLC_DIRECTORY', 'http://plc.test'),
      ('PDS_HANDLE_RECORDS', 'cloud-dns'),
      ('PDS_DNS_ZONE', 'pkg-zone'),
      ('PDS_DNS_PROJECT', 'dns-project'),
    ]));
    equal(config.port as i32, 8080);
    equal(config.clockId, 7);
    equal(config.plcDirectory, 'http://plc.test');
    match (config.storage) {
      case InFirestore {tenant, blobs, database}: {
        equal(tenant, 'pkg');
        equal(database as String, 'pkg');
        isTrue(blobs is InBucket && (blobs as InBucket).bucket == 'zena-blobs', 'the bucket');
      }
      case InMemory {}: {
        isTrue(false, 'not in memory');
      }
    }
    let host = config.host;
    if (host == null) {
      isTrue(false, 'a package host');
      return;
    }
    equal(host.domain, 'pkg.example.dev');
    equal(host.serviceDid, 'did:web:pkg.example.dev');
    equal(host.publicUrl as String, 'https://pkg.example.dev');
    isTrue(host.rotationKey != null, 'the rotation key');
    equal(host.admins.length, 4);
    equal(host.admins[0], 'did:plc:aaaa');
    equal(host.admins[1], 'did:web:ops.example.dev');
    equal(host.admins[3], 'did:plc:dddd');
    equal(host.reservedScopes.length, 2);
    equal(host.reservedScopes[1], 'core');
    match (host.records) {
      case InCloudDns {project, zone}: {
        equal(project as String, 'dns-project');
        equal(zone, 'pkg-zone');
      }
      case RecordsInMemory {}: {
        isTrue(false, 'in Cloud DNS');
      }
    }

    let local = configFromEnv(envOf([
      ('PDS_STORAGE', 'firestore'),
      ('PDS_JWT_SECRET', KEY),
      ('PDS_TENANT', 'dev'),
      ('PDS_BLOB_DIR', '/var/pds/blobs'),
      ('PDS_HOST_DOMAIN', 'pkg.test'),
      ('PDS_ROTATION_KEY', KEY),
      ('PDS_SERVICE_DID', 'did:web:other.test'),
      ('PDS_PUBLIC_URL', 'http://localhost:2583'),
      ('PDS_HANDLE_RECORDS', 'memory'),
    ]));
    if (let InFirestore {blobs} = local.storage) {
      isTrue(blobs is InDirectory && (blobs as InDirectory).path == '/var/pds/blobs', 'the directory');
    }
    let localHost = local.host;
    isTrue(localHost != null && localHost.serviceDid == 'did:web:other.test' &&
        localHost.publicUrl as String == 'http://localhost:2583', 'the DID and URL given');
  });

  test('accepts the configuration deploy/deploy.sh gives staging', (ctx) => {
    // As deploy.sh sets it on Cloud Run, with the secret's value.
    let config = configFromEnv(envOf([
      ('PORT', '8080'),
      ('PDS_STORAGE', 'firestore'),
      ('PDS_JWT_SECRET', KEY),
      ('PDS_FIRESTORE_DATABASE', 'zena-pkg-staging'),
      ('PDS_TENANT', 'pkg'),
      ('PDS_BLOB_BUCKET', 'meta-garage-420114-zena-pkg-staging'),
      ('PDS_HOST_DOMAIN', 'pkg-staging.zena-lang.dev'),
      ('PDS_HANDLE_RECORDS', 'cloud-dns'),
      ('PDS_DNS_ZONE', 'zena-pkg-staging'),
      ('PDS_DNS_PROJECT', 'meta-garage-420114'),
      ('PDS_PLC', 'staging'),
      ('GOOGLE_CLOUD_PROJECT', 'meta-garage-420114'),
      ('PDS_ROTATION_KEY', KEY),
    ]));
    isTrue(config.plcStaging, 'its own PLC directory');
    let host = config.host;
    isTrue(host != null && host.serviceDid == 'did:web:pkg-staging.zena-lang.dev' &&
        host.publicUrl as String == 'https://pkg-staging.zena-lang.dev', 'the host');
  });

  test('reads the online rotation key from Cloud KMS, and the offline key', (ctx) => {
    let offline = formatDidKey(publicKeyFor(KeyType.Secp256k1, new FixedArray<u8>(32, 3 as u8)));
    let config = configFromEnv(envOf([
      ('PDS_STORAGE', 'firestore'),
      ('PDS_JWT_SECRET', KEY),
      ('PDS_TENANT', 'pkg'),
      ('PDS_BLOB_BUCKET', 'zena-blobs'),
      ('PDS_HOST_DOMAIN', 'pkg.example.dev'),
      ('PDS_ROTATION_KMS_KEY', 'projects/p/locations/global/keyRings/r/cryptoKeys/rotation/cryptoKeyVersions/1'),
      ('PDS_OFFLINE_ROTATION_KEY', offline),
      ('PDS_HANDLE_RECORDS', 'memory'),
    ]));
    let host = config.host as HostSettings;
    isTrue(host.rotationKey == null, 'no key of its own');
    equal(host.rotationKmsKey as String, 'projects/p/locations/global/keyRings/r/cryptoKeys/rotation/cryptoKeyVersions/1');
    equal(formatDidKey(host.offlineRotationKey as PublicKey), offline);

    let both = refusal([('PDS_HOST_DOMAIN', 'pkg.test'), ('PDS_ROTATION_KEY', KEY),
        ('PDS_ROTATION_KMS_KEY', 'projects/p/locations/l/keyRings/r/cryptoKeys/k/cryptoKeyVersions/1')]);
    isTrue(both.contains('not both'), both);
    let notVersion = refusal([('PDS_HOST_DOMAIN', 'pkg.test'),
        ('PDS_ROTATION_KMS_KEY', 'projects/p/locations/l/keyRings/r/cryptoKeys/k')]);
    isTrue(notVersion.contains('is a key version'), notVersion);
    let badOffline = refusal([('PDS_HOST_DOMAIN', 'pkg.test'), ('PDS_OFFLINE_ROTATION_KEY', 'zQ3sh')]);
    isTrue(badOffline.contains('PDS_OFFLINE_ROTATION_KEY is not a did:key'), badOffline);
    let stray = refusal([('PDS_OFFLINE_ROTATION_KEY', offline)]);
    isTrue(stray.contains('PDS_OFFLINE_ROTATION_KEY needs PDS_HOST_DOMAIN'), stray);
  });

  test('makes up a rotation key for a host in memory', (ctx) => {
    let host = configFromEnv(envOf([('PDS_HOST_DOMAIN', 'pkg.test')])).host;
    isTrue(host != null && host.rotationKey == null, 'no key until the server starts');
    isTrue(host != null && host.records is RecordsInMemory, 'records in memory');
  });

  test('names every problem in a configuration', (ctx) => {
    let firestore = refusal([('PDS_STORAGE', 'firestore'), ('PDS_HOST_DOMAIN', 'pkg.test')]);
    isTrue(firestore.contains('needs PDS_TENANT'), firestore);
    isTrue(firestore.contains('needs PDS_BLOB_BUCKET or PDS_BLOB_DIR'), firestore);
    isTrue(firestore.contains('needs PDS_ROTATION_KEY or PDS_ROTATION_KMS_KEY'), firestore);
    isTrue(firestore.contains('needs PDS_HANDLE_RECORDS'), firestore);
    isTrue(firestore.contains('needs PDS_JWT_SECRET'), firestore);
    let records = refusal([('PDS_HOST_DOMAIN', 'pkg.test'), ('PDS_HANDLE_RECORDS', 'cloud-dns')]);
    isTrue(records.contains('needs PDS_DNS_ZONE'), records);
    let unknown = refusal([('PDS_HOST_DOMAIN', 'pkg.test'), ('PDS_HANDLE_RECORDS', 'route53'),
        ('PDS_DNS_ZONE', 'z')]);
    isTrue(unknown.contains('PDS_HANDLE_RECORDS is cloud-dns or memory'), unknown);
    let zoneAlone = refusal([('PDS_HOST_DOMAIN', 'pkg.test'), ('PDS_DNS_ZONE', 'z')]);
    isTrue(zoneAlone.contains('need PDS_HANDLE_RECORDS=cloud-dns'), zoneAlone);
    let noHost = refusal([('PDS_HANDLE_RECORDS', 'memory')]);
    isTrue(noHost.contains('PDS_HANDLE_RECORDS needs PDS_HOST_DOMAIN'), noHost);

    let values = refusal([
      ('PORT', 'eighty'),
      ('PDS_STORAGE', 'disk'),
      ('PDS_CLOCK_ID', '1024'),
      ('PDS_HOST_DOMAIN', 'pkg.test'),
      ('PDS_ROTATION_KEY', 'abcd'),
      ('PDS_MAX_BLOB_BYTES', '-5'),
      ('PDS_JWT_SECRET', 'not hex'),
    ]);
    for (let expected in ['PORT is not a number', 'PDS_STORAGE is memory or firestore', 'PDS_CLOCK_ID is 0 to 1023',
        'PDS_ROTATION_KEY is not 32 bytes of hex', 'PDS_MAX_BLOB_BYTES must be positive',
        'PDS_JWT_SECRET is not 32 bytes of hex']) {
      isTrue(values.contains(expected), `${expected} in: ${values}`);
    }

    let admin = refusal([('PDS_HOST_DOMAIN', 'pkg.test'), ('PDS_ADMIN_DIDS', 'did:plc:aaaa,alice.example.com')]);
    isTrue(admin.contains("PDS_ADMIN_DIDS has 'alice.example.com', which is not a DID"), admin);
    let strayAdmin = refusal([('PDS_ADMIN_DIDS', 'did:plc:aaaa')]);
    isTrue(strayAdmin.contains('PDS_ADMIN_DIDS needs PDS_HOST_DOMAIN'), strayAdmin);

    let stray = refusal([('PDS_ROTATION_KEY', KEY), ('PDS_BLOB_DIR', '/tmp/x')]);
    isTrue(stray.contains('PDS_ROTATION_KEY needs PDS_HOST_DOMAIN'), stray);
    isTrue(stray.contains('need PDS_STORAGE=firestore'), stray);
    let strayDatabase = refusal([('PDS_FIRESTORE_DATABASE', 'pkg')]);
    isTrue(strayDatabase.contains('need PDS_STORAGE=firestore'), strayDatabase);
    let both = refusal([('PDS_STORAGE', 'firestore'), ('PDS_TENANT', 't'), ('PDS_BLOB_BUCKET', 'b'),
        ('PDS_BLOB_DIR', '/d')]);
    isTrue(both.contains('not both'), both);
  });

  test('builds a PDS, and a package host when it has a domain', (ctx) => {
    let plain = runFuture(buildService(configFromEnv(envOf([])), 'http://127.0.0.1:1'));
    isTrue(plain.host == null, 'no package host');
    equal(get(plain.app, '/xrpc/_health').statusCode, 200);
    equal(get(plain.app, '/xrpc/com.atproto.server.describeServer').statusCode, 404);

    let config = configFromEnv(envOf([('PDS_HOST_DOMAIN', 'pkg.test'), ('PDS_RESERVED_SCOPES', 'std'),
        ('PDS_ADMIN_DIDS', 'did:plc:aaaa')]));
    let hosted = runFuture(buildService(config, 'http://127.0.0.1:1'));
    let host = hosted.host;
    if (host == null) {
      isTrue(false, 'a package host');
      return;
    }
    equal(host.config.endpoint, 'https://pkg.test');
    isTrue(host.config.reservedScopes.has('std') && host.config.reservedScopes.has('www'), 'the reserved scopes');
    isTrue(host.isHostAdmin('did:plc:aaaa') && !host.isHostAdmin('did:plc:bbbb'), 'the admins');
    let res = get(hosted.app, '/xrpc/com.atproto.server.describeServer');
    equal(res.statusCode, 200);
    equal((parseJson(res.body as String) as JsonObject)['did'] as String, 'did:web:pkg.test');
    // The service DID resolves, as atproto reads a did:web document, to the
    // host as a PDS.
    let document = get(hosted.app, '/.well-known/did.json');
    equal(document.statusCode, 200);
    let parsed = parseDidDocument(parseJson(document.body as String), 'did:web:pkg.test');
    equal(parsed.pds as String, 'https://pkg.test');
    equal(get(plain.app, '/.well-known/did.json').statusCode, 404);
  });

  test('reads PDS_PLC', (ctx) => {
    isTrue(!configFromEnv(envOf([])).plcStaging, 'public by default');
    isTrue(configFromEnv(envOf([('PDS_PLC', 'staging')])).plcStaging, 'staging');
    let wrong = refusal([('PDS_PLC', 'sandbox')]);
    isTrue(wrong.contains('PDS_PLC is public or staging'), wrong);
  });

  test('is a staging PLC directory, reading other DIDs from upstream', (ctx) => {
    // Upstream knows Alice, whose account is elsewhere, and counts what it
    // is sent.
    let alice = 'did:plc:alicealicealicealicealic';
    let aliceKey = hex.decode('c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721');
    let aliceDocument = stringify(didDocument(alice, genesisOperation(publicKeyFor(KeyType.P256, aliceKey),
        [publicKeyFor(KeyType.P256, aliceKey)], 'alice.test', 'https://elsewhere.test')));
    var posted = 0;
    let api = new App();
    api.use(async (req, res, next): Future<void> => {
      res.type = 'application/json';
      if (req.method == 'POST') {
        posted += 1;
      }
      if (req.path == `/${alice}`) {
        res.statusCode = 200;
        res.body = aliceDocument;
      } else {
        res.statusCode = 404;
        res.body = '{"message":"DID not registered"}';
      }
    });
    let upstream = new Server(api, 0 as u16);
    upstream.start();
    let config = configFromEnv(envOf([('PDS_HOST_DOMAIN', 'pkg.test'), ('PDS_PLC', 'staging'),
        ('PDS_PLC_DIRECTORY', `http://127.0.0.1:${upstream.port as i32}`)]));
    let service = runFuture(buildService(config, 'http://127.0.0.1:1'));
    let host = service.host as PackageHost;

    // Alice's token is checked with her key, read through from upstream.
    let seconds = now().seconds;
    let method = 'dev.zena-lang.host.createOrganization';
    let token = createServiceAuthToken(new ServiceAuthClaims(alice, 'did:web:pkg.test', seconds + 60, seconds,
        method, 'jti-1'), KeyType.P256, aliceKey);
    equal(runFuture(host.authenticate(`Bearer ${token}`, method, seconds)), alice);

    // The organization the host makes is recorded here, and served, and
    // never sent upstream.
    let created = runFuture(host.createOrganization(alice, 'acme',
        [formatDidKey(publicKeyFor(KeyType.P256, aliceKey))], 1792800000000000 as i64));
    let res = get(service.app, `/plc/${created.did}`);
    equal(res.statusCode, 200);
    let document = parseDidDocument(parseJson(res.body as String), created.did);
    equal(document.handle as String, 'acme.pkg.test');
    equal(document.pds as String, 'https://pkg.test');
    equal(posted, 0);
    // Alice reads through, from upstream.
    equal(get(service.app, `/plc/${alice}`).statusCode, 200);
    // The rest of the server is still there.
    equal(get(service.app, '/xrpc/_health').statusCode, 200);
    upstream.close();
  });
});
