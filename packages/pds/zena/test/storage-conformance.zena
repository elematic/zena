/**
 * What every `Storage` and `CredentialStore` must do, as tests that run
 * against any of them: `storage_test.zena` runs them in memory, and
 * `emulator/firestore_test.zena` against the Firestore emulator. The App
 * View's stores have their own, in
 * `packages/registry/zena/test/store-conformance.zena`.
 */

import {test} from 'zena:test';
import {equal, isNull, isTrue} from 'zena:assert';
import {hex} from 'zena:encoding';
import {BlockMap, readCar} from 'atproto:car';
import {Cid} from 'atproto:cid';
import {MapValue, StringValue, newMap} from 'atproto:data';
import {KeyType} from 'atproto:didkey';
import {decodeCommit} from 'atproto:repo';
import {AppPassword, CredentialStore, RefreshSession} from 'pds:sessions';
import {formatDidKey} from 'atproto:didkey';
import {Pds} from 'pds:pds';
import {CreateRecord, DeleteRecord, UpdateRecord, Write} from 'pds:repository';
import {
  Account, AccountKind, BlobRange, Head, KeyEncryption, RecordChange, RecordEntry, ReservedKey, SigningKey, Storage,
  StoredBlob
} from 'pds:storage';
import {Future} from 'zena:async';
import {sha256} from 'zena:crypto';

let ALICE = 'did:plc:alicealicealicealicealic';
let BOB = 'did:plc:bobbobbobbobbobbobbobbob';
let NOW = 1792800000000000 as i64;

function key(type: KeyType = KeyType.P256) {
  return new SigningKey(type, hex.decode('c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721'));
}

/**
 * Encrypts signing keys for tests, and counts what it encrypts and
 * decrypts. A
 * ciphertext is the key XORed with its DID's hash, after the hash's first
 * four bytes, which tie it to the DID: it is not a cipher to keep
 * anything with.
 */
export final class TestKeyEncryption implements KeyEncryption {
  var encrypted = 0;
  var decrypted = 0;

  async encrypt(did: String, privateKey: FixedArray<u8>): Future<FixedArray<u8>> {
    this.encrypted += 1;
    let pad = sha256(did.toBytes());
    let out = new FixedArray<u8>(4 + privateKey.length, 0 as u8);
    for (var i = 0; i < 4; i += 1) {
      out[i] = pad[i];
    }
    for (var i = 0; i < privateKey.length; i += 1) {
      out[4 + i] = (privateKey[i] ^ pad[i % 32]) as u8;
    }
    return out;
  }

  async decrypt(did: String, ciphertext: FixedArray<u8>): Future<FixedArray<u8>> {
    let pad = sha256(did.toBytes());
    for (var i = 0; i < 4; i += 1) {
      if (ciphertext[i] != pad[i]) {
        throw new Error(`this key is not ${did}'s`);
      }
    }
    this.decrypted += 1;
    let out = new FixedArray<u8>(ciphertext.length - 4, 0 as u8);
    for (var i = 0; i < out.length; i += 1) {
      out[i] = (ciphertext[4 + i] ^ pad[i % 32]) as u8;
    }
    return out;
  }
}

function cidOf(text: String) {
  return Cid.forDagCbor(text.toBytes());
}

function record(collection: String, text: String) {
  let value = newMap();
  value.entries['$type'] = new StringValue(collection);
  value.entries['text'] = new StringValue(text);
  return value;
}

function keysOf(entries: Array<RecordEntry>) {
  var out = '';
  for (let entry in entries) {
    out = if (out.length == 0) entry.key() else `${out} ${entry.key()}`;
  }
  return out;
}

function sameBytes(a: FixedArray<u8>, b: FixedArray<u8>): boolean {
  if (a.length != b.length) {
    return false;
  }
  for (var i = 0; i < a.length; i += 1) {
    if (a[i] != b[i]) {
      return false;
    }
  }
  return true;
}

/** Registers the storage tests, each on a new storage from `make`. */
export function storageConformance(make: () => Storage): void {
  test('keeps accounts, by DID and by handle', async (ctx) => {
    let storage = make();
    isNull(await storage.getAccount(ALICE));
    let alice = new Account(ALICE, 'alice.test', key(), AccountKind.Package);
    await storage.putAccount(alice);
    let read = (await storage.getAccount(ALICE)) as Account;
    equal(read.handle as String, 'alice.test');
    isTrue(read.kind == AccountKind.Package, 'kind');
    let readKey = await read.signingKey();
    isTrue(readKey.type == KeyType.P256, 'key type');
    isTrue(sameBytes(readKey.privateKey, key().privateKey), 'private key');
    equal(((await storage.accountByHandle('alice.test')) as Account).did, ALICE);

    // A new handle frees the old one.
    alice.handle = 'alice2.test';
    await storage.putAccount(alice);
    isNull(await storage.accountByHandle('alice.test'));
    equal(((await storage.accountByHandle('alice2.test')) as Account).did, ALICE);
    await storage.putAccount(new Account(BOB, 'alice.test', key(KeyType.Secp256k1)));
    equal(((await storage.accountByHandle('alice.test')) as Account).did, BOB);
    let bob = (await storage.getAccount(BOB)) as Account;
    isTrue((await bob.signingKey()).type == KeyType.Secp256k1, 'secp256k1');
    isTrue(((await storage.getAccount(BOB)) as Account).kind == AccountKind.Person, 'person');
    await storage.putAccount(new Account('did:plc:nohandlenohandlenohandle', null, key()));
    isNull(((await storage.getAccount('did:plc:nohandlenohandlenohandle')) as Account).handle);

    // A managed account keeps the App View that manages it.
    let managed = new Account('did:plc:managedmanagedmanagedman', 'router.acme.test', key(), AccountKind.Package);
    managed.manager = 'did:web:pkg.test';
    await storage.putAccount(managed);
    equal(((await storage.getAccount('did:plc:managedmanagedmanagedman')) as Account).manager as String,
        'did:web:pkg.test');
    isNull(((await storage.getAccount(BOB)) as Account).manager);
  });

  test('keeps a reserved signing key until it is taken, once, or expires', async (ctx) => {
    let storage = make();
    let reserved = key(KeyType.Secp256k1);
    let didKey = formatDidKey(reserved.publicKey());
    let now = 1792800000 as i64;
    isNull(await storage.takeReservedKey(didKey, 'did:web:pkg.test', now));
    await storage.reserveKey(didKey, new ReservedKey(reserved, 'did:web:pkg.test', now + 3600));
    // Only the App View it was reserved for takes it; another leaves it.
    isNull(await storage.takeReservedKey(didKey, 'did:web:other.test', now));
    let taken = (await storage.takeReservedKey(didKey, 'did:web:pkg.test', now)) as ReservedKey;
    equal(taken.reservedFor, 'did:web:pkg.test');
    isTrue(taken.key.type == KeyType.Secp256k1, 'key type');
    isTrue(sameBytes(taken.key.privateKey, reserved.privateKey), 'private key');
    // Once: a second account cannot take the same key.
    isNull(await storage.takeReservedKey(didKey, 'did:web:pkg.test', now));

    let late = key();
    let lateKey = formatDidKey(late.publicKey());
    await storage.reserveKey(lateKey, new ReservedKey(late, 'did:web:pkg.test', now - 1));
    isNull(await storage.takeReservedKey(lateKey, 'did:web:pkg.test', now));
  });

  test('keeps blocks and blobs', async (ctx) => {
    let store = make().store(ALICE);
    let blocks = new BlockMap();
    // More than one batch's worth.
    for (var i = 0; i < 600; i += 1) {
      let bytes = `block ${i}`.toBytes();
      blocks.set(Cid.forDagCbor(bytes), bytes);
    }
    await store.putBlocks(blocks);
    let last = 'block 599'.toBytes();
    isTrue(sameBytes((await store.getBlock(Cid.forDagCbor(last))) as FixedArray<u8>, last), 'block');
    let first = 'block 0'.toBytes();
    isTrue(await store.getBlock(Cid.forDagCbor(first)) != null, 'first block');
    isTrue(await store.getBlock(cidOf('never stored')) == null, 'no block');

    let bytes = 'a blob'.toBytes();
    let cid = Cid.forBlob(bytes);
    isNull(await store.getBlob(cid));
    await store.putBlob(cid, new StoredBlob('text/plain', bytes));
    let blob = (await store.getBlob(cid)) as StoredBlob;
    equal(blob.mimeType, 'text/plain');
    isTrue(sameBytes(blob.bytes, bytes), 'blob bytes');

    // Part of a blob, with the whole one's size and type.
    let part = (await store.getBlobRange(cid, 2 as i64, 3 as i64)) as BlobRange;
    equal(part.mimeType, 'text/plain');
    equal(part.size, 6 as i64);
    isTrue(sameBytes(part.bytes, 'blo'.toBytes()), 'the range');
    // A range past the end ends at it, and one that starts there is empty.
    isTrue(sameBytes(((await store.getBlobRange(cid, 4 as i64, 10 as i64)) as BlobRange).bytes, 'ob'.toBytes()), 'to the end');
    equal(((await store.getBlobRange(cid, 6 as i64, 1 as i64)) as BlobRange).bytes.length, 0);
    isNull(await store.getBlobRange(cidOf('never stored'), 0 as i64, 1 as i64));
  });

  test('commits only on the head it was built on', async (ctx) => {
    let store = make().store(ALICE);
    isNull(await store.getHead());
    let first = new Head(cidOf('first'), '3l3qo2vutsw2a');
    let second = new Head(cidOf('second'), '3l3qo2vutsw2b');
    isTrue(await store.commit(null, first, [new RecordChange('com.example.post', 'a', cidOf('a'))]));
    isTrue(!await store.commit(null, second, [new RecordChange('com.example.post', 'b', cidOf('b'))]),
        'a second first commit');
    isTrue(!await store.commit(second, second, []), 'a commit after a head that is not');
    isNull(await store.getRecord('com.example.post', 'b'));
    let head = (await store.getHead()) as Head;
    isTrue(head.cid.equals(first.cid) && head.rev == first.rev, 'the first head');

    isTrue(await store.commit(first, second, [
      new RecordChange('com.example.post', 'a', null),
      new RecordChange('com.example.post', 'b', cidOf('b')),
    ]));
    isNull(await store.getRecord('com.example.post', 'a'));
    isTrue(((await store.getRecord('com.example.post', 'b')) as Cid).equals(cidOf('b')), 'b');
    isTrue(((await store.getHead()) as Head).cid.equals(second.cid), 'the second head');
  });

  test('lists records in key order', async (ctx) => {
    let store = make().store(ALICE);
    let changes = new GrowableArray<RecordChange>();
    for (let rkey in ['3l3qo2vutsw2c', '3l3qo2vutsw2a', '__reserved__', '3l3qo2vutsw2b', 'self']) {
      changes.push(new RecordChange('a.b', rkey, cidOf(rkey)));
    }
    // `a.b.c/…` sorts before `a.b/…`: `.` is below `/`.
    changes.push(new RecordChange('a.b.c', 'x', cidOf('x')));
    changes.push(new RecordChange('a.a', 'y', cidOf('y')));
    isTrue(await store.commit(null, new Head(cidOf('h'), '3l3qo2vutsw2a'), changes));
    equal(keysOf(await store.allRecords()),
        'a.a/y a.b.c/x a.b/3l3qo2vutsw2a a.b/3l3qo2vutsw2b a.b/3l3qo2vutsw2c a.b/__reserved__ a.b/self');
    equal(keysOf(await store.listRecords('a.b', null, 2, false)), 'a.b/3l3qo2vutsw2a a.b/3l3qo2vutsw2b');
    equal(keysOf(await store.listRecords('a.b', '3l3qo2vutsw2b', 10, false)),
        'a.b/3l3qo2vutsw2c a.b/__reserved__ a.b/self');
    equal(keysOf(await store.listRecords('a.b', null, 2, true)), 'a.b/self a.b/__reserved__');
    equal(keysOf(await store.listRecords('a.b', '3l3qo2vutsw2b', 10, true)), 'a.b/3l3qo2vutsw2a');
    equal((await store.listRecords('a.c', null, 10, false)).length, 0);
    isTrue(((await store.getRecord('a.b', '__reserved__')) as Cid).equals(cidOf('__reserved__')), 'reserved');
  });

  test('holds a repository a PDS writes and exports', async (ctx) => {
    let storage = make();
    let pds = new Pds(storage);
    let account = await pds.createAccount(ALICE, 'alice.test', key(), NOW);
    let repository = pds.repositoryOf(account);
    await repository.applyWrites([
      new CreateRecord('com.example.post', 'one', record('com.example.post', 'one')),
      new CreateRecord('com.example.post', 'two', record('com.example.post', 'two')),
    ] as Array<Write>, NOW);
    let head = await repository.applyWrites([
      new UpdateRecord('com.example.post', 'one', record('com.example.post', 'edited'), null),
      new DeleteRecord('com.example.post', 'two', null),
    ] as Array<Write>, NOW);
    let car = readCar(await repository.exportCar());
    isTrue(car.roots[0].equals(head.cid), 'the export is of the head');
    let commit = decodeCommit(car.blocks.get(car.roots[0]) as FixedArray<u8>);
    equal(commit.rev, head.rev);
    equal(keysOf(await storage.store(ALICE).allRecords()), 'com.example.post/one');
    isTrue(await repository.recordProof('com.example.post', 'one') != null, 'a proof');
  });
}

/** Registers the PLC log tests, each on a new log from `make`. */
/** What every `CredentialStore` must do. */
export function credentialStoreConformance(make: () => CredentialStore): void {
  test('keeps app passwords by name, once each', async (ctx) => {
    let store = make();
    let did = 'did:plc:botbotbotbotbotbotbotbotb';
    equal((await store.appPasswords(did)).length, 0);
    isTrue(await store.addAppPassword(did, new AppPassword('ci', 'aa', '2026-10-27T00:00:00.000Z')), 'added');
    isTrue(!await store.addAppPassword(did, new AppPassword('ci', 'bb', '2026-10-27T00:00:01.000Z')),
        'a second of the same name');
    isTrue(await store.addAppPassword(did, new AppPassword('deploy', 'cc', '2026-10-27T00:00:02.000Z')), 'another');
    isTrue(await store.addAppPassword('did:plc:otherotherotherotherothe', new AppPassword('ci', 'dd', 'x')),
        'the same name on another account');
    let held = await store.appPasswords(did);
    equal(held.length, 2);
    var hashes = '';
    for (let password in held) {
      hashes = `${hashes}${password.name}=${password.hash} `;
    }
    isTrue(hashes.contains('ci=aa') && hashes.contains('deploy=cc'), hashes);
  });

  test('gives a refresh session to one taker', async (ctx) => {
    let store = make();
    let session = new RefreshSession('jti1', 'did:plc:botbotbotbotbotbotbotbotb', 'com.atproto.appPass',
        1790000000 as i64, 'ci');
    await store.putSession(session);
    let read = (await store.getSession('jti1')) as RefreshSession;
    equal(read.did, session.did);
    equal(read.scope, session.scope);
    equal(read.expiresAt, session.expiresAt);
    equal(read.appPassword, 'ci');
    let taken = (await store.takeSession('jti1')) as RefreshSession;
    equal(taken.did, session.did);
    isNull(await store.takeSession('jti1'));
    isNull(await store.getSession('jti1'));
    isNull(await store.getSession('never'));
  });
}
