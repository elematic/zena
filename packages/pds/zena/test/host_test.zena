    let metadata = ok(fixture.get('/oauth/client-metadata.json'));
    equal(metadata['client_id'] as String, 'https://pkg.test/oauth/client-metadata.json');
    equal(((metadata['redirect_uris'] as JsonArray)[0]) as String, 'https://pkg.test/oauth/callback');
    // Tokens for signing in to the pages, and nothing else.
    equal(metadata['scope'] as String, 'atproto rpc:dev.zena-lang.host.createWebSession?aud=*');
    equal(metadata['token_endpoint_auth_method'] as String, 'none');
  });

  test("links maintainers to their pages, which list the packages that name them", (ctx) => {
    let fixture = new Fixture();
    seedBrowsable(fixture);
    // Alice's DID does not resolve here, so it stands in for her handle.
    let router = pageOf(fixture.get('/packages/router.acme.pkg.test'));
    isTrue(router.contains(`href="/people/${ALICE}"`), router);

    let alice = fixture.get(`/people/${ALICE}`);
    equal(alice.statusCode, 200, 'her page');
    let aliceHtml = pageOf(alice);
    for (let expected in ['href="/packages/router.acme.pkg.test"', 'href="/packages/parser.acme.pkg.test"',
        '>owner<', ALICE]) {
      isTrue(aliceHtml.contains(expected), `${expected} in Alice's page`);
    }
    // Bob is named by no package.
    isTrue(pageOf(fixture.get(`/people/${BOB}`)).contains('No package here names them'), "Bob's page");
    equal(fixture.get('/people/nobody.example.com').statusCode, 404, 'a handle that does not resolve');

    // Avatars only at URLs a page signed; Alice has none here anyway.
    equal(fixture.get(`/people/${ALICE}/avatar`).statusCode, 404, 'unsigned');
    equal(fixture.get(`/people/${ALICE}/avatar?s=forged`).statusCode, 404, 'forged');
    let signature = ((fixture.host as PackageHost).sessions as Sessions).urlSignature(ALICE);
    equal(fixture.get(`/people/${ALICE}/avatar?s=${signature}`).statusCode, 404, 'no avatar');
  });

  test('shows who approved each release, from the attestations in their repositories', (ctx) => {
    let fixture = new Fixture();
    let router = seedBrowsable(fixture);
    let bot = runFuture(fixture.pds.storage.accountByHandle('ci.acme.pkg.test')) as Account;
    // The automation account publishes router too.
    let current = runFuture(fixture.pds.storage.store(router).getRecord(MAINTAINERS_TYPE, 'self')) as Cid;
    ok(putMaintainers(fixture, ALICE, router, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(bot.did, null, null, null, PUBLISHER, true)]), [], current.toString()));
    let release = runFuture(fixture.pds.storage.store(router).getRecord(RELEASE_TYPE, '1.0.0')) as Cid;
    let uri = `at://${router}/${RELEASE_TYPE}/1.0.0`;
    let attestation = new Attestation(uri, release, '2026-10-29T00:00:00.000Z');
    runFuture(fixture.pds.repositoryOf(bot).applyWrites([new CreateRecord(ATTESTATION_TYPE, attestation.recordKey(),
        attestation.toValue()) as Write], 0 as i64));
    // An attestation of another record, at 1.1.0's key, approves nothing.
    let other = runFuture(fixture.pds.storage.store(router).getRecord(RELEASE_TYPE, '1.1.0')) as Cid;
    let misplaced = new Attestation(uri, release, '2026-10-29T00:00:00.000Z');
    runFuture(fixture.pds.repositoryOf(bot).applyWrites([new CreateRecord(ATTESTATION_TYPE,
        new Attestation(`at://${router}/${RELEASE_TYPE}/1.1.0`, other, '2026-10-29T00:00:00.000Z').recordKey(),
        misplaced.toValue()) as Write], 0 as i64));

    let page = pageOf(fixture.get('/packages/router.acme.pkg.test'));
    isTrue(page.contains('<th>Approved by</th>'), 'the column');
    // 1.0.0, newest-but-one, by the bot; 1.1.0 by nobody.
    let rows = page.split('<tr class=');
    isTrue(rows[1].contains('>1.1.0<') && !rows[1].contains('href="/people/ci.acme.pkg.test"'), rows[1]);
    isTrue(rows[2].contains('>1.0.0<') && rows[2].contains('href="/people/ci.acme.pkg.test"'), rows[2]);
  });

  test('shows a release waiting for approval to its maintainers only', (ctx) => {
    let fixture = new Fixture();
    let router = seedBrowsable(fixture);
    ok(fixture.call(ALICE, 'publish',
        `{"package": "${router}", "release": ${releaseJson('2.0.0', upload(fixture, router, archiveOf(router, '2.0.0')))}}`));
    let command = 'zena approve router.acme.pkg.test@2.0.0';
    let alice = webCookie(fixture, ALICE);
    let mine = pageOf(fixture.get('/packages/router.acme.pkg.test', alice));
    isTrue(mine.contains('<h2>Waiting for approval</h2>') && mine.contains(command), mine);
    isTrue(mine.contains('Needs 1 maintainer.'), mine);
    let me = pageOf(fixture.get('/me', alice));
    isTrue(me.contains('<h2>Waiting for approval</h2>') && me.contains(command) &&
        me.contains('href="/packages/router.acme.pkg.test">router</a>'), me);
    // Bob, who does not maintain router, and a visitor see only what is published.
    for (let cookie in [webCookie(fixture, BOB), '']) {
      let theirs = pageOf(fixture.get('/packages/router.acme.pkg.test', if (cookie == '') null else cookie));
      isTrue(!theirs.contains('Waiting for approval') && !theirs.contains('2.0.0'), theirs);
    }
    isTrue(!pageOf(fixture.get('/me', webCookie(fixture, BOB))).contains('Waiting for approval'), 'not on Bob\'s /me');
  });

  test('signs a person in to the pages with their service-auth token, and out', (ctx) => {
    let fixture = new Fixture();
    seedBrowsable(fixture);
    // Signed out, the header offers to sign in, and /me asks to.
    let home = pageOf(fixture.get('/'));
    isTrue(home.contains('data-sign-in') && home.contains('data-service-did="did:web:pkg.test"'), home);
    isTrue(pageOf(fixture.get('/me')).contains('Sign in, with your atproto account'), 'me, signed out');

    let res = fixture.call(ALICE, 'createWebSession', '');
    equal(ok(res)['did'] as String, ALICE);
    let setCookie = res.getHeader('set-cookie') ?? '';
    for (let attribute in ['HttpOnly', 'SameSite=Lax', 'Secure', 'Path=/', 'Max-Age=86400']) {
      isTrue(setCookie.contains(attribute), `${attribute} in ${setCookie}`);
    }
    let cookie = setCookie.split(';')[0];
    isTrue(cookie.startsWith('session='), cookie);

    // Signed in, every page knows, and /me lists Alice's scope and packages.
    // Her DID does not resolve here, so it stands in for her handle.
    let signedIn = pageOf(fixture.get('/', cookie));
    isTrue(signedIn.contains(`data-did="${ALICE}"`) && signedIn.contains('href="/me"') &&
        !signedIn.contains('data-sign-in'), signedIn);
    let me = pageOf(fixture.get('/me', cookie));
    for (let expected in ['href="/scopes/acme"', 'href="/packages/router.acme.pkg.test"',
        'href="/packages/parser.acme.pkg.test"', '>owner<']) {
      isTrue(me.contains(expected), `${expected} in /me`);
    }
    // A cookie this server did not sign is nobody's.
    isTrue(pageOf(fixture.get('/me', 'session=a.b.c')).contains('Sign in, with'), 'a forged cookie');
    // Only a token for this method makes a web session.
    let wrongMethod = `Bearer ${fixture.token(BOB, 'dev.zena-lang.host.getMemberships')}`;
    equal(errorOf(fixture.call(null, 'createWebSession', '', '', 'application/json', wrongMethod)), 'InvalidToken');
    equal(errorOf(fixture.call(null, 'createWebSession', '')), 'AuthenticationRequired');

    // The callback page is a page, for the script to finish on.
    isTrue(pageOf(fixture.get('/oauth/callback')).contains('data-sign-in-status'), 'the callback page');

    let out = fixture.post('/signout', cookie);
    equal(out.statusCode, 303, 'sign out');
    equal(out.getHeader('location') ?? '', '/');
    isTrue((out.getHeader('set-cookie') ?? '').contains('session=; Max-Age=0'), out.getHeader('set-cookie') ?? '');
  });

  test("names private members to those who may see them, and shows the host's admins everything", (ctx) => {
    let fixture = new Fixture();
    let carol = 'did:plc:carolcarolcarolcarolcaro';
    let org = ok(createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let pkg = ok(createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    // A publisher, and a team member, only those allowed may see.
    let publisher = new MemberEntry(carol, PUBLISHER, filled(192));
    ok(putMaintainers(fixture, ALICE, pkgDid, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, publisher.commitment(), null, null, PUBLISHER)]), [publisher],
        (pkg['maintainers'] as JsonObject)['cid'] as String));
    let carolMember = new MemberEntry(carol, MEMBER, filled(194));
    ok(putMembers(fixture, ALICE, orgDid, [entriesSeen(fixture, ALICE, orgDid)[0], carolMember], [carolMember],
        (org['members'] as JsonObject)['cid'] as String));
    ok(putTeam(fixture, ALICE, orgDid, 'core', [new MemberEntry(carol, MAINTAINER, filled(193))], null));
    let bot = ok(fixture.call(ALICE, 'createAutomationAccount', `{"organization": "${orgDid}", "name": "ci"}`));

    // A visitor, and Bob, who belongs to none of it, see members as private.
    let visitor = pageOf(fixture.get('/scopes/acme'));
    isTrue(visitor.contains('a private member') && visitor.contains('<h3 class="mono">core</h3>') &&
        !visitor.contains(ALICE) && !visitor.contains(carol), visitor);
    let bob = webCookie(fixture, BOB);
    let asBob = pageOf(fixture.get('/scopes/acme', bob));
    isTrue(!asBob.contains(ALICE) && !asBob.contains(carol), asBob);
    isTrue(!pageOf(fixture.get('/packages/router.acme.pkg.test', bob)).contains(carol), 'the publisher, to Bob');
    equal(fixture.get('/admin', bob).statusCode, 403, 'admin, to Bob');
    isTrue(!pageOf(fixture.get('/', bob)).contains('href="/admin"'), 'no admin link for Bob');

    // Alice, an owner of acme, sees its members and teams.
    let alice = webCookie(fixture, ALICE);
    let asAlice = pageOf(fixture.get('/scopes/acme', alice));
    isTrue(asAlice.contains(ALICE) && asAlice.contains(carol) && asAlice.contains('>maintainer<'), asAlice);

    // Once Bob is one of the host's admins, he sees every account and every member.
    (fixture.host as PackageHost).config.admins.add(BOB);
    isTrue(pageOf(fixture.get('/', bob)).contains('href="/admin"'), 'the admin link');
    let admin = fixture.get('/admin', bob);
    equal(admin.statusCode, 200, 'admin');
    let adminHtml = pageOf(admin);
    for (let expected in ['href="/scopes/acme"', orgDid, 'href="/packages/router.acme.pkg.test"', pkgDid,
        bot['did'] as String, '1 scope', '1 package', '1 automation account']) {
      isTrue(adminHtml.contains(expected), `${expected} in /admin`);
    }
    let scope = pageOf(fixture.get('/scopes/acme', bob));
    isTrue(scope.contains(ALICE) && scope.contains('>owner<') && scope.contains(carol), scope);
    let router = pageOf(fixture.get('/packages/router.acme.pkg.test', bob));
    isTrue(router.contains(carol) && router.contains('(private)'), router);
    // Signed out, /admin asks to sign in.
    isTrue(pageOf(fixture.get('/admin')).contains('Sign in as one of'), 'admin, signed out');
  });

  test('refuses calls without a valid, unused token for the method', (ctx) => {
    let fixture = new Fixture();
    let body = `{"name": "acme", "recoveryKeys": ["${RECOVERY}"]}`;
    equal(errorOf(fixture.call(null, 'createOrganization', body)), 'AuthenticationRequired');
    let wrongMethod = `Bearer ${fixture.token(ALICE, 'dev.zena-lang.host.publish')}`;
    equal(errorOf(fixture.call(null, 'createOrganization', body, '', 'application/json', wrongMethod)),
        'InvalidToken');
    let once = `Bearer ${fixture.token(ALICE, 'dev.zena-lang.host.createOrganization')}`;
    ok(fixture.call(null, 'createOrganization', body, '', 'application/json', once));
    equal(errorOf(fixture.call(null, 'createOrganization',
        `{"name": "other", "recoveryKeys": ["${RECOVERY}"]}`, '', 'application/json', once)), 'InvalidToken');
  });

  test('refuses names that are taken and callers without the role', (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    equal(errorOf(createOrganization(fixture, BOB, 'acme')), 'NameTaken');
    equal(errorOf(createOrganization(fixture, BOB, 'www')), 'NameTaken');
    equal(errorOf(createOrganization(fixture, BOB, 'Not-A-Name')), 'NameTaken');
    // Bob is not an admin of acme.
    equal(errorOf(createPackage(fixture, BOB, orgDid, 'router')), 'Forbidden');
    let pkgDid = ok(createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    equal(errorOf(createPackage(fixture, ALICE, orgDid, 'router')), 'NameTaken');

    // Bob does not maintain router.
    equal(errorOf(fixture.call(BOB, 'uploadArtifact', 'bytes', `?package=${pkgDid}`, 'text/plain')), 'Forbidden');
    let blob = upload(fixture, pkgDid, archiveOf(pkgDid, '1.0.0'));
    release(fixture, ALICE, pkgDid, '1.0.0', blob);
    equal(errorOf(fixture.call(ALICE, 'publish', `{"package": "${pkgDid}", "release": ${releaseJson('1.0.0', blob)}}`)),
        'VersionExists');
    equal(errorOf(fixture.call(BOB, 'completeRelease', `{"package": "${pkgDid}", "version": "1.0.0"}`)), 'Forbidden');
    equal(errorOf(fixture.call(BOB, 'withdrawRelease', `{"package": "${pkgDid}", "version": "1.0.0"}`)), 'Forbidden');
    let missing = new BlobRef(Cid.forBlob('never uploaded'.toBytes()), 'text/plain', 14 as i64);
    equal(errorOf(fixture.call(ALICE, 'publish', `{"package": "${pkgDid}", "release": ${releaseJson('1.1.0', missing)}}`)),
        'BlobNotFound');
    equal(errorOf(fixture.call(BOB, 'publish', `{"package": "${pkgDid}", "release": ${releaseJson('1.2.0', blob)}}`)),
        'Forbidden');

    // A maintainer retracts a release that exists, and may give a new
    // reason later; a version with no release, and Bob, are refused.
    let retract = (caller: String, version: String, reason: String) => fixture.call(caller, 'retract',
        `{"package": "${pkgDid}", "version": "${version}", "reason": "${reason}"}`);
    equal(errorOf(retract(BOB, '1.0.0', 'mine now')), 'Forbidden');
    equal(errorOf(retract(ALICE, '9.9.9', 'never was')), 'ReleaseNotFound');
    let retracted = ok(retract(ALICE, '1.0.0', 'broken'));
    equal(retracted['uri'] as String, `at://${pkgDid}/${RETRACTION_TYPE}/1.0.0`);
    let again = ok(retract(ALICE, '1.0.0', 'broken on Windows'));
    isTrue(!((again['cid'] as String) == (retracted['cid'] as String)), 'the reason was replaced');
    let record = ok(fixture.get(`/xrpc/com.atproto.repo.getRecord?repo=${pkgDid}&collection=${RETRACTION_TYPE}&rkey=1.0.0`));
    let read = Retraction.fromValue(fromJson(record['value']), '1.0.0');
    equal(read.reason as String, 'broken on Windows');
    // The release itself stays.
    ok(fixture.get(`/xrpc/com.atproto.repo.getRecord?repo=${pkgDid}&collection=${RELEASE_TYPE}&rkey=1.0.0`));
  });

  test('takes a name only once, however the lookups race', (ctx) => {
    let fixture = new Fixture(new StaleHostStore());
    let orgDid = ok(createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    equal(errorOf(createOrganization(fixture, BOB, 'acme')), 'NameTaken');
    ok(createPackage(fixture, ALICE, orgDid, 'router'));
    equal(errorOf(createPackage(fixture, ALICE, orgDid, 'router')), 'NameTaken');
    // Only the accounts that got their names were sent to the directory,
    // and have records.
    equal(fixture.submitted.size, 2);
    equal(fixture.records.lookup('acme.pkg.test') as String, orgDid);
  });

  test('gives a name back when its account cannot be made', (ctx) => {
    let fixture = new Fixture();
    fixture.plcDown = true;
    equal(createOrganization(fixture, ALICE, 'acme').statusCode, 500);
    isTrue(fixture.records.lookup('acme.pkg.test') == null, 'no record for an account not made');
    fixture.plcDown = false;
    let orgDid = ok(createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    fixture.plcDown = true;
    equal(createPackage(fixture, ALICE, orgDid, 'router').statusCode, 500);
    isTrue(fixture.records.lookup('router.acme.pkg.test') == null, 'no record for an account not made');
    fixture.plcDown = false;
    let pkgDid = ok(createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    equal(fixture.records.lookup('router.acme.pkg.test') as String, pkgDid);
  });

  test('writes every handle record again from its store', (ctx) => {
    let store = new MemoryHostStore();
    let fixture = new Fixture(store);
    let orgDid = ok(createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkgDid = ok(createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    // The records are lost, and a name was claimed for an account that was
    // never made, as a crash between the two would leave it.
    runFuture(fixture.records.remove('acme.pkg.test'));
    runFuture(fixture.records.remove('router.acme.pkg.test'));
    runFuture(store.claimName('acme', 'ghost', 'did:plc:ghostghostghostghostghos'));

    equal(runFuture((fixture.host as PackageHost).syncHandles()), 2);
    equal(fixture.records.lookup('acme.pkg.test') as String, orgDid);
    equal(fixture.records.lookup('router.acme.pkg.test') as String, pkgDid);
    isTrue(fixture.records.lookup('ghost.acme.pkg.test') == null, 'no record for an account that does not exist');
  });

  test('refuses a release that does not agree with its archive, or depends on what is not there', (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkgDid = ok(createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    let publish = (version: String, blob: BlobRef): Response => fixture.call(ALICE, 'publish',
        `{"package": "${pkgDid}", "release": ${releaseJson(version, blob)}}`);
    let refusal = (res: Response): String => {
      isTrue(res.statusCode == 400, `${res.statusCode}: ${res.body as String}`);
      let body = json(res);
      equal(body['error'] as String, 'InvalidRelease');
      return body['message'] as String;
    };

    // The archive is 2.0.0, and the release says 2.1.0.
    let mismatched = refusal(publish('2.1.0', upload(fixture, pkgDid, archiveOf(pkgDid, '2.0.0'))));
    isTrue(mismatched.contains('is version 2.0.0, not 2.1.0'), mismatched);
    // The archive names another package than the profile.
    let renamed = refusal(publish('2.2.0', upload(fixture, pkgDid,
        archiveOf(pkgDid, '2.2.0', `{"name": "routing", "version": "2.2.0"}`))));
    isTrue(renamed.contains('names routing, not router'), renamed);
    // Not an archive at all.
    let text = BlobRef.fromValue(fromJson(ok(fixture.call(ALICE, 'uploadArtifact', 'just text',
        `?package=${pkgDid}`, 'application/vnd.ipld.car'))['blob'] as JsonObject));
    let junk = refusal(publish('2.3.0', text));
    isTrue(junk.contains('does not unpack'), junk);
    // The archive depends on json, which the release names at a DID that
    // cannot be found.
    let dependent = archiveOf(pkgDid, '2.4.0',
        `{"name": "router", "description": "A package for tests", "license": "MIT", "version": "2.4.0", "dependencies": {"json": {"did": "did:plc:jsonjsonjsonjsonjsonjson", "version": "1.0.0"}}}`);
    let blob = upload(fixture, pkgDid, dependent);
    let release = new Release(Version.parse('2.4.0'), '2026-10-26T00:00:00.000Z',
        new FixedArray<Artifact>(1, Artifact.whole(SOURCE, blob)),
        new FixedArray<Dependency>(1, new Dependency('did:plc:jsonjsonjsonjsonjsonjson', Version.parse('1.0.0'), 'json')));
    let missing = refusal(fixture.call(ALICE, 'publish',
        `{"package": "${pkgDid}", "release": ${stringify(toJson(release.toValue()))}}`));
    isTrue(missing.contains('json 1.0.0') && missing.contains('cannot be found'), missing);

    // None of them was recorded.
    let store = fixture.pds.storage.store(pkgDid);
    for (let version in ['2.1.0', '2.2.0', '2.3.0', '2.4.0']) {
      isTrue(runFuture(store.getRecord(RELEASE_TYPE, version)) == null, version);
    }
  });
});
