/**
 * The package host's methods, through the HTTP routes, as the `zena`
 * command will call them: each with a service-auth token from the
 * caller's own PDS, which these tests sign with the caller's key.
 */

import {suite, test} from 'zena:test';
import {equal, isTrue} from 'zena:assert';
import {Future, runFuture} from 'zena:async';
import {HashMap} from 'zena:collections';
import {join} from 'zena:core';
import {hex} from 'zena:encoding';
import {App, HTMLPartial, Request, Response} from 'zena:http';
import {JsonArray, JsonObject, parseJson, stringify} from 'zena:json';
import {bytesStream} from 'zena:stream';
import {now} from 'wasi:clocks/system-clock';
import {readCar} from 'atproto:car';
import {BlobRef, MapValue, Value, fromJson, toJson} from 'atproto:data';
import {Cid} from 'atproto:cid';
import {KeyType, PublicKey, formatDidKey, parseDidKey, verifySignature} from 'atproto:didkey';
import {PlcOperation, didOfGenesis} from 'atproto:plc';
import {IdentityResolver} from 'atproto:identity';
import {packSource} from 'package-manager:archive';
import {verifyRecordProof} from 'atproto:repo';
import {ServiceAuthClaims, createServiceAuthToken} from 'atproto:service-auth';
import {
  ADMIN, ATTESTATION_TYPE, Artifact, Attestation, Dependency, MAINTAINER, MAINTAINERS_TYPE, MEMBER, Maintainer,
  MEMBERS_TYPE, Maintainers, Members, OWNER, PUBLISHER, Profile,
  RELEASE_TYPE, RETRACTION_TYPE, Release, Retraction, SOURCE, TEAM_TYPE, Team
} from 'package-manager:records';
import {Version} from 'package-manager:version';
import {MemoryHandleRecords} from 'pds:handles';
import {
  ClaimedName, ClaimedScope, HostConfig, HostError, HostStore, MemoryHostStore, PENDING_MICROS, PackageHost,
  PendingChange, PendingRelease
} from 'pds:host';
import {MemberEntry} from 'package-manager:records';
import {Pds} from 'pds:pds';
import {CreateRecord, RepositoryError, Write} from 'pds:repository';
import {createApp} from 'pds:server';
import {MemoryCredentialStore, Sessions} from 'pds:sessions';
import {LocalRotationKey} from 'pds:rotation';
import {Account, AccountKind, MemoryStorage, SigningKey} from 'pds:storage';

let HOST = 'did:web:pkg.test';
let ALICE = 'did:plc:alicealicealicealicealic';
let BOB = 'did:plc:bobbobbobbobbobbobbobbob';
let ALICE_KEY = hex.decode('c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721');
let BOB_KEY = hex.decode('9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60');

/** A host on a PDS in memory, and the PLC operations it sent. */
final class Fixture {
  var app: App;
  var host: PackageHost | null = null;
  pds: Pds;
  submitted = new HashMap<String, PlcOperation>();
  /** The handles' DNS records the host wrote. */
  records = new MemoryHandleRecords();
  /** Whether the PLC directory refuses operations. */
  var plcDown = false;
  /**
   * The records in the repositories of callers this host does not hold,
   * Alice's and Bob's, by `"<did> <collection> <rkey>"`: what the host
   * reads from their PDSes.
   */
  remote = new HashMap<String, Value>();
  var #jti = 0;
  var #random = 0;

  new(store: HostStore = new MemoryHostStore()) : pds = new Pds(new MemoryStorage()), app = new App() {
    let rotation = new SigningKey(KeyType.Secp256k1, filled(200));
    let config = new HostConfig(HOST, 'pkg.test', 'https://pkg.test', new LocalRotationKey(rotation));
    let callers = new HashMap<String, PublicKey>();
    callers[ALICE] = new SigningKey(KeyType.P256, ALICE_KEY).publicKey();
    callers[BOB] = new SigningKey(KeyType.P256, BOB_KEY).publicKey();
    let submitted = this.submitted;
    let pds = this.pds;
    let host = new PackageHost(this.pds, config, store, this.records,
        async (did: String, fresh: boolean): Future<PublicKey | null> => {
          if (let (true, key) = callers.get(did)) {
            return key;
          }
          // An account this PDS holds, such as an automation account.
          let held = await pds.storage.getAccount(did);
          return if (held != null) held.key.publicKey() else null;
        },
        async (did: String, operation: PlcOperation): Future<void> => {
          if (this.plcDown) {
            throw new Error('the PLC directory is down');
          }
          submitted[did] = operation;
        },
        (count: i32) => {
          this.#random += 1;
          return filled(this.#random);
        },
        unreachableResolver());
    let remote = this.remote;
    host.remoteRecords = async (did: String, collection: String, rkey: String): Future<Value | null> => {
      if (let (true, value) = remote.get(`${did} ${collection} ${rkey}`)) {
        return value;
      }
      return null;
    };
    this.host = host;
    var counter = 0;
    let sessions = new Sessions(this.pds.storage, new MemoryCredentialStore(), filled(77), (count: i32) => {
      counter += 1;
      return new FixedArray<u8>(count, (counter + 100) as u8);
    });
    host.sessions = sessions;
    this.app = createApp(this.pds, host, sessions);
  }

  /** An attestation by `caller`, Alice or Bob, of the record at `uri` whose CID is `cid`. */
  attest(caller: String, uri: String, cid: String): void {
    let attestation = new Attestation(uri, Cid.parse(cid), '2026-10-29T00:00:00.000Z');
    this.remote[`${caller} ${ATTESTATION_TYPE} ${attestation.recordKey()}`] = attestation.toValue();
  }

  /** A token from `caller`'s PDS for `method`. */
  token(caller: String, method: String): String {
    this.#jti += 1;
    let seconds = now().seconds;
    let key = if (caller == ALICE) ALICE_KEY else BOB_KEY;
    return createServiceAuthToken(new ServiceAuthClaims(caller, HOST, seconds + 60, seconds,
        method, `jti-${this.#jti}`), KeyType.P256, key);
  }

  /** Calls the host method `name` as `caller` with a JSON body, or raw bytes. */
  call(caller: String | null, name: String, body: String | FixedArray<u8>, query: String = '',
      contentType: String = 'application/json', authorization: String | null = null): Response {
    let method = `dev.zena-lang.host.${name}`;
    let headers = new HashMap<String, String>();
    headers['content-type'] = contentType;
    if (authorization != null) {
      headers['authorization'] = authorization as String;
    } else if (caller != null) {
      headers['authorization'] = `Bearer ${this.token(caller as String, method)}`;
    }
    let res = new Response();
    let app = this.app;
    runFuture((async () => {
      let req = new Request.fromUrl(`http://localhost/xrpc/${method}${query}`, 'POST', headers,
          bytesStream(if (body is String) body.toBytes() else body as FixedArray<u8>));
      await app.handleRequest(req, res);
    })());
    return res;
  }

  /** Calls the host query `name` as `caller`, with `query` after the method. */
  query(caller: String, name: String, query: String): Response {
    let method = `dev.zena-lang.host.${name}`;
    let headers = new HashMap<String, String>();
    headers['authorization'] = `Bearer ${this.token(caller, method)}`;
    let res = new Response();
    let app = this.app;
    runFuture((async () => {
      let req = new Request.fromUrl(`http://localhost/xrpc/${method}${query}`, 'GET', headers);
      await app.handleRequest(req, res);
    })());
    return res;
  }

  /** POSTs JSON to `path`, with `token` as a Bearer token when there is one. */
  post(path: String, body: String, token: String | null): Response {
    let headers = new HashMap<String, String>();
    headers['content-type'] = 'application/json';
    if (token != null) {
      headers['authorization'] = `Bearer ${token as String}`;
    }
    let res = new Response();
    let app = this.app;
    runFuture((async () => {
      let req = new Request.fromUrl(`http://localhost${path}`, 'POST', headers, bytesStream(body.toBytes()));
      await app.handleRequest(req, res);
    })());
    return res;
  }

  /** GETs `path` with `token` as a Bearer token. */
  getWith(path: String, token: String): Response {
    let headers = new HashMap<String, String>();
    headers['authorization'] = `Bearer ${token}`;
    let res = new Response();
    let app = this.app;
    runFuture((async () => {
      let req = new Request.fromUrl(`http://localhost${path}`, 'GET', headers);
      await app.handleRequest(req, res);
    })());
    return res;
  }

  get(path: String, cookie: String | null = null): Response {
    return this.#send('GET', path, cookie);
  }

  /** A form post to `path`, with no body. */
  post(path: String, cookie: String | null = null): Response {
    return this.#send('POST', path, cookie);
  }

  #send(method: String, path: String, cookie: String | null): Response {
    let headers = new HashMap<String, String>();
    if (cookie != null) {
      headers['cookie'] = cookie as String;
    }
    let res = new Response();
    let app = this.app;
    runFuture((async () => {
      let req = new Request.fromUrl(`http://localhost${path}`, method, headers);
      await app.handleRequest(req, res);
    })());
    return res;
  }
}

/**
 * A host store whose lookups always miss, as a read can that another
 * server's claim races past.
 */
final class StaleHostStore implements HostStore {
  #inner = new MemoryHostStore();

  async scopeOwner(scope: String): Future<String | null> { return null; }
  async claimScope(scope: String, org: String): Future<boolean> { return await this.#inner.claimScope(scope, org); }
  async releaseScope(scope: String, org: String): Future<void> { await this.#inner.releaseScope(scope, org); }
  async nameInScope(scope: String, name: String): Future<String | null> { return null; }
  async claimName(scope: String, name: String, did: String): Future<boolean> {
    return await this.#inner.claimName(scope, name, did);
  }
  async releaseName(scope: String, name: String, did: String): Future<void> {
    await this.#inner.releaseName(scope, name, did);
  }
  async allScopes(): Future<Array<ClaimedScope>> { return await this.#inner.allScopes(); }
  async allNames(): Future<Array<ClaimedName>> { return await this.#inner.allNames(); }
  async entries(account: String): Future<Array<MemberEntry>> { return await this.#inner.entries(account); }
  async addEntries(account: String, entries: Array<MemberEntry>): Future<void> {
    await this.#inner.addEntries(account, entries);
  }
  async holdRelease(pkg: String, release: PendingRelease): Future<boolean> {
    return await this.#inner.holdRelease(pkg, release);
  }
  async heldRelease(pkg: String, version: String): Future<PendingRelease | null> { return null; }
  async heldReleases(pkg: String): Future<Array<PendingRelease>> { return await this.#inner.heldReleases(pkg); }
  async dropRelease(pkg: String, version: String): Future<void> { await this.#inner.dropRelease(pkg, version); }
  async holdChange(account: String, change: PendingChange): Future<void> {
    await this.#inner.holdChange(account, change);
  }
  async heldChange(account: String, collection: String, rkey: String): Future<PendingChange | null> {
    return await this.#inner.heldChange(account, collection, rkey);
  }
  async heldChanges(account: String): Future<Array<PendingChange>> { return await this.#inner.heldChanges(account); }
  async dropChange(account: String, collection: String, rkey: String, cid: Cid): Future<void> {
    await this.#inner.dropChange(account, collection, rkey, cid);
  }
}

function filled(value: i32): FixedArray<u8> {
  return new FixedArray<u8>(32, value as u8);
}

function json(res: Response): JsonObject {
  return parseJson(res.body as String) as JsonObject;
}

function ok(res: Response): JsonObject {
  isTrue(res.statusCode == 200, `${res.statusCode}: ${res.body as String}`);
  return json(res);
}

function errorOf(res: Response): String {
  isTrue(res.statusCode >= 400, `${res.statusCode}`);
  return json(res)['error'] as String;
}

let RECOVERY = formatDidKey(new SigningKey(KeyType.P256, ALICE_KEY).publicKey());

function createOrganization(fixture: Fixture, caller: String, name: String): Response {
  return fixture.call(caller, 'createOrganization', `{"name": "${name}", "recoveryKeys": ["${RECOVERY}"]}`);
}

function createPackage(fixture: Fixture, caller: String, org: String, name: String): Response {
  let profile = stringify(toJson(new Profile(name).toValue()));
  let maintainers = stringify(toJson(new Maintainers([Maintainer.ofDid(ALICE, OWNER)]).toValue()));
  return fixture.call(caller, 'createPackage',
      `{"organization": "${org}", "recoveryKeys": ["${RECOVERY}"], "profile": ${profile}, "maintainers": ${maintainers}}`);
}

/** `caller`'s view of the entries behind `account`'s members, team or maintainers. */
function entriesSeen(fixture: Fixture, caller: String, account: String, team: String | null = null)
    : Array<MemberEntry> {
  let query = if (team == null) `?account=${account}` else `?account=${account}&team=${team as String}`;
  let list = ok(fixture.query(caller, 'getEntries', query))['entries'] as JsonArray;
  let entries = new GrowableArray<MemberEntry>();
  for (var i = 0; i < list.length; i += 1) {
    entries.push(MemberEntry.fromValue(fromJson(list[i])));
  }
  return entries;
}

/**
 * Scopes acme and zeta; in acme, router, with 1.0.0 and 1.1.0, which is
 * retracted, parser, unreleased, and the automation account ci. Returns
 * router's DID.
 */
function seedBrowsable(fixture: Fixture): String {
  let orgDid = ok(createOrganization(fixture, ALICE, 'acme'))['did'] as String;
  ok(createOrganization(fixture, BOB, 'zeta'));
  let profile = stringify(toJson(new Profile('router', 'Routes requests', 'MIT').toValue()));
  let maintainers = stringify(toJson(new Maintainers([Maintainer.ofDid(ALICE, OWNER)]).toValue()));
  let router = ok(fixture.call(ALICE, 'createPackage',
      `{"organization": "${orgDid}", "profile": ${profile}, "maintainers": ${maintainers}}`))['did'] as String;
  ok(createPackage(fixture, ALICE, orgDid, 'parser'));
  ok(fixture.call(ALICE, 'createAutomationAccount', `{"organization": "${orgDid}", "name": "ci"}`));
  for (let version in ['1.0.0', '1.1.0']) {
    release(fixture, ALICE, router, version, upload(fixture, router, archiveOf(router, version)));
  }
  ok(fixture.call(ALICE, 'retract', `{"package": "${router}", "version": "1.1.0", "reason": "broken"}`));
  return router;
}

/** The cookie of a web session for `caller`, from `createWebSession`. */
function webCookie(fixture: Fixture, caller: String): String {
  let res = fixture.call(caller, 'createWebSession', '');
  ok(res);
  return (res.getHeader('set-cookie') ?? '').split(';')[0];
}

/** The HTML of a page `res` answered with. */
function pageOf(res: Response): String {
  isTrue((res.type ?? '').contains('text/html'), res.type ?? 'no type');
  return (res.body as HTMLPartial).toString();
}

/** The JSON of `entries`, as a list. */
function entriesJson(entries: Array<MemberEntry>): String {
  let list = new JsonArray();
  for (let entry in entries) {
    list.push(toJson(entry.toValue()));
  }
  return stringify(list);
}

function commitmentsOf(entries: Array<MemberEntry>): FixedArray<Cid> {
  let out = new FixedArray<Cid>(entries.length, Cid.forBlob(new FixedArray<u8>(0, 0 as u8)));
  for (var i = 0; i < entries.length; i += 1) {
    out[i] = entries[i].commitment();
  }
  return out;
}

/** The `swapRecord` member of a call's body, or nothing. */
function swapJson(swap: String | null): String {
  return if (swap == null) '' else `, "swapRecord": "${swap as String}"`;
}

/** `putMembers` as `caller`: a members record committing to `members`, sending `sent`, then `approved`. */
function putMembers(fixture: Fixture, caller: String, org: String, members: Array<MemberEntry>,
    sent: Array<MemberEntry>, swap: String | null, ownerThreshold: i64 = 1 as i64): Response {
  return approved(fixture, caller, proposeMembers(fixture, caller, org, members, sent, swap, ownerThreshold));
}

/** `putMembers` as `caller`, which only holds the change. */
function proposeMembers(fixture: Fixture, caller: String, org: String, members: Array<MemberEntry>,
    sent: Array<MemberEntry>, swap: String | null, ownerThreshold: i64 = 1 as i64): Response {
  let record = stringify(toJson(new Members(commitmentsOf(members), ownerThreshold).toValue()));
  return fixture.call(caller, 'putMembers',
      `{"organization": "${org}", "members": ${record}, "entries": ${entriesJson(sent)}${swapJson(swap)}}`);
}

/** `putTeam` as `caller`: `org`'s team `name`, committing to `members`, sending them all, then `approved`. */
function putTeam(fixture: Fixture, caller: String, org: String, name: String, members: Array<MemberEntry>,
    swap: String | null, threshold: i64 = 1 as i64): Response {
  return approved(fixture, caller, proposeTeam(fixture, caller, org, name, members, swap, threshold));
}

/** `putTeam` as `caller`, which only holds the change. */
function proposeTeam(fixture: Fixture, caller: String, org: String, name: String, members: Array<MemberEntry>,
    swap: String | null, threshold: i64 = 1 as i64): Response {
  let record = stringify(toJson(new Team(commitmentsOf(members), threshold).toValue()));
  return fixture.call(caller, 'putTeam',
      `{"organization": "${org}", "name": "${name}", "team": ${record}, "entries": ${entriesJson(members)}${swapJson(swap)}}`);
}

/** `putMaintainers` as `caller`, sending `sent`, then `approved`. */
function putMaintainers(fixture: Fixture, caller: String, pkg: String, maintainers: Maintainers,
    sent: Array<MemberEntry>, swap: String | null): Response {
  return approved(fixture, caller, proposeMaintainers(fixture, caller, pkg, maintainers, sent, swap));
}

/** `putMaintainers` as `caller`, which only holds the change. */
function proposeMaintainers(fixture: Fixture, caller: String, pkg: String, maintainers: Maintainers,
    sent: Array<MemberEntry>, swap: String | null): Response {
  let record = stringify(toJson(maintainers.toValue()));
  return fixture.call(caller, 'putMaintainers',
      `{"package": "${pkg}", "maintainers": ${record}, "entries": ${entriesJson(sent)}${swapJson(swap)}}`);
}

/**
 * After a put that `held` answered, `caller`'s attestation of the new
 * record and `completeChange`, whose answer it returns: `written` when the
 * record before it allowed `caller` alone. A put that failed is `held`.
 */
function approved(fixture: Fixture, caller: String, held: Response): Response {
  if (held.statusCode != 200) {
    return held;
  }
  let body = json(held);
  fixture.attest(caller, body['uri'] as String, body['cid'] as String);
  return completeChange(fixture, caller, body['uri'] as String, body['cid'] as String);
}

/** `completeChange` of the record at `uri`, as `caller`. */
function completeChange(fixture: Fixture, caller: String, uri: String, cid: String): Response {
  return fixture.call(caller, 'completeChange', `{"uri": "${uri}", "cid": "${cid}"}`);
}

/** `uploadArtifact` as `caller`, which only a maintainer may do. */
function upload(fixture: Fixture, caller: String, pkg: String): Response {
  return fixture.call(caller, 'uploadArtifact', new FixedArray<u8>(4, 1 as u8), `?package=${pkg}`,
      'application/octet-stream');
}

/**
 * A resolver whose directory is a closed port, so a release's dependencies
 * are never found and the tests reach no network.
 */
function unreachableResolver(): IdentityResolver {
  let resolver = new IdentityResolver();
  resolver.plcDirectory = 'http://127.0.0.1:1';
  resolver.dnsOverHttps = 'http://127.0.0.1:1';
  return resolver;
}

/** A source archive of `router` `version`, the package `did`, as `zena publish` packs one. */
function archiveOf(did: String, version: String, manifest: String | null = null): FixedArray<u8> {
  let files = new HashMap<String, FixedArray<u8>>();
  files['zena-package.json'] = (manifest ?? `{"name": "router", "did": "${did}", "description": "A package for tests", "license": "MIT", "version": "${version}"}`)
    .toBytes() as FixedArray<u8>;
  files['router.zena'] = 'export let route = 1;\n'.toBytes() as FixedArray<u8>;
  return packSource(files);
}

/** Uploads `archive` to `pkg` as Alice, and returns its blob. */
function upload(fixture: Fixture, pkg: String, archive: FixedArray<u8>): BlobRef {
  return BlobRef.fromValue(fromJson(ok(fixture.call(ALICE, 'uploadArtifact', archive, `?package=${pkg}`,
      'application/vnd.ipld.car'))['blob'] as JsonObject));
}

/**
 * Publishes `version` of `pkg` as `caller`, Alice or Bob, who attests it
 * and completes it, and returns what `completeRelease` answered.
 */
function release(fixture: Fixture, caller: String, pkg: String, version: String, blob: BlobRef): JsonObject {
  let held = ok(fixture.call(caller, 'publish', `{"package": "${pkg}", "release": ${releaseJson(version, blob)}}`));
  fixture.attest(caller, held['uri'] as String, held['cid'] as String);
  let completed = complete(fixture, caller, pkg, version);
  equal(completed['state'] as String, 'published');
  return completed;
}

/** `completeRelease` of `version` of `pkg` as `caller`. */
function complete(fixture: Fixture, caller: String, pkg: String, version: String): JsonObject {
  return ok(fixture.call(caller, 'completeRelease', `{"package": "${pkg}", "version": "${version}"}`));
}

/** The DIDs `answer`'s `approvedBy` lists. */
function approvedBy(answer: JsonObject): String {
  let list = answer['approvedBy'] as JsonArray;
  let dids = new GrowableArray<String>();
  for (var i = 0; i < list.length; i += 1) {
    dids.push(list[i] as String);
  }
  return join(dids, ' ');
}

function releaseJson(version: String, blob: BlobRef): String {
  let release = new Release(Version.parse(version), '2026-10-23T00:00:00.000Z',
      new FixedArray<Artifact>(1, Artifact.whole(SOURCE, blob)),
      new FixedArray<Dependency>(0, new Dependency('', Version.parse('0.0.0'), '')));
  return stringify(toJson(release.toValue()));
}

export let tests = suite('pds:host', () => {
  test('creates an organization and a package, and publishes a release a client verifies', (ctx) => {
    let fixture = new Fixture();
    let org = ok(createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    equal(org['handle'] as String, 'acme.pkg.test');
    // The host sent the organization's genesis operation, which makes its
    // DID, with Alice's recovery key ranked above the host's key.
    let orgOperation = fixture.submitted[orgDid];
    equal(didOfGenesis(orgOperation), orgDid);
    equal(orgOperation.rotationKeys[0], RECOVERY);
    equal(orgOperation.rotationKeys.length, 2);
    equal(orgOperation.services['atproto_pds'].endpoint, 'https://pkg.test');

    let pkg = ok(createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    equal(pkg['handle'] as String, 'router.acme.pkg.test');
    // Both handles resolve, by the TXT records the host wrote.
    equal(fixture.records.lookup('acme.pkg.test') as String, orgDid);
    equal(fixture.records.lookup('router.acme.pkg.test') as String, pkgDid);
    equal(((pkg['maintainers'] as JsonObject)['uri'] as String),
        `at://${pkgDid}/dev.zena-lang.package.maintainers/self`);

    let archive = archiveOf(pkgDid, '1.0.0');
    let uploaded = ok(fixture.call(ALICE, 'uploadArtifact', archive, `?package=${pkgDid}`,
        'application/vnd.ipld.car'));
    let blobJson = uploaded['blob'] as JsonObject;
    equal(blobJson['mimeType'] as String, 'application/vnd.ipld.car');
    let blob = BlobRef.fromValue(fromJson(blobJson));

    let published = release(fixture, ALICE, pkgDid, '1.0.0', blob);
    equal(published['uri'] as String, `at://${pkgDid}/${RELEASE_TYPE}/1.0.0`);

    // The release can be fetched with a proof that verifies with the signing
    // key the package's DID document names.
    let signingKey = parseDidKey(fixture.submitted[pkgDid].verificationMethods['atproto']);
    let proof = fixture.get(`/xrpc/com.atproto.sync.getRecord?did=${pkgDid}&collection=${RELEASE_TYPE}&rkey=1.0.0`);
    let verified = verifyRecordProof(readCar(proof.body as FixedArray<u8>), pkgDid, RELEASE_TYPE, '1.0.0',
        (signed, sig) => verifySignature(signingKey, signed, sig));
    equal((verified.cid as Cid).toString(), published['cid'] as String);
    let artifact = fixture.get(`/xrpc/com.atproto.sync.getBlob?did=${pkgDid}&cid=${blob.cid.toString()}`);
    equal(Cid.forBlob(artifact.body as FixedArray<u8>).toString(), Cid.forBlob(archive).toString());

    // A package account holds package records only.
    let account = runFuture(fixture.pds.storage.getAccount(pkgDid)) as Account;
    equal(account.kind, AccountKind.Package);
    var refused = '';
    try {
      runFuture(fixture.pds.repositoryOf(account).applyWrites([new CreateRecord('app.bsky.feed.post', 'x',
          new Profile('x').toValue()) as Write], 0 as i64));
    } catch (e) {
      refused = if (e is RepositoryError) (e as RepositoryError).error else e.message;
    }
    equal(refused, 'InvalidRequest');
  });

  test('holds a release out of the repository until its maintainers attest it', (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkgDid = ok(createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    let blob = upload(fixture, pkgDid, archiveOf(pkgDid, '1.0.0'));
    let body = `{"package": "${pkgDid}", "release": ${releaseJson('1.0.0', blob)}}`;
    let held = ok(fixture.call(ALICE, 'publish', body));
    equal(held['state'] as String, 'pending');
    let uri = held['uri'] as String;
    let cid = held['cid'] as String;
    equal(uri, `at://${pkgDid}/${RELEASE_TYPE}/1.0.0`);

    // Nothing is in the repository, so nothing is in the feed or listed.
    let store = fixture.pds.storage.store(pkgDid);
    isTrue(runFuture(store.getRecord(RELEASE_TYPE, '1.0.0')) == null, 'not written');
    let listed = ok(fixture.get('/xrpc/dev.zena-lang.host.listPackages'))['packages'] as JsonArray;
    isTrue((listed[0] as JsonObject)['latest'] == null, 'no release listed');
    // Publishing it again answers the same; another release of 1.0.0 is refused.
    equal(ok(fixture.call(ALICE, 'publish', body))['cid'] as String, cid);
    let other = new Release(Version.parse('1.0.0'), '2026-10-24T00:00:00.000Z',
        new FixedArray<Artifact>(1, Artifact.whole(SOURCE, blob)),
        new FixedArray<Dependency>(0, new Dependency('', Version.parse('0.0.0'), '')));
    let refused = fixture.call(ALICE, 'publish', `{"package": "${pkgDid}", "release": ${stringify(toJson(other.toValue()))}}`);
    equal(errorOf(refused), 'VersionExists');

    // Unattested, it waits.
    let waiting = complete(fixture, ALICE, pkgDid, '1.0.0');
    equal(waiting['state'] as String, 'pending');
    equal(approvedBy(waiting), '');
    equal((waiting['threshold'] as Box<f64>).value as i32, 1);
    let pending = ok(fixture.query(ALICE, 'getPendingReleases', `?package=${pkgDid}`))['releases'] as JsonArray;
    equal(pending.length, 1);
    let entry = pending[0] as JsonObject;
    equal(entry['version'] as String, '1.0.0');
    equal(entry['cid'] as String, cid);
    equal(entry['publisher'] as String, ALICE);
    equal(((entry['release'] as JsonObject)['version'] as String), '1.0.0');
    equal(errorOf(fixture.query(BOB, 'getPendingReleases', `?package=${pkgDid}`)), 'Forbidden');
    // An attestation of another CID, even at this release's key, counts for nothing.
    let otherCid = Cid.forDagCbor(new FixedArray<u8>(1, 0 as u8)).toString();
    let key = new Attestation(uri, Cid.parse(cid), '2026-10-29T00:00:00.000Z').recordKey();
    fixture.remote[`${ALICE} ${ATTESTATION_TYPE} ${key}`] =
        new Attestation(uri, Cid.parse(otherCid), '2026-10-29T00:00:00.000Z').toValue();
    equal(complete(fixture, ALICE, pkgDid, '1.0.0')['state'] as String, 'pending');

    // Alice's attestation meets the threshold of 1, and the host writes it.
    fixture.attest(ALICE, uri, cid);
    let done = complete(fixture, ALICE, pkgDid, '1.0.0');
    equal(done['state'] as String, 'published');
    equal(approvedBy(done), ALICE);
    equal((runFuture(store.getRecord(RELEASE_TYPE, '1.0.0')) as Cid).toString(), cid);
    equal(complete(fixture, ALICE, pkgDid, '1.0.0')['state'] as String, 'published');
    equal((ok(fixture.query(ALICE, 'getPendingReleases', `?package=${pkgDid}`))['releases'] as JsonArray).length, 0);
    equal(errorOf(fixture.call(ALICE, 'publish', body)), 'VersionExists');
  });

  test('waits for the threshold of maintainers, and for people', (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkg = ok(createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    let robot = 'did:plc:robotrobotrobotrobotrobo';
    var maintainers = new Maintainers([Maintainer.ofDid(ALICE, OWNER), Maintainer.ofDid(BOB, PUBLISHER),
        new Maintainer(robot, null, null, null, PUBLISHER, true)], 2 as i64);
    maintainers.humans = 3 as i64;
    var swap = (pkg['maintainers'] as JsonObject)['cid'] as String;
    // Two people cannot meet humans: 3.
    equal(errorOf(putMaintainers(fixture, ALICE, pkgDid, maintainers, [], swap)), 'InvalidRequest');
    maintainers.humans = 1 as i64;
    swap = ok(putMaintainers(fixture, ALICE, pkgDid, maintainers, [], swap))['cid'] as String;

    let held = ok(fixture.call(BOB, 'publish',
        `{"package": "${pkgDid}", "release": ${releaseJson('1.0.0', upload(fixture, pkgDid, archiveOf(pkgDid, '1.0.0')))}}`));
    let uri = held['uri'] as String;
    let cid = held['cid'] as String;
    // Automation alone is not enough, however many: it needs a person.
    fixture.attest(robot, uri, cid);
    let one = complete(fixture, BOB, pkgDid, '1.0.0');
    equal(one['state'] as String, 'pending');
    equal(approvedBy(one), robot);
    equal((one['humans'] as Box<f64>).value as i32, 1);
    // Bob and the robot make two, one of them a person.
    fixture.attest(BOB, uri, cid);
    let two = complete(fixture, BOB, pkgDid, '1.0.0');
    equal(two['state'] as String, 'published');
    equal(approvedBy(two), `${BOB} ${robot}`);
  });

  test('counts automation the host holds only together with a person', (ctx) => {
    let fixture = new Fixture();
    let router = seedBrowsable(fixture);
    let bot = runFuture(fixture.pds.storage.accountByHandle('ci.acme.pkg.test')) as Account;
    let current = runFuture(fixture.pds.storage.store(router).getRecord(MAINTAINERS_TYPE, 'self')) as Cid;
    ok(putMaintainers(fixture, ALICE, router, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(bot.did, null, null, null, PUBLISHER, true)]), [], current.toString()));
    let held = ok(fixture.call(ALICE, 'publish',
        `{"package": "${router}", "release": ${releaseJson('2.0.0', upload(fixture, router, archiveOf(router, '2.0.0')))}}`));
    let uri = held['uri'] as String;
    let attestation = new Attestation(uri, Cid.parse(held['cid'] as String), '2026-10-29T00:00:00.000Z');
    runFuture(fixture.pds.repositoryOf(bot).applyWrites([new CreateRecord(ATTESTATION_TYPE, attestation.recordKey(),
        attestation.toValue()) as Write], 0 as i64));
    // The host holds the bot's keys, so the bot alone could be the host.
    let alone = complete(fixture, ALICE, router, '2.0.0');
    equal(alone['state'] as String, 'pending');
    equal(approvedBy(alone), bot.did);
    fixture.attest(ALICE, uri, held['cid'] as String);
    equal(complete(fixture, ALICE, router, '2.0.0')['state'] as String, 'published');
  });

  test('frees a version its release was withdrawn from, or waited too long at', (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkg = ok(createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    ok(putMaintainers(fixture, ALICE, pkgDid, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        Maintainer.ofDid(BOB, PUBLISHER)]), [], (pkg['maintainers'] as JsonObject)['cid'] as String));
    let blob = upload(fixture, pkgDid, archiveOf(pkgDid, '1.0.0'));
    let publish = (caller: String, created: String): Response => {
      let release = new Release(Version.parse('1.0.0'), created, new FixedArray<Artifact>(1, Artifact.whole(SOURCE, blob)),
          new FixedArray<Dependency>(0, new Dependency('', Version.parse('0.0.0'), '')));
      return fixture.call(caller, 'publish', `{"package": "${pkgDid}", "release": ${stringify(toJson(release.toValue()))}}`);
    };
    let withdraw = (caller: String): Response =>
        fixture.call(caller, 'withdrawRelease', `{"package": "${pkgDid}", "version": "1.0.0"}`);

    // Alice's release: Bob, a publisher, may not withdraw it; Alice may.
    ok(publish(ALICE, '2026-10-24T00:00:00.000Z'));
    equal(errorOf(publish(BOB, '2026-10-25T00:00:00.000Z')), 'VersionExists');
    equal(errorOf(withdraw(BOB)), 'Forbidden');
    ok(withdraw(ALICE));
    equal(errorOf(withdraw(ALICE)), 'ReleaseNotFound');
    equal(errorOf(fixture.call(ALICE, 'completeRelease', `{"package": "${pkgDid}", "version": "1.0.0"}`)),
        'ReleaseNotFound');

    // Bob's: Alice, an owner, may withdraw it too, and Bob may.
    ok(publish(BOB, '2026-10-25T00:00:00.000Z'));
    ok(withdraw(ALICE));
    ok(publish(BOB, '2026-10-26T00:00:00.000Z'));

    // After seven days, it is gone, and the version is free.
    let host = fixture.host as PackageHost;
    let later = now().seconds * (1000000 as i64) + PENDING_MICROS + (1000000 as i64);
    equal(runFuture(host.pendingReleases(ALICE, pkgDid, later)).length, 0);
    var missing = '';
    try {
      runFuture(host.completeRelease(ALICE, pkgDid, '1.0.0', later));
    } catch (e) {
      missing = if (e is HostError) (e as HostError).error else e.message;
    }
    equal(missing, 'ReleaseNotFound');
    ok(publish(ALICE, '2026-10-27T00:00:00.000Z'));
  });

  test('holds an account alone when its owners give no recovery keys', (ctx) => {
    let fixture = new Fixture();
    let host = (fixture.host as PackageHost).config.rotationKey.publicKey();
    let org = ok(fixture.call(ALICE, 'createOrganization', '{"name": "acme"}'));
    let operation = fixture.submitted[org['did'] as String];
    equal(operation.rotationKeys.length, 1);
    equal(operation.rotationKeys[0], formatDidKey(host));
    let none = ok(fixture.call(ALICE, 'createOrganization', '{"name": "acme2", "recoveryKeys": []}'));
    equal(fixture.submitted[none['did'] as String].rotationKeys.length, 1);

    // The host keeps two of PLC's five rotation keys for itself (#597).
    let four = `"${RECOVERY}", "${RECOVERY}", "${RECOVERY}", "${RECOVERY}"`;
    equal(errorOf(fixture.call(ALICE, 'createOrganization', `{"name": "acme3", "recoveryKeys": [${four}]}`)),
        'InvalidRequest');
    equal(errorOf(fixture.call(ALICE, 'createOrganization', '{"name": "acme3", "recoveryKeys": "no"}')),
        'InvalidRequest');
  });

  test("ranks recovery keys, then the operator's offline key, then the host's online key", (ctx) => {
    let fixture = new Fixture();
    let host = fixture.host as PackageHost;
    let offline = new SigningKey(KeyType.Secp256k1, filled(201)).publicKey();
    host.config.offlineRotationKey = offline;
    let org = ok(createOrganization(fixture, ALICE, 'acme'));
    let operation = fixture.submitted[org['did'] as String];
    equal(operation.rotationKeys.length, 3);
    equal(operation.rotationKeys[0], RECOVERY);
    equal(operation.rotationKeys[1], formatDidKey(offline));
    equal(operation.rotationKeys[2], formatDidKey(host.config.rotationKey.publicKey()));
    // The online key signs it.
    isTrue(operation.isSignedBy(host.config.rotationKey.publicKey()), 'signed by the online key');
    // Four recovery keys and the host's two would pass PLC's five.
    let four = `"${RECOVERY}", "${RECOVERY}", "${RECOVERY}", "${RECOVERY}"`;
    equal(errorOf(fixture.call(ALICE, 'createOrganization', `{"name": "acme2", "recoveryKeys": [${four}]}`)),
        'InvalidRequest');
  });

  test('lets the operator create a reserved scope, which no caller can', (ctx) => {
    let fixture = new Fixture();
    let host = fixture.host as PackageHost;
    equal(errorOf(createOrganization(fixture, ALICE, 'zena')), 'NameTaken');
    let created = runFuture(host.createScopeAsOperator(ALICE, 'zena', [], 0 as i64));
    equal(created.handle, 'zena.pkg.test');
    equal(fixture.submitted[created.did].rotationKeys.length, 1);
    // Its owner is Alice, who can create packages in it.
    ok(createPackage(fixture, ALICE, created.did, 'wit-parser'));
    // Taken once, as any scope.
    var taken = '';
    try {
      runFuture(host.createScopeAsOperator(BOB, 'zena', [], 0 as i64));
    } catch (e) {
      taken = if (e is HostError) (e as HostError).error else e.message;
    }
    equal(taken, 'NameTaken');
  });

  test('changes an organization\'s members, and a role ends with the record that gave it', (ctx) => {
    let fixture = new Fixture();
    let org = ok(createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    var swap = (org['members'] as JsonObject)['cid'] as String;
    // Alice's own entry, which the host made, is all she needs to keep.
    let alice = entriesSeen(fixture, ALICE, orgDid);
    equal(alice.length, 1);
    equal(alice[0].role, OWNER);
    let bob = new MemberEntry(BOB, ADMIN, filled(150));

    // Only an owner changes the members.
    equal(errorOf(putMembers(fixture, BOB, orgDid, [alice[0], bob], [bob], swap)), 'Forbidden');
    // Each entry is behind a commitment, each commitment has an entry, and
    // the record keeps owners enough for its thresholds.
    equal(errorOf(putMembers(fixture, ALICE, orgDid, [alice[0]], [bob], swap)), 'InvalidRequest');
    equal(errorOf(putMembers(fixture, ALICE, orgDid, [alice[0], bob], [], swap)), 'InvalidRequest');
    equal(errorOf(putMembers(fixture, ALICE, orgDid, [bob], [bob], swap)), 'InvalidRequest');
    equal(errorOf(putMembers(fixture, ALICE, orgDid, [alice[0], bob], [bob], swap, 2 as i64)), 'InvalidRequest');
    let pope = new MemberEntry(BOB, 'pope', filled(151));
    equal(errorOf(putMembers(fixture, ALICE, orgDid, [alice[0], pope], [pope], swap)), 'InvalidRequest');
    equal(errorOf(putMembers(fixture, ALICE, orgDid, [alice[0], bob], [bob], 'bafyreinotacid')), 'InvalidRequest');

    let added = ok(putMembers(fixture, ALICE, orgDid, [alice[0], bob], [bob], swap));
    // A second change made from the same record is refused.
    equal(errorOf(putMembers(fixture, ALICE, orgDid, [alice[0]], [], swap)), 'InvalidSwap');
    swap = added['cid'] as String;

    // Bob, an admin now, creates packages, sees every entry, and sees no
    // more than his own once he is removed.
    ok(createPackage(fixture, BOB, orgDid, 'router'));
    equal(entriesSeen(fixture, BOB, orgDid).length, 2);
    ok(putMembers(fixture, ALICE, orgDid, [alice[0]], [], swap));
    equal(errorOf(createPackage(fixture, BOB, orgDid, 'parser')), 'Forbidden');
    equal(entriesSeen(fixture, BOB, orgDid).length, 0);
    equal(entriesSeen(fixture, ALICE, orgDid).length, 1);
  });

  test('gives a team a package, and takes it away with the team', (ctx) => {
    let fixture = new Fixture();
    let org = ok(createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let alice = entriesSeen(fixture, ALICE, orgDid);
    let bobMember = new MemberEntry(BOB, MEMBER, filled(160));
    ok(putMembers(fixture, ALICE, orgDid, [alice[0], bobMember], [bobMember],
        (org['members'] as JsonObject)['cid'] as String));
    let pkg = ok(createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    var pkgSwap = (pkg['maintainers'] as JsonObject)['cid'] as String;

    // A member makes no team; an admin does, of members only.
    let bob = new MemberEntry(BOB, MAINTAINER, filled(161));
    equal(errorOf(putTeam(fixture, BOB, orgDid, 'core', [bob], null)), 'Forbidden');
    let stranger = new MemberEntry('did:plc:strangerstrangerstranger', MEMBER, filled(162));
    equal(errorOf(putTeam(fixture, ALICE, orgDid, 'core', [bob, stranger], null)), 'InvalidRequest');
    equal(errorOf(putTeam(fixture, ALICE, orgDid, 'Core', [bob], null)), 'InvalidRequest');
    var teamSwap = ok(putTeam(fixture, ALICE, orgDid, 'core', [bob], null))['cid'] as String;
    // The team's maintainer changes it after.
    teamSwap = ok(putTeam(fixture, BOB, orgDid, 'core', [bob], teamSwap))['cid'] as String;
    equal(entriesSeen(fixture, BOB, orgDid, 'core').length, 1);

    // Bob publishes to the package through the team, and is no owner of it.
    equal(errorOf(upload(fixture, BOB, pkgDid)), 'Forbidden');
    let withTeam = new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, null, orgDid, 'core', PUBLISHER)]);
    let missingTeam = new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, null, orgDid, 'nobody', PUBLISHER)]);
    equal(errorOf(putMaintainers(fixture, ALICE, pkgDid, missingTeam, [], pkgSwap)), 'TeamNotFound');
    pkgSwap = ok(putMaintainers(fixture, ALICE, pkgDid, withTeam, [], pkgSwap))['cid'] as String;
    ok(upload(fixture, BOB, pkgDid));
    equal(errorOf(putMaintainers(fixture, BOB, pkgDid, withTeam, [], pkgSwap)), 'Forbidden');

    // Only an admin deletes the team, and with it Bob's part in the package.
    equal(errorOf(fixture.call(BOB, 'deleteTeam', `{"organization": "${orgDid}", "name": "core"}`)), 'Forbidden');
    ok(fixture.call(ALICE, 'deleteTeam', `{"organization": "${orgDid}", "name": "core", "swapRecord": "${teamSwap}"}`));
    equal(errorOf(upload(fixture, BOB, pkgDid)), 'Forbidden');
    equal(errorOf(fixture.call(ALICE, 'deleteTeam', `{"organization": "${orgDid}", "name": "core"}`)), 'TeamNotFound');
  });

  test('changes a package\'s maintainers, with private entries in the roles they give', (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkg = ok(createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    var swap = (pkg['maintainers'] as JsonObject)['cid'] as String;
    let bob = new MemberEntry(BOB, OWNER, filled(170));
    let asOwner = new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, bob.commitment(), null, null, OWNER)]);
    // An entry in another role than the record gives it, too few owners for
    // the threshold, and too few maintainers for releases, are refused.
    let wrongRole = new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, bob.commitment(), null, null, PUBLISHER)]);
    equal(errorOf(putMaintainers(fixture, ALICE, pkgDid, wrongRole, [bob], swap)), 'InvalidRequest');
    equal(errorOf(putMaintainers(fixture, ALICE, pkgDid,
        new Maintainers(asOwner.maintainers, 1 as i64, 3 as i64), [bob], swap)), 'InvalidRequest');
    equal(errorOf(putMaintainers(fixture, ALICE, pkgDid,
        new Maintainers(asOwner.maintainers, 3 as i64), [bob], swap)), 'InvalidRequest');
    equal(errorOf(putMaintainers(fixture, ALICE, pkgDid, asOwner, [], swap)), 'InvalidRequest');

    swap = ok(putMaintainers(fixture, ALICE, pkgDid, asOwner, [bob], swap))['cid'] as String;
    // Bob, an owner by commitment, sees the package's entries and changes
    // its maintainers; his entry stays private to the package's owners.
    equal(entriesSeen(fixture, BOB, pkgDid).length, 1);
    ok(putMaintainers(fixture, BOB, pkgDid, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, bob.commitment(), null, null, OWNER)], 2 as i64), [], swap));
    ok(upload(fixture, BOB, pkgDid));
  });

  test('holds a change to the members until enough owners of the record before it attest it', (ctx) => {
    let fixture = new Fixture();
    let org = ok(createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let alice = entriesSeen(fixture, ALICE, orgDid)[0];
    let bob = new MemberEntry(BOB, OWNER, filled(190));
    // Alice alone owns acme, so her attestation makes Bob an owner, and the
    // new record asks for two owners from then on.
    var swap = ok(putMembers(fixture, ALICE, orgDid, [alice, bob], [bob],
        (org['members'] as JsonObject)['cid'] as String, 2 as i64))['cid'] as String;

    // Alice removes Bob: the change waits, and Bob is an owner until it is written.
    let held = ok(proposeMembers(fixture, ALICE, orgDid, [alice], [], swap));
    equal(held['state'] as String, 'pending');
    let uri = held['uri'] as String;
    let cid = held['cid'] as String;
    equal(uri, `at://${orgDid}/dev.zena-lang.org.members/self`);
    fixture.attest(ALICE, uri, cid);
    let waiting = ok(completeChange(fixture, ALICE, uri, cid));
    equal(waiting['state'] as String, 'pending');
    let requirement = (waiting['requirements'] as JsonArray)[0] as JsonObject;
    equal(requirement['role'] as String, OWNER);
    equal((requirement['threshold'] as Box<f64>).value as i32, 2);
    equal(approvedBy(requirement), ALICE);
    isTrue((runFuture(fixture.pds.storage.store(orgDid).getRecord(MEMBERS_TYPE, 'self')) as Cid).toString() == swap,
        'the record is unchanged');
    equal(entriesSeen(fixture, BOB, orgDid).length, 2);

    // Bob sees the change, with the entries the new record commits to.
    let pending = ok(fixture.query(BOB, 'getPendingChanges', `?account=${orgDid}`))['changes'] as JsonArray;
    equal(pending.length, 1);
    let change = pending[0] as JsonObject;
    equal(change['uri'] as String, uri);
    equal(change['cid'] as String, cid);
    equal(change['base'] as String, swap);
    equal(change['proposer'] as String, ALICE);
    equal((change['entries'] as JsonArray).length, 1);
    equal(((change['entries'] as JsonArray)[0] as JsonObject)['did'] as String, ALICE);
    equal(errorOf(fixture.query(BOB, 'getPendingChanges', `?account=did:plc:nonenonenonenonenonenone`)),
        'InvalidRequest');

    // A later change to the record takes its place, and Alice's attestation
    // of the first counts for nothing toward it.
    let carol = new MemberEntry('did:plc:carolcarolcarolcarolcaro', MEMBER, filled(191));
    let later = ok(proposeMembers(fixture, ALICE, orgDid, [alice, carol], [carol], swap));
    let laterCid = later['cid'] as String;
    let replaced = ok(fixture.query(ALICE, 'getPendingChanges', `?account=${orgDid}`))['changes'] as JsonArray;
    equal(replaced.length, 1);
    equal((replaced[0] as JsonObject)['cid'] as String, laterCid);
    equal(approvedBy(((ok(completeChange(fixture, ALICE, uri, laterCid))['requirements'] as JsonArray)[0])
        as JsonObject), '');

    // Both owners attest it, and it is written.
    fixture.attest(ALICE, uri, laterCid);
    fixture.attest(BOB, uri, laterCid);
    let written = ok(completeChange(fixture, BOB, uri, laterCid));
    equal(written['state'] as String, 'written');
    equal(approvedBy((written['requirements'] as JsonArray)[0] as JsonObject), `${ALICE} ${BOB}`);
    equal((runFuture(fixture.pds.storage.store(orgDid).getRecord(MEMBERS_TYPE, 'self')) as Cid).toString(), laterCid);
    // Bob is no member now; completing again answers as written.
    equal(errorOf(fixture.query(BOB, 'getPendingChanges', `?account=${orgDid}`)), 'Forbidden');
    equal(ok(completeChange(fixture, ALICE, uri, laterCid))['state'] as String, 'written');
    equal(errorOf(completeChange(fixture, ALICE, uri, cid)), 'ChangeNotFound');
  });

  test('lets a team\'s maintainers, or enough admins, change a team', (ctx) => {
    let fixture = new Fixture();
    let org = ok(createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let alice = entriesSeen(fixture, ALICE, orgDid)[0];
    let bobMember = new MemberEntry(BOB, ADMIN, filled(200));
    let members = stringify(toJson(new Members(commitmentsOf([alice, bobMember]), 1 as i64, 2 as i64).toValue()));
    let put = fixture.call(ALICE, 'putMembers', `{"organization": "${orgDid}", "members": ${members}, "entries": ${
        entriesJson([bobMember])}, "swapRecord": "${(org['members'] as JsonObject)['cid'] as String}"}`);
    isTrue(ok(approved(fixture, ALICE, put))['state'] as String == 'written', 'Bob is an admin');

    // A new team needs two admins now.
    let bob = new MemberEntry(BOB, MAINTAINER, filled(201));
    let created = ok(putTeam(fixture, ALICE, orgDid, 'core', [bob], null));
    equal(created['state'] as String, 'pending');
    let uri = created['uri'] as String;
    let requirements = created['requirements'] as JsonArray;
    equal(requirements.length, 1);
    equal(((requirements[0] as JsonObject)['role'] as String), ADMIN);
    isTrue(runFuture(fixture.pds.storage.store(orgDid).getRecord(TEAM_TYPE, 'core')) == null, 'no team yet');
    fixture.attest(BOB, uri, created['cid'] as String);
    var teamSwap = ok(completeChange(fixture, BOB, uri, created['cid'] as String))['cid'] as String;

    // Bob, the team's maintainer, changes it alone: its threshold is 1.
    let carol = new MemberEntry('did:plc:carolcarolcarolcarolcaro', MEMBER, filled(202));
    let carolMember = new MemberEntry('did:plc:carolcarolcarolcarolcaro', MEMBER, filled(203));
    let swap = runFuture(fixture.pds.storage.store(orgDid).getRecord(MEMBERS_TYPE, 'self')) as Cid;
    ok(putMembers(fixture, ALICE, orgDid, [alice, bobMember, carolMember], [carolMember], swap.toString(),
        1 as i64));
    let byMaintainer = ok(putTeam(fixture, BOB, orgDid, 'core', [bob, carol], teamSwap));
    equal(byMaintainer['state'] as String, 'written');
    teamSwap = byMaintainer['cid'] as String;

    // A change held to a team deleted since is dropped when completed.
    let held = ok(proposeTeam(fixture, BOB, orgDid, 'core', [bob], teamSwap));
    fixture.attest(BOB, held['uri'] as String, held['cid'] as String);
    ok(fixture.call(ALICE, 'deleteTeam', `{"organization": "${orgDid}", "name": "core"}`));
    equal(errorOf(completeChange(fixture, BOB, held['uri'] as String, held['cid'] as String)), 'InvalidSwap');
    equal(errorOf(completeChange(fixture, BOB, held['uri'] as String, held['cid'] as String)), 'ChangeNotFound');
  });

  test('holds a change of maintainers until enough owners attest it, and lets it be withdrawn', (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkg = ok(createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    let robot = 'did:plc:robotrobotrobotrobotrobo';
    let two = new Maintainers([Maintainer.ofDid(ALICE, OWNER), Maintainer.ofDid(BOB, OWNER),
        new Maintainer(robot, null, null, null, PUBLISHER, true)], 1 as i64, 2 as i64);
    var swap = ok(putMaintainers(fixture, ALICE, pkgDid, two, [], (pkg['maintainers'] as JsonObject)['cid'] as String))
        ['cid'] as String;

    // Alice drops Bob: he stays an owner until he attests it too.
    let alone = new Maintainers([Maintainer.ofDid(ALICE, OWNER)]);
    let held = ok(putMaintainers(fixture, ALICE, pkgDid, alone, [], swap));
    equal(held['state'] as String, 'pending');
    let uri = held['uri'] as String;
    let cid = held['cid'] as String;
    // The robot's attestation is not an owner's.
    fixture.attest(robot, uri, cid);
    equal(approvedBy((ok(completeChange(fixture, ALICE, uri, cid))['requirements'] as JsonArray)[0] as JsonObject),
        ALICE);
    equal((runFuture(fixture.pds.storage.store(pkgDid).getRecord(MAINTAINERS_TYPE, 'self')) as Cid).toString(), swap);
    ok(upload(fixture, BOB, pkgDid));

    // Bob, an owner, withdraws it; a URI of no account here is refused.
    equal(errorOf(fixture.call(BOB, 'withdrawChange', '{"uri": "at://did:plc:x/dev.zena-lang.org.team/core"}')),
        'InvalidRequest');
    ok(fixture.call(BOB, 'withdrawChange', `{"uri": "${uri}"}`));
    equal(errorOf(fixture.call(BOB, 'withdrawChange', `{"uri": "${uri}"}`)), 'ChangeNotFound');

    // Asked for again, it expires after seven days.
    ok(proposeMaintainers(fixture, ALICE, pkgDid, alone, [], swap));
    let host = fixture.host as PackageHost;
    let later = now().seconds * (1000000 as i64) + PENDING_MICROS + (1000000 as i64);
    equal(runFuture(host.pendingChanges(ALICE, pkgDid, later)).length, 0);
    fixture.attest(BOB, uri, cid);
    equal(errorOf(completeChange(fixture, ALICE, uri, cid)), 'ChangeNotFound');
  });

  test('creates an automation account that signs in and publishes, as a publisher only', (ctx) => {
    let fixture = new Fixture();
    let org = ok(createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let pkg = ok(createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    var swap = (pkg['maintainers'] as JsonObject)['cid'] as String;

    let body = `{"organization": "${orgDid}", "name": "ci"}`;
    equal(errorOf(fixture.call(BOB, 'createAutomationAccount', body)), 'Forbidden');
    let bot = ok(fixture.call(ALICE, 'createAutomationAccount', body));
    let botDid = bot['did'] as String;
    equal(bot['handle'] as String, 'ci.acme.pkg.test');
    equal(fixture.records.lookup('ci.acme.pkg.test') as String, botDid);
    equal(fixture.submitted[botDid].rotationKeys.length, 1);
    equal((runFuture(fixture.pds.storage.getAccount(botDid)) as Account).kind, AccountKind.Automation);
    // Its name is taken in the scope, as a package's would be.
    equal(errorOf(fixture.call(ALICE, 'createAutomationAccount', body)), 'NameTaken');
    equal(errorOf(createPackage(fixture, ALICE, orgDid, 'ci')), 'NameTaken');

    // It signs in with its app password, and gets a token for the host
    // from its PDS, which is this one.
    let session = ok(fixture.post('/xrpc/com.atproto.server.createSession',
        `{"identifier": "ci.acme.pkg.test", "password": "${bot['appPassword'] as String}"}`, null));
    let access = session['accessJwt'] as String;
    let serviceAuth = (method: String): String => ok(fixture.getWith(
        `/xrpc/com.atproto.server.getServiceAuth?aud=${HOST}&lxm=${method}`, access))['token'] as String;
    let upload = 'dev.zena-lang.host.uploadArtifact';
    equal(errorOf(fixture.call(null, 'uploadArtifact', new FixedArray<u8>(4, 1 as u8), `?package=${pkgDid}`,
        'application/octet-stream', `Bearer ${serviceAuth(upload)}`)), 'Forbidden');

    // A package's owners add it as a publisher, marked as automation.
    let entry = new MemberEntry(botDid, PUBLISHER, filled(180), true);
    let unmarked = new MemberEntry(botDid, PUBLISHER, filled(181));
    let asBot = (role: String, marked: boolean, behind: MemberEntry): Maintainers => new Maintainers([
        Maintainer.ofDid(ALICE, OWNER), new Maintainer(null, behind.commitment(), null, null, role, marked)]);
    equal(errorOf(putMaintainers(fixture, ALICE, pkgDid, asBot(PUBLISHER, false, unmarked), [unmarked], swap)),
        'InvalidRequest');
    let ownerEntry = new MemberEntry(botDid, OWNER, filled(182), true);
    equal(errorOf(putMaintainers(fixture, ALICE, pkgDid, asBot(OWNER, true, ownerEntry), [ownerEntry], swap)),
        'InvalidRequest');
    swap = ok(putMaintainers(fixture, ALICE, pkgDid, asBot(PUBLISHER, true, entry), [entry], swap))['cid'] as String;
    ok(fixture.call(null, 'uploadArtifact', new FixedArray<u8>(4, 1 as u8), `?package=${pkgDid}`,
        'application/octet-stream', `Bearer ${serviceAuth(upload)}`));
    // It writes attestations to its own repository, and nothing else.
    let attestation = `{"$type": "dev.zena-lang.package.attestation", "subject": {"uri": "at://${pkgDid}/dev.zena-lang.package.release/1.0.0", "cid": "${swap}"}, "createdAt": "2026-10-27T00:00:00.000Z"}`;
    ok(fixture.post('/xrpc/com.atproto.repo.putRecord',
        `{"repo": "${botDid}", "collection": "dev.zena-lang.package.attestation", "rkey": "one", "record": ${attestation}}`,
        access));
    equal(errorOf(fixture.post('/xrpc/com.atproto.repo.putRecord',
        `{"repo": "${botDid}", "collection": "app.bsky.feed.post", "rkey": "x", "record": {"$type": "app.bsky.feed.post"}}`,
        access)), 'InvalidRequest');
  });

  test('lists the scopes and packages a visitor can browse, with their latest releases', (ctx) => {
    let fixture = new Fixture();
    seedBrowsable(fixture);

    let scopes = ok(fixture.get('/xrpc/dev.zena-lang.host.listScopes'))['scopes'] as JsonArray;
    equal(scopes.length, 2);
    let acme = scopes[0] as JsonObject;
    equal(acme['name'] as String, 'acme');
    equal(acme['handle'] as String, 'acme.pkg.test');
    // The automation account takes a name, and is no package.
    equal((acme['packages'] as Box<f64>).value as i32, 2);
    equal((scopes[1] as JsonObject)['name'] as String, 'zeta');

    let packages = ok(fixture.get('/xrpc/dev.zena-lang.host.listPackages'))['packages'] as JsonArray;
    equal(packages.length, 2);
    equal((packages[0] as JsonObject)['name'] as String, 'parser');
    isTrue((packages[0] as JsonObject)['latest'] == null, 'parser has no release');
    let listed = packages[1] as JsonObject;
    equal(listed['name'] as String, 'router');
    equal(listed['handle'] as String, 'router.acme.pkg.test');
    equal(listed['description'] as String, 'Routes requests');
    equal(listed['license'] as String, 'MIT');
    // 1.1.0 is retracted, so 1.0.0 is the latest; both are releases.
    equal(listed['latest'] as String, '1.0.0');
    equal((listed['releases'] as Box<f64>).value as i32, 2);
    equal((ok(fixture.get('/xrpc/dev.zena-lang.host.listPackages?scope=zeta'))['packages'] as JsonArray).length, 0);
  });

  test('renders the pages a visitor browses', (ctx) => {
    let fixture = new Fixture();
    let router = seedBrowsable(fixture);

    let home = fixture.get('/');
    equal(home.statusCode, 200, 'home');
    let homeHtml = pageOf(home);
    for (let expected in ['href="/packages/router.acme.pkg.test"', 'Routes requests', 'href="/scopes/zeta"',
        '>unreleased<']) {
      isTrue(homeHtml.contains(expected), `${expected} in the home page`);
    }
    // The filter matches the description, ignoring case, and escapes the query.
    let found = pageOf(fixture.get('/?q=ROUTES'));
    isTrue(found.contains('router.acme.pkg.test') && !found.contains('parser.acme.pkg.test'), found);
    let none = pageOf(fixture.get('/?q=%3Cb%3E'));
    isTrue(none.contains('No packages match') && none.contains('&lt;b&gt;') && !none.contains('<b>'), none);

    let scope = pageOf(fixture.get('/scopes/acme'));
    isTrue(scope.contains('@acme') && scope.contains('parser.acme.pkg.test'), scope);
    equal(fixture.get('/scopes/nobody').statusCode, 404, 'a missing scope');

    // A release of parser that depends on router, written straight to its
    // repository: publish would check the dependency against its source.
    let parser = runFuture(fixture.pds.storage.accountByHandle('parser.acme.pkg.test')) as Account;
    let blob = upload(fixture, parser.did, archiveOf(parser.did, '0.3.0'));
    let withDependency = new Release(Version.parse('0.3.0'), '2026-10-24T00:00:00.000Z',
        new FixedArray<Artifact>(1, Artifact.whole(SOURCE, blob)),
        [new Dependency(router, Version.parse('1.0.0'), 'router'),
         new Dependency('did:plc:elsewhereelsewhereelsewh', Version.parse('0.2.1'), 'other')]);
    runFuture(fixture.pds.repositoryOf(parser).applyWrites([new CreateRecord(RELEASE_TYPE, '0.3.0',
        withDependency.toValue()) as Write], 0 as i64));
    let parserHtml = pageOf(fixture.get('/packages/parser.acme.pkg.test'));
    for (let expected in ['href="/scopes/acme"', 'href="/packages/router.acme.pkg.test">router</a>',
        '≥ 1.0.0 (1.x)', 'did:plc:elsewhereelsewhereelsewh', '≥ 0.2.1 (0.x)']) {
      isTrue(parserHtml.contains(expected), `${expected} in parser's page`);
    }

    let pkg = fixture.get('/packages/router.acme.pkg.test');
    equal(pkg.statusCode, 200, 'package');
    let pkgHtml = pageOf(pkg);
    for (let expected in ['zena add router.acme.pkg.test', router, '>MIT<', ALICE, 'broken',
        'class="retracted"']) {
      isTrue(pkgHtml.contains(expected), `${expected} in the package page`);
    }
    // 1.1.0 is retracted, so 1.0.0 is the latest, and listed after it.
    isTrue(pkgHtml.contains('chip-primary">1.0.0<'), 'the latest');
    isTrue(pkgHtml.split('>1.1.0<')[1].contains('>1.0.0</span>'), 'newest first');

    let missing = fixture.get('/packages/nothing.acme.pkg.test');
    equal(missing.statusCode, 404, 'a missing package');
    isTrue(pageOf(missing).contains('No package here'), 'the not-found page');
    equal(fixture.get('/nowhere').statusCode, 404, 'a path no page has');
  });

  test("lists a caller's memberships, a team's packages included", (ctx) => {
    let fixture = new Fixture();
    let org = ok(createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let alice = entriesSeen(fixture, ALICE, orgDid);
    let bobAdmin = new MemberEntry(BOB, ADMIN, filled(190));
    ok(putMembers(fixture, ALICE, orgDid, [alice[0], bobAdmin], [bobAdmin], (org['members'] as JsonObject)['cid'] as String));
    ok(putTeam(fixture, ALICE, orgDid, 'core', [new MemberEntry(BOB, MAINTAINER, filled(191))], null));
    let pkg = ok(createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    ok(putMaintainers(fixture, ALICE, pkgDid, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, null, orgDid, 'core', PUBLISHER)]), [], (pkg['maintainers'] as JsonObject)['cid'] as String));
    ok(createPackage(fixture, ALICE, orgDid, 'parser'));

    let bob = ok(fixture.query(BOB, 'getMemberships', ''));
    equal(bob['did'] as String, BOB);
    let orgs = bob['orgs'] as JsonArray;
    equal(orgs.length, 1);
    equal((orgs[0] as JsonObject)['name'] as String, 'acme');
    equal((orgs[0] as JsonObject)['role'] as String, 'admin');
    let teams = bob['teams'] as JsonArray;
    equal(teams.length, 1);
    equal((teams[0] as JsonObject)['name'] as String, 'core');
    equal((teams[0] as JsonObject)['role'] as String, 'maintainer');
    // Through the team, Bob publishes router, and parser is none of his.
    let packages = bob['packages'] as JsonArray;
    equal(packages.length, 1);
    equal((packages[0] as JsonObject)['handle'] as String, 'router.acme.pkg.test');
    equal((packages[0] as JsonObject)['role'] as String, 'publisher');
    let mine = ok(fixture.query(ALICE, 'getMemberships', ''));
    equal(((mine['orgs'] as JsonArray)[0] as JsonObject)['role'] as String, 'owner');
    equal((mine['teams'] as JsonArray).length, 0);
    equal((mine['packages'] as JsonArray).length, 2);
    // Without a token, nothing.
    equal(errorOf(fixture.get('/xrpc/dev.zena-lang.host.getMemberships')), 'AuthenticationRequired');
  });

  test('resolves handles, and describes the web app as an OAuth client', (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let resolved = ok(fixture.get('/xrpc/com.atproto.identity.resolveHandle?handle=ACME.pkg.test'));
    equal(resolved['did'] as String, orgDid);
