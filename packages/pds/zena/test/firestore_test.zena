/**
 * What of `pds:firestore` runs without Firestore. The store itself is
 * tested against the emulator (`npm run test:emulator`); this file
 * also keeps it compiled in `npm test`, which does not start the emulator.
 */

import {suite, test} from 'zena:test';
import {equal, isTrue} from 'zena:assert';
import {runFuture} from 'zena:async';
import {randomU64} from 'zena:random';
import {DirectoryBlobs, recordId} from 'pds:firestore';

export let tests = suite('pds:firestore', () => {
  test('keeps record keys as document IDs, except the ones Firestore reserves', (ctx) => {
    equal(recordId('3l3qo2vutsw2b'), '3l3qo2vutsw2b');
    equal(recordId('self'), 'self');
    equal(recordId('__reserved__'), '%__reserved__');
    equal(recordId('____'), '%____');
    // Too short to be `__…__`, or not closed.
    equal(recordId('___'), '___');
    equal(recordId('__open'), '__open');
    equal(recordId('_x_'), '_x_');
  });

  test('keeps blob bytes in a directory, making the directories it needs', (ctx) => {
    // `/tmp` outlives a run, so each run writes under a name of its own.
    let blobs = new DirectoryBlobs(`/tmp/pds-blobs-${randomU64()}`);
    let name = 'tenant/did:plc:alicealicealicealicealic/bafkreiexample';
    isTrue(runFuture(blobs.read(name)) == null, 'nothing yet');
    let bytes = 'a blob'.toBytes() as FixedArray<u8>;
    runFuture(blobs.write(name, bytes, 'text/plain'));
    let read = runFuture(blobs.read(name));
    isTrue(read != null, 'written');
    equal(String.fromBytes((read as FixedArray<u8>) as ByteArray), 'a blob');
    // A second write of the same object replaces it.
    runFuture(blobs.write(name, 'again'.toBytes() as FixedArray<u8>, 'text/plain'));
    equal(String.fromBytes((runFuture(blobs.read(name)) as FixedArray<u8>) as ByteArray), 'again');
  });
});
