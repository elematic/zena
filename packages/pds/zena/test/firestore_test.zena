/**
 * What of `pds:firestore` runs without Firestore. The store itself is
 * tested against the emulator (`npm run test:emulator`); this file
 * also keeps it compiled in `npm test`, which does not start the emulator.
 */

import {suite, test} from 'zena:test';
import {equal} from 'zena:assert';
import {recordId} from 'pds:firestore';

export let tests = suite('pds:firestore', () => {
  test('keeps record keys as document IDs, except the ones Firestore reserves', (ctx) => {
    equal(recordId('3l3qo2vutsw2b'), '3l3qo2vutsw2b');
    equal(recordId('self'), 'self');
    equal(recordId('__reserved__'), '%__reserved__');
    equal(recordId('____'), '%____');
    // Too short to be `__…__`, or not closed.
    equal(recordId('___'), '___');
    equal(recordId('__open'), '__open');
    equal(recordId('_x_'), '_x_');
  });
});
