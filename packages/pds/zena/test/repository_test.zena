import {suite, test} from 'zena:test';
import {equal, isNull, isTrue} from 'zena:assert';
import {Future} from 'zena:async';
import {hex} from 'zena:encoding';
import {readCar} from 'atproto:car';
import {Cid} from 'atproto:cid';
import {MapValue, StringValue, newMap, stringField} from 'atproto:data';
import {KeyType, verifySignature} from 'atproto:didkey';
import {mstWalk} from 'atproto:mst';
import {decodeCommit, verifyRecordProof} from 'atproto:repo';
import {isValidTid} from 'atproto:syntax';
import {TidClock} from 'atproto:tid';
import {BlockMap} from 'atproto:car';
import {Pds} from 'pds:pds';
import {CreateRecord, DeleteRecord, Repository, RepositoryError, UpdateRecord, Write} from 'pds:repository';
import {
  Account, AccountStore, Head, MemoryStorage, RecordChange, RecordEntry, SigningKey, StoredBlob
} from 'pds:storage';

let DID = 'did:plc:alicealicealicealicealic';
let NOW = 1792800000000000 as i64;
let POST = 'com.example.post';

function key() {
  return new SigningKey(KeyType.P256,
      hex.decode('c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721'));
}

function record(collection: String, text: String) {
  let value = newMap();
  value.entries['$type'] = new StringValue(collection);
  value.entries['text'] = new StringValue(text);
  return value;
}

/** A PDS with Alice's account, and her repository. */
async function setUp(): Future<(Pds, Account, Repository)> {
  let pds = new Pds(new MemoryStorage(), 5);
  let account = await pds.createAccount(DID, 'alice.test', key(), NOW);
  return (pds, account, pds.repositoryOf(account));
}

function verifyWith(signing: SigningKey) {
  let publicKey = signing.publicKey();
  return (signed: FixedArray<u8>, sig: FixedArray<u8>) => verifySignature(publicKey, signed, sig);
}

/** The error name `write` fails with, or '' when it succeeds. */
async function refusal(repository: Repository, writes: Array<Write>): Future<String> {
  try {
    await repository.applyWrites(writes, NOW);
  } catch (e) {
    return if (e is RepositoryError) e.error else `another error: ${e.message}`;
  }
  return '';
}

/**
 * A store that, at the next commit, first runs `interloper`: another
 * server's write, landing between this one's start and its commit.
 */
final class RacingStore implements AccountStore {
  #inner: AccountStore;
  var interloper: (() => Future<void>) | null = null;
  var commits: i32 = 0;

  new(inner: AccountStore) : #inner = inner;

  async getBlock(cid: Cid): Future<FixedArray<u8> | null> { return await this.#inner.getBlock(cid); }
  async putBlocks(blocks: BlockMap): Future<void> { await this.#inner.putBlocks(blocks); }
  async getRecord(collection: String, rkey: String): Future<Cid | null> {
    return await this.#inner.getRecord(collection, rkey);
  }
  async listRecords(collection: String, after: String | null, limit: i32, descending: boolean)
      : Future<Array<RecordEntry>> {
    return await this.#inner.listRecords(collection, after, limit, descending);
  }
  async allRecords(): Future<Array<RecordEntry>> { return await this.#inner.allRecords(); }
  async getHead(): Future<Head | null> { return await this.#inner.getHead(); }
  async getBlob(cid: Cid): Future<StoredBlob | null> { return await this.#inner.getBlob(cid); }
  async putBlob(cid: Cid, blob: StoredBlob): Future<void> { await this.#inner.putBlob(cid, blob); }

  async commit(previous: Head | null, head: Head, changes: Array<RecordChange>): Future<boolean> {
    this.commits += 1;
    let interloper = this.interloper;
    if (interloper != null) {
      this.interloper = null;
      await interloper();
    }
    return await this.#inner.commit(previous, head, changes);
  }
}

export let tests = suite('pds:repository', () => {
  test('starts an account with a signed commit of an empty tree', async (ctx) => {
    let (pds, account, repository) = await setUp();
    let head = await pds.storage.store(DID).getHead();
    isTrue(head != null);
    let car = readCar(await repository.exportCar());
    let commit = decodeCommit(car.blocks.get(car.roots[0]) as FixedArray<u8>);
    equal(commit.did, DID);
    isNull(commit.prev);
    isTrue(isValidTid(commit.rev), commit.rev);
    isTrue(verifyWith(await account.signingKey())(commit.signedBytes(), commit.sig));
  });

  test("tells the PDS's commit listeners what each commit changed", async (ctx) => {
    let (pds, account, repository) = await setUp();
    var seen = '';
    pds.onCommit(async (committed, head, changes): Future<void> => {
      var line = `${committed.did} ${head.rev}`;
      for (let change in changes) {
        line = `${line} ${change.collection}/${change.rkey}`;
      }
      seen = `${seen}${line}\n`;
    });
    let head = await pds.repositoryOf(account).applyWrites([
      new CreateRecord(POST, '3l3qo2vutsw2b', record(POST, 'one')),
      new CreateRecord(POST, '3l3qo2vutsw2c', record(POST, 'two')),
    ], NOW);
    equal(seen, `${DID} ${head.rev} ${POST}/3l3qo2vutsw2b ${POST}/3l3qo2vutsw2c\n`);
    // A write the repository refuses commits nothing, and tells no one.
    equal(await refusal(pds.repositoryOf(account), [new CreateRecord(POST, '3l3qo2vutsw2b', record(POST, 'again'))]),
        'InvalidRequest');
    equal(seen, `${DID} ${head.rev} ${POST}/3l3qo2vutsw2b ${POST}/3l3qo2vutsw2c\n`);
  });

  test('commits writes, and proves each record against the new commit', async (ctx) => {
    let (pds, account, repository) = await setUp();
    let first = await repository.applyWrites([
      new CreateRecord(POST, '3l3qo2vutsw2b', record(POST, 'one')),
      new CreateRecord(POST, '3l3qo2vutsw2c', record(POST, 'two')),
      new CreateRecord('com.example.profile', 'self', record('com.example.profile', 'me')),
    ], NOW);
    let second = await repository.applyWrites([
      new UpdateRecord(POST, '3l3qo2vutsw2b', record(POST, 'one, edited'), null),
      new DeleteRecord(POST, '3l3qo2vutsw2c', null),
    ], NOW);
    isTrue(first.rev.compareTo(second.rev) < 0, `${first.rev} < ${second.rev}`);

    let proof = verifyRecordProof(readCar((await repository.recordProof(POST, '3l3qo2vutsw2b')) as FixedArray<u8>),
        DID, POST, '3l3qo2vutsw2b', verifyWith(await account.signingKey()));
    isTrue(proof.commit.rev == second.rev);
    isTrue((proof.commit.prev as Cid).equals(first.cid));
    equal(stringField(proof.record as MapValue, 'text') as String, 'one, edited');
    isTrue(await repository.recordProof(POST, '3l3qo2vutsw2c') == null);
  });

  test('exports every node and record under the current commit', async (ctx) => {
    let (pds, account, repository) = await setUp();
    let writes = new GrowableArray<Write>();
    for (var i = 0; i < 40; i += 1) {
      writes.push(new CreateRecord(POST, `record${i}`, record(POST, `${i}`)));
    }
    await repository.applyWrites(writes, NOW);
    let car = readCar(await repository.exportCar());
    let commit = decodeCommit(car.blocks.get(car.roots[0]) as FixedArray<u8>);
    var count = 0;
    mstWalk(commit.data, car.blocks, (key, value) => {
      isTrue(car.blocks.has(value), `the export lacks ${key}`);
      count += 1;
    });
    equal(count, 40);
    // A proof carries only the path to its record.
    let proof = readCar((await repository.recordProof(POST, 'record7')) as FixedArray<u8>);
    isTrue(proof.blocks.size < car.blocks.size, `${proof.blocks.size} of ${car.blocks.size} blocks`);
  });

  test('applies a write again on a head another server moved', async (ctx) => {
    let (pds, account, unused) = await setUp();
    let inner = pds.storage.store(DID);
    let racing = new RacingStore(inner);
    let repository = new Repository(account, racing, new TidClock(1));
    // The other server's clock is an hour ahead.
    let other = new Repository(account, inner, new TidClock(2));
    var theirs: Head | null = null;
    racing.interloper = async (): Future<void> => {
      theirs = await other.applyWrites([new CreateRecord(POST, 'theirs', record(POST, 'theirs'))],
          NOW + (3600000000 as i64));
    };
    let ours = await repository.applyWrites([new CreateRecord(POST, 'ours', record(POST, 'ours'))], NOW);
    equal(racing.commits, 2);
    isTrue(await inner.getRecord(POST, 'theirs') != null, 'their record');
    isTrue(await inner.getRecord(POST, 'ours') != null, 'our record');
    let theirHead = theirs as Head;
    isTrue(theirHead.rev.compareTo(ours.rev) < 0, `${theirHead.rev} < ${ours.rev}`);
    let car = readCar(await repository.exportCar());
    let commit = decodeCommit(car.blocks.get(car.roots[0]) as FixedArray<u8>);
    isTrue((commit.prev as Cid).equals(theirHead.cid), 'our commit follows theirs');
    equal((await inner.allRecords()).length, 2);

    // A write that their record makes invalid fails when it is tried again.
    racing.interloper = async (): Future<void> => {
      await other.applyWrites([new DeleteRecord(POST, 'theirs', null)], NOW);
    };
    equal(await refusal(repository, [new UpdateRecord(POST, 'theirs', record(POST, 'edited'), null)]), 'RecordNotFound');
  });

  test('updates and deletes only the record a swap names, even when a change races it', async (ctx) => {
    let (pds, account, repository) = await setUp();
    await repository.applyWrites([new CreateRecord(POST, 'a', record(POST, 'one'))], NOW);
    let first = (await pds.storage.store(DID).getRecord(POST, 'a')) as Cid;
    await repository.applyWrites([new UpdateRecord(POST, 'a', record(POST, 'two'), first)], NOW);
    let second = (await pds.storage.store(DID).getRecord(POST, 'a')) as Cid;
    isTrue(!second.equals(first), 'updated');
    // The first CID is no longer the record's.
    equal(await refusal(repository, [new UpdateRecord(POST, 'a', record(POST, 'three'), first)]), 'InvalidSwap');
    equal(await refusal(repository, [new DeleteRecord(POST, 'a', first)]), 'InvalidSwap');
    equal(await refusal(repository, [new UpdateRecord(POST, 'missing', record(POST, 'x'), first)]), 'InvalidSwap');

    // A change that lands between the check and the commit is not
    // overwritten: the swap is checked again when the commit is tried again.
    let inner = pds.storage.store(DID);
    let racing = new RacingStore(inner);
    let raced = new Repository(account, racing, new TidClock(3));
    let other = new Repository(account, inner, new TidClock(4));
    racing.interloper = async (): Future<void> => {
      await other.applyWrites([new UpdateRecord(POST, 'a', record(POST, 'theirs'), null)], NOW + (3600000000 as i64));
    };
    equal(await refusal(raced, [new UpdateRecord(POST, 'a', record(POST, 'ours'), second)]), 'InvalidSwap');
    isTrue(!((await inner.getRecord(POST, 'a')) as Cid).equals(second), 'their change stands');
    await repository.applyWrites([new DeleteRecord(POST, 'a', await inner.getRecord(POST, 'a'))], NOW);
    isNull(await inner.getRecord(POST, 'a'));
  });

  test('refuses writes that do not fit the repository, and writes nothing', async (ctx) => {
    let (pds, account, repository) = await setUp();
    await repository.applyWrites([new CreateRecord(POST, 'a', record(POST, 'a'))], NOW);
    let before = await pds.storage.store(DID).getHead();
    equal(await refusal(repository, [new CreateRecord(POST, 'a', record(POST, 'again'))]), 'InvalidRequest');
    equal(await refusal(repository, [new UpdateRecord(POST, 'b', record(POST, 'b'), null)]), 'RecordNotFound');
    equal(await refusal(repository, [new DeleteRecord(POST, 'b', null)]), 'RecordNotFound');
    equal(await refusal(repository, [new CreateRecord(POST, 'c', record('com.example.other', 'c'))]), 'InvalidRecord');
    equal(await refusal(repository, [new CreateRecord('not an nsid', 'c', record('not an nsid', 'c'))]), 'InvalidRequest');
    equal(await refusal(repository, [new CreateRecord(POST, 'no/slash', record(POST, 'c'))]), 'InvalidRequest');
    // A later write in a batch failing leaves the earlier ones unwritten.
    equal(await refusal(repository, [
      new CreateRecord(POST, 'd', record(POST, 'd')),
      new DeleteRecord(POST, 'missing', null),
    ]), 'RecordNotFound');
    isNull(await pds.storage.store(DID).getRecord(POST, 'd'));
    isTrue(((await pds.storage.store(DID).getHead()) as Head).cid.equals((before as Head).cid));
    // Within a batch, a write sees the ones before it.
    equal(await refusal(repository, [
      new CreateRecord(POST, 'e', record(POST, 'e')),
      new DeleteRecord(POST, 'e', null),
    ]), '');
  });
});
