/**
 * Password sessions (`pds:sessions`): app passwords, and the access and
 * refresh tokens a session is made of.
 */

import {suite, test} from 'zena:test';
import {equal, isTrue} from 'zena:assert';
import {runFuture} from 'zena:async';
import {KeyType} from 'atproto:didkey';
import {Pds} from 'pds:pds';
import {MemoryCredentialStore, SessionError, Sessions, Tokens, WEB_SECONDS, WebCaller} from 'pds:sessions';
import {MemoryStorage, SigningKey} from 'pds:storage';

let DID = 'did:plc:botbotbotbotbotbotbotbotb';
let NOW: i64 = 1790000000 as i64;

function sessionsWith(secret: i32, pds: Pds, credentials: MemoryCredentialStore): Sessions {
  var counter = 0;
  return new Sessions(pds.storage, credentials, new FixedArray<u8>(32, secret as u8), (count: i32) => {
    counter += 1;
    return new FixedArray<u8>(count, counter as u8);
  });
}

/** The error a call refused with, or `''`. */
function refusal(call: () => void): String {
  try {
    call();
  } catch (e) {
    return if (e is SessionError) (e as SessionError).error else `another error: ${e.message}`;
  }
  return '';
}

export let tests = suite('pds:sessions', () => {
  test('signs in with an app password, and refuses anything else alike', (ctx) => {
    let pds = new Pds(new MemoryStorage());
    runFuture(pds.createAccount(DID, 'ci.acme.pkg.test', new SigningKey(KeyType.Secp256k1, new FixedArray<u8>(32, 9 as u8)),
        NOW * (1000000 as i64)));
    let credentials = new MemoryCredentialStore();
    let sessions = sessionsWith(1, pds, credentials);
    let password = runFuture(sessions.addAppPassword(DID, 'ci', '2026-10-27T00:00:00.000Z'));
    equal(password.length, 19);
    equal(password.split('-').length, 4);
    // The server keeps the hash alone.
    let held = runFuture(credentials.appPasswords(DID));
    equal(held.length, 1);
    isTrue(held[0].hash != password && !held[0].hash.contains(password), 'only the hash is kept');
    equal(refusal(() => { runFuture(sessions.addAppPassword(DID, 'ci', 'later')); }), 'DuplicateAppPassword');

    let byDid = runFuture(sessions.create(DID, password, NOW));
    equal(byDid.account.did, DID);
    let byHandle = runFuture(sessions.create('CI.acme.pkg.test', password, NOW));
    equal(byHandle.account.did, DID);
    equal(refusal(() => { runFuture(sessions.create(DID, 'aaaa-bbbb-cccc-dddd', NOW)); }), 'AuthenticationRequired');
    equal(refusal(() => { runFuture(sessions.create('did:plc:nobodynobodynobodynobod', password, NOW)); }),
        'AuthenticationRequired');
  });

  test('signs web sessions that stand for nothing else', (ctx) => {
    let pds = new Pds(new MemoryStorage());
    let sessions = sessionsWith(1, pds, new MemoryCredentialStore());
    let person = 'did:plc:alicealicealicealicealic';
    let token = sessions.webSession(person, 'alice.example.com', NOW);
    let caller = sessions.webCaller(token, NOW + (60 as i64));
    isTrue(caller != null, 'a web session');
    equal((caller as WebCaller).did, person);
    equal((caller as WebCaller).name(), 'alice.example.com');
    // Without a handle, the DID stands in.
    equal((sessions.webCaller(sessions.webSession(person, null, NOW), NOW) as WebCaller).name(), person);

    // Expired, signed by another server, altered, or no token at all: nobody.
    isTrue(sessions.webCaller(token, NOW + WEB_SECONDS + (1 as i64)) == null, 'expired');
    isTrue(sessionsWith(2, pds, new MemoryCredentialStore()).webCaller(token, NOW) == null, 'another secret');
    let parts = token.split('.');
    let forged = sessions.webSession('did:plc:mallorymallorymallorymal', null, NOW).split('.');
    isTrue(sessions.webCaller(`${parts[0]}.${forged[1]}.${parts[2]}`, NOW) == null, 'altered');
    isTrue(sessions.webCaller(null, NOW) == null && sessions.webCaller('', NOW) == null, 'none');

    // An account's access token is not a web session, and a web session is
    // not an access token.
    runFuture(pds.createAccount(DID, 'ci.acme.pkg.test', new SigningKey(KeyType.Secp256k1, new FixedArray<u8>(32, 9 as u8)),
        NOW * (1000000 as i64)));
    let password = runFuture(sessions.addAppPassword(DID, 'ci', '2026-10-27T00:00:00.000Z'));
    let tokens = runFuture(sessions.create(DID, password, NOW));
    isTrue(sessions.webCaller(tokens.accessJwt, NOW) == null, 'an access token');
    equal(refusal(() => { runFuture(sessions.authenticate(`Bearer ${token}`, NOW)); }), 'InvalidToken');
  });

  test('checks access tokens, and spends each refresh token once', (ctx) => {
    let pds = new Pds(new MemoryStorage());
    runFuture(pds.createAccount(DID, 'ci.acme.pkg.test', new SigningKey(KeyType.Secp256k1, new FixedArray<u8>(32, 9 as u8)),
        NOW * (1000000 as i64)));
    let credentials = new MemoryCredentialStore();
    let sessions = sessionsWith(1, pds, credentials);
    let password = runFuture(sessions.addAppPassword(DID, 'ci', '2026-10-27T00:00:00.000Z'));
    let tokens = runFuture(sessions.create(DID, password, NOW));

    let caller = runFuture(sessions.authenticate(`Bearer ${tokens.accessJwt}`, NOW + (60 as i64)));
    equal(caller.account.did, DID);
    equal(caller.scope, 'com.atproto.appPass');
    // An expired token, a refresh token in its place, another server's
    // token, a changed one, and none at all are each refused.
    equal(refusal(() => { runFuture(sessions.authenticate(`Bearer ${tokens.accessJwt}`, NOW + (7201 as i64))); }),
        'ExpiredToken');
    equal(refusal(() => { runFuture(sessions.authenticate(`Bearer ${tokens.refreshJwt}`, NOW)); }), 'InvalidToken');
    let other = sessionsWith(2, pds, credentials);
    equal(refusal(() => { runFuture(other.authenticate(`Bearer ${tokens.accessJwt}`, NOW)); }), 'InvalidToken');
    let parts = tokens.accessJwt.split('.');
    let changed = `${parts[0]}.${parts[1]}x.${parts[2]}`;
    equal(refusal(() => { runFuture(sessions.authenticate(`Bearer ${changed}`, NOW)); }), 'InvalidToken');
    equal(refusal(() => { runFuture(sessions.authenticate(null, NOW)); }), 'AuthenticationRequired');

    // Refreshing gives new tokens and spends the old refresh token.
    let fresh = runFuture(sessions.refresh(`Bearer ${tokens.refreshJwt}`, NOW + (60 as i64)));
    isTrue(fresh.refreshJwt != tokens.refreshJwt, 'a new refresh token');
    equal(runFuture(sessions.authenticate(`Bearer ${fresh.accessJwt}`, NOW + (60 as i64))).scope, 'com.atproto.appPass');
    equal(refusal(() => { runFuture(sessions.refresh(`Bearer ${tokens.refreshJwt}`, NOW + (61 as i64))); }),
        'ExpiredToken');
    // Deleting the session ends its refresh token.
    runFuture(sessions.delete(`Bearer ${fresh.refreshJwt}`, NOW + (62 as i64)));
    equal(refusal(() => { runFuture(sessions.refresh(`Bearer ${fresh.refreshJwt}`, NOW + (63 as i64))); }),
        'ExpiredToken');
  });
});
