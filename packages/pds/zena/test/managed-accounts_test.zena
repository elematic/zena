/**
 * Managed accounts (docs/design/package-manager.md, "Managed accounts"),
 * through the HTTP application as an App View calls them: the PDS
 * reserves a signing key for an App View it trusts, creates an account for a
 * DID only when that App View signed the DID's genesis operation, which names
 * the key, and takes the account's writes only with that App View's
 * service-auth tokens.
 */

import {suite, test} from 'zena:test';
import {equal, isTrue} from 'zena:assert';
import {Future} from 'zena:async';
import {HashMap} from 'zena:collections';
import {App, Request, Response} from 'zena:http';
import {JsonArray, JsonObject, parseJson} from 'zena:json';
import {bytesStream} from 'zena:stream';
import {now} from 'wasi:clocks/system-clock';
import {KeyType, PublicKey, formatDidKey, parseDidKey} from 'atproto:didkey';
import {PlcOperation, didOfGenesis, genesisOperation} from 'atproto:plc';
import {ServiceAuthClaims, createServiceAuthToken} from 'atproto:service-auth';
import {ManagedAccounts, TrustedAppView} from 'pds:managed';
import {Pds} from 'pds:pds';
import {createApp} from 'pds:server';
import {Account, MemoryStorage, SigningKey} from 'pds:storage';

let PDS_DID = 'did:web:padstone.test';
let PDS_URL = 'https://padstone.test';
let APP_VIEW_DID = 'did:web:pkg.test';
let OTHER_DID = 'did:web:other-pkg.test';
let HANDLE = 'router.acme.pkg.test';
let PROFILE = 'dev.zena-lang.package.profile';

function key(seed: i32) {
  return new SigningKey(KeyType.Secp256k1, new FixedArray<u8>(32, seed as u8));
}

/**
 * A PDS that trusts two App Views, the one under test and another,
 * with the PLC directory and DID documents it reads.
 */
final class Fixture {
  var app: App;
  pds: Pds;
  /** The App View's rotation key, which signs its DIDs' genesis operations. */
  appViewRotation = key(11);
  /** The App View's own signing key, which its service-auth tokens are signed with. */
  appViewSigning = key(12);
  /** Another trusted App View's keys. */
  otherRotation = key(13);
  otherSigning = key(14);
  /** Each DID's operations, oldest first. */
  logs = new HashMap<String, Array<PlcOperation>>();
  /** The signing key each DID's document names now. */
  keys = new HashMap<String, PublicKey>();
  var #jti = 0;

  new() : pds = new Pds(new MemoryStorage()), app = new App() {
    this.keys[APP_VIEW_DID] = this.appViewSigning.publicKey();
    this.keys[OTHER_DID] = this.otherSigning.publicKey();
    let logs = this.logs;
    let keys = this.keys;
    this.pds.managed = new ManagedAccounts(PDS_DID, PDS_URL,
        [new TrustedAppView(APP_VIEW_DID, [this.appViewRotation.publicKey()]),
         new TrustedAppView(OTHER_DID, [this.otherRotation.publicKey()])],
        async (did: String): Future<Array<PlcOperation>> => {
          if (let (true, log) = logs.get(did)) {
            return log;
          }
          return [];
        },
        async (did: String, fresh: boolean): Future<PublicKey | null> => {
          if (let (true, found) = keys.get(did)) {
            return found;
          }
          return null;
        });
    this.app = createApp(this.pds);
  }

  /** A signing key the PDS reserves for the App View, or for `issuer`, the other one. */
  async reserve(issuer: String = APP_VIEW_DID): Future<PublicKey> {
    let signer = if (issuer == APP_VIEW_DID) this.appViewSigning else this.otherSigning;
    let reserved = ok(await this.call('com.atproto.server.reserveSigningKey', 'POST',
        this.token(issuer, signer, 'com.atproto.server.reserveSigningKey'), '{}'));
    return parseDidKey(reserved['signingKey'] as String);
  }

  /**
   * A DID as an App View mints one: a genesis operation naming `signing` as
   * its signing key and `endpoint` as its PDS, with `rotation` as its
   * rotation keys, signed with `signer`.
   */
  mint(signer: SigningKey, signing: PublicKey, endpoint: String = PDS_URL,
      rotation: Array<PublicKey> | null = null): String {
    let keys: Array<PublicKey> = rotation ?? [this.appViewRotation.publicKey()];
    let operation = genesisOperation(signing, keys, HANDLE, endpoint)
        .signedWith((bytes) => signer.sign(bytes));
    let did = didOfGenesis(operation);
    this.logs[did] = [operation];
    this.keys[did] = signing;
    return did;
  }

  /** A service-auth token from `issuer`, signed with `signer`, for `method` at this PDS. */
  token(issuer: String, signer: SigningKey, method: String): String {
    this.#jti += 1;
    let seconds = now().seconds;
    return createServiceAuthToken(new ServiceAuthClaims(issuer, PDS_DID, seconds + 60, seconds, method,
        `jti-${this.#jti}`), KeyType.Secp256k1, signer.privateKey);
  }

  async call(method: String, httpMethod: String, token: String | null, body: String | FixedArray<u8> | null,
      query: String = '', contentType: String = 'application/json'): Future<Response> {
    let headers = new HashMap<String, String>();
    if (token != null) {
      headers['authorization'] = `Bearer ${token}`;
    }
    let url = `${PDS_URL}/xrpc/${method}${query}`;
    var req = new Request.fromUrl(url, httpMethod, headers);
    if (body != null) {
      headers['content-type'] = contentType;
      let bytes = if (body is String) body.toBytes() else body;
      req = new Request.fromUrl(url, httpMethod, headers, bytesStream(bytes));
    }
    let res = new Response();
    let app = this.app;
    let request = req;
    await app.handleRequest(request, res);
    return res;
  }

  /** `createAccount` for `did`, with `token`. */
  async create(did: String, token: String | null): Future<Response> {
    return await this.call('com.atproto.server.createAccount', 'POST', token, `{"did": "${did}", "handle": "${HANDLE}"}`);
  }

  /** Creates the managed account of a DID the App View mints, and returns the DID. */
  async created(): Future<String> {
    let did = this.mint(this.appViewRotation, await this.reserve());
    ok(await this.create(did, this.appViewToken('com.atproto.server.createAccount')));
    return did;
  }

  /** A token from the App View for `method`. */
  appViewToken(method: String): String {
    return this.token(APP_VIEW_DID, this.appViewSigning, method);
  }
}

function ok(res: Response): JsonObject {
  isTrue(res.statusCode == 200, `${res.statusCode}: ${res.body as String}`);
  return parseJson(res.body as String) as JsonObject;
}

function errorOf(res: Response) {
  isTrue(res.statusCode >= 400, `${res.statusCode}`);
  return (parseJson(res.body as String) as JsonObject)['error'] as String;
}

export let tests = suite('pds:managed', () => {
  test('creates an account for a DID a trusted App View made, with the key it reserved', async (ctx) => {
    let fixture = new Fixture();
    let reserved = await fixture.reserve();
    let did = fixture.mint(fixture.appViewRotation, reserved);
    let created = ok(await fixture.create(did, fixture.appViewToken('com.atproto.server.createAccount')));
    equal(created['did'] as String, did);
    equal(created['handle'] as String, HANDLE);
    let account = (await fixture.pds.storage.getAccount(did)) as Account;
    equal(account.manager as String, APP_VIEW_DID);
    // The key the genesis operation names, which the PDS made and holds.
    equal(formatDidKey((await account.signingKey()).publicKey()), formatDidKey(reserved));

    // Once is enough.
    equal(errorOf(await fixture.create(did, fixture.appViewToken('com.atproto.server.createAccount'))), 'InvalidRequest');
  });

  test('reserves keys only for the App Views it trusts', async (ctx) => {
    let fixture = new Fixture();
    let method = 'com.atproto.server.reserveSigningKey';
    equal(errorOf(await fixture.call(method, 'POST', null, '{}')), 'AuthenticationRequired');
    let stranger = key(41);
    fixture.keys['did:web:stranger.test'] = stranger.publicKey();
    equal(errorOf(await fixture.call(method, 'POST', fixture.token('did:web:stranger.test', stranger, method), '{}')),
        'Forbidden');
    equal(errorOf(await fixture.call(method, 'POST', fixture.appViewToken('com.atproto.server.createAccount'), '{}')),
        'InvalidToken');
    // It reads its input, as its lexicon gives it one.
    equal(errorOf(await fixture.call(method, 'POST', fixture.appViewToken(method), 'a key, please')), 'InvalidRequest');
  });

  test('refuses an account no trusted App View made, or with a key it did not reserve', async (ctx) => {
    let fixture = new Fixture();
    let create = (did: String) => fixture.create(did, fixture.appViewToken('com.atproto.server.createAccount'));

    // Naming the App View's rotation key is not enough: the App View must have signed.
    let attacker = key(31);
    let forged = fixture.mint(attacker, await fixture.reserve(), PDS_URL,
        [fixture.appViewRotation.publicKey(), attacker.publicKey()]);
    equal(errorOf(await create(forged)), 'IncompatibleDidDoc');
    isTrue(await fixture.pds.storage.getAccount(forged) == null, 'no account');

    // A DID whose document names another PDS.
    equal(errorOf(await create(fixture.mint(fixture.appViewRotation, await fixture.reserve(), 'https://other.test'))),
        'IncompatibleDidDoc');

    // A key the PDS did not reserve, or reserved for another App View, whose
    // reservation stays.
    equal(errorOf(await create(fixture.mint(fixture.appViewRotation, key(32).publicKey()))), 'InvalidRequest');
    let others = await fixture.reserve(OTHER_DID);
    equal(errorOf(await create(fixture.mint(fixture.appViewRotation, others))), 'InvalidRequest');
    let theirs = fixture.mint(fixture.otherRotation, others, PDS_URL, [fixture.otherRotation.publicKey()]);
    ok(await fixture.create(theirs, fixture.token(OTHER_DID, fixture.otherSigning, 'com.atproto.server.createAccount')));

    // Only the App View that made the DID asks for its account.
    let did = fixture.mint(fixture.appViewRotation, await fixture.reserve());
    equal(errorOf(await fixture.create(did, fixture.token(OTHER_DID, fixture.otherSigning,
        'com.atproto.server.createAccount'))), 'Forbidden');
    equal(errorOf(await fixture.create(did, null)), 'AuthenticationRequired');

    // An account of its own, with an email address and a password, is not one this PDS makes.
    equal(errorOf(await fixture.call('com.atproto.server.createAccount', 'POST', null,
        '{"handle": "alice.padstone.test", "email": "alice@example.com", "password": "secret"}')), 'InvalidRequest');
  });

  test("takes a managed account's writes only from its App View", async (ctx) => {
    let fixture = new Fixture();
    let did = await fixture.created();
    let profile = `{"$type": "${PROFILE}", "name": "router"}`;
    let writes = `{"repo": "${did}", "writes": [{"$type": "com.atproto.repo.applyWrites#create", "collection": "${PROFILE}", "rkey": "self", "value": ${profile}}]}`;

    // Not without a token, nor with the account's own DID's token.
    equal(errorOf(await fixture.call('com.atproto.repo.applyWrites', 'POST', null, writes)), 'AuthenticationRequired');
    let own = await ((await fixture.pds.storage.getAccount(did)) as Account).signingKey();
    equal(errorOf(await fixture.call('com.atproto.repo.applyWrites', 'POST',
        fixture.token(did, own, 'com.atproto.repo.applyWrites'), writes)), 'Forbidden');
    // Nor with the App View's token for another method.
    equal(errorOf(await fixture.call('com.atproto.repo.applyWrites', 'POST',
        fixture.appViewToken('com.atproto.repo.putRecord'), writes)), 'InvalidToken');

    let applied = ok(await fixture.call('com.atproto.repo.applyWrites', 'POST',
        fixture.appViewToken('com.atproto.repo.applyWrites'), writes));
    isTrue((applied['commit'] as JsonObject)['rev'] is String, 'a commit');
    let result = (applied['results'] as JsonArray)[0] as JsonObject;
    equal(result['uri'] as String, `at://${did}/${PROFILE}/self`);
    let read = ok(await fixture.call('com.atproto.repo.getRecord', 'GET', null, null,
        `?repo=${did}&collection=${PROFILE}&rkey=self`));
    equal(read['cid'] as String, result['cid'] as String);

    // putRecord and deleteRecord take the App View's token too.
    ok(await fixture.call('com.atproto.repo.putRecord', 'POST', fixture.appViewToken('com.atproto.repo.putRecord'),
        `{"repo": "${did}", "collection": "${PROFILE}", "rkey": "self", "record": {"$type": "${PROFILE}", "name": "routing"}}`));
    ok(await fixture.call('com.atproto.repo.deleteRecord', 'POST', fixture.appViewToken('com.atproto.repo.deleteRecord'),
        `{"repo": "${did}", "collection": "${PROFILE}", "rkey": "self"}`));
    equal((await fixture.call('com.atproto.repo.getRecord', 'GET', null, null,
        `?repo=${did}&collection=${PROFILE}&rkey=self`)).statusCode, 404);

    // A blob, for the account its `repo` names, since the App View's token names none.
    let bytes = 'an artifact'.toBytes();
    let blob = ok(await fixture.call('com.atproto.repo.uploadBlob', 'POST', fixture.appViewToken('com.atproto.repo.uploadBlob'),
        bytes, `?repo=${did}`, 'application/octet-stream'))['blob'] as JsonObject;
    equal(blob['mimeType'] as String, 'application/octet-stream');
    equal((blob['size'] as Box<f64>).value as i32, bytes.length);
    equal(errorOf(await fixture.call('com.atproto.repo.uploadBlob', 'POST', fixture.appViewToken('com.atproto.repo.uploadBlob'),
        bytes, '', 'application/octet-stream')), 'InvalidRequest');
  });

  test('limits a managed account to package records and artifacts, whoever writes', async (ctx) => {
    let fixture = new Fixture();
    let did = await fixture.created();
    // Even the App View's writes: the limits are the PDS operator's.
    let post = `{"repo": "${did}", "writes": [{"$type": "com.atproto.repo.applyWrites#create", "collection": "app.bsky.feed.post", "rkey": "x", "value": {"$type": "app.bsky.feed.post", "text": "hi"}}]}`;
    equal(errorOf(await fixture.call('com.atproto.repo.applyWrites', 'POST',
        fixture.appViewToken('com.atproto.repo.applyWrites'), post)), 'InvalidRequest');
    equal(errorOf(await fixture.call('com.atproto.repo.putRecord', 'POST', fixture.appViewToken('com.atproto.repo.putRecord'),
        `{"repo": "${did}", "collection": "app.bsky.feed.post", "rkey": "x", "record": {"$type": "app.bsky.feed.post"}}`)),
        'InvalidRequest');
    // A blob a browser would run as a page is refused, as is one too large.
    equal(errorOf(await fixture.call('com.atproto.repo.uploadBlob', 'POST', fixture.appViewToken('com.atproto.repo.uploadBlob'),
        '<script></script>'.toBytes(), `?repo=${did}`, 'text/html')), 'InvalidRequest');
    fixture.pds.managedLimits.maxBlobSize = 8 as i64;
    let tooLarge = await fixture.call('com.atproto.repo.uploadBlob', 'POST', fixture.appViewToken('com.atproto.repo.uploadBlob'),
        'twelve bytes'.toBytes(), `?repo=${did}`, 'application/octet-stream');
    equal(tooLarge.statusCode, 413);
    equal(errorOf(tooLarge), 'BlobTooLarge');
  });

  test('takes no writes to an account that is not managed, without sessions', async (ctx) => {
    let fixture = new Fixture();
    let did = 'did:plc:ownownownownownownownownow';
    await fixture.pds.createAccount(did, 'own.padstone.test', key(41), 0 as i64);
    let profile = `{"$type": "${PROFILE}", "name": "own"}`;
    equal(errorOf(await fixture.call('com.atproto.repo.putRecord', 'POST', fixture.appViewToken('com.atproto.repo.putRecord'),
        `{"repo": "${did}", "collection": "${PROFILE}", "rkey": "self", "record": ${profile}}`)), 'Forbidden');
    equal(errorOf(await fixture.call('com.atproto.repo.uploadBlob', 'POST', fixture.appViewToken('com.atproto.repo.uploadBlob'),
        'bytes'.toBytes(), `?repo=${did}`, 'application/octet-stream')), 'Forbidden');
  });
});
