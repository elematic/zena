/**
 * The small pieces every page builds from: chips, counts, and the
 * iteration and condition helpers `zena:http`'s `html` tag needs, since a
 * value must be a `String`, an `html` result, `unsafeHTML`, null, or an
 * iterable of those.
 */

import {HashMap} from 'zena:collections';
import {GrowableArray} from 'zena:core';
import {HTMLPartial, TemplateValue, html, unsafeHTML} from 'zena:http';
import {URL} from 'zena:url';

/** A chip: `text` in a pill, colored by `kind`, one of `app.css`'s `chip-*` classes. */
export function chip(text: String, kind: String = 'neutral'): HTMLPartial {
  return html`<span class="chip chip-${kind}">${text}</span>`;
}

/** `n` and `noun`, plural unless `n` is 1. */
export function count(n: i32, noun: String): String {
  return if (n == 1) `1 ${noun}` else `${n} ${noun}s`;
}

/** `render` of each of `items`, for a template. */
export function each<T>(items: Array<T>, render: (item: T) => TemplateValue): Array<TemplateValue> {
  let rendered = new GrowableArray<TemplateValue>();
  for (let item in items) {
    rendered.push(render(item));
  }
  return rendered;
}

/**
 * A link to `url`, someone's own address such as a package's homepage,
 * labelled `label`, when it is an `http:` or `https:` URL, and nothing
 * otherwise. Escaping keeps a value inside its attribute, but not a
 * `javascript:` URL from running on this host's origin when it is
 * followed. The page vouches for no such link (`rel`).
 */
export function externalLink(url: String | null, label: String): TemplateValue {
  if (url == null) {
    return null;
  }
  let parsed = URL.parse(url as String);
  if (parsed == null || (parsed.protocol != 'https:' && parsed.protocol != 'http:')) {
    return null;
  }
  return html`<a href="${parsed.href}" rel="nofollow ugc noopener">${label}</a>`;
}

/** `content` when `condition` holds, else nothing. */
export function when(condition: boolean, content: () => TemplateValue): TemplateValue {
  return if (condition) content() else null;
}

/**
 * Splices server-rendered `slots` into an Eleventy-built HTML `template`
 * at `<!--zena-slot-->name<!--zena-slot-->` markers. Even segments are
 * static build-time HTML (`unsafeHTML`), and odd segments name a slot in
 * `slots` (rendered via `zena:http`'s escaping `html` tag).
 */
export function renderSlots(template: String, slots: HashMap<String, TemplateValue>): HTMLPartial {
  let chunks = template.split('<!--zena-slot-->');
  let out = new GrowableArray<TemplateValue>();
  for (var i = 0; i < chunks.length; i += 1) {
    if (i % 2 == 0) {
      out.push(unsafeHTML(chunks[i]));
    } else if (let (true, value) = slots.get(chunks[i])) {
      out.push(value);
    }
  }
  return html`${out}`;
}
