/**
 * The shell every page of the web app shares, and the small pieces pages
 * build from. Pages are rendered on the server with `zena:http`'s `html`
 * tag, which escapes every value it is given; `packages/pds-web` builds the
 * stylesheet and the script they load from `/assets/`.
 */

import {GrowableArray} from 'zena:core';
import {HTMLPartial, TemplateValue, html, unsafeHTML} from 'zena:http';
import {WebCaller} from '../sessions.zena';
import {PageContext} from './session.zena';
import {Person} from './people.zena';

/**
 * Applies the theme the theme select saved before the page paints, as the
 * select itself would once its script loads: `rad-theme-dark` on `<html>`
 * for `dark`, or for `auto` when the system prefers dark.
 */
let THEME_SCRIPT = "try{let t=localStorage.getItem('themeName')??'auto';if(t==='dark'||(t==='auto'&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('rad-theme-dark')}catch{}";

/**
 * A whole page: `title`, the header, with the host's domain and who is
 * signed in, and `body`. The body's data attributes tell the page's
 * script the host's service DID, which service-auth tokens are addressed
 * to, and the DID signed in.
 */
export function page(title: String, context: PageContext, body: TemplateValue): HTMLPartial {
  let who = context.who;
  return html`<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${title}</title>
    <script>${unsafeHTML(THEME_SCRIPT)}</script>
    <link rel="stylesheet" href="/assets/app.css">
    <script type="module" src="/assets/app.js"></script>
  </head>
  <body data-service-did="${context.host.config.serviceDid}" data-did="${if (who != null) who.did else ''}">
    <header class="site">
      <a class="title" href="/">Zena packages</a>
      <span class="mono muted">${context.domain}</span>
      <span class="spacer"></span>
      ${if (who != null) signedIn(context, who, context.isAdmin) else signInButton()}
      <rad-theme-select></rad-theme-select>
    </header>
    <main>${body}</main>
  </body>
</html>
`;
}

/**
 * The header's links for `who`, signed in: the admin page, for the host's
 * admins; their packages; their name; and signing out.
 */
function signedIn(context: PageContext, who: WebCaller, admin: boolean): HTMLPartial {
  let person = context.person;
  return html`
    ${when(admin, () => html`<a href="/admin">Admin</a>`)}
    <a href="/me">Your packages</a>
    ${if (person != null) html`<a class="who" href="${person.path()}">${avatar(context, person)}
      <span class="mono muted">${who.name()}</span></a>` else html`<span class="mono muted">${who.name()}</span>`}
    <form class="sign-out" method="post" action="/signout">
      <button type="submit" class="quiet">Sign out</button>
    </form>`;
}

/**
 * The header's sign-in button, and the dialog it opens, which asks for a
 * handle and sends the browser to that person's PDS. The page's script
 * does both; without it, the button does nothing.
 */
function signInButton(): HTMLPartial {
  return html`
    <button type="button" data-sign-in>Sign in with Atmosphere</button>
    <dialog id="sign-in">
      <form method="dialog" class="sign-in">
        <h2>Sign in with Atmosphere</h2>
        <p>
          Sign in with your Atmosphere account: the one you use with Bluesky
          and other atproto apps. Your own PDS asks for your password; this
          site never sees it.
        </p>
        <label>
          Handle or DID
          <input name="identifier" placeholder="alice.bsky.social" required autocomplete="username">
        </label>
        <p class="error" hidden></p>
        <div class="actions">
          <button type="submit" value="sign-in">Sign in</button>
          <button type="button" class="quiet" data-close>Cancel</button>
        </div>
      </form>
    </dialog>`;
}

/**
 * `person`'s avatar, served through this host (`PageContext.avatarUrl`),
 * or the first letter of their name in its place.
 */
export function avatar(context: PageContext, person: Person, size: String = 'small'): HTMLPartial {
  let url = context.avatarUrl(person);
  if (url != null) {
    return html`<img class="avatar avatar-${size}" src="${url as String}" alt="" loading="lazy">`;
  }
  let name = person.name();
  let letter = if (name.startsWith('did:')) '?' else String.fromCodePoint(name.codePointAt(0)).asciiUpperCase();
  return html`<span class="avatar avatar-${size} avatar-none" aria-hidden="true">${letter}</span>`;
}

/** `person`, linked to their page: their avatar and name, and their handle beside a display name. */
export function personLink(context: PageContext, person: Person): HTMLPartial {
  let handle = person.handle;
  return html`<a class="person" href="${person.path()}">${avatar(context, person)}<span>${person.name()}</span></a>${
      when(person.displayName != null && handle != null, () => html` <span class="mono muted">${handle as String}</span>`)}`;
}

/** A chip: `text` in a pill, colored by `kind`, one of `app.css`'s `chip-*` classes. */
export function chip(text: String, kind: String = 'neutral'): HTMLPartial {
  return html`<span class="chip chip-${kind}">${text}</span>`;
}

/** `n` and `noun`, plural unless `n` is 1. */
export function count(n: i32, noun: String): String {
  return if (n == 1) `1 ${noun}` else `${n} ${noun}s`;
}

/** `render` of each of `items`, for a template. */
export function each<T>(items: Array<T>, render: (item: T) => TemplateValue): Array<TemplateValue> {
  let rendered = new GrowableArray<TemplateValue>();
  for (let item in items) {
    rendered.push(render(item));
  }
  return rendered;
}

/** `content` when `condition` holds, else nothing. */
export function when(condition: boolean, content: () => TemplateValue): TemplateValue {
  return if (condition) content() else null;
}
