/**
 * Who is signed in to the host's pages. A person signs in with atproto
 * OAuth in the browser, at their own PDS; the page then trades a
 * service-auth token from it for a web session
 * (`dev.zena-lang.host.createWebSession`), which this module keeps in an
 * HttpOnly cookie. The server never holds anything that can write to the
 * person's repository: the cookie stands for them only to this host's
 * pages.
 */

import {Request, Response} from 'zena:http';
import {milliseconds} from 'zena:time';
import {now} from 'wasi:clocks/system-clock';
import {Future} from 'zena:async';
import {PackageHost} from '../host.zena';
import {People, Person} from './people.zena';
import {WEB_SECONDS, WebCaller} from '../sessions.zena';

/** The cookie that holds a web session's token. */
export let SESSION_COOKIE = 'session';

/** What every page needs: the host, who is signed in, if anyone, and the people pages show. */
export final class PageContext {
  host: PackageHost;
  who: WebCaller | null;
  people: People;
  /** The person signed in, as `people` reads them, for the header. */
  var person: Person | null = null;

  new(this.host, this.who, this.people);

  /**
   * The URL of `person`'s avatar, served through this host and signed so
   * that it serves only avatars of people its pages show; null when their
   * profile has none.
   */
  avatarUrl(person: Person): String | null {
    let sessions = this.host.sessions;
    if (person.avatar == null || sessions == null) {
      return null;
    }
    return `/people/${person.did}/avatar?s=${sessions.urlSignature(person.did)}`;
  }

  /** Whether the person signed in is one of the host's admins (`PDS_ADMIN_DIDS`). */
  isAdmin: boolean {
    get {
      let who = this.who;
      return who != null && this.host.isHostAdmin(who.did);
    }
  }

  /** The domain the host's handles are under, for the header. */
  domain: String {
    get {
      return this.host.config.domain;
    }
  }
}

/** The context of a page `req` asks for, reading its session cookie. */
export async function contextOf(req: Request, host: PackageHost, people: People): Future<PageContext> {
  let sessions = host.sessions;
  let who = if (sessions == null) null else sessions.webCaller(req.cookie(SESSION_COOKIE), now().seconds);
  let context = new PageContext(host, who, people);
  if (who != null) {
    context.person = await people.person(who.did);
  }
  return context;
}

/**
 * Keeps the session `token` in its cookie: HttpOnly, so no script reads
 * it; SameSite=Lax, so another site's form cannot send it; and Secure
 * when the host is served over HTTPS.
 */
export function setSessionCookie(res: Response, host: PackageHost, token: String): void {
  res.setCookie(SESSION_COOKIE, token, {
    path: '/',
    httpOnly: true,
    secure: host.config.endpoint.startsWith('https:'),
    sameSite: 'Lax',
    maxAge: milliseconds(WEB_SECONDS * (1000 as i64)),
  });
}

/** Ends the web session: the browser drops its cookie. */
export function clearSessionCookie(res: Response): void {
  res.clearCookie(SESSION_COOKIE);
}
