/**
 * Every page of the web app, each in its own module under `pages/`, built
 * from the shell (`layout.zena`) and the shared pieces under `partials/`.
 * `pds:server` adds them all with `webPages`.
 */

import {Router} from 'zena:http';
import {PackageHost} from '../host.zena';
import {Approvals} from './approvals.zena';
import {People} from './people.zena';
import {adminPage} from './pages/admin.zena';
import {homePage} from './pages/home.zena';
import {mePage} from './pages/me.zena';
import {packagePage} from './pages/package.zena';
import {personPage} from './pages/person.zena';
import {scopePage} from './pages/scope.zena';
import {signInPages} from './pages/sign-in.zena';

/** Adds every page to `router`, reading people through `people`. */
export function webPages(router: Router, host: PackageHost, people: People): void {
  homePage(router, host, people);
  scopePage(router, host, people);
  packagePage(router, host, people, Approvals.forHost(host, people));
  personPage(router, host, people);
  mePage(router, host, people);
  signInPages(router, host, people);
  adminPage(router, host, people);
}
