/** `/me`: the scopes, teams and packages of the person signed in, each with their role. */

import {HTMLPartial, Router, html} from 'zena:http';
import {Membership, Memberships, PackageHost} from '../../host.zena';
import {page} from '../layout.zena';
import {People} from '../people.zena';
import {contextOf} from '../session.zena';
import {chip, each} from '../partials/common.zena';

/** Adds `/me` to `router`. */
export function mePage(router: Router, host: PackageHost, people: People): void {
  router.get('/me', async (req, res, next, params) => {
    let context = await contextOf(req, host, people);
    res.type = 'text/html; charset=utf-8';
    let who = context.who;
    if (who == null) {
      res.body = page('Your packages · Zena packages', context, html`
        <h1>Your packages</h1>
        <p>Sign in, with your atproto account, to see the scopes, teams and packages you have a part in here.</p>
      `);
      return;
    }
    let memberships = await host.getMemberships(who.did);
    res.body = page('Your packages · Zena packages', context, meBody(memberships));
  });
}

/** The scopes, teams and packages of the person signed in, each with their role. */
function meBody(memberships: Memberships): HTMLPartial {
  return html`
    <h1>Your packages</h1>
    <section>
      <h2>Scopes</h2>
      ${list(memberships.orgs, (org) => html`<a href="/scopes/${org.scope}">@${org.scope}</a>
        <span class="mono muted">${org.handle}</span>`,
          'You belong to no scope here. zena scope create makes one.')}
    </section>
    <section>
      <h2>Teams</h2>
      ${list(memberships.teams, (team) => html`<span class="mono">${team.scope}/${team.name}</span>`,
          'You are on no team here.')}
    </section>
    <section>
      <h2>Packages</h2>
      ${list(memberships.packages, (pkg) => html`<a href="/packages/${pkg.handle}">${pkg.name}</a>
        <span class="mono muted">${pkg.handle}</span>`,
          'You maintain no package here.')}
    </section>
  `;
}

/** `items` as a list, each with its role, or `empty` when there are none. */
function list(items: Array<Membership>, label: (item: Membership) => HTMLPartial, empty: String): HTMLPartial {
  if (items.length == 0) {
    return html`<p class="muted">${empty}</p>`;
  }
  return html`<ul class="plain">${each(items, (item) => html`
    <li>${label(item)} ${chip(item.role)}</li>`)}
  </ul>`;
}
