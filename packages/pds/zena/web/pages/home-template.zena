export let HOME_TEMPLATE = "<div class=\"home-page\">\n  <div class=\"hero hero-centered\">\n    <div class=\"container\">\n      <div class=\"main\">\n        <h1><span class=\"name clip\">Packages for Zena</span></h1>\n        <p class=\"title\">Find and share packages for the Zena programming language.</p>\n        <p class=\"tagline\">Explore community libraries, tools, and official packages — or publish your own with <code>zena publish</code>.</p>\n        <!--zena-slot-->search-form<!--zena-slot-->\n        <div class=\"actions\">\n          <div class=\"action\">\n            <a class=\"button brand\" href=\"/docs/getting-started/\">Get Started</a>\n          </div>\n          <div class=\"action\">\n            <a class=\"button alt\" href=\"/docs/\">Documentation</a>\n          </div>\n          <div class=\"action\">\n            <a class=\"button alt\" href=\"/docs/publishing/\">Publish a Package</a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"features\">\n    <div class=\"container\">\n      <div class=\"items\">\n        <div class=\"item grid-3\">\n          <a class=\"feature link\" href=\"/docs/getting-started/\">\n            <article class=\"box\">\n              <div class=\"header\">\n                <div class=\"icon\">🚀</div>\n                <h2 class=\"title\">Getting Started</h2>\n              </div>\n              <p class=\"details\">Add dependencies with <code>zena add</code>, pin versions reproducibly in <code>zena-lock.json</code>, and import libraries by local alias.</p>\n              <div class=\"link-text\">\n                <p class=\"link-text-value\">Quickstart guide <span class=\"icon-arrow-right link-text-icon\"></span></p>\n              </div>\n            </article>\n          </a>\n        </div>\n        <div class=\"item grid-3\">\n          <a class=\"feature link\" href=\"/docs/approvals-and-settings/\">\n            <article class=\"box\">\n              <div class=\"header\">\n                <div class=\"icon\">🛡️</div>\n                <h2 class=\"title\">Security &amp; Labelers</h2>\n              </div>\n              <p class=\"details\">Protect releases with M-of-N maintainer approvals, signed Merkle proofs, and independent security labelers that flag vulnerabilities.</p>\n              <div class=\"link-text\">\n                <p class=\"link-text-value\">Security &amp; policies <span class=\"icon-arrow-right link-text-icon\"></span></p>\n              </div>\n            </article>\n          </a>\n        </div>\n        <div class=\"item grid-3\">\n          <a class=\"feature link\" href=\"/docs/publishing/\">\n            <article class=\"box\">\n              <div class=\"header\">\n                <div class=\"icon\">🔓</div>\n                <h2 class=\"title\">No Registry Lock-In</h2>\n              </div>\n              <p class=\"details\">Decentralized by design with no single gatekeeper or namespace monopoly. Move hosts anytime without breaking existing dependents.</p>\n              <div class=\"link-text\">\n                <p class=\"link-text-value\">Publishing workflow <span class=\"icon-arrow-right link-text-icon\"></span></p>\n              </div>\n            </article>\n          </a>\n        </div>\n        <div class=\"item grid-3\">\n          <a class=\"feature link\" href=\"/docs/orgs-and-teams/\">\n            <article class=\"box\">\n              <div class=\"header\">\n                <div class=\"icon\">👥</div>\n                <h2 class=\"title\">Scopes, Orgs &amp; Teams</h2>\n              </div>\n              <p class=\"details\">Organize packages under <code>@scope</code> namespaces and manage team roles with commitments that keep memberships private until members act.</p>\n              <div class=\"link-text\">\n                <p class=\"link-text-value\">Orgs &amp; teams <span class=\"icon-arrow-right link-text-icon\"></span></p>\n              </div>\n            </article>\n          </a>\n        </div>\n        <div class=\"item grid-3\">\n          <a class=\"feature link\" href=\"/docs/manifests/\">\n            <article class=\"box\">\n              <div class=\"header\">\n                <div class=\"icon\">📋</div>\n                <h2 class=\"title\">Manifests &amp; Workspaces</h2>\n              </div>\n              <p class=\"details\">Configure <code>zena-package.json</code>, library <code>exports</code>, conditional targets, minimal version selection, and multi-package workspaces.</p>\n              <div class=\"link-text\">\n                <p class=\"link-text-value\">Manifest reference <span class=\"icon-arrow-right link-text-icon\"></span></p>\n              </div>\n            </article>\n          </a>\n        </div>\n        <div class=\"item grid-3\">\n          <a class=\"feature link\" href=\"/docs/architecture/\">\n            <article class=\"box\">\n              <div class=\"header\">\n                <div class=\"icon\">🌐</div>\n                <h2 class=\"title\">Built on AT Protocol</h2>\n              </div>\n              <p class=\"details\">Curious how it works under the hood? Every package and scope is an Atmosphere account with a DID, signed repository, and CAR archives.</p>\n              <div class=\"link-text\">\n                <p class=\"link-text-value\">AT Protocol architecture <span class=\"icon-arrow-right link-text-icon\"></span></p>\n              </div>\n            </article>\n          </a>\n        </div>\n      </div>\n    </div>\n  </div>\n  <!--zena-slot-->featured-packages<!--zena-slot-->\n</div>\n";
