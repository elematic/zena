/**
 * A package's page: its profile and scope, the command that adds it, its
 * versions with their dependencies, approvers and retractions, and its
 * maintainers.
 */

import {HashMap} from 'zena:collections';
import {GrowableArray} from 'zena:core';
import {HTMLPartial, Router, TemplateValue, html} from 'zena:http';
import {percentDecode} from 'zena:url';
import {Dependency, Maintainer, Maintainers, RELEASE_TYPE, Release} from 'package-manager:records';
import {PackageDetail, PackageHost} from '../../host.zena';
import {Approvals} from '../approvals.zena';
import {page} from '../layout.zena';
import {People} from '../people.zena';
import {contextOf} from '../session.zena';
import {chip, count, each, when} from '../partials/common.zena';
import {Shown, describe, shownWith, visibleEntries} from '../partials/members.zena';
import {personLink} from '../partials/person.zena';
import {notFound} from './not-found.zena';

/** How many of a package's newest releases its page shows the approvers of. */
let APPROVALS_SHOWN = 10;

/** Adds the package page, `/packages/<handle>`, to `router`. */
export function packagePage(router: Router, host: PackageHost, people: People, approvals: Approvals): void {
  router.get('/packages/:handle', async (req, res, next, params) => {
    let context = await contextOf(req, host, people);
    let handle = percentDecode(params['handle'] ?? '');
    let detail = await host.getPackage(handle);
    if (detail == null) {
      notFound(res, context, `No package here has the handle ${handle}.`);
      return;
    }
    let found = detail as PackageDetail;
    // The handles of the dependencies this host holds, to link to them.
    let handles = new HashMap<String, String>();
    for (let release in found.releases) {
      for (let dependency in release.dependencies) {
        let account = await host.pds.storage.getAccount(dependency.did);
        if (account != null && account.handle != null) {
          handles[dependency.did] = account.handle as String;
        }
      }
    }
    res.type = 'text/html; charset=utf-8';
    let profile = found.profile;
    let name = if (profile != null) profile.name else found.handle;
    let entries = await visibleEntries(context, found.did, null);
    let named = new GrowableArray<String>();
    let record = found.maintainers;
    if (record != null) {
      for (let maintainer in record.maintainers) {
        if (maintainer.did != null) {
          named.push(maintainer.did as String);
        }
      }
    }
    // Who approved the newest releases: each attester's repository is
    // asked once per release, so the oldest are left out.
    let attesters = await host.attesters(found.did);
    let approvedBy = new HashMap<String, Array<String>>();
    var checked = 0;
    for (let release in found.releases) {
      let version = release.version.toString();
      if (checked < APPROVALS_SHOWN) {
        if (let (true, cid) = found.releaseCids.get(version)) {
          let approvers = await approvals.of(`at://${found.did}/${RELEASE_TYPE}/${version}`, cid, attesters);
          approvedBy[version] = approvers;
          for (let did in approvers) {
            named.push(did);
          }
        }
      }
      checked += 1;
    }
    let shown = await shownWith(context, entries, named);
    if (record != null) {
      for (let maintainer in record.maintainers) {
        let org = maintainer.org;
        if (org != null) {
          let account = await host.pds.storage.getAccount(org as String);
          if (account != null && account.handle != null) {
            shown.scopes[org as String] = (account.handle as String).split('.')[0];
          }
        }
      }
    }
    res.body = page(`${name} · Zena packages`, context, packageBody(found, handles, shown, approvedBy));
  });
}

/** A package's page: its profile, the command that adds it, its versions and its maintainers. */
function packageBody(detail: PackageDetail, handles: HashMap<String, String>, shown: Shown,
    approvedBy: HashMap<String, Array<String>>): HTMLPartial {
  let profile = detail.profile;
  var name = detail.handle;
  var description: String | null = null;
  var license: String | null = null;
  var homepage: String | null = null;
  var source: String | null = null;
  if (profile != null) {
    name = profile.name;
    description = profile.description;
    license = profile.license;
    homepage = profile.homepage;
    source = profile.source;
  }
  var latest: String | null = null;
  for (let release in detail.releases) {
    if (latest == null && !detail.retractions.has(release.version.toString())) {
      latest = release.version.toString();
    }
  }
  return html`
    <div>
      <h1 class="with-chips">
        ${name}
        ${when(latest != null, () => chip(latest as String, 'primary'))}
        ${when(license != null, () => chip(license as String, 'success'))}
      </h1>
      ${when(description != null, () => html`<p>${description as String}</p>`)}
      <div class="meta mono muted">
        <span>in <a href="/scopes/${detail.scope}">@${detail.scope}</a></span>
        <span>${detail.handle}</span>
        <span>${detail.did}</span>
        ${when(homepage != null, () => html`<a href="${homepage as String}">Homepage</a>`)}
        ${when(source != null, () => html`<a href="${source as String}">Source</a>`)}
      </div>
    </div>
    <pre class="mono">zena add ${detail.handle}</pre>
    <section>
      <h2>Versions</h2>
      ${if (detail.releases.length == 0) html`<p class="muted">Nothing is published yet.</p>` else versions(detail, handles, shown, approvedBy)}
    </section>
    <section>
      <h2>Maintainers</h2>
      ${if (detail.maintainers == null) html`<p class="muted">No maintainers record.</p>`
          else maintainers(detail.maintainers as Maintainers, shown)}
    </section>
  `;
}

/**
 * Who approved release `version`: its approvers, or a dash when none of
 * the maintainers' repositories holds an attestation of it, or it is too
 * old to have been looked for.
 */
function approvers(version: String, shown: Shown, approvedBy: HashMap<String, Array<String>>): TemplateValue {
  if (let (true, dids) = approvedBy.get(version)) {
    if (dids.length > 0) {
      return html`<ul class="plain">${each(dids, (did) => html`<li>${personLink(shown.context, shown.person(did))}</li>`)}</ul>`;
    }
  }
  return html`<span class="muted">—</span>`;
}

function versions(detail: PackageDetail, handles: HashMap<String, String>, shown: Shown,
    approvedBy: HashMap<String, Array<String>>): HTMLPartial {
  return html`
    <table>
      <thead><tr><th>Version</th><th>Published</th><th>Dependencies</th><th>Approved by</th></tr></thead>
      <tbody>${each(detail.releases, (release) => {
        let version = release.version.toString();
        var retracted = false;
        var reason: String | null = null;
        if (let (true, retraction) = detail.retractions.get(version)) {
          retracted = true;
          reason = retraction.reason;
        }
        return html`
        <tr class="${if (retracted) 'retracted' else ''}">
          <td>
            <span class="version mono">${version}</span>
            ${when(retracted, () => chip('retracted', 'danger'))}
            ${when(reason != null, () => html`<div class="muted">${reason as String}</div>`)}
          </td>
          <td class="muted">${release.createdAt.sliceBytes(0, 10)}</td>
          <td>${dependencies(release, handles)}</td>
          <td>${approvers(version, shown, approvedBy)}</td>
        </tr>`;
      })}
      </tbody>
    </table>
  `;
}

function dependencies(release: Release, handles: HashMap<String, String>): TemplateValue {
  if (release.dependencies.length == 0) {
    return html`<span class="muted">none</span>`;
  }
  return html`<ul class="plain">${each(release.dependencies, (dependency: Dependency) => {
    // A package hosted here is named by its handle and linked; another by its DID.
    var target = html`<span class="mono">${dependency.name}</span> <span class="mono muted">${dependency.did}</span>`;
    if (let (true, handle) = handles.get(dependency.did)) {
      target = html`<a class="mono" href="/packages/${handle}">${dependency.name}</a>
        <span class="mono muted">${handle}</span>`;
    }
    return html`<li>${target} <span class="mono" title="${rangeTitle(dependency)}">${range(dependency)}</span></li>`;
  })}</ul>`;
}

/**
 * The versions a dependency accepts: its version or any later one of the
 * same major version, the one version selection picks from
 * (package-manager.md, "Version selection").
 */
function range(dependency: Dependency): String {
  return `≥ ${dependency.version.toString()} (${dependency.version.major}.x)`;
}

function rangeTitle(dependency: Dependency): String {
  return `${dependency.version.toString()} or any later ${dependency.version.major}.x release`;
}

function maintainers(record: Maintainers, shown: Shown): HTMLPartial {
  return html`
    <ul class="plain">${each(record.maintainers, (maintainer: Maintainer) => html`
      <li>${describe(maintainer, shown)} ${chip(maintainer.role)}</li>`)}
    </ul>
    <p class="muted">
      A release counts once ${count(record.threshold as i32, 'maintainer')}
      ${if (record.threshold == 1 as i64) 'approves' else 'approve'} it, and a change of maintainers once
      ${count(record.ownerThreshold as i32, 'owner')} ${if (record.ownerThreshold == 1 as i64) 'does' else 'do'}.
    </p>
  `;
}
