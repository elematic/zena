/**
 * The home page: centered hero with package search, feature & architecture
 * cards, and featured packages (or search results when `?q=` is present).
 */

import {Router, html} from 'zena:http';
import {GrowableArray} from 'zena:core';
import {PackageHost, PackageSummary} from '../../host.zena';
import {page} from '../layout.zena';
import {People} from '../people.zena';
import {contextOf} from '../session.zena';
import {count} from '../partials/common.zena';
import {packageList} from '../partials/packages.zena';

/** Adds the home page, `/`, to `router`. */
export function homePage(router: Router, host: PackageHost, people: People): void {
  router.get('/', async (req, res, next, params) => {
    let context = await contextOf(req, host, people);
    let query = (req.url.searchParams().get('q') ?? '').trim();
    res.type = 'text/html; charset=utf-8';

    if (query != '') {
      let packages = await host.listPackages(null);
      let shown = filtered(packages, query);
      res.body = page('Search · Zena packages', context, html`
        <div class="home-page">
          <div class="hero hero-centered">
            <div class="container">
              <div class="main">
                <h1><span class="name clip">Packages for Zena</span></h1>
                <form class="search hero-search" action="/" method="get">
                  <input type="search" name="q" value="${query}" placeholder="Search packages by name, handle, or description…"
                      aria-label="Search packages">
                  <button type="submit">Search</button>
                </form>
              </div>
            </div>
          </div>
          <div class="home-section">
            <div class="container">
              <h2>Search results</h2>
              <p class="muted">${count(shown.length, 'package')} matching “${query}”.</p>
              ${packageList(shown, 'No packages match.')}
            </div>
          </div>
        </div>
      `);
      return;
    }

    res.body = page('Zena packages', context, html`
      <div class="home-page">
        <div class="hero hero-centered">
          <div class="container">
            <div class="main">
              <h1><span class="name clip">Packages for Zena</span></h1>
              <p class="title">Find, verify, and ship libraries for WebAssembly GC.</p>
              <p class="tagline">
                Cryptographically signed releases, M-of-N maintainer approvals, and independent
                security labelers — in a decentralized package ecosystem with no registry lock-in.
              </p>
              <form class="search hero-search" action="/" method="get">
                <input type="search" name="q" value="" placeholder="Search packages by name, @scope, or description…"
                    aria-label="Search packages">
                <button type="submit">Search</button>
              </form>
              <div class="actions">
                <div class="action">
                  <a class="button brand" href="/docs/getting-started/">Get Started</a>
                </div>
                <div class="action">
                  <a class="button alt" href="/docs/">Documentation</a>
                </div>
                <div class="action">
                  <a class="button alt" href="/docs/publishing/">Publish a Package</a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="features">
          <div class="container">
            <div class="items">
              <div class="item grid-3">
                <a class="feature link" href="/docs/getting-started/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">🚀</div>
                      <h2 class="title">Getting Started</h2>
                    </div>
                    <p class="details">Add dependencies with <code>zena add</code>, pin versions reproducibly in <code>zena-lock.json</code>, and import libraries by local alias.</p>
                    <div class="link-text">
                      <p class="link-text-value">Quickstart guide <span class="icon-arrow-right link-text-icon"></span></p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/approvals-and-settings/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">🛡️</div>
                      <h2 class="title">Security &amp; Labelers</h2>
                    </div>
                    <p class="details">Protect releases with M-of-N maintainer approvals, signed Merkle proofs, and independent security labelers that flag vulnerabilities.</p>
                    <div class="link-text">
                      <p class="link-text-value">Security &amp; policies <span class="icon-arrow-right link-text-icon"></span></p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/publishing/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">🔓</div>
                      <h2 class="title">No Registry Lock-In</h2>
                    </div>
                    <p class="details">Decentralized by design with no single gatekeeper or namespace monopoly. Move hosts anytime without breaking existing dependents.</p>
                    <div class="link-text">
                      <p class="link-text-value">Publishing workflow <span class="icon-arrow-right link-text-icon"></span></p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/orgs-and-teams/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">👥</div>
                      <h2 class="title">Scopes, Orgs &amp; Teams</h2>
                    </div>
                    <p class="details">Organize packages under <code>@scope</code> namespaces and manage team roles with commitments that keep memberships private until members act.</p>
                    <div class="link-text">
                      <p class="link-text-value">Orgs &amp; teams <span class="icon-arrow-right link-text-icon"></span></p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/manifests/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">📋</div>
                      <h2 class="title">Manifests &amp; Workspaces</h2>
                    </div>
                    <p class="details">Configure <code>zena-package.json</code>, library <code>exports</code>, conditional targets, minimal version selection, and multi-package workspaces.</p>
                    <div class="link-text">
                      <p class="link-text-value">Manifest reference <span class="icon-arrow-right link-text-icon"></span></p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/architecture/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">🌐</div>
                      <h2 class="title">Built on AT Protocol</h2>
                    </div>
                    <p class="details">Curious how it works under the hood? Every package and scope is an Atmosphere account with a DID, signed repository, and CAR archives.</p>
                    <div class="link-text">
                      <p class="link-text-value">AT Protocol architecture <span class="icon-arrow-right link-text-icon"></span></p>
                    </div>
                  </article>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="features featured-packages">
          <div class="container">
            <div class="featured-header">
              <h2>Featured Packages</h2>
              <p class="muted">Popular libraries and foundational packages for Zena applications.</p>
            </div>
            <div class="items">
              <div class="item grid-3">
                <a class="feature link" href="/docs/getting-started/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">🌐</div>
                      <h3 class="title mono">@zena/http</h3>
                      <span class="chip chip-primary">0.4.2</span>
                    </div>
                    <p class="details">HTTP client, router, and streaming HTML templates for WASI HTTP components and servers.</p>
                    <div class="link-text">
                      <p class="link-text-value mono">zena add @zena/http</p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/getting-started/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">📄</div>
                      <h3 class="title mono">@zena/json</h3>
                      <span class="chip chip-primary">0.3.1</span>
                    </div>
                    <p class="details">Fast JSON parser, schema validator, and typed serializer for WebAssembly GC records and classes.</p>
                    <div class="link-text">
                      <p class="link-text-value mono">zena add @zena/json</p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/getting-started/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">🗄️</div>
                      <h3 class="title mono">@zena/sqlite</h3>
                      <span class="chip chip-primary">0.2.0</span>
                    </div>
                    <p class="details">Embedded SQLite bindings, typed query builder, and schema migrations with prepared statement caching.</p>
                    <div class="link-text">
                      <p class="link-text-value mono">zena add @zena/sqlite</p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/getting-started/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">🔐</div>
                      <h3 class="title mono">@zena/crypto</h3>
                      <span class="chip chip-primary">0.5.0</span>
                    </div>
                    <p class="details">SHA-256, Ed25519, secp256k1 signatures, and content-addressed CIDs for verifiable data structures.</p>
                    <div class="link-text">
                      <p class="link-text-value mono">zena add @zena/crypto</p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/getting-started/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">⌨️</div>
                      <h3 class="title mono">@zena/cli</h3>
                      <span class="chip chip-primary">0.3.0</span>
                    </div>
                    <p class="details">Command-line flag parsing, subcommand dispatch, ANSI terminal styling, and interactive prompts.</p>
                    <div class="link-text">
                      <p class="link-text-value mono">zena add @zena/cli</p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/getting-started/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">⏱️</div>
                      <h3 class="title mono">@zena/bench</h3>
                      <span class="chip chip-primary">0.1.4</span>
                    </div>
                    <p class="details">Microbenchmarking harness and statistical regression runner for performance-critical Zena libraries.</p>
                    <div class="link-text">
                      <p class="link-text-value mono">zena add @zena/bench</p>
                    </div>
                  </article>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    `);
  });
}

/** The packages whose name, handle or description has `query` in it, ignoring case; all for an empty query. */
function filtered(packages: Array<PackageSummary>, query: String): Array<PackageSummary> {
  if (query == '') {
    return packages;
  }
  let needle = query.asciiLowerCase();
  let shown = new GrowableArray<PackageSummary>();
  for (let pkg in packages) {
    let description = pkg.description ?? '';
    if (pkg.name.asciiLowerCase().contains(needle) || pkg.handle.asciiLowerCase().contains(needle) ||
        description.asciiLowerCase().contains(needle)) {
      shown.push(pkg);
    }
  }
  return shown;
}
