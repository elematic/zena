/** The home page: hero, documentation feature cards, every package on the host, and every scope. */

import {Router, html} from 'zena:http';
import {GrowableArray} from 'zena:core';
import {PackageHost, PackageSummary} from '../../host.zena';
import {page} from '../layout.zena';
import {People} from '../people.zena';
import {contextOf} from '../session.zena';
import {count, when} from '../partials/common.zena';
import {packageList, scopeList} from '../partials/packages.zena';

/** Adds the home page, `/`, to `router`. */
export function homePage(router: Router, host: PackageHost, people: People): void {
  router.get('/', async (req, res, next, params) => {
    let context = await contextOf(req, host, people);
    let query = (req.url.searchParams().get('q') ?? '').trim();
    let packages = await host.listPackages(null);
    let shown = filtered(packages, query);
    let scopes = await host.listScopes();
    res.type = 'text/html; charset=utf-8';
    res.body = page('Zena packages', context, html`
      <div class="home-page">
        <div class="hero">
          <div class="container">
            <div class="hero-grid">
              <div class="main">
                <h1><span class="name clip">Packages for Zena</span></h1>
                <p class="title">Decentralized packages on the AT Protocol.</p>
                <p class="tagline">
                  Discover, publish, and verify WebAssembly GC packages identified by DID,
                  backed by signed Merkle repositories and maintainer attestations.
                </p>
                <form class="search hero-search" action="/" method="get">
                  <input type="search" name="q" value="${query}" placeholder="Search packages by name, handle, or description…"
                      aria-label="Search packages">
                  <button type="submit">Search</button>
                </form>
                <div class="actions">
                  <div class="action">
                    <a class="button brand" href="/docs/getting-started/">Get Started</a>
                  </div>
                  <div class="action">
                    <a class="button alt" href="/docs/">Documentation</a>
                  </div>
                  <div class="action">
                    <a class="button alt" href="/docs/publishing/">Publish a Package</a>
                  </div>
                </div>
              </div>
              <div class="hero-code prose">
                <zena-code-group class="code-group">
                  <div class="tabs" role="tablist">
                    <button type="button" class="tab active" role="tab" aria-selected="true" tabindex="0">Install</button>
                    <button type="button" class="tab" role="tab" aria-selected="false" tabindex="-1">Publish</button>
                    <button type="button" class="tab" role="tab" aria-selected="false" tabindex="-1">Approve</button>
                  </div>
                  <div class="blocks">
                    <div class="language-sh active" role="tabpanel">
                      <button type="button" title="Copy Code" class="copy"></button>
                      <span class="lang">sh</span>
                      <pre class="shiki"><code><span class="line"># Add a dependency by @scope/name, handle, or DID</span>
<span class="line">zena add @acme/router</span>
<span class="line"></span>
<span class="line"># Verify and fetch pinned archives from zena-lock.json</span>
<span class="line">zena fetch --frozen</span></code></pre>
                    </div>
                    <div class="language-sh" role="tabpanel" hidden>
                      <button type="button" title="Copy Code" class="copy"></button>
                      <span class="lang">sh</span>
                      <pre class="shiki"><code><span class="line"># Sign in with your Atmosphere (atproto) account</span>
<span class="line">zena login alice.bsky.social</span>
<span class="line"></span>
<span class="line"># Create an organization scope and publish a release</span>
<span class="line">zena scope create acme</span>
<span class="line">zena publish --scope acme</span></code></pre>
                    </div>
                    <div class="language-sh" role="tabpanel" hidden>
                      <button type="button" title="Copy Code" class="copy"></button>
                      <span class="lang">sh</span>
                      <pre class="shiki"><code><span class="line"># Require 2-of-N maintainer attestations for releases</span>
<span class="line">zena maintainers threshold @acme/router --releases 2</span>
<span class="line"></span>
<span class="line"># Inspect and co-sign a pending release from your repo</span>
<span class="line">zena pending @acme/router</span>
<span class="line">zena approve @acme/router@1.4.2</span></code></pre>
                    </div>
                  </div>
                </zena-code-group>
              </div>
            </div>
          </div>
        </div>

        ${when(query == '', () => html`
        <div class="features">
          <div class="container">
            <div class="items">
              <div class="item grid-3">
                <a class="feature link" href="/docs/getting-started/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">🚀</div>
                      <h2 class="title">Getting Started</h2>
                    </div>
                    <p class="details">Add dependencies with <code>zena add</code>, pin versions in <code>zena-lock.json</code>, and import libraries by local alias.</p>
                    <div class="link-text">
                      <p class="link-text-value">Quickstart guide <span class="icon-arrow-right link-text-icon"></span></p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/publishing/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">📦</div>
                      <h2 class="title">Publishing Packages</h2>
                    </div>
                    <p class="details">Sign in with your Atmosphere account, create a scope, and publish verified source archives without shared package passwords.</p>
                    <div class="link-text">
                      <p class="link-text-value">Publishing workflow <span class="icon-arrow-right link-text-icon"></span></p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/manifests/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">📋</div>
                      <h2 class="title">Manifests &amp; Workspaces</h2>
                    </div>
                    <p class="details">Configure <code>zena-package.json</code>, library <code>exports</code>, conditional targets, and multi-package workspaces.</p>
                    <div class="link-text">
                      <p class="link-text-value">Manifest reference <span class="icon-arrow-right link-text-icon"></span></p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/orgs-and-teams/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">👥</div>
                      <h2 class="title">Scopes, Orgs &amp; Teams</h2>
                    </div>
                    <p class="details">Manage organization members and teams with salted cryptographic commitments that keep memberships private until members act.</p>
                    <div class="link-text">
                      <p class="link-text-value">Orgs &amp; teams <span class="icon-arrow-right link-text-icon"></span></p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/approvals-and-settings/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">🔐</div>
                      <h2 class="title">Approvals &amp; Security</h2>
                    </div>
                    <p class="details">Require M-of-N maintainer attestations, enforce scope-wide policies, retract broken releases, and manage CI accounts.</p>
                    <div class="link-text">
                      <p class="link-text-value">Security &amp; policies <span class="icon-arrow-right link-text-icon"></span></p>
                    </div>
                  </article>
                </a>
              </div>
              <div class="item grid-3">
                <a class="feature link" href="/docs/architecture/">
                  <article class="box">
                    <div class="header">
                      <div class="icon">🌐</div>
                      <h2 class="title">AT Protocol Architecture</h2>
                    </div>
                    <p class="details">Every package is a DID with a signed Merkle repository, content-addressed CAR archives, and minimal version selection.</p>
                    <div class="link-text">
                      <p class="link-text-value">Architecture deep dive <span class="icon-arrow-right link-text-icon"></span></p>
                    </div>
                  </article>
                </a>
              </div>
            </div>
          </div>
        </div>`)}

        <div class="home-section">
          <div class="container">
            <div class="columns">
              <section>
                <h2>${if (query == '') 'Packages' else 'Search results'}</h2>
                ${when(query != '', () => html`<p class="muted">${count(shown.length, 'package')} matching “${query}”.</p>`)}
                ${packageList(shown, if (query == '') 'Nothing is published here yet.' else 'No packages match.')}
              </section>
              <aside>
                <div>
                  <h2>Scopes</h2>
                  ${scopeList(scopes)}
                </div>
                <div class="aside-card">
                  <h3>CLI Reference</h3>
                  <p class="muted">Manage dependencies, scopes, teams, and releases from the command line:</p>
                  <pre class="mono">zena add @scope/pkg
zena publish --scope acme
zena approve @scope/pkg@1.0.0</pre>
                  <p><a href="/docs/cli/">All CLI commands →</a></p>
                </div>
              </aside>
            </div>
          </div>
        </div>
      </div>
    `);
  });
}

/** The packages whose name, handle or description has `query` in it, ignoring case; all for an empty query. */
function filtered(packages: Array<PackageSummary>, query: String): Array<PackageSummary> {
  if (query == '') {
    return packages;
  }
  let needle = query.asciiLowerCase();
  let shown = new GrowableArray<PackageSummary>();
  for (let pkg in packages) {
    let description = pkg.description ?? '';
    if (pkg.name.asciiLowerCase().contains(needle) || pkg.handle.asciiLowerCase().contains(needle) ||
        description.asciiLowerCase().contains(needle)) {
      shown.push(pkg);
    }
  }
  return shown;
}
