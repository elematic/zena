/**
 * Starts the PDS alone, padstone, as the environment configures it (see
 * `pds/service`). With no configuration it is a PDS on port 2583, the
 * reference PDS's port, with its data in memory and no App Views to keep
 * managed accounts for. The App View, which can run one in the same
 * process, starts from `packages/registry/zena/main.zena`.
 */

import {Future} from 'zena:async';
import {exit, getEnv} from 'zena:cli';
import {ConfigError, PdsConfig, configFromEnv, serve} from './service.zena';

/** The configuration the environment gives, or null, having said why. */
function readConfig(): PdsConfig | null {
  try {
    return configFromEnv((name) => getEnv(name));
  } catch (e) {
    if (e is ConfigError) {
      console.error(e.message);
      return null;
    }
    throw e;
  }
}

export async function main(): Future<void> {
  let config = readConfig();
  if (config == null) {
    exit(2);
    return;
  }
  let running = await serve(config);
  console.log(`PDS ${running.service.did} listening on ${running.listening.origin}`);
  await running.listening.server.done;
}
