/**
 * Starts the PDS on `PORT` (default 2583, the reference PDS's port).
 */

import { getEnv } from 'zena:cli';
import { createApp } from './server.zena';

function resolvePort(): u16 {
  let envPort = getEnv('PORT');
  if (envPort != null) {
    if (let (true, p) = parseI32(envPort)) {
      return p as u16;
    }
  }
  return 2583 as u16;
}

export async function main() {
  let server = await createApp().listen(resolvePort());
  console.log(`PDS listening on http://localhost:${server.port}`);
}
