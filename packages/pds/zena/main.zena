/**
 * Starts the PDS, and the package host when `PDS_HOST_DOMAIN` is set, as
 * the environment configures them (see `pds:service`). With no
 * configuration it is a PDS on port 2583, the reference PDS's port, with
 * its data in memory.
 *
 * With the argument `sync-handles`, it writes the DNS record of every
 * handle the host has given out instead, from its store, and exits: for
 * after records were lost, or a write of one failed.
 *
 * Two commands are for the operator's offline rotation key, on the
 * operator's own machine, and read no configuration but
 * `PDS_PLC_DIRECTORY`:
 *
 * - `generate-key` prints a new secp256k1 private key in hex and its
 *   `did:key`, for `PDS_OFFLINE_ROTATION_KEY`. Keep the private key
 *   offline.
 * - `plc-restore <did> <cid> [--yes]` undoes every operation of `<did>`
 *   after the one whose CID is `<cid>`, as after the online key was
 *   stolen: it reads the offline private key from stdin, prints the
 *   operation it would send, and sends it to the PLC directory with
 *   `--yes`. The directory takes it within 72 hours of the first
 *   operation it undoes.
 *
 * With `create-scope <name> --owner <did> [--recovery-key <did:key>]...`,
 * it creates a scope owned by `<did>` alone, as the host's operator, and
 * exits. Unlike `zena scope create`, it may take a name the host reserves
 * (package-manager.md, "Scopes").
 */

import {Future} from 'zena:async';
import {exit, getArguments, getEnv, readStdin} from 'zena:cli';
import {hex} from 'zena:encoding';
import {fetch} from 'zena:fetch';
import {JsonArray, parseJson, stringify} from 'zena:json';
import {randomBytes} from 'zena:random';
import {KeyType, formatDidKey} from 'atproto:didkey';
import {PlcError, PlcOperation, submitPlcOperation, undoOperation} from 'atproto:plc';
import {SigningKey} from './storage.zena';
import {HostError} from './host.zena';
import {nowMicros} from './server.zena';
import {ConfigError, ServiceConfig, buildService, configFromEnv, serve} from './service.zena';

/** The configuration the environment gives, or null, having said why. */
function readConfig(): ServiceConfig | null {
  try {
    return configFromEnv((name) => getEnv(name));
  } catch (e) {
    if (e is ConfigError) {
      console.error(e.message);
      return null;
    }
    throw e;
  }
}

export async function main(): Future<void> {
  if (hasArgument('generate-key')) {
    generateKey();
    return;
  }
  if (hasArgument('plc-restore')) {
    await plcRestore();
    return;
  }
  let config = readConfig();
  if (config == null) {
    exit(2);
    return;
  }
  if (hasArgument('sync-handles')) {
    await syncHandles(config as ServiceConfig);
    return;
  }
  if (hasArgument('create-scope')) {
    await createScope(config as ServiceConfig);
    return;
  }
  let running = await serve(config as ServiceConfig);
  let host = running.service.host;
  if (host != null) {
    console.log(`PDS and package host for ${host.config.domain} listening on ${running.origin}`);
  } else {
    console.log(`PDS listening on ${running.origin}`);
  }
  await running.server.done;
}

/**
 * Whether the command line, after the program, holds `name`. `zena run`
 * passes on the `--` before a program's arguments, and a module run by
 * itself has none, so the position varies.
 */
function hasArgument(name: String): boolean {
  let args = getArguments();
  for (var i = 1; i < args.length; i += 1) {
    if (args[i] == name) {
      return true;
    }
  }
  return false;
}

/** The arguments after `name`, or null when the command line has no `name`. */
function argumentsAfter(name: String): Array<String> | null {
  let args = getArguments();
  for (var i = 1; i < args.length; i += 1) {
    if (args[i] == name) {
      let rest = new GrowableArray<String>();
      for (var j = i + 1; j < args.length; j += 1) {
        rest.push(args[j]);
      }
      return rest;
    }
  }
  return null;
}

/** Creates the scope `create-scope` names, as the operator, and exits. */
async function createScope(config: ServiceConfig): Future<void> {
  let usage = 'usage: create-scope <name> --owner <did> [--recovery-key <did:key>]...';
  let args = argumentsAfter('create-scope') as Array<String>;
  var name: String | null = null;
  var owner: String | null = null;
  let recoveryKeys = new GrowableArray<String>();
  var i = 0;
  while (i < args.length) {
    let arg = args[i];
    if ((arg == '--owner' || arg == '--recovery-key') && i + 1 < args.length) {
      if (arg == '--owner') {
        owner = args[i + 1];
      } else {
        recoveryKeys.push(args[i + 1]);
      }
      i += 2;
    } else if (name == null && !arg.startsWith('-')) {
      name = arg;
      i += 1;
    } else {
      console.error(usage);
      exit(2);
      return;
    }
  }
  if (name == null || owner == null || !(owner as String).startsWith('did:')) {
    console.error(usage);
    exit(2);
    return;
  }
  let service = await buildService(config, '');
  let host = service.host;
  if (host == null) {
    console.error('create-scope needs a package host: set PDS_HOST_DOMAIN');
    exit(2);
    return;
  }
  try {
    let created = await host.createScopeAsOperator(owner as String, name as String, recoveryKeys, nowMicros());
    console.log(`created the scope ${created.handle} (${created.did}), owned by ${owner as String}`);
  } catch (e) {
    if (e is HostError) {
      console.error(`create-scope: ${e.message}`);
      exit(1);
      return;
    }
    throw e;
  }
  exit(0);
}

/** Prints a new secp256k1 private key and its `did:key`, and exits. */
function generateKey(): void {
  let key = new SigningKey(KeyType.Secp256k1, randomBytes(32));
  console.log(`private key (keep it offline): ${hex.encode(key.privateKey)}`);
  console.log(`did:key (PDS_OFFLINE_ROTATION_KEY): ${formatDidKey(key.publicKey())}`);
  exit(0);
}

/**
 * Undoes every operation of a DID after one, with the offline key read
 * from stdin, and exits.
 */
async function plcRestore(): Future<void> {
  let usage = 'usage: plc-restore <did> <cid> [--yes], with the offline private key in hex on stdin';
  let args = argumentsAfter('plc-restore') as Array<String>;
  let positional = new GrowableArray<String>();
  var yes = false;
  for (let arg in args) {
    if (arg == '--yes') {
      yes = true;
    } else {
      positional.push(arg);
    }
  }
  if (positional.length != 2 || !positional[0].startsWith('did:plc:')) {
    console.error(usage);
    exit(2);
    return;
  }
  let did = positional[0];
  let cid = positional[1];
  let directory = getEnv('PDS_PLC_DIRECTORY') ?? 'https://plc.directory';
  let keyText = (await readStdin()).trim();
  var key: SigningKey | null = null;
  try {
    key = new SigningKey(KeyType.Secp256k1, hex.decode(keyText));
    (key as SigningKey).publicKey();
  } catch (e) {
    console.error('plc-restore: stdin does not hold a secp256k1 private key in hex');
    exit(2);
    return;
  }
  let offline = key as SigningKey;
  try {
    let response = await fetch(`${directory}/${did}/log`);
    if (!response.ok) {
      throw new PlcError(`${directory} has no log for ${did}: HTTP ${response.status}`);
    }
    let list = parseJson(await response.text());
    if (!(list is JsonArray)) {
      throw new PlcError(`${directory} answered ${did}'s log with something other than a list`);
    }
    let log = new GrowableArray<PlcOperation>();
    let items = list as JsonArray;
    for (var i = 0; i < items.length; i += 1) {
      log.push(PlcOperation.fromJson(items[i]));
    }
    let undo = undoOperation(log, cid, offline.publicKey()).signedWith((bytes) => offline.sign(bytes));
    console.log(stringify(undo.toJson()));
    if (!yes) {
      console.log(`run again with --yes to send it to ${directory}, undoing every operation of ${did} after ${cid}`);
      exit(0);
      return;
    }
    await submitPlcOperation(directory, did, undo);
    console.log(`sent: ${did} is as ${cid} left it`);
  } catch (e) {
    if (e is PlcError) {
      console.error(`plc-restore: ${e.message}`);
      exit(1);
      return;
    }
    throw e;
  }
  exit(0);
}

/** Writes every handle record from the host's store, and exits. */
async function syncHandles(config: ServiceConfig): Future<void> {
  let service = await buildService(config, '');
  let host = service.host;
  if (host == null) {
    console.error('sync-handles needs a package host: set PDS_HOST_DOMAIN');
    exit(2);
    return;
  }
  let written = await host.syncHandles();
  console.log(`wrote ${written} handle records for ${host.config.domain}`);
  exit(0);
}
