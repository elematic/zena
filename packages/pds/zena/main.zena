/**
 * Starts the PDS on `PORT` (default 2583, the reference PDS's port), with
 * its data in memory, so it starts empty and forgets everything when it
 * stops.
 */

import { getEnv } from 'zena:cli';
import { Pds } from './pds.zena';
import { createApp } from './server.zena';
import { MemoryStorage } from './storage.zena';

function resolvePort(): u16 {
  let envPort = getEnv('PORT');
  if (envPort != null) {
    if (let (true, p) = parseI32(envPort)) {
      return p as u16;
    }
  }
  return 2583 as u16;
}

export async function main() {
  let server = await createApp(new Pds(new MemoryStorage())).listen(resolvePort());
  console.log(`PDS listening on http://localhost:${server.port}`);
}
