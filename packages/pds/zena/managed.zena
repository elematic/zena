/**
 * Managed accounts (docs/design/package-manager.md, "Managed accounts"):
 * accounts this PDS creates for a package host its operator trusts, with
 * no email address, password or invite code, and which take writes only
 * from that host.
 *
 * A host first asks for a signing key with
 * `com.atproto.server.reserveSigningKey`, which the PDS makes and keeps
 * for that host (`reserver`). The host mints the account's `did:plc` with
 * a genesis operation naming that key and this PDS, signed with its
 * rotation key, which is the DID's only PLC operation. It then asks for
 * the account with `com.atproto.server.createAccount` and a service-auth
 * token of its own. `admit` checks that the genesis operation was signed
 * by the rotation key of the trusted host the token is from, and that the
 * DID document names this PDS; the PDS makes the account with the key the
 * document names, if that host reserved it (`Pds.createManagedAccount`).
 *
 * Every write to the account carries a service-auth token from its host,
 * for the write's method and addressed to this PDS (`fromHost`). Whoever
 * writes, the account holds only what `ManagedLimits` allows: by default
 * the records and artifacts of Zena packages.
 */

import {Future} from 'zena:async';
import {SERVER_CREATE_ACCOUNT, SERVER_RESERVE_SIGNING_KEY} from 'atproto:methods';
import {PublicKey, formatDidKey} from 'atproto:didkey';
import {PlcError, PlcOperation, didOfGenesis} from 'atproto:plc';
import {ReplayGuard, ServiceAuthError, SigningKeyLookup, verifyServiceAuth} from 'atproto:service-auth';
import {ARTIFACT_MIME_TYPES} from 'package-manager:validate';
import {SessionError} from './sessions.zena';
import {Account} from './storage.zena';

/**
 * What the PDS lets a managed account hold, whoever writes it: its
 * operator's limits against abuse, since it creates such an account on an
 * App View's word (package-manager.md, "Managed accounts"). By default,
 * the records and artifacts of Zena packages.
 */
export final class ManagedLimits {
  /** The NSID prefixes a record's collection must start with. */
  var collections: Array<String> = ['dev.zena-lang.'];
  /** The MIME types a blob may have. */
  var blobTypes: Array<String> = ARTIFACT_MIME_TYPES;
  /** The largest blob, in bytes. */
  var maxBlobSize: i64 = (50 * 1024 * 1024) as i64;

  /** Whether a managed account may hold records of `collection`. */
  allowsCollection(collection: String): boolean {
    for (let prefix in this.collections) {
      if (collection.startsWith(prefix)) {
        return true;
      }
    }
    return false;
  }

  /**
   * The MIME type `contentType` names, without its parameters and in
   * lowercase, when a managed account's blob may have it; otherwise null.
   */
  blobType(contentType: String): String | null {
    let type = contentType.split(';')[0].trim().asciiLowerCase();
    for (let allowed in this.blobTypes) {
      if (type == allowed) {
        return type;
      }
    }
    return null;
  }
}

/** A package host the operator trusts: its DID, and the rotation keys it signs its DIDs' genesis operations with. */
export final class TrustedHost {
  did: String;
  rotationKeys: Array<PublicKey>;

  new(this.did, this.rotationKeys);
}

/** What `ManagedAccounts.admit` admits: the host, and the signing key the DID document names. */
export final class Admission {
  host: TrustedHost;
  /** A `did:key`, which the PDS makes the account with if the host reserved it. */
  signingKey: String;

  new(this.host, this.signingKey);
}

/**
 * The operations a PLC directory has recorded for a DID, oldest first.
 * Throws `PlcError`, or answers none, when it has no log for the DID.
 */
export type PlcLogLookup = (did: String) => Future<Array<PlcOperation>>;

/** The trusted hosts, and the checks on the tokens of managed accounts and their hosts. */
export final class ManagedAccounts {
  /** This PDS's DID, which the tokens are addressed to. */
  serviceDid: String;
  /** This PDS's endpoint, which a managed account's DID document names. */
  endpoint: String;
  #hosts: Array<TrustedHost>;
  #log: PlcLogLookup;
  #keys: SigningKeyLookup;
  #replays = new ReplayGuard();

  new(serviceDid: String, endpoint: String, hosts: Array<TrustedHost>, log: PlcLogLookup, keys: SigningKeyLookup)
      : serviceDid = serviceDid, endpoint = endpoint, #hosts = hosts, #log = log, #keys = keys;

  /**
   * The trusted host that the token in `authorization`, for
   * `com.atproto.server.reserveSigningKey`, is from. Throws `SessionError`.
   */
  async reserver(authorization: String | null, nowSeconds: i64): Future<TrustedHost> {
    let caller = await this.caller(authorization, SERVER_RESERVE_SIGNING_KEY, nowSeconds);
    let host = this.#trusted(caller);
    if (host == null) {
      throw new SessionError(403, 'Forbidden', `${caller} is not a package host this PDS trusts`);
    }
    return host;
  }

  /**
   * Whether the host that the token in `authorization` is from may have an
   * account for `did`: when its rotation key signed the DID's genesis
   * operation, and the DID document names this PDS. Throws `SessionError`.
   */
  async admit(authorization: String | null, did: String, nowSeconds: i64): Future<Admission> {
    let caller = await this.caller(authorization, SERVER_CREATE_ACCOUNT, nowSeconds);
    var log: Array<PlcOperation> = [];
    try {
      log = await this.#log(did);
    } catch (e) {
      if (!(e is PlcError)) {
        throw e;
      }
    }
    if (log.length == 0 || !makes(log[0], did)) {
      throw new SessionError(400, 'UnresolvableDid', `the PLC directory has no genesis operation for ${did}`);
    }
    let host = this.#signer(log[0]);
    if (host == null) {
      throw new SessionError(400, 'IncompatibleDidDoc', `${did} was not made by a package host this PDS trusts`);
    }
    if (host.did != caller) {
      throw new SessionError(403, 'Forbidden', `${did} was made by ${host.did}, not ${caller}`);
    }
    let latest = log[log.length - 1];
    let pds = pdsOf(latest);
    if (pds != this.endpoint) {
      throw new SessionError(400, 'IncompatibleDidDoc', `${did}'s DID document names ${pds ?? 'no PDS'}, not ${this.endpoint}`);
    }
    if (let (true, signingKey) = latest.verificationMethods.get('atproto')) {
      return new Admission(host, signingKey);
    }
    throw new SessionError(400, 'IncompatibleDidDoc', `${did}'s DID document names no signing key`);
  }

  /**
   * Checks that `authorization` holds a token from `account`'s host, for
   * `method`. Throws `SessionError`.
   */
  async fromHost(authorization: String | null, account: Account, method: String, nowSeconds: i64): Future<void> {
    let caller = await this.caller(authorization, method, nowSeconds);
    if (caller != account.manager) {
      throw new SessionError(403, 'Forbidden', `only ${account.manager ?? 'its host'} writes to ${account.did}`);
    }
  }

  /**
   * Who sent the service-auth token in `authorization`, addressed to this
   * PDS for `method`, once its signature checks against the issuer's DID
   * document. Throws `SessionError`.
   */
  async caller(authorization: String | null, method: String, nowSeconds: i64): Future<String> {
    if (authorization == null || !authorization.startsWith('Bearer ')) {
      throw new SessionError(401, 'AuthenticationRequired', 'a service-auth token is required');
    }
    let token = authorization.sliceBytes(7, authorization.length);
    try {
      let claims = await verifyServiceAuth(token, this.serviceDid, method, nowSeconds, this.#keys);
      this.#replays.accept(claims, nowSeconds);
      return claims.iss;
    } catch (e) {
      if (e is ServiceAuthError) {
        throw new SessionError(401, 'InvalidToken', e.message);
      }
      throw e;
    }
  }

  /** The trusted host whose DID is `did`, or null. */
  #trusted(did: String): TrustedHost | null {
    for (let host in this.#hosts) {
      if (host.did == did) {
        return host;
      }
    }
    return null;
  }

  /** The trusted host whose rotation key, among `genesis`'s own, signed it, or null. */
  #signer(genesis: PlcOperation): TrustedHost | null {
    for (let host in this.#hosts) {
      for (let key in host.rotationKeys) {
        if (genesis.rotationKeys.contains(formatDidKey(key)) && genesis.isSignedBy(key)) {
          return host;
        }
      }
    }
    return null;
  }
}

/** Whether `operation` is the signed genesis operation of `did`. */
function makes(operation: PlcOperation, did: String): boolean {
  try {
    return didOfGenesis(operation) == did;
  } catch (e) {
    if (e is PlcError) {
      return false;
    }
    throw e;
  }
}

/** The PDS endpoint `operation` names, or null. */
function pdsOf(operation: PlcOperation): String | null {
  if (let (true, service) = operation.services.get('atproto_pds')) {
    return service.endpoint;
  }
  return null;
}
