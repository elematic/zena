/**
 * The PDS: its storage, the accounts in it, and each account's repository.
 * The HTTP routes (`pds:server`) answer from this, and tests drive it
 * directly. pds.js builds one `PersonalDataServer` around one account
 * (`packages/core/src/pds.js`); this finds the account for each request,
 * since it holds many.
 */

import {Future} from 'zena:async';
import {normalizeHandle} from 'atproto:syntax';
import {TidClock} from 'atproto:tid';
import {ManagedAccounts, ManagedLimits} from './managed.zena';
import {CommitListener, Repository} from './repository.zena';
import {Account, AccountKind, SigningKey, Storage} from './storage.zena';

export final class Pds {
  storage: Storage;
  /** The package hosts this server keeps managed accounts for, or null when it keeps none. */
  var managed: ManagedAccounts | null = null;
  /** What a managed account may hold, whoever writes it. */
  managedLimits = new ManagedLimits();
  /** Hands out every commit's `rev`. */
  #clock: TidClock;
  #listeners = new GrowableArray<CommitListener>();

  /**
   * `clockId`, 0 to 1023, keeps this server's revisions apart from another's
   * made in the same microsecond.
   */
  new(storage: Storage, clockId: i32 = 0) : storage = storage, #clock = new TidClock(clockId);

  /**
   * Adds an account and writes its repository's first commit. `nowMicros`
   * is the time, in microseconds since the Unix epoch. `manager` is the
   * DID of the package host that alone writes to a managed account.
   */
  async createAccount(did: String, handle: String | null, key: SigningKey, nowMicros: i64,
      kind: AccountKind = AccountKind.Person, manager: String | null = null): Future<Account> {
    let account = new Account(did, handle, key, kind);
    account.manager = manager;
    await this.storage.putAccount(account);
    await this.repositoryOf(account).initialize(nowMicros);
    return account;
  }

  /** The account a DID or a handle names, or null. */
  async findAccount(identifier: String): Future<Account | null> {
    if (identifier.startsWith('did:')) {
      return await this.storage.getAccount(identifier);
    }
    return await this.storage.accountByHandle(normalizeHandle(identifier));
  }

  /** A new record key, a TID, for a record created at `nowMicros`. */
  newRecordKey(nowMicros: i64): String {
    return this.#clock.next(nowMicros);
  }

  repositoryOf(account: Account): Repository {
    let limits = this.managedLimits;
    let allows: ((collection: String) => boolean) | null = if (account.manager != null)
        (collection: String) => limits.allowsCollection(collection) else null;
    return new Repository(account, this.storage.store(account.did), this.#clock, this.#listeners, allows);
  }

  /**
   * Runs `listener` after each commit of writes to a repository this
   * server makes, before the write returns: the package host keeps its
   * package summaries with it. A listener that throws fails the write
   * after its commit, so a listener catches what it can live without.
   */
  onCommit(listener: CommitListener): void {
    this.#listeners.push(listener);
  }
}
