/**
 * An account's repository: applying writes, which signs a new commit each
 * time, and reading it back as the proofs and archives `com.atproto.sync`
 * serves. The write path follows pds.js `packages/core/src/pds.js`
 * (`applyWrites`), and the reads `packages/core/src/handlers/xrpc-sync.js`.
 *
 * Each commit rebuilds the record tree from the record index, where pds.js
 * updates it along the changed paths (`packages/core/src/mst.js`). The tree
 * for a set of keys is unique, so both give the same root; rebuilding costs
 * time in proportion to the repository, which is small for the package
 * accounts this serves first. Porting the path updates is a later change.
 * A `getRecord` proof holds the nodes on the path to the record, where
 * pds.js sends every node.
 *
 * pds.js serializes an account's writes by running it in one Durable
 * Object. Here several servers may share a store, so a commit is built on
 * the head read at its start, and stored only if that is still the head
 * (`AccountStore.commit`); otherwise the writes are checked and applied
 * again on the new head.
 */

import {Future} from 'zena:async';
import {HashMap} from 'zena:collections';
import {BlockMap, writeCar} from 'atproto:car';
import {Cid} from 'atproto:cid';
import {MapValue, stringField} from 'atproto:data';
import {MstNode, buildMst, compareKeys, decodeNode} from 'atproto:mst';
import {decodeCommit, signCommit} from 'atproto:repo';
import {isValidNsid, isValidRecordKey} from 'atproto:syntax';
import {TidClock, tidMicros} from 'atproto:tid';
import {Account, AccountStore, Head, RecordChange, RecordEntry, sortRecordEntries} from './storage.zena';

/** How many times a write is tried while other writes keep moving the head. */
let COMMIT_ATTEMPTS = 5;

/** A write the repository refuses, with the XRPC error name to answer with. */
export class RepositoryError extends Error {
  /** Such as `InvalidRequest` or `RecordNotFound`. */
  error: String;

  new(error: String, message: String) : error = error, super(message);
}

/**
 * One change to a repository's records. An update or a deletion with a
 * non-null `swapRecord` happens only while the record's CID is that one, and is
 * refused with `InvalidSwap` otherwise, as `com.atproto.repo.putRecord`'s
 * `swapRecord` is: the check is made again on every attempt to commit, so
 * a change that lands between the check and the commit is not overwritten.
 */
// TODO(#603): default `swapRecord` to null once variants take defaults.
export sealed class Write {
  case CreateRecord(collection: String, rkey: String, record: MapValue)
  case UpdateRecord(collection: String, rkey: String, record: MapValue, swapRecord: Cid | null)
  case DeleteRecord(collection: String, rkey: String, swapRecord: Cid | null)
}

/** An account's repository, over its store. */
export final class Repository {
  #account: Account;
  #store: AccountStore;
  #clock: TidClock;

  new(account: Account, store: AccountStore, clock: TidClock)
      : #account = account, #store = store, #clock = clock;

  /**
   * Writes the repository's first commit, of an empty tree, unless it has
   * one. `nowMicros` is the time, in microseconds since the Unix epoch.
   */
  async initialize(nowMicros: i64): Future<Head> {
    for (var attempt = 0; attempt < COMMIT_ATTEMPTS; attempt += 1) {
      let head = await this.#store.getHead();
      if (head != null) {
        return head as Head;
      }
      let committed = await this.#commit(null, new BlockMap(), new GrowableArray<RecordChange>(), nowMicros);
      if (committed != null) {
        return committed as Head;
      }
    }
    throw new Error(`${this.#account.did}: the repository's head kept moving`);
  }

  /**
   * Applies `writes` in order and signs one commit for all of them. Throws
   * `RepositoryError` for a write that is malformed, creates a record that
   * exists, or updates or deletes one that does not; nothing is written
   * then.
   */
  async applyWrites(writes: Array<Write>, nowMicros: i64): Future<Head> {
    for (var attempt = 0; attempt < COMMIT_ATTEMPTS; attempt += 1) {
      let previous = await this.#store.getHead();
      let blocks = new BlockMap();
      let changes = await this.#changes(writes, blocks);
      let head = await this.#commit(previous, blocks, changes, nowMicros);
      if (head != null) {
        return head as Head;
      }
    }
    throw new Error(`${this.#account.did}: the repository's head kept moving`);
  }

  /**
   * The changes `writes` make to the record index, checked against it, with
   * each new record's block added to `blocks`.
   */
  async #changes(writes: Array<Write>, blocks: BlockMap): Future<GrowableArray<RecordChange>> {
    let changes = new GrowableArray<RecordChange>();
    // A record created and then deleted in the same batch, say, is checked
    // against the batch's own earlier writes.
    let pending = new HashMap<String, boolean>();
    for (let write in writes) {
      let collection = collectionOf(write);
      let rkey = rkeyOf(write);
      checkKey(collection, rkey);
      if (!this.#account.allows(collection)) {
        throw new RepositoryError('InvalidRequest',
            `${this.#account.did} cannot hold records of ${collection}`);
      }
      let key = `${collection}/${rkey}`;
      var exists = false;
      var current: Cid | null = null;
      if (let (true, present) = pending.get(key)) {
        exists = present;
      } else {
        current = await this.#store.getRecord(collection, rkey);
        exists = current != null;
      }
      let swap = swapOf(write);
      if (swap != null && (current == null || !(current as Cid).equals(swap as Cid))) {
        throw new RepositoryError('InvalidSwap', `${key} is not ${(swap as Cid).toString()}`);
      }
      match (write) {
        case CreateRecord {record}: {
          if (exists) {
            throw new RepositoryError('InvalidRequest', `${key} already exists`);
          }
          changes.push(new RecordChange(collection, rkey, addRecord(blocks, collection, record)));
          pending[key] = true;
        }
        case UpdateRecord {record}: {
          if (!exists) {
            throw new RepositoryError('RecordNotFound', `${key} does not exist`);
          }
          changes.push(new RecordChange(collection, rkey, addRecord(blocks, collection, record)));
        }
        case DeleteRecord {}: {
          if (!exists) {
            throw new RepositoryError('RecordNotFound', `${key} does not exist`);
          }
          changes.push(new RecordChange(collection, rkey, null));
          pending[key] = false;
        }
      }
    }
    return changes;
  }

  /**
   * The answer to `com.atproto.sync.getRecord` for `collection/rkey`: a CAR
   * file whose root is the current commit, holding the tree's nodes on the
   * path to the record and the record. Null when there is no such record.
   */
  async recordProof(collection: String, rkey: String): Future<FixedArray<u8> | null> {
    let cid = await this.#store.getRecord(collection, rkey);
    if (cid == null) {
      return null;
    }
    let head = await this.#head();
    let blocks = new BlockMap();
    let commitBytes = await this.#block(head.cid);
    blocks.set(head.cid, commitBytes);
    let key = `${collection}/${rkey}`;
    var next: Cid | null = decodeCommit(commitBytes).data;
    while (next != null) {
      let nodeCid = next as Cid;
      let bytes = await this.#block(nodeCid);
      blocks.set(nodeCid, bytes);
      next = childToward(decodeNode(bytes), key);
    }
    let recordCid = cid as Cid;
    blocks.set(recordCid, await this.#block(recordCid));
    return writeCar(new FixedArray<Cid>(1, head.cid), blocks);
  }

  /**
   * The whole repository as `com.atproto.sync.getRepo` answers with it: the
   * current commit, every node of the tree and every record.
   */
  async exportCar(): Future<FixedArray<u8>> {
    let head = await this.#head();
    let blocks = new BlockMap();
    let commitBytes = await this.#block(head.cid);
    blocks.set(head.cid, commitBytes);
    let pending = new GrowableArray<Cid>();
    pending.push(decodeCommit(commitBytes).data);
    while (pending.length > 0) {
      let nodeCid = pending.pop();
      let bytes = await this.#block(nodeCid);
      blocks.set(nodeCid, bytes);
      let node = decodeNode(bytes);
      if (node.left != null) {
        pending.push(node.left as Cid);
      }
      for (let entry in node.entries) {
        blocks.set(entry.value, await this.#block(entry.value));
        if (entry.right != null) {
          pending.push(entry.right as Cid);
        }
      }
    }
    return writeCar(new FixedArray<Cid>(1, head.cid), blocks);
  }

  /**
   * Builds the tree over the record index with `changes` made, stores its
   * nodes, `blocks` and a commit over it after `previous`, and makes that
   * commit the head. Returns null, when `previous` is no longer the head.
   */
  async #commit(previous: Head | null, blocks: BlockMap, changes: GrowableArray<RecordChange>, nowMicros: i64)
      : Future<Head | null> {
    let records = withChanges(await this.#store.allRecords(), changes);
    let keys = new FixedArray<String>(records.length, '');
    let values = new FixedArray<Cid>(records.length, Cid.forBlob(new FixedArray<u8>(0, 0 as u8)));
    for (var i = 0; i < records.length; i += 1) {
      keys[i] = records[i].key();
      values[i] = records[i].cid;
    }
    let root = buildMst(keys, values, blocks);
    // A revision follows the one before it, even one another server's
    // clock gave out.
    var micros = nowMicros;
    if (previous != null && tidMicros(previous.rev) >= micros) {
      micros = tidMicros(previous.rev) + 1;
    }
    let rev = this.#clock.next(micros);
    let key = await this.#account.signingKey();
    let commit = signCommit(this.#account.did, root, rev,
        if (previous == null) null else (previous as Head).cid, (bytes) => key.sign(bytes));
    blocks.set(commit.cid, commit.bytes);
    await this.#store.putBlocks(blocks);
    let head = new Head(commit.cid, rev);
    if (await this.#store.commit(previous, head, changes)) {
      return head;
    }
    return null;
  }

  async #head(): Future<Head> {
    let head = await this.#store.getHead();
    if (head == null) {
      throw new RepositoryError('RepoNotFound', `${this.#account.did} has no commit`);
    }
    return head as Head;
  }

  async #block(cid: Cid): Future<FixedArray<u8>> {
    let bytes = await this.#store.getBlock(cid);
    if (bytes == null) {
      throw new Error(`${this.#account.did} is missing block ${cid.toString()}`);
    }
    return bytes as FixedArray<u8>;
  }
}

/** `records`, in tree-key order, with `changes` made, the last change to a key winning. */
function withChanges(records: Array<RecordEntry>, changes: GrowableArray<RecordChange>): GrowableArray<RecordEntry> {
  let changed = new HashMap<String, RecordChange>();
  for (let change in changes) {
    changed[`${change.collection}/${change.rkey}`] = change;
  }
  let result = new GrowableArray<RecordEntry>();
  for (let record in records) {
    if (!changed.has(record.key())) {
      result.push(record);
    }
  }
  changed.forEach((key, change) => {
    let cid = change.cid;
    if (cid != null) {
      result.push(new RecordEntry(change.collection, change.rkey, cid));
    }
  });
  return sortRecordEntries(result, (a, b) => compareKeys(a.key(), b.key()));
}

function collectionOf(write: Write): String {
  return match (write) {
    case CreateRecord {collection}: collection
    case UpdateRecord {collection}: collection
    case DeleteRecord {collection}: collection
  };
}

/** The CID an update or deletion requires the record to have, or null. */
function swapOf(write: Write): Cid | null {
  return match (write) {
    case CreateRecord {}: null
    case UpdateRecord {swapRecord}: swapRecord
    case DeleteRecord {swapRecord}: swapRecord
  };
}

function rkeyOf(write: Write): String {
  return match (write) {
    case CreateRecord {rkey}: rkey
    case UpdateRecord {rkey}: rkey
    case DeleteRecord {rkey}: rkey
  };
}

/** Stores `record` as a block and returns its CID, checking its `$type`. */
function addRecord(blocks: BlockMap, collection: String, record: MapValue): Cid {
  let type = stringField(record, '$type');
  if (type == null || type as String != collection) {
    throw new RepositoryError('InvalidRecord', `a record in ${collection} must have $type ${collection}`);
  }
  return blocks.add(record);
}

function checkKey(collection: String, rkey: String): void {
  if (!isValidNsid(collection)) {
    throw new RepositoryError('InvalidRequest', `'${collection}' is not a collection NSID`);
  }
  if (!isValidRecordKey(rkey)) {
    throw new RepositoryError('InvalidRequest', `'${rkey}' is not a record key`);
  }
}

/**
 * The subtree of `node` that holds `key`, if the node does not: the one
 * before the first entry whose key is greater. Null when there is none, or
 * when the node holds the key itself.
 */
function childToward(node: MstNode, key: String): Cid | null {
  var next = node.left;
  for (let entry in node.entries) {
    let order = compareKeys(key, entry.key);
    if (order == 0) {
      return null;
    }
    if (order < 0) {
      break;
    }
    next = entry.right;
  }
  return next;
}
