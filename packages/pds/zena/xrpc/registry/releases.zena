/**
 * The App View methods of a package's releases: uploading an artifact,
 * publishing a release, which the App View holds until its maintainers attest
 * it, completing it once they have, listing and withdrawing the releases
 * waiting, and retracting a published one (package-manager.md,
 * "Publishing a release").
 */

import {Future} from 'zena:async';
import {HttpError, Router} from 'zena:http';
import {JsonArray, JsonObject} from 'zena:json';
import {formatTimestamp} from 'zena:time';
import {decodeCbor} from 'atproto:cbor';
import {fromJson, toJson} from 'atproto:data';
import {
  COMPLETE_RELEASE, GET_PENDING_RELEASES, PUBLISH, RETRACT, UPLOAD_ARTIFACT, WITHDRAW_RELEASE
} from 'package-manager:registry-methods';
import {PENDING_MICROS, AppView, Tally} from '../../app-view.zena';
import {fail, jsonBody, nowMicros} from '../common.zena';
import {registryProcedure, registryQuery, writtenJson} from './common.zena';

/** Adds the methods of releases to `router`. */
export function releaseRoutes(router: Router, appView: AppView): void {
  registryProcedure(router, appView, UPLOAD_ARTIFACT, async (req, res, caller): Future<JsonObject | null> => {
    let pkg = req.url.searchParams().get('package');
    if (pkg == null || pkg == '') {
      fail(res, 400, 'InvalidRequest', 'Missing required parameter: package');
      return null;
    }
    // Reading the body consumes the request: its type is read first.
    let mimeType = req.getHeader('content-type') ?? 'application/octet-stream';
    // As large as the App View stores, and refused before more is read.
    req.bodyLimit = appView.config.maxBlobSize;
    let bytes = try {
      await req.bytes()
    } catch (e) {
      if (e is HttpError && e.status == 413) {
        fail(res, 413, 'TooLarge', `the blob is larger than ${appView.config.maxBlobSize} bytes`);
        return null;
      }
      throw e;
    };
    let blob = await appView.uploadArtifact(caller, pkg, mimeType, bytes);
    let body = new JsonObject();
    body['blob'] = toJson(blob.toValue());
    return body;
  });

  registryProcedure(router, appView, PUBLISH, async (req, res, caller): Future<JsonObject | null> => {
    let input = await jsonBody(req, res);
    if (input == null) {
      return null;
    }
    if (!(input['package'] is String) || input['release'] == null) {
      fail(res, 400, 'InvalidRequest', 'package and release are required');
      return null;
    }
    let created = await appView.publish(caller, input['package'] as String, fromJson(input['release']),
        nowMicros());
    let answer = writtenJson(created);
    answer['state'] = 'pending';
    return answer;
  });

  registryProcedure(router, appView, COMPLETE_RELEASE, async (req, res, caller): Future<JsonObject | null> => {
    let input = await jsonBody(req, res);
    if (input == null) {
      return null;
    }
    if (!(input['package'] is String) || !(input['version'] is String)) {
      fail(res, 400, 'InvalidRequest', 'package and version are required');
      return null;
    }
    let completion = await appView.completeRelease(caller, input['package'] as String, input['version'] as String,
        nowMicros());
    let answer = tallyJson(completion.tally);
    answer['uri'] = completion.uri;
    answer['cid'] = completion.cid.toString();
    answer['state'] = if (completion.published) 'published' else 'pending';
    return answer;
  });

  registryQuery(router, appView, GET_PENDING_RELEASES, async (req, res, caller): Future<JsonObject | null> => {
    let pkg = req.url.searchParams().get('package');
    if (pkg == null || pkg == '') {
      fail(res, 400, 'InvalidRequest', 'Missing required parameter: package');
      return null;
    }
    let releases = new JsonArray();
    for (let waiting in await appView.pendingReleases(caller, pkg, nowMicros())) {
      let held = waiting.release;
      let entry = tallyJson(waiting.tally);
      entry['version'] = held.version;
      entry['uri'] = waiting.uri;
      entry['cid'] = held.cid.toString();
      entry['publisher'] = held.publisher;
      entry['heldAt'] = formatTimestamp(held.heldAt * (1000 as i64));
      entry['expiresAt'] = formatTimestamp((held.heldAt + PENDING_MICROS) * (1000 as i64));
      entry['release'] = toJson(decodeCbor(held.record));
      releases.push(entry);
    }
    let answer = new JsonObject();
    answer['releases'] = releases;
    return answer;
  });

  registryProcedure(router, appView, WITHDRAW_RELEASE, async (req, res, caller): Future<JsonObject | null> => {
    let input = await jsonBody(req, res);
    if (input == null) {
      return null;
    }
    if (!(input['package'] is String) || !(input['version'] is String)) {
      fail(res, 400, 'InvalidRequest', 'package and version are required');
      return null;
    }
    await appView.withdrawRelease(caller, input['package'] as String, input['version'] as String, nowMicros());
    return new JsonObject();
  });

  registryProcedure(router, appView, RETRACT, async (req, res, caller): Future<JsonObject | null> => {
    let input = await jsonBody(req, res);
    if (input == null) {
      return null;
    }
    let reason = input['reason'];
    if (!(input['package'] is String) || !(input['version'] is String) || (reason != null && !(reason is String))) {
      fail(res, 400, 'InvalidRequest', 'package and version are required, and reason must be a string');
      return null;
    }
    return writtenJson(await appView.retract(caller, input['package'] as String, input['version'] as String,
        if (reason is String) reason else null, nowMicros()));
  });
}

/** Who attested a release, and what its maintainers record asks for. */
function tallyJson(tally: Tally): JsonObject {
  let approvedBy = new JsonArray();
  for (let did in tally.approvedBy) {
    approvedBy.push(did);
  }
  let answer = new JsonObject();
  answer['approvedBy'] = approvedBy;
  answer['people'] = new Box<f64>(tally.people as f64);
  answer['threshold'] = new Box<f64>(tally.threshold as f64);
  answer['humans'] = new Box<f64>(tally.humans as f64);
  return answer;
}
