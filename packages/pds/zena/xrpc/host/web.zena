/**
 * What the host's web pages sign in with: the web app's atproto OAuth
 * client metadata, which its `client_id` names, so the person's PDS can
 * find its redirect and scope; and `createWebSession`, which trades a
 * service-auth token from the person's own PDS for a cookie that keeps
 * them signed in to the pages (`pds:web/session`).
 */

import {Future} from 'zena:async';
import {Router} from 'zena:http';
import {JsonArray, JsonObject} from 'zena:json';
import {div} from 'zena:math';
import {CREATE_WEB_SESSION} from 'package-manager:host-methods';
import {HostError, PackageHost} from '../../host.zena';
import {CALLBACK_PATH} from '../../web/pages/sign-in.zena';
import {setSessionCookie} from '../../web/session.zena';
import {json, nowMicros} from '../common.zena';
import {hostProcedure} from './common.zena';

/** Where the web app's OAuth client metadata is, below the host's origin. */
export let OAUTH_CLIENT_METADATA = '/oauth/client-metadata.json';

/**
 * The OAuth scope the web app asks for: service-auth tokens for
 * `createWebSession` and nothing else, so signing in grants no access to
 * the person's repository or other apps' data (the atproto permission
 * spec's `rpc` scope; `getServiceAuth` checks it). Its audience is `*`:
 * the page asks for tokens addressed to the host's service DID, and an
 * audience in a scope must also name a service type. As the pages gain
 * actions, the permission set `dev.zena-lang.authPublish` replaces this,
 * once its lexicon is published where PDSes resolve it.
 */
let OAUTH_SCOPE = `atproto rpc:${CREATE_WEB_SESSION}?aud=*`;

/** Adds the OAuth client metadata and `createWebSession` to `router`. */
export function webSessionRoutes(router: Router, host: PackageHost): void {
  router.get(OAUTH_CLIENT_METADATA, async (req, res, next, params) => {
    let origin = host.config.endpoint;
    let redirects = new JsonArray();
    redirects.push(`${origin}${CALLBACK_PATH}`);
    let grants = new JsonArray();
    grants.push('authorization_code');
    grants.push('refresh_token');
    let responses = new JsonArray();
    responses.push('code');
    let metadata = new JsonObject();
    metadata['client_id'] = `${origin}${OAUTH_CLIENT_METADATA}`;
    metadata['client_name'] = 'Zena packages';
    metadata['client_uri'] = origin;
    metadata['redirect_uris'] = redirects;
    metadata['scope'] = OAUTH_SCOPE;
    metadata['grant_types'] = grants;
    metadata['response_types'] = responses;
    metadata['token_endpoint_auth_method'] = 'none';
    metadata['application_type'] = 'web';
    metadata['dpop_bound_access_tokens'] = new Box<boolean>(true);
    json(res, metadata);
  });

  hostProcedure(router, host, CREATE_WEB_SESSION, async (req, res, caller): Future<JsonObject | null> => {
    let sessions = host.sessions;
    if (sessions == null) {
      throw new HostError(501, 'MethodNotImplemented', 'this host has no sessions');
    }
    let handle = await host.handleOf(caller);
    setSessionCookie(res, host, sessions.webSession(caller, handle, div(nowMicros(), 1000000 as i64)));
    let answer = new JsonObject();
    answer['did'] = caller;
    if (handle != null) {
      answer['handle'] = handle as String;
    }
    return answer;
  });
}
