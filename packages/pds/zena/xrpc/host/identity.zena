/**
 * What a client needs to find and call the package host: its DID
 * document, when its service DID is a `did:web`, which names the host's
 * methods as `#zena_package_host`; `dev.zena-lang.host.describeHost`,
 * which gives that DID, which tokens are addressed to, the domain its
 * handles are under, and what it serves (package-manager.md, "Finding a
 * host"); `com.atproto.server.describeServer`, the PDS's; and
 * `com.atproto.identity.resolveHandle`, which the web app's sign-in
 * resolves handles with, since a browser cannot look DNS up itself.
 */

import {Router} from 'zena:http';
import {JsonArray, JsonObject} from 'zena:json';
import {formatMultikey} from 'atproto:didkey';
import {IDENTITY_RESOLVE_HANDLE, SERVER_DESCRIBE_SERVER, xrpcPath} from 'atproto:methods';
import {
  CREATE_AUTOMATION_ACCOUNT, DESCRIBE_HOST, HOST_METHODS, PACKAGE_HOST_SERVICE, PACKAGE_HOST_TYPE
} from 'package-manager:host-methods';
import {PackageHost} from '../../host.zena';
import {fail, json} from '../common.zena';

/** Adds the host's DID document, `describeHost`, `describeServer` and `resolveHandle` to `router`. */
export function identityRoutes(router: Router, host: PackageHost): void {
  // A `did:web` resolves to `https://<host>/.well-known/did.json`. It names
  // the server as a PDS, and its host methods, and lists the host's
  // signing key, which its tokens to the PDSes of its accounts are
  // checked with.
  if (host.config.serviceDid.startsWith('did:web:')) {
    router.get('/.well-known/did.json', async (req, res, next, params) => {
      let context = new JsonArray();
      context.push('https://www.w3.org/ns/did/v1');
      context.push('https://w3id.org/security/multikey/v1');
      let pds = new JsonObject();
      pds['id'] = '#atproto_pds';
      pds['type'] = 'AtprotoPersonalDataServer';
      pds['serviceEndpoint'] = host.config.endpoint;
      let hostService = new JsonObject();
      hostService['id'] = `#${PACKAGE_HOST_SERVICE}`;
      hostService['type'] = PACKAGE_HOST_TYPE;
      hostService['serviceEndpoint'] = host.config.endpoint;
      let services = new JsonArray();
      services.push(pds);
      services.push(hostService);
      let body = new JsonObject();
      body['@context'] = context;
      body['id'] = host.config.serviceDid;
      let signingKey = host.config.signingKey;
      if (signingKey != null) {
        let method = new JsonObject();
        method['id'] = `${host.config.serviceDid}#atproto`;
        method['type'] = 'Multikey';
        method['controller'] = host.config.serviceDid;
        method['publicKeyMultibase'] = formatMultikey(signingKey.publicKey());
        let methods = new JsonArray();
        methods.push(method);
        body['verificationMethod'] = methods;
      }
      body['service'] = services;
      json(res, body);
    });
  }

  router.get(xrpcPath(DESCRIBE_HOST), async (req, res, next, params) => {
    let reserved = new JsonArray();
    for (let name in host.config.reservedScopes) {
      reserved.push(name);
    }
    let limits = new JsonObject();
    limits['maxBlobSize'] = new Box<f64>(host.config.maxBlobSize as f64);
    // A host with no sessions cannot sign automation accounts in.
    let served = new JsonArray();
    for (let method in HOST_METHODS) {
      if (method != CREATE_AUTOMATION_ACCOUNT || host.sessions != null) {
        served.push(method);
      }
    }
    let body = new JsonObject();
    body['did'] = host.config.serviceDid;
    body['domain'] = host.config.domain;
    body['reservedScopes'] = reserved;
    body['limits'] = limits;
    // New scopes do not wait for the operator yet (#670).
    body['scopeApproval'] = new Box<boolean>(false);
    body['methods'] = served;
    json(res, body);
  });

  router.get(xrpcPath(SERVER_DESCRIBE_SERVER), async (req, res, next, params) => {
    let domains = new JsonArray();
    domains.push(`.${host.config.domain}`);
    let body = new JsonObject();
    body['did'] = host.config.serviceDid;
    body['availableUserDomains'] = domains;
    json(res, body);
  });

  resolveHandleRoute(router, host);
}

/**
 * Adds `com.atproto.identity.resolveHandle`, which the site's sign-in
 * also calls on its own origin to resolve the handle a person types, to
 * `router`.
 */
export function resolveHandleRoute(router: Router, host: PackageHost): void {
  router.get(xrpcPath(IDENTITY_RESOLVE_HANDLE), async (req, res, next, params) => {
    let handle = req.url.searchParams().get('handle');
    if (handle == null || handle == '') {
      fail(res, 400, 'InvalidRequest', 'Missing required parameter: handle');
      return;
    }
    let did = await host.resolveHandle(handle);
    if (did == null) {
      fail(res, 400, 'HandleNotFound', `${handle} does not resolve to a DID`);
      return;
    }
    let answer = new JsonObject();
    answer['did'] = did;
    json(res, answer);
  });
}
