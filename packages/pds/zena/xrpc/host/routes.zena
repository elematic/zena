/**
 * Every route of the package host (`pds:host`), each area in its own
 * module beside this one: what a client finds the host by
 * (`identity.zena`), the accounts it makes and lists (`accounts.zena`),
 * releases (`releases.zena`), who belongs (`members.zena`), and signing in
 * to the pages (`web.zena`). `pds:server` adds them all with `hostRoutes`.
 */

import {Router} from 'zena:http';
import {PackageHost} from '../../host.zena';
import {accountRoutes} from './accounts.zena';
import {identityRoutes} from './identity.zena';
import {memberRoutes} from './members.zena';
import {releaseRoutes} from './releases.zena';
import {webSessionRoutes} from './web.zena';

/** Adds every route of `host` to `router`. */
export function hostRoutes(router: Router, host: PackageHost): void {
  identityRoutes(router, host);
  accountRoutes(router, host);
  releaseRoutes(router, host);
  memberRoutes(router, host);
  webSessionRoutes(router, host);
}
