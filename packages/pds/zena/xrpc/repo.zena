/**
 * The `com.atproto.repo` methods: reading a repository's description, a
 * record and a page of records, and the writes, `putRecord`,
 * `deleteRecord`, `applyWrites` and `uploadBlob`. An account writes its
 * own repository with a session; a managed account takes writes only
 * with its App View's service-auth token (`pds:managed`). Ported from
 * pds.js's `packages/core/src/handlers/xrpc-repo.js`, at the revision
 * docs/design/pds.md pins.
 */

import {Future} from 'zena:async';
import {join, parseI32} from 'zena:core';
import {HttpError, Router} from 'zena:http';
import {JsonArray, JsonObject, JsonValue} from 'zena:json';
import {cidForValue, decodeCbor} from 'atproto:cbor';
import {Cid} from 'atproto:cid';
import {BlobRef, MapValue, fromJson, toJson} from 'atproto:data';
import {
  REPO_APPLY_WRITES, REPO_DELETE_RECORD, REPO_DESCRIBE_REPO, REPO_GET_RECORD, REPO_LIST_RECORDS, REPO_PUT_RECORD,
  REPO_UPLOAD_BLOB, xrpcPath
} from 'atproto:methods';
import {Pds} from '../pds.zena';
import {CreateRecord, DeleteRecord, UpdateRecord, Write} from '../repository.zena';
import {SessionError, Sessions} from '../sessions.zena';
import {Account, Head, StoredBlob} from '../storage.zena';
import {accountFor, fail, json, jsonBody, nowMicros, nowSeconds, parseCid, required, sessionCall} from './common.zena';

/** `com.atproto.repo.listRecords`'s page size, when the request gives none, and its largest. */
let DEFAULT_LIMIT = 50;
let MAX_LIMIT = 100;

/** The most writes one `com.atproto.repo.applyWrites` takes, as its lexicon allows. */
let MAX_WRITES = 200;

/**
 * Adds the reads of the repositories in `pds`, and their writes: by their
 * own accounts with `sessions`, and by their App Views for managed accounts.
 */
export function repoRoutes(router: Router, pds: Pds, sessions: Sessions | null): void {
  router.get(xrpcPath(REPO_DESCRIBE_REPO), async (req, res, next, params) => {
    let given = required(req, res, ['repo']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    let collections = new JsonArray();
    var last = '';
    for (let entry in await pds.storage.store(account.did).allRecords()) {
      // Records come in key order, so a collection's records are together.
      if (entry.collection != last) {
        collections.push(entry.collection);
        last = entry.collection;
      }
    }
    let body = new JsonObject();
    body['handle'] = account.handle ?? account.did;
    body['did'] = account.did;
    body['didDoc'] = new JsonObject();
    body['collections'] = collections;
    body['handleIsCorrect'] = new Box<boolean>(account.handle != null);
    json(res, body);
  });

  router.get(xrpcPath(REPO_GET_RECORD), async (req, res, next, params) => {
    let given = required(req, res, ['repo', 'collection', 'rkey']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    let store = pds.storage.store(account.did);
    let cid = await store.getRecord(given[1], given[2]);
    if (cid == null) {
      fail(res, 404, 'RecordNotFound', 'Record not found');
      return;
    }
    let found = cid;
    let bytes = await store.getBlock(found);
    let body = new JsonObject();
    body['uri'] = `at://${account.did}/${given[1]}/${given[2]}`;
    body['cid'] = found.toString();
    body['value'] = toJson(decodeCbor(bytes as FixedArray<u8>));
    json(res, body);
  });

  router.get(xrpcPath(REPO_LIST_RECORDS), async (req, res, next, params) => {
    let given = required(req, res, ['repo', 'collection']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    let query = req.url.searchParams();
    var limit = DEFAULT_LIMIT;
    if (let (true, asked) = parseI32(query.get('limit') ?? '')) {
      limit = if (asked < 1) 1 else if (asked > MAX_LIMIT) MAX_LIMIT else asked;
    }
    // As the reference PDS does, newest record key first, unless `reverse`.
    let descending = query.get('reverse') != 'true';
    let store = pds.storage.store(account.did);
    let page = await store.listRecords(given[1], query.get('cursor'), limit, descending);
    let records = new JsonArray();
    for (let entry in page) {
      let record = new JsonObject();
      record['uri'] = `at://${account.did}/${entry.collection}/${entry.rkey}`;
      record['cid'] = entry.cid.toString();
      record['value'] = toJson(decodeCbor((await store.getBlock(entry.cid)) as FixedArray<u8>));
      records.push(record);
    }
    let body = new JsonObject();
    body['records'] = records;
    if (page.length == limit) {
      body['cursor'] = page[page.length - 1].rkey;
    }
    json(res, body);
  });

  if (sessions != null || pds.managed != null) {
    writeRoutes(router, pds, sessions);
  }
}

/**
 * Adds the writes to the repositories in `pds`. The body is read before
 * the caller is checked, since its `repo` says whose token a write needs
 * (`writable`), so it is no larger than `REQUEST_BODY_LIMIT`.
 */
function writeRoutes(router: Router, pds: Pds, sessions: Sessions | null): void {
  router.post(xrpcPath(REPO_PUT_RECORD), async (req, res, next, params) => {
    await sessionCall(req, res, async (req, res): Future<JsonObject | null> => {
      let authorization = req.getHeader('authorization');
      let input = await jsonBody(req, res);
      if (input == null) {
        return null;
      }
      if (!(input['collection'] is String) || !(input['rkey'] is String) || !(input['record'] is JsonObject)) {
        fail(res, 400, 'InvalidRequest', 'repo, collection, rkey and record are required');
        return null;
      }
      let account = await writable(pds, sessions, authorization, input['repo'], REPO_PUT_RECORD);
      let collection = input['collection'] as String;
      let rkey = input['rkey'] as String;
      let record = fromJson(input['record']);
      if (!(record is MapValue)) {
        fail(res, 400, 'InvalidRequest', 'the record is not an object');
        return null;
      }
      let swap = swapCidOf(input);
      let store = pds.storage.store(account.did);
      let exists = (await store.getRecord(collection, rkey)) != null;
      if (!exists && swap != null) {
        fail(res, 400, 'InvalidSwap', `${collection}/${rkey} does not exist`);
        return null;
      }
      let write = if (exists) new UpdateRecord(collection, rkey, record, swap) as Write
          else new CreateRecord(collection, rkey, record) as Write;
      let head = await pds.repositoryOf(account).applyWrites([write], nowMicros());
      let answer = new JsonObject();
      answer['uri'] = `at://${account.did}/${collection}/${rkey}`;
      answer['cid'] = ((await store.getRecord(collection, rkey)) as Cid).toString();
      answer['commit'] = commitJson(head);
      return answer;
    });
  });

  router.post(xrpcPath(REPO_DELETE_RECORD), async (req, res, next, params) => {
    await sessionCall(req, res, async (req, res): Future<JsonObject | null> => {
      let authorization = req.getHeader('authorization');
      let input = await jsonBody(req, res);
      if (input == null) {
        return null;
      }
      if (!(input['collection'] is String) || !(input['rkey'] is String)) {
        fail(res, 400, 'InvalidRequest', 'repo, collection and rkey are required');
        return null;
      }
      let account = await writable(pds, sessions, authorization, input['repo'], REPO_DELETE_RECORD);
      let collection = input['collection'] as String;
      let rkey = input['rkey'] as String;
      // Deleting a record that is not there is done already, with no commit.
      let answer = new JsonObject();
      if ((await pds.storage.store(account.did).getRecord(collection, rkey)) != null) {
        let head = await pds.repositoryOf(account).applyWrites([new DeleteRecord(collection, rkey, swapCidOf(input))],
            nowMicros());
        answer['commit'] = commitJson(head);
      }
      return answer;
    });
  });

  router.post(xrpcPath(REPO_APPLY_WRITES), async (req, res, next, params) => {
    await sessionCall(req, res, async (req, res): Future<JsonObject | null> => {
      let authorization = req.getHeader('authorization');
      let input = await jsonBody(req, res);
      if (input == null) {
        return null;
      }
      let given = input['writes'];
      if (!(given is JsonArray)) {
        fail(res, 400, 'InvalidRequest', 'repo and writes are required');
        return null;
      }
      let list = given;
      if (list.length > MAX_WRITES) {
        fail(res, 400, 'InvalidRequest', `at most ${MAX_WRITES} writes are taken at once`);
        return null;
      }
      if (input['swapCommit'] != null) {
        fail(res, 400, 'InvalidRequest', 'swapCommit is not supported');
        return null;
      }
      let account = await writable(pds, sessions, authorization, input['repo'], REPO_APPLY_WRITES);
      let micros = nowMicros();
      let writes = new GrowableArray<Write>();
      for (var i = 0; i < list.length; i += 1) {
        writes.push(writeOf(pds, list[i], micros));
      }
      let head = await pds.repositoryOf(account).applyWrites(writes, micros);
      let results = new JsonArray();
      for (let write in writes) {
        results.push(resultOf(account, write));
      }
      let answer = new JsonObject();
      answer['commit'] = commitJson(head);
      answer['results'] = results;
      return answer;
    });
  });

  // Only managed accounts take blobs for now: an account's own uploads
  // would need the ones no record references collected, as the reference
  // PDS does. An App View's token names no account, so the upload names it in
  // `repo`, a parameter the lexicon does not have.
  router.post(xrpcPath(REPO_UPLOAD_BLOB), async (req, res, next, params) => {
    await sessionCall(req, res, async (req, res): Future<JsonObject | null> => {
      let given = required(req, res, ['repo']);
      if (given == null) {
        return null;
      }
      let named = await pds.findAccount(given[0]);
      if (named == null || named.manager == null) {
        fail(res, 403, 'Forbidden', 'only managed accounts take blobs here');
        return null;
      }
      let account = try {
        await writable(pds, sessions, req.getHeader('authorization'), named.did, REPO_UPLOAD_BLOB)
      } catch (e) {
        if (e is SessionError) {
          fail(res, e.status, e.error, e.message);
          return null;
        }
        throw e;
      };
      // Reading the body consumes the request: its type is read first, and
      // a managed account takes only the types its limits allow.
      let limits = pds.managedLimits;
      let mimeType = limits.blobType(req.getHeader('content-type') ?? 'application/octet-stream');
      if (mimeType == null) {
        fail(res, 400, 'InvalidRequest', `a managed account's blob is one of ${join(limits.blobTypes, ', ')}`);
        return null;
      }
      req.bodyLimit = limits.maxBlobSize;
      let bytes = try {
        await req.bytes()
      } catch (e) {
        if (e is HttpError && e.status == 413) {
          fail(res, 413, 'BlobTooLarge', `the blob is larger than ${limits.maxBlobSize} bytes`);
          return null;
        }
        throw e;
      };
      let cid = Cid.forBlob(bytes);
      await pds.storage.store(account.did).putBlob(cid, new StoredBlob(mimeType, bytes));
      let answer = new JsonObject();
      answer['blob'] = toJson(new BlobRef(cid, mimeType, bytes.length as i64).toValue());
      return answer;
    });
  });
}

/**
 * The account a write names as its `repo`, once `authorization` shows the
 * caller may write it: a managed account's App View, with a token for
 * `method` (`ManagedAccounts.fromAppView`), or the account itself, with a
 * session.
 */
async function writable(pds: Pds, sessions: Sessions | null, authorization: String | null, repo: JsonValue,
    method: String): Future<Account> {
  let named = if (repo is String) await pds.findAccount(repo) else null;
  if (named != null && named.manager != null) {
    let managed = pds.managed;
    if (managed == null) {
      throw new SessionError(403, 'Forbidden', `${named.did} takes writes only from its App View`);
    }
    await managed.fromAppView(authorization, named, method, nowSeconds());
    return named;
  }
  if (sessions == null) {
    throw new SessionError(403, 'Forbidden', 'this PDS takes writes only to managed accounts, from their App Views');
  }
  let caller = await sessions.authenticate(authorization, nowSeconds());
  if (named == null || named.did != caller.account.did) {
    throw new SessionError(403, 'Forbidden', `${caller.account.did} may write only its own repository`);
  }
  return named;
}

/**
 * The write one of `com.atproto.repo.applyWrites`'s `writes` asks for. A
 * create with no `rkey` gets a TID.
 */
function writeOf(pds: Pds, value: JsonValue, nowMicros: i64): Write {
  if (!(value is JsonObject)) {
    throw new SessionError(400, 'InvalidRequest', 'each write is an object');
  }
  let write = value;
  let given = write['$type'];
  let type = if (given is String) given else '';
  let collection = write['collection'];
  if (!(collection is String)) {
    throw new SessionError(400, 'InvalidRequest', 'each write names its collection');
  }
  let rkey = write['rkey'];
  if (type == 'com.atproto.repo.applyWrites#create') {
    return new CreateRecord(collection, if (rkey is String) rkey else pds.newRecordKey(nowMicros),
        recordOf(write));
  }
  if (!(rkey is String)) {
    throw new SessionError(400, 'InvalidRequest', 'an update or a delete names its rkey');
  }
  if (type == 'com.atproto.repo.applyWrites#update') {
    return new UpdateRecord(collection, rkey, recordOf(write), null);
  }
  if (type == 'com.atproto.repo.applyWrites#delete') {
    return new DeleteRecord(collection, rkey, null);
  }
  throw new SessionError(400, 'InvalidRequest', `'${type}' is not a write applyWrites takes`);
}

/** The record a create or an update writes, its `value`. */
function recordOf(write: JsonObject): MapValue {
  let record = fromJson(write['value']);
  if (!(record is MapValue)) {
    throw new SessionError(400, 'InvalidRequest', 'a create or an update has an object as its value');
  }
  return record;
}

/** A write's commit, as the write methods answer with it: its CID and revision. */
function commitJson(head: Head): JsonObject {
  let commit = new JsonObject();
  commit['cid'] = head.cid.toString();
  commit['rev'] = head.rev;
  return commit;
}

/** What `com.atproto.repo.applyWrites` answers for `write`. */
function resultOf(account: Account, write: Write): JsonObject {
  let result = new JsonObject();
  match (write) {
    case CreateRecord {collection, rkey, record}: {
      result['$type'] = 'com.atproto.repo.applyWrites#createResult';
      result['uri'] = `at://${account.did}/${collection}/${rkey}`;
      result['cid'] = cidForValue(record).toString();
    }
    case UpdateRecord {collection, rkey, record}: {
      result['$type'] = 'com.atproto.repo.applyWrites#updateResult';
      result['uri'] = `at://${account.did}/${collection}/${rkey}`;
      result['cid'] = cidForValue(record).toString();
    }
    case DeleteRecord {}: {
      result['$type'] = 'com.atproto.repo.applyWrites#deleteResult';
    }
  }
  return result;
}

/** The `swapRecord` CID a write gives, or null; one that is not a CID is refused. */
function swapCidOf(input: JsonObject): Cid | null {
  let swap = input['swapRecord'];
  if (!(swap is String)) {
    return null;
  }
  let cid = parseCid(swap);
  if (cid == null) {
    throw new SessionError(400, 'InvalidRequest', `swapRecord '${swap}' is not a CID`);
  }
  return cid;
}
