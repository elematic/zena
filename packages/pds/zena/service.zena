/**
 * The PDS as a server of its own, padstone: its configuration, read from
 * the environment by `configFromEnv`, and `buildPds`, which builds the
 * storage, the PDS and its sessions the configuration names. `main.zena`
 * serves it. An App View that runs a PDS in the same process builds it
 * here too, from the same variables (`registry/service`).
 *
 * The variables:
 *
 * - `PORT`: the port to listen on, 2583 by default.
 * - `PDS_STORAGE`: `memory` (the default), which forgets everything when
 *   the server stops, or `firestore`.
 * - With `firestore`:
 *   - `PDS_TENANT`, the tenant whose documents these are;
 *   - and either `PDS_BLOB_BUCKET`, the Cloud Storage bucket for blob bytes,
 *     or `PDS_BLOB_DIR`, a directory for them, for a server on one machine.
 *   - `PDS_FIRESTORE_DATABASE`, the database, `(default)` when unset.
 *   - `PDS_KEY_ENCRYPTION_KMS_KEY`, a Cloud KMS symmetric key,
 *     `projects/…/cryptoKeys/<key>`, that accounts' signing keys are
 *     encrypted with in Firestore (`pds/key-encryption`). Without it they
 *     are kept in the clear, and an encrypted one cannot be read.
 *   - The project and credentials come from `google-cloud/firestore`'s
 *     defaults, and `FIRESTORE_EMULATOR_HOST` points it at the emulator.
 * - `PDS_PUBLIC_URL`: the origin the accounts' DID documents name as
 *   their PDS, by default the server's own.
 * - `PDS_DID`: the PDS's DID, which the App Views' service-auth tokens are
 *   addressed to, by default the `did:web` of `PDS_PUBLIC_URL`'s host.
 * - `PDS_TRUSTED_APP_VIEWS`: the App Views the PDS keeps managed accounts
 *   for (`pds/managed`), separated by spaces, each `<did>=<did:key>`: its
 *   DID, and the online rotation key that signs its accounts' genesis
 *   operations. An App View with several keys is given once for each.
 *   None by default.
 * - `PDS_PLC_DIRECTORY`: where DIDs are resolved, and the managed
 *   accounts' operations read, `https://plc.directory` by default.
 * - `PDS_JWT_SECRET`: 32 bytes in hex, which signs the access and refresh
 *   tokens of sessions (`pds/sessions`). Required with `firestore`, since
 *   sessions outlive the server and every server of a deployment checks
 *   them. With `memory`, a missing secret is made up at start.
 * - `PDS_CLOCK_ID`: 0 to 1023, which keeps this server's revisions apart
 *   from another's made in the same microsecond. Random by default.
 */

import {Completer, Future} from 'zena:async';
import {HashMap} from 'zena:collections';
import {Unmanaged} from 'zena:core';
import {App, Server} from 'zena:http';
import {hex} from 'zena:encoding';
import {randomBytes, randomInt} from 'zena:random';
import {URL} from 'zena:url';
import {Firestore} from 'google-cloud/firestore';
import {CloudKms} from 'google-cloud/kms';
import {Storage as CloudStorage} from 'google-cloud/storage';
import {PublicKey, parseDidKey} from 'atproto/didkey';
import {IdentityResolver, didWebFor} from 'atproto/identity';
import {PlcOperation, fetchOperations} from 'atproto/plc';
import {SigningKeyLookup} from 'atproto/service-auth';
import {BlobBytes, CloudStorageBlobs, DirectoryBlobs, FirestoreCredentialStore, FirestoreStorage} from './firestore.zena';
import {KmsKeyEncryption} from './key-encryption.zena';
import {ManagedAccounts, PlcLogLookup, TrustedAppView} from './managed.zena';
import {Pds} from './pds.zena';
import {createApp} from './server.zena';
import {CredentialStore, MemoryCredentialStore, Sessions} from './sessions.zena';
import {MemoryStorage, Storage} from './storage.zena';

/** A configuration `configFromEnv` refuses, with every problem it found. */
export class ConfigError extends Error {
  new(message: String) : super(message);
}

/** Where the server keeps its data. */
export sealed class StorageChoice {
  case InMemory
  /**
   * Firestore, for `tenant`, in the database `database`, or the project's
   * default one when null, with blob bytes in `blobs`, and signing keys
   * encrypted with the Cloud KMS key `keyEncryptionKey`, or in the clear
   * when it is null.
   */
  case InFirestore(tenant: String, blobs: BlobChoice, database: String | null, keyEncryptionKey: String | null)
}

/** Where blob bytes go beside Firestore. */
export sealed class BlobChoice {
  case InBucket(bucket: String)
  case InDirectory(path: String)
}

/** What the PDS is to be. */
export final class PdsConfig {
  port: u16;
  storage: StorageChoice;
  /** The origin the accounts' DID documents name, or null for the server's own. */
  var publicUrl: String | null = null;
  /** The PDS's DID, or null for the `did:web` of its origin. */
  var did: String | null = null;
  /** The App Views it keeps managed accounts for. */
  var trustedAppViews: Array<TrustedAppView> = [];
  var plcDirectory = 'https://plc.directory';
  clockId: i32;
  /** The secret sessions' tokens are signed with, or null to make one up at start. */
  var jwtSecret: FixedArray<u8> | null = null;

  new(this.port, this.storage, this.clockId);
}

/** A built PDS, not yet listening: its application, the PDS, and its sessions. */
export final class PdsService {
  app: App;
  pds: Pds;
  sessions: Sessions;
  /** Its DID, which App Views' tokens are addressed to. */
  did: String;

  new(this.app, this.pds, this.sessions, this.did);
}

/**
 * The PDS's configuration the variables `env` gives (see the module
 * comment). Throws `ConfigError` naming every variable that is wrong.
 */
export function configFromEnv(env: (name: String) => String | null): PdsConfig {
  let problems = new GrowableArray<String>();
  let config = readPdsConfig(valuesOf(env), problems);
  refuseProblems(problems);
  return config;
}

/** `env`'s values, trimmed, with an empty one as none. */
export function valuesOf(env: (name: String) => String | null): (name: String) => String | null {
  return (name: String): String | null => {
    let text = env(name);
    return if (text == null || text.trim().length == 0) null else text.trim();
  };
}

/** Throws `ConfigError` listing `problems`, when there are any. */
export function refuseProblems(problems: Array<String>): void {
  if (problems.length == 0) {
    return;
  }
  var message = 'the configuration is not usable:';
  for (let problem in problems) {
    message = `${message}\n  ${problem}`;
  }
  throw new ConfigError(message);
}

/** The variables of the PDS's configuration, every one `readPdsConfig` reads but `PORT`. */
export let PDS_VARIABLES: Array<String> = [
  'PDS_STORAGE', 'PDS_TENANT', 'PDS_BLOB_BUCKET', 'PDS_BLOB_DIR', 'PDS_FIRESTORE_DATABASE', 'PDS_KEY_ENCRYPTION_KMS_KEY',
  'PDS_PUBLIC_URL', 'PDS_DID', 'PDS_TRUSTED_APP_VIEWS', 'PDS_PLC_DIRECTORY', 'PDS_JWT_SECRET', 'PDS_CLOCK_ID'
];

/** The port `PORT` gives, 2583 by default, with what is wrong with it added to `problems`. */
export function readPort(value: (name: String) => String | null, problems: GrowableArray<String>): u16 {
  let portText = value('PORT');
  if (portText == null) {
    return 2583 as u16;
  }
  if (let (true, parsed) = parseI32(portText)) {
    if (parsed >= 0 && parsed <= 65535) {
      return parsed as u16;
    }
    problems.push(`PORT is out of range: ${portText}`);
  } else {
    problems.push(`PORT is not a number: ${portText}`);
  }
  return 2583 as u16;
}

/**
 * The PDS's configuration the trimmed `value`s give, with what is wrong
 * with them added to `problems`.
 */
export function readPdsConfig(value: (name: String) => String | null, problems: GrowableArray<String>): PdsConfig {
  let port = readPort(value, problems);
  var storage: StorageChoice = new InMemory();
  let storageKind = value('PDS_STORAGE') ?? 'memory';
  let bucket = value('PDS_BLOB_BUCKET');
  let blobDir = value('PDS_BLOB_DIR');
  let keyEncryptionKey = value('PDS_KEY_ENCRYPTION_KMS_KEY');
  if (keyEncryptionKey != null && (!keyEncryptionKey.contains('/cryptoKeys/') ||
      keyEncryptionKey.contains('/cryptoKeyVersions/'))) {
    problems.push(`PDS_KEY_ENCRYPTION_KMS_KEY is a key, projects/…/cryptoKeys/<key>, not ${keyEncryptionKey}`);
  }
  if (storageKind == 'firestore') {
    let tenant = value('PDS_TENANT');
    if (tenant == null) {
      problems.push('PDS_STORAGE=firestore needs PDS_TENANT');
    }
    if (bucket != null && blobDir != null) {
      problems.push('give PDS_BLOB_BUCKET or PDS_BLOB_DIR, not both');
    } else if (bucket == null && blobDir == null) {
      problems.push('PDS_STORAGE=firestore needs PDS_BLOB_BUCKET or PDS_BLOB_DIR');
    }
    if (tenant != null && (bucket == null) != (blobDir == null)) {
      let blobs: BlobChoice = if (bucket != null) new InBucket(bucket) else new InDirectory(blobDir as String);
      storage = new InFirestore(tenant, blobs, value('PDS_FIRESTORE_DATABASE'), keyEncryptionKey);
    }
  } else if (storageKind == 'memory') {
    if (bucket != null || blobDir != null || value('PDS_FIRESTORE_DATABASE') != null) {
      problems.push('PDS_BLOB_BUCKET, PDS_BLOB_DIR and PDS_FIRESTORE_DATABASE need PDS_STORAGE=firestore');
    }
    if (keyEncryptionKey != null) {
      problems.push('PDS_KEY_ENCRYPTION_KMS_KEY needs PDS_STORAGE=firestore: memory keeps signing keys as they are');
    }
  } else {
    problems.push(`PDS_STORAGE is memory or firestore, not ${storageKind}`);
  }

  var clockId = randomInt(1024);
  let clockText = value('PDS_CLOCK_ID');
  if (clockText != null) {
    if (let (true, parsed) = parseI32(clockText)) {
      if (parsed >= 0 && parsed < 1024) {
        clockId = parsed;
      } else {
        problems.push(`PDS_CLOCK_ID is 0 to 1023, not ${clockText}`);
      }
    } else {
      problems.push(`PDS_CLOCK_ID is not a number: ${clockText}`);
    }
  }

  let config = new PdsConfig(port, storage, clockId);
  let publicUrl = value('PDS_PUBLIC_URL');
  if (publicUrl != null) {
    if (originOf(publicUrl) == null) {
      problems.push(`PDS_PUBLIC_URL is an origin, such as https://padstone.zena-lang.dev, not ${publicUrl}`);
    } else {
      config.publicUrl = publicUrl;
    }
  }
  let did = value('PDS_DID');
  if (did != null) {
    if (!did.startsWith('did:')) {
      problems.push(`PDS_DID is a DID, not ${did}`);
    } else {
      config.did = did;
    }
  }
  config.trustedAppViews = trustedAppViewsFrom(value('PDS_TRUSTED_APP_VIEWS'), problems);
  config.plcDirectory = value('PDS_PLC_DIRECTORY') ?? config.plcDirectory;
  let secretText = value('PDS_JWT_SECRET');
  if (secretText != null) {
    config.jwtSecret = decodeKey(secretText);
    if (config.jwtSecret == null) {
      problems.push('PDS_JWT_SECRET is not 32 bytes of hex');
    }
  } else if (storageKind == 'firestore') {
    problems.push('PDS_STORAGE=firestore needs PDS_JWT_SECRET');
  }
  return config;
}

/**
 * The trusted App Views `text` gives: `<did>=<did:key>` entries separated
 * by spaces, an App View's keys gathered from each entry that names it.
 */
function trustedAppViewsFrom(text: String | null, problems: GrowableArray<String>): Array<TrustedAppView> {
  let trusted = new GrowableArray<TrustedAppView>();
  if (text == null) {
    return trusted;
  }
  let keys = new HashMap<String, GrowableArray<PublicKey>>();
  let order = new GrowableArray<String>();
  for (let entry in text.split(' ')) {
    if (entry.length == 0) {
      continue;
    }
    let parts = entry.split('=');
    if (parts.length != 2 || !parts[0].startsWith('did:')) {
      problems.push(`PDS_TRUSTED_APP_VIEWS has '${entry}', which is not <did>=<did:key>`);
      continue;
    }
    var key: PublicKey | null = null;
    try {
      key = parseDidKey(parts[1]);
    } catch (e) {
      problems.push(`PDS_TRUSTED_APP_VIEWS gives ${parts[0]} '${parts[1]}', which is not a did:key`);
      continue;
    }
    if (!keys.has(parts[0])) {
      keys[parts[0]] = new GrowableArray<PublicKey>();
      order.push(parts[0]);
    }
    keys[parts[0]].push(key);
  }
  for (let did in order) {
    trusted.push(new TrustedAppView(did, keys[did]));
  }
  return trusted;
}

/** The 32 bytes `text` spells in hex, or null. */
export function decodeKey(text: String): FixedArray<u8> | null {
  if (text.length != 64) {
    return null;
  }
  try {
    return hex.decode(text);
  } catch (e) {
    return null;
  }
}

/**
 * `text` as an `http` or `https` origin, such as `https://pkg.zena-lang.dev`,
 * or null when it is not one: a URL with a path, a query or credentials.
 */
export function originOf(text: String): URL | null {
  let url = URL.parse(text);
  if (url == null) {
    return null;
  }
  let parsed = url;
  let web = parsed.protocol == 'https:' || parsed.protocol == 'http:';
  let bare = parsed.pathname == '/' && parsed.search == '' && parsed.hash == '' && parsed.username == '' &&
      parsed.password == '';
  return if (web && bare) parsed else null;
}

/** The `did:web` of the server at `origin`, with its port, if it has one, percent-encoded. */
export function didWebOfOrigin(origin: String): String {
  let url = URL.parse(origin);
  if (url == null) {
    throw new Error(`not a URL: ${origin}`);
  }
  let parsed = url;
  return didWebFor(if (parsed.port == '') parsed.hostname else `${parsed.hostname}:${parsed.port}`);
}

/**
 * The PDS `config` describes, not yet listening, with `endpoint` as its
 * origin when the configuration leaves it to the server. It keeps managed
 * accounts for `config`'s trusted App Views and for `also`, reading their
 * DIDs' operations with `operations` and the signing keys of their tokens'
 * issuers with `keys`, or else from `config`'s PLC directory.
 */
export async function buildPds(config: PdsConfig, endpoint: String, also: Array<TrustedAppView> = [],
    operations: PlcLogLookup | null = null, keys: SigningKeyLookup | null = null): Future<PdsService> {
  var storage: Storage = new MemoryStorage();
  var credentials: CredentialStore = new MemoryCredentialStore();
  match (config.storage) {
    case InMemory {}: {}
    case InFirestore {tenant, blobs, database, keyEncryptionKey}: {
      let db = if (database != null) await Firestore.connect({databaseId: database}) else await Firestore.connect();
      let encryption = if (keyEncryptionKey != null) new KmsKeyEncryption(CloudKms.connect(keyEncryptionKey)) else null;
      storage = new FirestoreStorage(db, tenant, blobBytes(blobs), encryption);
      credentials = new FirestoreCredentialStore(db, tenant);
    }
  }
  let pds = new Pds(storage, config.clockId);
  let sessions = new Sessions(storage, credentials, config.jwtSecret ?? randomBytes(32),
      (count: i32) => randomBytes(count));
  let origin = config.publicUrl ?? endpoint;
  let did = config.did ?? didWebOfOrigin(origin);
  pds.did = did;
  let trusted = new GrowableArray<TrustedAppView>();
  for (let appView in config.trustedAppViews) {
    trusted.push(appView);
  }
  for (let appView in also) {
    trusted.push(appView);
  }
  if (trusted.length > 0) {
    let plcDirectory = config.plcDirectory;
    let resolver = new IdentityResolver();
    resolver.plcDirectory = plcDirectory;
    let lookup = operations ?? (async (subject: String): Future<Array<PlcOperation>> =>
        await fetchOperations(plcDirectory, subject));
    pds.managed = new ManagedAccounts(did, origin, trusted, lookup, keys ?? resolver.signingKeys());
  }
  return new PdsService(createApp(pds, sessions), pds, sessions, did);
}

/** Where `choice` keeps bytes: a Cloud Storage bucket, or a directory. */
export function blobBytes(choice: BlobChoice): BlobBytes {
  return match (choice) {
    case InBucket {bucket}: new CloudStorageBlobs(CloudStorage.connect().bucket(bucket)) as BlobBytes
    case InDirectory {path}: new DirectoryBlobs(path) as BlobBytes
  };
}

/** A listening server, and the origin it listens on, `http://127.0.0.1:<port>`. */
export final class Listening {
  /** Kept open: it runs until `close()`, or until its scope is cancelled. */
  server: Unmanaged<Server>;
  origin: String;

  new(this.server, this.origin);
}

/**
 * Listens on `port`, and serves the application `build` makes, given the
 * listening origin, which a configuration may leave to the server. A
 * request that comes while it is built waits for it, since Cloud Run sends
 * a new instance its first request as soon as it listens; if the build
 * fails, those requests are answered 503, and the server closes.
 */
export async function listen(port: u16, build: (origin: String) => Future<App>): Future<Listening> {
  var inner: App | null = null;
  var starting = true;
  let waiting = new GrowableArray<Completer<void>>();
  let outer = new App();
  outer.use(async (req, res, next): Future<void> => {
    if (starting) {
      let ready = new Completer<void>();
      waiting.push(ready);
      await ready.future;
    }
    let app = inner;
    if (app == null) {
      res.statusCode = 503;
      res.type = 'application/json';
      res.body = '{"error": "Unavailable", "message": "the server could not start"}';
      return;
    }
    await app.handleRequest(req, res);
  });
  let server = new Server(outer, port);
  server.start();
  let origin = `http://127.0.0.1:${server.port as i32}`;
  // Held until the application is built: a failure closes the server.
  try {
    inner = await build(origin);
  } finally {
    starting = false;
    for (let ready in waiting) {
      ready.complete();
    }
  }
  return new Listening(server.keepOpen(), origin);
}

/** A listening PDS. */
export final class RunningPds {
  listening: Listening;
  service: PdsService;

  new(this.listening, this.service);
}

/** Builds the PDS `config` describes and listens on its port. */
export async function serve(config: PdsConfig): Future<RunningPds> {
  var built: PdsService | null = null;
  let listening = await listen(config.port, async (origin): Future<App> => {
    let service = await buildPds(config, origin);
    built = service;
    return service.app;
  });
  return new RunningPds(listening, built as PdsService);
}
