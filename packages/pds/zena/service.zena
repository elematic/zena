/**
 * The PDS as a server: its configuration, read from the environment by
 * `configFromEnv`, and `serve`, which builds the storage, the PDS and the
 * package host the configuration names and listens. `main.zena` is the
 * two together.
 *
 * The variables:
 *
 * - `PORT`: the port to listen on, 2583 by default.
 * - `PDS_STORAGE`: `memory` (the default), which forgets everything when
 *   the server stops, or `firestore`.
 * - With `firestore`:
 *   - `PDS_TENANT`, the tenant whose documents these are;
 *   - and either `PDS_BLOB_BUCKET`, the Cloud Storage bucket for blob bytes,
 *     or `PDS_BLOB_DIR`, a directory for them, for a server on one machine.
 *   - `PDS_FIRESTORE_DATABASE`, the database, `(default)` when unset.
 *   - The project and credentials come from `google-cloud:firestore`'s
 *     defaults, and `FIRESTORE_EMULATOR_HOST` points it at the emulator.
 * - `PDS_HOST_DOMAIN`: the package host's domain, such as
 *   `pkg.zena-lang.dev`. Without it the server is a PDS with no package
 *   host. With it:
 *   - `PDS_ROTATION_KEY`: the host's online PLC rotation key, a secp256k1
 *     private key in hex; or `PDS_ROTATION_KMS_KEY`, a Cloud KMS key
 *     version, `projects/…/cryptoKeyVersions/<n>`, on secp256k1 or P-256,
 *     which signs without the key leaving Cloud KMS (`pds:rotation`). One
 *     of them is required with `firestore`, since the accounts it creates
 *     outlive the server. With `memory`, a missing key is made up at start.
 *   - `PDS_OFFLINE_ROTATION_KEY`: the operator's offline rotation key, as
 *     a `did:key`, which every new account ranks above the online key, so
 *     that the operator can undo what a stolen online key signs.
 *   - `PDS_SERVICE_DID`: the host's DID, `did:web:<domain>` by default.
 *   - `PDS_PUBLIC_URL`: the origin the accounts' DID documents name as
 *     their PDS, `https://<domain>` by default.
 *   - `PDS_ADMIN_DIDS`: the DIDs of the host's admins, separated by commas
 *     or spaces, who sign in to the web app as themselves and may see every
 *     account the host holds and every private entry. `deploy.sh` passes
 *     spaces, since `gcloud --set-env-vars` splits on commas.
 *   - `PDS_RESERVED_SCOPES`: scope names no one may take, comma-separated,
 *     beside the host's own.
 *   - `PDS_MAX_BLOB_BYTES`: the largest artifact the host stores.
 *   - `PDS_HANDLE_RECORDS`: where the host writes its handles' DNS records
 *     (`pds:handles`): `cloud-dns`, a Cloud DNS managed zone, or `memory`,
 *     for local runs. `memory` by default, but required with `firestore`,
 *     so that no deployment keeps them in memory by leaving it out. With
 *     `cloud-dns`, `PDS_DNS_ZONE` names the zone, and `PDS_DNS_PROJECT`
 *     its project, by default the one the server runs in.
 * - `PDS_PLC_DIRECTORY` and `PDS_DNS_OVER_HTTPS`: where DIDs and handles
 *   are resolved, `https://plc.directory` and Cloudflare's resolver by
 *   default.
 * - `PDS_PLC`: `public` (the default), where the host sends the operations
 *   of the accounts it makes to `PDS_PLC_DIRECTORY`; or `staging`, where
 *   the server is a PLC directory itself, at `/plc` (`pds:plc-directory`),
 *   that records them in its storage and reads every other DID from
 *   `PDS_PLC_DIRECTORY`, so nothing a staging host makes reaches it.
 * - `PDS_JWT_SECRET`: 32 bytes in hex, which signs the access and refresh
 *   tokens of sessions (`pds:sessions`). Required with `firestore`, since
 *   sessions outlive the server and every server of a deployment checks
 *   them. With `memory`, a missing secret is made up at start.
 * - `PDS_WEB_DIR`: the directory of the web app's assets
 *   (`packages/pds-web`'s build), which the server serves at `/assets/`.
 *   A package host renders its pages (`pds:web/routes`) with or without
 *   it, but unstyled without; a PDS with no host answers `/` with its
 *   banner.
 * - `PDS_CLOCK_ID`: 0 to 1023, which keeps this server's revisions apart
 *   from another's made in the same microsecond. Random by default.
 */

import {Future} from 'zena:async';
import {Option, Some, none, some} from 'zena:core';
import {App, Server, mount, serve as serveFiles} from 'zena:http';
import {hex} from 'zena:encoding';
import {randomBytes, randomInt} from 'zena:random';
import {defaultProjectId} from 'google-cloud:auth';
import {CloudDns} from 'google-cloud:dns';
import {Firestore} from 'google-cloud:firestore';
import {Storage as CloudStorage} from 'google-cloud:storage';
import {KeyType} from 'atproto:didkey';
import {IdentityResolver} from 'atproto:identity';
import {PlcOperation, submitPlcOperation} from 'atproto:plc';
import {
  BlobBytes, CloudStorageBlobs, DirectoryBlobs, FirestoreCredentialStore, FirestoreHostStore, FirestorePlcLog,
  FirestoreStorage
} from './firestore.zena';
import {parseDidDocument} from 'atproto:did';
import {PublicKey, parseDidKey} from 'atproto:didkey';
import {SigningKeyLookup} from 'atproto:service-auth';
import {CloudDnsRecords, HandleRecords, MemoryHandleRecords} from './handles.zena';
import {MemoryPlcLog, PlcDirectory, PlcLog} from './plc-directory.zena';
import {HostConfig, HostStore, MemoryHostStore, PackageHost} from './host.zena';
import {Pds} from './pds.zena';
import {createApp} from './server.zena';
import {CredentialStore, MemoryCredentialStore, Sessions} from './sessions.zena';
import {KmsRotationKey, LocalRotationKey, RotationKey} from './rotation.zena';
import {CloudKms} from 'google-cloud:kms';
import {MemoryStorage, SigningKey, Storage} from './storage.zena';

/** A configuration `configFromEnv` refuses, with every problem it found. */
export class ConfigError extends Error {
  new(message: String) : super(message);
}

/** Where the server keeps its data. */
export sealed class StorageChoice {
  case InMemory
  /**
   * Firestore, for `tenant`, in the database `database`, or the project's
   * default one when null, with blob bytes in `blobs`.
   */
  case InFirestore(tenant: String, blobs: BlobChoice, database: String | null)
}

/** Where blob bytes go beside Firestore. */
export sealed class BlobChoice {
  case InBucket(bucket: String)
  case InDirectory(path: String)
}

/** Where the package host writes its handles' DNS records. */
export sealed class RecordsChoice {
  case RecordsInMemory
  /** A Cloud DNS managed zone, of `project`, or the server's own when null. */
  case InCloudDns(project: String | null, zone: String)
}

/** The package host's settings. */
export final class HostSettings {
  domain: String;
  serviceDid: String;
  /** The accounts' PDS endpoint, or null for the server's own origin. */
  publicUrl: String | null;
  /** The host's PLC rotation key, or null to make one up at start. */
  rotationKey: SigningKey | null;
  /** The Cloud KMS key version of the online rotation key, in place of `rotationKey`. */
  var rotationKmsKey: String | null = null;
  /** The operator's offline rotation key. */
  var offlineRotationKey: PublicKey | null = null;
  reservedScopes: Array<String>;
  /** The DIDs of the host's admins. */
  var admins: Array<String> = [];
  /** The largest artifact the host stores, or none for the host's default. */
  maxBlobSize: Option<i64>;
  records: RecordsChoice;

  new(this.domain, this.serviceDid, this.publicUrl, this.rotationKey, this.reservedScopes, this.maxBlobSize,
      this.records);
}

/** What the server is to be. */
export final class ServiceConfig {
  port: u16;
  storage: StorageChoice;
  host: HostSettings | null;
  plcDirectory: String;
  dnsOverHttps: String;
  clockId: i32;
  /**
   * Whether the server is a staging PLC directory itself, reading the DIDs
   * it has not recorded from `plcDirectory` (`PDS_PLC=staging`).
   */
  var plcStaging: boolean = false;
  /** The secret sessions' tokens are signed with, or null to make one up at start. */
  var jwtSecret: FixedArray<u8> | null = null;
  /** The web app's directory, or null to serve none. */
  var webDir: String | null = null;

  new(this.port, this.storage, this.host, this.plcDirectory, this.dnsOverHttps, this.clockId);
}

/**
 * A built server, not yet listening: its application, PDS and host, where
 * the host writes its handles' DNS records, and the staging PLC directory
 * it is, if it is one.
 */
export final class Service {
  app: App;
  pds: Pds;
  host: PackageHost | null;
  records: HandleRecords;
  plc: PlcDirectory | null;
  sessions: Sessions;

  new(this.app, this.pds, this.host, this.records, this.plc, this.sessions);
}

/**
 * The configuration the variables `env` gives (see the module comment).
 * Throws `ConfigError` naming every variable that is wrong.
 */
export function configFromEnv(env: (name: String) => String | null): ServiceConfig {
  let problems = new GrowableArray<String>();
  let value = (name: String): String | null => {
    let text = env(name);
    return if (text == null || text.trim().length == 0) null else text.trim();
  };

  var port = 2583 as u16;
  let portText = value('PORT');
  if (portText != null) {
    if (let (true, parsed) = parseI32(portText)) {
      if (parsed >= 0 && parsed <= 65535) {
        port = parsed as u16;
      } else {
        problems.push(`PORT is out of range: ${portText}`);
      }
    } else {
      problems.push(`PORT is not a number: ${portText}`);
    }
  }

  var storage: StorageChoice = new InMemory();
  let storageKind = value('PDS_STORAGE') ?? 'memory';
  let bucket = value('PDS_BLOB_BUCKET');
  let blobDir = value('PDS_BLOB_DIR');
  if (storageKind == 'firestore') {
    let tenant = value('PDS_TENANT');
    if (tenant == null) {
      problems.push('PDS_STORAGE=firestore needs PDS_TENANT');
    }
    if (bucket != null && blobDir != null) {
      problems.push('give PDS_BLOB_BUCKET or PDS_BLOB_DIR, not both');
    } else if (bucket == null && blobDir == null) {
      problems.push('PDS_STORAGE=firestore needs PDS_BLOB_BUCKET or PDS_BLOB_DIR');
    }
    if (tenant != null && (bucket == null) != (blobDir == null)) {
      let blobs: BlobChoice = if (bucket != null) new InBucket(bucket as String) else new InDirectory(blobDir as String);
      storage = new InFirestore(tenant as String, blobs, value('PDS_FIRESTORE_DATABASE'));
    }
  } else if (storageKind == 'memory') {
    if (bucket != null || blobDir != null || value('PDS_FIRESTORE_DATABASE') != null) {
      problems.push('PDS_BLOB_BUCKET, PDS_BLOB_DIR and PDS_FIRESTORE_DATABASE need PDS_STORAGE=firestore');
    }
  } else {
    problems.push(`PDS_STORAGE is memory or firestore, not ${storageKind}`);
  }

  var host: HostSettings | null = null;
  let domain = value('PDS_HOST_DOMAIN');
  if (domain != null) {
    var rotationKey: SigningKey | null = null;
    let keyText = value('PDS_ROTATION_KEY');
    if (keyText != null) {
      let bytes = decodeKey(keyText);
      if (bytes == null) {
        problems.push('PDS_ROTATION_KEY is not 32 bytes of hex');
      } else {
        rotationKey = new SigningKey(KeyType.Secp256k1, bytes as FixedArray<u8>);
      }
    }
    let kmsKey = value('PDS_ROTATION_KMS_KEY');
    if (keyText != null && kmsKey != null) {
      problems.push('give PDS_ROTATION_KEY or PDS_ROTATION_KMS_KEY, not both');
    } else if (keyText == null && kmsKey == null && storageKind == 'firestore') {
      problems.push('PDS_HOST_DOMAIN with PDS_STORAGE=firestore needs PDS_ROTATION_KEY or PDS_ROTATION_KMS_KEY');
    }
    if (kmsKey != null && !(kmsKey as String).contains('/cryptoKeyVersions/')) {
      problems.push(`PDS_ROTATION_KMS_KEY is a key version, projects/…/cryptoKeyVersions/<n>, not ${kmsKey as String}`);
    }
    var offlineKey: PublicKey | null = null;
    let offlineText = value('PDS_OFFLINE_ROTATION_KEY');
    if (offlineText != null) {
      try {
        offlineKey = parseDidKey(offlineText as String);
      } catch (e) {
        problems.push('PDS_OFFLINE_ROTATION_KEY is not a did:key');
      }
    }
    var maxBlobSize: Option<i64> = none;
    let maxText = value('PDS_MAX_BLOB_BYTES');
    if (maxText != null) {
      if (let (true, parsed) = parseI32(maxText)) {
        if (parsed > 0) {
          maxBlobSize = some(parsed as i64);
        } else {
          problems.push(`PDS_MAX_BLOB_BYTES must be positive: ${maxText}`);
        }
      } else {
        problems.push(`PDS_MAX_BLOB_BYTES is not a number: ${maxText}`);
      }
    }
    let reserved = new GrowableArray<String>();
    let reservedText = value('PDS_RESERVED_SCOPES');
    if (reservedText != null) {
      for (let name in reservedText.split(',')) {
        let trimmed = name.trim();
        if (trimmed.length > 0) {
          reserved.push(trimmed);
        }
      }
    }
    let admins = new GrowableArray<String>();
    let adminText = value('PDS_ADMIN_DIDS');
    if (adminText != null) {
      for (let part in adminText.split(',')) {
        for (let did in part.split(' ')) {
          let trimmed = did.trim();
          if (trimmed.length == 0) {
            continue;
          }
          if (!trimmed.startsWith('did:')) {
            problems.push(`PDS_ADMIN_DIDS has '${trimmed}', which is not a DID`);
          }
          admins.push(trimmed);
        }
      }
    }
    var records: RecordsChoice = new RecordsInMemory();
    let recordsKind = value('PDS_HANDLE_RECORDS');
    let zone = value('PDS_DNS_ZONE');
    let project = value('PDS_DNS_PROJECT');
    if (recordsKind == 'cloud-dns') {
      if (zone == null) {
        problems.push('PDS_HANDLE_RECORDS=cloud-dns needs PDS_DNS_ZONE');
      } else {
        records = new InCloudDns(project, zone as String);
      }
    } else if (recordsKind == null || recordsKind == 'memory') {
      if (recordsKind == null && storageKind == 'firestore') {
        problems.push('PDS_HOST_DOMAIN with PDS_STORAGE=firestore needs PDS_HANDLE_RECORDS: cloud-dns, or memory');
      }
      if (zone != null || project != null) {
        problems.push('PDS_DNS_ZONE and PDS_DNS_PROJECT need PDS_HANDLE_RECORDS=cloud-dns');
      }
    } else {
      problems.push(`PDS_HANDLE_RECORDS is cloud-dns or memory, not ${recordsKind}`);
    }
    let settings = new HostSettings(domain as String, value('PDS_SERVICE_DID') ?? `did:web:${domain}`,
        value('PDS_PUBLIC_URL') ?? `https://${domain}`, rotationKey, reserved, maxBlobSize, records);
    settings.rotationKmsKey = kmsKey;
    settings.admins = admins;
    settings.offlineRotationKey = offlineKey;
    host = settings;
  } else {
    for (let name in ['PDS_ROTATION_KEY', 'PDS_ROTATION_KMS_KEY', 'PDS_OFFLINE_ROTATION_KEY', 'PDS_SERVICE_DID',
        'PDS_PUBLIC_URL', 'PDS_RESERVED_SCOPES', 'PDS_ADMIN_DIDS',
        'PDS_MAX_BLOB_BYTES', 'PDS_HANDLE_RECORDS', 'PDS_DNS_ZONE', 'PDS_DNS_PROJECT']) {
      if (value(name) != null) {
        problems.push(`${name} needs PDS_HOST_DOMAIN`);
      }
    }
  }

  var jwtSecret: FixedArray<u8> | null = null;
  let secretText = value('PDS_JWT_SECRET');
  if (secretText != null) {
    jwtSecret = decodeKey(secretText);
    if (jwtSecret == null) {
      problems.push('PDS_JWT_SECRET is not 32 bytes of hex');
    }
  } else if (storageKind == 'firestore') {
    problems.push('PDS_STORAGE=firestore needs PDS_JWT_SECRET');
  }

  var clockId = randomInt(1024);
  let clockText = value('PDS_CLOCK_ID');
  if (clockText != null) {
    if (let (true, parsed) = parseI32(clockText)) {
      if (parsed >= 0 && parsed < 1024) {
        clockId = parsed;
      } else {
        problems.push(`PDS_CLOCK_ID is 0 to 1023, not ${clockText}`);
      }
    } else {
      problems.push(`PDS_CLOCK_ID is not a number: ${clockText}`);
    }
  }

  var plcStaging = false;
  let plcMode = value('PDS_PLC') ?? 'public';
  if (plcMode == 'staging') {
    plcStaging = true;
  } else if (plcMode != 'public') {
    problems.push(`PDS_PLC is public or staging, not ${plcMode}`);
  }

  if (problems.length > 0) {
    var message = 'the configuration is not usable:';
    for (let problem in problems) {
      message = `${message}\n  ${problem}`;
    }
    throw new ConfigError(message);
  }
  let config = new ServiceConfig(port, storage, host, value('PDS_PLC_DIRECTORY') ?? 'https://plc.directory',
      value('PDS_DNS_OVER_HTTPS') ?? 'https://cloudflare-dns.com/dns-query', clockId);
  config.plcStaging = plcStaging;
  config.jwtSecret = jwtSecret;
  config.webDir = value('PDS_WEB_DIR');
  return config;
}

/** The 32 bytes `text` spells in hex, or null. */
function decodeKey(text: String): FixedArray<u8> | null {
  if (text.length != 64) {
    return null;
  }
  try {
    return hex.decode(text);
  } catch (e) {
    return null;
  }
}

/**
 * The server `config` describes, not yet listening, with `endpoint` as
 * the package host's PDS endpoint when the configuration leaves it to the
 * server.
 */
export async function buildService(config: ServiceConfig, endpoint: String): Future<Service> {
  var storage: Storage = new MemoryStorage();
  var hostStore: HostStore = new MemoryHostStore();
  var plcLog: PlcLog = new MemoryPlcLog();
  var credentials: CredentialStore = new MemoryCredentialStore();
  match (config.storage) {
    case InMemory {}: {}
    case InFirestore {tenant, blobs, database}: {
      let db = if (database != null) await Firestore.connect({databaseId: database}) else await Firestore.connect();
      storage = new FirestoreStorage(db, tenant, blobBytes(blobs));
      hostStore = new FirestoreHostStore(db, tenant);
      plcLog = new FirestorePlcLog(db, tenant);
      credentials = new FirestoreCredentialStore(db, tenant);
    }
  }
  let plc = if (config.plcStaging) new PlcDirectory(plcLog, config.plcDirectory) else null;
  let pds = new Pds(storage, config.clockId);
  let sessions = new Sessions(storage, credentials, config.jwtSecret ?? randomBytes(32),
      (count: i32) => randomBytes(count));
  let settings = config.host;
  if (settings == null) {
    return new Service(withAssets(withPlc(createApp(pds, null, sessions), plc), config.webDir), pds, null,
        new MemoryHandleRecords(), plc, sessions);
  }
  var records: HandleRecords = new MemoryHandleRecords();
  match (settings.records) {
    case RecordsInMemory {}: {}
    case InCloudDns {project, zone}: {
      let dnsProject = project ?? await defaultProjectId();
      records = new CloudDnsRecords(CloudDns.connect(dnsProject, zone));
    }
  }
  let kmsKey = settings.rotationKmsKey;
  let rotationKey: RotationKey = if (kmsKey != null) await KmsRotationKey.connect(CloudKms.connect(kmsKey as String))
      else new LocalRotationKey(settings.rotationKey ?? new SigningKey(KeyType.Secp256k1, randomBytes(32)));
  let hostConfig = new HostConfig(settings.serviceDid, settings.domain, settings.publicUrl ?? endpoint, rotationKey);
  hostConfig.offlineRotationKey = settings.offlineRotationKey;
  for (let did in settings.admins) {
    hostConfig.admins.add(did);
  }
  for (let name in settings.reservedScopes) {
    hostConfig.reservedScopes.add(name);
  }
  if (let Some {value} = settings.maxBlobSize) {
    hostConfig.maxBlobSize = value;
  }
  let resolver = new IdentityResolver();
  resolver.plcDirectory = config.plcDirectory;
  resolver.dnsOverHttps = config.dnsOverHttps;
  let upstream = config.plcDirectory;
  var keys = resolver.signingKeys();
  var submit = async (did: String, operation: PlcOperation): Future<void> => {
    await submitPlcOperation(upstream, did, operation);
  };
  // A release's dependencies are resolved as a fetch of it would resolve
  // them: a staging host's through its own directory, since they are its.
  var dependencies = resolver;
  if (plc != null) {
    keys = keysThrough(plc, keys);
    submit = async (did: String, operation: PlcOperation): Future<void> => {
      await plc.submit(did, operation);
    };
    dependencies = new IdentityResolver();
    dependencies.plcDirectory = `${hostConfig.endpoint}/plc`;
    dependencies.dnsOverHttps = config.dnsOverHttps;
  }
  let host = new PackageHost(pds, hostConfig, hostStore, records, keys, submit, (count: i32) => randomBytes(count),
      dependencies);
  host.sessions = sessions;
  return new Service(withAssets(withPlc(createApp(pds, host, sessions), plc), config.webDir), pds, host, records, plc,
      sessions);
}

/**
 * `app`, with the web app's assets in `dir`, when there is one, at
 * `/assets/`: the stylesheet and script its pages load. The pages
 * themselves are `app`'s (`pds:web/routes`).
 */
function withAssets(app: App, dir: String | null): App {
  if (dir == null) {
    return app;
  }
  let both = new App();
  both.use(mount('/assets', serveFiles(dir as String)));
  both.use(async (req, res, next): Future<void> => {
    await app.handleRequest(req, res);
  });
  return both;
}

/** `app`, with `/plc/` answered by `plc` when there is one. */
function withPlc(app: App, plc: PlcDirectory | null): App {
  if (plc == null) {
    return app;
  }
  let directory = plc.app();
  let both = new App();
  both.use(async (req, res, next): Future<void> => {
    if (req.path.startsWith('/plc/')) {
      await directory.handleRequest(req, res);
    } else {
      await app.handleRequest(req, res);
    }
  });
  return both;
}

/**
 * Signing keys for service auth that resolve a `did:plc` through `plc`,
 * which reads the DIDs it has not recorded from upstream, and any other
 * DID with `others`.
 */
function keysThrough(plc: PlcDirectory, others: SigningKeyLookup): SigningKeyLookup {
  return async (did: String, fresh: boolean): Future<PublicKey | null> => {
    if (!did.startsWith('did:plc:')) {
      return await others(did, fresh);
    }
    let document = await plc.document(did);
    return if (document == null) null else parseDidDocument(document, did).signingKey;
  };
}

function blobBytes(choice: BlobChoice): BlobBytes {
  return match (choice) {
    case InBucket {bucket}: new CloudStorageBlobs(CloudStorage.connect().bucket(bucket)) as BlobBytes
    case InDirectory {path}: new DirectoryBlobs(path) as BlobBytes
  };
}

/** A listening server, and the service it serves. */
export final class Running {
  server: Server;
  service: Service;
  /** The origin it listens on, `http://127.0.0.1:<port>`. */
  origin: String;

  new(this.server, this.service, this.origin);
}

/**
 * Builds the server `config` describes and listens on its port. When the
 * configuration leaves the host's endpoint to the server, it is the
 * listening origin, known once the port is: the application then serves
 * through one built after it listens.
 */
export async function serve(config: ServiceConfig): Future<Running> {
  var inner: App | null = null;
  let outer = new App();
  outer.use(async (req, res, next): Future<void> => {
    let app = inner;
    if (app == null) {
      res.statusCode = 503;
      res.type = 'application/json';
      res.body = '{"error": "Unavailable", "message": "the server is starting"}';
      return;
    }
    await app.handleRequest(req, res);
  });
  let server = new Server(outer, config.port);
  server.start();
  let origin = `http://127.0.0.1:${server.port as i32}`;
  let service = await buildService(config, origin);
  inner = service.app;
  return new Running(server, service, origin);
}
