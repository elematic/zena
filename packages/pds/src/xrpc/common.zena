/**
 * What every XRPC route builds from: errors and JSON answers, required
 * query parameters and JSON bodies, the account a request names, and the
 * clock. pds.js keeps these in `packages/core/src/handlers/` beside each
 * handler; here they are shared.
 */

import {Future} from 'zena:async';
import {Borrow, Own} from 'zena:core';
import {HttpError, Request, Response} from 'zena:http';
import {JsonArray, JsonObject, parseJson, stringify} from 'zena:json';
import {div} from 'zena:math';
import {now} from 'wasi:clocks/system-clock';
import {Cid} from 'atproto/cid';
import {isValidDid, isValidHandle, isValidNsid, isValidRecordKey} from 'atproto/syntax';
import {Pds} from '../pds.zena';
import {RepositoryError} from '../repository.zena';
import {SessionError} from '../sessions.zena';
import {Account} from '../storage.zena';

/**
 * The most bytes of a request body the server reads, unless a method that
 * takes more (`uploadArtifact`) raises its own: a session or a record is
 * far smaller, and a body read before authentication must not fill memory.
 */
export let REQUEST_BODY_LIMIT = (1024 * 1024) as i64;

/** Answers `res` with the XRPC error `error`. */
export function fail(res: Response, status: i32, error: String, message: String): void {
  res.statusCode = status;
  res.type = 'application/json';
  let body = new JsonObject();
  body['error'] = error;
  body['message'] = message;
  res.body = stringify(body);
}

/** Answers `res` with `body`. */
export function json(res: Response, body: JsonObject): void {
  res.type = 'application/json';
  res.body = stringify(body);
}

/**
 * The query parameters `names`, all of them present and not empty; null,
 * after answering `InvalidRequest`, when one is missing.
 */
export function required(req: Borrow<Request>, res: Response, names: Array<String>): GrowableArray<String> | null {
  let params = req.url.searchParams();
  let values = new GrowableArray<String>();
  for (let name in names) {
    let value = params.get(name);
    if (value == null || value == '') {
      fail(res, 400, 'InvalidRequest', `Missing required parameter: ${name}`);
      return null;
    }
    values.push(value);
  }
  return values;
}

/** `text` as a CID, or null when it is not one. */
export function parseCid(text: String): Cid | null {
  try {
    return Cid.parse(text);
  } catch (e) {
    return null;
  }
}

/**
 * The account `identifier` names; null, after answering, when it is not a
 * DID or a handle (`InvalidRequest`) or names no account (`RepoNotFound`).
 */
export async function accountFor(pds: Pds, identifier: String, res: Response): Future<Account | null> {
  if (!isValidDid(identifier) && !isValidHandle(identifier)) {
    fail(res, 400, 'InvalidRequest', `'${identifier}' is not a DID or a handle`);
    return null;
  }
  let account = await pds.findAccount(identifier);
  if (account == null) {
    fail(res, 404, 'RepoNotFound', `Could not find repo: ${identifier}`);
  }
  return account;
}

/**
 * Whether `collection` is an NSID, and `rkey`, when given, a record key;
 * when not, after answering `InvalidRequest`. Storage reads from where
 * they name, so one that is neither would name somewhere else.
 */
export function validRecordPath(res: Response, collection: String, rkey: String | null): boolean {
  if (!isValidNsid(collection)) {
    fail(res, 400, 'InvalidRequest', `'${collection}' is not an NSID`);
    return false;
  }
  if (rkey != null && !isValidRecordKey(rkey)) {
    fail(res, 400, 'InvalidRequest', `'${rkey}' is not a record key`);
    return false;
  }
  return true;
}

/** The time, in microseconds since the Unix epoch. */
export function nowMicros(): i64 {
  let instant = now();
  return instant.seconds * (1000000 as i64) + div(instant.nanoseconds as i64, 1000 as i64);
}

/** The time, in seconds since the Unix epoch. */
export function nowSeconds(): i64 {
  return now().seconds;
}

/**
 * The JSON object a request's body holds; null, after answering
 * `InvalidRequest`, when it is not one. Reading the body consumes the
 * request.
 */
export async function jsonBody(req: Own<Request>, res: Response): Future<JsonObject | null> {
  let limit = req.bodyLimit;
  let text = try {
    await req.text()
  } catch (e) {
    if (e is HttpError && e.status == 413) {
      fail(res, 413, 'PayloadTooLarge', `the body is larger than the ${limit} bytes this method takes`);
      return null;
    }
    throw e;
  };
  let parsed = parseBody(text);
  if (parsed == null) {
    fail(res, 400, 'InvalidRequest', 'the body is not a JSON object');
  }
  return parsed;
}

function parseBody(text: String): JsonObject | null {
  try {
    let json = parseJson(text);
    return if (json is JsonObject) json else null;
  } catch (e) {
    return null;
  }
}

/** The strings of a JSON array member, or null when it is not one. */
export function strings(json: JsonObject, name: String): GrowableArray<String> | null {
  let value = json[name];
  if (!(value is JsonArray)) {
    return null;
  }
  let list = value;
  let out = new GrowableArray<String>();
  for (var i = 0; i < list.length; i += 1) {
    if (!(list[i] is String)) {
      return null;
    }
    out.push(list[i] as String);
  }
  return out;
}

/**
 * Answers with `call`'s JSON, or with the error a session or repository
 * refused with. Passing `req` into `call` keeps it out of a closure capture,
 * so `call` releases it when it returns without reading the body.
 */
export async function sessionCall(
  req: Own<Request>,
  res: Response,
  call: (req: Own<Request>, res: Response) => Future<JsonObject | null>
): Future<void> {
  try {
    let answer = await call(req, res);
    if (answer != null) {
      json(res, answer);
    }
  } catch (e) {
    if (e is SessionError) {
      let error = e;
      fail(res, error.status, error.error, error.message);
      return;
    }
    if (e is RepositoryError) {
      fail(res, 400, e.error, e.message);
      return;
    }
    throw e;
  }
}
