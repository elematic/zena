/**
 * The `com.atproto.sync` reads: an account's latest commit, a record with
 * its proof, the whole repository, and a blob. Ported from pds.js's
 * `packages/core/src/handlers/xrpc-sync.js` and `handlers/xrpc-blob.js`,
 * at the revision docs/design/pds.md pins. pds.js serves one account and
 * answers `RepoNotFound` for any other; this finds the account each
 * request names.
 */

import {Future} from 'zena:async';
import {Router} from 'zena:http';
import {JsonObject} from 'zena:json';
import {StreamWriter} from 'zena:stream';
import {Cid} from 'atproto/cid';
import {SYNC_GET_BLOB, SYNC_GET_LATEST_COMMIT, SYNC_GET_RECORD, SYNC_GET_REPO, xrpcPath} from 'atproto/methods';
import {Pds} from '../pds.zena';
import {AccountStore} from '../storage.zena';
import {accountFor, fail, json, parseCid, required} from './common.zena';

/** How much of a blob `sync.getBlob` reads at a time. */
let BLOB_CHUNK = (1024 * 1024) as i64;

/** The longest range a `Range` without a last byte asks for. */
let TO_THE_END: i64 = 0x7fffffffffffffff;

/** Adds the `com.atproto.sync` routes for the accounts in `pds`. */
export function syncRoutes(router: Router, pds: Pds): void {
  router.get(xrpcPath(SYNC_GET_LATEST_COMMIT), async (req, res, next, params) => {
    let given = required(req, res, ['did']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    let head = await pds.storage.store(account.did).getHead();
    if (head == null) {
      fail(res, 404, 'RepoNotFound', `${account.did} has no commit`);
      return;
    }
    let body = new JsonObject();
    body['cid'] = head.cid.toString();
    body['rev'] = head.rev;
    json(res, body);
  });

  router.get(xrpcPath(SYNC_GET_RECORD), async (req, res, next, params) => {
    let given = required(req, res, ['did', 'collection', 'rkey']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    let car = await pds.repositoryOf(account).recordProof(given[1], given[2]);
    if (car == null) {
      fail(res, 404, 'RecordNotFound', 'Record not found');
      return;
    }
    res.type = 'application/vnd.ipld.car';
    res.body = car;
  });

  router.get(xrpcPath(SYNC_GET_REPO), async (req, res, next, params) => {
    let given = required(req, res, ['did']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    res.type = 'application/vnd.ipld.car';
    res.body = await pds.repositoryOf(account).exportCar();
  });

  router.get(xrpcPath(SYNC_GET_BLOB), async (req, res, next, params) => {
    let given = required(req, res, ['did', 'cid']);
    if (given == null) {
      return;
    }
    let account = await accountFor(pds, given[0], res);
    if (account == null) {
      return;
    }
    let cid = parseCid(given[1]);
    if (cid == null) {
      fail(res, 400, 'InvalidRequest', `'${given[1]}' is not a CID`);
      return;
    }
    // As the reference PDS does: whatever its type, a blob is never a page
    // or a script on this origin, where the site's cookie may be.
    res.setHeader('content-security-policy', "default-src 'none'; sandbox");
    res.setHeader('x-content-type-options', 'nosniff');
    let store = pds.storage.store(account.did);
    // A range, or the whole blob, is read a `BLOB_CHUNK` at a time, so that
    // no blob is ever in memory whole: anyone may ask for any blob, as
    // often as they like.
    let range = byteRange(req.getHeader('range'));
    let first = range?.first ?? (0 as i64);
    let wanted = range?.length ?? TO_THE_END;
    let head = await store.getBlobRange(cid, first, if (wanted < BLOB_CHUNK) wanted else BLOB_CHUNK);
    if (head == null) {
      fail(res, 400, 'BlobNotFound', 'Blob not found');
      return;
    }
    // Where what is asked for ends: the blob's end, for a range past it.
    let end = if (wanted >= head.size - first) head.size else first + wanted;
    if (range != null) {
      if (first >= head.size) {
        res.statusCode = 416;
        res.setHeader('content-range', `bytes */${head.size}`);
        res.body = new FixedArray<u8>(0, 0 as u8);
        return;
      }
      res.statusCode = 206;
      res.setHeader('content-range', `bytes ${first}-${end - (1 as i64)}/${head.size}`);
    } else {
      res.setHeader('accept-ranges', 'bytes');
    }
    res.type = head.mimeType;
    if (first + (head.bytes.length as i64) >= end) {
      res.body = head.bytes;
      return;
    }
    let writer = new StreamWriter<u8>();
    res.body = writer.stream;
    sendRest(store, cid, head.bytes, first + (head.bytes.length as i64), end, writer);
  });
}

/**
 * Writes `head`, and then the blob `cid` from `offset` up to `end` a
 * `BLOB_CHUNK` at a time, to `writer`, and closes it: early, when the
 * reader stops or a read fails, which ends the response short.
 */
async function sendRest(store: AccountStore, cid: Cid, head: FixedArray<u8>, offset: i64, end: i64,
    writer: StreamWriter<u8>): Future<void> {
  try {
    if (!(await writer.writeAll(head))) {
      return;
    }
    var next = offset;
    while (next < end) {
      let left = end - next;
      let part = await store.getBlobRange(cid, next, if (left < BLOB_CHUNK) left else BLOB_CHUNK);
      if (part == null || part.bytes.length == 0) {
        return;
      }
      if (!(await writer.writeAll(part.bytes))) {
        return;
      }
      next += part.bytes.length as i64;
    }
  } finally {
    writer.close();
  }
}

/** A range of bytes a `Range` header asks for: `length` bytes from `first`. */
class ByteRange(first: i64, length: i64)

/**
 * The one range `header` asks for, `bytes=<first>-<last>` or
 * `bytes=<first>-`; or null when there is no header, or it asks for
 * anything else. A server may answer any `Range` with the whole
 * representation (RFC 9110, section 14.2), and this one does for a suffix
 * (`bytes=-<n>`), a list of ranges and anything it cannot read.
 */
function byteRange(header: String | null): ByteRange | null {
  if (header == null || !header.startsWith('bytes=')) {
    return null;
  }
  let parts = header.sliceBytes(6, header.length).trim().split('-');
  if (parts.length != 2) {
    return null;
  }
  let first = digitsOf(parts[0]);
  if (first < 0 as i64) {
    return null;
  }
  if (parts[1] == '') {
    return new ByteRange(first, TO_THE_END - first);
  }
  let last = digitsOf(parts[1]);
  if (last < first) {
    return null;
  }
  return new ByteRange(first, last - first + (1 as i64));
}

/** `text` as a number, when it is 1 to 18 decimal digits; otherwise -1. */
function digitsOf(text: String): i64 {
  if (text.length == 0 || text.length > 18) {
    return -1 as i64;
  }
  var value = 0 as i64;
  for (var i = 0; i < text.length; i += 1) {
    let byte = text.getByteAt(i);
    if (byte < 48 || byte > 57) {
      return -1 as i64;
    }
    value = value * (10 as i64) + ((byte - 48) as i64);
  }
  return value;
}
