import { suite, test } from 'zena:test';
import { equal, isTrue } from 'zena:assert';
import { Future } from 'zena:async';
import { hex } from 'zena:encoding';
import { App, Request, Response } from 'zena:http';
import { JsonArray, JsonObject, parseJson } from 'zena:json';
import { Stream, readAllBytes } from 'zena:stream';
import { readCar } from 'atproto/car';
import { Cid } from 'atproto/cid';
import { MapValue, StringValue, newMap, stringField } from 'atproto/data';
import { KeyType, verifySignature } from 'atproto/didkey';
import { decodeCommit, verifyRecordProof } from 'atproto/repo';
import { createApp, version } from 'pds/server';
import { Pds } from 'pds/pds';
import { CreateRecord, Write } from 'pds/repository';
import { MemoryStorage, SigningKey, StoredBlob } from 'pds/storage';

let DID = 'did:plc:alicealicealicealicealic';
let NOW = 1792800000000000 as i64;
let POST = 'com.example.post';

let KEY = new SigningKey(KeyType.P256,
    hex.decode('c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721'));

function post(text: String) {
  let value = newMap();
  value.entries['$type'] = new StringValue(POST);
  value.entries['text'] = new StringValue(text);
  return value;
}

/** A server holding Alice's account: five posts, a profile and a blob. */
async function aliceApp(): Future<App> {
  let pds = new Pds(new MemoryStorage());
  let account = await pds.createAccount(DID, 'alice.test', KEY, NOW);
  let writes = new GrowableArray<Write>();
  for (var i = 1; i <= 5; i += 1) {
    writes.push(new CreateRecord(POST, `post${i}`, post(`post ${i}`)));
  }
  let profile = newMap();
  profile.entries['$type'] = new StringValue('com.example.profile');
  writes.push(new CreateRecord('com.example.profile', 'self', profile));
  await pds.repositoryOf(account).applyWrites(writes, NOW);
  let bytes = 'hello'.toBytes();
  await pds.storage.store(DID).putBlob(Cid.forBlob(bytes), new StoredBlob('text/plain', bytes));
  return createApp(pds);
}

async function getFrom(app: App, path: String): Future<Response> {
  let res = new Response();
  let req = new Request.fromUrl(`http://localhost${path}`, 'GET', new Map<String, String>());
  await app.handleRequest(req, res);
  return res;
}

async function get(path: String): Future<Response> {
  return await getFrom(createApp(new Pds(new MemoryStorage())), path);
}

function jsonOf(res: Response) {
  return parseJson(res.body as String) as JsonObject;
}

/** The XRPC error name of `res`, which must not be a success. */
function errorOf(res: Response) {
  isTrue(res.statusCode >= 400, `status ${res.statusCode}`);
  return jsonOf(res)['error'] as String;
}

export let tests = suite('pds/server', () => {
  test('GET / answers with a plain-text banner', async (ctx) => {
    let res = await get('/');
    equal(res.statusCode, 200);
    equal(res.type as String, 'text/plain; charset=utf-8');
  });

  test('GET /xrpc/_health reports the version', async (ctx) => {
    let res = await get('/xrpc/_health');
    equal(res.statusCode, 200);
    equal(res.type as String, 'application/json');
    equal(res.body as String, `{"version":"${version}"}`);
  });

  test('an unknown route is a 404', async (ctx) => {
    equal((await get('/xrpc/com.example.nothing')).statusCode, 404);
  });

  test('server.describeServer names the DID App Views address their tokens to', async (ctx) => {
    // Until it is configured, as pds.js does, the did:web of the host asked.
    let res = await get('/xrpc/com.atproto.server.describeServer');
    equal(res.statusCode, 200);
    let body = jsonOf(res);
    equal(body['did'] as String, 'did:web:localhost');
    // Its accounts' handles are their App Views', so it offers none.
    equal((body['availableUserDomains'] as JsonArray).length, 0);

    let pds = new Pds(new MemoryStorage());
    pds.did = 'did:web:padstone.test';
    equal(jsonOf(await getFrom(createApp(pds), '/xrpc/com.atproto.server.describeServer'))['did'] as String,
        'did:web:padstone.test');
  });

  test('sync.getRecord answers with a proof a client verifies', async (ctx) => {
    let app = await aliceApp();
    let res = await getFrom(app, `/xrpc/com.atproto.sync.getRecord?did=${DID}&collection=${POST}&rkey=post3`);
    equal(res.statusCode, 200);
    equal(res.type as String, 'application/vnd.ipld.car');
    let publicKey = KEY.publicKey();
    let car = readCar(res.body as FixedArray<u8>);
    let proof = verifyRecordProof(car, DID, POST, 'post3',
        (signed, sig) => verifySignature(publicKey, signed, sig));
    equal(stringField(proof.record as MapValue, 'text') as String, 'post 3');

    let latest = jsonOf(await getFrom(app, `/xrpc/com.atproto.sync.getLatestCommit?did=${DID}`));
    equal(latest['cid'] as String, car.roots[0].toString());
    equal(latest['rev'] as String, proof.commit.rev);

    equal(errorOf(await getFrom(app, `/xrpc/com.atproto.sync.getRecord?did=${DID}&collection=${POST}&rkey=post9`)),
        'RecordNotFound');
    equal(errorOf(await getFrom(app, `/xrpc/com.atproto.sync.getRecord?did=did:plc:nobody&collection=${POST}&rkey=post1`)),
        'RepoNotFound');
    equal(errorOf(await getFrom(app, `/xrpc/com.atproto.sync.getRecord?did=${DID}&collection=${POST}`)),
        'InvalidRequest');
  });

  test('sync.getRepo answers with the whole repository', async (ctx) => {
    let car = readCar((await getFrom(await aliceApp(), `/xrpc/com.atproto.sync.getRepo?did=${DID}`)).body as FixedArray<u8>);
    let commit = decodeCommit(car.blocks.get(car.roots[0]) as FixedArray<u8>);
    equal(commit.did, DID);
    isTrue(car.blocks.size >= 7, `${car.blocks.size} blocks`);
  });

  test('sync.getBlob answers with the blob and its type', async (ctx) => {
    let app = await aliceApp();
    let cid = Cid.forBlob('hello'.toBytes()).toString();
    let res = await getFrom(app, `/xrpc/com.atproto.sync.getBlob?did=${DID}&cid=${cid}`);
    equal(res.type as String, 'text/plain');
    equal(String.fromBytes(res.body as FixedArray<u8>), 'hello');
    let missing = Cid.forBlob('bye'.toBytes()).toString();
    equal(errorOf(await getFrom(app, `/xrpc/com.atproto.sync.getBlob?did=${DID}&cid=${missing}`)), 'BlobNotFound');
    equal(errorOf(await getFrom(app, `/xrpc/com.atproto.sync.getBlob?did=${DID}&cid=nonsense`)), 'InvalidRequest');
  });

  test('sync.getBlob streams a blob larger than one read, a range at a time', async (ctx) => {
    let pds = new Pds(new MemoryStorage());
    await pds.createAccount(DID, 'alice.test', KEY, NOW);
    let bytes = new FixedArray<u8>(2500000, 0 as u8);
    for (var i = 0; i < bytes.length; i += 1) {
      bytes[i] = (i % 251) as u8;
    }
    let cid = Cid.forBlob(bytes);
    await pds.storage.store(DID).putBlob(cid, new StoredBlob('application/gzip', bytes));
    let res = await getFrom(createApp(pds), `/xrpc/com.atproto.sync.getBlob?did=${DID}&cid=${cid.toString()}`);
    equal(res.statusCode, 200);
    equal(res.type as String, 'application/gzip');
    // Never the whole blob in memory at once, however large it is.
    let body = res.body;
    isTrue(body is Stream<u8>, 'a stream');
    let read = await readAllBytes(body as Stream<u8>);
    equal(read.length, bytes.length);
    equal(Cid.forBlob(read).toString(), cid.toString());

    // As is a large range, such as everything from a byte on.
    let headers: Map<String, String> = {'range' => 'bytes=1000-'};
    let ranged = new Response();
    await createApp(pds).handleRequest(new Request.fromUrl(
        `http://localhost/xrpc/com.atproto.sync.getBlob?did=${DID}&cid=${cid.toString()}`, 'GET', headers), ranged);
    equal(ranged.statusCode, 206);
    equal(ranged.getHeader('content-range') ?? '', 'bytes 1000-2499999/2500000');
    let part = ranged.body;
    isTrue(part is Stream<u8>, 'a stream for the range');
    let rest = await readAllBytes(part as Stream<u8>);
    equal(rest.length, bytes.length - 1000);
    equal(rest[0] as i32, 1000 % 251);
    equal(rest[rest.length - 1] as i32, (bytes.length - 1) % 251);
  });

  test('sync.getBlob answers a Range with that part of the blob', async (ctx) => {
    let app = await aliceApp();
    let path = `/xrpc/com.atproto.sync.getBlob?did=${DID}&cid=${Cid.forBlob('hello'.toBytes()).toString()}`;
    let ranged = async (range: String): Future<Response> => {
      let headers: Map<String, String> = {'range' => range};
      let res = new Response();
      await app.handleRequest(new Request.fromUrl(`http://localhost${path}`, 'GET', headers), res);
      return res;
    };
    let whole = await getFrom(app, path);
    equal(whole.statusCode, 200);
    equal(whole.getHeader('accept-ranges') ?? '', 'bytes');

    let middle = await ranged('bytes=1-3');
    equal(middle.statusCode, 206);
    equal(middle.type as String, 'text/plain');
    equal(middle.getHeader('content-range') ?? '', 'bytes 1-3/5');
    equal(String.fromBytes(middle.body as FixedArray<u8>), 'ell');
    let open = await ranged('bytes=2-');
    equal(open.getHeader('content-range') ?? '', 'bytes 2-4/5');
    equal(String.fromBytes(open.body as FixedArray<u8>), 'llo');
    // A range past the end ends at it; one that starts there is not satisfiable.
    equal(String.fromBytes((await ranged('bytes=3-99')).body as FixedArray<u8>), 'lo');
    let past = await ranged('bytes=5-');
    equal(past.statusCode, 416);
    equal(past.getHeader('content-range') ?? '', 'bytes */5');

    // Ranges it does not take, suffixes and lists among them, get the whole blob.
    for (let other in ['bytes=-2', 'bytes=0-1,3-4', 'items=0-1', 'bytes=3-1', 'bytes=x-', 'bytes=-']) {
      let res = await ranged(other);
      equal(res.statusCode, 200, other);
      equal(String.fromBytes(res.body as FixedArray<u8>), 'hello', other);
    }
  });

  test('repo.getRecord answers with the record as JSON, by DID or handle', async (ctx) => {
    let app = await aliceApp();
    let byHandle = jsonOf(await getFrom(app, `/xrpc/com.atproto.repo.getRecord?repo=alice.test&collection=${POST}&rkey=post2`));
    equal(byHandle['uri'] as String, `at://${DID}/${POST}/post2`);
    equal((byHandle['value'] as JsonObject)['text'] as String, 'post 2');
    let byDid = jsonOf(await getFrom(app, `/xrpc/com.atproto.repo.getRecord?repo=${DID}&collection=${POST}&rkey=post2`));
    equal(byDid['cid'] as String, byHandle['cid'] as String);
  });

  test('repo.listRecords pages through a collection, newest key first unless reversed', async (ctx) => {
    let app = await aliceApp();
    let first = jsonOf(await getFrom(app, `/xrpc/com.atproto.repo.listRecords?repo=${DID}&collection=${POST}&limit=2`));
    let records = first['records'] as JsonArray;
    equal(records.length, 2);
    equal((records[0] as JsonObject)['uri'] as String, `at://${DID}/${POST}/post5`);
    equal(first['cursor'] as String, 'post4');
    let rest = jsonOf(await getFrom(app,
        `/xrpc/com.atproto.repo.listRecords?repo=${DID}&collection=${POST}&limit=10&cursor=post4`));
    equal((rest['records'] as JsonArray).length, 3);
    isTrue(!rest.has('cursor'), 'a last page has no cursor');
    let oldest = jsonOf(await getFrom(app,
        `/xrpc/com.atproto.repo.listRecords?repo=${DID}&collection=${POST}&limit=1&reverse=true`));
    equal(((oldest['records'] as JsonArray)[0] as JsonObject)['uri'] as String, `at://${DID}/${POST}/post1`);
  });

  test('repo.describeRepo lists the collections', async (ctx) => {
    let described = jsonOf(await getFrom(await aliceApp(), `/xrpc/com.atproto.repo.describeRepo?repo=${DID}`));
    equal(described['handle'] as String, 'alice.test');
    let collections = described['collections'] as JsonArray;
    equal(collections.length, 2);
    equal(collections[0] as String, 'com.example.post');
    equal(collections[1] as String, 'com.example.profile');
  });
});
