# The environment that points zena at the staging package host, for trying
# it out: `source packages/pds/deploy/staging.env` in a shell, then
# `zena login`, `zena publish` and `zena add` there. ZENA_CONFIG_DIR, where
# the sign-in is kept, is left to you: set it to a directory of its own to
# keep a staging sign-in apart from your usual one.
export ZENA_PACKAGE_HOST=https://pkg-staging.zena-lang.dev
export ZENA_PLC_DIRECTORY=https://pkg-staging.zena-lang.dev/plc
