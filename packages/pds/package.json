{
  "name": "@zena-lang/pds",
  "version": "0.0.1",
  "description": "An AT Protocol PDS written in Zena, with managed accounts for the App Views it trusts",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wireit",
    "test:emulator": "wireit"
  },
  "wireit": {
    "test": {
      "command": "../../target/release/zena-cli test \"test/*_test.zena\"",
      "files": [
        "src/*.zena",
        "src/xrpc/**/*.zena",
        "test/*.zena",
        "../atproto/src/**/*.zena",
        "../package-manager/src/**/*.zena",
        "../google-cloud/src/*.zena",
        "../google-cloud/src/testing/*.zena",
        "../protobuf/src/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../../zena-package.json",
        "zena-package.json",
        "../atproto/zena-package.json",
        "../package-manager/zena-package.json",
        "../google-cloud/zena-package.json",
        "../protobuf/zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "../zena-cli:build"
      ]
    },
    "test:emulator": {
      "#command": "The storage conformance tests against the Firestore emulator. Not part of `test`: the emulator needs the flake's `emulators` shell (firebase-tools and Java, about 2 GB), which the root `emulators:start` service enters itself.",
      "command": "../../target/release/zena-cli test \"test/emulator/*_test.zena\"",
      "files": [
        "src/*.zena",
        "src/xrpc/**/*.zena",
        "test/emulator/*.zena",
        "test/storage-conformance.zena",
        "../atproto/src/**/*.zena",
        "../package-manager/src/**/*.zena",
        "../google-cloud/src/*.zena",
        "../google-cloud/src/testing/*.zena",
        "../protobuf/src/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../../zena-package.json",
        "zena-package.json",
        "../atproto/zena-package.json",
        "../package-manager/zena-package.json",
        "../google-cloud/zena-package.json",
        "../protobuf/zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "../..:emulators:start",
        "../zena-cli:build"
      ],
      "env": {
        "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8180"
      }
    }
  }
}
