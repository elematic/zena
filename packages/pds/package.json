{
  "name": "@zena-lang/pds",
  "version": "0.0.1",
  "description": "An AT Protocol PDS written in Zena, and the base of the Zena package host",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wireit",
    "test:emulator": "wireit",
    "demo": "wireit",
    "build:server": "wireit",
    "stage:docker": "wireit",
    "stage:web": "wireit",
    "docker:build": "wireit",
    "deploy:setup": "wireit",
    "deploy:image": "wireit",
    "deploy": "wireit",
    "deploy:domain": "wireit"
  },
  "wireit": {
    "test": {
      "command": "../../target/release/zena-cli test \"zena/test/*_test.zena\"",
      "files": [
        "zena/*.zena",
        "zena/web/**/*.zena",
        "zena/test/*.zena",
        "../atproto/zena/**/*.zena",
        "../package-manager/zena/**/*.zena",
        "../google-cloud/zena/*.zena",
        "../google-cloud/zena/testing/*.zena",
        "../protobuf/zena/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../../zena-package.json",
        "zena/zena-package.json",
        "../atproto/zena/zena-package.json",
        "../package-manager/zena/zena-package.json",
        "../google-cloud/zena/zena-package.json",
        "../protobuf/zena/zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "../zena-cli:build"
      ]
    },
    "test:emulator": {
      "#command": "The storage conformance tests against the Firestore emulator. Not part of `test`: the emulator needs the flake's `emulators` shell (firebase-tools and Java, about 2 GB), which the root `emulators:start` service enters itself.",
      "command": "../../target/release/zena-cli test \"zena/test/emulator/*_test.zena\"",
      "files": [
        "zena/*.zena",
        "zena/web/**/*.zena",
        "zena/test/emulator/*.zena",
        "zena/test/storage-conformance.zena",
        "../atproto/zena/**/*.zena",
        "../package-manager/zena/**/*.zena",
        "../google-cloud/zena/*.zena",
        "../protobuf/zena/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../../zena-package.json",
        "zena/zena-package.json",
        "../atproto/zena/zena-package.json",
        "../package-manager/zena/zena-package.json",
        "../google-cloud/zena/zena-package.json",
        "../protobuf/zena/zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "../..:emulators:start",
        "../zena-cli:build"
      ],
      "env": {
        "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8180"
      }
    },
    "demo": {
      "#command": "A package host for pkg.test on this machine, with a stand-in PLC directory and a resolver for its handles, to try `zena login`, `zena publish` and `zena add` against: dev/demo.zena prints how. Runs until stopped.",
      "command": "cd ../.. && PDS_WEB_DIR=${PDS_WEB_DIR:-/web} ./target/release/zena-cli run --dir packages/pds-web/out::/web packages/pds/dev/demo.zena",
      "service": true,
      "files": [
        "dev/*.zena",
        "zena/*.zena",
        "zena/web/**/*.zena",
        "../atproto/zena/**/*.zena",
        "../package-manager/zena/**/*.zena",
        "../google-cloud/zena/*.zena",
        "../protobuf/zena/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../../zena-package.json",
        "zena/zena-package.json",
        "../atproto/zena/zena-package.json",
        "../package-manager/zena/zena-package.json",
        "../google-cloud/zena/zena-package.json",
        "../protobuf/zena/zena-package.json"
      ],
      "dependencies": [
        "../zena-cli:build",
        "../pds-web:build"
      ]
    },
    "build:server": {
      "#command": "Compiles zena/main.zena, the server, into deploy/pds.wasm, for the image.",
      "command": "cd ../.. && ./target/release/zena-cli build packages/pds/zena/main.zena -o packages/pds/deploy/pds.wasm",
      "files": [
        "zena/*.zena",
        "zena/web/**/*.zena",
        "../atproto/zena/**/*.zena",
        "../package-manager/zena/**/*.zena",
        "../google-cloud/zena/*.zena",
        "../protobuf/zena/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../../zena-package.json",
        "zena/zena-package.json",
        "../atproto/zena/zena-package.json",
        "../package-manager/zena/zena-package.json",
        "../google-cloud/zena/zena-package.json",
        "../protobuf/zena/zena-package.json"
      ],
      "output": [
        "deploy/pds.wasm"
      ],
      "dependencies": [
        "../zena-cli:build"
      ]
    },
    "stage:docker": {
      "#command": "Stages a Linux x86_64 zena-run into deploy/ for the image, with the website's resolving and patching (deploy/stage-docker.js).",
      "command": "node deploy/stage-docker.js",
      "files": [
        "deploy/stage-docker.js",
        "../website/lib/stage-docker.js",
        "../../target/release/zena-run",
        "../zena-run/Cargo.toml",
        "../zena-run/src/**/*.rs",
        "../zena-runtime/Cargo.toml",
        "../zena-runtime/src/**/*.rs",
        "../stdlib/zena/host-wit/*.wit",
        "../../Cargo.toml",
        "../../Cargo.lock"
      ],
      "output": [
        "deploy/zena-run"
      ],
      "dependencies": [
        "../zena-run:build"
      ]
    },
    "stage:web": {
      "#command": "Copies the web app's build (packages/pds-web) into deploy/web for the image, which serves it as PDS_WEB_DIR.",
      "command": "rm -rf deploy/web && cp -R ../pds-web/out deploy/web",
      "dependencies": [
        "../pds-web:build"
      ],
      "files": [
        "../pds-web/out/**"
      ],
      "output": [
        "deploy/web/**"
      ]
    },
    "docker:build": {
      "#command": "Builds the image locally, for those with Docker; deploy:image builds it with Cloud Build instead.",
      "command": "docker build --platform linux/amd64 --file deploy/Dockerfile --tag zena-pkg deploy",
      "dependencies": [
        "build:server",
        "stage:docker",
        "stage:web"
      ]
    },
    "deploy:setup": {
      "#command": "One time, and idempotent: the Google Cloud resources of the environment PDS_ENV (staging by default) in ZENA_GCP_PROJECT. See deploy/setup.sh. No files, so it always runs: re-running is the fix when a step failed.",
      "command": "bash deploy/setup.sh"
    },
    "deploy:image": {
      "#command": "Builds the image with Cloud Build from deploy/, and pushes it. The same image serves both environments.",
      "command": "bash -c 'source deploy/env.sh > /dev/null && gcloud builds submit --project \"$PROJECT\" --config deploy/cloudbuild.yaml --substitutions _IMAGE=\"$IMAGE\" deploy'",
      "dependencies": [
        "build:server",
        "stage:docker",
        "stage:web"
      ]
    },
    "deploy": {
      "#command": "Deploys the image to the environment PDS_ENV (staging by default), and checks that it answers. See deploy/deploy.sh.",
      "command": "bash deploy/deploy.sh",
      "dependencies": [
        "deploy:image"
      ]
    },
    "deploy:domain": {
      "#command": "Once, after the first deploy: maps the environment's domain to its service and writes the records it needs. Needs gcloud's beta component. See deploy/domain.sh.",
      "command": "bash deploy/domain.sh"
    }
  },
  "devDependencies": {
    "wireit": "^0.14.4"
  }
}
