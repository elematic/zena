  },
  "scripts": {
    "test": {
      "command": "../../target/release/zena-cli test \"test/*_test.zena\"",
      "files": ["test/*.zena"],
      "dependencies": ["source", "../stdlib:lib", "../zena-cli:build"]
    },
    "test:emulator": {
      "#command": "The storage conformance tests against the Firestore emulator. Not part of `test`: the emulator needs the flake's `emulators` shell (firebase-tools and Java, about 2 GB), which the root `emulators:start` service enters itself.",
      "command": "../../target/release/zena-cli test \"test/emulator/*_test.zena\"",
      "files": ["test/emulator/*.zena", "test/storage-conformance.zena"],
      "env": {
        "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8180"
      },
      "dependencies": [
        "source",
        "../stdlib:lib",
        "../..:emulators:start",
        "../zena-cli:build"
      ]
    }
  }
}
