    "test:emulator": {
      "#tests": "The storage conformance tests against the Firestore emulator. Not part of `test`: the emulator needs the flake's `emulators` shell (firebase-tools and Java, about 2 GB), which the root `emulators:start` service enters itself.",
      "type": "zena:test",
      "tests": "test/emulator/*_test.zena",
      "files": ["test/emulator/*.zena", "test/storage-conformance.zena"],
      "env": {
        "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8180"
      },
      "dependencies": ["../..:emulators:start", "../zena-cli:build"]
    }
  }
