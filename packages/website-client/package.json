{
  "name": "@zena-lang/website-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Lit custom elements that add interactivity to the Zena docs site.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "typecheck"
      ]
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json",
      "dependencies": [
        "../playground:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@zena-lang/playground": "*",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3",
    "wireit": "^0.14.12"
  }
}
