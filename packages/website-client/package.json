{
  "name": "@zena-lang/website-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Lit custom elements that add interactivity to the Zena docs site, including the playground.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/lib/worker/compiler-worker.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "wireit",
    "build:stdlib": "wireit",
    "typecheck": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:stdlib",
        "typecheck"
      ]
    },
    "build:stdlib": {
      "command": "node --experimental-strip-types src/scripts/build-stdlib-map.ts",
      "dependencies": [
        "../stdlib:build"
      ],
      "files": [
        "src/scripts/build-stdlib-map.ts",
        "../stdlib/zena/**/*.zena"
      ],
      "output": [
        "src/lib/stdlib-data.json"
      ]
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
      "dependencies": [
        "build:stdlib",
        "../runtime:build",
        "../language-service:build"
      ],
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tsconfig.json",
        "tsconfig.worker.json"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.3",
    "@zena-lang/runtime": "*",
    "codemirror-elements": "^0.0.11",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@zena-lang/language-service": "*",
    "typescript": "~5.9.3",
    "wireit": "^0.14.12"
  }
}
