{
  "name": "@zena-lang/pds-web",
  "private": true,
  "version": "0.0.1",
  "description": "The assets of the PDS's web app: its stylesheet over Radica's design tokens, and the Radica elements its server-rendered pages use",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit",
    "bundle": "wireit",
    "docs": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "typecheck",
        "bundle",
        "docs"
      ]
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json",
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../website-client/src/*.ts"
      ],
      "output": []
    },
    "bundle": {
      "#command": "Builds the assets into out/, the directory the PDS serves at /assets/ as PDS_WEB_DIR.",
      "command": "node build.js",
      "files": [
        "build.js",
        "src/**/*.ts",
        "src/**/*.css",
        "../website/src/css/*.css",
        "../website/src/public/logo.svg",
        "../website-client/src/*.ts"
      ],
      "output": [
        "out/app.js",
        "out/app.js.map",
        "out/app.css",
        "out/logo.svg",
        "out/chunks/**"
      ],
      "clean": "if-file-deleted"
    },
    "docs": {
      "#command": "Builds the static package manager documentation into out/docs/, which the PDS serves at /docs/.",
      "command": "eleventy",
      "files": [
        "eleventy.config.js",
        "site/**/*",
        "../website/src/_includes/*.njk",
        "../website/src/_layouts/doc.njk",
        "../website/lib/highlight.js",
        "../website/lib/markdown.js",
        "../website/lib/toc.js",
        "../website/lib/sidebar.js",
        "../vscode-zena/syntaxes/zena.tmLanguage.json"
      ],
      "output": [
        "out/docs/**"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "^0.5.11",
    "@radica/base": "^0.0.4",
    "@radica/ui": "^0.0.4"
  }
}
