{
  "name": "@zena-lang/pds-web",
  "private": true,
  "version": "0.0.1",
  "description": "The assets of the PDS's web app: its stylesheet over Radica's design tokens, and the Radica elements its server-rendered pages use",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit",
    "bundle": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "typecheck",
        "bundle"
      ]
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json",
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": []
    },
    "bundle": {
      "#command": "Builds the assets into out/, the directory the PDS serves at /assets/ as PDS_WEB_DIR.",
      "command": "node build.js",
      "files": [
        "build.js",
        "src/**/*.ts",
        "src/**/*.css"
      ],
      "output": [
        "out/**"
      ],
      "clean": "if-file-deleted"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "^0.5.11",
    "@radica/base": "^0.0.4",
    "@radica/ui": "^0.0.4"
  }
}
