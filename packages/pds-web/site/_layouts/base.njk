<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }} · {{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="icon" href="/assets/logo.svg" type="image/svg+xml" />
    <script>
      try{let t=localStorage.getItem('themeName')??'auto';if(t==='dark'||(t==='auto'&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('rad-theme-dark')}catch{}
    </script>
    <link rel="stylesheet" href="/assets/app.css" />
    <script type="module" src="/assets/app.js"></script>
  </head>
  <body class="is-docs-page" data-static="true">
    <a href="#site-content" class="skip-link visually-hidden">Skip to content</a>
    <div class="docs-backdrop" data-close-sidebar></div>

    <header class="site">
      <a class="title" href="/">
        <img class="site-logo" src="/assets/logo.svg" alt="" width="24" height="24" />
        <span>{{ site.title }}</span>
      </a>
      <span class="mono muted domain-badge" data-host-domain>{{ site.domain }}</span>
      <nav class="site-links" aria-label="Main navigation">
        <a href="/">Packages</a>
        <a href="/docs/" class="active" aria-current="page">Docs</a>
        <a href="{{ site.mainSiteUrl }}" target="_blank" rel="noopener">zena-lang.dev</a>
      </nav>
      <span class="spacer"></span>
      <div class="site-actions">
        <a href="/me" data-static-me hidden>Your packages</a>
        <button type="button" data-sign-in>Sign in with Atmosphere</button>
        <dialog id="sign-in">
          <form method="dialog" class="sign-in">
            <h2>Sign in with Atmosphere</h2>
            <p>
              Sign in with your Atmosphere account: the one you use with Bluesky
              and other atproto apps. Your own PDS asks for your password; this
              site never sees it.
            </p>
            <label>
              Handle or DID
              <input name="identifier" placeholder="alice.bsky.social" required autocomplete="username" />
            </label>
            <p class="error" hidden></p>
            <div class="actions">
              <button type="submit" value="sign-in">Sign in</button>
              <button type="button" class="quiet" data-close>Cancel</button>
            </div>
          </form>
        </dialog>
        <rad-theme-select></rad-theme-select>
      </div>
    </header>

    {{ content | safe }}

    <footer class="site-footer{% if hasSidebar %} has-sidebar{% endif %}">
      <div class="site-footer-inner">
        <span>Zena Package Registry · <span class="mono">{{ site.domain }}</span></span>
        <nav class="site-footer-links" aria-label="Footer navigation">
          <a href="/docs/">Documentation</a>
          <a href="/docs/cli/">CLI Reference</a>
          <a href="/docs/architecture/">Architecture</a>
          <a href="{{ site.mainSiteUrl }}" target="_blank" rel="noopener">zena-lang.dev</a>
          <a href="{{ site.repo }}" target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
