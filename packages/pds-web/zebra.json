{
  "locks": ["zena-lock.json", "package-lock.json"],
  "scripts": {
    "build": {
      "dependencies": ["typecheck", "bundle", "docs"]
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json",
      "files": ["src/**/*.ts", "tsconfig.json", "../website-client/src/*.ts"]
    },
    "bundle": {
      "#command": "Builds the assets into out/, the directory the PDS serves at /assets/ as APP_VIEW_WEB_DIR.",
      "command": "node build.js",
      "files": [
        "build.js",
        "src/**/*.ts",
        "src/theme.js",
        "src/**/*.css",
        "../website/src/css/*.css",
        "../website/src/public/logo.svg",
        "../website-client/src/*.ts"
      ],
      "output": [
        "out/app.js",
        "out/app.js.map",
        "out/app.css",
        "out/logo.svg",
        "out/theme.js",
        "out/chunks/**"
      ],
      "clean": "if-file-deleted"
    },
    "docs": {
      "#command": "Builds the static package manager documentation into out/docs/, which the PDS serves at /docs/.",
      "command": "eleventy",
      "files": [
        "eleventy.config.js",
        "site/**/*",
        "../website/src/_includes/*.njk",
        "../website/src/_layouts/doc.njk",
        "../website/lib/highlight.js",
        "../website/lib/markdown.js",
        "../website/lib/toc.js",
        "../website/lib/sidebar.js",
        "../vscode-zena/syntaxes/zena.tmLanguage.json"
      ],
      "output": ["out/docs/**", "out/home.html"]
    }
  }
}
