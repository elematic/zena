/**
 * Compiling a source file: in this module, with the compiler linked in,
 * or with another compiler module when `ZENA_COMPILER_WASM` names one.
 *
 * The build scripts set `ZENA_COMPILER_WASM` to choose which compiler
 * builds a file: the bootstrap builds the compiler, and the fixpoint
 * check builds the compiler with itself. That compiler is run through
 * `zena:wasm` with the same flags and preopens `zc` has always had.
 *
 * `zena run`, `zena test` and `zena bench` compile through a cache. An
 * entry is the module plus a list of every file the compile read, with
 * each file's modification time and size, and it is fresh while all of
 * them still match. The key covers everything else that changes the
 * output: the source path, the flags, and this module's own identity,
 * since the compiler is part of it.
 */

import { getEnv } from 'zena:cli';
import { HashMap, HashSet } from 'zena:collections';
import {
  existsSync, isDirectorySync, isFileSync, mkdirSync, readFileSync, readFileBytesSync, renameSync, statSync, unlinkSync,
  writeFileSync, writeFileBytesSync
} from 'zena:fs';
import { AbsolutePath, basename, dirname, extname } from 'zena:path';
import { monotonic } from 'zena:time';
import { runModule } from 'zena:wasm';
import {
  CompileFileOptions, CompileSession, compileFile, defaultOptLevel, defaultTarget,
  openCompileSession, parseOptLevel
} from 'zena-compiler:compile-file';
import { targetEmitsComponent } from 'zena-compiler:targets';
import { sha256HexOfString } from 'zena:crypto';
import {
  Options, cliModule, envSet, repoRelative, repoRoot, resolveUserPath, stdlibDir
} from './env.zena';

/** What to compile, and how. */
export final class CompileRequest {
  source: AbsolutePath;
  /** The compilation target; null for the compiler's default. */
  var target: String | null = null;
  /** A WIT file or directory declaring a component's world. */
  var wit: AbsolutePath | null = null;
  var world: String | null = null;
  /** WIT files or directories the program's extensions are written to. */
  var extensionWits = new Array<AbsolutePath>();
  /**
   * The module string literals are imported from on the `js` target;
   * null for the compiler's default.
   */
  var importedStringConstants: String | null = null;
  /** Group imports by module and type; see `CompileFileOptions.compactImports`. */
  var compactImports = false;
  /** Compile a test suite, giving it a `main` that runs `tests`. */
  var testMode = false;
  /** Print the compiler's phase timings. */
  var time = false;

  new(this.source);
}

/** A compile that failed. Its diagnostics have already been printed. */
export final class CompileFailure extends Error {
  new(message: String) : super(message);
}

/**
 * The optimization level, from `-O` or else ZENA_OPT_LEVEL, as the text
 * the user gave; '' for the default.
 */
function optLevelText(options: Options) {
  let flag = options.optLevel;
  return flag ?? getEnv('ZENA_OPT_LEVEL') ?? '';
}

/** The compiler module ZENA_COMPILER_WASM names, or null for this one. */
function externalCompiler(): AbsolutePath | null {
  let named = getEnv('ZENA_COMPILER_WASM');
  if (named == null) {
    return null;
  }
  let path = resolveUserPath(named);
  if (!isFileSync(path.value)) {
    throw new CompileFailure(
      `Compiler WASM not found at ${path.value}. Please build it first.`,
    );
  }
  return path;
}

/**
 * Compiles `request` to `out`. With `quiet`, what the compiler prints
 * is held back and shown only if the compile fails, so that `zena run`'s
 * output is the program's alone.
 */
export function compileTo(
  request: CompileRequest,
  options: Options,
  out: AbsolutePath,
  quiet: boolean = false,
): void {
  compileRecording(request, options, out, quiet, (path) => {});
}

var runtimeMemoryModuleThisProcess: AbsolutePath | null = null;

/**
 * The component runtime memory module, through the compile cache.
 *
 * Every component embeds it, and its bytes do not vary with the
 * program: core module 0 has no imports, and the program module imports
 * its exports at the component level. Compiling it is about two thirds
 * of a small component build, and `zena test` runs one process per test
 * file, so without this every one of those processes compiles the same
 * 1459 bytes again.
 *
 * It goes through `compileCached` rather than a build-time artifact
 * because the cache already answers the two hard questions: where to
 * put it so that an installed `zena` can reach it, and when it is
 * stale. Its `.deps` records the standard library files the module
 * read, so editing the allocator rebuilds it; the key covers the
 * compiler's own identity, so a new compiler does too. The request's
 * target is `freestanding`, which is not a component target, so this
 * does not recurse.
 */
function cachedRuntimeMemoryModule(options: Options) {
  let already = runtimeMemoryModuleThisProcess;
  if (already != null) {
    return already;
  }
  let request = new CompileRequest(
      new AbsolutePath(`${stdlibDir().value}/component-runtime/memory.zena`));
  request.target = 'freestanding';
  let path = compileCached(request, options);
  // Held for the process: the standard library cannot change under a
  // running command, and `compileCached` asks about it twice — once
  // before a program's own freshness check, once while compiling.
  runtimeMemoryModuleThisProcess = path;
  return path;
}

/**
 * The runtime memory module for a component build of `request`.
 *
 * It is compiled before the program, so it is the compile that meets a
 * fault every compile shares first, such as a workspace whose manifests
 * do not load. The compiler has printed the cause by then; what did not
 * compile is `request`'s program, so that is the file the failure names.
 */
function runtimeMemoryModuleFor(request: CompileRequest, options: Options) {
  try {
    return cachedRuntimeMemoryModule(options);
  } catch (e) {
    if (e is CompileFailure) {
      throw new CompileFailure(`${request.source.value} did not compile`);
    }
    throw e;
  }
}

/**
 * The files a cached entry recorded reading, from its `.deps`.
 *
 * Empty when there is no `.deps` beside the module, which is what a
 * compile that was not cached leaves — the caller then records nothing
 * and its own entry is rebuilt next time, which is safe.
 */
function recordedDeps(modulePath: AbsolutePath) {
  let paths = new GrowableArray<String>();
  let depsPath = `${modulePath.value.sliceBytes(0, modulePath.value.length - 5)}.deps`;
  if (!isFileSync(depsPath)) {
    return paths;
  }
  for (let line in readFileSync(depsPath).split('\n')) {
    if (line == '') {
      continue;
    }
    // "<modified> <size> <path>"; the path may contain spaces.
    let second = spaceAfter(line, spaceAfter(line, 0) + 1);
    if (second < 0) {
      continue;
    }
    paths.push(line.sliceBytes(second + 1, line.length));
  }
  return paths;
}

function compileRecording(
  request: CompileRequest,
  options: Options,
  out: AbsolutePath,
  quiet: boolean,
  onRead: (path: String) => void,
): void {
  ensureDir(dirname(out.value));
  let compiler = externalCompiler();
  if (compiler != null) {
    compileWith(compiler, request, options, out, quiet);
    return;
  }
  var status = 1;
  try {
    status = compileFile(compileFileOptions(request, options, out, onRead));
  } catch (e) {
    if (e is CompileFailure) {
      throw e;
    }
    // compileFile printed the error and its stack on the way out; the
    // message rides along for the cases where it did not get to.
    throw new CompileFailure(
        `the compiler failed on ${request.source.value}: ${e.message}`);
  }
  if (status != 0) {
    throw new CompileFailure(`${request.source.value} did not compile`);
  }
}

/**
 * What the compiler is told for `request`, writing to `out` and reporting
 * each file it reads to `onRead`. A component's runtime memory module is
 * built (or found in the cache) here, and its sources are reported too.
 */
function compileFileOptions(
  request: CompileRequest,
  options: Options,
  out: AbsolutePath,
  onRead: (path: String) => void,
): CompileFileOptions {
  let level = optLevelText(options);
  let optLevel = if (level == '') {
    defaultOptLevel
  } else {
    let parsed = parseOptLevel(level);
    if (parsed < 0) {
      throw new CompileFailure(
        `invalid optimization level '${level}' (expected 0, 1, 2, or s)`,
      );
    }
    parsed
  };
  let wit = request.wit;
  let extensionWitPaths = new Array<String>();
  for (let path in request.extensionWits) {
    extensionWitPaths.push(repoRelative(path));
  }
  let target = request.target ?? defaultTarget;
  // Empty for a target that embeds no runtime memory module, as
  // `witPath` is empty for a compile with no declared world.
  let runtimeMemory = if (!targetEmitsComponent(target)) {
    ''
  } else {
    let runtime = runtimeMemoryModuleFor(request, options);
    // The sources behind those bytes are sources of *this* module: the
    // program embeds the runtime module's output, so a change to the
    // allocator changes the program. Recording the output's path
    // instead would read fresh here until something else rebuilt it —
    // an ordering a refactor could break without any test noticing,
    // and the symptom would be a program embedding an allocator that
    // no longer matches its source.
    for (let path in recordedDeps(runtime)) {
      onRead(path);
    }
    runtime.value
  };
  let baseOptions: CompileFileOptions = {
    entry: repoRelative(request.source),
    outPath: out.value,
    stdlibRoot: stdlibDir().value,
    projectRoot: repoRoot().value,
    packageCache: packageCacheDir(),
    testMode: request.testMode,
    time: request.time,
    debugNames: options.debug,
    warnUnnecessaryCasts: envSet('ZENA_WARN_UNNECESSARY_CASTS'),
    onRead,
    target,
    witPath: if (wit == null) { '' } else { repoRelative(wit) },
    worldName: request.world ?? '',
    extensionWitPaths: extensionWitPaths,
    optLevel,
    runtimeMemoryPath: runtimeMemory,
    compactImports: request.compactImports,
  };
  let stringConstants = request.importedStringConstants;
  return if (stringConstants == null) {
    baseOptions
  } else {
    {...baseOptions, importedStringConstants: stringConstants}
  };
}

/**
 * Runs another compiler module, as `zc`, with the preopens it expects:
 * the repository root as `.`, the standard library as `/stdlib`, and
 * the output's directory under its own name.
 */
function compileWith(
  compiler: AbsolutePath,
  request: CompileRequest,
  options: Options,
  out: AbsolutePath,
  quiet: boolean,
): void {
  let args = new GrowableArray<String>();
  args.push('zc');
  args.push(repoRelative(request.source));
  args.push('-o');
  args.push(out.value);
  let target = request.target;
  if (target != null) {
    args.push('-t');
    args.push(target);
  }
  if (request.time) {
    args.push('--time');
  }
  if (request.testMode) {
    args.push('--test');
  }
  let wit = request.wit;
  if (wit != null) {
    args.push('--wit');
    args.push(repoRelative(wit));
  }
  let world = request.world;
  if (world != null) {
    args.push('--world');
    args.push(world);
  }
  let stringConstants = request.importedStringConstants;
  if (stringConstants != null) {
    args.push('--imported-string-constants');
    args.push(stringConstants);
  }
  if (request.compactImports) {
    args.push('--compact-imports');
  }
  let outDir = dirname(out.value);
  // Flags reach the compiler as environment variables: the checked-in
  // bootstrap predates them and would read an unknown flag as the input
  // file.
  let env = new Map<String, String>();
  if (options.debug) {
    env['ZENA_DEBUG_NAMES'] = '1';
  }
  let level = options.optLevel;
  if (level != null) {
    env['ZENA_OPT_LEVEL'] = level;
  }
  let result = runModule(compiler.value, {
    args: args,
    env: env,
    inheritEnv: true,
    dirs: [
      {from: repoRoot().value, to: '.'},
      {from: stdlibDir().value, to: '/stdlib'},
      {from: outDir, to: outDir},
    ],
    inheritStdio: !quiet,
  });
  if (result.succeeded() && isFileSync(out.value)) {
    return;
  }
  printCaptured(result.stdout);
  printCaptured(result.stderr);
  if (result.message != '') {
    console.error(result.message);
  }
  throw new CompileFailure(`${request.source.value} did not compile`);
}

function printCaptured(text: String): void {
  if (text == '') {
    return;
  }
  if (text.endsWith('\n')) {
    console.error(text.sliceBytes(0, text.length - 1));
  } else {
    console.error(text);
  }
}

/** Creates a directory and any parents it needs. */
export function ensureDir(path: String): void {
  if (path == '' || path == '/' || path == '.' || existsSync(path)) {
    return;
  }
  ensureDir(dirname(path));
  try {
    mkdirSync(path);
  } catch (e) {
    // Another process may have made it since `exists` said no: `zena
    // test` compiles its files in parallel, into one cache directory.
    if (!isDirectorySync(path)) {
      throw e;
    }
  }
}

/**
 * Where compiled modules are cached: `.zena/cache` in the repository
 * when ZENA_PROJECT_CACHE or ZENA_LOCAL_CACHE is set, and otherwise
 * `zena/wasm_objects` under the user's cache directory.
 */
export function cacheDir(): String {
  return cacheSubdir('cache', 'wasm_objects');
}

/**
 * Where `zena fetch` keeps packages and the compiler reads them:
 * `.zena/packages` in the repository when ZENA_PROJECT_CACHE or
 * ZENA_LOCAL_CACHE is set, and otherwise `zena/packages` under the
 * user's cache directory.
 */
export function packageCacheDir(): String {
  return cacheSubdir('packages', 'packages');
}

/**
 * `.zena/<inProject>` in the repository when ZENA_PROJECT_CACHE or
 * ZENA_LOCAL_CACHE is set or there is no user cache directory, and
 * otherwise `<inUserCache>` under $ZENA_CACHE_DIR, $XDG_CACHE_HOME/zena
 * or $HOME/.cache/zena.
 */
function cacheSubdir(inProject: String, inUserCache: String): String {
  if (envSet('ZENA_PROJECT_CACHE') || envSet('ZENA_LOCAL_CACHE')) {
    return `${repoRoot().value}/.zena/${inProject}`;
  }
  let custom = getEnv('ZENA_CACHE_DIR');
  if (custom != null && custom != '') {
    return `${custom}/${inUserCache}`;
  }
  let xdg = getEnv('XDG_CACHE_HOME');
  if (xdg != null && xdg != '') {
    return `${xdg}/zena/${inUserCache}`;
  }
  let home = getEnv('HOME');
  if (home == null || home == '') {
    return `${repoRoot().value}/.zena/${inProject}`;
  }
  return `${home}/.cache/zena/${inUserCache}`;
}

/** A file's identity for the cache: its modification time and size. */
function identity(path: String) {
  let info = statSync(path);
  return `${info.modified} ${info.size}`;
}

/** What decides the module a compile produces, apart from its sources. */
function cacheKey(request: CompileRequest, options: Options) {
  let compiler = getEnv('ZENA_COMPILER_WASM') ?? cliModule().value;
  var key = `zena-cache-1\n${request.source.value}\n`;
  key = key + `test=${request.testMode} debug=${options.debug}\n`;
  key = key + `target=${request.target ?? ''} opt=${optLevelText(options)}\n`;
  key = key + `strings=${request.importedStringConstants ?? ''}\n`;
  key = key + `compact=${request.compactImports}\n`;
  key = key + `wide=${envSet('ZENA_WIDE_ARITHMETIC')}\n`;
  key = `${key}${compiler} ${identity(resolveUserPath(compiler).value)}\n`;
  return sha256HexOfString(key).sliceBytes(0, 16);
}

/** The index of the first space at or after `from`, or -1. */
function spaceAfter(text: String, from: i32): i32 {
  if (from < 0) {
    return -1;
  }
  for (var i = from; i < text.length; i += 1) {
    if (text.getByteAt(i) == 32) {
      return i;
    }
  }
  return -1;
}

function joinLines(lines: Array<String>) {
  var text = '';
  for (let line in lines) {
    text = `${text}${line}\n`;
  }
  return text;
}

/**
 * Whether every file a cache entry lists still has the modification
 * time and size it had when the entry was written.
 */
function entryIsFresh(depsPath: String, modulePath: String): boolean {
  if (!isFileSync(depsPath) || !isFileSync(modulePath)) {
    return false;
  }
  let lines = readFileSync(depsPath).split('\n');
  var checked = 0;
  for (let line in lines) {
    if (line == '') {
      continue;
    }
    // "<modified> <size> <path>"; the path may contain spaces.
    let first = spaceAfter(line, 0);
    let second = spaceAfter(line, first + 1);
    if (first < 0 || second < 0) {
      return false;
    }
    let path = line.sliceBytes(second + 1, line.length);
    let recorded = line.sliceBytes(0, second);
    let current = try { identity(path) } catch (e) { '' };
    if (current != recorded) {
      return false;
    }
    checked += 1;
  }
  return checked > 0;
}

/** The name of `request`'s entry in the cache, before `.wasm` and `.deps`. */
function cacheName(request: CompileRequest, options: Options) {
  let stem = basename(request.source.value, extname(request.source.value));
  return `${stem}_${cacheKey(request, options)}`;
}

/** Whether the cache holds a fresh module for `request`. */
export function isCached(request: CompileRequest, options: Options): boolean {
  if (getEnv('ZENA_COMPILER_WASM') != null) {
    return false;
  }
  let name = `${cacheDir()}/${cacheName(request, options)}`;
  return entryIsFresh(`${name}.deps`, `${name}.wasm`);
}

/**
 * Compiles through the cache and returns the cached module's path.
 * A module that is already there and fresh is not compiled again.
 */
export function compileCached(
  request: CompileRequest,
  options: Options,
  noCache: boolean = false,
  quiet: boolean = true,
): AbsolutePath {
  let dir = cacheDir();
  ensureDir(dir);
  let name = cacheName(request, options);
  let modulePath = `${dir}/${name}.wasm`;
  let depsPath = `${dir}/${name}.deps`;
  if (!noCache && getEnv('ZENA_COMPILER_WASM') == null &&
      entryIsFresh(depsPath, modulePath)) {
    return new AbsolutePath(modulePath);
  }

  // Written beside the entry and renamed into place, so a reader never
  // sees half a module. Two processes compiling the same file at once
  // both compile it, and the second rename wins.
  let unique = i64ToString(monotonic() as i64);
  let tempModule = `${dir}/${name}.tmp-${unique}.wasm`;
  let deps = new GrowableArray<String>();
  let seen = new HashSet<String>();
  compileRecording(
    request,
    options,
    new AbsolutePath(tempModule),
    quiet,
    (path) => {
      if (seen.add(path)) {
        // Taken before the compiler reads the file, so an edit made
        // during the compile leaves the entry stale, not wrongly fresh.
        try {
          deps.push(`${identity(path)} ${path}`);
        } catch (e) {
          // A file that cannot be read fails the compile anyway.
        }
      }
    },
  );
  renameSync(tempModule, modulePath);
  let tempDeps = `${dir}/${name}.tmp-${unique}.deps`;
  writeFileSync(tempDeps, joinLines(deps));
  renameSync(tempDeps, depsPath);
  return new AbsolutePath(modulePath);
}

/**
 * Compiles each of `requests` the cache does not already hold fresh, all
 * with one compiler session, and stores each module where
 * `compileCached` finds it. The requests may differ only in their
 * source: the session is opened with the first one's settings.
 *
 * From the second compile on, what the entries share is loaded, parsed
 * and checked once (`CompileSession`), so the files a compile reads are
 * no longer the files it depends on. Each entry's `.deps` lists instead
 * what the session read before its first compile (the workspace's
 * manifests, the WIT, the runtime memory module's sources) and the files
 * its own program is made of (`CompileSession.sources`), each with its
 * identity from when the compiler read it, so an edit made since leaves
 * the entry stale and never wrongly fresh.
 *
 * A request that does not compile is left out of the cache, and
 * `compileCached` compiles it again, alone, for whoever asks next and
 * reports why. Nothing can be shared with the compiler module
 * ZENA_COMPILER_WASM names, so with it set nothing is compiled here.
 */
export function compileIntoCache(requests: Array<CompileRequest>, options: Options): void {
  if (requests.length == 0 || getEnv('ZENA_COMPILER_WASM') != null) {
    return;
  }
  let dir = cacheDir();
  ensureDir(dir);
  let stale = new GrowableArray<CompileRequest>();
  for (let request in requests) {
    if (!isCached(request, options)) {
      stale.push(request);
    }
  }
  if (stale.length == 0) {
    return;
  }
  // Each file's identity when the compiler last read it, and the files
  // the session read before its first compile.
  let identities = new HashMap<String, String>();
  let setup = new GrowableArray<String>();
  var opened = false;
  let onRead = (path: String) => {
    try {
      identities[path] = identity(path);
    } catch (e) {
      // A file that cannot be read fails the compile anyway.
    }
    if (!opened) {
      setup.push(path);
    }
  };
  let unique = i64ToString(monotonic() as i64);
  let first = stale[0];
  var opening: CompileSession | null = null;
  try {
    let out = new AbsolutePath(`${dir}/${cacheName(first, options)}.tmp-${unique}.wasm`);
    opening = openCompileSession(compileFileOptions(first, options, out, onRead));
  } catch (e) {
    // The compile `compileCached` runs for each of them reports it.
  }
  opened = true;
  if (opening == null) {
    return;
  }
  let session = opening as CompileSession;
  for (let request in stale) {
    let name = cacheName(request, options);
    let tempModule = `${dir}/${name}.tmp-${unique}.wasm`;
    var status = 1;
    try {
      status = session.compile(repoRelative(request.source), tempModule);
    } catch (e) {
      // A throw out of the compiler belongs to this entry alone; the
      // compile `compileCached` runs for it meets it again.
    }
    if (status != 0 || !isFileSync(tempModule)) {
      if (existsSync(tempModule)) {
        unlinkSync(tempModule);
      }
      continue;
    }
    let seen = new HashSet<String>();
    let deps = new GrowableArray<String>();
    for (let path in setup) {
      recordDep(path, identities, seen, deps);
    }
    for (let path in session.sources) {
      recordDep(path, identities, seen, deps);
    }
    renameSync(tempModule, `${dir}/${name}.wasm`);
    let tempDeps = `${dir}/${name}.tmp-${unique}.deps`;
    writeFileSync(tempDeps, joinLines(deps));
    renameSync(tempDeps, `${dir}/${name}.deps`);
  }
}

/** Adds `path`'s `.deps` line, with the identity it was read with, once. */
function recordDep(
  path: String,
  identities: HashMap<String, String>,
  seen: HashSet<String>,
  deps: GrowableArray<String>,
): void {
  if (!seen.add(path)) {
    return;
  }
  if (let (true, recorded) = identities.get(path)) {
    deps.push(`${recorded} ${path}`);
  }
}
