/**
 * Where the `zena` command is running: what the host told it, and the
 * flags every subcommand shares.
 *
 * The host (`zena-cli`) preopens the repository root as `.` and the
 * whole filesystem as `/`, so a relative path here is relative to the
 * repository root, which is where the compiler expects to find
 * `zena-packages.json` and the standard library. The user ran the
 * command from somewhere else, so paths they type are measured from
 * `ZENA_CWD` instead. The host sets three variables:
 *
 * - `ZENA_REPO_ROOT`: the repository root, absolute.
 * - `ZENA_CWD`: the directory the user ran the command from.
 * - `ZENA_CLI_MODULE`: this module's own path, so the test runner can
 *   start copies of it.
 *
 * It also sets `ZENA_AVAILABLE_PARALLELISM`, the number of CPUs, which
 * WASI has no way to ask for.
 */

import { getEnv } from 'zena:cli';
import { AbsolutePath, RelativePath, isAbsolute, join2, normalize } from 'zena:path';

/** The flags that apply to every subcommand. */
export final class Options {
  verbose: boolean;
  debug: boolean;
  /** -O's value, or null to leave the compiler's default alone. */
  optLevel: String | null;

  new(this.verbose, this.debug, this.optLevel);
}

let envOrFail = (name: String): String => {
  let value = getEnv(name);
  if (value == null) {
    throw new Error(
      `${name} is not set: this program runs under the zena-cli host`,
    );
  }
  return value;
};

/** The repository root, which is this program's working directory. */
export let repoRoot = (): AbsolutePath =>
  new AbsolutePath(envOrFail('ZENA_REPO_ROOT'));

/** The directory the user ran the command from. */
export let userCwd = (): AbsolutePath => new AbsolutePath(envOrFail('ZENA_CWD'));

/** This module, as a path the host can run. */
export let cliModule = (): AbsolutePath =>
  new AbsolutePath(envOrFail('ZENA_CLI_MODULE'));

/**
 * The variables the host set for this module, to hand to a copy of it.
 * A run's `inheritEnv` passes on the host process's environment, which
 * does not have them: the host sets them in this module's WASI
 * environment only.
 */
export let hostEnv = (): Map<String, String> => {
  let env = new Map<String, String>();
  for (let name in [
    'ZENA_REPO_ROOT',
    'ZENA_CWD',
    'ZENA_CLI_MODULE',
    'ZENA_AVAILABLE_PARALLELISM',
  ]) {
    let value = getEnv(name);
    if (value != null) {
      env[name] = value;
    }
  }
  return env;
};

/** The standard library's source directory. */
export let stdlibDir = (): AbsolutePath =>
  repoRoot().join(new RelativePath('packages/stdlib/zena'));

/**
 * A path the user typed, as an absolute one, measured from where they
 * ran the command. `..` segments are resolved here, because
 * `zena:wasm` refuses a path that has one.
 */
export let resolveUserPath = (path: String): AbsolutePath => {
  if (isAbsolute(path)) {
    return new AbsolutePath(normalize(path));
  }
  return new AbsolutePath(normalize(join2(userCwd().value, path)));
};

/**
 * A path as the compiler names files: relative to the repository root
 * when it is inside it, and absolute otherwise.
 */
export let repoRelative = (path: AbsolutePath): String => {
  let relative = path.stripPrefix(repoRoot());
  if (relative == null) {
    return path.value;
  }
  return relative.value;
};

/** An environment variable as a positive number, or 0. */
export let envInt = (name: String): i32 => {
  let raw = getEnv(name);
  if (raw == null) {
    return 0;
  }
  if (let (true, value) = parseI32(raw)) {
    return value;
  }
  return 0;
};

/** ZENA_TEST_PARALLELISM, or the machine's CPUs up to eight. */
export let parallelism = (): i32 => {
  let configured = envInt('ZENA_TEST_PARALLELISM');
  if (configured > 0) {
    return configured;
  }
  let available = envInt('ZENA_AVAILABLE_PARALLELISM');
  if (available <= 0) {
    return 4;
  }
  if (available > 8) {
    return 8;
  }
  return available;
};

/** True when an environment variable is set to anything. */
export let envSet = (name: String): boolean => getEnv(name) != null;
