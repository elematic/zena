/**
 * `zena pkg retract <version>`: marks a release as retracted
 * (docs/design/package-manager.md, "Retraction"). The release stays, for
 * the builds that pin it, and choosing a version skips it. Any maintainer
 * may retract a release; the command writes the retraction through the
 * registry and attests it in the maintainer's own repository, as `zena pkg
 * publish` does a release.
 */

import { ParsedArgs } from 'zena:args';
import { Future } from 'zena:async';
import { JsonObject } from 'zena:json';
import { Cid } from 'atproto/cid';
import { parsePackageVersion } from 'package-manager/records';
import { Options } from './env.zena';
import { packageDid } from './members.zena';
import { PublishError, attest, findRegistry, registryClient, runCommand, saveIfRefreshed, signedIn } from './publish.zena';
import { RETRACT } from 'package-manager/registry-methods';

export async function retractCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    if (args.rest.length != 1) {
      throw new PublishError('give the version: zena pkg retract <version> [--reason <why>] [--package <package>]');
    }
    let version = args.rest[0];
    try {
      parsePackageVersion(version);
    } catch (e) {
      throw new PublishError(`'${version}' is not a version`);
    }
    let session = await signedIn();
    let registry = await findRegistry(args);
    let pkg = await packageDid(registry, args);
    let input = new JsonObject();
    input['package'] = pkg;
    input['version'] = version;
    if (let (true, reason) = args.getOption('reason')) {
      input['reason'] = reason;
    }
    let client = await registryClient(session, registry, RETRACT);
    let written = (await client.procedure(RETRACT, input)) as JsonObject;
    await attest(session, written['uri'] as String, Cid.parse(written['cid'] as String));
    console.log(`Retracted ${version} of ${pkg}. Builds that pin it still use it; choosing a version skips it.`);
    await saveIfRefreshed(session);
  });
}
