/**
 * `zena` — the command line.
 *
 * This is the CLI module: the whole `zena` command, compiled to one Wasm
 * module that the `zena-cli` binary runs. It reads the command line,
 * compiles with the compiler linked into it, runs programs and tests
 * with `zena:wasm`, and builds targets with zb. See
 * docs/design/cli-module.md, and env.zena for what the host tells it.
 */

import { ArgParser, OptionType, ParsedArgs } from 'zena:args';
import { Future } from 'zena:async';
import { getArguments, getEnv } from 'zena:cli';
import { exists, isFile, readFile, writeFile } from 'zena:fs';
import { JsonArray, JsonObject, parseJson } from 'zena:json';
import { AbsolutePath, extname } from 'zena:path';
import { precompileModule } from 'zena:wasm';
import { DiagnosticSeverity, SourceSpan } from 'zena-compiler/diagnostics';
import { format } from 'zena-formatter/printer';
import { documentPackage, DocumentOptions } from 'zenadoc/document';
import { packageToJson } from 'zenadoc/json';
import { loadPackage } from 'zenadoc/package';
import { BuildOutcome, buildTarget, reportBuild, reportMigration, watchTarget } from 'zb/runner';
import { ScriptRef } from 'zb/wireit-config';
import { migrateWorkspaceToZebra } from 'zb/zebra-config';
import { benchCommand } from './bench-run.zena';
import { CompileFailure, CompileRequest, compileTo } from './compile.zena';
import { Options, repoRelative, resolveUserPath, userCwd } from './env.zena';
import { runCommand } from './run.zena';
import { lspCommand } from './lsp.zena';
import { testCommand } from './test-run.zena';
import { lintCommand } from './lint.zena';
import { fetchCommand } from './fetch.zena';
import { addCommand, updateCommand } from './add.zena';
import { loginCommand, logoutCommand } from './login.zena';
import { DEFAULT_REGISTRY, packageCreateCommand, publishCommand } from './publish.zena';
import { scopeCreateCommand, scopeInfoCommand, scopeProfileCommand } from './scope.zena';
import {
  ownerCommand, scopeAddCommand, scopeMembersCommand, scopePolicyCommand, scopeRemoveCommand, scopeSettingsCommand,
  teamCommand
} from './members.zena';
import { approveCommand } from './approve.zena';
import { retractCommand } from './retract.zena';
import { ciCommand } from './ci.zena';

/** The help of every `zena pkg` command's `--registry`. */
let REGISTRY_HELP = `The package registry (default $ZENA_REGISTRY, else ${DEFAULT_REGISTRY})`;

/** The whole command line, described once. */
function describe() {
  let help = {type: OptionType.Flag, abbr: 'h', help: 'Print help'};
  let noCache = {
    type: OptionType.Flag,
    help: 'Compile even if the cache has an answer',
  };
  let allowChanged = {
    type: OptionType.Flag,
    help: 'Pin releases whose CIDs changed at the same version, instead of refusing',
  };
  let time = {type: OptionType.Flag, help: "Print the compiler's phase timings"};
  let parser = new ArgParser.fromConfig({
    name: 'zena',
    help: 'The Zena compiler and toolchain',
    options: {
      'help' => help,
      'version' => {type: OptionType.Flag, abbr: 'V', help: 'Print the version'},
      'verbose' => {
        type: OptionType.Flag,
        abbr: 'v',
        help: 'Print what the tool is doing',
      },
      'debug' => {
        type: OptionType.Flag,
        abbr: 'g',
        help: 'Name functions in modules, turn off inlining so traps name them, and check `debug` contract clauses',
      },
      'opt-level' => {abbr: 'O', help: 'Optimization level: 0, 1, 2 or s'},
    },
    commands: {
      'build' => {
        help: 'Compile a Zena file to WebAssembly, or build a target',
        options: {
          'help' => help,
          'output' => {abbr: 'o', help: 'Where to write the module'},
          'target' => {
            abbr: 't',
            help: 'Compilation target: zena-component (default), component, core, js, or zena-js',
          },
          'wit' => {help: "The component's world, a .wit file or directory"},
          'world' => {help: 'Which world, when the document declares several'},
          'extension-wit' => {
            type: OptionType.MultiString,
            help: "An extension's WIT, which the world's views of its interfaces are checked against",
          },
          'imported-string-constants' => {
            help: 'The module --target js or zena-js imports string literals from (default _)',
          },
          'compact-imports' => {
            type: OptionType.Flag,
            help: 'Group imports by module and type (experimental: the compact import section proposal)',
          },
          'jobs' => {
            abbr: 'j',
            help: 'Maximum concurrent target scripts to run',
          },
          'watch' => {
            type: OptionType.Flag,
            abbr: 'w',
            help: 'Watch target inputs and rebuild incrementally',
          },
          'force' => {
            type: OptionType.Flag,
            abbr: 'f',
            help: 'Rebuild target scripts even when fresh or cached',
          },
          'verbose' => {
            type: OptionType.Flag,
            abbr: 'v',
            help: 'List fresh and skipped target steps and print step command output',
          },
          'migrate' => {
            type: OptionType.Flag,
            help: 'Convert package.json wireit scripts into zena-package.json or zebra.json',
          },
          'dry-run' => {
            type: OptionType.Flag,
            help: 'Preview migrated zena-package.json or zebra.json files without writing them',
          },
          'time' => time,
          'no-cache' => noCache,
        },
      },
      'run' => {
        help: 'Compile and run a Zena file, or run a compiled module',
        // Everything after the file belongs to the program being run.
        stopAtPositional: true,
        options: {
          'help' => help,
          'invoke' => {help: 'The exported function to call'},
          'dir' => {
            type: OptionType.MultiString,
            help: 'Pre-open a directory, as HOST or HOST::GUEST',
          },
          'time' => time,
          'no-cache' => noCache,
          'allow-spawn' => {
            type: OptionType.Flag,
            help: 'Let the program spawn processes and run modules',
          },
          'allow-extensions' => {
            type: OptionType.Flag,
            help: 'Let the program load components as extensions',
          },
        },
      },
      'test' => {
        help: 'Run the test suites in .zena files',
        options: {
          'help' => help,
          'filter' => {
            abbr: 'f',
            help: 'Only run files whose path contains this',
          },
          'exclude' => {
            type: OptionType.MultiString,
            help: 'Skip files matching this glob',
          },
          'single' => {
            type: OptionType.Flag,
            help: 'Run one file in this process (what each test runs as)',
          },
          'compile' => {
            type: OptionType.Flag,
            help: 'Compile the files into the cache on one compiler, and run none (what the runner starts first)',
          },
        },
      },
      'doc' => {
        help: "Extract a package's API as JSON",
        options: {
          'help' => help,
          'output' => {abbr: 'o', help: 'Where to write the JSON'},
          'name' => {help: "The package's name, overriding the manifest's"},
          'target' => {
            abbr: 't',
            defaultVal: 'zena-component',
            help: 'Which target decides virtual modules',
          },
          'include-private' => {
            type: OptionType.Flag,
            help: 'Document non-exported and #private members',
          },
        },
      },
      'lint' => {
        help: 'Report what the lint rules find in Zena files, or fix it',
        options: {
          'help' => help,
          'fix' => {
            type: OptionType.Flag,
            help: 'Rewrite the files, keeping each fix the checker accepts',
          },
          'only' => {help: 'Run only these rules, comma-separated'},
          'skip' => {help: 'Run every rule but these, comma-separated'},
          'list-rules' => {type: OptionType.Flag, help: 'Print the rules'},
        },
      },
      'fmt' => {
        help: 'Format Zena files',
        options: {
          'help' => help,
          'write' => {
            type: OptionType.Flag,
            abbr: 'w',
            help: 'Rewrite the files in place',
          },
          'check' => {
            type: OptionType.Flag,
            help: 'List files that are not formatted, and fail if any',
          },
        },
      },
      'bench' => {
        help: 'Run a benchmark suite, comparing variants round-robin',
        options: {
          'help' => help,
          'out' => {abbr: 'o', help: 'Where to write the report JSON'},
        },
      },
      'lsp' => {
        help: 'Run a language server over stdin and stdout',
        options: {'help' => help},
      },
      'precompile' => {
        help: 'Compile a .wasm to machine code ahead of its first run',
        options: {'help' => help},
      },
    },
  });
  // The commands about packages, which come up less often than building
  // and testing, under one noun: `zena pkg add`.
  parser.addCommand('pkg', {
    help: 'Add, fetch and publish packages, and change who maintains them',
    options: {'help' => help},
  }).addCommands({
    'add' => {
      help: 'Add a package to the dependencies, pin it, and fetch it',
      options: {
        'help' => help,
        'name' => {help: 'The local name for the package, a name or scope:name, instead of scope:name or the one it suggests'},
        'allow-changed' => allowChanged,
      },
    },
    'update' => {
      help: 'Raise dependencies to their latest versions, pin them, and fetch them',
      options: {'help' => help, 'allow-changed' => allowChanged},
    },
    'fetch' => {
      help: 'Fetch the packages zena-lock.json pins into the package cache',
      options: {'help' => help},
    },
    'login' => {
      help: 'Sign in to your atproto account with an app password, to publish',
      options: {
        'help' => help,
        'password-stdin' => {
          type: OptionType.Flag,
          help: 'Read the app password from stdin',
        },
      },
    },
    'logout' => {
      help: 'End the session zena pkg login started',
      options: {'help' => help},
    },
    'publish' => {
      help: "Publish the package you are in, at its manifest's version, as you, or as CI with $ZENA_REGISTRY_TOKEN",
      options: {
        'help' => help,
        'registry' => {help: REGISTRY_HELP},
        'scope' => {help: 'The scope to create a new package in, when its manifest names none'},
        'yes' => {type: OptionType.Flag, help: 'Create the package if it has no DID yet'},
      },
    },
    'scope' => {
      help: 'scope create <name> | info <scope> | members <scope> | add <scope> <person> | remove <scope> <person> | settings <scope> | policy <scope> | profile <scope>',
      options: {
        'help' => help,
        'registry' => {help: REGISTRY_HELP},
        'yes' => {type: OptionType.Flag, help: 'Create it'},
        'role' => {help: 'With add: member (the default), admin or owner'},
        'owner-threshold' => {help: "With settings: how many owners must approve a change to the scope's members"},
        'admin-threshold' => {help: "With settings: how many admins or owners must approve a change to one of its teams"},
        'minimum-threshold' => {help: 'With policy: the fewest approvals a release of any package in the scope needs'},
        'minimum-humans' => {help: "With policy: the fewest of a release's approvals that must come from people"},
        'default-teams' => {help: 'With policy: the teams new packages start maintained by, as <team>:<role>,...'},
        'default-threshold' => {help: 'With policy: the release threshold new packages start with'},
        'default-owner-threshold' => {help: 'With policy: the owner threshold new packages start with'},
        'default-humans' => {help: 'With policy: the humans new packages start with'},
        'creators' => {help: 'With policy: the teams whose members may create packages, as <team>,...'},
        'name' => {help: "With profile: the scope's display name (empty clears it)"},
        'description' => {help: 'With profile: what the scope is (empty clears it)'},
        'website' => {help: "With profile: the scope's website, an http: or https: URL (empty clears it)"},
      },
    },
    'team' => {
      help: 'team create|delete|members|settings <scope>/<team> | add|remove <scope>/<team> <person>',
      options: {
        'help' => help,
        'registry' => {help: REGISTRY_HELP},
        'role' => {help: 'With add: member (the default) or maintainer'},
        'threshold' => {help: "With settings: how many of the team's maintainers must approve a change to it"},
      },
    },
    'owner' => {
      help: "owner add|remove <person> | add|remove --team <scope>/<team> | list | settings: a package's maintainers",
      options: {
        'help' => help,
        'registry' => {help: REGISTRY_HELP},
        'role' => {help: 'With add: publisher (the default) or owner'},
        'team' => {help: 'A team, <scope>/<team>, in place of a person'},
        'package' => {help: 'The package, by DID, handle or scope:name (default: the one you are in)'},
        'automation' => {type: OptionType.Flag, help: 'With add: the person is an automation account, from zena pkg ci create'},
        'threshold' => {help: 'With settings: how many maintainers must approve a release'},
        'owner-threshold' => {help: 'With settings: how many owners must approve a change to the maintainers'},
        'humans' => {help: "With settings: how many of a release's approvals must come from people, not automation"},
      },
    },
    'ci' => {
      help: 'ci create <scope>/<name>: an automation account for CI to publish as, and its token; ci token <scope>/<name>: a new token for it',
      options: {
        'help' => help,
        'registry' => {help: REGISTRY_HELP},
      },
    },
    'approve' => {
      help: 'approve [<package>@]<version> | <scope> | <package>: show a release, or changes to who belongs, waiting for approval, and with --yes, approve them',
      options: {
        'help' => help,
        'registry' => {help: REGISTRY_HELP},
        'yes' => {type: OptionType.Flag, help: 'Approve it'},
      },
    },
    'retract' => {
      help: 'Retract a published version: builds that pin it keep it, and choosing a version skips it',
      options: {
        'help' => help,
        'registry' => {help: REGISTRY_HELP},
        'reason' => {help: 'Why, for those who depend on it'},
        'package' => {help: 'The package, by DID, handle or scope:name (default: the one you are in)'},
      },
    },
    'create' => {
      help: 'Create the package you are in on a registry, without publishing',
      options: {
        'help' => help,
        'registry' => {help: REGISTRY_HELP},
        'scope' => {help: 'The scope to create the package in, when its manifest names none'},
        'yes' => {type: OptionType.Flag, help: 'Create it'},
      },
    },
  });
  return parser;
}

export async function main(): Future<i32> {
  let parser = describe();
  var parsed: ParsedArgs | null = null;
  try {
    parsed = parser.parse(getArguments(), 1);
  } catch (e) {
    console.error('Error: ' + e.message);
    console.error('');
    console.error(parser.formatHelp());
    return 2;
  }
  let args = parsed;
  if (args == null) {
    return 2;
  }
  try {
    return await dispatch(parser, args);
  } catch (e) {
    if (e is CompileFailure) {
      // The compiler has already said what went wrong.
      console.error('Error: ' + e.message);
      return 1;
    }
    console.error('Error: ' + e.message);
    return 1;
  }
}

async function dispatch(parser: ArgParser, args: ParsedArgs): Future<i32> {
  if (args.getFlag('version')) {
    console.log('zena ' + (getEnv('ZENA_VERSION') ?? 'dev'));
    return 0;
  }
  let name = args.commandName;
  let sub = args.commandArgs;
  if (name == null || sub == null) {
    if (args.getFlag('help')) {
      console.log(parser.formatHelp());
      return 0;
    }
    if (args.rest.length > 0) {
      let unknown = args.rest[0];
      let pkg = parser.command('pkg') as ArgParser;
      if (pkg.command(unknown) != null) {
        console.error(`Error: no such command: ${unknown}. The package commands are under zena pkg: zena pkg ${unknown}`);
      } else {
        console.error(`Error: no such command: ${unknown}`);
      }
      return 2;
    }
    console.error('Error: a command is required');
    console.error('');
    console.error(parser.formatHelp());
    return 2;
  }
  if (sub.getFlag('help')) {
    console.log((parser.command(name) ?? parser).formatHelp());
    return 0;
  }
  var optLevel: String | null = null;
  if (let (true, level) = args.getOption('opt-level')) {
    optLevel = level;
  }
  let options = new Options(args.getFlag('verbose'), args.getFlag('debug'), optLevel);
  if (name == 'build') {
    return await build(sub, options);
  }
  if (name == 'run') {
    return await runCommand(sub, options);
  }
  if (name == 'test') {
    return await testCommand(sub, options);
  }
  if (name == 'doc') {
    return await doc(sub);
  }
  if (name == 'fmt') {
    return await fmt(sub);
  }
  if (name == 'lint') {
    return await lintCommand(sub, options);
  }
  if (name == 'pkg') {
    return await pkgCommand(parser.command('pkg') as ArgParser, sub, options);
  }
  if (name == 'bench') {
    return await benchCommand(sub, options);
  }
  if (name == 'lsp') {
    return await lspCommand(sub, options);
  }
  if (name == 'precompile') {
    return precompile(sub, options);
  }
  console.error('Error: no such command: ' + name);
  return 2;
}

/** `zena pkg <command>`: the commands about packages, which `pkg` parses. */
async function pkgCommand(pkg: ArgParser, args: ParsedArgs, options: Options): Future<i32> {
  let name = args.commandName;
  let sub = args.commandArgs;
  if (name == null || sub == null) {
    if (args.rest.length > 0) {
      console.error(`Error: no such command: zena pkg ${args.rest[0]}`);
      console.error('');
    } else {
      console.error('Error: zena pkg takes a command');
      console.error('');
    }
    console.error(pkg.formatHelp());
    return 2;
  }
  if (sub.getFlag('help')) {
    console.log((pkg.command(name) ?? pkg).formatHelp());
    return 0;
  }
  if (name == 'fetch') {
    return await fetchCommand(sub, options);
  }
  if (name == 'add') {
    return await addCommand(sub, options);
  }
  if (name == 'update') {
    return await updateCommand(sub, options);
  }
  if (name == 'login') {
    return await loginCommand(sub, options);
  }
  if (name == 'logout') {
    return await logoutCommand(sub, options);
  }
  if (name == 'publish') {
    return await publishCommand(sub, options);
  }
  if (name == 'create') {
    if (sub.rest.length != 0) {
      console.error('Error: zena pkg create takes no arguments: it creates the package you are in');
      return 2;
    }
    return await packageCreateCommand(sub, options);
  }
  if (name == 'scope') {
    if (sub.rest.length > 0 && sub.rest[0] == 'create') {
      return await scopeCreateCommand(sub, options);
    }
    if (sub.rest.length > 0 && sub.rest[0] == 'info') {
      return await scopeInfoCommand(sub, options);
    }
    if (sub.rest.length > 0 && sub.rest[0] == 'members') {
      return await scopeMembersCommand(sub, options);
    }
    if (sub.rest.length > 0 && sub.rest[0] == 'add') {
      return await scopeAddCommand(sub, options);
    }
    if (sub.rest.length > 0 && sub.rest[0] == 'remove') {
      return await scopeRemoveCommand(sub, options);
    }
    if (sub.rest.length > 0 && sub.rest[0] == 'settings') {
      return await scopeSettingsCommand(sub, options);
    }
    if (sub.rest.length > 0 && sub.rest[0] == 'policy') {
      return await scopePolicyCommand(sub, options);
    }
    if (sub.rest.length > 0 && sub.rest[0] == 'profile') {
      return await scopeProfileCommand(sub, options);
    }
    console.error('Error: zena pkg scope create <name> | info <scope> | members <scope> | add <scope> <person> | remove <scope> <person> | settings <scope> | policy <scope> | profile <scope>');
    return 2;
  }
  if (name == 'team') {
    return await teamCommand(sub, options);
  }
  if (name == 'retract') {
    return await retractCommand(sub, options);
  }
  if (name == 'approve') {
    return await approveCommand(sub, options);
  }
  if (name == 'ci') {
    return await ciCommand(sub, options);
  }
  if (name == 'owner') {
    return await ownerCommand(sub, options);
  }
  console.error(`Error: no such command: zena pkg ${name}`);
  return 2;
}

/**
 * `zena build`: an argument naming a `.zena` file compiles that file;
 * anything else is a build target, run with zb.
 */
async function build(args: ParsedArgs, options: Options): Future<i32> {
  if (args.getFlag('migrate')) {
    let startDir = if (args.rest.length == 0)
      userCwd()
    else
      resolveUserPath(args.rest[0]);
    let root = await workspaceRoot(startDir);
    let targetDirs = new GrowableArray<String>();
    if (args.rest.length == 0) {
      if (startDir.value != root.value) {
        let rel = startDir.stripPrefix(root);
        if (rel != null) {
          targetDirs.push(rel.value);
        }
      }
    } else {
      for (let raw in args.rest) {
        let dir = resolveUserPath(raw);
        let rel = dir.stripPrefix(root);
        targetDirs.push(if (rel == null) raw else rel.value);
      }
    }
    let dryRun = args.getFlag('dry-run');
    try {
      let result = await migrateWorkspaceToZebra(
        root.value,
        targetDirs,
        args.getFlag('force'),
        dryRun,
      );
      return reportMigration(result, dryRun);
    } catch (e) {
      console.error(`Error: ${e.message}`);
      return 1;
    }
  }
  if (args.getFlag('dry-run')) {
    console.error('Error: --dry-run is only used with --migrate');
    return 2;
  }
  if (args.rest.length > 1) {
    console.error('Error: build takes one file or target');
    return 2;
  }
  var argument = 'build';
  if (args.rest.length == 1) {
    argument = args.rest[0];
    let path = resolveUserPath(argument);
    if (extname(argument) == '.zena' || await isFile(path.value)) {
      return await buildFile(args, options, argument, path);
    }
  }
  var jobs = 0;
  if (let (true, rawJobs) = args.getOption('jobs')) {
    if (let (true, parsed) = parseI32(rawJobs)) {
      if (parsed >= 1) {
        jobs = parsed;
      } else {
        console.error(`Error: invalid job count "${rawJobs}"`);
        return 2;
      }
    } else {
      console.error(`Error: invalid job count "${rawJobs}"`);
      return 2;
    }
  }
  return await buildScript(
    argument,
    jobs,
    args.getFlag('watch'),
    args.getFlag('force'),
    !args.getFlag('no-cache'),
    options.verbose || args.getFlag('verbose'),
  );
}

/**
 * Compiles one file, always: invoking `build` on a file is the request
 * to compile it, and the scripts that do so track their own inputs.
 */
async function buildFile(
  args: ParsedArgs,
  options: Options,
  argument: String,
  path: AbsolutePath,
): Future<i32> {
  if (!(await isFile(path.value))) {
    console.error(`Error: no such file: ${argument}`);
    return 2;
  }
  var output = '';
  if (let (true, value) = args.getOption('output')) {
    output = value;
  }
  if (output == '') {
    console.error('Error: build needs -o <FILE>');
    return 2;
  }
  let request = new CompileRequest(path);
  request.time = args.getFlag('time');
  if (let (true, target) = args.getOption('target')) {
    request.target = target;
  }
  if (let (true, wit) = args.getOption('wit')) {
    request.wit = resolveUserPath(wit);
  }
  if (let (true, world) = args.getOption('world')) {
    request.world = world;
  }
  for (let path in args.getMultiOption('extension-wit')) {
    request.extensionWits.push(resolveUserPath(path));
  }
  if (let (true, value) = args.getOption('imported-string-constants')) {
    request.importedStringConstants = value;
  }
  request.compactImports = args.getFlag('compact-imports');
  await compileTo(request, options, resolveUserPath(output));
  return 0;
}

/**
 * Runs a build target with zb: `test` is a script of the package the
 * user is in, and `./packages/zb:test` a script of another package, in
 * the form wireit dependencies use. The workspace is the nearest
 * directory, from where the user is, whose package.json declares
 * `workspaces`.
 */
async function buildScript(
  argument: String,
  jobs: i32 = 0,
  watch: boolean = false,
  force: boolean = false,
  useCache: boolean = true,
  verbose: boolean = false,
): Future<i32> {
  var packagePath = '.';
  var script = argument;
  if (argument.startsWith('.')) {
    var colon = -1;
    for (var i = 0; i < argument.length; i += 1) {
      if (argument.getByteAt(i) == 58) {
        colon = i;
        break;
      }
    }
    if (colon < 0) {
      packagePath = argument;
      script = 'build';
    } else {
      packagePath = argument.sliceBytes(0, colon);
      script = argument.sliceBytes(colon + 1, argument.length);
    }
  }
  let packageDir = resolveUserPath(packagePath);
  if (!(await isFile(`${packageDir.value}/zebra.json`)) &&
      !(await isFile(`${packageDir.value}/zena-package.json`)) &&
      !(await isFile(`${packageDir.value}/package.json`))) {
    console.error(`Error: no zebra.json, zena-package.json, or package.json in ${packageDir.value}`);
    return 2;
  }
  let root = await workspaceRoot(packageDir);
  let relative = packageDir.stripPrefix(root);
  let packageRef = if (relative == null) '' else relative.value;
  let entry = new ScriptRef(packageRef, script);
  var outcome: BuildOutcome | null = null;
  try {
    outcome = if (watch)
      await watchTarget(root.value, entry, jobs, force, useCache, 150 as i64, null, verbose)
    else
      await buildTarget(root.value, entry, jobs, force, useCache);
  } catch (e) {
    console.error(`Error: ${e.message}`);
    return 1;
  }
  return reportBuild(outcome, verbose);
}

function normalizeWorkspacePattern(raw: String) {
  var p = raw;
  if (p.startsWith('./')) {
    p = p.sliceBytes(2, p.length);
  }
  while (p.length > 0 && p.endsWith('/')) {
    p = p.sliceBytes(0, p.length - 1);
  }
  return p;
}

function workspacePatternMatches(rawPattern: String, rel: String) {
  let pattern = normalizeWorkspacePattern(rawPattern);
  if (pattern == '') {
    return false;
  }
  if (pattern == rel || pattern.startsWith(`${rel}/`)) {
    return true;
  }
  if (pattern.endsWith('/**')) {
    let prefix = pattern.sliceBytes(0, pattern.length - 3);
    return prefix == '' || rel == prefix || rel.startsWith(`${prefix}/`);
  }
  if (pattern == '*') {
    return rel != '' && !rel.contains('/');
  }
  if (pattern.endsWith('/*')) {
    let parent = pattern.sliceBytes(0, pattern.length - 2);
    if (!rel.startsWith(`${parent}/`)) {
      return false;
    }
    let rest = rel.sliceBytes(parent.length + 1, rel.length);
    return rest != '' && !rest.contains('/');
  }
  return false;
}

async function manifestWorkspacePatterns(path: String): Future<Array<String>?> {
  if (!(await isFile(path))) {
    return null;
  }
  try {
    let root = parseJson(
      await readFile(path),
      {allowComments: true, trackLocations: false},
    );
    if (root is JsonObject) {
      let ws = root['workspace'];
      if (ws is JsonObject) {
        let pkgs = ws['packages'];
        if (pkgs is JsonArray) {
          let out = new GrowableArray<String>();
          for (var i = 0; i < pkgs.length; i += 1) {
            let item = pkgs[i];
            if (item is String) {
              out.push(item);
            }
          }
          return out;
        }
      }
    }
  } catch (e) {
    return null;
  }
  return null;
}

async function npmWorkspacePatterns(dir: String): Future<Array<String>?> {
  let path = `${dir}/package.json`;
  if (!(await isFile(path))) {
    return null;
  }
  try {
    let root = parseJson(await readFile(path));
    if (root is JsonObject) {
      let ws = root['workspaces'];
      var arr: JsonArray | null = null;
      if (ws is JsonArray) {
        arr = ws;
      } else if (ws is JsonObject) {
        let pkgs = ws['packages'];
        if (pkgs is JsonArray) {
          arr = pkgs;
        }
      }
      if (arr != null) {
        let out = new GrowableArray<String>();
        for (var i = 0; i < arr.length; i += 1) {
          let item = arr[i];
          if (item is String) {
            out.push(item);
          }
        }
        return out;
      }
    }
  } catch (e) {
    return null;
  }
  return null;
}

function matchesAnyWorkspacePattern(
  patterns: Array<String>?,
  dir: AbsolutePath,
  from: AbsolutePath,
): boolean {
  if (patterns == null) {
    return false;
  }
  if (dir.value == from.value) {
    return true;
  }
  let rel = from.stripPrefix(dir);
  if (rel == null) {
    return false;
  }
  for (let p in patterns) {
    if (workspacePatternMatches(p, rel.value)) {
      return true;
    }
  }
  return false;
}

/**
 * The workspace root for `from`: `from` itself when its `zebra.json` or
 * `zena-package.json` declares `workspace` or its `package.json` declares
 * `workspaces`, else the nearest ancestor whose workspace patterns list
 * `from`, else `from`.
 */
async function workspaceRoot(from: AbsolutePath): Future<AbsolutePath> {
  var dir = from;
  while (true) {
    let zebraPatterns = await manifestWorkspacePatterns(`${dir.value}/zebra.json`);
    if (matchesAnyWorkspacePattern(zebraPatterns, dir, from)) {
      return dir;
    }
    let zenaPatterns = await manifestWorkspacePatterns(`${dir.value}/zena-package.json`);
    if (matchesAnyWorkspacePattern(zenaPatterns, dir, from)) {
      return dir;
    }
    let npmPatterns = await npmWorkspacePatterns(dir.value);
    if (matchesAnyWorkspacePattern(npmPatterns, dir, from)) {
      return dir;
    }
    if (dir.value == '/') {
      return from;
    }
    dir = dir.parent();
  }
  return from;
}

/**
 * `zena doc`: a package's API as JSON. An input inside the repository
 * is read repo-relative, which is what makes the `root` and `file` paths
 * in the JSON repo-relative, and so checkable in.
 */
async function doc(args: ParsedArgs): Future<i32> {
  if (args.rest.length != 1) {
    console.error('Error: doc needs a path');
    return 2;
  }
  let path = resolveUserPath(args.rest[0]);
  if (!(await exists(path.value))) {
    console.error('Error: no such path: ' + path.value);
    return 2;
  }
  let options = new DocumentOptions();
  options.includePrivate = args.getFlag('include-private');
  if (let (true, target) = args.getOption('target')) {
    options.target = target;
  }
  var name: String | null = null;
  if (let (true, value) = args.getOption('name')) {
    name = value;
  }
  let pkg = await loadPackage(repoRelative(path), name, options.target);
  let result = await documentPackage(pkg, options);
  for (let failure in result.failures) {
    console.error('Failed to document ' + failure);
  }
  for (let diagnostic in result.diagnostics) {
    if (diagnostic.severity == DiagnosticSeverity.Error) {
      console.error(where(diagnostic.location) + diagnostic.message);
    }
  }
  let json = packageToJson(result.docs);
  if (let (true, output) = args.getOption('output')) {
    await writeFile(resolveUserPath(output).value, json);
  } else {
    console.log(json);
  }
  // The JSON is written either way: a package that does not check is
  // exactly when someone wants to read its docs.
  return if (result.hasErrors()) 1 else 0;
}

function where(location: SourceSpan | null): String {
  if (location == null) {
    return '';
  }
  return location.file + ':' + i32ToString(location.line) + ':' +
      i32ToString(location.column) + ' - ';
}

/**
 * `zena fmt`: prints one file formatted, or with `--write` rewrites each
 * file, or with `--check` lists the files that are not formatted.
 */
async function fmt(args: ParsedArgs): Future<i32> {
  if (args.rest.length == 0) {
    console.error('Error: fmt needs a file');
    return 2;
  }
  let write = args.getFlag('write');
  let check = args.getFlag('check');
  if (!write && !check && args.rest.length > 1) {
    console.error('Error: fmt prints one file; use --write or --check for several');
    return 2;
  }
  var unformatted = 0;
  for (let file in args.rest) {
    let path = resolveUserPath(file).value;
    let source = await readFile(path);
    let formatted = format(source);
    if (check) {
      if (formatted != source) {
        console.log(file);
        unformatted += 1;
      }
    } else if (write) {
      if (formatted != source) {
        await writeFile(path, formatted);
      }
    } else {
      console.log(formatted);
    }
  }
  return if (unformatted > 0) 1 else 0;
}

/** `zena precompile`: machine code for a module, cached beside it. */
function precompile(args: ParsedArgs, options: Options): i32 {
  if (args.rest.length != 1) {
    console.error('Error: precompile needs a .wasm file');
    return 2;
  }
  let path = resolveUserPath(args.rest[0]);
  let failure = precompileModule(path.value, options.debug);
  if (failure != '') {
    console.error('Error: ' + failure);
    return 1;
  }
  console.log('Precompiled ' + path.value);
  return 0;
}
