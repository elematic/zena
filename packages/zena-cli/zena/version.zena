/**
 * The `zena` command's version, which `zena --version` prints and every
 * call to a registry names (`clientAgent`), so that a registry can require
 * a newer one (`APP_VIEW_MIN_CLIENT_VERSION`). Raise it with each release
 * of the command, and in a change that a registry will need clients to
 * have (packages/registry/DEVELOPMENT.md, "Requiring a newer zena").
 */

import {getEnv} from 'zena:cli';

export let CLI_VERSION = '0.1.0';

/**
 * The `user-agent` the command sends a registry: `zena/<version>`, and the
 * platform it runs on, which the host gives as `ZENA_HOST_PLATFORM`
 * (`<os>-<arch>`): `zena/0.1.0 (linux-x86_64)`.
 */
export function clientAgent(): String {
  let platform = getEnv('ZENA_HOST_PLATFORM');
  return if (platform != null) `zena/${CLI_VERSION} (${platform})` else `zena/${CLI_VERSION}`;
}
