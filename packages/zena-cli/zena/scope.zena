/**
 * `zena pkg scope create`, `zena pkg scope info` and `zena pkg scope profile`: the
 * scopes on a registry
 * (docs/design/package-manager.md, "Scopes"). A scope is an account whose
 * handle is one label below the registry's domain, with a maintainers
 * record of its owners and publishers; packages are created in it by
 * `zena pkg publish` (`publish.zena`), which never creates a scope itself.
 */

import { ParsedArgs } from 'zena:args';
import { Future } from 'zena:async';
import { JsonArray, JsonObject } from 'zena:json';
import { fromJson, toJson } from 'atproto/data';
import { XrpcClient, XrpcError } from 'atproto/xrpc';
import {
  MEMBERS_TYPE, OWNER, RecordError, SCOPE_MAINTAINERS_TYPE, SCOPE_PROFILE_TYPE, ScopeMaintainers, ScopeProfile,
  isValidScopeName
} from 'package-manager/records';
import { PUT_SCOPE_PROFILE } from 'package-manager/registry-methods';
import { Options } from './env.zena';
import { packageResolver } from './fetch.zena';
import {
  PublishError, createScope, findRegistry, registryClient, runCommand, saveIfRefreshed, handleDid, signedIn
} from './publish.zena';
import { REPO_GET_RECORD } from 'atproto/methods';

/**
 * `zena pkg scope create <name>`: creates the scope on the registry, with the
 * signed-in maintainer as its only owner, once `--yes` says to.
 */
export async function scopeCreateCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    if (args.rest.length != 2) {
      throw new PublishError('give the scope to create: zena pkg scope create <name>');
    }
    let name = args.rest[1];
    if (!isValidScopeName(name)) {
      throw new PublishError(
          `'${name}' cannot be a scope: use lowercase letters, digits and -, starting with a letter`);
    }
    let session = await signedIn();
    let registry = await findRegistry(args);
    let handle = `${name}.${registry.domain}`;
    if ((await handleDid(handle)) != null) {
      throw new PublishError(`${registry.origin} already has the scope ${name} (${handle})`);
    }
    if (!args.getFlag('yes')) {
      throw new PublishError(
          `Run again with --yes to create the scope ${handle} on ${registry.origin}, owned by ${session.handle}.`);
    }
    await createScope(session, registry, name);
    await saveIfRefreshed(session);
  });
}

/**
 * `zena pkg scope info <scope>`: the scope's DID, handle and PDS, its
 * maintainers record (how many owners and publishers, and how many owners a
 * change needs), and for an organization, how many members it has. The
 * scope is its name on the registry, its handle, or its DID. Who a private
 * maintainer or member is stays private (package-manager.md, "Private
 * membership").
 */
export async function scopeInfoCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    if (args.rest.length != 2) {
      throw new PublishError('give the scope: zena pkg scope info <name, handle or DID>');
    }
    let given = args.rest[1];
    var did = given;
    if (!given.startsWith('did:')) {
      let handle = if (given.contains('.')) given else {
        let reg = await findRegistry(args);
        `${given}.${reg.domain}`
      };
      let found = await handleDid(handle);
      if (found == null) {
        throw new PublishError(`no scope has the handle ${handle}`);
      }
      did = found;
    }
    // The handle is the one that resolves back to the DID, not whatever
    // its document claims.
    let identity = await packageResolver().resolve(did);
    let document = identity.document;
    if (document.pds == null) {
      throw new PublishError(`${did} names no PDS`);
    }
    let held = await recordOf(did, SCOPE_MAINTAINERS_TYPE);
    if (held == null) {
      throw new PublishError(`${did} has no scope maintainers record, so it is not a scope`);
    }
    let maintainers = ScopeMaintainers.fromValue(fromJson(held['value']));
    var owners = 0;
    for (let maintainer in maintainers.maintainers) {
      if (maintainer.role == OWNER) {
        owners += 1;
      }
    }
    console.log(identity.handle ?? '(no handle)');
    let profile = await recordOf(did, SCOPE_PROFILE_TYPE);
    if (profile != null) {
      printProfile(ScopeProfile.fromValue(fromJson(profile['value'])));
    }
    console.log(`  DID: ${did}`);
    console.log(`  PDS: ${document.pds as String}`);
    console.log(`  Owners: ${owners}`);
    console.log(`  Publishers: ${maintainers.maintainers.length - owners}`);
    console.log(`  Owners needed to change it: ${maintainers.ownerThreshold}`);
    let members = await recordOf(did, MEMBERS_TYPE);
    if (members != null) {
      console.log(`  Organization members: ${((members['value'] as JsonObject)['members'] as JsonArray).length}`);
    }
  });
}

/**
 * `zena pkg scope profile <scope> [--name <text>] [--description <text>]
 * [--website <url>]`: how the scope presents itself on the registry's pages.
 * A flag given empty clears its field. With no flags, prints it. Its
 * owners write it at once: it decides no one's role.
 */
export async function scopeProfileCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    if (args.rest.length != 2) {
      throw new PublishError('give the scope: zena pkg scope profile <scope> [--name <text>] [--description <text>] [--website <url>]');
    }
    let scope = args.rest[1];
    let session = await signedIn();
    let registry = await findRegistry(args);
    let scopeDid = await handleDid(`${scope}.${registry.domain}`);
    if (scopeDid == null) {
      throw new PublishError(`${registry.origin} has no scope ${scope}`);
    }
    let held = await recordOf(scopeDid, SCOPE_PROFILE_TYPE);
    let profile = if (held == null) new ScopeProfile()
        else ScopeProfile.fromValue(fromJson(held['value']));
    var changed = false;
    if (let (true, given) = args.getOption('name')) {
      profile.displayName = if (given == '') null else given;
      changed = true;
    }
    if (let (true, given) = args.getOption('description')) {
      profile.description = if (given == '') null else given;
      changed = true;
    }
    if (let (true, given) = args.getOption('website')) {
      profile.website = if (given == '') null else given;
      changed = true;
    }
    if (!changed) {
      console.log(`${scope}.${registry.domain}`);
      printProfile(profile);
      await saveIfRefreshed(session);
      return;
    }
    // Checked here as the registry will check it, so a bad website is refused before the call.
    try {
      ScopeProfile.fromValue(profile.toValue());
    } catch (e) {
      if (e is RecordError) {
        throw new PublishError(e.message);
      }
      throw e;
    }
    let input = new JsonObject();
    input['scope'] = scopeDid;
    input['profile'] = toJson(profile.toValue());
    if (held != null) {
      input['swapRecord'] = held['cid'] as String;
    }
    let client = await registryClient(session, registry, PUT_SCOPE_PROFILE);
    await client.procedure(PUT_SCOPE_PROFILE, input);
    console.log(`Changed the profile of ${scope}.`);
    printProfile(profile);
    await saveIfRefreshed(session);
  });
}

function printProfile(profile: ScopeProfile): void {
  console.log(`  Name: ${profile.displayName ?? '(none)'}`);
  console.log(`  Description: ${profile.description ?? '(none)'}`);
  console.log(`  Website: ${profile.website ?? '(none)'}`);
}

/** The `getRecord` answer for `did`'s record at `collection/self`, from its PDS, or null when it has none. */
async function recordOf(did: String, collection: String): Future<JsonObject | null> {
  let document = await packageResolver().resolveDid(did);
  if (document.pds == null) {
    throw new PublishError(`${did} names no PDS`);
  }
  let params: Array<(String, String)> = [('repo', did), ('collection', collection), ('rkey', 'self')];
  try {
    return (await new XrpcClient(document.pds as String).query(REPO_GET_RECORD, params)) as JsonObject;
  } catch (e) {
    if (e is XrpcError && e.error == 'RecordNotFound') {
      return null;
    }
    throw e;
  }
}
