/**
 * `zena pkg add` and `zena pkg update`: change a package's dependencies in its
 * `zena-package.json`, select versions across the whole workspace, pin
 * them in `zena-lock.json`, and fetch them (docs/design/package-manager.md,
 * "Dependencies and resolution"). The workspace's root is the repository
 * root, and the package changed is the one the command is run in: the
 * workspace package whose directory holds the current directory, or else
 * the root, whose manifest `zena pkg add` creates if need be.
 *
 * `zena pkg add <package>[@<version>]` takes a DID, a handle or `scope:name`,
 * and the latest version that is not retracted unless one is given. The local
 * name is `scope:name` for a package in a scope, unless the root manifest sets
 * `scopedNames` to false, and otherwise the one the package's profile
 * suggests; `--name` gives another. `zena pkg update [<name>...]` raises each named dependency, or all
 * of them, to the latest version its range allows that is not retracted.
 *
 * Both print what the new selection changes in the lockfile's pins, and
 * refuse, writing nothing, when a pinned version's release record or
 * source archive has other CIDs than the lockfile pins: a published
 * version never changes, so its PDS or its host changed it. With
 * `--allow-changed`, the new CIDs are pinned.
 */

import { ParsedArgs } from 'zena:args';
import { Future } from 'zena:async';
import { getEnv } from 'zena:cli';
import { HashSet, OrderedHashMap } from 'zena:collections';
import { exists, readFile, writeFile } from 'zena:fs';
import { Cid } from 'atproto/cid';
import { IdentityResolver } from 'atproto/identity';
import { writeDependencies } from 'package-manager/manifest';
import { isValidLocalName, parsePackageVersion } from 'package-manager/records';
import {
  DEFAULT_DOMAIN, fetchProfile, isScopedIdentifier, listVersions, NetworkSource, resolveIdentifier, scopedHandle,
  scopedName
} from 'package-manager/registry';
import {
  Pin, PinAdded, PinChange, PinChangedInPlace, PinRemoved, PinVersionChanged, diffPins, packageKey, readPins,
  writeLockfile
} from 'package-manager/resolution';
import { Requirement, resolve } from 'package-manager/resolve';
import { Range, Version } from 'zena-lang:semver';
import { DiskFiles, Workspace, WorkspacePackage, readWorkspace } from 'package-manager/workspace';
import { Options, workspaceRoot, userCwd } from './env.zena';
import { fetchAndReport, packageResolver } from './fetch.zena';
import { findRegistry } from './publish.zena';

/**
 * The domain `scope:name` stands under when the workspace's `scopes` do
 * not name one: the domain of the registry `ZENA_REGISTRY` names, as its
 * `describeRegistry` gives it, or else the Zena project's, without asking
 * any registry, so that adding a package needs no App View.
 */
async function scopeDomain(args: ParsedArgs): Future<String> {
  if (getEnv('ZENA_REGISTRY') == null) {
    return DEFAULT_DOMAIN;
  }
  return (await findRegistry(args)).domain;
}

export async function addCommand(args: ParsedArgs, options: Options): Future<i32> {
  if (args.rest.length != 1) {
    console.error('Error: zena pkg add takes one package: a DID, a handle or scope:name, with @<version> if wanted.');
    return 2;
  }
  let (identifier, versionText) = splitVersion(args.rest[0]);
  let workspace = await readWorkspace(workspaceRoot().value, new DiskFiles());
  let target = workspace.packageAt(userCwd().value);
  let manifest = target.manifest;
  let requirements = manifest.requirements;
  let resolver = packageResolver();
  let scopedIdentifier = isScopedIdentifier(identifier);
  let domain = if (scopedIdentifier) await scopeDomain(args) else DEFAULT_DOMAIN;
  let did = await resolveIdentifier(identifier, workspace.root.manifest.scopes, resolver, domain);
  let document = await resolver.resolveDid(did);

  var version: Version | null = null;
  if (versionText != null) {
    version = parsePackageVersion(versionText);
  } else {
    let versions = await listVersions(document);
    version = versions.latest();
    if (version == null) {
      console.error(`Error: ${identifier} (${did}) has no release that is not retracted.`);
      return 1;
    }
  }
  let chosen = version;

  var name = '';
  if (let (true, given) = args.getOption('name')) {
    name = given;
  } else {
    // A package in a scope is `<scope>:<name>`, by a handle that resolves
    // to it, unless the workspace turns that off (docs/design/import-names.md);
    // any other, by the name its profile suggests.
    let root = workspace.root.manifest;
    let scopes = root.scopes;
    var scoped: String | null = null;
    if (root.scopedNames) {
      let handle = await verifiedHandle(identifier, did, document.handle, scopes, resolver, domain);
      if (handle != null) {
        scoped = scopedName(handle, scopes, if (scopedIdentifier) domain else await scopeDomain(args));
      }
    }
    if (scoped != null) {
      name = scoped;
    } else {
      let profile = await fetchProfile(document);
      if (profile == null) {
        console.error(`Error: ${identifier} has no profile to suggest a name; give one with --name.`);
        return 1;
      }
      name = profile.name;
    }
  }
  if (!isValidLocalName(name)) {
    console.error(`Error: '${name}' is not a valid local name: a package name, or scope:name.`);
    return 1;
  }
  let taken = nameTaken(workspace, target, name, did);
  if (taken != null) {
    console.error(`Error: '${name}' already names ${taken}; give this package another name with --name.`);
    return 1;
  }

  requirements[name] = new Requirement(did, Range.parse(`^${chosen.toString()}`));
  console.log(`Adding ${name} to ${target.manifestPath()}: ${did} ${chosen.toString()}`);
  // The version chosen is kept, as a pin is, where the ranges allow it.
  let chosenKey = packageKey(did, chosen);
  return await resolveWriteAndFetch(workspace, target, resolver, args, options, (pin) => true, chosenKey);
}

/**
 * Selects versions again without keeping the lockfile's pins of the named
 * dependencies, or of any package when none is named, so that each range
 * gets the highest version it can. The manifests do not change.
 */
export async function updateCommand(args: ParsedArgs, options: Options): Future<i32> {
  let workspace = await readWorkspace(workspaceRoot().value, new DiskFiles());
  let target = workspace.packageAt(userCwd().value);
  let requirements = target.manifest.requirements;
  if (requirements.size == 0) {
    console.log(`Nothing to update: ${target.manifestPath()} declares no published dependencies.`);
    return 0;
  }
  let dids = new HashSet<String>();
  for (let name in args.rest) {
    if (let (true, requirement) = requirements.get(name)) {
      dids.add(requirement.did);
    } else {
      console.error(`Error: ${target.manifestPath()} has no published dependency named '${name}'.`);
      return 1;
    }
  }
  let named = args.rest.length > 0;
  return await resolveWriteAndFetch(workspace, target, packageResolver(), args, options,
      (pin) => named && !dids.has(pin.did));
}

/**
 * What `name` already names in `target`, when it is not `did`: another
 * published package, a package on disk, a WIT-backed package, the package
 * itself, or, in a root that is not a package, a workspace package. Null
 * when it is free.
 */
/**
 * The handle of the package `did`, which `identifier` named, or null when
 * none is known to resolve to it: the handle `identifier` is or stands for,
 * which `resolveIdentifier` resolved, or for a DID, the handle its document
 * gives, `claimed`, once it resolves back to the DID.
 */
async function verifiedHandle(identifier: String, did: String, claimed: String | null,
    scopes: OrderedHashMap<String, String>, resolver: IdentityResolver, domain: String): Future<String | null> {
  if (isScopedIdentifier(identifier)) {
    return scopedHandle(identifier, scopes, domain);
  }
  if (!identifier.startsWith('did:')) {
    return identifier;
  }
  if (claimed == null) {
    return null;
  }
  try {
    return if ((await resolver.resolve(claimed)).did == did) claimed else null;
  } catch (e) {
    return null;
  }
}

function nameTaken(workspace: Workspace, target: WorkspacePackage, name: String,
    did: String): String | null {
  let manifest = target.manifest;
  if (let (true, existing) = manifest.requirements.get(name)) {
    return if (existing.did == did) null else existing.did;
  }
  if (let (true, path) = manifest.paths.get(name)) {
    return `the package in ${path}`;
  }
  if (let (true, wit) = manifest.wits.get(name)) {
    return `the WIT in ${wit}`;
  }
  // A package in a scope names itself by its plain name as well.
  if (workspace.localNameOf(target) == name || manifest.name == name) {
    return 'this package';
  }
  if (target.dir == workspace.root.dir && manifest.name == null) {
    for (let pkg in workspace.packages) {
      if (workspace.localNameOf(pkg) == name) {
        return `the workspace package in ${pkg.dir}`;
      }
    }
  }
  return null;
}

/**
 * Selects versions for the whole workspace, with `target`'s changed
 * requirements, keeping the pins `keep` accepts, and the version `also`
 * names, where the ranges allow,
 * writes `target`'s manifest and the lockfile, prints what changed in its
 * pins, and fetches what it pins. A version lowered to share it with
 * another package is a warning, and so, with `--duplicates warn` or the
 * root manifest's `"duplicates": "warn"`, is a package selected at two
 * versions. Nothing is written when selection fails, when a pinned release
 * changed in place and `--allow-changed` is not given, or when a package
 * has two versions under `--duplicates error`.
 */
async function resolveWriteAndFetch(workspace: Workspace, target: WorkspacePackage,
    resolver: IdentityResolver, args: ParsedArgs, options: Options, keep: (pin: Pin) => boolean,
    also: String | null = null): Future<i32> {
  var duplicates = workspace.root.manifest.duplicates;
  if (let (true, given) = args.getOption('duplicates')) {
    duplicates = given;
  }
  if (duplicates != 'allow' && duplicates != 'warn' && duplicates != 'error') {
    console.error(`Error: --duplicates is allow, warn or error, not '${duplicates}'.`);
    return 2;
  }
  let requirements = target.manifest.requirements;
  let lockfilePath = workspace.lockfilePath();
  let before = if (await exists(lockfilePath)) readPins(await readFile(lockfilePath)) else new GrowableArray<Pin>();
  let preferred = new HashSet<String>();
  for (let pin in before) {
    if (keep(pin)) {
      preferred.add(pin.key);
    }
  }
  if (also != null) {
    preferred.add(also);
  }
  let resolution = await resolve(workspace.requirements(), new NetworkSource(resolver), preferred);
  let changes = diffPins(before, resolution);
  if (!args.getFlag('allow-changed') && refuseChangedInPlace(changes)) {
    return 1;
  }
  let twice = resolution.duplicates();
  if (twice.size > 0 && duplicates == 'error') {
    twice.forEach((did, versions) => {
      console.error(`Error: ${did} would be installed at ${listVersionsOf(versions)}.`);
    });
    console.error('Nothing was written: --duplicates error refuses a package at two versions.');
    return 1;
  }
  let lockfile = writeLockfile(resolution, workspace.pinsByPackage(resolution));
  await writeFile(target.manifestPath(), writeDependencies(target.text, requirements, target.manifest.paths));
  await writeFile(lockfilePath, lockfile);
  if (changes.length == 0) {
    console.log('zena-lock.json is unchanged.');
  }
  for (let change in changes) {
    if (let PinVersionChanged {pin, now} = change) {
      if (now.version.compareTo(pin.version) < 0) {
        // Selection lowers a version only to install one where it would
        // otherwise install two.
        console.error(`warning: ${describeChange(change)}, to share one version with another package`);
        continue;
      }
    }
    console.log(describeChange(change));
  }
  twice.forEach((did, versions) => {
    let line = `${did} is installed at ${listVersionsOf(versions)}, for ranges no one version is in`;
    if (duplicates == 'warn') {
      console.error(`warning: ${line}`);
    } else {
      console.log(line);
    }
  });
  return await fetchAndReport(readPins(lockfile), options);
}

/** `versions` as `1.1.5 and 1.9.0`. */
function listVersionsOf(versions: GrowableArray<Version>): String {
  var text = '';
  for (var i = 0; i < versions.length; i += 1) {
    let separator = if (i == 0) '' else if (i == versions.length - 1) ' and ' else ', ';
    text = `${text}${separator}${versions[i].toString()}`;
  }
  return text;
}

/**
 * Whether `changes` has a release changed in place; if so, says which,
 * and how to pin them anyway.
 */
function refuseChangedInPlace(changes: GrowableArray<PinChange>): boolean {
  var refused = false;
  for (let change in changes) {
    if (let PinChangedInPlace {pin, now} = change) {
      if (!refused) {
        console.error('Error: these releases have other CIDs than zena-lock.json pins, at the same version:');
        refused = true;
      }
      console.error(`  ${pin.key}: ${cidsChanged(pin, now.release, now.source)}`);
    }
  }
  if (refused) {
    console.error('A published version never changes, so its PDS or its package host changed it. Nothing was written.');
    console.error('To pin these releases as they are now, run the command again with --allow-changed.');
  }
  return refused;
}

/** A line saying what `change` does to the lockfile. */
function describeChange(change: PinChange): String {
  return match (change) {
    case PinAdded {now}: `Added ${now.key}`
    case PinRemoved {pin}: `Removed ${pin.key}`
    case PinVersionChanged {pin, now}: {
      let verb = if (now.version.compareTo(pin.version) > 0) 'Upgraded' else 'Downgraded';
      `${verb} ${pin.key} -> ${now.version.toString()}`
    }
    case PinChangedInPlace {pin, now}:
      `Changed ${pin.key} in place: ${cidsChanged(pin, now.release, now.source)}`
  };
}

/** Which of `pin`'s CIDs `release` and `source` replace. */
function cidsChanged(pin: Pin, release: Cid, source: Cid): String {
  var out = if (!pin.release.equals(release)) {
    `release ${pin.release.toString()} -> ${release.toString()}`
  } else {
    ''
  };
  if (!pin.source.equals(source)) {
    let sourceChanged = `source ${pin.source.toString()} -> ${source.toString()}`;
    out = if (out == '') sourceChanged else `${out}, ${sourceChanged}`;
  }
  return out;
}

/** `text` split into the package and the version after its last `@`, if any. */
function splitVersion(text: String): inline (String, String | null) {
  for (var i = text.length - 1; i > 0; i -= 1) {
    if (text.getByteAt(i) == 64) {
      return (text.sliceBytes(0, i), text.sliceBytes(i + 1, text.length));
    }
  }
  return (text, null);
}
