/**
 * `zena lsp`: a language server over standard input and output, for
 * editors that start one (Neovim, Helix, Zed and others).
 *
 * The protocol and the analysis are the language service's
 * (`language-service/server` and `language-service/service`); this
 * connects them to stdin and stdout, and to the repository's standard
 * library and package map. The analysis sees the `zena-cli` target, so
 * programs that use `zena:fs` or `zena:process` check the way they
 * build.
 */

import { ParsedArgs } from 'zena:args';
import { readStdin } from 'zena:cli';
import { logString } from 'zena:console';
import { isFile, readFile } from 'zena:fs';
import { CompilerHost } from 'zena-compiler/library-loader';
import { PackageConfig } from 'zena-compiler/module-resolver';
import { loadWorkspace } from 'zena-compiler/package-manifest';
import { directoryNames } from 'zena-compiler/fs-host';
import { createLanguageService } from 'language-service/service';
import { LspServer, MessageReader, frame } from 'language-service/server';
import { Options, workspaceRoot, stdlibDir } from './env.zena';
import { packageCacheDir } from './compile.zena';

/** A file's text, or null when it cannot be read. */
async function readOrNull(path: String): Future<String | null> {
  try {
    return await readFile(path);
  } catch (e) {
    return null;
  }
}

/** Reads the workspace's manifests for `loadWorkspace`. */
class ManifestHost implements CompilerHost {
  async readFile(path: String): Future<String> {
    return await readFile(path);
  }

  /** Null: this host reads only the manifest. */
  async listDir(path: String): Future<Array<String> | null> {
    return await directoryNames(path);
  }
}

/**
 * The workspace's packages, with absolute roots so that they match the
 * absolute paths an editor sends.
 */
async function packageMap(): Future<Map<String, PackageConfig> | null> {
  let root = workspaceRoot().value;
  if (!(await isFile(`${root}/zena-package.json`))) {
    return null;
  }
  return await loadWorkspace(new ManifestHost(), root, null, packageCacheDir());
}

export async function lspCommand(args: ParsedArgs, options: Options): Future<i32> {
  let service = createLanguageService(
    stdlibDir().value,
    readOrNull,
    'zena-component',
    await packageMap(),
  );
  // Only the protocol's messages may reach stdout: anything else the
  // server has to say goes to stderr.
  let server = new LspServer(service, readOrNull, (json: String) => {
    logString(frame(json));
  });
  // Each message is answered before the next is read, so a check that
  // awaits the service still answers messages in the order they came.
  let messages = new MessageReader(() => readStdin(65536));
  while (!server.exited) {
    let body = await messages.next();
    if (body == null) {
      break;
    }
    await server.handle(body);
  }
  return 0;
}
