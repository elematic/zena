/**
 * `zena pkg publish` and `zena pkg create`: publishing the package the
 * command is run in to a registry (docs/design/package-manager.md,
 * "Creating a package" and "Publishing a release").
 *
 * Both act as the signed-in maintainer (`zena pkg login`): each call to the
 * registry carries a service-auth token from the maintainer's own PDS. A
 * package whose manifest has no `did` yet is created first, once `--yes`
 * says to, in the scope its manifest names, else its workspace root's,
 * else `--scope`. The scope must exist: `zena pkg scope create` makes one
 * (`scope.zena`), and publishing never does. The new package's DID is
 * written into `zena-package.json`, with the scope when `--scope` gave it.
 * A package that has a DID is checked against its scope: its handle must
 * be its name in that scope.
 *
 * Publishing packs the files the manifest publishes (`package-manager/files`)
 * into a source archive, uploads it, writes the release for the manifest's
 * `version`, and writes the maintainer's attestation of the release to
 * their own repository. The release is checked first, before the registry is
 * asked anything, so a package whose release would be refused is never
 * created.
 *
 * The registry is `--registry`, else `ZENA_REGISTRY`, else the Zena
 * project's App View (`DEFAULT_REGISTRY`); its service DID and handle
 * domain come from its `dev.zena-lang.registry.describeRegistry`, and the
 * DID must be the origin's own (`checkHostDid`) before any token is made
 * for it.
 */

import { ParsedArgs } from 'zena:args';
import { Future } from 'zena:async';
import { getEnv } from 'zena:cli';
import { OrderedHashMap } from 'zena:collections';
import { FileType, exists, listDir, readFile, readFileBytes, writeFile } from 'zena:fs';
import { hex } from 'zena:encoding';
import { JsonArray, JsonObject } from 'zena:json';
import { join2 } from 'zena:path';
import { formatTimestamp } from 'zena:time';
import { now } from 'wasi:clocks/system-clock';
import { Cid } from 'atproto/cid';
import { BlobRef, fromJson, toJson } from 'atproto/data';
import { KeyType, formatDidKey, publicKeyFor } from 'atproto/didkey';
import { Session, getServiceAuth } from 'atproto/session';
import { XrpcClient, XrpcError } from 'atproto/xrpc';
import { packSource } from 'package-manager/archive';
import { SOURCE_MIME_TYPE, checkDependencies, checkMetadata, validateRelease } from 'package-manager/validate';
import { PublishedFiles } from 'package-manager/files';
import { Manifest, readManifest, writeDid } from 'package-manager/manifest';
import {
  ATTESTATION_TYPE, Artifact, Attestation, Dependency, Maintainer, Maintainers, OWNER, POLICY_TYPE, Policy, Profile,
  Release, SOURCE
} from 'package-manager/records';
import { Range, Version } from 'zena-lang:semver';
import { DiskFiles, WorkspacePackage, readWorkspace } from 'package-manager/workspace';
import { Options, workspaceRoot, userCwd } from './env.zena';
import { packageResolver } from './fetch.zena';
import { IdentityError, didWebHost } from 'atproto/identity';
import { URL } from 'zena:url';
import { configDir, currentSession, saveSession } from './login.zena';
import { CLI_VERSION, clientAgent } from './version.zena';
import { REPO_GET_RECORD, REPO_PUT_RECORD } from 'atproto/methods';
import {
  COMPLETE_RELEASE, CREATE_ORGANIZATION, CREATE_PACKAGE, DESCRIBE_REGISTRY, PUBLISH, UPLOAD_ARTIFACT
} from 'package-manager/registry-methods';

/**
 * The Zena project's App View, the registry `zena pkg` calls without
 * `--registry` or `ZENA_REGISTRY`. Its accounts are on padstone, which
 * serves no registry methods.
 */
export let DEFAULT_REGISTRY = 'https://pkg.zena-lang.dev';

/** A DID no package has, for checking a release before its package exists. */
let STAND_IN_DID = 'did:plc:aaaaaaaaaaaaaaaaaaaaaaaa';

/** A registry, as its `describeRegistry` describes it. */
export final class Registry {
  origin: String;
  /** The DID tokens for it are addressed to. */
  did: String;
  /** The domain its scopes' handles are under. */
  domain: String;
  /** Whether only its admins and the accounts they list may create scopes (`scopeCreation` is `listed`). */
  var listsScopeCreators = false;

  new(origin: String, did: String, domain: String) : origin = origin, did = did, domain = domain;
}

/** A failure to report, with no stack: the command's own errors. */
export class PublishError extends Error {
  new(message: String) : super(message);
}

export async function publishCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    let target = await currentPackage();
    refuseWitDependencies(target.manifest);
    refuseProblems(checkMetadata(target.manifest, target.manifestPath()));
    await requirePublished(await dependenciesOf(target, target.manifest));
    var manifestText = target.text as String;
    if (target.manifest.did == null) {
      // Everything about the release is checked before anything is asked
      // of the registry, let alone the package created: with a stand-in for
      // the DID it will have, written into the manifest as createPackage
      // writes the real one. Only the DID's value is left to check once
      // it exists.
      let draft = writeDid(manifestText, STAND_IN_DID, null);
      await prepareRelease(target, readManifest(draft), STAND_IN_DID, draft);
    }
    let caller = await currentCaller();
    let registry = await findRegistry(args);
    if (target.manifest.did == null) {
      manifestText = await createPackage(args, personOf(caller, 'create a package'), registry, target);
    } else {
      await checkScope(args, registry, target);
    }
    let manifest = readManifest(manifestText);
    let scope = await scopeOf(args, target);
    let approveAs = if (scope != null) `${scope}:${manifest.name as String}` else manifest.did as String;
    await publish(caller, registry, target, manifest, await prepareRelease(target, manifest, manifest.did as String, manifestText),
        approveAs);
    await saveCaller(caller);
  });
}

export async function packageCreateCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    let target = await currentPackage();
    if (target.manifest.did != null) {
      throw new PublishError(`${target.manifestPath()} already names its package: ${target.manifest.did as String}`);
    }
    refuseProblems(checkMetadata(target.manifest, target.manifestPath()));
    let session = await signedIn();
    await createPackage(args, session, await findRegistry(args), target);
    await saveIfRefreshed(session);
  });
}

/**
 * Runs `body`, printing the message alone for a `PublishError`, or for a
 * call the registry or a PDS refused (`XrpcError`, which names the error).
 */
export async function runCommand(body: () => Future<void>): Future<i32> {
  try {
    await body();
    return 0;
  } catch (e) {
    // TODO(#99): read `message` on the narrowed union.
    let message = e.message;
    if (e is PublishError || e is XrpcError) {
      console.error(`Error: ${message}`);
      return 1;
    }
    throw e;
  }
}

async function currentPackage(): Future<WorkspacePackage> {
  let workspace = await readWorkspace(workspaceRoot().value, new DiskFiles());
  let target = workspace.packageAt(userCwd().value);
  if (target.text == null || target.manifest.name == null) {
    throw new PublishError('run this in a package: a directory whose zena-package.json has a name');
  }
  return target;
}

/**
 * Throws for a WIT dependency, which a published package cannot have: its
 * path is on this disk (docs/design/package-manifest.md). Checked before
 * anything is created on the registry.
 */
function refuseWitDependencies(manifest: Manifest): void {
  manifest.wits.forEach((name, wit) => {
    throw new PublishError(
        `${name} is the WIT in ${wit}, which a published package cannot depend on; publish the WIT as a package of its own`);
  });
}

/**
 * Throws unless each dependency is a release that is published and not
 * retracted: a release that names one that is not could never be resolved.
 * Checked before anything is created on the registry.
 */
async function requirePublished(dependencies: FixedArray<Dependency>): Future<void> {
  refuseProblems(await checkDependencies(dependencies, packageResolver()));
}

/** Throws the problems the checks found, when there are any. */
function refuseProblems(problems: Array<String>): void {
  if (problems.length == 0) {
    return;
  }
  var message = 'the release cannot be published:';
  for (let problem in problems) {
    message = `${message}\n  ${problem}`;
  }
  throw new PublishError(message);
}

export async function signedIn(): Future<Session> {
  let session = await currentSession();
  if (session == null) {
    throw new PublishError('sign in first, with zena pkg login');
  }
  return session;
}

export async function saveIfRefreshed(session: Session): Future<void> {
  if (session.refreshed) {
    await saveSession(session);
  }
}

/**
 * Who calls the registry: a maintainer signed in at their own PDS, which
 * signs their tokens, or CI with an automation account's token, which the
 * registry issued (docs/design/package-manager.md, "Publishing a release").
 */
export sealed class Caller {
  case SignedIn(session: Session)
  case AutomationToken(token: String)
}

/**
 * The caller of `zena pkg publish`: CI, when `ZENA_REGISTRY_TOKEN` holds an
 * automation account's token, or else the signed-in maintainer.
 */
export async function currentCaller(): Future<Caller> {
  let token = getEnv('ZENA_REGISTRY_TOKEN');
  if (token != null && token.length > 0) {
    return new AutomationToken(token);
  }
  return new SignedIn(await signedIn());
}

/** The session of `caller`, who must be a person: an automation token does only what CI publishes. */
function personOf(caller: Caller, doing: String): Session {
  if (let SignedIn {session} = caller) {
    return session;
  }
  throw new PublishError(`an automation token cannot ${doing}; a maintainer does it, signed in with zena pkg login`);
}

/** Saves `caller`'s session when it was refreshed. */
async function saveCaller(caller: Caller): Future<void> {
  if (let SignedIn {session} = caller) {
    await saveIfRefreshed(session);
  }
}

/** A client for `registry` that calls `method` as `caller`. */
export async function callerClient(caller: Caller, registry: Registry, method: String): Future<XrpcClient> {
  if (let AutomationToken {token} = caller) {
    let client = registryXrpc(registry.origin);
    client.authorization = `Bearer ${token}`;
    return client;
  }
  return await registryClient(personOf(caller, 'call the registry'), registry, method);
}

export async function findRegistry(args: ParsedArgs): Future<Registry> {
  var origin = getEnv('ZENA_REGISTRY') ?? DEFAULT_REGISTRY;
  if (let (true, given) = args.getOption('registry')) {
    origin = given;
  }
  let described = (await registryXrpc(origin).query(DESCRIBE_REGISTRY)) as JsonObject;
  let did = described['did'] as String;
  await checkRegistryDid(origin, did);
  let notice = described['clientNotice'];
  if (notice is String && notice != '') {
    console.error(`${origin} says: ${notice}`);
  }
  let minimum = described['minimumClientVersion'];
  if (minimum is String && newerThanThis(minimum)) {
    throw new PublishError(
        `${origin} needs zena ${minimum} or newer, and this is zena ${CLI_VERSION}. Upgrade zena: in a checkout of Zena, git pull and npm run build.`);
  }
  let registry = new Registry(origin, did, described['domain'] as String);
  registry.listsScopeCreators = described['scopeCreation'] == 'listed';
  return registry;
}

/** A client for the registry at `origin`, which names this command (`clientAgent`). */
function registryXrpc(origin: String): XrpcClient {
  let client = new XrpcClient(origin);
  client.userAgent = clientAgent();
  return client;
}

/** Whether `version`, a registry's minimum, is newer than this command; false when it is not a version. */
function newerThanThis(version: String): boolean {
  try {
    return Version.parse(version).compareTo(Version.parse(CLI_VERSION)) > 0;
  } catch (e) {
    return false;
  }
}

/**
 * Throws unless `did`, the DID the server at `origin` says it has, is the
 * origin's own: a `did:web` by its registry, which only the origin's domain can
 * hold, and a `did:plc` by the PDS endpoint its document names. Tokens for
 * the registry are addressed to its DID, so a server at any other origin that
 * answered with the real registry's DID would be given tokens it could replay
 * to the real registry, as whoever asked for them.
 */
/**
 * `authority`, a host and an optional port, in lowercase, with a loopback
 * address written as `localhost`. atproto allows a port in a `did:web`
 * only for `localhost`, so a registry on this machine, such as the
 * demo's, is served at `127.0.0.1` and names itself
 * `did:web:localhost%3A<port>`: both name this machine, on the same port.
 */
function loopbackAsLocalhost(authority: String) {
  let lower = authority.asciiLowerCase();
  for (let address in ['127.0.0.1', '[::1]']) {
    if (lower == address || lower.startsWith(`${address}:`)) {
      return `localhost${lower.sliceBytes(address.length, lower.length)}`;
    }
  }
  return lower;
}

async function checkRegistryDid(origin: String, did: String): Future<void> {
  let url = URL.parse(origin);
  if (url == null) {
    throw new PublishError(`the registry ${origin} is not a URL`);
  }
  let parsed = url;
  let authority = if (parsed.port == '') parsed.hostname else `${parsed.hostname}:${parsed.port}`;
  if (did.startsWith('did:web:')) {
    let named = try {
      didWebHost(did)
    } catch (e) {
      throw new PublishError(`the registry ${origin} says it is ${did}: ${e.message}`);
    };
    if (loopbackAsLocalhost(named) != loopbackAsLocalhost(authority)) {
      throw new PublishError(`the registry ${origin} says it is ${did}, which is the registry at ${named}, not ${authority}`);
    }
    return;
  }
  if (did.startsWith('did:plc:')) {
    let doc = await packageResolver().resolveDid(did);
    let endpoint = doc.pds;
    if (endpoint == null || trimSlash(endpoint) != trimSlash(`${parsed.protocol}//${authority}`)) {
      throw new PublishError(`the registry ${origin} says it is ${did}, whose PDS is ${endpoint ?? 'none'}`);
    }
    return;
  }
  throw new PublishError(`the registry ${origin} says it is ${did}, which is neither a did:web nor a did:plc`);
}

/** `url` without a trailing `/`. */
function trimSlash(url: String): String {
  return if (url.endsWith('/')) url.sliceBytes(0, url.length - 1) else url;
}

/** A client for `registry` that calls `method` as the signed-in maintainer. */
export async function registryClient(session: Session, registry: Registry, method: String): Future<XrpcClient> {
  let token = await getServiceAuth(session, registry.did, method);
  let client = registryXrpc(registry.origin);
  client.authorization = `Bearer ${token}`;
  return client;
}

/**
 * The scope `target` is in: `--scope`, which must agree with the manifest
 * when the manifest names one, else the manifest's, else its workspace
 * root's (package-manifest.md, "scope"). Null when none names one.
 */
async function scopeOf(args: ParsedArgs, target: WorkspacePackage): Future<String | null> {
  let named = target.manifest.scope ?? (await rootScope());
  if (let (true, given) = args.getOption('scope')) {
    if (named != null && named != given) {
      throw new PublishError(`${target.manifestPath()} puts ${target.manifest.name as String} in the scope ${named}, not ${given}`);
    }
    return given;
  }
  return named;
}

/** The scope the workspace's root manifest names for its packages, or null. */
async function rootScope(): Future<String | null> {
  return (await readWorkspace(workspaceRoot().value, new DiskFiles())).root.manifest.scope;
}

/**
 * Throws unless the package `target` names, which has a DID, has its name
 * in its scope as its handle: otherwise the manifest and the package
 * disagree about where it is, as for a manifest copied from another
 * package, or a package renamed without its manifest following. A package
 * with no scope, such as one whose handle is on its maintainers' own
 * domain, is not checked.
 */
async function checkScope(args: ParsedArgs, registry: Registry, target: WorkspacePackage): Future<void> {
  let scope = await scopeOf(args, target);
  if (scope == null) {
    return;
  }
  let did = target.manifest.did as String;
  let expected = `${target.manifest.name as String}.${scope}.${registry.domain}`;
  let doc = await packageResolver().resolveDid(did);
  let handle = doc.handle;
  if (handle != expected) {
    throw new PublishError(
        `${did} is ${handle ?? 'a package with no handle'}, not ${expected}: ${target.manifestPath()} names the scope ${scope}`);
  }
}

/**
 * Creates the package `target` is on `registry`, in its scope (`scopeOf`),
 * which must exist, and writes its DID into the manifest, with the scope
 * when only `--scope` named it. Returns the manifest's new text.
 */
async function createPackage(args: ParsedArgs, session: Session, registry: Registry, target: WorkspacePackage): Future<String> {
  let name = target.manifest.name as String;
  let found = await scopeOf(args, target);
  if (found == null) {
    throw new PublishError(
        `${name} has no DID yet; name the scope to create it in, with "scope" in ${target.manifestPath()} or --scope <name>`);
  }
  let scope = found;
  let org = await scopeOrganization(`${scope}.${registry.domain}`);
  if (org == null) {
    throw new PublishError(`${registry.origin} has no scope ${scope}; create it with zena pkg scope create ${scope}`);
  }
  let handle = `${name}.${scope}.${registry.domain}`;
  if (!args.getFlag('yes')) {
    throw new PublishError(
        `${name} has no DID yet. Run again with --yes to create the package ${handle} on ${registry.origin}, maintained by ${session.handle}.`);
  }
  let recoveryKeys = await recoveryDidKeys();

  let input = new JsonObject();
  input['organization'] = org;
  input['recoveryKeys'] = strings(recoveryKeys);
  // The profile says what the manifest says, for the index to show.
  input['profile'] = toJson(new Profile(name, target.manifest.description, target.manifest.license).toValue());
  let initial = await initialMaintainers(session.did, org);
  input['maintainers'] = toJson(initial.toValue());
  let client = await registryClient(session, registry, CREATE_PACKAGE);
  let created = try {
    (await client.procedure(CREATE_PACKAGE, input)) as JsonObject
  } catch (e) {
    if (e is XrpcError && e.error == 'NameTaken') {
      throw await nameTaken(handle, target);
    }
    throw e;
  };
  let did = created['did'] as String;
  let text = writeDid(target.text as String, did,
      if (target.manifest.scope == null && (await rootScope()) != scope) scope else null);
  await writeFile(target.manifestPath(), text);
  console.log(`Created ${created['handle'] as String} (${did}), and wrote its DID into ${target.manifestPath()}.`);
  return text;
}

/**
 * Why `target`, a manifest with no DID, cannot be created as `handle`: a
 * package has the name. Most often it is `target`'s own, published before
 * from a manifest whose DID was never committed, so the error names the
 * DID to write. It writes nothing itself: a new package that happens to
 * take the name would be published into the other one.
 */
async function nameTaken(handle: String, target: WorkspacePackage): Future<PublishError> {
  let did = await scopeOrganization(handle);
  if (did == null) {
    return new PublishError(`${handle} is taken; choose another name in ${target.manifestPath()}`);
  }
  return new PublishError(
      `${handle} already exists, as ${did}. If ${target.manifestPath()} is that package's, add "did": "${did}" to it and publish again; otherwise choose another name.`);
}

/**
 * A new package's maintainers record, as `org`'s policy has its packages
 * start: `creator` as its owner, beside the policy's default teams, with
 * its default thresholds.
 */
async function initialMaintainers(creator: String, org: String): Future<Maintainers> {
  let policy = await scopePolicy(org);
  let maintainers = new GrowableArray<Maintainer>();
  maintainers.push(Maintainer.ofDid(creator, OWNER));
  for (let team in policy.defaultTeams) {
    maintainers.push(new Maintainer(null, null, org, team.team, team.role));
  }
  let list = new FixedArray<Maintainer>(maintainers.length, maintainers[0]);
  for (var i = 0; i < maintainers.length; i += 1) {
    list[i] = maintainers[i];
  }
  let record = new Maintainers(list, policy.defaultThreshold, policy.defaultOwnerThreshold);
  record.humans = policy.defaultHumans;
  return record;
}

/** `org`'s policy for the packages in its scope, from its repository, or the one that asks nothing. */
export async function scopePolicy(org: String): Future<Policy> {
  let document = await packageResolver().resolveDid(org);
  if (document.pds == null) {
    throw new PublishError(`${org} names no PDS`);
  }
  let params: Array<(String, String)> = [('repo', org), ('collection', POLICY_TYPE), ('rkey', 'self')];
  try {
    let answer = (await new XrpcClient(document.pds as String).query(REPO_GET_RECORD, params)) as JsonObject;
    return Policy.fromValue(fromJson(answer['value']));
  } catch (e) {
    if (e is XrpcError && e.error == 'RecordNotFound') {
      return new Policy();
    }
    throw e;
  }
}

/**
 * Creates the scope `scope` on `registry`, owned by the signed-in maintainer,
 * and attests its members record. Returns the organization's DID.
 */
export async function createOrganization(session: Session, registry: Registry, scope: String): Future<String> {
  let input = new JsonObject();
  input['name'] = scope;
  input['recoveryKeys'] = strings(await recoveryDidKeys());
  let client = await registryClient(session, registry, CREATE_ORGANIZATION);
  let created = (await client.procedure(CREATE_ORGANIZATION, input)) as JsonObject;
  console.log(`Created the scope ${created['handle'] as String} (${created['did'] as String}), with you as its owner.`);
  let members = created['members'] as JsonObject;
  await attest(session, members['uri'] as String, Cid.parse(members['cid'] as String));
  return created['did'] as String;
}

/**
 * The account the handle of a scope names, when the handle resolves to a
 * DID whose document claims it back; null when it does not, as for a
 * scope that does not exist yet, or a record left behind by one that is
 * gone. A lookup that gets no answer, from a DNS-over-HTTPS resolver or a
 * PLC directory that cannot be reached, is a `PublishError` naming them,
 * and not a scope that is not there.
 */
export async function scopeOrganization(handle: String): Future<String | null> {
  let resolver = packageResolver();
  try {
    let resolved = await resolver.resolve(handle);
    return resolved.did;
  } catch (e) {
    // The answer: the handle resolves to no DID, or to one that does not
    // claim it.
    if (e is IdentityError) {
      return null;
    }
    // No answer, as when a variable still names a server that has stopped.
    throw new PublishError(`could not look up ${handle}: ${e.message}. Handles are looked up through ${resolver.dnsOverHttps} (ZENA_DNS_OVER_HTTPS), and DIDs through ${resolver.plcDirectory} (ZENA_PLC_DIRECTORY).`);
  }
}

/**
 * The recovery keys to rank above the registry's, as `did:key`s: the
 * maintainer's, when they keep one in the configuration directory, and
 * none otherwise. None is never made here: the registry holds the accounts it
 * creates, and a recovery key is for owners who choose to keep one
 * (package-manager.md, "Keys").
 */
async function recoveryDidKeys(): Future<Array<String>> {
  let path = `${configDir()}/recovery-key`;
  if (!(await exists(path))) {
    return [];
  }
  return [formatDidKey(publicKeyFor(KeyType.Secp256k1, hex.decode((await readFile(path)).trim())))];
}

/** A release of a package, and the source archive it names, checked and ready to upload. */
final class PreparedRelease {
  release: Release;
  archive: FixedArray<u8>;

  new(this.release, this.archive);
}

/**
 * `manifest`'s version of `target`, the package `did`, packed and checked
 * as the registry and every fetch will check it: its source archive, with
 * `manifestText` as its `zena-package.json`, and its release record.
 * Throws the problems found.
 */
async function prepareRelease(target: WorkspacePackage, manifest: Manifest, did: String, manifestText: String)
    : Future<PreparedRelease> {
  if (manifest.version == null) {
    throw new PublishError(`${target.manifestPath()} has no version to publish`);
  }
  let files = await sourceFiles(target.dir, manifest);
  files['zena-package.json'] = manifestText.toBytes();
  let archive = packSource(files);
  // The blob the registry will store, named by its contents, so the release is
  // checked as the registry and every fetch will check it before anything is
  // uploaded.
  let blob = new BlobRef(Cid.forBlob(archive), SOURCE_MIME_TYPE, archive.length as i64);
  let release = new Release(manifest.version as Version, formatTimestamp(nowNanos()),
      new FixedArray<Artifact>(1, Artifact.whole(SOURCE, blob)), await dependenciesOf(target, manifest));
  refuseProblems(await validateRelease(release, did, archive, manifest.name as String, packageResolver()));
  return new PreparedRelease(release, archive);
}

/**
 * Uploads and publishes `prepared`, `manifest`'s version of `target`,
 * attests it, and completes it, unless it waits for other maintainers to
 * approve it, as `zena pkg approve <approveAs>@<version>`. The registry
 * attests it itself for an automation token.
 */
async function publish(caller: Caller, registry: Registry, target: WorkspacePackage, manifest: Manifest,
    prepared: PreparedRelease, approveAs: String): Future<void> {
  let name = manifest.name as String;
  let did = manifest.did as String;
  let version = manifest.version as Version;
  let archive = prepared.archive;
  let release = prepared.release;
  let blob = release.artifact(SOURCE) as Artifact;

  let uploadClient = await callerClient(caller, registry, UPLOAD_ARTIFACT);
  let uploaded = (await uploadClient
    .upload(UPLOAD_ARTIFACT, SOURCE_MIME_TYPE, archive, [('package', did)]))
    as JsonObject;
  if (!BlobRef.fromValue(fromJson(uploaded['blob'])).cid.equals(blob.cid)) {
    throw new PublishError('the registry stored the archive under another CID');
  }
  let input = new JsonObject();
  input['package'] = did;
  input['release'] = toJson(release.toValue());
  let publishClient = await callerClient(caller, registry, PUBLISH);
  let published = (await publishClient.procedure(PUBLISH, input)) as JsonObject;
  if (let SignedIn {session} = caller) {
    await attest(session, published['uri'] as String, Cid.parse(published['cid'] as String));
  }
  await completeRelease(caller, registry, did, version.toString(), `${name} ${version.toString()}`, approveAs);
}

/**
 * Asks the registry to write the release of `pkg` at `version`, which it holds
 * until its maintainers' attestations are enough, and says whether it did
 * or what the release waits for. `label` names the release, and
 * `approveAs` the package, for `zena pkg approve`.
 */
export async function completeRelease(caller: Caller, registry: Registry, pkg: String, version: String, label: String,
    approveAs: String): Future<void> {
  let input = new JsonObject();
  input['package'] = pkg;
  input['version'] = version;
  let client = await callerClient(caller, registry, COMPLETE_RELEASE);
  let answer = (await client.procedure(COMPLETE_RELEASE, input)) as JsonObject;
  if ((answer['state'] as String) == 'published') {
    console.log(`Published ${label}: ${answer['uri'] as String}`);
    return;
  }
  console.log(`${label} is waiting for approval: ${approvals(answer)}.`);
  console.log(`Another maintainer approves it with: zena pkg approve ${approveAs}@${version}`);
}

/**
 * How far the attestations a `completeRelease` or `getPendingReleases`
 * answer lists are from enough, as a phrase.
 */
export function approvals(answer: JsonObject): String {
  let approved = (answer['approvedBy'] as JsonArray).length;
  let people = (answer['people'] as Box<f64>).value as i32;
  let threshold = (answer['threshold'] as Box<f64>).value as i32;
  let humans = (answer['humans'] as Box<f64>).value as i32;
  let needed = if (humans == 0) '' else if (humans == 1) ', one of them a person' else `, ${humans} of them people`;
  let phrase = `approved by ${approved} of the ${threshold} maintainers it needs${needed}`;
  if (approved >= threshold && people >= humans) {
    // Enough, but for automation the registry holds, which counts only with a person.
    return `${phrase}; an automation account on the registry counts only together with a person`;
  }
  return phrase;
}

/** Writes the maintainer's attestation of the record at `uri` to their own repository. */
export async function attest(session: Session, uri: String, cid: Cid): Future<void> {
  let attestation = new Attestation(uri, cid, formatTimestamp(nowNanos()));
  let input = new JsonObject();
  input['repo'] = session.did;
  input['collection'] = ATTESTATION_TYPE;
  input['rkey'] = attestation.recordKey();
  input['record'] = toJson(attestation.toValue());
  await session.client().procedure(REPO_PUT_RECORD, input);
}

/**
 * The release's dependencies: the manifest's published ones, and each path
 * dependency as the DID and version its own manifest gives, so a package
 * another depends on is published first.
 */
async function dependenciesOf(target: WorkspacePackage, manifest: Manifest): Future<FixedArray<Dependency>> {
  let all = new GrowableArray<Dependency>();
  manifest.requirements.forEach((name, requirement) => {
    all.push(new Dependency(requirement.did, requirement.range, name));
  });
  for (let name in manifest.paths.keys()) {
    let path = manifest.paths[name];
    let dir = join2(target.dir, path);
    let other = readManifest(await readFile(`${dir}/zena-package.json`));
    if (other.did == null || other.version == null) {
      throw new PublishError(`${name} (${dir}) has no DID and version yet; publish it first`);
    }
    all.push(new Dependency(other.did as String, Range.parse(`^${(other.version as Version).toString()}`), name));
  }
  let fixed = new FixedArray<Dependency>(all.length, new Dependency('', Range.parse('*'), ''));
  for (var i = 0; i < all.length; i += 1) {
    fixed[i] = all[i];
  }
  return fixed;
}

/**
 * The files of the package in `dir` that `manifest` publishes, by path
 * from it (`package-manager/files`): those its `files` list names, or all
 * but its tests, and never hidden ones, `node_modules`, `zena-lock.json`,
 * or the files of packages nested in it, which are published on their own.
 */
async function sourceFiles(dir: String, manifest: Manifest): Future<OrderedHashMap<String, FixedArray<u8>>> {
  let files = new OrderedHashMap<String, FixedArray<u8>>();
  await addFiles(dir, '', PublishedFiles.of(manifest), files);
  return files;
}

/**
 * Adds the files under `dir`, at `prefix` in the package, that `published`
 * takes. A directory that holds a `zena-package.json` is a package of its
 * own, published on its own.
 */
async function addFiles(dir: String, prefix: String, published: PublishedFiles,
    files: OrderedHashMap<String, FixedArray<u8>>): Future<void> {
  for (let entry in await listDir(dir)) {
    let name = entry.name;
    if (name.startsWith('.') || name == 'node_modules' || (prefix == '' && name == 'zena-lock.json')) {
      continue;
    }
    let path = `${dir}/${name}`;
    let relative = if (prefix == '') name else `${prefix}/${name}`;
    if (entry.fileType == FileType.Directory) {
      if (!(await exists(`${path}/zena-package.json`))) {
        await addFiles(path, relative, published, files);
      }
    } else if (entry.fileType == FileType.RegularFile && published.includes(relative)) {
      files[relative] = await readFileBytes(path);
    }
  }
}

function nowNanos(): i64 {
  let instant = now();
  return instant.seconds * (1000000000 as i64) + (instant.nanoseconds as i64);
}

function strings(items: Array<String>): JsonArray {
  let array = new JsonArray();
  for (let item in items) {
    array.push(item);
  }
  return array;
}
