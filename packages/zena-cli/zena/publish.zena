/**
 * `zena publish` and `zena package create`: publishing the package the
 * command is run in to a package host (docs/design/package-manager.md,
 * "Creating a package" and "Publishing a release").
 *
 * Both act as the signed-in maintainer (`zena login`): each call to the
 * host carries a service-auth token from the maintainer's own PDS. A
 * package whose manifest has no `did` yet is created first, once `--yes`
 * says to, in the scope its manifest names, else its workspace root's,
 * else `--scope`. The scope must exist: `zena scope create` makes one
 * (`scope.zena`), and publishing never does. The new package's DID is
 * written into `zena-package.json`, with the scope when `--scope` gave it.
 * A package that has a DID is checked against its scope: its handle must
 * be its name in that scope.
 *
 * Publishing packs the files the manifest publishes (`package-manager:files`)
 * into a source archive, uploads it, writes the release for the manifest's
 * `version`, and writes the maintainer's attestation of the release to
 * their own repository. The release is checked first, before the host is
 * asked anything, so a package whose release would be refused is never
 * created.
 *
 * The host is `--host`, else `ZENA_PACKAGE_HOST`, else
 * `https://pkg.zena-lang.dev`; its service DID and handle domain come from
 * its `com.atproto.server.describeServer`, and the DID must be the
 * origin's own (`checkHostDid`) before any token is made for it.
 */

import { ParsedArgs } from 'zena:args';
import { runFuture } from 'zena:async';
import { getEnv } from 'zena:cli';
import { OrderedHashMap } from 'zena:collections';
import { FileType, existsSync, listDirSync, readFileBytesSync, readFileSync, writeFileSync } from 'zena:fs';
import { hex } from 'zena:encoding';
import { JsonArray, JsonObject } from 'zena:json';
import { join2 } from 'zena:path';
import { formatTimestamp } from 'zena:time';
import { now } from 'wasi:clocks/system-clock';
import { Cid } from 'atproto:cid';
import { BlobRef, fromJson, toJson } from 'atproto:data';
import { KeyType, formatDidKey, publicKeyFor } from 'atproto:didkey';
import { Session, getServiceAuth } from 'atproto:session';
import { XrpcClient, XrpcError } from 'atproto:xrpc';
import { packSource } from 'package-manager:archive';
import { SOURCE_MIME_TYPE, checkDependencies, checkMetadata, validateRelease } from 'package-manager:validate';
import { PublishedFiles } from 'package-manager:files';
import { Manifest, readManifest, writeDid } from 'package-manager:manifest';
import {
  ATTESTATION_TYPE, Artifact, Attestation, Dependency, Maintainer, Maintainers, OWNER, POLICY_TYPE, Policy, Profile,
  Release, SOURCE
} from 'package-manager:records';
import { Version } from 'package-manager:version';
import { DiskFiles, WorkspacePackage, readWorkspace } from 'package-manager:workspace';
import { Options, repoRoot, userCwd } from './env.zena';
import { packageResolver } from './fetch.zena';
import { didWebHost } from 'atproto:identity';
import { URL } from 'zena:url';
import { configDir, currentSession, saveSession } from './login.zena';
import { REPO_GET_RECORD, REPO_PUT_RECORD, SERVER_DESCRIBE_SERVER } from 'atproto:methods';
import {
  COMPLETE_RELEASE, CREATE_ORGANIZATION, CREATE_PACKAGE, PUBLISH, UPLOAD_ARTIFACT
} from 'package-manager:host-methods';

let DEFAULT_HOST = 'https://pkg.zena-lang.dev';

/** A DID no package has, for checking a release before its package exists. */
let STAND_IN_DID = 'did:plc:aaaaaaaaaaaaaaaaaaaaaaaa';

/** A package host, as its `describeServer` describes it. */
export final class Host {
  origin: String;
  /** The DID tokens for it are addressed to. */
  did: String;
  /** The domain its scopes' handles are under. */
  domain: String;

  new(origin: String, did: String, domain: String) : origin = origin, did = did, domain = domain;
}

/** A failure to report, with no stack: the command's own errors. */
export class PublishError extends Error {
  new(message: String) : super(message);
}

export function publishCommand(args: ParsedArgs, options: Options): i32 {
  return runCommand(() => {
    let target = currentPackage();
    refuseWitDependencies(target.manifest);
    refuseProblems(checkMetadata(target.manifest, target.manifestPath()));
    requirePublished(dependenciesOf(target, target.manifest));
    var manifestText = target.text as String;
    if (target.manifest.did == null) {
      // Everything about the release is checked before anything is asked
      // of the host, let alone the package created: with a stand-in for
      // the DID it will have, written into the manifest as createPackage
      // writes the real one. Only the DID's value is left to check once
      // it exists.
      let draft = writeDid(manifestText, STAND_IN_DID, null);
      prepareRelease(target, readManifest(draft), STAND_IN_DID, draft);
    }
    let session = signedIn();
    let host = findHost(args);
    if (target.manifest.did == null) {
      manifestText = createPackage(args, session, host, target);
    } else {
      checkScope(args, host, target);
    }
    let manifest = readManifest(manifestText);
    let scope = scopeOf(args, target);
    let approveAs = if (scope != null) `@${scope as String}/${manifest.name as String}` else manifest.did as String;
    publish(session, host, target, manifest, prepareRelease(target, manifest, manifest.did as String, manifestText),
        approveAs);
    saveIfRefreshed(session);
  });
}

export function packageCreateCommand(args: ParsedArgs, options: Options): i32 {
  return runCommand(() => {
    let target = currentPackage();
    if (target.manifest.did != null) {
      throw new PublishError(`${target.manifestPath()} already names its package: ${target.manifest.did as String}`);
    }
    refuseProblems(checkMetadata(target.manifest, target.manifestPath()));
    let session = signedIn();
    createPackage(args, session, findHost(args), target);
    saveIfRefreshed(session);
  });
}

/**
 * Runs `body`, printing the message alone for a `PublishError`, or for a
 * call the host or a PDS refused (`XrpcError`, which names the error).
 */
export function runCommand(body: () => void): i32 {
  try {
    body();
    return 0;
  } catch (e) {
    // TODO(#99): read `message` on the narrowed union.
    let message = e.message;
    if (e is PublishError || e is XrpcError) {
      console.error(`Error: ${message}`);
      return 1;
    }
    throw e;
  }
}

function currentPackage(): WorkspacePackage {
  let workspace = readWorkspace(repoRoot().value, new DiskFiles());
  let target = workspace.packageAt(userCwd().value);
  if (target.text == null || target.manifest.name == null) {
    throw new PublishError('run this in a package: a directory whose zena-package.json has a name');
  }
  return target;
}

/**
 * Throws for a WIT dependency, which a published package cannot have: its
 * path is on this disk (docs/design/package-manifest.md). Checked before
 * anything is created on the host.
 */
function refuseWitDependencies(manifest: Manifest): void {
  manifest.wits.forEach((name, wit) => {
    throw new PublishError(
        `${name} is the WIT in ${wit}, which a published package cannot depend on; publish the WIT as a package of its own`);
  });
}

/**
 * Throws unless each dependency is a release that is published and not
 * retracted: a release that names one that is not could never be resolved.
 * Checked before anything is created on the host.
 */
function requirePublished(dependencies: FixedArray<Dependency>): void {
  refuseProblems(runFuture(checkDependencies(dependencies, packageResolver())));
}

/** Throws the problems the checks found, when there are any. */
function refuseProblems(problems: Array<String>): void {
  if (problems.length == 0) {
    return;
  }
  var message = 'the release cannot be published:';
  for (let problem in problems) {
    message = `${message}\n  ${problem}`;
  }
  throw new PublishError(message);
}

export function signedIn(): Session {
  let session = currentSession();
  if (session == null) {
    throw new PublishError('sign in first, with zena login');
  }
  return session as Session;
}

export function saveIfRefreshed(session: Session): void {
  if (session.refreshed) {
    saveSession(session);
  }
}

export function findHost(args: ParsedArgs): Host {
  var origin = getEnv('ZENA_PACKAGE_HOST') ?? DEFAULT_HOST;
  if (let (true, given) = args.getOption('host')) {
    origin = given;
  }
  let described = runFuture(new XrpcClient(origin).query(SERVER_DESCRIBE_SERVER)) as JsonObject;
  let domains = described['availableUserDomains'] as JsonArray;
  let domain = domains[0] as String;
  let did = described['did'] as String;
  checkHostDid(origin, did);
  return new Host(origin, did, if (domain.startsWith('.')) domain.sliceBytes(1, domain.length) else domain);
}

/**
 * Throws unless `did`, the DID the server at `origin` says it has, is the
 * origin's own: a `did:web` by its host, which only the origin's domain can
 * hold, and a `did:plc` by the PDS endpoint its document names. Tokens for
 * the host are addressed to its DID, so a server at any other origin that
 * answered with the real host's DID would be given tokens it could replay
 * to the real host, as whoever asked for them.
 */
function checkHostDid(origin: String, did: String): void {
  let url = URL.parse(origin);
  if (url == null) {
    throw new PublishError(`the package host ${origin} is not a URL`);
  }
  let parsed = url as URL;
  let authority = if (parsed.port == '') parsed.hostname else `${parsed.hostname}:${parsed.port}`;
  if (did.startsWith('did:web:')) {
    let named = try {
      didWebHost(did)
    } catch (e) {
      throw new PublishError(`the package host ${origin} says it is ${did}: ${e.message}`);
    };
    if (named.asciiLowerCase() != authority.asciiLowerCase()) {
      throw new PublishError(`the package host ${origin} says it is ${did}, which is the host at ${named}, not ${authority}`);
    }
    return;
  }
  if (did.startsWith('did:plc:')) {
    let endpoint = runFuture(packageResolver().resolveDid(did)).pds;
    if (endpoint == null || trimSlash(endpoint as String) != trimSlash(`${parsed.protocol}//${authority}`)) {
      throw new PublishError(`the package host ${origin} says it is ${did}, whose PDS is ${endpoint ?? 'none'}`);
    }
    return;
  }
  throw new PublishError(`the package host ${origin} says it is ${did}, which is neither a did:web nor a did:plc`);
}

/** `url` without a trailing `/`. */
function trimSlash(url: String): String {
  return if (url.endsWith('/')) url.sliceBytes(0, url.length - 1) else url;
}

/** A client for `host` that calls `method` as the signed-in maintainer. */
export function hostClient(session: Session, host: Host, method: String): XrpcClient {
  let token = runFuture(getServiceAuth(session, host.did, method));
  let client = new XrpcClient(host.origin);
  client.authorization = `Bearer ${token}`;
  return client;
}

/**
 * The scope `target` is in: `--scope`, which must agree with the manifest
 * when the manifest names one, else the manifest's, else its workspace
 * root's (package-manifest.md, "scope"). Null when none names one.
 */
function scopeOf(args: ParsedArgs, target: WorkspacePackage): String | null {
  let named = target.manifest.scope ?? rootScope();
  if (let (true, given) = args.getOption('scope')) {
    if (named != null && named != given) {
      throw new PublishError(`${target.manifestPath()} puts ${target.manifest.name as String} in the scope ${named}, not ${given}`);
    }
    return given;
  }
  return named;
}

/** The scope the workspace's root manifest names for its packages, or null. */
function rootScope(): String | null {
  return readWorkspace(repoRoot().value, new DiskFiles()).root.manifest.scope;
}

/**
 * Throws unless the package `target` names, which has a DID, has its name
 * in its scope as its handle: otherwise the manifest and the package
 * disagree about where it is, as for a manifest copied from another
 * package, or a package renamed without its manifest following. A package
 * with no scope, such as one whose handle is on its maintainers' own
 * domain, is not checked.
 */
function checkScope(args: ParsedArgs, host: Host, target: WorkspacePackage): void {
  let scope = scopeOf(args, target);
  if (scope == null) {
    return;
  }
  let did = target.manifest.did as String;
  let expected = `${target.manifest.name as String}.${scope as String}.${host.domain}`;
  let handle = runFuture(packageResolver().resolveDid(did)).handle;
  if (handle != expected) {
    throw new PublishError(
        `${did} is ${handle ?? 'a package with no handle'}, not ${expected}: ${target.manifestPath()} names the scope ${scope as String}`);
  }
}

/**
 * Creates the package `target` is on `host`, in its scope (`scopeOf`),
 * which must exist, and writes its DID into the manifest, with the scope
 * when only `--scope` named it. Returns the manifest's new text.
 */
function createPackage(args: ParsedArgs, session: Session, host: Host, target: WorkspacePackage): String {
  let name = target.manifest.name as String;
  let found = scopeOf(args, target);
  if (found == null) {
    throw new PublishError(
        `${name} has no DID yet; name the scope to create it in, with "scope" in ${target.manifestPath()} or --scope <name>`);
  }
  let scope = found as String;
  let org = scopeOrganization(`${scope}.${host.domain}`);
  if (org == null) {
    throw new PublishError(`${host.origin} has no scope ${scope}; create it with zena scope create ${scope}`);
  }
  let handle = `${name}.${scope}.${host.domain}`;
  if (!args.getFlag('yes')) {
    throw new PublishError(
        `${name} has no DID yet. Run again with --yes to create the package ${handle} on ${host.origin}, maintained by ${session.handle}.`);
  }
  let recoveryKeys = recoveryDidKeys();

  let input = new JsonObject();
  input['organization'] = org as String;
  input['recoveryKeys'] = strings(recoveryKeys);
  // The profile says what the manifest says, for the index to show.
  input['profile'] = toJson(new Profile(name, target.manifest.description, target.manifest.license).toValue());
  input['maintainers'] = toJson(initialMaintainers(session.did, org as String).toValue());
  let created = runFuture(hostClient(session, host, CREATE_PACKAGE)
    .procedure(CREATE_PACKAGE, input)) as JsonObject;
  let did = created['did'] as String;
  let text = writeDid(target.text as String, did,
      if (target.manifest.scope == null && rootScope() != scope) scope else null);
  writeFileSync(target.manifestPath(), text);
  console.log(`Created ${created['handle'] as String} (${did}), and wrote its DID into ${target.manifestPath()}.`);
  return text;
}

/**
 * A new package's maintainers record, as `org`'s policy has its packages
 * start: `creator` as its owner, beside the policy's default teams, with
 * its default thresholds.
 */
function initialMaintainers(creator: String, org: String): Maintainers {
  let policy = scopePolicy(org);
  let maintainers = new GrowableArray<Maintainer>();
  maintainers.push(Maintainer.ofDid(creator, OWNER));
  for (let team in policy.defaultTeams) {
    maintainers.push(new Maintainer(null, null, org, team.team, team.role));
  }
  let list = new FixedArray<Maintainer>(maintainers.length, maintainers[0]);
  for (var i = 0; i < maintainers.length; i += 1) {
    list[i] = maintainers[i];
  }
  let record = new Maintainers(list, policy.defaultThreshold, policy.defaultOwnerThreshold);
  record.humans = policy.defaultHumans;
  return record;
}

/** `org`'s policy for the packages in its scope, from its repository, or the one that asks nothing. */
export function scopePolicy(org: String): Policy {
  let document = runFuture(packageResolver().resolveDid(org));
  if (document.pds == null) {
    throw new PublishError(`${org} names no PDS`);
  }
  let params: Array<(String, String)> = [('repo', org), ('collection', POLICY_TYPE), ('rkey', 'self')];
  try {
    let answer = runFuture(new XrpcClient(document.pds as String).query(REPO_GET_RECORD, params)) as JsonObject;
    return Policy.fromValue(fromJson(answer['value']));
  } catch (e) {
    if (e is XrpcError && (e as XrpcError).error == 'RecordNotFound') {
      return new Policy();
    }
    throw e;
  }
}

/**
 * Creates the scope `scope` on `host`, owned by the signed-in maintainer,
 * and attests its members record. Returns the organization's DID.
 */
export function createOrganization(session: Session, host: Host, scope: String): String {
  let input = new JsonObject();
  input['name'] = scope;
  input['recoveryKeys'] = strings(recoveryDidKeys());
  let created = runFuture(hostClient(session, host, CREATE_ORGANIZATION)
    .procedure(CREATE_ORGANIZATION, input)) as JsonObject;
  console.log(`Created the scope ${created['handle'] as String} (${created['did'] as String}), with you as its owner.`);
  let members = created['members'] as JsonObject;
  attest(session, members['uri'] as String, Cid.parse(members['cid'] as String));
  return created['did'] as String;
}

/**
 * The organization the handle of a scope names, or null when the handle
 * does not resolve, as for a scope that does not exist yet. The host
 * refuses to create a scope that does exist (`NameTaken`), so a lookup
 * that fails for another reason does no harm.
 */
export function scopeOrganization(handle: String): String | null {
  try {
    return runFuture(packageResolver().resolveHandle(handle));
  } catch (e) {
    return null;
  }
}

/**
 * The recovery keys to rank above the host's, as `did:key`s: the
 * maintainer's, when they keep one in the configuration directory, and
 * none otherwise. None is never made here: the host holds the accounts it
 * creates, and a recovery key is for owners who choose to keep one
 * (package-manager.md, "Keys").
 */
function recoveryDidKeys(): Array<String> {
  let path = `${configDir()}/recovery-key`;
  if (!existsSync(path)) {
    return [];
  }
  return [formatDidKey(publicKeyFor(KeyType.Secp256k1, hex.decode(readFileSync(path).trim())))];
}

/** A release of a package, and the source archive it names, checked and ready to upload. */
final class PreparedRelease {
  release: Release;
  archive: FixedArray<u8>;

  new(this.release, this.archive);
}

/**
 * `manifest`'s version of `target`, the package `did`, packed and checked
 * as the host and every fetch will check it: its source archive, with
 * `manifestText` as its `zena-package.json`, and its release record.
 * Throws the problems found.
 */
function prepareRelease(target: WorkspacePackage, manifest: Manifest, did: String, manifestText: String)
    : PreparedRelease {
  if (manifest.version == null) {
    throw new PublishError(`${target.manifestPath()} has no version to publish`);
  }
  let files = sourceFiles(target.dir, manifest);
  files['zena-package.json'] = manifestText.toBytes() as FixedArray<u8>;
  let archive = packSource(files);
  // The blob the host will store, named by its contents, so the release is
  // checked as the host and every fetch will check it before anything is
  // uploaded.
  let blob = new BlobRef(Cid.forBlob(archive), SOURCE_MIME_TYPE, archive.length as i64);
  let release = new Release(manifest.version as Version, formatTimestamp(nowNanos()),
      new FixedArray<Artifact>(1, Artifact.whole(SOURCE, blob)), dependenciesOf(target, manifest));
  refuseProblems(runFuture(validateRelease(release, did, archive, manifest.name as String, packageResolver())));
  return new PreparedRelease(release, archive);
}

/**
 * Uploads and publishes `prepared`, `manifest`'s version of `target`,
 * attests it, and completes it, unless it waits for other maintainers to
 * approve it, as `zena approve <approveAs>@<version>`.
 */
function publish(session: Session, host: Host, target: WorkspacePackage, manifest: Manifest,
    prepared: PreparedRelease, approveAs: String): void {
  let name = manifest.name as String;
  let did = manifest.did as String;
  let version = manifest.version as Version;
  let archive = prepared.archive;
  let release = prepared.release;
  let blob = release.artifact(SOURCE) as Artifact;

  let uploaded = runFuture(hostClient(session, host, UPLOAD_ARTIFACT)
    .upload(UPLOAD_ARTIFACT, SOURCE_MIME_TYPE, archive, [('package', did)]))
    as JsonObject;
  if (!BlobRef.fromValue(fromJson(uploaded['blob'])).cid.equals(blob.cid)) {
    throw new PublishError('the host stored the archive under another CID');
  }
  let input = new JsonObject();
  input['package'] = did;
  input['release'] = toJson(release.toValue());
  let published = runFuture(hostClient(session, host, PUBLISH)
    .procedure(PUBLISH, input)) as JsonObject;
  attest(session, published['uri'] as String, Cid.parse(published['cid'] as String));
  completeRelease(session, host, did, version.toString(), `${name} ${version.toString()}`, approveAs);
}

/**
 * Asks the host to write the release of `pkg` at `version`, which it holds
 * until its maintainers' attestations are enough, and says whether it did
 * or what the release waits for. `label` names the release, and
 * `approveAs` the package, for `zena approve`.
 */
export function completeRelease(session: Session, host: Host, pkg: String, version: String, label: String,
    approveAs: String): void {
  let input = new JsonObject();
  input['package'] = pkg;
  input['version'] = version;
  let answer = runFuture(hostClient(session, host, COMPLETE_RELEASE)
    .procedure(COMPLETE_RELEASE, input)) as JsonObject;
  if ((answer['state'] as String) == 'published') {
    console.log(`Published ${label}: ${answer['uri'] as String}`);
    return;
  }
  console.log(`${label} is waiting for approval: ${approvals(answer)}.`);
  console.log(`Another maintainer approves it with: zena approve ${approveAs}@${version}`);
}

/**
 * How far the attestations a `completeRelease` or `getPendingReleases`
 * answer lists are from enough, as a phrase.
 */
export function approvals(answer: JsonObject): String {
  let approved = (answer['approvedBy'] as JsonArray).length;
  let people = (answer['people'] as Box<f64>).value as i32;
  let threshold = (answer['threshold'] as Box<f64>).value as i32;
  let humans = (answer['humans'] as Box<f64>).value as i32;
  let needed = if (humans == 0) '' else if (humans == 1) ', one of them a person' else `, ${humans} of them people`;
  let phrase = `approved by ${approved} of the ${threshold} maintainers it needs${needed}`;
  if (approved >= threshold && people >= humans) {
    // Enough, but for automation the host holds, which counts only with a person.
    return `${phrase}; an automation account on the host counts only together with a person`;
  }
  return phrase;
}

/** Writes the maintainer's attestation of the record at `uri` to their own repository. */
export function attest(session: Session, uri: String, cid: Cid): void {
  let attestation = new Attestation(uri, cid, formatTimestamp(nowNanos()));
  let input = new JsonObject();
  input['repo'] = session.did;
  input['collection'] = ATTESTATION_TYPE;
  input['rkey'] = attestation.recordKey();
  input['record'] = toJson(attestation.toValue());
  runFuture(session.client().procedure(REPO_PUT_RECORD, input));
}

/**
 * The release's dependencies: the manifest's published ones, and each path
 * dependency as the DID and version its own manifest gives, so a package
 * another depends on is published first.
 */
function dependenciesOf(target: WorkspacePackage, manifest: Manifest): FixedArray<Dependency> {
  let all = new GrowableArray<Dependency>();
  manifest.requirements.forEach((name, requirement) => {
    all.push(new Dependency(requirement.did, requirement.version, name));
  });
  manifest.paths.forEach((name, path) => {
    let dir = join2(target.dir, path);
    let other = readManifest(readFileSync(`${dir}/zena-package.json`));
    if (other.did == null || other.version == null) {
      throw new PublishError(`${name} (${dir}) has no DID and version yet; publish it first`);
    }
    all.push(new Dependency(other.did as String, other.version as Version, name));
  });
  let fixed = new FixedArray<Dependency>(all.length, new Dependency('', Version.parse('0.0.0'), ''));
  for (var i = 0; i < all.length; i += 1) {
    fixed[i] = all[i];
  }
  return fixed;
}

/**
 * The files of the package in `dir` that `manifest` publishes, by path
 * from it (`package-manager:files`): those its `files` list names, or all
 * but its tests, and never hidden ones, `node_modules`, `zena-lock.json`,
 * or the files of packages nested in it, which are published on their own.
 */
function sourceFiles(dir: String, manifest: Manifest): OrderedHashMap<String, FixedArray<u8>> {
  let files = new OrderedHashMap<String, FixedArray<u8>>();
  addFiles(dir, '', PublishedFiles.of(manifest), files);
  return files;
}

/**
 * Adds the files under `dir`, at `prefix` in the package, that `published`
 * takes. A directory that holds a `zena-package.json` is a package of its
 * own, published on its own.
 */
function addFiles(dir: String, prefix: String, published: PublishedFiles,
    files: OrderedHashMap<String, FixedArray<u8>>): void {
  for (let entry in listDirSync(dir)) {
    let name = entry.name;
    if (name.startsWith('.') || name == 'node_modules' || (prefix == '' && name == 'zena-lock.json')) {
      continue;
    }
    let path = `${dir}/${name}`;
    let relative = if (prefix == '') name else `${prefix}/${name}`;
    if (entry.fileType == FileType.Directory) {
      if (!existsSync(`${path}/zena-package.json`)) {
        addFiles(path, relative, published, files);
      }
    } else if (entry.fileType == FileType.RegularFile && published.includes(relative)) {
      files[relative] = readFileBytesSync(path);
    }
  }
}

function nowNanos(): i64 {
  let instant = now();
  return instant.seconds * (1000000000 as i64) + (instant.nanoseconds as i64);
}

function strings(items: Array<String>): JsonArray {
  let array = new JsonArray();
  for (let item in items) {
    array.push(item);
  }
  return array;
}
