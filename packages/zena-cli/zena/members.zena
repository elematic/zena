/**
 * Who belongs: `zena pkg scope add`, `remove`, `maintainers`, `settings`
 * and `upgrade` for a scope's maintainers, its owners and publishers;
 * `zena pkg org` for an organization's members, `zena pkg team` for its
 * teams, and `zena pkg owner` for a package's maintainers
 * (docs/design/package-manager.md, "Scopes" and "Adding and removing
 * people").
 *
 * Each change takes the same steps: read the record and its CID from the
 * account's repository, and the private entries behind its commitments
 * from the registry (`getEntries`); make the new person's entry, with a new
 * salt, or leave out the one removed; call the registry's method with the new
 * record, the entries, and the CID read, so that a change someone else
 * made since is refused rather than overwritten; attest the new record in
 * the caller's own repository; and ask the registry to write it
 * (`completeChange`). The registry holds it until the record before it allows
 * it: until enough of the owners or team maintainers that record names, or
 * the scope's owners, have attested it, which with thresholds of one is the
 * caller. Until then the command says what it waits for, and the others
 * approve it with `zena pkg approve` (`approve.zena`).
 */

import { ParsedArgs } from 'zena:args';
import { Future } from 'zena:async';
import { parseI32 } from 'zena:core';
import { JsonArray, JsonObject, JsonValue } from 'zena:json';
import { getRandomBytes } from 'wasi:random/random';
import { Cid } from 'atproto/cid';
import { fromJson, toJson } from 'atproto/data';
import { Session } from 'atproto/session';
import { XrpcClient } from 'atproto/xrpc';
import {
  MAINTAINER, MAINTAINERS_TYPE, MEMBER, MEMBERS_TYPE, Maintainer, Maintainers, MemberEntry, Members, OWNER,
  POLICY_TYPE, PUBLISHER, Policy, SCOPE_MAINTAINERS_TYPE, ScopeMaintainers, TEAM_TYPE, Team, TeamRole
} from 'package-manager/records';
import { isScopedIdentifier } from 'package-manager/registry';
import { DiskFiles, readWorkspace } from 'package-manager/workspace';
import { Options, workspaceRoot, userCwd } from './env.zena';
import { packageResolver } from './fetch.zena';
import {
  Registry, PublishError, attest, findRegistry, registryClient, runCommand, saveIfRefreshed, handleDid, signedIn
} from './publish.zena';
import { REPO_GET_RECORD } from 'atproto/methods';
import {
  COMPLETE_CHANGE, DELETE_TEAM, GET_ENTRIES, PUT_MAINTAINERS, PUT_MEMBERS, PUT_POLICY, PUT_SCOPE_MAINTAINERS, PUT_TEAM,
  UPGRADE_SCOPE
} from 'package-manager/registry-methods';

/** A record in an account's repository, as it is now. */
export final class Held {
  value: JsonValue;
  cid: String;
  uri: String;

  new(this.value, this.cid, this.uri);
}

/**
 * `zena pkg scope add <scope> <person> [--role publisher|owner]`, or with
 * `--team <org>/<team>` in place of the person: adds them to the scope's
 * maintainers, as a publisher unless `--role` says owner. A publisher creates
 * packages in the scope, and starts as an owner of each; an owner also
 * changes the scope, its policy and every package's maintainers in it.
 */
export async function scopeAddCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await changeScopeMaintainers(args, true);
}

/** `zena pkg scope remove <scope> <person>`, or `--team <org>/<team>`: takes them out of the scope's maintainers. */
export async function scopeRemoveCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await changeScopeMaintainers(args, false);
}

async function changeScopeMaintainers(args: ParsedArgs, adding: boolean): Future<i32> {
  return await runCommand(async (): Future<void> => {
    let verb = if (adding) 'add' else 'remove';
    let usage = `usage: zena pkg scope ${verb} <scope> <handle or DID>${
        if (adding) ' [--role publisher|owner]' else ''}, or zena pkg scope ${verb} <scope> --team <org>/<team>`;
    if (args.rest.length != 2 && args.rest.length != 3) {
      throw new PublishError(usage);
    }
    let scope = args.rest[1];
    let person = if (args.rest.length == 3) args.rest[2] else null;
    let role = roleOf(args, PUBLISHER, [PUBLISHER, OWNER]);
    let session = await signedIn();
    let registry = await findRegistry(args);
    let account = await scopeDid(registry, scope);
    let held = required(await current(account, SCOPE_MAINTAINERS_TYPE, 'self'), `${scope} has no maintainers record`);
    let record = ScopeMaintainers.fromValue(fromJson(held.value));
    let entries = await allEntries(session, registry, account, null, false, commitmentsIn(record.maintainers), scope);
    let change = await changeMaintainers(registry, args, record.maintainers, entries, person, adding, role, false, scope,
        usage);
    let input = new JsonObject();
    input['scope'] = account;
    input['maintainers'] = toJson(new ScopeMaintainers(change.maintainers, record.ownerThreshold).toValue());
    input['entries'] = entriesJson(change.fresh);
    input['swapRecord'] = held.cid;
    if (await write(session, registry, PUT_SCOPE_MAINTAINERS, input, `${scope}'s maintainers`, scope)) {
      console.log(if (adding) `Added ${change.who} to ${scope} as ${role}.` else `Removed ${change.who} from ${scope}.`);
    }
    await saveIfRefreshed(session);
  });
}

/** `zena pkg scope maintainers <scope>`: its owners and publishers, each named when the caller may see them. */
export async function scopeMaintainersCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    if (args.rest.length != 2) {
      throw new PublishError('give the scope: zena pkg scope maintainers <scope>');
    }
    let scope = args.rest[1];
    let session = await signedIn();
    let registry = await findRegistry(args);
    let account = await scopeDid(registry, scope);
    let held = required(await current(account, SCOPE_MAINTAINERS_TYPE, 'self'), `${scope} has no maintainers record`);
    let record = ScopeMaintainers.fromValue(fromJson(held.value));
    await printMaintainers(record.maintainers, await visibleEntries(session, registry, account, null));
    console.log(await scopeSettings(scope, account, record));
    await saveIfRefreshed(session);
  });
}

/**
 * `zena pkg scope settings <scope> [--owner-threshold <n>]`: how many of
 * the scope's owners must approve a change to its maintainers and policy,
 * and to an organization's members and teams. Without it, prints it. A
 * change to it is a change to the maintainers record, which the threshold
 * it replaces must approve.
 */
export async function scopeSettingsCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    if (args.rest.length != 2) {
      throw new PublishError('give the scope: zena pkg scope settings <scope> [--owner-threshold <n>]');
    }
    let scope = args.rest[1];
    let owners = countOption(args, 'owner-threshold', 1);
    let session = await signedIn();
    let registry = await findRegistry(args);
    let account = await scopeDid(registry, scope);
    let held = required(await current(account, SCOPE_MAINTAINERS_TYPE, 'self'), `${scope} has no maintainers record`);
    let record = ScopeMaintainers.fromValue(fromJson(held.value));
    if (owners < 0) {
      console.log(await scopeSettings(scope, account, record));
      await saveIfRefreshed(session);
      return;
    }
    let changed = new ScopeMaintainers(record.maintainers, owners);
    let input = new JsonObject();
    input['scope'] = account;
    input['maintainers'] = toJson(changed.toValue());
    input['entries'] = new JsonArray();
    input['swapRecord'] = held.cid;
    if (await write(session, registry, PUT_SCOPE_MAINTAINERS, input, `${scope}'s maintainers`, scope)) {
      console.log(await scopeSettings(scope, account, changed));
    }
    await saveIfRefreshed(session);
  });
}

/**
 * `zena pkg scope upgrade <scope> --yes`: makes the scope an organization,
 * with its owners as its first members, so that it has members and teams.
 * It keeps its DID, its handle and its packages, and its owners are the
 * organization's. The change waits for the scope's owners, as a change to
 * its maintainers does.
 */
export async function scopeUpgradeCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    if (args.rest.length != 2) {
      throw new PublishError('give the scope: zena pkg scope upgrade <scope> --yes');
    }
    let scope = args.rest[1];
    let session = await signedIn();
    let registry = await findRegistry(args);
    let account = await scopeDid(registry, scope);
    if ((await current(account, MEMBERS_TYPE, 'self')) != null) {
      throw new PublishError(`${scope} is an organization already`);
    }
    if (!args.getFlag('yes')) {
      throw new PublishError(
          `Run again with --yes to make ${scope} an organization, with its owners as its first members. A scope stays an organization.`);
    }
    let input = new JsonObject();
    input['scope'] = account;
    if (await write(session, registry, UPGRADE_SCOPE, input, `${scope}'s members`, scope)) {
      console.log(`${scope} is an organization, with its owners as its members. Add others with zena pkg org add ${scope} <person>.`);
    }
    await saveIfRefreshed(session);
  });
}

/**
 * `zena pkg scope policy <scope> [flags]`: the scope's policy for its
 * packages: the least a release needs, which applies to every package in
 * it at once (`--minimum-threshold`, `--minimum-humans`); and what a new
 * package's maintainers record starts with (`--default-teams
 * <org>/<team>:<role>,...`, `--default-threshold`,
 * `--default-owner-threshold`, `--default-humans`). A list given empty is
 * cleared. With no flags, prints it. A change to it waits for the scope's
 * owners, as a change to its maintainers does.
 */
export async function scopePolicyCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    if (args.rest.length != 2) {
      throw new PublishError('give the scope: zena pkg scope policy <scope> [--minimum-threshold <n>] ...');
    }
    let scope = args.rest[1];
    let session = await signedIn();
    let registry = await findRegistry(args);
    let account = await scopeDid(registry, scope);
    let held = await current(account, POLICY_TYPE, 'self');
    let policy = if (held == null) new Policy() else Policy.fromValue(fromJson(held.value));
    let minimum = countOption(args, 'minimum-threshold', 1);
    let minimumHumans = countOption(args, 'minimum-humans', 0);
    let threshold = countOption(args, 'default-threshold', 1);
    let owners = countOption(args, 'default-owner-threshold', 1);
    let humans = countOption(args, 'default-humans', 0);
    var changed = minimum >= (0 as i64) || minimumHumans >= (0 as i64) || threshold >= (0 as i64) ||
        owners >= (0 as i64) || humans >= (0 as i64);
    policy.minimumThreshold = if (minimum < (0 as i64)) policy.minimumThreshold else minimum;
    policy.minimumHumans = if (minimumHumans < (0 as i64)) policy.minimumHumans else minimumHumans;
    policy.defaultThreshold = if (threshold < (0 as i64)) policy.defaultThreshold else threshold;
    policy.defaultOwnerThreshold = if (owners < (0 as i64)) policy.defaultOwnerThreshold else owners;
    policy.defaultHumans = if (humans < (0 as i64)) policy.defaultHumans else humans;
    if (let (true, given) = args.getOption('default-teams')) {
      changed = true;
      let teams = new GrowableArray<TeamRole>();
      for (let item in listOption(given)) {
        let parts = item.split(':');
        let role = if (parts.length > 1) parts[1] else PUBLISHER;
        if (parts.length > 2 || (role != PUBLISHER && role != OWNER)) {
          throw new PublishError(`'${item}' is not <org>/<team>, <org>/<team>:publisher or <org>/<team>:owner`);
        }
        let (org, team) = teamName(parts[0]);
        teams.push(new TeamRole(await scopeDid(registry, org), team, role));
      }
      policy.defaultTeams = teams;
    }
    if (!changed) {
      console.log(describePolicy(scope, policy));
      await saveIfRefreshed(session);
      return;
    }
    let input = new JsonObject();
    input['scope'] = account;
    input['policy'] = toJson(policy.toValue());
    if (held != null) {
      input['swapRecord'] = held.cid;
    }
    if (await write(session, registry, PUT_POLICY, input, `${scope}'s policy`, scope)) {
      console.log(describePolicy(scope, policy));
    }
    await saveIfRefreshed(session);
  });
}

/** `given`, a list separated by commas, without empty items. */
function listOption(given: String): GrowableArray<String> {
  let items = new GrowableArray<String>();
  for (let part in given.split(',')) {
    let item = part.trim();
    if (item != '') {
      items.push(item);
    }
  }
  return items;
}

/** What `policy` asks of the packages in `scope`, in words. */
export function describePolicy(scope: String, policy: Policy): String {
  let people = if (policy.minimumHumans == (0 as i64)) '' else `, ${policy.minimumHumans} of them from people`;
  var teams = '';
  for (let team in policy.defaultTeams) {
    teams = `${teams} and the team ${team.team} of ${team.org} as ${team.role}`;
  }
  let humans = if (policy.defaultHumans == (0 as i64)) '' else `, ${policy.defaultHumans} of them from people`;
  return `Every release in ${scope} needs at least ${count(policy.minimumThreshold, "maintainer's attestation",
      "maintainers' attestations")}${people}.\nNew packages start maintained by their creator${teams}, with releases needing ${
      policy.defaultThreshold}${humans}, and changes to the maintainers ${count(policy.defaultOwnerThreshold, "owner's", "owners'")}.`;
}

/** How many owners a change to the scope `scope`, the account `account`, needs, in words. */
async function scopeSettings(scope: String, account: String, record: ScopeMaintainers): Future<String> {
  let organization = (await current(account, MEMBERS_TYPE, 'self')) != null;
  let also = if (organization) ", and so do changes to its members and teams, or a team's own threshold of its maintainers"
      else '';
  return `Changes to ${scope}'s maintainers and policy need ${count(record.ownerThreshold, 'owner')}${also}.`;
}

/**
 * `zena pkg org add|remove <org> <person>` and `zena pkg org members
 * <org>`: an organization's members, who are the people its teams can
 * have. Its scope's owners change them.
 */
export async function orgCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    let usage = 'usage: zena pkg org add|remove <org> <handle or DID>, or zena pkg org members <org>';
    let sub = if (args.rest.length > 0) args.rest[0] else '';
    if (!((sub == 'members' && args.rest.length == 2) || ((sub == 'add' || sub == 'remove') && args.rest.length == 3))) {
      throw new PublishError(usage);
    }
    let org = args.rest[1];
    let session = await signedIn();
    let registry = await findRegistry(args);
    let account = await scopeDid(registry, org);
    let held = required(await current(account, MEMBERS_TYPE, 'self'),
        `${org} is not an organization; zena pkg scope upgrade ${org} makes it one`);
    if (sub == 'members') {
      await printEntries(await visibleEntries(session, registry, account, null, true));
      await saveIfRefreshed(session);
      return;
    }
    let members = Members.fromValue(fromJson(held.value));
    let person = args.rest[2];
    let did = await personDid(person);
    let before = await allEntries(session, registry, account, null, true, members.members, org);
    let entries = withoutPerson(before, did);
    let fresh = new GrowableArray<MemberEntry>();
    if (sub == 'add') {
      let added = newEntry(did, MEMBER);
      entries.push(added);
      fresh.push(added);
    } else if (entries.length == before.length) {
      throw new PublishError(`${person} is not a member of ${org}`);
    }
    let input = new JsonObject();
    input['organization'] = account;
    input['members'] = toJson(new Members(commitmentsOf(entries)).toValue());
    input['entries'] = entriesJson(fresh);
    input['swapRecord'] = held.cid;
    if (await write(session, registry, PUT_MEMBERS, input, `${org}'s members`, org)) {
      console.log(if (sub == 'add') `Added ${person} to ${org}.` else `Removed ${person} from ${org}.`);
    }
    await saveIfRefreshed(session);
  });
}

/**
 * `zena pkg team create|add|remove|delete|members <org>/<team> ...`: an
 * organization's teams. A team is created empty, and its members must be
 * members of the organization.
 */
export async function teamCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    let usage = 'zena pkg team create|delete|members <org>/<team>, zena pkg team add|remove <org>/<team> <handle or DID>, or zena pkg team settings <org>/<team> [--threshold <n>]';
    if (args.rest.length < 2) {
      throw new PublishError(`give a subcommand and a team: ${usage}`);
    }
    let sub = args.rest[0];
    let (org, name) = teamName(args.rest[1]);
    let session = await signedIn();
    let registry = await findRegistry(args);
    let account = await scopeDid(registry, org);
    let held = await current(account, TEAM_TYPE, name);
    if (sub == 'create') {
      if (held != null) {
        throw new PublishError(`${org} already has the team ${name}`);
      }
      if (await putTeam(session, registry, org, account, name, new Team([]), [], null)) {
        console.log(`Created the team ${org}/${name}. Add its members with zena pkg team add ${org}/${name} <person>.`);
      }
    } else {
      if (held == null) {
        throw new PublishError(`${org} has no team ${name}`);
      }
      let found = held;
      let team = Team.fromValue(fromJson(found.value));
      if (sub == 'delete') {
        let input = new JsonObject();
        input['organization'] = account;
        input['name'] = name;
        input['swapRecord'] = found.cid;
        let client = await registryClient(session, registry, DELETE_TEAM);
        await client.procedure(DELETE_TEAM, input);
        console.log(`Deleted the team ${org}/${name}.`);
      } else if (sub == 'members') {
        await printEntries(await visibleEntries(session, registry, account, name));
      } else if (sub == 'settings' && args.rest.length == 2) {
        // How many of the team's maintainers must approve a change to it.
        let threshold = countOption(args, 'threshold', 1);
        if (threshold < 0) {
          console.log(teamSettings(org, name, team));
        } else {
          let changed = new Team(team.members, threshold);
          if (await putTeam(session, registry, org, account, name, changed, [], found.cid)) {
            console.log(teamSettings(org, name, changed));
          }
        }
      } else if ((sub == 'add' || sub == 'remove') && args.rest.length == 3) {
        let person = args.rest[2];
        let did = await personDid(person);
        let before = await allEntries(session, registry, account, name, false, team.members, `${org}/${name}`);
        let entries = withoutPerson(before, did);
        let fresh = new GrowableArray<MemberEntry>();
        if (sub == 'add') {
          let added = newEntry(did, roleOf(args, MEMBER, [MEMBER, MAINTAINER]));
          entries.push(added);
          fresh.push(added);
        } else if (entries.length == before.length) {
          throw new PublishError(`${person} is not on the team ${org}/${name}`);
        }
        if (await putTeam(session, registry, org, account, name, new Team(commitmentsOf(entries), team.threshold), fresh,
            found.cid)) {
          console.log(`${if (sub == 'add') 'Added' else 'Removed'} ${person} ${if (sub == 'add') 'to' else 'from'} ${org}/${name}.`);
        }
      } else {
        throw new PublishError(usage);
      }
    }
    await saveIfRefreshed(session);
  });
}

/**
 * `zena pkg owner add|remove|list`: a package's maintainers, for the package
 * in the current directory or the one `--package` names. A person is added
 * by commitment, so the record does not name them; `--team <org>/<team>`
 * adds or removes a team, and `--automation` marks an automation account
 * (`zena pkg ci create`), which the registry requires of one, as a publisher.
 * The owners of the package's scope can change it too.
 */
export async function ownerCommand(args: ParsedArgs, options: Options): Future<i32> {
  return await runCommand(async (): Future<void> => {
    let usage = 'zena pkg owner add|remove <handle or DID> [--role publisher|owner] [--automation], zena pkg owner add|remove --team <org>/<team>, zena pkg owner list, or zena pkg owner settings [--threshold <n>] [--owner-threshold <n>] [--humans <n>]';
    if (args.rest.length == 0) {
      throw new PublishError(usage);
    }
    let sub = args.rest[0];
    let session = await signedIn();
    let registry = await findRegistry(args);
    let pkg = await packageDid(registry, args);
    let held = await current(pkg, MAINTAINERS_TYPE, 'self');
    if (held == null) {
      throw new PublishError(`${pkg} has no maintainers record`);
    }
    let found = held;
    let record = Maintainers.fromValue(fromJson(found.value));
    if (sub == 'list') {
      await printMaintainers(record.maintainers, await visibleEntries(session, registry, pkg, null));
      console.log(packageSettings(record));
      await saveIfRefreshed(session);
      return;
    }
    if (sub == 'settings') {
      let threshold = countOption(args, 'threshold', 1);
      let owners = countOption(args, 'owner-threshold', 1);
      let humans = countOption(args, 'humans', 0);
      if (threshold < 0 && owners < 0 && humans < 0) {
        console.log(packageSettings(record));
        await saveIfRefreshed(session);
        return;
      }
      let changed = new Maintainers(record.maintainers, if (threshold < 0) record.threshold else threshold,
          if (owners < 0) record.ownerThreshold else owners);
      changed.humans = if (humans < 0) record.humans else humans;
      let input = new JsonObject();
      input['package'] = pkg;
      input['maintainers'] = toJson(changed.toValue());
      input['entries'] = new JsonArray();
      input['swapRecord'] = found.cid;
      if (await write(session, registry, PUT_MAINTAINERS, input, `the maintainers of ${pkg}`, await approveAsOf(args, pkg))) {
        console.log(packageSettings(changed));
      }
      await saveIfRefreshed(session);
      return;
    }
    if ((sub != 'add' && sub != 'remove') || args.rest.length > 2) {
      throw new PublishError(usage);
    }
    let entries = await allEntries(session, registry, pkg, null, false, commitmentsIn(record.maintainers), pkg);
    let person = if (args.rest.length == 2) args.rest[1] else null;
    let change = await changeMaintainers(registry, args, record.maintainers, entries, person, sub == 'add',
        roleOf(args, PUBLISHER, [PUBLISHER, OWNER]), true, pkg, usage);
    let changed = new Maintainers(change.maintainers, record.threshold, record.ownerThreshold);
    changed.humans = record.humans;
    let input = new JsonObject();
    input['package'] = pkg;
    input['maintainers'] = toJson(changed.toValue());
    input['entries'] = entriesJson(change.fresh);
    input['swapRecord'] = found.cid;
    if (await write(session, registry, PUT_MAINTAINERS, input, `the maintainers of ${pkg}`, await approveAsOf(args, pkg))) {
      console.log(`${if (sub == 'add') 'Added' else 'Removed'} ${change.who} ${if (sub == 'add') 'to' else 'from'} the maintainers of ${pkg}.`);
    }
    await saveIfRefreshed(session);
  });
}

/** A change to a maintainers record's list: whom it is about, the list after it, and the entries it adds. */
final class MaintainerChange {
  who: String;
  maintainers: FixedArray<Maintainer>;
  fresh: GrowableArray<MemberEntry>;

  new(this.who, this.maintainers, this.fresh);
}

/**
 * `maintainers`, a package's or a scope's, with the person `person`, or
 * the team `--team` names, added in `role` when `adding`, or else taken
 * out. `entries` are the entries behind the list's commitments, and `what`
 * names its account. A person is added by commitment; `--automation` marks
 * them as an automation account where `automation` allows one.
 */
async function changeMaintainers(registry: Registry, args: ParsedArgs, maintainers: FixedArray<Maintainer>,
    entries: Array<MemberEntry>, person: String | null, adding: boolean, role: String, automation: boolean,
    what: String, usage: String): Future<MaintainerChange> {
  var teamOrg: String | null = null;
  var teamLabel: String | null = null;
  var did: String | null = null;
  var who = '';
  if (let (true, given) = args.getOption('team')) {
    if (person != null) {
      throw new PublishError(usage);
    }
    let (org, name) = teamName(given);
    teamOrg = await scopeDid(registry, org);
    teamLabel = name;
    who = `the team ${given}`;
  } else if (person != null) {
    did = await personDid(person);
    who = person;
  } else {
    throw new PublishError(usage);
  }
  let kept = new GrowableArray<Maintainer>();
  for (let maintainer in maintainers) {
    let isThem = if (teamOrg != null) maintainer.org == teamOrg && maintainer.team == teamLabel
        else maintainerDid(maintainer, entries) == did;
    if (!isThem) {
      kept.push(maintainer);
    }
  }
  let fresh = new GrowableArray<MemberEntry>();
  if (adding) {
    if (teamOrg != null) {
      kept.push(new Maintainer(null, null, teamOrg, teamLabel, role));
    } else {
      let marked = automation && args.getFlag('automation');
      let added = new MemberEntry(did as String, role, getRandomBytes(32), marked);
      fresh.push(added);
      kept.push(new Maintainer(null, added.commitment(), null, null, role, marked));
    }
  } else if (kept.length == maintainers.length) {
    throw new PublishError(`${who} does not maintain ${what}`);
  }
  if (kept.length == 0) {
    throw new PublishError(`${what} would have no maintainers; add another first`);
  }
  let list = new FixedArray<Maintainer>(kept.length, kept[0]);
  for (var i = 0; i < kept.length; i += 1) {
    list[i] = kept[i];
  }
  return new MaintainerChange(who, list, fresh);
}

/** The commitments among `maintainers`. */
function commitmentsIn(maintainers: FixedArray<Maintainer>): GrowableArray<Cid> {
  let commitments = new GrowableArray<Cid>();
  for (let maintainer in maintainers) {
    if (maintainer.commitment != null) {
      commitments.push(maintainer.commitment as Cid);
    }
  }
  return commitments;
}

/**
 * Asks the registry for the change `method` makes with `input`, to `what`'s
 * record, attests the new record, and asks the registry to write it
 * (`completeChange`). Returns whether it did.
 */
async function write(session: Session, registry: Registry, method: String, input: JsonObject, what: String, approveAs: String)
    : Future<boolean> {
  let client = await registryClient(session, registry, method);
  let held = (await client.procedure(method, input)) as JsonObject;
  let uri = held['uri'] as String;
  let cid = held['cid'] as String;
  await attest(session, uri, Cid.parse(cid));
  return await completeChange(session, registry, uri, cid, what, approveAs);
}

/**
 * Asks the registry to write the change to the record at `uri`, whose new
 * record's CID is `cid`, once the record before it allows it. Returns
 * whether it did; otherwise says what the change to `what` waits for, and
 * the command that approves it, `zena pkg approve <approveAs>`.
 */
export async function completeChange(session: Session, registry: Registry, uri: String, cid: String, what: String,
    approveAs: String): Future<boolean> {
  let input = new JsonObject();
  input['uri'] = uri;
  input['cid'] = cid;
  let client = await registryClient(session, registry, COMPLETE_CHANGE);
  let answer = (await client.procedure(COMPLETE_CHANGE, input)) as JsonObject;
  if ((answer['state'] as String) == 'written') {
    return true;
  }
  console.log(`The change to ${what} is waiting for approval: ${changeApprovals(answer)}.`);
  console.log(`Another approves it with: zena pkg approve ${approveAs}`);
  return false;
}

/**
 * How far the attestations a `completeChange` or `getPendingChanges`
 * answer lists are from enough, as a phrase: each way the record before
 * it allows the change, any one of which is enough.
 */
export function changeApprovals(answer: JsonObject): String {
  let requirements = answer['requirements'] as JsonArray;
  var phrase = '';
  for (var i = 0; i < requirements.length; i += 1) {
    let requirement = requirements[i] as JsonObject;
    let role = requirement['role'] as String;
    let who = if (role == 'scope owner') "owners of the package's scope"
        else if (role == 'maintainer') 'maintainers of the team' else 'owners';
    let part = `approved by ${(requirement['approvedBy'] as JsonArray).length} of the ${
        (requirement['threshold'] as Box<f64>).value as i32} ${who} it needs`;
    phrase = if (phrase == '') part else `${phrase}, or ${part}`;
  }
  return phrase;
}

function teamSettings(org: String, name: String, team: Team): String {
  return `Changes to the team ${org}/${name} need ${count(team.threshold, 'of its maintainers', 'of its maintainers')
      }, or the owners of ${org}.`;
}

async function putTeam(session: Session, registry: Registry, org: String, account: String, name: String, team: Team,
    fresh: Array<MemberEntry>, swap: String | null): Future<boolean> {
  let input = new JsonObject();
  input['organization'] = account;
  input['name'] = name;
  input['team'] = toJson(team.toValue());
  input['entries'] = entriesJson(fresh);
  if (swap != null) {
    input['swapRecord'] = swap;
  }
  return await write(session, registry, PUT_TEAM, input, `the team ${org}/${name}`, org);
}

/** What a package's maintainers record asks of its releases and of changes to it. */
function packageSettings(record: Maintainers): String {
  let people = if (record.humans == (0 as i64)) ''
      else `, ${if (record.humans == (1 as i64)) 'one' else `${record.humans}`} of them from people`;
  return `Releases need ${count(record.threshold, "maintainer's attestation", "maintainers' attestations")}${people
      }, and changes to the maintainers ${count(record.ownerThreshold, "owner's", "owners'")}.`;
}

/**
 * How `zena pkg approve` names the package: as `--package` did, else as
 * `scope:name` from the manifest of the package in the current directory,
 * else by DID.
 */
async function approveAsOf(args: ParsedArgs, pkg: String): Future<String> {
  if (let (true, given) = args.getOption('package')) {
    return given;
  }
  let workspace = await readWorkspace(workspaceRoot().value, new DiskFiles());
  let manifest = workspace.packageAt(userCwd().value).manifest;
  let scope = manifest.scope ?? workspace.root.manifest.scope;
  if (manifest.did == pkg && scope != null && manifest.name != null) {
    return `${scope}:${manifest.name as String}`;
  }
  return pkg;
}

/** `n` and `one`, or `many` when `n` is not 1 (`one` with an s by default). */
function count(n: i64, one: String, many: String = ''): String {
  if (n == (1 as i64)) {
    return `1 ${one}`;
  }
  return `${n} ${if (many == '') `${one}s` else many}`;
}

/**
 * The count `--<name>` gives, at least `least`; -1 when it gives none. A
 * value that is not a whole number, or is too small, is refused.
 */
function countOption(args: ParsedArgs, name: String, least: i32): i64 {
  if (let (true, given) = args.getOption(name)) {
    if (let (true, n) = parseI32(given)) {
      if (n >= least) {
        return n as i64;
      }
    }
    throw new PublishError(`--${name} is a whole number of at least ${least}, not '${given}'`);
  }
  return -1 as i64;
}

/** `--role`, which must be one of `allowed`, or `fallback`. */
function roleOf(args: ParsedArgs, fallback: String, allowed: Array<String>): String {
  if (let (true, given) = args.getOption('role')) {
    for (let role in allowed) {
      if (role == given) {
        return given;
      }
    }
    var names = '';
    for (let role in allowed) {
      names = if (names == '') role else `${names}, ${role}`;
    }
    throw new PublishError(`'${given}' is not a role here: use ${names}`);
  }
  return fallback;
}

/** `<org>/<team>`, split. */
function teamName(text: String): (String, String) {
  let parts = text.split('/');
  if (parts.length != 2 || parts[0] == '' || parts[1] == '') {
    throw new PublishError(`'${text}' is not <org>/<team>`);
  }
  return (parts[0], parts[1]);
}

/** The DID of the scope `scope` on `registry`. */
export async function scopeDid(registry: Registry, scope: String): Future<String> {
  let handle = `${scope}.${registry.domain}`;
  let did = await handleDid(handle);
  if (did == null) {
    throw new PublishError(`${registry.origin} has no scope ${scope}`);
  }
  return did;
}

/** A person's DID, from a DID or a handle. */
export async function personDid(person: String): Future<String> {
  if (person.startsWith('did:')) {
    return person;
  }
  let did = await handleDid(person);
  if (did == null) {
    throw new PublishError(`${person} does not resolve to a DID`);
  }
  return did;
}

/**
 * The package `--package` names, by DID, handle or `scope:name` on the
 * registry, else the one in the current directory, by its manifest's DID.
 */
export async function packageDid(registry: Registry, args: ParsedArgs): Future<String> {
  if (let (true, given) = args.getOption('package')) {
    return await namedPackage(registry, given);
  }
  return await currentPackageDid();
}

/** The package `given` names, by DID, handle or `scope:name` on the registry. */
export async function namedPackage(registry: Registry, given: String): Future<String> {
  if (given.startsWith('did:')) {
    return given;
  }
  var handle = given;
  if (isScopedIdentifier(given)) {
    let parts = given.split(':');
    if (parts.length != 2 || parts[0] == '' || parts[1] == '') {
      throw new PublishError(`'${given}' is not <scope>:<name>`);
    }
    handle = `${parts[1]}.${parts[0]}.${registry.domain}`;
  }
  let did = await handleDid(handle);
  if (did == null) {
    throw new PublishError(`${given} does not resolve to a package`);
  }
  return did;
}

/** The DID of the package in the current directory, from its manifest. */
export async function currentPackageDid(): Future<String> {
  let workspace = await readWorkspace(workspaceRoot().value, new DiskFiles());
  let target = workspace.packageAt(userCwd().value);
  if (target.manifest.did == null) {
    throw new PublishError('run this in a published package, or name the package');
  }
  return target.manifest.did as String;
}

/** The record at `collection/rkey` in `did`'s repository, or null. */
export async function current(did: String, collection: String, rkey: String): Future<Held | null> {
  let document = await packageResolver().resolveDid(did);
  if (document.pds == null) {
    throw new PublishError(`${did} names no PDS`);
  }
  let params: Array<(String, String)> = [('repo', did), ('collection', collection), ('rkey', rkey)];
  try {
    let answer = (await new XrpcClient(document.pds as String).query(REPO_GET_RECORD, params))
      as JsonObject;
    return new Held(answer['value'], answer['cid'] as String, answer['uri'] as String);
  } catch (e) {
    return null;
  }
}

/** `held`, or a `PublishError` saying `missing`. */
function required(held: Held | null, missing: String): Held {
  if (held == null) {
    throw new PublishError(missing);
  }
  return held;
}

/**
 * Every entry behind `commitments`, the record of `what` as it is now.
 * Changing a record needs them all, which only those who may change it
 * see from the registry.
 */
async function allEntries(session: Session, registry: Registry, account: String, team: String | null, members: boolean,
    commitments: Array<Cid>, what: String): Future<GrowableArray<MemberEntry>> {
  let entries = await visibleEntries(session, registry, account, team, members);
  if (entries.length < commitments.length) {
    throw new PublishError(
        `you can see ${entries.length} of the ${commitments.length} people in ${what}, so you cannot change it`);
  }
  return entries;
}

/**
 * The entries the caller may see, from the registry, behind the
 * commitments of `account`'s maintainers record, or of an organization's
 * members record with `members`, or of its team `team`.
 */
export async function visibleEntries(session: Session, registry: Registry, account: String, team: String | null,
    members: boolean = false): Future<GrowableArray<MemberEntry>> {
  let params = new GrowableArray<(String, String)>();
  params.push(('account', account));
  if (team != null) {
    params.push(('team', team));
  }
  if (members) {
    params.push(('members', 'true'));
  }
  let client = await registryClient(session, registry, GET_ENTRIES);
  let answer = (await client.query(GET_ENTRIES, params)) as JsonObject;
  let list = answer['entries'] as JsonArray;
  let entries = new GrowableArray<MemberEntry>();
  for (var i = 0; i < list.length; i += 1) {
    entries.push(MemberEntry.fromValue(fromJson(list[i])));
  }
  return entries;
}

/** `entries` without those of `did`. */
function withoutPerson(entries: Array<MemberEntry>, did: String): GrowableArray<MemberEntry> {
  let kept = new GrowableArray<MemberEntry>();
  for (let entry in entries) {
    if (entry.did != did) {
      kept.push(entry);
    }
  }
  return kept;
}

/** A new entry for `did` in `role`, with a new salt. */
function newEntry(did: String, role: String): MemberEntry {
  return new MemberEntry(did, role, getRandomBytes(32));
}

function commitmentsOf(entries: Array<MemberEntry>): FixedArray<Cid> {
  let out = new FixedArray<Cid>(entries.length, Cid.forBlob(new FixedArray<u8>(0, 0 as u8)));
  for (var i = 0; i < entries.length; i += 1) {
    out[i] = entries[i].commitment();
  }
  return out;
}

function entriesJson(entries: Array<MemberEntry>): JsonArray {
  let list = new JsonArray();
  for (let entry in entries) {
    list.push(toJson(entry.toValue()));
  }
  return list;
}

/** The DID a maintainer stands for, when it is one person the caller can see. */
function maintainerDid(maintainer: Maintainer, entries: Array<MemberEntry>): String | null {
  if (maintainer.did != null) {
    return maintainer.did;
  }
  let commitment = maintainer.commitment;
  if (commitment != null) {
    for (let entry in entries) {
      if (entry.commitment().equals(commitment)) {
        return entry.did;
      }
    }
  }
  return null;
}

/** A maintainer as `zena pkg approve` shows them. */
export function describeMaintainer(maintainer: Maintainer, entries: Array<MemberEntry>): String {
  if (maintainer.org != null) {
    return `the team ${maintainer.team as String} of ${maintainer.org as String}`;
  }
  return maintainerDid(maintainer, entries) ?? `${(maintainer.commitment as Cid).toString()} (private)`;
}

/** Prints each maintainer, a person as `personLabel` names them, and their role. */
async function printMaintainers(maintainers: FixedArray<Maintainer>, entries: Array<MemberEntry>): Future<void> {
  for (let maintainer in maintainers) {
    let did = if (maintainer.org == null) maintainerDid(maintainer, entries) else null;
    let label = if (did != null) await personLabel(did) else describeMaintainer(maintainer, entries);
    console.log(`${label}${if (maintainer.automation) ' (automation)' else ''}  ${maintainer.role}`);
  }
}

/** Prints each entry, as `personLabel` names its person, and its role. */
async function printEntries(entries: Array<MemberEntry>): Future<void> {
  if (entries.length == 0) {
    console.log('(none you can see)');
  }
  for (let entry in entries) {
    console.log(`${await personLabel(entry.did)}  ${entry.role}`);
  }
}

/**
 * `did`, with its handle when the handle resolves back to it. A DID
 * document can claim any handle, so a claim alone is not shown.
 */
async function personLabel(did: String): Future<String> {
  try {
    let identity = await packageResolver().resolve(did);
    if (identity.handle != null) {
      return `${did} (${identity.handle as String})`;
    }
  } catch (e) {
    // A DID that does not resolve is still listed.
  }
  return did;
}
