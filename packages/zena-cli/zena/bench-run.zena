/**
 * `zena bench`: run a benchmark suite with `zena:bench`'s `runSuite`.
 *
 * All this command adds is what the library cannot do on its own: it
 * compiles a suite's `zena` variants, through the compile cache, with the
 * compiler linked into this module.
 */

import { ParsedArgs } from 'zena:args';
import { runSuite } from 'zena:bench';
import { exists } from 'zena:fs';
import { AbsolutePath, RelativePath, isAbsolute } from 'zena:path';
import { CompileRequest, compileCached } from './compile.zena';
import { Options, repoRelative, repoRoot, resolveUserPath } from './env.zena';

export let benchCommand = (args: ParsedArgs, options: Options): i32 => {
  if (args.rest.length == 0) {
    console.error('Error: bench needs a config file');
    return 2;
  }
  let config = resolveUserPath(args.rest[0]);
  if (!exists(config.value)) {
    console.error('Error: bench config not found: ' + config.value);
    return 2;
  }
  // The suite's paths are relative to its config, which is named
  // relative to this module's working directory, the repository root.
  let compile = (source: String): String => {
    let path = if (isAbsolute(source)) {
      new AbsolutePath(source)
    } else {
      repoRoot().join(new RelativePath(source))
    };
    return compileCached(new CompileRequest(path), options).value;
  };
  let configPath = repoRelative(config);
  if (let (true, out) = args.getOption('out')) {
    return runSuite(configPath, {
      out: resolveUserPath(out).value,
      debug: options.debug,
      compile: compile,
    });
  }
  return runSuite(configPath, {debug: options.debug, compile: compile});
};
