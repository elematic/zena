/**
 * The versions `zena` names: what `zena --version` prints, and every call
 * to a registry sends in its user-agent. Written by `npm run versions`
 * (dev/versions.zena) from each package's zena-package.json: change a
 * version there, never here.
 */

/** The version of `zena` itself, which stands for the build: packages/zena-cli/zena-package.json. */
export let CLI_VERSION = '0.0.1-preview.1';

/** The compiler's version: packages/zena-compiler/zena-package.json. */
export let COMPILER_VERSION = '0.0.1-preview.1';

/** The package manager's libraries' version: packages/package-manager/zena-package.json. */
export let PACKAGE_MANAGER_VERSION = '0.0.1-preview.1';
