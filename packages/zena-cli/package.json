{
  "name": "@zena-lang/zena-cli",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "zena": "wireit"
  },
  "wireit": {
    "zena": {
      "command": "../../target/release/zena-cli",
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "command": "cargo build --release",
      "files": [
        "Cargo.toml",
        "Cargo.lock",
        "src/**/*.rs"
      ],
      "output": [
        "target/release/zena-cli"
      ],
      "dependencies": []
    },
    "test": {
      "command": "cargo test",
      "#files": "cargo test does a dev build, so we have the same files as the build step.",
      "files": [
        "Cargo.toml",
        "Cargo.lock",
        "src/**/*.rs"
      ]
    }
  }
}
