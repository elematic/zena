/**
 * Changing who belongs, from end to end, against
 * `tests/fixtures/publish-stack.zena`: Alice creates a scope and a package,
 * adds Bob to the scope and to a team, gives the team the package, and Bob
 * publishes it until the team loses it.
 */

import {suite, test} from 'zena:test';
import {isTrue} from 'zena:assert';
import {JsonObject, parseJson} from 'zena:json';
import {Scratch, ZenaCommand, described, fakePdsOrigin, read, startFakePds, stopFakePds, write} from './cli-support.zena';

let ALICE = 'did:plc:alicealicealicealicealic';
let BOB = 'did:plc:bobbobbobbobbobbobbobbob';

export let tests = suite('zena pkg scope, team and owner', () => {
  test('adds people to a scope, a team and a package, and takes them away', async (ctx) => {
    let scratch = await Scratch.create('membership');
    let stack = await startFakePds(scratch, 'publish-stack.zena');
    try {
      await fakePdsOrigin(scratch, stack);
      let addresses = parseJson(await read(scratch.at('pds/stack.json'))) as JsonObject;
      // Each person signs in with a configuration directory of their own.
      let person = (who: String, dir: String) =>
        new ZenaCommand(scratch.at(dir), scratch.host('cache'))
          .set('ZENA_PLC_DIRECTORY', addresses['plc'] as String)
          .set('ZENA_DNS_OVER_HTTPS', addresses['dns'] as String)
          .set('ZENA_REGISTRY', addresses['registry'] as String)
          .set('ZENA_CONFIG_DIR', scratch.host(`config-${who}`));

      await write(scratch.at('lib/zena-package.json'), '{"name": "greet", "description": "A package for tests", "license": "MIT", "scope": "acme", "version": "1.0.0"}\n');
      await write(scratch.at('lib/greet.zena'), 'export function answer(): i32 { return 42; }\n');
      let alice = person('alice', 'lib');
      let bob = person('bob', 'lib');
      isTrue((await alice.run(['pkg', 'login', ALICE, '--password-stdin'], 'app-password\n')).succeeded(), 'alice signs in');
      isTrue((await bob.run(['pkg', 'login', BOB, '--password-stdin'], 'bob-password\n')).succeeded(), 'bob signs in');
      let scope = await alice.run(['pkg', 'scope', 'create', 'acme', '--yes']);
      isTrue(scope.succeeded(), described(scope));
      let published = await alice.run(['pkg', 'publish', '--yes']);
      isTrue(published.succeeded(), described(published));
      let did = (parseJson(await read(scratch.at('lib/zena-package.json'))) as JsonObject)['did'] as String;
      let manifestAt = async (version: String) => await write(scratch.at('lib/zena-package.json'),
          `{"name": "greet", "description": "A package for tests", "license": "MIT", "did": "${did}", "scope": "acme", "version": "${version}"}\n`);

      // Alice is the only member; Bob, who is none, sees no one and can
      // change nothing.
      let members = await alice.run(['pkg', 'scope', 'members', 'acme']);
      isTrue(members.succeeded() && members.stdout.contains(`${ALICE}  owner`), described(members));
      let outsider = await bob.run(['pkg', 'scope', 'add', 'acme', BOB, '--role', 'owner']);
      isTrue(!outsider.succeeded() && outsider.stderr.contains('cannot change it'), described(outsider));
      let badRole = await alice.run(['pkg', 'scope', 'add', 'acme', BOB, '--role', 'pope']);
      isTrue(!badRole.succeeded() && badRole.stderr.contains('not a role'), described(badRole));

      // Alice says how the scope presents itself; Bob, no admin, cannot.
      let profile = await alice.run(['pkg', 'scope', 'profile', 'acme', '--name', 'Acme Corp', '--website', 'https://acme.example/']);
      isTrue(profile.succeeded() && profile.stdout.contains('Changed the profile of acme'), described(profile));
      let info = await alice.run(['pkg', 'scope', 'info', 'acme']);
      isTrue(info.succeeded() && info.stdout.contains('Name: Acme Corp') &&
          info.stdout.contains('Website: https://acme.example/'), described(info));
      let badSite = await alice.run(['pkg', 'scope', 'profile', 'acme', '--website', 'javascript:alert(1)']);
      isTrue(!badSite.succeeded() && badSite.stderr.contains('not an http: or https: URL') &&
          !badSite.stderr.contains('backtrace'), described(badSite));
      let notAdmin = await bob.run(['pkg', 'scope', 'profile', 'acme', '--name', 'Bob Corp']);
      isTrue(!notAdmin.succeeded() && notAdmin.stderr.contains('Forbidden'), described(notAdmin));

      // Alice adds Bob as an admin, who then sees every member.
      let added = await alice.run(['pkg', 'scope', 'add', 'acme', BOB, '--role', 'admin']);
      isTrue(added.succeeded() && added.stdout.contains('as admin'), described(added));
      let seen = await bob.run(['pkg', 'scope', 'members', 'acme']);
      isTrue(seen.succeeded() && seen.stdout.contains(`${ALICE}  owner`) && seen.stdout.contains(`${BOB}  admin`),
          described(seen));
      // Alice's own attestation was enough, so nothing waits.
      let nothing = await alice.run(['pkg', 'approve', '@acme']);
      isTrue(!nothing.succeeded() && nothing.stderr.contains('no change to @acme is waiting for approval'),
          described(nothing));

      // A team, with Bob on it, publishes the package.
      let team = await alice.run(['pkg', 'team', 'create', 'acme/core']);
      isTrue(team.succeeded() && team.stdout.contains('Created the team acme/core'), described(team));
      let onTeam = await alice.run(['pkg', 'team', 'add', 'acme/core', BOB]);
      isTrue(onTeam.succeeded(), described(onTeam));
      let teamMembers = await bob.run(['pkg', 'team', 'members', 'acme/core']);
      isTrue(teamMembers.succeeded() && teamMembers.stdout.contains(`${BOB}  member`), described(teamMembers));
      let notYet = await bob.run(['pkg', 'publish']);
      isTrue(!notYet.succeeded(), described(notYet));
      let given = await alice.run(['pkg', 'owner', 'add', '--team', 'acme/core']);
      isTrue(given.succeeded() && given.stdout.contains('Added the team acme/core'), described(given));
      let owners = await alice.run(['pkg', 'owner', 'list']);
      isTrue(owners.succeeded() && owners.stdout.contains(`${ALICE}  owner`) &&
          owners.stdout.contains('the team core of did:plc:') && owners.stdout.contains('publisher'), described(owners));

      await manifestAt('1.1.0');
      let byBob = await bob.run(['pkg', 'publish']);
      isTrue(byBob.succeeded() && byBob.stdout.contains('Published greet 1.1.0'), described(byBob));
      // As a publisher, Bob does not choose the package's maintainers.
      let notOwner = await bob.run(['pkg', 'owner', 'add', ALICE, '--role', 'owner']);
      isTrue(!notOwner.succeeded() && notOwner.stderr.contains('Forbidden'), described(notOwner));

      // Taken away: the team loses the package, and Bob the scope.
      let taken = await alice.run(['pkg', 'owner', 'remove', '--team', 'acme/core']);
      isTrue(taken.succeeded(), described(taken));
      await manifestAt('1.2.0');
      let refused = await bob.run(['pkg', 'publish']);
      isTrue(!refused.succeeded() && refused.stderr.contains('Forbidden'), described(refused));
      let deleted = await alice.run(['pkg', 'team', 'delete', 'acme/core']);
      isTrue(deleted.succeeded(), described(deleted));
      let removed = await alice.run(['pkg', 'scope', 'remove', 'acme', BOB]);
      isTrue(removed.succeeded(), described(removed));
      let gone = await bob.run(['pkg', 'scope', 'members', 'acme']);
      isTrue(gone.succeeded() && gone.stdout.contains('none you can see'), described(gone));
      // The last owner stays: the registry refuses a record with none.
      let lastOwner = await alice.run(['pkg', 'scope', 'remove', 'acme', ALICE]);
      isTrue(!lastOwner.succeeded() && lastOwner.stderr.contains('InvalidRequest'), described(lastOwner));
    } finally {
      await stopFakePds(stack);
      await scratch.remove();
    }
  });
});
