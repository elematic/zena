/**
 * A PLC directory, DNS-over-HTTPS resolver and PDS serving two published
 * packages, for `tests/package_map.rs`:
 *
 * - `@acme/router` (router.acme.pkg.zena-lang.dev): 1.4.2 and 1.5.0, which
 *   need json 2.1.0, and 1.6.0, which is yanked;
 * - `@acme/json` (json.acme.pkg.zena-lang.dev): 2.0.0 and 2.1.0.
 *
 * Run from the repository root with `--dir <scratch>::/out`, it writes the
 * PLC directory's origin to `/out/plc.txt` and then serves until it is
 * killed. The DNS-over-HTTPS endpoint is `/dns-query` on the same origin.
 */

import {Future} from 'zena:async';
import {OrderedHashMap} from 'zena:collections';
import {writeFileSync} from 'zena:fs';
import {BlobRef} from 'atproto:data';
import {packSource} from 'package-manager:archive';
import {Artifact, Dependency, Profile, Release, SOURCE, Yank} from 'package-manager:records';
import {DID, FakeAccount, FakePds} from 'package-manager:testing/fake-pds';
import {Version} from 'package-manager:version';

let JSON_DID = 'did:plc:jsonjsonjsonjsonjsonjson';

function bytesOf(text: String) {
  let out = new FixedArray<u8>(text.length, 0 as u8);
  for (var i = 0; i < text.length; i += 1) {
    out[i] = text.getByteAt(i) as u8;
  }
  return out;
}

/** Publishes `version` of `account`, with these files and dependencies. */
function publish(account: FakeAccount, version: String, files: OrderedHashMap<String, FixedArray<u8>>,
    dependencies: FixedArray<Dependency>) {
  // The archive's manifest agrees with the release, as fetching checks.
  var listed = '';
  for (let dependency in dependencies) {
    let entry = `"${dependency.name}": {"did": "${dependency.did}", "version": "${dependency.version.toString()}"}`;
    listed = if (listed.length == 0) entry else `${listed}, ${entry}`;
  }
  files['zena-package.json'] = bytesOf(`{"name": "pkg", "version": "${version}", "dependencies": {${listed}}}`);
  let archive = packSource(files);
  let source = account.addBlob(archive);
  let artifact = Artifact.whole(SOURCE, new BlobRef(source, 'application/vnd.ipld.car', archive.length as i64));
  account.publish(new Release(Version.parse(version), '2026-10-22T00:00:00.000Z',
      new FixedArray<Artifact>(1, artifact), dependencies));
}

function routerFiles(version: String) {
  let files = new OrderedHashMap<String, FixedArray<u8>>();
  files['match.zena'] = bytesOf(
      `// router ${version}\nimport { parse } from 'json:parse';\nexport function route(): i32 { return parse() + 1; }\n`);
  return files;
}

function jsonFiles(version: String) {
  let files = new OrderedHashMap<String, FixedArray<u8>>();
  files['parse.zena'] = bytesOf(`// json ${version}\nexport function parse(): i32 { return 41; }\n`);
  return files;
}

export async function main(): Future<i32> {
  let pds = new FakePds();
  pds.start();
  let router = pds.account(DID, 'router.acme.pkg.zena-lang.dev');
  let json = pds.account(JSON_DID, 'json.acme.pkg.zena-lang.dev');
  router.setProfile(new Profile('router'));
  json.setProfile(new Profile('json'));

  let none = new FixedArray<Dependency>(0, new Dependency('', Version.parse('0.0.0'), ''));
  publish(json, '2.0.0', jsonFiles('2.0.0'), none);
  publish(json, '2.1.0', jsonFiles('2.1.0'), none);
  let needsJson = new FixedArray<Dependency>(1, new Dependency(JSON_DID, Version.parse('2.1.0'), 'json'));
  publish(router, '1.4.2', routerFiles('1.4.2'), needsJson);
  publish(router, '1.5.0', routerFiles('1.5.0'), needsJson);
  publish(router, '1.6.0', routerFiles('1.6.0'), needsJson);
  router.yank(new Yank(Version.parse('1.6.0'), 'broken'));

  writeFileSync('/out/plc.txt', pds.plcDirectory);
  await pds.done();
  return 0;
}
