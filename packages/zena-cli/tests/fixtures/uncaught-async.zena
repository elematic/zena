/**
 * An async `main` whose error escapes it, for checking what `zena run`
 * prints of an uncaught error: it should name the error's message, and
 * prints only "thrown Wasm exception" (#1074).
 */

import {Future} from 'zena:async';

async function fail(): Future<void> {
  throw new Error('the port is taken');
}

export async function main(): Future<void> {
  await fail();
}
