/**
 * Everything `zena pkg publish` talks to, for `tests/publish_test.zena`:
 *
 * - a fake PDS (`package-manager/testing/fake-pds`) as the PLC directory,
 *   and as the PDS of the maintainers
 *   `did:plc:alicealicealicealicealic`, whose app password is
 *   `app-password`, and `did:plc:bobbobbobbobbobbobbobbob`, whose app
 *   password is `bob-password`, and of `did:plc:mallorymallorymallorymal`,
 *   whose document claims the handle `acme.pkg.test` that the tests give
 *   the scope acme, and whose repository holds a members record, so she
 *   passes for that scope wherever a handle is shown unchecked;
 * - the PDS written in Zena with its App View, for the domain
 *   `pkg.test`, as `registry/service` serves it, sending the operations of the
 *   accounts it creates to that PLC directory;
 * - a DNS-over-HTTPS resolver that answers from the handle records the
 *   App View writes, so its handles resolve only by those, and from one
 *   record left over, `ghost.pkg.test`, naming a DID no directory has, as
 *   a deleted scope's record would be.
 *
 * With `STACK_WEB_DIR` naming a directory it can read, the App View serves
 * it as the web app's assets. `STACK_ADMINS` names the App View's admins,
 * separated by spaces, and `STACK_SCOPE_CREATORS=listed` lets only them and
 * the accounts they list create scopes. `STACK_MIN_CLIENT_VERSION` and
 * `STACK_CLIENT_NOTICE` are the oldest `zena` it takes and its message to
 * `zena`'s users. Run from the repository root with
 * `--dir <scratch>::/out`, it writes
 * `/out/stack.json` (`{"plc", "dns", "registry"}`), then `/out/plc.txt` (the PLC
 * directory's origin), and serves until it is killed.
 */

import {Future} from 'zena:async';
import {getEnv} from 'zena:cli';
import {writeFile} from 'zena:fs';
import {Server} from 'zena:http';
import {JsonObject, stringify} from 'zena:json';
import {Cid} from 'atproto/cid';
import {MemoryHandleRecords, dnsOverHttpsApp} from 'registry/handles';
import {MEMBERS_TYPE, MemberEntry, Members} from 'package-manager/records';
import {FakePds, KEY, didDocument} from 'package-manager/testing/fake-pds';
import {InMemory, PdsConfig} from 'pds/service';
import {ScopeCreation} from 'registry/app-view';
import {Version} from 'zena-lang:semver';
import {AppViewSettings, RecordsInMemory, ServiceConfig, serve} from 'registry/service';

export async function main(): Future<i32> {
  let world = new FakePds();
  world.start();
  let alice = world.account('did:plc:alicealicealicealicealic', null);
  alice.password = 'app-password';
  let bob = world.account('did:plc:bobbobbobbobbobbobbobbob', null);
  bob.password = 'bob-password';
  // Only her document claims the handle, so `world`'s resolver does not
  // answer for it.
  let mallory = world.account('did:plc:mallorymallorymallorymal', null);
  mallory.didDocument = didDocument(world.origin, KEY, mallory.did, 'acme.pkg.test');
  let entry = new MemberEntry(mallory.did, 'owner', new FixedArray<u8>(32, 0 as u8));
  mallory.put(MEMBERS_TYPE, 'self', new Members(new FixedArray<Cid>(1, entry.commitment())).toValue());

  // The server `main.zena` runs, configured as the environment would,
  // with its own origin as the registry's endpoint and a rotation key made
  // up at start.
  // Its DID is the did:web of its origin, which `zena` checks it against.
  let registry = new AppViewSettings('pkg.test', null, null, new GrowableArray<String>(), new RecordsInMemory());
  // The maintainers' PDS is on this machine.
  registry.privateReads = true;
  let admins = getEnv('STACK_ADMINS');
  if (admins != null) {
    registry.admins = admins.split(' ');
  }
  if (getEnv('STACK_SCOPE_CREATORS') == 'listed') {
    registry.scopeCreation = ScopeCreation.Listed;
  }
  let minimum = getEnv('STACK_MIN_CLIENT_VERSION');
  if (minimum != null) {
    registry.minimumClientVersion = Version.parse(minimum);
  }
  registry.clientNotice = getEnv('STACK_CLIENT_NOTICE');
  let pds = new PdsConfig(0 as u16, new InMemory(), 0);
  pds.plcDirectory = world.plcDirectory;
  let config = new ServiceConfig(pds, registry, world.plcDirectory, world.dnsOverHttps);
  config.webDir = getEnv('STACK_WEB_DIR');
  let running = await serve(config);
  let records = running.service.records as MemoryHandleRecords;
  await records.set('ghost.pkg.test', 'did:plc:ghostghostghostghostghost');
  let dns = new Server(dnsOverHttpsApp(records), 0 as u16);
  dns.start();

  let stack = new JsonObject();
  stack['plc'] = world.plcDirectory;
  stack['dns'] = `http://127.0.0.1:${dns.port as i32}/dns-query`;
  stack['registry'] = running.origin;
  await writeFile('/out/stack.json', stringify(stack));
  await writeFile('/out/plc.txt', world.plcDirectory);
  await world.done();
  return 0;
}
