/**
 * Everything `zena publish` talks to, for `tests/publish_test.zena`:
 *
 * - a fake PDS (`package-manager:testing/fake-pds`) as the PLC directory
 *   and DNS-over-HTTPS resolver, and as the PDS of the maintainer,
 *   `did:plc:alicealicealicealicealic`, whose app password is
 *   `app-password`;
 * - the PDS written in Zena with its package host (`pds:host`), for the
 *   domain `pkg.test`, sending the operations of the accounts it creates to
 *   that PLC directory.
 *
 * Run from the repository root with `--dir <scratch>::/out`, it writes
 * `/out/stack.json` (`{"plc", "dns", "host"}`), then `/out/plc.txt` (the PLC
 * directory's origin), and serves until it is killed.
 */

import {Future} from 'zena:async';
import {writeFileSync} from 'zena:fs';
import {App, Server} from 'zena:http';
import {JsonObject, stringify} from 'zena:json';
import {getRandomBytes} from 'wasi:random/random';
import {KeyType} from 'atproto:didkey';
import {PlcOperation, submitPlcOperation} from 'atproto:plc';
import {FakePds} from 'package-manager:testing/fake-pds';
import {HostConfig, MemoryHostStore, PackageHost} from 'pds:host';
import {Pds} from 'pds:pds';
import {createApp} from 'pds:server';
import {MemoryStorage, SigningKey} from 'pds:storage';

export async function main(): Future<i32> {
  let world = new FakePds();
  world.start();
  let alice = world.account('did:plc:alicealicealicealicealic', null);
  alice.password = 'app-password';

  // The host's endpoint is its own origin, known once it listens, so the
  // server forwards to an application made after.
  var inner: App | null = null;
  let outer = new App();
  outer.use(async (req, res, next): Future<void> => {
    await (inner as App).handleRequest(req, res);
  });
  let server = new Server(outer, 0 as u16);
  server.start();
  let origin = `http://127.0.0.1:${server.port as i32}`;

  let config = new HostConfig('did:web:pkg.test', 'pkg.test', origin,
      new SigningKey(KeyType.Secp256k1, getRandomBytes(32)));
  let plc = world.plcDirectory;
  let host = new PackageHost(new Pds(new MemoryStorage()), config, new MemoryHostStore(),
      world.resolver().signingKeys(),
      async (did: String, operation: PlcOperation): Future<void> => {
        await submitPlcOperation(plc, did, operation);
      },
      (count: i32) => getRandomBytes(count as u64));
  inner = createApp(host.pds, host);

  let stack = new JsonObject();
  stack['plc'] = plc;
  stack['dns'] = world.dnsOverHttps;
  stack['host'] = origin;
  writeFileSync('/out/stack.json', stringify(stack));
  writeFileSync('/out/plc.txt', plc);
  await world.done();
  return 0;
}
