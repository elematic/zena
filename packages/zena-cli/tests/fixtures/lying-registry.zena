/**
 * A server that says it is another registry, for
 * `tests/registry-did_test.zena`: its `dev.zena-lang.registry.describeRegistry`
 * answers with `did:web:pkg.zena-lang.dev`, which names another origin.
 * Run with `--dir <scratch>::/out`, it writes `/out/plc.txt`, its origin
 * followed by `/plc` as `fakePdsOrigin` reads it, and serves until it is
 * killed.
 */

import {Future} from 'zena:async';
import {writeFile} from 'zena:fs';
import {App, Router, Server} from 'zena:http';

export async function main(): Future<i32> {
  let router = new Router();
  router.get('/xrpc/dev.zena-lang.registry.describeRegistry', async (req, res, next, params) => {
    res.type = 'application/json';
    res.body = '{"did": "did:web:pkg.zena-lang.dev", "domain": "pkg.zena-lang.dev", "reservedScopes": [], "limits": {"releaseBytes": 1024, "packageBytes": 4096, "scopeBytes": 16384}, "scopeApproval": false, "methods": []}';
  });
  let app = new App();
  app.use(router.routes());
  let server = new Server(app, 0 as u16);
  server.start();
  await writeFile('/out/plc.txt', `http://127.0.0.1:${server.port as i32}/plc`);
  await server.done;
  return 0;
}
