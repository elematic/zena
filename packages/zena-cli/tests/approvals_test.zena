/**
 * Approvals, from end to end, against `tests/fixtures/publish-stack.zena`:
 * Alice and Bob own a package and its scope, raise their thresholds, and
 * then neither publishes nor changes who belongs without the other's
 * approval (`zena pkg owner settings`, `zena pkg scope settings`, `zena pkg approve`).
 */

import {suite, test} from 'zena:test';
import {isTrue} from 'zena:assert';
import {JsonObject, parseJson} from 'zena:json';
import {Scratch, ZenaCommand, described, fakePdsOrigin, read, startFakePds, stopFakePds, write} from './cli-support.zena';

let ALICE = 'did:plc:alicealicealicealicealic';
let BOB = 'did:plc:bobbobbobbobbobbobbobbob';

export let tests = suite('zena pkg approve', () => {
  test('holds releases and changes until a second owner approves them', async (ctx) => {
    let scratch = await Scratch.create('approvals');
    let stack = await startFakePds(scratch, 'publish-stack.zena');
    try {
      await fakePdsOrigin(scratch, stack);
      let addresses = parseJson(await read(scratch.at('pds/stack.json'))) as JsonObject;
      let personIn = (who: String, dir: String) =>
        new ZenaCommand(scratch.at(dir), scratch.host('cache'))
          .set('ZENA_PLC_DIRECTORY', addresses['plc'] as String)
          .set('ZENA_DNS_OVER_HTTPS', addresses['dns'] as String)
          .set('ZENA_REGISTRY', addresses['registry'] as String)
          .set('ZENA_CONFIG_DIR', scratch.host(`config-${who}`));
      let person = (who: String) => personIn(who, 'lib');
      await write(scratch.at('lib/zena-package.json'), '{"name": "greet", "description": "A package for tests", "license": "MIT", "scope": "acme", "version": "1.0.0"}\n');
      await write(scratch.at('lib/greet.zena'), 'export function answer(): i32 { return 42; }\n');
      let alice = person('alice');
      let bob = person('bob');
      isTrue((await alice.run(['pkg', 'login', ALICE, '--password-stdin'], 'app-password\n')).succeeded(), 'alice signs in');
      isTrue((await bob.run(['pkg', 'login', BOB, '--password-stdin'], 'bob-password\n')).succeeded(), 'bob signs in');
      isTrue((await alice.run(['pkg', 'scope', 'create', 'acme', '--yes'])).succeeded(), 'the scope');
      let published = await alice.run(['pkg', 'publish', '--yes']);
      isTrue(published.succeeded() && published.stdout.contains('Published greet 1.0.0'), described(published));
      let did = (parseJson(await read(scratch.at('lib/zena-package.json'))) as JsonObject)['did'] as String;
      let manifestAt = async (version: String) => await write(scratch.at('lib/zena-package.json'),
          `{"name": "greet", "description": "A package for tests", "license": "MIT", "did": "${did}", "scope": "acme", "version": "${version}"}\n`);

      // Alice alone decides, until Bob is an owner and the package needs both.
      let settings = await alice.run(['pkg', 'owner', 'settings']);
      isTrue(settings.succeeded() && settings.stdout.contains("Releases need 1 maintainer's attestation") &&
          settings.stdout.contains("1 owner's"), described(settings));
      let badCount = await alice.run(['pkg', 'owner', 'settings', '--threshold', '0']);
      isTrue(!badCount.succeeded() && badCount.stderr.contains('at least 1'), described(badCount));
      isTrue((await alice.run(['pkg', 'owner', 'add', BOB, '--role', 'owner'])).succeeded(), 'bob owns greet');
      let raised = await alice.run(['pkg', 'owner', 'settings', '--owner-threshold', '2']);
      isTrue(raised.succeeded() && raised.stdout.contains("2 owners'"), described(raised));

      // Now a change to the maintainers waits for Bob.
      let waits = await alice.run(['pkg', 'owner', 'settings', '--threshold', '2']);
      isTrue(waits.succeeded() && waits.stdout.contains('is waiting for approval: approved by 1 of the 2 owners') &&
          waits.stdout.contains('zena pkg approve acme:greet'), described(waits));
      let shown = await bob.run(['pkg', 'approve', 'acme:greet']);
      isTrue(shown.succeeded() && shown.stdout.contains('threshold: 1 → 2') &&
          shown.stdout.contains('Run again with --yes'), described(shown));
      let approved = await bob.run(['pkg', 'approve', 'acme:greet', '--yes']);
      isTrue(approved.succeeded() && approved.stdout.contains('Changed the maintainers of acme:greet'),
          described(approved));
      let now = await alice.run(['pkg', 'owner', 'settings']);
      isTrue(now.succeeded() && now.stdout.contains("Releases need 2 maintainers' attestations"), described(now));

      // And a release waits for Bob too.
      await manifestAt('1.1.0');
      let held = await alice.run(['pkg', 'publish']);
      isTrue(held.succeeded() && held.stdout.contains('greet 1.1.0 is waiting for approval') &&
          held.stdout.contains('approved by 1 of the 2 maintainers'), described(held));
      let release = await bob.run(['pkg', 'approve', 'acme:greet@1.1.0', '--yes']);
      isTrue(release.succeeded() && release.stdout.contains('Published acme:greet 1.1.0'), described(release));

      // The scope: Bob joins as an owner, the members then need both
      // owners, and adding Carol waits for Bob. Removing an owner would
      // leave too few to approve anything, which the registry refuses.
      isTrue((await alice.run(['pkg', 'scope', 'add', 'acme', BOB, '--role', 'owner'])).succeeded(), 'bob owns acme');
      let scope = await alice.run(['pkg', 'scope', 'settings', 'acme', '--owner-threshold', '2']);
      isTrue(scope.succeeded() && scope.stdout.contains("Changes to acme's members need 2 owners"), described(scope));
      let tooFew = await alice.run(['pkg', 'scope', 'remove', 'acme', BOB]);
      isTrue(!tooFew.succeeded() && tooFew.stderr.contains('cannot meet the thresholds'), described(tooFew));
      let carol = 'did:plc:carolcarolcarolcarolcaro';
      let adding = await alice.run(['pkg', 'scope', 'add', 'acme', carol]);
      isTrue(adding.succeeded() && adding.stdout.contains("The change to acme's members is waiting") &&
          !adding.stdout.contains('Added'), described(adding));
      let notYet = await bob.run(['pkg', 'scope', 'members', 'acme']);
      isTrue(notYet.succeeded() && !notYet.stdout.contains(carol), described(notYet));
      let change = await bob.run(['pkg', 'approve', 'acme']);
      isTrue(change.succeeded() && change.stdout.contains(`+ ${carol} member`), described(change));
      let joined = await bob.run(['pkg', 'approve', 'acme', '--yes']);
      isTrue(joined.succeeded() && joined.stdout.contains('Changed the members of acme'), described(joined));
      let members = await bob.run(['pkg', 'scope', 'members', 'acme']);
      isTrue(members.succeeded() && members.stdout.contains(`${carol}  member`), described(members));

      // The scope's policy, which waits for Bob too: every release in it
      // needs two approvals, and so a package one person would maintain
      // alone is refused.
      let policy = await alice.run(['pkg', 'scope', 'policy', 'acme', '--minimum-threshold', '2', '--default-threshold', '2']);
      isTrue(policy.succeeded() && policy.stdout.contains("The change to acme's policy is waiting"), described(policy));
      let shownPolicy = await bob.run(['pkg', 'approve', 'acme']);
      isTrue(shownPolicy.succeeded() && shownPolicy.stdout.contains('now: Every release in acme needs at least 2') &&
          shownPolicy.stdout.contains('was: Every release in acme needs at least 1'), described(shownPolicy));
      let applied = await bob.run(['pkg', 'approve', 'acme', '--yes']);
      isTrue(applied.succeeded() && applied.stdout.contains('Changed the policy of acme'), described(applied));
      let printed = await alice.run(['pkg', 'scope', 'policy', 'acme']);
      isTrue(printed.succeeded() && printed.stdout.contains("Every release in acme needs at least 2 maintainers'"),
          described(printed));
      await write(scratch.at('solo/zena-package.json'), '{"name": "solo", "description": "A package for tests", "license": "MIT", "scope": "acme", "version": "1.0.0"}\n');
      await write(scratch.at('solo/solo.zena'), 'export let one = 1;\n');
      let solo = await personIn('alice', 'solo').run(['pkg', 'create', '--yes']);
      isTrue(!solo.succeeded() && solo.stderr.contains('asks 2 maintainers'), described(solo));

      // A team's own threshold.
      isTrue((await alice.run(['pkg', 'team', 'create', 'acme/core'])).succeeded(), 'the team');
      let team = await alice.run(['pkg', 'team', 'settings', 'acme/core', '--threshold', '2']);
      isTrue(team.succeeded() && team.stdout.contains('Changes to the team acme/core need 2 of its maintainers'),
          described(team));
    } finally {
      await stopFakePds(stack);
      await scratch.remove();
    }
  });
});
