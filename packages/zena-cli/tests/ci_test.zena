/**
 * Publishing from CI, from end to end, against
 * `tests/fixtures/publish-stack.zena`: Alice creates an automation account
 * in her scope and adds it to a package, and CI publishes with the
 * account's token. The registry holds the account and writes its
 * attestation, so its release waits until Alice approves it.
 */

import {suite, test} from 'zena:test';
import {isTrue} from 'zena:assert';
import {runFuture} from 'zena:async';
import {fetch} from 'zena:fetch';
import {JsonArray, JsonObject, parseJson} from 'zena:json';
import {Scratch, ZenaCommand, described, fakePdsOrigin, read, startFakePds, stopFakePds, write} from './cli-support.zena';

let ALICE = 'did:plc:alicealicealicealicealic';

/** The text after `label` on its line of `text`. */
function after(text: String, label: String): String {
  for (let line in text.split('\n')) {
    if (line.startsWith(label)) {
      return line.sliceBytes(label.length, line.length).trim();
    }
  }
  return '';
}

export let tests = suite('zena pkg ci', () => {
  test('creates an automation account that CI publishes as with its token', (ctx) => {
    let scratch = Scratch.create('ci');
    let stack = startFakePds(scratch, 'publish-stack.zena');
    try {
      fakePdsOrigin(scratch, stack);
      let addresses = parseJson(read(scratch.at('pds/stack.json'))) as JsonObject;
      let person = (who: String) =>
        new ZenaCommand(scratch.host('lib'), scratch.at('lib'), scratch.host('cache'))
          .set('ZENA_PLC_DIRECTORY', addresses['plc'] as String)
          .set('ZENA_DNS_OVER_HTTPS', addresses['dns'] as String)
          .set('ZENA_REGISTRY', addresses['registry'] as String)
          .set('ZENA_CONFIG_DIR', scratch.host(`config-${who}`));
      write(scratch.at('lib/zena-package.json'), '{"name": "greet", "description": "A package for tests", "license": "MIT", "scope": "acme", "version": "1.0.0"}\n');
      write(scratch.at('lib/greet.zena'), 'export function answer(): i32 { return 42; }\n');
      let alice = person('alice');
      isTrue(alice.run(['pkg', 'login', ALICE, '--password-stdin'], 'app-password\n').succeeded(), 'alice signs in');
      isTrue(alice.run(['pkg', 'scope', 'create', 'acme', '--yes']).succeeded(), 'the scope');
      let published = alice.run(['pkg', 'publish', '--yes']);
      isTrue(published.succeeded(), described(published));

      let created = alice.run(['pkg', 'ci', 'create', 'acme/ci']);
      isTrue(created.succeeded() && created.stdout.contains('Created the automation account ci.acme.pkg.test'),
          described(created));
      let token = after(created.stdout, 'Its token, which is not shown again:');
      isTrue(token.startsWith('zena_ci_'), described(created));
      let again = alice.run(['pkg', 'ci', 'create', 'acme/ci']);
      isTrue(!again.succeeded() && again.stderr.contains('NameTaken'), described(again));

      // CI publishes with the token from its secrets, signed in to nothing,
      // and can publish nothing until an owner adds it, marked as
      // automation.
      let ci = (given: String) => person('bot').set('ZENA_REGISTRY_TOKEN', given);
      let bot = ci(token);
      let did = (parseJson(read(scratch.at('lib/zena-package.json'))) as JsonObject)['did'] as String;
      write(scratch.at('lib/zena-package.json'),
          `{"name": "greet", "description": "A package for tests", "license": "MIT", "did": "${did}", "scope": "acme", "version": "1.1.0"}\n`);
      let notYet = bot.run(['pkg', 'publish']);
      isTrue(!notYet.succeeded() && notYet.stderr.contains('Forbidden'), described(notYet));
      let unmarked = alice.run(['pkg', 'owner', 'add', 'ci.acme.pkg.test']);
      isTrue(!unmarked.succeeded() && unmarked.stderr.contains('automation account'), described(unmarked));
      let added = alice.run(['pkg', 'owner', 'add', 'ci.acme.pkg.test', '--automation']);
      isTrue(added.succeeded(), described(added));
      let byBot = bot.run(['pkg', 'publish']);
      isTrue(byBot.succeeded() && byBot.stdout.contains('greet 1.1.0 is waiting for approval') &&
          byBot.stdout.contains('zena pkg approve @acme/greet@1.1.0'), described(byBot));

      // Alice sees what she approves, and approves it.
      let none = alice.run(['pkg', 'approve', '@acme/greet@9.9.9']);
      isTrue(!none.succeeded() && none.stderr.contains('no release 9.9.9 of @acme/greet is waiting'), described(none));
      let shown = alice.run(['pkg', 'approve', '@acme/greet@1.1.0']);
      isTrue(shown.succeeded() && shown.stdout.contains('@acme/greet 1.1.0, published by ') &&
          shown.stdout.contains('Run again with --yes'), described(shown));
      let approved = alice.run(['pkg', 'approve', '1.1.0', '--yes']);
      isTrue(approved.succeeded() && approved.stdout.contains('Published ') &&
          approved.stdout.contains('/dev.zena-lang.package.release/1.1.0'), described(approved));
      let done = alice.run(['pkg', 'approve', '1.1.0']);
      isTrue(!done.succeeded() && done.stderr.contains('is waiting for approval'), described(done));

      // Its attestation of the release is in its own repository, on the
      // registry, which wrote it.
      let listed = runFuture(fetch(
          `${addresses['registry'] as String}/xrpc/com.atproto.repo.listRecords?repo=ci.acme.pkg.test&collection=dev.zena-lang.package.attestation`));
      let records = (parseJson(runFuture(listed.text())) as JsonObject)['records'] as JsonArray;
      isTrue(records.length == 1, `${records.length} attestations`);

      // Alice replaces a token that leaked: the old one stops working.
      let replaced = alice.run(['pkg', 'ci', 'token', 'acme/ci']);
      let next = after(replaced.stdout, 'Its new token, which is not shown again:');
      isTrue(replaced.succeeded() && next.startsWith('zena_ci_') && next != token, described(replaced));
      write(scratch.at('lib/zena-package.json'),
          `{"name": "greet", "description": "A package for tests", "license": "MIT", "did": "${did}", "scope": "acme", "version": "1.2.0"}\n`);
      let revoked = bot.run(['pkg', 'publish']);
      isTrue(!revoked.succeeded() && revoked.stderr.contains('InvalidToken'), described(revoked));
      let renewed = ci(next).run(['pkg', 'publish']);
      isTrue(renewed.succeeded() && renewed.stdout.contains('greet 1.2.0 is waiting for approval'), described(renewed));
    } finally {
      stopFakePds(stack);
      scratch.remove();
    }
  });
});
