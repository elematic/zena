/**
 * The package manager writes `zena-lock.json` and the compiler reads it,
 * each with its own reader, and neither package depends on the other.
 * `zena` links both, so they must read the same version of the format.
 */

import {suite, test} from 'zena:test';
import {equal} from 'zena:assert';
import {LOCKFILE_VERSION as MANAGER_VERSION} from 'package-manager/resolution';
import {LOCKFILE_VERSION as COMPILER_VERSION} from 'zena-compiler/package-manifest';

export let tests = suite('zena-lock.json versions', () => {
  test('the package manager and the compiler read the same lockfile version', (ctx) => {
    equal(COMPILER_VERSION, MANAGER_VERSION);
  });
});
