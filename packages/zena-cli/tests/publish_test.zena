/**
 * `zena pkg publish` from end to end, against `tests/fixtures/publish-stack.zena`:
 * a maintainer signs in, creates a scope, publishes a package to it, which
 * creates the package's account, publishes a second version, and
 * another workspace adds the package by its handle, fetches it and runs a
 * program that imports it.
 */

import {suite, test} from 'zena:test';
import {equal, isTrue} from 'zena:assert';
import {exists, listDir} from 'zena:fs';
import {fetch} from 'zena:fetch';
import {JsonArray, JsonObject, parseJson} from 'zena:json';
import {
  MAIN, Scratch, ZenaCommand, described, fakePdsOrigin, read, startFakePds, stopFakePds, write
} from './cli-support.zena';

let ALICE = 'did:plc:alicealicealicealicealic';

export let tests = suite('zena pkg publish', () => {
  test('publishes a package that another workspace adds and runs', async (ctx) => {
    let scratch = await Scratch.create('publish');
    let stack = await startFakePds(scratch, 'publish-stack.zena');
    try {
      await fakePdsOrigin(scratch, stack);
      let addresses = parseJson(await read(scratch.at('pds/stack.json'))) as JsonObject;
      let zenaIn = (dir: String) =>
        new ZenaCommand(scratch.host(dir), scratch.at(dir), scratch.host('cache'))
          .set('ZENA_PLC_DIRECTORY', addresses['plc'] as String)
          .set('ZENA_DNS_OVER_HTTPS', addresses['dns'] as String)
          .set('ZENA_REGISTRY', addresses['registry'] as String)
          .set('ZENA_CONFIG_DIR', scratch.host('config'));

      await write(scratch.at('lib/zena-package.json'), '{"name": "greet", "description": "A package for tests", "license": "MIT", "version": "1.0.0"}\n');
      await write(scratch.at('lib/greet.zena'), 'export function answer(): i32 { return 42; }\n');
      await write(scratch.at('lib/.notes'), 'hidden files stay out of the archive\n');
      // Tests stay out too, by default, and any other file goes in.
      await write(scratch.at('lib/greet_test.zena'), 'export let x = 1;\n');
      await write(scratch.at('lib/test/fixture.txt'), 'a fixture\n');
      await write(scratch.at('lib/docs/guide.md'), '# Greeting\n');
      let lib = zenaIn('lib');

      let notSignedIn = await lib.run(['pkg', 'publish']);
      isTrue(!notSignedIn.succeeded() && notSignedIn.stderr.contains('zena pkg login'), described(notSignedIn));
      let login = await lib.run(['pkg', 'login', ALICE, '--password-stdin'], 'app-password\n');
      isTrue(login.succeeded(), described(login));

      // A package without a license is refused before anything is made for it.
      await write(scratch.at('lib/zena-package.json'), '{"name": "greet", "description": "Greets", "version": "1.0.0"}\n');
      let unlicensed = await lib.run(['pkg', 'publish', '--scope', 'acme', '--yes']);
      isTrue(!unlicensed.succeeded() && unlicensed.stderr.contains('has no license') &&
          !unlicensed.stdout.contains('Created'), described(unlicensed));

      // A package that depends on a WIT is refused before anything is made
      // for it on the registry.
      await write(scratch.at('lib/zena-package.json'),
          '{"name": "greet", "description": "A package for tests", "license": "MIT", "version": "1.0.0", "dependencies": {"gfx": {"wit": "./wit"}}}\n');
      let wit = await lib.run(['pkg', 'publish', '--scope', 'acme', '--yes']);
      isTrue(!wit.succeeded() && wit.stderr.contains('the WIT in ./wit') && !wit.stdout.contains('Created'),
          described(wit));
      isTrue(!(await read(scratch.at('lib/zena-package.json'))).contains('"did"'), 'no DID was written');

      // So is a package with no version to publish: the release is checked
      // before the package is created.
      await write(scratch.at('lib/zena-package.json'), '{"name": "greet", "description": "A package for tests", "license": "MIT"}\n');
      let unversioned = await lib.run(['pkg', 'publish', '--scope', 'acme', '--yes']);
      isTrue(!unversioned.succeeded() && unversioned.stderr.contains('has no version to publish') &&
          !unversioned.stdout.contains('Created'), described(unversioned));
      isTrue(!(await read(scratch.at('lib/zena-package.json'))).contains('"did"'), 'no DID was written for it');
      await write(scratch.at('lib/zena-package.json'), '{"name": "greet", "description": "A package for tests", "license": "MIT", "version": "1.0.0"}\n');

      // A package with no DID needs a scope, which publishing never
      // creates, and a yes, to be created.
      let noScope = await lib.run(['pkg', 'publish']);
      isTrue(!noScope.succeeded() && noScope.stderr.contains('--scope'), described(noScope));
      let noSuchScope = await lib.run(['pkg', 'publish', '--scope', 'acme', '--yes']);
      isTrue(!noSuchScope.succeeded() && noSuchScope.stderr.contains('zena pkg scope create acme') &&
          !noSuchScope.stdout.contains('Created'), described(noSuchScope));

      // `zena pkg scope create` makes the scope, once told yes.
      let badName = await lib.run(['pkg', 'scope', 'create', 'Acme', '--yes']);
      isTrue(!badName.succeeded() && badName.stderr.contains('cannot be a scope'), described(badName));
      let scopeNoYes = await lib.run(['pkg', 'scope', 'create', 'acme']);
      isTrue(!scopeNoYes.succeeded() && scopeNoYes.stderr.contains('--yes') &&
          scopeNoYes.stderr.contains('acme.pkg.test'), described(scopeNoYes));
      let scope = await lib.run(['pkg', 'scope', 'create', 'acme', '--yes']);
      isTrue(scope.succeeded() && scope.stdout.contains('Created the scope acme.pkg.test'), described(scope));
      let scopeAgain = await lib.run(['pkg', 'scope', 'create', 'acme', '--yes']);
      isTrue(!scopeAgain.succeeded() && scopeAgain.stderr.contains('already has the scope acme'),
          described(scopeAgain));
      // A handle record left behind, naming a DID that does not claim the
      // handle, is no scope.
      let ghost = await lib.run(['pkg', 'scope', 'create', 'ghost', '--yes']);
      isTrue(ghost.succeeded() && ghost.stdout.contains('Created the scope ghost.pkg.test'), described(ghost));
      let info = await lib.run(['pkg', 'scope', 'info', 'acme']);
      isTrue(info.succeeded() && info.stdout.contains('acme.pkg.test') && info.stdout.contains('DID: did:plc:') &&
          info.stdout.contains('Members: 1'), described(info));

      let noYes = await lib.run(['pkg', 'publish', '--scope', 'acme']);
      isTrue(!noYes.succeeded() && noYes.stderr.contains('--yes') &&
          noYes.stderr.contains('greet.acme.pkg.test'), described(noYes));

      let first = await lib.run(['pkg', 'publish', '--scope', 'acme', '--yes']);
      isTrue(first.succeeded(), described(first));
      isTrue(!first.stdout.contains('Created the scope'), described(first));
      isTrue(first.stdout.contains('Created greet.acme.pkg.test'), described(first));
      isTrue(first.stdout.contains('Published greet 1.0.0'), described(first));
      // The manifest now names the package's DID and its scope.
      let manifest = parseJson(await read(scratch.at('lib/zena-package.json'))) as JsonObject;
      let did = manifest['did'] as String;
      isTrue(did.startsWith('did:plc:'), did);
      equal(manifest['scope'] as String, 'acme');
      // The registry holds the accounts it creates: no recovery key is made.
      isTrue(!(await exists(scratch.at('config/recovery-key'))), 'no recovery key was created');

      // A version is published once.
      let again = await lib.run(['pkg', 'publish']);
      isTrue(!again.succeeded() && again.stderr.contains('VersionExists'), described(again));
      // A manifest whose scope is not the package's is refused, and so is a
      // --scope that disagrees with the manifest.
      await write(scratch.at('lib/zena-package.json'),
          `{"name": "greet", "description": "A package for tests", "license": "MIT", "did": "${did}", "scope": "other", "version": "1.1.0"}\n`);
      let wrongScope = await lib.run(['pkg', 'publish']);
      isTrue(!wrongScope.succeeded() && wrongScope.stderr.contains('not greet.other.pkg.test') &&
          wrongScope.stderr.contains('greet.acme.pkg.test'), described(wrongScope));
      await write(scratch.at('lib/zena-package.json'),
          `{"name": "greet", "description": "A package for tests", "license": "MIT", "did": "${did}", "scope": "acme", "version": "1.1.0"}\n`);
      let disagrees = await lib.run(['pkg', 'publish', '--scope', 'beta']);
      isTrue(!disagrees.succeeded() && disagrees.stderr.contains('in the scope acme, not beta'), described(disagrees));
      let second = await lib.run(['pkg', 'publish']);
      isTrue(second.succeeded() && second.stdout.contains('Published greet 1.1.0'), described(second));
      isTrue(!second.stdout.contains('Created'), described(second));

      // A second package names its scope in its manifest, and `zena pkg
      // create` only creates it.
      await write(scratch.at('other/zena-package.json'), '{"name": "other", "description": "A package for tests", "license": "MIT", "scope": "acme", "version": "0.1.0"}\n');
      await write(scratch.at('other/other.zena'), 'export let x = 1;\n');
      let created = await zenaIn('other').run(['pkg', 'create', '--yes']);
      isTrue(created.succeeded() && created.stdout.contains('Created other.acme.pkg.test'), described(created));
      isTrue(!created.stdout.contains('Published'), described(created));

      // A workspace's root names the scope of its packages.
      await write(scratch.at('ws/zena-package.json'), '{"workspace": {"packages": ["pkgs/*"]}, "scope": "acme"}\n');
      await write(scratch.at('ws/pkgs/third/zena-package.json'), '{"name": "third", "description": "A package for tests", "license": "MIT", "version": "0.1.0"}\n');
      await write(scratch.at('ws/pkgs/third/third.zena'), 'export let y = 2;\n');
      let third = await new ZenaCommand(scratch.host('ws'), scratch.at('ws/pkgs/third'), scratch.host('cache'))
        .set('ZENA_PLC_DIRECTORY', addresses['plc'] as String)
        .set('ZENA_DNS_OVER_HTTPS', addresses['dns'] as String)
        .set('ZENA_REGISTRY', addresses['registry'] as String)
        .set('ZENA_CONFIG_DIR', scratch.host('config'))
        .run(['pkg', 'create', '--yes']);
      isTrue(third.succeeded() && third.stdout.contains('Created third.acme.pkg.test'), described(third));
      isTrue(!(await read(scratch.at('ws/pkgs/third/zena-package.json'))).contains('"scope"'),
          'a scope the root gives is not written into the package');
      let other = await zenaIn('other').run(['pkg', 'publish']);
      isTrue(other.succeeded() && other.stdout.contains('Published other 0.1.0'), described(other));

      // A release whose dependencies cannot be resolved is refused before
      // anything is made for it: greet has no 9.9.0, and other's manifest
      // names 0.2.0, which it has not published.
      await write(scratch.at('uses/zena-package.json'),
          `{"name": "uses", "description": "A package for tests", "license": "MIT", "version": "1.0.0", "dependencies": {"greet": {"did": "${did}", "version": "9.9.0"}}}\n`);
      let missing = await zenaIn('uses').run(['pkg', 'publish', '--scope', 'acme', '--yes']);
      isTrue(!missing.succeeded() && missing.stderr.contains('greet 9.9.0') &&
          missing.stderr.contains('is not published') && !missing.stdout.contains('Created'), described(missing));
      let otherManifest = await read(scratch.at('other/zena-package.json'));
      let otherDid = (parseJson(otherManifest) as JsonObject)['did'] as String;
      await write(scratch.at('other/zena-package.json'),
          `{"name": "other", "description": "A package for tests", "license": "MIT", "did": "${otherDid}", "version": "0.2.0"}\n`);
      await write(scratch.at('uses/zena-package.json'),
          '{"name": "uses", "description": "A package for tests", "license": "MIT", "version": "1.0.0", "dependencies": {"other": {"path": "../other"}}}\n');
      let unpublished = await zenaIn('uses').run(['pkg', 'publish', '--scope', 'acme', '--yes']);
      isTrue(!unpublished.succeeded() && unpublished.stderr.contains('other 0.2.0') &&
          !unpublished.stdout.contains('Created'), described(unpublished));
      isTrue(!(await read(scratch.at('uses/zena-package.json'))).contains('"did"'), 'no DID was written');
      await write(scratch.at('other/zena-package.json'), otherManifest);

      // Alice attested the members records of the two scopes she made, acme
      // and ghost, and the three releases, in her own repository.
      let listed = await fetch(
          `${(addresses['plc'] as String).sliceBytes(0, (addresses['plc'] as String).length - 4)}/xrpc/com.atproto.repo.listRecords?repo=${ALICE}&collection=dev.zena-lang.package.attestation`);
      equal(((parseJson(await listed.text()) as JsonObject)['records'] as JsonArray).length, 5,
          'attestations of two members records and three releases');

      // Another workspace adds the package by its handle and runs it.
      await write(scratch.at('app/prog.zena'), `import { answer } from 'greet:greet';\n${MAIN} {\n  return answer() - 42;\n}\n`);
      let app = zenaIn('app');
      let added = await app.run(['pkg', 'add', 'greet.acme.pkg.test']);
      isTrue(added.succeeded(), described(added));
      // Each archive it fetched holds the package's files, but not its tests
      // or hidden files.
      let sources = scratch.at('cache/packages/sources');
      var unpacked = 0;
      for (let entry in await listDir(sources)) {
        let dir = `${sources}/${entry.name}`;
        if (await exists(`${dir}/greet.zena`)) {
          unpacked += 1;
          isTrue(await exists(`${dir}/docs/guide.md`), `${dir} has docs/guide.md`);
          isTrue(!(await exists(`${dir}/greet_test.zena`)) && !(await exists(`${dir}/test`)) && !(await exists(`${dir}/.notes`)),
              `${dir} has no tests or hidden files`);
        }
      }
      isTrue(unpacked > 0, 'greet is in the cache');
      let appManifest = await read(scratch.at('app/zena-package.json'));
      isTrue(appManifest.contains('1.1.0'), appManifest);
      let ran = await app.run(['run', 'prog.zena']);
      isTrue(ran.succeeded(), described(ran));

      // Retracting 1.1.0 leaves app, which pins it, running, and a new
      // workspace that adds the package gets 1.0.0.
      let notVersion = await lib.run(['pkg', 'retract', 'latest']);
      isTrue(!notVersion.succeeded() && notVersion.stderr.contains('not a version'), described(notVersion));
      let noRelease = await lib.run(['pkg', 'retract', '9.9.9']);
      isTrue(!noRelease.succeeded() && noRelease.stderr.contains('ReleaseNotFound'), described(noRelease));
      let retracted = await lib.run(['pkg', 'retract', '1.1.0', '--reason', 'answers 43 on Tuesdays']);
      isTrue(retracted.succeeded() && retracted.stdout.contains('Retracted 1.1.0'), described(retracted));
      let stillRuns = await app.run(['run', 'prog.zena']);
      isTrue(stillRuns.succeeded(), described(stillRuns));
      await write(scratch.at('later/prog.zena'), `import { answer } from 'greet:greet';\n${MAIN} {\n  return answer() - 42;\n}\n`);
      let later = zenaIn('later');
      let addedLater = await later.run(['pkg', 'add', 'greet.acme.pkg.test']);
      isTrue(addedLater.succeeded(), described(addedLater));
      let laterManifest = await read(scratch.at('later/zena-package.json'));
      isTrue(laterManifest.contains('1.0.0'), laterManifest);
    } finally {
      await stopFakePds(stack);
      await scratch.remove();
    }
  });
});
