/**
 * `zena/versions.zena` holds the versions the packages' manifests give,
 * as `npm run versions` (dev/versions.zena) writes them.
 */

import {suite, test} from 'zena:test';
import {isTrue} from 'zena:assert';
import {readFile} from 'zena:fs';
import {VERSIONS_FILE, versionsSource} from '../dev/version-file.zena';

export let tests = suite('zena/versions.zena', () => {
  test('holds the versions the manifests give', async (ctx) => {
    let kept = await readFile(VERSIONS_FILE);
    isTrue(kept == await versionsSource(), `${VERSIONS_FILE} is out of date: run npm run versions`);
  });
});
