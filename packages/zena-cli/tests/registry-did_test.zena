/**
 * `zena` sends a registry tokens addressed to the DID the registry says it
 * has, so it first checks that the DID is the registry's own: a server at one
 * origin that answers with another registry's DID is refused before any token
 * is made (#688).
 */

import {suite, test} from 'zena:test';
import {isTrue} from 'zena:assert';
import {Scratch, described, ensureDir, fakePdsOrigin, startFakePds, stopFakePds, zenaIn} from './cli-support.zena';

export let tests = suite("zena: the registry's DID", () => {
  test("refuses a registry that answers with another registry's DID", async (ctx) => {
    let scratch = await Scratch.create('registry-did');
    let stack = await startFakePds(scratch, 'lying-registry.zena');
    try {
      let plc = await fakePdsOrigin(scratch, stack);
      let origin = plc.sliceBytes(0, plc.length - '/plc'.length);
      await ensureDir(scratch.at('project'));
      let refused = await zenaIn(scratch, 'project').run(['pkg', 'scope', 'info', 'acme', '--registry', origin]);
      isTrue(!refused.succeeded() && refused.stderr.contains('says it is did:web:pkg.zena-lang.dev') &&
          refused.stderr.contains('the registry at pkg.zena-lang.dev'), described(refused));
    } finally {
      await stopFakePds(stack);
      await scratch.remove();
    }
  });
});
