/**
 * `zena pkg add` and `zena pkg update` against `tests/fixtures/add-pds.zena`, which
 * serves `acme:router` (1.4.2 and 1.5.0, which need json 2.1.0, and a
 * retracted 1.6.0), `acme:json` (2.0.0 and 2.1.0) and `acme:log` (1.0.0).
 */

import {suite, test} from 'zena:test';
import {equal, isTrue} from 'zena:assert';
import {ProcessResult} from 'zena:process';
import {
  MAIN, Scratch, ZenaCommand, described, dnsBeside, fakePdsOrigin, read, startFakePds, stopFakePds, write
} from './cli-support.zena';

let JSON_KEY = 'did:plc:jsonjsonjsonjsonjsonjson@2.1.0';
let LOG_KEY = 'did:plc:loglogloglogloglogloglog@1.0.0';

export let tests = suite('zena pkg add and zena pkg update', () => {
  test('select versions for the whole workspace, pin them, and fetch them', async (ctx) => {
    let scratch = await Scratch.create('add');
    let pds = await startFakePds(scratch, 'add-pds.zena');
    try {
      let plc = await fakePdsOrigin(scratch, pds);
      let zenaFrom = (dir: String) =>
        new ZenaCommand(scratch.at(dir), scratch.host('cache'))
          .set('ZENA_PLC_DIRECTORY', plc)
          .set('ZENA_DNS_OVER_HTTPS', dnsBeside(plc));
      let zena = zenaFrom('workspace');
      let manifest = scratch.at('workspace/zena-package.json');
      let lockfile = scratch.at('workspace/zena-lock.json');
      let succeeds = (what: String, result: ProcessResult) => {
        isTrue(result.succeeded(), `${what}: ${described(result)}`);
      };
      await write(scratch.at('workspace/prog.zena'),
          `import { route } from 'acme:router/match';\n${MAIN} {\n  return route() - 42;\n}\n`);
      // A workspace has a manifest: without one, the command would walk up
      // to this repository's.
      await write(manifest, '{"name": "app"}\n');

      // Add router at a version, by its scoped name, to a workspace with no
      // dependencies yet, under that name. Its dependency, json, is selected
      // and fetched with it.
      let add = await zena.run(['pkg', 'add', 'acme:router@1.4.2']);
      succeeds('zena pkg add', add);
      isTrue(add.stdout.contains('2 fetched'), described(add));
      let text = await read(manifest);
      isTrue(text.contains('"acme:router"') && text.contains('1.4.2'), text);
      let pins = await read(lockfile);
      isTrue(pins.contains('"did:plc:routerrouterrouterrouter@1.4.2"') &&
          pins.contains('"did:plc:jsonjsonjsonjsonjsonjson@2.1.0"') && pins.contains('"workspace"'), pins);
      succeeds('zena run', await zena.run(['run', 'prog.zena']));

      // Update to the latest version that is not retracted: 1.5.0, not 1.6.0.
      let update = await zena.run(['pkg', 'update']);
      succeeds('zena pkg update', update);
      isTrue(update.stdout.contains('1.4.2 -> 1.5.0'), described(update));
      let updated = await read(manifest);
      isTrue(updated.contains('1.5.0') && !updated.contains('1.6.0'), updated);
      succeeds('zena run', await zena.run(['run', 'prog.zena']));

      // Give the workspace a package, lib, and add json 2.0.0 to it from its
      // directory. Only lib's manifest changes, and the lockfile still pins
      // json 2.1.0, which router needs: one version for the whole workspace.
      await write(manifest, `{"workspace": {"packages": ["packages/*"]},${updated.sliceBytes(1, updated.length)}`);
      await write(scratch.at('workspace/packages/lib/zena-package.json'), '{"name": "lib"}');
      let before = await read(manifest);
      succeeds('zena pkg add in a workspace package',
          await zenaFrom('workspace/packages/lib').run(['pkg', 'add', 'acme:json@2.0.0']));
      let lib = await read(scratch.at('workspace/packages/lib/zena-package.json'));
      isTrue(lib.contains('"acme:json"') && lib.contains('2.0.0'), lib);
      equal(await read(manifest), before);
      let shared = await read(lockfile);
      isTrue(shared.contains('2.1.0') && !shared.contains('2.0.0'), shared);

      // Add json to the root without a version: its latest. By DID, it gets
      // its scoped name too, from the handle its DID document gives and
      // which resolves back to it.
      succeeds('zena pkg add without a version',
          await zena.run(['pkg', 'add', 'did:plc:jsonjsonjsonjsonjsonjson']));
      let root = await read(manifest);
      isTrue(root.contains('"acme:json"') && root.contains('2.1.0'), root);

      // A name that does not resolve is an error, and changes nothing.
      isTrue(!(await zena.run(['pkg', 'add', 'acme:nothing'])).succeeded(),
          'zena pkg add accepted a package that does not exist');
      equal(await read(manifest), root);
    } finally {
      await stopFakePds(pds);
      await scratch.remove();
    }
  });

  test('keep a WIT dependency, and its name', async (ctx) => {
    let scratch = await Scratch.create('add-wit');
    let pds = await startFakePds(scratch, 'add-pds.zena');
    try {
      let plc = await fakePdsOrigin(scratch, pds);
      let zena = new ZenaCommand(scratch.at('workspace'), scratch.host('cache'))
        .set('ZENA_PLC_DIRECTORY', plc)
        .set('ZENA_DNS_OVER_HTTPS', dnsBeside(plc));
      let manifest = scratch.at('workspace/zena-package.json');
      await write(manifest, '{"dependencies": {"gfx": {"wit": "./wit"}}}\n');

      let add = await zena.run(['pkg', 'add', 'acme:router@1.4.2']);
      isTrue(add.succeeded(), described(add));
      let text = await read(manifest);
      isTrue(text.contains('"gfx"') && text.contains('"wit": "./wit"') && text.contains('"acme:router"'), text);

      let taken = await zena.run(['pkg', 'add', 'acme:json', '--name', 'gfx']);
      isTrue(!taken.succeeded() && taken.stderr.contains('the WIT in ./wit'), described(taken));
      equal(await read(manifest), text);

      // --name gives any local name, plain or in a scope.
      let named = await zena.run(['pkg', 'add', 'acme:json', '--name', 'json']);
      isTrue(named.succeeded() && (await read(manifest)).contains('"json"'), described(named));
      let bad = await zena.run(['pkg', 'add', 'acme:log', '--name', '@acme']);
      isTrue(!bad.succeeded() && bad.stderr.contains('not a valid local name'), described(bad));

      // A package in a scope names itself by its plain name as well.
      await write(manifest, '{"name": "app", "scope": "acme"}\n');
      let self = await zena.run(['pkg', 'add', 'acme:log', '--name', 'app']);
      isTrue(!self.succeeded() && self.stderr.contains('this package'), described(self));

      // With scopedNames false, a package in a scope gets the name its
      // profile suggests.
      await write(manifest, '{"scopedNames": false}\n');
      let plain = await zena.run(['pkg', 'add', 'acme:log']);
      let plainText = await read(manifest);
      isTrue(plain.succeeded() && plainText.contains('"log"') && !plainText.contains('acme:log'),
          `${described(plain)}\n${plainText}`);
    } finally {
      await stopFakePds(pds);
      await scratch.remove();
    }
  });

  test('refuse a pinned release that changed in place', async (ctx) => {
    let scratch = await Scratch.create('add-changed');
    try {
      let zenaWith = (plc: String) =>
        new ZenaCommand(scratch.at('workspace'), scratch.host('cache'))
          .set('ZENA_PLC_DIRECTORY', plc)
          .set('ZENA_DNS_OVER_HTTPS', dnsBeside(plc));
      let manifest = scratch.at('workspace/zena-package.json');
      let lockfile = scratch.at('workspace/zena-lock.json');
      await write(manifest, '{"name": "app"}\n');
      let first = await startFakePds(scratch, 'add-pds.zena');
      try {
        let add = await zenaWith(await fakePdsOrigin(scratch, first)).run(['pkg', 'add', 'acme:router@1.5.0']);
        isTrue(add.succeeded() && add.stdout.contains(`Added ${JSON_KEY}`), described(add));
      } finally {
        await stopFakePds(first);
      }

      // The PDS serves json 2.1.0 again, with other bytes.
      await write(scratch.at('pds/plc.txt'), '');
      await write(scratch.at('pds/republish'), '');
      let second = await startFakePds(scratch, 'add-pds.zena');
      try {
        let zena = zenaWith(await fakePdsOrigin(scratch, second));
        let text = await read(manifest);
        let pins = await read(lockfile);

        // Adding a package that does not need json selects json again, and
        // is refused, with nothing written; so is updating.
        let refused = await zena.run(['pkg', 'add', 'acme:log']);
        isTrue(!refused.succeeded() && refused.stderr.contains(`${JSON_KEY}:`) &&
            refused.stderr.contains('--allow-changed'), described(refused));
        equal(await read(manifest), text);
        equal(await read(lockfile), pins);
        let update = await zena.run(['pkg', 'update']);
        isTrue(!update.succeeded() && update.stderr.contains(`${JSON_KEY}:`), described(update));
        equal(await read(lockfile), pins);

        // Allowed, the new pins replace the old.
        let allowed = await zena.run(['pkg', 'add', 'acme:log', '--allow-changed']);
        isTrue(allowed.succeeded() && allowed.stdout.contains(`Changed ${JSON_KEY} in place`) &&
            allowed.stdout.contains(`Added ${LOG_KEY}`), described(allowed));
        isTrue((await read(lockfile)) != pins && (await read(manifest)).contains('"acme:log"'), await read(lockfile));
        let again = await zena.run(['pkg', 'update']);
        isTrue(again.succeeded() && again.stdout.contains('zena-lock.json is unchanged'), described(again));
      } finally {
        await stopFakePds(second);
      }
    } finally {
      await scratch.remove();
    }
  });
});
