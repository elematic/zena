/**
 * The workspace `zena` works in, which it finds by walking up from where it
 * runs, as npm and Cargo do: the nearest `zena-package.json` is the
 * package, and the nearest manifest above it whose `workspace.packages`
 * lists it is the workspace's root, else the package is its own. A `zena`
 * built in this checkout takes the checkout's standard library and CLI
 * module wherever it runs. These tests leave unset the variables that
 * place the standard library and the module, and set `ZENA_REPO_ROOT`,
 * which once chose the workspace, to show that a shell's value no longer
 * does.
 */

import {suite, test} from 'zena:test';
import {isTrue} from 'zena:assert';
import {run} from 'zena:process';
import {MAIN, Scratch, described, repoRoot, write, zenaBinary, zenaIn} from './cli-support.zena';

/** Everything that would choose for the command. */
let CHOOSERS = [
  'ZENA_CLI_MODULE', 'ZENA_STDLIB_DIR', 'ZENA_PROJECT_CACHE', 'ZENA_LOCAL_CACHE', 'ZENA_COMPILER_WASM',
];

export let tests = suite('the workspace zena works in', () => {
  test('is found by walking up from where it runs, and no shell variable moves it', async (ctx) => {
    // A directory outside the checkout, as the host names it. The test
    // module reaches only the repository and its own /tmp, so the shell
    // writes the project.
    let outside = (await run(['mktemp', '-d'])).stdout.trim();
    isTrue(!outside.startsWith(repoRoot()), outside);
    try {
      let setUp = await run(['/bin/sh', '-c', `mkdir -p "$1/lib/src" "$1/src" &&
printf '%s\\n' '{"name": "app", "dependencies": {"lib": {"path": "./lib"}}}' > "$1/zena-package.json" &&
printf '%s\\n' '{"name": "lib"}' > "$1/lib/zena-package.json" &&
printf '%s\\n' 'export function answer(): i32 { return 42; }' > "$1/lib/src/answer.zena" &&
printf '%s\\n' "import { answer } from 'lib/answer';" '${MAIN} { return answer() - 42; }' > "$1/prog.zena"`,
          'sh', outside]);
      isTrue(setUp.succeeded(), described(setUp));
      // The program imports lib by the path in the project's own
      // manifest, so it compiles only when the project is the workspace:
      // run in it, and in src/, below it. ZENA_REPO_ROOT, which once chose
      // the workspace, names no directory and changes nothing. The shell
      // goes into the directory, since a working directory the test names
      // would be read in its own namespace, where /tmp can be another
      // directory (ZENA_PROJECT_CACHE).
      var unset = '';
      for (let name in CHOOSERS) {
        unset = `${unset} -u ${name}`;
      }
      let runsIn = async (dir: String, file: String) => {
        let ran = await run(['/bin/sh', '-c',
            `cd "$1${dir}" && exec env${unset} ZENA_REPO_ROOT=/no/such/dir ZENA_CACHE_DIR="$1/.cache" "$2" run ${file}`,
            'sh', outside, zenaBinary()]);
        isTrue(ran.succeeded(), `in ${outside}${dir}: ${described(ran)}`);
      };
      await runsIn('', 'prog.zena');
      await runsIn('/src', '../prog.zena');
    } finally {
      await run(['rm', '-rf', outside]);
    }
  });

  test("is a package's own, inside the checkout, when the checkout's workspace does not list it", async (ctx) => {
    // As a test package someone makes in their clone of this repository:
    // its path dependency resolves only when it is the workspace.
    let scratch = await Scratch.create('workspace-nested');
    try {
      await write(scratch.at('package-1/zena-package.json'),
          '{"name": "package-1", "dependencies": {"lib": {"path": "./lib"}}}\n');
      await write(scratch.at('package-1/lib/zena-package.json'), '{"name": "lib"}\n');
      await write(scratch.at('package-1/lib/src/answer.zena'), 'export function answer(): i32 { return 42; }\n');
      await write(scratch.at('package-1/prog.zena'),
          `import { answer } from 'lib/answer';\n${MAIN} { return answer() - 42; }\n`);
      let ran = await zenaIn(scratch, 'package-1').run(['run', 'prog.zena']);
      isTrue(ran.succeeded(), described(ran));
    } finally {
      await scratch.remove();
    }
  });

  test('zena build supports --force and --no-cache on target scripts', async (ctx) => {
    let outside = (await run(['mktemp', '-d'])).stdout.trim();
    try {
      let setUp = await run(['/bin/sh', '-c',
          `printf '%s\\n' '{"workspaces":[],"scripts":{"build":"wireit"},"wireit":{"build":{"command":"echo ok > out.txt","files":[],"output":["out.txt"]}}}' > "$1/package.json"`,
          'sh', outside]);
      isTrue(setUp.succeeded(), described(setUp));
      var unset = '';
      for (let name in CHOOSERS) {
        unset = `${unset} -u ${name}`;
      }
      let first = await run(['/bin/sh', '-c', `cd "$1" && exec env${unset} ZENA_CACHE_DIR="$1/.cache" "$2" build`,
          'sh', outside, zenaBinary()]);
      isTrue(first.succeeded(), described(first));
      isTrue(first.stdout.contains(':build: ran'), first.stdout);

      let warm = await run(['/bin/sh', '-c', `cd "$1" && exec env${unset} ZENA_CACHE_DIR="$1/.cache" "$2" build`,
          'sh', outside, zenaBinary()]);
      isTrue(warm.succeeded(), described(warm));
      isTrue(warm.stdout.contains('1 fresh'), warm.stdout);

      let warmVerbose = await run(['/bin/sh', '-c', `cd "$1" && exec env${unset} ZENA_CACHE_DIR="$1/.cache" "$2" build -v`,
          'sh', outside, zenaBinary()]);
      isTrue(warmVerbose.succeeded(), described(warmVerbose));
      isTrue(warmVerbose.stdout.contains(':build: fresh'), warmVerbose.stdout);

      let forced = await run(['/bin/sh', '-c', `cd "$1" && exec env${unset} ZENA_CACHE_DIR="$1/.cache" "$2" build --force`,
          'sh', outside, zenaBinary()]);
      isTrue(forced.succeeded(), described(forced));
      isTrue(forced.stdout.contains(':build: ran'), forced.stdout);

      let dropOut = await run(['rm', '-f', `${outside}/out.txt`]);
      isTrue(dropOut.succeeded(), described(dropOut));
      let noCache = await run(['/bin/sh', '-c', `cd "$1" && exec env${unset} ZENA_CACHE_DIR="$1/.cache" "$2" build --no-cache`,
          'sh', outside, zenaBinary()]);
      isTrue(noCache.succeeded(), described(noCache));
      isTrue(noCache.stdout.contains(':build: ran'), noCache.stdout);
    } finally {
      await run(['rm', '-rf', outside]);
    }
  });

  test('zena build runs zena-package.json and standalone zebra.json workspaces and migrates wireit configs', async (ctx) => {
    let outside = (await run(['mktemp', '-d'])).stdout.trim();
    try {
      // 1. Zena workspace using `scripts` + synthesized `source` fileset in `zena-package.json`.
      let setUp = await run(['/bin/sh', '-c', `mkdir -p "$1/packages/lib/src" "$1/packages/app/src" &&
printf '%s\\n' '{"workspace":{"packages":["packages/*"]}}' > "$1/zena-package.json" &&
printf '%s\\n' '{"name":"lib","scripts":{"gen":{"command":"printf hello > out.txt","files":[],"output":["out.txt"]}}}' > "$1/packages/lib/zena-package.json" &&
printf '%s\\n' 'export let x = 1;' > "$1/packages/lib/src/x.zena" &&
printf '%s\\n' '{"name":"app","dependencies":{"lib":{"path":"../lib"}},"scripts":{"build":{"command":"cat ../lib/out.txt src/main.zena > app.txt","output":["app.txt"],"dependencies":["source","../lib:gen"]}}}' > "$1/packages/app/zena-package.json" &&
printf '%s\\n' 'export let y = 2;' > "$1/packages/app/src/main.zena"`,
          'sh', outside]);
      isTrue(setUp.succeeded(), described(setUp));
      var unset = '';
      for (let name in CHOOSERS) {
        unset = `${unset} -u ${name}`;
      }
      // `zena build` with no args runs `build` in the current package (even if a `./build` file exists).
      let touchBuildFile = await run(['/bin/sh', '-c', `printf 'unrelated\n' > "$1/packages/app/build"`, 'sh', outside]);
      isTrue(touchBuildFile.succeeded(), described(touchBuildFile));
      let first = await run(['/bin/sh', '-c',
          `cd "$1/packages/app" && exec env${unset} ZENA_CACHE_DIR="$1/.cache" "$2" build`,
          'sh', outside, zenaBinary()]);
      isTrue(first.succeeded(), described(first));
      isTrue(first.stdout.contains('packages/lib:gen: ran'), first.stdout);
      isTrue(first.stdout.contains('packages/app:build: ran'), first.stdout);

      // `zena build ./packages/app` from workspace root defaults to `:build` and stays fresh.
      let warmFromRoot = await run(['/bin/sh', '-c',
          `cd "$1" && exec env${unset} ZENA_CACHE_DIR="$1/.cache" "$2" build ./packages/app`,
          'sh', outside, zenaBinary()]);
      isTrue(warmFromRoot.succeeded(), described(warmFromRoot));
      isTrue(warmFromRoot.stdout.contains('2 fresh'), warmFromRoot.stdout);

      // 2. Standalone `zebra.json` workspace (no zena-package.json or package.json).
      let setUpZebra = await run(['/bin/sh', '-c', `mkdir -p "$1/standalone/pkg" &&
printf '%s\\n' '{"workspace":{"packages":["pkg"]}}' > "$1/standalone/zebra.json" &&
printf '%s\\n' '{"scripts":{"build":{"command":"printf ok > built.txt","files":[],"output":["built.txt"]}}}' > "$1/standalone/pkg/zebra.json"`,
          'sh', outside]);
      isTrue(setUpZebra.succeeded(), described(setUpZebra));
      let standaloneBuild = await run(['/bin/sh', '-c',
          `cd "$1/standalone/pkg" && exec env${unset} ZENA_CACHE_DIR="$1/.cache" "$2" build`,
          'sh', outside, zenaBinary()]);
      isTrue(standaloneBuild.succeeded(), described(standaloneBuild));
      isTrue(standaloneBuild.stdout.contains('pkg:build: ran'), standaloneBuild.stdout);

      // 3. `zena build --migrate` writes `zebra.json` when no `zena-package.json` exists,
      // and merges `scripts` into `zena-package.json` when one exists.
      let setUpWireit = await run(['/bin/sh', '-c', `mkdir -p "$1/wireit-pkg" "$1/zena-wireit-pkg" &&
printf '%s\\n' '{"scripts":{"test":"wireit"},"wireit":{"test":{"command":"echo ok","files":[],"output":[]}}}' > "$1/wireit-pkg/package.json" &&
printf '%s\\n' '{"name":"zpkg"}' > "$1/zena-wireit-pkg/zena-package.json" &&
printf '%s\\n' '{"scripts":{"build":"wireit"},"wireit":{"build":{"command":"echo built > out.txt","files":[],"output":["out.txt"]}}}' > "$1/zena-wireit-pkg/package.json"`,
          'sh', outside]);
      isTrue(setUpWireit.succeeded(), described(setUpWireit));
      let migratedZebra = await run(['/bin/sh', '-c',
          `cd "$1/wireit-pkg" && exec env${unset} NO_COLOR=1 ZENA_CACHE_DIR="$1/.cache" "$2" build --migrate`,
          'sh', outside, zenaBinary()]);
      isTrue(migratedZebra.succeeded(), described(migratedZebra));
      isTrue(migratedZebra.stdout.contains('zebra.json: wrote'), migratedZebra.stdout);
      let verifyZebra = await run(['test', '-f', `${outside}/wireit-pkg/zebra.json`]);
      isTrue(verifyZebra.succeeded(), 'zebra.json exists after --migrate');

      let migratedZena = await run(['/bin/sh', '-c',
          `cd "$1/zena-wireit-pkg" && exec env${unset} NO_COLOR=1 ZENA_CACHE_DIR="$1/.cache" "$2" build --migrate`,
          'sh', outside, zenaBinary()]);
      isTrue(migratedZena.succeeded(), described(migratedZena));
      isTrue(migratedZena.stdout.contains('zena-package.json: wrote'), migratedZena.stdout);
    } finally {
      await run(['rm', '-rf', outside]);
    }
  });

  test('zena build forwards extra arguments after -- to the entry target without caching it', async (ctx) => {
    let outside = (await run(['mktemp', '-d'])).stdout.trim();
    try {
      let setUp = await run(['/bin/sh', '-c', `mkdir -p "$1/packages/lib" "$1/packages/app" &&
printf '%s\\n' '{"workspace":{"packages":["packages/*"]}}' > "$1/zebra.json" &&
printf '%s\\n' '{"scripts":{"build":{"command":"printf ok > out.txt","files":[],"output":["out.txt"]}}}' > "$1/packages/lib/zebra.json" &&
printf '%s\\n' 'printf "%s|%s|%s\\n" "$#" "$1" "$2" > ran.txt' > "$1/packages/app/check.sh" &&
printf '%s\\n' '{"scripts":{"build":{"command":"sh check.sh","files":["check.sh"],"output":[],"dependencies":["../lib:build"]},"test":{"command":"sh check.sh","files":["check.sh"],"output":[],"dependencies":["../lib:build"]}}}' > "$1/packages/app/zebra.json"`,
          'sh', outside]);
      isTrue(setUp.succeeded(), described(setUp));
      var unset = '';
      for (let name in CHOOSERS) {
        unset = `${unset} -u ${name}`;
      }

      // 1. `zena build <target> -- ...` forwards args only to `<target>`.
      let filtered = await run(['/bin/sh', '-c',
          `cd "$1" && exec env${unset} NO_COLOR=1 ZENA_CACHE_DIR="$1/.cache" "$2" build ./packages/app:test -- --filter "two words"`,
          'sh', outside, zenaBinary()]);
      isTrue(filtered.succeeded(), described(filtered));
      let args1 = (await run(['cat', `${outside}/packages/app/ran.txt`])).stdout;
      isTrue(args1 == '2|--filter|two words\n', args1);

      // 2. Subsequent plain `zena build ./packages/app:test` keeps `lib:build` fresh while running `app:test` unfiltered.
      let plainRun = await run(['/bin/sh', '-c',
          `cd "$1" && exec env${unset} NO_COLOR=1 ZENA_CACHE_DIR="$1/.cache" "$2" build ./packages/app:test`,
          'sh', outside, zenaBinary()]);
      isTrue(plainRun.succeeded(), described(plainRun));
      isTrue(plainRun.stdout.contains('packages/app:test: ran'), plainRun.stdout);
      isTrue(plainRun.stdout.contains('1 fresh'), plainRun.stdout);
      let args2 = (await run(['cat', `${outside}/packages/app/ran.txt`])).stdout;
      isTrue(args2 == '0||\n', args2);

      // 3. `zena build -- ...` with no explicit target forwards args to default `build` in cwd.
      let defaultTargetArgs = await run(['/bin/sh', '-c',
          `cd "$1/packages/app" && exec env${unset} NO_COLOR=1 ZENA_CACHE_DIR="$1/.cache" "$2" build -- --fast`,
          'sh', outside, zenaBinary()]);
      isTrue(defaultTargetArgs.succeeded(), described(defaultTargetArgs));
      let args3 = (await run(['cat', `${outside}/packages/app/ran.txt`])).stdout;
      isTrue(args3 == '1|--fast|\n', args3);
    } finally {
      await run(['rm', '-rf', outside]);
    }
  });
});
