/**
 * `zena pkg fetch` against `tests/fixtures/fetch-pds.zena`, which serves one
 * published package and writes a workspace root depending on it and the
 * lockfile pinning it.
 */

import {suite, test} from 'zena:test';
import {isTrue} from 'zena:assert';
import {exists, listDir} from 'zena:fs';
import {MAIN, Scratch, described, fakePdsOrigin, read, startFakePds, stopFakePds, write, zenaIn} from './cli-support.zena';

export let tests = suite('zena pkg fetch', () => {
  test('downloads the pinned packages, which the compiler then reads', async (ctx) => {
    let scratch = await Scratch.create('fetch');
    let pds = await startFakePds(scratch, 'fetch-pds.zena');
    try {
      let plc = await fakePdsOrigin(scratch, pds);
      for (let file in ['zena-package.json', 'zena-lock.json']) {
        await write(scratch.at(`workspace/${file}`), await read(scratch.at(`pds/${file}`)));
      }
      await write(scratch.at('workspace/prog.zena'),
          `import { route } from 'router:match';\n${MAIN} {\n  return route() - 42;\n}\n`);
      let zena = zenaIn(scratch, 'workspace').set('ZENA_PLC_DIRECTORY', plc);

      let first = await zena.run(['pkg', 'fetch']);
      isTrue(first.succeeded() && first.stdout.contains('1 fetched'), described(first));
      let second = await zena.run(['pkg', 'fetch']);
      isTrue(second.succeeded() && second.stdout.contains('1 already in the cache'), described(second));
      let ran = await zena.run(['run', 'prog.zena']);
      isTrue(ran.succeeded(), described(ran));
    } finally {
      await stopFakePds(pds);
      await scratch.remove();
    }
  });

  test('refuses a release that differs from its pin, and stores nothing', async (ctx) => {
    let scratch = await Scratch.create('fetch-changed');
    let pds = await startFakePds(scratch, 'fetch-pds.zena');
    try {
      let plc = await fakePdsOrigin(scratch, pds);
      // Pin a release record CID the PDS does not serve.
      let pinned = await read(scratch.at('pds/zena-lock.json'));
      let marker = '"release": "';
      let parts = pinned.split(marker);
      let tail = parts[1];
      var end = 0;
      while (tail.getByteAt(end) != 34) { // '"'
        end += 1;
      }
      await write(scratch.at('workspace/zena-lock.json'),
          `${parts[0]}${marker}bafyreie5737gdxlw5i64vzichcalba3z2v5n6icifvx5xytvske7mr3hpm${tail.sliceBytes(end, tail.length)}`);
      // The manifest makes the directory the workspace whose lockfile is read.
      await write(scratch.at('workspace/zena-package.json'), await read(scratch.at('pds/zena-package.json')));
      let fetched = await zenaIn(scratch, 'workspace').set('ZENA_PLC_DIRECTORY', plc).run(['pkg', 'fetch']);
      isTrue(!fetched.succeeded(), 'zena pkg fetch accepted a changed release');
      isTrue(fetched.stderr.contains('changed after it was pinned'), described(fetched));
      let sources = scratch.at('cache/packages/sources');
      isTrue(!(await exists(sources)) || (await listDir(sources)).length == 0,
          'zena pkg fetch stored a package it refused');
    } finally {
      await stopFakePds(pds);
      await scratch.remove();
    }
  });
});
