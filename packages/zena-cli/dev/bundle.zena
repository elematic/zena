import { ArgParser } from 'zena:args';
import { getArguments, exit } from 'zena:cli';
import { exists, isDirectory, isFile, listDir, FileType, mkdir, readFileBytes, writeFile } from 'zena:fs';
import { dirname, join2, relative } from 'zena:path';
import { StringBuilder, GrowableArray } from 'zena:core';
import { sha256Hex, sha256HexOfString } from 'zena:crypto';
import { compareStrings, sortBy } from 'workflow:canonical';

class BundleFile(relPath: String, absPath: String)

let collectFiles = (
  dir: String,
  base: String,
  out: GrowableArray<BundleFile>,
): void => {
  if (!isDirectory(dir)) {
    return;
  }
  for (let entry in listDir(dir)) {
    let name = entry.name;
    // Skip hidden files or OS artifacts like .DS_Store
    if (name.startsWith('.')) {
      continue;
    }
    let full = join2(dir, name);
    if (entry.fileType == FileType.Directory) {
      collectFiles(full, base, out);
    } else if (entry.fileType == FileType.RegularFile) {
      let rel = relative(base, full);
      out.push(new BundleFile(rel, full));
    }
  }
};

export let main = (): i32 => {
  let parser = new ArgParser('bundle', 'Generates the Rust stdlib and CLI module bundle.')
    .addOption('stdlib', {
      abbr: 's',
      defaultVal: 'packages/stdlib/zena',
      help: 'Path to stdlib source directory',
    })
    .addOption('module', {
      abbr: 'm',
      defaultVal: 'packages/zena-cli/out/zena.wasm',
      help: 'Path to compiled CLI Wasm module',
    })
    .addOption('out', {
      abbr: 'o',
      defaultVal: 'packages/zena-cli/out/stdlib_bundle.rs',
      help: 'Output Rust source file',
    });

  let parsed = parser.parse(getArguments(), 1);
  let stdlibDir = parsed.getOption('stdlib') ?? 'packages/stdlib/zena';
  let modulePath = parsed.getOption('module') ?? 'packages/zena-cli/out/zena.wasm';
  let outPath = parsed.getOption('out') ?? 'packages/zena-cli/out/stdlib_bundle.rs';

  let files = new GrowableArray<BundleFile>();
  collectFiles(stdlibDir, stdlibDir, files);
  sortBy(files, (a: BundleFile, b: BundleFile) => compareStrings(a.relPath, b.relPath));

  // Compute a composite hash of all stdlib files (relative paths + content hashes)
  let hashSummary = new StringBuilder();
  for (let f in files) {
    hashSummary.append(f.relPath);
    hashSummary.append(':');
    let contentHash = sha256Hex(readFileBytes(f.absPath));
    hashSummary.append(contentHash);
    hashSummary.append('\n');
  }
  let stdlibHash = sha256HexOfString(hashSummary.toString());

  let sb = new StringBuilder();
  sb.append('// Auto-generated by packages/zena-cli/dev/bundle.zena. Do not edit.\n\n');
  sb.append('pub static STDLIB_HASH: &str = "');
  sb.append(stdlibHash);
  sb.append('";\n\n');
  sb.append('pub static STDLIB_FILES: &[(&str, &[u8])] = &[\n');
  for (let f in files) {
    sb.append('    ("');
    sb.append(f.relPath);
    sb.append('", include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"), "/../../packages/stdlib/zena/');
    sb.append(f.relPath);
    sb.append('"))),\n');
  }
  sb.append('];\n\n');

  if (isFile(modulePath)) {
    let wasmHash = sha256Hex(readFileBytes(modulePath));
    sb.append('pub static BUNDLED_CLI_HASH: Option<&str> = Some("');
    sb.append(wasmHash);
    sb.append('");\n');
    sb.append('pub static BUNDLED_CLI_MODULE: Option<&\'static [u8]> = Some(include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"), "/out/zena.wasm")));\n');
  } else {
    sb.append('pub static BUNDLED_CLI_HASH: Option<&str> = None;\n');
    sb.append('pub static BUNDLED_CLI_MODULE: Option<&\'static [u8]> = None;\n');
  }

  let outDir = dirname(outPath);
  if (outDir.length > 0 && !exists(outDir)) {
    mkdir(outDir);
  }

  writeFile(outPath, sb.toString());
  console.log(`Bundled ${files.length} stdlib files into ${outPath}`);
  return 0;
};

