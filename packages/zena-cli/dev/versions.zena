/**
 * Writes `zena/versions.zena` from the packages' manifests
 * (`dev/version-file.zena`): `npm run versions`, after changing the
 * version of zena-cli, zena-compiler or package-manager.
 */

import {Future} from 'zena:async';
import {writeFile} from 'zena:fs';
import {VERSIONS_FILE, versionsSource} from './version-file.zena';

export async function main(): Future<i32> {
  await writeFile(VERSIONS_FILE, await versionsSource());
  console.log(`wrote ${VERSIONS_FILE}`);
  return 0;
}
