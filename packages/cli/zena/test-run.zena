/**
 * `zena test`: find the test files, compile the ones the cache does not
 * hold, then run each in its own Wasmtime store.
 *
 * When more files are stale than workers run at once, compiling comes
 * first (`zena test --compile <files...>`), each worker compiling its
 * share of the files on one `CompileSession` so the standard library and
 * shared packages are loaded and checked once per worker rather than once
 * per file (`compileIntoCache`). Each test whose cached `.wasm` is fresh
 * then runs directly with `startModule(cachedWasm, ...)`; a file that did
 * not compile in `--compile` falls back to `zena test --single <file>` so
 * its diagnostics are captured and reported.
 *
 * `CliTestStepRunner` shares one `ConcurrencyLimiter` across all
 * `"type": "zena:test"` steps in a build or watch run so concurrent package
 * test suites share a single worker cap and run in-process.
 */

import { ArgParser, OptionType, ParsedArgs } from 'zena:args';
import { Completer, Future } from 'zena:async';
import { getEnv, getEnvironment } from 'zena:cli';
import { HashMap, HashSet } from 'zena:collections';
import { StringBuilder } from 'zena:core';
import { GlobOptions, exists, glob, isDirectory, isFile } from 'zena:fs';
import { hasMagic } from 'zena:glob';
import { AbsolutePath, RelativePath, extname, isAbsolute, join2, normalize } from 'zena:path';
import { div } from 'zena:math';
import { monotonic } from 'zena:time';
import { RunOutcome, RunResult, runModule } from 'zena:wasm';
import { StepExecution, TestStepRequest, TestStepRunner } from 'zebra/builder';
import { joinWorkspace } from 'zebra/fs-util';
import { appendShellArgs } from 'zebra/shell';
import {
  CompileRequest, cachedModuleIfFresh, compileCached, compileIntoCache,
  testRunnerFingerprint
} from './compile.zena';
import {
  Options, cliModule, envInt, hostEnv, normalizeHostPath, parallelism, repoRelative,
  resolveUserPath, stdlibDir, workspaceRoot
} from './env.zena';
import { hostDir } from './run.zena';

/** ANSI SGR sequence (string literals have no escape for ESC). */
function sgr(code: String) {
  let b = new StringBuilder();
  b.appendByte(27);
  b.append('[');
  b.append(code);
  b.append('m');
  return b.toString();
}

let green = sgr('32');
let red = sgr('31');
let reset = sgr('0');

class WaiterBucket {
  waiters = new GrowableArray<Completer<void>>();
  var head = 0;

  isEmpty(): boolean {
    return this.head >= this.waiters.length;
  }

  push(w: Completer<void>): void {
    this.waiters.push(w);
  }

  pop(): Completer<void> {
    let w = this.waiters[this.head];
    this.head += 1;
    if (this.head >= this.waiters.length) {
      this.waiters.clear();
      this.head = 0;
    }
    return w;
  }
}

/**
 * Permit limiter shared across concurrent test steps, servicing waiting
 * package queues in round-robin order so a package with many fast files
 * never starves another package's long critical-path suite.
 */
class ConcurrencyLimiter {
  #limit: i32;
  var #active = 0;
  var #nextQueueId = 1;
  #buckets = new HashMap<i32, WaiterBucket>();
  #ring = new GrowableArray<i32>();
  var #ringHead = 0;

  new(limit: i32) : #limit = if (limit >= 1) limit else 1;

  limit: i32 {
    get { return this.#limit; }
  }

  allocateQueue(): i32 {
    let id = this.#nextQueueId;
    this.#nextQueueId += 1;
    return id;
  }

  async acquire(queueId: i32 = 0): Future<void> {
    if (this.#active < this.#limit) {
      this.#active += 1;
      return;
    }
    let waiter = new Completer<void>();
    var bucket: WaiterBucket | null = null;
    if (let (true, existing) = this.#buckets.get(queueId)) {
      bucket = existing;
    } else {
      let created = new WaiterBucket();
      this.#buckets[queueId] = created;
      bucket = created;
    }
    let wasEmpty = bucket.isEmpty();
    bucket.push(waiter);
    if (wasEmpty) {
      this.#ring.push(queueId);
    }
    await waiter.future;
  }

  tryAcquire(): boolean {
    if (this.#active < this.#limit) {
      this.#active += 1;
      return true;
    }
    return false;
  }

  release(): void {
    while (this.#ringHead < this.#ring.length) {
      let queueId = this.#ring[this.#ringHead];
      this.#ringHead += 1;
      if (this.#ringHead >= this.#ring.length) {
        this.#ring.clear();
        this.#ringHead = 0;
      }
      if (let (true, bucket) = this.#buckets.get(queueId)) {
        if (!bucket.isEmpty()) {
          let next = bucket.pop();
          if (!bucket.isEmpty()) {
            this.#ring.push(queueId);
          } else {
            this.#buckets.delete(queueId);
          }
          next.complete();
          return;
        }
        this.#buckets.delete(queueId);
      }
    }
    this.#active -= 1;
  }
}

/**
 * Resolves a user/config argument relative to `baseDir` within `targetRoot`
 * into a glob pattern relative to `targetRoot`, or `null` when a literal
 * path does not exist.
 */
async function resolveTestPatternInRoot(
  targetRoot: String,
  baseDir: String,
  argument: String,
): Future<String | null> {
  let normalizedArg = normalizeHostPath(argument, getEnv('ZENA_HOST_PLATFORM'));
  let rootPath = new AbsolutePath(targetRoot);
  let resolved = if (isAbsolute(normalizedArg))
    new AbsolutePath(normalize(normalizedArg))
  else
    new AbsolutePath(
      normalize(
        join2(
          if (baseDir == '') targetRoot else `${targetRoot}/${baseDir}`,
          normalizedArg,
        ),
      ),
    );
  let rel = resolved.stripPrefix(rootPath);
  let fromRoot = if (rel == null) resolved.value else rel.value;
  if (hasMagic(normalizedArg)) {
    return fromRoot;
  }
  let checkInProcess = targetRoot == workspaceRoot().value;
  let found = if (checkInProcess)
    (await exists(fromRoot)) || (await exists(resolved.value))
  else
    await exists(resolved.value);
  if (!found) {
    return null;
  }
  let isDir = if (checkInProcess)
    (await isDirectory(fromRoot)) || (await isDirectory(resolved.value))
  else
    await isDirectory(resolved.value);
  if (isDir) {
    return if (fromRoot == '' || fromRoot == '.') '**/*_test.zena' else `${fromRoot}/**/*_test.zena`;
  }
  return fromRoot;
}

/**
 * The glob pattern one `zena test` CLI argument stands for, relative to
 * the workspace root, or null when it names nothing.
 */
async function testPattern(argument: String): Future<String | null> {
  let resolved = resolveUserPath(argument);
  let fromRoot = repoRelative(resolved);
  if (hasMagic(argument)) {
    return fromRoot;
  }
  if (!(await exists(fromRoot)) && !(await exists(resolved.value))) {
    return null;
  }
  if ((await isDirectory(fromRoot)) || (await isDirectory(resolved.value))) {
    return if (fromRoot == '' || fromRoot == '.') '**/*_test.zena' else `${fromRoot}/**/*_test.zena`;
  }
  return fromRoot;
}

/** Discovers `.zena` test files for CLI `zena test <paths...>`. */
async function findTests(args: ParsedArgs, paths: Array<String>): Future<Array<String> | null> {
  let excludes = args.getMultiOption('exclude');
  var filter = '';
  if (let (true, value) = args.getOption('filter')) {
    filter = value;
  }
  let found = new GrowableArray<String>();
  let seen = new HashSet<String>();
  for (let argument in paths) {
    let pattern = await testPattern(argument);
    if (pattern == null) {
      console.error('Error: path not found: ' + argument);
      return null;
    }
    let opts = new GlobOptions();
    opts.cwd = workspaceRoot().value;
    for (let exclude in excludes) {
      opts.exclude.push(exclude);
    }
    for (let match in await glob(pattern, opts)) {
      if (extname(match) != '.zena') {
        continue;
      }
      if (filter != '' && !match.contains(filter)) {
        continue;
      }
      if (seen.add(match)) {
        found.push(match);
      }
    }
  }
  return found;
}

/** Discovers `.zena` test files for a Zebra `"type": "zena:test"` step. */
async function findStepTests(
  targetRoot: String,
  packageDir: String,
  patterns: Array<String>,
  filter: String,
  excludes: Array<String>,
  errorsOut: GrowableArray<String>,
): Future<Array<String> | null> {
  let found = new GrowableArray<String>();
  let seen = new HashSet<String>();
  for (let raw in patterns) {
    let pattern = await resolveTestPatternInRoot(targetRoot, packageDir, raw);
    if (pattern == null) {
      errorsOut.push('Error: path not found: ' + raw);
      return null;
    }
    let opts = new GlobOptions();
    opts.cwd = targetRoot;
    for (let exclude in excludes) {
      let scopedExclude = if (packageDir == '' || isAbsolute(exclude) || exclude.startsWith('**/'))
        exclude
      else
        joinWorkspace(packageDir, exclude);
      opts.exclude.push(scopedExclude);
    }
    for (let match in await glob(pattern, opts)) {
      if (extname(match) != '.zena') {
        continue;
      }
      if (filter != '' && !match.contains(filter)) {
        continue;
      }
      if (seen.add(match)) {
        found.push(match);
      }
    }
  }
  return found;
}

/** Builds an explicit guest WASI environment map (preserving first-entry-wins). */
function buildGuestEnv(
  targetRoot: String,
  overrides: Array<(String, String)>,
  removals: Array<String>,
  includeCliHostVars: boolean,
  cliModuleOverride: AbsolutePath | null = null,
): Map<String, String> {
  let removed = new HashSet<String>();
  for (let name in removals) {
    removed.add(name);
  }
  let env = new Map<String, String>();
  for (let entry in getEnvironment()) {
    if (!removed.has(entry.name) && !env.has(entry.name)) {
      env[entry.name] = entry.value;
    }
  }
  if (includeCliHostVars) {
    for (let entry in hostEnv()) {
      if (!removed.has(entry.key)) {
        env[entry.key] = entry.value;
      }
    }
    if (cliModuleOverride != null && !removed.has('ZENA_CLI_MODULE')) {
      env['ZENA_CLI_MODULE'] = cliModuleOverride.value;
    }
    env['ZENA_CWD'] = targetRoot;
  }
  for (let (name, value) in overrides) {
    env[name] = value;
  }
  env['ZENA_WORKSPACE_ROOT'] = targetRoot;
  return env;
}

class TestFileOutcome(passed: boolean, formatted: String)

function appendIndented(out: StringBuilder, label: String, text: String) {
  if (text.length == 0) {
    return;
  }
  out.append(`      --- ${label} ---\n`);
  for (let line in text.split('\n')) {
    out.append(`      ${line}\n`);
  }
}

function formatTestResult(
  path: String,
  direct: boolean,
  result: RunResult,
  useColor: boolean,
) {
  let ms = (result.callTime as i64 as f64) / 1000000.0;
  let tenths = ((ms * 10.0) as i64 as f64) / 10.0;
  let passed = if (direct)
    result.outcome == RunOutcome.Returned &&
      result.exitCode == 0 &&
      !result.stdout.contains('FAIL')
  else
    result.succeeded();

  let passTag = if (useColor) `${green}PASS${reset}` else 'PASS';
  let failTag = if (useColor) `${red}FAIL${reset}` else 'FAIL';

  if (passed) {
    return new TestFileOutcome(true, `${passTag}  ${path} (${tenths}ms)\n`);
  }

  let block = new StringBuilder();
  block.append(`${failTag}  ${path} (${tenths}ms)\n`);
  appendIndented(block, 'Stdout', result.stdout);
  if (direct) {
    var errText = result.stderr;
    let reason = if (result.message != '') {
      result.message
    } else if (result.exitCode != 0) {
      `Suite returned non-zero code: ${result.exitCode}`
    } else {
      'Suite reported failure in output'
    };
    if (reason != '') {
      errText = if (errText == '')
        reason
      else if (errText.endsWith('\n'))
        `${errText}${reason}`
      else
        `${errText}\n${reason}`;
    }
    appendIndented(block, 'Stderr', errText);
  } else {
    appendIndented(block, 'Stderr', result.stderr);
    if (result.message != '') {
      appendIndented(block, 'Error', result.message);
    }
  }
  return new TestFileOutcome(false, block.toString());
}

/** Absolute path of `file` (which is relative to `targetRoot`). */
function testPathInRoot(targetRoot: String, file: String) {
  return new AbsolutePath(targetRoot).join(new RelativePath(file)).value;
}

/** The compile request for `absOrRelPath` in the current CLI workspace. */
function testRequest(path: String) {
  let request = new CompileRequest(resolveUserPath(path));
  request.testMode = true;
  return request;
}

function testRequestForAbs(absPath: String) {
  let request = new CompileRequest(new AbsolutePath(normalize(absPath)));
  request.testMode = true;
  return request;
}

/** Runs a copy of this CLI module as `zena test <mode> <paths...>`. */
async function runCopyInRoot(
  targetRoot: String,
  mode: String,
  paths: Array<String>,
  options: Options,
  noCache: boolean,
  cliGuestEnv: Map<String, String>,
  cliModuleOverride: AbsolutePath | null = null,
): Future<RunResult> {
  let args = new GrowableArray<String>();
  args.push('zena');
  if (options.debug) {
    args.push('-g');
  }
  let opt = options.optLevel;
  if (opt != null) {
    args.push('-O');
    args.push(opt);
  }
  args.push('test');
  args.push(mode);
  if (noCache) {
    args.push('--no-cache');
  }
  for (let path in paths) {
    args.push(path);
  }
  let modulePath = if (cliModuleOverride != null) cliModuleOverride.value else cliModule().value;
  return await runModule(modulePath, {
    args: args,
    env: cliGuestEnv,
    inheritEnv: false,
    dirs: [
      {from: targetRoot, to: '.'},
      {from: stdlibDir().value, to: '/stdlib'},
      {from: '/', to: '/'},
    ],
    grant: true,
    grantExtensions: true,
    debug: options.debug,
  });
}

async function runCompileShareWithPermit(
  targetRoot: String,
  share: Array<String>,
  options: Options,
  noCache: boolean,
  cliGuestEnv: Map<String, String>,
  cliModuleOverride: AbsolutePath | null,
  limiter: ConcurrencyLimiter,
): Future<void> {
  try {
    await runCopyInRoot(
      targetRoot,
      '--compile',
      share,
      options,
      noCache,
      cliGuestEnv,
      cliModuleOverride,
    );
  } finally {
    limiter.release();
  }
}

/**
 * Checks `.zena` cache freshness once per file, batch-compiles stale files
 * across available `limiter` workers (releasing each permit as soon as its
 * worker finishes), and returns the map of `file -> freshCachedWasmPath`.
 */
async function prepareTestModules(
  targetRoot: String,
  files: Array<String>,
  options: Options,
  limiter: ConcurrencyLimiter,
  noCache: boolean,
  cliGuestEnv: Map<String, String>,
  cliModuleOverride: AbsolutePath | null = null,
  identityMemo: HashMap<String, String> | null = null,
): Future<HashMap<String, AbsolutePath>> {
  let fresh = new HashMap<String, AbsolutePath>();
  let canCheckCacheHere = !noCache && targetRoot == workspaceRoot().value;
  let staleFiles = new GrowableArray<String>();
  let staleAbs = new GrowableArray<String>();
  for (let file in files) {
    let absPath = testPathInRoot(targetRoot, file);
    if (canCheckCacheHere) {
      let cached = await cachedModuleIfFresh(
        testRequestForAbs(absPath),
        options,
        cliModuleOverride,
        identityMemo,
      );
      if (cached != null) {
        fresh[file] = cached;
        continue;
      }
    }
    staleFiles.push(file);
    staleAbs.push(absPath);
  }

  if (staleAbs.length <= 1) {
    return fresh;
  }
  let maxCopies = if (staleAbs.length < limiter.limit) staleAbs.length else limiter.limit;
  if (staleAbs.length <= maxCopies && targetRoot != workspaceRoot().value) {
    return fresh;
  }

  // Acquire 1 permit, then take up to `maxCopies - 1` immediately available permits.
  await limiter.acquire();
  var copies = 1;
  while (copies < maxCopies && limiter.tryAcquire()) {
    copies += 1;
  }
  if (staleAbs.length <= copies) {
    for (var r = 0; r < copies; r += 1) {
      limiter.release();
    }
    return fresh;
  }

  let compileTasks = new GrowableArray<Future<void>>();
  var unstarted = copies;
  try {
    var start = 0;
    for (var i = 0; i < copies; i += 1) {
      var size = div(staleAbs.length, copies);
      if (i < staleAbs.length % copies) {
        size += 1;
      }
      let share = new GrowableArray<String>();
      for (var j = start; j < start + size; j += 1) {
        share.push(staleAbs[j]);
      }
      start += size;
      compileTasks.push(
        runCompileShareWithPermit(
          targetRoot,
          share,
          options,
          noCache,
          cliGuestEnv,
          cliModuleOverride,
          limiter,
        ),
      );
      unstarted -= 1;
    }
  } finally {
    for (var r = 0; r < unstarted; r += 1) {
      limiter.release();
    }
  }
  for (let task in compileTasks) {
    await task;
  }

  if (canCheckCacheHere) {
    for (var i = 0; i < staleFiles.length; i += 1) {
      let cached = await cachedModuleIfFresh(
        testRequestForAbs(staleAbs[i]),
        options,
        cliModuleOverride,
        identityMemo,
      );
      if (cached != null) {
        fresh[staleFiles[i]] = cached;
      }
    }
  }
  return fresh;
}

/**
 * Acquires one permit, runs `file`, immediately releases both the `Run`
 * resource and the `limiter` permit on completion, and returns the formatted
 * result line(s).
 */
async function runOneTestFile(
  targetRoot: String,
  file: String,
  cachedModule: AbsolutePath | null,
  tmpDir: String,
  options: Options,
  limiter: ConcurrencyLimiter,
  queueId: i32,
  noCache: boolean,
  directGuestEnv: Map<String, String>,
  cliGuestEnv: Map<String, String>,
  useColor: boolean,
  cliModuleOverride: AbsolutePath | null,
): Future<TestFileOutcome> {
  await limiter.acquire(queueId);
  let absFile = testPathInRoot(targetRoot, file);
  let direct = cachedModule != null;
  let result = try {
    if (cachedModule != null) {
      await runModule(cachedModule.value, {
        args: [absFile],
        env: directGuestEnv,
        inheritEnv: false,
        dirs: [
          {from: targetRoot, to: '.'},
          {from: stdlibDir().value, to: '/stdlib'},
          {from: tmpDir, to: '/tmp'},
        ],
        grant: true,
        grantExtensions: true,
        debug: options.debug,
      })
    } else {
      await runCopyInRoot(
        targetRoot,
        '--single',
        [absFile],
        options,
        noCache,
        cliGuestEnv,
        cliModuleOverride,
      )
    }
  } finally {
    limiter.release();
  };
  return formatTestResult(file, direct, result, useColor);
}

/** Runs `files` under `limiter`, streaming to console or capturing into `capturedOut`. */
async function executeTestFiles(
  targetRoot: String,
  files: Array<String>,
  options: Options,
  limiter: ConcurrencyLimiter,
  noCache: boolean,
  envOverrides: Array<(String, String)>,
  envRemovals: Array<String>,
  streamToConsole: boolean,
  capturedOut: StringBuilder,
  cliModuleOverride: AbsolutePath | null = null,
  identityMemo: HashMap<String, String> | null = null,
): Future<i32> {
  let header = `Running ${files.length} tests...`;
  if (streamToConsole) {
    console.log(header);
  } else {
    capturedOut.append(header);
    capturedOut.append('\n');
  }

  let directGuestEnv = buildGuestEnv(targetRoot, envOverrides, envRemovals, false);
  let cliGuestEnv = buildGuestEnv(
    targetRoot,
    envOverrides,
    envRemovals,
    true,
    cliModuleOverride,
  );

  let freshModules = await prepareTestModules(
    targetRoot,
    files,
    options,
    limiter,
    noCache,
    cliGuestEnv,
    cliModuleOverride,
    identityMemo,
  );

  let tmpDir = (await hostDir('/tmp')).value;
  let useColor = getEnv('NO_COLOR') == null;
  let queueId = limiter.allocateQueue();

  let tasks = new GrowableArray<Future<TestFileOutcome>>();
  for (let file in files) {
    var cachedMod: AbsolutePath | null = null;
    if (let (true, hit) = freshModules.get(file)) {
      cachedMod = hit;
    }
    tasks.push(
      runOneTestFile(
        targetRoot,
        file,
        cachedMod,
        tmpDir,
        options,
        limiter,
        queueId,
        noCache,
        directGuestEnv,
        cliGuestEnv,
        useColor,
        cliModuleOverride,
      ),
    );
  }

  var passed = 0;
  var failed = 0;
  for (let task in tasks) {
    let outcome = await task;
    if (outcome.passed) {
      passed += 1;
    } else {
      failed += 1;
    }
    if (streamToConsole) {
      echo(outcome.formatted, false);
    } else {
      capturedOut.append(outcome.formatted);
    }
  }

  let summary = `Test Summary: ${passed} passed, ${failed} failed`;
  if (streamToConsole) {
    console.log('');
    console.log(summary);
  } else {
    capturedOut.append('\n');
    capturedOut.append(summary);
    capturedOut.append('\n');
  }
  return if (failed > 0) { 1 } else { 0 };
}

/**
 * `zena test --compile <files...>`: compile the files into the cache on
 * one compiler, and run none.
 */
async function compileOnly(args: ParsedArgs, options: Options): Future<i32> {
  let requests = new GrowableArray<CompileRequest>();
  for (let path in args.rest) {
    requests.push(testRequest(path));
  }
  await compileIntoCache(requests, options, args.getFlag('no-cache'));
  return 0;
}

export async function testCommand(
  args: ParsedArgs,
  options: Options,
  paths: Array<String> = args.rest,
  jobs: i32 = 0,
  noCache: boolean = false,
): Future<i32> {
  if (args.getFlag('single')) {
    return await runSingle(args, options);
  }
  if (args.getFlag('compile')) {
    return await compileOnly(args, options);
  }
  if (paths.length == 0) {
    console.error('Error: test needs a file, directory or glob');
    return 2;
  }
  let files = await findTests(args, paths);
  if (files == null) {
    return 2;
  }
  if (files.length == 0) {
    console.error('Error: no tests found matching the path or filter');
    return 2;
  }
  let limit = if (jobs > 0) jobs else parallelism();
  let limiter = new ConcurrencyLimiter(limit);
  let emptyOverrides = new GrowableArray<(String, String)>();
  let emptyRemovals = new GrowableArray<String>();
  return await executeTestFiles(
    workspaceRoot().value,
    files,
    options,
    limiter,
    noCache,
    emptyOverrides,
    emptyRemovals,
    true,
    new StringBuilder(),
  );
}

function stepExtraArgsParser() {
  return new ArgParser({
    name: 'zena test',
    options: {
      'filter' => {
        abbr: 'f',
        help: 'Only run files whose path contains this',
      },
      'exclude' => {
        type: OptionType.MultiString,
        help: 'Skip files matching this glob',
      },
      'no-cache' => {
        type: OptionType.Flag,
        help: 'Compile even if the cache has an answer',
      },
    },
  });
}

function formatStepCommandLabel(
  patterns: Array<String>,
  extraArgs: Array<String>,
  debug: boolean,
) {
  let base = if (debug) 'zena -g test' else 'zena test';
  let all = new GrowableArray<String>();
  for (let p in patterns) {
    all.push(p);
  }
  for (let a in extraArgs) {
    all.push(a);
  }
  return appendShellArgs(base, all);
}

function stepRunnerParallelism(jobs: i32): i32 {
  if (jobs > 0) {
    return jobs;
  }
  let explicitTest = envInt('ZENA_TEST_PARALLELISM');
  if (explicitTest > 0) {
    return explicitTest;
  }
  let zebraPar = envInt('ZEBRA_PARALLEL');
  if (zebraPar > 0) {
    return zebraPar;
  }
  let available = envInt('ZENA_AVAILABLE_PARALLELISM');
  if (available <= 0) {
    return parallelism();
  }
  if (available > 16) {
    return 16;
  }
  return available;
}

/**
 * Shared in-process runner passed to Zebra's `buildTarget` and `watchTarget`
 * so `"type": "zena:test"` steps run without spawning shell or CLI processes.
 */
export class CliTestStepRunner implements TestStepRunner {
  #options: Options;
  #limiter: ConcurrencyLimiter;
  #noCache: boolean;
  #builtCliPath: String;
  #startedOnBootstrapFallback: boolean;
  #identityMemo = new HashMap<String, String>();
  var #activeSteps = 0;

  new(
    options: Options,
    jobs: i32,
    noCache: boolean,
    builtCliPath: String,
    startedOnBootstrapFallback: boolean,
  ) : #options = options,
      #limiter = new ConcurrencyLimiter(stepRunnerParallelism(jobs)),
      #noCache = noCache,
      #builtCliPath = builtCliPath,
      #startedOnBootstrapFallback = startedOnBootstrapFallback;

  static async create(
    options: Options,
    jobs: i32,
    noCache: boolean,
  ): Future<CliTestStepRunner> {
    let root = workspaceRoot().value;
    let builtPath = `${root}/packages/cli/out/zena.wasm`;
    let bootstrapPath = `${root}/packages/cli/bootstrap/zena.wasm`;
    let startedOnBootstrap =
      cliModule().value == bootstrapPath && !(await isFile(builtPath));
    return new CliTestStepRunner(options, jobs, noCache, builtPath, startedOnBootstrap);
  }

  async #activeCliModule(): Future<AbsolutePath> {
    if (this.#startedOnBootstrapFallback && (await isFile(this.#builtCliPath))) {
      return new AbsolutePath(this.#builtCliPath);
    }
    return cliModule();
  }

  async fingerprint(): Future<String> {
    if (this.#activeSteps == 0) {
      this.#identityMemo.clear();
    }
    return await testRunnerFingerprint(this.#options, await this.#activeCliModule());
  }

  async runTests(request: TestStepRequest): Future<StepExecution> {
    let startNs = monotonic() as i64;
    let cmdLabel = formatStepCommandLabel(
      request.patterns,
      request.extraArgs,
      request.debug || this.#options.debug,
    );
    var filter = '';
    var excludes: Array<String> = new GrowableArray<String>();
    var stepNoCache = this.#noCache;
    var activePatterns = request.patterns;

    if (request.extraArgs.length > 0) {
      let parser = stepExtraArgsParser();
      var parsed: ParsedArgs | null = null;
      try {
        parsed = parser.parse(request.extraArgs);
      } catch (e) {
        let durationMs = div((monotonic() as i64) - startNs, 1000000 as i64);
        return new StepExecution(cmdLabel, 2, '', `Error: ${e.message}\n`, durationMs);
      }
      let p = parsed;
      if (let (true, f) = p.getOption('filter')) {
        filter = f;
      }
      excludes = p.getMultiOption('exclude');
      if (p.getFlag('no-cache')) {
        stepNoCache = true;
      }
      if (p.rest.length > 0) {
        activePatterns = p.rest;
      }
    }

    let errors = new GrowableArray<String>();
    let files = await findStepTests(
      request.root,
      request.packageDir,
      activePatterns,
      filter,
      excludes,
      errors,
    );
    if (files == null) {
      let errSb = new StringBuilder();
      for (let msg in errors) {
        errSb.append(msg);
        errSb.append('\n');
      }
      let durationMs = div((monotonic() as i64) - startNs, 1000000 as i64);
      return new StepExecution(cmdLabel, 2, '', errSb.toString(), durationMs);
    }
    if (files.length == 0) {
      let durationMs = div((monotonic() as i64) - startNs, 1000000 as i64);
      return new StepExecution(
        cmdLabel,
        2,
        '',
        'Error: no tests found matching the path or filter\n',
        durationMs,
      );
    }

    let stepOptions = new Options(
      this.#options.verbose,
      this.#options.debug || request.debug,
      this.#options.optLevel,
    );
    let activeCli = await this.#activeCliModule();
    let capturedOut = new StringBuilder();
    if (this.#activeSteps == 0) {
      this.#identityMemo.clear();
    }
    this.#activeSteps += 1;
    let exitCode = try {
      await executeTestFiles(
        request.root,
        files,
        stepOptions,
        this.#limiter,
        stepNoCache,
        request.env,
        request.envRemove,
        false,
        capturedOut,
        activeCli,
        this.#identityMemo,
      )
    } finally {
      this.#activeSteps -= 1;
      if (this.#activeSteps == 0) {
        this.#identityMemo.clear();
      }
    };
    let durationMs = div((monotonic() as i64) - startNs, 1000000 as i64);
    return new StepExecution(
      cmdLabel,
      exitCode,
      capturedOut.toString(),
      '',
      durationMs,
    );
  }
}

/** Writes captured output through without adding a newline of its own. */
function echo(text: String, toError: boolean) {
  if (text == '') {
    return;
  }
  let trimmed = if (text.endsWith('\n')) text.sliceBytes(0, text.length - 1) else text;
  if (toError) {
    console.error(trimmed);
  } else {
    console.log(trimmed);
  }
}

/**
 * `zena test --single <file>`: compile one test file and run it,
 * printing what it printed. Returns 0 when it passed: its `main`
 * returned 0 and it printed no `FAIL`.
 *
 * The test gets the repository as `.`, the standard library as
 * `/stdlib` and a temporary directory as `/tmp`, and may spawn
 * processes: repository tests are trusted code. `ZENA_WORKSPACE_ROOT`
 * gives it the workspace's path on the host, for the processes it starts.
 */
async function runSingle(args: ParsedArgs, options: Options): Future<i32> {
  if (args.rest.length != 1) {
    console.error('Error: test --single takes exactly one file');
    return 2;
  }
  let file = args.rest[0];
  let request = testRequest(file);
  var module: AbsolutePath | null = null;
  try {
    module = await compileCached(request, options, args.getFlag('no-cache'));
  } catch (e) {
    console.error(e.message);
    return 1;
  }
  if (module == null) {
    return 1;
  }
  let emptyOverrides = new GrowableArray<(String, String)>();
  let emptyRemovals = new GrowableArray<String>();
  let result = await runModule(module.value, {
    args: [file],
    env: buildGuestEnv(workspaceRoot().value, emptyOverrides, emptyRemovals, false),
    inheritEnv: false,
    dirs: [
      {from: workspaceRoot().value, to: '.'},
      {from: stdlibDir().value, to: '/stdlib'},
      {from: (await hostDir('/tmp')).value, to: '/tmp'},
    ],
    grant: true,
    grantExtensions: true,
    debug: options.debug,
  });
  echo(result.stdout, false);
  if (result.outcome == RunOutcome.Returned && result.exitCode == 0 &&
      !result.stdout.contains('FAIL')) {
    return 0;
  }
  echo(result.stderr, true);
  if (result.message != '') {
    console.error(result.message);
  } else if (result.exitCode != 0) {
    console.error(`Suite returned non-zero code: ${result.exitCode}`);
  } else {
    console.error('Suite reported failure in output');
  }
  return 1;
}
