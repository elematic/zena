/**
 * `zena pkg init [dir]`: make a directory a package, with a
 * `zena-package.json` naming it (docs/design/package-manifest.md).
 *
 * The directory is the current one, or `dir`, which is made if need be.
 * The package's name is `--name`, or else the directory's name, which must
 * then be a valid package name; `--scope` adds the scope it is published
 * in. Its version starts at 0.1.0. A directory that already has a manifest
 * is left as it is.
 */

import { ParsedArgs } from 'zena:args';
import { Future } from 'zena:async';
import { exists, writeFile } from 'zena:fs';
import { JsonObject, stringify } from 'zena:json';
import { basename, join2 } from 'zena:path';
import { isValidPackageName, isValidScopeName } from 'package-manager/records';
import { Options, resolveUserPath, userCwd } from '../env.zena';
import { ensureDir } from '../compile.zena';

export async function initCommand(args: ParsedArgs, options: Options): Future<i32> {
  if (args.rest.length > 1) {
    console.error('Error: zena pkg init takes at most one directory.');
    return 2;
  }
  let dir = if (args.rest.length == 1) resolveUserPath(args.rest[0]).value else userCwd().value;
  let manifestPath = join2(dir, 'zena-package.json');
  if (await exists(manifestPath)) {
    console.error(`Error: ${manifestPath} already exists.`);
    return 1;
  }

  var name = basename(dir);
  if (let (true, given) = args.getOption('name')) {
    name = given;
  }
  if (!isValidPackageName(name)) {
    console.error(`Error: '${name}' is not a valid package name: lowercase letters, digits and '-', starting with a letter. Give one with --name.`);
    return 1;
  }
  let manifest = new JsonObject();
  manifest['name'] = name;
  if (let (true, scope) = args.getOption('scope')) {
    if (!isValidScopeName(scope)) {
      console.error(`Error: '${scope}' is not a valid scope name.`);
      return 1;
    }
    manifest['scope'] = scope;
  }
  manifest['version'] = '0.1.0';

  await ensureDir(dir);
  await writeFile(manifestPath, stringify(manifest, '  '));
  console.log(`Wrote ${manifestPath}: the package ${name}.`);
  return 0;
}
