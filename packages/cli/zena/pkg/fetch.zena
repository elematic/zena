/**
 * `zena pkg fetch`: fetches the packages the workspace's `zena-lock.json`
 * pins into the package cache, where the compiler reads them
 * (docs/design/package-manager.md, "Fetching and verification").
 *
 * Each pinned release is fetched from its package's PDS and checked
 * against the CIDs the lockfile pins; see `package-manager/fetch`.
 * Packages already in the cache cost no requests. `ZENA_PLC_DIRECTORY`
 * replaces the PLC directory, `https://plc.directory`, and
 * `ZENA_DNS_OVER_HTTPS` the DNS-over-HTTPS endpoint handles are resolved
 * with, for mirrors and tests.
 */

import { ParsedArgs } from 'zena:args';
import { Future } from 'zena:async';
import { getEnv } from 'zena:cli';
import { exists, readFile } from 'zena:fs';
import { IdentityResolver } from 'atproto/identity';
import { PackageCache } from 'package-manager/cache';
import { FetchResult, fetchAll } from 'package-manager/fetch';
import { Pin, readPins } from 'package-manager/resolution';
import { StepKind } from 'zena-lang:terminal/layout';
import { Output } from 'zena-lang:terminal/output';
import { packageCacheDir } from '../compile.zena';
import { Options } from '../env.zena';

export async function fetchCommand(args: ParsedArgs, options: Options): Future<i32> {
  let output = new Output();
  output.intro('zena pkg fetch');
  return await output.run(() => fetchPinned(options, output));
}

async function fetchPinned(options: Options, output: Output): Future<i32> {
  if (!(await exists('zena-lock.json'))) {
    output.outro('Nothing to fetch: there is no zena-lock.json here.');
    return 0;
  }
  let pins = readPins(await readFile('zena-lock.json'));
  if (pins.length == 0) {
    output.outro('Nothing to fetch: zena-lock.json pins no packages.');
    return 0;
  }
  let failed = await fetchAndReport(pins, options, output);
  if (failed > 0) {
    return output.fail(`${countOf(failed, 'package')} could not be fetched.`);
  }
  output.outro('The packages zena-lock.json pins are in the cache.');
  return 0;
}

/** `count` and `noun`, plural unless `count` is 1: `2 packages`. */
export function countOf(count: i32, noun: String): String {
  return if (count == 1) `1 ${noun}` else `${count} ${noun}s`;
}

/**
 * Resolves DIDs and handles, with the PLC directory from
 * `ZENA_PLC_DIRECTORY` and the DNS-over-HTTPS endpoint from
 * `ZENA_DNS_OVER_HTTPS` when they are set, for mirrors and tests.
 */
export function packageResolver(): IdentityResolver {
  let resolver = new IdentityResolver();
  let plcDirectory = getEnv('ZENA_PLC_DIRECTORY');
  if (plcDirectory != null && plcDirectory != '') {
    resolver.plcDirectory = plcDirectory;
  }
  let dnsOverHttps = getEnv('ZENA_DNS_OVER_HTTPS');
  if (dnsOverHttps != null && dnsOverHttps != '') {
    resolver.dnsOverHttps = dnsOverHttps;
  }
  return resolver;
}

/**
 * Fetches `pins` into the package cache and prints what happened: a step
 * counting them, the packages fetched under it (the cached ones too, with
 * `--verbose`), and an error for each that failed. Returns how many
 * failed.
 */
export async function fetchAndReport(pins: GrowableArray<Pin>, options: Options,
    output: Output): Future<i32> {
  let cache = new PackageCache(packageCacheDir());
  let results = await output.waitFor<GrowableArray<FetchResult>>(
      `Fetching ${countOf(pins.length, 'package')}`, fetchAll(pins, cache, packageResolver()));

  var fetched = 0;
  var failed = 0;
  var listed = '';
  for (let result in results) {
    let line = result.pin.key;
    if (result.error != null) {
      failed += 1;
    } else if (result.fetched) {
      listed = `${listed}Fetched ${line}\n`;
      fetched += 1;
    } else if (options.verbose) {
      listed = `${listed}Cached ${line}\n`;
    }
  }
  let cached = results.length - fetched - failed;
  output.step(`${countOf(results.length, 'package')}:`,
      `${fetched} fetched, ${cached} already in the cache, ${failed} failed`,
      if (failed > 0) StepKind.Error else StepKind.Success);
  if (listed != '') {
    output.lines(listed);
  }
  for (let result in results) {
    let error = result.error;
    if (error != null) {
      output.error(error);
    }
  }
  return failed;
}
