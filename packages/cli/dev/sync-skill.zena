/**
 * Writes the copy of the skill's sections in `AGENTS.md`
 * (`dev/skill-section.zena`): `npm run skill`, after changing
 * `skills/zena/SKILL.md`.
 */

import {Future} from 'zena:async';
import {readFile, writeFile} from 'zena:fs';
import {AGENTS_FILE, SKILL_FILE, agentsSection, withSection} from './skill-section.zena';

export async function main(): Future<i32> {
  let section = agentsSection(await readFile(SKILL_FILE));
  await writeFile(AGENTS_FILE, withSection(await readFile(AGENTS_FILE), section));
  console.log(`wrote ${AGENTS_FILE}`);
  return 0;
}
