/**
 * Changing who belongs, from end to end, against
 * `tests/fixtures/publish-stack.zena`: Alice creates a scope and a package,
 * adds Bob to the scope's maintainers, makes the scope an organization with
 * Bob as a member and on a team, gives the team the package, and Bob
 * publishes it until the team loses it.
 */

import {suite, test} from 'zena:test';
import {isTrue} from 'zena:assert';
import {JsonObject, parseJson} from 'zena:json';
import {Scratch, ZenaCommand, described, ensureDir, fakePdsOrigin, read, startFakePds, stopFakePds, write} from './cli-support.zena';

let ALICE = 'did:plc:alicealicealicealicealic';
let BOB = 'did:plc:bobbobbobbobbobbobbobbob';
let MALLORY = 'did:plc:mallorymallorymallorymal';

export let tests = suite('zena pkg scope, org, team and owner', () => {
  test('adds people to a scope, an organization, a team and a package, and takes them away', async (ctx) => {
    let scratch = await Scratch.create('membership');
    let stack = await startFakePds(scratch, 'publish-stack.zena');
    try {
      await fakePdsOrigin(scratch, stack);
      let addresses = parseJson(await read(scratch.at('pds/stack.json'))) as JsonObject;
      // Each person signs in with a configuration directory of their own.
      let person = (who: String, dir: String) =>
        new ZenaCommand(scratch.at(dir), scratch.host('cache'))
          .set('ZENA_PLC_DIRECTORY', addresses['plc'] as String)
          .set('ZENA_DNS_OVER_HTTPS', addresses['dns'] as String)
          .set('ZENA_REGISTRY', addresses['registry'] as String)
          .set('ZENA_CONFIG_DIR', scratch.host(`config-${who}`));

      await write(scratch.at('lib/zena-package.json'), '{"name": "acme:greet", "description": "A package for tests", "license": "MIT", "version": "1.0.0"}\n');
      await write(scratch.at('lib/greet.zena'), 'export function answer(): i32 { return 42; }\n');
      let alice = person('alice', 'lib');
      let bob = person('bob', 'lib');
      isTrue((await alice.run(['pkg', 'login', ALICE, '--password-stdin'], 'app-password\n')).succeeded(), 'alice signs in');
      isTrue((await bob.run(['pkg', 'login', BOB, '--password-stdin'], 'bob-password\n')).succeeded(), 'bob signs in');
      let scope = await alice.run(['pkg', 'scope', 'create', 'acme', '--yes']);
      isTrue(scope.succeeded(), described(scope));
      let published = await alice.run(['pkg', 'publish', '--yes']);
      isTrue(published.succeeded(), described(published));
      let did = (parseJson(await read(scratch.at('lib/zena-package.json'))) as JsonObject)['did'] as String;
      let manifestAt = async (version: String) => await write(scratch.at('lib/zena-package.json'),
          `{"name": "acme:greet", "description": "A package for tests", "license": "MIT", "did": "${did}", "version": "${version}"}\n`);

      // Alice is the only maintainer; Bob, who is none, sees no one and can
      // change nothing.
      let maintainers = await alice.run(['pkg', 'scope', 'maintainers', 'acme']);
      isTrue(maintainers.succeeded() && maintainers.stdout.contains(`${ALICE}  owner`) &&
          maintainers.stdout.contains("Changes to acme's maintainers and policy need 1 owner."), described(maintainers));
      let outsider = await bob.run(['pkg', 'scope', 'add', 'acme', BOB, '--role', 'owner']);
      isTrue(!outsider.succeeded() && outsider.stderr.contains('cannot change it'), described(outsider));
      let badRole = await alice.run(['pkg', 'scope', 'add', 'acme', BOB, '--role', 'member']);
      isTrue(!badRole.succeeded() && badRole.stderr.contains('not a role'), described(badRole));

      // Alice says how the scope presents itself; Bob, no owner, cannot.
      let profile = await alice.run(['pkg', 'scope', 'profile', 'acme', '--name', 'Acme Corp', '--website', 'https://acme.example/']);
      isTrue(profile.succeeded() && profile.stdout.contains('Changed the profile of acme'), described(profile));
      let info = await alice.run(['pkg', 'scope', 'info', 'acme']);
      isTrue(info.succeeded() && info.stdout.contains('Name: Acme Corp') &&
          info.stdout.contains('Website: https://acme.example/'), described(info));
      let badSite = await alice.run(['pkg', 'scope', 'profile', 'acme', '--website', 'javascript:alert(1)']);
      isTrue(!badSite.succeeded() && badSite.stderr.contains('not an http: or https: URL') &&
          !badSite.stderr.contains('backtrace'), described(badSite));
      let notOwner = await bob.run(['pkg', 'scope', 'profile', 'acme', '--name', 'Bob Corp']);
      isTrue(!notOwner.succeeded() && notOwner.stderr.contains('Forbidden'), described(notOwner));

      // Alice adds Bob as a publisher, who sees his own entry, and Alice's as
      // private.
      let added = await alice.run(['pkg', 'scope', 'add', 'acme', BOB]);
      isTrue(added.succeeded() && added.stdout.contains(`Added ${BOB} to acme as publisher`), described(added));
      let seen = await bob.run(['pkg', 'scope', 'maintainers', 'acme']);
      isTrue(seen.succeeded() && seen.stdout.contains(`${BOB}  publisher`) && !seen.stdout.contains(ALICE) &&
          seen.stdout.contains('(private)  owner'), described(seen));
      // Alice's own attestation was enough, so nothing waits.
      let nothing = await alice.run(['pkg', 'approve', 'acme']);
      isTrue(!nothing.succeeded() && nothing.stderr.contains('no change to acme is waiting for approval'),
          described(nothing));

      // A scope has no members until it is an organization, which only
      // an owner makes it.
      let noOrg = await alice.run(['pkg', 'org', 'add', 'acme', BOB]);
      isTrue(!noOrg.succeeded() && noOrg.stderr.contains('zena pkg scope upgrade acme'), described(noOrg));
      let asked = await alice.run(['pkg', 'scope', 'upgrade', 'acme']);
      isTrue(!asked.succeeded() && asked.stderr.contains('Run again with --yes'), described(asked));
      let byPublisher = await bob.run(['pkg', 'scope', 'upgrade', 'acme', '--yes']);
      isTrue(!byPublisher.succeeded() && byPublisher.stderr.contains('Forbidden'), described(byPublisher));
      let upgraded = await alice.run(['pkg', 'scope', 'upgrade', 'acme', '--yes']);
      isTrue(upgraded.succeeded() && upgraded.stdout.contains('acme is an organization'), described(upgraded));
      let joined = await alice.run(['pkg', 'org', 'add', 'acme', BOB]);
      isTrue(joined.succeeded() && joined.stdout.contains(`Added ${BOB} to acme.`), described(joined));
      let orgMembers = await alice.run(['pkg', 'org', 'members', 'acme']);
      isTrue(orgMembers.succeeded() && orgMembers.stdout.contains(`${ALICE}  member`) &&
          orgMembers.stdout.contains(`${BOB}  member`), described(orgMembers));

      // Bob's own scope joins acme once Alice, its owner, approves too, and
      // either of them takes it out.
      isTrue((await bob.run(['pkg', 'scope', 'create', 'bobs', '--yes'])).succeeded(), 'bob makes bobs');
      let joining = await bob.run(['pkg', 'scope', 'join', 'bobs', 'acme']);
      isTrue(joining.succeeded() && joining.stdout.contains('The change to the organization of bobs is waiting') &&
          joining.stdout.contains('and approved by 0 of the 1 owners of the organization'), described(joining));
      let request = await alice.run(['pkg', 'approve', 'bobs']);
      isTrue(request.succeeded() && request.stdout.contains('organization: none → did:plc:'), described(request));
      let accepted = await alice.run(['pkg', 'approve', 'bobs', '--yes']);
      isTrue(accepted.succeeded() && accepted.stdout.contains('Changed the organization of bobs'), described(accepted));
      let inAcme = await bob.run(['pkg', 'scope', 'info', 'bobs']);
      isTrue(inAcme.succeeded() && inAcme.stdout.contains('Part of the organization: acme.pkg.test'), described(inAcme));
      let out = await alice.run(['pkg', 'scope', 'leave', 'bobs']);
      isTrue(out.succeeded() && out.stdout.contains('bobs belongs to no organization now'), described(out));
      let alone = await bob.run(['pkg', 'scope', 'leave', 'bobs']);
      isTrue(!alone.succeeded() && alone.stderr.contains('belongs to no organization'), described(alone));

      // A team, with Bob on it, publishes the package.
      let team = await alice.run(['pkg', 'team', 'create', 'acme/core']);
      isTrue(team.succeeded() && team.stdout.contains('Created the team acme/core'), described(team));
      let teamSettings = await alice.run(['pkg', 'team', 'settings', 'acme/core', '--threshold', '2']);
      isTrue(teamSettings.succeeded() &&
          teamSettings.stdout.contains('Changes to the team acme/core need 2 of its maintainers, or the owners of acme'),
          described(teamSettings));
      let onTeam = await alice.run(['pkg', 'team', 'add', 'acme/core', BOB]);
      isTrue(onTeam.succeeded(), described(onTeam));
      let teamMembers = await bob.run(['pkg', 'team', 'members', 'acme/core']);
      isTrue(teamMembers.succeeded() && teamMembers.stdout.contains(`${BOB}  member`), described(teamMembers));
      let notYet = await bob.run(['pkg', 'publish']);
      isTrue(!notYet.succeeded(), described(notYet));
      let given = await alice.run(['pkg', 'owner', 'add', '--team', 'acme/core']);
      isTrue(given.succeeded() && given.stdout.contains('Added the team acme/core'), described(given));
      let owners = await alice.run(['pkg', 'owner', 'list']);
      isTrue(owners.succeeded() && owners.stdout.contains(`${ALICE}  owner`) &&
          owners.stdout.contains('the team core of did:plc:') && owners.stdout.contains('publisher'), described(owners));

      await manifestAt('1.1.0');
      let byBob = await bob.run(['pkg', 'publish']);
      isTrue(byBob.succeeded() && byBob.stdout.contains('Published greet 1.1.0'), described(byBob));
      // As a publisher, Bob does not choose the package's maintainers.
      let publisher = await bob.run(['pkg', 'owner', 'add', ALICE, '--role', 'owner']);
      isTrue(!publisher.succeeded() && publisher.stderr.contains('Forbidden'), described(publisher));

      // Taken away: the team loses the package, and Bob the organization
      // and the scope.
      let taken = await alice.run(['pkg', 'owner', 'remove', '--team', 'acme/core']);
      isTrue(taken.succeeded(), described(taken));
      await manifestAt('1.2.0');
      let refused = await bob.run(['pkg', 'publish']);
      isTrue(!refused.succeeded() && refused.stderr.contains('Forbidden'), described(refused));
      let deleted = await alice.run(['pkg', 'team', 'delete', 'acme/core']);
      isTrue(deleted.succeeded(), described(deleted));
      let left = await alice.run(['pkg', 'org', 'remove', 'acme', BOB]);
      isTrue(left.succeeded() && left.stdout.contains(`Removed ${BOB} from acme.`), described(left));
      let noLonger = await bob.run(['pkg', 'org', 'members', 'acme']);
      isTrue(noLonger.succeeded() && noLonger.stdout.contains('none you can see'), described(noLonger));
      // The last owner stays: the registry refuses a record with none.
      let lastOwner = await alice.run(['pkg', 'scope', 'remove', 'acme', ALICE]);
      isTrue(!lastOwner.succeeded() && lastOwner.stderr.contains('too few for its owner threshold'),
          described(lastOwner));
      let removed = await alice.run(['pkg', 'scope', 'remove', 'acme', BOB]);
      isTrue(removed.succeeded(), described(removed));
      let gone = await bob.run(['pkg', 'scope', 'maintainers', 'acme']);
      isTrue(gone.succeeded() && !gone.stdout.contains(BOB), described(gone));
    } finally {
      await stopFakePds(stack);
      await scratch.remove();
    }
  });

  test('shows a handle only when it resolves back to the DID', async (ctx) => {
    let scratch = await Scratch.create('membership-handles');
    let stack = await startFakePds(scratch, 'publish-stack.zena');
    try {
      await fakePdsOrigin(scratch, stack);
      let addresses = parseJson(await read(scratch.at('pds/stack.json'))) as JsonObject;
      await ensureDir(scratch.at('work'));
      let alice = new ZenaCommand(scratch.at('work'), scratch.host('cache'))
          .set('ZENA_PLC_DIRECTORY', addresses['plc'] as String)
          .set('ZENA_DNS_OVER_HTTPS', addresses['dns'] as String)
          .set('ZENA_REGISTRY', addresses['registry'] as String)
          .set('ZENA_CONFIG_DIR', scratch.host('config'));
      isTrue((await alice.run(['pkg', 'login', ALICE, '--password-stdin'], 'app-password\n')).succeeded(), 'alice signs in');
      let scope = await alice.run(['pkg', 'scope', 'create', 'acme', '--yes']);
      isTrue(scope.succeeded(), described(scope));

      // Mallory's document claims the scope's handle, which resolves to the
      // scope. Listed as a maintainer, she is her DID alone.
      let added = await alice.run(['pkg', 'scope', 'add', 'acme', MALLORY]);
      isTrue(added.succeeded(), described(added));
      let maintainers = await alice.run(['pkg', 'scope', 'maintainers', 'acme']);
      isTrue(maintainers.succeeded() && maintainers.stdout.contains(`${MALLORY}  publisher`), described(maintainers));

      // The scope has its handle; Mallory, whose repository holds a scope
      // maintainers record too, does not.
      let info = await alice.run(['pkg', 'scope', 'info', 'acme']);
      isTrue(info.succeeded() && info.stdout.startsWith('acme.pkg.test\n'), described(info));
      let posing = await alice.run(['pkg', 'scope', 'info', MALLORY]);
      isTrue(posing.succeeded() && posing.stdout.startsWith('(no handle)\n') &&
          !posing.stdout.contains('acme.pkg.test'), described(posing));
    } finally {
      await stopFakePds(stack);
      await scratch.remove();
    }
  });
});
