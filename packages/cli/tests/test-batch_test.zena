/**
 * `zena test` compiles the files it runs on a shared compiler first
 * (`compileIntoCache`), and caches each module with the files its program
 * is made of. These check what that must not change: a cached module goes
 * stale when any file it reaches changes, including one that an earlier
 * compile on the same compiler read, which its own compile then found
 * loaded and never read; and a file that does not compile fails with its
 * own errors while the files beside it pass.
 */

import {suite, test} from 'zena:test';
import {isTrue} from 'zena:assert';
import {Scratch, described, write, zenaIn} from './cli-support.zena';

/** A test file asserting that `value()`, from `./<lib>.zena`, is 1. */
function valueTest(lib: String) {
  return "import { suite, test } from 'zena:test';\n" +
    "import { equal } from 'zena:assert';\n" +
    `import { value } from './${lib}.zena';\n\n` +
    "export let tests = suite('value', () => {\n" +
    "  test('is one', (ctx) => {\n    equal(value(), 1);\n  });\n});\n";
}

export let tests = suite('zena test: files compiled together', () => {
  test('a test goes stale when a file an earlier compile read changes', async (ctx) => {
    let scratch = await Scratch.create('test-batch-shared');
    try {
      await write(scratch.at('ws/shared.zena'), 'export function value(): i32 { return 1; }\n');
      await write(scratch.at('ws/a_test.zena'), valueTest('shared'));
      await write(scratch.at('ws/b_test.zena'), valueTest('shared'));
      // One copy compiles both, so the second compile finds shared.zena
      // already loaded and does not read it.
      let zena = zenaIn(scratch, 'ws').set('ZENA_TEST_PARALLELISM', '1');
      let first = await zena.run(['test', '*_test.zena']);
      isTrue(first.succeeded(), described(first));
      // A different size, so the edit shows even within the same second.
      await write(scratch.at('ws/shared.zena'), 'export function value(): i32 { return 10; }\n');
      let second = await zena.run(['test', '*_test.zena']);
      isTrue(!second.succeeded(), described(second));
      isTrue(second.stdout.contains('a_test.zena') && second.stdout.contains('b_test.zena') &&
          !second.stdout.contains('PASS'), described(second));
    } finally {
      await scratch.remove();
    }
  });

  test('a file that does not compile fails with its errors, and the rest pass', async (ctx) => {
    let scratch = await Scratch.create('test-batch-error');
    try {
      await write(scratch.at('ws/one.zena'), 'export function value(): i32 { return 1; }\n');
      await write(scratch.at('ws/a_test.zena'), valueTest('one'));
      await write(scratch.at('ws/b_test.zena'), valueTest('missing'));
      await write(scratch.at('ws/c_test.zena'), valueTest('one'));
      let zena = zenaIn(scratch, 'ws').set('ZENA_TEST_PARALLELISM', '1');
      let result = await zena.run(['test', '*_test.zena']);
      isTrue(!result.succeeded(), described(result));
      isTrue(result.stdout.contains('PASS') && result.stdout.contains('a_test.zena') &&
          result.stdout.contains('c_test.zena'), described(result));
      isTrue(result.stdout.contains('FAIL') && result.stdout.contains('missing.zena'), described(result));
      isTrue(result.stdout.contains('Test Summary: 2 passed, 1 failed'), described(result));
    } finally {
      await scratch.remove();
    }
  });

  test('bounded compile batches split larger suites and track shared dependencies', async (ctx) => {
    let scratch = await Scratch.create('test-batch-chunked');
    try {
      await write(scratch.at('ws/shared.zena'), 'export function value(): i32 { return 1; }\n');
      for (let name in ['a', 'b', 'c', 'd', 'e']) {
        await write(scratch.at(`ws/${name}_test.zena`), valueTest('shared'));
      }
      let zena = zenaIn(scratch, 'ws')
        .set('ZENA_TEST_PARALLELISM', '2')
        .set('ZENA_TEST_COMPILE_BATCH', '2');
      let first = await zena.run(['test', '*_test.zena']);
      isTrue(first.succeeded(), described(first));
      isTrue(first.stdout.contains('Test Summary: 5 passed, 0 failed'), described(first));

      await write(scratch.at('ws/shared.zena'), 'export function value(): i32 { return 20; }\n');
      let second = await zena.run(['test', '*_test.zena']);
      isTrue(!second.succeeded(), described(second));
      isTrue(second.stdout.contains('Test Summary: 0 passed, 5 failed'), described(second));
    } finally {
      await scratch.remove();
    }
  });

  test('concurrent zena:test packages pool stale files through the shared batcher', async (ctx) => {
    let scratch = await Scratch.create('test-batch-pooled');
    try {
      await write(
        scratch.at('ws/zena-package.json'),
        '{\n' +
        '  "workspace": { "packages": ["packages/a", "packages/b", "packages/c"] },\n' +
        '  "scripts": {\n' +
        '    "test": { "dependencies": ["./packages/a:test", "./packages/b:test", "./packages/c:test"] }\n' +
        '  }\n' +
        '}\n',
      );
      for (let pkg in ['a', 'b', 'c']) {
        await write(
          scratch.at(`ws/packages/${pkg}/zena-package.json`),
          `{\n  "name": "pkg-${pkg}",\n  "scripts": { "test": { "type": "zena:test", "tests": "test/*_test.zena" } }\n}\n`,
        );
        await write(
          scratch.at(`ws/packages/${pkg}/test/one_test.zena`),
          "import { suite, test } from 'zena:test';\n" +
          "import { equal } from 'zena:assert';\n" +
          `export let tests = suite('${pkg}', () => { test('ok', () => { equal(1, 1); }); });\n`,
        );
      }
      let zena = zenaIn(scratch, 'ws')
        .set('ZEBRA_PARALLEL', '3')
        .set('ZENA_TEST_PARALLELISM', '1')
        .set('ZENA_TEST_COMPILE_BATCH', '4');
      let result = await zena.run(['test']);
      isTrue(result.succeeded(), described(result));
    } finally {
      await scratch.remove();
    }
  });
});
