// The printer's precedence ranks must agree with the parser.
//
// `printer.zena` carries a rank per operator, because deciding where a
// parenthesis goes needs precedence as data, and the parser holds it as the
// shape of its call chain — `#parseTerm` calling `#parseFactor` is what makes
// `*` bind tighter than `+`. There is nothing there to import.
//
// So the ranks restate a fact the parser already encodes, and this file keeps
// the two honest. The expected order comes from `binaryOperatorRank` and the
// actual order is read back out of real parses, so neither side is written down
// twice: move a level in `parser.zena` without the table following, or reorder
// the table, and a pair fails here rather than reappearing later as a formatter
// that drops a parenthesis it needed.
import {suite, test, TestContext} from 'zena:test';
import {equal, isTrue} from 'zena:assert';
import {parse} from '../../../zena-compiler/zena/lib/parser.zena';
import {
  Node, Expression, VariableDeclaration, BinaryExpression, RangeExpression,
  AsExpression, UnaryExpression
} from '../../../zena-compiler/zena/lib/ast.zena';
import {binaryOperatorRank} from '../lib/printer.zena';

/** The initializer of `let x = <expr>;`. */
function initOf(source: String) {
  let module = parse(source, 'test.zena');
  let first = module.body[0];
  return if (let VariableDeclaration {init} = first) {
    init
  } else {
    throw new Error('expected a variable declaration: ' + source)
  };
}

/** The operator at the root of `let x = <expr>;`, or '' if it is not binary. */
function rootOperator(source: String) {
  return if (let BinaryExpression {operator} = initOf(source)) operator else '';
}

/** Every operator the printer's table ranks. */
function allOperators() {
  let ops = new Array<String>(23);
  for (let op in ['||', '??', '&&', '|', '^', '&', '==', '!=', '===', '!==',
      '<', '<=', '>', '>=', '<<', '>>', '>>>', '+', '-', '*', '/', '%', '**']) {
    ops.push(op);
  }
  return ops;
}

let tests = suite('precedence agreement', () => {
  test('every ranked pair binds the way the parser groups it', (t) => {
    // For each pair the table calls distinct, the looser operator must end up
    // at the root of `a <looser> b <tighter> c`, with the tighter one gathered
    // into its right operand. Same-rank pairs are skipped: they associate
    // rather than nest, and the two associativity tests below cover that.
    let ops = allOperators();
    var compared = 0;
    for (let looser in ops) {
      for (let tighter in ops) {
        if (binaryOperatorRank(looser) < binaryOperatorRank(tighter)) {
          let source = `let x = a ${looser} b ${tighter} c;`;
          equal(rootOperator(source), looser, source);
          compared += 1;
        }
      }
    }
    // A guard on the loop itself: if the table collapsed to one rank, every
    // pair would be skipped and the test would pass having checked nothing.
    isTrue(compared > 100, 'the table distinguishes many pairs');
  });

  test('`??` shares a level with `||`', (t) => {
    // Both are read by `#parseLogicalOr`, so they associate left to right
    // instead of one binding tighter.
    equal(binaryOperatorRank('??'), binaryOperatorRank('||'), 'same rank');
    equal(rootOperator('let x = a ?? b || c;'), '||', 'left to right');
  });

  test('a binary operator is left associative', (t) => {
    // `a - b - c` is `(a - b) - c`, so the nested operand is the left one.
    let expr = initOf('let x = a - b - c;');
    let leftIsNested = if (let BinaryExpression {left} = expr) {
      left is BinaryExpression
    } else {
      false
    };
    isTrue(leftIsNested, '`-` nests on the left');
  });

  test('`**` is right associative', (t) => {
    // `a ** b ** c` is `a ** (b ** c)`, which is why the printer must not
    // flatten its left spine.
    let expr = initOf('let x = a ** b ** c;');
    let rightIsNested = if (let BinaryExpression {right} = expr) {
      right is BinaryExpression
    } else {
      false
    };
    isTrue(rightIsNested, '`**` nests on the right');
  });

  // `..`, `as` and prefix `-` are not `BinaryExpression`s, so the table ranks
  // them by node kind and the parser places them by tree shape.
  test('`..` is looser than `as`, which is looser than `+`', (t) => {
    let expr = initOf('let x = a + b..c as T;');
    let shape = if (let RangeExpression {start, end} = expr) {
      let startIsSum = if (let BinaryExpression {operator} = start as Node) {
        operator == '+'
      } else {
        false
      };
      let endIsCast = end as Node is AsExpression;
      startIsSum && endIsCast
    } else {
      false
    };
    isTrue(shape, '`..` is the root, with a sum on its left and a cast right');
  });

  test('prefix `-` binds tighter than any binary operator', (t) => {
    let expr = initOf('let x = -a + b;');
    let shape = if (let BinaryExpression {operator, left} = expr) {
      let leftIsNegation = if (let UnaryExpression {prefix} = left) {
        prefix
      } else {
        false
      };
      operator == '+' && leftIsNegation
    } else {
      false
    };
    isTrue(shape, '`+` is the root and its left operand is the negation');
  });
});

export function main(): i32 {
  let result = tests.run();
  for (let tr in result.tests) {
    if (!tr.passed) {
      console.log('FAIL: ' + tr.name);
      if (tr.error !== null) {
        console.log('  error: ' + tr.error);
      }
    }
  }
  return result.failed;
}
