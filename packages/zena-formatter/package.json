{
  "name": "@zena-lang/zena-formatter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wireit"
  },
  "wireit": {
    "test": {
      "command": "../../target/release/zena-cli test \"test/*_test.zena\"",
      "files": [
        "src/**/*.zena",
        "test/**/*.zena",
        "../zena-compiler/zena/lib/**/*.zena",
        "../wit-parser/src/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../../tests/language/**/*.zena",
        "../../zena-package.json",
        "zena-package.json",
        "../zena-compiler/zena-package.json",
        "../wit-parser/zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "../zena-cli:build"
      ]
    }
  },
  "devDependencies": {
    "wireit": "^0.14.4"
  }
}
