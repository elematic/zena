{
  "locks": ["zena-lock.json", "package-lock.json"],
  "scripts": {
    "build": {
      "dependencies": ["build:typecheck", "build:bundle"]
    },
    "build:typecheck": {
      "command": "tsc",
      "dependencies": ["../runtime:build", "../language-service:build:ts"],
      "files": ["src/**/*.ts", "tsconfig.json"],
      "output": ["tsconfig.tsbuildinfo"]
    },
    "build:bundle": {
      "command": "node scripts/bundle.js",
      "dependencies": [
        "../runtime:build",
        "../language-service:build",
        "../stdlib:build"
      ],
      "files": [
        "scripts/bundle.js",
        "src/**/*.ts",
        "../stdlib/zena/**/*.zena",
        "../language-service/lsp.wasm"
      ],
      "output": [
        "dist/extension.cjs",
        "dist/extension.cjs.map",
        "dist/lsp.wasm"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "command": "node --test src/test/*_test.ts",
      "dependencies": ["build"],
      "files": [
        "src/test/**/*.ts",
        "package.json",
        ".vscodeignore",
        "LICENSE",
        "CHANGELOG.md",
        "README.md",
        "language-configuration.json",
        "syntaxes/**/*.json"
      ],
      "output": []
    },
    "package": "npm run build && vsce package --no-dependencies -o vscode-zena.vsix",
    "install-ext": "npm run package && code --install-extension \"$PWD/vscode-zena.vsix\""
  }
}
