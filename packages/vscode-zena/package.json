{
  "name": "vscode-zena",
  "displayName": "Zena Language",
  "description": "Language support for the Zena programming language",
  "version": "0.1.0",
  "publisher": "zena-lang",
  "type": "module",
  "engines": {
    "vscode": "^1.115.0"
  },
  "main": "./dist/extension.cjs",
  "browser": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:zena"
  ],
  "homepage": "https://zena-lang.dev",
  "bugs": {
    "url": "https://github.com/elematic/zena/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elematic/zena.git",
    "directory": "packages/vscode-zena"
  },
  "keywords": [
    "zena",
    "wasm",
    "webassembly"
  ],
  "license": "MIT",
  "scripts": {
    "build": "wireit",
    "build:typecheck": "wireit",
    "build:bundle": "wireit",
    "test": "wireit",
    "package": "npm run build && vsce package --no-dependencies -o vscode-zena.vsix",
    "install-ext": "npm run package && code --install-extension \"$PWD/vscode-zena.vsix\""
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:typecheck",
        "build:bundle"
      ]
    },
    "build:typecheck": {
      "command": "tsc",
      "dependencies": [
        "../runtime:build",
        "../language-service:build:ts"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "tsconfig.tsbuildinfo"
      ]
    },
    "build:bundle": {
      "command": "node scripts/bundle.js",
      "dependencies": [
        "../runtime:build",
        "../language-service:build",
        "../stdlib:build"
      ],
      "files": [
        "scripts/bundle.js",
        "src/**/*.ts",
        "../stdlib/zena/**/*.zena",
        "../language-service/lsp.wasm"
      ],
      "output": [
        "dist/extension.cjs",
        "dist/extension.cjs.map",
        "dist/lsp.wasm"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "command": "node --test src/test/*_test.ts",
      "dependencies": [
        "build"
      ],
      "files": [
        "src/test/**/*.ts",
        "package.json",
        ".vscodeignore",
        "LICENSE",
        "CHANGELOG.md",
        "README.md",
        "language-configuration.json",
        "syntaxes/**/*.json"
      ],
      "output": []
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/vscode": "^1.115.0",
    "@vscode/vsce": "^4.0.0",
    "@zena-lang/language-service": "^0.0.1",
    "@zena-lang/runtime": "^0.0.1",
    "esbuild": "^0.28.2",
    "ovsx": "^1.4.0",
    "typescript": "^7.0.2",
    "wireit": "^0.14.4"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zena",
        "aliases": [
          "Zena",
          "zena"
        ],
        "extensions": [
          ".zena"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "zena.helloWorld",
        "title": "Hello World",
        "category": "Zena"
      },
      {
        "command": "zena.fixLint",
        "title": "Fix lint findings in file",
        "category": "Zena"
      },
      {
        "command": "zena.showOutput",
        "title": "Show Output",
        "category": "Zena"
      }
    ],
    "grammars": [
      {
        "language": "zena",
        "scopeName": "source.zena",
        "path": "./syntaxes/zena.tmLanguage.json"
      },
      {
        "scopeName": "text.html.markdown.zena.codeblock",
        "path": "./syntaxes/zena-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.zena": "zena"
        }
      }
    ]
  }
}
