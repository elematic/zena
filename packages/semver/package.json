{
  "name": "@zena-lang/semver",
  "version": "0.0.1",
  "type": "module",
  "description": "Semantic versions and npm's version ranges, for Zena",
  "private": true,
  "scripts": {
    "test": "wireit"
  },
  "wireit": {
    "test": {
      "#command": "Runs from the repository root, where the compiler finds the package map.",
      "command": "cd ../.. && ./target/release/zena-cli test \"packages/semver/test/*_test.zena\"",
      "dependencies": [
        "../zena-cli:build",
        "../stdlib:lib"
      ],
      "files": [
        "src/**/*.zena",
        "test/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../../zena-package.json",
        "zena-package.json"
      ],
      "output": []
    }
  }
}
