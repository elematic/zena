/**
 * ZenaFX Platform Component (`zenafx:platform@0.1.0`).
 *
 * Implements the logical UI scene graph above the minimal Rust native core
 * (`zenafx:core/render@0.1.0`): templates, bindings, holes, slots (flattened
 * into concrete render-tree child lists), detached nodes, the full property /
 * fact / condition / stylesheet engine (`style.zena`), legacy `state-style`
 * compatibility, and logical pointer/keyboard event routing.
 */
import {
  Cursor, LayoutFlex, LayoutFlow, NodeStyleFill, NodeStyleText,
  TextContent, TextSelection, WatchFlags,
  CreateOp, BoxOp, LayoutOp, StyleOp, ContentOp, TextStyleOp, CursorOp,
  InteractionOp, WatchedOp,
  RenderOp, RenderOpCreate, RenderOpRemove, RenderOpSetRoot,
  RenderOpSetBox, RenderOpSetLayout, RenderOpSetStyle, RenderOpSetContent,
  RenderOpSetTextStyle, RenderOpSetCursor, RenderOpSetInteraction,
  RenderOpSetWatched,
  CoreEvent, CoreEventHoverTarget, CoreEventPressTarget, CoreEventFocusTarget,
  CoreEventSizesChanged, CoreEventScrollChanged,
  selection as coreSelection, select as coreSelect,
} from 'zenafx:core/render';
import {
  BindingValueContent, BindingValueStyle, BindingValueTextStyle,
  BindingValueBox, BindingValueLayout,
  Condition, Declaration, FactKind, Hole, NodeDef, Phase, PointerEvent,
  PointerKind, PropertyDef, Reach, Scope, StyleKey, StyleValue, StylesheetDef,
  TemplateDef, TemplateRef, TemplateRefKnown, TemplateRefFresh,
  Call, Delivery, WatcherUpdate,
} from 'zenafx:platform/runtime';
import { GrowableArray, HashMap } from 'zena:collections';
import { Option, Some, some, none } from 'zena:core';
import {
  Interior, LogicalNode, ResolvedStateOverride, PointerListenerReg,
  KeyListenerReg, rootLogicalId, hoveredLogical, pressedLogical,
  focusedLogical, lastHoverLogical, nodes, renderToLogical, templates,
  listenerOwner, endedListeners, styledNodes,
  setHoveredLogical, setPressedLogical, setFocusedLogical,
  setLastHoverLogical, setRootLogicalId,
  allocLogicalId, allocRenderId, getNode, resolveTarget, logicalForRender,
  logicalForRenderId, flushOps, makeRenderDef, nearestRenderLogical,
  isAtOrBeneath, stateBit, addWatchFlag, computeLegacyActiveStyle,
  emitFlatChildren, localCoords, copyU32Array, nodeStyleEqual,
} from './tree.zena';
import {
  styleEngineActive, markStyleEngineActive, definePropertyDef, defineFactKind,
  defineStylesheetDef, declsWatchBits, attachStylesheetToNode,
  detachStylesheetFromNode, refreshStyleTree, refreshFromNode,
  applyInheritedScopeWatchBits, queryResolvedProperty,
  registerConditionWatcher, registerPropertyWatcher, removeWatcher,
  recordEndedWatchersForNode, drainWatcherUpdates,
} from './style.zena';

// ============================================================================
// Internal Helpers
// ============================================================================

function inheritedCursor(parentId: u32) {
  let p = getNode(parentId);
  return p?.resolvedCursor ?? Cursor.Default;
}

function inheritedUnselectable(parentId: u32): boolean {
  let p = getNode(parentId);
  return p?.resolvedUnselectable ?? false;
}

function updateLegacyInherited(node: LogicalNode, ops: GrowableArray<RenderOp>): void {
  let nextCursor = if (let Some { value } = node.ownCursor) {
    value
  } else {
    inheritedCursor(node.parent)
  };
  let nextUnsel = node.ownUnselectable || inheritedUnselectable(node.parent);
  let cursorChanged = nextCursor != node.resolvedCursor;
  let unselChanged = nextUnsel != node.resolvedUnselectable;
  node.resolvedCursor = nextCursor;
  node.resolvedUnselectable = nextUnsel;

  if (!node.isSlot && node.renderId != (0 as u32)) {
    if (cursorChanged) {
      ops.push(new RenderOpSetCursor(new CursorOp(node.renderId, nextCursor)));
    }
    if (unselChanged) {
      ops.push(new RenderOpSetInteraction(new InteractionOp(
        node.renderId,
        node.focusable,
        node.editable,
        nextUnsel,
      )));
    }
  }
  if (cursorChanged || unselChanged) {
    for (var i = 0; i < node.children.length; i += 1) {
      let c = getNode(node.children[i]);
      if (c != null) {
        updateLegacyInherited(c, ops);
      }
    }
  }
}

function refreshLegacyStyledNodes(ops: GrowableArray<RenderOp>) {
  var changed = false;
  let live = new GrowableArray<u32>();
  for (let id in styledNodes) {
    let n = getNode(id);
    if (n == null) {
      continue;
    }
    let node = n;
    if (node.stateStyles.length == 0) {
      continue;
    }
    live.push(id);
    if (node.isSlot || node.renderId == (0 as u32)) {
      continue;
    }
    let next = computeLegacyActiveStyle(node);
    if (!nodeStyleEqual(next, node.activeStyle)) {
      node.activeStyle = next;
      ops.push(new RenderOpSetStyle(new StyleOp(node.renderId, next)));
      changed = true;
    }
  }
  styledNodes.clear();
  for (let id in live) {
    styledNodes.push(id);
  }
  return changed;
}

function recordEndedListeners(node: LogicalNode) {
  for (var i = 0; i < node.pointerListeners.length; i += 1) {
    let lid = node.pointerListeners[i].id;
    listenerOwner.delete(lid);
    endedListeners.push(lid);
  }
  node.pointerListeners.clear();
  for (var i = 0; i < node.keyListeners.length; i += 1) {
    let lid = node.keyListeners[i].id;
    listenerOwner.delete(lid);
    endedListeners.push(lid);
  }
  node.keyListeners.clear();
}

/** Drop a logical subtree (and its render nodes), detaching guest-owned children. */
function dropSubtree(id: u32, forceDropGuestOwned: boolean, ops: GrowableArray<RenderOp>): void {
  let n = getNode(id);
  if (n == null) {
    return;
  }
  let node = n;
  if (node.guestOwned && !forceDropGuestOwned) {
    node.parent = 0 as u32;
    node.slotIndex = -1;
    return;
  }
  let kids = node.children;
  for (var i = 0; i < kids.length; i += 1) {
    dropSubtree(kids[i], false, ops);
  }
  recordEndedListeners(node);
  recordEndedWatchersForNode(id);
  if (node.renderId != (0 as u32)) {
    renderToLogical.delete(node.renderId);
    ops.push(new RenderOpRemove(node.renderId));
  }
  nodes.delete(id);
}

function clearInterior(host: LogicalNode, ops: GrowableArray<RenderOp>) {
  let kids = host.children;
  for (let kid in kids) {
    dropSubtree(kid, false, ops);
  }
  host.children.clear();
  host.stateStyles.clear();
  if (host.watchedFlags != (0 as u32)) {
    host.watchedFlags = 0 as u32;
    if (!host.isSlot && host.renderId != (0 as u32)) {
      ops.push(new RenderOpSetWatched(new WatchedOp(host.renderId, 0 as WatchFlags)));
    }
  }
  recordEndedListeners(host);
  host.interior = null;
}

function applyNodeDef(node: LogicalNode, def: NodeDef, ops: GrowableArray<RenderOp>) {
  node.ownBox = def.box;
  node.flushedBox = def.box;
  node.layout = def.layout;
  node.flushedLayout = def.layout;
  node.baseStyle = def.style;
  node.activeStyle = def.style;
  node.ownCursor = def.cursor;
  node.focusable = def.focusable;
  node.editable = def.editable;
  node.ownUnselectable = def.unselectable;
  node.resolvedCursor = if (let Some { value } = def.cursor) {
    value
  } else {
    inheritedCursor(node.parent)
  };
  node.resolvedUnselectable = def.unselectable || inheritedUnselectable(node.parent);

  if (!node.isSlot && node.renderId != (0 as u32)) {
    ops.push(new RenderOpSetBox(new BoxOp(node.renderId, node.flushedBox)));
    ops.push(new RenderOpSetLayout(new LayoutOp(node.renderId, node.flushedLayout)));
    ops.push(new RenderOpSetStyle(new StyleOp(node.renderId, node.activeStyle)));
    ops.push(new RenderOpSetCursor(new CursorOp(node.renderId, node.resolvedCursor)));
    ops.push(new RenderOpSetInteraction(new InteractionOp(
      node.renderId,
      node.focusable,
      node.editable,
      node.resolvedUnselectable,
    )));
  }
}

function applyHole(
  interior: Interior,
  tpl: TemplateDef,
  hole: Hole,
  ops: GrowableArray<RenderOp>,
) {
  let bIdx = hole.binding as i32;
  if (bIdx < 0 || bIdx >= tpl.bindings.length) {
    return;
  }
  let binding = tpl.bindings[bIdx];
  let nIdx = binding.node as i32;
  if (nIdx < 0 || nIdx >= interior.nodes.length) {
    return;
  }
  let target = getNode(interior.nodes[nIdx]);
  if (target == null) {
    return;
  }
  let node = target;
  if (hole.value is BindingValueContent) {
    let text = (hole.value as BindingValueContent).value;
    if (node.baseStyle is NodeStyleText) {
      let old = (node.baseStyle as NodeStyleText).value;
      node.baseStyle = new NodeStyleText(new TextContent(text, old.style));
    }
    node.activeStyle = computeLegacyActiveStyle(node);
    if (!node.isSlot && node.renderId != (0 as u32)) {
      ops.push(new RenderOpSetContent(new ContentOp(node.renderId, text)));
    }
  } else if (hole.value is BindingValueStyle) {
    let bs = (hole.value as BindingValueStyle).value;
    node.baseStyle = new NodeStyleFill(bs);
    node.activeStyle = computeLegacyActiveStyle(node);
    if (!node.isSlot && node.renderId != (0 as u32)) {
      ops.push(new RenderOpSetStyle(new StyleOp(node.renderId, node.activeStyle)));
    }
  } else if (hole.value is BindingValueTextStyle) {
    let ts = (hole.value as BindingValueTextStyle).value;
    if (node.baseStyle is NodeStyleText) {
      let old = (node.baseStyle as NodeStyleText).value;
      node.baseStyle = new NodeStyleText(new TextContent(old.content, ts));
    }
    node.activeStyle = computeLegacyActiveStyle(node);
    if (!node.isSlot && node.renderId != (0 as u32)) {
      ops.push(new RenderOpSetTextStyle(new TextStyleOp(node.renderId, ts)));
    }
  } else if (hole.value is BindingValueBox) {
    let bx = (hole.value as BindingValueBox).value;
    node.ownBox = bx;
    node.flushedBox = bx;
    if (!node.isSlot && node.renderId != (0 as u32)) {
      ops.push(new RenderOpSetBox(new BoxOp(node.renderId, bx)));
    }
  } else if (hole.value is BindingValueLayout) {
    let lay = (hole.value as BindingValueLayout).value;
    let sameKind = (node.layout is LayoutFlex && lay is LayoutFlex)
      || (node.layout is LayoutFlow && lay is LayoutFlow);
    if (sameKind) {
      node.layout = lay;
      node.flushedLayout = lay;
      if (!node.isSlot && node.renderId != (0 as u32)) {
        ops.push(new RenderOpSetLayout(new LayoutOp(node.renderId, lay)));
      }
    }
  }
}

function findSlot(host: LogicalNode, slotIndex: u32): LogicalNode | null {
  let interior = host.interior;
  if (interior == null) {
    return null;
  }
  let intNodes = interior.nodes;
  var seen = 0 as u32;
  for (var i = 1; i < intNodes.length; i += 1) {
    let n = getNode(intNodes[i]);
    if (n != null && n.isSlot) {
      if (seen == slotIndex) {
        return n;
      }
      seen += 1 as u32;
    }
  }
  return null;
}

function logicalPath(leafId: u32) {
  let rev = new GrowableArray<u32>();
  var cur = leafId;
  while (cur != (0 as u32)) {
    rev.push(cur);
    let n = getNode(cur);
    if (n == null) {
      break;
    }
    cur = n.parent;
  }
  let out = new GrowableArray<u32>();
  var i = rev.length - 1;
  while (i >= 0) {
    out.push(rev[i]);
    i -= 1;
  }
  return out;
}

// ============================================================================
// Exported `zenafx:platform/runtime` Functions — Scene & Events
// ============================================================================

export function root(): u32 {
  if (rootLogicalId != (0 as u32)) {
    return rootLogicalId;
  }
  let id = allocLogicalId();
  let rid = allocRenderId();
  let node = new LogicalNode(id, rid, false, false);
  nodes[id] = node;
  renderToLogical[rid] = id;
  setRootLogicalId(id);

  let ops = new GrowableArray<RenderOp>();
  ops.push(new RenderOpCreate(new CreateOp(rid, makeRenderDef(node))));
  ops.push(new RenderOpSetRoot(some(rid)));
  flushOps(ops);
  return id;
}

export function createNode(): u32 {
  let id = allocLogicalId();
  let rid = allocRenderId();
  let node = new LogicalNode(id, rid, false, true);
  nodes[id] = node;
  renderToLogical[rid] = id;

  let ops = new GrowableArray<RenderOp>();
  ops.push(new RenderOpCreate(new CreateOp(rid, makeRenderDef(node))));
  flushOps(ops);
  return id;
}

export function dropNode(id: u32): boolean {
  let n = getNode(id);
  if (n == null) {
    return false;
  }
  let node = n;
  if (!node.guestOwned) {
    return false;
  }
  let ops = new GrowableArray<RenderOp>();
  let parentId = node.parent;
  if (parentId != (0 as u32)) {
    let p = getNode(parentId);
    if (p != null) {
      let parent = p;
      let nextKids = new GrowableArray<u32>();
      for (var i = 0; i < parent.children.length; i += 1) {
        if (parent.children[i] != id) {
          nextKids.push(parent.children[i]);
        }
      }
      parent.children = nextKids;
      if (parent.isSlot) {
        for (var i = 0; i < parent.children.length; i += 1) {
          let c = getNode(parent.children[i]);
          if (c != null) {
            c.slotIndex = i;
          }
        }
      }
      let boxAnc = nearestRenderLogical(parentId);
      if (boxAnc != null) {
        emitFlatChildren(boxAnc, ops);
      }
    }
  }
  dropSubtree(id, true, ops);
  if (styleEngineActive) {
    refreshStyleTree(ops);
  }
  flushOps(ops);
  return true;
}

export function render(id: u32, template: TemplateRef, holes: Array<Hole>): void {
  let hostOpt = getNode(id);
  if (hostOpt == null) {
    return;
  }
  let host = hostOpt;

  var tplId = 0 as u32;
  if (template is TemplateRefFresh) {
    let def = template.value;
    tplId = def.id;
    templates[tplId] = def;
  } else {
    tplId = (template as TemplateRefKnown).value;
  }
  var tpl: TemplateDef | null = null;
  if (let (true, found) = templates.get(tplId)) {
    tpl = found;
  }
  if (tpl == null) {
    return;
  }
  let tplDef = tpl;
  if (tplDef.nodes.length == 0) {
    return;
  }

  let ops = new GrowableArray<RenderOp>();
  let existing = host.interior;
  if (existing != null && existing.templateId == tplId) {
    let intObj = existing;
    for (var i = 0; i < holes.length; i += 1) {
      applyHole(intObj, tplDef, holes[i], ops);
    }
    if (styleEngineActive) {
      refreshFromNode(host, ops);
    }
    flushOps(ops);
    return;
  }

  // Build fresh interior.
  clearInterior(host, ops);

  let count = tplDef.nodes.length;
  let intNodes = new FixedArray<u32>(count, 0 as u32);
  intNodes[0] = host.id;

  applyNodeDef(host, tplDef.nodes[0], ops);

  for (var i = 1; i < count; i += 1) {
    let def = tplDef.nodes[i];
    let lid = allocLogicalId();
    let rid = if (def.isSlot) { 0 as u32 } else { allocRenderId() };
    let child = new LogicalNode(lid, rid, def.isSlot, false);
    child.interiorOwner = host.id;
    nodes[lid] = child;
    if (!def.isSlot) {
      renderToLogical[rid] = lid;
    }
    intNodes[i] = lid;
  }

  for (var i = 0; i < count; i += 1) {
    let def = tplDef.nodes[i];
    let parent = getNode(intNodes[i]) as LogicalNode;
    if (i > 0) {
      parent.ownBox = def.box;
      parent.flushedBox = def.box;
      parent.layout = def.layout;
      parent.flushedLayout = def.layout;
      parent.baseStyle = def.style;
      parent.activeStyle = def.style;
      parent.ownCursor = def.cursor;
      parent.focusable = def.focusable;
      parent.editable = def.editable;
      parent.ownUnselectable = def.unselectable;
      parent.resolvedCursor = if (let Some { value } = def.cursor) {
        value
      } else {
        inheritedCursor(parent.parent)
      };
      parent.resolvedUnselectable =
        def.unselectable || inheritedUnselectable(parent.parent);
      if (!parent.isSlot) {
        ops.push(new RenderOpCreate(new CreateOp(parent.renderId, makeRenderDef(parent))));
      }
    }
    let first = def.firstChild as i32;
    let cc = def.childCount as i32;
    for (var k = 0; k < cc; k += 1) {
      let cIdx = first + k;
      if (cIdx > i && cIdx < count) {
        let cid = intNodes[cIdx];
        parent.children.push(cid);
        let cn = getNode(cid) as LogicalNode;
        cn.parent = parent.id;
      }
    }
  }

  for (var i = 0; i < count; i += 1) {
    let n = getNode(intNodes[i]) as LogicalNode;
    if (!n.isSlot && (i == 0 || n.children.length > 0)) {
      emitFlatChildren(n, ops);
    }
  }

  let interior = new Interior(tplId, intNodes);
  host.interior = interior;

  for (let ss in tplDef.states) {
    let nIdx = ss.node as i32;
    let ofIdx = ss.of as i32;
    if (nIdx >= 0 && nIdx < count && ofIdx >= 0 && ofIdx < count) {
      let target = getNode(intNodes[nIdx]) as LogicalNode;
      let ofId = intNodes[ofIdx];
      if (target.stateStyles.length == 0) {
        styledNodes.push(target.id);
      }
      target.stateStyles.push(new ResolvedStateOverride(ss.when, ofId, ss.style));
      addWatchFlag(ofId, stateBit(ss.when), ops);
    }
  }

  for (var i = 0; i < holes.length; i += 1) {
    applyHole(interior, tplDef, holes[i], ops);
  }

  if (styleEngineActive) {
    for (var i = 0; i < count; i += 1) {
      let n = getNode(intNodes[i]);
      if (n != null) {
        applyInheritedScopeWatchBits(n, ops);
      }
    }
    refreshFromNode(host, ops);
  }

  flushOps(ops);
}

export function content(id: u32, slot: u32, count: u32): Option<Array<u32>> {
  let hostOpt = getNode(id);
  if (hostOpt == null) {
    return none;
  }
  let slotOpt = findSlot(hostOpt, slot);
  if (slotOpt == null) {
    return none;
  }
  let slotNode = slotOpt;
  let ops = new GrowableArray<RenderOp>();
  let target = count as i32;

  while (slotNode.children.length > target) {
    let last = slotNode.children[slotNode.children.length - 1];
    slotNode.children.pop();
    dropSubtree(last, false, ops);
  }

  while (slotNode.children.length < target) {
    let lid = allocLogicalId();
    let rid = allocRenderId();
    let child = new LogicalNode(lid, rid, false, false);
    child.parent = slotNode.id;
    child.slotIndex = slotNode.children.length;
    child.resolvedCursor = slotNode.resolvedCursor;
    child.resolvedUnselectable = slotNode.resolvedUnselectable;
    nodes[lid] = child;
    renderToLogical[rid] = lid;
    slotNode.children.push(lid);
    ops.push(new RenderOpCreate(new CreateOp(rid, makeRenderDef(child))));
    if (styleEngineActive) {
      applyInheritedScopeWatchBits(child, ops);
    }
  }

  let boxAnc = nearestRenderLogical(slotNode.parent);
  if (boxAnc != null) {
    emitFlatChildren(boxAnc, ops);
  }
  if (styleEngineActive) {
    refreshFromNode(hostOpt, ops);
  }
  flushOps(ops);

  let arr: Array<u32> = copyU32Array(slotNode.children);
  return some(arr);
}

export function setSlot(id: u32, slot: u32, children: Array<u32>): boolean {
  let hostOpt = getNode(id);
  if (hostOpt == null) {
    return false;
  }
  let slotOpt = findSlot(hostOpt, slot);
  if (slotOpt == null) {
    return false;
  }
  let slotNode = slotOpt;

  let seen = new HashMap<u32, boolean>();
  for (let cid in children) {
    if (seen.has(cid)) {
      return false;
    }
    seen[cid] = true;
    let cn = getNode(cid);
    if (cn == null || cn.isSlot) {
      return false;
    }
    if (isAtOrBeneath(slotNode.id, cid)) {
      return false;
    }
  }

  let ops = new GrowableArray<RenderOp>();

  for (let oldId in slotNode.children) {
    if (!seen.has(oldId)) {
      dropSubtree(oldId, false, ops);
    }
  }

  let dirtyParents = new GrowableArray<u32>();
  for (let cid in children) {
    let child = getNode(cid) as LogicalNode;
    if (child.parent != (0 as u32) && child.parent != slotNode.id) {
      let prev = getNode(child.parent);
      if (prev != null) {
        let pp = prev;
        let kept = new GrowableArray<u32>();
        for (var k = 0; k < pp.children.length; k += 1) {
          if (pp.children[k] != cid) {
            kept.push(pp.children[k]);
          }
        }
        pp.children = kept;
        if (pp.isSlot) {
          for (var k = 0; k < pp.children.length; k += 1) {
            let sc = getNode(pp.children[k]);
            if (sc != null) {
              sc.slotIndex = k;
            }
          }
        }
        dirtyParents.push(pp.id);
      }
    }
    child.parent = slotNode.id;
  }

  slotNode.children.clear();
  for (var i = 0; i < children.length; i += 1) {
    slotNode.children.push(children[i]);
    let child = getNode(children[i]) as LogicalNode;
    child.slotIndex = i;
    if (styleEngineActive) {
      applyInheritedScopeWatchBits(child, ops);
    } else {
      updateLegacyInherited(child, ops);
    }
  }

  for (var i = 0; i < dirtyParents.length; i += 1) {
    let boxAnc = nearestRenderLogical(dirtyParents[i]);
    if (boxAnc != null) {
      emitFlatChildren(boxAnc, ops);
    }
  }
  let targetBox = nearestRenderLogical(slotNode.parent);
  if (targetBox != null) {
    emitFlatChildren(targetBox, ops);
  }
  if (styleEngineActive) {
    refreshFromNode(hostOpt, ops);
  }
  flushOps(ops);
  return true;
}

export function takeEndedListeners(): Array<u32> {
  let out = copyU32Array(endedListeners);
  endedListeners.clear();
  return out;
}

export function listenPointer(
  id: u32,
  target: u32,
  listenerId: u32,
  kind: PointerKind,
  inScope: Scope,
  at: Phase,
): boolean {
  let hostOpt = getNode(id);
  if (hostOpt == null) {
    return false;
  }
  let interior = hostOpt.interior;
  if (interior == null) {
    return false;
  }
  let idx = target as i32;
  let intNodes = interior.nodes;
  if (idx < 0 || idx >= intNodes.length) {
    return false;
  }
  let targetNode = getNode(intNodes[idx]);
  if (targetNode == null) {
    return false;
  }
  let tn = targetNode;
  tn.pointerListeners.push(new PointerListenerReg(listenerId, kind, inScope, at));
  listenerOwner[listenerId] = tn.id;
  return true;
}

export function listenKeys(
  id: u32,
  target: u32,
  listenerId: u32,
  at: Phase,
): boolean {
  let hostOpt = getNode(id);
  if (hostOpt == null) {
    return false;
  }
  let interior = hostOpt.interior;
  if (interior == null) {
    return false;
  }
  let idx = target as i32;
  let intNodes = interior.nodes;
  if (idx < 0 || idx >= intNodes.length) {
    return false;
  }
  let targetNode = getNode(intNodes[idx]);
  if (targetNode == null) {
    return false;
  }
  let tn = targetNode;
  tn.keyListeners.push(new KeyListenerReg(listenerId, at));
  listenerOwner[listenerId] = tn.id;
  return true;
}

export function unlisten(listenerId: u32): void {
  if (let (true, ownerId) = listenerOwner.get(listenerId)) {
    listenerOwner.delete(listenerId);
    let n = getNode(ownerId);
    if (n == null) {
      return;
    }
    let node = n;
    let keptPtr = new GrowableArray<PointerListenerReg>();
    for (var i = 0; i < node.pointerListeners.length; i += 1) {
      if (node.pointerListeners[i].id != listenerId) {
        keptPtr.push(node.pointerListeners[i]);
      }
    }
    node.pointerListeners = keptPtr;

    let keptKey = new GrowableArray<KeyListenerReg>();
    for (var i = 0; i < node.keyListeners.length; i += 1) {
      if (node.keyListeners[i].id != listenerId) {
        keptKey.push(node.keyListeners[i]);
      }
    }
    node.keyListeners = keptKey;
  }
}

export function selection(id: u32, target: u32): Option<TextSelection> {
  let hostOpt = getNode(id);
  if (hostOpt == null) {
    return none;
  }
  let interior = hostOpt.interior;
  if (interior == null) {
    return none;
  }
  let idx = target as i32;
  let intNodes = interior.nodes;
  if (idx < 0 || idx >= intNodes.length) {
    return none;
  }
  let tn = getNode(intNodes[idx]);
  if (tn == null || tn.renderId == (0 as u32)) {
    return none;
  }
  return coreSelection(tn.renderId);
}

export function select(id: u32, target: u32, to: TextSelection): boolean {
  let hostOpt = getNode(id);
  if (hostOpt == null) {
    return false;
  }
  let interior = hostOpt.interior;
  if (interior == null) {
    return false;
  }
  let idx = target as i32;
  let intNodes = interior.nodes;
  if (idx < 0 || idx >= intNodes.length) {
    return false;
  }
  let tn = getNode(intNodes[idx]);
  if (tn == null || tn.renderId == (0 as u32) || !(tn.baseStyle is NodeStyleText)) {
    return false;
  }
  coreSelect(tn.renderId, to);
  return true;
}

export function onCoreEvents(events: Array<CoreEvent>): boolean {
  var stateChanged = false;
  for (let ev in events) {
    if (ev is CoreEventHoverTarget) {
      let next = logicalForRender(ev.value);
      if (next != hoveredLogical) {
        setHoveredLogical(next);
        stateChanged = true;
      }
    } else if (ev is CoreEventPressTarget) {
      let next = logicalForRender(ev.value);
      if (next != pressedLogical) {
        setPressedLogical(next);
        stateChanged = true;
      }
    } else if (ev is CoreEventFocusTarget) {
      let next = logicalForRender(ev.value);
      if (next != focusedLogical) {
        setFocusedLogical(next);
        stateChanged = true;
      }
    } else if (ev is CoreEventSizesChanged) {
      for (let ns in ev.value) {
        let lid = logicalForRenderId(ns.id);
        let n = getNode(lid);
        if (n != null) {
          if (!n.hasSize || n.measuredWidth != ns.width || n.measuredHeight != ns.height) {
            n.hasSize = true;
            n.measuredWidth = ns.width;
            n.measuredHeight = ns.height;
            stateChanged = true;
          }
        }
      }
    } else if (ev is CoreEventScrollChanged) {
      for (let sc in ev.value) {
        let lid = logicalForRenderId(sc.id);
        let n = getNode(lid);
        if (n != null) {
          if (
            !n.hasScroll
            || n.scrollX != sc.scrollX
            || n.scrollY != sc.scrollY
            || n.scrollRangeX != sc.reachX
            || n.scrollRangeY != sc.reachY
          ) {
            n.hasScroll = true;
            n.scrollX = sc.scrollX;
            n.scrollY = sc.scrollY;
            n.scrollRangeX = sc.reachX;
            n.scrollRangeY = sc.reachY;
            stateChanged = true;
          }
        }
      }
    }
  }
  if (!stateChanged) {
    return false;
  }
  let ops = new GrowableArray<RenderOp>();
  let changed = if (styleEngineActive) {
    refreshStyleTree(ops)
  } else {
    refreshLegacyStyledNodes(ops)
  };
  flushOps(ops);
  return changed;
}

export function routePointer(
  kind: PointerKind,
  target: Option<u32>,
  x: f32,
  y: f32,
  button: u8,
  captured: boolean,
): Array<Delivery> {
  let deliveries = new GrowableArray<Delivery>();
  let nextLogical = logicalForRender(target);

  if (nextLogical != lastHoverLogical) {
    let oldPath = logicalPath(lastHoverLogical);
    let newPath = logicalPath(nextLogical);
    var common = 0;
    while (
      common < oldPath.length
      && common < newPath.length
      && oldPath[common] == newPath[common]
    ) {
      common += 1;
    }

    let crossingCalls = new GrowableArray<Call>();
    var i = oldPath.length - 1;
    while (i >= common) {
      let nid = oldPath[i];
      let n = getNode(nid);
      if (n != null) {
        let node = n;
        let (lx, ly) = localCoords(nid, x, y);
        for (let l in node.pointerListeners) {
          if (l.kind == PointerKind.Leave) {
            let matches = (l.inScope == Scope.Subtree)
              || (l.inScope == Scope.Node && nid == lastHoverLogical);
            if (matches) {
              crossingCalls.push(new Call(l.id, new PointerEvent(PointerKind.Leave, lx, ly, 0 as u8)));
            }
          }
        }
      }
      i -= 1;
    }
    for (var j = common; j < newPath.length; j += 1) {
      let nid = newPath[j];
      let n = getNode(nid);
      if (n != null) {
        let node = n;
        let (lx, ly) = localCoords(nid, x, y);
        for (let l in node.pointerListeners) {
          if (l.kind == PointerKind.Enter) {
            let matches = (l.inScope == Scope.Subtree)
              || (l.inScope == Scope.Node && nid == nextLogical);
            if (matches) {
              crossingCalls.push(new Call(l.id, new PointerEvent(PointerKind.Enter, lx, ly, 0 as u8)));
            }
          }
        }
      }
    }
    if (crossingCalls.length > 0) {
      deliveries.push(new Delivery(crossingCalls, false));
    }
    setLastHoverLogical(nextLogical);
  }

  if (kind == PointerKind.Enter || kind == PointerKind.Leave || nextLogical == (0 as u32)) {
    return deliveries;
  }

  let path = logicalPath(nextLogical);
  let calls = new GrowableArray<Call>();

  for (let nid in path) {
    let n = getNode(nid);
    if (n == null) {
      continue;
    }
    let node = n;
    let (lx, ly) = localCoords(nid, x, y);
    for (let l in node.pointerListeners) {
      if (l.kind == kind && l.at == Phase.Intercept) {
        let matches = (l.inScope == Scope.Subtree)
          || (l.inScope == Scope.Node && nid == nextLogical)
          || (l.inScope == Scope.Captured && captured);
        if (matches) {
          calls.push(new Call(l.id, new PointerEvent(kind, lx, ly, button)));
        }
      }
    }
  }

  var j = path.length - 1;
  while (j >= 0) {
    let nid = path[j];
    let n = getNode(nid);
    if (n != null) {
      let node = n;
      let (lx, ly) = localCoords(nid, x, y);
      for (let l in node.pointerListeners) {
        if (l.kind == kind && l.at == Phase.Bubble) {
          let matches = (l.inScope == Scope.Subtree)
            || (l.inScope == Scope.Node && nid == nextLogical)
            || (l.inScope == Scope.Captured && captured);
          if (matches) {
            calls.push(new Call(l.id, new PointerEvent(kind, lx, ly, button)));
          }
        }
      }
    }
    j -= 1;
  }

  if (calls.length > 0) {
    deliveries.push(new Delivery(calls, true));
  }
  return deliveries;
}

export function routeKey(focused: Option<u32>): Array<u32> {
  let target = logicalForRender(focused);
  let leaf = if (target != (0 as u32)) { target } else { rootLogicalId };
  let path = logicalPath(leaf);
  let out = new GrowableArray<u32>();

  for (var i = 0; i < path.length; i += 1) {
    let n = getNode(path[i]);
    if (n == null) {
      continue;
    }
    let node = n;
    for (let l in node.keyListeners) {
      if (l.at == Phase.Intercept) {
        out.push(l.id);
      }
    }
  }
  var j = path.length - 1;
  while (j >= 0) {
    let n = getNode(path[j]);
    if (n != null) {
      let node = n;
      for (let l in node.keyListeners) {
        if (l.at == Phase.Bubble) {
          out.push(l.id);
        }
      }
    }
    j -= 1;
  }
  return out;
}

export function captureTarget(listenerId: u32): Option<u32> {
  if (let (true, ownerId) = listenerOwner.get(listenerId)) {
    let rn = nearestRenderLogical(ownerId);
    if (rn != null) {
      return some(rn.renderId);
    }
  }
  return none;
}

// ============================================================================
// Exported `zenafx:platform/runtime` Functions — Style Engine
// ============================================================================

export function defineProperty(def: PropertyDef): u32 {
  return definePropertyDef(def);
}

export function defineFact(kind: FactKind): u32 {
  return defineFactKind(kind);
}

export function defineStylesheet(def: StylesheetDef): void {
  defineStylesheetDef(def);
  let ops = new GrowableArray<RenderOp>();
  refreshStyleTree(ops);
  flushOps(ops);
}

export function attachStylesheet(
  node: u32,
  target: u32,
  stylesheet: u32,
  reach: Reach,
): boolean {
  let tn = resolveTarget(node, target);
  if (tn == null) {
    return false;
  }
  let ops = new GrowableArray<RenderOp>();
  let ok = attachStylesheetToNode(tn, stylesheet, reach, ops);
  flushOps(ops);
  return ok;
}

export function detachStylesheet(
  node: u32,
  target: u32,
  stylesheet: u32,
): boolean {
  let tn = resolveTarget(node, target);
  if (tn == null) {
    return false;
  }
  let ops = new GrowableArray<RenderOp>();
  let ok = detachStylesheetFromNode(tn, stylesheet, ops);
  flushOps(ops);
  return ok;
}

export function setFlag(node: u32, target: u32, key: u32, value: boolean): boolean {
  let tn = resolveTarget(node, target);
  if (tn == null) {
    return false;
  }
  markStyleEngineActive();
  if (value) {
    tn.flags[key] = true;
  } else {
    tn.flags.delete(key);
  }
  let ops = new GrowableArray<RenderOp>();
  refreshFromNode(tn, ops);
  flushOps(ops);
  return true;
}

export function setNumber(node: u32, target: u32, key: u32, value: Option<f32>): boolean {
  let tn = resolveTarget(node, target);
  if (tn == null) {
    return false;
  }
  markStyleEngineActive();
  if (let Some { value as n } = value) {
    tn.numbers[key] = n;
  } else {
    tn.numbers.delete(key);
  }
  let ops = new GrowableArray<RenderOp>();
  refreshFromNode(tn, ops);
  flushOps(ops);
  return true;
}

export function setDeclarations(
  node: u32,
  target: u32,
  decls: Array<Declaration>,
): boolean {
  let tn = resolveTarget(node, target);
  if (tn == null) {
    return false;
  }
  markStyleEngineActive();
  let copy = new GrowableArray<Declaration>();
  for (let d in decls) {
    copy.push(d);
  }
  tn.inlineDecls = copy;
  let ops = new GrowableArray<RenderOp>();
  let bits = declsWatchBits(decls);
  addWatchFlag(tn.id, bits, ops);
  refreshFromNode(tn, ops);
  flushOps(ops);
  return true;
}

export function setScopeOwner(node: u32, owner: u32): boolean {
  let tn = getNode(node);
  if (tn == null) {
    return false;
  }
  if (owner != (0 as u32) && getNode(owner) == null) {
    return false;
  }
  markStyleEngineActive();
  tn.scopeOwner = owner;
  let ops = new GrowableArray<RenderOp>();
  applyInheritedScopeWatchBits(tn, ops);
  refreshFromNode(tn, ops);
  flushOps(ops);
  return true;
}

export function resolvedProperty(
  node: u32,
  target: u32,
  key: StyleKey,
): Option<StyleValue> {
  let tn = resolveTarget(node, target);
  if (tn == null) {
    return none;
  }
  return queryResolvedProperty(tn, key);
}

export function watchCondition(
  node: u32,
  target: u32,
  watcherId: u32,
  conditions: Array<Condition>,
  root: u32,
): Option<boolean> {
  let tn = resolveTarget(node, target);
  if (tn == null) {
    return none;
  }
  let ops = new GrowableArray<RenderOp>();
  let holds = registerConditionWatcher(tn, watcherId, conditions, root, ops);
  flushOps(ops);
  return some(holds);
}

export function watchProperty(
  node: u32,
  target: u32,
  watcherId: u32,
  key: StyleKey,
): Option<StyleValue> {
  let tn = resolveTarget(node, target);
  if (tn == null) {
    return none;
  }
  return registerPropertyWatcher(tn, watcherId, key);
}

export function unwatch(watcherId: u32): void {
  removeWatcher(watcherId);
}

export function takeWatcherUpdates(): Array<WatcherUpdate> {
  return drainWatcherUpdates();
}
