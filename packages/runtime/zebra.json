{
  "locks": ["zena-lock.json", "package-lock.json"],
  "scripts": {
    "build": {
      "command": "tsc",
      "files": ["src/**/*.ts", "tsconfig.json"],
      "output": [
        "lib",
        "test",
        "index.{js,d.ts,js.map,d.ts.map}",
        "number-format.{js,d.ts,js.map,d.ts.map}",
        "tsconfig.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "command": "node --enable-source-maps --test test/**/*_test.js",
      "files": ["../language-service/lsp.wasm"],
      "dependencies": [
        "build",
        "../stdlib:lib",
        {
          "script": "../language-service:build:wasm",
          "cascade": false
        }
      ]
    }
  }
}
