{
  "name": "@zena-lang/runtime",
  "version": "0.0.2-preview.1",
  "description": "JavaScript WebAssembly-GC host runtime for compiled Zena modules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elematic/zena.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://zena-lang.dev",
  "bugs": {
    "url": "https://github.com/elematic/zena/issues"
  },
  "keywords": [
    "zena",
    "runtime",
    "webassembly",
    "wasm-gc"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.js.map",
    "index.d.ts",
    "number-format.js",
    "number-format.js.map",
    "number-format.d.ts"
  ],
  "scripts": {
    "build": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc",
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "lib",
        "test",
        "index.{js,d.ts,js.map,d.ts.map}",
        "number-format.{js,d.ts,js.map,d.ts.map}",
        "tsconfig.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "command": "node --enable-source-maps --test test/**/*_test.js",
      "dependencies": [
        "build",
        {
          "script": "../compiler-js:build:wasm",
          "cascade": false
        }
      ],
      "files": [
        "../stdlib/zena/**/*.zena",
        "../compiler-js/compiler.wasm"
      ],
      "output": []
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
