/**
 * Probe: which optional method calls lower? Expected output `x y` if all do.
 */
class Holder {
  var hits = 0;
  describe(): String {
    return 'x';
  }
  poke(): void {
    this.hits += 1;
  }
}

function maybe(flag: boolean): Holder | null {
  return if (flag) new Holder() else null;
}

function viaValue(h: Holder | null) {
  return h?.describe() ?? 'y';
}

function viaStatement(h: Holder | null) {
  h?.poke();
}

export function main(): i32 {
  viaStatement(maybe(true));
  viaStatement(null);
  console.log(`${viaValue(maybe(true))} ${viaValue(null)}`);
  return 0;
}
