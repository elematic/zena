/**
 * Does `if (let …)` work as an expression? The match-to-if rule writes
 * one when a two-arm match sits in value position. Expected output:
 * `3 0 7`.
 */

class Point {
  x: i32;
  y: i32;
  new(this.x, this.y);
}

sealed class Shape {
  case Circle(r: i32)
  case Square(side: i32)
}

function area(s: Shape): i32 {
  return if (let Circle {r} = s) r * 3 else 0;
}

function sum(p: Point | null): i32 {
  let fallback = new Point(7, 0);
  let q = p ?? fallback;
  return if (let Point {x, y} = q) x + y else -1;
}

export function main(): i32 {
  let a = area(new Circle(1));
  let b = area(new Square(2));
  let c = sum(null);
  console.log(`${i32ToString(a)} ${i32ToString(b)} ${i32ToString(c)}`);
  return 0;
}
