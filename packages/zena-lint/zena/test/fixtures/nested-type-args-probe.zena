/** Probe: explicit type arguments with nested generics on a call. Expected output: 1. */
import { growable } from 'zena:core';
function wrap<T>(items: FixedArray<T>): GrowableArray<T> {
  return growable<T>(items);
}
export function main(): i32 {
  let boxes = wrap<Box<i32>>([new Box<i32>(1)]);
  console.log(i32ToString(boxes[0].value));
  return 0;
}
