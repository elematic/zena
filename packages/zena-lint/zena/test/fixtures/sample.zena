/**
 * A file written the old way, for the lint tool to practise on.
 */

import { HashMap } from 'zena:collections';
import { growable } from 'zena:core';

class Point {
  x: f64;
  y: f64;
  new(this.x, this.y);
}

class Named {
  name: String;
  var tag: String | null = null;
  new(this.name);
  describe(): String {
    return this.name;
  }
}

/** A documented helper. */
let origin = (): Point => new Point(0.0, 0.0);

let scale = (p: Point, k: f64): Point => {
  return new Point(p.x * k, p.y * k);
};

let labels = (names: GrowableArray<String>): GrowableArray<String> => {
  let out = new Array<String>(names.length);
  for (let name in names) {
    out.push(name + '!');
  }
  return out;
};

let firstOr = (names: GrowableArray<String>, fallback: String): String => {
  var result: String = fallback;
  if (names.length > 0) {
    result = names[0];
  }
  return result;
};

let tagOf = (n: Named | null): String => {
  let tag = if (n != null) { n.tag } else { null };
  return tag ?? 'none';
};

let nameOf = (n: Named | null): String => {
  return if (n != null) { n.name } else { 'anonymous' };
};

let describe = (p: Point | null): String => {
  return match (p) {
    case null: 'nowhere'
    case _: 'somewhere'
  };
};

let count = (xs: GrowableArray<i32>): i32 => {
  var total: i32 = 0;
  var i = 0;
  while (i < xs.length) {
    let x = xs[i];
    total += x;
    i += 1;
  }
  return total;
};

let pairs = (): HashMap<String, i32> => {
  let m = new Map<String, i32>();
  m['a'] = 1;
  m['b'] = 2;
  return m;
};

let items = (): GrowableArray<String> => {
  let xs = new Array<String>(4);
  xs.push('one');
  xs.push('two');
  xs.push('three');
  return xs;
};

let shout = (s: String, n: i32): String => {
  let message: String = s + ' x ' + i32ToString(n) + '!';
  let as_string = message as String;
  return as_string;
};

let isBig = (n: i32): boolean => {
  if (n > 100) {
    return true;
  }
  return false;
};

let each = (xs: GrowableArray<String>): i32 => {
  var seen = 0;
  xs.map((x: String, index: i32, seq: GrowableArray<String>): i32 => {
    seen += 1;
    return x.length;
  });
  return seen;
};

export let main = (): i32 => {
  let p = scale(origin(), 2.0);
  let names = items();
  let ls = labels(names);
  let n = new Named('x');
  let total = count(growable([1, 2, 3]));
  let s = shout(firstOr(ls, 'none'), total);
  console.log(s + tagOf(n) + nameOf(null) + describe(p) + i32ToString(pairs()['a']));
  if (isBig(total) || each(names) > 0) {
    return 1;
  }
  return 0;
};
