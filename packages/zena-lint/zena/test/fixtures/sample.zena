/**
 * A file written the old way, for the lint tool to practise on.
 */

import { HashMap } from 'zena:collections';
import { growable } from 'zena:core';

class Point {
  x: f64;
  y: f64;
  new(this.x, this.y);
}

class Named {
  name: String;
  tag: String | null = null;
  new(this.name);
  describe(): String {
    return this.name;
  }
}

/** A documented helper. */
function origin() {
  return new Point(0.0, 0.0);
}

function scale(p: Point, k: f64) {
  return new Point(p.x * k, p.y * k);
}

function labels(names: GrowableArray<String>) {
  let out = new Array<String>(names.length);
  for (let name in names) {
    out.push(name + '!');
  }
  return out;
}

function firstOr(names: GrowableArray<String>, fallback: String) {
  let result = if (names.length > 0) names[0] else fallback;
  return result;
}

function tagOf(n: Named | null) {
  let tag = n?.tag;
  return tag ?? 'none';
}

function nameOf(n: Named | null) {
  return n?.name ?? 'anonymous';
}

function describe(p: Point | null) {
  return if (p == null) 'nowhere' else 'somewhere';
}

function count(xs: GrowableArray<i32>) {
  var total = 0;
  for (let x in xs) {
    total += x;
  }
  return total;
}

function pairs() {
  let m: HashMap<String, i32> = {'a' => 1, 'b' => 2};
  return m;
}

function items() {
  let xs = growable<String>(['one', 'two', 'three']);
  return xs;
}

function shout(s: String, n: i32) {
  let message = `${s} x ${i32ToString(n)}!`;
  let as_string = message;
  return as_string;
}

function isBig(n: i32) {
  return n > 100;
}

function each(xs: GrowableArray<String>) {
  var seen = 0;
  xs.map((x, index, seq) => {
    seen += 1;
    return x.length;
  });
  return seen;
}

export function main(): i32 {
  let p = scale(origin(), 2.0);
  let names = items();
  let ls = labels(names);
  let n = new Named('x');
  let total = count(growable([1, 2, 3]));
  let s = shout(firstOr(ls, 'none'), total);
  console.log(s + tagOf(n) + nameOf(null) + describe(p) + i32ToString(pairs()['a']));
  if (isBig(total) || each(names) > 0) {
    return 1;
  }
  return 0;
}
