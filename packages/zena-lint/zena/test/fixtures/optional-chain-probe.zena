/**
 * Probe: does `x?.field ?? default` compile for each field type?
 * Expected output: `a 0 7 b`.
 */

class Holder {
  value: String;
  count: i32;
  new(this.value, this.count);
}

function maybe(flag: boolean): Holder | null {
  return if (flag) new Holder('a', 7) else null;
}

function stringField(h: Holder | null): String {
  return h?.value ?? '';
}

function intField(h: Holder | null): i32 {
  return h?.count ?? 0;
}

function viaLocal(flag: boolean): String {
  let h = maybe(flag);
  let packageRef = h?.value ?? 'b';
  return packageRef;
}

export function main(): i32 {
  console.log(`${stringField(maybe(true))} ${i32ToString(intField(null))} ${i32ToString(intField(maybe(true)))} ${viaLocal(false)}`);
  return 0;
}
