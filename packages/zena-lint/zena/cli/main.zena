/**
 * The lint tool's command line.
 *
 * Rewrites Zena files to current idiom: `function` declarations for
 * top-level arrows, no casts or annotations the checker does not need,
 * collection literals, `if`/`??`/`?.` expressions in place of mutable
 * variables and small matches. Each rewrite is type-checked before it is
 * kept; one the checker rejects is reported with the error.
 *
 * Run from the repository root:
 *
 *   zena-cli run packages/zena-lint/zena/cli/main.zena -- \
 *       [--dry-run] [--verbose] [--only rule,rule] [--skip rule,rule] <paths>
 *
 * A path is a `.zena` file or a directory, which is searched for them.
 */

import { getArguments, exit } from 'zena:cli';
import { isDirectorySync, listDirSync, existsSync, FileType } from 'zena:fs';
import { join2 } from 'zena:path';
import { Project } from '../lib/checking.zena';
import { lintFile, LintOptions, NamedRule, FileReport } from '../lib/lint.zena';
import { allRules } from '../lib/rules.zena';

let USAGE =
    'Usage: zena-lint [--dry-run|-n] [--verbose|-v] [--only rules] [--skip rules]\n' +
    '                    [--stdlib-root <dir>] [--list-rules] <paths...>';

export function main(): i32 {
  let args = getArguments();
  let paths = new Array<String>();
  var dryRun = false;
  var verbose = false;
  var only: String | null = null;
  var skip: String | null = null;
  var stdlibRoot = 'packages/stdlib/zena';

  var i = 1;
  while (i < args.length) {
    let arg = args[i];
    if (arg == '--') {
      // `zena run file -- args` hands the separator on.
    } else if (arg == '--dry-run' || arg == '-n') {
      dryRun = true;
    } else if (arg == '--verbose' || arg == '-v') {
      verbose = true;
    } else if (arg == '--only' && i + 1 < args.length) {
      only = args[i + 1];
      i += 1;
    } else if (arg == '--skip' && i + 1 < args.length) {
      skip = args[i + 1];
      i += 1;
    } else if (arg == '--stdlib-root' && i + 1 < args.length) {
      stdlibRoot = args[i + 1];
      i += 1;
    } else if (arg == '--list-rules') {
      for (let rule in allRules()) {
        console.log(rule.name);
      }
      return 0;
    } else if (arg == '-h' || arg == '--help') {
      console.log(USAGE);
      return 0;
    } else if (arg.startsWith('-')) {
      console.error(`Unknown option: ${arg}`);
      console.error(USAGE);
      return 2;
    } else {
      paths.push(arg);
    }
    i += 1;
  }
  if (paths.length == 0) {
    console.error(USAGE);
    return 2;
  }

  let rules = selectRules(only, skip);
  if (rules == null) {
    return 2;
  }
  let options = new LintOptions(rules);
  options.write = !dryRun;
  options.verbose = verbose;

  let files = new Array<String>();
  for (let path in paths) {
    if (!existsSync(path)) {
      console.error(`No such path: ${path}`);
      return 2;
    }
    collectFiles(path, files);
  }

  let project = new Project(stdlibRoot);
  var edited = 0;
  var rejected = 0;
  var skipped = 0;
  for (let file in files) {
    var report: FileReport | null = null;
    try {
      report = lintFile(project, file, options);
    } catch (e) {
      console.error(`${file}: the tool failed: ${(e as Error).message}`);
      return 1;
    }
    if (report == null) {
      return 1;
    }
    print(report, options);
    if (report.changed) {
      edited += 1;
    }
    rejected += report.rejected.length;
    if (report.errorsBefore.length > 0 || report.failure != null) {
      skipped += 1;
    }
  }
  let verb = if (dryRun) 'would change' else 'changed';
  console.log(`${i32ToString(files.length)} files, ${verb} ${i32ToString(edited)}, ` +
      `${i32ToString(rejected)} edits rejected by the checker, ${i32ToString(skipped)} skipped`);
  return 0;
}

/** The rules named by `--only`, less those named by `--skip`. */
function selectRules(only: String | null, skip: String | null): GrowableArray<NamedRule> | null {
  let all = allRules();
  let chosen = new Array<NamedRule>();
  for (let rule in all) {
    if (only != null && !listHas(only, rule.name)) {
      continue;
    }
    if (skip != null && listHas(skip, rule.name)) {
      continue;
    }
    chosen.push(rule);
  }
  for (let named in namesIn(only)) {
    if (!ruleExists(all, named)) {
      console.error(`No such rule: ${named}`);
      return null;
    }
  }
  for (let named in namesIn(skip)) {
    if (!ruleExists(all, named)) {
      console.error(`No such rule: ${named}`);
      return null;
    }
  }
  return chosen;
}

function namesIn(list: String | null): FixedArray<String> {
  if (list == null) {
    return new FixedArray<String>(0, '');
  }
  return list.split(',');
}

function listHas(list: String, name: String): boolean {
  for (let item in list.split(',')) {
    if (item.trim() == name) {
      return true;
    }
  }
  return false;
}

function ruleExists(rules: GrowableArray<NamedRule>, name: String): boolean {
  for (let rule in rules) {
    if (rule.name == name) {
      return true;
    }
  }
  return false;
}

/** `.zena` files at or under `path`, skipping build output and the bootstrap. */
function collectFiles(path: String, out: GrowableArray<String>): void {
  if (!isDirectorySync(path)) {
    if (path.endsWith('.zena')) {
      out.push(path);
    }
    return;
  }
  for (let entry in listDirSync(path)) {
    let name = entry.name;
    if (name == '.' || name == '..' || name == 'node_modules' || name == 'out' ||
        name == 'bootstrap' || name == 'target' || name.startsWith('.')) {
      continue;
    }
    let child = join2(path, name);
    if (entry.fileType == FileType.Directory) {
      collectFiles(child, out);
    } else if (entry.fileType == FileType.RegularFile && name.endsWith('.zena')) {
      out.push(child);
    }
  }
}

function print(report: FileReport, options: LintOptions): void {
  let failure = report.failure;
  if (failure != null) {
    console.log(`${report.path}: skipped, could not compile: ${failure}`);
    return;
  }
  if (report.errorsBefore.length > 0) {
    console.log(`${report.path}: skipped, does not check (${report.errorsBefore[0]})`);
    return;
  }
  if (report.applied.length == 0 && report.rejected.length == 0) {
    if (options.verbose) {
      console.log(`${report.path}: nothing to do`);
    }
    return;
  }
  console.log(`${report.path}: ${i32ToString(report.applied.length)} edits ` +
      `in ${i32ToString(report.passes)} passes${summarize(report)}`);
  if (options.verbose) {
    for (let edit in report.applied) {
      console.log(`  line ${i32ToString(edit.line)}: ${edit.rule}`);
    }
  }
  for (let rejection in report.rejected) {
    console.log(`  rejected ${rejection.edit.rule} at line ${i32ToString(rejection.edit.line)}: ${rejection.error}`);
    if (options.verbose) {
      console.log(`    proposed: ${rejection.edit.replacement}`);
    }
  }
}

/** ` (rule 3, rule 1)` — how many edits each rule made. */
function summarize(report: FileReport): String {
  let names = new Array<String>();
  let counts = new Array<i32>();
  for (let edit in report.applied) {
    var found = false;
    var i = 0;
    while (i < names.length) {
      if (names[i] == edit.rule) {
        counts[i] = counts[i] + 1;
        found = true;
      }
      i += 1;
    }
    if (!found) {
      names.push(edit.rule);
      counts.push(1);
    }
  }
  if (names.length == 0) {
    return '';
  }
  var text = ' (';
  var i = 0;
  while (i < names.length) {
    if (i > 0) {
      text = text + ', ';
    }
    text = `${text}${names[i]} ${i32ToString(counts[i])}`;
    i += 1;
  }
  return text + ')';
}
