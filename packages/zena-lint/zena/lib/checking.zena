/**
 * Compiling and checking files, with text that is not on disk yet.
 *
 * The tool checks a file, rewrites it, and checks the rewrite before
 * writing it. The rewrite exists only in memory, so the compiler reads
 * through an overlay host: a path with an override reads the override,
 * everything else reads the disk. One `Compiler` is kept warm across
 * files so the standard library is checked once; it is replaced every
 * `ENTRIES_PER_COMPILER` files because a compiler's per-entry state is
 * never collected (see packages/zena-compiler/CONTEXT.md).
 */

import { readFileSync } from 'zena:fs';
import { getEnv } from 'zena:cli';
import { join2 } from 'zena:path';
import {
  createCompiler, checkCompilation, CompilerHost, Compiler, PackageConfig,
  ProgramCheckResult, Diagnostic, loadWorkspace,
} from 'zena-compiler:compiler';
import { stdlibIdToRelativeFile } from 'zena-compiler:module-resolver';
import { isWitModulePath, synthesizeWitModule } from 'zena-compiler:wit-module-synth';
import { directoryNames } from 'zena-compiler:fs-host';
import { CheckedFile } from './checked.zena';

export { CheckedFile } from './checked.zena';

/** How many entry points share one compiler before it is replaced. */
let ENTRIES_PER_COMPILER = 16;

/** Reads the stdlib from its root, overrides from memory, the rest from disk. */
final class OverlayHost implements CompilerHost {
  #stdlibRoot: String;
  overrides = new Map<String, String>();

  new(stdlibRoot: String) : #stdlibRoot = stdlibRoot;

  readFile(path: String): String {
    if (let (true, text) = this.overrides.get(path)) {
      return text;
    }
    if (isWitModulePath(path)) {
      return synthesizeWitModule(this, path);
    }
    if (path.startsWith('zena:')) {
      return readFileSync(join2(this.#stdlibRoot, stdlibIdToRelativeFile(path)));
    }
    return readFileSync(path);
  }

  listDir(path: String): Array<String> | null {
    return directoryNames(path);
  }
}

/**
 * The project the files belong to: where the standard library is and
 * which packages `zena-packages.json` declares, plus the warm compiler.
 */
export final class Project {
  /** Where the compiler reads the standard library from. */
  stdlibRoot: String;
  /**
   * Where the standard library's files are named on a command line, when
   * that is somewhere else: the `zena` command reads them through the
   * host's `/stdlib` preopen but is asked about `packages/stdlib/zena/…`.
   */
  stdlibSources: String;
  target: String;
  #host: OverlayHost;
  #packages: Map<String, PackageConfig>;
  var #compiler: Compiler | null = null;
  var #previous: ProgramCheckResult | null = null;
  var #entriesOnCompiler = 0;
  /** Whether the current file is in an import cycle; see `override`. */
  var #cyclic = false;

  /**
   * `packageCache` is where fetched packages are, for a project whose
   * `zena-packages.json` pins some; see `CompileFileOptions.packageCache`.
   */
  new(stdlibRoot: String = 'packages/stdlib/zena', stdlibSources: String | null = null,
      target: String = 'zena-cli', packageCache: String | null = null)
    : stdlibRoot = stdlibRoot,
      stdlibSources = stdlibSources ?? stdlibRoot,
      target = target,
      #host = new OverlayHost(stdlibRoot),
      #packages = loadPackages(new OverlayHost(stdlibRoot), packageCache);

  /** A fresh compiler, dropping whatever the old one accumulated. */
  #freshCompiler(): Compiler {
    let compiler = createCompiler(this.#host, {
      stdlibRoot: this.stdlibRoot,
      packages: this.#packages,
      warnUnnecessaryCasts: true,
    });
    this.#compiler = compiler;
    this.#previous = null;
    this.#entriesOnCompiler = 0;
    return compiler;
  }

  /**
   * Text the compiler should read for `path` instead of the disk's, or
   * null to read the disk again. Call before `check` for the same path.
   */
  override(path: String, text: String | null): void {
    let key = this.entryIdOf(path);
    if (text == null) {
      this.#host.overrides.delete(key);
    } else {
      this.#host.overrides[key] = text;
    }
    if (this.#cyclic) {
      // A file in an import cycle cannot be re-read on its own: the
      // other members keep the types of its old parse, and the new
      // parse's types do not match them ("'App' is not assignable to
      // 'App'"). Start over with a compiler that has seen none of them.
      this.#compiler = null;
      this.#previous = null;
      return;
    }
    let compiler = this.#compiler;
    // Not `compiler?.invalidate(path)`: an optional method call does not
    // lower yet (see the nullish rule).
    if (compiler != null) {
      compiler.invalidate(key);
    }
  }

  /**
   * The id the compiler knows a file by. A standard library file is
   * `zena:<path under the root>`: compiled by its disk path it would be a
   * second copy of its library, with types that match nothing the rest
   * of the standard library has (`'Encoding' is not assignable to
   * 'Encoding'`).
   */
  entryIdOf(path: String): String {
    let root = `${this.stdlibSources}/`;
    if (path.startsWith(root)) {
      return `zena:${path.sliceBytes(root.length, path.length)}`;
    }
    return path;
  }

  /** Forget every override and every cached file. Call between files. */
  reset(): void {
    this.#host.overrides.clear();
    this.#entriesOnCompiler += 1;
    if (this.#entriesOnCompiler >= ENTRIES_PER_COMPILER || this.#cyclic) {
      this.#compiler = null;
      this.#previous = null;
    }
    this.#cyclic = false;
  }

  /**
   * Compiles and checks the file at `path` (reading an override if one is
   * set), or throws when it does not parse or a dependency is missing.
   */
  check(path: String): CheckedFile {
    let compiler = this.#compiler ?? this.#freshCompiler();
    // The file itself may have changed since the last check; the
    // dependencies are trusted until `reset`.
    let id = this.entryIdOf(path);
    if (getEnv('ZENA_LINT_DEBUG') != null) {
      console.log(`checking ${path} as ${id} (stdlib root ${this.stdlibRoot})`);
    }
    compiler.invalidate(id);
    let result = compiler.compile({entry: id, target: this.target});
    if (result.hasCycle) {
      this.#cyclic = true;
    }
    let checked = checkCompilation(result, this.#previous);
    this.#previous = checked;
    let entryPath = result.entry.path;
    let own = new Array<Diagnostic>();
    for (let diagnostic in checked.entry.diagnostics) {
      let location = diagnostic.location;
      if (location == null || location.file == entryPath || location.file == path ||
          location.file == id) {
        own.push(diagnostic);
      }
    }
    let file = new CheckedFile(path, result.entry.source, result.entry.ast,
        checked.entry.model, own);
    file.isStdlib = id.startsWith('zena:');
    return file;
  }
}

/** The packages of the workspace in the working directory, or none. */
function loadPackages(host: CompilerHost, packageCache: String | null): Map<String, PackageConfig> {
  return loadWorkspace(host, '.', null, packageCache);
}
