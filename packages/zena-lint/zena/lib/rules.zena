/**
 * Every rule, by name. The order is the order they run in within a
 * pass; it only matters when two rules want the same bytes, and then the
 * one listed first wins the pass and the other gets the next.
 */

import { NamedRule } from './lint.zena';
import { functionDeclarations } from './rules/function-declaration.zena';
import { unnecessaryCasts } from './rules/unnecessary-cast.zena';
import { unnecessaryAnnotations } from './rules/unnecessary-annotation.zena';
import { collectionLiterals } from './rules/collection-literal.zena';
import { ifInitializers } from './rules/if-initializer.zena';
import { nullishOperators } from './rules/nullish.zena';
import { matchToIf } from './rules/match-to-if.zena';
import { elseIfs } from './rules/else-if.zena';
import { preferLet } from './rules/prefer-let.zena';
import { immutableFields } from './rules/immutable-field.zena';
import { emptyConstructors } from './rules/empty-constructor.zena';
import { templateLiterals } from './rules/template-literal.zena';
import { booleanReturns } from './rules/boolean-return.zena';
import { forInLoops } from './rules/for-in.zena';
import { arrowBodies } from './rules/arrow-body.zena';

export function allRules(): GrowableArray<NamedRule> {
  let rules = new Array<NamedRule>();
  rules.push(new NamedRule('function-declaration', functionDeclarations));
  rules.push(new NamedRule('unnecessary-cast', unnecessaryCasts));
  rules.push(new NamedRule('unnecessary-annotation', unnecessaryAnnotations));
  rules.push(new NamedRule('collection-literal', collectionLiterals));
  rules.push(new NamedRule('if-initializer', ifInitializers));
  rules.push(new NamedRule('nullish', nullishOperators));
  rules.push(new NamedRule('match-to-if', matchToIf));
  rules.push(new NamedRule('else-if', elseIfs));
  rules.push(new NamedRule('for-in', forInLoops));
  rules.push(new NamedRule('boolean-return', booleanReturns));
  rules.push(new NamedRule('template-literal', templateLiterals));
  rules.push(new NamedRule('arrow-body', arrowBodies));
  rules.push(new NamedRule('prefer-let', preferLet));
  rules.push(new NamedRule('immutable-field', immutableFields));
  rules.push(new NamedRule('empty-constructor', emptyConstructors));
  return rules;
}
