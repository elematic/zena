/**
 * Probe, deliberately not compiling: an assignment in the constructor
 * body does not initialize a field, with or without `var`, and a field
 * without `var` is read-only there too. Both classes report
 * "Field 'name' must be initialized"; `A` also reports "Cannot assign to
 * read-only property 'name'". So the `immutable-field` rule treats every
 * assignment to a field, wherever it is, as a reason to keep `var`.
 */

class A {
  name: String;
  new(name: String) {
    this.name = name;
  }
}
class B {
  var name: String;
  new(name: String) {
    this.name = name;
  }
}
export function main(): i32 {
  return new A('a').name.length + new B('bb').name.length;
}
