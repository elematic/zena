{
  "name": "@zena-lang/zena-lint",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./zena/*": "./zena/*.zena"
  },
  "files": [
    "zena"
  ],
  "scripts": {
    "test": "wireit",
    "lint": "wireit"
  },
  "wireit": {
    "test": {
      "command": "../../target/release/zena-cli test \"zena/test/*_test.zena\"",
      "files": [
        "zena/**/*",
        "../zena-compiler/zena/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json"
      ],
      "output": [],
      "dependencies": [
        "../zena-cli:build",
        "../zena-compiler:precompile:cli"
      ]
    },
    "lint": {
      "#": "Runs the lint tool: `npm run lint -w @zena-lang/zena-lint -- <paths>`, paths relative to the repository root.",
      "command": "cd ../.. && ./target/release/zena-cli run --allow-spawn packages/zena-lint/zena/cli/main.zena --",
      "dependencies": [
        "../zena-cli:build"
      ]
    }
  },
  "devDependencies": {
    "wireit": "^0.14.4"
  }
}
