{
  "name": "@zena-lang/zena-lint",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./zena/*": "./zena/*.zena"
  },
  "files": [
    "zena"
  ],
  "scripts": {
    "test": "wireit"
  },
  "wireit": {
    "test": {
      "command": "../../target/release/zena-cli test \"zena/test/*_test.zena\"",
      "files": [
        "zena/**/*",
        "../zena-compiler/zena/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../../zena-package.json",
        "../*/zena/**/zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "../zena-cli:build",
        "../zena-compiler:precompile:cli"
      ]
    }
  },
  "devDependencies": {
    "wireit": "^0.14.4"
  }
}
