import {Future} from 'zena:async';
import {JsonObject} from 'zena:json';
import {suite, test} from 'zena:test';
import {equal, isFalse, isNotNull, isNull, isTrue, rejects, throws} from 'zena:assert';
import {
  ConfigProbe,
  planSnapshotFromText,
  planSnapshotToText,
} from 'zebra/plan-cache';
import {
  RuleRegistry,
  RuleResolveContext,
  RuleResolver,
  defaultRuleRegistry,
  parseCommonRuleFields,
} from 'zebra/rules';
import {
  DependencySpec,
  EnvBinding,
  EnvExternal,
  EnvLiteral,
  ScriptConfig,
  ScriptRef,
  ServiceConfig,
  ZENA_BUILD_RULE_TYPE,
  ZENA_TEST_RULE_TYPE,
  ZenaBuildEntry,
  ZenaBuildRule,
  ZenaTestRule,
  refKey,
} from 'zebra/wireit-config';
import {
  ZebraWorkspace,
  convertPackageJsonToZebraJson,
  mergeWireitIntoZenaPackageJson,
  readWorkspaceConcurrencyGroups,
} from 'zebra/zebra-config';

function hasStr(items: Array<String>, target: String): boolean {
  for (let item in items) {
    if (item == target) {
      return true;
    }
  }
  return false;
}

class MockLangRule implements RuleResolver {
  ruleType: String {
    get { return 'mock:build'; }
  }

  async resolve(entry: JsonObject, ctx: RuleResolveContext): Future<ScriptConfig> {
    let common = parseCommonRuleFields(entry, ctx, new GrowableArray<String>(), 'mock:build');
    let langCfg = await ctx.readFile('packages/demo/lang.cfg');
    let outName = if (langCfg != null) langCfg.trim() else 'default.out';
    common.files.push('src/**/*.lang');
    return new ScriptConfig(
      ctx.ref,
      true,
      'mockc',
      common.files,
      [outName],
      true,
      true,
      common.dependencies,
      common.clean,
      null,
      common.env,
      common.locks,
      common.cacheEnabled,
      false,
      null,
      common.concurrencyGroup,
    );
  }
}

export let tests = suite('zebra-config and plan-cache', () => {
  test('zebra.json parses comments, defaults output to [] and locks to zena-lock.json, and honors cache: false', async () => {
    let files = {
      'zebra.json' => `{
        // Standalone Zebra build configuration
        "workspace": {"packages": ["packages/*"]},
        "scripts": {
          "test": {
            "command": "zena test",
            "files": ["src/**/*.zena", "test/**/*_test.zena"]
          },
          "build": {
            "command": "zena build src/main.zena -o out/app.wasm",
            "output": ["out/app.wasm"],
            "dependencies": ["sources"]
          },
          "check:always": {
            "command": "zena lint src",
            "files": ["src/**/*.zena"],
            "cache": false
          },
          "cargo": {
            /* No files, output, or fileset dep -> always runs */
            "command": "cargo build --release"
          },
          "fmt": "zena fmt --check",
          "all": {
            "dependencies": ["test", "cargo"]
          }
        },
        "filesets": {
          "sources": ["src/**/*.zena"]
        }
      }`,
    };
    let ws = new ZebraWorkspace(async (path: String): Future<String?> => {
      if (let (true, content) = files.get(path)) {
        return content;
      }
      return null;
    });

    let testCfg = await ws.scriptConfig(new ScriptRef('', 'test'));
    isTrue(testCfg.fingerprintable, 'task with files is tracked without output: []');
    isFalse(testCfg.isFileset);
    equal(testCfg.output.length, 0);
    isTrue(testCfg.outputDeclared);
    equal(testCfg.packageLocks.length, 1);
    equal(testCfg.packageLocks[0], 'zena-lock.json');

    let buildCfg = await ws.scriptConfig(new ScriptRef('', 'build'));
    isTrue(buildCfg.fingerprintable, 'task with output + fileset dep caches without files: []');
    equal(buildCfg.files.length, 0);
    equal(buildCfg.output.length, 1);

    let fsCfg = await ws.scriptConfig(new ScriptRef('', 'sources'));
    isTrue(fsCfg.isFileset);
    isNull(fsCfg.command);
    isTrue(fsCfg.fingerprintable);
    equal(fsCfg.files.length, 1);
    equal(fsCfg.files[0], 'src/**/*.zena');

    let uncached = await ws.scriptConfig(new ScriptRef('', 'check:always'));
    isFalse(uncached.cacheEnabled);
    isFalse(uncached.fingerprintable);
    equal(uncached.files.length, 1);

    let cargo = await ws.scriptConfig(new ScriptRef('', 'cargo'));
    isFalse(cargo.filesDeclared);
    isFalse(cargo.fingerprintable);

    let fmt = await ws.scriptConfig(new ScriptRef('', 'fmt'));
    isFalse(fmt.isWireit);
    isFalse(fmt.fingerprintable);
    equal(fmt.command, 'zena fmt --check');

    let group = await ws.scriptConfig(new ScriptRef('', 'all'));
    isNull(group.command);
    isTrue(group.fingerprintable);
    isFalse(group.isFileset);
  });

  test('zena-package.json synthesizes transitive source filesets and supports explicit filesets and scripts', async () => {
    let files = {
      'zena-package.json' => `{
        "workspace": {"packages": ["packages/*"]},
        "scopes": {"demo": "pkg.example.test"},
        "scopedNames": true
      }`,
      'packages/core/zena-package.json' => `{
        "name": "core",
        "source": ".",
        "dependencies": {
          "host": {"wit": "./wit"}
        }
      }`,
      'packages/app/zena-package.json' => `{
        "name": "app",
        "dependencies": {
          "core": {"path": "../core"}
        },
        "filesets": {
          "assets": {
            "files": ["assets/**"],
            "dependencies": ["source"]
          }
        },
        "scripts": {
          "build": {
            "command": "zena build src/main.zena -o out/app.wasm",
            "output": ["out/app.wasm"],
            "dependencies": ["assets"]
          }
        }
      }`,
    };
    let ws = new ZebraWorkspace(async (path: String): Future<String?> => {
      if (let (true, content) = files.get(path)) {
        return content;
      }
      return null;
    });

    // Workspace root has no `name` or `source`, so `:source` tracks only zena-package.json.
    let rootSource = await ws.scriptConfig(new ScriptRef('', 'source'));
    isTrue(rootSource.isFileset);
    equal(rootSource.files.length, 1);
    equal(rootSource.files[0], 'zena-package.json');

    // `packages/core` has `"source": "."` + `"wit": "./wit"`.
    let coreSource = await ws.scriptConfig(new ScriptRef('packages/core', 'source'));
    isTrue(coreSource.isFileset);
    isTrue(hasStr(coreSource.files, 'zena-package.json'));
    isTrue(hasStr(coreSource.files, '../../zena-package.json'));
    isTrue(hasStr(coreSource.files, '**/*.zena'));
    isTrue(hasStr(coreSource.files, '!**/*_test.zena'));
    isTrue(hasStr(coreSource.files, '!**/test/**'));
    isTrue(hasStr(coreSource.files, '!**/tests/**'));
    isTrue(hasStr(coreSource.files, './wit/**/*.wit'));

    // `packages/app` defaults `source` to `src` and depends on `packages/core:source`.
    let closure = await ws.collect([new ScriptRef('packages/app', 'build')]);
    equal(closure.length, 4);
    equal(refKey(closure[0].ref), 'packages/app:build');
    equal(refKey(closure[1].ref), 'packages/app:assets');
    equal(refKey(closure[2].ref), 'packages/app:source');
    equal(refKey(closure[3].ref), 'packages/core:source');
    isTrue(closure[0].fingerprintable);
    isFalse(closure[0].isFileset);
    isTrue(closure[1].isFileset);
    isTrue(closure[2].isFileset);
    isTrue(hasStr(closure[2].files, 'src/**/*.zena'));
    isTrue(hasStr(closure[2].files, '!src/**/*_test.zena'));
  });

  test('coexistence: zena-package.json without scripts falls back to package.json wireit while still serving :source', async () => {
    let reads = new GrowableArray<String>();
    let files = {
      'zena-package.json' => `{"workspace": {"packages": ["packages/*"]}}`,
      'packages/hybrid/zena-package.json' => `{"name": "hybrid"}`,
      'packages/hybrid/package.json' => `{
        "scripts": {"build": "wireit"},
        "wireit": {
          "build": {
            "command": "zena build src/lib.zena -o dist/lib.wasm",
            "files": [],
            "output": ["dist/lib.wasm"],
            "dependencies": ["source"]
          }
        }
      }`,
      'packages/native/zena-package.json' => `{
        "name": "native",
        "scripts": {
          "build": {
            "command": "zena build src/main.zena -o out/main.wasm",
            "output": ["out/main.wasm"],
            "dependencies": ["source", "../hybrid:build"]
          }
        }
      }`,
      'packages/native/package.json' => `{"NotValidJsonIfRead": `,
      'packages/split/zena-package.json' => `{"name": "split"}`,
      'packages/split/zebra.json' => `{
        "scripts": {
          "check": {
            "command": "zena lint src",
            "dependencies": ["source"]
          }
        }
      }`,
    };
    let ws = new ZebraWorkspace(async (path: String): Future<String?> => {
      reads.push(path);
      if (let (true, content) = files.get(path)) {
        return content;
      }
      return null;
    });

    let closure = await ws.collect([new ScriptRef('packages/native', 'build')]);
    equal(closure.length, 4);
    equal(refKey(closure[0].ref), 'packages/native:build');
    equal(refKey(closure[1].ref), 'packages/native:source');
    equal(refKey(closure[2].ref), 'packages/hybrid:build');
    equal(refKey(closure[3].ref), 'packages/hybrid:source');
    for (let path in reads) {
      isTrue(
        path != 'packages/native/package.json',
        'package.json ignored when zena-package.json defines scripts',
      );
    }

    let splitCheck = await ws.scriptConfig(new ScriptRef('packages/split', 'check'));
    isTrue(splitCheck.fingerprintable, 'zebra.json script depending on zena-package.json :source is tracked');
  });

  test('package-level locks apply to scripts unless overridden per script', async () => {
    let ws = new ZebraWorkspace(async (path: String): Future<String?> => {
      if (path == 'zebra.json') {
        return `{
          "locks": ["zena-lock.json", "Cargo.lock"],
          "scripts": {
            "a": {"command": "true", "files": []},
            "b": {"command": "true", "files": [], "locks": []}
          }
        }`;
      }
      return null;
    });
    let a = await ws.scriptConfig(new ScriptRef('', 'a'));
    equal(a.packageLocks.length, 2);
    equal(a.packageLocks[0], 'zena-lock.json');
    equal(a.packageLocks[1], 'Cargo.lock');

    let b = await ws.scriptConfig(new ScriptRef('', 'b'));
    equal(b.packageLocks.length, 0);
  });

  test('invalid zebra.json / zena-package.json shapes fail with ConfigError', async () => {
    let checkZebraThrows = async (json: String) => {
      let ws = new ZebraWorkspace(async (path: String): Future<String?> => {
        return if (path == 'zebra.json') json else null;
      });
      await rejects(async () => {
        await ws.scriptConfig(new ScriptRef('', 'x'));
      });
    };

    // Unknown top-level key in zebra.json.
    await checkZebraThrows(`{"unknown": 1, "scripts": {"x": {"command": "true"}}}`);
    // Duplicate name across filesets and scripts.
    await checkZebraThrows(`{"filesets": {"x": ["a"]}, "scripts": {"x": {"command": "true"}}}`);
    // Unknown script key.
    await checkZebraThrows(`{"scripts": {"x": {"command": "true", "packageLocks": []}}}`);
    // Explicit cache: true without files, output, or fileset dep.
    await checkZebraThrows(`{"scripts": {"x": {"command": "true", "cache": true}}}`);
    // Invalid lock path.
    await checkZebraThrows(`{"locks": ["sub/lock.json"], "scripts": {"x": {"command": "true"}}}`);
    // Service declaring output.
    await checkZebraThrows(`{"scripts": {"x": {"command": "true", "service": true, "output": ["a"]}}}`);
    // "type": "zena:test" required for "tests"/"debug", and incompatible with command, service, or output.
    await checkZebraThrows(`{"scripts": {"x": {"tests": "test/*_test.zena"}}}`);
    await checkZebraThrows(`{"scripts": {"x": {"type": "other", "tests": "test/*_test.zena"}}}`);
    await checkZebraThrows(`{"scripts": {"x": {"type": 123}}}`);
    await checkZebraThrows(`{"scripts": {"x": {"type": "zena:test", "tests": true, "command": "true"}}}`);
    await checkZebraThrows(`{"scripts": {"x": {"type": "zena:test", "tests": true, "service": true}}}`);
    await checkZebraThrows(`{"scripts": {"x": {"type": "zena:test", "tests": true, "output": ["a"]}}}`);
    await checkZebraThrows(`{"scripts": {"x": {"type": "zena:test", "tests": false}}}`);
    await checkZebraThrows(`{"scripts": {"x": {"type": "zena:test", "tests": []}}}`);
    await checkZebraThrows(`{"scripts": {"x": {"command": "true", "files": [], "debug": true}}}`);

    // "tests" without "type": "zena:test" is also rejected in zena-package.json.
    let wsMissingType = new ZebraWorkspace(
      async (path: String): Future<String?> =>
        if (path == 'zena-package.json')
          `{"name": "p", "scripts": {"test": {"tests": "test/*_test.zena"}}}`
        else
          null,
    );
    await rejects(async () => {
      await wsMissingType.scriptConfig(new ScriptRef('', 'test'));
    });

    // Wireit block pasted into zena-package.json.
    let wsZena = new ZebraWorkspace(async (path: String): Future<String?> => {
      return if (path == 'zena-package.json') `{"name": "p", "wireit": {}}` else null;
    });
    await rejects(async () => {
      await wsZena.scriptConfig(new ScriptRef('', 'source'));
    });
  });

  test('tests scripts parse patterns, merge input globs, auto-add source, and synthesize zero-config zena-package.json test', async () => {
    let files = {
      'zena-package.json' => `{"workspace": {"packages": ["packages/*"]}}`,
      'packages/explicit/zena-package.json' => `{
        "name": "explicit",
        "scripts": {
          "test": {
            "type": "zena:test",
            "tests": "test/*_test.zena",
            "files": ["test/fixtures/**"]
          },
          "test:multi": {
            "type": "zena:test",
            "tests": ["test/*_test.zena", "integration/*_test.zena"],
            "debug": true
          },
          "test:default": {
            "type": "zena:test",
            "tests": true
          },
          "test:omitted-tests": {
            "type": "zena:test"
          }
        }
      }`,
      'packages/zero-src/zena-package.json' => `{"name": "zero-src"}`,
      'packages/zero-dot/zena-package.json' => `{"name": "zero-dot", "source": "."}`,
      'packages/fallback-pkg/zena-package.json' => `{"name": "fallback-pkg"}`,
      'packages/fallback-pkg/package.json' => `{
        "scripts": {"test": "node --test"}
      }`,
      'packages/no-pkg-test/zena-package.json' => `{"name": "no-pkg-test"}`,
      'packages/no-pkg-test/package.json' => `{
        "scripts": {"build": "tsc"}
      }`,
      'packages/only-zebra/zebra.json' => `{
        "scripts": {"build": {"command": "true", "files": []}}
      }`,
    };
    let ws = new ZebraWorkspace(async (path: String): Future<String?> => {
      if (let (true, content) = files.get(path)) {
        return content;
      }
      return null;
    });

    let explicit = await ws.scriptConfig(new ScriptRef('packages/explicit', 'test'));
    equal(explicit.ruleType, ZENA_TEST_RULE_TYPE);
    let explicitTests = explicit.tests ?? new GrowableArray<String>();
    equal(explicitTests.length, 1);
    equal(explicitTests[0], 'test/*_test.zena');
    isFalse(explicit.testDebug);
    isTrue(explicit.fingerprintable);
    isTrue(hasStr(explicit.files, 'test/fixtures/**'));
    isTrue(hasStr(explicit.files, 'test/*_test.zena'));
    equal(explicit.dependencies.length, 1);
    equal(refKey(explicit.dependencies[0].ref), 'packages/explicit:source');

    let multi = await ws.scriptConfig(new ScriptRef('packages/explicit', 'test:multi'));
    let multiTests = multi.tests ?? new GrowableArray<String>();
    equal(multiTests.length, 2);
    isTrue(multi.testDebug);
    isTrue(hasStr(multi.files, 'integration/*_test.zena'));

    let defTestsCfg = await ws.scriptConfig(new ScriptRef('packages/explicit', 'test:default'));
    let defTests = defTestsCfg.tests ?? new GrowableArray<String>();
    equal(defTests.length, 2);
    isTrue(hasStr(defTestsCfg.files, 'test/**/*.zena'));
    isTrue(hasStr(defTestsCfg.files, 'tests/**/*.zena'));

    let omittedTestsCfg = await ws.scriptConfig(new ScriptRef('packages/explicit', 'test:omitted-tests'));
    equal(omittedTestsCfg.ruleType, ZENA_TEST_RULE_TYPE);
    let omittedTests = omittedTestsCfg.tests ?? new GrowableArray<String>();
    equal(omittedTests.length, 2);
    isTrue(hasStr(omittedTestsCfg.files, 'test/**/*.zena'));

    // Zero-config zena-package.json synthesizes `test` (both default `src` and `"source": "."`).
    let zeroSrc = await ws.scriptConfig(new ScriptRef('packages/zero-src', 'test'));
    equal(zeroSrc.ruleType, ZENA_TEST_RULE_TYPE);
    isNotNull(zeroSrc.tests);
    isTrue(hasStr(zeroSrc.files, 'test/**/*.zena'));
    equal(zeroSrc.dependencies.length, 1);
    equal(refKey(zeroSrc.dependencies[0].ref), 'packages/zero-src:source');

    let zeroDot = await ws.scriptConfig(new ScriptRef('packages/zero-dot', 'test'));
    let dotPatterns = zeroDot.tests ?? new GrowableArray<String>();
    isTrue(hasStr(dotPatterns, '**/*_test.zena'));

    // When zena-package.json omits scripts and package.json defines `test`, package.json wins.
    let fallbackTest = await ws.scriptConfig(new ScriptRef('packages/fallback-pkg', 'test'));
    isNull(fallbackTest.tests);
    equal(fallbackTest.command, 'node --test');

    // When package.json exists without a `test` script, zena-package.json still synthesizes `test`.
    let synthBesidePkg = await ws.scriptConfig(new ScriptRef('packages/no-pkg-test', 'test'));
    isNotNull(synthBesidePkg.tests);

    // zebra.json without `test` does not synthesize one.
    await rejects(async () => {
      await ws.scriptConfig(new ScriptRef('packages/only-zebra', 'test'));
    });
  });

  test('convertPackageJsonToZebraJson and mergeWireitIntoZenaPackageJson migrate wireit configs cleanly', async () => {
    let noWireit = convertPackageJsonToZebraJson(`{"name": "plain", "scripts": {"test": "node test.js"}}`);
    isNull(noWireit);

    let wireitPkg = `{
      "name": "@demo/pkg",
      "scripts": {
        "build": "wireit",
        "test": "wireit",
        "untracked-watch": "wireit",
        "lint": "eslint ."
      },
      "wireit": {
        "build": {
          "#": "Main compile step",
          "command": "tsc",
          "files": ["src/**/*.ts"],
          "output": ["dist/**"],
          "clean": "if-file-deleted",
          "env": {"NODE_ENV": "production"},
          "dependencies": [{"script": "codegen", "cascade": false}]
        },
        "test": {
          "command": "node --test",
          "files": ["src/**/*.ts", "test/**/*.ts"],
          "output": []
        },
        "untracked-watch": {
          "command": "node check.js",
          "files": ["src/**/*.ts"]
        },
        "codegen": {
          "command": "node gen.js",
          "files": ["schema.json"],
          "output": ["src/gen.ts"],
          "packageLocks": []
        }
      }
    }`;

    let converted = convertPackageJsonToZebraJson(wireitPkg, true);
    isNotNull(converted);
    let zebraText = converted ?? '';
    isFalse(zebraText.contains('"output": []'), zebraText);
    isTrue(zebraText.contains('"cache": false'), zebraText);

    let merged = mergeWireitIntoZenaPackageJson(
      `{\n  "name": "demo-pkg",\n  "source": "src"\n}`,
      wireitPkg,
      true,
    );
    isNotNull(merged);
    let mergedText = merged ?? '';
    isTrue(mergedText.contains('"name": "demo-pkg"'), mergedText);
    isTrue(mergedText.contains('"source": "src"'), mergedText);

    let ws = new ZebraWorkspace(async (path: String): Future<String?> => {
      return if (path == 'zena-package.json') mergedText else null;
    });
    let buildCfg = await ws.scriptConfig(new ScriptRef('', 'build'));
    isTrue(buildCfg.fingerprintable);
    equal(buildCfg.clean, 'if-file-deleted');
    equal(buildCfg.packageLocks.length, 2);
    equal(buildCfg.packageLocks[0], 'zena-lock.json');
    equal(buildCfg.packageLocks[1], 'package-lock.json');

    let testCfg = await ws.scriptConfig(new ScriptRef('', 'test'));
    isTrue(testCfg.fingerprintable);
    equal(testCfg.output.length, 0);

    let untracked = await ws.scriptConfig(new ScriptRef('', 'untracked-watch'));
    isFalse(untracked.fingerprintable);
    equal(untracked.files.length, 1);

    let codegen = await ws.scriptConfig(new ScriptRef('', 'codegen'));
    isTrue(codegen.fingerprintable);
    equal(codegen.packageLocks.length, 0);

    let lint = await ws.scriptConfig(new ScriptRef('', 'lint'));
    isFalse(lint.fingerprintable);
    equal(lint.command, 'eslint .');

    let sourceFs = await ws.scriptConfig(new ScriptRef('', 'source'));
    isTrue(sourceFs.isFileset);
  });

  test('planSnapshotToText and planSnapshotFromText round-trip probes, filesets, and configs', () => {
    let probes = [
      new ConfigProbe(false, 'packages/legacy/zebra.json'),
      new ConfigProbe(true, 'packages/legacy/package.json', 1700000000123456789 as i64, 512 as i64, 'deadbeef'),
    ];
    let c0Env = new GrowableArray<(String, EnvBinding)>();
    c0Env.push(('A_LIT', new EnvLiteral('val:with\nnewline')));
    c0Env.push(('B_EXT', new EnvExternal('fallback')));
    c0Env.push(('C_EXT_NONE', new EnvExternal(null)));
    let configs = [
      new ScriptConfig(
        new ScriptRef('packages/app', 'build:all'),
        true,
        'printf "line1\nline2:ok\n" > out.txt',
        ['src/**/*.zena', '!src/ignore.zena'],
        ['out.txt'],
        true,
        true,
        [new DependencySpec(new ScriptRef('packages/legacy', 'serve'), false)],
        'if-file-deleted',
        null,
        c0Env,
        ['zena-lock.json'],
        false,
        false,
      ),
      new ScriptConfig(
        new ScriptRef('packages/app', 'source'),
        true,
        null,
        ['zena-package.json', 'src/**/*.zena'],
        new GrowableArray<String>(),
        true,
        true,
        new GrowableArray<DependencySpec>(),
        'false',
        null,
        new GrowableArray<(String, EnvBinding)>(),
        new GrowableArray<String>(),
        true,
        true,
      ),
      new ScriptConfig(
        new ScriptRef('packages/legacy', 'serve'),
        true,
        'node server.js',
        ['server.js'],
        new GrowableArray<String>(),
        true,
        false,
        new GrowableArray<DependencySpec>(),
        'true',
        new ServiceConfig('Ready: [0-9]+'),
        new GrowableArray<(String, EnvBinding)>(),
        new GrowableArray<String>(),
        true,
        false,
      ),
      new ScriptConfig(
        new ScriptRef('packages/app', 'test'),
        true,
        null,
        ['test/**/*.zena'],
        new GrowableArray<String>(),
        true,
        true,
        [new DependencySpec(new ScriptRef('packages/app', 'source'), true)],
        'false',
        null,
        new GrowableArray<(String, EnvBinding)>(),
        ['zena-lock.json'],
        true,
        false,
        new ZenaTestRule(['test/*_test.zena'], true),
        'heavy-test',
      ),
      new ScriptConfig(
        new ScriptRef('packages/app', 'build:wasm'),
        true,
        null,
        ['src/main.zena', 'wit/app.wit'],
        ['out/app.wasm'],
        true,
        true,
        [new DependencySpec(new ScriptRef('packages/app', 'source'), true)],
        'true',
        null,
        new GrowableArray<(String, EnvBinding)>(),
        ['zena-lock.json'],
        true,
        false,
        new ZenaBuildRule(
          [
            new ZenaBuildEntry(
              'src/main.zena',
              'out/app.wasm',
              'component',
              '2',
              true,
              'wit/app.wit',
              'app',
              ['wit/ext.wit'],
              'str',
              true,
            ),
          ],
          '../compiler/out/cli.wasm',
        ),
        'compile',
      ),
    ];

    let encoded = planSnapshotToText(probes, configs);
    let snapshot = planSnapshotFromText(encoded);
    let decProbes = snapshot.probes;
    let decConfigs = snapshot.configs;

    equal(decProbes.length, 2);
    isFalse(decProbes[0].exists);
    equal(decProbes[0].path, 'packages/legacy/zebra.json');
    isTrue(decProbes[1].exists);
    equal(decProbes[1].path, 'packages/legacy/package.json');
    equal(decProbes[1].modified, 1700000000123456789 as i64);
    equal(decProbes[1].size, 512 as i64);
    equal(decProbes[1].sha256, 'deadbeef');

    equal(decConfigs.length, 5);
    let c0 = decConfigs[0];
    equal(refKey(c0.ref), 'packages/app:build:all');
    isNull(c0.ruleType);
    isNull(c0.concurrencyGroup);
    equal(c0.command, 'printf "line1\nline2:ok\n" > out.txt');
    isFalse(c0.cacheEnabled);
    isFalse(c0.isFileset);
    isFalse(c0.fingerprintable);
    equal(c0.dependencies.length, 1);
    isFalse(c0.dependencies[0].cascade);
    equal(c0.env.length, 3);
    let e0 = c0.env[0][1];
    if (e0 is EnvLiteral) {
      equal(e0.value, 'val:with\nnewline');
    } else {
      throws(() => { throw new Error('expected EnvLiteral'); });
    }

    let c1 = decConfigs[1];
    isTrue(c1.isFileset);
    isNull(c1.command);

    let c2 = decConfigs[2];
    isFalse(c2.isFileset);
    let svc = c2.service;
    isNotNull(svc);
    if (svc != null) {
      equal(svc.readyWhenLineMatches, 'Ready: [0-9]+');
    }

    let c3 = decConfigs[3];
    isNull(c3.command);
    equal(c3.ruleType, ZENA_TEST_RULE_TYPE);
    equal(c3.concurrencyGroup, 'heavy-test');
    isTrue(c3.testDebug);
    let c3Tests = c3.tests ?? new GrowableArray<String>();
    equal(c3Tests.length, 1);
    equal(c3Tests[0], 'test/*_test.zena');

    let c4 = decConfigs[4];
    isNull(c4.command);
    equal(c4.ruleType, ZENA_BUILD_RULE_TYPE);
    equal(c4.concurrencyGroup, 'compile');
    let c4Rule = c4.rule;
    if (c4Rule is ZenaBuildRule) {
      equal(c4Rule.compiler, '../compiler/out/cli.wasm');
      equal(c4Rule.entries.length, 1);
      let b0 = c4Rule.entries[0];
      equal(b0.entry, 'src/main.zena');
      equal(b0.output, 'out/app.wasm');
      equal(b0.target, 'component');
      equal(b0.opt, '2');
      isTrue(b0.debug);
      equal(b0.wit, 'wit/app.wit');
      equal(b0.world, 'app');
      equal(b0.extensionWit.length, 1);
      equal(b0.extensionWit[0], 'wit/ext.wit');
      equal(b0.importedStringConstants, 'str');
      isTrue(b0.compactImports);
    } else {
      throws(() => { throw new Error('expected ZenaBuildRule'); });
    }

    throws(() => {
      planSnapshotFromText('wrong-header\n');
    });
    throws(() => {
      planSnapshotFromText(`${encoded}extra`);
    });
  });

  test('concurrencyGroups and script concurrencyGroup parse and validate', async () => {
    let files = {
      'zena-package.json' => `{
        "workspace": {"packages": ["packages/*"]},
        "concurrencyGroups": {
          "#": "Comment ignored",
          "cache": 12,
          "cargo": {"limit": 1, "parent": "default"},
          "compile": {"parent": "default"}
        },
        "scripts": {
          "a": {"command": "true", "concurrencyGroup": "cargo"}
        }
      }`,
      'packages/bad-root/zena-package.json' => `{
        "name": "bad-root",
        "concurrencyGroups": {"x": 2},
        "scripts": {"a": {"command": "true"}}
      }`,
    };
    let read = async (path: String): Future<String?> => {
      if (let (true, content) = files.get(path)) {
        return content;
      }
      return null;
    };

    let groups = await readWorkspaceConcurrencyGroups(read);
    equal(groups.size, 3);
    if (let (true, cache) = groups.get('cache')) {
      isTrue(cache.hasLimit);
      equal(cache.limit, 12);
      isNull(cache.parent);
    } else {
      throws(() => { throw new Error('missing cache group'); });
    }
    if (let (true, cargo) = groups.get('cargo')) {
      isTrue(cargo.hasLimit);
      equal(cargo.limit, 1);
      equal(cargo.parent, 'default');
    } else {
      throws(() => { throw new Error('missing cargo group'); });
    }
    if (let (true, compile) = groups.get('compile')) {
      isFalse(compile.hasLimit);
      equal(compile.parent, 'default');
    } else {
      throws(() => { throw new Error('missing compile group'); });
    }

    let ws = new ZebraWorkspace(read);
    let scriptA = await ws.scriptConfig(new ScriptRef('', 'a'));
    equal(scriptA.concurrencyGroup, 'cargo');

    // Non-root packages may not declare concurrencyGroups.
    await rejects(async () => {
      await ws.scriptConfig(new ScriptRef('packages/bad-root', 'a'));
    });

    // Invalid concurrencyGroups shapes fail with ConfigError.
    let checkBadRoot = async (json: String) => {
      await rejects(async () => {
        await readWorkspaceConcurrencyGroups(async (path): Future<String?> =>
          if (path == 'zebra.json') json else null,
        );
      });
    };
    await checkBadRoot(`{"concurrencyGroups": 4}`);
    await checkBadRoot(`{"concurrencyGroups": {"x": 0}}`);
    await checkBadRoot(`{"concurrencyGroups": {"x": 1.5}}`);
    await checkBadRoot(`{"concurrencyGroups": {"x": {}}}`);
    await checkBadRoot(`{"concurrencyGroups": {"x": {"limit": 0}}}`);
    await checkBadRoot(`{"concurrencyGroups": {"x": {"parent": ""}}}`);
    await checkBadRoot(`{"concurrencyGroups": {"x": {"unknown": 1, "limit": 1}}}`);

    // Invalid script concurrencyGroup values fail with ConfigError.
    let wsBadScript = new ZebraWorkspace(async (path): Future<String?> =>
      if (path == 'zebra.json')
        `{"scripts": {"a": {"command": "true", "concurrencyGroup": ""}}}`
      else
        null,
    );
    await rejects(async () => {
      await wsBadScript.scriptConfig(new ScriptRef('', 'a'));
    });
  });

  test('zena:build parses single and multi-entry configs, derives files/output/source, and validates errors', async () => {
    let files = {
      'zena-package.json' => `{"workspace": {"packages": ["packages/*"]}}`,
      'packages/app/zena-package.json' => `{
        "name": "app",
        "scripts": {
          "build:one": {
            "type": "zena:build",
            "entry": "src/main.zena",
            "output": "out/app.wasm",
            "target": "zena-js",
            "opt": 2,
            "debug": true,
            "importedStringConstants": "strings",
            "compactImports": true,
            "compiler": "../compiler/out/cli.wasm"
          },
          "build:many": {
            "type": "zena:build",
            "target": "component",
            "opt": "s",
            "entries": [
              {
                "entry": "fixtures/a.zena",
                "output": "out/a.wasm",
                "wit": "fixtures/a.wit",
                "world": "world-a"
              },
              {
                "entry": "fixtures/b.zena",
                "output": "out/b.wasm",
                "target": "wasi",
                "wit": "fixtures/wit-dir",
                "extensionWit": "fixtures/ext.wit"
              }
            ]
          }
        }
      }`,
    };
    let ws = new ZebraWorkspace(async (path): Future<String?> => {
      if (let (true, content) = files.get(path)) {
        return content;
      }
      return null;
    });

    let one = await ws.scriptConfig(new ScriptRef('packages/app', 'build:one'));
    equal(one.ruleType, ZENA_BUILD_RULE_TYPE);
    isTrue(one.fingerprintable);
    equal(one.output.length, 1);
    equal(one.output[0], 'out/app.wasm');
    isTrue(hasStr(one.files, 'src/main.zena'));
    isTrue(hasStr(one.files, '../compiler/out/cli.wasm'));
    equal(one.dependencies.length, 1);
    equal(refKey(one.dependencies[0].ref), 'packages/app:source');
    let oneRule = one.rule;
    if (oneRule is ZenaBuildRule) {
      equal(oneRule.compiler, '../compiler/out/cli.wasm');
      equal(oneRule.entries.length, 1);
      equal(oneRule.entries[0].opt, '2');
      isTrue(oneRule.entries[0].debug);
      equal(oneRule.entries[0].target, 'zena-js');
      equal(oneRule.entries[0].importedStringConstants, 'strings');
      isTrue(oneRule.entries[0].compactImports);
    } else {
      throws(() => { throw new Error('expected ZenaBuildRule'); });
    }

    let many = await ws.scriptConfig(new ScriptRef('packages/app', 'build:many'));
    equal(many.ruleType, ZENA_BUILD_RULE_TYPE);
    equal(many.output.length, 2);
    equal(many.output[0], 'out/a.wasm');
    equal(many.output[1], 'out/b.wasm');
    isTrue(hasStr(many.files, 'fixtures/a.zena'));
    isTrue(hasStr(many.files, 'fixtures/a.wit'));
    isTrue(hasStr(many.files, 'fixtures/b.zena'));
    isTrue(hasStr(many.files, 'fixtures/wit-dir/**/*.wit'));
    isTrue(hasStr(many.files, 'fixtures/ext.wit'));
    let manyRule = many.rule;
    if (manyRule is ZenaBuildRule) {
      equal(manyRule.entries.length, 2);
      equal(manyRule.entries[0].target, 'component');
      equal(manyRule.entries[0].opt, 's');
      equal(manyRule.entries[1].target, 'wasi');
      equal(manyRule.entries[1].opt, 's');
      equal(manyRule.entries[1].extensionWit.length, 1);
      equal(manyRule.entries[1].extensionWit[0], 'fixtures/ext.wit');
    } else {
      throws(() => { throw new Error('expected ZenaBuildRule'); });
    }

    let checkBad = async (json: String) => {
      let badWs = new ZebraWorkspace(async (path): Future<String?> =>
        if (path == 'zebra.json') json else null,
      );
      await rejects(async () => {
        await badWs.scriptConfig(new ScriptRef('', 'b'));
      });
    };
    await checkBad(`{"scripts": {"b": {"entry": "a.zena", "output": "a.wasm"}}}`);
    await checkBad(`{"scripts": {"b": {"type": "zena:build"}}}`);
    await checkBad(`{"scripts": {"b": {"type": "zena:build", "entry": "a.zena"}}}`);
    await checkBad(`{"scripts": {"b": {"type": "zena:build", "entry": "a.zena", "output": "a.wasm", "command": "true"}}}`);
    await checkBad(`{"scripts": {"b": {"type": "zena:build", "entry": "a.zena", "output": "a.wasm", "opt": "3"}}}`);
    await checkBad(`{"scripts": {"b": {"type": "zena:build", "entries": []}}}`);
    await checkBad(`{"scripts": {"b": {"type": "zena:build", "output": "x.wasm", "entries": [{"entry": "a.zena", "output": "a.wasm"}]}}}`);
    await checkBad(`{"scripts": {"b": {"type": "zena:build", "entries": [{"entry": "a.zena", "output": "dup.wasm"}, {"entry": "b.zena", "output": "dup.wasm"}]}}}`);
  });

  test('RuleRegistry lets custom rules read language config files through RuleResolveContext.readFile', async () => {
    let registry = defaultRuleRegistry();
    registry.register(new MockLangRule());
    let probed = new GrowableArray<String>();
    let files = {
      'packages/demo/zebra.json' => `{"scripts": {"build": {"type": "mock:build"}}}`,
      'packages/demo/lang.cfg' => 'dist/app.out\n',
    };
    let ws = new ZebraWorkspace(async (path): Future<String?> => {
      probed.push(path);
      if (let (true, content) = files.get(path)) {
        return content;
      }
      return null;
    }, registry);

    let cfg = await ws.scriptConfig(new ScriptRef('packages/demo', 'build'));
    equal(cfg.command, 'mockc');
    equal(cfg.output.length, 1);
    equal(cfg.output[0], 'dist/app.out');
    isTrue(hasStr(cfg.files, 'src/**/*.lang'));
    isTrue(hasStr(probed, 'packages/demo/lang.cfg'));
  });
});
