  test('SIGTERM during an in-flight build stops running scripts and active services', async (ctx) => {
    let root = '/tmp/zebra-sig-build-' + i64ToString(monotonic() as i64);
    await ensureDir(root);
    await write(root, 'package.json', `{
      "scripts": {
        "db": "wireit",
        "app": "wireit"
      },
      "wireit": {
        "db": {
          "command": "echo db-start >> svc.log && trap 'echo db-stop >> svc.log; exit 0' TERM; echo READY && while true; do sleep 0.1; done",
          "service": {"readyWhen": {"lineMatches": "^READY$"}}
        },
        "app": {
          "command": "echo app-start >> svc.log && trap 'echo app-stop >> svc.log; exit 0' TERM; echo running > app.running && while true; do sleep 0.1; done",
          "dependencies": ["db"]
        }
      }
    }`);

    let zenaBin = (getEnv('ZENA_WORKSPACE_ROOT') ?? '.') + '/target/release/zena-cli';
