      cwd: root,
    });
    while (!(await isFile(withRoot(root, 'app.running')))) {
      await sleep(milliseconds(20));
    }
    equal(await readFile(withRoot(root, 'svc.log')), 'db-start\napp-start\n');

    let stopped = await proc.stop(3000 as i64);
    isFalse(stopped.timedOut, 'expected in-flight build to exit cleanly on SIGTERM');
    equal(stopped.exitCode, 143);
    equal(await readFile(withRoot(root, 'svc.log')), 'db-start\napp-start\napp-stop\ndb-stop\n');
  });

  test('formatBuildReport renders Clack rail for ran, fresh, restored, verbose, and failed builds', async (ctx) => {
    let root = '/tmp/zebra-report-ux-' + i64ToString(monotonic() as i64);
    await ensureDir(root);
    await write(root, 'package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {"dependencies": ["./packages/app:build"]}
      }
    }`);
    await write(root, 'packages/lib/package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "command": "mkdir -p out && echo 'lib log line' && cat src/in.txt > out/lib.txt",
          "files": ["src/**"],
          "output": ["out/**"]
        }
      }
    }`);
    await write(root, 'packages/lib/src/in.txt', 'lib-v1\n');
    await write(root, 'packages/app/package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "command": "mkdir -p out && cat ../lib/out/lib.txt greeting.txt > out/app.txt",
          "files": ["greeting.txt"],
          "output": ["out/**"],
          "dependencies": ["../lib:build"]
        }
      }
    }`);
    await write(root, 'packages/app/greeting.txt', 'hello-v1\n');
    let entry = new ScriptRef('', 'build');
    let plain = Colors.plain();

    // 1. Cold build: lists ran steps on the rail and summarizes fresh (:build aggregator) in the outro.
    let first = await buildTarget(root, entry);
    let firstDefault = formatBuildReport(first, false, plain);
    isTrue(firstDefault.contains('┌  [zebra] :build'), firstDefault);
    isTrue(firstDefault.contains('◇  packages/lib:build: ran'), firstDefault);
    isTrue(firstDefault.contains('◇  packages/app:build: ran'), firstDefault);
    isFalse(firstDefault.contains('lib log line'), 'passing stdout is hidden unless verbose');
    isTrue(firstDefault.contains('└  build succeeded in '), firstDefault);
    isTrue(firstDefault.contains('(3 ran)'), firstDefault);

    // Verbose mode prints captured stdout indented along the rail.
    let firstVerbose = formatBuildReport(first, true, plain);
    isTrue(firstVerbose.contains('│  lib log line'), firstVerbose);

    // 2. Warm build: collapses fresh steps into the outro unless verbose is true.
    let second = await buildTarget(root, entry);
    let secondDefault = formatBuildReport(second, false, plain);
    isFalse(secondDefault.contains('packages/lib:build: fresh'), secondDefault);
    isTrue(secondDefault.contains('(3 fresh)'), secondDefault);

    let secondVerbose = formatBuildReport(second, true, plain);
    isTrue(secondVerbose.contains('○  packages/lib:build: fresh'), secondVerbose);
    isTrue(secondVerbose.contains('○  packages/app:build: fresh'), secondVerbose);

    // 3. Cache restore: shows restored steps with ◆ on the rail.
    await unlink(withRoot(root, 'packages/lib/.zebra/state.json'));
    let restored = await buildTarget(root, entry);
    let restoredReport = formatBuildReport(restored, false, plain);
    isTrue(restoredReport.contains('◆  packages/lib:build: restored'), restoredReport);
    isTrue(restoredReport.contains('(1 restored, 2 fresh)'), restoredReport);

    // 4. Failing step: prints ■, command, and stderr on the rail even when not verbose.
    await write(root, 'packages/app/package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "command": "echo 'boom on stderr' >&2 && exit 1",
          "files": ["greeting.txt"],
          "output": ["out/**"],
          "dependencies": ["../lib:build"]
        }
      }
    }`);
    let failed = await buildTarget(root, entry);
    let failedDefault = formatBuildReport(failed, false, plain);
    isTrue(failedDefault.contains('■  packages/app:build: failed (exit 1)'), failedDefault);
    isTrue(failedDefault.contains('│  $ echo \'boom on stderr\' >&2 && exit 1'), failedDefault);
    isTrue(failedDefault.contains('│  boom on stderr'), failedDefault);
    isTrue(failedDefault.contains('└  build failed in '), failedDefault);
    isTrue(failedDefault.contains('(1 failed, 1 skipped, 1 fresh)'), failedDefault);

    let failedVerbose = formatBuildReport(failed, true, plain);
    isTrue(failedVerbose.contains('▲  :build: skipped'), failedVerbose);
  });

  test('zebra.json builds, tracks zena-lock.json by default, and reuses cached plan snapshots with zero config parses', async () => {
    let root = `/tmp/zebra-native-plan-${i64ToString(monotonic() as i64)}`;
    await ensureDir(root);
    await write(root, 'zena-lock.json', '{"resolved": {}}\n');
    await write(root, 'zebra.json', `{
      // Root standalone Zebra config
      "scripts": {
        "build": {
          "dependencies": ["./packages/app:check", "./packages/legacy:build"]
        }
      }
    }`);
    await write(root, 'packages/app/src.zena', 'export let v = 1;\n');
    await write(root, 'packages/app/zebra.json', `{
      "scripts": {
        "check": {
          "command": "cat src.zena ../legacy/out.txt > checked.log && rm checked.log",
          "files": ["src.zena"],
          "dependencies": ["../legacy:build"]
        }
      }
    }`);
    await write(root, 'packages/legacy/in.txt', 'legacy-v1\n');
    await write(root, 'packages/legacy/package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "command": "printf 'legacy-1\\n' > out.txt",
          "files": ["in.txt"],
          "output": ["out.txt"]
        }
      }
    }`);

    let entry = new ScriptRef('', 'build');

    // 1. Cold build parses the 3 reachable config files and writes the plan snapshot.
    let stats1 = new PlanLoadStats();
    let r1 = await buildTarget(root, entry, {planStatsOut: stats1});
    isTrue(r1.result.allSucceeded, 'cold build succeeds');
    isFalse(stats1.fromSnapshot, 'first run resolves configs fresh');
    equal(stats1.filesParsed, 3);
    isTrue(sourceOf(r1.result, 'packages/legacy:build') == StepSource.Ran);
    isTrue(sourceOf(r1.result, 'packages/app:check') == StepSource.Ran);

    // 2. Warm build reuses the plan snapshot with zero config files parsed.
    let stats2 = new PlanLoadStats();
    let r2 = await buildTarget(root, entry, {planStatsOut: stats2});
    isTrue(r2.result.allSucceeded, 'warm build succeeds');
    isTrue(stats2.fromSnapshot, 'warm build loads plan snapshot');
    equal(stats2.filesParsed, 0);
    isTrue(sourceOf(r2.result, 'packages/legacy:build') == StepSource.Fresh);
    isTrue(sourceOf(r2.result, 'packages/app:check') == StepSource.Fresh);

    // 3. Editing zena-lock.json invalidates the zebra.json step (without changing zebra.json).
    await write(root, 'zena-lock.json', '{"resolved": {"pkg": "v2"}}\n');
    let stats3 = new PlanLoadStats();
    let r3 = await buildTarget(root, entry, {planStatsOut: stats3});
    isTrue(r3.result.allSucceeded);
    isTrue(stats3.fromSnapshot, 'lockfile change keeps plan snapshot valid');
    isTrue(sourceOf(r3.result, 'packages/legacy:build') == StepSource.Fresh);
    isTrue(sourceOf(r3.result, 'packages/app:check') == StepSource.Ran);

    // 4. Same-byte-length edit to legacy/package.json invalidates the plan snapshot.
    await write(root, 'packages/legacy/package.json', `{
      "scripts": {"build": "wireit"},
      "wireit": {
        "build": {
          "command": "printf 'legacy-2\\n' > out.txt",
          "files": ["in.txt"],
          "output": ["out.txt"]
        }
      }
    }`);
    let stats4 = new PlanLoadStats();
    let r4 = await buildTarget(root, entry, {planStatsOut: stats4});
    isTrue(r4.result.allSucceeded);
    isFalse(stats4.fromSnapshot, 'config edit invalidates plan snapshot');
    equal(await readFile(withRoot(root, 'packages/legacy/out.txt')), 'legacy-2\n');

    // 5. Adding zebra.json to packages/legacy (without touching package.json)
    // invalidates the plan snapshot because the missing zebra.json probe flips.
    await write(root, 'packages/legacy/zebra.json', `{
      "scripts": {
        "build": {
          "command": "printf 'native-zebra\\n' > out.txt",
          "files": ["in.txt"],
          "output": ["out.txt"]
        }
      }
    }`);
    let stats5 = new PlanLoadStats();
    let r5 = await buildTarget(root, entry, {planStatsOut: stats5});
    isTrue(r5.result.allSucceeded);
    isFalse(stats5.fromSnapshot, 'new zebra.json invalidates plan snapshot');
    equal(await readFile(withRoot(root, 'packages/legacy/out.txt')), 'native-zebra\n');
  });

  test('zena-package.json scripts track transitive path-dependency :source filesets while ignoring upstream test edits', async () => {
    let root = `/tmp/zebra-zena-pkg-fileset-${i64ToString(monotonic() as i64)}`;
    await ensureDir(root);
    let plain = Colors.plain();

    await write(root, 'zena-package.json', `{
      "workspace": {"packages": ["packages/*"]}
    }`);
    await write(root, 'packages/lib/zena-package.json', `{
      "name": "lib",
      "source": "."
    }`);
    await write(root, 'packages/lib/answer.zena', 'export let answer = 41;\n');
    await write(root, 'packages/lib/test/answer_test.zena', '// test v1\n');

    await write(root, 'packages/app/zena-package.json', `{
      "name": "app",
      "dependencies": {
        "lib": {"path": "../lib"}
      },
      "scripts": {
        "build": {
          "command": "mkdir -p out && cat ../lib/answer.zena src/app.zena > out/bundle.txt",
          "output": ["out/bundle.txt"],
          "dependencies": ["source"]
        }
      }
    }`);
    await write(root, 'packages/app/src/app.zena', 'export let appVal = 1;\n');

    let entry = new ScriptRef('packages/app', 'build');

    // 1. Cold build runs `packages/app:build` and omits `:source` filesets from the rail report.
    let r1 = await buildTarget(root, entry);
    isTrue(r1.result.allSucceeded);
    let report1 = formatBuildReport(r1, false, plain);
    isTrue(report1.contains('◇  packages/app:build: ran'), report1);
    isFalse(report1.contains(':source'), report1);
    isTrue(report1.contains('(1 ran)'), report1);

    // 2. Warm build hits plan snapshot and stays fresh.
    let stats2 = new PlanLoadStats();
    let r2 = await buildTarget(root, entry, {planStatsOut: stats2});
    isTrue(stats2.fromSnapshot);
    equal(stats2.filesParsed, 0);
    isTrue(sourceOf(r2.result, 'packages/app:build') == StepSource.Fresh);

    // 3. Editing a test file inside `packages/lib` (`"source": "."`) does NOT invalidate `:source`.
    await write(root, 'packages/lib/test/answer_test.zena', '// test v2 edited\n');
    let r3 = await buildTarget(root, entry);
    isTrue(sourceOf(r3.result, 'packages/app:build') == StepSource.Fresh);

    // 4. Editing a library source file in `packages/lib` invalidates `packages/lib:source` -> `packages/app:source` -> `packages/app:build`.
    await write(root, 'packages/lib/answer.zena', 'export let answer = 42;\n');
    let r4 = await buildTarget(root, entry);
    isTrue(sourceOf(r4.result, 'packages/app:build') == StepSource.Ran);
    isTrue(
      (await readFile(withRoot(root, 'packages/app/out/bundle.txt'))).contains('answer = 42'),
    );
  });

  test('bare directory output globs cache nested files and restore atomically without truncating existing inodes', async () => {
    let root = `/tmp/zebra-dir-out-atomic-${i64ToString(monotonic() as i64)}`;
    await ensureDir(root);
    await write(root, 'packages/lib/src/in.txt', 'v1\n');
    await write(root, 'packages/lib/zebra.json', `{
      "scripts": {
        "build": {
          "command": "mkdir -p lib/sub && printf 'index-%s\\n' \"$(cat src/in.txt)\" > lib/index.js && printf 'util-%s\\n' \"$(cat src/in.txt)\" > lib/sub/util.js && printf 'tsb\\n' > tsconfig.tsbuildinfo",
          "files": ["src"],
          "output": ["lib", "tsconfig.tsbuildinfo"]
        }
      }
    }`);
    let entry = new ScriptRef('packages/lib', 'build');

    let first = await buildTarget(root, entry);
    isTrue(first.result.allSucceeded);
    isTrue(sourceOf(first.result, 'packages/lib:build') == StepSource.Ran);
    equal(await readFile(withRoot(root, 'packages/lib/lib/sub/util.js')), 'util-v1\n');

    // Deleting a nested file inside bare `"output": ["lib"]` invalidates freshness and restores from DiskCache.
    await unlink(withRoot(root, 'packages/lib/lib/sub/util.js'));
    let restoredMissing = await buildTarget(root, entry);
    isTrue(restoredMissing.result.allSucceeded);
    isTrue(sourceOf(restoredMissing.result, 'packages/lib:build') == StepSource.Cache);
    equal(await readFile(withRoot(root, 'packages/lib/lib/sub/util.js')), 'util-v1\n');

    // Corrupt `lib/index.js` and pin its inode via a second hardlink (`pinned.js` outside `lib/`).
    // Restoring from DiskCache must unlink/rename over `lib/index.js` rather than truncating the pinned inode in place.
    await sleep(milliseconds(10));
    await write(root, 'packages/lib/lib/index.js', 'corrupted-inode\n');
    let linked = await runWith(['ln', 'lib/index.js', 'pinned.js'], {
      cwd: withRoot(root, 'packages/lib'),
    });
    isTrue(linked.succeeded(), linked.stderr);

    let restoredAtomic = await buildTarget(root, entry);
    isTrue(restoredAtomic.result.allSucceeded);
    isTrue(sourceOf(restoredAtomic.result, 'packages/lib:build') == StepSource.Cache);
    equal(await readFile(withRoot(root, 'packages/lib/lib/index.js')), 'index-v1\n');
    equal(
      await readFile(withRoot(root, 'packages/lib/pinned.js')),
      'corrupted-inode\n',
      'existing inode must not be truncated in place during cache restore',
    );
    for (let dirent in await listDir(withRoot(root, 'packages/lib/lib'))) {
      isFalse(dirent.name.contains('.tmp-'), `leftover temp file ${dirent.name}`);
    }
  });

  test('stepKeys and reports follow topological dependency order, and defaultParallelism honors ZEBRA_PARALLEL and WIREIT_PARALLEL', async () => {
    let root = `/tmp/zebra-topo-order-${i64ToString(monotonic() as i64)}`;
    await mkFixture(root);
    await write(root, 'packages/app/greeting.txt', 'hi\n');

    let outcome = await buildTarget(root, new ScriptRef('', 'build'));
    isTrue(outcome.result.allSucceeded);
    equal(outcome.stepKeys.length, 3);
    equal(outcome.stepKeys[0], 'packages/lib:build');
    equal(outcome.stepKeys[1], 'packages/app:build');
    equal(outcome.stepKeys[2], ':build');

    let report = formatBuildReport(outcome, false, Colors.plain());
    var libLine = -1;
    var appLine = -1;
    var rootLine = -1;
    let reportLines = report.split('\n');
    for (var i = 0; i < reportLines.length; i += 1) {
      let line = reportLines[i];
      if (line.contains('packages/lib:build: ran')) libLine = i;
      else if (line.contains('packages/app:build: ran')) appLine = i;
      else if (line.contains(':build: ran')) rootLine = i;
    }
    isTrue(libLine >= 0 && appLine > libLine && rootLine > appLine, report);

    // ZEBRA_PARALLEL takes precedence over WIREIT_PARALLEL and ZENA_AVAILABLE_PARALLELISM.
    equal(
      defaultParallelism((k): String? => {
        if (k == 'ZEBRA_PARALLEL') return '3';
        if (k == 'WIREIT_PARALLEL') return '5';
        if (k == 'ZENA_AVAILABLE_PARALLELISM') return '12';
        return null;
      }),
      3,
    );
    equal(
      defaultParallelism((k): String? => {
        if (k == 'WIREIT_PARALLEL') return '5';
        if (k == 'ZENA_AVAILABLE_PARALLELISM') return '12';
        return null;
      }),
      5,
    );
    equal(
      defaultParallelism((k): String? => {
        if (k == 'ZEBRA_PARALLEL') return 'invalid';
        if (k == 'WIREIT_PARALLEL') return '4';
        return null;
      }),
      4,
    );
    equal(defaultParallelism((_): String? => null), 8);
  });

  test('extraArgs run only on the entry script with shell quoting and never cache or clobber saved freshness', async () => {
    let root = `/tmp/zebra-extra-args-${i64ToString(monotonic() as i64)}`;
    await ensureDir(root);
    await write(root, 'zebra.json', `{
      "scripts": {
        "build": {
          "dependencies": ["./packages/app:test"]
        }
      }
    }`);
    await write(root, 'packages/lib/in.txt', 'lib-1\n');
    await write(root, 'packages/lib/zebra.json', `{
      "scripts": {
        "build": {
          "command": "printf '%s:%s\\n' \"$#\" \"$(cat in.txt)\" > out.txt",
          "files": ["in.txt"],
          "output": ["out.txt"]
        }
      }
    }`);
    await write(root, 'packages/app/src/app.txt', 'app-1\n');
    await write(root, 'packages/app/run-tests.sh', `printf '%s|%s|%s\\n' "$#" "$1" "$2" > last-run.txt\n`);
    await write(root, 'packages/app/zebra.json', `{
      "scripts": {
        "test": {
          "command": "sh run-tests.sh",
          "files": ["src/**", "run-tests.sh"],
          "output": [],
          "dependencies": ["../lib:build"]
        }
      }
    }`);

    let entry = new ScriptRef('packages/app', 'test');

    // 1. Cold filtered run: dependency runs with 0 extra args and is saved fresh;
    // entry runs with quoted extra args (preserving single quotes and `$HOME` literally).
    let r1 = await buildTarget(root, entry, {
      extraArgs: ['--filter', "it's $HOME"],
    });
    isTrue(r1.result.allSucceeded);
    isTrue(sourceOf(r1.result, 'packages/lib:build') == StepSource.Ran);
    isTrue(sourceOf(r1.result, 'packages/app:test') == StepSource.Ran);
    equal(await readFile(withRoot(root, 'packages/lib/out.txt')), '0:lib-1\n');
    equal(
      await readFile(withRoot(root, 'packages/app/last-run.txt')),
      "2|--filter|it's $HOME\n",
    );

    // 2. Subsequent plain run: dependency is Fresh, while entry MUST run unfiltered
    // because the filtered run did not persist freshness or cache for the entry step.
    let r2 = await buildTarget(root, entry);
    isTrue(r2.result.allSucceeded);
    isTrue(sourceOf(r2.result, 'packages/lib:build') == StepSource.Fresh);
    isTrue(sourceOf(r2.result, 'packages/app:test') == StepSource.Ran);
    equal(await readFile(withRoot(root, 'packages/app/last-run.txt')), '0||\n');

    // 3. Filtered run over an already-fresh entry still executes with extraArgs...
    let r3 = await buildTarget(root, entry, {extraArgs: ['variables']});
    isTrue(r3.result.allSucceeded);
    isTrue(sourceOf(r3.result, 'packages/lib:build') == StepSource.Fresh);
    isTrue(sourceOf(r3.result, 'packages/app:test') == StepSource.Ran);
    equal(await readFile(withRoot(root, 'packages/app/last-run.txt')), '1|variables|\n');

    // 4. ...and does not clobber the prior unfiltered freshness record when nothing changed.
    let r4 = await buildTarget(root, entry);
    isTrue(r4.result.allSucceeded);
    isTrue(sourceOf(r4.result, 'packages/app:test') == StepSource.Fresh);

    // 5. Passing extraArgs to a command-less group target fails cleanly.
    await rejects(async () => {
      await buildTarget(root, new ScriptRef('', 'build'), {
        extraArgs: ['--filter', 'x'],
      });
    });
  });
});
