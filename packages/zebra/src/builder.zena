} from './wireit-config.zena';

export {
  ConcurrencyGroupConfig,
  ConcurrencyGroups,
  DEFAULT_CONCURRENCY_GROUP,
} from 'workflow/concurrency';
export {
  RuleConfig,
  ZENA_BUILD_RULE_TYPE,
  ZENA_TEST_RULE_TYPE,
  ZenaBuildEntry,
  ZenaBuildRule,
  ZenaTestRule,
} from './wireit-config.zena';

/** Captured command output and wall-clock duration for a step that executed. */
export class StepExecution {
  command: String;
  exitCode: i32;
  stdout: String;
  stderr: String;
  durationMs: i64;

  new(this.command, this.exitCode, this.stdout, this.stderr, this.durationMs);

  combinedOutput(): String {
    if (this.stdout == '') {
      return this.stderr;
    }
    if (this.stderr == '') {
      return this.stdout;
    }
    if (this.stdout.endsWith('\n')) {
      return this.stdout + this.stderr;
    }
    return `${this.stdout}\n${this.stderr}`;
  }
}

/** Built-in child concurrency group for in-process compiler batch workers. */
export let COMPILE_CONCURRENCY_GROUP = 'compile';

/** Built-in child concurrency group for in-process `zena:test` execution. */
export let TEST_CONCURRENCY_GROUP = 'test';

/** Parameters for running one package's native Zena `"tests"` step. */
export class TestStepRequest {
  root: String;
  packageDir: String;
  patterns: Array<String>;
  extraArgs: Array<String>;
  env: Array<(String, String)>;
  envRemove: Array<String>;
  debug: boolean;
  /** Engine concurrency group tree for this run, or `null` when run standalone. */
  concurrency: ConcurrencyGroups?;
  /** Explicit concurrency group for test execution (`null` uses `'test'`). */
  testGroup: String?;

  new(
    this.root,
    this.packageDir,
    this.patterns,
    this.extraArgs,
    this.env,
    this.envRemove,
    this.debug,
    this.concurrency = null,
    this.testGroup = null,
  );
}

/**
 * In-process executor for native Zena `"tests"` steps, supplied by `zena`
 * so test targets compile and run without spawning shell or CLI child processes.
 */
export interface TestStepRunner {
  /**
   * Identity of the compiler and standard library running tests, evaluated
   * lazily after a step's dependencies settle so upstream compiler builds
   * invalidate downstream test steps in the same run.
   */
  fingerprint(): Future<String>;
  /** Runs one package's Zena test step and returns its captured output and status. */
  runTests(request: TestStepRequest): Future<StepExecution>;
}

/** Parameters for running one package's native `"type": "zena:build"` step. */
export class BuildStepRequest {
  root: String;
  packageDir: String;
  entries: Array<ZenaBuildEntry>;
  /** Optional workspace-relative path to an explicit compiler `.wasm` module. */
  compiler: String?;
  env: Array<(String, String)>;
  envRemove: Array<String>;
  /** Engine concurrency group tree for this run, or `null` when run standalone. */
  concurrency: ConcurrencyGroups?;
  /** Explicit concurrency group for compilation (`null` uses `'compile'`). */
  buildGroup: String?;

  new(
    this.root,
    this.packageDir,
    this.entries,
    this.compiler = null,
    this.env = new GrowableArray<(String, String)>(),
    this.envRemove = new GrowableArray<String>(),
    this.concurrency = null,
    this.buildGroup = null,
  );
}

/**
 * In-process executor for native `"type": "zena:build"` steps, supplied by
 * `zena` so compilation targets share `CompileSession` instances and run
 * without spawning shell or CLI child processes.
 */
export interface BuildStepRunner {
  /**
   * Identity of the compiler and standard library building targets, evaluated
   * lazily after upstream dependencies settle. `compilerOverride` is a
   * workspace-relative `.wasm` path when `"compiler"` is set, or `null` for
   * the default CLI compiler.
   */
  fingerprint(compilerOverride: String?): Future<String>;
  /** Compiles all entries in one `"type": "zena:build"` step. */
  runBuild(request: BuildStepRequest): Future<StepExecution>;
}

/** A planned build: the step graph, initial leaf map, and captured step runs. */
export class Plan {
  graph: Graph;
  leaves: HashMap<String, Fingerprint>;
  executions: HashMap<String, StepExecution>;

  new(
    this.graph,
    this.leaves,
    this.executions = new HashMap<String, StepExecution>(),
  );
}

function appendSegment(sb: StringBuilder, s: String) {
  sb.appendI32(s.length);
  sb.append(':');
  sb.append(s);
}

function appendEnvSegments(
  sb: StringBuilder,
  env: Array<(String, EnvBinding)>,
) {
  for (let (name, binding) in env) {
    match (binding) {
      case EnvLiteral as lit: {
        appendSegment(sb, 'env:' + name);
        appendSegment(sb, lit.value);
      }
      case EnvExternal as ext: {
        let effective = getEnv(name) ?? ext.defaultValue;
        if (effective != null) {
          appendSegment(sb, 'env-ext:' + name);
          appendSegment(sb, effective);
        } else {
          appendSegment(sb, 'env-unset:' + name);
        }
      }
    }
  }
}

/**
 * Remote-cache variables consumed by the outer Zebra process. Child scripts
 * and services strip these from their inherited environment unless their own
 * `env` config declares them, so nested builds and test suites do not read or
 * write the outer run's remote cache.
 */
export let REMOTE_CACHE_ENV_VARS = [
  'ZEBRA_CACHE',
  'ZEBRA_CACHE_READ_ONLY',
  'ZEBRA_GITHUB_CUSTODIAN_URL',
  'WIREIT_CACHE_GITHUB_CUSTODIAN_PORT',
];

/** Concrete `(name, value)` pairs to pass in `SpawnOptions.env`. */
function resolveEnvOverrides(
  env: Array<(String, EnvBinding)>,
): Array<(String, String)> {
  let overrides = new GrowableArray<(String, String)>();
  for (let (name, binding) in env) {
    match (binding) {
      case EnvLiteral as lit: {
        overrides.push((name, lit.value));
      }
      case EnvExternal as ext: {
        if (getEnv(name) == null) {
          let def = ext.defaultValue;
          if (def != null) {
            overrides.push((name, def));
          }
        }
      }
    }
  }
  return overrides;
}

/** Remote-cache variables to omit from `SpawnOptions.envRemove`. */
function resolveEnvRemovals(
  env: Array<(String, EnvBinding)>,
): Array<String> {
  let removals = new GrowableArray<String>();
  for (let candidate in REMOTE_CACHE_ENV_VARS) {
    var declared = false;
    for (let (name, _) in env) {
      if (name == candidate) {
        declared = true;
        break;
      }
    }
    if (!declared) {
      removals.push(candidate);
    }
  }
  return removals;
}

function configFingerprint(
  config: ScriptConfig,
  salt: String,
  forceSalted: boolean = false,
  hasInProcessTestRunner: boolean = false,
  hasInProcessBuildRunner: boolean = false,
) {
  let sb = new StringBuilder();
  appendSegment(sb, 'zebra-config-v1');
  let command = config.command;
  appendSegment(sb, command ?? '');
  appendSegment(sb, config.clean);
  appendSegment(sb, if (config.isWireit) 'wireit' else 'bare');
  let svc = config.service;
  if (svc != null) {
    let pattern = svc.readyWhenLineMatches;
    appendSegment(
      sb,
      if (pattern != null) 'service:line:' + pattern else 'service:ready',
    );
  } else {
    appendSegment(sb, 'service:none');
  }
  let rule = config.rule;
  if (rule != null) {
    match (rule) {
      case ZenaTestRule as tr: {
        appendSegment(sb, 'type:' + ZENA_TEST_RULE_TYPE);
        for (let pat in tr.patterns) {
          appendSegment(sb, 'test-glob:' + pat);
        }
        appendSegment(sb, if (tr.debug) 'test-debug:1' else 'test-debug:0');
        appendSegment(
          sb,
          if (hasInProcessTestRunner) 'test-runner:in-process' else 'test-runner:shell',
        );
      }
      case ZenaBuildRule as br: {
        appendSegment(sb, 'type:' + ZENA_BUILD_RULE_TYPE);
        appendSegment(sb, 'build-compiler:' + (br.compiler ?? ''));
        for (let item in br.entries) {
          appendSegment(sb, 'build-entry:' + item.entry);
          appendSegment(sb, 'build-output:' + item.output);
          appendSegment(sb, 'build-target:' + (item.target ?? ''));
          appendSegment(sb, 'build-opt:' + (item.opt ?? ''));
          appendSegment(sb, if (item.debug) 'build-debug:1' else 'build-debug:0');
          appendSegment(sb, 'build-wit:' + (item.wit ?? ''));
          appendSegment(sb, 'build-world:' + (item.world ?? ''));
          for (let ext in item.extensionWit) {
            appendSegment(sb, 'build-ext-wit:' + ext);
          }
          appendSegment(sb, 'build-strings:' + (item.importedStringConstants ?? ''));
          appendSegment(sb, if (item.compactImports) 'build-compact:1' else 'build-compact:0');
        }
        appendSegment(
          sb,
          if (hasInProcessBuildRunner) 'build-runner:in-process' else 'build-runner:shell',
        );
      }
    }
  }
  for (let glob in config.files) {
    appendSegment(sb, 'file:' + glob);
  }
  for (let glob in config.output) {
    appendSegment(sb, 'out:' + glob);
  }
  for (let lock in config.packageLocks) {
    appendSegment(sb, 'lock:' + lock);
  }
  appendEnvSegments(sb, config.env);
  if (forceSalted || !config.fingerprintable) {
    // Bare npm scripts, scripts with undeclared inputs/outputs, and
    // foreground top-level services must never go fresh or hit cache.
    appendSegment(sb, 'salt:' + salt);
  }
  return new Fingerprint('sha256:' + sha256HexOfString(sb.toString()));
}

async function cleanOutputs(
  root: String,
  config: ScriptConfig,
  ctx: RunContext,
): Future<void> {
  if (config.clean == 'false') {
    return;
  }
  if (config.clean == 'if-file-deleted') {
    let delta = ctx.delta;
    if (delta == null || delta.removed.length == 0) {
      return;
    }
  }
  let previous = ctx.previous;
  if (previous != null) {
    for (let entry in previous.outputs) {
      if (entry.fingerprint.value.startsWith('sha256:')) {
        await deleteIfExists(withRoot(root, entry.name));
      }
    }
  } else {
    for (let path in await expandGlobs(root, config.ref.packageDir, config.output)) {
      await deleteIfExists(withRoot(root, path));
    }
  }
}

/**
 * The PATH prefix npm would give the script: the package's own
 * node_modules/.bin and the workspace root's, relative to the package
 * directory the command runs in.
 */
function binPathPrefix(packageDir: String) {
  if (packageDir == '') {
    return 'node_modules/.bin';
  }
  let up = new StringBuilder();
  for (let segment in packageDir.split('/')) {
    if (segment != '') {
      up.append('../');
    }
  }
  return `node_modules/.bin:${up.toString()}node_modules/.bin`;
}

function fallbackTestShellCommand(
  patterns: Array<String>,
  extraArgs: Array<String>,
  debug: boolean,
) {
  let base = if (debug) 'zena -g test' else 'zena test';
  let allArgs = new GrowableArray<String>();
  for (let p in patterns) {
    allArgs.push(p);
  }
  for (let a in extraArgs) {
    allArgs.push(a);
  }
  return appendShellArgs(base, allArgs);
}

function fallbackBuildShellCommand(
  entries: Array<ZenaBuildEntry>,
  compiler: String?,
) {
  let sb = new StringBuilder();
  for (var i = 0; i < entries.length; i += 1) {
    if (i > 0) {
      sb.append(' && ');
    }
    let item = entries[i];
    let args = new GrowableArray<String>();
    if (item.debug) {
      args.push('-g');
    }
    let opt = item.opt;
    if (opt != null) {
      args.push('-O');
      args.push(opt);
    }
    args.push('build');
    args.push(item.entry);
    args.push('-o');
    args.push(item.output);
    let target = item.target;
    if (target != null) {
      args.push('--target');
      args.push(target);
    }
    let wit = item.wit;
    if (wit != null) {
      args.push('--wit');
      args.push(wit);
    }
    let world = item.world;
    if (world != null) {
      args.push('--world');
      args.push(world);
    }
    for (let ext in item.extensionWit) {
      args.push('--extension-wit');
      args.push(ext);
    }
    let strings = item.importedStringConstants;
    if (strings != null) {
      args.push('--imported-string-constants');
      args.push(strings);
    }
    if (item.compactImports) {
      args.push('--compact-imports');
    }
    let prefix = if (compiler != null)
      appendShellArgs(`ZENA_COMPILER_WASM=${compiler} zena`, args)
    else
      appendShellArgs('zena', args);
    sb.append(prefix);
  }
  return sb.toString();
}

/**
 * Runs one script's command (or declarative `zena:test` / `zena:build` rule)
 * and collects its outputs. Shell commands run through `sh -c` in the package
 * directory with node_modules/.bin on PATH, like wireit through npm, and await
 * exit asynchronously so independent steps run in parallel.
 */
export async function runScript(
  root: String,
  config: ScriptConfig,
  ctx: RunContext,
  volatileMark: String?,
  hasher: FileHasher?,
  executions: HashMap<String, StepExecution>? = null,
  testRunner: TestStepRunner? = null,
  buildRunner: BuildStepRunner? = null,
): Future<OutputManifest> {
  let command = config.command;
  let rule = config.rule;
  if (command == null && rule == null && config.output.length == 0) {
    // Command-less group or fileset scripts forward their resolved
    // inputs as virtual entries so upstream manifest changes (and
    // $volatile markers) propagate to downstream dependents.
    let forwarded = new GrowableArray<OutputEntry>();
    for (let inp in ctx.inputs) {
      forwarded.push(new OutputEntry(
        '$in:' + inp.name,
        new Fingerprint('ref:' + inp.fingerprint.value),
      ));
    }
    return new OutputManifest(forwarded);
  }
  if (rule is ZenaTestRule) {
    let key = refKey(config.ref);
    let sigBefore = checkSignal();
    if (sigBefore != 0) {
      throw new Error(
        `script "${key}" interrupted by signal ${i32ToString(sigBefore)}`,
      );
    }
    let extra = rule.extraArgs ?? new GrowableArray<String>();
    let envOverrides = resolveEnvOverrides(config.env);
    let envRemovals = resolveEnvRemovals(config.env);
    var exec: StepExecution | null = null;
    if (testRunner != null) {
      exec = await testRunner.runTests(
        new TestStepRequest(
          root,
          config.ref.packageDir,
          rule.patterns,
          extra,
          envOverrides,
          envRemovals,
          rule.debug,
          ctx.concurrency,
          config.concurrencyGroup,
        ),
      );
    } else {
      let startNs = monotonic() as i64;
      let cwd = withRoot(root, config.ref.packageDir);
      let shellCmd = fallbackTestShellCommand(rule.patterns, extra, rule.debug);
      let wrapped =
        `export PATH="${binPathPrefix(config.ref.packageDir)}:$PATH"; ${shellCmd}`;
      let result = await runWith(['sh', '-c', wrapped], {
        cwd: cwd,
        env: envOverrides,
        envRemove: envRemovals,
        processGroup: true,
      });
      let durationMs = div((monotonic() as i64) - startNs, 1000000 as i64);
      exec = new StepExecution(
        shellCmd,
        result.exitCode,
        result.stdout,
        result.stderr,
        durationMs,
      );
    }
    let sigAfter = checkSignal();
    if (sigAfter != 0) {
      throw new Error(
        `script "${key}" interrupted by signal ${i32ToString(sigAfter)}`,
      );
    }
    let finished = exec;
    if (executions != null) {
      executions[key] = finished;
    }
    if (finished.exitCode != 0) {
      throw new Error(
        `script "${key}" failed (exit ${i32ToString(finished.exitCode)}): ${finished.command}\n` +
        finished.stdout + finished.stderr,
      );
    }
  } else if (rule is ZenaBuildRule) {
    let key = refKey(config.ref);
    let sigBefore = checkSignal();
    if (sigBefore != 0) {
      throw new Error(
        `script "${key}" interrupted by signal ${i32ToString(sigBefore)}`,
      );
    }
    if (hasher != null) {
      hasher.markMutated();
    }
    await cleanOutputs(root, config, ctx);
    let envOverrides = resolveEnvOverrides(config.env);
    let envRemovals = resolveEnvRemovals(config.env);
    let wsCompiler = if (rule.compiler != null)
      joinWorkspace(config.ref.packageDir, rule.compiler)
    else
      null;
    var exec: StepExecution | null = null;
    if (buildRunner != null) {
      exec = await buildRunner.runBuild(
        new BuildStepRequest(
          root,
          config.ref.packageDir,
          rule.entries,
          wsCompiler,
          envOverrides,
          envRemovals,
          ctx.concurrency,
          config.concurrencyGroup,
        ),
      );
    } else {
      let startNs = monotonic() as i64;
      let cwd = withRoot(root, config.ref.packageDir);
      let shellCmd = fallbackBuildShellCommand(rule.entries, rule.compiler);
      let wrapped =
        `export PATH="${binPathPrefix(config.ref.packageDir)}:$PATH"; ${shellCmd}`;
      let result = await runWith(['sh', '-c', wrapped], {
        cwd: cwd,
        env: envOverrides,
        envRemove: envRemovals,
        processGroup: true,
      });
      let durationMs = div((monotonic() as i64) - startNs, 1000000 as i64);
      exec = new StepExecution(
        shellCmd,
        result.exitCode,
        result.stdout,
        result.stderr,
        durationMs,
      );
    }
    let sigAfter = checkSignal();
    if (sigAfter != 0) {
      throw new Error(
        `script "${key}" interrupted by signal ${i32ToString(sigAfter)}`,
      );
    }
    let finished = exec;
    if (executions != null) {
      executions[key] = finished;
    }
    if (finished.exitCode != 0) {
      throw new Error(
        `script "${key}" failed (exit ${i32ToString(finished.exitCode)}): ${finished.command}\n` +
        finished.stdout + finished.stderr,
      );
    }
  } else if (command != null) {
    let key = refKey(config.ref);
    let sigBefore = checkSignal();
    if (sigBefore != 0) {
      throw new Error(
        `script "${key}" interrupted by signal ${i32ToString(sigBefore)}`,
      );
    }
    if (hasher != null) {
      hasher.markMutated();
    }
    await cleanOutputs(root, config, ctx);
    let startNs = monotonic() as i64;
    let cwd = withRoot(root, config.ref.packageDir);
    let wrapped =
      `export PATH="${binPathPrefix(config.ref.packageDir)}:$PATH"; ${command}`;
    let result = await runWith(['sh', '-c', wrapped], {
      cwd: cwd,
      env: resolveEnvOverrides(config.env),
      envRemove: resolveEnvRemovals(config.env),
      processGroup: true,
    });
    let sigAfter = checkSignal();
    if (sigAfter != 0) {
      throw new Error(
        `script "${key}" interrupted by signal ${i32ToString(sigAfter)}`,
      );
    }
    if (executions != null) {
      let durationMs = div((monotonic() as i64) - startNs, 1000000 as i64);
      executions[key] = new StepExecution(
        command,
        result.exitCode,
        result.stdout,
        result.stderr,
        durationMs,
      );
    }
    if (!result.succeeded()) {
      throw new Error(
        `script "${key}" failed (exit ${i32ToString(result.exitCode)}): ${command}\n` +
        result.stdout + result.stderr,
      );
    }
  }
  let outFiles = await expandGlobs(root, config.ref.packageDir, config.output);
  let outputs = new GrowableArray<OutputEntry>();
  for (let path in outFiles) {
    let fp = if (hasher != null) await hasher.hash(path) else await hashFile(root, path);
    outputs.push(new OutputEntry(path, fp));
  }
  if (volatileMark != null) {
    // An unfingerprintable script's true outputs are unknown, so its
    // manifest must never repeat: dependents' cache keys change every
    // run, which keeps them from going fresh over outputs this script
    // may have changed without declaring (wireit poisons dependents of
    // untracked scripts the same way).
    outputs.push(new OutputEntry(
      '$volatile',
      new Fingerprint('volatile:' + volatileMark),
    ));
  }
  return new OutputManifest(outputs);
}

class ZbServiceHandle implements ServiceHandle {
  #key: String;
  #command: String;
  #proc: Unmanaged<Process>;
  var #stopped = false;

  new(key: String, command: String, proc: Unmanaged<Process>)
      : #key = key,
        #command = command,
        #proc = proc;

  isAlive(): boolean {
    if (this.#stopped) {
      return false;
    }
    return !this.#proc.hasExited();
  }

  async stop(): Future<void> {
    if (this.#stopped) {
      return;
    }
    this.#stopped = true;
    let proc = adopt(this.#proc);
    if (proc.hasExited()) {
      let res = await proc.wait();
      if (checkSignal() == 0) {
        throw new Error(
          `service "${this.#key}" exited unexpectedly (exit ${i32ToString(res.exitCode)}): ${this.#command}\n` +
          res.stdout + res.stderr,
        );
      }
      return;
    }
    await proc.stop(2000 as i64);
  }
}

function compileReadyRegex(config: ScriptConfig): Regex? {
  let svc = config.service;
  if (svc == null) {
    return null;
  }
  let pattern = svc.readyWhenLineMatches;
  if (pattern == null) {
    return null;
  }
  try {
    return new Regex(pattern);
  } catch (e) {
    throw new ConfigError(
      `script "${refKey(config.ref)}": invalid readyWhen.lineMatches regex "${pattern}": ${e.message}`,
    );
  }
}

async function startService(
  root: String,
  config: ScriptConfig,
  readyRegex: Regex?,
  hasher: FileHasher,
  executions: HashMap<String, StepExecution>,
): Future<ServiceHandle> {
  let key = refKey(config.ref);
  let sigBefore = checkSignal();
  if (sigBefore != 0) {
    throw new Error(
      `service "${key}" interrupted by signal ${i32ToString(sigBefore)}`,
    );
  }
  hasher.markMutated();
  let startNs = monotonic() as i64;
  let command = config.command ?? '';
  let cwd = withRoot(root, config.ref.packageDir);
  let wrapped =
    `export PATH="${binPathPrefix(config.ref.packageDir)}:$PATH"; ${command}`;
  let proc = spawnWith(['sh', '-c', wrapped], {
    cwd: cwd,
    env: resolveEnvOverrides(config.env),
    envRemove: resolveEnvRemovals(config.env),
    processGroup: true,
  });
  if (readyRegex != null) {
    var matched = false;
    while (true) {
      let line = await proc.readLine();
      if (line == null) {
        break;
      }
      if (readyRegex.test(line)) {
        matched = true;
        break;
      }
    }
    let sigAfter = checkSignal();
    if (sigAfter != 0) {
      await proc.stop(2000 as i64);
      throw new Error(
        `service "${key}" interrupted by signal ${i32ToString(sigAfter)}`,
      );
    }
    if (!matched) {
      let res = await proc.stop(500 as i64);
      let durationMs = div((monotonic() as i64) - startNs, 1000000 as i64);
      executions[key] = new StepExecution(
        command,
        res.exitCode,
        res.stdout,
        res.stderr,
        durationMs,
      );
      throw new Error(
        `service "${key}" exited before readyWhen.lineMatches matched (exit ${i32ToString(res.exitCode)}): ${command}\n` +
        res.stdout + res.stderr,
      );
    }
  } else if (proc.hasExited()) {
    let res = await proc.wait();
    let durationMs = div((monotonic() as i64) - startNs, 1000000 as i64);
    executions[key] = new StepExecution(
      command,
      res.exitCode,
      res.stdout,
      res.stderr,
      durationMs,
    );
    throw new Error(
      `service "${key}" exited immediately (exit ${i32ToString(res.exitCode)}): ${command}\n` +
      res.stdout + res.stderr,
    );
  }
  let durationMs = div((monotonic() as i64) - startNs, 1000000 as i64);
  executions[key] = new StepExecution(command, 0, '', '', durationMs);
  return new ZbServiceHandle(key, command, disown(proc));
}

async function runForegroundService(
  root: String,
  config: ScriptConfig,
  readyRegex: Regex?,
  salt: String,
  hasher: FileHasher,
): Future<OutputManifest> {
  let sigBefore = checkSignal();
  if (sigBefore != 0) {
    throw new Error(
      `service "${refKey(config.ref)}" interrupted by signal ${i32ToString(sigBefore)}`,
    );
  }
  hasher.markMutated();
  let command = config.command ?? '';
  let cwd = withRoot(root, config.ref.packageDir);
  let wrapped =
    `export PATH="${binPathPrefix(config.ref.packageDir)}:$PATH"; ${command}`;
  let proc = spawnWith(['sh', '-c', wrapped], {
    cwd: cwd,
    env: resolveEnvOverrides(config.env),
    envRemove: resolveEnvRemovals(config.env),
    processGroup: true,
  });
  var matched = readyRegex == null;
  while (true) {
    let line = await proc.readLine();
    if (line == null) {
      break;
    }
    console.log(line);
    if (!matched && readyRegex != null && readyRegex.test(line)) {
      matched = true;
    }
  }
  let sigAfterRead = checkSignal();
  if (sigAfterRead != 0) {
    await proc.stop(2000 as i64);
    throw new Error(
      `service "${refKey(config.ref)}" interrupted by signal ${i32ToString(sigAfterRead)}`,
    );
  }
  let res = await proc.wait();
  let sigAfterWait = checkSignal();
  if (sigAfterWait != 0) {
    throw new Error(
      `service "${refKey(config.ref)}" interrupted by signal ${i32ToString(sigAfterWait)}`,
    );
  }
  if (!matched) {
    throw new Error(
      `service "${refKey(config.ref)}" exited before readyWhen.lineMatches matched (exit ${i32ToString(res.exitCode)}): ${command}\n` +
      res.stdout + res.stderr,
    );
  }
  if (!res.succeeded()) {
    throw new Error(
      `service "${refKey(config.ref)}" failed (exit ${i32ToString(res.exitCode)}): ${command}\n` +
      res.stdout + res.stderr,
    );
  }
  return new OutputManifest([
    new OutputEntry('$volatile', new Fingerprint('volatile:' + salt)),
  ]);
}

export function lockfileCandidates(
  packageDir: String,
  lockNames: Array<String>,
): Array<String> {
  let candidates = new GrowableArray<String>();
  let seen = new HashSet<String>();
  var cur = packageDir;
  while (true) {
    for (let name in lockNames) {
      let candidate = joinWorkspace(cur, name);
      if (seen.add(candidate)) {
        candidates.push(candidate);
      }
    }
    if (cur == '') {
      break;
    }
    var slash = -1;
    for (var i = 0; i < cur.length; i += 1) {
      if (cur.getByteAt(i) == 47) {
        slash = i;
      }
    }
    cur = if (slash < 0) '' else cur.sliceBytes(0, slash);
  }
  return candidates;
}

async function resolveTestRunnerLeaf(
  runner: TestStepRunner,
): Future<Array<(String, Fingerprint)>> {
  let entries = new GrowableArray<(String, Fingerprint)>();
  entries.push(('__zena_test_runner__', new Fingerprint(await runner.fingerprint())));
  return entries;
}

class CoalescedRunnerLeaf {
  #runner: TestStepRunner;
  var #pending: Future<Array<(String, Fingerprint)>>? = null;

  new(runner: TestStepRunner) : #runner = runner;

  resolve(): Future<Array<(String, Fingerprint)>> {
    let existing = this.#pending;
    if (existing != null) {
      return existing;
    }
    let started = resolveTestRunnerLeaf(this.#runner);
    this.#pending = started;
    return started;
  }
}

async function resolveBuildRunnerLeaf(
  runner: BuildStepRunner,
  compilerOverride: String?,
): Future<Array<(String, Fingerprint)>> {
  return [
    ('__zena_build_runner__', new Fingerprint(await runner.fingerprint(compilerOverride))),
  ];
}

class CoalescedBuildRunnerLeaf {
  #runner: BuildStepRunner;
  #pending = new HashMap<String, Future<Array<(String, Fingerprint)>>>();

  new(runner: BuildStepRunner) : #runner = runner;

  resolve(compilerOverride: String?): Future<Array<(String, Fingerprint)>> {
    let cacheKey = compilerOverride ?? '';
    if (let (true, existing) = this.#pending.get(cacheKey)) {
      return existing;
    }
    let started = resolveBuildRunnerLeaf(this.#runner, compilerOverride);
    this.#pending[cacheKey] = started;
    return started;
  }
}

function buildStepInputs(
  config: ScriptConfig,
  hasher: FileHasher,
  runnerLeaf: CoalescedRunnerLeaf? = null,
  buildRunnerLeaf: CoalescedBuildRunnerLeaf? = null,
): Array<InputRef> {
  validateGlobs(config.ref.packageDir, config.files);
  validateGlobs(config.ref.packageDir, config.output);
  let inputs = new GrowableArray<InputRef>();
  let rule = config.rule;
  let lockCandidates = if (
    config.isWireit &&
    (config.command != null || rule != null) &&
    config.fingerprintable &&
    config.packageLocks.length > 0
  )
    lockfileCandidates(config.ref.packageDir, config.packageLocks)
  else
    new GrowableArray<String>();
  if (config.files.length > 0 || lockCandidates.length > 0) {
    let pkgDir = config.ref.packageDir;
    let globs = config.files;
    inputs.push(
      new LeafSet('files', () => hasher.hashInputs(pkgDir, globs, lockCandidates)),
    );
  }
  if (rule is ZenaTestRule && config.fingerprintable && runnerLeaf != null) {
    let sharedLeaf = runnerLeaf;
    inputs.push(new LeafSet('test-runner', () => sharedLeaf.resolve()));
  } else if (rule is ZenaBuildRule && config.fingerprintable && buildRunnerLeaf != null) {
    let sharedBuildLeaf = buildRunnerLeaf;
    let wsCompiler = if (rule.compiler != null)
      joinWorkspace(config.ref.packageDir, rule.compiler)
    else
      null;
    inputs.push(
      new LeafSet('build-runner', () => sharedBuildLeaf.resolve(wsCompiler)),
    );
  }
  // Deduplicate dependency edges, letting `cascade: true` win if listed both ways.
  let order = new GrowableArray<String>();
  let cascadeByKey = new HashMap<String, boolean>();
  let seen = new HashSet<String>();
  for (let dep in config.dependencies) {
    let key = refKey(dep.ref);
    if (seen.add(key)) {
      order.push(key);
      cascadeByKey[key] = dep.cascade;
    } else if (dep.cascade) {
      cascadeByKey[key] = true;
    }
  }
  for (let key in order) {
    if (cascadeByKey.getOr(key, true)) {
      inputs.push(new StepOutputs(new StepKey(key)));
    } else {
      inputs.push(new StepOrder(new StepKey(key)));
    }
  }
  return inputs;
}

/**
 * Turns collected script configs into a step graph with lazy per-step
 * input glob expansion backed by `hasher`. `foregroundServiceKey` names
 * a service invoked directly as the top-level target so it runs in the
 * foreground instead of sitting idle with zero dependents.
 */
export function planScripts(
  root: String,
  configs: Array<ScriptConfig>,
  salt: String,
  hasher: FileHasher? = null,
  foregroundServiceKey: String? = null,
  testRunner: TestStepRunner? = null,
  concurrencyGroups: ConcurrencyGroups? = null,
  buildRunner: BuildStepRunner? = null,
): Plan {
  let fileHasher = hasher ?? new FileHasher(root);
  let hasTestRunner = testRunner != null;
  let hasBuildRunner = buildRunner != null;
  let runnerLeaf = if (testRunner != null) new CoalescedRunnerLeaf(testRunner) else null;
  let buildRunnerLeaf = if (buildRunner != null)
    new CoalescedBuildRunnerLeaf(buildRunner)
  else
    null;
  let leaves = new HashMap<String, Fingerprint>();
  let executions = new HashMap<String, StepExecution>();
  let steps = new GrowableArray<Step>();
  for (let config in configs) {
    let key = refKey(config.ref);
    let explicitGroup = config.concurrencyGroup;
    if (
      explicitGroup != null &&
      concurrencyGroups != null &&
      !concurrencyGroups.hasGroup(explicitGroup)
    ) {
      throw new ConfigError(
        `script "${key}": unknown concurrencyGroup "${explicitGroup}"`,
      );
    }
    let inputs = buildStepInputs(config, fileHasher, runnerLeaf, buildRunnerLeaf);
    if (config.service != null) {
      let readyRegex = compileReadyRegex(config);
      if (foregroundServiceKey != null && key == foregroundServiceKey) {
        steps.push(new TaskStep(
          new StepKey(key),
          configFingerprint(config, salt, true, hasTestRunner, hasBuildRunner),
          inputs,
          (ctx) => runForegroundService(root, config, readyRegex, salt, fileHasher),
          explicitGroup ?? DEFAULT_CONCURRENCY_GROUP,
        ));
      } else {
        steps.push(new ServiceStep(
          new StepKey(key),
          configFingerprint(config, salt, false, hasTestRunner, hasBuildRunner),
          inputs,
          (svcCtx) => startService(root, config, readyRegex, fileHasher, executions),
        ));
      }
    } else {
      let rule = config.rule;
      let isInProcessCoordinator =
        (rule is ZenaTestRule && hasTestRunner) ||
        (rule is ZenaBuildRule && hasBuildRunner);
      let isAggregate =
        config.command == null && rule == null && config.output.length == 0;
      // Aggregate/fileset steps do no I/O work, and in-process `zena:test` /
      // `zena:build` steps coordinate sub-tasks that acquire `'compile'` /
      // `'test'` permits directly from `ctx.concurrency` — neither should
      // occupy a parent slot.
      let stepGroup = if (isAggregate || isInProcessCoordinator)
        null
      else if (rule is ZenaBuildRule)
        explicitGroup ?? COMPILE_CONCURRENCY_GROUP
      else
        explicitGroup ?? DEFAULT_CONCURRENCY_GROUP;
      steps.push(new TaskStep(
        new StepKey(key),
        configFingerprint(config, salt, false, hasTestRunner, hasBuildRunner),
        inputs,
        (ctx) => runScript(
          root,
          config,
          ctx,
          if (config.fingerprintable) null else salt,
          fileHasher,
          executions,
          testRunner,
          buildRunner,
        ),
        stepGroup,
      ));
    }
  }
  return new Plan(new Graph(steps), leaves, executions);
}
