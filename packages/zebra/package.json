{
  "name": "@zena-lang/zebra",
  "version": "0.0.1-preview.1",
  "type": "module",
  "description": "Zebra: an incremental build runner built on the workflow engine",
  "private": true,
  "scripts": {
    "test": "wireit"
  },
  "wireit": {
    "test": {
      "#command": "Runs the Zebra config, plan cache, glob, and end-to-end build tests from the repository root.",
      "command": "cd ../.. && ./target/release/zena-cli test \"packages/zebra/test/*_test.zena\"",
      "env": {
        "ZEBRA_CACHE": "local"
      },
      "dependencies": [
        "../zena-cli:build",
        "../stdlib:lib"
      ],
      "files": [
        "src/**/*.zena",
        "test/**/*.zena",
        "test/fixtures/example/**",
        "../workflow/src/**/*.zena",
        "../terminal/src/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../../zena-package.json",
        "../../package.json",
        "../../packages/*/package.json",
        "../../packages/*/zena-package.json",
        "../../packages/*/zebra.json",
        "../../packages/*/test/**/*.zena",
        "../../packages/*/tests/**/*.zena",
        "zena-package.json",
        "../workflow/zena-package.json",
        "../terminal/zena-package.json"
      ],
      "output": []
    }
  }
}
