{
  "name": "zebra",
  "scope": "zena-lang",
  "version": "0.0.1-preview.1",
  "description": "Zebra: an incremental build orchestrator for Zena and standalone workspaces",
  "license": "MIT",
  "files": ["src"],
  "exports": {
    "main": {},
    "runner": {},
    "zebra-config": {},
    "wireit-config": {},
    "plan-cache": {},
    "builder": {},
    "disk-cache": {},
    "github-cache": {},
    "state-json": {},
    "fs-walk": {},
    "fs-util": {},
    "colors": {},
    "layout": {},
    "animation": {},
    "shell": {}
  },
  "dependencies": {
    "workflow": {
      "path": "../workflow"
    }
  },
  "scripts": {
    "test": {
      "#command": "Runs the Zebra config, plan cache, glob, terminal, and end-to-end build tests from the repository root.",
      "command": "cd ../.. && ./target/release/zena-cli test \"packages/zebra/test/*_test.zena\"",
      "env": {
        "ZEBRA_CACHE": "local"
      },
      "files": ["test/**/*.zena", "test/fixtures/example/**"],
      "dependencies": ["source", "../stdlib:lib", "../zena-cli:build"]
    }
  }
}
