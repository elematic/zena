import { suite, test } from 'zena:test';
import {equal, isTrue} from 'zena:assert';
import { newByteArray, Encoding } from 'zena:core';

export let tests = suite('String', () => {
  test('toBytes and fromBytes round-trip the stored bytes', () => {
    let bytes = 'héllo'.toBytes();
    equal(bytes.length, 6);
    equal(bytes[0], 104 as u8);
    equal(String.fromBytes(bytes), 'héllo');
    equal(''.toBytes().length, 0);
  });

  suite('startsWith', () => {
    test('returns true for matching prefix', () => {
      equal("hello world".startsWith("hello"), true);
    });

    test('returns true for empty prefix', () => {
      equal("hello".startsWith(""), true);
    });

    test('returns false for non-matching prefix', () => {
      equal("hello world".startsWith("world"), false);
    });

    test('returns false when prefix is longer than string', () => {
      equal("hi".startsWith("hello"), false);
    });

    test('returns true when prefix equals string', () => {
      equal("hello".startsWith("hello"), true);
    });

    test('returns true for single character prefix', () => {
      equal("abc".startsWith("a"), true);
    });

    test('returns false for single character non-match', () => {
      equal("abc".startsWith("b"), false);
    });

    test('empty string starts with empty string', () => {
      equal("".startsWith(""), true);
    });

    test('empty string does not start with non-empty', () => {
      equal("".startsWith("a"), false);
    });
  });

  suite('endsWith', () => {
    test('returns true for matching suffix', () => {
      equal("hello world".endsWith("world"), true);
    });

    test('returns true for empty suffix', () => {
      equal("hello".endsWith(""), true);
    });

    test('returns false for non-matching suffix', () => {
      equal("hello world".endsWith("hello"), false);
    });

    test('returns false when suffix is longer than string', () => {
      equal("hi".endsWith("hello"), false);
    });

    test('returns true when suffix equals string', () => {
      equal("hello".endsWith("hello"), true);
    });

    test('returns true for single character suffix', () => {
      equal("abc".endsWith("c"), true);
    });

    test('returns false for single character non-match', () => {
      equal("abc".endsWith("b"), false);
    });

    test('empty string ends with empty string', () => {
      equal("".endsWith(""), true);
    });

    test('empty string does not end with non-empty', () => {
      equal("".endsWith("a"), false);
    });
  });

  suite('contains', () => {
    test('returns true for empty substring', () => {
      equal("hello".contains(""), true);
    });

    test('returns true for matching suffix', () => {
      equal("hello world".contains("world"), true);
    });

    test('returns true for matching prefix', () => {
      equal("hello world".contains("hello"), true);
    });

    test('returns true for matching substring', () => {
      equal("hello world".contains("ll"), true);
    });

    test('returns false when substring is longer than string', () => {
      equal("hi".contains("hello"), false);
    });

    test('returns true when substring equals string', () => {
      equal("hello".contains("hello"), true);
    });

    test('returns true for single character suffix', () => {
      equal("abc".contains("c"), true);
    });

    test('returns true for single character substring', () => {
      equal("abc".contains("b"), true);
    });

    test('returns false for non-matching substring with matching ends', () => {
      equal("abcde".contains("bxd"), false);
    });

    test('empty string contains empty string', () => {
      equal("".contains(""), true);
    });

    test('empty string does not contain non-empty', () => {
      equal("".contains("a"), false);
    });
  });

  suite('trim', () => {
    test('removes ASCII whitespace from both ends', () => {
      equal("  hello \t".trim(), "hello");
      equal("\r\n\tline\n".trim(), "line");
      equal("inner  space".trim(), "inner  space");
    });

    test('an all-whitespace string trims to empty', () => {
      equal(" \t\r\n".trim(), "");
      equal("".trim(), "");
    });

    test('keeps non-ASCII whitespace', () => {
      // Each end is U+00A0, a no-break space, two bytes in UTF-8.
      equal(" x ".trim().length, 5);
    });
  });

  suite('+', () => {
    test('concatenates two strings', () => {
      equal("hello " + "world", "hello world");
    });

    test('concatenates empty string with non-empty', () => {
      equal("" + "hello", "hello");
      equal("hello" + "", "hello");
    });

    test('concatenates multiple strings', () => {
      equal(`abc`, "abc");
    });
  });

  suite('split', () => {
    test('splits string by single character separator', () => {
      let parts = "a/b/c".split("/");
      equal(parts.length, 3);
      equal(parts[0], "a");
      equal(parts[1], "b");
      equal(parts[2], "c");
    });

    test('returns single element array for empty separator', () => {
      let parts = "hello".split("");
      equal(parts.length, 1);
      equal(parts[0], "hello");
    });

    test('returns single element array if separator is not found', () => {
      let parts = "hello".split("/");
      equal(parts.length, 1);
      equal(parts[0], "hello");
    });

    test('splits string with multiple character separator', () => {
      let parts = "a::b::c".split("::");
      equal(parts.length, 3);
      equal(parts[0], "a");
      equal(parts[1], "b");
      equal(parts[2], "c");
    });
  });

  suite('compareTo', () => {
    test('returns 0 for equal strings', () => {
      let s = "hello";
      equal(s.compareTo(s), 0);
      equal("hello".compareTo("hello"), 0);
      equal("".compareTo(""), 0);
    });

    test('returns negative when this < other', () => {
      isTrue("a".compareTo("b") < 0);
      isTrue("apple".compareTo("banana") < 0);
      isTrue("abc".compareTo("abd") < 0);
      isTrue("".compareTo("a") < 0);
    });

    test('returns positive when this > other', () => {
      isTrue("b".compareTo("a") > 0);
      isTrue("banana".compareTo("apple") > 0);
      isTrue("abd".compareTo("abc") > 0);
      isTrue("a".compareTo("") > 0);
    });

    test('orders prefixes before longer strings', () => {
      isTrue("abc".compareTo("abcd") < 0);
      isTrue("abcd".compareTo("abc") > 0);
    });

    test('orders UTF-8 multi-byte characters by code point', () => {
      isTrue("café".compareTo("cafe") > 0);
      isTrue("α".compareTo("β") < 0);
    });
  });

  suite('regionEqualsBytes', () => {
    let source = "let alpha = beta;";

    test('matches a range equal to the whole string', () => {
      equal("alpha".regionEqualsBytes(source, 4, 9), true);
    });

    test('rejects a range of a different length', () => {
      equal("alpha".regionEqualsBytes(source, 4, 8), false);
      equal("alpha".regionEqualsBytes(source, 4, 10), false);
    });

    test('rejects an equal-length range with different bytes', () => {
      equal("alpha".regionEqualsBytes("betas", 0, 5), false);
    });

    test('matches an empty string against an empty range', () => {
      equal("".regionEqualsBytes(source, 3, 3), true);
      equal("a".regionEqualsBytes(source, 3, 3), false);
    });

    test('compares against the receiver, not its backing array', () => {
      // The receiver here is a slice, so its own offset must be honoured
      // rather than the start of the array it shares.
      let slice = source.sliceBytes(4, 9);
      equal(slice.regionEqualsBytes("xxalphaxx", 2, 7), true);
      equal(slice.regionEqualsBytes("xxbetaxxx", 2, 7), false);
    });

    test('does not match a range outside the other string', () => {
      // Must return false rather than read out of bounds: the length check
      // alone passes here, since the range is the right size.
      equal("abc".regionEqualsBytes("xy", 5, 8), false);
      equal("abc".regionEqualsBytes("xyzw", 2, 5), false);
      equal("abc".regionEqualsBytes(source, -3, 0), false);
      // Far enough out that reading it would trap, not merely read a
      // neighbouring literal's bytes — so this fails loudly without the guard.
      equal("abc".regionEqualsBytes("xy", 1000000, 1000003), false);
    });

    test('compares encoded bytes for multi-byte content', () => {
      // "café" is five bytes in UTF-8, not four characters' worth.
      let text = "café au lait";
      equal("café".regionEqualsBytes(text, 0, 5), true);
      equal("café".regionEqualsBytes(text, 0, 4), false);
    });
  });

  suite('isEmpty and the utf8 view', () => {
    test('reports isEmpty and the UTF-8 length', () => {
      equal("".utf8.length, 0);
      equal("".isEmpty, true);
      equal("abc".utf8.length, 3);
      equal("abc".isEmpty, false);
      equal("café".utf8.length, 5);
      equal("😀".utf8.length, 4);
    });

    test('utf8[i] reads raw UTF-8 bytes and indexAt slices on them', () => {
      let s = "café";
      equal(s.utf8[0] as i32, 99);
      equal(s.utf8[3] as i32, 0xC3);
      equal(s.utf8[4] as i32, 0xA9);
      if (let (true, three) = s.utf8.indexAt(3)) {
        equal(s[..three], "caf");
        equal(s[three..], "é");
      } else {
        isTrue(false);
      }
    });
  });

  suite('StringIndex navigation and validation', () => {
    test('startIndex and endIndex on ASCII and multi-byte strings', () => {
      let s = "café";
      equal(s.startIndex as i32, 0);
      equal(s.endIndex as i32, 5);
    });

    test('indexAfter and indexBefore step by grapheme cluster', () => {
      // "c" (1B), "a" (1B), "f" (1B), "e" + U+0301 (1B + 2B = 3B) => total 6 bytes
      let s = "cafe" + String.fromCodePoint(0x0301);
      let i0 = s.startIndex;
      let i1 = s.indexAfter(i0);
      let i2 = s.indexAfter(i1);
      let i3 = s.indexAfter(i2);
      let i4 = s.indexAfter(i3);
      equal(i1 as i32, 1);
      equal(i2 as i32, 2);
      equal(i3 as i32, 3);
      equal(i4 as i32, 6);
      equal(i4, s.endIndex);

      equal(s.indexBefore(i4), i3);
      equal(s.indexBefore(i3), i2);
      equal(s.indexBefore(i2), i1);
      equal(s.indexBefore(i1), i0);
    });

    test('scalarIndexAfter and scalarIndexBefore step by code point', () => {
      let s = "e" + String.fromCodePoint(0x0301); // 'e' (1B) + U+0301 (2B)
      let i0 = s.startIndex;
      let i1 = s.scalarIndexAfter(i0);
      let i2 = s.scalarIndexAfter(i1);
      equal(i1 as i32, 1);
      equal(i2 as i32, 3);
      equal(s.scalarIndexBefore(i2), i1);
      equal(s.scalarIndexBefore(i1), i0);
    });

    test('indexOffsetBy steps forward and backward with bounds checking', () => {
      let s = "a😀b";
      if (let (true, idx1) = s.indexOffsetBy(s.startIndex, 1)) {
        equal(s[idx1], "😀");
        if (let (true, idx2) = s.indexOffsetBy(idx1, 1)) {
          equal(s[idx2], "b");
        } else {
          isTrue(false);
        }
      } else {
        isTrue(false);
      }

      if (let (true, endMinus1) = s.indexOffsetBy(s.endIndex, -1)) {
        equal(s[endMinus1], "b");
      } else {
        isTrue(false);
      }

      if (let (true, _) = s.indexOffsetBy(s.startIndex, 4)) {
        isTrue(false);
      }
      if (let (true, _) = s.indexOffsetBy(s.startIndex, -1)) {
        isTrue(false);
      }
    });

    test('utf8.indexAt accepts scalar boundaries and rejects continuation bytes', () => {
      let s = "aé😀"; // 'a' at 0, 'é' at 1..3, '😀' at 3..7
      let v = s.utf8;
      if (let (true, idx0) = v.indexAt(0)) {
        equal(idx0, s.startIndex);
      } else {
        isTrue(false);
      }
      if (let (true, idx1) = v.indexAt(1)) {
        equal(s[idx1..], "é😀");
      } else {
        isTrue(false);
      }
      // Byte 2 is a continuation byte inside 'é'
      if (let (true, _) = v.indexAt(2)) {
        isTrue(false);
      }
      if (let (true, idx3) = v.indexAt(3)) {
        equal(s[idx3..], "😀");
      } else {
        isTrue(false);
      }
      // Bytes 4, 5, 6 are continuation bytes inside '😀'
      if (let (true, _) = v.indexAt(4)) {
        isTrue(false);
      }
      if (let (true, idxEnd) = v.indexAt(7)) {
        equal(idxEnd, s.endIndex);
      } else {
        isTrue(false);
      }
      if (let (true, _) = v.indexAt(-1)) {
        isTrue(false);
      }
      if (let (true, _) = v.indexAt(8)) {
        isTrue(false);
      }
    });

    test('indexAt on a sub-view counts from the string, not the sub-view', () => {
      let s = "aé😀";
      let tail = s.utf8.slice(1, 7);
      if (let (true, idx) = tail.indexAt(2)) {
        equal(s[idx..], "😀");
      } else {
        isTrue(false);
      }
    });

    test('utf16.indexAt maps code unit offsets to the string and rejects a split pair', () => {
      let s = "aé😀"; // units: 'a', 'é', high surrogate, low surrogate
      let v = s.utf16;
      equal(v.length, 4);
      if (let (true, idx2) = v.indexAt(2)) {
        equal(s[idx2..], "😀");
      } else {
        isTrue(false);
      }
      if (let (true, _) = v.indexAt(3)) {
        isTrue(false);
      }
      if (let (true, idxEnd) = v.indexAt(4)) {
        equal(idxEnd, s.endIndex);
      } else {
        isTrue(false);
      }
    });
  });

  suite('indexing and Range<StringIndex> slicing', () => {
    test('single StringIndex indexing returns grapheme cluster slice', () => {
      let s = "aé👨‍👩‍👧‍👦b";
      let i0 = s.startIndex;
      let i1 = s.indexAfter(i0);
      let i2 = s.indexAfter(i1);
      let i3 = s.indexAfter(i2);
      equal(s[i0], "a");
      equal(s[i1], "é");
      equal(s[i2], "👨‍👩‍👧‍👦");
      equal(s[i3], "b");
    });

    test('range slicing with start..end, start.., ..end, and ..', () => {
      let s = "hello 🌍 world";
      if (let (true, worldIdx) = s.indexOf("🌍")) {
        let afterEmoji = s.indexAfter(worldIdx);
        equal(s[..worldIdx], "hello ");
        equal(s[worldIdx..afterEmoji], "🌍");
        equal(s[afterEmoji..], " world");
        equal(s[..], "hello 🌍 world");
        equal(s.slice(worldIdx, afterEmoji), "🌍");
        equal(s.slice(afterEmoji), " world");
      } else {
        isTrue(false);
      }
    });

    test('rejects StringIndex from another string that lands mid-character', () => {
      let ascii = "abc";
      let idx2 = ascii.indexAfter(ascii.indexAfter(ascii.startIndex)); // byte offset 2
      let utf8 = "aé"; // byte offset 2 is inside 'é' (bytes 1..3)
      var threw = false;
      try {
        let _ = utf8[..idx2];
      } catch (e) {
        threw = true;
      }
      equal(threw, true);
    });
  });

  suite('indexOf', () => {
    test('returns (true, StringIndex) when found and (false, _) when absent', () => {
      let s = "café au café";
      if (let (true, first) = s.indexOf("café")) {
        equal(first as i32, 0);
        let nextStart = s.indexAfter(first);
        if (let (true, second) = s.indexOf("café", nextStart)) {
          equal(s[second..], "café");
        } else {
          isTrue(false);
        }
      } else {
        isTrue(false);
      }

      if (let (true, _) = s.indexOf("tea")) {
        isTrue(false);
      }
    });
  });

  suite('grapheme iteration and reverse', () => {
    test('iterates grapheme clusters by default', () => {
      let eAcute = "e" + String.fromCodePoint(0x0301);
      let s = eAcute + "🏴󠁧󠁢󠁥󠁮󠁧󠁿🇺🇸👨‍👩‍👧";
      let clusters = new GrowableArray<String>();
      for (let g in s) {
        clusters.push(g);
      }
      equal(clusters.length, 4);
      equal(clusters[0], eAcute);
      equal(clusters[1], "🏴󠁧󠁢󠁥󠁮󠁧󠁿");
      equal(clusters[2], "🇺🇸");
      equal(clusters[3], "👨‍👩‍👧");
      equal(s.graphemes.count(), 4);
    });

    test('reverses ASCII, CRLF, combining marks, and multi-code-point emojis', () => {
      let acute = String.fromCodePoint(0x0301);
      let diaeresis = String.fromCodePoint(0x0308);
      let jamo = String.fromCodePoints([0x1100, 0x1161, 0x11A8]);
      equal("".reverse(), "");
      equal("a".reverse(), "a");
      equal("hello".reverse(), "olleh");
      equal("a\r\nb".reverse(), "b\r\na");
      equal(("cafe" + acute).reverse(), "e" + acute + "fac");
      equal(("a" + acute + diaeresis + "b").reverse(), "ba" + acute + diaeresis);
      equal("👋🏽!".reverse(), "!👋🏽");
      equal("❤️A".reverse(), "A❤️");
      equal("1️⃣2️⃣".reverse(), "2️⃣1️⃣");
      equal("👨‍👩‍👧‍👦!".reverse(), "!👨‍👩‍👧‍👦");
      equal("🇺🇸🇯🇵".reverse(), "🇯🇵🇺🇸");
      equal((jamo + "X").reverse(), "X" + jamo);
    });
  });

  suite('codePoints, utf8, and utf16 views', () => {
    test('codePoints iterates decoded Unicode scalar values', () => {
      let s = "Aé😀";
      let cps = s.codePoints.toArray();
      equal(cps.length, 3);
      equal(cps[0], 0x41);
      equal(cps[1], 0xE9);
      equal(cps[2], 0x1F600);
      equal(s.codePoints.count(), 3);
      equal(s.codePoints.contains(0x1F600), true);
      equal(s.codePoints.contains(0x42), false);
      equal(String.fromCodePoints(cps), "Aé😀");
      equal(String.fromCodePoint(0x1F600), "😀");
    });

    test('utf8 view provides indexed and iterable u8 access', () => {
      let s = "hé";
      let utf8 = s.utf8;
      equal(utf8.length, 3);
      equal(utf8[0], 0x68 as u8);
      equal(utf8[1], 0xC3 as u8);
      equal(utf8[2], 0xA9 as u8);
      equal(utf8.slice(1, 3).length, 2);
      equal(utf8.slice(1, 3)[0], 0xC3 as u8);

      var sum = 0;
      for (let b in utf8) {
        sum += (b as i32);
      }
      equal(sum, 0x68 + 0xC3 + 0xA9);
    });

    test('utf16 view transcodes WTF-8 string to u16 code units', () => {
      let s = "Aé😀";
      let utf16 = s.utf16;
      equal(utf16.length, 4);
      equal(utf16[0], 0x0041 as u16);
      equal(utf16[1], 0x00E9 as u16);
      equal(utf16[2], 0xD83D as u16);
      equal(utf16[3], 0xDE00 as u16);
      equal(utf16.slice(2, 4).length, 2);
      equal(utf16.slice(2, 4)[0], 0xD83D as u16);

      var sum = 0;
      for (let u in utf16) {
        sum += (u as i32);
      }
      equal(sum, 0x0041 + 0x00E9 + 0xD83D + 0xDE00);
    });

    test('WTF-16 encoded String supports indexing, iteration, utf8, and utf16 views', () => {
      // "Aé😀" in little-endian UTF-16: 0x0041, 0x00E9, 0xD83D, 0xDE00
      let raw = newByteArray(8);
      raw[0] = 0x41; raw[1] = 0x00;
      raw[2] = 0xE9; raw[3] = 0x00;
      raw[4] = 0x3D; raw[5] = 0xD8;
      raw[6] = 0x00; raw[7] = 0xDE;
      let s = String.fromByteArray(raw, 0, 8, Encoding.WTF16);
      equal(s.encoding == Encoding.WTF16, true);
      equal(s.utf16.length, 4);
      equal(s.utf16[2], 0xD83D as u16);
      equal(s.utf8.length, 7);
      equal(s.utf8[0], 0x41 as u8);
      equal(s.utf8[1], 0xC3 as u8);
      equal(s.utf8[2], 0xA9 as u8);
      equal(s.utf8[3], 0xF0 as u8);
      equal(s.codePoints.count(), 3);
      equal(s.graphemes.count(), 3);

      let i1 = s.indexAfter(s.startIndex);
      let i2 = s.indexAfter(i1);
      equal(s[i1..i2].utf8.length, 2);
      equal(s.reverse().codePoints.toArray()[0], 0x1F600);
    });
  });
});

