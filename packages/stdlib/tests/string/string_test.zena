import { suite, test } from 'zena:test';
import {equal, isTrue} from 'zena:assert';

export let tests = suite('String', () => {
  test('toBytes and fromBytes round-trip the stored bytes', () => {
    let bytes = 'héllo'.toBytes();
    equal(bytes.length, 6);
    equal(bytes[0], 104 as u8);
    equal(String.fromBytes(bytes), 'héllo');
    equal(''.toBytes().length, 0);
  });

  suite('startsWith', () => {
    test('returns true for matching prefix', () => {
      equal("hello world".startsWith("hello"), true);
    });

    test('returns true for empty prefix', () => {
      equal("hello".startsWith(""), true);
    });

    test('returns false for non-matching prefix', () => {
      equal("hello world".startsWith("world"), false);
    });

    test('returns false when prefix is longer than string', () => {
      equal("hi".startsWith("hello"), false);
    });

    test('returns true when prefix equals string', () => {
      equal("hello".startsWith("hello"), true);
    });

    test('returns true for single character prefix', () => {
      equal("abc".startsWith("a"), true);
    });

    test('returns false for single character non-match', () => {
      equal("abc".startsWith("b"), false);
    });

    test('empty string starts with empty string', () => {
      equal("".startsWith(""), true);
    });

    test('empty string does not start with non-empty', () => {
      equal("".startsWith("a"), false);
    });
  });

  suite('endsWith', () => {
    test('returns true for matching suffix', () => {
      equal("hello world".endsWith("world"), true);
    });

    test('returns true for empty suffix', () => {
      equal("hello".endsWith(""), true);
    });

    test('returns false for non-matching suffix', () => {
      equal("hello world".endsWith("hello"), false);
    });

    test('returns false when suffix is longer than string', () => {
      equal("hi".endsWith("hello"), false);
    });

    test('returns true when suffix equals string', () => {
      equal("hello".endsWith("hello"), true);
    });

    test('returns true for single character suffix', () => {
      equal("abc".endsWith("c"), true);
    });

    test('returns false for single character non-match', () => {
      equal("abc".endsWith("b"), false);
    });

    test('empty string ends with empty string', () => {
      equal("".endsWith(""), true);
    });

    test('empty string does not end with non-empty', () => {
      equal("".endsWith("a"), false);
    });
  });

  suite('contains', () => {
    test('returns true for empty substring', () => {
      equal("hello".contains(""), true);
    });

    test('returns true for matching suffix', () => {
      equal("hello world".contains("world"), true);
    });

    test('returns true for matching prefix', () => {
      equal("hello world".contains("hello"), true);
    });

    test('returns true for matching substring', () => {
      equal("hello world".contains("ll"), true);
    });

    test('returns false when substring is longer than string', () => {
      equal("hi".contains("hello"), false);
    });

    test('returns true when substring equals string', () => {
      equal("hello".contains("hello"), true);
    });

    test('returns true for single character suffix', () => {
      equal("abc".contains("c"), true);
    });

    test('returns true for single character substring', () => {
      equal("abc".contains("b"), true);
    });

    test('returns false for non-matching substring with matching ends', () => {
      equal("abcde".contains("bxd"), false);
    });

    test('empty string contains empty string', () => {
      equal("".contains(""), true);
    });

    test('empty string does not contain non-empty', () => {
      equal("".contains("a"), false);
    });
  });

  suite('trim', () => {
    test('removes ASCII whitespace from both ends', () => {
      equal("  hello \t".trim(), "hello");
      equal("\r\n\tline\n".trim(), "line");
      equal("inner  space".trim(), "inner  space");
    });

    test('an all-whitespace string trims to empty', () => {
      equal(" \t\r\n".trim(), "");
      equal("".trim(), "");
    });

    test('keeps non-ASCII whitespace', () => {
      // Each end is U+00A0, a no-break space, two bytes in UTF-8.
      equal(" x ".trim().length, 5);
    });
  });

  suite('+', () => {
    test('concatenates two strings', () => {
      equal("hello " + "world", "hello world");
    });

    test('concatenates empty string with non-empty', () => {
      equal("" + "hello", "hello");
      equal("hello" + "", "hello");
    });

    test('concatenates multiple strings', () => {
      equal("a" + "b" + "c", "abc");
    });
  });

  suite('split', () => {
    test('splits string by single character separator', () => {
      let parts = "a/b/c".split("/");
      equal(parts.length, 3);
      equal(parts[0], "a");
      equal(parts[1], "b");
      equal(parts[2], "c");
    });

    test('returns single element array for empty separator', () => {
      let parts = "hello".split("");
      equal(parts.length, 1);
      equal(parts[0], "hello");
    });

    test('returns single element array if separator is not found', () => {
      let parts = "hello".split("/");
      equal(parts.length, 1);
      equal(parts[0], "hello");
    });

    test('splits string with multiple character separator', () => {
      let parts = "a::b::c".split("::");
      equal(parts.length, 3);
      equal(parts[0], "a");
      equal(parts[1], "b");
      equal(parts[2], "c");
    });
  });

  suite('compareTo', () => {
    test('returns 0 for equal strings', () => {
      let s = "hello";
      equal(s.compareTo(s), 0);
      equal("hello".compareTo("hello"), 0);
      equal("".compareTo(""), 0);
    });

    test('returns negative when this < other', () => {
      isTrue("a".compareTo("b") < 0);
      isTrue("apple".compareTo("banana") < 0);
      isTrue("abc".compareTo("abd") < 0);
      isTrue("".compareTo("a") < 0);
    });

    test('returns positive when this > other', () => {
      isTrue("b".compareTo("a") > 0);
      isTrue("banana".compareTo("apple") > 0);
      isTrue("abd".compareTo("abc") > 0);
      isTrue("a".compareTo("") > 0);
    });

    test('orders prefixes before longer strings', () => {
      isTrue("abc".compareTo("abcd") < 0);
      isTrue("abcd".compareTo("abc") > 0);
    });

    test('orders UTF-8 multi-byte characters by code point', () => {
      isTrue("café".compareTo("cafe") > 0);
      isTrue("α".compareTo("β") < 0);
  suite('regionEqualsBytes', () => {
    let source = "let alpha = beta;";

    test('matches a range equal to the whole string', () => {
      equal("alpha".regionEqualsBytes(source, 4, 9), true);
    });

    test('rejects a range of a different length', () => {
      equal("alpha".regionEqualsBytes(source, 4, 8), false);
      equal("alpha".regionEqualsBytes(source, 4, 10), false);
    });

    test('rejects an equal-length range with different bytes', () => {
      equal("alpha".regionEqualsBytes("betas", 0, 5), false);
    });

    test('matches an empty string against an empty range', () => {
      equal("".regionEqualsBytes(source, 3, 3), true);
      equal("a".regionEqualsBytes(source, 3, 3), false);
    });

    test('compares against the receiver, not its backing array', () => {
      // The receiver here is a slice, so its own offset must be honoured
      // rather than the start of the array it shares.
      let slice = source.sliceBytes(4, 9);
      equal(slice.regionEqualsBytes("xxalphaxx", 2, 7), true);
      equal(slice.regionEqualsBytes("xxbetaxxx", 2, 7), false);
    });

    test('does not match a range outside the other string', () => {
      // Must return false rather than read out of bounds: the length check
      // alone passes here, since the range is the right size.
      equal("abc".regionEqualsBytes("xy", 5, 8), false);
      equal("abc".regionEqualsBytes("xyzw", 2, 5), false);
      equal("abc".regionEqualsBytes(source, -3, 0), false);
      // Far enough out that reading it would trap, not merely read a
      // neighbouring literal's bytes — so this fails loudly without the guard.
      equal("abc".regionEqualsBytes("xy", 1000000, 1000003), false);
    });

    test('compares encoded bytes for multi-byte content', () => {
      // "café" is five bytes in UTF-8, not four characters' worth.
      let text = "café au lait";
      equal("café".regionEqualsBytes(text, 0, 5), true);
      equal("café".regionEqualsBytes(text, 0, 4), false);
    });
  });
});
