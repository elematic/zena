// URLSearchParams tests.
//
// WPT's URLSearchParams coverage lives in .js files rather than the JSON
// data we generate from, so these are hand-ported from
// wpt/url/urlsearchparams-*.any.js plus the spec's own examples.

import { suite, test, TestContext } from 'zena:test';
// isNull/isNotNull are `<T extends anyref>(value: T | null)`, which does not
// infer from a `String | null` argument, so null checks here use
// `isTrue(x == null)` — the same shape url_test.zena and the WPT generator use.
import { equal, isTrue, isFalse, throws } from 'zena:assert';
import { URL, URLSearchParams } from 'zena:url';

export let tests = suite('URLSearchParams', () => {

  suite('construction and parsing', () => {
    test('empty by default', (ctx) => {
      let p = new URLSearchParams();
      equal(p.size, 0);
      equal(p.toString(), '');
    });

    test('parses name=value pairs', (ctx) => {
      let p = new URLSearchParams('a=1&b=2');
      equal(p.size, 2);
      equal(p.get('a') as String, '1');
      equal(p.get('b') as String, '2');
    });

    test('ignores a single leading question mark', (ctx) => {
      let p = new URLSearchParams('?a=1');
      equal(p.size, 1);
      equal(p.get('a') as String, '1');
    });

    test('only the FIRST leading question mark is stripped', (ctx) => {
      let p = new URLSearchParams('??a=1');
      equal(p.get('?a') as String, '1');
    });

    test('a pair with no "=" has an empty value', (ctx) => {
      let p = new URLSearchParams('a');
      equal(p.size, 1);
      equal(p.get('a') as String, '');
    });

    test('empty value after "="', (ctx) => {
      let p = new URLSearchParams('a=');
      equal(p.get('a') as String, '');
    });

    test('empty name before "="', (ctx) => {
      let p = new URLSearchParams('=b');
      equal(p.get('') as String, 'b');
    });

    test('empty segments are dropped', (ctx) => {
      let p = new URLSearchParams('&a=1&&b=2&');
      equal(p.size, 2);
    });

    test('"+" decodes to a space', (ctx) => {
      let p = new URLSearchParams('a=b+c');
      equal(p.get('a') as String, 'b c');
    });

    test('percent escapes decode in names and values', (ctx) => {
      let p = new URLSearchParams('a%20b=c%26d');
      equal(p.get('a b') as String, 'c&d');
    });

    test('only the first "=" splits a pair', (ctx) => {
      let p = new URLSearchParams('a=b=c');
      equal(p.get('a') as String, 'b=c');
    });
  });

  suite('lookup', () => {
    test('get returns the FIRST value', (ctx) => {
      let p = new URLSearchParams('a=1&a=2');
      equal(p.get('a') as String, '1');
    });

    test('get returns null when absent', (ctx) => {
      let p = new URLSearchParams('a=1');
      isTrue(p.get('nope') == null);
    });

    test('getAll returns every value in order', (ctx) => {
      let p = new URLSearchParams('a=1&b=x&a=2');
      let all = p.getAll('a');
      equal(all.length, 2);
      equal(all[0], '1');
      equal(all[1], '2');
    });

    test('getAll is empty when absent', (ctx) => {
      let p = new URLSearchParams('a=1');
      equal(p.getAll('nope').length, 0);
    });

    test('has by name', (ctx) => {
      let p = new URLSearchParams('a=1');
      isTrue(p.has('a'));
      isFalse(p.has('b'));
    });

    test('has by name AND value', (ctx) => {
      let p = new URLSearchParams('a=1&a=2');
      isTrue(p.has('a', '2'));
      isFalse(p.has('a', '3'));
    });
  });

  suite('mutation', () => {
    test('append keeps duplicates, in order', (ctx) => {
      let p = new URLSearchParams();
      p.append('a', '1');
      p.append('a', '2');
      equal(p.size, 2);
      equal(p.toString(), 'a=1&a=2');
    });

    test('set replaces the first and drops the rest', (ctx) => {
      let p = new URLSearchParams('a=1&b=x&a=2');
      p.set('a', '9');
      equal(p.toString(), 'a=9&b=x');
    });

    test('set appends when the name is absent', (ctx) => {
      let p = new URLSearchParams('a=1');
      p.set('b', '2');
      equal(p.toString(), 'a=1&b=2');
    });

    test('set on an empty params', (ctx) => {
      let p = new URLSearchParams();
      p.set('a', '1');
      equal(p.toString(), 'a=1');
    });

    test('delete removes every pair with the name', (ctx) => {
      let p = new URLSearchParams('a=1&b=x&a=2');
      p.delete('a');
      equal(p.toString(), 'b=x');
    });

    test('delete by name AND value removes only exact matches', (ctx) => {
      let p = new URLSearchParams('a=1&a=2');
      p.delete('a', '1');
      equal(p.toString(), 'a=2');
    });

    test('delete of an absent name is a no-op', (ctx) => {
      let p = new URLSearchParams('a=1');
      p.delete('nope');
      equal(p.toString(), 'a=1');
    });
  });

  suite('serialization', () => {
    test('space serializes as "+"', (ctx) => {
      let p = new URLSearchParams();
      p.append('a', 'b c');
      equal(p.toString(), 'a=b+c');
    });

    test('separators in a value are escaped, so they round-trip', (ctx) => {
      let p = new URLSearchParams();
      p.append('a', 'b&c=d');
      equal(p.toString(), 'a=b%26c%3Dd');
      let again = new URLSearchParams(p.toString());
      equal(again.size, 1);
      equal(again.get('a') as String, 'b&c=d');
    });

    test('non-ASCII is UTF-8 percent-encoded', (ctx) => {
      let p = new URLSearchParams();
      p.append('a', 'é');
      equal(p.toString(), 'a=%C3%A9');
    });

    test('"+" in a value is escaped, not left as a space', (ctx) => {
      let p = new URLSearchParams();
      p.append('a', 'b+c');
      equal(p.toString(), 'a=b%2Bc');
      equal((new URLSearchParams(p.toString())).get('a') as String, 'b+c');
    });
  });

  suite('sort', () => {
    test('sorts by name', (ctx) => {
      let p = new URLSearchParams('c=3&a=1&b=2');
      p.sort();
      equal(p.toString(), 'a=1&b=2&c=3');
    });

    test('is stable across equal names', (ctx) => {
      let p = new URLSearchParams('a=first&b=x&a=second');
      p.sort();
      equal(p.toString(), 'a=first&a=second&b=x');
    });

    test('sorting an empty params is a no-op', (ctx) => {
      let p = new URLSearchParams();
      p.sort();
      equal(p.size, 0);
    });

    test('shorter name sorts before its own prefix-extension', (ctx) => {
      let p = new URLSearchParams('ab=2&a=1');
      p.sort();
      equal(p.toString(), 'a=1&ab=2');
    });
  });

  suite('iteration', () => {
    test('for-in yields pairs in order', (ctx) => {
      let p = new URLSearchParams('a=1&b=2');
      let names = new Array<String>();
      let values = new Array<String>();
      for (let pair in p) {
        let (n, v) = pair;
        names.push(n);
        values.push(v);
      }
      equal(names.length, 2);
      equal(names[0], 'a');
      equal(names[1], 'b');
      equal(values[0], '1');
      equal(values[1], '2');
    });

    test('iterating an empty params yields nothing', (ctx) => {
      let p = new URLSearchParams();
      var count = 0;
      for (let pair in p) {
        count += 1;
      }
      equal(count, 0);
    });
  });

  // Mutating during iteration is a hard error rather than the web API's
  // silent misbehavior. In JS these same programs quietly go wrong: deleting
  // 'b' while sitting on 'a' yields ["a","c"] — 'b' is skipped, because the
  // live iterator's index now points past it — and appending never
  // terminates. See ConcurrentModificationError for the reasoning.
  suite('mutation during iteration fails fast', () => {
    test('append during iteration throws', (ctx) => {
      throws(() => {
        let p = new URLSearchParams('a=1&b=2');
        for (let pair in p) {
          p.append('c', '3');
        }
      });
    });

    test('delete of a LATER pair throws instead of skipping it', (ctx) => {
      throws(() => {
        let p = new URLSearchParams('a=1&b=2&c=3');
        for (let pair in p) {
          let (n, _v) = pair;
          if (n == 'a') {
            p.delete('b');
          }
        }
      });
    });

    test('set during iteration throws', (ctx) => {
      throws(() => {
        let p = new URLSearchParams('a=1&b=2');
        for (let pair in p) {
          p.set('a', '9');
        }
      });
    });

    test('sort during iteration throws', (ctx) => {
      throws(() => {
        let p = new URLSearchParams('b=2&a=1');
        for (let pair in p) {
          p.sort();
        }
      });
    });

    test('a read-only pass over the params does NOT throw', (ctx) => {
      let p = new URLSearchParams('a=1&b=2&c=3');
      var count = 0;
      for (let pair in p) {
        count += 1;
      }
      equal(count, 3);
    });

    test('mutating BETWEEN iterations is fine', (ctx) => {
      let p = new URLSearchParams('a=1');
      for (let pair in p) {
        equal(p.size, 1);
      }
      p.append('b', '2');
      var count = 0;
      for (let pair in p) {
        count += 1;
      }
      equal(count, 2);
    });

    test('IterableUtils methods inherit the check', (ctx) => {
      throws(() => {
        let p = new URLSearchParams('a=1&b=2');
        p.some((pair): boolean => {
          p.append('c', '3');
          return false;
        });
      });
    });
  });

  suite('URL.searchParams', () => {
    test('parses the URL query', (ctx) => {
      let u = URL.parse('https://example.com/?a=1&b=2', null) as URL;
      let p = u.searchParams();
      equal(p.size, 2);
      equal(p.get('a') as String, '1');
    });

    test('is empty when there is no query', (ctx) => {
      let u = URL.parse('https://example.com/', null) as URL;
      equal(u.searchParams().size, 0);
    });

    test('is a snapshot — mutating it does not touch the URL', (ctx) => {
      let u = URL.parse('https://example.com/?a=1', null) as URL;
      let p = u.searchParams();
      p.set('a', '999');
      p.append('b', '2');
      equal(u.search, '?a=1');
      equal(u.href, 'https://example.com/?a=1');
      // ...and a second call gives a fresh snapshot of the URL, not the
      // one we just mutated.
      equal(u.searchParams().get('a') as String, '1');
    });

    test('decodes escapes from the query', (ctx) => {
      let u = URL.parse('https://example.com/?a=b%20c', null) as URL;
      equal(u.searchParams().get('a') as String, 'b c');
    });
  });
});
