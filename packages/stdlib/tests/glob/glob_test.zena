// Tests for zena:glob module
import {suite, test, TestContext} from 'zena:test';
import {equal, notEqual, isTrue, isFalse, greater, throws} from 'zena:assert';
import {hasMagic, globToRegex, GlobPattern, GlobSet, matchGlob} from 'zena:glob';

export let tests = suite('Glob', (): void => {
  test('hasMagic', (ctx: TestContext): void => {
    isTrue(hasMagic('*.zena'));
    isTrue(hasMagic('tests/**/*.zena'));
    isTrue(hasMagic('test_?.zena'));
    isTrue(hasMagic('file[0-9].txt'));
    isTrue(hasMagic('index.{js,d.ts}'));
    isFalse(hasMagic('foo/bar/baz.zena'));
    isFalse(hasMagic('plain_filename.txt'));
    isFalse(hasMagic(''));
  });

  test('single star wildcard (*)', (ctx: TestContext): void => {
    let pat = new GlobPattern('*.zena');
    isTrue(pat.matches('foo.zena'));
    isTrue(pat.matches('test_runner.zena'));
    isFalse(pat.matches('foo.txt'));
    isFalse(pat.matches('dir/foo.zena'));

    let dirPat = new GlobPattern('src/*.zena');
    isTrue(dirPat.matches('src/main.zena'));
    isFalse(dirPat.matches('src/sub/main.zena'));
    isFalse(dirPat.matches('other/main.zena'));
  });

  test('double star wildcard (**)', (ctx: TestContext): void => {
    let pat = new GlobPattern('**/*.zena');
    isTrue(pat.matches('foo.zena'));
    isTrue(pat.matches('src/foo.zena'));
    isTrue(pat.matches('a/b/c/foo.zena'));
    isFalse(pat.matches('foo.txt'));
    isFalse(pat.matches('a/b/c/foo.txt'));

    let prefixPat = new GlobPattern('tests/**');
    isTrue(prefixPat.matches('tests/foo'));
    isTrue(prefixPat.matches('tests/a/b/c'));
    isFalse(prefixPat.matches('other/a/b/c'));
  });

  test('question mark wildcard (?)', (ctx: TestContext): void => {
    let pat = new GlobPattern('file?.txt');
    isTrue(pat.matches('file1.txt'));
    isTrue(pat.matches('fileA.txt'));
    isFalse(pat.matches('file12.txt'));
    isFalse(pat.matches('file.txt'));
    isFalse(pat.matches('file/.txt'));
  });

  test('character class ([...])', (ctx: TestContext): void => {
    let pat = new GlobPattern('file[0-9].txt');
    isTrue(pat.matches('file0.txt'));
    isTrue(pat.matches('file5.txt'));
    isTrue(pat.matches('file9.txt'));
    isFalse(pat.matches('fileA.txt'));

    let negPat = new GlobPattern('file[!0-9].txt');
    isTrue(negPat.matches('fileA.txt'));
    isFalse(negPat.matches('file0.txt'));
  });

  test('brace alternatives ({a,b})', (ctx: TestContext): void => {
    let pat = new GlobPattern('index.{js,d.ts,js.map}');
    isTrue(pat.matches('index.js'));
    isTrue(pat.matches('index.d.ts'));
    isTrue(pat.matches('index.js.map'));
    isFalse(pat.matches('index.ts'));
    isFalse(pat.matches('index.{js,d.ts,js.map}'));

    // Alternatives hold glob syntax of their own, and whole segments.
    let dirs = new GlobPattern('{src,test}/**/*.zena');
    isTrue(dirs.matches('src/a.zena'));
    isTrue(dirs.matches('test/deep/b.zena'));
    isFalse(dirs.matches('lib/a.zena'));

    let wild = new GlobPattern('out/*.{wasm,w?t}');
    isTrue(wild.matches('out/cli.wasm'));
    isTrue(wild.matches('out/cli.wat'));
    isFalse(wild.matches('out/cli.js'));

    // Nesting, and an empty alternative.
    let nested = new GlobPattern('a{b,c{d,e}}f');
    isTrue(nested.matches('abf'));
    isTrue(nested.matches('acdf'));
    isTrue(nested.matches('acef'));
    isFalse(nested.matches('acf'));

    let optional = new GlobPattern('main{,.test}.zena');
    isTrue(optional.matches('main.zena'));
    isTrue(optional.matches('main.test.zena'));

    // A comma outside braces is an ordinary character.
    isTrue(matchGlob('a,b', 'a,b'));
  });

  test('an unclosed brace is rejected when the pattern is built', (ctx: TestContext): void => {
    throws(() => {
      new GlobPattern('index.{js,ts');
    });
  });

  test('GlobSet: the last pattern to match decides', (ctx: TestContext): void => {
    let set = new GlobSet(['zena/**/*.zena', '!zena/**/*_test.zena']);
    isTrue(set.matches('zena/lib/engine.zena'));
    isFalse(set.matches('zena/test/engine_test.zena'));
    isFalse(set.matches('README.md'));

    // A later positive pattern takes a path back.
    let reInclude = new GlobSet(['src/**', '!src/tmp/**', 'src/tmp/keep.ts']);
    isTrue(reInclude.matches('src/a.ts'));
    isFalse(reInclude.matches('src/tmp/x.ts'));
    isTrue(reInclude.matches('src/tmp/keep.ts'));

    // Negation only ever removes: a list of nothing but negations
    // matches nothing.
    let onlyNegations = new GlobSet(['!*.ts']);
    isFalse(onlyNegations.matches('a.js'));

    let braces = new GlobSet(['index.{js,d.ts}']);
    isTrue(braces.matches('index.d.ts'));
    equal(braces.size, 1);
  });

  test('matchGlob helper', (ctx: TestContext): void => {
    isTrue(matchGlob('*.wasm', 'out.wasm'));
    isFalse(matchGlob('*.wasm', 'out.wat'));
    isTrue(matchGlob('foo/**/bar', 'foo/bar'));
    isTrue(matchGlob('foo/**/bar', 'foo/sub/bar'));
    isTrue(matchGlob('foo/**/bar', 'foo/a/b/c/bar'));
  });
});
