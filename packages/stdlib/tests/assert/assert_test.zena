// Assert stdlib tests using zena:test
import {suite, test, TestContext} from 'zena:test';
import {equal, notEqual, isTrue, isFalse, greater, greaterOrEqual, less, lessOrEqual, throws, doesNotThrow, same, notSame, isNull, isNotNull, fail} from 'zena:assert';

class TestBox {
  value: i32;
  new(v: i32) : value = v;
}

export let tests = suite('Assert', () => {
  test('equal passes for same i32 values', (ctx) => {
    equal(1 + 1, 2);
    equal(5 - 3, 2);
    equal(10, 10);
  });

  test('equal passes for equal strings', (ctx) => { 
    equal('hello', 'hello');
  });

  test('equal throws for unequal strings', (ctx) => {
    throws(() => {
      equal('hello', 'world');
    });
  });

  test('equal throws for unequal i32 values', (ctx) => {
    throws(() => {
      equal(42, 43);
    });
  });

  test('notEqual passes for different values', (ctx) => {
    notEqual(1, 2);
    notEqual(10, 20);
  });

  test('notEqual throws for equal values', (ctx) => {
    throws(() => {
      notEqual(1, 1);
    });
  });

  test('isTrue passes for true', (ctx) => {
    isTrue(true);
    isTrue(1 == 1);
    isTrue(2 > 1);
  });

  test('isFalse passes for false', (ctx) => {
    isFalse(false);
    isFalse(1 == 2);
    isFalse(1 > 2);
  });

  test('isTrue throws for false', (ctx) => {
    throws(() => {
      isTrue(false);
    });
  });

  test('isFalse throws for true', (ctx) => {
    throws(() => {
      isFalse(true);
    });
  });

  test('fail always throws', (ctx) => {
    throws(() => {
      fail();
    });
  });

  test('fail throws with custom message', (ctx) => {
    throws(() => {
      fail('intentional failure');
    });
  });

  test('greater passes when actual > expected', (ctx) => {
    greater(5, 3);
  });

  test('greater throws when actual <= expected', (ctx) => {
    throws(() => {
      greater(5, 5);
    });
  });

  test('greaterOrEqual passes when actual >= expected', (ctx) => {
    greaterOrEqual(5, 3);
    greaterOrEqual(5, 5);
  });

  test('greaterOrEqual throws when actual < expected', (ctx) => {
    throws(() => {
      greaterOrEqual(3, 5);
    });
  });

  test('less passes when actual < expected', (ctx) => {
    less(3, 5);
  });

  test('less throws when actual >= expected', (ctx) => {
    throws(() => {
      less(5, 5);
    });
  });

  test('lessOrEqual passes when actual <= expected', (ctx) => {
    lessOrEqual(3, 5);
    lessOrEqual(5, 5);
  });

  test('lessOrEqual throws when actual > expected', (ctx) => {
    throws(() => {
      lessOrEqual(5, 3);
    });
  });

  test('throws passes when function throws', (ctx) => {
    throws(() => {
      throw new Error('expected');
    });
  });

  test('doesNotThrow passes when function does not throw', (ctx) => {
    doesNotThrow(() => {
    });
  });

  test('same passes for same reference', (ctx) => {
    let b = new TestBox(1);
    same(b, b);
  });

  test('notSame passes for different references', (ctx) => {
    let a = new TestBox(1);
    let b = new TestBox(1);
    notSame(a, b);
  });

  test('isNull passes for null', (ctx) => {
    let b: TestBox | null = null;
    isNull<TestBox>(b);
  });

  test('isNotNull passes for non-null', (ctx) => {
    let b: TestBox | null = new TestBox(1);
    isNotNull<TestBox>(b);
  });
});
