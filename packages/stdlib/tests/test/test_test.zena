// Test stdlib tests using zena:test
// Tests the test framework's data structures (Suite, TestResult, test registration)
import {
  suite, test, testOnly, testSkip, TestResult, TestContext,
} from 'zena:test';
import {equal, isTrue, isFalse, isNull, isNotNull, fail} from 'zena:assert';

export let tests = suite('Test Framework', () => {
  suite('test registration', () => {
    test('test() registers a test case in current suite', (ctx) => {
      let s = suite('my suite', () => {
        test('my test', (ctx) => {
          // empty test
        });
      });
      equal(s.tests.length, 1);
    });

    test('multiple tests are registered', (ctx) => {
      let s = suite('my suite', () => {
        test('test 1', (ctx) => {});
        test('test 2', (ctx) => {});
        test('test 3', (ctx) => {});
      });
      equal(s.tests.length, 3);
    });
  });

  suite('suite registration', () => {
    test('suite() returns a Suite with correct name', (ctx) => {
      let s = suite('my suite', () => {
        test('nested test', (ctx) => {});
      });
      equal(s.name, 'my suite');
    });

    test('nested suites work', (ctx) => {
      let outer = suite('outer', () => {
        suite('inner', () => {
          test('deep test', (ctx) => {});
        });
      });
      equal(outer.suites.length, 1);
    });

    test('export let tests = suite(...) pattern works', (ctx) => {
      let s = suite('Array', () => {
        test('push increases length', (ctx) => {
          // test body
        });
        test('pop returns last', (ctx) => {
          // test body
        });
      });
      equal(s.name, 'Array');
      equal(s.tests.length, 2);
    });
  });

  suite('TestResult', () => {
    test('can create passing result', (ctx) => {
      let result = new TestResult('my test', true, null);
      equal(result.name, 'my test');
      isTrue(result.passed);
      isNull<String>(result.error);
    });

    test('can create failing result', (ctx) => {
      let result = new TestResult('my test', false, 'test failed');
      equal(result.name, 'my test');
      isFalse(result.passed);
      isNotNull<String>(result.error);
    });
  });

  suite('suite.run()', () => {
    test('run() returns SuiteResult with correct name', (ctx) => {
      let s = suite('my suite', () => {
        test('a test', (ctx) => {});
      });
      let result = s.run();
      equal(result.name, 'my suite');
    });

    test('passing test increments passed count', (ctx) => {
      let s = suite('passing suite', () => {
        test('passes', (ctx) => {
          equal(1, 1);
        });
      });
      let result = s.run();
      equal(result.passed, 1);
      equal(result.failed, 0);
    });

    test('failing test increments failed count', (ctx) => {
      let s = suite('failing suite', () => {
        test('fails', (ctx) => {
          fail('intentional failure');
        });
      });
      let result = s.run();
      equal(result.passed, 0);
      equal(result.failed, 1);
    });

    test('mixed passing and failing tests', (ctx) => {
      let s = suite('mixed suite', () => {
        test('passes 1', (ctx) => {
          equal(1, 1);
        });
        test('fails', (ctx) => {
          fail();
        });
        test('passes 2', (ctx) => {
          isTrue(true);
        });
      });
      let result = s.run();
      equal(result.passed, 2);
      equal(result.failed, 1);
    });

    test('test results contain correct pass/fail status', (ctx) => {
      let s = suite('status suite', () => {
        test('passes', (ctx) => {});
        test('fails', (ctx) => {
          fail();
        });
      });
      let result = s.run();
      equal(result.tests.length, 2);
      isTrue(result.tests[0].passed);
      isFalse(result.tests[1].passed);
    });

    test('failing test result contains error message', (ctx) => {
      let s = suite('error suite', () => {
        test('fails with message', (ctx) => {
          fail('custom error message');
        });
      });
      let result = s.run();
      isFalse(result.tests[0].passed);
      isNotNull<String>(result.tests[0].error);
    });

    test('nested suite results are aggregated', (ctx) => {
      let s = suite('outer', () => {
        test('outer passes', (ctx) => {});
        suite('inner', () => {
          test('inner passes', (ctx) => {});
          test('inner fails', (ctx) => {
            fail();
          });
        });
      });
      let result = s.run();
      // outer: 1 pass, inner: 1 pass + 1 fail = total 2 pass, 1 fail
      equal(result.passed, 2);
      equal(result.failed, 1);
      equal(result.suites.length, 1);
    });
  });

  suite('testSkip', () => {
    test('testSkip() registers a skipped test', (ctx) => {
      let s = suite('skip suite', () => {
        testSkip('skipped test', (ctx) => {
          fail('should not run');
        });
      });
      equal(s.tests.length, 1);
    });

    test('skipped tests do not run', (ctx) => {
      let s = suite('skip suite', () => {
        test('runs', (ctx) => {});
        testSkip('skipped', (ctx) => {
          fail('should not run');
        });
        test('also runs', (ctx) => {});
      });
      let result = s.run();
      // Only 2 tests run (the skipped one doesn't)
      equal(result.tests.length, 2);
      equal(result.passed, 2);
      equal(result.failed, 0);
    });
  });

  suite('testOnly', () => {
    test('testOnly() filters to only that test', (ctx) => {
      let s = suite('only suite', () => {
        test('skipped', (ctx) => {});
        testOnly('only this', (ctx) => {});
        test('also skipped', (ctx) => {});
      });
      let result = s.run();
      // Only 1 test runs
      equal(result.tests.length, 1);
      equal(result.passed, 1);
    });

    test('testOnly() in nested suite filters parent tests', (ctx) => {
      let s = suite('outer', () => {
        test('outer test - should be skipped', (ctx) => {});
        suite('inner', () => {
          test('inner test - should be skipped', (ctx) => {});
          testOnly('only this runs', (ctx) => {});
        });
        test('another outer - should be skipped', (ctx) => {});
      });
      let result = s.run();
      // Outer tests are skipped, only the testOnly runs
      equal(result.tests.length, 0);
      equal(result.suites.length, 1);
      equal(result.suites[0].tests.length, 1);
      equal(result.passed, 1);
    });

    test('hasOnly propagates from nested to parent', (ctx) => {
      let s = suite('outer', () => {
        suite('inner', () => {
          testOnly('only test', (ctx) => {});
        });
      });
      isTrue(s.hasOnly);
    });
  });
});
