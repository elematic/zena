import { suite, test, TestContext } from 'zena:test';
import { equal, isTrue, isFalse, isNull, fail } from 'zena:assert';
import { Stream, readAllText } from 'zena:stream';
import { milliseconds } from 'zena:time';
import { Completer, Future } from 'zena:async';
import { Own, Result } from 'zena:core';
import {
  App, ErrorCode, HttpError, Request, Response, SendOptions, WireResponse,
  httpDate, mimeType, send, serve, toWireResponse
} from 'zena:http';

function unit() {}

/** The outcome of one request through `serve`. */
class Served {
  res: Response;
  /** Whether the middleware passed the request on to `next`. */
  passed: boolean;
  new(this.res, this.passed);
}

let fixtures = () => 'packages/stdlib/tests/http/fixtures/static';

/** One request through `serve(fixtures(), options)`, run to completion. */
async function serveOne(
  req: Own<Request>,
  options: SendOptions
): Future<Served> {
  let middleware = serve(fixtures(), options);
  let res = new Response();
  var passed = false;
  await middleware(req, res, async (passedOn): Future<void> => {
    passed = true;
  });
  return new Served(res, passed);
}

async function get(path: String): Future<Served> {
  return await serveOne(new Request.fromUrl(`http://localhost${path}`), {});
}

async function getWith(path: String, name: String, value: String): Future<Served> {
  let headers: HashMap<String, String> = {name => value};
  return await serveOne(
      new Request.fromUrl(`http://localhost${path}`, 'GET', headers), {});
}

async function bodyText(res: Response): Future<String> {
  return await readAllText(res.body as Stream<u8>);
}

export let tests = suite('zena:http static files', () => {
  test('serves a file with its headers', async (ctx) => {
    let served = await get('/hello.txt');
    isFalse(served.passed);
    let res = served.res;
    equal(res.statusCode, 200);
    equal(await bodyText(res), 'world\n');
    equal(res.getHeader('content-type') as String, 'text/plain; charset=utf-8');
    equal(res.getHeader('content-length') as String, '6');
    equal(res.getHeader('cache-control') as String, 'max-age=0');
    equal(res.getHeader('x-content-type-options') as String, 'nosniff');
    isTrue((res.getHeader('last-modified') as String).endsWith(' GMT'));
    isTrue((res.getHeader('etag') as String).startsWith('W/"6-'));
  });

  test('serves the index file for a directory', async (ctx) => {
    equal(await bodyText((await get('/')).res), '<h1>home</h1>\n');
    equal(await bodyText((await get('/docs/')).res), '<h1>docs</h1>\n');
    // Without the trailing slash too, since `format` is on.
    equal(await bodyText((await get('/docs')).res), '<h1>docs</h1>\n');
    equal((await get('/docs/')).res.getHeader('content-type') as String,
        'text/html; charset=utf-8');
  });

  test('passes a directory on when format is off', async (ctx) => {
    let served = await serveOne(new Request.fromUrl('http://localhost/docs'), {format: false});
    isTrue(served.passed);
  });

  test('passes a missing file on to next', async (ctx) => {
    let served = await get('/missing.txt');
    isTrue(served.passed);
    equal(served.res.statusCode, 404);
    isTrue(served.res.body == null);
  });

  test('serves the notFound file with status 404 when next leaves the response unhandled', async (ctx) => {
    let served = await serveOne(
        new Request.fromUrl('http://localhost/missing'), {notFound: 'about.html'});
    isTrue(served.passed);
    equal(served.res.statusCode, 404);
    equal(await bodyText(served.res), '<h1>about</h1>\n');
    equal(served.res.getHeader('content-type') as String, 'text/html; charset=utf-8');
    equal(served.res.getHeader('x-content-type-options') as String, 'nosniff');

    let headServed = await serveOne(
        new Request.fromUrl('http://localhost/missing', 'HEAD'), {notFound: 'about.html'});
    isTrue(headServed.passed);
    equal(headServed.res.statusCode, 404);
    isTrue(headServed.res.body == null);

    // When `next` handles the request, `notFound` does not overwrite it.
    let app = new App();
    app.use(serve(fixtures(), {notFound: 'about.html'}));
    app.use(async (req, res, next) => {
      res.body = 'downstream';
    });
    let handledRes = new Response();
    await app.handleRequest(new Request.fromUrl('http://localhost/missing'), handledRes);
    equal(handledRes.statusCode, 200);
    equal(handledRes.body as String, 'downstream');
  });

  test('passes hidden paths on to next', async (ctx) => {
    isTrue((await get('/.private/key.txt')).passed);
  });

  test('serves hidden paths when asked to', async (ctx) => {
    let served = await serveOne(
        new Request.fromUrl('http://localhost/.private/key.txt'), {hidden: true});
    equal(await bodyText(served.res), 'secret\n');
  });

  test('decodes the path', async (ctx) => {
    equal(await bodyText((await get('/hell%6F.txt')).res), 'world\n');
  });

  test('refuses a path above the root with 403', async (ctx) => {
    let req = new Request.fromUrl('http://localhost/');
    req.path = '/docs/../../static_test.zena';
    var status = 0;
    try {
      await serveOne(req, {});
    } catch (e) {
      if (e is HttpError) {
        status = e.status;
      }
    }
    equal(status, 403);
  });

  test('passes other methods on to next', async (ctx) => {
    let served = await serveOne(
        new Request.fromUrl('http://localhost/hello.txt', 'POST'), {});
    isTrue(served.passed);
  });

  test('answers HEAD without a body', async (ctx) => {
    let served = await serveOne(
        new Request.fromUrl('http://localhost/hello.txt', 'HEAD'), {});
    equal(served.res.statusCode, 200);
    isTrue(served.res.body == null);
    equal(served.res.getHeader('content-length') as String, '6');
  });

  test('answers a matching If-None-Match with 304', async (ctx) => {
    let etag = (await get('/hello.txt')).res.getHeader('etag') as String;
    let res = (await getWith('/hello.txt', 'If-None-Match', etag)).res;
    equal(res.statusCode, 304);
    isTrue(res.body == null);
    isNull(res.getHeader('content-length'));
    // A strong form of the same tag matches too: the comparison is weak.
    let strong = etag.sliceBytes(2, etag.length);
    equal((await getWith('/hello.txt', 'If-None-Match', `"x", ${strong}`)).res.statusCode, 304);
    equal((await getWith('/hello.txt', 'If-None-Match', '"other"')).res.statusCode, 200);
  });

  test('answers If-None-Match with 304 only for GET and HEAD', async (ctx) => {
    let etag = (await get('/hello.txt')).res.getHeader('etag') as String;
    let headers: HashMap<String, String> = {'If-None-Match' => etag};
    let req = new Request.fromUrl('http://localhost/', 'POST', headers);
    let res = new Response();
    await send(req, res, 'hello.txt', {root: fixtures()});
    equal(res.statusCode, 200);
    equal(await bodyText(res), 'world\n');
  });

  test('an error after a file is sent stops its stream', async (ctx) => {
    let app = new App();
    var sentBody: Stream<u8> | null = null;
    app.use(async (req, res, next) => {
      await next(req);
      sentBody = res.body as Stream<u8>;
      throw new HttpError(500);
    });
    app.use(serve(fixtures()));
    let res = new Response();
    await app.handleRequest(new Request.fromUrl('http://localhost/hello.txt'), res);
    equal(res.statusCode, 500);
    // Stopped, the file's stream reads as ended rather than as the file.
    equal(await readAllText(sentBody as Stream<u8>), '');
  });

  test('prefers a brotli variant the client accepts', async (ctx) => {
    let res = (await getWith('/style.css', 'Accept-Encoding', 'gzip, deflate, br')).res;
    equal(await bodyText(res), 'brotli bytes of style.css\n');
    equal(res.getHeader('content-encoding') as String, 'br');
    equal(res.getHeader('content-type') as String, 'text/css; charset=utf-8');
    equal(res.getHeader('vary') as String, 'Accept-Encoding');
  });

  test('falls back to a gzip variant', async (ctx) => {
    let res = (await getWith('/style.css', 'Accept-Encoding', 'gzip, br;q=0')).res;
    equal(await bodyText(res), 'gzip bytes of style.css\n');
    equal(res.getHeader('content-encoding') as String, 'gzip');
  });

  test('serves the plain file without an accepted encoding', async (ctx) => {
    let res = (await getWith('/style.css', 'Accept-Encoding', 'identity')).res;
    equal(await bodyText(res), 'body { color: red; }\n');
    isNull(res.getHeader('content-encoding'));
    isNull((await get('/style.css')).res.getHeader('content-encoding'));
    // Identity preferred over gzip.
    let res2 = (await getWith('/style.css', 'Accept-Encoding', 'gzip;q=0.5, identity')).res;
    isNull(res2.getHeader('content-encoding'));
  });

  test('tries extensions for a path without one', async (ctx) => {
    let served = await serveOne(
        new Request.fromUrl('http://localhost/about'), {extensions: ['html']});
    equal(await bodyText(served.res), '<h1>about</h1>\n');
    isTrue((await get('/about')).passed);
  });

  test('sets Cache-Control from maxAge and immutable', async (ctx) => {
    let served = await serveOne(new Request.fromUrl('http://localhost/hello.txt'),
        {maxAge: milliseconds(60000 as i64), immutable: true});
    equal(served.res.getHeader('cache-control') as String, 'max-age=60,immutable');
  });

  test('calls setHeaders with the file', async (ctx) => {
    var seen = '';
    let served = await serveOne(new Request.fromUrl('http://localhost/hello.txt'), {
      setHeaders: (res, path, stat) => {
        seen = `${path} ${stat.size}`;
        res.setHeader('cache-control', 'no-store');
      },
    });
    equal(seen, 'packages/stdlib/tests/http/fixtures/static/hello.txt 6');
    equal(served.res.getHeader('cache-control') as String, 'no-store');
  });

  test('serves application/octet-stream for an unknown type', async (ctx) => {
    equal((await get('/data.xyz')).res.getHeader('content-type') as String,
        'application/octet-stream');
  });

  test('send throws 404 for a missing file', async (ctx) => {
    var status = 0;
    try {
      let req = new Request.fromUrl('http://localhost/');
      await send(req, new Response(), 'nope.txt', {root: fixtures()});
    } catch (e) {
      if (e is HttpError) {
        status = e.status;
      }
    }
    equal(status, 404);
  });

  test('send serves a file under its root', async (ctx) => {
    let req = new Request.fromUrl('http://localhost/');
    let res = new Response();
    let sent = await send(req, res, 'docs/index.html', {root: fixtures()});
    equal(sent as String, 'packages/stdlib/tests/http/fixtures/static/docs/index.html');
    equal(await bodyText(res), '<h1>docs</h1>\n');
  });

  test('send preserves an explicitly set status code on GET and HEAD', async (ctx) => {
    let getReq = new Request.fromUrl('http://localhost/missing');
    let getRes = new Response();
    getRes.statusCode = 404;
    await send(getReq, getRes, 'about.html', {root: fixtures()});
    equal(getRes.statusCode, 404);
    equal(await bodyText(getRes), '<h1>about</h1>\n');

    let headReq = new Request.fromUrl('http://localhost/missing', 'HEAD');
    let headRes = new Response();
    headRes.statusCode = 404;
    await send(headReq, headRes, 'about.html', {root: fixtures()});
    equal(headRes.statusCode, 404);
    isTrue(headRes.body == null);
  });

  test('a served file reaches the wire response', async (ctx) => {
    // The file's stream goes into `response.new` as it is; reading the
    // wire response's body back brings the file's bytes.
    let res = (await get('/hello.txt')).res;
    let wire = toWireResponse(res);
    equal(wire.getStatusCode() as i32, 200);
    let received = new Completer<Result<void, ErrorCode>>();
    let (body, trailers) = WireResponse.consumeBody(wire, received.future);
    equal(await readAllText(body), 'world\n');
    received.complete((true, unit()));
  });

  test('httpDate formats IMF-fixdate', (ctx) => {
    equal(httpDate(0 as i64), 'Thu, 01 Jan 1970 00:00:00 GMT');
    equal(httpDate(86399 as i64), 'Thu, 01 Jan 1970 23:59:59 GMT');
    equal(httpDate(951782400 as i64), 'Tue, 29 Feb 2000 00:00:00 GMT');
    equal(httpDate(1791990983 as i64), 'Wed, 14 Oct 2026 15:16:23 GMT');
    equal(httpDate(4102444799 as i64), 'Thu, 31 Dec 2099 23:59:59 GMT');
  });

  test('mimeType maps extensions', (ctx) => {
    equal(mimeType('a/b/index.HTML') as String, 'text/html; charset=utf-8');
    equal(mimeType('app.wasm') as String, 'application/wasm');
    isNull(mimeType('README'));
    isNull(mimeType('x.unknown'));
  });
});
