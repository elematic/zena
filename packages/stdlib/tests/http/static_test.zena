import { suite, test, TestContext } from 'zena:test';
import { equal, isTrue, isFalse, isNull, fail } from 'zena:assert';
import { Stream, readAllText } from 'zena:stream';
import { milliseconds } from 'zena:time';
import { blockOn } from 'zena:wasi';
import { Completer } from 'zena:async';
import { Ok, Outcome } from 'zena:core';
import {
  App, ErrorCode, HttpError, Request, Response, SendOptions, WireResponse,
  httpDate, mimeType, send, serve, toWireResponse
} from 'zena:http';

function unit(): void {}

/** The outcome of one request through `serve`. */
class Served {
  res: Response;
  /** Whether the middleware passed the request on to `next`. */
  passed: boolean;
  new(this.res, this.passed);
}

let fixtures = (): String => 'packages/stdlib/tests/http/fixtures/static';

/** One request through `serve(fixtures(), options)`, run to completion. */
let serveOne = (
  req: Request,
  options: SendOptions
): Served => {
  let middleware = serve(fixtures(), options);
  let res = new Response();
  var passed = false;
  blockOn(middleware(req, res, async (): Future<void> => {
    passed = true;
  }));
  return new Served(res, passed);
};

let get = (path: String): Served =>
    serveOne(new Request.fromUrl(`http://localhost${path}`), {});

let getWith = (path: String, name: String, value: String): Served => {
  let headers = new Map<String, String>();
  headers[name] = value;
  return serveOne(
      new Request.fromUrl(`http://localhost${path}`, 'GET', headers), {});
};

let bodyText = (res: Response): String =>
    blockOn(readAllText(res.body as Stream<u8>));

export let tests = suite('zena:http static files', (): void => {
  test('serves a file with its headers', (ctx: TestContext): void => {
    let served = get('/hello.txt');
    isFalse(served.passed);
    let res = served.res;
    equal(res.statusCode, 200);
    equal(bodyText(res), 'world\n');
    equal(res.getHeader('content-type') as String, 'text/plain; charset=utf-8');
    equal(res.getHeader('content-length') as String, '6');
    equal(res.getHeader('cache-control') as String, 'max-age=0');
    isTrue((res.getHeader('last-modified') as String).endsWith(' GMT'));
    isTrue((res.getHeader('etag') as String).startsWith('W/"6-'));
  });

  test('serves the index file for a directory', (ctx: TestContext): void => {
    equal(bodyText(get('/').res), '<h1>home</h1>\n');
    equal(bodyText(get('/docs/').res), '<h1>docs</h1>\n');
    // Without the trailing slash too, since `format` is on.
    equal(bodyText(get('/docs').res), '<h1>docs</h1>\n');
    equal(get('/docs/').res.getHeader('content-type') as String,
        'text/html; charset=utf-8');
  });

  test('passes a directory on when format is off', (ctx: TestContext): void => {
    let served = serveOne(new Request.fromUrl('http://localhost/docs'), {format: false});
    isTrue(served.passed);
  });

  test('passes a missing file on to next', (ctx: TestContext): void => {
    let served = get('/missing.txt');
    isTrue(served.passed);
    equal(served.res.statusCode, 404);
    isTrue(served.res.body == null);
  });

  test('passes hidden paths on to next', (ctx: TestContext): void => {
    isTrue(get('/.private/key.txt').passed);
  });

  test('serves hidden paths when asked to', (ctx: TestContext): void => {
    let served = serveOne(
        new Request.fromUrl('http://localhost/.private/key.txt'), {hidden: true});
    equal(bodyText(served.res), 'secret\n');
  });

  test('decodes the path', (ctx: TestContext): void => {
    equal(bodyText(get('/hell%6F.txt').res), 'world\n');
  });

  test('refuses a path above the root with 403', (ctx: TestContext): void => {
    let req = new Request.fromUrl('http://localhost/');
    req.path = '/docs/../../static_test.zena';
    var status = 0;
    try {
      serveOne(req, {});
    } catch (e) {
      if (e is HttpError) {
        status = (e as HttpError).status;
      }
    }
    equal(status, 403);
  });

  test('passes other methods on to next', (ctx: TestContext): void => {
    let served = serveOne(
        new Request.fromUrl('http://localhost/hello.txt', 'POST'), {});
    isTrue(served.passed);
  });

  test('answers HEAD without a body', (ctx: TestContext): void => {
    let served = serveOne(
        new Request.fromUrl('http://localhost/hello.txt', 'HEAD'), {});
    equal(served.res.statusCode, 200);
    isTrue(served.res.body == null);
    equal(served.res.getHeader('content-length') as String, '6');
  });

  test('answers a matching If-None-Match with 304', (ctx: TestContext): void => {
    let etag = get('/hello.txt').res.getHeader('etag') as String;
    let res = getWith('/hello.txt', 'If-None-Match', etag).res;
    equal(res.statusCode, 304);
    isTrue(res.body == null);
    isNull(res.getHeader('content-length'));
    // A strong form of the same tag matches too: the comparison is weak.
    let strong = etag.sliceBytes(2, etag.length);
    equal(getWith('/hello.txt', 'If-None-Match', `"x", ${strong}`).res.statusCode, 304);
    equal(getWith('/hello.txt', 'If-None-Match', '"other"').res.statusCode, 200);
  });

  test('answers If-None-Match with 304 only for GET and HEAD', (ctx: TestContext): void => {
    let etag = get('/hello.txt').res.getHeader('etag') as String;
    let headers = new Map<String, String>();
    headers['If-None-Match'] = etag;
    let req = new Request.fromUrl('http://localhost/', 'POST', headers);
    let res = new Response();
    blockOn(send(req, res, 'hello.txt', {root: fixtures()}));
    equal(res.statusCode, 200);
    equal(bodyText(res), 'world\n');
  });

  test('an error after a file is sent stops its stream', (ctx: TestContext): void => {
    let app = new App();
    var sentBody: Stream<u8> | null = null;
    app.use(async (req, res, next) => {
      await next();
      sentBody = res.body as Stream<u8>;
      throw new HttpError(500);
    });
    app.use(serve(fixtures()));
    let res = new Response();
    blockOn(app.handleRequest(new Request.fromUrl('http://localhost/hello.txt'), res));
    equal(res.statusCode, 500);
    // Stopped, the file's stream reads as ended rather than as the file.
    equal(blockOn(readAllText(sentBody as Stream<u8>)), '');
  });

  test('prefers a brotli variant the client accepts', (ctx: TestContext): void => {
    let res = getWith('/style.css', 'Accept-Encoding', 'gzip, deflate, br').res;
    equal(bodyText(res), 'brotli bytes of style.css\n');
    equal(res.getHeader('content-encoding') as String, 'br');
    equal(res.getHeader('content-type') as String, 'text/css; charset=utf-8');
    equal(res.getHeader('vary') as String, 'Accept-Encoding');
  });

  test('falls back to a gzip variant', (ctx: TestContext): void => {
    let res = getWith('/style.css', 'Accept-Encoding', 'gzip, br;q=0').res;
    equal(bodyText(res), 'gzip bytes of style.css\n');
    equal(res.getHeader('content-encoding') as String, 'gzip');
  });

  test('serves the plain file without an accepted encoding', (ctx: TestContext): void => {
    let res = getWith('/style.css', 'Accept-Encoding', 'identity').res;
    equal(bodyText(res), 'body { color: red; }\n');
    isNull(res.getHeader('content-encoding'));
    isNull(get('/style.css').res.getHeader('content-encoding'));
    // Identity preferred over gzip.
    let res2 = getWith('/style.css', 'Accept-Encoding', 'gzip;q=0.5, identity').res;
    isNull(res2.getHeader('content-encoding'));
  });

  test('tries extensions for a path without one', (ctx: TestContext): void => {
    let served = serveOne(
        new Request.fromUrl('http://localhost/about'), {extensions: ['html']});
    equal(bodyText(served.res), '<h1>about</h1>\n');
    isTrue(get('/about').passed);
  });

  test('sets Cache-Control from maxAge and immutable', (ctx: TestContext): void => {
    let served = serveOne(new Request.fromUrl('http://localhost/hello.txt'),
        {maxAge: milliseconds(60000 as i64), immutable: true});
    equal(served.res.getHeader('cache-control') as String, 'max-age=60,immutable');
  });

  test('calls setHeaders with the file', (ctx: TestContext): void => {
    var seen = '';
    let served = serveOne(new Request.fromUrl('http://localhost/hello.txt'), {
      setHeaders: (res, path, stat) => {
        seen = `${path} ${stat.size}`;
        res.setHeader('cache-control', 'no-store');
      },
    });
    equal(seen, 'packages/stdlib/tests/http/fixtures/static/hello.txt 6');
    equal(served.res.getHeader('cache-control') as String, 'no-store');
  });

  test('serves application/octet-stream for an unknown type', (ctx: TestContext): void => {
    equal(get('/data.xyz').res.getHeader('content-type') as String,
        'application/octet-stream');
  });

  test('send throws 404 for a missing file', (ctx: TestContext): void => {
    var status = 0;
    try {
      let req = new Request.fromUrl('http://localhost/');
      blockOn(send(req, new Response(), 'nope.txt', {root: fixtures()}));
    } catch (e) {
      if (e is HttpError) {
        status = (e as HttpError).status;
      }
    }
    equal(status, 404);
  });

  test('send serves a file under its root', (ctx: TestContext): void => {
    let req = new Request.fromUrl('http://localhost/');
    let res = new Response();
    let sent = blockOn(send(req, res, 'docs/index.html', {root: fixtures()}));
    equal(sent as String, 'packages/stdlib/tests/http/fixtures/static/docs/index.html');
    equal(bodyText(res), '<h1>docs</h1>\n');
  });

  test('send preserves an explicitly set status code on GET and HEAD', (ctx: TestContext): void => {
    let getReq = new Request.fromUrl('http://localhost/missing');
    let getRes = new Response();
    getRes.statusCode = 404;
    blockOn(send(getReq, getRes, 'about.html', {root: fixtures()}));
    equal(getRes.statusCode, 404);
    equal(bodyText(getRes), '<h1>about</h1>\n');

    let headReq = new Request.fromUrl('http://localhost/missing', 'HEAD');
    let headRes = new Response();
    headRes.statusCode = 404;
    blockOn(send(headReq, headRes, 'about.html', {root: fixtures()}));
    equal(headRes.statusCode, 404);
    isTrue(headRes.body == null);
  });

  test('a served file reaches the wire response', (ctx: TestContext): void => {
    // The file's stream goes into `response.new` as it is; reading the
    // wire response's body back brings the file's bytes.
    let res = get('/hello.txt').res;
    let wire = toWireResponse(res);
    equal(wire.getStatusCode() as i32, 200);
    let received = new Completer<Outcome<void, ErrorCode>>();
    let (body, trailers) = WireResponse.consumeBody(wire, received.future);
    equal(blockOn(readAllText(body)), 'world\n');
    received.complete(new Ok<void, ErrorCode>(unit()));
  });

  test('httpDate formats IMF-fixdate', (ctx: TestContext): void => {
    equal(httpDate(0 as i64), 'Thu, 01 Jan 1970 00:00:00 GMT');
    equal(httpDate(86399 as i64), 'Thu, 01 Jan 1970 23:59:59 GMT');
    equal(httpDate(951782400 as i64), 'Tue, 29 Feb 2000 00:00:00 GMT');
    equal(httpDate(1791990983 as i64), 'Wed, 14 Oct 2026 15:16:23 GMT');
    equal(httpDate(4102444799 as i64), 'Thu, 31 Dec 2099 23:59:59 GMT');
  });

  test('mimeType maps extensions', (ctx: TestContext): void => {
    equal(mimeType('a/b/index.HTML') as String, 'text/html; charset=utf-8');
    equal(mimeType('app.wasm') as String, 'application/wasm');
    isNull(mimeType('README'));
    isNull(mimeType('x.unknown'));
  });
});
