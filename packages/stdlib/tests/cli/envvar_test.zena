// Test type alias with object type
//
// @requires: wasmtime

import { growable } from 'zena:core';

type EnvVar = {
  name: String,
  value: String
};

let getEnvVars = (): Array<EnvVar> => {
  let result = growable<EnvVar>([
    { name: "HOME", value: "/home/user" },
    { name: "PATH", value: "/bin" },
  ]);
  return result;
};

export let main = (): i32 => {
  console.log("Testing EnvVar type...");
  
  let envs = getEnvVars();
  console.log("Got envs");
  
  if (envs.length > 0) {
    let first = envs[0];
    console.log(`First: ${first.name}=${first.value}`);
  }
  
  return 0;
};
