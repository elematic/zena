// Test just creating Array<String>
//
// @requires: wasmtime

import { growable } from 'zena:core';

export let main = (): i32 => {
  console.log("Creating GrowableArray<String>...");
  
  let arr = growable<String>(["hello", "world"]);
  
  console.log("Array has items");
  console.log("First: " + arr[0]);
  
  return 0;
};
