// Filesystem tests - WASI 0.2
//
// @requires: wasmtime
//
// Tests for zena:fs functionality using wasmtime with --dir flag.
// Run with: wasmtime run -W gc=y -W exceptions=y --dir /tmp::/tmp fs_test.wasm

import { suite, test, TestContext } from 'zena:test';
import {equal, isTrue, isFalse} from 'zena:assert';
import {
  readFile, writeFile, exists, isFile, isDirectory, unlink, getPreopens,
  glob, GlobOptions
} from 'zena:fs';

export let tests = suite('Filesystem', (): void => {
  // Test getPreopens returns at least one directory
  test('getPreopens returns preopened directories', (ctx: TestContext): void => {
    let preopens = getPreopens();
    isTrue(preopens.length > 0);
  });

  // Test writing and reading a file
  test('writeFile and readFile roundtrip', (ctx: TestContext): void => {
    let testPath = 'fs-test-roundtrip.txt';
    let content = 'Hello from Zena fs test!';
    
    // Write file
    writeFile(testPath, content);
    
    // Verify it exists
    isTrue(exists(testPath));
    isTrue(isFile(testPath));
    isFalse(isDirectory(testPath));
    
    // Read back
    let read = readFile(testPath);
    equal(read, content);
    
    // Cleanup
    unlink(testPath);
    isFalse(exists(testPath));
  });

  // Test exists returns false for non-existent file
  test('exists returns false for missing file', (ctx: TestContext): void => {
    isFalse(exists('non-existent-file-12345.txt'));
  });

  // Test multi-preopen file access capability
  test('readFile across different preopened directories', (ctx: TestContext): void => {
    let preopens = getPreopens();
    // The test runner generally maps repo-root to / and /tmp to /tmp
    // We'll write to a unique file in /tmp using explicit relative resolution
    if (preopens.length > 1) {
       let tmpTestPath = '/tmp/zena-multi-preopen-test.txt';
       writeFile(tmpTestPath, 'testing multi-preopen');
       isTrue(exists(tmpTestPath));
       equal(readFile(tmpTestPath), 'testing multi-preopen');
       unlink(tmpTestPath);
    }
  });

  // Test multi-line content
  test('writeFile preserves newlines', (ctx: TestContext): void => {
    let testPath = 'fs-test-newlines.txt';
    let content = 'line1\nline2\nline3';
    
    writeFile(testPath, content);
    let read = readFile(testPath);
    equal(read, content);
    
    unlink(testPath);
  });

  test('glob filesystem search', (ctx: TestContext): void => {
    let found = glob('packages/stdlib/tests/path/*_test.zena');
    isTrue(found.length > 0);
    equal(found[0], 'packages/stdlib/tests/path/path_test.zena');

    // Test with cwd option
    let cwdOpts = new GlobOptions();
    cwdOpts.cwd = 'packages/stdlib';
    let foundCwd = glob('tests/path/*_test.zena', cwdOpts);
    isTrue(foundCwd.length > 0);
    equal(foundCwd[0], 'tests/path/path_test.zena');

    // Test with exclude
    let opts = new GlobOptions();
    opts.cwd = 'packages/stdlib';
    let excludes = new GrowableArray<String>();
    excludes.push('**/path_test.zena');
    opts.exclude = excludes;
    let excluded = glob('tests/path/*_test.zena', opts);
    equal(excluded.length, 0);
  });
});


