// TaskGroup (docs/design/cancellation.md, the structured half):
// children spawn into the group's scope, the first failure cancels
// the siblings, cancelling the group wakes parked children, and join
// completes once every child has settled — with the first failure if
// there was one, and normally otherwise.
import {suite, test, TestContext} from 'zena:test';
import {equal, isTrue, isFalse} from 'zena:assert';
import {Completer, TaskGroup, drainMicrotasks} from 'zena:async';

let doubled = async (gate: Future<i32>): Future<i32> => {
  let v = await gate;
  return v * 2;
};

let failing = async (gate: Future<i32>): Future<i32> => {
  let v = await gate;
  throw new Error('child failed');
};

/** Records how awaiting `f` ends — value, error, or cancellation.
 * With `state` gone, an outcome is observed the way user code
 * observes it: by awaiting, with a `cancel` clause for the third
 * settlement (the probe's own frame then completes cancelled, which
 * is fine — the record is the observation). */
var outcomes = '';
let probe = async (f: Future<i32>): Future<void> => {
  try {
    let v = await f;
    outcomes = `${outcomes}v${i32ToString(v)}`;
  } cancel {
    outcomes = outcomes + 'C';
  } catch (e) {
    outcomes = outcomes + 'e';
  }
};

export let tests = suite('TaskGroup', () => {
  test('children complete and join settles', async (ctx) => {
    let g1 = new Completer<i32>();
    let g2 = new Completer<i32>();
    let group = new TaskGroup();
    let a = group.spawn(() => doubled(g1.future));
    let b = group.spawn(() => doubled(g2.future));
    let j = group.join();
    drainMicrotasks();
    isFalse(j.isCompleted);

    g1.complete(1);
    g2.complete(2);
    drainMicrotasks();
    isTrue(j.isCompleted);
    equal(await a, 2);
    equal(await b, 4);
  });

  test('a child failure cancels its siblings and surfaces at join', async (ctx) => {
    let g1 = new Completer<i32>();
    let g2 = new Completer<i32>();
    let group = new TaskGroup();
    let a = group.spawn(() => failing(g1.future));
    let b = group.spawn(() => doubled(g2.future));
    let j = group.join();

    // Only the failing child's gate completes; the sibling is parked
    // and must be WOKEN by the cancellation.
    g1.complete(1);
    drainMicrotasks();

    outcomes = '';
    probe(a);
    probe(b);
    drainMicrotasks();
    equal(outcomes, 'eC');
    isTrue(group.isCancelled);
    isTrue(j.isCompleted);
    var msg = '';
    try {
      await j;
    } catch (e) {
      msg = e.message;
    }
    equal(msg, 'child failed');
  });

  test('cancelling the group wakes parked children; join completes normally', async (ctx) => {
    let g1 = new Completer<i32>();
    let g2 = new Completer<i32>();
    let group = new TaskGroup();
    let a = group.spawn(() => doubled(g1.future));
    let b = group.spawn(() => doubled(g2.future));
    let j = group.join();
    drainMicrotasks();
    isFalse(j.isCompleted);

    // Neither gate ever completes: only the wake can deliver.
    group.cancel();
    drainMicrotasks();
    outcomes = '';
    probe(a);
    probe(b);
    drainMicrotasks();
    equal(outcomes, 'CC');
    isTrue(j.isCompleted);
    var raised = false;
    try {
      await j;
    } catch (e) {
      raised = true;
    }
    isFalse(raised);
  });

  test('join after everything settled is already settled', async (ctx) => {
    let g1 = new Completer<i32>();
    let group = new TaskGroup();
    let a = group.spawn(() => doubled(g1.future));
    g1.complete(5);
    drainMicrotasks();
    equal(await a, 10);
    isTrue(group.join().isCompleted);
  });

  test('an empty group joins immediately', (ctx) => {
    let group = new TaskGroup();
    isTrue(group.join().isCompleted);
  });

  test('race takes the first settled value and cancels the losers', async (ctx) => {
    let g1 = new Completer<i32>();
    let g2 = new Completer<i32>();
    let r = TaskGroup.race([
      () => doubled(g1.future),
      () => doubled(g2.future),
    ]);
    drainMicrotasks();
    isFalse(r.isCompleted);

    // The second candidate settles first and wins; the first is
    // parked forever, so only the loser-cancelling reaches it.
    g2.complete(21);
    drainMicrotasks();
    equal(await r, 42);
  });

  test('a failing winner surfaces through the race future', async (ctx) => {
    let g1 = new Completer<i32>();
    let g2 = new Completer<i32>();
    let r = TaskGroup.race([
      () => failing(g1.future),
      () => doubled(g2.future),
    ]);
    g1.complete(1);
    drainMicrotasks();
    var msg = '';
    try {
      await r;
      msg = 'settled normally';
    } catch (e) {
      msg = e.message;
    }
    equal(msg, 'child failed');
  });

  test('cancellation from outside completes the race cancelled', (ctx) => {
    let g1 = new Completer<i32>();
    let outer = new TaskGroup();
    var race: Future<i32> | null = null;
    outer.spawn(() => {
      race = TaskGroup.race([() => doubled(g1.future)]);
      return Future.of(0);
    });
    outer.cancel();
    drainMicrotasks();
    outcomes = '';
    probe(race as Future<i32>);
    drainMicrotasks();
    equal(outcomes, 'C');
  });

  test('a race of nothing is refused', (ctx) => {
    var msg = '';
    try {
      TaskGroup.race<i32>([]);
      msg = 'not refused';
    } catch (e) {
      msg = e.message;
    }
    equal(msg, 'TaskGroup.race needs at least one candidate');
  });
});
