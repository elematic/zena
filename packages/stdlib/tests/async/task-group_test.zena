// TaskGroup (docs/design/cancellation.md, the structured half):
// children spawn into the group's scope, the first failure cancels
// the siblings, cancelling the group wakes parked children, and join
// completes once every child has settled — with the first failure if
// there was one, and normally otherwise.
import {suite, test, TestContext} from 'zena:test';
import {equal, isTrue, isFalse} from 'zena:assert';
import {
  Future, FutureState, Completer, TaskGroup, CancelScope, drainMicrotasks,
  runFuture,
} from 'zena:async';
import { Error } from 'zena:error';

let doubled = async (gate: Future<i32>): Future<i32> => {
  let v = await gate;
  return v * 2;
};

let failing = async (gate: Future<i32>): Future<i32> => {
  let v = await gate;
  throw new Error('child failed');
};

export let tests = suite('TaskGroup', (): void => {
  test('children complete and join settles', (ctx: TestContext): void => {
    let g1 = new Completer<i32>();
    let g2 = new Completer<i32>();
    let group = new TaskGroup();
    let a = group.spawn(() => doubled(g1.future));
    let b = group.spawn(() => doubled(g2.future));
    let j = group.join();
    drainMicrotasks();
    isFalse(j.isCompleted);

    g1.complete(1);
    g2.complete(2);
    drainMicrotasks();
    isTrue(j.isCompleted);
    equal(runFuture(a), 2);
    equal(runFuture(b), 4);
  });

  test('a child failure cancels its siblings and surfaces at join', (ctx: TestContext): void => {
    let g1 = new Completer<i32>();
    let g2 = new Completer<i32>();
    let group = new TaskGroup();
    let a = group.spawn(() => failing(g1.future));
    let b = group.spawn(() => doubled(g2.future));
    let j = group.join();

    // Only the failing child's gate completes; the sibling is parked
    // and must be WOKEN by the cancellation.
    g1.complete(1);
    drainMicrotasks();

    isTrue(a.state == FutureState.Rejected);
    isTrue(b.state == FutureState.Cancelled);
    isTrue(group.isCancelled);
    isTrue(j.isCompleted);
    var msg = '';
    try {
      runFuture(j);
    } catch (e) {
      msg = e.message;
    }
    equal(msg, 'child failed');
  });

  test('cancelling the group wakes parked children; join completes normally', (ctx: TestContext): void => {
    let g1 = new Completer<i32>();
    let g2 = new Completer<i32>();
    let group = new TaskGroup();
    let a = group.spawn(() => doubled(g1.future));
    let b = group.spawn(() => doubled(g2.future));
    let j = group.join();
    drainMicrotasks();
    isFalse(j.isCompleted);

    // Neither gate ever completes: only the wake can deliver.
    group.cancel();
    drainMicrotasks();
    isTrue(a.state == FutureState.Cancelled);
    isTrue(b.state == FutureState.Cancelled);
    isTrue(j.isCompleted);
    var raised = false;
    try {
      runFuture(j);
    } catch (e) {
      raised = true;
    }
    isFalse(raised);
  });

  test('join after everything settled is already settled', (ctx: TestContext): void => {
    let g1 = new Completer<i32>();
    let group = new TaskGroup();
    let a = group.spawn(() => doubled(g1.future));
    g1.complete(5);
    drainMicrotasks();
    equal(runFuture(a), 10);
    isTrue(group.join().isCompleted);
  });

  test('an empty group joins immediately', (ctx: TestContext): void => {
    let group = new TaskGroup();
    isTrue(group.join().isCompleted);
  });

  test('race takes the first settled value and cancels the losers', (ctx: TestContext): void => {
    let g1 = new Completer<i32>();
    let g2 = new Completer<i32>();
    let r = TaskGroup.race([
      () => doubled(g1.future),
      () => doubled(g2.future),
    ]);
    drainMicrotasks();
    isFalse(r.isCompleted);

    // The second candidate settles first and wins; the first is
    // parked forever, so only the loser-cancelling reaches it.
    g2.complete(21);
    drainMicrotasks();
    equal(runFuture(r), 42);
  });

  test('a failing winner surfaces through the race future', (ctx: TestContext): void => {
    let g1 = new Completer<i32>();
    let g2 = new Completer<i32>();
    let r = TaskGroup.race([
      () => failing(g1.future),
      () => doubled(g2.future),
    ]);
    g1.complete(1);
    drainMicrotasks();
    var msg = '';
    try {
      runFuture(r);
      msg = 'settled normally';
    } catch (e) {
      msg = e.message;
    }
    equal(msg, 'child failed');
  });

  test('cancellation from outside completes the race cancelled', (ctx: TestContext): void => {
    let g1 = new Completer<i32>();
    let outer = new CancelScope();
    var race: Future<i32> | null = null;
    outer.run(() => {
      race = TaskGroup.race([() => doubled(g1.future)]);
    });
    outer.cancel();
    drainMicrotasks();
    isTrue((race as Future<i32>).state == FutureState.Cancelled);
  });

  test('a race of nothing is refused', (ctx: TestContext): void => {
    var msg = '';
    try {
      TaskGroup.race<i32>([]);
      msg = 'not refused';
    } catch (e) {
      msg = e.message;
    }
    equal(msg, 'TaskGroup.race needs at least one candidate');
  });
});
