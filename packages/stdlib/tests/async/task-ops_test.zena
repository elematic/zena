// zena:task — Op<T> combinators: timeout and hedge cancel their
// losers through TaskGroup.race, retry and fallback act on failures
// and hand cancellation through untouched.
import {suite, test} from 'zena:test';
import {equal, isTrue, isFalse} from 'zena:assert';
import {Completer, TaskGroup, drainMicrotasks} from 'zena:async';
import {
  Op, TimeoutError, timeout, deadline, retry, fallback, hedge,
} from 'zena:task';
import { monotonic, milliseconds } from 'zena:time';

var log = '';
var altRan = false;
var inner: Future<i32> = Future.of(0);

/** An op that never settles on its own, recording if it is cancelled. */
let pass = async (gate: Future<i32>): Future<i32> => await gate;

/** Awaits `f`, recording how the await ends — value, failure, or
 * cancellation. */
let probe = async (f: Future<i32>): Future<void> => {
  try {
    let v = await f;
    log = log + 'v';
  } cancel {
    log = log + 'C';
  } catch (e) {
    log = log + 'e';
  }
};

let stuck = async (): Future<i32> => {
  let never = new Completer<i32>();
  try {
    return await never.future;
  } cancel {
    log = log + 'C';
  }
};

export let tests = suite('task ops', () => {
  test('timeout hands back an attempt that beats its budget', async () => {
    let op = timeout(milliseconds(1000), () => Future.of(5));
    equal(await op(), 5);
  });

  test('timeout expires and cancels the attempt', async () => {
    log = '';
    let op = timeout(milliseconds(1), stuck);
    var msg = '';
    try {
      let unused = await op();
      msg = 'no throw';
    } catch (e) {
      msg = e.message;
    }
    equal(msg, 'timed out after 1ms');
    equal(log, 'C');
  });

  test('retry returns the first value and stops', async () => {
    var calls = 0;
    let flaky = () => {
      calls += 1;
      if (calls < 3) {
        return Future.failed<i32>(new Error('flake'));
      }
      return Future.of(calls);
    };
    let op = retry(5, flaky);
    equal(await op(), 3);
    equal(calls, 3);
  });

  test('retry exhausts and rethrows the last failure', async () => {
    var calls = 0;
    let doomed = () => {
      calls += 1;
      return Future.failed<i32>(new Error('f' + (if (calls == 1) '1' else '2')));
    };
    var msg = '';
    try {
      let op = retry(2, doomed);
      let unused = await op();
    } catch (e) {
      msg = e.message;
    }
    equal(msg, 'f2');
    equal(calls, 2);
  });

  test('fallback answers with alt on failure only', async () => {
    var altCalls = 0;
    let alt = () => {
      altCalls += 1;
      return Future.of(-1);
    };
    let bad = () => Future.failed<i32>(new Error('x'));
    let rescued = fallback(bad, alt);
    equal(await rescued(), -1);
    equal(altCalls, 1);
    let fine = fallback(() => Future.of(2), alt);
    equal(await fine(), 2);
    equal(altCalls, 1);
  });

  test('hedge lets the second attempt win and cancels the first', async () => {
    log = '';
    var calls = 0;
    let slowThenFast = () => {
      calls += 1;
      if (calls == 1) {
        return stuck();
      }
      return Future.of(7);
    };
    let op = hedge(milliseconds(1), slowThenFast);
    equal(await op(), 7);
    equal(calls, 2);
    equal(log, 'C');
  });

  test('fallback passes cancellation through without running alt', () => {
    log = '';
    altRan = false;
    let gate = new Completer<i32>();
    let group = new TaskGroup();
    inner = group.spawn(() => pass(gate.future));
    let op = fallback(() => inner, () => {
      altRan = true;
      return Future.of(-1);
    });
    probe(op());
    group.cancel();
    drainMicrotasks();
    equal(log, 'C');
    isFalse(altRan);
  });

  test('a lapsed deadline fails without running the op', async () => {
    var calls = 0;
    let counted = () => {
      calls += 1;
      return Future.of(1);
    };
    let past = monotonic() + milliseconds(0 - 1);
    let op = deadline(past, counted);
    var timedOut = false;
    try {
      let unused = await op();
    } catch (e) {
      timedOut = e is TimeoutError;
    }
    isTrue(timedOut);
    equal(calls, 0);
  });

  test('retry over timeout gives each attempt a fresh budget', async () => {
    log = '';
    var calls = 0;
    let stuckOnceThenValue = () => {
      calls += 1;
      if (calls == 1) {
        return stuck();
      }
      return Future.of(9);
    };
    let op = retry(2, timeout(milliseconds(1), stuckOnceThenValue));
    equal(await op(), 9);
    equal(calls, 2);
    equal(log, 'C');
  });
});
