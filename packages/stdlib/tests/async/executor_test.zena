// Executor: FIFO microtask draining and DeferredFuture laziness.
import {suite, test, TestContext} from 'zena:test';
import {equal, rejects} from 'zena:assert';
import {
  Completer, DeferredFuture, Future, drainMicrotasks, scheduleMicrotask,
} from 'zena:async';

export let tests = suite('executor', () => {
  test('drainMicrotasks runs scheduled callbacks in FIFO order including nested schedules', (ctx) => {
    var order = '';
    scheduleMicrotask(() => {
      order = `${order}a`;
      scheduleMicrotask(() => {
        order = `${order}c`;
      });
    });
    scheduleMicrotask(() => {
      order = `${order}b`;
    });
    equal(order, '');
    drainMicrotasks();
    equal(order, 'abc');
  });

  test('drainMicrotasks settles a scheduled Completer', async (ctx) => {
    let c = new Completer<i32>();
    scheduleMicrotask(() => {
      c.complete(42);
    });
    equal(await c.future, 42);
  });

  test('drainMicrotasks rejects a failed Completer', async (ctx) => {
    let c = new Completer<i32>();
    scheduleMicrotask(() => {
      c.fail(new Error('rejected'));
    });
    await rejects(async () => {
      await c.future;
    });
  });

  test('DeferredFuture does not run its producer until awaited', async (ctx) => {
    var produced = false;
    let deferred: Future<i32> = new DeferredFuture<i32>(() => {
      produced = true;
      return Future.of(7);
    });
    drainMicrotasks();
    equal(produced, false);
    equal(await deferred, 7);
    equal(produced, true);
  });
});
