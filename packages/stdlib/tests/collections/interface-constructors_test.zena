// The collection interfaces' constructors: each builds the default
// implementation, so code can say `new Map()` without naming HashMap.
import {suite, test, TestContext} from 'zena:test';
import {equal, isTrue, isFalse} from 'zena:assert';
import { Set, OrderedHashMap, HashSet, OrderedHashSet } from 'zena:collections';
import {StringBuilder} from 'zena:core';

let joinKeys = (m: Map<String, i32>): String => {
  let sb = new StringBuilder();
  m.forEach((key: String, value: i32): void => {
    sb.append(key);
  });
  return sb.toString();
};

let joinValues = (s: Set<String>): String => {
  let sb = new StringBuilder();
  for (let v in s) {
    sb.append(v);
  }
  return sb.toString();
};

export let tests = suite('interface constructors', (): void => {
  test('new Map() is a HashMap', (ctx: TestContext): void => {
    let m = new Map<String, i32>();
    isTrue(m is HashMap<String, i32>);
    m["a"] = 1;
    equal(m["a"], 1);
    equal(m.size, 1);
  });

  test('new Map.ordered() keeps insertion order', (ctx: TestContext): void => {
    let m = new Map<String, i32>.ordered();
    isTrue(m is OrderedHashMap<String, i32>);
    m["c"] = 3;
    m["a"] = 1;
    m["b"] = 2;
    equal(joinKeys(m), "cab");
  });

  test('new Map() takes its type arguments from the context', (ctx: TestContext): void => {
    let m: Map<String, i32> = new Map();
    m["x"] = 42;
    equal(m.getOr("x", 0), 42);
    let capacity: Map<i32, i32> = new Map(4);
    capacity[1] = 2;
    equal(capacity[1], 2);
  });

  test('new Set() is a HashSet', (ctx: TestContext): void => {
    let s = new Set<i32>();
    isTrue(s is HashSet<i32>);
    isTrue(s.add(1));
    isFalse(s.add(1));
    isTrue(s.has(1));
  });

  test('new Set.ordered() keeps insertion order', (ctx: TestContext): void => {
    let s: Set<String> = new Set.ordered();
    isTrue(s is OrderedHashSet<String>);
    s.add("b");
    s.add("a");
    s.add("c");
    equal(joinValues(s), "bac");
  });

  test('new Array() is a GrowableArray', (ctx: TestContext): void => {
    let a = new Array<i32>();
    a.push(1);
    a.push(2);
    equal(a.length, 2);
    equal(a[1], 2);
    let b: Array<String> = new Array();
    equal(b.length, 0);
  });

  test('new Array.growable() takes a capacity', (ctx: TestContext): void => {
    let a = new Array<i32>.growable(2);
    a.push(1);
    a.push(2);
    a.push(3);
    equal(a.length, 3);
    equal(a[2], 3);
  });

  test('new Array.fixed() is a FixedArray of one value', (ctx: TestContext): void => {
    let a = new Array<i32>.fixed(3, 7);
    equal(a.length, 3);
    equal(a[0] + a[1] + a[2], 21);
    a[1] = 1;
    equal(a[1], 1);
    let b = new Array.fixed(2, "x");
    equal(b.length, 2);
    equal(b[1], "x");
  });
});
