// The `dedentRaw` template tag.
//
// Unlike `dedent_test.zena`, the templates here do contain escape sequences:
// preserving them is what separates `dedentRaw` from `dedent`, so every
// escape below is the thing under test rather than an oversight. The expected
// values are ordinary quoted strings, where `\\n` is the backslash and the `n`
// that `dedentRaw` hands back and `\n` is a real line break.
//
// A real CRLF line ending is not covered. One cannot be written inside a
// tagged literal — a `\r` escape stays two raw characters — so reaching
// `contentEndKeepingBreak`'s CRLF branch would take a source file saved with
// CRLF endings, which this repository does not have. `dedent` is untested on
// CRLF for the same reason.
import {suite, test, TestContext} from 'zena:test';
import {equal} from 'zena:assert';
import {dedentRaw} from 'zena:core';

export let tests = suite('dedentRaw', (): void => {
  suite('escapes', (): void => {
    test('keeps an escape as the characters that were written', (ctx: TestContext): void => {
      equal(dedentRaw`
        let s = 'hello\nworld';
      `, "let s = 'hello\\nworld';\n");
    });

    test('keeps a backslash that escapes a backslash', (ctx: TestContext): void => {
      equal(dedentRaw`
        let s = 'a\\b';
      `, "let s = 'a\\\\b';\n");
    });

    test('keeps an escape on every line, and still dedents', (ctx: TestContext): void => {
      // The `\n` runs do not break lines here, so both lines share eight
      // spaces of indentation and both lose them.
      equal(dedentRaw`
        let a = 'x\ny';
        let b = 'p\nq';
      `, "let a = 'x\\ny';\nlet b = 'p\\nq';\n");
    });
  });

  suite('the trailing line break', (): void => {
    test('keeps the break when the closing backtick is on its own line', (ctx: TestContext): void => {
      equal(dedentRaw`
        alpha
        beta
      `, 'alpha\nbeta\n');
    });

    test('adds no break when the closing backtick follows content', (ctx: TestContext): void => {
      equal(dedentRaw`
        alpha
        beta`, 'alpha\nbeta');
    });

    test('keeps one break, not the blank line before it', (ctx: TestContext): void => {
      // The closing line is still dropped; only the break that ended the last
      // content line survives. A blank line before the close is content, so it
      // stays as an empty line.
      equal(dedentRaw`
        alpha

      `, 'alpha\n\n');
    });
  });

  suite('the rules it shares with dedent', (): void => {
    test('strips the longest common indentation', (ctx: TestContext): void => {
      equal(dedentRaw`
        alpha
          beta
        gamma
      `, 'alpha\n  beta\ngamma\n');
    });

    test('splices an interpolation in verbatim', (ctx: TestContext): void => {
      let op = '+=';
      equal(dedentRaw`
        let f = () => {
          x ${op} 2;
        };
      `, 'let f = () => {\n  x += 2;\n};\n');
    });

    test('leaves a single line with no indentation alone', (ctx: TestContext): void => {
      equal(dedentRaw`hello`, 'hello');
      equal(dedentRaw``, '');
    });

    test('produces nothing from an entirely blank template', (ctx: TestContext): void => {
      equal(dedentRaw`
      `, '');
    });

    test('empties a blank line rather than leaving the indent on it', (ctx: TestContext): void => {
      equal(dedentRaw`
        alpha

        beta
      `, 'alpha\n\nbeta\n');
    });
  });
});
