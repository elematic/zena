// zena:time — the Instant/Duration affine core: instant minus instant
// is a duration, instant plus or minus duration is an instant, durations
// add, subtract, negate, scale and compare.
import {suite, test} from 'zena:test';
import {equal, isTrue, isFalse} from 'zena:assert';
import {monotonic, milliseconds, formatTimestamp, Instant} from 'zena:time';

export let tests = suite('time types', () => {
  test('milliseconds builds a nanosecond count', () => {
    equal(milliseconds(5) as i64, 5000000 as i64);
    equal(milliseconds(0) as i64, 0 as i64);
  });

  test('instant minus instant is the signed span between them', () => {
    let a = 1000 as i64 as Instant;
    let b = 4000 as i64 as Instant;
    equal((b - a) as i64, 3000 as i64);
    isTrue((a - b).isNegative());
    isTrue((a - b) < milliseconds(0));
  });

  test('instant plus and minus duration round-trip', () => {
    let a = monotonic();
    let d = milliseconds(25);
    let b = a + d;
    isTrue(a < b);
    isTrue(b > a);
    isTrue(a <= a);
    isTrue(b >= a);
    isFalse(b < a);
    equal((b - a) as i64, d as i64);
    equal(b - d, a);
    equal(b + (-d), a);
  });

  test('durations add, subtract, negate, scale and compare', () => {
    let d = milliseconds(3) + milliseconds(4);
    equal(d as i64, milliseconds(7) as i64);
    equal((d - milliseconds(2)) as i64, milliseconds(5) as i64);
    equal((-d) as i64, milliseconds(-7) as i64);
    equal((d * 3) as i64, milliseconds(21) as i64);
    isTrue(d > milliseconds(4));
    isTrue(-d < milliseconds(0));
    isTrue(d.isPositive());
    isFalse(d.isNegative());
    isFalse(milliseconds(0).isPositive());
    isFalse(milliseconds(0).isNegative());
  });

  test('formatTimestamp writes UTC with milliseconds', (ctx) => {
    let at = (millis: i64) => formatTimestamp(millis * (1000000 as i64));
    equal(at(0 as i64), '1970-01-01T00:00:00.000Z');
    equal(at(951782400000 as i64), '2000-02-29T00:00:00.000Z');
    equal(at(1792800000123 as i64), '2026-10-24T00:00:00.123Z');
    equal(at(1735689599999 as i64), '2024-12-31T23:59:59.999Z');
    equal(at(4102444800000 as i64), '2100-01-01T00:00:00.000Z');
    // Below a millisecond is dropped.
    equal(formatTimestamp(1999999 as i64), '1970-01-01T00:00:00.001Z');
  });
});
