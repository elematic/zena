import {suite, test, TestContext} from 'zena:test';
import {equal, isTrue, isFalse, throws} from 'zena:assert';
import {State, Computed} from 'zena:signals';

export let tests = suite('Signals: State and Computed', (): void => {
  test('a state holds a value', (ctx: TestContext): void => {
    let s = new State(1);
    equal(s.get(), 1);
    s.set(2);
    equal(s.get(), 2);
  });

  test('a computed is lazy and cached', (ctx: TestContext): void => {
    let s = new State(1);
    var runs = 0;
    let c = new Computed<i32>((): i32 => {
      runs += 1;
      return s.get() * 10;
    });
    equal(runs, 0);
    equal(c.get(), 10);
    equal(c.get(), 10);
    equal(runs, 1);
    s.set(2);
    equal(runs, 1);
    equal(c.get(), 20);
    equal(runs, 2);
  });

  test('setting an equal value does not rerun', (ctx: TestContext): void => {
    let s = new State(1);
    var runs = 0;
    let c = new Computed<i32>((): i32 => {
      runs += 1;
      return s.get();
    });
    c.get();
    s.set(1);
    c.get();
    equal(runs, 1);
  });

  test('an unchanged computed stops the update', (ctx: TestContext): void => {
    let s = new State(1);
    let parity = new Computed<i32>((): i32 => s.get() % 2);
    var runs = 0;
    let label = new Computed<String>((): String => {
      runs += 1;
      return if (parity.get() == 0) 'even' else 'odd';
    });
    equal(label.get(), 'odd');
    s.set(3);
    equal(label.get(), 'odd');
    equal(runs, 1);
    s.set(4);
    equal(label.get(), 'even');
    equal(runs, 2);
  });

  test('a diamond runs each computed once', (ctx: TestContext): void => {
    let a = new State(1);
    var bRuns = 0;
    var cRuns = 0;
    var dRuns = 0;
    let b = new Computed<i32>((): i32 => {
      bRuns += 1;
      return a.get() + 1;
    });
    let c = new Computed<i32>((): i32 => {
      cRuns += 1;
      return a.get() * 2;
    });
    let d = new Computed<i32>((): i32 => {
      dRuns += 1;
      return b.get() + c.get();
    });
    equal(d.get(), 4);
    a.set(5);
    equal(d.get(), 16);
    equal(bRuns, 2);
    equal(cRuns, 2);
    equal(dRuns, 2);
  });

  test('dependencies follow the branch taken', (ctx: TestContext): void => {
    let useA = new State<boolean>(true);
    let a = new State(1);
    let b = new State(2);
    var runs = 0;
    let c = new Computed<i32>((): i32 => {
      runs += 1;
      return if (useA.get()) a.get() else b.get();
    });
    equal(c.get(), 1);
    b.set(20);
    equal(c.get(), 1);
    equal(runs, 1);
    useA.set(false);
    equal(c.get(), 20);
    equal(runs, 2);
    a.set(10);
    equal(c.get(), 20);
    equal(runs, 2);
  });

  test('custom equals', (ctx: TestContext): void => {
    // Equal when the last digits match.
    let s = new State<i32>(1, {equals: (a: i32, b: i32): boolean => a % 10 == b % 10});
    var runs = 0;
    let c = new Computed<i32>((): i32 => {
      runs += 1;
      return s.get();
    });
    c.get();
    s.set(11);
    equal(s.get(), 1);
    equal(c.get(), 1);
    s.set(15);
    equal(c.get(), 15);
    equal(runs, 2);
  });

  test('an error is cached and rethrown', (ctx: TestContext): void => {
    let s = new State(0);
    var runs = 0;
    let c = new Computed<i32>((): i32 => {
      runs += 1;
      if (s.get() == 0) {
        throw new Error('zero');
      }
      return 100 / s.get() as i32;
    });
    throws((): void => {
      c.get();
    });
    throws((): void => {
      c.get();
    });
    equal(runs, 1);
    s.set(4);
    equal(c.get(), 25);
  });

  test('reading itself is a cycle', (ctx: TestContext): void => {
    let holder = new State<Computed<i32> | null>(null);
    let c = new Computed<i32>((): i32 => {
      let me = holder.get();
      if (me == null) {
        return 0;
      }
      return (me as Computed<i32>).get() + 1;
    });
    equal(c.get(), 0);
    holder.set(c);
    throws((): void => {
      c.get();
    });
  });
});
