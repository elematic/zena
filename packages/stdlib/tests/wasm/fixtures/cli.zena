// Exercises what a run passes through WASI, compiled to a component by
// the stdlib package's `build:fixtures` script:
// - main writes "hello\n" to stdout and returns its argument count;
// - `preopen` returns how many directories were handed over;
// - `env` returns how many environment variables it sees;
// - `exits` ends the component with exit(3);
// - `spawns` runs a host process and returns its exit code, which needs
//   the grant.
import { exit, getArguments, getEnvironment } from 'zena:cli';
import { getPreopens } from 'zena:fs';
import { run } from 'zena:process';

export function main(): i32 {
  console.log('hello');
  return getArguments().length;
}

export function preopen(): i32 {
  return getPreopens().length;
}

export function env(): i32 {
  return getEnvironment().length;
}

export function exits(): i32 {
  exit(3);
  return 0;
}

export function spawns(): i32 {
  return run(['/bin/sh', '-c', 'exit 5']).exitCode;
}
