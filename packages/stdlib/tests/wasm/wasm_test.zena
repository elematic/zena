// zena:wasm: running other modules and reading how they ended. The
// modules are hand-written .wat fixtures, so nothing here depends on
// the compiler. Repo tests run with the spawn grant, which covers
// zena:wasm too.
import { suite, test } from 'zena:test';
import { equal, isFalse, isTrue } from 'zena:assert';
import { exists } from 'zena:fs';
import { milliseconds } from 'zena:time';
import { RunOutcome, precompileModule, runModule, startModule } from 'zena:wasm';

let fixtures = 'packages/stdlib/tests/wasm/fixtures';

let fixture = (name: String): String => `${fixtures}/${name}`;

export let tests = suite('wasm', (): void => {
  test('a returned status is the exit code', () => {
    let result = runModule(fixture('returns.wat'));
    equal(result.outcome, RunOutcome.Returned);
    equal(result.exitCode, 7);
    equal(result.resultText, '7');
    isFalse(result.succeeded());

    let other = runModule(fixture('returns.wat'), {invoke: 'other'});
    equal(other.exitCode, 11);
  });

  test('a result of any type is reported as text', () => {
    let float = runModule(fixture('returns.wat'), {invoke: 'float'});
    equal(float.resultText, '2.5');
    equal(float.exitCode, 0);

    let nothing = runModule(fixture('returns.wat'), {invoke: 'nothing'});
    equal(nothing.outcome, RunOutcome.Returned);
    equal(nothing.resultText, '');
    isTrue(nothing.succeeded());
  });

  test('exit ends the run with its code', () => {
    let result = runModule(fixture('wasi.wat'), {invoke: 'exits'});
    equal(result.outcome, RunOutcome.Exited);
    equal(result.exitCode, 3);
    equal(result.resultText, '');
  });

  test('a module can be compiled ahead of its first run', () => {
    equal(precompileModule(fixture('traps.wat')), '');
    isTrue(exists(fixture('traps.wat.cwasm')));
    isTrue(precompileModule('/etc/passwd').contains('outside'));
    isTrue(precompileModule(fixture('no-such-module.wat')).contains('no such module'));
    equal(precompileModule(fixture('traps.wat'), true), '');
  });

  test('a run can ask for the debug engine', () => {
    let returned = runModule(fixture('returns.wat'), {debug: true});
    equal(returned.exitCode, 7);
    let trapped = runModule(fixture('traps.wat'), {debug: true});
    equal(trapped.outcome, RunOutcome.Trapped);
  });

  test('a trap is reported, not propagated', () => {
    let result = runModule(fixture('traps.wat'));
    equal(result.outcome, RunOutcome.Trapped);
    equal(result.exitCode, -1);
    isTrue(result.message.contains('unreachable'));
  });

  test('output is captured and arguments are passed', () => {
    let result = runModule(fixture('wasi.wat'), {args: ['prog', 'a', 'b']});
    equal(result.outcome, RunOutcome.Returned);
    equal(result.stdout, 'hello\n');
    // main returns its argument count.
    equal(result.exitCode, 3);
  });

  test('environment variables are set', () => {
    // `env` returns how many variables the module sees.
    let none = runModule(fixture('wasi.wat'), {invoke: 'env'});
    equal(none.exitCode, 0);
    let two = runModule(fixture('wasi.wat'), {
      invoke: 'env',
      env: {'ZENA_A' => '1', 'ZENA_B' => '2'},
    });
    equal(two.exitCode, 2);
  });

  test('a directory is preopened only when handed over', () => {
    let without = runModule(fixture('wasi.wat'), {invoke: 'preopen'});
    // EBADF: fd 3 is not a preopened directory.
    equal(without.exitCode, 8);

    let shared = runModule(fixture('wasi.wat'), {
      invoke: 'preopen',
      dirs: [{from: '.', to: '.'}],
    });
    equal(shared.exitCode, 0);
  });

  test('a path outside this program\'s reach does not start', () => {
    let outside = runModule(fixture('returns.wat'), {dirs: [{from: '/etc', to: '/etc'}]});
    equal(outside.outcome, RunOutcome.Failed);
    isTrue(outside.message.contains('/etc'));

    let climbing = runModule(fixture('../fixtures/returns.wat'));
    equal(climbing.outcome, RunOutcome.Failed);

    let missing = runModule(fixture('no-such-module.wat'));
    equal(missing.outcome, RunOutcome.Failed);
  });

  test('a run past its time limit is stopped', () => {
    let result = runModule(fixture('loops.wat'), {timeout: milliseconds(100 as i64)});
    equal(result.outcome, RunOutcome.TimedOut);
    // It cannot have stopped before its limit.
    isTrue((result.callTime as i64) >= (90000000 as i64));
  });

  test('several runs can be in flight at once', () => {
    let first = startModule(fixture('loops.wat'), {timeout: milliseconds(100 as i64)});
    let second = startModule(fixture('returns.wat'));
    let third = startModule(fixture('traps.wat'));
    equal(third.wait().outcome, RunOutcome.Trapped);
    equal(second.wait().exitCode, 7);
    equal(first.wait().outcome, RunOutcome.TimedOut);
    // Waiting again returns the same result.
    equal(second.wait().exitCode, 7);
  });
});
