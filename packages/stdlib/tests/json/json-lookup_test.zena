// Typed lookups into parsed JSON, and writing parsed values back out.
import {suite, test} from 'zena:test';
import {equal, isTrue, isFalse} from 'zena:assert';
import {
  JsonBuilder, JsonValue, parseJson, jsonArray, jsonBool, jsonInt, jsonNumber, jsonObject,
  jsonString,
} from 'zena:json';

let sample = (): JsonValue => parseJson(
  '{"id": 7, "ok": true, "ratio": 2.5, "params": {"uri": "file:///a", "list": [1, "two"]}}');

export let tests = suite('JSON lookups', (): void => {
  test('a lookup of the right type finds the value', () => {
    let message = sample();
    equal(jsonString(message, '.params.uri') ?? 'none', 'file:///a');
    equal(jsonInt(message, '.id') ?? -1, 7);
    equal(jsonNumber(message, '.ratio') ?? 0.0, 2.5);
    isTrue(jsonBool(message, '.ok') ?? false);
    equal(jsonString(message, '.params.list[1]') ?? 'none', 'two');
  });

  test('a missing value or one of another type is not found', () => {
    let message = sample();
    equal(jsonString(message, '.params.missing') ?? 'none', 'none');
    equal(jsonString(message, '.id') ?? 'none', 'none');
    equal(jsonInt(message, '.params.uri') ?? -1, -1);
    // 2.5 is a number, and not an integer.
    equal(jsonInt(message, '.ratio') ?? -1, -1);
    isFalse(jsonBool(message, '.id') ?? false);
  });

  test('objects and arrays are found as themselves', () => {
    let message = sample();
    if (let (true, params) = jsonObject(message, '.params')) {
      isTrue(params.has('uri'));
    } else {
      isTrue(false, 'no params object');
    }
    if (let (true, list) = jsonArray(message, '.params.list')) {
      equal(list.length, 2);
    } else {
      isTrue(false, 'no list array');
    }
    isFalse(if (let (true, _) = jsonObject(message, '.params.list')) true else false);
  });

  test('a parsed value is written back as it came', () => {
    let message = sample();
    let b = new JsonBuilder();
    b.beginObject().key('id').value(parseJson('7'))
      .key('ratio').value(parseJson('2.5'))
      .key('name').value(parseJson('"x\\ny"'))
      .key('nothing').value(parseJson('null'))
      .key('params').value(jsonObject(message, '.params') ?? null)
      .endObject();
    equal(b.toString(),
      '{"id":7,"ratio":2.5,"name":"x\\ny","nothing":null,"params":{"uri":"file:///a","list":[1,"two"]}}');
  });
});
