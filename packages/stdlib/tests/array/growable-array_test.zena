// GrowableArray stdlib tests using zena:test
import {suite, test, TestContext} from 'zena:test';
import {equal, throws} from 'zena:assert';
import {GrowableArray} from 'zena:growable-array';

export let tests = suite('GrowableArray', (): void => {
  test('constructor creates array with zero length', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    equal(arr.length, 0);
  });

  test('push adds elements and updates length', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    arr.push(10);
    arr.push(20);
    equal(arr.length, 2);
    equal(arr[0], 10);
    equal(arr[1], 20);
  });

  test('push grows from an explicit zero capacity', (ctx: TestContext): void => {
    // Doubling a zero-sized buffer used to produce another zero-sized
    // buffer and trap on the write.
    let arr = new GrowableArray<i32>(0);
    arr.push(10);
    arr.push(20);
    equal(arr.length, 2);
    equal(arr[0], 10);
    equal(arr[1], 20);
  });

  test('pop removes and returns last element', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    arr.push(10);
    arr.push(20);
    
    let v1 = arr.pop();
    equal(v1, 20);
    equal(arr.length, 1);
    
    let v2 = arr.pop();
    equal(v2, 10);
    equal(arr.length, 0);
  });

  test('set updates element at index', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    arr.push(10);
    arr[0] = 99;
    equal(arr[0], 99);
  });

  test('grow increases capacity when needed', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    arr.push(1);
    arr.push(2);
    arr.push(3);
    arr.push(4);
    arr.push(5);
    
    equal(arr.length, 5);
    equal(arr[0], 1);
    equal(arr[4], 5);
  });

  test('out of bounds access throws', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    arr.push(1);
    throws((): void => {
      arr[1];
    });
    throws((): void => {
      arr[-1];
    });
  });

  test('out of bounds set throws', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    arr.push(1);
    throws((): void => {
      arr[1] = 2; // Should throw - index out of bounds
    });
    throws((): void => {
      arr[-1] = 2; // Should throw - index out of bounds
    });
  });

  test('map transforms elements', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    arr.push(1);
    arr.push(2);
    arr.push(3);
    
    let mapped = arr.map<i32>((x: i32) => x * 2);
    
    equal(mapped.length, 3);
    equal(mapped[0], 2);
    equal(mapped[1], 4);
    equal(mapped[2], 6);
  });

  test('fold aggregates elements', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    arr.push(1);
    arr.push(2);
    arr.push(3);
    arr.push(4);
    let sum = arr.fold<i32>(0, (acc: i32, x: i32): i32 => acc + x);
    equal(sum, 10);
  });

  test('fold on empty array returns initial value', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(0);
    let sum = arr.fold<i32>(42, (acc: i32, x: i32): i32 => acc + x);
    equal(sum, 42);
  });

  test('from copies elements from an array', (ctx: TestContext): void => {
    let src = [10, 20, 30];
    let arr = GrowableArray.from<i32>(src);
    equal(arr.length, 3);
    equal(arr[0], 10);
    equal(arr[1], 20);
    equal(arr[2], 30);
  });

  test('contains returns true if element found', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    arr.push(10);
    arr.push(20);
    equal(arr.contains(10), true);
    equal(arr.contains(20), true);
    equal(arr.contains(30), false);
  });

  test('all returns true when all elements match', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    arr.push(2);
    arr.push(4);
    arr.push(6);
    equal(arr.all((x: i32) => x % 2 == 0), true);
    arr.push(7);
    equal(arr.all((x: i32) => x % 2 == 0), false);
  });

  test('some returns true when at least one element matches', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    arr.push(1);
    arr.push(3);
    equal(arr.some((x: i32) => x % 2 == 0), false);
    arr.push(4);
    equal(arr.some((x: i32) => x % 2 == 0), true);
  });

  test('find returns element when predicate matches', (ctx: TestContext): void => {
    let arr = new GrowableArray<i32>(4);
    arr.push(10);
    arr.push(25);
    arr.push(30);
    if (let (true, found) = arr.find((x: i32) => x > 20)) {
      equal(found, 25);
    } else {
      equal(1, 0);
    }
    if (let (false, _) = arr.find((x: i32) => x > 100)) {
      // expected
    } else {
      equal(1, 0);
    }
  });
});

