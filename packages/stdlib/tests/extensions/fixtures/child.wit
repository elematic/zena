// The extensions' side of the interfaces: `ops` is what the child
// exports and `callbacks` what it imports, each as free functions.
// `relay` is a second extension bound to the child's `ops`. The
// caller's copy of all three is in caller.wit.
package test:ext@1.0.0;

interface ops {
  /// Asks the caller what `x` maps to, and doubles the answer.
  compute: async func(x: s32) -> s32;
  /// A string and a list across the boundary.
  describe: async func(name: string, parts: list<u32>) -> string;
  /// Traps.
  trap: async func();
  /// Never returns.
  spin: async func();
  /// Holds `mebibytes` of arrays at once, and returns how many it made.
  grow: async func(mebibytes: u32) -> u32;
  /// Counts the calls since the instance started.
  count: async func() -> u32;
  /// A transaction on the caller's store: begin, put, commit, drop.
  transact: async func(key: string, value: u32) -> u32;
}

/// What the caller serves: a store with transactions, a resource the
/// caller owns and the child holds through a proxy.
interface store {
  resource txn {
    put: func(key: string, value: u32);
    commit: func() -> u32;
  }
  begin: func() -> own<txn>;
  /// How many puts `txn` holds: a borrow across the boundary.
  size: func(txn: borrow<txn>) -> u32;
}

/// What the child exports and the caller holds through proxies.
interface sessions {
  resource session {
    bump: async func() -> u32;
  }
  open: async func(name: string) -> own<session>;
  /// How many sessions have been dropped.
  disposed: async func() -> u32;
}

interface callbacks {
  lookup: async func(key: s32) -> s32;
}

/// Calls another extension's `ops`.
interface relay {
  /// `compute` on the bound extension, twice over: 2 * (2 * lookup(x)).
  twice: async func(x: s32) -> s32;
}

/// A component with nothing to call back and no imports.
interface plain {
  ping: func() -> u32;
}

world child {
  import callbacks;
  import store;
  export ops;
  export sessions;
}

world relay-world {
  import ops;
  export relay;
}

world plain-world {
  export plain;
}

world random-world {
  import wasi:random/random@0.3.0;
  export plain;
}
