// An extension bound to another extension: its `ops` import is the
// child's export, wired by the caller's binding, and the child's calls
// back reach the caller through it.
import { compute } from 'test:ext/ops';
import { Future } from 'zena:async';

export async function twice(x: i32): Future<i32> {
  let once = await compute(x);
  return once * 2;
}
