// The extension the components tests load: implements `ops` from
// child.wit, calling back through `callbacks`. Compiled by the
// package's `build:fixtures` script.
import { lookup } from 'test:ext/callbacks';
import { Future } from 'zena:async';

var calls = 0 as u32;

export async function compute(x: i32): Future<i32> {
  let mapped = await lookup(x);
  return mapped * 2;
}

export async function describe(name: String, parts: Array<u32>): Future<String> {
  var sum = 0 as u32;
  for (let part in parts) {
    sum += part;
  }
  return `${name}:${parts.length}:${sum}`;
}

export async function trap(): Future<void> {
  let a = new FixedArray<i32>(1, 0);
  var i = 5;
  a[i] = 1;
}

export async function spin(): Future<void> {
  var n = 0;
  while (true) {
    n += 1;
  }
}

export async function grow(mebibytes: u32): Future<u32> {
  let held = new GrowableArray<FixedArray<u8>>();
  var i = 0 as u32;
  while (i < mebibytes) {
    held.push(new FixedArray<u8>(1 << 20, 0 as u8));
    i += 1 as u32;
  }
  return held.length as u32;
}

export async function count(): Future<u32> {
  calls += 1 as u32;
  return calls;
}
