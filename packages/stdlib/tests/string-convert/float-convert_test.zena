// @stdlib: true
//
// Float conversion is checked two ways. Here: the cases that pin the
// contract and the ones that have historically broken implementations
// — the extremes of the range, the subnormals, the ties, the values
// needing all 17 digits. Separately: `dev/fp-difftest.js` runs half a
// million randomized cases against JavaScript's own correctly-rounded
// conversions, which is what actually establishes that this is right.
import { suite, test } from 'zena:test';
import { equal } from 'zena:assert';
import {
  parseF64, f64ToString, f32ToString, f64ToPrecision, u64ToString,
} from 'zena:string-convert';
import {
  i64_reinterpret_f64, f64_reinterpret_i64, mulWide, mulWideSigned,
  add128, sub128,
} from 'zena:math';

/** The float's bits, so a test can name an exact value. */
let bitsOf = (v: f64): u64 => i64_reinterpret_f64(v) as u64;

export let tests = suite('float conversion', () => {
  // -- printing --------------------------------------------------------

  test('prints the shortest form that round-trips', (ctx) => {
    equal(f64ToString(0.1), "0.1");
    equal(f64ToString(0.3), "0.3");
    equal(f64ToString(1.0 / 3.0), "0.3333333333333333");
    equal(f64ToString(0.1 + 0.2), "0.30000000000000004");
    equal(f64ToString(0.0), "0");
    equal(f64ToString(1.5), "1.5");
    equal(f64ToString(100.0), "100");
  });

  test('prints values needing all 17 digits', (ctx) => {
    // 0.1 + 0.2 above is one; these are the classic others.
    equal(f64ToString(parseF64("1.7976931348623157e308")), "1.7976931348623157e+308");
    equal(f64ToString(parseF64("2.2250738585072014e-308")), "2.2250738585072014e-308");
    equal(f64ToString(parseF64("9.007199254740993e15")), "9007199254740992");
  });

  test('prints exactly representable integers exactly', (ctx) => {
    // The old implementation truncated to 15 significant digits and
    // printed this one as 9007199254740990.
    equal(f64ToString(9007199254740992.0), "9007199254740992");
    equal(f64ToString(123456789012345678.0), "123456789012345680");
    equal(f64ToString(4503599627370497.0), "4503599627370497");
  });

  test('prints the extremes', (ctx) => {
    equal(f64ToString(parseF64("5e-324")), "5e-324");
    equal(f64ToString(parseF64("1e-323")), "1e-323");
    equal(f64ToString(parseF64("2.225073858507201e-308")), "2.225073858507201e-308");
    equal(f64ToString(parseF64("1e308")), "1e+308");
  });

  test('switches notation where ECMAScript does', (ctx) => {
    equal(f64ToString(parseF64("1e20")), "100000000000000000000");
    equal(f64ToString(parseF64("1e21")), "1e+21");
    equal(f64ToString(parseF64("1e-6")), "0.000001");
    equal(f64ToString(parseF64("1e-7")), "1e-7");
  });

  test('prints NaN, the infinities and both zeros', (ctx) => {
    let inf = parseF64("1e400");
    equal(f64ToString(inf), "Infinity");
    equal(f64ToString(0.0 - inf), "-Infinity");
    equal(f64ToString(inf - inf), "NaN");
    equal(f64ToString(0.0), "0");
    equal(f64ToString(f64_reinterpret_i64(-9223372036854775808 as i64)), "-0");
    equal(f64ToString(0.0 - 1.5), "-1.5");
  });

  test('prints f32 with the f32 interval, not the promoted one', (ctx) => {
    // Promoting to f64 first and printing that would give
    // "0.10000000149011612" — the shortest decimal for the f64, not
    // for the f32 the caller actually has.
    equal(f32ToString(0.1 as f32), "0.1");
    equal(f32ToString(0.2 as f32), "0.2");
    equal(f32ToString(1.5 as f32), "1.5");
    equal(f32ToString(0.0 as f32), "0");
  });

  // -- parsing ---------------------------------------------------------

  test('parses to the nearest float', (ctx) => {
    equal(bitsOf(parseF64("0.1")), bitsOf(0.1));
    equal(bitsOf(parseF64("0.3")), bitsOf(0.3));
    equal(bitsOf(parseF64("1.5")), bitsOf(1.5));
    equal(bitsOf(parseF64("-2.5")), bitsOf(0.0 - 2.5));
    equal(bitsOf(parseF64("+7")), bitsOf(7.0));
  });

  test('reaches the top of the range without overflowing to infinity', (ctx) => {
    // The old implementation multiplied by a float power of ten and
    // returned Infinity for the largest finite double.
    let max = parseF64("1.7976931348623157e308");
    equal(f64ToString(max), "1.7976931348623157e+308");
    equal(f64ToString(parseF64("1.7976931348623159e308")), "Infinity");
    equal(f64ToString(parseF64("1e309")), "Infinity");
    equal(f64ToString(parseF64("-1e309")), "-Infinity");
  });

  test('reaches the subnormals without underflowing to zero', (ctx) => {
    // Likewise: the old implementation divided and returned 0 here.
    equal(f64ToString(parseF64("5e-324")), "5e-324");
    equal(f64ToString(parseF64("4.9e-324")), "5e-324");
    equal(f64ToString(parseF64("2.5e-324")), "5e-324");
    // Below half the smallest subnormal there is nothing left.
    equal(f64ToString(parseF64("2.4e-324")), "0");
    equal(f64ToString(parseF64("1e-400")), "0");
  });

  test('rounds halfway cases to even', (ctx) => {
    // 2^53 + 1 is not representable; it sits exactly between two
    // doubles and must land on the even one.
    equal(f64ToString(parseF64("9007199254740993")), "9007199254740992");
    equal(f64ToString(parseF64("9007199254740995")), "9007199254740996");
  });

  test('parses the values that have broken other implementations', (ctx) => {
    // The PHP-hang value and its neighbours.
    equal(f64ToString(parseF64("2.2250738585072011e-308")), "2.225073858507201e-308");
    equal(f64ToString(parseF64("2.2250738585072012e-308")), "2.2250738585072014e-308");
    equal(f64ToString(parseF64("8.98846567431158e307")), "8.98846567431158e+307");
    equal(f64ToString(parseF64("123456789012345678")), "123456789012345680");
  });

  test('round-trips every shortest form it prints', (ctx) => {
    // Printing is defined by this property, so assert it directly.
    let values = [
      0.1, 0.3, 1.0 / 3.0, 0.1 + 0.2, 1.5, 10000000000.0, 123.456, 0.0 - 7.25,
      9007199254740992.0, 4503599627370497.0, 1.0 / 7.0, 2.0 / 3.0,
    ];
    for (let v in values) {
      equal(bitsOf(parseF64(f64ToString(v))), bitsOf(v));
    }
  });

  test('accepts leading zeros, bare fractions and exponent signs', (ctx) => {
    equal(bitsOf(parseF64("007")), bitsOf(7.0));
    equal(bitsOf(parseF64("0.5")), bitsOf(0.5));
    equal(bitsOf(parseF64(".5")), bitsOf(0.5));
    equal(bitsOf(parseF64("5.")), bitsOf(5.0));
    equal(bitsOf(parseF64("1e+2")), bitsOf(100.0));
    equal(bitsOf(parseF64("1E-2")), bitsOf(0.01));
    equal(bitsOf(parseF64("0.000000000000000000000001")), bitsOf(parseF64("1e-24")));
  });

  test('parses hexadecimal integers', (ctx) => {
    equal(bitsOf(parseF64("0x10")), bitsOf(16.0));
    equal(bitsOf(parseF64("0xff")), bitsOf(255.0));
    equal(bitsOf(parseF64("-0xFF")), bitsOf(0.0 - 255.0));
  });

  // -- fixed-width printing --------------------------------------------

  test('prints a fixed number of significant digits', (ctx) => {
    equal(f64ToPrecision(3.14159265358979, 5), "3.1416");
    equal(f64ToPrecision(3.14159265358979, 1), "3");
    equal(f64ToPrecision(1.0 / 3.0, 10), "0.3333333333");
    equal(f64ToPrecision(0.0 - 2.5, 2), "-2.5");
    equal(f64ToPrecision(0.0, 5), "0");
  });

  test('carries a fixed-width round-up into an extra digit', (ctx) => {
    // Matching ECMAScript's toPrecision: the digit count is kept even
    // when the round-up carries, so 0.99999 to three digits is "1.00".
    equal(f64ToPrecision(9.999, 2), "10");
    equal(f64ToPrecision(0.99999, 3), "1.00");
    equal(f64ToPrecision(9.999, 3), "10.0");
  });

  // -- the wide-arithmetic intrinsics underneath ------------------------
  //
  // These lower either to the wide-arithmetic proposal's instructions
  // or to the sequences that mean the same thing, depending on a
  // compiler flag, so their results must not depend on which.

  test('multiplies to a full 128-bit product', (ctx) => {
    let (lo, hi) = mulWide(18446744073709551615 as u64, 18446744073709551615 as u64);
    // (2^64-1)^2 = 2^128 - 2^65 + 1
    equal(u64ToString(hi), "18446744073709551614");
    equal(u64ToString(lo), "1");

    let (lo2, hi2) = mulWide(1311768467463790320 as u64, 1147797409030816545 as u64);
    equal(u64ToString(hi2), "81621149086635842");
    equal(u64ToString(lo2), "2465395958572223728");

    let (lo3, hi3) = mulWide(0 as u64, 12345 as u64);
    equal(u64ToString(hi3), "0");
    equal(u64ToString(lo3), "0");

    let (lo4, hi4) = mulWide(1 as u64, 12345 as u64);
    equal(u64ToString(hi4), "0");
    equal(u64ToString(lo4), "12345");
  });

  test('sign-extends the signed wide multiply', (ctx) => {
    let minusThree: i64 = -3 as i64;
    let (lo, hi) = mulWideSigned(minusThree, 5 as i64);
    equal(hi, -1 as i64);                        // -15 is all-ones above
    equal(u64ToString(lo as u64), "18446744073709551601");
  });

  test('carries and borrows across 128 bits', (ctx) => {
    let (lo, hi) = add128(
        18446744073709551615 as u64, 0 as u64, 1 as u64, 0 as u64);
    equal(u64ToString(hi), "1");
    equal(u64ToString(lo), "0");

    let (lo2, hi2) = sub128(0 as u64, 1 as u64, 1 as u64, 0 as u64);
    equal(u64ToString(hi2), "0");
    equal(u64ToString(lo2), "18446744073709551615");

    let (lo3, hi3) = add128(1 as u64, 2 as u64, 3 as u64, 4 as u64);
    equal(u64ToString(hi3), "6");
    equal(u64ToString(lo3), "4");
  });
});
