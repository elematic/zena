import { suite, test } from 'zena:test';
import { equal, isTrue, isFalse, isNull, throws, fail } from 'zena:assert';
import {
  ArgParser, OptionType, parseArgs,
  Flag, Single, Multi,
} from 'zena:args';

export let tests = suite('Args', () => {
  test('boolean flags and negation', () => {
    let parser = new ArgParser({
      name: 'app',
      options: {
        'verbose' => {type: OptionType.Flag, abbr: 'v', help: 'Verbose output'},
        'debug' => {type: OptionType.Flag, abbr: 'g', help: 'Debug mode'},
        'optimize' => {type: OptionType.Flag, help: 'Optimization', defaultVal: 'true'},
        'no-cache' => {type: OptionType.Flag, help: 'Bypass compile cache'},
      },
    });

    let res1 = parser.parse(['--verbose']);
    isTrue(res1.getFlag('verbose'));
    isFalse(res1.getFlag('debug'));
    isTrue(res1.getFlag('optimize'));
    isFalse(res1.getFlag('no-cache'));

    // Negated flag (`--no-optimize`) vs literal `--no-cache` flag
    let res2 = parser.parse(['--no-optimize', '--no-cache']);
    isFalse(res2.getFlag('optimize'));
    isTrue(res2.getFlag('no-cache'));

    // Explicit `=true` / `=false` / `=1` on flags
    let res3 = parser.parse(['--verbose=false', '--debug=1']);
    isFalse(res3.getFlag('verbose'));
    isTrue(res3.getFlag('debug'));

    // Combined short flags
    let res4 = parser.parse(['-vg']);
    isTrue(res4.getFlag('verbose'));
    isTrue(res4.getFlag('debug'));
  });

  test('string options', () => {
    let parser = new ArgParser({
      name: 'app',
      options: {
        'output' => {abbr: 'o', help: 'Output path', defaultVal: 'default.out'},
        'target' => {abbr: 't', help: 'Target'},
        'opt' => {abbr: 'O'},
      },
    });

    // Space-separated: --output file.txt
    let res1 = parser.parse(['--output', 'file.txt']);
    equal(res1.getOption('output') ?? null, 'file.txt');

    // Equals-separated: --output=file2.txt
    let res2 = parser.parse(['--output=file2.txt']);
    equal(res2.getOption('output') ?? null, 'file2.txt');

    // Short option: -o file3.txt
    let res3 = parser.parse(['-o', 'file3.txt']);
    equal(res3.getOption('output') ?? null, 'file3.txt');

    // Short attached: -O2
    let res4 = parser.parse(['-O2']);
    equal(res4.getOption('opt') ?? null, '2');

    // Short option with equals: -o=file4.txt
    let res5 = parser.parse(['-o=file4.txt']);
    equal(res5.getOption('output') ?? null, 'file4.txt');
  });

  test('integer options', () => {
    let parser = new ArgParser({
      name: 'app',
      options: {
        'count' => {type: OptionType.Int, abbr: 'n', help: 'Count', defaultVal: '1'},
      },
    });

    let res1 = parser.parse(['-n', '42']);
    equal(res1.getInt('count') ?? 0, 42);

    let res2 = parser.parse([]);
    equal(res2.getInt('count') ?? 0, 1);

    let res3 = parser.parse(['--count=notanumber']);
    equal(res3.getInt('count') ?? -1, -1);
  });

  test('multi-string options', () => {
    let parser = new ArgParser({
      name: 'app',
      options: {
        'dir' => {type: OptionType.MultiString, abbr: 'd', help: 'Preopened directory'},
      },
    });

    let res = parser.parse(['--dir', '/tmp', '--dir=/data', '-d', '/var', '-d/opt']);
    isTrue(res.getMultiOption('dir').contentEquals(['/tmp', '/data', '/var', '/opt']));

    let empty = parser.parse([]);
    equal(empty.getMultiOption('dir').length, 0);
  });

  test('allowed option values', () => {
    let parser = new ArgParser({
      name: 'app',
      options: {
        'target' => {
          abbr: 't',
          allowed: ['wasm', 'js'],
          defaultVal: 'wasm',
          help: 'Compilation target',
        },
        'tag' => {
          type: OptionType.MultiString,
          allowed: ['fast', 'slow'],
        },
      },
    });

    let res = parser.parse(['-t', 'js', '--tag=fast', '--tag', 'slow']);
    equal(res.getOption('target') ?? null, 'js');
    isTrue(res.getMultiOption('tag').contentEquals(['fast', 'slow']));

    throws(() => {
      parser.parse(['--target=native']);
    });
    throws(() => {
      parser.parse(['-tnative']);
    });
    throws(() => {
      parser.parse(['--tag=unknown']);
    });

    let help = parser.formatHelp();
    isTrue(help.contains('[wasm, js]'), help);
    isTrue(help.contains('(default: wasm)'), help);
  });

  test('positional arguments and delimiter (--)', () => {
    let parser = new ArgParser({
      name: 'app',
      options: {
        'verbose' => {type: OptionType.Flag, abbr: 'v'},
      },
    });

    let res = parser.parse(['input.txt', '-v', '--', '--not-an-option', 'final.txt']);
    isTrue(res.getFlag('verbose'));
    isTrue(res.rest.contentEquals(['input.txt', '--not-an-option', 'final.txt']));
  });

  test('subcommands and nested subcommands from config', () => {
    let parser = new ArgParser({
      name: 'zena',
      help: 'The Zena toolchain',
      options: {
        'verbose' => {type: OptionType.Flag, abbr: 'v'},
      },
      commands: {
        'build' => {
          help: 'Build a Zena file',
          options: {
            'output' => {abbr: 'o', help: 'Output file', defaultVal: 'out.wasm'},
            'time' => {type: OptionType.Flag, help: 'Time compilation'},
          },
        },
        'pkg' => {
          help: 'Manage packages',
          commands: {
            'add' => {
              help: 'Add a package',
              options: {'name' => {help: 'Its local name'}},
            },
            'fetch' => {help: 'Fetch pinned packages'},
          },
        },
      },
    });

    let res1 = parser.parse(['-v', 'build', 'main.zena', '-o', 'main.wasm', '--time']);
    isTrue(res1.getFlag('verbose'));
    equal(res1.commandName, 'build');
    let buildArgs = res1.commandArgs;
    if (buildArgs != null) {
      equal(buildArgs.getOption('output') ?? null, 'main.wasm');
      isTrue(buildArgs.getFlag('time'));
      isTrue(buildArgs.rest.contentEquals(['main.zena']));
    } else {
      fail('expected build commandArgs');
    }

    let res2 = parser.parse(['pkg', 'add', 'acme.pkg.test', '--name', 'acme']);
    equal(res2.commandName, 'pkg');
    let pkgArgs = res2.commandArgs;
    if (pkgArgs != null) {
      equal(pkgArgs.commandName, 'add');
      let addArgs = pkgArgs.commandArgs;
      if (addArgs != null) {
        equal(addArgs.getOption('name') ?? null, 'acme');
        isTrue(addArgs.rest.contentEquals(['acme.pkg.test']));
      } else {
        fail('expected add commandArgs');
      }
    } else {
      fail('expected pkg commandArgs');
    }

    let pkg = parser.command('pkg');
    if (pkg != null) {
      let pkgHelp = pkg.formatHelp();
      isTrue(pkgHelp.contains('Usage: zena pkg'), pkgHelp);
      isTrue(pkgHelp.contains('add') && pkgHelp.contains('Fetch pinned packages'), pkgHelp);
      let add = pkg.command('add');
      if (add != null) {
        isTrue(add.formatHelp().contains('Usage: zena pkg add'));
      } else {
        fail('expected add parser');
      }
    } else {
      fail('expected pkg parser');
    }
    isNull(parser.command('nothing'));
  });

  test('dynamic addOption and addCommand', () => {
    let parser = new ArgParser({name: 'mytool', help: 'Extensible tool'});
    parser.addOption('verbose', {type: OptionType.Flag, abbr: 'v'});
    let pluginCmd = parser.addCommand('serve', {help: 'Start server'});
    pluginCmd.addOption('port', {type: OptionType.Int, abbr: 'p', defaultVal: '8080'});

    let res = parser.parse(['-v', 'serve', '-p', '3000']);
    isTrue(res.getFlag('verbose'));
    equal(res.commandName, 'serve');
    let serveArgs = res.commandArgs;
    if (serveArgs != null) {
      equal(serveArgs.getInt('port') ?? 0, 3000);
    } else {
      fail('expected serve commandArgs');
    }
  });

  test('help formatting and first-line command summaries', () => {
    let parser = new ArgParser({
      name: 'mytool',
      help: 'A CLI utility',
      options: {
        'verbose' => {type: OptionType.Flag, abbr: 'v', help: 'Verbose logging'},
        'output' => {abbr: 'o', help: 'Output file', defaultVal: 'out.txt'},
        'imported-string-constants' => {help: 'Module importing string constants'},
      },
      commands: {
        'fmt' => {
          help: 'Format Zena files\n\nRewrites files in place with -w, or checks formatting with --check.',
          options: {'write' => {type: OptionType.Flag, abbr: 'w'}},
        },
      },
    });

    let rootHelp = parser.formatHelp();
    isTrue(rootHelp.contains('Usage: mytool [options] <command> [args]'), rootHelp);
    isTrue(rootHelp.contains('A CLI utility'), rootHelp);
    isTrue(rootHelp.contains('-v, --verbose'), rootHelp);
    isTrue(rootHelp.contains('-o, --output <value>'), rootHelp);
    isTrue(rootHelp.contains('(default: out.txt)'), rootHelp);
    isTrue(
      rootHelp.contains('--imported-string-constants <value>  Module importing string constants'),
      rootHelp,
    );
    // Parent Commands table shows only the first line of fmt's help.
    isTrue(rootHelp.contains('Format Zena files'), rootHelp);
    isFalse(rootHelp.contains('Rewrites files in place'), rootHelp);

    // Subcommand's own formatHelp shows the full multi-paragraph help.
    let fmt = parser.command('fmt');
    if (fmt != null) {
      let fmtHelp = fmt.formatHelp();
      isTrue(fmtHelp.contains('Usage: mytool fmt [options]'), fmtHelp);
      isTrue(fmtHelp.contains('Format Zena files\n\nRewrites files in place'), fmtHelp);
    } else {
      fail('expected fmt parser');
    }

    // Anonymous parser falls back to `Usage: program`.
    let anon = new ArgParser();
    isTrue(anon.formatHelp().contains('Usage: program'));
  });

  test('parseArgs with full ParserConfig', () => {
    let res = parseArgs(
      ['ignored_binary', '--quiet', 'run', '--name=Alice', 'prog.zena', '--child-flag'],
      {
        options: {
          'quiet' => {type: OptionType.Flag, abbr: 'q'},
        },
        commands: {
          'run' => {
            stopAtPositional: true,
            options: {
              'name' => {defaultVal: 'World'},
            },
          },
        },
      },
      1,
    );

    isTrue(res.getFlag('quiet'));
    equal(res.commandName, 'run');
    let sub = res.commandArgs;
    if (sub != null) {
      equal(sub.getOption('name') ?? null, 'Alice');
      isTrue(sub.rest.contentEquals(['prog.zena', '--child-flag']));
    } else {
      fail('expected run commandArgs');
    }
  });

  test('error cases and name validation', () => {
    let parser = new ArgParser({
      name: 'app',
      options: {
        'verbose' => {type: OptionType.Flag, abbr: 'v'},
        'output' => {abbr: 'o'},
      },
    });

    // Unknown options
    throws(() => { parser.parse(['--invalid']); });
    throws(() => { parser.parse(['--invalid=1']); });
    throws(() => { parser.parse(['-x']); });
    throws(() => { parser.parse(['-vx']); });

    // Non-flag inside combined short flags
    throws(() => { parser.parse(['-vo']); });

    // Missing required option values
    throws(() => { parser.parse(['--output']); });
    throws(() => { parser.parse(['-o']); });

    // Empty option or command names
    throws(() => {
      new ArgParser({options: {'' => {}}});
    });
    throws(() => {
      new ArgParser().addOption('', {type: OptionType.Flag});
    });
    throws(() => {
      new ArgParser().addCommand('');
    });
  });

  test('ParsedValue variants and hasOption', () => {
    let parser = new ArgParser({
      name: 'app',
      options: {
        'flag' => {type: OptionType.Flag},
        'single' => {},
        'multi' => {type: OptionType.MultiString},
        'absent' => {},
        'defaulted' => {defaultVal: 'yes'},
      },
    });

    let res = parser.parse(['--flag', '--single=hello', '--multi=first', '--multi=second']);

    if (let (true, Flag {value}) = res.get('flag')) {
      isTrue(value);
    } else {
      fail('expected Flag');
    }

    if (let (true, Single {value}) = res.get('single')) {
      equal(value, 'hello');
    } else {
      fail('expected Single');
    }

    if (let (true, Multi {values}) = res.get('multi')) {
      isTrue(values.contentEquals(['first', 'second']));
    } else {
      fail('expected Multi');
    }

    equal(res.options.size, 4);
    isTrue(res.hasOption('flag'));
    isTrue(res.hasOption('single'));
    isTrue(res.hasOption('multi'));
    isTrue(res.hasOption('defaulted'));
    isFalse(res.hasOption('absent'));
  });

  test('stopAtPositional hands the tail to rest', () => {
    let parser = new ArgParser({
      name: 'app',
      commands: {
        'run' => {
          stopAtPositional: true,
          options: {'verbose' => {type: OptionType.Flag, abbr: 'v'}},
        },
      },
    });

    let res = parser.parse(['run', '-v', 'prog.zena', '-v', '--unknown', 'tail']);
    equal(res.commandName, 'run');
    let sub = res.commandArgs;
    if (sub != null) {
      isTrue(sub.getFlag('verbose'));
      isTrue(sub.rest.contentEquals(['prog.zena', '-v', '--unknown', 'tail']));
    } else {
      fail('expected run commandArgs');
    }

    // Without stopAtPositional, an undeclared option after a positional throws.
    let strict = new ArgParser({
      name: 'app',
      options: {'verbose' => {type: OptionType.Flag, abbr: 'v'}},
    });
    throws(() => {
      strict.parse(['prog.zena', '--unknown']);
    });
  });
});
