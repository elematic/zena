{
  "description": "Zena standard library module manifest",
  "name": "zena",
  "root": "zena",
  "modules": {
    "args": {},
    "assert": {},
    "async": {},
    "bench": {
      "path": "bench/index.zena"
    },
    "cli": {
      "virtual": {
        "zena-cli": "cli/component.zena",
        "component": "cli/component.zena"
      }
    },
    "core": {
      "path": "core/index.zena"
    },
    "collections": {
      "path": "collections/index.zena"
    },
    "console": {
      "virtual": {
        "host": "console/host.zena",
        "js": "console/host.zena",
        "zena-cli": "console/component.zena",
        "component": "console/component.zena",
        "freestanding": "console/component.zena"
      }
    },
    "error-stack": {
      "virtual": {
        "host": "core/error/stack-host.zena",
        "js": "core/error/stack-host.zena",
        "zena-cli": "core/error/stack-hooked.zena",
        "freestanding": "core/error/stack-none.zena",
        "component": "core/error/stack-none.zena"
      },
      "internal": true
    },
    "fetch": {
      "virtual": {
        "host": "fetch/host.zena",
        "js": "fetch/host.zena",
        "component": "fetch/component.zena"
      }
    },
    "fs": {
      "virtual": {
        "zena-cli": "fs/component.zena",
        "component": "fs/component.zena"
      }
    },
    "glob": {},
    "host-setup": {
      "virtual": {
        "zena-cli": "host-setup.zena"
      }
    },
    "js": {
      "virtual": {
        "host": "js/index.zena",
        "js": "js/index.zena"
      }
    },
    "json": {},
    "math": {},
    "memory": {
      "virtual": {
        "host": "memory.zena",
        "js": "memory.zena",
        "zena-cli": "memory/component.zena",
        "freestanding": "memory.zena",
        "component": "memory/component.zena"
      }
    },
    "path": {},
    "process": {
      "virtual": {
        "zena-cli": "process/component.zena"
      }
    },
    "regex": {},
    "simd": {
      "path": "simd/index.zena"
    },
    "stream": {
      "path": "stream/index.zena"
    },
    "task": {},
    "test": {},
    "time": {
      "virtual": {
        "host": "time/host.zena",
        "js": "time/host.zena",
        "zena-cli": "time/p3.zena",
        "component": "time/p3.zena"
      }
    },
    "url": {
      "path": "url/index.zena"
    },
    "wasi": {
      "path": "wasi/index.zena"
    },
    "wasm": {
      "virtual": {
        "zena-cli": "wasm/component.zena"
      }
    },
    "http": {
      "virtual": {
        "component": "http/index.zena"
      }
    }
  }
}
