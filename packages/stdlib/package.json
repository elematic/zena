{
  "name": "@zena-lang/stdlib",
  "version": "0.0.1",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./zena/*": "./zena/*.zena"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "zena"
  ],
  "scripts": {
    "build": "wireit",
    "lib": "wireit",
    "test": "wireit",
    "build:wasi-tests": "wireit",
    "test:wasmtime": "wireit",
    "build:wasi-tests:self-hosted": "wireit",
    "test:wasmtime:self-hosted": "wireit",
    "test:self-hosted": "wireit",
    "test:cli": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc",
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "zena/**/*.zena"
      ],
      "output": [
        "index.{js,d.ts,js.map,d.ts.map}",
        "tsconfig.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "lib": {
      "command": "echo 'Zena stdlib files'",
      "files": [
        "zena/**/*.zena"
      ],
      "output": []
    },
    "build:wasi-tests": {
      "command": "node scripts/build-wasi-tests.js",
      "files": [
        "scripts/build-wasi-tests.js",
        "zena/**/*.zena",
        "tests/fs/**/*.zena",
        "tests/memory_test.__runner__.zena",
        "tests/fixed_array/**/*.zena",
        "tests/array/**/*.zena"
      ],
      "output": [
        "tests/out/**/*.wasm"
      ],
      "dependencies": [
        "../cli:build"
      ]
    },
    "test": {
      "dependencies": [
        "test:wasmtime",
        "test:node",
        "test:self-hosted"
      ]
    },
    "test:node": {
      "dependencies": [
        "../compiler:test:portable"
      ]
    },
    "test:wasmtime": {
      "command": "node scripts/run-wasmtime.js",
      "files": [
        "scripts/run-wasmtime.js"
      ],
      "output": [],
      "dependencies": [
        "build:wasi-tests",
        "../zena-cli:build"
      ]
    },
    "build:wasi-tests:self-hosted": {
      "command": "node scripts/build-wasi-tests-self-hosted.js",
      "files": [
        "scripts/build-wasi-tests-self-hosted.js",
        "zena/**/*.zena",
        "tests/**/*.zena",
        "!tests/cli/**/*.zena",
        "!tests/**/*.__runner__.zena"
      ],
      "output": [
        "tests/out-self-hosted/**/*.wasm"
      ],
      "dependencies": [
        "../zena-cli:build",
        "../zena-compiler:precompile:cli"
      ]
    },
    "test:wasmtime:self-hosted": {
      "command": "node scripts/run-wasmtime-self-hosted.js",
      "files": [
        "scripts/run-wasmtime-self-hosted.js"
      ],
      "output": [],
      "dependencies": [
        "build:wasi-tests:self-hosted",
        "../zena-cli:build"
      ]
    },
    "test:self-hosted": {
      "dependencies": [
        "test:wasmtime:self-hosted"
      ]
    },
    "test:cli": {
      "command": "../../target/release/zena-cli test \"tests/**/*_test.zena\"",
      "files": [
        "tests/**/*_test.zena",
        "zena/**/*.zena"
      ],
      "output": [],
      "dependencies": [
        "../zena-cli:build",
        "../zena-compiler:precompile:cli"
      ]
    }
  },
  "dependencies": {
    "glob": "^11.1.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "wireit": "^0.14.4"
  }
}
