{
  "name": "@zena-lang/stdlib",
  "version": "0.0.1",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./zena/*": "./zena/*.zena"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "zena"
  ],
  "scripts": {
    "build": "wireit",
    "lib": "wireit",
    "test": "wireit",
    "test:cli": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc",
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "zena/**/*.zena"
      ],
      "output": [
        "index.{js,d.ts,js.map,d.ts.map}",
        "lib/**",
        "tsconfig.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "lib": {
      "command": "echo 'Zena stdlib files'",
      "files": [
        "zena/**/*.zena"
      ],
      "output": []
    },
    "test": {
      "dependencies": [
        "test:cli"
      ]
    },
    "test:cli": {
      "command": "../../target/release/zena-cli test tests --exclude \"**/cli_test.zena\"",
      "//": "cli_test.zena reaches both of zena:cli's record shapes at once, which does not compile: https://code.rictic.com/justin/zena/issues/484. It was excluded before this too, silently, by the Node build script's glob.",
      "files": [
        "tests/**/*.zena",
        "zena/**/*.zena",
        "stdlib-manifest.json"
      ],
      "output": [],
      "dependencies": [
        "../zena-cli:build",
        "../zena-compiler:precompile:cli"
      ]
    }
  },
  "dependencies": {
    "glob": "^11.1.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "wireit": "^0.14.4"
  }
}
