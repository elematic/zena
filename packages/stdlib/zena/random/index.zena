/**
 * Random numbers from the host's cryptographically secure generator:
 * `wasi:random`'s `random` interface on the component targets, and
 * `crypto.getRandomValues` on js.
 *
 * The values are unpredictable, so they are fit for keys, salts, nonces
 * and identifiers. Nothing seeds the generator, so a sequence cannot be
 * repeated.
 *
 * ## Examples
 *
 * ```zena
 * import { randomBytes, randomInt, randomF64 } from 'zena:random';
 *
 * let salt = randomBytes(32);
 * let roll = randomInt(1..7);
 * let jitter = randomF64() * 50.0;
 * ```
 */

import { hostRandomBytes, hostRandomU64 } from './source.zena';

/**
 * `count` random bytes. Throws when `count` is negative.
 */
export function randomBytes(count: i32): FixedArray<u8> {
  if (count < 0) {
    throw new Error(`zena:random: randomBytes(${count}) needs a count of zero or more`);
  }
  return hostRandomBytes(count);
}

/** A random `u64`. */
export function randomU64(): u64 {
  return hostRandomU64();
}

/**
 * A random integer in `[0, span)` (`0 < span <= 2^32`), with every
 * value equally likely.
 */
function randomBelow(span: u64): u32 {
  // The 2^64 possible values of a `u64` split into floor(2^64 / span)
  // complete groups of size `span`, plus one partial group of size
  // `threshold = 2^64 % span` left over. Taking `x % span` across all
  // 2^64 values would give remainders `0..threshold` one extra hit from
  // that partial group.
  //
  // In 64-bit unsigned wraparound arithmetic, `0 - span` is
  // `2^64 - span`, which has the same remainder modulo `span` as `2^64`
  // itself. So `((0 as u64) - span) % span` computes `2^64 % span`
  // without needing a 65-bit integer.
  //
  // When `x < threshold`, `x` falls in the first `threshold` values
  // (`0..threshold`), so we discard it and draw again. The accepted
  // range `[threshold, 2^64)` has `2^64 - threshold` values — an exact
  // multiple of `span`. Because any contiguous integer range of length
  // `k * span` covers every remainder `0..span` exactly `k` times
  // regardless of where it starts, `x % span` on an accepted `x` is
  // completely uniform.
  //
  // Since `threshold < span <= 2^32`, `x < threshold` is true on fewer
  // than 2^32 / 2^64 = 1 in 2^32 (~4.3 billion) draws.
  let threshold = ((0 as u64) - span) % span;
  var x = hostRandomU64();
  while (x < threshold) {
    x = hostRandomU64();
  }
  return (x % span) as u32;
}

/**
 * A random integer at least 0 and less than `bound`, each equally
 * likely. Throws when `bound` is not positive.
 */
export function randomInt(bound: i32): i32 {
  if (bound <= 0) {
    throw new Error(`zena:random: randomInt(${bound}) needs a positive bound`);
  }
  return randomBelow(bound as u64) as i32;
}

/**
 * A random integer in the half-open `range` `[range.start, range.end)`,
 * each equally likely. Throws when `range.start >= range.end`.
 */
export function randomInt(range: BoundedRange): i32 {
  let min = range.start;
  let max = range.end;
  if (min >= max) {
    throw new Error(`zena:random: randomInt(${min}..${max}) needs a non-empty range`);
  }
  // Subtract in i64 so spans wider than i32.max (e.g. -10..i32.max) do
  // not overflow i32.
  let span = ((max as i64) - (min as i64)) as u64;
  return ((min as u32) + randomBelow(span)) as i32;
}

/**
 * A random `f64` at least 0 and less than 1: one of the 2^53 multiples
 * of 2^-53 in that range, each equally likely.
 */
export function randomF64(): f64 {
  let bits = hostRandomU64() >> (11 as u64);
  // 2^53, which divides exactly.
  return (bits as f64) / 9007199254740992.0;
}
