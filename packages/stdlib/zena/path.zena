/**
 * File path manipulation and inspection for forward-slash delimited paths.
 *
 * This module provides two complementary APIs:
 *
 * 1. **Standalone string functions**: (`join`, `dirname`, `basename`, `extname`,
 *    `normalize`, `relative`, `split`, `stripPrefix`) operate directly on
 *    standard `String` values.
 * 2. **Strongly typed path classes**: (`Path`, `AbsolutePath`, `RelativePath`,
 *    `PathSegment`, `FilePath`, `DirectoryPath`) wrap `String` as extension
 *    classes to enforce path invariants at compile time with zero runtime
 *    allocation overhead.
 *
 * ## Strongly Typed Paths
 *
 * Using plain strings for paths can lead to subtle bugs, such as passing a
 * relative path where an absolute path is required or joining two absolute
 * paths together. The typed path hierarchy models path distinctions in the
 * type system:
 *
 * - `Path`: Base extension class for any path.
 * - `AbsolutePath`: A path guaranteed to start with `/`.
 * - `RelativePath`: A path guaranteed not to start with `/`.
 * - `PathSegment`: A single non-empty relative component containing no `/`.
 * - `FilePath`: A path representing a file.
 * - `DirectoryPath`: A path representing a directory, with fluent child navigation.
 *
 * Because these are Zena extension classes on `String`, they are erased at
 * runtime. A `Path` or `AbsolutePath` is represented as an unboxed `String`
 * in WebAssembly memory with no object wrappers and no virtual method tables.
 *
 * ### Constructing and Validating Paths
 *
 * Standard constructors validate format at runtime and throw `Error` on invalid
 * input:
 *
 * ```zena
 * let abs = new AbsolutePath('/usr/local/bin');
 * let rel = new RelativePath('src/main.zena');
 * let seg = new PathSegment('main.zena');
 * ```
 *
 * When input is already known to be valid (for example, output from an internal
 * helper), the `unchecked` constructors bypass validation checks:
 *
 * ```zena
 * let fastAbs = new AbsolutePath.unchecked('/etc/hosts');
 * ```
 *
 * ### Type-Safe Path Operations
 *
 * Typed paths enforce sound combinations. For example, `AbsolutePath.join()`
 * requires a `RelativePath` parameter and returns an `AbsolutePath`:
 *
 * ```zena
 * let root = new AbsolutePath('/home/user');
 * let sub = new RelativePath('projects/zena');
 * let projectDir = root.join(sub); // AbsolutePath: '/home/user/projects/zena'
 * ```
 *
 * ### Conversions
 *
 * A general `Path` can be converted to more specific types:
 * - `toAbsolutePath()` and `toRelativePath()` validate at runtime and throw
 *   `Error` if the path does not match the target format.
 * - `toFilePath()` and `toDirectoryPath()` are erased compile-time casts with
 *   no runtime checks.
 *
 * ## Examples
 *
 * ```zena
 * import { join, dirname, basename, extname, AbsolutePath, RelativePath, DirectoryPath } from 'zena:path';
 *
 * // Standalone functions on strings:
 * let fullPath = join(['src/lib', 'index.zena']);
 * let dir = dirname(fullPath);
 * let file = basename(fullPath);
 * let ext = extname(fullPath);
 *
 * // Strongly typed path classes:
 * let project = new DirectoryPath('/workspace/app');
 * let src = project.dir('src');
 * let mainFile = src.file('main.zena');
 * let extStr = mainFile.extension; // '.zena'
 * ```
 */

import { StringBuilder, StringReader } from 'zena:core';

/**
 * The path segment separator ('/').
 */
export let separator: String = '/';

/**
 * The platform path list delimiter (':' in POSIX/WASI).
 */
export let delimiter: String = ':';

/**
 * Returns true if `path` is an absolute path (starts with '/').
 */
export let isAbsolute = (path: String): boolean => {
  return path.length > 0 && path.getByteAt(0) == 47;
};

/**
 * Splits `path` by the separator into non-empty segments using a two-pass
 * approach that returns a fixed-size array of PathSegments.
 *
 * @example
 * ```zena
 * split('/foo/bar/baz') // ['foo', 'bar', 'baz']
 * split('a//b')         // ['a', 'b']
 * ```
 */
export let split = (path: String): FixedArray<PathSegment> => {
  if (path.length == 0) {
    return new FixedArray<PathSegment>(0, new PathSegment.unchecked(''));
  }

  let reader = new StringReader(path);

  // Pass 1: count non-empty segments
  var count = 0;
  var segStart = 0;
  while (!reader.isAtEnd) {
    let pos = reader.position;
    if (reader.advanceByte() == 47) {
      if (pos > segStart) {
        count += 1;
      }
      segStart = pos + 1;
    }
  }
  if (segStart < path.length) {
    count += 1;
  }

  if (count == 0) {
    return new FixedArray<PathSegment>(0, new PathSegment.unchecked(''));
  }

  // Pass 2: populate segments
  let parts = new FixedArray<PathSegment>(count, new PathSegment.unchecked(''));
  reader.reset(0);
  var idx = 0;
  segStart = 0;
  while (!reader.isAtEnd) {
    let pos = reader.position;
    if (reader.advanceByte() == 47) {
      if (pos > segStart) {
        parts[idx] = new PathSegment.unchecked(path.sliceBytes(segStart, pos));
        idx += 1;
      }
      segStart = pos + 1;
    }
  }
  if (segStart < path.length) {
    parts[idx] = new PathSegment.unchecked(path.sliceBytes(segStart, path.length));
  }

  return parts;
};

/**
 * Normalizes `path`, resolving '.' and '..' segments and collapsing
 * multiple consecutive slashes.
 *
 * Leading '/' is preserved for absolute paths. Leading '..' segments
 * are preserved for relative paths that navigate above their starting point.
 *
 * @example
 * ```zena
 * normalize('/a/b/../c/./d') // '/a/c/d'
 * normalize('a//b/./c')      // 'a/b/c'
 * normalize('')              // '.'
 * ```
 */
export let normalize = (path: String): String => {
  if (path.length == 0) {
    return '.';
  }

  let isAbs = isAbsolute(path);
  let segments = new GrowableArray<String>();
  let reader = new StringReader(path);
  var segStart = 0;

  while (!reader.isAtEnd) {
    let pos = reader.position;
    if (reader.advanceByte() == 47) {
      if (pos > segStart) {
        let seg = path.sliceBytes(segStart, pos);
        if (seg == '..') {
          if (segments.length > 0 && segments[segments.length - 1] != '..') {
            segments.pop();
          } else if (!isAbs) {
            segments.push(seg);
          }
        } else if (seg != '.') {
          segments.push(seg);
        }
      }
      segStart = pos + 1;
    }
  }

  if (segStart < path.length) {
    let seg = path.sliceBytes(segStart, path.length);
    if (seg == '..') {
      if (segments.length > 0 && segments[segments.length - 1] != '..') {
        segments.pop();
      } else if (!isAbs) {
        segments.push(seg);
      }
    } else if (seg != '.') {
      segments.push(seg);
    }
  }

  if (segments.length == 0) {
    return if (isAbs) '/' else '.';
  }

  let sb = new StringBuilder();
  if (isAbs) {
    sb.append('/');
  }
  for (var j = 0; j < segments.length; j += 1) {
    if (j > 0) {
      sb.append('/');
    }
    sb.append(segments[j]);
  }
  return sb.toString();
};

/**
 * Returns the directory name of `path`, similar to POSIX dirname.
 * Trailing slashes are ignored.
 *
 * @example
 * ```zena
 * dirname('/a/b/c') // '/a/b'
 * dirname('/a')     // '/'
 * dirname('a/b')    // 'a'
 * dirname('a')      // '.'
 * dirname('/')      // '/'
 * ```
 */
export let dirname = (path: String): String => {
  if (path.length == 0) {
    return '.';
  }

  // Strip trailing slashes
  var end = path.length - 1;
  for (; end > 0 && path.getByteAt(end) == 47; end -= 1) {}
  if (end == 0 && path.getByteAt(0) == 47) {
    return '/';
  }

  // Find the last separator before `end`
  var i = end;
  for (; i >= 0 && path.getByteAt(i) != 47; i -= 1) {}
  if (i < 0) {
    return '.';
  }

  // Strip redundant slashes before the separator
  for (; i > 0 && path.getByteAt(i - 1) == 47; i -= 1) {}
  return if (i == 0) '/' else path.sliceBytes(0, i);
};

/**
 * Returns the last component of `path`, similar to POSIX basename.
 * If `suffix` is provided and the basename ends with `suffix` (and is longer
 * than `suffix`), the suffix is removed.
 *
 * @example
 * ```zena
 * basename('/a/b/c.zena')         // 'c.zena'
 * basename('/a/b/c.zena', '.zena') // 'c'
 * basename('/a/b/')                // 'b'
 * basename('/')                    // '/'
 * ```
 */
export let basename = (path: String, suffix: String = ''): String => {
  if (path.length == 0) {
    return '';
  }

  var end = path.length - 1;
  for (; end > 0 && path.getByteAt(end) == 47; end -= 1) {}
  if (end == 0 && path.getByteAt(0) == 47) {
    return '/';
  }

  var i = end;
  for (; i >= 0 && path.getByteAt(i) != 47; i -= 1) {}
  let base = path.sliceBytes(i + 1, end + 1);
  if (suffix.length > 0 && base.endsWith(suffix) && base.length > suffix.length) {
    return base.sliceBytes(0, base.length - suffix.length);
  }
  return base;
};

/**
 * Returns the extension of `path` from the last '.' to the end of the
 * filename. Returns an empty string if there is no '.' or if the '.' is the
 * first character of the filename (e.g. '.gitignore').
 *
 * @example
 * ```zena
 * extname('foo.zena')     // '.zena'
 * extname('foo.bar.zena') // '.zena'
 * extname('foo')          // ''
 * extname('.gitignore')   // ''
 * extname('foo.')         // '.'
 * ```
 */
export let extname = (path: String): String => {
  let base = basename(path);
  if (base.length == 0 || base == '.' || base == '..') {
    return '';
  }

  var dotIndex = 0 - 1;
  for (var i = base.length - 1; i >= 0; i -= 1) {
    if (base.getByteAt(i) == 46) { // 46 = '.'
      dotIndex = i;
      break;
    }
  }

  if (dotIndex <= 0) {
    return '';
  }
  return base.sliceBytes(dotIndex, base.length);
};

/**
 * Replaces or appends the extension of `path`.
 * If `newExt` does not start with '.', one is automatically added
 * (unless `newExt` is empty, in which case the extension is removed).
 *
 * @example
 * ```zena
 * withExtension('main.wasm', 'cwasm')  // 'main.cwasm'
 * withExtension('main.wasm', '.cwasm') // 'main.cwasm'
 * withExtension('main.wasm', '')       // 'main'
 * withExtension('main', '.wasm')       // 'main.wasm'
 * ```
 */
export let withExtension = (path: String, newExt: String): String => {
  let ext = extname(path);
  let prefix = if (ext.length > 0) {
    path.sliceBytes(0, path.length - ext.length)
  } else {
    path
  };
  let extToAdd = if (newExt.length > 0 && !newExt.startsWith('.')) {
    `.${newExt}`
  } else {
    newExt
  };
  return `${prefix}${extToAdd}`;
};

/**
 * Joins two path segments and normalizes the result.
 * If `b` is an absolute path, it replaces `a`.
 */
export let join2 = (a: String, b: String): String => {
  if (a.length == 0) {
    return normalize(b);
  }
  if (b.length == 0) {
    return normalize(a);
  }
  if (isAbsolute(b)) {
    return normalize(b);
  }
  return normalize(`${a}/${b}`);
};

/**
 * Joins all given path segments together and normalizes the resulting path.
 * If any segment is absolute, preceding segments are ignored.
 */
export let join = (parts: Array<String>): String => {
  let sb = new StringBuilder();
  for (let part in parts) {
    if (part.length > 0) {
      if (isAbsolute(part)) {
        sb.clear();
        sb.append(part);
      } else if (sb.length == 0) {
        sb.append(part);
      } else {
        sb.append('/');
        sb.append(part);
      }
    }
  }
  return normalize(sb.toString());
};

/**
 * Strips `prefix` from `path` if `path` begins with `prefix` at a directory boundary.
 * Returns the remainder (without leading slash), or null if `prefix` does not match.
 *
 * @example
 * ```zena
 * stripPrefix('/a/b/c', '/a/b')  // 'c'
 * stripPrefix('/a/b/c', '/a/b/') // 'c'
 * stripPrefix('/a/bc', '/a/b')   // null
 * stripPrefix('/a/b', '/a/b')    // ''
 * ```
 */
export let stripPrefix = (path: String, prefix: String): String | null => {
  let pNorm = normalize(path);
  let prefNorm = normalize(prefix);
  if (pNorm == prefNorm) {
    return '';
  }
  let prefWithSlash = if (prefNorm.endsWith('/')) prefNorm else `${prefNorm}/`;
  if (pNorm.startsWith(prefWithSlash)) {
    return pNorm.sliceBytes(prefWithSlash.length, pNorm.length);
  }
  return null;
};

/**
 * Computes the relative path from `from` to `to`.
 * If both paths resolve to the same location, returns '.'.
 *
 * @example
 * ```zena
 * relative('/a/b', '/a/b/c/d') // 'c/d'
 * relative('/a/b/c', '/a/b')    // '..'
 * relative('/a/b/c', '/a/d/e')  // '../../d/e'
 * ```
 */
export let relative = (from: String, to: String): String => {
  let fromNorm = normalize(from);
  let toNorm = normalize(to);

  if (fromNorm == toNorm) {
    return '.';
  }

  let fromIsAbs = isAbsolute(fromNorm);
  let toIsAbs = isAbsolute(toNorm);

  if (fromIsAbs != toIsAbs) {
    return toNorm;
  }

  let fromParts = split(fromNorm);
  let toParts = split(toNorm);

  var common = 0;
  for (; common < fromParts.length && common < toParts.length; common += 1) {
    if (fromParts[common].value != toParts[common].value) {
      break;
    }
  }

  let upCount = fromParts.length - common;
  let downCount = toParts.length - common;
  if (upCount == 0 && downCount == 0) {
    return '.';
  }

  let sb = new StringBuilder();
  for (var i = 0; i < upCount; i += 1) {
    if (i > 0) {
      sb.append('/');
    }
    sb.append('..');
  }

  for (var j = common; j < toParts.length; j += 1) {
    if (sb.length > 0) {
      sb.append('/');
    }
    sb.append(toParts[j].value);
  }

  return sb.toString();
};

/**
 * A strongly-typed representation of a filesystem path.
 *
 * `Path` is the base extension class for all path types, extending `String`.
 * It provides methods for path inspection, normalization, extension handling,
 * and navigation.
 *
 * ## Subclasses
 *
 * - `AbsolutePath`: An absolute path starting with `/`.
 * - `RelativePath`: A relative path not starting with `/`.
 * - `PathSegment`: A single non-empty relative component containing no `/`.
 *   (Subclass of `RelativePath`.)
 * - `FilePath`: A path representing a file, with file-specific properties like
 *   `extension`.
 * - `DirectoryPath`: A path representing a directory, with fluent methods
 *   (`file`, `dir`, `directory`) for building child paths.
 *
 * ## Performance Characteristics
 *
 * All path classes are Zena extension classes on `String`. At runtime, they are
 * erased to plain strings with zero heap allocation overhead, no wrappers,
 * and no virtual dispatch.
 */
export extension class Path on String {

  /**
   * Constructs a `Path` from a string.
   *
   * Zero-cost compile-time cast. Performs no runtime validation check and no
   * heap allocation.
   */
  new(value: String) : super(value);

  /**
   * The underlying string value of this path.
   *
   * Zero-cost getter returning the underlying `String` directly.
   */
  value: String {
    get {
      return this as String;
    }
  }

  /**
   * Length of the path in bytes.
   */
  length: i32 {
    get {
      return (this as String).length;
    }
  }

  /**
   * True if this path is absolute (starts with '/').
   */
  isAbsolute: boolean {
    get {
      return isAbsolute(this as String);
    }
  }

  /**
   * Returns a normalized copy of this path, preserving its concrete type.
   */
  normalize(): this {
    return normalize(this as String) as this;
  }

  /**
   * Returns the directory portion of this path.
   */
  dirname(): Path {
    return new Path(dirname(this as String));
  }

  /**
   * Alias for dirname().
   */
  parent(): Path {
    return (this as Path).dirname();
  }

  /**
   * Returns the last component of this path.
   */
  basename(suffix: String = ''): String {
    return basename(this as String, suffix);
  }

  /**
   * Returns the file extension, or '' if none.
   */
  extname(): String {
    return extname(this as String);
  }

  /**
   * Returns a copy with the extension replaced or appended, preserving concrete type.
   */
  withExtension(newExt: String): this {
    return withExtension(this as String, newExt) as this;
  }

  /**
   * Returns a copy with the extension removed, preserving concrete type.
   */
  withoutExtension(): this {
    return withExtension(this as String, '') as this;
  }

  /**
   * Joins a relative path to this path.
   */
  join(rel: RelativePath): Path {
    return new Path(join2(this as String, rel as String));
  }

  /**
   * Splits this path into non-empty segments.
   */
  split(): FixedArray<PathSegment> {
    return split(this as String);
  }

  /**
   * Computes the relative path from this path to `to`.
   */
  relative(to: Path): RelativePath {
    return new RelativePath.unchecked(relative(this as String, to as String));
  }

  /**
   * Strips `prefix` from this path if it begins with `prefix`.
   */
  stripPrefix(prefix: Path): RelativePath | null {
    let result = stripPrefix(this as String, prefix as String);
    if (result != null) {
      return new RelativePath.unchecked(result as String);
    }
    return null;
  }

  /**
   * Converts this path to an `AbsolutePath`.
   *
   * Performs a runtime check to verify the path starts with '/'.
   * Zero heap allocation (extension classes are erased at runtime).
   *
   * @throws Error If this path is not absolute (does not start with '/').
   */
  toAbsolutePath(): AbsolutePath {
    return new AbsolutePath(this as String);
  }

  /**
   * Converts this path to a `RelativePath`.
   *
   * Performs a runtime check to verify the path does not start with '/'.
   * Zero heap allocation (extension classes are erased at runtime).
   *
   * @throws Error If this path is absolute (starts with '/').
   */
  toRelativePath(): RelativePath {
    return new RelativePath(this as String);
  }

  /**
   * Converts this path to a `FilePath`.
   *
   * Zero-cost compile-time cast. Performs no runtime validation check and no
   * heap allocation.
   */
  toFilePath(): FilePath {
    return new FilePath(this as String);
  }

  /**
   * Converts this path to a `DirectoryPath`.
   *
   * Zero-cost compile-time cast. Performs no runtime validation check and no
   * heap allocation.
   */
  toDirectoryPath(): DirectoryPath {
    return new DirectoryPath(this as String);
  }

  /**
   * Returns the underlying string.
   *
   * Zero-cost erased cast returning the underlying `String` directly with no
   * copy or allocation.
   */
  toString(): String {
    return this as String;
  }
}

/**
 * An absolute filesystem path (starts with '/').
 *
 * Subclass of `Path`. Enforces that the path begins with a leading forward slash.
 */
export extension class AbsolutePath extends Path {

  /**
   * Constructs an `AbsolutePath`, validating that `value` starts with '/'.
   *
   * Performs a runtime check. Zero heap allocation (erased at runtime).
   *
   * @throws Error If `value` does not start with '/'.
   */
  new(value: String) : super(value) {
    if (!isAbsolute(value)) {
      throw new Error(`Expected absolute path starting with '/', got '${value}'`);
    }
  }

  /**
   * Constructs an `AbsolutePath` without runtime validation.
   *
   * Use when `value` is already known to start with '/'.
   * Zero-cost compile-time cast with no runtime check and no allocation.
   */
  new unchecked(value: String) : super(value);

  /**
   * Joins a relative path to this absolute path, producing an AbsolutePath.
   */
  join(rel: RelativePath): AbsolutePath {
    return new AbsolutePath.unchecked(join2(this as String, rel as String));
  }

  /**
   * Returns the directory portion of this path as an AbsolutePath.
   */
  dirname(): AbsolutePath {
    return new AbsolutePath.unchecked(dirname(this as String));
  }

  /**
   * Alias for dirname().
   */
  parent(): AbsolutePath {
    return (this as AbsolutePath).dirname();
  }

  /**
   * Returns this path as an `AbsolutePath`.
   *
   * Zero-cost identity operation (`return this;`). Performs no runtime check
   * and no allocation.
   */
  toAbsolutePath(): AbsolutePath {
    return this;
  }
}

/**
 * A relative filesystem path (does not start with '/').
 *
 * Subclass of `Path`. Enforces that the path does not begin with a leading
 * forward slash.
 */
export extension class RelativePath extends Path {

  /**
   * Constructs a `RelativePath`, validating that `value` does not start with '/'.
   *
   * Performs a runtime check. Zero heap allocation (erased at runtime).
   *
   * @throws Error If `value` starts with '/'.
   */
  new(value: String) : super(value) {
    if (isAbsolute(value)) {
      throw new Error(`Expected relative path not starting with '/', got '${value}'`);
    }
  }

  /**
   * Constructs a `RelativePath` without runtime validation.
   *
   * Use when `value` is already known not to start with '/'.
   * Zero-cost compile-time cast with no runtime check and no allocation.
   */
  new unchecked(value: String) : super(value);

  /**
   * Joins a relative path to this relative path, producing a RelativePath.
   */
  join(rel: RelativePath): RelativePath {
    return new RelativePath.unchecked(join2(this as String, rel as String));
  }

  /**
   * Returns the directory portion of this path as a RelativePath.
   */
  dirname(): RelativePath {
    return new RelativePath.unchecked(dirname(this as String));
  }

  /**
   * Alias for dirname().
   */
  parent(): RelativePath {
    return (this as RelativePath).dirname();
  }

  /**
   * Returns this path as a `RelativePath`.
   *
   * Zero-cost identity operation (`return this;`). Performs no runtime check
   * and no allocation.
   */
  toRelativePath(): RelativePath {
    return this;
  }
}

/**
 * A single path segment (non-empty, contains no '/').
 *
 * Subclass of `RelativePath`. Represents an individual component within a path.
 */
export extension class PathSegment extends RelativePath {

  /**
   * Constructs a `PathSegment`, validating that `value` is non-empty and
   * contains no '/'.
   *
   * Performs a runtime check. Zero heap allocation (erased at runtime).
   *
   * @throws Error If `value` is empty or contains '/'.
   */
  new(value: String) : super(value) {
    if (value.length == 0 || value.contains('/')) {
      throw new Error(`Invalid path segment: '${value}' contains '/' or is empty`);
    }
  }

  /**
   * Constructs a `PathSegment` without runtime validation.
   *
   * Use when `value` is already known to be a non-empty string with no '/'.
   * Zero-cost compile-time cast with no runtime check and no allocation.
   */
  new unchecked(value: String) : super(value);

  /** A single segment splits into an array containing only itself. */
  split(): FixedArray<PathSegment> {
    return [this as PathSegment];
  }
}

/**
 * A strongly-typed filesystem path representing a file.
 *
 * Subclass of `Path`. Provides access to file-specific properties like
 * `extension`.
 */
export extension class FilePath extends Path {
  
  /**
   * Constructs a `FilePath` from a string.
   *
   * Zero-cost compile-time cast. Performs no runtime validation check and no
   * heap allocation.
   */
  new(value: String) : super(value);

  /**
   * The file extension (including leading dot), or '' if none.
   */
  extension: String {
    get {
      return extname(this as String);
    }
  }
}

/**
 * A strongly-typed filesystem path representing a directory.
 *
 * Subclass of `Path`. Provides convenience methods for navigating and creating
 * child paths.
 */
export extension class DirectoryPath extends Path {

  /**
   * Constructs a `DirectoryPath` from a string.
   *
   * Zero-cost compile-time cast. Performs no runtime validation check and no
   * heap allocation.
   */
  new(value: String) : super(value);

  /**
   * Joins a child path segment to this directory.
   */
  join(segment: String): Path {
    return new Path(join2(this as String, segment));
  }

  /**
   * Joins a file name to this directory, returning a FilePath.
   */
  file(name: String): FilePath {
    return new FilePath(join2(this as String, name));
  }

  /**
   * Joins a child directory name to this directory, returning a DirectoryPath.
   */
  dir(name: String): DirectoryPath {
    return new DirectoryPath(join2(this as String, name));
  }

  /**
   * Joins a child directory name to this directory, returning a DirectoryPath.
   */
  directory(name: String): DirectoryPath {
    return new DirectoryPath(join2(this as String, name));
  }
}
