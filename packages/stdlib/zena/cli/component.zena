/**
 * Command-line interface support over WASI 0.3, for the component
 * target: arguments, environment variables, the working directory and
 * process exit, over `wasi:cli@0.3.0` as the compiler synthesizes it
 * from the vendored WIT.
 *
 * ## Examples
 *
 * ```zena
 * import { getArguments, getEnv, exit } from 'zena:cli';
 *
 * let args = getArguments();
 * let home = getEnv('HOME');
 * if (args.length < 2) {
 *   console.error('usage: tool <file>');
 *   exit(2);
 * }
 * ```
 */

import { Some, StringBuilder } from 'zena:core';
import { Stream } from 'zena:stream';
import { blockOn } from 'zena:wasi';
import {
  getArguments as witGetArguments, getEnvironment as witGetEnvironment,
  getInitialCwd,
} from 'wasi:cli/environment';
import { exitWithCode } from 'wasi:cli/exit';
import { readViaStream } from 'wasi:cli/stdin';

// ============================================================================
// Standard input
// ============================================================================

var __stdin: Stream<u8> | null = null;

/**
 * The program's standard input, as a stream of bytes. It is opened on
 * the first call and the same stream is returned after that: standard
 * input can be read only once.
 */
export let stdin = (): Stream<u8> => {
  let open = __stdin;
  if (open != null) {
    return open;
  }
  let (stream, done) = readViaStream();
  __stdin = stream;
  return stream;
};

/**
 * Waits for standard input to have something, and returns up to `max`
 * bytes of it as a string of those bytes; '' at the end of the input.
 *
 * ```zena
 * var chunk = readStdin();
 * while (chunk != '') {
 *   handle(chunk);
 *   chunk = readStdin();
 * }
 * ```
 */
export let readStdin = (max: i32 = 4096): String => {
  let buffer = new FixedArray<u8>(max, 0 as u8);
  let count = blockOn(stdin().read(buffer));
  let text = new StringBuilder();
  for (var i = 0; i < count; i += 1) {
    text.appendByte(buffer[i] as i32);
  }
  return text.toString();
};

// ============================================================================
// Exit Codes
// ============================================================================

/** Conventional exit statuses. */
export enum ExitCode {
  /** Successful program termination (code 0). */
  Success,
  /** Generic failure (code 1). */
  Failure,
  /** Invalid command-line arguments (code 2). */
  InvalidArguments,
  /** Resource not found (code 3). */
  NotFound,
  /** Permission denied (code 4). */
  PermissionDenied,
  /** I/O error (code 5). */
  IoError,
}

// ============================================================================
// Environment
// ============================================================================

/** An environment variable. */
export type EnvVar = {
  name: String,
  value: String,
};

/** Every environment variable, as name and value pairs. */
export let getEnvironment = (): Array<EnvVar> => {
  let result = new Array<EnvVar>();
  for (let (name, value) in witGetEnvironment()) {
    result.push({ name: name, value: value });
  }
  return result;
};

/** The value of an environment variable, or null when it is unset. */
export let getEnv = (name: String): String | null => {
  for (let (envName, value) in witGetEnvironment()) {
    if (envName == name) {
      return value;
    }
  }
  return null;
};

/** The command-line arguments, the program's name first. */
export let getArguments = (): Array<String> => witGetArguments();

/** The program's name: the first argument, or '' without one. */
export let getProgramName = (): String => {
  let args = getArguments();
  if (args.length > 0) {
    return args[0];
  }
  return '';
};

/** The directory the program was started in, when the host says. */
export let initialCwd = (): String | null => {
  let cwd = getInitialCwd();
  if (cwd is Some<String>) {
    return (cwd as Some<String>).value;
  }
  return null;
};

// ============================================================================
// Process Exit
// ============================================================================

/** End the program with an exit status. Does not return. */
export let exit = (code: i32): void => {
  exitWithCode(code as u8);
};

/** End the program successfully. */
export let exitSuccess = (): void => {
  exitWithCode(0 as u8);
};

/** End the program with the generic failure status. */
export let exitFailure = (): void => {
  exitWithCode(1 as u8);
};

