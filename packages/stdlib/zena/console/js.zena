// Console Standard Library - JavaScript Target Implementation
// Provides a JavaScript console API for logging via host imports

import { Console } from './interface.zena';

export * from './interface.zena';

@external("console", "log_i32")
declare function __console_log_i32(val: i32): void;

@external("console", "log_f32")
declare function __console_log_f32(val: f32): void;

@external("console", "log_string")
declare function __console_log_string(s: externref): void;

@external("console", "error_string")
declare function __console_error_string(s: externref): void;

@external("console", "warn_string")
declare function __console_warn_string(s: externref): void;

@external("console", "info_string")
declare function __console_info_string(s: externref): void;

@external("console", "debug_string")
declare function __console_debug_string(s: externref): void;

export class HostConsole implements Console {
  log<T>(message: T): void {
    __console_log_string(toString(message).handle);
  }

  error<T>(message: T): void {
    __console_error_string(toString(message).handle);
  }

  warn<T>(message: T): void {
    __console_warn_string(toString(message).handle);
  }

  info<T>(message: T): void {
    __console_info_string(toString(message).handle);
  }

  debug<T>(message: T): void {
    __console_debug_string(toString(message).handle);
  }
}

export let console = new HostConsole();

export let log = (val: i32) => {
  __console_log_i32(val);
};

export let logF32 = (val: f32) => {
  __console_log_f32(val);
};

export let logString = (val: String) => {
  __console_log_string(val.handle);
};

