/**
 * No-op `Console` implementation for `--target js`, where no host console
 * imports are assumed beyond `wasm:js-string`.
 */

import { Console } from './interface.zena';

export * from './interface.zena';

export class NoopConsole implements Console {
  log<T>(_message: T): void {}

  error<T>(_message: T): void {}

  warn<T>(_message: T): void {}

  info<T>(_message: T): void {}

  debug<T>(_message: T): void {}
}

export let console = new NoopConsole();

export function logString(_val: String): void {}
