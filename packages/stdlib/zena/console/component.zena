// Console Standard Library - Component Implementation
//
// Prints through WASI p3 stdio: `wasi:cli/stdout@0.3.0` takes a
// `stream<u8>` the guest creates, and the bytes flow through
// `zena:component-stream`'s blocking writer. The import declarations
// here are core-shaped in the compiler's eyes — a stream end and a
// future are handle `i32`s on the wire, spelled with
// `component-stream`'s handle types — and the compiler knows these
// interfaces' real WIT (`wasi-interfaces.zena`), emitting the true
// instance types.
//
// One stream per standard stream, created on first use and handed to
// the host once: `write-via-stream(readable)` registers the readable
// end, and every later print is a blocking write on the kept writable
// end. Blocking is what a console wants — output ordered with the
// program, no event loop required to print, exactly as every other
// target's console blocks; how a blocked write waits is
// `zena:component-stream`'s business. The returned outcome future is
// deliberately not read: a console cannot report stdout's failure to
// stdout, and the write itself already fails loudly when the host end
// is gone. The handle it leaks is one per standard stream per program.

import { String } from 'zena:string';
import {
  ByteStreamPair, ReadableByteStream, WritableByteStream,
  newByteStreamPair, writeStringBlocking
} from 'zena:component-stream';
import { Console } from './interface.zena';

export * from './interface.zena';

/** The outcome future's handle, unread by design (header). */
@external("wasi:cli/stdout@0.3.0", "write-via-stream")
declare function stdoutWriteViaStream(data: ReadableByteStream): i32;

@external("wasi:cli/stderr@0.3.0", "write-via-stream")
declare function stderrWriteViaStream(data: ReadableByteStream): i32;

/** The kept streams, each created and registered on first use. */
var stdoutPair: ByteStreamPair | null = null;
var stderrPair: ByteStreamPair | null = null;

let stdoutEnd = (): WritableByteStream => {
  let existing = stdoutPair;
  if (existing != null) {
    return (existing as ByteStreamPair).writable;
  }
  let pair = newByteStreamPair();
  stdoutWriteViaStream(pair.readable);
  stdoutPair = pair;
  return pair.writable;
};

let stderrEnd = (): WritableByteStream => {
  let existing = stderrPair;
  if (existing != null) {
    return (existing as ByteStreamPair).writable;
  }
  let pair = newByteStreamPair();
  stderrWriteViaStream(pair.readable);
  stderrPair = pair;
  return pair.writable;
};

// ComponentConsole - the p3 stdio implementation
export class ComponentConsole implements Console {
  log(message: String): void {
    writeStringBlocking(stdoutEnd(), message, true);
  }

  error(message: String): void {
    writeStringBlocking(stderrEnd(), message, true);
  }

  warn(message: String): void {
    writeStringBlocking(stderrEnd(), message, true);
  }

  info(message: String): void {
    writeStringBlocking(stdoutEnd(), message, true);
  }

  debug(message: String): void {
    writeStringBlocking(stdoutEnd(), message, true);
  }
}

// Global console instance - connected to p3 stdio
export let console = new ComponentConsole();

/** Write without the newline, mirroring the other targets' helper. */
export let logString = (val: String) => {
  writeStringBlocking(stdoutEnd(), val, false);
};
