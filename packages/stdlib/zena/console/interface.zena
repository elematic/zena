/**
 * Standard output and error logging utilities.
 *
 * Provides the global `console` instance for writing informational, warning,
 * and error messages to standard output and standard error streams.
 *
 * ## Examples
 *
 * ```zena
 * import { console } from 'zena:console';
 *
 * console.log('Hello, world!');
 * console.error('An error occurred');
 * ```
 */

/**
 * Standard output and error logging interface.
 */
export interface Console {
  /** Logs an informational message to standard output. */
  log<T>(message: T): void;

  /** Logs an error message to standard error. */
  error<T>(message: T): void;

  /** Logs a warning message to standard error. */
  warn<T>(message: T): void;

  /** Logs an informational message to standard output. */
  info<T>(message: T): void;

  /** Logs a debug message to standard output. */
  debug<T>(message: T): void;
}
