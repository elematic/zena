/**
 * `sinh`, `cosh`, `tanh`, `asinh`, `acosh` and `atanh`, ported from
 * musl's `sinh.c`, `cosh.c`, `tanh.c`, `asinh.c`, `acosh.c`, `atanh.c`
 * and `__expo2.c` (MIT licensed; see musl's COPYRIGHT).
 *
 * They are written in terms of `exp`, `expm1`, `log` and `log1p`, with
 * the identities chosen so that nothing cancels. The direct functions
 * are under 1 ulp; `tanh` is within 2 ulp on [0.1, 0.2554], `asinh`
 * within 1.6 ulp on [0.125, 0.5], `acosh` within 2 ulp on [1, 1.125] and
 * `atanh` within 1.7 ulp below 0.5.
 */

import { bits, fromBits, fsqrt, highWord, pow2 } from './float-bits.zena';
import { exp, expm1 } from './exp.zena';
import { log, log1p } from './log.zena';

let LN2 = 0.6931471805599453; // 0x3fe62e42fefa39ef
let ABS_MASK: i64 = 0x7fffffffffffffff;

/**
 * `exp(|x|) / 2` for `|x| > log(DBL_MAX)`, without overflowing before
 * the result does: `exp(x - k ln2) * 2^(k - 1)` with `k = 2043`, chosen
 * so that `k ln2` has minimal relative error and `x - k ln2 > log(DBL_MIN)`.
 */
function expo2(x: f64) {
  let kln2 = fromBits(0x40962066151add8b); // 2043 * ln2
  let scale = pow2(1021); // k is odd, and scale * scale overflows
  return exp(x - kln2) * scale * scale;
}

/** The hyperbolic sine of `x`. */
export function sinh(x: f64): f64 {
  var h = 0.5;
  if (bits(x) < 0) {
    h = -h;
  }
  let absx = fromBits(bits(x) & ABS_MASK);
  let w = highWord(absx);
  if (w < 0x40862e42) {
    // |x| < log(DBL_MAX)
    let t = expm1(absx);
    if (w < 0x3ff00000) {
      if (w < 0x3ff00000 - (26 << 20)) {
        return x; // |x| < 2^-26, avoiding spurious underflow
      }
      return h * (2.0 * t - t * t / (t + 1.0));
    }
    return h * (t + t / (t + 1.0));
  }
  // |x| > log(DBL_MAX) or NaN
  return 2.0 * h * expo2(absx);
}

export function sinh(x: f32): f32 {
  return sinh(x as f64) as f32;
}

/** The hyperbolic cosine of `x`. */
export function cosh(x: f64): f64 {
  let absx = fromBits(bits(x) & ABS_MASK);
  let w = highWord(absx);
  if (w < 0x3fe62e42) {
    // |x| < log(2)
    if (w < 0x3ff00000 - (26 << 20)) {
      return 1.0; // |x| < 2^-26
    }
    let t = expm1(absx);
    return 1.0 + t * t / (2.0 * (1.0 + t));
  }
  if (w < 0x40862e42) {
    // |x| < log(DBL_MAX)
    let t = exp(absx);
    return 0.5 * (t + 1.0 / t);
  }
  // |x| > log(DBL_MAX) or NaN
  return expo2(absx);
}

export function cosh(x: f32): f32 {
  return cosh(x as f64) as f32;
}

/** The hyperbolic tangent of `x`, in [-1, 1]. */
export function tanh(x: f64): f64 {
  let sign = bits(x) < 0;
  let absx = fromBits(bits(x) & ABS_MASK);
  let w = highWord(absx);
  var t = 0.0;
  if (w > 0x3fe193ea) {
    // |x| > log(3)/2 ~= 0.5493 or NaN
    if (w > 0x40340000) {
      // |x| > 20 or NaN, without raising overflow
      t = 1.0 - 0.0 / absx;
    } else {
      t = expm1(2.0 * absx);
      t = 1.0 - 2.0 / (t + 2.0);
    }
  } else if (w > 0x3fd058ae) {
    // |x| > log(5/3)/2 ~= 0.2554
    t = expm1(2.0 * absx);
    t = t / (t + 2.0);
  } else if (w >= 0x00100000) {
    // |x| >= 2^-1022, up to 2 ulp of error in [0.1, 0.2554]
    t = expm1(-2.0 * absx);
    t = -t / (t + 2.0);
  } else {
    // |x| is subnormal
    t = absx;
  }
  return if (sign) -t else t;
}

export function tanh(x: f32): f32 {
  return tanh(x as f64) as f32;
}

/** The inverse hyperbolic sine of `x`. */
export function asinh(x0: f64): f64 {
  let u = bits(x0);
  let e = ((u >> 52) as i32) & 0x7ff;
  let sign = u < 0;
  var x = fromBits(u & ABS_MASK);
  if (e >= 0x3ff + 26) {
    // |x| >= 2^26, inf or NaN
    x = log(x) + LN2;
  } else if (e >= 0x3ff + 1) {
    // |x| >= 2
    x = log(2.0 * x + 1.0 / (fsqrt(x * x + 1.0) + x));
  } else if (e >= 0x3ff - 26) {
    // |x| >= 2^-26, up to 1.6 ulp of error in [0.125, 0.5]
    x = log1p(x + x * x / (fsqrt(x * x + 1.0) + 1.0));
  }
  // |x| < 2^-26: asinh(x) = x
  return if (sign) -x else x;
}

export function asinh(x: f32): f32 {
  return asinh(x as f64) as f32;
}

/**
 * The inverse hyperbolic cosine of `x`, for `x >= 1`. `acosh` of a
 * number below 1 is NaN.
 */
export function acosh(x: f64): f64 {
  let ux = bits(x);
  let e = ((ux >> 52) as i32) & 0x7ff;
  if (e < 0x3ff + 1) {
    // |x| < 2, invalid if x < 1; up to 2 ulp of error in [1, 1.125]
    let x1 = x - 1.0;
    return log1p(x1 + fsqrt(x1 * x1 + 2.0 * x1));
  }
  if (e < 0x3ff + 26 && ux >= 0) {
    // 2 <= x < 2^26
    return log(2.0 * x - 1.0 / (x + fsqrt(x * x - 1.0)));
  }
  // x >= 2^26, x <= -2, or NaN
  return log(x) + LN2;
}

export function acosh(x: f32): f32 {
  return acosh(x as f64) as f32;
}

/**
 * The inverse hyperbolic tangent of `x`, for `x` in [-1, 1]. `atanh(+-1)`
 * is +-infinity, and `atanh` of a number outside [-1, 1] is NaN.
 */
export function atanh(x: f64): f64 {
  let u = bits(x);
  let e = ((u >> 52) as i32) & 0x7ff;
  let sign = u < 0;
  var y = fromBits(u & ABS_MASK);
  if (e < 0x3ff - 1) {
    if (e >= 0x3ff - 32) {
      // 2^-32 <= |x| < 0.5, up to 1.7 ulp of error
      y = 0.5 * log1p(2.0 * y + 2.0 * y * y / (1.0 - y));
    }
    // |x| < 2^-32: atanh(x) = x
  } else {
    // avoid overflow
    y = 0.5 * log1p(2.0 * (y / (1.0 - y)));
  }
  return if (sign) -y else y;
}

export function atanh(x: f32): f32 {
  return atanh(x as f64) as f32;
}
