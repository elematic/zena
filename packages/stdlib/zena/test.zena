/**
 * Test framework for structuring and running test suites.
 *
 * Provides `suite` and `test` functions to define hierarchical test suites,
 * executed through the Zena CLI test runner (`zena test`).
 *
 * A test's body is synchronous, or `async`: an asynchronous body is
 * awaited before the next test starts, and a failure anywhere in it,
 * before or after an `await`, is the test's failure. Tests run one at
 * a time, in the order they were registered.
 *
 * ## Examples
 *
 * ```zena
 * import { suite, test, TestContext } from 'zena:test';
 * import { equal } from 'zena:assert';
 * import { readFile } from 'zena:fs';
 *
 * export let tests = suite('Math', () => {
 *   test('addition', (ctx: TestContext) => {
 *     equal(1 + 1, 2);
 *   });
 *
 *   test('a file', async (ctx: TestContext) => {
 *     equal(await readFile('two.txt'), '2');
 *   });
 * });
 * ```
 */

import { StringBuilder, StringReader } from 'zena:core';

/**
 * Test context passed to each test function
 */
export class TestContext {
  name: String;

  new(name: String) : name = name;
}

/**
 * Result of a single test execution
 */
export class TestResult {
  name: String;
  passed: boolean;
  error: String | null;

  new(this.name: String, this.passed: boolean, this.error: String | null);
}

// Result of running a suite
export class SuiteResult {
  name: String;
  tests = new Array<TestResult>();
  suites = new Array<SuiteResult>();
  var passed = 0;
  var failed = 0;

  new(this.name: String);

  addTestResult(result: TestResult): void {
    this.tests.push(result);
    if (result.passed) {
      this.passed = this.passed + 1;
    } else {
      this.failed = this.failed + 1;
    }
  }

  addSuiteResult(result: SuiteResult): void {
    this.suites.push(result);
    this.passed = this.passed + result.passed;
    this.failed = this.failed + result.failed;
  }
}

/** A test's body: synchronous, or asynchronous and awaited. */
sealed class TestBody {
  case Synchronous(fn: (ctx: TestContext) => void)
  case Asynchronous(fn: (ctx: TestContext) => Future<void>)
}

/** What a failed test reports: the error's message and, when it has
 * one, its stack trace. */
function describeFailure(e: anyref) {
  if (e is Error) {
    let stack = e.getStackTrace();
    if (stack != null) {
      return `${e.message}\n${stack}`;
    }
    return e.message;
  }
  return "Unknown error";
}

/**
 * A single test case
 */
class TestCase {
  name: String;
  body: TestBody;
  only: boolean;
  skip: boolean;

  new(
    this.name: String,
    this.body: TestBody,
    this.only: boolean,
    this.skip: boolean);

  async run(): Future<TestResult> {
    let ctx = new TestContext(this.name);
    let body = this.body;
    try {
      if (body is Asynchronous) {
        await body.fn(ctx);
      } else if (body is Synchronous) {
        body.fn(ctx);
      }
    } catch (e) {
      return new TestResult(this.name, false, describeFailure(e));
    }
    return new TestResult(this.name, true, null);
  }
}

/**
 * A test suite containing tests and nested suites
 */
export class Suite {
  name: String;
  tests = new Array<TestCase>();
  suites = new Array<Suite>();
  var hasOnly = false;

  new(this.name: String);

  /**
   * Runs the suite's tests, then its nested suites, one at a time and
   * in order, and returns what each did.
   */
  async run(): Future<SuiteResult> {
    let result = new SuiteResult(this.name);
    
    // Check if any test has .only
    let runOnlyTests = this.hasOnly;
    
    // Run tests
    for (let testCase in this.tests) {
      // Skip tests that are explicitly skipped
      if (testCase.skip) {
        continue;
      }
      // Skip non-only tests if we have .only tests
      let shouldRun = !runOnlyTests || testCase.only;
      if (shouldRun) {
        let testResult = await testCase.run();
        result.addTestResult(testResult);
      }
    }
    
    // Run nested suites
    for (let nestedSuite in this.suites) {
      let suiteResult = await nestedSuite.run();
      result.addSuiteResult(suiteResult);
    }
    
    return result;
  }
}

// Current suite for nested test/suite registration
var currentSuite: Suite | null = null;

function register(name: String, body: TestBody, only: boolean, skip: boolean) {
  if (currentSuite !== null) {
    currentSuite.tests.push(new TestCase(name, body, only, skip));
    if (only) {
      currentSuite.hasOnly = true;
    }
  }
}

/**
 * Register a test in the current suite
 */
export function test(name: String, fn: (ctx: TestContext) => void): void {
  register(name, new Synchronous(fn), false, false);
}

/**
 * Register a test whose body is asynchronous. The next test starts
 * once the body's future has settled.
 */
export function test(name: String, fn: (ctx: TestContext) => Future<void>): void {
  register(name, new Asynchronous(fn), false, false);
}

/**
 * Register a test that will be the only one to run (for debugging)
 */
export function testOnly(name: String, fn: (ctx: TestContext) => void): void {
  register(name, new Synchronous(fn), true, false);
}

export function testOnly(name: String, fn: (ctx: TestContext) => Future<void>): void {
  register(name, new Asynchronous(fn), true, false);
}

/**
 * Register a test that will be skipped
 */
export function testSkip(name: String, fn: (ctx: TestContext) => void): void {
  register(name, new Synchronous(fn), false, true);
}

export function testSkip(name: String, fn: (ctx: TestContext) => Future<void>): void {
  register(name, new Asynchronous(fn), false, true);
}

/**
 * Create a test suite
 */
export function suite(name: String, fn: () => void): Suite {
  let parentSuite = currentSuite;
  let newSuite = new Suite(name);
  if (parentSuite !== null) {
    parentSuite.suites.push(newSuite);
  }
  currentSuite = newSuite;
  fn();
  // Propagate hasOnly up to parent suite
  if (newSuite.hasOnly) {
    if (parentSuite !== null) {
      parentSuite.hasOnly = true;
    }
  }
  currentSuite = parentSuite;
  return newSuite;
}

// ============================================================================
// Reporting
// ============================================================================

// Format a duration in milliseconds for display
function formatDuration(ms: i32) {
  if (ms < 1000) {
    return `${ms}ms`;
  }
  let secs = ms / 1000;
  let remainder = ms % 1000;
  return `${secs}.${remainder}s`;
}

// Build an indentation string (2 spaces per level)
function indent(level: i32) {
  let sb = new StringBuilder(level * 2);
  var i = 0;
  while (i < level) {
    sb.append('  ');
    i += 1;
  }
  return sb.toString();
}

let RED = "\\x1b[31m";
let GREEN = "\\x1b[32m";
let DIM = "\\x1b[2m";
let NC = "\\x1b[0m";

// Report a suite result tree to a write function (spec reporter style).
// The write function is called once per line of output.
function reportFailedTests(result: SuiteResult, write: (s: String) => void, path: GrowableArray<String>): void {
  // Add this suite to the path
  path.push(result.name);

  // Build path prefix directly since Array.join is not available
  let sb = new StringBuilder(64);
  for (var i = 0; i < path.length; i += 1) {
    if (i > 0) {
      sb.append(' > ');
    }
    sb.append(path[i]);
  }
  let pathPrefix = sb.toString();

  // Print failed tests in this suite
  for (let t in result.tests) {
    if (!t.passed) {
      write(`${RED}✖ ${pathPrefix} > ${t.name}${NC}`);
      if (t.error !== null) {
        let r = new StringReader(t.error as String);
        while (!r.isAtEnd) {
          let lineStart = r.mark();
          while (!r.isAtEnd && r.peekByte() != 10) { // 10 = '\n'
            r.advanceByte();
          }
          let line = r.sliceFrom(lineStart);
          let displayLine = if (line.endsWith("\r")) {
            line.sliceBytes(0, line.length - 1)
          } else {
            line
          };
          write(`    ${DIM}${displayLine}${NC}`);
          if (r.peekByte() == 10) {
            r.advanceByte();
          }
        }
      }
    }
  }

  // Recurse into nested suites
  for (let suite in result.suites) {
    reportFailedTests(suite, write, path);
  }

  // Remove this suite from the path
  path.pop();
}

// Format a summary of all test failures across all suites.
function reportSummary(result: SuiteResult, write: (s: String) => void) {
  if (result.failed == 0) {
    return;
  }
  write(`\n${RED}FAILURES:${NC}`);
  let path = new Array<String>(4);
  reportFailedTests(result, write, path);
}

/**
 * Run a suite, print results, and return the number of failures.
 * This is the standard entry point for test runners.
 *
 * Usage in a test wrapper:
 *   import { tests } from './my_test.zena';
 *   import { runAndReport } from 'zena:test';
 *   export async function main(): Future<i32> {
 *     return await runAndReport(tests, console.log);
 *   }
 */
export async function runAndReport(s: Suite, write: (s: String) => void): Future<i32> {
  let result = await s.run();

  // We only print the failures now instead of the full tree to avoid flooding
  reportSummary(result, write);

  // Print summary
  let total = result.passed + result.failed;
  write('');
  if (result.failed == 0) {
    write(`${GREEN}✓ ${result.passed} of ${total} test(s) passed${NC}`);
  } else {
    write(`${RED}✗ ${result.failed} failed, ${result.passed} passed of ${total} test(s)${NC}`);
  }

  return result.failed;
}
