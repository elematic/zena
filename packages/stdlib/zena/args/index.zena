/**
 * Command-line argument parsing with flags, typed options, positional
 * arguments, subcommands, and `--help` formatting.
 *
 * ## Examples
 *
 * Configure an `ArgParser` with a `ParserConfig` record:
 *
 * ```zena
 * import { ArgParser, OptionType } from 'zena:args';
 * import { getArguments } from 'zena:cli';
 *
 * let parser = new ArgParser({
 *   name: 'mytool',
 *   help: 'Compile and run files',
 *   options: {
 *     'verbose' => {type: OptionType.Flag, abbr: 'v', help: 'Enable verbose logging'},
 *     'output' => {abbr: 'o', defaultVal: 'out.txt', help: 'Output file path'},
 *   },
 *   commands: {
 *     'build' => {
 *       help: 'Compile a project',
 *       options: {
 *         'target' => {abbr: 't', allowed: ['wasm', 'js'], defaultVal: 'wasm'},
 *       },
 *     },
 *   },
 * });
 *
 * let parsed = parser.parse(getArguments(), 1);
 * let verbose = parsed.getFlag('verbose');
 * let output = parsed.getOption('output') ?? 'out.txt';
 * ```
 *
 * For scripts that do not need help formatting or a reusable `ArgParser`,
 * call `parseArgs` directly:
 *
 * ```zena
 * import { OptionType, parseArgs } from 'zena:args';
 * import { getArguments } from 'zena:cli';
 *
 * let parsed = parseArgs(getArguments(), {
 *   options: {
 *     'quiet' => {type: OptionType.Flag, abbr: 'q'},
 *     'count' => {type: OptionType.Int, abbr: 'n', defaultVal: '1'},
 *   },
 * }, 1);
 * ```
 */

import { StringBuilder, StringReader, growable, join } from 'zena:core';
import { OrderedHashMap } from 'zena:collections';

/**
 * A parsed command-line option value.
 */
export sealed class ParsedValue {
  /** A boolean flag value. */
  case Flag(value: boolean)

  /** A single option value, used for `OptionType.StringVal` and `OptionType.Int`. */
  case Single(value: String)

  /** All values passed for a repeatable `OptionType.MultiString` option, in order. */
  case Multi(values: GrowableArray<String>)
}

/**
 * The kind of value a command-line option accepts.
 */
export enum OptionType {
  /** A single string value (`--opt <val>`, `--opt=<val>`, `-o <val>`). The default. */
  StringVal,

  /** A boolean toggle (`--flag`, `-f`, `--no-flag`). */
  Flag,

  /** A 32-bit integer value (`--count 42`), read as `i32` with `ParsedArgs.getInt`. */
  Int,

  /** A repeatable string option collecting every passed value (`--dir <val>`). */
  MultiString,
}

/**
 * Configuration for a command-line option.
 */
export type OptionConfig = {
  /** The kind of value the option accepts. Defaults to `OptionType.StringVal`. */
  type?: OptionType,

  /** Single-character short alias, such as `'v'` for `-v`. */
  abbr?: String,

  /** Default value used when the option is not passed on the command line. */
  defaultVal?: String,

  /** Permitted values for the option; `ArgParser.parse` throws if a value is not listed. */
  allowed?: Array<String>,

  /** Help text shown next to the option in `ArgParser.formatHelp`. */
  help?: String,
};

/**
 * Configuration for a subcommand.
 */
export type CommandConfig = {
  /**
   * Help text for the subcommand. A parent parser's `Commands:` table shows
   * the first line; the subcommand's own `formatHelp` shows the full text.
   */
  help?: String,

  /** Options accepted by the subcommand, keyed by long option name. */
  options?: Map<String, OptionConfig>,

  /** Nested subcommands under this subcommand, keyed by command name. */
  commands?: Map<String, CommandConfig>,

  /**
   * Whether to stop parsing options at the first positional argument, placing
   * all subsequent arguments in `ParsedArgs.rest` even when they start with
   * `-`. Useful for commands that forward trailing arguments to another
   * program (`mytool run prog.zena --verbose`).
   */
  stopAtPositional?: boolean,
};

/**
 * Configuration for an `ArgParser`.
 */
export type ParserConfig = {
  /** Program name shown in the `Usage:` line of `ArgParser.formatHelp`. */
  name?: String,

  /** Help text shown below the `Usage:` line in `ArgParser.formatHelp`. */
  help?: String,

  /** Options accepted by the parser, keyed by long option name. */
  options?: Map<String, OptionConfig>,

  /** Subcommands dispatched by the parser, keyed by command name. */
  commands?: Map<String, CommandConfig>,

  /**
   * Whether to stop parsing options at the first positional argument.
   * See `CommandConfig.stopAtPositional`.
   */
  stopAtPositional?: boolean,
};

/**
 * The result of parsing command-line arguments with `ArgParser.parse` or
 * `parseArgs`.
 */
export class ParsedArgs {
  /** Parsed option values keyed by long option name, including applied defaults. */
  options: HashMap<String, ParsedValue>;

  /** Positional arguments not consumed as options or subcommands. */
  rest: GrowableArray<String>;

  /** Name of the matched subcommand, or `null` if no subcommand matched. */
  commandName: String | null;

  /** Parsed arguments for the matched subcommand, or `null` if no subcommand matched. */
  commandArgs: ParsedArgs | null;

  /** Creates a `ParsedArgs` result. */
  new(
    this.options,
    this.rest,
    this.commandName,
    this.commandArgs,
  );

  /**
   * Returns `true` if the boolean flag `name` was set (or defaulted to
   * `'true'`), and `false` otherwise.
   */
  getFlag(name: String): boolean {
    if (let (true, Flag {value}) = this.options.get(name)) {
      return value;
    }
    return false;
  }

  /**
   * Returns `(true, value)` if the single-value option `name` is present, or
   * `(false, _)` if not.
   *
   * Supports `??` for fallback values (`parsed.getOption('output') ?? 'out.txt'`).
   */
  getOption(name: String): inline (true, String) | inline (false, _) {
    if (let (true, Single {value}) = this.options.get(name)) {
      return (true, value);
    }
    return (false, _);
  }

  /**
   * Parses the option `name` as a 32-bit integer, returning `(true, value)`
   * when present and valid, or `(false, _)` otherwise.
   *
   * Supports `??` for fallback values (`parsed.getInt('count') ?? 1`).
   */
  getInt(name: String): inline (true, i32) | inline (false, _) {
    if (let (true, Single {value}) = this.options.get(name)) {
      return parseI32(value);
    }
    return (false, _);
  }

  /**
   * Returns all values passed for the repeatable option `name`, or an empty
   * array if none were passed.
   */
  getMultiOption(name: String): Array<String> {
    if (let (true, Multi {values}) = this.options.get(name)) {
      return values;
    }
    return [];
  }

  /**
   * Returns `(true, value)` for the `ParsedValue` of option `name`, or
   * `(false, _)` if absent.
   */
  get(name: String): inline (true, ParsedValue) | inline (false, _) {
    return this.options.get(name);
  }

  /**
   * Returns `true` if option `name` was passed on the command line or supplied
   * by `OptionConfig.defaultVal`.
   */
  hasOption(name: String): boolean {
    return this.options.has(name);
  }
}

/** Returns the first line of `text`, up to the first line break. */
function firstLine(text: String) {
  return new StringReader(text).readLine() ?? '';
}

/**
 * A configurable command-line argument parser.
 *
 * `ArgParser` configures options, flags, and subcommands, parses raw argument
 * lists (such as `getArguments()` from `zena:cli`), and formats `--help` usage
 * text.
 *
 * ### Configuration
 *
 * Pass a `ParserConfig` record with `options` and `commands` maps to
 * `new ArgParser(...)`:
 *
 * ```zena
 * let parser = new ArgParser({
 *   name: 'mytool',
 *   help: 'Build and inspect artifacts',
 *   options: {
 *     'verbose' => {type: OptionType.Flag, abbr: 'v', help: 'Enable verbose output'},
 *     'output' => {abbr: 'o', defaultVal: 'out.txt', help: 'Output file path'},
 *     'count' => {type: OptionType.Int, abbr: 'n', help: 'Number of items'},
 *   },
 *   commands: {
 *     'build' => {
 *       help: 'Build the project',
 *       options: {'release' => {type: OptionType.Flag, abbr: 'r'}},
 *     },
 *   },
 * });
 * ```
 *
 * When options or subcommands are registered dynamically (for example, by
 * plugins), add them with `addOption` and `addCommand`.
 *
 * ### Supported Argument Syntax
 *
 * - **Flags**: `--flag`, short `-f`, negated `--no-flag`, `--flag=true`, or
 *   combined short flags `-vfg`.
 * - **Options**: `--opt value`, `--opt=value`, `-o value`, `-o=value`, or
 *   attached `-oval`.
 * - **Delimiter**: `--` treats all subsequent arguments as positional `rest`
 *   values.
 * - **Subcommands**: Dispatched to the matching subcommand's parser, which may
 *   define nested subcommands of its own (`zena pkg add`). Look up a
 *   subcommand's parser with `command(name)` to format its help.
 */
export class ArgParser {
  /** Program name shown in the `Usage:` line of `formatHelp`. */
  programName: String;

  /** Help text shown below the `Usage:` line in `formatHelp`. */
  help: String;

  /**
   * Whether to stop parsing options at the first positional argument.
   * See `CommandConfig.stopAtPositional`.
   */
  stopAtPositional: boolean;

  #options = new OrderedHashMap<String, OptionConfig>();
  #byAbbr = new HashMap<String, (String, OptionConfig)>();
  #commands = new OrderedHashMap<String, ArgParser>();

  /**
   * Creates a command-line argument parser configured from `config`.
   */
  new(config: ParserConfig = {})
    : programName = config.name ?? '',
      help = config.help ?? '',
      stopAtPositional = config.stopAtPositional ?? false {
    if (let {options} = config) {
      for (let entry in options) {
        this.#addOpt(entry.key, entry.value);
      }
    }
    if (let {commands} = config) {
      for (let entry in commands) {
        this.addCommand(entry.key, entry.value);
      }
    }
  }

  /**
   * Adds an option named `name` to this parser and returns `this`.
   */
  addOption(name: String, config: OptionConfig = {}): ArgParser {
    this.#addOpt(name, config);
    return this;
  }

  /**
   * Adds a subcommand named `name` and returns its parser, whose `programName`
   * prefixes `name` with this parser's `programName` (such as `'zena pkg'`).
   */
  addCommand(name: String, config: CommandConfig = {}): ArgParser {
    if (name.length == 0) {
      throw new Error('Command must have a name');
    }
    let fullName = if (this.programName.length > 0) {
      `${this.programName} ${name}`
    } else {
      name
    };
    let commandParser = new ArgParser({...config, name: fullName});
    this.#commands[name] = commandParser;
    return commandParser;
  }

  /**
   * Returns the parser for subcommand `name`, or `null` if none is registered.
   */
  command(name: String): ArgParser | null {
    if (let (true, parser) = this.#commands.get(name)) {
      return parser;
    }
    return null;
  }

  #addOpt(name: String, opt: OptionConfig): void {
    if (name.length == 0) {
      throw new Error('Option must have a name');
    }
    this.#options[name] = opt;
    if (let {abbr} = opt) {
      if (abbr.length > 0) {
        this.#byAbbr[abbr] = (name, opt);
      }
    }
  }

  #recordValue(
    options: HashMap<String, ParsedValue>,
    name: String,
    opt: OptionConfig,
    val: String,
  ): void {
    if (let {allowed} = opt) {
      var matched = false;
      for (let item in allowed) {
        if (item == val) {
          matched = true;
          break;
        }
      }
      if (!matched) {
        throw new Error(
          `Invalid value '${val}' for option '--${name}' (allowed: ${join(allowed, ', ')})`,
        );
      }
    }
    let optType = opt.type ?? OptionType.StringVal;
    if (optType == OptionType.MultiString) {
      if (let (true, Multi {values}) = options.get(name)) {
        values.push(val);
      } else {
        options[name] = new Multi(growable([val]));
      }
    } else {
      options[name] = new Single(val);
    }
  }

  /**
   * Parses `args` starting at `startIndex`.
   *
   * @param args Argument strings to parse (such as `getArguments()`).
   * @param startIndex Index in `args` to start parsing from (typically `0`, or `1` to skip the binary name).
   */
  parse(args: Array<String>, startIndex: i32 = 0): ParsedArgs {
    let options = new HashMap<String, ParsedValue>();
    let rest = new GrowableArray<String>();
    var commandName: String | null = null;
    var commandArgs: ParsedArgs | null = null;

    var i = startIndex;
    var stopOptions = false;

    while (i < args.length) {
      let arg = args[i];

      if (stopOptions) {
        rest.push(arg);
        i += 1;
        continue;
      }

      if (arg == '--') {
        stopOptions = true;
        i += 1;
        continue;
      }

      // Long option: --name, --name=value, --no-name
      if (arg.startsWith('--')) {
        let reader = new StringReader(arg);
        reader.skipBytes(2);

        let nameBeforeEq = reader.readUntil('=');
        if (nameBeforeEq != null) {
          let val = reader.readToEnd();
          if (let (true, opt) = this.#options.get(nameBeforeEq)) {
            let optType = opt.type ?? OptionType.StringVal;
            if (optType == OptionType.Flag) {
              options[nameBeforeEq] = new Flag(val == 'true' || val == '1');
            } else {
              this.#recordValue(options, nameBeforeEq, opt, val);
            }
          } else {
            throw new Error(`Unknown option: '--${nameBeforeEq}'`);
          }
        } else {
          let bodyStart = reader.mark();
          if (reader.matchString('no-')) {
            let negName = reader.readToEnd();
            if (let (true, opt) = this.#options.get(negName)) {
              if ((opt.type ?? OptionType.StringVal) == OptionType.Flag) {
                options[negName] = new Flag(false);
                i += 1;
                continue;
              }
            }
            reader.reset(bodyStart);
          }

          let optBody = reader.readToEnd();
          if (let (true, opt) = this.#options.get(optBody)) {
            let optType = opt.type ?? OptionType.StringVal;
            if (optType == OptionType.Flag) {
              options[optBody] = new Flag(true);
            } else {
              if (i + 1 >= args.length) {
                throw new Error(`Option '--${optBody}' requires a value`);
              }
              this.#recordValue(options, optBody, opt, args[i + 1]);
              i += 1;
            }
          } else {
            throw new Error(`Unknown option: '--${optBody}'`);
          }
        }
        i += 1;
        continue;
      }

      // Short option: -f, -f value, -f=value, -fvalue, combined -vfg
      if (arg.startsWith('-') && arg.length > 1) {
        let reader = new StringReader(arg);
        reader.skipBytes(1);
        let start = reader.mark();
        reader.advance();
        let shortChar = reader.sliceFrom(start);

        if (let (true, (optName, opt)) = this.#byAbbr.get(shortChar)) {
          let optType = opt.type ?? OptionType.StringVal;
          if (optType == OptionType.Flag) {
            options[optName] = new Flag(true);
            while (!reader.isAtEnd) {
              let chStart = reader.mark();
              reader.advance();
              let ch = reader.sliceFrom(chStart);
              if (let (true, (fName, fOpt)) = this.#byAbbr.get(ch)) {
                if ((fOpt.type ?? OptionType.StringVal) == OptionType.Flag) {
                  options[fName] = new Flag(true);
                } else {
                  throw new Error(`Option '-${ch}' is not a flag`);
                }
              } else {
                throw new Error(`Unknown short option: '-${ch}'`);
              }
            }
          } else if (!reader.isAtEnd) {
            reader.matchByte(61); // '='
            this.#recordValue(options, optName, opt, reader.readToEnd());
          } else {
            if (i + 1 >= args.length) {
              throw new Error(`Option '-${shortChar}' requires a value`);
            }
            this.#recordValue(options, optName, opt, args[i + 1]);
            i += 1;
          }
        } else {
          throw new Error(`Unknown option: '${arg}'`);
        }
        i += 1;
        continue;
      }

      // Subcommands
      if (let (true, sub) = this.#commands.get(arg)) {
        commandName = arg;
        commandArgs = sub.parse(args, i + 1);
        break;
      }

      // Positional argument
      rest.push(arg);
      if (this.stopAtPositional) {
        stopOptions = true;
      }
      i += 1;
    }

    // Apply defaults for options not explicitly provided on the CLI
    for (let entry in this.#options) {
      let optName = entry.key;
      let opt = entry.value;
      if (!options.has(optName)) {
        if (let {defaultVal} = opt) {
          let optType = opt.type ?? OptionType.StringVal;
          if (optType == OptionType.Flag) {
            options[optName] = new Flag(defaultVal == 'true' || defaultVal == '1');
          } else if (optType == OptionType.StringVal || optType == OptionType.Int) {
            options[optName] = new Single(defaultVal);
          }
        }
      }
    }

    return new ParsedArgs(options, rest, commandName, commandArgs);
  }

  /**
   * Formats a `--help` usage message for this parser.
   */
  formatHelp(): String {
    let sb = new StringBuilder();
    sb.append('Usage: ');
    sb.append(if (this.programName.length > 0) this.programName else 'program');

    if (this.#options.size > 0) {
      sb.append(' [options]');
    }
    if (this.#commands.size > 0) {
      sb.append(' <command> [args]');
    }
    sb.append('\n');

    if (this.help.length > 0) {
      sb.append('\n');
      sb.append(this.help);
      sb.append('\n');
    }

    if (this.#options.size > 0) {
      sb.append('\nOptions:\n');
      for (let entry in this.#options) {
        let optName = entry.key;
        let opt = entry.value;
        let optAbbr = opt.abbr ?? '';
        let optType = opt.type ?? OptionType.StringVal;
        let optHelp = opt.help ?? '';

        sb.append('  ');
        var optStr = if (optAbbr.length > 0) {
          `-${optAbbr}, --${optName}`
        } else {
          `    --${optName}`
        };
        if (optType != OptionType.Flag) {
          optStr = `${optStr} <value>`;
        }
        sb.append(optStr);

        let suffix = new StringBuilder();
        suffix.append(optHelp);
        if (let {allowed} = opt) {
          if (allowed.length > 0) {
            if (suffix.length > 0) {
              suffix.append(' ');
            }
            suffix.append(`[${join(allowed, ', ')}]`);
          }
        }
        if (let {defaultVal} = opt) {
          if (optType != OptionType.Flag) {
            if (suffix.length > 0) {
              suffix.append(' ');
            }
            suffix.append(`(default: ${defaultVal})`);
          }
        }

        if (suffix.length > 0) {
          let padCount = if (28 - optStr.length > 2) 28 - optStr.length else 2;
          for (var pad = padCount; pad > 0; pad -= 1) {
            sb.append(' ');
          }
          sb.append(suffix.toString());
        }
        sb.append('\n');
      }
    }

    if (this.#commands.size > 0) {
      sb.append('\nCommands:\n');
      for (let entry in this.#commands) {
        let cmdName = entry.key;
        let summary = firstLine(entry.value.help);
        sb.append('  ');
        sb.append(cmdName);
        if (summary.length > 0) {
          let padCount = if (16 - cmdName.length > 2) 16 - cmdName.length else 2;
          for (var pad = padCount; pad > 0; pad -= 1) {
            sb.append(' ');
          }
          sb.append(summary);
        }
        sb.append('\n');
      }
    }

    return sb.toString();
  }
}

/**
 * Parses `args` starting at `startIndex` using `config`.
 *
 * @param args Argument strings to parse (such as `getArguments()`).
 * @param config Parser configuration defining options, subcommands, and behavior.
 * @param startIndex Index in `args` to start parsing from (default `0`).
 * @returns Parsed arguments result.
 */
export function parseArgs(
  args: Array<String>,
  config: ParserConfig = {},
  startIndex: i32 = 0,
): ParsedArgs {
  return new ArgParser(config).parse(args, startIndex);
}
