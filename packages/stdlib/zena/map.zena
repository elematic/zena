// 'zena:map' — the unordered map, from the collections library.
//
// The implementation lives in collections/, next to the ordered map and the
// sets it shares a hash table with. This module stays because most code
// imports HashMap from here, and because the prelude injects Map and HashMap
// from this specifier. 'zena:collections' exports the same declarations.

export * from 'zena:hashable';

export { Map, MapEntry } from './collections/map.zena';
export { HashMap } from './collections/hash-map.zena';
