/**
 * JSON serialization, deserialization, and AST representation.
 *
 * Provides functions to parse JSON text into structured `JsonValue` trees and
 * format values back into JSON strings.
 *
 * ## Examples
 *
 * ```zena
 * import { parseJson, stringify, JsonObject } from 'zena:json';
 *
 * let data = parseJson('{"name": "Zena", "version": 1}');
 * if (data is JsonObject) {
 *   let obj = data as JsonObject;
 *   let name = obj['name'];
 * }
 *
 * let text = stringify(data);
 * ```
 */

import {StringBuilder, StringReader} from 'zena:core';

// === Source Location ===

export final class SourceLocation {
  line: i32;
  column: i32;
  endLine: i32;
  endColumn: i32;

  new(line: i32, column: i32, endLine: i32, endColumn: i32)
    : line = line, column = column, endLine = endLine, endColumn = endColumn;
}

// === JSON Value Types ===

// Forward declaration for recursive type
export type JsonValue = JsonObject | JsonArray | String | Box<f64> | Box<boolean> | null;

export class JsonObject {
  #fields = new Map<String, JsonValue>.ordered();
  #locations: HashMap<String, SourceLocation> | null = null;

  static withLocations(): JsonObject {
    return new JsonObject(true);
  }

  new(withLocations: boolean = false)
    : #locations = 
        if (withLocations) { new Map<String, SourceLocation>() }
        else { null } {}

  operator [](key: String): JsonValue {
    return this.#fields.getOr(key, null);
  }

  operator []=(key: String, value: JsonValue): void {
    this.#fields[key] = value;
  }

  has(key: String): boolean {
    return this.#fields.has(key);
  }

  delete(key: String): boolean {
    return this.#fields.delete(key);
  }

  size: i32 {
    get {
      return this.#fields.size;
    }
  }

  // Source location for a key (only if tracking enabled)
  locationOf(key: String): SourceLocation | null {
    if (this.#locations == null) {
      return null;
    }
    return if (let (true, loc) = this.#locations.get(key)) {
      loc
    } else {
      null
    };
  }

  // Internal: set location for a key
  setLocation(key: String, loc: SourceLocation): void {
    if (this.#locations != null) {
      this.#locations[key] = loc;
    }
  }

  /**
   * The value at a path of keys separated by dots, like
   * `'params.textDocument.uri'`. Null when a key is missing, or when a
   * value on the way is not an object.
   */
  lookup(path: String): JsonValue {
    var current: JsonValue = this;
    for (let key in path.split('.')) {
      if (current is JsonObject) {
        current = current[key];
      } else {
        return null;
      }
    }
    return current;
  }

  /**
   * The string at `path` (see `lookup`), found only when it is there and
   * is a string.
   *
   * ```zena
   * let uri = message.stringAt('params.textDocument.uri') ?? '';
   * ```
   */
  stringAt(path: String): inline (true, String) | inline (false, _) {
    let found = this.lookup(path);
    if (found is String) {
      return (true, found);
    }
    return (false, _);
  }

  /** The number at `path`, found only when it is a number. */
  numberAt(path: String): inline (true, f64) | inline (false, _) {
    let found = this.lookup(path);
    if (found is Box<f64>) {
      return (true, found.value);
    }
    return (false, _);
  }

  /**
   * The integer at `path`, found only when it is a number with no
   * fractional part that fits an `i32`.
   */
  intAt(path: String): inline (true, i32) | inline (false, _) {
    let found = this.lookup(path);
    if (found is Box<f64>) {
      let n = found.value;
      let whole = n as i32;
      if ((whole as f64) == n) {
        return (true, whole);
      }
    }
    return (false, _);
  }

  /** The boolean at `path`, found only when it is a boolean. */
  boolAt(path: String): inline (true, boolean) | inline (false, _) {
    let found = this.lookup(path);
    if (found is Box<boolean>) {
      return (true, found.value);
    }
    return (false, _);
  }

  /** The object at `path`, found only when it is an object. */
  objectAt(path: String): inline (true, JsonObject) | inline (false, _) {
    let found = this.lookup(path);
    if (found is JsonObject) {
      return (true, found);
    }
    return (false, _);
  }

  /** The array at `path`, found only when it is an array. */
  arrayAt(path: String): inline (true, JsonArray) | inline (false, _) {
    let found = this.lookup(path);
    if (found is JsonArray) {
      return (true, found);
    }
    return (false, _);
  }

  // Iterate over all key-value pairs
  forEach(callback: (key: String, value: JsonValue) => void): void {
    this.#fields.forEach(callback);
  }

  /** The keys, in the order the fields were added. */
  keys(): Iterator<String> {
    return this.#fields.keys();
  }

  // Serialize to JSON string
  stringify(): String {
    let sb = new StringBuilder(64);
    stringifyObject(sb, this, null, 0);
    return sb.toString();
  }
}

export class JsonArray {
  #elements = new Array<JsonValue>();
  #locations: GrowableArray<SourceLocation> | null = null;

  static withLocations(): JsonArray {
    return new JsonArray(true);
  }

  new(withLocations: boolean = false)
    : #locations = 
        if (withLocations) { new Array<SourceLocation>() }
        else { null } {}

  operator [](index: i32): JsonValue {
    return this.#elements[index];
  }

  operator []=(index: i32, value: JsonValue): void {
    this.#elements[index] = value;
  }

  length: i32 {
    get {
      return this.#elements.length;
    }
  }

  push(value: JsonValue): void {
    this.#elements.push(value);
  }

  pushWithLocation(value: JsonValue, loc: SourceLocation): void {
    this.#elements.push(value);
    if (this.#locations != null) {
      this.#locations.push(loc);
    }
  }

  // Source location for an index (only if tracking enabled)
  locationOf(index: i32): SourceLocation | null {
    if (this.#locations == null) {
      return null;
    }
    if (index < 0 || index >= this.#locations.length) {
      return null;
    }
    return this.#locations[index];
  }

  // Serialize to JSON string
  stringify(): String {
    let sb = new StringBuilder(64);
    stringifyArray(sb, this, null, 0);
    return sb.toString();
  }
}

// === JSON Stringify Helpers ===

function hexDigit(n: i32) {
  if (n < 10) {
    return 48 + n;  // '0' = 48
  } else {
    return 97 + n - 10;  // 'a' = 97
  }
}

function escapeJsonString(sb: StringBuilder, s: String) {
  sb.appendByte(34);
  let reader = new StringReader(s);
  var spanStart = reader.mark();
  while (!reader.isAtEnd) {
    let at = reader.mark();
    let cp = reader.advance();
    if (cp < 0 || (cp >= 32 && cp != 34 && cp != 92)) {
      continue;
    }
    if (at > spanStart) {
      sb.appendSlice(s, spanStart, at);
    }
    if (cp == 34) {
      // " -> \"
      sb.appendByte2(92, 34);
    } else if (cp == 92) {
      // \ -> \\
      sb.appendByte2(92, 92);
    } else if (cp == 10) {
      // newline -> \n
      sb.appendByte2(92, 110);
    } else if (cp == 13) {
      // carriage return -> \r
      sb.appendByte2(92, 114);
    } else if (cp == 9) {
      // tab -> \t
      sb.appendByte2(92, 116);
    } else {
      // Other control characters -> \u00XX
      sb.append("\\u00");
      sb.appendByte2(hexDigit(cp >> 4), hexDigit(cp & 15));
    }
    spanStart = reader.mark();
  }
  if (spanStart == 0) {
    sb.append(s);
  } else {
    let end = reader.mark();
    if (end > spanStart) {
      sb.appendSlice(s, spanStart, end);
    }
  }
  sb.appendByte(34);
}

function stringifyI32(sb: StringBuilder, n: i32) {
  sb.appendI32(n);
}

function stringifyF64(sb: StringBuilder, n: f64) {
  // Handle NaN - JSON doesn't support NaN, write null
  if (n != n) {
    sb.append("null");
    return;
  }
  
  // Handle Infinity - JSON doesn't support it, write null
  // For finite values, value - value == 0.0
  // For infinity, infinity - infinity = NaN, which != 0.0
  let selfDiff = n - n;
  let ZERO: f64 = 0.0;
  if (selfDiff != ZERO) {
    sb.append("null");
    return;
  }
  
  // Use standard f64 formatting
  sb.appendF64(n);
}

function stringifyValue(sb: StringBuilder, value: JsonValue, indent: String | null, depth: i32) {
  if (value == null) {
    sb.append("null");
  } else if (value is JsonObject) {
    stringifyObject(sb, value, indent, depth);
  } else if (value is JsonArray) {
    stringifyArray(sb, value, indent, depth);
  } else if (value is String) {
    escapeJsonString(sb, value);
  } else if (value is Box<f64>) {
    stringifyF64(sb, value.value);
  } else if (value is Box<i32>) {
    let boxed = value as Box<i32>;
    stringifyI32(sb, boxed.value);
  } else if (value is Box<boolean>) {
    if (value.value) {
      sb.append("true");
    } else {
      sb.append("false");
    }
  } else {
    // Fallback for unknown types
    sb.append("null");
  }
}

function writeIndent(sb: StringBuilder, indent: String, depth: i32) {
  var i = 0;
  while (i < depth) {
    sb.append(indent);
    i += 1;
  }
}

function stringifyObject(sb: StringBuilder, obj: JsonObject, indent: String | null, depth: i32): void {
  if (indent != null) {
    // Pretty-print mode
    if (obj.size == 0) {
      sb.appendByte2(123, 125);
      return;
    }
    sb.appendByte2(123, 10);
    var first = true;
    obj.forEach((key, value) => {
      if (!first) {
        sb.appendByte2(44, 10);
      }
      first = false;
      writeIndent(sb, indent, depth + 1);
      escapeJsonString(sb, key);
      sb.appendByte2(58, 32);
      stringifyValue(sb, value, indent, depth + 1);
    });
    sb.appendByte(10);
    writeIndent(sb, indent, depth);
    sb.appendByte(125);
  } else {
    // Compact mode
    sb.appendByte(123);
    var first = true;
    obj.forEach((key, value) => {
      if (!first) {
        sb.appendByte(44);
      }
      first = false;
      escapeJsonString(sb, key);
      sb.appendByte(58);
      stringifyValue(sb, value, null, 0);
    });
    sb.appendByte(125);
  }
}

function stringifyArray(sb: StringBuilder, arr: JsonArray, indent: String | null, depth: i32): void {
  let len = arr.length;
  if (indent != null) {
    // Pretty-print mode
    if (len == 0) {
      sb.appendByte2(91, 93);
      return;
    }
    sb.appendByte2(91, 10);
    var i = 0;
    while (i < len) {
      if (i > 0) {
        sb.appendByte2(44, 10);
      }
      writeIndent(sb, indent, depth + 1);
      stringifyValue(sb, arr[i], indent, depth + 1);
      i += 1;
    }
    sb.appendByte(10);
    writeIndent(sb, indent, depth);
    sb.appendByte(93);
  } else {
    // Compact mode
    sb.appendByte(91);
    var i = 0;
    while (i < len) {
      if (i > 0) {
        sb.appendByte(44);
      }
      stringifyValue(sb, arr[i], null, 0);
      i += 1;
    }
    sb.appendByte(93);
  }
}

/**
 * Serialize any JSON value to a string.
 * @param value The JSON value to serialize
 * @param indent Optional indentation string for pretty-printing (e.g., "  " or "\t")
 */
export function stringify(value: JsonValue, indent: String | null = null): String {
  let sb = new StringBuilder(64);
  stringifyValue(sb, value, indent, 0);
  if (indent != null) {
    sb.appendByte(10);
  }
  return sb.toString();
}

// === Parse Options ===

// TODO: Use optional record fields when supported, e.g.:
//   type JsonOptions = { allowComments?: boolean, trackLocations?: boolean };
// This would allow: parseJson(input, { allowComments: true })
export type JsonOptions = { allowComments: boolean, trackLocations: boolean };

// === Parse Error ===

export class JsonParseError extends Error {
  #line: i32;
  #column: i32;

  new(message: String, line: i32, column: i32)
    : #line = line, 
      #column = column, 
      super(message);

  line: i32 {
    get { return this.#line; }
  }

  column: i32 {
    get { return this.#column; }
  }
}

// === Parser ===

/**
 * How deep objects and arrays may nest in a document `parseJson` reads.
 * DAG-CBOR's decoder (`atproto/cbor`) allows the same.
 */
let MAX_DEPTH = 256;

class JsonParser {
  #reader: StringReader;
  var #depth = 0;
  #allowComments: boolean;
  #trackLocations: boolean;
  var #line = 1;
  var #column = 1;

  new(input: String, options: JsonOptions | null)
    : #reader = new StringReader(input),
      #allowComments = options?.allowComments ?? false,
      #trackLocations = options?.trackLocations ?? false
  {}

  parse(): JsonValue {
    this.#skipWhitespaceAndComments();
    let value = this.#parseValue();
    this.#skipWhitespaceAndComments();
    if (!this.#reader.isAtEnd) {
      this.#error("Unexpected content after JSON value");
    }
    return value;
  }

  #peek(): i32 {
    return this.#reader.peek();
  }

  #parseValue(): JsonValue {
    let b = this.#peek();

    if (b == 123 || b == 91) {  // '{' or '['
      // Each level is a frame of this recursion, so a deeper document
      // would overflow the stack, which ends the program, not the parse.
      this.#depth += 1;
      if (this.#depth > MAX_DEPTH) {
        this.#error(`the value is nested more than ${MAX_DEPTH} deep`);
      }
      let value: JsonValue = if (b == 123) this.#parseObject() else this.#parseArray();
      this.#depth -= 1;
      return value;
    }
    if (b == 34) {   // '"'
      return this.#parseString();
    }
    if (b == 116) {  // 't' (true)
      return this.#parseTrue();
    }
    if (b == 102) {  // 'f' (false)
      return this.#parseFalse();
    }
    if (b == 110) {  // 'n' (null)
      return this.#parseNull();
    }
    if (b == 45 || (b >= 48 && b <= 57)) {  // '-' or digit
      return this.#parseNumber();
    }
    
    this.#error("Unexpected character");
    // Unreachable, but need to return something
    return null;
  }

  #parseObject(): JsonObject {
    let obj = if (this.#trackLocations) {
      JsonObject.withLocations()
    } else {
      new JsonObject()
    };
    
    this.#expect(123);  // '{'
    this.#skipWhitespaceAndComments();
    
    if (this.#peek() == 125) {  // '}'
      this.#advance();
      return obj;
    }
    
    while (true) {
      this.#skipWhitespaceAndComments();
      
      // Parse key
      if (this.#peek() != 34) {  // '"'
        this.#error("Expected string key");
      }
      let key = this.#parseString();
      
      this.#skipWhitespaceAndComments();
      this.#expect(58);  // ':'
      this.#skipWhitespaceAndComments();
      
      // Parse value
      let valueStartLine = this.#line;
      let valueStartCol = this.#column;
      let value = this.#parseValue();
      let valueEndLine = this.#line;
      let valueEndCol = this.#column;
      
      obj[key] = value;
      if (this.#trackLocations) {
        obj.setLocation(key, new SourceLocation(
          valueStartLine, valueStartCol, valueEndLine, valueEndCol
        ));
      }
      
      this.#skipWhitespaceAndComments();
      
      let next = this.#peek();
      if (next == 125) {  // '}'
        this.#advance();
        return obj;
      }
      if (next == 44) {  // ','
        this.#advance();
      } else {
        this.#error("Expected ',' or '}'");
      }
    }
    
    // Unreachable
    return obj;
  }

  #parseArray(): JsonArray {
    let arr = if (this.#trackLocations) {
      JsonArray.withLocations()
    } else {
      new JsonArray()
    };
    
    this.#expect(91);  // '['
    this.#skipWhitespaceAndComments();
    
    if (this.#peek() == 93) {  // ']'
      this.#advance();
      return arr;
    }
    
    while (true) {
      this.#skipWhitespaceAndComments();
      
      let valueStartLine = this.#line;
      let valueStartCol = this.#column;
      let value = this.#parseValue();
      let valueEndLine = this.#line;
      let valueEndCol = this.#column;
      
      if (this.#trackLocations) {
        arr.pushWithLocation(value, new SourceLocation(
          valueStartLine, valueStartCol, valueEndLine, valueEndCol
        ));
      } else {
        arr.push(value);
      }
      
      this.#skipWhitespaceAndComments();
      
      let next = this.#peek();
      if (next == 93) {  // ']'
        this.#advance();
        return arr;
      }
      if (next == 44) {  // ','
        this.#advance();
      } else {
        this.#error("Expected ',' or ']'");
      }
    }
    
    // Unreachable
    return arr;
  }

  #parseString(): String {
    this.#expect(34);  // '"'

    let reader = this.#reader;
    let start = reader.mark();
    var hasEscape = false;

    while (!reader.isAtEnd) {
      let cp = reader.peek();
      if (cp >= 32 && cp != 34 && cp != 92) {
        this.#advance();
        continue;
      }
      if (cp == 34) {  // '"'
        let raw = reader.sliceFrom(start);
        this.#advance();
        if (hasEscape) {
          return this.#unescapeString(raw);
        }
        return raw;
      }
      if (cp == 92) {  // '\\'
        hasEscape = true;
        this.#advance();
        // Skip the escaped character
        if (reader.isAtEnd) {
          this.#error("Unterminated escape sequence");
        }
        this.#advance();
      } else {
        this.#error("Control character in string");
      }
    }

    this.#error("Unterminated string");
    return "";
  }

  #unescapeString(raw: String): String {
    let r = new StringReader(raw);
    let out = new StringBuilder(raw.length);
    var spanStart = r.mark();
    while (!r.isAtEnd) {
      let at = r.mark();
      let cp = r.advance();
      if (cp != 92) {  // not '\\': scan ahead
        continue;
      }
      if (at > spanStart) {
        out.appendSlice(raw, spanStart, at);
      }
      let escaped = r.advance();
      if (escaped == 110) {         // 'n'
        out.appendByte(10);
      } else if (escaped == 114) {  // 'r'
        out.appendByte(13);
      } else if (escaped == 116) {  // 't'
        out.appendByte(9);
      } else if (escaped == 98) {   // 'b'
        out.appendByte(8);
      } else if (escaped == 102) {  // 'f'
        out.appendByte(12);
      } else if (escaped == 117) {  // 'u': four hex digits, a UTF-16 unit
        var code = this.#hexUnit(r);
        // A high surrogate followed by an escaped low one is one code
        // point, which is how JSON writes anything past U+FFFF.
        if (code >= 0xD800 && code <= 0xDBFF) {
          let afterHigh = r.mark();
          if (r.matchString("\\u")) {
            let low = this.#hexUnit(r);
            if (low >= 0xDC00 && low <= 0xDFFF) {
              code = 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00);
            } else {
              r.reset(afterHigh);
            }
          }
        }
        // `appendCodePoint` encodes into the builder's native encoding and
        // replaces an unpaired surrogate (`0xD800..0xDFFF`) with `U+FFFD`.
        out.appendCodePoint(code);
      } else {                      // '"', '\\' and '/' stand for themselves
        out.appendCodePoint(escaped);
      }
      spanStart = r.mark();
    }
    let end = r.mark();
    if (end > spanStart) {
      out.appendSlice(raw, spanStart, end);
    }
    return out.toString();
  }

  /** Reads four hex digits from `r` as a 16-bit unit. */
  #hexUnit(r: StringReader): i32 {
    var value = 0;
    for (var k = 0; k < 4; k += 1) {
      if (r.isAtEnd) {
        this.#error("Incomplete \\u escape");
      }
      let c = r.advance();
      var digit = 0;
      if (c >= 48 && c <= 57) {         // 0-9
        digit = c - 48;
      } else if (c >= 97 && c <= 102) { // a-f
        digit = c - 87;
      } else if (c >= 65 && c <= 70) {  // A-F
        digit = c - 55;
      } else {
        this.#error("Invalid hex digit in \\u escape");
      }
      value = value * 16 + digit;
    }
    return value;
  }

  #parseNumber(): Box<f64> {
    let reader = this.#reader;
    let start = reader.mark();
    var negative = false;
    
    // Optional minus
    if (reader.peek() == 45) {  // '-'
      negative = true;
      this.#advance();
    }
    
    // Integer part
    var intDigits = 0;
    var intAcc = 0 as i64;
    let first = reader.peek();
    if (first == 48) {  // '0'
      this.#advance();
      intDigits = 1;
    } else if (first >= 49 && first <= 57) {  // '1'-'9'
      intAcc = (first - 48) as i64;
      this.#advance();
      intDigits = 1;
      while (!reader.isAtEnd) {
        let cp = reader.peek();
        if (cp >= 48 && cp <= 57) {
          intAcc = intAcc * (10 as i64) + ((cp - 48) as i64);
          this.#advance();
          intDigits += 1;
        } else {
          break;
        }
      }
    } else {
      this.#error("Invalid number");
    }
    
    var isFloat = false;
    // Fractional part
    if (reader.peek() == 46) {  // '.'
      isFloat = true;
      this.#advance();
      var hasDigit = false;
      while (!reader.isAtEnd) {
        let cp = reader.peek();
        if (cp >= 48 && cp <= 57) {
          this.#advance();
          hasDigit = true;
        } else {
          break;
        }
      }
      if (!hasDigit) {
        this.#error("Invalid number: expected digit after decimal point");
      }
    }
    
    // Exponent part
    let e = reader.peek();
    if (e == 101 || e == 69) {  // 'e' or 'E'
      isFloat = true;
      this.#advance();
      let sign = reader.peek();
      if (sign == 43 || sign == 45) {  // '+' or '-'
        this.#advance();
      }
      var hasExpDigit = false;
      while (!reader.isAtEnd) {
        let cp = reader.peek();
        if (cp >= 48 && cp <= 57) {
          this.#advance();
          hasExpDigit = true;
        } else {
          break;
        }
      }
      if (!hasExpDigit) {
        this.#error("Invalid number: expected digit in exponent");
      }
    }

    if (!isFloat && intDigits <= 18) {
      if (negative) {
        if (intAcc == (0 as i64)) {
          return new Box(0.0 - 0.0);
        }
        return new Box(0.0 - (intAcc as f64));
      }
      return new Box(intAcc as f64);
    }

    let numStr = reader.sliceFrom(start);
    let value = parseF64(numStr);
    return new Box(value);
  }

  #parseTrue(): Box<boolean> {
    this.#expectWord("true");
    return new Box(true as boolean);
  }

  #parseFalse(): Box<boolean> {
    this.#expectWord("false");
    return new Box(false as boolean);
  }

  #parseNull(): JsonValue {
    this.#expectWord("null");
    return null;
  }

  #expectWord(word: String): void {
    if (!this.#reader.matchString(word)) {
      this.#error(`Expected '${word}'`);
    }
    this.#column += word.length;
  }

  #skipWhitespaceAndComments(): void {
    let reader = this.#reader;
    while (!reader.isAtEnd) {
      let cp = reader.peek();
      
      // Whitespace
      if (cp == 32 || cp == 9 || cp == 13) {  // space, tab, CR
        this.#advance();
      } else if (cp == 10) {  // newline
        reader.advance();
        this.#line += 1;
        this.#column = 1;
      } else if (this.#allowComments && cp == 47) {  // '/'
        if (reader.matchString("//")) {  // '//' line comment
          this.#column += 2;
          while (!reader.isAtEnd && reader.peek() != 10) {
            this.#advance();
          }
        } else if (reader.matchString("/*")) {  // '/*' block comment
          this.#column += 2;
          while (!reader.isAtEnd) {
            if (reader.matchString("*/")) {
              this.#column += 2;
              break;
            }
            let c = reader.advance();
            if (c == 10) {  // newline
              this.#line += 1;
              this.#column = 1;
            } else {
              this.#column += 1;
            }
          }
        } else {
          break;  // Not a comment
        }
      } else {
        break;
      }
    }
  }

  #expect(expected: i32): void {
    let actual = this.#peek();
    if (actual != expected) {
      this.#error("Expected character");
    }
    this.#advance();
  }

  #advance(): void {
    this.#reader.advance();
    this.#column += 1;
  }

  #error(message: String): never {
    throw new JsonParseError(message, this.#line, this.#column);
  }
}

// === Public API ===

/**
 * Parses `input` as one JSON value, throwing `JsonParseError` for text
 * that is not JSON and for objects and arrays nested more than 256 deep.
 */
export function parseJson(input: String, options: JsonOptions | null = null): JsonValue {
  let parser = new JsonParser(input, options);
  return parser.parse();
}

// === jq-Style Query Functions ===

// Get a value by path (e.g., ".foo.bar[0].baz")
export function jsonGet(value: JsonValue, path: String): JsonValue {
  let reader = new StringReader(path);
  var current = value;
  
  while (!reader.isAtEnd && current != null) {
    let b = reader.peek();
    
    if (b == 46) {  // '.'
      reader.advance();
      
      // Parse field name
      let start = reader.mark();
      while (!reader.isAtEnd) {
        let c = reader.peek();
        if (c == 46 || c == 91) {  // '.' or '['
          break;
        }
        reader.advance();
      }
      let key = reader.sliceFrom(start);
      
      if (key.length > 0) {
        if (current is JsonObject) {
          current = current[key];
        } else {
          return null;  // Not an object
        }
      }
    } else if (b == 91) {  // '['
      reader.advance();
      
      // Parse index
      var index = 0;
      while (!reader.isAtEnd) {
        let c = reader.peek();
        if (c == 93) {  // ']'
          reader.advance();
          break;
        }
        if (c >= 48 && c <= 57) {
          index = index * 10 + (c - 48);
          reader.advance();
        } else {
          return null;  // Invalid index
        }
      }
      
      if (current is JsonArray) {
        let arr = current;
        if (index >= 0 && index < arr.length) {
          current = arr[index];
        } else {
          return null;  // Out of bounds
        }
      } else {
        return null;  // Not an array
      }
    } else {
      return null;  // Invalid path syntax
    }
  }
  
  return current;
}

// ============================================================================
// JsonBuilder - Streaming JSON construction
// ============================================================================

/**
 * JsonBuilder - Streaming JSON construction
 * 
 * Provides a fluent API for building JSON strings incrementally.
 * 
 * Example:
 *   let json = new JsonBuilder()
 *     .beginObject()
 *       .key("name").string("example")
 *       .key("count").i32(42)
 *       .key("items").beginArray()
 *         .string("a")
 *         .string("b")
 *       .endArray()
 *     .endObject()
 *     .toString();
 *   // {"name":"example","count":42,"items":["a","b"]}
 */
export class JsonBuilder {
  #sb: StringBuilder;
  var #depth: i32 = 0;        // Current container nesting depth
  var #hasEntry = false;      // True when the current container has at least one item
  var #needsValue = false;    // True after key(), expecting a value next

  new(capacity: i32 = 64) : #sb = new StringBuilder(capacity);

  // === Object methods ===

  beginObject(): JsonBuilder {
    this.#writeCommaIfNeeded();
    this.#sb.appendByte(123);
    this.#depth += 1;
    this.#hasEntry = false;
    this.#needsValue = false;
    return this;
  }

  endObject(): JsonBuilder {
    this.#sb.appendByte(125);
    this.#depth -= 1;
    this.#hasEntry = this.#depth > 0;
    this.#needsValue = false;
    return this;
  }

  // === Array methods ===

  beginArray(): JsonBuilder {
    this.#writeCommaIfNeeded();
    this.#sb.appendByte(91);
    this.#depth += 1;
    this.#hasEntry = false;
    this.#needsValue = false;
    return this;
  }

  endArray(): JsonBuilder {
    this.#sb.appendByte(93);
    this.#depth -= 1;
    this.#hasEntry = this.#depth > 0;
    this.#needsValue = false;
    return this;
  }

  // === Key (for objects) ===

  key(k: String): JsonBuilder {
    this.#writeCommaIfNeeded();
    escapeJsonString(this.#sb, k);
    this.#sb.appendByte(58);
    this.#needsValue = true;
    return this;
  }

  // === Value methods ===

  string(v: String): JsonBuilder {
    this.#writeCommaIfNeeded();
    escapeJsonString(this.#sb, v);
    this.#incrementCount();
    return this;
  }

  i32(v: i32): JsonBuilder {
    this.#writeCommaIfNeeded();
    this.#sb.appendI32(v);
    this.#incrementCount();
    return this;
  }

  i64(v: i64): JsonBuilder {
    this.#writeCommaIfNeeded();
    this.#sb.appendI64(v);
    this.#incrementCount();
    return this;
  }

  f64(v: f64): JsonBuilder {
    this.#writeCommaIfNeeded();
    stringifyF64(this.#sb, v);
    this.#incrementCount();
    return this;
  }

  bool(v: boolean): JsonBuilder {
    this.#writeCommaIfNeeded();
    if (v) {
      this.#sb.append("true");
    } else {
      this.#sb.append("false");
    }
    this.#incrementCount();
    return this;
  }

  nullValue(): JsonBuilder {
    this.#writeCommaIfNeeded();
    this.#sb.append("null");
    this.#incrementCount();
    return this;
  }

  /**
   * Writes a parsed value as it came: a request's `id` echoed into its
   * reply, or a whole object passed through. A number with no fractional
   * part is written as an integer, so `7` stays `7`.
   */
  value(v: JsonValue): JsonBuilder {
    if (v is String) {
      return this.string(v);
    }
    if (v is Box<f64>) {
      let n = v.value;
      // Past 2^53 an f64 holds only whole numbers, and converting one to
      // i64 could overflow, so it is written as a number as it is.
      let whole = if (n > -9007199254740992.0 && n < 9007199254740992.0) n as i64 else (0 as i64);
      if ((whole as f64) == n) {
        return this.i64(whole);
      }
      return this.f64(n);
    }
    if (v is Box<boolean>) {
      return this.bool(v.value);
    }
    if (v is JsonObject) {
      this.beginObject();
      v.forEach((key, item) => {
        this.key(key);
        this.value(item);
      });
      return this.endObject();
    }
    if (v is JsonArray) {
      this.beginArray();
      for (var i = 0; i < v.length; i += 1) {
        this.value(v[i]);
      }
      return this.endArray();
    }
    return this.nullValue();
  }

  // === Raw JSON (for pre-serialized content) ===

  raw(json: String): JsonBuilder {
    this.#writeCommaIfNeeded();
    this.#sb.append(json);
    this.#incrementCount();
    return this;
  }

  // === Get result / reset ===

  toString(): String {
    return this.#sb.toString();
  }

  clear(): void {
    this.#sb.clear();
    this.#depth = 0;
    this.#hasEntry = false;
    this.#needsValue = false;
  }

  // === Private helpers ===

  #writeCommaIfNeeded(): void {
    // After key(), needsValue is true, so no comma needed before the value
    if (this.#needsValue) {
      this.#needsValue = false;
      return;
    }
    // If we're inside a container and have written items, add comma
    if (this.#hasEntry) {
      this.#sb.appendByte(44);
    }
  }

  #incrementCount(): void {
    this.#hasEntry = this.#depth > 0;
    this.#needsValue = false;
  }
}
