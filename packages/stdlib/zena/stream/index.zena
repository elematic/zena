/**
 * Asynchronous data streaming between producers and consumers.
 *
 * Provides `Stream<T>` for reading data and `StreamWriter<T>` for writing data
 * with built-in backpressure. Elements move directly from writers to readers,
 * with writers awaiting until written data has been consumed.
 *
 * ## Examples
 *
 * ```zena
 * import { StreamWriter } from 'zena:stream';
 *
 * let writer = new StreamWriter<String>();
 * let stream = writer.stream;
 *
 * writer.write('first chunk');
 * writer.close();
 * ```
 */

import { Completer, AsyncStep, AsyncIterator, AsyncIterable, release } from 'zena:async';
import { Result, WithDefault, defaultValue, isFirstClass, unit } from 'zena:core';

/**
 * A second reference to a stream, which move checking does not track:
 * a writer's, and an iterator's, view of the stream its reader owns
 * (owner-futures.md §"Streams"). The stream's own state keeps the one
 * reader and the one writer apart.
 */
@intrinsic('share_reference')
declare function shareReference<scoped T>(value: T): T;

/** The write capability's entry points, unexported so a `Stream`
 * reference cannot reach them (docs/design/classes.md §9.4). */
symbol write;
symbol writeAll;
symbol close;
symbol nextStep;

/**
 * The readable end.
 *
 * `T` is `scoped` (owner-futures.md §"Streams"), so a stream may carry
 * owners. A single write parks its element in the stream's one slot
 * until a read takes it, and resolves `(true, _)`; if the reader stops
 * first, the write hands the element back, `(false, value)`, as
 * `tryComplete` hands back its loser. So the stream never releases or
 * drops an element. The bulk operations, `read(buf)` and `writeAll`,
 * copy through arrays and so need a first-class `T`; a bulk write parks
 * a slice of its writer's buffer instead of one element.
 *
 * Both operations are exclusive: one read and one write may be
 * pending at a time, and a concurrent operation throws. The read
 * buffer belongs to the caller: a read overwrites a prefix and
 * reports the count, and only `[0, count)` is meaningful.
 */
export class Stream<scoped T> implements AsyncIterable<T> {
  /** The parked single write's element, while `#slotFull`. */
  var #slot: WithDefault<T> = defaultValue<T>();
  var #slotFull: boolean = false;
  /** The parked single write's signal: `true` once a read took its
   * element, `false` once the reader stopped and left it in the slot
   * for the writer to take back. */
  var #slotTaken: Completer<boolean> | null = null;
  /** The one pending bulk write, at a first-class `T`: its slice, the
   * cursor into it, and the future its writer awaits. The slice
   * belongs to the stream until the write's future completes; reads
   * drain from `#writeOffset`, and the write completes once the slice
   * is fully consumed. */
  var #writeBuf: FixedArray<T> | null = null;
  var #writeOffset: i32 = 0;
  var #writeEnd: i32 = 0;
  var #writeDone: Completer<boolean> | null = null;
  /** The one pending bulk read, at a first-class `T`: its completer
   * and the caller's buffer, set together. A write rendezvouses with
   * it immediately. */
  var #pendingRead: Completer<i32> | null = null;
  var #pendingBuf: FixedArray<T> | null = null;
  /** The one pending `readOne` (or `for await` step), exclusive with
   * `#pendingRead`: `true` once an element waits in the slot or the
   * bulk slice, `false` at end-of-stream. */
  var #pendingOne: Completer<boolean> | null = null;
  var #closed: boolean = false;
  var #stopped: boolean = false;

  /**
   * Between 1 and `buf.length` elements into `buf`, or 0 at
   * end-of-stream. Completes the moment any elements exist — awaiting
   * it still costs the queue hop, per the always-async rule.
   */
  read(buf: FixedArray<T>): Future<i32> {
    if (isFirstClass<T>()) {
      this.#checkReadable();
      if (buf.length == 0) {
        throw new Error('zena:stream: read buffer is empty');
      }
      if (this.#stopped) {
        return Future.of(0);
      }
      if (this.#slotFull) {
        buf[0] = this.#takeSlot();
        return Future.of(1);
      }
      let src = this.#writeBuf;
      if (src != null) {
        let from = src;
        let remaining = this.#writeEnd - this.#writeOffset;
        let n = if (remaining < buf.length) remaining else buf.length;
        var i = 0;
        while (i < n) {
          buf[i] = from[this.#writeOffset + i];
          i += 1;
        }
        this.#writeOffset += n;
        this.#completeIfDrained();
        return Future.of(n);
      }
      if (this.#closed) {
        return Future.of(0);
      }
      let c = new Completer<i32>();
      this.#pendingRead = c;
      this.#pendingBuf = buf;
      return c.future;
    }
    throw new Error('zena:stream: read(buf) copies elements, so it needs a first-class element type');
  }

  /**
   * One element, or `none` at end-of-stream: a read of one that needs
   * no buffer of the caller's, for a consumer that takes elements one
   * at a time — an event loop, or the pump that carries a typed
   * stream across a component boundary. The same exclusivity as
   * `read`: one read of either kind may be pending.
   */
  readOne(): Future<Option<T>> {
    this.#checkReadable();
    if (this.#stopped) {
      return Future.of<Option<T>>(none);
    }
    if (this.#slotFull) {
      return Future.of<Option<T>>(some(this.#takeSlot()));
    }
    if (this.#hasBulk()) {
      return Future.of<Option<T>>(some(this.#drainOne()));
    }
    if (this.#closed) {
      return Future.of<Option<T>>(none);
    }
    let arrived = new Completer<boolean>();
    this.#pendingOne = arrived;
    return this.#readParked(arrived);
  }

  /** A `readOne` that waited for a write: its element, or `none` at
   * end-of-stream. */
  async #readParked(arrived: Completer<boolean>): Future<Option<T>> {
    if (await arrived.future) {
      if (this.#slotFull) {
        return some(this.#takeSlot());
      }
      if (this.#hasBulk()) {
        return some(this.#drainOne());
      }
    }
    return none;
  }

  /** The slot's element, for a read: its write resolves `(true, _)`. */
  #takeSlot(): T {
    let value = this.#slot as T;
    this.#slotFull = false;
    let taken = this.#slotTaken;
    if (taken != null) {
      this.#slotTaken = null;
      taken.complete(true);
    }
    return value;
  }

  /** Whether a bulk write's slice is parked, which only a first-class
   * `T` has. */
  #hasBulk(): boolean {
    if (isFirstClass<T>()) {
      return this.#writeBuf != null;
    }
    return false;
  }

  /** The parked slice's next element, when `#hasBulk()`. */
  #drainOne(): T {
    if (isFirstClass<T>()) {
      let from = this.#writeBuf as FixedArray<T>;
      let value = from[this.#writeOffset];
      this.#writeOffset += 1;
      this.#completeIfDrained();
      return value;
    }
    throw new Error('zena:stream: a bulk write needs a first-class element type');
  }

  /** The pending bulk write drained by reads: it completes `true` and
   * the slice clears. */
  #completeIfDrained(): void {
    if (isFirstClass<T>()) {
      if (this.#writeOffset >= this.#writeEnd) {
        let done = this.#writeDone as Completer<boolean>;
        this.#writeBuf = null;
        this.#writeDone = null;
        this.#writeOffset = 0;
        this.#writeEnd = 0;
        done.complete(true);
      }
    }
  }

  /** A read is a programming error while another read pends. */
  #checkReadable(): void {
    if (this.#pendingRead != null || this.#pendingOne != null) {
      throw new Error('zena:stream: one read may be pending at a time');
    }
  }

  /**
   * The reader disclaims the rest of the stream: a parked write gets
   * its element back, later writes are refused the same way, a parked
   * bulk write completes `false`, and later reads complete 0 or
   * `none`. Under cancellation this is what releasing the read end
   * performs; at a component boundary it is the readable-end drop.
   */
  stop(): void {
    if (this.#stopped) {
      return;
    }
    this.#stopped = true;
    // The element stays in the slot for its writer to take back.
    let taken = this.#slotTaken;
    if (taken != null) {
      this.#slotTaken = null;
      taken.complete(false);
    }
    if (isFirstClass<T>()) {
      // A bulk writer still holds its buffer.
      let done = this.#writeDone;
      if (done != null) {
        this.#writeBuf = null;
        this.#writeDone = null;
        this.#writeOffset = 0;
        this.#writeEnd = 0;
        done.complete(false);
      }
      let pending = this.#pendingRead;
      if (pending != null) {
        this.#pendingRead = null;
        this.#pendingBuf = null;
        pending.complete(0);
      }
    }
    let one = this.#pendingOne;
    if (one != null) {
      this.#pendingOne = null;
      one.complete(false);
    }
  }

  /** What dropping a stream of owners does: stop it, so a parked
   * write gets its element back (owner-futures.md §"Streams"). */
  [release](): void {
    this.stop();
  }

  /**
   * The writer's one-element write. Its future resolves `(true, _)`
   * once a read has taken the element, and `(false, value)`, handing
   * the element back, if the reader stopped before taking it or had
   * already stopped.
   */
  [write](value: T): Future<Result<void, T>> {
    if (this.#stopped) {
      return Future.of<Result<void, T>>((false, value));
    }
    this.#checkWritable();
    if (isFirstClass<T>()) {
      // A parked bulk read takes the element straight into its buffer.
      let pending = this.#pendingRead;
      if (pending != null) {
        let buf = this.#pendingBuf as FixedArray<T>;
        buf[0] = value;
        this.#pendingRead = null;
        this.#pendingBuf = null;
        pending.complete(1);
        return Future.of<Result<void, T>>((true, unit()));
      }
    }
    this.#slot = value;
    this.#slotFull = true;
    let taken = new Completer<boolean>();
    this.#slotTaken = taken;
    let one = this.#pendingOne;
    if (one != null) {
      this.#pendingOne = null;
      one.complete(true);
    }
    return this.#awaitTaken(taken);
  }

  /** A parked write's result: `(true, _)` once a read took the
   * element, or the element itself once the reader stopped. */
  async #awaitTaken(taken: Completer<boolean>): Future<Result<void, T>> {
    if (await taken.future) {
      return (true, unit());
    }
    let value = this.#slot as T;
    this.#slotFull = false;
    return (false, value);
  }

  /**
   * The writer's batch write: the first `count` elements of `buf`,
   * which belongs to the stream until the returned future completes.
   * This is the shape the WIT ABI's `stream.write` carries.
   *
   * The future completes with `true` once the LAST element has been
   * consumed by reads, and with `false` if the reader stopped before
   * that — in which case a prefix of the slice may already have been
   * delivered; `false` means "the rest will never be", not "nothing
   * was".
   */
  [writeAll](buf: FixedArray<T>, count: i32 = buf.length): Future<boolean> {
    if (isFirstClass<T>()) {
      if (count <= 0 || count > buf.length) {
        throw new Error('zena:stream: writeAll count out of range');
      }
      if (this.#stopped) {
        return Future.of(false as boolean);
      }
      this.#checkWritable();
      let pending = this.#pendingRead;
      if (pending != null) {
        // Rendezvous with the blocked reader first; the rest parks.
        let dst = this.#pendingBuf as FixedArray<T>;
        let n = if (count < dst.length) count else dst.length;
        var i = 0;
        while (i < n) {
          dst[i] = buf[i];
          i += 1;
        }
        this.#pendingRead = null;
        this.#pendingBuf = null;
        pending.complete(n);
        if (n >= count) {
          return Future.of(true as boolean);
        }
        let parked = this.#park(buf, count);
        this.#writeOffset = n;
        return parked;
      }
      let parked = this.#park(buf, count);
      // A blocked one-element reader drains the slice from here.
      let one = this.#pendingOne;
      if (one != null) {
        this.#pendingOne = null;
        one.complete(true);
      }
      return parked;
    }
    throw new Error('zena:stream: writeAll copies elements, so it needs a first-class element type');
  }

  /** A write is a programming error after `close` (the writer's own
   * end) and while another write pends (the ends are exclusive); a
   * STOPPED reader is not — callers check that first and refuse the
   * write, because the reader's disclaim is data, not a bug. */
  #checkWritable(): void {
    if (this.#closed) {
      throw new Error('zena:stream: write after close');
    }
    if (this.#slotFull || this.#writeDone != null) {
      throw new Error('zena:stream: one write may be pending at a time');
    }
  }

  /** Installs `buf[0, count)` as the one pending bulk write and
   * returns the future its writer awaits; reads drain it from
   * `#writeOffset` until it completes. Callers have already handled
   * the rendezvous-with-a-blocked-reader case. */
  #park(buf: FixedArray<T>, count: i32): Future<boolean> {
    let done = new Completer<boolean>();
    if (isFirstClass<T>()) {
      this.#writeBuf = buf;
    }
    this.#writeOffset = 0;
    this.#writeEnd = count;
    this.#writeDone = done;
    return done.future;
  }

  /** The writer's close: end-of-stream. A pending write's remainder
   * still delivers; once it drains, reads complete 0. */
  [close](): void {
    this.#closed = true;
    if (isFirstClass<T>()) {
      let pending = this.#pendingRead;
      if (pending != null) {
        this.#pendingRead = null;
        this.#pendingBuf = null;
        pending.complete(0);
      }
    }
    let one = this.#pendingOne;
    if (one != null) {
      this.#pendingOne = null;
      one.complete(false);
    }
  }

  [AsyncIterable.asyncIterator](): AsyncIterator<T> {
    return new StreamIterator<T>(shareReference(this));
  }

  /**
   * One `AsyncStep<T>` for `AsyncIterator`: drains an in-flight batch
   * slice synchronously as `Ready` steps (`(1, value, _)`), returns
   * `Done` (`(0, _, _)`) when closed or stopped, and parks a single
   * `Pending` future (`(2, _, this.readOne())`) only when awaiting the
   * next write.
   */
  [nextStep](): AsyncStep<T> {
    this.#checkReadable();
    if (this.#stopped) {
      return (0, _, _);
    }
    if (this.#slotFull) {
      return (1, this.#takeSlot(), _);
    }
    if (this.#hasBulk()) {
      return (1, this.#drainOne(), _);
    }
    if (this.#closed) {
      return (0, _, _);
    }
    return (2, _, this.readOne());
  }
}

/** A `for await` over a stream: it reads the stream its holder owns. */
final class StreamIterator<scoped T> implements AsyncIterator<T> {
  #stream: Stream<T>;
  new(stream: Stream<T>) : #stream = stream;

  next(): AsyncStep<T> {
    return this.#stream.[nextStep]();
  }

  /** The stream is its holder's to release, not the iterator's. */
  [release](): void {}
}

/**
 * The write capability. Hand out `.stream`; keep this — and keep it
 * singular: fan-in from several producers is an explicit multiplexing
 * adapter over one writer, not shared use of this object. At a
 * restricted `T` the stream has one reader, so `.stream` cannot be read
 * off the writer; make the pair with `StreamWriter.create` instead.
 *
 * A write's future is the backpressure: it completes when its
 * elements are consumed into reads — or refuses them when the reader
 * has stopped, which is data, not a failure.
 */
export class StreamWriter<scoped T> {
  stream = new Stream<T>();

  /**
   * A writer and its stream's readable end. At a restricted `T`, such
   * as a stream of owners, this is how the pair is made: the stream
   * belongs to its reader, and the writer keeps a reference that only
   * puts into it.
   */
  static create<scoped A>(): inline (StreamWriter<A>, Stream<A>) {
    let writer = new StreamWriter<A>();
    let stream = shareReference(writer.stream);
    return (writer, stream);
  }

  /** Delivers `value` to the reader: `(true, _)` once it is consumed,
   * or `(false, value)`, handing it back, if the reader stopped before
   * consuming it. */
  write(value: T): Future<Result<void, T>> {
    return this.stream.[write](value);
  }

  /**
   * Delivers the first `count` elements of `buf` (all of it by
   * default); the buffer belongs to the stream until the future
   * completes. `true` = every element was consumed; `false` = the
   * reader stopped first, and a prefix may already have been
   * delivered.
   */
  writeAll(buf: FixedArray<T>, count: i32 = buf.length): Future<boolean> {
    return this.stream.[writeAll](buf, count);
  }

  /** Ends the stream: after the pending write drains, reads
   * complete 0. */
  close(): void {
    this.stream.[close]();
  }

  /** What dropping a writer of owners does: end the stream, as
   * `close` does, and leave it to its reader. */
  [release](): void {
    this.close();
  }
}

export {
  Multicast, Subscription, Policy, Conflate, Waits, Buffered, conflate,
  waits, buffered,
} from './multicast.zena';

/** A stream longer than the most a read of it would take (`readAllBytes`). */
export final class StreamLimitError extends Error {
  /** The most it would take, in bytes. */
  limit: i64;

  new(limit: i64) : limit = limit, super(`the stream is longer than ${limit} bytes`);
}

/**
 * Every byte of `stream` from here to end-of-stream, in one array:
 * reads until a read returns 0. A response body is the usual case; a
 * stream that never ends never resolves. Bytes rather than any `T`
 * because a read needs a scratch buffer, and a buffer of `T` needs a
 * value of `T` to fill it with.
 *
 * With a `limit` of zero or more, a stream that runs past that many
 * bytes is stopped, and the read fails with `StreamLimitError`, so a
 * body someone else sends cannot fill memory.
 */
export async function readAllBytes(stream: Stream<u8>, limit: i64 = -1 as i64): Future<FixedArray<u8>> {
  let chunk = new Array<u8>.fixed(4096, 0);
  let collected = new Array<u8>();
  while (true) {
    let n = await stream.read(chunk);
    if (n == 0) {
      break;
    }
    if (limit >= (0 as i64) && ((collected.length + n) as i64) > limit) {
      stream.stop();
      throw new StreamLimitError(limit);
    }
    for (var i = 0; i < n; i += 1) {
      collected.push(chunk[i]);
    }
  }
  return FixedArray.from(collected);
}

/**
 * Every byte of `stream` to end-of-stream, decoded as text. Zena
 * strings are WTF-8 views over byte arrays, so nothing is re-encoded:
 * the bytes are collected and wrapped.
 */
export async function readAllText(stream: Stream<u8>, limit: i64 = -1 as i64): Future<String> {
  return String.fromBytes(await readAllBytes(stream, limit));
}

export final class TextStream extends Stream<u8> {
  #text: String;
  var #offset: i32 = 0;
  var #stopped: boolean = false;

  new(text: String) : #text = text, super();

  takeRemainingText(): String {
    if (this.#stopped || this.#offset >= this.#text.length) {
      return '';
    }
    if (this.#offset == 0) {
      this.#offset = this.#text.length;
      return this.#text;
    }
    let rem = this.#text.sliceBytes(this.#offset, this.#text.length);
    this.#offset = this.#text.length;
    return rem;
  }

  read(buf: FixedArray<u8>): Future<i32> {
    if (buf.length == 0) {
      throw new Error('zena:stream: read buffer is empty');
    }
    if (this.#stopped || this.#offset >= this.#text.length) {
      return Future.of(0);
    }
    let remaining = this.#text.length - this.#offset;
    let n = if (remaining < buf.length) remaining else buf.length;
    var i = 0;
    while (i < n) {
      buf[i] = this.#text.getByteAt(this.#offset + i) as u8;
      i += 1;
    }
    this.#offset += n;
    return Future.of(n);
  }

  readOne(): Future<Option<u8>> {
    if (this.#stopped || this.#offset >= this.#text.length) {
      return Future.of<Option<u8>>(none);
    }
    let b = this.#text.getByteAt(this.#offset) as u8;
    this.#offset += 1;
    return Future.of<Option<u8>>(some(b));
  }

  stop(): void {
    this.#stopped = true;
    super.stop();
  }
}

/**
 * A byte stream carrying `text`, then end-of-stream: a response or
 * request body built from a string.
 */
export function textStream(text: String): Stream<u8> {
  return new TextStream(text);
}

/**
 * A stream over an array of bytes: reads copy out of the array from a
 * cursor, with no writer and no pump coroutine, so a body or a file's
 * contents built from bytes in hand costs one object.
 */
final class BytesStream extends Stream<u8> {
  #bytes: FixedArray<u8>;
  var #offset: i32 = 0;
  var #stopped: boolean = false;

  new(bytes: FixedArray<u8>) : #bytes = bytes, super();

  read(buf: FixedArray<u8>): Future<i32> {
    if (buf.length == 0) {
      throw new Error('zena:stream: read buffer is empty');
    }
    if (this.#stopped || this.#offset >= this.#bytes.length) {
      return Future.of(0);
    }
    let remaining = this.#bytes.length - this.#offset;
    let n = if (remaining < buf.length) remaining else buf.length;
    var i = 0;
    while (i < n) {
      buf[i] = this.#bytes[this.#offset + i];
      i += 1;
    }
    this.#offset += n;
    return Future.of(n);
  }

  readOne(): Future<Option<u8>> {
    if (this.#stopped || this.#offset >= this.#bytes.length) {
      return Future.of<Option<u8>>(none);
    }
    let b = this.#bytes[this.#offset];
    this.#offset += 1;
    return Future.of<Option<u8>>(some(b));
  }

  stop(): void {
    this.#stopped = true;
    super.stop();
  }
}

/**
 * A byte stream carrying `bytes`, then end-of-stream: a response or
 * request body, or a file's new contents, built from bytes in hand.
 */
export function bytesStream(bytes: FixedArray<u8>): Stream<u8> {
  return new BytesStream(bytes);
}
