/**
 * @file
 *
 * The guest side of the Component Model's canonical ABI.
 *
 * A component-level `string` is bytes in linear memory, and a Zena
 * `String` is a view over a garbage-collected byte array. Nothing
 * converts between the two for free, so every `string` crossing the
 * boundary is a copy, in one of these functions.
 *
 * Nothing in a Zena program calls them. The compiler synthesizes a
 * wrapper around each export whose signature mentions `String` and the
 * wrapper calls these; `realloc` is named by the component's
 * canonical options rather than by any code at all. That is why they
 * live in the standard library instead of being built in IR: the work
 * is allocation and a copy loop, which Zena already says better than
 * `IrBuilder` would.
 *
 * Only the `component` target links this module, as one of that
 * target's runtime modules — loaded after the entry point and bound
 * under no name. See docs/design/component-emission.md, Part 4.
 */

import { Memory, defaultAllocator } from 'zena:memory';
import { String, Encoding } from 'zena:string';
import { newByteArray } from 'zena:byte-array';
import { Error } from 'zena:error';
import { FixedArray } from 'zena:fixed-array';
import { Array } from 'zena:array';

let mem = Memory.default;

/**
 * The canonical ABI's allocator, as the `realloc` option names it.
 *
 * The host calls this to build values in the guest's memory before
 * handing them over — a `string` argument to an export arrives already
 * copied into a buffer this returned. Its contract is C's `realloc`
 * plus an alignment: `ptr == 0` allocates, `newSize == 0` frees, and
 * anything else moves.
 *
 * `align` is not passed on to the allocator. `FreeListAllocator` puts
 * an 8-byte header in front of every block and rounds every size up to
 * 8, so the pointers it hands out are already 8-aligned, and the
 * canonical ABI never asks for more than 8. Going through
 * `allocAligned` instead would align a pointer *inside* a block and
 * return that, which `free` cannot then look up.
 *
 * Exhaustion throws, and this is the one function in the language the
 * host calls with no Zena frame above it — lowering an argument happens
 * before the export is entered. So the throw unwinds out of the module
 * and becomes a trap. That is the right outcome: returning 0 would make
 * the canonical ABI write the value at address 0 and carry on.
 */
export function realloc(
  ptr: i32,
  oldSize: i32,
  align: i32,
  newSize: i32
): i32 {
  if (newSize == 0) {
    if (ptr != 0) {
      defaultAllocator.free(ptr);
    }
    // Not zero: zero is the answer to "allocate nothing", and the host
    // is entitled to treat it as an aligned empty buffer rather than a
    // failure. `align` is a power of two, so it is aligned to itself.
    return align;
  }
  if (let (true, fresh) = defaultAllocator.alloc(newSize)) {
    if (ptr != 0) {
      var copied = oldSize;
      if (newSize < copied) {
        copied = newSize;
      }
      for (var i = 0; i < copied; i += 1) {
        mem[fresh + i] = mem[ptr + i];
      }
      defaultAllocator.free(ptr);
    }
    return fresh;
  }
  throw new Error('out of linear memory');
}

/**
 * A `string` as the guest sees it: `len` bytes of UTF-8 at `ptr`,
 * copied into a fresh Zena String.
 *
 * Copies rather than viewing, and does not free: a Zena String is a view
 * over a garbage-collected byte array, and there is no linear-memory
 * buffer it could keep. Whether the buffer was the guest's to release is
 * the caller's to know — see `releaseStringArgument` for the case where
 * it is.
 */
export function stringFromMemory(ptr: i32, len: i32): String {
  let bytes = newByteArray(len);
  for (var i = 0; i < len; i += 1) {
    __byte_array_set(bytes, i, mem[ptr + i]);
  }
  return String.fromByteArray(bytes, 0, len, Encoding.WTF8);
}

/**
 * Free the buffer a `string` argument arrived in.
 *
 * Lowering an argument into an export uses the *lifted* function's
 * `realloc`, so the bytes come out of this allocator and are the
 * guest's to release once they have been copied. The canonical ABI's
 * `post-return` is specified for the return value and cannot reach
 * them; a guest that never calls this leaks a block per string
 * argument, and the free list never gets it back.
 *
 * The guard is on the length rather than the pointer. A zero-length
 * string is lowered through `realloc(0, 0, 1, 0)`, which returns
 * `align` — an aligned address that was never allocated. Freeing that
 * would walk into a block header that is not there.
 */
export function releaseStringArgument(ptr: i32, len: i32): void {
  if (len > 0) {
    defaultAllocator.free(ptr);
  }
}

/**
 * A `string` result, as the host reads it: the bytes copied into linear
 * memory, and the address of an 8-byte area holding `(ptr, len)`.
 *
 * A single `string` flattens to two core values, one more than a lifted
 * function may return, so the canonical ABI returns it indirectly: the
 * core function's `i32` result is this area's address, and the host
 * reads the pair out of it. `postReturn` frees both halves once it
 * has.
 *
 * The bytes are copied verbatim, which `assertWtf8` guards — true for
 * every string a component can build today, since WTF-16 strings come
 * from JS interop and the `js` target is not this one, but an
 * assertion rather than an assumption.
 */
export function stringResultArea(s: String): i32 {
  assertWtf8(s);
  let len = s.length;
  let area = realloc(0, 0, 4, 8);
  let ptr = if (len == 0) 0 else realloc(0, 0, 1, len);
  for (var i = 0; i < len; i += 1) {
    mem[ptr + i] = s.getByteAt(i);
  }
  mem.setI32(area, ptr);
  mem.setI32(area + 4, len);
  return area;
}

/**
 * The `post-return` option: free what `stringResultArea` allocated.
 *
 * The host calls this after it has read the result out, which is the
 * only moment at which the guest can know the buffer is dead. Without
 * it the component still works and leaks a string per call.
 */
export function postReturn(area: i32): void {
  let ptr = mem.getI32(area);
  if (ptr != 0) {
    defaultAllocator.free(ptr);
  }
  defaultAllocator.free(area);
}

// ============================================================================
// The import side: staging arguments, lifting spilled results
// ============================================================================
//
// The functions above serve exports — the host initiates, and the
// canonical options name what it calls. These serve *imports*: the
// synthesized wrapper around a WIT-typed import calls them to place
// argument bytes before the lowered call and to read results back out
// after it. A result that flattens to more than one core value is
// spilled: the caller passes the address of a return area as a
// trailing parameter, the canonical ABI writes the flattened result
// there — allocating any buffers through `realloc` above, so they are
// the guest's to free — and the lift helpers below read it, copy into
// GC values, and release everything.

/**
 * The verbatim-copy assumption, asserted: a `string` crosses the
 * boundary as its bytes, unchanged, which is only right for WTF-8. A
 * string in any other encoding can only arrive through JS interop;
 * re-encoding at the boundary is future work, and until it exists a
 * loud error beats mojibake.
 */
let assertWtf8 = (s: String): void => {
  if (s.encoding != Encoding.WTF8) {
    throw new Error(
        'a non-WTF-8 string reached the component boundary; ' +
        're-encoding is not implemented yet');
  }
};

/**
 * Allocate and fill a staging buffer: `readAt(i)` supplies byte `i` of
 * `len`. Returns `(ptr, len)`, released by `releaseStringArgument`
 * once the lowered call has consumed it; an empty source is `(0, 0)` —
 * nothing is allocated, and the pointer half is never dereferenced.
 */
let stageBytes = (len: i32, readAt: (i: i32) => i32): (i32, i32) => {
  if (len == 0) {
    return (0, 0);
  }
  if (let (true, ptr) = defaultAllocator.alloc(len)) {
    for (var i = 0; i < len; i += 1) {
      mem[ptr + i] = readAt(i);
    }
    return (ptr, len);
  }
  throw new Error('out of linear memory');
};

/** Stage a String's bytes for a lowered call. */
export function stringToMemory(s: String): (i32, i32) {
  assertWtf8(s);
  return stageBytes(s.length, (i: i32) => s.getByteAt(i));
}

/**
 * Stage a byte buffer for a lowered call: `list<u8>` and `string` have
 * the same wire shape. The cast widens: `Memory`'s indexer trades in
 * `i32` — the language has no implicit numeric conversions, widening
 * included — so the `u8` element is spelled up to it.
 */
export function bytesToMemory(bytes: FixedArray<u8>): (i32, i32) {
  return stageBytes(bytes.length, (i: i32) => bytes[i] as i32);
}

/** Allocate the return area a spilled result is written into. */
export function resultArea(size: i32): i32 {
  return realloc(0, 0, 4, size);
}

/** The `(ptr, len)` pair a spilled result wrote at `area`. */
let takeBuffer = (area: i32): (i32, i32) => {
  let ptr = mem.getI32(area);
  let len = mem.getI32(area + 4);
  return (ptr, len);
};

/**
 * A spilled `string` result: copy the bytes out of the buffer the
 * canonical ABI allocated through `realloc`, then free the buffer and
 * the return area — after the copy, both are dead.
 */
export function liftStringResult(area: i32): String {
  let (ptr, len) = takeBuffer(area);
  let s = stringFromMemory(ptr, len);
  if (len > 0) {
    defaultAllocator.free(ptr);
  }
  defaultAllocator.free(area);
  return s;
}

/** A spilled `list<u8>` result, with the same ownership story. */
export function liftBytesResult(area: i32): FixedArray<u8> {
  let (ptr, len) = takeBuffer(area);
  let bytes = new FixedArray<u8>(len, 0);
  for (var i = 0; i < len; i += 1) {
    bytes[i] = mem[ptr + i] as u8;
  }
  if (len > 0) {
    defaultAllocator.free(ptr);
  }
  defaultAllocator.free(area);
  return bytes;
}

/**
 * A spilled `list<string>` result: `count` `(ptr, len)` pairs at
 * `base`, each string's bytes their own `realloc` allocation. Copy
 * them all out, then free every buffer, the pair array, and the area.
 */
export function liftStringListResult(area: i32): Array<String> {
  let (base, count) = takeBuffer(area);
  let out = new GrowableArray<String>();
  for (var i = 0; i < count; i += 1) {
    let ptr = mem.getI32(base + i * 8);
    let len = mem.getI32(base + i * 8 + 4);
    out.push(stringFromMemory(ptr, len));
    if (len > 0) {
      defaultAllocator.free(ptr);
    }
  }
  if (count > 0) {
    defaultAllocator.free(base);
  }
  defaultAllocator.free(area);
  return out;
}
