/**
 * Host HTTP server runner for zena-cli.
 */

import { Server as HostServer, ResponseWriter } from 'zena-cli:host/http-server';
import {
  Request as WireRequest,
  Response as WireResponse,
  ErrorCode
} from 'wasi:http/types';
import { fromWireRequest, toWireResponse, textResponse } from './wasi.zena';
import { App } from './app.zena';
import { Request } from './request.zena';
import { Response } from './response.zena';
import { Disposable, Option, Some } from 'zena:core';
import { Completer } from 'zena:async';

function unit(): void {}

let emptyHeadersList = new GrowableArray<(String, String)>(0);

function getEmptyHeaders(): Array<(String, String)> {
  return emptyHeadersList;
}

function completeTextResponse(
  wireReq: WireRequest,
  writer: ResponseWriter,
  req: Request,
  res: Response,
  body: String,
  defaultCt: String
): void {
  var reqOpt: Option<WireRequest> = none;
  if (req.isBodyConsumed) {
    req.close();
  } else {
    reqOpt = some(wireReq);
  }
  let ctOpt = res.contentTypeHeader;
  var ct = if (ctOpt != null) ctOpt as String else defaultCt;
  var headers = getEmptyHeaders();
  if (res.hasCustomHeaders) {
    let custom = new GrowableArray<(String, String)>();
    res.forEachHeader((name: String, val: String): void => {
      if (name == 'content-type') {
        ct = val;
      } else {
        custom.push((name, val));
      }
    });
    headers = custom;
  }
  ResponseWriter.completeText(writer, reqOpt, res.statusCode as u16, ct, headers, body);
}

type RequestTuple = (WireRequest, ResponseWriter);

/**
 * A running HTTP server instance.
 */
export class Server {
  #hostServer: HostServer;
  #app: App;
  var #closed: boolean = false;
  var #running: boolean = false;
  var #isDone: boolean = false;
  var #doneCompleter: Completer<void> = new Completer<void>();

  new(app: App, port: u16)
    : #hostServer = HostServer.create(port),
      #app = app;

  /**
   * The port this server is listening on.
   */
  port: u16 {
    get {
      return this.#hostServer.port();
    }
  }

  /**
   * True if the server is still open.
   */
  isOpen: boolean {
    get {
      return !this.#closed;
    }
  }

  /**
   * Future that completes when the server is closed or stops running.
   */
  done: Future<void> {
    get {
      return this.#doneCompleter.future;
    }
  }

  /**
   * True if the server has finished running and is closed.
   */
  isDone: boolean {
    get {
      return this.#isDone;
    }
  }

  /**
   * Closes the server and releases its socket.
   */
  close(): void {
    if (!this.#closed) {
      this.#closed = true;
      this.#hostServer.close();
      this.#isDone = true;
      this.#doneCompleter.tryComplete(unit());
    }
  }

  /**
   * Runs the server accept loop.
   */
  async start(): Future<void> {
    if (this.#running) return;
    this.#running = true;
    let stream = this.#hostServer.listen();
    if (!this.#closed) {
      let firstOpt = await stream.readOne();
      if (firstOpt is Some<RequestTuple>) {
        let first = (firstOpt as Some<RequestTuple>).value;
        let (firstReq, firstWriter) = first;
        this.#dispatch(firstReq, firstWriter);
        let batch = new Array<RequestTuple>.fixed(64, first);
        while (!this.#closed) {
          let n = await stream.read(batch);
          if (n == 0) {
            break;
          }
          var i = 0;
          while (i < n) {
            let (wireReq, writer) = batch[i];
            this.#dispatch(wireReq, writer);
            i += 1;
          }
        }
      }
    }
    this.#isDone = true;
    this.#doneCompleter.tryComplete(unit());
  }

  async #dispatch(wireReq: WireRequest, writer: ResponseWriter): Future<void> {
    try {
      let req = fromWireRequest(wireReq);
      let res = new Response();
      await this.#app.handleRequest(req, res);
      let b = res.body;
      if (b is String) {
        completeTextResponse(wireReq, writer, req, res, b as String, 'text/plain; charset=utf-8');
      } else if (b == null) {
        completeTextResponse(wireReq, writer, req, res, '', '');
      } else {
        req.close();
        writer.respond(toWireResponse(res));
        writer.[Disposable.dispose]();
      }
    } catch (e) {
      let errRes = textResponse('Internal Server Error\n', 500);
      writer.respond(errRes);
      writer.[Disposable.dispose]();
    }
    return;
  }
}

