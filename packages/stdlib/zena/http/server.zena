/**
 * Host HTTP server runner for zena-cli.
 */

import { Server as HostServer, ResponseWriter } from 'zena-cli:host/http-server';
import { Request as WireRequest } from 'wasi:http/types';
import { toWireResponse, textResponse } from './wasi.zena';
import { App } from './app.zena';
import { Request } from './request.zena';
import { Response } from './response.zena';
import { Disposable, Own, Some, Unmanaged, adopt, disown, unit } from 'zena:core';
import { Completer } from 'zena:async';
import { Stream } from 'zena:stream';

let emptyHeadersList = new GrowableArray<(String, String)>(0);

function getEmptyHeaders(): Array<(String, String)> {
  return emptyHeadersList;
}

/** Answers with `res`'s status, headers and text `body` in one host call. */
function completeTextResponse(
  writer: Own<ResponseWriter>,
  res: Response,
  body: String,
  defaultCt: String
) {
  let code = res.statusCode;
  let wireStatus = if (code >= 100 && code <= 599) code as u16 else 0 as u16;
  let ctOpt = res.contentTypeHeader;
  var hasCustomCt = false;
  var headers = getEmptyHeaders();
  if (res.hasCustomHeaders) {
    let custom = new GrowableArray<(String, String)>();
    res.forEachHeader((name, val) => {
      if (name == 'content-type') {
        hasCustomCt = true;
      }
      custom.push((name, val));
    });
    headers = custom;
  }
  let ct = ctOpt ?? (if (hasCustomCt) '' else defaultCt);
  ResponseWriter.completeText(writer, wireStatus, ct, headers, body);
}

type RequestPair = (Own<WireRequest>, Own<ResponseWriter>);

function createHostServer(port: u16): Own<HostServer> {
  match (HostServer.create(port)) {
    case (true, let srv): { return srv; }
    case (false, let why): { throw new Error(why); }
  }
}

/**
 * What a server and its accept loop share. Both close the host server:
 * the server's owner by `close()` or by dropping it, and the loop when
 * its scope is cancelled. So the host server is held unmanaged here,
 * and `closeServer` closes and releases it once, whichever comes first.
 */
final class ServerState {
  var host: Unmanaged<HostServer> | null;
  port: u16;
  done = new Completer<void>();
  var started = false;

  new(host: Unmanaged<HostServer>, this.port) : host = host;
}

function bind(port: u16) {
  let host = createHostServer(port);
  let bound = host.port();
  return new ServerState(disown(host), bound);
}

/** Closes the host server and releases it, the first time it is called. */
function closeServer(state: ServerState) {
  let host = state.host;
  if (host == null) {
    return;
  }
  state.host = null;
  let owner = adopt(host);
  owner.close();
  state.done.tryComplete(unit());
}

/**
 * A running HTTP server.
 *
 * A resource class, held as `Own<Server>`: its owner closes it when it
 * leaves scope, so the server runs for as long as something holds it.
 * `await server.done` holds it until it closes. `keepOpen()` trades the
 * owner for a handle that keeps it running until `close()`, which an
 * ordinary object can store.
 */
export resource class Server {
  #state: ServerState;
  #app: App;

  /** Binds the listener; `start` runs the accept loop. */
  new(app: App, port: u16) : #state = bind(port), #app = app;

  /**
   * The port this server is listening on.
   */
  port: u16 {
    get {
      return this.#state.port;
    }
  }

  /**
   * True if the server is still open.
   */
  isOpen: boolean {
    get {
      return this.#state.host != null;
    }
  }

  /**
   * Future that completes when the server is closed or stops running.
   */
  done: Future<void> {
    get {
      return this.#state.done.future;
    }
  }

  /**
   * True if the server has finished running and is closed.
   */
  isDone: boolean {
    get {
      return this.#state.host == null;
    }
  }

  /**
   * Closes the server and releases its socket.
   */
  close(): void {
    closeServer(this.#state);
  }

  /**
   * Keeps the server running after its owner's scope ends: the handle
   * this returns never closes it implicitly, and an ordinary class or
   * record can store it. The server then runs until `close()`, or until
   * the scope it was started in is cancelled.
   */
  keepOpen(this: Own<this>): Unmanaged<Server> {
    return disown(this);
  }

  /**
   * Runs the accept loop in the background, once.
   */
  start(): void {
    let state = this.#state;
    if (state.started) {
      return;
    }
    state.started = true;
    serve(this.#app, state);
  }

  [Disposable.dispose](this: Own<this>): void {
    this.close();
  }
}

/**
 * The host's stream of requests. `listen` starts the pump that reads
 * it; created inside `shielded`, the pump belongs to a scope no
 * cancellation reaches, so cancelling the server's scope does not tear
 * it down with a host read in flight. `serve`'s `finally` stops the
 * stream instead, and the pump drops its end itself.
 */
async function listenShielded(host: Unmanaged<HostServer>): Future<Stream<RequestPair>> {
  shielded {
    return host.listen();
  }
}

/**
 * The accept loop: hands each request the host delivers to `app`,
 * until the server closes, or its scope is cancelled, which closes it.
 */
async function serve(app: App, state: ServerState): Future<void> {
  let host = state.host;
  if (host == null) {
    return;
  }
  let requests = await listenShielded(host);
  try {
    while (state.host != null) {
      if (let Some {value} = await requests.readOne()) {
        let (wire, writer) = value;
        dispatch(app, wire, writer);
      } else {
        break;
      }
    }
  } finally {
    requests.stop();
    closeServer(state);
  }
}

/** Runs one request through `app` and answers it. */
async function dispatch(app: App, wire: Own<WireRequest>, writer: Own<ResponseWriter>): Future<void> {
  let res = new Response();
  var sent = false;
  try {
    try {
      await app.handleRequest(new Request.fromWire(wire), res);
    } catch (e) {
      ResponseWriter.respond(writer, textResponse('Internal Server Error\n', 500));
      sent = true;
      return;
    }
    let b = res.body;
    if (b is String && (b.length > 0 || !res.hasCustomHeaders)) {
      completeTextResponse(writer, res, b, 'text/plain; charset=utf-8');
      sent = true;
    } else if (b == null) {
      completeTextResponse(writer, res, '', '');
      sent = true;
    } else {
      let wireRes = try {
        toWireResponse(res)
      } catch (e) {
        textResponse('Internal Server Error\n', 500)
      };
      ResponseWriter.respond(writer, wireRes);
      sent = true;
    }
  } finally {
    if (!sent) {
      res.body = null;
    }
  }
}
