/**
 * Cross-Origin Resource Sharing (CORS) middleware.
 *
 * Ported from Zipadee's `@zipadee/cors`.
 */

import { StringBuilder } from 'zena:core';
import { div } from 'zena:math';
import { Duration } from 'zena:time';
import { Middleware } from './middleware.zena';
import { Request } from './request.zena';
import { Response } from './response.zena';

let NS_PER_SECOND: i64 = 1000000000;
let DEFAULT_ALLOW_METHODS = 'GET,HEAD,PUT,POST,DELETE,PATCH';

/**
 * Callback returning the allowed origin for a request, or `null` to
 * disable CORS for that request. May return synchronously or as a `Future`.
 */
export type OriginFn = (req: Request) => String | null | Future<String | null>;

/**
 * An origin specification: a static origin string, `null` to disable CORS,
 * or a per-request callback.
 */
export type Origin = String | null | OriginFn;

/** Synchronous callback deciding whether credentials are allowed for a request. */
export type SyncCredentialsFn = (req: Request) => boolean;

/** Asynchronous callback deciding whether credentials are allowed for a request. */
export type AsyncCredentialsFn = (req: Request) => Future<boolean>;

/** Callback deciding whether credentials are allowed for a request. */
export type CredentialsFn = SyncCredentialsFn | AsyncCredentialsFn;

/** Options for `cors`. Every field is optional. */
export type CorsOptions = {
  /**
   * `Access-Control-Allow-Origin` header value, `null` to disable CORS,
   * or a function returning the origin (or `null` to disable CORS for
   * that request). Defaults to `'*'`.
   */
  origin?: Origin,
  /**
   * `Access-Control-Allow-Methods` header value for preflight requests.
   * Defaults to `'GET,HEAD,PUT,POST,DELETE,PATCH'`. Pass `null` to omit
   * the header.
   */
  allowMethods?: String | Array<String> | null,
  /**
   * `Access-Control-Allow-Headers` header value for preflight requests.
   * If absent, mirrors the request's `Access-Control-Request-Headers`
   * header when present.
   */
  allowHeaders?: String | Array<String>,
  /**
   * Set `Cross-Origin-Opener-Policy: same-origin` and
   * `Cross-Origin-Embedder-Policy: require-corp`. Off if absent.
   */
  secureContext?: boolean,
  /**
   * `Access-Control-Expose-Headers` header value on non-preflight
   * responses.
   */
  exposeHeaders?: String | Array<String>,
  /**
   * `Access-Control-Max-Age` duration for preflight responses, sent in
   * whole seconds.
   */
  maxAge?: Duration,
  /**
   * Include `Access-Control-Allow-Credentials: true`. Off if absent.
   */
  credentials?: boolean,
  /**
   * Per-request callback deciding whether to include
   * `Access-Control-Allow-Credentials: true`. Takes precedence over
   * `credentials` when provided.
   */
  credentialsFor?: CredentialsFn,
};

let joinComma = (items: Array<String>): String => {
  if (items.length == 0) {
    return '';
  }
  if (items.length == 1) {
    return items[0];
  }
  let sb = new StringBuilder();
  var i = 0;
  while (i < items.length) {
    if (i > 0) {
      sb.append(',');
    }
    sb.append(items[i]);
    i += 1;
  }
  return sb.toString();
};

let normalizeHeaderList = (value: String | Array<String>): String => {
  if (value is String) {
    return value as String;
  }
  return joinComma(value as Array<String>);
};

/**
 * Middleware that sets Cross-Origin Resource Sharing (CORS) headers on
 * responses and answers preflight `OPTIONS` requests.
 *
 * ## Examples
 *
 * ```zena
 * let app = new App();
 * app.use(cors());
 * ```
 */
export function cors(options: CorsOptions = {}): Middleware {
  var originOpt: Origin = '*';
  if (let {origin} = options) {
    originOpt = origin;
  }

  var allowMethods: String | null = DEFAULT_ALLOW_METHODS;
  if (let {allowMethods: givenMethods} = options) {
    if (givenMethods == null) {
      allowMethods = null;
    } else {
      allowMethods = normalizeHeaderList(givenMethods as (String | Array<String>));
    }
  }

  var exposeHeaders: String | null = null;
  if (let {exposeHeaders: givenExpose} = options) {
    exposeHeaders = normalizeHeaderList(givenExpose);
  }

  var allowHeaders: String | null = null;
  if (let {allowHeaders: givenAllow} = options) {
    allowHeaders = normalizeHeaderList(givenAllow);
  }

  var secureContext = false;
  if (let {secureContext: givenSecure} = options) {
    secureContext = givenSecure;
  }

  var maxAge: String | null = null;
  if (let {maxAge: givenMaxAge} = options) {
    let seconds = div(givenMaxAge as i64, NS_PER_SECOND);
    maxAge = i64ToString(seconds);
  }

  var staticCredentials = false;
  if (let {credentials: givenCredentials} = options) {
    staticCredentials = givenCredentials;
  }

  var credentialsFor: CredentialsFn | null = null;
  if (let {credentialsFor: givenCredentialsFor} = options) {
    credentialsFor = givenCredentialsFor;
  }

  return async (req, res, next) => {
    var origin: String | null = null;
    if (originOpt == null) {
      origin = null;
    } else if (originOpt is String) {
      origin = originOpt as String;
    } else {
      let fn = originOpt as OriginFn;
      origin = await fn(req);
    }

    var credentials = staticCredentials;
    if (credentialsFor != null) {
      let fn = credentialsFor as CredentialsFn;
      if (fn is SyncCredentialsFn) {
        credentials = (fn as SyncCredentialsFn)(req);
      } else {
        credentials = await (fn as AsyncCredentialsFn)(req);
      }
    }

    let requestOrigin = req.getHeader('Origin');

    if (requestOrigin == null) {
      // If the Origin header is not present, we can only respond with
      // `Access-Control-Allow-Origin: *`, and only if the origin option is '*'
      // and credentials is false.
      if (credentials) {
        await next();
        return;
      }

      if (origin != null && (origin as String) == '*') {
        res.setHeader('Access-Control-Allow-Origin', '*');
        await next();
        return;
      }
    }

    if (credentials && origin != null && (origin as String) == '*') {
      // Disallow wildcard origin with credentials.
      await next();
      return;
    }

    if (origin == null || (origin as String).length == 0) {
      await next();
      return;
    }

    let resolvedOrigin = origin as String;

    if (req.method == 'OPTIONS') {
      // Preflight request: requires Access-Control-Request-Method.
      if (!req.hasHeader('Access-Control-Request-Method')) {
        await next();
        return;
      }

      res.setHeader('Access-Control-Allow-Origin', resolvedOrigin);
      res.statusCode = 204;

      if (allowMethods != null && (allowMethods as String).length > 0) {
        res.setHeader('Access-Control-Allow-Methods', allowMethods as String);
      }

      if (credentials) {
        res.setHeader('Access-Control-Allow-Credentials', 'true');
      }

      if (secureContext) {
        res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
        res.setHeader('Cross-Origin-Embedder-Policy', 'require-corp');
      }

      if (maxAge != null) {
        res.setHeader('Access-Control-Max-Age', maxAge as String);
      }

      var effectiveAllowHeaders = allowHeaders;
      if (effectiveAllowHeaders == null) {
        effectiveAllowHeaders = req.getHeader('Access-Control-Request-Headers');
      }
      if (effectiveAllowHeaders != null && (effectiveAllowHeaders as String).length > 0) {
        res.setHeader('Access-Control-Allow-Headers', effectiveAllowHeaders as String);
      }
      return;
    }

    res.setHeader('Access-Control-Allow-Origin', resolvedOrigin);

    if (exposeHeaders != null && (exposeHeaders as String).length > 0) {
      res.setHeader('Access-Control-Expose-Headers', exposeHeaders as String);
    }

    if (credentials) {
      res.setHeader('Access-Control-Allow-Credentials', 'true');
    }

    if (secureContext) {
      res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
      res.setHeader('Cross-Origin-Embedder-Policy', 'require-corp');
    }

    await next();
  };
}
