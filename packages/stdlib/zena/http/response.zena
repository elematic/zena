/**
 * HTTP Response abstraction.
 */

import { Option, Some } from 'zena:core';
import { Stream } from 'zena:stream';
import { HTMLPartial } from './html.zena';

/**
 * Valid body representations for a response.
 */
export type ResponseBody = String | FixedArray<u8> | Stream<u8> | HTMLPartial | null;

/**
 * Represents an HTTP response being built by server middleware.
 *
 * Defaults to status code 404 until a body or status code is set.
 * Setting `body` automatically updates `statusCode` to 200 if it was not
 * explicitly set beforehand.
 */
export class Response {
  var #statusCode: i32 = 404;
  var #statusCodeSet: boolean = false;
  var #body: ResponseBody = null;
  var #contentType: String | null = null;
  var #headers: Map<String, GrowableArray<String>> | null = null;

  #ensureHeaders(): Map<String, GrowableArray<String>> {
    if (this.#headers == null) {
      this.#headers = new Map<String, GrowableArray<String>>();
    }
    return this.#headers as Map<String, GrowableArray<String>>;
  }

  /**
   * True if custom headers (other than the fast-path content-type) have been set.
   */
  hasCustomHeaders: boolean {
    get {
      return this.#headers != null;
    }
  }

  /**
   * Fast-path content-type header value if set without custom multi-value headers.
   */
  contentTypeHeader: String | null {
    get {
      return this.#contentType;
    }
  }

  /**
   * The HTTP status code.
   */
  statusCode: i32 {
    get {
      return this.#statusCode;
    }
    set(value) {
      this.#statusCode = value;
      this.#statusCodeSet = true;
    }
  }

  /**
   * Whether the status code was explicitly set.
   */
  statusCodeSet: boolean {
    get {
      return this.#statusCodeSet;
    }
  }

  /**
   * The response body.
   */
  body: ResponseBody {
    get {
      return this.#body;
    }
    set(value) {
      if (!this.#statusCodeSet) {
        this.#statusCode = 200;
      }
      this.#body = value;
    }
  }

  /**
   * Sets a response header, replacing any previous values for this header.
   */
  setHeader(name: String, value: String): void {
    let key = name.asciiLowerCase();
    if (key == 'content-type') {
      this.#contentType = value;
      if (this.#headers != null) {
        (this.#headers as Map<String, GrowableArray<String>>).delete('content-type');
      }
      return;
    }
    let headers = this.#ensureHeaders();
    let values = new GrowableArray<String>(1);
    values.push(value);
    headers[key] = values;
  }

  /**
   * Appends a value to a response header without removing previous values.
   */
  appendHeader(name: String, value: String): void {
    let key = name.asciiLowerCase();
    if (key == 'content-type') {
      if (this.#contentType == null && this.#headers == null) {
        this.#contentType = value;
        return;
      }
      let headers = this.#ensureHeaders();
      if (this.#contentType != null) {
        let initial = new GrowableArray<String>(2);
        initial.push(this.#contentType as String);
        initial.push(value);
        this.#contentType = null;
        headers['content-type'] = initial;
        return;
      }
    }
    let headers = this.#ensureHeaders();
    if (let (true, existing) = headers.get(key)) {
      existing.push(value);
    } else {
      let values = new GrowableArray<String>(1);
      values.push(value);
      headers[key] = values;
    }
  }

  /**
   * Returns the first value of a response header, or null if absent.
   */
  getHeader(name: String): String | null {
    let key = name.asciiLowerCase();
    if (key == 'content-type' && this.#contentType != null) {
      return this.#contentType;
    }
    if (this.#headers == null) {
      return null;
    }
    if (let (true, values) = (this.#headers as Map<String, GrowableArray<String>>).get(key)) {
      if (values.length > 0) {
        return values[0];
      }
    }
    return null;
  }

  /**
   * Returns all values of a response header.
   */
  getHeaders(name: String): Array<String> {
    let key = name.asciiLowerCase();
    if (key == 'content-type' && this.#contentType != null) {
      let values = new GrowableArray<String>(1);
      values.push(this.#contentType as String);
      return values;
    }
    if (this.#headers != null) {
      if (let (true, values) = (this.#headers as Map<String, GrowableArray<String>>).get(key)) {
        return values;
      }
    }
    return new GrowableArray<String>(0);
  }

  /**
   * Returns true if the response header is present.
   */
  hasHeader(name: String): boolean {
    let key = name.asciiLowerCase();
    if (key == 'content-type' && this.#contentType != null) {
      return true;
    }
    if (this.#headers == null) {
      return false;
    }
    return (this.#headers as Map<String, GrowableArray<String>>).has(key);
  }

  /**
   * Removes a response header.
   */
  removeHeader(name: String): void {
    let key = name.asciiLowerCase();
    if (key == 'content-type') {
      this.#contentType = null;
    }
    if (this.#headers != null) {
      (this.#headers as Map<String, GrowableArray<String>>).delete(key);
    }
  }

  /**
   * Returns all header names currently set on this response.
   */
  headerNames(): Array<String> {
    let extra = if (this.#contentType != null) 1 else 0;
    let mapSize = if (this.#headers != null) (this.#headers as Map<String, GrowableArray<String>>).size else 0;
    let names = new GrowableArray<String>(extra + mapSize);
    if (this.#contentType != null) {
      names.push('content-type');
    }
    if (this.#headers != null) {
      for (let entry in (this.#headers as Map<String, GrowableArray<String>>)) {
        names.push(entry.key);
      }
    }
    return names;
  }

  /**
   * Calls `fn(name, value)` for each custom header entry on this response.
   */
  forEachHeader(fn: (name: String, value: String) => void): void {
    if (this.#headers == null) {
      return;
    }
    for (let entry in (this.#headers as Map<String, GrowableArray<String>>)) {
      let name = entry.key;
      let values = entry.value;
      var i = 0;
      while (i < values.length) {
        fn(name, values[i]);
        i += 1;
      }
    }
  }

  /**
   * The Content-Type header.
   */
  type: String | null {
    get {
      return this.#contentType ?? this.getHeader('content-type');
    }
    set(value) {
      if (value != null) {
        this.#contentType = value;
        if (this.#headers != null) {
          (this.#headers as Map<String, GrowableArray<String>>).delete('content-type');
        }
      } else {
        this.#contentType = null;
        if (this.#headers != null) {
          (this.#headers as Map<String, GrowableArray<String>>).delete('content-type');
        }
      }
    }
  }

  /**
   * Sets Content-Length header.
   */
  setLength(value: i32): void {
    this.setHeader('content-length', i32ToString(value));
  }

  /**
   * The Content-Length header as an integer, or none if absent.
   */
  length: Option<i32> {
    get {
      let h = this.getHeader('content-length');
      if (h != null) {
        if (let (true, val) = parseI32(h)) {
          return some(val);
        }
      }
      return none;
    }
    set(value) {
      if (value is Some<i32>) {
        this.setHeader('content-length', i32ToString(value.value));
      } else {
        this.removeHeader('content-length');
      }
    }
  }

  /**
   * Performs an HTTP redirect.
   *
   * Sets the `Location` header to `url`. If the current status code is not
   * a 3xx redirect status (300-399), it defaults to 302.
   */
  redirect(url: String, alt: String = '/'): void {
    this.setHeader('location', url);
    if (!(this.#statusCode >= 300 && this.#statusCode < 400)) {
      this.statusCode = 302;
    }
    if (this.#body == null) {
      this.type = 'text/plain; charset=utf-8';
      this.body = `Redirecting to ${url}.`;
    }
  }
}
