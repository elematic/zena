/**
 * WASI HTTP wire adapter for WebAssembly components (wasi:http/types@0.3.0).
 */

import {
  Fields,
  Request as WireRequest,
  Response as WireResponse,
  ErrorCode,
  Method,
  MethodGet, MethodHead, MethodPost, MethodPut, MethodDelete,
  MethodConnect, MethodOptions, MethodTrace, MethodPatch, MethodOther,
  Scheme, SchemeHTTP, SchemeHTTPS, SchemeOther
} from 'wasi:http/types';
import { Completer, DeferredFuture } from 'zena:async';
import { HashMap } from 'zena:collections';
import { Disposable, Outcome, Ok, Option, Some } from 'zena:core';
import { Stream, textStream, readAllText } from 'zena:stream';
import { URL } from 'zena:url';
import { Request, RequestSource, placeholderUrl, placeholderHeaders, fallbackUrl } from './request.zena';
import { Response, bytesStream } from './response.zena';
import { App as BaseApp, AppOptions } from './app.zena';
import { HTMLPartial, htmlStream } from './html.zena';

export { Request as WireRequest, Response as WireResponse, ErrorCode, Fields } from 'wasi:http/types';
export { AppOptions } from './app.zena';

function unit(): void {}

let emptyTrailersFuture: Future<Outcome<Option<Fields>, ErrorCode>> =
    Future.of<Outcome<Option<Fields>, ErrorCode>>(new Ok<Option<Fields>, ErrorCode>(none));

let bytesTextPlain: FixedArray<u8> = 'text/plain; charset=utf-8'.toBytes();
let bytesTextHtml: FixedArray<u8> = 'text/html; charset=utf-8'.toBytes();
let bytesAppJsonUtf8: FixedArray<u8> = 'application/json; charset=utf-8'.toBytes();
let bytesAppJson: FixedArray<u8> = 'application/json'.toBytes();
let bytesOctetStream: FixedArray<u8> = 'application/octet-stream'.toBytes();

function buildSmallLengths(): FixedArray<FixedArray<u8>> {
  let table = new Array<FixedArray<u8>>.fixed(256, ''.toBytes());
  var i = 0;
  while (i < 256) {
    table[i] = i32ToString(i).toBytes();
    i += 1;
  }
  return table;
}
let smallLengthBytes: FixedArray<FixedArray<u8>> = buildSmallLengths();

function lengthToBytes(len: i32): FixedArray<u8> {
  if (len >= 0 && len < 256) {
    return smallLengthBytes[len];
  }
  return i32ToString(len).toBytes();
}

function contentTypeToBytes(ct: String): FixedArray<u8> {
  if (ct == 'application/json; charset=utf-8') return bytesAppJsonUtf8;
  if (ct == 'application/json') return bytesAppJson;
  if (ct == 'text/plain; charset=utf-8') return bytesTextPlain;
  if (ct == 'text/html; charset=utf-8') return bytesTextHtml;
  if (ct == 'application/octet-stream') return bytesOctetStream;
  return ct.toBytes();
}

function methodToString(m: Method): String {
  if (m is MethodGet) return 'GET';
  if (m is MethodPost) return 'POST';
  if (m is MethodPut) return 'PUT';
  if (m is MethodDelete) return 'DELETE';
  if (m is MethodHead) return 'HEAD';
  if (m is MethodPatch) return 'PATCH';
  if (m is MethodOptions) return 'OPTIONS';
  if (m is MethodConnect) return 'CONNECT';
  if (m is MethodTrace) return 'TRACE';
  if (m is MethodOther) return (m as MethodOther).value.asciiUpperCase();
  return 'GET';
}

function schemeToString(s: Scheme): String {
  if (s is SchemeHTTP) return 'http';
  if (s is SchemeHTTPS) return 'https';
  if (s is SchemeOther) return (s as SchemeOther).value;
  return 'http';
}

export async function drainFuture<T>(f: Future<T>): Future<void> {
  try {
    await f;
  } catch (e) {}
}

function disposeDeferred<T>(f: Future<T>): void {
  if (f is DeferredFuture<T>) {
    (f as DeferredFuture<T>).[Disposable.dispose]();
  }
}

final class WireRequestSource implements RequestSource {
  #wire: WireRequest;
  var #consumed: boolean = false;

  new(wire: WireRequest) : #wire = wire {}

  loadMethod(): String {
    return methodToString(this.#wire.getMethod());
  }

  loadPath(): String {
    let pathOpt = this.#wire.getPathWithQuery();
    let pathWithQuery = if (pathOpt is Some<String>) (pathOpt as Some<String>).value else '/';
    let fullPath = if (pathWithQuery.startsWith('/')) pathWithQuery else '/' + pathWithQuery;
    var i = 0;
    while (i < fullPath.length) {
      if (fullPath.getByteAt(i) == 0x3F) { // '?'
        return if (i == 0) '/' else fullPath.sliceBytes(0, i);
      }
      i += 1;
    }
    return if (fullPath.length == 0) '/' else fullPath;
  }

  loadHeaders(): HashMap<String, GrowableArray<String>> {
    let wireHeaders = this.#wire.getHeaders();
    let entries = wireHeaders.copyAll();
    wireHeaders.[Disposable.dispose]();
    let headers = new HashMap<String, GrowableArray<String>>();
    for (let entry in entries) {
      let (fieldName, fieldValueBytes) = entry;
      let key = fieldName.asciiLowerCase();
      let val = String.fromBytes(fieldValueBytes);
      if (let (true, existing) = headers.get(key)) {
        existing.push(val);
      } else {
        let list = new GrowableArray<String>(1);
        list.push(val);
        headers[key] = list;
      }
    }
    return headers;
  }

  loadUrl(): URL {
    let schemeOpt = this.#wire.getScheme();
    let scheme = if (schemeOpt is Some<Scheme>) schemeToString((schemeOpt as Some<Scheme>).value) else 'http';
    let authOpt = this.#wire.getAuthority();
    var auth = if (authOpt is Some<String>) (authOpt as Some<String>).value else '';
    if (auth.length == 0) {
      let wireHeaders = this.#wire.getHeaders();
      let hostEntries = wireHeaders.get('host');
      wireHeaders.[Disposable.dispose]();
      if (hostEntries.length > 0) {
        auth = String.fromBytes(hostEntries[0]);
      }
    }
    if (auth.length == 0) auth = 'localhost';
    let pathOpt = this.#wire.getPathWithQuery();
    let pathWithQuery = if (pathOpt is Some<String>) (pathOpt as Some<String>).value else '/';
    let fullPath = if (pathWithQuery.startsWith('/')) pathWithQuery else '/' + pathWithQuery;
    let href = `${scheme}://${auth}${fullPath}`;
    let parsedUrl = URL.parse(href, null);
    return if (parsedUrl != null) parsedUrl as URL else fallbackUrl();
  }

  loadBody(): Stream<u8> {
    this.#consumed = true;
    let received = Future.of<Outcome<void, ErrorCode>>(new Ok<void, ErrorCode>(unit()));
    let (bodyStream, trailers) = WireRequest.consumeBody(this.#wire, received);
    disposeDeferred(trailers);
    return bodyStream;
  }

  close(): void {
    if (!this.#consumed) {
      this.#wire.[Disposable.dispose]();
    }
  }
}

/**
 * Creates a Request from a low-level WASI HTTP Request resource.
 */
export function fromWireRequest(wire: WireRequest): Request {
  return new Request(placeholderUrl, 'GET', placeholderHeaders, null, new WireRequestSource(wire));
}

/**
 * Converts a Response into a low-level WASI WireResponse resource along with its transmitted future.
 */
export function toWireResponseWithTransmitted(res: Response): (WireResponse, Future<Outcome<void, ErrorCode>>) {
  let fields = Fields.create();
  let ct = res.contentTypeHeader;
  var hasCt = ct != null;
  if (hasCt) {
    fields.append('content-type', contentTypeToBytes(ct as String));
  }
  let hasCustom = res.hasCustomHeaders;
  var hasCl = false;
  if (hasCustom) {
    res.forEachHeader((name: String, val: String): void => {
      if (name == 'content-type') {
        hasCt = true;
        fields.append(name, contentTypeToBytes(val));
      } else {
        if (name == 'content-length') {
          hasCl = true;
        }
        fields.append(name, val.toBytes());
      }
    });
  }

  let b = res.body;
  var streamOpt: Option<Stream<u8>> = none;

  if (b is String) {
    let s = b as String;
    if (!hasCt) {
      fields.append('content-type', bytesTextPlain);
    }
    if (!hasCl) {
      fields.append('content-length', lengthToBytes(s.length));
    }
    streamOpt = some(textStream(s));
  } else if (b is HTMLPartial) {
    if (!hasCt) {
      fields.append('content-type', bytesTextHtml);
    }
    streamOpt = some(htmlStream(b as HTMLPartial, 1024));
  } else if (b is FixedArray<u8>) {
    let bytes = b as FixedArray<u8>;
    if (!hasCt) {
      fields.append('content-type', bytesOctetStream);
    }
    if (!hasCl) {
      fields.append('content-length', lengthToBytes(bytes.length));
    }
    streamOpt = some(bytesStream(bytes));
  } else if (b is Stream<u8>) {
    streamOpt = some(b as Stream<u8>);
  }

  let (wireResp, transmitted) = WireResponse.new_(fields, streamOpt, emptyTrailersFuture);
  let status = res.statusCode;
  if (status != 200) {
    wireResp.setStatusCode(status as u16);
  }
  return (wireResp, transmitted);
}

/**
 * Converts a Response into a low-level WASI WireResponse resource.
 */
export function toWireResponse(res: Response): WireResponse {
  let (wireResp, transmitted) = toWireResponseWithTransmitted(res);
  disposeDeferred(transmitted);
  return wireResp;
}

/**
 * Dispatches an incoming WASI wire request through an App's middleware pipeline.
 */
export async function handleWireRequest(app: BaseApp, wire: WireRequest): Future<Outcome<WireResponse, ErrorCode>> {
  let req = fromWireRequest(wire);
  let res = new Response();
  await app.handleRequest(req, res);
  req.close();
  return new Ok<WireResponse, ErrorCode>(toWireResponse(res));
}

/**
 * An HTTP application with native WASI handler integration.
 */
export class App extends BaseApp {
  async handle(wireRequest: WireRequest): Future<Outcome<WireResponse, ErrorCode>> {
    return handleWireRequest(this, wireRequest);
  }
}

/**
 * Builds a low-level wire response carrying `body` as text.
 */
export function textResponse(
  body: String,
  status: i32 = 200,
  contentType: String = 'text/plain; charset=utf-8'
): WireResponse {
  let headers = Fields.create();
  if (let (false, _, err) = headers.append('content-type', contentTypeToBytes(contentType))) {
    throw new Error('zena:http: the content-type header was refused');
  }
  let (response, transmitted) =
      WireResponse.new_(headers, some(textStream(body)), emptyTrailersFuture);
  disposeDeferred(transmitted);
  if (status != 200) {
    response.setStatusCode(status as u16);
  }
  return response;
}

/**
 * Reads a wire request's body to the end and decodes it as text.
 */
export async function requestText(request: WireRequest): Future<String> {
  let received = new Completer<Outcome<void, ErrorCode>>();
  let (body, trailers) = WireRequest.consumeBody(request, received.future);
  disposeDeferred(trailers);
  let text = await readAllText(body);
  received.complete(new Ok<void, ErrorCode>(unit()));
  return text;
}
