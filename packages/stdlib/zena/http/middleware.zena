/**
 * Middleware types, composition, and mounting.
 */

import { Own } from 'zena:core';
import { Request } from './request.zena';
import { Response } from './response.zena';

/**
 * A callback function invoked by middleware to pass control, and the
 * request, to the downstream middleware.
 */
export type NextFunction = (req: Own<Request>) => Future<void>;

/**
 * A middleware function handling an HTTP request and response pair.
 *
 * The middleware owns the request: it hands it on with `next(req)`, or
 * answers itself and drops it. After `next(req)` the request is the
 * downstream middleware's, so read what you need from it first; a
 * second `next(req)`, or any use of `req` after it, is a compile error.
 */
export type Middleware = (req: Own<Request>, res: Response, next: NextFunction) => Future<void>;

/**
 * Composes an array of middleware functions into a single middleware.
 *
 * Middleware executes in the order given, unwinding in reverse order as
 * downstream futures resolve (the onion model).
 */
export function compose(middleware: Array<Middleware>): Middleware {
  let len = middleware.length;
  if (len == 0) {
    return (req: Own<Request>, res: Response, next: NextFunction) => next(req);
  }
  if (len == 1) {
    return middleware[0];
  }
  return (req: Own<Request>, res: Response, next: NextFunction) => {
    var currentNext = next;
    var i = len - 1;
    while (i >= 0) {
      let fn = middleware[i];
      let downstreamNext = currentNext;
      currentNext = (downstream: Own<Request>) => fn(downstream, res, downstreamNext);
      i -= 1;
    }
    return currentNext(req);
  };
}

/**
 * Mounts middleware at a URL path prefix.
 *
 * If `req.path` starts with `prefix`, `req.path` is rewritten to the matched subpath
 * before `middleware` runs, and restored when it passes the request on with `next(req)`.
 * If `req.path` does not start with `prefix`, `middleware` is bypassed and `next(req)` is called.
 */
export function mount(prefix: String, middleware: Middleware): Middleware {
  return (req: Own<Request>, res: Response, next: NextFunction) => {
    let originalPath = req.path;
    let subpath = matchPath(prefix, originalPath);
    if (subpath == null) {
      return next(req);
    }
    req.path = subpath;
    return middleware(req, res, (passed) => {
      passed.path = originalPath;
      return next(passed);
    });
  };
}

/**
 * Checks if `path` starts with `prefix` and returns the subpath.
 *
 * Returns `null` if `path` does not start with `prefix`.
 *
 * ## Examples
 *
 * ```zena
 * matchPath('/prefix', '/prefix')       // => '/'
 * matchPath('/prefix/', '/prefix')      // => null
 * matchPath('/prefix', '/prefix/users') // => '/users'
 * matchPath('/prefix/', '/prefix/users')// => '/users'
 * matchPath('/prefix', '/other')        // => null
 * ```
 */
export function matchPath(prefix: String, path: String): String | null {
  if (!path.startsWith(prefix)) {
    return null;
  }
  let subPath = path.sliceBytes(prefix.length, path.length);
  if (subPath.length == 0) {
    return '/';
  }
  if (prefix.length > 0 && prefix.getByteAt(prefix.length - 1) == 0x2F) {
    return '/' + subPath;
  }
  if (subPath.getByteAt(0) != 0x2F) {
    return null;
  }
  return subPath;
}

