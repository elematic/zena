/**
 * HTTP Application server orchestration.
 */

import { Request } from './request.zena';
import { Response } from './response.zena';
import { Middleware, NextFunction, compose } from './middleware.zena';
import { HttpError } from './error.zena';
import { Server } from './server.zena';
import { checkCancellation } from 'zena:async';
import { Stream } from 'zena:stream';

function unit(): void {}

/**
 * Configuration options for the HTTP App.
 */
export class AppOptions {
  /**
   * If true, include error details in responses when errors are thrown.
   */
  var dev: boolean = false;
}

/**
 * An HTTP application managing a middleware pipeline.
 *
 * ## Examples
 *
 * ```zena
 * import { App } from 'zena:http';
 *
 * export async function main(): Future<void> {
 *   let app = new App();
 *
 *   app.use(async (req, res, next) => {
 *     res.body = 'Hello, world!';
 *   });
 *
 *   let server = await app.listen(8080);
 *   console.log(`Listening on http://127.0.0.1:${server.port}`);
 * }
 * ```
 */
export class App {
  var #middleware = new GrowableArray<Middleware>();
  var #pipeline: Middleware | null = null;
  #completedVoid: Future<void> = Future.of(unit());
  var #noopNext: NextFunction | null = null;
  var #dev: boolean = false;

  new(options: AppOptions | null = null) {
    if (options != null) {
      this.#dev = (options as AppOptions).dev;
    }
  }

  /**
   * Adds a middleware to the application pipeline.
   */
  use(middleware: Middleware): void {
    this.#middleware.push(middleware);
    this.#pipeline = null;
  }

  /**
   * Directly dispatches a Request and Response through the application pipeline.
   *
   * Catches thrown `HttpError` instances and translates them to HTTP status codes
   * and responses. Any uncaught general `Error` results in a 500 Internal Server Error.
   */
  async handleRequest(req: Request, res: Response): Future<void> {
    var pipeline = this.#pipeline;
    if (pipeline == null) {
      let composed = compose(this.#middleware);
      this.#pipeline = composed;
      pipeline = composed;
    }
    var noop = this.#noopNext;
    if (noop == null) {
      let completed = this.#completedVoid;
      let fn: NextFunction = (): Future<void> => completed;
      this.#noopNext = fn;
      noop = fn;
    }
    try {
      await (pipeline as Middleware)(req, res, noop as NextFunction);
    } catch (e) {
      this.#handleError(res, e);
    }
  }

  /**
   * Binds an HTTP server on `127.0.0.1:{port}` (or an ephemeral port when
   * `port` is 0) and starts the accept loop in the background.
   *
   * Returns a `Future<Server>` that resolves once the listener is bound, or
   * rejects if binding fails (such as when `port` is already in use).
   * Cancelling the enclosing `CancelScope` closes the server and releases
   * its socket.
   *
   * Unlike Zipadee's `App.listen()`, which returns `Promise<void>` because
   * Zipadee's `App` owns a single internal `http.Server` (`app.server`),
   * `zena:http` returns the `Server` instance so callers can inspect the
   * bound `server.port`, close it directly, or run multiple servers from one
   * `App`.
   */
  async listen(port: u16 = 8080 as u16): Future<Server> {
    checkCancellation();
    let server = new Server(this, port);
    server.start();
    return server;
  }

  #handleError(res: Response, e: Error): void {
    // The error body replaces whatever was set, and nothing will read a
    // stream body now: stop it, so a file's handle is released.
    let abandoned = res.body;
    if (abandoned is Stream<u8>) {
      (abandoned as Stream<u8>).stop();
    }
    if (e is HttpError) {
      let httpErr = e as HttpError;
      res.statusCode = httpErr.status;
      var msg = httpErr.message;
      if (this.#dev && httpErr.privateMessage != null) {
        msg = msg + '\n' + (httpErr.privateMessage as String);
      }
      res.type = 'text/plain; charset=utf-8';
      res.body = msg;
    } else {
      res.statusCode = 500;
      var msg = 'Internal Server Error';
      if (this.#dev) {
        msg = msg + '\n' + e.message;
      }
      res.type = 'text/plain; charset=utf-8';
      res.body = msg;
    }
  }
}
