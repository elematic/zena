/**
 * HTTP server and middleware library for Zena.
 *
 * Provides an Express-like, Zipadee-inspired HTTP framework targeting WebAssembly GC
 * components implementing `wasi:http`.
 */

export { App, AppOptions } from './app.zena';
export {
  WireRequest, WireResponse, ErrorCode, Fields,
  fromWireRequest, toWireResponse, handleWireRequest,
  textResponse, requestText
} from './wasi.zena';
export { Request } from './request.zena';
export { Response, ResponseBody } from './response.zena';
export { bytesStream } from 'zena:stream';
export { Middleware, NextFunction, compose, mount, matchPath } from './middleware.zena';
export { HttpError, statusText } from './error.zena';
export { Router, RouteHandler } from './router.zena';
export { Server } from './server.zena';
export { send, serve, SendOptions, httpDate } from './static.zena';
export { mimeType } from './mime.zena';
export { CookieOptions, parseCookies, serializeCookie } from './cookie.zena';
export {
  cors, CorsOptions, Origin, OriginFn,
  CredentialsFn, SyncCredentialsFn, AsyncCredentialsFn
} from './cors.zena';
export {
  html,
  HTMLPartial,
  HTMLIterator,
  UnsafeHTML,
  unsafeHTML,
  escape,
  TemplateValue,
  PipeOptions,
  pipeToStream,
  htmlStream,
  collectResult
