/**
 * Media types by file extension.
 */

import { extname } from 'zena:path';

/**
 * The `Content-Type` for a file, from its extension (case-insensitive),
 * or null for an extension not listed. Text types carry
 * `charset=utf-8`.
 *
 * ## Examples
 *
 * ```zena
 * mimeType('index.html')    // 'text/html; charset=utf-8'
 * mimeType('logo.SVG')      // 'image/svg+xml'
 * mimeType('archive.xyz')   // null
 * ```
 */
export function mimeType(path: String): String | null {
  let ext = extname(path).asciiLowerCase();
  return match (ext) {
    case '.html': 'text/html; charset=utf-8'
    case '.htm': 'text/html; charset=utf-8'
    case '.css': 'text/css; charset=utf-8'
    case '.js': 'text/javascript; charset=utf-8'
    case '.mjs': 'text/javascript; charset=utf-8'
    case '.json': 'application/json; charset=utf-8'
    case '.map': 'application/json; charset=utf-8'
    case '.webmanifest': 'application/manifest+json; charset=utf-8'
    case '.txt': 'text/plain; charset=utf-8'
    case '.md': 'text/markdown; charset=utf-8'
    case '.csv': 'text/csv; charset=utf-8'
    case '.xml': 'application/xml; charset=utf-8'
    case '.zena': 'text/plain; charset=utf-8'
    case '.wit': 'text/plain; charset=utf-8'
    case '.svg': 'image/svg+xml'
    case '.png': 'image/png'
    case '.jpg': 'image/jpeg'
    case '.jpeg': 'image/jpeg'
    case '.gif': 'image/gif'
    case '.webp': 'image/webp'
    case '.avif': 'image/avif'
    case '.ico': 'image/x-icon'
    case '.woff': 'font/woff'
    case '.woff2': 'font/woff2'
    case '.ttf': 'font/ttf'
    case '.otf': 'font/otf'
    case '.wasm': 'application/wasm'
    case '.pdf': 'application/pdf'
    case '.zip': 'application/zip'
    case '.gz': 'application/gzip'
    case '.mp3': 'audio/mpeg'
    case '.wav': 'audio/wav'
    case '.ogg': 'audio/ogg'
    case '.mp4': 'video/mp4'
    case '.webm': 'video/webm'
    case _: null
  };
}
