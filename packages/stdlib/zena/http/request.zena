/**
 * HTTP Request abstraction.
 */

import { HashMap } from 'zena:collections';
import { Stream, StreamWriter, readAllBytes, readAllText } from 'zena:stream';
import { URL } from 'zena:url';

export function fallbackUrl(): URL {
  return URL.parse('http://localhost/', null) as URL;
}
export let placeholderUrl: URL = fallbackUrl();
export let placeholderHeaders: HashMap<String, GrowableArray<String>> = new HashMap<String, GrowableArray<String>>();

export interface RequestSource {
  loadMethod(): String;
  loadPath(): String;
  loadUrl(): URL;
  loadHeaders(): HashMap<String, GrowableArray<String>>;
  loadBody(): Stream<u8>;
  close(): void;
}

/**
 * Represents an incoming HTTP request.
 *
 * Provides typed access to the method, URL, headers, and body stream,
 * as well as a mutable `path` property used by routers and prefix mounting.
 */
export class Request {
  var #source: RequestSource | null = null;
  var #url: URL;
  var #urlLoaded: boolean = true;
  var #method: String;
  var #methodLoaded: boolean = true;
  var #headers: HashMap<String, GrowableArray<String>>;
  var #headersLoaded: boolean = true;
  var #path: String | null = null;
  var #bodyStream: Stream<u8> | null = null;
  var #bodyText: String | null = null;
  var #bodyBytes: FixedArray<u8> | null = null;

  /**
   * Constructs a Request with explicit parameters or a lazy RequestSource.
   */
  new(
    url: URL,
    method: String = 'GET',
    headers: HashMap<String, GrowableArray<String>> = new HashMap<String, GrowableArray<String>>(),
    bodyStream: Stream<u8> | null = null,
    source: RequestSource | null = null
  ) : #source = source,
      #url = url,
      #urlLoaded = source == null,
      #method = if (source == null) method.asciiUpperCase() else method,
      #methodLoaded = source == null,
      #headers = headers,
      #headersLoaded = source == null,
      #bodyStream = bodyStream {}

  /**
   * True if the request body stream has been accessed.
   */
  isBodyConsumed: boolean {
    get {
      return this.#bodyStream != null;
    }
  }

  /**
   * Releases any underlying wire request or body stream resources.
   */
  close(): void {
    if (this.#bodyStream != null) {
      (this.#bodyStream as Stream<u8>).stop();
    }
    if (this.#source != null) {
      let src = this.#source as RequestSource;
      this.#source = null;
      src.close();
    }
  }

  /**
   * Constructs a Request from a string URL and optional headers.
   */
  new fromUrl(
    urlString: String,
    method: String = 'GET',
    headers: Map<String, String> | null = null,
    bodyStream: Stream<u8> | null = null
  ) : #url = if (URL.parse(urlString, null) != null) URL.parse(urlString, null) as URL else fallbackUrl(),
      #method = method.asciiUpperCase(),
      #headers = new HashMap<String, GrowableArray<String>>(),
      #bodyStream = bodyStream {
    if (headers != null) {
      let h = headers as Map<String, String>;
      for (let entry in h) {
        let key = entry.key.asciiLowerCase();
        let arr = new GrowableArray<String>(1);
        arr.push(entry.value);
        this.#headers[key] = arr;
      }
    }
  }

  #ensureHeaders(): HashMap<String, GrowableArray<String>> {
    if (!this.#headersLoaded) {
      this.#headersLoaded = true;
      if (this.#source != null) {
        this.#headers = (this.#source as RequestSource).loadHeaders();
      }
    }
    return this.#headers;
  }

  /**
   * The HTTP method in uppercase ('GET', 'POST', 'PUT', etc.).
   */
  method: String {
    get {
      if (!this.#methodLoaded) {
        this.#methodLoaded = true;
        if (this.#source != null) {
          this.#method = (this.#source as RequestSource).loadMethod();
        }
      }
      return this.#method;
    }
  }

  /**
   * The request URL.
   */
  url: URL {
    get {
      if (!this.#urlLoaded) {
        this.#urlLoaded = true;
        if (this.#source != null) {
          this.#url = (this.#source as RequestSource).loadUrl();
        }
      }
      return this.#url;
    }
  }

  /**
   * The request path, defaults to `url.pathname` or `'/'`.
   *
   * Middleware like `mount()` or routers can rewrite `path` to represent
   * the current subpath within a mounted handler hierarchy.
   */
  path: String {
    get {
      if (this.#path != null) {
        return this.#path as String;
      }
      if (this.#source != null && this.#urlLoaded == false) {
        let p = (this.#source as RequestSource).loadPath();
        this.#path = p;
        return p;
      }
      let p = this.url.pathname;
      return if (p.length == 0) '/' else p;
    }
    set(value) {
      this.#path = value;
    }
  }

  /**
   * The origin of the request URL (e.g. "https://example.com:8080").
   */
  origin: String {
    get {
      return this.url.origin();
    }
  }

  /**
   * The protocol of the request URL without the trailing colon (e.g. "http", "https").
   */
  protocol: String {
    get {
      let proto = this.url.protocol;
      if (proto.length > 0 && proto.getByteAt(proto.length - 1) == 0x3A) { // ':'
        return proto.sliceBytes(0, proto.length - 1);
      }
      return proto;
    }
  }

  /**
   * The Host of the request.
   */
  host: String {
    get {
      return this.url.host();
    }
  }

  /**
   * The query string including the leading '?', or empty if none.
   */
  query: String {
    get {
      return this.url.search;
    }
  }

  /**
   * Returns the first value of the header with the given name, or null if absent.
   */
  getHeader(name: String): String | null {
    let headers = this.#ensureHeaders();
    let key = name.asciiLowerCase();
    if (let (true, values) = headers.get(key)) {
      if (values.length > 0) {
        return values[0];
      }
    }
    return null;
  }

  /**
   * Returns all values of the header with the given name.
   */
  getHeaders(name: String): Array<String> {
    let headers = this.#ensureHeaders();
    let key = name.asciiLowerCase();
    if (let (true, values) = headers.get(key)) {
      return values;
    }
    return new GrowableArray<String>(0);
  }

  /**
   * Returns true if the header with the given name is present.
   */
  hasHeader(name: String): boolean {
    let headers = this.#ensureHeaders();
    return headers.has(name.asciiLowerCase());
  }

  /**
   * Returns all header names present in the request.
   */
  headerNames(): Array<String> {
    let headers = this.#ensureHeaders();
    let names = new GrowableArray<String>(headers.size);
    for (let entry in headers) {
      names.push(entry.key);
    }
    return names;
  }

  /**
   * The body stream of the request.
   */
  body: Stream<u8> {
    get {
      if (this.#bodyStream != null) {
        return this.#bodyStream as Stream<u8>;
      }
      if (this.#source != null) {
        let s = (this.#source as RequestSource).loadBody();
        this.#bodyStream = s;
        return s;
      }
      let emptyWriter = new StreamWriter<u8>();
      emptyWriter.close();
      this.#bodyStream = emptyWriter.stream;
      return emptyWriter.stream;
    }
  }

  /**
   * Reads and decodes the full request body as text.
   */
  async text(): Future<String> {
    if (this.#bodyText != null) {
      return this.#bodyText as String;
    }
    let str = await readAllText(this.body);
    this.#bodyText = str;
    return str;
  }

  /**
   * Reads the full request body as bytes.
   */
  async bytes(): Future<FixedArray<u8>> {
    if (this.#bodyBytes != null) {
      return this.#bodyBytes as FixedArray<u8>;
    }
    let b = await readAllBytes(this.body);
    this.#bodyBytes = b;
    return b;
  }
}
