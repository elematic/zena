/**
 * HTTP Request abstraction.
 */

import { HashMap } from 'zena:collections';
import { Borrow, Disposable, Own, Result, Some, parseI64, unit } from 'zena:core';
import {
  Request as WireRequest,
  ErrorCode,
  Method,
  MethodGet, MethodHead, MethodPost, MethodPut, MethodDelete,
  MethodConnect, MethodOptions, MethodTrace, MethodPatch, MethodOther,
  Scheme, SchemeHTTP, SchemeHTTPS, SchemeOther
} from 'wasi:http/types';
import { Stream, StreamLimitError, StreamWriter, readAllBytes } from 'zena:stream';
import { HttpError } from './error.zena';
import { URL } from 'zena:url';
import { parseCookies } from './cookie.zena';

export function fallbackUrl(): URL {
  return URL.parse('http://localhost/', null) as URL;
}

function methodToString(m: Method) {
  if (m is MethodGet) return 'GET';
  if (m is MethodPost) return 'POST';
  if (m is MethodPut) return 'PUT';
  if (m is MethodDelete) return 'DELETE';
  if (m is MethodHead) return 'HEAD';
  if (m is MethodPatch) return 'PATCH';
  if (m is MethodOptions) return 'OPTIONS';
  if (m is MethodConnect) return 'CONNECT';
  if (m is MethodTrace) return 'TRACE';
  if (m is MethodOther) return m.value.asciiUpperCase();
  return 'GET';
}

function schemeToString(s: Scheme) {
  if (s is SchemeHTTP) return 'http';
  if (s is SchemeHTTPS) return 'https';
  if (s is SchemeOther) return s.value;
  return 'http';
}

/** The wire request's path and query, with a leading `/`. */
function wirePathWithQuery(wire: Borrow<WireRequest>) {
  let pathOpt = wire.getPathWithQuery();
  let pathWithQuery = if (pathOpt is Some<String>) pathOpt.value else '/';
  return if (pathWithQuery.startsWith('/')) pathWithQuery else '/' + pathWithQuery;
}

/** The wire request's path, without the query. */
function wirePath(wire: Borrow<WireRequest>) {
  let fullPath = wirePathWithQuery(wire);
  var i = 0;
  while (i < fullPath.length) {
    if (fullPath.getByteAt(i) == 0x3F) { // '?'
      return if (i == 0) '/' else fullPath.sliceBytes(0, i);
    }
    i += 1;
  }
  return if (fullPath.length == 0) '/' else fullPath;
}

function wireHeaders(wire: Borrow<WireRequest>) {
  let fields = wire.getHeaders();
  let headers = new HashMap<String, GrowableArray<String>>();
  for (let (fieldName, fieldValueBytes) in fields.copyAll()) {
    let key = fieldName.asciiLowerCase();
    let val = String.fromBytes(fieldValueBytes);
    if (let (true, existing) = headers.get(key)) {
      existing.push(val);
    } else {
      let list = new GrowableArray<String>(1);
      list.push(val);
      headers[key] = list;
    }
  }
  return headers;
}

function wireUrl(wire: Borrow<WireRequest>) {
  let schemeOpt = wire.getScheme();
  let scheme = if (schemeOpt is Some<Scheme>) schemeToString(schemeOpt.value) else 'http';
  let authOpt = wire.getAuthority();
  var auth = if (authOpt is Some<String>) authOpt.value else '';
  if (auth.length == 0) {
    let fields = wire.getHeaders();
    let hostEntries = fields.get('host');
    if (hostEntries.length > 0) {
      auth = String.fromBytes(hostEntries[0]);
    }
  }
  if (auth.length == 0) auth = 'localhost';
  let href = `${scheme}://${auth}${wirePathWithQuery(wire)}`;
  return URL.parse(href, null) ?? fallbackUrl();
}

/** A stream that has already ended: the body of a request without one. */
function emptyBody() {
  let writer = new StreamWriter<u8>();
  writer.close();
  return writer.stream;
}

/**
 * Reads `body` to the end, within `limit` bytes when it is not -1. A
 * body over the limit is refused with an `HttpError` of 413, which
 * `App` answers: one whose declared `Content-Length` is over it before
 * anything is read, and one that does not say once it passes it.
 */
async function readBody(body: Stream<u8>, limit: i64, declared: String | null): Future<FixedArray<u8>> {
  if (limit >= (0 as i64) && declared != null) {
    if (let (true, length) = parseI64(declared.trim())) {
      if (length > limit) {
        body.stop();
        throw new HttpError(413);
      }
    }
  }
  return try {
    await readAllBytes(body, limit)
  } catch (e) {
    if (e is StreamLimitError) {
      throw new HttpError(413);
    }
    throw e;
  };
}

async function decodeText(bytes: Future<FixedArray<u8>>): Future<String> {
  return String.fromBytes(await bytes);
}

/**
 * Represents an incoming HTTP request.
 *
 * Provides typed access to the method, URL, headers, and body stream,
 * as well as a mutable `path` property used by routers and prefix mounting.
 *
 * A resource class, held as `Own<Request>`: a handler owns the request
 * it is given and hands it on with `next(req)`, so whoever holds it last
 * reads or releases its body. Reading the body consumes the request
 * (`text`, `bytes`, `body`); read anything else you need from it first.
 * A request dropped with its body unread releases the wire request,
 * and with it the body the host holds.
 */
export resource class Request {
  /** The incoming request, until reading the body takes it. */
  var #wire: Own<WireRequest> | null = null;
  var #url: URL | null = null;
  var #method: String | null = null;
  var #headers: HashMap<String, GrowableArray<String>> | null = null;
  var #path: String | null = null;
  var #bodyStream: Stream<u8> | null = null;
  /**
   * The most bytes `text()` and `bytes()` read of the body, or -1 for no
   * limit. A body over it is refused with an `HttpError` of 413, which
   * `App` answers: one whose `Content-Length` is over it before anything
   * is read, and one that does not say once it passes it. A server sets
   * it before its handlers read, and a handler that takes more raises it.
   */
  var bodyLimit: i64 = -1 as i64;

  /**
   * Constructs a Request with explicit parameters.
   */
  new(
    url: URL,
    method: String = 'GET',
    headers: HashMap<String, GrowableArray<String>> = new HashMap<String, GrowableArray<String>>(),
    bodyStream: Stream<u8> | null = null
  ) : #url = url,
      #method = method.asciiUpperCase(),
      #headers = headers,
      #bodyStream = bodyStream {}

  /**
   * Constructs a Request from a string URL and optional headers.
   */
  new fromUrl(
    urlString: String,
    method: String = 'GET',
    headers: Map<String, String> | null = null,
    bodyStream: Stream<u8> | null = null
  ) : #url = URL.parse(urlString, null) ?? fallbackUrl(),
      #method = method.asciiUpperCase(),
      #bodyStream = bodyStream {
    let byName = new HashMap<String, GrowableArray<String>>();
    if (headers != null) {
      for (let entry in headers) {
        let arr = new GrowableArray<String>(1);
        arr.push(entry.value);
        byName[entry.key.asciiLowerCase()] = arr;
      }
    }
    this.#headers = byName;
  }

  /**
   * Constructs a Request over an incoming `wasi:http` request, which it
   * reads from as its members are asked for.
   */
  new fromWire(wire: Own<WireRequest>) : #wire = wire;

  #ensureHeaders(): HashMap<String, GrowableArray<String>> {
    let known = this.#headers;
    if (known != null) {
      return known;
    }
    let wire = this.#wire;
    let headers = if (wire != null) wireHeaders(wire)
        else new HashMap<String, GrowableArray<String>>();
    this.#headers = headers;
    return headers;
  }

  /**
   * The HTTP method in uppercase ('GET', 'POST', 'PUT', etc.).
   */
  method: String {
    get {
      let known = this.#method;
      if (known != null) {
        return known;
      }
      let wire = this.#wire;
      let method = if (wire != null) methodToString(wire.getMethod()) else 'GET';
      this.#method = method;
      return method;
    }
  }

  /**
   * The request URL.
   */
  url: URL {
    get {
      let known = this.#url;
      if (known != null) {
        return known;
      }
      let wire = this.#wire;
      let url = if (wire != null) wireUrl(wire) else fallbackUrl();
      this.#url = url;
      return url;
    }
  }

  /**
   * The request path, defaults to `url.pathname` or `'/'`.
   *
   * Middleware like `mount()` or routers can rewrite `path` to represent
   * the current subpath within a mounted handler hierarchy.
   */
  path: String {
    get {
      let known = this.#path;
      if (known != null) {
        return known;
      }
      // The path alone needs no URL: read it off the wire request.
      let wire = this.#wire;
      if (wire != null && this.#url == null) {
        let p = wirePath(wire);
        this.#path = p;
        return p;
      }
      let p = this.url.pathname;
      return if (p.length == 0) '/' else p;
    }
    set(value) {
      this.#path = value;
    }
  }

  /**
   * The origin of the request URL (e.g. "https://example.com:8080").
   */
  origin: String {
    get {
      return this.url.origin();
    }
  }

  /**
   * The protocol of the request URL without the trailing colon (e.g. "http", "https").
   */
  protocol: String {
    get {
      let proto = this.url.protocol;
      if (proto.length > 0 && proto.getByteAt(proto.length - 1) == 0x3A) { // ':'
        return proto.sliceBytes(0, proto.length - 1);
      }
      return proto;
    }
  }

  /**
   * The Host of the request.
   */
  host: String {
    get {
      return this.url.host();
    }
  }

  /**
   * The query string including the leading '?', or empty if none.
   */
  query: String {
    get {
      return this.url.search;
    }
  }

  /**
   * Returns the first value of the header with the given name, or null if absent.
   */
  getHeader(name: String): String | null {
    let headers = this.#ensureHeaders();
    let key = name.asciiLowerCase();
    if (let (true, values) = headers.get(key)) {
      if (values.length > 0) {
        return values[0];
      }
    }
    return null;
  }

  /**
   * Returns all values of the header with the given name.
   */
  getHeaders(name: String): Array<String> {
    let headers = this.#ensureHeaders();
    let key = name.asciiLowerCase();
    if (let (true, values) = headers.get(key)) {
      return values;
    }
    return new GrowableArray<String>(0);
  }

  /**
   * The value of the cookie `name`, or null when the request has none.
   * Reads every `Cookie` header, since HTTP/2 lets a browser send one per
   * cookie (`parseCookies`).
   */
  cookie(name: String): String | null {
    for (let header in this.getHeaders('cookie')) {
      if (let (true, value) = parseCookies(header).get(name)) {
        return value;
      }
    }
    return null;
  }

  /**
   * Returns true if the header with the given name is present.
   */
  hasHeader(name: String): boolean {
    let headers = this.#ensureHeaders();
    return headers.has(name.asciiLowerCase());
  }

  /**
   * Returns all header names present in the request.
   */
  headerNames(): Array<String> {
    let headers = this.#ensureHeaders();
    let names = new GrowableArray<String>(headers.size);
    for (let entry in headers) {
      names.push(entry.key);
    }
    return names;
  }

  /**
   * The body stream. Consumes the request.
   */
  body(this: Own<this>): Stream<u8> {
    let stream = this.#bodyStream;
    if (stream != null) {
      this.#bodyStream = null;
      return stream;
    }
    let wire = this.#wire;
    if (wire != null) {
      // `consume-body` takes the wire request. The trailers future it
      // hands back holds an owner, and dropping it unread releases it.
      let (body, trailers) = WireRequest.consumeBody(wire,
          Future.of<Result<void, ErrorCode>>((true, unit())));
      return body;
    }
    return emptyBody();
  }

  /**
   * Reads and decodes the full request body as text, within
   * `bodyLimit`. Consumes the request.
   */
  text(this: Own<this>): Future<String> {
    return decodeText(this.bytes());
  }

  /**
   * Reads the full request body as bytes, within `bodyLimit`. Consumes
   * the request.
   */
  bytes(this: Own<this>): Future<FixedArray<u8>> {
    let limit = this.bodyLimit;
    let declared = if (limit >= (0 as i64)) this.getHeader('content-length') else null;
    return readBody(this.body(), limit, declared);
  }

  /** A body nobody read is stopped, so its writer, or the host, can
   * let go of it. */
  [Disposable.dispose](this: Own<this>): void {
    let stream = this.#bodyStream;
    if (stream != null) {
      stream.stop();
    }
  }
}
