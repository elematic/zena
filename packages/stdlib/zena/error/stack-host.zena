// Stack traces, host-hook implementation.
//
// The two `env` imports below take and return `anyref`/`externref`, which
// have no Component Model representation — a component cannot declare
// them in a world, and per component-emission.md 1.10 they cannot be
// stubbed by an adapter either. So they live behind the virtual
// `zena:error-stack` module, and only the targets whose host actually
// supplies them select this file.
//
// See docs/design/component-emission.md, Part 2.

import { String } from 'zena:string';

/** Opaque host-side stack-trace handle. */
export distinct type StackRef = anyref;

@external("env", "captureStackTrace")
export declare function captureStackTrace(): StackRef | null;

@external("env", "formatStackTrace")
export declare function formatStackTrace(stack: StackRef | null): String | null;
