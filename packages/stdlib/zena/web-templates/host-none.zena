/**
 * The host functions on a target with no DOM host. No listener runs
 * there: a server renders a template's markup and leaves its listeners
 * out, so reading an event is a program error, and no string crosses to
 * a JavaScript host.
 */
let noHost = (what: String): Error =>
  new Error(`${what}: there is no DOM host on this target; listeners and protocol exports run only in one`);

export let eventTargetValue = (event: externref): String => {
  throw noHost('Event.targetValue');
};

export let eventKey = (event: externref): String => {
  throw noHost('Event.key');
};

export let eventPreventDefault = (event: externref): void => {
  throw noHost('Event.preventDefault');
};

export let eventStopPropagation = (event: externref): void => {
  throw noHost('Event.stopPropagation');
};

export let stringHandle = (s: String): externref => {
  throw noHost('stringHandle');
};

export let stringFromHandle = (handle: externref): String => {
  throw noHost('stringFromHandle');
};
