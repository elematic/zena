/**
 * The host functions on a target with no DOM host. No listener runs
 * there: a server renders a template's markup and leaves its listeners
 * out, so reading an event is a program error, and no string crosses to
 * a JavaScript host.
 */
function noHost(what: String) {
  return new Error(`${what}: there is no DOM host on this target; listeners and protocol exports run only in one`);
}

export function eventTargetValue(event: externref): String {
  throw noHost('Event.targetValue');
}

export function eventKey(event: externref): String {
  throw noHost('Event.key');
}

export function eventPreventDefault(event: externref): void {
  throw noHost('Event.preventDefault');
}

export function eventStopPropagation(event: externref): void {
  throw noHost('Event.stopPropagation');
}

export function stringHandle(s: String): externref {
  throw noHost('stringHandle');
}

export function stringFromHandle(handle: externref): String {
  throw noHost('stringFromHandle');
}
