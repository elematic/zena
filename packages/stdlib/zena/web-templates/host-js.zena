/**
 * The host functions on the js target: the DOM host's capability
 * imports, each linked only when something reachable calls it, and the
 * crossings between a Zena string and the JavaScript string the host
 * holds. A module whose listeners never read their events imports none
 * of the capabilities, and a host that grants none fails such a module
 * at instantiation.
 */
@external('wasm-web-ui', 'event_target_value')
declare function __eventTargetValue(event: externref): externref;

@external('wasm-web-ui', 'event_key')
declare function __eventKey(event: externref): externref;

@external('wasm-web-ui', 'event_prevent_default')
declare function __eventPreventDefault(event: externref): void;

@external('wasm-web-ui', 'event_stop_propagation')
declare function __eventStopPropagation(event: externref): void;

export let eventTargetValue = (event: externref): String =>
  String.fromHandle(__eventTargetValue(event));

export let eventKey = (event: externref): String =>
  String.fromHandle(__eventKey(event));

export let eventPreventDefault = (event: externref): void => {
  __eventPreventDefault(event);
};

export let eventStopPropagation = (event: externref): void => {
  __eventStopPropagation(event);
};

/** The JavaScript string behind a Zena string, for the host. */
export let stringHandle = (s: String): externref => s.handle;

/** The Zena string over a JavaScript string the host passed. */
export let stringFromHandle = (handle: externref): String => String.fromHandle(handle);
