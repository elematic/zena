/**
 * Templates for the Wasm Web UI protocol (docs/design/wasm-web-ui.md).
 *
 * `html` and `svg` are template tags whose result, a `TemplateResult`,
 * a host renders. On the js target the DOM host reads results through
 * the `webui_*` functions of `./protocol.zena`, which the compiler exports
 * from every program that imports this library; on a server target
 * there is no protocol, and `zena:web-elements` renders a result to a
 * string. The types, the tags and `Event` are the same everywhere
 * (`./result.zena`), so one source serves both.
 */
export {
  HostValue, Event, Listener, TemplateValue, TemplateResult, html, svg, mathml, nothing,
} from './result.zena';
export * from './protocol.zena';
