/**
 * zena:time — JS/non-WASI host entry (docs/design/async.md §4).
 *
 * A browser will not let the main thread block, and no mechanism
 * changes that: `Atomics.wait` throws there, and JSPI is not in every
 * engine (Safari has neither). So this entry does not try to wait. It
 * schedules a wake through the host and reports that it did not wait,
 * which unwinds the drain; the host then calls the module's
 * `__zena_drain` export when the deadline arrives and the drain resumes
 * where it stopped.
 *
 * That keeps one meaning for `drainMicrotasks()` on every target — run
 * until nothing more can happen *now* — with the clock as the only
 * thing that differs. WASI can wait, so its drain simply never unwinds.
 *
 * The host supplies two primitives, both in `@zena-lang/runtime`'s
 * default imports. Time crosses the boundary as `f64` milliseconds
 * rather than `i64` nanoseconds so nothing here depends on BigInt
 * marshalling.
 *
 * A consequence worth knowing: an async `main` returns before its
 * timers have fired, so the value arrives later. `@zena-lang/runtime`'s
 * `run()` drives that and hands back a promise.
 *
 * This inherits `setTimeout`'s web semantics deliberately, including
 * the >=4ms floor browsers impose once timeouts nest more than five
 * deep. Each wake schedules a fresh timeout, so long chains of very
 * short sleeps hit that floor; driving them from one shared interval
 * would avoid it if the granularity ever matters.
 */
import { Error } from 'zena:error';
import { Future } from 'zena:async';
import { Clock, installClock, sleep as sleepImpl, monotonicNs as nowImpl,
         monotonicMs as nowMsImpl } from './queue.zena';

@external("time", "now_ms")
declare function __time_now_ms(): f64;

@external("time", "request_wake")
declare function __time_request_wake(ms: f64): void;

final class HostClock implements Clock {
  new();

  nowNs(): i64 {
    return (__time_now_ms() * 1000000.0) as i64;
  }

  /**
   * Never waits: asks the host to re-enter `__zena_drain` later and
   * reports false so the drain unwinds in the meantime.
   */
  waitNs(ns: i64): boolean {
    __time_request_wake((ns as f64) / 1000000.0);
    return false;
  }
}

let hostClock = new HostClock();
var installed = false;

let ensureClock = (): void => {
  if (!installed) {
    installClock(hostClock);
    installed = true;
  }
};

/** A future that completes after at least `ms` milliseconds. */
export let sleep = (ms: i32): Future<void> => {
  ensureClock();
  return sleepImpl(ms);
};

/** Nanoseconds on the monotonic clock. */
export let monotonicNs = (): i64 => {
  ensureClock();
  return nowImpl();
};

/** Milliseconds on the monotonic clock. */
export let monotonicMs = (): f64 => {
  ensureClock();
  return nowMsImpl();
};
