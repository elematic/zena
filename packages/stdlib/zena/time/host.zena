/**
 * zena:time — JS/non-WASI host entry (docs/design/async.md §4).
 *
 * The host supplies two primitives, both in `@zena-lang/runtime`'s
 * default imports: a monotonic clock reading and a blocking wait. Time
 * crosses the boundary as `f64` milliseconds rather than `i64`
 * nanoseconds so nothing here depends on BigInt marshalling.
 *
 * Why a *blocking* wait, when `setTimeout` is the obvious JS answer: a
 * callback-driven timer needs the host to call back into wasm to settle
 * the `Completer`, and only the entry module's exports become wasm
 * exports — a stdlib module cannot publish that entry point. It arrives
 * with A3's `__zena_drain` export, and this module is where it will go.
 * Until then a blocking park is what both targets can express, and it
 * has the considerable virtue that a program behaves identically under
 * wasmtime and under Node.
 *
 * The cost is honest and worth stating: `drainMicrotasks()` blocks the
 * JS thread while a timer is pending, exactly as it blocks the module
 * under WASI. That is fine in Node and in a worker; on a browser main
 * thread it freezes the tab, which is why the runtime's implementation
 * refuses rather than busy-waiting when it cannot block properly.
 */
import { Error } from 'zena:error';
import { Future } from 'zena:async';
import { Clock, installClock, sleep as sleepImpl, monotonicNs as nowImpl,
         monotonicMs as nowMsImpl } from './queue.zena';

@external("time", "now_ms")
declare function __time_now_ms(): f64;

@external("time", "sleep_ms")
declare function __time_sleep_ms(ms: f64): void;

final class HostClock implements Clock {
  new();

  nowNs(): i64 {
    return (__time_now_ms() * 1000000.0) as i64;
  }

  parkNs(ns: i64): void {
    __time_sleep_ms((ns as f64) / 1000000.0);
  }
}

let hostClock = new HostClock();
var installed = false;

let ensureClock = (): void => {
  if (!installed) {
    installClock(hostClock);
    installed = true;
  }
};

/** A future that completes after at least `ms` milliseconds. */
export let sleep = (ms: i32): Future<void> => {
  ensureClock();
  return sleepImpl(ms);
};

/** Nanoseconds on the monotonic clock. */
export let monotonicNs = (): i64 => {
  ensureClock();
  return nowImpl();
};

/** Milliseconds on the monotonic clock. */
export let monotonicMs = (): f64 => {
  ensureClock();
  return nowMsImpl();
};
