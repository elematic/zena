/**
 * zena:time — JS/non-WASI host entry (docs/design/async.md §4).
 *
 * A timer is not special here. Once a host can settle a future by handle
 * (§4 Level 2), `sleep` is an ordinary host-async binding whose host side
 * happens to be `setTimeout` — so this entry is six lines of registration
 * and none of the machinery the WASI entry needs.
 *
 * That machinery — the `Clock` interface, the timer queue, the `Parker`
 * the drain loop consults — exists because WASI can genuinely *block*:
 * its drain has to sort pending deadlines itself and sleep on the nearest
 * one through `poll_oneoff`. A browser main thread cannot block at all
 * (`Atomics.wait` throws there, and JSPI is not in every engine — Safari
 * has neither), so it never wants any of that: the JS event loop already
 * is the timer queue, and it already sorts by deadline. `time/queue.zena`
 * is therefore reachable only from `time/wasi.zena`.
 *
 * A consequence worth knowing, unchanged from before: an async `main`
 * returns before its timers have fired, so the value arrives later.
 * `@zena-lang/runtime`'s `run()` drives that and hands back a promise.
 *
 * This inherits `setTimeout`'s web semantics deliberately, including the
 * >=4ms floor browsers impose once timeouts nest more than five deep.
 */
import { pending } from 'zena:js';
import { Instant, Duration } from './types.zena';

export { Instant, Duration, milliseconds, nanoseconds } from './types.zena';

/** Milliseconds on a monotonic clock. `f64` rather than `i64` so nothing
 * here depends on BigInt marshalling. */
@external("time", "now_ms")
declare function __time_now_ms(): f64;

/** Starts a timer; the host completes `handle` when it elapses. */
@external("time", "sleep_ms")
declare function __time_sleep_ms(handle: i32, ms: f64): void;

/**
 * A future that completes after at least `d`.
 *
 * "At least": the deadline is when the timer becomes *eligible*, and it
 * completes through the microtask queue like every other future, so a
 * busy queue can delay it further. A zero-length sleep still yields — it
 * never completes synchronously, per the always-async rule.
 */
export function sleep(d: Duration): Future<void> {
  if (d.isNegative()) {
    throw new Error('zena:time: sleep() needs a non-negative duration');
  }
  let p = pending<void>();
  let nsF = (d as i64) as f64;
  __time_sleep_ms(p.handle, nsF / 1000000.0);
  return p.future;
}

/** The monotonic clock's reading. */
export function monotonic(): Instant {
  let ns = (__time_now_ms() * 1000000.0) as i64;
  return ns as Instant;
}
