/**
 * The `wasm:js-string` builtins, declared once for the js target's `String`
 * (`string-js.zena`) and `StringBuilder` (`string-builder-js.zena`).
 *
 * Each declaration is a separate import, so two files declaring the same
 * builtin would make a module import it twice. Internal: `core/index.zena`
 * does not re-export this file.
 */

@external("wasm:js-string", "length")
export declare function __js_string_length(s: externref): i32;

@external("wasm:js-string", "concat")
export declare function __js_string_concat(a: externref, b: externref): externref;

@external("wasm:js-string", "equals")
export declare function __js_string_equals(a: externref, b: externref): boolean;

@external("wasm:js-string", "compare")
export declare function __js_string_compare(a: externref, b: externref): i32;

@external("wasm:js-string", "substring")
export declare function __js_string_substring(s: externref, start: i32, end: i32): externref;

@external("wasm:js-string", "charCodeAt")
export declare function __js_string_char_code_at(s: externref, index: i32): i32;

@external("wasm:js-string", "codePointAt")
export declare function __js_string_code_point_at(s: externref, index: i32): i32;

@external("wasm:js-string", "fromCharCode")
export declare function __js_string_from_char_code(code: i32): externref;

@external("wasm:js-string", "fromCodePoint")
export declare function __js_string_from_code_point(code: i32): externref;
