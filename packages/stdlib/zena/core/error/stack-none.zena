// Stack traces, no-host implementation.
//
// Selected by targets with nowhere to put a stack trace: `freestanding`
// has no host at all, and `component` has no Component Model type for
// the `anyref`/`externref` handle the host hooks trade in. `Error` still
// carries the field; it is always null, and `getStackTrace()` returns
// null rather than a fabricated trace.
//
// See docs/design/component-emission.md, Part 2.

// Declared in a library no target varies, so `Error`'s field type is
// the same on every target. Imported as well as re-exported: the
// signatures below name it. See stack-ref.zena.
import { StackRef } from './stack-ref.zena';
export { StackRef } from './stack-ref.zena';

export function captureStackTrace(): StackRef | null {
  return null;
}

export function formatStackTrace(stack: StackRef | null): String | null {
  return null;
}
