import { hash } from './hashable.zena';
import { FilteredIterable } from './iterable-utils.zena';

import { Encoding } from './encoding.zena';
export { Encoding } from './encoding.zena';


/**
 * Returns the ASCII lowercase of `b`, leaving every other byte or code point
 * unchanged.
 */
export let asciiLowerByte = (b: i32): i32 =>
  if (b >= 0x41 && b <= 0x5A) b + 0x20 else b;

/** Returns the ASCII uppercase of `b`. */
export let asciiUpperByte = (b: i32): i32 =>
  if (b >= 0x61 && b <= 0x7A) b - 0x20 else b;

/**
 * Whether `b` is ASCII whitespace: a space, tab, line feed, form feed or
 * carriage return.
 */
let isAsciiSpace = (b: i32) =>
  b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0C || b == 0x0D;

/**
 * Whether `cp` is a C0/C1 control character, CR, or LF (UAX #29 Control / CR / LF).
 */
let isGraphemeControl = (cp: i32): boolean =>
  cp < 0x20 || (cp >= 0x7F && cp <= 0x9F);

/**
 * Whether `cp` extends the preceding grapheme cluster (combining marks,
 * enclosing marks, variation selectors, ZWJ/ZWNJ, emoji skin-tone modifiers,
 * and subdivision flag tags).
 */
let isGraphemeExtend = (cp: i32): boolean => {
  if (cp < 0x0300) {
    return false;
  }
  if (cp <= 0x036F) {
    return true; // Combining Diacritical Marks
  }
  if (cp >= 0x0483 && cp <= 0x0489) {
    return true; // Cyrillic combining marks
  }
  if ((cp >= 0x0591 && cp <= 0x05BD) || cp == 0x05BF ||
      (cp >= 0x05C1 && cp <= 0x05C2) || (cp >= 0x05C4 && cp <= 0x05C5) ||
      cp == 0x05C7) {
    return true; // Hebrew marks
  }
  if ((cp >= 0x0610 && cp <= 0x061A) || (cp >= 0x064B && cp <= 0x065F) ||
      cp == 0x0670 || (cp >= 0x06D6 && cp <= 0x06ED)) {
    return true; // Arabic marks
  }
  if ((cp >= 0x0900 && cp <= 0x0903) || (cp >= 0x093A && cp <= 0x094F) ||
      (cp >= 0x0951 && cp <= 0x0957) || (cp >= 0x0962 && cp <= 0x0963)) {
    return true; // Devanagari marks
  }
  if (cp == 0x0E31 || (cp >= 0x0E34 && cp <= 0x0E3A) ||
      (cp >= 0x0E47 && cp <= 0x0E4E)) {
    return true; // Thai marks
  }
  if (cp >= 0x1AB0 && cp <= 0x1AFF) {
    return true; // Combining Diacritical Marks Extended
  }
  if (cp >= 0x1DC0 && cp <= 0x1DFF) {
    return true; // Combining Diacritical Marks Supplement
  }
  if (cp >= 0x200C && cp <= 0x200D) {
    return true; // ZWNJ and ZWJ
  }
  if (cp >= 0x20D0 && cp <= 0x20FF) {
    return true; // Combining Diacritical Marks for Symbols (includes U+20E3 keycap)
  }
  if (cp >= 0xFE00 && cp <= 0xFE0F) {
    return true; // Variation Selectors
  }
  if (cp >= 0xFE20 && cp <= 0xFE2F) {
    return true; // Combining Half Marks
  }
  if (cp >= 0x1F3FB && cp <= 0x1F3FF) {
    return true; // Emoji Fitzpatrick skin-tone modifiers
  }
  if (cp >= 0xE0020 && cp <= 0xE007F) {
    return true; // Subdivision flag tag characters
  }
  if (cp >= 0xE0100 && cp <= 0xE01EF) {
    return true; // Variation Selectors Supplement
  }
  return false;
};

/**
 * Whether `cp` is a Regional Indicator symbol (`U+1F1E6..U+1F1FF`).
 */
let isRegionalIndicator = (cp: i32): boolean =>
  cp >= 0x1F1E6 && cp <= 0x1F1FF;

/**
 * Returns the Hangul syllable category for `cp`:
 * 0 = Not Hangul, 1 = L, 2 = V, 3 = T, 4 = LV, 5 = LVT.
 */
let hangulSyllableType = (cp: i32): i32 => {
  if ((cp >= 0x1100 && cp <= 0x115F) || (cp >= 0xA960 && cp <= 0xA97C)) {
    return 1; // L
  }
  if ((cp >= 0x1160 && cp <= 0x11A7) || (cp >= 0xD7B0 && cp <= 0xD7C6)) {
    return 2; // V
  }
  if ((cp >= 0x11A8 && cp <= 0x11FF) || (cp >= 0xD7CB && cp <= 0xD7FB)) {
    return 3; // T
  }
  if (cp >= 0xAC00 && cp <= 0xD7A3) {
    let offset = cp - 0xAC00;
    let rem = offset - (offset / 28) * 28;
    return if (rem == 0) 4 else 5; // LV or LVT
  }
  return 0;
};

/**
 * A byte offset within a `String` that has been validated to lie on a
 * Unicode boundary.
 *
 * `StringIndex` values are produced by `String` methods (`startIndex`,
 * `endIndex`, `indexAfter`, `indexBefore`, `scalarIndexAfter`,
 * `scalarIndexBefore`, `indexOffsetBy`, `validateByteIndex`, `indexOf`)
 * and cannot be forged by casting an arbitrary `i32` outside `zena:core`.
 * Reading the underlying byte offset with `idx as i32` is always legal.
 */
export opaque type StringIndex = i32;

/**
 * A range bounded by `StringIndex` endpoints: `start..end`, `start..`, or
 * `..end`. For an unbounded full slice `str[..]`, `FullRange` is used.
 */
export sealed class StringRange {
  case BoundedStringRange, FromStringRange, ToStringRange

  abstract bounds(endIndex: StringIndex): inline (StringIndex, StringIndex);
}

/**
 * A bounded string range `[start, end)`.
 */
export final class BoundedStringRange extends StringRange {
  start: StringIndex;
  end: StringIndex;

  new(start: StringIndex, end: StringIndex) : start = start, end = end, super();

  bounds(_endIndex: StringIndex): inline (StringIndex, StringIndex) {
    return (this.start, this.end);
  }
}

/**
 * A string range `[start, endIndex)`.
 */
export final class FromStringRange extends StringRange {
  start: StringIndex;

  new(start: StringIndex) : start = start, super();

  bounds(endIndex: StringIndex): inline (StringIndex, StringIndex) {
    return (this.start, endIndex);
  }
}

/**
 * A string range `[startIndex, end)`.
 */
export final class ToStringRange extends StringRange {
  end: StringIndex;

  new(end: StringIndex) : end = end, super();

  bounds(_endIndex: StringIndex): inline (StringIndex, StringIndex) {
    return (0 as StringIndex, this.end);
  }
}

/**
 * An immutable sequence of characters with value equality.
 *
 * Strings are created from string literals, template literals, concatenation,
 * slicing, and `StringBuilder`.
 *
 * Indexing and slicing operate on `StringIndex` values (`str[i]`,
 * `str[start..end]`, `str[start..]`, `str[..end]`, `str[..]`), which are
 * guaranteed to lie on Unicode scalar boundaries. Iteration (`for (let ch in str)`)
 * yields grapheme clusters as `String` slices by default. Use `str.codePoints`
 * to iterate Unicode scalar values (`i32`), `str.utf8` for a UTF-8 byte view
 * (`u8`), or `str.utf16` for a UTF-16 code unit view (`u16`).
 */
export final class String implements Hashable, Stringable, Iterable<String> {
  // Internal storage - accessed by compiler intrinsics
  #data: ByteArray;    // Backing storage (may be shared with other Strings)
  #start: i32;         // Start offset into #data (inclusive)
  #end: i32;           // End offset into #data (exclusive)
  #encoding: Encoding;
  /**
   * Cached hash code. A value of 0 indicates that the hash code has not yet
   * been computed. If a string's calculated FNV-1a hash is exactly 0, it is
   * coerced to 1 by the compiler's hash helper to avoid redundant recomputations.
   */
  var #hashCode: i32 = 0;

  /**
   * Create a new String view over a ByteArray.
   *
   * Important: This should be considered a private constructor - strings are
   * created by the compiler for literals or by StringBuilder/transcoding
   * functions.
   */
  new #fromBytes(data: ByteArray, start: i32, end: i32, encoding: Encoding)
    : #data = data, #start = start, #end = end, #encoding = encoding;

  /**
   * Creates a String from a ByteArray with given bounds and encoding.
   * This is used by StringBuilder and other internal operations.
   */
  static fromByteArray(data: ByteArray, start: i32, end: i32, encoding: Encoding): String {
    return new String.#fromBytes(data, start, end, encoding);
  }

  /**
   * A String over a copy of `bytes`, taken as WTF-8 — the bytes a
   * response body or a file arrives as. Zena strings are views over
   * byte arrays, so nothing is re-encoded; the copy is what turns a
   * fixed array into the backing store a view needs.
   */
  static fromBytes(bytes: FixedArray<u8>): String {
    let data = __byte_array_new(bytes.length);
    for (var i = 0; i < bytes.length; i += 1) {
      data[i] = bytes[i];
    }
    return new String.#fromBytes(data, 0, bytes.length, Encoding.WTF8);
  }

  /**
   * Creates a String containing a single Unicode code point `code`.
   * Throws `IndexOutOfBoundsError` if `code` is outside `0..0x10FFFF`.
   */
  static fromCodePoint(code: i32): String {
    if (code < 0 || code > 0x10FFFF) {
      throw new IndexOutOfBoundsError(code, 0x10FFFF);
    }
    if (code < 0x80) {
      let data = __byte_array_new(1);
      __byte_array_set(data, 0, code);
      return new String.#fromBytes(data, 0, 1, Encoding.WTF8);
    }
    if (code < 0x800) {
      let data = __byte_array_new(2);
      __byte_array_set(data, 0, 0xC0 | (code >> 6));
      __byte_array_set(data, 1, 0x80 | (code & 0x3F));
      return new String.#fromBytes(data, 0, 2, Encoding.WTF8);
    }
    if (code < 0x10000) {
      let data = __byte_array_new(3);
      __byte_array_set(data, 0, 0xE0 | (code >> 12));
      __byte_array_set(data, 1, 0x80 | ((code >> 6) & 0x3F));
      __byte_array_set(data, 2, 0x80 | (code & 0x3F));
      return new String.#fromBytes(data, 0, 3, Encoding.WTF8);
    }
    let data = __byte_array_new(4);
    __byte_array_set(data, 0, 0xF0 | (code >> 18));
    __byte_array_set(data, 1, 0x80 | ((code >> 12) & 0x3F));
    __byte_array_set(data, 2, 0x80 | ((code >> 6) & 0x3F));
    __byte_array_set(data, 3, 0x80 | (code & 0x3F));
    return new String.#fromBytes(data, 0, 4, Encoding.WTF8);
  }

  /**
   * Creates a String from a sequence of Unicode code points.
   * Throws `IndexOutOfBoundsError` if any code point is outside `0..0x10FFFF`.
   */
  static fromCodePoints<A extends Array<i32>>(codes: A): String {
    let count = codes.length;
    var totalBytes = 0;
    var i = 0;
    while (i < count) {
      let cp = codes[i];
      if (cp < 0 || cp > 0x10FFFF) {
        throw new IndexOutOfBoundsError(cp, 0x10FFFF);
      }
      totalBytes += if (cp < 0x80) 1 else if (cp < 0x800) 2 else if (cp < 0x10000) 3 else 4;
      i += 1;
    }
    let data = __byte_array_new(totalBytes);
    var pos = 0;
    i = 0;
    while (i < count) {
      let cp = codes[i];
      if (cp < 0x80) {
        __byte_array_set(data, pos, cp);
        pos += 1;
      } else if (cp < 0x800) {
        __byte_array_set(data, pos, 0xC0 | (cp >> 6));
        __byte_array_set(data, pos + 1, 0x80 | (cp & 0x3F));
        pos += 2;
      } else if (cp < 0x10000) {
        __byte_array_set(data, pos, 0xE0 | (cp >> 12));
        __byte_array_set(data, pos + 1, 0x80 | ((cp >> 6) & 0x3F));
        __byte_array_set(data, pos + 2, 0x80 | (cp & 0x3F));
        pos += 3;
      } else {
        __byte_array_set(data, pos, 0xF0 | (cp >> 18));
        __byte_array_set(data, pos + 1, 0x80 | ((cp >> 12) & 0x3F));
        __byte_array_set(data, pos + 2, 0x80 | ((cp >> 6) & 0x3F));
        __byte_array_set(data, pos + 3, 0x80 | (cp & 0x3F));
        pos += 4;
      }
      i += 1;
    }
    return new String.#fromBytes(data, 0, totalBytes, Encoding.WTF8);
  }

  /**
   * A copy of this string's UTF-8 / WTF-8 bytes. The inverse of `fromBytes`:
   * what a `list<u8>` position wants, a header value or a body.
   */
  toBytes(): FixedArray<u8> {
    return this.utf8.toArray();
  }

  /**
   * The encoding of the backing bytes. Encoding is deliberately an
   * internal detail almost everywhere; this exists for boundary code —
   * canonical-ABI marshaling, host interop — that copies the bytes
   * verbatim and must assert what it is copying rather than assume.
   */
  encoding: Encoding {
    get {
      return this.#encoding;
    }
  }

  /**
   * Creates a new string by concatenating all parts.
   * This is more efficient than chained + operators for multiple strings,
   * as it allocates the result array only once.
   *
   * Generic over the array representation: element access resolves
   * through the bound, so each specialization reads its receiver
   * directly with no interface dispatch.
   */
  static fromParts<A extends Array<String>>(parts: A): String {
    // First pass: calculate total length
    let partsLen = parts.length;
    var totalLen = 0;
    var i = 0;
    while (i < partsLen) {
      let part = parts[i];
      totalLen = totalLen + (part.#end - part.#start);
      i += 1;
    }

    // Allocate result array
    let data = __byte_array_new(totalLen);

    // Second pass: copy all parts
    var offset = 0;
    i = 0;
    while (i < partsLen) {
      let part = parts[i];
      let partLen = part.#end - part.#start;
      __byte_array_copy(data, offset, part.#data, part.#start, partLen);
      offset = offset + partLen;
      i += 1;
    }

    // Use encoding from first part, or default to WTF-8
    let encoding = if (partsLen > 0) parts[0].#encoding else Encoding.WTF8;
    return new String.#fromBytes(data, 0, totalLen, encoding);
  }

  /**
   * The raw-array entry the compiler's synthesized string joins call —
   * template-literal lowering resolves it by name against a
   * one-parameter raw-array signature. Its body is also the call site
   * that keeps the FixedArray<String> specialization of fromParts
   * reachable. User code calls fromParts.
   */
  static fromRawParts(parts: array<var String>): String {
    return String.fromParts(parts as FixedArray<String>);
  }

  /**
   * True when this string contains zero bytes.
   */
  isEmpty: boolean {
    get {
      return this.#end == this.#start;
    }
  }

  /**
   * The length of the string in encoded bytes.
   */
  byteLength: i32 {
    get {
      return this.#end - this.#start;
    }
  }

  /**
   * The length of the string in bytes.
   *
   * @deprecated Use `byteLength`, `isEmpty`, or `graphemes.count()` instead.
   */
  length: i32 {
    get {
      return this.#end - this.#start;
    }
  }

  /**
   * The index of the first character in this string (always byte offset 0).
   */
  startIndex: StringIndex {
    get {
      return 0 as StringIndex;
    }
  }

  /**
   * The "past the end" index of this string (equal to `byteLength`).
   */
  endIndex: StringIndex {
    get {
      return (this.#end - this.#start) as StringIndex;
    }
  }

  /**
   * View of this string's extended grapheme clusters as `String` slices.
   * Zero heap allocation.
   */
  graphemes: StringGraphemes {
    get {
      return this as StringGraphemes;
    }
  }

  /**
   * View of this string's decoded Unicode scalar values as `i32`.
   * Zero heap allocation.
   */
  codePoints: StringCodePoints {
    get {
      return this as StringCodePoints;
    }
  }

  /**
   * Contiguous UTF-8 / WTF-8 byte view (`u8`) of this string.
   *
   * Zero-copy when `this.encoding == Encoding.WTF8`; transcodes to a fresh
   * UTF-8 `ByteArray` when `this.encoding == Encoding.WTF16`.
   */
  utf8: StringUtf8View {
    get {
      if (this.#encoding == Encoding.WTF8) {
        return new StringUtf8View(this.#data, this.#start, this.#end);
      }
      let len = this.#end - this.#start;
      var utf8Len = 0;
      var pos = 0;
      while (pos < len) {
        let (cp, next) = this.#decodeScalarAt(pos);
        utf8Len += if (cp < 0x80) 1 else if (cp < 0x800) 2 else if (cp < 0x10000) 3 else 4;
        pos = next;
      }
      let out = __byte_array_new(utf8Len);
      var outPos = 0;
      pos = 0;
      while (pos < len) {
        let (cp, next) = this.#decodeScalarAt(pos);
        if (cp < 0x80) {
          __byte_array_set(out, outPos, cp);
          outPos += 1;
        } else if (cp < 0x800) {
          __byte_array_set(out, outPos, 0xC0 | (cp >> 6));
          __byte_array_set(out, outPos + 1, 0x80 | (cp & 0x3F));
          outPos += 2;
        } else if (cp < 0x10000) {
          __byte_array_set(out, outPos, 0xE0 | (cp >> 12));
          __byte_array_set(out, outPos + 1, 0x80 | ((cp >> 6) & 0x3F));
          __byte_array_set(out, outPos + 2, 0x80 | (cp & 0x3F));
          outPos += 3;
        } else {
          __byte_array_set(out, outPos, 0xF0 | (cp >> 18));
          __byte_array_set(out, outPos + 1, 0x80 | ((cp >> 12) & 0x3F));
          __byte_array_set(out, outPos + 2, 0x80 | ((cp >> 6) & 0x3F));
          __byte_array_set(out, outPos + 3, 0x80 | (cp & 0x3F));
          outPos += 4;
        }
        pos = next;
      }
      return new StringUtf8View(out, 0, utf8Len);
    }
  }

  /**
   * Contiguous UTF-16 / WTF-16 code unit view (`u16`) of this string.
   *
   * Zero-copy when `this.encoding == Encoding.WTF16`; transcodes to a fresh
   * little-endian UTF-16 `ByteArray` when `this.encoding == Encoding.WTF8`.
   */
  utf16: StringUtf16View {
    get {
      if (this.#encoding == Encoding.WTF16) {
        return new StringUtf16View(this.#data, this.#start, this.#end);
      }
      let len = this.#end - this.#start;
      var units = 0;
      var pos = 0;
      while (pos < len) {
        let (cp, next) = this.#decodeScalarAt(pos);
        units += if (cp >= 0x10000) 2 else 1;
        pos = next;
      }
      let byteLen = units << 1;
      let out = __byte_array_new(byteLen);
      var outPos = 0;
      pos = 0;
      while (pos < len) {
        let (cp, next) = this.#decodeScalarAt(pos);
        if (cp < 0x10000) {
          __byte_array_set(out, outPos, cp & 0xFF);
          __byte_array_set(out, outPos + 1, (cp >> 8) & 0xFF);
          outPos += 2;
        } else {
          let u = cp - 0x10000;
          let hi = 0xD800 + (u >> 10);
          let lo = 0xDC00 + (u & 0x3FF);
          __byte_array_set(out, outPos, hi & 0xFF);
          __byte_array_set(out, outPos + 1, (hi >> 8) & 0xFF);
          __byte_array_set(out, outPos + 2, lo & 0xFF);
          __byte_array_set(out, outPos + 3, (lo >> 8) & 0xFF);
          outPos += 4;
        }
        pos = next;
      }
      return new StringUtf16View(out, 0, byteLen);
    }
  }

  /**
   * Returns an iterator over the extended grapheme clusters of this string.
   */
  [Iterable.iterator](): Iterator<String> {
    return new StringGraphemeIterator(this);
  }

  /**
   * True if `offset` is within `[0, byteLength]` and lies on a Unicode scalar
   * boundary for this string's encoding.
   */
  #isScalarBoundary(offset: i32): boolean {
    let len = this.#end - this.#start;
    if (offset < 0 || offset > len) {
      return false;
    }
    if (offset == 0 || offset == len) {
      return true;
    }
    if (this.#encoding == Encoding.WTF16) {
      if ((offset & 1) != 0) {
        return false;
      }
      let base = this.#start + offset;
      let prev = __byte_array_get(this.#data, base - 2) | (__byte_array_get(this.#data, base - 1) << 8);
      let curr = __byte_array_get(this.#data, base) | (__byte_array_get(this.#data, base + 1) << 8);
      if (prev >= 0xD800 && prev <= 0xDBFF && curr >= 0xDC00 && curr <= 0xDFFF) {
        return false;
      }
      return true;
    }
    let b = __byte_array_get(this.#data, this.#start + offset);
    return (b & 0xC0) != 0x80;
  }

  /**
   * Validates that `offset` is a scalar boundary in `[0, byteLength]`, throwing
   * `IndexOutOfBoundsError` otherwise.
   */
  #checkBoundary(offset: i32): void {
    if (!this.#isScalarBoundary(offset)) {
      throw new IndexOutOfBoundsError(offset, this.#end - this.#start);
    }
  }

  /**
   * Validates that `offset` is a scalar boundary in `[0, byteLength)`, throwing
   * `IndexOutOfBoundsError` otherwise.
   */
  #checkInBoundsBoundary(offset: i32): void {
    let len = this.#end - this.#start;
    if (offset < 0 || offset >= len || !this.#isScalarBoundary(offset)) {
      throw new IndexOutOfBoundsError(offset, len);
    }
  }

  /**
   * Decodes the Unicode scalar at `offset` (`0 <= offset < byteLength`)
   * and returns `(codePoint, nextByteOffset)`.
   */
  #decodeScalarAt(offset: i32): inline (i32, i32) {
    let len = this.#end - this.#start;
    if (this.#encoding == Encoding.WTF16) {
      let base = this.#start + offset;
      let c0 = __byte_array_get(this.#data, base) | (__byte_array_get(this.#data, base + 1) << 8);
      if (c0 >= 0xD800 && c0 <= 0xDBFF && offset + 3 < len) {
        let c1 = __byte_array_get(this.#data, base + 2) | (__byte_array_get(this.#data, base + 3) << 8);
        if (c1 >= 0xDC00 && c1 <= 0xDFFF) {
          let cp = 0x10000 + ((c0 - 0xD800) << 10) + (c1 - 0xDC00);
          return (cp, offset + 4);
        }
      }
      return (c0, offset + 2);
    }
    let b0 = __byte_array_get(this.#data, this.#start + offset);
    if ((b0 & 0x80) == 0) {
      return (b0, offset + 1);
    }
    if ((b0 & 0xE0) == 0xC0) {
      if (offset + 1 < len) {
        let b1 = __byte_array_get(this.#data, this.#start + offset + 1);
        return (((b0 & 0x1F) << 6) | (b1 & 0x3F), offset + 2);
      }
      return (b0, offset + 1);
    }
    if ((b0 & 0xF0) == 0xE0) {
      if (offset + 2 < len) {
        let b1 = __byte_array_get(this.#data, this.#start + offset + 1);
        let b2 = __byte_array_get(this.#data, this.#start + offset + 2);
        return (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), offset + 3);
      }
      return (b0, offset + 1);
    }
    if ((b0 & 0xF8) == 0xF0) {
      if (offset + 3 < len) {
        let b1 = __byte_array_get(this.#data, this.#start + offset + 1);
        let b2 = __byte_array_get(this.#data, this.#start + offset + 2);
        let b3 = __byte_array_get(this.#data, this.#start + offset + 3);
        return (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F), offset + 4);
      }
      return (b0, offset + 1);
    }
    return (b0, offset + 1);
  }

  /**
   * Steps backward one scalar from `offset` (`0 < offset <= byteLength`) and
   * returns `(codePoint, prevByteOffset)`.
   */
  #decodeScalarBefore(offset: i32): inline (i32, i32) {
    if (this.#encoding == Encoding.WTF16) {
      let base = this.#start + offset;
      let cLast = __byte_array_get(this.#data, base - 2) | (__byte_array_get(this.#data, base - 1) << 8);
      if (cLast >= 0xDC00 && cLast <= 0xDFFF && offset >= 4) {
        let cPrev = __byte_array_get(this.#data, base - 4) | (__byte_array_get(this.#data, base - 3) << 8);
        if (cPrev >= 0xD800 && cPrev <= 0xDBFF) {
          let cp = 0x10000 + ((cPrev - 0xD800) << 10) + (cLast - 0xDC00);
          return (cp, offset - 4);
        }
      }
      return (cLast, offset - 2);
    }
    var pos = offset - 1;
    while (pos > 0 && (__byte_array_get(this.#data, this.#start + pos) & 0xC0) == 0x80) {
      pos -= 1;
    }
    let (cp, _) = this.#decodeScalarAt(pos);
    return (cp, pos);
  }

  /**
   * Whether a grapheme cluster boundary exists between `prevCp` (starting at
   * byte offset `prevStart`) and `nextCp`.
   */
  #shouldBreakBetween(prevCp: i32, nextCp: i32, prevStart: i32): boolean {
    // GB3: Do not break between CR and LF.
    if (prevCp == 0x0D && nextCp == 0x0A) {
      return false;
    }
    // GB4, GB5: Break before and after Control, CR, LF.
    if (isGraphemeControl(prevCp) || isGraphemeControl(nextCp)) {
      return true;
    }
    // GB6, GB7, GB8: Hangul syllable sequences.
    let hPrev = hangulSyllableType(prevCp);
    let hNext = hangulSyllableType(nextCp);
    if (hPrev != 0 && hNext != 0) {
      if (hPrev == 1 && (hNext == 1 || hNext == 2 || hNext == 4 || hNext == 5)) {
        return false;
      }
      if ((hPrev == 4 || hPrev == 2) && (hNext == 2 || hNext == 3)) {
        return false;
      }
      if ((hPrev == 5 || hPrev == 3) && hNext == 3) {
        return false;
      }
    }
    // GB9, GB9a: Do not break before extending characters, ZWJ, or spacing marks.
    if (isGraphemeExtend(nextCp)) {
      return false;
    }
    // GB11: Do not break after ZWJ within emoji ZWJ sequences.
    if (prevCp == 0x200D) {
      return false;
    }
    // GB12, GB13: Pair Regional Indicator symbols two by two.
    if (isRegionalIndicator(prevCp) && isRegionalIndicator(nextCp)) {
      var riCount = 1;
      var scan = prevStart;
      while (scan > 0) {
        let (scanCp, scanPrev) = this.#decodeScalarBefore(scan);
        if (!isRegionalIndicator(scanCp)) {
          break;
        }
        riCount += 1;
        scan = scanPrev;
      }
      return (riCount & 1) == 0;
    }
    // GB999: Otherwise, break everywhere.
    return true;
  }

  /**
   * Returns the `StringIndex` immediately following the extended grapheme
   * cluster at `i`. Throws `IndexOutOfBoundsError` if `i` is at `endIndex`
   * or is not a valid boundary of this string.
   */
  indexAfter(i: StringIndex): StringIndex {
    let offset = i as i32;
    this.#checkInBoundsBoundary(offset);
    let len = this.#end - this.#start;

    // Fast path for ASCII in WTF-8.
    if (this.#encoding == Encoding.WTF8) {
      let b0 = __byte_array_get(this.#data, this.#start + offset);
      if (b0 < 0x80) {
        if (offset + 1 == len) {
          return (offset + 1) as StringIndex;
        }
        let b1 = __byte_array_get(this.#data, this.#start + offset + 1);
        if (b0 == 0x0D && b1 == 0x0A) {
          return (offset + 2) as StringIndex;
        }
        if (b1 < 0x80) {
          return (offset + 1) as StringIndex;
        }
      }
    }

    var prevStart = offset;
    let (firstCp, firstNext) = this.#decodeScalarAt(offset);
    var prevCp = firstCp;
    var pos = firstNext;
    while (pos < len) {
      let (nextCp, nextEnd) = this.#decodeScalarAt(pos);
      if (this.#shouldBreakBetween(prevCp, nextCp, prevStart)) {
        break;
