  indexOffsetBy(from: StringIndex, count: i32): inline (true, StringIndex) | inline (false, _) {
    let startOffset = from as i32;
    if (!this.#isScalarBoundary(startOffset)) {
      return (false, _);
    }
    let len = this.#end - this.#start;
    var cur = from;
    if (count >= 0) {
      var rem = count;
      while (rem > 0) {
        if ((cur as i32) >= len) {
          return (false, _);
        }
        cur = this.indexAfter(cur);
        rem -= 1;
      }
      return (true, cur);
    } else {
      var rem = 0 - count;
      while (rem > 0) {
