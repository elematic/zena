    let (lastCp, lastStart) = this.#decodeScalarBefore(offset);
    var nextCp = lastCp;
    var pos = lastStart;
    while (pos > 0) {
      let (prevCp, prevStart) = this.#decodeScalarBefore(pos);
      if (this.#shouldBreakBetween(prevCp, nextCp, prevStart)) {
