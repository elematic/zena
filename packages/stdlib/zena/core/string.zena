        return false;
      }
    }
    return true;
  }

  some(predicate: (item: u16) => boolean): boolean {
    for (let item in this) {
      if (predicate(item)) {
        return true;
      }
    }
    return false;
  }

  fold<R>(initial: R, combine: (acc: R, item: u16) => R): R {
    var acc = initial;
