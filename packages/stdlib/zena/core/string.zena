 * enclosing marks, variation selectors, ZWJ/ZWNJ, emoji skin-tone modifiers,
 * and subdivision flag tags).
 */
let isGraphemeExtend = (cp: i32): boolean => {
  if (cp < 0x0300) {
    return false;
  }
  if (cp <= 0x036F) {
    return true; // Combining Diacritical Marks
  }
  if (cp >= 0x0483 && cp <= 0x0489) {
    return true; // Cyrillic combining marks
  }
  if ((cp >= 0x0591 && cp <= 0x05BD) || cp == 0x05BF ||
      (cp >= 0x05C1 && cp <= 0x05C2) || (cp >= 0x05C4 && cp <= 0x05C5) ||
      cp == 0x05C7) {
    return true; // Hebrew marks
  }
  if ((cp >= 0x0610 && cp <= 0x061A) || (cp >= 0x064B && cp <= 0x065F) ||
      cp == 0x0670 || (cp >= 0x06D6 && cp <= 0x06ED)) {
    return true; // Arabic marks
  }
  if ((cp >= 0x0900 && cp <= 0x0903) || (cp >= 0x093A && cp <= 0x094F) ||
      (cp >= 0x0951 && cp <= 0x0957) || (cp >= 0x0962 && cp <= 0x0963)) {
    return true; // Devanagari marks
  }
  if (cp == 0x0E31 || (cp >= 0x0E34 && cp <= 0x0E3A) ||
      (cp >= 0x0E47 && cp <= 0x0E4E)) {
    return true; // Thai marks
  }
  if (cp >= 0x1AB0 && cp <= 0x1AFF) {
    return true; // Combining Diacritical Marks Extended
  }
  if (cp >= 0x1DC0 && cp <= 0x1DFF) {
    return true; // Combining Diacritical Marks Supplement
  }
  if (cp >= 0x200C && cp <= 0x200D) {
    return true; // ZWNJ and ZWJ
  }
  if (cp >= 0x20D0 && cp <= 0x20FF) {
    return true; // Combining Diacritical Marks for Symbols (includes U+20E3 keycap)
  }
  if (cp >= 0xFE00 && cp <= 0xFE0F) {
    return true; // Variation Selectors
  }
  if (cp >= 0xFE20 && cp <= 0xFE2F) {
    return true; // Combining Half Marks
  }
  if (cp >= 0x1F3FB && cp <= 0x1F3FF) {
    return true; // Emoji Fitzpatrick skin-tone modifiers
  }
  if (cp >= 0xE0020 && cp <= 0xE007F) {
    return true; // Subdivision flag tag characters
  }
  if (cp >= 0xE0100 && cp <= 0xE01EF) {
    return true; // Variation Selectors Supplement
  }
