/**
 * Iterator over the extended grapheme clusters of a `String`.
 */
final class StringGraphemeIterator implements Iterator<String> {
  #str: String;
  var #pos: StringIndex;
  #end: StringIndex;

  new(str: String) : #str = str, #pos = str.startIndex, #end = str.endIndex;

  next(): Step<String> {
    if ((this.#pos as i32) >= (this.#end as i32)) {
      return (0, _, _);
    }
    let start = this.#pos;
    let nextPos = this.#str.indexAfter(start);
    this.#pos = nextPos;
    return (1, this.#str.unsafeSliceBytes(start as i32, nextPos as i32), _);
  }
}

/**
 * Iterator over the decoded Unicode scalar values (`i32`) of a `String`.
 */
final class StringCodePointIterator implements Iterator<i32> {
  #str: String;
  var #pos: StringIndex;
  #end: StringIndex;

  new(str: String) : #str = str, #pos = str.startIndex, #end = str.endIndex;

  next(): Step<i32> {
    if ((this.#pos as i32) >= (this.#end as i32)) {
      return (0, _, _);
    }
    let cur = this.#pos;
    let cp = this.#str.codePointAt(cur);
    this.#pos = this.#str.scalarIndexAfter(cur);
    return (1, cp, _);
  }
}

/**
