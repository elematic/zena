    if (sepLength == 0) {
      return new Array<String>.fixed(1, this);
    }

    let haystackLength = this.#end - this.#start;
    if (sepLength > haystackLength) {
      return new Array<String>.fixed(1, this);
    }

    // First pass: count parts
    var count = 1;
    var i = 0;
    let lastIndex = sepLength - 1;
    let firstByte = __byte_array_get(separator.#data, separator.#start);
    let lastByte = __byte_array_get(separator.#data, separator.#start + lastIndex);

    while (i <= haystackLength - sepLength) {
      let currentIndex = this.#start + i;
      if (__byte_array_get(this.#data, currentIndex) == firstByte &&
          __byte_array_get(this.#data, currentIndex + lastIndex) == lastByte &&
          (sepLength <= 2 || this.#regionEquals(separator, currentIndex + 1, separator.#start + 1, sepLength - 2))) {
        count += 1;
        i += sepLength;
      } else {
        i += 1;
