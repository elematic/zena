    // Allocate result array
    let result = __array_new_empty<String>(count) as FixedArray<String>;

    // Second pass: fill parts
    var partIdx = 0;
    var lastStart = 0;
    i = 0;
    while (i <= haystackLength - sepLength) {
      let currentIndex = this.#start + i;
      if (__byte_array_get(this.#data, currentIndex) == firstByte &&
          __byte_array_get(this.#data, currentIndex + lastIndex) == lastByte &&
          (sepLength <= 2 || this.#regionEquals(separator, currentIndex + 1, separator.#start + 1, sepLength - 2))) {
