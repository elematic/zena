export class Box<T> {
  var value: T;
  new(value: T) : value = value;
}

/**
 * A slot for a `T` that may be empty: `T` itself at a primitive, and
 * `T | null` at a reference. A generic class keeps a value it may not
 * have yet in one, without a `Box`. `defaultValue<T>()` is its empty
 * value, a `T` fills it, and `slot as T` reads it back; at a non-null
 * reference `T`, reading an empty slot fails the cast.
 *
 * ```zena
 * class Cell<T> {
 *   var #value: WithDefault<T> = defaultValue<T>();
 *   set(value: T): void { this.#value = value; }
 *   get(): T { return this.#value as T; }
 * }
 * ```
 */
@intrinsic('type.withDefault')
export declare type WithDefault<T>;

/** The value of an empty `WithDefault<T>`: zero at a primitive, null at a reference. */
@intrinsic('default_value')
export declare function defaultValue<scoped T>(): WithDefault<T>;
