// ByteArray Utilities
// Provides factory functions for the intrinsic ByteArray type.
//
// ByteArray is a WASM GC array of i8 (unsigned bytes).
// The built-in ByteArray type has intrinsic length, [], and []= operators.
// This module provides the `new` factory function and copy utility.

/**
 * Create a new ByteArray of the specified size, filled with zeros.
 */
export function newByteArray(size: i32): ByteArray {
  return __byte_array_new(size);
}

/** Whether two byte arrays hold the same bytes. */
export function bytesEqual(a: ByteArray, b: ByteArray): boolean {
  let length = __byte_array_length(a);
  if (__byte_array_length(b) != length) {
    return false;
  }
  for (var i = 0; i < length; i += 1) {
    if (__byte_array_get(a, i) != __byte_array_get(b, i)) {
      return false;
    }
  }
  return true;
}

/**
 * Copy bytes from source to destination.
 * @param dest Destination array
 * @param destOffset Starting index in destination
 * @param src Source array
 * @param srcOffset Starting index in source
 * @param length Number of bytes to copy
 */
export function copyBytes(dest: ByteArray, destOffset: i32, src: ByteArray, srcOffset: i32, length: i32): void {
  __byte_array_copy(dest, destOffset, src, srcOffset, length);
}
