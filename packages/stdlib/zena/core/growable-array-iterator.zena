import { Step } from 'zena:async';

export final class GrowableArrayIterator<T> implements Iterator<T> {
  #buffer: FixedArray<T>;
  #length: i32;
  var #index: i32 = 0;

  new(buffer: FixedArray<T>, length: i32) : #buffer = buffer, #length = length;

  next(): Step<T> {
    if (this.#index < this.#length) {
      let value = this.#buffer[this.#index];
      this.#index += 1;
      return (1, value, _);
    }
    return (0, _, _);
  }
}
