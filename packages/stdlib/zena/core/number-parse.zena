/**
 * String-to-float parsing on the byte targets: `parseF64` in
 * `string-convert.zena`, which shares that file's power-of-ten tables with
 * float printing.
 *
 * A virtual module. The js target selects `number-parse-js.zena`, which
 * asks the host instead.
 */
export { parseF64 } from './string-convert.zena';
