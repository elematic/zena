/**
 * Joining strings, over whichever `StringBuilder` the target selects.
 *
 * `string-builder.zena` is a virtual module with one implementation per
 * target, so anything declared beside it would be declared once per target.
 * These are written once, here.
 */
import { StringBuilder } from './string-builder.zena';

export extension class IterableJoin<T> on Iterable<T> {
  join(stringify: (item: T) => String, separator: String = ', '): String {
    let sb = new StringBuilder();
    let iter = this.[Iterable.iterator]();
    var first = true;
    for (let item in iter) {
      if (!first) {
        sb.append(separator);
      }
      sb.append(stringify(item));
      first = false;
    }
    return sb.toString();
  }
}

/**
 * Concatenates the strings in `items` with `separator` between adjacent elements.
 */
export function join(items: Iterable<String>, separator: String = ''): String {
  let sb = new StringBuilder();
  var first = true;
  for (let item in items) {
    if (!first) {
      sb.append(separator);
    }
    sb.append(item);
    first = false;
  }
  return sb.toString();
}
