/**
 * String conversion functions for primitive types

 * These provide both low-level buffer writing (for StringBuilder) and
 * high-level String creation (for template literals).
 */

import { String, Encoding } from 'zena:string';
import { FixedArray } from 'zena:fixed-array';
import { div, I32_MIN, I64_MIN, abs, i64_reinterpret_f64, i32_reinterpret_f32, f64_reinterpret_i64, clz, mulWide } from 'zena:math';

// ============================================================================
// Low-level buffer writing functions
// These write to a pre-allocated ByteArray and return (startPos, endPos).
// They write digits in reverse from the end of the buffer.
// The caller must provide a buffer of sufficient size.
// ============================================================================

/**
 * Writes an i32 to a buffer. Buffer must have at least 11 bytes.
 * Returns (startPos, endPos) where the digits are in buffer[startPos..endPos).
 */
export let writeI32 = (value: i32, buffer: ByteArray, bufferEnd: i32): inline (i32, i32) => {
  if (value == 0) {
    __byte_array_set(buffer, bufferEnd - 1, 48);
    return (bufferEnd - 1, bufferEnd);
  }
  
  if (value == I32_MIN) {
    // Special case: -2147483648 can't be negated without overflow
    let minStr = "-2147483648";
    let start = bufferEnd - 11;
    // TODO: Add a __string_get_bytes intrinsic to avoid creating a temporary
    // String object here
    minStr.copyBytesTo(buffer, start);
    return (start, bufferEnd);
  }
  
  let isNegative = value < 0;
  var absValue = value;
  if (isNegative) {
    absValue = 0 - value;
  }
  
  var pos = bufferEnd;
  while (absValue > 0) {
    pos = pos - 1;
    __byte_array_set(buffer, pos, 48 + (absValue - div(absValue, 10) * 10));
    absValue = div(absValue, 10);
  }
  
  if (isNegative) {
    pos = pos - 1;
    __byte_array_set(buffer, pos, 45);
  }
  
  return (pos, bufferEnd);
};

/**
 * Writes a u32 to a buffer. Buffer must have at least 10 bytes.
 * Returns (startPos, endPos).
 */
export let writeU32 = (value: u32, buffer: ByteArray, bufferEnd: i32): inline (i32, i32) => {
  let zero: u32 = 0 as u32;
  if (value == zero) {
    __byte_array_set(buffer, bufferEnd - 1, 48);
    return (bufferEnd - 1, bufferEnd);
  }
  
  var v = value;
  var pos = bufferEnd;
  while (v > zero) {
    pos = pos - 1;
    let digit = v - div(v, 10 as u32) * (10 as u32);
    __byte_array_set(buffer, pos, 48 + (digit as i32));
    v = div(v, 10 as u32);
  }
  
  return (pos, bufferEnd);
};

/**
 * Writes an i64 to a buffer. Buffer must have at least 20 bytes.
 * Returns (startPos, endPos).
 */
export let writeI64 = (value: i64, buffer: ByteArray, bufferEnd: i32): inline (i32, i32) => {
  let zero: i64 = 0 as i64;
  if (value == zero) {
    __byte_array_set(buffer, bufferEnd - 1, 48);
    return (bufferEnd - 1, bufferEnd);
  }
  
  if (value == I64_MIN) {
    // Special case: -9223372036854775808 can't be negated without overflow
    let minStr = "-9223372036854775808";
    let start = bufferEnd - 20;
    minStr.copyBytesTo(buffer, start);
    return (start, bufferEnd);
  }
  
  let isNegative = value < zero;
  var absValue = value;
  if (isNegative) {
    absValue = zero - value;
  }
  
  var pos = bufferEnd;
  while (absValue > zero) {
    pos = pos - 1;
    let digit = absValue - div(absValue, 10 as i64) * (10 as i64);
    __byte_array_set(buffer, pos, 48 + (digit as i32));
    absValue = div(absValue, 10 as i64);
  }
  
  if (isNegative) {
    pos = pos - 1;
    __byte_array_set(buffer, pos, 45);
  }
  
  return (pos, bufferEnd);
};

/**
 * Writes a u64 to a buffer. Buffer must have at least 20 bytes.
 * Returns (startPos, endPos).
 */
export let writeU64 = (value: u64, buffer: ByteArray, bufferEnd: i32): inline (i32, i32) => {
  let zero: u64 = 0 as u64;
  if (value == zero) {
    __byte_array_set(buffer, bufferEnd - 1, 48);
    return (bufferEnd - 1, bufferEnd);
  }
  
  var v = value;
  var pos = bufferEnd;
  while (v > zero) {
    pos = pos - 1;
    let digit = v - div(v, 10 as u64) * (10 as u64);
    __byte_array_set(buffer, pos, 48 + (digit as i32));
    v = div(v, 10 as u64);
  }
  
  return (pos, bufferEnd);
};

// ============================================================================
// High-level String conversion functions
// Used by template literals for automatic primitive-to-string conversion.
// ============================================================================

/**
 * Converts an i32 to its decimal string representation.
 */
export let i32ToString = (value: i32): String => {
  if (value == I32_MIN) {
    return "-2147483648";
  }
  let buffer = __byte_array_new(12);
  let (start, end) = writeI32(value, buffer, 12);
  return String.fromByteArray(buffer, start, end, Encoding.WTF8);
};

/**
 * Converts a u32 to its decimal string representation.
 */
export let u32ToString = (value: u32): String => {
  let buffer = __byte_array_new(11);
  let (start, end) = writeU32(value, buffer, 11);
  return String.fromByteArray(buffer, start, end, Encoding.WTF8);
};

/**
 * Converts an i64 to its decimal string representation.
 */
export let i64ToString = (value: i64): String => {
  if (value == I64_MIN) {
    return "-9223372036854775808";
  }
  let buffer = __byte_array_new(21);
  let (start, end) = writeI64(value, buffer, 21);
  return String.fromByteArray(buffer, start, end, Encoding.WTF8);
};

/**
 * Converts a u64 to its decimal string representation.
 */
export let u64ToString = (value: u64): String => {
  let buffer = __byte_array_new(21);
  let (start, end) = writeU64(value, buffer, 21);
  return String.fromByteArray(buffer, start, end, Encoding.WTF8);
};

/**
 * Converts a bool to "true" or "false".
 */
export let boolToString = (value: boolean): String => {
  if (value) {
    return "true";
  }
  return "false";
};

// ============================================================================
// String-to-number parsing
// ============================================================================

/**
 * Parse a decimal integer from a string, with optional leading sign.
 * Returns `inline (true, value)` on success, `inline (false, _)` on failure.
 * Fails if the string is empty or contains non-digit characters (after optional sign).
 */
export let parseI32 = (s: String): inline (true, i32) | inline (false, _) => {
  if (s.length == 0) {
    return (false, _);
  }
  var start = 0;
  var negative = false;
  let first = s.getByteAt(0);
  if (first == 45) { // '-'
    negative = true;
    start = 1;
  } else if (first == 43) { // '+'
    start = 1;
  }
  if (start >= s.length) {
    return (false, _);
  }
  var result = 0;
  var i = start;
  // Max positive i32 is 2147483647, max negative is 2147483648.
  // We accumulate as positive and check against the appropriate limit.
  // The first 9 digits are the same (214748364); only the last digit differs.
  let limit = 214748364;
  let maxLastDigit = if (negative) { 8 } else { 7 };
  while (i < s.length) {
    let ch = s.getByteAt(i);
    if (ch < 48 || ch > 57) {
      return (false, _);
    }
    let digit = ch - 48;
    if (result > limit || (result == limit && digit > maxLastDigit)) {
      return (false, _);
    }
    result = result * 10 + digit;
    i += 1;
  }
  if (negative) {
    result = 0 - result;
  }
  return (true, result);
};


// ===========================================================================
// Correctly rounded conversion between binary floats and decimal
//
// The algorithm is the unrounded scaling of
// https://research.swtch.com/fp. One primitive, `uscale`, returns an
// approximation to x * 2^e * 10^p carrying enough extra information to
// round it in any direction; printing and parsing are both a few lines
// on top of it. Everything is exact: `parseF64` returns the float
// nearest the decimal it was given, and `f64ToString` returns the
// shortest decimal that reads back as the float it was given.
//
// `dev/fp-reference.js` (in this package) is the same algorithm in JavaScript, checked
// against that language's own correctly-rounded conversions over
// millions of values, and `dev/fp-gen-tables.js` generates and
// verifies the tables below. This is a transliteration of the first;
// keep the two in step.
// ===========================================================================

// GENERATED by dev/fp-gen-tables.js — do not edit by hand.
//
// The compressed power-of-ten cache. A full 128-bit table over
// p in [-344, 324] would be 10704 bytes; these two hold
// 840 and rebuild any entry with one 192x64 multiply.
// The generator verifies the rebuild reproduces every entry of the
// full table exactly, so this is a size trade and nothing else.

/** 10^(27q) truncated to 192 bits, three words high to low, q from -13. */
let POW10_ANCHORS: FixedArray<u64> = [
  9244100769003082158 as u64, 2331608335343510136 as u64, 12404635893250474763 as u64,   // 10^-351
  14934650266808366570 as u64, 5910495864778290617 as u64, 5142877117464292730 as u64,   // 10^-324
  12064114410120881697 as u64, 12622167777931096654 as u64, 7312877456945461814 as u64,   // 10^-297
  9745314011399999080 as u64, 6518754469289960081 as u64, 14714928903009965783 as u64,   // 10^-270
  15744403932561434696 as u64, 12626303854077184414 as u64, 11746114382721246818 as u64,   // 10^-243
  12718228212127407596 as u64, 13658706619031801779 as u64, 18308159190397764632 as u64,   // 10^-216
  10273702932711667006 as u64, 6088502188546649756 as u64, 4733321751740631165 as u64,   // 10^-189
  16598062275523971834 as u64, 915538744049291538 as u64, 11796442215211893654 as u64,   // 10^-162
  13407807929942597099 as u64, 10588892233814828051 as u64, 2422963254366584019 as u64,   // 10^-135
  10830740992659433045 as u64, 4209185567039092847 as u64, 16791723050533251564 as u64,   // 10^-108
  17498005798264095394 as u64, 18078137856785627587 as u64, 3933290470431885569 as u64,   // 10^-81
  14134776518227074636 as u64, 12292541425473992838 as u64, 10845844145321538984 as u64,   // 10^-54
  11417981541647679048 as u64, 8601490892183123069 as u64, 14576447477258439111 as u64,   // 10^-27
  9223372036854775808 as u64, 0 as u64, 0 as u64,   // 10^0
  14901161193847656250 as u64, 0 as u64, 0 as u64,   // 10^27
  12037062152420224081 as u64, 11065503397408397604 as u64, 0 as u64,   // 10^54
  9723461371658033917 as u64, 7611128154919104931 as u64, 16113757790975053352 as u64,   // 10^81
  15709099088952724969 as u64, 16721424822051837077 as u64, 15513681152740284627 as u64,   // 10^108
  12689709186578246116 as u64, 6827560182880305039 as u64, 13856584293446594591 as u64,   // 10^135
  10250665447337476733 as u64, 1466078993672598279 as u64, 2575331249103045365 as u64,   // 10^162
  16560843210556190337 as u64, 10310543607939835386 as u64, 17344994892919524476 as u64,   // 10^189
  13377742608693866209 as u64, 7896285879677171346 as u64, 9867298837582875614 as u64,   // 10^216
  10806454419566533849 as u64, 5385653213018257806 as u64, 962163898128633415 as u64,   // 10^243
  17458768723248864463 as u64, 13574758819556003052 as u64, 4439498980731556220 as u64,   // 10^270
  14103081061443981063 as u64, 758345818024902856 as u64, 171258419585080375 as u64,   // 10^297
  11392378155556871081 as u64, 7784369436827535057 as u64, 5279584310227164866 as u64,   // 10^324
];

/** 5^r normalized to bit 63 (exact: 5^26 < 2^61), r in [0, 26]. */
let POW5_SHIFTED: FixedArray<u64> = [
  9223372036854775808 as u64,   // 5^0
  11529215046068469760 as u64,   // 5^1
  14411518807585587200 as u64,   // 5^2
  18014398509481984000 as u64,   // 5^3
  11258999068426240000 as u64,   // 5^4
  14073748835532800000 as u64,   // 5^5
  17592186044416000000 as u64,   // 5^6
  10995116277760000000 as u64,   // 5^7
  13743895347200000000 as u64,   // 5^8
  17179869184000000000 as u64,   // 5^9
  10737418240000000000 as u64,   // 5^10
  13421772800000000000 as u64,   // 5^11
  16777216000000000000 as u64,   // 5^12
  10485760000000000000 as u64,   // 5^13
  13107200000000000000 as u64,   // 5^14
  16384000000000000000 as u64,   // 5^15
  10240000000000000000 as u64,   // 5^16
  12800000000000000000 as u64,   // 5^17
  16000000000000000000 as u64,   // 5^18
  10000000000000000000 as u64,   // 5^19
  12500000000000000000 as u64,   // 5^20
  15625000000000000000 as u64,   // 5^21
  9765625000000000000 as u64,   // 5^22
  12207031250000000000 as u64,   // 5^23
  15258789062500000000 as u64,   // 5^24
  9536743164062500000 as u64,   // 5^25
  11920928955078125000 as u64,   // 5^26
];


// ---------------------------------------------------------------------------
// Exponent estimates. Both are exact over the ranges reached here (the
// divisors are powers of two, so the arithmetic shift IS the floor).
// ---------------------------------------------------------------------------

/** floor(log2(10^p)). */
let log2Pow10 = (p: i32): i32 => (p * 108853) >> 15;

/** floor(log10(2^e)). */
let log10Pow2 = (e: i32): i32 => (e * 78913) >> 18;

/**
 * floor(log10(3 * 2^(e-2))) — the estimate for an exact power of two,
 * whose rounding interval is not one ulp wide but three quarters of
 * one: the binade below has half the spacing, so the interval runs a
 * quarter ulp down and half an ulp up. 125076 is round(log10(3) * 2^18).
 */
let skewedPow2 = (e: i32): i32 => (((e - 2) * 78913) + 125076) >> 18;

// ---------------------------------------------------------------------------
// The unrounded number.
//
// `u` encodes 4*v: the value sits above bit 2, bit 1 says the fraction
// reaches one half, and bit 0 is sticky — some fraction beyond that.
// Every rounding mode is then an add and a shift.
// ---------------------------------------------------------------------------

let ZERO: u64 = 0 as u64;
let ONE: u64 = 1 as u64;

let uFloor = (u: u64): u64 => u >> (2 as u64);
let uCeil = (u: u64): u64 => (u + (3 as u64)) >> (2 as u64);
/** Round half to even. */
let uRound = (u: u64): u64 =>
    (u + ONE + ((u >> (2 as u64)) & ONE)) >> (2 as u64);
/** Halve, keeping the sticky bit. */
let uHalve = (u: u64): u64 => (u >> ONE) | (u & ONE);

// ---------------------------------------------------------------------------
// The power-of-ten cache
// ---------------------------------------------------------------------------

/** a + b + carryIn, as (sum, carryOut). */
let addCarry = (a: u64, b: u64, carryIn: u64): inline (u64, u64) => {
  let s1 = a + b;
  let c1 = if (s1 < a) { ONE } else { ZERO };
  let s2 = s1 + carryIn;
  let c2 = if (s2 < s1) { ONE } else { ZERO };
  return (s2, c1 + c2);
};

/**
 * 10^p's significand rounded UP to 128 bits, in BORROW form:
 * pm = hi * 2^64 - lo. That form is what lets `uscale` decide
 * exactness — see the comment there.
 *
 * Rebuilt from the compressed cache: 10^p = 10^(27q) * 5^r * 2^r, so
 * one 192x64 multiply of the anchor for p's stride block by the
 * (exact) shifted power of five recovers the entry. The generator
 * verifies this reproduces a full 128-bit table entry for entry, so
 * the compression trades table bytes for the multiply above.
 *
 * `p` must be within [-344, 324]; callers clamp before reaching here.
 */
let pow10Borrow = (p: i32): inline (u64, u64) => {
  // 27 * 13 = 351 > 344, so the bias makes the dividend positive and
  // truncating division is floor division.
  let q = div(p + 351, 27);
  let r = p + 351 - q * 27;
  let base = q * 3;
  let f = POW5_SHIFTED[r];
  let (l2, h2) = mulWide(POW10_ANCHORS[base], f);
  let (l1, h1) = mulWide(POW10_ANCHORS[base + 1], f);
  let (l0, h0) = mulWide(POW10_ANCHORS[base + 2], f);
  // P = anchor * f as four words. The anchor is >= 2^191 and f >= 2^63,
  // so P >= 2^254: its top bit is bit 255 or bit 254, never lower, and
  // normalizing is a shift by one or by nothing.
  let w0 = l0;
  let (w1, c1) = addCarry(l1, h0, ZERO);
  let (w2, c2) = addCarry(l2, h1, c1);
  let w3 = h2 + c2;

  var pmHi = w3;
  var pmLo = w2;
  var restHi = w1;
  var restLo = w0;
  if ((w3 >> (63 as u64)) == ZERO) {
    pmHi = (w3 << ONE) | (w2 >> (63 as u64));
    pmLo = (w2 << ONE) | (w1 >> (63 as u64));
    restHi = (w1 << ONE) | (w0 >> (63 as u64));
    restLo = w0 << ONE;
  }
  if (restHi != ZERO || restLo != ZERO) {
    pmLo = pmLo + ONE;
    if (pmLo == ZERO) {
      pmHi = pmHi + ONE;
    }
  }
  if (pmLo == ZERO) {
    return (pmHi, ZERO);
  }
  return (pmHi + ONE, ZERO - pmLo);
};

/**
 * The scaling constants for one (e, p): the borrow-form power of ten
 * and the shift that lands its product in the unrounded form. They
 * depend only on the exponents, so a conversion computes them once and
 * scales several values through them.
 */
let prescale = (e: i32, p: i32): inline (u64, u64, i32) => {
  let (pmHi, pmLo) = pow10Borrow(p);
  return (pmHi, pmLo, 0 - (e + log2Pow10(p) + 3));
};

/**
 * An unrounded x * 2^e * 10^p, for an x with its high bit set.
 *
 * Only the top word of the 192-bit product survives the shift, so the
 * low word of x * pm.lo is never needed — and when any discarded bit
 * of the top word is set, neither is the rest: the result is inexact
 * whatever the low bits say.
 *
 * The `> 1` is where rounding the table entry UP pays off. Doing so
 * makes the stored pm exceed the true 10^p by some fraction below one,
 * hence the product exceed the true product by less than 2^64 — at
 * most one unit of the middle word. So a middle-word residue of 0 or 1
 * cannot be told from an exact zero, and the algorithm's precision
 * argument is exactly the claim that it never has to be: at this scale
 * the true value is exact, or it is more than a unit away from exact.
 */
let uscale = (x: u64, pmHi: u64, pmLo: u64, s: i32): u64 => {
  if (s >= 64) {
    // Everything shifts out. x >= 2^63 and pm >= 2^127 make the
    // product nonzero, and 4*value < 1, so the answer is "zero, but
    // not exactly zero".
    return ONE;
  }
  let shift = s as u64;
  let (mid, high) = mulWide(x, pmHi);
  var hi = high;
  var sticky = ONE;
  if ((hi & ((ONE << shift) - ONE)) == ZERO) {
    // Only the high word matters: the low one is entirely below
    // the shift, and the residue test above already covers it.
    let (_, mid2) = mulWide(x, pmLo);
    sticky = if ((mid - mid2) > ONE) { ONE } else { ZERO };
    if (mid < mid2) {
      hi = hi - ONE;
    }
  }
  return (hi >> shift) | sticky;
};

// ---------------------------------------------------------------------------
// Float bit surgery
//
// A float is carried as (m, e) with value = m * 2^e and m normalized
// to bit 63, which is the form uscale wants. `z` is then the number of
// low bits of m below the significand (64 - 53 for f64, 64 - 24 for
// f32) and `minExp` the e of the smallest normal — below it the
// significand is short and z grows to match.
// ---------------------------------------------------------------------------

let F64_Z: i32 = 11;
let F64_MIN_EXP: i32 = -1085;
let F32_Z: i32 = 40;
let F32_MIN_EXP: i32 = -189;

let INFINITY_BITS: i64 = 9218868437227405312 as i64;   // 0x7FF0000000000000
let SIGN_BIT: i64 = -9223372036854775808 as i64;       // 0x8000000000000000

/** A positive finite f64's bits as (m, e), m normalized to bit 63. */
let unpackF64 = (bits: i64): inline (u64, i32) => {
  let biased = ((bits >> (52 as i64)) & (0x7FF as i64)) as i32;
  var m = (bits & (0xFFFFFFFFFFFFF as i64)) as u64;
  var e = -1074;
  if (biased != 0) {
    m = m | (ONE << (52 as u64));
    e = biased - 1075;
  }
  let shift = clz(m) as i32;
  return (m << (shift as u64), e - shift);
};

/** A positive finite f32's bits as (m, e), m normalized to bit 63. */
let unpackF32 = (bits: i32): inline (u64, i32) => {
  let biased = (bits >> 23) & 0xFF;
  var m = ((bits & 0x7FFFFF) as i64) as u64;
  var e = -149;
  if (biased != 0) {
    m = m | (ONE << (23 as u64));
    e = biased - 150;
  }
  let shift = clz(m) as i32;
  return (m << (shift as u64), e - shift);
};

/**
 * The f64 whose value is `mant * 2^-e`, or an infinity when that
 * overflows. A `mant` below 2^52 is a subnormal and carries its own
 * (zero) exponent field, which is also how a zero result arrives.
 */
let packF64 = (mant: u64, e: i32, negative: boolean): f64 => {
  var m = mant;
  var ex = e;
  if (m >= (ONE << (53 as u64))) {
    // A final round-up carried into the next binade.
    m = m >> ONE;
    ex = ex - 1;
  }
  var biased = 1075 - ex;
  if (m < (ONE << (52 as u64))) {
    biased = 0;
  }
  var bits = INFINITY_BITS;
  if (biased < 0x7FF) {
    bits = ((biased as i64) << (52 as i64)) |
        ((m & (0xFFFFFFFFFFFFF as u64)) as i64);
  }
  if (negative) {
    bits = bits | SIGN_BIT;
  }
  return f64_reinterpret_i64(bits);
};

// ---------------------------------------------------------------------------
// Parsing
// ---------------------------------------------------------------------------

/**
 * The f64 nearest to `d * 10^p`, correctly rounded. `d` is the decimal
 * significand as an integer below 2^64 and `p` its decimal exponent.
 * `inexact` says the true value lies strictly between `d` and `d + 1`
 * — the caller had more digits than it could keep — and `tail` is that
 * leftover fraction scaled by 2^11.
 *
 * With 19 or fewer significant digits `inexact` is false and the
 * result is the correctly rounded one, always. Beyond that the
 * significand no longer fits: normalizing d to 64 bits leaves only
 * 64 - bits(d) low bits for the remainder, so the value is placed to
 * within half of the last of them and can land on the wrong side of a
 * rounding boundary that falls inside that gap. Measured against a
 * correctly-rounded implementation this is about one input in five
 * thousand of more than 19 significant digits, always by one ulp
 * (dev/fp-difftest.js measures it).
 * Closing it needs an exact-arithmetic fallback, which the algorithm
 * this comes from also leaves to its caller.
 */
export let decimalToF64 = (
  d: u64,
  p: i32,
  negative: boolean,
  inexact: boolean,
  tail: u64
): f64 => {
  if (d == ZERO) {
    return packF64(ZERO, 0, negative);
  }
  // Outside these the answer needs no table: d >= 1 forces overflow,
  // and d < 2^64 forces underflow to zero.
  if (p > 309) {
    return packF64(ONE << (53 as u64), -100000, negative);
  }
  if (p < -344) {
    return packF64(ZERO, 0, negative);
  }
  let b = 64 - (clz(d) as i32);
  let lp = log2Pow10(p);
  // The e that lands d * 2^e * 10^p in [2^52, 2^53), capped so the
  // result is never finer than the smallest subnormal.
  var e = 53 - b - lp;
  if (e > 1074) {
    e = 1074;
  }
  let (pmHi, pmLo, s) = prescale(e - (64 - b), p);
  // Normalizing d to 64 bits leaves 64-b low bits free, and the
  // leftover fraction goes there — so digits past the nineteenth
  // still move the value, rather than only setting the sticky bit.
  var x = d << ((64 - b) as u64);
  if (inexact) {
    let nudge = ((tail << ((64 - b) as u64)) + (1024 as u64)) >> (11 as u64);
    // Never let the nudge carry out of 64 bits; at that point the
    // significand is at the top of its range and the nudge cannot
    // change the answer anyway.
    if (x + nudge > x) {
      x = x + nudge;
    }
  }
  var u = uscale(x, pmHi, pmLo, s);
  if (inexact) {
    // Whatever is left below the nudge is still strictly positive,
    // which is what the sticky bit means and what turns a tie into a
    // round-up.
    u = u | ONE;
  }
  var ex = e;
  // 4 * 2^53 - 2 is the unrounded encoding of exactly 2^53 - 1/2:
  // at or above it the significand would round out of range.
  if (u >= ((ONE << (55 as u64)) - (2 as u64))) {
    u = uHalve(u);
    ex = e - 1;
  }
  return packF64(uRound(u), ex, negative);
};

// ---------------------------------------------------------------------------
// Shortest-round-trip printing
// ---------------------------------------------------------------------------

/**
 * The shortest decimal `d * 10^p` that reads back as the float
 * (m, e) — where m is normalized to bit 63, `z` is the count of bits
 * below its significand and `minExp` the exponent of the smallest
 * normal.
 *
 * The rounding interval is the half-open span of reals that round to
 * this float: half an ulp each way, except at an exact power of two,
 * where the binade below has half the spacing and the interval runs
 * only a quarter ulp down. `odd` decides whether the endpoints
 * themselves belong to it — with an even significand a tie rounds
 * inward, so they do.
 */
let shortestDigits = (
  m: u64,
  e: i32,
  zBase: i32,
  minExp: i32
): inline (u64, i32) => {
  var z = zBase;
  var p = 0;
  var lo = ZERO;
  if (m == (ONE << (63 as u64)) && e > minExp) {
    p = 0 - skewedPow2(e + z);
    lo = m - (ONE << ((z - 2) as u64));
  } else {
    if (e < minExp) {
      // Subnormal: the significand is short by exactly this much.
      z = zBase + (minExp - e);
    }
    p = 0 - log10Pow2(e + z);
    lo = m - (ONE << ((z - 1) as u64));
  }
  let hi = m + (ONE << ((z - 1) as u64));
  let odd = (m >> (z as u64)) & ONE;

  let (pmHi, pmLo, s) = prescale(e, p);
  let dmin = uCeil(uscale(lo, pmHi, pmLo, s) + odd);
  let dmax = uFloor(uscale(hi, pmHi, pmLo, s) - odd);

  // A multiple of ten inside the interval means one fewer digit.
  var d = div(dmax, 10 as u64);
  if (d * (10 as u64) >= dmin) {
    var out = d;
    var outP = 0 - (p - 1);
    while (out != ZERO && div(out, 10 as u64) * (10 as u64) == out) {
      out = div(out, 10 as u64);
      outP = outP + 1;
    }
    return (out, outP);
  }
  d = dmin;
  if (d < dmax) {
    // More than one shortest candidate: take the nearest.
    d = uRound(uscale(m, pmHi, pmLo, s));
  }
  return (d, 0 - p);
};

// ---------------------------------------------------------------------------
// Fixed-width printing
// ---------------------------------------------------------------------------

/**
 * `n` significant decimal digits of the float (m, e), correctly
 * rounded, as (digits, p) with value ~ digits * 10^p and digits
 * having exactly n of them. n must be in [1, 18].
 */
let fixedDigits = (m: u64, e: i32, n: i32): inline (u64, i32) => {
  // m is normalized to 64 bits, so its leading digit sits at
  // 10^floor(log10(2^(e+63))) and n digits start n-1 below that.
  var p = n - 1 - log10Pow2(e + 63);
  let (pmHi, pmLo, s) = prescale(e, p);
  var d = uRound(uscale(m, pmHi, pmLo, s));
  // The estimate can be one low, or rounding can carry into an extra
  // digit; either way one division puts it back in range.
  var limit = ONE;
  var i = 0;
  while (i < n) {
    limit = limit * (10 as u64);
    i = i + 1;
  }
  if (d >= limit) {
    d = div(d, 10 as u64);
    p = p - 1;
  }
  return (d, 0 - p);
};

/**
 * Renders `digits * 10^(exp - numDigits + 1)` in ECMAScript's format:
 * plain notation when the decimal exponent is in [-6, 21), scientific
 * otherwise. `exp` is the decimal exponent of the FIRST digit.
 */
let formatDecimal = (
  digits: u64,
  numDigits: i32,
  decExp: i32,
  isNegative: boolean
): String => {
  let exp = decExp;
  let ten_i: u64 = 10 as u64;

  // Extract individual digits to temp buffer (right to left)
  let digitBuf = __byte_array_new(20);
  var dLen = 0;
  var dTemp = digits;
  while (dTemp != ZERO) {
    let d = dTemp - div(dTemp, ten_i) * ten_i;
    __byte_array_set(digitBuf, 19 - dLen, 48 + (d as i32));
    dLen = dLen + 1;
    dTemp = div(dTemp, ten_i);
  }
  let dStart = 20 - dLen;
  // digits are now in digitBuf[dStart..20), left to right

  // Build output string
  let buffer = __byte_array_new(50);
  var pos = 0;

  // Write sign
  if (isNegative) {
    __byte_array_set(buffer, 0, 45);
    pos = 1;
  }

  // Choose format based on exponent range (ECMAScript-style)
  if (exp >= 0 && exp < 21) {
    // Normal notation with integer part
    let intDigitCount = exp + 1;

    if (numDigits <= intDigitCount) {
      // All significant digits are in the integer part
      var di = dStart;
      while (di < 20) {
        __byte_array_set(buffer, pos, __byte_array_get(digitBuf, di));
        pos = pos + 1;
        di = di + 1;
      }
      // Append trailing zeros
      let trailingZeros = intDigitCount - numDigits;
      var zi = 0;
      while (zi < trailingZeros) {
        __byte_array_set(buffer, pos, 48);
        pos = pos + 1;
        zi = zi + 1;
      }
    } else {
      // Digits span the decimal point
      var di = dStart;
      var written = 0;
      // Write integer part
      while (written < intDigitCount) {
        __byte_array_set(buffer, pos, __byte_array_get(digitBuf, di));
        pos = pos + 1;
        di = di + 1;
        written = written + 1;
      }
      // Decimal point
      __byte_array_set(buffer, pos, 46);
      pos = pos + 1;
      // Fractional digits
      while (di < 20) {
        __byte_array_set(buffer, pos, __byte_array_get(digitBuf, di));
        pos = pos + 1;
        di = di + 1;
      }
    }
  } else if (exp >= -6 && exp < 0) {
    // Small number in normal notation: 0.000...digits
    __byte_array_set(buffer, pos, 48);
    pos = pos + 1;
    __byte_array_set(buffer, pos, 46);
    pos = pos + 1;

    // Leading zeros
    let leadingZeros = 0 - exp - 1;
    var zi = 0;
    while (zi < leadingZeros) {
      __byte_array_set(buffer, pos, 48);
      pos = pos + 1;
      zi = zi + 1;
    }

    // Significant digits
    var di = dStart;
    while (di < 20) {
      __byte_array_set(buffer, pos, __byte_array_get(digitBuf, di));
      pos = pos + 1;
      di = di + 1;
    }
  } else {
    // Scientific notation: d.dddde±eee
    // First digit
    __byte_array_set(buffer, pos, __byte_array_get(digitBuf, dStart));
    pos = pos + 1;

    // Decimal point and remaining digits (if any)
    if (numDigits > 1) {
      __byte_array_set(buffer, pos, 46);
      pos = pos + 1;
      var di = dStart + 1;
      while (di < 20) {
        __byte_array_set(buffer, pos, __byte_array_get(digitBuf, di));
        pos = pos + 1;
        di = di + 1;
      }
    }

    // 'e'
    __byte_array_set(buffer, pos, 101);
    pos = pos + 1;

    // Exponent sign and value
    var absExp = exp;
    if (exp >= 0) {
      __byte_array_set(buffer, pos, 43);
      pos = pos + 1;
    } else {
      __byte_array_set(buffer, pos, 45);
      pos = pos + 1;
      absExp = 0 - exp;
    }

    // Exponent digits (1-3 digits)
    if (absExp >= 100) {
      let h = div(absExp as i64, 100 as i64) as i32;
      __byte_array_set(buffer, pos, 48 + h);
      pos = pos + 1;
      absExp = absExp - h * 100;
      // Must always emit tens digit after hundreds
      let t = div(absExp as i64, 10 as i64) as i32;
      __byte_array_set(buffer, pos, 48 + t);
      pos = pos + 1;
      absExp = absExp - t * 10;
      __byte_array_set(buffer, pos, 48 + absExp);
      pos = pos + 1;
    } else if (absExp >= 10) {
      let t = div(absExp as i64, 10 as i64) as i32;
      __byte_array_set(buffer, pos, 48 + t);
      pos = pos + 1;
      absExp = absExp - t * 10;
      __byte_array_set(buffer, pos, 48 + absExp);
      pos = pos + 1;
    } else {
      __byte_array_set(buffer, pos, 48 + absExp);
      pos = pos + 1;
    }
  }

  return String.fromByteArray(buffer, 0, pos, Encoding.WTF8);
};

/** NaN, the infinities and the zeros, which have no digits to compute. */
let nonFiniteToString = (value: f64, bits: i64): String => {
  if (value != value) {
    return "NaN";
  }
  let selfDiff = value - value;
  if (selfDiff != 0.0) {
    if (value > 0.0) {
      return "Infinity";
    }
    return "-Infinity";
  }
  if (bits != (0 as i64)) {
    return "-0";
  }
  return "0";
};

/** How many decimal digits `d` has (d != 0). */
let digitCount = (d: u64): i32 => {
  var n = 1;
  var rest = div(d, 10 as u64);
  while (rest != (0 as u64)) {
    n = n + 1;
    rest = div(rest, 10 as u64);
  }
  return n;
};

/**
 * The shortest decimal string that reads back as `value`. Correct by
 * construction: `shortestDigits` returns the fewest digits whose
 * rounding interval contains the float, and the nearest such when
 * there is a choice.
 */
let floatToStringImpl = (value: f64, isF32: boolean): String => {
  let bits = i64_reinterpret_f64(value);
  if (value != value || value - value != 0.0 || value == 0.0) {
    return nonFiniteToString(value, bits);
  }
  let isNegative = value < 0.0;
  let magnitude = abs(value);
  var d = 0 as u64;
  var p = 0;
  if (isF32) {
    let (m, e) = unpackF32(i32_reinterpret_f32(magnitude as f32));
    let (dd, pp) = shortestDigits(m, e, F32_Z, F32_MIN_EXP);
    d = dd;
    p = pp;
  } else {
    let (m, e) = unpackF64(i64_reinterpret_f64(magnitude));
    let (dd, pp) = shortestDigits(m, e, F64_Z, F64_MIN_EXP);
    d = dd;
    p = pp;
  }
  let numDigits = digitCount(d);
  return formatDecimal(d, numDigits, numDigits - 1 + p, isNegative);
};


/**
 * The shortest decimal string that reads back as this f32. The f32
 * interval is used, not the f64 one the promoted value would have, so
 * `0.1 as f32` prints "0.1" rather than "0.10000000149011612".
 */
export let f32ToString = (value: f32): String => {
  return floatToStringImpl(value as f64, true);
};

/** The shortest decimal string that reads back as this f64. */
export let f64ToString = (value: f64): String => {
  return floatToStringImpl(value, false);
};

/**
 * `value` rounded to `sigDigits` significant decimal digits, in the
 * same format `f64ToString` uses. `sigDigits` is clamped to [1, 17].
 */
export let f64ToPrecision = (value: f64, sigDigits: i32): String => {
  let bits = i64_reinterpret_f64(value);
  if (value != value || value - value != 0.0 || value == 0.0) {
    return nonFiniteToString(value, bits);
  }
  var n = sigDigits;
  if (n < 1) { n = 1; }
  if (n > 17) { n = 17; }
  let isNegative = value < 0.0;
  let (m, e) = unpackF64(i64_reinterpret_f64(abs(value)));
  let (d, p) = fixedDigits(m, e, n);
  return formatDecimal(d, n, n - 1 + p, isNegative);
};

/**
 * Parses a decimal (or hexadecimal) number string to the NEAREST f64,
 * correctly rounded.
 *
 * The significand is accumulated as an integer and the exponent
 * tracked alongside, so no rounding happens until the single
 * `decimalToF64` at the end. Digits beyond the nineteenth cannot
 * change the result except through the tie they might break, so they
 * are folded into a sticky low digit rather than dropped.
 */
export let parseF64 = (s: String): f64 => {
  let len = s.length;
  var i = 0;
  var negative = false;
  if (i < len && s.getByteAt(i) == 45) { // '-'
    negative = true;
    i += 1;
  } else if (i < len && s.getByteAt(i) == 43) { // '+'
    i += 1;
  }

  // Hex literal: an exact integer, no scaling involved.
  if (i + 1 < len && s.getByteAt(i) == 48) { // '0'
    let next = s.getByteAt(i + 1);
    if (next == 120 || next == 88) { // 'x' or 'X'
      i += 2;
      var hexValue: f64 = 0.0;
      while (i < len) {
        let hb = s.getByteAt(i);
        var digit = -1;
        if (hb >= 48 && hb <= 57) {
          digit = hb - 48;
        } else if (hb >= 97 && hb <= 102) {
          digit = hb - 87;
        } else if (hb >= 65 && hb <= 70) {
          digit = hb - 55;
        } else {
          break;
        }
        hexValue = hexValue * 16.0 + (digit as f64);
        i += 1;
      }
      if (negative) {
        return 0.0 - hexValue;
      }
      return hexValue;
    }
  }

  // Nineteen digits is the most that fits in a u64 without risk of
  // overflow (10^19 < 2^64); the twentieth onwards only need to be
  // remembered as "there was more".
  let maxDigits = 19;
  var sig: u64 = 0 as u64;
  var digits = 0;
  var exp10 = 0;
  var sawDigit = false;
  var truncated = false;
  // The first few digits that do not fit, as a fraction of the last
  // one that did. Six is comfortably more than the eleven bits it is
  // scaled into below.
  var tailValue: u64 = 0 as u64;
  var tailCount = 0;

  while (i < len) {
    let b = s.getByteAt(i);
    if (b < 48 || b > 57) {
      break;
    }
    sawDigit = true;
    if (digits < maxDigits) {
      if (!(sig == (0 as u64) && b == 48)) {
        sig = sig * (10 as u64) + ((b - 48) as u64);
        digits += 1;
      }
    } else {
      exp10 += 1;
      if (tailCount < 6) {
        tailValue = tailValue * (10 as u64) + ((b - 48) as u64);
        tailCount += 1;
      }
      if (b != 48) {
        truncated = true;
      }
    }
    i += 1;
  }

  if (i < len && s.getByteAt(i) == 46) { // '.'
    i += 1;
    while (i < len) {
      let fb = s.getByteAt(i);
      if (fb < 48 || fb > 57) {
        break;
      }
      sawDigit = true;
      if (digits < maxDigits) {
        if (sig == (0 as u64) && fb == 48) {
          // Leading zeros after the point do not consume precision,
          // they only move the exponent.
          exp10 -= 1;
        } else {
          sig = sig * (10 as u64) + ((fb - 48) as u64);
          digits += 1;
          exp10 -= 1;
        }
      } else {
        if (tailCount < 6) {
          tailValue = tailValue * (10 as u64) + ((fb - 48) as u64);
          tailCount += 1;
        }
        if (fb != 48) {
          truncated = true;
        }
      }
      i += 1;
    }
  }

  if (!sawDigit) {
    return 0.0;
  }

  if (i < len) {
    let ec = s.getByteAt(i);
    if (ec == 101 || ec == 69) { // 'e' or 'E'
      i += 1;
      var expNeg = false;
      if (i < len) {
        let sign = s.getByteAt(i);
        if (sign == 45) {
          expNeg = true;
          i += 1;
        } else if (sign == 43) {
          i += 1;
        }
      }
      var expVal = 0;
      while (i < len) {
        let eb = s.getByteAt(i);
        if (eb < 48 || eb > 57) {
          break;
        }
        // Saturate rather than wrap: any exponent this large already
        // decides the answer.
        if (expVal < 100000) {
          expVal = expVal * 10 + (eb - 48);
        }
        i += 1;
      }
      if (expNeg) {
        exp10 -= expVal;
      } else {
        exp10 += expVal;
      }
    }
  }

  if (exp10 > 100000) {
    exp10 = 100000;
  }
  if (exp10 < -100000) {
    exp10 = -100000;
  }
  var tail: u64 = 0 as u64;
  if (truncated && tailCount > 0) {
    var scale: u64 = 1 as u64;
    var t = 0;
    while (t < tailCount) {
      scale = scale * (10 as u64);
      t += 1;
    }
    tail = div(tailValue << (11 as u64), scale);
  }
  return decimalToF64(sig, exp10, negative, truncated, tail);
};

/**
 * Parse an i64 integer from a string, supporting optional leading sign,
 * optional hex prefix (0x or 0X), and optional underscores (_).
 * Returns `inline (true, value)` on success, `inline (false, _)` on failure.
 */
export let parseI64 = (s: String): inline (true, i64) | inline (false, _) => {
  if (s.length == 0) {
    return (false, _);
  }
  var isNeg = false;
  var start = 0;
  let first = s.getByteAt(0);
  if (first == 45) { // '-'
    isNeg = true;
    start = 1;
  } else if (first == 43) { // '+'
    start = 1;
  }
  if (start >= s.length) {
    return (false, _);
  }
  
  var isHex = false;
  if (start + 2 <= s.length) {
    let c0 = s.getByteAt(start);
    let c1 = s.getByteAt(start + 1);
    if (c0 == 48 && (c1 == 120 || c1 == 88)) { // '0' and ('x' or 'X')
      isHex = true;
      start = start + 2;
    }
  }
  if (start >= s.length) {
    return (false, _);
  }

  var res: u64 = 0 as u64;
  var i = start;
  let ten = 10 as u64;
  let sixteen = 16 as u64;
  var hasDigits = false;
  
  while (i < s.length) {
    let code = s.getByteAt(i);
    var digit = -1;
    if (code >= 48 && code <= 57) { // '0'..'9'
      digit = code - 48;
    } else if (isHex && code >= 97 && code <= 102) { // 'a'..'f'
      digit = code - 97 + 10;
    } else if (isHex && code >= 65 && code <= 70) { // 'A'..'F'
      digit = code - 65 + 10;
    } else if (code == 95) { // '_'
      i += 1;
      continue;
    } else {
      return (false, _);
    }
    
    let base = if (isHex) sixteen else ten;
    let limit: u64 = if (isNeg) (9223372036854775807 as u64) + (1 as u64) else 9223372036854775807 as u64;

    let limitDivBase = div(limit, base);
    let limitModBase = (limit - div(limit, base) * base) as i32;

    if (res > limitDivBase || (res == limitDivBase && digit > limitModBase)) {
      return (false, _);
    }
    
    res = res * base + (digit as u64);
    hasDigits = true;
    i += 1;
  }
  
  if (!hasDigits) {
    return (false, _);
  }

  let finalVal: i64 = if (isNeg) (0 as i64) - (res as i64) else res as i64;
  return (true, finalVal);
};
