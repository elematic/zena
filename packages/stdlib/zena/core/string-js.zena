/** Whether `data[i]` is in bounds and a UTF-8 continuation byte. */
function isContinuation(data: ByteArray, i: i32, end: i32): boolean {
  return i < end && (__byte_array_get(data, i) & 0xC0) == 0x80;
}

/**
 * Decodes `data[start, end)` as WTF-8: UTF-8 that may also carry a lone
 * surrogate (U+D800 to U+DFFF) in its three-byte form. A byte that does not
 * start a well-formed sequence decodes as U+FFFD, and decoding resumes at the
 * next byte.
 */
function decodeWtf8(data: ByteArray, start: i32, end: i32): externref {
  var res = ''.handle;
  var i = start;
  while (i < end) {
    let b0 = __byte_array_get(data, i);
    var cp = 0xFFFD;
    var n = 1;
    if (b0 < 0x80) {
      cp = b0;
    } else if (b0 >= 0xC2 && b0 < 0xE0) {
      if (isContinuation(data, i + 1, end)) {
        cp = ((b0 & 0x1F) << 6) | (__byte_array_get(data, i + 1) & 0x3F);
        n = 2;
      }
    } else if (b0 >= 0xE0 && b0 < 0xF0) {
      if (isContinuation(data, i + 1, end) && isContinuation(data, i + 2, end)) {
        let c = ((b0 & 0x0F) << 12) |
            ((__byte_array_get(data, i + 1) & 0x3F) << 6) |
            (__byte_array_get(data, i + 2) & 0x3F);
        // Below U+0800 is an overlong encoding.
        if (c >= 0x800) {
          cp = c;
          n = 3;
        }
      }
    } else if (b0 >= 0xF0 && b0 < 0xF5) {
      if (isContinuation(data, i + 1, end) && isContinuation(data, i + 2, end) &&
          isContinuation(data, i + 3, end)) {
        let c = ((b0 & 0x07) << 18) |
            ((__byte_array_get(data, i + 1) & 0x3F) << 12) |
            ((__byte_array_get(data, i + 2) & 0x3F) << 6) |
            (__byte_array_get(data, i + 3) & 0x3F);
        if (c >= 0x10000 && c <= 0x10FFFF) {
          cp = c;
          n = 4;
        }
      }
    }
    res = __js_string_concat(res, if (cp < 0x10000)
        __js_string_from_char_code(cp) else __js_string_from_code_point(cp));
    i += n;
  }
  return res;
}

export final extension class StringGraphemes on String implements Iterable<String> {
  [Iterable.iterator](): Iterator<String> {
    return new StringGraphemeIterator(this);
  }

  filter(predicate: (item: String) => boolean): Iterable<String> {
    return new FilteredIterable<String>(this, predicate);
  }

  contains(value: String): boolean {
    for (let item in this) {
      if (item == value) {
        return true;
      }
    }
    return false;
  }

  all(predicate: (item: String) => boolean): boolean {
    for (let item in this) {
      if (!predicate(item)) {
        return false;
      }
    }
    return true;
  }

  some(predicate: (item: String) => boolean): boolean {
    for (let item in this) {
      if (predicate(item)) {
        return true;
      }
    }
    return false;
  }

  fold<R>(initial: R, combine: (acc: R, item: String) => R): R {
    var acc = initial;
    for (let item in this) {
      acc = combine(acc, item);
    }
    return acc;
  }

  find(predicate: (item: String) => boolean): inline (true, String) | inline (false, _) {
    for (let item in this) {
      if (predicate(item)) {
        return (true, item);
      }
    }
    return (false, _);
  }

  count(): i32 {
    var n = 0;
    var cur = this.startIndex;
    let end = this.endIndex;
    while ((cur as i32) < (end as i32)) {
      cur = this.indexAfter(cur);
      n += 1;
    }
    return n;
  }

  toArray(): FixedArray<String> {
    let len = (this as StringGraphemes).count();
    let out = __array_new_empty<String>(len) as FixedArray<String>;
    var i = 0;
    var cur = this.startIndex;
    let end = this.endIndex;
    while ((cur as i32) < (end as i32)) {
      let next = this.indexAfter(cur);
      out[i] = this.unsafeSliceBytes(cur as i32, next as i32);
      cur = next;
      i += 1;
    }
    return out;
  }
}

export final extension class StringCodePoints on String implements Iterable<i32> {
