/**
 * The Zena String class for the JavaScript target (--target js).
 *
 * Uses the WebAssembly JS String Builtins proposal (wasm:js-string)
 * for native WTF-16 JavaScript strings wrapped in a Wasm GC String class
 * backed by #handle: externref.
 */
import { FilteredIterable } from './iterable-utils.zena';
import { Encoding } from './encoding.zena';
import {
  __js_string_length, __js_string_concat, __js_string_equals,
  __js_string_compare, __js_string_substring, __js_string_char_code_at,
  __js_string_code_point_at, __js_string_from_char_code,
  __js_string_from_code_point,
} from './js-string-builtins.zena';
export { Encoding } from './encoding.zena';


export let asciiLowerByte = (b: i32): i32 =>
  if (b >= 0x41 && b <= 0x5A) b + 0x20 else b;

export let asciiUpperByte = (b: i32): i32 =>
  if (b >= 0x61 && b <= 0x7A) b - 0x20 else b;

let isGraphemeControl = (cp: i32): boolean =>
  cp < 0x20 || (cp >= 0x7F && cp <= 0x9F);

let isGraphemeExtend = (cp: i32): boolean => {
  if (cp < 0x0300) {
    return false;
  }
  if (cp <= 0x036F) {
    return true;
  }
  if (cp >= 0x0483 && cp <= 0x0489) {
    return true;
  }
  if ((cp >= 0x0591 && cp <= 0x05BD) || cp == 0x05BF ||
      (cp >= 0x05C1 && cp <= 0x05C2) || (cp >= 0x05C4 && cp <= 0x05C5) ||
      cp == 0x05C7) {
    return true;
  }
  if ((cp >= 0x0610 && cp <= 0x061A) || (cp >= 0x064B && cp <= 0x065F) ||
      cp == 0x0670 || (cp >= 0x06D6 && cp <= 0x06ED)) {
    return true;
  }
  if ((cp >= 0x0900 && cp <= 0x0903) || (cp >= 0x093A && cp <= 0x094F) ||
      (cp >= 0x0951 && cp <= 0x0957) || (cp >= 0x0962 && cp <= 0x0963)) {
    return true;
  }
  if (cp == 0x0E31 || (cp >= 0x0E34 && cp <= 0x0E3A) ||
      (cp >= 0x0E47 && cp <= 0x0E4E)) {
    return true;
  }
  if (cp >= 0x1AB0 && cp <= 0x1AFF) {
    return true;
  }
  if (cp >= 0x1DC0 && cp <= 0x1DFF) {
    return true;
  }
  if (cp >= 0x200C && cp <= 0x200D) {
    return true;
  }
  if (cp >= 0x20D0 && cp <= 0x20FF) {
    return true;
  }
  if (cp >= 0xFE00 && cp <= 0xFE0F) {
    return true;
  }
  if (cp >= 0xFE20 && cp <= 0xFE2F) {
    return true;
  }
  if (cp >= 0x1F3FB && cp <= 0x1F3FF) {
    return true;
  }
  if (cp >= 0xE0020 && cp <= 0xE007F) {
    return true;
  }
  if (cp >= 0xE0100 && cp <= 0xE01EF) {
    return true;
  }
  return false;
};

let isRegionalIndicator = (cp: i32): boolean =>
  cp >= 0x1F1E6 && cp <= 0x1F1FF;

let hangulSyllableType = (cp: i32): i32 => {
  if ((cp >= 0x1100 && cp <= 0x115F) || (cp >= 0xA960 && cp <= 0xA97C)) {
    return 1;
  }
  if ((cp >= 0x1160 && cp <= 0x11A7) || (cp >= 0xD7B0 && cp <= 0xD7C6)) {
    return 2;
  }
  if ((cp >= 0x11A8 && cp <= 0x11FF) || (cp >= 0xD7CB && cp <= 0xD7FB)) {
    return 3;
  }
  if (cp >= 0xAC00 && cp <= 0xD7A3) {
    let offset = cp - 0xAC00;
    let rem = offset - (offset / 28) * 28;
    return if (rem == 0) 4 else 5;
  }
  return 0;
};

export opaque type StringIndex = i32;

export sealed class StringRange {
  case BoundedStringRange, FromStringRange, ToStringRange

  abstract bounds(endIndex: StringIndex): inline (StringIndex, StringIndex);
}

export final class BoundedStringRange extends StringRange {
  start: StringIndex;
  end: StringIndex;

  new(start: StringIndex, end: StringIndex) : start = start, end = end, super();

  bounds(_endIndex: StringIndex): inline (StringIndex, StringIndex) {
    return (this.start, this.end);
  }
}

export final class FromStringRange extends StringRange {
  start: StringIndex;

  new(start: StringIndex) : start = start, super();

  bounds(endIndex: StringIndex): inline (StringIndex, StringIndex) {
    return (this.start, endIndex);
  }
}

export final class ToStringRange extends StringRange {
  end: StringIndex;

  new(end: StringIndex) : end = end, super();

  bounds(_endIndex: StringIndex): inline (StringIndex, StringIndex) {
    return (0 as StringIndex, this.end);
  }
}

// Host delegate functions for Unicode case mapping
@external("zena:host:string", "toLowerCase")
declare function __js_string_to_lower(s: externref): externref;

@external("zena:host:string", "toUpperCase")
declare function __js_string_to_upper(s: externref): externref;

// Template string join helpers
export let __concat2 = (a: String, b: String): String => a + b;
export let __concat3 = (a: String, b: String, c: String): String => a + b + c;
export let __concat4 = (a: String, b: String, c: String, d: String): String => a + b + c + d;
export let __concat5 = (a: String, b: String, c: String, d: String, e: String): String => a + b + c + d + e;

export final class String implements Hashable, Stringable, Iterable<String> {
  #handle: externref;

  new #fromHandle(handle: externref)
    : #handle = handle;

  handle: externref {
    get {
      return this.#handle;
    }
  }

  static fromHandle(handle: externref): String {
    return new String.#fromHandle(handle);
  }

  encoding: Encoding {
    get {
      return Encoding.WTF16;
    }
  }

  isEmpty: boolean {
    get {
      return __js_string_length(this.#handle) == 0;
    }
  }

  byteLength: i32 {
    get {
      return __js_string_length(this.#handle);
    }
  }

  /**
   * @deprecated Use `byteLength`, `isEmpty`, or `graphemes.count()` instead.
   */
  length: i32 {
    get {
      return __js_string_length(this.#handle);
    }
  }

  startIndex: StringIndex {
    get {
      return 0 as StringIndex;
    }
  }

  endIndex: StringIndex {
    get {
      return __js_string_length(this.#handle) as StringIndex;
    }
  }

  graphemes: StringGraphemes {
    get {
      return this as StringGraphemes;
    }
  }

  codePoints: StringCodePoints {
    get {
      return this as StringCodePoints;
    }
  }

  utf8: StringUtf8View {
    get {
      let len = __js_string_length(this.#handle);
      var utf8Len = 0;
      var pos = 0;
      while (pos < len) {
        let (cp, next) = this.#decodeScalarAt(pos);
        utf8Len += if (cp < 0x80) 1 else if (cp < 0x800) 2 else if (cp < 0x10000) 3 else 4;
        pos = next;
      }
      let out = __byte_array_new(utf8Len);
      var outPos = 0;
      pos = 0;
      while (pos < len) {
        let (cp, next) = this.#decodeScalarAt(pos);
        if (cp < 0x80) {
          __byte_array_set(out, outPos, cp);
          outPos += 1;
        } else if (cp < 0x800) {
          __byte_array_set(out, outPos, 0xC0 | (cp >> 6));
          __byte_array_set(out, outPos + 1, 0x80 | (cp & 0x3F));
          outPos += 2;
        } else if (cp < 0x10000) {
          __byte_array_set(out, outPos, 0xE0 | (cp >> 12));
          __byte_array_set(out, outPos + 1, 0x80 | ((cp >> 6) & 0x3F));
          __byte_array_set(out, outPos + 2, 0x80 | (cp & 0x3F));
          outPos += 3;
        } else {
          __byte_array_set(out, outPos, 0xF0 | (cp >> 18));
          __byte_array_set(out, outPos + 1, 0x80 | ((cp >> 12) & 0x3F));
          __byte_array_set(out, outPos + 2, 0x80 | ((cp >> 6) & 0x3F));
          __byte_array_set(out, outPos + 3, 0x80 | (cp & 0x3F));
          outPos += 4;
        }
        pos = next;
      }
      return new StringUtf8View(out, 0, utf8Len);
    }
  }

  utf16: StringUtf16View {
    get {
      return new StringUtf16View(this.#handle);
    }
  }

  [Iterable.iterator](): Iterator<String> {
    return new StringGraphemeIterator(this);
  }

  #isScalarBoundary(offset: i32): boolean {
    let len = __js_string_length(this.#handle);
    if (offset < 0 || offset > len) {
      return false;
    }
    if (offset == 0 || offset == len) {
      return true;
    }
    let prev = __js_string_char_code_at(this.#handle, offset - 1);
    let curr = __js_string_char_code_at(this.#handle, offset);
    if (prev >= 0xD800 && prev <= 0xDBFF && curr >= 0xDC00 && curr <= 0xDFFF) {
      return false;
    }
    return true;
  }

  #checkBoundary(offset: i32): void {
    if (!this.#isScalarBoundary(offset)) {
      throw new IndexOutOfBoundsError(offset, __js_string_length(this.#handle));
    }
  }

  #checkInBoundsBoundary(offset: i32): void {
    let len = __js_string_length(this.#handle);
    if (offset < 0 || offset >= len || !this.#isScalarBoundary(offset)) {
      throw new IndexOutOfBoundsError(offset, len);
    }
  }

  #decodeScalarAt(offset: i32): inline (i32, i32) {
    let len = __js_string_length(this.#handle);
    let c0 = __js_string_char_code_at(this.#handle, offset);
    if (c0 >= 0xD800 && c0 <= 0xDBFF && offset + 1 < len) {
      let c1 = __js_string_char_code_at(this.#handle, offset + 1);
      if (c1 >= 0xDC00 && c1 <= 0xDFFF) {
        let cp = 0x10000 + ((c0 - 0xD800) << 10) + (c1 - 0xDC00);
        return (cp, offset + 2);
      }
    }
    return (c0, offset + 1);
  }

  #decodeScalarBefore(offset: i32): inline (i32, i32) {
    let cLast = __js_string_char_code_at(this.#handle, offset - 1);
    if (cLast >= 0xDC00 && cLast <= 0xDFFF && offset >= 2) {
      let cPrev = __js_string_char_code_at(this.#handle, offset - 2);
      if (cPrev >= 0xD800 && cPrev <= 0xDBFF) {
        let cp = 0x10000 + ((cPrev - 0xD800) << 10) + (cLast - 0xDC00);
        return (cp, offset - 2);
      }
    }
    return (cLast, offset - 1);
  }

  #shouldBreakBetween(prevCp: i32, nextCp: i32, prevStart: i32): boolean {
    if (prevCp == 0x0D && nextCp == 0x0A) {
      return false;
    }
    if (isGraphemeControl(prevCp) || isGraphemeControl(nextCp)) {
      return true;
    }
    let hPrev = hangulSyllableType(prevCp);
    let hNext = hangulSyllableType(nextCp);
    if (hPrev != 0 && hNext != 0) {
      if (hPrev == 1 && (hNext == 1 || hNext == 2 || hNext == 4 || hNext == 5)) {
        return false;
      }
      if ((hPrev == 4 || hPrev == 2) && (hNext == 2 || hNext == 3)) {
        return false;
      }
      if ((hPrev == 5 || hPrev == 3) && hNext == 3) {
        return false;
      }
    }
    if (isGraphemeExtend(nextCp)) {
      return false;
    }
    if (prevCp == 0x200D) {
      return false;
    }
    if (isRegionalIndicator(prevCp) && isRegionalIndicator(nextCp)) {
      var riCount = 1;
      var scan = prevStart;
      while (scan > 0) {
        let (scanCp, scanPrev) = this.#decodeScalarBefore(scan);
        if (!isRegionalIndicator(scanCp)) {
          break;
        }
        riCount += 1;
        scan = scanPrev;
      }
      return (riCount & 1) == 0;
    }
    return true;
  }

  indexAfter(i: StringIndex): StringIndex {
    let offset = i as i32;
    this.#checkInBoundsBoundary(offset);
    let len = __js_string_length(this.#handle);
    var prevStart = offset;
    let (firstCp, firstNext) = this.#decodeScalarAt(offset);
    var prevCp = firstCp;
    var pos = firstNext;
    while (pos < len) {
      let (nextCp, nextEnd) = this.#decodeScalarAt(pos);
      if (this.#shouldBreakBetween(prevCp, nextCp, prevStart)) {
        break;
      }
      prevStart = pos;
      prevCp = nextCp;
      pos = nextEnd;
    }
    return pos as StringIndex;
  }

  indexBefore(i: StringIndex): StringIndex {
    let offset = i as i32;
    let len = __js_string_length(this.#handle);
    if (offset <= 0 || offset > len || !this.#isScalarBoundary(offset)) {
      throw new IndexOutOfBoundsError(offset, len);
    }
    let (lastCp, lastStart) = this.#decodeScalarBefore(offset);
    var nextCp = lastCp;
    var pos = lastStart;
    while (pos > 0) {
      let (prevCp, prevStart) = this.#decodeScalarBefore(pos);
      if (this.#shouldBreakBetween(prevCp, nextCp, prevStart)) {
        break;
      }
      nextCp = prevCp;
      pos = prevStart;
    }
    return pos as StringIndex;
  }

  scalarIndexAfter(i: StringIndex): StringIndex {
    let offset = i as i32;
    this.#checkInBoundsBoundary(offset);
    let (_, nextOffset) = this.#decodeScalarAt(offset);
    return nextOffset as StringIndex;
  }

  scalarIndexBefore(i: StringIndex): StringIndex {
    let offset = i as i32;
    let len = __js_string_length(this.#handle);
    if (offset <= 0 || offset > len || !this.#isScalarBoundary(offset)) {
      throw new IndexOutOfBoundsError(offset, len);
    }
    let (_, prevOffset) = this.#decodeScalarBefore(offset);
    return prevOffset as StringIndex;
  }

  indexOffsetBy(from: StringIndex, count: i32): inline (true, StringIndex) | inline (false, _) {
    let startOffset = from as i32;
    if (!this.#isScalarBoundary(startOffset)) {
      return (false, _);
    }
    let len = __js_string_length(this.#handle);
    var cur = from;
    if (count >= 0) {
      var rem = count;
      while (rem > 0) {
        if ((cur as i32) >= len) {
          return (false, _);
        }
        cur = this.indexAfter(cur);
        rem -= 1;
      }
      return (true, cur);
    } else {
      var rem = 0 - count;
      while (rem > 0) {
        if ((cur as i32) <= 0) {
          return (false, _);
        }
        cur = this.indexBefore(cur);
        rem -= 1;
      }
      return (true, cur);
    }
  }

  validateByteIndex(byteOffset: i32): inline (true, StringIndex) | inline (false, _) {
    if (this.#isScalarBoundary(byteOffset)) {
      return (true, byteOffset as StringIndex);
    }
    return (false, _);
  }

  operator [](index: StringIndex): String {
    let next = this.indexAfter(index);
    return new String.#fromHandle(__js_string_substring(this.#handle, index as i32, next as i32));
  }

  operator [](r: StringRange): String {
    let (start, end) = r.bounds(this.endIndex);
    return this.slice(start, end);
  }

  operator [](_r: FullRange): String {
    return this;
  }

  slice(start: StringIndex, end: StringIndex): String {
    let s = start as i32;
    let e = end as i32;
    this.#checkBoundary(s);
    this.#checkBoundary(e);
    if (s > e) {
      throw new IndexOutOfBoundsError(s, e);
    }
    return new String.#fromHandle(__js_string_substring(this.#handle, s, e));
  }

  slice(start: StringIndex): String {
    return this.slice(start, this.endIndex);
  }

  reverse(): String {
    let len = __js_string_length(this.#handle);
    if (len <= 1) {
      return this;
    }
    var res = __js_string_substring(this.#handle, 0, 0);
    var cur = this.endIndex;
    while ((cur as i32) > 0) {
      let prev = this.indexBefore(cur);
      let part = __js_string_substring(this.#handle, prev as i32, cur as i32);
      res = __js_string_concat(res, part);
      cur = prev;
    }
    return new String.#fromHandle(res);
  }

  charCodeAt(index: i32): i32 {
    return __js_string_char_code_at(this.#handle, index);
  }

  codePointAt(index: StringIndex): i32 {
    let offset = index as i32;
    this.#checkInBoundsBoundary(offset);
    return __js_string_code_point_at(this.#handle, offset);
  }

  /**
   * @deprecated Use `codePointAt(StringIndex)` or `codePoints` instead.
   */
  codePointAt(index: i32): i32 {
    return __js_string_code_point_at(this.#handle, index);
  }

  unsafeByteAt(index: i32): i32 {
    return __js_string_char_code_at(this.#handle, index) & 0xFF;
  }

  /**
   * @deprecated Use `str.utf8[index]` or `unsafeByteAt(index)` instead.
   */
  getByteAt(index: i32): i32 {
    return __js_string_char_code_at(this.#handle, index) & 0xFF;
  }

  substring(start: i32, end: i32): String {
    let len = __js_string_length(this.#handle);
    var s = start;
    var e = end;
    // Match Zena String (core/string.zena) clamping behavior:
    // 1. wasm:js-string treats i32 as unsigned (s >>> 0), so negative start
    //    would become > len rather than 0 without this check.
    // 2. JS String.prototype.substring swaps start and end if start > end;
    //    Zena strings do not swap, clamping start to end to return "".
    if (s < 0) { s = 0; }
    if (e > len) { e = len; }
    if (s > e) { s = e; }
    return new String.#fromHandle(__js_string_substring(this.#handle, s, e));
  }

  unsafeSliceBytes(start: i32, end: i32): String {
    return this.substring(start, end);
  }

  /**
   * @deprecated Use `str[start..end]`, `slice(start, end)`, or `unsafeSliceBytes(start, end)` instead.
   */
  sliceBytes(start: i32, end: i32): String {
    return this.substring(start, end);
  }

  toBytes(): FixedArray<u8> {
    return this.utf8.toArray();
  }

  copy(): String {
    return this;
  }

  regionEqualsBytes(other: String, start: i32, end: i32): boolean {
    let length = __js_string_length(this.#handle);
    if (end - start != length) {
      return false;
    }
    let otherLen = __js_string_length(other.#handle);
    if (start < 0 || end > otherLen) {
      return false;
    }
    let sub = __js_string_substring(other.#handle, start, end);
    return __js_string_equals(this.#handle, sub);
  }

  startsWith(prefix: String): boolean {
    let pLen = __js_string_length(prefix.#handle);
    let thisLen = __js_string_length(this.#handle);
    if (pLen > thisLen) {
      return false;
    }
    return __js_string_equals(__js_string_substring(this.#handle, 0, pLen), prefix.#handle);
  }

  endsWith(suffix: String): boolean {
    let sLen = __js_string_length(suffix.#handle);
    let thisLen = __js_string_length(this.#handle);
    if (sLen > thisLen) {
      return false;
    }
    return __js_string_equals(__js_string_substring(this.#handle, thisLen - sLen, thisLen), suffix.#handle);
  }

  #indexOfFrom(needle: String, fromIndex: i32): i32 {
    let nLen = __js_string_length(needle.#handle);
    let thisLen = __js_string_length(this.#handle);
    if (nLen == 0) {
      return if (fromIndex > thisLen) thisLen else if (fromIndex < 0) 0 else fromIndex;
    }
    if (fromIndex >= thisLen || nLen > thisLen) {
      return -1;
    }
    let start = if (fromIndex < 0) 0 else fromIndex;
    let first = __js_string_char_code_at(needle.#handle, 0);
    let limit = thisLen - nLen;
    var i = start;
    while (i <= limit) {
      if (__js_string_char_code_at(this.#handle, i) == first) {
        if (nLen == 1 || __js_string_equals(__js_string_substring(this.#handle, i, i + nLen), needle.#handle)) {
          return i;
        }
      }
      i += 1;
    }
    return -1;
  }

  indexOf(needle: String): inline (true, StringIndex) | inline (false, _) {
    let pos = this.#indexOfFrom(needle, 0);
    if (pos < 0) {
      return (false, _);
    }
    return (true, pos as StringIndex);
  }

  indexOf(needle: String, from: StringIndex): inline (true, StringIndex) | inline (false, _) {
    let fromOffset = from as i32;
    this.#checkBoundary(fromOffset);
    let pos = this.#indexOfFrom(needle, fromOffset);
    if (pos < 0) {
      return (false, _);
    }
    return (true, pos as StringIndex);
  }

  contains(needle: String): boolean {
    return this.#indexOfFrom(needle, 0) >= 0;
  }

  split(separator: String): FixedArray<String> {
    let sepLen = __js_string_length(separator.#handle);
    let thisLen = __js_string_length(this.#handle);
    if (sepLen == 0) {
      let res = new FixedArray<String>(thisLen, String.empty());
      var k = 0;
      while (k < thisLen) {
        res[k] = new String.#fromHandle(__js_string_substring(this.#handle, k, k + 1));
        k += 1;
      }
      return res;
    }
    if (sepLen > thisLen) {
      let res = new FixedArray<String>(1, this);
      return res;
    }
    // Pass 1: count parts
    var count = 1;
    var pos = 0;
    while (pos <= thisLen - sepLen) {
      let nextIdx = this.#indexOfFrom(separator, pos);
      if (nextIdx < 0) {
        break;
      }
      count += 1;
      pos = nextIdx + sepLen;
    }
    // Pass 2: fill parts
    let result = new FixedArray<String>(count, String.empty());
    var partIdx = 0;
    var lastStart = 0;
    pos = 0;
    while (pos <= thisLen - sepLen) {
      let nextIdx = this.#indexOfFrom(separator, pos);
      if (nextIdx < 0) {
        break;
      }
      result[partIdx] = new String.#fromHandle(__js_string_substring(this.#handle, lastStart, nextIdx));
      partIdx += 1;
      lastStart = nextIdx + sepLen;
      pos = lastStart;
    }
    result[partIdx] = new String.#fromHandle(__js_string_substring(this.#handle, lastStart, thisLen));
    return result;
  }

  replace(needle: String, replacement: String): String {
    let idx = this.#indexOfFrom(needle, 0);
    if (idx < 0) {
      return this;
    }
    let nLen = __js_string_length(needle.#handle);
    let before = __js_string_substring(this.#handle, 0, idx);
    let after = __js_string_substring(this.#handle, idx + nLen, __js_string_length(this.#handle));
    return new String.#fromHandle(__js_string_concat(__js_string_concat(before, replacement.#handle), after));
  }

  replaceAll(needle: String, replacement: String): String {
    let idx = this.#indexOfFrom(needle, 0);
    if (idx < 0) {
      return this;
    }
    let parts = this.split(needle);
    var res = parts[0];
    var i = 1;
    while (i < parts.length) {
      res = new String.#fromHandle(__js_string_concat(__js_string_concat(res.#handle, replacement.#handle), parts[i].#handle));
      i += 1;
    }
    return res;
  }

  trim(): String {
    let len = __js_string_length(this.#handle);
    var start = 0;
    while (start < len && __js_string_char_code_at(this.#handle, start) <= 32) {
      start += 1;
    }
    var end = len;
    while (end > start && __js_string_char_code_at(this.#handle, end - 1) <= 32) {
      end -= 1;
    }
    if (start == 0 && end == len) {
