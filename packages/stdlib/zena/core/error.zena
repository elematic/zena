// Target-conditional: the `env` host hooks where the host has them, null
// where it does not. `Error` is in the prelude, so this is the one import
// a program cannot drop by writing less code — and the hooks trade in
// `anyref`/`externref`, which a component cannot declare. See
// docs/design/component-emission.md, Part 2.
import { StackRef, captureStackTrace, formatStackTrace } from 'zena:error-stack';

export class Error {
  message: String;
  #stackTrace: StackRef | null;

  new(message: String) : message = message, #stackTrace = captureStackTrace() {}

  getStackTrace(): String | null {
    if (this.#stackTrace == null) {
      return null;
    }
    return formatStackTrace(this.#stackTrace);
  }
}

/** Base class for errors when a lookup operation fails. */
export class LookupError extends Error {
  new(message: String) : super(message);
}

/** Thrown when an array/sequence index is out of bounds. */
export class IndexOutOfBoundsError extends LookupError {
  index: i32;
  length: i32;

  new(index: i32, length: i32) : index = index, length = length, super("Index out of bounds");
}

/** Thrown when a key is not found in a map or similar collection. */
export class KeyNotFoundError extends LookupError {
  new() : super("Key not found");
}

/**
 * Thrown by `requireSync`/`requireSyncIterator` (zena:async) when the
 * asynchronous iterator they wrap reports a Pending step — a value that
 * is not available synchronously. Consume such an iterator with
 * `for await` instead (docs/design/async-iteration.md).
 */
export class AsyncInSyncIteration extends Error {
  new() : super("Asynchronous value encountered in a synchronous iteration; use `for await`");
}

/**
 * Thrown when a contract clause does not hold: a `requires` or `ensures`
 * clause of a function, or an `invariant` clause of a loop. The message
 * is the clause as it was written.
 */
export class ContractError extends Error {
  new(message: String) : super(message);
}

/**
 * What compiled code calls when a contract clause does not hold. The
 * compiler emits the call, with a message naming the clause, so what a
 * violated contract does is decided here.
 */
export function $contractFailed(message: String): never {
  throw new ContractError(message);
}

@intrinsic("unreachable")
export declare function unreachable(): never;
