/**
 * Protocol symbols for untagged node-literal construction (`Type(args) { ... }`).
 *
 * A class opts into untagged node-literal syntax by declaring a
 * `new [Builder.construct]` constructor accepting any leading positional
 * arguments followed by a descriptor record with any subset of the named
 * slots `{ props?, entries?, children?, spreads? }`.
 *
 * A class that accepts heterogeneous `key => value` entries (such as typed
 * custom style properties `PropertyKey<T>`) may also declare a generic
 * `static [Builder.entry]<T>(key, value)` method; otherwise `key => value`
 * entries lower as a `HashMap` literal.
 */
export interface Builder {
  static symbol construct;
  static symbol entry;
}
