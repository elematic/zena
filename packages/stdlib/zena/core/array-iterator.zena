import { Step } from 'zena:async';

/**
 * Iterator over a FixedArray<T>.
 * Holds a reference to the array and tracks position.
 */
export final class ArrayIterator<T> implements Iterator<T> {
  #array: array<var T>;
  var #index: i32;

  new(arr: array<var T>) : #array = arr, #index = 0;

  next(): Step<T> {
    if (this.#index < __array_len(this.#array)) {
      let value = __array_get(this.#array, this.#index);
      this.#index += 1;
      return (1, value, _);
    }
    return (0, _, _);
  }
}
