import { IterableUtils } from './iterable-utils.zena';
import { ArrayIterator } from './array-iterator.zena';

export final extension class FixedArray<T> on array<var T> with IterableUtils<T> implements MutableArray<T>, Iterable<T> {
  @intrinsic('array.len')
  declare length: i32;

  new(length: i32, value: T) : super(__array_new(length, value));

  @intrinsic('array.get')
  declare operator [](index: i32): T;

  @intrinsic('array.set')
  declare operator []=(index: i32, value: T): void;

  /**
   * A copy of the elements whose indices are in the range: `a..b`, `a..`,
   * `..b` or `..`. Bounds outside the array are clamped to it.
   */
  operator [](r: Range): FixedArray<T> {
    let (start, end) = r.bounds(this.length);
    return this.slice(start, end);
  }

  static from<A>(seq: Array<A>): FixedArray<A> {
    let len = seq.length;
    let result = __array_new_empty<A>(len) as FixedArray<A>;
    for (var i = 0; i < len; i += 1) {
      result[i] = seq[i];
    }
    return result;
  }

  map<U>(f: (item: T, index: i32, seq: FixedArray<T>) => U): FixedArray<U> {
    let len = this.length;
    let result = __array_new_empty<U>(len) as FixedArray<U>;
    for (var i = 0; i < len; i += 1) {
      result[i] = f(this[i], i, this as FixedArray<T>);
    }
    return result;
  }

  fold<R>(initial: R, combine: (acc: R, item: T) => R): R {
    var acc = initial;    
    for (let item in this) {
      acc = combine(acc, item);
    }
    return acc;
  }

  reverse(): FixedArray<T> {
    let len = this.length;
    let result = __array_new_empty<T>(len) as FixedArray<T>;
    for (var i = 0; i < len; i += 1) {
      result[i] = this[len - 1 - i];
    }
    return result;
  }

  /**
   * Returns a shallow copy of a portion of the array.
   * The start index is inclusive, the end index is exclusive.
   * Negative indices are not supported.
   */
  slice(start: i32, end: i32): FixedArray<T> {
    // Clamp indices to valid range
    let len = this.length;
    var s = start;
    var e = end;
    if (s < 0) { s = 0; }
    if (e > len) { e = len; }
    if (s >= e) {
      return __array_new_empty<T>(0) as FixedArray<T>;
    }

    let resultLen = e - s;
    let result = __array_new_empty<T>(resultLen) as FixedArray<T>;
    for (var i = 0; i < resultLen; i += 1) {
      result[i] = this[s + i];
    }
    return result;
  }

  /**
   * Returns an iterator over the elements of this array.
   */
  [Iterable.iterator](): Iterator<T> {
    return new ArrayIterator<T>(this);
  }
}

/**
 * Its argument, unchanged: `fixed([1, 2, 3])`.
 *
 * The parameter supplies the mutable context, so a literal argument
 * builds directly as a FixedArray — a mutable literal in expression
 * position, where no annotation can say so. The identity body inlines
 * away, leaving the bare allocation.
 */
export function fixed<T>(items: FixedArray<T>): FixedArray<T> {
  return items;
}
