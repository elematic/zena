/**
 * Result<T, E> — a value that is either an ok payload or an error payload.
 *
 * A value union of two tuples, told apart by the literal in front: `(true,
 * value)` or `(false, error)`. Returned as `inline Result<T, E>`, it is a
 * WebAssembly multi-value return and costs no allocation; stored in a
 * variable, field or collection, it is a boxed tuple. The two forms convert
 * implicitly. See docs/design/result-option.md.
 *
 * ```zena
 * import { Result } from 'zena:core';
 *
 * let checkedSub = (a: i32, b: i32): inline Result<i32, String> => {
 *   if (b > a) {
 *     return (false, "underflow");
 *   }
 *   return (true, a - b);
 * };
 *
 * if (let (true, v) = checkedSub(10, 4)) {
 *   // v is 6
 * }
 * let kept: Array<Result<i32, String>> = [checkedSub(1, 2)];
 * ```
 */
export type Result<T, E> = (true, T) | (false, E);
