/**
 * String-to-float parsing on the JavaScript target (--target js).
 *
 * One call to the `zena:host:number` import `parseF64`, which
 * `@zena-lang/runtime` provides (`numberImports`). It reads the same
 * grammar as the byte targets' `parseF64` in `string-convert.zena` and
 * returns the same float; the byte targets' version is several kilobytes
 * of tables and correctly rounded scaling.
 */

@external("zena:host:number", "parseF64")
declare function __host_parse_f64(s: externref): f64;

/**
 * Parses a decimal (or hexadecimal) number string to the NEAREST f64,
 * correctly rounded.
 */
export let parseF64 = (s: String): f64 => __host_parse_f64(s.handle);
