/**
 * A type that provides a custom string representation for template literals
 * and `toString()`.
 *
 * `Stringable` is not required to pass a value to `toString()` or interpolate
 * it into a template literal — non-`Stringable` classes format as `<ClassName>`,
 * records as `<record>`, and tuples as `<tuple>`. Implementing `Stringable`
 * opts a class into custom formatting via `[Stringable.toString]()`.
 *
 * ```zena
 * class Point implements Stringable {
 *   x: i32;
 *   y: i32;
 *   new(this.x, this.y);
 *   [Stringable.toString](): String {
 *     return `(${this.x}, ${this.y})`;
 *   }
 * }
 * ```
 */
export interface Stringable {
  /** The well-known symbol keying the string conversion method. */
  static symbol toString;

  /** Returns the string representation of this value. */
  [Stringable.toString](): String;
}

/**
 * Converts any value to a `String`, dispatched on its static type: primitives
 * format by value, `null` as `'null'`, `Stringable` types via
 * `[Stringable.toString]()`, and other classes, records, and tuples with a
 * type-tag fallback (`<ClassName>`, `<record>`, `<tuple>`).
 */
@intrinsic('to_string')
export declare function toString<T>(value: T): String;
