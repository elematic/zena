/**
 * File system access over WASI 0.3, for the component target.
 *
 * Provides file reading and writing, directory listing and metadata,
 * relative to the directories the host preopened, over
 * `wasi:filesystem@0.3.0` as the compiler synthesizes it from the
 * vendored WIT.
 *
 * The API is asynchronous, as the 0.3 filesystem is: every descriptor
 * method is an `async func` on the wire, and a file's contents travel
 * as a `stream<u8>`. Each convenience function here (`readFile`,
 * `writeFile`, `listDir`, ...) also has a synchronous twin under a
 * `Sync` suffix, which waits for the same call in `blockOn`. Only a
 * task the host lifted async may wait that way, and the compiler
 * exports `main` async for a program that reaches `blockOn`, so the
 * `Sync` forms work inside `main` and inside test bodies; in a
 * synchronous WIT export, a module initializer or test registration
 * they trap, and the asynchronous forms are the ones to use. See
 * docs/design/async-fs-cli.md.
 *
 * ## Examples
 *
 * ```zena
 * import { readFile, writeFile, listDir, readFileSync } from 'zena:fs';
 *
 * let content = await readFile('config.json');
 * await writeFile('output.txt', 'Hello, World!');
 * for (let entry in await listDir('.')) {
 *   console.log(entry.name);
 * }
 * let synchronous = readFileSync('config.json');
 * ```
 */

import {
  Disposable, Ok, Err, Outcome, Some, Own, Unmanaged, adopt, disown
} from 'zena:core';
import { Stream, readAllBytes, bytesStream, textStream } from 'zena:stream';
import { blockOn } from 'zena:wasi';
import { GlobPattern, hasMagic } from 'zena:glob';
import { getDirectories } from 'wasi:filesystem/preopens';
import {
  Descriptor as WitDescriptor, DescriptorStat, DescriptorType,
  DescriptorTypeBlockDevice, DescriptorTypeCharacterDevice,
  DescriptorTypeDirectory, DescriptorTypeRegularFile,
  DescriptorTypeSocket, DescriptorTypeSymbolicLink, DirectoryEntry,
  ErrorCode, ErrorCodeAccess, ErrorCodeBadDescriptor, ErrorCodeExist,
  ErrorCodeInsufficientSpace, ErrorCodeInvalid, ErrorCodeInvalidSeek,
  ErrorCodeIo, ErrorCodeIsDirectory, ErrorCodeLoop, ErrorCodeNameTooLong,
  ErrorCodeNoEntry, ErrorCodeNotDirectory, ErrorCodeNotEmpty,
  ErrorCodeNotPermitted, ErrorCodeReadOnly, ErrorCodeTooManyLinks,
  PathFlags, pathFlagsSymlinkFollow,
  OpenFlags as WitOpenFlags, openFlagsCreate, openFlagsDirectory,
  openFlagsTruncate,
  DescriptorFlags as WitDescriptorFlags, descriptorFlagsRead,
  descriptorFlagsWrite, descriptorFlagsMutateDirectory,
} from 'wasi:filesystem/types';
import { Instant } from 'wasi:clocks/system-clock';

// ============================================================================
// Error Types
// ============================================================================

/**
 * The failures a file operation reports. The numbers are the WASI
 * preview 1 errno values the codes were first modelled on, kept so
 * `FsError.errno` stays what it was; a 0.3 `error-code` maps onto them.
 */
export enum FsErrorCode {
  Success,          // No error (0)
  Access,           // Permission denied (2)
  BadDescriptor,    // Bad file descriptor (8)
  Exist,            // File exists (20)
  NotFound,         // No such file or directory (44)
  IsDirectory,      // Is a directory (31)
  NotDirectory,     // Not a directory (54)
  NotEmpty,         // Directory not empty (55)
  ReadOnly,         // Read-only file system (69)
  InvalidSeek,      // Invalid seek (70)
  Io,               // I/O error (29)
  InvalidArgument,  // Invalid argument (28)
  TooManyLinks,     // Too many symbolic links (72)
  NameTooLong,      // Filename too long (37)
  NoSpace,          // No space left on device (51)
  NotPermitted,     // Operation not permitted (63)
}

let errnoToCode = (errno: i32): FsErrorCode => {
  return match (errno) {
    case 0: FsErrorCode.Success
    case 2: FsErrorCode.Access
    case 8: FsErrorCode.BadDescriptor
    case 20: FsErrorCode.Exist
    case 44: FsErrorCode.NotFound
    case 31: FsErrorCode.IsDirectory
    case 54: FsErrorCode.NotDirectory
    case 55: FsErrorCode.NotEmpty
    case 69: FsErrorCode.ReadOnly
    case 70: FsErrorCode.InvalidSeek
    case 29: FsErrorCode.Io
    case 28: FsErrorCode.InvalidArgument
    case 72: FsErrorCode.TooManyLinks
    case 37: FsErrorCode.NameTooLong
    case 51: FsErrorCode.NoSpace
    case 63: FsErrorCode.NotPermitted
    case _: FsErrorCode.Io
  };
};

/** The errno a 0.3 `error-code` stands for; anything unlisted is I/O. */
let errnoOf = (code: ErrorCode): i32 => {
  if (code is ErrorCodeAccess) { return 2; }
  if (code is ErrorCodeBadDescriptor) { return 8; }
  if (code is ErrorCodeExist) { return 20; }
  if (code is ErrorCodeNoEntry) { return 44; }
  if (code is ErrorCodeIsDirectory) { return 31; }
  if (code is ErrorCodeNotDirectory) { return 54; }
  if (code is ErrorCodeNotEmpty) { return 55; }
  if (code is ErrorCodeReadOnly) { return 69; }
  if (code is ErrorCodeInvalidSeek) { return 70; }
  if (code is ErrorCodeInvalid) { return 28; }
  if (code is ErrorCodeTooManyLinks || code is ErrorCodeLoop) { return 72; }
  if (code is ErrorCodeNameTooLong) { return 37; }
  if (code is ErrorCodeInsufficientSpace) { return 51; }
  if (code is ErrorCodeNotPermitted) { return 63; }
  return 29;
};

let describe = (code: ErrorCode): String => {
  return match (errnoOf(code)) {
    case 2: 'permission denied'
    case 8: 'bad descriptor'
    case 20: 'already exists'
    case 44: 'no such file or directory'
    case 31: 'is a directory'
    case 54: 'not a directory'
    case 55: 'directory not empty'
    case 69: 'read-only file system'
    case 70: 'invalid seek'
    case 28: 'invalid argument'
    case 72: 'too many links'
    case 37: 'name too long'
    case 51: 'no space left'
    case 63: 'operation not permitted'
    case _: 'I/O error'
  };
};

/** A failed file operation: its code, and what was being done. */
export class FsError extends Error {
  code: FsErrorCode;
  errno: i32;
  new(errno: i32, message: String)
    : errno = errno, code = errnoToCode(errno), super(message);
}

let fail = (code: ErrorCode, what: String): never => {
  throw new FsError(errnoOf(code), `${what}: ${describe(code)}`);
};

/** Throw for a failed `result<_, error-code>`. */
let check = (outcome: Outcome<void, ErrorCode>, what: String): void => {
  if (outcome is Err<void, ErrorCode>) {
    fail((outcome as Err<void, ErrorCode>).error, what);
  }
};

// ============================================================================
// File Types
// ============================================================================

/** The kind of a directory entry or stat'd path. */
export enum FileType {
  Unknown,
  BlockDevice,
  CharacterDevice,
  Directory,
  RegularFile,
  SymbolicLink,
  Socket,
}

let fileTypeOf = (t: DescriptorType): FileType => {
  if (t is DescriptorTypeRegularFile) { return FileType.RegularFile; }
  if (t is DescriptorTypeDirectory) { return FileType.Directory; }
  if (t is DescriptorTypeSymbolicLink) { return FileType.SymbolicLink; }
  if (t is DescriptorTypeBlockDevice) { return FileType.BlockDevice; }
  if (t is DescriptorTypeCharacterDevice) { return FileType.CharacterDevice; }
  if (t is DescriptorTypeSocket) { return FileType.Socket; }
  return FileType.Unknown;
};

/** File metadata. */
export type FileStat = {
  fileType: FileType,
  size: i64,
  /** When the contents last changed, in nanoseconds since the Unix epoch. */
  modified: i64,
};

/** A directory entry. */
export type DirEntry = {
  name: String,
  fileType: FileType,
};

/** How `Descriptor.openAt` opens a path. */
export enum DescriptorFlags {
  Read,
  Write,
  ReadWrite,
  MutateDirectory,
}

let statOf = (s: DescriptorStat): FileStat => {
  var modified = 0 as i64;
  let stamp = s.dataModificationTimestamp;
  if (stamp is Some<Instant>) {
    let at = (stamp as Some<Instant>).value;
    modified = at.seconds * (1000000000 as i64) + (at.nanoseconds as i64);
  }
  return {
    fileType: fileTypeOf(s.type),
    size: s.size as i64,
    modified: modified,
  };
};

// ============================================================================
// Descriptors
// ============================================================================

let noOpenFlags = (0 as u32) as WitOpenFlags;

let witDescriptorFlags = (flags: DescriptorFlags): WitDescriptorFlags => {
  return match (flags) {
    case DescriptorFlags.Read: descriptorFlagsRead
    case DescriptorFlags.Write: descriptorFlagsWrite
    case DescriptorFlags.ReadWrite: {
      ((descriptorFlagsRead as u32) | (descriptorFlagsWrite as u32)) as WitDescriptorFlags
    }
    case DescriptorFlags.MutateDirectory: {
      ((descriptorFlagsRead as u32) | (descriptorFlagsMutateDirectory as u32)) as WitDescriptorFlags
    }
  };
};

/** Every entry of a directory stream. */
async function collectEntries(stream: Stream<DirectoryEntry>): Future<Array<DirEntry>> {
  let out = new Array<DirEntry>();
  while (true) {
    let next = await stream.readOne();
    if (next is Some<DirectoryEntry>) {
      let entry = (next as Some<DirectoryEntry>).value;
      out.push({ name: entry.name, fileType: fileTypeOf(entry.type) });
    } else {
      break;
    }
  }
  return out;
}

/**
 * The descriptor an `open-at` returned, or the failure thrown as an
 * `FsError` naming `what`. A pattern rather than a cast: a cast to a
 * type that names `Own` is rejected outside `zena:ownership`, and the
 * pattern moves the owner out of the `Ok` arm.
 */
let opened = (
  outcome: Outcome<Own<WitDescriptor>, ErrorCode>,
  what: String
): Own<WitDescriptor> => {
  // An `is` test with the type arguments spelled out: a class pattern
  // (`if (let Ok {value} = outcome)`) tests the erased template type and
  // matches nothing (#270), and a cast to a type that names `Own` is
  // refused.
  if (outcome is Ok<Own<WitDescriptor>, ErrorCode>) {
    return outcome.value;
  }
  if (outcome is Err<Own<WitDescriptor>, ErrorCode>) {
    fail(outcome.error, what);
  }
  throw new Error(`${what}: open-at returned neither ok nor err`);
};

/**
 * Release a descriptor once the host has finished reading its contents
 * into a stream handed on elsewhere: the owned parameter is released at
 * this function's exit. A failure there arrives after the stream has
 * started, so there is nothing left to report it to.
 */
async function closeWhenRead(
  file: Own<WitDescriptor>,
  done: Future<Outcome<void, ErrorCode>>
): Future<void> {
  try {
    await done;
  } catch (e) {}
}

/**
 * An open file or directory: a resource over the host's handle, held
 * as `Own<Descriptor>` and released when that owner leaves scope. A
 * use after the release is a compile error.
 * Paths given to the `*At` methods are relative to a directory
 * descriptor. Every operation is asynchronous; a synchronous caller
 * waits with `blockOn`.
 *
 * The preopened directories are `Unmanaged<Descriptor>`: they live as
 * long as the program and are never released, and an unmanaged handle
 * reaches every method here the way an owned one does.
 */
export resource class Descriptor {
  #inner: Own<WitDescriptor>;

  new(inner: Own<WitDescriptor>) : #inner = inner;

  /** The entire contents, as bytes. */
  async readAllBytes(): Future<FixedArray<u8>> {
    let (stream, done) = this.#inner.readViaStream(0 as u64);
    let bytes = await readAllBytes(stream);
    check(await done, 'read');
    return bytes;
  }

  /** The entire contents, as text. */
  async readString(): Future<String> {
    return String.fromBytes(await this.readAllBytes());
  }

  /**
   * The contents, as a stream the host fills: for handing on to
   * another host interface — a response body, say — so that the bytes
   * never pass through the program. Consumes this descriptor: the
   * host's handle goes to a task that releases it once the stream has
   * been read to the end.
   */
  readStream(this: Own<this>): Stream<u8> {
    let (stream, done) = this.#inner.readViaStream(0 as u64);
    closeWhenRead(this.#inner, done);
    return stream;
  }

  /** Write `data` from the start of the file. */
  async writeBytes(data: FixedArray<u8>): Future<void> {
    check(await this.#inner.writeViaStream(bytesStream(data), 0 as u64), 'write');
  }

  /** Write `data` from the start of the file. */
  async writeString(data: String): Future<void> {
    check(await this.#inner.writeViaStream(textStream(data), 0 as u64), 'write');
  }

  /** Open a path under this directory, following symlinks. */
  async openAt(path: String, flags: DescriptorFlags): Future<Own<Descriptor>> {
    let outcome = await this.#inner.openAt(
        pathFlagsSymlinkFollow, path, noOpenFlags, witDescriptorFlags(flags));
    return new Descriptor(opened(outcome, `open '${path}'`));
  }

  /** Create a file under this directory, or truncate the one there,
   * open for writing. */
  async createAt(path: String): Future<Own<Descriptor>> {
    let openFlags =
        ((openFlagsCreate as u32) | (openFlagsTruncate as u32)) as WitOpenFlags;
    let outcome = await this.#inner.openAt(
        pathFlagsSymlinkFollow, path, openFlags, descriptorFlagsWrite);
    return new Descriptor(opened(outcome, `create '${path}'`));
  }

  /** Open a directory under this one. */
  async openDirAt(path: String): Future<Own<Descriptor>> {
    let outcome = await this.#inner.openAt(
        pathFlagsSymlinkFollow, path, openFlagsDirectory,
        witDescriptorFlags(DescriptorFlags.MutateDirectory));
    return new Descriptor(opened(outcome, `opendir '${path}'`));
  }

  /** This descriptor's metadata. */
  async stat(): Future<FileStat> {
    let outcome = await this.#inner.stat();
    if (outcome is Err<DescriptorStat, ErrorCode>) {
      fail((outcome as Err<DescriptorStat, ErrorCode>).error, 'stat');
    }
    return statOf((outcome as Ok<DescriptorStat, ErrorCode>).value);
  }

  /** The metadata of a path under this directory, following symlinks. */
  async statAt(path: String): Future<FileStat> {
    let outcome = await this.#inner.statAt(pathFlagsSymlinkFollow, path);
    if (outcome is Err<DescriptorStat, ErrorCode>) {
      fail((outcome as Err<DescriptorStat, ErrorCode>).error, `stat '${path}'`);
    }
    return statOf((outcome as Ok<DescriptorStat, ErrorCode>).value);
  }

  /** Whether anything is at a path under this directory. */
  async existsAt(path: String): Future<boolean> {
    let outcome = await this.#inner.statAt(pathFlagsSymlinkFollow, path);
    return outcome is Ok<DescriptorStat, ErrorCode>;
  }

  /** The entries of this directory. `.` and `..` are not among them. */
  async readDir(): Future<Array<DirEntry>> {
    let (stream, done) = this.#inner.readDirectory();
    let entries = await collectEntries(stream);
    check(await done, 'readdir');
    return entries;
  }

  /** Create a directory under this one. */
  async mkdirAt(path: String): Future<void> {
    check(await this.#inner.createDirectoryAt(path), `mkdir '${path}'`);
  }

  /** Remove a file under this directory. */
  async unlinkAt(path: String): Future<void> {
    check(await this.#inner.unlinkFileAt(path), `unlink '${path}'`);
  }

  /** Remove an empty directory under this one. */
  async rmdirAt(path: String): Future<void> {
    check(await this.#inner.removeDirectoryAt(path), `rmdir '${path}'`);
  }

  /**
   * Rename a path under this directory to a path under `to`, a
   * directory the program does not own, which is what a preopen is.
   * (An unmanaged handle does not pass where a borrow is expected, so
   * a caller holding an owned target disowns it for the call.)
   */
  async renameAt(from: String, to: Unmanaged<Descriptor>, toPath: String): Future<void> {
    check(await this.#inner.renameAt(from, to.#inner, toPath),
        `rename '${from}' to '${toPath}'`);
  }

  // No written dispose: the release is the field's, and the compiler
  // synthesizes the dispose that drops the host's handle. (A written
  // dispose beside an owned field of a synthesized class does not
  // lower yet, #388, which is why there is no `close`; a descriptor is
  // released when its owner's scope ends.)
}

// ============================================================================
// Preopened Directories
// ============================================================================

var preopensCache: Array<(Unmanaged<Descriptor>, String)> | null = null;

/**
 * The directories the host preopened, each with the path it is known
 * by. Synchronous: `get-directories` is a synchronous WIT function.
 * The descriptors are unmanaged: they are the program's for its whole
 * run, and nothing releases them.
 */
export let getPreopens = (): Array<(Unmanaged<Descriptor>, String)> => {
  let cached = preopensCache;
  if (cached != null) {
    return cached;
  }
  let result = new Array<(Unmanaged<Descriptor>, String)>();
  for (let (descriptor, path) in getDirectories()) {
    // The host's handle arrives unmanaged, since a tuple cannot carry
    // an owner; adopted into the wrapper and disowned again as a whole.
    result.push((disown(new Descriptor(adopt(descriptor))), path));
  }
  preopensCache = result;
  return result;
};

/** The first preopened directory. */
export let getRootDir = (): Unmanaged<Descriptor> => {
  let preopens = getPreopens();
  if (preopens.length == 0) {
    throw new FsError(44, 'No preopened directories available');
  }
  return preopens[0][0];
};

let SLASH = 0x2F;

/**
 * `path` with empty and `.` segments dropped, or `.` when nothing is
 * left: a path operation rejects an empty path, so a path that names a
 * preopen exactly names the preopen's own directory.
 */
let normalizeRelative = (path: String): String => {
  let kept = new GrowableArray<String>(4);
  for (let segment in path.split('/')) {
    if (segment != '' && segment != '.') {
      kept.push(segment);
    }
  }
  if (kept.length == 0) {
    return '.';
  }
  var joined = kept[0];
  for (var i = 1; i < kept.length; i += 1) {
    joined = `${joined}/${kept[i]}`;
  }
  return joined;
};

/**
 * The preopen a path falls under, and the path relative to it. A
 * relative path is under the preopen named `.` (else the first); an
 * absolute path is under the preopen whose name is its longest prefix
 * at a segment boundary, so `/tmpfiles` is not under `/tmp`.
 */
export let resolvePreopen = (path: String): (Unmanaged<Descriptor>, String) => {
  let preopens = getPreopens();
  if (preopens.length == 0) {
    throw new FsError(44, 'No preopened directories available');
  }
  var best = preopens[0][0];
  var bestLength = -1;
  var relative = path;
  let absolute = path.startsWith('/');
  for (let (descriptor, name) in preopens) {
    if (!absolute) {
      if (name == '.' && bestLength < 0) {
        best = descriptor;
        bestLength = 0;
      }
    } else if (name.startsWith('/')) {
      let matches = name == '/' || path == name ||
          (path.startsWith(name) && path.getByteAt(name.length) == SLASH);
      if (matches && name.length > bestLength) {
        best = descriptor;
        bestLength = name.length;
        relative = path.sliceBytes(name.length, path.length);
      }
    }
  }
  if (absolute && bestLength < 0) {
    throw new FsError(44, `no preopened directory holds '${path}'`);
  }
  return (best, normalizeRelative(relative));
};

// ============================================================================
// High-Level Convenience Functions
// ============================================================================

/** The contents of a file, as text. */
export async function readFile(path: String): Future<String> {
  let (dir, rel) = resolvePreopen(path);
  let file = await dir.openAt(rel, DescriptorFlags.Read);
  return await file.readString();
}

/** The contents of a file, as bytes. */
export async function readFileBytes(path: String): Future<FixedArray<u8>> {
  let (dir, rel) = resolvePreopen(path);
  let file = await dir.openAt(rel, DescriptorFlags.Read);
  return await file.readAllBytes();
}

/** Write text to a file, creating or truncating it. */
export async function writeFile(path: String, content: String): Future<void> {
  let (dir, rel) = resolvePreopen(path);
  let file = await dir.createAt(rel);
  await file.writeString(content);
}

/** Write bytes to a file, creating or truncating it. */
export async function writeFileBytes(path: String, content: FixedArray<u8>): Future<void> {
  let (dir, rel) = resolvePreopen(path);
  let file = await dir.createAt(rel);
  await file.writeBytes(content);
}

/** The entries of a directory. */
export async function listDir(path: String): Future<Array<DirEntry>> {
  let (dir, rel) = resolvePreopen(path);
  let opened = await dir.openDirAt(rel);
  return await opened.readDir();
}

/** Whether anything exists at a path. */
export async function exists(path: String): Future<boolean> {
  let (dir, rel) = resolvePreopen(path);
  return await dir.existsAt(rel);
}

/** The metadata of a path, or null when nothing is there. */
async function statOrNull(path: String): Future<FileStat | null> {
  let (dir, rel) = resolvePreopen(path);
  try {
    return await dir.statAt(rel);
  } catch (e) {
    return null;
  }
}

/** Whether a regular file exists at a path. */
export async function isFile(path: String): Future<boolean> {
  let info = await statOrNull(path);
  return info != null && (info as FileStat).fileType == FileType.RegularFile;
}

/** Whether a directory exists at a path. */
export async function isDirectory(path: String): Future<boolean> {
  let info = await statOrNull(path);
  return info != null && (info as FileStat).fileType == FileType.Directory;
}

/** Create a directory. */
export async function mkdir(path: String): Future<void> {
  let (dir, rel) = resolvePreopen(path);
  await dir.mkdirAt(rel);
}

/** Remove a file. */
export async function unlink(path: String): Future<void> {
  let (dir, rel) = resolvePreopen(path);
  await dir.unlinkAt(rel);
}

/** Move a file or directory. */
export async function rename(from: String, to: String): Future<void> {
  let (fromDir, fromRel) = resolvePreopen(from);
  let (toDir, toRel) = resolvePreopen(to);
  await fromDir.renameAt(fromRel, toDir, toRel);
}

/** The metadata of a path. */
export async function stat(path: String): Future<FileStat> {
  let (dir, rel) = resolvePreopen(path);
  return await dir.statAt(rel);
}

/** Remove an empty directory. */
export async function rmdir(path: String): Future<void> {
  let (dir, rel) = resolvePreopen(path);
  await dir.rmdirAt(rel);
}

// ============================================================================
// Glob
// ============================================================================

/** How `glob` searches. */
export class GlobOptions {
  var cwd: String = '.';
  var onlyFiles: boolean = true;
  var exclude = new GrowableArray<String>();
}

/** Insertion sort, in place: directory listings are nearly sorted. */
let sortStrings = (arr: GrowableArray<String>): void => {
  for (var i = 1; i < arr.length; i += 1) {
    let cur = arr[i];
    var j = i - 1;
    for (; j >= 0 && arr[j].compareTo(cur) > 0; j -= 1) {
      arr[j + 1] = arr[j];
    }
    arr[j + 1] = cur;
  }
};

/** The directory prefix of a pattern before its first wildcard. */
let baseDirOf = (pattern: String): String => {
  var lastSlash = 0 - 1;
  for (var i = 0; i < pattern.length; i += 1) {
    let b = pattern.getByteAt(i);
    if (b == 42 || b == 63 || b == 91 || b == 123) { // '*', '?', '[', '{'
      break;
    }
    if (b == 47) { // '/'
      lastSlash = i;
    }
  }
  if (lastSlash < 0) {
    return '.';
  }
  if (lastSlash == 0) {
    return '/';
  }
  return pattern.sliceBytes(0, lastSlash);
};

/** The entries of a directory, or null when it cannot be listed. */
async function entriesOrNull(path: String): Future<Array<DirEntry> | null> {
  try {
    return await listDir(path);
  } catch (e) {
    return null;
  }
}

async function scanDir(
  currentDir: String,
  relPrefix: String,
  globPattern: GlobPattern,
  excludePatterns: GrowableArray<GlobPattern>,
  onlyFiles: boolean,
  results: GrowableArray<String>
): Future<void> {
  let entries = await entriesOrNull(currentDir);
  if (entries == null) {
    return;
  }
  for (let entry in entries as Array<DirEntry>) {
    if (entry.name == '.' || entry.name == '..') {
      continue;
    }
    let relPath = if (relPrefix.length == 0 || relPrefix == '.') {
      entry.name
    } else {
      relPrefix + '/' + entry.name
    };
    let fullPath = if (currentDir == '.') {
      entry.name
    } else {
      currentDir + '/' + entry.name
    };
    var excluded = false;
    for (var ex = 0; ex < excludePatterns.length; ex += 1) {
      if (excludePatterns[ex].matches(relPath) || excludePatterns[ex].matches(fullPath)) {
        excluded = true;
        break;
      }
    }
    if (excluded) {
      continue;
    }
    let isDir = entry.fileType == FileType.Directory;
    if (globPattern.matches(relPath)) {
      if (!onlyFiles || !isDir) {
        results.push(relPath);
      }
    }
    if (isDir) {
      await scanDir(fullPath, relPath, globPattern, excludePatterns, onlyFiles, results);
    }
  }
}

/**
 * The paths under `options.cwd` matching a glob pattern, sorted. A
 * pattern with no wildcard names one path, reported if it exists.
 */
export async function glob(
  pattern: String,
  options: GlobOptions | null = null
): Future<Array<String>> {
  let opts = if (options != null) {
    options as GlobOptions
  } else {
    new GlobOptions()
  };
  let results = new GrowableArray<String>();
  let excludePatterns = new GrowableArray<GlobPattern>();
  for (var ex = 0; ex < opts.exclude.length; ex += 1) {
    excludePatterns.push(new GlobPattern(opts.exclude[ex]));
  }
  if (!hasMagic(pattern)) {
    let target = if (opts.cwd == '.') {
      pattern
    } else {
      opts.cwd + '/' + pattern
    };
    if (await exists(target)) {
      var excluded = false;
      for (var ex = 0; ex < excludePatterns.length; ex += 1) {
        if (excludePatterns[ex].matches(pattern)) {
          excluded = true;
          break;
        }
      }
      if (!excluded) {
        results.push(pattern);
      }
    }
    return results;
  }
  let baseDir = baseDirOf(pattern);
  let scanRoot = if (opts.cwd == '.') {
    baseDir
  } else if (baseDir == '.') {
    opts.cwd
  } else {
    opts.cwd + '/' + baseDir
  };
  let relPrefix = if (baseDir == '.') '' else baseDir;
  let globPattern = new GlobPattern(pattern);
  await scanDir(scanRoot, relPrefix, globPattern, excludePatterns, opts.onlyFiles, results);
  sortStrings(results);
  return results;
}

// ============================================================================
// Synchronous forms
// ============================================================================
//
// Each waits for the asynchronous function above it in `blockOn`. See
// the library header for where that is allowed.

export let readFileSync = (path: String): String => blockOn(readFile(path));
export let readFileBytesSync = (path: String): FixedArray<u8> => blockOn(readFileBytes(path));
export let writeFileSync = (path: String, content: String): void => {
  blockOn(writeFile(path, content));
};
export let writeFileBytesSync = (path: String, content: FixedArray<u8>): void => {
  blockOn(writeFileBytes(path, content));
};
export let listDirSync = (path: String): Array<DirEntry> => blockOn(listDir(path));
export let existsSync = (path: String): boolean => blockOn(exists(path));
export let isFileSync = (path: String): boolean => blockOn(isFile(path));
export let isDirectorySync = (path: String): boolean => blockOn(isDirectory(path));
export let mkdirSync = (path: String): void => {
  blockOn(mkdir(path));
};
export let unlinkSync = (path: String): void => {
  blockOn(unlink(path));
};
export let renameSync = (from: String, to: String): void => {
  blockOn(rename(from, to));
};
export let statSync = (path: String): FileStat => blockOn(stat(path));
export let rmdirSync = (path: String): void => {
  blockOn(rmdir(path));
};
export let globSync = (pattern: String, options: GlobOptions | null = null): Array<String> =>
    blockOn(glob(pattern, options));
