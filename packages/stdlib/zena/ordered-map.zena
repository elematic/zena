// TRANSITIONAL. OrderedMap's home is 'zena:collections'; this module exists
// only so that the compiler's own sources can keep importing it.
//
// The checked-in bootstrap resolves stdlib module names from the list baked
// into the compiler it was built from, and that list has no 'collections'
// entry yet. So compiler sources cannot import 'zena:collections' until after
// the next reseed — see "The Bootstrap" in AGENTS.md. Once that lands, point
// packages/zena-compiler/zena/lib/{types,codegen/type-mapping}.zena at
// 'zena:collections', delete this file, and drop "ordered-map" from both
// module manifests.
//
// Nothing else should import this. Stdlib files can reach the implementation
// relatively (see json.zena); everything else uses 'zena:collections'.

export { OrderedMap } from './collections/hash-map.zena';
