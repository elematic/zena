/**
 * Mathematical operations, numeric limits, bit manipulation intrinsics, and
 * wide arithmetic.
 *
 * Provides constants for integer bounds (`I32_MIN`, `I32_MAX`, etc.) and
 * for `PI`, `E`, `TAU`, `LN2`, `LN10` and `SQRT2`; bitwise operations
 * (`clz`, `ctz`, `popcnt`); the floating-point operations Wasm has
 * instructions for (`abs`, `floor`, `ceil`, `sqrt`, `min`, `max`); the
 * exponential, logarithmic, trigonometric and hyperbolic functions,
 * `pow`, `cbrt`, `hypot` and `fma`, each over `f64` and `f32`; and
 * 128-bit arithmetic (`mulWide`, `add128`).
 *
 * The transcendental functions are a port of musl's libm, which is
 * FreeBSD's and before that Sun's fdlibm (the `math/` directory). Each
 * is accurate to under 1 ulp unless its documentation says otherwise,
 * and `fma` is exact.
 *
 * ## Examples
 *
 * ```zena
 * import { min, max, sqrt, clz, popcnt, sin, pow, PI } from 'zena:math';
 *
 * let smallest = min(3.0, 7.5);
 * let root = sqrt(16.0);
 * let leadingZeros = clz(16);
 * let bits = popcnt(7);
 * let height = sin(PI / 6.0);
 * let cube = pow(3.0, 3.0);
 * ```
 */

export * from './math/intrinsics.zena';
export { exp, expm1 } from './math/exp.zena';
export { exp2, pow } from './math/pow.zena';
export { log, log2, log10, log1p } from './math/log.zena';
export { sin, cos, tan } from './math/trig.zena';
export { asin, acos, atan, atan2 } from './math/inverse-trig.zena';
export {
  sinh, cosh, tanh, asinh, acosh, atanh,
} from './math/hyperbolic.zena';
export { cbrt, hypot } from './math/roots.zena';
export { fma } from './math/fma.zena';

/** The ratio of a circle's circumference to its diameter. */
export let PI = 3.141592653589793;
/** The base of the natural logarithm. */
export let E = 2.718281828459045;
/** `2 * PI`: the circumference of the unit circle. */
export let TAU = 6.283185307179586;
/** The natural logarithm of 2. */
export let LN2 = 0.6931471805599453;
/** The natural logarithm of 10. */
export let LN10 = 2.302585092994046;
/** The square root of 2. */
export let SQRT2 = 1.4142135623730951;

/** Whether `x` is NaN, which `x == x` cannot tell: NaN is unequal to itself. */
export function isNaN(x: f64): boolean {
  return x != x;
}

export function isNaN(x: f32): boolean {
  return x != x;
}
