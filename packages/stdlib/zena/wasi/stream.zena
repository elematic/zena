/**
 * @file
 *
 * The component target's guest side of `stream<u8>`: create the pair,
 * move bytes through the canonical `stream.write`, and — for callers
 * with no event loop — wait for a blocked write in place.
 *
 * Two kinds of consumer meet the canonical stream protocol, and they
 * wait differently. Async code joins its ends to
 * `zena:wasi`'s waitable set and is resumed through the
 * callback: `lowerByteStream` and `liftByteStream` connect a
 * `zena:stream` `Stream<u8>` to a canonical end through a background
 * pump riding that set. Synchronous code cannot
 * be resumed, so it *blocks*, on this module's own waitable set via
 * the blocking `waitable-set.wait` builtin — a separate set, so a
 * blocking wait here can never swallow an event the program's event
 * loop is owed. `zena:console` is the blocking consumer: a print from
 * a sync `main` must complete before the next statement, event loop or
 * none.
 *
 * The write is lowered with the `async` canonical option even on the
 * blocking path, because the synchronous form of the builtin is the
 * extension (wasmtime gates it as 🚝): a BLOCKED result parks on the
 * set, everything else returns packed progress directly.
 */

import { Waiter, scheduleTask } from 'zena:async';
import { Option } from 'zena:core';
import { Memory, defaultAllocator } from 'zena:memory';
import { Stream, StreamWriter, TextStream } from 'zena:stream';
// A core module may not import one canonical builtin under the same
// name twice, so the waitable builtins have exactly one declaring
// module — the driver — and everyone else imports the declarations.
import {
  waitableSetNew, waitableJoin, waitableSetWait, awaitWaitable, Waitable,
  WaitableSet
} from './async.zena';

/**
 * The two ends of a `stream<u8>`, as unforgeable handle types: a
 * readable end is what a WIT import like `write-via-stream` is handed,
 * a writable end is what the guest keeps and writes, and nothing but
 * `newByteStreamPair` can produce either. On the wire each is a
 * component-model handle index (a core `i32`).
 */
export opaque type ReadableByteStream = i32;
export opaque type WritableByteStream = i32;

/** A fresh stream's two ends. */
export final class ByteStreamPair {
  readable: ReadableByteStream;
  writable: WritableByteStream;
  new(this.readable, this.writable);
}

/** The raw builtin packs both end indices into one integer: the
 * readable end in the low 32 bits, the writable end in the high 32. */
@external("canon", "stream.new", "stream<u8>")
declare function streamNew(): u64;

export function newByteStreamPair(): ByteStreamPair {
  let pair = streamNew();
  let readable = (pair as i32) as ReadableByteStream;
  let writable = ((pair >> 32) as i32) as WritableByteStream;
  return new ByteStreamPair(readable, writable);
}

/**
 * The copy: up to `len` bytes at `ptr` into the stream, returning
 * `(progress << 4) | result` — COMPLETED with how many bytes the host
 * consumed, DROPPED when the readable end is gone — or BLOCKED when
 * nothing could move yet, in which case the copy is in flight and its
 * completion arrives as a STREAM_WRITE event.
 */
@external("canon", "stream.write", "stream<u8>,async")
declare function streamWrite(
  end: WritableByteStream,
  ptr: i32,
  len: i32
): i32;

/**
 * The copy out: up to `len` stream bytes into memory at `ptr`,
 * returning `(progress << 4) | result` — COMPLETED with how many
 * bytes arrived, DROPPED when the writable end is gone — or BLOCKED
 * when none exist yet, in which case the copy is in flight and its
 * completion arrives as a STREAM_READ event.
 */
@external("canon", "stream.read", "stream<u8>,async")
declare function streamRead(
  end: ReadableByteStream,
  ptr: i32,
  len: i32
): i32;

@external("canon", "stream.drop-readable", "stream<u8>")
declare function streamDropReadable(end: ReadableByteStream): void;

@external("canon", "stream.drop-writable", "stream<u8>")
declare function streamDropWritable(end: WritableByteStream): void;

// From the Component Model's canonical ABI (design/mvp/CanonicalABI.md).
// A copy's packed result is `(progress << 4) | CopyResult`, where
// CopyResult is COMPLETED = 0, DROPPED = 1, CANCELLED = 2; BLOCKED is
// the all-ones sentinel an async-lowered copy returns instead when
// nothing has moved yet. An event is `(EventCode, waitable, payload)`,
// and EventCode.STREAM_WRITE = 3 (SUBTASK = 1 is the driver's case).
let RESULT_MASK = 15;
let RESULT_COMPLETED = 0;
let BLOCKED = -1;
let EVENT_STREAM_WRITE = 3;

let mem = Memory.default;

/** The blocking writers' waitable set, created on first block. Zero is
 * not a valid set index, so it doubles as "not yet created". */
var blockingSet = 0 as WaitableSet;

/**
 * A blocked write's completion, waited for in place. Only the end
 * being waited on is ever in the blocking set, so the one event a
 * wait can deliver is that write's — anything else is a protocol
 * breakdown worth trapping over.
 */
let awaitWrite = (end: WritableByteStream): i32 => {
  if ((blockingSet as i32) == 0) {
    blockingSet = waitableSetNew();
  }
  waitableJoin((end as i32) as Waitable, blockingSet);
  if (let (true, eventArea) = defaultAllocator.alloc(8)) {
    let event = waitableSetWait(blockingSet as i32, eventArea);
    let waitable = mem.getI32(eventArea);
    let payload = mem.getI32(eventArea + 4);
    defaultAllocator.free(eventArea);
    if (event != EVENT_STREAM_WRITE || waitable != end as i32) {
      throw new Error("a blocking wait delivered someone else's event");
    }
    return payload;
  }
  throw new Error('could not allocate the blocking wait event area');
};

/**
 * Drain `len` bytes at `ptr` into a writable end, returning only once
 * every byte is consumed — blocking, not parking, when the host
 * cannot take them at once. A copy event may report partial progress,
 * so the drain loops. A DROPPED result means the peer let go of the
 * readable end, which a synchronous writer has no way to wait out, so
 * it throws.
 */
let flushBlocking = (end: WritableByteStream, ptr: i32, len: i32) => {
  var at = 0;
  while (at < len) {
    var packed = streamWrite(end, ptr + at, len - at);
    if (packed == BLOCKED) {
      packed = awaitWrite(end);
    }
    if ((packed & RESULT_MASK) != RESULT_COMPLETED) {
      throw new Error('the stream was dropped by its reader');
    }
    let progress = packed >> 4;
    if (progress <= 0) {
      throw new Error('the stream write made no progress');
    }
    at += progress;
  }
};

/**
 * Write a String's bytes to a writable end, appending a newline when
 * asked, blocking until every byte is consumed. The String staging is
 * the one convenience the current consumer (`zena:console`) needs; a
 * byte-buffer entry point over the same `flushBlocking` core arrives
 * with its first consumer, the `Stream<u8>` boundary binding.
 */
export function writeStringBlocking(
  end: WritableByteStream,
  s: String,
  newline: boolean
): void {
  let sLen = s.length;
  let len = sLen + (if (newline) 1 else 0);
  if (len == 0) {
    return;
  }
  if (let (true, buffer) = defaultAllocator.alloc(len)) {
    mem.copyFromString(buffer, s, 0, sLen);
    if (newline) {
      mem[buffer + sLen] = 10;
    }
    flushBlocking(end, buffer, len);
    defaultAllocator.free(buffer);
  }
}

// ============================================================================
// The event-loop binding: `Stream<u8>` across the boundary
// ============================================================================

/** Bytes a pump moves per canonical copy: one staging chunk. */
let CHUNK = 4096;

var sharedWriteChunk = 0;

function flushTextStreamTurn(s: String, end: WritableByteStream) {
  let len = s.length;
  if (len == 0) {
    streamDropWritable(end);
    return;
  }
  if (len <= CHUNK) {
    if (sharedWriteChunk == 0) {
      if (let (true, c) = defaultAllocator.alloc(CHUNK)) {
        sharedWriteChunk = c;
      }
    }
    let chunk = sharedWriteChunk;
    if (chunk != 0) {
      mem.copyFromString(chunk, s, 0, len);
      let packed = streamWrite(end, chunk, len);
      if (packed != BLOCKED) {
        if ((packed & RESULT_MASK) != RESULT_COMPLETED || (packed >> 4) >= len) {
          streamDropWritable(end);
          return;
        }
        pumpTextRemainder(s, packed >> 4, end);
        return;
      }
      sharedWriteChunk = 0;
      pumpBlockedTextChunk(s, 0, chunk, end);
      return;
    }
  }
  pumpTextRemainder(s, 0, end);
}

async function pumpBlockedTextChunk(
  s: String,
  offset: i32,
  chunk: i32,
  end: WritableByteStream
): Future<void> {
  let packed = await awaitWaitable(end as i32);
  defaultAllocator.free(chunk);
  if ((packed & RESULT_MASK) != RESULT_COMPLETED) {
    streamDropWritable(end);
    return;
  }
  let nextOffset = offset + (packed >> 4);
  if (nextOffset >= s.length) {
    streamDropWritable(end);
    return;
  }
  await pumpTextRemainder(s, nextOffset, end);
}

async function pumpTextRemainder(
  s: String,
  startOffset: i32,
  end: WritableByteStream
): Future<void> {
  if (let (true, chunk) = defaultAllocator.alloc(CHUNK)) {
    var offset = startOffset;
    let total = s.length;
    var open = true;
    while (open && offset < total) {
      let rem = total - offset;
      let n = if (rem < CHUNK) rem else CHUNK;
      mem.copyFromString(chunk, s, offset, n);
      var at = 0;
      while (at < n) {
        var packed = streamWrite(end, chunk + at, n - at);
        if (packed == BLOCKED) {
          packed = await awaitWaitable(end as i32);
        }
        if ((packed & RESULT_MASK) != RESULT_COMPLETED) {
          open = false;
          break;
        }
        at += packed >> 4;
      }
      offset += n;
    }
    defaultAllocator.free(chunk);
    streamDropWritable(end);
    return;
  }
  throw new Error('could not allocate a stream pump buffer');
}

final class TextStreamPump implements Waiter {
  #text: String;
  #end: WritableByteStream;

  new(text: String, end: WritableByteStream) : #text = text, #end = end {}

  run(): void {
    flushTextStreamTurn(this.#text, this.#end);
  }
}

/**
 * A guest `Stream<u8>` as a canonical `stream<u8>` value: a fresh
 * pair, a background pump copying the guest stream into the writable
 * end, and the readable end — which IS the transferable value —
 * returned as the wire handle. The pump ends the canonical stream
 * when the source ends, and stops the source when the host reader
 * drops its end.
 *
 * A stream that came from the host and has not been read is not
 * pumped: its own readable end is returned, so the host moves the
 * bytes and none of them pass through the guest.
 */
export function lowerByteStream(source: Stream<u8>): i32 {
  if (source is HostByteStream) {
    let end = source.takeEnd();
    if (end != 0) {
      return end;
    }
  }
  if (source is TextStream) {
    let pair = newByteStreamPair();
    let s = source.takeRemainingText();
    scheduleTask(new TextStreamPump(s, pair.writable));
    return pair.readable as i32;
  }
  let pair = newByteStreamPair();
  pumpOut(source, pair.writable);
  return pair.readable as i32;
}

/**
 * A canonical `stream<u8>` handle as a guest `Stream<u8>`. The first
 * read starts a background pump that reads the readable end on the
 * event loop and delivers into a `StreamWriter` — with the writer's
 * backpressure, so the pump never reads the host faster than the
 * guest consumes. The pump closes the stream when the host drops its
 * writable end, and drops the readable end when the guest reader
 * stops. Until that first read, `lowerByteStream` can pass the handle
 * back to the host unread.
 */
export function liftByteStream(handle: i32): Stream<u8> {
  return new HostByteStream(handle);
}

/**
 * A `stream<u8>` the host handed in, holding its readable end until
 * the guest reads it or hands it on.
 *
 * Reading starts the pump and delegates to the pumped stream. Handing
 * it on — `lowerByteStream`, when the stream is passed to a WIT
 * import such as `wasi:http`'s `response.new` — gives the end itself
 * to the host, so a file's `read-via-stream` sent as a response body
 * is copied by the host from the file to the socket. A stream handed
 * on can no longer be read. Stopping one that was never read drops
 * the end without starting a pump.
 *
 * Handle index 0 is never a valid handle, so `#end == 0` means the
 * end is gone: pumping, stopped, or taken.
 */
final class HostByteStream extends Stream<u8> {
  var #end: i32;
  var #pumped: Stream<u8> | null = null;
  var #taken = false;

  new(end: i32) : #end = end, super();

  /**
   * The readable end, for the caller to pass to the host; 0 when it is
   * no longer here to give. A stream taken this way reads as an error.
   */
  takeEnd(): i32 {
    let end = this.#end;
    if (end != 0) {
      this.#end = 0;
      this.#taken = true;
    }
    return end;
  }

  /** The stream reads delegate to: the pump, started on first use. */
  #source(): Stream<u8> | null {
    let pumped = this.#pumped;
    if (pumped != null) {
      return pumped;
    }
    if (this.#taken) {
      throw new Error(
          'zena:wasi: this stream was handed to the host and cannot be read');
    }
    if (this.#end == 0) {
      // Stopped before any read: the base stream reads as ended.
      return null;
    }
    let writer = new StreamWriter<u8>();
    pumpIn(this.#end as ReadableByteStream, writer);
    this.#end = 0;
    this.#pumped = writer.stream;
    return writer.stream;
  }

  read(buf: FixedArray<u8>): Future<i32> {
    let source = this.#source();
    if (source != null) {
      return source.read(buf);
    }
    return super.read(buf);
  }

  readOne(): Future<Option<u8>> {
    let source = this.#source();
    if (source != null) {
      return source.readOne();
    }
    return super.readOne();
  }

  stop(): void {
    let pumped = this.#pumped;
    if (pumped != null) {
      pumped.stop();
    } else if (this.#end != 0) {
      streamDropReadable(this.#end as ReadableByteStream);
      this.#end = 0;
    }
    super.stop();
  }
}

let pumpBufPool = new Array<FixedArray<u8>>();

/** The guest-to-host pump behind `lowerByteStream`. */
async function pumpOut(
  source: Stream<u8>,
  end: WritableByteStream
): Future<void> {
  if (let (true, chunk) = defaultAllocator.alloc(CHUNK)) {
    let buf = if (pumpBufPool.length > 0) pumpBufPool.pop() else new Array<u8>.fixed(CHUNK, 0);
    var open = true;
    while (open) {
      let n = await source.read(buf);
      if (n == 0) {
        // The source ended: dropping the writable end below is the
        // canonical end-of-stream.
        break;
      }
      mem.copyFromBytes(chunk, buf, 0, n);
      var at = 0;
      while (at < n) {
        var packed = streamWrite(end, chunk + at, n - at);
        if (packed == BLOCKED) {
          packed = await awaitWaitable(end as i32);
        }
        if ((packed & RESULT_MASK) != RESULT_COMPLETED) {
          // The host reader dropped its end: the rest of the source
          // will never be delivered, which its producer learns as
          // any reader stop — writes completing `false`.
          source.stop();
          open = false;
          break;
        }
        at += packed >> 4;
      }
    }
    pumpBufPool.push(buf);
    defaultAllocator.free(chunk);
    streamDropWritable(end);
    return;
  }
  throw new Error('could not allocate a stream pump buffer');
}

/** The host-to-guest pump behind `liftByteStream`. */
async function pumpIn(
  end: ReadableByteStream,
  writer: StreamWriter<u8>
): Future<void> {
  if (let (true, chunk) = defaultAllocator.alloc(CHUNK)) {
    var open = true;
    while (open) {
      var packed = streamRead(end, chunk, CHUNK);
      if (packed == BLOCKED) {
        packed = await awaitWaitable(end as i32);
      }
      let n = packed >> 4;
      let completed = (packed & RESULT_MASK) == RESULT_COMPLETED;
      if (n > 0) {
        let buf = mem.bytesAt(chunk, n);
        let delivered = await writer.writeAll(buf, n);
        if (!delivered) {
          // The guest reader stopped: dropping the readable end below
          // disclaims the rest to the host.
          open = false;
        }
      } else if (completed) {
        throw new Error('the stream read made no progress');
      }
      if (!completed) {
        // The host writer dropped its end — any final bytes were
        // delivered above: end-of-stream.
        open = false;
      }
    }
    defaultAllocator.free(chunk);
    writer.close();
    streamDropReadable(end);
    return;
  }
  throw new Error('could not allocate a stream pump buffer');
}
