/**
 * @file
 *
 * The component target's async-import driver: waitables in, futures
 * out.
 *
 * An async-lowered import returns immediately with a packed value —
 * `(subtask << 4) | state` — instead of blocking. This module turns
 * that protocol into the `Future` every other async source already
 * speaks: `awaitPacked` either completes at once (the call finished
 * inside the lowering) or joins the subtask to the driver's waitable
 * set and parks a completer; when the host re-enters through the
 * callback with a RETURNED subtask, the completer resolves and the
 * microtask queue drains.
 *
 * Stream and future ends ride the same set through `awaitWaitable`:
 * an async copy that returned BLOCKED parks here, and the end's next
 * event — carrying the packed `(progress << 4) | CopyResult` —
 * resolves the future with that payload. The callback dispatches on
 * the event *kind*, because `code` means a `CallState` for a subtask
 * and a copy result for an end, and the two must never be confused.
 *
 * It generalizes what `time/p3.zena` built for the one timer wait —
 * that driver now delegates here — from "at most one subtask" to a
 * registry of any number, which is what synthesized WIT imports need,
 * and keeps that registry per task: each waitable belongs to the task
 * whose entry registered it, and the callback answers for the owner.
 *
 * The entry and callback the compiler wires (`componentPoll`,
 * `componentResume`) live here, and only the `component` target
 * resolves this module.
 */

import {
  Completer, Parker, drainMicrotasks, setBlockingParker
} from 'zena:async';
import { Memory, defaultAllocator } from 'zena:memory';


// ============================================================================
// The canonical builtins
// ============================================================================

// These are Component Model builtins, not WASI: functions the host
// provides to every component, named by `@external("canon", ...)`.
//
// A *waitable* is a host-side handle the host can report an event on:
// a subtask (an async import call in progress), or one end of a
// stream or future. A *waitable set* is a host-side group of
// waitables — the host owns the set and the grouping, and the guest
// only holds its handle. `waitable-set.new` makes an empty one,
// `waitable.join` puts a waitable into a set, and a paused task names
// a set for the host to wake it for. Nothing here is a Zena `Set<T>`.
//
// Exported: a core module may not import one canonical builtin under
// the same name twice, so any other module needing these — the
// console's blocked-write wait, say — imports the declarations from
// here rather than redeclaring them.

/** A waitable's handle: a subtask, or a stream or future end. One
 * host table holds them all, so one type names them all. */
export distinct type Waitable = i32;

/** A waitable set's handle. Zero is never one — the host never hands
 * out 0 — which is what lets a field mean "no set yet". */
export distinct type WaitableSet = i32;

@external("canon", "waitable-set.new")
export declare function waitableSetNew(): WaitableSet;

@external("canon", "waitable-set.drop")
declare function waitableSetDrop(set: WaitableSet): void;

/** Put `waitable` into `set`; a set of 0 removes it from whichever set
 * it is in. A join is persistent until the next join. */
@external("canon", "waitable.join")
export declare function waitableJoin(waitable: Waitable, set: WaitableSet): void;

/**
 * The blocking wait: suspends this task until something in the set
 * fires, returns the event's kind, and stores the waitable index and
 * the payload as two u32s at `ptr`. Only a task the host lifted async
 * may call it: a synchronous task that blocks traps ("cannot block a
 * synchronous task before returning"), which is why every component
 * entry is lifted async, and why a synchronous WIT export can never
 * do blocking I/O. `blockOn` below is the driver's use; the byte
 * stream's blocking write is the other.
 */
@external("canon", "waitable-set.wait")
export declare function waitableSetWait(set: i32, ptr: i32): i32;

@external("canon", "subtask.drop")
declare function subtaskDrop(subtask: Waitable): void;

@external("canon", "task.return")
declare function taskReturn(): void;

// A task's wake future: a bare `future` (no payload) whose readable
// end sits in the task's waitable set. The task arms it when its
// value is still pending and it has nothing of its own to wait on;
// whichever task's entry settles the value writes it, and the host
// re-enters the waiting task with a FUTURE_READ event. See `armWake`.
// The pair packs the readable end in the low 32 bits and the writable
// end in the high 32, like a stream's. Named `#wake` because a core
// module imports each canonical builtin once per name, and a program
// may declare `future.write` at a type of its own.
@external("canon", "future.new#wake", "future")
declare function wakeFutureNew(): u64;

/** The read: BLOCKED until written. `ptr` is unused for a bare
 * future, and 0. */
@external("canon", "future.read#wake", "future,async")
declare function wakeFutureRead(end: i32, ptr: i32): i32;

/** The write: completes at once when the read is pending. */
@external("canon", "future.write#wake", "future,async")
declare function wakeFutureWrite(end: i32, ptr: i32): i32;

@external("canon", "future.drop-readable#wake", "future")
declare function wakeFutureDropReadable(end: i32): void;

@external("canon", "future.drop-writable#wake", "future")
declare function wakeFutureDropWritable(end: i32): void;

// ============================================================================
// Callback codes and packed values
// ============================================================================

/**
 * What the entry and the callback return to the host: the low four
 * bits are the code — EXIT or WAIT — and, for WAIT, the rest is the
 * waitable set to wake the task for, so a WAIT is
 * `WAIT | (set << 4)`.
 */
export distinct type CallbackCode = i32;

/** Done: the task has returned and must not be re-entered. */
let EXIT = 0;
/** Wake me when something in this waitable set fires. */
let WAIT = 2;

let exitCode = (): CallbackCode => EXIT as CallbackCode;
let waitOn = (set: WaitableSet): CallbackCode =>
    (WAIT | ((set as i32) << 4)) as CallbackCode;

/**
 * An async-lowered import returns `(subtask << 4) | state`: the
 * subtask's handle in the high bits, and its `CallState` in the low
 * four. The same state is the `code` a SUBTASK event carries. A
 * subtask is reported more than once — it starts, and later it
 * returns — and only RETURNED means there is a completed subtask to
 * resolve and drop.
 */
let STATE_MASK = 15;
let STATE_RETURNED = 2;

/**
 * The event kinds the callback's first argument carries, from the
 * canonical ABI's EventCode. A SUBTASK event's `code` is a
 * `CallState`; a stream or future event's `code` is the copy's
 * packed payload, `(progress << 4) | CopyResult`, decoded by the
 * reader or writer that parked on it.
 */
let EVENT_SUBTASK = 1;
let EVENT_STREAM_READ = 2;
let EVENT_STREAM_WRITE = 3;
let EVENT_FUTURE_READ = 4;
let EVENT_FUTURE_WRITE = 5;

// ============================================================================
// The driver
// ============================================================================

/**
 * A task is one call from the host into an export that was lifted
 * async. It starts when the host calls the export, pauses by returning
 * a WAIT code that names a waitable set, and resumes when the host
 * calls `componentResume` with an event for something in that set.
 * It ends when it calls `task.return` and returns EXIT. The lifted
 * entry's `main` is the first task; the service world's exported
 * `handle`, called once per request, will be the others
 * (docs/design/component-async-exports.md, Part 2).
 *
 * A waitable is a host-side handle the host can report an event on:
 * a subtask (an async import call in progress), or one end of a
 * stream or future. A waitable set is a host-side group of them,
 * identified by an i32 like every other handle; the `waitable.join`
 * builtin puts a waitable into a set, and a paused task names the set
 * it wants to be woken for. Neither is a Zena collection.
 */
final class TaskContext {
  /** This task's waitable set, or 0 before it needs one. Created
   * lazily by `ensureSet`. */
  var waitableSet = 0 as WaitableSet;
  /** How many waitables this task has joined to its set and is still
   * owed an event for. Zero means the task has nothing left to wait
   * on. */
  var pendingWaitables = 0;
  /** Whether this task hands the host a value through a typed
   * `task.return` (see `finishTask`), rather than the bare one the
   * driver calls for a task that returns nothing. */
  var returnsValue = false;
  /** The typed return, ready to call: set once the task's result is
   * known, called from the task's own entry, then cleared. */
  var pendingReturn: (() => void) | null = null;
  /** Whether the typed return has been called. */
  var returned = false;
  /** What the task's result failed with, if it did. Reported by the
   * next answer to the host instead of a return. */
  var failure: Error | null = null;
  /** The wake future's two ends, or 0 before one is armed and after
   * each is dropped (`armWake`, `wake`). */
  var wakeReadable = 0;
  var wakeWritable = 0;
}

/**
 * The task that is running: the one the host called into, or re-
 * entered through the callback. Tracked because the host does not say
 * which task an export call or callback belongs to — the guest has
 * to know. Code that starts a wait (`awaitPacked`, `awaitWaitable`)
 * joins the waitable to this task's set, since this is the task the
 * host will resume when the event arrives; and after resuming a task
 * the callback reports whether that task is done or what it waits
 * on next.
 */
var currentTask: TaskContext | null = null;

/**
 * What one in-flight waitable is owed: the task it was joined for, and
 * the completer its event resolves. A subtask's completes when the
 * call returns; a stream or future copy's completes with the packed
 * payload of its one event. Exactly one of the two is set.
 */
final class Wait {
  owner: TaskContext;
  subtask: Completer<void> | null;
  copy: Completer<i32> | null;
  new(this.owner, this.subtask, this.copy);
}

/**
 * The in-flight waitables, indexed by handle. A handle is the index of
 * an entry in this instance's handle table, which the host allocates
 * from small integers and reuses once a handle is dropped, so an array
 * stays short. Read ends and write ends are distinct handles, and an
 * end has at most one copy in flight, so the handle is the whole key.
 */
let waits = new Array<Wait | null>();

/** The wait recorded for `waitable`, or null. */
let waitFor = (waitable: Waitable): Wait | null => {
  let i = waitable as i32;
  return if (i < waits.length) waits[i] else null;
};

/**
 * Start a task. Called by the synthesized adapter at the top of every
 * export the host lifted async — the entry, a service's `handle` —
 * before the program's function runs, so what that function waits
 * on and returns belongs to the new task and not to whichever task
 * ran last. Without this, two requests in flight in one instance
 * would share a context: both joined to one waitable set, the second
 * value parked where the first was already returned, and the host
 * answering the wrong request or none.
 */
export function beginTask(): void {
  currentTask = new TaskContext();
}

/**
 * The synchronous wait's park source on this target: one blocking
 * `waitable-set.wait` on the running task's set, dispatched the way the
 * callback would. `runFuture` falls back to it once the microtask queue
 * is empty, which is what lets a synchronous caller wait out a p3
 * import or timer — `zena:fs` does, and so does a test that runs a
 * future to its value. Installed by `blockOn` (block.zena), and on the
 * zena command's host by the entry, through `zena:host-setup`. Not by
 * `beginTask`: building the parker links the wait, whose event pair
 * lives in linear memory, and a component that only awaits has no use
 * for either.
 */
final class DriverParker implements Parker {
  new();

  park(): boolean {
    let ctx = currentContext();
    if (ctx.pendingWaitables == 0) {
      return false;
    }
    if (let (true, area) = defaultAllocator.alloc(8)) {
      let mem = Memory.default;
      let event = waitableSetWait(ensureSet(ctx) as i32, area);
      let fired = mem.getI32(area);
      let code = mem.getI32(area + 4);
      defaultAllocator.free(area);
      let waitable = fired as Waitable;
      let isCopy = event == EVENT_STREAM_READ || event == EVENT_STREAM_WRITE ||
          event == EVENT_FUTURE_READ || event == EVENT_FUTURE_WRITE;
      if ((event == EVENT_SUBTASK && code == STATE_RETURNED) || isCopy) {
        dispatchEvent(event, waitable, code);
        // The event may have belonged to another task; the blocking
        // one is running again now.
        currentTask = ctx;
      }
      return true;
    }
    throw new Error('the blocking wait could not allocate its event area');
  }
}

var blockingParkerInstalled = false;

/**
 * Register the parker, once: for `blockOn` (block.zena) and the zena
 * command's host setup. A program that reaches neither links no
 * blocking wait.
 */
export let installBlockingParker = (): void => {
  if (!blockingParkerInstalled) {
    blockingParkerInstalled = true;
    setBlockingParker(new DriverParker());
  }
};

/** The running task, created lazily when nothing began one: code
 * that waits before any adapter ran, which is the synchronous
 * console's blocking path. (`??=` would say this in one line, but it
 * does not lower on a module-level `var` yet — #572.) */
let currentContext = (): TaskContext => {
  let existing = currentTask;
  if (existing != null) {
    return existing;
  }
  let fresh = new TaskContext();
  currentTask = fresh;
  return fresh;
};

/** Create the task's waitable set if it has none yet. */
let ensureSet = (ctx: TaskContext): WaitableSet => {
  if ((ctx.waitableSet as i32) == 0) {
    ctx.waitableSet = waitableSetNew();
  }
  return ctx.waitableSet;
};

/** Join `waitable` to `ctx`'s set and record what it is owed — from
 * whichever task is running: a set is the instance's, and any task may
 * put a waitable into any set. */
let registerFor = (
  ctx: TaskContext,
  waitable: Waitable,
  subtask: Completer<void> | null,
  copy: Completer<i32> | null
): void => {
  waitableJoin(waitable, ensureSet(ctx));
  let i = waitable as i32;
  while (waits.length <= i) {
    waits.push(null);
  }
  waits[i] = new Wait(ctx, subtask, copy);
  ctx.pendingWaitables += 1;
};

/** Forget the wait recorded for `waitable` and count it off the task
 * that was waiting. Null if nothing was. */
let release = (waitable: Waitable): Wait | null => {
  let wait = waitFor(waitable);
  if (wait != null) {
    waits[waitable as i32] = null;
    wait.owner.pendingWaitables -= 1;
  }
  return wait;
};

/**
 * An async-lowered import's packed result, as a future. `packed` is
 * the raw `(subtask << 4) | state` the lowering returned (see
 * STATE_MASK), taken as an i32 because that is what a raw import
 * hands back.
 *
 * State RETURNED means the call finished inside the lowering — the
 * timer had already expired, the write already flushed — and the
 * future arrives completed, with no subtask to own. Anything else is a
 * subtask: joined to the running task's set, registered, resolved by
 * the callback.
 */
export function awaitPacked(packed: i32): Future<void> {
  let completer = new Completer<void>();
  if ((packed & STATE_MASK) == STATE_RETURNED) {
    completer.complete();
    return completer.future;
  }
  let subtask = (packed >> 4) as Waitable;
  registerFor(currentContext(), subtask, completer, null);
  return completer.future;
}

/**
 * A stream or future end's next event, as a future of the packed
 * `(progress << 4) | CopyResult` payload. The caller has just issued
 * an async copy on `end` and got BLOCKED back: the copy is in flight,
 * and the payload arrives when the host has moved what it can. `end`
 * is the raw handle as the copy builtin took it.
 */
export function awaitWaitable(end: i32): Future<i32> {
  let completer = new Completer<i32>();
  registerFor(currentContext(), end as Waitable, null, completer);
  return completer.future;
}

/**
 * Arm `ctx`'s wake future: a fresh bare future whose readable end
 * joins `ctx`'s set with a read pending on it, so that a write to the
 * other end re-enters `ctx` with a FUTURE_READ event. Armed from
 * `ctx`'s own entry when its value is pending and it has nothing else
 * to wait on, and from another task's entry by `wake` when the value
 * settles there; either way the ends are the instance's, and joining
 * from any task works.
 */
let armWake = (ctx: TaskContext): void => {
  let pair = wakeFutureNew();
  let readable = pair as i32;
  ctx.wakeReadable = readable;
  ctx.wakeWritable = (pair >> 32) as i32;
  // -1 is BLOCKED: nothing written yet, the copy is in flight, and
  // its completion arrives as a FUTURE_READ event.
  if (wakeFutureRead(readable, 0) != -1) {
    throw new Error("a wake future was readable before it was written");
  }
  registerFor(ctx, readable as Waitable, null, new Completer<i32>());
};

/**
 * Re-enter `ctx` to run its return, once its value has settled. The
 * host re-enters a task only for an event in that task's set, and the
 * value may have settled in another task's entry — a timer queue arms
 * one host wait for every sleeper, so the wait that fires belongs to
 * whichever task armed it, and every due sleep completes in that
 * task's drain. `ctx` may be waiting on things of its own meanwhile,
 * some of which never fire (a response's transmitted future the
 * program ignores), so its own next entry cannot be counted on. The
 * wake future is the event: armed here if `ctx` has none, written at
 * once (the read is pending, so the write completes immediately), and
 * `ctx`'s callback then finds the return parked. Settling in `ctx`'s
 * own entry needs none of this: that entry's `nextCode` runs the
 * return.
 */
let wake = (ctx: TaskContext): void => {
  if (ctx.wakeWritable == 0) {
    if (currentTask == ctx) {
      // Settled in its own entry: the entry's `nextCode` runs the
      // return, and no event is needed.
      return;
    }
    // Settled in another task's entry, and `ctx` has not armed a wake
    // — it may well have waitables of its own it is waiting on, some
    // of which may never fire. The pair is created here, joined to
    // `ctx`'s set from this task, and written at once.
    armWake(ctx);
  }
  let writable = ctx.wakeWritable;
  ctx.wakeWritable = 0;
  if (wakeFutureWrite(writable, 0) == -1) {
    throw new Error("a wake future's write blocked with its read pending");
  }
  wakeFutureDropWritable(writable);
};

/**
 * Hand the running task's result to the host once `result` settles:
 * `ret` is the typed `task.return` for the task's result type, and
 * the driver calls it from the task's own entry — the one running now
 * if the value is already known by the time the entry asks what to
 * do next, else the callback re-entry after which it is. A failure
 * is reported from that entry instead. Called by the entry wrapper
 * the compiler writes for an async `main` that returns a value
 * (lib/component-entry.zena in the compiler).
 */
export async function finishTask<T>(
  result: Future<T>,
  ret: (value: T) => void
): Future<void> {
  let ctx = currentContext();
  ctx.returnsValue = true;
  try {
    let value = await result;
    ctx.pendingReturn = (): void => {
      ret(value);
    };
  } catch (e) {
    ctx.failure = e;
  }
  wake(ctx);
}

/**
 * Note that the running task's typed `task.return` has been called
 * already, by the entry itself: a synchronous `main`'s value is known
 * when it returns, and the entry adapter the compiler builds returns
 * it before asking what to do next (ir/component-adapters.zena in the
 * compiler). Without this the driver would issue its bare
 * `task.return` at exit, a second return for the same task.
 */
export function markReturned(): void {
  let ctx = currentContext();
  ctx.returnsValue = true;
  ctx.returned = true;
}

/**
 * Decide how the task returns to the host: EXIT once it has nothing
 * left to wait on — after `task.return`, and after dropping its
 * waitable set, since a set left alive at exit is a leak the host
 * reports rather than collects — or WAIT naming its set otherwise.
 *
 * A task with a value calls its typed return as soon as the value is
 * known, here, from its own entry: `task.return` must be issued by
 * the task it belongs to. That can be before EXIT — the task may still
 * have waitables to see out — but never after. A task that runs out
 * of things to wait on with its value still pending is not done: the
 * value is coming from work another task's entry will finish, so it
 * arms its wake future and waits for that (`armWake`). A value that
 * never comes leaves the task waiting forever, which is what the
 * deadlock is; nothing here can tell it apart from a slow one.
 */
let nextCode = (ctx: TaskContext): CallbackCode => {
  let failure = ctx.failure;
  if (failure != null) {
    throw failure;
  }
  let ret = ctx.pendingReturn;
  if (ret != null) {
    ctx.pendingReturn = null;
    ctx.returned = true;
    ret();
    // Lowering the value can start work: a stream or future in it
    // gets a pump, whose first step is a queue hop and whose first
    // copy joins this task's set. Run the checkpoint again so that
    // work has happened before the task decides whether it has
    // anything left to wait on — else it exits with the pump parked
    // on a hop nothing will ever drain.
    drainMicrotasks();
  }
  if (ctx.pendingWaitables == 0) {
    if (ctx.returnsValue && !ctx.returned) {
      armWake(ctx);
      return waitOn(ctx.waitableSet);
    }
    if (ctx.wakeReadable != 0) {
      // Fired and consumed; the end is out of the set already.
      wakeFutureDropReadable(ctx.wakeReadable);
      ctx.wakeReadable = 0;
    }
    if ((ctx.waitableSet as i32) != 0) {
      waitableSetDrop(ctx.waitableSet);
      ctx.waitableSet = 0 as WaitableSet;
    }
    if (!ctx.returnsValue) {
      taskReturn();
    }
    return exitCode();
  }
  return waitOn(ctx.waitableSet);
};

/**
 * Called by the synthesized entry after `main` returns: run the
 * microtask checkpoint, then either exit or ask to be woken.
 */
export function componentPoll(): CallbackCode {
  let ctx = currentContext();
  drainMicrotasks();
  return nextCode(ctx);
}

/**
 * The callback the host calls when a waitable fires. It resolves the
 * completer parked on that waitable, runs the microtask checkpoint —
 * the runtime's, at the host boundary, where a JS engine runs its own
 * — and answers for the task that was waiting on the waitable.
 *
 * A SUBTASK event's `code` is its new state — a subtask is delivered
 * more than once, and only RETURNED resolves anything (dropping an
 * unresolved subtask traps, so the state is checked rather than
 * assumed). A stream or future event's `code` is the packed copy
 * payload, delivered exactly once per parked copy, and it resolves
 * the end's completer with the payload for the parked reader or
 * writer to decode.
 */
export function componentResume(
  event: i32,
  fired: i32,
  code: i32
): CallbackCode {
  let waitable = fired as Waitable;
  if (event == EVENT_SUBTASK && code != STATE_RETURNED) {
    // Started, not returned: nothing to resolve, keep waiting.
    var set = currentContext().waitableSet;
    let known = waitFor(waitable);
    if (known != null) {
      set = known.owner.waitableSet;
    }
    return waitOn(set);
  }
  let isCopy = event == EVENT_STREAM_READ || event == EVENT_STREAM_WRITE ||
      event == EVENT_FUTURE_READ || event == EVENT_FUTURE_WRITE;
  if (event != EVENT_SUBTASK && !isCopy) {
    return waitOn(currentContext().waitableSet);
  }
  let ctx = dispatchEvent(event, waitable, code);
  return nextCode(ctx);
}

/**
 * Resolve what an event settles — the completer parked on the
 * subtask, or on the stream or future end — and run the microtask
 * checkpoint. Returns the task that was waiting on the waitable,
 * which becomes the running task. The callback's second half, and
 * the whole of a `blockOn` turn.
 */
let dispatchEvent = (event: i32, waitable: Waitable, code: i32): TaskContext => {
  let wait = release(waitable);
  let ctx = if (wait != null) wait.owner else currentContext();
  currentTask = ctx;
  if (wait != null) {
    let subtask = wait.subtask;
    let copy = wait.copy;
    if (event == EVENT_SUBTASK && subtask != null) {
      subtaskDrop(waitable);
      subtask.complete();
    } else if (event != EVENT_SUBTASK && copy != null) {
      // A join is persistent: the end would stay in the set after its
      // event, and a set dropped at exit with members still in it
      // traps. The end leaves the set with its event; the next copy
      // that blocks joins it again.
      waitableJoin(waitable, 0 as WaitableSet);
      copy.complete(code);
    }
  }
  drainMicrotasks();
  return ctx;
};

