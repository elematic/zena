/// What the `zena` command's host provides beyond WASI: the imports
/// behind `zena:error-stack`, `zena:process` and `zena:wasm` on the
/// component target. `zena-runtime` implements every interface here,
/// and `zena-cli` and `zena-run` link them; nothing else does.
package zena-cli:host@1.0.0;

/// Backtraces for `Error`: what wasmtime knows about the guest's stack.
interface stack-trace {
  /// The wasm backtrace at the call, formatted one frame per line, or
  /// the empty string when the host keeps none.
  capture: func() -> string;
}

/// Spawning host processes. Granted to the command (`--allow-spawn`); a
/// component without the grant gets stubs that trap.
interface process {
  /// How a process ended, and what it wrote.
  record finished {
    exit-code: s32,
    stdout: list<u8>,
    stderr: list<u8>,
    /// Wall-clock nanoseconds from spawn to exit.
    wall-nanos: s64,
    /// The process overran its deadline and was killed.
    timed-out: bool,
  }

  /// A process being configured.
  resource command {
    constructor(argv: list<string>);
    /// The working directory, in the guest's view of the file system.
    cwd: func(path: string);
    /// Connect the process to the host's own stdio instead of capturing.
    inherit-stdio: func();
    /// Write `data` to the process's stdin, then close it. Without it
    /// the process reads end of input straight away.
    input: func(data: list<u8>);
    /// Set the environment variable `name` to `value` in the process,
    /// which otherwise inherits the host's environment.
    env: func(name: string, value: string);
    /// Leave the environment variable `name` out of the process's
    /// environment.
    env-remove: func(name: string);
    /// Start it. An error is why it could not start.
    spawn: func() -> result<process, string>;
  }

  /// A running process.
  resource process {
    /// Wait at most `millis` milliseconds, killing the process on
    /// overrun; a non-positive limit waits forever. Waiting again
    /// returns the same result.
    wait: func(millis: s64) -> finished;
  }
}

/// Running other Wasm components. Granted with `process`.
interface wasm {
  /// A directory of the caller's, `source`, preopened for the run under
  /// the path `target`.
  record dir-mapping {
    source: string,
    target: string,
  }

  /// How to run a component. See `zena:wasm`'s `RunOptions`.
  record run-options {
    args: list<string>,
    env: list<tuple<string, string>>,
    inherit-env: bool,
    dirs: list<dir-mapping>,
    invoke: string,
    inherit-stdio: bool,
    /// Pass on the caller's grant to spawn processes.
    grant: bool,
    /// Pass on the caller's grant to instantiate components.
    grant-extensions: bool,
    debug: bool,
    /// A time limit in nanoseconds; none when not positive.
    timeout-nanos: s64,
  }

  /// How a run ended.
  enum outcome {
    /// The export returned.
    returned,
    trapped,
    timed-out,
    /// The component could not be read, compiled, linked or instantiated.
    failed,
    /// The component ended itself with `exit(code)`.
    exited,
  }

  record run-result {
    outcome: outcome,
    exit-code: s32,
    /// The export's first result as `zena run` prints it; '' without one.
    result-text: string,
    message: string,
    stdout: list<u8>,
    stderr: list<u8>,
    /// Nanoseconds the exported call took.
    call-nanos: s64,
  }

  /// A run in progress. Starting is the constructor.
  resource run {
    constructor(path: string, options: run-options);
    /// Block until the run ends. Waiting again returns the same result.
    wait: func() -> run-result;
  }

  /// Write a component's ahead-of-time compiled form beside it; '' on
  /// success, else why not.
  precompile: func(path: string, debug: bool) -> string;
}

/// Loading components as extensions: long-lived instances the program
/// calls through objects, and which call the program through objects
/// the program made for each of them. Granted on its own
/// (`--allow-extensions`).
///
/// The program decides what an extension gets: `load` takes a binding
/// for every interface the extension may import, and an import without
/// one fails the load. The program's own WIT declares its side of each
/// interface in a shape the host pairs with the extension's, in full in
/// docs/design/runtime-components.md:
///
/// - An interface the program serves is exported as a resource whose
///   methods are the extension's free functions, plus
///   `create: func(extension: u32) -> own<resource>`. The first call from
///   an extension on that interface makes its object through `create`,
///   and every later call lands on that object, so the object is the
///   extension's identity.
/// - An interface the program calls is imported as a resource whose
///   methods are the extension's exported functions, each result wrapped
///   in `result<_, string>` (the string says why a call failed), plus
///   `attach: func(extension: u32) -> own<resource>`, which the host
///   serves with an object whose method calls go to that extension.
///
/// A call on an attached object must be awaited: a program that blocks
/// on it keeps its instance entered, so the extension's calls back
/// cannot start, and both sides wait on each other.
interface extensions {
  /// Where one of an extension's imports comes from.
  variant source {
    /// This host: a WASI or `zena-cli:host` interface.
    host,
    /// This program's export of the given name.
    program(string),
    /// Another loaded extension's export of the same name, by handle.
    extension(u32),
  }

  record binding {
    /// The import, by name with version: `wasi:clocks/monotonic-clock@0.3.0`.
    name: string,
    served-by: source,
  }

  record load-options {
    /// The most memory the instance may hold, linear memory and GC heap
    /// together, in bytes; no limit when 0.
    memory-limit: u64,
    /// The most time one call may take, in nanoseconds; no limit when
    /// not positive.
    call-timeout-nanos: s64,
    /// Run with inlining off, so a trap's backtrace names every
    /// function.
    debug: bool,
  }

  /// Loads `path`, in the caller's view of the file system, with
  /// `bindings` as everything it may import, checks its types against
  /// this program's, and instantiates it. The result is the extension's
  /// handle, or why it could not be loaded.
  load: func(path: string, bindings: list<binding>, options: load-options) -> result<u32, string>;

  /// `load` for a component the program trusts as it trusts itself: it
  /// may import every interface this host serves, and every interface
  /// this program exports, by the same name.
  load-trusted: func(path: string, options: load-options) -> result<u32, string>;

  /// Drops the extension and its memory. Calls already made complete;
  /// later calls on an object attached to it fail. Its handle is not
  /// reused. Objects the program made for it through `create` are
  /// released when the program's run ends.
  drop: func(extension: u32);
}

/// Running an HTTP server for zena-cli.
interface http-server {
  use wasi:http/types@0.3.0.{request, response, error-code};

  /// Single-use responder for an incoming HTTP request.
  resource response-writer {
    /// Sends the HTTP response for this request.
    respond: func(response: response);

    /// Sends an in-memory text response and disposes the writer and optional unconsumed request.
    complete-text: static func(
      writer: response-writer,
      req: option<request>,
      status: u16,
      content-type: string,
      headers: list<tuple<string, string>>,
      body: string
    );

    /// Aborts this request with an HTTP error code.
    respond-error: func(error: error-code);
  }

  /// A host-managed HTTP server instance.
  resource server {
    /// Binds a TCP listener on `127.0.0.1:port` (or an ephemeral port if `port` is 0)
    /// and returns the running server resource, or an error string if binding fails.
    create: static func(port: u16) -> result<server, string>;

    /// The bound TCP port number.
    port: func() -> u16;

    /// Returns a stream of incoming HTTP requests paired with their response writers.
    listen: func() -> stream<tuple<request, response-writer>>;

    /// Closes the listener socket and terminates the request stream.
    close: func();
  }
}

/// The command's imports beyond WASI.
/// Handling credentials: files only their owner may read, and reading a
/// secret from the terminal without showing it. Granted with `process`.
interface secrets {
  /// Writes `contents` to `path`, in the caller's view of the file
  /// system, as a file only its owner can read or write: on Unix,
  /// created with mode 0600, or set to 0600 before it is truncated if it
  /// exists. The error says why it could not.
  write-private: func(path: string, contents: list<u8>) -> result<_, string>;

  /// Writes `prompt` to the terminal and reads a line from it with echo
  /// off, returning the line without its line ending. The error says why
  /// it could not, such as stdin not being a terminal.
  read-hidden: func(prompt: string) -> result<string, string>;
}

world command {
  import stack-trace;
  import process;
  import wasm;
  import extensions;
  import http-server;
  import secrets;
}
