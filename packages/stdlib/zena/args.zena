/**
 * Command-line argument parsing with flags, options, positional arguments,
 * subcommands, and help text generation.
 *
 * ## Examples
 *
 * ```zena
 * import { ArgParser, OptionType } from 'zena:args';
 * import { getArguments } from 'zena:cli';
 *
 * let parser = new ArgParser('mytool')
 *   .addOption('verbose', {
 *     type: OptionType.Flag,
 *     abbr: 'v',
 *     help: 'Enable verbose logging',
 *   })
 *   .addOption('output', {
 *     abbr: 'o',
 *     defaultVal: 'out.txt',
 *     help: 'Output file path',
 *   });
 *
 * let parsed = parser.parse(getArguments(), 1);
 * let verbose = parsed.getFlag('verbose');
 * let output = parsed.getOption('output') ?? 'out.txt';
 * ```
 */

import { StringBuilder, StringReader, parseI64, parseI32, growable } from 'zena:core';
import { OrderedHashMap } from 'zena:collections';

/**
 * A parsed command-line option value.
 */
export sealed class ParsedValue {
  case Flag(value: boolean)
  case Single(value: String)
  case Multi(values: GrowableArray<String>)
}

/**
 * The type of a command-line option.
 */
export enum OptionType {

  /**
   * A key-value string option (--opt <val>, --opt=<val>, -o <val>). Default.
   */
  StringVal,

  /**
   * A boolean toggle (--flag, -f, --no-flag).
   */
  Flag,

  /**
   * An integer number option (--count 42).
   */
  Int,

  /**
   * A repeatable string option collecting multiple values (--dir <val>).
   */
  MultiString,
}

/**
 * Configuration for a single command-line option.
 */
export type OptionConfig = {
  name?: String,
  type?: OptionType,
  abbr?: String,
  defaultVal?: String | null,
  allowed?: Array<String> | null,
  help?: String,
  description?: String,
};

/**
 * Configuration for a subcommand.
 */
export type CommandConfig = {
  description?: String,
  help?: String,
  options?: Map<String, OptionConfig>,
};

/**
 * Configuration for an entire command-line parser.
 */
export type ParserConfig = {
  name: String,
  description?: String,
  help?: String,
  options?: Map<String, OptionConfig>,
  commands?: Map<String, CommandConfig>,
};

/**
 * The results of parsing command-line arguments.
 */
export class ParsedArgs {
  /**
   * The parsed options by name.
   */
  options: HashMap<String, ParsedValue>;

  /**
   * Positional arguments not consumed as options or subcommands.
   */
  rest: GrowableArray<String>;

  /**
   * The subcommand invoked, or null if no subcommand was matched.
   */
  commandName: String | null;

  /**
   * The parsed arguments for the invoked subcommand, or null.
   */
  commandArgs: ParsedArgs | null;

  new(
    this.options,
    this.rest,
    this.commandName,
    this.commandArgs
  );

  /**
   * Returns true if the named boolean flag was set, or its default value.
   */
  getFlag(name: String): boolean {
    if (let (true, val) = this.options.get(name)) {
      if (val is Flag) {
        return (val as Flag).value;
      }
    }
    return false;
  }

  /**
   * Returns the value of the named option as an inline tuple:
   * `(true, value)` if the option was set, or `(false, _)` if not.
   *
   * To fallback to a default value, use `getOption(name) ?? fallback`.
   */
  getOption(name: String): inline (true, String) | inline (false, _) {
    if (let (true, val) = this.options.get(name)) {
      if (val is Single) {
        return (true, (val as Single).value);
      }
    }
    return (false, _);
  }

  /**
   * Returns the integer value of the named option, or `fallback` if not set
   * or not a valid integer.
   */
  getInt(name: String): inline (true, i32) | inline (false, _) {
    if (let (true, val) = this.options.get(name)) {
      if (val is Single) {
        return parseI32((val as Single).value);
      }
    }
    return (false, _);
  }

  /**
   * Returns all values passed for a repeatable multi-option.
   */
  getMultiOption(name: String): Array<String> {
    if (let (true, val) = this.options.get(name)) {
      if (val is Multi) {
        return (val as Multi).values;
      }
    }
    return [];
  }

  /**
   * Returns the parsed value for the named option, or not found.
   */
  get(name: String): inline (true, ParsedValue) | inline (false, _) {
    return this.options.get(name);
  }

  /**
   * Returns true if the option was passed on the command line or has a default.
   */
  hasOption(name: String): boolean {
    return this.options.has(name);
  }
}

// ============================================================================
// ArgParser
// ============================================================================

/**
 * Configurable command-line argument parser.
 *
 * `ArgParser` defines options, flags, and subcommands, parses raw argument
   strings
 * (e.g. from `zena:cli`'s `getArguments()`), and formats standard `--help`
   usage messages.
 *
 * ### Defining Options & Commands
 *
 * Options and subcommands can be configured either declaratively in the
   constructor
 * (or `new ArgParser.fromConfig(config)`), or incrementally with `addOption`
   and `addCommand`:
 *
 * ```zena
 * let parser = new ArgParser('mytool', 'A sample CLI utility', {
 *   'verbose' => {type: OptionType.Flag, abbr: 'v', help: 'Enable verbose
     output'},
 *   'output'  => {abbr: 'o', help: 'Output file path', defaultVal: 'out.txt'},
 *   'count'   => {type: OptionType.Int, abbr: 'n', help: 'Number of items'},
 * }, {
 *   'build'   => {help: 'Build the project', options: {'release' => {type:
     OptionType.Flag}}},
 * });
 * ```
 *
 * ### Supported Argument Syntax
 *
 * - **Flags**: `--flag`, short `-f`, negated `--no-flag`, or combined short
     flags `-vfg`
 * - **Options**: `--opt value`, `--opt=value`, `-o value`, `-o=value`, or
     attached `-oval`
 * - **Delimiter**: `--` treats all subsequent arguments as positional rest
     values
 * - **Subcommands**: Dispatched to the matching subcommand's parser
 *
 * Call `parser.parse(args, startIndex)` to produce a `ParsedArgs` instance, or
 * `parser.formatHelp()` to generate usage documentation.
 */
export class ArgParser {
  programName: String;
  description: String;
  #options = new OrderedHashMap<String, OptionConfig>();
  #byAbbr = new HashMap<String, OptionConfig>();
  #commands = new OrderedHashMap<String, ArgParser>();

  new(
    this.programName = '',
    this.description = '',
    options: Map<String, OptionConfig> | null = null,
    commands: Map<String, CommandConfig> | null = null
  ) {
    if (options != null) {
      this.addOptions(options as Map<String, OptionConfig>);
    }
    if (commands != null) {
      this.addCommands(commands as Map<String, CommandConfig>);
    }
  }

  new fromConfig(config: ParserConfig)
    : programName = config.name,
      description = (config.help ?? (config.description ?? '')) {
    if (let {options} = config) {
      this.addOptions(options);
    }
    if (let {commands} = config) {
      this.addCommands(commands);
    }
  }

  /**
   * Adds an option declaratively.
   */
  addOption(name: String, config: OptionConfig = {}): ArgParser {
    this.#addOpt({ ...config, name });
    return this;
  }

  /**
   * Adds multiple options declaratively from a map.
   */
  addOptions(options: Map<String, OptionConfig>): ArgParser {
    for (let entry in options) {
      this.#addOpt({ ...entry.value, name: entry.key });
    }
    return this;
  }

  /**
   * Adds a subcommand with its own parser.
   */
  addCommand(name: String, config: CommandConfig = {}): ArgParser {
    let desc = config.help ?? (config.description ?? '');
    let commandParser = new ArgParser(name, desc);
    if (let {options} = config) {
      commandParser.addOptions(options);
    }
    this.#commands[name] = commandParser;
    return commandParser;
  }

  /**
   * Adds multiple subcommands declaratively from a map.
   */
  addCommands(commands: Map<String, CommandConfig>): ArgParser {
    for (let entry in commands) {
      this.addCommand(entry.key, entry.value);
    }
    return this;
  }

  #addOpt(opt: OptionConfig): void {
    let {name = ''} = opt;
    if (name.length == 0) {
      throw new Error('Option must have a name');
    }
    this.#options[name] = opt;
    if (let {abbr} = opt) {
      this.#byAbbr[abbr] = opt;
    }
  }

  /**
   * Parses the given array of argument strings.
   *
   * @param args The arguments to parse (e.g. from getArguments())
   * @param startIndex The index to start parsing from (typically 0 or 1)
   */
  parse(args: Array<String>, startIndex: i32 = 0): ParsedArgs {
    let options = new HashMap<String, ParsedValue>();
    let rest = new GrowableArray<String>();
    var commandName: String | null = null;
    var commandArgs: ParsedArgs | null = null;

    let pushMulti = (name: String, val: String): void => {
      if (let (true, Multi {values}) = options.get(name)) {
        values.push(val);
      } else {
        options[name] = new Multi(growable([val]));
      }
    };

    var i = startIndex;
    var stopOptions = false;

    while (i < args.length) {
      let arg = args[i];

      if (stopOptions) {
        rest.push(arg);
        i += 1;
        continue;
      }

      if (arg == '--') {
        stopOptions = true;
        i += 1;
        continue;
      }

      // Long option: --name, --name=value, --no-name
      if (arg.startsWith('--')) {
        let reader = new StringReader(arg);
        reader.skipBytes(2);

        let maybeName = reader.readUntil('=');
        if (maybeName != null) {
          let name = maybeName as String;
          let val = reader.readToEnd();
          if (let (true, opt) = this.#options.get(name)) {
            let optType = opt.type ?? OptionType.StringVal;
            if (optType == OptionType.Flag) {
              options[name] = new Flag(val == 'true' || val == '1');
            } else if (optType == OptionType.MultiString) {
              pushMulti(name, val);
            } else {
              options[name] = new Single(val);
            }
          } else {
            throw new Error(`Unknown option: '--${name}'`);
          }
        } else {
          let optBody = reader.readToEnd();

          // Check --no-flag
          if (optBody.startsWith('no-')) {
            let noReader = new StringReader(optBody);
            noReader.skipBytes(3);
            let negName = noReader.readToEnd();
            if (let (true, opt) = this.#options.get(negName)) {
              let optType = opt.type ?? OptionType.StringVal;
              if (optType == OptionType.Flag) {
                options[negName] = new Flag(false);
                i += 1;
                continue;
              }
            }
          }

          if (let (true, opt) = this.#options.get(optBody)) {
            let optType = opt.type ?? OptionType.StringVal;
            if (optType == OptionType.Flag) {
              options[optBody] = new Flag(true);
            } else if (optType == OptionType.StringVal || optType == OptionType.Int) {
              if (i + 1 >= args.length) {
                throw new Error(`Option '--${optBody}' requires a value`);
              }
              options[optBody] = new Single(args[i + 1]);
              i += 1;
            } else if (optType == OptionType.MultiString) {
              if (i + 1 >= args.length) {
                throw new Error(`Option '--${optBody}' requires a value`);
              }
              pushMulti(optBody, args[i + 1]);
              i += 1;
            }
          } else {
            throw new Error(`Unknown option: '--${optBody}'`);
          }
        }
        i += 1;
        continue;
      }

      // Short option: -f, -f value, -f=value, -fvalue, combined -vfg
      if (arg.startsWith('-') && arg.length > 1) {
        let reader = new StringReader(arg);
        reader.skipBytes(1);
        let start = reader.mark();
        reader.advance();
        let shortChar = reader.sliceFrom(start);

        if (let (true, opt) = this.#byAbbr.get(shortChar)) {
          let optType = opt.type ?? OptionType.StringVal;
          let optName = opt.name ?? '';
          if (optType == OptionType.Flag) {
            options[optName] = new Flag(true);
            // Check if combined short flags like -vg
            while (!reader.isAtEnd) {
              let chStart = reader.mark();
              reader.advance();
              let ch = reader.sliceFrom(chStart);
              if (let (true, fOpt) = this.#byAbbr.get(ch)) {
                let fType = fOpt.type ?? OptionType.StringVal;
                let fName = fOpt.name ?? '';
                if (fType == OptionType.Flag) {
                  options[fName] = new Flag(true);
                } else {
                  throw new Error(`Option '-${ch}' is not a flag`);
                }
              } else {
                throw new Error(`Unknown short option: '-${ch}'`);
              }
            }
          } else {
            // Non-flag short option
            if (!reader.isAtEnd) {
              reader.matchByte(61); // '='
              let restOfArg = reader.readToEnd();
              if (optType == OptionType.MultiString) {
                pushMulti(optName, restOfArg);
              } else {
                options[optName] = new Single(restOfArg);
              }
            } else {
              if (i + 1 >= args.length) {
                throw new Error(`Option '-${shortChar}' requires a value`);
              }
              if (optType == OptionType.MultiString) {
                pushMulti(optName, args[i + 1]);
              } else {
                options[optName] = new Single(args[i + 1]);
              }
              i += 1;
            }
          }
        } else {
          throw new Error(`Unknown option: '${arg}'`);
        }
        i += 1;
        continue;
      }

      // Check subcommands
      if (this.#commands.has(arg)) {
        let sub = this.#commands[arg];
        commandName = arg;
        commandArgs = sub.parse(args, i + 1);
        break;
      }

      // Positional argument
      rest.push(arg);
      i += 1;
    }

    // Apply defaults for options not explicitly provided on the CLI
    for (let entry in this.#options) {
      let optName = entry.key;
      let opt = entry.value;
      if (!options.has(optName)) {
        let optType = opt.type ?? OptionType.StringVal;
        let optDefault = opt.defaultVal ?? null;
        if (optType == OptionType.Flag) {
          if (optDefault == 'true') {
            options[optName] = new Flag(true);
          }
        } else if (optType == OptionType.StringVal || optType == OptionType.Int) {
          if (optDefault != null) {
            options[optName] = new Single(optDefault as String);
          }
        }
      }
    }

    return new ParsedArgs(options, rest, commandName, commandArgs);
  }

  /**
   * Formats a standard help and usage message.
   */
  formatHelp(): String {
    let sb = new StringBuilder();
    sb.append('Usage: ');
    if (this.programName.length > 0) {
      sb.append(this.programName);
    } else {
      sb.append('program');
    }

    if (this.#options.size > 0) {
      sb.append(' [options]');
    }
    if (this.#commands.size > 0) {
      sb.append(' <command> [args]');
    }
    sb.append('\n');

    if (this.description.length > 0) {
      sb.append('\n');
      sb.append(this.description);
      sb.append('\n');
    }

    if (this.#options.size > 0) {
      sb.append('\nOptions:\n');
      for (let entry in this.#options) {
        let opt = entry.value;
        let optName = entry.key;
        let optAbbr = opt.abbr ?? '';
        let optType = opt.type ?? OptionType.StringVal;
        let optHelp = opt.help ?? (opt.description ?? '');
        let optDefault = opt.defaultVal ?? null;

        sb.append('  ');
        var optStr = '';
        if (optAbbr.length > 0) {
          optStr = `-${optAbbr}, --${optName}`;
        } else {
          optStr = `    --${optName}`;
        }
        if (optType != OptionType.Flag) {
          optStr = `${optStr} <value>`;
        }
        sb.append(optStr);

        // Pad to column 28
        for (var pad = 28 - optStr.length; pad > 0; pad -= 1) {
          sb.append(' ');
        }

        sb.append(optHelp);
        if (optDefault != null && optType != OptionType.Flag) {
          sb.append(` (default: ${optDefault as String})`);
        }
        sb.append('\n');
      }
    }

    if (this.#commands.size > 0) {
      sb.append('\nCommands:\n');
      for (let entry in this.#commands) {
        let cmdName = entry.key;
        let sub = entry.value;
        sb.append('  ');
        sb.append(cmdName);
        for (var pad = 16 - cmdName.length; pad > 0; pad -= 1) {
          sb.append(' ');
        }
        sb.append(sub.description);
        sb.append('\n');
      }
    }

    return sb.toString();
  }
}

/**
 * Convenience function to parse arguments using a map of option specifications.
 *
 * @param args The command-line argument array (e.g. from getArguments())
 * @param options A map of option specifications
 * @param offset The starting index in args to parse from (default: 0)
 * @returns Parsed arguments result
 */
export function parseArgs(
  args: Array<String>,
  options: Map<String, OptionConfig>,
  offset: i32 = 0
): ParsedArgs {
  let parser = new ArgParser('', '', options);
  return parser.parse(args, offset);
}
