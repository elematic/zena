/**
 * Pattern matching and regular expression translation for glob patterns.
 *
 * Supports standard glob wildcards:
 * - `*` matches characters within a single path segment (not crossing `/`)
 * - `**` matches across directory boundaries
 * - `?` matches any single character
 * - `[...]` matches character ranges and classes
 * - `[!...]` matches inverted character classes
 * - `{a,b}` matches any one of its comma-separated alternatives, each of
 *   which may hold wildcards or further braces (`{src,test}/**`,
 *   `index.{js,d.ts}`, `main{,.test}.zena`)
 *
 * `GlobSet` reads a list of patterns with `!` exclusions, the way
 * `.gitignore` does.
 *
 * ## Examples
 *
 * ```zena
 * import { matchGlob, GlobPattern } from 'zena:glob';
 *
 * let matches = matchGlob('tests/*_test.zena', 'tests/foo_test.zena');
 *
 * let pattern = new GlobPattern('*.zena');
 * let isZena = pattern.matches('main.zena');
 * ```
 */

import { Regex } from 'zena:regex';
import { StringBuilder } from 'zena:core';

// ============================================================================
// Pattern Inspection & Translation
// ============================================================================

/**
 * Returns true if `pattern` contains any glob syntax ('*', '?', '[', '{').
 */
export let hasMagic = (pattern: String): boolean => {
  for (var i = 0; i < pattern.length; i += 1) {
    let b = pattern.getByteAt(i);
    if (b == 42 || b == 63 || b == 91 || b == 123) { // '*', '?', '[', '{'
      return true;
    }
  }
  return false;
};

/**
 * Translates a glob pattern to an anchored regular expression string.
 *
 * @throws Error if a `{` has no matching `}`.
 */
export let globToRegex = (pattern: String): String => {
  let sb = new StringBuilder();
  sb.appendByte(94); // '^'
  translateRange(pattern, 0, pattern.length, sb);
  sb.appendByte(36); // '$'
  return sb.toString();
};

/**
 * The index one past a `[...]` class starting at `start`, or `end` if it
 * runs off the range. Brace scanning skips classes whole, so a `{` or
 * `,` inside one stays a class member.
 */
let skipClass = (pattern: String, start: i32, end: i32): i32 => {
  var i = start + 1;
  if (i < end && pattern.getByteAt(i) == 33) { // '[!'
    i += 1;
  }
  while (i < end && pattern.getByteAt(i) != 93) { // ']'
    if (pattern.getByteAt(i) == 92) { // escaped member
      i += 1;
    }
    i += 1;
  }
  return if (i < end) i + 1 else end;
};

/**
 * Translates `pattern[start..end)` into `sb`. A `{a,b}` becomes the
 * alternation `(?:a|b)`, each alternative translated the same way, so
 * alternatives nest and carry wildcards of their own.
 */
let translateRange = (
  pattern: String,
  start: i32,
  end: i32,
  sb: StringBuilder,
): void => {
  var i = start;

  while (i < end) {
    let b = pattern.getByteAt(i);

    if (b == 42) { // '*'
      if (i + 1 < end && pattern.getByteAt(i + 1) == 42) { // '**'
        i += 2;
        if (i < end && pattern.getByteAt(i) == 47) { // '/**/'
          i += 1;
          sb.append('(?:.*/)?');
        } else {
          sb.append('.*');
        }
      } else {
        sb.append('[^/]*');
        i += 1;
      }
    } else if (b == 63) { // '?'
      sb.append('[^/]');
      i += 1;
    } else if (b == 123) { // '{'
      i = translateBraces(pattern, i, end, sb);
    } else if (b == 91) { // '['
      sb.appendByte(91);
      i += 1;
      if (i < end && pattern.getByteAt(i) == 33) { // '[!' -> '[^'
        sb.appendByte(94); // '^'
        i += 1;
      }
      while (i < end && pattern.getByteAt(i) != 93) { // ']'
        let cb = pattern.getByteAt(i);
        if (cb == 92) { // escape in bracket
          sb.appendByte(92);
          i += 1;
          if (i < end) {
            sb.appendByte(pattern.getByteAt(i));
          }
        } else {
          sb.appendByte(cb);
        }
        i += 1;
      }
      if (i < end && pattern.getByteAt(i) == 93) {
        sb.appendByte(93);
        i += 1;
      }
    } else if (b == 46 || b == 43 || b == 40 || b == 41 || b == 125 ||
               b == 124 || b == 94 || b == 36 || b == 92) {
      // Escape regex metacharacters: . + ( ) } | ^ $ \
      sb.appendByte(92);
      sb.appendByte(b);
      i += 1;
    } else {
      sb.appendByte(b);
      i += 1;
    }
  }
};

/**
 * Translates the `{...}` group opening at `open` and returns the index
 * after its closing `}`. Commas split alternatives only at the group's
 * own depth; nested groups are translated when their alternative is.
 */
let translateBraces = (
  pattern: String,
  open: i32,
  end: i32,
  sb: StringBuilder,
): i32 => {
  var depth = 0;
  var altStart = open + 1;
  var i = open;
  sb.append('(?:');
  while (i < end) {
    let b = pattern.getByteAt(i);
    if (b == 91) { // '['
      i = skipClass(pattern, i, end);
      continue;
    }
    if (b == 123) { // '{'
      depth += 1;
    } else if (b == 125) { // '}'
      depth -= 1;
      if (depth == 0) {
        translateRange(pattern, altStart, i, sb);
        sb.appendByte(41); // ')'
        return i + 1;
      }
    } else if (b == 44 && depth == 1) { // ','
      translateRange(pattern, altStart, i, sb);
      sb.appendByte(124); // '|'
      altStart = i + 1;
    }
    i += 1;
  }
  throw new Error(`Unclosed brace in glob pattern: ${pattern}`);
};

// ============================================================================
// GlobPattern Class
// ============================================================================

/**
 * A compiled glob pattern for efficient repeated matching against paths.
 */
export class GlobPattern {
  pattern: String;
  #regex: Regex;

  new(pattern: String)
    : pattern = pattern,
      #regex = new Regex(globToRegex(pattern));

  /**
   * Returns true if `path` matches this glob pattern.
   */
  matches(path: String): boolean {
    return this.#regex.test(path);
  }
}

/**
 * Tests if `path` matches `pattern`.
 */
export let matchGlob = (pattern: String, path: String): boolean => {
  let gp = new GlobPattern(pattern);
  return gp.matches(path);
};

/**
 * An ordered list of patterns in which a `!` prefix excludes, read the
 * way `.gitignore` and wireit read theirs: a path is in the set when the
 * last pattern that matches it is a positive one.
 *
 * `['src/**', '!src/tmp/**', 'src/tmp/keep.ts']` takes `src/a.ts` and
 * `src/tmp/keep.ts` and leaves out `src/tmp/x.ts`. A path no pattern
 * matches is not in the set, so a list of only negations is empty.
 */
export class GlobSet {
  #patterns: GrowableArray<GlobPattern>;
  #negated: GrowableArray<boolean>;

  new(patterns: Array<String>)
      : #patterns = new GrowableArray<GlobPattern>(),
        #negated = new GrowableArray<boolean>() {
    for (let raw in patterns) {
      var pattern = raw;
      var negated = false;
      if (pattern.startsWith('!')) {
        negated = true;
        pattern = pattern.sliceBytes(1, pattern.length);
      }
      this.#patterns.push(new GlobPattern(pattern));
      this.#negated.push(negated);
    }
  }

  /** How many patterns the set holds, negations included. */
  size: i32 {
    get {
      return this.#patterns.length;
    }
  }

  /** Whether `path` is in the set. */
  matches(path: String): boolean {
    var included = false;
    for (var i = 0; i < this.#patterns.length; i += 1) {
      if (this.#patterns[i].matches(path)) {
        included = !this.#negated[i];
      }
    }
    return included;
  }
}
