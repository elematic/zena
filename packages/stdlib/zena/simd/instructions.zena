/**
 * @file
 *
 * WebAssembly fixed-width SIMD: the `v128` vector type's instruction set,
 * one `@intrinsic` declaration per wasm instruction, lowered to that
 * single instruction with nothing in between.
 *
 * Names follow the wasm names mechanically — `i32x4.add` is
 * `i32x4Add`, `v128.load8x8_s` is `v128Load8x8S` — so the spec reads
 * as documentation for this module. See docs/design/simd.md.
 *
 * Arguments that wasm takes as IMMEDIATES must be literals: the lane
 * index of the lane-access and lane-memory instructions, the four words
 * of `v128Const`, and the sixteen lane selectors of `i8x16Shuffle`.
 * A non-literal there is a compile error, not a slower path.
 *
 * Relaxed SIMD is not here: its results are allowed to differ between
 * engines, which is a decision to make deliberately rather than inherit.
 */

// ===========================================================================
// Loads and stores
// ===========================================================================
//
// The memory argument is the compiler's: every access uses the
// instruction's natural alignment at offset zero. Alignment is a hint in
// wasm and never changes what a load returns, so nothing is lost by not
// exposing it.

@intrinsic('v128.load')
export declare function v128Load(ptr: i32): v128;
@intrinsic('v128.load8x8_s')
export declare function v128Load8x8S(ptr: i32): v128;
@intrinsic('v128.load8x8_u')
export declare function v128Load8x8U(ptr: i32): v128;
@intrinsic('v128.load16x4_s')
export declare function v128Load16x4S(ptr: i32): v128;
@intrinsic('v128.load16x4_u')
export declare function v128Load16x4U(ptr: i32): v128;
@intrinsic('v128.load32x2_s')
export declare function v128Load32x2S(ptr: i32): v128;
@intrinsic('v128.load32x2_u')
export declare function v128Load32x2U(ptr: i32): v128;
@intrinsic('v128.load8_splat')
export declare function v128Load8Splat(ptr: i32): v128;
@intrinsic('v128.load16_splat')
export declare function v128Load16Splat(ptr: i32): v128;
@intrinsic('v128.load32_splat')
export declare function v128Load32Splat(ptr: i32): v128;
@intrinsic('v128.load64_splat')
export declare function v128Load64Splat(ptr: i32): v128;
@intrinsic('v128.load32_zero')
export declare function v128Load32Zero(ptr: i32): v128;
@intrinsic('v128.load64_zero')
export declare function v128Load64Zero(ptr: i32): v128;
@intrinsic('v128.store')
export declare function v128Store(ptr: i32, value: v128): void;
@intrinsic('v128.load8_lane')
export declare function v128Load8Lane(ptr: i32, vec: v128, lane: i32): v128;
@intrinsic('v128.load16_lane')
export declare function v128Load16Lane(ptr: i32, vec: v128, lane: i32): v128;
@intrinsic('v128.load32_lane')
export declare function v128Load32Lane(ptr: i32, vec: v128, lane: i32): v128;
@intrinsic('v128.load64_lane')
export declare function v128Load64Lane(ptr: i32, vec: v128, lane: i32): v128;
@intrinsic('v128.store8_lane')
export declare function v128Store8Lane(ptr: i32, vec: v128, lane: i32): void;
@intrinsic('v128.store16_lane')
export declare function v128Store16Lane(ptr: i32, vec: v128, lane: i32): void;
@intrinsic('v128.store32_lane')
export declare function v128Store32Lane(ptr: i32, vec: v128, lane: i32): void;
@intrinsic('v128.store64_lane')
export declare function v128Store64Lane(ptr: i32, vec: v128, lane: i32): void;

// ===========================================================================
// Constants, shuffles and splats
// ===========================================================================

@intrinsic('v128.const')
export declare function v128Const(lane0: i32, lane1: i32, lane2: i32, lane3: i32): v128;
@intrinsic('i8x16.shuffle')
export declare function i8x16Shuffle(a: v128, b: v128, l0: i32, l1: i32, l2: i32, l3: i32, l4: i32, l5: i32, l6: i32, l7: i32, l8: i32, l9: i32, l10: i32, l11: i32, l12: i32, l13: i32, l14: i32, l15: i32): v128;
@intrinsic('i8x16.swizzle')
export declare function i8x16Swizzle(a: v128, b: v128): v128;
@intrinsic('i8x16.splat')
export declare function i8x16Splat(x: i32): v128;
@intrinsic('i16x8.splat')
export declare function i16x8Splat(x: i32): v128;
@intrinsic('i32x4.splat')
export declare function i32x4Splat(x: i32): v128;
@intrinsic('i64x2.splat')
export declare function i64x2Splat(x: i64): v128;
@intrinsic('f32x4.splat')
export declare function f32x4Splat(x: f32): v128;
@intrinsic('f64x2.splat')
export declare function f64x2Splat(x: f64): v128;

// ===========================================================================
// Lane access
// ===========================================================================

@intrinsic('i8x16.extract_lane_s')
export declare function i8x16ExtractLaneS(a: v128, lane: i32): i32;
@intrinsic('i8x16.extract_lane_u')
export declare function i8x16ExtractLaneU(a: v128, lane: i32): i32;
@intrinsic('i8x16.replace_lane')
export declare function i8x16ReplaceLane(a: v128, lane: i32, value: i32): v128;
@intrinsic('i16x8.extract_lane_s')
export declare function i16x8ExtractLaneS(a: v128, lane: i32): i32;
@intrinsic('i16x8.extract_lane_u')
export declare function i16x8ExtractLaneU(a: v128, lane: i32): i32;
@intrinsic('i16x8.replace_lane')
export declare function i16x8ReplaceLane(a: v128, lane: i32, value: i32): v128;
@intrinsic('i32x4.extract_lane')
export declare function i32x4ExtractLane(a: v128, lane: i32): i32;
@intrinsic('i32x4.replace_lane')
export declare function i32x4ReplaceLane(a: v128, lane: i32, value: i32): v128;
@intrinsic('i64x2.extract_lane')
export declare function i64x2ExtractLane(a: v128, lane: i32): i64;
@intrinsic('i64x2.replace_lane')
export declare function i64x2ReplaceLane(a: v128, lane: i32, value: i64): v128;
@intrinsic('f32x4.extract_lane')
export declare function f32x4ExtractLane(a: v128, lane: i32): f32;
@intrinsic('f32x4.replace_lane')
export declare function f32x4ReplaceLane(a: v128, lane: i32, value: f32): v128;
@intrinsic('f64x2.extract_lane')
export declare function f64x2ExtractLane(a: v128, lane: i32): f64;
@intrinsic('f64x2.replace_lane')
export declare function f64x2ReplaceLane(a: v128, lane: i32, value: f64): v128;

// ===========================================================================
// Bitwise
// ===========================================================================

@intrinsic('v128.not')
export declare function v128Not(a: v128): v128;
@intrinsic('v128.and')
export declare function v128And(a: v128, b: v128): v128;
@intrinsic('v128.andnot')
export declare function v128Andnot(a: v128, b: v128): v128;
@intrinsic('v128.or')
export declare function v128Or(a: v128, b: v128): v128;
@intrinsic('v128.xor')
export declare function v128Xor(a: v128, b: v128): v128;
@intrinsic('v128.bitselect')
export declare function v128Bitselect(a: v128, b: v128, c: v128): v128;
@intrinsic('v128.any_true')
export declare function v128AnyTrue(a: v128): i32;

