// Public entry for 'zena:simd' — re-exports only.
//
// Two layers, one import. `shapes.zena` holds the vector types you
// normally reach for; `instructions.zena` is the whole WebAssembly
// fixed-width SIMD instruction set, one function per instruction, for
// everything the shapes do not cover.
//
// The shapes are extension classes over `v128` and are erased, so
// `I32x4` IS a `v128` at runtime and `v as v128` costs nothing. Mixing
// the two layers in one expression is normal and free.

export * from './shapes.zena';
export * from './instructions.zena';
