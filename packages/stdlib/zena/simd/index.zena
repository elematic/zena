/**
 * WebAssembly 128-bit fixed-width SIMD vector types and instructions.
 *
 * Provides typed vector shapes (`I8x16`, `I16x8`, `I32x4`, `I64x2`, `F32x4`,
 * `F64x2`) with elementwise arithmetic operators, along with low-level
 * instruction intrinsics.
 *
 * ## Examples
 *
 * ```zena
 * import { I32x4 } from 'zena:simd';
 *
 * let a = I32x4.splat(10);
 * let b = I32x4.splat(20);
 * let sum = a + b;
 * ```
 */

export * from './shapes.zena';
export * from './instructions.zena';
