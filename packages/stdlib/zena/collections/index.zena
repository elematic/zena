/**
 * Collection data structures: maps, sets, and array types.
 *
 * Provides mutable and ordered hash maps (`HashMap`, `OrderedHashMap`),
 * hash sets (`HashSet`, `OrderedHashSet`), and array abstractions
 * (`FixedArray`, `GrowableArray`, `ImmutableArray`).
 *
 * ## Examples
 *
 * ```zena
 * import { HashMap, HashSet } from 'zena:collections';
 *
 * let counts = new HashMap<String, i32>();
 * counts['apples'] = 3;
 * counts['oranges'] = 5;
 *
 * let seen = new HashSet<String>();
 * seen.add('first');
 * let hasFirst = seen.has('first');
 * ```
 */

export { Hashable } from 'zena:core';

export { Array, MutableArray } from 'zena:core';
export { FixedArray, fixed } from 'zena:core';
export { GrowableArray, growable } from 'zena:core';
export { ImmutableArray } from 'zena:core';

export { Map, MapEntry } from './map.zena';
export { HashMap } from './hash-map.zena';
export { OrderedMap as OrderedHashMap } from './hash-map.zena';
export { Set } from './set.zena';
export { HashSet, OrderedHashSet } from './hash-set.zena';
