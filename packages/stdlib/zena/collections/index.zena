// Public entry for 'zena:collections' — re-exports only.
//
// One library for the collections, rather than a module per class. The
// implementation files beside this one have no manifest entry and are
// reachable only from here and from each other; 'zena:map' and 'zena:set'
// are thin shims over the same files, kept because most code imports from
// them.
//
// OrderedMap and OrderedHashSet are exported here and nowhere else.

export * from 'zena:hashable';

export { Sequence, MutableSequence } from 'zena:sequence';
export { FixedArray } from 'zena:fixed-array';
export { Array } from 'zena:growable-array';
export { ImmutableArray } from 'zena:immutable-array';

export { Map, MapEntry } from './map.zena';
export { HashMap } from './hash-map.zena';
export { OrderedMap as OrderedHashMap } from './hash-map.zena';
export { Set } from './set.zena';
export { HashSet, OrderedHashSet } from './hash-set.zena';
