// The Set interface. The hash-backed implementations live in hash-set.zena.
//
// `zena:collections` is a prelude entry, so every module it re-exports is
// denied the prelude. These names are spelled out for that reason.
// The classes the constructors below build. hash-set.zena imports this
// module back; classes and interfaces may cross an import cycle.
import { HashSet, OrderedHashSet } from './hash-set.zena';

export interface Set<T> extends Iterable<T> {
  // The interface asks nothing of T; a hash table needs it Hashable, so
  // these constructors restate the parameter with that bound, checked
  // at each `new Set<T>()`.

  /** An empty HashSet, with room for `capacity` values before it grows. */
  new<T extends Hashable>(capacity: i32 = 16) {
    return new HashSet<T>(capacity);
  }

  /** An empty OrderedHashSet: iteration follows insertion order. */
  new ordered<T extends Hashable>(capacity: i32 = 16) {
    return new OrderedHashSet<T>(capacity);
  }

  size: i32 { get; }

  /**
   * Adds a value to the set. Returns true if the value was newly added,
   * false if it already existed.
   */
  add(value: T): boolean;

  /**
   * Checks if the set contains the given value.
   */
  operator [](value: T): boolean;

  /**
   * Checks if the set contains the given value.
   */
  has(value: T): boolean;

  /**
   * Removes a value from the set. Returns true if the value was removed,
   * false if it didn't exist.
   */
  delete(value: T): boolean;

  /**
   * Removes all values from the set.
   */
  clear(): void;
}
