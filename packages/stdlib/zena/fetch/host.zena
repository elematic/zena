/**
 * HTTP client for making network requests.
 *
 * `fetch(url, init)` sends an HTTP request and completes with a `Response`.
 * The response provides the HTTP status, headers, and methods for
 * asynchronously reading the response body.
 *
 * ## Examples
 *
 * ```zena
 * import { fetch } from 'zena:fetch';
 *
 * let response = await fetch('https://example.com/api/data');
 * if (response.ok) {
 *   let text = await response.text();
 * }
 * ```
 */

import { pending } from 'zena:js';
import { Disposable, Own } from 'zena:core';
import { StreamLimitError } from 'zena:stream';
import { URL } from 'zena:url';
import { RequestInit } from './options.zena';
export { RequestInit } from './options.zena';

/** Opaque reference to the host's own response object. */
distinct type JsResponse = anyref;

/** Opaque reference to a host `RequestInit` object being assembled. */
distinct type JsRequestInit = anyref;

/** Opaque reference to a host `Uint8Array`. */
distinct type JsBytes = anyref;

/** Starts fetching `url` with `init`; the host completes `handle` with a
 * reference to its response object once headers have arrived. */
@external("web", "fetch_start")
declare function __fetch_start(
  handle: i32,
  url: String,
  len: i32,
  init: JsRequestInit | null
): void;

/** Allocates an empty host `RequestInit` object. */
@external("web", "request_init")
declare function __request_init(): JsRequestInit;

/** Sets `init.method` on the host `RequestInit`. */
@external("web", "request_method")
declare function __request_method(init: JsRequestInit, method: String, len: i32): void;

/** Appends a `(name, value)` header pair on the host `RequestInit`. */
@external("web", "request_header")
declare function __request_header(
  init: JsRequestInit,
  name: String,
  nameLen: i32,
  value: String,
  valueLen: i32
): void;

/** Sets `init.body` on the host `RequestInit` to a text string. */
@external("web", "request_body_text")
declare function __request_body_text(init: JsRequestInit, body: String, len: i32): void;

/** Allocates a `Uint8Array(len)` as `init.body` on the host `RequestInit` and returns it. */
@external("web", "request_body_bytes")
declare function __request_body_bytes(init: JsRequestInit, len: i32): JsBytes;

/** Sets `bytes[index] = value` on a host `Uint8Array`. */
@external("web", "bytes_set")
declare function __bytes_set(bytes: JsBytes, index: i32, value: i32): void;

/** The HTTP status of the host response. */
@external("web", "response_status")
declare function __response_status(response: JsResponse): i32;

/** Reads the body of the host response; the host completes `handle`
 * with the decoded text. */
@external("web", "response_text")
declare function __response_text(handle: i32, response: JsResponse): void;

/** Reads the body of the host response as a `Uint8Array`; the host
 * completes `handle` with the `Uint8Array` reference. */
@external("web", "response_bytes")
declare function __response_bytes(handle: i32, response: JsResponse): void;

/** The byte length of a host `Uint8Array`. */
@external("web", "bytes_length")
declare function __bytes_length(bytes: JsBytes): i32;

/** Reads `bytes[index]` from a host `Uint8Array`. */
@external("web", "bytes_get")
declare function __bytes_get(bytes: JsBytes, index: i32): i32;

/** Retrieves the value of the named response header from the host,
 * or null if absent. */
@external("web", "response_header")
declare function __response_header(response: JsResponse, name: String, len: i32): String | null;

/**
 * An HTTP response: the status and headers, and the body, which lives on
 * the host until it is read.
 *
 * A resource class, held as `Own<Response>`, as on the component
 * targets: reading the body consumes the response (`text`, `bytes`), so
 * it is read at most once, as on the web, and a second read is a use
 * after move. Read the status and any headers you need first.
 */
export resource class Response {
  /** The HTTP status code. */
  status: i32;
  #response: JsResponse;

  new(this.status, response: JsResponse) : #response = response;

  /** True for a 2xx status, exactly like the web's `Response.ok`. */
  ok: boolean {
    get {
      return this.status >= 200 && this.status < 300;
    }
  }

  /**
   * The first value of the response header `name`, or null when the
   * response carries none. Header names are case-insensitive.
   */
  header(name: String): String | null {
    return __response_header(this.#response, name, name.length);
  }

  /**
   * The response body, decoded as text. Consumes the response. With a
   * `limit` of zero or more, a body longer than that many bytes fails with
   * `StreamLimitError`. The host reads the whole body before the program
   * sees it, so here the limit bounds what the program keeps, not what the
   * host receives.
   */
  text(this: Own<this>, limit: i64 = -1 as i64): Future<String> {
    let p = pending<String>();
    __response_text(p.handle, this.#response);
    return if (limit < (0 as i64)) p.future else textWithin(p.future, limit);
  }

  /** The response body's bytes, read up to `limit` as `text` reads. Consumes the response. */
  async bytes(this: Own<this>, limit: i64 = -1 as i64): Future<FixedArray<u8>> {
    let p = pending<anyref>();
    __response_bytes(p.handle, this.#response);
    let bytes = await bytesOf(p.future);
    if (limit >= (0 as i64) && (bytes.length as i64) > limit) {
      throw new StreamLimitError(limit);
    }
    return bytes;
  }

  /** The host's response is the garbage collector's: nothing to release. */
  [Disposable.dispose](this: Own<this>): void {}
}

/** The text `text` completes with, unless it is longer than `limit` bytes. */
async function textWithin(text: Future<String>, limit: i64): Future<String> {
  let value = await text;
  if ((value.length as i64) > limit) {
    throw new StreamLimitError(limit);
  }
  return value;
}

/** The bytes of the `Uint8Array` the host completes `raw` with. */
async function bytesOf(raw: Future<anyref>): Future<FixedArray<u8>> {
  let bytes = (await raw) as JsBytes;
  let len = __bytes_length(bytes);
  let out = new FixedArray<u8>(len, 0 as u8);
  for (var i = 0; i < len; i += 1) {
    out[i] = __bytes_get(bytes, i) as u8;
  }
  return out;
}

let buildInit = (init: RequestInit): JsRequestInit | null => {
  var jsInit: JsRequestInit | null = null;
  let ensure = (): JsRequestInit => {
    let existing = jsInit;
    if (existing != null) {
      return existing;
    }
    let created = __request_init();
    jsInit = created;
    return created;
  };
  if (let {method} = init) {
    __request_method(ensure(), method, method.length);
  }
  if (let {headers} = init) {
    let target = ensure();
    for (let (name, value) in headers) {
      __request_header(target, name, name.length, value, value.length);
    }
  }
  if (let {body} = init) {
    if (body is String) {
      __request_body_text(ensure(), body, body.length);
    } else if (body is FixedArray<u8>) {
      let len = body.length;
      let raw = __request_body_bytes(ensure(), len);
      for (var i = 0; i < len; i += 1) {
        __bytes_set(raw, i, body[i] as i32);
      }
    }
  }
  return jsInit;
};

/**
 * Starts fetching `url`, returning a future that resolves once the
 * response is available.
 *
 * `init` sets the request method (default `'GET'`), headers, and body
 * (`String` or `FixedArray<u8>`). The future resolves to the `Response`
 * for the request: its status and headers are in, and its body is read
 * from it afterwards.
 *
 * The future fails only when the request itself fails — a network
 * error, a CORS refusal, a host with no fetch(). It does not fail
 * when the server answers with a status that means an error (404,
 * 504, and so on): that is a response like any other, and the caller
 * checks `ok` or `status`.
 */
export async function fetch(url: String | URL, init: RequestInit = {}): Future<Own<Response>> {
  let href = if (url is URL) url.href else url;
  let p = pending<anyref>();
  __fetch_start(p.handle, href, href.length, buildInit(init));
  let response = (await p.future) as JsResponse;
  return new Response(__response_status(response), response);
}
