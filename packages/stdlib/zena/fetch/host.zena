/**
 * zena:fetch — HTTP requests over the host's own fetch()
 * (docs/design/async.md §4, Level 2).
 *
 * The API follows the web's: `fetch(url)` resolves with a `Response`
 * whose `status`/`ok` the caller inspects, and whose body is read
 * separately with `text()` — a 404 is a normal completion, not a
 * failure. The future fails only when there is no response at all: a
 * network error, a CORS refusal, a host with no fetch().
 *
 * The host's response object crosses the boundary as a reference
 * (docs/design/host-interop.md, "Host object handles"): `fetch`
 * completes with the object itself, held here as an opaque anyref the
 * engine's unified garbage collector owns. A `Response` therefore
 * carries no release obligation — when it dies, the host object is
 * collectable — and `text()` is a second host-async completion against
 * the same reference. Keeping the body on the host until it is read is
 * also the structure a streamed body needs later: the host side holds
 * the stream, and reads cross one chunk at a time.
 *
 * The host side inherits fetch()'s web semantics deliberately, CORS
 * included: in a browser, a request only succeeds where the page could
 * have made it itself.
 */
import { Error } from 'zena:error';
import { pending } from 'zena:js';
import { String } from 'zena:string';

/** Opaque reference to the host's own response object. */
distinct type JsResponse = anyref;

/** Starts a GET of `url`; the host completes `handle` with a reference
 * to its response object once headers have arrived. */
@external("web", "fetch_start")
declare function __fetch_start(handle: i32, url: String, len: i32): void;

/** The HTTP status of the host response. */
@external("web", "response_status")
declare function __response_status(response: JsResponse): i32;

/** Reads the body of the host response; the host completes `handle`
 * with the decoded text. */
@external("web", "response_text")
declare function __response_text(handle: i32, response: JsResponse): void;

/**
 * An HTTP response: the status, and a one-shot handle on the body.
 *
 * The body lives on the host until `text()` reads it, so reading is
 * asynchronous and — as on the web — allowed once: a second `text()`
 * throws rather than handing back an empty body.
 */
export class Response {
  /** The HTTP status code. */
  status: i32;
  #response: JsResponse;
  var #bodyUsed: boolean = false;

  new(this.status, response: JsResponse) : #response = response;

  /** True for a 2xx status, exactly like the web's `Response.ok`. */
  ok: boolean {
    get {
      return this.status >= 200 && this.status < 300;
    }
  }

  /** The response body, decoded as text. */
  text(): Future<String> {
    if (this.#bodyUsed) {
      throw new Error(
        'zena:fetch: the response body has already been read');
    }
    this.#bodyUsed = true;
    let p = pending<String>();
    __response_text(p.handle, this.#response);
    return p.future;
  }
}

/**
 * GET `url`, resolving with the `Response` once headers arrive.
 *
 * Fails — an ordinary failed future, caught with `try`/`catch` around
 * the `await` — only when there is no response: a network error, a
 * CORS refusal, a host with no fetch(). A non-2xx status is a normal
 * completion; check `ok` or `status`.
 */
export let fetch = async (url: String): Future<Response> => {
  let p = pending<anyref>();
  __fetch_start(p.handle, url, url.length);
  let response = (await p.future) as JsResponse;
  return new Response(__response_status(response), response);
};
