/**
 * zena:fetch — HTTP requests over the host's own fetch()
 * (docs/design/async.md §4, Level 2).
 *
 * The API follows the web's: `fetch(url)` resolves with a `Response`
 * whose `status`/`ok` the caller inspects, and whose body is read
 * separately with `text()` — a 404 is a normal completion, not a
 * failure. The future fails only when there is no response at all: a
 * network error, a CORS refusal, a host with no fetch().
 *
 * Both halves are ordinary host-async operations: `fetch` completes
 * with an id naming the host-side response object, and `text()` is a
 * second completion that consumes it. Keeping the response on the host
 * behind an id — rather than copying everything over eagerly — is also
 * the structure a streamed body needs later: the host side holds the
 * stream, and reads cross one chunk at a time.
 *
 * The host side inherits fetch()'s web semantics deliberately, CORS
 * included: in a browser, a request only succeeds where the page could
 * have made it itself.
 */
import { Error } from 'zena:error';
import { Future } from 'zena:async';
import { pending } from 'zena:host-async';
import { Disposable } from 'zena:ownership';
import { String } from 'zena:string';

/** Starts a GET of `url`; the host completes `handle` with a response
 * id once headers have arrived. */
@external("web", "fetch_start")
declare function __fetch_start(handle: i32, url: String, len: i32): void;

/** The HTTP status of the host-side response named by `id`. */
@external("web", "response_status")
declare function __response_status(id: i32): i32;

/** Reads the body of the response named by `id`; the host completes
 * `handle` with the decoded text and releases the response. */
@external("web", "response_text")
declare function __response_text(handle: i32, id: i32): void;

/** Releases the response named by `id` without reading it. The host
 * tolerates an id that was already consumed. */
@external("web", "response_drop")
declare function __response_drop(id: i32): void;

/**
 * An HTTP response: the status, and a one-shot handle on the body.
 *
 * The body lives on the host until `text()` reads it, so reading is
 * asynchronous and — as on the web — allowed once: a second `text()`
 * throws rather than handing back an empty body.
 *
 * A response whose body is never read holds its host-side entry until
 * the program ends. `dispose()` releases it early, so a status-only
 * caller can write `using response = await fetch(url);` and hold
 * nothing. (`status`/`ok` were copied over when the response arrived
 * and outlive disposal.) Reading and disposing are one obligation:
 * `text()` consumes the entry, after which `dispose()` is a no-op —
 * and disposal is idempotent, per the `Disposable` contract.
 */
export class Response implements Disposable {
  /** The HTTP status code. */
  status: i32;
  #id: i32;
  var #consumed: boolean = false;

  new(this.status, id: i32) : #id = id;

  /** True for a 2xx status, exactly like the web's `Response.ok`. */
  ok: boolean {
    get {
      return this.status >= 200 && this.status < 300;
    }
  }

  /** The response body, decoded as text. */
  text(): Future<String> {
    if (this.#consumed) {
      throw new Error(
        'zena:fetch: the response body has already been read or disposed');
    }
    this.#consumed = true;
    let p = pending<String>();
    __response_text(p.handle, this.#id);
    return p.future;
  }

  /** Releases the host-side response without reading the body. */
  :Disposable.dispose(): void {
    if (this.#consumed) {
      return;
    }
    this.#consumed = true;
    __response_drop(this.#id);
  }
}

/**
 * GET `url`, resolving with the `Response` once headers arrive.
 *
 * Fails — an ordinary failed future, caught with `try`/`catch` around
 * the `await` — only when there is no response: a network error, a
 * CORS refusal, a host with no fetch(). A non-2xx status is a normal
 * completion; check `ok` or `status`.
 */
export let fetch = async (url: String): Future<Response> => {
  let p = pending<i32>();
  __fetch_start(p.handle, url, url.length);
  let id = await p.future;
  return new Response(__response_status(id), id);
};
