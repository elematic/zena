import { Duration } from 'zena:time';

/**
 * Options for an HTTP request sent with `fetch`.
 */
export type RequestInit = {
  /** The HTTP method, such as `'POST'`. `'GET'` if absent. */
  method?: String,
  /** Request headers as `(name, value)` pairs, appended in order. */
  headers?: Array<(String, String)>,
  /** The request body, as UTF-8 text or bytes, or none when null or absent. */
  body?: String | FixedArray<u8> | null,
  /**
   * The longest to wait for the connection, for the response's status and
   * headers, and then for each part of its body; the request fails when
   * any takes longer. The runtime's own limit if absent, which on
   * `zena-cli` is ten minutes.
   */
  timeout?: Duration,
};
