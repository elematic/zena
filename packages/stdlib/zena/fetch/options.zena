/**
 * Options for an HTTP request sent with `fetch`.
 */
export type RequestInit = {
  /** The HTTP method, such as `'POST'`. `'GET'` if absent. */
  method?: String,
  /** Request headers as `(name, value)` pairs, appended in order. */
  headers?: Array<(String, String)>,
  /** The request body, as UTF-8 text or bytes, or none when null or absent. */
  body?: String | FixedArray<u8> | null,
};
