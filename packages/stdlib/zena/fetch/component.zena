/**
 * HTTP client for making network requests.
 *
 * `fetch(url, init)` sends an HTTP request and completes with a `Response`.
 * The response provides the HTTP status, headers, and methods for
 * asynchronously reading the response body.
 *
 * ## Examples
 *
 * ```zena
 * import { fetch } from 'zena:fetch';
 *
 * let response = await fetch('https://example.com/api/data');
 * if (response.ok) {
 *   let text = await response.text();
 * }
 * ```
 */

import { URL } from 'zena:url';
import { Completer, release } from 'zena:async';
import { Option, Own, Result, unit } from 'zena:core';
import { Stream, bytesStream, readAllBytes, readAllText, textStream } from 'zena:stream';
import {
  Fields, Method, MethodConnect, MethodDelete, MethodGet, MethodHead,
  MethodOptions, MethodOther, MethodPatch, MethodPost, MethodPut,
  MethodTrace, Request, Response as WireResponse, ErrorCode, Scheme,
  SchemeHTTP, SchemeHTTPS, SchemeOther, ErrorCodeDNSError,
  ErrorCodeDNSTimeout, ErrorCodeDestinationNotFound,
  ErrorCodeDestinationUnavailable, ErrorCodeConnectionRefused,
  ErrorCodeConnectionTimeout, ErrorCodeConnectionTerminated,
  ErrorCodeHTTPRequestURIInvalid, ErrorCodeInternalError, ErrorCodeDestinationIPProhibited
} from 'wasi:http/types';
import { send } from 'wasi:http/client';
import { RequestInit } from './options.zena';
export { RequestInit } from './options.zena';

/**
 * An HTTP response: the status and headers, and the body, which stays on
 * the host until it is read.
 *
 * A resource class over the wire response, held as `Own<Response>`.
 * Reading the body consumes the response (`text`, `bytes`), so it is
 * read at most once, and a second read is a use after move. Read the
 * status and any headers you need first. A response dropped unread
 * releases the wire response, and with it the body the host holds.
 */
export resource class Response {
  /** The HTTP status code. */
  status: i32;
  /** The wire response, until reading the body takes it. */
  var #wire: Own<WireResponse> | null;

  new(this.status, wire: Own<WireResponse>) : #wire = wire;

  /** True for a 2xx status, exactly like the web's `Response.ok`. */
  ok: boolean {
    get {
      return this.status >= 200 && this.status < 300;
    }
  }

  /**
   * The first value of the response header `name`, or null when the
   * response carries none. Header names are case-insensitive; values
   * are bytes on the wire and decoded here as text.
   */
  header(name: String): String | null {
    let wire = this.#wire;
    if (wire == null) {
      return null;
    }
    let headers = wire.getHeaders();
    let values = headers.get(name);
    return if (values.length == 0) null else String.fromBytes(values[0]);
  }

  /**
   * The response body, decoded as text. Consumes the response. With a
   * `limit` of zero or more, a body longer than that many bytes stops
   * being read and fails with `StreamLimitError`, so a server cannot fill
   * memory with it.
   */
  async text(this: Own<this>, limit: i64 = -1 as i64): Future<String> {
    let received = new Completer<Result<void, ErrorCode>>();
    let text = await readAllText(this.#consumeBody(received.future), limit);
    received.complete((true, unit()));
    return text;
  }

  /** The response body's bytes, read up to `limit` as `text` reads. Consumes the response. */
  async bytes(this: Own<this>, limit: i64 = -1 as i64): Future<FixedArray<u8>> {
    let received = new Completer<Result<void, ErrorCode>>();
    let bytes = await readAllBytes(this.#consumeBody(received.future), limit);
    received.complete((true, unit()));
    return bytes;
  }

  /**
   * The body stream. `consume-body` takes the wire response and the
   * future the reader settles to say how receiving went, the mirror of
   * a request's trailers. The trailers future it hands back holds an
   * owner, and dropping it unread releases it.
   */
  #consumeBody(this: Own<this>, received: Future<Result<void, ErrorCode>>): Stream<u8> {
    let wire = this.#wire;
    if (wire == null) {
      // Only the consuming readers take it, and each consumes the
      // response, so a response always has its wire here.
      throw new Error('zena:fetch: the response body has already been read');
    }
    let (body, trailers) = WireResponse.consumeBody(wire, received);
    return body;
  }
}

/**
 * Starts fetching `url`, returning a future that resolves once the
 * response is available.
 *
 * `init` sets the request method (default `'GET'`), headers, and body
 * (`String` or `FixedArray<u8>`). The future resolves to the `Response`
 * for the request: its status and headers are in, and its body is read
 * from it afterwards.
 *
 * The future fails only when the request itself fails — a URL that
 * does not parse, a host the runtime could not resolve or reach, a
 * connection that closed before a response arrived. It does not fail
 * when the server answers with a status that means an error (404,
 * 504, and so on): that is a response like any other, and the caller
 * checks `ok` or `status`.
 */
export async function fetch(url: String | URL, init: RequestInit = {}): Future<Own<Response>> {
  var parsed: URL | null = null;
  if (url is URL) {
    parsed = url;
  } else {
    parsed = URL.parse(url);
    if (parsed == null) {
      throw new Error('zena:fetch: not a URL: ' + (url));
    }
  }
  let target = parsed;
  let request = requestFor(target, init);
  let sent = await send(request);
  let wire = match (sent) {
    case (true, let value): value
    case (false, let error): throw new Error(`zena:fetch: ${describe(error)}: ${target.href}`)
  };
  let status = wire.getStatusCode() as i32;
  return new Response(status, wire);
}

/**
 * A request for `target` from `init`: no trailers, the method, headers,
 * body, and the scheme, authority and path-with-query set from the URL.
 * A p3 request has no URL string; those three are its addressing.
 */
function requestFor(target: URL, init: RequestInit): Own<Request> {
  let fields = Fields.create();
  if (let {headers} = init) {
    for (let (name, value) in headers) {
      if (let (false, err) = fields.append(name, value.toBytes())) {
        throw new Error(`zena:fetch: invalid header: ${name}`);
      }
    }
  }
  var contents: Option<Stream<u8>> = none;
  if (let {body} = init) {
    var bodyLength = -1;
    if (body is String) {
      bodyLength = body.length;
      contents = some(textStream(body));
    } else if (body is FixedArray<u8>) {
      bodyLength = body.length;
      contents = some(bytesStream(body));
    }
    if (bodyLength >= 0 && !fields.has('content-length')) {
      if (let (false, err) = fields.append('content-length', `${bodyLength}`.toBytes())) {
        throw new Error('zena:fetch: invalid header: content-length');
      }
    }
  }
  // The trailers future is the sender's to settle, and the host does
  // not consider the request body finished until it is: this request
  // has no trailers, so it settles now with "none".
  let trailers = Future.of<Result<Option<Own<Fields>>, ErrorCode>>(
      (true, none));
  // `new` returns the request and a future that settles once it has
  // been transmitted; a client that wanted send errors ahead of the
  // response would await it. Nothing waits on it here, so its end is
  // given up now: dropping a future of a plain value releases nothing
  // (TODO(#831)).
  let (request, transmitted) =
      Request.new_(fields, contents, trailers, none);
  transmitted.[release]();
  let {method = 'GET'} = init;
  request.setMethod(methodOf(method));
  request.setScheme(some(schemeOf(target.protocol)));
  request.setAuthority(some(target.host()));
  var path = target.pathname;
  if (path == '') {
    path = '/';
  }
  request.setPathWithQuery(some(path + target.search));
  return request;
}

/** The WIT method for a method name such as `GET` or `POST`. */
function methodOf(method: String): Method {
  let upper = method.asciiUpperCase();
  if (upper == 'GET') return new MethodGet();
  if (upper == 'HEAD') return new MethodHead();
  if (upper == 'POST') return new MethodPost();
  if (upper == 'PUT') return new MethodPut();
  if (upper == 'DELETE') return new MethodDelete();
  if (upper == 'CONNECT') return new MethodConnect();
  if (upper == 'OPTIONS') return new MethodOptions();
  if (upper == 'TRACE') return new MethodTrace();
  if (upper == 'PATCH') return new MethodPatch();
  return new MethodOther(method);
}

/** The WIT scheme for a URL protocol such as `http:`. */
function schemeOf(protocol: String): Scheme {
  if (protocol == 'http:') {
    return new SchemeHTTP();
  }
  if (protocol == 'https:') {
    return new SchemeHTTPS();
  }
  // Without the trailing colon, as WIT spells a scheme.
  return new SchemeOther(protocol.sliceBytes(0, protocol.length - 1));
}

/** A short account of why a request produced no response. */
function describe(code: ErrorCode): String {
  if (code is ErrorCodeDNSError || code is ErrorCodeDNSTimeout ||
      code is ErrorCodeDestinationNotFound) {
    return 'the host could not be resolved';
  }
  if (code is ErrorCodeDestinationUnavailable ||
      code is ErrorCodeConnectionRefused ||
      code is ErrorCodeConnectionTimeout) {
    return 'the server could not be reached';
  }
  if (code is ErrorCodeDestinationIPProhibited) {
    // The embedder's policy, such as zena-run's ZENA_DENY_PRIVATE_EGRESS.
    return 'the host prohibits connecting to that address';
  }
  if (code is ErrorCodeConnectionTerminated) {
    return 'the connection was closed before a response arrived';
  }
  if (code is ErrorCodeHTTPRequestURIInvalid) {
    return 'the server rejected the request URI';
  }
  if (code is ErrorCodeInternalError) {
    let detail = code.value;
    if (detail is Some<String>) {
      return 'the host reported: ' + detail.value;
    }
    return 'the host reported an internal error';
  }
  return 'the request failed';
}
