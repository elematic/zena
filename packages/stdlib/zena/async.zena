/**
 * zena:async — Future<T>, Completer<T>, and the microtask executor
 * (docs/design/async.md §2, docs/design/async-runtime-shape.md).
 *
 * Deliberately ordinary Zena: no async/gen syntax appears here, so this
 * module compiles with no bootstrapping problem. The `async`/`await`
 * surface lowers onto these types; from non-async code they are used
 * directly via callbacks.
 *
 * Semantics pinned here:
 * - A future settles exactly once; settling twice throws (`tryComplete`
 *   / `tryFail` report it instead, for callers racing on purpose).
 * - Callbacks always run from the FIFO microtask queue, never
 *   synchronously inside complete()/fail()/onComplete() — the
 *   "always async" rule, so completion order is deterministic and
 *   re-entrancy surprises are impossible.
 *
 * **Waiters pull.** There is one notification protocol, `Task`, and it
 * carries no type parameter: a settling future schedules its waiters and
 * each reads the settled result back with `:result()`. The alternative —
 * pushing the value to a typed listener — needs an object per waiter per
 * settle to carry the value across the queue hop, and makes the waiter
 * interface generic in the awaited type, so one async frame would need
 * an implementation per type it awaits. Pulling costs one field on a
 * waiter (the future it waits on, which a frame already spills anyway)
 * and allocates nothing at all when a future settles.
 *
 * The reads are keyed by symbols this module does not export, so a
 * future tells user code nothing synchronously: subscribing is the only
 * way to observe one, and `runFuture` the only way to unwrap one from
 * synchronous code. Symbols compare by identity, so a same-named symbol
 * declared elsewhere does not reach them.
 *
 * Implementation note (compiler limitation worked around, loud when
 * hit): no closures are created inside generic code here — RTA does not
 * yet specialize closure implementations per instantiation
 * ("non-concrete function reached") — which is why the combinators are
 * written with waiter objects rather than callbacks.
 */

import { Disposable } from 'zena:ownership';

/**
 * The runtime's own reads of a settled future, keyed by symbols this
 * module does not export so that no other module can name them
 * (docs/design/classes.md §9.4). User code observes a future by
 * subscribing to it, never by asking it what it holds — the affordance
 * that lets code branch on scheduling is the one worth withholding
 * (docs/design/async-runtime-shape.md, "Why hiding completion state is
 * worth it").
 *
 * The compiler is inside this boundary trivially: the split pass
 * resolves members by string, so it names `:valueOrThrow` directly.
 *
 * Enforced by symbol identity, not by name: declaring `symbol
 * valueOrThrow` in another module does not reach these
 * (`tests/language/semantics/async/private-settled-read.zena`).
 */
symbol result;
symbol failure;
symbol valueOrThrow;
/**
 * The settle side, keyed by the same unexported symbols: a reference
 * to a `Future` is read-only, and `Completer` is the write capability
 * (async.md §2 — everything external completes futures through one,
 * and there is no other way in). This module's own machinery — the
 * statics, the combinators, the frames the split pass synthesizes —
 * settles through the symbols directly.
 */
symbol complete;
symbol fail;
symbol tryComplete;
symbol tryFail;
symbol cancelComplete;
symbol childSettled;
symbol registerTask;
symbol install;
symbol checkpoint;
symbol shieldScope;

/** A future is Pending until it settles as Resolved or Rejected. */
export enum FutureState {
  /** Explicitly zero: the compiler's shielded-resume guard reads a
   * future's `#state` field directly and compares it to this value
   * (this module is not importable from the compiler, so the
   * dependency is by name and by this declared value). */
  Pending = 0,
  Resolved = 1,
  Rejected = 2,
  /** The work was cancelled before it produced a value or a failure.
   * Observing the result of a cancelled future raises on the
   * cancellation channel — being downstream of cancelled work is
   * inside the cancellation's blast radius
   * (docs/design/cancellation.md, "Observation at the boundary"). */
  Cancelled = 3,
}

// ---------------------------------------------------------------------------
// The executor: a FIFO queue of runnable tasks.
// ---------------------------------------------------------------------------

/**
 * One unit of queued work.
 *
 * The same type serves every role: a suspended async frame (the split
 * pass synthesizes an implementation per async function), a callback
 * bridge, a combinator's subscription, and a bare closure. Because a
 * waiter reads the settled value out of the future rather than being
 * handed it, this needs no type parameter, so one implementation per
 * frame serves every await site in a function whatever it awaits.
 */
export interface Task {
  run(): void;
}

/** Wraps a plain callback for non-generic callers. */
class ClosureTask implements Task {
  cb: () => void;
  new(this.cb);
  run(): void {
    let f = this.cb;
    f();
  }
}

class TaskQueue {
  #items = new GrowableArray<Task>();
  var #head = 0;

  schedule(task: Task): void {
    this.#items.push(task);
  }

  /** Runs queued tasks in FIFO order until the queue is empty
   * (including tasks scheduled while draining). */
  drain(): void {
    while (this.#head < this.#items.length) {
      let task = this.#items[this.#head];
      this.#head += 1;
      task.run();
    }
    // Empty: release the backlog so long drains don't accrete.
    while (this.#items.length > 0) {
      this.#items.pop();
    }
    this.#head = 0;
  }
}

let queue = new TaskQueue();

/**
 * A source of completions that arrive from outside the queue, and that
 * the drain loop can wait for (async.md §4, Level 1).
 *
 * The microtask queue alone can only run work that already exists. A
 * timer, or host I/O, settles a `Completer` at a moment nothing in the
 * queue can cause — so when the queue empties, the drain loop asks the
 * parker to block until the next such completion is ready.
 *
 * `park()` returns true if it delivered a completion (the drain loop
 * then runs the microtasks that produced and asks again) and false if
 * there is nothing outstanding to wait for. Returning false is what
 * ends the drain; a parker that always returns true never terminates.
 */
export interface Parker {
  park(): boolean;
}

/**
 * The one registered parker, or null when nothing external can
 * complete — which is the plain case, and the one the deadlock message
 * in `Future.valueOrThrow` describes.
 *
 * A single slot rather than a list, deliberately: waiting on several
 * sources means waiting on whichever is ready *first*, which a loop
 * over independent parkers gets wrong (it would block on the first one
 * while the second was already ready). When a target has more than one
 * source, it registers one parker that knows how to wait on all of
 * them — which is exactly what a host event loop already is.
 *
 * The mechanism does not enforce that premise: a second registration
 * silently replaces the first, which would strand whatever the first
 * one was waiting on. Only `zena:time`'s WASI entry registers today —
 * see async-runtime-shape.md, "Parking".
 */
var parker: Parker | null = null;

/** Register the drain loop's park source, replacing any previous one. */
export let setParker = (p: Parker): void => {
  parker = p;
};

/** Enqueue a task on the microtask queue. */
export let scheduleTask = (task: Task): void => {
  queue.schedule(task);
};

/** Enqueue a callback on the microtask queue. */
export let scheduleMicrotask = (cb: () => void): void => {
  queue.schedule(new ClosureTask(cb));
};

/**
 * Run microtasks until the queue is empty and nothing external is left
 * to wait for.
 *
 * With no parker registered this is exactly "drain the queue". With
 * one, an empty queue is not the end: the loop parks, and whatever
 * that delivers is drained in turn, until the parker reports nothing
 * outstanding.
 */
export let drainMicrotasks = (): void => {
  queue.drain();
  let p = parker;
  if (p != null) {
    let source = p as Parker;
    while (source.park()) {
      queue.drain();
    }
  }
};

/**
 * Raises on the cancellation channel: a second exception tag that
 * `catch (e)` cannot observe, so cancellation cannot be swallowed —
 * `finally`, `using`, and scope-drop regions still run their cleanup,
 * and the unwind then continues (docs/design/cancellation.md). This is
 * the raw raise the checkpoint machinery will emit; until `CancelScope`
 * lands there is no reason to call it directly.
 */
@intrinsic('cancel.raise')
export declare function raiseCancellation(): never;

// ---------------------------------------------------------------------------
// Cancellation scopes (docs/design/cancellation.md)
// ---------------------------------------------------------------------------

/**
 * The current scope: ordinary module state, changed at exactly two
 * kinds of control-transfer site — a frame's run() installs the
 * frame's scope around each step() (compiler-emitted, via
 * `:install`), and a scope's own `run` installs itself around its
 * body. Null until the root is constructed; `currentScope` resolves
 * null to the root.
 */
var current: CancelScope | null = null;

/**
 * The root scope: what `currentScope()` reports before any scope has
 * been entered. Constructed while the current scope is still null,
 * which is
 * what makes it parentless.
 */
let rootScope = new CancelScope();

/**
 * A cancellation scope: a level-triggered cancelled flag and a parent
 * link. Cancelling a scope marks it and every descendant, and every
 * checkpoint in a cancelled scope raises — however many already have.
 * Async frames bind to the current scope at creation and test it at
 * each checkpoint; sync code that wants to stop early polls
 * `currentScope()` explicitly.
 */
export class CancelScope {
  #parent: CancelScope | null;
  var #cancelled: boolean = false;
  #children = new GrowableArray<CancelScope>();
  /** The frames bound to this scope, registered by their ramps so
   * `cancel` can WAKE them: a parked frame's next checkpoint only
   * runs when something schedules it, and the future it awaits may
   * never settle. Scheduling is safe whatever the frame is doing —
   * a completed frame's step returns at its DONE guard, a running
   * frame has parked or completed by the time the queue reaches it,
   * and a parked frame's resume checkpoint tests the scope before
   * touching its still-pending future. The root registers nothing:
   * it cannot be cancelled, so uncancellable work pays no tracking. */
  #tasks = new GrowableArray<Task>();

  /** A child of the current scope, sharing its cancelled level. */
  new() : #parent = current {
    let p = this.#parent;
    if (p != null) {
      let parent = p as CancelScope;
      parent.#children.push(this);
      this.#cancelled = parent.#cancelled;
    }
  }

  /**
   * A scope with no parent, wherever it is created: cancelling any
   * other scope never reaches it, and only its holder can cancel it.
   * This is the scope for work that must outlive its callers — a
   * cache's shared fills, for example — where `new CancelScope()`
   * would quietly parent to whichever scope happens to be current at
   * construction.
   */
  static detached(): CancelScope {
    // The constructor reads the current scope; hide it for the one
    // construction. Single-threaded, and nothing between the two
    // writes can observe the slot.
    let prev = current;
    current = null;
    let scope = new CancelScope();
    current = prev;
    return scope;
  }

  isCancelled: boolean {
    get {
      return this.#cancelled;
    }
  }

  /**
   * Marks this scope and every descendant cancelled. Code between
   * checkpoints is never interrupted: each frame bound to a marked
   * scope raises at its next checkpoint. The root scope cannot be
   * cancelled — code that started before any scope existed belongs to
   * it, and cancelling everything is not a meaningful request.
   */
  cancel(): void {
    if (this == rootScope) {
      throw new Error('The root scope cannot be cancelled');
    }
    if (this.#cancelled) {
      return;
    }
    this.#cancelled = true;
    // Wake every registered task, so a parked frame runs its next
    // checkpoint and observes the cancellation.
    while (this.#tasks.length > 0) {
      scheduleTask(this.#tasks.pop());
    }
    for (let child in this.#children) {
      child.cancel();
    }
  }

  /**
   * Registers `t` to be scheduled when this scope is cancelled. The
   * compiler emits a call in every async function's ramp with the new
   * frame as the task: a frame parked on a future that never settles
   * would otherwise never reach the checkpoint that delivers its
   * cancellation. The root never cancels, so frames bound to it are
   * not tracked; an already-cancelled scope needs no wake either,
   * because the frame raises at its first checkpoint.
   */
  :registerTask(t: Task): void {
    if (this == rootScope || this.#cancelled) {
      return;
    }
    this.#tasks.push(t);
  }

  /**
   * Makes this scope the current scope and returns the one it
   * replaced. Compiler-emitted code is the only caller, always in
   * pairs: a frame's run() installs the frame's scope, calls step(),
   * then installs the returned previous scope again, and `shielded`
   * regions do the same around their extent. The pairs nest strictly
   * — the executor runs one task at a time, and installs happen only
   * on the way into and out of a region — so the saved previous
   * scopes on the callers' stacks are the stack; no separate
   * structure is needed.
   */
  :install(): CancelScope {
    let p = current;
    current = this;
    return if (p != null) p else rootScope;
  }

  /**
   * Raises on the cancellation channel if this scope has been
   * cancelled, and does nothing otherwise. The compiler calls this at
   * each suspension point — on entering an await and on resuming from
   * one. Those calls are the only places cancellation is delivered.
   */
  :checkpoint(): void {
    if (this.#cancelled) {
      raiseCancellation();
    }
  }

  /**
   * The scope `shielded { }` regions run under: the root, which no
   * cancellation reaches, so shielded cleanup and any work it starts
   * run to completion. Level-triggering resumes at the region's
   * closing brace.
   */
  :shieldScope(): CancelScope {
    return rootScope;
  }

  /**
   * Runs `body` with this scope as the current scope, so async
   * frames created inside bind to it. Eager start does the
   * inheritance: a frame's ramp runs synchronously here, reads the
   * current scope once, and stores it — after creation the frame
   * never consults it again.
   */
  run(body: () => void): void {
    let prev = current;
    current = this;
    try {
      body();
    } finally {
      current = prev;
    }
  }
}

/** The scope new async work would bind to; sync code polls this to
 * stop early without any signature change. */
export let currentScope = (): CancelScope => {
  let s = current;
  return if (s != null) s as CancelScope else rootScope;
};

// ---------------------------------------------------------------------------
// Future / Completer
// ---------------------------------------------------------------------------

export class Future<T> {
  /** Read by name by the compiler's shielded-resume guard — see the
   * note on `FutureState.Pending`. */
  var #state = FutureState.Pending;
  var #value: Box<T> | null = null;
  var #error: Error | null = null;
  /** The single waiter, which is the overwhelmingly common case: an
   * awaited future has exactly one frame parked on it. */
  var #waiter: Task | null = null;
  /** Waiters beyond the first. Null until a second one arrives, so an
   * ordinary future allocates no list and no backing storage. */
  var #more: GrowableArray<Task> | null = null;

  new();

  state: FutureState {
    get {
      return this.#state;
    }
  }

  isCompleted: boolean {
    get {
      return !(this.#state == FutureState.Pending);
    }
  }

  /**
   * The settled result: `(true, value, _)` or `(false, _, error)`.
   *
   * Throws if this future is still pending. At an async resume point
   * that cannot happen — the frame only runs once its future has
   * settled — so reaching it means the queue drained with work still
   * parked and nothing left that could complete it: a deadlock
   * (async.md §4).
   */
  :result(): inline (true, T, _) | inline (false, _, Error) {
    if (this.#state == FutureState.Rejected) {
      return (false, _, this.#error as Error);
    }
    if (this.#state == FutureState.Cancelled) {
      raiseCancellation();
    }
    if (this.#state == FutureState.Pending) {
      throw new Error(
        'Deadlock: the microtask queue is empty but this future is ' +
        'still pending, and no external completion source exists');
    }
    let stored = this.#value as Box<T>;
    return (true, stored.value, _);
  }

  /**
   * The stored failure, or null if this future resolved.
   *
   * `result()` says the same thing and says it better — the tag cannot
   * be separated from the payload there. This exists because a
   * zero-width `T` does not lower in an inline-tuple lane, so
   * `Future<void>.result()` bails ("method result type"), and the
   * library's own waiters have to work at every `T`. Retire it when
   * void lanes lower.
   */
  :failure(): Error | null {
    if (this.#state == FutureState.Cancelled) {
      raiseCancellation();
    }
    if (this.#state == FutureState.Pending) {
      throw new Error(
        'Deadlock: the microtask queue is empty but this future is ' +
        'still pending, and no external completion source exists');
    }
    return this.#error;
  }

  /**
   * Registers a waiter: `t.run()` runs from the microtask queue once
   * this future settles (scheduled immediately if it already has — the
   * always-async rule holds here too, so a frame awaiting a completed
   * future still yields one queue hop).
   *
   * This is what the `await` transform emits. It is deliberately
   * untyped in T: the waiter reads the settled result back with
   * `result()` when it runs.
   */
  subscribe(t: Task): void {
    if (!(this.#state == FutureState.Pending)) {
      scheduleTask(t);
      return;
    }
    if (this.#waiter == null) {
      this.#waiter = t;
      return;
    }
    if (this.#more == null) {
      this.#more = new GrowableArray<Task>();
    }
    (this.#more as GrowableArray<Task>).push(t);
  }

  /**
   * Low-level subscription: exactly one of the callbacks runs, from the
   * microtask queue, once this future settles (scheduled immediately if
   * it already has). This is the bridge for non-async code.
   */
  onComplete(
    onValue: (value: T) => void,
    onError: (error: Error) => void
  ): void {
    // `this as Future<T>`: inside a generic class's own method `this`
    // types as the raw template `Future`, so the cast is what names the
    // instantiation. Same idiom as `AllState.attach` below.
    this.subscribe(
      new CallbackTask<T>(this as Future<T>, onValue, onError));
  }

  /**
   * The settled value, or a throw of the stored failure.
   *
   * Async frames call this at each resume point, which is what makes a
   * failed await propagate as an ordinary exception: it unwinds into
   * step()'s failure-capture region and rejects the frame's own
   * future, with no separate error slot to thread (async.md §3).
   *
   * Reads the fields directly rather than going through `result()`:
   * this is the hot path, once per await, and rethrowing the error arm
   * would need the both-arms narrowing `CallbackTask` works around.
   */
  :valueOrThrow(): T {
    if (this.#state == FutureState.Rejected) {
      throw this.#error as Error;
    }
    if (this.#state == FutureState.Cancelled) {
      // Awaiting cancelled work is being downstream of it: raise on
      // the cancellation channel, exactly as a checkpoint does. This
      // is the one hook that makes a cancellation propagate from a
      // frame to its awaiters — each resume calls this.
      raiseCancellation();
    }
    if (this.#state == FutureState.Pending) {
      throw new Error(
        'Deadlock: the microtask queue is empty but this future is ' +
        'still pending, and no external completion source exists');
    }
    let stored = this.#value as Box<T>;
    return stored.value;
  }

  /** Settles this future with a value. Throws if already settled. */
  :complete(value: T): void {
    if (!this.:tryComplete(value)) {
      throw new Error('Future already completed');
    }
  }

  /** Settles this future with a value, reporting whether it won.
   * False means someone else settled it first, which is not an error
   * for a caller racing on purpose. */
  :tryComplete(value: T): boolean {
    if (!(this.#state == FutureState.Pending)) {
      return false;
    }
    this.#state = FutureState.Resolved;
    this.#value = new Box<T>(value);
    this.#notify();
    return true;
  }

  /** Settles this future with a failure. Throws if already settled. */
  :fail(error: Error): void {
    if (!this.:tryFail(error)) {
      throw new Error('Future already completed');
    }
  }

  /** Settles this future with a failure, reporting whether it won. */
  :tryFail(error: Error): boolean {
    if (!(this.#state == FutureState.Pending)) {
      return false;
    }
    this.#state = FutureState.Rejected;
    this.#error = error;
    this.#notify();
    return true;
  }

  /**
   * Settles this future as cancelled: no value and no error, and
   * every observer raises on the cancellation channel when it looks.
   * This is what step()'s cancellation capture calls when a
   * cancellation unwinds an async frame; the frame's waiters resume
   * and re-raise at their own checkpoints, which is how the unwind
   * continues across frames without a shared stack. Throws if already
   * settled — a frame that is still running cannot have settled its
   * own future.
   */
  :cancelComplete(): void {
    if (!(this.#state == FutureState.Pending)) {
      throw new Error('Future already completed');
    }
    this.#state = FutureState.Cancelled;
    this.#notify();
  }

  /**
   * Moves every waiter onto the queue and drops the list.
   *
   * Allocates nothing: the waiters were registered as themselves, so
   * there is no delivery object to mint, and the overflow list is
   * dropped rather than cleared.
   */
  #notify(): void {
    let w = this.#waiter;
    if (w != null) {
      this.#waiter = null;
      scheduleTask(w as Task);
    }
    let m = this.#more;
    if (m != null) {
      let list = m as GrowableArray<Task>;
      this.#more = null;
      var i = 0;
      while (i < list.length) {
        scheduleTask(list[i]);
        i += 1;
      }
    }
  }

  // -------------------------------------------------------------------
  // Constructors and combinators
  // -------------------------------------------------------------------
  //
  // Each static declares its OWN type parameter `A`: a static is outside
  // its class's generic scope, so `T` does not name anything here.

  /** An already-resolved future. */
  static of<A>(value: A): Future<A> {
    let f = new Future<A>();
    f.:complete(value);
    return f;
  }

  /** An already-failed future. */
  static failed<A>(error: Error): Future<A> {
    let f = new Future<A>();
    f.:fail(error);
    return f;
  }

  /**
   * A future of every input's value, in **input order** regardless of
   * the order they settle in — or of the first failure to arrive.
   *
   * The failure is reported as soon as it happens, without waiting for
   * the other inputs: once one has failed no combined value can exist,
   * so waiting could only delay the answer, and would hang outright if
   * another input never settles. Inputs that settle after that are
   * ignored — they lost a race that was already decided, which is not
   * an error.
   *
   * With no inputs the result is an empty array. It still settles
   * through the microtask queue like everything else (the always-async
   * rule), so `all` never runs a continuation before its caller
   * returns.
   *
   * Futures are eager, so the inputs are already running when they get
   * here: this waits for them, it does not start them.
   */
  static all<A>(futures: Array<Future<A>>): Future<Array<A>> {
    return new AllState<A>().attach(futures);
  }

  /**
   * A future settling as the **first input to settle** does — with its
   * value, or with its failure. A failure wins a race exactly the way a
   * value does; use it when the first answer is the answer, and note
   * that the losers keep running (nothing here cancels them; that waits
   * on cancellation).
   *
   * Throws on an empty array rather than returning a future. A race
   * with nothing in it can never settle, and a future that never
   * settles surfaces much later as a deadlock report naming the
   * awaiting code, so the mistake is refused where it was made.
   */
  static race<A>(futures: Array<Future<A>>): Future<A> {
    if (futures.length == 0) {
      throw new Error(
        'Future.race: needs at least one future; a race with no inputs ' +
        'can never settle');
    }
    return new RaceState<A>().attach(futures);
  }
}

/**
 * A completer with its payload type erased.
 *
 * This exists so a collection can hold completers for different `T` —
 * which is what `zena:js`'s handle registry is. A base class
 * rather than an interface, deliberately and not by preference: a value
 * held as an interface cannot be tested or downcast back to its concrete
 * type today (`x is Plain` answers *false* through an interface
 * reference, for generic and non-generic classes alike — see BUGS.md).
 * Through a base class it works, and it distinguishes specializations
 * exactly: a `Completer<String>` held as `AnyCompleter` tests true for
 * `Completer<String>` and false for `Completer<i32>`, `Completer<f64>`,
 * and `Completer<SomeOtherClass>` alike.
 *
 * That is what makes the registry need no type tag of its own. The
 * completer's own specialized type *is* the tag, checked by the same
 * `ref.cast` the language already emits.
 *
 * `fail` is declared here because failing needs no payload: a caller
 * that only knows the erased completer can still reject it.
 */
export class AnyCompleter {
  new();

  /** Rejects the underlying future. Overridden by `Completer<T>`. */
  fail(_error: Error): void {
    throw new Error('AnyCompleter.fail: not a completer');
  }
}

/**
 * The boundary object: everything external — host I/O, timers, test
 * harnesses — completes futures through a Completer.
 */
export class Completer<T> extends AnyCompleter {
  future = new Future<T>();

  new() : super();

  complete(value: T): void {
    this.future.:complete(value);
  }

  fail(error: Error): void {
    this.future.:fail(error);
  }

  /** Settles with a value, reporting whether it won. False means
   * someone else settled first — not an error for a caller racing on
   * purpose. */
  tryComplete(value: T): boolean {
    return this.future.:tryComplete(value);
  }

  /** Settles with a failure, reporting whether it won. */
  tryFail(error: Error): boolean {
    return this.future.:tryFail(error);
  }
}

/**
 * A waiter built from a pair of callbacks (`onComplete`).
 *
 * Holding the future it reads is what a pulling waiter needs: the future
 * hands a waiter nothing, so the waiter keeps the reference it reads back
 * through.
 */
class CallbackTask<T> implements Task {
  future: Future<T>;
  valueCb: (value: T) => void;
  errorCb: (error: Error) => void;
  new(this.future, this.valueCb, this.errorCb);
  run(): void {
    let f = this.future;
    // `:failure()` + `:valueOrThrow()` rather than `:result()`: this
    // class specializes at `T = void` too, and a zero-width lane does
    // not lower in an inline tuple.
    let e = f.:failure();
    if (e == null) {
      let ok = this.valueCb;
      ok(f.:valueOrThrow());
      return;
    }
    let bad = this.errorCb;
    bad(e as Error);
  }
}

/**
 * Runs the executor to a standstill and returns `f`'s value, throwing
 * its failure.
 *
 * The public way to get a value out of a future from synchronous code,
 * and deliberately the only one: it cannot answer before the queue has
 * run, so there is no way to observe whether something settled "early".
 * If `f` is still pending once nothing more can happen, that is a
 * deadlock and it throws saying so.
 *
 * Top-level only — a driver, a test, `main`. Calling it from inside a
 * task would re-enter the drain and break run-to-completion.
 */
export let runFuture = <T>(f: Future<T>): T => {
  drainMicrotasks();
  return f.:valueOrThrow();
};

// ---------------------------------------------------------------------------
// Combinators
// ---------------------------------------------------------------------------
//
// Ordinary library code over `subscribe`, as async.md §2 says they would
// be: no primitive, no compiler support, nothing the executor has to
// know about. They are written with waiter OBJECTS rather than closures
// for the reason the module header gives — a closure created inside
// generic code is not specialized per instantiation and fails to lower —
// which is also why each carries its own small state class instead of
// capturing one.
//
// Both are written against `subscribe` rather than as async functions
// awaiting their inputs in turn, and the difference is semantic, not
// stylistic: awaiting in sequence would wait on futures whose result
// can no longer matter, so a rejected input would be reported only
// after every input ahead of it settled — and never at all if one of
// them never settles.
//
// Because waiters pull, neither combinator stores the values it is
// waiting for: the inputs hold them, in input order, and `allOf` reads
// them back once the last one lands.

/** Shared state for one `allOf` call: the inputs, how many are still
 * outstanding, and the future they all settle. */
class AllState<T> {
  result = new Future<Array<T>>();
  inputs = new GrowableArray<Future<T>>();
  var remaining = 0;

  new();

  /**
   * Subscribes to every input and hands back the combined future.
   *
   * This lives on the state class rather than in `Future.all` itself
   * because the waiters are interface implementations, and a body
   * specialized on its OWN type parameter does not get the interface
   * vtable for a class it instantiates ("interface vtable global not
   * found") — whereas a generic class's own method does. That covers a
   * generic free function and a static alike; inlining this into
   * `Future.race` was tried after the statics landed and bails. Same
   * reason as the closure restriction the module header describes:
   * what works depends on where the generic code lives.
   */
  attach(futures: Array<Future<T>>): Future<Array<T>> {
    this.remaining = futures.length;
    if (futures.length == 0) {
      this.result.:complete(new GrowableArray<T>());
      return this.result;
    }
    var i = 0;
    while (i < futures.length) {
      this.inputs.push(futures[i]);
      i += 1;
    }
    // Subscribing cannot deliver synchronously, so `remaining` and the
    // inputs above are necessarily in place before any waiter runs.
    // The cast on `this` is the raw-template-type gap in BUGS.md: in a
    // generic class's own method `this` checks as `AllState`, not
    // `AllState<T>`.
    i = 0;
    while (i < futures.length) {
      futures[i].subscribe(new AllWaiter<T>(this as AllState<T>, i));
      i += 1;
    }
    return this.result;
  }

  /** Counts one input in; on the last, reads every input's value back
   * in input order. No slot array and no box per value: the inputs are
   * the storage. */
  report(): void {
    if (this.result.isCompleted) {
      return;
    }
    this.remaining -= 1;
    if (this.remaining == 0) {
      let values = new GrowableArray<T>();
      var i = 0;
      while (i < this.inputs.length) {
        values.push(this.inputs[i].:valueOrThrow());
        i += 1;
      }
      this.result.:complete(values);
    }
  }

  /** The first failure settles the whole thing; later ones are spent. */
  reject(error: Error): void {
    this.result.:tryFail(error);
  }
}

/** One input's subscription into an `AllState`.
 *
 * Carries the input's index rather than the future itself. Either works
 * and both are one field; the index is what `report` would need anyway,
 * since `all` has to keep every input to read the values back in order. */
class AllWaiter<T> implements Task {
  state: AllState<T>;
  index: i32;
  new(this.state, this.index);
  run(): void {
    let f = this.state.inputs[this.index];
    // `:failure()` for the reason CallbackTask documents.
    let e = f.:failure();
    if (e == null) {
      this.state.report();
      return;
    }
    this.state.reject(e as Error);
  }
}

/** Shared state for one `Future.race` call: whoever settles first wins. */
class RaceState<T> {
  result = new Future<T>();

  new();

  /** Subscribes every input. On the state class for the same reason
   * `AllState.attach` is. */
  attach(futures: Array<Future<T>>): Future<T> {
    // One waiter per input rather than one shared between them: a
    // pulling waiter has to know which future to read, and a race does
    // not otherwise care which settled. Unlike `AllState`, nothing here
    // needs the inputs afterwards — the winner's waiter carries the one
    // future anyone will read — so a race keeps no input list. `this`
    // is cast for the same reason as in AllState.attach.
    var i = 0;
    while (i < futures.length) {
      futures[i].subscribe(
        new RaceWaiter<T>(this as RaceState<T>, futures[i]));
      i += 1;
    }
    return this.result;
  }

  win(value: T): void {
    this.result.:tryComplete(value);
  }

  lose(error: Error): void {
    this.result.:tryFail(error);
  }
}

/** One input's subscription into a `RaceState`, holding the input it
 * reads. */
class RaceWaiter<T> implements Task {
  state: RaceState<T>;
  future: Future<T>;
  new(this.state, this.future);
  run(): void {
    let f = this.future;
    let e = f.:failure();
    if (e == null) {
      this.state.win(f.:valueOrThrow());
      return;
    }
    this.state.lose(e as Error);
  }
}

// Note: no generic `MaybeFuture<T> = T | Future<T>` alias — Zena
// rejects unions mixing an unbounded type parameter with reference
// types (T could be a primitive). Concrete unions like
// `i32 | Future<i32>` work directly, and `await` accepts them
// (async.md §1).

// ---------------------------------------------------------------------------
// TaskGroup: the structured half (docs/design/cancellation.md)
// ---------------------------------------------------------------------------

/**
 * The task a group subscribes to each future it watches: when the
 * future settles, `run` reads whether it failed and reports that to
 * the group. It reads `state` before touching the result, because
 * reading a cancelled future's result raises on the cancellation
 * channel — and the group needs to record that outcome, not unwind.
 */
class GroupWaiter<T> implements Task {
  group: TaskGroup;
  future: Future<T>;
  new(this.group, this.future);
  run(): void {
    let f = this.future;
    var err: Error | null = null;
    if (f.state == FutureState.Rejected) {
      err = f.:failure();
    }
    this.group.:childSettled(err);
  }
}

/**
 * A group of async calls that are cancelled and awaited together.
 *
 * `spawn` starts a call and makes it a member: the group holds one
 * `CancelScope`, each member's frame binds to that scope, and the
 * group watches each member's future. `cancel` cancels every member;
 * one member's failure cancels the rest; and `join` gives a future
 * that completes once every member has settled — failing with the
 * first member failure, if there was one. A member that ends
 * cancelled is a recorded outcome, not an error.
 */
export class TaskGroup {
  /** The group's scope: a child of the scope current at construction,
   * so cancelling an ancestor cancels the group's children too. */
  #scope = new CancelScope();
  var #outstanding: i32 = 0;
  var #firstError: Error | null = null;
  var #joinWaiter: Completer<void> | null = null;

  new();

  isCancelled: boolean {
    get {
      return this.#scope.isCancelled;
    }
  }

  /** Cancels every child (and work they spawned): marks the group's
   * scope, so each child raises at its next checkpoint. */
  cancel(): void {
    this.#scope.cancel();
  }

  /**
   * Starts `body` as a member of the group. The call begins here,
   * synchronously, with the group's scope installed as current,
   * so the new frame binds to it. The returned future is an ordinary
   * future — anyone may await it — and the group watches it either
   * way.
   */
  spawn<T>(body: () => Future<T>): Future<T> {
    this.#outstanding += 1;
    let prev = current;
    current = this.#scope;
    var fut: Future<T> | null = null;
    try {
      fut = body();
    } finally {
      current = prev;
    }
    let f = fut as Future<T>;
    f.subscribe(new GroupWaiter<T>(this, f));
    return f;
  }

  :childSettled(err: Error | null): void {
    if (err != null && this.#firstError == null) {
      // One member's failure cancels the rest; the error itself
      // surfaces at join, once.
      this.#firstError = err;
      this.#scope.cancel();
    }
    this.#outstanding -= 1;
    if (this.#outstanding == 0) {
      let w = this.#joinWaiter;
      if (w != null) {
        this.#joinWaiter = null;
        this.#settle(w);
      }
    }
  }

  #settle(c: Completer<void>): void {
    let e = this.#firstError;
    if (e != null) {
      c.fail(e);
    } else {
      c.complete();
    }
  }

  /**
   * A future that completes once every member has settled — failing
   * with the first member failure, if there was one. Joins while
   * members are outstanding share one future. A join with nothing
   * outstanding gets a fresh, already-settled future: settling and
   * keeping the shared completer instead would break a group that
   * spawns again after going idle, whose next drain would settle it a
   * second time.
   */
  join(): Future<void> {
    if (this.#outstanding == 0) {
      let c = new Completer<void>();
      this.#settle(c);
      return c.future;
    }
    let w = this.#joinWaiter ??= new Completer<void>();
    return w.future;
  }

  /**
   * Runs every body as a member of a fresh group and gives the first
   * settled outcome — value or failure — cancelling the rest. This is
   * the loser-cancelling form of `Future.race`: `race` over
   * already-started futures ignores its losers, because it does not
   * own them, while this form starts the candidates itself and so may
   * cancel the ones that lost. If cancellation instead arrives from
   * outside — an ancestor scope cancels the group before any
   * candidate settles — the returned future completes cancelled.
   *
   * An empty array is refused: its future could never settle.
   */
  static race<A>(bodies: Array<() => Future<A>>): Future<A> {
    if (bodies.length == 0) {
      throw new Error('TaskGroup.race needs at least one candidate');
    }
    let group = new TaskGroup();
    let state = new RaceGroupState<A>(group, bodies.length);
    for (let body in bodies) {
      let f = group.spawn(body);
      f.subscribe(new RaceGroupWaiter<A>(state, f));
    }
    return state.result;
  }
}

/**
 * What a loser-cancelling race's watchers share: the group holding
 * the candidates and the future the race settles.
 */
class RaceGroupState<T> {
  group: TaskGroup;
  result = new Future<T>();
  /** Candidates that have not ended cancelled. When it reaches zero
   * with no winner, cancellation came from outside the race, and the
   * race's own future completes cancelled too. */
  var #undecided: i32;
  new(this.group, count: i32) : #undecided = count;

  /** Called once per candidate, when it settles. */
  settled(f: Future<T>): void {
    if (f.state == FutureState.Cancelled) {
      this.#undecided -= 1;
      if (this.#undecided == 0 && this.result.state == FutureState.Pending) {
        this.result.:cancelComplete();
      }
      return;
    }
    // A value or a failure. The first one settles the race; the rest
    // lose. tryComplete/tryFail make the settle first-wins, and
    // cancelling an already-cancelled group does nothing.
    let e = f.:failure();
    if (e == null) {
      this.result.:tryComplete(f.:valueOrThrow());
    } else {
      this.result.:tryFail(e as Error);
    }
    this.group.cancel();
  }
}

/** One candidate's subscription into a `RaceGroupState`, holding the
 * future it reads — the same shape as `RaceWaiter`. */
class RaceGroupWaiter<T> implements Task {
  state: RaceGroupState<T>;
  future: Future<T>;
  new(this.state, this.future);
  run(): void {
    this.state.settled(this.future);
  }
}

// ---------------------------------------------------------------------------
// FutureClaim: consumer interest (docs/design/cancellation.md)
// ---------------------------------------------------------------------------

/**
 * The claim count behind a set of `FutureClaim` handles: how many
 * handles have not been released, and the scope to cancel when the
 * count reaches zero. Not generic — the release path runs inside
 * `FutureClaim<T>`'s methods, and keeping the count on a plain class
 * means no closures are created in generic code (the same constraint
 * the combinators live under). It is its own deferred zero check:
 * releasing the last claim schedules the Interest itself, so a
 * release allocates nothing.
 */
class Interest implements Task {
  scope: CancelScope;
  var count: i32 = 1;
  new(this.scope);

  release(): void {
    this.count -= 1;
    if (this.count == 0) {
      // Deferred one queue turn rather than cancelling here, so a
      // release never cancels from inside the releaser's stack, and a
      // handoff that re-establishes interest in the same turn never
      // observes the transient zero.
      scheduleTask(this);
    }
  }

  /** The deferred check: if the count is still zero a turn after it
   * got there, nobody holds a claim, and the work is cancelled. */
  run(): void {
    if (this.count == 0 && !this.scope.isCancelled) {
      this.scope.cancel();
    }
  }
}

/**
 * A future plus a counted claim on the work producing it. Work
 * spawned on behalf of several consumers should keep running while
 * any of them still wants the result and stop when none does; holding
 * an `FutureClaim` is declaring that want. Releasing the handle —
 * `using`, `:dispose`, or an explicit `release()` — gives the claim
 * up, and when the last claim is gone the work's scope is cancelled,
 * one queue turn later.
 *
 * Sharing is an explicit `split()`: the count goes up before the
 * second handle exists, so claims never pass through zero during a
 * handoff. Releasing is per-handle and idempotent.
 *
 * The bare `future` stays an ordinary value. Holding it confers
 * awaiting and nothing else: if every claim is released, a bystander
 * mid-await gets the cancellation raise at its checkpoint. Awaiting
 * without holding a claim is awaiting at the claim holders' pleasure
 * — which is the honest version of the contract, and why nothing on
 * `Future` itself can cancel.
 */
export class FutureClaim<T> implements Disposable {
  future: Future<T>;
  #interest: Interest;
  var #released: boolean = false;

  new(this.future, interest: Interest) : #interest = interest;

  /**
   * Starts `body` as owned work: the call runs under a new scope — a
   * child of the current scope, so enclosing cancellation still
   * reaches it — and the returned handle carries the one initial
   * claim. Work that must not inherit the caller's cancellation runs
   * the spawn under `CancelScope.detached()`.
   */
  static spawn<A>(body: () => Future<A>): FutureClaim<A> {
    let scope = new CancelScope();
    let prev = current;
    current = scope;
    var fut: Future<A> | null = null;
    try {
      fut = body();
    } finally {
      current = prev;
    }
    return new FutureClaim<A>(fut as Future<A>, new Interest(scope));
  }

  /** Whether this handle still holds its claim. */
  isReleased: boolean {
    get {
      return this.#released;
    }
  }

  /**
   * A second claim on the same work. Throws if this handle was
   * already released — a released handle has nothing to share.
   */
  split(): FutureClaim<T> {
    if (this.#released) {
      throw new Error('FutureClaim was already released');
    }
    this.#interest.count += 1;
    return new FutureClaim<T>(this.future, this.#interest);
  }

  /**
   * Gives this handle's claim up. Releasing the last claim cancels
   * the work's scope one queue turn later. Idempotent, per handle.
   */
  release(): void {
    if (this.#released) {
      return;
    }
    this.#released = true;
    this.#interest.release();
  }

  :Disposable.dispose(): void {
    this.release();
  }
}
