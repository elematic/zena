/**
 * zena:async — Future<T>, Completer<T>, and the microtask executor
 * (docs/design/async.md §2, docs/design/async-runtime-shape.md).
 *
 * Deliberately ordinary Zena: no async/gen syntax appears here, so this
 * module compiles with no bootstrapping problem. The `async`/`await`
 * surface lowers onto these types; from non-async code they are used
 * directly via callbacks.
 *
 * Semantics pinned here:
 * - A future settles exactly once; settling twice throws (`tryComplete`
 *   / `tryFail` report it instead, for callers racing on purpose).
 * - Callbacks always run from the FIFO microtask queue, never
 *   synchronously inside complete()/fail()/onComplete() — the
 *   "always async" rule, so completion order is deterministic and
 *   re-entrancy surprises are impossible.
 *
 * **Waiters pull.** There is one notification protocol, `Task`, and it
 * carries no type parameter: a settling future schedules its waiters and
 * each reads the settled result back with `:result()`. The alternative —
 * pushing the value to a typed listener — needs an object per waiter per
 * settle to carry the value across the queue hop, and makes the waiter
 * interface generic in the awaited type, so one async frame would need
 * an implementation per type it awaits. Pulling costs one field on a
 * waiter (the future it waits on, which a frame already spills anyway)
 * and allocates nothing at all when a future settles.
 *
 * The reads are keyed by symbols this module does not export, so a
 * future tells user code nothing synchronously: subscribing is the only
 * way to observe one, and `runFuture` the only way to unwrap one from
 * synchronous code. (Not yet enforced — BUGS.md, "Symbol-keyed members
 * resolve by name".)
 *
 * Implementation note (compiler limitations worked around, loud when
 * hit): no closures are created inside generic code here — RTA does not
 * yet specialize closure implementations per instantiation
 * ("non-concrete function reached") — and a generic class cannot receive
 * a `Future<T>` by any direct spelling, so waiters reach theirs by index
 * or through a one-element array (BUGS.md, "A generic class cannot
 * receive a `Future<T>`").
 */
import { Array } from 'zena:array';
import { Box } from 'zena:box';
import { Error } from 'zena:error';

/**
 * The runtime's own reads of a settled future, keyed by symbols this
 * module does not export so that no other module can name them
 * (docs/design/classes.md §9.4). User code observes a future by
 * subscribing to it, never by asking it what it holds — the affordance
 * that lets code branch on scheduling is the one worth withholding
 * (docs/design/async-runtime-shape.md, "Why hiding completion state is
 * worth it").
 *
 * The compiler is inside this boundary trivially: the split pass
 * resolves members by string, so it names `:valueOrThrow` directly.
 *
 * **This is not enforced yet.** Symbol-keyed members resolve by the
 * symbol's source name, so a determined caller can still write
 * `f.:valueOrThrow()` — see BUGS.md, "Symbol-keyed members resolve by
 * name". Nothing here depends on the fix; it makes the boundary real.
 */
symbol result;
symbol failure;
symbol valueOrThrow;

/** A future is Pending until it settles as Resolved or Rejected. */
export enum FutureState {
  Pending,
  Resolved,
  Rejected,
}

// ---------------------------------------------------------------------------
// The executor: a FIFO queue of runnable tasks.
// ---------------------------------------------------------------------------

/**
 * One unit of queued work.
 *
 * The same type serves every role: a suspended async frame (the split
 * pass synthesizes an implementation per async function), a callback
 * bridge, a combinator's subscription, and a bare closure. Because a
 * waiter reads the settled value out of the future rather than being
 * handed it, this needs no type parameter, so one implementation per
 * frame serves every await site in a function whatever it awaits.
 */
export interface Task {
  run(): void;
}

/** Wraps a plain callback for non-generic callers. */
class ClosureTask implements Task {
  cb: () => void;
  new(this.cb);
  run(): void {
    let f = this.cb;
    f();
  }
}

class TaskQueue {
  #items = new Array<Task>();
  var #head = 0;

  schedule(task: Task): void {
    this.#items.push(task);
  }

  /** Runs queued tasks in FIFO order until the queue is empty
   * (including tasks scheduled while draining). */
  drain(): void {
    while (this.#head < this.#items.length) {
      let task = this.#items[this.#head];
      this.#head += 1;
      task.run();
    }
    // Empty: release the backlog so long drains don't accrete.
    while (this.#items.length > 0) {
      this.#items.pop();
    }
    this.#head = 0;
  }
}

let queue = new TaskQueue();

/**
 * A source of completions that arrive from outside the queue, and that
 * the drain loop can wait for (async.md §4, Level 1).
 *
 * The microtask queue alone can only run work that already exists. A
 * timer, or host I/O, settles a `Completer` at a moment nothing in the
 * queue can cause — so when the queue empties, the drain loop asks the
 * parker to block until the next such completion is ready.
 *
 * `park()` returns true if it delivered a completion (the drain loop
 * then runs the microtasks that produced and asks again) and false if
 * there is nothing outstanding to wait for. Returning false is what
 * ends the drain; a parker that always returns true never terminates.
 */
export interface Parker {
  park(): boolean;
}

/**
 * The one registered parker, or null when nothing external can
 * complete — which is the plain case, and the one the deadlock message
 * in `Future.valueOrThrow` describes.
 *
 * A single slot rather than a list, deliberately: waiting on several
 * sources means waiting on whichever is ready *first*, which a loop
 * over independent parkers gets wrong (it would block on the first one
 * while the second was already ready). When a target has more than one
 * source, it registers one parker that knows how to wait on all of
 * them — which is exactly what a host event loop already is.
 *
 * The mechanism does not enforce that premise: a second registration
 * silently replaces the first, which would strand whatever the first
 * one was waiting on. Only `zena:time`'s WASI entry registers today —
 * see async-runtime-shape.md, "Parking".
 */
var parker: Parker | null = null;

/** Register the drain loop's park source, replacing any previous one. */
export let setParker = (p: Parker): void => {
  parker = p;
};

/** Enqueue a task on the microtask queue. */
export let scheduleTask = (task: Task): void => {
  queue.schedule(task);
};

/** Enqueue a callback on the microtask queue. */
export let scheduleMicrotask = (cb: () => void): void => {
  queue.schedule(new ClosureTask(cb));
};

/**
 * Run microtasks until the queue is empty and nothing external is left
 * to wait for.
 *
 * With no parker registered this is exactly "drain the queue". With
 * one, an empty queue is not the end: the loop parks, and whatever
 * that delivers is drained in turn, until the parker reports nothing
 * outstanding.
 */
export let drainMicrotasks = (): void => {
  queue.drain();
  let p = parker;
  if (p != null) {
    let source = p as Parker;
    while (source.park()) {
      queue.drain();
    }
  }
};

// ---------------------------------------------------------------------------
// Future / Completer
// ---------------------------------------------------------------------------

export class Future<T> {
  var #state = FutureState.Pending;
  var #value: Box<T> | null = null;
  var #error: Error | null = null;
  /** The single waiter, which is the overwhelmingly common case: an
   * awaited future has exactly one frame parked on it. */
  var #waiter: Task | null = null;
  /** Waiters beyond the first. Null until a second one arrives, so an
   * ordinary future allocates no list and no backing storage. */
  var #more: Array<Task> | null = null;

  new();

  state: FutureState {
    get {
      return this.#state;
    }
  }

  isCompleted: boolean {
    get {
      return !(this.#state == FutureState.Pending);
    }
  }

  /**
   * The settled result: `(true, value, _)` or `(false, _, error)`.
   *
   * Throws if this future is still pending. At an async resume point
   * that cannot happen — the frame only runs once its future has
   * settled — so reaching it means the queue drained with work still
   * parked and nothing left that could complete it: a deadlock
   * (async.md §4).
   */
  :result(): inline (true, T, _) | inline (false, _, Error) {
    if (this.#state == FutureState.Rejected) {
      return (false, _, this.#error as Error);
    }
    if (this.#state == FutureState.Pending) {
      throw new Error(
        'Deadlock: the microtask queue is empty but this future is ' +
        'still pending, and no external completion source exists');
    }
    let stored = this.#value as Box<T>;
    return (true, stored.value, _);
  }

  /**
   * The stored failure, or null if this future resolved.
   *
   * `result()` says the same thing and says it better — the tag cannot
   * be separated from the payload there. This exists because a
   * zero-width `T` does not lower in an inline-tuple lane, so
   * `Future<void>.result()` bails ("method result type"), and the
   * library's own waiters have to work at every `T`. Retire it when
   * void lanes lower.
   */
  :failure(): Error | null {
    if (this.#state == FutureState.Pending) {
      throw new Error(
        'Deadlock: the microtask queue is empty but this future is ' +
        'still pending, and no external completion source exists');
    }
    return this.#error;
  }

  /**
   * Registers a waiter: `t.run()` runs from the microtask queue once
   * this future settles (scheduled immediately if it already has — the
   * always-async rule holds here too, so a frame awaiting a completed
   * future still yields one queue hop).
   *
   * This is what the `await` transform emits. It is deliberately
   * untyped in T: the waiter reads the settled result back with
   * `result()` when it runs.
   */
  subscribe(t: Task): void {
    if (!(this.#state == FutureState.Pending)) {
      scheduleTask(t);
      return;
    }
    if (this.#waiter == null) {
      this.#waiter = t;
      return;
    }
    if (this.#more == null) {
      this.#more = new Array<Task>();
    }
    (this.#more as Array<Task>).push(t);
  }

  /**
   * The settled value, or a throw of the stored failure.
   *
   * Async frames call this at each resume point, which is what makes a
   * failed await propagate as an ordinary exception: it unwinds into
   * step()'s failure-capture region and rejects the frame's own
   * future, with no separate error slot to thread (async.md §3).
   *
   * Reads the fields directly rather than going through `result()`:
   * this is the hot path, once per await, and rethrowing the error arm
   * would need the both-arms narrowing `CallbackTask` works around.
   */
  :valueOrThrow(): T {
    if (this.#state == FutureState.Rejected) {
      throw this.#error as Error;
    }
    if (this.#state == FutureState.Pending) {
      throw new Error(
        'Deadlock: the microtask queue is empty but this future is ' +
        'still pending, and no external completion source exists');
    }
    let stored = this.#value as Box<T>;
    return stored.value;
  }

  /** Settles this future with a value. Throws if already settled. */
  complete(value: T): void {
    if (!this.tryComplete(value)) {
      throw new Error('Future already completed');
    }
  }

  /** Settles this future with a value, reporting whether it won.
   * False means someone else settled it first, which is not an error
   * for a caller racing on purpose. */
  tryComplete(value: T): boolean {
    if (!(this.#state == FutureState.Pending)) {
      return false;
    }
    this.#state = FutureState.Resolved;
    this.#value = new Box<T>(value);
    this.#notify();
    return true;
  }

  /** Settles this future with a failure. Throws if already settled. */
  fail(error: Error): void {
    if (!this.tryFail(error)) {
      throw new Error('Future already completed');
    }
  }

  /** Settles this future with a failure, reporting whether it won. */
  tryFail(error: Error): boolean {
    if (!(this.#state == FutureState.Pending)) {
      return false;
    }
    this.#state = FutureState.Rejected;
    this.#error = error;
    this.#notify();
    return true;
  }

  /**
   * Moves every waiter onto the queue and drops the list.
   *
   * Allocates nothing: the waiters were registered as themselves, so
   * there is no delivery object to mint, and the overflow list is
   * dropped rather than cleared.
   */
  #notify(): void {
    let w = this.#waiter;
    if (w != null) {
      this.#waiter = null;
      scheduleTask(w as Task);
    }
    let m = this.#more;
    if (m != null) {
      let list = m as Array<Task>;
      this.#more = null;
      var i = 0;
      while (i < list.length) {
        scheduleTask(list[i]);
        i += 1;
      }
    }
  }
}

/**
 * A completer with its payload type erased.
 *
 * This exists so a collection can hold completers for different `T` —
 * which is what `zena:host-async`'s handle registry is. A base class
 * rather than an interface, deliberately and not by preference: a value
 * held as an interface cannot be tested or downcast back to its concrete
 * type today (`x is Plain` answers *false* through an interface
 * reference, for generic and non-generic classes alike — see BUGS.md).
 * Through a base class it works, and it distinguishes specializations
 * exactly: a `Completer<String>` held as `AnyCompleter` tests true for
 * `Completer<String>` and false for `Completer<i32>`, `Completer<f64>`,
 * and `Completer<SomeOtherClass>` alike.
 *
 * That is what makes the registry need no type tag of its own. The
 * completer's own specialized type *is* the tag, checked by the same
 * `ref.cast` the language already emits.
 *
 * `fail` is declared here because failing needs no payload: a caller
 * that only knows the erased completer can still reject it.
 */
export class AnyCompleter {
  new();

  /** Rejects the underlying future. Overridden by `Completer<T>`. */
  fail(_error: Error): void {
    throw new Error('AnyCompleter.fail: not a completer');
  }
}

/**
 * The boundary object: everything external — host I/O, timers, test
 * harnesses — completes futures through a Completer.
 */
export class Completer<T> extends AnyCompleter {
  future = new Future<T>();

  new() : super();

  complete(value: T): void {
    this.future.complete(value);
  }

  fail(error: Error): void {
    this.future.fail(error);
  }
}

/**
 * A waiter built from a pair of callbacks (`onComplete`).
 *
 * Holding the future it reads is what a pulling waiter needs, and three
 * separate compiler limits stand between here and the obvious spellings
 * (all filed in BUGS.md under "A generic class cannot receive a
 * `Future<T>`"): a `Future<T>` constructor parameter fails to lower, a
 * `Future<T> | null` field cannot be read back at `Future<T>`, and a
 * generic function cannot capture one in a closure. An **initialized**
 * `Array<Future<T>>` field is none of those, so the future arrives by
 * `push` after construction. Capacity 1 rather than the default 8.
 */
class CallbackTask<T> implements Task {
  holder = new Array<Future<T>>(1);
  valueCb: (value: T) => void;
  errorCb: (error: Error) => void;
  new(this.valueCb, this.errorCb);
  run(): void {
    let f = this.holder[0];
    // `:failure()` + `:valueOrThrow()` rather than `:result()`: this
    // class specializes at `T = void` too, and a zero-width lane does
    // not lower in an inline tuple.
    let e = f.:failure();
    if (e == null) {
      let ok = this.valueCb;
      ok(f.:valueOrThrow());
      return;
    }
    let bad = this.errorCb;
    bad(e as Error);
  }
}

/** Hosts the waiter construction: a specialized generic FUNCTION cannot
 * construct a class that implements an interface, whereas a generic
 * class's own method can — the same restriction `AllState.attach`
 * exists for. */
class CallbackAttach<T> {
  new();
  attach(
    f: Future<T>,
    onValue: (value: T) => void,
    onError: (error: Error) => void
  ): void {
    let t = new CallbackTask<T>(onValue, onError);
    t.holder.push(f);
    f.subscribe(t);
  }
}

/**
 * Low-level subscription: exactly one of the callbacks runs, from the
 * microtask queue, once `f` settles (immediately scheduled if it
 * already has). This is the bridge for non-async code.
 *
 * A free function rather than a method on `Future<T>`, and not by
 * preference: a pulling waiter has to hold the future it reads, and a
 * generic class cannot hand `this` to another generic class — without a
 * cast the checker sees the raw template type, and with one codegen
 * crashes (BUGS.md). As an argument `f` is an ordinary `Future<T>` and
 * neither happens. It sits beside `futureOf`/`allOf`/`raceOf`, which are
 * free functions for their own reasons.
 */
export let onComplete = <T>(
  f: Future<T>,
  onValue: (value: T) => void,
  onError: (error: Error) => void
): void => {
  new CallbackAttach<T>().attach(f, onValue, onError);
};

/**
 * Runs the executor to a standstill and returns `f`'s value, throwing
 * its failure.
 *
 * The public way to get a value out of a future from synchronous code,
 * and deliberately the only one: it cannot answer before the queue has
 * run, so there is no way to observe whether something settled "early".
 * If `f` is still pending once nothing more can happen, that is a
 * deadlock and it throws saying so.
 *
 * Top-level only — a driver, a test, `main`. Calling it from inside a
 * task would re-enter the drain and break run-to-completion.
 */
export let runFuture = <T>(f: Future<T>): T => {
  drainMicrotasks();
  return f.:valueOrThrow();
};

/** An already-resolved future. */
export let futureOf = <T>(value: T): Future<T> => {
  let f = new Future<T>();
  f.complete(value);
  return f;
};

/** An already-failed future. */
export let failedFuture = <T>(error: Error): Future<T> => {
  let f = new Future<T>();
  f.fail(error);
  return f;
};

// ---------------------------------------------------------------------------
// Combinators
// ---------------------------------------------------------------------------
//
// Ordinary library code over `subscribe`, as async.md §2 says they would
// be: no primitive, no compiler support, nothing the executor has to
// know about. They are written with waiter OBJECTS rather than closures
// for the reason the module header gives — a closure created inside
// generic code is not specialized per instantiation and fails to lower —
// which is also why each carries its own small state class instead of
// capturing one.
//
// Both are written against `subscribe` rather than as async functions
// awaiting their inputs in turn, and the difference is semantic, not
// stylistic: awaiting in sequence would wait on futures whose result
// can no longer matter, so a rejected input would be reported only
// after every input ahead of it settled — and never at all if one of
// them never settles.
//
// Because waiters pull, neither combinator stores the values it is
// waiting for: the inputs hold them, in input order, and `allOf` reads
// them back once the last one lands.

/** Shared state for one `allOf` call: the inputs, how many are still
 * outstanding, and the future they all settle. */
class AllState<T> {
  result = new Future<Array<T>>();
  inputs = new Array<Future<T>>();
  var remaining = 0;

  new();

  /**
   * Subscribes to every input and hands back the combined future.
   *
   * This lives on the state class rather than in `allOf` itself
   * because the waiters are interface implementations, and a
   * specialized generic FUNCTION does not get the interface vtable for
   * a class it instantiates ("interface vtable global not found") —
   * whereas a generic class's own method does. Same reason as the
   * closure restriction the module header describes: what works
   * depends on where the generic code lives.
   */
  attach(futures: Array<Future<T>>): Future<Array<T>> {
    this.remaining = futures.length;
    if (futures.length == 0) {
      this.result.complete(new Array<T>());
      return this.result;
    }
    var i = 0;
    while (i < futures.length) {
      this.inputs.push(futures[i]);
      i += 1;
    }
    // Subscribing cannot deliver synchronously, so `remaining` and the
    // inputs above are necessarily in place before any waiter runs.
    // The cast on `this` is the raw-template-type gap in BUGS.md: in a
    // generic class's own method `this` checks as `AllState`, not
    // `AllState<T>`.
    i = 0;
    while (i < futures.length) {
      futures[i].subscribe(new AllWaiter<T>(this as AllState<T>, i));
      i += 1;
    }
    return this.result;
  }

  /** Counts one input in; on the last, reads every input's value back
   * in input order. No slot array and no box per value: the inputs are
   * the storage. */
  report(): void {
    if (this.result.isCompleted) {
      return;
    }
    this.remaining -= 1;
    if (this.remaining == 0) {
      let values = new Array<T>();
      var i = 0;
      while (i < this.inputs.length) {
        values.push(this.inputs[i].:valueOrThrow());
        i += 1;
      }
      this.result.complete(values);
    }
  }

  /** The first failure settles the whole thing; later ones are spent. */
  reject(error: Error): void {
    this.result.tryFail(error);
  }
}

/** One input's subscription into an `AllState`.
 *
 * Carries the input's index rather than the future itself: a pulling
 * waiter needs to reach its future, and `Future<T>` cannot be a generic
 * class's constructor parameter (BUGS.md), but the state already holds
 * every input in order, so an index reaches it. */
class AllWaiter<T> implements Task {
  state: AllState<T>;
  index: i32;
  new(this.state, this.index);
  run(): void {
    let f = this.state.inputs[this.index];
    // `:failure()` for the reason CallbackTask documents.
    let e = f.:failure();
    if (e == null) {
      this.state.report();
      return;
    }
    this.state.reject(e as Error);
  }
}

/**
 * A future of every input's value, in **input order** regardless of the
 * order they settle in — or of the first failure to arrive.
 *
 * The failure is reported as soon as it happens, without waiting for
 * the other inputs: once one has failed no combined value can exist, so
 * waiting could only delay the answer, and would hang outright if
 * another input never settles. Inputs that settle after that are
 * ignored — they lost a race that was already decided, which is not an
 * error.
 *
 * With no inputs the result is an empty array. It still settles through
 * the microtask queue like everything else (the always-async rule), so
 * `allOf` never runs a continuation before its caller returns.
 *
 * Futures are eager, so the inputs are already running when they get
 * here: this waits for them, it does not start them.
 */
export let allOf = <T>(futures: Array<Future<T>>): Future<Array<T>> => {
  return new AllState<T>().attach(futures);
};

/** Shared state for one `raceOf` call: whoever settles first wins. */
class RaceState<T> {
  result = new Future<T>();
  inputs = new Array<Future<T>>();

  new();

  /** Subscribes every input. On the state class for the same reason
   * `AllState.attach` is. */
  attach(futures: Array<Future<T>>): Future<T> {
    var i = 0;
    while (i < futures.length) {
      this.inputs.push(futures[i]);
      i += 1;
    }
    // One waiter per input rather than one shared between them: a
    // pulling waiter has to know which future to read, and a race does
    // not otherwise care which settled. `this` is cast for the same
    // reason as in AllState.attach.
    i = 0;
    while (i < futures.length) {
      futures[i].subscribe(new RaceWaiter<T>(this as RaceState<T>, i));
      i += 1;
    }
    return this.result;
  }

  win(value: T): void {
    this.result.tryComplete(value);
  }

  lose(error: Error): void {
    this.result.tryFail(error);
  }
}

/** One input's subscription into a `RaceState`, by index for the same
 * reason `AllWaiter` carries one. */
class RaceWaiter<T> implements Task {
  state: RaceState<T>;
  index: i32;
  new(this.state, this.index);
  run(): void {
    let f = this.state.inputs[this.index];
    let e = f.:failure();
    if (e == null) {
      this.state.win(f.:valueOrThrow());
      return;
    }
    this.state.lose(e as Error);
  }
}

/**
 * A future settling as the **first input to settle** does — with its
 * value, or with its failure. A failure wins a race exactly the way a
 * value does; use it when the first answer is the answer, and note that
 * the losers keep running (nothing here cancels them; that waits on
 * cancellation).
 *
 * Throws on an empty array rather than returning a future. A race with
 * nothing in it can never settle, and a future that never settles
 * surfaces much later as a deadlock report naming the awaiting code, so
 * the mistake is refused where it was made.
 */
export let raceOf = <T>(futures: Array<Future<T>>): Future<T> => {
  if (futures.length == 0) {
    throw new Error(
      'raceOf: needs at least one future; a race with no inputs can ' +
      'never settle');
  }
  return new RaceState<T>().attach(futures);
};

// Note: no generic `MaybeFuture<T> = T | Future<T>` alias — Zena
// rejects unions mixing an unbounded type parameter with reference
// types (T could be a primitive). Concrete unions like
// `i32 | Future<i32>` work directly, and `await` accepts them
// (async.md §1).
