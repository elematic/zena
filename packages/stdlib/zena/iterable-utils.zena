import { Iterable, Iterator } from 'zena:iterator';

/**
 * An Iterator that yields elements matching a predicate.
 */
export final class FilterIterator<T> implements Iterator<T> {
  #iter: Iterator<T>;
  #predicate: (item: T) => boolean;

  new(iter: Iterator<T>, predicate: (item: T) => boolean) : #iter = iter, #predicate = predicate;

  next(): inline (true, T) | inline (false, _) {
    while (let (true, item) = this.#iter.next()) {
      if (this.#predicate(item)) {
        return (true, item);
      }
    }
    return (false, _);
  }
}

/**
 * An Iterable that lazily filters elements using a predicate.
 */
export final class FilteredIterable<T> implements Iterable<T> {
  #source: Iterable<T>;
  #predicate: (item: T) => boolean;

  new(source: Iterable<T>, predicate: (item: T) => boolean) : #source = source, #predicate = predicate;

  :Iterable.iterator(): Iterator<T> {
    return new FilterIterator<T>(this.#source.:Iterable.iterator(), this.#predicate);
  }

  filter(predicate: (item: T) => boolean): Iterable<T> {
    return new FilteredIterable<T>(this, predicate);
  }

  contains(value: T): boolean {
    for (let item in this) {
      if (item == value) {
        return true;
      }
    }
    return false;
  }

  all(predicate: (item: T) => boolean): boolean {
    for (let item in this) {
      if (!predicate(item)) {
        return false;
      }
    }
    return true;
  }

  some(predicate: (item: T) => boolean): boolean {
    for (let item in this) {
      if (predicate(item)) {
        return true;
      }
    }
    return false;
  }

  fold<R>(initial: R, combine: (acc: R, item: T) => R): R {
    var acc = initial;
    for (let item in this) {
      acc = combine(acc, item);
    }
    return acc;
  }

  find(predicate: (item: T) => boolean): inline (true, T) | inline (false, _) {
    for (let item in this) {
      if (predicate(item)) {
        return (true, item);
      }
    }
    return (false, _);
  }
}

/**
 * Common iteration utilities for any collection that implements Iterable<T>.
 */
export mixin IterableUtils<T> on Iterable<T> {
  /**
   * Returns a new iterable containing only the elements that match the predicate.
   */
  filter(predicate: (item: T) => boolean): Iterable<T> {
    return new FilteredIterable<T>(this, predicate);
  }

  /**
   * Checks if the collection contains the specified value using equality.
   */
  contains(value: T): boolean {
    for (let item in this) {
      if (item == value) {
        return true;
      }
    }
    return false;
  }

  /**
   * Returns true if all elements match the given predicate.
   * Returns true if the collection is empty.
   */
  all(predicate: (item: T) => boolean): boolean {
    for (let item in this) {
      if (!predicate(item)) {
        return false;
      }
    }
    return true;
  }

  /**
   * Returns true if at least one element matches the given predicate.
   * Returns false if the collection is empty.
   */
  some(predicate: (item: T) => boolean): boolean {
    for (let item in this) {
      if (predicate(item)) {
        return true;
      }
    }
    return false;
  }

  /**
   * Reduces the collection to a single value by accumulating state.
   */
  fold<R>(initial: R, combine: (acc: R, item: T) => R): R {
    var acc = initial;
    for (let item in this) {
      acc = combine(acc, item);
    }
    return acc;
  }

  /**
   * Finds the first element that matches the predicate.
   * Returns an inline tuple (true, item) if found, or (false, _) if not.
   */
  find(predicate: (item: T) => boolean): inline (true, T) | inline (false, _) {
    for (let item in this) {
      if (predicate(item)) {
        return (true, item);
      }
    }
    return (false, _);
  }
}

