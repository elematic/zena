/**
 * The elements layer's host calls on a target without a DOM host. A
 * server renders an element once, so an update request has nothing to
 * schedule, an event has no document to be dispatched into, and no
 * string crosses to a JavaScript host.
 */
export let hostRequestUpdate = (element: anyref): void => {};

export let hostDispatchEvent = (element: anyref, type: String, flags: i32): boolean => true;

export let stringHandle = (s: String): externref => {
  throw new Error('stringHandle: there is no DOM host on this target');
};

export let stringFromHandle = (handle: externref): String => {
  throw new Error('stringFromHandle: there is no DOM host on this target');
};
