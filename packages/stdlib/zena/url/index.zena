/**
 * URL parsing, resolution, percent-encoding, and URL pattern matching.
 *
 * Provides `URL` for manipulating URLs and their components, `URLSearchParams`
 * for query parameters, `URLPattern` for routing and matching, and
 * percent-encoding utilities.
 *
 * ## Examples
 *
 * ```zena
 * import { URL, URLSearchParams } from 'zena:url';
 *
 * let u = new URL('https://example.com/api?format=json');
 * let format = u.searchParams.get('format');
 * ```
 */

export {
  EncodeSet,
  byteNeedsPercentEncoding,
  percentEncode,
  percentDecode,
  encodeByteInto,
  parseFormUrlencoded,
  serializeFormUrlencoded
} from './encoding.zena';

export { URL } from './url.zena';
export { url } from './tag.zena';
export {
  parsePattern,
  Part,
  FixedPart,
  SegmentWildcardPart,
  FullWildcardPart,
  RegexPart,
  Modifier,
  URLComponentType,
  PatternSyntaxError
} from './pattern-parts.zena';
export { URLPattern, URLPatternInit } from './pattern.zena';
export { punycodeEncode, punycodeDecode } from './punycode.zena';
export { URLSearchParams, ConcurrentModificationError } from './search-params.zena';
