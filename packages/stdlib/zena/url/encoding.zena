// Percent-encoding and application/x-www-form-urlencoded, per the WHATWG URL
// Standard (https://url.spec.whatwg.org/#percent-encoded-bytes).
//
// Percent-encoding works on UTF-8 bytes, and every byte outside 0x20..0x7E is
// in the C0 control percent-encode set, which all other sets include. The
// codec reads a string's bytes through `str.utf8`, which on the byte targets
// is the string's own storage and on the js target, where a `String` is
// UTF-16, its UTF-8 encoding; and it builds a decoded string from UTF-8 with
// `String.fromByteArray`.

import { StringBuilder, Encoding } from 'zena:core';

/**
 * The percent-encode sets defined by the URL Standard. Each set includes all
 * of the sets above it (C0 control ⊂ fragment ⊂ ... is not a strict chain —
 * fragment and query diverge — but every set includes the C0 control set).
 */
export enum EncodeSet {
  C0Control,
  Fragment,
  Query,
  SpecialQuery,
  Path,
  Userinfo,
  Component,
  FormUrlencoded
}

let inQuerySet = (b: i32) =>
  b == 0x20 || b == 0x22 || b == 0x23 || b == 0x3C || b == 0x3E;

let inPathSet = (b: i32) =>
  inQuerySet(b) || b == 0x3F || b == 0x5E || b == 0x60 || b == 0x7B || b == 0x7D;

let inUserinfoSet = (b: i32) =>
  inPathSet(b) || b == 0x2F || b == 0x3A || b == 0x3B || b == 0x3D ||
  b == 0x40 || (b >= 0x5B && b <= 0x5E) || b == 0x7C;

let inComponentSet = (b: i32) =>
  inUserinfoSet(b) || b == 0x24 || b == 0x25 || b == 0x26 || b == 0x2B ||
  b == 0x2C;

let inFormUrlencodedSet = (b: i32) =>
  inComponentSet(b) || b == 0x21 || b == 0x27 || b == 0x28 || b == 0x29 ||
  b == 0x7E;

/**
 * True when byte `b` must be percent-encoded for `set`. Bytes outside
 * 0x20..0x7E (C0 controls, DEL, and all non-ASCII bytes) are encoded in every
 * set.
 */
export let byteNeedsPercentEncoding = (b: i32, set: EncodeSet): boolean => {
  if (b < 0x20 || b > 0x7E) {
    return true;
  }
  if (set == EncodeSet.C0Control) {
    return false;
  }
  if (set == EncodeSet.Fragment) {
    return b == 0x20 || b == 0x22 || b == 0x3C || b == 0x3E || b == 0x60;
  }
  if (set == EncodeSet.Query) {
    return inQuerySet(b);
  }
  if (set == EncodeSet.SpecialQuery) {
    return inQuerySet(b) || b == 0x27;
  }
  if (set == EncodeSet.Path) {
    return inPathSet(b);
  }
  if (set == EncodeSet.Userinfo) {
    return inUserinfoSet(b);
  }
  if (set == EncodeSet.Component) {
    return inComponentSet(b);
  }
  return inFormUrlencodedSet(b);
};

let hexDigitUpper = (n: i32) => {
  if (n < 10) {
    return 0x30 + n;        // '0'..'9'
  }
  return 0x41 + (n - 10);   // 'A'..'F'
};

/** Appends `b` as `%XX`, two uppercase hex digits. */
export let appendPercentEncodedByte = (sb: StringBuilder, b: i32): void => {
  sb.appendByte(0x25); // '%'
  sb.appendByte(hexDigitUpper((b >> 4) & 0xF));
  sb.appendByte(hexDigitUpper(b & 0xF));
};

/**
 * Appends `b` to `sb`, percent-encoded if `set` requires it. This is the
 * byte-at-a-time form the URL parser builds components with.
 */
export let encodeByteInto = (sb: StringBuilder, b: i32, set: EncodeSet): void => {
  if (byteNeedsPercentEncoding(b, set)) {
    appendPercentEncodedByte(sb, b);
  } else {
    sb.appendByte(b);
  }
};

/**
 * Percent-encodes `input` for the given encode set. `spaceAsPlus` implements
 * the form-urlencoded serializer's special case (0x20 → '+').
 */
export let percentEncode = (
  input: String,
  set: EncodeSet,
  spaceAsPlus: boolean = false
): String => {
  let bytes = input.utf8;
  let sb = new StringBuilder(bytes.length + 8);
  for (var i = 0; i < bytes.length; i += 1) {
    let b = bytes[i] as i32;
    if (spaceAsPlus && b == 0x20) {
      sb.appendByte(0x2B); // '+'
    } else if (byteNeedsPercentEncoding(b, set)) {
      appendPercentEncodedByte(sb, b);
    } else {
      sb.appendByte(b);
    }
  }
  return sb.toString();
};

let hexValue = (b: i32): i32 => {
  if (b >= 0x30 && b <= 0x39) {
    return b - 0x30;
  }
  if (b >= 0x41 && b <= 0x46) {
    return b - 0x41 + 10;
  }
  if (b >= 0x61 && b <= 0x66) {
    return b - 0x61 + 10;
  }
  return -1;
};

/**
 * Percent-decodes `input` (https://url.spec.whatwg.org/#percent-decode).
 * A '%' not followed by two hex digits is passed through unchanged, per spec.
 * `plusAsSpace` implements the form-urlencoded parser's '+' → 0x20 rule.
 */
export let percentDecode = (
  input: String,
  plusAsSpace: boolean = false
): String => {
  let bytes = input.utf8;
  let len = bytes.length;
  // Decoding only shortens: every %XX is one byte.
  let out = __byte_array_new(len);
  var n = 0;
  var i = 0;
  while (i < len) {
    var b = bytes[i] as i32;
    i += 1;
    if (plusAsSpace && b == 0x2B) {
      b = 0x20;
    } else if (b == 0x25 && i + 1 < len) {
      let hi = hexValue(bytes[i] as i32);
      let lo = hexValue(bytes[i + 1] as i32);
      if (hi >= 0 && lo >= 0) {
        b = (hi << 4) | lo;
        i += 2;
      }
    }
    __byte_array_set(out, n, b);
    n += 1;
  }
  return String.fromByteArray(out, 0, n, Encoding.WTF8);
};

/**
 * Parses an application/x-www-form-urlencoded string into ordered
 * (name, value) pairs (https://url.spec.whatwg.org/#urlencoded-parsing).
 * A leading '?' is NOT stripped here — callers strip it (the URL API layer
 * does, matching URLSearchParams).
 */
export let parseFormUrlencoded = (input: String): Array<(String, String)> => {
  let pairs = new Array<(String, String)>();
  for (let piece in input.split("&")) {
    if (piece.isEmpty) {
      continue;
    }
    var name = piece;
    var value = "";
    if (let (true, eq) = piece.indexOf("=")) {
      name = piece.slice(piece.startIndex, eq);
      value = piece.slice(piece.scalarIndexAfter(eq));
    }
    pairs.push((percentDecode(name, true), percentDecode(value, true)));
  }
  return pairs;
};

/**
 * Serializes ordered (name, value) pairs to application/x-www-form-urlencoded
 * (https://url.spec.whatwg.org/#concept-urlencoded-serializer).
 */
export let serializeFormUrlencoded = (
  pairs: Array<(String, String)>
): String => {
  let sb = new StringBuilder();
  var first = true;
  for (let pair in pairs) {
    let (name, value) = pair;
    if (!first) {
      sb.appendByte(0x26); // '&'
    }
    first = false;
    sb.append(percentEncode(name, EncodeSet.FormUrlencoded, true));
    sb.appendByte(0x3D); // '='
    sb.append(percentEncode(value, EncodeSet.FormUrlencoded, true));
  }
  return sb.toString();
};
