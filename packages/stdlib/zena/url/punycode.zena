// Punycode, the Bootstring encoding of RFC 3492
// (https://www.rfc-editor.org/rfc/rfc3492), which IDNA uses to write a
// Unicode label as ASCII.
//
// This is the label codec on its own: it neither adds nor strips the "xn--"
// prefix, and it does none of the UTS 46 mapping that surrounds it in a real
// domain-to-ASCII conversion.
//
// Zena strings are UTF-8 and Bootstring works on code points, so both
// directions convert through an Array<i32> of code points.

import { StringBuilder } from 'zena:core';

// The Bootstring parameters RFC 3492 section 5 fixes for Punycode.
let BASE = 36;
let TMIN = 1;
let TMAX = 26;
let SKEW = 38;
let DAMP = 700;
let INITIAL_BIAS = 72;
// Code points below this are "basic" and are written literally.
let INITIAL_N = 128;
let DELIMITER = 0x2D;  // '-'

// Arithmetic that would pass this is a failure rather than a wrap. The RFC
// calls for exactly this: an implementation must not let a hostile label
// overflow its way to a different answer.
let MAX_I32 = 2147483647;

let MAX_CODE_POINT = 0x10FFFF;

// ((BASE - TMIN) * TMAX) / 2, the loop bound in adapt(), written out because
// it is a constant and integer division is not free here — see divide().
let ADAPT_LIMIT = 455;

/**
 * Truncating integer division.
 *
 * Zena's `/` always yields a float, and f32 cannot represent every i32
 * exactly, so this widens to f64 first. That is exact for this use: every
 * i32 converts to f64 without loss, and the rounding error on the quotient
 * is far smaller than the distance from a non-integral quotient to the
 * nearest integer, so truncating never lands on the wrong side.
 */
let divide = (a: i32, b: i32) => ((a as f64) / (b as f64)) as i32;

/** RFC 3492 section 6.1: the bias adaptation function. */
let adapt = (rawDelta: i32, numPoints: i32, firstTime: boolean) => {
  var delta = if (firstTime) divide(rawDelta, DAMP) else divide(rawDelta, 2);
  delta += divide(delta, numPoints);
  var k = 0;
  while (delta > ADAPT_LIMIT) {
    delta = divide(delta, BASE - TMIN);
    k += BASE;
  }
  return k + divide((BASE - TMIN + 1) * delta, delta + SKEW);
};

/** The threshold for digit position `k`, clamped to [TMIN, TMAX]. */
let threshold = (k: i32, bias: i32) => {
  if (k <= bias + TMIN) return TMIN;
  if (k >= bias + TMAX) return TMAX;
  return k - bias;
};

/** Digit value (0..35) to its ASCII character: 0-25 to 'a'-'z', 26-35 to '0'-'9'. */
let digitToChar = (d: i32) => if (d < 26) 0x61 + d else 0x30 + (d - 26);

/** The inverse, returning BASE for anything that is not a Punycode digit. */
let charToDigit = (c: i32) => {
  if (c >= 0x30 && c <= 0x39) return c - 0x30 + 26;
  if (c >= 0x61 && c <= 0x7A) return c - 0x61;
  // The decoder accepts uppercase; the encoder never produces it.
  if (c >= 0x41 && c <= 0x5A) return c - 0x41;
  return BASE;
};

/**
 * Decodes UTF-8 bytes to code points, or null if the bytes are malformed.
 *
 * Exported for idna.zena, which walks the same code points; it is not part of
 * the library's public surface, which index.zena defines.
 */
export let toCodePoints = (s: String): Array<i32> | null => {
  let out = new Array<i32>();
  var i = 0;
  while (i < s.length) {
    let b = s.getByteAt(i);
    if (b < 0x80) {
      out.push(b);
      i += 1;
    } else if (b >= 0xC2 && b <= 0xDF) {
      if (i + 1 >= s.length) return null;
      out.push(((b & 0x1F) << 6) | (s.getByteAt(i + 1) & 0x3F));
      i += 2;
    } else if (b >= 0xE0 && b <= 0xEF) {
      if (i + 2 >= s.length) return null;
      out.push(((b & 0x0F) << 12) | ((s.getByteAt(i + 1) & 0x3F) << 6) |
               (s.getByteAt(i + 2) & 0x3F));
      i += 3;
    } else if (b >= 0xF0 && b <= 0xF4) {
      if (i + 3 >= s.length) return null;
      out.push(((b & 0x07) << 18) | ((s.getByteAt(i + 1) & 0x3F) << 12) |
               ((s.getByteAt(i + 2) & 0x3F) << 6) | (s.getByteAt(i + 3) & 0x3F));
      i += 4;
    } else {
      return null;
    }
  }
  return out;
};

/** Appends one code point to `sb` as UTF-8. Exported alongside `toCodePoints`. */
export let appendCodePoint = (sb: StringBuilder, cp: i32): void => {
  if (cp < 0x80) {
    sb.appendByte(cp);
  } else if (cp < 0x800) {
    sb.appendByte(0xC0 | (cp >> 6));
    sb.appendByte(0x80 | (cp & 0x3F));
  } else if (cp < 0x10000) {
    sb.appendByte(0xE0 | (cp >> 12));
    sb.appendByte(0x80 | ((cp >> 6) & 0x3F));
    sb.appendByte(0x80 | (cp & 0x3F));
  } else {
    sb.appendByte(0xF0 | (cp >> 18));
    sb.appendByte(0x80 | ((cp >> 12) & 0x3F));
    sb.appendByte(0x80 | ((cp >> 6) & 0x3F));
    sb.appendByte(0x80 | (cp & 0x3F));
  }
};

/** Shifts everything from `at` right by one and writes `value` into the gap. */
let insertAt = (a: GrowableArray<i32>, at: i32, value: i32) => {
  a.push(value);
  var i = a.length - 1;
  while (i > at) {
    a[i] = a[i - 1];
    i -= 1;
  }
  a[at] = value;
};

/**
 * Encodes one label, per RFC 3492 section 6.3.
 *
 * The result carries no "xn--" prefix. An all-ASCII label encodes to itself
 * followed by a '-', which is what the RFC specifies even though IDNA never
 * has a reason to encode such a label.
 *
 * Returns null if the input is not well-formed UTF-8, or if the label is so
 * pathological that the encoder's arithmetic would overflow.
 */
export let punycodeEncode = (label: String): String | null => {
  let decoded = toCodePoints(label);
  if (decoded == null) return null;
  let cps = decoded;

  let sb = new StringBuilder(label.length + 8);
  var basicCount = 0;
  for (let cp in cps) {
    if (cp < INITIAL_N) {
      sb.appendByte(cp);
      basicCount += 1;
    }
  }
  if (basicCount > 0) sb.appendByte(DELIMITER);

  var handled = basicCount;
  var n = INITIAL_N;
  var delta = 0;
  var bias = INITIAL_BIAS;

  while (handled < cps.length) {
    // The smallest code point not yet handled, which the next run encodes.
    var m = MAX_I32;
    for (let cp in cps) {
      if (cp >= n && cp < m) m = cp;
    }
    if (m - n > divide(MAX_I32 - delta, handled + 1)) return null;
    delta += (m - n) * (handled + 1);
    n = m;

    for (let cp in cps) {
      if (cp < n) {
        if (delta == MAX_I32) return null;
        delta += 1;
      }
      if (cp == n) {
        var q = delta;
        var k = BASE;
        while (true) {
          let t = threshold(k, bias);
          if (q < t) break;
          sb.appendByte(digitToChar(t + ((q - t) % (BASE - t))));
          q = divide(q - t, BASE - t);
          k += BASE;
        }
        sb.appendByte(digitToChar(q));
        bias = adapt(delta, handled + 1, handled == basicCount);
        delta = 0;
        handled += 1;
      }
    }
    delta += 1;
    n += 1;
  }
  return sb.toString();
};

/**
 * Decodes one label, per RFC 3492 section 6.2.
 *
 * The input must not carry the "xn--" prefix. Returns null for a label that
 * is not valid Punycode: a bad digit, arithmetic that would overflow, a
 * non-ASCII byte in the literal portion, or a result outside the Unicode
 * scalar range.
 */
export let punycodeDecode = (label: String): String | null => {
  // Everything before the LAST delimiter is literal, so a label may contain
  // delimiters of its own.
  var lastDelimiter = 0 - 1;
  var i = 0;
  while (i < label.length) {
    if (label.getByteAt(i) == DELIMITER) lastDelimiter = i;
    i += 1;
  }

  let out = new Array<i32>();
  var next = 0;
  // The delimiter is consumed only if something preceded it. A leading '-'
  // is therefore not a separator but a digit — and not a valid one — so
  // "-" alone is rejected rather than decoding to the empty string.
  if (lastDelimiter > 0) {
    var j = 0;
    while (j < lastDelimiter) {
      let c = label.getByteAt(j);
      if (c >= INITIAL_N) return null;
      out.push(c);
      j += 1;
    }
    next = lastDelimiter + 1;
  }

  var n = INITIAL_N;
  var bias = INITIAL_BIAS;
  var index = 0;

  while (next < label.length) {
    let oldIndex = index;
    var weight = 1;
    var k = BASE;
    while (true) {
      if (next >= label.length) return null;
      let digit = charToDigit(label.getByteAt(next));
      next += 1;
      if (digit >= BASE) return null;
      if (digit > divide(MAX_I32 - index, weight)) return null;
      index += digit * weight;
      let t = threshold(k, bias);
      if (digit < t) break;
      if (weight > divide(MAX_I32, BASE - t)) return null;
      weight *= (BASE - t);
      k += BASE;
    }

    let outLength = out.length + 1;
    bias = adapt(index - oldIndex, outLength, oldIndex == 0);
    if (divide(index, outLength) > MAX_I32 - n) return null;
    n += divide(index, outLength);
    index = index % outLength;
    // Bootstring is generic over code point ranges; Unicode is not, so a
    // label that decodes past the scalar range or into a surrogate is
    // rejected rather than producing an unencodable value.
    if (n > MAX_CODE_POINT || (n >= 0xD800 && n <= 0xDFFF)) return null;
    insertAt(out, index, n);
    index += 1;
  }

  let sb = new StringBuilder(out.length * 2);
  for (let cp in out) {
    appendCodePoint(sb, cp);
  }
  return sb.toString();
};
