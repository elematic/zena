import { IterableUtils } from 'zena:core';
import { Step } from 'zena:async';
import { parseFormUrlencoded, serializeFormUrlencoded } from './encoding.zena';

/**
 * Thrown when a `URLSearchParams` is mutated while an iteration over it is
 * still in progress.
 *
 * This is a deliberate divergence from the web API, which iterates live: in
 * JS, deleting a pair during a `for...of` silently SKIPS the following pair
 * (WebIDL's default pair iterator indexes into the current list and re-reads
 * it on every step), and appending during iteration never terminates. Both
 * produce a wrong answer with no signal, so this follows Java's fail-fast
 * collections instead and reports the bug where it happens.
 *
 * Like Java's, the check is best-effort: it exists to catch mistakes, not to
 * make concurrent mutation safe.
 *
 * Lives here rather than in `zena:error` because `URLSearchParams` is the
 * only collection that currently detects this; it should move if others
 * adopt the same discipline.
 */
export class ConcurrentModificationError extends Error {
  new() : super('URLSearchParams was modified during iteration');
}

/**
 * Iterator over a `URLSearchParams`' pairs that fails fast when the params
 * are mutated underneath it.
 *
 * It holds the pair list captured at creation plus the params' shared
 * modification counter, so it can tell "unchanged" from "mutated" without
 * `URLSearchParams` having to expose the counter publicly.
 */
final class URLSearchParamsIterator implements Iterator<(String, String)> {
  #pairs: Array<(String, String)>;
  #version: Box<i32>;
  #expected: i32;
  var #index: i32 = 0;

  new(pairs: Array<(String, String)>, version: Box<i32>)
    : #pairs = pairs, #version = version, #expected = version.value;

  next(): Step<(String, String)> {
    if (this.#version.value != this.#expected) {
      throw new ConcurrentModificationError();
    }
    if (this.#index < this.#pairs.length) {
      let pair = this.#pairs[this.#index];
      this.#index += 1;
      return (1, pair, _);
    }
    return (0, _, _);
  }
}

/**
 * An ordered, mutable list of (name, value) pairs — the
 * `application/x-www-form-urlencoded` half of the WHATWG URL Standard
 * (https://url.spec.whatwg.org/#interface-urlsearchparams).
 *
 * Order is significant and duplicate names are allowed, so this is a
 * multimap over a list, not a map. Unlike `URL` this type is mutable: it
 * is a collection/builder, like `GrowableArray` or `StringBuilder`.
 *
 * Names and values are held DECODED. Percent-encoding and `+`-for-space
 * happen only at `toString`, so a value containing `&` or `=` round-trips.
 */
export final class URLSearchParams with IterableUtils<(String, String)>
    implements Iterable<(String, String)> {
  var #pairs: GrowableArray<(String, String)>;

  /**
   * Bumped by every mutation. Live iterators hold this same box and
   * compare against the value they captured, so they can fail fast
   * (see `ConcurrentModificationError`) without this counter becoming
   * part of the public API.
   */
  #version: Box<i32> = new Box<i32>(0);

  /**
   * Parses `init` as an urlencoded string. A single leading `?` is
   * ignored, so `new URLSearchParams(url.search)` does the expected
   * thing. Defaults to empty.
   *
   * The parser returns its list as the read-only `Array` interface; this
   * class appends to and sorts that same list, so it takes it back as the
   * `GrowableArray` it was built as.
   */
  new(init: String = '')
      : #pairs = parseFormUrlencoded(stripLeadingQuestion(init)) as GrowableArray<(String, String)>;

  /** Number of pairs, counting duplicate names separately. */
  size: i32 {
    get { return this.#pairs.length; }
  }

  /**
   * True if any pair has this name — or, when `value` is given, if any
   * pair has both this name and that value.
   */
  has(name: String, value: String | null = null): boolean {
    for (let pair in this.#pairs) {
      let (n, v) = pair;
      if (n == name && (value == null || v == (value as String))) {
        return true;
      }
    }
    return false;
  }

  /** The first value for `name`, or null when there is none. */
  get(name: String): String | null {
    for (let pair in this.#pairs) {
      let (n, v) = pair;
      if (n == name) {
        return v;
      }
    }
    return null;
  }

  /** Every value for `name`, in order. Empty when there is none. */
  getAll(name: String): Array<String> {
    let out = new Array<String>();
    for (let pair in this.#pairs) {
      let (n, v) = pair;
      if (n == name) {
        out.push(v);
      }
    }
    return out;
  }

  /** Appends a pair, keeping any existing pairs with the same name. */
  append(name: String, value: String): void {
    this.#pairs.push((name, value));
    this.#version.value += 1;
  }

  /**
   * Sets `name` to a single `value`: updates the first pair with that
   * name and drops the rest, or appends when there is none. The first
   * pair keeps its position.
   */
  set(name: String, value: String): void {
    let out = new Array<(String, String)>();
    var seen = false;
    for (let pair in this.#pairs) {
      let (n, v) = pair;
      if (n != name) {
        out.push(pair);
      } else if (!seen) {
        seen = true;
        out.push((name, value));
      }
    }
    if (!seen) {
      out.push((name, value));
    }
    this.#pairs = out;
    this.#version.value += 1;
  }

  /**
   * Removes every pair with this name — or, when `value` is given, only
   * the pairs matching both.
   */
  delete(name: String, value: String | null = null): void {
    let out = new Array<(String, String)>();
    for (let pair in this.#pairs) {
      let (n, v) = pair;
      if (n != name || (value != null && v != (value as String))) {
        out.push(pair);
      }
    }
    this.#pairs = out;
    this.#version.value += 1;
  }

  /**
   * Sorts pairs by name, preserving the relative order of pairs that
   * share a name (an insertion sort, which is stable).
   *
   * The spec sorts by UTF-16 code unit; this compares UTF-8 bytes, which
   * is code POINT order. The two agree on everything except a
   * supplementary-plane name ordered against U+E000..U+FFFF — see
   * `compareByteWise`.
   */
  sort(): void {
    let a = this.#pairs;
    for (var i = 1; i < a.length; i += 1) {
      let cur = a[i];
      let (curName, _cv) = cur;
      var j = i - 1;
      while (j >= 0) {
        let (prevName, _pv) = a[j];
        if (prevName.compareTo(curName) <= 0) {
          break;
        }
        a[j + 1] = a[j];
        j -= 1;
      }
      a[j + 1] = cur;
    }
    // Reordering in place is as disruptive to a live iteration as an
    // insert or a removal, so it counts as a modification too.
    this.#version.value += 1;
  }

  /** Serializes to `application/x-www-form-urlencoded` (no leading `?`). */
  toString(): String {
    return serializeFormUrlencoded(this.#pairs);
  }

  [Iterable.iterator](): Iterator<(String, String)> {
    return new URLSearchParamsIterator(this.#pairs, this.#version);
  }
}

/** Drops one leading '?', so `url.search` can be passed through directly. */
let stripLeadingQuestion = (s: String): String => {
  if (s.length > 0 && s.getByteAt(0) == 0x3F) {
    return s.sliceBytes(1, s.length);
  }
  return s;
};
