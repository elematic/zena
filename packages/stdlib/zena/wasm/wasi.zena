/**
 * zena:wasm — running other Wasm modules and waiting for their results.
 *
 * A module cannot start a Wasm engine by itself, so this is a host
 * import (wasm module `zena_wasm`), provided by the `zena-cli` and
 * `zena-run` hosts, and available only on the `zena-cli` target. It is
 * granted together with `zena:process`: a program that may spawn
 * processes may also run modules, and one that may not gets imports
 * that trap at the first call.
 *
 * ```zena
 * import { runModule } from 'zena:wasm';
 *
 * let result = runModule('out/array_test.wasm', {
 *   args: ['array_test'],
 *   dirs: [{from: '.', to: '.'}],
 * });
 * if (!result.succeeded()) {
 *   console.error(result.stdout);
 *   console.error(result.message);
 * }
 * ```
 *
 * Each run gets a fresh store on its own host thread. `startModule`
 * returns straight away, so several modules can run at once; `wait`
 * blocks until one ends. A trap is reported in the result and does not
 * affect the caller.
 *
 * Paths — the module's, and each directory handed to it — are in this
 * program's own view of the filesystem and are translated through its
 * preopens. A path outside them, or with a `..` segment, makes the run
 * fail to start: a program can pass on only what it can reach itself.
 */

import { Duration } from 'zena:time';

/**
 * Opaque host-side handle to a run being configured. The host makes an
 * externref; the import wrapper the compiler generates converts it with
 * `any.convert_extern`, so it can be stored like any other reference.
 */
distinct type RunConfigRef = anyref;

/** Opaque host-side handle to a started run. */
distinct type RunRef = anyref;

@external("zena_wasm", "run_new")
declare function __runNew(path: String): RunConfigRef;

@external("zena_wasm", "run_arg")
declare function __runArg(config: RunConfigRef, arg: String): void;

@external("zena_wasm", "run_env")
declare function __runEnv(config: RunConfigRef, key: String, value: String): void;

@external("zena_wasm", "run_inherit_env")
declare function __runInheritEnv(config: RunConfigRef): void;

@external("zena_wasm", "run_dir")
declare function __runDir(config: RunConfigRef, from: String, to: String): void;

@external("zena_wasm", "run_invoke")
declare function __runInvoke(config: RunConfigRef, name: String): void;

@external("zena_wasm", "run_inherit_stdio")
declare function __runInheritStdio(config: RunConfigRef): void;

@external("zena_wasm", "run_grant")
declare function __runGrant(config: RunConfigRef): void;

@external("zena_wasm", "run_debug")
declare function __runDebug(config: RunConfigRef): void;

@external("zena_wasm", "run_timeout")
declare function __runTimeout(config: RunConfigRef, nanos: i64): void;

/** Starts the run; does not block. */
@external("zena_wasm", "run_start")
declare function __runStart(config: RunConfigRef): RunRef;

/** Blocks until the run ends; returns its exit code. */
@external("zena_wasm", "run_wait")
declare function __runWait(run: RunRef): i32;

@external("zena_wasm", "run_outcome")
declare function __runOutcome(run: RunRef): i32;

@external("zena_wasm", "run_message")
declare function __runMessage(run: RunRef): String;

@external("zena_wasm", "run_stdout")
declare function __runStdout(run: RunRef): String;

@external("zena_wasm", "run_stderr")
declare function __runStderr(run: RunRef): String;

@external("zena_wasm", "run_call_nanos")
declare function __runCallNanos(run: RunRef): i64;

@external("zena_wasm", "run_result_text")
declare function __runResultText(run: RunRef): String;

/** Writes a module's `.cwasm`; returns '' or why it could not. */
@external("zena_wasm", "module_precompile")
declare function __modulePrecompile(path: String, debug: boolean): String;

/** How a run ended. */
export enum RunOutcome {
  /**
   * The exported function returned. `exitCode` is the `i32` it returned,
   * and `resultText` its first result however typed.
   */
  Returned,
  /** The module ended itself with `exit(code)`; `exitCode` is the code. */
  Exited,
  /** The module trapped. `message` has the trap and its backtrace. */
  Trapped,
  /** The run was stopped at its time limit. */
  TimedOut,
  /**
   * The module did not start: it could not be read, compiled, linked
   * or instantiated, or a path it was given is outside what this
   * program can reach. `message` says which.
   */
  Failed,
}

/** The host's numbering of how a run ended. */
let outcomeOf = (code: i32): RunOutcome => {
  if (code == 0) {
    return RunOutcome.Returned;
  }
  if (code == 1) {
    return RunOutcome.Trapped;
  }
  if (code == 2) {
    return RunOutcome.TimedOut;
  }
  if (code == 4) {
    return RunOutcome.Exited;
  }
  return RunOutcome.Failed;
};

/** What a finished run produced. */
export class RunResult {
  outcome: RunOutcome;
  /**
   * The status the module ended with: the `i32` its exported function
   * returned, the code it passed to `exit`, or 0 when the function
   * returns nothing. -1 when it trapped, timed out or failed to start.
   */
  exitCode: i32;
  /**
   * What the exported function returned, formatted the way `zena run`
   * prints it (`7`, `2.5`); '' when it returned nothing or did not
   * return.
   */
  resultText: String;
  /** Why a run trapped, timed out or failed to start; otherwise ''. */
  message: String;
  /** What the module wrote, when its output was captured; otherwise ''. */
  stdout: String;
  stderr: String;
  /**
   * How long the exported call took. Loading and instantiating the
   * module are not included, so this is the number a benchmark wants.
   */
  callTime: Duration;

  new(
    this.outcome,
    this.exitCode,
    this.resultText,
    this.message,
    this.stdout,
    this.stderr,
    this.callTime,
  );

  /** True when the module returned or exited with status 0. */
  succeeded(): boolean {
    return (this.outcome == RunOutcome.Returned || this.outcome == RunOutcome.Exited) &&
        this.exitCode == 0;
  }
}

/**
 * A directory handed to a module: `from` in this program's view of the
 * filesystem, appearing as `to` in the module's. `{from: '.', to: '.'}`
 * shares this program's working directory.
 */
export type DirMapping = {from: String, to: String};

/** How to run a module. Every field may be left out. */
export type RunOptions = {
  /**
   * The module's argument vector, program name first, as
   * `getArguments()` will return it inside the module. Empty if absent.
   */
  args?: Array<String>,
  /** Environment variables to set in the module's environment. */
  env?: Map<String, String>,
  /**
   * Give the module this host process's environment variables, before
   * `env` is applied. Off if absent.
   */
  inheritEnv?: boolean,
  /**
   * The directories to preopen, in order. The first is where the
   * module's relative paths resolve. None if absent.
   */
  dirs?: Array<DirMapping>,
  /** The exported function to call; `main` if absent. */
  invoke?: String,
  /**
   * Connect the module to this program's own stdin, stdout and stderr,
   * so what it prints appears as it prints it. Its output is captured
   * into the result if absent.
   */
  inheritStdio?: boolean,
  /**
   * Let the module spawn processes and run modules itself, within the
   * directories it was given. Off if absent.
   *
   * TODO: make this capability-based. A program should be able to
   * forward, or proxy, each of its host imports to the module it starts,
   * so a module is given exactly the capabilities its caller chooses.
   * For now this is the all-or-nothing grant the CLI needs.
   */
  grant?: boolean,
  /**
   * Run the module with inlining off, so a trap's backtrace names every
   * function on the way to it. The caller's own setting if absent.
   */
  debug?: boolean,
  /**
   * Stop the run if its exported call takes longer than this. The limit
   * is checked every few milliseconds, so it is approximate. No limit if
   * absent or not positive.
   */
  timeout?: Duration,
};

/** Builds the host-side configuration for a run of `path`. */
let configure = (path: String, options: RunOptions): RunConfigRef => {
  let config = __runNew(path);
  if (let {args} = options) {
    for (let arg in args) {
      __runArg(config, arg);
    }
  }
  let {inheritEnv = false, invoke = 'main', inheritStdio = false} = options;
  if (inheritEnv) {
    __runInheritEnv(config);
  }
  if (let {env} = options) {
    for (let entry in env) {
      __runEnv(config, entry.key, entry.value);
    }
  }
  if (let {dirs} = options) {
    for (let dir in dirs) {
      __runDir(config, dir.from, dir.to);
    }
  }
  __runInvoke(config, invoke);
  if (inheritStdio) {
    __runInheritStdio(config);
  }
  let {grant = false, debug = false} = options;
  if (grant) {
    __runGrant(config);
  }
  if (debug) {
    __runDebug(config);
  }
  if (let {timeout} = options) {
    if (timeout.isPositive()) {
      __runTimeout(config, timeout as i64);
    }
  }
  return config;
};

/**
 * A started run. `wait` blocks until it ends; waiting again returns the
 * same result.
 */
export final class Run {
  #run: RunRef;
  var #result: RunResult | null = null;

  new(run: RunRef) : #run = run;

  wait(): RunResult {
    let cached = this.#result;
    if (cached != null) {
      return cached;
    }
    let code = __runWait(this.#run);
    let result = new RunResult(
      outcomeOf(__runOutcome(this.#run)),
      code,
      __runResultText(this.#run),
      __runMessage(this.#run),
      __runStdout(this.#run),
      __runStderr(this.#run),
      __runCallNanos(this.#run) as Duration,
    );
    this.#result = result;
    return result;
  }
}

/** Starts a module without waiting for it. */
export let startModule = (path: String, options: RunOptions = {}): Run =>
  new Run(__runStart(configure(path, options)));

/** Runs a module to completion. */
export let runModule = (path: String, options: RunOptions = {}): RunResult =>
  startModule(path, options).wait();

/**
 * Compiles a module to machine code now and caches it beside the file,
 * so that its first run does not pay for the compile. Returns '' on
 * success and the reason otherwise. Running a module caches it the same
 * way; this is for doing it ahead of time. `debug` compiles it for runs
 * with `debug: true`.
 */
export let precompileModule = (path: String, debug: boolean = false): String =>
  __modulePrecompile(path, debug);
