/**
 * Spawning host processes, for programs the `zena` command's host runs:
 * `zena-cli:host/process` as the compiler synthesizes it from the
 * host's WIT. The host grants it to the command and to `zena-run
 * --allow-spawn`; anywhere else the imports are stubs that trap.
 *
 * ## Examples
 *
 * ```zena
 * import { run } from 'zena:process';
 *
 * let result = await run(['git', 'status']);
 * if (result.succeeded()) {
 *   console.log(result.stdout);
 * }
 * ```
 */

import { Future } from 'zena:async';
import { Own, Some } from 'zena:core';
import {
  Command,
  Process as HostProcess,
  Finished,
  listenSignals as hostListenSignals,
  checkSignal as hostCheckSignal,
  waitSignal as hostWaitSignal,
} from 'zena-cli:host/process';

/** How a process ended, and what it wrote. */
export class ProcessResult {
  exitCode: i32;
  stdout: String;
  stderr: String;
  /** Wall-clock nanoseconds from spawn to exit. */
  wallNanos: i64;
  /**
   * True when the process overran a `waitFor` deadline and was killed
   * rather than exiting on its own. Whatever it had written before the
   * deadline is still in `stdout`/`stderr`.
   */
  timedOut: boolean;

  new(this.exitCode, this.stdout, this.stderr, this.wallNanos, this.timedOut);

  succeeded(): boolean {
    return this.exitCode == 0 && !this.timedOut;
  }
}

function resultOf(finished: Finished) {
  return new ProcessResult(
    finished.exitCode,
    String.fromBytes(finished.stdout),
    String.fromBytes(finished.stderr),
    finished.wallNanos,
    finished.timedOut);
}

/**
 * A running process: a resource over the host's handle, held as
 * `Own<Process>` and released when the owner leaves scope. Releasing
 * it does not end the process; it lets go of the host's record of it.
 */
export resource class Process {
  #proc: Own<HostProcess>;
  var #result: ProcessResult | null = null;

  new(proc: Own<HostProcess>) : #proc = proc;

  /** Waits for the process to exit without blocking this program's other tasks. */
  async wait(): Future<ProcessResult> {
    return await this.waitFor(0 as i64);
  }

  /**
   * Waits at most `millis` for the process to exit, killing it if it
   * overruns — the result then has `timedOut` set, and holds whatever
   * it managed to write first. A non-positive `millis` waits forever,
   * so a caller can disable its timeout without branching. Waiting
   * again returns the same result.
   */
  async waitFor(millis: i64): Future<ProcessResult> {
    let cached = this.#result;
    if (cached != null) {
      return cached;
    }
    let result = resultOf(await this.#proc.wait(millis));
    this.#result = result;
    return result;
  }

  /** Whether the process has already exited. */
  hasExited(): boolean {
    if (this.#result != null) {
      return true;
    }
    return this.#proc.hasExited();
  }

  /**
   * Reads the next line written to stdout or stderr (without its `\n` or
   * `\r\n`), or `null` once both streams close. Returns `null` immediately
   * when stdio is inherited. Lines read here are still included in the
   * final `ProcessResult`.
   */
  async readLine(): Future<String | null> {
    let next = await this.#proc.readLine();
    if (next is Some<String>) {
      return next.value;
    }
    return null;
  }

  /**
   * Asks the process to stop (`SIGTERM` on Unix, sent to its process group
   * when started with `processGroup: true`), waits up to `graceMillis`
   * for it to exit, and force-kills it if it is still running.
   */
  async stop(graceMillis: i64 = 2000): Future<ProcessResult> {
    let cached = this.#result;
    if (cached != null) {
      return cached;
    }
    let result = resultOf(await this.#proc.stop(graceMillis));
    this.#result = result;
    return result;
  }
}

/** How to start a process. Every field may be left out. */
export type SpawnOptions = {
  /**
   * The working directory, in this program's view of the file system;
   * this program's own if absent.
   */
  cwd?: String,
  /**
   * Connect the process to this program's own stdin, stdout and stderr,
   * so what it writes appears as it writes it. Its output is captured
   * into the result if absent.
   */
  inheritStdio?: boolean,
  /**
   * Start the process in a new process group of its own on Unix, so
   * `stop` and timeouts reach any child processes it spawns too.
   */
  processGroup?: boolean,
  /**
   * Written to the process's stdin, which is then closed. The process
   * reads end of input straight away if absent.
   */
  input?: String,
  /**
   * Environment variables to set in the process, which otherwise inherits
   * this program's host's environment.
   */
  env?: Array<(String, String)>,
  /** Environment variables to leave out of the process's environment. */
  envRemove?: Array<String>,
};

/**
 * Start a process from an argument vector, the program first.
 *
 * ```zena
 * let sorted = await runWith(['sort'], {input: 'b\na\n'});
 * ```
 */
export function spawnWith(argv: Array<String>, options: SpawnOptions): Own<Process> {
  let cmd = Command.create(argv);
  if (let {cwd} = options) {
    cmd.cwd(cwd);
  }
  let {inheritStdio = false} = options;
  if (inheritStdio) {
    cmd.inheritStdio();
  }
  let {processGroup = false} = options;
  if (processGroup) {
    cmd.processGroup();
  }
  if (let {input} = options) {
    cmd.input(input.toBytes());
  }
  if (let {envRemove} = options) {
    for (let name in envRemove) {
      cmd.envRemove(name);
    }
  }
  if (let {env} = options) {
    for (let (name, value) in env) {
      cmd.env(name, value);
    }
  }
  match (cmd.spawn()) {
    case (true, let proc): { return new Process(proc); }
    case (false, let why): {
      throw new Error(`could not start ${argv[0]}: ${why}`);
    }
  }
}

/** Runs a process to completion; see `spawnWith`. */
export async function runWith(
  argv: Array<String>,
  options: SpawnOptions,
): Future<ProcessResult> {
  let proc = spawnWith(argv, options);
  return await proc.wait();
}

/**
 * Start a process from an argument vector, the program first, in the
 * directory `cwd` (this program's own when null). With `inheritStdio`
 * the process writes to this program's own streams instead of having
 * its output captured.
 */
export function spawnIn(
  argv: Array<String>,
  cwd: String | null,
  inheritStdio: boolean = false,
): Own<Process> {
  if (cwd != null) {
    return spawnWith(argv, {cwd: cwd, inheritStdio: inheritStdio});
  }
  return spawnWith(argv, {inheritStdio: inheritStdio});
}

export function spawn(argv: Array<String>): Own<Process> {
  return spawnIn(argv, null);
}

export async function runIn(
  argv: Array<String>,
  cwd: String | null,
): Future<ProcessResult> {
  let proc = spawnIn(argv, cwd);
  return await proc.wait();
}

export async function run(argv: Array<String>): Future<ProcessResult> {
  let proc = spawnIn(argv, null);
  return await proc.wait();
}

/**
 * Run a process connected to this program's own stdio, so its output
 * appears as it is written; the result's `stdout` and `stderr` are
 * empty.
 */
export async function runInheriting(
  argv: Array<String>,
  cwd: String | null = null,
): Future<ProcessResult> {
  let proc = spawnIn(argv, cwd, true);
  return await proc.wait();
}

/** Signal number for `SIGINT` (`Ctrl-C`). */
export let SIGINT = 2;

/** Signal number for `SIGTERM`. */
export let SIGTERM = 15;

/**
 * Installs handlers for `SIGINT` and `SIGTERM` on the host process so
 * termination signals can be observed with `checkSignal` and `waitSignal`
 * instead of ending the process immediately.
 */
export function listenSignals(): void {
  hostListenSignals();
}

/**
 * Returns the first termination signal received since `listenSignals`
 * (`SIGINT` = 2, `SIGTERM` = 15), or `0` if none has arrived.
 */
export function checkSignal(): i32 {
  return hostCheckSignal();
}

/**
 * Waits up to `millis` milliseconds for `SIGINT` or `SIGTERM` (enabling
 * `listenSignals` if not already active). A non-positive `millis` waits
 * indefinitely. Returns the signal number (`2` or `15`), or `0` if the
 * timeout elapsed first.
 */
export async function waitSignalFor(millis: i64): Future<i32> {
  return await hostWaitSignal(millis);
}

/**
 * Waits for `SIGINT` or `SIGTERM` (enabling `listenSignals` if not
 * already active) and returns the signal number (`2` or `15`).
 */
export async function waitSignal(): Future<i32> {
  return await hostWaitSignal(0 as i64);
}
