/**
 * zena:task — operations as values (docs/design/cancellation.md;
 * PLAN.md, async roadmap).
 *
 * An operation that can be started is a value, `Op<T> = () =>
 * Future<T>`, and this module is the algebra over such values:
 * combinators from `Op<T>` to `Op<T>`, so composition order is
 * syntax:
 * `retry(3, timeout(100, op))` gives every attempt its own 100ms
 * budget, `timeout(500, retry(3, op))` one budget over all of them.
 *
 * Two rules make the algebra sound. Policies act on FAILURES and
 * never on cancellation: an ambient cancel passes through every
 * combinator untouched — `catch` cannot observe the cancellation
 * channel, so retrying cancelled work is not even expressible here —
 * because a retry after cancel would outlive the scope tree that
 * cancelled it. And racing combinators start their candidates inside
 * a `TaskGroup`, so a loser or an expired attempt is actually
 * cancelled rather than left running (the thing a resilience layer
 * over bare promises cannot do).
 *
 * An `Op` is called once per attempt: the operation must be a
 * future-RETURNING function, not a future. A future is work already
 * started — it cannot be attempted again.
 *
 * The planned Task class — an operation's observable lifecycle
 * (initial, pending, complete, error), in the style of @lit/task —
 * belongs here too: a Task runs an `Op`, and these combinators are
 * the policies a Task runs it under.
 */

import { Error } from 'zena:error';
import {
  Future, Completer, TaskGroup, CancelScope, scheduleMicrotask,
} from 'zena:async';
import { sleep, monotonicMs } from 'zena:time';
import { i32ToString } from 'zena:string-convert';

/** An operation that can be attempted. Each call starts one fresh
 * attempt and hands back its future. */
export type Op<T> = () => Future<T>;

/** How `timeout` and `deadline` report an attempt that ran out of
 * budget. Carries the budget so a retry layer's log can say which. */
export class TimeoutError extends Error {
  budgetMs: i32;
  new(this.budgetMs)
    : super('timed out after ' + i32ToString(budgetMs) + 'ms');
}

/**
 * Bounds each attempt to `ms` of wall time: the attempt races its
 * budget, and whichever loses is cancelled. An attempt that exceeds
 * the budget fails with `TimeoutError` — a failure like any other, so
 * an outer `retry` treats a timeout as retryable.
 */
export let timeout = <T>(ms: i32, op: Op<T>): Op<T> => {
  // The budget arm's annotation is load-bearing: its body only
  // throws, which infers `Future<void>` rather than the race's `T`.
  return () => TaskGroup.race<T>([op, async (): Future<T> => {
    await sleep(ms);
    throw new TimeoutError(ms);
  }]);
};

/**
 * Bounds each attempt to finish before an absolute point on the
 * monotonic clock (`monotonicMs()`), however many layers retry it:
 * where `timeout` gives every attempt a fresh budget, a deadline
 * spends one budget across all of them. An attempt starting past the
 * deadline fails immediately, without running the operation.
 */
export let deadline = <T>(atMs: f64, op: Op<T>): Op<T> => {
  return (): Future<T> => {
    let remaining = atMs - monotonicMs();
    if (remaining <= 0.0) {
      return Future.failed<T>(new TimeoutError(0));
    }
    // `timeout(...)()` in one expression is issue #448 — a call whose
    // callee is itself a call does not lower yet.
    let bounded = timeout<T>(remaining as i32, op);
    return bounded();
  };
};

/** `retry`'s body. A top-level function rather than an async closure
 * because an `await` inside a `try` inside a loop crashes emission in
 * closure position (issue #453); fold it into `retry` when that is
 * fixed. */
let retryImpl = async <T>(
    attempts: i32, firstDelayMs: i32, op: Op<T>): Future<T> => {
  var delay = firstDelayMs;
  var failed = 0;
  while (failed < attempts - 1) {
    try {
      return await op();
    } catch (e) {
      failed += 1;
      if (delay > 0) {
        await sleep(delay);
        // Exponential: each wait doubles the last.
        delay = delay * 2;
      }
    }
  }
  // The last attempt runs outside the loop so its failure propagates
  // as the result.
  return await op();
};

/**
 * Runs up to `attempts` attempts, handing back the first value; the
 * last attempt's failure propagates. With `firstDelayMs`, waits that
 * long before the second attempt and doubles the wait each time after.
 *
 * Retrying is the reason `Op` is a function: each attempt is a fresh
 * call. Cancellation is not retried — see the module comment.
 */
export let retry = <T>(
    attempts: i32, op: Op<T>, firstDelayMs: i32 = 0): Op<T> => {
  if (attempts < 1) {
    throw new Error('retry: needs at least one attempt');
  }
  return () => retryImpl<T>(attempts, firstDelayMs, op);
};

/**
 * Tries `op`; on failure, answers with `alt` instead. The failure
 * that triggered the fallback is discarded — when it matters, catch
 * it yourself. Cancellation is not a failure: if `op`'s attempt
 * completes cancelled, the unwind passes through and `alt` never
 * runs.
 */
export let fallback = <T>(op: Op<T>, alt: Op<T>): Op<T> => {
  return async () => {
    try {
      return await op();
    } catch (e) {
      return await alt();
    }
  };
};

/**
 * Starts a second attempt if the first has not settled within
 * `delayMs`, and hands back whichever settles first, value or
 * failure — the tool for an operation that is usually fast and
 * occasionally very slow. The loser is cancelled. A hedge trims
 * slowness and does not mask errors; layer `retry` on top for that.
 */
export let hedge = <T>(delayMs: i32, op: Op<T>): Op<T> => {
  return () => TaskGroup.race<T>([op, async () => {
    await sleep(delayMs);
    return await op();
  }]);
};

// ---------------------------------------------------------------------------
// Task<T>: an operation's observable lifecycle (docs/design/task.md)
// ---------------------------------------------------------------------------

/** Where a task's latest run stands. Cancellation is not a state: a
 * cancelled run restores the state the task held before it
 * (docs/design/task.md, "The state, as data"). */
export sealed class TaskState<T> {
  case Initial, Pending, Complete, Errored
}

/** No run has settled yet. */
export final class Initial<T> extends TaskState<T> {}

/** A run is in flight. Deliberately carries no future: only the
 * latest run's outcome ever becomes the state, and a held future
 * could outlive its run's relevance. */
export final class Pending<T> extends TaskState<T> {}

/** The latest settled run produced this value. */
export final class Complete<T>(value: T) extends TaskState<T>

/** The latest settled run failed with this error. */
export final class Errored<T>(error: Error) extends TaskState<T>

/** The monitor's reporting entry points, keyed by unexported symbols
 * so only this module can settle a task's state
 * (docs/design/classes.md §9.4). */
symbol reportPending;
symbol reportSettled;
symbol reportCancelled;
symbol takeCompleter;

/**
 * Runs an operation and exposes where the run stands — `Initial`,
 * `Pending`, `Complete`, or `Errored` — across however many runs,
 * latest-wins (docs/design/task.md).
 *
 * The op is fixed at construction with its policies already composed:
 * `new Task(retry(3, timeout(100, fetchUser)))`. Each run starts the
 * op inside a child `CancelScope`, so a superseding `run()` cancels
 * the previous attempt's whole subtree rather than racing it for the
 * state.
 */
export class Task<T> {
  #op: Op<T>;
  /** Called after every transition, from the microtask queue. */
  #onChange: (() => void)?;
  /** Backs `state`; `var(#state) state` is the shape this wants,
   * blocked on issue #463 (field initializer + var(#) crashes). */
  var #state: TaskState<T> = new Initial<T>();
  /** What a cancelled run restores. */
  var #prev: TaskState<T> = new Initial<T>();
  var #scope: CancelScope? = null;
  var #runId = 0;
  /** Settles `completed`: minted lazily, carried across supersession,
   * replaced by the next run after a settle. */
  var #completed: Completer<T>? = null;
  /** The changed() round: one completer shared by every waiter until
   * the next transition settles it. */
  var #round: Completer<void>? = null;

  new(op: Op<T>, onChange: (() => void)? = null)
    : #op = op, #onChange = onChange;

  /** Where the latest run stands. */
  state: TaskState<T> {
    get {
      return this.#state;
    }
  }

  /**
   * The latest run's eventual answer: the value or failure of
   * whichever run is current when one settles. Supersession carries
   * it forward to the new run; a run started after a settle mints a
   * fresh one.
   */
  completed: Future<T> {
    get {
      return (this.#completed ??= new Completer<T>()).future;
    }
  }

  /** Settles at the next state transition after the call. */
  changed(): Future<void> {
    return (this.#round ??= new Completer<void>()).future;
  }

  /**
   * Starts a run, cancelling a pending previous one — superseded
   * before it arrived, its outcome discarded. Returns this run's
   * future, which settles the way the run does even if superseded.
   */
  run(): Future<T> {
    let prevScope = this.#scope;
    if (prevScope != null) {
      prevScope.cancel();
    }
    this.#runId += 1;
    let id = this.#runId;
    if (this.#completed == null || this.#isSettled()) {
      this.#completed = new Completer<T>();
    }
    let scope = new CancelScope();
    this.#scope = scope;
    let op = this.#op;
    let t = this;
    // In a generic class body `this` types as the bare generic
    // source (issue #434); the cast restores the instantiated type.
    return scope.run(() => monitorRun<T>(t as Task<T>, id, op));
  }

  /** Cancels a pending run; the previous settled state is restored
   * when the cancellation lands. A task with no run pending is
   * unchanged. */
  cancel(): void {
    let s = this.#scope;
    if (s != null) {
      s.cancel();
    }
  }

  [reportPending](id: i32): void {
    if (id != this.#runId) {
      return;
    }
    // The async ramp is eager, so this runs synchronously inside
    // run(): the state is Pending the moment run() returns, but the
    // notification goes through the queue — no user callback runs
    // inside another's frame. Waking the changed() round already
    // does (settling a completer schedules its waiters).
    this.#state = new Pending<T>();
    this.#wakeRound();
    let cb = this.#onChange;
    if (cb != null) {
      scheduleMicrotask(cb);
    }
  }

  [reportSettled](id: i32, s: TaskState<T>): void {
    if (id != this.#runId) {
      return;
    }
    this.#scope = null;
    this.#prev = s;
    this.#transition(s);
  }

  [reportCancelled](id: i32): void {
    if (id != this.#runId) {
      return;
    }
    this.#scope = null;
    // The restore keeps `completed` consistent with the state it
    // restores: a task holding Complete or Errored has a settled
    // `completed`, so a completer minted for the cancelled run
    // settles from the restored state.
    let c = this.#completed;
    let p = this.#prev;
    if (c != null && !c.future.isCompleted) {
      if (p is Complete<T>) {
        c.complete(p.value);
      } else if (p is Errored<T>) {
        c.fail(p.error);
      }
    }
    this.#transition(p);
  }

  /** The completer this run should settle, or null if superseded —
   * a superseded run must not settle `completed`, which has been
   * carried forward to the run that superseded it. */
  [takeCompleter](id: i32): Completer<T>? {
    return if (id != this.#runId) null else this.#completed;
  }

  #isSettled(): boolean {
    return this.#state is Complete<T> || this.#state is Errored<T>;
  }

  #wakeRound(): void {
    let r = this.#round;
    if (r != null) {
      this.#round = null;
      r.complete();
    }
  }

  #transition(s: TaskState<T>): void {
    this.#state = s;
    this.#wakeRound();
    let cb = this.#onChange;
    if (cb != null) {
      cb();
    }
  }
}

/**
 * One run: starts the op under the run's scope (the ramp binds the
 * frame to it), reports each transition back, and settles the way
 * the op does. Reporting happens from this frame — inside a
 * microtask — so `onChange` never runs inside `run()` itself.
 *
 * The settled value is never bound to a local: at `T = void` a
 * binding has no wasm type (issue #435), so the value rides argument
 * position (`new Complete<T>(await f)`) and the settled future is
 * re-awaited where needed — one queue hop to the same value.
 */
let monitorRun = async <T>(t: Task<T>, id: i32, op: Op<T>): Future<T> => {
  t.[reportPending](id);
  let f = op();
  try {
    await f;
  } cancel {
    t.[reportCancelled](id);
  } catch (e) {
    let c = t.[takeCompleter](id);
    if (c != null) {
      c.fail(e);
    }
    t.[reportSettled](id, new Errored<T>(e));
    throw e;
  }
  let c = t.[takeCompleter](id);
  if (c != null) {
    c.complete(await f);
  }
  t.[reportSettled](id, new Complete<T>(await f));
  return await f;
};
