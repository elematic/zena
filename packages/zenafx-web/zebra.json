{
  "scripts": {
    "build:engine": {
      "#": "Compile zenafx-render + the C-ABI bridge to wasm32-unknown-unknown.",
      "command": "cargo build --profile wasm-release --target wasm32-unknown-unknown -p zenafx-web-engine && mkdir -p out && cp ../../target/wasm32-unknown-unknown/wasm-release/zenafx_web_engine.wasm out/zenafx_web_engine.wasm",
      "files": [
        "engine/Cargo.toml",
        "engine/src/**/*.rs",
        "../zenafx-render/Cargo.toml",
        "../zenafx-render/src/**/*.rs",
        "../../Cargo.toml",
        "../../Cargo.lock"
      ],
      "output": ["out/zenafx_web_engine.wasm"]
    },
    "build": {
      "dependencies": ["build:engine"]
    },
    "test": {
      "command": "node --test test/web_runner_test.js",
      "files": [
        "src/**/*.js",
        "test/**/*.js",
        "out/zenafx_web_engine.wasm",
        "../zenafx/out/*.wasm"
      ],
      "dependencies": ["build", "../zenafx:build:examples"]
    },
    "demo": {
      "command": "node demo/serve.mjs",
      "dependencies": ["build", "../zenafx:build:examples"]
    }
  }
}
