/**
 * A language server: the Language Server Protocol over the language
 * service, for editors that start a server process and talk to it over
 * its standard input and output (Neovim, Helix, Zed and others).
 *
 * Messages are JSON-RPC, each framed by a `Content-Length` header.
 * `MessageReader` (in `framing.zena`) takes the bytes apart into
 * messages, `LspServer` answers each one, and `frame` puts a reply's
 * header on. The transport is the caller's: `zena lsp` connects them to
 * stdin and stdout.
 *
 * The server keeps whole documents: the client sends the full text of a
 * document when it opens and on every change. Positions in the protocol
 * are a line and a UTF-16 character offset into it; the service works in
 * UTF-8 byte offsets, and `positions.zena` converts.
 */

import { JsonBuilder, JsonObject, JsonValue, parseJson } from 'zena:json';
import { fileURLToPath, pathToFileURL } from 'zena:url';
import { Diagnostic } from 'zena-compiler:diagnostics';
import { format as formatSource } from 'zena-formatter:printer';
import { FileReader, LanguageService } from './service.zena';
import { normalizePath } from './host.zena';
import { offsetOf } from './positions.zena';
import {
  ErrorCode, RequestError, initializeResult, writeCompletion, writeDiagnostic, writeHover, writeRange, writeSpan, writeSymbol,
} from './protocol.zena';

export { MessageReader, frame } from './framing.zena';
export { Position, offsetOf, positionOf } from './positions.zena';

/**
 * The path a document's URI names. A URI other than a `file:` one, like
 * the `untitled:` an editor gives a buffer never saved, is used as the
 * path as it is.
 */
let pathOf = (uri: String): String =>
  if (uri.startsWith('file:')) { fileURLToPath(uri) } else { uri };

/** The URI for a path `pathOf` returned. */
let uriOf = (path: String): String =>
  if (path.startsWith('/')) { pathToFileURL(path) } else { path };

/**
 * Answers the protocol's messages from a language service.
 *
 * `send` is called with each outgoing message's JSON: replies to
 * requests, and the diagnostics it publishes when a document opens or
 * changes. Frame it with `frame` before writing it out.
 */
export final class LspServer {
  #service: LanguageService;
  #readFile: FileReader;
  #send: (json: String) => void;
  /** The text of each open document, by path. */
  #documents = new Map<String, String>();
  var #exited = false;

  new(service: LanguageService, readFile: FileReader, send: (json: String) => void)
    : #service = service, #readFile = readFile, #send = send;

  /** True once the client has sent `exit`. */
  exited: boolean {
    get {
      return this.#exited;
    }
  }

  /** Answers one message's body. */
  handle(body: String): void {
    let message = this.#parse(body);
    if (message == null) {
      return;
    }
    let method = message.stringAt('method') ?? '';
    // Absent params read as an empty object, so a request that needs one
    // of its fields gets the error for that field.
    let params = message.objectAt('params') ?? new JsonObject();
    if (!message.has('id')) {
      try {
        this.#notification(method, params);
      } catch (e) {
        console.error(`zena lsp: ${method}: ${e.message}`);
      }
      return;
    }
    let id = message['id'];
    try {
      let result = this.#request(method, params);
      if (result == null) {
        this.#error(id, ErrorCode.MethodNotFound, `Unsupported request: ${method}`);
      } else {
        this.#reply(id, result);
      }
    } catch (e) {
      let code = if (e is RequestError) { e.code } else { ErrorCode.InternalError };
      this.#error(id, code, e.message);
    }
  }

  /** A message's JSON object, or null after answering one that is not. */
  #parse(body: String): JsonObject | null {
    let message = try {
      parseJson(body)
    } catch (e) {
      this.#error(null, ErrorCode.ParseError, `Not JSON: ${e.message}`);
      return null;
    };
    if (message is JsonObject) {
      return message;
    }
    this.#error(null, ErrorCode.InvalidRequest, 'A message must be a JSON object');
    return null;
  }

  #notification(method: String, params: JsonObject): void {
    match (method) {
      case 'exit': {
        this.#exited = true;
      }
      case 'textDocument/didOpen': {
        this.#setDocument(this.#uriIn(params), params.stringAt('textDocument.text') ?? '');
      }
      case 'textDocument/didChange': {
        // Full synchronization: the last change holds the whole text.
        if (let (true, changes) = params.arrayAt('contentChanges')) {
          let last = if (changes.length > 0) { changes[changes.length - 1] } else { null };
          if (last is JsonObject) {
            this.#setDocument(this.#uriIn(params), last.stringAt('text') ?? '');
          }
        }
      }
      case 'textDocument/didClose': {
        let uri = this.#uriIn(params);
        let path = pathOf(uri);
        this.#documents.delete(path);
        this.#service.closeDocument(path);
        this.#publish(uri, path, '', new Array<Diagnostic>());
      }
      case _: {
        // Everything else ('initialized', '$/cancelRequest', saves) needs
        // nothing from a server that keeps whole documents.
      }
    }
  }

  /** A request's result as JSON, or null for a method the server lacks. */
  #request(method: String, params: JsonObject): String | null {
    return match (method) {
      case 'initialize': initializeResult()
      case 'shutdown': 'null'
      case 'textDocument/hover': this.#hover(params)
      case 'textDocument/definition': this.#definition(params)
      case 'textDocument/documentSymbol': this.#documentSymbols(params)
      case 'textDocument/completion': this.#completions(params)
      case 'textDocument/formatting': this.#formatting(params)
      case _: null
    };
  }

  /** The URI of the document a message is about. */
  #uriIn(params: JsonObject): String {
    if (let (true, uri) = params.stringAt('textDocument.uri')) {
      return uri;
    }
    throw new RequestError(ErrorCode.InvalidParams, 'The message names no document');
  }

  /** The text of an open document; empty for one the client has not opened. */
  #openText(path: String): String {
    return this.#documents.getOr(path, '');
  }

  /** The byte offset in `text` of the position a request names. */
  #offsetIn(params: JsonObject, text: String): i32 {
    if (let (true, line) = params.intAt('position.line')) {
      if (let (true, character) = params.intAt('position.character')) {
        return offsetOf(text, {line: line, character: character});
      }
    }
    throw new RequestError(ErrorCode.InvalidParams, 'The request has no position');
  }

  /** Records a document's text, checks it, and publishes what it found. */
  #setDocument(uri: String, text: String): void {
    let path = pathOf(uri);
    this.#documents[path] = text;
    this.#publish(uri, path, text, this.#service.check(path, text));
  }

  /**
   * Sends the diagnostics that belong to `path`. A check also reports
   * problems in the files a document imports; those are left for when
   * the files are opened themselves.
   */
  #publish(uri: String, path: String, text: String, diagnostics: Array<Diagnostic>): void {
    let b = new JsonBuilder();
    b.beginObject().key('jsonrpc').string('2.0')
      .key('method').string('textDocument/publishDiagnostics')
      .key('params').beginObject().key('uri').string(uri)
      .key('diagnostics').beginArray();
    let key = normalizePath(path);
    for (let diagnostic in diagnostics) {
      let location = diagnostic.location;
      if (location == null || normalizePath(location.file) == key) {
        writeDiagnostic(b, text, diagnostic);
      }
    }
    b.endArray().endObject().endObject();
    let send = this.#send;
    send(b.toString());
  }

  #hover(params: JsonObject): String {
    let path = pathOf(this.#uriIn(params));
    let hover = this.#service.getHover(path, this.#offsetIn(params, this.#openText(path)));
    if (hover == null) {
      return 'null';
    }
    let b = new JsonBuilder();
    writeHover(b, hover);
    return b.toString();
  }

  /** The text of a file, open or on disk; null when it cannot be read. */
  #fileText(path: String): String | null {
    if (let (true, open) = this.#documents.get(path)) {
      return open;
    }
    let read = this.#readFile;
    return read(path);
  }

  #definition(params: JsonObject): String {
    let path = pathOf(this.#uriIn(params));
    let span = this.#service.getDefinition(path, this.#offsetIn(params, this.#openText(path)));
    if (span == null) {
      return 'null';
    }
    let b = new JsonBuilder();
    b.beginObject().key('uri').string(uriOf(span.file)).key('range');
    let text = this.#fileText(span.file);
    if (text != null) {
      writeSpan(b, text, span.start, span.start + span.length);
    } else {
      // Without the text, the line and column the span carries are the
      // best there is; the column counts bytes.
      let at = {line: span.line - 1, character: span.column - 1};
      writeRange(b, at, at);
    }
    b.endObject();
    return b.toString();
  }

  #documentSymbols(params: JsonObject): String {
    let path = pathOf(this.#uriIn(params));
    let text = this.#openText(path);
    let b = new JsonBuilder();
    b.beginArray();
    for (let entry in this.#service.getDocumentSymbols(path, text)) {
      writeSymbol(b, text, entry);
    }
    b.endArray();
    return b.toString();
  }

  #completions(params: JsonObject): String {
    let path = pathOf(this.#uriIn(params));
    let b = new JsonBuilder();
    b.beginArray();
    for (let item in this.#service.getCompletions(path, this.#offsetIn(params, this.#openText(path)))) {
      writeCompletion(b, item);
    }
    b.endArray();
    return b.toString();
  }

  /** One edit replacing the whole document, or none if it is formatted. */
  #formatting(params: JsonObject): String {
    let text = this.#openText(pathOf(this.#uriIn(params)));
    let formatted = formatSource(text);
    let b = new JsonBuilder();
    b.beginArray();
    if (formatted != text) {
      b.beginObject().key('range');
      writeSpan(b, text, 0, text.length);
      b.key('newText').string(formatted).endObject();
    }
    b.endArray();
    return b.toString();
  }

  /** Sends a request's result, given as JSON. */
  #reply(id: JsonValue, result: String): void {
    let b = new JsonBuilder();
    b.beginObject()
      .key('jsonrpc').string('2.0')
      .key('id').value(id)
      .key('result').raw(result)
      .endObject();
    let send = this.#send;
    send(b.toString());
  }

  #error(id: JsonValue, code: ErrorCode, message: String): void {
    let b = new JsonBuilder();
    b.beginObject()
      .key('jsonrpc').string('2.0')
      .key('id').value(id)
      .key('error').beginObject()
        .key('code').i32(code as i32)
        .key('message').string(message)
        .endObject()
      .endObject();
    let send = this.#send;
    send(b.toString());
  }
}
