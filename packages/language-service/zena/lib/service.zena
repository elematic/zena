/**
 * The language service: what an editor asks about Zena source, answered
 * from the compiler's own analysis. Diagnostics, hover, go to definition,
 * completions and document symbols.
 *
 * It keeps the documents an editor has open and serves them to the
 * compiler in place of the files on disk, and keeps the compiler between
 * requests so that unchanged files are not checked again.
 *
 * Two programs use it: `lsp.zena`, the module the VS Code extension and
 * the playground load, and `zena lsp`, the language server in the zena
 * command. Each passes in how to read a file that is not open.
 *
 * Each feature is in a module of its own: `hover.zena`,
 * `completion.zena` and `symbols.zena`, and `compile.zena` generates code
 * for the playground. This one keeps the compiler and the analysis they
 * share, and finds definitions.
 */

import {
  Compiler, CompilerTarget, createCompiler, checkCompilation, ProgramCheckResult, findNodeAtOffset, resolveMemberDefinition, CompilationResult,
} from 'zena-compiler:compiler';
import { parse as parseSource, ParseCompleteness } from 'zena-compiler:parser';
import { PackageConfig } from 'zena-compiler:module-resolver';
import {
  Diagnostic, DiagnosticCode, SourceSpan, DiagnosticSeverity
} from 'zena-compiler:diagnostics';
import { Symbol, ScopeResult } from 'zena-compiler:scope';
import { Program, CompilationUnit } from 'zena-compiler:program';
import { DocumentHost, FileReader, normalizePath } from './host.zena';
import { FileAnalysis, symbolUnder } from './analysis.zena';
import { HoverResult, hoverAt } from './hover.zena';
import { CompletionItem, memberCompletions, scopeCompletions } from './completion.zena';
import { DocumentSymbol, documentSymbols } from './symbols.zena';

export { FileReader } from './host.zena';
export { HoverResult } from './hover.zena';
export { CompletionItem, CompletionItemKind } from './completion.zena';
export { DocumentSymbol, SymbolKind } from './symbols.zena';

/**
 * The 0-based byte offset of a 1-based line and column in `source`, the
 * end of the source for a column past the last line's end, and 0 for a
 * line past the end.
 */
let offsetOf = (source: String, line: i32, column: i32): i32 => {
  var currentLine = 1;
  var currentColumn = 1;
  var i = 0;
  while (i < source.length) {
    if (currentLine == line && currentColumn == column) {
      return i;
    }
    if (source.getByteAt(i) == 10) {
      currentLine += 1;
      currentColumn = 1;
    } else {
      currentColumn += 1;
    }
    i += 1;
  }
  return if (currentLine == line) { i } else { 0 };
};

/**
 * A diagnostic for a compile that threw instead of reporting. The
 * message's first line may start with `file:line:column:`, which becomes
 * the diagnostic's location.
 */
let diagnosticFromError = (message: String, source: String): Diagnostic => {
  let firstLine = message.split('\n')[0];
  let parts = firstLine.split(':');
  if (parts.length >= 4) {
    let file = parts[0];
    if (let (true, line) = parseI32(parts[1])) {
      if (let (true, column) = parseI32(parts[2])) {
        let location = new SourceSpan(file, offsetOf(source, line, column), 1, line, column);
        let prefixLength = file.length + parts[1].length + parts[2].length + 4;
        let text = if (firstLine.length > prefixLength) {
          firstLine.sliceBytes(prefixLength, firstLine.length)
        } else {
          message
        };
        return new Diagnostic(DiagnosticCode.UnexpectedToken, text, DiagnosticSeverity.Error, location);
      }
    }
  }
  return new Diagnostic(DiagnosticCode.UnexpectedToken, message, DiagnosticSeverity.Error, null);
};

/**
 * Stateful language service backed by a persistent Compiler.
 *
 * Owns the compiler host, compiler instance, and cached analysis
 * results. The compiler's LibraryLoader caches parsed stdlib files
 * across calls so they aren't re-parsed on every keystroke.
 */
export class LanguageService {
  #host: DocumentHost;
  #compiler: Compiler;
  /** The target the editor's code is analyzed for; fixed for the service's life. */
  #targetName: String;
  var #checked: ProgramCheckResult | null = null;
  /** Scopes of every library the last compiles reached, by normalized path. */
  #scopes = new Map<String, ScopeResult>();
  /** The last compile of each document checked, by normalized path. */
  #compilations = new Map<String, CompilationResult>();

  new(host: DocumentHost, compiler: Compiler, targetName: String)
    : #host = host, #compiler = compiler, #targetName = targetName;

  /** The compiler's library set for this service's target. */
  #target: CompilerTarget {
    get { return this.#compiler.forTarget(this.#targetName); }
  }

  /** Compile `entry` on this service's target. */
  #compile(entry: String): CompilationResult {
    return this.#compiler.compile({entry, target: this.#targetName});
  }

  preloadStdlib(): void {
    try {
      this.#checked =
          checkCompilation(this.#compile('zena:core/index.zena'), this.#checked);
    } catch (e) {
      // Best-effort preload
    }
  }

  /**
   * Register or update an open document's source in the host and compiler cache.
   */
  openDocument(path: String, source: String): void {
    let key = normalizePath(path);
    this.#host.setDocument(path, source);
    this.#host.setDocument(key, source);
    this.#compiler.delete(path);
    this.#compiler.delete(key);
  }

  /**
   * Remove an open document, evicting it from compiler cache and analysis state.
   */
  closeDocument(path: String): void {
    let key = normalizePath(path);
    this.#host.deleteDocument(path);
    this.#host.deleteDocument(key);
    this.#compiler.delete(path);
    this.#compiler.delete(key);
    this.#compilations.delete(key);
    this.#scopes.delete(key);
  }

  /**
   * Parse, scope-analyze, and type-check a source string with full
   * cross-module import resolution.
   *
   * Updates the open documents map for `path` so that any module
   * importing this file sees the editor's version, then compiles
   * starting from `path` as the root of the dependency tree.
   */
  check(path: String, source: String): Array<Diagnostic> {
    this.openDocument(path, source);

    let diagnostics = try {
      let result = this.#compile(path);

      // Scopes for every file the compile reached, so that definition
      // and hover work in a dependency the editor navigates into.
      for (let file in result.files) {
        let scopes = file.scopeResult;
        if (scopes != null) {
          this.#scopes[normalizePath(file.path)] = scopes;
        }
      }
      this.#compilations[normalizePath(path)] = result;

      // Type-check all modules, carrying forward unchanged results.
      let checked = checkCompilation(result, this.#checked);
      this.#checked = checked;

      // Recovering from a parse error does not excuse it. The file was
      // analyzed anyway, so report what the parser had to work around
      // ahead of what the checker went on to find.
      let diagnostics = new Array<Diagnostic>(checked.diagnostics.length);
      for (let file in result.files) {
        for (let parseError in file.parseErrors) {
          diagnostics.push(parseError);
        }
      }
      for (let diagnostic in checked.diagnostics) {
        diagnostics.push(diagnostic);
      }
      diagnostics
    } catch (e) {
      let diagnostics = new Array<Diagnostic>(1);
      diagnostics.push(diagnosticFromError(e.message, source));
      diagnostics
    };
    return diagnostics;
  }

  /**
   * A document checked for running: the program to generate code from,
   * or null when it has errors. `compile.zena` generates the code.
   */
  checkProgram(path: String, source: String): Program | null {
    this.#host.setDocument(path, source);
    this.#compiler.invalidate(path);
    let compiled = this.#compile(path);

    // A recovered AST holds stand-ins where the user has not finished
    // typing, so it must not reach codegen. Check here rather than
    // below: parse errors are not in the checker's diagnostics, so the
    // error scan that follows would report none.
    for (let file in compiled.files) {
      if (file.completeness != ParseCompleteness.Complete) {
        return null;
      }
    }

    let checked = checkCompilation(compiled, this.#checked);
    this.#checked = checked;
    for (let diagnostic in checked.diagnostics) {
      if (diagnostic.severity == DiagnosticSeverity.Error) {
        return null;
      }
    }

    let units = new Array<CompilationUnit>();
    var entryUnit: CompilationUnit | null = null;
    for (let file in compiled.files) {
      if (let (true, res) = checked.results.get(file.path)) {
        let unit = {ast: file.ast, model: res.model};
        units.push(unit);
        if (file.path == compiled.entry.path || file.ast.path == compiled.entry.ast.path) {
          entryUnit = unit;
        }
      } else {
        console.error(`File not in checkResult: ${file.path}`);
      }
    }
    if (entryUnit == null && units.length > 0) {
      entryUnit = units[units.length - 1];
    }
    return new Program(units, entryUnit);
  }

  #scopesOf(key: String): ScopeResult | null {
    if (let (true, scopes) = this.#scopes.get(key)) {
      return scopes;
    }
    return null;
  }

  /**
   * The analysis of a checked file: the entry of a compile, or a file one
   * reached, which an editor opens by going to a definition in it.
   */
  #analysis(key: String): FileAnalysis | null {
    let checked = this.#checked;
    if (checked == null) {
      return null;
    }
    let scopes = this.#scopesOf(key);
    if (let (true, compilation) = this.#compilations.get(key)) {
      if (let (true, result) = checked.results.get(compilation.entry.path)) {
        return {ast: compilation.entry.ast, model: result.model, scopes: scopes};
      }
    }
    if (let (true, result) = checked.results.get(key)) {
      let source = this.#target.getSourceFile(key);
      if (source != null) {
        return {ast: source.ast, model: result.model, scopes: scopes};
      }
    }
    return null;
  }

  /**
   * Where a symbol is declared. An import leads to the declaration it
   * names, in the module that declares it. That is only sometimes the
   * module the import names: `import { Error } from 'zena:core'` names
   * the library's entry point, and the declaration is in a file behind
   * it.
   */
  #declarationSpan(sym: Symbol, key: String): SourceSpan | null {
    let target = sym.resolveTarget();
    let decl = target.declaration;
    if (decl == null) {
      return null;
    }
    let loc = decl.loc;
    if (loc == null) {
      return null;
    }
    let file = if (target.modulePath.length > 0) {
      this.#host.resolveToFilesystemPath(target.modulePath)
    } else {
      key
    };
    return new SourceSpan(file, loc.start, loc.end - loc.start, loc.line, loc.column);
  }

  /** The definition of what is at a byte offset in a checked file. */
  getDefinition(path: String, offset: i32): SourceSpan | null {
    let key = normalizePath(path);
    let scopes = this.#scopesOf(key);
    if (scopes == null) {
      return null;
    }
    let file = this.#analysis(key);
    let node = if (file == null) { null } else { findNodeAtOffset(file.ast, offset) };
    let sym = symbolUnder(scopes, node, offset);
    if (sym != null) {
      return this.#declarationSpan(sym, key);
    }
    // A member access, like the `x` in `p.x`, has no symbol of its own:
    // the member is found through the object's type.
    if (file == null) {
      return null;
    }
    return resolveMemberDefinition(file.ast, offset, file.model, scopes, this.#target);
  }

  /** Hover for a byte offset in a checked file, or null for none. */
  getHover(path: String, offset: i32): HoverResult | null {
    let checked = this.#checked;
    let file = this.#analysis(normalizePath(path));
    if (checked == null || file == null) {
      return null;
    }
    return hoverAt(file, offset, checked, this.#target);
  }

  /** Completions at a byte offset. */
  getCompletions(path: String, offset: i32): Array<CompletionItem> {
    let key = normalizePath(path);
    let checked = this.#checked;
    let file = this.#analysis(key);
    if (checked != null && file != null) {
      let members = memberCompletions(file, offset, checked);
      if (members != null) {
        return members;
      }
    }
    return scopeCompletions(this.#scopesOf(key));
  }

  /**
   * The outline of a document: its top-level declarations, and in a test
   * file its suites and tests. It parses `source` itself, so it works on
   * a document that has not been checked.
   */
  getDocumentSymbols(path: String, source: String): Array<DocumentSymbol> {
    let symbols = try {
      documentSymbols(parseSource(source, path))
    } catch (e) {
      new Array<DocumentSymbol>()
    };
    return symbols;
  }
}

/**
 * Create a LanguageService with the standard pipeline. `readFile` reads
 * the files that are not open, the standard library's included;
 * `target` decides which of the standard library's per-target modules
 * the analysis sees; and `packages` is the package map imports like
 * `zena-compiler:parser` resolve through, none if null.
 */
export let createLanguageService = (
  stdlibRoot: String,
  readFile: FileReader,
  target: String = 'js',
  packageMap: Map<String, PackageConfig> | null = null,
): LanguageService => {
  let host = new DocumentHost(stdlibRoot, readFile);
  let packages = packageMap ?? new Map<String, PackageConfig>();
  // Source in an editor is source mid-edit: recover from what can be
  // recovered from, so an unfinished import still yields an AST to
  // answer completions and symbols against. The errors are still
  // reported — check() folds them in with the rest.
  let compiler = createCompiler(host, {
    stdlibRoot,
    packages,
    recoverFromParseErrors: true,
  });
  let ls = new LanguageService(host, compiler, target);
  ls.preloadStdlib();
  return ls;
};
