/**
 * Language service entry point.
 *
 * This module is compiled to WASM and loaded by the VS Code extension.
 * It exports functions that the JS host calls to check source files,
 * format documents, and read back diagnostics.
 *
 * The API is handle-based: check() returns an opaque result reference
 * (a WASM GC object passed as externref). The host passes this handle
 * back to getter functions to read individual diagnostic fields. When
 * the JS side drops the reference, the WASM GC collects the result.
 *
 * String parameters (source, path) are passed as externref via the
 * $stringCreate/$stringSetByte exports. String results (messages) are
 * returned as externref and read via $stringGetByte/$stringGetLength.
 *
 * Cross-module imports are resolved via the full Compiler pipeline.
 * The host provides a read_file import so the compiler can load
 * dependency sources from the filesystem.
 */

import { Diagnostic, DiagnosticSeverity, SourceSpan } from 'zena-compiler:diagnostics';
import { PackageConfig } from 'zena-compiler:module-resolver';
import { loadWorkspace } from 'zena-compiler:package-manifest';
import { DocumentHost } from './lib/host.zena';
import { format as formatSource } from 'zena-formatter:printer';
import {
  CompletionItem, DocumentSymbol, Edit, HoverResult, LanguageService,
  createLanguageService,
} from './lib/service.zena';
import { compileToWasm as compileDocument } from './lib/compile.zena';
import { pending, toPromise } from 'zena:js';

// ============================================================================
// Host imports
// ============================================================================

/**
 * Read a file from the host filesystem by absolute path. The JS side
 * provides this import at instantiation time, as a host-async import
 * (`asyncImports` in `@zena-lang/runtime`): it completes `handle` with
 * the file's text, or fails it when there is no such file.
 */
@external("compiler", "read_file")
declare function __read_file(handle: i32, path: String, len: i32): void;

/**
 * Reads a file through the JS host's `read_file` import; null when
 * there is no such file.
 */
async function readHostFile(path: String): Future<String | null> {
  let p = pending<String>();
  __read_file(p.handle, path, path.length);
  try {
    return await p.future;
  } catch (e) {
    return null;
  }
}

// ============================================================================
// WASM Exports — flat function API for the JS host
// ============================================================================

/** Singleton LanguageService, created by init(). */
var __ls: LanguageService | null = null;

/**
 * The exports that compile, or read files, await the service, and a
 * Wasm export cannot return a `Future` the host could use. Each returns
 * a JavaScript promise instead, which `toPromise` settles as the future
 * does: with the handle the synchronous export used to return, or a
 * rejection carrying the failure's message.
 */

/**
 * Initialize the language service with the path to the stdlib sources.
 * Must be called once before check(); the promise settles when the
 * service is ready.
 */
export function init(stdlibRoot: String): anyref {
  return toPromise(initService(stdlibRoot));
}

async function initService(stdlibRoot: String): Future<void> {
  // The workspace's packages, when the host can read its manifests from
  // the working directory, so that imports like `wit-parser:wit` resolve
  // the way they do for `zena build`. Without them a library of a
  // package in this repository reports every such import missing.
  let manifest = await readHostFile("zena-package.json");
  let packageMap: Map<String, PackageConfig> | null = if (manifest != null) {
    await loadWorkspace(new DocumentHost(stdlibRoot, readHostFile), ".")
  } else {
    null
  };
  __ls = createLanguageService(stdlibRoot, readHostFile, 'zena-js', packageMap);
}

/**
 * Check a source file. See LanguageService.check(). The promise resolves
 * with the diagnostics' handle.
 */
export function check(path: String, source: String): anyref {
  return toPromise((__ls as LanguageService).check(path, source));
}

/**
 * Check a source file against an explicit target.
 */
export function checkForTarget(path: String, source: String, target: String): anyref {
  return toPromise((__ls as LanguageService).checkForTarget(path, source, target));
}

/**
 * Register or update an open document.
 */
export function openDocument(path: String, source: String): void {
  if (__ls != null) {
    __ls.openDocument(path, source);
  }
}

/**
 * Close an open document and remove it from cache.
 */
export function closeDocument(path: String): void {
  if (__ls != null) {
    __ls.closeDocument(path);
  }
}

/**
 * Format a Zena source string and return the formatted result.
 */
export function format(source: String): String {
  return formatSource(source);
}

/**
 * Find the definition at a byte offset. See LanguageService.getDefinition().
 */
export function getDefinition(path: String, offset: i32): SourceSpan | null {
  return (__ls as LanguageService).getDefinition(path, offset);
}

// ============================================================================
// Definition Getters
// ============================================================================

/**
 * Get the file path of a definition result.
 */
export function getDefinitionFile(result: SourceSpan): String {
  return result.file;
}

/**
 * Get the 1-based line number of a definition result.
 */
export function getDefinitionLine(result: SourceSpan): i32 {
  return result.line;
}

/**
 * Get the 1-based column number of a definition result.
 */
export function getDefinitionColumn(result: SourceSpan): i32 {
  return result.column;
}

/**
 * Get the 0-based start byte offset of a definition result.
 */
export function getDefinitionStart(result: SourceSpan): i32 {
  return result.start;
}

/**
 * Get the byte length of the definition span.
 */
export function getDefinitionLength(result: SourceSpan): i32 {
  return result.length;
}

// ============================================================================
// Diagnostic Getters
// ============================================================================

/**
 * Get the number of diagnostics in a result.
 */
export function getDiagnosticCount(diagnostics: Array<Diagnostic>): i32 {
  return diagnostics.length;
}

/**
 * Get the 1-based line number of the i-th diagnostic.
 * Returns 0 if the diagnostic has no location.
 */
export function getDiagnosticLine(diagnostics: Array<Diagnostic>, index: i32): i32 {
  let diag = diagnostics[index];
  if (diag.location != null) {
    return (diag.location as SourceSpan).line;
  }
  return 0;
}

/**
 * Get the 1-based column number of the i-th diagnostic.
 * Returns 0 if the diagnostic has no location.
 */
export function getDiagnosticColumn(diagnostics: Array<Diagnostic>, index: i32): i32 {
  let diag = diagnostics[index];
  if (diag.location != null) {
    return (diag.location as SourceSpan).column;
  }
  return 0;
}

/**
 * Get the 0-based start byte offset of the i-th diagnostic.
 * Returns -1 if the diagnostic has no location.
 */
export function getDiagnosticStart(diagnostics: Array<Diagnostic>, index: i32): i32 {
  let diag = diagnostics[index];
  if (diag.location != null) {
    return (diag.location as SourceSpan).start;
  }
  return -1;
}

/**
 * Get the byte length of the span of the i-th diagnostic.
 * Returns 0 if the diagnostic has no location.
 */
export function getDiagnosticLength(diagnostics: Array<Diagnostic>, index: i32): i32 {
  let diag = diagnostics[index];
  if (diag.location != null) {
    return (diag.location as SourceSpan).length;
  }
  return 0;
}

/**
 * Get the severity of the i-th diagnostic as an i32.
 * 0 = Error, 1 = Warning, 2 = Information.
 */
export function getDiagnosticSeverity(diagnostics: Array<Diagnostic>, index: i32): i32 {
  let diag = diagnostics[index];
  match (diag.severity) {
    case DiagnosticSeverity.Error: 0
    case DiagnosticSeverity.Warning: 1
    case DiagnosticSeverity.Information: 2
  }
}

/**
 * Get the message of the i-th diagnostic.
 */
export function getDiagnosticMessage(diagnostics: Array<Diagnostic>, index: i32): String {
  return diagnostics[index].message;
}

/**
 * Get the file path of the i-th diagnostic.
 * Returns an empty string if the diagnostic has no location.
 */
export function getDiagnosticFile(diagnostics: Array<Diagnostic>, index: i32): String {
  let diag = diagnostics[index];
  if (diag.location != null) {
    return (diag.location as SourceSpan).file;
  }
  return "";
}

// ============================================================================
// Hover Exports
// ============================================================================

/**
 * Get hover information at a byte offset.
 * Returns a HoverResult or null if no info is available.
 */
export function getHover(path: String, offset: i32): HoverResult | null {
  return (__ls as LanguageService).getHover(path, offset);
}

/**
 * Get the type string from a hover result (e.g., "i32", "(a: i32) => i32").
 */
export function getHoverType(result: HoverResult): String {
  return result.typeStr;
}

/**
 * Get the display label from a hover result (e.g., "let x: i32").
 */
export function getHoverLabel(result: HoverResult): String {
  return result.label;
}

/**
 * Get the doc comment from a hover result.
 * Returns an empty string if no doc comment is available.
 */
export function getHoverDoc(result: HoverResult): String {
  return result.docComment;
}

// ============================================================================
// Document Symbols Exports
// ============================================================================

/**
 * Get document symbols for the outline view.
 */
export function getDocumentSymbols(path: String, source: String): Array<DocumentSymbol> {
  return (__ls as LanguageService).getDocumentSymbols(path, source);
}

/**
 * Get the number of symbols in a result array.
 */
export function getSymbolCount(symbols: Array<DocumentSymbol>): i32 {
  return symbols.length;
}

/**
 * Get the i-th symbol from a result array.
 */
export function getSymbol(symbols: Array<DocumentSymbol>, index: i32): DocumentSymbol {
  return symbols[index];
}

/**
 * Get the name of a symbol.
 */
export function getSymbolName(sym: DocumentSymbol): String {
  return sym.name;
}

/**
 * Get the kind of a symbol (VS Code SymbolKind value).
 */
export function getSymbolKind(sym: DocumentSymbol): i32 {
  return sym.kind as i32;
}

/**
 * Get the full range start byte offset of a symbol.
 */
export function getSymbolStart(sym: DocumentSymbol): i32 {
  return sym.start;
}

/**
 * Get the full range end byte offset of a symbol.
 */
export function getSymbolEnd(sym: DocumentSymbol): i32 {
  return sym.end;
}

/**
 * Get the selection range start byte offset of a symbol.
 */
export function getSymbolSelStart(sym: DocumentSymbol): i32 {
  return sym.selStart;
}

/**
 * Get the selection range end byte offset of a symbol.
 */
export function getSymbolSelEnd(sym: DocumentSymbol): i32 {
  return sym.selEnd;
}

/**
 * Get the number of children of a symbol.
 */
export function getSymbolChildCount(sym: DocumentSymbol): i32 {
  return sym.children.length;
}

/**
 * Get the i-th child of a symbol.
 */
export function getSymbolChild(sym: DocumentSymbol, index: i32): DocumentSymbol {
  return sym.children[index];
}

// ============================================================================
// Lint Exports
// ============================================================================

/**
 * What the lint rules find in a document `check` has seen: each finding
 * is a byte range and the text that fixes it. See LanguageService.lint().
 */
export function lint(path: String): Array<Edit> {
  return (__ls as LanguageService).lint(path);
}

export function getLintCount(findings: Array<Edit>): i32 {
  return findings.length;
}

/** The 0-based start byte offset of the i-th finding. */
export function getLintStart(findings: Array<Edit>, index: i32): i32 {
  return findings[index].start;
}

/** The byte offset just past the i-th finding. */
export function getLintEnd(findings: Array<Edit>, index: i32): i32 {
  return findings[index].end;
}

/** The name of the rule behind the i-th finding. */
export function getLintRule(findings: Array<Edit>, index: i32): String {
  return findings[index].rule;
}

/** The one-line message of the i-th finding. */
export function getLintMessage(findings: Array<Edit>, index: i32): String {
  return (__ls as LanguageService).lintMessage(findings[index]);
}

/** The text that replaces the i-th finding's range to fix it. */
export function getLintReplacement(findings: Array<Edit>, index: i32): String {
  return findings[index].replacement;
}

/**
 * Whether the i-th entry supports the fixes of its rule (an import they
 * need) rather than being a finding: shown as nothing, applied with any
 * fix of that rule.
 */
export function getLintShared(findings: Array<Edit>, index: i32): boolean {
  return findings[index].shared;
}

/**
 * Compile source to WebAssembly binary (ByteArray). The promise resolves
 * with the bytes' handle, or null when the source does not compile.
 */
export function compileToWasm(path: String, source: String): anyref {
  return toPromise(compileDocument(__ls as LanguageService, path, source));
}

/**
 * Compile source to WebAssembly binary (ByteArray) for an explicit target.
 */
export function compileToWasmForTarget(path: String, source: String, target: String): anyref {
  return toPromise(compileDocument(__ls as LanguageService, path, source, target));
}

/**
 * Get the length of a ByteArray.
 */
export function getByteArrayLength(bytes: ByteArray): i32 {
  return bytes.length;
}

/**
 * Get byte at index from ByteArray.
 */
export function getByteArrayByte(bytes: ByteArray, index: i32): i32 {
  // A byte reads as `u8` now that ByteArray is `array<u8>`. The i32
  // return is the host boundary's shape, so widen explicitly.
  return bytes[index] as i32;
}

/**
 * Get code completions at the specified offset.
 */
export function getCompletions(path: String, offset: i32): Array<CompletionItem> {
  return (__ls as LanguageService).getCompletions(path, offset);
}

export function getCompletionCount(items: Array<CompletionItem>): i32 {
  return items.length;
}

export function getCompletionItem(items: Array<CompletionItem>, index: i32): CompletionItem {
  return items[index];
}

export function getCompletionLabel(item: CompletionItem): String {
  return item.label;
}

export function getCompletionKind(item: CompletionItem): i32 {
  return item.kind as i32;
}

export function getCompletionDetail(item: CompletionItem): String {
  return item.detail;
}

export function getCompletionDoc(item: CompletionItem): String {
  return item.docComment;
}
