// Message framing: `frame` and `MessageReader`, which splits a byte
// stream back into messages.
import { suite, test } from 'zena:test';
import { equal, isTrue } from 'zena:assert';
import { MessageReader, frame } from '../lib/framing.zena';

/** A message reader over fixed chunks, as if they arrived one by one. */
function readerOf(chunks: Array<String>) {
  var next = 0;
  return new MessageReader(async () => {
    if (next >= chunks.length) {
      return '';
    }
    let chunk = chunks[next];
    next += 1;
    return chunk;
  });
}

export let tests = suite('message framing', () => {
  test('a frame counts its body in bytes', () => {
    equal(frame('{"a":"é"}'), 'Content-Length: 10\r\n\r\n{"a":"é"}');
  });

  test('messages are split out of chunks, whatever the chunks', async () => {
    let whole = frame('{"a":1}') + frame('{"b":"é"}');
    // Every split point, including through a header and a UTF-8 body.
    for (var cut = 1; cut < whole.length; cut += 1) {
      let reader = readerOf([whole.sliceBytes(0, cut), whole.sliceBytes(cut, whole.length)]);
      equal((await reader.next()) ?? 'none', '{"a":1}');
      equal((await reader.next()) ?? 'none', '{"b":"é"}');
      isTrue((await reader.next()) == null);
    }
  });

  test('a header name is matched whatever its case, and its value trimmed', async () => {
    let reader = readerOf(['content-length:  2 \r\nContent-Type: x\r\n\r\n{}']);
    equal((await reader.next()) ?? 'none', '{}');
  });

  test('a message without a length is an error', async () => {
    let reader = readerOf(['Content-Type: x\r\n\r\n{}']);
    equal(await outcomeOf(reader), 'threw');
  });
});

/** What reading the next message does: its body, 'end', or 'threw'. */
async function outcomeOf(reader: MessageReader): Future<String> {
  try {
    return (await reader.next()) ?? 'end';
  } catch (e) {
    return 'threw';
  }
}
