// The language server's parts: protocol positions against byte offsets,
// and sessions with the server itself. Run from the repository root,
// which the service reads the standard library from.
import { suite, test } from 'zena:test';
import { equal, isTrue, isFalse } from 'zena:assert';
import { readFileSync } from 'zena:fs';
import { JsonArray, JsonObject, parseJson } from 'zena:json';
import { createLanguageService } from '../lib/service.zena';
import { LspServer, offsetOf, positionOf } from '../lib/server.zena';

function readOrNull(path: String): String | null {
  try {
    return readFileSync(path);
  } catch (e) {
    return null;
  }
}


/** A message the server sent, which is always a JSON object. */
function parsed(json: String) {
  return parseJson(json) as JsonObject;
}

/** The array at `path` in a message, or a failure when there is none. */
function arrayIn(message: JsonObject, path: String): JsonArray {
  if (let (true, list) = message.arrayAt(path)) {
    return list;
  }
  throw new Error(`no array at ${path}`);
}

/** The line the first diagnostic in a publishDiagnostics message starts on. */
function firstDiagnosticLine(published: JsonObject): i32 {
  if (let (true, diagnostics) = published.arrayAt('params.diagnostics')) {
    let first = if (diagnostics.length > 0) { diagnostics[0] } else { null };
    if (first is JsonObject) {
      return first.intAt('range.start.line') ?? -1;
    }
  }
  return -1;
}

/** A server, and the messages it has sent. */
function serverSession(): {server: LspServer, sent: Array<String>} {
  let sent = new Array<String>();
  let service = createLanguageService('packages/stdlib/zena', readOrNull, 'zena-cli');
  let server = new LspServer(service, readOrNull, (json: String) => {
    sent.push(json);
  });
  return {server: server, sent: sent};
}

export let tests = suite('language server', () => {
  test('positions count UTF-16 units, offsets count bytes', () => {
    // 'é' is two bytes and one UTF-16 unit; '😀' four bytes and two.
    let source = 'ab\né😀x\n';
    equal(offsetOf(source, {line: 0, character: 1}), 1);
    equal(offsetOf(source, {line: 1, character: 0}), 3);
    equal(offsetOf(source, {line: 1, character: 1}), 5);
    equal(offsetOf(source, {line: 1, character: 3}), 9);
    // Past the end of a line stops at the line's end.
    equal(offsetOf(source, {line: 1, character: 40}), 10);

    let x = positionOf(source, 9);
    equal(x.line, 1);
    equal(x.character, 3);
    let start = positionOf(source, 3);
    equal(start.line, 1);
    equal(start.character, 0);
  });

  test('lint findings are published as warnings, with quick fixes', () => {
    let {server, sent} = serverSession();
    let uri = 'file:///nowhere/lint.zena';
    // A top-level arrow and a `var` never reassigned: two findings.
    server.handle(`{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"${uri}","text":"let add = (a: i32, b: i32): i32 => a + b;\\nexport function run(): i32 {\\n  var n = add(1, 2);\\n  return n;\\n}\\n"}}}`);
    let published = parsed(sent[0]);
    equal(published.stringAt('method') ?? '', 'textDocument/publishDiagnostics');
    // The checker's own warnings are published too; count the lint ones.
    let diagnostics = arrayIn(published, 'params.diagnostics');
    let lint = new Array<JsonObject>();
    var i = 0;
    while (i < diagnostics.length) {
      let candidate = diagnostics[i] as JsonObject;
      if ((candidate.stringAt('source') ?? '') == 'zena-lint') {
        lint.push(candidate);
      }
      i += 1;
    }
    equal(lint.length, 2);
    let first = lint[0];
    equal(first.stringAt('code') ?? '', 'function-declaration');
    equal(first.intAt('severity') ?? 0, 2);
    equal(first.intAt('range.start.line') ?? -1, 0);
    equal(lint[1].stringAt('code') ?? '', 'prefer-let');

    // Code actions on the `var`: its quick fix, and the fix-all action.
    server.handle(`{"jsonrpc":"2.0","id":1,"method":"textDocument/codeAction","params":{"textDocument":{"uri":"${uri}"},"range":{"start":{"line":2,"character":2},"end":{"line":2,"character":5}},"context":{"diagnostics":[]}}}`);
    let actions = arrayIn(parsed(sent[1]), 'result');
    equal(actions.length, 2);
    let fix = actions[0] as JsonObject;
    equal(fix.stringAt('kind') ?? '', 'quickfix');
    isTrue((fix.stringAt('title') ?? '').contains('`let`'));
    let all = actions[1] as JsonObject;
    equal(all.stringAt('kind') ?? '', 'source.fixAll.zena');
    // The URI has dots in it, so it is read as one key, not a path.
    let changes = if (let (true, byUri) = all.objectAt('edit.changes')) byUri[uri] else null;
    isTrue(changes is JsonArray);
    equal((changes as JsonArray).length, 2);
  });

  test('a document without a file URI is published under its own URI', () => {
    let {server, sent} = serverSession();
    server.handle('{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"untitled:Untitled-1","text":"let x: i32 = 1;"}}}');
    equal(parsed(sent[0]).stringAt('params.uri') ?? '', 'untitled:Untitled-1');
  });

  test('a request without a position gets an invalid params error', () => {
    let {server, sent} = serverSession();
    server.handle('{"jsonrpc":"2.0","id":1,"method":"textDocument/hover","params":{"textDocument":{"uri":"file:///nowhere/a.zena"}}}');
    equal(parsed(sent[0]).intAt('error.code') ?? 0, -32602);
  });

  test('a session: open a document, then ask about it', () => {
    let {server, sent} = serverSession();
    let uri = 'file:///nowhere/sample.zena';
    let text = 'let one = (): i32 => 1;\nlet wrong: String = one();\n';

    server.handle('{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}');
    equal(parsed(sent[0]).intAt('result.capabilities.textDocumentSync.change') ?? 0, 1);

    server.handle(`{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"${uri}","text":${'"'}let one = (): i32 => 1;\\nlet wrong: String = one();\\n${'"'}}}}`);
    let published = parsed(sent[1]);
    equal(published.stringAt('method') ?? '', 'textDocument/publishDiagnostics');
    equal(published.stringAt('params.uri') ?? '', uri);
    // The error is on the second line.
    equal(firstDiagnosticLine(published), 1);

    // Hover over `one` in `one()`, on the second line.
    server.handle(`{"jsonrpc":"2.0","id":2,"method":"textDocument/hover","params":{"textDocument":{"uri":"${uri}"},"position":{"line":1,"character":21}}}`);
    let hover = parsed(sent[2]).stringAt('result.contents.value') ?? '';
    isTrue(hover.contains('one'));

    server.handle(`{"jsonrpc":"2.0","id":3,"method":"textDocument/definition","params":{"textDocument":{"uri":"${uri}"},"position":{"line":1,"character":21}}}`);
    let definition = parsed(sent[3]);
    equal(definition.stringAt('result.uri') ?? '', uri);
    equal(definition.intAt('result.range.start.line') ?? -1, 0);
    equal(definition.intAt('result.range.start.character') ?? -1, 4);

    server.handle('{"jsonrpc":"2.0","id":"x","method":"no/such","params":{}}');
    equal(parsed(sent[4]).intAt('error.code') ?? 0, -32601);
    equal(parsed(sent[4]).stringAt('id') ?? '', 'x');

    isFalse(server.exited);
    server.handle('{"jsonrpc":"2.0","method":"exit"}');
    isTrue(server.exited);
  });

  test('a message that is not JSON gets a parse error', () => {
    let {server, sent} = serverSession();
    server.handle('{not json');
    equal(parsed(sent[0]).intAt('error.code') ?? 0, -32700);
  });
});
