{
  "name": "language-service",
  "version": "0.0.1-preview.1",
  "description": "The Zena language service, which gives editors diagnostics, completions and navigation",
  "license": "MIT",
  "files": ["src"],
  "main": "service",
  "exports": {
    "analysis": {},
    "compile": {},
    "completion": {},
    "framing": {},
    "host": {},
    "hover": {},
    "positions": {},
    "protocol": {},
    "server": {},
    "service": {},
    "symbols": {}
  },
  "dependencies": {
    "zena-compiler": {
      "path": "../zena-compiler"
    },
    "zena-formatter": {
      "path": "../zena-formatter"
    },
    "zena-lint": {
      "path": "../zena-lint"
    }
  },
  "locks": ["zena-lock.json", "package-lock.json"],
  "scripts": {
    "test": {
      "#": "The language server's Zena tests, run by the zena command's test runner from the repository root. zena-lsp_test.zena runs the zena command's language server, so this needs the zena command built.",
      "command": "../../target/release/zena-cli test test",
      "files": ["test/**/*.zena"],
      "dependencies": ["source", "../stdlib:lib", "../zena-cli:build"]
    }
  }
}
