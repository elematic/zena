{
  "name": "@zena-lang/language-service",
  "version": "0.0.2-preview.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wireit"
  },
  "wireit": {
    "test": {
      "#": "The language server's Zena tests, run by the zena command's test runner from the repository root. zena-lsp_test.zena runs the zena command's language server, so this needs the zena command built.",
      "command": "../../target/release/zena test test",
      "files": [
        "src/**/*.zena",
        "test/**/*.zena",
        "../compiler/src/lib/**/*.zena",
        "../wit-parser/src/**/*.zena",
        "../formatter/src/**/*.zena",
        "../lint/src/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../../zena-package.json",
        "zena-package.json",
        "../compiler/zena-package.json",
        "../formatter/zena-package.json",
        "../lint/zena-package.json",
        "../wit-parser/zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "../cli:build"
      ]
    }
  },
  "devDependencies": {
    "wireit": "^0.15.0"
  }
}
