{
  "name": "@zena-lang/language-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wireit"
  },
  "wireit": {
    "test": {
      "#": "The language server's Zena tests, run by the zena command's test runner from the repository root. zena-lsp_test.zena runs the zena command's language server, so this needs the zena command built.",
      "command": "../../target/release/zena-cli test test",
      "files": [
        "src/**/*.zena",
        "test/**/*.zena",
        "../zena-compiler/zena/lib/**/*.zena",
        "../wit-parser/src/**/*.zena",
        "../zena-formatter/src/**/*.zena",
        "../zena-lint/src/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../../zena-package.json",
        "zena-package.json",
        "../zena-compiler/zena-package.json",
        "../zena-formatter/zena-package.json",
        "../zena-lint/zena-package.json",
        "../wit-parser/zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "../zena-cli:build"
      ]
    }
  },
  "devDependencies": {
    "wireit": "^0.15.0"
  }
}
