{
  "name": "@zena-lang/language-service",
  "version": "0.0.1",
  "description": "The Zena language service and compiler as a WebAssembly module, with a JavaScript API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elematic/zena.git",
    "directory": "packages/language-service"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./lsp.wasm": "./lsp.wasm",
    "./zena/*": "./zena/*.zena"
  },
  "files": [
    "index.js",
    "index.js.map",
    "index.d.ts",
    "lsp.wasm",
    "zena"
  ],
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "test:zena": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:ts",
        "build:wasm"
      ]
    },
    "build:ts": {
      "command": "tsc",
      "dependencies": [
        "../runtime:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "index.{js,d.ts,js.map,d.ts.map}",
        "test/",
        "tsconfig.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "build:wasm": {
      "command": "ZENA_GC_RESERVE_MB=1536 ../../target/release/zena-cli build zena/lsp.zena --target host -o lsp.wasm",
      "files": [
        "zena/**/*.zena",
        "../zena-compiler/zena/**/*.zena",
        "../zena-formatter/zena/**/*.zena",
        "../stdlib/zena/**/*.zena"
      ],
      "output": [
        "lsp.wasm"
      ],
      "dependencies": [
        "../zena-cli:build",
        "../zena-compiler:precompile:cli"
      ]
    },
    "test": {
      "command": "node --test test/*_test.js",
      "dependencies": [
        "build",
        "test:zena"
      ],
      "files": [
        "test/*_test.js"
      ],
      "output": []
    },
    "test:zena": {
      "#": "The language server's Zena tests, run by the zena command's test runner from the repository root, which is where the service reads the standard library from. zena-lsp_test.zena runs the zena command's language server, so this needs the zena command built.",
      "command": "../../target/release/zena-cli test zena/test",
      "files": [
        "zena/**/*.zena",
        "../zena-compiler/zena/lib/**/*.zena",
        "../zena-formatter/zena/lib/**/*.zena",
        "../stdlib/zena/**/*.zena"
      ],
      "output": [],
      "dependencies": [
        "../zena-cli:build"
      ]
    }
  },
  "dependencies": {
    "@zena-lang/runtime": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^7.0.2",
    "wireit": "^0.14.4"
  }
}
