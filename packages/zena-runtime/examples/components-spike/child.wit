// The extension side of the spike: `ops` is what the child exports and
// the caller imports; `callbacks` is what the child imports and the
// caller exports. Both functions are `async`, so the caller's call to
// `compute` is async-lowered and the child's call to `lookup` is too.
package spike:child@0.1.0;

interface ops {
  /// Asks the caller what `x` maps to, and doubles the answer.
  compute: async func(x: s32) -> s32;
}

interface callbacks {
  lookup: async func(key: s32) -> s32;
}

world child {
  import callbacks;
  export ops;
}
