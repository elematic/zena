// The caller's view of the same two interfaces: each function takes the
// installation first. The runtime pairs these with the child's by
// interface and function name.
package spike:child@0.1.0;

interface ops {
  compute: async func(installation: u32, x: s32) -> s32;
}

interface callbacks {
  lookup: async func(installation: u32, key: s32) -> s32;
}

world caller {
  import wasi:cli/stdout@0.3.0;
  import wasi:cli/stderr@0.3.0;
  import ops;
  export callbacks;
  export main: async func();
}
