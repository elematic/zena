// The caller: loads nothing itself (the harness does), calls the child's
// `compute` through its import, and serves the child's `lookup` while
// that call is in flight.
import { compute } from 'spike:child/ops';
import { Future } from 'zena:async';

export async function lookup(installation: u32, key: i32): Future<i32> {
  console.log(`lookup from installation ${installation}: ${key}`);
  return key + 100;
}

export async function main(): Future<void> {
  let first = await compute(1 as u32, 5);
  console.log(`compute(5) = ${first}`);
  let second = await compute(1 as u32, 7);
  console.log(`compute(7) = ${second}`);
}
