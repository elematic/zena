// The caller again, blocking on the child's call instead of awaiting it:
// `blockOn` parks the entry's task in `waitable-set.wait`.
import { compute } from 'spike:child/ops';
import { Future } from 'zena:async';
import { blockOn } from 'zena:wasi';

export async function lookup(installation: u32, key: i32): Future<i32> {
  console.log(`lookup from installation ${installation}: ${key}`);
  return key + 100;
}

export function main(): void {
  let first = blockOn(compute(1 as u32, 5));
  console.log(`compute(5) = ${first}`);
}
