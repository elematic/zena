{
  "name": "@zena-lang/zena-compiler",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./zena/*": "./zena/*.zena"
  },
  "files": [
    "zena"
  ],
  "scripts": {
    "build": "wireit",
    "build:scripts": "wireit",
    "build:cli": "wireit",
    "build:tests": "wireit",
    "build:tests:self-hosted": "wireit",
    "build:self-hosted": "wireit",
    "test": "wireit",
    "test:self-hosted": "wireit",
    "test:unit": "wireit",
    "test:unit:self-hosted": "wireit",
    "test:syntax": "wireit",
    "test:syntax:self-hosted": "wireit",
    "test:semantics": "wireit",
    "test:semantics:self-hosted": "wireit",
    "test:execution": "wireit",
    "test:interop": "wireit",
    "benchmark": "wireit"
  },
  "wireit": {
    "benchmark": {
      "command": "node scripts/benchmark.js",
      "dependencies": [
        "build:scripts",
        "precompile:cli",
        "../zena-cli:build"
      ]
    },
    "build": {
      "dependencies": [
        "build:cli",
        "build:tests"
      ]
    },
    "build:cli": {
      "command": "node --stack-size=4096 ../cli/lib/cli.js build zena/cli/main.zena --target wasi -o zena/out/cli.wasm -g --warn-unnecessary-casts --warnings-as-errors",
      "files": [
        "zena/**/*.zena",
        "../cli/lib/**/*.js",
        "../compiler/lib/**/*.js"
      ],
      "output": [
        "zena/out/cli.wasm"
      ],
      "dependencies": [
        "../cli:build",
        "../stdlib:lib"
      ]
    },
    "precompile:cli": {
      "command": "../../target/release/zena-cli precompile zena/out/cli.wasm",
      "files": [
        "zena/out/cli.wasm"
      ],
      "output": [
        "zena/out/cli.cwasm"
      ],
      "dependencies": [
        "build:cli",
        "../zena-cli:build"
      ]
    },
    "build:self-hosted": {
      "command": "ZENA_GC_RESERVE_MB=1536 ../../target/release/zena-cli build zena/cli/main.zena -o zena/out/cli-self.wasm && ../../target/release/zena-cli precompile zena/out/cli-self.wasm",
      "files": [
        "zena/**/*.zena",
        "zena/out/cli.wasm"
      ],
      "output": [
        "zena/out/cli-self.wasm",
        "zena/out/cli-self.cwasm"
      ],
      "dependencies": [
        "precompile:cli",
        "../zena-cli:build"
      ]
    },
    "build:scripts": {
      "command": "tsc",
      "dependencies": [
        "../runtime:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "scripts/**/*.js",
        "scripts/**/*.js.map"
      ],
      "clean": "if-file-deleted"
    },
    "build:tests": {
      "command": "node scripts/build-wasi-tests.js",
      "files": [
        "zena/**/*.zena",
        "!zena/**/*.__runner__.zena",
        "../cli/lib/**/*.js",
        "../compiler/lib/**/*.js"
      ],
      "output": [
        "zena/out/**/*.wasm",
        "!zena/out/cli.wasm",
        "zena/**/*.__runner__.zena"
      ],
      "dependencies": [
        "build:scripts",
        "../zena-cli:build",
        "../stdlib:lib"
      ]
    },
    "build:tests:self-hosted": {
      "command": "SELF_HOSTED=true node scripts/build-wasi-tests.js",
      "files": [
        "zena/**/*.zena",
        "!zena/**/*.__runner__.zena",
        "zena/out/cli-self.wasm"
      ],
      "output": [
        "zena/out/test-self/**/*.wasm",
        "zena/**/*.__runner__.zena"
      ],
      "dependencies": [
        "build:scripts",
        "build:self-hosted",
        "../zena-cli:build",
        "../stdlib:lib"
      ]
    },
    "test": {
      "dependencies": [
        "test:unit",
        "test:syntax",
        "test:semantics",
        "test:execution",
        "test:interop"
      ]
    },
    "test:self-hosted": {
      "dependencies": [
        "build:self-hosted",
        "test:unit:self-hosted",
        "test:syntax:self-hosted",
        "test:semantics:self-hosted"
      ]
    },
    "test:unit": {
      "command": "node scripts/run-wasmtime.js",
      "files": [
        "scripts/run-wasmtime.js",
        "test-files/snapshots/**/*.snap"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "build:tests"
      ]
    },
    "test:unit:self-hosted": {
      "command": "SELF_HOSTED=true node scripts/run-wasmtime.js",
      "files": [
        "scripts/run-wasmtime.js",
        "test-files/snapshots/**/*.snap"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "build:tests:self-hosted"
      ]
    },
    "test:syntax": {
      "command": "node scripts/run-wasmtime.js zena/out/test/portable_syntax.wasm",
      "files": [
        "../../tests/language/syntax/**/*.zena",
        "../../tests/language/syntax/**/*.ast.json",
        "scripts/run-wasmtime.js"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "build:tests"
      ]
    },
    "test:syntax:self-hosted": {
      "command": "SELF_HOSTED=true node scripts/run-wasmtime.js zena/out/test-self/portable_syntax.wasm",
      "files": [
        "../../tests/language/syntax/**/*.zena",
        "../../tests/language/syntax/**/*.ast.json",
        "scripts/run-wasmtime.js"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "build:tests:self-hosted"
      ]
    },
    "test:semantics": {
      "command": "node scripts/run-wasmtime.js zena/out/test/portable_semantics.wasm",
      "files": [
        "../../tests/language/semantics/**/*.zena",
        "scripts/run-wasmtime.js"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "build:tests"
      ]
    },
    "test:semantics:self-hosted": {
      "command": "SELF_HOSTED=true node scripts/run-wasmtime.js zena/out/test-self/portable_semantics.wasm",
      "files": [
        "../../tests/language/semantics/**/*.zena",
        "scripts/run-wasmtime.js"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "build:tests:self-hosted"
      ]
    },
    "test:execution": {
      "command": "node scripts/run-execution-tests.js",
      "files": [
        "../../tests/language/execution/**/*.zena",
        "scripts/run-execution-tests.js"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "../zena-cli:build",
        "precompile:cli"
      ]
    },
    "test:interop": {
      "command": "node scripts/external-functions-test.js",
      "files": [
        "scripts/external-functions-test.js"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "../zena-cli:build",
        "../runtime:build",
        "precompile:cli"
      ]
    }
  },
  "devDependencies": {
    "@zena-lang/compiler": "0.0.1",
    "@zena-lang/runtime": "0.0.1",
    "typescript": "~5.9.3",
    "wireit": "^0.14.4"
  }
}
