{
  "name": "@zena-lang/zena-compiler",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./zena/*": "./zena/*.zena"
  },
  "files": [
    "zena"
  ],
  "scripts": {
    "build": "wireit",
    "build:scripts": "wireit",
    "build:cli": "wireit",
    "build:api": "wireit",
    "build:tests": "wireit",
    "build:self-hosted": "wireit",
    "test": "wireit",
    "test:unit": "wireit",
    "test:syntax": "wireit",
    "test:semantics": "wireit",
    "test:execution": "wireit",
    "test:interop": "wireit",
    "benchmark": "wireit",
    "test:fixpoint": "wireit",
    "reseed": "wireit",
    "test:component": "wireit"
  },
  "wireit": {
    "benchmark": {
      "command": "node scripts/benchmark.js",
      "dependencies": [
        "build:scripts",
        "precompile:cli",
        "../zena-cli:build"
      ]
    },
    "build": {
      "dependencies": [
        "build:cli",
        "build:tests"
      ]
    },
    "build:cli": {
      "command": "ZENA_GC_RESERVE_MB=1536 ZENA_COMPILER_WASM=bootstrap/cli.wasm ../../target/release/zena-cli build zena/cli/main.zena -o zena/out/cli.wasm",
      "files": [
        "zena/**/*.zena",
        "bootstrap/cli.wasm",
        "../stdlib/zena/**/*.zena",
        "../wit-parser/zena/**/*.zena"
      ],
      "output": [
        "zena/out/cli.wasm"
      ],
      "dependencies": [
        "../zena-cli:build",
        "../stdlib:lib"
      ]
    },
    "build:api": {
      "command": "../../target/release/zena-cli build zena/cli/api.zena --target host -o zena/out/api.wasm",
      "files": [
        "zena/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../wit-parser/zena/**/*.zena"
      ],
      "output": [
        "zena/out/api.wasm"
      ],
      "dependencies": [
        "build:cli",
        "../zena-cli:build"
      ]
    },
    "precompile:cli": {
      "command": "../../target/release/zena-cli precompile zena/out/cli.wasm",
      "files": [
        "zena/out/cli.wasm"
      ],
      "output": [
        "zena/out/cli.cwasm"
      ],
      "dependencies": [
        "build:cli",
        "../zena-cli:build"
      ]
    },
    "build:self-hosted": {
      "command": "ZENA_GC_RESERVE_MB=1536 ../../target/release/zena-cli -g build zena/cli/main.zena -o zena/out/cli-self.wasm && ../../target/release/zena-cli precompile zena/out/cli-self.wasm",
      "files": [
        "zena/**/*.zena",
        "zena/out/cli.wasm",
        "../wit-parser/zena/**/*.zena"
      ],
      "output": [
        "zena/out/cli-self.wasm",
        "zena/out/cli-self.cwasm"
      ],
      "dependencies": [
        "precompile:cli",
        "../zena-cli:build"
      ]
    },
    "build:scripts": {
      "command": "tsc",
      "dependencies": [
        "../runtime:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "scripts/**/*.js",
        "scripts/**/*.js.map"
      ],
      "clean": "if-file-deleted"
    },
    "build:tests": {
      "command": "node scripts/build-wasi-tests.js",
      "files": [
        "zena/**/*.zena",
        "!zena/**/*.__runner__.zena",
        "zena/out/cli-self.wasm",
        "../wit-parser/zena/**/*.zena"
      ],
      "output": [
        "zena/out/test-self/**/*.wasm",
        "zena/**/*.__runner__.zena"
      ],
      "dependencies": [
        "build:scripts",
        "build:self-hosted",
        "../zena-cli:build",
        "../stdlib:lib"
      ]
    },
    "test": {
      "dependencies": [
        "test:unit",
        "test:component",
        "test:syntax",
        "test:semantics",
        "test:execution",
        "test:interop",
        "test:fixpoint"
      ]
    },
    "test:unit": {
      "command": "node scripts/run-wasmtime.js",
      "files": [
        "scripts/run-wasmtime.js",
        "test-files/snapshots/**/*.snap",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "build:tests"
      ]
    },
    "test:syntax": {
      "command": "node scripts/run-wasmtime.js zena/out/test-self/portable_syntax.wasm",
      "files": [
        "../../tests/language/syntax/**/*.zena",
        "../../tests/language/syntax/**/*.ast.json",
        "scripts/run-wasmtime.js",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "build:tests"
      ]
    },
    "test:semantics": {
      "command": "node scripts/run-wasmtime.js zena/out/test-self/portable_semantics.wasm",
      "files": [
        "../../tests/language/semantics/**/*.zena",
        "scripts/run-wasmtime.js",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "build:tests"
      ]
    },
    "test:execution": {
      "command": "node scripts/run-wasmtime.js zena/out/test-self/portable_execution.wasm",
      "files": [
        "../../tests/language/execution/**/*.zena",
        "scripts/run-wasmtime.js",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "build:tests"
      ]
    },
    "test:interop": {
      "command": "node scripts/external-functions-test.js",
      "files": [
        "scripts/external-functions-test.js"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "../zena-cli:build",
        "../runtime:build",
        "precompile:cli"
      ]
    },
    "reseed": {
      "command": "cp zena/out/cli-self.wasm bootstrap/cli.wasm",
      "files": [
        "zena/out/cli-self.wasm"
      ],
      "output": [
        "bootstrap/cli.wasm"
      ],
      "dependencies": [
        "test"
      ]
    },
    "test:fixpoint": {
      "command": "node scripts/check-fixpoint.js",
      "files": [
        "zena/**/*.zena",
        "zena/out/cli-self.wasm",
        "scripts/check-fixpoint.js"
      ],
      "output": [
        "zena/out/cli-self2.wasm"
      ],
      "dependencies": [
        "build:scripts",
        "build:self-hosted",
        "../zena-cli:build"
      ]
    },
    "test:component": {
      "command": "node scripts/component-e2e.js",
      "files": [
        "scripts/component-e2e.js",
        "test-files/component/**/*.zena"
      ],
      "output": [
        "zena/out/component/**/*.wasm"
      ],
      "dependencies": [
        "build:scripts",
        "build:self-hosted",
        "../zena-cli:build",
        "../stdlib:lib"
      ]
    }
  },
  "devDependencies": {
    "@zena-lang/runtime": "0.0.1",
    "typescript": "~5.9.3",
    "wireit": "^0.14.4"
  }
}
