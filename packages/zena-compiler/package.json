{
  "name": "@zena-lang/zena-compiler",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./zena/*": "./zena/*.zena"
  },
  "files": [
    "zena"
  ],
  "scripts": {
    "build": "wireit",
    "build:scripts": "wireit",
    "build:cli": "wireit",
    "build:tests": "wireit",
    "build:self-hosted": "wireit",
    "test": "wireit",
    "test:unit": "wireit",
    "test:syntax": "wireit",
    "test:semantics": "wireit",
    "test:execution": "wireit",
    "test:execution:o2": "wireit",
    "test:interop": "wireit",
    "test:fixpoint": "wireit",
    "reseed": "wireit",
    "test:component": "wireit",
    "test:smoke": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:cli",
        "build:tests"
      ]
    },
    "build:cli": {
      "#command": "The bootstrap compiles the compiler, run on zena-run with the preopens `zc` expects: the repository as `.` and the standard library as `/stdlib`. It cannot go through zena-cli, whose module this compiler builds. ZENA_OPT_LEVEL=2 (the env form, which a bootstrap that predates the -O flag ignores rather than misreads) makes the working compiler an -O2 build: it compiles the zena module in 20s where the -O1 build takes 27s, and every build and test step downstream of this one runs it (docs/design/compiler-memory.md).",
      "command": "mkdir -p zena/out && cd ../.. && ZENA_GC_RESERVE_MB=1536 ZENA_OPT_LEVEL=2 ./target/release/zena-run --dir .::. --dir packages/stdlib/zena::/stdlib packages/zena-compiler/bootstrap/cli.wasm packages/zena-compiler/zena/cli/main.zena -o packages/zena-compiler/zena/out/cli.wasm",
      "files": [
        "zena/cli/**/*.zena",
        "zena/lib/**/*.zena",
        "bootstrap/cli.wasm",
        "../stdlib/zena/**/*.zena",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../wit-parser/zena/**/*.zena",
        "!../wit-parser/zena/test/**",
        "../../zena-package.json",
        "zena/lib/zena-package.json",
        "../wit-parser/zena/zena-package.json"
      ],
      "output": [
        "zena/out/cli.wasm"
      ],
      "dependencies": [
        "../zena-run:build",
        "../stdlib:lib"
      ]
    },
    "precompile:cli": {
      "command": "../../target/release/zena-cli precompile zena/out/cli.wasm",
      "files": [
        "zena/out/cli.wasm"
      ],
      "output": [
        "zena/out/cli.cwasm"
      ],
      "dependencies": [
        {
          "script": "build:cli",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    },
    "build:self-hosted": {
      "command": "ZENA_GC_RESERVE_MB=1536 ZENA_TEMPLATE_CHECK=1 ZENA_COMPILER_WASM=zena/out/cli.wasm ../../target/release/zena-cli -g -O2 build zena/cli/main.zena -o zena/out/cli-self.wasm && ../../target/release/zena-cli precompile zena/out/cli-self.wasm",
      "files": [
        "zena/cli/**/*.zena",
        "zena/lib/**/*.zena",
        "zena/out/cli.wasm",
        "../wit-parser/zena/**/*.zena",
        "!../wit-parser/zena/test/**",
        "../stdlib/zena/**/*.zena",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../../zena-package.json",
        "zena/lib/zena-package.json",
        "../wit-parser/zena/zena-package.json"
      ],
      "output": [
        "zena/out/cli-self.wasm",
        "zena/out/cli-self.cwasm"
      ],
      "dependencies": [
        {
          "script": "precompile:cli",
          "cascade": false
        },
        "../zena-cli:build",
        "../stdlib:lib"
      ]
    },
    "build:scripts": {
      "command": "tsc",
      "dependencies": [
        "../runtime:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "scripts/**/*.js",
        "scripts/**/*.js.map"
      ],
      "clean": "if-file-deleted"
    },
    "build:tests": {
      "command": "node scripts/build-wasi-tests.js",
      "files": [
        "zena/lib/**/*.zena",
        "zena/test/**/*.zena",
        "!zena/test/__all_tests__.zena",
        "zena/out/cli.wasm",
        "../wit-parser/zena/**/*.zena",
        "!../wit-parser/zena/test/**",
        "../../zena-package.json",
        "zena/lib/zena-package.json",
        "../wit-parser/zena/zena-package.json"
      ],
      "output": [
        "zena/out/test-self/__all_tests__.wasm",
        "zena/test/__all_tests__.zena"
      ],
      "dependencies": [
        "build:scripts",
        {
          "script": "precompile:cli",
          "cascade": false
        },
        "../zena-cli:build",
        "../stdlib:lib"
      ],
      "#dependencies": "precompile:cli, not build:self-hosted: this program is built by stage A (see build-wasi-tests.ts), and precompiling it is what keeps running it off Cranelift. Depending on stage B put the four suites behind its 64s."
    },
    "test": {
      "#": "Everything, which is what CI runs. `test:smoke` is this minus the fixpoint check, so the two cannot drift.",
      "dependencies": [
        "test:smoke",
        "test:fixpoint"
      ]
    },
    "test:unit": {
      "command": "node scripts/run-wasmtime.js unit",
      "files": [
        "scripts/run-wasmtime.js",
        "zena/out/test-self/__all_tests__.wasm",
        "zena/cli/**/*.zena",
        "zena/lib/**/*.zena",
        "../wit-parser/zena/**/*.zena",
        "!../wit-parser/zena/test/**",
        "test-files/snapshots/**/*.snap",
        "test-files/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../stdlib/stdlib-manifest.json",
        "../../zena-package.json",
        "zena/lib/zena-package.json",
        "../wit-parser/zena/zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        {
          "script": "build:tests",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    },
    "test:syntax": {
      "command": "node scripts/run-wasmtime.js syntax",
      "files": [
        "../../tests/language/syntax/**/*.zena",
        "../../tests/language/syntax/**/*.ast.json",
        "scripts/run-wasmtime.js",
        "zena/out/test-self/__all_tests__.wasm",
        "../stdlib/zena/**/*.zena",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../stdlib/stdlib-manifest.json"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        {
          "script": "build:tests",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    },
    "test:semantics": {
      "command": "node scripts/run-wasmtime.js semantics",
      "files": [
        "../../tests/language/semantics/**/*.zena",
        "scripts/run-wasmtime.js",
        "zena/out/test-self/__all_tests__.wasm",
        "../stdlib/zena/**/*.zena",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../stdlib/stdlib-manifest.json",
        "../../zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        {
          "script": "build:tests",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    },
    "test:execution": {
      "command": "node scripts/run-wasmtime.js execution",
      "env": {
        "ZENA_TEST_OPT_LEVEL": {
          "external": true
        },
        "ZENA_PROPAGATE": {
          "external": true
        }
      },
      "files": [
        "../../tests/language/execution/**/*.zena",
        "scripts/run-wasmtime.js",
        "zena/out/test-self/__all_tests__.wasm",
        "../stdlib/zena/**/*.zena",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../stdlib/stdlib-manifest.json",
        "../../zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        {
          "script": "build:tests",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    },
    "test:execution:o2": {
      "#": "The execution suite compiled at -O2, through the module loop the default level skips. It writes to zena/out/test-exec-O2, and runs after test:execution rather than beside it, which keeps CI's peak memory where it was.",
      "command": "node scripts/run-wasmtime.js execution",
      "env": {
        "ZENA_TEST_OPT_LEVEL": "2",
        "ZENA_PROPAGATE": {
          "external": true
        }
      },
      "files": [
        "../../tests/language/execution/**/*.zena",
        "scripts/run-wasmtime.js",
        "zena/out/test-self/__all_tests__.wasm",
        "../stdlib/zena/**/*.zena",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "../stdlib/stdlib-manifest.json",
        "../../zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        {
          "script": "build:tests",
          "cascade": false
        },
        "../zena-cli:build",
        "test:execution"
      ]
    },
    "test:interop": {
      "command": "node scripts/external-functions-test.js",
      "files": [
        "scripts/external-functions-test.js",
        "zena/out/cli.wasm"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "../zena-cli:build",
        "../runtime:build",
        {
          "script": "precompile:cli",
          "cascade": false
        },
        "../stdlib:lib"
      ]
    },
    "reseed": {
      "command": "cp zena/out/cli-self.wasm bootstrap/cli.wasm",
      "files": [
        "zena/out/cli-self.wasm"
      ],
      "output": [
        "bootstrap/cli.wasm"
      ],
      "dependencies": [
        "test"
      ]
    },
    "test:fixpoint": {
      "command": "node scripts/check-fixpoint.js",
      "files": [
        "zena/cli/**/*.zena",
        "zena/lib/**/*.zena",
        "../wit-parser/zena/**/*.zena",
        "!../wit-parser/zena/test/**",
        "../stdlib/zena/**/*.zena",
        "../stdlib/zena/wit/*.wit",
        "../stdlib/zena/host-wit/*.wit",
        "zena/out/cli-self.wasm",
        "scripts/check-fixpoint.js",
        "../../zena-package.json",
        "zena/lib/zena-package.json",
        "../wit-parser/zena/zena-package.json"
      ],
      "output": [
        "zena/out/cli-self2.wasm"
      ],
      "dependencies": [
        "build:scripts",
        {
          "script": "build:self-hosted",
          "cascade": false
        },
        "../zena-cli:build",
        "../stdlib:lib"
      ]
    },
    "test:component": {
      "command": "node scripts/component-e2e.js",
      "files": [
        "scripts/component-e2e.js",
        "test-files/component/**/*.zena",
        "test-files/component/**/*.wit",
        "zena/out/cli.wasm"
      ],
      "output": [
        "zena/out/component/**/*.wasm"
      ],
      "dependencies": [
        "build:scripts",
        {
          "script": "precompile:cli",
          "cascade": false
        },
        "../zena-cli:build",
        "../stdlib:lib"
      ]
    },
    "test:smoke": {
      "#": "Every compiler test but the fixpoint check. See the root package's test:smoke for when to reach for it.",
      "dependencies": [
        "test:unit",
        "test:component",
        "test:syntax",
        "test:semantics",
        "test:execution",
        "test:execution:o2",
        "test:interop"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@zena-lang/runtime": "0.0.1",
    "typescript": "^7.0.2",
    "wireit": "^0.14.4"
  }
}
