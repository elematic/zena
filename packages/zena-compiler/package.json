{
  "name": "@zena-lang/zena-compiler",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./zena/*": "./zena/*.zena"
  },
  "files": [
    "zena"
  ],
  "scripts": {
    "build": "wireit",
    "build:scripts": "wireit",
    "build:cli": "wireit",
    "build:tests": "wireit",
    "test": "wireit",
    "test:execution": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:cli",
        "build:tests"
      ]
    },
    "build:cli": {
      "command": "node --stack-size=4096 ../cli/lib/cli.js build zena/cli/main.zena --target wasi -o zena/out/cli.wasm -g",
      "files": [
        "zena/**/*.zena"
      ],
      "output": [
        "zena/out/cli.wasm"
      ],
      "dependencies": [
        "../cli:build"
      ]
    },
    "build:scripts": {
      "command": "tsc",
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "scripts/**/*.js",
        "scripts/**/*.js.map"
      ],
      "clean": "if-file-deleted"
    },
    "build:tests": {
      "command": "node scripts/build-wasi-tests.js",
      "files": [
        "zena/**/*.zena",
        "!zena/**/*.__runner__.zena"
      ],
      "output": [
        "zena/out/**/*.wasm",
        "!zena/out/cli.wasm",
        "zena/**/*.__runner__.zena"
      ],
      "dependencies": [
        "build:scripts",
        "../cli:build"
      ]
    },
    "test": {
      "command": "node scripts/run-wasmtime.js",
      "files": [
        "../../tests/**/*.zena",
        "../../tests/**/*.json"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "build:tests",
        "test:execution"
      ]
    },
    "test:execution": {
      "command": "node scripts/run-execution-tests.js",
      "files": [
        "../../tests/language/execution/**/*.zena",
        "scripts/run-execution-tests.js"
      ],
      "output": [],
      "dependencies": [
        "build:scripts",
        "../cli:build",
        "build:cli"
      ]
    }
  },
  "devDependencies": {
    "@zena-lang/compiler": "0.0.1",
    "typescript": "~5.9.3",
    "wireit": "^0.14.4"
  }
}
