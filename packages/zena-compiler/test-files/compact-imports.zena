@external("env", "log_i32") declare function logI32(n: i32): void;
@external("other", "tick") declare function tick(): void;
@external("env", "log_f64") declare function logF64(n: f64): void;
@external("env", "log_i32_again") declare function logI32Again(n: i32): void;

export let main = (): String => {
  logI32(1);
  tick();
  logF64(2.0);
  logI32Again(3);
  console.log("a");
  console.log("b");
  return "c";
};
