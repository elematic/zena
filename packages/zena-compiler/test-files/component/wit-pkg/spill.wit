// Imports whose parameters spill: past sixteen core values in a
// synchronous call, past four in an asynchronous one, the canonical
// ABI passes every parameter through one address into memory the
// caller owns. `four` sits exactly at the async limit and stays flat.
package fixture:spill@1.0.0;

interface wide {
  record opts {
    name: option<string>,
    level: option<u8>,
    fast: option<bool>,
  }

  resource gpu {
    request: async func(options: option<opts>) -> u32;
    poke: func(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32,
        h: u32, i: u32, j: u32, k: u32, l: u32, m: u32, n: u32, o: u32,
        p: u32);
  }

  sum: func(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32,
      h: u32, i: u32, j: u32, k: u32, l: u32, m: u32, n: u32, o: u32,
      p: u32, q: u32) -> u32;
  describe: func(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32,
      h: u32, i: u32, j: u32, k: u32, l: u32, m: u32, n: u32, o: u32,
      p: u32, name: string) -> string;
  sum-async: async func(a: u32, b: u32, c: u32, d: u32, e: u32) -> u32;
  four: async func(a: u32, b: u32, c: u32, d: u32) -> u32;
}
