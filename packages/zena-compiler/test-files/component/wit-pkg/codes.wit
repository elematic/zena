// Enums and flags for the WIT-typed-module tests: the two single-flat
// named types. `level` exercises both directions plus composition with
// the string machinery; `modes` is the bitset shape.
package wasi:codes@1.0.0;

interface status {
  enum level {
    ok,
    warning,
    fatal-error,
  }

  flags modes {
    read,
    write,
    append,
  }

  describe: func(l: level) -> string;
  classify: func(code: u32) -> level;
  open-modes: func() -> modes;
  combine: func(m: modes, extra: modes) -> u32;
}
