// A strings-and-lists interface for the WIT-typed-module tests: every
// signature shape the marshaling slice renders — staged string and
// byte-list parameters, spilled string / byte-list / string-list
// results, and a scalar mixed in so pass-through and staging coexist
// in one call.
package wasi:text@1.0.0;

interface transform {
  upper: func(input: string) -> string;
  measure: func(input: string) -> u32;
  describe: func(count: u32) -> string;
  checksum: func(data: list<u8>) -> u32;
  fill: func(value: u8, count: u32) -> list<u8>;
  split: func(input: string, separator: string) -> list<string>;
}
