// A resource for the WIT-typed-module tests: constructor, methods
// (staged params, lifted results, a void setter, a plain scalar), a
// static returning an optional handle, and a free function returning
// a bare resource — implicit `own` in value position.
package wasi:store@1.0.0;

interface kv {
  resource bucket {
    constructor(name: string);
    get: func(key: string) -> option<string>;
    set: func(key: string, value: string);
    count: func() -> u32;
    absorb: func(other: bucket);
    peek: static func(b: borrow<bucket>) -> u32;
    open: static func(name: string) -> option<bucket>;
  }

  default-bucket: func() -> bucket;
}
