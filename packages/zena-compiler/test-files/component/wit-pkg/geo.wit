// Aggregates for the WIT-typed-module tests: records (with string,
// enum and option fields), a variant whose payloads span unit, record,
// string and scalar cases, and the container shapes around them —
// option, list, tuple and a top-level result.
package wasi:geo@1.0.0;

interface survey {
  enum quality {
    poor,
    fair,
    good,
  }

  record point {
    x: f64,
    y: f64,
    label: string,
  }

  record reading {
    quality: quality,
    value: option<u16>,
  }

  variant finding {
    nothing,
    at(point),
    message(string),
    code(u32),
  }

  variant note {
    empty,
    text(string),
    id(u32),
  }

  origin: func() -> point;
  locate: func(name: string) -> option<point>;
  survey-all: func() -> list<reading>;
  check: func(id: u32) -> result<point, finding>;
  bounds: func() -> tuple<point, point>;

  label-of: func(p: point) -> u32;
  annotate: func(n: note) -> u32;
  maybe-name: func(n: option<string>) -> u32;
  send-labels: func(names: list<string>) -> u32;
  window: func(w: tuple<u32, u32>) -> u32;
  report: func(f: finding) -> u32;
}
