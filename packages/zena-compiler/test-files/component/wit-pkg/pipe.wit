// Byte streams in signatures for the WIT-typed-module tests: a
// direct stream result (one flat handle), a stream parameter, streams
// inside aggregates (a spilled tuple result, an option), an async
// function moving a stream — and the refused shapes, a non-u8 element
// and a future value.
package wasi:pipe@1.0.0;

interface pipes {
  source: func() -> stream<u8>;
  sink: func(data: stream<u8>) -> u32;
  tee: func() -> tuple<stream<u8>, stream<u8>>;
  open: func(name: string) -> option<stream<u8>>;
  transfer: async func(data: stream<u8>) -> u64;

  ints: func() -> stream<u32>;
  status: func() -> future<u32>;
}
