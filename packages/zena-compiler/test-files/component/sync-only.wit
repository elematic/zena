// An exported interface with no async function in it, and no `main`.
//
// Two things this covers. A declared world synthesizes a wrapper module,
// and that wrapper roots the p3 async driver whether or not anything is
// async; `greeter` is the same shape but has one `async func`, which is
// what kept the all-synchronous case from being covered.
//
// And `split` returns two bare floats. A synchronous lift returns at most
// one core value, so that comes back through a return area — which lives in
// linear memory, so the lift needs the memory options even though no string
// or list is anywhere near it.
package test:sync-only@1.0.0;

interface arith {
  record point { x: f32, y: f32 }

  double: func(n: u32) -> u32;
  split: func(n: f32) -> point;
}

world provider {
  export arith;
}
