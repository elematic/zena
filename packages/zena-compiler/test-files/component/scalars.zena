// Every flat scalar that crosses the canonical boundary today, in both
// directions. `u8` and `bool` are the interesting ones: all three lower
// to a core i32, so the component-level type has to come from the Zena
// signature rather than from the lowered form.
export function addNarrow(a: u8, b: u16): u32 {
  return (a as u32) + (b as u32);
}

export function negate(value: boolean): boolean {
  return !value;
}

export function scale(x: f64): f64 {
  return x * 2.0;
}

export function nextBig(x: u64): u64 {
  return x + 1;
}

export function noResult(x: i32): void {
}

export function main(): i32 {
  return 0;
}
