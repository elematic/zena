// A string on an *import*, which is the direction that cannot be
// lowered yet.
//
// Lifting takes its memory and `realloc` from the program module's own
// exports, because lifting happens after instantiation. A lowered import
// is one of the module's imports, so it has to exist first, and its
// memory has to come from a second core module that owns linear memory
// and the allocator — the runtime module C3 builds for stdio. Until then
// this must fail by name rather than emit a lowering with no memory to
// read the bytes out of.
@external("test:strings/sink@0.1.0", "swallow")
declare function swallow(text: String): void;

export function main(): i32 {
  swallow('hi');
  return 0;
}
