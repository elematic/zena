// The WIT the zenafx triangle fixture is built against, as
// `wasm-tools component wit packages/zenafx/fixtures/triangle.wasm`
// prints it: the world, all of `wasi:webgpu/webgpu@0.3.0-rc.2`, and
// both `wasi-gfx:surface@0.2.0` interfaces. A unit test synthesizes
// every interface in it and checks nothing is refused, so the
// bindings the graphics work needs stay whole as the synthesizer
// changes. Regenerate it from the fixture rather than editing it.
package root:component;

world root {
  import wasi:webgpu/webgpu@0.3.0-rc.2;
  import wasi-gfx:surface/surface@0.2.0;
  import wasi-gfx:surface/surface-webgpu@0.2.0;
  import print: func(s: string);

  export start: async func();
}
package wasi:webgpu@0.3.0-rc.2 {
  interface webgpu {
    resource record-option-gpu-size64;

    resource gpu-adapter {
      request-device: async func(descriptor: option<gpu-device-descriptor>) -> result<gpu-device, request-device-error>;
    }

    resource gpu-device {
      queue: func() -> gpu-queue;
      create-pipeline-layout: func(descriptor: gpu-pipeline-layout-descriptor) -> gpu-pipeline-layout;
      create-shader-module: func(descriptor: gpu-shader-module-descriptor) -> gpu-shader-module;
      create-render-pipeline: func(descriptor: gpu-render-pipeline-descriptor) -> gpu-render-pipeline;
      create-command-encoder: func(descriptor: option<gpu-command-encoder-descriptor>) -> gpu-command-encoder;
    }

    resource gpu {
      request-adapter: async func(options: option<gpu-request-adapter-options>) -> option<gpu-adapter>;
      get-preferred-canvas-format: func() -> gpu-texture-format;
    }

    enum gpu-power-preference {
      low-power,
      high-performance,
    }

    record gpu-request-adapter-options {
      feature-level: option<string>,
      power-preference: option<gpu-power-preference>,
      force-fallback-adapter: option<bool>,
      xr-compatible: option<bool>,
    }

    enum gpu-feature-name {
      core-features-and-limits,
      depth-clip-control,
      depth32float-stencil8,
      texture-compression-bc,
      texture-compression-bc-sliced3d,
      texture-compression-etc2,
      texture-compression-astc,
      texture-compression-astc-sliced3d,
      timestamp-query,
      indirect-first-instance,
      shader-f16,
      rg11b10ufloat-renderable,
      bgra8unorm-storage,
      float32-filterable,
      float32-blendable,
      clip-distances,
      dual-source-blending,
      subgroups,
      texture-formats-tier1,
      texture-formats-tier2,
      primitive-index,
      texture-component-swizzle,
    }

    record gpu-queue-descriptor {
      label: option<string>,
    }

    record gpu-device-descriptor {
      required-features: option<list<gpu-feature-name>>,
      required-limits: option<record-option-gpu-size64>,
      default-queue: option<gpu-queue-descriptor>,
      label: option<string>,
    }

    variant request-device-error-kind {
      type-error,
      operation-error,
    }

    record request-device-error {
      kind: request-device-error-kind,
      message: string,
    }

    enum gpu-texture-format {
      r8unorm,
      r8snorm,
      r8uint,
      r8sint,
      r16unorm,
      r16snorm,
      r16uint,
      r16sint,
      r16float,
      rg8unorm,
