// `zena:cli` over wasi:cli 0.3.0: the arguments and environment the
// host hands a component. `wasmtime run` passes the component's path
// as the program name and nothing else, and `--env` sets a variable.
import { getArguments, getEnv, getEnvironment, getProgramName } from 'zena:cli';

export function main(): u32 {
  let args = getArguments();
  console.log(`args ${args.length}`);
  console.log(`program ${getProgramName().endsWith('cli-env.wasm')}`);
  let greeting = getEnv('ZENA_GREETING');
  console.log(`greeting ${greeting ?? 'unset'}`);
  var found = false;
  for (let env in getEnvironment()) {
    if (env.name == 'ZENA_GREETING' && env.value == 'hello') {
      found = true;
    }
  }
  console.log(`listed ${found}`);
  return 0 as u32;
}
