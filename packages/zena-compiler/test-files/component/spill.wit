// Two Zena components composed: `consumer` calls `provider`'s `wide`
// functions, whose parameters spill — seventeen core values on the
// synchronous ones, five on the asynchronous one — so the consumer
// lowers them into memory it owns and passes one address, and the
// provider lifts them back out.
package test:spill@1.0.0;

interface wide {
  sum: func(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32,
      h: u32, i: u32, j: u32, k: u32, l: u32, m: u32, n: u32, o: u32,
      p: u32, q: u32) -> u32;
  describe: func(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32,
      h: u32, i: u32, j: u32, k: u32, l: u32, m: u32, n: u32, o: u32,
      p: u32, name: string) -> string;
  sum-async: async func(a: u32, b: u32, c: u32, d: u32, e: u32) -> u32;
}

world provider {
  export wide;
}

world consumer {
  import wasi:cli/stdout@0.3.0;
  import wasi:cli/stderr@0.3.0;
  import wide;

  export main: async func() -> u32;
}
