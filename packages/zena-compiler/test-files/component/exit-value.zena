// An async main with a value. The entry is lifted async, so the value
// cannot come back from the call: it travels through `task.return`,
// typed with main's result, issued once the future settles — after
// the timer here, from the callback re-entry that fired it. The
// compiler writes the wrapper that declares that return
// (lib/component-entry.zena) and the driver calls it from the task's
// own entry (`finishTask` in zena:component-async).
import { sleep, milliseconds } from 'zena:time';
import { Future } from 'zena:async';

export async function main(): Future<u32> {
  await sleep(milliseconds(10));
  return 42;
}
