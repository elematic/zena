// A Zena provider of `fixture:geo/survey`: every function of the
// interface implemented with plain exported functions over the
// classes the interface's synthesized module declares — the same
// module the consumer imports them from. The answers are chosen so
// that `geo-wit.zena`'s `main`, run against this provider, sums to 49.
import {
  Point, Reading, Quality, Finding, FindingAt, Note, NoteText, NoteId
} from 'fixture:geo/survey';
import { Option, Some, some, none, Result } from 'zena:core';
import { Future } from 'zena:async';

export function origin(): Point {
  return new Point(0.0, 0.0, 'origin');
}

export function locate(name: String): Option<Point> {
  if (name == 'base') {
    return some(new Point(1.0, 2.0, name));
  }
  return none;
}

export function surveyAll(): Array<Reading> {
  let out = new GrowableArray<Reading>();
  out.push(new Reading(Quality.Good, some(1 as u16)));
  out.push(new Reading(Quality.Poor, none));
  out.push(new Reading(Quality.Good, none));
  return out;
}

export function check(id: u32): Result<Point, Finding> {
  return (true, new Point(id as f64, 0.0, 'seven'));
}

export function bounds(): (Point, Point) {
  return (new Point(1.0, 0.0, 'a'), new Point(2.0, 0.0, 'b'));
}

export async function fetchPoint(name: String): Future<Result<Point, Finding>> {
  return (true, new Point(0.0, 0.0, name));
}

export async function pushLabels(names: Array<String>): Future<void> {
}

export function labelOf(p: Point): u32 {
  return p.label.length as u32;
}

export function annotate(n: Note): u32 {
  if (n is NoteText) {
    return (n as NoteText).value.length as u32;
  }
  if (n is NoteId) {
    return (n as NoteId).value;
  }
  return 0 as u32;
}

export function maybeName(n: Option<String>): u32 {
  if (n is Some<String>) {
    return (n as Some<String>).value.length as u32;
  }
  return 0 as u32;
}

export function sendLabels(names: Array<String>): u32 {
  return names.length as u32;
}

export function window(w: (u32, u32)): u32 {
  let (a, b) = w;
  return a * b;
}

export function report(f: Finding): u32 {
  if (f is FindingAt) {
    return (f as FindingAt).value.x as u32;
  }
  return 0 as u32;
}
