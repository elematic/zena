// A component that prints, over WASI p3 stdio.
//
// `console` is an explicit import on this target rather than a prelude
// binding — a prelude module loads with the entry and would perturb
// every component build, printing or not. The two lines matter: the
// second write reuses the free list the first write's buffers went
// back to, through the runtime memory module's allocator.

import { console } from 'zena:console';

export function main(): i32 {
  console.log('hello from a component');
  console.error('and a line to stderr');
  console.log('the free list survived the first write');
  return 0;
}
