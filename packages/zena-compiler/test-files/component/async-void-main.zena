// An `async main` that awaits nothing, against a world whose only
// export is `main: async func()`.
//
// The async pass replaces the `main` export with a synthesized wrapper,
// and only the component entry can lift one — a wrapper has no
// declaration to read a signature from. The entry is built when the
// async driver is rooted, and the driver used to be rooted only by an
// awaited async import or by an entry wrapper module, neither of which
// this program has. So it failed to compile with "the component target
// cannot export 'main$asyncEntry'"; `#rootComponentAsyncDriver` now
// counts an `async main` as a third door.
import { Future } from 'zena:async';

export async function main(): Future<void> { }
