// An `async main` that awaits nothing, against a world whose only
// export is `main: async func()`.
//
// Only the component entry can lift an `async main` returning
// `Future<void>`. The entry is built when the async driver is rooted,
// and the driver used to be rooted only by an awaited async import or
// by an entry wrapper module, neither of which this program has.
// `#rootComponentAsyncDriver` counts an `async main` as a door into the
// driver as well.
import { Future } from 'zena:async';

export async function main(): Future<void> { }
