// Enums and flags through a WIT-typed module: `Level` is a synthesized
// Zena enum whose ordinals are the wire discriminants, `Modes` a
// distinct u32 bitset with one constant per flag. Compile-level
// coverage — no host serves `wasi:codes` — the unit tests assert the
// synthesized source and that this program emits a component.
import {
  Level, Modes, modesRead, describe, classify, openModes, combine
} from 'wasi:codes/status';

export function main(): u32 {
  let level = classify(3);
  if (level == Level.FatalError) {
    return 1;
  }
  let text = describe(Level.Warning);
  let m = openModes();
  return combine(m, modesRead) + (text.length as u32);
}
