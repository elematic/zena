// Byte streams and futures through a WIT-typed module: stream
// positions bind to `zena:stream`'s `Stream<u8>` pumped by
// `zena:wasi`, future positions bind to `Future` moved by
// generated per-payload-type helpers, and a bare result arm is a
// `void` lane. Compile-only — no host serves `fixture:pipe` — so the
// point is the whole surface compiling: a direct stream result, a
// stream parameter, streams inside a tuple and an option, an async
// transfer, a scalar-payload future result, a future parameter with
// an Outcome payload, a rich future inside a tuple, and a sync
// bare-arm result. The async transfer roots the driver, so the entry
// is callback-lifted and `main` is async.
import {
  source, sink, tee, open, transfer, finish, deliver, submit, commit,
  PipeError, PipeErrorClosed,
} from 'fixture:pipe/pipes';
import { Stream, StreamWriter } from 'zena:stream';
import { Some, Option, Result } from 'zena:core';
import { Completer, Future } from 'zena:async';

export async function main(): Future<void> {
  let incoming = source();
  let outgoing = new StreamWriter<u8>();
  if (sink(outgoing.stream) != (0 as u32)) {
    incoming.stop();
  }
  let (left, right) = tee();
  transfer(left);
  if (open('names') is Some<Stream<u8>>) {
    right.stop();
  }
  let counted = finish();
  let done = new Completer<Result<void, PipeError>>();
  deliver(done.future);
  let (accepted, confirmation) = submit('names');
  if (let (false, error) = commit()) {
    if (error is PipeErrorClosed) {
      incoming.stop();
    }
  }
  await consume(counted, accepted, confirmation);
}

async function consume(
  counted: Future<u32>,
  accepted: u32,
  confirmation: Future<Result<Option<String>, PipeError>>
): Future<void> {
  let n = await counted;
  let got = await confirmation;
  if (n == accepted && got is (true, Option<String>)) {
    return;
  }
}
