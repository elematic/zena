// An HTTP GET over real p3 wasi:http, written the way a program
// would: `zena:fetch`'s `fetch(url)`, the status, the body as text.
// The e2e script serves 127.0.0.1:18923 from a local node server
// while this runs under wasmtime, and asserts the printed lines.
//
// Underneath, `zena:fetch` on this target builds a `wasi:http/types`
// request, sends it through `wasi:http/client`, and pumps the body
// stream — the bindings the compiler synthesizes from the WIT the
// stdlib ships, imported as the `wasi` package without any manifest.
import { fetch } from 'zena:fetch';

export async function main(): Future<void> {
  let response = await fetch('http://127.0.0.1:18923/hello');
  console.log(response.status);
  let contentType = response.header('content-type');
  if (contentType != null) {
    console.log(`content-type: ${contentType}`);
  }
  let text = await response.text();
  if (text == 'hello from the host') {
    console.log('body ok');
  } else {
    console.log('body mismatch: ' + text);
  }
}
