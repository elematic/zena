// Aggregates through a WIT-typed module: records lift as case
// classes, variants as sealed hierarchies, options and lists and
// tuples compose around them, and a top-level result arrives as the
// inline Result. Compile-level coverage — no host serves `wasi:geo` —
// the unit tests assert the synthesized source.
import {
  Point, Reading, Quality, Finding, FindingAt, Note, NoteText, NoteEmpty,
  origin, locate, surveyAll, check, bounds,
  labelOf, annotate, maybeName, sendLabels, window
} from 'wasi:geo/survey';
import { Some, some, none } from 'zena:option';

export function main(): u32 {
  let p = origin();
  var acc = p.label.length as u32;
  acc += labelOf(new Point(1.0, 2.0, 'origin'));
  acc += annotate(new NoteText('hello'));
  acc += annotate(new NoteEmpty());
  acc += maybeName(some('base'));
  acc += maybeName(none);
  let labels = new GrowableArray<String>();
  labels.push('a');
  labels.push('b');
  acc += sendLabels(labels);
  acc += window((3 as u32, 4 as u32));
  if (let (true, good, _) = check(7)) {
    acc += good.x as u32;
  }
  let maybe = locate('base');
  if (maybe is Some<Point>) {
    acc += (maybe as Some<Point>).value.y as u32;
  }
  for (let r in surveyAll()) {
    if (r.quality == Quality.Good) {
      acc += 1;
    }
  }
  let (a, b) = bounds();
  acc += (a.x + b.x) as u32;
  return acc;
}
