// An async `main` that returns a `String`. The entry wrapper returns
// it through a `task.return` typed `string`, which, unlike a flat
// scalar's, needs the memory the host reads the string out of.
import { Future } from 'zena:async';
import { sleep, milliseconds } from 'zena:time';

export async function main(): Future<String> {
  await sleep(milliseconds(1));
  return `waited, then returned ${'a string'}`;
}
