// The reason component emission exists: `wasi:clocks` is a WIT
// interface, and a core module cannot name one. `now` is a flat scalar
// in and out, so it needs no memory, no realloc, and no type encoding
// beyond primitives. See docs/design/component-emission.md.
@external("wasi:clocks/monotonic-clock@0.3.0", "now")
declare function monotonicNow(): u64;

export function main(): u64 {
  return monotonicNow();
}
