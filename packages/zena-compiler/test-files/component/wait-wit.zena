// A WIT-typed async import: `wait-for` is `async` in the package's
// WIT, so the synthesized module renders the raw declaration — lowered
// with the canonical `async` option, its core result the packed
// subtask — plus a wrapper that hands that to `awaitPacked`. What the
// program imports is the wrapper, and its type is `Future<void>`, the
// same future every other async source returns.
import { waitFor } from 'wasi:clocks/monotonic-clock';
import { drainMicrotasks, Future } from 'zena:async';

async function wait(): Future<void> {
  await waitFor(1000000);
}

export function main(): void {
  wait();
  drainMicrotasks();
}
