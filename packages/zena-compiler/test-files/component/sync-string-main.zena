// A synchronous `main` that returns a `String` and prints. Printing can
// wait for the host, so the entry is lifted async, and the string goes
// back through a `task.return` typed `string` rather than as the
// lifted call's own result.
import { console } from 'zena:console';

export function main(): String {
  console.log('printed first');
  return 'then returned';
}
