// A program compiled against a declared world: `declared.wit`, via
// `--wit`/`--world`. The world is the authority — the component's
// import surface is the world's, and a disagreement in either
// direction (an @external the world lacks, an export the program
// lacks, a type that differs) is a compile error rather than a
// component that fails at instantiation.

import { console } from 'zena:console';

export function main(): i32 {
  console.log('declared world says hello');
  return 0;
}

export function shout(): String {
  return 'FROM A DECLARED WORLD';
}
