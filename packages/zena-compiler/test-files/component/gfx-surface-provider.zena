// The provider half of the exported-resource composition: `Surface`
// and `Context` are the classes behind the `surface` interface's
// resources. The compiler-written wrapper keeps each instance in a
// table by its representation, mints a handle over it when a
// constructor or an own result hands one out, and looks it up again
// when a method's `self` or a borrowed parameter arrives.
import { FrameEvent } from 'test:gfx-surface/surface';
import { Stream, StreamWriter } from 'zena:stream';
import { Future } from 'zena:async';
import { Disposable } from 'zena:core';

/** How many surfaces have been disposed: the destructor reaches the
 * class's `dispose` when the consumer drops its last handle. */
var disposedSurfaces = 0 as u32;

async function produce(writer: StreamWriter<FrameEvent>, count: i32): Future<void> {
  for (var i = 0; i < count; i += 1) {
    await writer.write(new FrameEvent(i as u64, (i as f32) * 16.5));
  }
  writer.close();
}

export class Surface implements Disposable {
  width: u32;
  height: u32;
  new(this.width, this.height);

  [Disposable.dispose](): void {
    disposedSurfaces += 1 as u32;
  }

  size(): u32 {
    return this.width * this.height;
  }

  async onFrame(count: u32): Future<Stream<FrameEvent>> {
    let writer = new StreamWriter<FrameEvent>();
    produce(writer, count as i32);
    return writer.stream;
  }

  describe(): String {
    return `${this.width}x${this.height}`;
  }

  static defaultSize(): u32 {
    return 64 as u32;
  }

  static disposed(): u32 {
    return disposedSurfaces;
  }

  // An own parameter: the instance itself, back from the table. The
  // consumer's handle is spent, and no destructor runs for it.
  static adopt(s: Surface): u32 {
    return s.size();
  }
}

export class Context implements Disposable {
  surface: Surface;
  new(this.surface);

  area(): u32 {
    return this.surface.size();
  }

  // A resource's class is a Disposable: its dispose is the destructor
  // the host calls when the last handle over it is dropped.
  [Disposable.dispose](): void {}
}

export function openContext(surface: Surface): Context {
  return new Context(surface);
}
