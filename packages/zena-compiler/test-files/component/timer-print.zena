// One component, both WASI generations: a p3 timer and p2 stdio.
//
// A component is not "a p2 component" or "a p3 component" — each import
// names its own interface version, and the world mixes them. This is
// the design's 1.4 evidence as a regression test: the sleep is
// `wasi:clocks/monotonic-clock@0.3.0` lowered async, the print is
// `wasi:cli/stdout@0.2.8`, and both live in one binary. Printing
// *after* the sleep proves stdio still works once the event loop has
// run — that write happens on re-entry through the async callback.

import { console } from 'zena:console';
import { sleep } from 'zena:time';
import { drainMicrotasks, Future } from 'zena:async';

async function announce(): Future<void> {
  await sleep(50);
  console.log('after the sleep');
}

export function main(): void {
  console.log('before the sleep');
  announce();
  drainMicrotasks();
}
