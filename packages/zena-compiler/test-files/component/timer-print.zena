// A p3 timer and p3 stdio in one component. Printing *after* the
// sleep proves stdio still works once the event loop has run — that
// write happens on re-entry through the async callback, and it is a
// synchronous `stream.write` issued from inside a callback-lifted
// task.

import { console } from 'zena:console';
import { sleep, milliseconds } from 'zena:time';
import { Future } from 'zena:async';

async function announce(): Future<void> {
  await sleep(milliseconds(50));
  console.log('after the sleep');
}

export async function main(): Future<void> {
  console.log('before the sleep');
  await announce();
}
