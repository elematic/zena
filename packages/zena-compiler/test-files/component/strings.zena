// Strings across the component boundary, in both directions.
//
// A `string` is the first type that does not fit in the flat scalars: it
// is bytes in linear memory, so lifting one needs the canonical options
// and a wrapper to do the copying. Run under wasmtime with
// `--invoke 'greet("world")'`.

export function main(): i32 {
  return 0;
}

/** Host writes a string, guest reads it. */
export function measure(text: String): i32 {
  return text.length;
}

/** Guest writes a string, host reads it. */
export function shout(): String {
  return 'HELLO FROM A COMPONENT';
}

/** Both directions in one call, with a concatenation in between. */
export function greet(name: String): String {
  return 'hello, ' + name;
}

/** An empty result: the length is zero and the pointer is never read. */
export function nothing(): String {
  return '';
}
