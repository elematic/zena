// A wasi:http service: `handle` answers every request with a text
// body naming the path it was asked for. The world exports the
// `handler` interface as an instance, the compiler-written wrapper
// lifts the request handle into `Request` and lowers the `Outcome`
// into a `task.return` typed `result<response, error-code>`, and
// `wasmtime serve` drives it — the e2e script fetches a path and
// reads the body back.
//
// The body is a `Stream<u8>` the response is built around, written by
// a background task: a stream write meets its reader, and the reader
// is the host, which reads only once the response has been returned.
// `textResponse` (zena:http) builds all of that from a string.
import { Request, Response, ErrorCode } from 'wasi:http/types';
import { Future } from 'zena:async';
import { Option, Some, Result } from 'zena:core';
import { textResponse } from 'zena:http';
import { sleep, milliseconds } from 'zena:time';

export async function handle(request: Request): Future<Result<Response, ErrorCode>> {
  // The path and query the request asked for, `/` when it named none.
  var path = '/';
  let requestedPath = request.getPathWithQuery();
  if (requestedPath is Some<String>) {
    path = (requestedPath as Some<String>).value;
  }
  // Suspend mid-request, so that the e2e's concurrent requests are all
  // in flight at once: each is its own task, and the driver must keep
  // them apart — answer each from its own entry, return each its own
  // value.
  await sleep(milliseconds(100));
  return (true, 
      textResponse('hello from zena at ' + path));
}
