// A world whose `main` is async while the program's is not.
//
// The async-ness that matters belongs to the lift, not to the Zena
// function: an async lift is the only thing that can return WAIT and so
// the only way the host learns to come back. Declaring it here means the
// wrapper synthesizer builds the task, and the program keeps an ordinary
// synchronous `main` that starts work and returns.
package test:sync-main-then@0.1.0;

world app {
  // `sleep` parks on this; a declared world has to name what the program
  // imports.
  import wasi:clocks/monotonic-clock@0.3.0;
  // The entry's uncaught-exception path can print a stack trace, so the
  // program reaches `wasi:cli/stdout` whether or not it ever prints.
  import wasi:cli/stdout@0.3.0;

  export main: async func();
}
