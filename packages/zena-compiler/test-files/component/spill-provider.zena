// The provider half of the spill fixture: it exports `wide`, whose
// functions take more parameters than the canonical ABI passes as
// core values, so the compiler-written wrapper lifts them out of the
// memory the caller spilled them into.
import { Future } from 'zena:async';

export function sum(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32,
    g: u32, h: u32, i: u32, j: u32, k: u32, l: u32, m: u32, n: u32,
    o: u32, p: u32, q: u32): u32 {
  return a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p + q;
}

export function describe(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32,
    g: u32, h: u32, i: u32, j: u32, k: u32, l: u32, m: u32, n: u32,
    o: u32, p: u32, name: String): String {
  let total = a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p;
  return `${total} ${name}`;
}

export async function sumAsync(a: u32, b: u32, c: u32, d: u32,
    e: u32): Future<u32> {
  return a + b + c + d + e;
}
