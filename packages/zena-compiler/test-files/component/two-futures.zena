// Two WIT interfaces that each lift a future of their own:
// `wasi:cli/stdin`'s read-via-stream, and `wasi:filesystem`'s, which
// `zena:fs` reads a file through. Each interface's generated bindings
// declare the per-type future builtins, and the two must not collide.
import { readViaStream } from 'wasi:cli/stdin';
import { readFile } from 'zena:fs';

export let main = (): i32 => {
  let (input, done) = readViaStream();
  return readFile('input.txt').length;
};
