// Probe: a borrowed cross-package resource inside a record parameter.
import { Surface, Context, ContextConfiguration } from 'fixture:gfx/surface';
import { GpuDevice, TextureFormat } from 'fixture:gfx/device';

export function main(): u32 {
  let surface = new Surface(0);
  let context = surface.getContext();
  let device = new GpuDevice(0);
  context.configure(new ContextConfiguration(device, TextureFormat.Rgba8));
  return 0 as u32;
}
