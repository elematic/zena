// The world `declared.zena` is compiled against. The wasi packages are
// not vendored here: the compiler carries their WIT and splices it in,
// which is exactly what lets a world import them by name.
package test:app@1.0.0;

world app {
  import wasi:cli/stdout@0.3.0;
  import wasi:cli/stderr@0.3.0;

  export main: func() -> s32;
  export shout: func() -> string;
}
