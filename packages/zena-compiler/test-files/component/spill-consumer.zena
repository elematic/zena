// The consumer half of the spill fixture: it calls the provider's
// `wide` functions with more arguments than travel as core values.
// The bindings stage them into one buffer and pass its address; the
// synchronous calls free it on return, the asynchronous one once its
// subtask has returned.
import { sum, describe, sumAsync } from 'test:spill/wide';
import { Future } from 'zena:async';

export async function main(): Future<u32> {
  let total = sum(1 as u32, 2 as u32, 3 as u32, 4 as u32, 5 as u32,
      6 as u32, 7 as u32, 8 as u32, 9 as u32, 10 as u32, 11 as u32,
      12 as u32, 13 as u32, 14 as u32, 15 as u32, 16 as u32, 17 as u32);
  let text = describe(1 as u32, 2 as u32, 3 as u32, 4 as u32, 5 as u32,
      6 as u32, 7 as u32, 8 as u32, 9 as u32, 10 as u32, 11 as u32,
      12 as u32, 13 as u32, 14 as u32, 15 as u32, 16 as u32, 'z');
  console.log(`described ${text}`);
  let five = await sumAsync(1 as u32, 2 as u32, 3 as u32, 4 as u32,
      5 as u32);
  // 153 + 15.
  return total + five;
}
