// `zena:fs` over wasi:filesystem 0.3.0, the asynchronous API from an
// `async` main: a directory made, a file written and read back as text
// and as bytes, listed, stat'd, renamed, and everything removed again
// — under `wasmtime -S p3=y --dir`. Each `await` parks the task on the
// import's subtask and the host re-enters through the callback; nothing
// here blocks. (fs-sizes.zena is the same filesystem through the
// `Sync` forms, which wait in `blockOn`.)
import {
  exists, isDirectory, isFile, listDir, mkdir, readFile, readFileBytes,
  rename, rmdir, stat, unlink, writeFile, writeFileBytes, FileType,
} from 'zena:fs';

export async function main(): Future<u32> {
  let dir = 'fs-roundtrip-scratch';
  if (await exists(dir)) {
    for (let entry in await listDir(dir)) {
      await unlink(`${dir}/${entry.name}`);
    }
    await rmdir(dir);
  }
  await mkdir(dir);
  if (!await isDirectory(dir)) {
    console.log('mkdir did not make a directory');
    return 1 as u32;
  }

  let path = `${dir}/hello.txt`;
  await writeFile(path, 'hello, file');
  let text = await readFile(path);
  console.log(`read ${text}`);
  if (!await isFile(path) || await isDirectory(path)) {
    console.log('the file is not a file');
    return 2 as u32;
  }
  let info = await stat(path);
  console.log(`size ${info.size} regular ${info.fileType == FileType.RegularFile}`);

  // Overwriting truncates: the shorter text replaces the longer one.
  await writeFile(path, 'hi');
  if (await readFile(path) != 'hi') {
    console.log('overwrite did not truncate');
    return 3 as u32;
  }

  let bytes = new FixedArray<u8>(3, 0 as u8);
  bytes[0] = 1 as u8;
  bytes[1] = 2 as u8;
  bytes[2] = 255 as u8;
  let binPath = `${dir}/bytes.bin`;
  await writeFileBytes(binPath, bytes);
  let back = await readFileBytes(binPath);
  console.log(`bytes ${back.length} ${back[2]}`);

  // The host lists in its own order, so membership is what is checked.
  let entries = await listDir(dir);
  var sawText = false;
  var sawBytes = false;
  for (let entry in entries) {
    if (entry.name == 'hello.txt') { sawText = entry.fileType == FileType.RegularFile; }
    if (entry.name == 'bytes.bin') { sawBytes = true; }
  }
  console.log(`entries ${entries.length} ${sawText} ${sawBytes}`);

  await rename(binPath, `${dir}/moved.bin`);
  if (await exists(binPath) || !await exists(`${dir}/moved.bin`)) {
    console.log('rename did not move the file');
    return 4 as u32;
  }

  await unlink(path);
  await unlink(`${dir}/moved.bin`);
  await rmdir(dir);
  console.log(`gone ${!await exists(dir)}`);
  return 0 as u32;
}
