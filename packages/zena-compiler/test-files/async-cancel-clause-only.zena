import { Future } from 'zena:async';

let work = async (): Future<i32> => {
  try {
    let v = await Future.of(21);
    return v * 2;
  } cancel {
    // Nothing in this program can raise a cancellation, so this
    // clause is dead and the compiler elides it.
  }
};

export async function main(): Future<i32> {
  return await work();
}
