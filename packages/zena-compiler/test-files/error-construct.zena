// Constructing an `Error` is what reaches the stack-trace hooks: the
// constructor captures a trace, so `zena:error-stack` is linked into any
// program that can throw. On a target whose host supplies the hooks that
// is two `env` imports; on `freestanding` it must be none, which is what
// `binary-size_test.zena` asserts. See docs/design/component-emission.md.
export function main(): i32 {
  let e = new Error("boom");
  return e.message.length;
}
