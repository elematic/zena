// A step between minimal and array-sum: one string literal, returned.
// This genuinely needs the String class, the literal machinery (data
// segment, __start, $fromShared/getLiteral) and the four $string*
// host-interop exports — the host reads the returned value through
// $stringGetLength/$stringGetByte — but it calls NO String methods, so
// it is the fixture that tracks what instantiating String costs beyond
// the literal itself (today: every method, via the vtable force-reach
// — see "The keystone" in docs/design/binary-size.md).
// `binary-size_test.zena` holds it to a byte budget.
export function main(): String {
  return "Hello World";
}
