// The same import, with a tagged template. This is the one thing that
// builds a TemplateStringsArray, so it must ship here.
import { TemplateStringsArray } from 'zena:core';

let tag = (strings: TemplateStringsArray, values: FixedArray<i32>): i32 => {
  return strings.length + values[0];
};

export function main(): i32 {
  return tag`a${7}b`;
}
