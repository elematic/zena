// A counting loop written as a for-in over a range literal.
// `binary-size_test.zena` requires it to compile to exactly the bytes
// of counting-loop.zena, the same loop written C-style.
export function main(n: i32): i32 {
  var total = 0;
  for (let i in 0..n) {
    total += i;
  }
  return total;
}
