import { Iterator } from 'zena:core';

let counting = gen (): Iterator<i32> => {
  yield 1;
  yield 2;
};

export let main = (): i32 => {
  // Manual protocol consumption only — the Step is matched by hand,
  // not iterated through a for-in over the Iterator protocol — so
  // nothing can dispose and the gate stays closed.
  var acc = 0;
  let it = counting();
  var running = true;
  while (running) {
    match (it.next()) {
      case (1, let v, _): { acc += v; }
      case _: { running = false; }
    }
  }
  return acc - 3;
};
