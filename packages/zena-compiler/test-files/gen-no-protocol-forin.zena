import { Iterator } from 'zena:iterator';

let counting = gen (): Iterator<i32> => {
  yield 1;
  yield 2;
};

export let main = (): i32 => {
  // Manual protocol consumption only — no for-in through the
  // Iterator protocol, so nothing can dispose and the gate stays
  // closed.
  var acc = 0;
  let it = counting();
  while (let (true, v) = it.next()) {
    acc += v;
  }
  return acc - 3;
};
