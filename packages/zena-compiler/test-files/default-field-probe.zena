class Cell<T> {
  var v: T;
  new();
  set(value: T): void {
    this.v = value;
  }
}

export let main = (): i32 => {
  let a = new Cell<i32>();
  let before = a.v;
  a.set(41);
  let b = new Cell<String>();
  let s: String | null = null;
  // b.v is the default: for a reference T that is null-at-rest even
  // though the declared type is String.
  return a.v + before + 1;
};
