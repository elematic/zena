// For-in loops over range values that are not written in the loop
// header: each loop reads the range's bounds and counts, and must not
// reach the ranges' iterators (see `binary-size_test.zena`).
let sum = (r: BoundedRange): i32 => {
  var total = 0;
  for (let i in r) {
    total += i;
  }
  return total;
};

let sumUntil = (r: FromRange, limit: i32): i32 => {
  var total = 0;
  for (let i in r) {
    if (i >= limit) { break; }
    total += i;
  }
  return total;
};

export function main(n: i32): i32 {
  return sum(0..n) + sumUntil(n.., 100);
}
