let runDirectAccessBenchmark = (container: DirectContainer, n: i32): i32 => {
  var lenSum = 0;
  for (var i = 0; i < n; i += 1) {
    let s = container.value;
    lenSum = lenSum + s.length;
  }
  return lenSum;
};

let runCastAccessBenchmark = (container: CastContainer, n: i32): i32 => {
  var lenSum = 0;
  for (var i = 0; i < n; i += 1) {
    let s = container.value as String;
    lenSum = lenSum + s.length;
  }
  return lenSum;
};

