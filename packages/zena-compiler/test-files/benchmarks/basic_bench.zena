import { console } from 'zena:console';
import { String } from 'zena:string';
import { getArguments } from 'zena:cli';
import { Iterator, Iterable } from 'zena:iterator';
import { IterableUtils } from 'zena:iterable-utils';
import { ImmutableArray } from 'zena:immutable-array';
import { runTest } from 'zena:benchmark';

let fibRecursive = (n: i32): i32 => {
  if (n <= 1) {
    return n;
  }
  return fibRecursive(n - 1) + fibRecursive(n - 2);
};

let fibIterative = (n: i32): i32 => {
  var a = 0;
  var b = 1;
  for (var i = 0; i < n; i += 1) {
    let temp = (a + b) % 1000000;
    a = b;
    b = temp;
  }
  return a;
};

let add = (a: i32, b: i32): i32 => a + b;

let testSimpleCall = (n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = add(sum, 1);
  }
  return sum;
};

let addNoInline = (a: i32, b: i32): i32 => {
  if (a < -1000000) {
    var x = a;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    return x;
  }
  return a + b;
};

let testNoInlineCall = (n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = addNoInline(sum, 1);
  }
  return sum;
};

let makeClosure = (offset: i32): (x: i32) => i32 => {
  return (x: i32): i32 => x + offset;
};

let runClosureBenchmark = (closure: (sum: i32) => i32, n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = closure(sum);
  }
  return sum;
};

class BaseClass {
  new();
  getValue(): i32 { return 1; }
}

class SubClassOfBase extends BaseClass {
  new() : super() {}
  getValue(): i32 { return 2; }
}

class BaseClassWithOverride {
  new();
  getValue(): i32 { return 1; }
}

class SubClassWithOverride extends BaseClassWithOverride {
  new() : super() {}
  getValue(): i32 { return 2; }
}

final class FinalClass {
  new();
  getValue(): i32 { return 1; }
}

class CastContainer {
  value: anyref;
  new(this.value);
}

class DirectContainer {
  value: String;
  new(this.value);
}

class BaseClassWithField {
  value: i32;
  new(this.value);
}

class SubClassWithField extends BaseClassWithField {
  new(v: i32) : super(v) {}
}

final class FinalClassWithField {
  value: i32;
  new(this.value);
}

class ClassWithFinalField {
  final value: i32;
  new(this.value);
}

class EffectivelyFinalClassWithField {
  value: i32;
  new(this.value);
}

class BaseClassWithMutableField {
  var value: i32;
  new(this.value);
}

class SubClassWithMutableField extends BaseClassWithMutableField {
  new(v: i32) : super(v) {}
}

final class FinalClassWithMutableField {
  var value: i32;
  new(this.value);
}

class ClassWithFinalMutableField {
  final var value: i32;
  new(this.value);
}

class EffectivelyFinalClassWithMutableField {
  var value: i32;
  new(this.value);
}

final class CustomCollectionIterator implements Iterator<i32> {
  #array: FixedArray<i32>;
  var #index: i32;

  new(arr: FixedArray<i32>) : #array = arr, #index = 0;

  next(): inline (true, i32) | inline (false, _) {
    if (this.#index < this.#array.length) {
      let value = this.#array[this.#index];
      this.#index += 1;
      return (true, value);
    }
    return (false, _);
  }
}

final class CustomCollection with IterableUtils<i32> implements Iterable<i32> {
  #array: FixedArray<i32>;

  new(arr: FixedArray<i32>) : #array = arr;

  :Iterable.iterator(): Iterator<i32> {
    return new CustomCollectionIterator(this.#array);
  }
}

let runForLoopBenchmark = (arr: FixedArray<i32>): i32 => {
  var sum = 0;
  let len = arr.length;
  for (var i = 0; i < len; i += 1) {
    sum = sum + arr[i];
  }
  return sum;
};

let runForInArrayBenchmark = (arr: FixedArray<i32>): i32 => {
  var sum = 0;
  for (let x in arr) {
    sum = sum + x;
  }
  return sum;
};

let runWhileArrayBenchmark = (arr: FixedArray<i32>): i32 => {
  var sum = 0;
  let len = arr.length;
  var i = 0;
  while (i < len) {
    sum = sum + arr[i];
    i += 1;
  }
  return sum;
};

let runForInArrayInterfaceBenchmark = (iterable: Iterable<i32>): i32 => {
  var sum = 0;
  for (let x in iterable) {
    sum = sum + x;
  }
  return sum;
};

let runForInGrowableArrayBenchmark = (arr: Array<i32>): i32 => {
  var sum = 0;
  for (let x in arr) {
    sum = sum + x;
  }
  return sum;
};

let runForInGrowableArrayInterfaceBenchmark = (iterable: Iterable<i32>): i32 => {
