import { Memory, defaultAllocator } from 'zena:memory';
import { console } from 'zena:console';
import { String } from 'zena:string';
import { getArguments } from 'zena:cli';
import { Iterator, Iterable } from 'zena:iterator';
import { IterableUtils } from 'zena:iterable-utils';

@external("wasi_snapshot_preview1", "clock_time_get")
declare function __wasi_clock_time_get(
  clockId: i32,
  precision: i64,
  timePtr: i32
): i32;

let getMonotonicTimeMs = (): f64 => {
  if (let (true, addr) = defaultAllocator.allocAligned(8, 8)) {
    // Clock ID 1 is CLOCK_MONOTONIC. Precision 1ns.
    let res = __wasi_clock_time_get(1, 1 as i64, addr);
    if (res == 0) {
      let ns = Memory.default.getI64(addr);
      defaultAllocator.free(addr);
      return (ns as f64) / 1000000.0;
    }
    defaultAllocator.free(addr);
  }
  return 0.0;
};

let formatFloat = (n: f64): String => {
  let total = n;
  let integerPart = total as i32;
  let fractionPart = ((total - (integerPart as f64)) * 100.0) as i32;
  let fractionPartAbs = if (fractionPart < 0) -fractionPart else fractionPart;
  let fracStr = if (fractionPartAbs < 10) "0" + i32ToString(fractionPartAbs) else i32ToString(fractionPartAbs);
  return i32ToString(integerPart) + "." + fracStr;
};

let runTest = (name: String, testFunc: () => void, filter: String): void => {
  if (filter.length > 0 && !name.contains(filter)) {
    return;
  }
  // Warm up the JIT compiler
  testFunc();

  let start = getMonotonicTimeMs();
  testFunc();
  let end = getMonotonicTimeMs();
  console.log(name + ": " + formatFloat(end - start) + " ms");
};

let fibRecursive = (n: i32): i32 => {
  if (n <= 1) {
    return n;
  }
  return fibRecursive(n - 1) + fibRecursive(n - 2);
};

let fibIterative = (n: i32): i32 => {
  var a = 0;
  var b = 1;
  for (var i = 0; i < n; i += 1) {
    let temp = (a + b) % 1000000;
    a = b;
    b = temp;
  }
  return a;
};

let add = (a: i32, b: i32): i32 => a + b;

let testSimpleCall = (n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = add(sum, 1);
  }
  return sum;
};

let addNoInline = (a: i32, b: i32): i32 => {
  if (a < -1000000) {
    var x = a;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    x = x + 1; x = x + 1; x = x + 1; x = x + 1; x = x + 1;
    return x;
  }
  return a + b;
};

let testNoInlineCall = (n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = addNoInline(sum, 1);
  }
  return sum;
};

let makeClosure = (offset: i32): (x: i32) => i32 => {
  return (x: i32): i32 => x + offset;
};

let runClosureBenchmark = (closure: (sum: i32) => i32, n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = closure(sum);
  }
  return sum;
};

class BaseClass {
  new();
  getValue(): i32 { return 1; }
}

class SubClassOfBase extends BaseClass {
  new() : super() {}
  getValue(): i32 { return 2; }
}

class BaseClassWithOverride {
  new();
  getValue(): i32 { return 1; }
}

class SubClassWithOverride extends BaseClassWithOverride {
  new() : super() {}
  getValue(): i32 { return 2; }
}

final class FinalClass {
  new();
  getValue(): i32 { return 1; }
}

class CastContainer {
  value: any;
  new(this.value);
}

class DirectContainer {
  value: String;
  new(this.value);
}

final class CustomCollectionIterator implements Iterator<i32> {
  #array: FixedArray<i32>;
  var #index: i32;

  new(arr: FixedArray<i32>) : #array = arr, #index = 0;

  next(): inline (true, i32) | inline (false, _) {
    if (this.#index < this.#array.length) {
      let value = this.#array[this.#index];
      this.#index += 1;
      return (true, value);
    }
    return (false, _);
  }
}

final class CustomCollection with IterableUtils<i32> implements Iterable<i32> {
  #array: FixedArray<i32>;

  new(arr: FixedArray<i32>) : #array = arr;

  :Iterable.iterator(): Iterator<i32> {
    return new CustomCollectionIterator(this.#array);
  }
}

let runForLoopBenchmark = (arr: FixedArray<i32>): i32 => {
  var sum = 0;
  let len = arr.length;
  for (var i = 0; i < len; i += 1) {
    sum = sum + arr[i];
  }
  return sum;
};

let runForInArrayBenchmark = (arr: FixedArray<i32>): i32 => {
  var sum = 0;
  for (let x in arr) {
    sum = sum + x;
  }
  return sum;
};

let runForInCustomBenchmark = (coll: CustomCollection): i32 => {
  var sum = 0;
  for (let x in coll) {
    sum = sum + x;
  }
  return sum;
};

let runDirectAccessBenchmark = (container: DirectContainer, n: i32): i32 => {
  var lenSum = 0;
  for (var i = 0; i < n; i += 1) {
    let s = container.value;
    lenSum = lenSum + s.length;
  }
  return lenSum;
};

let runCastAccessBenchmark = (container: CastContainer, n: i32): i32 => {
  var lenSum = 0;
  for (var i = 0; i < n; i += 1) {
    let s = container.value as String;
    lenSum = lenSum + s.length;
  }
  return lenSum;
};

let runDevirtNoInferBenchmark = (obj: BaseClass, n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = sum + obj.getValue();
  }
  return sum;
};

let runDevirtInferBenchmark = (n: i32): i32 => {
  let obj = new BaseClass();
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = sum + obj.getValue();
  }
  return sum;
};

let runDevirtNoInferOverrideBenchmark = (obj: BaseClassWithOverride, n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = sum + obj.getValue();
  }
  return sum;
};

let runDevirtInferOverrideBenchmark = (n: i32): i32 => {
  let obj = new SubClassWithOverride();
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = sum + obj.getValue();
  }
  return sum;
};

let runStaticCallBenchmark = (obj: FinalClass, n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = sum + obj.getValue();
  }
  return sum;
};

export let main = (): i32 => {
  let args = getArguments();
  var filter = "";
  if (args.length > 1) {
    filter = args[1];
  }

  console.log("==============================================");
  console.log("Running Zena Basic Benchmarks (Wasm GC)...");
  if (filter.length > 0) {
    console.log("Filter: " + filter);
  }
  console.log("==============================================");

  // 1. Recursive Fibonacci (N=35)
  runTest("FibonacciRecursive35", () => {
    let res = fibRecursive(35);
    if (res != 9227465) {
      console.log("Error in fibRecursive(35): " + i32ToString(res));
    }
  }, filter);

  // 2. Recursive Fibonacci (N=40)
  runTest("FibonacciRecursive40", () => {
    let res = fibRecursive(40);
    if (res != 102334155) {
      console.log("Error in fibRecursive(40): " + i32ToString(res));
    }
  }, filter);

  // 3. Iterative Fibonacci (N=10,000,000)
  runTest("FibonacciIterative (N=10,000,000)", () => {
    let res = fibIterative(10000000);
    if (res != 820001) {
      console.log("Error in fibIterative(10,000,000): " + i32ToString(res));
    }
  }, filter);

  // 4. Function Call Benchmarks (N=10,000,000)
  let closure = makeClosure(1);
  runTest("FunctionCallSimple (N=10,000,000)", () => {
    let res = testSimpleCall(10000000);
    if (res != 10000000) {
      console.log("Error in FunctionCallSimple(10,000,000): " + i32ToString(res));
    }
  }, filter);

  runTest("FunctionCallNoInline (N=10,000,000)", () => {
    let res = testNoInlineCall(10000000);
    if (res != 10000000) {
      console.log("Error in FunctionCallNoInline(10,000,000): " + i32ToString(res));
    }
  }, filter);

  runTest("FunctionCallClosure (N=10,000,000)", () => {
    let res = runClosureBenchmark(closure, 10000000);
    if (res != 10000000) {
      console.log("Error in FunctionCallClosure(10,000,000): " + i32ToString(res));
    }
  }, filter);

  // 5. Loop Iteration Benchmarks (N=10,000 x 1,000)
  let arr = new FixedArray<i32>(1000, 1);
  let customColl = new CustomCollection(arr);
  runTest("LoopForLoop (N=10,000,000)", () => {
    var sum = 0;
    for (var i = 0; i < 10000; i += 1) {
      sum = sum + runForLoopBenchmark(arr);
    }
    if (sum != 10000000) {
      console.log("Error in LoopForLoop: " + i32ToString(sum));
    }
  }, filter);

  runTest("LoopForInArray (N=10,000,000)", () => {
    var sum = 0;
    for (var i = 0; i < 10000; i += 1) {
      sum = sum + runForInArrayBenchmark(arr);
    }
    if (sum != 10000000) {
      console.log("Error in LoopForInArray: " + i32ToString(sum));
    }
  }, filter);

  runTest("LoopForInCustom (N=10,000,000)", () => {
    var sum = 0;
    for (var i = 0; i < 10000; i += 1) {
      sum = sum + runForInCustomBenchmark(customColl);
    }
    if (sum != 10000000) {
      console.log("Error in LoopForInCustom: " + i32ToString(sum));
    }
  }, filter);

  // 6. Cast Benchmarks (N=10,000,000)
  let directCont = new DirectContainer("hello");
  let castCont = new CastContainer("hello");
  runTest("CastDirectAccess (N=10,000,000)", () => {
    let res = runDirectAccessBenchmark(directCont, 10000000);
    if (res != 50000000) {
      console.log("Error in CastDirectAccess: " + i32ToString(res));
    }
  }, filter);

  runTest("CastWithCastAccess (N=10,000,000)", () => {
    let res = runCastAccessBenchmark(castCont, 10000000);
    if (res != 50000000) {
      console.log("Error in CastWithCastAccess: " + i32ToString(res));
    }
  }, filter);

  // 7. Devirtualization Benchmarks (N=10,000,000)
  let baseObj = new BaseClass();
  let finalObj = new FinalClass();
  runTest("DevirtNoInferCall (N=10,000,000)", () => {
    let res = runDevirtNoInferBenchmark(baseObj, 10000000);
    if (res != 10000000) {
      console.log("Error in DevirtNoInferCall: " + i32ToString(res));
    }
  }, filter);

  runTest("DevirtInferCall (N=10,000,000)", () => {
    let res = runDevirtInferBenchmark(10000000);
    if (res != 10000000) {
      console.log("Error in DevirtInferCall: " + i32ToString(res));
    }
  }, filter);

  let overrideObj = new SubClassWithOverride();
  runTest("DevirtNoInferOverrideCall (N=10,000,000)", () => {
    let res = runDevirtNoInferOverrideBenchmark(overrideObj, 10000000);
    if (res != 20000000) {
      console.log("Error in DevirtNoInferOverrideCall: " + i32ToString(res));
    }
  }, filter);

  runTest("DevirtInferOverrideCall (N=10,000,000)", () => {
    let res = runDevirtInferOverrideBenchmark(10000000);
    if (res != 20000000) {
      console.log("Error in DevirtInferOverrideCall: " + i32ToString(res));
    }
  }, filter);

  runTest("DevirtStaticCall (N=10,000,000)", () => {
    let res = runStaticCallBenchmark(finalObj, 10000000);
    if (res != 10000000) {
      console.log("Error in DevirtStaticCall: " + i32ToString(res));
    }
  }, filter);

  console.log("----------------------------------------------");
  return 0;
};
