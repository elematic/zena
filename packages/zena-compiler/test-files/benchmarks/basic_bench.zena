  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = sum + obj.value;
  }
  return sum;
};

type Point2D = {x: i32, y: i32};
type Point3D = {x: i32, y: i32, z: i32};

let runRecordFieldAccessNoAdaptBenchmark = (p: Point2D, n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = sum + p.x;
  }
  return sum;
};

let runRecordFieldAccessAdaptBenchmark = (p: Point2D, n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    sum = sum + p.x;
  }
  return sum;
};

let runFieldAssignVirtualBenchmark = (obj: BaseClassWithMutableField, n: i32): void => {
  for (var i = 0; i < n; i += 1) {
    obj.value = i;
  }
};

let runFieldAssignDevirtFinalBenchmark = (obj: FinalClassWithMutableField, n: i32): void => {
  for (var i = 0; i < n; i += 1) {
    obj.value = i;
  }
};

let runFieldAssignDevirtFinalFieldBenchmark = (obj: ClassWithFinalMutableField, n: i32): void => {
  for (var i = 0; i < n; i += 1) {
    obj.value = i;
  }
};

let runFieldAssignDevirtEffectivelyFinalBenchmark = (obj: EffectivelyFinalClassWithMutableField, n: i32): void => {
  for (var i = 0; i < n; i += 1) {
    obj.value = i;
  }
};

sealed class PropertyName {
  case IdentifierName(name: String)
  case SymbolName(symbolRef: BaseClass)
  case FallbackName()
}

let runMatchSingleBenchmark = (obj: BaseClass, n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    let val = match (obj) {
      case SubClassOfBase: 2
      case _: 1
    };
    sum = sum + val;
  }
  return sum;
};

let runIfSingleBenchmark = (obj: BaseClass, n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    let val = if (obj is SubClassOfBase) 2 else 1;
    sum = sum + val;
  }
  return sum;
};

let runMatch3CaseBenchmark = (nameNode: PropertyName, n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    let val = match (nameNode) {
      case IdentifierName {name}: name.length
      case SymbolName {symbolRef}: symbolRef.getValue()
      case _: 0
    };
    sum = sum + val;
  }
  return sum;
};

let runIf3CaseBenchmark = (nameNode: PropertyName, n: i32): i32 => {
  var sum = 0;
  for (var i = 0; i < n; i += 1) {
    let val = if (nameNode is IdentifierName) {
      (nameNode as IdentifierName).name.length
    } else if (nameNode is SymbolName) {
      (nameNode as SymbolName).symbolRef.getValue()
    } else {
      0
    };
    sum = sum + val;
  }
  return sum;
};

export let main = (): i32 => {
  let args = getArguments();
  var filter = "";
  if (args.length > 1) {
    filter = args[1];
  }

  console.log("==============================================");
  console.log("Running Zena Basic Benchmarks (Wasm GC)...");
  if (filter.length > 0) {
    console.log("Filter: " + filter);
  }
  console.log("==============================================");

  // 1. Recursive Fibonacci (N=35)
  runTest("FibonacciRecursive35", () => {
    let res = fibRecursive(35);
    if (res != 9227465) {
      console.log("Error in fibRecursive(35): " + i32ToString(res));
    }
  }, filter);

  // 2. Recursive Fibonacci (N=40)
  runTest("FibonacciRecursive40", () => {
    let res = fibRecursive(40);
    if (res != 102334155) {
      console.log("Error in fibRecursive(40): " + i32ToString(res));
    }
  }, filter);

  // 3. Iterative Fibonacci (N=10,000,000)
  runTest("FibonacciIterative (N=10,000,000)", () => {
    let res = fibIterative(10000000);
    if (res != 820001) {
      console.log("Error in fibIterative(10,000,000): " + i32ToString(res));
    }
  }, filter);

  // 4. Function Call Benchmarks (N=10,000,000)
  let closure = makeClosure(1);
  runTest("FunctionCallSimple (N=10,000,000)", () => {
    let res = testSimpleCall(10000000);
    if (res != 10000000) {
      console.log("Error in FunctionCallSimple(10,000,000): " + i32ToString(res));
    }
  }, filter);

  runTest("FunctionCallNoInline (N=10,000,000)", () => {
    let res = testNoInlineCall(10000000);
    if (res != 10000000) {
      console.log("Error in FunctionCallNoInline(10,000,000): " + i32ToString(res));
    }
  }, filter);

  runTest("FunctionCallClosure (N=10,000,000)", () => {
    let res = runClosureBenchmark(closure, 10000000);
    if (res != 10000000) {
      console.log("Error in FunctionCallClosure(10,000,000): " + i32ToString(res));
    }
  }, filter);

  // 5. Loop Iteration Benchmarks (N=10,000 x 1,000)
  let arr = new FixedArray<i32>(1000, 1);
  let growableArr = new Array<i32>(1000);
  for (var i = 0; i < 1000; i += 1) {
    growableArr.push(1);
  }
  let customColl = new CustomCollection(arr);
  let immutableArr = arr as ImmutableArray<i32>;
  
  runTest("LoopForLoop (N=10,000,000)", () => {
    var sum = 0;
    for (var i = 0; i < 10000; i += 1) {
      sum = sum + runForLoopBenchmark(arr);
    }
    if (sum != 10000000) {
      console.log("Error in LoopForLoop: " + i32ToString(sum));
    }
  }, filter);

  runTest("LoopWhileArray (N=10,000,000)", () => {
    var sum = 0;
    for (var i = 0; i < 10000; i += 1) {
      sum = sum + runWhileArrayBenchmark(arr);
    }
    if (sum != 10000000) {
      console.log("Error in LoopWhileArray: " + i32ToString(sum));
    }
  }, filter);

  runTest("LoopForInArray (N=10,000,000)", () => {
    var sum = 0;
    for (var i = 0; i < 10000; i += 1) {
      sum = sum + runForInArrayBenchmark(arr);
    }
    if (sum != 10000000) {
      console.log("Error in LoopForInArray: " + i32ToString(sum));
    }
  }, filter);

  runTest("LoopForInArrayInterface (N=10,000,000)", () => {
    var sum = 0;
    let iterable: Iterable<i32> = arr;
    for (var i = 0; i < 10000; i += 1) {
      sum = sum + runForInArrayInterfaceBenchmark(iterable);
    }
    if (sum != 10000000) {
      console.log("Error in LoopForInArrayInterface: " + i32ToString(sum));
    }
  }, filter);

  runTest("LoopForInGrowableArray (N=10,000,000)", () => {
    var sum = 0;
    for (var i = 0; i < 10000; i += 1) {
      sum = sum + runForInGrowableArrayBenchmark(growableArr);
    }
    if (sum != 10000000) {
      console.log("Error in LoopForInGrowableArray: " + i32ToString(sum));
    }
  }, filter);

  runTest("LoopForInGrowableArrayInterface (N=10,000,000)", () => {
    var sum = 0;
    let iterable: Iterable<i32> = growableArr;
    for (var i = 0; i < 10000; i += 1) {
      sum = sum + runForInGrowableArrayInterfaceBenchmark(iterable);
    }
    if (sum != 10000000) {
      console.log("Error in LoopForInGrowableArrayInterface: " + i32ToString(sum));
    }
  }, filter);

  runTest("LoopForInImmutableArray (N=10,000,000)", () => {
    var sum = 0;
    for (var i = 0; i < 10000; i += 1) {
      sum = sum + runForInImmutableArrayBenchmark(immutableArr);
    }
    if (sum != 10000000) {
      console.log("Error in LoopForInImmutableArray: " + i32ToString(sum));
    }
  }, filter);

  runTest("LoopForInImmutableArrayInterface (N=10,000,000)", () => {
    var sum = 0;
    let iterable: Iterable<i32> = immutableArr;
    for (var i = 0; i < 10000; i += 1) {
      sum = sum + runForInImmutableArrayInterfaceBenchmark(iterable);
    }
    if (sum != 10000000) {
      console.log("Error in LoopForInImmutableArrayInterface: " + i32ToString(sum));
    }
  }, filter);

  runTest("LoopForInCustom (N=10,000,000)", () => {
    var sum = 0;
    for (var i = 0; i < 10000; i += 1) {
      sum = sum + runForInCustomBenchmark(customColl);
    }
    if (sum != 10000000) {
      console.log("Error in LoopForInCustom: " + i32ToString(sum));
    }
  }, filter);

  // 6. Cast Benchmarks (N=10,000,000)
  let directCont = new DirectContainer("hello");
  let castCont = new CastContainer("hello");
  runTest("CastDirectAccess (N=10,000,000)", () => {
    let res = runDirectAccessBenchmark(directCont, 10000000);
    if (res != 50000000) {
      console.log("Error in CastDirectAccess: " + i32ToString(res));
    }
  }, filter);

  runTest("CastWithCastAccess (N=10,000,000)", () => {
    let res = runCastAccessBenchmark(castCont, 10000000);
    if (res != 50000000) {
      console.log("Error in CastWithCastAccess: " + i32ToString(res));
    }
  }, filter);

  // 7. Devirtualization Benchmarks (N=10,000,000)
  let baseObj = new BaseClass();
  let finalObj = new FinalClass();
  runTest("DevirtNoInferCall (N=10,000,000)", () => {
    let res = runDevirtNoInferBenchmark(baseObj, 10000000);
    if (res != 10000000) {
      console.log("Error in DevirtNoInferCall: " + i32ToString(res));
    }
  }, filter);

  runTest("DevirtInferCall (N=10,000,000)", () => {
    let res = runDevirtInferBenchmark(10000000);
    if (res != 10000000) {
      console.log("Error in DevirtInferCall: " + i32ToString(res));
    }
  }, filter);

  let overrideObj = new SubClassWithOverride();
  runTest("DevirtNoInferOverrideCall (N=10,000,000)", () => {
    let res = runDevirtNoInferOverrideBenchmark(overrideObj, 10000000);
    if (res != 20000000) {
      console.log("Error in DevirtNoInferOverrideCall: " + i32ToString(res));
    }
  }, filter);

  runTest("DevirtInferOverrideCall (N=10,000,000)", () => {
    let res = runDevirtInferOverrideBenchmark(10000000);
    if (res != 20000000) {
      console.log("Error in DevirtInferOverrideCall: " + i32ToString(res));
    }
  }, filter);

  runTest("DevirtStaticCall (N=10,000,000)", () => {
    let res = runStaticCallBenchmark(finalObj, 10000000);
    if (res != 10000000) {
      console.log("Error in DevirtStaticCall: " + i32ToString(res));
    }
  }, filter);

  // 8. Field Access Benchmarks (N=10,000,000)
  let subWithField = new SubClassWithField(1);
  let finalWithField = new FinalClassWithField(1);
  let finalFieldObj = new ClassWithFinalField(1);
  let effFinalWithField = new EffectivelyFinalClassWithField(1);
  let p2d: Point2D = {x: 1, y: 2};
  let p3d: Point3D = {x: 1, y: 2, z: 3};

  runTest("FieldAccessVirtual (N=10,000,000)", () => {
    let res = runFieldAccessVirtualBenchmark(subWithField, 10000000);
    if (res != 10000000) {
      console.log("Error in FieldAccessVirtual: " + i32ToString(res));
    }
  }, filter);

  runTest("FieldAccessDevirtFinal (N=10,000,000)", () => {
    let res = runFieldAccessDevirtFinalBenchmark(finalWithField, 10000000);
    if (res != 10000000) {
      console.log("Error in FieldAccessDevirtFinal: " + i32ToString(res));
    }
  }, filter);

  runTest("FieldAccessDevirtFinalField (N=10,000,000)", () => {
    let res = runFieldAccessDevirtFinalFieldBenchmark(finalFieldObj, 10000000);
    if (res != 10000000) {
      console.log("Error in FieldAccessDevirtFinalField: " + i32ToString(res));
    }
  }, filter);

  runTest("FieldAccessDevirtEffectivelyFinal (N=10,000,000)", () => {
    let res = runFieldAccessDevirtEffectivelyFinalBenchmark(effFinalWithField, 10000000);
    if (res != 10000000) {
      console.log("Error in FieldAccessDevirtEffectivelyFinal: " + i32ToString(res));
    }
  }, filter);

  runTest("FieldAccessRecordNoAdapt (N=10,000,000)", () => {
    let res = runRecordFieldAccessNoAdaptBenchmark(p2d, 10000000);
    if (res != 10000000) {
      console.log("Error in FieldAccessRecordNoAdapt: " + i32ToString(res));
    }
  }, filter);

  runTest("FieldAccessRecordAdapt (N=10,000,000)", () => {
    let res = runRecordFieldAccessAdaptBenchmark(p3d, 10000000);
    if (res != 10000000) {
      console.log("Error in FieldAccessRecordAdapt: " + i32ToString(res));
    }
  }, filter);

  // 9. Field Assignment Benchmarks (N=10,000,000)
  let subWithMutableField = new SubClassWithMutableField(0);
  let finalWithMutableField = new FinalClassWithMutableField(0);
  let finalMutableFieldObj = new ClassWithFinalMutableField(0);
  let effFinalWithMutableField = new EffectivelyFinalClassWithMutableField(0);

  runTest("FieldAssignVirtual (N=10,000,000)", () => {
    runFieldAssignVirtualBenchmark(subWithMutableField, 10000000);
    if (subWithMutableField.value != 9999999) {
      console.log("Error in FieldAssignVirtual: " + i32ToString(subWithMutableField.value));
    }
  }, filter);

  runTest("FieldAssignDevirtFinal (N=10,000,000)", () => {
    runFieldAssignDevirtFinalBenchmark(finalWithMutableField, 10000000);
    if (finalWithMutableField.value != 9999999) {
      console.log("Error in FieldAssignDevirtFinal: " + i32ToString(finalWithMutableField.value));
    }
  }, filter);

  runTest("FieldAssignDevirtFinalField (N=10,000,000)", () => {
    runFieldAssignDevirtFinalFieldBenchmark(finalMutableFieldObj, 10000000);
    if (finalMutableFieldObj.value != 9999999) {
      console.log("Error in FieldAssignDevirtFinalField: " + i32ToString(finalMutableFieldObj.value));
    }
  }, filter);

  runTest("FieldAssignDevirtEffectivelyFinal (N=10,000,000)", () => {
    runFieldAssignDevirtEffectivelyFinalBenchmark(effFinalWithMutableField, 10000000);
    if (effFinalWithMutableField.value != 9999999) {
      console.log("Error in FieldAssignDevirtEffectivelyFinal: " + i32ToString(effFinalWithMutableField.value));
    }
  }, filter);

  // 10. Pattern Matching vs is/else Benchmarks (N=10,000,000)
  let subClassObj = new SubClassOfBase();
  let nameNode: PropertyName = new IdentifierName("abc");
  
  runTest("MatchSingle (N=10,000,000)", () => {
    let res = runMatchSingleBenchmark(subClassObj, 10000000);
    if (res != 20000000) {
      console.log("Error in MatchSingle: " + i32ToString(res));
    }
  }, filter);

  runTest("IfSingle (N=10,000,000)", () => {
    let res = runIfSingleBenchmark(subClassObj, 10000000);
    if (res != 20000000) {
      console.log("Error in IfSingle: " + i32ToString(res));
    }
  }, filter);

  runTest("Match3Case (N=10,000,000)", () => {
    let res = runMatch3CaseBenchmark(nameNode, 10000000);
    if (res != 30000000) {
      console.log("Error in Match3Case: " + i32ToString(res));
    }
  }, filter);

  runTest("If3Case (N=10,000,000)", () => {
    let res = runIf3CaseBenchmark(nameNode, 10000000);
    if (res != 30000000) {
      console.log("Error in If3Case: " + i32ToString(res));
    }
  }, filter);

  console.log("----------------------------------------------");
  return 0;
};
