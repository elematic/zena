import { Future, TaskGroup } from 'zena:async';

let work = async (gate: Future<i32>): Future<i32> => {
  let v = await gate;
  return v * 2;
};

export async function main(): Future<i32> {
  let group = new TaskGroup();
  let f = group.spawn(() => work(Future.of(21)));
  let got = await f;
  group.cancel();
  return got;
}
