// A program every target can build, whose dependencies are not the same
// on each of them. Allocating an array reaches `zena:memory`, which is
// the free-list allocator on `freestanding` and the module that
// delegates to the component's memory on `component` — so the two
// compiles check different source for the same specifier.
//
// `multi-target_test.zena` compiles it on several targets through one
// compiler.
export function main(): i32 {
  let xs = [1, 2, 3, 4];
  var total = 0;
  for (let x in xs) {
    total += x;
  }
  return total;
}
