// `zena:fs` has a manifest entry for `component` and `zena-cli` and
// none for `js` or `freestanding`, so this program builds on the first
// two and does not resolve on the others. `multi-target_test.zena`
// compiles it on both kinds of target through one compiler.
import { exists } from 'zena:fs';

export function main(): i32 {
  return if (exists('zena-packages.json')) { 1 } else { 0 };
}
