// Cache invalidation comment to force clean rebuild - 31
import { getArguments, getEnv, exit, ExitCode } from 'zena:cli';
import { readFile, writeFileBytes, writeFile, exists } from 'zena:fs';
import { CompilerHost } from '../lib/library-loader.zena';
import { PackageConfig, stdlibIdToRelativeFile } from '../lib/module-resolver.zena';
import { loadPackageMap } from '../lib/package-manifest.zena';
import { createCompiler, CompilerOptions, checkCompilation } from '../lib/compiler.zena';
import { DiagnosticSeverity, SourceSpan } from '../lib/diagnostics.zena';
import { BinaryGenerator } from '../lib/codegen/binary-generator.zena';
import { WatGenerator } from '../lib/codegen/wat-generator.zena';
import { Program, CompilationUnit } from '../lib/program.zena';
import { Module, Statement, VariableDeclaration } from '../lib/ast.zena';
import { SemanticModel } from '../lib/semantic-model.zena';
import { performance } from '../lib/time.zena';
import { isKnownTarget, knownTargetsDescription, targetEmitsComponent } from '../lib/targets.zena';
import { compileComponentRuntimeModule } from '../lib/codegen/component-runtime.zena';
import { makeImportEncoder } from '../lib/codegen/wit-imports.zena';

class WasiHost implements CompilerHost {
  testMode: boolean;
  entryPath: String;
  new(this.testMode, this.entryPath);

  readFile(path: String): String {
    var actualPath = path;
    // If it's a zena: package import, map it to the wasi /stdlib dir
    if (path.startsWith("zena:")) {
      actualPath = "/stdlib/" + stdlibIdToRelativeFile(path);
    }
    let content = readFile(actualPath);
    if (this.testMode && path == this.entryPath) {
      if (content.contains("let main") || content.contains("main =") || content.contains("main(")) {
        return content;
      }
      return "import {runAndReport} from 'zena:test';\n" + 
        content + 
        "\nexport let main = (): i32 => {\n  return runAndReport(tests, (s: String): void => {\n    console.log(s);\n  });\n};\n";
    }
    return content;
  }
}

// Load package configs ("zena-compiler:parser" → file path) from the manifest
// in the working directory. A missing manifest is fine — standalone files need
// only stdlib and relative imports — but a malformed one throws loudly.
// (An existence probe instead of try/catch: both compilers currently
// mishandle catch-and-recover shapes here — see BUGS.md "try block"
// entries and tests/language/execution/exceptions/try-tail-assignment.zena.)
let loadPackages = (host: CompilerHost): HashMap<String, PackageConfig> => {
  if (!exists("zena-packages.json")) {
    return new HashMap<String, PackageConfig>();
  }
  return loadPackageMap(host, "zena-packages.json");
};

export let main = (): i32 => {
  let args = getArguments();
  if (args.length < 2) {
    console.error('Usage: zc <filename> [-o <output_path>] [-t <target>] [-g] [--test]');
    exit(1);
  }

  var filename = "";
  var outPath = "zc-out.wasm";
  var target = "zena-cli";
  var testMode = false;
  var time = false;
  // Name section: opt-in. zena-cli's `-g` arrives as an env var
  // (the checked-in bootstrap predates the flag and would read an
  // unknown `-g` as the input filename); `-g` here serves direct
  // invocations of the compiler.
  var debugNames = getEnv("ZENA_DEBUG_NAMES") != null;
  // Unnecessary-cast warnings: opt-in via env var, like -g, so the
  // checked-in bootstrap never needs to know the flag exists.
  let warnUnnecessaryCasts = getEnv("ZENA_WARN_UNNECESSARY_CASTS") != null;
  for (var i = 1; i < args.length; i += 1) {
    if (args[i] == "-o" && i + 1 < args.length) {
      outPath = args[i + 1];
      i += 1;
    } else if (args[i] == "--test") {
      testMode = true;
    } else if ((args[i] == "-t" || args[i] == "--target") && i + 1 < args.length) {
      target = args[i + 1];
      i += 1;
    } else if (args[i] == "--time") {
      time = true;
    } else if (args[i] == "-g" || args[i] == "--debug") {
      debugNames = true;
    } else {
      filename = args[i];
    }
  }

  if (filename == "") {
    console.error("Error: no input file specified");
    exit(1);
  }

  if (!isKnownTarget(target)) {
    console.error("Error: invalid target '" + target + "' (expected " +
        knownTargetsDescription() + ")");
    exit(1);
  }

  let host = new WasiHost(testMode, filename);
  let packages = loadPackages(host);
  let options = new CompilerOptions(target, "/stdlib", packages);
  options.time = time;
  let compiler = createCompiler(host, options);

  console.log("Compiling " + filename + "...");
  try {
    let compResult = compiler.compile(filename);

    let checkResults = checkCompilation(compResult, null, false, warnUnnecessaryCasts);
    let diagnostics = checkResults.diagnostics;
    var hasError = false;
    for (let diag in diagnostics) {
      if (diag.severity == DiagnosticSeverity.Error) {
        if (diag.location != null) {
          let loc = diag.location as SourceSpan;
          console.error(loc.file + ":" + i32ToString(loc.line) + ":" + i32ToString(loc.column) + " - Error: " + diag.message);
        } else {
          console.error("Error: " + diag.message);
        }
        hasError = true;
      } else if (warnUnnecessaryCasts && diag.severity == DiagnosticSeverity.Warning) {
        if (diag.location != null) {
          let loc = diag.location as SourceSpan;
          console.error(loc.file + ":" + i32ToString(loc.line) + ":" + i32ToString(loc.column) + " - Warning: " + diag.message);
        } else {
          console.error("Warning: " + diag.message);
        }
      }
    }
    
    if (hasError) {
      exit(1);
    }
    
    checkResults.results[filename].model;
    let entryAst = compResult.entry.ast;
    let units = new Array<CompilationUnit>();
    var entryUnit: CompilationUnit | null = null;
    for (let file in compResult.files) {
      let res = checkResults.results[file.path];
      if (res != null) {
        let unit = {ast: file.ast, model: res.model};
        units.push(unit);
        if (file.ast.path == entryAst.path) {
          entryUnit = unit;
        }
      }
    }
    let tCodegen = performance.start("codegen");
    let program = new Program(units, entryUnit);
    
    // Every compile goes AST -> ZIR -> wasm; a lowering bail is a
    // fatal error. ZENA_ZIR_STATS=1 prints the lowered count.
    let zirStats = getEnv("ZENA_ZIR_STATS") != null;

    // `-o out.wat` emits the WAT text directly — the readable form of
    // exactly what the binary build would contain, for inspecting a
    // program's emitted shape (`zena build hello.zena -o hello.wat`).
    if (outPath.endsWith(".wat")) {
      let watOnly = new WatGenerator(target, zirStats);
      writeFile(outPath, watOnly.generate(program));
      performance.end(tCodegen);
      console.log("Success: wrote " + outPath);
      return 0;
    }

    let generator = new BinaryGenerator(target, zirStats, debugNames);
    if (targetEmitsComponent(target)) {
      // The component's second core module, owning linear memory and
      // the allocator. Compiled up front — whether the program needs it
      // is only known after its own compile, and this one is small.
      generator.runtimeMemoryModule =
          compileComponentRuntimeModule(host, "/stdlib", packages);
      generator.importEncoder = makeImportEncoder();
    }
    let wasmBytes = generator.generate(program).toByteArray();
    writeFileBytes(outPath, wasmBytes);

    // The WAT dump runs a SECOND full generator pass and its text
    // dwarfs the binary (~30x — the tests module's dump is ~135 MB),
    // so it is opt-in for debugging.
    if (getEnv("ZENA_EMIT_WAT") != null) {
      let watGenerator = new WatGenerator(target, false);
      let watString = watGenerator.generate(program);
      writeFile(outPath + ".wat", watString);
    }
    performance.end(tCodegen);
    
    console.log("Success: wrote " + outPath);

    if (time) {
      let loadTime = compiler.loadTime;
      let parseTime = compiler.parseTime;
      let scopeTime = performance.getDuration("scope");
      let checkTime = performance.getDuration("check");
      let codegenTime = performance.getDuration("codegen");
      let discoveryTime = performance.getDuration("codegen-discovery");
      let discoveryInitTime = performance.getDuration("codegen-discovery-init");
      let discoveryQueuesTime = performance.getDuration("codegen-discovery-queues");
      let discoveryLayoutTime = performance.getDuration("codegen-discovery-layout");
      let layoutTime = performance.getDuration("codegen-layout");
      let emitCodeTime = performance.getDuration("codegen-emit-code");
      let emitOtherTime = performance.getDuration("codegen-emit-other");
      let totalTime = loadTime + parseTime + scopeTime + checkTime + codegenTime;

      console.log("");
      console.log("=== Compiler Timing Report ===");
      console.log("File Load:  " + f64ToString(loadTime) + " ms");
      console.log("Pure Parse: " + f64ToString(parseTime) + " ms");
      console.log("Scope:      " + f64ToString(scopeTime) + " ms");
      console.log("Check:      " + f64ToString(checkTime) + " ms");
      console.log("Codegen:    " + f64ToString(codegenTime) + " ms");
      console.log("  Discovery:  " + f64ToString(discoveryTime) + " ms");
      console.log("    Discovery Init:   " + f64ToString(discoveryInitTime) + " ms");
      console.log("    Discovery Queues: " + f64ToString(discoveryQueuesTime) + " ms");
      console.log("    Discovery Layout: " + f64ToString(discoveryLayoutTime) + " ms");
      console.log("  Layout:     " + f64ToString(layoutTime) + " ms");
      console.log("  Emit Code:  " + f64ToString(emitCodeTime) + " ms");
      console.log("  Emit Other: " + f64ToString(emitOtherTime) + " ms");
      console.log("------------------------------");
      console.log("Total:      " + f64ToString(totalTime) + " ms");
      console.log("==============================");
    }
  } catch (e) {
    console.log("Exception caught in CLI compiler!");
    if (e is Error) {
      console.log("Error message: " + e.message);
      let stack = e.getStackTrace();
      if (stack != null) {
        console.log("Stack Trace: \n" + stack);
      }
    }
    throw e;
  }

  return 0;
};
