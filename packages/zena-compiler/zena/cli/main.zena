// The compiler's own command line, `zc`: reads the flags and hands them to
// `compileFile`, which does the work. The `zena` command line calls
// `compileFile` directly.
import { getArguments, getEnv, exit } from 'zena:cli';
import { CompileFileOptions, compileFile } from '../lib/compile-file.zena';

/**
 * "-O" levels: 0, 1, 2, and s (size — the loop with budgets down,
 * currently equal to 2). Returns -1 on anything else.
 */
let parseOptLevel = (text: String): i32 => {
  if (text == "0") { return 0; }
  if (text == "1") { return 1; }
  if (text == "2") { return 2; }
  if (text == "s") { return 2; }
  return -1;
};

export let main = (): i32 => {
  let args = getArguments();
  if (args.length < 2) {
    console.error('Usage: zc <filename> [-o <output_path>] [-t <target>] [-g] [--test]');
    exit(1);
  }

  var filename = "";
  var outPath = "zc-out.wasm";
  var target = "zena-cli";
  var testMode = false;
  var time = false;
  var witPath = "";
  var worldName = "";
  // Name section: opt-in. zena-cli's `-g` arrives as an env var
  // (the checked-in bootstrap predates the flag and would read an
  // unknown `-g` as the input filename); `-g` here serves direct
  // invocations of the compiler.
  var debugNames = getEnv("ZENA_DEBUG_NAMES") != null;
  // Unnecessary-cast warnings: opt-in via env var, like -g, so the
  // checked-in bootstrap never needs to know the flag exists.
  let warnUnnecessaryCasts = getEnv("ZENA_WARN_UNNECESSARY_CASTS") != null;
  // Optimization level (docs/design/optimization-pipeline.md): env
  // var for the same bootstrap reason, `-O<n>` for direct invocation.
  var optLevel = 1;
  let optEnv = getEnv("ZENA_OPT_LEVEL");
  if (optEnv != null) {
    let parsed = parseOptLevel(optEnv);
    if (parsed < 0) {
      console.error("Error: invalid ZENA_OPT_LEVEL '" + (optEnv as String) +
          "' (expected 0, 1, 2, or s)");
      exit(1);
    }
    optLevel = parsed;
  }
  for (var i = 1; i < args.length; i += 1) {
    if (args[i] == "-o" && i + 1 < args.length) {
      outPath = args[i + 1];
      i += 1;
    } else if (args[i] == "--test") {
      testMode = true;
    } else if ((args[i] == "-t" || args[i] == "--target") && i + 1 < args.length) {
      target = args[i + 1];
      i += 1;
    } else if (args[i] == "--time") {
      time = true;
    } else if (args[i] == "--wit" && i + 1 < args.length) {
      witPath = args[i + 1];
      i += 1;
    } else if (args[i] == "--world" && i + 1 < args.length) {
      worldName = args[i + 1];
      i += 1;
    } else if (args[i] == "-g" || args[i] == "--debug") {
      debugNames = true;
    } else if (args[i].startsWith("-O")) {
      let parsed = parseOptLevel(args[i].sliceBytes(2, args[i].length));
      if (parsed < 0) {
        console.error("Error: invalid optimization level '" + args[i] +
            "' (expected -O0, -O1, -O2, or -Os)");
        exit(1);
      }
      optLevel = parsed;
    } else {
      filename = args[i];
    }
  }

  if (filename == "") {
    console.error("Error: no input file specified");
    exit(1);
  }

  let options = new CompileFileOptions(filename, outPath);
  options.target = target;
  options.testMode = testMode;
  options.time = time;
  options.witPath = witPath;
  options.worldName = worldName;
  options.debugNames = debugNames;
  options.warnUnnecessaryCasts = warnUnnecessaryCasts;
  options.optLevel = optLevel;
  options.progress = true;
  let status = compileFile(options);
  if (status != 0) {
    exit(status);
  }
  return 0;
};
