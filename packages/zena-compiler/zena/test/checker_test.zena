/**
 * Checker API tests — validates the programmatic API surface of the checker.
 *
 * These tests verify that:
 * 1. checkModule() can be called and returns a CheckResult
 * 2. The SemanticModel contains expected type information
 * 3. Diagnostics are collected for invalid code
 * 4. The checker integrates with scope analysis correctly
 *
 * Behavioral correctness (does the checker accept/reject the right code?) is
 * tested via portable tests in tests/language/semantics/. This file focuses on
 * the API contract.
 */

import { suite, test, TestContext } from 'zena:test';
import { equal, isTrue } from 'zena:assert';
import { parse } from '../lib/parser.zena';
import { Symbol, noSymbolId } from '../lib/scope/symbol.zena';
import { ScopeBuilder } from '../lib/scope/scope-builder.zena';
import { checkModule, CheckResult, SharedCheckerState } from '../lib/checker.zena';
import { SemanticModel } from '../lib/semantic-model.zena';
import { Diagnostic, DiagnosticSeverity } from '../lib/diagnostics.zena';
import {
  Type, I32Type, BooleanType, VoidType, TypeParameterType, FieldInfo, MethodInfo, BoolLiteralType, ClassType, InterfaceType, FunctionType, UnionType, InlineTupleType, HoleType, typeToString, TypeId,
} from '../lib/types.zena';
import { WellKnown } from '../lib/well-known.zena';
import { VariableDeclaration, Identifier, Node } from '../lib/ast.zena';
import { growable } from 'zena:core';

// ============================================================================
// Helpers
// ============================================================================

// TODO: In the future, instead of manually mocking types here, we should
// parse and check exactly the stdlib modules needed once, and share those
// AST/Types across test runs.
function createTestSharedState() {
  let sharedState = new SharedCheckerState();
  let stringClass = new ClassType(9000 as TypeId, noSymbolId, "String");
  stringClass.members["length"] = new FieldInfo(new I32Type() as Type, false, false, false, false, false);
  sharedState.preludeTypes["String"] = stringClass as Type;
  
  let fixedArrayClass = new ClassType(9001 as TypeId, noSymbolId, "FixedArray");
  let faT = new TypeParameterType("T", null, null);
  let faTArr = growable<TypeParameterType>([faT]);
  fixedArrayClass.typeParameters = faTArr;
  fixedArrayClass.members["length"] = new FieldInfo(new I32Type() as Type, false, false, false, false, false);
  let faPushParams = growable<Type>([faT as Type]);
  fixedArrayClass.members["push"] = new MethodInfo(new FunctionType(faPushParams, new VoidType() as Type), false, false, false, false);
  sharedState.preludeTypes["FixedArray"] = fixedArrayClass as Type;

  // Array literals type as ImmutableArray unless the context wants
  // mutable elements, so member lookup on a literal resolves here.
  let immutableArrayClass = new ClassType(9002 as TypeId, noSymbolId, "ImmutableArray");
  let iaT = new TypeParameterType("T", null, null);
  let iaTArr = growable<TypeParameterType>([iaT]);
  immutableArrayClass.typeParameters = iaTArr;
  immutableArrayClass.members["length"] = new FieldInfo(new I32Type() as Type, false, false, false, false, false);
  sharedState.preludeTypes["ImmutableArray"] = immutableArrayClass as Type;

  let growableArrayClass = new ClassType(9003 as TypeId, noSymbolId, "GrowableArray");
  let arrT = new TypeParameterType("T", null, null);
  let arrTArr = growable<TypeParameterType>([arrT]);
  growableArrayClass.typeParameters = arrTArr;
  growableArrayClass.members["length"] = new FieldInfo(new I32Type() as Type, false, false, false, false, false);
  let arrPushParams = growable<Type>([arrT as Type]);
  growableArrayClass.members["push"] = new MethodInfo(new FunctionType(arrPushParams, new VoidType() as Type), false, false, false, false);
  sharedState.preludeTypes["GrowableArray"] = growableArrayClass as Type;
  sharedState.preludeTypes["Array"] = growableArrayClass as Type;

  let mapClass = new ClassType(9005 as TypeId, noSymbolId, "HashMap");
  let mapK = new TypeParameterType("K", null, null);
  let mapV = new TypeParameterType("V", null, null);
  let mapTArr = growable<TypeParameterType>([mapK, mapV]);
  mapClass.typeParameters = mapTArr;
  let getParams = growable<Type>([mapK as Type]);
  // Mirror the stdlib signature: inline (true, V) | inline (false, _).
  let hitElems = growable<Type>([
    new BoolLiteralType(true) as Type,
    mapV as Type,
  ]);
  let missElems = growable<Type>([
    new BoolLiteralType(false) as Type,
    new HoleType() as Type,
  ]);
  let getReturnArms = growable<Type>([
    new InlineTupleType(hitElems) as Type,
    new InlineTupleType(missElems) as Type,
  ]);
  mapClass.members["get"] = new MethodInfo(new FunctionType(getParams, new UnionType(getReturnArms) as Type), false, false, false, false);
  let hasParams = growable<Type>([mapK as Type]);
  mapClass.members["has"] = new MethodInfo(new FunctionType(hasParams, new BooleanType() as Type), false, false, false, false);
  let setParams = growable<Type>([mapK as Type, mapV as Type]);
  mapClass.members["[]="] = new MethodInfo(new FunctionType(setParams, new VoidType() as Type), false, false, false, false);
  let idxParams = growable<Type>([mapK as Type]);
  mapClass.members["[]"] = new MethodInfo(new FunctionType(idxParams, mapV as Type), false, false, false, false);
  sharedState.preludeTypes["HashMap"] = mapClass as Type;

  let futureClass = new ClassType(9007 as TypeId, noSymbolId, "Future");
  let futureT = new TypeParameterType("T", null, null);
  let futureTArr = growable<TypeParameterType>([futureT]);
  futureClass.typeParameters = futureTArr;
  sharedState.preludeTypes["Future"] = futureClass as Type;

  let iterT = new TypeParameterType("T", null, null);
  let iterTArr = growable<TypeParameterType>([iterT]);

  let iteratorIface = new InterfaceType(9008 as TypeId, noSymbolId, "Iterator");
  iteratorIface.typeParameters = iterTArr;
  sharedState.preludeTypes["Iterator"] = iteratorIface as Type;

  let iterableIface = new InterfaceType(9009 as TypeId, noSymbolId, "Iterable");
  iterableIface.typeParameters = iterTArr;
  sharedState.preludeTypes["Iterable"] = iterableIface as Type;

  let resourceClass = new ClassType(9010 as TypeId, noSymbolId, "Resource");
  resourceClass.isAbstract = true;
  resourceClass.isResource = true;
  sharedState.preludeTypes["Resource"] = resourceClass as Type;

  let hashableIface = new InterfaceType(9011 as TypeId, noSymbolId, "Hashable");
  let hashMethodType = new FunctionType(new Array<Type>(), new I32Type());
  hashableIface.members["hashCode"] = new MethodInfo(hashMethodType, false, false, false, false);
  sharedState.preludeTypes["Hashable"] = hashableIface as Type;

  // The checker asks for well-known declarations by registry variant, not by
  // name, so a mock standard library has to say which slot each stand-in
  // fills. In a real compilation this comes from the library a declaration
  // is declared in; these types are built here and belong to no module.
  let known = (w: WellKnown, t: Type) => {
    sharedState.wellKnownTypes[w as i32] = t;
  };
  known(WellKnown.StringClass, stringClass as Type);
  known(WellKnown.FixedArrayClass, fixedArrayClass as Type);
  known(WellKnown.ImmutableArrayClass, immutableArrayClass as Type);
  known(WellKnown.GrowableArrayClass, growableArrayClass as Type);
  known(WellKnown.ArrayInterface, growableArrayClass as Type);
  known(WellKnown.FutureClass, futureClass as Type);
  known(WellKnown.IteratorInterface, iteratorIface as Type);
  known(WellKnown.IterableInterface, iterableIface as Type);
  known(WellKnown.ResourceClass, resourceClass as Type);
  known(WellKnown.HashableInterface, hashableIface as Type);

  return sharedState;
}

/**
 * Parse, scope-analyse, and type-check a source string.
 */
function check(source: String) {
  let ast = parse(source, "<test>");
  let scopeBuilder = new ScopeBuilder("<test>");
  let scopeResult = scopeBuilder.build(ast);
  return checkModule(ast, scopeResult, null, null, false, createTestSharedState());
}

/**
 * Assert that checking produces no errors.
 */
function checkOk(source: String) {
  let result = check(source);
  let errors = errorDiagnostics(result.diagnostics);
  if (errors.length > 0) {
    var msg = "Expected no errors, got:\n";
    var i = 0;
    while (i < errors.length) {
      msg = `${msg}  - ${errors[i].message}\n`;
      i += 1;
    }
    throw new Error(msg);
  }
  return result;
}

/**
 * Assert that checking produces at least one error matching the pattern.
 */
function checkError(source: String, pattern: String) {
  let result = check(source);
  let errors = errorDiagnostics(result.diagnostics);
  var found = false;
  var i = 0;
  while (i < errors.length) {
    if (contains(errors[i].message, pattern)) {
      found = true;
      break;
    }
    i += 1;
  }
  if (!found) {
    var msg = `Expected error containing '${pattern}', got:\n`;
    if (errors.length == 0) {
      msg = msg + "  (none)\n";
    } else {
      var j = 0;
      while (j < errors.length) {
        msg = `${msg}  - ${errors[j].message}\n`;
        j += 1;
      }
    }
    throw new Error(msg);
  }
}

/**
 * Filter diagnostics to only error severity.
 */
function errorDiagnostics(diags: Array<Diagnostic>): Array<Diagnostic> {
  let errors = new Array<Diagnostic>(4);
  var i = 0;
  while (i < diags.length) {
    if (diags[i].severity == DiagnosticSeverity.Error) {
      errors.push(diags[i]);
    }
    i += 1;
  }
  return errors;
}

/**
 * Substring check (no builtins yet).
 */
function contains(s: String, sub: String): boolean {
  if (sub.length > s.length) { return false; }
  var i = 0;
  while (i <= s.length - sub.length) {
    if (s.sliceBytes(i, i + sub.length) == sub) {
      return true;
    }
    i += 1;
  }
  return false;
}

// ============================================================================
// Tests
// ============================================================================

export let tests = suite('Checker API', () => {

  // ==========================================================================
  // Basic API surface
  // ==========================================================================

  suite('checkModule returns a CheckResult', () => {

    test('valid source produces CheckResult with no errors', (ctx) => {
      let result = checkOk("let _x = 42;");
      // CheckResult has a model and diagnostics
      isTrue(errorDiagnostics(result.diagnostics).length == 0);
    });

    test('invalid source produces diagnostics', (ctx) => {
      let result = check("let x: i32 = true;");
      let errors = errorDiagnostics(result.diagnostics);
      isTrue(errors.length > 0);
    });

    test('multiple statements checked', (ctx) => {
      let result = checkOk(
        "let x = 1;\nlet y = 2;\nlet z = x;"
      );
      isTrue(errorDiagnostics(result.diagnostics).length == 0);
    });
  });

  // ==========================================================================
  // SemanticModel: node types
  // ==========================================================================

  suite('SemanticModel records node types', () => {

    test('integer literal has i32 type', (ctx) => {
      let source = "let _x = 42;";
      let ast = parse(source, "<test>");
      let scopeBuilder = new ScopeBuilder("<test>");
      let scopeResult = scopeBuilder.build(ast);
      let result = checkModule(ast, scopeResult, null, null, false, createTestSharedState());

      // Navigate AST: body[0] is VariableDeclaration, its init is NumberLiteral
      let decl = ast.body[0] as VariableDeclaration;
      let initType = result.model.getNodeType(decl.init);
      isTrue(initType != null);
      equal(typeToString(initType as Type), "i32");
    });

    test('string literal has String type', (ctx) => {
      let source = "let _x = 'hello';";
      let ast = parse(source, "<test>");
      let scopeBuilder = new ScopeBuilder("<test>");
      let scopeResult = scopeBuilder.build(ast);
      let result = checkModule(ast, scopeResult, null, null, false, createTestSharedState());

      let decl = ast.body[0] as VariableDeclaration;
      let initType = result.model.getNodeType(decl.init);
      isTrue(initType != null);
      equal(typeToString(initType as Type), "String");
    });

    test('boolean literal has literal type', (ctx) => {
      let source = "let _x = true;";
      let ast = parse(source, "<test>");
      let scopeBuilder = new ScopeBuilder("<test>");
      let scopeResult = scopeBuilder.build(ast);
      let result = checkModule(ast, scopeResult, null, null, false, createTestSharedState());

      let decl = ast.body[0] as VariableDeclaration;
      let initType = result.model.getNodeType(decl.init);
      isTrue(initType != null);
      equal(typeToString(initType as Type), "true");
    });

    test('binary expression has inferred type', (ctx) => {
      let source = "let _x = 1 + 2;";
      let ast = parse(source, "<test>");
      let scopeBuilder = new ScopeBuilder("<test>");
      let scopeResult = scopeBuilder.build(ast);
      let result = checkModule(ast, scopeResult, null, null, false, createTestSharedState());

      let decl = ast.body[0] as VariableDeclaration;
      let initType = result.model.getNodeType(decl.init);
      isTrue(initType != null);
      equal(typeToString(initType as Type), "i32");
    });

    test('function expression has function type', (ctx) => {
      let source = "let f = (x: i32): i32 => x;";
      let ast = parse(source, "<test>");
      let scopeBuilder = new ScopeBuilder("<test>");
      let scopeResult = scopeBuilder.build(ast);
      let result = checkModule(ast, scopeResult, null, null, false, createTestSharedState());

      let decl = ast.body[0] as VariableDeclaration;
      let initType = result.model.getNodeType(decl.init);
      isTrue(initType != null);
      let typeStr = typeToString(initType as Type);
      // Should be something like "(x: i32) => i32"
      isTrue(contains(typeStr, "i32"));
    });
  });

  // ==========================================================================
  // SemanticModel: binding types
  // ==========================================================================

  suite('SemanticModel records binding types', () => {

    test('let binding has correct type via scope lookup', (ctx) => {
      let source = "let _x = 42;";
      let ast = parse(source, "<test>");
      let scopeBuilder = new ScopeBuilder("<test>");
      let scopeResult = scopeBuilder.build(ast);
      let result = checkModule(ast, scopeResult, null, null, false, createTestSharedState());

      // Look up x in scope, then get its binding type
      let info = scopeResult.rootScope.resolve("_x");
      isTrue(info != null);
      let bindingType = result.model.getBindingType(info as Symbol);
      isTrue(bindingType != null);
      equal(typeToString(bindingType as Type), "i32");
    });

    test('annotated binding has annotation type', (ctx) => {
      let source = "let _x: i32 = 42;";
      let ast = parse(source, "<test>");
      let scopeBuilder = new ScopeBuilder("<test>");
      let scopeResult = scopeBuilder.build(ast);
      let result = checkModule(ast, scopeResult, null, null, false, createTestSharedState());

      let info = scopeResult.rootScope.resolve("_x");
      isTrue(info != null);
      let bindingType = result.model.getBindingType(info as Symbol);
      isTrue(bindingType != null);
      equal(typeToString(bindingType as Type), "i32");
    });

    test('var binding widens literal type', (ctx) => {
      let source = "var _x = true;";
      let ast = parse(source, "<test>");
      let scopeBuilder = new ScopeBuilder("<test>");
      let scopeResult = scopeBuilder.build(ast);
      let result = checkModule(ast, scopeResult, null, null, false, createTestSharedState());

      let info = scopeResult.rootScope.resolve("_x");
      isTrue(info != null);
      let bindingType = result.model.getBindingType(info as Symbol);
      isTrue(bindingType != null);
      // var should widen true → boolean
      equal(typeToString(bindingType as Type), "boolean");
    });
  });

  // ==========================================================================
  // Diagnostics
  // ==========================================================================

  suite('diagnostics', () => {

    test('type mismatch produces error', (ctx) => {
      checkError("let x: i32 = true;", "Type mismatch");
    });

    test('undeclared variable produces error', (ctx) => {
      checkError("let x = y;", "not found");
    });

    test('error has location info', (ctx) => {
      let result = check("let x: i32 = true;");
      let errors = errorDiagnostics(result.diagnostics);
      isTrue(errors.length > 0);
      isTrue(errors[0].location != null);
    });

    test('multiple errors collected', (ctx) => {
      let result = check("let x: i32 = true;\nlet y: String = 42;");
      let errors = errorDiagnostics(result.diagnostics);
      isTrue(errors.length >= 2);
    });

    test('valid code produces zero errors', (ctx) => {
      let result = check("let x = 1;\nlet y = x + 2;");
      let errors = errorDiagnostics(result.diagnostics);
      equal(errors.length, 0);
    });
  });

  // ==========================================================================
  // Class declarations
  // ==========================================================================

  suite('class type creation', () => {

    test('class creates a ClassType', (ctx) => {
      let source = "class Point {\n  x: i32;\n  y: i32;\n  new(this.x, this.y);\n}";
      let ast = parse(source, "<test>");
      let scopeBuilder = new ScopeBuilder("<test>");
      let scopeResult = scopeBuilder.build(ast);
      let result = checkModule(ast, scopeResult, null, null, false, createTestSharedState());

      let errors = errorDiagnostics(result.diagnostics);
      equal(errors.length, 0);

      // Point should be resolvable as a type
      let info = scopeResult.rootScope.resolve("Point");
      isTrue(info != null);
    });

    test('class instantiation works', (ctx) => {
      let result = checkOk(
        "class Point {\n  x: i32;\n  y: i32;\n  new(this.x, this.y);\n}\nlet p = new Point(1, 2);"
      );
      isTrue(errorDiagnostics(result.diagnostics).length == 0);
    });

    test('sealed class with variants', (ctx) => {
      let result = checkOk(
        "sealed class Shape {\n  case Circle(radius: f64)\n  case Rect(width: f64, height: f64)\n}"
      );
      isTrue(errorDiagnostics(result.diagnostics).length == 0);
    });

    test('case class creates type', (ctx) => {
      let result = checkOk(
        "class Pair(first: i32, second: String)"
      );
      isTrue(errorDiagnostics(result.diagnostics).length == 0);
    });
  });

  // ==========================================================================
  // Integration: scope + checker pipeline
  // ==========================================================================

  suite('scope integration', () => {

    test('identifier resolves through scope', (ctx) => {
      let result = checkOk("let x = 1;\nlet y = x;");
      isTrue(errorDiagnostics(result.diagnostics).length == 0);
    });

    test('function parameter types resolve', (ctx) => {
      let result = checkOk(
        "let add = (a: i32, b: i32): i32 => a + b;\nlet r = add(1, 2);"
      );
      isTrue(errorDiagnostics(result.diagnostics).length == 0);
    });

    test('class members resolve from scope', (ctx) => {
      let result = checkOk(
        "class Foo {\n  value: i32;\n  new(this.value);\n  getValue(): i32 { return this.value; }\n}\nlet f = new Foo(42);\nlet v = f.getValue();"
      );
      isTrue(errorDiagnostics(result.diagnostics).length == 0);
    });

    test('block scope isolates variables', (ctx) => {
      // The inner x should not conflict with the outer x
      let result = checkOk(
        "let f = (): void => {\n  let x = 1;\n  {\n    let x = 2;\n  }\n};"
      );
      isTrue(errorDiagnostics(result.diagnostics).length == 0);
    });

    test('block type alias shadows outer materialized type', (ctx) => {
      // Ensure outer Point gets materialized first, then shadow it with a
      // block-local type alias and use that alias in an annotation.
      let result = checkOk(
        "class Point {\n  x: i32;\n  new(this.x);\n}\nlet p: Point = new Point(1);\nlet f = (): i32 => {\n  type Point = i32;\n  let x: Point = 1;\n  return x;\n};\nlet y = f();"
      );
      isTrue(errorDiagnostics(result.diagnostics).length == 0);
    });
  });

  // ==========================================================================
  // Type checking: patterns and match
  // ==========================================================================

  suite('pattern matching', () => {

    test('exhaustive match on sealed class passes', (ctx) => {
      let result = checkOk(
        "sealed class Shape {\n  case Circle(radius: f64)\n  case Rect(w: f64, h: f64)\n}\nlet describe = (s: Shape): String => match (s) {\n  case Circle {}: 'circle'\n  case Rect {}: 'rect'\n};"
      );
      isTrue(errorDiagnostics(result.diagnostics).length == 0);
    });

    test('non-exhaustive match produces error', (ctx) => {
      checkError(
        "sealed class Shape {\n  case Circle(radius: f64)\n  case Rect(w: f64, h: f64)\n}\nlet describe = (s: Shape): String => match (s) {\n  case Circle {}: 'circle'\n};",
        "Non-exhaustive"
      );
    });
  });

  // ==========================================================================
  // Private fields
  // ==========================================================================

  suite('private fields', () => {

    test('private field read in own class', (ctx) => {
      checkOk(
        "class Counter {\n  #count: i32 = 0;\n  getCount(): i32 { return this.#count; }\n}"
      );
    });

    test('private field write in own class', (ctx) => {
      checkOk(
        "class Counter {\n  var #count: i32 = 0;\n  increment(): void { this.#count += 1; }\n}"
      );
    });

    test('private field outside class is error', (ctx) => {
      checkError(
        "class Foo {\n  #secret: i32 = 0;\n}\nlet f = new Foo();\nlet x = f.#secret;",
        "Private field"
      );
    });

    test('private method in own class', (ctx) => {
      checkOk(
        "class Builder {\n  #helper(): i32 { return 42; }\n  build(): i32 { return this.#helper(); }\n}"
      );
    });

    test('private field with initializer expression', (ctx) => {
      // Scope.zena pattern: #values = new Map<String, Symbol>()
      checkOk(
        "class Container {\n  #items: FixedArray<i32> = [1, 2, 3];\n  count(): i32 { return this.#items.length; }\n}"
      );
    });

    test('private field member access chain', (ctx) => {
      // Pattern: this.#values.has(name)
      checkOk(
        "class Wrapper {\n  #text: String = 'hello';\n  len(): i32 { return this.#text.length; }\n}"
      );
    });

    test('forward reference to private method', (ctx) => {
      // build() calls #helper() which is defined later in the class body
      checkOk(
        "class Builder {\n  build(): i32 { return this.#process(); }\n  #process(): i32 { return 42; }\n}"
      );
    });

    test('cross-class forward reference', (ctx) => {
      // Class A's method calls class B's method — B is declared AFTER A.
      // The two-phase checker registers all member signatures before checking bodies.
      checkOk(
        "class A {\n  getValue(): i32 {\n    let b = new B(42);\n    return b.getDouble();\n  }\n}\nclass B {\n  value: i32;\n  new(this.value);\n  getDouble(): i32 { return this.value * 2; }\n}"
      );
    });
  });

  // ==========================================================================
  // Generic type members
  // ==========================================================================

  suite('generic type members', () => {

    test('array literal length', (ctx) => {
      checkOk(
        "let arr = [1, 2, 3];\nlet n: i32 = arr.length;"
      );
    });

    test('array push method', (ctx) => {
      checkOk(
        "let arr = new GrowableArray<i32>();\nlet f = (): void => {\n  arr.push(42);\n};"
      );
    });
  });

  // ==========================================================================
  // Null comparison operators
  // ==========================================================================

  suite('null comparison', () => {

    test('nullable field compared to null with !=', (ctx) => {
      checkOk(
        "class Foo {\n  x: String | null;\n  new(this.x);\n}\nlet f = new Foo(null);\nlet b = f.x != null;"
      );
    });

    test('nullable field compared to null with ==', (ctx) => {
      checkOk(
        "class Foo {\n  x: String | null;\n  new(this.x);\n}\nlet f = new Foo(null);\nlet b = f.x == null;"
      );
    });

    test('nullable class type compared to null', (ctx) => {
      checkOk(
        "class Point { x: f64; new(this.x); }\nlet p: Point | null = null;\nlet b = p != null;"
      );
    });

    test('class field compared to null', (ctx) => {
      checkOk(
        "class Loc { line: i32; new(this.line); }\nclass Foo {\n  loc: Loc | null;\n  new(this.loc);\n}\nlet f = new Foo(null);\nlet b = f.loc != null;"
      );
    });
  });

  // ==========================================================================
  // HashMap member access
  // ==========================================================================

  suite('HashMap members', () => {

    test('HashMap index access', (ctx) => {
      checkOk(
        "import { HashMap } from 'zena:collections';\nlet m = new HashMap<String, i32>();\nlet f = (): void => {\n  m[\"x\"] = 42;\n};"
      );
    });

    test('HashMap get method', (ctx) => {
      checkOk(
        "import { HashMap } from 'zena:collections';\nlet m = new HashMap<String, i32>();\nlet f = (): void => {\n  if (let (true, v) = m.get(\"x\")) { let _ = v; }\n};"
      );
    });

    test('HashMap has method', (ctx) => {
      checkOk(
        "import { HashMap } from 'zena:collections';\nlet m = new HashMap<String, i32>();\nlet b = m.has(\"x\");"
      );
    });

    test('HashMap field with get and return', (ctx) => {
      // Class with HashMap field — get method return type must substitute V
      checkOk(
        "import { HashMap } from 'zena:collections';\nclass Store {\n  #data = new HashMap<String, i32>();\n  lookup(key: String): i32 {\n    if (let (true, val) = this.#data.get(key)) { return val; }\n    return 0;\n  }\n}"
      );
    });

    test('HashMap index access substitutes V', (ctx) => {
      // Index access on HashMap field must substitute type args
      checkOk(
        "import { HashMap } from 'zena:collections';\nclass Cache {\n  #map = new HashMap<String, i32>();\n  getValue(key: String): i32 {\n    return this.#map[key];\n  }\n}"
      );
    });
  });

  // ==========================================================================
  // Match pattern narrowing
  // ==========================================================================

  suite('match pattern narrowing', () => {

    test('as pattern narrows to class type', (ctx) => {
      checkOk(
        "sealed class Shape {\n  case Circle(radius: f64)\n  case Rect(w: f64, h: f64)\n}\nlet c = new Circle(3.14);\nlet r: f64 = c.radius;"
      );
    });

    test('as pattern with identifier narrows to class type', (ctx) => {
      // `case Circle as c:` where Circle is an Identifier (no {})
      checkOk(
        "sealed class Shape {\n  case Circle(radius: f64)\n  case Rect(w: f64, h: f64)\n}\nlet area = (s: Shape): f64 => match (s) {\n  case Circle as c: c.radius\n  case Rect as r: r.w * r.h\n};"
      );
    });

    test('as pattern with distributed variant narrows', (ctx) => {
      // Distributed variant (standalone class extends sealed)
      checkOk(
        "sealed class Node {\n  case Leaf, Branch\n}\nclass Leaf(value: i32) extends Node\nclass Branch(left: Node, right: Node) extends Node\nlet eval = (n: Node): i32 => match (n) {\n  case Leaf as l: l.value\n  case Branch as b: eval(b.left) + eval(b.right)\n};"
      );
    });
  });

  suite('null check narrowing', () => {

    test('if != null narrows in then branch', (ctx) => {
      checkOk(
        "class Foo {\n  x: i32;\n  new(this.x);\n}\nlet f = (): void => {\n  let foo: Foo | null = null;\n  if (foo != null) {\n    let y: Foo = foo;\n  }\n};"
      );
    });

    test('if == null narrows in else branch', (ctx) => {
      checkOk(
        "class Foo {\n  x: i32;\n  new(this.x);\n}\nlet f = (): void => {\n  let foo: Foo | null = null;\n  if (foo == null) {\n    let y: i32 = 0;\n  } else {\n    let y: Foo = foo;\n  }\n};"
      );
    });

    test('if == null early return narrows after', (ctx) => {
      checkOk(
        "class Foo {\n  x: i32;\n  new(this.x);\n}\nlet f = (foo: Foo | null): i32 => {\n  if (foo == null) { return 0; }\n  let y: Foo = foo;\n  return y.x;\n};"
      );
    });

    test('null narrowing with method call argument', (ctx) => {
      // Pattern from scope.zena: if (info == null) { ... } else { record(expr, info); }
      checkOk(
        "class Info {\n  x: i32;\n  new(this.x);\n}\nlet record = (info: Info): void => {};\nlet lookup = (): Info | null => null;\nlet test = (): void => {\n  let info = lookup();\n  if (info == null) {\n    let x = 0;\n  } else {\n    record(info);\n  }\n};"
      );
    });

    test('null narrowing with != null and method call', (ctx) => {
      // Pattern from scope.zena: if (info != null) { record(ann, info); }
      checkOk(
        "class Info {\n  x: i32;\n  new(this.x);\n}\nlet record = (info: Info): void => {};\nlet lookup = (): Info | null => null;\nlet test = (): void => {\n  let info = lookup();\n  if (info != null) {\n    record(info);\n  }\n};"
      );
    });

    test('null narrowing inside match case with method call', (ctx) => {
      // Exact pattern from scope.zena: inside match arm, if == null, else calls method
      checkOk(
        "class Info {\n  x: i32;\n  new(this.x);\n}\nclass Ref {\n  record(a: i32, info: Info): void {}\n}\nclass Foo {\n  #ref: Ref;\n  new() : #ref = new Ref();\n  test(input: String | null): void {\n    let info: Info | null = null;\n    if (info == null) {\n      let x = 0;\n    } else {\n      this.#ref.record(42, info);\n    }\n  }\n}"
      );
    });

    test('null narrowing inside match case body', (ctx) => {
      // info inferred from function returning T | null, inside match arm
      // FIRST: without match - should pass
      checkOk(
        "class Info {\n  x: i32;\n  new(this.x);\n}\nlet record = (info: Info): void => {};\nlet lookup = (s: String): Info | null => null;\nlet process = (s: String): void => {\n  let info = lookup(s);\n  if (info == null) {\n    let x = 0;\n  } else {\n    record(info);\n  }\n};"
      );
    });

    test('null narrowing inside match case body with match', (ctx) => {
      // SAME but inside match - should also pass
      checkOk(
        "class Info {\n  x: i32;\n  new(this.x);\n}\nlet record = (info: Info): void => {};\nlet lookup = (s: String): Info | null => null;\nsealed class Tag {\n  case A(name: String)\n  case B\n}\nlet process = (expr: Tag): void => {\n  match (expr) {\n    case A {name}: {\n      let info = lookup(name);\n      if (info == null) {\n        let x = 0;\n      } else {\n        record(info);\n      }\n    }\n    case _: {}\n  }\n};"
      );
    });

    test('null narrowing inside match - no destructuring', (ctx) => {
      // Same but without destructuring in match pattern
      checkOk(
        "sealed class Tag {\n  case A\n  case B\n}\nlet f = (): String | null => null;\nlet process = (expr: Tag): void => {\n  match (expr) {\n    case A: {\n      let info = f();\n      if (info == null) {\n        let x = 0;\n      } else {\n        let y: String = info;\n      }\n    }\n    case B: {}\n  }\n};"
      );
    });

    test('rejects nullable to non-nullable assignment', (ctx) => {
      checkError(
        "class Foo {\n  x: i32;\n  new(this.x);\n}\nlet foo: Foo | null = null;\nlet y: Foo = foo;",
        "not assignable"
      );
    });

    test('narrowing allows non-null assignment in if body', (ctx) => {
      // With narrowing, foo should be Foo (not Foo | null) inside the if body
      checkOk(
        "class Foo {\n  x: i32;\n  new(this.x);\n}\nlet f = (): void => {\n  let foo: Foo | null = null;\n  if (foo != null) {\n    let y: Foo = foo;\n  }\n};"
      );
    });
  });
});
