/**
 * Portable semantics tests — every `.zena` file under
 * `tests/language/semantics/` is parsed, scope-analysed and type-checked,
 * and the diagnostics produced are matched against the file's `@error:`
 * and `@warning:` directives.
 *
 * Discovery walks the directory tree with no allow-list; the only way
 * to hold a test back is an explicit `@skip: <reason>` in the file,
 * which the summary then reports.
 *
 * Requires WASI (run with wasmtime via `npm run test:semantics`).
 */

import { runAndReport, suite } from 'zena:test';
import { console } from 'zena:console';
import { readFile } from 'zena:fs';
import { Array } from 'zena:array';
import { stdlibIdToRelativeFile } from '../lib/module-resolver.zena';
import { Diagnostic, DiagnosticSeverity, formatDiagnostic } from '../lib/diagnostics.zena';
import { createCompiler, CompilerOptions, checkCompilation, ProgramCheckResult } from '../lib/compiler.zena';
import { CompilerHost } from '../lib/library-loader.zena';
import { loadPackageMap } from '../lib/package-manifest.zena';
import { Directive, Discovery, TestFile, registerSuites } from './portable-harness.zena';

let testsRoot = 'tests/language/semantics';

/**
 * Reads from disk, except for the one file under test, whose source is
 * injected so the compiler sees it without a round trip through the
 * filesystem.
 */
class FsHost implements CompilerHost {
  #stdlibRoot: String;
  var filePathOverride: String = '';
  var fileSourceOverride: String = '';

  new(stdlibRoot: String)
    : #stdlibRoot = stdlibRoot;

  readFile(path: String): String {
    if (path == this.filePathOverride) {
      return this.fileSourceOverride;
    }
    if (path.startsWith('zena:')) {
      return readFile(`${this.#stdlibRoot}/${stdlibIdToRelativeFile(path)}`);
    }
    return readFile(path);
  }
}

// One compiler instance is shared across the whole suite so that
// checking is incremental — which is also why discovery order has to be
// deterministic (see portable-harness.zena).
let stdlibRoot = 'packages/stdlib/zena';
let host = new FsHost(stdlibRoot);
let packages = loadPackageMap(host, 'zena-packages.json');
let options = new CompilerOptions('host', stdlibRoot, packages);
let compiler = createCompiler(host, options);
var prevCheckResult: ProgramCheckResult | null = null;

/** Renders diagnostics one per line for a failure message. */
let formatAll = (diagnostics: Array<Diagnostic>, source: String): String => {
  if (diagnostics.length == 0) {
    return '(none)';
  }
  var out = '';
  for (var i = 0; i < diagnostics.length; i += 1) {
    if (i > 0) {
      out = out + '\n';
    }
    out = out + formatDiagnostic(diagnostics[i], source);
  }
  return out;
};

let severityMatches = (d: Diagnostic, wanted: DiagnosticSeverity): boolean =>
  match (d.severity) {
    case DiagnosticSeverity.Error: wanted == DiagnosticSeverity.Error
    case DiagnosticSeverity.Warning: wanted == DiagnosticSeverity.Warning
    case _: false
  };

let filterBySeverity = (
    diagnostics: Array<Diagnostic>,
    wanted: DiagnosticSeverity): Array<Diagnostic> => {
  let matches = new Array<Diagnostic>(4);
  for (let d in diagnostics) {
    if (severityMatches(d, wanted)) {
      matches.push(d);
    }
  }
  return matches;
};

/** Parse → scope → check the file, then match diagnostics against directives. */
let runSemanticTest = (f: TestFile): void => {
  let expectedErrors = f.all('error');
  let expectedWarnings = f.all('warning');
  let warnUnnecessaryCasts = f.directive('warnUnnecessaryCasts') == 'true';

  host.filePathOverride = f.path;
  host.fileSourceOverride = f.source;

  // Invalidate the loader cache for this path so the file is re-read.
  compiler.invalidate(f.path);
  options.warnUnnecessaryCasts = warnUnnecessaryCasts;

  let result = compiler.compile(f.path);
  let checkResult = checkCompilation(result, prevCheckResult, false, warnUnnecessaryCasts);
  prevCheckResult = checkResult;

  // Aggregate diagnostics from every non-stdlib module of this
  // compilation, not just the entry: import-cycle diagnostics land in
  // the cycle member that evaluates first, which is never the entry.
  let diagnostics = new Array<Diagnostic>(4);
  for (let file in result.files) {
    if (!file.isStdlib && checkResult.results.has(file.path)) {
      for (let diag in checkResult.results[file.path].diagnostics) {
        diagnostics.push(diag);
      }
    }
  }

  let errors = filterBySeverity(diagnostics, DiagnosticSeverity.Error);
  for (let expected in expectedErrors) {
    var matched = false;
    for (let error in errors) {
      if (error.message.contains(expected.value)) {
        matched = true;
        break;
      }
    }
    if (!matched) {
      throw new Error(
        `Expected error matching '${expected.value}' on line ${expected.line} but found none.\n` +
        `Actual errors:\n${formatAll(errors, f.source)}\nFile: ${f.path}`);
    }
  }

  if (expectedErrors.length == 0 && errors.length > 0) {
    throw new Error(`Unexpected errors:\n${formatAll(errors, f.source)}\nFile: ${f.path}`);
  }

  // Warnings match one-for-one: two `@warning:` directives require two
  // distinct warnings, not one warning matching both.
  let warnings = filterBySeverity(diagnostics, DiagnosticSeverity.Warning);
  let claimed = new Array<boolean>(warnings.length);
  for (var i = 0; i < warnings.length; i += 1) {
    claimed.push(false);
  }

  for (let expected in expectedWarnings) {
    var warningMatched = false;
    for (var i = 0; i < warnings.length; i += 1) {
      if (!claimed[i] && warnings[i].message.contains(expected.value)) {
        warningMatched = true;
        claimed[i] = true;
        break;
      }
    }
    if (!warningMatched) {
      throw new Error(
        `Expected warning matching '${expected.value}' on line ${expected.line} but found none.\n` +
        `Actual warnings:\n${formatAll(warnings, f.source)}\nFile: ${f.path}`);
    }
  }

  // Unexpected warnings only fail tests that opted into checking them.
  if (expectedWarnings.length > 0) {
    let unclaimed = new Array<Diagnostic>(4);
    for (var i = 0; i < warnings.length; i += 1) {
      if (!claimed[i]) {
        unclaimed.push(warnings[i]);
      }
    }
    if (unclaimed.length > 0) {
      throw new Error(
        `Unexpected warnings:\n${formatAll(unclaimed, f.source)}\nFile: ${f.path}`);
    }
  }
};

export let main = (): i32 => {
  let discovery = new Discovery();
  let root = suite('Portable Semantics Tests', (): void => {
    // Every `.zena` file under semantics/ is checked on its own, the
    // modules that exist to be imported by another test included: a
    // module that fails to check in isolation is itself a bug.
    registerSuites(
      testsRoot, '', discovery, (f: TestFile): boolean => true, runSemanticTest);
  });
  // Registration is complete once `suite` returns, so what was found can
  // be reported before anything runs.
  let write = (s: String): void => { console.log(s); };
  discovery.report('Semantics', write);
  return runAndReport(root, write);
};
