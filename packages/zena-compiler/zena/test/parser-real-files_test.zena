import { suite, test, TestContext } from 'zena:test';
import { equal } from 'zena:assert';
import { readFile, listDir, FileType } from 'zena:fs';
import { parse } from '../lib/parser.zena';

let parseFile = (path: String): boolean => {
  let source = readFile(path);
  let mod = try {
    parse(source, path);
    true
  } catch (e) {
    console.log("Parse error in " + path + ": " + e.message);
    let stack = e.getStackTrace();
    if (stack != null) {
      console.log(stack);
    }
    false
  };
  return mod;
};

/** Every `.zena` file under `dirPath`, deepest directories included. */
let zenaFilesUnder = (dirPath: String, out: GrowableArray<String>): void => {
  for (let entry in listDir(dirPath)) {
    if (entry.fileType == FileType.Directory) {
      if (entry.name != "." && entry.name != "..") {
        zenaFilesUnder(dirPath + "/" + entry.name, out);
      }
    } else if (entry.fileType == FileType.RegularFile) {
      if (entry.name.endsWith(".zena")) {
        out.push(dirPath + "/" + entry.name);
      }
    }
  }
};

// The files are listed inside the test rather than while the suite
// registers: registration runs in the instance's start function,
// before any task exists, and a component's file system calls block
// in a task.
export let tests = suite('Parser: Real Files', (): void => {
  test('every standard library file parses', (ctx: TestContext): void => {
    let files = new Array<String>();
    zenaFilesUnder('packages/stdlib/zena', files);
    var failed = 0;
    var names = '';
    for (let path in files) {
      if (!parseFile(path)) {
        failed += 1;
        names = names + ' ' + path;
      }
    }
    equal(failed, 0, `files that did not parse:${names}`);
  });
});
