/**
 * Tests for the package manifest parser and stdlib config builder.
 */ 

import { suite, test } from 'zena:test';
import { equal, isTrue, isFalse } from 'zena:assert';
import { readFileSync } from 'zena:fs';
import { JsonObject, parseJson } from 'zena:json';
import { ModuleExport } from '../lib/module-resolver.zena';
import { loadWorkspace, buildStdlibConfig } from '../lib/package-manifest.zena';
import { stdlibLibraryOf, stdlibLibraryAnswers } from '../lib/stdlib-manifest.zena';
import { MockHost } from './test-utils.zena';

export let tests = suite("Package Manifest", () => {

  suite("loadWorkspace", () => {

    // A workspace whose root is the package `app`, with a package `lib`
    // in packages/, a published dependency pinned in zena-lock.json, and
    // a WIT-backed one.
    let workspace = () => {
      let host = new MockHost();
      host.addFile("/ws/zena-package.json", `{
        "name": "app",
        "exports": {"server": {}},
        "dependencies": {
          "lib": {"path": "./packages/lib"},
          "router": {"did": "did:plc:router", "version": "1.4.2"},
          "gfx": {"wit": "./wit"}
        },
        "workspace": {"packages": ["packages/*"]}
      }`);
      host.addFile("/ws/main.zena", "");
      host.addFile("/ws/wit/gfx.wit", "");
      host.addFile("/ws/packages/lib/zena-package.json", `{
        "name": "lib",
        "dependencies": {"router2": {"did": "did:plc:router", "version": "2.0.0"}}
      }`);
      host.addFile("/ws/packages/lib/lib.zena", "");
      host.addFile("/ws/packages/tool/zena-package.json", '{"name": "tool"}');
      host.addFile("/ws/packages/notes/README.md", "");
      host.addFile("/ws/zena-lock.json", `{
        "resolved": {
          "did:plc:router@1": {"version": "1.4.2", "release": "bafyrei1", "source": "bafkreione"},
          "did:plc:router@2": {"version": "2.0.0", "release": "bafyrei2", "source": "bafkreitwo"}
        }
      }`);
      // Router 1.4.2 is in the cache, with a manifest of its own.
      host.addFile("/cache/sources/bafkreione/zena-package.json", '{"exports": {"match": {}}}');
      host.addFile("/cache/sources/bafkreione/match.zena", "");
      return host;
    };

    test("reads the packages from the manifests, each with its own names", () => {
      let packages = loadWorkspace(workspace(), "/ws", null, "/cache");
      let app = packages["app"];
      equal(app.root, "/ws");
      isTrue(app.exports != null);
      let appNames = app.dependencies as HashMap<String, String>;
      equal(appNames["app"], "app");
      equal(appNames["lib"], "lib");
      equal(appNames["router"], "did:plc:router@1");
      equal(appNames["gfx"], "gfx");
      equal(packages["gfx"].witRoot as String, "/ws/wit");

      let lib = packages["lib"];
      equal(lib.root, "/ws/packages/lib");
      let libNames = lib.dependencies as HashMap<String, String>;
      equal(libNames["router2"], "did:plc:router@2");
      isFalse(libNames.has("router"));
      // `tool` is a workspace package; packages/notes has no manifest.
      isTrue(packages.has("tool"));
      isFalse(packages.has("notes"));

      // A published package's exports come from its manifest in the cache.
      let router = packages["did:plc:router@1"];
      equal(router.root, "/cache/sources/bafkreione");
      isTrue((router.exports as HashMap<String, ModuleExport>).has("match"));
      isTrue(packages["did:plc:router@2"].exports == null);
    });

    test("leaves published packages out without a package cache", () => {
      let packages = loadWorkspace(workspace(), "/ws");
      isFalse(packages.has("did:plc:router@1"));
      isFalse((packages["app"].dependencies as HashMap<String, String>).has("router"));
      isTrue(packages.has("lib"));
    });

    test("reads a workspace whose root is not a package", () => {
      let host = new MockHost();
      host.addFile("/ws/zena-package.json", '{"workspace": {"packages": ["a", "b"]}}');
      host.addFile("/ws/a/zena-package.json", '{"name": "a", "dependencies": {"b": {"path": "../b"}}}');
      host.addFile("/ws/b/zena-package.json", '{"name": "b"}');
      let packages = loadWorkspace(host, "/ws", null, "/cache");
      equal(packages.size, 2);
      equal((packages["a"].dependencies as HashMap<String, String>)["b"], "b");
      equal(packages["b"].root, "/ws/b");
    });

    test("gives the files in no package the dependencies of a root that is not a package", () => {
      let host = new MockHost();
      host.addFile("/ws/zena-package.json", `{
        "workspace": {"packages": ["lib"]},
        "dependencies": {
          "library": {"path": "./lib"},
          "gfx": {"wit": "./wit"},
          "router": {"did": "did:plc:router", "version": "1.0.0"}
        }
      }`);
      host.addFile("/ws/lib/zena-package.json", '{"name": "lib"}');
      host.addFile("/ws/zena-lock.json",
          '{"resolved": {"did:plc:router@1": {"version": "1.0.0", "source": "bafkreirouter"}}}');
      let packages = loadWorkspace(host, "/ws", null, "/cache");
      equal(packages["library"].aliasOf as String, "lib");
      equal(packages["router"].aliasOf as String, "did:plc:router@1");
      equal(packages["gfx"].witRoot as String, "/ws/wit");
      equal(packages["lib"].root, "/ws/lib");
    });

    test("reads a path outside the workspace against the workspace's absolute path", () => {
      let host = new MockHost();
      host.addFile("zena-package.json", `{
        "name": "app",
        "dependencies": {
          "sibling": {"path": "../zena/packages/lib"},
          "inside": {"path": "./packages/inside"},
          "elsewhere": {"path": "/elsewhere/lib"},
          "w": {"wit": "../zena/wit"}
        }
      }`);
      host.addFile("/home/me/zena/packages/lib/zena-package.json", '{"name": "sibling"}');
      host.addFile("packages/inside/zena-package.json", '{"name": "inside"}');
      host.addFile("/elsewhere/lib/zena-package.json", '{"name": "elsewhere"}');
      let packages = loadWorkspace(host, ".", "/home/me/project");
      equal(packages["app"].root, ".");
      equal(packages["sibling"].root, "/home/me/zena/packages/lib");
      equal(packages["w"].witRoot as String, "/home/me/zena/wit");
      equal(packages["elsewhere"].root, "/elsewhere/lib");
      // A package inside the workspace stays relative, as library paths
      // and diagnostics expect.
      equal(packages["inside"].root, "packages/inside");
    });

    test("parses each form of export", () => {
      let host = new MockHost();
      host.addFile("/ws/zena-package.json", `{
        "name": "lib",
        "exports": {
          "plain": {},
          "widgets": {"path": "widgets/index.zena", "internal": true},
          "console": {"virtual": {"js": "console/js.zena", "zena-cli": "console/cli.zena"}},
          "legacy": {"virtual": {"host": "legacy/js.zena"}}
        }
      }`);
      let exports = loadWorkspace(host, "/ws")["lib"].exports as HashMap<String, ModuleExport>;
      equal(exports.size, 4);
      isTrue(exports["plain"].path == null);
      isFalse(exports["plain"].internal);
      equal(exports["widgets"].path as String, "widgets/index.zena");
      isTrue(exports["widgets"].internal);
      let console = exports["console"].virtual as HashMap<String, String>;
      equal(console["js"], "console/js.zena");
      equal(console["zena-cli"], "console/cli.zena");
      // A virtual entry under the old target name `host` is the `js` one.
      let legacy = exports["legacy"].virtual as HashMap<String, String>;
      equal(legacy["js"], "legacy/js.zena");
      isFalse(legacy.has("host"));
    });

    test("has no packages without a manifest", () => {
      let host = new MockHost();
      host.addFile("/ws/main.zena", "");
      equal(loadWorkspace(host, "/ws", null, "/cache").size, 0);
    });

    test("rejects a lockfile whose pins do not hold together", () => {
      let router = '"did:plc:router@1": {"source": "bafkreirouter"}';
      let rejects = (lock: String) => {
        let host = new MockHost();
        host.addFile("/ws/zena-package.json", '{"name": "app"}');
        host.addFile("/ws/zena-lock.json", lock);
        var caught = false;
        try {
          loadWorkspace(host, "/ws", null, "/cache");
        } catch (e) {
          caught = true;
        }
        isTrue(caught, lock);
      };
      // Keys that are not a DID and major version.
      rejects('{"resolved": {"router@1": {"source": "bafkreirouter"}}}');
      rejects('{"resolved": {"did:plc:router": {"source": "bafkreirouter"}}}');
      rejects('{"resolved": {"did:plc:router@one": {"source": "bafkreirouter"}}}');
      // Sources that are not CIDs, which could name any directory.
      rejects('{"resolved": {"did:plc:router@1": {"source": "../../etc"}}}');
      rejects('{"resolved": {"did:plc:router@1": {"source": "bafkrei/router"}}}');
      rejects('{"resolved": {"did:plc:router@1": {}}}');
      rejects('{"resolved": {"did:plc:router@1": "bafkreirouter"}}');
      // Two packages in one directory.
      rejects(`{"resolved": {${router}, "did:plc:copy@1": {"source": "bafkreirouter"}}}`);
      // A pin's dependency that is not pinned, or not a name.
      rejects('{"resolved": {"did:plc:router@1": {"source": "bafkreirouter", "dependencies": {"json": "did:web:json@2"}}}}');
      rejects(`{"resolved": {"did:plc:router@1": {"source": "bafkreirouter", "dependencies": {"a:b": "did:plc:router@1"}}}}`);
    });

    test("rejects a workspace that does not hold together", () => {
      let rejects = (files: Array<(String, String)>, what: String) => {
        let host = new MockHost();
        for (let (path, text) in files) {
          host.addFile(path, text);
        }
        var caught = false;
        try {
          loadWorkspace(host, "/ws", null, "/cache");
        } catch (e) {
          caught = true;
        }
        isTrue(caught, what);
      };
      rejects([("/ws/zena-package.json", '{"name": "app", "dependencies": {"lib": {"path": "./lib"}}}')],
          "a path dependency with no manifest");
      rejects([
        ("/ws/zena-package.json", '{"workspace": {"packages": ["a", "b"]}}'),
        ("/ws/a/zena-package.json", '{"name": "same"}'),
        ("/ws/b/zena-package.json", '{"name": "same"}'),
      ], "two packages with one name");
      rejects([("/ws/zena-package.json",
          '{"name": "app", "dependencies": {"router": {"did": "did:plc:router", "version": "1.0.0"}}}')],
          "a published dependency the lockfile does not pin");
      rejects([("/ws/zena-package.json", '{"name": "zena"}')], "the standard library's name");
      rejects([("/ws/zena-package.json", '{"name": "app", "dependencies": {"a:b": {"path": "."}}}')],
          "a local name that cannot be imported");
      rejects([
        ("/ws/zena-package.json", '{"workspace": {"packages": ["lib"]}, "dependencies": {"lib": {"path": "./other"}}}'),
        ("/ws/lib/zena-package.json", '{"name": "lib"}'),
        ("/ws/other/zena-package.json", '{"name": "other"}'),
      ], "a root name that is also a package's");
    });
  });

  suite("buildStdlibConfig", () => {

    test("sets root from argument", () => {
      let config = buildStdlibConfig("/path/to/stdlib/zena");
      equal(config.root, "/path/to/stdlib/zena");
    });

    test("includes public modules", () => {
      let config = buildStdlibConfig("/stdlib");
      let exports = config.exports as Map<String, ModuleExport>;
      isTrue(exports.has("core"));
      isTrue(exports.has("collections"));
      isTrue(exports.has("json"));
      isTrue(exports.has("test"));
    });

    test("includes console as virtual module", () => {
      let config = buildStdlibConfig("/stdlib");
      let exports = config.exports as Map<String, ModuleExport>;
      let consoleExport = exports["console"];
      let virtual = consoleExport.virtual as Map<String, String>;
      equal(virtual["js"], "console/js.zena");
      equal(virtual["zena-cli"], "console/component.zena");
      isFalse(virtual.has("host"));
    });

    test("includes core/string.zena as internal virtual module", () => {
      let config = buildStdlibConfig("/stdlib");
      let exports = config.exports as Map<String, ModuleExport>;
      let stringExport = exports["core/string.zena"];
      isTrue(stringExport.internal);
      let virtual = stringExport.virtual as Map<String, String>;
      equal(virtual["js"], "core/string-js.zena");
      equal(virtual["zena-cli"], "core/string.zena");
      equal(virtual["component"], "core/string.zena");
      equal(virtual["freestanding"], "core/string.zena");
    });

    test("does not export console implementation files by name", () => {
      let config = buildStdlibConfig("/stdlib");
      let exports = config.exports as Map<String, ModuleExport>;
      isFalse(exports.has("console-host"));
      isFalse(exports.has("console-wasi"));
      isFalse(exports.has("console-interface"));
    });

    // The module list in `lib/stdlib-manifest.zena` is a second copy of the
    // one in `packages/stdlib/stdlib-manifest.json`, and its comment says to
    // keep them in sync. Nothing checked that, so a module added to the JSON
    // alone built fine and then failed to resolve, with "Library not found"
    // naming the import rather than the list that was missing it.
    //
    // Read inside the test: registration runs in the instance's start
    // function, where a file system call blocks a task that does not exist
    // yet.
    test("exports every module the standard library's manifest declares", () => {
      let manifest = parseJson(readFileSync('packages/stdlib/stdlib-manifest.json'));
      let modules = (manifest as JsonObject)['modules'] as JsonObject;
      let exports = buildStdlibConfig("/stdlib").exports as Map<String, ModuleExport>;
      var missing = '';
      modules.forEach((name, config) => {
        if (!exports.has(name)) {
          missing = `${missing} ${name}`;
        }
      });
      equal(
        missing,
        '',
        `declared in stdlib-manifest.json, missing from lib/stdlib-manifest.zena:${missing}`,
      );
    });
  });

  suite("stdlibLibraryOf", () => {

    test("a library's own name maps to itself", () => {
      equal(stdlibLibraryOf("zena:core"), "core");
      equal(stdlibLibraryOf("zena:collections"), "collections");
      equal(stdlibLibraryOf("zena:error-stack"), "error-stack");
    });

    test("an id without the zena: prefix is not a stdlib module", () => {
      // Callers pass a sourcePath, and every stdlib one carries the prefix.
      isTrue(stdlibLibraryOf("core") == null);
      isTrue(stdlibLibraryOf("async/future.zena") == null);
    });

    test("an entry file maps to the library it is the entry for", () => {
      equal(stdlibLibraryOf("zena:console/host.zena"), "console");
      equal(stdlibLibraryOf("zena:url/index.zena"), "url");
      equal(stdlibLibraryOf("zena:memory/component.zena"), "memory");
    });

    test("an entry file wins over the directory it sits in", () => {
      // core/error/ holds error-stack's two entry files. They are named by
      // the manifest, so they belong to their respective libraries rather
      // than falling through the directory rule to core.
      equal(stdlibLibraryOf("zena:core/error/stack-host.zena"), "error-stack");
      equal(stdlibLibraryOf("zena:core/error/stack-none.zena"), "error-stack");
      // Everything under core/ (including the virtual string files) belongs to core.
      equal(stdlibLibraryOf("zena:core/string.zena"), "core");
      equal(stdlibLibraryOf("zena:core/string-js.zena"), "core");
      equal(stdlibLibraryOf("zena:core/error.zena"), "core");
    });

    test("a private file belongs to the library its directory names", () => {
      equal(stdlibLibraryOf("zena:async/future.zena"), "async");
      equal(stdlibLibraryOf("zena:async/executor.zena"), "async");
      equal(stdlibLibraryOf("zena:collections/hash-map.zena"), "collections");
      equal(stdlibLibraryOf("zena:simd/instructions.zena"), "simd");
    });

    test("a non-stdlib module belongs to no library", () => {
      isTrue(stdlibLibraryOf("zena:not-a-library") == null);
      isTrue(stdlibLibraryOf("zena:not-a-library/file.zena") == null);
      isTrue(stdlibLibraryOf("/project/src/main.zena") == null);
    });

    test("a private file of a published directory library belongs to it", () => {
      // Core's members have no module name of their own, so the directory
      // rule is what attributes them: every file under core/ belongs to
      // core, whether or not the manifest has heard of it.
      equal(stdlibLibraryOf("zena:core/array.zena"), "core");
      equal(stdlibLibraryOf("zena:core/index.zena"), "core");
      equal(stdlibLibraryOf("zena:core/not-a-module.zena"), "core");
    });

    test("a library answers for itself", () => {
      isTrue(stdlibLibraryAnswers("collections", "collections"));
      isTrue(stdlibLibraryAnswers("core", "core"));
    });

    test("no library answers for another between migrations", () => {
      // The move table is empty at rest, so a lookup naming a library has
      // exactly one answer. An entry exists only while a library's files
      // are mid-move, and `string-convert` — the one that has needed it so
      // far — now lives where the manifest says it does.
      isFalse(stdlibLibraryAnswers("core", "string-convert"));
      isFalse(stdlibLibraryAnswers("core", "json"));
      isFalse(stdlibLibraryAnswers("core", "regex"));
      isFalse(stdlibLibraryAnswers("string-convert", "core"));
    });

    test("a name is not matched by prefix", () => {
      // "collections" is its own library, not a file under "core".
      equal(stdlibLibraryOf("zena:collections"), "collections");
      isTrue(stdlibLibraryOf("zena:corely") == null);
      isTrue(stdlibLibraryOf("zena:asyncx/future.zena") == null);
    });
  });
});
