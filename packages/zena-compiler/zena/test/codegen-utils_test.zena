import { suite, test, TestContext } from 'zena:test';
import { equal, isTrue, isFalse } from 'zena:assert';
import { typeContainsTypeParameter, sortStringsByLengthDescending } from '../lib/codegen/codegen-utils.zena';
import { noSymbolId } from '../lib/scope/symbol.zena';
import {
  Type, I32Type, ClassType, InterfaceType, TypeAliasType, MixinType, TypeParameterType, TypeId
} from '../lib/types.zena';
import { growable } from 'zena:core';

export let tests = suite('codegen-utils: typeContainsTypeParameter', () => {
  test('primitive types do not contain type parameters', (ctx) => {
    isFalse(typeContainsTypeParameter(new I32Type() as Type));
  });

  test('direct TypeParameterType contains type parameter', (ctx) => {
    let tParam = new TypeParameterType("T", null, null);
    isTrue(typeContainsTypeParameter(tParam as Type));
  });

  test('ClassType details', (ctx) => {
    let classType = new ClassType(1 as TypeId, noSymbolId, "MyClass");
    isFalse(typeContainsTypeParameter(classType as Type));

    // With concrete type arguments
    let args1 = growable<Type>([new I32Type() as Type]);
    classType.typeArguments = args1;
    isFalse(typeContainsTypeParameter(classType as Type));

    // With type parameter arguments
    let args2 = growable<Type>([
      new TypeParameterType("T", null, null) as Type,
    ]);
    classType.typeArguments = args2;
    isTrue(typeContainsTypeParameter(classType as Type));

    // Open generic class (uninstantiated)
    classType.typeArguments = null;
    let tps = growable<TypeParameterType>([
      new TypeParameterType("T", null, null),
    ]);
    classType.typeParameters = tps;
    isTrue(typeContainsTypeParameter(classType as Type));
  });

  test('InterfaceType details', (ctx) => {
    let interfaceType = new InterfaceType(2 as TypeId, noSymbolId, "MyInterface");
    isFalse(typeContainsTypeParameter(interfaceType as Type));

    // With concrete type arguments
    let args1 = growable<Type>([new I32Type() as Type]);
    interfaceType.typeArguments = args1;
    isFalse(typeContainsTypeParameter(interfaceType as Type));

    // With type parameter arguments
    let args2 = growable<Type>([
      new TypeParameterType("T", null, null) as Type,
    ]);
    interfaceType.typeArguments = args2;
    isTrue(typeContainsTypeParameter(interfaceType as Type));

    // Open generic interface (uninstantiated)
    interfaceType.typeArguments = null;
    let tps = growable<TypeParameterType>([
      new TypeParameterType("T", null, null),
    ]);
    interfaceType.typeParameters = tps;
    isTrue(typeContainsTypeParameter(interfaceType as Type));
  });

  test('TypeAliasType details', (ctx) => {
    let aliasType = new TypeAliasType(
      "MyAlias",
      null,
      new I32Type() as Type,
      false,
      null,
      false,
      ""
    );
    isFalse(typeContainsTypeParameter(aliasType as Type));

    // With concrete type arguments
    let args1 = growable<Type>([new I32Type() as Type]);
    aliasType.typeArguments = args1;
    isFalse(typeContainsTypeParameter(aliasType as Type));

    // With type parameter arguments
    let args2 = growable<Type>([
      new TypeParameterType("T", null, null) as Type,
    ]);
    aliasType.typeArguments = args2;
    isTrue(typeContainsTypeParameter(aliasType as Type));

    // Open generic type alias (uninstantiated)
    aliasType.typeArguments = null;
    let tps = growable<TypeParameterType>([
      new TypeParameterType("T", null, null),
    ]);
    aliasType.typeParameters = tps;
    isTrue(typeContainsTypeParameter(aliasType as Type));
  });

  test('MixinType details', (ctx) => {
    let mixinType = new MixinType("MyMixin");
    isFalse(typeContainsTypeParameter(mixinType as Type));

    // With concrete type arguments
    let args1 = growable<Type>([new I32Type() as Type]);
    mixinType.typeArguments = args1;
    isFalse(typeContainsTypeParameter(mixinType as Type));

    // With type parameter arguments
    let args2 = growable<Type>([
      new TypeParameterType("T", null, null) as Type,
    ]);
    mixinType.typeArguments = args2;
    isTrue(typeContainsTypeParameter(mixinType as Type));

    // Reset type arguments, test onType containing type parameter
    mixinType.typeArguments = null;
    mixinType.onType = new TypeParameterType("T", null, null) as Type;
    isTrue(typeContainsTypeParameter(mixinType as Type));

    // with concrete onType
    mixinType.onType = new I32Type() as Type;
    isFalse(typeContainsTypeParameter(mixinType as Type));

    // Open generic mixin (uninstantiated)
    mixinType.onType = null;
    let tps = growable<TypeParameterType>([
      new TypeParameterType("T", null, null),
    ]);
    mixinType.typeParameters = tps;
    isTrue(typeContainsTypeParameter(mixinType as Type));
  });

  test('sortStringsByLengthDescending basic functionality', (ctx) => {
    let arr = growable<String>(["a", "abc", "ab", ""]);
    
    sortStringsByLengthDescending(arr);
    
    equal(arr.length, 4);
    equal(arr[0], "abc");
    equal(arr[1], "ab");
    equal(arr[2], "a");
    equal(arr[3], "");
  });

  test('sortStringsByLengthDescending empty and single element', (ctx) => {
    let arrEmpty = new Array<String>();
    sortStringsByLengthDescending(arrEmpty);
    equal(arrEmpty.length, 0);

    let arrSingle = growable<String>(["hello"]);
    sortStringsByLengthDescending(arrSingle);
    equal(arrSingle.length, 1);
    equal(arrSingle[0], "hello");
  });

  test('sortStringsByLengthDescending duplicate lengths', (ctx) => {
    let arr = growable<String>(["abc", "xy", "z", "def", "ab"]);
    
    sortStringsByLengthDescending(arr);
    
    equal(arr.length, 5);
    // Elements of length 3 should come first (in some order)
    isTrue(arr[0].length == 3);
    isTrue(arr[1].length == 3);
    // Elements of length 2 should come next
    isTrue(arr[2].length == 2);
    isTrue(arr[3].length == 2);
    // Elements of length 1 should come last
    isTrue(arr[4].length == 1);
  });
});

