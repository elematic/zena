// Hello World test for the self-hosted Zena compiler
// Tests that the basic test infrastructure is working

import { suite, test, TestContext } from 'zena:test';
import { equal, isTrue } from 'zena:assert';

export let tests = suite('Hello World', () => {
  test('1 + 1 equals 2', (ctx) => {
    equal(1 + 1, 2);
  });

  test('string comparison works', (ctx) => {
    equal('hello', 'hello');
  });

  test('boolean assertions work', (ctx) => {
    isTrue(true);
    isTrue(1 < 2);
  });

  suite('nested suite', () => {
    test('nested test works', (ctx) => {
      equal(42, 42);
    });
  });
});


