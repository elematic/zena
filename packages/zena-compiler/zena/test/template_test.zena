/**
 * Template lowering (docs/design/template-zir.md): the methods of a
 * generic class are lowered for two specializations and copied for the
 * rest, and the module comes out the same as with every body lowered
 * directly. Each test compiles with templates on and check mode on
 * (every copied body is also lowered directly and compared), then with
 * templates off, and compares the two modules' text.
 */
import { suite, test } from 'zena:test';
import { equal, isTrue } from 'zena:assert';
import { WatGenerator } from '../lib/codegen/wat-generator.zena';
import { TemplateFamilies } from '../lib/codegen/ir/template.zena';
import { Program, CompilationUnit } from '../lib/program.zena';
import {
  makeCompiler, makeStdlibCompiler, MockHost, PlainHost, errorDiagnostics,
} from './test-utils.zena';
import { checkCompilation } from '../lib/compiler.zena';
import { TypeInterner } from '../lib/types.zena';

/** The checked program for `source`. */
function programOf(source: String): Program {
  let host = new MockHost();
  host.addFile("test.zena", source);
  let compiler = makeCompiler(host);
  let compResult = compiler.compile({entry: "test.zena", target: 'js'});
  let checkRes = checkCompilation(compResult);
  let errors = errorDiagnostics(checkRes.diagnostics);
  if (errors.length > 0) {
    throw new Error(`the fixture does not compile: ${errors[0].message}`);
  }
  let entryAst = compResult.entry.ast;
  let units = new Array<CompilationUnit>();
  var entryUnit: CompilationUnit | null = null;
  for (let file in compResult.files) {
    if (!file.isStdlib) {
      let res = checkRes.results[file.path];
      if (res != null) {
        let unit = {ast: file.ast, model: res.model};
        units.push(unit);
        if (file.ast.path == entryAst.path) {
          entryUnit = unit;
        }
      }
    }
  }
  return new Program(units, entryUnit);
}

/**
 * The checked program for `source` against the standard library on
 * disk, every unit included, with the checker's interner: what `hash`
 * on a class needs (it reaches the `String` helpers).
 */
function stdlibProgramOf(source: String): (Program, TypeInterner) {
  let host = new PlainHost();
  host.addFile("test.zena", source);
  let compiler = makeStdlibCompiler(host);
  let compResult = compiler.compile({entry: "test.zena", target: 'freestanding'});
  let checkRes = checkCompilation(compResult);
  let errors = errorDiagnostics(checkRes.diagnostics);
  if (errors.length > 0) {
    throw new Error(`the fixture does not compile: ${errors[0].message}`);
  }
  let entryAst = compResult.entry.ast;
  let units = new Array<CompilationUnit>();
  var entryUnit: CompilationUnit | null = null;
  for (let file in compResult.files) {
    let res = checkRes.results[file.path];
    if (res != null) {
      let unit = {ast: file.ast, model: res.model};
      units.push(unit);
      if (file.ast.path == entryAst.path) {
        entryUnit = unit;
      }
    }
  }
  return (new Program(units, entryUnit), checkRes.sharedState.interner);
}

/**
 * Compiles `source` with templates and check mode on, checks that the
 * module equals the one compiled with templates off, and returns the
 * families the first compile used.
 */
function compileBothWays(source: String): TemplateFamilies {
  let withTemplates = new WatGenerator("freestanding", false, 1);
  withTemplates.templateCheck = true;
  let wat = withTemplates.generate(programOf(source));
  let without = new WatGenerator("freestanding", false, 1);
  without.templates = false;
  equal(wat, without.generate(programOf(source)));
  return withTemplates.templateFamilies as TemplateFamilies;
}

/** `compileBothWays` against the standard library. */
function compileBothWaysWithStdlib(source: String): TemplateFamilies {
  let (program, interner) = stdlibProgramOf(source);
  let withTemplates = new WatGenerator("freestanding", false, 1);
  withTemplates.templateCheck = true;
  withTemplates.interner = interner;
  let wat = withTemplates.generate(program);
  let (program2, interner2) = stdlibProgramOf(source);
  let without = new WatGenerator("freestanding", false, 1);
  without.templates = false;
  without.interner = interner2;
  equal(wat, without.generate(program2));
  return withTemplates.templateFamilies as TemplateFamilies;
}

export let tests = suite('template lowering', () => {
  test('methods of a class specialized at four classes copy from one template', () => {
    let families = compileBothWays(`
      class A { n: i32; new(this.n); }
      class B { n: i32; new(this.n); }
      class C { n: i32; new(this.n); }
      class D { n: i32; new(this.n); }
      class Slot<T> {
        var #value: T;
        var #writes: i32 = 0;
        new(value: T) : #value = value;
        get(): T { return this.#value; }
        set(value: T): void {
          this.#value = value;
          this.#writes = this.#writes + 1;
        }
        writes(): i32 { return this.#writes; }
      }
      export let run = (): i32 => {
        let a = new Slot<A>(new A(1));
        let b = new Slot<B>(new B(2));
        let c = new Slot<C>(new C(3));
        let d = new Slot<D>(new D(4));
        a.set(new A(5));
        b.set(new B(6));
        c.set(new C(7));
        d.set(new D(8));
        return a.get().n + b.get().n + c.get().n + d.get().n +
            a.writes() + b.writes() + c.writes() + d.writes();
      };
    `);
    isTrue(families.templates >= 3);
    // Two of the four members of each family teach it; the other two copy.
    isTrue(families.specialized >= 6);
  });

  test('a method overridden in one specialization is not copied into it', () => {
    // Base<A> has a subclass that overrides `weight`, so `this.weight()`
    // in Base<A>.score dispatches through the vtable; in Base<B>,
    // Base<C> and Base<D> it is a direct call. Whichever members the
    // template was learned from, Base<A>'s body must not be copied
    // from the others: the guard on `memberProvidedBySubclass` declines
    // it, or the two representatives disagree and there is no template.
    let families = compileBothWays(`
      class A { n: i32; new(this.n); }
      class B { n: i32; new(this.n); }
      class C { n: i32; new(this.n); }
      class D { n: i32; new(this.n); }
      class Base<T> {
        value: T;
        new(this.value);
        weight(): i32 { return 1; }
        score(): i32 { return this.weight() * 10; }
      }
      class Heavy extends Base<A> {
        new(v: A) : super(v);
        weight(): i32 { return 7; }
      }
      export let run = (): i32 => {
        let plain = new Base<A>(new A(1));
        let heavy: Base<A> = new Heavy(new A(2));
        let b = new Base<B>(new B(30));
        let c = new Base<C>(new C(1000));
        let d = new Base<D>(new D(10000));
        return plain.score() + heavy.score() + b.score() + c.score() + d.score();
      };
    `);
    let declined = families.declined.format();
    let stopped = families.stopped.format();
    isTrue(declined.contains('guard') || stopped.contains('differ'));
  });

  test('a key class with its own hashCode and == is not copied into', () => {
    // A, B and C inherit hashCode from Keyed and compare by identity,
    // so a template learned from two of them calls Keyed.hashCode and
    // compares with ref.eq. D declares both, and the guards on the
    // method's owner and on identity equality decline its copies.
    let families = compileBothWaysWithStdlib(`
      @intrinsic('hash')
      declare function hash<T>(value: T): i32;
      @intrinsic('eq')
      declare function equals<T>(a: T, b: T): boolean;
      class Keyed {
        id: i32;
        new(this.id);
        hashCode(): i32 { return this.id; }
      }
      class A extends Keyed { new(id: i32) : super(id); }
      class B extends Keyed { new(id: i32) : super(id); }
      class C extends Keyed { new(id: i32) : super(id); }
      class D extends Keyed {
        new(id: i32) : super(id);
        hashCode(): i32 { return this.id * 1000; }
        operator ==(other: D): boolean { return this.id == other.id; }
      }
      class Table<K extends Keyed> {
        #key: K;
        new(key: K) : #key = key;
        slot(): i32 { return hash(this.#key); }
        same(other: K): boolean { return equals(this.#key, other); }
        holds(other: K): boolean { return this.#key == other; }
      }
      export let run = (): i32 => {
        let ta = new Table<A>(new A(1));
        let tb = new Table<B>(new B(2));
        let tc = new Table<C>(new C(3));
        let td = new Table<D>(new D(4));
        var n = ta.slot() + tb.slot() + tc.slot() + td.slot();
        if (ta.same(new A(1)) || tb.same(new B(2)) || tc.same(new C(3)) ||
            td.same(new D(4))) {
          n += 1;
        }
        if (ta.holds(new A(1)) || tb.holds(new B(2)) || tc.holds(new C(3)) ||
            td.holds(new D(4))) {
          n += 1;
        }
        return n;
      };
    `);
    isTrue(families.specialized >= 3);
    let declined = families.declined.format();
    let stopped = families.stopped.format();
    isTrue(declined.contains('guard') || stopped.contains('differ') ||
        stopped.contains('class equality'));
  });
});
