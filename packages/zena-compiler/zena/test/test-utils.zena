/**
 * Shared test utilities for the self-hosted compiler test suite.
 */

import { CompilerHost } from '../lib/library-loader.zena';
import { PackageConfig } from '../lib/module-resolver.zena';
import {
  createCompiler, Compiler, CompilerOptions
} from '../lib/compiler.zena';
import { Diagnostic, DiagnosticSeverity } from '../lib/diagnostics.zena';

/**
 * In-memory CompilerHost backed by a HashMap.
 *
 * Tests call `addFile` to register virtual files, then pass
 * the host to `makeCompiler` or `createCompiler`.
 */
export class MockHost implements CompilerHost {
  #files = new Map<String, String>();

  addFile(path: String, content: String): void {
    this.#files[path] = content;
  }

  readFile(path: String): String {
    return this.#files.getOr(path, '');
  }

  /**
   * The files directly under `path`, and the directories that hold the
   * rest; null when no file is under `path`, since a map of files holds
   * no empty directories.
   */
  listDir(path: String): Array<String> | null {
    let prefix = `${path}/`;
    let names = new GrowableArray<String>();
    for (let file in this.#files.keys()) {
      if (!file.startsWith(prefix)) {
        continue;
      }
      var name = file.sliceBytes(prefix.length, file.length);
      for (var i = 0; i < name.length; i += 1) {
        if (name.getByteAt(i) == 47) { // '/'
          name = name.sliceBytes(0, i);
          break;
        }
      }
      if (!names.contains(name)) {
        names.push(name);
      }
    }
    if (names.length == 0) {
      return null;
    }
    return names;
  }
}

/**
 * Create a Compiler with minimal stdlib stubs.
 *
 * The prelude names `zena:core`, so its entry point has to exist and
 * re-export the stubs behind it — that entry is how the prelude scope
 * reaches any of them. The files it re-exports have no module name of
 * their own, the way the real library is arranged.
 */
export let makeCompiler = (host: MockHost): Compiler => {
  host.addFile("zena:core/index.zena",
      "export * from './string.zena';\n" +
      "export * from './array.zena';\n" +
      "export * from './iterator.zena';\n" +
      "export * from './ownership.zena';\n" +
      "export * from './hashable.zena';\n");
  host.addFile("zena:core/string.zena", "export class String {}");
  host.addFile("zena:core/array.zena", "export class Array {} export class FixedArray<T> {} export class GrowableArray<T> {}");
  host.addFile("zena:core/iterator.zena", "export interface Iterator<T> {} export interface Iterable<T> {}");
  host.addFile("zena:core/ownership.zena", "export class Resource {}");
  host.addFile("zena:core/hashable.zena", "export interface Hashable {}");
  host.addFile("zena:async", "export class Future<T> {}");
  host.addFile("zena:console", "export let console = null;");

  let packages = new Map<String, PackageConfig>();
  let options = new CompilerOptions("host", "/stdlib", packages);
  return createCompiler(host, options);
};

/**
 * Filter an array of diagnostics down to errors only.
 */
export let errorDiagnostics = (diags: Array<Diagnostic>): Array<Diagnostic> => {
  let errors = new Array<Diagnostic>(4);
  // TODO: add a .filter method to Array to simplify this
  for (let diagnostic in diags) {
    if (diagnostic.severity == DiagnosticSeverity.Error) {
      errors.push(diagnostic);
    }
  }
  return errors;
};
