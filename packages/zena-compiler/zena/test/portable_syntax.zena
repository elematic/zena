/**
 * Portable syntax tests — every `.zena` file under
 * `tests/language/syntax/` is parsed and its AST compared against the
 * `.ast.json` snapshot beside it. A file carrying an `@error:` directive
 * asserts that parsing fails instead.
 *
 * Discovery walks the directory tree with no allow-list; the only way
 * to hold a test back is an explicit `@skip: <reason>` in the file,
 * which the summary then reports.
 *
 * Requires WASI (run with wasmtime via `npm run test:syntax`).
 */

import { runAndReport, suite } from 'zena:test';
import { console } from 'zena:console';
import { jsonEqual } from 'zena:assert';
import { readFile, writeFile, exists } from 'zena:fs';
import { parseJson, stringify } from 'zena:json';
import { parse } from '../lib/parser.zena';
import { nodeToJson } from '../lib/ast-json.zena';
import { ExpressionStatement } from '../lib/ast.zena';
import { Discovery, TestFile, registerSuites } from './portable-harness.zena';

let testsRoot = 'tests/language/syntax';

/** The AST node a snapshot covers: the whole module unless the file says otherwise. */
let targetOf = (f: TestFile): String => {
  let target = f.directive('target');
  return if (target == null) { 'module' } else { target as String };
};

/** The `.ast.json` snapshot that sits beside a `.zena` test. */
let snapshotPathOf = (f: TestFile): String =>
  f.path.sliceBytes(0, f.path.length - 5) + '.ast.json';

let runSyntaxTest = (f: TestFile): void => {
  if (f.has('error')) {
    // Error test: the parser is expected to reject this source.
    let threw = try {
      parse(f.source, f.name);
      false
    } catch (e) {
      true
    };
    if (!threw) {
      throw new Error(
        `Expected parse error (has @error directive) but parsing succeeded: ${f.path}`);
    }
    return;
  }

  let mod = parse(f.source, f.name);
  let actual = match (targetOf(f)) {
    case 'statement': {
      nodeToJson(mod.body[0]);
    }
    case 'expression': {
      let stmt = mod.body[0] as ExpressionStatement;
      nodeToJson(stmt.expression);
    }
    case _: {
      nodeToJson(mod)
    }
  };

  let snapshotPath = snapshotPathOf(f);
  if (!exists(snapshotPath)) {
    // A missing snapshot is generated on the first run rather than
    // failing, so a newly added test records its own baseline.
    writeFile(snapshotPath, stringify(actual, '  '));
    return;
  }

  let expected = parseJson(
    readFile(snapshotPath), { allowComments: false, trackLocations: true });
  jsonEqual(actual, expected, f.path);
};

export let main = (): i32 => {
  let discovery = new Discovery();
  let root = suite('Portable Syntax Tests', (): void => {
    // Every `.zena` file under syntax/ is a test: parsing one never
    // needs a second file, so there are no support modules to exclude.
    registerSuites(
      testsRoot, '', discovery, (f: TestFile): boolean => true, runSyntaxTest);
  });
  // Registration is complete once `suite` returns, so what was found can
  // be reported before anything runs.
  let write = (s: String): void => { console.log(s); };
  discovery.report('Syntax', write);
  return runAndReport(root, write);
};
