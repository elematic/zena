// Tests for the module resolver.

import { suite, test, TestContext } from 'zena:test';
import { equal, throws } from 'zena:assert';
import {
  ModuleResolver, ModuleExport, PackageConfig, indexOfByte, dirName, normalizePath, splitByByte, stdlibIdToRelativeFile,
} from '../lib/module-resolver.zena';

// ============================================================================
// Helpers
// ============================================================================

// Create a minimal stdlib package config for testing.
function makeStdlibConfig() {
  let exports = new Map<String, ModuleExport>();
  exports["string"] = new ModuleExport(null);
  exports["array"] = new ModuleExport(null);
  exports["map"] = new ModuleExport(null);

  // A module with an explicit entry file (a directory-based library).
  exports["url"] = new ModuleExport(null, "url/index.zena");

  let stringVirtual: HashMap<String, String> = {
    "js" => "core/string-js.zena",
    "zena-cli" => "core/string.zena",
  };
  exports["core/string.zena"] = new ModuleExport(stringVirtual, null, true);

  // An internal module: the manifest entry is what picks its file, and
  // only the package's own modules may name it.
  let stackVirtual: HashMap<String, String> = {
    "js" => "core/error/stack-host.zena",
  };
  exports["error-stack"] = new ModuleExport(stackVirtual, null, true);

  let consoleVirtual: HashMap<String, String> = {
    "js" => "console/host.zena",
    "zena-cli" => "console/component.zena",
  };
  exports["console"] = new ModuleExport(consoleVirtual);

  let fallbackVirtual: HashMap<String, String> = {
    "js" => "fallback/js.zena",
    "default" => "fallback/default.zena",
  };
  exports["fallback"] = new ModuleExport(fallbackVirtual);

  return new PackageConfig("/stdlib", exports);
}

// Create a user package config for testing.
function makeUserPackageConfig() {
  return new PackageConfig("/project/packages/mylib/zena/lib", null);
}

// Create a resolver with stdlib + user package.
function makeResolver(target: String) {
  let packages: HashMap<String, PackageConfig> = {
    "zena" => makeStdlibConfig(),
    "mylib" => makeUserPackageConfig(),
  };
  return new ModuleResolver(packages, target);
}

// A resolver for a project that uses router, a published package, which
// itself uses json; with a WIT package, as the stdlib carries.
function makeResolvedResolver() {
  let router = new PackageConfig("/cache/sources/bafkreirouter", null);
  router.dependencies = {"json" => "did:web:json@2"};
  let json = new PackageConfig("/cache/sources/bafkreijson", null);
  json.dependencies = new Map<String, String>();
  let alias = new PackageConfig("", null);
  alias.aliasOf = "did:plc:router@1";
  let wasi = new PackageConfig("", null);
  wasi.witRoot = "/stdlib/wit";
  let packages: HashMap<String, PackageConfig> = {
    "zena" => makeStdlibConfig(),
    "app" => new PackageConfig("/project/src", null),
    "vendored" => new PackageConfig("/project/src/vendor/lib", null),
    "did:plc:router@1" => router,
    "did:web:json@2" => json,
    "router" => alias,
    "wasi" => wasi,
  };
  return new ModuleResolver(packages, "zena-cli");
}

export let tests = suite("Module Resolver", () => {

// ============================================================================
// Path Utility Tests
// ============================================================================

  suite("Path Utilities", () => {

  test("indexOfByte finds byte", (t) => {
    equal(indexOfByte("hello:world", 58), 5); // 58 = ':'
  });

  test("indexOfByte returns -1 when not found", (t) => {
    equal(indexOfByte("hello", 58), 0 - 1);
  });

  test("indexOfByte finds first occurrence", (t) => {
    equal(indexOfByte("a:b:c", 58), 1);
  });

  test("dirName extracts directory", (t) => {
    equal(dirName("/foo/bar/baz.zena"), "/foo/bar");
  });

  test("dirName returns . for no separator", (t) => {
    equal(dirName("file.zena"), ".");
  });

  test("normalizePath preserves leading double-dots in relative paths", (t) => {
    equal(normalizePath("../foo.zena"), "../foo.zena");
    equal(normalizePath("a/../../foo.zena"), "../foo.zena");
  });

  test("stdlibIdToRelativeFile maps name ids", (t) => {
    equal(stdlibIdToRelativeFile("zena:string"), "string.zena");
    equal(stdlibIdToRelativeFile("string"), "string.zena");
  });

  test("stdlibIdToRelativeFile maps path ids", (t) => {
    equal(stdlibIdToRelativeFile("zena:console/host.zena"), "console/host.zena");
  });

  test("normalizePath resolves dots", (t) => {
    equal(normalizePath("/foo/bar/./baz.zena"), "/foo/bar/baz.zena");
  });

  test("normalizePath resolves double-dots", (t) => {
    equal(normalizePath("/foo/bar/../baz.zena"), "/foo/baz.zena");
  });

  test("normalizePath preserves absolute path", (t) => {
    equal(normalizePath("/foo/bar"), "/foo/bar");
  });

  test("normalizePath handles relative path", (t) => {
    equal(normalizePath("foo/bar"), "foo/bar");
  });

  test("splitByByte splits on delimiter", (t) => {
    let parts = splitByByte("a/b/c", 47); // 47 = '/'
    equal(parts.length, 3);
    equal(parts[0], "a");
    equal(parts[1], "b");
    equal(parts[2], "c");
  });

  test("splitByByte handles leading delimiter", (t) => {
    let parts = splitByByte("/a/b", 47);
    equal(parts.length, 3);
    equal(parts[0], "");
    equal(parts[1], "a");
    equal(parts[2], "b");
  });
  });

// ============================================================================
// Module Resolver Tests
// ============================================================================

  suite("ModuleResolver", () => {

  // --- Stdlib resolution ---

  test("resolves stdlib module", (t) => {
    let resolver = makeResolver("js");
    let result = resolver.resolve("zena:string", "/my/file.zena");
    equal(result.path, "zena:string");
    equal(result.packageName, "zena");
  });

  test("resolves stdlib virtual module for js", (t) => {
    let resolver = makeResolver("js");
    let result = resolver.resolve("zena:console", "/my/file.zena");
    equal(result.path, "zena:console/host.zena");
    equal(result.packageName, "zena");
  });

  test("resolves the legacy target name host as js", (t) => {
    // Manifests list entries under "js" only.
    let resolver = makeResolver("host");
    equal(resolver.target, "js");
    let result = resolver.resolve("zena:console", "/my/file.zena");
    equal(result.path, "zena:console/host.zena");
    equal(result.packageName, "zena");
  });

  test("resolves stdlib virtual module for zena-cli", (t) => {
    let resolver = makeResolver("zena-cli");
    let result = resolver.resolve("zena:console", "/my/file.zena");
    equal(result.path, "zena:console/component.zena");
    equal(result.packageName, "zena");
  });

  test("resolves stdlib virtual module with default fallback", (t) => {
    let resolver = makeResolver("wasi");
    let result = resolver.resolve("zena:fallback", "/my/file.zena");
    equal(result.path, "zena:fallback/default.zena");
    equal(result.packageName, "zena");
  });

  test("resolves stdlib module with explicit entry path", (t) => {
    let resolver = makeResolver("js");
    let result = resolver.resolve("zena:url", "/my/file.zena");
    equal(result.path, "zena:url/index.zena");
    equal(result.packageName, "zena");
  });

  test("blocks import of unlisted stdlib file by name", (t) => {
    let resolver = makeResolver("js");
    throws(() => {
      resolver.resolve("zena:console-host", "/my/file.zena");
    });
  });

  test("rejects unknown stdlib module", (t) => {
    let resolver = makeResolver("js");
    throws(() => {
      resolver.resolve("zena:nonexistent", "/my/file.zena");
    });
  });

  // --- Relative imports between stdlib files ---

  test("resolves relative import from a stdlib path id", (t) => {
    let resolver = makeResolver("js");
    let result = resolver.resolve("./interface.zena", "zena:console/host.zena");
    equal(result.path, "zena:console/interface.zena");
    equal(result.packageName, "zena");
  });

  test("relative import to a manifest module canonicalizes to its name id", (t) => {
    let resolver = makeResolver("js");
    let result = resolver.resolve("./array.zena", "zena:string");
    equal(result.path, "zena:array");
    equal(result.packageName, "zena");
  });

  test("relative import from a subdirectory up to a manifest module", (t) => {
    let resolver = makeResolver("js");
    let result = resolver.resolve("../string.zena", "zena:console/host.zena");
    equal(result.path, "zena:string");
  });

  test("relative import to an unlisted stdlib file gets a path id", (t) => {
    let resolver = makeResolver("js");
    let result = resolver.resolve("./helper.zena", "zena:string");
    equal(result.path, "zena:helper.zena");
  });

  test("relative import to an explicit-path module keeps the path id", (t) => {
    // url has path "url/index.zena", so its canonical id is the path id,
    // and relative imports to the same file must agree.
    let resolver = makeResolver("js");
    let result = resolver.resolve("./url/index.zena", "zena:string");
    equal(result.path, "zena:url/index.zena");
  });

  test("an internal module resolves for its own package", (t) => {
    let resolver = makeResolver("js");
    let result = resolver.resolve("zena:error-stack", "zena:core/error.zena");
    equal(result.path, "zena:core/error/stack-host.zena");
  });

  test("an internal module is refused from outside its package", (t) => {
    // The name exists and picks a file per target. That is machinery for
    // the library that owns it, and not an API a program may import.
    let resolver = makeResolver("js");
    throws(() => {
      resolver.resolve("zena:error-stack", "/project/src/main.zena");
    });
  });

  test("relative import to an internal virtual module selects target file", (t) => {
    let jsResolver = makeResolver("js");
    let jsResult = jsResolver.resolve("./string.zena", "zena:core/index.zena");
    equal(jsResult.path, "zena:core/string-js.zena");

    let cliResolver = makeResolver("zena-cli");
    let cliResult = cliResolver.resolve("./string.zena", "zena:core/index.zena");
    equal(cliResult.path, "zena:core/string.zena");
  });

  test("relative import escaping the stdlib throws", (t) => {
    let resolver = makeResolver("js");
    throws(() => {
      resolver.resolve("../outside.zena", "zena:string");
    });
  });

  // --- User package resolution ---

  test("resolves user package module", (t) => {
    let resolver = makeResolver("js");
    let result = resolver.resolve("mylib:utils", "/my/file.zena");
    equal(result.path, "/project/packages/mylib/zena/lib/utils.zena");
    equal(result.packageName, "mylib");
  });

  test("rejects unknown package", (t) => {
    let resolver = makeResolver("js");
    throws(() => {
      resolver.resolve("unknown:module", "/my/file.zena");
    });
  });

  // --- Relative resolution ---

  test("resolves relative import", (t) => {
    let resolver = makeResolver("js");
    let result = resolver.resolve("./utils.zena", "/project/src/main.zena");
    equal(result.path, "/project/src/utils.zena");
  });

  test("resolves parent relative import", (t) => {
    let resolver = makeResolver("js");
    let result = resolver.resolve("../lib/utils.zena", "/project/src/main.zena");
    equal(result.path, "/project/lib/utils.zena");
  });

  // --- Specifier validation ---

  test("rejects bare specifier without colon", (t) => {
    let resolver = makeResolver("js");
    throws(() => {
      resolver.resolve("bare-specifier", "/my/file.zena");
    });
  });

  // --- Package membership ---

  test("findPackageForPath identifies stdlib", (t) => {
    let resolver = makeResolver("js");
    equal(resolver.findPackageForPath("zena:string"), "zena");
  });

  test("findPackageForPath identifies user package", (t) => {
    let resolver = makeResolver("js");
    equal(resolver.findPackageForPath("/project/packages/mylib/zena/lib/foo.zena"), "mylib");
  });

  test("findPackageForPath returns empty for unknown", (t) => {
    let resolver = makeResolver("js");
    equal(resolver.findPackageForPath("/unknown/file.zena"), "");
  });

  });
  suite("Published packages", () => {

  test("a project name resolves through its alias to the pinned package", (t) => {
    let resolved = makeResolvedResolver().resolve("router:match", "/project/src/main.zena");
    equal(resolved.path, "/cache/sources/bafkreirouter/match.zena");
    equal(resolved.packageName, "did:plc:router@1");
  });

  test("a pinned package's files resolve names through its own dependencies", (t) => {
    let resolver = makeResolvedResolver();
    let resolved = resolver.resolve("json:parse", "/cache/sources/bafkreirouter/match.zena");
    equal(resolved.path, "/cache/sources/bafkreijson/parse.zena");
    equal(resolved.packageName, "did:web:json@2");
    // The project has no name for json.
    throws(() => {
      resolver.resolve("json:parse", "/project/src/main.zena");
    });
  });

  test("a pinned package sees the standard library and WIT packages", (t) => {
    let resolver = makeResolvedResolver();
    equal(resolver.resolve("zena:string", "/cache/sources/bafkreirouter/match.zena").path, "zena:string");
    let wit = resolver.resolve("wasi:clocks/monotonic-clock", "/cache/sources/bafkreirouter/match.zena");
    equal(wit.path, "wit:/stdlib/wit#wasi:clocks/monotonic-clock");
  });

  test("a pinned package does not see the project's names", (t) => {
    let resolver = makeResolvedResolver();
    throws(() => {
      resolver.resolve("app:main", "/cache/sources/bafkreirouter/match.zena");
    });
    throws(() => {
      resolver.resolve("router:match", "/cache/sources/bafkreijson/parse.zena");
    });
  });

  test("a relative import stays in the pinned package", (t) => {
    let resolved = makeResolvedResolver().resolve("./util.zena", "/cache/sources/bafkreirouter/match.zena");
    equal(resolved.path, "/cache/sources/bafkreirouter/util.zena");
    equal(resolved.packageName, "did:plc:router@1");
  });

  test("findPackageForPath matches whole directories, the longest first", (t) => {
    let resolver = makeResolvedResolver();
    equal(resolver.findPackageForPath("/project/src/main.zena"), "app");
    equal(resolver.findPackageForPath("/project/src/vendor/lib/x.zena"), "vendored");
    equal(resolver.findPackageForPath("/project/srcs/main.zena"), "");
    equal(resolver.findPackageForPath("/cache/sources/bafkreijson/parse.zena"), "did:web:json@2");
    // Aliases and WIT packages have no root, and own nothing.
    equal(resolver.findPackageForPath("/elsewhere/x.zena"), "");
  });
  });
  suite("A workspace's root package", () => {
  test("a package rooted at . owns the relative paths no other package does", (t) => {
    let packages: HashMap<String, PackageConfig> = {
      "zena" => makeStdlibConfig(),
      "app" => new PackageConfig(".", null),
      "lib" => new PackageConfig("packages/lib", null),
    };
    let resolver = new ModuleResolver(packages, "zena-cli");
    equal(resolver.findPackageForPath("main.zena"), "app");
    equal(resolver.findPackageForPath("src/server.zena"), "app");
    equal(resolver.findPackageForPath("packages/lib/lib.zena"), "lib");
    equal(resolver.findPackageForPath("../other/x.zena"), "");
    equal(resolver.findPackageForPath("/elsewhere/x.zena"), "");
    equal(resolver.findPackageForPath("zena:string"), "zena");
  });
  });
});


