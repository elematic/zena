import { suite, test, TestContext } from 'zena:test';
import { equal, isTrue } from 'zena:assert';
import { WatGenerator } from '../lib/codegen/wat-generator.zena';
import { Array } from 'zena:array';
import { Program, CompilationUnit } from '../lib/program.zena';
import { readFile, writeFile, exists, mkdir } from 'zena:fs';
import { String } from 'zena:string';
import { makeCompiler, MockHost } from './test-utils.zena';
import {
  assertFunctionOmits, assertFunctionUses, assertFunctionUsesTimes,
  assertNoAllocation, watFunction,
} from './wat-invariants.zena';
import { checkCompilation } from '../lib/compiler.zena';
import { getEnv } from 'zena:cli';

let assertSnapshot = (name: String, content: String): void => {
  let snapDir = 'packages/zena-compiler/test-files/snapshots';
  if (!exists(snapDir)) {
    mkdir(snapDir);
  }
  let snapFile = snapDir + '/' + name + '.snap';
  if (getEnv("UPDATE_SNAPSHOTS") != null) {
    writeFile(snapFile, content);
    equal(content, content);
  } else if (exists(snapFile)) {
    let expected = readFile(snapFile);
    equal(content, expected);
  } else {
    writeFile(snapFile, content);
    equal(content, content);
  }
};

let compileWithZir = (source: String): String => {
  let host = new MockHost();
  host.addFile("test.zena", source);

  let compiler = makeCompiler(host);
  let compResult = compiler.compile("test.zena");
  let checkRes = checkCompilation(compResult, null, false);

  let entryAst = compResult.entry.ast;
  let units = new GrowableArray<CompilationUnit>();
  var entryUnit: CompilationUnit | null = null;

  for (let file in compResult.files) {
    if (!file.isStdlib) {
      let res = checkRes.results[file.path];
      if (res != null) {
        let unit = {ast: file.ast, model: res.model};
        units.push(unit);
        if (file.ast.path == entryAst.path) {
          entryUnit = unit;
        }
      }
    }
  }

  let program = new Program(units, entryUnit);
  let generator = new WatGenerator("zena-cli", false);
  return generator.generate(program);
};

export let tests = suite('zir backend', (): void => {
  test('straight-line arithmetic function', (ctx: TestContext): void => {
    let result = compileWithZir(
        'export let main = (): i32 => { let a = 6; let b = 7; return a * b; };');
    assertSnapshot('zir_straight_line', result);
  });

  test('if/else with merged assignment', (ctx: TestContext): void => {
    let result = compileWithZir(
        'export let main = (): i32 => {\n' +
        '  var r = 0;\n' +
        '  let x = 4;\n' +
        '  if (x % 2 == 0) {\n' +
        '    r = x * 2;\n' +
        '  } else {\n' +
        '    r = x + 1;\n' +
        '  }\n' +
        '  return r;\n' +
        '};');
    assertSnapshot('zir_if_else_merge', result);
  });

  test('try/catch keeps an assigned local off the heap', (ctx: TestContext): void => {
    // A try body that assigns an enclosing local needs storage the
    // handler can read, because the protected edge carries only the
    // values live at try entry. That storage is a wasm local — a
    // mutable variable, ir.md §5.1.1 — and specifically NOT a heap
    // cell: writing a `try` must not silently start allocating.
    let result = compileWithZir(
        'export let main = (): i32 => {\n' +
        '  var n = 0;\n' +
        '  try {\n' +
        '    n = 7;\n' +
        '  } catch {\n' +
        '    n = 0 - 1;\n' +
        '  }\n' +
        '  return n;\n' +
        '};');
    let usesTry = new GrowableArray<String>();
    usesTry.push('try_table');
    assertFunctionUses(result, '$main', usesTry,
        'the fixture is supposed to compile a protected region');
    assertNoAllocation(result, '$main',
        'a try-assigned local is mirrored into a wasm local, not boxed');
    assertSnapshot('zir_try_local_mirror', result);
  });

  test('a finalizer is emitted once for every way out of the try', (ctx: TestContext): void => {
    // Four exits leave this region — the body's normal completion, the
    // `return`, the `break`, and the exception the handler edge
    // catches — and each of them owes the finalizer. They are routed
    // through ONE copy of it rather than getting a copy each: the
    // marker constant appears exactly once. Emitting a copy per edge
    // would also be wrong, not just fat, because the copy on the
    // normal path would sit INSIDE the protected region and rerun
    // itself if it threw.
    let result = compileWithZir(
        'export let main = (): i32 => {\n' +
        '  var n = 0;\n' +
        '  var i = 0;\n' +
        '  while (i < 3) {\n' +
        '    i += 1;\n' +
        '    try {\n' +
        '      if (i == 1) { break; }\n' +
        '      if (i == 2) { return 5; }\n' +
        '      n += 1;\n' +
        '    } finally {\n' +
        '      n += 987654;\n' +
        '    }\n' +
        '  }\n' +
        '  return n;\n' +
        '};');
    let usesTry = new GrowableArray<String>();
    usesTry.push('try_table');
    assertFunctionUses(result, '$main', usesTry,
        'the fixture is supposed to compile a protected region');
    assertFunctionUsesTimes(result, '$main', 'i32.const 987654', 1,
        'every exit out of a finally region runs one shared copy of ' +
        'the finalizer');
    assertNoAllocation(result, '$main',
        'a finally region parks its exit in wasm locals, not on the heap');
    assertSnapshot('zir_try_finally', result);
  });

  test('while loop with break and continue', (ctx: TestContext): void => {
    let result = compileWithZir(
        'export let main = (): i32 => {\n' +
        '  var acc = 0;\n' +
        '  var i = 0;\n' +
        '  while (i < 10) {\n' +
        '    i += 1;\n' +
        '    if (i == 3) {\n' +
        '      continue;\n' +
        '    }\n' +
        '    if (i == 7) {\n' +
        '      break;\n' +
        '    }\n' +
        '    acc += i;\n' +
        '  }\n' +
        '  return acc;\n' +
        '};');
    assertSnapshot('zir_while_break_continue', result);
  });

  test('short-circuit logic chains', (ctx: TestContext): void => {
    let result = compileWithZir(
        'let f = (x: i32, y: i32): boolean => x > 0 && y > 0 || x == -1;\n' +
        'export let main = (): i32 => if (f(1, 2)) 1 else 0;');
    assertSnapshot('zir_short_circuit', result);
  });

  test('direct calls, recursion, and mutual recursion', (ctx: TestContext): void => {
    // Structural assertions rather than a full-module snapshot: function
    // ORDER in the module depends on discovery worklist order, which
    // shifts with process-global symbol/uid counters whenever unrelated
    // compiler code changes — a multi-function snapshot would churn on
    // every compiler edit. (Single-function snapshots above are stable.)
    let result = compileWithZir(
        'let add = (a: i32, b: i32): i32 => a + b;\n' +
        'let fib = (n: i32): i32 => {\n' +
        '  if (n < 2) {\n' +
        '    return n;\n' +
        '  }\n' +
        '  return fib(n - 1) + fib(n - 2);\n' +
        '};\n' +
        'let isEven = (n: i32): boolean => {\n' +
        '  if (n == 0) { return true; }\n' +
        '  return isOdd(n - 1);\n' +
        '};\n' +
        'let isOdd = (n: i32): boolean => {\n' +
        '  if (n == 0) { return false; }\n' +
        '  return isEven(n - 1);\n' +
        '};\n' +
        'export let main = (): i32 => add(fib(10), if (isEven(4)) 1 else 0);');
    // Self-recursion and mutual recursion emit direct calls.
    isTrue(result.contains('call $fib'));
    isTrue(result.contains('call $isOdd'));
    isTrue(result.contains('call $isEven'));
    isTrue(result.contains('call $add'));
    // The bodies came from the ZIR emitter (every value a local), not the
    // streaming generator: fib's compare materializes into a local before
    // the branch instead of feeding an if directly off the stack.
    isTrue(result.contains('(func $fib'));
  });

  test('if expression with value blocks', (ctx: TestContext): void => {
    let result = compileWithZir(
        'export let main = (): i32 => {\n' +
        '  let n = -200;\n' +
        '  let kind = if (n < 0) {\n' +
        '    let mag = -n;\n' +
        '    if (mag > 100) 3 else 1;\n' +
        '  } else if (n == 0) {\n' +
        '    0;\n' +
        '  } else {\n' +
        '    2;\n' +
        '  };\n' +
        '  return kind;\n' +
        '};');
    assertSnapshot('zir_if_expression', result);
  });

  test('c-style for loop with break and continue', (ctx: TestContext): void => {
    let result = compileWithZir(
        'export let main = (): i32 => {\n' +
        '  var acc = 0;\n' +
        '  for (var i = 0; i < 10; i += 1) {\n' +
        '    if (i == 2) { continue; }\n' +
        '    if (i == 7) { break; }\n' +
        '    acc += i;\n' +
        '  }\n' +
        '  return acc;\n' +
        '};');
    assertSnapshot('zir_for_loop', result);
  });

  test('scalar casts', (ctx: TestContext): void => {
    let result = compileWithZir(
        'export let main = (): i32 => {\n' +
        '  let x = 10;\n' +
        '  let d = x as f64;\n' +
        '  let half = d / 2.0;\n' +
        '  let wide = x as i64;\n' +
        '  return (half as i32) + ((wide * (3 as i64)) as i32);\n' +
        '};');
    assertSnapshot('zir_scalar_casts', result);
  });

  test('unsigned operators select _u variants', (ctx: TestContext): void => {
    // Structural (not snapshot): multi-function modules are
    // discovery-order sensitive.
    let result = compileWithZir(
        'let umod = (a: u32, b: u32): u32 => a % b;\n' +
        'let ucompare = (a: u32, b: u32): boolean => a > b;\n' +
        'export let main = (): i32 => {\n' +
        '  let big = (-1294967296) as u32;\n' +
        '  if (ucompare(big, 2000000000 as u32)) { return umod(big, 7 as u32) as i32; }\n' +
        '  return 0;\n' +
        '};');
    isTrue(result.contains('i32.rem_u'));
    isTrue(result.contains('i32.gt_u'));
  });

  test('reference plumbing: null tests, narrowing, identity', (ctx: TestContext): void => {
    // Structural: multi-function modules are discovery-order sensitive.
    // A local class supplies the reference type (the MockHost harness has
    // no stdlib, so String is unavailable here); string-literal lowering
    // is covered by the portable execution suite under ZENA_BACKEND=zir.
    let result = compileWithZir(
        'class Box { x: i32; new(this.x); }\n' +
        'let pick = (primary: Box | null, fallback: Box): Box => {\n' +
        '  if (primary != null) {\n' +
        '    return primary;\n' +
        '  }\n' +
        '  return fallback;\n' +
        '};\n' +
        'let same = (a: Box, b: Box): boolean => a === b;\n' +
        'export let main = (): i32 => {\n' +
        '  let b = new Box(1);\n' +
        '  if (same(pick(null, b), b)) { return 1; }\n' +
        '  return 0;\n' +
        '};');
    isTrue(result.contains('ref.is_null'));
    isTrue(result.contains('ref.eq'));
    // The narrowed `return primary` re-asserts non-nullness.
    isTrue(result.contains('ref.as_non_null'));
  });

  test('entry-defined ref local graduates non-null past a join', (ctx: TestContext): void => {
    // The entry block's own code emits BEFORE the join's wrapper block
    // opens, so its set persists through the whole function and the
    // local can be declared at its precise non-null type — reads after
    // the join then need no ref.as_non_null re-assert. Under the old
    // block-0 gate any merge child under the entry blocked graduation.
    let result = compileWithZir(
        'class Box { x: i32; new(this.x); }\n' +
        'export let main = (): i32 => {\n' +
        '  let b = new Box(3);\n' +
        '  var acc = 7;\n' +
        '  if (acc > 1) { acc = 1; } else { acc = 2; }\n' +
        '  return acc + b.x;\n' +
        '};');
    let mainWat = watFunction(result, '$main');
    isTrue(mainWat.contains('(local (ref '));
    isTrue(!mainWat.contains('(local (ref null'));
    isTrue(!mainWat.contains('ref.as_non_null'));
  });

  test('conditional-join value keeps its nullable local', (ctx: TestContext): void => {
    // A join param is written on the arms' edges, INSIDE the if/else
    // scopes — the validator forgets both sets at the join (rollback is
    // uniform even when every arm assigns), so the init replay must
    // keep the local nullable and re-assert on the read.
    let result = compileWithZir(
        'class Box { x: i32; new(this.x); }\n' +
        'let pickBox = (c: boolean): i32 => {\n' +
        '  let b = if (c) new Box(1) else new Box(2);\n' +
        '  return b.x;\n' +
        '};\n' +
        'export let main = (): i32 => pickBox(true);');
    let pickWat = watFunction(result, '$pickBox');
    isTrue(pickWat.contains('(local (ref null'));
    isTrue(pickWat.contains('ref.as_non_null'));
  });

  test('new, field reads, and devirtualized method calls', (ctx: TestContext): void => {
    // Structural: multi-function modules are discovery-order sensitive.
    let result = compileWithZir(
        'final class Point {\n' +
        '  x: i32;\n' +
        '  y: i32;\n' +
        '  new(this.x, this.y);\n' +
        '  manhattan(): i32 { return this.x + this.y; }\n' +
        '}\n' +
        'let measure = (p: Point): i32 => p.manhattan() + p.x;\n' +
        'export let main = (): i32 => measure(new Point(1, 2));');
    // Construction is a single-shot struct.new inside the factory
    // (non-nullable-refs.md) — no struct.new_default shell remains.
    isTrue(result.contains('struct.new'));
    isTrue(!result.contains('struct.new_default'));
    isTrue(result.contains('struct.get'));
    isTrue(result.contains('call $Point'));
  });

  test('constructor prologue: defaults, this params, super', (ctx: TestContext): void => {
    // Structural: multi-function modules are discovery-order sensitive.
    let result = compileWithZir(
        'class Base { tag: i32; new(this.tag); }\n' +
        'final class Derived extends Base {\n' +
        '  var extra: i32 = 7;\n' +
        '  new(t: i32) : super(t) {\n' +
        '    this.extra += t;\n' +
        '  }\n' +
        '}\n' +
        'export let main = (): i32 => {\n' +
        '  let d = new Derived(3);\n' +
        '  return d.tag + d.extra;\n' +
        '};');
    // Derived's factory drives Base through its value phase and
    // allocates with one struct.new; the body's `this.extra += t`
    // is the surviving struct.set.
    isTrue(result.contains('call $Base'));
    isTrue(result.contains('<ctor-init>'));
    isTrue(result.contains('struct.new'));
    isTrue(!result.contains('struct.new_default'));
    isTrue(result.contains('struct.set'));
  });

  test('non-null let fields are immutable and read without re-asserts', (ctx: TestContext): void => {
    // Field types are precise (non-nullable-refs.md): a `let` field of
    // non-null class type declares `(field (ref $T))` — immutable, no
    // null — while a `T | null` field stays nullable, and a reader
    // needs no ref.as_non_null after struct.get.
    let result = compileWithZir(
        'class Box { x: i32; new(this.x); }\n' +
        'class Holder {\n' +
        '  b: Box;\n' +
        '  var maybe: Box | null = null;\n' +
        '  new(this.b);\n' +
        '}\n' +
        'let read = (h: Holder): i32 => h.b.x;\n' +
        'export let main = (): i32 => read(new Holder(new Box(5)));');
    isTrue(result.contains('(field (ref '));
    isTrue(result.contains('(field (mut (ref null'));
    let readWat = watFunction(result, '$read');
    isTrue(!readWat.contains('ref.as_non_null'));
  });

  test('scalar match with literals, or-patterns, and guards', (ctx: TestContext): void => {
    let result = compileWithZir(
        'export let main = (): i32 => {\n' +
        '  let x = 5;\n' +
        '  return match (x) {\n' +
        '    case 0: 10\n' +
        '    case 1 | 2: 20\n' +
        '    case n if (n > 4): 30\n' +
        '    case _: 40\n' +
        '  };\n' +
        '};');
    assertSnapshot('zir_match_scalar', result);
  });

  test('match with class patterns and as-bindings', (ctx: TestContext): void => {
    // Structural: multi-function modules are discovery-order sensitive.
    let result = compileWithZir(
        'class Base { tag: i32; new(this.tag); }\n' +
        'final class One extends Base {\n' +
        '  extra: i32;\n' +
        '  new(t: i32, this.extra) : super(t);\n' +
        '}\n' +
        'let pick = (b: Base): i32 => match (b) {\n' +
        '  case One as o: o.extra\n' +
        '  case _: b.tag\n' +
        '};\n' +
        'export let main = (): i32 => {\n' +
        '  let one = new One(1, 5);\n' +
        '  let base = new Base(9);\n' +
        '  return pick(one) + pick(base);\n' +
        '};');
    // The type test and the guarded downcast for the as-binding.
    isTrue(result.contains('ref.test'));
    isTrue(result.contains('ref.cast'));
    // This match has a wildcard arm, so it HAS no impossible path —
    // the old `unreachable` assertion here was matching the
    // function-tail filler, which outermost-return fall-through
    // removed. The genuinely-impossible no-match path is asserted on
    // an exhaustive sealed match, whose trap sits mid-block:
    let sealedResult = compileWithZir(
        'sealed class E {\n' +
        '  case A(x: i32)\n' +
        '  case B\n' +
        '}\n' +
        'let f = (e: E): i32 => match (e) {\n' +
        '  case A {x}: x\n' +
        '  case B: 2\n' +
        '};\n' +
        'export let main = (): i32 => f(new A(40)) + f(new B());');
    isTrue(sealedResult.contains('unreachable'));
  });

  test('interface packing and vtable dispatch', (ctx: TestContext): void => {
    // Structural: multi-function modules are discovery-order sensitive.
    let result = compileWithZir(
        'interface Greeter { greet(): i32; }\n' +
        'class Loud implements Greeter {\n' +
        '  volume: i32;\n' +
        '  new(this.volume);\n' +
        '  greet(): i32 { return this.volume * 2; }\n' +
        '}\n' +
        'let run = (g: Greeter): i32 => g.greet();\n' +
        'export let main = (): i32 => {\n' +
        '  let loud = new Loud(21);\n' +
        '  return run(loud);\n' +
        '};');
    // Packing: vtable global + fat-pointer struct.new at the call site.
    isTrue(result.contains('global.get'));
    isTrue(result.contains('struct.new'));
    // Dispatch: the vtable slot is signature-typed, so the loaded
    // funcref feeds call_ref directly (no ref.cast needed).
    isTrue(result.contains('call_ref'));
  });

  test('field shadowed by subclass accessor uses the getter', (ctx: TestContext): void => {
    // Regression: a subclass redefining an inherited physical field as
    // an accessor must dispatch through the getter, not struct.get the
    // parent's field (classes/super-fields.zena caught this).
    let result = compileWithZir(
        'class Base { x: i32; new(this.x); }\n' +
        'final class Derived extends Base {\n' +
        '  new(x: i32) : super(x);\n' +
        '  x: i32 {\n' +
        '    get {\n' +
        '      return 99;\n' +
        '    }\n' +
        '  }\n' +
        '}\n' +
        'export let main = (): i32 => {\n' +
        '  let d = new Derived(13);\n' +
        '  return d.x;\n' +
        '};');
    // The read must call the accessor.
    isTrue(result.contains('call $Derived.get#x') ||
        result.contains('get#x'));
  });

  test('calls through closure-typed values', (ctx: TestContext): void => {
    // Structural: multi-function modules are discovery-order sensitive.
    let result = compileWithZir(
        'let apply = (f: (x: i32) => i32, v: i32): i32 => f(v);\n' +
        'let double = (x: i32): i32 => x * 2;\n' +
        'export let main = (): i32 => apply(double, 21);');
    // The closure call unpacks ctx + func and call_refs the impl sig.
    isTrue(result.contains('call_ref'));
    isTrue(result.contains('(func $apply'));
  });

  test('closure creation with by-value captures', (ctx: TestContext): void => {
    // Structural: multi-function modules are discovery-order sensitive.
    let result = compileWithZir(
        'let make = (k: i32): ((x: i32) => i32) => {\n' +
        '  let f = (x: i32): i32 => x + k;\n' +
        '  return f;\n' +
        '};\n' +
        'export let main = (): i32 => {\n' +
        '  let add5 = make(5);\n' +
        '  return add5(4);\n' +
        '};');
    // Creation: ref.func + context struct.new + closure pair struct.new.
    isTrue(result.contains('ref.func'));
    isTrue(result.contains('struct.new'));
    // The call side goes through call_ref.
    isTrue(result.contains('call_ref'));
  });

  test('zir output contains the lowered function', (ctx: TestContext): void => {
    // Cheap structural sanity independent of snapshots: the ZIR-lowered
    // function is emitted (every value a local, so at least one local).
    let result = compileWithZir('export let main = (): i32 => 1 + 2;');
    isTrue(result.contains('(func $main'));
  });

  test('simplify folds constant arithmetic', (ctx: TestContext): void => {
    let result = compileWithZir(
        'export let main = (): i32 => { let a = 6; let b = 7; return a * b + 3; };');
    let present = new GrowableArray<String>();
    present.push('i32.const 45');
    assertFunctionUses(result, '$main', present,
        'constant multiply-add folds to one constant');
    let absent = new GrowableArray<String>();
    absent.push('i32.mul');
    absent.push('i32.add');
    assertFunctionOmits(result, '$main', absent,
        'folded arithmetic leaves no arithmetic behind');
  });

  test('simplify folds a constant chain across widths', (ctx: TestContext): void => {
    // i64 multiply of constants folds, and the wrap of the folded
    // constant folds after it — one forward pass cascades because
    // operand ids precede use ids.
    let result = compileWithZir(
        'export let main = (): i32 => {\n' +
        '  let a = 6 as i64;\n' +
        '  let b = 7 as i64;\n' +
        '  return (a * b) as i32;\n' +
        '};');
    let present = new GrowableArray<String>();
    present.push('i32.const 42');
    assertFunctionUses(result, '$main', present,
        'the i64 product wraps to a folded i32 constant');
    let absent = new GrowableArray<String>();
    absent.push('i64.mul');
    absent.push('i32.wrap_i64');
    assertFunctionOmits(result, '$main', absent,
        'both the multiply and the wrap fold away');
  });

  test('simplify removes additive identity', (ctx: TestContext): void => {
    let result = compileWithZir(
        'let f = (x: i32): i32 => x + 0;\n' +
        'export let main = (): i32 => f(21);');
    let absent = new GrowableArray<String>();
    absent.push('i32.add');
    assertFunctionOmits(result, '$f', absent,
        'x + 0 is x; no add survives');
  });

  test('simplify strength-reduces multiply by a power of two', (ctx: TestContext): void => {
    let result = compileWithZir(
        'let f = (x: i32): i32 => x * 8;\n' +
        'export let main = (): i32 => f(5);');
    let present = new GrowableArray<String>();
    present.push('i32.shl');
    assertFunctionUses(result, '$f', present,
        'x * 8 becomes x << 3');
    let absent = new GrowableArray<String>();
    absent.push('i32.mul');
    assertFunctionOmits(result, '$f', absent,
        'the multiply is replaced, not kept alongside');
  });

  test('simplify folds self-cancelling xor', (ctx: TestContext): void => {
    let result = compileWithZir(
        'let f = (x: i32): i32 => x ^ x;\n' +
        'export let main = (): i32 => f(21);');
    let absent = new GrowableArray<String>();
    absent.push('i32.xor');
    assertFunctionOmits(result, '$f', absent,
        'x ^ x is 0 regardless of x');
  });

  test('branch folding removes the untaken side entirely', (ctx: TestContext): void => {
    // The condition folds to a constant, the br_if folds to a br, and
    // block cleanup deletes the stranded alternative — its constant
    // must not survive anywhere in the function.
    let result = compileWithZir(
        'export let main = (): i32 => { if (1 < 2) { return 10; } return 20; };');
    let present = new GrowableArray<String>();
    present.push('i32.const 10');
    assertFunctionUses(result, '$main', present,
        'the taken side is still there');
    let absent = new GrowableArray<String>();
    absent.push('i32.const 20');
    absent.push('br_if');
    assertFunctionOmits(result, '$main', absent,
        'a constant-true condition leaves neither a branch nor the untaken side');
  });

  test('dce removes an unused pure computation', (ctx: TestContext): void => {
    let result = compileWithZir(
        'let f = (x: i32): i32 => { var a = x * 3; a = x; return a; };\n' +
        'export let main = (): i32 => f(21);');
    let absent = new GrowableArray<String>();
    absent.push('i32.mul');
    assertFunctionOmits(result, '$f', absent,
        'the overwritten x * 3 is dead and pure, so it goes');
  });

  test('dce removes an unused tuple allocation', (ctx: TestContext): void => {
    let result = compileWithZir(
        'let f = (x: i32): i32 => { let t = (x, x + 1); return x; };\n' +
        'export let main = (): i32 => f(21);');
    assertNoAllocation(result, '$f',
        'an unused, non-escaping tuple never allocates');
  });

  test('dce keeps an unused division that could trap', (ctx: TestContext): void => {
    let result = compileWithZir(
        'let f = (x: i32, y: i32): i32 => { var a = x % y; a = x; return a; };\n' +
        'export let main = (): i32 => f(21, 2);');
    let present = new GrowableArray<String>();
    present.push('i32.rem_s');
    assertFunctionUses(result, '$f', present,
        'x % y traps when y is zero; dead or not, it must run');
  });

  test('simplify leaves division by a constant zero to trap', (ctx: TestContext): void => {
    // % lowers to i32.rem_s, which traps on a zero divisor. The
    // simplifier must not fold or delete it — the trap is the
    // program's runtime behavior, in its original position.
    let result = compileWithZir(
        'export let main = (): i32 => { let a = 7; let b = 0; return a % b; };');
    let present = new GrowableArray<String>();
    present.push('i32.rem_s');
    assertFunctionUses(result, '$main', present,
        'a trapping division survives simplification untouched');
  });
});
