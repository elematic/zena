import { dedentRaw, growable } from 'zena:core';
import { suite, test, TestContext } from 'zena:test';
import { equal, isTrue, fail } from 'zena:assert';
import { WatGenerator } from '../lib/codegen/wat-generator.zena';
import { Program, CompilationUnit } from '../lib/program.zena';
import { readFileSync, writeFileSync, existsSync, mkdirSync } from 'zena:fs';
import {
  makeCompiler, makeStdlibCompiler, MockHost, PlainHost, errorDiagnostics,
} from './test-utils.zena';
import {
  assertFunctionOmits, assertFunctionUses, assertFunctionUsesTimes,
  assertNoAllocation, watFunction,
} from './wat-invariants.zena';
import { checkCompilation } from '../lib/compiler.zena';
import { getEnv } from 'zena:cli';

function assertSnapshot(name: String, content: String) {
  let snapDir = 'packages/zena-compiler/test-files/snapshots';
  if (!existsSync(snapDir)) {
    mkdirSync(snapDir);
  }
  let snapFile = `${snapDir}/${name}.snap`;
  if (getEnv("UPDATE_SNAPSHOTS") != null) {
    writeFileSync(snapFile, content);
    equal(content, content);
  } else if (existsSync(snapFile)) {
    let expected = readFileSync(snapFile);
    equal(content, expected);
  } else {
    writeFileSync(snapFile, content);
    equal(content, content);
  }
}

function compileWithZir(source: String) {
  return compileWithZirAt(source, 1);
}

function compileWithZirAt(source: String, optLevel: i32): String {
  let host = new MockHost();
  host.addFile("test.zena", source);

  let compiler = makeCompiler(host);
  let compResult = compiler.compile({entry: "test.zena", target: 'js'});
  let checkRes = checkCompilation(compResult);

  let entryAst = compResult.entry.ast;
  let units = new Array<CompilationUnit>();
  var entryUnit: CompilationUnit | null = null;

  for (let file in compResult.files) {
    if (!file.isStdlib) {
      let res = checkRes.results[file.path];
      if (res != null) {
        let unit = {ast: file.ast, model: res.model};
        units.push(unit);
        if (file.ast.path == entryAst.path) {
          entryUnit = unit;
        }
      }
    }
  }

  let program = new Program(units, entryUnit);
  let generator = new WatGenerator("freestanding", false, optLevel);
  return generator.generate(program);
}

/**
 * Compile `source` against the real standard library on disk and pass
 * every checked unit to `Program`, for WAT tests that use `String` or
 * other standard library types.
 */
function compileWithZirStdlib(source: String) {
  return compileWithZirStdlibAt(source, 1);
}

function compileWithZirStdlibAt(source: String, optLevel: i32): String {
  let host = new PlainHost();
  host.addFile("test.zena", source);

  let compiler = makeStdlibCompiler(host);
  let compResult = compiler.compile({entry: "test.zena", target: 'freestanding'});
  let checkRes = checkCompilation(compResult);
  let errors = errorDiagnostics(checkRes.diagnostics);
  if (errors.length > 0) {
    throw new Error(`the fixture does not compile: ${errors[0].message}`);
  }

  let entryAst = compResult.entry.ast;
  let units = new Array<CompilationUnit>();
  var entryUnit: CompilationUnit | null = null;

  for (let file in compResult.files) {
    let res = checkRes.results[file.path];
    if (res != null) {
      let unit = {ast: file.ast, model: res.model};
      units.push(unit);
      if (file.ast.path == entryAst.path) {
        entryUnit = unit;
      }
    }
  }

  let program = new Program(units, entryUnit);
  let generator = new WatGenerator("freestanding", false, optLevel);
  generator.interner = checkRes.sharedState.interner;
  return generator.generate(program);
}

export let tests = suite('zir backend', () => {
  test('straight-line arithmetic function', (ctx) => {
    let result = compileWithZir(
        'export let main = (): i32 => { let a = 6; let b = 7; return a * b; };');
    assertSnapshot('zir_straight_line', result);
  });

  test('if/else with merged assignment', (ctx) => {
    let result = compileWithZir(dedentRaw`
        export let main = (): i32 => {
          var r = 0;
          let x = 4;
          if (x % 2 == 0) {
            r = x * 2;
          } else {
            r = x + 1;
          }
          return r;
        };
        `);
    assertSnapshot('zir_if_else_merge', result);
  });

  test('try/catch keeps an assigned local off the heap', (ctx) => {
    // A try body that assigns an enclosing local needs storage the
    // handler can read, because the protected edge carries only the
    // values live at try entry. That storage is a wasm local — a
    // mutable variable, ir.md §5.1.1 — and specifically NOT a heap
    // cell: writing a `try` must not silently start allocating.
    let result = compileWithZir(dedentRaw`
        export let main = (): i32 => {
          var n = 0;
          try {
            n = 7;
          } catch {
            n = 0 - 1;
          }
          return n;
        };
        `);
    let usesTry = growable<String>(['try_table']);
    assertFunctionUses(result, '$main', usesTry,
        'the fixture is supposed to compile a protected region');
    assertNoAllocation(result, '$main',
        'a try-assigned local is mirrored into a wasm local, not boxed');
    assertSnapshot('zir_try_local_mirror', result);
  });

  test('a finalizer is emitted once for every way out of the try', (ctx) => {
    // Four exits leave this region — the body's normal completion, the
    // `return`, the `break`, and the exception the handler edge
    // catches — and each of them owes the finalizer. They are routed
    // through ONE copy of it rather than getting a copy each: the
    // marker constant appears exactly once. Emitting a copy per edge
    // would also be wrong, not just fat, because the copy on the
    // normal path would sit INSIDE the protected region and rerun
    // itself if it threw.
    let result = compileWithZir(dedentRaw`
        export let main = (): i32 => {
          var n = 0;
          var i = 0;
          while (i < 3) {
            i += 1;
            try {
              if (i == 1) { break; }
              if (i == 2) { return 5; }
              n += 1;
            } finally {
              n += 987654;
            }
          }
          return n;
        };
        `);
    let usesTry = growable<String>(['try_table']);
    assertFunctionUses(result, '$main', usesTry,
        'the fixture is supposed to compile a protected region');
    assertFunctionUsesTimes(result, '$main', 'i32.const 987654', 1,
        'every exit out of a finally region runs one shared copy of ' +
        'the finalizer');
    assertNoAllocation(result, '$main',
        'a finally region parks its exit in wasm locals, not on the heap');
    assertSnapshot('zir_try_finally', result);
  });

  test('while loop with break and continue', (ctx) => {
    let result = compileWithZir(dedentRaw`
        export let main = (): i32 => {
          var acc = 0;
          var i = 0;
          while (i < 10) {
            i += 1;
            if (i == 3) {
              continue;
            }
            if (i == 7) {
              break;
            }
            acc += i;
          }
          return acc;
        };
        `);
    assertSnapshot('zir_while_break_continue', result);
  });

  test('short-circuit logic chains', (ctx) => {
    let result = compileWithZir(dedentRaw`
        let f = (x: i32, y: i32): boolean => x > 0 && y > 0 || x == -1;
        export let main = (): i32 => if (f(1, 2)) 1 else 0;
        `);
    assertSnapshot('zir_short_circuit', result);
  });

  test('direct calls, recursion, and mutual recursion', (ctx) => {
    // Structural assertions rather than a full-module snapshot: function
    // ORDER in the module depends on discovery worklist order, which
    // shifts with process-global symbol/uid counters whenever unrelated
    // compiler code changes — a multi-function snapshot would churn on
    // every compiler edit. (Single-function snapshots above are stable.)
    let result = compileWithZir(dedentRaw`
        let add = (a: i32, b: i32): i32 => a + b;
        let fib = (n: i32): i32 => {
          if (n < 2) {
            return n;
          }
          return fib(n - 1) + fib(n - 2);
        };
        let isEven = (n: i32): boolean => {
          if (n == 0) { return true; }
          return isOdd(n - 1);
        };
        let isOdd = (n: i32): boolean => {
          if (n == 0) { return false; }
          return isEven(n - 1);
        };
        export let main = (): i32 => add(fib(10), if (isEven(4)) 1 else 0);
        `);
    // Self-recursion and mutual recursion emit direct calls.
    isTrue(result.contains('call $fib'));
    isTrue(result.contains('call $isOdd'));
    isTrue(result.contains('call $isEven'));
    isTrue(result.contains('call $add'));
    // The bodies came from the ZIR emitter (every value a local), not the
    // streaming generator: fib's compare materializes into a local before
    // the branch instead of feeding an if directly off the stack.
    isTrue(result.contains('(func $fib'));
  });

  test('if expression with value blocks', (ctx) => {
    let result = compileWithZir(dedentRaw`
        export let main = (): i32 => {
          let n = -200;
          let kind = if (n < 0) {
            let mag = -n;
            if (mag > 100) 3 else 1;
          } else if (n == 0) {
            0;
          } else {
            2;
          };
          return kind;
        };
        `);
    assertSnapshot('zir_if_expression', result);
  });

  test('c-style for loop with break and continue', (ctx) => {
    let result = compileWithZir(dedentRaw`
        export let main = (): i32 => {
          var acc = 0;
          for (var i = 0; i < 10; i += 1) {
            if (i == 2) { continue; }
            if (i == 7) { break; }
            acc += i;
          }
          return acc;
        };
        `);
    assertSnapshot('zir_for_loop', result);
  });

  test('scalar casts', (ctx) => {
    let result = compileWithZir(dedentRaw`
        export let main = (): i32 => {
          let x = 10;
          let d = x as f64;
          let half = d / 2.0;
          let wide = x as i64;
          return (half as i32) + ((wide * (3 as i64)) as i32);
        };
        `);
    assertSnapshot('zir_scalar_casts', result);
  });

  test('unsigned operators select _u variants', (ctx) => {
    // Structural (not snapshot): multi-function modules are
    // discovery-order sensitive.
    let result = compileWithZir(dedentRaw`
        let umod = (a: u32, b: u32): u32 => a % b;
        let ucompare = (a: u32, b: u32): boolean => a > b;
        export let main = (): i32 => {
          let big = (-1294967296) as u32;
          if (ucompare(big, 2000000000 as u32)) { return umod(big, 7 as u32) as i32; }
          return 0;
        };
        `);
    isTrue(result.contains('i32.rem_u'));
    isTrue(result.contains('i32.gt_u'));
  });

  test('reference plumbing: null tests, narrowing, identity', (ctx) => {
    // Structural: multi-function modules are discovery-order sensitive.
    // A local class supplies the reference type (the MockHost harness has
    // no stdlib, so String is unavailable here); string-literal lowering
    // is covered by the portable execution suite under ZENA_BACKEND=zir.
    let result = compileWithZir(dedentRaw`
        class Box { x: i32; new(this.x); }
        let pick = (primary: Box | null, fallback: Box): Box => {
          if (primary != null) {
            return primary;
          }
          return fallback;
        };
        let same = (a: Box, b: Box): boolean => a === b;
        export let main = (): i32 => {
          let b = new Box(1);
          if (same(pick(null, b), b)) { return 1; }
          return 0;
        };
        `);
    isTrue(result.contains('ref.is_null'));
    isTrue(result.contains('ref.eq'));
    // The narrowed `return primary` re-asserts non-nullness.
    isTrue(result.contains('ref.as_non_null'));
  });

  test('entry-defined ref local graduates non-null past a join', (ctx) => {
    // The entry block's own code emits BEFORE the join's wrapper block
    // opens, so its set persists through the whole function and the
    // local can be declared at its precise non-null type — reads after
    // the join then need no ref.as_non_null re-assert. Under the old
    // block-0 gate any merge child under the entry blocked graduation.
    // At -O0, so the constant branch and its join survive to emission:
    // the cleanup passes fold the branch and fuse the blocks, leaving
    // no join and no local at all.
    let result = compileWithZirAt(dedentRaw`
        class Box { x: i32; new(this.x); }
        export let main = (): i32 => {
          let b = new Box(3);
          var acc = 7;
          if (acc > 1) { acc = 1; } else { acc = 2; }
          return acc + b.x;
        };
        `, 0);
    let mainWat = watFunction(result, '$main');
    isTrue(mainWat.contains('(local (ref '));
    isTrue(!mainWat.contains('(local (ref null'));
    isTrue(!mainWat.contains('ref.as_non_null'));
  });

  test('conditional-join value keeps its nullable local', (ctx) => {
    // A join param is written on the arms' edges, INSIDE the if/else
    // scopes — the validator forgets both sets at the join (rollback is
    // uniform even when every arm assigns), so the init replay must
    // keep the local nullable and re-assert on the read.
    let result = compileWithZir(dedentRaw`
        class Box { x: i32; new(this.x); }
        let pickBox = (c: boolean): i32 => {
          let b = if (c) new Box(1) else new Box(2);
          return b.x;
        };
        export let main = (): i32 => pickBox(true);
        `);
    let pickWat = watFunction(result, '$pickBox');
    isTrue(pickWat.contains('(local (ref null'));
    isTrue(pickWat.contains('ref.as_non_null'));
  });

  test('new, field reads, and devirtualized method calls', (ctx) => {
    // Structural: multi-function modules are discovery-order sensitive.
    let result = compileWithZir(dedentRaw`
        final class Point {
          x: i32;
          y: i32;
          new(this.x, this.y);
          manhattan(): i32 { return this.x + this.y; }
        }
        let measure = (p: Point): i32 => p.manhattan() + p.x;
        export let main = (): i32 => measure(new Point(1, 2));
        `);
    // Construction is a single-shot struct.new inside the factory
    // (non-nullable-refs.md) — no struct.new_default shell remains.
    isTrue(result.contains('struct.new'));
    isTrue(!result.contains('struct.new_default'));
    isTrue(result.contains('struct.get'));
    isTrue(result.contains('call $Point'));
  });

  test('constructor prologue: defaults, this params, super', (ctx) => {
    // Structural: multi-function modules are discovery-order sensitive.
    let result = compileWithZir(dedentRaw`
        class Base { tag: i32; new(this.tag); }
        final class Derived extends Base {
          var extra: i32 = 7;
          new(t: i32) : super(t) {
            this.extra += t;
          }
        }
        export let main = (): i32 => {
          let d = new Derived(3);
          return d.tag + d.extra;
        };
        `);
    // Derived's factory drives Base through its value phase and
    // allocates with one struct.new; the body's `this.extra += t`
    // is the surviving struct.set.
    isTrue(result.contains('call $Base'));
    isTrue(result.contains('<ctor-init>'));
    isTrue(result.contains('struct.new'));
    isTrue(!result.contains('struct.new_default'));
    isTrue(result.contains('struct.set'));
  });

  test('non-null let fields are immutable and read without re-asserts', (ctx) => {
    // Field types are precise (non-nullable-refs.md): a `let` field of
    // non-null class type declares `(field (ref $T))` — immutable, no
    // null — while a `T | null` field stays nullable, and a reader
    // needs no ref.as_non_null after struct.get.
    let result = compileWithZir(dedentRaw`
        class Box { x: i32; new(this.x); }
        class Holder {
          b: Box;
          var maybe: Box | null = null;
          new(this.b);
        }
        // maybe is read too, or dead-field elimination deletes it.
        let read = (h: Holder): i32 => h.b.x + (if (h.maybe == null) 0 else 1);
        export let main = (): i32 => read(new Holder(new Box(5)));
        `);
    isTrue(result.contains('(field (ref '));
    isTrue(result.contains('(field (mut (ref null'));
    let readWat = watFunction(result, '$read');
    isTrue(!readWat.contains('ref.as_non_null'));
  });

  test('scalar match with literals, or-patterns, and guards', (ctx) => {
    let result = compileWithZir(dedentRaw`
        export let main = (): i32 => {
          let x = 5;
          return match (x) {
            case 0: 10
            case 1 | 2: 20
            case let n if (n > 4): 30
            case _: 40
          };
        };
        `);
    assertSnapshot('zir_match_scalar', result);
  });

  test('match with class patterns and as-bindings', (ctx) => {
    // Structural: multi-function modules are discovery-order sensitive.
    let result = compileWithZir(dedentRaw`
        class Base { tag: i32; new(this.tag); }
        final class One extends Base {
          extra: i32;
          new(t: i32, this.extra) : super(t);
        }
        let pick = (b: Base): i32 => match (b) {
          case One as o: o.extra
          case _: b.tag
        };
        export let main = (): i32 => {
          let one = new One(1, 5);
          let base = new Base(9);
          return pick(one) + pick(base);
        };
        `);
    // The type test and the guarded downcast for the as-binding.
    isTrue(result.contains('ref.test'));
    isTrue(result.contains('ref.cast'));
    // This match has a wildcard arm, so it HAS no impossible path —
    // the old `unreachable` assertion here was matching the
    // function-tail filler, which outermost-return fall-through
    // removed. The genuinely-impossible no-match path is asserted on
    // an exhaustive sealed match, whose trap sits mid-block:
    let sealedResult = compileWithZir(dedentRaw`
        sealed class E {
          case A(x: i32)
          case B
        }
        let f = (e: E): i32 => match (e) {
          case A {x}: x
          case B: 2
        };
        export let main = (): i32 => f(new A(40)) + f(new B());
        `);
    isTrue(sealedResult.contains('unreachable'));
  });

  test('interface packing and vtable dispatch', (ctx) => {
    // Structural: multi-function modules are discovery-order sensitive.
    let result = compileWithZir(dedentRaw`
        interface Greeter { greet(): i32; }
        class Loud implements Greeter {
          volume: i32;
          new(this.volume);
          greet(): i32 { return this.volume * 2; }
        }
        let run = (g: Greeter): i32 => g.greet();
        export let main = (): i32 => {
          let loud = new Loud(21);
          return run(loud);
        };
        `);
    // Packing: vtable global + fat-pointer struct.new at the call site.
    isTrue(result.contains('global.get'));
    isTrue(result.contains('struct.new'));
    // Dispatch: the vtable slot is signature-typed, so the loaded
    // funcref feeds call_ref directly (no ref.cast needed).
    isTrue(result.contains('call_ref'));
  });

  test('field shadowed by subclass accessor uses the getter', (ctx) => {
    // Regression: a subclass redefining an inherited physical field as
    // an accessor must dispatch through the getter, not struct.get the
    // parent's field (classes/super-fields.zena caught this).
    let result = compileWithZir(dedentRaw`
        class Base { x: i32; new(this.x); }
        final class Derived extends Base {
          new(x: i32) : super(x);
          x: i32 {
            get {
              return 99;
            }
          }
        }
        export let main = (): i32 => {
          let d = new Derived(13);
          return d.x;
        };
        `);
    // The read must call the accessor.
    isTrue(result.contains('call $Derived.get#x') ||
        result.contains('get#x'));
  });

  test('calls through closure-typed values', (ctx) => {
    // Structural: multi-function modules are discovery-order sensitive.
    let result = compileWithZir(dedentRaw`
        let apply = (f: (x: i32) => i32, v: i32): i32 => f(v);
        let double = (x: i32): i32 => x * 2;
        export let main = (): i32 => apply(double, 21);
        `);
    // The closure call unpacks ctx + func and call_refs the impl sig.
    isTrue(result.contains('call_ref'));
    isTrue(result.contains('(func $apply'));
  });

  test('closure creation with by-value captures', (ctx) => {
    // Structural: multi-function modules are discovery-order sensitive.
    let result = compileWithZir(dedentRaw`
        let make = (k: i32): ((x: i32) => i32) => {
          let f = (x: i32): i32 => x + k;
          return f;
        };
        export let main = (): i32 => {
          let add5 = make(5);
          return add5(4);
        };
        `);
    // Creation: ref.func + context struct.new + closure pair struct.new.
    isTrue(result.contains('ref.func'));
    isTrue(result.contains('struct.new'));
    // The call side goes through call_ref.
    isTrue(result.contains('call_ref'));
  });

  test('zir output contains the lowered function', (ctx) => {
    // Cheap structural sanity independent of snapshots: the ZIR-lowered
    // function is emitted (every value a local, so at least one local).
    let result = compileWithZir('export let main = (): i32 => 1 + 2;');
    isTrue(result.contains('(func $main'));
  });

  test('-O2 inlines a trivial call chain to a constant', (ctx) => {
    // main calls f calls inc; the rounds inline the chain and the
    // cleanup passes fold what remains, so main is one constant.
    let result = compileWithZirAt(dedentRaw`
        let inc = (x: i32): i32 => x + 1;
        let f = (y: i32): i32 => inc(y);
        export let main = (): i32 => f(20);
        `, 2);
    let present = growable<String>(['i32.const 21']);
    assertFunctionUses(result, '$main', present,
        'the inlined chain folds to its value');
    let absent = growable<String>(['call ']);
    assertFunctionOmits(result, '$main', absent,
        'no call survives inlining the chain');
  });

  test('-O2 inlines a private method into its caller', (ctx) => {
    let result = compileWithZirAt(dedentRaw`
        class P {
          #x: i32 = 7;
          #twice(): i32 { return this.#x + this.#x; }
          sum(): i32 { return this.#twice() + 1; }
        }
        let f = (p: P): i32 => p.sum();
        export let main = (): i32 => f(new P());
        `, 2);
    // Nothing dispatches on P, so sum and #twice are direct calls that
    // inline all the way into main, and harvest then deletes both.
    let absent = growable<String>(['call ']);
    assertFunctionOmits(result, '$main', absent,
        'the method and its private helper are inlined into main');
    isTrue(!result.contains('.sum'),
        'the fully inlined method is deleted from the module');
  });

  test('-O2 devirtualizes an interface call with one implementer', (ctx) => {
    // Only Circle is ever packed as Shape, so every Shape vtable global
    // installs Circle.area in the slot: the call_ref becomes a direct
    // call, and the dead slot-load chain folds and dies.
    let result = compileWithZirAt(dedentRaw`
        interface Shape { area(): i32; }
        class Circle implements Shape {
          r: i32;
          new(this.r);
          area(): i32 { return this.r * this.r; }
        }
        export let measure = (s: Shape): i32 => s.area();
        export let main = (): i32 => measure(new Circle(3));
        `, 2);
    let absent = growable<String>(['call_ref']);
    assertFunctionOmits(result, '$measure', absent,
        'a single-implementer interface slot dispatches directly');
  });

  test('-O2 keeps an interface call with two implementers indirect', (ctx) => {
    let result = compileWithZirAt(dedentRaw`
        interface Shape { area(): i32; }
        class Circle implements Shape {
          r: i32;
          new(this.r);
          area(): i32 { return this.r * this.r; }
        }
        class Square implements Shape {
          s: i32;
          new(this.s);
          area(): i32 { return this.s * 4; }
        }
        export let measure = (s: Shape): i32 => s.area();
        export let main = (): i32 => measure(new Circle(3)) + measure(new Square(2));
        `, 2);
    let present = growable<String>(['call_ref']);
    assertFunctionUses(result, '$measure', present,
        'two live implementers keep the slot dynamic');
  });

  test('-O2 devirtualizes through a visible fat-pointer pack', (ctx) => {
    // Two implementers exist, but each dispatch site packs its own
    // concrete object, so provenance resolves both without the
    // hierarchy rule.
    let result = compileWithZirAt(dedentRaw`
        interface Shape { area(): i32; }
        class Circle implements Shape {
          r: i32;
          new(this.r);
          area(): i32 { return this.r * this.r; }
        }
        class Square implements Shape {
          s: i32;
          new(this.s);
          area(): i32 { return this.s * 4; }
        }
        export let main = (): i32 => {
          let a: Shape = new Circle(3);
          let b: Shape = new Square(2);
          return a.area() + b.area();
        };
        `, 2);
    let absent = growable<String>(['call_ref']);
    assertFunctionOmits(result, '$main', absent,
        'a pack visible at the dispatch site names the implementation');
  });

  test('an unescaping tuple is scalar-replaced', (ctx) => {
    // Both element reads forward to the tuple's operands, so the
    // allocation has no uses left and DCE deletes it. Level 1: this is
    // per-function forwarding, not the module loop.
    let result = compileWithZir(dedentRaw`
        let f = (x: i32): i32 => { let t = (x, x + 1); let (a, b) = t; return a * b; };
        export let main = (): i32 => f(21);
        `);
    assertNoAllocation(result, '$f',
        'reads off a fresh immutable allocation forward to its operands');
  });

  test('a record literal argument is passed as its fields', (ctx) => {
    // Argument explosion (ir/explode.zena) at level 1, where nothing
    // inlines: `f` only reads fields of its record parameter, so `main`
    // calls `f.core` with the literals' field values, omitted optional
    // included, and the core reads them as parameters.
    let result = compileWithZir(dedentRaw`
        type Opts = {a: i32, b?: i32};
        let f = (o: Opts): i32 => o.a * (o.b ?? 2);
        export let main = (): i32 => f({a: 3}) + f({b: 4, a: 5});
        `);
    assertNoAllocation(result, '$main',
        'a record literal argument is never built');
    let coreCall = growable<String>(['call $f.core']);
    assertFunctionUses(result, '$main', coreCall,
        'a call passing a literal goes to the core');
    let absent = growable<String>(['call_ref']);
    assertFunctionOmits(result, '$f.core', absent,
        'the core reads fields from its parameters, not through getters');
    assertNoAllocation(result, '$f.core',
        'the record the core rebuilds for its parameter has no uses');
  });

  test('a record value argument goes through the forwarder', (ctx) => {
    // `g` is only ever given a record from the heap, so it passes that
    // record to `f` itself, whose body reads the fields and calls the
    // core.
    let result = compileWithZir(dedentRaw`
        type Opts = {a: i32, b?: i32};
        let f = (o: Opts): i32 => o.a * (o.b ?? 2);
        let g = (o: Opts): i32 => f(o) + 1;
        export let main = (): i32 => {
          let held: Opts = {a: 5};
          return f({a: 3}) + g(held);
        };
        `);
    let forwarded = growable<String>(['call $f']);
    assertFunctionUses(result, '$g', forwarded,
        'a record value is passed to the forwarder');
    let coreCall = growable<String>(['call $f.core']);
    assertFunctionOmits(result, '$g', coreCall,
        'only a literal argument can be passed as fields');
    assertFunctionUses(result, '$f', coreCall,
        'the forwarder calls the core');
  });

  test('a record passed on whole stays as its fields', (ctx) => {
    // `outer` passes its record to `inner`, which only reads fields, so
    // `outer` only needs the fields too. The literal is never built:
    // `main` calls `outer.core`, which calls `inner.core` with the
    // fields it was given, and neither core rebuilds the record.
    let result = compileWithZir(dedentRaw`
        type Opts = {a: i32, b?: i32};
        let inner = (o: Opts): i32 => o.a * (o.b ?? 2);
        let outer = (o: Opts): i32 => inner(o) + o.a;
        export let main = (): i32 => outer({a: 3});
        `);
    assertNoAllocation(result, '$main',
        'the literal enters the chain as fields');
    let innerCore = growable<String>(['call $inner.core']);
    assertFunctionUses(result, '$outer.core', innerCore,
        'a forwarded field-only record is passed as its fields');
    assertNoAllocation(result, '$outer.core',
        'the forwarded record is never rebuilt');
    let absent = growable<String>(['call_ref']);
    assertFunctionOmits(result, '$outer.core', absent,
        'no getter dispatch on the forwarded record');
  });

  test('a record literal passed to a constructor is passed as its fields', (ctx) => {
    // The named-arguments idiom for a class: `P`'s constructor only reads
    // fields of its record parameter, so `new P({x: 3})` calls the
    // factory's core with the fields and builds no record.
    let result = compileWithZir(dedentRaw`
        type Init = {x: i32, y?: i32};
        final class P {
          x: i32;
          y: i32;
          new(init: Init) : x = init.x, y = init.y ?? 7;
        }
        export let main = (): i32 => {
          let p = new P({x: 3});
          return p.x + p.y;
        };
        `);
    assertNoAllocation(result, '$main',
        'the record literal is never built; the core allocates P');
    var core = '';
    for (let chunk in result.split('(func $')) {
      let name = chunk.split(' ')[0];
      if (name.endsWith('<constructor>.core')) {
        core = '$' + name;
      }
    }
    isTrue(core.length > 0, 'the constructor has a core');
    let absent = growable<String>(['call_ref']);
    assertFunctionOmits(result, core, absent,
        'the core reads the fields from its parameters');
  });

  test('a record passed to super(...) is passed as its fields', (ctx) => {
    // `Base` only reads fields of its record, so its phase functions
    // take the fields too: `Sub`'s literal and `Pass`'s own exploded
    // parameter reach `Base` without a record being built. Each
    // constructor allocates only its instance.
    let result = compileWithZir(dedentRaw`
        type Init = {x: i32, y?: i32};
        class Base {
          x: i32;
          y: i32;
          new(init: Init) : x = init.x, y = init.y ?? 7;
        }
        final class Sub extends Base {
          z: i32;
          new(z: i32) : z = z, super({x: z});
        }
        final class Pass extends Base {
          new(init: Init) : super(init);
        }
        export let main = (): i32 => {
          let s = new Sub(3);
          let p = new Pass({x: 4});
          return s.y + p.x;
        };
        `);
    let named = (prefix: String, suffix: String) => {
      var found = '';
      for (let chunk in result.split('(func $')) {
        let name = chunk.split(' ')[0];
        if (name.startsWith(prefix) && name.endsWith(suffix)) {
          found = '$' + name;
        }
      }
      isTrue(found.length > 0, `no function ${prefix}…${suffix}`);
      return found;
    };
    assertNoAllocation(result, '$main', 'both records arrive as fields');
    assertFunctionUsesTimes(result, named('Sub_', '<constructor>'),
        'struct.new', 1, 'the literal passed to super is never built');
    assertFunctionUsesTimes(result, named('Pass_', '<constructor>.core'),
        'struct.new', 1, 'a record passed on to super is never rebuilt');
  });

  test('a record passed to a named constructor is passed as its fields', (ctx) => {
    // Named constructors explode like the unnamed one: `new Base.from`
    // with a literal, a subclass's `super.from(...)` with a literal, and
    // a named constructor passing its own record up to `super.from`.
    let result = compileWithZir(dedentRaw`
        type Init = {x: i32, y?: i32};
        class Base {
          x: i32;
          y: i32;
          new(this.x, this.y);
          new from(init: Init) : x = init.x, y = init.y ?? 7;
        }
        final class Sub extends Base {
          z: i32;
          new(z: i32) : z = z, super.from({x: z});
        }
        final class Pass extends Base {
          new relay(init: Init) : super.from(init);
        }
        export let main = (): i32 => {
          let b = new Base.from({x: 2});
          let s = new Sub(3);
          let p = new Pass.relay({x: 4});
          return b.y + s.y + p.x;
        };
        `);
    let named = (prefix: String, suffix: String) => {
      var found = '';
      for (let chunk in result.split('(func $')) {
        let name = chunk.split(' ')[0];
        if (name.startsWith(prefix) && name.endsWith(suffix)) {
          found = '$' + name;
        }
      }
      isTrue(found.length > 0, `no function ${prefix}…${suffix}`);
      return found;
    };
    assertNoAllocation(result, '$main', 'every record arrives as fields');
    assertFunctionUsesTimes(result, named('Sub_', '<constructor>'),
        'struct.new', 1, 'the literal passed to super.from is never built');
    assertFunctionUsesTimes(result, named('Pass_', '<constructor>.relay.core'),
        'struct.new', 1, 'a record passed on to super.from is never rebuilt');
  });

  test('a record passed to a generic class constructor is passed as its fields', (ctx) => {
    // Each instantiation's constructor explodes on its own: `new
    // Box<i32>` and `new Pair<f64>` with literals, whose record type
    // mentions the type parameter, and a subclass of `Box<i32>` passing
    // a literal to `super(...)`.
    let result = compileWithZir(dedentRaw`
        type Init = {x: i32, y?: i32};
        class Box<T> {
          value: T;
          x: i32;
          new(value: T, init: Init) : value = value, x = init.x;
        }
        final class Pair<T> {
          a: T;
          new(r: {a: T, b: T}) : a = r.b;
        }
        final class IntBox extends Box<i32> {
          new(v: i32) : super(v, {x: v});
        }
        export let main = (): i32 => {
          let b = new Box<i32>(1, {x: 2});
          let p = new Pair<f64>({a: 1.5, b: 2.5});
          let ib = new IntBox(3);
          return b.x + (p.a as i32) + ib.x;
        };
        `);
    let named = (prefix: String, suffix: String) => {
      var found = '';
      for (let chunk in result.split('(func $')) {
        let name = chunk.split(' ')[0];
        if (name.startsWith(prefix) && name.endsWith(suffix)) {
          found = '$' + name;
        }
      }
      isTrue(found.length > 0, `no function ${prefix}…${suffix}`);
      return found;
    };
    assertNoAllocation(result, '$main', 'every record arrives as fields');
    assertFunctionUsesTimes(result, named('IntBox_', '<constructor>'),
        'struct.new', 1, 'the literal passed to super is never built');
  });

  test('a generic function takes and returns records as fields per instantiation', (ctx) => {
    // Each specialization explodes on its own: `area<i32>` and
    // `first<f64>` take literals, `shift<i32>` returns its result's
    // fields, and `relay<i32>` passes its exploded record on to
    // `area<i32>`.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        let first = <T>(r: {a: T, b: T}): T => r.a;
        let shift = <T>(r: V, tag: T): V => ({x: r.x + 1, y: r.y + 1});
        let area = <T>(r: V, tag: T): i32 => r.x * r.y;
        let relay = <T>(r: V, tag: T): i32 => area<T>(r, tag) + 1;
        export let main = (): i32 => {
          let {x, y} = shift<i32>({x: 1, y: 2}, 0);
          return x + y + area<i32>({x: 3, y: 4}, 0) +
              (first<f64>({a: 1.5, b: 2.5}) as i32) +
              relay<i32>({x: 2, y: 3}, 0);
        };
        `);
    let forwarders = growable<String>([
      'call $shift_spec_i32\n',
      'call $area_spec_i32\n',
      'call $first_spec_f64\n',
      'call $relay_spec_i32\n',
    ]);
    assertNoAllocation(result, '$main', 'every record arrives as fields');
    assertFunctionOmits(result, '$main', forwarders,
        'each specialization is called through its core');
    assertFunctionOmits(result, '$relay_spec_i32.core', forwarders,
        'the record is passed on as its fields');
  });

  test('a generic method takes and returns records as fields per instantiation', (ctx) => {
    // Each specialization of a method's own type parameters explodes on
    // its own: `area<i32>` and `first<f64>` take literals, `shift<i32>`
    // returns its result's fields, and `relay<i32>` passes its exploded
    // record on to `area<i32>`.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        final class Grid {
          scale: i32;
          new(this.scale);
          area<T>(r: V, tag: T): i32 { return r.x * r.y * this.scale; }
          shift<T>(r: V, tag: T): V { return {x: r.x + 1, y: r.y + 1}; }
          first<T>(r: {a: T, b: T}): T { return r.a; }
          relay<T>(r: V, tag: T): i32 { return this.area<T>(r, tag) + 1; }
        }
        export let main = (): i32 => {
          let g = new Grid(2);
          let {x, y} = g.shift<i32>({x: 1, y: 2}, 0);
          return x + y + g.area<i32>({x: 3, y: 4}, 0) +
              (g.first<f64>({a: 1.5, b: 2.5}) as i32) +
              g.relay<i32>({x: 2, y: 3}, 0);
        };
        `);
    var relayCore = '';
    for (let chunk in result.split('(func $')) {
      let name = chunk.split(' ')[0];
      if (name.startsWith('Grid_') && name.endsWith('.relay_spec_i32.core')) {
        relayCore = '$' + name;
      }
    }
    isTrue(relayCore.length > 0, 'relay<i32> has a core');
    // A call to a forwarder ends its line with the specialization's
    // name; a call to a core, with `.core`.
    let forwarders = growable<String>([
      '.shift_spec_i32\n',
      '.area_spec_i32\n',
      '.first_spec_f64\n',
      '.relay_spec_i32\n',
    ]);
    assertNoAllocation(result, '$main', 'every record arrives as fields');
    assertFunctionOmits(result, '$main', forwarders,
        'each specialization is called through its core');
    assertFunctionOmits(result, relayCore, forwarders,
        'the record is passed on as its fields');
  });

  test('generators and async functions take records as fields', (ctx) => {
    // `span` and `total` take a literal as its fields, and the call in
    // `walk`'s body passes its literal to `area.core`: no record is
    // built, before or after a suspension.
    let result = compileWithZirStdlib(dedentRaw`
        import { Future } from 'zena:async';
        type V = {x: i32, y: i32};
        let area = (r: V): i32 => r.x * r.y;
        let span = gen (r: V): Iterator<i32> => {
          yield r.x;
          yield r.y;
        };
        let walk = gen (n: i32): Iterator<i32> => {
          for (var i = 0; i < n; i += 1) {
            yield area({x: i, y: 2});
          }
        };
        let total = async (r: V): Future<i32> => r.x + r.y;
        export let main = (): i32 => {
          var s = 0;
          for (let v in span({x: 3, y: 4})) {
            s += v;
          }
          for (let v in walk(3)) {
            s += v;
          }
          total({x: 1, y: 2});
          return s;
        };
        `);
    var walkNext = '';
    for (let chunk in result.split('(func $')) {
      let name = chunk.split(' ')[0];
      if (name.startsWith('walk$') && name.endsWith('$Frame.next')) {
        walkNext = '$' + name;
      }
    }
    isTrue(walkNext.length > 0, 'walk has a next function');
    let forwarders = growable<String>([
      'call $span\n',
      'call $total\n',
      'call $area\n',
    ]);
    assertNoAllocation(result, '$main', 'the literals are never built');
    assertFunctionOmits(result, '$main', forwarders,
        'a generator and an async function are called through their cores');
    assertNoAllocation(result, walkNext,
        'the literal in the generator body is passed as its fields');
    assertFunctionOmits(result, walkNext, forwarders,
        'the call in the generator body goes to the core');
  });

  test('a record spread into a literal stays as its fields', (ctx) => {
    // `widen` spreads its parameter into its result, and `fromBound`
    // spreads a bound call result into its result: neither the sources
    // nor the results are built.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        type W = {x: i32, y: i32, z: i32};
        let widen = (r: V, z: i32): W => ({...r, z});
        let make = (n: i32): V => ({x: n, y: n * 2});
        let fromBound = (n: i32): W => {
          let r = make(n);
          return {...r, z: 7};
        };
        export let main = (): i32 => {
          let {x, y, z} = widen({x: 1, y: 2}, 3);
          let w = fromBound(3);
          return x + y + z + w.x + w.y + w.z;
        };
        `);
    let forwarders = growable<String>([
      'call $widen\n',
      'call $make\n',
      'call $fromBound\n',
    ]);
    assertNoAllocation(result, '$main', 'the spread source arrives as fields');
    assertFunctionOmits(result, '$main', forwarders,
        'the spreading functions are called through their cores');
    assertNoAllocation(result, '$widen.core',
        'the spread reads the exploded parameter');
    assertNoAllocation(result, '$fromBound.core',
        'the bound result is spread from its fields');
    assertFunctionOmits(result, '$fromBound.core', forwarders,
        'the bound result comes back as fields');
  });

  test('== on a record held as its fields compares the fields', (ctx) => {
    // `same` compares two exploded parameters and `isOrigin` one against
    // a literal: neither the callers nor the cores build a record.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        let same = (a: V, b: V): boolean => a == b;
        let isOrigin = (p: V): boolean => p == {x: 0, y: 0};
        export let main = (): i32 => {
          let s = same({x: 1, y: 2}, {x: 1, y: 2});
          let o = isOrigin({x: 0, y: 0});
          return if (s && o) 1 else 0;
        };
        `);
    let forwarders = growable<String>(['call $same\n', 'call $isOrigin\n']);
    assertNoAllocation(result, '$main', 'the compared records arrive as fields');
    assertFunctionOmits(result, '$main', forwarders,
        'the comparing functions are called through their cores');
    assertNoAllocation(result, '$same.core',
        'two exploded parameters compare from their fields');
    assertNoAllocation(result, '$isOrigin.core',
        'an exploded parameter compares with a literal from its fields');
  });

  test('a record passed to super past the first superclass is passed as its fields', (ctx) => {
    // `Middle`'s own `super({...})` runs in `Middle.<ctor-init>`, which
    // returns `Base`'s arguments to `Leaf`'s factory. Its core returns
    // the record's fields, so neither it nor `Leaf` builds the record.
    let result = compileWithZir(dedentRaw`
        type Init = {x: i32, y?: i32};
        class Base {
          x: i32;
          y: i32;
          new(init: Init) : x = init.x, y = init.y ?? 7;
        }
        class Middle extends Base {
          m: i32;
          new(m: i32) : m = m, super({x: m * 10});
        }
        final class Leaf extends Middle {
          new() : super(4);
        }
        export let main = (): i32 => {
          let leaf = new Leaf();
          return leaf.x + leaf.y + leaf.m;
        };
        `);
    let named = (prefix: String, suffix: String) => {
      var found = '';
      for (let chunk in result.split('(func $')) {
        let name = chunk.split(' ')[0];
        if (name.startsWith(prefix) && name.endsWith(suffix)) {
          found = '$' + name;
        }
      }
      isTrue(found.length > 0, `no function ${prefix}…${suffix}`);
      return found;
    };
    assertNoAllocation(result, named('Middle_', '<ctor-init>.core'),
        'the value phase returns the super record as its fields');
    assertFunctionUsesTimes(result, named('Leaf_', '<constructor>'),
        'struct.new', 1, 'the record passed past Middle is never built');
  });

  test('a record result only read for its fields is returned as its fields', (ctx) => {
    // `step` builds its result from a literal and `main` only
    // destructures it, so `step.core` returns the two fields as wasm
    // results and neither side builds the record.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        let step = (p: i32): V => ({x: p, y: p + 1});
        export let main = (): i32 => {
          let {x, y} = step(3);
          return x * y;
        };
        `);
    assertNoAllocation(result, '$step.core',
        'the result literal is returned as its fields');
    assertNoAllocation(result, '$main', 'the fields are never packed');
    let coreCall = growable<String>(['call $step.core']);
    assertFunctionUses(result, '$main', coreCall,
        'a fields-only result calls the core');
  });

  test('a result returned from if and match arms is returned as its fields', (ctx) => {
    // Each arm of the returned `if` and `match` is a literal, so the
    // cores merge the arms' fields rather than their records, and
    // neither the cores nor `main` build one.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        let pick = (p: i32): V => if (p > 0) ({x: p, y: 1}) else ({x: 0, y: p});
        let classify = (p: i32): V => match (p) {
          case 0: ({x: 0, y: 0})
          case _: if (p > 10) ({x: 10, y: p}) else ({x: p, y: p * 2})
        };
        export let main = (): i32 => {
          let {x, y} = pick(3);
          let r = classify(4);
          return x * y + r.x + r.y;
        };
        `);
    assertNoAllocation(result, '$pick.core',
        'the if arms are merged as their fields');
    assertNoAllocation(result, '$classify.core',
        'the match arms, nested if included, are merged as their fields');
    assertNoAllocation(result, '$main', 'the fields are never packed');
  });

  test('a parameter returned whole passes its fields straight through', (ctx) => {
    // `same` returns its parameter, and its only caller passes a literal
    // and destructures the result, so the parameter and the result both
    // explode and `same.core` hands back the fields it was given.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        let same = (v: V): V => v;
        export let main = (): i32 => {
          let {x, y} = same({x: 3, y: 4});
          return x * y;
        };
        `);
    assertNoAllocation(result, '$same.core',
        'the parameter is returned as the fields it arrived as');
    assertNoAllocation(result, '$main', 'neither side builds the record');
  });

  test('a method takes and returns a record as its fields', (ctx) => {
    // `Grid` has no subclass, so its calls are direct: `area` takes the
    // literal as its fields and `shift` returns its result as fields, and
    // `main` builds no record.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        class Grid {
          scale: i32;
          new(this.scale);
          area(r: V): i32 { return r.x * r.y * this.scale; }
          shift(r: V, by: i32): V { return {x: r.x + by, y: r.y + by}; }
        }
        export let main = (): i32 => {
          let g = new Grid(2);
          let {x, y} = g.shift({x: 1, y: 2}, 10);
          return g.area({x: 3, y: 4}) + x * y;
        };
        `);
    let named = (prefix: String, suffix: String) => {
      var found = '';
      for (let chunk in result.split('(func $')) {
        let name = chunk.split(' ')[0];
        if (name.startsWith(prefix) && name.endsWith(suffix)) {
          found = '$' + name;
        }
      }
      isTrue(found.length > 0, `no function ${prefix}…${suffix}`);
      return found;
    };
    assertNoAllocation(result, '$main', 'the literals and the result stay as fields');
    assertNoAllocation(result, named('Grid_', '.area.core'),
        'the core reads the fields from its parameters');
    assertNoAllocation(result, named('Grid_', '.shift.core'),
        'the core takes and returns the fields');
  });

  test('a record passed on to a method and a static method stays as its fields', (ctx) => {
    // `area` passes its record on to `#scaled` and to the static `sum`,
    // and `main` passes a literal: the literal is never built, and no
    // core rebuilds it to pass it on.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        class Grid {
          scale: i32;
          new(this.scale);
          static sum(r: V): i32 { return r.x + r.y; }
          area(r: V): i32 { return this.#scaled(r) + Grid.sum(r); }
          #scaled(r: V): i32 { return r.x * r.y * this.scale; }
        }
        export let main = (): i32 => {
          let g = new Grid(2);
          return g.area({x: 3, y: 4});
        };
        `);
    let named = (prefix: String, suffix: String) => {
      var found = '';
      for (let chunk in result.split('(func $')) {
        let name = chunk.split(' ')[0];
        if (name.startsWith(prefix) && name.endsWith(suffix)) {
          found = '$' + name;
        }
      }
      isTrue(found.length > 0, `no function ${prefix}…${suffix}`);
      return found;
    };
    assertNoAllocation(result, '$main', 'the literal is passed as its fields');
    assertNoAllocation(result, named('Grid_', '.area.core'),
        'the record is passed on as its fields');
  });

  test('a method of a generic class takes a record as its fields', (ctx) => {
    // Each instantiation's `area` has its own core, and `main` passes
    // both literals as fields.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        class Box<T> {
          value: T;
          new(this.value);
          area(r: V): i32 { return r.x * r.y; }
        }
        export let main = (): i32 => {
          let a = new Box<i32>(1);
          let b = new Box<f64>(2.0);
          return a.area({x: 3, y: 4}) + b.area({x: 5, y: 6});
        };
        `);
    assertNoAllocation(result, '$main',
        'both instantiations take the literals as fields');
  });

  test('a record result stays as its fields as it flows on', (ctx) => {
    // `wrap` returns a method's result, `chain` passes a bound result to
    // `use`, whose only caller is that one, and `walk` updates a `var`
    // through a method: no function builds the record.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        class Grid {
          scale: i32;
          new(this.scale);
          shift(r: V, by: i32): V { return {x: r.x * this.scale + by, y: r.y + by}; }
          step(p: V): V { return {x: p.x + p.y, y: p.y + 1}; }
        }
        let wrap = (g: Grid, n: i32): V => g.shift({x: n, y: n}, 3);
        let walk = (g: Grid, n: i32): i32 => {
          var pos: V = {x: 0, y: 1};
          for (var i = 0; i < n; i += 1) {
            pos = g.step(pos);
          }
          return pos.x;
        };
        let make = (n: i32): V => ({x: n, y: n * 2});
        let use = (r: V): i32 => r.x * 100 + r.y;
        let chain = (n: i32): i32 => {
          let r = make(n);
          return use(r);
        };
        export let main = (): i32 => {
          let g = new Grid(2);
          let {x, y} = wrap(g, 4);
          return x + y + chain(5) + walk(g, 3);
        };
        `);
    assertNoAllocation(result, '$main', 'the method result is never packed');
    assertNoAllocation(result, '$walk',
        'a var written from a method call is held as its fields');
    assertNoAllocation(result, '$wrap.core',
        'a method result is returned on as its fields');
    assertNoAllocation(result, '$chain',
        'the bound result is passed on as its fields');
  });

  test('a record result passed straight to a call stays as its fields', (ctx) => {
    // Every record here is a call's result handed to another call, and
    // every parameter only reads fields, so nothing is built.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        let make = (n: i32): V => ({x: n, y: n * 2});
        let bump = (r: V): V => ({x: r.x + 1, y: r.y + 1});
        let use = (r: V): i32 => r.x * 100 + r.y;
        let twice = (r: V): V => bump(bump(r));
        export let main = (): i32 =>
          use(make(5)) + use(bump(make(1))) + twice({x: 1, y: 2}).x;
        `);
    // A forwarder builds the record, so no call may go through one.
    let forwarders = growable<String>([
      'call $make\n',
      'call $bump\n',
      'call $use\n',
    ]);
    assertNoAllocation(result, '$main',
        'call results are passed on as their fields');
    assertFunctionOmits(result, '$main', forwarders,
        'call results are passed on as their fields');
    assertNoAllocation(result, '$twice.core',
        'a nested call result is passed on as its fields');
    assertFunctionOmits(result, '$twice.core', forwarders,
        'a nested call result is passed on as its fields');
  });

  test('a var record updated through a call stays as its fields', (ctx) => {
    // `pos` is only read for its fields and only assigned values that
    // are fields already, so it is carried around the loop as its
    // fields: `step.core` takes and returns them, and no iteration
    // builds a record.
    let result = compileWithZir(dedentRaw`
        type V = {x: i32, y: i32};
        let step = (p: V): V => ({x: p.x + p.y, y: p.y + 1});
        export let main = (): i32 => {
          var pos: V = {x: 0, y: 1};
          for (var i = 0; i < 10; i += 1) {
            pos = step(pos);
          }
          return pos.x;
        };
        `);
    assertNoAllocation(result, '$main', 'the var is carried as its fields');
    assertNoAllocation(result, '$step.core',
        'the result is returned as its fields');
  });

  test('-O2 removes a local fat pointer entirely', (ctx) => {
    // Pack, dispatch, unpack, all in one body: devirtualization makes
    // the call direct, inlining brings the trampoline's receiver cast
    // in, forwarding turns the unpack into the packed object, the cast
    // folds, and the pack dies unused.
    let result = compileWithZirAt(dedentRaw`
        interface Shape { area(): i32; }
        class Circle implements Shape {
          r: i32;
          new(this.r);
          area(): i32 { return this.r * this.r; }
        }
        class Square implements Shape {
          s: i32;
          new(this.s);
          area(): i32 { return this.s * 4; }
        }
        export let measure = (c: Circle): i32 => { let s: Shape = c; return s.area(); };
        export let main = (): i32 => measure(new Circle(3)) + (new Square(2)).area();
        `, 2);
    assertNoAllocation(result, '$measure',
        'the fat pointer never escapes, so it is never allocated');
    let absent = growable<String>(['call_ref']);
    assertFunctionOmits(result, '$measure', absent,
        'the dispatch through the pack is direct');
    // With no pack of Circle as Shape left anywhere, the pair's vtable
    // global is unreachable, and harvest deletes it with the
    // trampolines it installed.
    isTrue(!result.contains('_trampoline'),
        'no interface trampoline survives once every pack is forwarded');
  });

  test('-O2 inlines a callee with a loop', (ctx) => {
    // A multi-block callee: its blocks become the caller's, its return
    // a branch to a continuation. The loop shape survives in the
    // caller and the call does not.
    let result = compileWithZirAt(dedentRaw`
        let sum = (n: i32): i32 => {
          var s = 0;
          var i = 0;
          while (i < n) { s += i; i += 1; }
          return s;
        };
        export let f = (k: i32): i32 => sum(k) + 1;
        export let main = (): i32 => f(10);
        `, 2);
    let present = growable<String>(['loop']);
    assertFunctionUses(result, '$f', present,
        'the callee loop is now the caller loop');
    let absent = growable<String>(['call $sum']);
    assertFunctionOmits(result, '$f', absent,
        'the multi-block callee is inlined');
  });

  test('-O2 inlines a callee with an early return', (ctx) => {
    // Two returns become two branches to one continuation; with a
    // constant argument the branch folds and the whole thing is a
    // constant.
    let result = compileWithZirAt(dedentRaw`
        let abs = (x: i32): i32 => { if (x < 0) { return 0 - x; } return x; };
        export let main = (): i32 => abs(0 - 7);
        `, 2);
    let present = growable<String>(['i32.const 7']);
    assertFunctionUses(result, '$main', present,
        'the inlined early return folds to its value');
    let absent = growable<String>(['call ']);
    assertFunctionOmits(result, '$main', absent,
        'no call survives');
  });

  test('-O2 inlines a loop over a closure argument and removes the closure', (ctx) => {
    // `each` is called from two places, so the plain policy leaves it
    // alone; both calls pass a closure written at the call, `each`
    // only calls its parameter, so the argument rule inlines it. Then
    // the closure call becomes a direct call to the lambda, the lambda
    // inlines, and the closure object is never allocated.
    let result = compileWithZirAt(dedentRaw`
        let each = (f: (x: i32) => i32, n: i32): i32 => {
          var s = 0;
          var i = 0;
          while (i < n) { s += f(i); i += 1; }
          return s;
        };
        export let a = (n: i32): i32 => each((x: i32): i32 => x * 2, n);
        let b = (n: i32): i32 => each((x: i32): i32 => x + 1, n);
        export let main = (): i32 => a(10) + b(10);
        `, 2);
    let present = growable<String>(['loop']);
    assertFunctionUses(result, '$a', present,
        'the loop from each is now in a');
    assertNoAllocation(result, '$a',
        'the closure passed to each is never allocated');
    let absent = growable<String>(['call']);
    assertFunctionOmits(result, '$a', absent,
        'the closure body is inlined into the loop');
  });

  test('-O2 inlines through an argument-adapted closure', (ctx) => {
    // The lambda takes one parameter where the callback type takes
    // two, so the closure wraps an adapter that tail-calls the lambda.
    // Inlining converts the adapter's tail call into a call, and the
    // rounds carry on: the loop ends up calling nothing at all.
    let result = compileWithZirAt(dedentRaw`
        let apply = (f: (a: i32, b: i32) => i32, n: i32): i32 => {
          var s = 0;
          var i = 0;
          while (i < n) { s += f(i, 1); i += 1; }
          return s;
        };
        export let main = (): i32 => apply((x: i32): i32 => x * 2, 10);
        `, 2);
    assertNoAllocation(result, '$main',
        'neither the closure nor its adapter is allocated');
    let absent = growable<String>(['call']);
    assertFunctionOmits(result, '$main', absent,
        'the adapter and the lambda are both inlined into the loop');
  });

  test('-O2 treats a named closure like a closure literal', (ctx) => {
    // `let g = ...; each(g, n)` binds the closure value to a name; the
    // call passes that same value, so the argument rule sees exactly
    // what it sees for a literal.
    let result = compileWithZirAt(dedentRaw`
        let each = (f: (x: i32) => i32, n: i32): i32 => {
          var s = 0;
          var i = 0;
          while (i < n) { s += f(i); i += 1; }
          return s;
        };
        export let a = (n: i32): i32 => {
          let g = (x: i32): i32 => x * 2;
          return each(g, n);
        };
        let b = (n: i32): i32 => each((x: i32): i32 => x + 1, n);
        export let main = (): i32 => a(10) + b(10);
        `, 2);
    assertNoAllocation(result, '$a',
        'the named closure is never allocated');
    let absent = growable<String>(['call']);
    assertFunctionOmits(result, '$a', absent,
        'the named closure body is inlined into the loop');
  });

  test('-O2 inlines a loop over an interface argument and removes the pack', (ctx) => {
    let result = compileWithZirAt(dedentRaw`
        interface Shape { area(): i32; }
        class Circle implements Shape {
          r: i32;
          new(this.r);
          area(): i32 { return this.r * this.r; }
        }
        class Square implements Shape {
          s: i32;
          new(this.s);
          area(): i32 { return this.s * 4; }
        }
        let total = (s: Shape, n: i32): i32 => {
          var t = 0;
          var i = 0;
          while (i < n) { t += s.area(); i += 1; }
          return t;
        };
        export let c = (n: i32): i32 => total(new Circle(3), n);
        let q = (n: i32): i32 => total(new Square(2), n);
        export let main = (): i32 => c(10) + q(10);
        `, 2);
    let absent = growable<String>(['call_ref']);
    assertFunctionOmits(result, '$c', absent,
        'the interface call inside the inlined loop is direct');
  });

  test('-O2 does not inline a callee containing try', (ctx) => {
    let result = compileWithZirAt(dedentRaw`
        let guarded = (x: i32): i32 => { try { return x + 1; } catch { return 0; } };
        export let f = (k: i32): i32 => guarded(k);
        export let main = (): i32 => f(10);
        `, 2);
    let present = growable<String>(['call $guarded']);
    assertFunctionUses(result, '$f', present,
        'a protected region is not spliced into another body');
  });

  test('-O2 deletes a function once every call to it is inlined', (ctx) => {
    let result = compileWithZirAt(dedentRaw`
        let inc = (x: i32): i32 => x + 1;
        export let main = (): i32 => inc(41);
        `, 2);
    isTrue(!result.contains('(func $inc'),
        'inc has no callers left and is not exported, so harvest removes it');
    let present = growable<String>(['i32.const 42']);
    assertFunctionUses(result, '$main', present,
        'the inlined call folded');
  });

  test('-O2 does not copy a single-site callee into every copy of its caller', (ctx) => {
    // `pick` has control flow and one call site, in `relay`, so the
    // inliner may move its body there. `relay` is small enough to
    // inline at both of its sites in `f`, and each copy brings a call
    // to `pick` along; inlining `pick` into those copies would put its
    // body in the module twice.
    let result = compileWithZirAt(dedentRaw`
        export let f = (a: i32, b: i32): i32 => relay(a) * relay(b);
        let relay = (x: i32): i32 => pick(x);
        let pick = (x: i32): i32 => {
          if (x > 100) { return x * 3 + 7; }
          if (x < 0) { return 0 - x; }
          return x + 1;
        };
        export let main = (): i32 => f(5, 200);
        `, 2);
    assertFunctionUsesTimes(result, '$f', 'call $pick', 2,
        'once relay is copied into f twice, pick has two call sites and stays a function');
  });

  test('-O2 does not inline into a block that ends in a throw', (ctx) => {
    // The block that builds the error runs only on the way to an
    // exception, so a copy of `twice` there is code nothing gains
    // from. The return path inlines it as usual.
    let result = compileWithZirStdlibAt(dedentRaw`
        import { i32ToString } from 'zena:core';
        let twice = (x: i32): i32 => x * 2 + 1;
        export let check = (x: i32): i32 => {
          if (x < 0) {
            throw new Error('negative: ' + i32ToString(twice(x)));
          }
          return twice(x);
        };
        export let run = (): i32 => check(3);
        `, 2);
    assertFunctionUsesTimes(result, '$check', 'call $twice', 1,
        'the throwing block keeps its call and the return path inlines it');
  });

  test('-O2 inlines a callee that only throws into a try body', (ctx) => {
    // Once `boom` is inlined, the try body never completes, so the
    // try's join block is unreachable. Block cleanup has to remove it
    // along with the rest of the dead code, or the verifier rejects
    // the function.
    let result = compileWithZirStdlibAt(dedentRaw`
        let boom = (): void => {
          throw new Error('boom');
        };
        export let attempt = (): i32 => {
          try {
            boom();
          } catch (e) {
            return 1;
          }
          return 0;
        };
        export let run = (): i32 => attempt();
        `, 2);
    let absent = growable<String>(['call $boom']);
    assertFunctionOmits(result, '$attempt', absent,
        'boom is inlined into the try body');
  });

  test('-O1 keeps a function that is still called', (ctx) => {
    let result = compileWithZir(dedentRaw`
        let inc = (x: i32): i32 => x + 1;
        export let main = (): i32 => inc(41);
        `);
    isTrue(result.contains('(func $inc'),
        'without inlining, inc is called and stays');
  });

  test('-O2 sees through an allocation returned by an inlined callee', (ctx) => {
    // make has a loop, so it inlines through a continuation block; its
    // one return passes the packed Circle as the continuation's
    // parameter. Deleting that parameter lets the dispatch resolve
    // and the pack die: main allocates the Circle and nothing else.
    let result = compileWithZirAt(dedentRaw`
        interface Shape { area(): i32; }
        class Circle implements Shape {
          r: i32;
          new(this.r);
          area(): i32 { return this.r * this.r; }
        }
        class Square implements Shape {
          s: i32;
          new(this.s);
          area(): i32 { return this.s * 4; }
        }
        let make = (n: i32): Shape => {
          var i = 0;
          while (i < n) { i += 1; }
          return new Circle(i);
        };
        export let main = (): i32 => make(3).area() + (new Square(2)).area();
        `, 2);
    let absent = growable<String>(['call_ref']);
    assertFunctionOmits(result, '$main', absent,
        'the dispatch on the returned value resolves through the deleted parameter');
    // Even the Circle and the Square go: their fields forward into the
    // inlined area bodies, and nothing else reads them.
    assertNoAllocation(result, '$main',
        'neither the objects nor their fat pointers are allocated');
  });

  test('folds a type test the static type decides', (ctx) => {
    // The scrutinee is a Lit, so the Lit arm's test is true and the
    // Neg arm's is false: main keeps one arm and no test.
    let result = compileWithZir(dedentRaw`
        sealed class Expr {
          case Lit(value: i32)
          case Neg(inner: Expr)
        }
        export let neg = (e: Expr): i32 => 7;
        export let main = (): i32 => {
          let e: Expr = new Lit(3);
          return match (e) {
            case Lit {value}: value
            case Neg {inner}: neg(inner)
          };
        };
        `);
    let absent = growable<String>(['ref.test', 'call $neg']);
    assertFunctionOmits(result, '$main', absent,
        'the tests fold on the static type and the Neg arm is unreachable');
  });

  test('-O2 folds a match over the case an inlined callee constructs', (ctx) => {
    let result = compileWithZirAt(dedentRaw`
        sealed class Expr {
          case Lit(value: i32)
          case Neg(inner: Expr)
        }
        export let neg = (e: Expr): i32 => 7;
        let make = (n: i32): Expr => new Lit(n);
        export let main = (): i32 => match (make(3)) {
          case Lit {value}: value
          case Neg {inner}: neg(inner)
        };
        `, 2);
    let absent = growable<String>(['ref.test', 'call $neg']);
    assertFunctionOmits(result, '$main', absent,
        'once make is inlined the scrutinee is a Lit allocation');
  });

  test('-O2 propagates a constant through a loop that only changes it on a dead path', (ctx) => {
    // x is 1 at entry, and the only assignment sits under a test x
    // itself makes false. The peephole pass cannot see that: the
    // loop-carried parameter meets 1 and the join's parameter, and
    // the join's parameter meets x and 2. SCCP never executes the
    // assignment's edge, so both parameters are 1.
    let result = compileWithZirAt(dedentRaw`
        export let f = (n: i32): i32 => {
          var x = 1;
          var i = 0;
          while (i < n) {
            if (x != 1) { x = 2; }
            i += 1;
          }
          return x;
        };
        export let main = (): i32 => f(5);
        `, 2);
    let absent = growable<String>(['i32.ne', 'i32.const 2']);
    assertFunctionOmits(result, '$f', absent,
        'the test on x and the assignment under it fold away');
  });

  test('-O2 makes a multi-value interface call direct and inlines it', (ctx) => {
    // next() returns two values through an interface slot. The slot
    // resolves by provenance (the pack of a fresh Counter), the
    // trampoline it names is a multi-value tail call, and the method
    // behind it has control flow: all three shapes inline, so the loop
    // keeps no call of any kind.
    let result = compileWithZirAt(dedentRaw`
        interface Iter { next(): inline (true, i32) | inline (false, _); }
        class Counter implements Iter {
          n: i32;
          var #i: i32 = 0;
          new(this.n);
          next(): inline (true, i32) | inline (false, _) {
            if (this.#i < this.n) {
              let v = this.#i;
              this.#i += 1;
              return (true, v);
            }
            return (false, _);
          }
        }
        export let main = (): i32 => {
          let it: Iter = new Counter(10);
          var sum = 0;
          while (let (true, v) = it.next()) { sum += v; }
          return sum;
        };
        `, 2);
    let absent = growable<String>([
      'call_ref',
      'call $',
      'struct.get',
      'struct.set',
    ]);
    assertFunctionOmits(result, '$main', absent,
        'the multi-value dispatch resolves, both the trampoline and next inline, and the counter dissolves');
    assertNoAllocation(result, '$main',
        'the Counter object escapes nowhere once next is inlined, so its field is a value');
    // One test per iteration: the flag next returned is threaded, so
    // the arm that found an element runs the body directly and the
    // arm that ran out leaves. (`br_if` would count here too.)
    assertFunctionUsesTimes(result, '$main', 'if', 1,
        'the loop tests once per element; the done flag is threaded away');
  });

  test('-O2 replaces a local object with a written field by a loop-carried value', (ctx) => {
    // The object never leaves f: every use is a read or a write of
    // its field. The field written in the loop becomes a parameter of
    // the loop header; the object is never allocated.
    let result = compileWithZirAt(dedentRaw`
        class Acc {
          var total: i32 = 0;
        }
        export let f = (n: i32): i32 => {
          let a = new Acc();
          var i = 0;
          while (i < n) {
            a.total += i;
            i += 1;
          }
          return a.total;
        };
        export let main = (): i32 => f(5);
        `, 2);
    let absent = growable<String>(['struct.get', 'struct.set']);
    assertFunctionOmits(result, '$f', absent,
        'the field reads and writes become the value itself');
    assertNoAllocation(result, '$f', 'the object is replaced by its one field');
  });

  test('-O2 inlines a three-lane multi-value call through an interface', (ctx) => {
    // The sync-or-async Step shape (async/step.zena): three lanes,
    // the third a reference the Ready and Done arms leave as a hole.
    // Nothing in the splice is written for two results; this pins it.
    let result = compileWithZirAt(dedentRaw`
        class Pend {}
        interface Iter {
          next(): inline (0, _, _) | inline (1, i32, _) | inline (2, _, Pend);
        }
        class Counter implements Iter {
          n: i32;
          var #i: i32 = 0;
          new(this.n);
          next(): inline (0, _, _) | inline (1, i32, _) | inline (2, _, Pend) {
            if (this.#i < this.n) {
              let v = this.#i;
              this.#i += 1;
              return (1, v, _);
            }
            return (0, _, _);
          }
        }
        export let main = (): i32 => {
          let it: Iter = new Counter(10);
          var sum = 0;
          var going = true;
          while (going) {
            match (it.next()) {
              case (0, _, _): { going = false; }
              case (1, let v, _): { sum += v; }
              case (2, _, let p): { going = false; }
            }
          }
          return sum;
        };
        `, 2);
    let absent = growable<String>(['call_ref', 'call $']);
    assertFunctionOmits(result, '$main', absent,
        'a three-result slot devirtualizes and its trampoline and body inline');
  });

  test('-O2 numbers the same cast from two inlined bodies as one', (ctx) => {
    // Each inlined accessor brings its own cast of the operand, at its
    // own type-table index; the value numbering keys the target type
    // by identity, so the second cast is the first.
    let result = compileWithZirAt(dedentRaw`
        class Box { x: i32; new(this.x); }
        let get = (a: anyref): i32 => (a as Box).x;
        let get2 = (a: anyref): i32 => (a as Box).x * 2;
        export let both = (v: anyref): i32 => get(v) + get2(v);
        export let main = (): i32 => both(new Box(3));
        `, 2);
    assertFunctionUsesTimes(result, '$both', 'ref.cast', 1,
        'one cast serves both inlined reads');
  });

  test('-O2 hoists a cast out of a loop header', (ctx) => {
    // The cast sits in the header (the loop condition reads through
    // it), so it runs on every entry to the loop; moving it before the
    // loop changes nothing about when it can trap.
    let result = compileWithZirAt(dedentRaw`
        class Arr { len: i32; new(this.len); }
        export let count = (a: anyref): i32 => {
          var s = 0;
          var i = 0;
          while (i < (a as Arr).len) { s += i; i += 1; }
          return s;
        };
        export let main = (): i32 => count(new Arr(4));
        `, 2);
    let body = watFunction(result, '$count');
    isTrue(body.length > 0, 'no function $count in the emitted module');
    let parts = body.split('loop');
    isTrue(parts.length >= 2, 'count has a loop');
    isTrue(parts[0].contains('ref.cast'), 'the cast happens before the loop');
    isTrue(!parts[1].contains('ref.cast'), 'and no longer inside it');
  });

  test('a class whose every allocation is forwarded away leaves no type behind', (ctx) => {
    // At -O2 the constructor inlines, the field read forwards to the
    // argument, DCE deletes the allocation, and nothing emitted names
    // Dead any more: neither its struct nor its vtable struct is in
    // the type section. At -O1 the constructor is still a call that
    // allocates, so the types stay.
    let source = dedentRaw`
        class Dead { x: i32; new(this.x); }
        let f = (n: i32): i32 => new Dead(n).x;
        export let main = (): i32 => f(3);
        `;
    isTrue(!compileWithZirAt(source, 2).contains('$Dead'),
        'at -O2 no type named after Dead survives');
    isTrue(compileWithZirAt(source, 1).contains('$Dead'),
        'at -O1 the constructor allocates and its types stay');
  });

  test('-O2 specializes a function on the class its callers pack', (ctx) => {
    // total takes Shape and has two call sites with two loops, so it
    // stays a function; every caller packs a Circle. The clone takes
    // the Circle: no fat pointer, no cast, and area inlines to the
    // field read. Nothing else references total, so it is gone.
    let result = compileWithZirAt(dedentRaw`
        interface Shape { area(): i32; }
        class Circle implements Shape {
          r: i32;
          new(this.r);
          area(): i32 { return this.r * this.r; }
        }
        let total = (s: Shape, n: i32): i32 => {
          var t = 0;
          var i = 0;
          while (i < n) { t += s.area(); i += 1; }
          var j = 0;
          while (j < n) { t += s.area() * 2; j += 1; }
          return t;
        };
        export let main = (): i32 => {
          let c = new Circle(3);
          return total(c, 10) + total(c, 5);
        };
        `, 2);
    let clone = watFunction(result, '$total$spec');
    isTrue(clone.length > 0, 'no function $total$spec in the emitted module');
    isTrue(watFunction(result, '$total').length == 0,
        'the original total has no callers left and is deleted');
    isTrue(clone.contains('struct.get'),
        'the clone reads the Circle field straight off its parameter');
    let absent = growable<String>(['call', 'ref.cast', 'struct.new']);
    assertFunctionOmits(result, '$total$spec', absent,
        'area inlines against the exact receiver, and the entry pack dies');
    absent.push('call_ref');
    assertFunctionUsesTimes(result, '$main', 'struct.new', 1,
        'main allocates the Circle and no fat pointer');
  });

  test('-O2 hoists an immutable field load out of a loop', (ctx) => {
    let result = compileWithZirAt(dedentRaw`
        class P {
          k: i32;
          new(this.k);
        }
        export let sum = (p: P, n: i32): i32 => {
          var s = 0;
          var i = 0;
          while (i < n) { s += p.k; i += 1; }
          return s;
        };
        export let main = (): i32 => sum(new P(3), 10);
        `, 2);
    let sumBody = watFunction(result, '$sum');
    isTrue(sumBody.length > 0, 'no function $sum in the emitted module');
    let parts = sumBody.split('loop');
    isTrue(parts.length >= 2, 'sum has a loop');
    isTrue(parts[0].contains('struct.get'),
        'the field load happens before the loop');
    isTrue(!parts[1].contains('struct.get'),
        'and no longer inside it');
  });

  test('-O2 hoists an interface dispatch chain out of a loop', (ctx) => {
    // Two implementers keep the call indirect, so the win is the
    // unpack and the vtable-slot load moving out of the loop: inside,
    // only the call remains.
    let result = compileWithZirAt(dedentRaw`
        interface Shape { area(): i32; }
        class Circle implements Shape {
          r: i32;
          new(this.r);
          area(): i32 { return this.r * this.r; }
        }
        class Square implements Shape {
          s: i32;
          new(this.s);
          area(): i32 { return this.s * 4; }
        }
        export let total = (s: Shape, n: i32): i32 => {
          var t = 0;
          var i = 0;
          while (i < n) { t += s.area(); i += 1; }
          return t;
        };
        export let main = (): i32 => total(new Circle(3), 10) + total(new Square(2), 10);
        `, 2);
    let totalBody = watFunction(result, '$total');
    isTrue(totalBody.length > 0, 'no function $total in the emitted module');
    let parts = totalBody.split('loop');
    isTrue(parts.length >= 2, 'total has a loop');
    isTrue(parts[1].contains('call_ref'),
        'with two implementers the call stays indirect');
    isTrue(!parts[1].contains('struct.get'),
        'the unpack and the slot load are outside the loop');
  });

  test('-O1 does not inline', (ctx) => {
    let result = compileWithZir(dedentRaw`
        let inc = (x: i32): i32 => x + 1;
        let f = (y: i32): i32 => inc(y);
        export let main = (): i32 => f(20);
        `);
    let present = growable<String>(['call $inc']);
    assertFunctionUses(result, '$f', present,
        'inlining is the module loop, which is -O2');
  });

  test('-O0 turns the cleanup passes off', (ctx) => {
    // Same program as the folding test below, compiled at level 0:
    // the arithmetic must survive. GVN still runs at every level.
    let result = compileWithZirAt(
        'export let main = (): i32 => { let a = 6; let b = 7; return a * b + 3; };',
        0);
    let present = growable<String>(['i32.mul']);
    assertFunctionUses(result, '$main', present,
        'level 0 does not fold');
  });

  test('simplify folds constant arithmetic', (ctx) => {
    let result = compileWithZir(
        'export let main = (): i32 => { let a = 6; let b = 7; return a * b + 3; };');
    let present = growable<String>(['i32.const 45']);
    assertFunctionUses(result, '$main', present,
        'constant multiply-add folds to one constant');
    let absent = growable<String>(['i32.mul', 'i32.add']);
    assertFunctionOmits(result, '$main', absent,
        'folded arithmetic leaves no arithmetic behind');
  });

  test('simplify folds a constant chain across widths', (ctx) => {
    // i64 multiply of constants folds, and the wrap of the folded
    // constant folds after it — one forward pass cascades because
    // operand ids precede use ids.
    let result = compileWithZir(dedentRaw`
        export let main = (): i32 => {
          let a = 6 as i64;
          let b = 7 as i64;
          return (a * b) as i32;
        };
        `);
    let present = growable<String>(['i32.const 42']);
    assertFunctionUses(result, '$main', present,
        'the i64 product wraps to a folded i32 constant');
    let absent = growable<String>(['i64.mul', 'i32.wrap_i64']);
    assertFunctionOmits(result, '$main', absent,
        'both the multiply and the wrap fold away');
  });

  test('simplify removes additive identity', (ctx) => {
    let result = compileWithZir(dedentRaw`
        let f = (x: i32): i32 => x + 0;
        export let main = (): i32 => f(21);
        `);
    let absent = growable<String>(['i32.add']);
    assertFunctionOmits(result, '$f', absent,
        'x + 0 is x; no add survives');
  });

  test('simplify strength-reduces multiply by a power of two', (ctx) => {
    let result = compileWithZir(dedentRaw`
        let f = (x: i32): i32 => x * 8;
        export let main = (): i32 => f(5);
        `);
    let present = growable<String>(['i32.shl']);
    assertFunctionUses(result, '$f', present,
        'x * 8 becomes x << 3');
    let absent = growable<String>(['i32.mul']);
    assertFunctionOmits(result, '$f', absent,
        'the multiply is replaced, not kept alongside');
  });

  test('simplify folds self-cancelling xor', (ctx) => {
    let result = compileWithZir(dedentRaw`
        let f = (x: i32): i32 => x ^ x;
        export let main = (): i32 => f(21);
        `);
    let absent = growable<String>(['i32.xor']);
    assertFunctionOmits(result, '$f', absent,
        'x ^ x is 0 regardless of x');
  });

  test('branch folding removes the untaken side entirely', (ctx) => {
    // The condition folds to a constant, the br_if folds to a br, and
    // block cleanup deletes the stranded alternative — its constant
    // must not survive anywhere in the function.
    let result = compileWithZir(
        'export let main = (): i32 => { if (1 < 2) { return 10; } return 20; };');
    let present = growable<String>(['i32.const 10']);
    assertFunctionUses(result, '$main', present,
        'the taken side is still there');
    let absent = growable<String>(['i32.const 20', 'br_if']);
    assertFunctionOmits(result, '$main', absent,
        'a constant-true condition leaves neither a branch nor the untaken side');
  });

  test('dce removes an unused pure computation', (ctx) => {
    let result = compileWithZir(dedentRaw`
        let f = (x: i32): i32 => { var a = x * 3; a = x; return a; };
        export let main = (): i32 => f(21);
        `);
    let absent = growable<String>(['i32.mul']);
    assertFunctionOmits(result, '$f', absent,
        'the overwritten x * 3 is dead and pure, so it goes');
  });

  test('dce removes an unused tuple allocation', (ctx) => {
    let result = compileWithZir(dedentRaw`
        let f = (x: i32): i32 => { let t = (x, x + 1); return x; };
        export let main = (): i32 => f(21);
        `);
    assertNoAllocation(result, '$f',
        'an unused, non-escaping tuple never allocates');
  });

  test('dce keeps an unused division that could trap', (ctx) => {
    let result = compileWithZir(dedentRaw`
        let f = (x: i32, y: i32): i32 => { var a = x % y; a = x; return a; };
        export let main = (): i32 => f(21, 2);
        `);
    let present = growable<String>(['i32.rem_s']);
    assertFunctionUses(result, '$f', present,
        'x % y traps when y is zero; dead or not, it must run');
  });

  test('gvn commons repeated immutable field loads', (ctx) => {
    let result = compileWithZir(dedentRaw`
        class P {
          #x: i32 = 7;
          sum(): i32 { return this.#x + this.#x; }
        }
        let f = (p: P): i32 => p.sum();
        export let main = (): i32 => f(new P());
        `);
    // Method function names carry a symbol uid ($P_s1234.sum), so find
    // the emitted name rather than hardcoding it.
    var sumName = '';
    for (let chunk in result.split('(func $')) {
      if (chunk.startsWith('P_') && chunk.contains('.sum')) {
        sumName = '$' + chunk.split(' ')[0];
      }
    }
    isTrue(sumName.length > 0, 'no P.sum function in the emitted module');
    assertFunctionUsesTimes(result, sumName, 'struct.get', 1,
        'two reads of an immutable field are one load');
  });

  test('a method receives this as a non-null reference', (ctx) => {
    // The receiver parameter is typed (ref $T), so reading a field off
    // `this` needs no re-assert. The nullable form has nothing to do
    // with dispatch: a method-table slot is an untyped funcref, and the
    // call site's cast only needs base and override to share one
    // signature, which rooting the receiver at the declaring class
    // gives either way.
    let result = compileWithZir(dedentRaw`
        class Base {
          tag: i32;
          new(this.tag);
          describe(): i32 { return this.tag; }
        }
        final class Derived extends Base {
          extra: i32;
          new(t: i32, this.extra) : super(t);
          describe(): i32 { return this.tag + this.extra; }
          later(): () => i32 { return () => this.extra; }
        }
        let viaBase = (b: Base): i32 => b.describe();
        let maybe = (b: Base | null): i32 => {
          if (b != null) { return b.describe(); }
          return 0;
        };
        export let main = (): i32 => {
          let d = new Derived(1, 2);
          return viaBase(new Base(5)) + viaBase(d) + maybe(d) + maybe(null) +
              d.later()();
        };
        `);
    // Specialized names carry an id: `$Base_s12.describe`.
    let methodNamed = (className: String, method: String) => {
      for (let chunk in result.split('(func ')) {
        let name = chunk.split(' ')[0];
        if (name.startsWith(`$${className}_`) && name.endsWith('.' + method)) {
          return name;
        }
      }
      fail(`no ${className}.${method} function in the emitted module`);
      return '';
    };
    let omitted = growable<String>(['ref.as_non_null']);
    assertFunctionOmits(result, methodNamed('Base', 'describe'), omitted,
        'this arrives non-null, so its fields are read without a re-assert');
    // The override is reached through Base's slot and so takes Base's
    // receiver; its prologue casts down with ref.cast, which is non-null.
    assertFunctionOmits(result, methodNamed('Derived', 'describe'), omitted,
        'the downcast receiver is non-null too');
    // A nullable receiver narrowed by a null check is re-asserted at
    // the call site, where the value is nullable.
    let asserted = growable<String>(['ref.as_non_null']);
    assertFunctionUses(result, '$maybe', asserted,
        'the narrowed receiver is asserted where it is still nullable');
  });

  test('a dispatched accessor on a narrowed receiver re-asserts it', (ctx) => {
    // `n.loc` reads an abstract field through Node's method table.
    // The receiver was narrowed by `n != null` inside the `&&`, so it
    // is still in a nullable local and has to be re-asserted before it
    // reaches the getter's non-null receiver parameter. lsp.wasm
    // failed validation on this shape: "call_ref[0] expected type
    // (ref $T), found local.get of type (ref null $T)". This checks
    // the shape; tests/language/execution runs the same program under
    // wasmtime, which validates it.
    let result = compileWithZir(dedentRaw`
        class Loc { start: i32; new(this.start); }
        sealed class Node {
          abstract loc: Loc | null;
          case Leaf(loc: Loc | null)
          case Pair(loc: Loc | null, other: i32)
        }
        let startOf = (n: Node | null): i32 => {
          if (n != null && n.loc != null) {
            let l = n.loc as Loc;
            return l.start;
          }
          return -1;
        };
        export let main = (): i32 => startOf(new Leaf(new Loc(5))) + startOf(null);
        `);
    let used = growable<String>(['call_ref', 'ref.as_non_null']);
    assertFunctionUses(result, '$startOf', used,
        'the getter dispatches through the method table on a re-asserted receiver');
  });

  test('a fresh trailing operand streams past a parameter read', (ctx) => {
    // `i - p.x`: the first operand is a parameter and the second is
    // produced right before the subtraction. The parameter read is
    // emitted before the field load, so the load's result stays on
    // the stack — no local for it, no set/get pair. The same for a
    // store: `p.y = i * 2` pushes `p` before the multiply.
    let result = compileWithZir(dedentRaw`
        class Point {
          x: i32;
          var y: i32;
          new(this.x, this.y);
        }
        let sub = (p: Point, i: i32): i32 => i - p.x;
        let store = (p: Point, i: i32): void => { p.y = i * 2; };
        export let main = (): i32 => {
          let p = new Point(3, 0);
          store(p, 5);
          return sub(p, 10) + p.y;
        };
        `);
    let locals = growable<String>(['local.set', 'local.tee']);
    assertFunctionOmits(result, '$sub', locals,
        'the field load streams into the subtraction');
    assertFunctionOmits(result, '$store', locals,
        'the product streams into the store');
  });

  test('simplify leaves division by a constant zero to trap', (ctx) => {
    // % lowers to i32.rem_s, which traps on a zero divisor. The
    // simplifier must not fold or delete it — the trap is the
    // program's runtime behavior, in its original position.
    let result = compileWithZir(
        'export let main = (): i32 => { let a = 7; let b = 0; return a % b; };');
    let present = growable<String>(['i32.rem_s']);
    assertFunctionUses(result, '$main', present,
        'a trapping division survives simplification untouched');
  });

  test('a string literal compiles', (ctx) => {
    let result = compileWithZirStdlib(
        'export let main = (): i32 => \'ab\'.length;');
    isTrue(result.contains('(func $main'));
  });
});
