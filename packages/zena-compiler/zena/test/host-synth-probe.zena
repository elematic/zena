// Probe: synthesize the `zena:host` interfaces the `zena-component`
// target's zena:process, zena:wasm and zena:error-stack are written
// against, and dump each module. Run with `zena-run --dir .::.` from
// the repository root.
import { readWitSource } from '../lib/wit-source.zena';
import { synthesizeWitModule } from '../lib/wit-module-synth.zena';
import { DiskHost } from '../lib/fs-host.zena';
import { writeFile } from 'zena:fs';

let root = 'packages/stdlib/zena/host-wit';

export async function main(): Future<i32> {
  let wit = await readWitSource(new DiskHost(), root);
  let specs = ['zena:host/stack-trace', 'zena:host/process',
      'zena:host/wasm'];
  var refused = 0;
  var index = 0;
  for (let spec in specs) {
    index += 1;
    let source = try {
      await synthesizeWitModule(new DiskHost(), `wit:${root}#${spec}`, wit)
    } catch (e) {
      console.log(`${spec}: THREW ${e.message}`);
      ''
    };
    var count = 0;
    for (let line in source.split('\n')) {
      if (line.contains('Not yet importable') || line.contains('waits on')) {
        console.log(`${spec}: ${line}`);
        count += 1;
      }
    }
    console.log(`${spec}: ${count} refusals`);
    refused += count;
    await writeFile(`packages/zena-compiler/zena/out/host-synth-${index}.zena`, source);
  }
  return refused;
}
