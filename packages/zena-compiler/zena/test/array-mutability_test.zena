import { suite, test, TestContext } from 'zena:test';
import { equal, isTrue, isFalse } from 'zena:assert';
import { ByteBuffer } from 'zena:core';
import { ArrayType, I32Type, Type } from '../lib/types.zena';
import { WasmModule, WasmArray, asWasmArray } from '../lib/codegen/wasm-module.zena';
import { ValTypeI32, ValTypeAnyRef } from '../lib/codegen/wasm.zena';
import { typeToValType } from '../lib/codegen/type-mapping.zena';
import { getTypeKeyForSpecialization } from '../lib/codegen/codegen-utils.zena';
import { BinaryEmitter } from '../lib/codegen/binary-emitter.zena';

/**
 * Bare `array<T>` has immutable elements and `array<var T>` mutable
 * ones (docs/design/array-mutability.md). These tests drive the
 * representation directly: an ArrayType with immutable elements must
 * intern a distinct Wasm array type and emit `(array T)` rather than
 * `(array (mut T))`.
 */
export let tests = suite('array element mutability', (): void => {
  test('typeToValType keeps mutable and immutable arrays distinct', (ctx: TestContext): void => {
    let wasm = new WasmModule();
    let mutVt = typeToValType(wasm, new ArrayType(new I32Type(), true));
    let immVt = typeToValType(wasm, new ArrayType(new I32Type(), false));

    let mutArr = asWasmArray(mutVt) as WasmArray;
    let immArr = asWasmArray(immVt) as WasmArray;
    isTrue(mutArr != immArr);
    isTrue(mutArr.isMutable);
    isFalse(immArr.isMutable);

    // Interning is per (element, mutability): asking again returns the
    // same type, not a new one.
    let again = asWasmArray(typeToValType(wasm, new ArrayType(new I32Type(), false))) as WasmArray;
    isTrue(again == immArr);
  });

  test('specialization keys distinguish element mutability', (ctx: TestContext): void => {
    let mutKey = getTypeKeyForSpecialization(new ArrayType(new I32Type(), true));
    let immKey = getTypeKeyForSpecialization(new ArrayType(new I32Type(), false));
    equal(mutKey, 'arr_i32');
    equal(immKey, 'arrimm_i32');
  });

  test('binary emitter writes the element mutability bit', (ctx: TestContext): void => {
    // An array of values writes: 0x4F (sub final), 0 supertypes, 0x5E
    // (array form), the element valtype, then the mutability byte.
    let checkMutByte = (isMutable: boolean, expected: i32): void => {
      let emitter = new BinaryEmitter(new ByteBuffer());
      emitter.emitTypeSectionStart(1);
      emitter.emitArrayType(0, new ValTypeI32(), isMutable, -1, true);
      let section = emitter.currentSection as ByteBuffer;
      // Byte 0 is the type count; the array type starts at byte 1.
      equal(section.getByte(1), 0x4F);
      equal(section.getByte(2), 0);
      equal(section.getByte(3), 0x5E);
      equal(section.getByte(4), 0x7F); // i32
      equal(section.getByte(5), expected);
    };
    checkMutByte(true, 1);
    checkMutByte(false, 0);
  });

  test('binary emitter writes the supertype an immutable reference array declares', (ctx: TestContext): void => {
    // The root of a chain, (array anyref), has no supertype of its own,
    // and the arrays below it name it, so it is emitted open: 0x50
    // (sub), 0 supertypes. Who is open and who is final is decided by
    // ModuleGenerator (docs/design/struct-finality.md) and arrives as
    // the last argument; the emitter writes what it is told.
    let root = new BinaryEmitter(new ByteBuffer());
    root.emitTypeSectionStart(1);
    root.emitArrayType(0, new ValTypeAnyRef(), false, -1, false);
    let rootSection = root.currentSection as ByteBuffer;
    equal(rootSection.getByte(1), 0x50);
    equal(rootSection.getByte(2), 0);
    equal(rootSection.getByte(3), 0x5E);

    // A subtype names its supertype, and is itself final when it is the
    // most derived array in the chain: 0x4F, 1 supertype, its index.
    let sub = new BinaryEmitter(new ByteBuffer());
    sub.emitTypeSectionStart(1);
    sub.emitArrayType(8, new ValTypeAnyRef(), false, 7, true);
    let subSection = sub.currentSection as ByteBuffer;
    equal(subSection.getByte(1), 0x4F);
    equal(subSection.getByte(2), 1);
    equal(subSection.getByte(3), 7);
    equal(subSection.getByte(4), 0x5E);

    // A mutable reference array declares no supertype and can have
    // none, so it is always final.
    let mut = new BinaryEmitter(new ByteBuffer());
    mut.emitTypeSectionStart(1);
    mut.emitArrayType(0, new ValTypeAnyRef(), true, -1, true);
    let mutSection = mut.currentSection as ByteBuffer;
    equal(mutSection.getByte(1), 0x4F);
    equal(mutSection.getByte(2), 0);
  });
});
