import { suite, test, TestContext } from 'zena:test';
import { equal, isNotNull } from 'zena:assert';
import { console } from 'zena:console';
import { WatGenerator } from '../lib/codegen/wat-generator.zena';
import { parse } from '../lib/parser.zena';
import { SemanticModel } from '../lib/semantic-model.zena';
import { ScopeBuilder } from '../lib/scope/scope-builder.zena';
import { Module, VariableDeclaration, FunctionExpression, BinaryExpression } from '../lib/ast.zena';
import { I32Type } from '../lib/types.zena';
import { Array } from 'zena:array';
import { Program, CompilationUnit } from '../lib/program.zena';
import { readFile, writeFile, exists, mkdir } from 'zena:fs';
import { String } from 'zena:string';
import { makeCompiler, MockHost } from './test-utils.zena';
import { checkCompilation } from '../lib/compiler.zena';

let assertSnapshot = (name: String, content: String): void => {
  let snapDir = 'packages/zena-compiler/test-files/snapshots';
  if (!exists(snapDir)) {
    mkdir(snapDir);
  }
  let snapFile = snapDir + '/' + name + '.snap';
  if (exists(snapFile)) {
    let expected = readFile(snapFile);
    equal(content, expected);
  } else {
    writeFile(snapFile, content);
    equal(content, content);
  }
};

export let tests = suite('WatGenerator', (): void => {
  test('main returns i32 with block statement', (ctx: TestContext): void => {
    let source = 'export let main = (): i32 => { return 42; };';
    let ast = parse(source, 'test.zena');
    let scopeBuilder = new ScopeBuilder('test.zena');
    let scopeResult = scopeBuilder.build(ast);
    let model = new SemanticModel(); 
    model.setSymbols(scopeResult.symbols);

    let modules = new Array<Module>();
    let m = ast as Module;
    modules.push(m);
    
    let entryPoint = m;
    
    let unit = {ast: m, model: model};
    let units = new Array<CompilationUnit>();
    units.push(unit);
    let program = new Program(units, unit);

    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    assertSnapshot('main_returns_i32_block', result);
  });

  test('main returns i32 with expression body', (ctx: TestContext): void => {
    let source = 'export let main = (): i32 => 42;';
    let ast = parse(source, 'test.zena');
    let scopeBuilder = new ScopeBuilder('test.zena');
    let scopeResult = scopeBuilder.build(ast);
    let model = new SemanticModel(); 
    model.setSymbols(scopeResult.symbols);

    let modules = new Array<Module>();
    let m = ast as Module;
    modules.push(m);
    
    let entryPoint = m;
    
    let unit = {ast: m, model: model};
    let units = new Array<CompilationUnit>();
    units.push(unit);
    let program = new Program(units, unit);

    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    assertSnapshot('main_returns_i32_expr', result);
  });

  test('main returns 1 + 2', (ctx: TestContext): void => {
    let source = 'export let main = (): i32 => 1 + 2;';
    let ast = parse(source, 'test.zena');
    let scopeBuilder = new ScopeBuilder('test.zena');
    let scopeResult = scopeBuilder.build(ast);
    let model = new SemanticModel(); 
    model.setSymbols(scopeResult.symbols);
  
    let modules = new Array<Module>();
    let m = ast as Module;
    let varDecl = m.body[0] as VariableDeclaration;
    let fnExp = varDecl.init as FunctionExpression;
    let binExp = fnExp.body as BinaryExpression;
    model.setNodeType(binExp, new I32Type());
    model.setNodeType(binExp.left, new I32Type());
    model.setNodeType(binExp.right, new I32Type());
    
    modules.push(m);
    let entryPoint = m;
    
    let unit = {ast: m, model: model};
    let units = new Array<CompilationUnit>();
    units.push(unit);
    let program = new Program(units, unit);
  
    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    assertSnapshot('main_returns_1_plus_2', result);
  });

  test('multiple exported functions', (ctx: TestContext): void => {
    let source = 'export let foo = (): i32 => 1; export let bar = (): i32 => 2;';
    let ast = parse(source, 'test.zena');
    let scopeBuilder = new ScopeBuilder('test.zena');
    let scopeResult = scopeBuilder.build(ast);
    let model = new SemanticModel(); 
    model.setSymbols(scopeResult.symbols);

    let modules = new Array<Module>();
    let m = ast as Module;
    modules.push(m);
    
    let entryPoint = m;
    
    let unit = {ast: m, model: model};
    let units = new Array<CompilationUnit>();
    units.push(unit);
    let program = new Program(units, unit);

    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    assertSnapshot('multiple_exported_functions', result);
  });

  test('external function import and call', (ctx: TestContext): void => {
    let host = new MockHost();
    let source = "@external(\"env\", \"consoleLog\")\ndeclare function consoleLog(msg: i32): void;\nexport let main = (): void => { consoleLog(42); };";
    host.addFile("test.zena", source);
    
    let compiler = makeCompiler(host);
    let compResult = compiler.compile("test.zena");
    let checkRes = checkCompilation(compResult, null, false);
    
    let entryAst = compResult.entry.ast;
    let units = new Array<CompilationUnit>();
    var entryUnit: CompilationUnit | null = null;
    
    for (let file in compResult.files) {
      if (!file.isStdlib) {
        let res = checkRes.results[file.path];
        if (res != null) {
          let unit = {ast: file.ast, model: res.model};
          units.push(unit);
          if (file.ast.path == entryAst.path) {
            entryUnit = unit;
          }
        }
      }
    }
    
    let program = new Program(units, entryUnit);
    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    // Using simple asserts for the import since snapshots will change based on ast/model
    // if new logic is added. Just ensuring it generates `(import "env" "consoleLog" ...)` 
    // and calls it.
    assertSnapshot('external_function_import', result);
  });

  test('parameter default dependency optimization skips locals', (ctx: TestContext): void => {
    let host = new MockHost();
    let source = "let testFn = (a: i32 = 1, b: i32 = 2): i32 => a + b;\nexport let foo = (): i32 => testFn();";
    host.addFile("test.zena", source);
    
    let compiler = makeCompiler(host);
    let compResult = compiler.compile("test.zena");
    let checkRes = checkCompilation(compResult, null, false);
    
    let entryAst = compResult.entry.ast;
    let units = new Array<CompilationUnit>();
    var entryUnit: CompilationUnit | null = null;
    
    for (let file in compResult.files) {
      if (!file.isStdlib) {
        let res = checkRes.results[file.path];
        if (res != null) {
          let unit = {ast: file.ast, model: res.model};
          units.push(unit);
          if (file.ast.path == entryAst.path) {
            entryUnit = unit;
          }
        }
      }
    }
    
    let program = new Program(units, entryUnit);
    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    assertSnapshot('param_default_opt', result);
  });

  test('record property access casting', (ctx: TestContext): void => {
    let host = new MockHost();
    let source = "export let main = (): i32 => {\n  let record = { a: 10, b: { c: 20 } };\n  return record.b.c;\n};";
    host.addFile("test.zena", source);
    
    let compiler = makeCompiler(host);
    let compResult = compiler.compile("test.zena");
    let checkRes = checkCompilation(compResult, null, false);
    
    let entryAst = compResult.entry.ast;
    let units = new Array<CompilationUnit>();
    var entryUnit: CompilationUnit | null = null;
    
    for (let file in compResult.files) {
      if (!file.isStdlib) {
        let res = checkRes.results[file.path];
        if (res != null) {
          let unit = {ast: file.ast, model: res.model};
          units.push(unit);
          if (file.ast.path == entryAst.path) {
            entryUnit = unit;
          }
        }
      }
    }
    
    let program = new Program(units, entryUnit);
    let generator = new WatGenerator();
    let result = generator.generate(program);
  });
  
  test('function adaptation deduplication', (ctx: TestContext): void => {
    let host = new MockHost();
    let source = "export let main = (): void => {\n" +
                 "  let f1 = (a: i32): i32 => a;\n" +
                 "  let f2 = (a: i32): i32 => a;\n" +
                 "  let u1: (a: i32, b: i32) => i32 = f1;\n" +
                 "  let u2: (a: i32, b: i32) => i32 = f2;\n" +
                 "  let f3 = (a: f64): f64 => a;\n" +
                 "  let u3: (a: f64, b: f64) => f64 = f3;\n" +
                 "  u1(10, 20);\n" +
                 "  u2(30, 40);\n" +
                 "  u3(50.0, 60.0);\n" +
                 "};";
    host.addFile("test.zena", source);
    
    let compiler = makeCompiler(host);
    let compResult = compiler.compile("test.zena");
    let checkRes = checkCompilation(compResult, null, false);
    
    let entryAst = compResult.entry.ast;
    let units = new Array<CompilationUnit>();
    var entryUnit: CompilationUnit | null = null;
    
    for (let file in compResult.files) {
      if (!file.isStdlib) {
        let res = checkRes.results[file.path];
        if (res != null) {
          let unit = {ast: file.ast, model: res.model};
          units.push(unit);
          if (file.ast.path == entryAst.path) {
            entryUnit = unit;
          }
        }
      }
    }
    
    let program = new Program(units, entryUnit);
    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    assertSnapshot('function_adaptation_deduplication', result);
  });

  test('inline tuple multi-value return', (ctx: TestContext): void => {
    let host = new MockHost();
    let source = "export let pair = (): inline (i32, i32) => ((1, 2));";
    host.addFile("test.zena", source);
    
    let compiler = makeCompiler(host);
    let compResult = compiler.compile("test.zena");
    let checkRes = checkCompilation(compResult, null, false);
    
    let entryAst = compResult.entry.ast;
    let units = new Array<CompilationUnit>();
    var entryUnit: CompilationUnit | null = null;
    
    for (let file in compResult.files) {
      if (!file.isStdlib) {
        let res = checkRes.results[file.path];
        if (res != null) {
          let unit = {ast: file.ast, model: res.model};
          units.push(unit);
          if (file.ast.path == entryAst.path) {
            entryUnit = unit;
          }
        }
      }
    }
    
    let program = new Program(units, entryUnit);
    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    assertSnapshot('inline_tuple_multi_value_return', result);
  });
});

