import { suite, test, TestContext } from 'zena:test';
import { equal } from 'zena:assert';
import { WatGenerator } from '../lib/codegen/wat-generator.zena';
import { Module } from '../lib/ast.zena';
import { Program, CompilationUnit } from '../lib/program.zena';
import { readFile, writeFile, exists, mkdir } from 'zena:fs';
import { makeCompiler, MockHost, errorDiagnostics } from './test-utils.zena';
import { checkCompilation, createCompiler, CompilerOptions } from '../lib/compiler.zena';
import { PackageConfig } from '../lib/module-resolver.zena';
import { getEnv } from 'zena:cli';
import { assertFunctionUses, assertNoAllocation } from './wat-invariants.zena';

let assertSnapshot = (name: String, content: String): void => {
  let snapDir = 'packages/zena-compiler/test-files/snapshots';
  if (!exists(snapDir)) {
    mkdir(snapDir);
  }
  let snapFile = snapDir + '/' + name + '.snap';
  if (getEnv("UPDATE_SNAPSHOTS") != null) {
    writeFile(snapFile, content);
    equal(content, content);
  } else if (exists(snapFile)) {
    let expected = readFile(snapFile);
    equal(content, expected);
  } else {
    writeFile(snapFile, content);
    equal(content, content);
  }
};

let compileAndGenerateWat = (source: String): String => {
  let host = new MockHost();
  host.addFile("test.zena", source);
  
  let compiler = makeCompiler(host);
  let compResult = compiler.compile("test.zena");
  let checkRes = checkCompilation(compResult, null, false);
  
  let entryAst = compResult.entry.ast;
  let units = new Array<CompilationUnit>();
  var entryUnit: CompilationUnit | null = null;
  
  for (let file in compResult.files) {
    if (!file.isStdlib) {
      let res = checkRes.results[file.path];
      if (res != null) {
        let unit = {ast: file.ast, model: res.model};
        units.push(unit);
        if (file.ast.path == entryAst.path) {
          entryUnit = unit;
        }
      }
    }
  }
  
  let program = new Program(units, entryUnit);
  let generator = new WatGenerator();
  return generator.generate(program);
};

export let tests = suite('WatGenerator', (): void => {
  test('main returns i32 with block statement', (ctx: TestContext): void => {
    let result = compileAndGenerateWat('export let main = (): i32 => { return 42; };');
    assertSnapshot('main_returns_i32_block', result);
  });

  test('main returns i32 with expression body', (ctx: TestContext): void => {
    let result = compileAndGenerateWat('export let main = (): i32 => 42;');
    assertSnapshot('main_returns_i32_expr', result);
  });

  test('main returns 1 + 2', (ctx: TestContext): void => {
    let result = compileAndGenerateWat('export let main = (): i32 => 1 + 2;');
    assertSnapshot('main_returns_1_plus_2', result);
  });

  test('multiple exported functions', (ctx: TestContext): void => {
    let result = compileAndGenerateWat('export let foo = (): i32 => 1; export let bar = (): i32 => 2;');
    assertSnapshot('multiple_exported_functions', result);
  });

  test('external function import and call', (ctx: TestContext): void => {
    let host = new MockHost();
    let source = "@external(\"env\", \"consoleLog\")\ndeclare function consoleLog(msg: i32): void;\nexport let main = (): void => { consoleLog(42); };";
    host.addFile("test.zena", source);
    
    let compiler = makeCompiler(host);
    let compResult = compiler.compile("test.zena");
    let checkRes = checkCompilation(compResult, null, false);
    
    let entryAst = compResult.entry.ast;
    let units = new Array<CompilationUnit>();
    var entryUnit: CompilationUnit | null = null;
    
    for (let file in compResult.files) {
      if (!file.isStdlib) {
        let res = checkRes.results[file.path];
        if (res != null) {
          let unit = {ast: file.ast, model: res.model};
          units.push(unit);
          if (file.ast.path == entryAst.path) {
            entryUnit = unit;
          }
        }
      }
    }
    
    let program = new Program(units, entryUnit);
    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    // Using simple asserts for the import since snapshots will change based on ast/model
    // if new logic is added. Just ensuring it generates `(import "env" "consoleLog" ...)` 
    // and calls it.
    assertSnapshot('external_function_import', result);
  });

