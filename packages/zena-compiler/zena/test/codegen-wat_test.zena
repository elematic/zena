    host.addFile("zena:console-wasi", "import { Console } from 'zena:console-interface'; @intrinsic('wasi_write_string') declare function wasi_write_string(fd: i32, s: String): void; export class WasiConsole implements Console { log(message: String): void { wasi_write_string(1, message); } } export let console = new WasiConsole();");
    host.addFile("test.zena", "import { console } from 'zena:console'; export let main = (): void => { console.log('hello'); };");

    let packages = new HashMap<String, PackageConfig>();
    let options = new CompilerOptions("zena-cli", "/stdlib", packages);
    let compiler = createCompiler(host, options);

    let compResult = compiler.compile("test.zena");
    let checkRes = checkCompilation(compResult, null, false);
    equal(errorDiagnostics(checkRes.diagnostics).length, 0);
    
    let entryAst = compResult.entry.ast;
    let units = new Array<CompilationUnit>();
    var entryUnit: CompilationUnit | null = null;
    
    for (let file in compResult.files) {
      let res = checkRes.results[file.path];
      if (res != null) {
        let unit = {ast: file.ast, model: res.model};
        units.push(unit);
        if (file.ast.path == entryAst.path) {
