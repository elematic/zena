import { suite, test, TestContext } from 'zena:test';
import { equal, isNotNull } from 'zena:assert';
import { console } from 'zena:console';
import { WatGenerator } from '../lib/codegen/wat-generator.zena';
import { parse } from '../lib/parser.zena';
import { SemanticModel } from '../lib/semantic-model.zena';
import { Module, VariableDeclaration } from '../lib/ast.zena';
import { Array } from 'zena:array';
import { Program, CompilationUnit } from '../lib/program.zena';

export let tests = suite('WatGenerator', (): void => {
  test('main returns i32 with block statement', (ctx: TestContext): void => {
    let source = 'export let main = (): i32 => { return 42; };';
    let ast = parse(source, 'test.zena');
    let model = new SemanticModel(); 

    let modules = new Array<Module>();
    let m = ast as Module;
    modules.push(m);
    
    let entryPoint = m;
    
    let unit = {ast: m, model: model};
    let units = new Array<CompilationUnit>();
    units.push(unit);
    let program = new Program(units, unit);

    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    let expected = '(module\n  (func $main (result i32)\n    (i32.const 42)\n    return\n  )\n  (export "main" (func $main))\n)\n';
    equal(result, expected);
  });

  test('main returns i32 with expression body', (ctx: TestContext): void => {
    let source = 'export let main = (): i32 => 42;';
    let ast = parse(source, 'test.zena');
    let model = new SemanticModel(); 

    let modules = new Array<Module>();
    let m = ast as Module;
    modules.push(m);
    
    let entryPoint = m;
    
    let unit = {ast: m, model: model};
    let units = new Array<CompilationUnit>();
    units.push(unit);
    let program = new Program(units, unit);

    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    let expected = '(module\n  (func $main (result i32)\n    (i32.const 42)\n    return\n  )\n  (export "main" (func $main))\n)\n';
    equal(result, expected);
  });

  test('main returns a + b requiring semantic model', (ctx: TestContext): void => {
    let source = 'export let main = () => { let a = 1; let b = 2; return a + b; };';
    let ast = parse(source, 'test.zena');
    let model = new SemanticModel();
    
    // In a real scenario, Checker would run and populate model.
    // model.setType(addExpr.id, i32Type);

    let modules = new Array<Module>();
    let m = ast as Module;
    modules.push(m);
    let entryPoint = m;
    
    let unit = {ast: m, model: model};
    let units = new Array<CompilationUnit>();
    units.push(unit);
    let program = new Program(units, unit);

    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    // This is currently failing/unimplemented in wat-generator, so we might just ensure it does not crash for now
    // let expected = '...';
    // equal(result, expected);
  });

  test('multiple exported functions', (ctx: TestContext): void => {
    let source = 'export let foo = (): i32 => 1; export let bar = (): i32 => 2;';
    let ast = parse(source, 'test.zena');
    let model = new SemanticModel(); 

    let modules = new Array<Module>();
    let m = ast as Module;
    modules.push(m);
    
    let entryPoint = m;
    
    let unit = {ast: m, model: model};
    let units = new Array<CompilationUnit>();
    units.push(unit);
    let program = new Program(units, unit);

    let generator = new WatGenerator();
    let result = generator.generate(program);
    
    let expected = '(module\n  (func $foo (result i32)\n    (i32.const 1)\n    return\n  )\n  (export "foo" (func $foo))\n  (func $bar (result i32)\n    (i32.const 2)\n    return\n  )\n  (export "bar" (func $bar))\n)\n';
    equal(result, expected);
  });
});
