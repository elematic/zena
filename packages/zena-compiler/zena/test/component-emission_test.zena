/**
 * `--target component` emits a WebAssembly component.
 *
 * The structure is asserted here, on the bytes; that the result
 * validates and runs is asserted by `scripts/component-e2e.js`, which
 * needs `wasm-tools` and `wasmtime` and so belongs outside the unit
 * suite. Both matter: a component that validates but wraps the wrong
 * module would pass one and not the other.
 *
 * See docs/design/component-emission.md.
 */

import { suite, test, TestContext } from 'zena:test';
import { isTrue, equal, throws } from 'zena:assert';
import { readFile } from 'zena:fs';
import { newByteArray } from 'zena:byte-array';
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { CompilerHost } from '../lib/library-loader.zena';
import {
  createCompiler, CompilerOptions, checkCompilation
} from '../lib/compiler.zena';
import { loadPackageMap } from '../lib/package-manifest.zena';
import { stdlibIdToRelativeFile } from '../lib/module-resolver.zena';
import { DiagnosticSeverity } from '../lib/diagnostics.zena';
import { BinaryGenerator } from '../lib/codegen/binary-generator.zena';
import { compileComponentRuntimeModule } from '../lib/codegen/component-runtime.zena';
import { WatGenerator } from '../lib/codegen/wat-generator.zena';
import { Program, CompilationUnit } from '../lib/program.zena';
import { i32ToString } from 'zena:string-convert';
import {
  isKebabName, toKebabName, ComponentShape, ComponentImportFunc,
  ComponentFuncType
} from '../lib/codegen/component-emitter.zena';
import {
  deriveImportsWit, encodeImportTypes, makeImportEncoder
} from '../lib/codegen/wit-imports.zena';
import {
  isWitModulePath, synthesizeWitModule
} from '../lib/wit-module-synth.zena';
import { readWitSource } from 'wit-parser:document';
import { PackageConfig } from '../lib/module-resolver.zena';
import { assertFunctionUsesTimes } from './wat-invariants.zena';

let stdlibRoot = 'packages/stdlib/zena';
let fixtures = 'packages/zena-compiler/test-files/component';

class PlainHost implements CompilerHost {
  new();
  readFile(path: String): String {
    if (isWitModulePath(path)) {
      return synthesizeWitModule(path);
    }
    if (path.startsWith('zena:')) {
      return readFile(`${stdlibRoot}/${stdlibIdToRelativeFile(path)}`);
    }
    return readFile(path);
  }
}

/** Package map: the repo's, plus a WIT-backed `wasi` for the fixtures. */
let testPackages = (host: CompilerHost): HashMap<String, PackageConfig> => {
  let packages = loadPackageMap(host, 'zena-packages.json');
  let wasi = new PackageConfig('', null);
  wasi.witRoot = `${fixtures}/wit-pkg`;
  packages['wasi'] = wasi;
  return packages;
};

/** The compiled program, ready for whichever generator wants it. */
let programFor = (path: String, target: String): Program => {
  let host = new PlainHost();
  let packages = testPackages(host);
  let c = createCompiler(host, new CompilerOptions(target, stdlibRoot, packages));
  let result = c.compile(path);
  let checked = checkCompilation(result, null, false);
  for (let diag in checked.diagnostics) {
    if (diag.severity == DiagnosticSeverity.Error) {
      throw new Error(`${path}: ${diag.message}`);
    }
  }
  let entryAst = result.entry.ast;
  let units = new GrowableArray<CompilationUnit>();
  var entryUnit: CompilationUnit | null = null;
  for (let file in result.files) {
    let res = checked.results[file.path];
    if (res != null) {
      let unit = {ast: file.ast, model: res.model};
      units.push(unit);
      if (file.ast.path == entryAst.path) { entryUnit = unit; }
    }
  }
  return new Program(units, entryUnit);
};

let compileFor = (path: String, target: String): ByteArray => {
  let generator = new BinaryGenerator(target, false);
  if (target == 'component') {
    let host = new PlainHost();
    generator.runtimeMemoryModule = compileComponentRuntimeModule(
        host, stdlibRoot, loadPackageMap(host, 'zena-packages.json'));
    // The test `wasi` package's WIT, as the CLI passes its WIT-backed
    // packages' sources: the encoder emits those interfaces' true
    // types rather than deriving them from synthesized declarations.
    generator.importEncoder = makeImportEncoder(null, '',
        readWitSource(`${fixtures}/wit-pkg`));
  }
  return generator.generate(programFor(path, target)).toByteArray();
};

/** Compile against a declared world (`--wit`/`--world`'s path). */
let compileForWorld = (
  path: String,
  witSource: String,
  worldName: String
): ByteArray => {
  let generator = new BinaryGenerator('component', false);
  let host = new PlainHost();
  generator.runtimeMemoryModule = compileComponentRuntimeModule(
      host, stdlibRoot, loadPackageMap(host, 'zena-packages.json'));
  generator.importEncoder = makeImportEncoder(witSource, worldName);
  return generator.generate(programFor(path, 'component')).toByteArray();
};

/** The payload of the (`skip`+1)-th section with `id`, or empty. */
let sectionPayloadAfter = (bytes: ByteArray, id: i32, skip: i32): ByteArray => {
  var pos = 8;
  var remaining = skip;
  while (pos < bytes.length) {
    let sectionId = bytes[pos];
    pos += 1;
    var size = 0;
    var shift = 0;
    while (pos < bytes.length) {
      let b = bytes[pos];
      pos += 1;
      size = size | ((b & 0x7f) << shift);
      shift += 7;
      if ((b & 0x80) == 0) { break; }
    }
    if (sectionId == id) {
      if (remaining == 0) {
        let payload = newByteArray(size);
        for (var i = 0; i < size; i += 1) {
          payload[i] = bytes[pos + i];
        }
        return payload;
      }
      remaining -= 1;
    }
    pos += size;
  }
  return newByteArray(0);
};

/**
 * The core module's WAT. The component wrapper has no WAT form — it is
 * not core wasm — so this is the module nested inside it, which is where
 * the synthesized wrappers live.
 */
let watFor = (path: String, target: String): String =>
  new WatGenerator(target, false).generate(programFor(path, target));

/**
 * The section ids of a component or core module, in order. Both formats
 * are an 8-byte preamble followed by (id, size, payload) triples; only
 * the meaning of the ids differs.
 */
let sectionIds = (bytes: ByteArray): Array<i32> => {
  let ids = new GrowableArray<i32>();
  var pos = 8;
  while (pos < bytes.length) {
    ids.push(bytes[pos] as i32);
    pos += 1;
    var size = 0;
    var shift = 0;
    while (pos < bytes.length) {
      let b = bytes[pos];
      pos += 1;
      size = size | ((b & 0x7f) << shift);
      shift += 7;
      if ((b & 0x80) == 0) { break; }
    }
    pos += size;
  }
  return ids;
};

/** The payload of the first section with `id`, or an empty array. */
let sectionPayload = (bytes: ByteArray, id: i32): ByteArray => {
  var pos = 8;
  while (pos < bytes.length) {
    let sectionId = bytes[pos];
    pos += 1;
    var size = 0;
    var shift = 0;
    while (pos < bytes.length) {
      let b = bytes[pos];
      pos += 1;
      size = size | ((b & 0x7f) << shift);
      shift += 7;
      if ((b & 0x80) == 0) { break; }
    }
    if (sectionId == id) {
      let payload = newByteArray(size);
      for (var i = 0; i < size; i += 1) {
        payload[i] = bytes[pos + i];
      }
      return payload;
    }
    pos += size;
  }
  return newByteArray(0);
};

/**
 * Whether an export-section payload names `name`. The payload is names
 * and indices only, and an export name is length-prefixed, so a
 * byte-substring hit inside one of these is the name itself.
 */
let containsName = (payload: ByteArray, name: String): boolean => {
  if (payload.length < name.length) { return false; }
  for (var i = 0; i <= payload.length - name.length; i += 1) {
    var matches = true;
    for (var j = 0; j < name.length; j += 1) {
      if (payload[i + j] != name.getByteAt(j)) { matches = false; break; }
    }
    if (matches) { return true; }
  }
  return false;
};

let idsToString = (ids: Array<i32>): String => {
  var out = "";
  for (let id in ids) {
    if (out != "") { out = out + ","; }
    out = out + i32ToString(id);
  }
  return out;
};

export let tests = suite('Component emission', (): void => {
  test('the output is a component, not a core module', (ctx: TestContext): void => {
    // Same magic, and then version 0x000d with layer 0x0001 where a
    // core module has version 1. The layer is the whole difference to a
    // reader deciding which format it is holding.
    let bytes = compileFor(`${fixtures}/clock.zena`, 'component');
    equal(bytes[0], 0x00);
    equal(bytes[1], 0x61);
    equal(bytes[2], 0x73);
    equal(bytes[3], 0x6d);
    equal(bytes[4], 0x0d, 'component version low byte');
    equal(bytes[5], 0x00);
    equal(bytes[6], 0x01, 'component layer low byte');
    equal(bytes[7], 0x00);
  });

  test('an imported WIT interface produces the full section sequence', (ctx: TestContext): void => {
    // type (the instance type) / import / alias / canon lower / core
    // instance (the lowered functions) / core module / core instance
    // (instantiate) / alias (the core export) / type / canon lift /
    // export. Order is not cosmetic: each section's indices refer only
    // to what came before it.
    let ids = sectionIds(compileFor(`${fixtures}/clock.zena`, 'component'));
    equal(idsToString(ids), '7,10,6,8,2,1,2,6,7,8,11',
      `clock.zena emitted sections ${idsToString(ids)}`);
  });

  test('a p3 timer adds a canon section for the builtins', (ctx: TestContext): void => {
    // The same sequence as clock.zena with one addition: a second canon
    // section, holding the canonical builtins. They are not WIT
    // functions — no interface, no import, no declared type, only an
    // opcode — so they cannot ride in the lowering section beside the
    // imports they sit next to in the core module.
    let ids = sectionIds(compileFor(`${fixtures}/timer.zena`, 'component'));
    equal(idsToString(ids), '7,10,6,8,8,2,1,2,6,7,8,11',
      `timer.zena emitted sections ${idsToString(ids)}`);
  });

  test('the async entry replaces main', (ctx: TestContext): void => {
    // A program that sleeps is entered through the callback-lifted
    // `run`: it hands control back to the host while the timer runs and
    // is re-entered when it fires. Lifting `main` as well would offer
    // the host two entry points that mean different things — and the
    // one it would reach for returns before the timers it armed have
    // fired.
    let exportSection = sectionPayload(
        compileFor(`${fixtures}/timer.zena`, 'component'), 11);
    isTrue(containsName(exportSection, 'run'),
      'the timer component does not export `run`');
    isTrue(!containsName(exportSection, 'main'),
      'the timer component still exports `main` beside its async entry');
    // The synchronous case is unchanged: no driver, no async entry.
    let plain = sectionPayload(
        compileFor(`${fixtures}/clock.zena`, 'component'), 11);
    isTrue(containsName(plain, 'main'),
      'a component with no async driver does not export `main`');
  });

  test('a component with no imports carries no import machinery', (ctx: TestContext): void => {
    // No instance type, no import, no lowering, no synthesized instance
    // — just the module, its instantiation, and the lifted export. This
    // is the one-core-module case: a component that imports nothing
    // memory-carrying needs no second module.
    let ids = sectionIds(
        compileFor('packages/zena-compiler/test-files/minimal.zena', 'component'));
    equal(idsToString(ids), '1,2,6,7,8,11',
      `minimal.zena emitted sections ${idsToString(ids)}`);
  });

  test('the component embeds the core module verbatim', (ctx: TestContext): void => {
    // Emission is a wrapper, not a second backend: the module inside the
    // component is the same module the compiler emits for a hostless
    // core-module target, byte for byte. If these ever diverge, some
    // target knowledge has leaked into codegen, where the design says
    // there is none.
    let component = compileFor(`${fixtures}/scalars.zena`, 'component');
    let core = compileFor(`${fixtures}/scalars.zena`, 'freestanding');
    let embedded = sectionPayload(component, 1);
    equal(embedded.length, core.length,
      `the embedded core module is ${i32ToString(embedded.length)} bytes and ` +
      `the freestanding module is ${i32ToString(core.length)}`);
    for (var i = 0; i < core.length; i += 1) {
      if (embedded[i] != core[i]) {
        throw new Error(
          `the embedded core module differs from the freestanding module at ` +
          `byte ${i32ToString(i)}`);
      }
    }
  });

  test('a core-module import namespace is rejected', (ctx: TestContext): void => {
    // `env` is not a WIT interface, and no host can satisfy it through
    // a component's import. Emitting one anyway would produce a
    // component that nothing can instantiate, which is a worse failure
    // than not compiling.
    throws((): void => {
      compileFor(`${fixtures}/env-import.zena`, 'component');
    }, 'an @external in the `env` namespace compiled for the component target');
  });

  test('a string on an import is rejected', (ctx: TestContext): void => {
    // The asymmetry is structural rather than a missing case. An export
    // takes its memory from the program module, which exists by the time
    // anything is lifted; a lowered import has to exist before the
    // program module is instantiated, so its memory has to come from
    // somewhere earlier. That is the runtime module, and it is C3.
    throws((): void => {
      compileFor(`${fixtures}/string-import.zena`, 'component');
    }, 'a String-taking import compiled for the component target');
  });

  test('a string export is lifted through a wrapper, with memory options',
      (ctx: TestContext): void => {
    // The canonical ABI calls a `string`-taking export with a pointer and
    // a length; the Zena function takes a String. The wrapper is what has
    // the signature the ABI expects, and the lift names it rather than
    // the program's own function.
    let bytes = compileFor(`${fixtures}/strings.zena`, 'component');
    // Two core modules: the runtime memory module first, then the
    // program. The program's export section is in the second.
    let runtimeExports = sectionPayload(sectionPayload(bytes, 1), 7);
    isTrue(containsName(runtimeExports, 'realloc'),
      'the runtime module does not export its allocator');
    isTrue(containsName(runtimeExports, 'memory'),
      'the runtime module does not export its memory');
    let coreExports = sectionPayload(sectionPayloadAfter(bytes, 1, 1), 7);
    isTrue(containsName(coreExports, 'greet$componentExport'),
      'the core module does not export a wrapper for `greet`');
    isTrue(containsName(coreExports, 'cabi_post_return'),
      'the core module does not export post-return');
    // The allocator and the memory are the runtime module's; exporting
    // them from the program too would be a second name for each, and
    // the program does not even define a memory to export.
    isTrue(!containsName(coreExports, 'cabi_realloc'),
      'the program still exports cabi_realloc beside the runtime module');
    isTrue(!containsName(coreExports, 'memory'),
      'the program still exports a memory it no longer defines');
    // The program's memory is imported from the runtime module.
    let coreImports = sectionPayload(sectionPayloadAfter(bytes, 1, 1), 2);
    isTrue(containsName(coreImports, 'zena:runtime'),
      'the program does not import from the runtime namespace');
    // The wrapper is a core export only: the component still exports the
    // name the program wrote.
    let componentExports = sectionPayload(bytes, 11);
    isTrue(containsName(componentExports, 'greet'),
      'the component does not export `greet`');
    isTrue(!containsName(componentExports, 'greet$componentExport'),
      'the wrapper leaked out as a component export');
  });

  test('a string-moving component embeds the runtime memory module first',
      (ctx: TestContext): void => {
    // Two core-module sections and two instantiations, runtime first:
    // its memory must exist before the program module that imports it —
    // the same ordering a memory-carrying `canon lower` will need
    // (docs/design/component-emission.md, 1.3).
    let ids = sectionIds(compileFor(`${fixtures}/strings.zena`, 'component'));
    equal(idsToString(ids), '1,2,1,2,6,7,8,11',
      `strings.zena emitted sections ${idsToString(ids)}`);
  });

  test('a wrapper releases every argument buffer it is handed',
      (ctx: TestContext): void => {
    // The host lowers a `string` argument through the *lifted*
    // function's `realloc`, so the bytes come out of the guest's own
    // allocator and are the guest's to free. `post-return` is handed the
    // return area and cannot reach them, so a wrapper that does not
    // release leaks a block per call — invisible to the end-to-end
    // script, which invokes each export once.
    //
    // Counted rather than merely present: one release per string
    // argument, so a second copy would be a double free and none would
    // be the leak.
    let wat = watFor(`${fixtures}/strings.zena`, 'component');
    assertFunctionUsesTimes(wat, '$greet$componentExport',
      'call $releaseStringArgument', 1,
      'the argument buffer is the guest\'s to free');
    assertFunctionUsesTimes(wat, '$measure$componentExport',
      'call $releaseStringArgument', 1,
      'a string argument is released whatever the result type');
    // A result carries no buffer of the guest's to release on the way
    // in: it is allocated during the call and freed by post-return.
    assertFunctionUsesTimes(wat, '$shout$componentExport',
      'call $releaseStringArgument', 0,
      'an export taking no string has nothing to release');
  });

  test('a component moving no strings links none of the marshaling',
      (ctx: TestContext): void => {
    // `zena:component-abi` is in the component target's prelude, so it is
    // loaded for every program. Reachability is what keeps it out: the
    // allocator and the copy loops are rooted only when a String
    // actually crosses an export, so the timer and clock components are
    // emitted exactly as they were before any of this existed.
    let bytes = compileFor(`${fixtures}/clock.zena`, 'component');
    let coreExports = sectionPayload(sectionPayload(bytes, 1), 7);
    isTrue(!containsName(coreExports, 'cabi_realloc'),
      'a component with no strings still links the canonical allocator');
    // And with no linear memory there is no runtime module either: one
    // core-module section, and it is the program.
    isTrue(sectionPayloadAfter(bytes, 1, 1).length == 0,
      'a memory-free component still embeds the runtime memory module');
  });

  test('imported interfaces are encoded from derived WIT', (ctx: TestContext): void => {
    // The emitter no longer hand-writes instance types: the shape's
    // imports are rendered as a WIT document and pushed through the
    // same encoder that round-trips real WIT through wasm-tools. For a
    // flat-scalar interface the bytes come out identical to the old
    // hand-written ones, which the exact-section tests above pin; this
    // pins the derivation itself.
    let paramTypes = new GrowableArray<i32>();
    paramTypes.push(0x73); // string
    let paramNames = new GrowableArray<String>();
    paramNames.push('a0');
    let sig = new ComponentFuncType(paramTypes, paramNames, 0x79, false);
    let shape = new ComponentShape();
    shape.imports.push(new ComponentImportFunc(
        'test:probe/things@1.0.0', 'poke', sig));
    let text = deriveImportsWit(shape);
    isTrue(text.contains('package test:probe@1.0.0 {'),
      'the derived document does not declare the package');
    isTrue(text.contains('interface things {'),
      'the derived document does not declare the interface');
    isTrue(text.contains('poke: func(a0: string) -> u32;'),
      `the derived function is wrong:\n${text}`);
    isTrue(text.contains('import test:probe/things@1.0.0;'),
      'the derived world does not import the interface');
    let encoded = encodeImportTypes(shape);
    equal(encoded.instanceCount, 1);
    if (let (true, index) = encoded.instanceIndices.get('test:probe/things@1.0.0')) {
      equal(index, 0);
    } else {
      throw new Error('the encoded world lost the interface');
    }
  });

  test('an interface name without a package path is rejected', (ctx: TestContext): void => {
    // "a:b" passes the colon check but is not a WIT interface path, so
    // no WIT document can be derived for it. Before the encoder wiring
    // this emitted an import name no host could match; now it is a
    // compile error naming the expected shape.
    let sig = new ComponentFuncType(new GrowableArray<i32>(), new GrowableArray<String>(),
        -1, false);
    let shape = new ComponentShape();
    shape.imports.push(new ComponentImportFunc('a:b', 'poke', sig));
    throws((): void => {
      deriveImportsWit(shape);
    }, "an interface name with no '/' derived a WIT document");
  });

  test('a declared world is the import surface, used or not',
      (ctx: TestContext): void => {
    // The world imports an interface the program never calls. With a
    // declared world the component's imports are the world's, so the
    // unused instance is imported anyway — a host must satisfy the
    // world, not the subset a particular build happened to reach.
    let wit = `package test:probe@1.0.0;

interface extras {
  ping: func() -> u32;
}

world probe {
  import extras;
  export main: func() -> s32;
}
`;
    let bytes = compileForWorld(
        'packages/zena-compiler/test-files/minimal.zena', wit, 'probe');
    isTrue(containsName(sectionPayload(bytes, 10), 'test:probe/extras@1.0.0'),
      'the unused world import is missing from the import section');
  });

  test('disagreements between a declared world and the program are errors',
      (ctx: TestContext): void => {
    // Both directions, and types: a world export the program lacks, a
    // program export the world lacks, and a shared export whose types
    // differ. Each is a compile error naming the mismatch, not a
    // component that fails at instantiation.
    let missingInProgram = `package test:probe@1.0.0;
world probe {
  export main: func() -> s32;
  export absent: func() -> u32;
}
`;
    throws((): void => {
      compileForWorld('packages/zena-compiler/test-files/minimal.zena',
          missingInProgram, 'probe');
    }, 'a world export the program lacks compiled anyway');

    let missingInWorld = `package test:probe@1.0.0;
world probe {
}
`;
    throws((): void => {
      compileForWorld('packages/zena-compiler/test-files/minimal.zena',
          missingInWorld, 'probe');
    }, 'a program export the world lacks compiled anyway');

    let wrongType = `package test:probe@1.0.0;
world probe {
  export main: func() -> string;
}
`;
    throws((): void => {
      compileForWorld('packages/zena-compiler/test-files/minimal.zena',
          wrongType, 'probe');
    }, 'a type disagreement compiled anyway');
  });

  test('a declared world resolves without --world when it is alone',
      (ctx: TestContext): void => {
    let wit = `package test:probe@1.0.0;
world only {
  export main: func() -> s32;
}
`;
    let bytes = compileForWorld(
        'packages/zena-compiler/test-files/minimal.zena', wit, '');
    isTrue(containsName(sectionPayload(bytes, 11), 'main'),
      'the sole world did not resolve');
    throws((): void => {
      compileForWorld('packages/zena-compiler/test-files/minimal.zena',
          wit, 'nope');
    }, "--world named a world the document does not declare");
  });

  test('a WIT-typed module imports the interface as its WIT declares it',
      (ctx: TestContext): void => {
    // `import {now} from 'wasi:clocks/monotonic-clock'` — the
    // signature comes from the package's WIT, and so does the emitted
    // instance type: the package's source is spliced whole, so the
    // component imports the real interface — named types exported,
    // every function declared — not a derivation from the synthesized
    // core-shaped declarations, and not just the slice the program
    // touched.
    let viaWit = compileFor(`${fixtures}/clock-wit.zena`, 'component');
    isTrue(containsName(sectionPayload(viaWit, 10),
        'wasi:clocks/monotonic-clock@0.3.0'),
      'the interface import is missing');
    let instanceTypes = sectionPayload(viaWit, 7);
    isTrue(containsName(instanceTypes, 'instant'),
      "the interface's named alias is not exported from its instance type");
    isTrue(containsName(instanceTypes, 'wait-for'),
      'the whole interface should be imported, not just the used slice');
  });

  test('a WIT-typed module stages strings and lifts spilled results',
      (ctx: TestContext): void => {
    // The synthesized source for an interface with strings and lists:
    // the raw declaration carries the canonically flattened core
    // signature — two i32s per staged value, a trailing return-area
    // address when the result spills past one core value — and the
    // wrapper stages before the call, releases after it, and lifts the
    // result through zena:component-abi.
    let source = synthesizeWitModule(
        `wit:${fixtures}/wit-pkg#wasi:text/transform`);
    isTrue(source.contains(
        'declare function upper_raw(p0: i32, l0: i32, ret: i32): void;'),
      'the raw string->string declaration is misflattened:\n' + source);
    isTrue(source.contains('let (p0, l0) = stageString(input);'),
      'the string argument is not staged:\n' + source);
    isTrue(source.contains('releaseStagedFrom(m0);'),
      'the staged argument is not released:\n' + source);
    isTrue(source.contains('let out = liftStringAt(ret);'),
      'the spilled string result is not lifted:\n' + source);
    isTrue(source.contains('freeLifted(ret);'),
      'the return area is not freed:\n' + source);
    // A scalar result with a staged parameter returns directly.
    isTrue(source.contains(
        'declare function measure_raw(p0: i32, l0: i32): u32;'),
      'a scalar result should not spill:\n' + source);
    // A byte list stages and lifts through its own helpers.
    isTrue(source.contains('stageByteList(data)'),
      'the byte-list argument is not staged:\n' + source);
    isTrue(source.contains('liftBytesAt(ret)'),
      'the byte-list result is not lifted:\n' + source);
    isTrue(source.contains('): FixedArray<u8> {'),
      'the byte-list result type is wrong:\n' + source);
    // list<string> lifts through a generated list helper whose
    // elements are (ptr, len) pairs at an 8-byte stride.
    isTrue(source.contains('liftStringAt(base + i * 8)'),
      'the string-list result is not lifted:\n' + source);
    // A scalar parameter beside a staged one passes through unstaged.
    isTrue(source.contains(
        'declare function describe_raw(a0: u32, ret: i32): void;'),
      'a scalar parameter should pass through:\n' + source);
  });

  test('a WIT-typed module synthesizes enums and flags',
      (ctx: TestContext): void => {
    // A WIT `enum` becomes a Zena enum with explicit ordinals (the
    // ordinal is the wire discriminant), a `flags` becomes a distinct
    // u32 with one constant per label, and the wrappers cast at the
    // boundary — with a range-checked lift on an enum result, so an
    // out-of-range discriminant is a loud error rather than a value
    // that defeats exhaustive matching later.
    let source = synthesizeWitModule(
        `wit:${fixtures}/wit-pkg#wasi:codes/status`);
    isTrue(source.contains('export enum Level {'),
      'no synthesized enum:\n' + source);
    isTrue(source.contains('FatalError = 2,'),
      'enum ordinals should be explicit and PascalCase:\n' + source);
    isTrue(source.contains('export distinct type Modes = u32;'),
      'no synthesized flags type:\n' + source);
    isTrue(source.contains('export let modesAppend = (4 as u32) as Modes;'),
      'flag constants should be powers of two:\n' + source);
    isTrue(source.contains(
        'declare function describe_raw(a0: i32, ret: i32): void;'),
      'an enum parameter is one raw i32:\n' + source);
    isTrue(source.contains('return liftLevel(got);'),
      'an enum result is not lifted:\n' + source);
    isTrue(source.contains('invalid Level discriminant'),
      'the enum lift should range-check:\n' + source);
    isTrue(source.contains('combine_raw(m as u32, extra as u32)'),
      'flags parameters should cast through u32:\n' + source);
    // And the fixture importing all of it emits a component naming the
    // interface.
    let bytes = compileFor(`${fixtures}/codes-wit.zena`, 'component');
    isTrue(containsName(sectionPayload(bytes, 10),
        'wasi:codes/status@1.0.0'),
      'the codes interface import is missing');
  });

  test('a WIT-typed module synthesizes records, variants and lifts',
      (ctx: TestContext): void => {
    // The aggregate surface: records as case classes, variants as
    // sealed hierarchies (cases prefixed with the variant's name),
    // and generated lift helpers reading the canonical layout out of
    // a spilled return area — offsets computed per the canonical
    // ABI's size-and-alignment rules.
    let source = synthesizeWitModule(
        `wit:${fixtures}/wit-pkg#wasi:geo/survey`);
    isTrue(source.contains(
        'export class Point(x: f64, y: f64, label: String)'),
      'the record is not a case class:\n' + source);
    isTrue(source.contains('export sealed class Finding {'),
      'the variant is not a sealed class:\n' + source);
    isTrue(source.contains('case FindingNothing'),
      'a unit case should be prefixed and bare:\n' + source);
    isTrue(source.contains('case FindingAt(value: Point)'),
      'a payload case should carry its lifted type:\n' + source);
    // Point: x@0, y@8, label@16 — the string field's pair sits after
    // two f64s, and the record helper lifts it in place.
    isTrue(source.contains('liftStringAt(ptr + 16)'),
      "the record's string field offset is wrong:\n" + source);
    // Reading: quality (1-byte enum disc) @0, option<u16> @2 — the
    // option aligns to its u16 payload.
    isTrue(source.contains('liftQuality(loadU8(ptr))'),
      "the record's enum field is not lifted:\n" + source);
    // list<reading>: stride 6 (disc byte, pad, u16 option payload,
    // padded to align 2).
    isTrue(source.contains('base + i * 6'),
      "the reading list's stride is wrong:\n" + source);
    // check() lifts into the inline Result.
    isTrue(source.contains('): Result<Point, Finding> {'),
      'a top-level result should be the inline Result:\n' + source);
    isTrue(source.contains('return (true, ok, _);'),
      "the result's ok arm is not built:\n" + source);
    // bounds() is a tuple of records.
    isTrue(source.contains('): (Point, Point) {'),
      'a tuple result should be an inline tuple:\n' + source);
    // And the consumer fixture compiles to a component naming the
    // interface.
    let bytes = compileFor(`${fixtures}/geo-wit.zena`, 'component');
    isTrue(containsName(sectionPayload(bytes, 10),
        'wasi:geo/survey@1.0.0'),
      'the geo interface import is missing');
  });

  test('an async WIT import with a result lifts through the return area',
      (ctx: TestContext): void => {
    // `fetch-point: async func(name: string) -> result<point,
    // finding>` — the async lowering flattens the staged string (two
    // core values, within the async limit of four), appends the
    // return-area address, and hands back the packed subtask. The
    // wrapper is an async function: stage, call, await the driver,
    // release its own staging range, then lift the result the host
    // wrote — into Outcome, because a future's payload must be
    // storable and the inline Result is return-position-only.
    let source = synthesizeWitModule(
        `wit:${fixtures}/wit-pkg#wasi:geo/survey`);
    isTrue(source.contains(
        '@external("wasi:geo/survey@1.0.0", "fetch-point", "async")'),
      'the raw import is not async-lowered:\n' + source);
    isTrue(source.contains(
        'declare function fetchPoint_raw(p0: i32, l0: i32, ret: i32): i32;'),
      'the async raw signature is wrong:\n' + source);
    isTrue(source.contains(
        'export async function fetchPoint(name: String): ' +
        'Future<Outcome<Point, Finding>> {'),
      'the wrapper should be an async function returning an ' +
      'Outcome:\n' + source);
    isTrue(source.contains('await awaitPacked(packed);'),
      'the wrapper does not await its subtask:\n' + source);
    isTrue(source.contains('return new Ok<Point, Finding>(ok);'),
      "the result's ok arm should be an Outcome:\n" + source);
    // An async function with a rich parameter and no result also
    // rides the async wrapper, still Future<void>.
    isTrue(source.contains(
        'export async function pushLabels(names: Array<String>): ' +
        'Future<void> {'),
      'the rich-parameter async wrapper is wrong:\n' + source);
    // And the consumer awaiting both compiles to a component.
    let bytes = compileFor(`${fixtures}/fetch-wit.zena`, 'component');
    isTrue(containsName(sectionPayload(bytes, 11), 'run'),
      'an awaiting program should be entered through the async entry');
  });

  test('a WIT-typed module lowers aggregate parameters into flat slots',
      (ctx: TestContext): void => {
    // The mirror of the lift half: an aggregate parameter flattens
    // into zero-initialized slot variables the wrapper fills — a
    // record field by field, a variant through an if chain writing
    // the discriminant and its own arm's prefix of the shared payload
    // slots, an option leaving its slots at zero when none — with
    // staged buffers registered in the arena and one releaseStaged()
    // after the call. A list parameter stages an element buffer and
    // writes each element at its canonical stride.
    let source = synthesizeWitModule(
        `wit:${fixtures}/wit-pkg#wasi:geo/survey`);
    // point flattens to [f64, f64, i32, i32].
    isTrue(source.contains(
        'declare function labelOf_raw(s0_0: f64, s0_1: f64, s0_2: i32, ' +
        's0_3: i32): u32;'),
      "the record parameter's raw slots are wrong:\n" + source);
    isTrue(source.contains('var s0_0: f64 = 0.0;'),
      'slot variables should be zero-initialized:\n' + source);
    // The variant's arms share slots: text(string) stages, id(u32)
    // casts, empty writes only the discriminant.
    isTrue(source.contains('if (n is NoteText) {'),
      'the variant lowering chain is missing:\n' + source);
    isTrue(source.contains('} else if (n is NoteId) {'),
      'the variant chain should else-if through the cases:\n' + source);
    // The option wraps its payload staging in the Some arm.
    isTrue(source.contains('if (n is Some<String>) {'),
      'the option lowering is missing:\n' + source);
    // The list parameter stages elements at the string pair stride.
    isTrue(source.contains('stageBuffer('),
      'the list parameter does not stage a buffer:\n' + source);
    isTrue(source.contains('releaseStagedFrom(m0);'),
      'staged lowerings must release after the call:\n' + source);
    // finding's payloads join f64 (at: point) against i32 (message:
    // string), which the flat form cannot spell yet — refused loudly.
    isTrue(source.contains(
        'report: parameter \'f\': its variant payloads join across ' +
        'core types'),
      'the cross-type join should be refused:\n' + source);
  });

  test('a WIT-typed module synthesizes resource classes',
      (ctx: TestContext): void => {
    // A resource is a Disposable class owning the imported handle:
    // methods lead their raw calls with the handle, the WIT
    // constructor is `static create`, statics are statics, disposal
    // is the canonical `resource.drop` (idempotent behind a flag),
    // and a bare resource in value position — implicit `own` — wraps
    // the returned handle.
    let source = synthesizeWitModule(
        `wit:${fixtures}/wit-pkg#wasi:store/kv`);
    isTrue(source.contains(
        'export final class Bucket implements Disposable {'),
      'the resource is not a Disposable class:\n' + source);
    isTrue(source.contains('bucketDrop_raw(this.#handle);'),
      'dispose does not drop the handle:\n' + source);
    isTrue(source.contains(
        '@external("canon", "resource.drop", ' +
        '"resource:wasi:store/kv@1.0.0#bucket")'),
      'the drop builtin is not typed by the imported resource:\n' +
      source);
    isTrue(source.contains(
        'declare function bucketGet_raw(self: i32, p0: i32, l0: i32, ' +
        'ret: i32): void;'),
      "the method's raw declaration should lead with self:\n" + source);
    isTrue(source.contains('  get(key: String): Option<String> {'),
      'the method wrapper is not a member:\n' + source);
    isTrue(source.contains('  static create(name: String): Bucket {'),
      'the WIT constructor should be static create:\n' + source);
    isTrue(source.contains('return new Bucket(got);'),
      'an own result should wrap the returned handle:\n' + source);
    isTrue(source.contains('this.#handle, p0, l0'),
      'the method call should pass the handle first:\n' + source);
    // An own parameter consumes: the wrapper is marked moved, so its
    // later dispose cannot drop a handle the callee owns now. A
    // borrow parameter is not.
    isTrue(source.contains('other.[markMoved]();'),
      'an own parameter should mark the wrapper moved:\n' + source);
    isTrue(!source.contains('b.[markMoved]();'),
      'a borrow parameter must not mark the wrapper moved:\n' + source);
    // And the consumer fixture compiles to a component naming the
    // interface, with the alias for the drop's nominal type carrying
    // the resource's name.
    let bytes = compileFor(`${fixtures}/store-wit.zena`, 'component');
    isTrue(containsName(sectionPayload(bytes, 10),
        'wasi:store/kv@1.0.0'),
      'the store interface import is missing');
  });

  test('a WIT stream<u8> binds to Stream through the pumps',
      (ctx: TestContext): void => {
    // A `stream<u8>` in any position is one end-handle on the wire
    // and `zena:stream`'s `Stream<u8>` in the signature, connected by
    // `zena:component-stream`'s pumps: `lowerByteStream` going in
    // (fresh pair, pump, pass the readable end), `liftByteStream`
    // coming out. Streams inside aggregates ride the same expression
    // forms as any handle. Non-u8 elements and future values refuse.
    let source = synthesizeWitModule(
        `wit:${fixtures}/wit-pkg#wasi:pipe/pipes`);
    isTrue(source.contains("import { Stream } from 'zena:stream';"),
      'the stream type is not imported:\n' + source);
    isTrue(source.contains(
        "import { liftByteStream, lowerByteStream } " +
        "from 'zena:component-stream';"),
      'the pumps are not imported:\n' + source);
    // A direct stream result: one flat i32, lifted without a spill.
    isTrue(source.contains('declare function source_raw(): i32;'),
      "the stream result's raw declaration is wrong:\n" + source);
    isTrue(source.contains('export function source(): Stream<u8> {'),
      'a stream result should be a Stream<u8>:\n' + source);
    isTrue(source.contains('return liftByteStream(got);'),
      'a direct stream result should lift through the pump:\n' +
      source);
    // A stream parameter: lowered in argument position.
    isTrue(source.contains('declare function sink_raw(a0: i32): u32;'),
      "the stream parameter's raw declaration is wrong:\n" + source);
    isTrue(source.contains('sink_raw(lowerByteStream(data))'),
      'a stream parameter should lower through the pump:\n' + source);
    // Streams inside aggregates: a spilled tuple result and an
    // option, both lifting each end from memory.
    isTrue(source.contains('): (Stream<u8>, Stream<u8>) {'),
      'a tuple of streams should be an inline tuple:\n' + source);
    isTrue(source.contains('liftByteStream(loadI32(ptr))'),
      'a stream in an aggregate is not lifted from memory:\n' + source);
    isTrue(source.contains('liftByteStream(loadI32(ptr + 4))'),
      "the tuple's second stream is not lifted at its offset:\n" +
      source);
    // The async transfer: the stream lowers beside the return area.
    isTrue(source.contains(
        'declare function transfer_raw(a0: i32, ret: i32): i32;'),
      "the async raw signature is wrong:\n" + source);
    isTrue(source.contains(
        'export async function transfer(data: Stream<u8>): ' +
        'Future<u64> {'),
      'the async wrapper should carry the stream parameter:\n' +
      source);
    // The refused shapes say why.
    isTrue(source.contains(
        'ints: the result: stream elements other than u8 wait'),
      'a non-u8 stream element should refuse:\n' + source);
    isTrue(source.contains(
        'ping: the result: a bare future waits'),
      'a bare future should refuse:\n' + source);
    // And the consumer fixture compiles to a component naming the
    // interface.
    let bytes = compileFor(`${fixtures}/pipe-wit.zena`, 'component');
    isTrue(containsName(sectionPayload(bytes, 10),
        'wasi:pipe/pipes@1.0.0'),
      'the pipe interface import is missing');
  });

  test('a WIT future<T> binds to Future through generated helpers',
      (ctx: TestContext): void => {
    // A `future<T>` in any position is one end-handle on the wire
    // and a `Future` in the signature, moved by generated
    // per-payload-type helpers: each payload type gets its own five
    // canon builtin declares — the field disambiguated `#k` so
    // several payload types coexist as distinct core imports — at
    // the payload's own component type. A `result` payload rides
    // `Outcome`, and a bare arm — in a future payload or a plain
    // sync result — is a `void` lane filled by `witUnit()`.
    let source = synthesizeWitModule(
        `wit:${fixtures}/wit-pkg#wasi:pipe/pipes`);
    // A scalar-payload future result, lifted directly.
    isTrue(source.contains('export function finish(): Future<u32> {'),
      'a future result should be a Future:\n' + source);
    isTrue(source.contains('return liftFuture0(got);'),
      'a direct future result should lift through its helper:\n' +
      source);
    isTrue(source.contains(
        '@external("canon", "future.read#0", ' +
        '"future:wasi:pipe/pipes@1.0.0#u32,async")'),
      "the read builtin is not typed by the payload:\n" + source);
    // The future parameter: an Outcome payload with a bare ok arm.
    isTrue(source.contains(
        'export function deliver(done: Future<Outcome<void, ' +
        'PipeError>>): u32 {'),
      'a future parameter should carry Outcome with a void lane:\n' +
      source);
    isTrue(source.contains('deliver_raw(lowerFuture1(done))'),
      'a future parameter should lower through its helper:\n' +
      source);
    isTrue(source.contains(
        '@external("canon", "future.write#1", ' +
        '"future:wasi:pipe/pipes@1.0.0#result<_, pipe-error>,async")'),
      "the write builtin is not typed by the payload:\n" + source);
    isTrue(source.contains('return new Ok<void, PipeError>(witUnit());'),
      "the bare ok arm should lift as witUnit:\n" + source);
    // The pump lowers the Outcome into the canonical variant layout.
    isTrue(source.contains('async function pumpFuture1(value: ' +
        'Future<Outcome<void, PipeError>>, end: i32): Future<void> {'),
      'the lower pump is missing:\n' + source);
    isTrue(source.contains('if (v is Ok<void, PipeError>) {'),
      'the pump should lower the Outcome by case:\n' + source);
    // A rich future inside a tuple lifts from memory by helper.
    isTrue(source.contains('liftFuture2(loadI32('),
      'a future in an aggregate should lift from memory:\n' + source);
    isTrue(source.contains(
        'Future<Outcome<Option<String>, PipeError>>'),
      "the rich payload's Zena type is wrong:\n" + source);
    // A sync bare-arm result rides the inline Result's void lane.
    isTrue(source.contains(
        'export function commit(): Result<void, PipeError> {'),
      'a sync bare-arm result should be Result<void, E>:\n' + source);
    isTrue(source.contains('return (true, witUnit(), _);'),
      "the sync bare ok arm should return witUnit:\n" + source);
    // And the consumer fixture compiles to a component.
    let bytes = compileFor(`${fixtures}/pipe-wit.zena`, 'component');
    isTrue(containsName(sectionPayload(bytes, 10),
        'wasi:pipe/pipes@1.0.0'),
      'the pipe interface import is missing');
  });

  test('a WIT interface reaches another interface through use',
      (ctx: TestContext): void => {
    // `forwarding` does `use data.{packet, fault, channel, level}`:
    // the used types' declarations live in `data`'s synthesized
    // module, so `forwarding`'s module imports them — the sealed base
    // and every case, for a variant — and declares nothing locally.
    // The resource crosses because the marshaling symbols live in
    // `zena:component-abi`, one identity for every synthesized
    // module, rather than per-module.
    let source = synthesizeWitModule(
        `wit:${fixtures}/wit-pkg#wasi:relay/forwarding`);
    isTrue(source.contains(
        "import { Level, Packet, Fault, FaultLost, FaultGarbled, " +
        "Channel } from 'wasi:relay/data';"),
      'the used types are not imported from the sibling module:\n' +
      source);
    isTrue(!source.contains('export class Packet'),
      'a used record must not be re-declared:\n' + source);
    isTrue(!source.contains('export sealed class Fault'),
      'a used variant must not be re-declared:\n' + source);
    isTrue(source.contains(
        'export async function forward(p: Packet): ' +
        'Future<Outcome<Packet, Fault>> {'),
      'the used types should spell the signature:\n' + source);
    isTrue(source.contains('attach(c: Channel): u32'),
      'a used resource parameter is not rendered:\n' + source);
    isTrue(source.contains('c.[rawHandle]()'),
      "the used resource's handle member is not reached:\n" + source);
    isTrue(source.contains('function liftLevel(disc: i32): Level {'),
      'the enum lift should name the imported enum:\n' + source);
    isTrue(source.contains(
        '"future:wasi:relay/forwarding@1.0.0#result<_, fault>'),
      "the future's canon type should name the using interface:\n" +
      source);
    // A bare `-> result` has two outcomes and no payloads: a boolean.
    isTrue(source.contains('export function reset(): boolean {'),
      'a bare result should be a boolean:\n' + source);
    isTrue(source.contains('return got == 0;'),
      "the bare result's wire discriminant is the boolean:\n" + source);
    // The declaring module still declares, importing the shared
    // marshaling symbols from the abi.
    let dataSource = synthesizeWitModule(
        `wit:${fixtures}/wit-pkg#wasi:relay/data`);
    isTrue(dataSource.contains(
        'export class Packet(level: Level, body: String)'),
      "the declaring module lost its record:\n" + dataSource);
    isTrue(dataSource.contains('rawHandle, markMoved'),
      'the marshaling symbols should come from the abi:\n' +
      dataSource);
    isTrue(!dataSource.contains('symbol rawHandle;'),
      'per-module symbols must be gone:\n' + dataSource);
    // And a consumer using classes from BOTH modules compiles, with
    // both interfaces imported — `data` first (dependency order), so
    // the forwarding import is the second import section.
    let bytes = compileFor(`${fixtures}/relay-wit.zena`, 'component');
    isTrue(containsName(sectionPayload(bytes, 10),
        'wasi:relay/data@1.0.0'),
      'the data interface import is missing');
    isTrue(containsName(sectionPayloadAfter(bytes, 10, 1),
        'wasi:relay/forwarding@1.0.0'),
      'the forwarding interface import is missing');
  });

  test('a stream-only program still gets the async entry',
      (ctx: TestContext): void => {
    // `pipe.zena` awaits canonical copies (`awaitWaitable`) but never
    // an async-lowered import (`awaitPacked`): the driver's rooting
    // gate must open for either door, or the entry stays sync-lifted
    // and stream events are never dispatched.
    let bytes = compileFor(`${fixtures}/pipe.zena`, 'component');
    isTrue(containsName(sectionPayload(bytes, 11), 'run'),
      'a stream-awaiting program should be entered through the ' +
      'async entry');
  });

  test('a marshaling import lowers with the canonical memory options',
      (ctx: TestContext): void => {
    // text-wit.zena imports the whole transform interface. Every one of
    // its lowers moves bytes, so each carries (memory 0) (realloc 0) —
    // the runtime memory module's, aliased ahead of the lowers — and
    // the component imports the interface by its qualified name.
    let bytes = compileFor(`${fixtures}/text-wit.zena`, 'component');
    isTrue(containsName(sectionPayload(bytes, 10),
        'wasi:text/transform@1.0.0'),
      'the interface import is missing');
    let lowers = sectionPayload(bytes, 8);
    isTrue(lowers.length > 0, 'no canon lower section');
    var sawMemoryOptions = false;
    for (var i = 0; i + 4 < lowers.length; i += 1) {
      if (lowers[i] == 0x02 && lowers[i + 1] == 0x03 &&
          lowers[i + 2] == 0x00 && lowers[i + 3] == 0x04 &&
          lowers[i + 4] == 0x00) {
        sawMemoryOptions = true;
      }
    }
    isTrue(sawMemoryOptions,
      'no lower carries (memory 0) (realloc 0)');
  });

  test('a printing component declares the stream type for its builtins',
      (ctx: TestContext): void => {
    // p3 stdio: the guest creates a `stream<u8>` and writes through the
    // canonical `stream.write`. The stream/future builtins are
    // per-type — the canon entry's immediate is a component type
    // index — so a type section right before the builtins declares
    // `(stream u8)` (0x66, present element, u8), continuing the index
    // space the import front matter used.
    let bytes = compileFor(`${fixtures}/print.zena`, 'component');
    // Front matter declares one instance type per imported interface
    // (types, stdout, stderr); the fourth type section is the canon
    // types'.
    let canonTypes = sectionPayloadAfter(bytes, 7, 3);
    equal(canonTypes.length, 4, 'the canon-type section payload');
    equal(canonTypes[0], 0x01); // one type
    equal(canonTypes[1], 0x66); // stream
    equal(canonTypes[2], 0x01); // element present
    equal(canonTypes[3], 0x7d); // u8
    // The second canon section holds the builtins. stream.write (0x10)
    // carries the type index and its options — async (0x06), so a full
    // stream returns BLOCKED rather than gating on wasmtime's
    // sync-builtins feature, and the memory (0x03) its bytes move
    // through; waitable-set.wait (0x20) carries the not-cancellable
    // byte and the memory its event pair lands in; stream.new (0x0e)
    // carries the type index alone.
    let builtins = sectionPayloadAfter(bytes, 8, 1);
    isTrue(builtins.length > 0, 'no builtins canon section');
    var sawWrite = false;
    var sawWait = false;
    var sawNew = false;
    for (var i = 1; i < builtins.length; i += 1) {
      if (builtins[i] == 0x10 && builtins[i + 2] == 2 &&
          builtins[i + 3] == 0x06 && builtins[i + 4] == 0x03) {
        sawWrite = true;
      }
      if (builtins[i] == 0x20 && builtins[i + 1] == 0x00) {
        sawWait = true;
      }
      if (builtins[i] == 0x0e) {
        sawNew = true;
      }
    }
    isTrue(sawWrite, 'no async+memory stream.write canon entry');
    isTrue(sawWait, 'no waitable-set.wait canon entry');
    isTrue(sawNew, 'no stream.new canon entry');
  });

  test('a WIT-typed async import produces the async entry',
      (ctx: TestContext): void => {
    // `wait-for` is `async` in the package's WIT, so the synthesized
    // module is the raw async-lowered declaration plus a `Future<void>`
    // wrapper over `awaitPacked`, and awaiting it roots the driver:
    // the program is entered through the callback-lifted `run`. The
    // hand-transcribed spelling (wait-ext.zena) must land in the same
    // place.
    let viaWit = compileFor(`${fixtures}/wait-wit.zena`, 'component');
    let witExports = sectionPayload(viaWit, 11);
    isTrue(containsName(witExports, 'run'),
      'the WIT-typed async import did not produce the async entry');
    isTrue(!containsName(witExports, 'main'),
      'the async entry should replace main');
    let viaExternal = compileFor(`${fixtures}/wait-ext.zena`, 'component');
    isTrue(containsName(sectionPayload(viaExternal, 11), 'run'),
      'the hand-spelled async import did not produce the async entry');
  });

  test('a sync-only use of an async-declaring interface keeps the ' +
      'synchronous lift', (ctx: TestContext): void => {
    // clock-wit.zena imports only `now`, but the interface also
    // declares the async `wait-for` — so the synthesized module links
    // `zena:component-async` for its wrapper. Linking the driver's unit
    // must not root it: only a program that actually awaits an
    // async-lowered import gets the callback-lifted entry, and this one
    // keeps its synchronous `main(): u64`.
    let exports = sectionPayload(
        compileFor(`${fixtures}/clock-wit.zena`, 'component'), 11);
    isTrue(containsName(exports, 'main'),
      'a program that awaits nothing lost its synchronous main');
    isTrue(!containsName(exports, 'run'),
      'a program that awaits nothing was given the async entry');
  });

  test('Zena identifiers become kebab-case names', (ctx: TestContext): void => {
    // Every name in a component — imports, exports, parameters — is
    // kebab-case, and a Zena identifier cannot contain `-`, so the
    // conversion is the only way one reaches the boundary.
    equal(toKebabName('addNarrow'), 'add-narrow');
    equal(toKebabName('main'), 'main');
    equal(toKebabName('nextBig'), 'next-big');
    equal(toKebabName('x2'), 'x2');
    // A leading capital would open a word with `-`, and a leading `_`
    // is not a letter: neither has a valid rendering, and nothing here
    // invents one.
    equal(toKebabName('_private'), '');
    isTrue(isKebabName('wasi:clocks') == false, 'a `:` is not kebab-case');
    isTrue(isKebabName('wait-for'), 'wait-for is kebab-case');
    isTrue(isKebabName('wait--for') == false, 'a doubled dash is an empty word');
    isTrue(isKebabName('wait-') == false, 'a trailing dash is an empty word');
  });
});
