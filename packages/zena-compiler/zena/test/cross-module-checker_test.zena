/**
 * Cross-module type checking tests.
 *
 * Validates that the checker resolves imported types with full
 * fidelity: field access, method calls, constructor arguments,
 * and function signatures across module boundaries.
 */

import { suite, test, TestContext } from 'zena:test';
import { equal, isTrue, isFalse } from 'zena:assert';
import { checkCompilation } from '../lib/compiler.zena';
import { parse } from '../lib/parser.zena';
import { DiagnosticBag, DiagnosticCode, SourceSpan } from '../lib/diagnostics.zena';
import { MockHost, makeCompiler, errorDiagnostics } from './test-utils.zena';

export let tests = suite('Cross-Module Type Checking', () => {

  suite('imported class types', () => {

    test('imported class field access resolves', () => {
      let host = new MockHost();
      host.addFile("/project/point.zena", "export class Point { x: f64; y: f64; new(this.x, this.y); }");
      host.addFile("/project/main.zena", "import { Point } from './point.zena';\nlet p = new Point(1.0, 2.0);\nlet x: f64 = p.x;");
      let compiler = makeCompiler(host);
      let result = compiler.compile("/project/main.zena");
      let checkResult = checkCompilation(result);
      let errors = errorDiagnostics(checkResult.diagnostics);
      equal(errors.length, 0);
    });

    test('imported class method call resolves', () => {
      let host = new MockHost();
      host.addFile("/project/counter.zena", "export class Counter {\n  var count: i32 = 0;\n  increment(): void { this.count += 1; }\n}");
      host.addFile("/project/main.zena", "import { Counter } from './counter.zena';\nlet c = new Counter();\nc.increment();");
      let compiler = makeCompiler(host);
      let result = compiler.compile("/project/main.zena");
      let checkResult = checkCompilation(result);
      let errors = errorDiagnostics(checkResult.diagnostics);
      equal(errors.length, 0);
    });
  });

  suite('imported function types', () => {

    test('imported function return type resolves', () => {
      let host = new MockHost();
      host.addFile("/project/math.zena", "export let add = (a: i32, b: i32): i32 => a + b;");
      host.addFile("/project/main.zena", "import { add } from './math.zena';\nlet r: i32 = add(1, 2);");
      let compiler = makeCompiler(host);
      let result = compiler.compile("/project/main.zena");
      let checkResult = checkCompilation(result);
      let errors = errorDiagnostics(checkResult.diagnostics);
      equal(errors.length, 0);
    });
  });

  suite('cross-module diagnostic locations', () => {

    test('diagnostic against a foreign node reports that node\'s file', () => {
      // A checker's DiagnosticBag is created for the module being checked,
      // but errors can be reported against nodes that belong to another
      // module (e.g. a callee's default-parameter expression). The reported
      // span must carry the node's own file, not the bag's.
      let modA = parse('let x = 1;', 'a.zena');
      let bag = new DiagnosticBag('b.zena');
      bag.reportError('test error', DiagnosticCode.UnknownError, modA.body[0].loc);
      equal(bag.diagnostics.length, 1);
      let span = bag.diagnostics[0].location as SourceSpan;
      equal(span.file, 'a.zena');
    });

    test('diagnostic with no location falls back to the bag\'s file', () => {
      let bag = new DiagnosticBag('b.zena');
      bag.reportError('test error', DiagnosticCode.UnknownError, null);
      let span = bag.diagnostics[0].location as SourceSpan;
      equal(span.file, 'b.zena');
    });
  });
});
