import { suite, test, TestContext } from 'zena:test';
import { isTrue } from 'zena:assert';
import { BinaryGenerator } from '../lib/codegen/binary-generator.zena';
import { Array } from 'zena:array';
import { Program, CompilationUnit } from '../lib/program.zena';
import { MockHost } from './test-utils.zena';
import { checkCompilation, createCompiler, CompilerOptions } from '../lib/compiler.zena';
import { HashMap } from 'zena:map';
import { PackageConfig } from '../lib/module-resolver.zena';
import { ByteBuffer } from 'zena:byte-buffer';

let compileToBinary = (source: String): ByteBuffer => {
  let host = new MockHost();
  host.addFile("zena:string", "export enum Encoding { WTF8, WTF16 } export class String { #data: ByteArray; #start: i32; #end: i32; #encoding: Encoding; }");
  host.addFile("zena:array", "export class Array {}");
  host.addFile("test.zena", source);

  let packages = new HashMap<String, PackageConfig>();
  let options = new CompilerOptions("host", "/stdlib", packages);
  let compiler = createCompiler(host, options);

  let compResult = compiler.compile("test.zena");
  let checkRes = checkCompilation(compResult, null, false);
  
  let entryAst = compResult.entry.ast;
  let units = new GrowableArray<CompilationUnit>();
  var entryUnit: CompilationUnit | null = null;
  
  for (let file in compResult.files) {
    let res = checkRes.results[file.path];
    if (res != null) {
      let unit = {ast: file.ast, model: res.model};
      units.push(unit);
      if (file.ast.path == entryAst.path) {
        entryUnit = unit;
      }
    }
  }
  
  let program = new Program(units, entryUnit);
  let generator = new BinaryGenerator("host");
  return generator.generate(program);
};

export let tests = suite('Dead Code Elimination', (): void => {
  test('binary is smaller when unused functions are eliminated', (ctx: TestContext): void => {
    let source1 = 'export let main = (): i32 => { return 42; };';
    let binary1 = compileToBinary(source1);

    let source2 = 'export let main = (): i32 => { return 42; }; let unused = (): i32 => { return 100; };';
    let binary2 = compileToBinary(source2);

    isTrue(binary1.length == binary2.length);
  });
});
