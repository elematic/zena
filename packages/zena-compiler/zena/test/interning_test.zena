/**
 * Identifier interning across a compilation.
 *
 * The library loader owns one `StringTable` for every file it parses,
 * so an identifier spelled the same way in two files is the same
 * `String` object. These tests check that scope — one table per
 * loader, every file through it — rather than the table itself, which
 * `packages/stdlib/tests/string-table` covers.
 */

import { suite, test, TestContext } from 'zena:test';
import { isTrue, equal } from 'zena:assert';
import { MockHost, makeCompiler } from './test-utils.zena';
import { Node, Identifier, IdentifierPattern } from '../lib/ast.zena';
import { walkEnter } from '../lib/visitor.zena';
import { CompilationResult } from '../lib/compiler.zena';

/**
 * A two-file program: both files name something `value`, and one
 * imports the other, so a single compilation parses both.
 */
let program = (host: MockHost): void => {
  host.addFile('/a.zena', 'export let value = 1;\nexport let twice = value + value;\n');
  host.addFile('/b.zena', "import { value } from './a.zena';\nexport let main = (): i32 => value + value;\n");
};

/** Every `value` identifier in the two files, in load order. */
let valueNames = (result: CompilationResult): Array<String> => {
  let found = new Array<String>();
  for (let file in result.files) {
    if (!(file.path.endsWith('a.zena') || file.path.endsWith('b.zena'))) {
      continue;
    }
    walkEnter(file.ast, (n: Node): void => {
      if (n is Identifier) {
        let name = (n as Identifier).name;
        if (name == 'value') { found.push(name); }
      } else if (n is IdentifierPattern) {
        let name = (n as IdentifierPattern).name;
        if (name == 'value') { found.push(name); }
      }
    });
  }
  return found;
};

/** How many of `names` are distinct objects, by identity. */
let identityCount = (names: Array<String>): i32 => {
  let representatives = new Array<String>();
  for (let name in names) {
    var seen = false;
    for (let r in representatives) {
      if (r === name) { seen = true; break; }
    }
    if (!seen) { representatives.push(name); }
  }
  return representatives.length;
};

let compileProgram = (): CompilationResult => {
  let host = new MockHost();
  program(host);
  return makeCompiler(host).compile({entry: '/b.zena', target: 'freestanding'});
};

export let tests = suite('identifier interning', (): void => {
  test('the program repeats the name across both files', (ctx: TestContext): void => {
    let names = valueNames(compileProgram());
    isTrue(names.length >= 5,
      `expected at least 5 occurrences of \`value\`, found ${i32ToString(names.length)}`);
  });

  test('one table spans every file in the compilation', (ctx: TestContext): void => {
    let names = valueNames(compileProgram());
    equal(identityCount(names), 1,
      'every occurrence of `value`, in both files, should be the same String');
  });

  test('two compilers do not share a table', (ctx: TestContext): void => {
    let first = valueNames(compileProgram());
    let second = valueNames(compileProgram());
    isTrue(!(first[0] === second[0]),
      'a second compiler should intern into a table of its own');
  });
});
