import { suite, test, TestContext } from 'zena:test';
import { isTrue } from 'zena:assert';

function helperFunction() {
  return new Error('test error');
}

export let tests = suite('Backtrace', () => {
  test('captures and formats stack trace successfully', (ctx) => {
    let err = helperFunction();
    let trace = err.getStackTrace();
    isTrue(trace != null);
    let traceStr = trace as String;
    isTrue(traceStr.length > 0);
    isTrue(traceStr.contains('helperFunction'));
  });
});
