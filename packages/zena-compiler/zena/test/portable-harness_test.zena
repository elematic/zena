/**
 * Unit tests for the pieces of `portable-harness.zena` that decide what
 * a portable test file means. The discovery walk itself needs a real
 * filesystem, so it is covered by the runners; this covers the parsing
 * every runner depends on.
 */

import { suite, test, TestContext } from 'zena:test';
import { equal, isTrue, isFalse } from 'zena:assert';
import {
  TestFile, parseDirectives, siblingImports, unescapeNewlines, unquote,
} from './portable-harness.zena';

let fileWith = (path: String, source: String): TestFile => {
  var name = path;
  var i = path.length - 1;
  while (i >= 0) {
    if (path.getByteAt(i) == 47) { // '/'
      name = path.sliceBytes(i + 1, path.length);
      break;
    }
    i -= 1;
  }
  return new TestFile(path, name, name, source, parseDirectives(source));
};

export let tests = suite('Portable harness', (): void => {
  suite('parseDirectives', (): void => {
    test('reads name, value and 1-based line', (ctx: TestContext): void => {
      let ds = parseDirectives('// @mode: run\n// @result: 42\n');
      equal(ds.length, 2);
      equal(ds[0].name, 'mode');
      equal(ds[0].value, 'run');
      equal(ds[0].line, 1);
      equal(ds[1].name, 'result');
      equal(ds[1].value, '42');
      equal(ds[1].line, 2);
    });

    test('trims around the value but keeps inner spaces', (ctx: TestContext): void => {
      let ds = parseDirectives('// @result:   Hello World   \n');
      equal(ds.length, 1);
      equal(ds[0].value, 'Hello World');
    });

    test('the marker is exactly "// @", so looser spellings are not directives', (ctx: TestContext): void => {
      // Deliberately strict: a near-miss is easier to spot as a test
      // that does nothing than as a directive that quietly went unread.
      equal(parseDirectives('//   @result: 1\n').length, 0);
      equal(parseDirectives('//@result: 1\n').length, 0);
    });

    test('finds a trailing directive on a code line', (ctx: TestContext): void => {
      let ds = parseDirectives('  new() {} // @error: must be initialized\n');
      equal(ds.length, 1);
      equal(ds[0].name, 'error');
      equal(ds[0].value, 'must be initialized');
    });

    test('a value may be empty', (ctx: TestContext): void => {
      let ds = parseDirectives('// @skip:\n');
      equal(ds.length, 1);
      equal(ds[0].name, 'skip');
      equal(ds[0].value, '');
    });

    test('a source with no directives yields none', (ctx: TestContext): void => {
      equal(parseDirectives('export let main = (): i32 => 1;\n').length, 0);
    });
  });

  suite('TestFile', (): void => {
    test('directive returns the first match, or null', (ctx: TestContext): void => {
      let f = fileWith('a/b.zena', '// @mode: run\n// @result: 7\n');
      equal(f.directive('result'), '7');
      isTrue(f.directive('stdout') == null);
      isTrue(f.has('mode'));
      isFalse(f.has('invoke'));
    });

    test('all returns every match in file order', (ctx: TestContext): void => {
      let f = fileWith('a/b.zena', '// @error: one\n// @error: two\n');
      let errors = f.all('error');
      equal(errors.length, 2);
      equal(errors[0].value, 'one');
      equal(errors[1].value, 'two');
    });

    test('no @skip directive means the test runs', (ctx: TestContext): void => {
      isTrue(fileWith('a/b.zena', '// @mode: run\n').skipReason() == null);
    });

    test('@skip reports its reason', (ctx: TestContext): void => {
      equal(fileWith('a/b.zena', '// @skip: not implemented\n').skipReason(), 'not implemented');
    });

    test('a reasonless @skip still skips, and says so', (ctx: TestContext): void => {
      equal(fileWith('a/b.zena', '// @skip:\n').skipReason(), '(no reason given)');
    });
  });

  suite('siblingImports', (): void => {
    test('resolves against the importing file directory', (ctx: TestContext): void => {
      let f = fileWith(
        'tests/language/execution/imports/main.zena',
        "import { x } from './helper.zena';\n");
      let imports = siblingImports(f);
      equal(imports.length, 1);
      equal(imports[0], 'tests/language/execution/imports/helper.zena');
    });

    test('adds the extension when the specifier omits it', (ctx: TestContext): void => {
      let f = fileWith('t/main.zena', "import { x } from './dep';\n");
      let imports = siblingImports(f);
      equal(imports.length, 1);
      equal(imports[0], 't/dep.zena');
    });

    test('finds every import and ignores stdlib ones', (ctx: TestContext): void => {
      let f = fileWith(
        't/main.zena',
        "import { console } from 'zena:console';\n" +
        "import { a } from './a.zena';\n" +
        "import { b } from './b.zena';\n");
      let imports = siblingImports(f);
      equal(imports.length, 2);
      equal(imports[0], 't/a.zena');
      equal(imports[1], 't/b.zena');
    });

    test('a file that imports nothing relative yields none', (ctx: TestContext): void => {
      equal(siblingImports(fileWith('t/main.zena', "import { c } from 'zena:console';\n")).length, 0);
    });
  });

  suite('directive values', (): void => {
    test('unquote strips one matching pair', (ctx: TestContext): void => {
      equal(unquote('"Hello"'), 'Hello');
      equal(unquote("'Hello'"), 'Hello');
      equal(unquote('Hello'), 'Hello');
    });

    test('unquote leaves mismatched or partial quotes alone', (ctx: TestContext): void => {
      equal(unquote('"Hello'), '"Hello');
      equal(unquote('"'), '"');
    });

    test('unescapeNewlines expands the two-character escape', (ctx: TestContext): void => {
      equal(unescapeNewlines('a\\nb'), 'a\nb');
      equal(unescapeNewlines('no escapes'), 'no escapes');
    });
  });
});
