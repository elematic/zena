// Test that the self-hosted checker can type-check real Zena source files.
// This catches checker gaps (features used in real code that the checker
// doesn't handle yet). Each file is compiled with full dependency resolution
// so cross-module imports are wired up.
//
// These tests are currently SKIPPED because the checker has known gaps.
// Unskip individual files as they check clean.

import { suite, test, TestContext } from 'zena:test';
import { equal } from 'zena:assert';
import {
  createCompiler, checkCompilation,
} from '../lib/compiler.zena';
import { loadPackageMap } from '../lib/package-manifest.zena';
import { Diagnostic, DiagnosticSeverity } from '../lib/diagnostics.zena';
import { PlainHost, stdlibRoot, errorDiagnostics } from './test-utils.zena';

// ============================================================================
// Helpers
// ============================================================================

function checkFile(entryPath: String, target: String = "js") {
  let host = new PlainHost();
  let packages = loadPackageMap(host, "zena-packages.json");
  let compiler = createCompiler(host, {stdlibRoot, packages});
  let result = compiler.compile({entry: entryPath, target});
  // console.log("Checking compilation for " + entryPath + "...");
  let checkResult = checkCompilation(result);
  // Only return errors from the entry file, not dependencies.
  return errorDiagnostics(checkResult.diagnostics);
}

function checkFileJs(entryPath: String) {
  return checkFile(entryPath, "js");
}

function printDiagnostics(errors: Array<Diagnostic>, label: String) {
  if (errors.length > 0) {
    let count = errors.length;
    console.log(`${label}: ${i32ToString(count)} errors`);
    var i = 0;
    while (i < errors.length && i < 80) {
      let msg = errors[i].message;
      let loc = errors[i].location;
      let locStr = if (loc != null) {
        ` (line ${i32ToString(loc.line)})`
      } else {
        ""
      };
      console.log(`  ${msg}${locStr}`);
      i += 1;
    }
    if (errors.length > 80) {
      console.log(`  ... and ${i32ToString(errors.length - 80)} more`);
    }
  }
}

// ============================================================================
// Tests
// ============================================================================

export let tests = suite('Checker: Real Files', () => {

  // These tests compile real stdlib source files through the full pipeline.
  // The checker must be able to check all stdlib files cleanly, since they're
  // used in every program.

  test('checks array-iterator.zena', (ctx) => {
    let errors = checkFile("zena:core/array-iterator.zena");
    printDiagnostics(errors, "array-iterator.zena");
    equal(errors.length, 0);
  });

  test('checks array.zena', (ctx) => {
    let errors = checkFile("zena:core/array.zena");
    printDiagnostics(errors, "array.zena");
    equal(errors.length, 0);
