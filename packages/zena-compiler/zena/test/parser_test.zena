import { suite, test, TestContext } from 'zena:test';
import { equal, isTrue, isFalse, throws, greater } from 'zena:assert';
import { Array } from 'zena:array';
import { parse, parseRecovering } from '../lib/parser.zena';
import { SourceSpan } from '../lib/diagnostics.zena';
import {
  VariableDeclaration, Identifier, IdentifierPattern, NumberLiteral, StringLiteral, BooleanLiteral, BinaryExpression, ExpressionStatement, MemberExpression, BlockStatement, FunctionExpression, ClassDeclaration, TypeAnnotation, NamedTypeAnnotation, CallExpression, ImportDeclaration, SourceLocation,
} from '../lib/ast.zena';

// ============================================================================
// Tests
// ============================================================================

export let tests = suite('Parser', (): void => {

  // ==========================================================================
  // Variable Declarations
  // ==========================================================================

  suite('Variable Declarations', (): void => {
    test('should parse let declaration', (ctx: TestContext): void => {
      let source = 'let x = 1;';
      let mod = parse(source, 'test.zena');
      
      equal(mod.body.length, 1);
      
      let decl = mod.body[0] as VariableDeclaration;
      equal(decl.kind, 'let');
      isFalse(decl.exported);
      
      let pattern = decl.pattern as IdentifierPattern;
      equal(pattern.name, 'x');
      
      let init = decl.init as NumberLiteral;
      equal(init.raw, '1');
    });

    test('should parse var declaration', (ctx: TestContext): void => {
      let source = 'var y = 42;';
      let mod = parse(source, 'test.zena');
      
      equal(mod.body.length, 1);
      
      let decl = mod.body[0] as VariableDeclaration;
      equal(decl.kind, 'var');
      
      let pattern = decl.pattern as IdentifierPattern;
      equal(pattern.name, 'y');
      
      let init = decl.init as NumberLiteral;
      equal(init.raw, '42');
    });

    test('should parse exported let declaration', (ctx: TestContext): void => {
      let source = 'export let z = 0;';
      let mod = parse(source, 'test.zena');
      
      let decl = mod.body[0] as VariableDeclaration;
      isTrue(decl.exported);
      equal(decl.kind, 'let');
      
      let pattern = decl.pattern as IdentifierPattern;
      equal(pattern.name, 'z');
    });
  });

  // ==========================================================================
  // Expressions
  // ==========================================================================

  suite('Expressions', (): void => {
    test('should parse binary expression', (ctx: TestContext): void => {
      let source = 'x + 1;';
      let mod = parse(source, 'test.zena');
      
      equal(mod.body.length, 1);
      
      let stmt = mod.body[0] as ExpressionStatement;
      let expr = stmt.expression as BinaryExpression;
      equal(expr.operator, '+');
      
      let left = expr.left as Identifier;
      equal(left.name, 'x');
      
      let right = expr.right as NumberLiteral;
      equal(right.raw, '1');
    });

    test('should parse subtraction', (ctx: TestContext): void => {
      let source = 'a - b;';
      let mod = parse(source, 'test.zena');
      
      let stmt = mod.body[0] as ExpressionStatement;
      let expr = stmt.expression as BinaryExpression;
      
      equal(expr.operator, '-');
    });

    test('should parse multiplication', (ctx: TestContext): void => {
      let source = 'a * b;';
      let mod = parse(source, 'test.zena');
      
      let stmt = mod.body[0] as ExpressionStatement;
      let expr = stmt.expression as BinaryExpression;
      
      equal(expr.operator, '*');
    });

    test('should parse division', (ctx: TestContext): void => {
      let source = 'a / b;';
      let mod = parse(source, 'test.zena');
      
      let stmt = mod.body[0] as ExpressionStatement;
      let expr = stmt.expression as BinaryExpression;
      
      equal(expr.operator, '/');
    });

    test('should respect operator precedence', (ctx: TestContext): void => {
      let source = 'a + b * c;';
      let mod = parse(source, 'test.zena');
      
      let stmt = mod.body[0] as ExpressionStatement;
      let expr = stmt.expression as BinaryExpression;
      
      // Should be a + (b * c), so outer is +
      equal(expr.operator, '+');
      
      // Left should be identifier a
      let left = expr.left as Identifier;
      equal(left.name, 'a');
      
      // Right should be b * c
      let right = expr.right as BinaryExpression;
      equal(right.operator, '*');
    });
  });

  // ==========================================================================
  // Literals
  // ==========================================================================

  suite('Literals', (): void => {
    test('should parse boolean true', (ctx: TestContext): void => {
      let source = 'true;';
      let mod = parse(source, 'test.zena');
      
      let stmt = mod.body[0] as ExpressionStatement;
      let expr = stmt.expression as BooleanLiteral;
      
      isTrue(expr.value);
    });

    test('should parse boolean false', (ctx: TestContext): void => {
      let source = 'false;';
      let mod = parse(source, 'test.zena');
      
      let stmt = mod.body[0] as ExpressionStatement;
      let expr = stmt.expression as BooleanLiteral;
      
      isFalse(expr.value);
    });

    test('should parse string literal', (ctx: TestContext): void => {
      let source = "'hello';";
      let mod = parse(source, 'test.zena');
      
      let stmt = mod.body[0] as ExpressionStatement;
      let expr = stmt.expression as StringLiteral;
      
      equal(expr.value, 'hello');
    });
  });

  // ==========================================================================
  // Comment Collection via Parser
  // ==========================================================================

  suite('Comments', (): void => {
    test('should collect comments on module', (ctx: TestContext): void => {
      let source = '// a comment\nlet x = 1;';
      let mod = parse(source, 'test.zena');

      equal(mod.comments.length, 1);
      equal(mod.comments[0].value, ' a comment');
      equal(mod.comments[0].isBlock, false);
    });

    test('should collect block comments on module', (ctx: TestContext): void => {
      let source = '/* block */\nlet x = 1;';
      let mod = parse(source, 'test.zena');

      equal(mod.comments.length, 1);
      equal(mod.comments[0].value, ' block ');
      equal(mod.comments[0].isBlock, true);
    });

    test('should collect multiple comments', (ctx: TestContext): void => {
      let source = '// first\n// second\nlet x = 1;';
      let mod = parse(source, 'test.zena');

      equal(mod.comments.length, 2);
      equal(mod.comments[0].value, ' first');
      equal(mod.comments[1].value, ' second');
    });

    test('should have empty comments when none present', (ctx: TestContext): void => {
      let source = 'let x = 1;';
      let mod = parse(source, 'test.zena');

      equal(mod.comments.length, 0);
    });

    test('should preserve comment positions', (ctx: TestContext): void => {
      let source = 'let a = 1;\n// between\nlet b = 2;';
      let mod = parse(source, 'test.zena');

      equal(mod.comments.length, 1);
      equal(mod.comments[0].value, ' between');
      equal(mod.comments[0].line, 2);
      equal(mod.comments[0].start, 11);
    });
  });

  // ==========================================================================
  // Error Recovery
  // ==========================================================================

  suite('Error Recovery', (): void => {
    test('should recover from trailing dot in member access', (ctx: TestContext): void => {
      let source = 'let main = () => { p. };';
      let mod = parse(source, 'test.zena');

      equal(mod.body.length, 1);
      let vdecl = mod.body[0] as VariableDeclaration;
      let fn = vdecl.init as FunctionExpression;
      let block = fn.body as BlockStatement;

      equal(block.body.length, 1);
      let stmt = block.body[0] as ExpressionStatement;
      let me = stmt.expression as MemberExpression;

      let obj = me.object as Identifier;
      equal(obj.name, 'p');

      let prop = me.property;
      equal(prop.name, '');
    });

    test('should recover from missing semicolon before closing brace', (ctx: TestContext): void => {
      let source = 'let main = () => { console.l };';
      let mod = parse(source, 'test.zena');

      equal(mod.body.length, 1);
      let vdecl = mod.body[0] as VariableDeclaration;
      let fn = vdecl.init as FunctionExpression;
      let block = fn.body as BlockStatement;

      equal(block.body.length, 1);
      let stmt = block.body[0] as ExpressionStatement;
      let me = stmt.expression as MemberExpression;

      let obj = me.object as Identifier;
      equal(obj.name, 'console');

      let prop = me.property;
      equal(prop.name, 'l');
    });

    test('should recover from trailing dot with incomplete identifier before closing brace', (ctx: TestContext): void => {
      let source = 'let main = () => {\n  console.l\n};';
      let mod = parse(source, 'test.zena');

      equal(mod.body.length, 1);
      let vdecl = mod.body[0] as VariableDeclaration;
      let fn = vdecl.init as FunctionExpression;
      let block = fn.body as BlockStatement;

      equal(block.body.length, 1);
      let stmt = block.body[0] as ExpressionStatement;
      let me = stmt.expression as MemberExpression;

      let obj = me.object as Identifier;
      equal(obj.name, 'console');

      let prop = me.property;
      equal(prop.name, 'l');
    });

    test('should recover from incomplete variable initializer: let x =', (ctx: TestContext): void => {
      let source = 'let main = () => { let x = \n};';
      let mod = parse(source, 'test.zena');

      equal(mod.body.length, 1);
      let vdecl = mod.body[0] as VariableDeclaration;
      let fn = vdecl.init as FunctionExpression;
      let block = fn.body as BlockStatement;

      equal(block.body.length, 1);
      let innerDecl = block.body[0] as VariableDeclaration;
      let initId = innerDecl.init as Identifier;
      equal(initId.name, '');
    });

    test('should recover from incomplete binary expression: x +', (ctx: TestContext): void => {
      let source = 'let main = () => { x + \n};';
      let mod = parse(source, 'test.zena');

      equal(mod.body.length, 1);
      let vdecl = mod.body[0] as VariableDeclaration;
      let fn = vdecl.init as FunctionExpression;
      let block = fn.body as BlockStatement;

      equal(block.body.length, 1);
      let stmt = block.body[0] as ExpressionStatement;
      let bin = stmt.expression as BinaryExpression;

      equal(bin.operator, '+');
      let right = bin.right as Identifier;
      equal(right.name, '');
    });

    test('should recover from incomplete class extends clause', (ctx: TestContext): void => {
      let source = 'class Sub extends {\n}';
      let mod = parse(source, 'test.zena');

      equal(mod.body.length, 1);
      let cdecl = mod.body[0] as ClassDeclaration;
      isTrue(cdecl.superClass != null);

      let superAnn = cdecl.superClass as NamedTypeAnnotation;
      equal(superAnn.name, '');
    });

    test('should recover from incomplete class mixins with clause', (ctx: TestContext): void => {
      let source = 'class Foo with {\n}';
      let mod = parse(source, 'test.zena');

      equal(mod.body.length, 1);
      let cdecl = mod.body[0] as ClassDeclaration;
      isTrue(cdecl.mixins != null);

      let ms = cdecl.mixins as GrowableArray<TypeAnnotation>;
      equal(ms.length, 1);
      let m0 = ms[0] as NamedTypeAnnotation;
      equal(m0.name, '');
    });

    test('should recover from incomplete class implements clause', (ctx: TestContext): void => {
      let source = 'class Foo implements {\n}';
      let mod = parse(source, 'test.zena');

      equal(mod.body.length, 1);
      let cdecl = mod.body[0] as ClassDeclaration;
      isTrue(cdecl.implementsList != null);

      let impls = cdecl.implementsList as GrowableArray<TypeAnnotation>;
      equal(impls.length, 1);
      let impl0 = impls[0] as NamedTypeAnnotation;
      equal(impl0.name, '');
    });

    test('should recover from incomplete call arguments: foo( and foo(x,', (ctx: TestContext): void => {
      let source1 = 'let main = () => { foo(\n};';
      let mod1 = parse(source1, 'test.zena');
      let vdecl1 = mod1.body[0] as VariableDeclaration;
      let fn1 = vdecl1.init as FunctionExpression;
      let block1 = fn1.body as BlockStatement;
      let stmt1 = block1.body[0] as ExpressionStatement;
      let call1 = stmt1.expression as CallExpression;
      equal(call1.args.length, 1);
      equal((call1.args[0] as Identifier).name, '');

      let source2 = 'let main = () => { foo(x, \n};';
      let mod2 = parse(source2, 'test.zena');
      let vdecl2 = mod2.body[0] as VariableDeclaration;
      let fn2 = vdecl2.init as FunctionExpression;
      let block2 = fn2.body as BlockStatement;
      let stmt2 = block2.body[0] as ExpressionStatement;
      let call2 = stmt2.expression as CallExpression;
      equal(call2.args.length, 2);
      equal((call2.args[0] as Identifier).name, 'x');
      equal((call2.args[1] as Identifier).name, '');
    });

    // ========================================================================
    // Incomplete imports
    //
    // An import being typed is the completion point for module specifiers
    // and imported names, so each prefix has to yield an AST. Recovering
    // does not excuse the error: `parse` still throws it, and
    // `parseRecovering` reports it as a diagnostic beside the AST.
    // ========================================================================

    test('should recover from a bare import keyword', (ctx: TestContext): void => {
      let result = parseRecovering('import ', 'test.zena');

      equal(result.ast.body.length, 1);
      let decl = result.ast.body[0] as ImportDeclaration;
      equal(decl.imports.length, 0);
      equal(decl.moduleSpecifier.value, '');
      greater(result.diagnostics.length, 0);
    });

    test('should recover from an unclosed import specifier list', (ctx: TestContext): void => {
      let result = parseRecovering('import {Map', 'test.zena');

      equal(result.ast.body.length, 1);
      let decl = result.ast.body[0] as ImportDeclaration;
      equal(decl.imports.length, 1);
      equal(decl.imports[0].imported.name, 'Map');
      equal(decl.moduleSpecifier.value, '');
      equal(result.diagnostics[0].message, "Expected '}'");
    });

    test('should recover from an import with no from clause', (ctx: TestContext): void => {
      let result = parseRecovering('import {Map}', 'test.zena');

      equal(result.ast.body.length, 1);
      let decl = result.ast.body[0] as ImportDeclaration;
      equal(decl.imports.length, 1);
      equal(decl.imports[0].local.name, 'Map');
      equal(decl.moduleSpecifier.value, '');
      equal(result.diagnostics[0].message, "Expected 'from'");
    });

    test('should recover from an import with no module specifier', (ctx: TestContext): void => {
      let result = parseRecovering('import {Map} from', 'test.zena');

      equal(result.ast.body.length, 1);
      let decl = result.ast.body[0] as ImportDeclaration;
      equal(decl.imports.length, 1);
      equal(decl.moduleSpecifier.value, '');
      equal(result.diagnostics[0].message, 'Expected string literal');
    });

    test('should recover from an import missing only its semicolon', (ctx: TestContext): void => {
      // The completion point for module specifiers: the editor has
      // auto-closed the quote, but the statement is not finished.
      let result = parseRecovering("import {Map} from 'zena:map'\nlet x = 1;", 'test.zena');

      equal(result.ast.body.length, 2);
      let decl = result.ast.body[0] as ImportDeclaration;
      equal(decl.moduleSpecifier.value, 'zena:map');
      equal(result.diagnostics.length, 1);
      equal(result.diagnostics[0].message, "Expected ';'");
    });

    test('should recover from an incomplete import above other statements', (ctx: TestContext): void => {
      let result = parseRecovering('import {Map} from \nlet x = 1;', 'test.zena');

      equal(result.ast.body.length, 2);
      let decl = result.ast.body[0] as ImportDeclaration;
      equal(decl.moduleSpecifier.value, '');
      let vdecl = result.ast.body[1] as VariableDeclaration;
      equal((vdecl.init as NumberLiteral).raw, '1');
    });

    test('should recover from an incomplete flipped import', (ctx: TestContext): void => {
      let result = parseRecovering("from 'zena:map' import", 'test.zena');

      equal(result.ast.body.length, 1);
      let decl = result.ast.body[0] as ImportDeclaration;
      equal(decl.imports.length, 0);
      equal(decl.moduleSpecifier.value, 'zena:map');
      equal(result.diagnostics[0].message, "Expected '{'");
    });

    test('should report an incomplete import at the token it stopped on', (ctx: TestContext): void => {
      let result = parseRecovering('import {Map} from \nlet x = 1;', 'test.zena');

      let span = result.diagnostics[0].location as SourceSpan;
      equal(span.file, 'test.zena');
      equal(span.line, 2);
    });

    test('should still throw an incomplete import from a plain parse', (ctx: TestContext): void => {
      // Recovery is opt-in. A build gets the error it has always gotten.
      throws((): void => {
        parse('import {Map} from \nlet x = 1;', 'test.zena');
      });
      throws((): void => {
        parse("import {Map} from 'zena:map'\nlet x = 1;", 'test.zena');
      });
    });

    test('should locate the module specifier of a complete import', (ctx: TestContext): void => {
      let mod = parse("import {Map} from 'zena:map';", 'test.zena');

      let decl = mod.body[0] as ImportDeclaration;
      equal(decl.moduleSpecifier.value, 'zena:map');
      isTrue(decl.moduleSpecifier.loc != null);
      // The location spans the quotes: `'zena:map'` starts at offset 18.
      equal((decl.moduleSpecifier.loc as SourceLocation).start, 18);
    });

    test('should still reject a malformed import on one line', (ctx: TestContext): void => {
      // Recovery is for a statement being typed, not for a typo mid-line:
      // `from` here sits on the same line as the specifier list. Neither
      // entry point can make sense of it.
      throws((): void => {
        parse("import {Map from 'zena:map';", 'test.zena');
      });
      throws((): void => {
        parseRecovering("import {Map from 'zena:map';", 'test.zena');
      });
    });
  });
});


