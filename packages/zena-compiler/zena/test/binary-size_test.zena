/**
 * A minimal program must compile to a small module.
 *
 * This is a **ratchet**, not a snapshot. `export function main(): i32
 * { return 42; }` needs no strings, no collections, no allocation and
 * makes no calls, so every byte in its module arrived without the
 * program asking. The budget below only ever moves DOWN; raising it
 * means something started being emitted that a program with no code in
 * it does not need, and that is the bug.
 *
 * It exists because nothing was watching. `dce_test.zena` asserts only
 * that two programs compile to the *same* length, which stays true
 * while both triple. Between the TypeScript bootstrap's 175 bytes and
 * this test being written, the same program reached 33,875 — a name
 * section emitted unconditionally, plus the whole of `String`,
 * `FixedArray`/`ImmutableArray` at four element types (including
 * `HashMap`'s internal entry type, in a program with no map), and
 * `WasiConsole`. The reachability leaks behind that are diagnosed in
 * docs/design/binary-size.md and are not all fixed; the budget is set
 * where the compiler actually is, so it holds the line while they are.
 */

import { suite, test, TestContext } from 'zena:test';
import { isTrue, equal } from 'zena:assert';
import { readFile, writeFile, exists, mkdir } from 'zena:fs';
import { Array } from 'zena:array';
import { CompilerHost } from '../lib/library-loader.zena';
import {
  Compiler, createCompiler, CompilerOptions, checkCompilation
} from '../lib/compiler.zena';
import { loadPackageMap } from '../lib/package-manifest.zena';
import { stdlibIdToRelativeFile } from '../lib/module-resolver.zena';
import { DiagnosticSeverity } from '../lib/diagnostics.zena';
import { BinaryGenerator } from '../lib/codegen/binary-generator.zena';
import { WatGenerator } from '../lib/codegen/wat-generator.zena';
import { Program, CompilationUnit } from '../lib/program.zena';
import { i32ToString } from 'zena:string-convert';
import { getEnv } from 'zena:cli';

/** Mirrors codegen-wat_test's helper; UPDATE_SNAPSHOTS=1 regenerates. */
let assertSnapshot = (name: String, content: String): void => {
  let snapDir = 'packages/zena-compiler/test-files/snapshots';
  if (!exists(snapDir)) {
    mkdir(snapDir);
  }
  let snapFile = snapDir + '/' + name + '.snap';
  if (getEnv("UPDATE_SNAPSHOTS") != null) {
    writeFile(snapFile, content);
    equal(content, content);
  } else if (exists(snapFile)) {
    let expected = readFile(snapFile);
    equal(content, expected);
  } else {
    writeFile(snapFile, content);
    equal(content, content);
  }
};

let stdlibRoot = 'packages/stdlib/zena';

class PlainHost implements CompilerHost {
  new();
  readFile(path: String): String {
    if (path.startsWith('zena:')) {
      return readFile(`${stdlibRoot}/${stdlibIdToRelativeFile(path)}`);
    }
    return readFile(path);
  }
}

/** Compiles to wasm the way `zena-cli build` does — names off. */
let compile = (path: String): ByteArray => {
  let host = new PlainHost();
  let packages = loadPackageMap(host, 'zena-packages.json');
  let c = createCompiler(host, new CompilerOptions('zena-cli', stdlibRoot, packages));
  let result = c.compile(path);
  let checked = checkCompilation(result, null, false);
  for (let diag in checked.diagnostics) {
    if (diag.severity == DiagnosticSeverity.Error) {
      throw new Error(`${path}: ${diag.message}`);
    }
  }
  let entryAst = result.entry.ast;
  let units = new Array<CompilationUnit>();
  var entryUnit: CompilationUnit | null = null;
  for (let file in result.files) {
    let res = checked.results[file.path];
    if (res != null) {
      let unit = {ast: file.ast, model: res.model};
      units.push(unit);
      if (file.ast.path == entryAst.path) { entryUnit = unit; }
    }
  }
  return new BinaryGenerator('zena-cli', false)
    .generate(new Program(units, entryUnit))
    .toByteArray();
};

let target = 'packages/zena-compiler/test-files/minimal.zena';

/**
 * Whether the module's bytes contain `name` — a byte-substring scan,
 * not an export-section parse. Export names are stored verbatim, so
 * for these fixtures (whose sources never mention the helper names) a
 * hit can only be the export entry; the miss direction is exact.
 */
let hasExport = (bytes: ByteArray, name: String): boolean => {
  if (name.length == 0 || bytes.length < name.length) { return false; }
  for (var i = 0; i <= bytes.length - name.length; i += 1) {
    var matches = true;
    for (var j = 0; j < name.length; j += 1) {
      if (bytes[i + j] != name.getByteAt(j)) { matches = false; break; }
    }
    if (matches) { return true; }
  }
  return false;
};

/**
 * A step up from minimal: an array literal summed by a for-in loop, so
 * it genuinely needs an array type, its iterator, and
 * `Iterable`/`Iterator` dispatch. Minimal alone cannot notice a
 * regression in generic specialization, because it specializes
 * nothing.
 */
let arrayTarget = 'packages/zena-compiler/test-files/array-sum.zena';

/**
 * Between the two: one string literal, returned. Needs the String
 * class, the literal machinery, and the four $string* host-interop
 * exports — but calls no String methods, so its budget tracks what
 * instantiating String costs beyond the literal itself (today: every
 * method, via the vtable force-reach — "The keystone" in the doc).
 */
let helloTarget = 'packages/zena-compiler/test-files/hello-string.zena';

/**
 * Ratchet these down as reachability improves. Do not raise one
 * without recording why in docs/design/binary-size.md — the number
 * moving up is the signal this test exists to give.
 */
let budget = 37;
let arrayBudget = 6700;
let helloBudget = 2000;

export let tests = suite('Binary size', (): void => {
  test('a minimal program stays within its byte budget', (ctx: TestContext): void => {
    let bytes = compile(target);
    isTrue(bytes.length <= budget,
      `${target} compiles to ${i32ToString(bytes.length)} bytes, over the ` +
      `${i32ToString(budget)}-byte budget. Something is being emitted that a ` +
      `program with no code in it does not need — see docs/design/binary-size.md.`);
  });

  test('an array-literal sum stays within its byte budget', (ctx: TestContext): void => {
    let bytes = compile(arrayTarget);
    isTrue(bytes.length <= arrayBudget,
      `${arrayTarget} compiles to ${i32ToString(bytes.length)} bytes, over the ` +
      `${i32ToString(arrayBudget)}-byte budget. A generic specialization is ` +
      `reaching more than the program uses — see docs/design/binary-size.md.`);
  });

  test('a returned string literal stays within its byte budget', (ctx: TestContext): void => {
    let bytes = compile(helloTarget);
    isTrue(bytes.length <= helloBudget,
      `${helloTarget} compiles to ${i32ToString(bytes.length)} bytes, over the ` +
      `${i32ToString(helloBudget)}-byte budget. Instantiating String is ` +
      `reaching more than a program with one literal uses — see ` +
      `docs/design/binary-size.md.`);
  });

  test('the minimal program WAT is exactly the ideal module', (ctx: TestContext): void => {
    // A SNAPSHOT, unlike the byte budgets: the minimal module is small
    // enough to read whole, and any regression shows up as the exact
    // type/function/export it added. Regenerate with
    // UPDATE_SNAPSHOTS=1 and eyeball the diff — a new entry here means
    // something reached code a program with no code in it cannot run.
    assertSnapshot('minimal_program',
        new WatGenerator('zena-cli', false).generate(programOf(target)));
  });

  test('a program with no strings exports no string helpers', (ctx: TestContext): void => {
    // The $string* helpers exist to hand String values across the host
    // boundary; a module with no String values has nothing to hand
    // across, and every export is emitted code. A returned literal
    // must have them (the host reads the result through
    // $stringGetLength/$stringGetByte).
    isTrue(!hasExport(compile(target), '$stringCreate'),
      `${target} exports $stringCreate — a program with no strings is ` +
      `carrying the String host-interop helpers.`);
    isTrue(hasExport(compile(helloTarget), '$stringGetLength'),
      `${helloTarget} does not export $stringGetLength — the host cannot ` +
      `read the String this program returns.`);
  });

  test('the name section is opt-in', (ctx: TestContext): void => {
    // Debug metadata, and for a small module the largest thing in it.
    // `-g` (ZENA_DEBUG_NAMES) turns it on; the default must not.
    let plain = compile(target);
    let named = new BinaryGenerator('zena-cli', false, true)
      .generate(programOf(target))
      .toByteArray();
    isTrue(named.length > plain.length,
      `the debugNames build is ${i32ToString(named.length)} bytes and the ` +
      `default is ${i32ToString(plain.length)} — the default is carrying a ` +
      `name section it should not.`);
  });
});

/** The `Program` for a path, for a second generate() over the same input. */
let programOf = (path: String): Program => {
  let host = new PlainHost();
  let packages = loadPackageMap(host, 'zena-packages.json');
  let c = createCompiler(host, new CompilerOptions('zena-cli', stdlibRoot, packages));
  let result = c.compile(path);
  let checked = checkCompilation(result, null, false);
  let entryAst = result.entry.ast;
  let units = new Array<CompilationUnit>();
  var entryUnit: CompilationUnit | null = null;
  for (let file in result.files) {
    let res = checked.results[file.path];
    if (res != null) {
      let unit = {ast: file.ast, model: res.model};
      units.push(unit);
      if (file.ast.path == entryAst.path) { entryUnit = unit; }
    }
  }
  return new Program(units, entryUnit);
};
