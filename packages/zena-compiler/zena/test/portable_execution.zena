/**
 * Portable execution tests — every `.zena` file under
 * `tests/language/execution/` is compiled and run, and its result is
 * matched against the `@result:` / `@stdout:` directive in the file.
 *
 * Compiling and running are separated, and only running is isolated.
 *
 * **Compiling** happens in this process's own compiler (the runner
 * embeds it, so `../lib/...` is a plain import), batched: many entry
 * points go through **one** `Compiler`, threading the incremental
 * `ProgramCheckResult`, so the stdlib is parsed and checked once for
 * the batch instead of once per test. A five-line test used to cost
 * 0.385s and nearly all of it was the stdlib.
 *
 * Sharing is capped, not maximised: a compiler is replaced every
 * `entriesPerCompiler` entry points, because sharing one is worth a lot
 * and then worth nothing — see that constant for the measured curve.
 * The batch is also **sliced** across worker processes, which is what
 * makes the phase parallel; workers are this same module re-invoked at
 * `compileSlice`.
 *
 * **Running** is one `zena-cli run` process per test (via
 * `zena:process`, bounded pool), because that is where traps and
 * infinite loops live and one must take down one test rather than the
 * runner. Each worker is handed an already-emitted `.wasm`, so nothing
 * is compiled twice.
 *
 * Every run recompiles every test — there is no compile cache here and
 * so no way for a stale module to be reported as a pass. What a run
 * does reuse, when a module comes out byte-identical, is the module
 * file itself, purely so `zena-cli`'s wasmtime `.cwasm` beside it stays
 * valid; a test's module is only ever run on the strength of a status
 * file written by this run's compile phase.
 *
 * Discovery has no allow-list: a file runs because it exists. A file is
 * a test if it declares `@result:` or `@stdout:`; a file with neither is
 * a support module that some sibling test imports. `@skip: <reason>`
 * holds a test back and is reported. All three counts are printed, so a
 * test that stops being collected shows up as a number that moved.
 *
 * Usage (spawned by `run-wasmtime.js`, which grants `--allow-spawn`):
 *   portable_execution <zenaCli> <parallelism> [filter]
 * and, re-invoked on itself for one slice of the compile phase:
 *   portable_execution --invoke compileSlice <index> <count> [filter]
 */

import { getArguments } from 'zena:cli';
import { console } from 'zena:console';
import { Array } from 'zena:array';
import { HashSet } from 'zena:set';
import { StringBuilder } from 'zena:string-builder';
import { parseI64, i32ToString } from 'zena:string-convert';
import { Process, ProcessResult, spawn } from 'zena:process';
import { readFile, readFileBytes, writeFile, writeFileBytes, mkdir, exists, unlink } from 'zena:fs';
import {
  Discovery,
  TestFile,
  collect,
  siblingImports,
  unescapeNewlines,
  unquote,
} from './portable-harness.zena';
import { CompilerHost } from '../lib/library-loader.zena';
import {
  Compiler, createCompiler, CompilerOptions, checkCompilation, ProgramCheckResult
} from '../lib/compiler.zena';
import { loadPackageMap } from '../lib/package-manifest.zena';
import { stdlibIdToRelativeFile } from '../lib/module-resolver.zena';
import { DiagnosticSeverity, SourceSpan } from '../lib/diagnostics.zena';
import { BinaryGenerator } from '../lib/codegen/binary-generator.zena';
import { Program, CompilationUnit } from '../lib/program.zena';

let testsRoot = 'tests/language/execution';
let stdlibRoot = 'packages/stdlib/zena';

/**
 * Where the compile phase leaves the modules the run phase executes.
 * Under `zena/out`, which is git-ignored and which no wireit `output`
 * glob claims — `build:tests` owns `zena/out/test-self` alone.
 */
let outRoot = 'packages/zena-compiler/zena/out/test-exec';

/** ANSI SGR sequence (string literals have no escape for ESC). */
let sgr = (code: String): String => {
  let b = new StringBuilder();
  b.appendByte(27);
  b.append('[');
  b.append(code);
  b.append('m');
  return b.toString();
};

let green = sgr('32');
let red = sgr('31');
let dim = sgr('2');
let reset = sgr('0');

/** What a test file asserts about the program it describes. */
class Expectation {
  /** Expected `--invoke` return value, or null when the test checks stdout. */
  result: String | null;
  /** Expected program output, or null when the test checks the return value. */
  stdout: String | null;
  /** Export to invoke; `main` unless the file says otherwise. */
  invoke: String;

  new(this.result, this.stdout, this.invoke);
}

let expectationOf = (f: TestFile): Expectation => {
  let result = f.directive('result');
  let stdout = f.directive('stdout');
  let invoke = f.directive('invoke');
  return new Expectation(
    if (result == null) { null } else { unquote(result as String) },
    if (stdout == null) { null } else { unescapeNewlines(unquote(stdout as String)) },
    if (invoke == null) { 'main' } else { invoke as String });
};

/** A test file is only a test if it says what running it should produce. */
let isExecutionTest = (f: TestFile): boolean => f.has('result') || f.has('stdout');

let isWhitespaceByte = (b: i32): boolean => b == 32 || b == 9 || b == 13 || b == 10;

let trim = (s: String): String => {
  var start = 0;
  var end = s.length;
  while (start < end && isWhitespaceByte(s.getByteAt(start))) {
    start += 1;
  }
  while (end > start && isWhitespaceByte(s.getByteAt(end - 1))) {
    end -= 1;
  }
  return s.sliceBytes(start, end);
};

/**
 * `zena-cli run --invoke` prints the returned value on its own final
 * line, after anything the program itself printed. A `void` return
 * prints nothing, which is why `@result: undefined` expects the empty
 * string.
 */
let lastLine = (output: String): String => {
  let trimmed = trim(output);
  var i = trimmed.length - 1;
  while (i >= 0) {
    if (trimmed.getByteAt(i) == 10) {
      return trimmed.sliceBytes(i + 1, trimmed.length);
    }
    i -= 1;
  }
  return trimmed;
};

/**
 * Booleans cross the `--invoke` boundary as the i32 they are, so the
 * runner maps them back to what a Zena programmer would write. This is
 * a representation mapping, not a fuzzy match: `1` only reads as `true`
 * where `true` was the stated expectation.
 */
let normalizeResult = (actual: String, expected: String): String => {
  if (expected == 'true' && actual == '1') {
    return 'true';
  }
  if (expected == 'false' && actual == '0') {
    return 'false';
  }
  if (expected == 'undefined' && actual.length == 0) {
    return 'undefined';
  }
  return actual;
};

/**
 * A test whose worker process has been started but not yet waited on —
 * or one that never started, because the compile phase emitted no
 * module for it. Exactly one of `process` and `compileError` is set.
 */
class RunningTest {
  file: TestFile;
  expectation: Expectation;
  process: Process | null;
  compileError: String | null;

  new(this.file, this.expectation, this.process, this.compileError);
}

/**
 * How long a test may run once the pool starts waiting on it, after
 * which it is killed and reported as a failure. A language test that
 * cannot finish in this long is looping, not slow — the whole suite
 * compiles and runs from a cold cache in well under a minute.
 *
 * Because the window reports in submission order, a test that is not
 * yet the oldest keeps running while its predecessors are collected, so
 * this is a floor on the time it gets rather than an exact deadline.
 */
let testTimeoutMs = 120000 as i64;

/**
 * How long a compile worker may take. Generous against the timeout
 * above because a worker carries a whole slice of the suite, not one
 * test — eight slices of the full suite take about four seconds.
 */
let compileTimeoutMs = 600000 as i64;

/**
 * How many entry points share one `Compiler` before it is replaced.
 *
 * Sharing is worth a lot and then stops being worth anything. Compiling
 * all 465 tests, varying only this, and timing the compile loop:
 *
 * | entries per compiler | 1  | 8  | 16 | 24 | 58 | 465 |
 * | compile time (s)     | 28 | 19 | 19 | 19 | 22 | 30  |
 *
 * One compiler for everything is *worse than not sharing at all*, and
 * the whole win is in by ~8. What a compiler accumulates per entry
 * point — nominal types and type parameters in `SharedCheckerState`,
 * nodes in its `ModelIndex`, and instantiations interned onto the
 * stdlib's own generic types — is never collected while it lives, and
 * past a couple of dozen entry points that outweighs the stdlib it
 * saves re-checking. Rebuilding a compiler costs about 17ms.
 *
 * This is a cap, not a batch size: without it the batch size would be
 * tests-per-worker, which grows with the suite, so the suite would get
 * quietly slower per test as it grew.
 */
let entriesPerCompiler = 16;

/** Why a test failed, or null if it passed. */
let failureOf = (e: Expectation, res: ProcessResult): String | null => {
  if (res.timedOut) {
    return `timed out after ${testTimeoutMs}ms and was killed`;
  }
  if (res.exitCode != 0) {
    let detail = if (res.stderr.length > 0) { res.stderr } else { res.stdout };
    return `exited ${res.exitCode}\n${trim(detail)}`;
  }

  let expectedStdout = e.stdout;
  if (expectedStdout != null) {
    let actual = trim(res.stdout);
    if (actual == expectedStdout as String) {
      return null;
    }
    return `expected stdout: ${expectedStdout as String}\n  actual stdout: ${actual}`;
  }

  let expected = e.result as String;
  let actual = normalizeResult(lastLine(res.stdout), expected);
  if (actual == expected) {
    return null;
  }
  return `expected: ${expected}\n  actual:   ${actual}`;
};

/** Waits on a started test and prints its outcome. Returns whether it passed. */
let report = (running: RunningTest): boolean => {
  let compileError = running.compileError;
  let failure = if (compileError != null) {
    `did not compile:\n${compileError as String}`
  } else {
    failureOf(running.expectation, (running.process as Process).waitFor(testTimeoutMs))
  };
  if (failure == null) {
    return true;
  }
  console.log(`${red}FAIL${reset} ${running.file.relPath}`);
  for (let line in (failure as String).split('\n')) {
    console.log(`  ${dim}${line}${reset}`);
  }
  return false;
};

/**
 * Support modules that nothing imports.
 *
 * "Has no `@result:`/`@stdout:`" is what makes a file a support module
 * rather than a test, which would make a forgotten directive look
 * exactly like a helper — the silent skip this runner exists to prevent.
 * So the claim is checked: every non-test must be some other file's
 * import, and anything left over is reported as an error.
 */
let orphanedSupportModules = (d: Discovery): Array<TestFile> => {
  let imported = new HashSet<String>();
  for (let f in d.all()) {
    for (let path in siblingImports(f)) {
      imported.add(path);
    }
  }
  let orphans = new Array<TestFile>(2);
  for (let f in d.support) {
    if (!imported.has(f.path)) {
      orphans.push(f);
    }
  }
  return orphans;
};

// ---------------------------------------------------------------------
// Compile phase
// ---------------------------------------------------------------------

/** Reads sources for the compiler, mapping `zena:x` onto the stdlib. */
class FsHost implements CompilerHost {
  new();

  readFile(path: String): String {
    if (path.startsWith('zena:')) {
      return readFile(`${stdlibRoot}/${stdlibIdToRelativeFile(path)}`);
    }
    return readFile(path);
  }
}

/**
 * Where a test's emitted module goes. `relPath` is unique within the
 * category, so flattening its separators keeps the name unique without
 * needing nested directories.
 */
let artifactBase = (relPath: String): String => {
  let b = new StringBuilder();
  b.append(outRoot);
  b.append('/');
  var i = 0;
  while (i < relPath.length) {
    let byte = relPath.getByteAt(i);
    if (byte == 47) { // '/'
      b.append('__');
    } else {
      b.appendByte(byte);
    }
    i += 1;
  }
  return b.toString();
};

let wasmPathOf = (relPath: String): String => `${artifactBase(relPath)}.wasm`;

/**
 * What the compile phase says about this test, this run: `ok`, or the
 * diagnostics. Its *absence* is what makes a module from a previous run
 * unusable, which is why the module itself is not deleted up front —
 * see `emit` for why its mtime is worth preserving.
 */
let statusPathOf = (relPath: String): String => `${artifactBase(relPath)}.status`;

let bytesEqual = (a: ByteArray, b: ByteArray): boolean => {
  if (a.length != b.length) {
    return false;
  }
  var i = 0;
  while (i < a.length) {
    if (a[i] != b[i]) {
      return false;
    }
    i += 1;
  }
  return true;
};

/**
 * Writes a module only when its bytes changed. `zena-cli` caches the
 * wasmtime-compiled form of a module in a `.cwasm` beside it and
 * decides staleness by mtime, so rewriting an identical module would
 * throw that away and make the run phase re-JIT all 465 — which costs
 * more than the compile phase does. Skipping the write is not a
 * compile cache: the module was compiled either way, and it is the
 * status file, not this one, that says the result is from this run.
 */
let emit = (relPath: String, bytes: ByteArray): void => {
  let path = wasmPathOf(relPath);
  if (exists(path) && bytesEqual(readFileBytes(path), bytes)) {
    return;
  }
  writeFileBytes(path, bytes);
};

/** The tests this run covers, in discovery order — the order slices index into. */
let selectedTests = (filter: String): Array<TestFile> => {
  let discovery = new Discovery();
  collect(testsRoot, '', discovery, isExecutionTest);
  let files = new Array<TestFile>(discovery.tests.length);
  for (let f in discovery.tests) {
    if (filter.length == 0 || f.relPath.contains(filter)) {
      files.push(f);
    }
  }
  return files;
};

/**
 * Compiles one entry point on a shared compiler, threading `previous`
 * so files whose source has not changed — the whole stdlib, every time
 * after the first — carry their `CheckResult` forward instead of being
 * re-checked. Returns the new check result to thread onward, or null
 * if this entry failed; a failure is written to the test's `.err` file
 * rather than raised, so one bad test costs one test rather than the
 * rest of the slice.
 */
let compileOne = (
  compiler: Compiler,
  f: TestFile,
  previous: ProgramCheckResult | null
): ProgramCheckResult | null => {
  return try {
    let compResult = compiler.compile(f.path);
    let checked = checkCompilation(compResult, previous, false);

    let errors = new StringBuilder();
    var hasError = false;
    for (let diag in checked.diagnostics) {
      if (diag.severity == DiagnosticSeverity.Error) {
        if (hasError) { errors.append('\n'); }
        hasError = true;
        if (diag.location != null) {
          let loc = diag.location as SourceSpan;
          errors.append(`${loc.file}:${loc.line + 1}:${loc.column + 1} - ${diag.message}`);
        } else {
          errors.append(diag.message);
        }
      }
    }
    if (hasError) {
      writeFile(statusPathOf(f.relPath), errors.toString());
      // Still threaded: the check ran, and its per-file results are
      // valid for every file that did check.
      checked
    } else {
      let entryAst = compResult.entry.ast;
      let units = new Array<CompilationUnit>();
      var entryUnit: CompilationUnit | null = null;
      for (let file in compResult.files) {
        let res = checked.results[file.path];
        if (res != null) {
          let unit = {ast: file.ast, model: res.model};
          units.push(unit);
          if (file.ast.path == entryAst.path) {
            entryUnit = unit;
          }
        }
      }
      let bytes = new BinaryGenerator('zena-cli', false)
        .generate(new Program(units, entryUnit))
        .toByteArray();
      emit(f.relPath, bytes);
      writeFile(statusPathOf(f.relPath), 'ok');
      checked
    }
  } catch (e) {
    // A throw out of the compiler is a compiler bug, not a test
    // failure, but it still belongs to one test — name it and carry on.
    writeFile(statusPathOf(f.relPath), `the compiler threw: ${e.message}`);
    null
  };
};

/**
 * Worker entry point: compile every test whose position in discovery
 * order is `index` mod `count`. Invoked as
 * `zena-cli run --dir .::/ --invoke compileSlice <self.wasm> <index> <count> <filter>`.
 */
export let compileSlice = (): i32 => {
  let args = getArguments();
  if (args.length < 4) {
    console.error('Usage: compileSlice <index> <count> <filter>');
    return 1;
  }
  var index = 0;
  var count = 1;
  if (let (true, n) = parseI64(args[1])) { index = n as i32; }
  if (let (true, n) = parseI64(args[2])) { count = n as i32; }
  let filter = args[3];

  let files = selectedTests(filter);
  let host = new FsHost();
  let packages = loadPackageMap(host, 'zena-packages.json');
  let options = new CompilerOptions('zena-cli', stdlibRoot, packages);
  var compiler = createCompiler(host, options);

  var previous: ProgramCheckResult | null = null;
  var sinceFresh = 0;
  var pos = 0;
  for (let f in files) {
    if (pos % count == index) {
      if (sinceFresh == entriesPerCompiler) {
        // Nothing to dispose selectively: what a compiler accumulates
        // includes instantiations interned onto the stdlib's own
        // generic types, so the shared part is what the per-entry work
        // grows. Replacing the whole compiler is the disposal.
        compiler = createCompiler(host, options);
        previous = null;
        sinceFresh = 0;
      }
      sinceFresh += 1;
      // Clear the verdict before compiling, so that a test which has
      // started failing — or whose worker dies before reaching it —
      // cannot be run from the module a previous run left behind and
      // reported as a pass. Only a status written by *this* run makes
      // the module beside it usable.
      let statusPath = statusPathOf(f.relPath);
      if (exists(statusPath)) { unlink(statusPath); }
      previous = compileOne(compiler, f, previous);
    }
    pos += 1;
  }
  return 0;
};

/**
 * Runs the compile phase across `workers` processes and waits for all
 * of them. Returns whether every worker exited cleanly; a worker that
 * dies is not fatal on its own, since each of its tests then reports
 * its own missing artifact, but it is worth saying so once.
 */
let runCompilePhase = (
  zenaCli: String,
  selfWasm: String,
  workers: i32,
  filter: String
): boolean => {
  if (!exists(outRoot)) {
    mkdir(outRoot);
  }
  let running = new Array<Process>(workers);
  var i = 0;
  while (i < workers) {
    let argv = new Array<String>(9);
    argv.push(zenaCli);
    argv.push('run');
    // `.` canonicalises against the child's working directory, which
    // is this process's — the repo root. So the slice sees the repo at
    // `/` exactly as the orchestrator does, without either of us
    // needing to know the absolute host path.
    argv.push('--dir');
    argv.push('.::/');
    argv.push('--invoke');
    argv.push('compileSlice');
    argv.push(selfWasm);
    argv.push(i32ToString(i));
    argv.push(i32ToString(workers));
    argv.push(filter);
    running.push(spawn(argv));
    i += 1;
  }

  var allOk = true;
  var slowestNanos = 0 as i64;
  for (let p in running) {
    let res = p.waitFor(compileTimeoutMs);
    if (res.wallNanos > slowestNanos) {
      slowestNanos = res.wallNanos;
    }
    if (!res.succeeded()) {
      allOk = false;
      console.log(`${red}a compile worker failed${reset}`);
      let detail = if (res.stderr.length > 0) { res.stderr } else { res.stdout };
      for (let line in trim(detail).split('\n')) {
        console.log(`  ${dim}${line}${reset}`);
      }
    }
  }
  console.log(
    `${dim}compiled in ${(slowestNanos / (1000000 as i64)) as i32}ms ` +
    `across ${workers} worker(s)${reset}`);
  return allOk;
};

export let main = (): i32 => {
  let args = getArguments();
  if (args.length < 3) {
    console.error('Usage: portable_execution <zenaCli> <parallelism> [filter]');
    return 1;
  }
  let zenaCli = args[1];
  var parallelism = 1;
  if (let (true, n) = parseI64(args[2])) {
    if (n > 1) {
      parallelism = n as i32;
    }
  }
  let filter = if (args.length > 3) { args[3] } else { '' };

  let discovery = new Discovery();
  collect(testsRoot, '', discovery, isExecutionTest);

  let orphans = orphanedSupportModules(discovery);
  if (orphans.length > 0) {
    console.error(
      `${red}${orphans.length} file(s) declare neither @result: nor @stdout:, ` +
      `and nothing imports them — add a directive or delete them:${reset}`);
    for (let f in orphans) {
      console.error(`  - ${f.relPath}`);
    }
    return 1;
  }

  let files = new Array<TestFile>(discovery.tests.length);
  for (let f in discovery.tests) {
    if (filter.length == 0 || f.relPath.contains(filter)) {
      files.push(f);
    }
  }

  if (files.length == 0) {
    console.error(`No execution tests matched '${filter}' under ${testsRoot}`);
    return 1;
  }

  // Report what was found before running anything, so a run that stalls
  // still says what it was going to do.
  discovery.report('Execution', (s: String): void => { console.log(s); });
  if (filter.length > 0) {
    console.log(`${dim}(filter '${filter}': ${files.length} of ${discovery.tests.length} run)${reset}`);
  }

  // Compile everything first, batched, before a single test runs. One
  // slice per pool worker: the same processes would otherwise be idle
  // waiting on compiles, and a slice is where sharing a compiler pays
  // best (see the header).
  let selfWasm = args[0];
  let compileWorkers = if (parallelism < files.length) { parallelism } else { files.length };
  runCompilePhase(zenaCli, selfWasm, compileWorkers, filter);
  console.log('');

  // Sliding-window pool: at most `parallelism` `zena-cli run` workers in
  // flight, results reported in discovery order as the window advances.
  var passed = 0;
  var failed = 0;
  let running = new Array<RunningTest>(files.length);
  var reported = 0;
  var next = 0;
  while (next < files.length || reported < running.length) {
    if (running.length - reported >= parallelism || next >= files.length) {
      let oldest = running[reported];
      reported += 1;
      if (report(oldest)) {
        passed += 1;
      } else {
        failed += 1;
      }
      continue;
    }
    let file = files[next];
    next += 1;
    let expectation = expectationOf(file);
    let wasmPath = wasmPathOf(file.relPath);
    let statusPath = statusPathOf(file.relPath);
    let status = if (exists(statusPath)) { readFile(statusPath) } else { null };
    if (status == null || status as String != 'ok' || !exists(wasmPath)) {
      // Anything other than an `ok` written by this run's compile phase
      // means this test has no module to run: it failed to compile, or
      // its worker died before reaching it. Either way it failed, and
      // says why.
      let why = if (status != null && status as String != 'ok') {
        status as String
      } else {
        'the compile phase left no verdict for this test ' +
        '(its worker most likely died — look for a failed compile worker above)'
      };
      running.push(new RunningTest(file, expectation, null, why));
      continue;
    }
    let argv = new Array<String>(6);
    argv.push(zenaCli);
    argv.push('run');
    argv.push('--invoke');
    argv.push(expectation.invoke);
    argv.push(wasmPath);
    running.push(new RunningTest(file, expectation, spawn(argv), null));
  }

  // Worded exactly as `zena:test`'s runAndReport does, so this suite
  // reads the same as the others and run-wasmtime.js can count it.
  console.log('');
  if (failed == 0) {
    console.log(`${green}✓ ${passed} of ${passed} test(s) passed${reset}`);
  } else {
    console.log(`${red}✗ ${failed} failed, ${passed} passed of ${passed + failed} test(s)${reset}`);
  }
  return failed;
};
