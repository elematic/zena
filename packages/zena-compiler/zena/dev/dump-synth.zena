// Dev tool: print a synthesized WIT module's source, for debugging the
// generator. Usage:
//   zena-cli run zena/dev/dump-synth.zena --dir . -- 'wit:<root>#<ns>:<path>'
import { getArguments } from 'zena:cli';
import { synthesizeWitModule } from '../lib/wit-module-synth.zena';

export function main(): i32 {
  let args = getArguments();
  console.log(synthesizeWitModule(args[args.length - 1]));
  return 0;
}
