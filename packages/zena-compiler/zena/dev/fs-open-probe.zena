// Dev probe: open a file through zena:fs and print what fails, with the
// message an uncaught exception would not show under zena-run. Usage:
//   zena-run <compiler.wasm> zena/dev/fs-open-probe.zena -o out.wasm
//   zena-run --dir .::. out.wasm
import { readFile, exists } from 'zena:fs';

export async function main(): Future<i32> {
  try {
    console.log(`exists ${await exists('package.json')}`);
    let text = await readFile('package.json');
    console.log(`read ${text.length} bytes`);
  } catch (e) {
    console.log(`error: ${e.message}`);
    return 1;
  }
  return 0;
}
