// Compilation targets.
//
// A target names the *host* a program is compiled for, and the output form
// follows from it. There is no separate flag for "core module or
// component": WASI p2 and p3 are WIT interfaces and reachable only from a
// component, while the JS runtime's `console.*` and `zena-cli`'s `env.*`
// hooks are reachable only from a core module — so three of the eight
// combinations a second flag would offer cannot be built at all.
//
// See docs/design/component-emission.md, Part 3.
//
//   js            core module, `@zena-lang/runtime` imports
//   zena-cli      component, WASI 0.3 plus the `zena-cli:host` interfaces
//                 the zena command's host provides (stack traces, process
//                 spawning, running components)
//   freestanding  core module, nothing beyond what the program declares
//                 with `@external`
//   component     component, WASI 0.3 and application worlds: what any
//                 component host can run
//
// What a target selects is a set of standard-library implementations, and
// therefore an import set: `ModuleResolver` picks the `virtual` entry
// named by the target, and a module with no entry for it does not resolve.
// That is what makes `freestanding`'s floor structural rather than a
// matter of discipline — nothing can supply a host import behind the
// program's back.


/** The targets a program can be built for, in `--target`'s own spelling. */
export let targetNames = (): FixedArray<String> =>
    ["js", "zena-cli", "freestanding", "component"];

/** Legacy spellings still accepted by `--target`: `host` predates `js`. */
let legacyTargetNames = (): FixedArray<String> => ["host"];

/**
 * The current name of a target: `host` becomes `js`, and any other name
 * is returned as it is. Module resolution works in current names only,
 * so a manifest lists each entry once.
 */
export let canonicalTarget = (target: String): String => {
  if (target == "host") {
    return "js";
  }
  return target;
};

/** Whether `target` is a target name the compiler knows. */
export let isKnownTarget = (target: String): boolean => {
  for (let t in targetNames()) {
    if (t == target) {
      return true;
    }
  }
  for (let t in legacyTargetNames()) {
    if (t == target) {
      return true;
    }
  }
  return false;
};

/** `--target`'s accepted spellings, for an error message. */
export let knownTargetsDescription = (): String => {
  var out = "";
  for (let t in targetNames()) {
    if (out != "") {
      out = out + ", ";
    }
    out = out + "'" + t + "'";
  }
  for (let t in legacyTargetNames()) {
    out = out + ", '" + t + "' (legacy)";
  }
  return out;
};

/**
 * Whether the target's output is a component rather than a core module.
 * A component is the only form that can reach WASI p2 or p3.
 */
export let targetEmitsComponent = (target: String): boolean =>
    target == "component" || target == "zena-cli";

