  TryExpression, TupleLiteral, UnaryExpression, getMemberPropertyName
} from '../ast.zena';
import {
  ArrayType, BoolLiteralType, BooleanType, ClassType, ErrorType, F32Type,
  F64Type, FieldInfo, FunctionType, HoleType, I32Type, I64Type,
  InlineTupleType as InlineTupleT, InterfaceType, MethodInfo, NeverType,
  NullType, RecordType as RecordT, TupleType as TupleT, Type, TypeAliasType,
  TypeParameterType, U64Type, UnionType as UnionT, UnknownType, VoidType,
  applyTypeIntrinsic, baseType, instantiateClassType,
  instantiateTypeAliasType, isBooleanLike, isIntegerType, isNumericType,
