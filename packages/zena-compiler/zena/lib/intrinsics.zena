import { HashSet } from 'zena:set';
import { simdInstruction } from './simd.zena';

let validIntrinsics = new HashSet<String>();
let intrinsics = [
    'array.len',
    'array.get',
    'array.get_u',
    'array.set',
    'array.new',
    'array.new_default',
    'array.new_fixed',
    'array.new_data',
    'array.copy',
    'array.fill',
    'array.init_data',
    'array.init_elem',
    'memory.size',
    'memory.grow',
    'i32.load',
    'i32.load8_u',
    'i32.load8_s',
    'i32.store',
    'i32.store8',
    'i64.load',
    'i64.store',
    'f32.load',
    'f32.store',
    'f64.load',
    'f64.store',
    'eq',
    'hash',
        'wasi_write_string',
    'unreachable',
    'f32.abs',
    'f32.ceil',
    'f32.copysign',
    'f32.floor',
    'f32.max',
    'f32.min',
    'f32.nearest',
    'f32.neg',
    'f32.reinterpret_i32',
    'f32.sqrt',
    'f32.trunc',
    'f64.abs',
    'f64.ceil',
    'f64.copysign',
    'f64.floor',
    'f64.max',
    'f64.min',
    'f64.nearest',
    'f64.neg',
    'f64.reinterpret_i64',
    'f64.sqrt',
    'f64.trunc',
    'i32.clz',
    'i32.ctz',
    'i32.div_s',
    'i32.div_u',
    'i32.popcnt',
    'i32.reinterpret_f32',
    'i32.trunc_sat_f32_s',
    'i32.trunc_sat_f32_u',
    'i32.trunc_sat_f64_s',
    'i32.trunc_sat_f64_u',
    'i64.clz',
    'i64.ctz',
    'i64.div_s',
    'i64.div_u',
    'i64.popcnt',
    'i64.reinterpret_f64',
    'i64.trunc_sat_f32_s',
    'i64.trunc_sat_f32_u',
    'i64.trunc_sat_f64_s',
    'i64.trunc_sat_f64_u',
];
var initialized = false;

export let isValidIntrinsic = (name: String): boolean => {
  // TODO: We need a way to make a set from an array
  if (!initialized) {
    initialized = true;
    for (let intrinsic in intrinsics) {
      validIntrinsics.add(intrinsic);
    }
  }
  if (validIntrinsics.has(name)) {
    return true;
  }
  // The SIMD instructions are not listed above: their names, opcodes and
  // operand shapes come from one table in simd.zena, which the ZIR
  // lowering router reads too. Listing them here as well would be a
  // second place for the set to drift out of.
  return simdInstruction(name) != null;
};
