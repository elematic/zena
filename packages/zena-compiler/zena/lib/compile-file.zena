/**
 * Compiling one source file to a module on disk: what `zc` does, as a
 * function other programs can call. The compiler's own command line
 * (`zena/cli/main.zena`) and the `zena` command line both use it.
 *
 * It reads source and writes the module through `zena:fs`, so the caller
 * decides what it can reach through its preopens: the entry and its
 * package manifest are read relative to the working directory, and the
 * standard library from `stdlibRoot`.
 */

import { getEnv } from 'zena:cli';
import { StringBuilder } from 'zena:core';
import { readFile, writeFileBytes, writeFile, exists } from 'zena:fs';
import { CompilerHost } from './library-loader.zena';
import { PackageConfig, stdlibIdToRelativeFile } from './module-resolver.zena';
import { loadPackageMap } from './package-manifest.zena';
import {
  createCompiler, CompileOptions, checkCompilation, withBuiltinPackages,
  setCheckAllBodies
} from './compiler.zena';
import { DiagnosticSeverity, SourceSpan, SyntaxError } from './diagnostics.zena';
import { BinaryGenerator } from './codegen/binary-generator.zena';
import { WatGenerator } from './codegen/wat-generator.zena';
import { Program, CompilationUnit } from './program.zena';
import { Module } from './ast.zena';
import { nowMs, performance } from './time.zena';
import { isKnownTarget, knownTargetsDescription, targetEmitsComponent } from './targets.zena';
import { compileComponentRuntimeModule } from './codegen/component-runtime.zena';
import { makeImportEncoder } from './codegen/wit-imports.zena';
import {
  isWitModulePath, synthesizeWitModule, synthesizeExportWrapper,
  declaredPackageNamespaces
} from './wit-module-synth.zena';
import { ComponentEntryWrapper } from './component-entry.zena';
import { readWitSource } from './wit-source.zena';
import { directoryNames } from './fs-host.zena';

/**
 * "-O" levels: 0, 1, 2, and s (size — the loop with budgets down,
 * currently equal to 2). Returns -1 on anything else.
 */
export let parseOptLevel = (text: String): i32 => {
  if (text == "0") { return 0; }
  if (text == "1") { return 1; }
  if (text == "2") { return 2; }
  if (text == "s") { return 2; }
  return -1;
};

/** What `target` means when a request leaves it out. */
export let defaultTarget = "zena-cli";

/** What `optLevel` means when a request leaves it out. */
export let defaultOptLevel = 1;

/** What to compile, where to put it, and how. */
export type CompileFileOptions = {
  /** The source file, relative to the working directory. */
  entry: String,
  /** Where to write the module; a `.wat` path writes the text form. */
  outPath: String,
  target?: String,
  /**
   * Compile a test suite: a file without its own `main` gets one that
   * runs `tests` through `zena:test`'s `runAndReport`.
   */
  testMode?: boolean,
  /** Print a report of how long each compiler phase took. */
  time?: boolean,
  /** A WIT file or directory declaring the component's world. */
  witPath?: String,
  /** Which world in `witPath`, when it declares several. */
  worldName?: String,
  /** Emit a name section, so traps name functions. */
  debugNames?: boolean,
  warnUnnecessaryCasts?: boolean,
  /** 0, 1 or 2; see docs/design/optimization-pipeline.md. */
  optLevel?: i32,
  /** Where the standard library's `zena/` directory is. */
  stdlibRoot?: String,
  /** Print "Compiling ..." and "Success: wrote ..." lines. */
  progress?: boolean,
  /**
   * Called with each source file's path just before the compiler reads
   * it, as the compiler names it: relative to the working directory, or
   * under `stdlibRoot`. A compile cache records these to know when its
   * entry is stale.
   */
  onRead?: (path: String) => void,
};

/** The default `onRead`: a compile nothing is caching ignores it. */
function ignoreRead(path: String): void {}

/**
 * The host the compiler reads source through: files from the working
 * directory, `zena:` modules from the standard library, and WIT-backed
 * modules synthesized from their WIT.
 */
class FileHost implements CompilerHost {
  testMode: boolean;
  entryPath: String;
  stdlibRoot: String;
  onRead: (path: String) => void;
  /** The WIT-backed packages' source, once it has been read. */
  var packagesWit = "";
  new(this.testMode, this.entryPath, this.stdlibRoot, this.onRead);

  readFile(path: String): String {
    // A WIT-backed package's module: no file exists — the source is
    // synthesized from the package's WIT.
    if (isWitModulePath(path)) {
      return synthesizeWitModule(this, path, this.packagesWit);
    }
    var actualPath = path;
    if (path.startsWith("zena:")) {
      actualPath = this.stdlibRoot + "/" + stdlibIdToRelativeFile(path);
    }
    let onRead = this.onRead;
    onRead(actualPath);
    let content = readFile(actualPath);
    if (this.testMode && path == this.entryPath) {
      // A file that declares its own entry point is left alone. This runs
      // before the source is parsed, so the test is textual; what matters is
      // that it be narrow enough not to fire on ordinary prose or data.
      //
      // It used to look for "let main", "main =" or "main(" anywhere in the
      // file, which matched far more than declarations: `let mainScope`, and
      // — inside a string literal — the `domain(` of a URL pattern. A suite
      // that merely mentioned one got no entry point and then failed with
      // "Failed to find `main` export", naming nothing in the file that
      // caused it. See tests/test/wrapper-main-substring_test.zena.
      if (content.contains("export let main ") ||
          content.contains("export let main=") ||
          content.contains("export function main(")) {
        return content;
      }
      return "import {runAndReport} from 'zena:test';\n" +
        content +
        "\nexport let main = (): i32 => {\n  return runAndReport(tests, (s: String): void => {\n    console.log(s);\n  });\n};\n";
    }
    return content;
  }

  listDir(path: String): Array<String> | null {
    return directoryNames(path);
  }
}

// Load package configs ("zena-compiler:parser" → file path) from the manifest
// in the working directory. A missing manifest is fine — standalone files need
// only stdlib and relative imports — but a malformed one throws loudly.
let loadPackages = (host: CompilerHost): Map<String, PackageConfig> => {
  if (!exists("zena-packages.json")) {
    return new Map<String, PackageConfig>();
  }
  return loadPackageMap(host, "zena-packages.json");
};

let reportDiagnosticLine = (kind: String, file: String, line: i32, column: i32, message: String): void => {
  console.error(file + ":" + i32ToString(line) + ":" + i32ToString(column) + " - " + kind + ": " + message);
};

/** `text` followed by spaces, up to `width` bytes. */
let padRight = (text: String, width: i32): String => {
  let b = new StringBuilder();
  b.append(text);
  var i = text.length;
  while (i < width) {
    b.append(" ");
    i += 1;
  }
  return b.toString();
};

/** Spaces followed by `text`, up to `width` bytes. */
let padLeft = (text: String, width: i32): String => {
  let b = new StringBuilder();
  var i = text.length;
  while (i < width) {
    b.append(" ");
    i += 1;
  }
  b.append(text);
  return b.toString();
};

/** Milliseconds to one decimal place. */
let ms1 = (value: f64): String => {
  return f64ToString(((value * 10.0) as i64 as f64) / 10.0);
};

/**
 * The longest phase name that is a proper prefix of `name` followed by
 * `-`, or null. `codegen-discovery-init` nests under
 * `codegen-discovery` rather than under `codegen`, so the longest
 * match wins.
 */
let parentPhaseOf = (name: String, names: Array<String>): String | null => {
  var best: String | null = null;
  for (let candidate in names) {
    if (candidate.length >= name.length) {
      continue;
    }
    if (!name.startsWith(`${candidate}-`)) {
      continue;
    }
    let incumbent = best;
    if (incumbent == null || candidate.length > incumbent.length) {
      best = candidate;
    }
  }
  return best;
};

/**
 * Prints every phase `performance` measured, in the order the compiler
 * first entered each, nested under the phase whose name prefixes it.
 * The total is the sum of the top-level phases, which are the ones that
 * do not overlap.
 *
 * The report reads the phase list rather than naming phases itself, so
 * a `performance.start` added anywhere in the compiler appears here
 * without this function changing.
 */
let printTimingReport = (): void => {
  let phases = performance.phases();
  if (phases.length == 0) {
    return;
  }
  let names = new Array<String>(phases.length);
  for (let phase in phases) {
    names.push(phase.name);
  }

  console.log("");
  console.log("=== Compiler Timing Report ===");
  var total = 0.0;
  for (let phase in phases) {
    let parent = parentPhaseOf(phase.name, names);
    var depth = 0;
    var walk = parent;
    while (walk != null) {
      depth += 1;
      walk = parentPhaseOf(walk as String, names);
    }
    // A top-level phase is one no other phase contains, so these are
    // the ones that sum to the whole compile.
    let label = if (parent == null) {
      total = total + phase.total;
      phase.name
    } else {
      phase.name.sliceBytes((parent as String).length + 1, phase.name.length)
    };
    let indent = padRight("", depth * 2);
    let calls = if (phase.count == 1) { "" } else { ` (${i32ToString(phase.count)} calls)` };
    console.log(`${padRight(`${indent}${label}:`, 28)}${padLeft(ms1(phase.total), 9)} ms${calls}`);
  }
  console.log("------------------------------");
  console.log(`${padRight("Total:", 28)}${padLeft(ms1(total), 9)} ms`);
  console.log("==============================");
};

/**
 * Compiles `options.entry` and writes the module to `options.outPath`.
 * Returns 0 on success. On a mistake in the options or an error in the
 * program it prints the diagnostics to stderr and returns 1; it never
 * ends the process, so a caller can compile again.
 */
export let compileFile = (options: CompileFileOptions): i32 => {
  // ZENA_CHECK_ALL_BODIES=1 checks every loaded module's bodies when
  // its module is checked, instead of leaving a dependency's for
  // reachability to ask for. See docs/design/lazy-body-checking.md.
  setCheckAllBodies(getEnv("ZENA_CHECK_ALL_BODIES") != null);

  let {entry: filename, outPath} = options;
  let {
    witPath = "",
    worldName = "",
    stdlibRoot = "/stdlib",
    testMode = false,
    time = false,
    debugNames = false,
    warnUnnecessaryCasts = false,
    progress = false,
  } = options;
  // Read with `??` rather than a destructuring default: a default in a
  // destructuring pattern does not see module-level bindings, and these
  // three name theirs rather than writing it out.
  let target = options.target ?? defaultTarget;
  let optLevel = options.optLevel ?? defaultOptLevel;
  let onRead = options.onRead ?? ignoreRead;

  if (!isKnownTarget(target)) {
    console.error("Error: invalid target '" + target + "' (expected " +
        knownTargetsDescription() + ")");
    return 1;
  }
  // A declared world (docs/design/component-emission.md, Part 3): the
  // WIT becomes the authority the program is compiled against, and
  // disagreements between it and the Zena are errors.
  if ((witPath != "" || worldName != "") && !targetEmitsComponent(target)) {
    console.error(
        "Error: --wit/--world declare a component's world, and the " +
        "target is '" + target + "'. Use --target component.");
    return 1;
  }
  if (worldName != "" && witPath == "") {
    console.error("Error: --world names a world in a --wit document, " +
        "and no --wit was given.");
    return 1;
  }

  let host = new FileHost(testMode, filename, stdlibRoot, onRead);
  // The declared world's WIT: one file, or a directory whose *.wit
  // files are concatenated in name order into one document.
  var witSource = "";
  if (witPath != "") {
    if (!exists(witPath)) {
      console.error("Error: --wit path does not exist: " + witPath);
      return 1;
    }
    witSource = readWitSource(host, witPath);
  }
  let packages = loadPackages(host);
  // A declared world's document answers for its own packages: the
  // program imports the world's interfaces by name (`test:app/oracle`
  // for a document declaring `package test:app`), and the resolver
  // maps the namespace to a WIT-backed package rooted at the document.
  // A namespace the manifest or the stdlib already provides keeps its
  // package — a document vendoring `wasi:clocks` does not take over
  // `wasi` — and its interfaces are reached as before.
  if (witSource != "") {
    for (let namespace in declaredPackageNamespaces(witSource)) {
      if (namespace == "wasi" || packages.has(namespace)) { continue; }
      let declared = new PackageConfig("", null);
      declared.witRoot = witPath;
      packages[namespace] = declared;
    }
  }
  let compiler = createCompiler(host, {stdlibRoot, packages, warnUnnecessaryCasts});
  // The WIT-backed packages' real source, so the encoder emits their
  // interfaces' true types rather than deriving them from the
  // synthesized declarations (which are flattened core shapes), and so
  // a declared world can import their interfaces by name. Name-sorted:
  // a HashMap iterates in uid order, which depends on what the process
  // did earlier, and emitted bytes must not.
  var packagesWit = "";
  if (targetEmitsComponent(target)) {
    // Including the packages the stdlib carries (`wasi`), the same
    // set the resolver sees.
    let allPackages = withBuiltinPackages(stdlibRoot, packages);
    let witPackages = new Array<String>();
    let packageNames = allPackages.keys();
    for (let packageName in packageNames) {
      let root = allPackages[packageName].witRoot;
      // The declared document is the world's own source, parsed
      // alongside these; it does not ride along a second time.
      if (root != null && (root as String) != witPath) {
        witPackages.push(packageName);
      }
    }
    let byteLess = (x: String, y: String): boolean => {
      var minLen = x.length;
      if (y.length < minLen) { minLen = y.length; }
      for (var i = 0; i < minLen; i += 1) {
        let d = x.getByteAt(i) - y.getByteAt(i);
        if (d != 0) { return d < 0; }
      }
      return x.length < y.length;
    };
    for (var a = 0; a < witPackages.length; a += 1) {
      for (var b = a + 1; b < witPackages.length; b += 1) {
        if (byteLess(witPackages[b], witPackages[a])) {
          let t = witPackages[a];
          witPackages[a] = witPackages[b];
          witPackages[b] = t;
        }
      }
    }
    for (let packageName in witPackages) {
      packagesWit = packagesWit +
          readWitSource(host, allPackages[packageName].witRoot as String) + "\n";
    }
    host.packagesWit = packagesWit;
  }
  // Against a declared world the entry wrapper also implements the
  // world's async exports, which takes the WIT the compiler itself does
  // not link. Without a declared world the compiler writes its own.
  let declaredWit = witSource;
  let declaredWorld = worldName;
  let declaredPackages = packagesWit;
  let compileOptions: CompileOptions = if (witSource == "") {
    {entry: filename, target}
  } else {
    {
      entry: filename,
      target,
      componentWrapperSynth:
          (entryPath: String, ast: Module): ComponentEntryWrapper | null =>
              synthesizeExportWrapper(declaredWit, declaredWorld, entryPath,
                  ast, declaredPackages),
    }
  };

  if (progress) {
    console.log("Compiling " + filename + "...");
  }
  try {
    let compResult = compiler.compile(compileOptions);

    let checkResults = checkCompilation(compResult);
    let {diagnostics} = checkResults;
    var hasError = false;
    for (let diag in diagnostics) {
      if (diag.severity == DiagnosticSeverity.Error) {
        if (diag.location != null) {
          let loc = diag.location as SourceSpan;
          reportDiagnosticLine("Error", loc.file, loc.line, loc.column, diag.message);
        } else {
          console.error("Error: " + diag.message);
        }
        hasError = true;
      } else if (warnUnnecessaryCasts && diag.severity == DiagnosticSeverity.Warning) {
        if (diag.location != null) {
          let loc = diag.location as SourceSpan;
          reportDiagnosticLine("Warning", loc.file, loc.line, loc.column, diag.message);
        } else {
          console.error("Warning: " + diag.message);
        }
      }
    }

    if (hasError) {
      return 1;
    }

    checkResults.results[filename].model;
    let entryAst = compResult.entry.ast;
    let units = new Array<CompilationUnit>();
    var entryUnit: CompilationUnit | null = null;
    for (let file in compResult.files) {
      let res = checkResults.results[file.path];
      if (res != null) {
        let unit = {ast: file.ast, model: res.model};
        units.push(unit);
        if (file.ast.path == entryAst.path) {
          entryUnit = unit;
        }
      }
    }
    let tCodegen = performance.start("codegen");
    let program = new Program(units, entryUnit);

    // Every compile goes AST -> ZIR -> wasm; a lowering bail is a
    // fatal error. ZENA_ZIR_STATS=1 prints the lowered count.
    let zirStats = getEnv("ZENA_ZIR_STATS") != null;

    // ZENA_WIDE_ARITHMETIC=1 emits the wide-arithmetic proposal's
    // instructions instead of the sequences that mean the same thing.
    // Opt-in because V8 does not implement the proposal yet.
    let wideArithmetic = getEnv("ZENA_WIDE_ARITHMETIC") != null;

    // `-o out.wat` emits the WAT text directly — the readable form of
    // exactly what the binary build would contain, for inspecting a
    // program's emitted shape (`zena build hello.zena -o hello.wat`).
    if (outPath.endsWith(".wat")) {
      let watOnly = new WatGenerator(target, zirStats, optLevel);
      watOnly.wideArithmetic = wideArithmetic;
      writeFile(outPath, watOnly.generate(program));
      performance.end(tCodegen);
      if (progress) {
        console.log("Success: wrote " + outPath);
      }
      return 0;
    }

    let generator = new BinaryGenerator(target, zirStats, debugNames, optLevel);
    generator.wideArithmetic = wideArithmetic;
    if (targetEmitsComponent(target)) {
      // The component's second core module, owning linear memory and
      // the allocator. Compiled up front — whether the program needs it
      // is only known after its own compile, and this one is small.
      //
      // The module emits few bytes and still costs a whole compile, with
      // its own load, parse, scope and check of the standard library it
      // draws on, which land in the same phase totals as the program's
      // own. Timed separately so the report says how much of a component
      // build is this module.
      let tRuntimeModule = nowMs();
      generator.runtimeMemoryModule =
          compileComponentRuntimeModule(compiler, stdlibRoot);
      performance.add("codegen-runtime-module", nowMs() - tRuntimeModule);
      // A declared world compiles against its own document, with the
      // WIT-backed packages spliced in so it can import their
      // interfaces by name; without one, each interface's WIT is
      // derived from the program, except for the packages' own.
      generator.importEncoder = if (witPath != "") {
        makeImportEncoder(witSource, worldName, packagesWit)
      } else {
        makeImportEncoder(null, "", packagesWit)
      };
    }
    let wasmBytes = generator.generate(program).toByteArray();
    writeFileBytes(outPath, wasmBytes);

    // The WAT dump runs a SECOND full generator pass and its text
    // dwarfs the binary (~30x — the tests module's dump is ~135 MB),
    // so it is opt-in for debugging.
    if (getEnv("ZENA_EMIT_WAT") != null) {
      let watGenerator = new WatGenerator(target, false, optLevel);
      let watString = watGenerator.generate(program);
      writeFile(outPath + ".wat", watString);
    }
    performance.end(tCodegen);

    if (progress) {
      console.log("Success: wrote " + outPath);
    }

    if (time) {
      printTimingReport();
    }
  } catch (e) {
    // A syntax error is a fault in the input, and the parser has already
    // formatted it with its file, line, column and an underline. Report
    // it the way a type error is reported and fail: the banner and the
    // wasm backtrace below are for a fault in the compiler itself, and
    // printing them here says the wrong thing about whose bug it is.
    if (e is SyntaxError) {
      console.error(e.message);
      return 1;
    }
    console.log("Exception caught in CLI compiler!");
    if (e is Error) {
      console.log("Error message: " + e.message);
      let stack = e.getStackTrace();
      if (stack != null) {
        console.log("Stack Trace: \n" + stack);
      }
    }
    throw e;
  }

  return 0;
};
