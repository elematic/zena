import { targetEmitsComponent } from './targets.zena';

// Build the standard prelude map (module specifier → imported names).
// The compiler injects these into every file automatically.
// Explicit strings to import are used to limit namespace pollution.
// Note: Some primitive types (i32, f64, Array) are injected as language built-ins
// during scope resolution, so they don't need to be explicitly imported.
//
// The prelude is per-target because it is an import list like any
// other, and a virtual module resolves per target — but the list is
// the same on every target: `console` included, so that code that
// prints is portable. A target with no host to print to gets the
// component's console. See docs/design/component-emission.md, Part 3.
export let getStandardPrelude = (target: String): Map<String, FixedArray<String>> => {
  let prelude = new Map<String, FixedArray<String>>();

  // One entry for what used to be thirteen. The names are unchanged —
  // they are the same declarations, reached through the library that
  // owns them now that its members have no module names of their own.
  prelude["zena:core"] = [
    "String",
    "Error", "IndexOutOfBoundsError", "unreachable",
    "Option", "Some", "None", "some", "none",
    "Iterator", "Iterable",
    "Array", "MutableArray",
    "BoundedRange", "FromRange", "ToRange", "FullRange",
    "ImmutableArray", "FixedArray", "GrowableArray",
    "Hashable", "Box", "Resource",
    "i32ToString", "i64ToString", "f64ToString",
    "parseI32", "parseI64", "parseF64"
  ];
  // On every target, so that code that prints is portable. A target
  // with no host to print to gets the component's console, which is
  // what a hostless core module is once wrapped.
  prelude["zena:console"] = ["console"];
  prelude["zena:collections"] = ["Map", "HashMap"];
  prelude["zena:async"] = ["Future", "Awaited"];
  return prelude;
};

/**
 * Modules a target links whether or not the program names them.
 *
 * Not a prelude: the prelude is the list of names bound into every file,
 * and these bind nothing. They are here because the compiler
 * synthesizes calls into them, and a module it generates calls into has
 * to be in the graph before reachability runs. Reachability still
 * decides whether any of it is emitted — a component that moves no
 * strings links none of `zena:wasi`'s marshaling.
 *
 * Loaded **after** the entry point. Reachability roots a module's
 * exports by iterating `globalDeclarations`, which is in declaration
 * order, so a module loaded ahead of the entry no longer permutes what
 * the entry emits — it used to, when that map iterated in symbol-id
 * hash order. Loading afterwards is still the tidier shape: the
 * entry's symbol ids are the same with or without the runtime
 * modules, which keeps the component target's core module identical
 * to a hostless build's for one more reason than the ordered map.
 */
export let getTargetRuntimeModules = (target: String): FixedArray<String> => {
  if (target == "zena-cli") {
    // The zena command's host also supplies `Error`'s stack traces and
    // the blocking wait, through a module the component entry calls
    // before `main`.
    return ["zena:wasi", "zena:host-setup"];
  }
  if (targetEmitsComponent(target)) {
    return ["zena:wasi"];
  }
  return new Array<String>.fixed(0, "");
};
