import { HashMap } from 'zena:map';
import { targetHasConsole, targetEmitsComponent } from './targets.zena';

// Build the standard prelude map (module specifier → imported names).
// The compiler injects these into every file automatically.
// Explicit strings to import are used to limit namespace pollution.
// Note: Some primitive types (i32, f64, Array) are injected as language built-ins
// during scope resolution, so they don't need to be explicitly imported.
//
// The prelude is per-target, because it is an import list like any other.
// `console` is the entry that varies: a target with no host to print to
// (`freestanding`, `component`) does not bind it, so `console.log` is an
// unresolved name there rather than a call that compiles and prints
// nothing. See docs/design/component-emission.md, Part 3.
export let getStandardPrelude = (target: String): HashMap<String, FixedArray<String>> => {
  let prelude = new HashMap<String, FixedArray<String>>();

  prelude["zena:string"] = ["String"];
  prelude["zena:error"] = ["Error", "IndexOutOfBoundsError", "unreachable"];
  prelude["zena:option"] = ["Option", "Some", "None", "some", "none"];
  prelude["zena:sequence"] = ["Sequence", "MutableSequence"];
  prelude["zena:range"] = ["BoundedRange", "FromRange", "ToRange", "FullRange"];
  prelude["zena:immutable-array"] = ["ImmutableArray"];
  prelude["zena:fixed-array"] = ["FixedArray"];
  prelude["zena:growable-array"] = ["Array"];
  if (targetHasConsole(target)) {
    prelude["zena:console"] = ["console"];
  }
  prelude["zena:map"] = ["Map", "HashMap"];
  prelude["zena:box"] = ["Box"];
  prelude["zena:string-convert"] = [
    "i32ToString", "i64ToString", "f64ToString", "parseI32", "parseI64", "parseF64"
  ];
  if (targetEmitsComponent(target)) {
    // Loaded, and bound under no name. The component target synthesizes
    // wrappers that call these, and a module the compiler generates
    // calls into has to be in the graph before reachability runs — but
    // a program never names them itself, so binding them would be
    // namespace pollution with nothing on the other end. Reachability
    // decides whether any of it is emitted: a component that moves no
    // strings links none of it.
    prelude["zena:canonical-abi"] = new FixedArray<String>(0, "");
  }

  return prelude;
};
