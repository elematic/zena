import { CodeGenerator } from './code-generator.zena';
import { ByteBuffer } from 'zena:byte-buffer';
import { Program } from '../program.zena';
import { BinaryEmitter } from './binary-emitter.zena';
import { ModuleGenerator } from './module-generator.zena';
import { emitComponent, ComponentShape, ImportTypeEncoder } from './component-emitter.zena';
import { targetEmitsComponent } from '../targets.zena';

/**
 * The stateless entry point for WebAssembly code generation.
 * Creates a module builder and delegates the compilation of the given program.
 */
export final class BinaryGenerator implements CodeGenerator<ByteBuffer> {
  target: String;
  zirStats: boolean;
  /**
   * Emit the `name` custom section. Off by default: the section is
   * pure debug metadata and, for a small program, the largest thing in
   * the module — 9.9KB of a 34KB hello-world. `-g` turns it on.
   */
  debugNames: boolean;

  backendName(): String { return 'wasm'; }

  /**
   * The runtime memory module's bytes, for the component target. The
   * driver compiles them once per build (`compileComponentRuntimeModule`)
   * and hands them here; a component whose program uses linear memory
   * cannot be emitted without them, and `emitComponent` says so.
   */
  var runtimeMemoryModule: ByteBuffer | null = null;

  /**
   * The WIT import encoder, injected beside the runtime module by
   * drivers that emit components. Codegen calls it through this
   * indirection so it does not link the WIT parser itself.
   */
  var importEncoder: ImportTypeEncoder | null = null;

  /**
   * Emit the wide-arithmetic proposal's instructions (`i64.mul_wide_u`
   * and friends) instead of the 32-bit-halves sequences that mean the
   * same thing. Off by default: wasmtime, wasmi, JavaScriptCore and
   * SpiderMonkey implement the proposal, V8 does not yet, and the
   * stdlib has to run under `node`. ZENA_WIDE_ARITHMETIC=1 turns it on.
   */
  var wideArithmetic: boolean = false;

  /** Optimization level, forwarded to ModuleGenerator. */
  optLevel: i32;

  new(this.target = "zena-cli", this.zirStats = false, this.debugNames = false,
      this.optLevel = 1);

  generate(program: Program): ByteBuffer {
    let bb = new ByteBuffer();
    let emitter = new BinaryEmitter(bb, this.debugNames);
    let generator = new ModuleGenerator(program, emitter, this.target, this.zirStats,
        this.optLevel);
    generator.wideArithmetic = this.wideArithmetic;
    generator.importEncoder = this.importEncoder;
    generator.compile();
    // A component is the same core module with a wrapper around it: the
    // module is embedded verbatim, and the component contributes only
    // types, instantiation and the lift/lower adapters.
    if (targetEmitsComponent(this.target)) {
      let shape = generator.componentShape;
      if (shape == null) {
        throw new Error(
          "The component target produced no component shape — " +
          "ModuleGenerator.compile did not collect one."
        );
      }
      return emitComponent(bb, shape, this.runtimeMemoryModule);
    }
    return bb;
  }
}
