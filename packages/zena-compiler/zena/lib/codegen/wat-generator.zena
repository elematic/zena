import { StringBuilder } from 'zena:core';
import { Program } from '../program.zena';
import { CodeGenerator } from './code-generator.zena';
import { ModuleGenerator } from './module-generator.zena';
import { TemplateFamilies } from './ir/template.zena';
import { TypeInterner } from '../types.zena';
import { WatEmitter } from './wat-emitter.zena';
import { defaultImportedStringConstants } from '../targets.zena';

export class WatGenerator implements CodeGenerator<String> {
  var sb: StringBuilder = new StringBuilder();
  target: String;
  zirStats: boolean;

  backendName(): String { return 'wat'; }

  /**
   * Emit the wide-arithmetic proposal's instructions (`i64.mul_wide_u`
   * and friends) instead of the 32-bit-halves sequences that mean the
   * same thing. Off by default: wasmtime, wasmi, JavaScriptCore and
   * SpiderMonkey implement the proposal, V8 does not yet, and the
   * stdlib has to run under `node`. ZENA_WIDE_ARITHMETIC=1 turns it on.
   */
  var wideArithmetic: boolean = false;

  /** `WasmModule.importedStringConstants`. */
  var importedStringConstants = defaultImportedStringConstants;

  /** `ModuleGenerator.compactImports`. */
  var compactImports = false;

  /** `ModuleGenerator.templates`. */
  var templates = true;

  /** `ModuleGenerator.templateCheck`. */
  var templateCheck = false;

  /** `ModuleGenerator.templateFamilies` after the last `generate`. */
  var templateFamilies: TemplateFamilies | null = null;

  /** The checker's interned types, passed on to the module; see `WasmModule.interner`. */
  var interner: TypeInterner | null = null;

  /** Optimization level, forwarded to ModuleGenerator. */
  optLevel: i32;

  new(this.target = "freestanding", this.zirStats = false, this.optLevel = 1);

  generate(program: Program): String {
    this.sb = new StringBuilder();
    let emitter = new WatEmitter(this.sb);
    let generator = new ModuleGenerator(program, emitter, this.target, this.zirStats,
        this.optLevel);
    generator.wideArithmetic = this.wideArithmetic;
    generator.importedStringConstants = this.importedStringConstants;
    generator.compactImports = this.compactImports;
    generator.templates = this.templates;
    generator.templateCheck = this.templateCheck;
    generator.interner = this.interner;
    generator.compile();
    this.templateFamilies = generator.templateFamilies;
    return this.sb.toString();
  }
}
