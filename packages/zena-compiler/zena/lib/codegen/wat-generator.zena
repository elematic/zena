import { 
  Node, Module, VariableDeclaration, FunctionExpression, IdentifierPattern, 
  NumberLiteral, BooleanLiteral, StringLiteral, BlockStatement, ReturnStatement, 
  ExpressionStatement, Statement, Expression 
} from '../ast.zena';
import { SemanticModel } from '../semantic-model.zena';
import { Array } from 'zena:array';
import { CodeGenerator } from './code-generator.zena';
import { Program } from '../program.zena';
import { StringBuilder } from 'zena:string-builder';

export class WatGenerator implements CodeGenerator<String> {
  var sb: StringBuilder = new StringBuilder();
  var model: SemanticModel | null = null;
  
  backendName(): String { return 'wat'; }
  
  new();

  generate(program: Program): String {
    this.sb = new StringBuilder();
    this.model = program.model;
    
    this.sb.append('(module\n');
    
    let varDecl = program.entryPoint;
    if (varDecl != null) {
      let initNode = varDecl.init;
      if (initNode is FunctionExpression) {
         this.sb.append('  (func $main (result i32)\n');
         
         let body = initNode.body;
         if (body is BlockStatement) {
           let block = body as BlockStatement;
           for (let stmt in block.body) {
             this.processStatement(stmt);
           }
         } else if (body is Expression) {
           this.processExpression(body as Expression);
           // implicit return for arrow functions with expression body
           this.sb.append('    return\n');
         }
         
         this.sb.append('  )\n');
         this.sb.append('  (export "main" (func $main))\n');
      }
    }
    
    this.sb.append(')\n');
    return this.sb.toString();
  }

  processStatement(stmt: Statement): void {
    match (stmt) {
      case ReturnStatement {argument}: {
        if (argument != null) {
          this.processExpression(argument);
        }
        this.sb.append('    return\n');
      }
      case ExpressionStatement {expression}: {
        this.processExpression(expression);
        // drop if not used? depends on type
        // this.sb.append('    drop\n');
      }
      case BlockStatement {body}: {
        for (let s in body) {
          this.processStatement(s);
        }
      }
      case _: {
        // TODO
      }
    }
  }

  processExpression(expr: Expression): void {
    match (expr) {
      case NumberLiteral {raw}: {
        this.sb.append('    (i32.const ').append(raw).append(')\n');
      }
      case BooleanLiteral {value}: {
        let valStr = if (value) '1' else '0';
        this.sb.append('    (i32.const ').append(valStr).append(')\n');
      }
      case StringLiteral {value}: {
        this.sb.append('    ;; string literals unimplemented\n');
        this.sb.append('    (i32.const 0)\n');
      }
      case _: {
        // TODO: handle other expressions
      }
    }
  }
}
