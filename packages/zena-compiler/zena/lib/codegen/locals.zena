import { ValTypeI32 } from './wasm.zena';
import { typeToValType } from './wasm-module.zena';
import { 
  Node, VariableDeclaration, FunctionExpression, IdentifierPattern,
  Identifier, NumberLiteral, BooleanLiteral, StringLiteral, BlockStatement,
  ReturnStatement, ExpressionStatement, Statement, Expression, CallExpression,
  ImportSpecifier, BinaryExpression, UnaryExpression, AssignmentExpression,
  IfStatement, IfExpression, WhileStatement, ForStatement, BreakStatement,
  ContinueStatement, RecordLiteral, ArrayLiteral, TupleLiteral, MemberExpression,
  AsExpression, IsExpression, PipelineExpression, IndexExpression, PropertyAssignment,
  AsPattern, ClassPattern, RecordPattern, TuplePattern, LogicalPattern, BindingPattern,
  NullLiteral, MatchExpression, MatchCase, BindingProperty
} from '../ast.zena';
import { Type, F64Type, F32Type, FunctionType } from '../types.zena';
import { SymbolId, Symbol } from '../scope/symbol.zena';
import { ValType } from './wasm.zena';
import { typeToValType } from './wasm-module.zena';
import { Array } from 'zena:array';
import { FunctionContext } from './function-context.zena';

export let discoverLocalsFromExpr = (ctx: FunctionContext, expr: Expression, discExpr: (e: Expression) => void, discStmt: (s: Statement) => void): void => {
  match (expr) {
    case IfExpression {consequent, alternate}: {
      if (consequent is BlockStatement) {
        discStmt(consequent as BlockStatement);
      } else if (consequent is Expression) {
        discExpr(consequent as Expression);
      }
      if (alternate != null) {
        if (alternate is BlockStatement) {
          discStmt(alternate as BlockStatement);
        } else if (alternate is Expression) {
          discExpr(alternate as Expression);
        }
      }
    }
    case AssignmentExpression {value}: {
      discExpr(value);
    }
    case BinaryExpression {left, right}: {
      discExpr(left);
      discExpr(right);
    }
    case CallExpression {callee, args}: {
      let calleeType = ctx.wasmFunction.model.getNodeType(callee);
      match (calleeType) {
        case FunctionType as ft: {
          if (ft.parameterSymbols != null) {
            let symbols = ft.parameterSymbols as Array<SymbolId>;
            var i = 0;
            while (i < symbols.length && i < ft.parameters.length) {
              let symId = symbols[i];
              if (symId != (-1 as SymbolId) && !ctx.localIndices.has(symId)) {
                let paramType = ft.parameters[i];
                var vType = typeToValType(ctx.wasm, paramType);
                let index = ctx.wasmFunction.signature.params.length + ctx.localTypes.length;
                ctx.localIndices[symId] = index;
                ctx.localTypes.push(vType);
              }
              i += 1;
            }
          }
        }
        case _: {}
      }
      for (let arg in args) {
        discExpr(arg);
      }
    }
    case MemberExpression {object}: {
      discExpr(object);
    }
    case AsExpression {expression}: {
      discExpr(expression);
    }
    case IsExpression {expression}: {
      discExpr(expression);
    }
    case PipelineExpression {left, right}: {
      discExpr(left);
      discExpr(right);
    }
    case IndexExpression {object, index}: {
      discExpr(object);
      discExpr(index);
    }
    case RecordLiteral {properties}: {
      for (let prop in properties) {
        if (prop is PropertyAssignment) {
          discExpr((prop as PropertyAssignment).value);
        }
      }
    }
    case ArrayLiteral {elements}: {
      for (let el in elements) {
        discExpr(el);
      }
    }
    case TupleLiteral {elements}: {
      for (let el in elements) {
        discExpr(el);
      }
    }
    case MatchExpression as me: {
      discExpr(me.discriminant);
      for (let mc in me.cases) {
        discoverLocalsFromPattern(ctx, mc.pattern);
        if (mc.guard != null) {
          discExpr(mc.guard as Expression);
        }
        if (mc.body is BlockStatement) {
          discStmt(mc.body as BlockStatement);
        } else if (mc.body is Expression) {
          discExpr(mc.body as Expression);
        }
      }
    }
    case _: {}
  }
};

export let discoverLocalsFromStmt = (ctx: FunctionContext, stmt: Statement, discExpr: (e: Expression) => void, discStmt: (s: Statement) => void): void => {
  match (stmt) {
    case ReturnStatement {argument}: {
      if (argument != null) {
        discExpr(argument as Expression);
      }
    }
    case BlockStatement {body}: {
      for (let s in body) {
        discStmt(s);
      }
    }
    case IfStatement {consequent, alternate}: {
      discStmt(consequent);
      if (alternate != null) {
        discStmt(alternate as Statement);
      }
    }
    case WhileStatement {test, body}: {
      discExpr(test as Expression);
      discStmt(body);
    }
    case ForStatement {init, test, update, body}: {
      if (init != null) {
        if (init is Statement) {
          discStmt(init as Statement);
        } else if (init is Expression) {
          discExpr(init as Expression);
        }
      }
      if (test != null) {
        discExpr(test as Expression);
      }
      if (update != null) {
        discExpr(update as Expression);
      }
      discStmt(body);
    }
    case ExpressionStatement {expression}: {
      discExpr(expression);
    }
    case VariableDeclaration: {
      let decl = stmt as VariableDeclaration;
      if (decl.init != null) {
        discExpr(decl.init as Expression);
      }
      if (decl.pattern is IdentifierPattern) {
        let ident = decl.pattern as IdentifierPattern;
        let sym = ctx.wasmFunction.model.resolveDeclaration(ident);
        if (sym != null) {
          let varType = ctx.wasmFunction.model.getNodeType(ident);
          var vType: ValType = new ValTypeI32();
          if (varType != null) {
            vType = typeToValType(ctx.wasm, varType);
          }
          let index = ctx.wasmFunction.signature.params.length + ctx.localTypes.length;
          ctx.localIndices[sym.id] = index;
          ctx.localTypes.push(vType);
        }
      }
    }
    case _: {}
  }
};

export let discoverLocalsFromPattern = (ctx: FunctionContext, pattern: Node): void => {
  match (pattern) {
    case IdentifierPattern as pat: {
      if (pat.name != "_") {
        let sym = ctx.wasmFunction.model.resolveDeclaration(pat);
        if (sym != null && !ctx.localIndices.has(sym.id)) {
          let varType = ctx.wasmFunction.model.getNodeType(pat);
          var vType: ValType = new ValTypeI32();
          if (varType != null) {
            vType = typeToValType(ctx.wasm, varType);
          }
          let index = ctx.wasmFunction.signature.params.length + ctx.localTypes.length;
          ctx.localIndices[sym.id] = index;
          ctx.localTypes.push(vType);
        }
      }
    }
    case AsPattern as ap: {
      let sym = ctx.wasmFunction.model.resolveDeclaration(ap.name);
      if (sym != null && !ctx.localIndices.has(sym.id)) {
        let varType = ctx.wasmFunction.model.getNodeType(ap.name);
        var vType: ValType = new ValTypeI32();
        if (varType != null) {
          vType = typeToValType(ctx.wasm, varType);
        }
        let index = ctx.wasmFunction.signature.params.length + ctx.localTypes.length;
        ctx.localIndices[sym.id] = index;
        ctx.localTypes.push(vType);
      }
      discoverLocalsFromPattern(ctx, ap.pattern);
    }
    case ClassPattern as cp: {
      for (let prop in cp.properties) {
        discoverLocalsFromPattern(ctx, prop.value);
      }
    }
    case RecordPattern as rp: {
      for (let prop in rp.properties) {
        discoverLocalsFromPattern(ctx, prop.value);
      }
    }
    case TuplePattern as tp: {
      for (let el in tp.elements) {
        if (el != null) {
          discoverLocalsFromPattern(ctx, el as Node);
        }
      }
    }
    case LogicalPattern as lp: {
      discoverLocalsFromPattern(ctx, lp.left);
      discoverLocalsFromPattern(ctx, lp.right);
    }
    case BindingPattern as bp: {
      discoverLocalsFromPattern(ctx, bp.pattern);
    }
    case _: {}
  }
};
