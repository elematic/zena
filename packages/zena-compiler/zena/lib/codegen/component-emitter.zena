// Component emission.
//
// Wraps an emitted core module in a WebAssembly component: the component
// contributes types, instantiation, and the canonical `lift`/`lower`
// adapters that convert between component-level values and core-level
// ones, while every instruction still lives in the core module nested
// inside it.
//
// This is the whole of the `component` target's output side. It is
// deliberately a *wrapper* rather than a second backend: nothing here
// touches ZIR, lowering, or the type system, and the core module it
// embeds is byte-for-byte the one the other targets emit.
//
// The types that cross are the flat scalars — `u8`-`u64`, `s8`-`s64`,
// `f32`, `f64`, `bool` — plus `string` on exports. The scalars need no
// memory, no `realloc` and no type encoding beyond primitives; a string
// needs the first two, and takes them from the program module's own
// exports, which is what keeps this file to one core module and no
// shim. A string on an *import* is the case that cannot: its lowering
// has to exist before the module is instantiated, so its memory has to
// come from a second core module. That, and lists and records, arrive
// with the WIT type encoder; see docs/design/component-emission.md,
// Parts 1.3, 4 and 6.
//
// The binary format is the Component Model's `Binary.md`. Section ids
// differ from core wasm's and are listed in `ComponentSectionId` below.

import { ByteBuffer } from 'zena:byte-buffer';
import { Array } from 'zena:array';
import { Error } from 'zena:error';
import { String } from 'zena:string';
import { i32ToString } from 'zena:string-convert';

/**
 * Component section ids. A component's sections are a different space
 * from a core module's: `1` is a nested core module, not a type section.
 */
export enum ComponentSectionId {
  CoreModule = 1,
  CoreInstance = 2,
  CoreType = 3,
  Component = 4,
  Instance = 5,
  Alias = 6,
  Type = 7,
  Canon = 8,
  Start = 9,
  Import = 10,
  Export = 11,
  Value = 12
}

/**
 * Component-level primitive value types. These are the `primvaltype`
 * encodings, and they are what a flat-scalar import or export is made
 * of. `void` is not among them: a function with no result encodes the
 * absence rather than a type.
 */
export enum ComponentValType {
  Bool = 0x7f,
  S8 = 0x7e,
  U8 = 0x7d,
  S16 = 0x7c,
  U16 = 0x7b,
  S32 = 0x7a,
  U32 = 0x79,
  S64 = 0x78,
  U64 = 0x77,
  F32 = 0x76,
  F64 = 0x75,
  /**
   * The one non-scalar type so far. It is a single byte like the rest,
   * but it is not like the rest: a `string` is bytes in linear memory,
   * so every signature mentioning one drags in the canonical options —
   * a memory to put them in and a `realloc` to place them with.
   */
  String = 0x73
}

/** Whether `t` needs the canonical ABI's memory options to cross. */
export let componentTypeNeedsMemory = (t: i32): boolean =>
    t == (ComponentValType.String as i32);

/** `NO_RESULT` in a signature's `result` field: the function returns nothing. */
export let noComponentResult = -1;

/** A function signature at the component level. */
export final class ComponentFuncType {
  /** Parameter types, as `ComponentValType` opcodes. */
  paramTypes: Array<i32>;
  /** Parameter names, already kebab-case. Same length as `paramTypes`. */
  paramNames: Array<String>;
  /** The result type, or `noComponentResult`. */
  result: i32;
  /**
   * Whether the WIT function is `async`. An async function lowered
   * without `async` blocks; lowered with it, the call returns a subtask
   * handle instead of waiting. The signature is the same either way —
   * see docs/design/component-emission.md 1.6.
   */
  isAsync: boolean;

  new(this.paramTypes, this.paramNames, this.result, this.isAsync = false);
}

/**
 * One function imported from a WIT interface. The core module imports it
 * as `(import "<interfaceName>" "<fieldName>")`, which is what a Zena
 * `@external("wasi:clocks/monotonic-clock@0.3.0", "now")` already
 * compiles to.
 */
export final class ComponentImportFunc {
  interfaceName: String;
  fieldName: String;
  signature: ComponentFuncType;
  /** Whether to lower the call with the `async` canonical option. */
  lowerAsync: boolean;

  new(this.interfaceName, this.fieldName, this.signature, this.lowerAsync = false);
}

/**
 * The core-module import namespace that means "these are canonical
 * builtins, not a WIT interface". A builtin is a function the canonical
 * ABI itself provides — creating a waitable set, dropping a subtask —
 * so it has no interface to be imported from and no type to declare.
 * The core module still imports them like anything else, which is why
 * they need a namespace to be imported *from*.
 */
export let canonNamespace = "canon";

/**
 * The core export names of the async entry and its callback. Internal
 * to the toolchain: the component exports the entry under its own name
 * ("run"), and the callback is not exported at the component level at
 * all — the host reaches it only through the lift's `callback` option.
 */
export let componentEntryExport = "__zena_component_run";
export let componentCallbackExport = "__zena_component_callback";

/**
 * The core exports the canonical options name, when a signature carries
 * anything that lives in linear memory.
 *
 * They are `zena:canonical-abi`'s, exported under the names
 * `wit-component` and `wit-bindgen` use for the same two functions, so
 * a component of ours reads the way every other one does.
 */
export let componentReallocExport = "cabi_realloc";
export let componentPostReturnExport = "cabi_post_return";
/** The core module's memory export, which the emitter aliases back out. */
export let componentMemoryExport = "memory";

/**
 * The standard library module holding the guest side of the canonical
 * ABI. Only the component target links it, so its presence in the
 * program is itself the target check.
 */
export let canonicalAbiModule = "zena:canonical-abi";

/**
 * One canonical builtin the core module imports. `name` is both the
 * builtin's spelling in the Component Model and the core import's field
 * name.
 */
export final class ComponentCanonBuiltin {
  name: String;
  /** Only `task.return` carries one; it is the lifted task's result. */
  result: i32;

  // -1 is `noComponentResult`, spelled out: a default initializer
  // cannot name a module-level binding.
  new(this.name, this.result = -1);
}

/**
 * Whether lifting or lowering `signature` needs the canonical ABI's
 * memory options — true as soon as a `string` is anywhere in it, in
 * either direction. Arguments are written into guest memory before the
 * call and results are read out of it after, and both are the guest
 * allocator's business.
 */
export let componentSignatureNeedsMemory = (
  signature: ComponentFuncType
): boolean => {
  if (componentTypeNeedsMemory(signature.result)) {
    return true;
  }
  for (let p in signature.paramTypes) {
    if (componentTypeNeedsMemory(p)) {
      return true;
    }
  }
  return false;
};

/** One core-module export lifted to a component export. */
export final class ComponentExportFunc {
  /** The core module's export name. */
  coreName: String;
  /** The component's export name, kebab-case. */
  exportName: String;
  signature: ComponentFuncType;
  /**
   * The core export to lift as this function's callback, or the empty
   * string.
   *
   * A callback-lifted export does not run to completion: it returns a
   * code telling the host either that it is done, or which waitable set
   * to wake it on. The host re-enters through the callback when
   * something in that set fires. That is what makes a timer a timer
   * rather than a sleep — the process is not inside the guest while it
   * waits. See docs/design/component-emission.md 1.7.
   */
  callbackCoreName: String;

  new(this.coreName, this.exportName, this.signature,
      this.callbackCoreName = "");

  /** Whether lifting this export needs a memory and a `realloc`. */
  needsMemory(): boolean {
    return componentSignatureNeedsMemory(this.signature);
  }

  /**
   * Whether the host must call `post-return` after reading the result.
   *
   * Only a result needs one: it is allocated by the guest during the
   * call and nothing else can say when the host has finished copying it
   * out. Arguments are the host's own buffers.
   */
  needsPostReturn(): boolean {
    return componentTypeNeedsMemory(this.signature.result);
  }
}

/** The imports and exports a component wraps a core module in. */
export final class ComponentShape {
  imports = new Array<ComponentImportFunc>();
  builtins = new Array<ComponentCanonBuiltin>();
  exports = new Array<ComponentExportFunc>();

  new();
}

// ============================================================================
// Names
// ============================================================================

/**
 * Whether `name` is a valid Component Model kebab-case name: words of
 * `[a-z][a-z0-9]*` joined by single `-`. Import and export names, and
 * parameter names, are all checked by the format itself, so producing an
 * invalid one is a hard error rather than a cosmetic slip.
 */
export let isKebabName = (name: String): boolean => {
  if (name.length == 0) {
    return false;
  }
  var wordStart = true;
  for (var i = 0; i < name.length; i += 1) {
    let c = name.getByteAt(i);
    let isLower = c >= 97 && c <= 122; // a-z
    let isDigit = c >= 48 && c <= 57; // 0-9
    if (c == 45) { // '-'
      if (wordStart) {
        return false; // empty word: leading or doubled '-'
      }
      wordStart = true;
    } else if (wordStart) {
      if (!isLower) {
        return false; // a word must open with a lowercase letter
      }
      wordStart = false;
    } else if (!isLower && !isDigit) {
      return false;
    }
  }
  return !wordStart; // a trailing '-' leaves an empty word
};

/**
 * A Zena identifier as a Component Model name: `camelCase` becomes
 * `camel-case`. Zena identifiers cannot contain `-`, so a conversion is
 * the only way a Zena name can reach the boundary at all.
 *
 * Returns the empty string when the identifier has no valid rendering
 * (it starts with `_` or a digit, say). Callers decide what to do about
 * that; nothing here invents a name.
 */
export let toKebabName = (identifier: String): String => {
  let lowered = identifier.asciiLowerCase();
  var out = "";
  for (var i = 0; i < identifier.length; i += 1) {
    let c = identifier.getByteAt(i);
    if (c >= 65 && c <= 90 && i > 0) { // A-Z, not leading
      out = out + "-";
    }
    out = out + lowered.sliceBytes(i, i + 1);
  }
  if (!isKebabName(out)) {
    return "";
  }
  return out;
};

// ============================================================================
// Encoding
// ============================================================================

let writeName = (buffer: ByteBuffer, name: String): void => {
  buffer.writeULEB128(name.length);
  for (var i = 0; i < name.length; i += 1) {
    buffer.writeByte(name.getByteAt(i));
  }
};

/**
 * An import or export name: a `0x00` discriminant (the name carries no
 * `implements` clause) followed by the name itself.
 */
let writeExternName = (buffer: ByteBuffer, name: String): void => {
  buffer.writeByte(0x00);
  writeName(buffer, name);
};

/**
 * `resultlist`: one unnamed result, or the empty vector of named ones.
 */
let writeResultList = (buffer: ByteBuffer, result: i32): void => {
  if (result == noComponentResult) {
    // The other arm of `resultlist`: a vector of NAMED results, which
    // the format still carries and which is empty here. The count byte
    // is not optional — dropping it reads the next declaration's `0x40`
    // as a result count.
    buffer.writeByte(0x01);
    buffer.writeByte(0x00);
  } else {
    buffer.writeByte(0x00); // one result, unnamed
    buffer.writeByte(result);
  }
};

/**
 * `functype ::= 0x40 ps:vec(<labelvaltype>) rs:<resultlist>`, and `0x43`
 * for the async form — a distinct type, not a flag on the same one.
 */
let writeFuncType = (buffer: ByteBuffer, signature: ComponentFuncType): void => {
  buffer.writeByte(if (signature.isAsync) 0x43 else 0x40);
  buffer.writeULEB128(signature.paramTypes.length);
  for (var i = 0; i < signature.paramTypes.length; i += 1) {
    writeName(buffer, signature.paramNames[i]);
    buffer.writeByte(signature.paramTypes[i]);
  }
  writeResultList(buffer, signature.result);
};

/**
 * The canonical-builtin opcodes this emitter knows. They are the four
 * the async event loop needs: create a set to wait on, put a subtask in
 * it, hand a completed subtask back, and deliver the task's result.
 * Everything else in the builtin space belongs to resources, streams
 * and futures, which are C5 and C6.
 */
let canonBuiltinOpcode = (name: String): i32 => {
  if (name == "waitable-set.new") { return 0x1f; }
  if (name == "waitable-set.drop") { return 0x22; }
  if (name == "waitable.join") { return 0x23; }
  if (name == "subtask.drop") { return 0x0d; }
  if (name == "task.return") { return 0x09; }
  return -1;
};

/** Whether `name` is a canonical builtin this emitter can encode. */
export let isKnownCanonBuiltin = (name: String): boolean =>
    canonBuiltinOpcode(name) >= 0;

/** One imported WIT interface and the functions the program calls on it. */
final class ImportedInterface {
  name: String;
  funcs = new Array<ComponentImportFunc>();
  new(this.name);
}

/**
 * Group imports by interface, preserving first-appearance order. The
 * order is the emitted index order, so it must not depend on hash
 * iteration — a module's bytes are a function of its source, not of the
 * uid counter (see `resetWasmTypeUids`).
 */
let groupByInterface = (
  imports: Array<ComponentImportFunc>
): Array<ImportedInterface> => {
  let groups = new Array<ImportedInterface>();
  for (let imp in imports) {
    var found: ImportedInterface | null = null;
    for (let g in groups) {
      if (g.name == imp.interfaceName) {
        found = g;
      }
    }
    if (found == null) {
      let group = new ImportedInterface(imp.interfaceName);
      group.funcs.push(imp);
      groups.push(group);
    } else {
      (found as ImportedInterface).funcs.push(imp);
    }
  }
  return groups;
};

let writeSection = (out: ByteBuffer, id: i32, payload: ByteBuffer): void => {
  if (payload.length == 0) {
    return;
  }
  out.writeByte(id);
  out.writeULEB128(payload.length);
  out.writeBuffer(payload);
};

/**
 * Emit a component wrapping `coreModule`.
 *
 * The section order below is the order a validator reads them in, and
 * each one's indices refer only to what came before:
 *
 *   type          one instance type per imported interface
 *   import        one per interface, referencing its type
 *   alias         one per imported function, out of its instance
 *   canon         `canon lower` per imported function
 *   core instance one synthesized instance per interface, holding the
 *                 lowered core functions under their field names
 *   core module   the Zena module, embedded verbatim
 *   core instance instantiate it against those
 *   alias         pull each lifted export back out of the instance
 *   type          one functype per export
 *   canon         `canon lift` per export
 *   export        the component's exports
 */
export let emitComponent = (
  coreModule: ByteBuffer,
  shape: ComponentShape
): ByteBuffer => {
  let out = new ByteBuffer();
  // Magic, then version 0x000d and layer 0x0001 — the layer is what
  // distinguishes a component from a core module.
  out.writeU32(0x6D736100);
  out.writeU32(0x0001000D);

  let groups = groupByInterface(shape.imports);

  // --- type: one instance type per imported interface ---------------------
  if (groups.length > 0) {
    let types = new ByteBuffer();
    types.writeULEB128(groups.length);
    for (let group in groups) {
      types.writeByte(0x42); // instance type
      // Two declarations per function: its type, then its export.
      types.writeULEB128(group.funcs.length * 2);
      for (var i = 0; i < group.funcs.length; i += 1) {
        types.writeByte(0x01); // instancedecl: type
        writeFuncType(types, group.funcs[i].signature);
        types.writeByte(0x04); // instancedecl: export
        writeExternName(types, group.funcs[i].fieldName);
        types.writeByte(0x01); // externdesc: func
        // Index within the instance type's own type space: the i-th
        // function's type is the i-th type declared here.
        types.writeULEB128(i);
      }
    }
    writeSection(out, ComponentSectionId.Type as i32, types);

    // --- import: one instance per interface -------------------------------
    let imports = new ByteBuffer();
    imports.writeULEB128(groups.length);
    for (var i = 0; i < groups.length; i += 1) {
      writeExternName(imports, groups[i].name);
      imports.writeByte(0x05); // externdesc: instance
      imports.writeULEB128(i); // the instance type declared above
    }
    writeSection(out, ComponentSectionId.Import as i32, imports);

    // --- alias: each imported function out of its instance ----------------
    let aliases = new ByteBuffer();
    var aliasCount = 0;
    for (let group in groups) {
      aliasCount += group.funcs.length;
    }
    aliases.writeULEB128(aliasCount);
    for (var i = 0; i < groups.length; i += 1) {
      for (let f in groups[i].funcs) {
        aliases.writeByte(0x01); // sort: func
        aliases.writeByte(0x00); // target: instance export
        aliases.writeULEB128(i);
        writeName(aliases, f.fieldName);
      }
    }
    writeSection(out, ComponentSectionId.Alias as i32, aliases);

    // --- canon: lower each imported function ------------------------------
    let lowers = new ByteBuffer();
    lowers.writeULEB128(aliasCount);
    var funcIndex = 0;
    for (let group in groups) {
      for (let f in group.funcs) {
        lowers.writeByte(0x01); // canon lower
        lowers.writeByte(0x00);
        lowers.writeULEB128(funcIndex);
        if (f.lowerAsync) {
          lowers.writeULEB128(1); // one canonical option
          lowers.writeByte(0x06); // async
        } else {
          lowers.writeULEB128(0);
        }
        funcIndex += 1;
      }
    }
    writeSection(out, ComponentSectionId.Canon as i32, lowers);
  }

  // --- canon: the canonical builtins ---------------------------------------
  // Not WIT functions: they have no interface, no import and no declared
  // type, only an opcode. `task.return` is the one that carries
  // anything, and what it carries is the lifted task's own result.
  if (shape.builtins.length > 0) {
    let builtins = new ByteBuffer();
    builtins.writeULEB128(shape.builtins.length);
    for (let b in shape.builtins) {
      let opcode = canonBuiltinOpcode(b.name);
      if (opcode < 0) {
        throw new Error("Unknown canonical builtin '" + b.name + "'");
      }
      builtins.writeByte(opcode);
      if (b.name == "task.return") {
        writeResultList(builtins, b.result);
        builtins.writeULEB128(0); // no canonical options
      }
    }
    writeSection(out, ComponentSectionId.Canon as i32, builtins);
  }

  // --- core instance: one per interface, plus one for the builtins --------
  // The module imports each of these under the namespace it named in
  // `@external`, so the instance an argument is bound to is chosen by
  // that name rather than by position.
  if (groups.length > 0 || shape.builtins.length > 0) {
    let coreInstances = new ByteBuffer();
    coreInstances.writeULEB128(
        groups.length + (if (shape.builtins.length > 0) 1 else 0));
    var loweredIndex = 0;
    for (let group in groups) {
      coreInstances.writeByte(0x01); // from inline exports
      coreInstances.writeULEB128(group.funcs.length);
      for (let f in group.funcs) {
        writeName(coreInstances, f.fieldName);
        coreInstances.writeByte(0x00); // core sort: func
        coreInstances.writeULEB128(loweredIndex);
        loweredIndex += 1;
      }
    }
    if (shape.builtins.length > 0) {
      coreInstances.writeByte(0x01);
      coreInstances.writeULEB128(shape.builtins.length);
      for (let b in shape.builtins) {
        writeName(coreInstances, b.name);
        coreInstances.writeByte(0x00); // core sort: func
        coreInstances.writeULEB128(loweredIndex);
        loweredIndex += 1;
      }
    }
    writeSection(out, ComponentSectionId.CoreInstance as i32, coreInstances);
  }

  // --- core module: the Zena module, verbatim -----------------------------
  writeSection(out, ComponentSectionId.CoreModule as i32, coreModule);

  // --- core instance: instantiate it against the synthesized instances ----
  let instantiate = new ByteBuffer();
  instantiate.writeULEB128(1);
  instantiate.writeByte(0x00); // instantiate
  instantiate.writeULEB128(0); // module index 0
  instantiate.writeULEB128(
      groups.length + (if (shape.builtins.length > 0) 1 else 0));
  for (var i = 0; i < groups.length; i += 1) {
    // The argument name is the core module's import module name, which
    // is the interface string itself.
    writeName(instantiate, groups[i].name);
    instantiate.writeByte(0x12); // core sort: instance
    instantiate.writeULEB128(i);
  }
  if (shape.builtins.length > 0) {
    writeName(instantiate, canonNamespace);
    instantiate.writeByte(0x12);
    instantiate.writeULEB128(groups.length);
  }
  writeSection(out, ComponentSectionId.CoreInstance as i32, instantiate);

  if (shape.exports.length == 0) {
    return out;
  }

  // The instantiated module is the last core instance: one per imported
  // interface, then the builtins', then this one.
  let programInstance = groups.length + (if (shape.builtins.length > 0) 1 else 0);

  // The core function index space: the lowered imports, then the
  // builtins, then everything aliased back out of the program instance.
  var coreFuncIndex = 0;
  for (let group in groups) {
    coreFuncIndex += group.funcs.length;
  }
  coreFuncIndex += shape.builtins.length;
  let firstExportCoreFunc = coreFuncIndex;

  // Every distinct callback, aliased after the exports so a lift can
  // name one. Distinct: several exports may share one callback, and
  // aliasing it twice would be two core functions where one will do.
  let callbackNames = new Array<String>();
  for (let e in shape.exports) {
    if (e.callbackCoreName != "") {
      var seen = false;
      for (let name in callbackNames) {
        if (name == e.callbackCoreName) { seen = true; }
      }
      if (!seen) { callbackNames.push(e.callbackCoreName); }
    }
  }

  let callbackCoreIndex = (name: String): i32 => {
    for (var i = 0; i < callbackNames.length; i += 1) {
      if (callbackNames[i] == name) {
        return firstExportCoreFunc + shape.exports.length + i;
      }
    }
    throw new Error("No alias emitted for callback '" + name + "'");
  };

  // A `string` anywhere in a signature means the canonical options: the
  // memory the bytes live in, and the allocator that placed them. Both
  // come out of the program module's own exports, which is why one core
  // module is still the whole component — lifting happens after
  // instantiation, so nothing has to exist before the module does. An
  // *import* carrying a string is the case that cannot do this, because
  // its lowering has to exist before the module is instantiated; see
  // docs/design/component-emission.md 1.3.
  var needsMemory = false;
  var needsPostReturn = false;
  for (let e in shape.exports) {
    if (e.needsMemory()) { needsMemory = true; }
    if (e.needsPostReturn()) { needsPostReturn = true; }
  }
  let reallocCoreFunc = firstExportCoreFunc + shape.exports.length +
      callbackNames.length;
  let postReturnCoreFunc = reallocCoreFunc + 1;

  // --- alias: pull each exported core function out of the instance --------
  let exportAliases = new ByteBuffer();
  var aliasTotal = shape.exports.length + callbackNames.length;
  if (needsMemory) {
    aliasTotal += 2; // realloc, then the memory itself
  }
  if (needsPostReturn) {
    aliasTotal += 1;
  }
  exportAliases.writeULEB128(aliasTotal);
  for (let e in shape.exports) {
    exportAliases.writeByte(0x00); // sort: core
    exportAliases.writeByte(0x00); // core sort: func
    exportAliases.writeByte(0x01); // target: core instance export
    exportAliases.writeULEB128(programInstance);
    writeName(exportAliases, e.coreName);
  }
  for (let name in callbackNames) {
    exportAliases.writeByte(0x00);
    exportAliases.writeByte(0x00);
    exportAliases.writeByte(0x01);
    exportAliases.writeULEB128(programInstance);
    writeName(exportAliases, name);
  }
  if (needsMemory) {
    // The core function index space continues past the callbacks, so
    // realloc and post-return are aliased in that order to match
    // `reallocCoreFunc` above.
    exportAliases.writeByte(0x00);
    exportAliases.writeByte(0x00);
    exportAliases.writeByte(0x01);
    exportAliases.writeULEB128(programInstance);
    writeName(exportAliases, componentReallocExport);
    if (needsPostReturn) {
      exportAliases.writeByte(0x00);
      exportAliases.writeByte(0x00);
      exportAliases.writeByte(0x01);
      exportAliases.writeULEB128(programInstance);
      writeName(exportAliases, componentPostReturnExport);
    }
    // Core memories have an index space of their own, so this is memory
    // 0 whatever the functions did.
    exportAliases.writeByte(0x00);
    exportAliases.writeByte(0x02); // core sort: memory
    exportAliases.writeByte(0x01);
    exportAliases.writeULEB128(programInstance);
    writeName(exportAliases, componentMemoryExport);
  }
  writeSection(out, ComponentSectionId.Alias as i32, exportAliases);

  // --- type: one functype per export --------------------------------------
  let exportTypes = new ByteBuffer();
  exportTypes.writeULEB128(shape.exports.length);
  for (let e in shape.exports) {
    writeFuncType(exportTypes, e.signature);
  }
  writeSection(out, ComponentSectionId.Type as i32, exportTypes);

  // --- canon: lift each export --------------------------------------------
  // The component-level type index continues after the instance types.
  let firstExportType = groups.length;
  let lifts = new ByteBuffer();
  lifts.writeULEB128(shape.exports.length);
  for (var i = 0; i < shape.exports.length; i += 1) {
    let e = shape.exports[i];
    lifts.writeByte(0x00); // canon lift
    lifts.writeByte(0x00);
    lifts.writeULEB128(firstExportCoreFunc + i);
    var optionCount = 0;
    if (e.callbackCoreName != "") {
      optionCount += 2; // async, and the callback to re-enter through
    }
    if (e.needsMemory()) {
      optionCount += 2; // the memory, and the realloc that fills it
    }
    if (e.needsPostReturn()) {
      optionCount += 1;
    }
    lifts.writeULEB128(optionCount);
    if (e.callbackCoreName != "") {
      // The callback form takes both options together: the lifted
      // function is async, and this is what the host re-enters through.
      lifts.writeByte(0x06); // async
      lifts.writeByte(0x07); // callback
      lifts.writeULEB128(callbackCoreIndex(e.callbackCoreName));
    }
    if (e.needsMemory()) {
      lifts.writeByte(0x03); // memory
      lifts.writeULEB128(0); // the one aliased above
      lifts.writeByte(0x04); // realloc
      lifts.writeULEB128(reallocCoreFunc);
    }
    if (e.needsPostReturn()) {
      lifts.writeByte(0x05); // post-return
      lifts.writeULEB128(postReturnCoreFunc);
    }
    lifts.writeULEB128(firstExportType + i);
  }
  writeSection(out, ComponentSectionId.Canon as i32, lifts);

  // --- export --------------------------------------------------------------
  // Component function indices: the aliased imports come first, then the
  // lifted exports.
  var firstExportFunc = 0;
  for (let group in groups) {
    firstExportFunc += group.funcs.length;
  }
  let exports = new ByteBuffer();
  exports.writeULEB128(shape.exports.length);
  for (var i = 0; i < shape.exports.length; i += 1) {
    writeExternName(exports, shape.exports[i].exportName);
    exports.writeByte(0x01); // sort: func
    exports.writeULEB128(firstExportFunc + i);
    exports.writeByte(0x00); // no ascribed type
  }
  writeSection(out, ComponentSectionId.Export as i32, exports);

  return out;
};
