import { collectValueExports } from './lookup.zena';
import { ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeV128, ValTypeRefNull, ValTypeStructRef, ValTypeRef } from './wasm.zena';
import { simdInstruction } from '../simd.zena';
import {
  WasmModule, WasmFunction, WasmSignature, WasmExport, WasmGlobal, WasmStruct, VTableInit, WasmArray, StringLiteralLocation,
} from './wasm-module.zena';
import { ByteBuffer } from 'zena:byte-buffer';
import { ReachabilityAnalysis } from './reachability/analysis.zena';
import { prepareGenerators } from './ir/generators.zena';
import { prepareAsyncFunctions } from './ir/async.zena';
import { prepareComponentEntry, prepareComponentExports } from './ir/component-adapters.zena';
import {
  getClassKey, sortStringsByLengthDescending, parseI64OrU64Literal,
} from './codegen-utils.zena';
import { ClassType } from '../types.zena';
import { Program } from '../program.zena';
import {
  NumberLiteral, StringLiteral, BooleanLiteral, EnumDeclaration, ImportDeclaration, Module,
} from '../ast.zena';
import { Symbol } from '../scope/symbol.zena';
import { String } from 'zena:string';
import { ValType, resetWasmTypeUids } from './wasm.zena';
import { WasmEmitter } from './wasm-emitter.zena';
import { performance } from '../time.zena';
import { dirName, normalizePath } from '../module-resolver.zena';
import { lowerFunction } from './ir/lowering.zena';
import { verifyIr } from './ir/verifier.zena';
import { runGvn } from './ir/gvn.zena';
import { IrCfg } from './ir/cfg.zena';
import { emitZirFunction } from './ir/emit.zena';
import {
  ComponentShape, ImportTypeEncoder, componentEntryExport,
  componentCallbackExport, componentReallocExport,
  componentPostReturnExport, componentMemoryExport,
  componentRuntimeNamespace
} from './component-emitter.zena';
import { buildComponentShape } from './component-shape.zena';
import { targetEmitsComponent } from '../targets.zena';

export final class ModuleGenerator {
  program: Program;
  emitter: WasmEmitter;
  target: String;
  /** ZENA_ZIR_STATS=1: report the per-module lowered-function count. */
  zirStats: boolean;
  /**
   * What a component would wrap this module in — its WIT imports and
   * lifted exports — collected on a target that emits one, and null
   * otherwise. `BinaryGenerator` reads it after `compile()`; it is
   * derived from the same `WasmModule` the module was emitted from, so
   * the two cannot disagree about what exists.
   */
  var componentShape: ComponentShape | null = null;
  /**
   * The WIT import encoder, injected by the driver on the component
   * target (`wit-imports.zena` builds it). Null elsewhere — and in
   * hosts like the language service that never emit a component and
   * deliberately do not link the WIT parser.
   */
  var importEncoder: ImportTypeEncoder | null = null;

  new(this.program, this.emitter, this.target = "zena-cli", this.zirStats = false);

  emitDefaultValue(type: ValType): void {
    if (type is ValTypeI32) {
      this.emitter.emitI32Const(0);
    } else if (type is ValTypeI64) {
      this.emitter.emitI64Const(0 as i64);
    } else if (type is ValTypeF64) {
      this.emitter.emitF64Const(0.0);
    } else if (type is ValTypeF32) {
      this.emitter.emitF32Const(0.0);
    } else if (type is ValTypeV128) {
      this.emitZeroV128();
    } else {
      match (type) {
        case ValTypeRefNull as refNullType: {
          this.emitter.emitRefNull(refNullType.target.index);
        }
        case ValTypeRef as refType: {
          this.emitter.emitRefNull(refType.target.index);
        }
        case ValTypeStructRef: {
          this.emitter.emitRefNull(-21);
        }
        case _: {
          this.emitter.emitRefNull(-19); // fallback to eqref
        }
      }
    }
  }

  /**
   * An all-zero vector, the only constant expression a `v128` global or
   * field can be initialized with — there is no `v128` equivalent of
   * `i32.const`, only the 16-byte `v128.const`.
   */
  emitZeroV128(): void {
    let zeros = new GrowableArray<i32>();
    var i = 0;
    while (i < 16) {
      zeros.push(0);
      i += 1;
    }
    let instr = simdInstruction('v128.const');
    if (instr == null) {
      throw new Error('v128.const is missing from the SIMD table');
    }
    this.emitter.emitSimdBytes(instr.opcode, zeros);
  }

  
  compile(): void {
    // Uids are hashCode for WasmType and WasmFunction, so they order
    // every hash container keyed by one, and that order reaches the
    // emitted bytes. Restart the sequence per module so a module is
    // emitted the same whether or not others were compiled first.
    resetWasmTypeUids();

    let wasm = new WasmModule();
    wasm.program = this.program;


    let tDiscovery = performance.start("codegen-discovery");
    let pass = new ReachabilityAnalysis(this.program, wasm, this.target);
    pass.run();
    performance.end(tDiscovery);



    // Pre-discover all string literals inside reached function bodies so that they are registered in wasm.datas BEFORE layouts and sections are emitted
    for (let u in this.program.units) {
      let moduleNode = u.ast;
      for (let stmt in moduleNode.body) {
        if (stmt is EnumDeclaration) {
          for (let member in stmt.members) {
            let initializer = member.initializer;
            if (initializer is StringLiteral) {
              wasm.registerStringLiteral(initializer.value);
            }
          }
        }
      }
    }


    let tLayout = performance.start("codegen-layout");
    let {stringClass} = wasm;
    if (stringClass != null) {
      if (wasm.stringLiterals.size > 0) {
        wasm.registerStringLiteral(""); // Ensure empty string is in stringLiterals
        let stringKey = getClassKey(stringClass);
        var stringStruct: WasmStruct | null = null;
        if (let (true, stringInfo) = wasm.classInfos.get(stringKey)) {
          stringStruct = stringInfo.structType;
        }
        if (stringStruct == null) {
          throw new Error("String class struct not found during module compilation!");
        }
        new ValTypeRefNull(stringStruct);

        // Sort stringLiterals by length descending
        let sortedStrings = new GrowableArray<String>();
        let litKeys = wasm.stringLiterals.keys();
        while (let (true, val) = litKeys.next()) {
          sortedStrings.push(val);
        }
        sortStringsByLengthDescending(sortedStrings);

        // Subsequence optimization: place each literal at the first offset
        // where its bytes already occur in the accumulated segment,
        // appending it only when absent. Scanning the whole segment per
        // literal is quadratic in program size, so index every 4-byte
        // window of the segment and only verify offsets that share the
        // literal's first four bytes; the first verified candidate is the
        // same offset the full scan would have found.
        let accumulatedBytes = new ByteBuffer();
        let windowIndex = new HashMap<i32, GrowableArray<i32>>();
        // Window starts below this offset are indexed; it trails the end of
        // the buffer by up to 3 bytes so windows spanning an append
        // boundary are indexed once the bytes after them exist.
        var indexedUpTo = 0;
        for (var idx = 0; idx < sortedStrings.length; idx += 1) {
          let s = sortedStrings[idx];
          let sLen = s.length;

          var foundOffset = -1;
          if (sLen == 0) {
            foundOffset = 0;
          } else if (sLen < 4) {
            let accumLen = accumulatedBytes.length;
            for (var i = 0; i <= accumLen - sLen; i += 1) {
              var match = true;
              for (var j = 0; j < sLen; j += 1) {
                if (accumulatedBytes.getByte(i + j) != s.getByteAt(j)) {
                  match = false;
                  break;
                }
              }
              if (match) {
                foundOffset = i;
                break;
              }
            }
          } else {
            let key = s.getByteAt(0) | (s.getByteAt(1) << 8) | (s.getByteAt(2) << 16) | (s.getByteAt(3) << 24);
            if (let (true, positions) = windowIndex.get(key)) {
              let accumLen = accumulatedBytes.length;
              for (let pos in positions) {
                if (pos + sLen <= accumLen) {
                  var match = true;
                  for (var j = 4; j < sLen; j += 1) {
                    if (accumulatedBytes.getByte(pos + j) != s.getByteAt(j)) {
                      match = false;
                      break;
                    }
                  }
                  if (match) {
                    foundOffset = pos;
                    break;
                  }
                }
              }
            }
          }

          if (foundOffset != -1) {
            wasm.stringLiteralLocations[s] = new StringLiteralLocation(foundOffset, sLen);
          } else {
            let offset = accumulatedBytes.length;
            for (var i = 0; i < sLen; i += 1) {
              accumulatedBytes.writeByte(s.getByteAt(i));
            }
            let newLen = accumulatedBytes.length;
            while (indexedUpTo + 4 <= newLen) {
              let w = indexedUpTo;
              let wKey = accumulatedBytes.getByte(w) | (accumulatedBytes.getByte(w + 1) << 8) | (accumulatedBytes.getByte(w + 2) << 16) | (accumulatedBytes.getByte(w + 3) << 24);
              if (let (true, list) = windowIndex.get(wKey)) {
                list.push(w);
              } else {
                let list = new GrowableArray<i32>();
                list.push(w);
                windowIndex[wKey] = list;
              }
              indexedUpTo += 1;
            }
            wasm.stringLiteralLocations[s] = new StringLiteralLocation(offset, sLen);
          }
        }

        // Add single concatenated data segment
        let dataIndex = wasm.addData(accumulatedBytes);
        wasm.sharedStringsLength = accumulatedBytes.length;
        wasm.sharedStringsDataIdx = dataIndex;

        // Assign sequential IDs to string literals
        let astLitKeys = wasm.stringLiterals.keys();
        var litIdx = 0;
        while (let (true, val) = astLitKeys.next()) {
          wasm.stringLiteralIds[val] = litIdx;
          litIdx += 1;
        }

        wasm.ensureStringLiteralHelpers(this.program.units[0].model);
        let {stringLiteralsArrayGlobal} = wasm;
        if (stringLiteralsArrayGlobal != null) {
          stringLiteralsArrayGlobal.initArraySize = wasm.stringLiterals.size;
        }
      }
    }
    
    var needsStartFunction = stringClass != null && wasm.stringLiterals.size > 0;
    for (let g in wasm.globals) {
      // A namespace-import object is built in __start (one closure
      // pair per exported function, exported globals by value), but it
      // carries no initExpr to say so. It got a start function for
      // free while some stdlib global always had a non-literal
      // initializer; once a library unit is only walked when something
      // reaches it, that stopped being true and the object stayed
      // null.
      if (g.namespaceImport != null) {
        needsStartFunction = true;
      }
      let {initExpr} = g;
      if (initExpr != null) {
        let isLiteral = match (initExpr) {
          case NumberLiteral: true
          case BooleanLiteral: true
          case _: false
        };
        if (!isLiteral) {
          needsStartFunction = true;
        }
      }
    }
    
    if (needsStartFunction) {
      let startSig = wasm.getSignature(new GrowableArray<ValType>(), new GrowableArray<ValType>());
      let firstModel = this.program.units[0].model;
      let startFunc = new WasmFunction(startSig, null, firstModel);
      startFunc.name = "__start";
      wasm.addFunction(startFunc);
      wasm.startFunction = startFunc;
    }

    // Follows RTA's instantiation verdict, NOT declaration: the
    // helpers' bodies are synthesized against String's struct, and
    // "the struct has fields" is no signal either — layout populates
    // every declared class's struct whether or not a value can exist.
    if (wasm.stringClassIsInstantiated) {
      wasm.ensureStringHelpers(this.program.units[0].model);
    }
    // Pre-discover functions whose references are taken by namespace imports
    for (let g in wasm.globals) {
      let {namespaceImport} = g;
      if (namespaceImport != null) {
        let spec = namespaceImport;
        let moduleModel = g.model;
        let parentNode = moduleModel.getParent(spec);
        if (parentNode is ImportDeclaration) {
          let specifier = parentNode.moduleSpecifier.value;
          var canonicalPath = specifier;
          if (specifier.startsWith("./") || specifier.startsWith("../")) {
            let referrer = moduleModel.getParent(parentNode);
            if (referrer is Module) {
              let dir = dirName(referrer.path);
              canonicalPath = normalizePath(dir + "/" + specifier);
            }
          }
          if (this.program.unitsByPath.has(canonicalPath)) {
            let targetUnit = this.program.unitsByPath[canonicalPath];
            let exports = new HashMap<String, Symbol>();
            collectValueExports(this.program, targetUnit, exports);
            let expKeys = exports.keys();
            while (let (true, k) = expKeys.next()) {
              let sym = exports[k];
              if (wasm.functionMap.has(sym.id)) {
                let f = wasm.functionMap[sym.id];
                f.isReferenceTaken = true;
                if (f.closureTrampoline == null) {
                  let tParams = new GrowableArray<ValType>();
                  tParams.push(new ValTypeStructRef());
                  for (let p in f.signature.params) {
                    tParams.push(p);
                  }
                  let tSig = wasm.getSignature(tParams, f.signature.returns);
                  let trampoline = new WasmFunction(tSig, null, f.model);
                  let fName = if (f.name != null) (f.name as String) else "anonymous";
                  trampoline.name = fName + "$trampoline";
                  trampoline.isClosureTrampoline = true;
                  trampoline.closureTrampolineTarget = f;
                  trampoline.isReferenceTaken = true;
                  f.closureTrampoline = trampoline;
                  wasm.addFunction(trampoline);
                }
              }
            }
          }
        }
      }
    }

    // Generator split pass (ir/generators.zena): presplit-lowers every
    // generator body (which needs the string-literal registry above)
    // and synthesizes everything a generator needs — frame structs,
    // next() functions, Iterator<T> vtable globals. Must run before
    // layout() locks indices.
    let tGenerators = performance.start("codegen-generators");
    prepareGenerators(wasm, pass);
    performance.end(tGenerators);

    // Async split pass (ir/async.zena): the same treatment for every
    // `async` body — frame structs, step() functions, Resumable
    // vtable globals. Also before layout().
    let tAsync = performance.start("codegen-async");
    prepareAsyncFunctions(wasm, pass);
    performance.end(tAsync);

    // The component target's adapters: the async entry, synthesized only
    // where the program links a driver that needs one, and a wrapper per
    // export carrying a string. Before layout(), like the passes above,
    // because they add functions. The entry comes first — it decides
    // whether `main` is still an export to wrap.
    if (targetEmitsComponent(this.target)) {
      prepareComponentEntry(wasm, pass);
      prepareComponentExports(wasm, pass);
    }

    wasm.layout();
    performance.end(tLayout);

    let tEmitOther = performance.start("codegen-emit-other");
    this.emitter.emitModuleStart();
    // Rec groups come from layout()'s SCC pass: one group per
    // strongly-connected component of the type-reference graph, in
    // dependency order. A type-section entry is a GROUP (a singleton
    // emits in the bare, header-free form), so the section count is
    // the group count.
    let recGroupSizes = wasm.typeRecGroupSizes;
    var groupedTypeCount = 0;
    for (let gs in recGroupSizes) {
      groupedTypeCount += gs;
    }
    if (groupedTypeCount != wasm.types.length) {
      throw new Error('rec group sizes cover ' +
          i32ToString(groupedTypeCount) + ' types but the layout has ' +
          i32ToString(wasm.types.length));
    }

    this.emitter.emitTypeSectionStart(recGroupSizes.length);

    let emitTypeAtIndex = (idx: i32): void => {
      let t = wasm.types[idx];
      if (t is WasmSignature) {
        this.emitter.emitFunctionTypeStart(idx);
        
        this.emitter.emitFunctionTypeParamsStart(t.params.length);
        for (let param in t.params) {
          this.emitter.emitFunctionTypeParam(param);
        }
        
        this.emitter.emitFunctionTypeResultsStart(t.returns.length);
        for (let ret in t.returns) {
          this.emitter.emitFunctionTypeResult(ret);
        }
        
        this.emitter.emitFunctionTypeEnd();
      } else if (t is WasmStruct) {
        let superIdx =
          if (t.superStruct != null) (t.superStruct as WasmStruct).index 
          else -1;
        this.emitter.emitStructTypeStart(idx, t.name, superIdx);
        
        this.emitter.emitStructTypeFieldsStart(t.fields.length);
        for (let field in t.fields) {
          this.emitter.emitStructTypeField(field.type, field.isMutable);
        }
        
        this.emitter.emitStructTypeEnd();
      } else if (t is WasmArray) {
        this.emitter.emitArrayType(idx, t.elementType, t.isMutable);
      }
    };

    var nextTypeIdx = 0;
    for (let gs in recGroupSizes) {
      this.emitter.emitRecGroupStart(gs);
      var inGroup = 0;
      while (inGroup < gs) {
        emitTypeAtIndex(nextTypeIdx);
        nextTypeIdx += 1;
        inGroup += 1;
      }
      this.emitter.emitRecGroupEnd();
    }

    this.emitter.emitTypeSectionEnd();

    // On the component target the program does not own its memory: the
    // runtime memory module does, instantiated before this one, so that
    // a lowered import's canonical options have a memory that already
    // exists (docs/design/component-emission.md, 1.3). Everywhere else
    // the module defines its memory as before.
    let memoryImported =
        targetEmitsComponent(this.target) && wasm.hasMemory;

    this.emitter.emitImportSectionStart(
        wasm.functionImports.length + (if (memoryImported) 1 else 0));
    for (let f in wasm.functionImports) {
      let {importModule} = f;
      if (importModule != null && f.importName != null) {
        if (f.signature.index < 0) {
          throw new Error("Function import " + (if (f.name != null) f.name as String else "<unnamed>") + " has unassigned signature index (-1)!");
        }
        this.emitter.emitFunctionImport(importModule, f.importName as String, f.signature.index);
      }
    }
    if (memoryImported) {
      this.emitter.emitMemoryImport(
          componentRuntimeNamespace, componentMemoryExport, 1);
    }
    this.emitter.emitImportSectionEnd();

    this.emitter.emitFunctionSectionStart(wasm.functions.length);
    for (let f in wasm.functions) {
      if (f.signature.index < 0) {
        throw new Error("Function " + (if (f.name != null) f.name as String else "<unnamed>") + " has unassigned signature index (-1)!");
      }
      this.emitter.emitFunctionDefinition(f.signature.index);
    }
    this.emitter.emitFunctionSectionEnd();

    if (wasm.hasMemory && !memoryImported) {
      this.emitter.emitMemorySection(1);
    }

    this.emitter.emitTagSectionStart(wasm.tags.length);
    for (var i = 0; i < wasm.tags.length; i += 1) {
      let tag = wasm.tags[i];
      if (tag.signature.index < 0) {
        throw new Error("Tag has unassigned signature index (-1)!");
      }
      this.emitter.emitTagDefinition(tag.index, tag.signature.index);
    }
    this.emitter.emitTagSectionEnd();

    this.emitter.emitGlobalSectionStart(wasm.globals.length);
    for (let g in wasm.globals) {
      this.emitter.emitGlobal(g.type, g.isMutable);
      
      var emitted = false;
      let {initExpr} = g;
      if (initExpr != null) {
        match (initExpr) {
          case NumberLiteral {raw}: {
             let {type} = g;
             if (type is ValTypeI32 ) {
                if (let (true, val) = parseI32(raw)) {
                  this.emitter.emitI32Const(val);
                } else {
                  this.emitter.emitI32Const(0);
                }
             } else if (type is ValTypeI64 ) {
                if (let (true, val) = parseI64OrU64Literal(raw)) {
                  this.emitter.emitI64Const(val);
                } else {
                  this.emitter.emitI64Const(0 as i64);
                }
             } else if (type is ValTypeF64 ) {
                this.emitter.emitF64Const(parseF64(raw));
             } else if (type is ValTypeF32 ) {
                this.emitter.emitF32Const(parseF64(raw)); // f32 requires casting
             } else {
                this.emitter.emitI32Const(0);
              }
             emitted = true;
          }
          case BooleanLiteral {value}: {
            this.emitter.emitBooleanConst(value);
            emitted = true;
          }
          case _: {}
        }
      } else if (g.initVTable != null) {
        let vtableInit = g.initVTable as VTableInit;
        for (let func in vtableInit.funcs) {
          if (func.index == -1) {
            throw new Error("DIAGNOSTIC VTABLE INIT ERROR: func.name=" + (if (func.name == null) "null" else func.name as String) + " has index -1");
          }
          this.emitter.emitRefFunc(func.index);
        }
        this.emitter.emitStructNew(vtableInit.structType.index);
        emitted = true;
      } else if (g.initSingletonStruct != null) {
        let cType = g.initSingletonStruct as ClassType;
        let cKey = getClassKey(cType);
        var structTypeOpt: WasmStruct | null = null;
        var vtableGlobalOpt: WasmGlobal | null = null;
        if (let (true, info) = wasm.classInfos.get(cKey)) {
          structTypeOpt = info.structType;
          vtableGlobalOpt = info.vtableGlobal;
        }
        if (structTypeOpt == null) {
          throw new Error("Singleton struct not found for class: " + cType.name);
        }
        let structType = structTypeOpt;
        for (let field in structType.fields) {
          let {name} = field;
          if (name != null && name == "<vtable>") {
            if (vtableGlobalOpt == null) {
              throw new Error("Singleton vtable not found for class: " + cType.name);
            }
            this.emitter.emitGlobalGet(vtableGlobalOpt.index);
          } else {
            this.emitDefaultValue(field.type);
          }
        }
        this.emitter.emitStructNew(structType.index);
        emitted = true;
      } else if (g.initArraySize >= 0) {
        this.emitter.emitI32Const(g.initArraySize);
        let targetIndex = match (g.type) {
          case ValTypeRef {target}: target.index
          case ValTypeRefNull {target}: target.index
          case _: throw new Error("Expected ValTypeRef or ValTypeRefNull for array global initialization")
        };
        this.emitter.emitArrayNewDefault(targetIndex);
        emitted = true;
      }
      
      if (!emitted) {
        let {type} = g;
        if (type is ValTypeI32) {
          this.emitter.emitI32Const(0);
        } else if (type is ValTypeI64) {
          this.emitter.emitI64Const(0 as i64);
        } else if (type is ValTypeF64) {
          this.emitter.emitF64Const(0.0);
        } else if (type is ValTypeF32) {
          this.emitter.emitF32Const(0.0);
        } else if (type is ValTypeV128) {
          this.emitZeroV128();
        } else {
          match (type) {
            case ValTypeRefNull as refNullType: {
              this.emitter.emitRefNull(refNullType.target.index);
            }
            case ValTypeStructRef: {
              this.emitter.emitRefNull(-21);
            }
            case _: {
              this.emitter.emitI32Const(0);
            }
          }
        }
      }

      this.emitter.emitGlobalEnd();
    }
    this.emitter.emitGlobalSectionEnd();
    
    let exports = new GrowableArray<WasmExport>();
    let expKeys = wasm.exportMap.keys();
    while (let (true, k) = expKeys.next()) {
      let f = wasm.exportMap[k];
      exports.push(new WasmExport(k as String, f));
    }

    // Export synthesized runtime string helpers if present
    let {stringCreateFunc} = wasm;
    if (stringCreateFunc != null) {
      exports.push(new WasmExport("$stringCreate", stringCreateFunc));
    }
    let {stringSetByteFunc} = wasm;
    if (stringSetByteFunc != null) {
      exports.push(new WasmExport("$stringSetByte", stringSetByteFunc));
    }
    let {stringGetByteFunc} = wasm;
    if (stringGetByteFunc != null) {
      exports.push(new WasmExport("$stringGetByte", stringGetByteFunc));
    }
    let {stringGetLengthFunc} = wasm;
    if (stringGetLengthFunc != null) {
      exports.push(new WasmExport("$stringGetLength", stringGetLengthFunc));
    }

    // __zena_drain — the re-entry point for a host that cannot wait
    // synchronously (async.md §4). On such a host `drainMicrotasks()`
    // unwinds when the only remaining work is a future deadline, and
    // the host pings this to resume once the deadline arrives. Exported
    // whenever zena:async is reached; harmless where nothing calls it.
    let asyncDrain = wasm.getStdlibFunc('zena:async', 'drainMicrotasks');
    if (asyncDrain != null) {
      exports.push(new WasmExport("__zena_drain", asyncDrain));
    }

    // __zena_complete_* — how a host settles a future it was handed a
    // handle for (async.md §4, Level 2). Present exactly when the
    // program imports zena:js, whose exports RTA roots for this
    // reason; absent, and costing nothing, otherwise.
    let completeEntries = [
      ("__zena_complete_void", "completeVoid"),
      ("__zena_complete_i32", "completeI32"),
      ("__zena_complete_f64", "completeF64"),
      ("__zena_complete_string", "completeString"),
      ("__zena_complete_extern", "completeExtern"),
      ("__zena_complete_error", "completeError"),
    ];
    for (let entry in completeEntries) {
      let (exportName, zenaName) = entry;
      let f = wasm.getStdlibFunc('zena:js/index.zena', zenaName);
      if (f != null) {
        exports.push(new WasmExport(exportName, f));
      }
    }
    let {componentEntryFunc} = wasm;
    if (componentEntryFunc != null) {
      exports.push(new WasmExport(componentEntryExport,
          componentEntryFunc));
    }
    let {componentCallbackFunc} = wasm;
    if (componentCallbackFunc != null) {
      exports.push(new WasmExport(componentCallbackExport,
          componentCallbackFunc));
    }
    // The wrappers, and the two functions the canonical options name.
    // They are core-module exports and not component ones: the component
    // aliases them back out to build its lifts, and nothing outside sees
    // them.
    // Walked through `exportMap` rather than over the wrapper map's own
    // keys, so the order is the one the user exports are already in: a
    // hash map's iteration order is stable for a given set of keys, but
    // tying the two together is what makes it obviously so.
    let wrapperKeys = wasm.exportMap.keys();
    while (let (true, wrapperKey) = wrapperKeys.next()) {
      if (let (true, wrapper) = wasm.componentExportWrappers.get(wrapperKey)) {
        let wrapperName = wrapper.name;
        if (wrapperName == null) {
          throw new Error('a component export wrapper has no name');
        }
        exports.push(new WasmExport(wrapperName, wrapper));
      }
    }
    // `cabi_realloc` is not exported when the memory is imported: the
    // canonical options name the runtime memory module's own realloc,
    // which is the allocator this module already delegates to.
    let {componentReallocFunc} = wasm;
    if (componentReallocFunc != null && !memoryImported) {
      exports.push(new WasmExport(componentReallocExport,
          componentReallocFunc));
    }
    let {componentPostReturnFunc} = wasm;
    if (componentPostReturnFunc != null) {
      exports.push(new WasmExport(componentPostReturnExport,
          componentPostReturnFunc));
    }
    let {asyncMainStartFunc} = wasm;
    if (asyncMainStartFunc != null) {
      exports.push(new WasmExport("__zena_main_start", asyncMainStartFunc));
    }
    let {asyncMainResultFunc} = wasm;
    if (asyncMainResultFunc != null) {
      exports.push(new WasmExport("__zena_main_result", asyncMainResultFunc));
    }
    
    // Compute total exports = functions + globals + tags
    var totalExports = exports.length;
    let globalExports = new GrowableArray<WasmGlobal>();
    for (let gName in wasm.exportGlobalMap.keys()) {
      globalExports.push(wasm.exportGlobalMap[gName]);
    }
    totalExports += globalExports.length;
    
    let tagExports = new GrowableArray<String>();
    let tagKeys = wasm.exportTagMap.keys();
    while (let (true, k) = tagKeys.next()) {
      tagExports.push(k);
    }
    totalExports += tagExports.length;

    // An imported memory is the runtime module's to export; re-exporting
    // it here would only offer the component a second name for it.
    if (wasm.hasMemory && !memoryImported) {
      totalExports += 1;
    }

    this.emitter.emitExportSectionStart(totalExports);
    for (let exp in exports) {
      this.emitter.emitExport(exp.name, exp.func);
    }
    for (let g in globalExports) {
      this.emitter.emitExportGlobal(g.zenaName, g.index);
    }
    for (let tName in tagExports) {
      let tag = wasm.exportTagMap[tName];
      this.emitter.emitExportTag(tName, tag.index);
    }
    if (wasm.hasMemory && !memoryImported) {
      this.emitter.emitExportMemory("memory", 0);
    }
    this.emitter.emitExportSectionEnd();

    let {startFunction} = wasm;
    if (startFunction != null) {
      let sf = startFunction;
      this.emitter.emitStartSection(sf.index);
    }

    let elemIndices = new GrowableArray<i32>();
    for (let f in wasm.functions) {
      if (f.isReferenceTaken) {
        elemIndices.push(f.index);
      }
    }
    if (elemIndices.length > 0) {
      this.emitter.emitElementSection(elemIndices);
    }
    
    performance.end(tEmitOther);
    let tEmitCode = performance.start("codegen-emit-code");
    this.emitter.emitCodeSectionStart(wasm.functions.length);
    var zirLowered = 0;
    var zirGraduated = 0;
    var zirDemoted = 0;
     for (let wasmFunc in wasm.functions) {
        // Lowering failures throw: a bail is a compiler bug, not a
        // coverage gap.
        let body = lowerFunction(wasm, wasmFunc);
        runGvn(body, new IrCfg(body));
        // Loud on verifier failure: a broken lowering must never limp
        // into emission.
        let verifyErrors = verifyIr(body);
        if (verifyErrors.length > 0) {
          var message = "zir verify failed for " +
              (if (wasmFunc.name != null) wasmFunc.name as String else "<unnamed>") + ":";
          for (let e in verifyErrors) {
            message = message + "\n  " + e;
          }
          throw new Error(message);
        }
        let (graduated, demoted) = emitZirFunction(wasm, this.emitter, wasmFunc, body);
        zirGraduated += graduated;
        zirDemoted += demoted;
        zirLowered += 1;
     }
    if (this.zirStats) {
      console.log("zir backend: " + i32ToString(zirLowered) + " lowered");
      console.log("zir locals: " + i32ToString(zirGraduated) +
          " ref locals non-null, " + i32ToString(zirDemoted) +
          " kept nullable (init rollback)");
    }
    if (wasm.datas.length > 0) {
      this.emitter.emitDataCountSection(wasm.datas.length);
    }
    this.emitter.emitCodeSectionEnd();
    performance.end(tEmitCode);

    let tEmitOther2 = performance.start("codegen-emit-other");
    if (wasm.datas.length > 0) {
      this.emitter.emitDataSection(wasm.datas, wasm.rawDatas);
    }

    this.emitter.emitModuleEnd();
    performance.end(tEmitOther2);

    if (targetEmitsComponent(this.target)) {
      this.componentShape = buildComponentShape(wasm, this.importEncoder);
    }
  }
}
