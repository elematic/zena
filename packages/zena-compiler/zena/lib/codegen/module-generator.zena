import { WasmModule, WasmFunction, WasmSignature, WasmType, DiscoveryPass,
  WasmExport, WasmGlobal, WasmStruct
} from './wasm-module.zena';
import { Program, CompilationUnit } from '../program.zena';
import { VariableDeclaration, IdentifierPattern, Expression, NumberLiteral, StringLiteral, BooleanLiteral } from '../ast.zena';
import { String } from 'zena:string';
import { ValType } from './wasm.zena';
import { parseI32, parseF64 } from 'zena:string-convert';
import { Array } from 'zena:array';
import { FunctionGenerator } from './function-generator.zena';
import { WasmEmitter } from './wasm-emitter.zena';
import { UsageAnalyzer } from '../analysis/usage.zena';


export class ModuleGenerator {
  program: Program;
  emitter: WasmEmitter;
  
  new(this.program, this.emitter);

  generateExpression(expr: Expression, funcComp: FunctionGenerator): void {
    funcComp.generateExpression(expr);
  }
  
  compile(): void {
    let wasm = new WasmModule();
    let usageAnalyzer = new UsageAnalyzer(this.program);
    let usage = usageAnalyzer.analyze();
    let pass = new DiscoveryPass(this.program, wasm, usage);
    pass.run();
    wasm.layout();

    this.emitter.emitModuleStart();
    this.emitter.emitTypeSectionStart(wasm.types.length);
    var i = 0;
    for (let t in wasm.types) {
      if (t is WasmSignature) {
        let sig = t as WasmSignature;
        this.emitter.emitFunctionTypeStart(i);
        
        this.emitter.emitFunctionTypeParamsStart(sig.params.length);
        for (let param in sig.params) {
          this.emitter.emitFunctionTypeParam(param);
        }
        
        this.emitter.emitFunctionTypeResultsStart(sig.returns.length);
        for (let ret in sig.returns) {
          this.emitter.emitFunctionTypeResult(ret);
        }
        
        this.emitter.emitFunctionTypeEnd();
      } else if (t is WasmStruct) {
        let st = t as WasmStruct;
        this.emitter.emitStructTypeStart(i, st.name);
        
        this.emitter.emitStructTypeFieldsStart(st.fields.length);
        for (let field in st.fields) {
          this.emitter.emitStructTypeField(field.type, field.isMutable);
        }
        
        this.emitter.emitStructTypeEnd();
      }
      i += 1;
    }
    this.emitter.emitTypeSectionEnd();

    this.emitter.emitImportSectionStart(wasm.functionImports.length);
    for (let f in wasm.functionImports) {
      if (f.importModule != null && f.importName != null) {
        this.emitter.emitFunctionImport(f.importModule as String, f.importName as String, f.signature.index);
      }
    }
    this.emitter.emitImportSectionEnd();

    this.emitter.emitFunctionSectionStart(wasm.functions.length);
    for (let f in wasm.functions) {
      this.emitter.emitFunctionDefinition(f.signature.index);
    }
    this.emitter.emitFunctionSectionEnd();

    this.emitter.emitGlobalSectionStart(wasm.globals.length);
    for (let g in wasm.globals) {
      this.emitter.emitGlobal(g.type, g.isMutable);
      
      // Need a clean way to emit global initializer
      match (g.init) {
        case NumberLiteral {raw}: {
           let type = g.type;
           if (type == ValType.i32) {
              if (let (true, val) = parseI32(raw)) {
                this.emitter.emitI32Const(val);
              } else {
                this.emitter.emitI32Const(0);
              }
           } else if (type == ValType.f64) {
              this.emitter.emitF64Const(parseF64(raw));
           } else if (type == ValType.f32) {
              this.emitter.emitF32Const(parseF64(raw)); // f32 requires casting
           } else {
             this.emitter.emitI32Const(0);
           }
        }
        case BooleanLiteral {value}: {
          this.emitter.emitBooleanConst(value);
        }
        case _: {
           // Wait!
        }
      }
      this.emitter.emitGlobalEnd();
    }
    this.emitter.emitGlobalSectionEnd();
    
    let exports = new Array<WasmExport>();
    let entryPoint = this.program.entryPoint;
    if (entryPoint != null) {
      let entryMod = (entryPoint as CompilationUnit).ast;
      let model = (entryPoint as CompilationUnit).model;
      for (let stmt in entryMod.body) {
        if (stmt is VariableDeclaration) {
          let varDecl = stmt as VariableDeclaration;
          if (varDecl.exported && varDecl.pattern is IdentifierPattern) {
            let ident = varDecl.pattern as IdentifierPattern;
            let sym = model.resolveDeclaration(ident);
            if (sym != null) {
              if (wasm.functionMap.has(sym.id)) {
                let wasmFunc = wasm.functionMap[sym.id];
                exports.push(new WasmExport(ident.name, wasmFunc));
              }
            }
          }
        }
      }
    }
    
    // Compute total exports = functions + globals
    var totalExports = exports.length;
    let globalExports = new Array<WasmGlobal>();
    for (let gName in wasm.exportGlobalMap.keys()) {
      globalExports.push(wasm.exportGlobalMap[gName]);
    }
    totalExports += globalExports.length;

    this.emitter.emitExportSectionStart(totalExports);
    for (let exp in exports) {
      this.emitter.emitExport(exp.name, exp.func);
    }
    for (let g in globalExports) {
      this.emitter.emitExportGlobal(g.zenaName, g.index);
    }
    this.emitter.emitExportSectionEnd();
    
    this.emitter.emitCodeSectionStart(wasm.functions.length);
    for (let wasmFunc in wasm.functions) {
       let funcCompiler = new FunctionGenerator(wasm, this.emitter, wasmFunc);
       funcCompiler.generate();
    }
    this.emitter.emitCodeSectionEnd();
    
    this.emitter.emitModuleEnd();
  }
}
