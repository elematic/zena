/**
 * String literal, template literal, and tagged-template lowering,
 * split out of lowering.zena. Each function takes the shared LoweringContext;
 * bodies are streaming's shapes exactly (see the per-function docs).
 */
import { Array } from 'zena:array';
import { GrowableArray } from 'zena:growable-array';
import { String } from 'zena:string';
import { Error } from 'zena:error';
import { i32ToString } from 'zena:string-convert';
import {
  Expression, Identifier, StringLiteral, TaggedTemplateExpression,
  TemplateLiteral,
} from '../../ast.zena';
import {
  AnyRefType, ArrayType, ClassType, FunctionType, Type, baseType,
} from '../../types.zena';
import { Symbol } from '../../scope/symbol.zena';
import { ValType, ValTypeI32, ValTypeRef, ValTypeRefNull } from '../wasm.zena';
import {
  ClassCodegenInfo, WasmFunction, WasmGlobal, WasmSignature, WasmStruct,
  asWasmSignature, asWasmStruct, isValSubtype,
} from '../wasm-module.zena';
import { getClassKey, getClassMethodKey, templateConvertHelperName } from '../codegen-utils.zena';
import { typeToValTypeWithSub } from '../type-mapping.zena';
import { IrOp, IrRefField, IrRefFunc, IrRefGlobal, IrRefType } from './ir.zena';
import { lowerExpr } from './lowering.zena';
import {
  LoweringContext, noValues, oneValue, twoValues,
} from './lowering-context.zena';

/**
 * A string literal: id lookup in the shared registry, then the
 * get_string_literal helper call. Same contract as streaming: the
 * registry is complete by construction, so a miss is a discovery bug
 * — a plain Error (not ZirUnsupported) fails the compile loudly
 * rather than falling back to a second storage story.
 */
export let lowerStringLiteral = (cx: LoweringContext, lit: StringLiteral): i32 => {
  let litId = if (let (true, id) = cx.wasm.stringLiteralIds.get(lit.value)) id else -1;
  if (litId < 0) {
    throw new Error("String literal missing from the shared registry: '" +
        lit.value + "'");
  }
  if (cx.wasm.getStringLiteralFunc == null) {
    cx.fail('no string literal helper');
  }
  let helper = cx.wasm.getStringLiteralFunc as WasmFunction;
  if (helper.signature.returns.length != 1) {
    cx.fail('string helper shape');
  }
  let id = cx.b.constI32(litId, new ValTypeI32());
  let funcRef = cx.b.addRef(new IrRefFunc(helper));
  let call = cx.b.callFunc(funcRef, oneValue(id), helper.signature.returns[0]);
  // The literal is a non-null String; the helper returns nullable.
  // Re-assert so merges and returns type-check. Synthesized quasi
  // literals (template parts) carry no checker type — strip via the
  // value's own type instead.
  if (cx.func.model.getNodeType(lit) == null) {
    return cx.stripNonNull(call);
  }
  return cx.reassertNonNull(call, cx.exprVt(lit));
};

/**
 * Template literals: quasi/expression parts in order, primitives
 * converted through the zena:string-convert helpers, then joined —
 * __concatN for 2..5 parts, else array.new_fixed + String.fromParts
 * (streaming's shape exactly).
 */
export let lowerTemplateLiteral = (cx: LoweringContext, tpl: TemplateLiteral): i32 => {
  if (tpl.quasis.length + tpl.expressions.length == 0) {
    return lowerStringLiteral(cx, new StringLiteral('', tpl.loc));
  }
  if (tpl.expressions.length == 0) {
    return lowerStringLiteral(cx,
        new StringLiteral(tpl.quasis[0].cooked, tpl.loc));
  }
  let parts = new GrowableArray<i32>();
  for (var i = 0; i < tpl.expressions.length; i += 1) {
    parts.push(lowerStringLiteral(cx,
        new StringLiteral(tpl.quasis[i].cooked, tpl.quasis[i].loc)));
    parts.push(templateOperandString(cx, tpl.expressions[i]));
  }
  parts.push(lowerStringLiteral(cx, new StringLiteral(
      tpl.quasis[tpl.quasis.length - 1].cooked,
      tpl.quasis[tpl.quasis.length - 1].loc)));

  if (parts.length >= 2 && parts.length <= 5) {
    let concat = cx.wasm.getStdlibFunc(
        'zena:string', '__concat' + i32ToString(parts.length));
    if (concat != null) {
      let sig = concat.signature;
      if (sig.returns.length != 1 || sig.params.length != parts.length) {
        cx.fail('concat helper shape');
      }
      let call = cx.b.callFunc(
          cx.b.addRef(new IrRefFunc(concat)), parts, sig.returns[0]);
      return cx.reassertNonNull(call, cx.exprVt(tpl as Expression));
    }
  }
  let fromPartsOpt = if (cx.wasm.stringClass != null) {
    let key = getClassMethodKey(
        getClassKey(cx.wasm.stringClass as ClassType), 'fromParts');
    if (let (true, f) = cx.wasm.classMethodMap.get(key)) f else null
  } else {
    null
  };
  if (fromPartsOpt == null) {
    cx.fail('String.fromParts missing');
  }
  let fromParts = fromPartsOpt;
  let fsig = fromParts.signature;
  if (fsig.returns.length != 1 || fsig.params.length != 1) {
    cx.fail('fromParts shape');
  }
  let elemVt = if (parts.length > 0) {
    match (cx.valueTypeOf(parts[0])) {
      case ValTypeRef as r: new ValTypeRefNull(r.target) as ValType
      case _: cx.valueTypeOf(parts[0])
    }
  } else {
    new ValTypeI32() as ValType
  };
  let arr = cx.wasm.getArray(elemVt, true);
  let arrValue = cx.b.emit(IrOp.array_new_fixed,
      new ValTypeRef(arr) as ValType,
      cx.b.pushArgList(parts), cx.b.addRef(new IrRefType(arr)));
  if (!isValSubtype(cx.valueTypeOf(arrValue), fsig.params[0])) {
    cx.fail('fromParts operand type');
  }
  let args = new GrowableArray<i32>();
  args.push(arrValue);
  let call = cx.b.callFunc(
      cx.b.addRef(new IrRefFunc(fromParts)), args, fsig.returns[0]);
  return cx.reassertNonNull(call, cx.exprVt(tpl as Expression));
};

/**
 * A template interpolation as a String value: primitives convert
 * through the zena:string-convert helpers; String values pass
 * through; anything else bails.
 */
let templateOperandString = (cx: LoweringContext, expr: Expression): i32 => {
  let value = lowerExpr(cx, expr, null);
  let tOpt = cx.substitutedNodeType(expr);
  if (tOpt == null) {
    cx.fail('untyped template operand');
  }
  let bt = baseType(tOpt);
  let helperName = templateConvertHelperName(tOpt);
  if (helperName == '') {
    if (bt is ClassType && bt.name == 'String') {
      return value;
    }
    cx.fail('template operand type');
  }
  let helperOpt = cx.wasm.getStdlibFunc('zena:string-convert', helperName);
  if (helperOpt == null) {
    cx.fail('template helper missing');
  }
  let helper = helperOpt;
  let sig = helper.signature;
  if (sig.params.length != 1 || sig.returns.length != 1) {
    cx.fail('template helper shape');
  }
  if (!isValSubtype(cx.valueTypeOf(value), sig.params[0])) {
    cx.failConformance(value, sig.params[0], 'template operand type');
  }
  return cx.b.callFunc(
      cx.b.addRef(new IrRefFunc(helper)), oneValue(value), sig.returns[0]);
};

/**
 * Tagged templates: the TemplateStringsArray is built once and
 * cached in the expression's pre-registered global (discovery
 * created it); the interpolated values become a FixedArray typed by
 * the tag's second parameter; then the tag is called — directly for
 * top-level functions, through the closure pair for local values.
 * Streaming's shape throughout, including the lazy-init null check.
 */
export let lowerTaggedTemplate = (cx: LoweringContext,
    expr: TaggedTemplateExpression): i32 => {
  let tsaClassOpt = cx.wasm.templateStringsArrayClass;
  if (tsaClassOpt == null) {
    cx.fail('template strings array class missing');
  }
  let tsaKey = getClassKey(tsaClassOpt);
  let tsaInfoOpt = if (let (true, info) = cx.wasm.classInfos.get(tsaKey)) info else null;
  if (tsaInfoOpt == null) {
    cx.fail('template strings array struct missing');
  }
  let tsaInfo = tsaInfoOpt;
  let tsaStruct = tsaInfo.structType;
  let stringClassOpt = cx.wasm.stringClass;
  if (stringClassOpt == null) {
    cx.fail('string class missing');
  }
  let stringKey = getClassKey(stringClassOpt);
  let strInfoOpt = if (let (true, info) = cx.wasm.classInfos.get(stringKey)) info else null;
  if (strInfoOpt == null) {
    cx.fail('string struct missing');
  }
  let stringStruct = strInfoOpt.structType;
  let stringsArr = cx.wasm.getArray(
      new ValTypeRefNull(stringStruct) as ValType, true);
  let gOpt = if (cx.wasm.templateLiteralGlobals.has(expr)) {
    cx.wasm.templateLiteralGlobals[expr]
  } else {
    null
  };
  if (gOpt == null) {
    cx.fail('tagged template global missing');
  }
  let g = gOpt;

  // Lazy init: build the TSA on first evaluation, cache it.
  let cached = cx.b.emit(IrOp.global_get, g.type, -1,
      cx.b.addRef(new IrRefGlobal(g)));
  let isNull = cx.b.emit(IrOp.ref_is_null, new ValTypeI32(), cached, -1);
  let initB = cx.b.newBlock();
  let doneB = cx.b.newBlock();
  cx.b.brIf(isNull, initB, noValues(), doneB, noValues());

  cx.b.switchTo(initB);
  let cookedParts = new GrowableArray<i32>();
  for (let quasi in expr.quasi.quasis) {
    cookedParts.push(lowerStringLiteral(cx,
        new StringLiteral(quasi.cooked, quasi.loc)));
  }
  let cooked = cx.b.emit(IrOp.array_new_fixed,
      new ValTypeRef(stringsArr) as ValType,
      cx.b.pushArgList(cookedParts),
      cx.b.addRef(new IrRefType(stringsArr)));
  let rawParts = new GrowableArray<i32>();
  for (let quasi in expr.quasi.quasis) {
    rawParts.push(lowerStringLiteral(cx,
        new StringLiteral(quasi.raw, quasi.loc)));
  }
  let raw = cx.b.emit(IrOp.array_new_fixed,
      new ValTypeRef(stringsArr) as ValType,
      cx.b.pushArgList(rawParts),
      cx.b.addRef(new IrRefType(stringsArr)));
  let tsaArgs = new GrowableArray<i32>();
  let {vtableGlobal} = tsaInfo;
  if (vtableGlobal != null) {
    let vtG = vtableGlobal;
    tsaArgs.push(cx.b.emit(IrOp.global_get, vtG.type, -1,
        cx.b.addRef(new IrRefGlobal(vtG))));
  } else {
    tsaArgs.push(cx.b.emit(IrOp.ref_null,
        tsaStruct.fields[0].type, -1, -1));
  }
  for (var f = 1; f < tsaStruct.fields.length; f += 1) {
    let fieldName = if (tsaStruct.fields[f].name != null) {
      tsaStruct.fields[f].name as String
    } else {
      ''
    };
    if (fieldName.endsWith('::#strings')) {
      tsaArgs.push(cooked);
    } else if (fieldName.endsWith('::#raw')) {
      tsaArgs.push(raw);
    } else {
      let ft = tsaStruct.fields[f].type;
      tsaArgs.push(match (ft) {
        case ValTypeI32: cx.b.constI32(0, new ValTypeI32())
        case _: cx.b.emit(IrOp.ref_null, ft, -1, -1)
      });
    }
  }
  let tsaNew = cx.b.emit(IrOp.struct_new,
      new ValTypeRef(tsaStruct) as ValType,
      cx.b.pushArgList(tsaArgs),
      cx.b.addRef(new IrRefType(tsaStruct)));
  cx.b.emitVoid(IrOp.global_set, tsaNew,
      cx.b.addRef(new IrRefGlobal(g)));
  cx.b.br(doneB, noValues());

  cx.b.switchTo(doneB);
  let tsaLoaded = cx.b.emit(IrOp.global_get, g.type, -1,
      cx.b.addRef(new IrRefGlobal(g)));
  let tsa = cx.b.emit(IrOp.ref_as_non_null,
      new ValTypeRef(tsaStruct) as ValType, tsaLoaded, -1);

  // Interpolated values, typed by the tag's second parameter.
  let calleeType = cx.func.model.getNodeType(expr.tag);
  var valueType: Type = new AnyRefType();
  if (calleeType is FunctionType) {
    if (calleeType.parameters.length >= 2) {
      let vp = baseType(calleeType.parameters[1]);
      // The receiver casts are checker-unnecessary but load-bearing: a
      // nullable member null-tested on an is-narrowed binding fails ZIR
      // lowering without them (elematic/zena#85).
      if (vp is ClassType && (vp as ClassType).typeArguments != null &&
          ((vp as ClassType).typeArguments as GrowableArray<Type>).length > 0) {
        valueType = ((vp as ClassType).typeArguments as GrowableArray<Type>)[0];
      } else if (vp is ArrayType) {
        valueType = vp.elementType;
      }
    }
  }
  let valVt = typeToValTypeWithSub(cx.wasm, valueType, cx.func);
  cx.requireSupported(valVt, 'tagged template value type');
  let valuesArr = cx.wasm.getArray(valVt, true);
  let valueParts = new GrowableArray<i32>();
  for (let sub in expr.quasi.expressions) {
    let v = lowerExpr(cx, sub, valVt);
    if (!isValSubtype(cx.valueTypeOf(v), valVt)) {
      cx.failConformance(v, valVt, 'tagged template value type');
    }
    valueParts.push(v);
  }
  let values = cx.b.emit(IrOp.array_new_fixed,
      new ValTypeRef(valuesArr) as ValType,
      cx.b.pushArgList(valueParts),
      cx.b.addRef(new IrRefType(valuesArr)));

  // Call the tag.
  if (!(expr.tag is Identifier)) {
    cx.fail('tagged template tag kind');
  }
  let symOpt = cx.func.model.resolve(expr.tag);
  if (symOpt == null) {
    cx.fail('tagged template tag unresolved');
  }
  let resolved = symOpt.resolveTarget();
  let callArgs = twoValues(tsa, values);
  if (let (true, target) = cx.wasm.functionMap.get(resolved.id)) {
    let sig = target.signature;
    if (sig.params.length != 2 || sig.returns.length > 1) {
      cx.fail('tagged template tag shape');
    }
    let resultType = if (sig.returns.length == 1) sig.returns[0] else null;
    return cx.b.callFunc(
        cx.b.addRef(new IrRefFunc(target)), callArgs, resultType);
  }
  // A local value: call through its closure pair.
  let callee = if (cx.env.has(resolved.id)) cx.env[resolved.id] else -1;
  if (callee < 0) {
    cx.fail('tagged template tag target');
  }
  let structOpt = asWasmStruct(cx.valueTypeOf(callee));
  if (structOpt == null) {
    cx.fail('tagged template tag kind');
  }
  let closureStruct = structOpt;
  if (closureStruct.fields.length != 2) {
    cx.fail('tagged template tag kind');
  }
  let sigOpt = asWasmSignature(closureStruct.fields[0].type);
  if (sigOpt == null) {
    cx.fail('tagged template tag kind');
  }
  let csig = sigOpt;
  if (csig.params.length != 3 || csig.returns.length > 1) {
    cx.fail('tagged template tag shape');
  }
  let ctxVal = cx.b.emit(IrOp.struct_get, closureStruct.fields[1].type,
      callee, cx.b.addRef(new IrRefField(closureStruct, 'ctx')));
  let funcVal = cx.b.emit(IrOp.struct_get, closureStruct.fields[0].type,
      callee, cx.b.addRef(new IrRefField(closureStruct, 'func')));
  let clArgs = new GrowableArray<i32>();
  clArgs.push(ctxVal);
  clArgs.push(tsa);
  clArgs.push(values);
  for (var i = 1; i < csig.params.length; i += 1) {
    if (!isValSubtype(cx.valueTypeOf(clArgs[i]), csig.params[i])) {
      cx.failConformance(clArgs[i], csig.params[i],
          'tagged template argument type');
    }
  }
  let resultType = if (csig.returns.length == 1) csig.returns[0] else null;
  return cx.b.callRef(funcVal, clArgs, resultType);
};
