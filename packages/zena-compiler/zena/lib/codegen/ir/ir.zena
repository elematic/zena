/**
 * ZIR core data structures.
 *
 * See docs/design/ir.md. ZIR is a CFG-of-basic-blocks SSA IR with block
 * parameters instead of phi nodes. The encoding is data-oriented (§4):
 * instructions live in flat parallel i32 arrays indexed by instruction id,
 * and a value id IS the id of its defining instruction (block parameters
 * are `param` instructions, so the value namespace is uniform).
 *
 * Hot arrays hold only i32s. References to module entities (functions,
 * globals, struct types, fields, literals) are corralled into the small
 * per-function `refTable`; types go through `typeTable`. Instructions store
 * indices into those tables, never object references.
 *
 * Operand encoding conventions ("a"/"b" are the two inline operand slots;
 * "a -> [...]" means slot a holds an index into `extra` where the listed
 * items are stored consecutively):
 *
 *   nop, param, unreachable:  no operands
 *   const_i32:   a = the value itself
 *   const_i64:   a = index into constI64
 *   const_f32/const_f64: a = index into constF64
 *   unary ops:   a = operand value
 *   binary ops:  a, b = operand values
 *   ref_null:    no operands (result type = typeId)
 *   ref_test, ref_cast: a = value, b = target type (typeTable index)
 *   ref_func:    b = ref (function)
 *   str_lit:     b = ref (string literal)
 *   global_get:  b = ref (global)
 *   global_set:  a = value, b = ref (global)
 *   var_get:     b = var index (into varTypes)
 *   var_set:     a = value, b = var index
 *   struct_new:  a -> [argc, arg*],           b = ref (struct type)
 *   struct_get:  a = receiver,                b = ref (field)
 *   struct_set:  a -> [receiver, value],      b = ref (field)
 *   array_new:   a -> [length, init or -1],   b = ref (array type)
 *   array_new_data: a -> [offset, length, dataIndex], b = ref (array type)
 *   array_new_fixed: a -> [argc, arg*],       b = ref (array type)
 *   array_get:   a = array, b = index
 *   array_get_u: a = array, b = index  (zero-extending read of a packed element)
 *   array_get_s: a = array, b = index  (sign-extending read of a packed element)
 *   array_set:   a -> [array, index, value]
 *   array_copy:  a -> [dest, destOff, src, srcOff, len]
 *   array_len:   a = array
 *   iface_pack:  a = instance,                b = ref (vtable global);
 *                result type names the fat-pointer struct
 *   iface_vtable, iface_instance: a = fat pointer
 *   call:        a -> [argc, arg*],           b = ref (function)
 *   call_ref:    a -> [callee, argc, arg*]
 *   mv_get:      a = multi-result call value,  b = result index
 *   ret_multi:   a -> [argc, value*]
 *   throw:       a -> [argc, arg*],           b = ref (tag) or -1
 *   try_br:      a = ref (exception tag),
 *                b -> [bodyTarget, argc, arg*, catchTarget, argc, arg*]
 *   br:          a -> [target, argc, arg*]
 *   br_if:       a = condition,
 *                b -> [thenTarget, thenArgc, arg*, elseTarget, elseArgc, arg*]
 *   br_on_cast, br_on_cast_fail:
 *                a = value,
 *                b -> [targetType (typeTable index),
 *                      okTarget, okArgc, arg*, failTarget, failArgc, arg*]
 *   br_table:    a = selector,
 *                b -> [count, (target, argc, arg*)*]  (last entry = default)
 *   ret:         a = value, or -1 for void
 *   yield_:      a = yielded value, b -> [target, argc, arg*]
 *   await_:      a = awaited future, b -> [target, argc, arg*]
 *                (both: presplit suspension bodies only — generator
 *                bodies for yield_, async bodies for await_ — and
 *                rewritten by the split pass, never emitted)
 *
 * A result type of -1 in `typeId` means the instruction produces no value.
 * Instruction and block ids are plain i32 indices for now; -1 means "none".
 */
import { Array } from 'zena:array';
import { Error } from 'zena:error';
import { ValType, WasmType } from '../wasm.zena';
import { WasmStruct, WasmFunction, WasmGlobal, WasmTag } from '../wasm-module.zena';

export enum IrOp {
  nop,
  param,
  const_i32,
  const_i64,
  const_f32,
  const_f64,
  // i32 arithmetic and comparison (1:1 with wasm)
  i32_add,
  i32_sub,
  i32_mul,
  i32_div_s,
  i32_rem_s,
  i32_and,
  i32_or,
  i32_xor,
  i32_shl,
  i32_shr_s,
  i32_shr_u,
  i32_eqz,
  i32_eq,
  i32_ne,
  i32_lt_s,
  i32_le_s,
  i32_gt_s,
  i32_ge_s,
  i32_div_u,
  i32_rem_u,
  i32_lt_u,
  i32_le_u,
  i32_gt_u,
  i32_ge_u,
  // i64
  i64_add,
  i64_sub,
  i64_mul,
  i64_div_s,
  i64_rem_s,
  i64_and,
  i64_or,
  i64_xor,
  i64_shl,
  i64_shr_s,
  i64_shr_u,
  i64_eq,
  i64_ne,
  i64_lt_s,
  i64_le_s,
  i64_gt_s,
  i64_ge_s,
  i64_div_u,
  i64_rem_u,
  i64_lt_u,
  i64_le_u,
  i64_gt_u,
  i64_ge_u,
  // f64
  f64_add,
  f64_sub,
  f64_mul,
  f64_div,
  f64_eq,
  f64_ne,
  f64_lt,
  f64_le,
  f64_gt,
  f64_ge,
  // f32
  f32_add,
  f32_sub,
  f32_mul,
  f32_div,
  f32_eq,
  f32_ne,
  f32_lt,
  f32_le,
  f32_gt,
  f32_ge,
  // unary numerics
  i64_eqz,
  f64_neg,
  f32_neg,
  // conversions
  i32_wrap_i64,
  i64_extend_i32_s,
  f64_convert_i32_s,
  f32_convert_i32_s,
  f64_convert_i64_s,
  f32_convert_i64_s,
  i32_trunc_sat_f64_s,
  i32_trunc_sat_f32_s,
  i64_trunc_sat_f64_s,
  i64_trunc_sat_f32_s,
  f64_promote_f32,
  f32_demote_f64,
  i64_reinterpret_f64,
  i32_reinterpret_f32,
  f32_reinterpret_i32,
  f64_reinterpret_i64,
  i32_trunc_sat_f32_u,
  i32_trunc_sat_f64_u,
  i64_trunc_sat_f32_u,
  i64_trunc_sat_f64_u,
  i32_clz,
  i32_ctz,
  i32_popcnt,
  i64_clz,
  i64_ctz,
  i64_popcnt,
  f32_abs,
  f32_ceil,
  f32_floor,
  f32_nearest,
  f32_sqrt,
  f32_trunc,
  f64_abs,
  f64_ceil,
  f64_floor,
  f64_nearest,
  f64_sqrt,
  f64_trunc,
  f32_min,
  f32_max,
  f32_copysign,
  f64_min,
  f64_max,
  f64_copysign,
  // linear memory loads: a = addr, b = alignment hint
  i32_load,
  i32_load8_u,
  i64_load,
  f32_load,
  f64_load,
  i64_store,
  f32_store,
  f64_store,
  memory_size,
  memory_grow,
  // references
  ref_null,
  ref_is_null,
  ref_as_non_null,
  ref_eq,
  ref_test,
  ref_cast,
  ref_func,
  extern_convert_any,
  any_convert_extern,
  // linear memory (fixed alignments matching the streaming helpers)
  i32_store,
  i32_store8,
  // aggregates
  struct_new,
  struct_new_default,
  struct_get,
  struct_set,
  array_new,
  array_new_data,
  array_new_fixed,
  array_get,
  array_get_u,
  array_get_s,
  array_set,
  array_copy,
  array_len,
  // module-level accesses
  global_get,
  global_set,
  /**
   * Reads a mutable variable (§5.1). Distinct from every other value in
   * ZIR: a variable is STORAGE, not an SSA definition, so a read is not
   * value-numbered and sees whatever the last executed `var_set` wrote.
   * Emits as `local.get` on a dedicated wasm local, never coalesced.
   */
  var_get,
  /** Writes a mutable variable. `local.set` on its dedicated local. */
  var_set,
  str_lit,
  // dispatch (docs/design/ir.md §5)
  iface_pack,
  iface_vtable,
  iface_instance,
  call,
  call_ref,
  /** Projects one result out of a multi-result call (which itself
   * produces no single value). Projections are emitted immediately
   * after their call, in ascending result order. */
  mv_get,
  // Terminators. These must stay last and contiguous: isIrTerminator does a
  // band check against IrOp.br.
  br,
  br_if,
  br_table,
  br_on_cast,
  br_on_cast_fail,
  /** Enters a protected region: control flows to the body successor;
   * an exception thrown anywhere in the body's dynamic extent
   * transfers to the catch successor (payload via the exception
   * globals, streaming-compatible). */
  try_br,
  ret,
  /** Multi-value return: all result values at once. */
  ret_multi,
  throw,
  unreachable,
  /** Generator suspension (presplit form only, generators.md §4.1):
   * yields value `a` and resumes at the single successor. Never
   * emitted — the split pass rewrites every yield before emission. */
  yield_,
  /** Async suspension (presplit form only, async.md §3): awaits the
   * `Future` in slot `a` and resumes at the single successor. The
   * awaited future is an ordinary live value across the suspension, so
   * the resume edge carries no arguments — the resumed segment reads
   * the settled result back off the future. Never emitted; the split
   * pass rewrites every await before emission. */
  await_,
  /** Sentinel: the number of ops. Keep last. */
  op_count
}

export let isIrTerminator = (op: IrOp): boolean => {
  return op as i32 >= IrOp.br as i32;
};

/**
 * Unary numeric and conversion ops: exactly one value operand (slot a),
 * no payload. Shared by the operand decoder, the emitter, and (soon)
 * the simplify/constant-folding pass.
 */
export let isUnaryNumericOp = (op: IrOp): boolean => {
  return op == IrOp.i32_eqz || op == IrOp.i64_eqz || op == IrOp.f64_neg ||
      op == IrOp.f32_neg || op == IrOp.i32_wrap_i64 ||
      op == IrOp.i64_extend_i32_s || op == IrOp.f64_convert_i32_s ||
      op == IrOp.f32_convert_i32_s || op == IrOp.f64_convert_i64_s ||
      op == IrOp.f32_convert_i64_s || op == IrOp.i32_trunc_sat_f64_s ||
      op == IrOp.i32_trunc_sat_f32_s || op == IrOp.i64_trunc_sat_f64_s ||
      op == IrOp.i64_trunc_sat_f32_s || op == IrOp.f64_promote_f32 ||
      op == IrOp.f32_demote_f64 || op == IrOp.i64_reinterpret_f64 ||
      op == IrOp.i32_reinterpret_f32 ||
      op == IrOp.f32_reinterpret_i32 ||
      op == IrOp.f64_reinterpret_i64 ||
      op == IrOp.i32_trunc_sat_f32_u ||
      op == IrOp.i32_trunc_sat_f64_u ||
      op == IrOp.i64_trunc_sat_f32_u ||
      op == IrOp.i64_trunc_sat_f64_u ||
      op == IrOp.i32_clz ||
      op == IrOp.i32_ctz ||
      op == IrOp.i32_popcnt ||
      op == IrOp.i64_clz ||
      op == IrOp.i64_ctz ||
      op == IrOp.i64_popcnt ||
      op == IrOp.f32_abs ||
      op == IrOp.f32_ceil ||
      op == IrOp.f32_floor ||
      op == IrOp.f32_nearest ||
      op == IrOp.f32_sqrt ||
      op == IrOp.f32_trunc ||
      op == IrOp.f64_abs ||
      op == IrOp.f64_ceil ||
      op == IrOp.f64_floor ||
      op == IrOp.f64_nearest ||
      op == IrOp.f64_sqrt ||
      op == IrOp.f64_trunc;
};

/**
 * Ops taking exactly ONE value operand (slot a): the unary numerics
 * plus the single-receiver reference/aggregate/dispatch ops — null
 * tests and casts, array_len, field and vtable loads, fat-pointer
 * unpacking — whose slot b (where used) holds a refTable or typeTable
 * index rather than a value. global_set is here too: its one value
 * operand is the stored value; the target global rides in slot b.
 */
export let isSingleValueOp = (op: IrOp): boolean => {
  return isUnaryNumericOp(op) ||
      op == IrOp.ref_is_null || op == IrOp.ref_as_non_null ||
      op == IrOp.ref_test || op == IrOp.ref_cast || op == IrOp.array_len ||
      op == IrOp.extern_convert_any || op == IrOp.any_convert_extern ||
      op == IrOp.i32_load || op == IrOp.i32_load8_u || op == IrOp.i64_load ||
      op == IrOp.f32_load || op == IrOp.f64_load || op == IrOp.memory_grow ||
      op == IrOp.global_set || op == IrOp.var_set ||
      op == IrOp.struct_get || op == IrOp.iface_pack ||
      op == IrOp.iface_vtable || op == IrOp.iface_instance ||
      op == IrOp.mv_get;
};

/**
 * Binary numeric ops: two inline value operands (slots a and b), no
 * payload. Relies on the enum's contiguous numeric bands.
 */
export let isBinaryNumericOp = (op: IrOp): boolean => {
  let v = op as i32;
  return (v >= IrOp.i32_add as i32 && v <= IrOp.i32_ge_u as i32 &&
          v != IrOp.i32_eqz as i32) ||
         (v >= IrOp.i64_add as i32 && v <= IrOp.f32_ge as i32) ||
         op == IrOp.f32_min || op == IrOp.f32_max ||
         op == IrOp.f32_copysign || op == IrOp.f64_min ||
         op == IrOp.f64_max || op == IrOp.f64_copysign;
};

/**
 * A symbolic reference to a module entity. Instructions address these via
 * refTable indices; numeric wasm indices, field offsets, and vtable slots
 * are bound at layout time, after the optimization fixpoint (ir.md §10.2).
 */
export sealed class IrRef {
  case IrRefFunc(target: WasmFunction)
  case IrRefGlobal(target: WasmGlobal)
  case IrRefTag(target: WasmTag)
  case IrRefType(target: WasmType)
  /** A field named symbolically on a struct (object field or vtable slot). */
  case IrRefField(owner: WasmStruct, fieldName: String)
  /** A (class, interface) pair for fat-pointer construction. */
  case IrRefClassInterface(classStruct: WasmStruct, ifaceStruct: WasmStruct)
  case IrRefStringLit(value: String)
}

/**
 * One basic block.
 *
 * A basic block is a straight-line run of instructions: execution can only
 * enter at the top, and can only leave through the single *terminator*
 * instruction at the end (a branch, return, throw, or unreachable) — there
 * are no jumps into or out of the middle. A function body is a graph of
 * these blocks, with the terminators' targets as the edges.
 *
 * Block *parameters* are how values flow between blocks in SSA form; they
 * replace the phi nodes of textbook SSA. A block declares typed
 * parameters, and every branch to it must pass matching arguments — think
 * of branching to a block as calling it with values. For example, a
 * loop-carried counter is a parameter of the loop-header block: the entry
 * branch passes its initial value and the back-edge branch passes the
 * incremented one. (docs/design/ir.md §3 has a worked example.)
 *
 * `params` holds the ids of this block's param instructions; `insts` holds
 * the body instruction ids in order, the last of which must be a
 * terminator. Blocks are objects (not flattened into IrBody arrays)
 * because block counts are tiny relative to instruction counts; the flat
 * blockStart/blockEnd form from ir.md §4 is the *compacted*
 * representation, produced by compact() before serialization/emission
 * (later milestone).
 */
export final class IrBlock {
  params = new Array<i32>();
  insts = new Array<i32>();
}

/** One decoded control-flow edge: target block + branch arguments. */
export final class IrSuccessor {
  target: i32;
  /** Index into IrBody.extra of the first branch argument. */
  argStart: i32;
  argCount: i32;
  new(this.target, this.argStart, this.argCount);
}

export final class IrBody {
  // Parallel instruction arrays, indexed by instruction id. These always
  // have identical lengths and grow in lockstep (only the builder's
  // #newInst appends). A fused stride-N buffer or a rope could avoid the
  // separate copies on growth, but passes overwhelmingly scan one or two
  // of these fields linearly, which favors the struct-of-arrays split,
  // and growth copies are amortized and cheap (array.copy). Lowering will
  // pre-size them from the AST node count via a builder capacity hint
  // (ir.md §4), which should make mid-build growth rare.
  opcode = new Array<i32>();
  typeId = new Array<i32>();
  a = new Array<i32>();
  b = new Array<i32>();
  /** Block id owning each instruction. */
  instBlock = new Array<i32>();
  /** Overflow operand pool. */
  extra = new Array<i32>();

  blocks = new Array<IrBlock>();

  // Indirection tables (ir.md §4).
  typeTable = new Array<ValType>();
  refTable = new Array<IrRef>();

  // Constant pools.
  constI64 = new Array<i64>();
  constF64 = new Array<f64>();

  /**
   * Mutable variables (§5.1), indexed by var id: the declared type of
   * each. Emission gives every one its OWN wasm local, excluded from
   * coalescing, so its stored value survives an exception unwinding to
   * a handler in the same frame — which no SSA value can, since a
   * handler edge leaves from anywhere in the protected region and can
   * only carry values live at its entry.
   */
  varTypes = new Array<ValType>();

  instCount(): i32 {
    return this.opcode.length;
  }

  op(inst: i32): IrOp {
    return this.opcode[inst] as IrOp;
  }

  /** The result type of an instruction, or null if it produces no value. */
  resultType(inst: i32): ValType | null {
    let t = this.typeId[inst];
    if (t < 0) {
      return null;
    }
    return this.typeTable[t];
  }

  producesValue(inst: i32): boolean {
    return this.typeId[inst] >= 0;
  }

  /**
   * Appends every value operand of `inst` (instruction ids read by it,
   * including branch arguments) to `out`.
   */
  appendValueOperands(inst: i32, out: Array<i32>): void {
    let op = this.op(inst);
    let av = this.a[inst];
    // Each branch below corresponds to one shape from the operand-encoding
    // table in the file header; a/b hold either value ids directly or an
    // index into `extra`, depending on that shape.
    // Shape: no value operands. Constants and params define values from
    // payloads; ref_func/str_lit/global_get read module entities via b.
    if (op == IrOp.nop || op == IrOp.param || op == IrOp.const_i32 ||
        op == IrOp.const_i64 || op == IrOp.const_f32 || op == IrOp.const_f64 ||
        op == IrOp.ref_null || op == IrOp.ref_func || op == IrOp.str_lit ||
        op == IrOp.global_get || op == IrOp.var_get ||
        op == IrOp.struct_new_default ||
        op == IrOp.memory_size || op == IrOp.unreachable) {
      return;
    }
    // Shape: one value in slot a. Slot b is free for the non-value payload
    // (a refTable index for global_set/struct_get/vt_*, a typeTable index
    // for ref_test/ref_cast, unused for the pure unary numerics).
    if (isSingleValueOp(op)) {
      out.push(av);
      return;
    }
    // Shape: two values, inline in slots a and b.
    if (op == IrOp.array_get || op == IrOp.array_get_u ||
        op == IrOp.array_get_s || op == IrOp.ref_eq ||
        isBinaryNumericOp(op)) {
      out.push(av);
      out.push(this.b[inst]);
      return;
    }
    // Shapes with more than two operands spill to `extra`; slot a holds the
    // extra index (slot b keeps the refTable index where one is needed).
    // struct_set / memory stores: fixed pair [receiver|addr, value].
    if (op == IrOp.struct_set || op == IrOp.i32_store ||
        op == IrOp.i32_store8 || op == IrOp.i64_store ||
        op == IrOp.f32_store || op == IrOp.f64_store) {
      out.push(this.extra[av]);
      out.push(this.extra[av + 1]);
      return;
    }
    // array_set: fixed triple [array, index, value].
    if (op == IrOp.array_set) {
      out.push(this.extra[av]);
      out.push(this.extra[av + 1]);
      out.push(this.extra[av + 2]);
      return;
    }
    // array_copy: fixed 5-tuple [dest, destOff, src, srcOff, len].
    if (op == IrOp.array_copy) {
      out.push(this.extra[av]);
      out.push(this.extra[av + 1]);
      out.push(this.extra[av + 2]);
      out.push(this.extra[av + 3]);
      out.push(this.extra[av + 4]);
      return;
    }
    // array_new_data: [offset, length, dataIndex] — dataIndex is an
    // immediate, not a value.
    if (op == IrOp.array_new_data) {
      out.push(this.extra[av]);
      out.push(this.extra[av + 1]);
      return;
    }
    // array_new: [length, init], where init is -1 for default-initialized.
    if (op == IrOp.array_new) {
      out.push(this.extra[av]);
      let init = this.extra[av + 1];
      if (init >= 0) {
        out.push(init);
      }
      return;
    }
    // Counted argument list: [argc, arg*].
    if (op == IrOp.struct_new || op == IrOp.call || op == IrOp.throw ||
        op == IrOp.array_new_fixed) {
      let argc = this.extra[av];
      var i = 0;
      while (i < argc) {
        out.push(this.extra[av + 1 + i]);
        i += 1;
      }
      return;
    }
    // call_ref: the callee value precedes the counted list: [callee, argc, arg*].
    if (op == IrOp.call_ref) {
      out.push(this.extra[av]);
      let argc = this.extra[av + 1];
      var i = 0;
      while (i < argc) {
        out.push(this.extra[av + 2 + i]);
        i += 1;
      }
      return;
    }
    // ret: slot a is the value, or -1 for a void return.
    if (op == IrOp.ret) {
      if (av >= 0) {
        out.push(av);
      }
      return;
    }
    // ret_multi: counted value list.
    if (op == IrOp.ret_multi) {
      let argc = this.extra[av];
      var i = 0;
      while (i < argc) {
        out.push(this.extra[av + 1 + i]);
        i += 1;
      }
      return;
    }
    // Branches: the operands are the branch arguments of every successor
    // edge (decoded via successors()), plus — for the conditional forms —
    // the condition/scrutinee/selector riding in slot a.
    if (op == IrOp.br || op == IrOp.try_br) {
      // try_br's slot a is the exception-tag ref, not a value.
      this.#appendSuccessorArgs(inst, out);
      return;
    }
    if (op == IrOp.br_if || op == IrOp.br_on_cast ||
        op == IrOp.br_on_cast_fail || op == IrOp.br_table ||
        op == IrOp.yield_ || op == IrOp.await_) {
      out.push(av);
      this.#appendSuccessorArgs(inst, out);
      return;
    }
    throw new Error(`appendValueOperands: unhandled opcode ${irOpName(op)}`);
  }

  /**
   * Rewrites every VALUE operand of `inst` through `map`, in place —
   * the mutating mirror of appendValueOperands, branch for branch
   * (keep the two in sync). Non-value payloads (refTable/typeTable
   * indices, immediates, alignments) are untouched.
   */
  rewriteValueOperands(inst: i32, map: (v: i32) => i32): void {
    let op = this.op(inst);
    let av = this.a[inst];
    if (op == IrOp.nop || op == IrOp.param || op == IrOp.const_i32 ||
        op == IrOp.const_i64 || op == IrOp.const_f32 || op == IrOp.const_f64 ||
        op == IrOp.ref_null || op == IrOp.ref_func || op == IrOp.str_lit ||
        op == IrOp.global_get || op == IrOp.var_get ||
        op == IrOp.struct_new_default ||
        op == IrOp.memory_size || op == IrOp.unreachable) {
      return;
    }
    if (isSingleValueOp(op)) {
      this.a[inst] = map(av);
      return;
    }
    if (op == IrOp.array_get || op == IrOp.array_get_u ||
        op == IrOp.array_get_s || op == IrOp.ref_eq ||
        isBinaryNumericOp(op)) {
      this.a[inst] = map(av);
      this.b[inst] = map(this.b[inst]);
      return;
    }
    if (op == IrOp.struct_set || op == IrOp.i32_store ||
        op == IrOp.i32_store8 || op == IrOp.i64_store ||
        op == IrOp.f32_store || op == IrOp.f64_store) {
      this.extra[av] = map(this.extra[av]);
      this.extra[av + 1] = map(this.extra[av + 1]);
      return;
    }
    if (op == IrOp.array_set) {
      this.extra[av] = map(this.extra[av]);
      this.extra[av + 1] = map(this.extra[av + 1]);
      this.extra[av + 2] = map(this.extra[av + 2]);
      return;
    }
    if (op == IrOp.array_copy) {
      var ci = 0;
      while (ci < 5) {
        this.extra[av + ci] = map(this.extra[av + ci]);
        ci += 1;
      }
      return;
    }
    if (op == IrOp.array_new_data) {
      this.extra[av] = map(this.extra[av]);
      this.extra[av + 1] = map(this.extra[av + 1]);
      return;
    }
    if (op == IrOp.array_new) {
      this.extra[av] = map(this.extra[av]);
      let init = this.extra[av + 1];
      if (init >= 0) {
        this.extra[av + 1] = map(init);
      }
      return;
    }
    if (op == IrOp.struct_new || op == IrOp.call || op == IrOp.throw ||
        op == IrOp.array_new_fixed) {
      let argc = this.extra[av];
      var i = 0;
      while (i < argc) {
        this.extra[av + 1 + i] = map(this.extra[av + 1 + i]);
        i += 1;
      }
      return;
    }
    if (op == IrOp.call_ref) {
      this.extra[av] = map(this.extra[av]);
      let argc = this.extra[av + 1];
      var i = 0;
      while (i < argc) {
        this.extra[av + 2 + i] = map(this.extra[av + 2 + i]);
        i += 1;
      }
      return;
    }
    if (op == IrOp.ret) {
      if (av >= 0) {
        this.a[inst] = map(av);
      }
      return;
    }
    if (op == IrOp.ret_multi) {
      let argc = this.extra[av];
      var i = 0;
      while (i < argc) {
        this.extra[av + 1 + i] = map(this.extra[av + 1 + i]);
        i += 1;
      }
      return;
    }
    if (op == IrOp.br || op == IrOp.try_br) {
      this.#rewriteSuccessorArgs(inst, map);
      return;
    }
    if (op == IrOp.br_if || op == IrOp.br_on_cast ||
        op == IrOp.br_on_cast_fail || op == IrOp.br_table ||
        op == IrOp.yield_ || op == IrOp.await_) {
      this.a[inst] = map(av);
      this.#rewriteSuccessorArgs(inst, map);
      return;
    }
    throw new Error(`rewriteValueOperands: unhandled opcode ${irOpName(op)}`);
  }

  #rewriteSuccessorArgs(inst: i32, map: (v: i32) => i32): void {
    for (let s in this.successors(inst)) {
      var i = 0;
      while (i < s.argCount) {
        this.extra[s.argStart + i] = map(this.extra[s.argStart + i]);
        i += 1;
      }
    }
  }

  #appendSuccessorArgs(inst: i32, out: Array<i32>): void {
    let succs = this.successors(inst);
    for (let s in succs) {
      var i = 0;
      while (i < s.argCount) {
        out.push(this.extra[s.argStart + i]);
        i += 1;
      }
    }
  }


  /** Decodes the control-flow successors of a terminator instruction. */
  successors(inst: i32): Array<IrSuccessor> {
    let result = new Array<IrSuccessor>();
    let op = this.op(inst);
    if (op == IrOp.ret || op == IrOp.ret_multi || op == IrOp.throw ||
        op == IrOp.unreachable) {
      return result;
    }
    if (op == IrOp.br) {
      let idx = this.a[inst];
      let argc = this.extra[idx + 1];
      result.push(new IrSuccessor(this.extra[idx], idx + 2, argc));
      return result;
    }
    if (op == IrOp.br_if || op == IrOp.try_br) {
      var idx = this.b[inst];
      var i = 0;
      while (i < 2) {
        let target = this.extra[idx];
        let argc = this.extra[idx + 1];
        result.push(new IrSuccessor(target, idx + 2, argc));
        idx += 2 + argc;
        i += 1;
      }
      return result;
    }
    if (op == IrOp.br_on_cast || op == IrOp.br_on_cast_fail) {
      var idx = this.b[inst] + 1; // skip target type
      var i = 0;
      while (i < 2) {
        let target = this.extra[idx];
        let argc = this.extra[idx + 1];
        result.push(new IrSuccessor(target, idx + 2, argc));
        idx += 2 + argc;
        i += 1;
      }
      return result;
    }
    if (op == IrOp.br_table) {
      var idx = this.b[inst];
      let count = this.extra[idx];
      idx += 1;
      var i = 0;
      while (i < count) {
        let target = this.extra[idx];
        let argc = this.extra[idx + 1];
        result.push(new IrSuccessor(target, idx + 2, argc));
        idx += 2 + argc;
        i += 1;
      }
      return result;
    }
    if (op == IrOp.yield_ || op == IrOp.await_) {
      let idx = this.b[inst];
      let argc = this.extra[idx + 1];
      result.push(new IrSuccessor(this.extra[idx], idx + 2, argc));
      return result;
    }
    throw new Error(`successors: not a terminator: ${irOpName(op)}`);
  }
}

/**
 * Wasm-style mnemonic per op, indexed by the dense IrOp value; ops
 * without an entry (empty string) print as op#N.
 */
let buildIrOpNames = (): Array<String> => {
  let count = IrOp.op_count as i32;
  let n = new Array<String>(count);
  for (var i = 0; i < count; i += 1) {
    n.push('');
  }
  n[IrOp.nop as i32] = 'nop';
  n[IrOp.param as i32] = 'param';
  n[IrOp.const_i32 as i32] = 'const.i32';
  n[IrOp.const_i64 as i32] = 'const.i64';
  n[IrOp.const_f32 as i32] = 'const.f32';
  n[IrOp.const_f64 as i32] = 'const.f64';
  n[IrOp.i32_add as i32] = 'i32.add';
  n[IrOp.i32_sub as i32] = 'i32.sub';
  n[IrOp.i32_mul as i32] = 'i32.mul';
  n[IrOp.i32_div_s as i32] = 'i32.div_s';
  n[IrOp.i32_rem_s as i32] = 'i32.rem_s';
  n[IrOp.i32_and as i32] = 'i32.and';
  n[IrOp.i32_or as i32] = 'i32.or';
  n[IrOp.i32_xor as i32] = 'i32.xor';
  n[IrOp.i32_shl as i32] = 'i32.shl';
  n[IrOp.i32_shr_s as i32] = 'i32.shr_s';
  n[IrOp.i32_shr_u as i32] = 'i32.shr_u';
  n[IrOp.i32_eqz as i32] = 'i32.eqz';
  n[IrOp.i32_eq as i32] = 'i32.eq';
  n[IrOp.i32_ne as i32] = 'i32.ne';
  n[IrOp.i32_lt_s as i32] = 'i32.lt_s';
  n[IrOp.i32_le_s as i32] = 'i32.le_s';
  n[IrOp.i32_gt_s as i32] = 'i32.gt_s';
  n[IrOp.i32_ge_s as i32] = 'i32.ge_s';
  n[IrOp.i32_div_u as i32] = 'i32.div_u';
  n[IrOp.i32_rem_u as i32] = 'i32.rem_u';
  n[IrOp.i32_lt_u as i32] = 'i32.lt_u';
  n[IrOp.i32_le_u as i32] = 'i32.le_u';
  n[IrOp.i32_gt_u as i32] = 'i32.gt_u';
  n[IrOp.i32_ge_u as i32] = 'i32.ge_u';
  n[IrOp.i64_add as i32] = 'i64.add';
  n[IrOp.i64_sub as i32] = 'i64.sub';
  n[IrOp.i64_mul as i32] = 'i64.mul';
  n[IrOp.i64_div_s as i32] = 'i64.div_s';
  n[IrOp.i64_rem_s as i32] = 'i64.rem_s';
  n[IrOp.i64_and as i32] = 'i64.and';
  n[IrOp.i64_or as i32] = 'i64.or';
  n[IrOp.i64_xor as i32] = 'i64.xor';
  n[IrOp.i64_shl as i32] = 'i64.shl';
  n[IrOp.i64_shr_s as i32] = 'i64.shr_s';
  n[IrOp.i64_shr_u as i32] = 'i64.shr_u';
  n[IrOp.i64_eq as i32] = 'i64.eq';
  n[IrOp.i64_ne as i32] = 'i64.ne';
  n[IrOp.i64_lt_s as i32] = 'i64.lt_s';
  n[IrOp.i64_le_s as i32] = 'i64.le_s';
  n[IrOp.i64_gt_s as i32] = 'i64.gt_s';
  n[IrOp.i64_ge_s as i32] = 'i64.ge_s';
  n[IrOp.i64_div_u as i32] = 'i64.div_u';
  n[IrOp.i64_rem_u as i32] = 'i64.rem_u';
  n[IrOp.i64_lt_u as i32] = 'i64.lt_u';
  n[IrOp.i64_le_u as i32] = 'i64.le_u';
  n[IrOp.i64_gt_u as i32] = 'i64.gt_u';
  n[IrOp.i64_ge_u as i32] = 'i64.ge_u';
  n[IrOp.f64_add as i32] = 'f64.add';
  n[IrOp.f64_sub as i32] = 'f64.sub';
  n[IrOp.f64_mul as i32] = 'f64.mul';
  n[IrOp.f64_div as i32] = 'f64.div';
  n[IrOp.f64_eq as i32] = 'f64.eq';
  n[IrOp.f64_ne as i32] = 'f64.ne';
  n[IrOp.f64_lt as i32] = 'f64.lt';
  n[IrOp.f64_le as i32] = 'f64.le';
  n[IrOp.f64_gt as i32] = 'f64.gt';
  n[IrOp.f64_ge as i32] = 'f64.ge';
  n[IrOp.f32_add as i32] = 'f32.add';
  n[IrOp.f32_sub as i32] = 'f32.sub';
  n[IrOp.f32_mul as i32] = 'f32.mul';
  n[IrOp.f32_div as i32] = 'f32.div';
  n[IrOp.f32_eq as i32] = 'f32.eq';
  n[IrOp.f32_ne as i32] = 'f32.ne';
  n[IrOp.f32_lt as i32] = 'f32.lt';
  n[IrOp.f32_le as i32] = 'f32.le';
  n[IrOp.f32_gt as i32] = 'f32.gt';
  n[IrOp.f32_ge as i32] = 'f32.ge';
  n[IrOp.i64_eqz as i32] = 'i64.eqz';
  n[IrOp.f64_neg as i32] = 'f64.neg';
  n[IrOp.f32_neg as i32] = 'f32.neg';
  n[IrOp.i32_wrap_i64 as i32] = 'i32.wrap_i64';
  n[IrOp.i64_extend_i32_s as i32] = 'i64.extend_i32_s';
  n[IrOp.f64_convert_i32_s as i32] = 'f64.convert_i32_s';
  n[IrOp.f32_convert_i32_s as i32] = 'f32.convert_i32_s';
  n[IrOp.f64_convert_i64_s as i32] = 'f64.convert_i64_s';
  n[IrOp.f32_convert_i64_s as i32] = 'f32.convert_i64_s';
  n[IrOp.i32_trunc_sat_f64_s as i32] = 'i32.trunc_sat_f64_s';
  n[IrOp.i32_trunc_sat_f32_s as i32] = 'i32.trunc_sat_f32_s';
  n[IrOp.i64_trunc_sat_f64_s as i32] = 'i64.trunc_sat_f64_s';
  n[IrOp.i64_trunc_sat_f32_s as i32] = 'i64.trunc_sat_f32_s';
  n[IrOp.f64_promote_f32 as i32] = 'f64.promote_f32';
  n[IrOp.f32_demote_f64 as i32] = 'f32.demote_f64';
  n[IrOp.i64_reinterpret_f64 as i32] = 'i64.reinterpret_f64';
  n[IrOp.i32_reinterpret_f32 as i32] = 'i32.reinterpret_f32';
  n[IrOp.f32_reinterpret_i32 as i32] = 'f32.reinterpret_i32';
  n[IrOp.f64_reinterpret_i64 as i32] = 'f64.reinterpret_i64';
  n[IrOp.i32_trunc_sat_f32_u as i32] = 'i32.trunc_sat_f32_u';
  n[IrOp.i32_trunc_sat_f64_u as i32] = 'i32.trunc_sat_f64_u';
  n[IrOp.i64_trunc_sat_f32_u as i32] = 'i64.trunc_sat_f32_u';
  n[IrOp.i64_trunc_sat_f64_u as i32] = 'i64.trunc_sat_f64_u';
  n[IrOp.i32_clz as i32] = 'i32.clz';
  n[IrOp.i32_ctz as i32] = 'i32.ctz';
  n[IrOp.i32_popcnt as i32] = 'i32.popcnt';
  n[IrOp.i64_clz as i32] = 'i64.clz';
  n[IrOp.i64_ctz as i32] = 'i64.ctz';
  n[IrOp.i64_popcnt as i32] = 'i64.popcnt';
  n[IrOp.f32_abs as i32] = 'f32.abs';
  n[IrOp.f32_ceil as i32] = 'f32.ceil';
  n[IrOp.f32_floor as i32] = 'f32.floor';
  n[IrOp.f32_nearest as i32] = 'f32.nearest';
  n[IrOp.f32_sqrt as i32] = 'f32.sqrt';
  n[IrOp.f32_trunc as i32] = 'f32.trunc';
  n[IrOp.f64_abs as i32] = 'f64.abs';
  n[IrOp.f64_ceil as i32] = 'f64.ceil';
  n[IrOp.f64_floor as i32] = 'f64.floor';
  n[IrOp.f64_nearest as i32] = 'f64.nearest';
  n[IrOp.f64_sqrt as i32] = 'f64.sqrt';
  n[IrOp.f64_trunc as i32] = 'f64.trunc';
  n[IrOp.f32_min as i32] = 'f32.min';
  n[IrOp.f32_max as i32] = 'f32.max';
  n[IrOp.f32_copysign as i32] = 'f32.copysign';
  n[IrOp.f64_min as i32] = 'f64.min';
  n[IrOp.f64_max as i32] = 'f64.max';
  n[IrOp.f64_copysign as i32] = 'f64.copysign';
  n[IrOp.i32_load as i32] = 'i32.load';
  n[IrOp.i32_load8_u as i32] = 'i32.load8_u';
  n[IrOp.i64_load as i32] = 'i64.load';
  n[IrOp.f32_load as i32] = 'f32.load';
  n[IrOp.f64_load as i32] = 'f64.load';
  n[IrOp.i64_store as i32] = 'i64.store';
  n[IrOp.f32_store as i32] = 'f32.store';
  n[IrOp.f64_store as i32] = 'f64.store';
  n[IrOp.memory_size as i32] = 'memory.size';
  n[IrOp.memory_grow as i32] = 'memory.grow';
  n[IrOp.ref_null as i32] = 'ref.null';
  n[IrOp.ref_is_null as i32] = 'ref.is_null';
  n[IrOp.ref_as_non_null as i32] = 'ref.as_non_null';
  n[IrOp.ref_eq as i32] = 'ref.eq';
  n[IrOp.ref_test as i32] = 'ref.test';
  n[IrOp.ref_cast as i32] = 'ref.cast';
  n[IrOp.ref_func as i32] = 'ref.func';
  n[IrOp.extern_convert_any as i32] = 'extern.convert_any';
  n[IrOp.any_convert_extern as i32] = 'any.convert_extern';
  n[IrOp.i32_store as i32] = 'i32.store';
  n[IrOp.i32_store8 as i32] = 'i32.store8';
  n[IrOp.struct_new as i32] = 'struct.new';
  n[IrOp.struct_new_default as i32] = 'struct.new_default';
  n[IrOp.struct_get as i32] = 'struct.get';
  n[IrOp.struct_set as i32] = 'struct.set';
  n[IrOp.array_new as i32] = 'array.new';
  n[IrOp.array_new_data as i32] = 'array.new_data';
  n[IrOp.array_new_fixed as i32] = 'array.new_fixed';
  n[IrOp.array_get as i32] = 'array.get';
  n[IrOp.array_get_u as i32] = 'array.get_u';
  n[IrOp.array_get_s as i32] = 'array.get_s';
  n[IrOp.array_set as i32] = 'array.set';
  n[IrOp.array_copy as i32] = 'array.copy';
  n[IrOp.array_len as i32] = 'array.len';
  n[IrOp.global_get as i32] = 'global.get';
  n[IrOp.global_set as i32] = 'global.set';
  n[IrOp.var_get as i32] = 'var.get';
  n[IrOp.var_set as i32] = 'var.set';
  n[IrOp.str_lit as i32] = 'str.lit';
  n[IrOp.iface_pack as i32] = 'iface.pack';
  n[IrOp.iface_vtable as i32] = 'iface.vtable';
  n[IrOp.iface_instance as i32] = 'iface.instance';
  n[IrOp.call as i32] = 'call';
  n[IrOp.call_ref as i32] = 'call_ref';
  n[IrOp.mv_get as i32] = 'mv.get';
  n[IrOp.br as i32] = 'br';
  n[IrOp.br_if as i32] = 'br_if';
  n[IrOp.br_table as i32] = 'br_table';
  n[IrOp.br_on_cast as i32] = 'br_on_cast';
  n[IrOp.br_on_cast_fail as i32] = 'br_on_cast_fail';
  n[IrOp.try_br as i32] = 'try_br';
  n[IrOp.ret as i32] = 'ret';
  n[IrOp.ret_multi as i32] = 'ret.multi';
  n[IrOp.throw as i32] = 'throw';
  n[IrOp.unreachable as i32] = 'unreachable';
  n[IrOp.yield_ as i32] = 'yield';
  n[IrOp.await_ as i32] = 'await';
  return n;
};

let irOpNames = buildIrOpNames();

export let irOpName = (op: IrOp): String => {
  let raw = op as i32;
  if (raw >= 0 && raw < irOpNames.length) {
    let name = irOpNames[raw];
    if (name.length > 0) {
      return name;
    }
  }
  return `op#${raw}`;
};
