/**
 * The async split pass (async.md §3).
 *
 * Runs between RTA and layout() (`prepareAsyncFunctions`), alongside
 * the generator split pass whose machinery it shares (generators.zena
 * exports the raw IrBody helpers, liveness, and edge rerouting). Every
 * reached `async` function's body is lowered to presplit ZIR — an
 * ordinary CFG with await_ suspension terminators — and rewritten into
 * two finished IrBodies:
 *
 *  - the RAMP (the async function itself): allocate the frame, spill
 *    the arguments, allocate the frame's `Future<T>`, then — eager
 *    start, §1.1 — call step() straight away so the body runs
 *    synchronously up to the first await, and return the future.
 *  - step(): the state machine, the same dispatcher-loop shape as a
 *    generator's next(), with three differences (§3):
 *      1. Suspensions park rather than yield: `frame.$state = pc`,
 *         register the frame on the awaited future as a `Task`,
 *         and plain-`return`.
 *      2. Resume values are not passed in. The awaited future is an
 *         ordinary value live across the suspension, so it already has
 *         a frame field; the resumed segment reads the settled result
 *         back off it with `valueOrThrow()` (emitted during presplit
 *         lowering). A rejected future therefore resurfaces as an
 *         ordinary throw at the resume point.
 *      3. Returns complete the frame's own future instead of yielding,
 *         and the whole machine sits inside one try_br region whose
 *         catch fails that future. No suspension edge crosses the
 *         region — suspends *return* out of it — so this does not hit
 *         the region-surgery problem user-level try/await would.
 *
 * $state encoding matches generators: 0 = START, 1 = RUNNING,
 * 2 = DONE, 3+k = suspended at await k, with await-containing loop
 * headers taking pc values above the suspend range. RUNNING is never a
 * dispatch target, so a re-entrant step() traps on the dispatcher's
 * fall-through rather than resuming a frame twice.
 *
 * Deviation from §3 worth naming: the design has the frame *be* its
 * `Future<T>` (one allocation). Here the frame *holds* one and
 * *implements* `Task`. Making a synthesized struct a true
 * subclass of the specialized `Future<T>` means inheriting its vtable
 * and layout through RTA; the extra allocation buys that complexity
 * back, and the observable semantics are identical.
 */
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { HashSet } from 'zena:set';
import { Error } from 'zena:error';
import { i32ToString } from 'zena:string-convert';
import {
  ValType, ValTypeI32, ValTypeRef, ValTypeRefNull, WasmType, refTargetOf,
} from '../wasm.zena';
import {
  WasmModule, WasmStruct, WasmField, WasmFunction, WasmGlobal, WasmTag, VTableInit, ClassCodegenInfo,
} from '../wasm-module.zena';
import {
  IrOp, IrBody, IrBlock, IrRefField, IrRefType, IrRefGlobal, IrRefFunc,
  IrRefTag, isIrTerminator,
} from './ir.zena';
import { IrBuilder, valTypesStrictlyEqual } from './builder.zena';
import { IrCfg } from './cfg.zena';
import { FunctionLowerer } from './lowering.zena';
import {
  truncate, replaceContents, internVt, addRawRef, rawInst, placeInst,
  rawParam, computeLiveIn, weakenToNullable, loopContainsSuspend,
  rerouteEdges, TryRegion, dispatchRegionsOf, spillCatchLiveIns,
  varFieldsOf, rewriteVarsToFrame,
} from './generators.zena';
import { ReachabilityAnalysis } from '../reachability/analysis.zena';
import {
  getInterfaceMemberSignature, getClassTypeParameters,
  substituteTypeParamsInCodegen,
} from '../type-mapping.zena';
import {
  ClassKey, ExportKey, getClassKey, getClassMethodKey, getInterfaceKey,
  getInterfaceMemberKey, getClassInterfaceKey, getClassInterfaceVTableName,
  getInterfaceTrampolineName,
} from '../codegen-utils.zena';
import {
  Type, InterfaceType, FunctionType, ClassType, MethodInfo,
} from '../../types.zena';
import { FunctionExpression, MethodDefinition, Node } from '../../ast.zena';

let STATE_RUNNING = 1;
let STATE_DONE = 2;
let STATE_FIRST_SUSPEND = 3;

/** The finished bodies for one async function, keyed by WasmFunction uid. */
final class AsyncArtifacts(rampBody: IrBody, stepBody: IrBody)

/**
 * Prep-time registry: prepareAsyncFunctions fills it, the per-function
 * loop reads it back through lowerAsyncRamp/lowerAsyncStep. Cleared at
 * the start of every prepare so repeated compiles in one process stay
 * independent.
 */
var rampBodies = new HashMap<i32, AsyncArtifacts>();
var stepBodies = new HashMap<i32, AsyncArtifacts>();
/** Bodies of synthesized async-`main` export wrappers, by uid. */
var mainWrapperBodies = new HashMap<i32, IrBody>();

/** True if this WasmFunction carries an `async` AST node. */
export let isAsyncFunction = (func: WasmFunction): boolean => {
  let {node} = func;
  if (node == null) {
    return false;
  }
  return match (node) {
    case FunctionExpression {isAsync}: isAsync
    case MethodDefinition {isAsync}: isAsync
    case _: false
  };
};

let funcDisplayName = (func: WasmFunction): String => {
  if (func.name != null) {
    return func.name as String;
  }
  return 'async function';
};

/**
 * The `Future<T>` instantiation an async function returns, from its
 * checked FunctionType with class/function type arguments substituted
 * (the memoized instantiation object, so class keys match the ones
 * RTA specialized).
 */
let futureInstantiationOf = (wasm: WasmModule, func: WasmFunction): ClassType => {
  let t = func.model.getNodeType(func.node as Node);
  if (t == null || !(t is FunctionType)) {
    throw new Error('async function has no checked function type: ' +
        funcDisplayName(func));
  }
  var ret: Type = t.returnType;
  let {classType} = func;
  if (classType != null) {
    let ct = classType;
    if (ct.typeArguments != null) {
      ret = substituteTypeParamsInCodegen(wasm, 
          getClassTypeParameters(ct), ct.typeArguments, ret);
    }
  }
  if (func.typeParameters != null && func.typeArguments != null) {
    ret = substituteTypeParamsInCodegen(wasm, 
        func.typeParameters, func.typeArguments, ret);
  }
  if (!(ret is ClassType)) {
    throw new Error('async function return type is not Future<T>: ' +
        funcDisplayName(func));
  }
  return ret;
};

/**
 * The `Task` interface, read off `Future<T>.subscribe`'s
 * parameter. Deriving it from the future rather than looking it up by
 * name keeps the pass free of a well-known-type registry: every async
 * function already resolves its own `Future<T>`.
 */
let resumableInterfaceOf = (futureType: ClassType): InterfaceType => {
  if (!futureType.members.has('subscribe')) {
    throw new Error('zena:async Future has no subscribe member');
  }
  let mi = futureType.members['subscribe'];
  if (!(mi is MethodInfo)) {
    throw new Error('subscribe is not a method');
  }
  let ft = mi.type;
  if (!(ft is FunctionType)) {
    throw new Error('subscribe has no function type');
  }
  let params = ft.parameters;
  if (params.length != 1 || !(params[0] is InterfaceType)) {
    throw new Error('subscribe does not take a Task');
  }
  return params[0] as InterfaceType;
};

/** A method of the given specialized class, or a loud failure. */
let methodOf = (
  wasm: WasmModule,
  cKey: ClassKey,
  name: String,
  who: String
): WasmFunction => {
  let key = getClassMethodKey(cKey, name);
  if (let (true, f) = wasm.classMethodMap.get(key)) {
    return f;
  }
  throw new Error('async lowering: ' + (cKey as String) + '.' + name +
      ' was not reached (needed by ' + who + ')');
};

// ---------------------------------------------------------------------------
// The pass driver.
// ---------------------------------------------------------------------------

/**
 * Called by ModuleGenerator between RTA and wasm.layout(): everything
 * an async function needs (frame struct, step() function, Task
 * trampoline and vtable global) must exist before indices lock.
 */
export let prepareAsyncFunctions = (
  wasm: WasmModule,
  pass: ReachabilityAnalysis
): void => {
  rampBodies = new HashMap<i32, AsyncArtifacts>();
  stepBodies = new HashMap<i32, AsyncArtifacts>();
  mainWrapperBodies = new HashMap<i32, IrBody>();
  // Index loop: prepareOne appends step/trampoline functions.
  var i = 0;
  while (i < wasm.functions.length) {
    let func = wasm.functions[i];
    i += 1;
    if (!isAsyncFunction(func)) {
      continue;
    }
    if (func.typeParameters != null && func.typeArguments == null) {
      // Generic template; its specializations are processed instead.
      continue;
    }
    prepareOne(wasm, pass, func, i - 1);
  }
  prepareAsyncMain(wasm, pass);
};

/**
 * Level 0 (async.md §4): an async `main` is exported through a wrapper
 * that starts it, drains the microtask queue to empty, and unwraps the
 * result — so a program whose futures all complete internally runs to
 * completion on any host that can call one export, with no host event
 * loop and no changes to zena-cli.
 *
 * If the queue empties with main's future still pending, nothing can
 * ever complete it. `valueOrThrow()` throws there, naming the
 * deadlock.
 */
let prepareAsyncMain = (wasm: WasmModule, pass: ReachabilityAnalysis): void => {
  let key = 'main' as ExportKey;
  if (!wasm.exportMap.has(key)) {
    return;
  }
  let ramp = wasm.exportMap[key];
  if (!ramp.isAsyncRamp) {
    return;
  }
  let futureType = futureInstantiationOf(wasm, ramp);
  let fKey = getClassKey(futureType);
  let valueOrThrowFn = methodOf(wasm, fKey, ':valueOrThrow', 'async main');
  let drainFn = wasm.getStdlibFunc('zena:async', 'drainMicrotasks');
  if (drainFn == null) {
    throw new Error('async main: zena:async drainMicrotasks was not reached');
  }

  let wrapperSig = wasm.getSignature(ramp.signature.params,
      valueOrThrowFn.signature.returns);
  let wrapper = new WasmFunction(wrapperSig, null, ramp.model);
  wrapper.name = 'main$asyncEntry';
  wrapper.isAsyncMainWrapper = true;
  wasm.addFunction(wrapper);
  pass.markFunctionReached(wrapper);

  let b = new IrBuilder();
  let entry = b.newBlock();
  let params = new Array<i32>();
  for (let vt in ramp.signature.params) {
    params.push(b.blockParam(entry, vt));
  }
  b.switchTo(entry);
  let futVt = if (ramp.signature.returns.length == 1) {
    ramp.signature.returns[0]
  } else {
    throw new Error('async main: ramp does not return its future')
  };
  let fut = b.callFunc(b.addRef(new IrRefFunc(ramp)), params, futVt);
  b.callFunc(b.addRef(new IrRefFunc(drainFn)), new Array<i32>(0), null);
  let unwrapArgs = new Array<i32>();
  unwrapArgs.push(fut);
  if (valueOrThrowFn.signature.returns.length == 0) {
    b.callFunc(b.addRef(new IrRefFunc(valueOrThrowFn)), unwrapArgs, null);
    b.retVoid();
  } else {
    let value = b.callFunc(b.addRef(new IrRefFunc(valueOrThrowFn)),
        unwrapArgs, valueOrThrowFn.signature.returns[0]);
    b.ret(value);
  }
  mainWrapperBodies[wrapper.uid] = b.finish();

  // The export now names the wrapper; the ramp stays an ordinary
  // internal function that other code can still call directly.
  wasm.exportMap[key] = wrapper;

  buildHostEntry(wasm, pass, ramp, valueOrThrowFn, drainFn, futVtOf(ramp));
};

/** The future type the ramp returns. */
let futVtOf = (ramp: WasmFunction): ValType => {
  if (ramp.signature.returns.length != 1) {
    throw new Error('async main: ramp does not return its future');
  }
  return ramp.signature.returns[0];
};

/**
 * The split entry a host that cannot wait needs (async.md §4).
 *
 * `main` above starts the body, drains, and unwraps in one call, which
 * works wherever the clock can genuinely wait — the drain simply never
 * unwinds, so by the time it returns the future has settled. A host
 * that cannot wait unwinds the drain early, and unwrapping there would
 * hit `valueOrThrow`'s deadlock case even though the program is fine
 * and merely waiting on a timer.
 *
 * So such a host uses two calls instead of one: `$asyncMainStart` runs
 * the body as far as it can and parks the future in a global, then —
 * after `$asyncDrain` pings have carried it to completion —
 * `$asyncMainResult` unwraps it. Neither needs a branch, which is why
 * this is two functions rather than one with an `isCompleted` test.
 *
 * `main` is left exactly as it was, so WASI and zena-cli are unaffected
 * and a standalone `wasmtime --invoke main` still runs to completion.
 */
let buildHostEntry = (
  wasm: WasmModule,
  pass: ReachabilityAnalysis,
  ramp: WasmFunction,
  valueOrThrowFn: WasmFunction,
  drainFn: WasmFunction,
  futVt: ValType
): void => {
  // The in-flight future, so the two halves can find each other.
  let slot = new WasmGlobal('$asyncMainFuture', '$asyncMainFuture',
      futVt, true, null, null, ramp.model);
  wasm.globals.push(slot);
  let slotRef = new IrRefGlobal(slot);

  // $asyncMainStart(params...) -> void
  let startSig = wasm.getSignature(ramp.signature.params, new Array<ValType>(0));
  let startFn = new WasmFunction(startSig, null, ramp.model);
  startFn.name = 'main$asyncStart';
  startFn.isAsyncMainWrapper = true;
  wasm.addFunction(startFn);
  pass.markFunctionReached(startFn);

  let sb = new IrBuilder();
  let sEntry = sb.newBlock();
  let sParams = new Array<i32>();
  for (let vt in ramp.signature.params) {
    sParams.push(sb.blockParam(sEntry, vt));
  }
  sb.switchTo(sEntry);
  let started = sb.callFunc(sb.addRef(new IrRefFunc(ramp)), sParams, futVt);
  sb.emitVoid(IrOp.global_set, started, sb.addRef(slotRef));
  sb.callFunc(sb.addRef(new IrRefFunc(drainFn)), new Array<i32>(0), null);
  sb.retVoid();
  mainWrapperBodies[startFn.uid] = sb.finish();
  wasm.asyncMainStartFunc = startFn;

  // $asyncMainResult() -> T
  let resultSig = wasm.getSignature(new Array<ValType>(0),
      valueOrThrowFn.signature.returns);
  let resultFn = new WasmFunction(resultSig, null, ramp.model);
  resultFn.name = 'main$asyncResult';
  resultFn.isAsyncMainWrapper = true;
  wasm.addFunction(resultFn);
  pass.markFunctionReached(resultFn);

  let rb = new IrBuilder();
  let rEntry = rb.newBlock();
  rb.switchTo(rEntry);
  let stored = rb.emit(IrOp.global_get, futVt, -1, rb.addRef(slotRef));
  let rArgs = new Array<i32>();
  rArgs.push(stored);
  if (valueOrThrowFn.signature.returns.length == 0) {
    rb.callFunc(rb.addRef(new IrRefFunc(valueOrThrowFn)), rArgs, null);
    rb.retVoid();
  } else {
    let v = rb.callFunc(rb.addRef(new IrRefFunc(valueOrThrowFn)), rArgs,
        valueOrThrowFn.signature.returns[0]);
    rb.ret(v);
  }
  mainWrapperBodies[resultFn.uid] = rb.finish();
  wasm.asyncMainResultFunc = resultFn;
};

export let lowerAsyncMainWrapper = (
  wasm: WasmModule,
  func: WasmFunction
): IrBody => {
  if (let (true, body) = mainWrapperBodies.get(func.uid)) {
    return body;
  }
  throw new Error('async main wrapper was not prepared');
};

export let lowerAsyncRamp = (wasm: WasmModule, func: WasmFunction): IrBody => {
  if (let (true, art) = rampBodies.get(func.uid)) {
    return art.rampBody;
  }
  throw new Error('async function was not prepared (split pass did not run): ' +
      funcDisplayName(func));
};

export let lowerAsyncStep = (wasm: WasmModule, func: WasmFunction): IrBody => {
  if (let (true, art) = stepBodies.get(func.uid)) {
    return art.stepBody;
  }
  throw new Error('async step() was not prepared: ' + funcDisplayName(func));
};

let prepareOne = (
  wasm: WasmModule,
  pass: ReachabilityAnalysis,
  func: WasmFunction,
  funcIndex: i32
): void => {
  // Async closures need no special handling, for the same reason
  // generator closures do not: the context struct arrives as param 0
  // of the ramp and is spilled to a frame field like any other param.

  let futureType = futureInstantiationOf(wasm, func);
  pass.typeLowerer.discoverType(futureType as Type, func.model);
  let fKey = getClassKey(futureType);
  let futureInfo =
      if (let (true, info) = wasm.classInfos.get(fKey)) info else null;
  if (futureInfo == null) {
    throw new Error('async Future instantiation was not materialized: ' +
        funcDisplayName(func));
  }
  let futureStruct = futureInfo.structType;

  let name = funcDisplayName(func);
  let completeFn = methodOf(wasm, fKey, ':complete', name);
  let failFn = methodOf(wasm, fKey, ':fail', name);
  let futureCtor = methodOf(wasm, fKey, '<constructor>', name);
  // `complete(this, value: T)` is where the value type comes from.
  // `Future<void>` (async.md §8 question 1) needs nothing special here:
  // `void` is a zero-width type argument, so `complete` specializes to
  // the receiver alone and valueVt falls out null — exactly the "no
  // value slot" case presplitAsyncValueVt already describes.
  let valueVt = if (completeFn.signature.params.length > 1) {
    completeFn.signature.params[1]
  } else {
    null
  };

  if (wasm.exceptionTag == null || wasm.exceptionPayload == null) {
    // step()'s failure-capture region needs the exception infra; the
    // checker marks every async function as requiring it.
    throw new Error('async lowering: exception infrastructure missing for ' +
        name);
  }

  // Presplit lowering: the body as an ordinary CFG with await_
  // terminators. A bail inside an async body is a hard error
  // (ZirUnsupported propagates; there is no fallback backend).
  let fl = new FunctionLowerer(wasm, func);
  fl.presplitAsync = true;
  fl.presplitAsyncValueVt = valueVt;
  let presplit = fl.lower();
  let subscribeOf = fl.awaitSubscribeTargets;
  let hopTerms = fl.awaitHopTerms;
  // A union await's bare arm parks the frame directly on the queue
  // (async.md §1); the stdlib entry for that is only linked when a
  // program contains one.
  var scheduleFn: WasmFunction | null = null;
  if (hopTerms.size > 0) {
    let scheduleOpt = wasm.getStdlibFunc('zena:async', 'scheduleTask');
    if (scheduleOpt == null) {
      throw new Error('async lowering: zena:async scheduleTask was not ' +
          'reached (needed by a union await in ' + name + ')');
    }
    scheduleFn = scheduleOpt;
  }
  let cfg = new IrCfg(presplit);

  // Suspension analysis on the pristine CFG.
  let awaitBlocks = new Array<i32>();
  let resumeOf = new Array<i32>();
  var bi = 0;
  while (bi < presplit.blocks.length) {
    let insts = presplit.blocks[bi].insts;
    if (insts.length > 0) {
      let term = insts[insts.length - 1];
      if (presplit.op(term) == IrOp.await_) {
        awaitBlocks.push(bi);
        resumeOf.push(presplit.successors(term)[0].target);
      }
    }
    bi += 1;
  }

  // pc assignment: resume blocks get their suspend-state value;
  // await-containing loop headers get values above the suspend range.
  let pcOfBlock = new HashMap<i32, i32>();
  var ai = 0;
  while (ai < resumeOf.length) {
    pcOfBlock[resumeOf[ai]] = STATE_FIRST_SUSPEND + ai;
    ai += 1;
  }
  var nextPc = STATE_FIRST_SUSPEND + resumeOf.length;
  var hb = 0;
  while (hb < presplit.blocks.length) {
    if (cfg.isReachable(hb) && !pcOfBlock.has(hb) && hb != 0 &&
        loopContainsSuspend(presplit, cfg, hb, awaitBlocks)) {
      pcOfBlock[hb] = nextPc;
      nextPc += 1;
    }
    hb += 1;
  }

  // Which user try regions enclose each dispatch target (async.md §6).
  let dispatchRegions = dispatchRegionsOf(presplit, cfg, pcOfBlock);

  let liveIn = computeLiveIn(presplit, cfg);

  // Spill set: everything live into a dispatch target, every dispatch
  // target's block params, and every function parameter.
  let spilled = new HashSet<i32>();
  let entryParamIds = new Array<i32>();
  for (let p in presplit.blocks[0].params) {
    entryParamIds.push(p);
    spilled.add(p);
  }
  let dTargets = new Array<i32>();
  dTargets.push(0);
  var db = 0;
  while (db < presplit.blocks.length) {
    if (pcOfBlock.has(db)) {
      dTargets.push(db);
      for (let v in liveIn[db]) {
        spilled.add(v);
      }
      for (let p in presplit.blocks[db].params) {
        spilled.add(p);
      }
    }
    db += 1;
  }
  for (let v in liveIn[0]) {
    spilled.add(v);
  }
  spillCatchLiveIns(liveIn, dispatchRegions, spilled);

  // The frame struct: $state, the frame's own future, then one
  // nullable-weakened field per spilled value, ascending value id.
  let fields = new Array<WasmField>();
  fields.push(new WasmField('$state', new ValTypeI32(), true));
  fields.push(new WasmField('$future',
      new ValTypeRefNull(futureStruct), true));
  var vid = 0;
  while (vid < presplit.instCount()) {
    if (spilled.has(vid)) {
      let vt = presplit.resultType(vid);
      if (vt == null) {
        throw new Error('async spill of valueless instruction');
      }
      fields.push(new WasmField('$v' + i32ToString(vid),
          weakenToNullable(vt), true));
    }
    vid += 1;
  }
  varFieldsOf(presplit, fields);
  let frameName = name + '$' + i32ToString(funcIndex) + '$AsyncFrame';
  let frame = new WasmStruct(frameName, fields);
  wasm.types.push(frame);
  pass.markTypeReached(frame);

  // step(): (ref null $Frame) -> ().
  let stepParams = new Array<ValType>();
  stepParams.push(new ValTypeRefNull(frame));
  let stepSig = wasm.getSignature(stepParams, new Array<ValType>(0));
  let stepFunc = new WasmFunction(stepSig, null, func.model);
  stepFunc.name = frameName + '.step';
  stepFunc.isAsyncStep = true;
  wasm.addFunction(stepFunc);
  pass.markFunctionReached(stepFunc);

  // The frame implements Task: run() steps the machine. One
  // vtable per frame, whatever the function awaits.
  let iface = resumableInterfaceOf(futureType);
  pass.typeLowerer.discoverType(iface as Type, func.model);
  let iKey = getInterfaceKey(iface);
  if (!wasm.interfaceStructs.has(iKey) ||
      !wasm.interfaceVTableStructs.has(iKey)) {
    throw new Error('async Task interface was not materialized: ' + name);
  }
  let fatPtr = wasm.interfaceStructs[iKey];
  let vst = wasm.interfaceVTableStructs[iKey];
  wasm.usedInterfaceMembers[getInterfaceMemberKey(iKey, 'run')] = true;
  let slotSig = getInterfaceMemberSignature(wasm, iface, 'run');

  let frameKey = frameName as ClassKey;
  let methods = new Array<WasmFunction>();
  for (let field in vst.fields) {
    if ((field.name as String) != 'run') {
      throw new Error('unexpected Task vtable member: ' +
          (field.name as String));
    }
    let tramp = new WasmFunction(slotSig, null, func.model);
    tramp.name = getInterfaceTrampolineName(frameKey, iKey, 'run');
    tramp.interfaceTrampolineTarget = stepFunc;
    wasm.addFunction(tramp);
    pass.markFunctionReached(tramp);
    methods.push(tramp);
  }
  let vtableInit = new VTableInit(vst, methods);
  let viName = getClassInterfaceVTableName(frameKey, iKey);
  let vtableGlobal = new WasmGlobal(
    viName,
    viName,
    new ValTypeRef(vst),
    false,
    null,
    vtableInit,
    func.model
  );
  wasm.globals.push(vtableGlobal);
  wasm.classInterfaceVTables[getClassInterfaceKey(frameKey, iKey)] = vtableGlobal;
  wasm.usedInterfaceAdaptations[getClassInterfaceKey(frameKey, iKey)] = true;
  let unspecIKey = getInterfaceKey(iface.genericSource ?? iface);
  wasm.usedInterfaceAdaptations[getClassInterfaceKey(frameKey, unspecIKey)] = true;

  // The two bodies.
  let rampBody = buildRamp(func, frame, futureInfo, futureCtor, stepFunc,
      entryParamIds);
  let stepBody = buildStepBody(presplit, cfg, frame, futureStruct, spilled,
      pcOfBlock, dTargets, subscribeOf, hopTerms, scheduleFn, completeFn,
      failFn, valueVt, fatPtr, vtableGlobal, wasm.exceptionTag as WasmTag,
      wasm.exceptionPayload as WasmGlobal, dispatchRegions);
  let artifacts = new AsyncArtifacts(rampBody, stepBody);
  func.isAsyncRamp = true;
  rampBodies[func.uid] = artifacts;
  stepBodies[stepFunc.uid] = artifacts;
};

/**
 * ramp: allocate the frame, spill the arguments, allocate the frame's
 * future, then run the first segment eagerly (§1.1) and hand back the
 * future.
 */
let buildRamp = (
  func: WasmFunction,
  frame: WasmStruct,
  futureInfo: ClassCodegenInfo,
  futureCtor: WasmFunction,
  stepFunc: WasmFunction,
  entryParamIds: Array<i32>
): IrBody => {
  let b = new IrBuilder();
  let entry = b.newBlock();
  let params = new Array<i32>();
  for (let vt in func.signature.params) {
    params.push(b.blockParam(entry, vt));
  }
  b.switchTo(entry);
  let frameRef = b.addRef(new IrRefType(frame));
  let inst = b.emit(IrOp.struct_new_default, new ValTypeRef(frame), -1, frameRef);
  // $state defaults to 0 == START via struct.new_default.
  var i = 0;
  while (i < params.length) {
    let fieldRef = b.addRef(new IrRefField(frame,
        '$v' + i32ToString(entryParamIds[i])));
    let pair = new Array<i32>();
    pair.push(inst);
    pair.push(params[i]);
    b.emitVoid(IrOp.struct_set, b.pushExtra(pair), fieldRef);
    i += 1;
  }

  // The frame's own Future<T>: one factory call, the same shape
  // `new Future<T>()` lowers to.
  let futureStruct = futureInfo.structType;
  let futVt: ValType = new ValTypeRef(futureStruct);
  let fut = b.callFunc(b.addRef(new IrRefFunc(futureCtor)),
      new Array<i32>(), futVt);

  let futField = b.addRef(new IrRefField(frame, '$future'));
  let futPair = new Array<i32>();
  futPair.push(inst);
  futPair.push(fut);
  b.emitVoid(IrOp.struct_set, b.pushExtra(futPair), futField);

  // Eager start: the body runs synchronously up to the first await.
  let stepArgs = new Array<i32>();
  stepArgs.push(inst);
  b.callFunc(b.addRef(new IrRefFunc(stepFunc)), stepArgs, null);

  b.ret(fut);
  return b.finish();
};

// ---------------------------------------------------------------------------
// The state-machine transform: mutates the presplit body in place into
// the step() body.
// ---------------------------------------------------------------------------

let buildStepBody = (
  body: IrBody,
  cfg: IrCfg,
  frame: WasmStruct,
  futureStruct: WasmStruct,
  spilled: HashSet<i32>,
  pcOfBlockIn: HashMap<i32, i32>,
  dTargetsIn: Array<i32>,
  subscribeOf: HashMap<i32, WasmFunction>,
  hopTerms: HashSet<i32>,
  scheduleFn: WasmFunction | null,
  completeFn: WasmFunction,
  failFn: WasmFunction,
  valueVt: ValType | null,
  fatPtr: WasmStruct,
  vtableGlobal: WasmGlobal,
  exceptionTag: WasmTag,
  exceptionPayload: WasmGlobal,
  dispatchRegions: HashMap<i32, Array<TryRegion>>
): IrBody => {
  let origCount = body.blocks.length;
  let stateRef = addRawRef(body, new IrRefField(frame, '$state'));
  let futureRef = addRawRef(body, new IrRefField(frame, '$future'));
  let i32Vt: ValType = new ValTypeI32();

  // Snapshot the dispatch targets' params (cleared below; edges into
  // them turn into frame stores).
  let dParams = new HashMap<i32, Array<i32>>();
  for (let d in dTargetsIn) {
    let copy = new Array<i32>();
    for (let p in body.blocks[d].params) {
      copy.push(p);
    }
    dParams[d] = copy;
  }

  // 1. Evacuate the old entry into a fresh block E; block 0 becomes
  // the prologue head (the function's real entry: one frame param).
  let entryCopy = new IrBlock();
  let oldEntry = body.blocks[0];
  body.blocks.push(entryCopy);
  let entryCopyId = body.blocks.length - 1;
  for (let p in oldEntry.params) {
    entryCopy.params.push(p);
    body.instBlock[p] = entryCopyId;
  }
  for (let inst in oldEntry.insts) {
    entryCopy.insts.push(inst);
    body.instBlock[inst] = entryCopyId;
  }
  body.blocks[0] = new IrBlock();

  // Dispatch-target bookkeeping with entry remapped to its new id.
  let pcOfBlock = new HashMap<i32, i32>();
  pcOfBlock[entryCopyId] = 0;
  for (let d in dTargetsIn) {
    if (d == 0) {
      continue;
    }
    pcOfBlock[d] = pcOfBlockIn[d];
  }
  let dParamsById = new HashMap<i32, Array<i32>>();
  for (let d in dTargetsIn) {
    let mapped = if (d == 0) { entryCopyId } else { d };
    dParamsById[mapped] = dParams[d];
  }

  // 2. Prologue: the failure-capture region, the DONE guard, and the
  // dispatcher loop.
  let frameParam = rawParam(body, 0, new ValTypeRefNull(frame));

  let newBlockId = (): i32 => {
    body.blocks.push(new IrBlock());
    return body.blocks.length - 1;
  };
  let tryBody = newBlockId();
  let catchBlock = newBlockId();
  let doneBlock = newBlockId();
  let enterBlock = newBlockId();
  let trapBlock = newBlockId();
  let dispatcher = newBlockId();

  let emitIn = (blockId: i32, op: IrOp, typeIdx: i32, a: i32, b: i32): i32 => {
    let inst = rawInst(body, op, typeIdx, a, b);
    placeInst(body, blockId, inst);
    return inst;
  };
  let brTo = (fromBlock: i32, target: i32, args: Array<i32>): void => {
    let idx = body.extra.length;
    body.extra.push(target);
    body.extra.push(args.length);
    for (let v in args) {
      body.extra.push(v);
    }
    let inst = rawInst(body, IrOp.br, -1, idx, -1);
    placeInst(body, fromBlock, inst);
  };
  let brIfTo = (fromBlock: i32, cond: i32, thenTarget: i32, elseTarget: i32): void => {
    let idx = body.extra.length;
    body.extra.push(thenTarget);
    body.extra.push(0);
    body.extra.push(elseTarget);
    body.extra.push(0);
    let inst = rawInst(body, IrOp.br_if, -1, cond, idx);
    placeInst(body, fromBlock, inst);
  };
  let storeState = (blockId: i32, valueInst: i32): void => {
    let idx = body.extra.length;
    body.extra.push(frameParam);
    body.extra.push(valueInst);
    let inst = rawInst(body, IrOp.struct_set, -1, idx, stateRef);
    placeInst(body, blockId, inst);
  };
  let retVoidIn = (blockId: i32): void => {
    let inst = rawInst(body, IrOp.ret, -1, -1, -1);
    placeInst(body, blockId, inst);
  };
  /** frame.$future, re-asserted non-null for the call boundary. */
  let loadFuture = (blockId: i32): i32 => {
    let weak = emitIn(blockId, IrOp.struct_get,
        internVt(body, new ValTypeRefNull(futureStruct)), frameParam, futureRef);
    return emitIn(blockId, IrOp.ref_as_non_null,
        internVt(body, new ValTypeRef(futureStruct)), weak, -1);
  };
  let callIn = (blockId: i32, target: WasmFunction, args: Array<i32>): void => {
    let idx = body.extra.length;
    body.extra.push(args.length);
    for (let v in args) {
      body.extra.push(v);
    }
    let inst = rawInst(body, IrOp.call, -1, idx,
        addRawRef(body, new IrRefFunc(target)));
    placeInst(body, blockId, inst);
  };

  let i32Idx = internVt(body, i32Vt);

  // b0: enter the failure-capture region. Every suspension and every
  // completion RETURNS from inside it, so the region stays properly
  // nested (§3) — nothing branches out of it.
  let tryIdx = body.extra.length;
  body.extra.push(tryBody);
  body.extra.push(0);
  body.extra.push(catchBlock);
  body.extra.push(0);
  let tryInst = rawInst(body, IrOp.try_br, -1,
      addRawRef(body, new IrRefTag(exceptionTag)), tryIdx);
  placeInst(body, 0, tryInst);

  // tryBody: state = frame.$state; already DONE ? return : enter.
  let stateVal = emitIn(tryBody, IrOp.struct_get, i32Idx, frameParam, stateRef);
  let doneConst = emitIn(tryBody, IrOp.const_i32, i32Idx, STATE_DONE, -1);
  let isDone = emitIn(tryBody, IrOp.i32_eq, i32Idx, stateVal, doneConst);
  brIfTo(tryBody, isDone, doneBlock, enterBlock);

  // done: the future has already settled; nothing left to run.
  retVoidIn(doneBlock);

  // enter: $state = RUNNING, then dispatch on the state we loaded.
  // RUNNING is never a dispatch pc, so a re-entrant step() falls
  // through the chain into the trap instead of resuming twice.
  let runningConst = emitIn(enterBlock, IrOp.const_i32, i32Idx, STATE_RUNNING, -1);
  storeState(enterBlock, runningConst);
  let dispatchArgs = new Array<i32>();
  dispatchArgs.push(stateVal);
  brTo(enterBlock, dispatcher, dispatchArgs);

  // trap: an impossible state.
  let trapInst = rawInst(body, IrOp.unreachable, -1, -1, -1);
  placeInst(body, trapBlock, trapInst);

  // catch: the body threw. Fail the frame's own future with the caught
  // error and finish — this is the whole of async error handling (§3).
  let payloadVt = exceptionPayload.type;
  var payload = emitIn(catchBlock, IrOp.global_get, internVt(body, payloadVt),
      -1, addRawRef(body, new IrRefGlobal(exceptionPayload)));
  if (payloadVt is ValTypeRefNull) {
    let target = refTargetOf(payloadVt) as WasmType;
    payload = emitIn(catchBlock, IrOp.ref_as_non_null,
        internVt(body, new ValTypeRef(target)), payload, -1);
  }
  let doneC = emitIn(catchBlock, IrOp.const_i32, i32Idx, STATE_DONE, -1);
  storeState(catchBlock, doneC);
  let failFut = loadFuture(catchBlock);
  let failArgs = new Array<i32>();
  failArgs.push(failFut);
  failArgs.push(payload);
  callIn(catchBlock, failFn, failArgs);
  retVoidIn(catchBlock);

  /**
   * Re-enters the user `try` regions enclosing a dispatch target, and
   * returns the block the dispatcher should branch to (async.md §6).
   *
   * The dispatcher lives outside every user region, so branching
   * straight at the target would leave the segment it heads
   * unprotected — the region silently shrinks to exclude it, and a
   * failure raised there sails past the handler the user wrote.
   * Instead each enclosing region is re-entered through a fresh
   * `try_br` whose catch is that region's own handler, innermost last,
   * so the segment runs at the same protection depth the source put it
   * at.
   *
   * Applies to every dispatch target, not only resume blocks. A
   * suspending loop's header is a dispatch target too, and its
   * protection is not implied by the resume blocks inside it: a resume
   * block's fresh try_br covers what that block dominates, which is the
   * rest of that iteration after the await, but not the stretch from
   * the header down to the await.
   *
   * This is §6's construction with one simplification: §6 threads the
   * pc through the region's ORIGINAL try_br into a small inner
   * dispatcher. Re-entering through fresh try_brs needs no inner
   * dispatcher, no pc threading across a region edge, and no splitting
   * of the block that holds the original try_br — and the region it
   * builds is exactly the same one, because a region's extent is the
   * dominator subtree of its body target and a dispatch target inside a
   * try body dominates precisely the part of that body it heads.
   */
  let reenterRegions = (dispatchTarget: i32): i32 => {
    let regions =
        if (let (true, rs) = dispatchRegions.get(dispatchTarget)) rs
        else new Array<TryRegion>(0);
    var target = dispatchTarget;
    // Innermost first, so the outermost try_br ends up on the outside.
    var ri = regions.length - 1;
    while (ri >= 0) {
      let r = regions[ri];
      let t = newBlockId();
      let idx = body.extra.length;
      body.extra.push(target);
      body.extra.push(0);
      body.extra.push(r.catchTarget);
      body.extra.push(0);
      let inst = rawInst(body, IrOp.try_br, -1, r.tagRef, idx);
      placeInst(body, t, inst);
      target = t;
      ri -= 1;
    }
    return target;
  };

  // dispatcher(pc): br_if chain over the dispatch targets, ascending
  // pc. The final fall-through is an invalid state — trap.
  let pcParam = rawParam(body, dispatcher, i32Vt);
  let chainTargets = new Array<i32>();
  let chainPcs = new Array<i32>();
  chainTargets.push(entryCopyId);
  chainPcs.push(0);
  var scanPc = STATE_FIRST_SUSPEND;
  var remaining = pcOfBlock.size - 1;
  while (remaining > 0) {
    var found = -1;
    var fb = 0;
    while (fb < body.blocks.length) {
      if (pcOfBlock.has(fb) && pcOfBlock[fb] == scanPc) {
        found = fb;
        break;
      }
      fb += 1;
    }
    if (found >= 0) {
      chainTargets.push(reenterRegions(found));
      chainPcs.push(scanPc);
      remaining -= 1;
    }
    scanPc += 1;
  }
  var chainBlock = dispatcher;
  var ci = 0;
  while (ci < chainTargets.length) {
    let cmpConst = emitIn(chainBlock, IrOp.const_i32, i32Idx, chainPcs[ci], -1);
    let cmp = emitIn(chainBlock, IrOp.i32_eq, i32Idx, pcParam, cmpConst);
    let elseBlock = if (ci == chainTargets.length - 1) { trapBlock } else { newBlockId() };
    brIfTo(chainBlock, cmp, chainTargets[ci], elseBlock);
    chainBlock = elseBlock;
    ci += 1;
  }

  // The body blocks the remaining passes operate on.
  let bodyBlocks = new Array<i32>();
  bodyBlocks.push(entryCopyId);
  var obi = 1;
  while (obi < origCount) {
    bodyBlocks.push(obi);
    obi += 1;
  }

  // 3. Reroute every edge into a dispatch target through the
  // dispatcher, converting its branch args into frame stores.
  for (let blockId in bodyBlocks) {
    rerouteEdges(body, blockId, pcOfBlock, dParamsById, dispatcher,
        frameParam, frame, i32Idx, entryCopyId);
  }
  for (let d in dTargetsIn) {
    let mapped = if (d == 0) { entryCopyId } else { d };
    truncate(body.blocks[mapped].params);
  }

  // 4. Store every spilled definition to its frame field.
  let skipRemap = new HashSet<i32>();
  for (let blockId in bodyBlocks) {
    let block = body.blocks[blockId];
    let rebuilt = new Array<i32>();
    for (let p in block.params) {
      if (spilled.has(p)) {
        let idx = body.extra.length;
        body.extra.push(frameParam);
        body.extra.push(p);
        let st = rawInst(body, IrOp.struct_set, -1, idx,
            addRawRef(body, new IrRefField(frame, '$v' + i32ToString(p))));
        skipRemap.add(st);
        rebuilt.push(st);
        body.instBlock[st] = blockId;
      }
    }
    for (let inst in block.insts) {
      rebuilt.push(inst);
      if (spilled.has(inst) && !isIrTerminator(body.op(inst))) {
        let idx = body.extra.length;
        body.extra.push(frameParam);
        body.extra.push(inst);
        let st = rawInst(body, IrOp.struct_set, -1, idx,
            addRawRef(body, new IrRefField(frame, '$v' + i32ToString(inst))));
        skipRemap.add(st);
        rebuilt.push(st);
        body.instBlock[st] = blockId;
      }
    }
    replaceContents(block.insts, rebuilt);
  }

  // 5. Load every use of a spilled value from its frame field,
  // immediately before the use.
  for (let blockId in bodyBlocks) {
    let block = body.blocks[blockId];
    let rebuilt = new Array<i32>();
    let ops = new Array<i32>();
    for (let inst in block.insts) {
      if (skipRemap.has(inst)) {
        rebuilt.push(inst);
        continue;
      }
      truncate(ops);
      body.appendValueOperands(inst, ops);
      let loadOf = new HashMap<i32, i32>();
      for (let v in ops) {
        if (spilled.has(v) && !loadOf.has(v)) {
          let vt = body.resultType(v) as ValType;
          let weak = weakenToNullable(vt);
          var load = rawInst(body, IrOp.struct_get, internVt(body, weak),
              frameParam,
              addRawRef(body, new IrRefField(frame, '$v' + i32ToString(v))));
          rebuilt.push(load);
          body.instBlock[load] = blockId;
          if (!valTypesStrictlyEqual(weak, vt)) {
            load = rawInst(body, IrOp.ref_as_non_null, internVt(body, vt),
                load, -1);
            rebuilt.push(load);
            body.instBlock[load] = blockId;
          }
          loadOf[v] = load;
        }
      }
      if (loadOf.size > 0) {
        body.rewriteValueOperands(inst, (v: i32) => {
          if (let (true, l) = loadOf.get(v)) {
            return l;
          }
          return v;
        });
      }
      rebuilt.push(inst);
    }
    replaceContents(block.insts, rebuilt);
  }

  // 6. Rewrite suspensions and completions.
  for (let blockId in bodyBlocks) {
    let block = body.blocks[blockId];
    if (block.insts.length == 0) {
      continue;
    }
    let term = block.insts[block.insts.length - 1];
    let op = body.op(term);
    if (op == IrOp.await_) {
      let resumeTarget = body.successors(term)[0].target;
      let pc = pcOfBlock[resumeTarget];
      let futureVal = body.a[term];
      let isHop = hopTerms.has(term);
      let subscribeOpt =
          if (let (true, s) = subscribeOf.get(term)) s else null;
      if (subscribeOpt == null && !isHop) {
        throw new Error('async split: await site without a subscribe target');
      }
      let rebuilt = new Array<i32>();
      var k = 0;
      while (k < block.insts.length - 1) {
        rebuilt.push(block.insts[k]);
        k += 1;
      }
      // $state = the resume pc.
      let pcConst = rawInst(body, IrOp.const_i32, i32Idx, pc, -1);
      rebuilt.push(pcConst);
      body.instBlock[pcConst] = blockId;
      let stIdx = body.extra.length;
      body.extra.push(frameParam);
      body.extra.push(pcConst);
      let st = rawInst(body, IrOp.struct_set, -1, stIdx, stateRef);
      rebuilt.push(st);
      body.instBlock[st] = blockId;
      // Park this frame as a Task: on the awaited future (the library
      // schedules it when the future settles — or immediately, if it
      // already had), or, for a union await's bare arm, directly on
      // the microtask queue — the value needs no completion, only the
      // one hop the always-async rule requires.
      let self = rawInst(body, IrOp.ref_as_non_null,
          internVt(body, new ValTypeRef(frame)), frameParam, -1);
      rebuilt.push(self);
      body.instBlock[self] = blockId;
      let packed = rawInst(body, IrOp.iface_pack,
          internVt(body, new ValTypeRef(fatPtr)), self,
          addRawRef(body, new IrRefGlobal(vtableGlobal)));
      rebuilt.push(packed);
      body.instBlock[packed] = blockId;
      let callIdx = body.extra.length;
      if (isHop) {
        body.extra.push(1);
        body.extra.push(packed);
      } else {
        body.extra.push(2);
        body.extra.push(futureVal);
        body.extra.push(packed);
      }
      let callee = if (isHop) {
        scheduleFn as WasmFunction
      } else {
        subscribeOpt as WasmFunction
      };
      let call = rawInst(body, IrOp.call, -1, callIdx,
          addRawRef(body, new IrRefFunc(callee)));
      rebuilt.push(call);
      body.instBlock[call] = blockId;
      // The suspension itself: a plain return out of the region.
      body.opcode[term] = IrOp.ret as i32;
      body.a[term] = -1;
      body.b[term] = -1;
      rebuilt.push(term);
      replaceContents(block.insts, rebuilt);
    } else if (op == IrOp.ret) {
      // A return (or falling off a Future<void> body) completes the
      // frame's own future and finishes the machine.
      let retVal = body.a[term];
      let rebuilt = new Array<i32>();
      var k = 0;
      while (k < block.insts.length - 1) {
        rebuilt.push(block.insts[k]);
        k += 1;
      }
      let dC = rawInst(body, IrOp.const_i32, i32Idx, STATE_DONE, -1);
      rebuilt.push(dC);
      body.instBlock[dC] = blockId;
      let stIdx = body.extra.length;
      body.extra.push(frameParam);
      body.extra.push(dC);
      let st = rawInst(body, IrOp.struct_set, -1, stIdx, stateRef);
      rebuilt.push(st);
      body.instBlock[st] = blockId;
      let weakFut = rawInst(body, IrOp.struct_get,
          internVt(body, new ValTypeRefNull(futureStruct)), frameParam,
          futureRef);
      rebuilt.push(weakFut);
      body.instBlock[weakFut] = blockId;
      let fut = rawInst(body, IrOp.ref_as_non_null,
          internVt(body, new ValTypeRef(futureStruct)), weakFut, -1);
      rebuilt.push(fut);
      body.instBlock[fut] = blockId;
      let callIdx = body.extra.length;
      if (valueVt == null) {
        body.extra.push(1);
        body.extra.push(fut);
      } else {
        if (retVal < 0) {
          throw new Error('async split: valued future completed without a value');
        }
        body.extra.push(2);
        body.extra.push(fut);
        body.extra.push(retVal);
      }
      let call = rawInst(body, IrOp.call, -1, callIdx,
          addRawRef(body, new IrRefFunc(completeFn)));
      rebuilt.push(call);
      body.instBlock[call] = blockId;
      body.a[term] = -1;
      body.b[term] = -1;
      rebuilt.push(term);
      replaceContents(block.insts, rebuilt);
    }
  }

  // 7. Mutable variables move into the frame; their wasm locals would
  // not survive a suspension.
  rewriteVarsToFrame(body, bodyBlocks, frame, frameParam);

  return body;
};
