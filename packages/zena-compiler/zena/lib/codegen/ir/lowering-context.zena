/**
 * The single shared surface that split-out lowering modules see.
 * FunctionLowerer cannot be imported by them (import cycle with
 * lowering.zena), so the mutually-recursive core arrives as closures,
 * while the builder, module, and function are direct fields. Every
 * split module shares THIS type — a new module extends it with more
 * closures rather than minting its own context (ir/intrinsics.zena
 * predates this and keeps its narrower IntrinsicCx).
 */
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { HashSet } from 'zena:set';
import { String } from 'zena:string';
import { Error } from 'zena:error';
import {
  AssignmentExpression, BinaryExpression, BindingPattern, CallExpression,
  Expression, FunctionExpression, Identifier, IdentifierPattern,
  IndexExpression, MemberExpression, Node, Statement,
  ThrowExpression, VariableDeclaration,
} from '../../ast.zena';
import {
  ClassType, InterfaceType, NullType, RecordType, ThisType, Type,
  UnionType, baseType,
} from '../../types.zena';
import {
  ValType, ValTypeAnyRef, ValTypeEqRef, ValTypeF32, ValTypeF64,
  ValTypeI32, ValTypeI64, ValTypeRef, ValTypeRefNull, ValTypeStructRef,
  isRefValType,
} from '../wasm.zena';
import {
  substituteTypeParamsInFunctionContext, typeToValTypeWithSub,
} from '../type-mapping.zena';
import { IrOp } from './ir.zena';
import {
  WasmModule, WasmFunction, WasmSignature, ClassCodegenInfo,
  RecordDispatchInfo, WasmField, WasmGlobal, WasmStruct, asWasmSignature,
  asWasmStruct, isValSubtype,
  valTypeIdentical,
  sortWasmFields,
} from '../wasm-module.zena';
import { valTypeEquals } from '../wasm.zena';
import { getCellKey, getCellStruct } from '../type-mapping.zena';
import {
  getClassInterfaceKey, getClassKey, getClassMethodKey, getInterfaceKey,
} from '../codegen-utils.zena';
import { IrRefField, IrRefFunc, IrRefGlobal, IrRefType } from './ir.zena';
import { IrBuilder } from './builder.zena';
import { Symbol, SymbolId } from '../../scope/symbol.zena';
import { walkEnter } from '../../visitor.zena';
// Imported back across the module cycle: lowering.zena imports this
// module (docs/design/import-cycles.md).
import { FunctionLowerer, lowerExpr } from './lowering.zena';

/**
 * Thrown when lowering meets a construct it does not model; the
 * compile fails with the offending function named (see lowerFunction).
 * States the checker guarantees impossible are NOT ZirUnsupported —
 * throw a plain Error for those. (Defined here rather than in
 * lowering.zena so split modules can throw it without an import
 * cycle.)
 */
export final class ZirUnsupported extends Error {
  new(reason: String) : super('zir unsupported: ' + reason);
}

/** One loop's break/continue targets and carried symbols. */
export final class LoopCtx {
  /** Where `continue` jumps: the header for while, the update block for for. */
  continueTarget: i32;
  exit: i32;
  carried: Array<SymbolId>;
  new(this.continueTarget, this.exit, this.carried);
}

/**
 * The lazily-materialized join point of a value-producing control-flow
 * expression (if/try/match) or a merging statement. Arms br to it with
 * the tracked symbols' current values (plus the arm's result in value
 * position); it exists only once some arm actually reaches it.
 */
export final class MergeState {
  syms: Array<SymbolId>;
  isVoid: boolean;
  resultVt: ValType | null;
  var block = -1;
  var params: Array<i32> | null = null;
  var resultParam = -1;
  new(this.syms, this.isVoid, this.resultVt);
}

/** A lowered let-condition: the flag plus bindings to apply in the
 * SUCCESS block only — coercing an exhausted iterator's null payload
 * would trap if emitted before the flag branch. */
export final class LetCondBinds {
  cond: i32;
  syms: Array<Symbol>;
  values: Array<i32>;
  vts: Array<ValType>;
  /** Nested destructuring elements, tested/bound in the taken block. */
  patterns: Array<Node>;
  patternValues: Array<i32>;
  new(this.cond, this.syms, this.values, this.vts, this.patterns,
      this.patternValues);
}

export final class LoweringContext {
  b: IrBuilder;
  wasm: WasmModule;
  func: WasmFunction;
  // ---- Mutable per-function lowering state (single-homed HERE; the
  // coordinator and every split module read and write the same
  // instance). SSA construction is the structured-AST form: `env`
  // maps each variable symbol to its current value.
  var env = new HashMap<SymbolId, i32>();
  /** Symbols behind env entries, for binding-type lookups at merges. */
  symbols = new HashMap<SymbolId, Symbol>();
  loops = new Array<LoopCtx>();
  /** Values piped by enclosing |> expressions; $ reads the top. */
  pipelineValues = new Array<i32>();
  /**
   * Values known to be EXACTLY their class (freshly constructed by
   * struct.new in this function, or a singleton global). A method
   * call on an exact receiver never needs the vtable, even when
   * subclasses override the slot — no subclass instance can be here.
   * Merges, cells, and casts produce new ids, so exactness is
   * conservatively local.
   */
  exactValues = new HashSet<i32>();
  var reachable = true;
  /** The receiver value for instance methods; -1 elsewhere. */
  var thisValue = -1;
  /**
   * The owning FunctionLowerer (the coordinator in lowering.zena,
   * named here across the import cycle's back edge). Assigned when
   * the coordinator builds its context.
   */
  var host: FunctionLowerer | null = null;

  new(this.b, this.wasm, this.func);

  /**
   * ZIR's conformance gate: isValSubtype, EXCEPT nullable never
   * conforms to non-null. The shared isValSubtype inherits streaming's
   * nullability-loose valTypeEquals shortcut (streaming declares ref
   * locals nullable and re-casts at uses); ZIR types values exactly,
   * so the loose shortcut would silently skip required narrowing.
   */
  refConforms(have: ValType, want: ValType): boolean {
    if (have is ValTypeRefNull && want is ValTypeRef) {
      return false;
    }
    return isValSubtype(have, want);
  }

  /** Throws ZirUnsupported; the i32 never arrives (value positions). */
  fail(reason: String): i32 {
    throw new ZirUnsupported(reason + ' @' + (this.func.name ?? '?'));
  }

  /** The storage ValType of an already-lowered value. */
  valueTypeOf(value: i32): ValType {
    return this.b.body.typeTable[this.b.body.typeId[value]];
  }

  /**
   * Re-asserts non-nullness when the checked type is non-null but the
   * value's storage type is nullable with the same heap target. Other
   * shape differences pass through unchanged — downstream subtype
   * checks bail on actual misuse.
   */
  reassertNonNull(value: i32, want: ValType): i32 {
    let have = this.valueTypeOf(value);
    if (want is ValTypeRef && have is ValTypeRefNull &&
        (want as ValTypeRef).target == (have as ValTypeRefNull).target) {
      return this.b.emit(IrOp.ref_as_non_null, want, value, -1);
    }
    return value;
  }

  /** ref.as_non_null when the value's own storage type is nullable. */
  stripNonNull(value: i32): i32 {
    let vt = this.valueTypeOf(value);
    return if (vt is ValTypeRefNull) {
      this.reassertNonNull(
          value, new ValTypeRef((vt as ValTypeRefNull).target) as ValType)
    } else {
      value
    };
  }

  /** Types values may HAVE in the lowered subset (see lowering docs). */
  requireSupported(vt: ValType, what: String): void {
    let ok = vt is ValTypeI32 || vt is ValTypeI64 || vt is ValTypeF32 ||
        vt is ValTypeF64 || vt is ValTypeRef || vt is ValTypeRefNull ||
        vt is ValTypeAnyRef || vt is ValTypeEqRef || vt is ValTypeStructRef;
    if (!ok) {
      this.fail(what);
    }
  }

  /** The expression's own checked type, substituted and supported. */
  exprVt(expr: Expression): ValType {
    let t = this.func.model.getNodeType(expr);
    if (t == null) {
      this.fail('untyped expression');
    }
    let vt = typeToValTypeWithSub(this.wasm, t as Type, this.func);
    this.requireSupported(vt, 'expression type');
    return vt;
  }

  /** The checked semantic type, substituted; null when untyped. */
  substitutedNodeType(expr: Expression): Type | null {
    let t = this.func.model.getNodeType(expr);
    if (t == null) {
      return null;
    }
    return substituteTypeParamsInFunctionContext(this.wasm, this.func, t as Type);
  }

  /**
   * Value-conformance failure: a lowered value does not satisfy the
   * type its consumer requires. A scalar flowing into an any/eqref
   * context would need auto-boxing, which ZIR deliberately does not
   * implement — that case bails under its own permanent name so the
   * histogram tracks it.
   */
  failConformance(value: i32, want: ValType, reason: String): void {
    let vt = this.valueTypeOf(value);
    if (!isRefValType(vt) &&
        (want is ValTypeAnyRef || want is ValTypeEqRef)) {
      this.fail('auto-box to any');
    }
    this.fail(reason);
  }

  /** The receiver/callee expression of an optional-chain access. */
  optionalChainObject(expr: Expression): Expression {
    if (expr is MemberExpression) {
      return (expr as MemberExpression).object;
    }
    if (expr is IndexExpression) {
      return (expr as IndexExpression).object;
    }
    return (expr as CallExpression).callee;
  }

  /** Packs a class instance value into `it`'s fat pointer. */
  packInterface(value: i32, ct: ClassType, it: InterfaceType): i32 {
    let iName = getInterfaceKey(it);
    let key = getClassInterfaceKey(getClassKey(ct), iName);
    let vtOpt = this.wasm.getClassInterfaceVTable(key);
    if (vtOpt == null) {
      this.fail('interface vtable global not found');
    }
    let fatPtrOpt = if (let (true, st) = this.wasm.interfaceStructs.get(iName)) st else null;
    if (fatPtrOpt == null) {
      this.fail('interface struct not found');
    }
    let fatPtr = fatPtrOpt as WasmStruct;
    let globalRef = this.b.addRef(new IrRefGlobal(vtOpt as WasmGlobal));
    return this.b.emit(IrOp.iface_pack, new ValTypeRef(fatPtr) as ValType,
        value, globalRef);
  }

  /**
   * Maps ThisType (and the checker's `<Name>_This` marker classes) to
   * the enclosing method's concrete class.
   */
  resolveSelfType(t: Type): Type {
    let bt = baseType(t);
    var isSelf = bt is ThisType;
    if (!isSelf && bt is ClassType) {
      let ct = bt as ClassType;
      if (ct.name.length >= 5 &&
          ct.name.sliceBytes(ct.name.length - 5, ct.name.length) == "_This") {
        isSelf = true;
      }
    }
    if (isSelf) {
      if (this.func.classType == null) {
        this.fail('self type outside method');
      }
      return this.func.classType as Type;
    }
    return bt;
  }

  /**
   * Dispatches a receiver-only interface method through the vtable of
   * an already-lowered fat-pointer VALUE. The fat pointer's own struct
   * type names the vtable struct, so no InterfaceType resolution is
   * needed past whatever produced the value — the :iterator slot's
   * signature hands the loop the Iterator fat-pointer type for free.
   * Returns the call's result values (empty for void).
   */
  slotCallOnValue(recv: i32, memberName: String): Array<i32> {
    let fatOpt = asWasmStruct(this.valueTypeOf(recv));
    if (fatOpt == null || (fatOpt as WasmStruct).fields.length != 2) {
      this.fail('interface receiver type');
    }
    let fatPtr = fatOpt as WasmStruct;
    let vstOpt = asWasmStruct(fatPtr.fields[1].type);
    if (vstOpt == null) {
      this.fail('interface receiver type');
    }
    let vst = vstOpt as WasmStruct;
    let slot = vst.fieldIndexByName(memberName);
    if (slot < 0) {
      this.fail('interface member not in vtable');
    }
    let sigOpt = asWasmSignature(vst.fields[slot].type);
    if (sigOpt == null) {
      this.fail('interface slot shape');
    }
    let sig = sigOpt as WasmSignature;
    if (sig.params.length != 1) {
      this.fail('interface call arity adaptation');
    }
    let inst = this.b.emit(
        IrOp.iface_instance, fatPtr.fields[0].type, recv, -1);
    if (!isValSubtype(this.valueTypeOf(inst), sig.params[0])) {
      this.failConformance(inst, sig.params[0], 'interface receiver adaptation');
    }
    let vt = this.b.emit(IrOp.iface_vtable, fatPtr.fields[1].type, recv, -1);
    let fieldRef = this.b.addRef(new IrRefField(vst, memberName));
    let callee = this.b.emit(
        IrOp.struct_get, vst.fields[slot].type, vt, fieldRef);
    for (let r in sig.returns) {
      this.requireSupported(r, 'interface result type');
    }
    let args = oneValue(inst);
    if (sig.returns.length > 1) {
      return this.b.callRefMulti(callee, args, sig.returns);
    }
    let resultType = if (sig.returns.length == 1) sig.returns[0] else null;
    let result = this.b.callRef(callee, args, resultType);
    let out = new Array<i32>();
    if (resultType != null) {
      out.push(result);
    }
    return out;
  }

  /** #slotCallOnValue for members returning exactly one value. */
  slotCallSingle(recv: i32, memberName: String): i32 {
    let results = this.slotCallOnValue(recv, memberName);
    if (results.length != 1) {
      this.fail('interface slot shape');
    }
    return results[0];
  }

  /** #slotCallOnValue for members with multi-value returns. */
  slotCallMulti(recv: i32, memberName: String): Array<i32> {
    return this.slotCallOnValue(recv, memberName);
  }

  /**
   * The receiver of an optional chain, WITHOUT the checked-type
   * re-assert: the checker narrows the receiver non-null at the
   * access node (it must be accessible to type the chain), but the
   * whole point of `?.` is that the runtime value may be null — the
   * re-assert would trap before the null test. Identifier and
   * global receivers read raw; other expressions produce their own
   * (nullable) values.
   */
  chainReceiver(obj: Expression): i32 {
    if (obj is Identifier) {
      let sym = this.func.model.resolve(obj as Identifier);
      if (sym != null) {
        let resolved = (sym as Symbol).resolveTarget();
        if (this.env.has(resolved.id)) {
          var value = this.env[resolved.id];
          if (this.isCelled(resolved.id)) {
            value = this.cellRead(value);
          }
          return value;
        }
        if (let (true, g) = this.wasm.globalMap.get(resolved.id)) {
          let globalRef = this.b.addRef(new IrRefGlobal(g));
          return this.b.emit(IrOp.global_get, g.type, -1, globalRef);
        }
      }
    }
    return lowerExpr(this, obj, null);
  }

  /**
   * The ClassType a lowered receiver value actually carries: struct
   * types remember their class. This beats re-deriving the class from
   * checked node types, which name the GENERIC class inside
   * specialized-method bodies (same authoritative-source principle as
   * the closure-identity fix).
   */
  classTypeOfValue(value: i32): ClassType | null {
    let st = asWasmStruct(this.valueTypeOf(value));
    if (st != null) {
      return (st as WasmStruct).classType;
    }
    return null;
  }

  /** The generic-source root's key: specializations compare equal to
   * their template through this. */
  canonicalKeyOf(ct: ClassType): String {
    var c = ct;
    while (c.genericSource != null) {
      c = c.genericSource as ClassType;
    }
    return getClassKey(c) as String;
  }

  /** Resolves a method on ct (walking supers/generic sources) only
   * when no transitive subclass overrides it: a direct call stands
   * in for virtual dispatch. */
  resolveDevirtualizedMethod(ct: ClassType, methName: String): WasmFunction | null {
    var found: WasmFunction | null = null;
    var c: ClassType | null = ct;
    while (c != null) {
      var g: ClassType | null = c;
      while (g != null) {
        let key = getClassMethodKey(getClassKey(g), methName);
        if (let (true, m) = this.wasm.classMethodMap.get(key)) {
          found = m;
          break;
        }
        g = g.genericSource;
      }
      if (found != null) {
        break;
      }
      c = c.superType;
    }
    if (found == null) {
      return null;
    }
    var infoOpt: ClassCodegenInfo | null = null;
    if (let (true, info) = this.wasm.classInfos.get(getClassKey(ct))) {
      infoOpt = info;
    }
    if (infoOpt != null &&
        this.memberProvidedBySubclass(infoOpt as ClassCodegenInfo, methName)) {
      return null;
    }
    return found;
  }

  /**
   * True if a transitive subclass provides an accessor for `slotName`
   * that actually differs from a direct field read.
   *
   * Every class carrying a physical field gets a *synthesized* default
   * accessor — a `ref.cast` plus `struct.get` on its own struct. A
   * subclass that merely inherits the field therefore has a `get#x`
   * entry of its own, and `memberProvidedBySubclass` counts it, which
   * forced `obj.field` to dispatch through the vtable on every read
   * whenever the receiver's class had any subclass at all. That cost
   * ~59x on the FieldAccessVirtual benchmark against a direct
   * `struct.get`.
   *
   * A synthesized accessor for the *same* field is not an override:
   * wasm-gc struct subtyping puts the inherited field at the same
   * index, so reading it off the receiver's struct is exactly what the
   * subclass accessor would have done. Only a hand-written accessor,
   * or a synthesized one bound to a different field, needs dispatch.
   */
  accessorOverriddenBySubclass(classInfo: ClassCodegenInfo, slotName: String,
      fieldName: String): boolean {
    let subclasses = new Array<ClassCodegenInfo>();
    classInfo.getTransitiveSubclasses(subclasses);
    for (let sub in subclasses) {
      let subClassType = sub.structType.classType;
      if (subClassType != null) {
        let key = getClassMethodKey(getClassKey(subClassType as ClassType), slotName);
        if (let (true, f) = this.wasm.classMethodMap.get(key)) {
          let isGetter = slotName.startsWith("get#");
          let st = if (isGetter) f.getterStruct else f.setterStruct;
          let idx = if (isGetter) f.getterFieldIndex else f.setterFieldIndex;
          if (st == null || idx < 0) {
            // Hand-written accessor: a real override.
            return true;
          }
          let fields = (st as WasmStruct).fields;
          if (idx >= fields.length || fields[idx].name != fieldName) {
            // Synthesized, but bound to a different field.
            return true;
          }
          // Same name is not enough: require the same slot. wasm-gc
          // subtyping keeps inherited fields at their supertype index,
          // so an index that moved means the subclass redeclared the
          // field rather than inheriting it, and a direct read off the
          // receiver's struct would target the wrong slot.
          if (idx != classInfo.structType.fieldIndexByName(fieldName)) {
            return true;
          }
          // Synthesized accessor for the same field: equivalent to a
          // direct read, so it does not force dispatch.
        }
      }
    }
    return false;
  }

  /** True if any transitive subclass provides its own `methodName`. */
  memberProvidedBySubclass(classInfo: ClassCodegenInfo, methodName: String): boolean {
    let subclasses = new Array<ClassCodegenInfo>();
    classInfo.getTransitiveSubclasses(subclasses);
    for (let sub in subclasses) {
      let subClassType = sub.structType.classType;
      if (subClassType != null) {
        let key = getClassMethodKey(getClassKey(subClassType as ClassType), methodName);
        if (this.wasm.classMethodMap.has(key)) {
          return true;
        }
      }
    }
    return false;
  }

  /**
   * Whether the receiver class's vtable struct carries `slotName` —
   * the precondition for virtual dispatch through it.
   */
  vtableSlotIndex(classInfo: ClassCodegenInfo, slotName: String): i32 {
    let vtOpt = classInfo.vtableStructType;
    if (vtOpt == null) {
      return -1;
    }
    return (vtOpt as WasmStruct).fieldIndexByName(slotName);
  }

  /**
   * Virtual dispatch through the class vtable: load the receiver's
   * `<vtable>` field, cast to the class's vtable struct, load the
   * named slot, cast to the resolved method's exact signature, and
   * call_ref — streaming's shape. The slot signature is the STATIC
   * class's resolved method signature; overrides conform to it via
   * the vtable-init adapters.
   */
  lowerVtableCall(receiver: i32, classInfo: ClassCodegenInfo,
      slotName: String, sig: WasmSignature, args: Array<i32>,
      resultType: ValType | null): i32 {
    let structType = classInfo.structType;
    let vtStruct = classInfo.vtableStructType as WasmStruct;
    let vtFieldVt = this.fieldValType(structType, '<vtable>');
    let vtRaw = this.b.emit(IrOp.struct_get, vtFieldVt, receiver,
        this.b.addRef(new IrRefField(structType, '<vtable>')));
    var vt = vtRaw;
    let wantVtVt: ValType = new ValTypeRef(vtStruct);
    if (!isValSubtype(this.valueTypeOf(vtRaw), new ValTypeRefNull(vtStruct) as ValType)) {
      vt = this.b.emit(IrOp.ref_cast, wantVtVt, vtRaw,
          this.b.internType(wantVtVt));
    } else {
      vt = this.reassertNonNull(vtRaw, wantVtVt);
    }
    let slotVt = this.fieldValType(vtStruct, slotName);
    let slotRaw = this.b.emit(IrOp.struct_get, slotVt, vt,
        this.b.addRef(new IrRefField(vtStruct, slotName)));
    let sigVt: ValType = new ValTypeRef(sig);
    let slot = this.b.emit(IrOp.ref_cast, sigVt, slotRaw,
        this.b.internType(sigVt));
    return this.b.callRef(slot, args, resultType);
  }

  fieldValType(owner: WasmStruct, name: String): ValType {
    let idx = owner.fieldIndexByName(name);
    if (idx < 0) {
      this.fail('field not found on struct');
    }
    return owner.fields[idx].type;
  }

  /** A record property read through an already-known dispatch. */
  recordDispatchRead(dispatch: RecordDispatchInfo, propName: String,
      receiver: i32): i32 {
    var fieldIdx = -1;
    for (var i = 0; i < dispatch.fields.length; i += 1) {
      let f = dispatch.fields[i];
      if (f.name != null && (f.name as String) == propName) {
        fieldIdx = i;
      }
    }
    if (fieldIdx < 0) {
      this.fail('record member not found');
    }
    let recv = this.stripNonNull(receiver);
    let instance = this.b.emit(IrOp.iface_instance,
        new ValTypeStructRef() as ValType, recv, -1);
    let vtable = this.b.emit(IrOp.iface_vtable,
        new ValTypeRef(dispatch.vtableType) as ValType, recv, -1);
    let getterSig = dispatch.getterTypes[fieldIdx];
    if (getterSig.returns.length != 1) {
      this.fail('record getter shape');
    }
    let getter = this.b.emit(IrOp.struct_get,
        new ValTypeRef(getterSig) as ValType, vtable,
        this.b.addRef(new IrRefField(dispatch.vtableType, propName)));
    return this.b.callRef(getter, oneValue(instance), getterSig.returns[0]);
  }

  /**
   * A class field/getter read by name on an already-lowered receiver
   * value: physical field first, else a registered non-static getter
   * up the super chain.
   */
  objectPropertyRead(propName: String, receiver: i32): i32 {
    let stOpt = asWasmStruct(this.valueTypeOf(receiver));
    if (stOpt == null) {
      this.fail('destructuring source kind');
    }
    let st = stOpt as WasmStruct;
    if (st.fieldIndexByName(propName) >= 0) {
      let fieldRef = this.b.addRef(new IrRefField(st, propName));
      return this.b.emit(IrOp.struct_get,
          this.fieldValType(st, propName), receiver, fieldRef);
    }
    let ctOpt = this.classTypeOfValue(receiver);
    if (ctOpt == null) {
      this.fail('destructuring source kind');
    }
    var getterOpt: WasmFunction | null = null;
    var currClass: ClassType | null = ctOpt as ClassType;
    while (currClass != null && getterOpt == null) {
      let key = getClassMethodKey(
          getClassKey(currClass as ClassType), 'get#' + propName);
      if (let (true, g) = this.wasm.classMethodMap.get(key)) {
        getterOpt = g;
      }
      currClass = (currClass as ClassType).superType;
    }
    if (getterOpt == null || (getterOpt as WasmFunction).isStatic) {
      this.fail('member not found');
    }
    let getter = getterOpt as WasmFunction;
    let sig = getter.signature;
    if (sig.returns.length != 1) {
      this.fail('getter shape');
    }
    return this.b.callFunc(this.b.addRef(new IrRefFunc(getter)),
        oneValue(receiver), sig.returns[0]);
  }

  /**
   * Identity compares see through fat pointers: a record or interface
   * value becomes its eq-typed instance (field 0); everything else
   * passes through unchanged.
   */
  unwrapFatPointer(base: Type, value: i32): i32 {
    if (base is RecordType) {
      let dispatch = this.recordDispatchOf(base as RecordType);
      return this.fatPointerInstance(dispatch.fatPtrType, value);
    }
    if (base is InterfaceType) {
      let iName = getInterfaceKey(base as InterfaceType);
      let fatOpt = if (let (true, st) = this.wasm.interfaceStructs.get(iName)) st else null;
      if (fatOpt == null) {
        this.fail('interface struct not found');
      }
      return this.fatPointerInstance(fatOpt as WasmStruct, value);
    }
    if (base is UnionType) {
      // A nullable fat pointer (`Shape | null`) unwraps behind a null
      // guard: null stays null and compares like any null reference.
      let ut = base as UnionType;
      var nonNull: Type | null = null;
      var nonNullCount = 0;
      var nullCount = 0;
      for (let m in ut.types) {
        if (m is NullType) {
          nullCount += 1;
        } else {
          nonNull = m;
          nonNullCount += 1;
        }
      }
      if (nonNullCount != 1 || nullCount == 0) {
        return value;
      }
      let inner = baseType(nonNull as Type);
      var fatOpt: WasmStruct | null = null;
      if (inner is RecordType) {
        fatOpt = this.recordDispatchOf(inner as RecordType).fatPtrType;
      } else if (inner is InterfaceType) {
        let iName = getInterfaceKey(inner as InterfaceType);
        if (let (true, st) = this.wasm.interfaceStructs.get(iName)) {
          fatOpt = st;
        }
      }
      if (fatOpt == null) {
        return value;
      }
      let eqVt = new ValTypeEqRef() as ValType;
      let isNull = this.b.emit(IrOp.ref_is_null, new ValTypeI32(), value, -1);
      let extractB = this.b.newBlock();
      let merge = this.b.newBlock();
      let result = this.b.blockParam(merge, eqVt);
      let nullEq = this.b.emit(IrOp.ref_null, eqVt, -1, -1);
      this.b.brIf(isNull, merge, oneValue(nullEq),
          extractB, noValues());
      this.b.switchTo(extractB);
      let inst = this.fatPointerInstance(fatOpt as WasmStruct, value);
      this.b.br(merge, oneValue(inst));
      this.b.switchTo(merge);
      return result;
    }
    return value;
  }

  fatPointerInstance(fatPtr: WasmStruct, value: i32): i32 {
    let fatVt = new ValTypeRef(fatPtr) as ValType;
    var v = value;
    if (!isValSubtype(this.valueTypeOf(v), fatVt)) {
      v = this.b.emit(IrOp.ref_cast, fatVt, v, this.b.internType(fatVt));
    }
    let inst = this.b.emit(IrOp.iface_instance,
        fatPtr.fields[0].type, v, -1);
    let eqVt = new ValTypeEqRef() as ValType;
    if (this.valueTypeOf(inst) is ValTypeAnyRef) {
      return this.b.emit(IrOp.ref_cast, eqVt, inst, this.b.internType(eqVt));
    }
    return inst;
  }

  /**
   * The record dispatch registered for a record type's (sorted) field
   * shape. Discovery registers every checked record shape, so a miss
   * means the type never reached discovery — bail.
   */
  recordDispatchOf(rt: RecordType): RecordDispatchInfo {
    let fields = new Array<WasmField>();
    for (let pair in rt.properties) {
      fields.push(new WasmField(pair.key,
          typeToValTypeWithSub(this.wasm, pair.value, this.func), false));
    }
    sortWasmFields(fields);
    let infoOpt = this.wasm.findRecordDispatch(fields);
    if (infoOpt == null) {
      this.fail('record shape not discovered');
    }
    return infoOpt as RecordDispatchInfo;
  }

  /**
   * Direct call to a class operator member: a (+) b as a.+(b).
   * Resolves against the left VALUE's class when known (mirrors
   * method calls); the given checked class is the fallback.
   */
  operatorMemberOn(opMember: String, left: i32, right: i32,
      leftCt: ClassType): i32 {
    let fromValue = this.classTypeOfValue(left);
    let recvCt = if (fromValue != null) fromValue as ClassType else leftCt;
    let methodOpt = this.resolveDevirtualizedMethod(recvCt, opMember);
    if (methodOpt != null) {
      let method = methodOpt as WasmFunction;
      let sig = method.signature;
      if (sig.params.length != 2 || sig.returns.length != 1) {
        this.fail('operator method shape');
      }
      let recv = this.coerceTo(left, sig.params[0]);
      let arg = this.coerceTo(right, sig.params[1]);
      let funcRef = this.b.addRef(new IrRefFunc(method));
      let args = new Array<i32>();
      args.push(recv);
      args.push(arg);
      return this.b.callFunc(funcRef, args, sig.returns[0]);
    }
    // Overridden operators dispatch through the class vtable like any
    // other overridden method (member-lookup.md §5.5 — operators fold
    // into method resolution). The slot signature is the statically
    // resolved member's.
    var resolvedOpt: WasmFunction | null = null;
    var currClass: ClassType | null = recvCt;
    while (currClass != null && resolvedOpt == null) {
      var g: ClassType | null = currClass;
      while (g != null && resolvedOpt == null) {
        let key = getClassMethodKey(getClassKey(g as ClassType), opMember);
        if (let (true, m) = this.wasm.classMethodMap.get(key)) {
          resolvedOpt = m;
        }
        g = (g as ClassType).genericSource;
      }
      currClass = (currClass as ClassType).superType;
    }
    if (resolvedOpt == null) {
      this.fail('operator dispatch');
    }
    let resolvedM = resolvedOpt as WasmFunction;
    let vsig = resolvedM.signature;
    if (vsig.params.length != 2 || vsig.returns.length != 1) {
      this.fail('operator method shape');
    }
    let infoOpt = if (let (true, info) = this.wasm.classInfos.get(getClassKey(recvCt))) info else null;
    if (infoOpt == null) {
      this.fail('operator dispatch');
    }
    let classInfo = infoOpt as ClassCodegenInfo;
    if (this.vtableSlotIndex(classInfo, opMember) < 0) {
      this.fail('operator dispatch');
    }
    let vrecv = this.coerceTo(left, vsig.params[0]);
    let varg = this.coerceTo(right, vsig.params[1]);
    let vargs = new Array<i32>();
    vargs.push(vrecv);
    vargs.push(varg);
    return this.lowerVtableCall(vrecv, classInfo, opMember, vsig,
        vargs, vsig.returns[0]);
  }

  /** Symbols assigned anywhere inside `node` that are locals in scope. */
  assignedEnvSyms(node: Node): Array<SymbolId> {
    let result = new Array<SymbolId>();
    this.appendAssignedEnvSyms(node, result);
    return result;
  }

  appendAssignedEnvSyms(node: Node, out: Array<SymbolId>): void {
    let seen = new HashSet<SymbolId>();
    for (let existing in out) {
      seen.add(existing);
    }
    walkEnter(node, (n: Node): void => {
      if (n is AssignmentExpression) {
        let ae = n as AssignmentExpression;
        if (ae.left is Identifier) {
          let sym = this.func.model.resolve(ae.left);
          if (sym != null) {
            let resolved = (sym as Symbol).resolveTarget();
            // Celled bindings mutate their heap cell, not the env
            // entry, so they never need merge parameters.
            if (this.env.has(resolved.id) && !seen.has(resolved.id) &&
                !this.isCelled(resolved.id)) {
              seen.add(resolved.id);
              out.push(resolved.id);
              this.symbols[resolved.id] = resolved;
            }
          }
        }
      }
    });
  }

  coerceTo(value: i32, target: ValType): i32 {
    let vt = this.valueTypeOf(value);
    if (this.refConforms(vt, target)) {
      return value;
    }
    let nonNull = this.b.emit(IrOp.ref_as_non_null, this.nonNullOf(vt), value, -1);
    if (!isValSubtype(this.valueTypeOf(nonNull), target)) {
      this.failConformance(nonNull, target, 'intrinsic operand type');
    }
    return nonNull;
  }

  nonNullOf(vt: ValType): ValType {
    return match (vt) {
      case ValTypeRefNull as rn: new ValTypeRef(rn.target) as ValType
      case _: vt
    };
  }

  /**
   * Call-boundary conformance: argument and constructor-field slots
   * accept a strictly-wider ref value via a downcast, exactly like
   * stores into bindings (the parameter IS the callee's binding);
   * anything else stays a loud bail.
   */
  conformToSlot(value: i32, want: ValType, reason: String): i32 {
    let have = this.valueTypeOf(value);
    if (this.refConforms(have, want)) {
      return value;
    }
    // A nullable value whose non-null form already conforms: the
    // checker proved this use non-null; re-assert (a null here traps,
    // which is the re-assert contract everywhere else too).
    if (have is ValTypeRefNull && want is ValTypeRef) {
      let nn = new ValTypeRef((have as ValTypeRefNull).target) as ValType;
      if (isValSubtype(nn, want)) {
        return this.b.emit(IrOp.ref_as_non_null, nn, value, -1);
      }
    }
    if (!isRefValType(have) || !isValSubtype(want, have)) {
      this.failConformance(value, want, reason);
    }
    return this.b.emit(IrOp.ref_cast, want, value, this.b.internType(want));
  }

  conformToBinding(value: i32, bindingVt: ValType): i32 {
    let have = this.valueTypeOf(value);
    if (this.refConforms(have, bindingVt)) {
      return value;
    }
    if (have is ValTypeRefNull && bindingVt is ValTypeRef) {
      // Nullable value into a non-null binding: the checker proved
      // this init non-null; re-assert (same-target) or cast down.
      let nn = new ValTypeRef((have as ValTypeRefNull).target) as ValType;
      if (isValSubtype(nn, bindingVt)) {
        return this.reassertNonNull(value, nn);
      }
    }
    if (isRefValType(have) && isValSubtype(bindingVt, have)) {
      return this.b.emit(IrOp.ref_cast, bindingVt, value,
          this.b.internType(bindingVt));
    }
    return this.fail('binding value type');
  }

  bindPatternSym(sym: Symbol, value: i32): void {
    let bindingType = this.func.model.getBindingType(sym);
    if (bindingType == null) {
      this.fail('untyped match binding');
    }
    let bindingVt = typeToValTypeWithSub(this.wasm, bindingType as Type, this.func);
    this.requireSupported(bindingVt, 'match binding type');
    var bound = value;
    let have = this.valueTypeOf(value);
    if (!valTypeIdentical(have, bindingVt) && !this.refConforms(have, bindingVt)) {
      let wantRef = bindingVt is ValTypeRef || bindingVt is ValTypeRefNull;
      if (!isRefValType(have) || !wantRef) {
        this.fail('match binding coercion');
      }
      bound = this.b.emit(IrOp.ref_cast, bindingVt, value,
          this.b.internType(bindingVt));
    }
    if (this.isCelled(sym.id)) {
      this.env[sym.id] = this.cellAlloc(bindingVt, bound);
    } else {
      this.env[sym.id] = bound;
    }
    this.symbols[sym.id] = sym;
  }

  /**
   * Celled = captured by a closure and mutated on either side of the
   * boundary. The variable lives in a heap cell shared through closure
   * contexts; the environment maps the symbol to the cell REFERENCE,
   * which is an invariant SSA value — so celled bindings never
   * participate in merge parameters, and reads/writes go through the
   * cell's `value` field.
   */
  isCelled(symId: SymbolId): boolean {
    return this.wasm.mutableCapturedSymbols.has(symId);
  }

  /**
   * Cells pre-allocated (empty) by precellBindings, awaiting their
   * declaration's write-through. Consumed there, so a re-lowered
   * declaration (none today) or later shadowing allocates fresh.
   */
  precelledBindings = new HashSet<SymbolId>();

  /**
   * Enclosing locals assigned inside an ACTIVE `try` body, mapped to
   * the mutable variable mirroring them (ir.md §5.1).
   *
   * The binding stays an ordinary SSA variable everywhere — reads,
   * merges and loop carries are untouched, so there is no cost to
   * reading one. The mirror exists for the handler alone, which no SSA
   * edge can reach carrying the body's assignments: the protected edge
   * leaves from anywhere in the region and can only carry values live
   * at its entry. So every assignment ALSO writes the variable, and
   * the handler seeds its environment by reading it back.
   *
   * Nested tries share one variable per symbol: the innermost handler
   * wants the same "last value written" the outer one does.
   */
  tryVars = new HashMap<SymbolId, i32>();

  /**
   * Mirrors a newly stored value into the symbol's try variable, when
   * it has one. Every site that stores an SSA value for a symbol into
   * `env` must call this — a missed one leaves the handler reading a
   * stale value.
   */
  noteVarWrite(symId: SymbolId, value: i32): void {
    if (let (true, varId) = this.tryVars.get(symId)) {
      this.b.varSet(varId,
          this.conformToSlot(value, this.b.body.varTypes[varId], 'try var type'));
    }
  }

  /**
   * Pre-allocates empty cells for celled `let f = (…) => …` bindings
   * in a statement list, BEFORE any statement lowers. Self- and
   * forward-referencing closures capture the binding before its
   * declaration executes; the cell is the identity they share, and
   * the declaration later writes the closure value through it. Only
   * nullable-ref cells can start empty; celled bindings of other
   * shapes keep the declaration-time allocation (and closures created
   * before it keep failing loudly, as before).
   */
  precellBindings(body: Array<Statement>): void {
    for (let stmt in body) {
      if (!(stmt is VariableDeclaration)) { continue; }
      let vd = stmt as VariableDeclaration;
      var pat = vd.pattern;
      if (pat is BindingPattern) {
        pat = (pat as BindingPattern).pattern;
      }
      if (!(pat is IdentifierPattern)) { continue; }
      if (!(vd.init is FunctionExpression)) { continue; }
      let symOpt = this.func.model.resolveDeclaration(pat);
      if (symOpt == null) { continue; }
      let sym = symOpt as Symbol;
      if (!this.isCelled(sym.id) || this.env.has(sym.id)) { continue; }
      let bindingType = this.func.model.getBindingType(sym);
      if (bindingType == null) { continue; }
      let bindingVt = typeToValTypeWithSub(this.wasm, bindingType as Type, this.func);
      // Same invariant as cellAlloc: post-layout, the cell shape must
      // already be interned by discovery or its casts emit heap type -1.
      if (this.wasm.isLayoutLocked &&
          !this.wasm.cellStructs.has(getCellKey(bindingVt))) {
        throw new Error('cell struct not laid out (discovery bug): ' +
            (this.func.name ?? '<unnamed>'));
      }
      let cellStruct = getCellStruct(this.wasm, bindingVt);
      let fieldVt = cellStruct.fields[0].type;
      if (!(fieldVt is ValTypeRefNull)) { continue; }
      let nullVal = this.b.emit(IrOp.ref_null, fieldVt, -1, -1);
      let typeRef = this.b.addRef(new IrRefType(cellStruct));
      this.env[sym.id] = this.b.emit(IrOp.struct_new,
          new ValTypeRef(cellStruct) as ValType,
          this.b.pushArgList(oneValue(nullVal)), typeRef);
      this.symbols[sym.id] = sym;
      this.precelledBindings.add(sym.id);
    }
  }

  /** Allocates a fresh cell holding `value` for a celled binding. */
  cellAlloc(bindingVt: ValType, value: i32): i32 {
    // ZIR synthesis runs after layout: a getCellStruct MISS here would
    // mint a Cell struct that can never receive a type index (its
    // casts emit heap type -1 — invalid wasm). A miss means discovery
    // failed to intern this cell shape pre-layout — an invariant
    // violation, not a coverage gap — so fail the compile loudly
    // rather than masking it behind a streaming fallback.
    if (this.wasm.isLayoutLocked &&
        !this.wasm.cellStructs.has(getCellKey(bindingVt))) {
      throw new Error('cell struct not laid out (discovery bug): ' +
          (this.func.name ?? '<unnamed>'));
    }
    if (!isValSubtype(this.valueTypeOf(value), bindingVt)) {
      this.failConformance(value, bindingVt, 'cell init type');
    }
    let cellStruct = getCellStruct(this.wasm, bindingVt);
    let typeRef = this.b.addRef(new IrRefType(cellStruct));
    return this.b.emit(IrOp.struct_new,
        new ValTypeRef(cellStruct) as ValType,
        this.b.pushArgList(oneValue(value)), typeRef);
  }

  /** The cell struct behind a celled environment entry. */
  cellStructOf(cell: i32): WasmStruct {
    let st = asWasmStruct(this.valueTypeOf(cell));
    if (st != null) {
      return st as WasmStruct;
    }
    throw new ZirUnsupported('celled binding shape');
  }

  cellRead(cell: i32): i32 {
    let cs = this.cellStructOf(cell);
    let fieldRef = this.b.addRef(new IrRefField(cs, 'value'));
    return this.b.emit(IrOp.struct_get, cs.fields[0].type, cell, fieldRef);
  }

  cellWrite(cell: i32, value: i32): void {
    let cs = this.cellStructOf(cell);
    if (!isValSubtype(this.valueTypeOf(value), cs.fields[0].type)) {
      this.failConformance(value, cs.fields[0].type, 'cell write type');
    }
    let fieldRef = this.b.addRef(new IrRefField(cs, 'value'));
    let pairIdx = this.b.pushExtra(twoValues(cell, value));
    this.b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
  }

  /**
   * Conforms an arm's result and brs to the merge, materializing it on
   * first use. Callers guard on reachability; `value` is ignored for
   * void merges.
   */
  mergeArm(m: MergeState, value: i32, armKind: String = 'arm type'): void {
    var v = value;
    if (!m.isVoid) {
      v = this.conformToSlot(v, m.resultVt as ValType, armKind);
    }
    if (m.block < 0) {
      m.block = this.b.newBlock();
      m.params = this.addParams(m.block, m.syms);
      if (!m.isVoid) {
        m.resultParam = this.b.blockParam(m.block, m.resultVt as ValType);
      }
    }
    let args = this.envValues(m.syms);
    if (!m.isVoid) {
      args.push(v);
    }
    this.b.br(m.block, args);
  }

  /**
   * Lands at the merge: restores the saved env view, rebinds the
   * tracked symbols to the merge params, and resumes there. Returns
   * the result param, or -1 when no arm reached the merge (the
   * expression is unreachable past this point).
   */
  finishMerge(m: MergeState, saved: HashMap<SymbolId, i32>): i32 {
    if (m.block < 0) {
      this.reachable = false;
      return -1;
    }
    this.env = saved;
    this.applyParams(m.syms, m.params as Array<i32>);
    this.b.switchTo(m.block);
    this.reachable = true;
    return m.resultParam;
  }

  addParams(block: i32, syms: Array<SymbolId>): Array<i32> {
    let params = new Array<i32>();
    for (let symId in syms) {
      // The binding's declared type is the stable merge type: incoming
      // values may be wasm subtypes (non-null refs, subclass structs,
      // typed nulls), which the verifier's subtype check admits.
      params.push(this.b.blockParam(block, this.bindingValType(symId)));
    }
    return params;
  }

  bindingValType(symId: SymbolId): ValType {
    if (!this.symbols.has(symId)) {
      this.fail('unknown merge symbol');
    }
    let t = this.func.model.getBindingType(this.symbols[symId]);
    if (t == null) {
      this.fail('untyped merge binding');
    }
    let vt = typeToValTypeWithSub(this.wasm, t as Type, this.func);
    this.requireSupported(vt, 'merge binding type');
    return vt;
  }

  applyParams(syms: Array<SymbolId>, params: Array<i32>): void {
    for (var i = 0; i < syms.length; i += 1) {
      this.env[syms[i]] = params[i];
    }
  }

  envValues(syms: Array<SymbolId>): Array<i32> {
    let values = new Array<i32>();
    for (let symId in syms) {
      // Branch arguments must conform to the params addParams typed
      // from the DECLARED binding: env narrowing (a nullable value
      // proven non-null and re-widened by a merge, or vice versa)
      // can leave the current value at a different nullability than
      // the binding. conformToBinding re-asserts or downcasts; exact
      // matches pass through untouched.
      values.push(this.conformToBinding(this.env[symId],
          this.bindingValType(symId)));
    }
    return values;
  }

  copyEnv(): HashMap<SymbolId, i32> {
    return this.copyOf(this.env);
  }

  copyOf(source: HashMap<SymbolId, i32>): HashMap<SymbolId, i32> {
    let copy = new HashMap<SymbolId, i32>();
    for (let pair in source) {
      copy[pair.key] = pair.value;
    }
    return copy;
  }
}

/** An empty argument list (branch with no args, nullary call). */
export let noValues = (): Array<i32> => new Array<i32>();

/** A one-element argument list (single branch arg or call operand). */
export let oneValue = (a: i32): Array<i32> => {
  let list = new Array<i32>();
  list.push(a);
  return list;
};

/** A two-element argument list, in push order. */
export let twoValues = (a: i32, b: i32): Array<i32> => {
  let list = new Array<i32>();
  list.push(a);
  list.push(b);
  return list;
};
