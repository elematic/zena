/**
 * The single shared surface that split-out lowering modules see.
 * FunctionLowerer cannot be imported by them (import cycle with
 * lowering.zena), so the mutually-recursive core arrives as closures,
 * while the builder, module, and function are direct fields. Every
 * split module shares THIS type — a new module extends it with more
 * closures rather than minting its own context (ir/intrinsics.zena
 * predates this and keeps its narrower IntrinsicCx).
 */
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { HashSet } from 'zena:set';
import { String } from 'zena:string';
import { Error } from 'zena:error';
import { BinaryExpression, Expression } from '../../ast.zena';
import { Type, ClassType } from '../../types.zena';
import { ValType } from '../wasm.zena';
import {
  WasmModule, WasmFunction, WasmSignature, ClassCodegenInfo,
  RecordDispatchInfo,
} from '../wasm-module.zena';
import { IrBuilder } from './builder.zena';
import { Symbol, SymbolId } from '../../scope/symbol.zena';

/**
 * Thrown for constructs lowering does not model YET: tryLowerFunction
 * catches exactly this type and falls back to the streaming generator
 * (fatal under zir-strict). States the checker guarantees impossible
 * are NOT ZirUnsupported — throw a plain Error for those, which
 * propagates and fails the compile: a silent fallback would hide a
 * lowering bug. (Defined here rather than in lowering.zena so split
 * modules can throw it without an import cycle.)
 */
export final class ZirUnsupported extends Error {
  new(reason: String) : super('zir unsupported: ' + reason);
}

/** One loop's break/continue targets and carried symbols. */
export final class LoopCtx {
  /** Where `continue` jumps: the header for while, the update block for for. */
  continueTarget: i32;
  exit: i32;
  carried: Array<SymbolId>;
  new(this.continueTarget, this.exit, this.carried);
}

export final class LoweringContext {
  b: IrBuilder;
  wasm: WasmModule;
  func: WasmFunction;
  // ---- Mutable per-function lowering state (single-homed HERE; the
  // coordinator and every split module read and write the same
  // instance). SSA construction is the structured-AST form: `env`
  // maps each variable symbol to its current value.
  var env = new HashMap<SymbolId, i32>();
  /** Symbols behind env entries, for binding-type lookups at merges. */
  symbols = new HashMap<SymbolId, Symbol>();
  loops = new Array<LoopCtx>();
  /** Values piped by enclosing |> expressions; $ reads the top. */
  pipelineValues = new Array<i32>();
  /**
   * Values known to be EXACTLY their class (freshly constructed by
   * struct.new in this function, or a singleton global). A method
   * call on an exact receiver never needs the vtable, even when
   * subclasses override the slot — no subclass instance can be here.
   * Merges, cells, and casts produce new ids, so exactness is
   * conservatively local.
   */
  exactValues = new HashSet<i32>();
  var reachable = true;
  /** The receiver value for instance methods; -1 elsewhere. */
  var thisValue = -1;
  /** Lowers an expression; a non-null `want` supplies the context type. */
  lowerExpr: (e: Expression, want: ValType | null) => i32;
  /** The storage ValType of an already-lowered value. */
  valueTypeOf: (value: i32) => ValType;
  /** The expression's own checked type, substituted and supported. */
  exprVt: (e: Expression) => ValType;
  /** The checked semantic type, substituted; null when untyped. */
  substitutedNodeType: (e: Expression) => Type | null;
  reassertNonNull: (value: i32, want: ValType) => i32;
  /** ref.as_non_null when the value's own storage type is nullable. */
  stripNonNull: (value: i32) => i32;
  requireSupported: (vt: ValType, what: String) => void;
  /** Conformance failure: throws ZirUnsupported, never returns. */
  failConformance: (value: i32, want: ValType, reason: String) => void;
  /** Throws ZirUnsupported; the i32 never arrives (value positions). */
  fail: (reason: String) => i32;
  /** Coerce a value to a target ValType (identity or as_non_null). */
  coerceTo: (value: i32, target: ValType) => i32;
  /** The receiver's ClassType when the value's type maps to one. */
  classTypeOfValue: (value: i32) => ClassType | null;
  /** Specialization-independent class key (generic source's key). */
  canonicalKeyOf: (ct: ClassType) => String;
  /** The method when no transitive subclass overrides it, else null. */
  resolveDevirtualizedMethod: (ct: ClassType, methName: String) => WasmFunction | null;
  /** The vtable field index of a slot, or -1 when absent. */
  vtableSlotIndex: (classInfo: ClassCodegenInfo, slotName: String) => i32;
  /** Virtual dispatch through the class vtable (streaming's shape). */
  lowerVtableCall: (receiver: i32, classInfo: ClassCodegenInfo,
      slotName: String, sig: WasmSignature, args: Array<i32>,
      resultType: ValType | null) => i32;
  /** Binds a pattern symbol into the SSA env (cell-aware, coercing). */
  bindPatternSym: (sym: Symbol, value: i32) => void;
  /** A record property read through an already-known dispatch. */
  recordDispatchRead: (dispatch: RecordDispatchInfo, propName: String,
      receiver: i32) => i32;
  /** A record property read resolved from the receiver's own struct. */
  objectPropertyRead: (propName: String, receiver: i32) => i32;
  /** Adds one block param per symbol, typed from its binding. */
  addParams: (block: i32, syms: Array<SymbolId>) => Array<i32>;
  /** The syms' current env values, in order (branch-argument lists). */
  envValues: (syms: Array<SymbolId>) => Array<i32>;
  /** Rebinds each symbol to its block param after a merge. */
  applyParams: (syms: Array<SymbolId>, params: Array<i32>) => void;
  /** The instance behind a fat-pointer value of checked type `t`. */
  unwrapFatPointer: (t: Type, value: i32) => i32;
  /** Direct call to a class operator member: a (+) b as a.+(b). */
  operatorMemberOn: (opMember: String, left: i32, right: i32,
      leftCt: ClassType) => i32;
  /** `left ?? right` (env-merging short-circuit; stays lowerer-side). */
  nullishCoalesce: (bin: BinaryExpression) => i32;
  new(this.b, this.wasm, this.func, this.lowerExpr, this.valueTypeOf,
      this.exprVt, this.substitutedNodeType, this.reassertNonNull,
      this.stripNonNull, this.requireSupported, this.failConformance,
      this.fail, this.coerceTo, this.classTypeOfValue,
      this.canonicalKeyOf, this.resolveDevirtualizedMethod,
      this.vtableSlotIndex, this.lowerVtableCall, this.bindPatternSym,
      this.recordDispatchRead, this.objectPropertyRead, this.addParams,
      this.envValues, this.applyParams, this.unwrapFatPointer,
      this.operatorMemberOn, this.nullishCoalesce);
}

/** An empty argument list (branch with no args, nullary call). */
export let noValues = (): Array<i32> => new Array<i32>();

/** A one-element argument list (single branch arg or call operand). */
export let oneValue = (a: i32): Array<i32> => {
  let list = new Array<i32>();
  list.push(a);
  return list;
};

/** A two-element argument list, in push order. */
export let twoValues = (a: i32, b: i32): Array<i32> => {
  let list = new Array<i32>();
  list.push(a);
  list.push(b);
  return list;
};
