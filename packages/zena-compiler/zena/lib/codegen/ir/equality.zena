/**
 * Equality and hashing lowering, split out of lowering.zena: the
 * synthesized case-class operator== / hashCode bodies, the erased
 * (eqref-tiered) equality used by `==` on erased operands, and the
 * equals<T>/hash<T> intrinsics from zena:map — plus the call/fast-path
 * helpers only they use. Each function takes the shared LoweringContext;
 * bodies are streaming's shapes exactly (see the per-function docs).
 */
import { Array } from 'zena:array';
import { String } from 'zena:string';
import { CallExpression } from '../../ast.zena';
import {
  BooleanType, ClassType, F32Type, F64Type, I32Type, I64Type, Type,
  instantiateClassType,
} from '../../types.zena';
import {
  ValType, ValTypeAnyRef, ValTypeEqRef, ValTypeF32, ValTypeF64, ValTypeI32, ValTypeI64, ValTypeV128, ValTypeRef, ValTypeRefNull, ValTypeStructRef, refTargetOf,
} from '../wasm.zena';
import {
  ClassCodegenInfo, WasmField, WasmFunction, WasmSignature, WasmStruct,
} from '../wasm-module.zena';
import { getClassKey, getClassMethodKey } from '../codegen-utils.zena';
import { IrBody, IrOp, IrRefField, IrRefFunc } from './ir.zena';
import { lowerExpr } from './lowering.zena';
import {
  LoweringContext, ZirUnsupported, noValues, oneValue, twoValues,
} from './lowering-context.zena';

/** Bail with the lowering-side message shape (reason @function). */
let bail = (cx: LoweringContext, reason: String): never => {
  throw new ZirUnsupported(reason + ' @' + (cx.func.name ?? '?'));
};

let isNullableRef = (vt: ValType): boolean => {
  return match (vt) {
    case ValTypeRefNull: true
    case ValTypeAnyRef: true
    case ValTypeEqRef: true
    case ValTypeStructRef: true
    case _: false
  };
};

/** True when the struct IS the String struct (covers generic
 * specializations with String arguments, matched by struct index
 * like the streaming backend). */
let isStringStruct = (cx: LoweringContext, st: WasmStruct): boolean => {
  let strClass = cx.wasm.stringClass;
  if (strClass == null) {
    return false;
  }
  if (let (true, info) = cx.wasm.classInfos.get(getClassKey(strClass))) {
    return info.structType.index == st.index;
  }
  return false;
};

/** String's operator== function, or a bail. (Inline throw: the
 * checker does not treat a bail() call as terminating — BUGS.md
 * "never-returning calls don't narrow".) */
let stringEqFunc = (cx: LoweringContext): WasmFunction => {
  let strClass = cx.wasm.stringClass;
  if (strClass != null) {
    let key = getClassMethodKey(getClassKey(strClass), "==");
    if (let (true, m) = cx.wasm.classMethodMap.get(key)) {
      return m;
    }
  }
  throw new ZirUnsupported('string eq method');
};

/** Direct call to a devirtualized single-result unary method
 * (hashCode, the string-hash helper), coercing the receiver. */
let callUnary = (cx: LoweringContext, fn: WasmFunction, v: i32): i32 => {
  if (fn.signature.params.length != 1 || fn.signature.returns.length != 1) {
    bail(cx, 'unary method shape');
  }
  let recv = cx.coerceTo(v, fn.signature.params[0]);
  let funcRef = cx.b.addRef(new IrRefFunc(fn));
  return cx.b.callFunc(funcRef, oneValue(recv), fn.signature.returns[0]);
};

/** Direct call to a two-operand boolean method (String.== or a
 * devirtualized operator==), coercing operands to its params. */
let callEqMethod = (cx: LoweringContext, method: WasmFunction, a: i32, b2: i32): i32 => {
  let sig = method.signature;
  if (sig.params.length != 2 || sig.returns.length != 1) {
    bail(cx, 'eq method shape');
  }
  let ca = cx.coerceTo(a, sig.params[0]);
  let cb = cx.coerceTo(b2, sig.params[1]);
  let funcRef = cx.b.addRef(new IrRefFunc(method));
  return cx.b.callFunc(funcRef, twoValues(ca, cb), sig.returns[0]);
};

/** i64 -> i32 hash fold (lo ^ hi), shared by the hash intrinsic
 * and the case-class hashCode synthesis (mirrors streaming). */
let hashI64Fold = (cx: LoweringContext, v: i32): i32 => {
  let i32vt = new ValTypeI32() as ValType;
  let lo = cx.b.emit(IrOp.i32_wrap_i64, i32vt, v, -1);
  let thirtyTwo = cx.b.constI64(32 as i64, new ValTypeI64() as ValType);
  let shifted = cx.b.binary(IrOp.i64_shr_u, new ValTypeI64() as ValType, v, thirtyTwo);
  let hi = cx.b.emit(IrOp.i32_wrap_i64, i32vt, shifted, -1);
  return cx.b.binary(IrOp.i32_xor, i32vt, lo, hi);
};

/** Call the runtime string-hash helper on a String value. */
let callStringHash = (cx: LoweringContext, v: i32): i32 => {
  let hashFn = cx.wasm.stringHashFunc;
  if (hashFn == null) {
    bail(cx, 'string hash helper');
  }
  return callUnary(cx, hashFn, v);
};

/**
 * The reference-equality fast path around a content-equality call,
 * as a value-producing diamond (blocks + a merge parameter, since
 * ZIR has no select over calls):
 *
 *         same = ref.eq a b
 *        /                  \\
 *   same: true          nullSafe && either null?
 *      |                  yes: 0     no: call ==(a, b)
 *        \\                /
 *          merge(result: i32)
 *
 * `same` covers both the identical-reference case and, when
 * nullSafe, the both-null case (ref.eq of two nulls is true), so
 * the null arm only sees exactly-one-null — never equal. Callers
 * with non-nullable operands pass nullSafe=false and skip the null
 * checks entirely.
 */
let refEqFastPathCall = (cx: LoweringContext, method: WasmFunction, a: i32, b2: i32,
    nullSafe: boolean): i32 => {
  let i32vt = new ValTypeI32() as ValType;
  let same = cx.b.emit(IrOp.ref_eq, i32vt, a, b2);
  let sameB = cx.b.newBlock();
  let restB = cx.b.newBlock();
  cx.b.brIf(same, sameB, noValues(), restB, noValues());
  let mergeB = cx.b.newBlock();
  let result = cx.b.blockParam(mergeB, i32vt);

  cx.b.switchTo(sameB);
  let one = cx.b.constI32(1, i32vt);
  cx.b.br(mergeB, oneValue(one));

  cx.b.switchTo(restB);
  if (nullSafe) {
    let aNull = cx.b.emit(IrOp.ref_is_null, i32vt, a, -1);
    let bNull = cx.b.emit(IrOp.ref_is_null, i32vt, b2, -1);
    let anyNull = cx.b.binary(IrOp.i32_or, i32vt, aNull, bNull);
    let nullB = cx.b.newBlock();
    let callB = cx.b.newBlock();
    cx.b.brIf(anyNull, nullB, noValues(), callB, noValues());

    cx.b.switchTo(nullB);
    let zero = cx.b.constI32(0, i32vt);
    cx.b.br(mergeB, oneValue(zero));

    cx.b.switchTo(callB);
  }
  let called = callEqMethod(cx, method, a, b2);
  cx.b.br(mergeB, oneValue(called));

  cx.b.switchTo(mergeB);
  return result;
};

/** Field-wise equality for the synthesized case-class ==. */
let synthFieldEq = (cx: LoweringContext, f: WasmField, a: i32, b2: i32): i32 => {
  let i32vt = new ValTypeI32() as ValType;
  let ft = f.type;
  if (ft is ValTypeI32) {
    return cx.b.binary(IrOp.i32_eq, i32vt, a, b2);
  }
  if (ft is ValTypeI64) {
    return cx.b.binary(IrOp.i64_eq, i32vt, a, b2);
  }
  if (ft is ValTypeF32) {
    return cx.b.binary(IrOp.f32_eq, i32vt, a, b2);
  }
  if (ft is ValTypeF64) {
    return cx.b.binary(IrOp.f64_eq, i32vt, a, b2);
  }
  let fieldStruct = refTargetOf(ft);
  if (fieldStruct is WasmStruct) {
    var eqFunc: WasmFunction | null = null;
    if (isStringStruct(cx, fieldStruct)) {
      eqFunc = stringEqFunc(cx);
    }
    if (eqFunc == null && fieldStruct.classType != null) {
      let fct = fieldStruct.classType as ClassType;
      if (fct.members.has("==")) {
        // A user operator== on the field's class: only a
        // devirtualized direct call is expressible.
        eqFunc = cx.resolveDevirtualizedMethod(fct, "==");
        if (eqFunc == null) {
          bail(cx, 'case eq field dispatch');
        }
      }
    }
    if (eqFunc != null) {
      // Null-safe reference fast path around the content equality
      // (see refEqFastPathCall): struct fields are nullable refs.
      return refEqFastPathCall(cx, eqFunc, a, b2, true);
    }
  }
  // Fallback: reference identity (also covers arrays/closures).
  return cx.b.emit(IrOp.ref_eq, i32vt, a, b2);
};

/** Field-wise hash for the synthesized case-class hashCode. */
let synthFieldHash = (cx: LoweringContext, st: WasmStruct, f: WasmField,
    selfC: i32): i32 => {
  let i32vt = new ValTypeI32() as ValType;
  let ft = f.type;
  if (ft is ValTypeF32) {
    let fieldRef = cx.b.addRef(new IrRefField(st, f.name as String));
    let v = cx.b.emit(IrOp.struct_get, ft, selfC, fieldRef);
    let zero32 = cx.b.constF32(0.0, new ValTypeF32());
    let norm32 = cx.b.binary(IrOp.f32_add, new ValTypeF32() as ValType, v, zero32);
    return cx.b.emit(IrOp.i32_reinterpret_f32, new ValTypeI32(), norm32, -1);
  }
  if (ft is ValTypeF64) {
    let fieldRef = cx.b.addRef(new IrRefField(st, f.name as String));
    let v = cx.b.emit(IrOp.struct_get, ft, selfC, fieldRef);
    let zero64 = cx.b.constF64(0.0, new ValTypeF64());
    let norm64 = cx.b.binary(IrOp.f64_add, new ValTypeF64() as ValType, v, zero64);
    let bits = cx.b.emit(IrOp.i64_reinterpret_f64, new ValTypeI64(), norm64, -1);
    return hashI64Fold(cx, bits);
  }
  if (ft is ValTypeI32) {
    let fieldRef = cx.b.addRef(new IrRefField(st, f.name as String));
    return cx.b.emit(IrOp.struct_get, ft, selfC, fieldRef);
  }
  if (ft is ValTypeI64) {
    let fieldRef = cx.b.addRef(new IrRefField(st, f.name as String));
    let v = cx.b.emit(IrOp.struct_get, ft, selfC, fieldRef);
    return hashI64Fold(cx, v);
  }
  // Fresh binding: the narrowing state after the bail/return chain
  // above over-narrows `ft` (see BUGS.md narrowing entries).
  let ftRef: ValType = f.type;
  let fieldStruct = refTargetOf(ftRef);
  if (fieldStruct is WasmStruct) {
    var hashFunc: WasmFunction | null = null;
    if (isStringStruct(cx, fieldStruct) && cx.wasm.stringHashFunc != null) {
      hashFunc = cx.wasm.stringHashFunc;
    }
    var hashVtInfo: ClassCodegenInfo | null = null;
    var hashSlotSig: WasmSignature | null = null;
    if (hashFunc == null && fieldStruct.classType != null) {
      let fct = fieldStruct.classType as ClassType;
      if (fct.members.has("hashCode")) {
        hashFunc = cx.resolveDevirtualizedMethod(fct, "hashCode");
        if (hashFunc == null) {
          // Overridden in some subclass: dispatch through the
          // field class's vtable, like any virtual method call.
          var resolvedOpt: WasmFunction | null = null;
          var hc: ClassType | null = fct;
          while (hc != null && resolvedOpt == null) {
            var hg: ClassType | null = hc;
            while (hg != null && resolvedOpt == null) {
              let key = getClassMethodKey(getClassKey(hg), 'hashCode');
              if (let (true, m) = cx.wasm.classMethodMap.get(key)) {
                resolvedOpt = m;
              }
              hg = hg.genericSource;
            }
            hc = hc.superType;
          }
          let infoOpt2 = if (let (true, info) = cx.wasm.classInfos.get(getClassKey(fct))) info else null;
          if (resolvedOpt == null || infoOpt2 == null) {
            bail(cx, 'case hash field dispatch');
          }
          if (cx.vtableSlotIndex(infoOpt2, 'hashCode') < 0) {
            bail(cx, 'case hash field dispatch');
          }
          hashVtInfo = infoOpt2;
          hashSlotSig = resolvedOpt.signature;
        }
      }
    }
    if (hashFunc != null || hashSlotSig != null) {
      let fieldRef = cx.b.addRef(new IrRefField(st, f.name as String));
      let v = cx.b.emit(IrOp.struct_get, ft, selfC, fieldRef);
      // Null-safe: null hashes to 0.
      let isNull = cx.b.emit(IrOp.ref_is_null, i32vt, v, -1);
      let nullB = cx.b.newBlock();
      let callB = cx.b.newBlock();
      cx.b.brIf(isNull, nullB, noValues(), callB, noValues());
      let mergeB = cx.b.newBlock();
      let result = cx.b.blockParam(mergeB, i32vt);

      cx.b.switchTo(nullB);
      let zero = cx.b.constI32(0, i32vt);
      cx.b.br(mergeB, oneValue(zero));

      cx.b.switchTo(callB);
      let called = if (hashSlotSig != null) {
        let nonNullV = cx.stripNonNull(v);
        cx.lowerVtableCall(nonNullV, hashVtInfo as ClassCodegenInfo,
            'hashCode', hashSlotSig, oneValue(nonNullV), hashSlotSig.returns[0])
      } else {
        callUnary(cx, hashFunc as WasmFunction, v)
      };
      cx.b.br(mergeB, oneValue(called));

      cx.b.switchTo(mergeB);
      return result;
    }
  }
  // Unsupported field kinds hash to 0 (mirrors streaming).
  return cx.b.constI32(0, i32vt);
};

/**
 * Synthesized case-class operator== (mirrors the streaming
 * generator): `other` must ref.test as this struct, then every
 * field compares equal — numerics by value, Strings by content and
 * classes through a DEVIRTUALIZED operator== (both null-safely),
 * other references by identity. Virtual dispatch bails to
 * streaming.
 */
export let lowerCaseClassEq = (cx: LoweringContext): IrBody => {
  let sig = cx.func.signature;
  if (sig.params.length != 2 || sig.returns.length != 1 ||
      cx.func.structType == null) {
    bail(cx, 'case eq shape');
  }
  let st = cx.func.structType as WasmStruct;
  let i32vt = new ValTypeI32() as ValType;
  let entry = cx.b.newBlock();
  let params = new GrowableArray<i32>();
  for (let vt in sig.params) {
    params.push(cx.b.blockParam(entry, vt));
  }
  cx.b.switchTo(entry);

  let stVt = new ValTypeRef(st) as ValType;
  let test = cx.b.emit(IrOp.ref_test, i32vt, params[1], cx.b.internType(stVt));
  if (st.fields.length <= 1) {
    cx.b.ret(test);
    return cx.b.finish();
  }

  let thenB = cx.b.newBlock();
  let elseB = cx.b.newBlock();
  cx.b.brIf(test, thenB, noValues(), elseB, noValues());
  let mergeB = cx.b.newBlock();
  let resultParam = cx.b.blockParam(mergeB, i32vt);

  cx.b.switchTo(elseB);
  let zero = cx.b.constI32(0, i32vt);
  cx.b.br(mergeB, oneValue(zero));

  cx.b.switchTo(thenB);
  let selfC = cx.b.emit(IrOp.ref_cast, stVt, params[0], cx.b.internType(stVt));
  let otherC = cx.b.emit(IrOp.ref_cast, stVt, params[1], cx.b.internType(stVt));
  var acc = -1;
  for (var fi = 0; fi < st.fields.length; fi += 1) {
    let f = st.fields[fi];
    if (f.name == null || (f.name as String) == "<vtable>") {
      continue;
    }
    let fieldRef = cx.b.addRef(new IrRefField(st, f.name as String));
    let a = cx.b.emit(IrOp.struct_get, f.type, selfC, fieldRef);
    let b2 = cx.b.emit(IrOp.struct_get, f.type, otherC, fieldRef);
    let fe = synthFieldEq(cx, f, a, b2);
    acc = if (acc == -1) fe else cx.b.binary(IrOp.i32_and, i32vt, acc, fe);
  }
  if (acc == -1) {
    acc = cx.b.constI32(1, i32vt);
  }
  cx.b.br(mergeB, oneValue(acc));

  cx.b.switchTo(mergeB);
  cx.b.ret(resultParam);
  return cx.b.finish();
};

/**
 * Synthesized case-class hashCode (mirrors the streaming
 * generator): h = fold(h * 31 + fieldHash). Numerics hash by value
 * (i64 folds lo ^ hi), Strings through the runtime helper and
 * class fields through a DEVIRTUALIZED hashCode (both null-safely,
 * null hashing to 0); other reference fields hash to 0. Float
 * fields bail (no reinterpret ops in ZIR yet).
 */
export let lowerCaseClassHash = (cx: LoweringContext): IrBody => {
  let sig = cx.func.signature;
  if (sig.params.length != 1 || sig.returns.length != 1 ||
      cx.func.structType == null) {
    bail(cx, 'case hash shape');
  }
  let st = cx.func.structType as WasmStruct;
  let i32vt = new ValTypeI32() as ValType;
  let entry = cx.b.newBlock();
  let params = new GrowableArray<i32>();
  for (let vt in sig.params) {
    params.push(cx.b.blockParam(entry, vt));
  }
  cx.b.switchTo(entry);

  if (st.fields.length <= 1) {
    cx.b.ret(cx.b.constI32(0, i32vt));
    return cx.b.finish();
  }
  let stVt = new ValTypeRef(st) as ValType;
  let selfC = cx.b.emit(IrOp.ref_cast, stVt, params[0], cx.b.internType(stVt));
  var h = -1;
  for (var fi = 0; fi < st.fields.length; fi += 1) {
    let f = st.fields[fi];
    if (f.name == null || (f.name as String) == "<vtable>") {
      continue;
    }
    let fh = synthFieldHash(cx, st, f, selfC);
    if (h == -1) {
      h = fh;
    } else {
      let thirtyOne = cx.b.constI32(31, i32vt);
      let scaled = cx.b.binary(IrOp.i32_mul, i32vt, h, thirtyOne);
      h = cx.b.binary(IrOp.i32_add, i32vt, scaled, fh);
    }
  }
  if (h == -1) {
    h = cx.b.constI32(0, i32vt);
  }
  cx.b.ret(h);
  return cx.b.finish();
};

/**
 * Erased equality over eqref-typed operands: identity, then null,
 * then String content, then boxed-primitive value tiers, then false
 * — streaming's exact tier order.
 */
export let lowerErasedEq = (cx: LoweringContext, leftIn: i32, rightIn: i32): i32 => {
  let i32vt = new ValTypeI32() as ValType;
  let eqVt = new ValTypeEqRef() as ValType;
  var left = leftIn;
  var right = rightIn;
  if (cx.valueTypeOf(left) is ValTypeAnyRef) {
    left = cx.b.emit(IrOp.ref_cast, eqVt, left, cx.b.internType(eqVt));
  }
  if (cx.valueTypeOf(right) is ValTypeAnyRef) {
    right = cx.b.emit(IrOp.ref_cast, eqVt, right, cx.b.internType(eqVt));
  }
  let merge = cx.b.newBlock();
  let res = cx.b.blockParam(merge, i32vt);
  let one = cx.b.constI32(1, i32vt);
  let zero = cx.b.constI32(0, i32vt);

  let same = cx.b.binary(IrOp.ref_eq, i32vt, left, right);
  let notSameB = cx.b.newBlock();
  cx.b.brIf(same, merge, oneValue(one), notSameB, noValues());

  cx.b.switchTo(notSameB);
  let lNull = cx.b.emit(IrOp.ref_is_null, i32vt, left, -1);
  let rNull = cx.b.emit(IrOp.ref_is_null, i32vt, right, -1);
  let anyNull = cx.b.binary(IrOp.i32_or, i32vt, lNull, rNull);
  var contB = cx.b.newBlock();
  cx.b.brIf(anyNull, merge, oneValue(zero), contB, noValues());

  // String content tier.
  cx.b.switchTo(contB);
  let stringClassOpt = cx.wasm.stringClass;
  if (stringClassOpt != null) {
    let sKey = getClassKey(stringClassOpt);
    var sStruct: WasmStruct | null = null;
    if (let (true, info) = cx.wasm.classInfos.get(sKey)) {
      sStruct = info.structType;
    }
    var eqFunc: WasmFunction | null = null;
    if (let (true, f) = cx.wasm.classMethodMap.get(
        getClassMethodKey(sKey, '=='))) {
      eqFunc = f;
    }
    if (sStruct != null && eqFunc != null) {
      let strVt = new ValTypeRef(sStruct) as ValType;
      let lIsS = cx.b.emit(IrOp.ref_test, i32vt, left,
          cx.b.internType(strVt));
      let rIsS = cx.b.emit(IrOp.ref_test, i32vt, right,
          cx.b.internType(strVt));
      let bothS = cx.b.binary(IrOp.i32_and, i32vt, lIsS, rIsS);
      let strB = cx.b.newBlock();
      let afterStrB = cx.b.newBlock();
      cx.b.brIf(bothS, strB, noValues(), afterStrB, noValues());
      cx.b.switchTo(strB);
      let lS = cx.b.emit(IrOp.ref_cast, strVt, left,
          cx.b.internType(strVt));
      let rS = cx.b.emit(IrOp.ref_cast, strVt, right,
          cx.b.internType(strVt));
      let content = cx.b.callFunc(
          cx.b.addRef(new IrRefFunc(eqFunc)),
          twoValues(lS, rS),
          if (eqFunc.signature.returns.length == 1) {
            eqFunc.signature.returns[0]
          } else {
            null
          });
      cx.b.br(merge, oneValue(content));
      cx.b.switchTo(afterStrB);
      contB = afterStrB;
    }
  }

  // Boxed-primitive tiers, in streaming's order.
  let boxClassOpt = cx.wasm.boxClass;
  if (boxClassOpt != null) {
    let boxTypes = new GrowableArray<Type>();
    boxTypes.push(new I32Type());
    boxTypes.push(new BooleanType());
    boxTypes.push(new F64Type());
    boxTypes.push(new F32Type());
    boxTypes.push(new I64Type());
    for (var bi = 0; bi < boxTypes.length; bi += 1) {
      let t = boxTypes[bi];
      let typeArgs = new GrowableArray<Type>();
      typeArgs.push(t);
      let boxCt = instantiateClassType(boxClassOpt, typeArgs);
      var boxStruct: WasmStruct | null = null;
      if (let (true, info) = cx.wasm.classInfos.get(getClassKey(boxCt))) {
        boxStruct = info.structType;
      }
      if (boxStruct == null) {
        continue;
      }
      if (boxStruct.fields.length < 2 || boxStruct.fields[1].name == null) {
        continue;
      }
      let boxVt = new ValTypeRef(boxStruct) as ValType;
      let valueField = boxStruct.fields[1].name as String;
      let valueVt = boxStruct.fields[1].type;
      let lIsB = cx.b.emit(IrOp.ref_test, i32vt, left,
          cx.b.internType(boxVt));
      let rIsB = cx.b.emit(IrOp.ref_test, i32vt, right,
          cx.b.internType(boxVt));
      let bothB = cx.b.binary(IrOp.i32_and, i32vt, lIsB, rIsB);
      let unwrapB = cx.b.newBlock();
      let nextB = cx.b.newBlock();
      cx.b.brIf(bothB, unwrapB, noValues(), nextB, noValues());
      cx.b.switchTo(unwrapB);
      let lC = cx.b.emit(IrOp.ref_cast, boxVt, left,
          cx.b.internType(boxVt));
      let rC = cx.b.emit(IrOp.ref_cast, boxVt, right,
          cx.b.internType(boxVt));
      let fieldRef = cx.b.addRef(new IrRefField(boxStruct, valueField));
      let lV = cx.b.emit(IrOp.struct_get, valueVt, lC, fieldRef);
      let rVref = cx.b.addRef(new IrRefField(boxStruct, valueField));
      let rV = cx.b.emit(IrOp.struct_get, valueVt, rC, rVref);
      var cmpOp = IrOp.i32_eq;
      if (t is F64Type) {
        cmpOp = IrOp.f64_eq;
      } else if (t is F32Type) {
        cmpOp = IrOp.f32_eq;
      } else if (t is I64Type) {
        cmpOp = IrOp.i64_eq;
      }
      let cmp = cx.b.binary(cmpOp, i32vt, lV, rV);
      cx.b.br(merge, oneValue(cmp));
      cx.b.switchTo(nextB);
    }
  }

  // Different or non-comparable references: false.
  cx.b.br(merge, oneValue(zero));
  cx.b.switchTo(merge);
  return res;
};

/**
 * equals<T>(a, b) — the @intrinsic declare from zena:map,
 * type-directed like the streaming backend's generateGlobalIntrinsic
 * but restricted to the tiers ZIR can express today. Could this be
 * written in Zena? Only once the language can constrain the type
 * parameter (equals<T: Eq>) — the dispatch below is exactly what
 * such a bound would monomorphize to, and the string/hash helpers it
 * calls ARE Zena functions. Until then the type dispatch lives here
 * (routed by intrinsics.zena's lowerIntrinsic). By operand wasm
 * type —
 *   numerics        -> the type's eq instruction;
 *   String/String   -> String.operator== (content equality);
 *   class w/ ==     -> ref.eq fast path around a DEVIRTUALIZED
 *                      operator== (see refEqFastPathCall);
 *   anything else (nullable refs, erased operands, virtual ==)
 *                   -> bail to streaming.
 */
export let lowerEqIntrinsic = (cx: LoweringContext, call: CallExpression): i32 => {
  let i32vt = new ValTypeI32() as ValType;
  if (call.args.length != 2) {
    bail(cx, 'eq arity');
  }
  let a = lowerExpr(cx, call.args[0], null);
  let b2 = lowerExpr(cx, call.args[1], null);
  let va = cx.valueTypeOf(a);
  let vb = cx.valueTypeOf(b2);
  if (va is ValTypeI32 && vb is ValTypeI32) {
    return cx.b.binary(IrOp.i32_eq, i32vt, a, b2);
  }
  if (va is ValTypeI64 && vb is ValTypeI64) {
    return cx.b.binary(IrOp.i64_eq, i32vt, a, b2);
  }
  if (va is ValTypeF32 && vb is ValTypeF32) {
    return cx.b.binary(IrOp.f32_eq, i32vt, a, b2);
  }
  if (va is ValTypeF64 && vb is ValTypeF64) {
    return cx.b.binary(IrOp.f64_eq, i32vt, a, b2);
  }
  if (va is ValTypeV128 && vb is ValTypeV128) {
    let eqVec = cx.b.emit(IrOp.simd_binary, new ValTypeV128(), cx.b.pushExtra(twoValues(a, b2)), 0x23);
    return cx.b.emit(IrOp.simd_unary, i32vt, eqVec, 0x63);
  }
  // Reference operands: String content equality, or a class
  // operator== behind the reference fast path.
  let ctA = cx.classTypeOfValue(a);
  let ctB = cx.classTypeOfValue(b2);
  if (ctA == null || ctB == null) {
    bail(cx, 'eq operand type');
  }
  let strClass = cx.wasm.stringClass;
  if (strClass != null &&
      cx.canonicalKeyOf(ctA) == cx.canonicalKeyOf(strClass) &&
      cx.canonicalKeyOf(ctB) == cx.canonicalKeyOf(strClass)) {
    return callEqMethod(cx, stringEqFunc(cx), a, b2);
  }
  if (isNullableRef(va) || isNullableRef(vb)) {
    bail(cx, 'nullable eq operand');
  }
  if (!ctA.members.has('==')) {
    // No content equality declared: eq() compares identity. The
    // operands are non-null same-class references here, so plain
    // ref.eq is streaming's diamond minus its dead arms.
    return cx.b.binary(IrOp.ref_eq, new ValTypeI32(), a, b2);
  }
  let eqMethod = cx.resolveDevirtualizedMethod(ctA, "==");
  if (eqMethod == null) {
    bail(cx, 'eq dispatch');
  }
  return refEqFastPathCall(cx, eqMethod, a, b2, false);
};

/**
 * hash<T>(v): by operand wasm type —
 *   i32              -> the value itself;
 *   i64              -> lo ^ hi fold (mirrors streaming);
 *   String           -> the runtime string-hash helper;
 *   class w/hashCode -> DEVIRTUALIZED direct call;
 *   floats           -> +0.0 normalize, reinterpret (f64 folds);
 *   nullable refs, erased operands -> bail;
 *   overridden hashCode -> vtable dispatch.
 */
export let lowerHashIntrinsic = (cx: LoweringContext, call: CallExpression): i32 => {
  new ValTypeI32() as ValType;
  if (call.args.length != 1) {
    bail(cx, 'hash arity');
  }
  let v = lowerExpr(cx, call.args[0], null);
  let vv = cx.valueTypeOf(v);
  if (vv is ValTypeI32) {
    return v;
  }
  if (vv is ValTypeI64) {
    return hashI64Fold(cx, v);
  }
  // Floats hash by bit pattern after adding +0.0 (streaming's shape
  // exactly — the add canonicalizes -0.0 to +0.0 so both zeros land
  // in one bucket; both backends must produce identical hashes).
  if (vv is ValTypeF32) {
    let zero32 = cx.b.constF32(0.0, new ValTypeF32());
    let norm32 = cx.b.binary(IrOp.f32_add, new ValTypeF32() as ValType, v, zero32);
    return cx.b.emit(IrOp.i32_reinterpret_f32, new ValTypeI32(), norm32, -1);
  }
  if (vv is ValTypeF64) {
    let zero64 = cx.b.constF64(0.0, new ValTypeF64());
    let norm64 = cx.b.binary(IrOp.f64_add, new ValTypeF64() as ValType, v, zero64);
    let bits = cx.b.emit(IrOp.i64_reinterpret_f64, new ValTypeI64(), norm64, -1);
    return hashI64Fold(cx, bits);
  }
  if (vv is ValTypeV128) {
    let i32vt = new ValTypeI32() as ValType;
    let e0 = cx.b.emit(IrOp.simd_extract_lane, i32vt, v, cx.b.pushExtra(twoValues(0x1B, 0)));
    let e1 = cx.b.emit(IrOp.simd_extract_lane, i32vt, v, cx.b.pushExtra(twoValues(0x1B, 1)));
    let e2 = cx.b.emit(IrOp.simd_extract_lane, i32vt, v, cx.b.pushExtra(twoValues(0x1B, 2)));
    let e3 = cx.b.emit(IrOp.simd_extract_lane, i32vt, v, cx.b.pushExtra(twoValues(0x1B, 3)));
    let x01 = cx.b.binary(IrOp.i32_xor, i32vt, e0, e1);
    let x23 = cx.b.binary(IrOp.i32_xor, i32vt, e2, e3);
    return cx.b.binary(IrOp.i32_xor, i32vt, x01, x23);
  }
  let ctV = cx.classTypeOfValue(v);
  if (ctV == null) {
    bail(cx, 'hash operand type');
  }
  let strClass = cx.wasm.stringClass;
  if (strClass != null &&
      cx.canonicalKeyOf(ctV) == cx.canonicalKeyOf(strClass)) {
    return callStringHash(cx, v);
  }
  if (isNullableRef(vv)) {
    bail(cx, 'nullable hash operand');
  }
  let hashMethod = cx.resolveDevirtualizedMethod(ctV, "hashCode");
  if (hashMethod != null) {
    return callUnary(cx, hashMethod, v);
  }
  // Overridden hashCode: dispatch through the vtable, like the
  // case-class hash synthesizer does for its fields.
  var resolvedOpt: WasmFunction | null = null;
  var hc: ClassType | null = ctV;
  while (hc != null && resolvedOpt == null) {
    var hg: ClassType | null = hc;
    while (hg != null && resolvedOpt == null) {
      let key = getClassMethodKey(getClassKey(hg), 'hashCode');
      if (let (true, m) = cx.wasm.classMethodMap.get(key)) {
        resolvedOpt = m;
      }
      hg = hg.genericSource;
    }
    hc = hc.superType;
  }
  let ci = if (let (true, info) = cx.wasm.classInfos.get(getClassKey(ctV))) info else null;
  if (resolvedOpt == null || ci == null) {
    bail(cx, 'hash operand type');
  }
  if (cx.vtableSlotIndex(ci, 'hashCode') < 0) {
    bail(cx, 'hash operand type');
  }
  let hsig = resolvedOpt.signature;
  return cx.lowerVtableCall(v, ci, 'hashCode', hsig,
      oneValue(v), hsig.returns[0]);
};
