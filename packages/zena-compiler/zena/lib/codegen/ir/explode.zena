/**
 * Argument explosion (docs/design/argument-explosion.md): a record
 * parameter can be accepted as its fields, so a call that has the fields
 * on hand allocates no record and the callee reads each field from a
 * parameter instead of through the record's getters.
 *
 * The pass leaves every existing function as it is and adds a `core`
 * beside each eligible one, with the exploded parameters' fields in
 * their place. The original keeps its signature and becomes a
 * forwarder that reads the fields and calls the core, so function
 * values, exports, templates and every other reference to it keep
 * working unchanged. Only a direct call that has some exploded
 * argument's fields on hand calls the core (`#lowerDirectCallTo` in
 * lowering.zena).
 *
 * Two facts decide which parameters explode, both kept per (function,
 * parameter):
 *
 * - Demand, computed bottom-up: a parameter is fields-only when every
 *   use reads a field, destructures it, or passes it whole to a callee
 *   parameter that is itself fields-only. Otherwise the function needs
 *   the record. Summaries start optimistic and only ever turn to
 *   "needs the record" on evidence, so a recursive function that passes
 *   its record to itself is fields-only.
 * - Availability, computed top-down: some reached call passes the
 *   parameter unpacked, as a record literal (reachability's
 *   `recordLiteralArgs`) or as an exploded parameter of the calling
 *   core passed on whole.
 *
 * A parameter explodes when it is both. A record that enters a chain of
 * such functions as a literal is then never built, and one that enters
 * as a heap value is unpacked once, by the first forwarder; no core
 * rebuilds a record it was given as fields.
 *
 * Runs after reachability and every pass that synthesizes callers,
 * before `wasm.layout()`, because it interns signatures.
 */
import { HashMap, HashSet } from 'zena:collections';
import {
  BlockStatement, CallExpression, ClassDeclaration, Expression,
  ExpressionStatement, FunctionExpression, FunctionDeclaration, ReturnStatement,
  VariableDeclaration, IdentifierPattern, Identifier, MemberExpression,
  MethodDefinition, Parameter, RecordLiteral, RecordPattern,
  SuperInitializer, Node,
} from '../../ast.zena';
import { SemanticModel } from '../../semantic-model.zena';
import { Symbol, SymbolId } from '../../scope/symbol.zena';
import { ClassType, FunctionType, RecordType, baseType } from '../../types.zena';
import { walkEnter } from '../../visitor.zena';
import { ValType } from '../wasm.zena';
import {
  WasmModule, WasmFunction, RecordDispatchInfo, ExplosionSpec,
} from '../wasm-module.zena';
import { recordWasmFields, sortedOptionalNames } from '../type-mapping.zena';
import { ReachabilityAnalysis } from '../reachability/analysis.zena';
import {
  RecordResultCall, recordLiteralArgKey, recordLiteralCtorArgKey,
} from '../reachability/context.zena';
import { getClassKey, getClassMethodKey } from '../codegen-utils.zena';

/**
 * A whole-record use of a parameter as argument `index` of a call to the
 * candidate keyed `callee` (`functionKey` or `constructorKey`).
 */
final class Forward {
  callee: String;
  index: i32;
  new(this.callee, this.index);
}

/** The candidate key of the top-level function `id`. */
let functionKey = (id: SymbolId): String => `f${id as i32}`;

/** The candidate key of the unnamed constructor of the class keyed `classKey`. */
let constructorKey = (classKey: String): String => `c${classKey}`;

/**
 * The class a `super(...)` in a constructor of `ct` constructs through:
 * the nearest superclass that is not a mixin's intermediate.
 */
let superWithConstructor = (ct: ClassType): ClassType | null => {
  var s = ct.superType;
  while (s != null) {
    let cur = s as ClassType;
    if (!cur.isMixinIntermediate) {
      return cur;
    }
    s = cur.superType;
  }
  return null;
};

/**
 * A function or constructor whose record parameters might explode, and
 * what is known about each.
 */
final class Candidate {
  f: WasmFunction;
  /** A top-level function's symbol; null for a constructor. */
  self: Symbol | null;
  /** A constructor's class key; null for a function. */
  ctorKey: String | null;
  /** Per parameter, its record dispatch, or null for a non-record parameter. */
  dispatches: GrowableArray<RecordDispatchInfo | null>;
  /** Per parameter, the calls it is passed to whole. */
  forwards: GrowableArray<GrowableArray<Forward>>;
  /** Per parameter, whether every use only needs its fields. */
  fieldsOnly: GrowableArray<boolean>;
  /** Per parameter, whether some reached call passes it unpacked. */
  available: GrowableArray<boolean>;
  /**
   * A function's record result's dispatch, when it could return the
   * fields instead; null for a constructor or a non-record result.
   */
  result: RecordDispatchInfo | null;
  /** The expressions the function returns, for `result`. */
  returns: GrowableArray<Expression>;
  /** Whether the core returns `result`'s fields. */
  var resultExplodes: boolean = false;
  new(this.f, this.self, this.ctorKey, this.dispatches, this.forwards,
      this.fieldsOnly, this.available, this.result, this.returns);

  /** This candidate's key in the pass's lookup. */
  key(): String {
    let {self, ctorKey} = this;
    return if (self != null) functionKey(self.id) else
        constructorKey(ctorKey as String);
  }

  /**
   * Whether some reached call passes parameter `i` a record literal: a
   * call or `new`, or, for a constructor, a subclass's `super(...)`
   * (`superLiterals`, keyed `recordLiteralCtorArgKey`).
   */
  hasLiteralArg(pass: ReachabilityAnalysis, superLiterals: HashSet<String>,
      i: i32): boolean {
    let {self, ctorKey} = this;
    if (self != null) {
      return pass.recordLiteralArgs.has(recordLiteralArgKey(self.id, i));
    }
    if (ctorKey == null) {
      return false;
    }
    let key = recordLiteralCtorArgKey(ctorKey, '<constructor>', i);
    return pass.recordLiteralCtorArgs.has(key) || superLiterals.has(key);
  }
}

export let explodeRecordParameters = (
  wasm: WasmModule,
  pass: ReachabilityAnalysis
): void => {
  // Candidates in module order, for deterministic output; the map is
  // for lookups only.
  let candidates = new Array<Candidate>();
  let byKey = new HashMap<String, Candidate>();
  for (let f in wasm.functions) {
    let c = candidateFor(wasm, f);
    if (c != null) {
      candidates.push(c);
      byKey[c.key()] = c;
    }
  }

  // Demand: a forward keeps a parameter fields-only only while its
  // target is fields-only too, through the same record type.
  var changed = true;
  while (changed) {
    changed = false;
    for (let c in candidates) {
      for (var i = 0; i < c.fieldsOnly.length; i += 1) {
        if (!c.fieldsOnly[i]) {
          continue;
        }
        for (let fw in c.forwards[i]) {
          if (!forwardKeepsFields(byKey, c.dispatches[i], fw)) {
            c.fieldsOnly[i] = false;
            changed = true;
            break;
          }
        }
      }
    }
  }

  // Availability: literal arguments, then exploded parameters passed on.
  let superLiterals = literalSuperArgs(wasm);
  for (let c in candidates) {
    for (var i = 0; i < c.available.length; i += 1) {
      c.available[i] = c.fieldsOnly[i] &&
          c.hasLiteralArg(pass, superLiterals, i);
    }
  }
  changed = true;
  while (changed) {
    changed = false;
    for (let c in candidates) {
      for (var i = 0; i < c.available.length; i += 1) {
        if (!c.available[i]) {
          continue;
        }
        for (let fw in c.forwards[i]) {
          // Demand settled every forward of a fields-only parameter to a
          // fields-only target.
          if (let (true, target) = byKey.get(fw.callee)) {
            if (!target.available[fw.index]) {
              target.available[fw.index] = true;
              changed = true;
            }
          }
        }
      }
    }
  }

  explodeResults(wasm, pass, candidates, byKey);

  for (let c in candidates) {
    let params = new Array<RecordDispatchInfo | null>();
    var any = c.resultExplodes;
    for (var i = 0; i < c.dispatches.length; i += 1) {
      if (c.available[i]) {
        params.push(c.dispatches[i]);
        any = true;
      } else {
        params.push(null);
      }
    }
    if (any) {
      addCore(wasm, pass, c.f, params, 0,
          if (c.resultExplodes) c.result else null);
      let {ctorKey} = c;
      if (ctorKey != null) {
        addPhaseCores(wasm, pass, c.f, params);
      }
    }
  }
};

/**
 * How a call's record result is used: only for its fields (`direct`),
 * returned from the function keyed `returnedFrom`, or neither.
 */
final class ResultUse {
  rc: RecordResultCall;
  callee: String;
  direct: boolean;
  returnedFrom: String | null;
  new(this.rc, this.callee, this.direct, this.returnedFrom);
}

/**
 * Decides which functions return their record result's fields: those
 * some call uses only for its fields (demand) and that have the fields
 * on hand at some return (availability). Both depend on other functions
 * through `return g(...)`, so this iterates from "nothing explodes" up.
 * Marks the calls whose results lowering holds as fields in
 * `wasm.fieldsOnlyResultCalls`.
 */
let explodeResults = (wasm: WasmModule, pass: ReachabilityAnalysis,
    candidates: GrowableArray<Candidate>,
    byKey: HashMap<String, Candidate>): void => {
  let uses = new Array<ResultUse>();
  for (let rc in pass.recordResultCalls) {
    let key = functionKey(rc.callee);
    if (let (true, target) = byKey.get(key)) {
      let result = target.result;
      if (result != null) {
        uses.push(classifyResultUse(rc, key, result, byKey));
      }
    }
  }
  var changed = true;
  while (changed) {
    changed = false;
    for (let c in candidates) {
      if (c.result != null && !c.resultExplodes &&
          producesFields(c, byKey) && resultDemanded(c, uses, byKey)) {
        c.resultExplodes = true;
        changed = true;
      }
    }
  }
  for (let use in uses) {
    if (resultUseHoldsFields(use, byKey)) {
      wasm.fieldsOnlyResultCalls.add((use.rc.call as Node).id as i32);
    }
  }
};

/** Whether `use`'s callee returns fields and `use` only needs them. */
let resultUseHoldsFields = (use: ResultUse,
    byKey: HashMap<String, Candidate>): boolean => {
  if (let (true, callee) = byKey.get(use.callee)) {
    if (!callee.resultExplodes) {
      return false;
    }
  } else {
    return false;
  }
  if (use.direct) {
    return true;
  }
  let from = use.returnedFrom;
  if (from != null) {
    if (let (true, owner) = byKey.get(from)) {
      return owner.resultExplodes;
    }
  }
  return false;
};

/** Whether some call of `c` uses its result only for the fields. */
let resultDemanded = (c: Candidate, uses: GrowableArray<ResultUse>,
    byKey: HashMap<String, Candidate>): boolean => {
  let key = c.key();
  for (let use in uses) {
    if (use.callee != key) {
      continue;
    }
    if (use.direct) {
      return true;
    }
    let from = use.returnedFrom;
    if (from != null) {
      if (let (true, owner) = byKey.get(from)) {
        if (owner.resultExplodes) {
          return true;
        }
      }
    }
  }
  return false;
};

/**
 * Whether some return of `c` has its result's fields on hand: a record
 * literal, an exploded parameter of the same record type, or a call whose
 * result is returned as fields.
 */
let producesFields = (c: Candidate, byKey: HashMap<String, Candidate>): boolean => {
  let fn = c.f.node as FunctionExpression;
  let model = c.f.model;
  for (let e in c.returns) {
    if (e is RecordLiteral) {
      return true;
    }
    if (e is Identifier) {
      let sym = model.resolve(e);
      if (sym != null) {
        for (var i = 0; i < fn.params.length; i += 1) {
          let ps = model.resolveDeclaration(fn.params[i].name);
          if (ps != null && ps.id == sym.id && c.available[i] &&
              c.dispatches[i] === c.result) {
            return true;
          }
        }
      }
    }
    if (e is CallExpression) {
      let callee = e.callee;
      if (callee is Identifier) {
        let calleeSym = model.resolve(callee);
        if (calleeSym != null) {
          if (let (true, target) = byKey.get(
              functionKey(calleeSym.resolveTarget().id))) {
            if (target.resultExplodes && target.result === c.result) {
              return true;
            }
          }
        }
      }
    }
  }
  return false;
};

/** How `rc`'s result is used. */
let classifyResultUse = (rc: RecordResultCall, calleeKey: String,
    result: RecordDispatchInfo, byKey: HashMap<String, Candidate>): ResultUse => {
  let call = rc.call;
  let model = rc.model;
  let owner = enclosingFunction(call, model);
  let parent = model.getParent(call);
  var direct = false;
  var returnedFrom: String | null = null;
  if (parent is MemberExpression) {
    direct = (parent.object as Node) === (call as Node) &&
        !parent.optional && !parent.isSymbolAccess;
  } else if (parent is VariableDeclaration) {
    let pattern = parent.pattern;
    if ((parent.init as Node) === (call as Node)) {
      if (pattern is RecordPattern) {
        direct = true;
      } else if (pattern is IdentifierPattern) {
        if (parent.kind == 'let' && owner != null) {
          direct = boundResultUsesFields(owner as Node, model, pattern,
              result, byKey);
        }
      }
    }
  } else if (owner is FunctionExpression) {
    if (returnsFrom(call, parent, owner)) {
      let ownerSym = declaredSymbol(owner, model);
      if (ownerSym != null) {
        returnedFrom = functionKey(ownerSym.id);
      }
    }
  }
  return new ResultUse(rc, calleeKey, direct, returnedFrom);
};

/**
 * Whether `call`, whose parent is `parent`, is a value `owner` returns:
 * a `return` operand, the expression body, or a value block's tail.
 */
let returnsFrom = (call: CallExpression, parent: Node | null,
    owner: FunctionExpression): boolean => {
  if ((owner.body as Node) === (call as Node)) {
    return true;
  }
  if (parent is ReturnStatement) {
    let arg = parent.argument;
    return arg != null && (arg as Node) === (call as Node) && !parent.isTail;
  }
  if (parent is ExpressionStatement) {
    let body = owner.body;
    if (body is BlockStatement) {
      let stmts = body.body;
      return stmts.length > 0 &&
          (stmts[stmts.length - 1] as Node) === (parent as Node);
    }
  }
  return false;
};

/**
 * Whether the record bound by `let pattern = call` in `owner` is only
 * read for its fields, or passed to parameters of the same record type
 * that are.
 */
let boundResultUsesFields = (owner: Node, model: SemanticModel,
    pattern: IdentifierPattern, result: RecordDispatchInfo,
    byKey: HashMap<String, Candidate>): boolean => {
  let roots = new Array<Node>();
  if (owner is FunctionExpression) {
    roots.push(owner.body as Node);
  } else if (owner is MethodDefinition) {
    let body = owner.body;
    if (body != null) {
      roots.push(body);
    }
    let inits = owner.initializerList;
    if (inits != null) {
      for (let init in inits) {
        roots.push(init);
      }
    }
  }
  let forwards = new Array<Forward>();
  if (!usesOnlyFields(owner, roots, model, pattern, forwards, null)) {
    return false;
  }
  for (let fw in forwards) {
    if (!forwardKeepsFields(byKey, result, fw)) {
      return false;
    }
  }
  return true;
};

/** The function or method whose code `node` is in, if any. */
let enclosingFunction = (node: Node, model: SemanticModel): Node | null => {
  var p = model.getParent(node);
  while (p != null) {
    if (p is FunctionExpression || p is MethodDefinition) {
      return p;
    }
    p = model.getParent(p);
  }
  return null;
};

/**
 * The dispatch of `f`'s record result, when it could be returned as
 * fields: one wasm result, a record type with at least one field.
 */
let resultDispatchOf = (wasm: WasmModule, f: WasmFunction,
    self: Symbol): RecordDispatchInfo | null => {
  if (f.signature.returns.length != 1) {
    return null;
  }
  let ft = f.model.getBindingType(self);
  if (!(ft is FunctionType)) {
    return null;
  }
  let rt = baseType(ft.returnType);
  if (!(rt is RecordType)) {
    return null;
  }
  let d = wasm.findRecordDispatch(
      recordWasmFields(wasm, rt, f), sortedOptionalNames(rt));
  if (d == null || d.fields.length == 0) {
    return null;
  }
  return d;
};

/**
 * Collects the expressions `fn` returns into `out`: `return` operands
 * outside nested functions, the expression body, or a value block's
 * tail. False when `fn` has a `tail return`, whose call the core could
 * not turn into fields.
 */
let collectReturns = (fn: FunctionExpression, model: SemanticModel,
    out: GrowableArray<Expression>): boolean => {
  let body = fn.body;
  if (!(body is BlockStatement)) {
    out.push(body as Expression);
    return true;
  }
  var ok = true;
  walkEnter(body, (n: Node): void => {
    if (n is ReturnStatement) {
      if (enclosingFunction(n, model) === (fn as Node)) {
        if (n.isTail) {
          ok = false;
        }
        let arg = n.argument;
        if (arg != null) {
          out.push(arg);
        }
      }
    }
  });
  let stmts = body.body;
  if (stmts.length > 0) {
    let last = stmts[stmts.length - 1];
    if (last is ExpressionStatement) {
      out.push(last.expression);
    }
  }
  return ok;
};

/**
 * Cores for the phase functions of a constructor whose parameters
 * explode: a subclass's `super(...)` calls `<ctor-init>` and
 * `<ctor-body>`, not the factory. They exist only for a class some
 * reached constructor extends. `<ctor-body>` takes the instance first.
 */
let addPhaseCores = (wasm: WasmModule, pass: ReachabilityAnalysis,
    factory: WasmFunction, params: GrowableArray<RecordDispatchInfo | null>): void => {
  let classKey = getClassKey(factory.classType as ClassType);
  if (let (true, init) = wasm.classMethodMap.get(
      getClassMethodKey(classKey, '<ctor-init>'))) {
    addCore(wasm, pass, init, params, 0, null);
  }
  if (let (true, body) = wasm.classMethodMap.get(
      getClassMethodKey(classKey, '<ctor-body>'))) {
    addCore(wasm, pass, body, params, 1, null);
  }
};

/** Adds the literal arguments of `md`'s unnamed `super(...)` to `out`. */
let noteLiteralSuperArgs = (md: MethodDefinition, ct: ClassType,
    out: HashSet<String>): void => {
  let si = md.superInitializer;
  let superCt = superWithConstructor(ct);
  if (si is SuperInitializer && superCt != null) {
    if (si.constructorName == null) {
      let superKey = getClassKey(superCt) as String;
      for (var k = 0; k < si.args.length; k += 1) {
        if (si.args[k] is RecordLiteral) {
          out.add(recordLiteralCtorArgKey(superKey, '<constructor>', k));
        }
      }
    }
  }
};

/**
 * The `recordLiteralCtorArgKey`s of the record literals reached
 * constructors pass to an unnamed `super(...)`.
 */
let literalSuperArgs = (wasm: WasmModule): HashSet<String> => {
  let out = new HashSet<String>();
  for (let f in wasm.functions) {
    let ct = f.classType;
    let md = f.node;
    let meth = f.methodName;
    if (ct != null && meth != null &&
        (meth as String).startsWith('<constructor>') &&
        md is MethodDefinition) {
      noteLiteralSuperArgs(md, ct, out);
    }
  }
  return out;
};

/**
 * Adds `f`'s core, taking each exploded parameter's fields. The first
 * `leading` parameters of `f`'s signature (a phase's instance) are not
 * declared parameters and stay as they are.
 */
let addCore = (wasm: WasmModule, pass: ReachabilityAnalysis, f: WasmFunction,
    params: GrowableArray<RecordDispatchInfo | null>, leading: i32,
    result: RecordDispatchInfo | null): void => {
  let sig = f.signature;
  let coreParams = new Array<ValType>();
  for (var i = 0; i < leading; i += 1) {
    coreParams.push(sig.params[i]);
  }
  for (var i = 0; i < params.length; i += 1) {
    let d = params[i];
    if (d == null) {
      coreParams.push(sig.params[leading + i]);
    } else {
      for (let field in d.fields) {
        coreParams.push(field.type);
      }
    }
  }
  var coreReturns = sig.returns;
  if (result != null) {
    coreReturns = new Array<ValType>();
    for (let field in result.fields) {
      coreReturns.push(field.type);
    }
  }
  let coreSig = wasm.getSignature(coreParams, coreReturns);
  pass.markTypeReached(coreSig);
  let core = new WasmFunction(coreSig, f.node, f.model);
  core.name = `${f.name ?? 'function'}.core`;
  // A constructor's core lowers as a factory too. It has no method name:
  // `layout()` rebuilds the class method map from method names, and the
  // core must not replace the factory every `new` looks up.
  core.classType = f.classType;
  core.structType = f.structType;
  core.classDecl = f.classDecl;
  let spec = new ExplosionSpec(params, f, core, result);
  f.explosion = spec;
  core.explosion = spec;
  wasm.addFunction(core);
  pass.markFunctionReached(core);
};

/**
 * Whether passing a record whole, as `fw`, needs only its fields: the
 * callee is a candidate whose matching parameter takes the same record
 * type and is fields-only.
 */
let forwardKeepsFields = (byKey: HashMap<String, Candidate>,
    dispatch: RecordDispatchInfo | null, fw: Forward): boolean => {
  if (let (true, target) = byKey.get(fw.callee)) {
    if (fw.index >= target.dispatches.length) {
      return false;
    }
    let targetDispatch = target.dispatches[fw.index];
    return targetDispatch != null && targetDispatch === dispatch &&
        target.fieldsOnly[fw.index];
  }
  return false;
};

/**
 * `f` as a candidate, with each record parameter's uses classified, or
 * null when `f` can take no core.
 */
let candidateFor = (wasm: WasmModule, f: WasmFunction): Candidate | null => {
  if (f.classType != null) {
    return constructorCandidateFor(wasm, f);
  }
  // A plain top-level function: no receiver, context, type parameters
  // or suspension machinery, and nothing synthesized.
  let captures = f.captures;
  if (f.structType != null || f.isClosure ||
      f.contextStruct != null || (captures != null && captures.length > 0) ||
      f.capturesThis || f.typeParameters != null ||
      f.typeArguments != null || f.intrinsic != null || f.isImport ||
      f.isFunctionAdaptation || f.isClosureWrapper ||
      f.isClosureTrampoline || f.closureForwarder != null ||
      f.explosion != null) {
    return null;
  }
  let fn = f.node;
  if (!(fn is FunctionExpression)) {
    return null;
  }
  if (fn.isAsync || fn.isGenerator || fn.typeParameters != null) {
    return null;
  }
  let sig = f.signature;
  // One slot per declared parameter: no zero-width ones to skip.
  if (sig.returns.length > 1 || sig.params.length != fn.params.length) {
    return null;
  }
  let model = f.model;
  let self = declaredSymbol(fn, model);
  if (self == null) {
    return null;
  }
  if (let (true, mapped) = wasm.functionMap.get(self.id)) {
    if (mapped !== f) {
      return null;
    }
  } else {
    return null;
  }
  // An injected default can name an earlier parameter, which the core
  // no longer has as one value; such calls would need the record.
  for (let p in fn.params) {
    if (p.defaultValue != null) {
      return null;
    }
  }
  let roots = new Array<Node>();
  roots.push(fn.body as Node);
  var result = resultDispatchOf(wasm, f, self);
  let returns = new Array<Expression>();
  if (result != null && !collectReturns(fn, model, returns)) {
    result = null;
  }
  return classifyParams(wasm, f, fn, fn.params, roots, self, null, null,
      result, returns);
};

/**
 * A class's own written constructor as a candidate: the factory `new`
 * calls, on a plain, non-generic class. Its phase functions, which a
 * subclass's `super(...)` calls, keep the boxed signature.
 */
let constructorCandidateFor = (wasm: WasmModule,
    f: WasmFunction): Candidate | null => {
  let ct = f.classType as ClassType;
  let typeArgs = ct.typeArguments;
  let typeParams = ct.typeParameters;
  if (ct.isExtension || ct.isCaseClass || ct.isMixinIntermediate ||
      ct.isResource || (typeParams != null && typeParams.length > 0) ||
      (typeArgs != null && typeArgs.length > 0) ||
      f.methodName == null || (f.methodName as String) != '<constructor>' ||
      f.explosion != null || !(f.classDecl is ClassDeclaration)) {
    return null;
  }
  let md = f.node;
  if (!(md is MethodDefinition)) {
    return null;
  }
  if (!md.isConstructor || md.decorators.length > 0 || md.isAsync ||
      md.isGenerator) {
    return null;
  }
  let sig = f.signature;
  if (sig.returns.length != 1 || sig.params.length != md.params.length) {
    return null;
  }
  let classKey = getClassKey(ct);
  if (let (true, mapped) = wasm.classMethodMap.get(
      getClassMethodKey(classKey, '<constructor>'))) {
    if (mapped !== f) {
      return null;
    }
  } else {
    return null;
  }
  for (let p in md.params) {
    if (p.defaultValue != null || p.isThisParam) {
      return null;
    }
  }
  let roots = new Array<Node>();
  let body = md.body;
  if (body != null) {
    roots.push(body);
  }
  let inits = md.initializerList;
  if (inits != null) {
    for (let init in inits) {
      roots.push(init);
    }
  }
  let superInit = md.superInitializer;
  if (superInit != null) {
    roots.push(superInit);
  }
  let superCt = superWithConstructor(ct);
  let superKey = if (superCt != null)
      constructorKey(getClassKey(superCt) as String) else null;
  return classifyParams(wasm, f, md, md.params, roots, null,
      classKey as String, superKey, null, new Array<Expression>());
};

/**
 * The candidate for `f`, whose declaration `owner` has `params` and
 * whose code is `roots`, or null when no parameter is a record it only
 * needs the fields of.
 */
let classifyParams = (wasm: WasmModule, f: WasmFunction, owner: Node,
    params: GrowableArray<Parameter>, roots: GrowableArray<Node>,
    self: Symbol | null, ctorKey: String | null,
    superKey: String | null, result: RecordDispatchInfo | null,
    returns: GrowableArray<Expression>): Candidate | null => {
  let dispatches = new Array<RecordDispatchInfo | null>();
  let forwards = new Array<GrowableArray<Forward>>();
  let fieldsOnly = new Array<boolean>();
  let available = new Array<boolean>();
  var anyRecord = false;
  for (let p in params) {
    let out = new Array<Forward>();
    let d = recordDispatchOfParam(wasm, f, p.name);
    let usesFields = d != null &&
        usesOnlyFields(owner, roots, f.model, p.name, out, superKey);
    dispatches.push(if (usesFields) d else null);
    forwards.push(out);
    fieldsOnly.push(usesFields);
    available.push(false);
    if (usesFields) {
      anyRecord = true;
    }
  }
  if (!anyRecord && result == null) {
    return null;
  }
  return new Candidate(f, self, ctorKey, dispatches, forwards, fieldsOnly,
      available, result, returns);
};

/** The dispatch of a parameter whose declared type is a record type. */
let recordDispatchOfParam = (wasm: WasmModule, f: WasmFunction,
    name: Identifier): RecordDispatchInfo | null => {
  let sym = f.model.resolveDeclaration(name);
  if (sym == null) {
    return null;
  }
  let declared = f.model.getBindingType(sym);
  if (declared == null) {
    return null;
  }
  let rt = baseType(declared);
  if (!(rt is RecordType)) {
    return null;
  }
  return wasm.findRecordDispatch(
      recordWasmFields(wasm, rt, f), sortedOptionalNames(rt));
};

/** The symbol a top-level function's declaration binds. */
let declaredSymbol = (fn: FunctionExpression, model: SemanticModel): Symbol | null => {
  let parent = model.getParent(fn);
  if (parent is FunctionDeclaration) {
    return model.resolveDeclaration(parent.name);
  }
  if (parent is VariableDeclaration) {
    let pattern = parent.pattern;
    if (pattern is IdentifierPattern) {
      return model.resolveDeclaration(pattern);
    }
  }
  return null;
};

/**
 * Whether every use in `roots` of the parameter declared by `name` reads
 * a field or passes the record whole to a top-level function, recording
 * each such call in `forwards`. Any other use needs the record itself,
 * and the core would rebuild it on entry, which moves the allocation
 * instead of removing it.
 */
let usesOnlyFields = (owner: Node, roots: GrowableArray<Node>,
    model: SemanticModel, name: Node,
    forwards: GrowableArray<Forward>, superKey: String | null): boolean => {
  let param = model.resolveDeclaration(name);
  if (param == null) {
    return false;
  }
  var ok = true;
  for (let root in roots) {
    walkEnter(root, (n: Node): void => {
      if (ok && n is Identifier) {
        let sym = model.resolve(n);
        if (sym != null && sym.id == param.id &&
            !isFieldUse(n, owner, model, forwards, superKey)) {
          ok = false;
        }
      }
    });
  }
  return ok;
};

/**
 * `ident.field`, `let {...} = ident`, `g(..., ident, ...)` for a
 * top-level function `g`, or `super(..., ident, ...)` to the unnamed
 * constructor keyed `superKey`, outside any nested function: a closure
 * would capture the record.
 */
let isFieldUse = (ident: Identifier, owner: Node,
    model: SemanticModel, forwards: GrowableArray<Forward>,
    superKey: String | null): boolean => {
  let parent = model.getParent(ident);
  var accepted = false;
  var forward: Forward | null = null;
  if (parent is MemberExpression) {
    accepted = (parent.object as Node) === (ident as Node) &&
        !parent.optional && !parent.isSymbolAccess;
  } else if (parent is VariableDeclaration) {
    let pattern = parent.pattern;
    accepted = (parent.init as Node) === (ident as Node) &&
        pattern is RecordPattern;
  } else if (parent is CallExpression) {
    forward = forwardOf(parent, ident, model);
    accepted = forward != null;
  } else if (parent is SuperInitializer) {
    if (superKey != null && parent.constructorName == null) {
      for (var k = 0; k < parent.args.length; k += 1) {
        if ((parent.args[k] as Node) === (ident as Node)) {
          forward = new Forward(superKey, k);
        }
      }
    }
    accepted = forward != null;
  }
  if (!accepted) {
    return false;
  }
  var p = model.getParent(parent as Node);
  while (p != null && p !== owner) {
    if (p is FunctionExpression) {
      return false;
    }
    p = model.getParent(p);
  }
  if (forward != null) {
    forwards.push(forward);
  }
  return true;
};

/** `ident` as an argument of a direct call to a module-level function. */
let forwardOf = (call: CallExpression, ident: Identifier,
    model: SemanticModel): Forward | null => {
  let callee = call.callee;
  if (!(callee is Identifier)) {
    return null;
  }
  let calleeSym = model.resolve(callee);
  if (calleeSym == null) {
    return null;
  }
  for (var k = 0; k < call.args.length; k += 1) {
    if ((call.args[k] as Node) === (ident as Node)) {
      return new Forward(functionKey(calleeSym.resolveTarget().id), k);
    }
  }
  return null;
};
