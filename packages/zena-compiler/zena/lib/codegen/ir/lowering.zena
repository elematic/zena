/**
 * AST → ZIR lowering (docs/design/ir.md §6), M2 slice 1.
 *
 * Covers plain top-level functions over scalar wasm types (i32/i64/
 * f32/f64, plus booleans as i32): literals, locals, assignments
 * (including compound), signed arithmetic/comparison/bitwise operators,
 * short-circuit && and ||, unary -/!/~, if/else, while with break and
 * continue, and return.
 *
 * Everything else bails out by throwing ZirUnsupported, which
 * tryLowerFunction converts to null; the caller then falls back to the
 * streaming FunctionGenerator for that function. The bail is a migration
 * mechanism, not a fuzzy fallback: coverage is tracked per module and the
 * set of bails shrinks as lowering grows.
 *
 * SSA construction is the structured-AST form: an environment maps each
 * variable symbol to its current value; control-flow joins introduce
 * block parameters for the variables assigned in the joined regions
 * (computed by a pre-scan), and loop headers carry parameters for every
 * variable assigned anywhere in the loop.
 */
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { HashSet } from 'zena:set';
import { Error } from 'zena:error';
import { parseF64, parseI32 } from 'zena:string-convert';
import {
  Node, Statement, Expression, FunctionExpression, BlockStatement,
  ReturnStatement, BreakStatement, ContinueStatement, IfStatement,
  WhileStatement, ExpressionStatement, VariableDeclaration,
  BinaryExpression, UnaryExpression, AssignmentExpression, Identifier,
  NumberLiteral, BooleanLiteral, IdentifierPattern, BindingPattern, Pattern,
  CallExpression, IfExpression, AsExpression, ForStatement, ForInStatement,
  NullLiteral, StringLiteral, NewExpression, MemberExpression,
  MethodDefinition, ThisExpression, Parameter, ClassDeclaration,
  FieldDefinition, FieldInitializer, SuperInitializer, TypeAnnotation,
  MatchExpression, AsPattern, ClassPattern, LogicalPattern, LiteralPattern,
  TupleLiteral, getMemberPropertyName
} from '../../ast.zena';
import { Type, I32Type, I64Type, U32Type, U64Type, F32Type, F64Type, BooleanType, VoidType, ClassType, InterfaceType, ThisType, FunctionType, FieldInfo, ArrayType, InlineTupleType, baseType, isVoidOrNeverType } from '../../types.zena';
import { InterfaceAdaptation } from '../../semantic-model.zena';
import { SymbolId, Symbol } from '../../scope/symbol.zena';
import { walkEnter } from '../../visitor.zena';
import { ValType, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeRef, ValTypeRefNull, ValTypeAnyRef, ValTypeEqRef, ValTypeStructRef, valTypeEquals, isRefValType } from '../wasm.zena';
import { WasmModule, WasmFunction, WasmStruct, WasmGlobal, WasmSignature, WasmArray, ClassCodegenInfo, isValSubtype } from '../wasm-module.zena';
import { typeToValTypeWithSub, eraseTypeParameters, substituteTypeParamsInClassContext, getClosureStruct, getClosureKey, getCellStruct } from '../type-mapping.zena';
import { parseI64OrU64Literal } from '../expr/primitives.zena';
import { IrBody, IrOp, IrRefFunc, IrRefGlobal, IrRefType, IrRefField } from './ir.zena';
import { getClassKey, getClassMethodKey, getClassPrivateFieldKey, getMemberRootClass, getInterfaceKey, getClassInterfaceKey, getClosureSpecializationKey, ClassKey } from '../codegen-utils.zena';
import { IrBuilder } from './builder.zena';

/**
 * Thrown for constructs lowering does not model YET: tryLowerFunction
 * catches exactly this type and falls back to the streaming generator
 * (fatal under zir-strict). States the checker guarantees impossible
 * are NOT ZirUnsupported — throw a plain Error for those, which
 * propagates and fails the compile: a silent fallback would hide a
 * lowering bug.
 */
export final class ZirUnsupported extends Error {
  new(reason: String) : super('zir unsupported: ' + reason);
}

/**
 * Synthesized or adapted machinery lowering does not model: wrappers,
 * trampolines, accessor thunks, case-class equality/hash synthesis,
 * generics, and intrinsics. The direct-call gate in #lowerCall shares
 * several of these tests but intentionally differs — imports and class
 * methods are callable, just not lowerable.
 */
let usesSynthesizedMachinery = (func: WasmFunction): boolean => {
  return func.importWrapperTarget != null ||
      func.interfaceTrampolineTarget != null || func.isFunctionAdaptation ||
      func.isClosureWrapper || func.isClosureTrampoline ||
      func.getterStruct != null || func.setterStruct != null ||
      func.isCaseClassEq || func.isCaseClassHash ||
      func.typeParameters != null || func.typeArguments != null ||
      func.intrinsic != null;
};

final class MemberTarget {
  owner: WasmStruct;
  /** Set for physical-field reads. */
  fieldName: String | null;
  /** Set for direct getter calls. */
  getter: WasmFunction | null;
  new(this.owner, this.fieldName, this.getter);
}

final class LoopCtx {
  /** Where `continue` jumps: the header for while, the update block for for. */
  continueTarget: i32;
  exit: i32;
  carried: Array<SymbolId>;
  new(this.continueTarget, this.exit, this.carried);
}

/**
 * Attempts to lower `func` to ZIR. Returns null when the function uses
 * anything outside the currently supported subset; in strict mode
 * (ZENA_BACKEND=zir-strict) the ZirUnsupported propagates instead —
 * the migration ratchet for proving zero-fallback coverage before the
 * streaming path is deleted (ir.md §14 M4). When `bailReasons` is
 * provided (ZENA_ZIR_STATS=1), each fallback increments its reason so
 * coverage work can chase the biggest blockers first.
 */
export let tryLowerFunction = (wasm: WasmModule, func: WasmFunction, strict: boolean = false, bailReasons: HashMap<String, i32> | null = null): IrBody | null => {
  if (strict) {
    return lowerFunctionOrThrow(wasm, func);
  }
  // ZirUnsupported means "fall back to the streaming generator"; any
  // other exception is a lowering bug and propagates.
  let result: IrBody | null = try {
    lowerFunctionOrThrow(wasm, func)
  } catch (e) {
    if (e is ZirUnsupported) {
      if (bailReasons != null) {
        let reasons = bailReasons as HashMap<String, i32>;
        let key = (e as ZirUnsupported).message;
        let count = if (let (true, c) = reasons.get(key)) c else 0;
        reasons[key] = count + 1;
      }
      null
    } else {
      throw e
    }
  };
  return result;
};

/** Entry block with one param per signature slot; leaves it current. */
let synthEntryParams = (b: IrBuilder, func: WasmFunction): Array<i32> => {
  let entry = b.newBlock();
  let params = new Array<i32>();
  for (let vt in func.signature.params) {
    params.push(b.blockParam(entry, vt));
  }
  b.switchTo(entry);
  return params;
};

/**
 * Casts a value to a concrete-ref parameter type. Mirrors streaming's
 * trampoline casts, which are NON-null (emitRefCast) even when the
 * target slot is declared nullable. Non-concrete targets pass through.
 */
let castToConcreteRef = (b: IrBuilder, value: i32, targetVt: ValType): i32 => {
  var castVt: ValType | null = null;
  match (targetVt) {
    case ValTypeRef as r: { castVt = new ValTypeRef(r.target); }
    case ValTypeRefNull as rn: { castVt = new ValTypeRef(rn.target); }
    case _: {}
  }
  if (castVt == null) {
    return value;
  }
  let vt = castVt as ValType;
  return b.emit(IrOp.ref_cast, vt, value, b.internType(vt));
};

/**
 * Interface trampoline: cast the erased receiver to the target's
 * concrete type, cast any erased params likewise, and tail into the
 * target (docs: FunctionGenerator's interfaceTrampolineTarget arm).
 */
let synthesizeInterfaceTrampoline = (func: WasmFunction): IrBody => {
  let target = func.interfaceTrampolineTarget as WasmFunction;
  let b = new IrBuilder();
  let params = synthEntryParams(b, func);
  if (target.intrinsic != null) {
    if ((target.intrinsic as String) == 'array.len') {
      let recv = castToConcreteRef(b, params[0], target.signature.params[0]);
      let len = b.emit(IrOp.array_len, new ValTypeI32(), recv, -1);
      b.ret(len);
      return b.finish();
    }
    b.unreachable();
    return b.finish();
  }
  if (target.index == -1) {
    // Target never reached; streaming emits the same trap.
    b.unreachable();
    return b.finish();
  }
  if (func.signature.params.length != target.signature.params.length) {
    throw new ZirUnsupported('trampoline shape');
  }
  let args = new Array<i32>();
  args.push(castToConcreteRef(b, params[0], target.signature.params[0]));
  for (var i = 1; i < params.length; i += 1) {
    var v = params[i];
    if (!valTypeEquals(func.signature.params[i], target.signature.params[i])) {
      v = castToConcreteRef(b, v, target.signature.params[i]);
    }
    args.push(v);
  }
  let funcRef = b.addRef(new IrRefFunc(target));
  if (target.signature.returns.length > 1) {
    // Multi-result target (e.g. Iterator.next): project and re-return.
    if (func.signature.returns.length != target.signature.returns.length) {
      throw new ZirUnsupported('trampoline result shape');
    }
    let projs = b.callFuncMulti(funcRef, args, target.signature.returns);
    b.retMulti(projs);
    return b.finish();
  }
  let resultType = if (target.signature.returns.length == 1) target.signature.returns[0] else null;
  let result = b.callFunc(funcRef, args, resultType);
  if (func.signature.returns.length == 1) {
    if (resultType == null) {
      throw new ZirUnsupported('trampoline result shape');
    }
    b.ret(result);
  } else {
    b.retVoid();
  }
  return b.finish();
};

/**
 * Synthesized default accessors: cast the erased receiver to the
 * declaring struct and read (getter) or write (setter) the field,
 * with the getter's vtable-signature compat casts mirrored from
 * streaming. A field index of -1 means the accessor is a vtable slot
 * for a member no reachable class stores physically — it traps.
 */
let synthesizeAccessor = (func: WasmFunction, isGetter: boolean): IrBody => {
  let st = if (isGetter) func.getterStruct as WasmStruct
      else func.setterStruct as WasmStruct;
  let idx = if (isGetter) func.getterFieldIndex else func.setterFieldIndex;
  let b = new IrBuilder();
  let params = synthEntryParams(b, func);
  if (idx == -1) {
    b.unreachable();
    return b.finish();
  }
  let fieldName = st.fields[idx].name;
  if (fieldName == null) {
    throw new ZirUnsupported('unnamed accessor field');
  }
  let castVt: ValType = new ValTypeRef(st);
  let casted = b.emit(IrOp.ref_cast, castVt, params[0], b.internType(castVt));
  let fieldRef = b.addRef(new IrRefField(st, fieldName));
  if (!isGetter) {
    let pairIdx = b.pushExtra(twoValuesOf(casted, params[1]));
    b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
    b.retVoid();
    return b.finish();
  }
  let actual = st.fields[idx].type;
  var read = b.emit(IrOp.struct_get, actual, casted, fieldRef);
  if (func.signature.returns.length == 0) {
    b.retVoid();
    return b.finish();
  }
  // The getter's declared return is the vtable slot's erased type; cast
  // when the field's storage type differs (mirrors streaming).
  let expected = func.signature.returns[0];
  match (expected) {
    case ValTypeRefNull as r: {
      var same = false;
      match (actual) {
        case ValTypeRefNull as a: { same = a.target == r.target; }
        case _: {}
      }
      if (!same) {
        let vt: ValType = new ValTypeRefNull(r.target);
        read = b.emit(IrOp.ref_cast, vt, read, b.internType(vt));
      }
    }
    case ValTypeRef as r: {
      var same = false;
      match (actual) {
        case ValTypeRef as a: { same = a.target == r.target; }
        case _: {}
      }
      if (!same) {
        let vt: ValType = new ValTypeRef(r.target);
        read = b.emit(IrOp.ref_cast, vt, read, b.internType(vt));
      }
    }
    case ValTypeEqRef: {
      if (!(actual is ValTypeEqRef)) {
        let vt: ValType = new ValTypeEqRef();
        read = b.emit(IrOp.ref_cast, vt, read, b.internType(vt));
      }
    }
    case _: {}
  }
  b.ret(read);
  return b.finish();
};

/** Closure wrapper: forward params[1..] (dropping the ctx) to the target. */
let synthesizeClosureWrapper = (func: WasmFunction): IrBody => {
  if (func.closureWrapperTarget == null) {
    throw new ZirUnsupported('closure wrapper without target');
  }
  let target = func.closureWrapperTarget as WasmFunction;
  if (func.signature.params.length != target.signature.params.length + 1) {
    throw new ZirUnsupported('closure wrapper shape');
  }
  let b = new IrBuilder();
  let params = synthEntryParams(b, func);
  let args = new Array<i32>();
  for (var i = 1; i < params.length; i += 1) {
    args.push(params[i]);
  }
  let funcRef = b.addRef(new IrRefFunc(target));
  if (target.signature.returns.length > 1) {
    if (func.signature.returns.length != target.signature.returns.length) {
      throw new ZirUnsupported('closure wrapper result shape');
    }
    let projs = b.callFuncMulti(funcRef, args, target.signature.returns);
    b.retMulti(projs);
    return b.finish();
  }
  let resultType = if (target.signature.returns.length == 1) target.signature.returns[0] else null;
  let result = b.callFunc(funcRef, args, resultType);
  if (func.signature.returns.length == 1) {
    if (resultType == null) {
      throw new ZirUnsupported('closure wrapper result shape');
    }
    b.ret(result);
  } else {
    b.retVoid();
  }
  return b.finish();
};

/** The one intrinsic with a body streaming synthesizes: array.len. */
let synthesizeIntrinsic = (func: WasmFunction): IrBody => {
  if ((func.intrinsic as String) != 'array.len' ||
      func.signature.params.length != 1 || func.signature.returns.length != 1) {
    throw new ZirUnsupported('intrinsic');
  }
  let b = new IrBuilder();
  let params = synthEntryParams(b, func);
  let len = b.emit(IrOp.array_len, new ValTypeI32(), params[0], -1);
  b.ret(len);
  return b.finish();
};

let twoValuesOf = (a: i32, bVal: i32): Array<i32> => {
  let result = new Array<i32>();
  result.push(a);
  result.push(bVal);
  return result;
};

let lowerFunctionOrThrow = (wasm: WasmModule, func: WasmFunction): IrBody => {
  // Metadata-only functions first: no AST, but their bodies are tiny
  // fixed shapes ZIR synthesizes directly (they are half of all
  // fallbacks on the compiler itself). The node==null gate matters:
  // DECLARED accessors also carry getterStruct/setterStruct, but they
  // have real bodies (and often no physical field), so they take the
  // normal lowering path below.
  if (func.node == null) {
    if (func.interfaceTrampolineTarget != null) {
      return synthesizeInterfaceTrampoline(func);
    }
    if (func.getterStruct != null) {
      return synthesizeAccessor(func, true);
    }
    if (func.setterStruct != null) {
      return synthesizeAccessor(func, false);
    }
    if (func.isClosureWrapper) {
      return synthesizeClosureWrapper(func);
    }
    if (func.intrinsic != null) {
      return synthesizeIntrinsic(func);
    }
    if (func.methodName != null &&
        (func.methodName as String) == '<constructor>') {
      let lowerer = new FunctionLowerer(wasm, func);
      return lowerer.lowerSynthesizedConstructor();
    }
    throw new ZirUnsupported("synthesized function");
  }
  // No adaptations, trampolines, synthesized accessors, imports, or
  // generics. Plain top-level functions, written-out method bodies,
  // constructors, and closure implementation bodies are eligible.
  if (func.isImport || usesSynthesizedMachinery(func)) {
    throw new ZirUnsupported("function shape");
  }
  if (func.isClosure) {
    if (func.contextStruct == null) {
      throw new ZirUnsupported("closure without context struct");
    }
  } else if (func.captures.length > 0 || func.capturesThis ||
             func.contextStruct != null) {
    // Capture state on a non-closure is a shape lowering doesn't know.
    throw new ZirUnsupported("function shape");
  }
  if (func.node is MethodDefinition) {
    let md = func.node as MethodDefinition;
    var methName = "";
    if (md.name is Identifier) {
      methName = (md.name as Identifier).name;
    }
    let isCtor = methName == "<constructor>";
    // Declares/abstracts have no body; non-constructor methods with
    // initializer machinery would be malformed; decorated constructors
    // (synthetic case-class ctors) have argument-forwarding rules the
    // prologue lowering does not model.
    if (md.isDeclare || md.isAbstract || md.typeParameters != null ||
        (!isCtor && (md.body == null || md.initializerList != null ||
                     md.superInitializer != null)) ||
        (isCtor && md.decorators.length > 0)) {
      throw new ZirUnsupported("method shape");
    }
  } else if (!(func.node is FunctionExpression)) {
    throw new ZirUnsupported("synthesized function");
  } else if (!func.isClosure &&
             (func.classType != null || func.structType != null)) {
    // A non-closure FunctionExpression carrying class context
    // (extension methods) still bails; closures keep their enclosing
    // class context for `this` captures and type substitution.
    throw new ZirUnsupported("function shape");
  }
  let lowerer = new FunctionLowerer(wasm, func);
  return lowerer.lower();
};

final class FunctionLowerer {
  wasm: WasmModule;
  func: WasmFunction;
  b = new IrBuilder();
  var env = new HashMap<SymbolId, i32>();
  /** Symbols behind env entries, for binding-type lookups at merges. */
  symbols = new HashMap<SymbolId, Symbol>();
  loops = new Array<LoopCtx>();
  var reachable = true;
  /** The receiver value for instance methods; -1 elsewhere. */
  var thisValue = -1;

  new(this.wasm, this.func);

  lower(): IrBody {
    let sig = this.func.signature;
    for (let rt in sig.returns) {
      this.#requireSupported(rt, 'return type');
    }

    var params: Array<Parameter> | null = null;
    var bodyNode: Node | null = null;
    var paramOffset = 0;
    var ctorDef: MethodDefinition | null = null;
    let node = this.func.node as Node;
    if (node is MethodDefinition) {
      let md = node as MethodDefinition;
      params = md.params;
      bodyNode = md.body;
      if (!md.isStatic) {
        paramOffset = 1;
      }
      var methName = "";
      if (md.name is Identifier) {
        methName = (md.name as Identifier).name;
      }
      if (methName == "<constructor>") {
        ctorDef = md;
      }
    } else {
      let fExpr = node as FunctionExpression;
      params = fExpr.params;
      bodyNode = fExpr.body;
      if (this.func.isClosure) {
        // Closure implementations take their context as param 0.
        paramOffset = 1;
      }
    }
    let paramList = params as Array<Parameter>;
    if (sig.params.length != paramList.length + paramOffset) {
      this.#bail('signature/param shape mismatch');
    }

    let entry = this.b.newBlock();
    var ctxParam = -1;
    if (paramOffset == 1) {
      this.#requireSupported(sig.params[0], 'receiver type');
      let p0 = this.b.blockParam(entry, sig.params[0]);
      if (this.func.isClosure) {
        ctxParam = p0;
      } else {
        this.thisValue = p0;
      }
    }
    var needsThisDowncast = false;
    if (paramOffset == 1 && ctorDef == null && !this.func.isClosure &&
        this.func.classType != null && this.func.methodName != null) {
      // Override methods receive the ROOT class's receiver type (vtable
      // signature compatibility) and must downcast to their own class.
      let ct = this.func.classType as ClassType;
      let rootClass = getMemberRootClass(ct, this.func.methodName as String);
      if (ct != rootClass) {
        needsThisDowncast = true;
      }
    }
    for (var i = 0; i < paramList.length; i += 1) {
      let p = paramList[i];
      if (p.pattern != null || p.isThisParam || p.defaultValue != null) {
        this.#bail('parameter shape');
      }
      let sym = this.func.model.resolveDeclaration(p.name);
      if (sym == null) {
        this.#bail('unresolved parameter');
      }
      let vt = sig.params[i + paramOffset];
      this.#requireSupported(vt, 'parameter type');
      let value = this.b.blockParam(entry, vt);
      this.env[(sym as Symbol).id] = value;
      this.symbols[(sym as Symbol).id] = sym as Symbol;
    }
    this.b.switchTo(entry);
    // Celled parameters (captured and mutated through a closure) move
    // into their heap cells before any body code runs.
    for (var i = 0; i < paramList.length; i += 1) {
      let sym = this.func.model.resolveDeclaration(paramList[i].name);
      if (sym != null && this.#isCelled((sym as Symbol).id)) {
        let symId = (sym as Symbol).id;
        this.env[symId] = this.#cellAlloc(
            sig.params[i + paramOffset], this.env[symId]);
      }
    }
    if (needsThisDowncast) {
      let ct = this.func.classType as ClassType;
      var infoOpt: ClassCodegenInfo | null = null;
      if (let (true, info) = this.wasm.classInfos.get(getClassKey(ct))) {
        infoOpt = info;
      }
      if (infoOpt == null) {
        this.#bail('override class not discovered');
      }
      let ownStruct = (infoOpt as ClassCodegenInfo).structType;
      let castVt = new ValTypeRef(ownStruct) as ValType;
      this.thisValue = this.b.emit(IrOp.ref_cast, castVt, this.thisValue,
          this.b.internType(castVt));
    }
    if (this.func.isClosure) {
      this.#lowerClosurePrologue(ctxParam);
    }

    if (ctorDef != null) {
      this.#lowerConstructorPrologue(ctorDef as MethodDefinition);
      if (bodyNode != null) {
        this.#lowerStatement(bodyNode as Statement);
      }
      if (this.reachable) {
        this.b.retVoid();
      }
      return this.b.finish();
    }

    let body = bodyNode as Node;
    if (body is BlockStatement) {
      this.#lowerStatement(body as Statement);
      if (this.reachable) {
        if (sig.returns.length == 0) {
          this.b.retVoid();
        } else {
          // The checker guarantees a returning path; a reachable block end
          // here means dead code we could not prove terminated.
          this.b.unreachable();
        }
      }
    } else {
      // Expression-bodied function.
      if (sig.returns.length == 0) {
        this.#bail('void expression body');
      }
      if (sig.returns.length > 1) {
        this.#lowerMultiReturn(body as Expression);
      } else {
        let value = this.#lowerExpressionCtx(body as Expression, sig.returns[0]);
        this.#emitCheckedRet(value);
      }
    }
    return this.b.finish();
  }

  /**
   * Synthesized (node-less) constructors: the DEFAULT constructor of a
   * class with no written one, and the decorated case-class
   * constructor. Streaming's shapes differ from written constructors:
   * the default constructor calls super FIRST (forwarding its own
   * params) and then stores field defaults by RAW name; the case-class
   * constructor calls super with the receiver only, stores each case
   * parameter into its field, then stores field defaults with the
   * accessor rename applied. Both mirrored exactly.
   */
  lowerSynthesizedConstructor(): IrBody {
    let sig = this.func.signature;
    if (sig.returns.length != 0 || sig.params.length == 0) {
      this.#bail('constructor shape');
    }
    if (this.func.classType == null || this.func.structType == null) {
      this.#bail('constructor without class');
    }
    let ct = this.func.classType as ClassType;
    let structType = this.func.structType as WasmStruct;
    if (ct.isExtension) {
      this.#bail('extension constructor');
    }
    let classDecl = this.func.classDecl;
    if (classDecl == null || !(classDecl is ClassDeclaration)) {
      this.#bail('constructor declaration shape');
    }
    let cd = classDecl as ClassDeclaration;
    if (cd.mixins != null && (cd.mixins as Array<TypeAnnotation>).length > 0) {
      this.#bail('constructor with mixins');
    }

    let entry = this.b.newBlock();
    let params = new Array<i32>();
    for (let vt in sig.params) {
      this.#requireSupported(vt, 'constructor param type');
      params.push(this.b.blockParam(entry, vt));
    }
    this.b.switchTo(entry);
    this.thisValue = params[0];

    if (ct.isCaseClass) {
      this.#lowerCaseClassCtorBody(ct, structType, cd, params);
    } else {
      this.#lowerDefaultCtorBody(ct, structType, cd, params);
    }
    this.b.retVoid();
    return this.b.finish();
  }

  #lowerDefaultCtorBody(ct: ClassType, structType: WasmStruct,
      cd: ClassDeclaration, params: Array<i32>): void {
    if (ct.superType != null) {
      let superType = ct.superType as ClassType;
      let ctorKey = getClassMethodKey(getClassKey(superType), '<constructor>');
      if (let (true, superCtor) = this.wasm.classMethodMap.get(ctorKey)) {
        // The default constructor forwards its own params to super.
        if (superCtor.signature.params.length > params.length ||
            superCtor.signature.returns.length != 0) {
          this.#bail('super constructor shape');
        }
        let args = new Array<i32>();
        for (var i = 0; i < superCtor.signature.params.length; i += 1) {
          if (!isValSubtype(this.#valueType(params[i]),
              superCtor.signature.params[i])) {
            this.#bail('super constructor arg type');
          }
          args.push(params[i]);
        }
        let fr = this.b.addRef(new IrRefFunc(superCtor));
        this.b.callFunc(fr, args, null);
      }
    }
    for (let member in cd.body) {
      if (member is FieldDefinition) {
        let fd = member as FieldDefinition;
        if (fd.value != null && !fd.isStatic) {
          if (!(fd.name is Identifier)) {
            this.#bail('field name shape');
          }
          this.#storeCtorField(ct, structType, (fd.name as Identifier).name,
              fd.value as Expression, false);
        }
      }
    }
  }

  #lowerCaseClassCtorBody(ct: ClassType, structType: WasmStruct,
      cd: ClassDeclaration, params: Array<i32>): void {
    if (ct.superType != null) {
      let superType = ct.superType as ClassType;
      let ctorKey = getClassMethodKey(getClassKey(superType), '<constructor>');
      if (let (true, superCtor) = this.wasm.classMethodMap.get(ctorKey)) {
        // The case-class constructor passes ONLY the receiver to super.
        if (superCtor.signature.params.length != 1 ||
            superCtor.signature.returns.length != 0 ||
            !isValSubtype(this.#valueType(params[0]),
                superCtor.signature.params[0])) {
          this.#bail('case super constructor shape');
        }
        let fr = this.b.addRef(new IrRefFunc(superCtor));
        this.b.callFunc(fr, this.#oneArg(params[0]), null);
      }
    }
    if (ct.constructorType != null) {
      let ctorType = ct.constructorType as FunctionType;
      if (ctorType.parameterNames != null) {
        let names = ctorType.parameterNames as Array<String>;
        for (var pi = 0; pi < ctorType.parameters.length; pi += 1) {
          if (pi + 1 >= params.length || pi >= names.length) {
            this.#bail('case constructor arity');
          }
          let pName = names[pi];
          var lookupName = pName;
          if (pName.length > 0 && pName.sliceBytes(0, 1) == "#") {
            lookupName = getClassPrivateFieldKey(getClassKey(ct), pName);
          }
          let fieldIdx = structType.fieldIndexByName(lookupName);
          if (fieldIdx >= 0) {
            let fieldVt = structType.fields[fieldIdx].type;
            if (!isValSubtype(this.#valueType(params[pi + 1]), fieldVt)) {
              this.#bail('case constructor param type');
            }
            let fieldRef = this.b.addRef(new IrRefField(structType, lookupName));
            let pairIdx = this.b.pushExtra(
                this.#twoValues(this.thisValue, params[pi + 1]));
            this.b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
          }
        }
      }
    }
    for (let member in cd.body) {
      if (member is FieldDefinition) {
        let fd = member as FieldDefinition;
        if (fd.value != null && !fd.isStatic) {
          // Streaming skips (not bails) non-identifier field names here.
          if (fd.name is Identifier) {
            this.#storeCtorField(ct, structType,
                (fd.name as Identifier).name, fd.value as Expression);
          }
        }
      }
    }
  }

  /**
   * Closure implementation prologue, mirroring the streaming
   * generator: cast the structref context parameter to the context
   * struct and bind `this` (when captured) and each captured value
   * into the SSA environment. Celled captures bailed in pre-flight,
   * and captured symbols are never assigned in a lowered body (an
   * assignment would have made them celled), so plain environment
   * entries are sound — they never need merge parameters.
   */
  #lowerClosurePrologue(ctxParam: i32): void {
    let cs = this.func.contextStruct as WasmStruct;
    if (cs.fields.length == 0) {
      return;
    }
    let castVt: ValType = new ValTypeRef(cs);
    let casted = this.b.emit(IrOp.ref_cast, castVt, ctxParam,
        this.b.internType(castVt));
    var fieldIdx = 0;
    if (this.func.capturesThis) {
      let field = cs.fields[0];
      let fieldName = field.name;
      if (fieldName == null) {
        this.#bail('unnamed context field');
      }
      let fieldRef = this.b.addRef(new IrRefField(cs, fieldName as String));
      this.thisValue = this.b.emit(IrOp.struct_get, field.type, casted, fieldRef);
      fieldIdx = 1;
    }
    for (let symId in this.func.captures) {
      let field = cs.fields[fieldIdx];
      let fieldName = field.name;
      if (fieldName == null) {
        this.#bail('unnamed context field');
      }
      this.#requireSupported(field.type, 'capture type');
      let fieldRef = this.b.addRef(new IrRefField(cs, fieldName as String));
      let value = this.b.emit(IrOp.struct_get, field.type, casted, fieldRef);
      this.env[symId] = value;
      fieldIdx += 1;
    }
  }

  /**
   * Constructor prologue, mirroring FunctionGenerator's order exactly:
   * field default initializers (class body FieldDefinitions with
   * values), then the initializer list (which also carries desugared
   * `this.x` parameters), then the super-initializer call, then the
   * body. Mixins and decorated (synthetic) constructors bail before we
   * get here.
   */
  #lowerConstructorPrologue(md: MethodDefinition): void {
    if (this.func.classType == null || this.func.structType == null) {
      this.#bail('constructor without class');
    }
    let ct = this.func.classType as ClassType;
    let structType = this.func.structType as WasmStruct;
    if (ct.isExtension) {
      this.#bail('extension constructor');
    }
    let classDecl = this.func.classDecl;
    if (classDecl == null || !(classDecl is ClassDeclaration)) {
      this.#bail('constructor declaration shape');
    }
    let cd = classDecl as ClassDeclaration;
    if (cd.mixins != null && (cd.mixins as Array<TypeAnnotation>).length > 0) {
      this.#bail('constructor with mixins');
    }

    // 1. Field defaults, in declaration order.
    for (let member in cd.body) {
      if (member is FieldDefinition) {
        let fd = member as FieldDefinition;
        if (fd.value != null && !fd.isStatic) {
          if (!(fd.name is Identifier)) {
            this.#bail('field name shape');
          }
          this.#storeCtorField(ct, structType, (fd.name as Identifier).name,
              fd.value as Expression);
        }
      }
    }

    // 2. Initializer list (includes desugared this.x params).
    if (md.initializerList != null) {
      for (let init in md.initializerList as Array<Node>) {
        if (init is FieldInitializer) {
          let fi = init as FieldInitializer;
          this.#storeCtorField(ct, structType, fi.field.name, fi.value);
        } else {
          this.#bail('initializer kind');
        }
      }
    }

    // 3. Super-initializer.
    if (md.superInitializer != null) {
      let si = md.superInitializer as SuperInitializer;
      if (ct.superType == null) {
        this.#bail('super without superclass');
      }
      let superKey = getClassMethodKey(
          getClassKey(ct.superType as ClassType), '<constructor>');
      let superCtorOpt = if (let (true, sc) = this.wasm.classMethodMap.get(superKey)) sc else null;
      if (superCtorOpt == null) {
        this.#bail('super constructor not found');
      }
      let superCtor = superCtorOpt as WasmFunction;
      let superSig = superCtor.signature;
      if (superSig.params.length != si.args.length + 1) {
        this.#bail('super constructor arity');
      }
      let args = new Array<i32>();
      args.push(this.thisValue);
      for (var i = 0; i < si.args.length; i += 1) {
        let paramVt = superSig.params[i + 1];
        this.#requireSupported(paramVt, 'super arg type');
        let value = this.#lowerExpressionCtx(si.args[i], paramVt);
        if (!isValSubtype(this.#valueType(value), paramVt)) {
          this.#bail('super argument type');
        }
        args.push(value);
      }
      let superRef = this.b.addRef(new IrRefFunc(superCtor));
      this.b.callFunc(superRef, args, null);
    }
  }

  /**
   * Stores one constructor field initialization, applying the public
   * name -> private storage mapping (var(#x) x) and private-field key
   * mangling. Fields absent from the struct are skipped WITHOUT
   * evaluating the value, matching the streaming backend.
   */
  #storeCtorField(ct: ClassType, structType: WasmStruct, fieldName: String, value: Expression, mapSetterNames: boolean = true): void {
    var actualName = fieldName;
    // Streaming's DEFAULT-constructor path stores by the raw field name;
    // the written-constructor and case-class paths apply the accessor
    // rename first. Mirror whichever the caller mirrors.
    if (mapSetterNames && ct.fieldSetterNames != null) {
      let mapping = ct.fieldSetterNames as HashMap<String, String>;
      if (let (true, mapped) = mapping.get(fieldName)) {
        actualName = mapped;
      }
    }
    var lookupName = actualName;
    if (actualName.length > 0 && actualName.sliceBytes(0, 1) == "#") {
      lookupName = getClassPrivateFieldKey(getClassKey(ct), actualName);
    }
    let found = structType.fieldIndexByName(lookupName) >= 0;
    if (!found) {
      return;
    }
    let fieldVt = this.#fieldValType(structType, lookupName);
    let lowered = this.#lowerExpressionCtx(value, fieldVt);
    if (!isValSubtype(this.#valueType(lowered), fieldVt)) {
      this.#bail('constructor field type');
    }
    let fieldRef = this.b.addRef(new IrRefField(structType, lookupName));
    let pairIdx = this.b.pushExtra(this.#twoValues(this.thisValue, lowered));
    this.b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
  }

  /**
   * Emits a return after checking the value is a wasm subtype of the
   * declared return type. A mismatch means an implicit conversion the
   * lowering doesn't model yet — most commonly packing a class instance
   * into an interface fat pointer — so the function bails rather than
   * emitting invalid wasm.
   */
  /**
   * Multi-value returns: only the inline-tuple-literal form for now —
   * elements lower straight onto the result stack (with `_` producing
   * the slot's default, mirroring streaming). Boxed tuples and call
   * forwarding still bail.
   */
  #lowerMultiReturn(arg: Expression): void {
    if (!(arg is TupleLiteral)) {
      this.#bail('multi-value return');
    }
    let lit = arg as TupleLiteral;
    let sig = this.func.signature;
    if (lit.elements.length != sig.returns.length) {
      this.#bail('multi-value return arity');
    }
    let nt = this.func.model.getNodeType(lit);
    if (nt == null || !(baseType(nt as Type) is InlineTupleType)) {
      this.#bail('boxed tuple return');
    }
    let values = new Array<i32>();
    for (var i = 0; i < lit.elements.length; i += 1) {
      let el = lit.elements[i];
      let expected = sig.returns[i];
      var v = -1;
      if (el is Identifier && (el as Identifier).name == '_') {
        v = this.#defaultValueOf(expected);
      } else {
        v = this.#lowerExpressionCtx(el, expected);
      }
      if (!isValSubtype(this.#valueType(v), expected)) {
        this.#bail('multi-value return type');
      }
      values.push(v);
    }
    this.b.retMulti(values);
  }

  /** The zero value of a result slot (for `_` tuple placeholders). */
  #defaultValueOf(vt: ValType): i32 {
    if (vt is ValTypeI32) {
      return this.b.constI32(0, vt);
    }
    if (vt is ValTypeI64) {
      return this.b.constI64(0 as i64, vt);
    }
    if (vt is ValTypeF64) {
      return this.b.constF64(0.0, vt);
    }
    if (vt is ValTypeF32) {
      return this.b.constF32(0.0, vt);
    }
    let nullable = vt is ValTypeRefNull || vt is ValTypeAnyRef ||
        vt is ValTypeEqRef || vt is ValTypeStructRef;
    if (nullable) {
      return this.b.emit(IrOp.ref_null, vt, -1, -1);
    }
    return this.#bailValue('placeholder type');
  }

  #emitCheckedRet(value: i32): void {
    let sig = this.func.signature;
    if (sig.returns.length != 1) {
      this.#bail('return value in void function');
    }
    if (!isValSubtype(this.#valueType(value), sig.returns[0])) {
      this.#bail('return requires conversion');
    }
    this.b.ret(value);
  }

  // -- Statements ------------------------------------------------------

  #lowerStatement(stmt: Statement): void {
    if (!this.reachable) {
      // Statically dead statements after return/break/continue: skip.
      return;
    }
    match (stmt) {
      case BlockStatement {body}: {
        for (let s in body) {
          this.#lowerStatement(s);
        }
      }
      case ExpressionStatement {expression}: {
        this.#lowerExpression(expression);
      }
      case VariableDeclaration as vd: {
        this.#lowerVariableDeclaration(vd);
      }
      case ReturnStatement {argument}: {
        if (argument == null) {
          this.b.retVoid();
        } else if (this.func.signature.returns.length > 1) {
          this.#lowerMultiReturn(argument as Expression);
        } else {
          let sig = this.func.signature;
          let ctx = if (sig.returns.length == 1) sig.returns[0] else null;
          let value = this.#lowerExpressionCtx(argument as Expression, ctx);
          this.#emitCheckedRet(value);
        }
        this.reachable = false;
      }
      case IfStatement as ifStmt: {
        this.#lowerIf(ifStmt);
      }
      case WhileStatement as whileStmt: {
        this.#lowerWhile(whileStmt);
      }
      case ForStatement as forStmt: {
        this.#lowerFor(forStmt);
      }
      case ForInStatement as forIn: {
        this.#lowerForIn(forIn);
      }
      case BreakStatement {}: {
        if (this.loops.length == 0) {
          this.#bail('break outside loop');
        }
        let loop = this.loops[this.loops.length - 1];
        this.b.br(loop.exit, this.#envValues(loop.carried));
        this.reachable = false;
      }
      case ContinueStatement {}: {
        if (this.loops.length == 0) {
          this.#bail('continue outside loop');
        }
        let loop = this.loops[this.loops.length - 1];
        this.b.br(loop.continueTarget, this.#envValues(loop.carried));
        this.reachable = false;
      }
      case _: {
        this.#bail('statement kind');
      }
    }
  }

  #lowerVariableDeclaration(vd: VariableDeclaration): void {
    var pat = vd.pattern;
    if (pat is BindingPattern) {
      pat = (pat as BindingPattern).pattern;
    }
    if (!(pat is IdentifierPattern)) {
      this.#bail('destructuring declaration');
    }
    let sym = this.func.model.resolveDeclaration(pat);
    if (sym == null) {
      this.#bail('unresolved declaration');
    }
    let bindingType = this.func.model.getBindingType(sym as Symbol);
    if (bindingType == null) {
      this.#bail('untyped binding');
    }
    let bindingVt = typeToValTypeWithSub(this.wasm, bindingType as Type, this.func);
    this.#requireSupported(bindingVt, 'binding type');
    let value = this.#lowerExpressionCtx(vd.init, bindingVt);
    if (this.#isCelled((sym as Symbol).id)) {
      // The binding lives in a heap cell shared with capturing
      // closures; the environment holds the (invariant) cell ref.
      this.env[(sym as Symbol).id] = this.#cellAlloc(bindingVt, value);
    } else {
      this.env[(sym as Symbol).id] = value;
    }
    this.symbols[(sym as Symbol).id] = sym as Symbol;
  }

  #lowerIf(stmt: IfStatement): void {
    if (!(stmt.test is Expression)) {
      this.#bail('if-let');
    }
    let cond = this.#lowerExpression(stmt.test as Expression);

    if (stmt.alternate == null) {
      let mergeSyms = this.#assignedEnvSyms(stmt.consequent);
      let thenB = this.b.newBlock();
      let mergeB = this.b.newBlock();
      let mergeParams = this.#addParams(mergeB, mergeSyms);
      this.b.brIf(cond, thenB, this.#noArgs(), mergeB, this.#envValues(mergeSyms));

      let saved = this.#copyEnv();
      this.b.switchTo(thenB);
      this.#lowerStatement(stmt.consequent);
      if (this.reachable) {
        this.b.br(mergeB, this.#envValues(mergeSyms));
      }
      this.env = saved;
      this.#applyParams(mergeSyms, mergeParams);
      this.b.switchTo(mergeB);
      this.reachable = true;
      return;
    }

    let alternate = stmt.alternate as Statement;
    let mergeSyms = this.#assignedEnvSyms(stmt.consequent);
    this.#appendAssignedEnvSyms(alternate, mergeSyms);
    let thenB = this.b.newBlock();
    let elseB = this.b.newBlock();
    this.b.brIf(cond, thenB, this.#noArgs(), elseB, this.#noArgs());

    // The merge block is created lazily: if both branches terminate, no
    // merge exists (and an unreachable block would fail verification).
    var mergeB = -1;
    var mergeParams: Array<i32> | null = null;

    let saved = this.#copyEnv();
    this.b.switchTo(thenB);
    this.#lowerStatement(stmt.consequent);
    if (this.reachable) {
      mergeB = this.b.newBlock();
      mergeParams = this.#addParams(mergeB, mergeSyms);
      this.b.br(mergeB, this.#envValues(mergeSyms));
    }

    this.env = this.#copyOf(saved);
    this.reachable = true;
    this.b.switchTo(elseB);
    this.#lowerStatement(alternate);
    if (this.reachable) {
      if (mergeB < 0) {
        mergeB = this.b.newBlock();
        mergeParams = this.#addParams(mergeB, mergeSyms);
      }
      this.b.br(mergeB, this.#envValues(mergeSyms));
    }

    if (mergeB < 0) {
      this.reachable = false;
      return;
    }
    this.env = saved;
    this.#applyParams(mergeSyms, mergeParams as Array<i32>);
    this.b.switchTo(mergeB);
    this.reachable = true;
  }

  #lowerWhile(stmt: WhileStatement): void {
    if (!(stmt.test is Expression)) {
      this.#bail('while-let');
    }
    let carried = this.#assignedEnvSyms(stmt.body);
    this.#appendAssignedEnvSyms(stmt.test, carried);

    let header = this.b.newBlock();
    let headerParams = this.#addParams(header, carried);
    this.b.br(header, this.#envValues(carried));

    this.b.switchTo(header);
    this.#applyParams(carried, headerParams);
    let cond = this.#lowerExpression(stmt.test as Expression);

    let bodyB = this.b.newBlock();
    let exitB = this.b.newBlock();
    let exitParams = this.#addParams(exitB, carried);
    this.b.brIf(cond, bodyB, this.#noArgs(), exitB, this.#envValues(carried));

    this.loops.push(new LoopCtx(header, exitB, carried));
    this.b.switchTo(bodyB);
    this.#lowerStatement(stmt.body);
    if (this.reachable) {
      this.b.br(header, this.#envValues(carried));
    }
    this.loops.pop();

    this.#applyParams(carried, exitParams);
    this.b.switchTo(exitB);
    this.reachable = true;
  }

  #lowerFor(stmt: ForStatement): void {
    // C-style for. The init runs in the current block; the update gets its
    // own block so `continue` can route through it.
    if (stmt.init != null) {
      let init = stmt.init as Node;
      if (init is VariableDeclaration) {
        this.#lowerVariableDeclaration(init as VariableDeclaration);
      } else if (init is ExpressionStatement) {
        this.#lowerExpression((init as ExpressionStatement).expression);
      } else if (init is Expression) {
        this.#lowerExpression(init as Expression);
      } else {
        this.#bail('for-init kind');
      }
    }

    let carried = new Array<SymbolId>();
    if (stmt.test != null) {
      this.#appendAssignedEnvSyms(stmt.test as Node, carried);
    }
    if (stmt.update != null) {
      this.#appendAssignedEnvSyms(stmt.update as Node, carried);
    }
    this.#appendAssignedEnvSyms(stmt.body, carried);

    let header = this.b.newBlock();
    let headerParams = this.#addParams(header, carried);
    this.b.br(header, this.#envValues(carried));

    this.b.switchTo(header);
    this.#applyParams(carried, headerParams);
    var cond = -1;
    if (stmt.test != null) {
      cond = this.#lowerExpression(stmt.test as Expression);
    } else {
      cond = this.b.constI32(1, new ValTypeI32());
    }

    let bodyB = this.b.newBlock();
    let updateB = this.b.newBlock();
    let updateParams = this.#addParams(updateB, carried);
    let exitB = this.b.newBlock();
    let exitParams = this.#addParams(exitB, carried);
    this.b.brIf(cond, bodyB, this.#noArgs(), exitB, this.#envValues(carried));

    this.loops.push(new LoopCtx(updateB, exitB, carried));
    this.b.switchTo(bodyB);
    this.#lowerStatement(stmt.body);
    if (this.reachable) {
      this.b.br(updateB, this.#envValues(carried));
    }
    this.loops.pop();

    this.b.switchTo(updateB);
    this.reachable = true;
    this.#applyParams(carried, updateParams);
    if (stmt.update != null) {
      this.#lowerExpression(stmt.update as Expression);
    }
    this.b.br(header, this.#envValues(carried));

    this.#applyParams(carried, exitParams);
    this.b.switchTo(exitB);
    this.reachable = true;
  }

  /**
   * for-in over FixedArray/ImmutableArray values (a wasm array) and
   * Array instances (#buffer + #length struct): an index loop mirroring
   * the streaming fast paths, with the element re-bound each iteration.
   * The general iterator protocol needs multi-value next() calls, which
   * ZIR does not carry yet, so everything else bails.
   *
   * TODO(coverage): a Sequence whose `:iterator` is NOT overridden away
   * from the default (CHA query, same machinery as devirt) can compile
   * to a `.length` + `[]` indexed loop against the interface — no
   * multi-value needed — and M3 inlining then collapses those calls to
   * the #buffer/#length fast path. That splits the remaining bails into
   * genuinely-custom iterators (which do need multi-value) and
   * default-iterator sequences (which don't).
   */
  #lowerForIn(stmt: ForInStatement): void {
    let iterableType = this.func.model.getNodeType(stmt.iterable);
    if (iterableType == null) {
      this.#bail('untyped for-in iterable');
    }

    // FIXED = a bare wasm array value; ARRAY = the Array class struct.
    var isFixed = false;
    var isArray = false;
    var elemType: Type | null = null;
    var arrayCt: ClassType | null = null;
    if (iterableType is ArrayType) {
      isFixed = true;
      elemType = (iterableType as ArrayType).elementType;
    } else {
      let resolved = this.#resolveSelfType(iterableType as Type);
      if (resolved is ClassType) {
        let ct = resolved as ClassType;
        var canonical = ct;
        while (canonical.genericSource != null) {
          canonical = canonical.genericSource as ClassType;
        }
        if (canonical.name == 'FixedArray' ||
            canonical.name == 'ImmutableArray') {
          isFixed = true;
        } else if (canonical.name == 'Array') {
          isArray = true;
          arrayCt = ct;
        }
        if ((isFixed || isArray) && ct.typeArguments != null &&
            (ct.typeArguments as Array<Type>).length > 0) {
          elemType = (ct.typeArguments as Array<Type>)[0];
        }
      }
    }
    if ((!isFixed && !isArray) || elemType == null) {
      this.#bail('for-in iterator protocol');
    }

    // The fast paths consume the raw value; skip the top-level Iterable
    // adaptation the checker may have recorded on the iterable (the
    // streaming generator's ignoreAdaptations flag).
    let iterable = this.#lowerExpressionDispatch(stmt.iterable);

    var buf = -1;
    var len = -1;
    if (isFixed) {
      buf = iterable;
      len = this.b.emit(IrOp.array_len, new ValTypeI32(), buf, -1);
    } else {
      let ct = arrayCt as ClassType;
      let cKey = getClassKey(ct);
      var infoOpt: ClassCodegenInfo | null = null;
      if (let (true, info) = this.wasm.classInfos.get(cKey)) {
        infoOpt = info;
      }
      if (infoOpt == null) {
        this.#bail('for-in Array not discovered');
      }
      let structType = (infoOpt as ClassCodegenInfo).structType;
      if (!isValSubtype(this.#valueType(iterable),
          new ValTypeRefNull(structType) as ValType)) {
        this.#bail('for-in receiver struct mismatch');
      }
      let bufferName = getClassPrivateFieldKey(cKey, '#buffer');
      let lengthName = getClassPrivateFieldKey(cKey, '#length');
      let lenRef = this.b.addRef(new IrRefField(structType, lengthName));
      len = this.b.emit(IrOp.struct_get,
          this.#fieldValType(structType, lengthName), iterable, lenRef);
      let bufRef = this.b.addRef(new IrRefField(structType, bufferName));
      buf = this.b.emit(IrOp.struct_get,
          this.#fieldValType(structType, bufferName), iterable, bufRef);
    }
    var bufTarget: WasmArray | null = null;
    match (this.#valueType(buf)) {
      case ValTypeRef as r: {
        if (r.target is WasmArray) {
          bufTarget = r.target as WasmArray;
        }
      }
      case ValTypeRefNull as rn: {
        if (rn.target is WasmArray) {
          bufTarget = rn.target as WasmArray;
        }
      }
      case _: {}
    }
    if (bufTarget == null) {
      this.#bail('for-in buffer kind');
    }
    let elemVt = (bufTarget as WasmArray).elementType;
    this.#requireSupported(elemVt, 'for-in element type');

    var pat = stmt.pattern;
    if (pat is BindingPattern) {
      pat = (pat as BindingPattern).pattern;
    }
    var symOpt: Symbol | null = null;
    if (pat is IdentifierPattern || pat is Identifier) {
      symOpt = this.func.model.resolveDeclaration(pat);
    }
    if (symOpt == null) {
      this.#bail('for-in pattern');
    }

    // Index loop. The index rides as an extra header/update block param
    // (it is not an env symbol); loop-carried env symbols work as in
    // #lowerFor.
    let carried = this.#assignedEnvSyms(stmt.body);
    let header = this.b.newBlock();
    let headerParams = this.#addParams(header, carried);
    let idxParam = this.b.blockParam(header, new ValTypeI32());
    var initArgs = this.#envValues(carried);
    initArgs.push(this.b.constI32(0, new ValTypeI32()));
    this.b.br(header, initArgs);

    this.b.switchTo(header);
    this.#applyParams(carried, headerParams);
    let done = this.b.binary(IrOp.i32_ge_s, new ValTypeI32(), idxParam, len);

    let bodyB = this.b.newBlock();
    let exitB = this.b.newBlock();
    let exitParams = this.#addParams(exitB, carried);
    this.b.brIf(done, exitB, this.#envValues(carried), bodyB, this.#noArgs());

    this.b.switchTo(bodyB);
    let elem = this.b.emit(IrOp.array_get, elemVt, buf, idxParam);
    this.#bindPatternSym(symOpt as Symbol, elem);

    let updateB = this.b.newBlock();
    let updateParams = this.#addParams(updateB, carried);
    this.loops.push(new LoopCtx(updateB, exitB, carried));
    this.#lowerStatement(stmt.body);
    if (this.reachable) {
      this.b.br(updateB, this.#envValues(carried));
    }
    this.loops.pop();

    this.b.switchTo(updateB);
    this.reachable = true;
    this.#applyParams(carried, updateParams);
    let one = this.b.constI32(1, new ValTypeI32());
    let next = this.b.binary(IrOp.i32_add, new ValTypeI32(), idxParam, one);
    var backArgs = this.#envValues(carried);
    backArgs.push(next);
    this.b.br(header, backArgs);

    this.#applyParams(carried, exitParams);
    this.b.switchTo(exitB);
    this.reachable = true;
  }

  // -- Expressions -----------------------------------------------------

  #lowerExpression(expr: Expression): i32 {
    let value = this.#lowerExpressionDispatch(expr);
    return this.#applyAdaptations(expr, value);
  }

  /**
   * Post-expression adaptations, mirroring the streaming generator's
   * hook after generateExpression: the model marks expressions whose
   * value must be repacked for the consuming context. Interface
   * adaptations pack a class instance into a fat pointer (iface_pack);
   * record and function adaptations are not lowered yet and bail —
   * loudly, since silently skipping a required repack would miscompile.
   */
  #applyAdaptations(expr: Expression, value: i32): i32 {
    if (this.func.model.getRecordAdaptation(expr) != null) {
      this.#bail('record adaptation');
    }
    if (this.func.model.getFunctionAdaptation(expr) != null) {
      this.#bail('function adaptation');
    }
    let iaOpt = this.func.model.getInterfaceAdaptation(expr);
    if (iaOpt == null) {
      return value;
    }
    if (value < 0 || this.b.body.typeId[value] < 0) {
      this.#bail('interface adaptation without value');
    }
    let ia = iaOpt as InterfaceAdaptation;
    var srcType = ia.source as Type;
    var tgtType = ia.target as Type;
    // Mixin-intermediate and `_This`-marker sources stand in for the
    // enclosing class (mirrors the streaming hook).
    if (srcType is ClassType) {
      let sct = srcType as ClassType;
      let n = sct.name;
      if (sct.isMixinIntermediate ||
          (n.length >= 5 && n.sliceBytes(n.length - 5, n.length) == "_This")) {
        if (this.func.classType != null) {
          srcType = this.func.classType as ClassType;
        }
      }
    }
    if (this.func.classType != null) {
      let ct = this.func.classType as ClassType;
      srcType = substituteTypeParamsInClassContext(ct, srcType);
      tgtType = substituteTypeParamsInClassContext(ct, tgtType);
    }
    if (!(srcType is ClassType) || !(tgtType is InterfaceType)) {
      this.#bail('interface adaptation shape');
    }
    let iName = getInterfaceKey(tgtType as InterfaceType);
    let key = getClassInterfaceKey(getClassKey(srcType as ClassType), iName);
    let vtOpt = this.wasm.getClassInterfaceVTable(key);
    if (vtOpt == null) {
      this.#bail('interface vtable global not found');
    }
    let fatPtrOpt = if (let (true, st) = this.wasm.interfaceStructs.get(iName)) st else null;
    if (fatPtrOpt == null) {
      this.#bail('interface struct not found');
    }
    let fatPtr = fatPtrOpt as WasmStruct;
    let globalRef = this.b.addRef(new IrRefGlobal(vtOpt as WasmGlobal));
    return this.b.emit(IrOp.iface_pack, new ValTypeRef(fatPtr) as ValType,
        value, globalRef);
  }

  #lowerExpressionDispatch(expr: Expression): i32 {
    return match (expr) {
      case NumberLiteral as lit: this.#lowerNumberLiteral(lit)
      case BooleanLiteral {value}: this.b.constI32(if (value) 1 else 0, new ValTypeI32())
      case Identifier as ident: this.#lowerIdentifier(ident)
      case BinaryExpression as bin: this.#lowerBinary(bin)
      case UnaryExpression as un: this.#lowerUnary(un)
      case AssignmentExpression as assign: this.#lowerAssignment(assign)
      case CallExpression as call: this.#lowerCall(call)
      case IfExpression as ifExpr: this.#lowerIfExpression(ifExpr)
      case MatchExpression as matchExpr: this.#lowerMatch(matchExpr)
      case AsExpression as asExpr: this.#lowerAs(asExpr)
      case StringLiteral as strLit: this.#lowerStringLiteral(strLit)
      case NewExpression as newExpr: this.#lowerNew(newExpr)
      case MemberExpression as member: this.#lowerMemberRead(member)
      case ThisExpression: this.#lowerThis(expr)
      case FunctionExpression as fExpr: this.#lowerFunctionExpression(fExpr)
      case NullLiteral: this.#bailValue('null without context')
      case _: this.#bailValue('expression kind')
    };
  }

  #lowerNumberLiteral(lit: NumberLiteral): i32 {
    let vt = this.#exprValType(lit);
    if (vt is ValTypeI32) {
      if (let (true, value) = parseI32(lit.raw)) {
        return this.b.constI32(value, vt);
      }
      // u32 literals above i32.max: parse wide and truncate.
      if (let (true, wide) = parseI64OrU64Literal(lit.raw)) {
        if (wide >= (0 as i64) && wide <= (4294967295 as i64)) {
          return this.b.constI32(wide as i32, vt);
        }
      }
      this.#bail('unparseable i32 literal');
    }
    if (vt is ValTypeI64) {
      if (let (true, value) = parseI64OrU64Literal(lit.raw)) {
        return this.b.constI64(value, vt);
      }
      this.#bail('unparseable i64 literal');
    }
    if (vt is ValTypeF64) {
      return this.b.constF64(parseF64(lit.raw), vt);
    }
    if (vt is ValTypeF32) {
      return this.b.constF32(parseF64(lit.raw), vt);
    }
    return this.#bailValue('literal type');
  }

  #lowerIdentifier(ident: Identifier): i32 {
    let sym = this.func.model.resolve(ident);
    if (sym == null) {
      this.#bail('unresolved identifier');
    }
    let resolved = (sym as Symbol).resolveTarget();
    if (!this.env.has(resolved.id)) {
      this.#bail('non-local identifier');
    }
    var value = this.env[resolved.id];
    if (this.#isCelled(resolved.id)) {
      value = this.#cellRead(value);
    }
    // Narrowing arrives as explicit coercions (ir.md §5): the checker may
    // have narrowed this reference's type at this use site — most
    // commonly `x != null` making a nullable binding non-null. Re-assert
    // non-nullness when the narrowed type demands it; subtype narrowing
    // (casts to a subclass) is not lowered yet and bails.
    let nodeType = this.func.model.getNodeType(ident);
    if (nodeType == null) {
      return value;
    }
    let wantVt = typeToValTypeWithSub(this.wasm, nodeType as Type, this.func);
    let haveVt = this.#valueType(value);
    if (valTypeEquals(haveVt, wantVt)) {
      return value;
    }
    if (wantVt is ValTypeRef && haveVt is ValTypeRefNull) {
      let wantTarget = (wantVt as ValTypeRef).target;
      let haveTarget = (haveVt as ValTypeRefNull).target;
      if (wantTarget == haveTarget) {
        return this.b.emit(IrOp.ref_as_non_null, wantVt, value, -1);
      }
      this.#bail('narrowed to subtype');
    }
    if (isValSubtype(haveVt, wantVt)) {
      // Widening (e.g. a non-null value read at a nullable type): the
      // value passes as-is under wasm subtyping.
      return value;
    }
    return this.#bailValue('identifier type shift');
  }

  #lowerBinary(bin: BinaryExpression): i32 {
    if (bin.operator == "&&" || bin.operator == "||") {
      return this.#lowerLogical(bin);
    }
    // Null comparisons: x == null / x != null (either side).
    let leftIsNull = bin.left is NullLiteral;
    let rightIsNull = bin.right is NullLiteral;
    if ((leftIsNull || rightIsNull) &&
        (bin.operator == "==" || bin.operator == "!=" ||
         bin.operator == "===" || bin.operator == "!==")) {
      if (leftIsNull && rightIsNull) {
        // null == null needs no test at all.
        let same = bin.operator == "==" || bin.operator == "===";
        return this.b.constI32(if (same) 1 else 0, new ValTypeI32());
      }
      let other = if (leftIsNull) bin.right else bin.left;
      let value = this.#lowerExpression(other);
      let vt = this.#valueType(value);
      if (!isRefValType(vt)) {
        // The checker rejects null comparisons against non-nullable
        // scalars, so this only guards lowering bugs.
        this.#bail('null compare on non-ref');
      }
      let isNull = this.b.emit(IrOp.ref_is_null, new ValTypeI32(), value, -1);
      if (bin.operator == "!=" || bin.operator == "!==") {
        return this.b.emit(IrOp.i32_eqz, new ValTypeI32(), isNull, -1);
      }
      return isNull;
    }
    // Reference identity: === / !== between eq-typed references.
    if (bin.operator == "===" || bin.operator == "!==") {
      let left = this.#lowerExpression(bin.left);
      let right = this.#lowerExpression(bin.right);
      let lt = this.#valueType(left);
      let rt = this.#valueType(right);
      if (!isRefValType(lt) || !isRefValType(rt)) {
        this.#bail('identity compare on non-refs');
      }
      let same = this.b.binary(IrOp.ref_eq, new ValTypeI32(), left, right);
      if (bin.operator == "!==") {
        return this.b.emit(IrOp.i32_eqz, new ValTypeI32(), same, -1);
      }
      return same;
    }
    this.#requireScalarNode(bin.left);
    this.#requireScalarNode(bin.right);
    let left = this.#lowerExpression(bin.left);
    let right = this.#lowerExpression(bin.right);
    let leftType = this.#valueType(left);
    let rightType = this.#valueType(right);
    if (!valTypeEquals(leftType, rightType)) {
      this.#bail('mixed operand types');
    }
    let unsigned = this.#isUnsignedNode(bin.left) || this.#isUnsignedNode(bin.right);
    let op = this.#mapBinaryOp(bin.operator, leftType, unsigned);
    let isComparison = bin.operator == "==" || bin.operator == "!=" ||
        bin.operator == "<" || bin.operator == "<=" ||
        bin.operator == ">" || bin.operator == ">=";
    let resultType = if (isComparison) new ValTypeI32() as ValType else leftType;
    return this.b.binary(op, resultType, left, right);
  }

  #lowerLogical(bin: BinaryExpression): i32 {
    let left = this.#lowerExpression(bin.left);
    let evalRight = this.b.newBlock();
    let merge = this.b.newBlock();
    let result = this.b.blockParam(merge, new ValTypeI32());
    if (bin.operator == "&&") {
      let zero = this.b.constI32(0, new ValTypeI32());
      this.b.brIf(left, evalRight, this.#noArgs(), merge, this.#oneArg(zero));
    } else {
      let one = this.b.constI32(1, new ValTypeI32());
      this.b.brIf(left, merge, this.#oneArg(one), evalRight, this.#noArgs());
    }
    this.b.switchTo(evalRight);
    let right = this.#lowerExpression(bin.right);
    this.b.br(merge, this.#oneArg(right));
    this.b.switchTo(merge);
    return result;
  }

  #lowerUnary(un: UnaryExpression): i32 {
    let value = this.#lowerExpression(un.argument);
    let vt = this.#valueType(value);
    if (un.operator == "!") {
      if (!(vt is ValTypeI32)) {
        this.#bail('logical not on non-i32');
      }
      return this.b.emit(IrOp.i32_eqz, new ValTypeI32(), value, -1);
    }
    if (un.operator == "-") {
      if (vt is ValTypeI32) {
        let zero = this.b.constI32(0, vt);
        return this.b.binary(IrOp.i32_sub, vt, zero, value);
      }
      if (vt is ValTypeI64) {
        let zero = this.b.constI64(0 as i64, vt);
        return this.b.binary(IrOp.i64_sub, vt, zero, value);
      }
      if (vt is ValTypeF64) {
        return this.b.emit(IrOp.f64_neg, vt, value, -1);
      }
      if (vt is ValTypeF32) {
        return this.b.emit(IrOp.f32_neg, vt, value, -1);
      }
      this.#bail('negate type');
    }
    if (un.operator == "~") {
      if (vt is ValTypeI32) {
        let minusOne = this.b.constI32(-1, vt);
        return this.b.binary(IrOp.i32_xor, vt, value, minusOne);
      }
      if (vt is ValTypeI64) {
        let minusOne = this.b.constI64(-1 as i64, vt);
        return this.b.binary(IrOp.i64_xor, vt, value, minusOne);
      }
      this.#bail('bitwise not type');
    }
    return this.#bailValue('unary operator');
  }

  /**
   * If-expressions: like #lowerIf, plus one extra merge parameter carrying
   * the arm value. Arms may be plain expressions or value-blocks (a block
   * whose trailing expression statement is the value). Void-typed
   * if-expressions lower like statements and yield no value.
   */
  #lowerIfExpression(expr: IfExpression): i32 {
    if (!(expr.test is Expression)) {
      this.#bail('if-let expression');
    }
    let nodeType = this.func.model.getNodeType(expr);
    if (nodeType == null) {
      this.#bail('untyped if expression');
    }
    let isVoid = baseType(nodeType as Type) is VoidType;
    let resultVt = if (!isVoid) this.#exprValType(expr) else null;
    if (expr.alternate == null && !isVoid) {
      this.#bail('value if without else');
    }

    let cond = this.#lowerExpression(expr.test as Expression);
    let mergeSyms = this.#assignedEnvSyms(expr.consequent);
    if (expr.alternate != null) {
      this.#appendAssignedEnvSyms(expr.alternate as Node, mergeSyms);
    }

    let thenB = this.b.newBlock();
    let elseB = this.b.newBlock();
    this.b.brIf(cond, thenB, this.#noArgs(), elseB, this.#noArgs());

    var mergeB = -1;
    var mergeParams: Array<i32> | null = null;
    var resultParam = -1;

    let saved = this.#copyEnv();
    this.b.switchTo(thenB);
    let thenValue = this.#lowerValueNode(expr.consequent, isVoid, resultVt);
    if (this.reachable) {
      if (!isVoid &&
          !isValSubtype(this.#valueType(thenValue), resultVt as ValType)) {
        this.#bail('if arm type');
      }
      mergeB = this.b.newBlock();
      mergeParams = this.#addParams(mergeB, mergeSyms);
      if (!isVoid) {
        resultParam = this.b.blockParam(mergeB, resultVt as ValType);
      }
      let args = this.#envValues(mergeSyms);
      if (!isVoid) {
        args.push(thenValue);
      }
      this.b.br(mergeB, args);
    }

    this.env = this.#copyOf(saved);
    this.reachable = true;
    this.b.switchTo(elseB);
    if (expr.alternate != null) {
      let elseValue = this.#lowerValueNode(expr.alternate as Node, isVoid, resultVt);
      if (this.reachable) {
        if (!isVoid &&
            !isValSubtype(this.#valueType(elseValue), resultVt as ValType)) {
          this.#bail('if arm type');
        }
        if (mergeB < 0) {
          mergeB = this.b.newBlock();
          mergeParams = this.#addParams(mergeB, mergeSyms);
          if (!isVoid) {
            resultParam = this.b.blockParam(mergeB, resultVt as ValType);
          }
        }
        let args = this.#envValues(mergeSyms);
        if (!isVoid) {
          args.push(elseValue);
        }
        this.b.br(mergeB, args);
      }
    } else {
      // Void if-expression without else: fall through to the merge.
      if (mergeB < 0) {
        mergeB = this.b.newBlock();
        mergeParams = this.#addParams(mergeB, mergeSyms);
      }
      this.b.br(mergeB, this.#envValues(mergeSyms));
    }

    if (mergeB < 0) {
      this.reachable = false;
      return -1;
    }
    this.env = saved;
    this.#applyParams(mergeSyms, mergeParams as Array<i32>);
    this.b.switchTo(mergeB);
    this.reachable = true;
    return resultParam;
  }

  /**
   * Lowers an if-expression or match-case arm: a plain expression, or a
   * value-block whose trailing expression statement supplies the value.
   * `ctxVt` is the arm's contextual result type (for null literals);
   * null when the context is void. Returns -1 when the arm ends
   * unreachable (or the context is void).
   */
  #lowerValueNode(node: Node, isVoid: boolean, ctxVt: ValType | null): i32 {
    if (node is Expression) {
      let value = this.#lowerExpressionCtx(node as Expression, ctxVt);
      return if (isVoid) -1 else value;
    }
    if (node is BlockStatement) {
      let body = (node as BlockStatement).body;
      if (body.length == 0) {
        if (isVoid) {
          return -1;
        }
        this.#bail('empty value block');
      }
      for (var i = 0; i < body.length - 1; i += 1) {
        this.#lowerStatement(body[i]);
        if (!this.reachable) {
          return -1;
        }
      }
      let last = body[body.length - 1];
      if (last is ExpressionStatement) {
        let value = this.#lowerExpressionCtx(
            (last as ExpressionStatement).expression, ctxVt);
        return if (isVoid) -1 else value;
      }
      if (isVoid) {
        this.#lowerStatement(last);
        return -1;
      }
      this.#bail('value block tail');
    }
    return this.#bailValue('value arm kind');
  }

  // -- Match expressions -------------------------------------------------

  /**
   * Match lowering. Each case chains its tests so the first failure
   * branches to the next case's entry block — which also keeps nested
   * property tests guarded behind their enclosing ref.test (the
   * streaming backend gets the same guarantee from if/else
   * accumulators) — then binds pattern variables into the SSA
   * environment, tests the guard, and lowers the body. Completed arms
   * branch to a lazily created merge block carrying a result parameter
   * when the match produces a value. The final fail block only traps:
   * the checker proves exhaustiveness, mirroring streaming's trailing
   * unreachable.
   */
  #lowerMatch(expr: MatchExpression): i32 {
    let nodeType = this.func.model.getNodeType(expr);
    if (nodeType == null) {
      this.#bail('untyped match');
    }
    let isVoid = isVoidOrNeverType(nodeType as Type);
    let resultVt = if (!isVoid) {
      let vt = typeToValTypeWithSub(this.wasm, nodeType as Type, this.func);
      this.#requireSupported(vt, 'match result type');
      vt
    } else {
      null
    };

    let disc = this.#lowerExpression(expr.discriminant);

    let mergeSyms = new Array<SymbolId>();
    for (let mc in expr.cases) {
      this.#appendAssignedEnvSyms(mc.body, mergeSyms);
      if (mc.guard != null) {
        this.#appendAssignedEnvSyms(mc.guard as Node, mergeSyms);
      }
    }

    var mergeB = -1;
    var mergeParams: Array<i32> | null = null;
    var resultParam = -1;
    let saved = this.#copyEnv();

    var exhausted = false;
    var i = 0;
    while (i < expr.cases.length && !exhausted) {
      let mc = expr.cases[i];
      this.env = this.#copyOf(saved);
      // An irrefutable, guardless case consumes everything; later cases
      // are statically dead (and their blocks, having no predecessors,
      // would fail verification).
      var failB = -1;
      if (mc.guard != null || this.#patternRefutable(mc.pattern)) {
        failB = this.b.newBlock();
      } else {
        exhausted = true;
      }
      this.#lowerPatternTest(mc.pattern, disc, failB);
      this.#lowerPatternBindings(mc.pattern, disc);
      if (mc.guard != null) {
        let cond = this.#lowerExpression(mc.guard as Expression);
        this.#branchUnless(cond, failB);
      }
      let value = this.#lowerValueNode(mc.body, isVoid, resultVt);
      if (this.reachable) {
        if (!isVoid &&
            !isValSubtype(this.#valueType(value), resultVt as ValType)) {
          this.#bail('match arm type');
        }
        if (mergeB < 0) {
          mergeB = this.b.newBlock();
          mergeParams = this.#addParams(mergeB, mergeSyms);
          if (!isVoid) {
            resultParam = this.b.blockParam(mergeB, resultVt as ValType);
          }
        }
        let args = this.#envValues(mergeSyms);
        if (!isVoid) {
          args.push(value);
        }
        this.b.br(mergeB, args);
      }
      if (failB >= 0) {
        this.b.switchTo(failB);
        this.reachable = true;
      }
      i += 1;
    }

    if (!exhausted) {
      this.b.unreachable();
    }

    if (mergeB < 0) {
      this.reachable = false;
      return -1;
    }
    this.env = saved;
    this.#applyParams(mergeSyms, mergeParams as Array<i32>);
    this.b.switchTo(mergeB);
    this.reachable = true;
    return resultParam;
  }

  /**
   * Emits the refutable tests for `pattern` against `value`, branching
   * to `failB` at the first failure; on success execution falls through
   * in the current block. Pattern kinds not lowered yet (tuples,
   * records) bail here, falling the whole function back to streaming.
   */
  #lowerPatternTest(pattern: Node, value: i32, failB: i32): void {
    match (pattern) {
      case IdentifierPattern: {}
      case Identifier as ident: {
        if (ident.name != "_") {
          // `case Foo:` where Foo names a class is a type test; any
          // other identifier is an irrefutable binding (mirrors
          // streaming's check emitter).
          let patType = this.func.model.getNodeType(pattern);
          if (patType is ClassType) {
            let st = this.#classStructOf(patType as ClassType);
            this.#emitRefTest(value, st, failB);
          }
        }
      }
      case AsPattern as ap: {
        this.#lowerPatternTest(ap.pattern, value, failB);
      }
      case BindingPattern as bp: {
        this.#lowerPatternTest(bp.pattern, value, failB);
      }
      case LiteralPattern as lp: {
        this.#lowerPatternTest(lp.value, value, failB);
      }
      case ClassPattern as cp: {
        let ct = this.func.model.getNodeType(cp.name);
        if (!(ct is ClassType)) {
          this.#bail('untyped class pattern');
        }
        let st = this.#classStructOf(ct as ClassType);
        this.#emitRefTest(value, st, failB);
        let castVt = new ValTypeRef(st) as ValType;
        var casted = -1;
        for (let prop in cp.properties) {
          // Streaming parity on both filters: irrefutable property
          // patterns contribute no test, and properties without a
          // physical struct field are skipped.
          if (this.#patternRefutable(prop.value)) {
            let fieldIdx = this.#structFieldIndex(st, prop.name.name);
            if (fieldIdx >= 0) {
              if (casted < 0) {
                casted = this.b.emit(IrOp.ref_cast, castVt, value,
                    this.b.internType(castVt));
              }
              let fieldRef = this.b.addRef(new IrRefField(st, prop.name.name));
              let fieldVal = this.b.emit(
                  IrOp.struct_get, st.fields[fieldIdx].type, casted, fieldRef);
              this.#lowerPatternTest(prop.value, fieldVal, failB);
            }
          }
        }
      }
      case LogicalPattern as lp: {
        if (lp.operator == "||") {
          if (this.#patternBinds(lp.left) || this.#patternBinds(lp.right)) {
            // Bindings under an or-pattern would need the per-side
            // values merged into the arm; not lowered yet.
            this.#bail('or-pattern bindings');
          }
          if (this.#patternRefutable(lp.left) &&
              this.#patternRefutable(lp.right)) {
            let tryRight = this.b.newBlock();
            let successB = this.b.newBlock();
            this.#lowerPatternTest(lp.left, value, tryRight);
            this.b.br(successB, this.#noArgs());
            this.b.switchTo(tryRight);
            this.#lowerPatternTest(lp.right, value, failB);
            this.b.br(successB, this.#noArgs());
            this.b.switchTo(successB);
          }
          // Otherwise one side always matches, so the whole pattern does.
        } else {
          this.#lowerPatternTest(lp.left, value, failB);
          this.#lowerPatternTest(lp.right, value, failB);
        }
      }
      case NumberLiteral as num: {
        let vt = this.#valueType(value);
        var cond = -1;
        if (vt is ValTypeI32) {
          if (let (true, parsed) = parseI64OrU64Literal(num.raw)) {
            let lit = this.b.constI32(parsed as i32, vt);
            cond = this.b.binary(IrOp.i32_eq, new ValTypeI32(), value, lit);
          } else {
            this.#bail('unparseable pattern literal');
          }
        } else if (vt is ValTypeI64) {
          if (let (true, parsed) = parseI64OrU64Literal(num.raw)) {
            let lit = this.b.constI64(parsed, vt);
            cond = this.b.binary(IrOp.i64_eq, new ValTypeI32(), value, lit);
          } else {
            this.#bail('unparseable pattern literal');
          }
        } else if (vt is ValTypeF64) {
          let lit = this.b.constF64(parseF64(num.raw), vt);
          cond = this.b.binary(IrOp.f64_eq, new ValTypeI32(), value, lit);
        } else if (vt is ValTypeF32) {
          let lit = this.b.constF32(parseF64(num.raw), vt);
          cond = this.b.binary(IrOp.f32_eq, new ValTypeI32(), value, lit);
        } else {
          this.#bail('number pattern operand');
        }
        this.#branchUnless(cond, failB);
      }
      case BooleanLiteral as bl: {
        let vt = this.#valueType(value);
        if (!(vt is ValTypeI32)) {
          this.#bail('boolean pattern operand');
        }
        let lit = this.b.constI32(if (bl.value) 1 else 0, vt);
        let cond = this.b.binary(IrOp.i32_eq, new ValTypeI32(), value, lit);
        this.#branchUnless(cond, failB);
      }
      case NullLiteral: {
        let vt = this.#valueType(value);
        let nullable = vt is ValTypeRefNull || vt is ValTypeAnyRef ||
            vt is ValTypeEqRef;
        if (!nullable) {
          this.#bail('null pattern operand');
        }
        let cond = this.b.emit(IrOp.ref_is_null, new ValTypeI32(), value, -1);
        this.#branchUnless(cond, failB);
      }
      case StringLiteral as sl: {
        let cond = this.#stringPatternEq(value, sl);
        this.#branchUnless(cond, failB);
      }
      case MemberExpression as me: {
        // Enum constants and other member reads: compare by value.
        let expected = this.#lowerExpression(me as Expression);
        let vt = this.#valueType(value);
        if (!valTypeEquals(vt, this.#valueType(expected))) {
          this.#bail('member pattern type');
        }
        var op = IrOp.i32_eq;
        if (vt is ValTypeI32) {
          op = IrOp.i32_eq;
        } else if (vt is ValTypeI64) {
          op = IrOp.i64_eq;
        } else if (vt is ValTypeF32) {
          op = IrOp.f32_eq;
        } else if (vt is ValTypeF64) {
          op = IrOp.f64_eq;
        } else {
          this.#bail('member pattern operand');
        }
        let cond = this.b.binary(op, new ValTypeI32(), value, expected);
        this.#branchUnless(cond, failB);
      }
      case _: {
        this.#bail('pattern kind');
      }
    }
  }

  /** Binds `pattern`'s variables against `value` in the current block. */
  #lowerPatternBindings(pattern: Node, value: i32): void {
    match (pattern) {
      case IdentifierPattern as pat: {
        if (pat.name != "_") {
          let sym = this.func.model.resolveDeclaration(pat);
          if (sym != null) {
            this.#bindPatternSym(sym as Symbol, value);
          }
        }
      }
      case Identifier as ident: {
        if (ident.name != "_") {
          let sym = this.func.model.resolveDeclaration(ident);
          if (sym != null && !(sym as Symbol).isType()) {
            this.#bindPatternSym(sym as Symbol, value);
          }
        }
      }
      case AsPattern as ap: {
        let sym = this.func.model.resolveDeclaration(ap.name);
        if (sym != null) {
          this.#bindPatternSym(sym as Symbol, value);
        }
        this.#lowerPatternBindings(ap.pattern, value);
      }
      case BindingPattern as bp: {
        this.#lowerPatternBindings(bp.pattern, value);
      }
      case ClassPattern as cp: {
        let ct = this.func.model.getNodeType(cp.name);
        if (!(ct is ClassType)) {
          this.#bail('untyped class pattern');
        }
        let st = this.#classStructOf(ct as ClassType);
        let castVt = new ValTypeRef(st) as ValType;
        var casted = -1;
        for (let prop in cp.properties) {
          if (this.#patternBinds(prop.value)) {
            let fieldIdx = this.#structFieldIndex(st, prop.name.name);
            if (fieldIdx >= 0) {
              if (casted < 0) {
                casted = this.b.emit(IrOp.ref_cast, castVt, value,
                    this.b.internType(castVt));
              }
              let fieldRef = this.b.addRef(new IrRefField(st, prop.name.name));
              let fieldVal = this.b.emit(
                  IrOp.struct_get, st.fields[fieldIdx].type, casted, fieldRef);
              this.#lowerPatternBindings(prop.value, fieldVal);
            }
          }
        }
      }
      case LogicalPattern as lp: {
        if (lp.operator != "||") {
          this.#lowerPatternBindings(lp.left, value);
          this.#lowerPatternBindings(lp.right, value);
        }
        // Or-patterns with bindings bailed during the test phase.
      }
      case _: {}
    }
  }

  /**
   * Binds a pattern symbol, downcasting to the (narrowed) binding type
   * when needed — the preceding ref.test guarantees the cast succeeds.
   */
  #bindPatternSym(sym: Symbol, value: i32): void {
    let bindingType = this.func.model.getBindingType(sym);
    if (bindingType == null) {
      this.#bail('untyped match binding');
    }
    let bindingVt = typeToValTypeWithSub(this.wasm, bindingType as Type, this.func);
    this.#requireSupported(bindingVt, 'match binding type');
    var bound = value;
    let have = this.#valueType(value);
    if (!valTypeEquals(have, bindingVt) && !isValSubtype(have, bindingVt)) {
      let wantRef = bindingVt is ValTypeRef || bindingVt is ValTypeRefNull;
      if (!isRefValType(have) || !wantRef) {
        this.#bail('match binding coercion');
      }
      bound = this.b.emit(IrOp.ref_cast, bindingVt, value,
          this.b.internType(bindingVt));
    }
    if (this.#isCelled(sym.id)) {
      this.env[sym.id] = this.#cellAlloc(bindingVt, bound);
    } else {
      this.env[sym.id] = bound;
    }
    this.symbols[sym.id] = sym;
  }

  /**
   * Celled = captured by a closure and mutated on either side of the
   * boundary. The variable lives in a heap cell shared through closure
   * contexts; the environment maps the symbol to the cell REFERENCE,
   * which is an invariant SSA value — so celled bindings never
   * participate in merge parameters, and reads/writes go through the
   * cell's `value` field.
   */
  #isCelled(symId: SymbolId): boolean {
    return this.wasm.mutableCapturedSymbols.has(symId);
  }

  /** Allocates a fresh cell holding `value` for a celled binding. */
  #cellAlloc(bindingVt: ValType, value: i32): i32 {
    if (!isValSubtype(this.#valueType(value), bindingVt)) {
      this.#bail('cell init type');
    }
    let cellStruct = getCellStruct(this.wasm, bindingVt);
    let typeRef = this.b.addRef(new IrRefType(cellStruct));
    return this.b.emit(IrOp.struct_new,
        new ValTypeRef(cellStruct) as ValType,
        this.b.pushArgList(this.#oneArg(value)), typeRef);
  }

  /** The cell struct behind a celled environment entry. */
  #cellStructOf(cell: i32): WasmStruct {
    match (this.#valueType(cell)) {
      case ValTypeRef as r: {
        if (r.target is WasmStruct) {
          return r.target as WasmStruct;
        }
      }
      case ValTypeRefNull as rn: {
        if (rn.target is WasmStruct) {
          return rn.target as WasmStruct;
        }
      }
      case _: {}
    }
    throw new ZirUnsupported('celled binding shape');
  }

  #cellRead(cell: i32): i32 {
    let cs = this.#cellStructOf(cell);
    let fieldRef = this.b.addRef(new IrRefField(cs, 'value'));
    return this.b.emit(IrOp.struct_get, cs.fields[0].type, cell, fieldRef);
  }

  #cellWrite(cell: i32, value: i32): void {
    let cs = this.#cellStructOf(cell);
    if (!isValSubtype(this.#valueType(value), cs.fields[0].type)) {
      this.#bail('cell write type');
    }
    let fieldRef = this.b.addRef(new IrRefField(cs, 'value'));
    let pairIdx = this.b.pushExtra(this.#twoValues(cell, value));
    this.b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
  }

  /** Whether `pattern` can fail to match (needs a fail edge). */
  #patternRefutable(pattern: Node): boolean {
    return match (pattern) {
      case IdentifierPattern: false
      case Identifier as ident: {
        if (ident.name == "_") {
          false
        } else {
          let t = this.func.model.getNodeType(pattern);
          t is ClassType
        }
      }
      case AsPattern as ap: this.#patternRefutable(ap.pattern)
      case BindingPattern as bp: this.#patternRefutable(bp.pattern)
      case LogicalPattern as lp: {
        if (lp.operator == "||") {
          this.#patternRefutable(lp.left) && this.#patternRefutable(lp.right)
        } else {
          this.#patternRefutable(lp.left) || this.#patternRefutable(lp.right)
        }
      }
      case _: true
    };
  }

  /** Whether `pattern` introduces any bindings. */
  #patternBinds(pattern: Node): boolean {
    return match (pattern) {
      case IdentifierPattern as pat: pat.name != "_"
      case Identifier as ident: {
        if (ident.name == "_") {
          false
        } else {
          let sym = this.func.model.resolveDeclaration(ident);
          sym != null && !(sym as Symbol).isType()
        }
      }
      case AsPattern: true
      case BindingPattern as bp: this.#patternBinds(bp.pattern)
      case LiteralPattern: false
      case ClassPattern as cp: {
        var binds = false;
        for (let prop in cp.properties) {
          if (this.#patternBinds(prop.value)) {
            binds = true;
          }
        }
        binds
      }
      case LogicalPattern as lp:
          this.#patternBinds(lp.left) || this.#patternBinds(lp.right)
      case _: false
    };
  }

  /** Branches to `failB` when `cond` is false; continues in a new block. */
  #branchUnless(cond: i32, failB: i32): void {
    let contB = this.b.newBlock();
    this.b.brIf(cond, contB, this.#noArgs(), failB, this.#noArgs());
    this.b.switchTo(contB);
  }

  /** ref.test `value` against `st`, branching to `failB` on failure. */
  #emitRefTest(value: i32, st: WasmStruct, failB: i32): void {
    let vt = this.#valueType(value);
    if (!isRefValType(vt)) {
      this.#bail('type test operand');
    }
    let targetVt = new ValTypeRef(st) as ValType;
    let cond = this.b.emit(IrOp.ref_test, new ValTypeI32(), value,
        this.b.internType(targetVt));
    this.#branchUnless(cond, failB);
  }

  /** `case "lit":` — a direct call to String.==, mirroring streaming. */
  #stringPatternEq(value: i32, sl: StringLiteral): i32 {
    if (this.wasm.stringClass == null) {
      this.#bail('string pattern without String class');
    }
    let key = getClassMethodKey(
        getClassKey(this.wasm.stringClass as ClassType), "==");
    let eqFuncOpt = if (let (true, f) = this.wasm.classMethodMap.get(key)) f else null;
    if (eqFuncOpt == null) {
      this.#bail('string pattern without String.==');
    }
    let eqFunc = eqFuncOpt as WasmFunction;
    let sig = eqFunc.signature;
    if (sig.returns.length != 1 || sig.params.length != 2) {
      this.#bail('String.== shape');
    }
    let lit = this.#lowerStringLiteral(sl);
    if (!isValSubtype(this.#valueType(value), sig.params[0]) ||
        !isValSubtype(this.#valueType(lit), sig.params[1])) {
      this.#bail('string pattern operand');
    }
    let funcRef = this.b.addRef(new IrRefFunc(eqFunc));
    return this.b.callFunc(funcRef, this.#twoValues(value, lit), sig.returns[0]);
  }

  #structFieldIndex(st: WasmStruct, name: String): i32 {
    return st.fieldIndexByName(name);
  }

  #classStructOf(ct: ClassType): WasmStruct {
    if (let (true, info) = this.wasm.classInfos.get(getClassKey(ct))) {
      return info.structType;
    }
    throw new ZirUnsupported('pattern class not discovered');
  }

  /**
   * Scalar `as` casts. Same-representation casts (i32 as u32, boolean as
   * i32) are no-ops; cross-representation casts use signed conversions
   * and saturating truncation, matching the streaming backend. Casts
   * FROM unsigned types bail (no unsigned convert ops wired yet).
   */
  #lowerAs(expr: AsExpression): i32 {
    let value = this.#lowerExpression(expr.expression);
    let srcVt = this.#valueType(value);
    let dstVt = this.#exprValType(expr);
    if (valTypeEquals(srcVt, dstVt)) {
      return value;
    }
    if (this.#isUnsignedNode(expr.expression)) {
      this.#bail('cast from unsigned');
    }
    if (srcVt is ValTypeI32) {
      if (dstVt is ValTypeI64) { return this.b.emit(IrOp.i64_extend_i32_s, dstVt, value, -1); }
      if (dstVt is ValTypeF64) { return this.b.emit(IrOp.f64_convert_i32_s, dstVt, value, -1); }
      if (dstVt is ValTypeF32) { return this.b.emit(IrOp.f32_convert_i32_s, dstVt, value, -1); }
    } else if (srcVt is ValTypeI64) {
      if (dstVt is ValTypeI32) { return this.b.emit(IrOp.i32_wrap_i64, dstVt, value, -1); }
      if (dstVt is ValTypeF64) { return this.b.emit(IrOp.f64_convert_i64_s, dstVt, value, -1); }
      if (dstVt is ValTypeF32) { return this.b.emit(IrOp.f32_convert_i64_s, dstVt, value, -1); }
    } else if (srcVt is ValTypeF64) {
      if (dstVt is ValTypeI32) { return this.b.emit(IrOp.i32_trunc_sat_f64_s, dstVt, value, -1); }
      if (dstVt is ValTypeI64) { return this.b.emit(IrOp.i64_trunc_sat_f64_s, dstVt, value, -1); }
      if (dstVt is ValTypeF32) { return this.b.emit(IrOp.f32_demote_f64, dstVt, value, -1); }
    } else if (srcVt is ValTypeF32) {
      if (dstVt is ValTypeI32) { return this.b.emit(IrOp.i32_trunc_sat_f32_s, dstVt, value, -1); }
      if (dstVt is ValTypeI64) { return this.b.emit(IrOp.i64_trunc_sat_f32_s, dstVt, value, -1); }
      if (dstVt is ValTypeF64) { return this.b.emit(IrOp.f64_promote_f32, dstVt, value, -1); }
    }
    return this.#bailValue('cast kind');
  }

  #isUnsignedNode(expr: Expression): boolean {
    let t = this.func.model.getNodeType(expr);
    if (t == null) {
      return false;
    }
    let bt = baseType(t as Type);
    return bt is U32Type || bt is U64Type;
  }

  /**
   * `this` in an instance method: the receiver block param, re-asserted
   * non-null when the checked type demands it (receiver signature slots
   * are nullable for vtable compatibility, but `this` is never null).
   */
  #lowerThis(expr: Expression): i32 {
    if (this.thisValue < 0) {
      // NOT checker-impossible: default-parameter expressions are
      // supplied by the CALLER (desugared into the call's argument
      // list), so `this` in a default like `end = this.length - start`
      // reaches the lowering of a call site in a plain function, where
      // it means the callee's receiver. Until #lowerMethodCall binds
      // the receiver for default-argument expressions, bail.
      this.#bail('this outside instance method');
    }
    let haveVt = this.#valueType(this.thisValue);
    if (haveVt is ValTypeRefNull) {
      let want: ValType = new ValTypeRef(haveVt.target);
      return this.b.emit(IrOp.ref_as_non_null, want, this.thisValue, -1);
    }
    return this.thisValue;
  }

  /**
   * Maps ThisType (and the checker's `<Name>_This` marker classes) to
   * the enclosing method's concrete class.
   */
  #resolveSelfType(t: Type): Type {
    let bt = baseType(t);
    var isSelf = bt is ThisType;
    if (!isSelf && bt is ClassType) {
      let ct = bt as ClassType;
      if (ct.name.length >= 5 &&
          ct.name.sliceBytes(ct.name.length - 5, ct.name.length) == "_This") {
        isSelf = true;
      }
    }
    if (isSelf) {
      if (this.func.classType == null) {
        this.#bail('self type outside method');
      }
      return this.func.classType as Type;
    }
    return bt;
  }

  /**
   * `new C(args)` for plain (non-extension) classes: struct.new_default,
   * store the vtable when the class has one, call the constructor
   * directly. Zero-field case classes read their pre-allocated
   * singleton global instead.
   */
  #lowerNew(expr: NewExpression): i32 {
    let nodeType = this.func.model.getNodeType(expr);
    if (nodeType == null) {
      this.#bail('untyped new');
    }
    // Inside a class body, `new Point(...)` may be typed via the checker's
    // Point_This marker; resolve to the concrete class first.
    let selfResolved = this.#resolveSelfType(nodeType as Type);
    if (!(selfResolved is ClassType)) {
      this.#bail('new of non-class');
    }
    let classType = eraseTypeParameters(selfResolved);
    if (!(classType is ClassType)) {
      this.#bail('new erased kind');
    }
    let ct = classType as ClassType;
    if (ct.isExtension) {
      this.#bail('new extension class');
    }
    let cKey = getClassKey(ct);
    let infoOpt = if (let (true, info) = this.wasm.classInfos.get(cKey)) info else null;
    if (infoOpt == null) {
      this.#bail('class not discovered');
    }
    let classInfo = infoOpt as ClassCodegenInfo;
    let structType = classInfo.structType;
    let resultVt: ValType = new ValTypeRef(structType);

    if (classInfo.singletonGlobal != null) {
      let singleton = classInfo.singletonGlobal as WasmGlobal;
      let globalRef = this.b.addRef(new IrRefGlobal(singleton));
      return this.b.emit(IrOp.global_get, singleton.type, -1, globalRef);
    }

    let typeRef = this.b.addRef(new IrRefType(structType));
    let inst = this.b.emit(IrOp.struct_new_default, resultVt, -1, typeRef);

    if (classInfo.vtableGlobal != null) {
      let vtGlobal = classInfo.vtableGlobal as WasmGlobal;
      let vtRef = this.b.addRef(new IrRefGlobal(vtGlobal));
      let vtValue = this.b.emit(IrOp.global_get, vtGlobal.type, -1, vtRef);
      let fieldRef = this.b.addRef(new IrRefField(structType, '<vtable>'));
      let pairIdx = this.b.pushExtra(this.#twoValues(inst, vtValue));
      this.b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
    }

    let ctorKey = getClassMethodKey(cKey, '<constructor>');
    if (let (true, ctor) = this.wasm.classMethodMap.get(ctorKey)) {
      let sig = ctor.signature;
      if (sig.params.length != expr.args.length + 1) {
        this.#bail('constructor arity adaptation');
      }
      let args = new Array<i32>();
      args.push(inst);
      for (var i = 0; i < expr.args.length; i += 1) {
        let paramVt = sig.params[i + 1];
        this.#requireSupported(paramVt, 'constructor param type');
        let value = this.#lowerExpressionCtx(expr.args[i], paramVt);
        if (!isValSubtype(this.#valueType(value), paramVt)) {
          this.#bail('constructor argument type');
        }
        args.push(value);
      }
      let ctorRef = this.b.addRef(new IrRefFunc(ctor));
      this.b.callFunc(ctorRef, args, null);
    } else if (expr.args.length > 0) {
      this.#bail('constructor missing');
    }
    return inst;
  }

  /**
   * Member writes: direct struct.set when the property is a physical
   * field and no transitive subclass provides a setter for it. Setter
   * dispatch and static writes bail. Compound assignments read through
   * the same receiver value, so the object expression evaluates once.
   */
  #lowerMemberAssign(assign: AssignmentExpression): i32 {
    let member = assign.left as MemberExpression;
    if (member.optional) {
      this.#bail('optional member write');
    }
    if (this.func.model.isStaticAccess(member)) {
      this.#bail('static member write');
    }
    let receiver = this.#lowerExpression(member.object);
    let receiverCt = this.#receiverClass(receiver, member);
    let target = this.#resolveMemberTarget(member, receiverCt);
    if (target.fieldName == null) {
      this.#bail('write through accessor');
    }
    let fieldName = target.fieldName as String;
    // Setter-side override checks (the read-side resolve checked get#):
    // neither a redefined setter between receiver and declarer nor a
    // transitive-subclass setter may exist for a direct struct.set.
    let propName = getMemberPropertyName(member.isSymbolAccess, member.property.name);
    let isPrivateWrite = propName.length > 0 && propName.sliceBytes(0, 1) == "#";
    if (!isPrivateWrite &&
        this.#accessorRedefined(receiverCt, propName, 'set#' + propName)) {
      this.#bail('field with redefined setter');
    }
    var infoOpt: ClassCodegenInfo | null = null;
    if (let (true, info) = this.wasm.classInfos.get(getClassKey(receiverCt))) {
      infoOpt = info;
    }
    if (!isPrivateWrite && infoOpt != null &&
        this.#memberProvidedBySubclass(infoOpt as ClassCodegenInfo, 'set#' + propName)) {
      this.#bail('field with overriding setter');
    }

    if (!isValSubtype(this.#valueType(receiver),
        new ValTypeRefNull(target.owner) as ValType)) {
      this.#bail('member receiver struct mismatch');
    }
    let fieldVt = this.#fieldValType(target.owner, fieldName);
    var value = -1;
    if (assign.operator == null) {
      value = this.#lowerExpressionCtx(assign.value, fieldVt);
    } else {
      let fieldRefRead = this.b.addRef(new IrRefField(target.owner, fieldName));
      let readVt = this.#exprValType(member);
      let current = this.b.emit(IrOp.struct_get, readVt, receiver, fieldRefRead);
      let rhs = this.#lowerExpression(assign.value);
      let vt = this.#valueType(current);
      if (!valTypeEquals(vt, this.#valueType(rhs))) {
        this.#bail('mixed member compound types');
      }
      let unsigned = this.#isUnsignedNode(member as Expression) ||
          this.#isUnsignedNode(assign.value);
      let op = this.#mapBinaryOp(assign.operator as String, vt, unsigned);
      value = this.b.binary(op, vt, current, rhs);
    }
    if (!isValSubtype(this.#valueType(value), fieldVt)) {
      this.#bail('member write type');
    }
    let fieldRef = this.b.addRef(new IrRefField(target.owner, fieldName));
    let pairIdx = this.b.pushExtra(this.#twoValues(receiver, value));
    this.b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
    return value;
  }

  #fieldValType(owner: WasmStruct, name: String): ValType {
    let idx = owner.fieldIndexByName(name);
    if (idx < 0) {
      this.#bail('field not found on struct');
    }
    return owner.fields[idx].type;
  }

  /**
   * Member reads on class-typed receivers: a direct struct.get when the
   * property is a physical field on the receiver's struct and no
   * subclass overrides its accessor; otherwise a direct call to a
   * non-overridden getter. Interfaces, statics, optional chains, and
   * anything needing dynamic dispatch bail.
   */
  #lowerMemberRead(member: MemberExpression): i32 {
    if (member.optional) {
      this.#bail('optional member access');
    }
    let objectType = this.func.model.getNodeType(member.object);
    if (objectType != null &&
        this.#resolveSelfType(objectType as Type) is InterfaceType) {
      if (this.func.model.isStaticAccess(member)) {
        this.#bail('static interface access');
      }
      let it = this.#resolveSelfType(objectType as Type) as InterfaceType;
      let propName = getMemberPropertyName(
          member.isSymbolAccess, member.property.name);
      let result = this.#lowerInterfaceDispatch(
          it, 'get#' + propName, member.object, null);
      return this.#reassertNonNull(result, this.#exprValType(member));
    }
    let receiver = this.#lowerExpression(member.object);
    let target = this.#resolveMemberTarget(
        member, this.#receiverClass(receiver, member));
    let receiverVt = this.#valueType(receiver);
    let isStructRef = receiverVt is ValTypeRef || receiverVt is ValTypeRefNull;
    if (!isStructRef) {
      this.#bail('member receiver kind');
    }
    // The receiver value must actually be (a subtype of) the struct the
    // member resolved against — mismatched specialization keys (e.g.
    // intrinsic array classes) would otherwise emit invalid struct.gets.
    if (!isValSubtype(receiverVt,
        new ValTypeRefNull(target.owner) as ValType)) {
      this.#bail('member receiver struct mismatch');
    }
    if (target.fieldName != null) {
      let fieldName = target.fieldName as String;
      let fieldRef = this.b.addRef(new IrRefField(target.owner, fieldName));
      // The struct.get result carries the field's STORAGE type; the
      // member's checked type may be narrower (non-null).
      let fieldVt = this.#fieldValType(target.owner, fieldName);
      let read = this.b.emit(IrOp.struct_get, fieldVt, receiver, fieldRef);
      return this.#reassertNonNull(read, this.#exprValType(member));
    }
    let getter = target.getter as WasmFunction;
    let sig = getter.signature;
    if (sig.returns.length != 1) {
      this.#bail('getter shape');
    }
    let getterRef = this.b.addRef(new IrRefFunc(getter));
    let call = this.b.callFunc(getterRef, this.#oneArg(receiver), sig.returns[0]);
    // Getter signatures return the field's (nullable) storage type; the
    // member's checked type may be non-null.
    return this.#reassertNonNull(call, this.#exprValType(member));
  }

  /**
   * Devirtualized method calls only: the receiver's class (or an
   * ancestor) provides the method, no transitive subclass overrides it,
   * the name resolves directly (overloads use mangled keys and miss),
   * and arity matches exactly. Everything else — statics, interfaces,
   * generic methods, optional calls, dynamic dispatch — bails.
   */
  #lowerMethodCall(call: CallExpression, member: MemberExpression): i32 {
    if (member.optional || call.optional) {
      this.#bail('optional method call');
    }
    if (call.typeArguments != null) {
      this.#bail('generic method call');
    }
    if (this.func.model.isStaticAccess(member)) {
      this.#bail('static method call');
    }
    let objectType = this.func.model.getNodeType(member.object);
    if (objectType == null) {
      this.#bail('untyped method receiver');
    }
    let selfResolved = this.#resolveSelfType(objectType as Type);
    if (selfResolved is InterfaceType) {
      let propName = getMemberPropertyName(
          member.isSymbolAccess, member.property.name);
      let result = this.#lowerInterfaceDispatch(
          selfResolved as InterfaceType, propName, member.object, call.args);
      let nodeType = this.func.model.getNodeType(call);
      if (nodeType != null && !(baseType(nodeType as Type) is VoidType) &&
          this.b.body.typeId[result] >= 0) {
        let want = typeToValTypeWithSub(this.wasm, nodeType as Type, this.func);
        return this.#reassertNonNull(result, want);
      }
      return result;
    }
    if (!(selfResolved is ClassType)) {
      this.#bail('method receiver kind');
    }
    // Resolve against the class the receiver VALUE carries: checked
    // node types name the GENERIC class inside specialized-method
    // bodies, but specialized methods register under their own key.
    let receiver = this.#lowerExpression(member.object);
    var ct = eraseTypeParameters(selfResolved) as ClassType;
    let fromValue = this.#classTypeOfValue(receiver);
    if (fromValue != null) {
      ct = fromValue as ClassType;
    }
    let cKey = getClassKey(ct);
    let infoOpt = if (let (true, info) = this.wasm.classInfos.get(cKey)) info else null;
    if (infoOpt == null) {
      this.#bail('method receiver not discovered');
    }
    let classInfo = infoOpt as ClassCodegenInfo;
    let propName = getMemberPropertyName(member.isSymbolAccess, member.property.name);

    var methodOpt: WasmFunction | null = null;
    let isPrivate = propName.length > 0 && propName.sliceBytes(0, 1) == "#";
    if (isPrivate) {
      // Private methods are lexically scoped and never virtual: they
      // resolve ONLY against the class the code was written in — plus
      // that class's own specializations (same canonical class), since
      // specialized copies register under their specialized keys.
      // Never against super- or subclasses: private names cannot be
      // shared across a hierarchy.
      let lexicalCt = this.#lexicalClassOf(member, ct);
      let lexKey = getClassMethodKey(getClassKey(lexicalCt), propName);
      if (let (true, m) = this.wasm.classMethodMap.get(lexKey)) {
        methodOpt = m;
      }
      if (methodOpt == null) {
        let lexCanonical = this.#canonicalKeyOf(lexicalCt);
        var c: ClassType | null = ct;
        while (c != null && methodOpt == null) {
          let cc = c as ClassType;
          if (this.#canonicalKeyOf(cc) == lexCanonical) {
            let key = getClassMethodKey(getClassKey(cc), propName);
            if (let (true, m2) = this.wasm.classMethodMap.get(key)) {
              methodOpt = m2;
            }
          }
          c = cc.superType;
        }
      }
      if (methodOpt == null) {
        this.#bail('private method not found');
      }
    }
    var currClass: ClassType | null = ct;
    while (currClass != null && methodOpt == null) {
      // Inner walk through generic sources: shared (unspecialized)
      // template methods register under the template's key.
      var g: ClassType | null = currClass;
      while (g != null && methodOpt == null) {
        let key = getClassMethodKey(getClassKey(g as ClassType), propName);
        if (let (true, m) = this.wasm.classMethodMap.get(key)) {
          methodOpt = m;
        }
        g = (g as ClassType).genericSource;
      }
      currClass = (currClass as ClassType).superType;
    }
    if (methodOpt == null) {
      this.#bail('method not found');
    }
    let method = methodOpt as WasmFunction;
    if (method.isStatic || method.typeParameters != null ||
        method.intrinsic != null) {
      this.#bail('method shape');
    }
    if (!isPrivate && this.#memberProvidedBySubclass(classInfo, propName)) {
      // Private access is never virtual, so the devirt-safety check
      // only applies to public members.
      this.#bail('overridden method');
    }
    let sig = method.signature;
    if (sig.returns.length > 1) {
      this.#bail('method multi-value return');
    }
    if (sig.params.length != call.args.length + 1) {
      this.#bail('method arity adaptation');
    }

    if (!isValSubtype(this.#valueType(receiver), sig.params[0])) {
      this.#bail('method receiver type');
    }
    let args = new Array<i32>();
    args.push(receiver);
    for (var i = 0; i < call.args.length; i += 1) {
      let paramVt = sig.params[i + 1];
      this.#requireSupported(paramVt, 'method param type');
      let value = this.#lowerExpressionCtx(call.args[i], paramVt);
      if (!isValSubtype(this.#valueType(value), paramVt)) {
        this.#bail('method argument type');
      }
      args.push(value);
    }
    let resultType = if (sig.returns.length == 1) sig.returns[0] else null;
    if (resultType != null) {
      this.#requireSupported(resultType, 'method result type');
    }
    let methodRef = this.b.addRef(new IrRefFunc(method));
    let result = this.b.callFunc(methodRef, args, resultType);
    if (resultType != null) {
      let nodeType = this.func.model.getNodeType(call);
      if (nodeType != null && !(baseType(nodeType as Type) is VoidType)) {
        let want = typeToValTypeWithSub(this.wasm, nodeType as Type, this.func);
        if (want is ValTypeRef && (resultType as ValType) is ValTypeRefNull) {
          return this.b.emit(IrOp.ref_as_non_null, want, result, -1);
        }
      }
    }
    return result;
  }

  /**
   * Interface vtable dispatch (ir.md §5): unpack the fat pointer, load
   * the member's funcref slot from the vtable, and call_ref through it.
   * `memberName` is the vtable slot name — a method name or a get#/set#
   * accessor. `argExprs` is null for accessor reads (receiver only).
   */
  #lowerInterfaceDispatch(it: InterfaceType, memberName: String,
      receiverExpr: Expression, argExprs: Array<Expression> | null): i32 {
    let iName = getInterfaceKey(it);
    let vstOpt = if (let (true, v) = this.wasm.interfaceVTableStructs.get(iName)) v else null;
    let fatPtrOpt = if (let (true, st) = this.wasm.interfaceStructs.get(iName)) st else null;
    if (vstOpt == null || fatPtrOpt == null) {
      this.#bail('interface not discovered');
    }
    let vst = vstOpt as WasmStruct;
    let fatPtr = fatPtrOpt as WasmStruct;
    let slot = vst.fieldIndexByName(memberName);
    if (slot < 0) {
      // Function-typed interface fields called as methods land here
      // (streaming falls back to a closure call); closures bail.
      this.#bail('interface member not in vtable');
    }
    // The vtable slot's declared type IS the signature (the RTA pass
    // types slots as exact (ref $sig)); using it keeps the callee value
    // consistent with what emission derives the call_ref type from.
    var sigOpt: WasmSignature | null = null;
    match (vst.fields[slot].type) {
      case ValTypeRef as r: {
        if (r.target is WasmSignature) {
          sigOpt = r.target as WasmSignature;
        }
      }
      case _: {}
    }
    if (sigOpt == null) {
      this.#bail('interface slot shape');
    }
    let sig = sigOpt as WasmSignature;
    if (sig.returns.length > 1) {
      this.#bail('interface member multi-value return');
    }
    let argCount = if (argExprs == null) 0
        else (argExprs as Array<Expression>).length;
    if (sig.params.length != argCount + 1) {
      this.#bail('interface call arity adaptation');
    }

    let recv = this.#lowerExpression(receiverExpr);
    if (!isValSubtype(this.#valueType(recv),
        new ValTypeRefNull(fatPtr) as ValType)) {
      this.#bail('interface receiver type');
    }
    let inst = this.b.emit(
        IrOp.iface_instance, fatPtr.fields[0].type, recv, -1);
    if (!isValSubtype(this.#valueType(inst), sig.params[0])) {
      this.#bail('interface receiver adaptation');
    }
    let args = new Array<i32>();
    args.push(inst);
    if (argExprs != null) {
      let list = argExprs as Array<Expression>;
      for (var i = 0; i < list.length; i += 1) {
        let paramVt = sig.params[i + 1];
        this.#requireSupported(paramVt, 'interface param type');
        let value = this.#lowerExpressionCtx(list[i], paramVt);
        if (!isValSubtype(this.#valueType(value), paramVt)) {
          this.#bail('interface argument type');
        }
        args.push(value);
      }
    }
    let vt = this.b.emit(IrOp.iface_vtable, fatPtr.fields[1].type, recv, -1);
    let fieldRef = this.b.addRef(new IrRefField(vst, memberName));
    let callee = this.b.emit(
        IrOp.struct_get, vst.fields[slot].type, vt, fieldRef);
    var resultType: ValType | null = null;
    if (sig.returns.length == 1) {
      this.#requireSupported(sig.returns[0], 'interface result type');
      resultType = sig.returns[0];
    }
    return this.b.callRef(callee, args, resultType);
  }

  /**
   * The ClassType a lowered receiver value actually carries: struct
   * types remember their class. This beats re-deriving the class from
   * checked node types, which name the GENERIC class inside
   * specialized-method bodies (same authoritative-source principle as
   * the closure-identity fix).
   */
  #classTypeOfValue(value: i32): ClassType | null {
    match (this.#valueType(value)) {
      case ValTypeRef as r: {
        if (r.target is WasmStruct) {
          return (r.target as WasmStruct).classType;
        }
      }
      case ValTypeRefNull as rn: {
        if (rn.target is WasmStruct) {
          return (rn.target as WasmStruct).classType;
        }
      }
      case _: {}
    }
    return null;
  }

  /**
   * The LEXICAL class of a member access: derived from the checked
   * type of the receiver expression, which names the class the
   * accessing code was written in — the generic template inside
   * specialized-method bodies, and the DECLARING class inside method
   * bodies the compiler copies into subclasses. Private members are
   * lexically scoped, so their mangled names must resolve against
   * this, never against the receiver value's (possibly more derived,
   * possibly more specialized) runtime class.
   */
  #lexicalClassOf(member: MemberExpression, fallback: ClassType): ClassType {
    let objectType = this.func.model.getNodeType(member.object);
    if (objectType != null) {
      let selfResolved = this.#resolveSelfType(objectType as Type);
      if (selfResolved is ClassType) {
        return eraseTypeParameters(selfResolved) as ClassType;
      }
    }
    return fallback;
  }

  /**
   * Resolves a private member's mangled struct-field name by walking
   * the LEXICAL declaring chain — supertypes and generic sources —
   * since fields are stored under the DECLARING class's key (the
   * template's for specialized generics, an ancestor's for privates
   * accessed from copied method bodies).
   */
  #privateLookupName(st: WasmStruct, ct: ClassType, propName: String): String | null {
    var curr: ClassType | null = ct;
    while (curr != null) {
      let c = curr as ClassType;
      var g: ClassType | null = c;
      while (g != null) {
        let key = getClassPrivateFieldKey(getClassKey(g as ClassType), propName);
        if (st.fieldIndexByName(key) >= 0) {
          return key;
        }
        g = (g as ClassType).genericSource;
      }
      curr = c.superType;
    }
    return null;
  }

  /** The generic-source root's key: specializations compare equal to
   * their template through this. */
  #canonicalKeyOf(ct: ClassType): String {
    var c = ct;
    while (c.genericSource != null) {
      c = c.genericSource as ClassType;
    }
    return getClassKey(c) as String;
  }

  /** Receiver class for member/method resolution: the value's own
   * class when its struct carries one, else the checked type. */
  #receiverClass(receiver: i32, member: MemberExpression): ClassType {
    let fromValue = this.#classTypeOfValue(receiver);
    if (fromValue != null) {
      return fromValue as ClassType;
    }
    let objectType = this.func.model.getNodeType(member.object);
    if (objectType == null) {
      this.#bail('untyped member receiver');
    }
    let selfResolved = this.#resolveSelfType(objectType as Type);
    if (!(selfResolved is ClassType)) {
      this.#bail('member on non-class');
    }
    return eraseTypeParameters(selfResolved) as ClassType;
  }

  /**
   * Resolves a member read against the receiver's class: either a
   * physical field (fieldName set) or a non-overridden getter function.
   */
  #resolveMemberTarget(member: MemberExpression, ct: ClassType): MemberTarget {
    let cKey = getClassKey(ct);
    let infoOpt = if (let (true, info) = this.wasm.classInfos.get(cKey)) info else null;
    if (infoOpt == null) {
      this.#bail('receiver class not discovered');
    }
    let classInfo = infoOpt as ClassCodegenInfo;
    let structType = classInfo.structType;
    var propName = getMemberPropertyName(member.isSymbolAccess, member.property.name);
    var lookupName = propName;
    if (propName.length > 0 && propName.sliceBytes(0, 1) == "#") {
      if (this.func.classType == null) {
        this.#bail('private access outside class');
      }
      let lexicalCt = this.#lexicalClassOf(member, ct);
      let resolved = this.#privateLookupName(structType, lexicalCt, propName);
      if (resolved != null) {
        lookupName = resolved as String;
      } else {
        lookupName = getClassPrivateFieldKey(getClassKey(lexicalCt), propName);
      }
    }

    // Physical field with the property's name? (Memoized on the
    // struct: this runs once per member access.) A direct read is only
    // sound when no class between the receiver and the field's declarer
    // redefined the accessor (a subclass shadowing an inherited field
    // with a getter leaves the parent's physical field in the struct),
    // and no transitive subclass overrides it either. Private access
    // is never virtual, so those checks only apply to public members.
    let isPrivate = propName.length > 0 && propName.sliceBytes(0, 1) == "#";
    let hasField = structType.fieldIndexByName(lookupName) >= 0;
    if (hasField && isPrivate) {
      return new MemberTarget(structType, lookupName, null);
    }
    if (hasField && !this.#accessorRedefined(ct, propName, 'get#' + propName)) {
      if (this.#memberProvidedBySubclass(classInfo, 'get#' + propName)) {
        this.#bail('field with overriding accessor');
      }
      return new MemberTarget(structType, lookupName, null);
    }

    // Getter?
    let getterKey = getClassMethodKey(cKey, 'get#' + propName);
    var getter: WasmFunction | null = null;
    var currClass: ClassType | null = ct;
    while (currClass != null && getter == null) {
      let key = getClassMethodKey(getClassKey(currClass as ClassType), 'get#' + propName);
      if (let (true, g) = this.wasm.classMethodMap.get(key)) {
        getter = g;
      }
      currClass = (currClass as ClassType).superType;
    }
    if (getter == null) {
      this.#bail('member not found');
    }
    if ((getter as WasmFunction).isStatic) {
      this.#bail('static member');
    }
    if (!isPrivate && this.#memberProvidedBySubclass(classInfo, 'get#' + propName)) {
      this.#bail('overridden getter');
    }
    return new MemberTarget(structType, null, getter);
  }

  /**
   * True when a class between the receiver and the property's declaring
   * class redefines the accessor: the field-declaring class provides the
   * DEFAULT accessor, and if the nearest definition walking up from the
   * receiver differs, physical field access is wrong (mirrors the
   * streaming generator's hasOverride computation).
   */
  #accessorRedefined(ct: ClassType, propName: String, accessorName: String): boolean {
    var fieldDeclaringClass = ct;
    var curr: ClassType | null = ct;
    while (curr != null) {
      let c = curr as ClassType;
      if (c.members.has(propName) && c.members[propName] is FieldInfo) {
        fieldDeclaringClass = c;
      }
      curr = c.superType;
    }
    let defKey = getClassMethodKey(getClassKey(fieldDeclaringClass), accessorName);
    let defaultAccessor = if (let (true, d) = this.wasm.classMethodMap.get(defKey)) d else null;
    var resolved: WasmFunction | null = null;
    var currClass: ClassType | null = ct;
    while (currClass != null && resolved == null) {
      let key = getClassMethodKey(
          getClassKey(currClass as ClassType), accessorName);
      if (let (true, r) = this.wasm.classMethodMap.get(key)) {
        resolved = r;
      }
      currClass = (currClass as ClassType).superType;
    }
    return resolved != null && defaultAccessor != null &&
        resolved != defaultAccessor;
  }

  /** True if any transitive subclass provides its own `methodName`. */
  #memberProvidedBySubclass(classInfo: ClassCodegenInfo, methodName: String): boolean {
    let subclasses = new Array<ClassCodegenInfo>();
    classInfo.getTransitiveSubclasses(subclasses);
    for (let sub in subclasses) {
      let subClassType = sub.structType.classType;
      if (subClassType != null) {
        let key = getClassMethodKey(getClassKey(subClassType as ClassType), methodName);
        if (this.wasm.classMethodMap.has(key)) {
          return true;
        }
      }
    }
    return false;
  }

  #twoValues(a: i32, b: i32): Array<i32> {
    let result = new Array<i32>();
    result.push(a);
    result.push(b);
    return result;
  }

  /**
   * String literals: the fast path only — RTA pre-registers every
   * literal reached through checker dependencies, so the shared-data
   * helper call covers it (i32.const id; call $get_string_literal).
   * Literals missing from the registry bail to the streaming path,
   * which also knows how to build one-off strings inline.
   */
  #lowerStringLiteral(lit: StringLiteral): i32 {
    let litId = if (let (true, id) = this.wasm.stringLiteralIds.get(lit.value)) id else -1;
    if (litId < 0) {
      this.#bail('unregistered string literal');
    }
    if (this.wasm.getStringLiteralFunc == null) {
      this.#bail('no string literal helper');
    }
    let helper = this.wasm.getStringLiteralFunc as WasmFunction;
    if (helper.signature.returns.length != 1) {
      this.#bail('string helper shape');
    }
    let id = this.b.constI32(litId, new ValTypeI32());
    let funcRef = this.b.addRef(new IrRefFunc(helper));
    let call = this.b.callFunc(funcRef, this.#oneArg(id), helper.signature.returns[0]);
    // The literal's checked type is a non-null String; the helper returns
    // nullable. Re-assert non-nullness so merges and returns type-check.
    return this.#reassertNonNull(call, this.#exprValType(lit));
  }

  /**
   * Direct calls only: the callee is an identifier statically resolving
   * to a non-generic, non-adapted top-level function (or import) whose
   * signature is all scalars and whose arity matches the call exactly
   * (an arity mismatch means default-argument adaptation). Everything
   * else — methods, function values, generics, optional calls — bails.
   *
   * A void call returns its (valueless) instruction id; the checker
   * rejects void values in operand position, and if one ever slipped
   * through, the verifier's produces-no-value check fails loudly.
   */
  #lowerCall(call: CallExpression): i32 {
    if (call.callee is MemberExpression) {
      return this.#lowerMethodCall(call, call.callee as MemberExpression);
    }
    if (!(call.callee is Identifier)) {
      this.#bail('call callee kind');
    }
    if (call.optional) {
      this.#bail('optional call');
    }
    if (call.typeArguments != null) {
      this.#bail('generic call');
    }
    if (this.func.model.getUnionCallCalleeType(call.callee) != null) {
      this.#bail('union callee');
    }
    let sym = this.func.model.resolve(call.callee);
    if (sym == null) {
      this.#bail('unresolved callee');
    }
    let resolved = (sym as Symbol).resolveTarget();
    if (this.env.has(resolved.id)) {
      // A local variable holding a function value: closure call.
      return this.#lowerClosureCall(call);
    }
    let targetOpt = if (let (true, t) = this.wasm.functionMap.get(resolved.id)) t else null;
    if (targetOpt == null) {
      // Not a compiled function: a binding holding a closure value
      // (global function values still bail when the callee lowers).
      return this.#lowerClosureCall(call);
    }
    let target = targetOpt as WasmFunction;
    if (target.typeParameters != null || target.typeArguments != null ||
        target.intrinsic != null || target.isFunctionAdaptation ||
        target.isClosure || target.contextStruct != null ||
        target.captures.length > 0 || target.capturesThis ||
        target.classType != null || target.structType != null) {
      this.#bail('callee shape');
    }
    let sig = target.signature;
    if (sig.returns.length > 1) {
      this.#bail('callee multi-value return');
    }
    if (sig.params.length != call.args.length) {
      this.#bail('call arity adaptation');
    }
    for (var i = 0; i < sig.params.length; i += 1) {
      this.#requireSupported(sig.params[i], 'call param type');
    }
    var resultType: ValType | null = null;
    if (sig.returns.length == 1) {
      this.#requireSupported(sig.returns[0], 'call result type');
      resultType = sig.returns[0];
    }
    let args = new Array<i32>();
    for (var i = 0; i < call.args.length; i += 1) {
      let value = this.#lowerExpressionCtx(call.args[i], sig.params[i]);
      if (!isValSubtype(this.#valueType(value), sig.params[i])) {
        this.#bail('call argument type');
      }
      args.push(value);
    }
    let funcRef = this.b.addRef(new IrRefFunc(target));
    return this.b.callFunc(funcRef, args, resultType);
  }

  /**
   * Closure creation: ref.func of the (separately compiled, streaming
   * or ZIR) implementation, a context struct holding the captured
   * values, and the closure pair struct. Non-celled captures are BY
   * VALUE; celled captures pass the heap cell ref the environment
   * already holds — the context-field subtype check verifies each
   * capture matches what the closure body expects either way.
   */
  #lowerFunctionExpression(fExpr: FunctionExpression): i32 {
    let classKey = if (this.func.classType != null) {
      getClassKey(this.func.classType as ClassType)
    } else {
      "" as ClassKey
    };
    let closureKey = getClosureSpecializationKey(fExpr.id, classKey);
    var implOpt: WasmFunction | null = null;
    if (let (true, sc) = this.wasm.specializedClosures.get(closureKey)) {
      implOpt = sc;
    } else if (let (true, cf) = this.wasm.closureFunctions.get(fExpr)) {
      implOpt = cf;
    }
    if (implOpt == null) {
      this.#bail('closure not registered');
    }
    let impl = implOpt as WasmFunction;
    // The pair struct is keyed by the IMPLEMENTATION's own signature —
    // deriving it from the checked node type drifted under
    // substitution, and the func slot must hold exactly (ref implSig)
    // anyway.
    let pairKey = getClosureKey(impl.signature.params, impl.signature.returns);
    let closureStructOpt = if (let (true, st) = this.wasm.closureStructs.get(pairKey)) st else null;
    if (closureStructOpt == null) {
      this.#bail('closure pair struct not found');
    }
    let closureStruct = closureStructOpt as WasmStruct;
    if (impl.contextStruct == null) {
      this.#bail('closure without context struct');
    }
    let contextStruct = impl.contextStruct as WasmStruct;

    var ctxVal = -1;
    if (contextStruct.fields.length > 0) {
      let ctxArgs = new Array<i32>();
      var fieldIdx = 0;
      if (impl.capturesThis) {
        if (this.thisValue < 0) {
          this.#bail('closure captures this outside method');
        }
        if (!isValSubtype(this.#valueType(this.thisValue),
            contextStruct.fields[0].type)) {
          this.#bail('closure this capture type');
        }
        ctxArgs.push(this.thisValue);
        fieldIdx = 1;
      }
      for (let symId in impl.captures) {
        if (!this.env.has(symId)) {
          this.#bail('captured symbol not local');
        }
        let v = this.env[symId];
        if (!isValSubtype(this.#valueType(v),
            contextStruct.fields[fieldIdx].type)) {
          // Celled capture (context field wants a cell ref).
          this.#bail('celled capture');
        }
        ctxArgs.push(v);
        fieldIdx += 1;
      }
      let ctxTypeRef = this.b.addRef(new IrRefType(contextStruct));
      ctxVal = this.b.emit(IrOp.struct_new,
          new ValTypeRef(contextStruct) as ValType,
          this.b.pushArgList(ctxArgs), ctxTypeRef);
    } else {
      ctxVal = this.b.emit(IrOp.ref_null, new ValTypeStructRef(), -1, -1);
    }

    // The func slot's declared signature must be the implementation's
    // own signature (both come from the interned signature table).
    var slotSig: WasmSignature | null = null;
    match (closureStruct.fields[0].type) {
      case ValTypeRef as r: {
        if (r.target is WasmSignature) {
          slotSig = r.target as WasmSignature;
        }
      }
      case _: {}
    }
    if (slotSig == null || (slotSig as WasmSignature) != impl.signature) {
      this.#bail('closure signature adaptation');
    }
    let funcVal = this.b.emit(IrOp.ref_func, closureStruct.fields[0].type,
        -1, this.b.addRef(new IrRefFunc(impl)));
    let pairArgs = this.#twoValues(funcVal, ctxVal);
    return this.b.emit(IrOp.struct_new,
        new ValTypeRef(closureStruct) as ValType,
        this.b.pushArgList(pairArgs),
        this.b.addRef(new IrRefType(closureStruct)));
  }

  /**
   * Calls through a closure value {func: (ref $implSig), ctx: structref}:
   * the context rides as argument 0, and call_ref goes through the
   * exact-signature func field. Only the CALLING side is lowered —
   * closure creation and closure bodies still bail.
   */
  #lowerClosureCall(call: CallExpression): i32 {
    let callee = this.#lowerExpression(call.callee);
    // The callee value's OWN type carries the authoritative closure
    // struct; recomputing it from the checked node type drifted
    // whenever substitution or nullability normalization disagreed
    // with the type the value actually flowed in with.
    var structOpt: WasmStruct | null = null;
    match (this.#valueType(callee)) {
      case ValTypeRef as r: {
        if (r.target is WasmStruct) {
          structOpt = r.target as WasmStruct;
        }
      }
      case ValTypeRefNull as rn: {
        if (rn.target is WasmStruct) {
          structOpt = rn.target as WasmStruct;
        }
      }
      case _: {}
    }
    if (structOpt == null) {
      this.#bail('closure callee kind');
    }
    let closureStruct = structOpt as WasmStruct;
    if (closureStruct.fields.length != 2) {
      // Not a closure pair struct (e.g. a class instance): bail.
      this.#bail('closure callee shape');
    }
    var sigOpt: WasmSignature | null = null;
    match (closureStruct.fields[0].type) {
      case ValTypeRef as r: {
        if (r.target is WasmSignature) {
          sigOpt = r.target as WasmSignature;
        }
      }
      case _: {}
    }
    if (sigOpt == null) {
      this.#bail('closure callee shape');
    }
    let sig = sigOpt as WasmSignature;
    if (sig.returns.length > 1) {
      this.#bail('closure multi-value return');
    }
    if (sig.params.length != call.args.length + 1) {
      this.#bail('closure arity adaptation');
    }
    let ctxRef = this.b.addRef(new IrRefField(closureStruct, 'ctx'));
    let ctxVal = this.b.emit(IrOp.struct_get,
        closureStruct.fields[1].type, callee, ctxRef);
    let args = new Array<i32>();
    args.push(ctxVal);
    for (var i = 0; i < call.args.length; i += 1) {
      let paramVt = sig.params[i + 1];
      this.#requireSupported(paramVt, 'closure param type');
      let value = this.#lowerExpressionCtx(call.args[i], paramVt);
      if (!isValSubtype(this.#valueType(value), paramVt)) {
        this.#bail('closure argument type');
      }
      args.push(value);
    }
    let funcRef = this.b.addRef(new IrRefField(closureStruct, 'func'));
    let funcVal = this.b.emit(IrOp.struct_get,
        closureStruct.fields[0].type, callee, funcRef);
    var resultType: ValType | null = null;
    if (sig.returns.length == 1) {
      this.#requireSupported(sig.returns[0], 'closure result type');
      resultType = sig.returns[0];
    }
    let result = this.b.callRef(funcVal, args, resultType);
    if (resultType != null) {
      let nodeType = this.func.model.getNodeType(call);
      if (nodeType != null && !(baseType(nodeType as Type) is VoidType)) {
        let want = typeToValTypeWithSub(this.wasm, nodeType as Type, this.func);
        return this.#reassertNonNull(result, want);
      }
    }
    return result;
  }

  #lowerAssignment(assign: AssignmentExpression): i32 {
    if (assign.left is MemberExpression) {
      return this.#lowerMemberAssign(assign);
    }
    if (!(assign.left is Identifier)) {
      this.#bail('assignment target');
    }
    let sym = this.func.model.resolve(assign.left);
    if (sym == null) {
      this.#bail('unresolved assignment target');
    }
    let resolved = (sym as Symbol).resolveTarget();
    if (!this.env.has(resolved.id)) {
      this.#bail('non-local assignment target');
    }
    let celled = this.#isCelled(resolved.id);
    var value = -1;
    if (assign.operator == null) {
      var assignCtx: ValType | null = null;
      let targetBinding = this.func.model.getBindingType(resolved);
      if (targetBinding != null) {
        assignCtx = typeToValTypeWithSub(this.wasm, targetBinding as Type, this.func);
      }
      value = this.#lowerExpressionCtx(assign.value, assignCtx);
    } else {
      // Compound assignment: current op= value.
      this.#requireScalarNode(assign.left);
      this.#requireScalarNode(assign.value);
      let current = if (celled) this.#cellRead(this.env[resolved.id])
          else this.env[resolved.id];
      let rhs = this.#lowerExpression(assign.value);
      let vt = this.#valueType(current);
      if (!valTypeEquals(vt, this.#valueType(rhs))) {
        this.#bail('mixed compound assignment types');
      }
      let unsigned = this.#isUnsignedNode(assign.left) || this.#isUnsignedNode(assign.value);
      let op = this.#mapBinaryOp(assign.operator as String, vt, unsigned);
      value = this.b.binary(op, vt, current, rhs);
    }
    if (celled) {
      // Mutation goes through the heap cell; the env binding (the cell
      // ref) is invariant.
      this.#cellWrite(this.env[resolved.id], value);
    } else {
      this.env[resolved.id] = value;
    }
    return value;
  }

  // -- Helpers ---------------------------------------------------------

  #mapBinaryOp(operator: String, vt: ValType, unsigned: boolean): IrOp {
    if (vt is ValTypeI32) {
      if (operator == "+") { return IrOp.i32_add; }
      if (operator == "-") { return IrOp.i32_sub; }
      if (operator == "*") { return IrOp.i32_mul; }
      // No "/" here: Zena division always yields a float (the checker
      // promotes i32/i32 to f32), which lowering does not model yet.
      if (operator == "%") { return if (unsigned) IrOp.i32_rem_u else IrOp.i32_rem_s; }
      if (operator == "&") { return IrOp.i32_and; }
      if (operator == "|") { return IrOp.i32_or; }
      if (operator == "^") { return IrOp.i32_xor; }
      if (operator == "<<") { return IrOp.i32_shl; }
      if (operator == ">>") { return if (unsigned) IrOp.i32_shr_u else IrOp.i32_shr_s; }
      if (operator == ">>>") { return IrOp.i32_shr_u; }
      if (operator == "==") { return IrOp.i32_eq; }
      if (operator == "!=") { return IrOp.i32_ne; }
      if (operator == "<") { return if (unsigned) IrOp.i32_lt_u else IrOp.i32_lt_s; }
      if (operator == "<=") { return if (unsigned) IrOp.i32_le_u else IrOp.i32_le_s; }
      if (operator == ">") { return if (unsigned) IrOp.i32_gt_u else IrOp.i32_gt_s; }
      if (operator == ">=") { return if (unsigned) IrOp.i32_ge_u else IrOp.i32_ge_s; }
    } else if (vt is ValTypeI64) {
      if (operator == "+") { return IrOp.i64_add; }
      if (operator == "-") { return IrOp.i64_sub; }
      if (operator == "*") { return IrOp.i64_mul; }
      if (operator == "%") { return if (unsigned) IrOp.i64_rem_u else IrOp.i64_rem_s; }
      if (operator == "&") { return IrOp.i64_and; }
      if (operator == "|") { return IrOp.i64_or; }
      if (operator == "^") { return IrOp.i64_xor; }
      if (operator == "<<") { return IrOp.i64_shl; }
      if (operator == ">>") { return if (unsigned) IrOp.i64_shr_u else IrOp.i64_shr_s; }
      if (operator == ">>>") { return IrOp.i64_shr_u; }
      if (operator == "==") { return IrOp.i64_eq; }
      if (operator == "!=") { return IrOp.i64_ne; }
      if (operator == "<") { return if (unsigned) IrOp.i64_lt_u else IrOp.i64_lt_s; }
      if (operator == "<=") { return if (unsigned) IrOp.i64_le_u else IrOp.i64_le_s; }
      if (operator == ">") { return if (unsigned) IrOp.i64_gt_u else IrOp.i64_gt_s; }
      if (operator == ">=") { return if (unsigned) IrOp.i64_ge_u else IrOp.i64_ge_s; }
    } else if (vt is ValTypeF64) {
      if (operator == "+") { return IrOp.f64_add; }
      if (operator == "-") { return IrOp.f64_sub; }
      if (operator == "*") { return IrOp.f64_mul; }
      if (operator == "/") { return IrOp.f64_div; }
      if (operator == "==") { return IrOp.f64_eq; }
      if (operator == "!=") { return IrOp.f64_ne; }
      if (operator == "<") { return IrOp.f64_lt; }
      if (operator == "<=") { return IrOp.f64_le; }
      if (operator == ">") { return IrOp.f64_gt; }
      if (operator == ">=") { return IrOp.f64_ge; }
    } else if (vt is ValTypeF32) {
      if (operator == "+") { return IrOp.f32_add; }
      if (operator == "-") { return IrOp.f32_sub; }
      if (operator == "*") { return IrOp.f32_mul; }
      if (operator == "/") { return IrOp.f32_div; }
      if (operator == "==") { return IrOp.f32_eq; }
      if (operator == "!=") { return IrOp.f32_ne; }
      if (operator == "<") { return IrOp.f32_lt; }
      if (operator == "<=") { return IrOp.f32_le; }
      if (operator == ">") { return IrOp.f32_gt; }
      if (operator == ">=") { return IrOp.f32_ge; }
    }
    return this.#bailValue('operator ' + operator) as IrOp;
  }

  /** The wasm type of an already-lowered value. */
  #valueType(value: i32): ValType {
    return this.b.body.typeTable[this.b.body.typeId[value]];
  }

  /**
   * Re-asserts non-nullness when the checked type is non-null but the
   * value's storage type is nullable with the same heap target. Other
   * shape differences pass through unchanged — downstream subtype
   * checks bail on actual misuse.
   */
  #reassertNonNull(value: i32, want: ValType): i32 {
    let have = this.#valueType(value);
    if (want is ValTypeRef && have is ValTypeRefNull &&
        (want as ValTypeRef).target == (have as ValTypeRefNull).target) {
      return this.b.emit(IrOp.ref_as_non_null, want, value, -1);
    }
    return value;
  }

  #exprValType(expr: Expression): ValType {
    let t = this.func.model.getNodeType(expr);
    if (t == null) {
      this.#bail('untyped expression');
    }
    let vt = typeToValTypeWithSub(this.wasm, t as Type, this.func);
    this.#requireSupported(vt, 'expression type');
    return vt;
  }

  /**
   * Requires the checked type of `expr` to be a signed scalar the subset
   * handles. Unsigned types share wasm representations but need _u
   * operator variants; they bail until lowering learns them.
   */
  #requireScalarNode(expr: Expression): void {
    let t = this.func.model.getNodeType(expr);
    if (t == null) {
      this.#bail('untyped operand');
    }
    let bt = baseType(t as Type);
    let ok = bt is I32Type || bt is I64Type || bt is U32Type ||
        bt is U64Type || bt is F32Type || bt is F64Type ||
        bt is BooleanType;
    if (!ok) {
      this.#bail('operand type');
    }
  }

  #requireScalar(vt: ValType, what: String): void {
    let ok = vt is ValTypeI32 || vt is ValTypeI64 || vt is ValTypeF32 ||
        vt is ValTypeF64;
    if (!ok) {
      this.#bail(what);
    }
  }

  /**
   * Types values may HAVE in the lowered subset: scalars plus reference
   * types (concrete, anyref, eqref). Reference values only flow — the
   * operations on them are limited to null tests, identity, calls, and
   * assignment; anything else still bails at its own site.
   */
  #requireSupported(vt: ValType, what: String): void {
    let ok = vt is ValTypeI32 || vt is ValTypeI64 || vt is ValTypeF32 ||
        vt is ValTypeF64 || vt is ValTypeRef || vt is ValTypeRefNull ||
        vt is ValTypeAnyRef || vt is ValTypeEqRef || vt is ValTypeStructRef;
    if (!ok) {
      this.#bail(what);
    }
  }

  /**
   * Lowers an expression with a contextual wasm type: null literals take
   * the context's (nullable) type, and non-null results coerce is not
   * needed — wasm subtyping covers widening at use sites.
   */
  #lowerExpressionCtx(expr: Expression, contextVt: ValType | null): i32 {
    if (expr is NullLiteral) {
      if (contextVt == null) {
        this.#bail('null without context');
      }
      let vt = contextVt as ValType;
      let nullable = vt is ValTypeRefNull || vt is ValTypeAnyRef ||
          vt is ValTypeEqRef;
      if (!nullable) {
        this.#bail('null into non-nullable context');
      }
      return this.b.emit(IrOp.ref_null, vt, -1, -1);
    }
    return this.#lowerExpression(expr);
  }

  /** Symbols assigned anywhere inside `node` that are locals in scope. */
  #assignedEnvSyms(node: Node): Array<SymbolId> {
    let result = new Array<SymbolId>();
    this.#appendAssignedEnvSyms(node, result);
    return result;
  }

  #appendAssignedEnvSyms(node: Node, out: Array<SymbolId>): void {
    let seen = new HashSet<SymbolId>();
    for (let existing in out) {
      seen.add(existing);
    }
    walkEnter(node, (n: Node): void => {
      if (n is AssignmentExpression) {
        let ae = n as AssignmentExpression;
        if (ae.left is Identifier) {
          let sym = this.func.model.resolve(ae.left);
          if (sym != null) {
            let resolved = (sym as Symbol).resolveTarget();
            // Celled bindings mutate their heap cell, not the env
            // entry, so they never need merge parameters.
            if (this.env.has(resolved.id) && !seen.has(resolved.id) &&
                !this.#isCelled(resolved.id)) {
              seen.add(resolved.id);
              out.push(resolved.id);
              this.symbols[resolved.id] = resolved;
            }
          }
        }
      }
    });
  }

  /** Adds one block param per symbol, typed by the symbol's binding. */
  #addParams(block: i32, syms: Array<SymbolId>): Array<i32> {
    let params = new Array<i32>();
    for (let symId in syms) {
      // The binding's declared type is the stable merge type: incoming
      // values may be wasm subtypes (non-null refs, subclass structs,
      // typed nulls), which the verifier's subtype check admits.
      params.push(this.b.blockParam(block, this.#bindingValType(symId)));
    }
    return params;
  }

  #bindingValType(symId: SymbolId): ValType {
    if (!this.symbols.has(symId)) {
      this.#bail('unknown merge symbol');
    }
    let t = this.func.model.getBindingType(this.symbols[symId]);
    if (t == null) {
      this.#bail('untyped merge binding');
    }
    let vt = typeToValTypeWithSub(this.wasm, t as Type, this.func);
    this.#requireSupported(vt, 'merge binding type');
    return vt;
  }

  #applyParams(syms: Array<SymbolId>, params: Array<i32>): void {
    for (var i = 0; i < syms.length; i += 1) {
      this.env[syms[i]] = params[i];
    }
  }

  #envValues(syms: Array<SymbolId>): Array<i32> {
    let values = new Array<i32>();
    for (let symId in syms) {
      values.push(this.env[symId]);
    }
    return values;
  }

  #copyEnv(): HashMap<SymbolId, i32> {
    return this.#copyOf(this.env);
  }

  #copyOf(source: HashMap<SymbolId, i32>): HashMap<SymbolId, i32> {
    let copy = new HashMap<SymbolId, i32>();
    for (let pair in source) {
      copy[pair.key] = pair.value;
    }
    return copy;
  }

  #noArgs(): Array<i32> {
    return new Array<i32>();
  }

  #oneArg(value: i32): Array<i32> {
    let result = new Array<i32>();
    result.push(value);
    return result;
  }

  #bail(reason: String): never {
    throw new ZirUnsupported(reason);
  }

  #bailValue(reason: String): i32 {
    throw new ZirUnsupported(reason);
  }
}
