import { findDeclaration, collectValueExports, isArrayIntrinsic } from '../lookup.zena';
/**
 * AST → ZIR lowering (docs/design/ir.md §6).
 *
 * This is the compiler's only backend: every function body compiles
 * AST -> ZIR -> wasm. A ZirUnsupported bail is a compiler bug and
 * fails the compile (see lowerFunction), never a silent fallback.
 *
 * SSA construction is the structured-AST form: an environment maps each
 * variable symbol to its current value; control-flow joins introduce
 * block parameters for the variables assigned in the joined regions
 * (computed by a pre-scan), and loop headers carry parameters for every
 * variable assigned anywhere in the loop.
 */
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { HashSet } from 'zena:set';
import { Error } from 'zena:error';
import { parseF64, parseI32, i32ToString } from 'zena:string-convert';
import {
  Node, Statement, Expression, FunctionExpression, BlockStatement,
  ReturnStatement, BreakStatement, ContinueStatement, IfStatement,
  WhileStatement, ExpressionStatement, VariableDeclaration,
  BinaryExpression, UnaryExpression, AssignmentExpression, Identifier,
  NumberLiteral, BooleanLiteral, IdentifierPattern, BindingPattern, Pattern,
  CallExpression, IfExpression, AsExpression, ForStatement, ForInStatement,
  IndexExpression, TemplateLiteral,
  NullLiteral, StringLiteral, NewExpression, MemberExpression,
  MethodDefinition, ThisExpression, Parameter, ClassDeclaration,
  FieldDefinition, FieldInitializer, SuperInitializer, TypeAnnotation,
  AccessorDeclaration, SetterInfo,
  MatchExpression, AsPattern, ClassPattern, LogicalPattern, LiteralPattern,
  TupleLiteral, EnumDeclaration, DeclareFunction, getMemberPropertyName,
  IsExpression, RangeExpression, PipelineExpression, PipePlaceholder, SuperExpression,
  ArrayLiteral, RecordLiteral, MapLiteral, ThrowExpression, TryExpression, CatchClause, TaggedTemplateExpression, ImportDeclaration, ImportSpecifier, Module, SpreadElement,
  LetPatternCondition, TuplePattern, PropertyAssignment, SealedVariant,
  RecordPattern, BindingProperty
} from '../../ast.zena';
import { Type, I32Type, I64Type, U32Type, U64Type, F32Type, F64Type, BooleanType, VoidType, ClassType, InterfaceType, ThisType, FunctionType, FieldInfo, MethodInfo, ArrayType, InlineTupleType, TupleType, RecordType, TypeParameterType, UnionType, NullType, instantiateClassType, baseType, isVoidOrNeverType, isRefType, AnyRefType, EqRefType, typeToString } from '../../types.zena';
import { InterfaceAdaptation, RecordAdaptation, FunctionAdaptation } from '../../semantic-model.zena';
import { SymbolId, Symbol } from '../../scope/symbol.zena';
import { Program, CompilationUnit } from '../../program.zena';
import { walkEnter } from '../../visitor.zena';

import { dirName, normalizePath } from '../../module-resolver.zena';



import { ValType, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeRef, ValTypeRefNull, ValTypeAnyRef, ValTypeEqRef, ValTypeStructRef, ValTypeExternRef, ValTypeI8, valTypeEquals, isWasmSubtype, isRefValType, WasmType, refTargetOf } from '../wasm.zena';
import { WasmModule, WasmFunction, WasmStruct, WasmField, WasmGlobal, WasmSignature, WasmArray, WasmTag, ClassCodegenInfo, isValSubtype, sortWasmFields, RecordDispatchInfo, asWasmStruct, asWasmSignature, asWasmArray, valTypeIdentical } from '../wasm-module.zena';
import { typeToValTypeWithSub, typeToValType, eraseTypeParameters, substituteTypeParamsInClassContext, substituteTypeParamsInFunctionContext, getClosureStruct, getClosureKey, getCellStruct, findImplementedInterfaceTransitive, getNonNullableType } from '../type-mapping.zena';

import { IrBody, IrOp, IrRefFunc, IrRefGlobal, IrRefType, IrRefField, IrRefTag } from './ir.zena';
import { getClassKey, getClassMethodKey, getClassPrivateFieldKey, getMemberRootClass, getInterfaceKey, getClassInterfaceKey, getClosureSpecializationKey, getSignatureKey, ClassKey, getTypeKeyForSpecialization, getTypeUniqueKey, collectMixinFields, MixinKey, getSpecializedFunctionKey, getSpecializedName, getFunctionValueWrapperKey, parseI32WithHex, parseI64OrU64Literal } from '../codegen-utils.zena';
import { IrBuilder } from './builder.zena';
import { synthesizeScaffold } from './scaffold.zena';
import { lowerIntrinsic } from './intrinsics.zena';
import { LetCondBinds, LoopCtx, LoweringContext, MergeState, ZirUnsupported } from './lowering-context.zena';
import { lowerStringLiteral, lowerTaggedTemplate, lowerTemplateLiteral } from './templates.zena';
import {
  lowerCaseClassEq, lowerCaseClassHash, lowerErasedEq, lowerEqIntrinsic,
  lowerHashIntrinsic,
} from './equality.zena';
import {
  branchUnless, collectPatternBindSyms, lowerPatternBindings,
  lowerPatternTest, patternBinds, patternRefutable,
} from './patterns.zena';
import {
  isUnsignedNode, lowerAs, lowerBinary, lowerUnary, mapBinaryOp,
} from './operators.zena';
import {
  lowerFor, lowerForIn, lowerIf, lowerIfExpression,
  lowerLetCondition, lowerMatch, lowerTryExpression, lowerValueNode,
  lowerWhile,
} from './control-flow.zena';

// ZirUnsupported now lives in lowering-context.zena (imported above):
// split modules throw it too, and importing it from lowering would
// cycle.

/** Bail-reason tag for expression kinds without a dispatch arm. */


let kindTagOf = (e: Expression): String => {
  return match (e) {
    case IsExpression: ' is'
    case RangeExpression: ' range'
    case PipelineExpression: ' pipeline'
    case SuperExpression: ' super'
    case ArrayLiteral: ' arraylit'
    case RecordLiteral: ' recordlit'
    case MapLiteral: ' maplit'
    case TupleLiteral: ' tuplelit'
    case ThrowExpression: ' throw'
    case TryExpression: ' try'
    case _: ' other'
  };
};


/**
 * A HOST-import wrapper's body. "Import" here is a wasm-level host
 * import (a `declare` function provided by the embedder, like
 * __captureStackTrace), not a module import — module imports resolve
 * to their declarations and are plain calls. The host ABI cannot
 * traffic in wasm-GC references, so the raw import returns externref;
 * Zena-side callers hold the declared reference type. The wrapper is
 * that ABI shim: forward the params, call the raw import, convert the
 * externref result into the GC hierarchy (any.convert_extern), and
 * cast to the declared type. It exists as a real function (not
 * inlined at call sites) so the declared function keeps one uniform
 * callable identity — vtable slots and function values reference it.
 */
let lowerImportWrapper = (func: WasmFunction): IrBody => {
  let target = func.importWrapperTarget as WasmFunction;
  let b = new IrBuilder();
  let entry = b.newBlock();
  let args = new Array<i32>();
  for (let vt in func.signature.params) {
    args.push(b.blockParam(entry, vt));
  }
  b.switchTo(entry);
  if (func.signature.returns.length == 0) {
    b.callFunc(b.addRef(new IrRefFunc(target)), args, null);
    b.retVoid();
    return b.finish();
  }
  if (func.signature.returns.length != 1 ||
      target.signature.returns.length != 1) {
    throw new ZirUnsupported('import wrapper shape');
  }
  let raw = b.callFunc(b.addRef(new IrRefFunc(target)), args,
      target.signature.returns[0]);
  let wantVt = func.signature.returns[0];
  var result = raw;
  if (target.signature.returns[0] is ValTypeExternRef) {
    result = b.emit(IrOp.any_convert_extern,
        new ValTypeAnyRef() as ValType, raw, -1);
    if (!(wantVt is ValTypeAnyRef)) {
      result = b.emit(IrOp.ref_cast, wantVt, result, b.internType(wantVt));
    }
  } else if (!isValSubtype(b.body.resultType(raw) as ValType, wantVt)) {
    result = b.emit(IrOp.ref_cast, wantVt, result, b.internType(wantVt));
  }
  b.ret(result);
  return b.finish();
};

/**
 * A function-adaptation wrapper's body: its context (param 0) is the
 * WHOLE source closure pair. Unpack it, forward the source arity's
 * worth of parameters (casting where the target declared a wider
 * type), and call_ref through the source pair's func field —
 * streaming's generateFunctionAdaptationBody.
 */
let lowerFunctionAdaptation = (wasm: WasmModule, func: WasmFunction): IrBody => {
  let actualFt = func.functionAdaptationSource as FunctionType;
  let actualStruct = func.functionAdaptationResolvedSourceStruct ??
      getClosureStruct(wasm, actualFt);
  // ZIR synthesis runs AFTER layout: a getClosureStruct MISS here
  // mints a fresh struct that can never receive a type index (its
  // casts emit heap type -1 — invalid wasm). The miss happens when
  // the adaptation's source FunctionType keys differently from the
  // pre-layout interning (nullability normalization). Streaming
  // resolves the pair through its own adaptation records, so bail.
  var inTypes = false;
  for (let t in wasm.types) {
    if (t == (actualStruct as WasmType)) {
      inTypes = true;
    }
  }
  if (!inTypes) {
    throw new ZirUnsupported('adaptation source struct not laid out');
  }
  let actualSig = asWasmSignature(actualStruct.fields[0].type);
  if (actualSig == null) {
    throw new ZirUnsupported('adaptation source shape');
  }
  let srcSig = actualSig as WasmSignature;
  let b = new IrBuilder();
  let entry = b.newBlock();
  let params = new Array<i32>();
  for (let vt in func.signature.params) {
    params.push(b.blockParam(entry, vt));
  }
  b.switchTo(entry);
  let pairVt = new ValTypeRef(actualStruct) as ValType;
  let pair = b.emit(IrOp.ref_cast, pairVt, params[0], b.internType(pairVt));
  let ctxVal = b.emit(IrOp.struct_get, actualStruct.fields[1].type, pair,
      b.addRef(new IrRefField(actualStruct, 'ctx')));
  let args = new Array<i32>();
  args.push(ctxVal);
  // The wrapper's own params cover the target arity; the source
  // consumes a prefix of them.
  if (srcSig.params.length > func.signature.params.length) {
    throw new ZirUnsupported('adaptation arity shape');
  }
  for (var i = 1; i < srcSig.params.length; i += 1) {
    var v = params[i];
    let want = srcSig.params[i];
    if (!isValSubtype(b.body.resultType(v) as ValType, want)) {
      if (!(want is ValTypeRef || want is ValTypeRefNull)) {
        throw new ZirUnsupported('adaptation param shape');
      }
      v = b.emit(IrOp.ref_cast, want, v, b.internType(want));
    }
    args.push(v);
  }
  let funcVal = b.emit(IrOp.struct_get, actualStruct.fields[0].type, pair,
      b.addRef(new IrRefField(actualStruct, 'func')));
  if (srcSig.returns.length == 0) {
    b.callRef(funcVal, args, null);
    b.retVoid();
    return b.finish();
  }
  if (srcSig.returns.length != 1 || func.signature.returns.length != 1) {
    throw new ZirUnsupported('adaptation result shape');
  }
  let result = b.callRef(funcVal, args, srcSig.returns[0]);
  b.ret(result);
  return b.finish();
};

/**
 * Synthesized or adapted machinery lowering does not model: wrappers,
 * trampolines, accessor thunks, case-class equality/hash synthesis,
 * generics, and intrinsics. The direct-call gate in #lowerCall shares
 * several of these tests but intentionally differs — imports and class
 * methods are callable, just not lowerable.
 */
let usesSynthesizedMachinery = (func: WasmFunction): boolean => {
  return func.importWrapperTarget != null ||
      func.interfaceTrampolineTarget != null || func.isFunctionAdaptation ||
      func.isClosureWrapper || func.isClosureTrampoline ||
      func.getterStruct != null || func.setterStruct != null ||
      func.isCaseClassEq || func.isCaseClassHash ||
      func.typeParameters != null || func.typeArguments != null ||
      func.intrinsic != null;
};

/** Injected-default bookkeeping for one call site (see
 * #defaultArgInfo): where the defaults start, the callee's parameter
 * symbols, the declaring class of this-referencing defaults, and the
 * argument values lowered so far. */
final class DefaultArgInfo {
  originalCount: i32;
  paramSymbols: Array<SymbolId> | null;
  owner: ClassType | null;
  values = new Array<i32>();
  new(this.originalCount, this.paramSymbols, this.owner);
}

final class MemberTarget {
  owner: WasmStruct;
  /** Set for physical-field reads. */
  fieldName: String | null;
  /** Set for getter calls (direct, or the slot signature when virtual). */
  getter: WasmFunction | null;
  /** Set when the getter dispatches through the class vtable. */
  var vtSlot: String | null = null;
  /** The receiver class's codegen info, when vtSlot is set. */
  var vtInfo: ClassCodegenInfo | null = null;
  new(this.owner, this.fieldName, this.getter);
}

/**
 * Lowers `func` to ZIR. A ZirUnsupported bail is a compiler bug —
 * re-thrown with the function named so the failure points straight
 * at the construct that failed to lower; any other exception
 * propagates untouched.
 */
export let lowerFunction = (wasm: WasmModule, func: WasmFunction): IrBody => {
  // (The catch arm yields null rather than rethrowing directly — a
  // catch whose every arm throws miscompiles under the bootstrap.)
  var failMsg: String | null = null;
  let result: IrBody | null = try {
    lowerFunctionOrThrow(wasm, func)
  } catch (e) {
    if (e is ZirUnsupported) {
      // message carries the class's own 'zir unsupported: ' prefix;
      // strip it so re-wrapping does not double it.
      let m = (e as ZirUnsupported).message;
      failMsg = m.sliceBytes(17, m.length) + ' [in ' +
          (if (func.name != null) func.name as String else '<unnamed>') + ']';
      null
    } else {
      throw e
    }
  };
  if (failMsg != null) {
    throw new ZirUnsupported(failMsg as String);
  }
  return result as IrBody;
};

/** Entry block with one param per signature slot; leaves it current. */
let synthEntryParams = (b: IrBuilder, func: WasmFunction): Array<i32> => {
  let entry = b.newBlock();
  let params = new Array<i32>();
  for (let vt in func.signature.params) {
    params.push(b.blockParam(entry, vt));
  }
  b.switchTo(entry);
  return params;
};

/**
 * Casts a value to a concrete-ref parameter type. Mirrors streaming's
 * trampoline casts, which are NON-null (emitRefCast) even when the
 * target slot is declared nullable. Non-concrete targets pass through.
 */
let castToConcreteRef = (b: IrBuilder, value: i32, targetVt: ValType): i32 => {
  let target = refTargetOf(targetVt);
  if (target == null) {
    return value;
  }
  let vt = new ValTypeRef(target as WasmType) as ValType;
  return b.emit(IrOp.ref_cast, vt, value, b.internType(vt));
};

/**
 * Interface trampoline: cast the erased receiver to the target's
 * concrete type, cast any erased params likewise, and tail into the
 * target (docs: FunctionGenerator's interfaceTrampolineTarget arm).
 */
let synthesizeInterfaceTrampoline = (func: WasmFunction): IrBody => {
  let target = func.interfaceTrampolineTarget as WasmFunction;
  let b = new IrBuilder();
  let params = synthEntryParams(b, func);
  if (target.intrinsic != null) {
    if ((target.intrinsic as String) == 'array.len') {
      let recv = castToConcreteRef(b, params[0], target.signature.params[0]);
      let len = b.emit(IrOp.array_len, new ValTypeI32(), recv, -1);
      b.ret(len);
      return b.finish();
    }
    b.unreachable();
    return b.finish();
  }
  if (target.index == -1) {
    // Target never reached; streaming emits the same trap.
    b.unreachable();
    return b.finish();
  }
  if (func.signature.params.length != target.signature.params.length) {
    throw new ZirUnsupported('trampoline shape');
  }
  let args = new Array<i32>();
  args.push(castToConcreteRef(b, params[0], target.signature.params[0]));
  for (var i = 1; i < params.length; i += 1) {
    var v = params[i];
    if (!isWasmSubtype(func.signature.params[i], target.signature.params[i])) {
      v = castToConcreteRef(b, v, target.signature.params[i]);
    }
    args.push(v);
  }
  let funcRef = b.addRef(new IrRefFunc(target));
  if (target.signature.returns.length > 1) {
    // Multi-result target (e.g. Iterator.next): project and re-return.
    if (func.signature.returns.length != target.signature.returns.length) {
      throw new ZirUnsupported('trampoline result shape');
    }
    let projs = b.callFuncMulti(funcRef, args, target.signature.returns);
    b.retMulti(projs);
    return b.finish();
  }
  let resultType = if (target.signature.returns.length == 1) target.signature.returns[0] else null;
  var result = b.callFunc(funcRef, args, resultType);
  if (func.signature.returns.length == 1) {
    if (resultType == null) {
      throw new ZirUnsupported('trampoline result shape');
    }
    let expectedRet = func.signature.returns[0];
    if (!isWasmSubtype(resultType as ValType, expectedRet)) {
      result = castToConcreteRef(b, result, expectedRet);
    }
    b.ret(result);
  } else {
    b.retVoid();
  }
  return b.finish();
};

/**
 * Synthesized default accessors: cast the erased receiver to the
 * declaring struct and read (getter) or write (setter) the field,
 * with the getter's vtable-signature compat casts mirrored from
 * streaming. A field index of -1 means the accessor is a vtable slot
 * for a member no reachable class stores physically — it traps.
 */
let synthesizeAccessor = (func: WasmFunction, isGetter: boolean): IrBody => {
  let st = if (isGetter) func.getterStruct as WasmStruct
      else func.setterStruct as WasmStruct;
  let idx = if (isGetter) func.getterFieldIndex else func.setterFieldIndex;
  let b = new IrBuilder();
  let params = synthEntryParams(b, func);
  if (idx == -1) {
    b.unreachable();
    return b.finish();
  }
  let fieldName = st.fields[idx].name;
  if (fieldName == null) {
    throw new ZirUnsupported('unnamed accessor field');
  }
  let castVt: ValType = new ValTypeRef(st);
  let casted = b.emit(IrOp.ref_cast, castVt, params[0], b.internType(castVt));
  let fieldRef = b.addRef(new IrRefField(st, fieldName));
  if (!isGetter) {
    let pairIdx = b.pushExtra(twoValuesOf(casted, params[1]));
    b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
    b.retVoid();
    return b.finish();
  }
  let actual = st.fields[idx].type;
  var read = b.emit(IrOp.struct_get, actual, casted, fieldRef);
  if (func.signature.returns.length == 0) {
    b.retVoid();
    return b.finish();
  }
  // The getter's declared return is the vtable slot's erased type; cast
  // when the field's storage type differs (mirrors streaming).
  let expected = func.signature.returns[0];
  if (refTargetOf(expected) != null) {
    if (!valTypeIdentical(actual, expected)) {
      read = b.emit(IrOp.ref_cast, expected, read, b.internType(expected));
    }
  } else if (expected is ValTypeEqRef && !(actual is ValTypeEqRef)) {
    let vt: ValType = new ValTypeEqRef();
    read = b.emit(IrOp.ref_cast, vt, read, b.internType(vt));
  }
  b.ret(read);
  return b.finish();
};

/** Closure wrapper: forward params[1..] (dropping the ctx) to the target. */
/**
 * A closure trampoline: the value-position form of a plain function —
 * drops the (unused) context param and forwards the rest to the
 * target, streaming's generateClosureTrampolineBody.
 */
let synthesizeClosureTrampoline = (func: WasmFunction): IrBody => {
  if (func.closureTrampolineTarget == null) {
    throw new ZirUnsupported('closure trampoline without target');
  }
  let target = func.closureTrampolineTarget as WasmFunction;
  if (func.signature.params.length != target.signature.params.length + 1) {
    throw new ZirUnsupported('closure trampoline shape');
  }
  let b = new IrBuilder();
  let params = synthEntryParams(b, func);
  let args = new Array<i32>();
  for (var i = 1; i < params.length; i += 1) {
    args.push(params[i]);
  }
  let funcRef = b.addRef(new IrRefFunc(target));
  if (target.signature.returns.length > 1) {
    throw new ZirUnsupported('closure trampoline result shape');
  }
  let resultType = if (target.signature.returns.length == 1) target.signature.returns[0] else null;
  let result = b.callFunc(funcRef, args, resultType);
  if (func.signature.returns.length == 1) {
    if (resultType == null) {
      throw new ZirUnsupported('closure trampoline result shape');
    }
    b.ret(result);
    return b.finish();
  }
  b.retVoid();
  return b.finish();
};

let synthesizeClosureWrapper = (func: WasmFunction): IrBody => {
  if (func.closureWrapperTarget == null) {
    throw new ZirUnsupported('closure wrapper without target');
  }
  let target = func.closureWrapperTarget as WasmFunction;
  if (func.signature.params.length != target.signature.params.length + 1) {
    throw new ZirUnsupported('closure wrapper shape');
  }
  let b = new IrBuilder();
  let params = synthEntryParams(b, func);
  let args = new Array<i32>();
  for (var i = 1; i < params.length; i += 1) {
    args.push(params[i]);
  }
  let funcRef = b.addRef(new IrRefFunc(target));
  if (target.signature.returns.length > 1) {
    if (func.signature.returns.length != target.signature.returns.length) {
      throw new ZirUnsupported('closure wrapper result shape');
    }
    let projs = b.callFuncMulti(funcRef, args, target.signature.returns);
    b.retMulti(projs);
    return b.finish();
  }
  let resultType = if (target.signature.returns.length == 1) target.signature.returns[0] else null;
  let result = b.callFunc(funcRef, args, resultType);
  if (func.signature.returns.length == 1) {
    if (resultType == null) {
      throw new ZirUnsupported('closure wrapper result shape');
    }
    b.ret(result);
  } else {
    b.retVoid();
  }
  return b.finish();
};

/** The one intrinsic with a body streaming synthesizes: array.len. */
let synthesizeIntrinsic = (func: WasmFunction): IrBody => {
  if ((func.intrinsic as String) == 'array.len' &&
      func.signature.params.length == 1 && func.signature.returns.length == 1) {
    let b = new IrBuilder();
    let params = synthEntryParams(b, func);
    let len = b.emit(IrOp.array_len, new ValTypeI32(), params[0], -1);
    b.ret(len);
    return b.finish();
  }
  // Every other standalone intrinsic body mirrors the streaming
  // backend: call sites always inline the op, so the standalone
  // function exists only for slot uniformity and traps if reached.
  let b = new IrBuilder();
  synthEntryParams(b, func);
  b.unreachable();
  return b.finish();
};

let twoValuesOf = (a: i32, bVal: i32): Array<i32> => {
  let result = new Array<i32>();
  result.push(a);
  result.push(bVal);
  return result;
};

let lowerFunctionOrThrow = (wasm: WasmModule, func: WasmFunction): IrBody => {
  // Metadata-only functions first: no AST, but their bodies are tiny
  // fixed shapes ZIR synthesizes directly (they are half of all
  // fallbacks on the compiler itself). The node==null gate matters:
  // DECLARED accessors also carry getterStruct/setterStruct, but they
  // have real bodies (and often no physical field), so they take the
  // normal lowering path below.
  // Host-import wrappers keep their declare node but never have a
  // lowered body: the embedder-provided import trafficks in externref,
  // and the wrapper is the ABI shim to the declared GC types —
  // streaming's shape.
  if (func.importWrapperTarget != null) {
    return lowerImportWrapper(func);
  }
  // Case-class synthesizers win over any carried node: a leaf variant
  // whose sealed base writes hashCode()/== keeps the base's METHOD
  // NODE attached while the flag says "synthesize structurally" —
  // streaming dispatches on the flag first, so mirror that.
  if (func.isCaseClassEq) {
    let lowerer = new FunctionLowerer(wasm, func);
    return lowerer.lowerCaseClassEq();
  }
  if (func.isCaseClassHash) {
    let lowerer = new FunctionLowerer(wasm, func);
    return lowerer.lowerCaseClassHash();
  }
  if (func.node == null) {
    if (func.interfaceTrampolineTarget != null) {
      return synthesizeInterfaceTrampoline(func);
    }
    if (func.getterStruct != null) {
      return synthesizeAccessor(func, true);
    }
    if (func.setterStruct != null) {
      return synthesizeAccessor(func, false);
    }
    if (func.isClosureWrapper) {
      return synthesizeClosureWrapper(func);
    }
    if (func.isClosureTrampoline) {
      return synthesizeClosureTrampoline(func);
    }
    if (func.isFunctionAdaptation) {
      return lowerFunctionAdaptation(wasm, func);
    }
    if (func.name != null && (func.name as String) == '__start') {
      let lowerer = new FunctionLowerer(wasm, func);
      return lowerer.lowerStart();
    }
    // Named module-scaffold helpers ($stringCreate & co.): fixed
    // shapes synthesized instruction-for-instruction from streaming's
    // generators.
    let scaffold = synthesizeScaffold(wasm, func);
    if (scaffold != null) {
      return scaffold as IrBody;
    }
    if (func.intrinsic != null) {
      return synthesizeIntrinsic(func);
    }
    if (func.methodName != null &&
        (func.methodName as String) == '<constructor>') {
      let lowerer = new FunctionLowerer(wasm, func);
      return lowerer.lowerSynthesizedConstructor();
    }
    // Vtable slot stubs: the vtable struct declares one exactly-typed
    // funcref field per method of the hierarchy, so a method with no
    // proven call still needs a function of the right signature in its
    // slot. Streaming emits a bare `unreachable` for these; mirror it —
    // a dispatch landing here means liveness was wrong, so trap loudly.
    if (func.isVtableSlotStub) {
      let b = new IrBuilder();
      synthEntryParams(b, func);
      b.unreachable();
      return b.finish();
    }
    throw new ZirUnsupported("synthesized function");
  }
  // No adaptations, trampolines, synthesized accessors, imports, or
  // generics. Plain top-level functions, written-out method bodies,
  // constructors, and closure implementation bodies are eligible.
  // Declared intrinsic methods have no lowerable body: their
  // standalone functions mirror streaming (array.len real, all
  // others unreachable — call sites always inline the op).
  if (func.intrinsic != null) {
    return synthesizeIntrinsic(func);
  }
  // Written accessor bodies (grouped accessors) lower like methods;
  // getterStruct/setterStruct only routes to synthesis when there is
  // no AST node (field-backed synthesized accessors above).
  if (func.isImport || func.importWrapperTarget != null ||
      func.interfaceTrampolineTarget != null || func.isFunctionAdaptation ||
      func.isClosureWrapper || func.isClosureTrampoline) {
    // Wrapper flags on a node-carrying function: not a shape lowering
    // models (the hoisted routes above handle the synthesized ones).
    throw new ZirUnsupported("function shape");
  }
  // Monomorphized generic bodies (_spec_ copies) carry both the
  // template's type parameters and the solved arguments; every type
  // query routes through substituteTypeParamsInFunctionContext, so
  // they lower like plain functions. A generic with no solved
  // arguments is an ERASED vtable copy: its type parameters mean
  // anyref, so synthesize that solution and let the same substitution
  // machinery run — restored even on bail, since streaming
  // re-generates this function from the same object.
  if (func.typeParameters != null && func.typeArguments == null) {
    let erasedArgs = new Array<Type>();
    for (let tp in (func.typeParameters as Array<TypeParameterType>)) {
      erasedArgs.push(new AnyRefType());
    }
    func.typeArguments = erasedArgs;
    let erasedLowerer = new FunctionLowerer(wasm, func);
    let result = try {
      erasedLowerer.lower()
    } catch (e) {
      func.typeArguments = null;
      throw e
    };
    func.typeArguments = null;
    return result;
  }
  if (func.typeParameters == null && func.typeArguments != null) {
    throw new ZirUnsupported("function shape");
  }
  if (func.isClosure) {
    if (func.contextStruct == null) {
      throw new ZirUnsupported("closure without context struct");
    }
  } else if (func.captures.length > 0 || func.capturesThis ||
             func.contextStruct != null) {
    // Capture state on a non-closure is a shape lowering doesn't know.
    throw new ZirUnsupported("function shape");
  }
  if (func.node is MethodDefinition) {
    let md = func.node as MethodDefinition;
    var methName = "";
    if (md.name is Identifier) {
      methName = (md.name as Identifier).name;
    }
    let isCtor = methName == "<constructor>";
    // Declares/abstracts have no body; non-constructor methods with
    // initializer machinery would be malformed; decorated constructors
    // (synthetic case-class ctors) have argument-forwarding rules the
    // prologue lowering does not model.
    if (md.isDeclare || md.isAbstract ||
        (md.typeParameters != null && func.typeArguments == null) ||
        (!isCtor && (md.body == null || md.initializerList != null ||
                     md.superInitializer != null)) ||
        (isCtor && md.decorators.length > 0)) {
      throw new ZirUnsupported("method shape");
    }
  } else if (func.node is AccessorDeclaration || func.node is SetterInfo) {
    // Written grouped-accessor bodies: lowered like methods by
    // FunctionLowerer's accessor branches.
  } else if (!(func.node is FunctionExpression)) {
    throw new ZirUnsupported("synthesized function");
  } else if (!func.isClosure &&
             (func.classType != null || func.structType != null)) {
    // A non-closure FunctionExpression carrying class context
    // (extension methods) still bails; closures keep their enclosing
    // class context for `this` captures and type substitution.
    throw new ZirUnsupported("function shape");
  }
  let lowerer = new FunctionLowerer(wasm, func);
  return lowerer.lower();
};

export final class FunctionLowerer {
  wasm: WasmModule;
  func: WasmFunction;
  b = new IrBuilder();
  // Mutable lowering state lives on the shared LoweringContext (the
  // split modules operate on the same env/reachability the
  // coordinator does); see ir/lowering-context.zena.
  /** Backing store for #cx(); built on first use. */
  var #cxCache: LoweringContext | null = null;

  new(this.wasm, this.func);

  lower(): IrBody {
    let sig = this.func.signature;
    for (let rt in sig.returns) {
      this.#requireSupported(rt, 'return type');
    }

    var params: Array<Parameter> | null = null;
    var bodyNode: Node | null = null;
    var paramOffset = 0;
    var ctorDef: MethodDefinition | null = null;
    var extCtorDef: MethodDefinition | null = null;
    let node = this.func.node as Node;
    var setterParamIdent: Identifier | null = null;
    if (node is MethodDefinition) {
      let md = node as MethodDefinition;
      params = md.params;
      bodyNode = md.body;
      if (!md.isStatic) {
        paramOffset = 1;
      }
      var methName = "";
      if (md.name is Identifier) {
        methName = (md.name as Identifier).name;
      }
      if (methName == "<constructor>") {
        if (this.func.classType != null &&
            (this.func.classType as ClassType).isExtension) {
          // Extension constructors take NO receiver (their signature
          // is the declared params, returning the underlying value).
          extCtorDef = md;
          paramOffset = 0;
        } else {
          ctorDef = md;
        }
      }
    } else if (node is AccessorDeclaration) {
      // Written getter body: `this` plus no declared parameters.
      let acc = node as AccessorDeclaration;
      if (acc.getter == null) {
        this.#bail('accessor without getter body');
      }
      params = new Array<Parameter>();
      bodyNode = acc.getter as Node;
      paramOffset = 1;
    } else if (node is SetterInfo) {
      // Written setter body: `this` plus the single value parameter
      // (a bare Identifier, bound manually after the entry params).
      let si = node as SetterInfo;
      params = new Array<Parameter>();
      bodyNode = si.body;
      paramOffset = 1;
      setterParamIdent = si.param;
    } else {
      let fExpr = node as FunctionExpression;
      params = fExpr.params;
      bodyNode = fExpr.body;
      if (this.func.isClosure) {
        // Closure implementations take their context as param 0.
        paramOffset = 1;
      }
    }
    let paramList = params as Array<Parameter>;
    let setterExtra = if (setterParamIdent != null) 1 else 0;
    if (sig.params.length != paramList.length + paramOffset + setterExtra) {
      this.#bail('signature/param shape mismatch');
    }

    let entry = this.b.newBlock();
    var ctxParam = -1;
    if (paramOffset == 1) {
      this.#requireSupported(sig.params[0], 'receiver type');
      let p0 = this.b.blockParam(entry, sig.params[0]);
      if (this.func.isClosure) {
        ctxParam = p0;
      } else {
        this.#cx().thisValue = p0;
      }
    }
    var needsThisDowncast = false;
    if (paramOffset == 1 && ctorDef == null && !this.func.isClosure &&
        this.func.classType != null && this.func.methodName != null) {
      // Override methods receive the ROOT class's receiver type (vtable
      // signature compatibility) and must downcast to their own class.
      let ct = this.func.classType as ClassType;
      let rootClass = getMemberRootClass(ct, this.func.methodName as String);
      if (ct != rootClass) {
        needsThisDowncast = true;
      }
    }
    let patternParams = new Array<Node>();
    let patternValues = new Array<i32>();
    for (var i = 0; i < paramList.length; i += 1) {
      let p = paramList[i];
      // this-params bind like plain params — the parser already
      // synthesized the FieldInitializer entries that store them
      // (lowered by the constructor prologue). Default values are
      // CALLER-supplied (desugared into each call site's argument
      // list), so the callee binds the parameter normally; call sites
      // that actually omit arguments still bail at 'call arity
      // adaptation'.
      let vt = sig.params[i + paramOffset];
      this.#requireSupported(vt, 'parameter type');
      let value = this.b.blockParam(entry, vt);
      let sym = this.func.model.resolveDeclaration(p.name);
      if (sym != null) {
        this.#cx().env[(sym as Symbol).id] = value;
        this.#cx().symbols[(sym as Symbol).id] = sym as Symbol;
      }
      // Destructuring parameters bind their pattern from the same
      // value once the entry block is current (below).
      if (p.pattern != null) {
        patternParams.push(p.pattern as Node);
        patternValues.push(value);
      } else if (sym == null) {
        this.#bail('unresolved parameter');
      }
    }
    if (setterParamIdent != null) {
      let sym = this.func.model.resolveDeclaration(setterParamIdent as Node);
      if (sym == null) {
        this.#bail('unresolved setter parameter');
      }
      let vt = sig.params[paramOffset];
      this.#requireSupported(vt, 'parameter type');
      let value = this.b.blockParam(entry, vt);
      this.#cx().env[(sym as Symbol).id] = value;
      this.#cx().symbols[(sym as Symbol).id] = sym as Symbol;
    }
    this.b.switchTo(entry);
    // Destructuring parameters bind now that instructions can emit.
    for (var i = 0; i < patternParams.length; i += 1) {
      this.#lowerPatternBindings(patternParams[i], patternValues[i]);
    }
    // Celled parameters (captured and mutated through a closure) move
    // into their heap cells before any body code runs.
    for (var i = 0; i < paramList.length; i += 1) {
      let sym = this.func.model.resolveDeclaration(paramList[i].name);
      if (sym != null && this.#isCelled((sym as Symbol).id)) {
        let symId = (sym as Symbol).id;
        this.#cx().env[symId] = this.#cellAlloc(
            sig.params[i + paramOffset], this.#cx().env[symId]);
      }
    }
    if (needsThisDowncast) {
      let ct = this.func.classType as ClassType;
      var infoOpt: ClassCodegenInfo | null = null;
      if (let (true, info) = this.wasm.classInfos.get(getClassKey(ct))) {
        infoOpt = info;
      }
      if (infoOpt == null) {
        this.#bail('override class not discovered');
      }
      let ownStruct = (infoOpt as ClassCodegenInfo).structType;
      let castVt = new ValTypeRef(ownStruct) as ValType;
      this.#cx().thisValue = this.b.emit(IrOp.ref_cast, castVt, this.#cx().thisValue,
          this.b.internType(castVt));
    }
    if (this.func.isClosure) {
      this.#lowerClosurePrologue(ctxParam);
    }

    if (extCtorDef != null) {
      this.#lowerExtensionConstructor(extCtorDef as MethodDefinition, sig);
      return this.b.finish();
    }
    if (ctorDef != null) {
      this.#lowerConstructorPrologue(ctorDef as MethodDefinition);
      if (bodyNode != null) {
        this.#lowerStatement(bodyNode as Statement);
      }
      if (this.#cx().reachable) {
        this.b.retVoid();
      }
      return this.b.finish();
    }

    let body = bodyNode as Node;
    if (body is BlockStatement) {
      // Value-block function bodies: a trailing expression statement
      // that conforms to the return type IS the return value (the
      // checker accepts exactly that shape).
      let stmts = (body as BlockStatement).body;
      var tailExpr: Expression | null = null;
      if (sig.returns.length == 1 && stmts.length > 0 &&
          stmts[stmts.length - 1] is ExpressionStatement) {
        let te = (stmts[stmts.length - 1] as ExpressionStatement).expression;
        let tt = this.func.model.getNodeType(te);
        if (tt != null && !isVoidOrNeverType(tt as Type)) {
          tailExpr = te;
        }
      }
      let bodyCount = if (tailExpr != null) stmts.length - 1 else stmts.length;
      for (var si = 0; si < bodyCount; si += 1) {
        this.#lowerStatement(stmts[si]);
      }
      if (tailExpr != null && this.#cx().reachable) {
        let tailValue = this.#lowerExpressionCtx(
            tailExpr as Expression, sig.returns[0]);
        this.#emitCheckedRet(tailValue);
      } else if (this.#cx().reachable) {
        if (sig.returns.length == 0) {
          this.b.retVoid();
        } else {
          // The checker guarantees a returning path; a reachable block end
          // here means dead code we could not prove terminated.
          this.b.unreachable();
        }
      }
    } else {
      // Expression-bodied function.
      if (sig.returns.length == 0) {
        // Void body: evaluate for effects; any produced value is
        // simply never used (SSA has no stack to pop).
        this.#lowerExpression(body as Expression);
        if (this.#cx().reachable) {
          this.b.retVoid();
        }
        return this.b.finish();
      }
      if (sig.returns.length > 1) {
        this.#lowerMultiReturn(body as Expression);
      } else {
        let value = this.#lowerExpressionCtx(body as Expression, sig.returns[0]);
        this.#emitCheckedRet(value);
      }
    }
    return this.b.finish();
  }

  /**
   * Synthesized (node-less) constructors: the DEFAULT constructor of a
   * class with no written one, and the decorated case-class
   * constructor. Streaming's shapes differ from written constructors:
   * the default constructor calls super FIRST (forwarding its own
   * params) and then stores field defaults by RAW name; the case-class
   * constructor calls super with the receiver only, stores each case
   * parameter into its field, then stores field defaults with the
   * accessor rename applied. Both mirrored exactly.
   */
  /** Synthesized case-class operator== (see ir/equality.zena). */
  lowerCaseClassEq(): IrBody {
    return lowerCaseClassEq(this.#cx());
  }

  /** Synthesized case-class hashCode (see ir/equality.zena). */
  lowerCaseClassHash(): IrBody {
    return lowerCaseClassHash(this.#cx());
  }

  /**
   * Extension-class constructors have no receiver and RETURN the
   * underlying value: `new(len, v) : super(expr)` evaluates the
   * single super argument to the onType value, which becomes `this`
   * for any body statements and the function's result — streaming's
   * shape, with the this-local replaced by an SSA value. (A bare
   * `return;` in such a body would emit a void return against a
   * one-result signature; the verifier and wasm validation reject
   * that loudly. No stdlib extension constructor has a body today.)
   */
  #lowerExtensionConstructor(md: MethodDefinition, sig: WasmSignature): void {
    if (sig.returns.length != 1) {
      this.#bail('extension constructor shape');
    }
    if (md.initializerList != null) {
      this.#bail('extension constructor initializers');
    }
    if (md.superInitializer == null) {
      this.#bail('extension constructor without super');
    }
    let si = md.superInitializer as SuperInitializer;
    if (si.args.length != 1) {
      this.#bail('extension super arity');
    }
    this.#requireSupported(sig.returns[0], 'extension constructor type');
    var value = this.#lowerExpressionCtx(si.args[0], sig.returns[0]);
    value = this.#conformToSlot(value, sig.returns[0], 'extension constructor value type');
    this.#cx().thisValue = value;
    if (md.body != null) {
      this.#lowerStatement(md.body as Statement);
    }
    if (this.#cx().reachable) {
      this.b.ret(this.#cx().thisValue);
    }
  }

  /**
   * __start: the module initializer, mirroring streaming — the shared
   * string segment materializes first, then each unit's non-literal
   * global initializers in order (memory.zena's unit before all
   * others, then static class fields per unit), each lowered under
   * ITS OWN unit's model, after the namespace-import record globals
   * materialize. Any bail restores the swapped model
   * before propagating, since streaming re-generates this function
   * with the same WasmFunction object.
   */
  /**
   * A namespace import's record global: one closure pair per exported
   * function (its value trampoline when one exists), exported globals
   * by value, then the record's fat pointer with the shape's vtable —
   * streaming's __start shape, field for field.
   */
  #lowerNamespaceImportInit(g: WasmGlobal): void {
    let spec = g.namespaceImport as ImportSpecifier;
    let moduleModel = g.model;
    let parentNode = moduleModel.getParent(spec);
    if (parentNode == null || !(parentNode is ImportDeclaration)) {
      this.#bail('namespace import shape');
    }
    let importDecl = parentNode as ImportDeclaration;
    var canonicalPath = importDecl.moduleSpecifier.value;
    if (canonicalPath.startsWith('./') || canonicalPath.startsWith('../')) {
      let referrer = moduleModel.getParent(importDecl);
      if (referrer != null && referrer is Module) {
        canonicalPath = normalizePath(
            dirName((referrer as Module).path) + '/' + canonicalPath);
      }
    }
    let progOpt = this.wasm.program;
    if (progOpt == null) {
      this.#bail('namespace import shape');
    }
    let prog = progOpt as Program;
    if (!prog.unitsByPath.has(canonicalPath)) {
      this.#bail('namespace import module');
    }
    let targetUnit = prog.unitsByPath[canonicalPath];
    let exports = new HashMap<String, Symbol>();
    collectValueExports(prog, targetUnit, exports);

    let rtOpt = moduleModel.getNodeType(spec as Node);
    if (rtOpt == null || !(rtOpt is RecordType)) {
      this.#bail('namespace import shape');
    }
    let rt = rtOpt as RecordType;
    let fields = new Array<WasmField>();
    for (let pair in rt.properties) {
      fields.push(new WasmField(pair.key,
          typeToValType(this.wasm, pair.value), false));
    }
    sortWasmFields(fields);
    let dispatch = this.wasm.getRecordDispatch(moduleModel, fields);

    let args = new Array<i32>();
    for (let field in fields) {
      let fieldName = if (field.name != null) field.name as String else '';
      var value = -1;
      if (let (true, sym) = exports.get(fieldName)) {
        if (let (true, f) = this.wasm.functionMap.get(sym.id)) {
          let closureStruct = this.wasm.getClosureStruct(
              f.signature.params, f.signature.returns);
          let refTarget = if (f.closureTrampoline != null) {
            f.closureTrampoline as WasmFunction
          } else {
            f
          };
          let funcVal = this.b.emit(IrOp.ref_func,
              closureStruct.fields[0].type, -1,
              this.b.addRef(new IrRefFunc(refTarget)));
          let nullCtx = this.b.emit(IrOp.ref_null,
              new ValTypeStructRef() as ValType, -1, -1);
          value = this.b.emit(IrOp.struct_new,
              new ValTypeRef(closureStruct) as ValType,
              this.b.pushArgList(this.#twoValues(funcVal, nullCtx)),
              this.b.addRef(new IrRefType(closureStruct)));
        } else if (let (true, tg) = this.wasm.globalMap.get(sym.id)) {
          value = this.b.emit(IrOp.global_get, tg.type, -1,
              this.b.addRef(new IrRefGlobal(tg)));
        } else {
          value = this.b.emit(IrOp.ref_null, field.type, -1, -1);
        }
      } else {
        value = this.b.emit(IrOp.ref_null, field.type, -1, -1);
      }
      args.push(value);
    }
    let instance = this.b.emit(IrOp.struct_new,
        new ValTypeRef(dispatch.concreteType) as ValType,
        this.b.pushArgList(args),
        this.b.addRef(new IrRefType(dispatch.concreteType)));
    let packed = this.b.emit(IrOp.iface_pack,
        new ValTypeRef(dispatch.fatPtrType) as ValType, instance,
        this.b.addRef(new IrRefGlobal(dispatch.vtableGlobal)));
    this.b.emitVoid(IrOp.global_set, packed,
        this.b.addRef(new IrRefGlobal(g)));
  }

  lowerStart(): IrBody {
    let entry = this.b.newBlock();
    this.b.switchTo(entry);
    if (this.wasm.sharedStringsGlobal != null) {
      let byteArr = this.wasm.getByteArrayType();
      let zero = this.b.constI32(0, new ValTypeI32());
      let len = this.b.constI32(this.wasm.sharedStringsLength, new ValTypeI32());
      let bytes = this.b.arrayNewData(zero, len, this.wasm.sharedStringsDataIdx,
          this.b.addRef(new IrRefType(byteArr)),
          new ValTypeRef(byteArr) as ValType);
      let g = this.wasm.sharedStringsGlobal as WasmGlobal;
      this.b.emitVoid(IrOp.global_set, bytes,
          this.b.addRef(new IrRefGlobal(g)));
    }
    for (let g in this.wasm.globals) {
      if (g.namespaceImport != null) {
        this.#lowerNamespaceImportInit(g);
      }
    }
    let progOpt = this.wasm.program;
    if (progOpt != null) {
      let prog = progOpt as Program;
      for (let unit in prog.units) {
        if (unit.model.sourcePath.contains('memory.zena')) {
          this.#lowerUnitGlobalInits(unit);
        }
      }
      for (let unit in prog.units) {
        if (!unit.model.sourcePath.contains('memory.zena')) {
          this.#lowerUnitGlobalInits(unit);
        }
      }
    }
    this.b.retVoid();
    return this.b.finish();
  }

  /** One unit's non-literal global initializers, streaming's order. */
  #lowerUnitGlobalInits(unit: CompilationUnit): void {
    let model = unit.model;
    for (let stmt in unit.ast.body) {
      if (stmt is VariableDeclaration) {
        let vd = stmt as VariableDeclaration;
        if (vd.pattern is IdentifierPattern) {
          let sym = model.resolveDeclaration(vd.pattern);
          if (sym != null) {
            if (let (true, g) = this.wasm.globalMap.get((sym as Symbol).id)) {
              if (g.initExpr != null &&
                  !this.#isLiteralInit(g.initExpr as Expression)) {
                this.#lowerGlobalInit(g);
              }
            }
          }
        }
      } else if (stmt is ClassDeclaration) {
        let cd = stmt as ClassDeclaration;
        for (let member in cd.body) {
          if (member is FieldDefinition) {
            let fd = member as FieldDefinition;
            if (fd.isStatic && fd.value != null &&
                !this.#isLiteralInit(fd.value as Expression)) {
              if (fd.name is Identifier) {
                let expected = cd.name.name + '_' + (fd.name as Identifier).name;
                for (let g in this.wasm.globals) {
                  if (g.name == expected) {
                    this.#lowerGlobalInit(g);
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  /** Numeric/boolean literals init in the global's own initializer. */
  #isLiteralInit(e: Expression): boolean {
    return e is NumberLiteral || e is BooleanLiteral;
  }

  /**
   * Lowers one global's initializer under the global's OWN model —
   * restoring the swap even when the expression throws so no caller
   * ever observes a leaked swap.
   */
  #lowerGlobalInit(g: WasmGlobal): void {
    let saved = this.func.model;
    this.func.model = g.model;
    let value = try {
      this.#lowerExpressionCtx(g.initExpr as Expression, g.type)
    } catch (e) {
      this.func.model = saved;
      throw e
    };
    this.func.model = saved;
    if (!isValSubtype(this.#valueType(value), g.type)) {
      this.#failConformance(value, g.type, 'global init type');
    }
    this.b.emitVoid(IrOp.global_set, value,
        this.b.addRef(new IrRefGlobal(g)));
  }

  lowerSynthesizedConstructor(): IrBody {
    let sig = this.func.signature;
    if (sig.returns.length != 0 || sig.params.length == 0) {
      this.#bail('constructor shape');
    }
    if (this.func.classType == null || this.func.structType == null) {
      this.#bail('constructor without class');
    }
    let ct = this.func.classType as ClassType;
    let structType = this.func.structType as WasmStruct;
    if (ct.isExtension) {
      this.#bail('extension constructor');
    }
    let classDecl = this.func.classDecl;
    // Sealed-class variants (`case Lit(...)`) declare via a
    // SealedVariant node: no class body, so no local field defaults —
    // inherited initializers run in the base constructor via super.
    var cdOpt: ClassDeclaration | null = null;
    if (classDecl != null && classDecl is ClassDeclaration) {
      cdOpt = classDecl as ClassDeclaration;
    } else if (classDecl == null || !(classDecl is SealedVariant)) {
      this.#bail('constructor declaration shape');
    }

    let entry = this.b.newBlock();
    let params = new Array<i32>();
    for (let vt in sig.params) {
      this.#requireSupported(vt, 'constructor param type');
      params.push(this.b.blockParam(entry, vt));
    }
    this.b.switchTo(entry);
    this.#cx().thisValue = params[0];

    if (ct.isCaseClass) {
      this.#lowerCaseClassCtorBody(ct, structType, cdOpt, params);
    } else {
      this.#lowerDefaultCtorBody(ct, structType, cdOpt, params);
    }
    this.b.retVoid();
    return this.b.finish();
  }

  #lowerDefaultCtorBody(ct: ClassType, structType: WasmStruct,
      cdOpt: ClassDeclaration | null, params: Array<i32>): void {
    if (ct.superType != null) {
      let superType = ct.superType as ClassType;
      let ctorKey = getClassMethodKey(getClassKey(superType), '<constructor>');
      if (let (true, superCtor) = this.wasm.classMethodMap.get(ctorKey)) {
        // The default constructor forwards its own params to super.
        if (superCtor.signature.params.length > params.length ||
            superCtor.signature.returns.length != 0) {
          this.#bail('super constructor shape');
        }
        let args = new Array<i32>();
        for (var i = 0; i < superCtor.signature.params.length; i += 1) {
          if (!isValSubtype(this.#valueType(params[i]),
              superCtor.signature.params[i])) {
            this.#bail('super constructor arg type');
          }
          args.push(params[i]);
        }
        let fr = this.b.addRef(new IrRefFunc(superCtor));
        this.b.callFunc(fr, args, null);
      }
    }
    if (cdOpt == null) {
      return;
    }
    let cd = cdOpt as ClassDeclaration;
    for (let member in cd.body) {
      if (member is FieldDefinition) {
        let fd = member as FieldDefinition;
        if (fd.value != null && !fd.isStatic) {
          if (!(fd.name is Identifier)) {
            this.#bail('field name shape');
          }
          this.#storeCtorField(ct, structType, (fd.name as Identifier).name,
              fd.value as Expression, false);
        }
      }
    }
    this.#mixinFieldDefaults(ct, structType, cd, false);
  }

  /**
   * Field-default stores for the fields a class gains from its mixins,
   * after the class's own defaults (streaming's order). Private mixin
   * field names mangle with the MIXIN's scope key via #storeCtorField.
   */
  #mixinFieldDefaults(ct: ClassType, structType: WasmStruct,
      cd: ClassDeclaration, mapSetterNames: boolean): void {
    if (cd.mixins == null ||
        (cd.mixins as Array<TypeAnnotation>).length == 0) {
      return;
    }
    let mixinFields = new Array<FieldDefinition>();
    let mixinFieldScopes = new Array<String>();
    let seenMixins = new HashMap<MixinKey, boolean>();
    collectMixinFields(this.wasm.program as Program, this.func.model,
        cd.mixins, mixinFields, mixinFieldScopes, seenMixins);
    for (var i = 0; i < mixinFields.length; i += 1) {
      let fd = mixinFields[i];
      if (fd.value != null && !fd.isStatic) {
        if (!(fd.name is Identifier)) {
          this.#bail('field name shape');
        }
        this.#storeCtorField(ct, structType, (fd.name as Identifier).name,
            fd.value as Expression, mapSetterNames, mixinFieldScopes[i]);
      }
    }
  }

  #lowerCaseClassCtorBody(ct: ClassType, structType: WasmStruct,
      cdOpt: ClassDeclaration | null, params: Array<i32>): void {
    if (ct.superType != null) {
      let superType = ct.superType as ClassType;
      let ctorKey = getClassMethodKey(getClassKey(superType), '<constructor>');
      if (let (true, superCtor) = this.wasm.classMethodMap.get(ctorKey)) {
        // The case-class constructor passes ONLY the receiver to super.
        if (superCtor.signature.params.length != 1 ||
            superCtor.signature.returns.length != 0 ||
            !isValSubtype(this.#valueType(params[0]),
                superCtor.signature.params[0])) {
          this.#bail('case super constructor shape');
        }
        let fr = this.b.addRef(new IrRefFunc(superCtor));
        this.b.callFunc(fr, this.#oneArg(params[0]), null);
      }
    }
    if (ct.constructorType != null) {
      let ctorType = ct.constructorType as FunctionType;
      if (ctorType.parameterNames != null) {
        let names = ctorType.parameterNames as Array<String>;
        for (var pi = 0; pi < ctorType.parameters.length; pi += 1) {
          if (pi + 1 >= params.length || pi >= names.length) {
            this.#bail('case constructor arity');
          }
          let pName = names[pi];
          var lookupName = pName;
          if (pName.length > 0 && pName.sliceBytes(0, 1) == "#") {
            lookupName = getClassPrivateFieldKey(getClassKey(ct), pName);
          }
          let fieldIdx = structType.fieldIndexByName(lookupName);
          if (fieldIdx >= 0) {
            let fieldVt = structType.fields[fieldIdx].type;
            if (!isValSubtype(this.#valueType(params[pi + 1]), fieldVt)) {
              this.#bail('case constructor param type');
            }
            let fieldRef = this.b.addRef(new IrRefField(structType, lookupName));
            let pairIdx = this.b.pushExtra(
                this.#twoValues(this.#cx().thisValue, params[pi + 1]));
            this.b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
          }
        }
      }
    }
    if (cdOpt == null) {
      return;
    }
    let cd = cdOpt as ClassDeclaration;
    for (let member in cd.body) {
      if (member is FieldDefinition) {
        let fd = member as FieldDefinition;
        if (fd.value != null && !fd.isStatic) {
          // Streaming skips (not bails) non-identifier field names here.
          if (fd.name is Identifier) {
            this.#storeCtorField(ct, structType,
                (fd.name as Identifier).name, fd.value as Expression);
          }
        }
      }
    }
  }

  /**
   * Closure implementation prologue, mirroring the streaming
   * generator: cast the structref context parameter to the context
   * struct and bind `this` (when captured) and each captured value
   * into the SSA environment. Celled captures bailed in pre-flight,
   * and captured symbols are never assigned in a lowered body (an
   * assignment would have made them celled), so plain environment
   * entries are sound — they never need merge parameters.
   */
  #lowerClosurePrologue(ctxParam: i32): void {
    let cs = this.func.contextStruct as WasmStruct;
    if (cs.fields.length == 0) {
      return;
    }
    let castVt: ValType = new ValTypeRef(cs);
    let casted = this.b.emit(IrOp.ref_cast, castVt, ctxParam,
        this.b.internType(castVt));
    var fieldIdx = 0;
    if (this.func.capturesThis) {
      let field = cs.fields[0];
      let fieldName = field.name;
      if (fieldName == null) {
        this.#bail('unnamed context field');
      }
      let fieldRef = this.b.addRef(new IrRefField(cs, fieldName as String));
      this.#cx().thisValue = this.b.emit(IrOp.struct_get, field.type, casted, fieldRef);
      fieldIdx = 1;
    }
    for (let symId in this.func.captures) {
      let field = cs.fields[fieldIdx];
      let fieldName = field.name;
      if (fieldName == null) {
        this.#bail('unnamed context field');
      }
      this.#requireSupported(field.type, 'capture type');
      let fieldRef = this.b.addRef(new IrRefField(cs, fieldName as String));
      let value = this.b.emit(IrOp.struct_get, field.type, casted, fieldRef);
      this.#cx().env[symId] = value;
      fieldIdx += 1;
    }
  }

  /**
   * Constructor prologue, mirroring FunctionGenerator's order exactly:
   * field default initializers (class body FieldDefinitions with
   * values), then the initializer list (which also carries desugared
   * `this.x` parameters), then the super-initializer call, then the
   * body. Mixins and decorated (synthetic) constructors bail before we
   * get here.
   */
  #lowerConstructorPrologue(md: MethodDefinition): void {
    if (this.func.classType == null || this.func.structType == null) {
      this.#bail('constructor without class');
    }
    let ct = this.func.classType as ClassType;
    let structType = this.func.structType as WasmStruct;
    if (ct.isExtension) {
      this.#bail('extension constructor');
    }
    let classDecl = this.func.classDecl;
    if (classDecl == null || !(classDecl is ClassDeclaration)) {
      this.#bail('constructor declaration shape');
    }
    let cd = classDecl as ClassDeclaration;

    // 1. Field defaults, in declaration order: the class's own fields,
    // then mixin fields — streaming's order.
    for (let member in cd.body) {
      if (member is FieldDefinition) {
        let fd = member as FieldDefinition;
        if (fd.value != null && !fd.isStatic) {
          if (!(fd.name is Identifier)) {
            this.#bail('field name shape');
          }
          this.#storeCtorField(ct, structType, (fd.name as Identifier).name,
              fd.value as Expression);
        }
      }
    }
    this.#mixinFieldDefaults(ct, structType, cd, true);

    // 2. Initializer list (includes desugared this.x params).
    if (md.initializerList != null) {
      for (let init in md.initializerList as Array<Node>) {
        if (init is FieldInitializer) {
          let fi = init as FieldInitializer;
          this.#storeCtorField(ct, structType, fi.field.name, fi.value);
        } else {
          this.#bail('initializer kind');
        }
      }
    }

    // 3. Super-initializer.
    if (md.superInitializer != null) {
      let si = md.superInitializer as SuperInitializer;
      if (ct.superType == null) {
        this.#bail('super without superclass');
      }
      let superKey = getClassMethodKey(
          getClassKey(ct.superType as ClassType), '<constructor>');
      let superCtorOpt = if (let (true, sc) = this.wasm.classMethodMap.get(superKey)) sc else null;
      if (superCtorOpt == null) {
        this.#bail('super constructor not found');
      }
      let superCtor = superCtorOpt as WasmFunction;
      let superSig = superCtor.signature;
      if (superSig.params.length != si.args.length + 1) {
        this.#bail('super constructor arity');
      }
      let args = new Array<i32>();
      args.push(this.#cx().thisValue);
      for (var i = 0; i < si.args.length; i += 1) {
        let paramVt = superSig.params[i + 1];
        this.#requireSupported(paramVt, 'super arg type');
        var value = this.#lowerExpressionCtx(si.args[i], paramVt);
        value = this.#conformToSlot(value, paramVt, 'super argument type');
        args.push(value);
      }
      let superRef = this.b.addRef(new IrRefFunc(superCtor));
      this.b.callFunc(superRef, args, null);
    }
  }

  /**
   * Stores one constructor field initialization, applying the public
   * name -> private storage mapping (var(#x) x) and private-field key
   * mangling. Fields absent from the struct are skipped WITHOUT
   * evaluating the value, matching the streaming backend.
   */
  #storeCtorField(ct: ClassType, structType: WasmStruct, fieldName: String, value: Expression, mapSetterNames: boolean = true, mixinScope: String = ''): void {
    var actualName = fieldName;
    // Streaming's DEFAULT-constructor path stores by the raw field name;
    // the written-constructor and case-class paths apply the accessor
    // rename first. Mirror whichever the caller mirrors.
    if (mapSetterNames && ct.fieldSetterNames != null) {
      let mapping = ct.fieldSetterNames as HashMap<String, String>;
      if (let (true, mapped) = mapping.get(fieldName)) {
        actualName = mapped;
      }
    }
    var lookupName = actualName;
    if (actualName.length > 0 && actualName.sliceBytes(0, 1) == "#") {
      // Mixin privates are lexical to the MIXIN: their struct fields
      // carry the mixin's scope key, never the host class's.
      lookupName = if (mixinScope != '') {
        mixinScope + '::' + actualName
      } else {
        getClassPrivateFieldKey(getClassKey(ct), actualName)
      };
    }
    let found = structType.fieldIndexByName(lookupName) >= 0;
    if (!found) {
      return;
    }
    let fieldVt = this.#fieldValType(structType, lookupName);
    var lowered = this.#lowerExpressionCtx(value, fieldVt);
    lowered = this.#conformToSlot(lowered, fieldVt, 'constructor field type');
    let fieldRef = this.b.addRef(new IrRefField(structType, lookupName));
    let pairIdx = this.b.pushExtra(this.#twoValues(this.#cx().thisValue, lowered));
    this.b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
  }

  /**
   * Emits a return after checking the value is a wasm subtype of the
   * declared return type. A mismatch means an implicit conversion the
   * lowering doesn't model yet — most commonly packing a class instance
   * into an interface fat pointer — so the function bails rather than
   * emitting invalid wasm.
   */
  /**
   * Multi-value returns: only the inline-tuple-literal form for now —
   * elements lower straight onto the result stack (with `_` producing
   * the slot's default, mirroring streaming). Boxed tuples and call
   * forwarding still bail.
   */
  #lowerMultiReturn(arg: Expression): void {
    if (arg is CallExpression) {
      // Forwarding form: `return f(...)` where the callee returns the
      // same multi-value shape — projections flow straight through.
      let sig = this.func.signature;
      let outs = new Array<i32>();
      this.#lowerCall(arg as CallExpression, outs);
      if (outs.length != sig.returns.length) {
        this.#bail('multi-value return arity');
      }
      for (var i = 0; i < outs.length; i += 1) {
        if (!isValSubtype(this.#valueType(outs[i]), sig.returns[i])) {
          this.#failConformance(outs[i], sig.returns[i],
              'multi-value return type');
        }
      }
      this.b.retMulti(outs);
      this.#cx().reachable = false;
      return;
    }
    if (!(arg is TupleLiteral)) {
      this.#bail('multi-value return');
    }
    let lit = arg as TupleLiteral;
    let sig = this.func.signature;
    if (lit.elements.length != sig.returns.length) {
      this.#bail('multi-value return arity');
    }
    let nt = this.func.model.getNodeType(lit);
    if (nt == null || !(baseType(nt as Type) is InlineTupleType)) {
      this.#bail('boxed tuple return');
    }
    let values = new Array<i32>();
    for (var i = 0; i < lit.elements.length; i += 1) {
      let el = lit.elements[i];
      let expected = sig.returns[i];
      var v = -1;
      if (el is Identifier && (el as Identifier).name == '_') {
        v = this.#defaultValueOf(expected);
      } else {
        v = this.#lowerExpressionCtx(el, expected);
      }
      if (!isValSubtype(this.#valueType(v), expected)) {
        this.#failConformance(v, expected, 'multi-value return type');
      }
      values.push(v);
    }
    this.b.retMulti(values);
  }

  /** The zero value of a result slot (for `_` tuple placeholders). */
  #defaultValueOf(vt: ValType): i32 {
    if (vt is ValTypeI32) {
      return this.b.constI32(0, vt);
    }
    if (vt is ValTypeI64) {
      return this.b.constI64(0 as i64, vt);
    }
    if (vt is ValTypeF64) {
      return this.b.constF64(0.0, vt);
    }
    if (vt is ValTypeF32) {
      return this.b.constF32(0.0, vt);
    }
    let nullable = vt is ValTypeRefNull || vt is ValTypeAnyRef ||
        vt is ValTypeEqRef || vt is ValTypeStructRef;
    if (nullable) {
      return this.b.emit(IrOp.ref_null, vt, -1, -1);
    }
    return this.#bailValue('placeholder type');
  }

  #emitCheckedRet(value: i32): void {
    let sig = this.func.signature;
    if (sig.returns.length != 1) {
      this.#bail('return value in void function');
    }
    var v = value;
    let have = this.#valueType(v);
    let want = sig.returns[0];
    if (!this.#cx().refConforms(have, want)) {
      // Returns conform like stores (the signature is the binding):
      // a nullable value whose non-null form conforms re-asserts (the
      // checker proved the return non-null); a wider ref value (an
      // erased eqref out of a merge-typed expression) casts down at
      // the boundary; anything else bails.
      if (have is ValTypeRefNull && want is ValTypeRef &&
          isValSubtype(new ValTypeRef((have as ValTypeRefNull).target) as ValType, want)) {
        v = this.b.emit(IrOp.ref_as_non_null,
            new ValTypeRef((have as ValTypeRefNull).target) as ValType, v, -1);
      } else if (isRefValType(have) && isValSubtype(want, have)) {
        v = this.b.emit(IrOp.ref_cast, want, v, this.b.internType(want));
      } else {
        this.#failConformance(v, want, 'return requires conversion');
      }
    }
    this.b.ret(v);
  }

  // -- Statements ------------------------------------------------------

  #lowerStatement(stmt: Statement): void {
    if (!this.#cx().reachable) {
      // Statically dead statements after return/break/continue: skip.
      return;
    }
    match (stmt) {
      case BlockStatement {body}: {
        for (let s in body) {
          this.#lowerStatement(s);
        }
      }
      case ExpressionStatement {expression}: {
        if (expression is ThrowExpression) {
          this.#lowerThrowStatement(expression as ThrowExpression);
        } else {
          this.#lowerExpression(expression);
        }
      }
      case VariableDeclaration as vd: {
        this.#lowerVariableDeclaration(vd);
      }
      case ReturnStatement {argument}: {
        if (argument == null) {
          this.b.retVoid();
        } else if (this.func.signature.returns.length > 1) {
          this.#lowerMultiReturn(argument as Expression);
        } else {
          let sig = this.func.signature;
          let ctx = if (sig.returns.length == 1) sig.returns[0] else null;
          let value = this.#lowerExpressionCtx(argument as Expression, ctx);
          this.#emitCheckedRet(value);
        }
        this.#cx().reachable = false;
      }
      case IfStatement as ifStmt: {
        this.#lowerIf(ifStmt);
      }
      case WhileStatement as whileStmt: {
        this.#lowerWhile(whileStmt);
      }
      case ForStatement as forStmt: {
        this.#lowerFor(forStmt);
      }
      case ForInStatement as forIn: {
        this.#lowerForIn(forIn);
      }
      case BreakStatement {}: {
        if (this.#cx().loops.length == 0) {
          this.#bail('break outside loop');
        }
        let loop = this.#cx().loops[this.#cx().loops.length - 1];
        this.b.br(loop.exit, this.#envValues(loop.carried));
        this.#cx().reachable = false;
      }
      case ContinueStatement {}: {
        if (this.#cx().loops.length == 0) {
          this.#bail('continue outside loop');
        }
        let loop = this.#cx().loops[this.#cx().loops.length - 1];
        this.b.br(loop.continueTarget, this.#envValues(loop.carried));
        this.#cx().reachable = false;
      }
      case _: {
        this.#bail('statement kind');
      }
    }
  }

  #lowerVariableDeclaration(vd: VariableDeclaration): void {
    var pat = vd.pattern;
    if (pat is BindingPattern) {
      pat = (pat as BindingPattern).pattern;
    }
    if (pat is TuplePattern) {
      this.#lowerTupleDeclaration(vd, pat as TuplePattern);
      return;
    }
    if (pat is RecordPattern) {
      this.#lowerObjectPatternDeclaration(vd, (pat as RecordPattern).properties);
      return;
    }
    if (!(pat is IdentifierPattern)) {
      this.#bail('destructuring declaration');
    }
    let sym = this.func.model.resolveDeclaration(pat);
    if (sym == null) {
      this.#bail('unresolved declaration');
    }
    let bindingType = this.func.model.getBindingType(sym as Symbol);
    if (bindingType == null) {
      this.#bail('untyped binding');
    }
    let bindingVt = typeToValTypeWithSub(this.wasm, bindingType as Type, this.func);
    this.#requireSupported(bindingVt, 'binding type');
    let value = this.#conformToBinding(
        this.#lowerExpressionCtx(vd.init, bindingVt), bindingVt);
    if (this.#isCelled((sym as Symbol).id)) {
      // The binding lives in a heap cell shared with capturing
      // closures; the environment holds the (invariant) cell ref.
      this.#cx().env[(sym as Symbol).id] = this.#cellAlloc(bindingVt, value);
    } else {
      this.#cx().env[(sym as Symbol).id] = value;
    }
    this.#cx().symbols[(sym as Symbol).id] = sym as Symbol;
  }

  #lowerLetCondition(lpc: LetPatternCondition): LetCondBinds {
    return lowerLetCondition(this.#cx(), lpc);
  }

  /**
   * Evaluates a let-condition init to its result VALUES: multi-value
   * direct calls (devirtualized method or top-level function) and
   * receiver-only interface dispatch (iterator next()). Single-result
   * sources come back as one-element lists.
   */
  #lowerMultiSource(init: Expression): Array<i32> {
    let out = new Array<i32>();
    if (init is TupleLiteral) {
      for (let el in (init as TupleLiteral).elements) {
        out.push(this.#lowerExpression(el));
      }
      return out;
    }
    if (!(init is CallExpression)) {
      // Any other expression: a single value (a boxed tuple splits at
      // the destructuring site).
      out.push(this.#lowerExpression(init));
      return out;
    }
    let call = init as CallExpression;
    if (call.callee is MemberExpression) {
      let member = call.callee as MemberExpression;
      let objT = this.#substitutedNodeType(member.object);
      if (objT != null && call.args.length == 0 &&
          this.#resolveSelfType(objT as Type) is InterfaceType) {
        let recv = this.#lowerExpression(member.object);
        return this.#cx().slotCallOnValue(recv, getMemberPropertyName(
            member.isSymbolAccess, member.property.name));
      }
      let rep = this.#lowerMethodCall(call, member, out);
      if (out.length == 0) {
        out.push(rep);
      }
      return out;
    }
    if (call.callee is Identifier) {
      let rep = this.#lowerCall(call, out);
      if (out.length == 0) {
        out.push(rep);
      }
      return out;
    }
    // Any other expression: a single value (a boxed tuple splits at
    // the destructuring site).
    out.push(this.#lowerExpression(init));
    return out;
  }

  /**
   * `let (a, b) = init;` — the init's values come from the same
   * multi-value machinery as let-conditions (direct calls, interface
   * next(), or a tuple literal), and each element binds like a plain
   * declaration: the binding's own checked type, with a runtime
   * downcast when the source slot is erased/nullable.
   */
  #lowerTupleDeclaration(vd: VariableDeclaration, tp: TuplePattern): void {
    var values = this.#lowerMultiSource(vd.init);
    if (values.length == 1 && tp.elements.length != 1) {
      // A single value can still be a BOXED tuple (fields "0"..):
      // non-inline tuple returns arrive as one struct reference.
      let unboxed = this.#unboxTupleValue(values[0], tp.elements.length);
      if (unboxed != null) {
        values = unboxed as Array<i32>;
      }
    }
    if (values.length != tp.elements.length) {
      this.#bail('destructuring arity');
    }
    for (var i = 0; i < tp.elements.length; i += 1) {
      let el = tp.elements[i];
      if (el == null || el is LiteralPattern || el is BooleanLiteral ||
          el is NumberLiteral || el is StringLiteral || el is NullLiteral) {
        continue;
      }
      if (this.#patternBinds(el as Node)) {
        this.#lowerPatternBindings(el as Node, values[i]);
      }
    }
  }


  /**
   * Splits a boxed-tuple struct value (fields "0".."n-1") into its
   * element values, or null when the value is not that shape.
   */
  #unboxTupleValue(value: i32, n: i32): Array<i32> | null {
    let stOpt = asWasmStruct(this.#valueType(value));
    if (stOpt == null) {
      return null;
    }
    let st = stOpt as WasmStruct;
    let out = new Array<i32>();
    for (var i = 0; i < n; i += 1) {
      let fieldName = i32ToString(i);
      if (st.fieldIndexByName(fieldName) < 0) {
        return null;
      }
      let fieldRef = this.b.addRef(new IrRefField(st, fieldName));
      out.push(this.b.emit(IrOp.struct_get,
          this.#fieldValType(st, fieldName), value, fieldRef));
    }
    return out;
  }


  /**
   * `let { x, y } = value`: the source evaluates once; each property
   * binds via an ordinary member read on it (class fields/getters or
   * record dispatch), with the binding's own checked type.
   */
  #lowerObjectPatternDeclaration(vd: VariableDeclaration,
      properties: Array<BindingProperty>): void {
    if (vd.init == null) {
      this.#bail('destructuring without initializer');
    }
    let source = this.#lowerExpression(vd.init);
    let initTypeOpt = this.#substitutedNodeType(vd.init);
    if (initTypeOpt == null) {
      this.#bail('untyped destructuring source');
    }
    let initBase = baseType(getNonNullableType(initTypeOpt as Type));
    for (let prop in properties) {
      if (!this.#patternBinds(prop.value)) {
        continue;
      }
      let read = if (initBase is RecordType) {
        this.#lowerRecordPropertyRead(
            initBase as RecordType, prop.name.name, source)
      } else {
        this.#lowerObjectPropertyRead(prop.name.name, source)
      };
      this.#lowerPatternBindings(prop.value, read);
    }
  }

  /** A record property read on an already-lowered receiver value. */
  #lowerRecordPropertyRead(rt: RecordType, propName: String,
      receiver: i32): i32 {
    let dispatch = this.#cx().recordDispatchOf(rt);
    let recv = this.#conformRecordReceiver(dispatch, receiver);
    return this.#recordDispatchRead(dispatch, propName, recv);
  }

  /**
   * Conforms a receiver to the dispatch's fat-pointer type: adapted
   * or wider receivers cast down; exact ones pass through.
   */
  #conformRecordReceiver(dispatch: RecordDispatchInfo, recv: i32): i32 {
    let fatVt = new ValTypeRefNull(dispatch.fatPtrType) as ValType;
    if (isValSubtype(this.#valueType(recv), fatVt)) {
      return recv;
    }
    let castVt = new ValTypeRef(dispatch.fatPtrType) as ValType;
    return this.b.emit(IrOp.ref_cast, castVt, recv,
        this.b.internType(castVt));
  }

  #lowerObjectPropertyRead(propName: String, receiver: i32): i32 {
    return this.#cx().objectPropertyRead(propName, receiver);
  }

  #lowerIf(stmt: IfStatement): void {
    lowerIf(this.#cx(), stmt);
  }

  #lowerWhile(stmt: WhileStatement): void {
    lowerWhile(this.#cx(), stmt);
  }

  #lowerFor(stmt: ForStatement): void {
    lowerFor(this.#cx(), stmt);
  }

  #lowerForIn(stmt: ForInStatement): void {
    lowerForIn(this.#cx(), stmt);
  }

  #slotCallSingle(recv: i32, memberName: String): i32 {
    return this.#cx().slotCallSingle(recv, memberName);
  }

  #slotCallMulti(recv: i32, memberName: String): Array<i32> {
    return this.#cx().slotCallMulti(recv, memberName);
  }

  /**
   * Static method calls: the receiver expression names the class (its
   * checked type IS the ClassType), the method resolves by walking
   * the class and its supertypes for an isStatic registration under
   * the (overload-mangled) slot name, and the call passes no
   * receiver — streaming's shape exactly.
   */
  #lowerStaticCall(call: CallExpression, member: MemberExpression,
      multiOut: Array<i32> | null): i32 {
    let objectType = this.#substitutedNodeType(member.object);
    if (objectType == null) {
      this.#bail('untyped static receiver');
    }
    let resolved = this.#resolveSelfType(objectType as Type);
    if (!(resolved is ClassType)) {
      this.#bail('static receiver kind');
    }
    let ct = eraseTypeParameters(resolved) as ClassType;
    var name = getMemberPropertyName(
        member.isSymbolAccess, member.property.name);
    // Overload choice belongs to the checker; the recorded selection
    // reproduces the registered slot name. No record = no overloads.
    let chosenFt = this.func.model.getResolvedOverload(call);
    if (chosenFt != null) {
      name = name + getSignatureKey(chosenFt as FunctionType);
    }
    var foundOpt: WasmFunction | null = null;
    var curr: ClassType | null = ct;
    while (curr != null && foundOpt == null) {
      let key = getClassMethodKey(getClassKey(curr as ClassType), name);
      if (let (true, f) = this.wasm.classMethodMap.get(key)) {
        if (f.isStatic) {
          foundOpt = f;
        }
      }
      curr = (curr as ClassType).superType;
    }
    if (foundOpt == null) {
      this.#bail('static method not found');
    }
    let target = foundOpt as WasmFunction;
    if (target.typeParameters != null || target.intrinsic != null) {
      this.#bail('static method shape');
    }
    let sig = target.signature;
    if (sig.returns.length > 1 && multiOut == null) {
      this.#bail('method multi-value return');
    }
    if (sig.params.length != call.args.length) {
      this.#bail('static call arity');
    }
    let args = new Array<i32>();
    for (var i = 0; i < sig.params.length; i += 1) {
      this.#requireSupported(sig.params[i], 'method param type');
      var v = this.#lowerExpressionCtx(call.args[i], sig.params[i]);
      v = this.#conformToSlot(v, sig.params[i], 'method argument type');
      args.push(v);
    }
    let fr = this.b.addRef(new IrRefFunc(target));
    if (sig.returns.length > 1) {
      for (let r in sig.returns) {
        this.#requireSupported(r, 'method result type');
      }
      let projs = this.b.callFuncMulti(fr, args, sig.returns);
      let outs = multiOut as Array<i32>;
      for (let p in projs) {
        outs.push(p);
      }
      return projs[0];
    }
    var resultType: ValType | null = null;
    if (sig.returns.length == 1) {
      this.#requireSupported(sig.returns[0], 'method result type');
      resultType = sig.returns[0];
    }
    let result = this.b.callFunc(fr, args, resultType);
    return this.#reassertCallResult(call, result, resultType);
  }

  /**
   * The checker-solved type arguments recorded on a generic call's
   * callee type, substituted into this function's context; null when
   * the callee's checked type records none (non-generic call).
   */
  #solvedCallTypeArguments(call: CallExpression): Array<Type> | null {
    let ftNode = this.func.model.getNodeType(call.callee);
    if (ftNode == null || !(ftNode is FunctionType)) {
      return null;
    }
    let ft = ftNode as FunctionType;
    if (ft.typeArguments == null) {
      return null;
    }
    let raw = ft.typeArguments as Array<Type>;
    if (raw.length == 0) {
      return null;
    }
    let out = new Array<Type>();
    for (let a in raw) {
      out.push(substituteTypeParamsInFunctionContext(this.func, a));
    }
    return out;
  }

  /**
   * Direct call to a monomorphized (_spec_) copy of a top-level
   * generic function: the solved type arguments named a fully typed
   * specialization, so this is an ordinary direct call. Generic
   * METHODS resolve through the devirt path instead — their
   * specializations register under mangled classMethodMap slot names.
   */
  #lowerSpecializedCall(call: CallExpression, target: WasmFunction,
      multiOut: Array<i32> | null): i32 {
    let sig = target.signature;
    if (sig.returns.length > 1 && multiOut == null) {
      this.#bail('method multi-value return');
    }
    if (sig.params.length != call.args.length) {
      this.#bail('specialized call arity');
    }
    let defaults = this.#defaultArgInfo(call);
    let args = new Array<i32>();
    for (var i = 0; i < call.args.length; i += 1) {
      let pt = sig.params[i];
      this.#requireSupported(pt, 'method param type');
      var v = this.#lowerArgWithDefaults(call, i, pt, defaults, -1);
      v = this.#conformToSlot(v, pt, 'method argument type');
      args.push(v);
    }
    let fr = this.b.addRef(new IrRefFunc(target));
    if (sig.returns.length > 1) {
      for (let r in sig.returns) {
        this.#requireSupported(r, 'method result type');
      }
      let projs = this.b.callFuncMulti(fr, args, sig.returns);
      let outs = multiOut as Array<i32>;
      for (let p in projs) {
        outs.push(p);
      }
      return projs[0];
    }
    var resultType: ValType | null = null;
    if (sig.returns.length == 1) {
      this.#requireSupported(sig.returns[0], 'method result type');
      resultType = sig.returns[0];
    }
    let result = this.b.callFunc(fr, args, resultType);
    return this.#reassertCallResult(call, result, resultType);
  }

  // -- Expressions -----------------------------------------------------

  #lowerExpression(expr: Expression): i32 {
    let value = this.#lowerExpressionDispatch(expr);
    return this.#applyAdaptations(expr, value);
  }

  /**
   * Post-expression adaptations, mirroring the streaming generator's
   * hook after generateExpression: the model marks expressions whose
   * value must be repacked for the consuming context. Interface
   * adaptations pack a class instance into a fat pointer (iface_pack);
   * record and function adaptations are not lowered yet and bail —
   * loudly, since silently skipping a required repack would miscompile.
   */
  #applyAdaptations(expr: Expression, value: i32): i32 {
    var v = value;
    let raOpt = this.func.model.getRecordAdaptation(expr);
    if (raOpt != null) {
      v = this.#applyRecordAdaptation(raOpt as RecordAdaptation, v);
    }
    v = this.#applyInterfaceAdaptation(expr, v);
    let faOpt = this.func.model.getFunctionAdaptation(expr);
    if (faOpt != null) {
      v = this.#applyFunctionAdaptation(
          expr, faOpt as FunctionAdaptation, v);
    }
    return v;
  }

  /**
   * Record repack: the value is a record fat pointer; the adapted view
   * keeps the same instance and swaps in the vtable whose getters
   * were generated for the target shape (registered during discovery
   * — a missing registration bails).
   */
  #applyRecordAdaptation(ra: RecordAdaptation, value: i32): i32 {
    if (value < 0 || this.b.body.typeId[value] < 0) {
      this.#bail('record adaptation without value');
    }
    let inFields = new Array<WasmField>();
    for (let pair in ra.source.properties) {
      inFields.push(new WasmField(pair.key,
          typeToValType(this.wasm, pair.value), false));
    }
    let inInfo = this.wasm.getRecordDispatch(this.func.model, inFields);
    let outFields = new Array<WasmField>();
    for (let pair in ra.target.properties) {
      outFields.push(new WasmField(pair.key,
          typeToValType(this.wasm, pair.value), false));
    }
    let outInfo = this.wasm.getAdaptedRecordDispatch(
        this.func.model, inFields, outFields);
    if (outInfo.vtableGlobal.index < 0) {
      this.#bail('record adaptation vtable unregistered');
    }
    let inVt = new ValTypeRef(inInfo.fatPtrType) as ValType;
    var src = value;
    if (!isValSubtype(this.#valueType(src), inVt)) {
      src = this.b.emit(IrOp.ref_cast, inVt, src, this.b.internType(inVt));
    }
    let inst = this.b.emit(IrOp.iface_instance,
        inInfo.fatPtrType.fields[0].type, src, -1);
    return this.b.emit(IrOp.iface_pack,
        new ValTypeRef(outInfo.fatPtrType) as ValType, inst,
        this.b.addRef(new IrRefGlobal(outInfo.vtableGlobal)));
  }

  /**
   * Function repack: the wrapper registered for this site (during
   * discovery) forwards the target arity to the source closure; the
   * adapted value is a target-shaped pair whose context is the WHOLE
   * source pair.
   */
  #applyFunctionAdaptation(expr: Expression, fa: FunctionAdaptation,
      value: i32): i32 {
    if (value < 0 || this.b.body.typeId[value] < 0) {
      this.#bail('function adaptation without value');
    }
    let wOpt = if (let (true, w) = this.wasm.functionAdaptationWrappers.get(expr)) w else null;
    if (wOpt == null) {
      this.#bail('function adaptation wrapper unregistered');
    }
    let wrapper = wOpt as WasmFunction;
    let actualStruct = wrapper.functionAdaptationResolvedSourceStruct ??
        getClosureStruct(this.wasm, fa.source);
    let expectedStruct = wrapper.functionAdaptationResolvedTargetStruct ??
        getClosureStruct(this.wasm, fa.target);
    let actualVt = new ValTypeRef(actualStruct) as ValType;
    var pair = value;
    if (!isValSubtype(this.#valueType(pair), actualVt)) {
      pair = this.b.emit(IrOp.ref_cast, actualVt, pair,
          this.b.internType(actualVt));
    }
    let funcVal = this.b.emit(IrOp.ref_func,
        expectedStruct.fields[0].type, -1,
        this.b.addRef(new IrRefFunc(wrapper)));
    let pairArgs = this.#twoValues(funcVal, pair);
    return this.b.emit(IrOp.struct_new,
        new ValTypeRef(expectedStruct) as ValType,
        this.b.pushArgList(pairArgs),
        this.b.addRef(new IrRefType(expectedStruct)));
  }

  #applyInterfaceAdaptation(expr: Expression, value: i32): i32 {
    let iaOpt = this.func.model.getInterfaceAdaptation(expr);
    if (iaOpt == null) {
      return value;
    }
    if (value < 0 || this.b.body.typeId[value] < 0) {
      this.#bail('interface adaptation without value');
    }
    let ia = iaOpt as InterfaceAdaptation;
    var srcType = ia.source as Type;
    var tgtType = ia.target as Type;
    // Mixin-intermediate and `_This`-marker sources stand in for the
    // enclosing class (mirrors the streaming hook).
    if (srcType is ClassType) {
      let sct = srcType as ClassType;
      let n = sct.name;
      if (sct.isMixinIntermediate ||
          (n.length >= 5 && n.sliceBytes(n.length - 5, n.length) == "_This")) {
        if (this.func.classType != null) {
          srcType = this.func.classType as ClassType;
        }
      }
    }
    if (this.func.classType != null) {
      let ct = this.func.classType as ClassType;
      srcType = substituteTypeParamsInClassContext(ct, srcType);
      tgtType = substituteTypeParamsInClassContext(ct, tgtType);
    }
    if (!(srcType is ClassType) || !(tgtType is InterfaceType)) {
      this.#bail('interface adaptation shape');
    }
    return this.#packInterface(value, srcType as ClassType,
        tgtType as InterfaceType);
  }

  #packInterface(value: i32, ct: ClassType, it: InterfaceType): i32 {
    return this.#cx().packInterface(value, ct, it);
  }

  #lowerExpressionDispatch(expr: Expression): i32 {
    return match (expr) {
      case NumberLiteral as lit: this.#lowerNumberLiteral(lit)
      case BooleanLiteral {value}: this.b.constI32(if (value) 1 else 0, new ValTypeI32())
      case Identifier as ident: this.#lowerIdentifier(ident)
      case BinaryExpression as bin: this.#lowerBinary(bin)
      case UnaryExpression as un: this.#lowerUnary(un)
      case AssignmentExpression as assign: this.#lowerAssignment(assign)
      case CallExpression as call: this.#lowerCall(call)
      case IfExpression as ifExpr: this.#lowerIfExpression(ifExpr)
      case MatchExpression as matchExpr: this.#lowerMatch(matchExpr)
      case AsExpression as asExpr: this.#lowerAs(asExpr)
      case StringLiteral as strLit: this.#lowerStringLiteral(strLit)
      case NewExpression as newExpr: this.#lowerNew(newExpr)
      case MemberExpression as member: this.#lowerMemberRead(member)
      case ThisExpression: this.#lowerThis(expr)
      case FunctionExpression as fExpr: this.#lowerFunctionExpression(fExpr)
      case NullLiteral: this.#bailValue('null without context')
      case IndexExpression as idx: this.#lowerIndexRead(idx)
      case TemplateLiteral as tpl: this.#lowerTemplateLiteral(tpl)
      case IsExpression as isExpr: this.#lowerIs(isExpr)
      case ArrayLiteral as arrLit: this.#lowerArrayLiteral(arrLit)
      case RecordLiteral as recLit: this.#lowerRecordLiteral(recLit)
      case TupleLiteral as tupLit: this.#lowerTupleLiteralExpr(tupLit)
      case RangeExpression as range: this.#lowerRangeExpr(range)
      case TryExpression as tryExpr: this.#lowerTryExpression(tryExpr)
      case MapLiteral as mapLit: this.#lowerMapLiteral(mapLit)
      case PipelineExpression as pipe: this.#lowerPipeline(pipe)
      case PipePlaceholder: this.#lowerPipePlaceholder()
      case TaggedTemplateExpression as tagged: this.#lowerTaggedTemplate(tagged)
      case _: this.#bailValue('expression kind' + kindTagOf(expr))
    };
  }


  /**
   * A tuple literal in value position: the boxed form only — one
   * struct with fields "0".."n-1" (the same shape-deduped struct the
   * return-type mapping uses). Inline tuples never appear in value
   * position; their construction lives in the multi-value paths.
   */
  #lowerTupleLiteralExpr(tl: TupleLiteral): i32 {
    let tOpt = this.#substitutedNodeType(tl);
    if (tOpt == null) {
      this.#bail('untyped tuple literal');
    }
    let bt = baseType(tOpt as Type);
    if (!(bt is TupleType)) {
      this.#bail('inline tuple in value position');
    }
    let tt = bt as TupleType;
    let fields = new Array<WasmField>();
    for (var i = 0; i < tt.elementTypes.length; i += 1) {
      fields.push(new WasmField(i32ToString(i),
          typeToValTypeWithSub(this.wasm, tt.elementTypes[i], this.func),
          false));
    }
    let st = this.wasm.getStruct(null, fields);
    if (tl.elements.length != fields.length) {
      this.#bail('tuple literal arity');
    }
    let args = new Array<i32>();
    for (var i = 0; i < tl.elements.length; i += 1) {
      let fieldVt = fields[i].type;
      var v = this.#lowerExpressionCtx(tl.elements[i], fieldVt);
      v = this.#conformToSlot(v, fieldVt, 'tuple literal element type');
      args.push(v);
    }
    return this.b.emit(IrOp.struct_new, new ValTypeRef(st) as ValType,
        this.b.pushArgList(args), this.b.addRef(new IrRefType(st)));
  }

  /**
   * `{ x: 1, y: 2 }`: field values in sorted-field order into one
   * struct.new, then the shape's vtable global packs the fat pointer
   * — streaming's shape. Spread properties bail. The last assignment
   * to a repeated key wins, matching streaming's back-to-front scan.
   */
  #lowerRecordLiteral(lit: RecordLiteral): i32 {
    let tOpt = this.#substitutedNodeType(lit);
    if (tOpt == null) {
      this.#bail('untyped record literal');
    }
    let bt = baseType(tOpt as Type);
    if (!(bt is RecordType)) {
      this.#bail('record literal type');
    }
    let dispatch = this.#cx().recordDispatchOf(bt as RecordType);
    // Spread sources evaluate first, once each (streaming's order);
    // their values are looked up per field below.
    let spreadIds = new Array<i32>();
    let spreadVals = new Array<i32>();
    for (let prop in lit.properties) {
      if (prop is SpreadElement) {
        let sp = prop as SpreadElement;
        spreadIds.push((sp as Node).id as i32);
        spreadVals.push(this.#lowerExpression(sp.argument));
      }
    }
    let args = new Array<i32>();
    for (let f in dispatch.fields) {
      let key = if (f.name != null) f.name as String else '';
      var v = -1;
      var found = false;
      // Last property wins, scanning explicit assignments and spreads
      // alike from the end — streaming's override order.
      var pi = lit.properties.length - 1;
      while (pi >= 0 && !found) {
        let prop = lit.properties[pi];
        if (prop is PropertyAssignment) {
          let pa = prop as PropertyAssignment;
          if (pa.name.name == key) {
            v = this.#lowerExpressionCtx(pa.value, f.type);
            found = true;
          }
        } else if (prop is SpreadElement) {
          let sp = prop as SpreadElement;
          let spT = this.#substitutedNodeType(sp.argument);
          if (spT != null) {
            var sv = -1;
            for (var si = 0; si < spreadIds.length; si += 1) {
              if (spreadIds[si] == ((sp as Node).id as i32)) {
                sv = spreadVals[si];
              }
            }
            let nn = baseType(getNonNullableType(spT as Type));
            if (nn is RecordType && (nn as RecordType).properties.has(key)) {
              let srcDispatch = this.#cx().recordDispatchOf(nn as RecordType);
              v = this.#recordDispatchRead(srcDispatch, key, sv);
              found = true;
            } else if (nn is ClassType) {
              // Class spreads copy PHYSICAL public fields; anything
              // else falls through and the missing-field bail fires.
              var ct = eraseTypeParameters(
                  this.#resolveSelfType(nn as Type)) as ClassType;
              if (ct.members.has(key) &&
                  !(key.length > 0 && key.sliceBytes(0, 1) == '#')) {
                let infoOpt = if (let (true, info) = this.wasm.classInfos.get(getClassKey(ct))) info else null;
                if (infoOpt != null) {
                  let st = (infoOpt as ClassCodegenInfo).structType;
                  if (st.fieldIndexByName(key) >= 0) {
                    let fieldRef = this.b.addRef(new IrRefField(st, key));
                    v = this.b.emit(IrOp.struct_get,
                        this.#fieldValType(st, key),
                        this.#coerceTo(sv, new ValTypeRef(st) as ValType),
                        fieldRef);
                    found = true;
                  }
                }
              }
            }
          }
        }
        pi -= 1;
      }
      if (!found) {
        this.#bail('record literal field missing');
      }
      if (!isValSubtype(this.#valueType(v), f.type)) {
        this.#failConformance(v, f.type, 'record literal field type');
      }
      args.push(v);
    }
    let instance = this.b.emit(IrOp.struct_new,
        new ValTypeRef(dispatch.concreteType) as ValType,
        this.b.pushArgList(args),
        this.b.addRef(new IrRefType(dispatch.concreteType)));
    return this.b.emit(IrOp.iface_pack,
        new ValTypeRef(dispatch.fatPtrType) as ValType, instance,
        this.b.addRef(new IrRefGlobal(dispatch.vtableGlobal)));
  }

  /**
   * Reading a record member: the fat pointer's vtable slot holds the
   * getter for the field (record values may be adapted views, so the
   * read always dispatches — streaming's shape).
   */
  #lowerRecordRead(rt: RecordType, member: MemberExpression): i32 {
    let recv = this.#lowerExpression(member.object);
    return this.#lowerRecordReadOn(rt, member, recv);
  }

  /** The receiver-value core of a record member read. */
  #lowerRecordReadOn(rt: RecordType, member: MemberExpression,
      recvIn: i32): i32 {
    let dispatch = this.#cx().recordDispatchOf(rt);
    let propName = getMemberPropertyName(
        member.isSymbolAccess, member.property.name);
    let recv = this.#conformRecordReceiver(dispatch, recvIn);
    let result = this.#recordDispatchRead(dispatch, propName, recv);
    return this.#reassertNonNull(result, this.#exprValType(member));
  }

  /**
   * `[a, b, c]`: each element lowers against the array's element
   * type, then one array.new_fixed builds the array — streaming's
   * shape. The literal's checked type names the wasm array type.
   */
  #lowerArrayLiteral(lit: ArrayLiteral): i32 {
    let vt = this.#exprValType(lit);
    let arrOpt = asWasmArray(vt);
    if (arrOpt == null) {
      this.#bail('array literal type');
    }
    let arr = arrOpt as WasmArray;
    let elemVt = arr.elementType;
    let args = new Array<i32>();
    for (let el in lit.elements) {
      let v = this.#lowerExpressionCtx(el, elemVt);
      // Packed i8 elements store i32 values; everything else must
      // conform to the element type.
      if (!(elemVt is ValTypeI8) &&
          !isValSubtype(this.#valueType(v), elemVt)) {
        this.#bail('array literal element type');
      }
      args.push(v);
    }
    return this.b.emit(IrOp.array_new_fixed, vt,
        this.b.pushArgList(args), this.b.addRef(new IrRefType(arr)));
  }

  /**
   * `x is T`: ref.test for reference sources; non-reference sources
   * fold to a constant by type identity (the operand still evaluates
   * for effects). Mirrors streaming's IsExpression codegen.
   */
  #lowerIs(isExpr: IsExpression): i32 {
    let sourceTypeOpt = this.#substitutedNodeType(isExpr.expression);
    if (sourceTypeOpt == null) {
      this.#bail('untyped is source');
    }
    let sourceType = sourceTypeOpt as Type;
    let targetTypeOpt = this.func.model.getNodeType(isExpr.typeAnnotation);
    if (targetTypeOpt == null) {
      this.#bail('untyped is target');
    }
    let targetType = substituteTypeParamsInFunctionContext(
        this.func, targetTypeOpt as Type);
    let value = this.#lowerExpression(isExpr.expression);
    if (!isRefType(sourceType)) {
      let same = getTypeUniqueKey(sourceType) == getTypeUniqueKey(targetType) ||
          targetType is AnyRefType ||
          targetType is EqRefType;
      return this.b.constI32(if (same) 1 else 0, new ValTypeI32());
    }
    if (!isRefValType(this.#valueType(value))) {
      this.#bail('is operand type');
    }
    let targetVt = typeToValTypeWithSub(this.wasm, targetType, this.func);
    let target = refTargetOf(targetVt);
    if (target == null) {
      this.#bail('is target kind');
    }
    // Streaming emits a plain (non-null) ref.test either way.
    return this.b.emit(IrOp.ref_test, new ValTypeI32(), value,
        this.b.internType(new ValTypeRef(target as WasmType) as ValType));
  }

  /**
   * `throw e;` in statement position, mirroring streaming: the payload
   * value is stored in the shared exception-payload GLOBAL (the tag
   * itself carries no values), then the module-wide tag is thrown.
   * Expression-position throws still bail — they would have to yield a
   * value of the surrounding type from an unreachable continuation, a
   * shape lowering does not model yet.
   */
  #lowerThrowStatement(thr: ThrowExpression): void {
    this.wasm.ensureExceptionInfra(this.func.model);
    let tagOpt = this.wasm.exceptionTag;
    let payloadOpt = this.wasm.exceptionPayload;
    if (tagOpt == null || payloadOpt == null) {
      this.#bail('exception infra missing');
    }
    let payload = payloadOpt as WasmGlobal;
    var value = this.#lowerExpressionCtx(thr.argument, payload.type);
    value = this.#conformToSlot(value, payload.type, 'throw payload type');
    this.b.emitVoid(IrOp.global_set, value,
        this.b.addRef(new IrRefGlobal(payload)));
    this.b.throwWithTag(this.#noArgs(),
        this.b.addRef(new IrRefTag(tagOpt as WasmTag)));
    this.#cx().reachable = false;
  }

  #lowerNumberLiteral(lit: NumberLiteral): i32 {
    let vt = this.#exprValType(lit);
    if (vt is ValTypeI32) {
      if (let (true, value) = parseI32(lit.raw)) {
        return this.b.constI32(value, vt);
      }
      // 0x literals only: parseI32WithHex does not guard overflow, so
      // it must never see huge DECIMAL literals (an i64-range literal
      // wrapped to -1 instead of bailing when it did).
      // Destructure-then-if: the bootstrap rejects this call inside an
      // if-let tuple pattern.
      if (lit.raw.startsWith('0x')) {
        let (hexOk, hexValue) = parseI32WithHex(lit.raw);
        if (hexOk) {
          return this.b.constI32(hexValue, vt);
        }
      }
      if (let (true, wide) = parseI64OrU64Literal(lit.raw)) {
        if (wide >= (0 as i64) && wide <= (4294967295 as i64)) {
          return this.b.constI32(wide as i32, vt);
        }
      }
      this.#bail('unparseable i32 literal');
    }
    if (vt is ValTypeI64) {
      if (let (true, value) = parseI64OrU64Literal(lit.raw)) {
        return this.b.constI64(value, vt);
      }
      this.#bail('unparseable i64 literal');
    }
    if (vt is ValTypeF64) {
      return this.b.constF64(parseF64(lit.raw), vt);
    }
    if (vt is ValTypeF32) {
      return this.b.constF32(parseF64(lit.raw), vt);
    }
    return this.#bailValue('literal type');
  }

  #lowerIdentifier(ident: Identifier): i32 {
    let sym = this.func.model.resolve(ident);
    if (sym == null) {
      this.#bail('unresolved identifier');
    }
    let resolved = (sym as Symbol).resolveTarget();
    if (!this.#cx().env.has(resolved.id)) {
      // Module-level globals read via global.get; the checked type of
      // the identifier reasserts non-nullness where the global's wasm
      // type is a nullable ref.
      if (let (true, g) = this.wasm.globalMap.get(resolved.id)) {
        let globalRef = this.b.addRef(new IrRefGlobal(g));
        let raw = this.b.emit(IrOp.global_get, g.type, -1, globalRef);
        return this.#reassertNonNull(raw, this.#exprValType(ident));
      }
      // A function referenced as a VALUE: a fresh closure pair around
      // the discovery-registered value wrapper (already
      // reference-taken for the elem section) — streaming's shape,
      // which also makes two references of one function compare
      // unequal by identity.
      let identT = this.#substitutedNodeType(ident);
      if (identT != null && identT is FunctionType) {
        let ft = identT as FunctionType;
        let isSpecialized = ft.typeArguments != null &&
            (ft.typeArguments as Array<Type>).length > 0;
        let keyName = if (isSpecialized) {
          getSpecializedName(ident.name, ft.typeArguments as Array<Type>)
        } else {
          i32ToString(resolved.id as i32)
        };
        let wrapperKey = getFunctionValueWrapperKey(keyName, ft);
        if (let (true, wrapper) = this.wasm.functionValueWrappers.get(wrapperKey)) {
          let closureStruct = getClosureStruct(this.wasm, ft);
          let funcVal = this.b.emit(IrOp.ref_func,
              closureStruct.fields[0].type, -1,
              this.b.addRef(new IrRefFunc(wrapper)));
          let nullCtx = this.b.emit(IrOp.ref_null,
              new ValTypeStructRef() as ValType, -1, -1);
          return this.b.emit(IrOp.struct_new,
              new ValTypeRef(closureStruct) as ValType,
              this.b.pushArgList(this.#twoValues(funcVal, nullCtx)),
              this.b.addRef(new IrRefType(closureStruct)));
        }
      }
      this.#bail('non-local identifier');
    }
    var value = this.#cx().env[resolved.id];
    if (this.#isCelled(resolved.id)) {
      value = this.#cellRead(value);
    }
    // Narrowing arrives as explicit coercions (ir.md §5): the checker may
    // have narrowed this reference's type at this use site — most
    // commonly `x != null` making a nullable binding non-null. Re-assert
    // non-nullness when the narrowed type demands it; subtype narrowing
    // (casts to a subclass) is not lowered yet and bails.
    let nodeType = this.func.model.getNodeType(ident);
    if (nodeType == null) {
      return value;
    }
    let wantVt = typeToValTypeWithSub(this.wasm, nodeType as Type, this.func);
    let haveVt = this.#valueType(value);
    if (valTypeIdentical(haveVt, wantVt)) {
      return value;
    }
    if (wantVt is ValTypeRef && haveVt is ValTypeRefNull) {
      let wantTarget = (wantVt as ValTypeRef).target;
      let haveTarget = (haveVt as ValTypeRefNull).target;
      if (wantTarget == haveTarget) {
        return this.b.emit(IrOp.ref_as_non_null, wantVt, value, -1);
      }
    }
    if (isValSubtype(haveVt, wantVt)) {
      // Widening (e.g. a non-null value read at a nullable type): the
      // value passes as-is under wasm subtyping.
      return value;
    }
    // Downcast narrowing: the checker's flow analysis licenses reads
    // at a SUBTYPE of the stored value's type (`x is Dog` narrowing
    // later reads to Dog). Narrowing arrives as explicit coercions
    // (ir.md §5): emit the cast at the use. Only strictly-downward
    // casts qualify — any other mismatch stays a loud bail.
    if ((wantVt is ValTypeRef || wantVt is ValTypeRefNull) &&
        isRefValType(haveVt) && isValSubtype(wantVt, haveVt)) {
      return this.b.emit(IrOp.ref_cast, wantVt, value,
          this.b.internType(wantVt));
    }
    return this.#bailValue('identifier type shift');
  }

  /** Binary operators (see ir/operators.zena). */
  #lowerBinary(bin: BinaryExpression): i32 {
    return lowerBinary(this.#cx(), bin);
  }

  /**
   * Erased-operand equality: streaming's runtime type-dispatch
   * diamond, tier for tier. Identity first (which also makes
   * null == null true); then not-ref-equal + either-null -> false;
   * then String content equality when BOTH are Strings; then each
   * REACHED Box<primitive> specialization unwraps field 1 and
   * compares at its width; anything else -> false. Operands coerce
   * anyref -> eqref first, since ref.eq requires eqref.
   */
  #unwrapFatPointer(t: Type, value: i32): i32 {
    return this.#cx().unwrapFatPointer(t, value);
  }

  /** Erased (eqref-tiered) equality (see ir/equality.zena). */
  #lowerErasedEq(leftIn: i32, rightIn: i32): i32 {
    return lowerErasedEq(this.#cx(), leftIn, rightIn);
  }

  /** Unary operators (see ir/operators.zena). */
  #lowerUnary(un: UnaryExpression): i32 {
    return lowerUnary(this.#cx(), un);
  }

  #lowerIfExpression(expr: IfExpression): i32 {
    return lowerIfExpression(this.#cx(), expr);
  }

  #lowerTryExpression(expr: TryExpression): i32 {
    return lowerTryExpression(this.#cx(), expr);
  }

  #lowerValueNode(node: Node, isVoid: boolean, ctxVt: ValType | null): i32 {
    return lowerValueNode(this.#cx(), node, isVoid, ctxVt);
  }

  // -- Match expressions -------------------------------------------------

  #lowerMatch(expr: MatchExpression): i32 {
    return lowerMatch(this.#cx(), expr);
  }

  /** Refutable tests for `pattern` (see ir/patterns.zena). */
  #lowerPatternTest(pattern: Node, value: i32, failB: i32): void {
    lowerPatternTest(this.#cx(), pattern, value, failB);
  }


  #recordDispatchRead(dispatch: RecordDispatchInfo, propName: String,
      receiver: i32): i32 {
    return this.#cx().recordDispatchRead(dispatch, propName, receiver);
  }

  /** All symbols a pattern binds (see ir/patterns.zena). */
  #collectPatternBindSyms(pattern: Node, out: Array<SymbolId>): void {
    collectPatternBindSyms(this.#cx(), pattern, out);
  }

  /** Binds `pattern`'s variables (see ir/patterns.zena). */
  #lowerPatternBindings(pattern: Node, value: i32): void {
    lowerPatternBindings(this.#cx(), pattern, value);
  }

  /**
   * Binds a pattern symbol, downcasting to the (narrowed) binding type
   * when needed — the preceding ref.test guarantees the cast succeeds.
   */
  /**
   * Values stored into a binding conform to the binding's DECLARED
   * type: env-merge params are typed from the binding, so a wider
   * value (an erased eqref flowing out of a merge-typed expression)
   * must cast down at the store — streaming's typed locals enforce
   * exactly this at local.set. Only downward ref casts qualify; any
   * other mismatch bails loudly.
   */
  #conformToSlot(value: i32, want: ValType, reason: String): i32 {
    return this.#cx().conformToSlot(value, want, reason);
  }

  #conformToBinding(value: i32, bindingVt: ValType): i32 {
    return this.#cx().conformToBinding(value, bindingVt);
  }

  #bindPatternSym(sym: Symbol, value: i32): void {
    this.#cx().bindPatternSym(sym, value);
  }

  #isCelled(symId: SymbolId): boolean {
    return this.#cx().isCelled(symId);
  }

  #cellAlloc(bindingVt: ValType, value: i32): i32 {
    return this.#cx().cellAlloc(bindingVt, value);
  }

  #cellRead(cell: i32): i32 {
    return this.#cx().cellRead(cell);
  }

  #cellWrite(cell: i32, value: i32): void {
    this.#cx().cellWrite(cell, value);
  }

  /** Whether `pattern` can fail to match (see ir/patterns.zena). */
  #patternRefutable(pattern: Node): boolean {
    return patternRefutable(this.#cx(), pattern);
  }

  /** Whether `pattern` introduces bindings (see ir/patterns.zena). */
  #patternBinds(pattern: Node): boolean {
    return patternBinds(this.#cx(), pattern);
  }

  /** Branch to `failB` unless `cond` (see ir/patterns.zena). */
  #branchUnless(cond: i32, failB: i32): void {
    branchUnless(this.#cx(), cond, failB);
  }

  /** Scalar and reference `as` casts (see ir/operators.zena). */
  #lowerAs(expr: AsExpression): i32 {
    return lowerAs(this.#cx(), expr);
  }

  /** u32/u64-typed operand test (see ir/operators.zena). */
  #isUnsignedNode(expr: Expression): boolean {
    return isUnsignedNode(this.#cx(), expr);
  }

  /**
   * `this` in an instance method: the receiver block param, re-asserted
   * non-null when the checked type demands it (receiver signature slots
   * are nullable for vtable compatibility, but `this` is never null).
   */
  #lowerThis(expr: Expression): i32 {
    if (this.#cx().thisValue < 0) {
      // NOT checker-impossible: default-parameter expressions are
      // supplied by the CALLER (desugared into the call's argument
      // list), so `this` in a default like `end = this.length - start`
      // reaches the lowering of a call site in a plain function, where
      // it means the callee's receiver. Until #lowerMethodCall binds
      // the receiver for default-argument expressions, bail.
      this.#bail('this outside instance method');
    }
    let haveVt = this.#valueType(this.#cx().thisValue);
    if (haveVt is ValTypeRefNull) {
      let want: ValType = new ValTypeRef(haveVt.target);
      return this.b.emit(IrOp.ref_as_non_null, want, this.#cx().thisValue, -1);
    }
    return this.#cx().thisValue;
  }

  #resolveSelfType(t: Type): Type {
    return this.#cx().resolveSelfType(t);
  }

  /**
   * `new C(args)` for plain (non-extension) classes: struct.new_default,
   * store the vtable when the class has one, call the constructor
   * directly. Zero-field case classes read their pre-allocated
   * singleton global instead.
   */
  #lowerNew(expr: NewExpression): i32 {
    let nodeType = this.#substitutedNodeType(expr);
    if (nodeType == null) {
      this.#bail('untyped new');
    }
    // Inside a class body, `new Point(...)` may be typed via the checker's
    // Point_This marker; resolve to the concrete class first.
    let selfResolved = this.#resolveSelfType(nodeType as Type);
    if (!(selfResolved is ClassType)) {
      this.#bail('new of non-class');
    }
    let classType = eraseTypeParameters(selfResolved);
    if (!(classType is ClassType)) {
      this.#bail('new erased kind');
    }
    let ct = classType as ClassType;
    if (ct.isExtension) {
      // Extension `new` is a plain call: the constructor takes the
      // declared arguments (no receiver) and RETURNS the underlying
      // value (streaming's extension branch in generateNewExpression).
      let ctorKey2 = getClassMethodKey(getClassKey(ct), '<constructor>');
      let ctorOpt = if (let (true, c) = this.wasm.classMethodMap.get(ctorKey2)) c else null;
      if (ctorOpt == null) {
        this.#bail('extension constructor not found');
      }
      let ctor = ctorOpt as WasmFunction;
      let sig = ctor.signature;
      if (sig.returns.length != 1 || sig.params.length != expr.args.length) {
        this.#bail('extension constructor shape');
      }
      let args = new Array<i32>();
      for (var i = 0; i < expr.args.length; i += 1) {
        this.#requireSupported(sig.params[i], 'constructor param type');
        var value = this.#lowerExpressionCtx(expr.args[i], sig.params[i]);
        value = this.#conformToSlot(value, sig.params[i], 'constructor argument type');
        args.push(value);
      }
      this.#requireSupported(sig.returns[0], 'extension constructor type');
      return this.b.callFunc(this.b.addRef(new IrRefFunc(ctor)), args,
          sig.returns[0]);
    }
    let cKey = getClassKey(ct);
    let infoOpt = if (let (true, info) = this.wasm.classInfos.get(cKey)) info else null;
    if (infoOpt == null) {
      this.#bail('class not discovered');
    }
    let classInfo = infoOpt as ClassCodegenInfo;
    let structType = classInfo.structType;
    let resultVt: ValType = new ValTypeRef(structType);

    if (classInfo.singletonGlobal != null) {
      let singleton = classInfo.singletonGlobal as WasmGlobal;
      let globalRef = this.b.addRef(new IrRefGlobal(singleton));
      let sv = this.b.emit(IrOp.global_get, singleton.type, -1, globalRef);
      this.#cx().exactValues.add(sv);
      return sv;
    }

    return this.#constructInstance(classInfo, cKey, expr.args);
  }

  /**
   * The shared construction tail of `new` and range literals:
   * struct.new_default, store the vtable when the class has one, call
   * the constructor with the given argument expressions.
   */
  #constructInstance(classInfo: ClassCodegenInfo, cKey: ClassKey,
      argExprs: Array<Expression>): i32 {
    let inst = this.#instanceShell(classInfo);

    let ctorKey = getClassMethodKey(cKey, '<constructor>');
    if (let (true, ctor) = this.wasm.classMethodMap.get(ctorKey)) {
      let sig = ctor.signature;
      if (sig.params.length != argExprs.length + 1) {
        this.#bail('constructor arity adaptation');
      }
      let args = new Array<i32>();
      args.push(inst);
      for (var i = 0; i < argExprs.length; i += 1) {
        let paramVt = sig.params[i + 1];
        this.#requireSupported(paramVt, 'constructor param type');
        var value = this.#lowerExpressionCtx(argExprs[i], paramVt);
        value = this.#conformToSlot(value, paramVt, 'constructor argument type');
        args.push(value);
      }
      let ctorRef = this.b.addRef(new IrRefFunc(ctor));
      this.b.callFunc(ctorRef, args, null);
    } else if (argExprs.length > 0) {
      this.#bail('constructor missing');
    }
    return inst;
  }

  /** struct.new_default plus the vtable store: a default-initialized
   * instance, ready for its constructor call. */
  #instanceShell(classInfo: ClassCodegenInfo): i32 {
    let structType = classInfo.structType;
    let resultVt: ValType = new ValTypeRef(structType);
    let typeRef = this.b.addRef(new IrRefType(structType));
    let inst = this.b.emit(IrOp.struct_new_default, resultVt, -1, typeRef);
    this.#cx().exactValues.add(inst);
    if (classInfo.vtableGlobal != null) {
      let vtGlobal = classInfo.vtableGlobal as WasmGlobal;
      let vtRef = this.b.addRef(new IrRefGlobal(vtGlobal));
      let vtValue = this.b.emit(IrOp.global_get, vtGlobal.type, -1, vtRef);
      let fieldRef = this.b.addRef(new IrRefField(structType, '<vtable>'));
      let pairIdx = this.b.pushExtra(this.#twoValues(inst, vtValue));
      this.b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
    }
    return inst;
  }

  /**
   * Map literals construct their checked HashMap class (shell +
   * constructor with the capacity argument) and then call `[]=` once
   * per entry — streaming's shape, including the minimum capacity.
   */
  #lowerMapLiteral(lit: MapLiteral): i32 {
    let tOpt = this.#substitutedNodeType(lit);
    if (tOpt == null) {
      this.#bail('untyped map literal');
    }
    if (!(tOpt is ClassType)) {
      this.#bail('map literal type');
    }
    let ct = tOpt as ClassType;
    let cKey = getClassKey(ct);
    let infoOpt = if (let (true, info) = this.wasm.classInfos.get(cKey)) info else null;
    if (infoOpt == null) {
      this.#bail('map class not discovered');
    }
    let ctorOpt = if (let (true, c) = this.wasm.classMethodMap.get(
        getClassMethodKey(cKey, '<constructor>'))) c else null;
    if (ctorOpt == null) {
      this.#bail('map constructor missing');
    }
    let ctor = ctorOpt as WasmFunction;
    if (ctor.signature.params.length != 2 ||
        !(ctor.signature.params[1] is ValTypeI32)) {
      this.#bail('map constructor shape');
    }
    let setOpt = if (let (true, f) = this.wasm.classMethodMap.get(
        getClassMethodKey(cKey, '[]='))) f else null;
    if (setOpt == null) {
      this.#bail('map setter missing');
    }
    let setFn = setOpt as WasmFunction;
    let setSig = setFn.signature;
    if (setSig.params.length != 3 || setSig.returns.length != 0) {
      this.#bail('map setter shape');
    }
    let inst = this.#instanceShell(infoOpt as ClassCodegenInfo);
    let capacity = if (lit.entries.length > 16) lit.entries.length else 16;
    let capValue = this.b.constI32(capacity, new ValTypeI32());
    this.b.callFunc(this.b.addRef(new IrRefFunc(ctor)),
        this.#twoValues(inst, capValue), null);
    for (let entry in lit.entries) {
      this.#requireSupported(setSig.params[1], 'map key type');
      this.#requireSupported(setSig.params[2], 'map value type');
      var key = this.#lowerExpressionCtx(entry.key, setSig.params[1]);
      key = this.#conformToSlot(key, setSig.params[1], 'map key type');
      var value = this.#lowerExpressionCtx(entry.value, setSig.params[2]);
      value = this.#conformToSlot(value, setSig.params[2], 'map value type');
      let args = new Array<i32>();
      args.push(inst);
      args.push(key);
      args.push(value);
      this.b.callFunc(this.b.addRef(new IrRefFunc(setFn)), args, null);
    }
    return inst;
  }

  /**
   * `left |> right`: the left value is an SSA value on the pipeline
   * stack; every $ inside the right side reads it directly — no
   * temporaries needed.
   */
  #lowerPipeline(pipe: PipelineExpression): i32 {
    let left = this.#lowerExpression(pipe.left);
    this.#cx().pipelineValues.push(left);
    let result = try {
      this.#lowerExpression(pipe.right)
    } catch (e) {
      this.#cx().pipelineValues.pop();
      throw e
    };
    this.#cx().pipelineValues.pop();
    return result;
  }

  #lowerPipePlaceholder(): i32 {
    if (this.#cx().pipelineValues.length == 0) {
      this.#bail('pipeline placeholder outside pipeline');
    }
    return this.#cx().pipelineValues[this.#cx().pipelineValues.length - 1];
  }

  /**
   * Range literals construct their prelude range class exactly like
   * `new`: the range form names the class (BoundedRange carries start
   * and end, FromRange start, ToRange end, FullRange nothing) and its
   * operands become the constructor arguments.
   */
  #lowerRangeExpr(expr: RangeExpression): i32 {
    let nodeType = this.#substitutedNodeType(expr);
    if (nodeType == null) {
      this.#bail('untyped range');
    }
    if (!(nodeType is ClassType)) {
      this.#bail('range of non-class');
    }
    let ct = nodeType as ClassType;
    // The range form is the AST shape itself: which bounds exist is
    // exhaustive by construction (start/end presence), so there is
    // nothing to dispatch on — the checker already resolved the class
    // for this shape, and the constructor arity check below catches
    // any operand mismatch loudly.
    let operands = new Array<Expression>();
    if (expr.start != null) {
      operands.push(expr.start as Expression);
    }
    if (expr.end != null) {
      operands.push(expr.end as Expression);
    }
    let cKey = getClassKey(ct);
    let infoOpt = if (let (true, info) = this.wasm.classInfos.get(cKey)) info else null;
    if (infoOpt == null) {
      this.#bail('range class not discovered');
    }
    return this.#constructInstance(infoOpt as ClassCodegenInfo, cKey, operands);
  }

  /**
   * Member writes: direct struct.set when the property is a physical
   * field and no transitive subclass provides a setter for it. Setter
   * dispatch and static writes bail. Compound assignments read through
   * the same receiver value, so the object expression evaluates once.
   */
  #lowerMemberAssign(assign: AssignmentExpression): i32 {
    let member = assign.left as MemberExpression;
    if (member.optional) {
      this.#bail('optional member write');
    }
    if (this.func.model.isStaticAccess(member)) {
      return this.#lowerStaticMemberWrite(assign, member);
    }
    if (member.object is SuperExpression) {
      return this.#lowerSuperWrite(assign, member);
    }
    if (assign.operator != null && (assign.operator as String) == '??') {
      return this.#lowerMemberNullishAssign(assign, member);
    }
    // Interface receivers write through the set# vtable slot.
    let objT = this.#substitutedNodeType(member.object);
    if (objT != null &&
        this.#resolveSelfType(objT as Type) is InterfaceType) {
      if (assign.operator != null) {
        this.#bail('interface compound write');
      }
      let it = this.#resolveSelfType(objT as Type) as InterfaceType;
      let propName2 = getMemberPropertyName(
          member.isSymbolAccess, member.property.name);
      let setterArgs = new Array<Expression>();
      setterArgs.push(assign.value);
      // Setter dispatch returns no value; assignment-as-expression on
      // an interface member would need the value replayed — the
      // verifier's produces-no-value check trips loudly if used.
      return this.#lowerInterfaceDispatch(
          it, 'set#' + propName2, member.object, setterArgs);
    }
    let receiver = this.#lowerExpression(member.object);
    let receiverCt = this.#receiverClass(receiver, member);
    let target = this.#resolveMemberTarget(member, receiverCt);
    if (target.fieldName == null) {
      return this.#lowerSetterWrite(assign, member, receiver, receiverCt,
          target.getter as WasmFunction, target.vtSlot != null);
    }
    let fieldName = target.fieldName as String;
    // Setter-side override checks (the read-side resolve checked get#):
    // neither a redefined setter between receiver and declarer nor a
    // transitive-subclass setter may exist for a direct struct.set.
    let propName = getMemberPropertyName(member.isSymbolAccess, member.property.name);
    let isPrivateWrite = propName.length > 0 && propName.sliceBytes(0, 1) == "#";
    var infoOpt: ClassCodegenInfo | null = null;
    if (let (true, info) = this.wasm.classInfos.get(getClassKey(receiverCt))) {
      infoOpt = info;
    }
    // A synthesized default setter on a subclass targets this same
    // physical field, so it is not an override — see
    // accessorOverriddenBySubclass. Safe to use the field-name form
    // here because this branch already established a physical field.
    if (!isPrivateWrite &&
        (this.#accessorRedefined(receiverCt, propName, 'set#' + propName) ||
         (infoOpt != null && this.#cx().accessorOverriddenBySubclass(
             infoOpt as ClassCodegenInfo, 'set#' + propName, fieldName)))) {
      // An accessor shadows the physical field somewhere between the
      // receiver and a subclass: the write must dispatch.
      return this.#lowerVirtualSetterWrite(
          assign, member, receiver, receiverCt, propName);
    }

    if (!isValSubtype(this.#valueType(receiver),
        new ValTypeRefNull(target.owner) as ValType)) {
      this.#bail('member receiver struct mismatch');
    }
    let fieldVt = this.#fieldValType(target.owner, fieldName);
    var value = -1;
    if (assign.operator == null) {
      value = this.#lowerExpressionCtx(assign.value, fieldVt);
    } else {
      let fieldRefRead = this.b.addRef(new IrRefField(target.owner, fieldName));
      let readVt = this.#exprValType(member);
      let current = this.b.emit(IrOp.struct_get, readVt, receiver, fieldRefRead);
      value = this.#combineCompound(current, assign, member as Expression);
    }
    if (!isValSubtype(this.#valueType(value), fieldVt)) {
      this.#failConformance(value, fieldVt, 'member write type');
    }
    let fieldRef = this.b.addRef(new IrRefField(target.owner, fieldName));
    let pairIdx = this.b.pushExtra(this.#twoValues(receiver, value));
    this.b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
    return value;
  }

  #fieldValType(owner: WasmStruct, name: String): ValType {
    return this.#cx().fieldValType(owner, name);
  }

  /**
   * Writes through an accessor: a direct call to a non-overridden
   * setter. Private setters resolve lexically (never virtual); public
   * setters walk the receiver's super chain (through generic sources),
   * bailing when any transitive subclass overrides the slot — the same
   * devirt-safety rule as method calls. Compound assignments read the
   * current value through the already-resolved getter, so the receiver
   * evaluates once.
   */
  #lowerSetterWrite(assign: AssignmentExpression, member: MemberExpression,
      receiver: i32, receiverCt: ClassType, getter: WasmFunction,
      getterVirtual: boolean): i32 {
    let propName = getMemberPropertyName(
        member.isSymbolAccess, member.property.name);
    let isPrivate = propName.length > 0 && propName.sliceBytes(0, 1) == "#";
    var setterVirtual = false;
    var vtInfoOpt: ClassCodegenInfo | null = null;
    var setterOpt: WasmFunction | null = null;
    if (isPrivate) {
      if (this.func.classType == null) {
        this.#bail('private access outside class');
      }
      let lexicalCt = this.#lexicalClassOf(member, receiverCt);
      setterOpt = this.#resolvePrivateAccessor(
          receiverCt, lexicalCt, 'set#' + propName);
    } else {
      var currClass: ClassType | null = receiverCt;
      while (currClass != null && setterOpt == null) {
        var g: ClassType | null = currClass;
        while (g != null && setterOpt == null) {
          let key = getClassMethodKey(
              getClassKey(g as ClassType), 'set#' + propName);
          if (let (true, f) = this.wasm.classMethodMap.get(key)) {
            setterOpt = f;
          }
          g = (g as ClassType).genericSource;
        }
        currClass = (currClass as ClassType).superType;
      }
      if (let (true, info) = this.wasm.classInfos.get(getClassKey(receiverCt))) {
        vtInfoOpt = info;
        if (this.#cx().memberProvidedBySubclass(info, 'set#' + propName)) {
          // A subclass overrides the setter: the write must dispatch.
          if (this.#vtableSlotIndex(info, 'set#' + propName) < 0) {
            this.#bail('overridden setter without vtable slot');
          }
          setterVirtual = true;
        }
      }
    }
    if (setterOpt == null) {
      this.#bail('setter not found');
    }
    let setter = setterOpt as WasmFunction;
    if (setter.isStatic ||
        (setter.typeParameters != null && setter.typeArguments == null) ||
        setter.intrinsic != null) {
      this.#bail('setter shape');
    }
    let sig = setter.signature;
    if (sig.params.length != 2 || sig.returns.length != 0) {
      this.#bail('setter shape');
    }
    if (!isValSubtype(this.#valueType(receiver), sig.params[0])) {
      this.#failConformance(receiver, sig.params[0], 'setter receiver type');
    }
    let valueVt = sig.params[1];
    this.#requireSupported(valueVt, 'setter param type');
    var value = -1;
    if (assign.operator == null) {
      value = this.#lowerExpressionCtx(assign.value, valueVt);
    } else {
      let gsig = getter.signature;
      if (gsig.returns.length != 1) {
        this.#bail('getter shape');
      }
      var current = if (getterVirtual) {
        this.#lowerVtableCall(receiver, vtInfoOpt as ClassCodegenInfo,
            'get#' + propName, gsig, this.#oneArg(receiver), gsig.returns[0])
      } else {
        this.b.callFunc(this.b.addRef(new IrRefFunc(getter)),
            this.#oneArg(receiver), gsig.returns[0])
      };
      current = this.#reassertNonNull(current, this.#exprValType(member));
      value = this.#combineCompound(current, assign, member as Expression);
    }
    if (!isValSubtype(this.#valueType(value), valueVt)) {
      this.#failConformance(value, valueVt, 'setter value type');
    }
    let args = new Array<i32>();
    args.push(receiver);
    args.push(value);
    if (setterVirtual) {
      this.#lowerVtableCall(receiver, vtInfoOpt as ClassCodegenInfo,
          'set#' + propName, sig, args, null);
    } else {
      this.b.callFunc(this.b.addRef(new IrRefFunc(setter)), args, null);
    }
    return value;
  }

  /**
   * A write whose physical field is shadowed by an accessor somewhere
   * between the receiver and a subclass: resolve the nearest default
   * setter for the slot signature and dispatch through the vtable.
   * Compound assignments read the current value through the get# slot.
   */
  #lowerVirtualSetterWrite(assign: AssignmentExpression,
      member: MemberExpression, receiver: i32, receiverCt: ClassType,
      propName: String): i32 {
    var infoOpt: ClassCodegenInfo | null = null;
    if (let (true, info) = this.wasm.classInfos.get(getClassKey(receiverCt))) {
      infoOpt = info;
    }
    if (infoOpt == null) {
      this.#bail('method receiver not discovered');
    }
    let info = infoOpt as ClassCodegenInfo;
    if (this.#vtableSlotIndex(info, 'set#' + propName) < 0) {
      this.#bail('overridden field without setter slot');
    }
    var setterOpt: WasmFunction | null = null;
    var currClass: ClassType | null = receiverCt;
    while (currClass != null && setterOpt == null) {
      var g: ClassType | null = currClass;
      while (g != null && setterOpt == null) {
        let key = getClassMethodKey(
            getClassKey(g as ClassType), 'set#' + propName);
        if (let (true, f) = this.wasm.classMethodMap.get(key)) {
          setterOpt = f;
        }
        g = (g as ClassType).genericSource;
      }
      currClass = (currClass as ClassType).superType;
    }
    if (setterOpt == null) {
      this.#bail('overridden field without setter slot');
    }
    let setter = setterOpt as WasmFunction;
    let sig = setter.signature;
    if (sig.params.length != 2 || sig.returns.length != 0) {
      this.#bail('setter shape');
    }
    let valueVt = sig.params[1];
    this.#requireSupported(valueVt, 'setter param type');
    var value = -1;
    if (assign.operator == null) {
      value = this.#lowerExpressionCtx(assign.value, valueVt);
    } else {
      if (this.#vtableSlotIndex(info, 'get#' + propName) < 0) {
        this.#bail('overridden field without getter slot');
      }
      var getterOpt: WasmFunction | null = null;
      var gc: ClassType | null = receiverCt;
      while (gc != null && getterOpt == null) {
        let key = getClassMethodKey(
            getClassKey(gc as ClassType), 'get#' + propName);
        if (let (true, g) = this.wasm.classMethodMap.get(key)) {
          getterOpt = g;
        }
        gc = (gc as ClassType).superType;
      }
      if (getterOpt == null) {
        this.#bail('overridden field without getter slot');
      }
      let gsig = (getterOpt as WasmFunction).signature;
      if (gsig.returns.length != 1) {
        this.#bail('getter shape');
      }
      var current = this.#lowerVtableCall(receiver, info,
          'get#' + propName, gsig, this.#oneArg(receiver), gsig.returns[0]);
      current = this.#reassertNonNull(current, this.#exprValType(member));
      value = this.#combineCompound(current, assign, member as Expression);
    }
    if (!isValSubtype(this.#valueType(value), valueVt)) {
      this.#failConformance(value, valueVt, 'setter value type');
    }
    let args = new Array<i32>();
    args.push(receiver);
    args.push(value);
    this.#lowerVtableCall(receiver, info, 'set#' + propName, sig, args, null);
    return value;
  }

  /**
   * Member reads on class-typed receivers: a direct struct.get when the
   * property is a physical field on the receiver's struct and no
   * subclass overrides its accessor; otherwise a direct call to a
   * non-overridden getter. Interfaces, statics, optional chains, and
   * anything needing dynamic dispatch bail.
   */
  #lowerMemberRead(member: MemberExpression): i32 {
    if (member.optional) {
      return this.#lowerOptionalChainExpr(member as Expression);
    }
    let objectType = this.#substitutedNodeType(member.object);
    // Enum member access lowers to a constant, mirroring the
    // streaming backend: numeric members inline their (implicit or
    // literal) value, string-enum members their string literal. The
    // enum "namespace" identifier itself is never lowered.
    if (objectType != null && baseType(objectType as Type) is RecordType) {
      let rt = baseType(objectType as Type) as RecordType;
      if (rt.enumDeclaration != null) {
        return this.#lowerEnumMember(
            rt.enumDeclaration as EnumDeclaration, member);
      }
      return this.#lowerRecordRead(rt, member);
    }
    if (objectType != null &&
        this.#resolveSelfType(objectType as Type) is InterfaceType) {
      if (this.func.model.isStaticAccess(member)) {
        this.#bail('static interface access');
      }
      let it = this.#resolveSelfType(objectType as Type) as InterfaceType;
      let propName = getMemberPropertyName(
          member.isSymbolAccess, member.property.name);
      let result = this.#lowerInterfaceDispatch(
          it, 'get#' + propName, member.object, null);
      return this.#reassertNonNull(result, this.#exprValType(member));
    }
    if (objectType != null && this.func.model.isStaticAccess(member)) {
      let selfR = this.#resolveSelfType(objectType as Type);
      if (selfR is ClassType) {
        return this.#lowerStaticMemberRead(
            member, eraseTypeParameters(selfR) as ClassType);
      }
    }
    if (member.object is SuperExpression) {
      return this.#lowerSuperRead(member);
    }
    let receiver = this.#lowerExpression(member.object);
    return this.#lowerMemberReadOn(member, receiver);
  }

  /**
   * The superclass of the enclosing method's class: the resolution
   * root for every `super` access. Super dispatch is static — it
   * names the superclass's implementation directly and never goes
   * through the vtable, which would loop back to the override.
   */
  #superClassOfThis(): ClassType {
    if (this.func.classType == null) {
      this.#bail('super outside instance method');
    }
    let ct = this.func.classType as ClassType;
    if (ct.superType == null) {
      this.#bail('super without superclass');
    }
    return ct.superType as ClassType;
  }

  /**
   * `super.prop`: a non-static getter registered on the superclass
   * chain wins (called directly); otherwise the property is a plain
   * field read against the superclass struct — `this` is a subtype of
   * it, so the read needs no cast.
   */
  #lowerSuperRead(member: MemberExpression): i32 {
    let superCt = this.#superClassOfThis();
    let receiver = this.#lowerThis(member as Expression);
    let propName = getMemberPropertyName(
        member.isSymbolAccess, member.property.name);
    var getterOpt: WasmFunction | null = null;
    var curr: ClassType | null = superCt;
    while (curr != null && getterOpt == null) {
      var g: ClassType | null = curr;
      while (g != null && getterOpt == null) {
        let key = getClassMethodKey(
            getClassKey(g as ClassType), 'get#' + propName);
        if (let (true, f) = this.wasm.classMethodMap.get(key)) {
          if (!f.isStatic) {
            getterOpt = f;
          }
        }
        g = (g as ClassType).genericSource;
      }
      curr = (curr as ClassType).superType;
    }
    if (getterOpt != null) {
      let getter = getterOpt as WasmFunction;
      let sig = getter.signature;
      if (sig.params.length != 1 || sig.returns.length != 1) {
        this.#bail('super getter shape');
      }
      if (!isValSubtype(this.#valueType(receiver), sig.params[0])) {
        this.#failConformance(receiver, sig.params[0],
            'super receiver type');
      }
      this.#requireSupported(sig.returns[0], 'super getter type');
      let result = this.b.callFunc(
          this.b.addRef(new IrRefFunc(getter)),
          this.#oneArg(receiver), sig.returns[0]);
      return this.#reassertNonNull(result, this.#exprValType(member));
    }
    let cKey = getClassKey(superCt);
    let infoOpt = if (let (true, info) = this.wasm.classInfos.get(cKey)) info else null;
    if (infoOpt == null) {
      this.#bail('super class not discovered');
    }
    let st = (infoOpt as ClassCodegenInfo).structType;
    if (st.fieldIndexByName(propName) < 0) {
      this.#bail('super member not found');
    }
    let fieldRef = this.b.addRef(new IrRefField(st, propName));
    let read = this.b.emit(IrOp.struct_get,
        this.#fieldValType(st, propName), receiver, fieldRef);
    return this.#reassertNonNull(read, this.#exprValType(member));
  }

  /**
   * `super.prop = v`: a non-static setter on the superclass chain wins
   * (called directly, never through the vtable); otherwise the write
   * is a plain struct.set against the superclass struct. Compound
   * assignments read the current value through the super read path.
   */
  /**
   * `recv.field ??= rhs`: read the field once; keep it when non-null,
   * else evaluate rhs (short-circuit), store it, and yield it —
   * physical fields only, matching streaming's member nullish write.
   */
  #lowerMemberNullishAssign(assign: AssignmentExpression,
      member: MemberExpression): i32 {
    let receiver = this.#lowerExpression(member.object);
    let receiverCt = this.#receiverClass(receiver, member);
    let target = this.#resolveMemberTarget(member, receiverCt);
    if (target.fieldName == null || target.vtSlot != null) {
      this.#bail('nullish member assign target');
    }
    let fieldName = target.fieldName as String;
    let fieldVt = this.#fieldValType(target.owner, fieldName);
    if (!(fieldVt is ValTypeRefNull)) {
      this.#bail('nullish member assign type');
    }
    let readRef = this.b.addRef(new IrRefField(target.owner, fieldName));
    let current = this.b.emit(IrOp.struct_get, fieldVt, receiver, readRef);
    let resultVt = this.#exprValType(assign as Expression);
    let isNull = this.b.emit(IrOp.ref_is_null, new ValTypeI32(), current, -1);
    let writeB = this.b.newBlock();
    let keepB = this.b.newBlock();
    let merge = this.b.newBlock();
    let result = this.b.blockParam(merge, resultVt);
    this.b.brIf(isNull, writeB, this.#noArgs(), keepB, this.#noArgs());
    // The keep-path conform narrows nullable -> non-null, so it MUST
    // sit in its own arm: emitted before the branch it would trap on
    // exactly the null values the write arm exists to handle.
    this.b.switchTo(keepB);
    let keep = this.#conformToSlot(current, resultVt, 'nullish member value');
    this.b.br(merge, this.#oneArg(keep));
    this.b.switchTo(writeB);
    var rhs = this.#lowerExpressionCtx(assign.value, fieldVt);
    rhs = this.#conformToSlot(rhs, fieldVt, 'member write type');
    let writeRef = this.b.addRef(new IrRefField(target.owner, fieldName));
    let pairIdx = this.b.pushExtra(this.#twoValues(receiver, rhs));
    this.b.emitVoid(IrOp.struct_set, pairIdx, writeRef);
    let stored = this.#conformToSlot(rhs, resultVt, 'nullish member value');
    this.b.br(merge, this.#oneArg(stored));
    this.b.switchTo(merge);
    return result;
  }

  #lowerSuperWrite(assign: AssignmentExpression,
      member: MemberExpression): i32 {
    let superCt = this.#superClassOfThis();
    let receiver = this.#lowerThis(member as Expression);
    let propName = getMemberPropertyName(
        member.isSymbolAccess, member.property.name);
    var setterOpt: WasmFunction | null = null;
    var curr: ClassType | null = superCt;
    while (curr != null && setterOpt == null) {
      var g: ClassType | null = curr;
      while (g != null && setterOpt == null) {
        let key = getClassMethodKey(
            getClassKey(g as ClassType), 'set#' + propName);
        if (let (true, f) = this.wasm.classMethodMap.get(key)) {
          if (!f.isStatic) {
            setterOpt = f;
          }
        }
        g = (g as ClassType).genericSource;
      }
      curr = (curr as ClassType).superType;
    }
    var targetVt: ValType = new ValTypeI32();
    var fieldStruct: WasmStruct | null = null;
    if (setterOpt != null) {
      let sig = (setterOpt as WasmFunction).signature;
      if (sig.params.length != 2 || sig.returns.length != 0) {
        this.#bail('super setter shape');
      }
      targetVt = sig.params[1];
    } else {
      let infoOpt = if (let (true, info) = this.wasm.classInfos.get(getClassKey(superCt))) info else null;
      if (infoOpt == null) {
        this.#bail('super class not discovered');
      }
      let st = (infoOpt as ClassCodegenInfo).structType;
      if (st.fieldIndexByName(propName) < 0) {
        this.#bail('super member not found');
      }
      fieldStruct = st;
      targetVt = this.#fieldValType(st, propName);
    }
    this.#requireSupported(targetVt, 'super write type');
    var value = -1;
    if (assign.operator == null) {
      value = this.#lowerExpressionCtx(assign.value, targetVt);
    } else {
      let current = this.#lowerSuperRead(member);
      value = this.#combineCompound(current, assign, member as Expression);
    }
    if (!isValSubtype(this.#valueType(value), targetVt)) {
      this.#failConformance(value, targetVt, 'super write type');
    }
    if (setterOpt != null) {
      let setter = setterOpt as WasmFunction;
      if (!isValSubtype(this.#valueType(receiver), setter.signature.params[0])) {
        this.#failConformance(receiver, setter.signature.params[0],
            'super receiver type');
      }
      this.b.callFunc(this.b.addRef(new IrRefFunc(setter)),
          this.#twoValues(receiver, value), null);
      return value;
    }
    let st = fieldStruct as WasmStruct;
    let fieldRef = this.b.addRef(new IrRefField(st, propName));
    let pairIdx = this.b.pushExtra(this.#twoValues(receiver, value));
    this.b.emitVoid(IrOp.struct_set, pairIdx, fieldRef);
    return value;
  }

  /**
   * `super.m(...)`: resolve the method on the superclass chain
   * (overload slots via the checker's recorded selection, shared
   * generic templates via the genericSource walk) and call it
   * directly with `this` as the receiver.
   */
  #lowerSuperMethodCall(call: CallExpression, member: MemberExpression,
      multiOut: Array<i32> | null): i32 {
    let superCt = this.#superClassOfThis();
    let receiver = this.#lowerThis(member.object);
    let propName = getMemberPropertyName(
        member.isSymbolAccess, member.property.name);
    if (propName.length > 0 && propName.sliceBytes(0, 1) == '#') {
      this.#bail('super private call');
    }
    let chosenFt = this.func.model.getResolvedOverload(call);
    let slotName = if (chosenFt != null) {
      propName + getSignatureKey(chosenFt as FunctionType)
    } else {
      propName
    };
    var methodOpt: WasmFunction | null = null;
    var currClass: ClassType | null = superCt;
    while (currClass != null && methodOpt == null) {
      var g: ClassType | null = currClass;
      while (g != null && methodOpt == null) {
        let key = getClassMethodKey(getClassKey(g as ClassType), slotName);
        if (let (true, m) = this.wasm.classMethodMap.get(key)) {
          methodOpt = m;
        }
        g = (g as ClassType).genericSource;
      }
      currClass = (currClass as ClassType).superType;
    }
    if (methodOpt == null) {
      this.#bail('super method not found');
    }
    let method = methodOpt as WasmFunction;
    if (method.isStatic ||
        (method.typeParameters != null && method.typeArguments == null) ||
        method.intrinsic != null) {
      this.#bail('super method shape');
    }
    let sig = method.signature;
    if (sig.returns.length > 1) {
      this.#bail('super multi-value call');
    }
    if (multiOut != null) {
      this.#bail('super call in multi-value position');
    }
    if (sig.params.length != call.args.length + 1) {
      this.#bail('super method arity');
    }
    if (!isValSubtype(this.#valueType(receiver), sig.params[0])) {
      this.#failConformance(receiver, sig.params[0], 'super receiver type');
    }
    let args = new Array<i32>();
    args.push(receiver);
    for (var i = 0; i < call.args.length; i += 1) {
      let paramVt = sig.params[i + 1];
      this.#requireSupported(paramVt, 'super param type');
      var value = this.#lowerExpressionCtx(call.args[i], paramVt);
      value = this.#conformToSlot(value, paramVt, 'super argument type');
      args.push(value);
    }
    let resultType = if (sig.returns.length == 1) sig.returns[0] else null;
    if (resultType != null) {
      this.#requireSupported(resultType, 'super result type');
    }
    let result = this.b.callFunc(
        this.b.addRef(new IrRefFunc(method)), args, resultType);
    if (resultType != null) {
      let nodeType = this.func.model.getNodeType(call);
      if (nodeType != null && !(baseType(nodeType as Type) is VoidType)) {
        let want = typeToValTypeWithSub(this.wasm, nodeType as Type, this.func);
        if (want is ValTypeRef && (resultType as ValType) is ValTypeRefNull) {
          return this.b.emit(IrOp.ref_as_non_null, want, result, -1);
        }
      }
    }
    return result;
  }


  /**
   * Static member writes: the field's module global, with compound
   * assignments reading the same global first. Static setters bail.
   */
  #lowerStaticMemberWrite(assign: AssignmentExpression,
      member: MemberExpression): i32 {
    let objectType = this.#substitutedNodeType(member.object);
    if (objectType == null) {
      this.#bail('untyped static receiver');
    }
    let selfR = this.#resolveSelfType(objectType as Type);
    if (!(selfR is ClassType)) {
      this.#bail('static receiver kind');
    }
    let ct = eraseTypeParameters(selfR) as ClassType;
    let propName = getMemberPropertyName(
        member.isSymbolAccess, member.property.name);
    let gOpt = this.#staticFieldGlobal(ct, propName);
    if (gOpt == null) {
      this.#bail('static member not found');
    }
    let g = gOpt as WasmGlobal;
    var value = -1;
    if (assign.operator == null) {
      value = this.#lowerExpressionCtx(assign.value, g.type);
    } else {
      let current = this.b.emit(IrOp.global_get, g.type, -1,
          this.b.addRef(new IrRefGlobal(g)));
      value = this.#combineCompound(current, assign, member as Expression);
    }
    if (!isValSubtype(this.#valueType(value), g.type)) {
      this.#failConformance(value, g.type, 'global write type');
    }
    this.b.emitVoid(IrOp.global_set, value,
        this.b.addRef(new IrRefGlobal(g)));
    return value;
  }

  /**
   * Static member reads: a static getter registered in the class
   * hierarchy wins; otherwise the field's module global (named
   * '<ClassName>_<prop>'), cast to the member's checked type when the
   * global's declared type is wider — streaming's shape.
   */
  #lowerStaticMemberRead(member: MemberExpression, ct: ClassType): i32 {
    let propName = getMemberPropertyName(
        member.isSymbolAccess, member.property.name);
    var getterOpt: WasmFunction | null = null;
    var currClass: ClassType | null = ct;
    while (currClass != null && getterOpt == null) {
      let key = getClassMethodKey(
          getClassKey(currClass as ClassType), 'get#' + propName);
      if (let (true, f) = this.wasm.classMethodMap.get(key)) {
        if (f.isStatic) {
          getterOpt = f;
        }
      }
      currClass = (currClass as ClassType).superType;
    }
    if (getterOpt != null) {
      let getter = getterOpt as WasmFunction;
      let sig = getter.signature;
      if (sig.params.length != 0 || sig.returns.length != 1) {
        this.#bail('static getter shape');
      }
      let call = this.b.callFunc(this.b.addRef(new IrRefFunc(getter)),
          this.#noArgs(), sig.returns[0]);
      return this.#reassertNonNull(call, this.#exprValType(member));
    }
    let gOpt = this.#staticFieldGlobal(ct, propName);
    if (gOpt == null) {
      this.#bail('static member not found');
    }
    let g = gOpt as WasmGlobal;
    let raw = this.b.emit(IrOp.global_get, g.type, -1,
        this.b.addRef(new IrRefGlobal(g)));
    let want = this.#exprValType(member);
    if (valTypeEquals(g.type, want)) {
      return raw;
    }
    if (isRefValType(want) && isRefValType(g.type)) {
      if (isValSubtype(g.type, want)) {
        return this.#reassertNonNull(raw, want);
      }
      return this.b.emit(IrOp.ref_cast, want, raw, this.b.internType(want));
    }
    return this.#bailValue('static member type');
  }

  /** The module global backing a static field, walking the supers. */
  #staticFieldGlobal(ct: ClassType, propName: String): WasmGlobal | null {
    var currClass: ClassType | null = ct;
    while (currClass != null) {
      let wanted = (currClass as ClassType).name + '_' + propName;
      for (let g in this.wasm.globals) {
        if (g.name == wanted) {
          return g;
        }
      }
      currClass = (currClass as ClassType).superType;
    }
    return null;
  }

  /**
   * The receiver-value core of a member read: array .length, then
   * field / non-overridden getter resolution against the receiver's
   * class. Shared by the plain path and the optional-chain hit arm.
   */
  #lowerMemberReadOn(member: MemberExpression, receiver: i32): i32 {
    // .length on wasm-array receivers: array.len (mirrors the
    // FixedArray length intrinsic in the streaming backend).
    let recvArr = asWasmArray(this.#valueType(receiver));
    if (recvArr != null) {
      let arrProp = getMemberPropertyName(
          member.isSymbolAccess, member.property.name);
      if (arrProp == "length") {
        return this.b.emit(IrOp.array_len, new ValTypeI32(), receiver, -1);
      }
      // An extension class on the array type owns other members:
      // extensions have no fields or vtable, so the target is always
      // a getter called directly with the array value as receiver.
      let objectType = this.#substitutedNodeType(member.object);
      var extCt: ClassType | null = null;
      if (objectType != null) {
        let selfR = this.#resolveSelfType(objectType as Type);
        if (selfR is ClassType && (selfR as ClassType).isExtension) {
          extCt = eraseTypeParameters(selfR) as ClassType;
        }
      }
      if (extCt == null) {
        this.#bail('array member');
      }
      let extTarget = this.#resolveMemberTarget(member, extCt as ClassType);
      if (extTarget.fieldName != null || extTarget.vtSlot != null ||
          extTarget.getter == null) {
        this.#bail('array member');
      }
      let extGetter = extTarget.getter as WasmFunction;
      let egSig = extGetter.signature;
      if (egSig.params.length != 1 || egSig.returns.length != 1) {
        this.#bail('getter shape');
      }
      if (!isValSubtype(this.#valueType(receiver), egSig.params[0])) {
        this.#failConformance(receiver, egSig.params[0],
            'member receiver type');
      }
      let extCall = this.b.callFunc(this.b.addRef(new IrRefFunc(extGetter)),
          this.#oneArg(receiver), egSig.returns[0]);
      return this.#reassertNonNull(extCall, this.#exprValType(member));
    }
    let receiverCt = this.#receiverClass(receiver, member);
    let target = this.#resolveMemberTarget(member, receiverCt);
    let receiverVt = this.#valueType(receiver);
    let isStructRef = receiverVt is ValTypeRef || receiverVt is ValTypeRefNull;
    if (!isStructRef) {
      this.#bail('member receiver kind');
    }
    // The receiver value must actually be (a subtype of) the struct the
    // member resolved against — mismatched specialization keys (e.g.
    // intrinsic array classes) would otherwise emit invalid struct.gets.
    // Extension receivers are exempt: their getters take the onType
    // value, checked at the call below.
    if (!receiverCt.isExtension &&
        !isValSubtype(receiverVt,
        new ValTypeRefNull(target.owner) as ValType)) {
      this.#bail('member receiver struct mismatch');
    }
    if (target.vtSlot != null) {
      let vgetter = target.getter as WasmFunction;
      let vsig = vgetter.signature;
      if (vsig.returns.length != 1) {
        this.#bail('getter shape');
      }
      let vresult = this.#lowerVtableCall(receiver,
          target.vtInfo as ClassCodegenInfo, target.vtSlot as String,
          vsig, this.#oneArg(receiver), vsig.returns[0]);
      return this.#reassertNonNull(vresult, this.#exprValType(member));
    }
    if (target.fieldName != null) {
      let fieldName = target.fieldName as String;
      let fieldRef = this.b.addRef(new IrRefField(target.owner, fieldName));
      // The struct.get result carries the field's STORAGE type; the
      // member's checked type may be narrower (non-null).
      let fieldVt = this.#fieldValType(target.owner, fieldName);
      let read = this.b.emit(IrOp.struct_get, fieldVt, receiver, fieldRef);
      return this.#reassertNonNull(read, this.#exprValType(member));
    }
    let getter = target.getter as WasmFunction;
    let sig = getter.signature;
    if (sig.returns.length != 1) {
      this.#bail('getter shape');
    }
    if (!isValSubtype(this.#valueType(receiver), sig.params[0])) {
      this.#failConformance(receiver, sig.params[0], 'member receiver type');
    }
    let getterRef = this.b.addRef(new IrRefFunc(getter));
    let call = this.b.callFunc(getterRef, this.#oneArg(receiver), sig.returns[0]);
    // Getter signatures return the field's (nullable) storage type; the
    // member's checked type may be non-null.
    return this.#reassertNonNull(call, this.#exprValType(member));
  }

  /**
   * A ref-typed value with the null stripped from its type: the raw
   * value when already non-null, else a re-asserted copy.
   */
  #strippedNonNull(value: i32): i32 {
    return this.#cx().stripNonNull(value);
  }

  #lowerChainReceiver(obj: Expression): i32 {
    return this.#cx().chainReceiver(obj);
  }

  /**
   * The hit arm of an optional-chain access: the access itself,
   * performed on the already-null-checked receiver value.
   */
  #lowerOptionalHit(expr: Expression, receiver: i32): i32 {
    if (expr is MemberExpression) {
      let member = expr as MemberExpression;
      let objectType = this.#substitutedNodeType(member.object);
      if (objectType != null) {
        let nonNull = baseType(getNonNullableType(objectType as Type));
        if (nonNull is RecordType) {
          return this.#lowerRecordReadOn(nonNull as RecordType, member, receiver);
        }
      }
      return this.#lowerMemberReadOn(member, receiver);
    }
    if (expr is IndexExpression) {
      let idx = expr as IndexExpression;
      let objectType = this.#substitutedNodeType(idx.object);
      if (objectType == null) {
        this.#bail('untyped index receiver');
      }
      let selfResolved = this.#resolveSelfType(
          getNonNullableType(objectType as Type));
      return this.#lowerIndexReadOn(idx, selfResolved, receiver);
    }
    return this.#lowerClosureCallOn(expr as CallExpression, receiver);
  }

  /**
   * A standalone optional-chain access (`obj?.prop`, `arr?[i]`,
   * `fn?()`): the receiver evaluates once; null short-circuits to a
   * null result of the access's checked (nullable) type. Accesses
   * producing primitives would need a boxed `T | null`, which
   * lowering does not model — those bail (a fused `?? rhs` handles
   * them via #lowerNullishCoalesce instead).
   */
  #lowerOptionalChainExpr(expr: Expression): i32 {
    let exprVt = this.#exprValType(expr);
    if (!isRefValType(exprVt)) {
      this.#bail('optional primitive result');
    }
    let receiver0 = this.#lowerChainReceiver(this.#cx().optionalChainObject(expr));
    if (!isRefValType(this.#valueType(receiver0))) {
      this.#bail('optional receiver kind');
    }
    let isNull = this.b.emit(
        IrOp.ref_is_null, new ValTypeI32() as ValType, receiver0, -1);
    let nullB = this.b.newBlock();
    let okB = this.b.newBlock();
    this.b.brIf(isNull, nullB, this.#noArgs(), okB, this.#noArgs());

    let mergeB = this.b.newBlock();
    let resultParam = this.b.blockParam(mergeB, exprVt);

    this.b.switchTo(okB);
    let value = this.#lowerOptionalHit(expr, this.#strippedNonNull(receiver0));
    if (!isValSubtype(this.#valueType(value), exprVt)) {
      this.#bail('optional chain type');
    }
    this.b.br(mergeB, this.#oneArg(value));

    this.b.switchTo(nullB);
    let nullValue = this.#nullDefault(exprVt);
    this.b.br(mergeB, this.#oneArg(nullValue));

    this.b.switchTo(mergeB);
    this.#cx().reachable = true;
    return resultParam;
  }

  /** A null constant conforming to a (nullable) reference valtype. */
  #nullDefault(vt: ValType): i32 {
    return this.b.emit(IrOp.ref_null, vt, -1, -1);
  }

  /**
   * Devirtualized method calls only: the receiver's class (or an
   * ancestor) provides the method, no transitive subclass overrides it,
   * the name resolves directly (overloads use mangled keys and miss),
   * and arity matches exactly. Everything else — statics, interfaces,
   * generic methods, optional calls, dynamic dispatch — bails.
   */
  #lowerMethodCall(call: CallExpression, member: MemberExpression,
      multiOut: Array<i32> | null = null): i32 {
    if (member.optional || call.optional) {
      this.#bail('optional method call');
    }
    if (this.func.model.isStaticAccess(member)) {
      return this.#lowerStaticCall(call, member, multiOut);
    }
    if (member.object is SuperExpression) {
      return this.#lowerSuperMethodCall(call, member, multiOut);
    }
    let objectType = this.#substitutedNodeType(member.object);
    if (objectType == null) {
      this.#bail('untyped method receiver');
    }
    // Record-typed receivers (including namespace imports, which are
    // record globals of the module's exports): the member is a field
    // holding a function value — read it, call the closure pair.
    if (baseType(objectType as Type) is RecordType) {
      let rt = baseType(objectType as Type) as RecordType;
      let recv = this.#lowerExpression(member.object);
      let fnValue = this.#lowerRecordReadOn(rt, member, recv);
      return this.#lowerClosureCallOn(call, fnValue);
    }
    let selfResolved = this.#resolveSelfType(objectType as Type);
    if (selfResolved is InterfaceType) {
      let propName = getMemberPropertyName(
          member.isSymbolAccess, member.property.name);
      let result = this.#lowerInterfaceDispatch(
          selfResolved as InterfaceType, propName, member.object,
          call.args, multiOut);
      if (multiOut != null && (multiOut as Array<i32>).length > 1) {
        // Multi-value results have no single checked type to
        // re-assert against; the projections carry their slot types.
        return result;
      }
      return this.#reassertCallResult(call, result,
          this.b.body.resultType(result));
    }
    // Extension methods on arrays (map/fold/indexOf/...): resolved
    // by element-type specialization key against wasm.arrayMethods,
    // mirroring the streaming backend. The callee may itself be
    // streaming-compiled (the synthesized map/fold bodies) — both
    // backends share one module, so cross-backend calls are plain
    // direct calls.
    var arrayElem: Type | null = null;
    match (selfResolved) {
      case ArrayType as at: { arrayElem = at.elementType; }
      case ClassType as arrCt: {
        if (arrCt.name == "array" && arrCt.typeArguments != null &&
            (arrCt.typeArguments as Array<Type>).length > 0) {
          arrayElem = (arrCt.typeArguments as Array<Type>)[0];
        }
      }
      case _: {}
    }
    if (arrayElem != null) {
      return this.#lowerArrayExtensionCall(call, member, arrayElem as Type);
    }
    if (!(selfResolved is ClassType)) {
      this.#bail('method receiver kind');
    }
    // Resolve against the class the receiver VALUE carries: checked
    // node types name the GENERIC class inside specialized-method
    // bodies, but specialized methods register under their own key.
    let receiver = this.#lowerExpression(member.object);
    var ct = eraseTypeParameters(selfResolved) as ClassType;
    let fromValue = this.#classTypeOfValue(receiver);
    if (fromValue != null && !ct.isExtension) {
      ct = fromValue as ClassType;
    }
    let cKey = getClassKey(ct);
    let infoOpt = if (let (true, info) = this.wasm.classInfos.get(cKey)) info else null;
    if (infoOpt == null) {
      this.#bail('method receiver not discovered');
    }
    let classInfo = infoOpt as ClassCodegenInfo;
    let propName = getMemberPropertyName(member.isSymbolAccess, member.property.name);
    // One namespace, one lookup: the checker's member info names the
    // KIND. A field holding a function value is a member read plus a
    // closure call — decided here, before method resolution, never as
    // a fallback to a failed method lookup.
    if (let (true, kindInfo) = ct.members.get(propName)) {
      if (kindInfo is FieldInfo) {
        if (!(kindInfo.type is FunctionType)) {
          this.#bail('call of non-function field');
        }
        // A field whose name shadows an inherited METHOD has no
        // settled semantics (streaming resolves the call to the base
        // method; the checker accepts the declaration silently — see
        // BUGS.md). Refuse to pick a side.
        var superWalk: ClassType | null = ct.superType;
        while (superWalk != null) {
          if (let (true, superInfo) = (superWalk as ClassType).members.get(propName)) {
            if (superInfo is MethodInfo) {
              this.#bail('field shadows inherited method');
            }
          }
          superWalk = (superWalk as ClassType).superType;
        }
        if (multiOut != null) {
          this.#bail('closure call in multi-value position');
        }
        let calleeValue = this.#lowerMemberReadOn(member, receiver);
        return this.#lowerClosureCallOn(call, calleeValue);
      }
    }
    // Overloaded methods register under per-signature slot names; the
    // checker records its (static, subtype-sensitive) selection per
    // call node, and we reproduce the exact slot name from it. When a
    // record exists, ONLY that slot is acceptable — a plain-name
    // fallback could bind a different overload.
    let chosenFt = this.func.model.getResolvedOverload(call);
    var slotName = if (chosenFt != null) {
      propName + getSignatureKey(chosenFt as FunctionType)
    } else {
      propName
    };
    // Generic methods register one monomorphized copy per solved
    // type-argument list, under a specialized slot name — when the
    // class declares the member generic, the call resolves that copy.
    if (let (true, declInfo) = ct.members.get(propName)) {
      if (declInfo.type is FunctionType) {
        let declFt = declInfo.type as FunctionType;
        if (declFt.typeParameters != null &&
            (declFt.typeParameters as Array<TypeParameterType>).length > 0) {
          let targs = this.#solvedCallTypeArguments(call);
          if (targs == null) {
            this.#bail('generic method call');
          }
          slotName = getSpecializedName(propName, targs as Array<Type>);
        }
      }
    }

    var methodOpt: WasmFunction | null = null;
    let isPrivate = propName.length > 0 && propName.sliceBytes(0, 1) == "#";
    if (isPrivate) {
      // Mixin-declared bodies resolve their privates under the
      // mixin's scope key ("<scope>::#name", registered per host
      // class) — mixin privates are lexical to the mixin declaration
      // and never alias a host's same-named private.
      let mixScope = this.func.privateScopeKey;
      if (mixScope != null) {
        let scopedName = (mixScope as String) + "::" + slotName;
        var applied: ClassType | null = ct;
        while (applied != null) {
          let key = getClassMethodKey(getClassKey(applied), scopedName);
          if (let (true, m) = this.wasm.classMethodMap.get(key)) {
            methodOpt = m;
            break;
          }
          applied = applied.superType;
        }
      }
      // Private methods are lexically scoped and never virtual: they
      // resolve ONLY against the class the code was written in — plus
      // that class's own specializations (same canonical class), since
      // specialized copies register under their specialized keys.
      // Never against super- or subclasses: private names cannot be
      // shared across a hierarchy.
      let lexicalCt = this.#lexicalClassOf(member, ct);
      let lexKey = getClassMethodKey(getClassKey(lexicalCt), slotName);
      if (methodOpt == null) {
        if (let (true, m) = this.wasm.classMethodMap.get(lexKey)) {
          methodOpt = m;
        }
      }
      if (methodOpt == null) {
        let lexCanonical = this.#canonicalKeyOf(lexicalCt);
        var c: ClassType | null = ct;
        while (c != null && methodOpt == null) {
          let cc = c as ClassType;
          if (this.#canonicalKeyOf(cc) == lexCanonical) {
            let key = getClassMethodKey(getClassKey(cc), slotName);
            if (let (true, m2) = this.wasm.classMethodMap.get(key)) {
              methodOpt = m2;
            }
          }
          c = cc.superType;
        }
      }
      if (methodOpt == null) {
        this.#bail('private method not found');
      }
    }
    var currClass: ClassType | null = ct;
    while (currClass != null && methodOpt == null) {
      // Inner walk through generic sources: shared (unspecialized)
      // template methods register under the template's key.
      var g: ClassType | null = currClass;
      while (g != null && methodOpt == null) {
        let key = getClassMethodKey(getClassKey(g as ClassType), slotName);
        if (let (true, m) = this.wasm.classMethodMap.get(key)) {
          methodOpt = m;
        }
        g = (g as ClassType).genericSource;
      }
      currClass = (currClass as ClassType).superType;
    }
    if (methodOpt == null) {
      this.#bail('method not found');
    }
    let method = methodOpt as WasmFunction;
    // Intrinsic methods inline as instructions, exactly like their
    // call-position forms — streaming routes them through the same
    // per-name generators (the marker receiver carries no value).
    if (method.intrinsic != null) {
      return lowerIntrinsic(this.#cx(),
          method.intrinsic as String, call);
    }
    if (method.isStatic ||
        (method.typeParameters != null && method.typeArguments == null)) {
      this.#bail('method shape');
    }
    // Private access is never virtual; overload slots are overridden
    // independently (member-lookup.md §5.3), so the check keys on the
    // SLOT name. An overridden slot dispatches through the vtable.
    var isVirtual = false;
    if (!isPrivate && !this.#cx().exactValues.has(receiver) &&
        this.#cx().memberProvidedBySubclass(classInfo, slotName)) {
      if (this.#vtableSlotIndex(classInfo, slotName) < 0) {
        this.#bail('overridden method without vtable slot');
      }
      isVirtual = true;
    }
    let sig = method.signature;
    if (sig.returns.length > 1 && multiOut == null) {
      this.#bail('method multi-value return');
    }
    if (sig.params.length != call.args.length + 1) {
      this.#bail('method arity adaptation');
    }

    if (!isValSubtype(this.#valueType(receiver), sig.params[0])) {
      this.#failConformance(receiver, sig.params[0], 'method receiver type');
    }
    let defaults = this.#defaultArgInfo(call);
    let args = new Array<i32>();
    args.push(receiver);
    for (var i = 0; i < call.args.length; i += 1) {
      let paramVt = sig.params[i + 1];
      this.#requireSupported(paramVt, 'method param type');
      var value = this.#lowerArgWithDefaults(call, i, paramVt, defaults, receiver);
      value = this.#conformToSlot(value, paramVt, 'method argument type');
      args.push(value);
    }
    if (sig.returns.length > 1) {
      if (isVirtual) {
        this.#bail('virtual multi-value method');
      }
      for (let r in sig.returns) {
        this.#requireSupported(r, 'method result type');
      }
      let multiRef = this.b.addRef(new IrRefFunc(method));
      let projs = this.b.callFuncMulti(multiRef, args, sig.returns);
      let outs = multiOut as Array<i32>;
      for (let p in projs) {
        outs.push(p);
      }
      return projs[0];
    }
    let resultType = if (sig.returns.length == 1) sig.returns[0] else null;
    if (resultType != null) {
      this.#requireSupported(resultType, 'method result type');
    }
    let result = if (isVirtual) {
      this.#lowerVtableCall(receiver, classInfo, slotName, sig, args, resultType)
    } else {
      this.b.callFunc(this.b.addRef(new IrRefFunc(method)), args, resultType)
    };
    if (resultType != null) {
      let nodeType = this.func.model.getNodeType(call);
      if (nodeType != null && !(baseType(nodeType as Type) is VoidType)) {
        let want = typeToValTypeWithSub(this.wasm, nodeType as Type, this.func);
        if (want is ValTypeRef && (resultType as ValType) is ValTypeRefNull) {
          return this.b.emit(IrOp.ref_as_non_null, want, result, -1);
        }
      }
    }
    return result;
  }

  /**
   * Index reads. Raw wasm arrays (FixedArray values ARE wasm arrays)
   * read via array_get; boxed tuples read the literal-index field;
   * interface receivers dispatch through the [] vtable slot; class
   * receivers resolve the [] overload by mangled signature key exactly
   * like streaming (intrinsics preferred per class, supertype and
   * generic-source walk) and call it directly. Index WRITES still bail
   * at the assignment-target gate.
   */
  #lowerIndexRead(idx: IndexExpression): i32 {
    if (idx.optional) {
      return this.#lowerOptionalChainExpr(idx as Expression);
    }
    let objectType = this.#substitutedNodeType(idx.object);
    if (objectType == null) {
      this.#bail('untyped index receiver');
    }
    let selfResolved = this.#resolveSelfType(objectType as Type);

    if (selfResolved is InterfaceType) {
      let args = new Array<Expression>();
      args.push(idx.index);
      let result = this.#lowerInterfaceDispatch(
          selfResolved as InterfaceType, '[]', idx.object, args);
      return this.#reassertNonNull(result, this.#exprValType(idx));
    }

    let receiver = this.#lowerExpression(idx.object);
    return this.#lowerIndexReadOn(idx, selfResolved, receiver);
  }

  /**
   * The receiver-value core of an index read: boxed-tuple fields,
   * array elements, then [] overloads on classes. Shared by the plain
   * path and the optional-chain hit arm.
   */
  #lowerIndexReadOn(idx: IndexExpression, selfResolved: Type,
      receiver: i32): i32 {
    if (baseType(selfResolved) is TupleType) {
      if (!(idx.index is NumberLiteral)) {
        this.#bail('dynamic tuple index');
      }
      let elemIdx = if (let (true, n) = parseI32((idx.index as NumberLiteral).raw)) n else -1;
      if (elemIdx < 0) {
        this.#bail('tuple index literal');
      }
      let stOpt = asWasmStruct(this.#valueType(receiver));
      if (stOpt == null) {
        this.#bail('tuple receiver kind');
      }
      let st = stOpt as WasmStruct;
      let fieldName = i32ToString(elemIdx);
      if (st.fieldIndexByName(fieldName) < 0) {
        this.#bail('tuple field not found');
      }
      let fieldRef = this.b.addRef(new IrRefField(st, fieldName));
      let read = this.b.emit(IrOp.struct_get,
          this.#fieldValType(st, fieldName), receiver, fieldRef);
      return this.#reassertNonNull(read, this.#exprValType(idx));
    }

    let arrOpt = asWasmArray(this.#valueType(receiver));
    // A class-typed index (a range: arr[1..3]) is not an element read;
    // it dispatches to the matching [] overload like any class receiver.
    // Extension classes stay on the element path: their values ARE
    // their onType (an i32 index handle reads like an i32).
    let idxTypeOpt = this.#substitutedNodeType(idx.index);
    var classIndex = false;
    if (idxTypeOpt != null) {
      let idxBase = baseType(idxTypeOpt as Type);
      if (idxBase is ClassType) {
        classIndex = !(idxBase as ClassType).isExtension;
      }
    }
    if (arrOpt != null && !classIndex) {
      let arr = arrOpt as WasmArray;
      let index = this.#lowerExpression(idx.index);
      if (!(this.#valueType(index) is ValTypeI32)) {
        this.#bail('index operand type');
      }
      if (arr.elementType is ValTypeI8) {
        // Packed byte elements read unsigned, as i32 (array.get_u).
        return this.b.emit(IrOp.array_get_u, new ValTypeI32(), receiver, index);
      }
      this.#requireSupported(arr.elementType, 'array element type');
      let value = this.b.emit(IrOp.array_get, arr.elementType, receiver, index);
      return this.#reassertNonNull(value, this.#exprValType(idx));
    }

    // Class receiver: [] overload, resolved by mangled signature key.
    // The receiver VALUE's class wins (specializations); the checked
    // type is the fallback.
    let fromValue = this.#classTypeOfValue(receiver);
    let ct = if (fromValue != null) {
      fromValue
    } else if (selfResolved is ClassType) {
      eraseTypeParameters(selfResolved) as ClassType
    } else {
      null
    };
    if (ct == null) {
      this.#bail('index receiver kind');
    }
    // Overload choice belongs to the checker: it records the selected
    // declared FunctionType per index node, and registration mangles
    // overloaded members with that same declaration's signature key —
    // so the exact registered name is reproducible with NO argument-
    // type reconstruction here. No record means no overloads: the
    // plain name is unambiguous.
    let chosenFt = this.func.model.getResolvedOverload(idx);
    let mangled = if (chosenFt != null) {
      '[]' + getSignatureKey(chosenFt as FunctionType)
    } else {
      '[]'
    };
    let methodOpt = this.#resolveIndexMethod(ct as ClassType, mangled, chosenFt != null);
    if (methodOpt == null) {
      this.#bail('index method not found');
    }
    let method = methodOpt as WasmFunction;
    if (method.intrinsic != null) {
      // Linear-memory byte access (mem[i]) is the only [] intrinsic:
      // one load instruction, align 0 — streaming's shape.
      if ((method.intrinsic as String) == 'i32.load8_u') {
        let addr = this.#lowerExpression(idx.index);
        return this.b.emit(IrOp.i32_load8_u, new ValTypeI32(), addr, 0);
      }
      this.#bail('index intrinsic');
    }
    if (method.isStatic || method.typeParameters != null) {
      this.#bail('index method shape');
    }
    let sig = method.signature;
    if (sig.params.length != 2 || sig.returns.length > 1) {
      this.#bail('index method arity');
    }
    if (!isValSubtype(this.#valueType(receiver), sig.params[0])) {
      this.#failConformance(receiver, sig.params[0], 'index receiver type');
    }
    this.#requireSupported(sig.params[1], 'index param type');
    var indexValue = this.#lowerExpressionCtx(idx.index, sig.params[1]);
    indexValue = this.#conformToSlot(indexValue, sig.params[1], 'index operand type');
    let resultType = if (sig.returns.length == 1) sig.returns[0] else null;
    if (resultType != null) {
      this.#requireSupported(resultType, 'index result type');
    }
    let methodRef = this.b.addRef(new IrRefFunc(method));
    let result = this.b.callFunc(methodRef,
        this.#twoValues(receiver, indexValue), resultType);
    if (resultType == null) {
      return result;
    }
    return this.#reassertNonNull(result, this.#exprValType(idx));
  }

  /**
   * Finds the [] implementation registered under `mangled`, walking
   * supertype and generic-source chains, preferring intrinsic
   * registrations per class (streaming's rule). When the checker
   * recorded an overload choice (`exact`), ONLY that name is
   * acceptable — falling back to the plain name could silently bind a
   * different overload.
   */
  #resolveIndexMethod(ct: ClassType, mangled: String, exact: boolean): WasmFunction | null {
    var currClass: ClassType | null = ct;
    while (currClass != null) {
      var g: ClassType | null = currClass;
      while (g != null) {
        let cKey = getClassKey(g as ClassType);
        let keyWithSig = getClassMethodKey(cKey, mangled);
        if (let (true, f) = this.wasm.classMethodMap.get(keyWithSig)) {
          if (f.intrinsic != null) {
            return f;
          }
        }
        if (!exact) {
          if (let (true, f2) = this.wasm.classMethodMap.get(keyWithSig)) {
            return f2;
          }
        } else if (let (true, f3) = this.wasm.classMethodMap.get(keyWithSig)) {
          return f3;
        }
        g = (g as ClassType).genericSource;
      }
      currClass = (currClass as ClassType).superType;
    }
    return null;
  }

  /**
   * Interface vtable dispatch (ir.md §5): unpack the fat pointer, load
   * the member's funcref slot from the vtable, and call_ref through it.
   * `memberName` is the vtable slot name — a method name or a get#/set#
   * accessor. `argExprs` is null for accessor reads (receiver only).
   */
  #lowerInterfaceDispatch(it: InterfaceType, memberName: String,
      receiverExpr: Expression, argExprs: Array<Expression> | null,
      multiOut: Array<i32> | null = null): i32 {
    let iName = getInterfaceKey(it);
    let vstOpt = if (let (true, v) = this.wasm.interfaceVTableStructs.get(iName)) v else null;
    let fatPtrOpt = if (let (true, st) = this.wasm.interfaceStructs.get(iName)) st else null;
    if (vstOpt == null || fatPtrOpt == null) {
      this.#bail('interface not discovered');
    }
    let vst = vstOpt as WasmStruct;
    let fatPtr = fatPtrOpt as WasmStruct;
    let slot = vst.fieldIndexByName(memberName);
    if (slot < 0) {
      // Function-typed interface fields called as methods land here
      // (streaming falls back to a closure call); closures bail.
      this.#bail('interface member not in vtable');
    }
    // The vtable slot's declared type IS the signature (the RTA pass
    // types slots as exact (ref $sig)); using it keeps the callee value
    // consistent with what emission derives the call_ref type from.
    let sigOpt = asWasmSignature(vst.fields[slot].type);
    if (sigOpt == null) {
      this.#bail('interface slot shape');
    }
    let sig = sigOpt as WasmSignature;
    if (sig.returns.length > 1 && multiOut == null) {
      this.#bail('interface member multi-value return');
    }
    let argCount = if (argExprs == null) 0
        else (argExprs as Array<Expression>).length;
    if (sig.params.length != argCount + 1) {
      this.#bail('interface call arity adaptation');
    }

    let recv = this.#lowerExpression(receiverExpr);
    if (!isValSubtype(this.#valueType(recv),
        new ValTypeRefNull(fatPtr) as ValType)) {
      this.#bail('interface receiver type');
    }
    let inst = this.b.emit(
        IrOp.iface_instance, fatPtr.fields[0].type, recv, -1);
    if (!isValSubtype(this.#valueType(inst), sig.params[0])) {
      this.#failConformance(inst, sig.params[0], 'interface receiver adaptation');
    }
    let args = new Array<i32>();
    args.push(inst);
    if (argExprs != null) {
      let list = argExprs as Array<Expression>;
      for (var i = 0; i < list.length; i += 1) {
        let paramVt = sig.params[i + 1];
        this.#requireSupported(paramVt, 'interface param type');
        var value = this.#lowerExpressionCtx(list[i], paramVt);
        value = this.#conformToSlot(value, paramVt, 'interface argument type');
        args.push(value);
      }
    }
    let vt = this.b.emit(IrOp.iface_vtable, fatPtr.fields[1].type, recv, -1);
    let fieldRef = this.b.addRef(new IrRefField(vst, memberName));
    let callee = this.b.emit(
        IrOp.struct_get, vst.fields[slot].type, vt, fieldRef);
    if (sig.returns.length > 1) {
      for (let r in sig.returns) {
        this.#requireSupported(r, 'interface result type');
      }
      let projs = this.b.callRefMulti(callee, args, sig.returns);
      let outs = multiOut as Array<i32>;
      for (let pj in projs) {
        outs.push(pj);
      }
      return projs[0];
    }
    var resultType: ValType | null = null;
    if (sig.returns.length == 1) {
      this.#requireSupported(sig.returns[0], 'interface result type');
      resultType = sig.returns[0];
    }
    return this.b.callRef(callee, args, resultType);
  }

  #classTypeOfValue(value: i32): ClassType | null {
    return this.#cx().classTypeOfValue(value);
  }

  /**
   * The LEXICAL class of a member access: derived from the checked
   * type of the receiver expression, which names the class the
   * accessing code was written in — the generic template inside
   * specialized-method bodies, and the DECLARING class inside method
   * bodies the compiler copies into subclasses. Private members are
   * lexically scoped, so their mangled names must resolve against
   * this, never against the receiver value's (possibly more derived,
   * possibly more specialized) runtime class.
   */
  #lexicalClassOf(member: MemberExpression, fallback: ClassType): ClassType {
    let objectType = this.#substitutedNodeType(member.object);
    if (objectType != null) {
      let selfResolved = this.#resolveSelfType(objectType as Type);
      if (selfResolved is ClassType) {
        return eraseTypeParameters(selfResolved) as ClassType;
      }
    }
    return fallback;
  }

  /**
   * Resolves a private member's mangled struct-field name by walking
   * the LEXICAL declaring chain — supertypes and generic sources —
   * since fields are stored under the DECLARING class's key (the
   * template's for specialized generics, an ancestor's for privates
   * accessed from copied method bodies).
   */
  #privateLookupName(st: WasmStruct, ct: ClassType, propName: String): String | null {
    // Functions compiled from a mixin body resolve privates under the
    // mixin's scope key ("<Mixin>_This::#x") — mixin privates are
    // lexical to the mixin declaration and never alias a host's
    // same-named private (WasmFunction.privateScopeKey).
    let mixScope = this.func.privateScopeKey;
    if (mixScope != null) {
      let scopedName = (mixScope as String) + "::" + propName;
      if (st.fieldIndexByName(scopedName) >= 0) {
        return scopedName;
      }
    }
    // Shared with the streaming backend: struct field names carry the
    // key of whatever class the struct was BUILT for, so the struct
    // itself resolves, lexically disambiguated.
    return st.resolvePrivateFieldName(ct, propName);
  }

  /**
   * Resolves a private accessor function (get#/set# + private name)
   * lexically: the calling function's mixin scope key first (scoped
   * registrations walk the receiver's chain, since the mixin may be
   * applied at an ancestor), then the LEXICAL class and its generic
   * sources. Null when no such accessor is registered.
   */
  #resolvePrivateAccessor(ct: ClassType, lexicalCt: ClassType, accName: String): WasmFunction | null {
    let mixScope = this.func.privateScopeKey;
    if (mixScope != null) {
      let scopedName = (mixScope as String) + "::" + accName;
      var applied: ClassType | null = ct;
      while (applied != null) {
        let key = getClassMethodKey(getClassKey(applied), scopedName);
        if (let (true, f) = this.wasm.classMethodMap.get(key)) {
          return f;
        }
        applied = applied.superType;
      }
    }
    var candidate: ClassType | null = lexicalCt;
    while (candidate != null) {
      let key = getClassMethodKey(getClassKey(candidate), accName);
      if (let (true, f) = this.wasm.classMethodMap.get(key)) {
        return f;
      }
      candidate = candidate.genericSource;
    }
    return null;
  }

  #canonicalKeyOf(ct: ClassType): String {
    return this.#cx().canonicalKeyOf(ct);
  }

  /** Receiver class for member/method resolution: the value's own
   * class when its struct carries one, else the checked type. */
  #receiverClass(receiver: i32, member: MemberExpression): ClassType {
    // Extension receivers: the checked extension class wins — the
    // VALUE is the underlying onType and never names the extension.
    let checkedType = this.#substitutedNodeType(member.object);
    if (checkedType != null) {
      let selfR = this.#resolveSelfType(checkedType as Type);
      if (selfR is ClassType && (selfR as ClassType).isExtension) {
        return eraseTypeParameters(selfR) as ClassType;
      }
    }
    let fromValue = this.#classTypeOfValue(receiver);
    if (fromValue != null) {
      return fromValue as ClassType;
    }
    let objectType = this.#substitutedNodeType(member.object);
    if (objectType == null) {
      this.#bail('untyped member receiver');
    }
    let selfResolved = this.#resolveSelfType(objectType as Type);
    if (!(selfResolved is ClassType)) {
      this.#bail('member on non-class');
    }
    return eraseTypeParameters(selfResolved) as ClassType;
  }

  #vtableSlotIndex(classInfo: ClassCodegenInfo, slotName: String): i32 {
    return this.#cx().vtableSlotIndex(classInfo, slotName);
  }

  #lowerVtableCall(receiver: i32, classInfo: ClassCodegenInfo,
      slotName: String, sig: WasmSignature, args: Array<i32>,
      resultType: ValType | null): i32 {
    return this.#cx().lowerVtableCall(receiver, classInfo, slotName, sig,
        args, resultType);
  }

  /**
   * Resolves a member read against the receiver's class: either a
   * physical field (fieldName set) or a non-overridden getter function.
   */
  #resolveMemberTarget(member: MemberExpression, ct: ClassType): MemberTarget {
    let cKey = getClassKey(ct);
    let infoOpt = if (let (true, info) = this.wasm.classInfos.get(cKey)) info else null;
    if (infoOpt == null) {
      this.#bail('receiver class not discovered');
    }
    let classInfo = infoOpt as ClassCodegenInfo;
    let structType = classInfo.structType;
    var propName = getMemberPropertyName(member.isSymbolAccess, member.property.name);
    var lookupName = propName;
    if (propName.length > 0 && propName.sliceBytes(0, 1) == "#") {
      if (this.func.classType == null) {
        this.#bail('private access outside class');
      }
      let lexicalCt = this.#lexicalClassOf(member, ct);
      let resolved = this.#privateLookupName(structType, lexicalCt, propName);
      if (resolved != null) {
        lookupName = resolved as String;
      } else {
        // No physical field: a private ACCESSOR. Resolve the getter
        // LEXICALLY (never against the receiver chain — copied-down
        // method bodies are lowered with the subclass as receiver
        // class, and a subclass's shadowing private accessor must not
        // win): mixin scope key first, then the lexical class and its
        // generic sources.
        let privGetter = this.#resolvePrivateAccessor(ct, lexicalCt, 'get#' + propName);
        if (privGetter != null) {
          return new MemberTarget(structType, null, privGetter as WasmFunction);
        }
        // Never fall through to the receiver-chain getter walk below:
        // it could bind a subclass's shadowing private accessor.
        this.#bail('private member not found');
      }
    }

    // Physical field with the property's name? (Memoized on the
    // struct: this runs once per member access.) A direct read is only
    // sound when no class between the receiver and the field's declarer
    // redefined the accessor (a subclass shadowing an inherited field
    // with a getter leaves the parent's physical field in the struct),
    // and no transitive subclass overrides it either. Private access
    // is never virtual, so those checks only apply to public members.
    let isPrivate = propName.length > 0 && propName.sliceBytes(0, 1) == "#";
    let hasField = structType.fieldIndexByName(lookupName) >= 0;
    if (hasField && isPrivate) {
      return new MemberTarget(structType, lookupName, null);
    }
    if (hasField && !this.#accessorRedefined(ct, propName, 'get#' + propName)) {
      if (this.#cx().accessorOverriddenBySubclass(
              classInfo, 'get#' + propName, lookupName)) {
        // A subclass overrides the accessor: the read must dispatch.
        // The slot signature is the DEFAULT getter registered by the
        // declaring class (present whenever the slot is).
        return this.#virtualGetterTarget(
            structType, classInfo, ct, propName);
      }
      return new MemberTarget(structType, lookupName, null);
    }

    // Getter?
    let getterKey = getClassMethodKey(cKey, 'get#' + propName);
    var getter: WasmFunction | null = null;
    var currClass: ClassType | null = ct;
    while (currClass != null && getter == null) {
      let key = getClassMethodKey(getClassKey(currClass as ClassType), 'get#' + propName);
      if (let (true, g) = this.wasm.classMethodMap.get(key)) {
        getter = g;
      }
      currClass = (currClass as ClassType).superType;
    }
    if (getter == null) {
      this.#bail('member not found');
    }
    if ((getter as WasmFunction).isStatic) {
      this.#bail('static member');
    }
    if (!isPrivate && this.#cx().memberProvidedBySubclass(classInfo, 'get#' + propName)) {
      let target = new MemberTarget(structType, null, getter);
      if (this.#vtableSlotIndex(classInfo, 'get#' + propName) < 0) {
        this.#bail('overridden getter without vtable slot');
      }
      target.vtSlot = 'get#' + propName;
      target.vtInfo = classInfo;
      return target;
    }
    return new MemberTarget(structType, null, getter);
  }

  /**
   * A virtual-getter member target: resolves the slot's signature
   * from the nearest registered getter and marks the target for
   * vtable dispatch.
   */
  #virtualGetterTarget(structType: WasmStruct, classInfo: ClassCodegenInfo,
      ct: ClassType, propName: String): MemberTarget {
    var getter: WasmFunction | null = null;
    var currClass: ClassType | null = ct;
    while (currClass != null && getter == null) {
      let key = getClassMethodKey(
          getClassKey(currClass as ClassType), 'get#' + propName);
      if (let (true, g) = this.wasm.classMethodMap.get(key)) {
        getter = g;
      }
      currClass = (currClass as ClassType).superType;
    }
    if (getter == null) {
      this.#bail('overridden field without getter slot');
    }
    if (this.#vtableSlotIndex(classInfo, 'get#' + propName) < 0) {
      this.#bail('overridden field without vtable slot');
    }
    let target = new MemberTarget(structType, null, getter);
    target.vtSlot = 'get#' + propName;
    target.vtInfo = classInfo;
    return target;
  }

  /**
   * True when a class between the receiver and the property's declaring
   * class redefines the accessor: the field-declaring class provides the
   * DEFAULT accessor, and if the nearest definition walking up from the
   * receiver differs, physical field access is wrong (mirrors the
   * streaming generator's hasOverride computation).
   */
  #accessorRedefined(ct: ClassType, propName: String, accessorName: String): boolean {
    var fieldDeclaringClass = ct;
    var curr: ClassType | null = ct;
    while (curr != null) {
      let c = curr as ClassType;
      if (c.members.has(propName) && c.members[propName] is FieldInfo) {
        fieldDeclaringClass = c;
      }
      curr = c.superType;
    }
    let defKey = getClassMethodKey(getClassKey(fieldDeclaringClass), accessorName);
    let defaultAccessor = if (let (true, d) = this.wasm.classMethodMap.get(defKey)) d else null;
    var resolved: WasmFunction | null = null;
    var currClass: ClassType | null = ct;
    while (currClass != null && resolved == null) {
      let key = getClassMethodKey(
          getClassKey(currClass as ClassType), accessorName);
      if (let (true, r) = this.wasm.classMethodMap.get(key)) {
        resolved = r;
      }
      currClass = (currClass as ClassType).superType;
    }
    return resolved != null && defaultAccessor != null &&
        resolved != defaultAccessor;
  }

  /**
   * Index writes `recv[i] = v`: array.set for wasm-array receivers,
   * else a direct call to the checker-selected `[]=` overload (the
   * selection is recorded on the ASSIGNMENT node — the read
   * selection of a compound assignment lives on the IndexExpression,
   * but compound index writes bail for now). Yields the assigned
   * value, like every assignment expression.
   */
  #lowerIndexWrite(assign: AssignmentExpression): i32 {
    let idx = assign.left as IndexExpression;
    if (idx.optional) {
      this.#bail('optional index');
    }
    let objectType = this.#substitutedNodeType(idx.object);
    if (objectType == null) {
      this.#bail('untyped index receiver');
    }
    let selfResolved = this.#resolveSelfType(objectType as Type);
    if (selfResolved is InterfaceType) {
      this.#bail('interface index write');
    }

    let receiver = this.#lowerExpression(idx.object);
    let arrOpt = asWasmArray(this.#valueType(receiver));
    if (arrOpt != null) {
      let arr = arrOpt as WasmArray;
      let index = this.#lowerExpression(idx.index);
      if (!(this.#valueType(index) is ValTypeI32)) {
        this.#bail('index operand type');
      }
      // Packed byte elements write plain i32 values.
      var elemCtx: ValType = new ValTypeI32();
      if (!(arr.elementType is ValTypeI8)) {
        this.#requireSupported(arr.elementType, 'array element type');
        elemCtx = arr.elementType;
      }
      var value = -1;
      if (assign.operator == null) {
        value = this.#lowerExpressionCtx(assign.value, elemCtx);
      } else {
        // Compound: SSA reuses the receiver and index values, so the
        // element reads once and writes once.
        let current = if (arr.elementType is ValTypeI8) {
          this.b.emit(IrOp.array_get_u, new ValTypeI32(), receiver, index)
        } else {
          this.b.emit(IrOp.array_get, arr.elementType, receiver, index)
        };
        value = this.#combineCompound(current, assign, idx as Expression);
      }
      if (!isValSubtype(this.#valueType(value), elemCtx)) {
        this.#failConformance(value, elemCtx, 'array write type');
      }
      let tripleIdx = this.b.pushExtra(this.#threeValues(receiver, index, value));
      this.b.emitVoid(IrOp.array_set, tripleIdx, -1);
      return value;
    }

    // Class receiver: the checker records the selected `[]=` overload
    // on the assignment node; registration mangles overloaded members
    // with the same declaration's signature key. No record means no
    // overloads.
    let fromValue = this.#classTypeOfValue(receiver);
    let ct = if (fromValue != null) {
      fromValue
    } else if (selfResolved is ClassType) {
      eraseTypeParameters(selfResolved) as ClassType
    } else {
      null
    };
    if (ct == null) {
      this.#bail('index receiver kind');
    }
    if (assign.operator != null) {
      this.#bail('compound index write');
    }
    let chosenFt = this.func.model.getResolvedOverload(assign);
    let mangled = if (chosenFt != null) {
      '[]=' + getSignatureKey(chosenFt as FunctionType)
    } else {
      '[]='
    };
    let methodOpt = this.#resolveIndexMethod(ct as ClassType, mangled, chosenFt != null);
    if (methodOpt == null) {
      this.#bail('index setter not found');
    }
    let method = methodOpt as WasmFunction;
    if (method.intrinsic != null) {
      // Linear-memory byte store (mem[i] = v): one store instruction,
      // align 0 — streaming's shape.
      if ((method.intrinsic as String) == 'i32.store8') {
        let addr = this.#lowerExpression(idx.index);
        let sv = this.#lowerExpressionCtx(assign.value, new ValTypeI32());
        let pair = new Array<i32>();
        pair.push(addr);
        pair.push(sv);
        this.b.emitVoid(IrOp.i32_store8, this.b.pushExtra(pair), 0);
        return sv;
      }
      this.#bail('index intrinsic');
    }
    if (method.isStatic || method.typeParameters != null) {
      this.#bail('index method shape');
    }
    let sig = method.signature;
    if (sig.params.length != 3 || sig.returns.length > 0) {
      this.#bail('index setter shape');
    }
    if (!isValSubtype(this.#valueType(receiver), sig.params[0])) {
      this.#failConformance(receiver, sig.params[0], 'index receiver type');
    }
    var index = this.#lowerExpressionCtx(idx.index, sig.params[1]);
    index = this.#conformToSlot(index, sig.params[1], 'index operand type');
    var value = this.#lowerExpressionCtx(assign.value, sig.params[2]);
    value = this.#conformToSlot(value, sig.params[2], 'index write type');
    let funcRef = this.b.addRef(new IrRefFunc(method));
    let args = new Array<i32>();
    args.push(receiver);
    args.push(index);
    args.push(value);
    this.b.callFunc(funcRef, args, null);
    return value;
  }

  /** Module-level global writes: global.set, with compound
   * assignments reading through global.get first. Yields the
   * assigned value like every assignment expression. */
  #lowerGlobalAssign(assign: AssignmentExpression, g: WasmGlobal): i32 {
    var value = -1;
    if (assign.operator == null) {
      value = this.#lowerExpressionCtx(assign.value, g.type);
    } else {
      let readRef = this.b.addRef(new IrRefGlobal(g));
      let current = this.b.emit(IrOp.global_get, g.type, -1, readRef);
      value = this.#combineCompound(current, assign, assign.left);
    }
    if (!isValSubtype(this.#valueType(value), g.type)) {
      this.#failConformance(value, g.type, 'global write type');
    }
    let writeRef = this.b.addRef(new IrRefGlobal(g));
    this.b.emitVoid(IrOp.global_set, value, writeRef);
    return value;
  }

  /** equals<T> intrinsic (see ir/equality.zena). */
  #lowerEqIntrinsic(call: CallExpression): i32 {
    return lowerEqIntrinsic(this.#cx(), call);
  }

  /** hash<T> intrinsic (see ir/equality.zena). */
  #lowerHashIntrinsic(call: CallExpression): i32 {
    return lowerHashIntrinsic(this.#cx(), call);
  }

  /** A value coerced to the target ValType, or a bail: identity when
   * already a subtype, ref.as_non_null for nullable-to-non-null of
   * the same target. */
  #lowerOperatorMemberOn(opMember: String, left: i32, right: i32,
      leftCt: ClassType): i32 {
    return this.#cx().operatorMemberOn(opMember, left, right, leftCt);
  }

  /**
   * The combining step of a compound assignment: current (op) rhs.
   * Scalar operands map to the numeric operator (unsignedness read
   * from the target and value expressions); reference operands
   * resolve the operator member on the current value's class
   * (String += is String.+), exactly like binary expressions.
   */
  #combineCompound(current: i32, assign: AssignmentExpression,
      target: Expression): i32 {
    let opName = assign.operator as String;
    let rhs = this.#lowerExpression(assign.value);
    let vt = this.#valueType(current);
    if (isRefValType(vt)) {
      let ctOpt = this.#classTypeOfValue(current);
      if (ctOpt == null) {
        this.#bail('compound operand kind');
      }
      let ct = ctOpt as ClassType;
      if (!ct.members.has(opName)) {
        this.#bail('compound operator member not found');
      }
      return this.#lowerOperatorMemberOn(opName, current, rhs, ct);
    }
    if (!valTypeEquals(vt, this.#valueType(rhs))) {
      this.#bail('mixed compound assignment types');
    }
    let unsigned = this.#isUnsignedNode(target) ||
        this.#isUnsignedNode(assign.value);
    let op = this.#mapBinaryOp(opName, vt, unsigned);
    return this.b.binary(op, vt, current, rhs);
  }

  #coerceTo(value: i32, target: ValType): i32 {
    return this.#cx().coerceTo(value, target);
  }

  #resolveDevirtualizedMethod(ct: ClassType, methName: String): WasmFunction | null {
    return this.#cx().resolveDevirtualizedMethod(ct, methName);
  }

  /** Enum member constants (see the streaming generator's enum
   * path): sequential numeric values with literal overrides, or the
   * member's string literal for string enums. */
  #lowerEnumMember(ed: EnumDeclaration, member: MemberExpression): i32 {
    let propName = getMemberPropertyName(
        member.isSymbolAccess, member.property.name);
    let isStringEnum = ed.members.length > 0 &&
        ed.members[0].initializer is StringLiteral;
    var nextValue = 0;
    for (let m in ed.members) {
      if (isStringEnum) {
        if (m.name.name == propName) {
          if (m.initializer is StringLiteral) {
            return this.#lowerStringLiteral(m.initializer as StringLiteral);
          }
          this.#bail('string enum member literal');
        }
      } else {
        var currentValue = nextValue;
        if (m.initializer != null) {
          if (m.initializer is NumberLiteral) {
            let raw = (m.initializer as NumberLiteral).raw;
            let (ok, v) = parseI32WithHex(raw);
            if (ok) {
              currentValue = v;
            } else {
              this.#bail('enum member literal');
            }
          } else {
            this.#bail('enum member initializer');
          }
        }
        if (m.name.name == propName) {
          return this.b.constI32(currentValue, new ValTypeI32() as ValType);
        }
        nextValue = currentValue + 1;
      }
    }
    this.#bail('enum member not found');
    return -1;
  }

  /**
   * Calls a FixedArray/ImmutableArray extension method on an
   * array-typed receiver: the target is the arrayMethods entry whose
   * class specialization matches the element type (the generic
   * template when the element is a type parameter), mirroring the
   * streaming backend's matching. Receiver is argument 0.
   */
  #lowerArrayExtensionCall(call: CallExpression, member: MemberExpression, elemType: Type): i32 {
    let propName = getMemberPropertyName(
        member.isSymbolAccess, member.property.name);
    // Overloaded extension methods (slice(start) / slice(start, end))
    // register under mangled names; the checker records the selected
    // declaration per call node (member-lookup.md §5.2).
    var lookupName = propName;
    let chosenFt = this.func.model.getResolvedOverload(call);
    if (chosenFt != null) {
      lookupName = propName + getSignatureKey(chosenFt as FunctionType);
    }
    let isGenericElem = elemType is TypeParameterType;
    var foundOpt: WasmFunction | null = null;
    // Self-calls inside FixedArray/ImmutableArray's own specialized
    // methods (`this.slice(...)` from the Range wrappers): the
    // element type reads as erased there, but the target is simply
    // this function's own specialization.
    if (this.func.classType != null) {
      let ownCt = this.func.classType as ClassType;
      if (ownCt.name == "FixedArray" || ownCt.name == "ImmutableArray") {
        let key = getClassMethodKey(getClassKey(ownCt), lookupName);
        if (let (true, m) = this.wasm.classMethodMap.get(key)) {
          foundOpt = m;
        }
      }
    }
    if (foundOpt == null) {
    for (let f in this.wasm.arrayMethods) {
      if (f.classType == null || f.methodName == null ||
          (f.methodName as String) != lookupName) {
        continue;
      }
      let fClass = f.classType as ClassType;
      if (fClass.name != "FixedArray" && fClass.name != "ImmutableArray") {
        continue;
      }
      let fArgs = fClass.typeArguments;
      if (isGenericElem) {
        if (fArgs == null || (fArgs as Array<Type>).length == 0) {
          foundOpt = f;
        }
      } else if (fArgs != null && (fArgs as Array<Type>).length > 0) {
        if (getTypeKeyForSpecialization(elemType) ==
            getTypeKeyForSpecialization((fArgs as Array<Type>)[0])) {
          foundOpt = f;
        }
      }
    }
    }
    if (foundOpt == null) {
      this.#bail('array extension method');
    }
    let target = foundOpt as WasmFunction;
    if (target.intrinsic != null || target.typeParameters != null) {
      this.#bail('array extension shape');
    }
    let sig = target.signature;
    if (sig.returns.length > 1) {
      this.#bail('array extension multi-value');
    }
    if (sig.params.length != call.args.length + 1) {
      this.#bail('array extension arity');
    }
    for (let p in sig.params) {
      this.#requireSupported(p, 'array extension param');
    }
    var resultType: ValType | null = null;
    if (sig.returns.length == 1) {
      this.#requireSupported(sig.returns[0], 'array extension result');
      resultType = sig.returns[0];
    }
    var receiver = this.#lowerExpressionCtx(member.object, sig.params[0]);
    receiver = this.#conformToSlot(receiver, sig.params[0], 'array extension receiver');
    let args = new Array<i32>();
    args.push(receiver);
    for (var i = 0; i < call.args.length; i += 1) {
      var value = this.#lowerExpressionCtx(call.args[i], sig.params[i + 1]);
      value = this.#conformToSlot(value, sig.params[i + 1], 'array extension argument');
      args.push(value);
    }
    let funcRef = this.b.addRef(new IrRefFunc(target));
    let raw = this.b.callFunc(funcRef, args, resultType);
    return this.#reassertCallResult(call, raw, resultType);
  }

  #threeValues(a: i32, b: i32, c: i32): Array<i32> {
    let out = new Array<i32>();
    out.push(a);
    out.push(b);
    out.push(c);
    return out;
  }

  #twoValues(a: i32, b: i32): Array<i32> {
    let result = new Array<i32>();
    result.push(a);
    result.push(b);
    return result;
  }

  /**
   * The shared context split-out lowering modules receive (see
   * ir/lowering-context.zena) — the recursive core as closures,
   * everything else direct. ONE instance per FunctionLowerer, built
   * lazily (field initializers cannot call methods): the closures
   * defer to `this` at call time, so early construction is safe.
   */
  #cx(): LoweringContext {
    let cached = this.#cxCache;
    if (cached != null) {
      return cached as LoweringContext;
    }
    let cx = new LoweringContext(
        this.b,
        this.wasm,
        this.func,
);
    cx.host = this;
    this.#cxCache = cx;
    return cx;
  }

  // Recursion entry points for the module-level seam functions at the
  // bottom of this file (the emission modules call back through them
  // across the import cycle).
  hostLowerExpr(e: Expression, want: ValType | null): i32 {
    if (want == null) {
      return this.#lowerExpression(e);
    }
    return this.#lowerExpressionCtx(e, want as ValType);
  }
  hostLowerExprRaw(e: Expression): i32 {
    return this.#lowerExpressionDispatch(e);
  }
  hostLowerStmt(st: Statement): void {
    this.#lowerStatement(st);
  }
  hostVarDecl(vd: VariableDeclaration): void {
    this.#lowerVariableDeclaration(vd);
  }
  hostThrowStmt(thr: ThrowExpression): void {
    this.#lowerThrowStatement(thr);
  }
  hostMultiSource(init: Expression): Array<i32> {
    return this.#lowerMultiSource(init);
  }
  hostOptionalHit(expr: Expression, recv: i32): i32 {
    return this.#lowerOptionalHit(expr, recv);
  }

  #lowerStringLiteral(lit: StringLiteral): i32 {
    return lowerStringLiteral(this.#cx(), lit);
  }

  #lowerTaggedTemplate(expr: TaggedTemplateExpression): i32 {
    return lowerTaggedTemplate(this.#cx(), expr);
  }

  #lowerTemplateLiteral(tpl: TemplateLiteral): i32 {
    return lowerTemplateLiteral(this.#cx(), tpl);
  }






  /**
   * Caller-supplied default arguments: the checker injects each
   * omitted parameter's default expression into the call's argument
   * list, so args at index >= the ORIGINAL count are the callee's
   * own expressions. They lower here, in the caller, with the
   * callee's context bound: `this` is the call's receiver, the
   * callee's earlier parameters are the argument values already
   * computed, and the lexical class is the default's declaring class
   * (private-field defaults resolve against it). Null when the call
   * carries no injected defaults.
   */
  #defaultArgInfo(call: CallExpression): DefaultArgInfo | null {
    let orig = this.func.model.getOriginalArgCount(call);
    if (orig == -1 || orig >= call.args.length) {
      return null;
    }
    let ftNode = this.func.model.getNodeType(call.callee);
    let paramSyms = if (ftNode != null && ftNode is FunctionType) {
      (ftNode as FunctionType).parameterSymbols
    } else {
      null
    };
    let ownerT = this.func.model.getDefaultArgsOwner(call);
    let owner = if (ownerT != null && ownerT is ClassType) {
      ownerT as ClassType
    } else {
      null
    };
    return new DefaultArgInfo(orig, paramSyms, owner);
  }

  /**
   * Lowers one call argument. Explicit arguments lower as written;
   * injected defaults lower under the callee's bindings (see
   * #defaultArgInfo), restored even when lowering throws so no
   * caller ever observes a leaked swap.
   */
  #lowerArgWithDefaults(call: CallExpression, i: i32, paramVt: ValType,
      info: DefaultArgInfo | null, receiver: i32): i32 {
    if (info == null || i < (info as DefaultArgInfo).originalCount) {
      let value = this.#lowerExpressionCtx(call.args[i], paramVt);
      if (info != null) {
        (info as DefaultArgInfo).values.push(value);
      }
      return value;
    }
    let inf = info as DefaultArgInfo;
    let savedThis = this.#cx().thisValue;
    let savedClass = this.func.classType;
    let savedSyms = new Array<SymbolId>();
    let savedVals = new Array<i32>();
    let syms = inf.paramSymbols;
    if (syms != null) {
      let symList = syms as Array<SymbolId>;
      for (var j = 0; j < inf.values.length && j < symList.length; j += 1) {
        let symId = symList[j];
        if (symId == (-1 as SymbolId)) {
          continue;
        }
        savedSyms.push(symId);
        savedVals.push(
            if (let (true, v) = this.#cx().env.get(symId)) v else -1);
        this.#cx().env[symId] = inf.values[j];
      }
    }
    if (receiver >= 0) {
      this.#cx().thisValue = receiver;
    }
    if (inf.owner != null) {
      this.func.classType = inf.owner;
    }
    let value = try {
      this.#lowerExpressionCtx(call.args[i], paramVt)
    } catch (e) {
      this.#cx().thisValue = savedThis;
      this.func.classType = savedClass;
      this.#restoreEnvBindings(savedSyms, savedVals);
      throw e
    };
    this.#cx().thisValue = savedThis;
    this.func.classType = savedClass;
    this.#restoreEnvBindings(savedSyms, savedVals);
    inf.values.push(value);
    return value;
  }

  #restoreEnvBindings(syms: Array<SymbolId>, vals: Array<i32>): void {
    for (var j = 0; j < syms.length; j += 1) {
      if (vals[j] < 0) {
        this.#cx().env.delete(syms[j]);
      } else {
        this.#cx().env[syms[j]] = vals[j];
      }
    }
  }

  /**
   * Direct calls only: the callee is an identifier statically resolving
   * to a non-generic, non-adapted top-level function (or import) whose
   * signature is all scalars and whose arity matches the call exactly
   * (an arity mismatch means default-argument adaptation). Everything
   * else — methods, function values, generics, optional calls — bails.
   *
   * A void call returns its (valueless) instruction id; the checker
   * rejects void values in operand position, and if one ever slipped
   * through, the verifier's produces-no-value check fails loudly.
   */
  #lowerCall(call: CallExpression, multiOut: Array<i32> | null = null): i32 {
    if (call.callee is MemberExpression) {
      return this.#lowerMethodCall(call, call.callee as MemberExpression, multiOut);
    }
    if (!(call.callee is Identifier)) {
      this.#bail('call callee kind');
    }
    if (call.optional) {
      // `fn?()`: a null closure value short-circuits to a null result.
      return this.#lowerOptionalChainExpr(call as Expression);
    }
    // Prelude array builtins (__array_new_empty & co.) are checker-
    // registered values with no declaration and no compiled function;
    // streaming name-dispatches them to inline array instructions
    // (generateArrayIntrinsic). Same here — including the explicit-
    // type-argument form __array_new_empty<T>(n), which must route
    // before the generic-call gate.
    let calleeName = (call.callee as Identifier).name;
    if (isArrayIntrinsic(calleeName)) {
      return lowerIntrinsic(this.#cx(), calleeName, call);
    }
    if (this.func.model.getUnionCallCalleeType(call.callee) != null) {
      return this.#lowerUnionCall(call);
    }
    let sym = this.func.model.resolve(call.callee);
    if (sym == null) {
      this.#bail('unresolved callee');
    }
    let resolved = (sym as Symbol).resolveTarget();
    if (this.#cx().env.has(resolved.id)) {
      // A local variable holding a function value: closure call.
      return this.#lowerClosureCall(call);
    }
    // Calls to @intrinsic declare functions (equals/hash from
    // zena:map and friends) never become compiled functions —
    // type-directed inline lowering, mirroring the streaming
    // backend's global intrinsics.
    let calleeFtNode = this.func.model.getNodeType(call.callee);
    let calleeFt = if (calleeFtNode != null && calleeFtNode is FunctionType) {
      calleeFtNode as FunctionType
    } else {
      null
    };
    let intrDecl = findDeclaration(this.wasm, resolved, calleeFt);
    if (intrDecl != null) {
      if (let (true, intrName) = this.wasm.intrinsics.get((intrDecl as DeclareFunction).id)) {
        return lowerIntrinsic(this.#cx(), intrName, call);
      }
    }
    // A generic call: the solved type arguments name a monomorphized
    // copy registered under the resolved symbol's name. A miss means
    // the specialization was never instantiated — bail, don't fall
    // through to the erased template.
    let solvedTargs = this.#solvedCallTypeArguments(call);
    if (solvedTargs != null) {
      let specKey = getSpecializedFunctionKey(
          resolved.name, solvedTargs as Array<Type>);
      let specOpt = if (let (true, f) = this.wasm.specializedFunctions.get(specKey)) f else null;
      if (specOpt == null) {
        this.#bail('generic call');
      }
      return this.#lowerSpecializedCall(
          call, specOpt as WasmFunction, multiOut);
    }
    if (call.typeArguments != null) {
      // Explicit type arguments but no solution recorded on the
      // callee's checked type: not a shape lowering models.
      this.#bail('generic call');
    }
    let targetOpt = if (let (true, t) = this.wasm.functionMap.get(resolved.id)) t else null;
    if (targetOpt == null) {
      // Not a compiled function: a binding holding a closure value
      // (global function values still bail when the callee lowers).
      return this.#lowerClosureCall(call);
    }
    return this.#lowerDirectCallTo(call, targetOpt as WasmFunction, multiOut);
  }

  /** The direct-call tail shared by identifier callees and
   * namespace-import members: shape gates, argument lowering (with
   * caller-side defaults), and the call itself. */
  #lowerDirectCallTo(call: CallExpression, target: WasmFunction,
      multiOut: Array<i32> | null): i32 {
    if (target.typeParameters != null || target.typeArguments != null ||
        target.intrinsic != null || target.isFunctionAdaptation ||
        target.isClosure || target.contextStruct != null ||
        target.captures.length > 0 || target.capturesThis ||
        target.classType != null || target.structType != null) {
      this.#bail('callee shape');
    }
    let sig = target.signature;
    if (sig.returns.length > 1 && multiOut == null) {
      this.#bail('callee multi-value return');
    }
    if (sig.params.length != call.args.length) {
      this.#bail('call arity adaptation');
    }
    for (var i = 0; i < sig.params.length; i += 1) {
      this.#requireSupported(sig.params[i], 'call param type');
    }
    let defaults = this.#defaultArgInfo(call);
    let args = new Array<i32>();
    for (var i = 0; i < call.args.length; i += 1) {
      var value = this.#lowerArgWithDefaults(call, i, sig.params[i], defaults, -1);
      value = this.#conformToSlot(value, sig.params[i], 'call argument type');
      args.push(value);
    }
    let funcRef = this.b.addRef(new IrRefFunc(target));
    if (sig.returns.length > 1) {
      for (let r in sig.returns) {
        this.#requireSupported(r, 'call result type');
      }
      let projs = this.b.callFuncMulti(funcRef, args, sig.returns);
      let outs = multiOut as Array<i32>;
      for (let p in projs) {
        outs.push(p);
      }
      return projs[0];
    }
    var resultType: ValType | null = null;
    if (sig.returns.length == 1) {
      this.#requireSupported(sig.returns[0], 'call result type');
      resultType = sig.returns[0];
    }
    return this.b.callFunc(funcRef, args, resultType);
  }

  /**
   * The narrow slice of this lowerer that intrinsics.zena needs (its
   * module cannot import FunctionLowerer without a cycle). The eq and
   * hash lowerings ride along as closures: their implementations stay
   * on the lowerer because they share the primitive cluster with the
   * case-class ==/hashCode synthesizers.
   */
  /**
   * Closure creation: ref.func of the (separately compiled, streaming
   * or ZIR) implementation, a context struct holding the captured
   * values, and the closure pair struct. Non-celled captures are BY
   * VALUE; celled captures pass the heap cell ref the environment
   * already holds — the context-field subtype check verifies each
   * capture matches what the closure body expects either way.
   */
  #lowerFunctionExpression(fExpr: FunctionExpression): i32 {
    let classKey = if (this.func.classType != null) {
      getClassKey(this.func.classType as ClassType)
    } else {
      "" as ClassKey
    };
    let closureKey = getClosureSpecializationKey(fExpr.id, classKey);
    var implOpt: WasmFunction | null = null;
    if (let (true, sc) = this.wasm.specializedClosures.get(closureKey)) {
      implOpt = sc;
    } else if (let (true, cf) = this.wasm.closureFunctions.get(fExpr)) {
      implOpt = cf;
    }
    if (implOpt == null) {
      this.#bail('closure not registered');
    }
    let impl = implOpt as WasmFunction;
    // The pair struct is keyed by the IMPLEMENTATION's own signature —
    // deriving it from the checked node type drifted under
    // substitution, and the func slot must hold exactly (ref implSig)
    // anyway.
    let pairKey = getClosureKey(impl.signature.params, impl.signature.returns);
    let closureStructOpt = if (let (true, st) = this.wasm.closureStructs.get(pairKey)) st else null;
    if (closureStructOpt == null) {
      this.#bail('closure pair struct not found');
    }
    let closureStruct = closureStructOpt as WasmStruct;
    if (impl.contextStruct == null) {
      this.#bail('closure without context struct');
    }
    let contextStruct = impl.contextStruct as WasmStruct;

    var ctxVal = -1;
    if (contextStruct.fields.length > 0) {
      let ctxArgs = new Array<i32>();
      var fieldIdx = 0;
      if (impl.capturesThis) {
        if (this.#cx().thisValue < 0) {
          this.#bail('closure captures this outside method');
        }
        if (!isValSubtype(this.#valueType(this.#cx().thisValue),
            contextStruct.fields[0].type)) {
          this.#bail('closure this capture type');
        }
        ctxArgs.push(this.#cx().thisValue);
        fieldIdx = 1;
      }
      for (let symId in impl.captures) {
        if (!this.#cx().env.has(symId)) {
          this.#bail('captured symbol not local');
        }
        let v = this.#cx().env[symId];
        if (!isValSubtype(this.#valueType(v),
            contextStruct.fields[fieldIdx].type)) {
          // Celled capture (context field wants a cell ref).
          this.#bail('celled capture');
        }
        ctxArgs.push(v);
        fieldIdx += 1;
      }
      let ctxTypeRef = this.b.addRef(new IrRefType(contextStruct));
      ctxVal = this.b.emit(IrOp.struct_new,
          new ValTypeRef(contextStruct) as ValType,
          this.b.pushArgList(ctxArgs), ctxTypeRef);
    } else {
      ctxVal = this.b.emit(IrOp.ref_null, new ValTypeStructRef(), -1, -1);
    }

    // The func slot's declared signature must be the implementation's
    // own signature (both come from the interned signature table).
    let slotSig = asWasmSignature(closureStruct.fields[0].type);
    if (slotSig == null || (slotSig as WasmSignature) != impl.signature) {
      this.#bail('closure signature adaptation');
    }
    let funcVal = this.b.emit(IrOp.ref_func, closureStruct.fields[0].type,
        -1, this.b.addRef(new IrRefFunc(impl)));
    let pairArgs = this.#twoValues(funcVal, ctxVal);
    return this.b.emit(IrOp.struct_new,
        new ValTypeRef(closureStruct) as ValType,
        this.b.pushArgList(pairArgs),
        this.b.addRef(new IrRefType(closureStruct)));
  }

  /**
   * Calls through a closure value {func: (ref $implSig), ctx: structref}:
   * the context rides as argument 0, and call_ref goes through the
   * exact-signature func field. Only the CALLING side is lowered —
   * closure creation and closure bodies still bail.
   */
  /**
   * A callee whose static type is a UNION of function types: the
   * runtime value is one member's closure pair, found by ref.test
   * against each member's closure struct in order (streaming's
   * chain). The matching arm passes that member's ARITY worth of the
   * pre-evaluated arguments — extra arguments simply go unused, which
   * is the union-call adaptation semantics. No member matching traps.
   */
  #lowerUnionCall(call: CallExpression): i32 {
    let ut = this.func.model.getUnionCallCalleeType(call.callee) as UnionType;
    // RAW read: the checker records the SELECTED member's type on the
    // callee node, but the runtime value may be any member — the
    // normal identifier read would re-assert the wrong closure struct.
    let callee = this.#lowerChainReceiver(call.callee);
    let args = new Array<i32>();
    for (let a in call.args) {
      args.push(this.#lowerExpression(a));
    }
    let callT = this.func.model.getNodeType(call);
    let isVoid = callT == null || isVoidOrNeverType(callT as Type);
    var resultVt: ValType | null = null;
    if (!isVoid) {
      let vt = typeToValTypeWithSub(this.wasm, callT as Type, this.func);
      this.#requireSupported(vt, 'union call result');
      resultVt = vt;
    }
    let merge = this.b.newBlock();
    var resultParam = -1;
    if (resultVt != null) {
      resultParam = this.b.blockParam(merge, resultVt as ValType);
    }
    for (let member in ut.types) {
      if (!(member is FunctionType)) {
        continue;
      }
      let ftm = member as FunctionType;
      let cs = getClosureStruct(this.wasm, ftm);
      let csVt = new ValTypeRef(cs) as ValType;
      let hit = this.b.emit(IrOp.ref_test, new ValTypeI32(), callee,
          this.b.internType(csVt));
      let callB = this.b.newBlock();
      let nextB = this.b.newBlock();
      this.b.brIf(hit, callB, this.#noArgs(), nextB, this.#noArgs());
      this.b.switchTo(callB);
      let cv = this.b.emit(IrOp.ref_cast, csVt, callee,
          this.b.internType(csVt));
      let sigOpt = asWasmSignature(cs.fields[0].type);
      if (sigOpt == null) {
        this.#bail('union member shape');
      }
      let sig = sigOpt as WasmSignature;
      if (sig.returns.length > 1) {
        this.#bail('union member shape');
      }
      let arity = sig.params.length - 1;
      if (arity > args.length) {
        this.#bail('union call arity');
      }
      let ctxVal = this.b.emit(IrOp.struct_get, cs.fields[1].type, cv,
          this.b.addRef(new IrRefField(cs, 'ctx')));
      let callArgs = new Array<i32>();
      callArgs.push(ctxVal);
      for (var i = 0; i < arity; i += 1) {
        if (!isValSubtype(this.#valueType(args[i]), sig.params[i + 1])) {
          this.#failConformance(args[i], sig.params[i + 1],
              'union call argument type');
        }
        callArgs.push(args[i]);
      }
      let fnVal = this.b.emit(IrOp.struct_get, cs.fields[0].type, cv,
          this.b.addRef(new IrRefField(cs, 'func')));
      let memberResult = if (sig.returns.length == 1) {
        this.b.callRef(fnVal, callArgs, sig.returns[0])
      } else {
        this.b.callRef(fnVal, callArgs, null)
      };
      if (resultVt != null) {
        if (sig.returns.length != 1 ||
            !isValSubtype(this.#valueType(memberResult), resultVt as ValType)) {
          this.#failConformance(memberResult, resultVt as ValType,
              'union call result type');
        }
        this.b.br(merge, this.#oneArg(memberResult));
      } else {
        this.b.br(merge, this.#noArgs());
      }
      this.b.switchTo(nextB);
    }
    // The checker proved the value is one of the members.
    this.b.unreachable();
    this.b.switchTo(merge);
    if (resultParam >= 0) {
      return resultParam;
    }
    return this.b.constI32(0, new ValTypeI32());
  }

  #lowerClosureCall(call: CallExpression): i32 {
    let callee = this.#lowerExpression(call.callee);
    return this.#lowerClosureCallOn(call, callee);
  }

  /** The callee-value core of a closure call. */
  #lowerClosureCallOn(call: CallExpression, callee: i32): i32 {
    // The callee value's OWN type carries the authoritative closure
    // struct; recomputing it from the checked node type drifted
    // whenever substitution or nullability normalization disagreed
    // with the type the value actually flowed in with.
    let structOpt = asWasmStruct(this.#valueType(callee));
    if (structOpt == null) {
      this.#bail('closure callee kind');
    }
    let closureStruct = structOpt as WasmStruct;
    if (closureStruct.fields.length != 2) {
      // Not a closure pair struct (e.g. a class instance): bail.
      this.#bail('closure callee shape');
    }
    let sigOpt = asWasmSignature(closureStruct.fields[0].type);
    if (sigOpt == null) {
      this.#bail('closure callee shape');
    }
    let sig = sigOpt as WasmSignature;
    if (sig.returns.length > 1) {
      this.#bail('closure multi-value return');
    }
    if (sig.params.length != call.args.length + 1) {
      this.#bail('closure arity adaptation');
    }
    let ctxRef = this.b.addRef(new IrRefField(closureStruct, 'ctx'));
    let ctxVal = this.b.emit(IrOp.struct_get,
        closureStruct.fields[1].type, callee, ctxRef);
    let args = new Array<i32>();
    args.push(ctxVal);
    for (var i = 0; i < call.args.length; i += 1) {
      let paramVt = sig.params[i + 1];
      this.#requireSupported(paramVt, 'closure param type');
      var value = this.#lowerExpressionCtx(call.args[i], paramVt);
      value = this.#conformToSlot(value, paramVt, 'closure argument type');
      args.push(value);
    }
    let funcRef = this.b.addRef(new IrRefField(closureStruct, 'func'));
    let funcVal = this.b.emit(IrOp.struct_get,
        closureStruct.fields[0].type, callee, funcRef);
    var resultType: ValType | null = null;
    if (sig.returns.length == 1) {
      this.#requireSupported(sig.returns[0], 'closure result type');
      resultType = sig.returns[0];
    }
    let result = this.b.callRef(funcVal, args, resultType);
    return this.#reassertCallResult(call, result, resultType);
  }

  #lowerAssignment(assign: AssignmentExpression): i32 {
    if (assign.left is MemberExpression) {
      return this.#lowerMemberAssign(assign);
    }
    if (assign.left is IndexExpression) {
      return this.#lowerIndexWrite(assign);
    }
    if (!(assign.left is Identifier)) {
      this.#bail('assignment target');
    }
    let sym = this.func.model.resolve(assign.left);
    if (sym == null) {
      this.#bail('unresolved assignment target');
    }
    let resolved = (sym as Symbol).resolveTarget();
    if (!this.#cx().env.has(resolved.id)) {
      if (let (true, g) = this.wasm.globalMap.get(resolved.id)) {
        return this.#lowerGlobalAssign(assign, g);
      }
      this.#bail('non-local assignment target');
    }
    let celled = this.#isCelled(resolved.id);
    var value = -1;
    if (assign.operator != null && (assign.operator as String) == "??") {
      return this.#lowerNullishAssign(assign, resolved.id, celled);
    }
    if (assign.operator == null) {
      var assignCtx: ValType | null = null;
      let targetBinding = this.func.model.getBindingType(resolved);
      if (targetBinding != null) {
        assignCtx = typeToValTypeWithSub(this.wasm, targetBinding as Type, this.func);
      }
      value = this.#lowerExpressionCtx(assign.value, assignCtx);
    } else {
      // Compound assignment: current op= value.
      let current = if (celled) this.#cellRead(this.#cx().env[resolved.id])
          else this.#cx().env[resolved.id];
      value = this.#combineCompound(current, assign, assign.left);
    }
    if (let (true, storeSym) = this.#cx().symbols.get(resolved.id)) {
      let bt = this.func.model.getBindingType(storeSym);
      if (bt != null) {
        let bvt = typeToValTypeWithSub(this.wasm, bt as Type, this.func);
        this.#requireSupported(bvt, 'binding type');
        value = this.#conformToBinding(value, bvt);
      }
    }
    if (celled) {
      // Mutation goes through the heap cell; the env binding (the cell
      // ref) is invariant.
      this.#cellWrite(this.#cx().env[resolved.id], value);
    } else {
      this.#cx().env[resolved.id] = value;
    }
    return value;
  }

  /**
   * `x ??= rhs` on a local binding: the current value is kept when
   * non-null, else the right side evaluates and stores. The whole
   * expression's value is the binding's post-assignment value. Celled
   * bindings write through their heap cell; plain bindings merge the
   * two SSA values through a block param.
   */
  #lowerNullishAssign(assign: AssignmentExpression, symId: SymbolId,
      celled: boolean): i32 {
    let current = if (celled) this.#cellRead(this.#cx().env[symId])
        else this.#cx().env[symId];
    if (!isRefValType(this.#valueType(current))) {
      this.#bail('nullish on non-reference');
    }
    let isNull = this.b.emit(
        IrOp.ref_is_null, new ValTypeI32() as ValType, current, -1);
    let mergeSyms = this.#assignedEnvSyms(assign.value);
    if (!celled && !this.#containsSym(mergeSyms, symId)) {
      mergeSyms.push(symId);
    }
    let assignB = this.b.newBlock();
    let skipB = this.b.newBlock();
    this.b.brIf(isNull, assignB, this.#noArgs(), skipB, this.#noArgs());

    let resultVt = this.#valueType(current);
    let saved = this.#copyEnv();
    this.b.switchTo(assignB);
    let rhs = this.#lowerExpressionCtx(assign.value, resultVt);
    if (!isValSubtype(this.#valueType(rhs), resultVt)) {
      this.#bail('nullish assign type');
    }
    if (celled) {
      this.#cellWrite(this.#cx().env[symId], rhs);
    } else {
      this.#cx().env[symId] = rhs;
    }
    let mergeB = this.b.newBlock();
    let mergeParams = this.#addParams(mergeB, mergeSyms);
    let resultParam = this.b.blockParam(mergeB, resultVt);
    let assignArgs = this.#envValues(mergeSyms);
    assignArgs.push(rhs);
    this.b.br(mergeB, assignArgs);

    this.#cx().env = this.#copyOf(saved);
    this.#cx().reachable = true;
    this.b.switchTo(skipB);
    let skipArgs = this.#envValues(mergeSyms);
    skipArgs.push(current);
    this.b.br(mergeB, skipArgs);

    this.#cx().env = saved;
    this.#applyParams(mergeSyms, mergeParams);
    this.b.switchTo(mergeB);
    this.#cx().reachable = true;
    return resultParam;
  }

  /** Whether `syms` already contains `symId`. */
  #containsSym(syms: Array<SymbolId>, symId: SymbolId): boolean {
    for (let s in syms) {
      if (s == symId) {
        return true;
      }
    }
    return false;
  }

  // -- Helpers ---------------------------------------------------------

  /** Operator -> IrOp table (see ir/operators.zena). */
  #mapBinaryOp(operator: String, vt: ValType, unsigned: boolean): IrOp {
    return mapBinaryOp(this.#cx(), operator, vt, unsigned);
  }

  /** The wasm type of an already-lowered value. */
  #valueType(value: i32): ValType {
    return this.#cx().valueTypeOf(value);
  }

  /**
   * Re-asserts a call result against the CALL NODE's checked type:
   * the checker often knows the result non-null even when the callee
   * signature stores it nullable. Void-typed calls and valueless
   * results pass through.
   */
  #reassertCallResult(call: Expression, result: i32,
      resultType: ValType | null): i32 {
    if (resultType == null || this.b.body.typeId[result] < 0) {
      return result;
    }
    let nodeType = this.func.model.getNodeType(call);
    if (nodeType != null && !(baseType(nodeType as Type) is VoidType)) {
      let want = typeToValTypeWithSub(this.wasm, nodeType as Type, this.func);
      return this.#reassertNonNull(result, want);
    }
    return result;
  }

  /**
   * Re-asserts non-nullness when the checked type is non-null but the
   * value's storage type is nullable with the same heap target. Other
   * shape differences pass through unchanged — downstream subtype
   * checks bail on actual misuse.
   */
  #reassertNonNull(value: i32, want: ValType): i32 {
    return this.#cx().reassertNonNull(value, want);
  }

  #exprValType(expr: Expression): ValType {
    return this.#cx().exprVt(expr);
  }

  /**
   * Requires the checked type of `expr` to be a signed scalar the subset
   * handles. Unsigned types share wasm representations but need _u
   * operator variants; they bail until lowering learns them.
   */
  /**
   * The checked type of `expr` with the enclosing class/method context
   * substituted: inside a FixedArray<i32> body a node checker-typed `T`
   * (or `ArrayIterator<T>`) reads as i32 (ArrayIterator<i32>) here.
   * Type-directed decisions — scalar-ness, signedness, operator-member
   * dispatch, and especially class-key resolution before
   * eraseTypeParameters — must use this rather than the raw node type:
   * the raw type can name a type parameter that is concrete in this
   * function, and erasing it unsubstituted lands on the _anyref
   * specialization where streaming (whose getNodeType substitutes)
   * uses the concrete one.
   */
  #substitutedNodeType(expr: Expression): Type | null {
    return this.#cx().substitutedNodeType(expr);
  }

  /** Base type of #substitutedNodeType (unions unwrapped by baseType). */
  #substitutedBaseType(expr: Expression): Type | null {
    let t = this.#substitutedNodeType(expr);
    if (t == null) {
      return null;
    }
    return baseType(t as Type);
  }

  #requireScalar(vt: ValType, what: String): void {
    let ok = vt is ValTypeI32 || vt is ValTypeI64 || vt is ValTypeF32 ||
        vt is ValTypeF64;
    if (!ok) {
      this.#bail(what);
    }
  }

  /**
   * Types values may HAVE in the lowered subset: scalars plus reference
   * types (concrete, anyref, eqref). Reference values only flow — the
   * operations on them are limited to null tests, identity, calls, and
   * assignment; anything else still bails at its own site.
   */
  #requireSupported(vt: ValType, what: String): void {
    this.#cx().requireSupported(vt, what);
  }

  /**
   * Lowers an expression with a contextual wasm type: null literals take
   * the context's (nullable) type, and non-null results coerce is not
   * needed — wasm subtyping covers widening at use sites.
   */
  #lowerExpressionCtx(expr: Expression, contextVt: ValType | null): i32 {
    if (expr is NullLiteral) {
      if (contextVt == null) {
        this.#bail('null without context');
      }
      let vt = contextVt as ValType;
      let nullable = vt is ValTypeRefNull || vt is ValTypeAnyRef ||
          vt is ValTypeEqRef || vt is ValTypeStructRef;
      if (!nullable) {
        this.#bail('null into non-nullable context');
      }
      return this.b.emit(IrOp.ref_null, vt, -1, -1);
    }
    return this.#lowerExpression(expr);
  }

  #assignedEnvSyms(node: Node): Array<SymbolId> {
    return this.#cx().assignedEnvSyms(node);
  }

  #appendAssignedEnvSyms(node: Node, out: Array<SymbolId>): void {
    this.#cx().appendAssignedEnvSyms(node, out);
  }

  /** Adds one block param per symbol, typed by the symbol's binding. */
  #mergeArm(m: MergeState, value: i32, armKind: String = 'arm type'): void {
    this.#cx().mergeArm(m, value, armKind);
  }

  #finishMerge(m: MergeState, saved: HashMap<SymbolId, i32>): i32 {
    return this.#cx().finishMerge(m, saved);
  }

  #addParams(block: i32, syms: Array<SymbolId>): Array<i32> {
    return this.#cx().addParams(block, syms);
  }

  #applyParams(syms: Array<SymbolId>, params: Array<i32>): void {
    this.#cx().applyParams(syms, params);
  }

  #envValues(syms: Array<SymbolId>): Array<i32> {
    return this.#cx().envValues(syms);
  }

  #copyEnv(): HashMap<SymbolId, i32> {
    return this.#cx().copyEnv();
  }

  #copyOf(source: HashMap<SymbolId, i32>): HashMap<SymbolId, i32> {
    return this.#cx().copyOf(source);
  }

  #noArgs(): Array<i32> {
    return new Array<i32>();
  }

  #oneArg(value: i32): Array<i32> {
    let result = new Array<i32>();
    result.push(value);
    return result;
  }

  /**
   * Value-conformance failure: a lowered value does not satisfy the
   * type its consumer requires. A scalar flowing into an any/eqref
   * context would need auto-boxing, which ZIR deliberately does not
   * implement (the `any` type is slated for removal) — that case
   * bails under its own permanent name so the histogram tracks it.
   */
  #failConformance(value: i32, want: ValType, reason: String): never {
    this.#cx().failConformance(value, want, reason);
    throw new ZirUnsupported(reason);
  }

  #bail(reason: String): never {
    throw new ZirUnsupported(reason + ' @' + (this.func.name ?? '?'));
  }

  #bailValue(reason: String): i32 {
    return this.#cx().fail(reason);
  }
}

// ============================================================================
// Recursion seams
// ============================================================================

/**
 * The emission modules (templates, equality, patterns, operators,
 * control-flow, intrinsics) and the member machinery in
 * lowering-context.zena lower subexpressions by importing these
 * functions back across the module cycle. `cx.host` is the owning
 * FunctionLowerer — the shared core names this class across the
 * cycle's back edge.
 */
let hostOf = (cx: LoweringContext): FunctionLowerer =>
    cx.host as FunctionLowerer;

/** Lower `e` as a value; a non-null `want` supplies the context type. */
export let lowerExpr = (cx: LoweringContext, e: Expression, want: ValType | null): i32 =>
    hostOf(cx).hostLowerExpr(e, want);

/** Adaptation-free expression lowering (see #lowerExpressionDispatch). */
export let lowerExprRaw = (cx: LoweringContext, e: Expression): i32 =>
    hostOf(cx).hostLowerExprRaw(e);

/** Lower one statement. */
export let lowerStmt = (cx: LoweringContext, st: Statement): void => {
  hostOf(cx).hostLowerStmt(st);
};

/** Lower a variable declaration (patterns, celling, env binding). */
export let varDecl = (cx: LoweringContext, vd: VariableDeclaration): void => {
  hostOf(cx).hostVarDecl(vd);
};

/** Lower a throw in statement position. */
export let throwStmt = (cx: LoweringContext, thr: ThrowExpression): void => {
  hostOf(cx).hostThrowStmt(thr);
};

/** Lower a let-condition multi-value source. */
export let multiSource = (cx: LoweringContext, init: Expression): Array<i32> =>
    hostOf(cx).hostMultiSource(init);

/** Optional-chain hit arm (member machinery). */
export let optionalHit = (cx: LoweringContext, expr: Expression, recv: i32): i32 =>
    hostOf(cx).hostOptionalHit(expr, recv);
