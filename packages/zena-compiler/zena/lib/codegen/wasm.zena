  struct_new = 0x00,
  struct_new_default = 0x01,
  struct_get = 0x02,
  struct_get_s = 0x03,
  struct_get_u = 0x04,
  struct_set = 0x05,
  array_new = 0x06,
  array_new_default = 0x07,
  array_new_fixed = 0x08,
