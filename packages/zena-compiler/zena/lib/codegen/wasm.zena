export enum SectionId {
  Type = 1,
  Import = 2,
  Function = 3,
  Table = 4,
  Memory = 5,
  Global = 6,
  Export = 7,
  Start = 8,
  Element = 9,
  Code = 10,
  Data = 11,
  DataCount = 12,
  Tag = 13
}

export enum ValType {
  void = 0x40,
  i32 = 0x7F,
  i64 = 0x7E,
  f32 = 0x7D,
  f64 = 0x7C,
}

export enum Opcode {
  end = 0x0B,
  call = 0x10,
  return_ = 0x0F,
  drop = 0x1A,
  i32_const = 0x41
}
