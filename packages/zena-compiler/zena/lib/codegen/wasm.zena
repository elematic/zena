  array_get = 0x0B,
  array_get_s = 0x0C,
  array_get_u = 0x0D,
  array_set = 0x0E,
  array_len = 0x0F,
  array_copy = 0x11,
  extern_convert_any = 0x1B,
  any_convert_extern = 0x1A,
  ref_test = 0x14,
  ref_test_null = 0x15,
