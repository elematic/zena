import { Error } from 'zena:error';
import { Hashable } from 'zena:hashable';
import { RecordType, TupleType, F64Type, F32Type, I32Type, U32Type, I64Type, U64Type, BooleanType, ClassType, ArrayType, TypeAliasType, VoidType, NullType, UnknownType, ErrorType, EqRefType, AnyRefType, NeverType, HoleType, FunctionType, Type, typeToString } from '../types.zena';
export enum SectionId {
  Type = 1,
  Import = 2,
  Function = 3,
  Table = 4,
  Memory = 5,
  Global = 6,
  Export = 7,
  Start = 8,
  Element = 9,
  Code = 10,
  Data = 11,
  DataCount = 12,
  Tag = 13
}

var _nextWasmTypeUid: i32 = 1;
export let nextWasmTypeUid = (): i32 => {
  let id = _nextWasmTypeUid;
  _nextWasmTypeUid += 1;
  return id;
};

export class WasmType implements Hashable {
  var index: i32 = -1;
  /** Process-unique id, used for identity-based cache keys. */
  uid: i32 = nextWasmTypeUid();

  /**
   * Identity hash. Without this, HashMap/HashSet keyed by WasmType fall back
   * to a constant hash and degenerate into linear scans.
   */
  hashCode(): i32 {
    return this.uid;
  }
}

export sealed class ValType {
  case ValTypeVoid
  case ValTypeFunc
  case ValTypeI32
  case ValTypeI64
  case ValTypeF32
  case ValTypeF64
  case ValTypeV128
  case ValTypeFuncRef
  case ValTypeExternRef
  case ValTypeAnyRef
  case ValTypeEqRef
  case ValTypeStructRef
  case ValTypeOptRef
  case ValTypeRef(target: WasmType)
  case ValTypeRefNull(target: WasmType)
  case ValTypeI8
  case ValTypeI16
}

export let valTypeToOpcode = (type: ValType): i32 => match (type) {
  case ValTypeVoid: 0x40
  case ValTypeFunc: 0x60
  case ValTypeI32: 0x7F
  case ValTypeI64: 0x7E
  case ValTypeF32: 0x7D
  case ValTypeF64: 0x7C
  case ValTypeV128: 0x7B
  case ValTypeFuncRef: 0x70
  case ValTypeExternRef: 0x6F
  case ValTypeAnyRef: 0x6E
  case ValTypeEqRef: 0x6D
  case ValTypeStructRef: 0x6B
  case ValTypeOptRef: 0x6C
  case ValTypeRef: 0x64
  case ValTypeRefNull: 0x63
  case ValTypeI8: 0x78
  case ValTypeI16: 0x77
};

export let valTypeEquals = (a: ValType, b: ValType): boolean => {
  if (valTypeToOpcode(a) != valTypeToOpcode(b)) {
    return false;
  }
  return match (a) {
    case ValTypeRef as ta: match (b) {
       case ValTypeRef as tb : ta.target == tb.target
       case _: false
    }
    case ValTypeRefNull as ta: match (b) {
       case ValTypeRefNull as tb : ta.target == tb.target
       case _: false
    }
    case _: true
  };
};

/** Any reference-typed ValType, concrete or abstract heap type. */
export let isRefValType = (vt: ValType): boolean => {
  return match (vt) {
    case ValTypeRef: true
    case ValTypeRefNull: true
    case ValTypeAnyRef: true
    case ValTypeEqRef: true
    case ValTypeStructRef: true
    case ValTypeFuncRef: true
    case ValTypeExternRef: true
    case _: false
  };
};

export enum HeapType {
  func = 0x70,
  extern = 0x6F,
  any = 0x6E,
  eq = 0x6D,
  struct = 0x6B,
  array = 0x6A,
  i31 = 0x6C,
  none = 0x71,
  noextern = 0x72,
  nofunc = 0x73,
}

export let heapTypeToSigned = (type: HeapType): i32 => {
  return (type as i32) - 128;
};

