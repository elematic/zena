  return_ = 0x0F,
  call = 0x10,
  local_get = 0x20,
  local_set = 0x21,
  local_tee = 0x22,
  global_get = 0x23,
  global_set = 0x24,
  i32_load = 0x28,
  i32_load8_u = 0x2D,
  i32_store = 0x36,
  i32_store8 = 0x3A,
  memory_size = 0x3F,
  memory_grow = 0x40,
  drop = 0x1A,
  gc_prefix = 0xFB,
  local_tee = 0x22,
  global_get = 0x23,
  global_set = 0x24,
  drop = 0x1A,
  i32_const = 0x41,
  i32_eqz = 0x45,
  i32_eq = 0x46,
  i32_ne = 0x47,
  i32_lt_s = 0x48,
  i32_lt_u = 0x49,
  i32_gt_s = 0x4A,
  i32_gt_u = 0x4B,
  i32_le_s = 0x4C,
  i32_le_u = 0x4D,
  i32_ge_s = 0x4E,
  i32_ge_u = 0x4F,
  i32_clz = 0x67,
  i32_ctz = 0x68,
  i32_popcnt = 0x69,
  i32_add = 0x6A,
  i32_sub = 0x6B,
  i32_mul = 0x6C,
  i32_div_s = 0x6D,
  i32_div_u = 0x6E,
  i32_rem_s = 0x6F,
  i32_rem_u = 0x70,
  i32_and = 0x71,
  i32_or = 0x72,
  i32_xor = 0x73,
  i32_shl = 0x74,
  i32_shr_s = 0x75,
  i32_shr_u = 0x76,
  f32_const = 0x43,
  f32_eq = 0x5B,
  f32_ne = 0x5C,
  f32_lt = 0x5D,
  f32_gt = 0x5E,
  f32_le = 0x5F,
  f32_ge = 0x60,
  f32_add = 0x92,
  f32_sub = 0x93,
  f32_mul = 0x94,
  f32_div = 0x95,
  f32_convert_i32_s = 0xB2,
  f64_const = 0x44,
  f64_eq = 0x61,
  f64_ne = 0x62,
  f64_lt = 0x63,
  f64_gt = 0x64,
  f64_le = 0x65,
  f64_ge = 0x66,
  f64_add = 0xA0,
  f64_sub = 0xA1,
  f64_mul = 0xA2,
  f64_div = 0xA3,
  f64_convert_i32_s = 0xB7,
  ref_null = 0xD0,
  ref_func = 0xD2,
  ref_eq = 0xD3,
  call_ref = 0x14
}

export let typeToValType = (t: Type): ValType => match (t) {
  case TypeAliasType as a: typeToValType(a.target)
  case F64Type: ValType.f64
  case F32Type: ValType.f32
  case I32Type: ValType.i32
  case U32Type: ValType.i32
  case I64Type: ValType.i64
  case U64Type: ValType.i64
  case BooleanType: ValType.i32
  case RecordType: ValType.anyref
  case ClassType: ValType.anyref
  case ArrayType: ValType.anyref
  case VoidType: ValType.void
  case NullType: ValType.anyref
  case UnknownType: ValType.anyref
  case ErrorType: ValType.anyref
  case AnyType: ValType.anyref
  case AnyRefType: ValType.anyref
  case EqRefType: ValType.eqref
  case NeverType: ValType.void
  case HoleType: ValType.anyref
  case FunctionType: ValType.funcref
  
  // We can add more specific mappings here as we implement them!
  case _: {
     throw new Error("typeToValType: unsupported type: " + typeToString(t));
  }
};
