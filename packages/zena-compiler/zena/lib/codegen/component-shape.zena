// What a component wraps around the core module: which WIT interfaces it
// imports, which core exports it lifts, and the component-level types of
// both.
//
// Read off the same `WasmModule` the core module was emitted from, so
// the two cannot disagree about what exists: the import list is
// `functionImports` in emission order, and the export list is the
// program's own exports (`exportMap`) — the synthesized host-interop
// helpers ($stringCreate and friends, __zena_drain) stay core-module
// exports, because they exist for an embedder that instantiates the core
// module directly and have no component-level meaning.
//
// Types come from the *Zena* signature rather than the wasm one. A wasm
// `i32` is `s32`, `u32`, `u8`, `bool` and four more, and an import's
// declared type has to match what the host actually exports — so
// throwing away the Zena type and re-deriving it from the lowered form
// would be a guess. See docs/design/component-emission.md, Part 4.

import { Array } from 'zena:array';
import { Error } from 'zena:error';
import { String } from 'zena:string';
import { WasmModule, WasmFunction } from './wasm-module.zena';
import { Node } from '../ast.zena';
import {
  Type, FunctionType, TypeAliasType, ClassType, I32Type, U32Type, I64Type,
  U64Type, F32Type, F64Type, U8Type, U16Type, I8Type, I16Type, BooleanType,
  VoidType, typeToString
} from '../types.zena';
import { i32ToString } from 'zena:string-convert';
import {
  ComponentShape, ComponentImportFunc, ComponentExportFunc, ComponentFuncType,
  ComponentCanonBuiltin, ComponentValType, noComponentResult, isKebabName,
  toKebabName, canonNamespace, isKnownCanonBuiltin, componentEntryExport,
  componentCallbackExport, componentTypeNeedsMemory,
  componentSignatureNeedsMemory
} from './component-emitter.zena';

/** Look through type aliases (`type`, `distinct type`) to the type itself. */
let underlying = (t: Type): Type => match (t) {
  case TypeAliasType as alias: underlying(alias.target)
  case _: t
};

/**
 * Whether `t` is the standard library's `String`, compared by identity
 * against the class the module already found rather than by name. A
 * program is free to declare a `String` of its own, and it does not
 * cross the boundary as `string`.
 */
let isStringType = (wasm: WasmModule, t: Type): boolean => {
  let stringClass = wasm.stringClass;
  if (stringClass == null) {
    return false;
  }
  let u = underlying(t);
  if (!(u is ClassType)) {
    return false;
  }
  return (u as ClassType).symbolId == (stringClass as ClassType).symbolId;
};

/**
 * The component-level type of a Zena parameter or result type, or -1 if
 * it has none.
 *
 * The flat scalars need nothing but their opcode. `String` is the one
 * type beyond them so far, and it is a different kind of thing: the
 * component-level value is bytes in linear memory, so a signature
 * carrying one also carries the canonical options and a synthesized
 * wrapper to do the copying. Everything else still waits on C3's type
 * encoder.
 */
export let componentTypeOf = (wasm: WasmModule, t: Type): i32 => {
  if (isStringType(wasm, t)) {
    return ComponentValType.String as i32;
  }
  return match (underlying(t)) {
    case I32Type: ComponentValType.S32 as i32
    case U32Type: ComponentValType.U32 as i32
    case I64Type: ComponentValType.S64 as i32
    case U64Type: ComponentValType.U64 as i32
    case F32Type: ComponentValType.F32 as i32
    case F64Type: ComponentValType.F64 as i32
    case U8Type: ComponentValType.U8 as i32
    case U16Type: ComponentValType.U16 as i32
    case I8Type: ComponentValType.S8 as i32
    case I16Type: ComponentValType.S16 as i32
    case BooleanType: ComponentValType.Bool as i32
    case _: -1
  };
};

/** The `FunctionType` a function was declared with. */
export let declaredTypeOf = (func: WasmFunction, what: String): FunctionType => {
  let node = func.node;
  if (node == null) {
    throw new Error(
      "The component target cannot " + what + " '" + nameOf(func) +
        "': it has no declaration to read a signature from."
    );
  }
  let t = func.model.getNodeType(node);
  if (t == null || !(t is FunctionType)) {
    throw new Error(
      "The component target cannot " + what + " '" + nameOf(func) +
        "': its declaration has no function type."
    );
  }
  return t;
};

let nameOf = (func: WasmFunction): String => {
  let n = func.name;
  if (n != null) {
    return n;
  }
  let m = func.methodName;
  if (m != null) {
    return m;
  }
  return "<unnamed>";
};

/**
 * A parameter's name at the component level. Zena identifiers are
 * camelCase and cannot contain `-`, while the Component Model's names
 * are kebab-case, so the identifier is converted. Where it has no valid
 * rendering, the position stands in: parameter names take no part in
 * import subtyping — a component importing `wait-for` with the
 * parameter named `how-longx` links against a host declaring
 * `how-long` — so the name is documentation, and only its *shape* is
 * load-bearing.
 */
let paramName = (declared: FunctionType, index: i32): String => {
  let names = declared.parameterNames;
  if (names != null) {
    let list = names;
    if (index < list.length) {
      let kebab = toKebabName(list[index]);
      if (kebab != "") {
        return kebab;
      }
    }
  }
  return "a" + i32ToString(index);
};

/** What the boundary carries so far, for the message that says it does not. */
let crossesToday = (): String =>
    "Only u8-u64, i8-i64, f32, f64, boolean and String cross the boundary " +
    "today; richer types need C3's type encoder " +
    "(docs/design/component-emission.md).";

/**
 * A `string` can be lifted but not yet lowered, and the reason is
 * structural rather than a missing case.
 *
 * Lifting happens after instantiation, so an export takes its memory and
 * `realloc` from the program module's own exports. A lowered *import*
 * has to exist before the module is instantiated — it is one of the
 * module's imports — so its memory has to come from somewhere that
 * exists earlier, which means a second core module owning linear memory
 * and the allocator. See docs/design/component-emission.md 1.3; it is
 * what C3 builds for stdio.
 */
let checkMemoryDirection = (
  mapped: i32,
  func: WasmFunction,
  what: String
): void => {
  if (what == "import" && componentTypeNeedsMemory(mapped)) {
    throw new Error(
      "The component target cannot import '" + nameOf(func) +
        "': it carries a string, and lowering one needs a memory that " +
        "exists before the program module is instantiated. Exports can " +
        "carry strings today; imports wait on the runtime memory module " +
        "(docs/design/component-emission.md 1.3)."
    );
  }
};

/**
 * The component-level signature of a function, or a loud failure.
 *
 * `isAsync` is part of the *type*, not just the lowering: the canonical
 * `async` option is only legal against a function type that is itself
 * async, which is the format saying the two cannot disagree.
 */
let signatureOf = (
  wasm: WasmModule,
  func: WasmFunction,
  what: String,
  isAsync: boolean = false
): ComponentFuncType => {
  let declared = declaredTypeOf(func, what);
  let paramTypes = new Array<i32>();
  let paramNames = new Array<String>();
  for (var i = 0; i < declared.parameters.length; i += 1) {
    let mapped = componentTypeOf(wasm, declared.parameters[i]);
    if (mapped < 0) {
      throw new Error(
        "The component target cannot " + what + " '" + nameOf(func) +
          "': parameter " + i32ToString(i) + " has type '" +
          typeToString(declared.parameters[i]) + "'. " + crossesToday()
      );
    }
    checkMemoryDirection(mapped, func, what);
    paramTypes.push(mapped);
    paramNames.push(paramName(declared, i));
  }
  var result = noComponentResult;
  if (isAsync) {
    // An async-lowered call returns a *subtask handle*, packed with a
    // status — that is the core signature the canonical ABI hands the
    // guest, and it has nothing to do with the WIT function's own
    // result. The declaration says `i32` because that is what the call
    // evaluates to in Zena; the interface type says nothing, because a
    // WIT function that returns something under an async lowering
    // delivers it through the subtask, which needs C6's futures.
    if (!(underlying(declared.returnType) is I32Type)) {
      throw new Error(
        "The async-lowered import '" + nameOf(func) + "' must be declared " +
          "to return i32, the packed subtask handle the canonical ABI " +
          "hands back. It returns '" + typeToString(declared.returnType) +
          "'."
      );
    }
    return new ComponentFuncType(paramTypes, paramNames, result, true);
  }
  if (!(underlying(declared.returnType) is VoidType)) {
    result = componentTypeOf(wasm, declared.returnType);
    if (result < 0) {
      throw new Error(
        "The component target cannot " + what + " '" + nameOf(func) +
          "': it returns '" + typeToString(declared.returnType) + "'. " +
          crossesToday()
      );
    }
    checkMemoryDirection(result, func, what);
  }
  return new ComponentFuncType(paramTypes, paramNames, result, isAsync);
};

/**
 * The shape of the component wrapping `wasm`'s core module.
 *
 * Throws rather than dropping anything it cannot represent. A dropped
 * import would produce a component that fails to instantiate against a
 * host that has the function, and a dropped export would produce one
 * silently missing the entry point the program wrote — both worse than
 * a compile error naming the function.
 */
export let buildComponentShape = (wasm: WasmModule): ComponentShape => {
  let shape = new ComponentShape();

  for (let f in wasm.functionImports) {
    let module = f.importModule;
    let field = f.importName;
    if (module == null || field == null) {
      continue;
    }
    let interfaceName = module;
    let fieldName = field;
    // The canonical builtins: functions the ABI itself provides, with
    // no interface to import them from and no type to declare. The core
    // module still imports them, so they need a namespace.
    if (interfaceName == canonNamespace) {
      if (!isKnownCanonBuiltin(fieldName)) {
        throw new Error(
          "'" + fieldName + "' is not a canonical builtin this compiler " +
            "can emit. Known: waitable-set.new, waitable-set.drop, " +
            "waitable.join, subtask.drop, task.return."
        );
      }
      var builtinResult = noComponentResult;
      if (fieldName == "task.return") {
        // `task.return` carries the lifted task's result, so its type
        // comes from what the declaration takes, not from what it
        // returns.
        let declared = declaredTypeOf(f, "import");
        if (declared.parameters.length == 1) {
          builtinResult = componentTypeOf(wasm, declared.parameters[0]);
          if (builtinResult < 0) {
            throw new Error(
              "task.return takes '" +
                typeToString(declared.parameters[0]) +
                "', which is not a flat scalar."
            );
          }
        } else if (declared.parameters.length > 1) {
          throw new Error(
            "task.return takes at most one value, the lifted task's result."
          );
        }
      }
      shape.builtins.push(new ComponentCanonBuiltin(fieldName, builtinResult));
      continue;
    }
    if (!interfaceName.contains(":")) {
      throw new Error(
        "The component target cannot import '" + fieldName + "' from '" +
          interfaceName + "': a component imports WIT interfaces, and '" +
          interfaceName + "' is a core-module import namespace. Name a WIT " +
          "interface, as in @external(\"wasi:clocks/monotonic-clock@0.3.0\", " +
          "\"now\")."
      );
    }
    if (!isKebabName(fieldName)) {
      throw new Error(
        "The component target cannot import '" + fieldName + "' from '" +
          interfaceName + "': '" + fieldName + "' is not a kebab-case name, " +
          "so no WIT interface can export it."
      );
    }
    shape.imports.push(
      new ComponentImportFunc(interfaceName, fieldName,
          signatureOf(wasm, f, "import", f.importIsAsync), f.importIsAsync));
  }

  // The async entry, where the program links a driver that needs one.
  // It replaces `main` rather than joining it: `main` on its own would
  // return before the timers it armed have fired, and lifting both
  // would offer the host two entry points that mean different things.
  let entry = wasm.componentEntryFunc;
  if (entry != null) {
    let callback = wasm.componentCallbackFunc;
    if (callback == null) {
      throw new Error(
        "The component target has an async entry with no callback to " +
        "re-enter it through."
      );
    }
    shape.exports.push(new ComponentExportFunc(
      componentEntryExport, "run",
      new ComponentFuncType(new Array<i32>(), new Array<String>(),
          noComponentResult, true),
      componentCallbackExport));
  }

  let exportKeys = wasm.exportMap.keys();
  while (let (true, key) = exportKeys.next()) {
    let f = wasm.exportMap[key];
    let coreName = key as String;
    if (entry != null && coreName == "main") {
      continue;
    }
    let exportName = toKebabName(coreName);
    if (exportName == "") {
      throw new Error(
        "The component target cannot export '" + coreName +
          "': it has no kebab-case rendering, and every component export " +
          "name is kebab-case."
      );
    }
    let signature = signatureOf(wasm, f, "export");
    // An export carrying a string is lifted through its wrapper rather
    // than directly: the canonical ABI hands the guest a pointer and a
    // length, and the Zena function takes a String. The wrapper is what
    // the two have in common, and it is synthesized before layout —
    // absent here means the synth pass and this disagree about which
    // signatures carry one, which is a compiler bug rather than a
    // program error.
    var lifted = coreName;
    if (let (true, wrapper) = wasm.componentExportWrappers.get(key)) {
      let wrapperName = wrapper.name;
      if (wrapperName == null) {
        throw new Error("The component export wrapper for '" + coreName +
            "' has no name to alias it by.");
      }
      lifted = wrapperName as String;
    } else if (componentSignatureNeedsMemory(signature)) {
      throw new Error("The component export '" + coreName +
          "' carries a string with no wrapper synthesized for it.");
    }
    shape.exports.push(
      new ComponentExportFunc(lifted, exportName, signature));
  }

  return shape;
};
