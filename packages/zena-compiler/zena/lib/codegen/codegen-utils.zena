import { 
  Node, MethodDefinition, FieldDefinition, AccessorDeclaration, MixinDeclaration, ClassDeclaration, TypeAnnotation, NodeId, Identifier
} from '../ast.zena';
import { 
  Type, I32Type, U32Type, I64Type, U64Type, F32Type, F64Type,
  U8Type, U16Type, I8Type, I16Type, V128Type, BooleanType, BoolLiteralType,
  NullType, VoidType, ClassType, InterfaceType, ArrayType, RecordType,
  TupleType, InlineTupleType, UnionType, TypeParameterType, FunctionType, UnknownType, typeToString,
  MixinType, MixinKey, instantiateClassType, TypeAliasType, ErrorType, HoleType, NeverType, ThisType,
  AnyRefType, EqRefType, StringLiteralType, NumLiteralType, baseType, ErasedType} from '../types.zena';
import { SemanticModel } from '../semantic-model.zena';
import { Symbol, noSymbolId } from '../scope/symbol.zena';
import { String } from "zena:string";
import { i32ToString } from "zena:string-convert";
import { Array } from 'zena:array';
import { FixedArray } from 'zena:fixed-array';
import { GrowableArray } from 'zena:growable-array';
import { HashMap } from 'zena:map';
import { Program } from '../program.zena';
import { Hashable } from 'zena:hashable';

export { MixinKey } from '../types.zena';

@intrinsic('hash')
declare function hash<T>(value: T): i32;



/**
 * The hidden i64 bitmask fields carrying optional-field presence on a
 * record struct (docs/design/record-presence.md §2). Word w holds bits
 * for optional fields 64*w .. 64*w+63 in canonical sorted name order.
 * The suffix is zero-padded so canonical field sorting keeps the words
 * in index order.
 */
export let presentWordName = (word: i32): String => {
  var suffix = i32ToString(word);
  while (suffix.length < 3) {
    suffix = '0' + suffix;
  }
  return '$present' + suffix;
};

export let isPresentWordName = (name: String): boolean => {
  return name.length == 11 && name.sliceBytes(0, 8) == '$present';
};

export let presentWordCount = (optionalCount: i32): i32 => {
  return (optionalCount + 63) >> 6;
};

// TODO: Add string comparison to the stdlib and use that instead.
export let compareStrings = (a: String, b: String): i32 => {
  let lenA = a.length;
  let lenB = b.length;
  var minLen = lenA;
  if (lenB < lenA) {
    minLen = lenB;
  }
  
  for (var i = 0; i < minLen; i += 1) {
    let byteA = a.getByteAt(i);
    let byteB = b.getByteAt(i);
    if (byteA < byteB) return -1;
    if (byteA > byteB) return 1;
  }
  
  if (lenA < lenB) return -1;
  if (lenA > lenB) return 1;
  return 0;
};

export let getMemberRootClass = (ct: ClassType, memberName: String): ClassType => {
  var rootClass = ct;
  var currClass = ct.superType;
  while (currClass != null) {
    let superCt = currClass;
    if (superCt.isMixinIntermediate) {
      currClass = superCt.superType;
      continue;
    }
    var hasMember = superCt.members.has(memberName);
    if (!hasMember && memberName.startsWith("get#")) {
      let propName = memberName.sliceBytes(4, memberName.length);
      hasMember = superCt.members.has(propName);
    }
    if (!hasMember && memberName.startsWith("set#")) {
      let propName = memberName.sliceBytes(4, memberName.length);
      hasMember = superCt.members.has(propName);
    }
    if (hasMember) {
      rootClass = superCt;
    }
    currClass = superCt.superType;
  }
  return rootClass;
};

export distinct type ClassKey = String;
export distinct type InterfaceKey = String;
export distinct type CellKey = String;
export distinct type ClosureKey = String;
export distinct type ExportKey = String;
export distinct type ExportGlobalKey = String;

export final class ClassInterfaceKey implements Hashable {
  classKey: ClassKey;
  interfaceKey: InterfaceKey;
  new(this.classKey, this.interfaceKey);

  hashCode(): i32 {
    return hash(this.classKey) ^ hash(this.interfaceKey);
  }

  operator ==(other: ClassInterfaceKey): boolean {
    return this.classKey == other.classKey && this.interfaceKey == other.interfaceKey;
  }
}

export final class InterfaceMemberKey implements Hashable {
  interfaceKey: InterfaceKey;
  memberName: String;
  new(this.interfaceKey, this.memberName);

  hashCode(): i32 {
    return hash(this.interfaceKey) ^ hash(this.memberName);
  }

  operator ==(other: InterfaceMemberKey): boolean {
    return this.interfaceKey == other.interfaceKey && this.memberName == other.memberName;
  }
}

export final class ClassMethodKey implements Hashable {
  classKey: ClassKey;
  methodName: String;
  new(this.classKey, this.methodName);

  hashCode(): i32 {
    return hash(this.classKey) ^ hash(this.methodName);
  }

  operator ==(other: ClassMethodKey): boolean {
    return this.classKey == other.classKey && this.methodName == other.methodName;
  }
}

export final class ClosureSpecializationKey implements Hashable {
  closureId: NodeId;
  classKey: ClassKey;
  new(this.closureId, this.classKey);

  hashCode(): i32 {
    return (this.closureId as i32) ^ hash(this.classKey);
  }

  operator ==(other: ClosureSpecializationKey): boolean {
    return this.closureId == other.closureId && this.classKey == other.classKey;
  }
}

export final class FunctionAdaptationKey implements Hashable {
  src: Type;
  tgt: Type;
  new(this.src, this.tgt);

  hashCode(): i32 {
    return hash(getTypeUniqueKey(this.src)) ^ hash(getTypeUniqueKey(this.tgt));
  }

  operator ==(other: FunctionAdaptationKey): boolean {
    return getTypeUniqueKey(this.src) == getTypeUniqueKey(other.src) && getTypeUniqueKey(this.tgt) == getTypeUniqueKey(other.tgt);
  }
}

export final class FunctionValueWrapperKey implements Hashable {
  keyName: String;
  signatureKey: String;
  new(this.keyName, this.signatureKey);

  hashCode(): i32 {
    return hash(this.keyName) ^ hash(this.signatureKey);
  }

  operator ==(other: FunctionValueWrapperKey): boolean {
    return this.keyName == other.keyName && this.signatureKey == other.signatureKey;
  }
}

export final class SpecializedFunctionKey implements Hashable {
  baseName: String;
  typeArgs: Array<Type>;
  new(this.baseName, this.typeArgs);

  hashCode(): i32 {
    var h = hash(this.baseName);
    for (let arg in this.typeArgs) {
      h = h ^ hash(getTypeKeyForSpecialization(arg));
    }
    return h;
  }

  operator ==(other: SpecializedFunctionKey): boolean {
    if (this.baseName != other.baseName || this.typeArgs.length != other.typeArgs.length) {
      return false;
    }
    for (var i = 0; i < this.typeArgs.length; i += 1) {
      if (getTypeKeyForSpecialization(this.typeArgs[i]) != getTypeKeyForSpecialization(other.typeArgs[i])) {
        return false;
      }
    }
    return true;
  }
}

// `typeContainsTypeParameter` moved to types.zena (it is a pure function over
// Type, and the checker needs it too). Re-exported here for existing callers.
export { typeContainsTypeParameter } from '../types.zena';

export let isConcrete = (t: Type): boolean => {
  return match (t) {
    case TypeParameterType: false
    // An erasure is concrete in the sense this predicate asks about: it
    // is a type, and a slot can hold it. It is NOT something to emit
    // code for — nothing is ever registered at an erasure now (see
    // containsErasedType and registerSpecializedClass), so callers that
    // mean "should this get a body?" must ask that instead.
    case ErasedType: true
    case UnknownType: false
    case ErrorType: false
    case HoleType: false
    case NeverType: false
    case ThisType: false
    case ClassType as ct: {
      let {typeParameters} = ct;
      if (typeParameters != null && typeParameters.length > 0) {
        let args = ct.typeArguments;
        if (args == null) {
          return false;
        }
        var i = 0;
        var concrete = true;
        while (i < args.length) {
          if (!isConcrete(args[i])) { concrete = false; }
          i += 1;
        }
        concrete
      } else {
        true
      }
    }
    case InterfaceType as it: {
      let {typeParameters} = it;
      if (typeParameters != null && typeParameters.length > 0) {
        let args = it.typeArguments;
        if (args == null) {
          return false;
        }
        var i = 0;
        var concrete = true;
        while (i < args.length) {
          if (!isConcrete(args[i])) { concrete = false; }
          i += 1;
        }
        concrete
      } else {
        true
      }
    }
    case ArrayType {elementType}: isConcrete(elementType)
    case TupleType {elementTypes}: {
      var concrete = true;
      for (let el in elementTypes) {
        if (!isConcrete(el)) { concrete = false; }
      }
      concrete
    }
    case InlineTupleType {elementTypes}: {
      var concrete = true;
      for (let el in elementTypes) {
        if (!isConcrete(el)) { concrete = false; }
      }
      concrete
    }
    case UnionType {types}: {
      var concrete = true;
      for (let ut in types) {
        if (!isConcrete(ut)) { concrete = false; }
      }
      concrete
    }
    case RecordType as rec: {
      var concrete = true;
      let keys = rec.properties.keys();
      while (let (true, key) = keys.next()) {
        if (!isConcrete(rec.properties[key])) { concrete = false; }
      }
      concrete
    }
    case FunctionType as ft: {
      var concrete = true;
      for (let p in ft.parameters) {
        if (!isConcrete(p)) { concrete = false; }
      }
      if (!isConcrete(ft.returnType)) { concrete = false; }
      concrete
    }
    case _: true
  };
};


export let getTypeKeyForSpecialization = (t: Type): String => {
  let cached = t.specializationKeyCache;
  if (cached != null) {
    return cached;
  }
  let key = getTypeKeyForSpecializationRaw(t);
  t.specializationKeyCache = key;
  return key;
};

let getTypeKeyForSpecializationRaw = (type: Type): String => {
  return match (type) {
    case I32Type: "i32"
    case U32Type: "u32"
    case I64Type: "i64"
    case U64Type: "u64"
    case F32Type: "f32"
    case F64Type: "f64"
    case U8Type: "u8"
    case U16Type: "u16"
    case I8Type: "i8"
    case I16Type: "i16"
    case V128Type: "v128"
    case BooleanType: "bool"
    case BoolLiteralType: "bool"
    case NullType: "null"
    case VoidType: "void"
    case ClassType as ct: {
      let symId = (ct.genericSource ?? ct).symbolId;
      let base = if (symId != noSymbolId) {
        ct.name + "_s" + i32ToString(symId as i32)
      } else {
        let baseId = if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id;
        ct.name + "_t" + i32ToString(baseId as i32)
      };
      let {typeArguments} = ct;
      if (typeArguments != null && typeArguments.length > 0 && isConcrete(ct)) {
        let args = typeArguments;
        let parts = new FixedArray<String>(1 + 2 * args.length, "");
        parts[0] = base;
        var i = 0;
        while (i < args.length) {
          parts[1 + 2 * i] = "_";
          parts[2 + 2 * i] = getTypeKeyForSpecialization(args[i]);
          i += 1;
        }
        String.fromParts(parts as array<String>)
      } else {
        base
      }
    }
    case InterfaceType as it: {
      let symId = (it.genericSource ?? it).symbolId;
      let base = if (symId != noSymbolId) {
        it.name + "_s" + i32ToString(symId as i32)
      } else {
        let baseId = if (it.genericSource != null) (it.genericSource as InterfaceType).id else it.id;
        it.name + "_t" + i32ToString(baseId as i32)
      };
      let {typeArguments} = it;
      if (typeArguments != null && typeArguments.length > 0 && isConcrete(it)) {
        let args = typeArguments;
        let parts = new FixedArray<String>(1 + 2 * args.length, "");
        parts[0] = base;
        var i = 0;
        while (i < args.length) {
          parts[1 + 2 * i] = "_";
          parts[2 + 2 * i] = getTypeKeyForSpecialization(args[i]);
          i += 1;
        }
        String.fromParts(parts as array<String>)
      } else {
        base
      }
    }
    case ArrayType {elementType}: `arr_${getTypeKeyForSpecialization(elementType)}`
    case RecordType as rec: {
      let len = rec.properties.size;
      let parts = new FixedArray<String>(1 + 4 * len, "");
      parts[0] = "rec";
      let keys = rec.properties.keys();
      var i = 0;
      while (let (true, key) = keys.next()) {
        parts[1 + 4 * i] = "_";
        parts[2 + 4 * i] = if (rec.isOptional(key)) key + "?" else key;
        parts[3 + 4 * i] = "_";
        parts[4 + 4 * i] = getTypeKeyForSpecialization(rec.properties[key]);
        i += 1;
      }
      String.fromParts(parts as array<String>)
    }
    case TupleType {elementTypes}: {
      let parts = new FixedArray<String>(1 + 2 * elementTypes.length, "");
      parts[0] = "tup";
      var i = 0;
      while (i < elementTypes.length) {
        parts[1 + 2 * i] = "_";
        parts[2 + 2 * i] = getTypeKeyForSpecialization(elementTypes[i]);
        i += 1;
      }
      String.fromParts(parts as array<String>)
    }
    case InlineTupleType {elementTypes}: {
      let parts = new FixedArray<String>(1 + 2 * elementTypes.length, "");
      parts[0] = "itup";
      var i = 0;
      while (i < elementTypes.length) {
        parts[1 + 2 * i] = "_";
        parts[2 + 2 * i] = getTypeKeyForSpecialization(elementTypes[i]);
        i += 1;
      }
      String.fromParts(parts as array<String>)
    }
    // A type parameter and its erasure key the SAME — a specialization
    // named with `T` still standing and one named with `T` erased are
    // the same physical shape, a top-typed slot — and both key APART
    // from the real `anyref` type, which is a type a program can write
    // and construct. Spelling all three "anyref" made an erasure pass
    // `isConcrete` and gave RTA classes to build for types no value
    // has; see ErasedType in types.zena.
    case TypeParameterType as tp: "erased"
    case ErasedType: "erased"
    case UnionType {types}: {
      let parts = new FixedArray<String>(1 + 2 * types.length, "");
      parts[0] = "union";
      var i = 0;
      while (i < types.length) {
        parts[1 + 2 * i] = "_";
        parts[2 + 2 * i] = getTypeKeyForSpecialization(types[i]);
        i += 1;
      }
      String.fromParts(parts as array<String>)
    }
    case FunctionType as ft: {
      let parts = new FixedArray<String>(3 + 2 * ft.parameters.length, "");
      parts[0] = "func";
      var i = 0;
      while (i < ft.parameters.length) {
        parts[1 + 2 * i] = "_";
        parts[2 + 2 * i] = getTypeKeyForSpecialization(ft.parameters[i]);
        i += 1;
      }
      parts[1 + 2 * ft.parameters.length] = "_";
      parts[2 + 2 * ft.parameters.length] = getTypeKeyForSpecialization(ft.returnType);
      String.fromParts(parts as array<String>)
    }
    case TypeAliasType as ta: getTypeKeyForSpecialization(ta.target)
    case NeverType: "never"
    case HoleType: "hole"
    case ErrorType: "error"
    case UnknownType: "unknown"
    case AnyRefType: "anyref"
    case EqRefType: "eqref"
    case StringLiteralType: "string"
    case NumLiteralType: "number"
    case ThisType: "this"
    case _: "unknown"
  };
};

/**
 * Whether `t` is, or contains, the erasure of a type parameter.
 *
 * This is the structural test that used to need context: an erasure and
 * the real top type are now different types (ErasedType in types.zena),
 * so "did this mention come from inside generic code" is a question
 * about the type itself rather than about which walk produced it.
 */
export let containsErasedType = (t: Type): boolean => {
  return match (t) {
    case ErasedType: true
    // A type parameter still standing and its erasure key the SAME
    // (getTypeKeyForSpecialization), so `Array<T>` and `Array<erased>`
    // ARE one class — `Array_s777_erased`. They must classify the same
    // here too: a mention carrying a bare `T` is an erasure that has
    // not been spelled yet, not a specialization.
    case TypeParameterType: true
    case ArrayType {elementType}: containsErasedType(elementType)
    case ClassType as ct: {
      if (ct.typeArguments == null) { return false; }
      for (let arg in ct.typeArguments as Array<Type>) {
        if (containsErasedType(arg)) { return true; }
      }
      false
    }
    case InterfaceType as it: {
      if (it.typeArguments == null) { return false; }
      for (let arg in it.typeArguments as Array<Type>) {
        if (containsErasedType(arg)) { return true; }
      }
      false
    }
    case MixinType as mt: {
      if (mt.typeArguments == null) { return false; }
      for (let arg in mt.typeArguments as Array<Type>) {
        if (containsErasedType(arg)) { return true; }
      }
      false
    }
    case UnionType {types}: {
      for (let sub in types) {
        if (containsErasedType(sub)) { return true; }
      }
      false
    }
    case TupleType {elementTypes}: {
      for (let sub in elementTypes) {
        if (containsErasedType(sub)) { return true; }
      }
      false
    }
    case InlineTupleType {elementTypes}: {
      for (let sub in elementTypes) {
        if (containsErasedType(sub)) { return true; }
      }
      false
    }
    case FunctionType as ft: {
      for (let p in ft.parameters) {
        if (containsErasedType(p)) { return true; }
      }
      containsErasedType(ft.returnType)
    }
    case _: false
  };
};

export let getSpecializedName = (baseName: String, typeArgs: Array<Type>): String => {
  let len = typeArgs.length;
  let parts = new FixedArray<String>(2 + 2 * len, "");
  parts[0] = baseName;
  parts[1] = "_spec";
  var i = 0;
  while (i < len) {
    parts[2 + 2 * i] = "_";
    parts[3 + 2 * i] = getTypeKeyForSpecialization(typeArgs[i]);
    i += 1;
  }
  return String.fromParts(parts as array<String>);
};

export let getClassKey = (ct: ClassType): ClassKey => {
  let cached = ct.classKey;
  if (cached != null) {
    return cached as ClassKey;
  }
  let key = getTypeKeyForSpecialization(ct) as ClassKey;
  ct.classKey = key as String;
  return key;
};

export let getInterfaceKey = (it: InterfaceType): InterfaceKey => {
  let cached = it.interfaceKey;
  if (cached != null) {
    return cached as InterfaceKey;
  }
  let key = getTypeKeyForSpecialization(it) as InterfaceKey;
  it.interfaceKey = key as String;
  return key;
};

/**
 * Resolves or constructs the MixinKey for the generic mixin declaration.
 * Note that this ignores any parameterized type arguments on the MixinType,
 * since the layout and reachability caches care only about the base mixin declaration.
 */
export let getMixinKey = (mt: MixinType): MixinKey => {
  let cached = mt.mixinKeyCache;
  if (cached != null) {
    return cached;
  }
  let key = new MixinKey(mt.sourcePath, mt.name);
  mt.mixinKeyCache = key;
  return key;
};

export let getMixinKeyFromSymbol = (model: SemanticModel, sym: Symbol): MixinKey => {
  let mt = model.getBindingType(sym);
  if (mt == null || !(mt is MixinType)) {
    throw new Error(`Symbol is not a mixin: ${sym.name}`);
  }
  return getMixinKey(mt);
};

export let getClassInterfaceKey = (classKey: ClassKey, interfaceKey: InterfaceKey): ClassInterfaceKey => {
  return new ClassInterfaceKey(classKey, interfaceKey);
};

export let getInterfaceMemberKey = (interfaceKey: InterfaceKey, memberName: String): InterfaceMemberKey => {
  return new InterfaceMemberKey(interfaceKey, memberName);
};

export let getClassPrivateFieldKey = (classKey: ClassKey, fieldName: String): String => {
  return `${classKey as String}::${fieldName}`;
};

export let getClassInterfaceVTableName = (cName: ClassKey, iName: InterfaceKey): String => {
  return `${cName as String}_${iName as String}_vtable`;
};

export let getInterfaceTrampolineName = (cName: ClassKey, iName: InterfaceKey, fieldName: String): String => {
  return `${cName as String}_${iName as String}_${fieldName}_trampoline`;
};

export let getClassVTableName = (cName: ClassKey): String => {
  return `${cName as String}_vtable`;
};

export let getClassSingletonName = (cName: ClassKey): String => {
  return `${cName as String}_singleton`;
};

export let classInterfaceKeyToString = (key: ClassInterfaceKey): String => {
  return (key.classKey as String) + "::" + (key.interfaceKey as String);
};


export let getTypeKey = (type: Type): String => {
  return match (type) {
    case I32Type: "i32"
    case U32Type: "u32"
    case I64Type: "i64"
    case U64Type: "u64"
    case F32Type: "f32"
    case F64Type: "f64"
    case U8Type: "u8"
    case U16Type: "u16"
    case I8Type: "i8"
    case I16Type: "i16"
    case V128Type: "v128"
    case BooleanType: "bool"
    case BoolLiteralType: "bool"
    case NullType: "null"
    case VoidType: "void"
    case ClassType as ct: ct.name
    case InterfaceType as it: it.name
    case ArrayType {elementType}: `arr_${getTypeKey(elementType)}`
    case RecordType: "rec"
    case TupleType {elementTypes}: `tup${i32ToString(elementTypes.length)}`
    case InlineTupleType {elementTypes}: `tup${i32ToString(elementTypes.length)}`
    case UnionType: "union"
    // A type parameter and its erasure key the SAME — a specialization
    // named with `T` still standing and one named with `T` erased are
    // the same physical shape, a top-typed slot — and both key APART
    // from the real `anyref` type, which is a type a program can write
    // and construct. Spelling all three "anyref" made an erasure pass
    // `isConcrete` and gave RTA classes to build for types no value
    // has; see ErasedType in types.zena.
    case TypeParameterType as tp: "erased"
    case ErasedType: "erased"
    case _: "unknown"
  };
};

export let getSignatureKey = (funcType: FunctionType): String => {
  let len = funcType.parameters.length;
  if (len == 0) {
    return "$void";
  }
  let parts = new FixedArray<String>(2 * len, "");
  var i = 0;
  while (i < len) {
    parts[2 * i] = "$";
    parts[2 * i + 1] = getTypeKey(funcType.parameters[i]);
    i += 1;
  }
  return String.fromParts(parts as array<String>);
};

export let matchOverload = (moduleModel: SemanticModel, ft: FunctionType, mDef: MethodDefinition): FunctionType | null => {
  if (ft.overloads == null) {
    return null;
  }
  let paramTypes = new GrowableArray<Type>();
  for (let p in mDef.params) {
    let sym = moduleModel.resolveDeclaration(p as Node);
    if (sym != null) {
      let pType = moduleModel.getBindingType(sym);
      if (pType != null) {
        paramTypes.push(pType);
      } else {
        paramTypes.push(new UnknownType());
      }
    } else {
      paramTypes.push(new UnknownType());
    }
  }

  let methName = match (mDef.name) {
    case Identifier {name}: name
    case _: ""
  };

  // Check if main function type matches
  if (ft.parameters.length == paramTypes.length) {
    var match = true;
    for (var pi = 0; pi < paramTypes.length; pi += 1) {
      if (getTypeUniqueKey(ft.parameters[pi]) != getTypeUniqueKey(paramTypes[pi])) {
        match = false;
      }
    }
    if (match) {
      return ft;
    }
  }
  
  let ovs = ft.overloads as GrowableArray<FunctionType>;
  for (let ov in ovs) {
    if (ov.parameters.length == paramTypes.length) {
      var match = true;
      for (var pi = 0; pi < paramTypes.length; pi += 1) {
        if (getTypeUniqueKey(ov.parameters[pi]) != getTypeUniqueKey(paramTypes[pi])) {
          match = false;
        }
      }
      if (match) {
        return ov;
      }
    }
  }
  return null;
};

export let findMixinDeclaration = (program: Program, mt: MixinType): MixinDeclaration | null => {
  let path = mt.sourcePath;
  if (let (true, unit) = program.unitsByPath.get(path)) {
    for (let stmt in (unit).ast.body) {
      if (stmt is MixinDeclaration) {
        if (stmt.name.name == mt.name) {
          return stmt;
        }
      }
    }
  }
  return null;
};

export let collectMixinMembers = (
  program: Program,
  model: SemanticModel,
  mixinAnns: GrowableArray<TypeAnnotation> | null,
  methods: GrowableArray<Node>,
  seen: HashMap<MixinKey, boolean>,
  scopes: GrowableArray<String> | null = null,
  models: GrowableArray<SemanticModel> | null = null
): void => {
  if (mixinAnns == null) { return; }
  for (let ann in mixinAnns) {
    let sym = model.resolve(ann);
    if (sym != null) {
      let mt = model.getBindingType(sym);
      if (mt is MixinType) {
        let md = findMixinDeclaration(program, mt);
        if (md != null) {
          let mixinKey = getMixinKey(mt);
          if (!seen.has(mixinKey)) {
            seen[mixinKey] = true;
            collectMixinMembers(program, model, md.mixins, methods, seen, scopes, models);
            // The mixin's private scope key, parallel to `methods`
            // when the caller asks for it: functions compiled from
            // these nodes resolve their "#" fields under this scope
            // (see WasmFunction.privateScopeKey). Read from the
            // MixinType — the key includes the declaration's source
            // path, so it is never rederived from the name.
            let mtRoot = mt.genericSource ?? mt;
            let scope = if (mtRoot.privateScopeKey != null) {
              mtRoot.privateScopeKey as String
            } else {
              mt.name + "_This"
            };
            var mixinModel: SemanticModel = model;
            if (let (true, unit) = program.unitsByPath.get(mt.sourcePath)) {
              mixinModel = unit.model;
            }
            for (let member in md.body) {
              if (member is MethodDefinition || member is AccessorDeclaration || member is FieldDefinition) {
                methods.push(member);
                if (scopes != null) {
                  scopes.push(scope);
                }
                if (models != null) {
                  models.push(mixinModel);
                }
              }
            }
          }
        }
      }
    }
  }
};

/**
 * The private scope key of the mixin that declares `member`, when the
 * class declaration `cd` acquires `member` through a mixin (directly
 * or composed) — null for the class's own members. Used by
 * registration paths that reach members via nodes rather than via
 * the member-collection loops.
 */
export let mixinScopeOfMember = (
  program: Program,
  model: SemanticModel,
  cd: Node | null,
  member: Node
): String | null => {
  match (cd) {
    case ClassDeclaration as cdd: {
      if (cdd.mixins == null) { return null; }
      let members = new GrowableArray<Node>();
      let scopes = new GrowableArray<String>();
      let seen = new HashMap<MixinKey, boolean>();
      collectMixinMembers(program, model, cdd.mixins, members, seen, scopes);
      for (var i = 0; i < members.length; i += 1) {
        if (members[i] == member) {
          return scopes[i];
        }
      }
    }
    case _: {}
  }
  return null;
};

export let mixinModelOfMember = (
  program: Program,
  model: SemanticModel,
  cd: Node | null,
  member: Node
): SemanticModel | null => {
  match (cd) {
    case ClassDeclaration as cdd: {
      if (cdd.mixins == null) { return null; }
      let members = new GrowableArray<Node>();
      let seen = new HashMap<MixinKey, boolean>();
      let models = new GrowableArray<SemanticModel>();
      collectMixinMembers(program, model, cdd.mixins, members, seen, null, models);
      for (var i = 0; i < members.length; i += 1) {
        if (members[i] == member) {
          return models[i];
        }
      }
    }
    case _: {}
  }
  return null;
};

/**
 * The private scope key of the mixin declaration a node sits inside
 * LEXICALLY — null for nodes written in a class body or at top level.
 *
 * Privacy is a property of where the source text was written, not of
 * which registration path produced a function, so this walks the AST
 * parent chain rather than consulting the member-collection loops.
 * That is what makes it answer for the functions those loops never
 * name: a closure inside a mixin method, a monomorphized copy of a
 * generic mixin method. Both used to reach lowering with no scope and
 * silently bind the HOST class's same-named private.
 *
 * The walk stops at a ClassDeclaration — classes do not nest inside
 * mixin bodies, so a class member's answer costs one step.
 */
export let mixinScopeOfNode = (model: SemanticModel, node: Node): String | null => {
  var cur: Node | null = node;
  while (cur != null) {
    let c = cur;
    if (c is ClassDeclaration) { return null; }
    if (c is MixinDeclaration) {
      let sym = model.resolve(c);
      if (sym == null) { return null; }
      let mt = model.getBindingType(sym);
      if (mt == null || !(mt is MixinType)) { return null; }
      // Read the key from the MixinType — it carries the declaration's
      // source path, so two same-named mixins from different modules
      // are different scopes. Never rederive it from the name.
      let mtRoot = mt.genericSource ?? mt;
      let {privateScopeKey} = mtRoot;
      if (privateScopeKey != null) {
        return privateScopeKey;
      }
      return mt.name + "_This";
    }
    cur = model.getParent(c);
  }
  return null;
};

export let collectMixinFields = (
  program: Program,
  model: SemanticModel,
  mixinAnns: GrowableArray<TypeAnnotation> | null,
  fields: GrowableArray<FieldDefinition>,
  scopes: GrowableArray<String>,
  seen: HashMap<MixinKey, boolean>
): void => {
  if (mixinAnns == null) { return; }
  for (let ann in mixinAnns) {
    let sym = model.resolve(ann);
    if (sym != null) {
      let mt = model.getBindingType(sym);
      if (mt is MixinType) {
        let md = findMixinDeclaration(program, mt);
        if (md != null) {
          let mixinKey = getMixinKey(mt);
          if (!seen.has(mixinKey)) {
            seen[mixinKey] = true;
            collectMixinFields(program, model, md.mixins, fields, scopes, seen);
            // The mixin's private-field scope key: struct fields for
            // this mixin's privates are named "<scope>::#name" in
            // every host (see ClassType.privateScopeKey). Empty for
            // public fields' purposes — callers only apply it to
            // "#"-prefixed names.
            let mtRoot = mt.genericSource ?? mt;
            let scope = if (mtRoot.privateScopeKey != null) {
              mtRoot.privateScopeKey as String
            } else {
              mt.name + "_This"
            };
            for (let member in md.body) {
              if (member is FieldDefinition) {
                fields.push(member);
                scopes.push(scope);
              }
            }
          }
        }
      }
    }
  }
};

export let substituteTypeParams = (
  typeParams: Array<TypeParameterType> | null,
  typeArgs: Array<Type> | null,
  t: Type
): Type => {
  if (typeParams == null || typeArgs == null) { return t; }
  let tpLen = typeParams.length;
  let taLen = typeArgs.length;

  return match (t) {
    case TypeParameterType {name}: {
      for (var i = 0; i < tpLen && i < taLen; i += 1) {
        if (typeParams[i].name == name) {
          return typeArgs[i];
        }
      }
      t
    }
    case UnionType {types}: {
      let substituted = new GrowableArray<Type>();
      for (let subtype in types) {
        substituted.push(substituteTypeParams(typeParams, typeArgs, subtype));
      }
      new UnionType(substituted)
    }
    case ArrayType {elementType}: {
      let subElem = substituteTypeParams(typeParams, typeArgs, elementType);
      new ArrayType(subElem)
    }
    case TupleType {elementTypes}: {
      let subElems = new GrowableArray<Type>();
      for (let elem in elementTypes) {
        subElems.push(substituteTypeParams(typeParams, typeArgs, elem));
      }
      new TupleType(subElems)
    }
    case InlineTupleType {elementTypes}: {
      let subElems = new GrowableArray<Type>();
      for (let elem in elementTypes) {
        subElems.push(substituteTypeParams(typeParams, typeArgs, elem));
      }
      new InlineTupleType(subElems)
    }
    case RecordType as rec: {
      let subProps = new HashMap<String, Type>();
      for (let pair in rec.properties) {
        subProps[pair.key] = substituteTypeParams(typeParams, typeArgs, pair.value);
      }
      let res = new RecordType(subProps, rec.optionalProperties);
      res
    }
    case FunctionType as ft: {
      let subParams = new GrowableArray<Type>();
      for (let param in ft.parameters) {
        subParams.push(substituteTypeParams(typeParams, typeArgs, param));
      }
      let subRet = substituteTypeParams(typeParams, typeArgs, ft.returnType);
      let res = new FunctionType(subParams, ft.parameterNames, subRet);
      res.typeParameters = ft.typeParameters;
      res.optionalParameters = ft.optionalParameters;
      res.parameterInitializers = ft.parameterInitializers;
      res.parameterSymbols = ft.parameterSymbols;
      res.overloads = ft.overloads;
      res.isFinal = ft.isFinal;
      res.isAbstract = ft.isAbstract;
      res.typeArguments = ft.typeArguments;
      res.genericSource = ft.genericSource;
      res.functionSymbolId = ft.functionSymbolId;
      res.functionSymbolName = ft.functionSymbolName;
      res
    }
    case ClassType as ct: {
      let {typeArguments} = ct;
      if (typeArguments != null) {
        let srcArgs = typeArguments;
        let subArgs = new GrowableArray<Type>();
        for (let arg in srcArgs) {
          subArgs.push(substituteTypeParams(typeParams, typeArgs, arg));
        }
        instantiateClassType(ct.genericSource ?? ct, subArgs)
      } else {
        ct
      }
    }
    case _: t
  };
};

export let unwrapAliases = (t: Type): Type => {
  var curr = t;
  while (curr is TypeAliasType) {
    curr = curr.target;
  }
  return baseType(curr);
};

export let getTypeUniqueKey = (t: Type): String => {
  let cached = t.uniqueKeyCache;
  if (cached != null) {
    return cached;
  }
  let key = getTypeUniqueKeyRaw(t);
  t.uniqueKeyCache = key;
  return key;
};

let getTypeUniqueKeyRaw = (t: Type): String => match (t) {
  case ClassType as ct: {
    let baseId = if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id;
    let base = `${ct.name}_${i32ToString(baseId as i32)}`;
    let {typeArguments} = ct;
    if (typeArguments != null) {
      let args = typeArguments;
      let len = args.length;
      if (len > 0) {
        let parts = new FixedArray<String>(2 * len + 2, "");
        parts[0] = base;
        parts[1] = "<";
        parts[2] = getTypeUniqueKey(args[0]);
        var i = 1;
        while (i < len) {
          parts[2 * i + 1] = ", ";
          parts[2 * i + 2] = getTypeUniqueKey(args[i]);
          i += 1;
        }
        parts[2 * len + 1] = ">";
        String.fromParts(parts as array<String>)
      } else {
        base
      }
    } else {
      base
    }
  }
  case InterfaceType as it: {
    let baseId = if (it.genericSource != null) (it.genericSource as InterfaceType).id else it.id;
    let base = `${it.name}_${i32ToString(baseId as i32)}`;
    let {typeArguments} = it;
    if (typeArguments != null) {
      let args = typeArguments;
      let len = args.length;
      if (len > 0) {
        let parts = new FixedArray<String>(2 * len + 2, "");
        parts[0] = base;
        parts[1] = "<";
        parts[2] = getTypeUniqueKey(args[0]);
        var i = 1;
        while (i < len) {
          parts[2 * i + 1] = ", ";
          parts[2 * i + 2] = getTypeUniqueKey(args[i]);
          i += 1;
        }
        parts[2 * len + 1] = ">";
        String.fromParts(parts as array<String>)
      } else {
        base
      }
    } else {
      base
    }
  }
  case ArrayType {elementType}: `Array<${getTypeUniqueKey(elementType)}>`
  case TupleType {elementTypes}: {
    let len = elementTypes.length;
    if (len > 0) {
      let parts = new FixedArray<String>(2 * len + 1, "");
      parts[0] = "[";
      parts[1] = getTypeUniqueKey(elementTypes[0]);
      var i = 1;
      while (i < len) {
        parts[2 * i] = ", ";
        parts[2 * i + 1] = getTypeUniqueKey(elementTypes[i]);
        i += 1;
      }
      parts[2 * len] = "]";
      String.fromParts(parts as array<String>)
    } else {
      "[]"
    }
  }
  case InlineTupleType {elementTypes}: {
    let len = elementTypes.length;
    if (len > 0) {
      let parts = new FixedArray<String>(2 * len + 1, "");
      parts[0] = "(";
      parts[1] = getTypeUniqueKey(elementTypes[0]);
      var i = 1;
      while (i < len) {
        parts[2 * i] = ", ";
        parts[2 * i + 1] = getTypeUniqueKey(elementTypes[i]);
        i += 1;
      }
      parts[2 * len] = ")";
      String.fromParts(parts as array<String>)
    } else {
      "()"
    }
  }
  case UnionType {types}: {
    let len = types.length;
    if (len > 0) {
      let parts = new FixedArray<String>(2 * len - 1, "");
      parts[0] = getTypeUniqueKey(types[0]);
      var i = 1;
      while (i < len) {
        parts[2 * i - 1] = " | ";
        parts[2 * i] = getTypeUniqueKey(types[i]);
        i += 1;
      }
      String.fromParts(parts as array<String>)
    } else {
      ""
    }
  }
  case RecordType as recT: {
    let {properties} = recT;
    let len = properties.size;
    if (len > 0) {
      let parts = new FixedArray<String>(4 * len + 1, "");
      parts[0] = "{ ";
      let keys = properties.keys();
      var i = 0;
      while (let (true, key) = keys.next()) {
        let shownKey = if (recT.isOptional(key)) key + "?" else key;
        if (i > 0) {
          parts[4 * i] = ", ";
          parts[4 * i + 1] = shownKey;
          parts[4 * i + 2] = ": ";
          parts[4 * i + 3] = getTypeUniqueKey(properties[key]);
        } else {
          parts[1] = shownKey;
          parts[2] = ": ";
          parts[3] = getTypeUniqueKey(properties[key]);
        }
        i += 1;
      }
      parts[4 * len] = " }";
      String.fromParts(parts as array<String>)
    } else {
      "{  }"
    }
  }
  case FunctionType as ft: {
    let paramsLen = ft.parameters.length;
    
    // First pass: count parts
    var numParts = 3; // For "(", ") => ", and returnType
    if (paramsLen > 0) {
      numParts = numParts + (paramsLen - 1); // For ", " delimiters
    }
    
    let names = ft.parameterNames;
    var i = 0;
    while (i < paramsLen) {
      if (names != null && i < names.length) {
        numParts = numParts + 2; // For name and ": "
      }
      numParts = numParts + 1; // For type key
      i += 1;
    }
    
    // Allocate FixedArray
    let parts = new FixedArray<String>(numParts, "");
    parts[0] = "(";
    
    // Second pass: fill parts
    var idx = 1;
    i = 0;
    while (i < paramsLen) {
      if (i > 0) {
        parts[idx] = ", ";
        idx += 1;
      }
      if (names != null && i < names.length) {
        parts[idx] = names[i];
        parts[idx + 1] = ": ";
        idx += 2;
      }
      parts[idx] = getTypeUniqueKey(ft.parameters[i]);
      idx += 1;
      i += 1;
    }
    parts[idx] = ") => ";
    parts[idx + 1] = getTypeUniqueKey(ft.returnType);
    
    String.fromParts(parts as array<String>)
  }
  case TypeAliasType as a: `alias_${getTypeUniqueKey(a.target)}`
  case _: typeToString(t)
};

export let getFunctionAdaptationKey = (src: Type, tgt: Type): FunctionAdaptationKey => {
  return new FunctionAdaptationKey(src, tgt);
};

export let getClassMethodKey = (classKey: ClassKey, methodName: String): ClassMethodKey => {
  return new ClassMethodKey(classKey, methodName);
};

export let getSpecializedFunctionKey = (baseName: String, typeArgs: Array<Type>): SpecializedFunctionKey => {
  return new SpecializedFunctionKey(baseName, typeArgs);
};

export let getClosureSpecializationKey = (closureId: NodeId, classKey: ClassKey): ClosureSpecializationKey => {
  return new ClosureSpecializationKey(closureId, classKey);
};

export let getFunctionValueWrapperKey = (keyName: String, ft: FunctionType): FunctionValueWrapperKey => {
  return new FunctionValueWrapperKey(keyName, getSignatureKey(ft));
};

export let sortStringsByLengthDescending = (arr: GrowableArray<String>): void => {
  quickSortStringsByLengthDescending(arr, 0, arr.length - 1);
};

let quickSortStringsByLengthDescending = (arr: GrowableArray<String>, low: i32, high: i32): void => {
  if (low < high) {
    let pIdx = partitionStringsByLengthDescending(arr, low, high);
    quickSortStringsByLengthDescending(arr, low, pIdx);
    quickSortStringsByLengthDescending(arr, pIdx + 1, high);
  }
};

let partitionStringsByLengthDescending = (arr: GrowableArray<String>, low: i32, high: i32): i32 => {
  let mid = low + ((high - low) >> 1);
  let pivot = arr[mid];
  let pivotLen = pivot.length;
  
  var i = low - 1;
  var j = high + 1;
  
  while (true) {
    i += 1;
    while (arr[i].length > pivotLen) {
      i += 1;
    }
    
    j -= 1;
    while (arr[j].length < pivotLen) {
      j -= 1;
    }
    
    if (i >= j) {
      return j;
    }
    
    let temp = arr[i];
    arr[i] = arr[j];
    arr[j] = temp;
  }
  return j;
};

// ---- Literal parsing shared across codegen ----

export let parseI64OrU64Literal = (raw: String): inline (boolean, i64) => {
  if (raw.length == 0) return (false, 0 as i64);
  
  var isNeg = false;
  var start = 0;
  let first = raw.getByteAt(0);
  if (first == 45) { // '-'
    isNeg = true;
    start = 1;
  } else if (first == 43) { // '+'
    start = 1;
  }
  
  var isHex = false;
  if (start + 2 <= raw.length) {
    let c0 = raw.getByteAt(start);
    let c1 = raw.getByteAt(start + 1);
    if (c0 == 48 && (c1 == 120 || c1 == 88)) { // '0' and ('x' or 'X')
      isHex = true;
      start = start + 2;
    }
  }
  
  var res: u64 = 0 as u64;
  let ten = 10 as u64;
  let sixteen = 16 as u64;
  
  var i = start;
  var hasDigits = false;
  while (i < raw.length) {
    let code = raw.getByteAt(i);
    if (code == 95) { // '_'
      i += 1;
      continue;
    }
    var digit = 0 as u64;
    if (code >= 48 && code <= 57) { // '0'..'9'
      digit = (code - 48) as u64;
    } else if (isHex && code >= 97 && code <= 102) { // 'a'..'f'
      digit = (code - 97 + 10) as u64;
    } else if (isHex && code >= 65 && code <= 70) { // 'A'..'F'
      digit = (code - 65 + 10) as u64;
    } else {
      return (false, 0 as i64);
    }
    let base = if (isHex) sixteen else ten;
    res = res * base + digit;
    hasDigits = true;
    i += 1;
  }
  
  if (!hasDigits) return (false, 0 as i64);
  
  let finalVal = if (isNeg) (0 as i64) - (res as i64) else res as i64;
  return (true, finalVal);
};

export let parseI32WithHex = (s: String): (boolean, i32) => {
  if (s.length == 0) return (false, 0);
  var start = 0;
  var isNeg = false;
  let first = s.getByteAt(0);
  if (first == 45) { // '-'
    isNeg = true;
    start = 1;
  } else if (first == 43) { // '+'
    start = 1;
  }
  
  var isHex = false;
  if (start + 1 < s.length) {
    let c0 = s.getByteAt(start);
    let c1 = s.getByteAt(start + 1);
    if (c0 == 48 && (c1 == 120 || c1 == 88)) { // '0x' or '0X'
      isHex = true;
      start = start + 2;
    }
  }
  
  var res: i32 = 0;
  var i = start;
  var hasDigits = false;
  while (i < s.length) {
    let code = s.getByteAt(i);
    if (code == 95) { // '_'
      i += 1;
      continue;
    }
    var digit = 0;
    if (code >= 48 && code <= 57) { // '0'..'9'
      digit = code - 48;
    } else if (isHex && code >= 97 && code <= 102) { // 'a'..'f'
      digit = code - 97 + 10;
    } else if (isHex && code >= 65 && code <= 70) { // 'A'..'F'
      digit = code - 65 + 10;
    } else {
      return (false, 0);
    }
    let base = if (isHex) 16 else 10;
    res = res * base + digit;
    hasDigits = true;
    i += 1;
  }
  if (!hasDigits) return (false, 0);
  let finalVal = if (isNeg) 0 - res else res;
  return (true, finalVal);
};

/**
 * The `zena:string-convert` helper a template interpolation of type
 * `t` lowers to, or `''` when the operand is already a String (or is
 * not convertible).
 *
 * Shared by the lowering that emits the call (`ir/templates.zena`) and
 * the reachability pass that must root it. Lowering looks the helper
 * up by NAME through `getStdlibFunc`, so there is no call node for RTA
 * to see — the two have to agree, and a disagreement shows up as
 * `Invalid function call: function index < 0`.
 */
export let templateConvertHelperName = (t: Type): String => {
  return match (baseType(t)) {
    case I32Type: 'i32ToString'
    case U32Type: 'u32ToString'
    case I64Type: 'i64ToString'
    case U64Type: 'u64ToString'
    case F32Type: 'f32ToString'
    case F64Type: 'f64ToString'
    // Narrow types are held in canonical 32-bit form, so they print
    // through their promoted counterpart's helper.
    case U8Type: 'u32ToString'
    case U16Type: 'u32ToString'
    case I8Type: 'i32ToString'
    case I16Type: 'i32ToString'
    case BooleanType: 'boolToString'
    case _: ''
  };
};
