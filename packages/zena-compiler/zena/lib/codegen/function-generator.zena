import { 
  Node, VariableDeclaration, FunctionExpression, IdentifierPattern,
  Identifier, NumberLiteral, BooleanLiteral, StringLiteral, BlockStatement,
  ReturnStatement, ExpressionStatement, Statement, Expression, CallExpression,
  ImportSpecifier, BinaryExpression, UnaryExpression, AssignmentExpression,
  IfStatement, IfExpression, WhileStatement, ForStatement, BreakStatement,
  ContinueStatement
} from '../ast.zena';
import { Type, I32Type, F64Type, F32Type, VoidType, FunctionType } from '../types.zena';
import { SemanticModel } from '../semantic-model.zena';
import { SymbolId, Symbol } from '../scope/symbol.zena';
import { Error } from 'zena:error';
import { ValType } from "./wasm.zena";
import { String } from "zena:string";
import { i32ToString } from "zena:string-convert";
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';

import { parseI32, parseF64 } from 'zena:string-convert';
import { walkEnter } from '../visitor.zena';
import { FunctionContext } from './function-context.zena';
import { generateIdentifier, generateNumberLiteral, generateBooleanLiteral, generateStringLiteral } from './expr/primitives.zena';
import { generateUnaryExpression, generateBinaryExpression } from './expr/operators.zena';

import { WasmEmitter } from './wasm-emitter.zena';
import { WasmFunction, WasmModule } from './wasm-module.zena';

/**
 * Manages the generic AST traversal and code generation.
 * Emits backend-agnostic logical instructions to a generic `WasmEmitter`.
 */
export class FunctionGenerator {
  ctx: FunctionContext;

  new(wasm: WasmModule, emitter: WasmEmitter, wasmFunction: WasmFunction) : ctx = new FunctionContext(wasm, emitter, wasmFunction) {}



  discoverLocalsFromExpr(expr: Expression): void {
    match (expr) {
      case IfExpression {consequent, alternate}: {
        if (consequent is BlockStatement) {
          this.discoverLocalsFromStmt(consequent as BlockStatement);
        } else if (consequent is Expression) {
          this.discoverLocalsFromExpr(consequent as Expression);
        }
        if (alternate != null) {
          if (alternate is BlockStatement) {
            this.discoverLocalsFromStmt(alternate as BlockStatement);
          } else if (alternate is Expression) {
            this.discoverLocalsFromExpr(alternate as Expression);
          }
        }
      }
      case AssignmentExpression {value}: {
        this.discoverLocalsFromExpr(value);
      }
      case BinaryExpression {left, right}: {
        this.discoverLocalsFromExpr(left);
        this.discoverLocalsFromExpr(right);
      }
      case CallExpression {callee, args}: {
        let calleeType = this.ctx.wasmFunction.model.getNodeType(callee);
        match (calleeType) {
          case FunctionType as ft: {
            if (ft.parameterSymbols != null) {
              let symbols = ft.parameterSymbols as Array<SymbolId>;
              var i = 0;
              while (i < symbols.length && i < ft.parameters.length) {
                let symId = symbols[i];
                if (symId != (-1 as SymbolId) && !this.ctx.localIndices.has(symId)) {
                  let paramType = ft.parameters[i];
                  var vType = ValType.i32;
                  if (paramType is F64Type) {
                    vType = ValType.f64;
                  } else if (paramType is F32Type) {
                    vType = ValType.f32;
                  }
                  let index = this.ctx.wasmFunction.signature.params.length + this.ctx.localTypes.length;
                  this.ctx.localIndices[symId] = index;
                  this.ctx.localTypes.push(vType);
                }
                i += 1;
              }
            }
          }
          case _: {}
        }
        for (let arg in args) {
          this.discoverLocalsFromExpr(arg);
        }
      }
      case _: {}
    }
  }

  discoverLocalsFromStmt(stmt: Statement): void {
    match (stmt) {
      case BlockStatement {body}: {
        for (let s in body) {
          this.discoverLocalsFromStmt(s);
        }
      }
      case IfStatement {consequent, alternate}: {
        this.discoverLocalsFromStmt(consequent);
        if (alternate != null) {
          this.discoverLocalsFromStmt(alternate as Statement);
        }
      }
      case WhileStatement {test, body}: {
        this.discoverLocalsFromExpr(test as Expression);
        this.discoverLocalsFromStmt(body);
      }
      case ForStatement {init, test, update, body}: {
        if (init != null) {
          // If init is a VariableDeclaration, it will be handled as a Statement
          // In Zena AST, a ForStatement init might be a Node but typically a VariableDeclaration or Expression
          if (init is Statement) {
            this.discoverLocalsFromStmt(init as Statement);
          } else if (init is Expression) {
            this.discoverLocalsFromExpr(init as Expression);
          }
        }
        if (test != null) {
          this.discoverLocalsFromExpr(test as Expression);
        }
        if (update != null) {
          this.discoverLocalsFromExpr(update as Expression);
        }
        this.discoverLocalsFromStmt(body);
      }
      case ExpressionStatement {expression}: {
        this.discoverLocalsFromExpr(expression);
      }
      case VariableDeclaration: {
        let decl = stmt as VariableDeclaration;
        if (decl.init != null) {
          this.discoverLocalsFromExpr(decl.init as Expression);
        }
        if (decl.pattern is IdentifierPattern) {
          let ident = decl.pattern as IdentifierPattern;
          let sym = this.ctx.wasmFunction.model.resolveDeclaration(ident);
          if (sym != null) {
            let varType = this.ctx.wasmFunction.model.getNodeType(decl);
            var vType = ValType.i32;
            if (varType is F64Type) {
              vType = ValType.f64;
            } else if (varType is F32Type) {
              vType = ValType.f32;
            }
            let index = this.ctx.wasmFunction.signature.params.length + this.ctx.localTypes.length;
            this.ctx.localIndices[sym.id] = index;
            this.ctx.localTypes.push(vType);
          }
        }
      }
      case _: {}
    }
  }

  generate(): void {
    let bodyNode = this.ctx.wasmFunction.node;
    for (var i = 0; i < bodyNode.params.length; i += 1) {
      let param = bodyNode.params[i];
      let sym = this.ctx.wasmFunction.model.resolveDeclaration(param.name);
      if (sym != null) {
        this.ctx.localIndices[sym.id] = i;
      }
    }
    
    let body = bodyNode.body;
    match (body) {
      case BlockStatement: {
        let block = body as BlockStatement;
        for (let stmt in block.body) {
          this.discoverLocalsFromStmt(stmt);
        }
      }
      case _: {}
    }

    this.ctx.emitter.emitFunctionCodeStart(this.ctx.wasmFunction);
    var name = "func" + i32ToString(this.ctx.wasmFunction.index);
    if (this.ctx.wasmFunction.name != null) {
      name = this.ctx.wasmFunction.name as String;
    }
    this.ctx.emitter.emitFunctionSignatureStart(name, this.ctx.wasmFunction.signature.index);
    
    
    this.ctx.emitter.emitFunctionLocalsStart(this.ctx.localTypes);
    
    match (bodyNode.body) {
      case BlockStatement: {
        let block = bodyNode.body as BlockStatement;
        for (let stmt in block.body) {
          this.generateStatement(stmt);
          if (!this.ctx.isReachable) {
            break;
          }
        }
        if (this.ctx.wasmFunction.signature.returns.length > 0) {
          if (this.ctx.isReachable) {
            throw new Error("Function '" + name + "' misses a return statement");
          } else if (this.ctx.needsUnreachable) {
            this.ctx.emitter.emitUnreachable();
          }
        }
      }
      case Expression: {
        this.generateExpression(bodyNode.body as Expression);
        this.ctx.emitter.emitReturn();
        this.ctx.isReachable = false;
      }
    }
    
    this.ctx.emitter.emitFunctionEnd();
    this.ctx.emitter.emitFunctionCodeEnd(this.ctx.wasmFunction);
  }

  generateIfBranch(branch: Node, dropResult: boolean): void {
    if (branch is BlockStatement) {
      let block = branch as BlockStatement;
      if (dropResult) {
        this.generateStatement(block);
      } else {
        // Evaluate all but last statement
        for (var i = 0; i < block.body.length - 1; i += 1) {
          this.generateStatement(block.body[i]);
        }
        if (block.body.length > 0) {
          let lastStmt = block.body[block.body.length - 1];
          if (lastStmt is ExpressionStatement) {
            let exprStmt = lastStmt as ExpressionStatement;
            this.generateExpression(exprStmt.expression);
            // Don't drop it, it's the result
          } else {
            this.generateStatement(lastStmt);
          }
        }
      }
    } else if (branch is Expression) {
      this.generateExpression(branch as Expression);
      if (dropResult) {
        let exprType = this.ctx.wasmFunction.model.getNodeType(branch);
        if (!(exprType is VoidType)) {
          this.ctx.emitter.emitDrop();
        }
      }
    } else {
      throw new Error("Invalid if branch type in codegen");
    }
  }

  generateStatement(stmt: Statement): void {
    if (!this.ctx.isReachable) {
      return;
    }
    match (stmt) {
      case BreakStatement {}: {
        let n = this.ctx.loopStack.length;
        if (n > 0) {
          let (bDepth, _) = this.ctx.loopStack[n - 1];
          this.ctx.emitter.emitBr(bDepth);
        } else {
          this.ctx.emitter.emitUnreachable();
        }
        this.ctx.isReachable = false;
      }
      case ContinueStatement {}: {
        let n = this.ctx.loopStack.length;
        if (n > 0) {
          let (_, cDepth) = this.ctx.loopStack[n - 1];
          this.ctx.emitter.emitBr(cDepth);
        } else {
          this.ctx.emitter.emitUnreachable();
        }
        this.ctx.isReachable = false;
      }
      case ReturnStatement {argument}: {
        if (argument != null) {
          this.generateExpression(argument as Expression);
        }
        this.ctx.emitter.emitReturn();
        this.ctx.isReachable = false;
        this.ctx.needsUnreachable = false;
      }
      case ExpressionStatement {expression}: {
        this.generateExpression(expression);
        let exprType = this.ctx.wasmFunction.model.getNodeType(expression);
        if (!(exprType is VoidType)) {
          this.ctx.emitter.emitDrop();
        }
      }
      case BlockStatement {body}: {
        for (let s in body) {
          this.generateStatement(s);
          if (!this.ctx.isReachable) {
            break; // Stop generating unreachable statements
          }
        }
      }
      case IfStatement {test, consequent, alternate}: {
        this.generateExpression(test as Expression);
        this.ctx.emitter.emitIf(ValType.void);
        this.ctx.enterBlockStructure();
        
        let wasReachable = this.ctx.isReachable;
        
        this.generateStatement(consequent);
        let consReachable = this.ctx.isReachable;
        
        this.ctx.isReachable = wasReachable; // Reset for alternate definition
        if (alternate != null) {
          this.ctx.emitter.emitElse();
          this.generateStatement(alternate as Statement);
          let altReachable = this.ctx.isReachable;
          this.ctx.isReachable = consReachable || altReachable;
          if (!this.ctx.isReachable) {
            this.ctx.needsUnreachable = true;
          }
        } else {
          // No alternate, so we just continue
          this.ctx.isReachable = true;
        }
        
        this.ctx.exitBlockStructure();
        this.ctx.emitter.emitEnd();
      }
      case WhileStatement {test, body}: {
        this.ctx.emitter.emitBlock(ValType.void);
        this.ctx.emitter.emitLoop(ValType.void);
        
        this.generateExpression(test as Expression);
        this.ctx.emitter.emitI32Const(0);
        this.ctx.emitter.emitI32Eq();
        this.ctx.emitter.emitBrIf(1);
        
        let wasReachable = this.ctx.isReachable;
        this.ctx.enterLoop();
        this.generateStatement(body);
        this.ctx.exitLoop();
        
        this.ctx.isReachable = wasReachable;
        this.ctx.emitter.emitBr(0);
        this.ctx.emitter.emitEnd();
        this.ctx.emitter.emitEnd();
        
        this.ctx.isReachable = wasReachable;
      }
      case ForStatement {init, test, update, body}: {
        if (init != null) {
          if (init is Statement) {
            this.generateStatement(init as Statement);
          } else if (init is Expression) {
            this.generateExpression(init as Expression);
            let exprType = this.ctx.wasmFunction.model.getNodeType(init as Node);
            if (!(exprType is VoidType)) {
              this.ctx.emitter.emitDrop();
            }
          }
        }
        
        this.ctx.emitter.emitBlock(ValType.void);
        this.ctx.emitter.emitLoop(ValType.void);
        
        if (test != null) {
          this.generateExpression(test as Expression);
          this.ctx.emitter.emitI32Const(0);
          this.ctx.emitter.emitI32Eq();
          this.ctx.emitter.emitBrIf(1);
        }
        
        // Inner block for continue to jump to (skipping body, hitting update)
        this.ctx.emitter.emitBlock(ValType.void);
        let wasReachable = this.ctx.isReachable;
        
        this.ctx.enterForLoop();
        this.generateStatement(body);
        this.ctx.exitLoop();
        
        this.ctx.emitter.emitEnd(); // End continue block
        this.ctx.isReachable = wasReachable;
        
        if (update != null) {
          this.generateExpression(update as Expression);
          let exprType = this.ctx.wasmFunction.model.getNodeType(update as Node);
          if (!(exprType is VoidType)) {
            this.ctx.emitter.emitDrop();
          }
        }
        
        this.ctx.emitter.emitBr(0);
        this.ctx.emitter.emitEnd();
        this.ctx.emitter.emitEnd();
        
        this.ctx.isReachable = wasReachable;
      }
      case VariableDeclaration: {
        let decl = stmt as VariableDeclaration;
        if (decl.init != null) {
          this.generateExpression(decl.init as Expression);
          if (decl.pattern is IdentifierPattern) {
            let ident = decl.pattern as IdentifierPattern;
            let sym = this.ctx.wasmFunction.model.resolveDeclaration(ident);
            if (sym != null && this.ctx.localIndices.has(sym.id)) {
              this.ctx.emitter.emitLocalSet(this.ctx.localIndices[sym.id]);
            }
          }
        }
      }
      case _: {
        throw new Error("Unsupported statement type in codegen");
      }
    }
  }

  generateExpression(expr: Expression): void {
    match (expr) {
      case Identifier: generateIdentifier(this.ctx, expr as Identifier)
      case CallExpression {callee, args}: {
        let calleeType = this.ctx.wasmFunction.model.getNodeType(callee);
        var ft: FunctionType | null = null;
        if (calleeType is FunctionType) {
          ft = calleeType as FunctionType;
        }

        match (callee) {
          case Identifier: {
            let ident = callee as Identifier;
            let model = this.ctx.wasmFunction.model;
            let sym = model.resolve(ident);
            
            if (sym == null) {
              throw new Error("Unresolved identifier in codegen: " + ident.name);
            }
            
            if (this.ctx.wasm.functionMap.has((sym as Symbol).id)) {
              var i = 0;
              while (i < args.length) {
                this.generateExpression(args[i]);
                if (ft != null && ft.parameterSymbols != null) {
                  let syms = ft.parameterSymbols as Array<SymbolId>;
                  if (i < syms.length && syms[i] != (-1 as SymbolId) && this.ctx.localIndices.has(syms[i])) {
                    this.ctx.emitter.emitLocalTee(this.ctx.localIndices[syms[i]]);
                  }
                }
                i += 1;
              }
              this.ctx.emitter.emitCall(this.ctx.wasm.functionMap[(sym as Symbol).id]);
              return;
            } else {
              if ((sym as Symbol).declaration is ImportSpecifier) {
                let spec = (sym as Symbol).declaration as ImportSpecifier;
                let importedName = spec.imported.name;
                if (this.ctx.wasm.exportMap.has(importedName)) {
                  var i = 0;
                  while (i < args.length) {
                    this.generateExpression(args[i]);
                    if (ft != null && ft.parameterSymbols != null) {
                      let syms = ft.parameterSymbols as Array<SymbolId>;
                      if (i < syms.length && syms[i] != (-1 as SymbolId) && this.ctx.localIndices.has(syms[i])) {
                        this.ctx.emitter.emitLocalTee(this.ctx.localIndices[syms[i]]);
                      }
                    }
                    i += 1;
                  }
                  this.ctx.emitter.emitCall(this.ctx.wasm.exportMap[importedName]);
                  return;
                }
                throw new Error("Export map missing: " + importedName);
              }
              throw new Error("Could not resolve function call target");
            }
          }
          case _: {
            throw new Error("Unsupported call expression");
          }        
        }
      }
      case NumberLiteral: generateNumberLiteral(this.ctx, expr as NumberLiteral)
      case BooleanLiteral: generateBooleanLiteral(this.ctx, expr as BooleanLiteral)
      case StringLiteral: generateStringLiteral(this.ctx, expr as StringLiteral)
      case UnaryExpression: generateUnaryExpression(this.ctx, expr as UnaryExpression, (e: Expression) => this.generateExpression(e))
      case BinaryExpression: generateBinaryExpression(this.ctx, expr as BinaryExpression, (e: Expression) => this.generateExpression(e))
      case AssignmentExpression: {
        let assign = expr as AssignmentExpression;
        if (assign.left is Identifier) {
          let ident = assign.left as Identifier;
          let sym = this.ctx.wasmFunction.model.resolve(ident);
          
          this.generateExpression(assign.value);

          if (sym != null) {
            if (this.ctx.localIndices.has((sym as Symbol).id)) {
              this.ctx.emitter.emitLocalTee(this.ctx.localIndices[(sym as Symbol).id]);
              return;
            }
            if (this.ctx.wasm.globalMap.has((sym as Symbol).id)) {
              let globalIdx = this.ctx.wasm.globalMap[(sym as Symbol).id].index;
              this.ctx.emitter.emitGlobalSet(globalIdx);
              this.ctx.emitter.emitGlobalGet(globalIdx);
              return;
            }
            if ((sym as Symbol).declaration is ImportSpecifier) {
              let spec = (sym as Symbol).declaration as ImportSpecifier;
              let importedName = spec.imported.name;
              if (this.ctx.wasm.exportGlobalMap.has(importedName)) {
                let globalIdx = this.ctx.wasm.exportGlobalMap[importedName].index;
                this.ctx.emitter.emitGlobalSet(globalIdx);
                this.ctx.emitter.emitGlobalGet(globalIdx);
                return;
              }
            }
          }
          throw new Error("Could not resolve assignment target: " + ident.name);
        } else {
           throw new Error("Unsupported assignment target");
        }
      }
      case IfExpression {test, consequent, alternate}: {
        let nodeType = this.ctx.wasmFunction.model.getNodeType(expr);
        var resultValType = ValType.void;
        if (nodeType is F64Type) {
          resultValType = ValType.f64;
        } else if (nodeType is F32Type) {
          resultValType = ValType.f32;
        } else if (!(nodeType is VoidType)) {
          resultValType = ValType.i32;
        }

        this.generateExpression(test as Expression);
        this.ctx.emitter.emitIf(resultValType);
        this.ctx.enterBlockStructure();

        let dropResult = resultValType == ValType.void;
        this.generateIfBranch(consequent, dropResult);
        
        if (alternate != null) {
          this.ctx.emitter.emitElse();
          this.generateIfBranch(alternate as Node, dropResult);
        }
        
        this.ctx.exitBlockStructure();
        this.ctx.emitter.emitEnd();
      }
      case _: {
        throw new Error("Unsupported expression type in codegen");
      }
    }
  }
}
