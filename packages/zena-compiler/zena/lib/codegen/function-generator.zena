import { ValTypeStructRef, ValTypeRefNull, ValTypeRef, ValTypeAnyRef, ValTypeEqRef, ValTypeF64, ValTypeI32, valTypeEquals } from './wasm.zena';
import { 
  Node, VariableDeclaration, FunctionExpression, IdentifierPattern,
  Identifier, NumberLiteral, BooleanLiteral, StringLiteral, BlockStatement,
  ReturnStatement, ExpressionStatement, Statement, Expression, CallExpression,
  ImportSpecifier, BinaryExpression, UnaryExpression, AssignmentExpression,
  IfStatement, IfExpression, WhileStatement, ForStatement, BreakStatement,
  ContinueStatement, RecordLiteral, TupleLiteral, MemberExpression,
  IndexExpression, NewExpression, MethodDefinition, FieldInitializer, Parameter,
  ThisExpression, SuperInitializer, SuperExpression, ClassDeclaration, FieldDefinition,
  AccessorDeclaration, SetterInfo, AsExpression
} from '../ast.zena';
import { Type, I32Type, F64Type, F32Type, VoidType, FunctionType, RecordType, ClassType, typeToString } from '../types.zena';
import { SemanticModel, InterfaceAdaptation } from '../semantic-model.zena';
import { SymbolId, Symbol } from '../scope/symbol.zena';
import { Error } from 'zena:error';
import { ValType } from './wasm.zena';
import { typeToValType, WasmField, WasmStruct, sortWasmFields, getClassKey, getInterfaceKey, collectMixinFields } from './wasm-module.zena';
import { String } from "zena:string";
import { i32ToString } from "zena:string-convert";
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';

import { parseI32, parseF64 } from 'zena:string-convert';
import { walkEnter } from '../visitor.zena';
import { FunctionContext } from './function-context.zena';
import { generateIdentifier, generateNumberLiteral, generateBooleanLiteral, generateStringLiteral } from './expr/primitives.zena';
import { generateUnaryExpression, generateBinaryExpression } from './expr/operators.zena';

import { generateIdentifier, generateNumberLiteral, generateBooleanLiteral, generateStringLiteral } from './expr/primitives.zena';
import { generateUnaryExpression, generateBinaryExpression } from './expr/operators.zena';
import { generateCallExpression } from './expr/calls.zena';
import { generateAssignmentExpression } from './expr/assignment.zena';
import { generateIfExpression } from './expr/control-flow.zena';
import { generateNewExpression } from './expr/classes.zena';
import { generateMemberExpression, generateIndexExpression } from './expr/member.zena';
import { generateRecordLiteral, generateTupleLiteral } from './expr/literals.zena';
import { generateReturnStatement, generateExpressionStatement, generateIfStatement } from './stmt/control-flow.zena';
import { generateBreakStatement, generateContinueStatement, generateWhileStatement, generateForStatement } from './stmt/loops.zena';
import { generateBlockStatement } from './stmt/blocks.zena';
import { generateVariableDeclaration } from './stmt/bindings.zena';
import { discoverLocalsFromExpr, discoverLocalsFromStmt } from './locals.zena';
import { WasmEmitter } from './wasm-emitter.zena';
import { WasmFunction, WasmModule } from './wasm-module.zena';

/**
 * Manages the generic AST traversal and code generation.
 * Emits backend-agnostic logical instructions to a generic `WasmEmitter`.
 */
export class FunctionGenerator {
  ctx: FunctionContext;

  new(wasm: WasmModule, emitter: WasmEmitter, wasmFunction: WasmFunction)
    : ctx = new FunctionContext(wasm, emitter, wasmFunction);
    
  discoverLocalsFromExpr(expr: Expression): void {
    let adaptation = this.ctx.wasmFunction.model.getRecordAdaptation(expr);
    if (adaptation != null) {
      let inFields = new Array<WasmField>();
      for (let pair in adaptation.source.properties) {
        inFields.push(new WasmField(pair.key, typeToValType(this.ctx.wasm, pair.value), false));
      }
      let inDispatchInfo = this.ctx.wasm.getRecordDispatch(this.ctx.wasmFunction.model, inFields);
      this.ctx.getStructScratchLocal(inDispatchInfo.fatPtrType);
    }
    if (expr is MemberExpression) {
      let objectType = this.ctx.wasmFunction.model.getNodeType((expr as MemberExpression).object);
      match (objectType) {
        case RecordType as rt: {
          if (rt.enumDeclaration == null) {
            let fields = new Array<WasmField>();
            for (let pair in rt.properties) {
              fields.push(new WasmField(pair.key, typeToValType(this.ctx.wasm, pair.value), false));
            }
            let dispatchInfo = this.ctx.wasm.getRecordDispatch(this.ctx.wasmFunction.model, fields);
            this.ctx.getStructScratchLocal(dispatchInfo.fatPtrType);
          }
        }
        case _: {}
      }
    }
    discoverLocalsFromExpr(this.ctx, expr, (e: Expression) => this.discoverLocalsFromExpr(e), (s: Statement) => this.discoverLocalsFromStmt(s));
  }

  discoverLocalsFromStmt(stmt: Statement): void {
    discoverLocalsFromStmt(this.ctx, stmt, (e: Expression) => this.discoverLocalsFromExpr(e), (s: Statement) => this.discoverLocalsFromStmt(s));
  }

  generate(): void {
    if (this.ctx.wasmFunction.node == null) {
      // Synthetic helper functions have no AST node (e.g., dynamic property
      // getters for VTables). We generate their Wasm bytecodes directly here
      // rather than traversing a user-written AST body.
      this.ctx.emitter.emitFunctionCodeStart(this.ctx.wasmFunction);
      var name = "func" + i32ToString(this.ctx.wasmFunction.index);
      if (this.ctx.wasmFunction.name != null) {
        name = this.ctx.wasmFunction.name as String;
      }
      this.ctx.emitter.emitFunctionSignatureStart(name, this.ctx.wasmFunction.signature.index);
      this.ctx.emitter.emitFunctionLocalsStart(new Array<ValType>());
      
      if (this.ctx.wasmFunction.getterStruct != null) {
        let st = this.ctx.wasmFunction.getterStruct as WasmStruct;
        this.ctx.emitter.emitLocalGet(0);
        this.ctx.emitter.emitRefCast(st.index);
        this.ctx.emitter.emitStructGet(st.index, this.ctx.wasmFunction.getterFieldIndex);
      } else if (this.ctx.wasmFunction.setterStruct != null) {
        let st = this.ctx.wasmFunction.setterStruct as WasmStruct;
        this.ctx.emitter.emitLocalGet(0);
        this.ctx.emitter.emitRefCast(st.index);
        this.ctx.emitter.emitLocalGet(1);
        this.ctx.emitter.emitStructSet(st.index, this.ctx.wasmFunction.setterFieldIndex);
      } else if (this.ctx.wasmFunction.interfaceTrampolineTarget != null) {
        let target = this.ctx.wasmFunction.interfaceTrampolineTarget as WasmFunction;
        this.ctx.emitter.emitLocalGet(0);
        let ct = target.classType as ClassType;
        let classStruct = this.ctx.wasm.classStructs[getClassKey(ct)];
        this.ctx.emitter.emitRefCast(classStruct.index);
        var i = 1;
        while (i < this.ctx.wasmFunction.signature.params.length) {
          this.ctx.emitter.emitLocalGet(i);
          let paramWasmType = this.ctx.wasmFunction.signature.params[i];
          let targetWasmType = target.signature.params[i];
          if (!valTypeEquals(paramWasmType, targetWasmType)) {
            match (targetWasmType) {
              case ValTypeRefNull as targetRefNull: {
                this.ctx.emitter.emitRefCast(targetRefNull.target.index);
              }
              case ValTypeRef as targetRef: {
                this.ctx.emitter.emitRefCast(targetRef.target.index);
              }
              case _: {}
            }
          }
          i += 1;
        }
        this.ctx.emitter.emitCall(target);
      } else {
        this.ctx.emitter.emitUnreachable();
      }
      
      this.ctx.emitter.emitFunctionEnd();
      this.ctx.emitter.emitFunctionCodeEnd(this.ctx.wasmFunction);
      return;
    }
    
    let bodyNode = this.ctx.wasmFunction.node;
    var params: Array<Parameter> | null = null;
    var body: Node | null = null;

    match (bodyNode) {
      case FunctionExpression as fExpr: {
        params = fExpr.params;
        body = fExpr.body as Node;
      }
      case MethodDefinition as mDef: {
        params = mDef.params;
        body = mDef.body;
      }
      case AccessorDeclaration as acc: {
        params = new Array<Parameter>();
        body = acc.getter;
      }
      case SetterInfo as si: {
        let p = new Parameter(si.param, null, null, false, null, false, si.param.loc);
        let tempParams = new Array<Parameter>();
        tempParams.push(p);
        params = tempParams;
        body = si.body;
      }
      case _: {}
    }

    if (params != null) {
      var offset = 0;
      if (bodyNode is MethodDefinition || bodyNode is AccessorDeclaration || bodyNode is SetterInfo) {
        if (!this.ctx.wasmFunction.isStatic) {
          offset = 1;
        }
      }
      for (var i = 0; i < params.length; i += 1) {
        let param = params[i];
        let sym = this.ctx.wasmFunction.model.resolveDeclaration(param.name);
        if (sym != null) {
          this.ctx.localIndices[sym.id] = i + offset;
        }
      }
    }
    
    if (body != null) {
      match (body as Node) {
        case BlockStatement as blk: {
          this.discoverLocalsFromStmt(blk as Statement);
        }
        case Expression as expr: {
          this.discoverLocalsFromExpr(expr);
        }
        case _: {}
      }
    }

    this.ctx.emitter.emitFunctionCodeStart(this.ctx.wasmFunction);
    var name = "func" + i32ToString(this.ctx.wasmFunction.index);
    if (this.ctx.wasmFunction.name != null) {
      name = this.ctx.wasmFunction.name as String;
    }
    this.ctx.emitter.emitFunctionSignatureStart(name, this.ctx.wasmFunction.signature.index);
    
    
    this.ctx.emitter.emitFunctionLocalsStart(this.ctx.localTypes);
    
    if (bodyNode is MethodDefinition) {
      let mDef = bodyNode as MethodDefinition;
      let methName = match(mDef.name) {
        case Identifier {name}: name
        case _: "<unknown>"
      };
      if (methName == "<constructor>") {
        let structType = this.ctx.wasmFunction.structType;
        if (structType != null) {
          let classDecl = this.ctx.wasmFunction.classDecl;
          if (classDecl != null) {
            let cd = classDecl as ClassDeclaration;
            let mixinFields = new Array<FieldDefinition>();
            let seenMixins = new HashMap<String, boolean>();
            collectMixinFields(this.ctx.wasmFunction.model, cd.mixins, mixinFields, seenMixins);

            let allFields = new Array<FieldDefinition>();
            for (let member in cd.body) {
              if (member is FieldDefinition) {
                allFields.push(member as FieldDefinition);
              }
            }
            for (let fd in mixinFields) {
              allFields.push(fd);
            }

            for (let fd in allFields) {
              if (fd.value != null && !fd.isStatic) {
                let fieldName = match (fd.name) {
                  case Identifier {name}: name
                  case _: ""
                };
                if (fieldName != "") {
                  var actualFieldName = fieldName;
                  if (this.ctx.wasmFunction.classType != null) {
                    let ct = this.ctx.wasmFunction.classType as ClassType;
                    if (ct.fieldSetterNames != null) {
                      let m = ct.fieldSetterNames as HashMap<String, String>;
                      if (m.has(fieldName)) {
                        actualFieldName = m[fieldName];
                      }
                    }
                  }
                  var fieldIndex = -1;
                  let lookupName = if (actualFieldName.length > 0 && actualFieldName.sliceBytes(0, 1) == "#") {
                    if (this.ctx.wasmFunction.classType != null) {
                      getClassKey(this.ctx.wasmFunction.classType as ClassType) + "::" + actualFieldName
                    } else {
                      actualFieldName
                    }
                  } else {
                    actualFieldName
                  };
                  for (var i = 0; i < structType.fields.length; i += 1) {
                    if (structType.fields[i].name == lookupName) {
                      fieldIndex = i;
                    }
                  }
                  if (fieldIndex >= 0) {
                    this.ctx.emitter.emitLocalGet(0);
                    this.generateExpression(fd.value as Expression);
                    this.ctx.emitter.emitStructSet(structType.index, fieldIndex);
                  }
                }
              }
            }
          }
        }
        if (structType != null && mDef.initializerList != null) {
          let inits = mDef.initializerList as Array<Node>;
          for (let init in inits) {
            if (init is FieldInitializer) {
              let fi = init as FieldInitializer;
              if (fi.field is Identifier) {
                let fieldName = (fi.field as Identifier).name;
                var actualFieldName = fieldName;
                if (this.ctx.wasmFunction.classType != null) {
                  let ct = this.ctx.wasmFunction.classType as ClassType;
                  if (ct.fieldSetterNames != null) {
                    let m = ct.fieldSetterNames as HashMap<String, String>;
                    if (m.has(fieldName)) {
                      actualFieldName = m[fieldName];
                    }
                  }
                }
                var fieldIndex = -1;
                let lookupName = if (actualFieldName.length > 0 && actualFieldName.sliceBytes(0, 1) == "#") {
                  if (this.ctx.wasmFunction.classType != null) {
                    getClassKey(this.ctx.wasmFunction.classType as ClassType) + "::" + actualFieldName
                  } else {
                    actualFieldName
                  }
                } else {
                  actualFieldName
                };
                for (var i = 0; i < structType.fields.length; i += 1) {
                  if (structType.fields[i].name == lookupName) {
                    fieldIndex = i;
                  }
                }
                if (fieldIndex >= 0) {
                  this.ctx.emitter.emitLocalGet(0);
                  this.generateExpression(fi.value);
                  this.ctx.emitter.emitStructSet(structType.index, fieldIndex);
                }
              }
            }
          }
        }

        if (mDef.superInitializer != null) {
          let si = mDef.superInitializer as SuperInitializer;
          let cType = this.ctx.wasmFunction.classType;
          
          if (cType != null && cType.superType != null) {
            let st = cType.superType as ClassType;
            var ctorFunc: WasmFunction | null = null;
            
            for (let f in this.ctx.wasm.functions) {
              if (f.classType != null && (f.classType as ClassType).id == st.id && f.methodName == "<constructor>") {
                ctorFunc = f;
              }
            }

            if (ctorFunc != null) {
              this.ctx.emitter.emitLocalGet(0);
              var isSynthetic = false;
              for (let dec in mDef.decorators) {
                if (dec.name == "synthetic_constructor") {
                  isSynthetic = true;
                }
              }
              var argStart = 0;
              while (argStart < si.args.length) {
                  if (isSynthetic) {
                      this.ctx.emitter.emitLocalGet(argStart + 1);
                  } else {
                      this.generateExpression(si.args[argStart]);
                  }
                  argStart += 1;
              }
              this.ctx.emitter.emitCall(ctorFunc);
            } else {
                throw new Error("Super constructor not emitted!");
            }
          }
        }
      }
    }

    if (body != null) {
      match (body as Node) {
        case BlockStatement as blk: {
          this.generateStatement(blk as Statement);
          if (this.ctx.wasmFunction.signature.returns.length > 0) {
            if (this.ctx.isReachable) {
              throw new Error("Function '" + name + "' misses a return statement");
            } else if (this.ctx.needsUnreachable) {
              this.ctx.emitter.emitUnreachable();
            }
          }
        }
        case Expression as expr: {
          this.generateExpression(expr);
          this.ctx.emitter.emitReturn();
          this.ctx.isReachable = false;
        }
        case _: {}
      }
    }
    
    this.ctx.emitter.emitFunctionEnd();
    this.ctx.emitter.emitFunctionCodeEnd(this.ctx.wasmFunction);
  }

  generateStatement(stmt: Statement): void {
    if (!this.ctx.isReachable) {
      return;
    }
    match (stmt) {
      case BreakStatement: generateBreakStatement(this.ctx, stmt as BreakStatement)
      case ContinueStatement: generateContinueStatement(this.ctx, stmt as ContinueStatement)
      case ReturnStatement: generateReturnStatement(this.ctx, stmt as ReturnStatement, (e: Expression) => this.generateExpression(e))
      case ExpressionStatement: generateExpressionStatement(this.ctx, stmt as ExpressionStatement, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue))
      case BlockStatement: generateBlockStatement(this.ctx, stmt as BlockStatement, (s: Statement) => this.generateStatement(s))
      case IfStatement: generateIfStatement(this.ctx, stmt as IfStatement, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue), (s: Statement) => this.generateStatement(s))
      case WhileStatement: generateWhileStatement(this.ctx, stmt as WhileStatement, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue), (s: Statement) => this.generateStatement(s))
      case ForStatement: generateForStatement(this.ctx, stmt as ForStatement, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue), (s: Statement) => this.generateStatement(s))
      case VariableDeclaration: generateVariableDeclaration(this.ctx, stmt as VariableDeclaration, (e: Expression) => this.generateExpression(e))
      case _: {
        throw new Error("Unsupported statement type in codegen");
      }
    }
  }

  generateExpression(expr: Expression, discardValue: boolean = false): void {
    var handlesDiscardNatively: boolean = false;
    match (expr) {
      case Identifier: generateIdentifier(this.ctx, expr as Identifier)
      case MemberExpression: generateMemberExpression(this.ctx, expr as MemberExpression, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue))
      case IndexExpression: generateIndexExpression(this.ctx, expr as IndexExpression, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue))
      case CallExpression: generateCallExpression(this.ctx, expr as CallExpression, (e: Expression) => this.generateExpression(e))
      case NumberLiteral: generateNumberLiteral(this.ctx, expr as NumberLiteral)
      case BooleanLiteral: generateBooleanLiteral(this.ctx, expr as BooleanLiteral)
      case StringLiteral: generateStringLiteral(this.ctx, expr as StringLiteral)
      case RecordLiteral: generateRecordLiteral(this.ctx, expr as RecordLiteral, (e: Expression, d: boolean = false) => this.generateExpression(e, d))
      case TupleLiteral: generateTupleLiteral(this.ctx, expr as TupleLiteral, (e: Expression, d: boolean = false) => this.generateExpression(e, d))
      case UnaryExpression: generateUnaryExpression(this.ctx, expr as UnaryExpression, (e: Expression) => this.generateExpression(e))
      case ThisExpression: {
        this.ctx.emitter.emitLocalGet(0);
      }
      case BinaryExpression: generateBinaryExpression(this.ctx, expr as BinaryExpression, (e: Expression) => this.generateExpression(e))
      case AssignmentExpression: {
        generateAssignmentExpression(
          this.ctx,
          expr as AssignmentExpression,
          discardValue,
          (e) => this.generateExpression(e));
        handlesDiscardNatively = true;
      }
      case NewExpression: {
        generateNewExpression(this.ctx, expr as NewExpression, (e: Expression) => this.generateExpression(e));
      }
      case IfExpression: {
        generateIfExpression(this.ctx, expr as IfExpression, discardValue, (e: Expression, d: boolean = false) => this.generateExpression(e, d), (s: Statement) => this.generateStatement(s));
        handlesDiscardNatively = true;
      }
      case SuperExpression: {
        // Evaluate to `this` instance
        this.ctx.emitter.emitLocalGet(0);
      }
      case AsExpression: {
        let asExpr = expr as AsExpression;
        this.generateExpression(asExpr.expression);
        
        let sourceType = this.ctx.wasmFunction.model.getNodeType(asExpr.expression);
        let targetType = this.ctx.wasmFunction.model.getNodeType(asExpr);
        
        let sourceWasmType = typeToValType(this.ctx.wasm, sourceType);
        let targetWasmType = typeToValType(this.ctx.wasm, targetType);
        
        if (valTypeEquals(sourceWasmType, targetWasmType)) {
          // No-op identity cast
        } else {
          match (targetWasmType) {
            case ValTypeRefNull as targetRefNull: {
              let targetIdx = targetRefNull.target.index;
              match (sourceWasmType) {
                case ValTypeRefNull as sourceRefNull: {
                  if (sourceRefNull.target.index != targetIdx) {
                    this.ctx.emitter.emitRefCast(targetIdx);
                  }
                }
                case ValTypeRef as sourceRef: {
                  if (sourceRef.target.index != targetIdx) {
                    this.ctx.emitter.emitRefCast(targetIdx);
                  }
                }
                case ValTypeAnyRef: {
                  this.ctx.emitter.emitRefCast(targetIdx);
                }
                case ValTypeEqRef: {
                  this.ctx.emitter.emitRefCast(targetIdx);
                }
                case _: {
                  throw new Error("Unsupported ref_null cast in self-hosted compiler: " + typeToString(sourceType) + " to " + typeToString(targetType));
                }
              }
            }
            case ValTypeRef as targetRef: {
              let targetIdx = targetRef.target.index;
              match (sourceWasmType) {
                case ValTypeRef as sourceRef: {
                  if (sourceRef.target.index != targetIdx) {
                    this.ctx.emitter.emitRefCast(targetIdx);
                  }
                }
                case ValTypeRefNull as sourceRefNull: {
                  if (sourceRefNull.target.index != targetIdx) {
                    this.ctx.emitter.emitRefCast(targetIdx);
                  }
                }
                case ValTypeAnyRef: {
                  this.ctx.emitter.emitRefCast(targetIdx);
                }
                case ValTypeEqRef: {
                  this.ctx.emitter.emitRefCast(targetIdx);
                }
                case _: {
                  throw new Error("Unsupported ref cast in self-hosted compiler: " + typeToString(sourceType) + " to " + typeToString(targetType));
                }
              }
            }
            case ValTypeF64: {
              match (sourceWasmType) {
                case ValTypeI32: {
                  this.ctx.emitter.emitF64ConvertI32S();
                }
                case _: {
                  throw new Error("Unsupported primitive conversion to f64 from: " + typeToString(sourceType));
                }
              }
            }
            case _: {
              throw new Error("Unsupported cast in self-hosted compiler: " + typeToString(sourceType) + " to " + typeToString(targetType));
            }
          }
        }
      }
      case _: {
        throw new Error("Unsupported expression type in codegen");
      }
    }
    
    // EXCEPTION: Implicit Structural Adaptation
    // If the semantic model determined that this expression produces a record that is
    // being assigned to a narrower record type, we must perform an implicit adaptation.
    // This pops the original fat pointer from the stack, extracts the underlying instance,
    // and pushes a newly allocated fat pointer with a vtable tailored to the expected target.
    // In the future, this same injection point will likely be used to adapt functions 
    // and classes being assigned to interface contexts.
    let adaptation = this.ctx.wasmFunction.model.getRecordAdaptation(expr);
    if (adaptation != null && !discardValue) {
      let inFields = new Array<WasmField>();
      for (let pair in adaptation.source.properties) {
        inFields.push(new WasmField(pair.key, typeToValType(this.ctx.wasm, pair.value), false));
      }
      
      let inDispatchInfo = this.ctx.wasm.getRecordDispatch(this.ctx.wasmFunction.model, inFields);

      let scratchLocal = this.ctx.getStructScratchLocal(inDispatchInfo.fatPtrType);
      
      // Ensure the top-of-stack is cast exactly to the fatPtrType before storing
      // in the strongly-typed local. This avoids validation errors.
      this.ctx.emitter.emitRefCast(inDispatchInfo.fatPtrType.index);
      this.ctx.emitter.emitLocalSet(scratchLocal);

      let outFields = new Array<WasmField>();
      for (let pair in adaptation.target.properties) {
        outFields.push(new WasmField(pair.key, typeToValType(this.ctx.wasm, pair.value), false));
      }
      
      let outDispatchInfo = this.ctx.wasm.getAdaptedRecordDispatch(this.ctx.wasmFunction.model, inFields, outFields);

      this.ctx.emitter.emitLocalGet(scratchLocal);
      this.ctx.emitter.emitStructGet(inDispatchInfo.fatPtrType.index, 0); // Get Instance
      
      if (outDispatchInfo.vtableGlobal.index < 0) {
        throw new Error("vtableGlobal.index < 0 in generate! Key: " + outDispatchInfo.vtableGlobal.name);
      }
      this.ctx.emitter.emitGlobalGet(outDispatchInfo.vtableGlobal.index);
      
      this.ctx.emitter.emitStructNew(outDispatchInfo.fatPtrType.index);
    }

    let interfaceAdaptation = this.ctx.wasmFunction.model.getInterfaceAdaptation(expr);
    if (interfaceAdaptation != null && !discardValue) {
      let ia = interfaceAdaptation as InterfaceAdaptation;
      let cName = getClassKey(ia.source);
      let iName = getInterfaceKey(ia.target);
      
      let key = cName + "::" + iName;
      if (!this.ctx.wasm.classInterfaceVTables.has(key)) {
        throw new Error("Interface vtable global not found for " + key);
      }
      let vtableGlobal = this.ctx.wasm.classInterfaceVTables[key];
      
      this.ctx.emitter.emitGlobalGet(vtableGlobal.index);
      
      let fatPtrStruct = this.ctx.wasm.interfaceStructs[iName];
      this.ctx.emitter.emitStructNew(fatPtrStruct.index);
    }

    if (discardValue && !handlesDiscardNatively) {
      let exprType = this.ctx.wasmFunction.model.getNodeType(expr);
      if (!(exprType is VoidType)) {
        this.ctx.emitter.emitDrop();
      }
    }
  }
}
