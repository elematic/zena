import { 
  Node, VariableDeclaration, FunctionExpression, IdentifierPattern,
  Identifier, NumberLiteral, BooleanLiteral, StringLiteral, BlockStatement,
  ReturnStatement, ExpressionStatement, Statement, Expression, CallExpression,
  ImportSpecifier, BinaryExpression, UnaryExpression, AssignmentExpression,
  IfStatement, IfExpression, WhileStatement, ForStatement, BreakStatement,
  ContinueStatement
} from '../ast.zena';
import { Type, I32Type, F64Type, F32Type, VoidType } from '../types.zena';
import { SemanticModel } from '../semantic-model.zena';
import { SymbolId, Symbol } from '../scope/symbol.zena';
import { Error } from 'zena:error';
import { ValType } from "./wasm.zena";
import { String } from "zena:string";
import { i32ToString } from "zena:string-convert";
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';

import { parseI32, parseF64 } from 'zena:string-convert';

import { WasmEmitter } from './wasm-emitter.zena';
import { WasmFunction, WasmModule } from './wasm-module.zena';

/**
 * Manages the generic AST traversal and code generation.
 * Emits backend-agnostic logical instructions to a generic `WasmEmitter`.
 */
export class FunctionGenerator {
  wasm: WasmModule;
  emitter: WasmEmitter;
  wasmFunction: WasmFunction;
  localIndices = new HashMap<SymbolId, i32>();
  localTypes = new Array<ValType>();
  var isReachable: boolean = true;
  var needsUnreachable: boolean = false;

  /// Stack of active loops for break/continue targets.
  /// Tuple holds: (breakDepth: i32, continueDepth: i32)
  var loopStack = new Array<(i32, i32)>();

  new(this.wasm, this.emitter, this.wasmFunction);

  enterLoop(): void {
    // For while loops: break=1 (br to outer block), continue=0 (br to loop)
    this.loopStack.push((1, 0));
  }

  enterForLoop(): void {
    // For for loops: break=2 (br to outer block), continue=0 (br to inner block where update happens)
    this.loopStack.push((2, 0));
  }

  exitLoop(): void {
    this.loopStack.pop();
  }

  enterBlockStructure(): void {
    var i = 0;
    while (i < this.loopStack.length) {
      let (b, c) = this.loopStack[i];
      this.loopStack[i] = (b + 1, c + 1);
      i += 1;
    }
  }

  exitBlockStructure(): void {
    var i = 0;
    while (i < this.loopStack.length) {
      let (b, c) = this.loopStack[i];
      this.loopStack[i] = (b - 1, c - 1);
      i += 1;
    }
  }

  discoverLocalsFromExpr(expr: Expression): void {
    match (expr) {
      case IfExpression {consequent, alternate}: {
        if (consequent is BlockStatement) {
          this.discoverLocalsFromStmt(consequent as BlockStatement);
        } else if (consequent is Expression) {
          this.discoverLocalsFromExpr(consequent as Expression);
        }
        if (alternate != null) {
          if (alternate is BlockStatement) {
            this.discoverLocalsFromStmt(alternate as BlockStatement);
          } else if (alternate is Expression) {
            this.discoverLocalsFromExpr(alternate as Expression);
          }
        }
      }
      case AssignmentExpression {value}: {
        this.discoverLocalsFromExpr(value);
      }
      case BinaryExpression {left, right}: {
        this.discoverLocalsFromExpr(left);
        this.discoverLocalsFromExpr(right);
      }
      case CallExpression {args}: {
        for (let arg in args) {
          this.discoverLocalsFromExpr(arg);
        }
      }
      case _: {}
    }
  }

  discoverLocalsFromStmt(stmt: Statement): void {
    match (stmt) {
      case BlockStatement {body}: {
        for (let s in body) {
          this.discoverLocalsFromStmt(s);
        }
      }
      case IfStatement {consequent, alternate}: {
        this.discoverLocalsFromStmt(consequent);
        if (alternate != null) {
          this.discoverLocalsFromStmt(alternate as Statement);
        }
      }
      case WhileStatement {test, body}: {
        this.discoverLocalsFromExpr(test as Expression);
        this.discoverLocalsFromStmt(body);
      }
      case ForStatement {init, test, update, body}: {
        if (init != null) {
          // If init is a VariableDeclaration, it will be handled as a Statement
          // In Zena AST, a ForStatement init might be a Node but typically a VariableDeclaration or Expression
          if (init is Statement) {
            this.discoverLocalsFromStmt(init as Statement);
          } else if (init is Expression) {
            this.discoverLocalsFromExpr(init as Expression);
          }
        }
        if (test != null) {
          this.discoverLocalsFromExpr(test as Expression);
        }
        if (update != null) {
          this.discoverLocalsFromExpr(update as Expression);
        }
        this.discoverLocalsFromStmt(body);
      }
      case ExpressionStatement {expression}: {
        this.discoverLocalsFromExpr(expression);
      }
      case VariableDeclaration: {
        let decl = stmt as VariableDeclaration;
        if (decl.init != null) {
          this.discoverLocalsFromExpr(decl.init as Expression);
        }
        if (decl.pattern is IdentifierPattern) {
          let ident = decl.pattern as IdentifierPattern;
          let sym = this.wasmFunction.model.resolveDeclaration(ident);
          if (sym != null) {
            let varType = this.wasmFunction.model.getNodeType(decl);
            var vType = ValType.i32;
            if (varType is F64Type) {
              vType = ValType.f64;
            } else if (varType is F32Type) {
              vType = ValType.f32;
            }
            let index = this.wasmFunction.signature.params.length + this.localTypes.length;
            this.localIndices[sym.id] = index;
            this.localTypes.push(vType);
          }
        }
      }
      case _: {}
    }
  }

  generate(): void {
    let bodyNode = this.wasmFunction.node;
    for (var i = 0; i < bodyNode.params.length; i += 1) {
      let param = bodyNode.params[i];
      let sym = this.wasmFunction.model.resolveDeclaration(param.name);
      if (sym != null) {
        this.localIndices[sym.id] = i;
      }
    }
    
    let body = bodyNode.body;
    match (body) {
      case BlockStatement: {
        let block = body as BlockStatement;
        for (let stmt in block.body) {
          this.discoverLocalsFromStmt(stmt);
        }
      }
      case _: {}
    }

    this.emitter.emitFunctionCodeStart(this.wasmFunction);
    var name = "func" + i32ToString(this.wasmFunction.index);
    if (this.wasmFunction.name != null) {
      name = this.wasmFunction.name as String;
    }
    this.emitter.emitFunctionSignatureStart(name, this.wasmFunction.signature.index);
    
    
    this.emitter.emitFunctionLocalsStart(this.localTypes);
    
    match (bodyNode.body) {
      case BlockStatement: {
        let block = bodyNode.body as BlockStatement;
        for (let stmt in block.body) {
          this.generateStatement(stmt);
          if (!this.isReachable) {
            break;
          }
        }
        if (this.wasmFunction.signature.returns.length > 0) {
          if (this.isReachable) {
            throw new Error("Function '" + name + "' misses a return statement");
          } else if (this.needsUnreachable) {
            this.emitter.emitUnreachable();
          }
        }
      }
      case Expression: {
        this.generateExpression(bodyNode.body as Expression);
        this.emitter.emitReturn();
        this.isReachable = false;
      }
    }
    
    this.emitter.emitFunctionEnd();
    this.emitter.emitFunctionCodeEnd(this.wasmFunction);
  }

  generateIfBranch(branch: Node, dropResult: boolean): void {
    if (branch is BlockStatement) {
      let block = branch as BlockStatement;
      if (dropResult) {
        this.generateStatement(block);
      } else {
        // Evaluate all but last statement
        for (var i = 0; i < block.body.length - 1; i += 1) {
          this.generateStatement(block.body[i]);
        }
        if (block.body.length > 0) {
          let lastStmt = block.body[block.body.length - 1];
          if (lastStmt is ExpressionStatement) {
            let exprStmt = lastStmt as ExpressionStatement;
            this.generateExpression(exprStmt.expression);
            // Don't drop it, it's the result
          } else {
            this.generateStatement(lastStmt);
          }
        }
      }
    } else if (branch is Expression) {
      this.generateExpression(branch as Expression);
      if (dropResult) {
        let exprType = this.wasmFunction.model.getNodeType(branch);
        if (!(exprType is VoidType)) {
          this.emitter.emitDrop();
        }
      }
    } else {
      throw new Error("Invalid if branch type in codegen");
    }
  }

  generateStatement(stmt: Statement): void {
    if (!this.isReachable) {
      return;
    }
    match (stmt) {
      case BreakStatement {}: {
        let n = this.loopStack.length;
        if (n > 0) {
          let (bDepth, _) = this.loopStack[n - 1];
          this.emitter.emitBr(bDepth);
        } else {
          this.emitter.emitUnreachable();
        }
        this.isReachable = false;
      }
      case ContinueStatement {}: {
        let n = this.loopStack.length;
        if (n > 0) {
          let (_, cDepth) = this.loopStack[n - 1];
          this.emitter.emitBr(cDepth);
        } else {
          this.emitter.emitUnreachable();
        }
        this.isReachable = false;
      }
      case ReturnStatement {argument}: {
        if (argument != null) {
          this.generateExpression(argument as Expression);
        }
        this.emitter.emitReturn();
        this.isReachable = false;
        this.needsUnreachable = false;
      }
      case ExpressionStatement {expression}: {
        this.generateExpression(expression);
        let exprType = this.wasmFunction.model.getNodeType(expression);
        if (!(exprType is VoidType)) {
          this.emitter.emitDrop();
        }
      }
      case BlockStatement {body}: {
        for (let s in body) {
          this.generateStatement(s);
          if (!this.isReachable) {
            break; // Stop generating unreachable statements
          }
        }
      }
      case IfStatement {test, consequent, alternate}: {
        this.generateExpression(test as Expression);
        this.emitter.emitIf(ValType.void);
        this.enterBlockStructure();
        
        let wasReachable = this.isReachable;
        
        this.generateStatement(consequent);
        let consReachable = this.isReachable;
        
        this.isReachable = wasReachable; // Reset for alternate definition
        if (alternate != null) {
          this.emitter.emitElse();
          this.generateStatement(alternate as Statement);
          let altReachable = this.isReachable;
          this.isReachable = consReachable || altReachable;
          if (!this.isReachable) {
            this.needsUnreachable = true;
          }
        } else {
          // No alternate, so we just continue
          this.isReachable = true;
        }
        
        this.exitBlockStructure();
        this.emitter.emitEnd();
      }
      case WhileStatement {test, body}: {
        this.emitter.emitBlock(ValType.void);
        this.emitter.emitLoop(ValType.void);
        
        this.generateExpression(test as Expression);
        this.emitter.emitI32Const(0);
        this.emitter.emitI32Eq();
        this.emitter.emitBrIf(1);
        
        let wasReachable = this.isReachable;
        this.enterLoop();
        this.generateStatement(body);
        this.exitLoop();
        
        this.isReachable = wasReachable;
        this.emitter.emitBr(0);
        this.emitter.emitEnd();
        this.emitter.emitEnd();
        
        this.isReachable = wasReachable;
      }
      case ForStatement {init, test, update, body}: {
        if (init != null) {
          if (init is Statement) {
            this.generateStatement(init as Statement);
          } else if (init is Expression) {
            this.generateExpression(init as Expression);
            let exprType = this.wasmFunction.model.getNodeType(init as Node);
            if (!(exprType is VoidType)) {
              this.emitter.emitDrop();
            }
          }
        }
        
        this.emitter.emitBlock(ValType.void);
        this.emitter.emitLoop(ValType.void);
        
        if (test != null) {
          this.generateExpression(test as Expression);
          this.emitter.emitI32Const(0);
          this.emitter.emitI32Eq();
          this.emitter.emitBrIf(1);
        }
        
        // Inner block for continue to jump to (skipping body, hitting update)
        this.emitter.emitBlock(ValType.void);
        let wasReachable = this.isReachable;
        
        this.enterForLoop();
        this.generateStatement(body);
        this.exitLoop();
        
        this.emitter.emitEnd(); // End continue block
        this.isReachable = wasReachable;
        
        if (update != null) {
          this.generateExpression(update as Expression);
          let exprType = this.wasmFunction.model.getNodeType(update as Node);
          if (!(exprType is VoidType)) {
            this.emitter.emitDrop();
          }
        }
        
        this.emitter.emitBr(0);
        this.emitter.emitEnd();
        this.emitter.emitEnd();
        
        this.isReachable = wasReachable;
      }
      case VariableDeclaration: {
        let decl = stmt as VariableDeclaration;
        if (decl.init != null) {
          this.generateExpression(decl.init as Expression);
          if (decl.pattern is IdentifierPattern) {
            let ident = decl.pattern as IdentifierPattern;
            let sym = this.wasmFunction.model.resolveDeclaration(ident);
            if (sym != null && this.localIndices.has(sym.id)) {
              this.emitter.emitLocalSet(this.localIndices[sym.id]);
            }
          }
        }
      }
      case _: {
        throw new Error("Unsupported statement type in codegen");
      }
    }
  }

  generateExpression(expr: Expression): void {
    match (expr) {
      case Identifier: {
        let ident = expr as Identifier;
        let sym = this.wasmFunction.model.resolve(ident);
        if (sym != null) {
          if (this.localIndices.has((sym as Symbol).id)) {
            this.emitter.emitLocalGet(this.localIndices[(sym as Symbol).id]);
            return;
          }
          if (this.wasm.globalMap.has((sym as Symbol).id)) {
            this.emitter.emitGlobalGet(this.wasm.globalMap[(sym as Symbol).id].index);
            return;
          }
          if ((sym as Symbol).declaration is ImportSpecifier) {
            let spec = (sym as Symbol).declaration as ImportSpecifier;
            let importedName = spec.imported.name;
            if (this.wasm.exportGlobalMap.has(importedName)) {
              this.emitter.emitGlobalGet(this.wasm.exportGlobalMap[importedName].index);
              return;
            }
          }
        }
        throw new Error("Could not resolve identifier: " + ident.name);
      }
      case CallExpression {callee, args}: {
        match (callee) {
          case Identifier: {
            let ident = callee as Identifier;
            let model = this.wasmFunction.model;
            let sym = model.resolve(ident);
            
            if (sym == null) {
              throw new Error("Unresolved identifier in codegen: " + ident.name);
            }
            
            if (this.wasm.functionMap.has((sym as Symbol).id)) {
              for (let arg in args) {
                this.generateExpression(arg);
              }
              this.emitter.emitCall(this.wasm.functionMap[(sym as Symbol).id]);
              return;
            } else {
              if ((sym as Symbol).declaration is ImportSpecifier) {
                let spec = (sym as Symbol).declaration as ImportSpecifier;
                let importedName = spec.imported.name;
                if (this.wasm.exportMap.has(importedName)) {
                  for (let arg in args) {
                    this.generateExpression(arg);
                  }
                  this.emitter.emitCall(this.wasm.exportMap[importedName]);
                  return;
                }
                throw new Error("Export map missing: " + importedName);
              }
              throw new Error("Could not resolve function call target");
            }
          }
          case _: {
            throw new Error("Unsupported call expression");
          }        
        }
      }
      case NumberLiteral {raw}: {
        let nodeType = this.wasmFunction.model.getNodeType(expr as Node);
        if (nodeType is F64Type || nodeType is F32Type) {
          let val = parseF64(raw);
          this.emitter.emitF64Const(val);
        } else {
          let (ok, val) = parseI32(raw);
          if (!ok) {
            throw new Error('Failed to parse i32: ' + raw);
          }
          this.emitter.emitI32Const(val as i32);
        }
      }
      case BooleanLiteral {value}: {
        this.emitter.emitBooleanConst(value);
      }
      case StringLiteral {value}: {
        this.emitter.emitStringConst(value);
      }
      case UnaryExpression: {
        let un = expr as UnaryExpression;
        if (un.operator == "-") {
          let nodeType = this.wasmFunction.model.getNodeType(un);
          if (nodeType is F64Type || nodeType is F32Type) {
            this.emitter.emitF64Const(0.0);
            this.generateExpression(un.argument);
            this.emitter.emitF64Sub();
          } else {
            this.emitter.emitI32Const(0);
            this.generateExpression(un.argument);
            this.emitter.emitI32Sub();
          }
        } else {
          throw new Error("Unsupported unary operator: " + un.operator);
        }
      }
      case BinaryExpression: {
        let bin = expr as BinaryExpression;
        // TODO: Support operator overloading and custom classes
        
        let model = this.wasmFunction.model;
        let leftType = model.getNodeType(bin.left);
        let rightType = model.getNodeType(bin.right);
        
        if (leftType == null || rightType == null) {
          throw new Error("Missing type info in semantic model for binary expression operands");
        }
        
        var isFloatContext = false;
        if (leftType is F64Type || rightType is F64Type || leftType is F32Type || rightType is F32Type) {
            isFloatContext = true;
        }

        // Implicit F64 upconversion logic
        if (isFloatContext && !(leftType is F64Type) && !(leftType is F32Type)) {
          this.generateExpression(bin.left);
          this.emitter.emitF64ConvertI32S();
        } else {
          this.generateExpression(bin.left);
        }

        if (isFloatContext && !(rightType is F64Type) && !(rightType is F32Type)) {
          this.generateExpression(bin.right);
          this.emitter.emitF64ConvertI32S();
        } else {
          this.generateExpression(bin.right);
        }
        
        if (isFloatContext) {
          match (bin.operator) {
            case "+": this.emitter.emitF64Add()
            case "-": this.emitter.emitF64Sub()
            case "*": this.emitter.emitF64Mul()
            case "/": this.emitter.emitF64Div()
            case "==": this.emitter.emitF64Eq()
            case "!=": this.emitter.emitF64Ne()
            case "===": this.emitter.emitF64Eq()
            case "!==": this.emitter.emitF64Ne()
            case "<": this.emitter.emitF64Lt()
            case "<=": this.emitter.emitF64Le()
            case ">": this.emitter.emitF64Gt()
            case ">=": this.emitter.emitF64Ge()
            case _: throw new Error("Unsupported operator for f64: " + bin.operator)
          }
        } else {
          match (bin.operator) {
            case "+": this.emitter.emitI32Add()
            case "-": this.emitter.emitI32Sub()
            case "*": this.emitter.emitI32Mul()
            case "/": this.emitter.emitI32DivS()
            case "%": this.emitter.emitI32RemS()
            case "==": this.emitter.emitI32Eq()
            case "!=": this.emitter.emitI32Ne()
            case "===": this.emitter.emitI32Eq()
            case "!==": this.emitter.emitI32Ne()
            case "<": this.emitter.emitI32LtS()
            case "<=": this.emitter.emitI32LeS()
            case ">": this.emitter.emitI32GtS()
            case ">=": this.emitter.emitI32GeS()
            case "&": this.emitter.emitI32And()
            case "|": this.emitter.emitI32Or()
            case "^": this.emitter.emitI32Xor()
            case "<<": this.emitter.emitI32Shl()
            case ">>": this.emitter.emitI32ShrS()
            case ">>>": this.emitter.emitI32ShrU()
            case _: throw new Error("Unsupported operator for i32: " + bin.operator)
          }
        }
      }
      case AssignmentExpression: {
        let assign = expr as AssignmentExpression;
        if (assign.left is Identifier) {
          let ident = assign.left as Identifier;
          let sym = this.wasmFunction.model.resolve(ident);
          
          this.generateExpression(assign.value);

          if (sym != null) {
            if (this.localIndices.has((sym as Symbol).id)) {
              this.emitter.emitLocalTee(this.localIndices[(sym as Symbol).id]);
              return;
            }
            if (this.wasm.globalMap.has((sym as Symbol).id)) {
              let globalIdx = this.wasm.globalMap[(sym as Symbol).id].index;
              this.emitter.emitGlobalSet(globalIdx);
              this.emitter.emitGlobalGet(globalIdx);
              return;
            }
            if ((sym as Symbol).declaration is ImportSpecifier) {
              let spec = (sym as Symbol).declaration as ImportSpecifier;
              let importedName = spec.imported.name;
              if (this.wasm.exportGlobalMap.has(importedName)) {
                let globalIdx = this.wasm.exportGlobalMap[importedName].index;
                this.emitter.emitGlobalSet(globalIdx);
                this.emitter.emitGlobalGet(globalIdx);
                return;
              }
            }
          }
          throw new Error("Could not resolve assignment target: " + ident.name);
        } else {
           throw new Error("Unsupported assignment target");
        }
      }
      case IfExpression {test, consequent, alternate}: {
        let nodeType = this.wasmFunction.model.getNodeType(expr);
        var resultValType = ValType.void;
        if (nodeType is F64Type) {
          resultValType = ValType.f64;
        } else if (nodeType is F32Type) {
          resultValType = ValType.f32;
        } else if (!(nodeType is VoidType)) {
          resultValType = ValType.i32;
        }

        this.generateExpression(test as Expression);
        this.emitter.emitIf(resultValType);
        this.enterBlockStructure();

        let dropResult = resultValType == ValType.void;
        this.generateIfBranch(consequent, dropResult);
        
        if (alternate != null) {
          this.emitter.emitElse();
          this.generateIfBranch(alternate as Node, dropResult);
        }
        
        this.exitBlockStructure();
        this.emitter.emitEnd();
      }
      case _: {
        throw new Error("Unsupported expression type in codegen");
      }
    }
  }
}
