import { console } from 'zena:console';
import { ValTypeStructRef, ValTypeRefNull, ValTypeRef, ValTypeAnyRef, ValTypeEqRef, ValTypeF64, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeVoid, valTypeEquals, ValTypeExternRef } from './wasm.zena';
import { 
  Node, VariableDeclaration, FunctionExpression, IdentifierPattern,
  Identifier, NumberLiteral, BooleanLiteral, StringLiteral, NullLiteral, BlockStatement,
  ReturnStatement, ExpressionStatement, Statement, Expression, CallExpression,
  ImportSpecifier, BinaryExpression, UnaryExpression, AssignmentExpression,
  IfStatement, IfExpression, WhileStatement, ForStatement, BreakStatement,
  ContinueStatement, RecordLiteral, TupleLiteral, MemberExpression,
  IndexExpression, NewExpression, MethodDefinition, FieldInitializer, Parameter,
  ThisExpression, SuperInitializer, SuperExpression, ClassDeclaration, FieldDefinition,
  AccessorDeclaration, SetterInfo, AsExpression, IsExpression, MatchExpression, ArrayLiteral, SymbolPropertyName, TemplateLiteral, TaggedTemplateExpression,
  SourceLocation, ForInStatement, InterfaceDeclaration, EnumDeclaration, MixinDeclaration,
  TypeAliasDeclaration, ImportDeclaration, ExportAllDeclaration, ExportFromDeclaration, DeclareFunction,
  ThrowExpression, TryExpression, RangeExpression, PipelineExpression, PipePlaceholder,
  Module, getMemberPropertyName
} from '../ast.zena';
import { Type, I32Type, F64Type, F32Type, VoidType, FunctionType, RecordType, ClassType, InterfaceType, typeToString, isRefType, AnyType, AnyRefType, EqRefType, isVoidOrNeverType, FieldInfo } from '../types.zena';
import { SemanticModel, InterfaceAdaptation, FunctionAdaptation } from '../semantic-model.zena';
import { Program, CompilationUnit } from '../program.zena';
import { dirName, normalizePath } from '../module-resolver.zena';
import { SymbolId, Symbol } from '../scope/symbol.zena';
import { Error } from 'zena:error';
import { ValType, HeapType, heapTypeToSigned } from './wasm.zena';
import { WasmField, WasmStruct, WasmSignature, sortWasmFields, WasmGlobal, WasmFunction, WasmModule, WasmArray } from './wasm-module.zena';
import { typeToValType, getClosureStruct, getCellStruct, typeToValTypeWithSub, substituteTypeParamsInCodegen, getNodeType, getClassTypeParameters, getNonNullableType, getInterfaceTypeParameters } from './type-mapping.zena';
import { 
  getClassKey, getInterfaceKey, collectMixinFields, getClassInterfaceKey,
  getClassPrivateFieldKey, classInterfaceKeyToString,
  MixinKey, ClassKey, ClassMethodKey, getClassMethodKey, ClosureSpecializationKey, getClosureSpecializationKey
} from './codegen-utils.zena';
import { String } from "zena:string";
import { i32ToString } from "zena:string-convert";
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';

import { parseI32, parseF64, parseI64 } from 'zena:string-convert';
import { walkEnter } from '../visitor.zena';
import { FunctionContext } from './function-context.zena';
import { generateIdentifier, generateNumberLiteral, generateBooleanLiteral, generateStringLiteral, generateTemplateLiteral, generateTaggedTemplateExpression } from './expr/primitives.zena';
import { generateUnaryExpression, generateBinaryExpression } from './expr/operators.zena';
import { generateCallExpression } from './expr/calls.zena';
import { generateAssignmentExpression } from './expr/assignment.zena';
import { generateIfExpression, generateThrowExpression, generateTryExpression, generatePipelineExpression, generatePipePlaceholder } from './expr/control-flow.zena';
import { generateNewExpression, generateRangeExpression } from './expr/classes.zena';
import { generateMatchExpression } from './expr/match.zena';
import { generateMemberExpression, generateIndexExpression } from './expr/member.zena';
import { generateRecordLiteral, generateTupleLiteral, generateArrayLiteral } from './expr/literals.zena';
import { generateReturnStatement, generateExpressionStatement, generateIfStatement, generateValueReturn } from './stmt/control-flow.zena';
import { generateBreakStatement, generateContinueStatement, generateWhileStatement, generateForStatement, generateForInStatement } from './stmt/loops.zena';
import { generateBlockStatement } from './stmt/blocks.zena';
import { generateVariableDeclaration, generatePatternBinding } from './stmt/bindings.zena';
import { discoverLocalsFromExpr, discoverLocalsFromStmt, discoverLocalsFromPattern } from './locals.zena';
import { WasmEmitter } from './wasm-emitter.zena';

/**
 * Manages the generic AST traversal and code generation.
 * Emits backend-agnostic logical instructions to a generic `WasmEmitter`.
 */
export final class FunctionGenerator {
  ctx: FunctionContext;

  new(wasm: WasmModule, emitter: WasmEmitter, wasmFunction: WasmFunction)
    : ctx = new FunctionContext(wasm, emitter, wasmFunction);
    
  discoverLocalsFromExpr(expr: Expression): void {
    let adaptation = this.ctx.wasmFunction.model.getRecordAdaptation(expr);
    if (adaptation != null) {
      let inFields = new Array<WasmField>();
      for (let pair in adaptation.source.properties) {
        inFields.push(new WasmField(pair.key, typeToValType(this.ctx.wasm, pair.value), false));
      }
      let inDispatchInfo = this.ctx.wasm.getRecordDispatch(this.ctx.wasmFunction.model, inFields);
      this.ctx.getStructScratchLocal(inDispatchInfo.fatPtrType);
    }
    if (expr is MemberExpression) {
      let objectType = this.ctx.wasmFunction.model.getNodeType((expr as MemberExpression).object);
      match (objectType) {
        case RecordType as rt: {
          if (rt.enumDeclaration == null) {
            let fields = new Array<WasmField>();
            for (let pair in rt.properties) {
              fields.push(new WasmField(pair.key, typeToValType(this.ctx.wasm, pair.value), false));
            }
            let dispatchInfo = this.ctx.wasm.getRecordDispatch(this.ctx.wasmFunction.model, fields);
            this.ctx.getStructScratchLocal(dispatchInfo.fatPtrType);
          }
        }
        case _: {}
      }
    }
    discoverLocalsFromExpr(this.ctx, expr, (e: Expression) => this.discoverLocalsFromExpr(e), (s: Statement) => this.discoverLocalsFromStmt(s));
  }

  discoverLocalsFromStmt(stmt: Statement): void {
    discoverLocalsFromStmt(this.ctx, stmt, (e: Expression) => this.discoverLocalsFromExpr(e), (s: Statement) => this.discoverLocalsFromStmt(s));
  }

  generate(): void {
    if (this.ctx.wasmFunction.importWrapperTarget != null) {
      this.ctx.emitter.emitFunctionCodeStart(this.ctx.wasmFunction);
      var name = "func" + i32ToString(this.ctx.wasmFunction.index);
      if (this.ctx.wasmFunction.name != null) {
        name = this.ctx.wasmFunction.name as String;
      }
      this.ctx.emitter.emitFunctionSignatureStart(name, this.ctx.wasmFunction.signature.index);
      this.ctx.emitter.emitFunctionLocalsStart(new Array<ValType>());
      this.generateImportWrapperBody();
      this.ctx.emitter.emitFunctionEnd();
      this.ctx.emitter.emitFunctionCodeEnd(this.ctx.wasmFunction);
      return;
    }

    if (this.ctx.wasmFunction.node == null) {
      if (this.ctx.wasmFunction.name != null && (this.ctx.wasmFunction.name as String) == "__start") {
        this.ctx.emitter.emitFunctionCodeStart(this.ctx.wasmFunction);
        this.ctx.emitter.emitFunctionSignatureStart("__start", this.ctx.wasmFunction.signature.index);
        this.ctx.emitter.emitFunctionLocalsStart(this.ctx.localTypes);
        
        if (this.ctx.wasm.sharedStringsGlobal != null) {
          let byteArrayType = this.ctx.wasm.getByteArrayType();
          let byteArrayTypeIndex = byteArrayType.index;
          
          this.ctx.emitter.emitI32Const(0); // offset
          this.ctx.emitter.emitI32Const(this.ctx.wasm.sharedStringsLength); // length
          this.ctx.emitter.emitArrayNewData(byteArrayTypeIndex, this.ctx.wasm.sharedStringsDataIdx);
          this.ctx.emitter.emitGlobalSet((this.ctx.wasm.sharedStringsGlobal as WasmGlobal).index);
        }
        
        for (let g in this.ctx.wasm.globals) {
          if (g.initExpr != null) {
            let isLiteral = match (g.initExpr as Expression) {
              case NumberLiteral: true
              case BooleanLiteral: true
              case _: false
            };
            if (!isLiteral) {
              let originalModel = this.ctx.wasmFunction.model;
              this.ctx.wasmFunction.model = g.model;
              this.generateExpression(g.initExpr as Expression, false);
              this.ctx.wasmFunction.model = originalModel;
              this.ctx.emitter.emitGlobalSet(g.index);
            }
          } else if (g.namespaceImport != null) {
            let spec = g.namespaceImport as ImportSpecifier;
            let moduleModel = g.model;
            
            let parentNode = moduleModel.getParent(spec);
            if (parentNode != null && parentNode is ImportDeclaration) {
              let importDecl = parentNode as ImportDeclaration;
              let specifier = importDecl.moduleSpecifier.value;
              var canonicalPath = specifier;
              if (specifier.startsWith("./") || specifier.startsWith("../")) {
                let referrer = moduleModel.getParent(importDecl);
                if (referrer != null && referrer is Module) {
                  let mod = referrer as Module;
                  let dir = dirName(mod.path);
                  canonicalPath = normalizePath(dir + "/" + specifier);
                }
              }
              
              let prog = this.ctx.wasm.program as Program;
              if (prog.unitsByPath.has(canonicalPath)) {
                let targetUnit = prog.unitsByPath[canonicalPath];
                let exports = new HashMap<String, Symbol>();
                collectValueExports(prog, targetUnit, exports);
                
                let recordType = moduleModel.getNodeType(spec as Node) as RecordType;
                let fields = new Array<WasmField>();
                for (let pair in recordType.properties) {
                  fields.push(new WasmField(pair.key, typeToValType(this.ctx.wasm, pair.value), false));
                }
                sortWasmFields(fields);
                
                let dispatchInfo = this.ctx.wasm.getRecordDispatch(moduleModel, fields);
                let structType = dispatchInfo.concreteType;
                
                for (let field in fields) {
                  if (let (true, sym) = exports.get(field.name as String)) {
                    if (this.ctx.wasm.functionMap.has(sym.id)) {
                      let f = this.ctx.wasm.functionMap[sym.id];
                      f.isReferenceTaken = true;
                      let closureStruct = this.ctx.wasm.getClosureStruct(f.signature.params, f.signature.returns);
                      let refTarget = if (f.closureTrampoline != null) (f.closureTrampoline as WasmFunction) else f;
                      this.ctx.emitter.emitRefFunc(refTarget.index);
                      this.ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.struct));
                      this.ctx.emitter.emitStructNew(closureStruct.index);
                    } else if (this.ctx.wasm.globalMap.has(sym.id)) {
                      let targetGlobal = this.ctx.wasm.globalMap[sym.id];
                      this.ctx.emitter.emitGlobalGet(targetGlobal.index);
                    } else {
                      this.ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.none));
                    }
                  } else {
                    this.ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.none));
                  }
                }
                
                this.ctx.emitter.emitStructNew(structType.index);
                this.ctx.emitter.emitGlobalGet(dispatchInfo.vtableGlobal.index);
                this.ctx.emitter.emitStructNew(dispatchInfo.fatPtrType.index);
                this.ctx.emitter.emitGlobalSet(g.index);
              }
            }
          }
        }
        
        this.ctx.emitter.emitFunctionEnd();
        this.ctx.emitter.emitFunctionCodeEnd(this.ctx.wasmFunction);
        return;
      }

      // Synthetic helper functions have no AST node (e.g., dynamic property
      // getters for VTables). We generate their Wasm bytecodes directly here
      // rather than traversing a user-written AST body.
      this.ctx.emitter.emitFunctionCodeStart(this.ctx.wasmFunction);
      var name = "func" + i32ToString(this.ctx.wasmFunction.index);
      if (this.ctx.wasmFunction.name != null) {
        name = this.ctx.wasmFunction.name as String;
      }
      this.ctx.emitter.emitFunctionSignatureStart(name, this.ctx.wasmFunction.signature.index);
      let helperLocals = new Array<ValType>();
      if (this.ctx.wasmFunction.name != null && (this.ctx.wasmFunction.name as String) == "get_string_literal") {
        let stringClass = this.ctx.wasm.stringClass;
        if (stringClass != null) {
          let stringKey = getClassKey(stringClass as ClassType);
          if (let (true, stringInfo) = this.ctx.wasm.classInfos.get(stringKey)) {
            helperLocals.push(new ValTypeRefNull(stringInfo.structType)); // local 1: str
          }
        }
      }
      this.ctx.emitter.emitFunctionLocalsStart(helperLocals);
      
      if (this.ctx.wasmFunction.isCaseClassEq) {
        this.generateCaseClassEqBody();
      } else if (this.ctx.wasmFunction.isCaseClassHash) {
        this.generateCaseClassHashBody();
      } else if (this.ctx.wasmFunction.name != null && (this.ctx.wasmFunction.name as String) == "string_from_shared") {
        this.generateStringFromSharedBody();
      } else if (this.ctx.wasmFunction.name != null && (this.ctx.wasmFunction.name as String) == "get_string_literal") {
        this.generateGetStringLiteralBody();
      } else if (this.ctx.wasmFunction.methodName != null && (this.ctx.wasmFunction.methodName as String) == "<constructor>" && this.ctx.wasmFunction.classType != null && (this.ctx.wasmFunction.classType as ClassType).isCaseClass) {
        this.generateCaseClassConstructorBody();
      } else if (this.ctx.wasmFunction.getterStruct != null) {
        let st = this.ctx.wasmFunction.getterStruct as WasmStruct;
        this.ctx.emitter.emitLocalGet(0);
        this.ctx.emitter.emitRefCast(st.index);
        this.ctx.emitter.emitStructGet(st.index, this.ctx.wasmFunction.getterFieldIndex);
      } else if (this.ctx.wasmFunction.setterStruct != null) {
        let st = this.ctx.wasmFunction.setterStruct as WasmStruct;
        this.ctx.emitter.emitLocalGet(0);
        this.ctx.emitter.emitRefCast(st.index);
        this.ctx.emitter.emitLocalGet(1);
        this.ctx.emitter.emitStructSet(st.index, this.ctx.wasmFunction.setterFieldIndex);
      } else if (this.ctx.wasmFunction.interfaceTrampolineTarget != null) {
        let target = this.ctx.wasmFunction.interfaceTrampolineTarget as WasmFunction;
        this.ctx.emitter.emitLocalGet(0);
        let receiverType = target.signature.params[0];
        match (receiverType) {
          case ValTypeRefNull as r: {
            this.ctx.emitter.emitRefCast(r.target.index);
          }
          case ValTypeRef as r: {
            this.ctx.emitter.emitRefCast(r.target.index);
          }
          case _: {}
        }
        var i = 1;
        while (i < this.ctx.wasmFunction.signature.params.length) {
          this.ctx.emitter.emitLocalGet(i);
          let paramWasmType = this.ctx.wasmFunction.signature.params[i];
          let targetWasmType = target.signature.params[i];
          if (!valTypeEquals(paramWasmType, targetWasmType)) {
            match (targetWasmType) {
              case ValTypeRefNull as targetRefNull: {
                this.ctx.emitter.emitRefCast(targetRefNull.target.index);
              }
              case ValTypeRef as targetRef: {
                this.ctx.emitter.emitRefCast(targetRef.target.index);
              }
              case _: {}
            }
          }
          i += 1;
        }
        this.ctx.emitter.emitCall(target);
      } else if (this.ctx.wasmFunction.isFunctionAdaptation) {
        this.generateFunctionAdaptationBody();
      } else if (this.ctx.wasmFunction.isClosureTrampoline) {
        this.generateClosureTrampolineBody();
      } else if (this.ctx.wasmFunction.isClosureWrapper) {
        this.generateClosureWrapperBody();
      } else if (this.ctx.wasmFunction.importWrapperTarget != null) {
        this.generateImportWrapperBody();
      } else if (name == "wasi_write_string_helper") {
        this.generateWasiWriteStringHelper();
      } else if (name == "string_hash_helper") {
        this.generateStringHashHelper();
      } else if (name == "$stringCreate") {
        this.generateStringCreate();
      } else if (name == "$stringSetByte") {
        this.generateStringSetByte();
      } else if (name == "$stringGetByte") {
        this.generateStringGetByte();
      } else if (name == "$stringGetLength") {
        this.generateStringGetLength();
      } else if (name == "$stringHash") {
        this.generateStringHash();
      } else {
        this.ctx.emitter.emitUnreachable();
      }
      
      this.ctx.emitter.emitFunctionEnd();
      this.ctx.emitter.emitFunctionCodeEnd(this.ctx.wasmFunction);
      return;
    }
    
    let bodyNode = this.ctx.wasmFunction.node;

    var params: Array<Parameter> | null = null;
    var body: Node | null = null;

    match (bodyNode) {
      case FunctionExpression as fExpr: {
        params = fExpr.params;
        body = fExpr.body as Node;
      }
      case MethodDefinition as mDef: {
        params = mDef.params;
        body = mDef.body;
      }
      case AccessorDeclaration as acc: {
        params = new Array<Parameter>();
        body = acc.getter;
      }
      case SetterInfo as si: {
        let p = new Parameter(si.param, null, null, false, null, false, si.param.loc);
        let tempParams = new Array<Parameter>();
        tempParams.push(p);
        params = tempParams;
        body = si.body;
      }
      case _: {}
    }

    if (params != null) {
      var offset = 0;
      if (bodyNode is MethodDefinition || bodyNode is AccessorDeclaration || bodyNode is SetterInfo) {
        if (!this.ctx.wasmFunction.isStatic) {
          offset = 1;
        }
      } else if (this.ctx.wasmFunction.isClosure) {
        offset = 1;
      }
      for (var i = 0; i < params.length; i += 1) {
        let param = params[i];
        let sym = this.ctx.wasmFunction.model.resolveDeclaration(param.name);
        if (sym != null) {
          this.ctx.localIndices[sym.id] = i + offset;
        }
        if (param.pattern != null) {
          discoverLocalsFromPattern(this.ctx, param.pattern as Node);
        }
      }
    }
    
    if (body != null) {
      match (body as Node) {
        case BlockStatement as blk: {
          this.discoverLocalsFromStmt(blk as Statement);
        }
        case Expression as expr: {
          this.discoverLocalsFromExpr(expr);
        }
        case _: {}
      }
    }

    this.ctx.emitter.emitFunctionCodeStart(this.ctx.wasmFunction);
    var name = "func" + i32ToString(this.ctx.wasmFunction.index);
    if (this.ctx.wasmFunction.name != null) {
      name = this.ctx.wasmFunction.name as String;
    }
    this.ctx.emitter.emitFunctionSignatureStart(name, this.ctx.wasmFunction.signature.index);
    
    
    this.ctx.emitter.emitFunctionLocalsStart(this.ctx.localTypes);
    
    if (params != null) {
      for (var i = 0; i < params.length; i += 1) {
        let param = params[i];
        let sym = this.ctx.wasmFunction.model.resolveDeclaration(param.name);
        if (sym != null && this.ctx.isCelled(sym.id)) {
          let paramIdx = this.ctx.localIndices[sym.id];
          let symType = this.ctx.wasmFunction.model.getBindingType(sym);
          let valType = typeToValTypeWithSub(this.ctx.wasm, symType, this.ctx.wasmFunction);
          let cellStruct = getCellStruct(this.ctx.wasm, valType);
          
          let cellLocalIdx = this.ctx.allocLocal(new ValTypeRefNull(cellStruct));
          this.ctx.emitter.emitLocalGet(paramIdx);
          this.ctx.emitter.emitStructNew(cellStruct.index);
          this.ctx.emitter.emitLocalSet(cellLocalIdx);
          this.ctx.localIndices[sym.id] = cellLocalIdx;
        }
      }
      
      for (var i = 0; i < params.length; i += 1) {
        let param = params[i];
        if (param.pattern != null) {
          let sym = this.ctx.wasmFunction.model.resolveDeclaration(param.name);
          if (sym != null) {
            let paramIdx = this.ctx.localIndices[sym.id];
            let symType = this.ctx.wasmFunction.model.getBindingType(sym);
            let loadParamValue = (): void => {
              this.ctx.emitter.emitLocalGet(paramIdx);
            };
            generatePatternBinding(this.ctx, param.pattern as Node, symType, loadParamValue);
          }
        }
      }
    }

    if (this.ctx.wasmFunction.isClosure) {
      let contextStruct = this.ctx.wasmFunction.contextStruct as WasmStruct;
      if (contextStruct.fields.length > 0) {
        let typedCtxLocalIdx = this.ctx.allocLocal(new ValTypeRefNull(contextStruct));
        this.ctx.emitter.emitLocalGet(0);
        this.ctx.emitter.emitRefCast(contextStruct.index);
        this.ctx.emitter.emitLocalSet(typedCtxLocalIdx);
        
        var fieldIdx = 0;
        if (this.ctx.wasmFunction.capturesThis) {
          let field = contextStruct.fields[fieldIdx];
          let thisLocalIdx = this.ctx.allocLocal(field.type);
          this.ctx.thisLocalIndex = thisLocalIdx;
          
          this.ctx.emitter.emitLocalGet(typedCtxLocalIdx);
          this.ctx.emitter.emitStructGet(contextStruct.index, fieldIdx);
          this.ctx.emitter.emitLocalSet(thisLocalIdx);
          fieldIdx += 1;
        }
        for (let symId in this.ctx.wasmFunction.captures) {
          let field = contextStruct.fields[fieldIdx];
          let localIdx = this.ctx.allocLocal(field.type);
          this.ctx.localIndices[symId] = localIdx;
          
          this.ctx.emitter.emitLocalGet(typedCtxLocalIdx);
          this.ctx.emitter.emitStructGet(contextStruct.index, fieldIdx);
          this.ctx.emitter.emitLocalSet(localIdx);
          fieldIdx += 1;
        }
      }
    }
    
    if (bodyNode is MethodDefinition) {
      let mDef = bodyNode as MethodDefinition;
      let methName = match(mDef.name) {
        case Identifier {name}: name
        case _: "<unknown>"
      };
      if (methName == "<constructor>") {
        let structType = this.ctx.wasmFunction.structType;
        if (structType != null) {
          let classDecl = this.ctx.wasmFunction.classDecl;
          if (classDecl != null) {
            let cd = classDecl as ClassDeclaration;
            let mixinFields = new Array<FieldDefinition>();
            let seenMixins = new HashMap<MixinKey, boolean>();
            collectMixinFields(this.ctx.wasm.program as Program, this.ctx.wasmFunction.model, cd.mixins, mixinFields, seenMixins);

            let allFields = new Array<FieldDefinition>();
            for (let member in cd.body) {
              if (member is FieldDefinition) {
                allFields.push(member as FieldDefinition);
              }
            }
            for (let fd in mixinFields) {
              allFields.push(fd);
            }

            for (let fd in allFields) {
              if (fd.value != null && !fd.isStatic) {
                let fieldName = match (fd.name) {
                  case Identifier {name}: name
                  case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                    case Identifier {name}: name
                    case MemberExpression {property}: property.name
                    case _: "<symbol>"
                  }
                  case _: ""
                };
                if (fieldName != "") {
                  var actualFieldName = fieldName;
                  if (this.ctx.wasmFunction.classType != null) {
                    let ct = this.ctx.wasmFunction.classType as ClassType;
                    if (ct.fieldSetterNames != null) {
                      let m = ct.fieldSetterNames as HashMap<String, String>;
                      if (m.has(fieldName)) {
                        actualFieldName = m[fieldName];
                      }
                    }
                  }
                  var fieldIndex = -1;
                  let lookupName = if (actualFieldName.length > 0 && actualFieldName.sliceBytes(0, 1) == "#") {
                    if (this.ctx.wasmFunction.classType != null) {
                      getClassPrivateFieldKey(getClassKey(this.ctx.wasmFunction.classType as ClassType), actualFieldName)
                    } else {
                      actualFieldName
                    }
                  } else {
                    actualFieldName
                  };
                  for (var i = 0; i < structType.fields.length; i += 1) {
                    if (structType.fields[i].name != null && (structType.fields[i].name as String) == lookupName) {
                      fieldIndex = i;
                    }
                  }
                  if (fieldIndex >= 0) {
                    this.ctx.emitter.emitLocalGet(0);
                    this.generateExpression(fd.value as Expression);
                    this.ctx.emitter.emitStructSet(structType.index, fieldIndex);
                  }
                }
              }
            }
          }
        }
        if (structType != null && mDef.initializerList != null) {
          let inits = mDef.initializerList as Array<Node>;
          for (let init in inits) {
            if (init is FieldInitializer) {
              let fi = init as FieldInitializer;
              if (fi.field is Identifier) {
                let fieldName = fi.field.name;
                var actualFieldName = fieldName;
                if (this.ctx.wasmFunction.classType != null) {
                  let ct = this.ctx.wasmFunction.classType as ClassType;
                  if (ct.fieldSetterNames != null) {
                    let m = ct.fieldSetterNames as HashMap<String, String>;
                    if (m.has(fieldName)) {
                      actualFieldName = m[fieldName];
                    }
                  }
                }
                var fieldIndex = -1;
                let lookupName = if (actualFieldName.length > 0 && actualFieldName.sliceBytes(0, 1) == "#") {
                  if (this.ctx.wasmFunction.classType != null) {
                    getClassPrivateFieldKey(getClassKey(this.ctx.wasmFunction.classType as ClassType), actualFieldName)
                  } else {
                    actualFieldName
                  }
                } else {
                  actualFieldName
                };
                for (var i = 0; i < structType.fields.length; i += 1) {
                  if (structType.fields[i].name != null && (structType.fields[i].name as String) == lookupName) {
                    fieldIndex = i;
                  }
                }
                if (fieldIndex >= 0) {
                  this.ctx.emitter.emitLocalGet(0);
                  this.generateExpression(fi.value);
                  this.ctx.emitter.emitStructSet(structType.index, fieldIndex);
                }
              }
            }
          }
        }

        if (mDef.superInitializer != null) {
          let si = mDef.superInitializer as SuperInitializer;
          let cType = this.ctx.wasmFunction.classType;
          
          if (cType != null && cType.superType != null) {
            let st = cType.superType as ClassType;
            let ctorKey = getClassMethodKey(getClassKey(st), "<constructor>");
            var ctorFunc: WasmFunction | null = if (this.ctx.wasm.classMethodMap.has(ctorKey)) {
              this.ctx.wasm.classMethodMap[ctorKey]
            } else {
              null
            };

            if (ctorFunc != null) {
              this.ctx.emitter.emitLocalGet(0);
              var isSynthetic = false;
              for (let dec in mDef.decorators) {
                if (dec.name == "synthetic_constructor") {
                  isSynthetic = true;
                }
              }
              var argStart = 0;
              while (argStart < si.args.length) {
                  if (isSynthetic) {
                      this.ctx.emitter.emitLocalGet(argStart + 1);
                  } else {
                      this.generateExpression(si.args[argStart]);
                  }
                  argStart += 1;
              }
              this.ctx.emitter.emitCall(ctorFunc);
            } else {
                throw new Error("Super constructor not emitted!");
            }
          }
        }
      }
    }

    if (body != null) {
      match (body as Node) {
        case BlockStatement as blk: {
          this.generateStatement(blk as Statement);
          if (this.ctx.wasmFunction.signature.returns.length > 0) {
            if (this.ctx.isReachable) {
              throw new Error("Function '" + name + "' misses a return statement");
            } else if (this.ctx.needsUnreachable) {
              this.ctx.emitter.emitUnreachable();
            }
          }
        }
        case Expression as expr: {
          generateValueReturn(this.ctx, expr, (e: Expression, d: boolean = false) => this.generateExpression(e, d));
          this.ctx.emitter.emitReturn();
          this.ctx.isReachable = false;
        }
        case _: {}
      }
    } else {
      let mName = this.ctx.wasmFunction.methodName;
      if (mName == null || (mName as String) != "<constructor>") {
        this.ctx.emitter.emitUnreachable();
        this.ctx.isReachable = false;
      }
    }
    
    this.ctx.emitter.emitFunctionEnd();
    this.ctx.emitter.emitFunctionCodeEnd(this.ctx.wasmFunction);
  }

  generateStatement(stmt: Statement): void {
    if (!this.ctx.isReachable) {
      return;
    }
    match (stmt) {
      case BreakStatement: generateBreakStatement(this.ctx, stmt as BreakStatement)
      case ContinueStatement: generateContinueStatement(this.ctx, stmt as ContinueStatement)
      case ReturnStatement: generateReturnStatement(this.ctx, stmt as ReturnStatement, (e: Expression) => this.generateExpression(e))
      case ExpressionStatement: generateExpressionStatement(this.ctx, stmt as ExpressionStatement, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue))
      case BlockStatement: generateBlockStatement(this.ctx, stmt as BlockStatement, (s: Statement) => this.generateStatement(s))
      case IfStatement: generateIfStatement(this.ctx, stmt as IfStatement, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue), (s: Statement) => this.generateStatement(s))
      case WhileStatement: generateWhileStatement(this.ctx, stmt as WhileStatement, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue), (s: Statement) => this.generateStatement(s))
      case ForStatement: generateForStatement(this.ctx, stmt as ForStatement, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue), (s: Statement) => this.generateStatement(s))
      case ForInStatement: generateForInStatement(this.ctx, stmt as ForInStatement, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue), (s: Statement) => this.generateStatement(s), generatePatternBinding)
      case VariableDeclaration: generateVariableDeclaration(this.ctx, stmt as VariableDeclaration, (e: Expression) => this.generateExpression(e))
      case _: {
        var typeStr = "Other Node";
        if (stmt is ForInStatement) {
          typeStr = "ForInStatement";
        } else if (stmt is ClassDeclaration) {
          typeStr = "ClassDeclaration";
        } else if (stmt is InterfaceDeclaration) {
          typeStr = "InterfaceDeclaration";
        } else if (stmt is EnumDeclaration) {
          typeStr = "EnumDeclaration";
        } else if (stmt is MixinDeclaration) {
          typeStr = "MixinDeclaration";
        } else if (stmt is TypeAliasDeclaration) {
          typeStr = "TypeAliasDeclaration";
        } else if (stmt is ImportDeclaration) {
          typeStr = "ImportDeclaration";
        } else if (stmt is ExportAllDeclaration) {
          typeStr = "ExportAllDeclaration";
        } else if (stmt is ExportFromDeclaration) {
          typeStr = "ExportFromDeclaration";
        } else if (stmt is DeclareFunction) {
          typeStr = "DeclareFunction";
        }
        if (stmt.loc != null) {
          let loc = stmt.loc as SourceLocation;
          console.log("Unsupported statement type in codegen: " + typeStr + " at line=" + i32ToString(loc.line) + " col=" + i32ToString(loc.column));
        } else {
          console.log("Unsupported statement type in codegen: " + typeStr + " with null loc");
        }
        throw new Error("Unsupported statement type in codegen");
      }
    }
  }

  generateExpression(expr: Expression, discardValue: boolean = false): void {
    var handlesDiscardNatively: boolean = false;
    match (expr) {
      case Identifier: generateIdentifier(this.ctx, expr as Identifier)
      case MemberExpression: generateMemberExpression(this.ctx, expr as MemberExpression, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue))
      case IndexExpression: generateIndexExpression(this.ctx, expr as IndexExpression, (e: Expression, discardValue: boolean = false) => this.generateExpression(e, discardValue))
      case CallExpression: generateCallExpression(this.ctx, expr as CallExpression, (e: Expression) => this.generateExpression(e))
      case NumberLiteral: generateNumberLiteral(this.ctx, expr as NumberLiteral)
      case BooleanLiteral: generateBooleanLiteral(this.ctx, expr as BooleanLiteral)
      case StringLiteral: generateStringLiteral(this.ctx, expr as StringLiteral)
      case TemplateLiteral: generateTemplateLiteral(this.ctx, expr as TemplateLiteral, (e: Expression, d: boolean = false) => this.generateExpression(e, d))
      case TaggedTemplateExpression: generateTaggedTemplateExpression(this.ctx, expr as TaggedTemplateExpression, (e: Expression, d: boolean = false) => this.generateExpression(e, d))
      case NullLiteral: {
        this.ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.none));
      }
      case RecordLiteral: generateRecordLiteral(this.ctx, expr as RecordLiteral, (e: Expression, d: boolean = false) => this.generateExpression(e, d))
      case TupleLiteral: generateTupleLiteral(this.ctx, expr as TupleLiteral, (e: Expression, d: boolean = false) => this.generateExpression(e, d))
      case ArrayLiteral: generateArrayLiteral(this.ctx, expr as ArrayLiteral, (e: Expression, d: boolean = false) => this.generateExpression(e, d))
      case UnaryExpression: generateUnaryExpression(this.ctx, expr as UnaryExpression, (e: Expression) => this.generateExpression(e))
      case ThisExpression: {
        if (this.ctx.thisLocalIndex >= 0) {
          this.ctx.emitter.emitLocalGet(this.ctx.thisLocalIndex);
        } else {
          this.ctx.emitter.emitLocalGet(0);
        }
      }
      case FunctionExpression: {
        this.generateFunctionExpression(expr as FunctionExpression);
      }
      case BinaryExpression: generateBinaryExpression(this.ctx, expr as BinaryExpression, (e: Expression) => this.generateExpression(e))
      case AssignmentExpression: {
        generateAssignmentExpression(
          this.ctx,
          expr as AssignmentExpression,
          discardValue,
          (e) => this.generateExpression(e));
        handlesDiscardNatively = true;
      }
      case NewExpression: {
        generateNewExpression(this.ctx, expr as NewExpression, (e: Expression) => this.generateExpression(e));
      }
      case RangeExpression: {
        generateRangeExpression(this.ctx, expr as RangeExpression, (e: Expression, d: boolean = false) => this.generateExpression(e, d));
      }
      case IfExpression: {
        generateIfExpression(this.ctx, expr as IfExpression, discardValue, (e: Expression, d: boolean = false) => this.generateExpression(e, d), (s: Statement) => this.generateStatement(s));
        handlesDiscardNatively = true;
      }
      case MatchExpression: {
        generateMatchExpression(
          this.ctx,
          expr as MatchExpression,
          discardValue,
          (e, d) => this.generateExpression(e, d),
          (s) => this.generateStatement(s)
        );
        handlesDiscardNatively = true;
      }
      case SuperExpression: {
        // Evaluate to `this` instance
        this.ctx.emitter.emitLocalGet(0);
      }
      case ThrowExpression: {
        generateThrowExpression(this.ctx, expr as ThrowExpression, (e: Expression) => this.generateExpression(e));
      }
      case TryExpression: {
        generateTryExpression(
          this.ctx,
          expr as TryExpression,
          discardValue,
          (e: Expression, d: boolean = false) => this.generateExpression(e, d),
          (s: Statement) => this.generateStatement(s)
        );
        handlesDiscardNatively = true;
      }
      case PipelineExpression: {
        generatePipelineExpression(this.ctx, expr as PipelineExpression, (e: Expression, d: boolean = false) => this.generateExpression(e, d));
      }
      case PipePlaceholder: {
        generatePipePlaceholder(this.ctx, expr as PipePlaceholder);
      }
      case IsExpression: {
        let isExpr = expr as IsExpression;
        let sourceType = this.ctx.wasmFunction.model.getNodeType(isExpr.expression);
        if (sourceType == null) {
          throw new Error("IsExpression source type not found in semantic model!");
        }
        
        let targetType = this.ctx.wasmFunction.model.getNodeType(isExpr.typeAnnotation);
        if (targetType == null) {
          throw new Error("IsExpression target type not found in semantic model!");
        }
        
        if (!isRefType(sourceType as Type)) {
          this.generateExpression(isExpr.expression);
          this.ctx.emitter.emitDrop();
          
          let sType = sourceType as Type;
          let tType = targetType as Type;
          if (typeToString(sType) == typeToString(tType) || tType is AnyType || tType is AnyRefType || tType is EqRefType) {
            this.ctx.emitter.emitI32Const(1);
          } else {
            this.ctx.emitter.emitI32Const(0);
          }
          return;
        }

        this.generateExpression(isExpr.expression);
        let targetWasmType = typeToValTypeWithSub(this.ctx.wasm, targetType as Type, this.ctx.wasmFunction);
        match (targetWasmType) {
          case ValTypeRefNull as targetRefNull: {
            let targetIdx = targetRefNull.target.index;
            this.ctx.emitter.emitRefTest(targetIdx);
          }
          case ValTypeRef as targetRef: {
            let targetIdx = targetRef.target.index;
            this.ctx.emitter.emitRefTest(targetIdx);
          }
          case _: {
            throw new Error("Unsupported type for is-check: " + typeToString(targetType as Type));
          }
        }
      }
      case AsExpression: {
        let asExpr = expr as AsExpression;
        let targetType = this.ctx.wasmFunction.model.getNodeType(asExpr);
        let targetWasmType = typeToValTypeWithSub(this.ctx.wasm, targetType, this.ctx.wasmFunction);

        var handledLiteral = false;

        if (targetWasmType is ValTypeI64) {
          if (asExpr.expression is NumberLiteral) {
            let lit = asExpr.expression as NumberLiteral;
            if (let (true, val) = parseI64(lit.raw)) {
              this.ctx.emitter.emitI64Const(val);
              handledLiteral = true;
            }
          } else if (asExpr.expression is UnaryExpression) {
            let unary = asExpr.expression as UnaryExpression;
            if (unary.operator == "-" && unary.argument is NumberLiteral) {
              let lit = unary.argument as NumberLiteral;
              if (let (true, val) = parseI64("-" + lit.raw)) {
                this.ctx.emitter.emitI64Const(val);
                handledLiteral = true;
              }
            }
          }
        } else if (targetWasmType is ValTypeF64) {
          if (asExpr.expression is NumberLiteral) {
            let lit = asExpr.expression as NumberLiteral;
            let val = parseF64(lit.raw);
            this.ctx.emitter.emitF64Const(val);
            handledLiteral = true;
          } else if (asExpr.expression is UnaryExpression) {
            let unary = asExpr.expression as UnaryExpression;
            if (unary.operator == "-" && unary.argument is NumberLiteral) {
              let lit = unary.argument as NumberLiteral;
              let val = parseF64("-" + lit.raw);
              this.ctx.emitter.emitF64Const(val);
              handledLiteral = true;
            }
          }
        }

        if (!handledLiteral) {
          this.generateExpression(asExpr.expression);
          
           let rawSourceType = this.ctx.wasmFunction.model.getNodeType(asExpr.expression);
          var sourceType = rawSourceType;
          if (asExpr.expression is Identifier) {
            let sym = this.ctx.wasmFunction.model.resolve(asExpr.expression as Identifier);
            if (sym != null) {
              let bType = this.ctx.wasmFunction.model.getBindingType(sym);
              if (bType != null) {
                sourceType = bType;
              }
            }
          } else if (asExpr.expression is MemberExpression) {
            let mem = asExpr.expression as MemberExpression;
            if (!mem.optional) {
              let objType = this.ctx.wasmFunction.model.getNodeType(mem.object);
              if (objType != null) {
              let nonNullObjType = getNonNullableType(objType as Type);
              let propName = getMemberPropertyName(mem.isSymbolAccess, mem.property.name);
              match (nonNullObjType) {
                case ClassType as ct: {
                  let fType = getClassFieldType(this.ctx.wasm, ct, propName);
                  if (fType != null) {
                    sourceType = fType as Type;
                  }
                }
                case RecordType as rt: {
                  if (rt.properties.has(propName)) {
                    sourceType = rt.properties[propName];
                  }
                }
                case InterfaceType as it: {
                  let fType = getInterfaceFieldType(this.ctx.wasm, it, propName);
                  if (fType != null) {
                    sourceType = fType as Type;
                  }
                }
                case _: {}
              }
            }
          }
        }
          
          let sourceWasmType = typeToValTypeWithSub(this.ctx.wasm, sourceType, this.ctx.wasmFunction);
          
          if (valTypeEquals(sourceWasmType, targetWasmType)) {
            // No-op identity cast
          } else {
            match (targetWasmType) {
            case ValTypeRefNull as targetRefNull: {
              let targetIdx = targetRefNull.target.index;
              match (sourceWasmType) {
                case ValTypeRefNull as sourceRefNull: {
                  if (sourceRefNull.target.index != targetIdx) {
                    this.ctx.emitter.emitRefCastNull(targetIdx);
                  }
                }
                case ValTypeRef as sourceRef: {
                  if (sourceRef.target.index != targetIdx) {
                    this.ctx.emitter.emitRefCastNull(targetIdx);
                  }
                }
                case ValTypeAnyRef: {
                  this.ctx.emitter.emitRefCastNull(targetIdx);
                }
                case ValTypeEqRef: {
                  this.ctx.emitter.emitRefCastNull(targetIdx);
                }
                case ValTypeStructRef: {
                  this.ctx.emitter.emitRefCastNull(targetIdx);
                }
                case _: {
                  throw new Error("Unsupported ref_null cast in self-hosted compiler: " + typeToString(sourceType) + " to " + typeToString(targetType));
                }
              }
            }
            case ValTypeRef as targetRef: {
              let targetIdx = targetRef.target.index;
              match (sourceWasmType) {
                case ValTypeRef as sourceRef: {
                  if (sourceRef.target.index != targetIdx) {
                    this.ctx.emitter.emitRefCast(targetIdx);
                  }
                }
                case ValTypeRefNull as sourceRefNull: {
                  this.ctx.emitter.emitRefCast(targetIdx);
                }
                case ValTypeAnyRef: {
                  this.ctx.emitter.emitRefCast(targetIdx);
                }
                case ValTypeEqRef: {
                  this.ctx.emitter.emitRefCast(targetIdx);
                }
                case ValTypeStructRef: {
                  this.ctx.emitter.emitRefCast(targetIdx);
                }
                case _: {
                  throw new Error("Unsupported ref cast in self-hosted compiler: " + typeToString(sourceType) + " to " + typeToString(targetType));
                }
              }
            }
            case ValTypeI64: {
              match (sourceWasmType) {
                case ValTypeI32: {
                  this.ctx.emitter.emitI64ExtendI32S();
                }
                case ValTypeF32: {
                  this.ctx.emitter.emitI64TruncSatF32S();
                }
                case ValTypeF64: {
                  this.ctx.emitter.emitI64TruncSatF64S();
                }
                case _: {
                  throw new Error("Unsupported primitive conversion to i64 from: " + typeToString(sourceType));
                }
              }
            }
            case ValTypeI32: {
              match (sourceWasmType) {
                case ValTypeI64: {
                  this.ctx.emitter.emitI32WrapI64();
                }
                case ValTypeF32: {
                  this.ctx.emitter.emitI32TruncSatF32S();
                }
                case ValTypeF64: {
                  this.ctx.emitter.emitI32TruncSatF64S();
                }
                case _: {
                  throw new Error("Unsupported primitive conversion to i32 from: " + typeToString(sourceType));
                }
              }
            }
            case ValTypeF64: {
              match (sourceWasmType) {
                case ValTypeI32: {
                  this.ctx.emitter.emitF64ConvertI32S();
                }
                case ValTypeI64: {
                  this.ctx.emitter.emitF64ConvertI64S();
                }
                case ValTypeF32: {
                  this.ctx.emitter.emitF64PromoteF32();
                }
                case _: {
                  throw new Error("Unsupported primitive conversion to f64 from: " + typeToString(sourceType));
                }
              }
            }
            case ValTypeF32: {
              match (sourceWasmType) {
                case ValTypeI32: {
                  this.ctx.emitter.emitF32ConvertI32S();
                }
                case ValTypeI64: {
                  this.ctx.emitter.emitF32ConvertI64S();
                }
                case ValTypeF64: {
                  this.ctx.emitter.emitF32DemoteF64();
                }
                case _: {
                  throw new Error("Unsupported primitive conversion to f32 from: " + typeToString(sourceType));
                }
              }
            }
            case ValTypeAnyRef: {}
            case ValTypeEqRef: {}
            case ValTypeStructRef: {}
            case _: {
              throw new Error("Unsupported cast in self-hosted compiler: " + typeToString(sourceType) + " to " + typeToString(targetType));
            }
          }
        }
      }
    }
    case _: {
      let t = this.ctx.wasmFunction.model.getNodeType(expr);
      let tStr = if (t != null) { typeToString(t as Type) } else { "null" };
      throw new Error("Unsupported expression type in codegen. Node type in model: " + tStr);
    }
  }
    
    // EXCEPTION: Implicit Structural Adaptation
    // If the semantic model determined that this expression produces a record that is
    // being assigned to a narrower record type, we must perform an implicit adaptation.
    // This pops the original fat pointer from the stack, extracts the underlying instance,
    // and pushes a newly allocated fat pointer with a vtable tailored to the expected target.
    // In the future, this same injection point will likely be used to adapt functions 
    // and classes being assigned to interface contexts.
    let adaptation = this.ctx.wasmFunction.model.getRecordAdaptation(expr);
    if (adaptation != null && !discardValue) {
      let inFields = new Array<WasmField>();
      for (let pair in adaptation.source.properties) {
        inFields.push(new WasmField(pair.key, typeToValType(this.ctx.wasm, pair.value), false));
      }
      
      let inDispatchInfo = this.ctx.wasm.getRecordDispatch(this.ctx.wasmFunction.model, inFields);

      let scratchLocal = this.ctx.getStructScratchLocal(inDispatchInfo.fatPtrType);
      
      // Ensure the top-of-stack is cast exactly to the fatPtrType before storing
      // in the strongly-typed local. This avoids validation errors.
      this.ctx.emitter.emitRefCast(inDispatchInfo.fatPtrType.index);
      this.ctx.emitter.emitLocalSet(scratchLocal);

      let outFields = new Array<WasmField>();
      for (let pair in adaptation.target.properties) {
        outFields.push(new WasmField(pair.key, typeToValType(this.ctx.wasm, pair.value), false));
      }
      
      let outDispatchInfo = this.ctx.wasm.getAdaptedRecordDispatch(this.ctx.wasmFunction.model, inFields, outFields);

      this.ctx.emitter.emitLocalGet(scratchLocal);
      this.ctx.emitter.emitStructGet(inDispatchInfo.fatPtrType.index, 0); // Get Instance
      
      if (outDispatchInfo.vtableGlobal.index < 0) {
        throw new Error("vtableGlobal.index < 0 in generate! Key: " + outDispatchInfo.vtableGlobal.name);
      }
      this.ctx.emitter.emitGlobalGet(outDispatchInfo.vtableGlobal.index);
      
      this.ctx.emitter.emitStructNew(outDispatchInfo.fatPtrType.index);
    }

    let interfaceAdaptation = this.ctx.wasmFunction.model.getInterfaceAdaptation(expr);
    if (interfaceAdaptation != null && !discardValue) {
      let ia = interfaceAdaptation as InterfaceAdaptation;
      var srcType = ia.source;
      var tgtType = ia.target;
      if (this.ctx.wasmFunction.classType != null) {
        let ct = this.ctx.wasmFunction.classType as ClassType;
        srcType = substituteTypeParamsInCodegen(getClassTypeParameters(ct), ct.typeArguments, srcType) as ClassType;
        tgtType = substituteTypeParamsInCodegen(getClassTypeParameters(ct), ct.typeArguments, tgtType) as InterfaceType;
      }
      let cName = getClassKey(srcType);
      let iName = getInterfaceKey(tgtType);
      
      let key = getClassInterfaceKey(cName, iName);
      if (!this.ctx.wasm.classInterfaceVTables.has(key)) {
        throw new Error("Interface vtable global not found for " + classInterfaceKeyToString(key));
      }
      let vtableGlobal = this.ctx.wasm.classInterfaceVTables[key];
      
      this.ctx.emitter.emitGlobalGet(vtableGlobal.index);
      
      let fatPtrStruct = this.ctx.wasm.interfaceStructs[iName];
      this.ctx.emitter.emitStructNew(fatPtrStruct.index);
    }

    let funcAdaptation = this.ctx.wasmFunction.model.getFunctionAdaptation(expr);
    if (funcAdaptation != null && !discardValue) {
      if (this.ctx.wasm.functionAdaptationWrappers.has(expr)) {
        let wrapperFunc = this.ctx.wasm.functionAdaptationWrappers[expr];
        let src = funcAdaptation.source;
        let tgt = funcAdaptation.target;
        
        let actualClosureStruct = getClosureStruct(this.ctx.wasm, src);
        let expectedClosureStruct = getClosureStruct(this.ctx.wasm, tgt);
        
        let actualLocal = this.ctx.getStructScratchLocal(actualClosureStruct);
        this.ctx.emitter.emitRefCast(actualClosureStruct.index);
        this.ctx.emitter.emitLocalSet(actualLocal);
        
        this.ctx.emitter.emitRefFunc(wrapperFunc.index);
        this.ctx.emitter.emitLocalGet(actualLocal);
        
        this.ctx.emitter.emitStructNew(expectedClosureStruct.index);
      } else {
        throw new Error("Function adaptation wrapper not registered during discovery pass for expr: " + i32ToString(expr.id as i32));
      }
    }

    if (discardValue && !handlesDiscardNatively) {
      let exprType = this.ctx.wasmFunction.model.getNodeType(expr);
      if (exprType != null && !isVoidOrNeverType(exprType as Type)) {
        this.ctx.emitter.emitDrop();
      }
    }
  }

  generateFunctionAdaptationBody(): void {
    let actualFt = this.ctx.wasmFunction.functionAdaptationSource as FunctionType;
    let expectedFt = this.ctx.wasmFunction.functionAdaptationTarget as FunctionType;
    
    let actualClosureStruct = getClosureStruct(this.ctx.wasm, actualFt);
    
    // 1. Load context (param 0)
    this.ctx.emitter.emitLocalGet(0);
    // 2. Cast to the actual closure struct type
    this.ctx.emitter.emitRefCast(actualClosureStruct.index);
    // 3. Extract the actual closure's context (field 1)
    this.ctx.emitter.emitStructGet(actualClosureStruct.index, 1);
    
    // 4. Load parameters that the actual function expects
    var i = 0;
    let actualArity = actualFt.parameters.length;
    while (i < actualArity) {
      this.ctx.emitter.emitLocalGet(i + 1);
      
      let expectedParamWasmType = typeToValType(this.ctx.wasm, expectedFt.parameters[i]);
      let actualParamWasmType = typeToValType(this.ctx.wasm, actualFt.parameters[i]);
      
      if (!valTypeEquals(expectedParamWasmType, actualParamWasmType)) {
        match (actualParamWasmType) {
          case ValTypeRefNull as targetRefNull: {
            this.ctx.emitter.emitRefCast(targetRefNull.target.index);
          }
          case ValTypeRef as targetRef: {
            this.ctx.emitter.emitRefCast(targetRef.target.index);
          }
          case _: {}
        }
      }
      i += 1;
    }
    
    // 5. Load actual closure function reference (field 0)
    this.ctx.emitter.emitLocalGet(0);
    this.ctx.emitter.emitRefCast(actualClosureStruct.index);
    this.ctx.emitter.emitStructGet(actualClosureStruct.index, 0);
    
    // 6. Call ref
    let actualFuncFieldType = actualClosureStruct.fields[0].type as ValTypeRef;
    let actualImplSig = actualFuncFieldType.target as WasmSignature;
    this.ctx.emitter.emitCallRef(actualImplSig.index);
    this.ctx.emitter.emitReturn();
  }

  generateImportWrapperBody(): void {
    let target = this.ctx.wasmFunction.importWrapperTarget as WasmFunction;
    var i = 0;
    while (i < this.ctx.wasmFunction.signature.params.length) {
      this.ctx.emitter.emitLocalGet(i);
      i += 1;
    }
    this.ctx.emitter.emitCall(target);
    this.ctx.emitter.emitAnyConvertExtern();
    
    let wrapperResultType = this.ctx.wasmFunction.signature.returns[0];
    match (wrapperResultType) {
      case ValTypeRefNull as r: {
        this.ctx.emitter.emitRefCastNull(r.target.index);
      }
      case ValTypeRef as r: {
        this.ctx.emitter.emitRefCast(r.target.index);
      }
      case ValTypeEqRef: {
        this.ctx.emitter.emitRefCastEqNull();
      }
      case _: {}
    }
  }

  generateClosureTrampolineBody(): void {
    let target = this.ctx.wasmFunction.closureTrampolineTarget as WasmFunction;
    var i = 1;
    while (i < this.ctx.wasmFunction.signature.params.length) {
      this.ctx.emitter.emitLocalGet(i);
      i += 1;
    }
    this.ctx.emitter.emitCall(target);
  }

  generateClosureWrapperBody(): void {
    let target = this.ctx.wasmFunction.closureWrapperTarget as WasmFunction;
    var i = 1;
    while (i < this.ctx.wasmFunction.signature.params.length) {
      this.ctx.emitter.emitLocalGet(i);
      i += 1;
    }
    this.ctx.emitter.emitCall(target);
    this.ctx.emitter.emitReturn();
  }

  generateStringFromSharedBody(): void {
    let wasm = this.ctx.wasm;
    let stringClass = wasm.stringClass;
    if (stringClass == null) {
      throw new Error("String class not found during string_from_shared body generation!");
    }
    let stringKey = getClassKey(stringClass as ClassType);
    var structType: WasmStruct | null = null;
    var vtableGlobal: WasmGlobal | null = null;
    if (let (true, info) = wasm.classInfos.get(stringKey)) {
      structType = info.structType;
      vtableGlobal = info.vtableGlobal;
    }
    if (structType == null || vtableGlobal == null) {
      throw new Error("String class struct or vtable not found during string_from_shared body generation!");
    }
    let structTypeVal = structType as WasmStruct;
    let vtableGlobalVal = vtableGlobal as WasmGlobal;

    // Find string field offsets
    var dataFieldIdx = -1;
    var startFieldIdx = -1;
    var endFieldIdx = -1;
    var encodingFieldIdx = -1;
    for (var f = 0; f < structTypeVal.fields.length; f += 1) {
      let fieldName = structTypeVal.fields[f].name;
      if (fieldName != null) {
        let nameStr = fieldName as String;
        if (nameStr.endsWith("::#data")) {
          dataFieldIdx = f;
        } else if (nameStr.endsWith("::#start")) {
          startFieldIdx = f;
        } else if (nameStr.endsWith("::#end")) {
          endFieldIdx = f;
        } else if (nameStr.endsWith("::#encoding")) {
          encodingFieldIdx = f;
        }
      }
    }
    if (dataFieldIdx == -1 || startFieldIdx == -1 || endFieldIdx == -1 || encodingFieldIdx == -1) {
      throw new Error("String fields not found in struct during string_from_shared body generation!");
    }

    for (var i = 0; i < structTypeVal.fields.length; i += 1) {
      let field = structTypeVal.fields[i];
      let fieldName = field.name;
      if (fieldName != null) {
        let nameStr = fieldName as String;
        if (nameStr == "<vtable>" || nameStr == "__vtable") {
          let vtableGlobal = vtableGlobalVal;
          this.ctx.emitter.emitGlobalGet(vtableGlobal.index);
        } else if (nameStr.startsWith("__brand_")) {
          this.ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.none));
        } else if (i == dataFieldIdx) {
          this.ctx.emitter.emitGlobalGet((wasm.sharedStringsGlobal as WasmGlobal).index);
        } else if (i == startFieldIdx) {
          this.ctx.emitter.emitLocalGet(0);
        } else if (i == endFieldIdx) {
          this.ctx.emitter.emitLocalGet(0);
          this.ctx.emitter.emitLocalGet(1);
          this.ctx.emitter.emitI32Add();
        } else if (i == encodingFieldIdx) {
          this.ctx.emitter.emitI32Const(0);
        } else if (nameStr.endsWith("::#hashCode")) {
          this.ctx.emitter.emitI32Const(0);
        } else {
          match (field.type) {
            case ValTypeI32: this.ctx.emitter.emitI32Const(0)
            case ValTypeI64: this.ctx.emitter.emitI64Const(0 as i64)
            case ValTypeF32: this.ctx.emitter.emitF32Const(0.0)
            case ValTypeF64: this.ctx.emitter.emitF64Const(0.0)
            case _: this.ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.none))
          }
        }
      }
    }

    this.ctx.emitter.emitStructNew(structType.index);
  }

  generateGetStringLiteralBody(): void {
    let wasm = this.ctx.wasm;
    let arrayType = wasm.stringArrayType as WasmArray;
    let arrayGlobal = wasm.stringLiteralsArrayGlobal as WasmGlobal;
    let stringClass = wasm.stringClass;
    if (stringClass == null) {
      throw new Error("String class not found during get_string_literal body generation!");
    }
    let stringKey = getClassKey(stringClass as ClassType);
    var stringStructOpt: WasmStruct | null = null;
    if (let (true, stringInfo) = wasm.classInfos.get(stringKey)) {
      stringStructOpt = stringInfo.structType;
    }
    if (stringStructOpt == null) {
      throw new Error("String class struct not found during get_string_literal body generation!");
    }
    let stringStruct = stringStructOpt as WasmStruct;

    // Check if the array already contains the string
    this.ctx.emitter.emitGlobalGet(arrayGlobal.index);
    this.ctx.emitter.emitLocalGet(0); // id
    this.ctx.emitter.emitArrayGet(arrayType.index);
    this.ctx.emitter.emitLocalTee(1); // store in local 1
    this.ctx.emitter.emitRefIsNull();
    this.ctx.emitter.emitIf(new ValTypeVoid());

    let N = wasm.stringLiteralIds.size;
    if (N == 0) {
      this.ctx.emitter.emitUnreachable();
    } else if (N == 1) {
      let keys = wasm.stringLiteralIds.keys();
      if (let (true, firstLiteral) = keys.next()) {
        let loc = wasm.stringLiteralLocations[firstLiteral];
        this.ctx.emitter.emitI32Const(loc.offset);
        this.ctx.emitter.emitI32Const(loc.length);
        this.ctx.emitter.emitCall(wasm.stringFromSharedFunc as WasmFunction);
        this.ctx.emitter.emitLocalSet(1);
      }
    } else {
      let idEntries = new Array<String>();
      let keys = wasm.stringLiteralIds.keys();
      while (let (true, val) = keys.next()) {
        idEntries.push(val);
      }
      
      // Sort keys by their assigned ID to ensure we emit branches in ID order 0, 1, 2, ...
      for (var i = 0; i < N; i += 1) {
        var minIdx = i;
        for (var j = i + 1; j < N; j += 1) {
          let idVal = wasm.stringLiteralIds[idEntries[j]];
          let minVal = wasm.stringLiteralIds[idEntries[minIdx]];
          if (idVal < minVal) {
            minIdx = j;
          }
        }
        if (minIdx != i) {
          let temp = idEntries[i];
          idEntries[i] = idEntries[minIdx];
          idEntries[minIdx] = temp;
        }
      }

      for (var i = 0; i < N - 1; i += 1) {
        this.ctx.emitter.emitLocalGet(0); // id
        this.ctx.emitter.emitI32Const(i);
        this.ctx.emitter.emitI32Eq();
        this.ctx.emitter.emitIf(new ValTypeVoid());

        let loc = wasm.stringLiteralLocations[idEntries[i]];
        this.ctx.emitter.emitI32Const(loc.offset);
        this.ctx.emitter.emitI32Const(loc.length);
        this.ctx.emitter.emitCall(wasm.stringFromSharedFunc as WasmFunction);
        this.ctx.emitter.emitLocalSet(1);

        this.ctx.emitter.emitElse();
      }

      // Last branch
      let loc = wasm.stringLiteralLocations[idEntries[N - 1]];
      this.ctx.emitter.emitI32Const(loc.offset);
      this.ctx.emitter.emitI32Const(loc.length);
      this.ctx.emitter.emitCall(wasm.stringFromSharedFunc as WasmFunction);
      this.ctx.emitter.emitLocalSet(1);

      // End all the ifs
      for (var i = 0; i < N - 1; i += 1) {
        this.ctx.emitter.emitEnd();
      }
    }

    // Store the newly instantiated string in the array
    this.ctx.emitter.emitGlobalGet(arrayGlobal.index);
    this.ctx.emitter.emitLocalGet(0); // id
    this.ctx.emitter.emitLocalGet(1); // str
    this.ctx.emitter.emitArraySet(arrayType.index);

    this.ctx.emitter.emitEnd(); // close outer if

    // Return the non-null reference
    this.ctx.emitter.emitLocalGet(1);
    this.ctx.emitter.emitRefCast(stringStruct.index);
  }

  generateCaseClassEqBody(): void {
    let cType = this.ctx.wasmFunction.classType as ClassType;
    let structType = this.ctx.wasmFunction.structType as WasmStruct;

    if (structType.fields.length <= 1) {
      this.ctx.emitter.emitLocalGet(1);
      this.ctx.emitter.emitRefTest(structType.index);
    } else {
      this.ctx.emitter.emitLocalGet(1);
      this.ctx.emitter.emitRefTest(structType.index);
      this.ctx.emitter.emitI32Eqz();
      this.ctx.emitter.emitIf(new ValTypeI32());
      this.ctx.emitter.emitI32Const(0);
      this.ctx.emitter.emitElse();

      var firstField = true;
      for (var fi = 0; fi < structType.fields.length; fi += 1) {
        let f = structType.fields[fi];
        if (f.name == "<vtable>") { continue; }

        this.ctx.emitter.emitLocalGet(0);
        this.ctx.emitter.emitStructGet(structType.index, fi);

        this.ctx.emitter.emitLocalGet(1);
        this.ctx.emitter.emitRefCast(structType.index);
        this.ctx.emitter.emitStructGet(structType.index, fi);

        let ft = f.type;
        match (ft) {
          case ValTypeI32: this.ctx.emitter.emitI32Eq()
          case ValTypeF64: this.ctx.emitter.emitF64Eq()
          case ValTypeF32: this.ctx.emitter.emitF32Eq()
          case _: this.ctx.emitter.emitRefEq()
        }

        if (!firstField) {
          this.ctx.emitter.emitI32And();
        }
        firstField = false;
      }
      this.ctx.emitter.emitEnd();
    }

    this.ctx.emitter.emitReturn();
  }

  generateCaseClassHashBody(): void {
    let cType = this.ctx.wasmFunction.classType as ClassType;
    let structType = this.ctx.wasmFunction.structType as WasmStruct;

    if (structType.fields.length <= 1) {
      this.ctx.emitter.emitI32Const(0);
    } else {
      var firstField = true;
      for (var fi = 0; fi < structType.fields.length; fi += 1) {
        let f = structType.fields[fi];
        if (f.name == "<vtable>") { continue; }

        if (!firstField) {
          this.ctx.emitter.emitI32Const(31);
          this.ctx.emitter.emitI32Mul();
        }

        this.ctx.emitter.emitLocalGet(0);
        this.ctx.emitter.emitStructGet(structType.index, fi);

        let ft = f.type;
        match (ft) {
          case ValTypeI32: {}
          case _: {
             this.ctx.emitter.emitDrop();
             this.ctx.emitter.emitI32Const(0);
          }
        }

        if (!firstField) {
          this.ctx.emitter.emitI32Add();
        }
        firstField = false;
      }
    }

    this.ctx.emitter.emitReturn();
  }

  generateCaseClassConstructorBody(): void {
    let cType = this.ctx.wasmFunction.classType as ClassType;
    let structType = this.ctx.wasmFunction.structType as WasmStruct;

    if (cType.superType != null) {
      let st = cType.superType as ClassType;
      let ctorKey = getClassMethodKey(getClassKey(st), "<constructor>");
      var ctorFunc: WasmFunction | null = if (this.ctx.wasm.classMethodMap.has(ctorKey)) {
        this.ctx.wasm.classMethodMap[ctorKey]
      } else {
        null
      };
      if (ctorFunc != null) {
        this.ctx.emitter.emitLocalGet(0);
        this.ctx.emitter.emitCall(ctorFunc as WasmFunction);
      }
    }
    
    if (cType.constructorType != null) {
      let ctorType = cType.constructorType as FunctionType;
      // console.log("CASE CTOR: class=" + cType.name + " typeParams=" + (if (cType.typeParameters != null) "yes" else "no") + " hasParamNames=" + (if (ctorType.parameterNames != null) "yes" else "no"));
      if (ctorType.parameterNames != null) {
        let parameterNames = ctorType.parameterNames as Array<String>;
        // console.log("  PARAM NAMES length=" + i32ToString(parameterNames.length as i32));
        var pi = 0;
        while (pi < ctorType.parameters.length) {
          let pName = parameterNames[pi];
          let lookupName = if (pName.length > 0 && pName.sliceBytes(0, 1) == "#") {
            getClassPrivateFieldKey(getClassKey(cType), pName)
          } else {
            pName
          };
          var fieldIdx = -1;
          for (var fi = 0; fi < structType.fields.length; fi += 1) {
            if (structType.fields[fi].name == lookupName) {
              fieldIdx = fi;
            }
          }
          if (fieldIdx >= 0) {
            this.ctx.emitter.emitLocalGet(0);
            this.ctx.emitter.emitLocalGet(pi + 1);
            this.ctx.emitter.emitStructSet(structType.index, fieldIdx);
          }
          pi += 1;
        }
      }
    }
    
    let classDecl = this.ctx.wasmFunction.classDecl;
    if (classDecl != null) {
      let cd = classDecl as ClassDeclaration;
      let mixinFields = new Array<FieldDefinition>();
      let seenMixins = new HashMap<MixinKey, boolean>();
      collectMixinFields(this.ctx.wasm.program as Program, this.ctx.wasmFunction.model, cd.mixins, mixinFields, seenMixins);

      let allFields = new Array<FieldDefinition>();
      for (let member in cd.body) {
        if (member is FieldDefinition) {
          allFields.push(member as FieldDefinition);
        }
      }
      for (let fd in mixinFields) {
        allFields.push(fd);
      }

      for (let fd in allFields) {
        if (fd.value != null && !fd.isStatic) {
          let fieldName = match (fd.name) {
            case Identifier {name}: name
            case _: ""
          };
          if (fieldName != "") {
            var actualFieldName = fieldName;
            if (cType.fieldSetterNames != null) {
              let m = cType.fieldSetterNames as HashMap<String, String>;
              if (m.has(fieldName)) {
                actualFieldName = m[fieldName];
              }
            }
            var fieldIndex = -1;
            let lookupName = if (actualFieldName.length > 0 && actualFieldName.sliceBytes(0, 1) == "#") {
              getClassPrivateFieldKey(getClassKey(cType), actualFieldName)
            } else {
              actualFieldName
            };
            for (var i = 0; i < structType.fields.length; i += 1) {
              if (structType.fields[i].name == lookupName) {
                fieldIndex = i;
              }
            }
            if (fieldIndex >= 0) {
              this.ctx.emitter.emitLocalGet(0);
              this.generateExpression(fd.value as Expression);
              this.ctx.emitter.emitStructSet(structType.index, fieldIndex);
            }
          }
        }
      }
    }

    this.ctx.emitter.emitReturn();
  }

  generateFunctionExpression(fExpr: FunctionExpression): void {
    let classType = this.ctx.wasmFunction.classType;
    let classKey = if (classType != null) getClassKey(classType as ClassType) else "" as ClassKey;
    let closureKey = getClosureSpecializationKey(fExpr.id, classKey);
    if (this.ctx.wasm.specializedClosures.has(closureKey)) {
      let closureFunc = this.ctx.wasm.specializedClosures[closureKey];
      let funcTypeNode = getNodeType(this.ctx, fExpr) as Type;
      let closureStruct = getClosureStruct(this.ctx.wasm, funcTypeNode);

      // 1. Push function reference
      this.ctx.emitter.emitRefFunc(closureFunc.index);

      // 2. Push context pointer
      let contextStruct = closureFunc.contextStruct as WasmStruct;
      if (contextStruct.fields.length > 0) {
        var fieldIdx = 0;
        if (closureFunc.capturesThis) {
          if (this.ctx.thisLocalIndex >= 0) {
            this.ctx.emitter.emitLocalGet(this.ctx.thisLocalIndex);
          } else {
            this.ctx.emitter.emitLocalGet(0);
          }
          fieldIdx += 1;
        }
        for (let symId in closureFunc.captures) {
          if (!this.ctx.localIndices.has(symId)) {
            var keysStr = "";
            for (let pair in this.ctx.localIndices) {
              let name = if (this.ctx.wasm.symbolNames.has(pair.key)) this.ctx.wasm.symbolNames[pair.key] else "unknown";
              keysStr = keysStr + name + " (" + i32ToString(pair.key as i32) + "), ";
            }
            let missingName = if (this.ctx.wasm.symbolNames.has(symId)) this.ctx.wasm.symbolNames[symId] else "unknown";
            throw new Error("Key not found in localIndices for SymbolId: " + missingName + " (" + i32ToString(symId as i32) + ") (available: " + keysStr + ")");
          }
          let localIdx = this.ctx.localIndices[symId];
          this.ctx.emitter.emitLocalGet(localIdx);
          fieldIdx += 1;
        }
        this.ctx.emitter.emitStructNew(contextStruct.index);
      } else {
        this.ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.struct));
      }

      // 3. Create closure struct
      this.ctx.emitter.emitStructNew(closureStruct.index);
    } else {
      throw new Error("Closure function not registered for FunctionExpression: " + i32ToString(fExpr.id as i32) + " with class key: " + (classKey as String));
    }
  }
  
  generateWasiWriteStringHelper(): void {
    var stringStruct: WasmStruct | null = null;
    let stringClass = this.ctx.wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (let (true, stringInfo) = this.ctx.wasm.classInfos.get(key)) {
        stringStruct = stringInfo.structType;
      }
    }
    if (stringStruct == null) {
      throw new Error("wasi_write_string_helper generation: String class struct not found!");
    }
    let stringStructIndex = (stringStruct as WasmStruct).index;
    let byteArrayType = this.ctx.wasm.getByteArrayType();
    let byteArrayTypeIndex = byteArrayType.index;

    let locals = new Array<ValType>();
    locals.push(new ValTypeI32()); // 2: i
    locals.push(new ValTypeI32()); // 3: len
    locals.push(new ValTypeRefNull(byteArrayType)); // 4: data
    locals.push(new ValTypeI32()); // 5: start
    
    this.ctx.emitter.emitFunctionLocalsStart(locals);

    let fdParam = 0;
    let strParam = 1;
    let iLocal = 2;
    let lenLocal = 3;
    let dataLocal = 4;
    let startLocal = 5;

    // Check for null string - if null, just return
    this.ctx.emitter.emitLocalGet(strParam);
    this.ctx.emitter.emitRefIsNull();
    this.ctx.emitter.emitIf(new ValTypeVoid());
    this.ctx.emitter.emitReturn();
    this.ctx.emitter.emitEnd();

    var dataFieldIdx = -1;
    var startFieldIdx = -1;
    var endFieldIdx = -1;
    for (var f = 0; f < (stringStruct as WasmStruct).fields.length; f += 1) {
      let fieldName = (stringStruct as WasmStruct).fields[f].name;
      if (fieldName != null) {
        let nameStr = fieldName as String;
        if (nameStr.endsWith("::#data")) {
          dataFieldIdx = f;
        } else if (nameStr.endsWith("::#start")) {
          startFieldIdx = f;
        } else if (nameStr.endsWith("::#end")) {
          endFieldIdx = f;
        }
      }
    }

    if (dataFieldIdx == -1 || startFieldIdx == -1 || endFieldIdx == -1) {
      throw new Error("String layout fields not found in structure!");
    }

    // Get #data field
    this.ctx.emitter.emitLocalGet(strParam);
    this.ctx.emitter.emitRefCast(stringStructIndex);
    this.ctx.emitter.emitStructGet(stringStructIndex, dataFieldIdx);
    this.ctx.emitter.emitLocalSet(dataLocal);

    // Get string length: #end - #start
    this.ctx.emitter.emitLocalGet(strParam);
    this.ctx.emitter.emitRefCast(stringStructIndex);
    this.ctx.emitter.emitStructGet(stringStructIndex, endFieldIdx);
    this.ctx.emitter.emitLocalGet(strParam);
    this.ctx.emitter.emitRefCast(stringStructIndex);
    this.ctx.emitter.emitStructGet(stringStructIndex, startFieldIdx);
    this.ctx.emitter.emitI32Sub();
    this.ctx.emitter.emitLocalSet(lenLocal);

    // Get #start offset and store
    this.ctx.emitter.emitLocalGet(strParam);
    this.ctx.emitter.emitRefCast(stringStructIndex);
    this.ctx.emitter.emitStructGet(stringStructIndex, startFieldIdx);
    this.ctx.emitter.emitLocalSet(startLocal);

    // if (len == 0) return
    this.ctx.emitter.emitLocalGet(lenLocal);
    this.ctx.emitter.emitI32Eqz();
    this.ctx.emitter.emitIf(new ValTypeVoid());
    this.ctx.emitter.emitReturn();
    this.ctx.emitter.emitEnd();

    // i = 0
    this.ctx.emitter.emitI32Const(0);
    this.ctx.emitter.emitLocalSet(iLocal);

    // Loop: copy bytes to linear memory
    this.ctx.emitter.emitBlock(new ValTypeVoid()); // $break
    this.ctx.emitter.emitLoop(new ValTypeVoid()); // $continue

    // if (i >= len) br $break
    this.ctx.emitter.emitLocalGet(iLocal);
    this.ctx.emitter.emitLocalGet(lenLocal);
    this.ctx.emitter.emitI32GeS();
    this.ctx.emitter.emitBrIf(1); // br $break

    // memory.store8(WASI_STRING_BUF + i, array.get_u(data, start + i))
    this.ctx.emitter.emitI32Const(64); // WASI_STRING_BUF
    this.ctx.emitter.emitLocalGet(iLocal);
    this.ctx.emitter.emitI32Add();

    this.ctx.emitter.emitLocalGet(dataLocal);
    this.ctx.emitter.emitLocalGet(startLocal);
    this.ctx.emitter.emitLocalGet(iLocal);
    this.ctx.emitter.emitI32Add();
    this.ctx.emitter.emitArrayGetU(byteArrayTypeIndex);

    this.ctx.emitter.emitI32Store8(0, 0); // align=0, offset=0

    // i = i + 1
    this.ctx.emitter.emitLocalGet(iLocal);
    this.ctx.emitter.emitI32Const(1);
    this.ctx.emitter.emitI32Add();
    this.ctx.emitter.emitLocalSet(iLocal);

    // br $continue
    this.ctx.emitter.emitBr(0);

    this.ctx.emitter.emitEnd(); // end loop
    this.ctx.emitter.emitEnd(); // end block

    // Set up iovec: {buf: WASI_STRING_BUF, len: len}
    this.ctx.emitter.emitI32Const(0); // WASI_IOVEC_BUF
    this.ctx.emitter.emitI32Const(64); // WASI_STRING_BUF
    this.ctx.emitter.emitI32Store(2, 0); // align=2, offset=0

    this.ctx.emitter.emitI32Const(4); // WASI_IOVEC_LEN
    this.ctx.emitter.emitLocalGet(lenLocal);
    this.ctx.emitter.emitI32Store(2, 0); // align=2, offset=0

    // Call fd_write(fd, iovs=0, iovs_len=1, nwritten=WASI_NWRITTEN)
    this.ctx.emitter.emitLocalGet(fdParam);
    this.ctx.emitter.emitI32Const(0); // WASI_IOVEC_BUF
    this.ctx.emitter.emitI32Const(1); // iovs_len
    this.ctx.emitter.emitI32Const(8); // WASI_NWRITTEN
    
    var fdWriteImport: WasmFunction | null = null;
    for (let f in this.ctx.wasm.functionImports) {
      if (f.importName == "fd_write") {
        fdWriteImport = f;
      }
    }
    if (fdWriteImport == null) {
      throw new Error("fd_write import function not found!");
    }
    this.ctx.emitter.emitCall(fdWriteImport as WasmFunction);
    this.ctx.emitter.emitDrop(); // Ignore return value (errno)
  }

  generateStringHashHelper(): void {
    var stringStruct: WasmStruct | null = null;
    let stringClass = this.ctx.wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (let (true, stringInfo) = this.ctx.wasm.classInfos.get(key)) {
        stringStruct = stringInfo.structType;
      }
    }
    if (stringStruct == null) {
      throw new Error("string_hash_helper generation: String class struct not found!");
    }
    let stringStructIndex = (stringStruct as WasmStruct).index;
    let byteArrayType = this.ctx.wasm.getByteArrayType();
    let byteArrayTypeIndex = byteArrayType.index;

    let locals = new Array<ValType>();
    locals.push(new ValTypeRefNull(byteArrayType)); // 1: data
    locals.push(new ValTypeI32()); // 2: hash
    locals.push(new ValTypeI32()); // 3: i
    locals.push(new ValTypeI32()); // 4: end
    
    this.ctx.emitter.emitFunctionLocalsStart(locals);

    let strParam = 0;
    let dataLocal = 1;
    let hashLocal = 2;
    let iLocal = 3;
    let endLocal = 4;

    var dataFieldIdx = -1;
    var startFieldIdx = -1;
    var endFieldIdx = -1;
    for (var f = 0; f < (stringStruct as WasmStruct).fields.length; f += 1) {
      let fieldName = (stringStruct as WasmStruct).fields[f].name;
      if (fieldName != null) {
        let nameStr = fieldName as String;
        if (nameStr.endsWith("::#data")) {
          dataFieldIdx = f;
        } else if (nameStr.endsWith("::#start")) {
          startFieldIdx = f;
        } else if (nameStr.endsWith("::#end")) {
          endFieldIdx = f;
        }
      }
    }

    if (dataFieldIdx == -1 || startFieldIdx == -1 || endFieldIdx == -1) {
      throw new Error("String layout fields not found in structure!");
    }

    // data = s.#data (field 2)
    this.ctx.emitter.emitLocalGet(strParam);
    this.ctx.emitter.emitRefCast(stringStructIndex);
    this.ctx.emitter.emitStructGet(stringStructIndex, dataFieldIdx);
    this.ctx.emitter.emitLocalSet(dataLocal);

    // hash = 2166136261 (FNV offset basis)
    this.ctx.emitter.emitI32Const(-2128831035);
    this.ctx.emitter.emitLocalSet(hashLocal);

    // i = s.#start
    this.ctx.emitter.emitLocalGet(strParam);
    this.ctx.emitter.emitRefCast(stringStructIndex);
    this.ctx.emitter.emitStructGet(stringStructIndex, startFieldIdx);
    this.ctx.emitter.emitLocalSet(iLocal);

    // end = s.#end
    this.ctx.emitter.emitLocalGet(strParam);
    this.ctx.emitter.emitRefCast(stringStructIndex);
    this.ctx.emitter.emitStructGet(stringStructIndex, endFieldIdx);
    this.ctx.emitter.emitLocalSet(endLocal);

    // loop
    this.ctx.emitter.emitBlock(new ValTypeVoid()); // $break
    this.ctx.emitter.emitLoop(new ValTypeVoid()); // $continue

    // if i >= end break
    this.ctx.emitter.emitLocalGet(iLocal);
    this.ctx.emitter.emitLocalGet(endLocal);
    this.ctx.emitter.emitI32GeU();
    this.ctx.emitter.emitBrIf(1); // br $break

    // byte = data[i]
    this.ctx.emitter.emitLocalGet(dataLocal);
    this.ctx.emitter.emitLocalGet(iLocal);
    this.ctx.emitter.emitArrayGetU(byteArrayTypeIndex);

    // hash = hash ^ byte
    this.ctx.emitter.emitLocalGet(hashLocal);
    this.ctx.emitter.emitI32Xor();
    this.ctx.emitter.emitLocalSet(hashLocal);

    // hash = hash * 16777619
    this.ctx.emitter.emitLocalGet(hashLocal);
    this.ctx.emitter.emitI32Const(16777619);
    this.ctx.emitter.emitI32Mul();
    this.ctx.emitter.emitLocalSet(hashLocal);

    // i++
    this.ctx.emitter.emitLocalGet(iLocal);
    this.ctx.emitter.emitI32Const(1);
    this.ctx.emitter.emitI32Add();
    this.ctx.emitter.emitLocalSet(iLocal);

    // br $continue
    this.ctx.emitter.emitBr(0);

    this.ctx.emitter.emitEnd(); // end loop
    this.ctx.emitter.emitEnd(); // end block

    // return hash
    this.ctx.emitter.emitLocalGet(hashLocal);
  }

  generateStringCreate(): void {
    var stringStructOpt: WasmStruct | null = null;
    var vtableGlobalOpt: WasmGlobal | null = null;
    let stringClass = this.ctx.wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (let (true, stringInfo) = this.ctx.wasm.classInfos.get(key)) {
        stringStructOpt = stringInfo.structType;
        vtableGlobalOpt = stringInfo.vtableGlobal;
      }
    }
    if (stringStructOpt == null || vtableGlobalOpt == null) {
      throw new Error("$stringCreate: String class struct or vtable not found!");
    }
    let stringStruct = stringStructOpt as WasmStruct;
    let vtableGlobal = vtableGlobalOpt as WasmGlobal;
    let stringStructIndex = stringStruct.index;
    let byteArrayType = this.ctx.wasm.getByteArrayType();
    let byteArrayTypeIndex = byteArrayType.index;

    var dataFieldIdx = -1;
    var startFieldIdx = -1;
    var endFieldIdx = -1;
    var encodingFieldIdx = -1;
    for (var f = 0; f < stringStruct.fields.length; f += 1) {
      let fieldName = stringStruct.fields[f].name;
      if (fieldName != null) {
        let nameStr = fieldName as String;
        if (nameStr.endsWith("::#data")) {
          dataFieldIdx = f;
        } else if (nameStr.endsWith("::#start")) {
          startFieldIdx = f;
        } else if (nameStr.endsWith("::#end")) {
          endFieldIdx = f;
        } else if (nameStr.endsWith("::#encoding")) {
          encodingFieldIdx = f;
        }
      }
    }

    if (dataFieldIdx == -1 || startFieldIdx == -1 || endFieldIdx == -1 || encodingFieldIdx == -1) {
      throw new Error("$stringCreate: String layout fields not found in structure!");
    }

    let locals = new Array<ValType>();
    locals.push(new ValTypeRefNull(stringStruct)); // local 1
    this.ctx.emitter.emitFunctionLocalsStart(locals);

    let lenParam = 0;
    let stringLocal = 1;

    this.ctx.emitter.emitStructNewDefault(stringStructIndex);
    this.ctx.emitter.emitLocalTee(stringLocal);

    this.ctx.emitter.emitGlobalGet(vtableGlobal.index);
    this.ctx.emitter.emitStructSet(stringStructIndex, 0);

    this.ctx.emitter.emitLocalGet(stringLocal);
    this.ctx.emitter.emitLocalGet(lenParam);
    this.ctx.emitter.emitArrayNewDefault(byteArrayTypeIndex);
    this.ctx.emitter.emitStructSet(stringStructIndex, dataFieldIdx);

    this.ctx.emitter.emitLocalGet(stringLocal);
    this.ctx.emitter.emitI32Const(0);
    this.ctx.emitter.emitStructSet(stringStructIndex, startFieldIdx);

    this.ctx.emitter.emitLocalGet(stringLocal);
    this.ctx.emitter.emitLocalGet(lenParam);
    this.ctx.emitter.emitStructSet(stringStructIndex, endFieldIdx);

    this.ctx.emitter.emitLocalGet(stringLocal);
    this.ctx.emitter.emitI32Const(0);
    this.ctx.emitter.emitStructSet(stringStructIndex, encodingFieldIdx);

    this.ctx.emitter.emitLocalGet(stringLocal);
    this.ctx.emitter.emitExternConvertAny();
  }

  generateStringSetByte(): void {
    var stringStruct: WasmStruct | null = null;
    let stringClass = this.ctx.wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (let (true, stringInfo) = this.ctx.wasm.classInfos.get(key)) {
        stringStruct = stringInfo.structType;
      }
    }
    if (stringStruct == null) {
      throw new Error("$stringSetByte: String class struct not found!");
    }
    let stringStructIndex = (stringStruct as WasmStruct).index;
    let byteArrayType = this.ctx.wasm.getByteArrayType();
    let byteArrayTypeIndex = byteArrayType.index;

    var dataFieldIdx = -1;
    var startFieldIdx = -1;
    for (var f = 0; f < (stringStruct as WasmStruct).fields.length; f += 1) {
      let fieldName = (stringStruct as WasmStruct).fields[f].name;
      if (fieldName != null) {
        let nameStr = fieldName as String;
        if (nameStr.endsWith("::#data")) {
          dataFieldIdx = f;
        } else if (nameStr.endsWith("::#start")) {
          startFieldIdx = f;
        }
      }
    }

    if (dataFieldIdx == -1 || startFieldIdx == -1) {
      throw new Error("$stringSetByte: String layout fields not found in structure!");
    }

    let locals = new Array<ValType>();
    locals.push(new ValTypeRefNull(stringStruct as WasmStruct)); // local 3
    this.ctx.emitter.emitFunctionLocalsStart(locals);

    let strParam = 0;
    let indexParam = 1;
    let valueParam = 2;
    let strLocal = 3;

    this.ctx.emitter.emitLocalGet(strParam);
    this.ctx.emitter.emitAnyConvertExtern();
    this.ctx.emitter.emitRefCast(stringStructIndex);
    this.ctx.emitter.emitLocalSet(strLocal);

    this.ctx.emitter.emitLocalGet(strLocal);
    this.ctx.emitter.emitStructGet(stringStructIndex, dataFieldIdx);

    this.ctx.emitter.emitLocalGet(strLocal);
    this.ctx.emitter.emitStructGet(stringStructIndex, startFieldIdx);
    this.ctx.emitter.emitLocalGet(indexParam);
    this.ctx.emitter.emitI32Add();

    this.ctx.emitter.emitLocalGet(valueParam);

    this.ctx.emitter.emitArraySet(byteArrayTypeIndex);
  }

  generateStringHash(): void {
    var stringStruct: WasmStruct | null = null;
    let stringClass = this.ctx.wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (let (true, stringInfo) = this.ctx.wasm.classInfos.get(key)) {
        stringStruct = stringInfo.structType;
      }
    }
    if (stringStruct == null) {
      throw new Error("$stringHash: String class struct not found!");
    }
    let stringStructIndex = (stringStruct as WasmStruct).index;
    let byteArrayType = this.ctx.wasm.getByteArrayType();
    let byteArrayTypeIndex = byteArrayType.index;

    var dataFieldIdx = -1;
    var startFieldIdx = -1;
    var endFieldIdx = -1;
    var hashCodeFieldIdx = -1;
    for (var f = 0; f < (stringStruct as WasmStruct).fields.length; f += 1) {
      let fieldName = (stringStruct as WasmStruct).fields[f].name;
      if (fieldName != null) {
        let nameStr = fieldName as String;
        if (nameStr.endsWith("::#data")) {
          dataFieldIdx = f;
        } else if (nameStr.endsWith("::#start")) {
          startFieldIdx = f;
        } else if (nameStr.endsWith("::#end")) {
          endFieldIdx = f;
        } else if (nameStr.endsWith("::#hashCode")) {
          hashCodeFieldIdx = f;
        }
      }
    }

    if (dataFieldIdx == -1 || startFieldIdx == -1 || endFieldIdx == -1 || hashCodeFieldIdx == -1) {
      throw new Error("$stringHash: String layout fields not found in structure!");
    }

    let locals = new Array<ValType>();
    locals.push(new ValTypeRefNull(byteArrayType)); // local 1: data
    locals.push(new ValTypeI32()); // local 2: hash
    locals.push(new ValTypeI32()); // local 3: i
    locals.push(new ValTypeI32()); // local 4: end
    this.ctx.emitter.emitFunctionLocalsStart(locals);

    let sParam = 0;
    let dataLocal = 1;
    let hashLocal = 2;
    let iLocal = 3;
    let endLocal = 4;

    // Check if hashCode is already cached (s.#hashCode != 0)
    this.ctx.emitter.emitLocalGet(sParam);
    this.ctx.emitter.emitStructGet(stringStructIndex, hashCodeFieldIdx);
    this.ctx.emitter.emitLocalTee(hashLocal);
    this.ctx.emitter.emitI32Const(0);
    this.ctx.emitter.emitI32Ne();
    this.ctx.emitter.emitIf(new ValTypeI32());
    
    // If branch: return cached hash
    this.ctx.emitter.emitLocalGet(hashLocal);
    
    this.ctx.emitter.emitElse();

    // Else branch: calculate hash
    
    // data = s.#data
    this.ctx.emitter.emitLocalGet(sParam);
    this.ctx.emitter.emitStructGet(stringStructIndex, dataFieldIdx);
    this.ctx.emitter.emitLocalSet(dataLocal);

    // hash = -2128831035
    this.ctx.emitter.emitI32Const(-2128831035);
    this.ctx.emitter.emitLocalSet(hashLocal);

    // i = s.#start
    this.ctx.emitter.emitLocalGet(sParam);
    this.ctx.emitter.emitStructGet(stringStructIndex, startFieldIdx);
    this.ctx.emitter.emitLocalSet(iLocal);

    // end = s.#end
    this.ctx.emitter.emitLocalGet(sParam);
    this.ctx.emitter.emitStructGet(stringStructIndex, endFieldIdx);
    this.ctx.emitter.emitLocalSet(endLocal);

    // loop/block
    this.ctx.emitter.emitBlock(new ValTypeVoid());
    this.ctx.emitter.emitLoop(new ValTypeVoid());

    // if i >= end break
    this.ctx.emitter.emitLocalGet(iLocal);
    this.ctx.emitter.emitLocalGet(endLocal);
    this.ctx.emitter.emitI32GeU();
    this.ctx.emitter.emitBrIf(1);

    // byte = data[i]
    this.ctx.emitter.emitLocalGet(dataLocal);
    this.ctx.emitter.emitLocalGet(iLocal);
    this.ctx.emitter.emitArrayGetU(byteArrayTypeIndex);

    // hash ^= byte
    this.ctx.emitter.emitLocalGet(hashLocal);
    this.ctx.emitter.emitI32Xor();
    this.ctx.emitter.emitLocalSet(hashLocal);

    // hash *= 16777619
    this.ctx.emitter.emitLocalGet(hashLocal);
    this.ctx.emitter.emitI32Const(16777619);
    this.ctx.emitter.emitI32Mul();
    this.ctx.emitter.emitLocalSet(hashLocal);

    // i++
    this.ctx.emitter.emitLocalGet(iLocal);
    this.ctx.emitter.emitI32Const(1);
    this.ctx.emitter.emitI32Add();
    this.ctx.emitter.emitLocalSet(iLocal);

    this.ctx.emitter.emitBr(0);
    this.ctx.emitter.emitEnd(); // end loop
    this.ctx.emitter.emitEnd(); // end block

    // Prevent 0 hash (since 0 means uncalculated)
    this.ctx.emitter.emitLocalGet(hashLocal);
    this.ctx.emitter.emitI32Const(0);
    this.ctx.emitter.emitI32Eq();
    this.ctx.emitter.emitIf(new ValTypeI32());
    this.ctx.emitter.emitI32Const(1);
    this.ctx.emitter.emitElse();
    this.ctx.emitter.emitLocalGet(hashLocal);
    this.ctx.emitter.emitEnd();
    this.ctx.emitter.emitLocalSet(hashLocal);

    // Store in cache: s.#hashCode = hash
    this.ctx.emitter.emitLocalGet(sParam);
    this.ctx.emitter.emitLocalGet(hashLocal);
    this.ctx.emitter.emitStructSet(stringStructIndex, hashCodeFieldIdx);

    // Return the calculated hash
    this.ctx.emitter.emitLocalGet(hashLocal);

    this.ctx.emitter.emitEnd(); // close outer if-else
  }

  generateStringGetByte(): void {
    var stringStruct: WasmStruct | null = null;
    let stringClass = this.ctx.wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (let (true, stringInfo) = this.ctx.wasm.classInfos.get(key)) {
        stringStruct = stringInfo.structType;
      }
    }
    if (stringStruct == null) {
      throw new Error("$stringGetByte: String class struct not found!");
    }
    let stringStructIndex = (stringStruct as WasmStruct).index;
    let byteArrayType = this.ctx.wasm.getByteArrayType();
    let byteArrayTypeIndex = byteArrayType.index;

    var dataFieldIdx = -1;
    var startFieldIdx = -1;
    for (var f = 0; f < (stringStruct as WasmStruct).fields.length; f += 1) {
      let fieldName = (stringStruct as WasmStruct).fields[f].name;
      if (fieldName != null) {
        let nameStr = fieldName as String;
        if (nameStr.endsWith("::#data")) {
          dataFieldIdx = f;
        } else if (nameStr.endsWith("::#start")) {
          startFieldIdx = f;
        }
      }
    }

    if (dataFieldIdx == -1 || startFieldIdx == -1) {
      throw new Error("$stringGetByte: String layout fields not found in structure!");
    }

    let locals = new Array<ValType>();
    locals.push(new ValTypeRefNull(stringStruct as WasmStruct)); // local 2
    this.ctx.emitter.emitFunctionLocalsStart(locals);

    let strParam = 0;
    let indexParam = 1;
    let strLocal = 2;

    this.ctx.emitter.emitLocalGet(strParam);
    this.ctx.emitter.emitAnyConvertExtern();
    this.ctx.emitter.emitRefCast(stringStructIndex);
    this.ctx.emitter.emitLocalSet(strLocal);

    this.ctx.emitter.emitLocalGet(strLocal);
    this.ctx.emitter.emitStructGet(stringStructIndex, dataFieldIdx);

    this.ctx.emitter.emitLocalGet(strLocal);
    this.ctx.emitter.emitStructGet(stringStructIndex, startFieldIdx);
    this.ctx.emitter.emitLocalGet(indexParam);
    this.ctx.emitter.emitI32Add();

    this.ctx.emitter.emitArrayGetU(byteArrayTypeIndex);
  }

  generateStringGetLength(): void {
    var stringStruct: WasmStruct | null = null;
    let stringClass = this.ctx.wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (let (true, stringInfo) = this.ctx.wasm.classInfos.get(key)) {
        stringStruct = stringInfo.structType;
      }
    }
    if (stringStruct == null) {
      throw new Error("$stringGetLength: String class struct not found!");
    }
    let stringStructIndex = (stringStruct as WasmStruct).index;

    var startFieldIdx = -1;
    var endFieldIdx = -1;
    for (var f = 0; f < (stringStruct as WasmStruct).fields.length; f += 1) {
      let fieldName = (stringStruct as WasmStruct).fields[f].name;
      if (fieldName != null) {
        let nameStr = fieldName as String;
        if (nameStr.endsWith("::#start")) {
          startFieldIdx = f;
        } else if (nameStr.endsWith("::#end")) {
          endFieldIdx = f;
        }
      }
    }

    if (startFieldIdx == -1 || endFieldIdx == -1) {
      throw new Error("$stringGetLength: String layout fields not found in structure!");
    }

    let locals = new Array<ValType>();
    locals.push(new ValTypeRefNull(stringStruct as WasmStruct)); // local 1
    this.ctx.emitter.emitFunctionLocalsStart(locals);

    let strParam = 0;
    let strLocal = 1;

    this.ctx.emitter.emitLocalGet(strParam);
    this.ctx.emitter.emitAnyConvertExtern();
    this.ctx.emitter.emitRefCast(stringStructIndex);
    this.ctx.emitter.emitLocalSet(strLocal);

    this.ctx.emitter.emitLocalGet(strLocal);
    this.ctx.emitter.emitStructGet(stringStructIndex, endFieldIdx);

    this.ctx.emitter.emitLocalGet(strLocal);
    this.ctx.emitter.emitStructGet(stringStructIndex, startFieldIdx);

    this.ctx.emitter.emitI32Sub();
  }
}

export let collectValueExports = (program: Program, unit: CompilationUnit, result: HashMap<String, Symbol>): void => {
  for (let stmt in unit.ast.body) {
    match (stmt) {
      case VariableDeclaration {pattern, exported}: {
        if (exported && pattern is IdentifierPattern) {
          let ident = pattern as IdentifierPattern;
          let sym = unit.model.resolveDeclaration(ident);
          if (sym != null) {
            result[ident.name] = sym as Symbol;
          }
        }
      }
      case ClassDeclaration {name, exported}: {
        if (exported) {
          let sym = unit.model.resolveDeclaration(name);
          if (sym != null) {
            result[name.name] = sym as Symbol;
          }
        }
      }
      case EnumDeclaration {name, exported}: {
        if (exported) {
          let sym = unit.model.resolveDeclaration(name);
          if (sym != null) {
            result[name.name] = sym as Symbol;
          }
        }
      }
      case DeclareFunction {name, exported}: {
        if (exported) {
          let sym = unit.model.resolveDeclaration(name);
          if (sym != null) {
            result[name.name] = sym as Symbol;
          }
        }
      }
      case ExportFromDeclaration {specifiers, moduleSpecifier}: {
        let specifier = moduleSpecifier.value;
        var canonicalPath = specifier;
        if (specifier.startsWith("./") || specifier.startsWith("../")) {
          let dir = dirName(unit.ast.path);
          canonicalPath = normalizePath(dir + "/" + specifier);
        }
        if (program.unitsByPath.has(canonicalPath)) {
          let targetUnit = program.unitsByPath[canonicalPath];
          for (let spec in specifiers) {
            let importedName = spec.imported.name;
            let localName = spec.local.name;
            let targetExports = new HashMap<String, Symbol>();
            collectValueExports(program, targetUnit, targetExports);
            if (targetExports.has(importedName)) {
              result[localName] = targetExports[importedName];
            }
          }
        }
      }
      case ExportAllDeclaration {moduleSpecifier}: {
        let specifier = moduleSpecifier.value;
        var canonicalPath = specifier;
        if (specifier.startsWith("./") || specifier.startsWith("../")) {
          let dir = dirName(unit.ast.path);
          canonicalPath = normalizePath(dir + "/" + specifier);
        }
        if (program.unitsByPath.has(canonicalPath)) {
          let targetUnit = program.unitsByPath[canonicalPath];
          collectValueExports(program, targetUnit, result);
        }
      }
      case _: {}
    }
  }
};

let getClassFieldType = (wasm: WasmModule, ct: ClassType, propName: String): Type | null => {
  if (ct.members.has(propName) && ct.members[propName] is FieldInfo) {
    let fi = ct.members[propName] as FieldInfo;
    let ctParams = getClassTypeParameters(ct);
    return substituteTypeParamsInCodegen(ctParams, ct.typeArguments, fi.type);
  }
  let getterName = "get#" + propName;
  if (ct.members.has(getterName)) {
    let mi = ct.members[getterName];
    if (mi.type is FunctionType) {
      let ft = mi.type as FunctionType;
      let ctParams = getClassTypeParameters(ct);
      return substituteTypeParamsInCodegen(ctParams, ct.typeArguments, ft.returnType);
    }
  }
  if (ct.superType != null) {
    return getClassFieldType(wasm, ct.superType as ClassType, propName);
  }
  return null;
};

let getInterfaceFieldType = (wasm: WasmModule, it: InterfaceType, propName: String): Type | null => {
  if (it.members.has(propName) && it.members[propName] is FieldInfo) {
    let fi = it.members[propName] as FieldInfo;
    let itParams = getInterfaceTypeParameters(it);
    return substituteTypeParamsInCodegen(itParams, it.typeArguments, fi.type);
  }
  let getterName = "get#" + propName;
  if (it.members.has(getterName)) {
    let mi = it.members[getterName];
    if (mi.type is FunctionType) {
      let ft = mi.type as FunctionType;
      let itParams = getInterfaceTypeParameters(it);
      return substituteTypeParamsInCodegen(itParams, it.typeArguments, ft.returnType);
    }
  }
  for (let parent in it.extendsList) {
    let parentType = getInterfaceFieldType(wasm, parent, propName);
    if (parentType != null) {
      return parentType;
    }
  }
  return null;
};
