import { 
  Node, VariableDeclaration, FunctionExpression, IdentifierPattern,
  Identifier, NumberLiteral, BooleanLiteral, StringLiteral, BlockStatement,
  ReturnStatement, ExpressionStatement, Statement, Expression, CallExpression,
  ImportSpecifier, BinaryExpression, UnaryExpression, AssignmentExpression
} from '../ast.zena';
import { Type, I32Type, F64Type, F32Type } from '../types.zena';
import { SemanticModel } from '../semantic-model.zena';
import { SymbolId, Symbol } from '../scope/symbol.zena';
import { Error } from 'zena:error';
import { ValType } from "./wasm.zena";
import { String } from "zena:string";
import { i32ToString } from "zena:string-convert";
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';

import { parseI32, parseF64 } from 'zena:string-convert';

import { WasmEmitter } from './wasm-emitter.zena';
import { WasmFunction, WasmModule } from './wasm-module.zena';

/**
 * Manages the generic AST traversal and code generation.
 * Emits backend-agnostic logical instructions to a generic `WasmEmitter`.
 */
export class FunctionGenerator {
  wasm: WasmModule;
  emitter: WasmEmitter;
  wasmFunction: WasmFunction;
  localIndices = new HashMap<SymbolId, i32>();
  localTypes = new Array<ValType>();

  new(this.wasm, this.emitter, this.wasmFunction);

  discoverLocalsFromStmt(stmt: Statement): void {
    match (stmt) {
      case BlockStatement {body}: {
        for (let s in body) {
          this.discoverLocalsFromStmt(s);
        }
      }
      case VariableDeclaration: {
        let decl = stmt as VariableDeclaration;
        if (decl.pattern is IdentifierPattern) {
          let ident = decl.pattern as IdentifierPattern;
          let sym = this.wasmFunction.model.resolveDeclaration(ident);
          if (sym != null) {
            let varType = this.wasmFunction.model.getNodeType(decl);
            var vType = ValType.i32;
            if (varType is F64Type) {
              vType = ValType.f64;
            } else if (varType is F32Type) {
              vType = ValType.f32;
            }
            let index = this.wasmFunction.signature.params.length + this.localTypes.length;
            this.localIndices[sym.id] = index;
            this.localTypes.push(vType);
          }
        }
      }
      case _: {}
    }
  }

  generate(): void {
    let bodyNode = this.wasmFunction.node;
    for (var i = 0; i < bodyNode.params.length; i += 1) {
      let param = bodyNode.params[i];
      let sym = this.wasmFunction.model.resolveDeclaration(param.name);
      if (sym != null) {
        this.localIndices[sym.id] = i;
      }
    }
    
    let body = bodyNode.body;
    match (body) {
      case BlockStatement: {
        let block = body as BlockStatement;
        for (let stmt in block.body) {
          this.discoverLocalsFromStmt(stmt);
        }
      }
      case _: {}
    }

    this.emitter.emitFunctionCodeStart(this.wasmFunction);
    var name = "func" + i32ToString(this.wasmFunction.index);
    if (this.wasmFunction.name != null) {
      name = this.wasmFunction.name as String;
    }
    this.emitter.emitFunctionSignatureStart(name, this.wasmFunction.signature.index);
    
    
    this.emitter.emitFunctionLocalsStart(this.localTypes);
    
    match (bodyNode.body) {
      case BlockStatement: {
        let block = bodyNode.body as BlockStatement;
        for (let stmt in block.body) {
          this.generateStatement(stmt);
        }
      }
      case Expression: {
        this.generateExpression(bodyNode.body as Expression);
        this.emitter.emitReturn();
      }
    }
    
    this.emitter.emitFunctionEnd();
    this.emitter.emitFunctionCodeEnd(this.wasmFunction);
  }

  generateStatement(stmt: Statement): void {
    match (stmt) {
      case ReturnStatement {argument}: {
        if (argument != null) {
          this.generateExpression(argument as Expression);
        }
        this.emitter.emitReturn();
      }
      case ExpressionStatement {expression}: {
        this.generateExpression(expression);
      }
      case BlockStatement {body}: {
        for (let s in body) {
          this.generateStatement(s);
        }
      }
      case VariableDeclaration: {
        let decl = stmt as VariableDeclaration;
        if (decl.init != null) {
          this.generateExpression(decl.init as Expression);
          if (decl.pattern is IdentifierPattern) {
            let ident = decl.pattern as IdentifierPattern;
            let sym = this.wasmFunction.model.resolveDeclaration(ident);
            if (sym != null && this.localIndices.has(sym.id)) {
              this.emitter.emitLocalSet(this.localIndices[sym.id]);
            }
          }
        }
      }
      case _: {
        throw new Error("Unsupported statement type in codegen");
      }
    }
  }

  generateExpression(expr: Expression): void {
    match (expr) {
      case Identifier: {
        let ident = expr as Identifier;
        let sym = this.wasmFunction.model.resolve(ident);
        if (sym != null && this.localIndices.has((sym as Symbol).id)) {
          this.emitter.emitLocalGet(this.localIndices[(sym as Symbol).id]);
        } else {
          // It could be a top-level variable or globally imported value
          // We don't support globals yet.
          throw new Error("Could not resolve identifier to a local variable: " + ident.name);
        }
      }
      case CallExpression {callee, args}: {
        match (callee) {
          case Identifier: {
            let ident = callee as Identifier;
            let model = this.wasmFunction.model;
            let sym = model.resolve(ident);
            
            if (sym == null) {
              throw new Error("Unresolved identifier in codegen: " + ident.name);
            }
            
            if (this.wasm.functionMap.has((sym as Symbol).id)) {
              for (let arg in args) {
                this.generateExpression(arg);
              }
              this.emitter.emitCall(this.wasm.functionMap[(sym as Symbol).id]);
              return;
            } else {
              if ((sym as Symbol).declaration is ImportSpecifier) {
                let spec = (sym as Symbol).declaration as ImportSpecifier;
                let importedName = spec.imported.name;
                if (this.wasm.exportMap.has(importedName)) {
                  for (let arg in args) {
                    this.generateExpression(arg);
                  }
                  this.emitter.emitCall(this.wasm.exportMap[importedName]);
                  return;
                }
                throw new Error("Export map missing: " + importedName);
              }
              throw new Error("Could not resolve function call target");
            }
          }
          case _: {
            throw new Error("Unsupported call expression");
          }        
        }
      }
      case NumberLiteral {raw}: {
        let nodeType = this.wasmFunction.model.getNodeType(expr as Node);
        if (nodeType is F64Type || nodeType is F32Type) {
          let val = parseF64(raw);
          this.emitter.emitF64Const(val);
        } else {
          let (ok, val) = parseI32(raw);
          if (!ok) {
            throw new Error('Failed to parse i32: ' + raw);
          }
          this.emitter.emitI32Const(val as i32);
        }
      }
      case BooleanLiteral {value}: {
        this.emitter.emitBooleanConst(value);
      }
      case StringLiteral {value}: {
        this.emitter.emitStringConst(value);
      }
      case UnaryExpression: {
        let un = expr as UnaryExpression;
        if (un.operator == "-") {
          let nodeType = this.wasmFunction.model.getNodeType(un);
          if (nodeType is F64Type || nodeType is F32Type) {
            this.emitter.emitF64Const(0.0);
            this.generateExpression(un.argument);
            this.emitter.emitF64Sub();
          } else {
            this.emitter.emitI32Const(0);
            this.generateExpression(un.argument);
            this.emitter.emitI32Sub();
          }
        } else {
          throw new Error("Unsupported unary operator: " + un.operator);
        }
      }
      case BinaryExpression: {
        let bin = expr as BinaryExpression;
        // TODO: Support operator overloading and custom classes
        
        let model = this.wasmFunction.model;
        let leftType = model.getNodeType(bin.left);
        let rightType = model.getNodeType(bin.right);
        
        if (leftType == null || rightType == null) {
          throw new Error("Missing type info in semantic model for binary expression operands");
        }
        
        var isFloatContext = false;
        if (leftType is F64Type || rightType is F64Type || leftType is F32Type || rightType is F32Type) {
            isFloatContext = true;
        }

        // Implicit F64 upconversion logic
        if (isFloatContext && !(leftType is F64Type) && !(leftType is F32Type)) {
          this.generateExpression(bin.left);
          this.emitter.emitF64ConvertI32S();
        } else {
          this.generateExpression(bin.left);
        }

        if (isFloatContext && !(rightType is F64Type) && !(rightType is F32Type)) {
          this.generateExpression(bin.right);
          this.emitter.emitF64ConvertI32S();
        } else {
          this.generateExpression(bin.right);
        }
        
        if (isFloatContext) {
          match (bin.operator) {
            case "+": this.emitter.emitF64Add()
            case "-": this.emitter.emitF64Sub()
            case "*": this.emitter.emitF64Mul()
            case "/": this.emitter.emitF64Div()
            case "==": this.emitter.emitF64Eq()
            case "!=": this.emitter.emitF64Ne()
            case "===": this.emitter.emitF64Eq()
            case "!==": this.emitter.emitF64Ne()
            case "<": this.emitter.emitF64Lt()
            case "<=": this.emitter.emitF64Le()
            case ">": this.emitter.emitF64Gt()
            case ">=": this.emitter.emitF64Ge()
            case _: throw new Error("Unsupported operator for f64: " + bin.operator)
          }
        } else {
          match (bin.operator) {
            case "+": this.emitter.emitI32Add()
            case "-": this.emitter.emitI32Sub()
            case "*": this.emitter.emitI32Mul()
            case "/": this.emitter.emitI32DivS()
            case "%": this.emitter.emitI32RemS()
            case "==": this.emitter.emitI32Eq()
            case "!=": this.emitter.emitI32Ne()
            case "===": this.emitter.emitI32Eq()
            case "!==": this.emitter.emitI32Ne()
            case "<": this.emitter.emitI32LtS()
            case "<=": this.emitter.emitI32LeS()
            case ">": this.emitter.emitI32GtS()
            case ">=": this.emitter.emitI32GeS()
            case "&": this.emitter.emitI32And()
            case "|": this.emitter.emitI32Or()
            case "^": this.emitter.emitI32Xor()
            case "<<": this.emitter.emitI32Shl()
            case ">>": this.emitter.emitI32ShrS()
            case ">>>": this.emitter.emitI32ShrU()
            case _: throw new Error("Unsupported operator for i32: " + bin.operator)
          }
        }
      }
      case AssignmentExpression: {
        let assign = expr as AssignmentExpression;
        if (assign.left is Identifier) {
          let ident = assign.left as Identifier;
          let sym = this.wasmFunction.model.resolve(ident);
          
          // Generate the RHS value
          this.generateExpression(assign.value);

          if (sym != null && this.localIndices.has((sym as Symbol).id)) {
            // Write it using local.tee instead of local.set, because assignments are expressions
            // evaluate to their assigned value. But wait, if this assignment is inside an ExpressionStatement,
            // the value left on the stack will be dropped. But if it's part of another expression, it won't.
            // Oh right, JS assignment is an expression. We should tee it. Wait, does zena drop ExpressionStatements?
            this.emitter.emitLocalTee(this.localIndices[(sym as Symbol).id]);
          } else {
            throw new Error("Could not resolve assignment target to local: " + ident.name);
          }
        } else {
           throw new Error("Unsupported assignment target");
        }
      }
      case _: {
        throw new Error("Unsupported expression type in codegen");
      }
    }
  }
}
