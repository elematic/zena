import { ValTypeVoid, ValTypeRefNull, ValTypeRef, ValTypeStructRef, ValTypeI32, ValTypeAnyRef } from '../wasm.zena';
import { WasmArray, WasmGlobal } from '../wasm-module.zena';
import { Error } from 'zena:error';
import { 
  Node, BreakStatement, ContinueStatement, WhileStatement, ForStatement, Statement, Expression,
  ForInStatement, BindingPattern, IdentifierPattern, LetPatternCondition, TuplePattern, LiteralPattern, BooleanLiteral, NumberLiteral, StringLiteral, NullLiteral, SourceLocation
} from '../../ast.zena';
import { VoidType, Type, InterfaceType, ClassType, ArrayType, ThisType, UnionType, NullType, instantiateClassType, MethodInfo, FunctionType, InlineTupleType, baseType, typeToString } from '../../types.zena';
import { ValType } from "../wasm.zena";
import { FunctionContext } from '../function-context.zena';
import { typeToValType, getInterfaceMemberSignature, substituteTypeParamsInCodegen, typeToValTypeWithSub, getNodeType, getClassTypeParameters, getInterfaceTypeParameters, substituteTypeParamsInFunctionContext, substituteTypeParamsInClassContext } from '../type-mapping.zena';
import { 
  getInterfaceKey, getInterfaceMemberKey, getClassKey, getClassInterfaceKey,
  classInterfaceKeyToString, InterfaceKey, getClassPrivateFieldKey
} from '../codegen-utils.zena';
import { Program, CompilationUnit } from '../../program.zena';
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { generatePatternBinding } from './bindings.zena';
import { generateLetPatternCheck } from './control-flow.zena';
import { walk } from '../../visitor.zena';
import { i32ToString } from 'zena:string-convert';


let hasBreakTargetingLoop = (body: Statement): boolean => {
  var foundBreak = false;
  walk(body, (n: Node): boolean => {
    if (n is BreakStatement) {
      foundBreak = true;
      return false;
    }
    if (n is WhileStatement || n is ForStatement || n is ForInStatement) {
      return false;
    }
    return true;
  }, (n: Node): void => {});
  return foundBreak;
};

export let generateBreakStatement = (ctx: FunctionContext, stmt: BreakStatement): void => {
  let n = ctx.loopStack.length;
  if (n > 0) {
    let (bDepth, _) = ctx.loopStack[n - 1];
    ctx.emitter.emitBr(bDepth);
  } else {
    ctx.emitter.emitUnreachable();
  }
  ctx.isReachable = false;
};

export let generateContinueStatement = (ctx: FunctionContext, stmt: ContinueStatement): void => {
  let n = ctx.loopStack.length;
  if (n > 0) {
    let (_, cDepth) = ctx.loopStack[n - 1];
    ctx.emitter.emitBr(cDepth);
  } else {
    ctx.emitter.emitUnreachable();
  }
  ctx.isReachable = false;
};

export let generateWhileStatement = (ctx: FunctionContext, stmt: WhileStatement, genExpr: (e: Expression, discardValue: boolean) => void, genStmt: (s: Statement) => void): void => {
  if (stmt.test is LetPatternCondition) {
    let lpc = stmt.test as LetPatternCondition;
    let pattern = lpc.pattern;
    if (pattern is TuplePattern) {
      let tp = pattern as TuplePattern;
      let initType = getNodeType(ctx, lpc.init);
      
      var baseT = baseType(initType as Type);
      var elementTypes: Array<Type> | null = null;
      if (baseT is InlineTupleType) {
        elementTypes = (baseT as InlineTupleType).elementTypes;
      } else if (baseT is UnionType) {
        for (let ut in (baseT as UnionType).types) {
          if (ut is InlineTupleType) {
            if (elementTypes == null) {
              elementTypes = (ut as InlineTupleType).elementTypes;
            }
          }
        }
      }
      
      if (elementTypes == null) {
        throw new Error("while-let expects inline tuple type");
      }
      let elemTypes = elementTypes as Array<Type>;
      
      // 1. Allocate temp locals (same types as tuple elements)
      let tempLocals = new Array<i32>();
      for (var i = 0; i < tp.elements.length; i += 1) {
        let elType = elemTypes[i];
        let valType = typeToValType(ctx.wasm, elType);
        let temp = ctx.allocLocal(valType);
        tempLocals.push(temp);
      }
      
      // block $break (depth 1)
      ctx.emitter.emitBlock(new ValTypeVoid());
      // loop $continue (depth 0)
      ctx.emitter.emitLoop(new ValTypeVoid());
      
      // 2. Evaluate init (pushes values on stack)
      genExpr(lpc.init, false);
      
      // 3. Pop to temp locals in reverse order
      for (var i = tp.elements.length - 1; i >= 0; i -= 1) {
        let temp = tempLocals[i];
        ctx.emitter.emitLocalSet(temp);
      }
      
      // 4. Check condition (pattern check)
      generateLetPatternCheck(ctx, tp, tempLocals, elemTypes, genExpr);
      ctx.emitter.emitI32Eqz();
      ctx.emitter.emitBrIf(1); // break to outer block (depth 1)
      
      let wasReachable = ctx.isReachable;
      ctx.enterLoop();
      
      // 5. Bind pattern variables
      for (var i = 0; i < tp.elements.length; i += 1) {
        let el = tp.elements[i];
        if (el != null && !(el is LiteralPattern) && !(el is BooleanLiteral) && !(el is NumberLiteral) && !(el is StringLiteral) && !(el is NullLiteral)) {
          let temp = tempLocals[i];
          let loadValue = (): void => {
            ctx.emitter.emitLocalGet(temp);
          };
          generatePatternBinding(ctx, el as Node, elemTypes[i], loadValue);
        }
      }
      
      // 6. Generate body
      genStmt(stmt.body);
      ctx.exitLoop();
      
      ctx.isReachable = wasReachable;
      ctx.emitter.emitBr(0); // continue loop (depth 0)
      ctx.emitter.emitEnd(); // end loop
      ctx.emitter.emitEnd(); // end block
      return;
    }
  }

  let isConstantTrue = if (stmt.test != null && stmt.test is BooleanLiteral) (stmt.test as BooleanLiteral).value else false;
  let hasBreak = hasBreakTargetingLoop(stmt.body);
  let needsOuterBlock = !isConstantTrue || hasBreak;

  if (needsOuterBlock) {
    ctx.emitter.emitBlock(new ValTypeVoid());
  }
  ctx.emitter.emitLoop(new ValTypeVoid());
  
  if (!isConstantTrue) {
    genExpr(stmt.test as Expression, false);
    ctx.emitter.emitI32Const(0);
    ctx.emitter.emitI32Eq();
    ctx.emitter.emitBrIf(1);
  }
  
  let wasReachable = ctx.isReachable;
  ctx.enterLoop();
  genStmt(stmt.body);
  ctx.exitLoop();
  
  ctx.isReachable = wasReachable;
  ctx.emitter.emitBr(0);
  ctx.emitter.emitEnd();
  if (needsOuterBlock) {
    ctx.emitter.emitEnd();
  }
  
  if (isConstantTrue && !hasBreak) {
    ctx.emitter.emitUnreachable();
    ctx.isReachable = false;
  } else {
    ctx.isReachable = wasReachable;
  }
};

export let generateForStatement = (ctx: FunctionContext, stmt: ForStatement, genExpr: (e: Expression, discardValue: boolean) => void, genStmt: (s: Statement) => void): void => {
  let {init, test, update, body} = stmt;
  
  if (init != null) {
    if (init is Statement) {
      genStmt(init as Statement);
    } else if (init is Expression) {
      genExpr(init as Expression, true);
    }
  }
  
  ctx.emitter.emitBlock(new ValTypeVoid());
  ctx.emitter.emitLoop(new ValTypeVoid());
  
  if (test != null) {
    genExpr(test as Expression, false);
    ctx.emitter.emitI32Const(0);
    ctx.emitter.emitI32Eq();
    ctx.emitter.emitBrIf(1);
  }
  
  // Inner block for continue to jump to (skipping body, hitting update)
  ctx.emitter.emitBlock(new ValTypeVoid());
  let wasReachable = ctx.isReachable;
  
  ctx.enterForLoop();
  genStmt(body);
  ctx.exitLoop();
  
  ctx.emitter.emitEnd(); // End continue block
  ctx.isReachable = wasReachable;
  
  if (update != null) {
    genExpr(update as Expression, true);
  }
  
  ctx.emitter.emitBr(0);
  ctx.emitter.emitEnd();
  ctx.emitter.emitEnd();
  
  ctx.isReachable = wasReachable;
};

let findPreludeInterface = (ctx: FunctionContext, name: String): InterfaceType | null => {
  if (ctx.wasm.program != null) {
    let prog = ctx.wasm.program as Program;
    for (let unit in prog.units) {
      let model = unit.model;
      let t = model.getExportType(name);
      if (t != null && t is InterfaceType) {
        return t as InterfaceType;
      }
    }
  }
  return null;
};

let findPreludeClass = (ctx: FunctionContext, name: String): ClassType | null => {
  if (ctx.wasm.program != null) {
    let prog = ctx.wasm.program as Program;
    for (let unit in prog.units) {
      let model = unit.model;
      let t = model.getExportType(name);
      if (t != null && t is ClassType) {
        return t as ClassType;
      }
    }
  }
  return null;
};

let findIterableOrIteratorElementType = (t: Type): Type | null => {
  match (t) {
    case ArrayType {elementType}: {
      return elementType;
    }
    case ClassType as ct: {
      if ((ct.name == "array" || ct.name == "Array" || ct.name == "FixedArray" || ct.name == "ImmutableArray") && ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0) {
        return (ct.typeArguments as Array<Type>)[0];
      }
      for (let iface in ct.implementsList) {
        let res = findIterableOrIteratorElementType(iface as Type);
        if (res != null) {
          let ctParams = getClassTypeParameters(ct);
          return substituteTypeParamsInCodegen(ctParams, ct.typeArguments, res as Type);
        }
      }
      if (ct.superType != null) {
        let res = findIterableOrIteratorElementType(ct.superType as Type);
        if (res != null) {
          let ctParams = getClassTypeParameters(ct);
          return substituteTypeParamsInCodegen(ctParams, ct.typeArguments, res as Type);
        }
      }
    }
    case InterfaceType as it: {
      if ((it.name == "Iterable" || it.name == "Iterator") && it.typeArguments != null && (it.typeArguments as Array<Type>).length > 0) {
        return (it.typeArguments as Array<Type>)[0];
      }
      for (let ext in it.extendsList) {
        let res = findIterableOrIteratorElementType(ext as Type);
        if (res != null) {
          let itParams = getInterfaceTypeParameters(it);
          return substituteTypeParamsInCodegen(itParams, it.typeArguments, res as Type);
        }
      }
    }
    case _: {}
  }
  return null;
};

let findImplementedInterfaceTransitive = (ct: ClassType, name: String): InterfaceType | null => {
  let seen = new HashMap<InterfaceKey, boolean>();
  let queue = new Array<InterfaceType>();
  
  let ctParams = getClassTypeParameters(ct);
  for (let impl in ct.implementsList) {
    let resolved = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, impl) as InterfaceType;
    queue.push(resolved);
  }
  
  var currSuper = ct.superType;
  while (currSuper != null) {
    let superCt = currSuper as ClassType;
    let superCtParams = getClassTypeParameters(superCt);
    for (let impl in superCt.implementsList) {
      let resolved = substituteTypeParamsInCodegen(superCtParams, superCt.typeArguments, impl) as InterfaceType;
      queue.push(resolved);
    }
    currSuper = superCt.superType;
  }
  
  var head = 0;
  while (head < queue.length) {
    let it = queue[head];
    head += 1;
    
    let key = getInterfaceKey(it);
    if (!seen.has(key)) {
      seen[key] = true;
      if (it.name == name) {
        return it;
      }
      let itParams = getInterfaceTypeParameters(it);
      for (let ext in it.extendsList) {
        let resolvedExt = substituteTypeParamsInCodegen(itParams, it.typeArguments, ext) as InterfaceType;
        queue.push(resolvedExt);
      }
    }
  }
  return null;
};

let getForInElementType = (ctx: FunctionContext, iterableType: Type): Type => {
  var t = iterableType;
  while (t is UnionType) {
    let ut = t as UnionType;
    var found: Type | null = null;
    for (let member in ut.types) {
      if (!(member is NullType || member is VoidType)) {
        found = member;
        break;
      }
    }
    if (found != null) {
      t = found as Type;
    } else {
      break;
    }
  }

  let res = findIterableOrIteratorElementType(t);
  if (res != null) {
    return res as Type;
  }
  throw new Error("Could not determine element type for for-in loop");
};
export let generateForInStatement = (
  ctx: FunctionContext,
  stmt: ForInStatement,
  genExpr: (e: Expression, discardValue: boolean, ignoreAdaptations: boolean) => void,
  genStmt: (s: Statement) => void,
  genPatternBinding: (
    ctx: FunctionContext,
    pattern: Node,
    valueType: Type,
    loadValue: () => void
  ) => void
): void => {
  let iterableType = getNodeType(ctx, stmt.iterable);
  if (iterableType == null) {
    throw new Error("for-in iterable type is missing");
  }

  var resolvedIterableType = iterableType;
  if (iterableType is ArrayType) {
    let faClass = findPreludeClass(ctx, "FixedArray");
    if (faClass == null) {
      throw new Error("prelude FixedArray class not found");
    }
    let arrType = iterableType as ArrayType;
    let typeArgs = new Array<Type>();
    typeArgs.push(arrType.elementType);
    resolvedIterableType = instantiateClassType(faClass as ClassType, typeArgs);
  } else if (iterableType is ThisType) {
    if (ctx.wasmFunction.classType != null) {
      resolvedIterableType = ctx.wasmFunction.classType as ClassType;
    } else {
      throw new Error("ThisType found but wasmFunction has no classType");
    }
  } else if (iterableType is ClassType) {
    let ctVar = iterableType as ClassType;
    if (ctVar.name.length >= 5 && ctVar.name.sliceBytes(ctVar.name.length - 5, ctVar.name.length) == "_This") {
      if (ctx.wasmFunction.classType != null) {
        resolvedIterableType = ctx.wasmFunction.classType as ClassType;
      } else {
        throw new Error("Mixin synthetic class type found but wasmFunction has no classType");
      }
    }
  }

  var isFixedArray = false;
  var isArray = false;

  if (resolvedIterableType is ClassType) {
    let ct = resolvedIterableType as ClassType;
    var canonical = ct;
    while (canonical.genericSource != null) {
      canonical = canonical.genericSource as ClassType;
    }
    if (canonical.name == "FixedArray" || canonical.name == "ImmutableArray") {
      isFixedArray = true;
    } else if (canonical.name == "Array") {
      isArray = true;
    }
  }

  if (isFixedArray) {
    var elementType: Type | null = null;
    match (resolvedIterableType) {
      case ClassType as ct: {
        if (ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0) {
          elementType = (ct.typeArguments as Array<Type>)[0];
        }
      }
      case _: {}
    }
    if (elementType == null) {
      throw new Error("for-in: element type not found for FixedArray");
    }

    genExpr(stmt.iterable, false, true);

    let arrWasmType = typeToValTypeWithSub(ctx.wasm, resolvedIterableType, ctx.wasmFunction);
    let arrLocal = ctx.allocLocal(arrWasmType);
    ctx.emitter.emitLocalSet(arrLocal);

    ctx.emitter.emitLocalGet(arrLocal);
    ctx.emitter.emitArrayLen();
    let lenLocal = ctx.allocLocal(new ValTypeI32());
    ctx.emitter.emitLocalSet(lenLocal);

    let idxLocal = ctx.allocLocal(new ValTypeI32());
    ctx.emitter.emitI32Const(0);
    ctx.emitter.emitLocalSet(idxLocal);

    ctx.emitter.emitBlock(new ValTypeVoid()); // $break
    ctx.emitter.emitLoop(new ValTypeVoid()); // $loop_start

    ctx.emitter.emitLocalGet(idxLocal);
    ctx.emitter.emitLocalGet(lenLocal);
    ctx.emitter.emitI32GeS();
    ctx.emitter.emitBrIf(1);

    ctx.emitter.emitBlock(new ValTypeVoid()); // $continue_target

    let valType = typeToValTypeWithSub(ctx.wasm, resolvedIterableType, ctx.wasmFunction);
    let wasmArray = match (valType) {
      case ValTypeRefNull as refNull: {
        refNull.target as WasmArray
      }
      case ValTypeRef as refVal: {
        refVal.target as WasmArray
      }
      case _: {
        throw new Error("Expected array type for FixedArray/array looping");
      }
    };

    let loopElemType = elementType as Type;
    let loadElem = (): void => {
      ctx.emitter.emitLocalGet(arrLocal);
      ctx.emitter.emitLocalGet(idxLocal);
      ctx.emitter.emitArrayGet(wasmArray.index);
    };

    var patternNode = stmt.pattern;
    if (patternNode is BindingPattern) {
      patternNode = (patternNode as BindingPattern).pattern;
    }
    genPatternBinding(ctx, patternNode as Node, loopElemType, loadElem);

    let wasReachable = ctx.isReachable;
    ctx.enterForLoop();
    genStmt(stmt.body);
    ctx.exitLoop();

    ctx.isReachable = wasReachable;

    ctx.emitter.emitEnd(); // end $continue_target

    ctx.emitter.emitLocalGet(idxLocal);
    ctx.emitter.emitI32Const(1);
    ctx.emitter.emitI32Add();
    ctx.emitter.emitLocalSet(idxLocal);

    ctx.emitter.emitBr(0);
    ctx.emitter.emitEnd(); // end $loop_start
    ctx.emitter.emitEnd(); // end $break
    return;
  }

  if (isArray) {
    let ctVar = resolvedIterableType as ClassType;
    let cKey = getClassKey(ctVar);
    if (!ctx.wasm.classInfos.has(cKey)) {
      throw new Error("for-in: ClassInfo for Array not found");
    }
    let info = ctx.wasm.classInfos[cKey];

    let bufferMangledName = getClassPrivateFieldKey(cKey, "#buffer");
    let lengthMangledName = getClassPrivateFieldKey(cKey, "#length");
    var bufferFieldIndex = -1;
    var lengthFieldIndex = -1;
    var bufferFieldType: ValType | null = null;
    
    let structType = info.structType;
    for (var i = 0; i < structType.fields.length; i += 1) {
      let f = structType.fields[i];
      if (f.name != null) {
        let fName = f.name as String;
        if (fName == bufferMangledName) {
          bufferFieldIndex = i;
          bufferFieldType = f.type;
        } else if (fName == lengthMangledName) {
          lengthFieldIndex = i;
        }
      }
    }

    if (bufferFieldIndex == -1 || lengthFieldIndex == -1) {
      throw new Error("for-in: fields #buffer or #length not found on Array");
    }

    var elementType: Type | null = null;
    if (ctVar.typeArguments != null && (ctVar.typeArguments as Array<Type>).length > 0) {
      elementType = (ctVar.typeArguments as Array<Type>)[0];
    }
    if (elementType == null) {
      throw new Error("for-in: element type not found for Array");
    }

    let wasmArray = match (bufferFieldType as ValType) {
      case ValTypeRefNull as refNull: {
        refNull.target as WasmArray
      }
      case ValTypeRef as refVal: {
        refVal.target as WasmArray
      }
      case _: {
        throw new Error("Expected array type for Array::#buffer");
      }
    };

    genExpr(stmt.iterable, false, true);
    let arrWasmType = typeToValTypeWithSub(ctx.wasm, resolvedIterableType, ctx.wasmFunction);
    let arrLocal = ctx.allocLocal(arrWasmType);
    ctx.emitter.emitLocalSet(arrLocal);

    ctx.emitter.emitLocalGet(arrLocal);
    ctx.emitter.emitStructGet(structType.index, lengthFieldIndex);
    let lenLocal = ctx.allocLocal(new ValTypeI32());
    ctx.emitter.emitLocalSet(lenLocal);

    ctx.emitter.emitLocalGet(arrLocal);
    ctx.emitter.emitStructGet(structType.index, bufferFieldIndex);
    let bufLocal = ctx.allocLocal(bufferFieldType as ValType);
    ctx.emitter.emitLocalSet(bufLocal);

    let idxLocal = ctx.allocLocal(new ValTypeI32());
    ctx.emitter.emitI32Const(0);
    ctx.emitter.emitLocalSet(idxLocal);

    ctx.emitter.emitBlock(new ValTypeVoid()); // $break
    ctx.emitter.emitLoop(new ValTypeVoid()); // $loop_start

    ctx.emitter.emitLocalGet(idxLocal);
    ctx.emitter.emitLocalGet(lenLocal);
    ctx.emitter.emitI32GeS();
    ctx.emitter.emitBrIf(1);

    ctx.emitter.emitBlock(new ValTypeVoid()); // $continue_target

    let loopElemType = elementType as Type;
    let loadElem = (): void => {
      ctx.emitter.emitLocalGet(bufLocal);
      ctx.emitter.emitLocalGet(idxLocal);
      ctx.emitter.emitArrayGet(wasmArray.index);
    };

    var patternNode = stmt.pattern;
    if (patternNode is BindingPattern) {
      patternNode = (patternNode as BindingPattern).pattern;
    }
    genPatternBinding(ctx, patternNode as Node, loopElemType, loadElem);

    let wasReachable = ctx.isReachable;
    ctx.enterForLoop();
    genStmt(stmt.body);
    ctx.exitLoop();

    ctx.isReachable = wasReachable;

    ctx.emitter.emitEnd(); // end $continue_target

    ctx.emitter.emitLocalGet(idxLocal);
    ctx.emitter.emitI32Const(1);
    ctx.emitter.emitI32Add();
    ctx.emitter.emitLocalSet(idxLocal);

    ctx.emitter.emitBr(0);
    ctx.emitter.emitEnd(); // end $loop_start
    ctx.emitter.emitEnd(); // end $break
    return;
  }

  let iteratorIface = findPreludeInterface(ctx, "Iterator");
  if (iteratorIface == null) {
    throw new Error("prelude Iterator interface not found");
  }

  var isIterator = false;
  var iteratorType = iteratorIface as InterfaceType;

  if (resolvedIterableType is InterfaceType) {
    let itRef = resolvedIterableType as InterfaceType;
    if (itRef.name == "Iterator") {
      isIterator = true;
      iteratorType = itRef;
    }
  } else if (resolvedIterableType is ClassType) {
    let ctRef = resolvedIterableType as ClassType;
    let iteratorImpl = findImplementedInterfaceTransitive(ctRef, "Iterator");
    if (iteratorImpl != null) {
      isIterator = true;
      iteratorType = iteratorImpl as InterfaceType;
    }
  }

  let ignoreAdaptations = !isIterator && resolvedIterableType is ClassType;
  // 1. Generate iterable expression - pushes iterable/iterator on stack
  genExpr(stmt.iterable, false, ignoreAdaptations);

  var it: InterfaceType | null = null;
  if (!isIterator) {
    if (resolvedIterableType is ClassType) {
      var ct = resolvedIterableType as ClassType;
      if (ct.isMixinIntermediate || (ct.name.length >= 5 && ct.name.sliceBytes(ct.name.length - 5, ct.name.length) == "_This")) {
        if (ctx.wasmFunction.classType != null) {
          ct = ctx.wasmFunction.classType as ClassType;
        }
      }
      if (ctx.wasmFunction.classType != null) {
        let fct = ctx.wasmFunction.classType as ClassType;
        ct = substituteTypeParamsInClassContext(fct, ct) as ClassType;
      } else {
        ct = substituteTypeParamsInClassContext(ct, ct) as ClassType;
      }
      let cName = getClassKey(ct);
      let iterableIface = findPreludeInterface(ctx, "Iterable");
      if (iterableIface == null) {
        throw new Error("prelude Iterable interface not found");
      }
      var ifaceType = findImplementedInterfaceTransitive(ct, "Iterable");
      if (ifaceType == null) {
        ifaceType = substituteTypeParamsInClassContext(ct, iterableIface as InterfaceType) as InterfaceType;
      }
      it = ifaceType as InterfaceType;
      let iName = getInterfaceKey(it as InterfaceType);
      
      let key = getClassInterfaceKey(cName, iName);
      let vtableGlobalOpt = ctx.wasm.getClassInterfaceVTable(key);
      if (vtableGlobalOpt == null) {
        throw new Error("Interface vtable global not found for " + classInterfaceKeyToString(key));
      }
      let vtableGlobal = vtableGlobalOpt as WasmGlobal;
      
      ctx.emitter.emitGlobalGet(vtableGlobal.index);
      
      let fatPtrStruct = ctx.wasm.interfaceStructs[iName];
      ctx.emitter.emitStructNew(fatPtrStruct.index);
    } else if (resolvedIterableType is InterfaceType) {
      it = resolvedIterableType as InterfaceType;
    } else {
      let locStr = if (stmt.loc != null) {
        let span = stmt.loc as SourceLocation;
        " at " + ctx.wasmFunction.model.sourcePath + ":" + i32ToString(span.line) + ":" + i32ToString(span.column)
      } else {
        " in " + ctx.wasmFunction.model.sourcePath
      };
      throw new Error("Self-hosted compiler only supports for-in on InterfaceType and ClassType for now. Found: " + typeToString(resolvedIterableType) + locStr);
    }

    let iName = getInterfaceKey(it as InterfaceType);
    let vst = ctx.wasm.interfaceVTableStructs[iName];
    let fatPtr = ctx.wasm.interfaceStructs[iName];
    let targetName = ":iterator";
    
    var methodIndex = -1;
    for (var i = 0; i < vst.fields.length; i += 1) {
      if (vst.fields[i].name != null && (vst.fields[i].name as String) == targetName) {
        methodIndex = i;
      }
    }
    if (methodIndex == -1) {
      throw new Error("Method :iterator not found in interface vtable of " + (it as InterfaceType).name);
    }
    
    let scratchLocal = ctx.getStructScratchLocal(fatPtr);
    ctx.emitter.emitLocalTee(scratchLocal);
    ctx.emitter.emitStructGet(fatPtr.index, 0); // Get Instance
    
    ctx.emitter.emitLocalGet(scratchLocal);
    ctx.emitter.emitStructGet(fatPtr.index, 1); // Get VTable
    ctx.emitter.emitStructGet(vst.index, methodIndex); // Get function ref
    
    let sig = getInterfaceMemberSignature(ctx.wasm, it as InterfaceType, targetName);
    ctx.emitter.emitCallRef(sig.index);
  } else {
    // resolvedIterableType is already an Iterator
    if (resolvedIterableType is ClassType) {
      // Box the class reference on stack into the Iterator interface fat pointer
      var ct = resolvedIterableType as ClassType;
      if (ct.isMixinIntermediate || (ct.name.length >= 5 && ct.name.sliceBytes(ct.name.length - 5, ct.name.length) == "_This")) {
        if (ctx.wasmFunction.classType != null) {
          ct = ctx.wasmFunction.classType as ClassType;
        }
      }
      if (ctx.wasmFunction.classType != null) {
        let fct = ctx.wasmFunction.classType as ClassType;
        ct = substituteTypeParamsInClassContext(fct, ct) as ClassType;
      } else {
        ct = substituteTypeParamsInClassContext(ct, ct) as ClassType;
      }
      let cName = getClassKey(ct);
      let iName = getInterfaceKey(iteratorType);
      let key = getClassInterfaceKey(cName, iName);
      let vtableGlobalOpt = ctx.wasm.getClassInterfaceVTable(key);
      if (vtableGlobalOpt == null) {
        throw new Error("Interface vtable global not found for " + classInterfaceKeyToString(key));
      }
      let vtableGlobal = vtableGlobalOpt as WasmGlobal;
      ctx.emitter.emitGlobalGet(vtableGlobal.index);
      
      let fatPtrStruct = ctx.wasm.interfaceStructs[iName];
      ctx.emitter.emitStructNew(fatPtrStruct.index);
    }
  }

  if (it != null) {
    let mi = (it as InterfaceType).members[":iterator"] as MethodInfo;
    let ft = mi.type as FunctionType;
    let resolvedFt = substituteTypeParamsInCodegen(getInterfaceTypeParameters(it as InterfaceType), (it as InterfaceType).typeArguments, ft) as FunctionType;
    if (resolvedFt.returnType is InterfaceType) {
      iteratorType = resolvedFt.returnType as InterfaceType;
    }
  }

  // 2. Store the Iterator fat pointer in a local
  let iteratorFatPtr = ctx.wasm.interfaceStructs[getInterfaceKey(iteratorType)];
  let iterLocal = ctx.allocLocal(new ValTypeRefNull(iteratorFatPtr));
  ctx.emitter.emitLocalSet(iterLocal);

  // 3. Pre-declare temp locals for next() return values: (i32, element type)
  let boolTemp = ctx.allocLocal(new ValTypeI32());
  var elemWasmType: ValType = new ValTypeAnyRef();
  if (iteratorType.typeArguments != null && (iteratorType.typeArguments as Array<Type>).length > 0) {
    let elemType = (iteratorType.typeArguments as Array<Type>)[0];
    elemWasmType = typeToValTypeWithSub(ctx.wasm, elemType, ctx.wasmFunction);
  }
  let elemTemp = ctx.allocLocal(elemWasmType);

  // 4. Generate loop structure
  ctx.emitter.emitBlock(new ValTypeVoid());
  ctx.emitter.emitLoop(new ValTypeVoid());

  // Call iter.next()
  ctx.emitter.emitLocalGet(iterLocal);
  let iteratorKey = getInterfaceKey(iteratorType);
  let iterVst = ctx.wasm.interfaceVTableStructs[iteratorKey];
  let nextMethodName = "next";
  var nextMethodIndex = -1;
  for (var i = 0; i < iterVst.fields.length; i += 1) {
    if (iterVst.fields[i].name != null && (iterVst.fields[i].name as String) == nextMethodName) {
      nextMethodIndex = i;
    }
  }
  if (nextMethodIndex == -1) {
    throw new Error("Method next not found in Iterator vtable");
  }

  let iterScratch = ctx.getStructScratchLocal(iteratorFatPtr);
  ctx.emitter.emitLocalTee(iterScratch);
  ctx.emitter.emitStructGet(iteratorFatPtr.index, 0); // Get Instance
  
  ctx.emitter.emitLocalGet(iterScratch);
  ctx.emitter.emitStructGet(iteratorFatPtr.index, 1); // Get VTable
  ctx.emitter.emitStructGet(iterVst.index, nextMethodIndex); // Get next function ref
  
  let nextSig = getInterfaceMemberSignature(ctx.wasm, iteratorType, nextMethodName);
  ctx.emitter.emitCallRef(nextSig.index);

  // Store values (reverse order)
  ctx.emitter.emitLocalSet(elemTemp);
  ctx.emitter.emitLocalSet(boolTemp);

  // Check condition, break if false
  ctx.emitter.emitLocalGet(boolTemp);
  ctx.emitter.emitI32Eqz();
  ctx.emitter.emitBrIf(1); // break to outer block (depth 1)

  // 5. Bind pattern variable
  var patternNode = stmt.pattern;
  if (patternNode is BindingPattern) {
    patternNode = (patternNode as BindingPattern).pattern;
  }
  
  let loopElemType = getForInElementType(ctx, resolvedIterableType);
  let loadElem = (): void => {
    ctx.emitter.emitLocalGet(elemTemp);
    
    // Cast anyref to loopElemType at runtime (since elemTemp is anyref)
    let targetWasmType = typeToValTypeWithSub(ctx.wasm, loopElemType, ctx.wasmFunction);
    match (targetWasmType) {
      case ValTypeRefNull as refNull: {
        ctx.emitter.emitRefCast(refNull.target.index);
      }
      case ValTypeRef as refVal: {
        ctx.emitter.emitRefCast(refVal.target.index);
      }
      case _: {}
    }
  };
  
  genPatternBinding(ctx, patternNode as Node, loopElemType, loadElem);

  // 6. Generate loop body
  let wasReachable = ctx.isReachable;
  ctx.enterLoop();
  genStmt(stmt.body);
  ctx.exitLoop();

  ctx.isReachable = wasReachable;
  ctx.emitter.emitBr(0); // continue
  ctx.emitter.emitEnd(); // end loop
  ctx.emitter.emitEnd(); // end block
};
