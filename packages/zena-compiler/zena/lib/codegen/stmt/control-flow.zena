import { Error } from 'zena:error';
import { 
  Node, ReturnStatement, ExpressionStatement, IfStatement, Statement, Expression
} from '../../ast.zena';
import { VoidType } from '../../types.zena';
import { ValType } from "../wasm.zena";
import { FunctionContext } from '../function-context.zena';

export let generateReturnStatement = (ctx: FunctionContext, stmt: ReturnStatement, genExpr: (e: Expression) => void): void => {
  if (stmt.argument != null) {
    genExpr(stmt.argument as Expression);
  }
  ctx.emitter.emitReturn();
  ctx.isReachable = false;
  ctx.needsUnreachable = false;
};

export let generateExpressionStatement = (ctx: FunctionContext, stmt: ExpressionStatement, genExpr: (e: Expression) => void): void => {
  genExpr(stmt.expression);
  let exprType = ctx.wasmFunction.model.getNodeType(stmt.expression);
  if (!(exprType is VoidType)) {
    ctx.emitter.emitDrop();
  }
};

export let generateIfStatement = (ctx: FunctionContext, stmt: IfStatement, genExpr: (e: Expression) => void, genStmt: (s: Statement) => void): void => {
  genExpr(stmt.test as Expression);
  ctx.emitter.emitIf(ValType.void);
  ctx.enterBlockStructure();
  
  let wasReachable = ctx.isReachable;
  
  genStmt(stmt.consequent);
  let consReachable = ctx.isReachable;
  
  ctx.isReachable = wasReachable; // Reset for alternate definition
  if (stmt.alternate != null) {
    ctx.emitter.emitElse();
    genStmt(stmt.alternate as Statement);
    let altReachable = ctx.isReachable;
    ctx.isReachable = consReachable || altReachable;
    if (!ctx.isReachable) {
      ctx.needsUnreachable = true;
    }
  } else {
    // No alternate, so we just continue
    ctx.isReachable = true;
  }
  
  ctx.exitBlockStructure();
  ctx.emitter.emitEnd();
};
