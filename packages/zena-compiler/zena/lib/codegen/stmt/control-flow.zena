import { ValTypeVoid, ValType, ValTypeRefNull, ValTypeRef, ValTypeEqRef, ValTypeStructRef, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, HeapType, heapTypeToSigned, valTypeEquals, isWasmSubtype } from '../wasm.zena';
import { Error } from 'zena:error';
import { console } from 'zena:console';
import { 
  Node, ReturnStatement, ExpressionStatement, IfStatement, Statement, Expression,
  LetPatternCondition, TuplePattern, LiteralPattern, BooleanLiteral, NumberLiteral, StringLiteral, NullLiteral,
  IdentifierPattern, BindingPattern, Identifier
} from '../../ast.zena';
import { VoidType, Type, UnionType, InlineTupleType, baseType, HoleType, ClassType, F64Type, F32Type, I64Type, U64Type, isRefType, NullType } from '../../types.zena';
import { FunctionContext } from '../function-context.zena';
import { typeToValType, typeToValTypeWithSub, mapReturnTypeToWasmResults, getNodeType, substituteTypeParamsInFunctionContext, getExpressionType } from '../type-mapping.zena';
import { generatePatternBinding } from './bindings.zena';
import { Array } from 'zena:array';
import { InterfaceAdaptation, RecordAdaptation } from '../../semantic-model.zena';
import { Symbol } from '../../scope/symbol.zena';

export let generateValueReturn = (ctx: FunctionContext, arg: Expression, genExpr: (e: Expression, discardValue: boolean) => void): void => {
  genExpr(arg, false);

  let expectedReturns = ctx.wasmFunction.signature.returns;
  if (expectedReturns.length > 0) {
    let argType = getExpressionType(ctx, arg);
    if (argType != null) {
      var effectiveType = argType as Type;
      let interfaceAdaptation = ctx.wasmFunction.model.getInterfaceAdaptation(arg);
      if (interfaceAdaptation != null) {
        effectiveType = (interfaceAdaptation as InterfaceAdaptation).target as Type;
      } else {
        let recordAdaptation = ctx.wasmFunction.model.getRecordAdaptation(arg);
        if (recordAdaptation != null) {
          effectiveType = (recordAdaptation as RecordAdaptation).target as Type;
        }
      }

      effectiveType = substituteTypeParamsInFunctionContext(ctx.wasmFunction, effectiveType);

      let actualTypes = new Array<ValType>();
      mapReturnTypeToWasmResults(ctx.wasm, effectiveType, actualTypes);
      if (arg is Identifier && actualTypes.length == 1) {
        let idNode = arg as Identifier;
        let sym = ctx.wasmFunction.model.resolve(idNode);
        if (sym != null) {
          let rSym = (sym as Symbol).resolveTarget();
          let symId = if (ctx.localIndices.has((sym as Symbol).id)) (sym as Symbol).id else rSym.id;
          // Celled locals are stored as a Cell struct but generateIdentifier
          // reads THROUGH the cell, so the value on the stack has the
          // unboxed type — keep the checker-derived actual type for those.
          if (ctx.localIndices.has(symId) && !ctx.isCelled(symId)) {
            let localIndex = ctx.localIndices[symId];
            let paramCount = ctx.wasmFunction.signature.params.length;
            actualTypes[0] = if (localIndex < paramCount) {
              ctx.wasmFunction.signature.params[localIndex]
            } else {
              ctx.localTypes[localIndex - paramCount]
            };
          }
        }
      }

      if (argType is InlineTupleType) {
        let itt = argType as InlineTupleType;
        for (var i = 0; i < itt.elementTypes.length; i += 1) {
          if (i < expectedReturns.length && itt.elementTypes[i] is HoleType) {
            actualTypes[i] = expectedReturns[i];
          }
        }
      }

      if (actualTypes.length == expectedReturns.length) {
        var needsTemp = false;
        var i = 0;
        while (i < actualTypes.length) {
          let actual = actualTypes[i];
          let expected = expectedReturns[i];
          var itemNeedsCast = false;
          if (!isWasmSubtype(actual, expected)) {
            itemNeedsCast = true;
          }
          if (itemNeedsCast) {
            needsTemp = true;
            break;
          }
          i += 1;
        }

        if (needsTemp) {
          let tempLocals = new Array<i32>();
          var i = actualTypes.length - 1;
          while (i >= 0) {
            let actualType = actualTypes[i];
            let temp = ctx.allocLocal(actualType);
            tempLocals.push(temp);
            ctx.emitter.emitLocalSet(temp);
            i -= 1;
          }

          var j = 0;
          while (j < actualTypes.length) {
            let temp = tempLocals[actualTypes.length - 1 - j];
            let actual = actualTypes[j];
            let expected = expectedReturns[j];
            
            ctx.emitter.emitLocalGet(temp);

            match (expected) {
              case ValTypeRefNull as r: {
                if (!isWasmSubtype(actual, expected)) {
                  if (r.target.index >= 0) {
                    ctx.emitter.emitRefCastNull(r.target.index);
                  }
                }
              }
              case ValTypeRef as r: {
                if (!isWasmSubtype(actual, expected)) {
                  if (r.target.index >= 0) {
                    ctx.emitter.emitRefCast(r.target.index);
                  } else {
                    ctx.emitter.emitRefAsNonNull();
                  }
                }
              }
              case ValTypeEqRef: {
                if (!isWasmSubtype(actual, expected)) {
                  ctx.emitter.emitRefCastEqNull();
                }
              }
              case _: {
                if (actual is ValTypeRefNull && expected is ValTypeRef) {
                  ctx.emitter.emitRefAsNonNull();
                }
              }
            }

            j += 1;
          }
        }
      } else if (actualTypes.length < expectedReturns.length) {
        var k = actualTypes.length;
        while (k < expectedReturns.length) {
          let exp = expectedReturns[k];
          match (exp) {
            case ValTypeRefNull as r: {
              let idx = r.target.index;
              if (idx >= 0) {
                ctx.emitter.emitRefNull(idx);
              } else {
                ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.struct));
              }
            }
            case ValTypeStructRef: {
              ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.struct));
            }
            case ValTypeEqRef: {
              ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.eq));
            }
            case ValTypeI32: {
              ctx.emitter.emitI32Const(0);
            }
            case ValTypeI64: {
              ctx.emitter.emitI64Const(0 as i64);
            }
            case ValTypeF32: {
              ctx.emitter.emitF32Const(0.0);
            }
            case ValTypeF64: {
              ctx.emitter.emitF64Const(0.0);
            }
            case _: {
              ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.any));
            }
          }
          k += 1;
        }
      }
    }
  }
};

export let generateReturnStatement = (ctx: FunctionContext, stmt: ReturnStatement, genExpr: (e: Expression, discardValue: boolean) => void): void => {
  if (stmt.argument != null) {
    generateValueReturn(ctx, stmt.argument as Expression, genExpr);
  }
  ctx.emitter.emitReturn();
  ctx.isReachable = false;
  ctx.needsUnreachable = false;
};

export let generateExpressionStatement = (ctx: FunctionContext, stmt: ExpressionStatement, genExpr: (e: Expression, discardValue: boolean) => void): void => {
  genExpr(stmt.expression, true);
};

let getInlineTupleElementTypes = (t: Type): Array<Type> | null => {
  let b = baseType(t);
  if (b is InlineTupleType) {
    return (b as InlineTupleType).elementTypes;
  }
  if (b is UnionType) {
    let ut = b as UnionType;
    for (let t_i in ut.types) {
      let bt = baseType(t_i);
      if (bt is InlineTupleType) {
        return (bt as InlineTupleType).elementTypes;
      }
    }
  }
  return null;
};



export let generateLetPatternCheck = (
  ctx: FunctionContext,
  pattern: TuplePattern,
  tempLocals: Array<i32>,
  elemTypes: Array<Type>,
  genExpr: (e: Expression, d: boolean) => void
): void => {
  // Start with true (1)
  ctx.emitter.emitI32Const(1);
  
  for (var i = 0; i < pattern.elements.length; i += 1) {
    let el = pattern.elements[i];
    if (el == null) {
      continue;
    }
    
    let ep = el as Node;
    
    // Identifier patterns (wildcards or variable bindings) always match
    if (ep is IdentifierPattern) {
      continue;
    }
    if (ep is Identifier && (ep as Identifier).name == "_") {
      continue;
    }
    if (ep is Identifier) {
      continue;
    }
    
    // Boolean/Number/String/Null Literal pattern or LiteralPattern
    var isLiteral = false;
    var valueExpr: Expression | null = null;
    
    if (ep is LiteralPattern) {
      isLiteral = true;
      valueExpr = (ep as LiteralPattern).value;
    } else if (ep is BooleanLiteral || ep is NumberLiteral || ep is StringLiteral || ep is NullLiteral) {
      isLiteral = true;
      valueExpr = ep as Expression;
    }
    
    if (isLiteral && valueExpr != null) {
      let temp = tempLocals[i];
      ctx.emitter.emitLocalGet(temp);
      
      // Generate expected literal value
      genExpr(valueExpr as Expression, false);
      
      // Compare based on type
      let elType = baseType(elemTypes[i]);
      if (elType is F64Type) {
        ctx.emitter.emitF64Eq();
      } else if (elType is F32Type) {
        ctx.emitter.emitF32Eq();
      } else if (elType is I64Type || elType is U64Type) {
        ctx.emitter.emitI64Eq();
      } else if (isRefType(elType)) {
        ctx.emitter.emitRefEq();
      } else {
        // default to i32 comparison
        ctx.emitter.emitI32Eq();
      }
      
      ctx.emitter.emitI32And();
    }
  }
};

export let generateIfStatement = (ctx: FunctionContext, stmt: IfStatement, genExpr: (e: Expression, discardValue: boolean) => void, genStmt: (s: Statement) => void): void => {
  if (stmt.test is LetPatternCondition) {
    let lpc = stmt.test as LetPatternCondition;
    let pattern = lpc.pattern;
    if (pattern is TuplePattern) {
      let tp = pattern as TuplePattern;
      let initType = getNodeType(ctx, lpc.init);
      
      var baseT = baseType(initType as Type);
      var elementTypes: Array<Type> | null = null;
      if (baseT is InlineTupleType) {
        elementTypes = (baseT as InlineTupleType).elementTypes;
      } else if (baseT is UnionType) {
        for (let ut in (baseT as UnionType).types) {
          if (ut is InlineTupleType) {
            if (elementTypes == null) {
              elementTypes = (ut as InlineTupleType).elementTypes;
            }
          }
        }
      }
      
      if (elementTypes == null) {
        throw new Error("if-let expects inline tuple type");
      }
      let elemTypes = elementTypes as Array<Type>;
      
      // 1. Allocate temp locals (same types as tuple elements)
      let tempLocals = new Array<i32>();
      for (var i = 0; i < tp.elements.length; i += 1) {
        let elType = elemTypes[i];
        var valType = typeToValTypeWithSub(ctx.wasm, elType, ctx.wasmFunction);
        if (baseT is UnionType) {
          var hasHoleOrNull = false;
          for (let ut in (baseT as UnionType).types) {
            if (ut is InlineTupleType) {
              let tupleTypes = (ut as InlineTupleType).elementTypes;
              if (i < tupleTypes.length) {
                let t_i = tupleTypes[i];
                if (t_i is HoleType || t_i is NullType) {
                  hasHoleOrNull = true;
                }
              }
            }
          }
          if (hasHoleOrNull) {
            valType = match (valType) {
              case ValTypeRef as vr: new ValTypeRefNull(vr.target)
              case _: valType
            };
          }
        }
        let temp = ctx.allocLocal(valType);
        tempLocals.push(temp);
      }

      // 2. Evaluate init (pushes values on stack)
      genExpr(lpc.init, false);
      
      // 3. Pop to temp locals in reverse order
      for (var i = tp.elements.length - 1; i >= 0; i -= 1) {
        let temp = tempLocals[i];
        ctx.emitter.emitLocalSet(temp);
      }
      
      // 4. Emit condition (pattern check)
      generateLetPatternCheck(ctx, tp, tempLocals, elemTypes, genExpr);
      
      // 5. Emit WASM if block
      ctx.emitter.emitIf(new ValTypeVoid());
      ctx.enterBlockStructure();
      
      let wasReachable = ctx.isReachable;
      
      // 6. Bind pattern variables
      for (var i = 0; i < tp.elements.length; i += 1) {
        let el = tp.elements[i];
        if (el != null && !(el is LiteralPattern) && !(el is BooleanLiteral) && !(el is NumberLiteral) && !(el is StringLiteral) && !(el is NullLiteral)) {
          let tempIndex = tempLocals[i];
          let localOffset = tempIndex - ctx.wasmFunction.signature.params.length;
          let tempValType = ctx.localTypes[localOffset];
          let loadValue = (): void => {
            ctx.emitter.emitLocalGet(tempIndex);
            let targetValType = typeToValTypeWithSub(ctx.wasm, elemTypes[i], ctx.wasmFunction);
            if (!valTypeEquals(tempValType, targetValType)) {
              match (targetValType) {
                case ValTypeRef as tr: { ctx.emitter.emitRefCast(tr.target.index); }
                case _: {}
              }
            }
          };
          generatePatternBinding(ctx, el as Node, elemTypes[i], loadValue);
        }
      }
      
      // 6. Generate consequent
      genStmt(stmt.consequent);
      let consReachable = ctx.isReachable;
      
      ctx.isReachable = wasReachable;
      if (stmt.alternate != null) {
        ctx.emitter.emitElse();
        genStmt(stmt.alternate as Statement);
        let altReachable = ctx.isReachable;
        ctx.isReachable = consReachable || altReachable;
        if (!ctx.isReachable) {
          ctx.needsUnreachable = true;
        }
      } else {
        ctx.isReachable = true;
      }
      
      ctx.exitBlockStructure();
      ctx.emitter.emitEnd();
      return;
    }
  }

  // console.log("generateIfStatement called!");
  // if (stmt.alternate != null) {
  //   console.log("IfStatement has alternate block!");
  // }

  genExpr(stmt.test as Expression, false);
  ctx.emitter.emitIf(new ValTypeVoid());
  ctx.enterBlockStructure();
  
  let wasReachable = ctx.isReachable;
  
  genStmt(stmt.consequent);
  let consReachable = ctx.isReachable;
  
  ctx.isReachable = wasReachable; // Reset for alternate definition
  if (stmt.alternate != null) {
    ctx.emitter.emitElse();
    // console.log("Compiling alternate. ctx.isReachable =");
    // console.log(if (ctx.isReachable) "true" else "false");
    genStmt(stmt.alternate as Statement);
    // console.log("After compiling alternate. ctx.isReachable =");
    // console.log(if (ctx.isReachable) "true" else "false");
    let altReachable = ctx.isReachable;
    ctx.isReachable = consReachable || altReachable;
    if (!ctx.isReachable) {
      ctx.needsUnreachable = true;
    }
  } else {
    // No alternate, so we just continue
    ctx.isReachable = true;
  }
  
  ctx.exitBlockStructure();
  ctx.emitter.emitEnd();
};
