import { Error } from 'zena:error';
import { BlockStatement, Statement } from '../../ast.zena';
import { FunctionContext } from '../function-context.zena';

export let generateBlockStatement = (ctx: FunctionContext, stmt: BlockStatement, genStmt: (s: Statement) => void): void => {
  for (let s in stmt.body) {
    genStmt(s);
    if (!ctx.isReachable) {
      break; // Stop generating unreachable statements
    }
  }
};
