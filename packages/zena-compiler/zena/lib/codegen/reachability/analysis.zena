import { Program, CompilationUnit } from '../../program.zena';
import {
  WasmModule, WasmFunction, WasmSignature, WasmGlobal, WasmStruct, WasmField, WasmArray, VTableInit, ClassCodegenInfo,
} from '../wasm-module.zena';
import { SemanticModel, SymbolDependencies } from '../../semantic-model.zena';
import {
  Type, ClassType, InterfaceType, FunctionType, TypeId, makeTypeIdGenerator, TypeParameterType, MethodInfo, FieldInfo, isVoidOrNeverType, UnionType, TupleType, InlineTupleType, ArrayType, RecordType, TypeAliasType,
} from '../../types.zena';
import {
  Node, ClassDeclaration, InterfaceDeclaration, MixinDeclaration, MethodDefinition, AccessorDeclaration, FieldDefinition, VariableDeclaration, FunctionDeclaration, DeclareFunction, ImportDeclaration, IdentifierPattern, FunctionExpression, SealedVariant, SourceLocation, Module, Identifier, SymbolPropertyName, MemberExpression, CallExpression, ExportAllDeclaration, ExportFromDeclaration, IdGenerator, ShieldedStatement, TryExpression,
} from '../../ast.zena';
import { HashSet } from 'zena:set';
import { Array } from 'zena:array';
import { GrowableArray } from 'zena:growable-array';
import { OrderedMap } from 'zena:ordered-map';
import { StringBuilder } from 'zena:string-builder';
import {
  getClassKey, getInterfaceKey, getClassMethodKey, getInterfaceMemberKey, getClassInterfaceKey, getClassInterfaceVTableName, getClassVTableName, getClassSingletonName, getInterfaceTrampolineName, getSignatureKey, collectMixinMembers, mixinScopeOfMember, mixinModelOfMember, getClassPrivateFieldKey, MixinKey, getFunctionAdaptationKey, ClassKey, ClassMethodKey, getTypeUniqueKey, getClosureSpecializationKey, isConcrete, getSpecializedName, containsErasedType, isBoxablePrimitive,
} from '../codegen-utils.zena';
import {
  typeToValType, getClosureStruct, getInterfaceMemberSignature, mapReturnTypeToWasmResults, mapParamTypeToWasmParams, substituteTypeParamsInCodegen, getClassTypeParameters, getInterfaceTypeParameters, getCellStruct, substituteTypeParamsInClassContext,
} from '../type-mapping.zena';
import { SymbolId, Symbol, noSymbolId } from '../../scope/symbol.zena';
import {
  ValType, ValTypeI32, ValTypeRefNull, ValTypeAnyRef, ValTypeRef, ValTypeStructRef, WasmType, ValTypeFuncRef,
} from '../wasm.zena';
import { Referrer, ReachabilityContext, SpecializerInterface, TypeLowererInterface, ReachabilityVisitorInterface, ClassInterfacePair } from './context.zena';
import { ClassHierarchyAnalysis } from './hierarchy.zena';
import { Specializer, applyMixinPrivateScope } from './specialization.zena';
import { ReachabilityVisitor, TypeLowerer } from './visitor.zena';
import { walkEnter } from '../../visitor.zena';
import { performance } from '../../time.zena';
import { componentAbiModule } from '../component-emitter.zena';
import { targetEmitsComponent } from '../../targets.zena';
import { WellKnown, isWellKnown } from '../../well-known.zena';

final class ParsedMethodRef {
  classSymId: SymbolId;
  mName: String;
  new(this.classSymId, this.mName);
}

final class ParsedInterfaceMemberRef {
  ifaceSymId: SymbolId;
  mName: String;
  new(this.ifaceSymId, this.mName);
}

final class ParsedAdaptationRef {
  classSymId: SymbolId;
  ifaceSymId: SymbolId;
  new(this.classSymId, this.ifaceSymId);
}

let findDeclaringMixinIntermediate = (ct: ClassType, classDecls: HashMap<SymbolId, Node>, node: Node): ClassType | null => {
  var scWalk: ClassType | null = ct.superType;
  while (scWalk != null && scWalk.isMixinIntermediate) {
    let sc = scWalk;
    let scId = (sc.genericSource ?? sc).symbolId;
    if (classDecls.has(scId)) {
      let scDecl = classDecls[scId];
      if (scDecl is MixinDeclaration) {
        for (let m in (scDecl as MixinDeclaration).body) {
          if (m == node) {
            return sc;
          }
          if (m is AccessorDeclaration &&
              ((m as AccessorDeclaration).setter as Node) == node) {
            return sc;
          }
        }
      }
    }
    scWalk = sc.superType;
  }
  return null;
};

/**
 * ReachabilityAnalysis manages the whole-program reachability tracking,
 * driving queues of reachable functions/types and triggering monomorphization.
 */
export final class ReachabilityAnalysis implements ReachabilityContext {
  program: Program;
  wasm: WasmModule;
  target: String;

  var #chaBacking: ClassHierarchyAnalysis | null = null;
  var #specializerBacking: SpecializerInterface | null = null;
  var #typeLowererBacking: TypeLowererInterface | null = null;
  var #visitorBacking: ReachabilityVisitorInterface | null = null;

  cha: ClassHierarchyAnalysis {
    get { return this.#chaBacking as ClassHierarchyAnalysis; }
  }
  specializer: SpecializerInterface {
    get { return this.#specializerBacking as SpecializerInterface; }
  }
  typeLowerer: TypeLowererInterface {
    get { return this.#typeLowererBacking as TypeLowererInterface; }
  }
  visitor: ReachabilityVisitorInterface {
    get { return this.#visitorBacking as ReachabilityVisitorInterface; }
  }

  // Global lookups
  classDecls = new HashMap<SymbolId, Node>();
  classModels = new HashMap<SymbolId, SemanticModel>();
  interfaceDecls = new HashMap<SymbolId, InterfaceDeclaration>();
  interfaceModels = new HashMap<SymbolId, SemanticModel>();
  
  symbolIdToModel = new HashMap<SymbolId, SemanticModel>();
  symbolIdToDecl = new HashMap<SymbolId, Node>();
  symbolIdToTargetId = new HashMap<SymbolId, SymbolId>();

  nodeIdToNode = new HashMap<i32, Node>();
  nodeIdToModel = new HashMap<i32, SemanticModel>();
  
  // RTA Reachability tracking state
  reachedGlobals = new HashSet<SymbolId>();
  reachedMembers = new HashSet<String>();
  /**
   * Members traversed with `currentReachable` set, tracked apart from
   * `reachedMembers` for the same reason `queueReferrer` keeps
   * `reached` apart from `visited`: a checkable-phase traversal
   * discovers a member's dependencies without marking them reached, so
   * it must not satisfy a later reachable traversal of the same member.
   */
  reachedReachableMembers = new HashSet<String>();
  instantiatedClasses = new HashSet<SymbolId>();
  instantiatedSpecializedClasses = new HashSet<String>();
  reachablyNamedClasses = new HashSet<String>();
  /** See ReachabilityVisitor.noteEqualityUse. */
  var equalityDispatchUsed = false;
  /** Classes whose ==/hashCode slots were dropped while the equality
   * flag was false — repaired at settle if the flag flips late. */
  #eqPrunedClasses = new GrowableArray<ClassKey>();
  /**
   * Generic-source symbol ids of classes some DECLARED class extends —
   * built at init from every unit's class declarations (and sealed
   * variants, whose parent is extended by each case). A class can be
   * dispatched through its class vtable only if a value of a
   * supertype's static type can hold it: it has a superclass, or
   * something declared extends it. `String` and `FixedArray<T>` are
   * final with no superclass — nothing can virtually dispatch on them,
   * so their vtables need no slots beyond `==`/`hashCode` (which
   * HashMap and generic equality dispatch through the class vtable
   * even on hierarchy-less classes).
   */
  extendedClassSymbols = new HashSet<SymbolId>();
  /** Generic-source symbols with at least one `new` site; see queueExplicitCtor. */
  ctorDemandedGenerics = new HashSet<SymbolId>();
  /**
   * Members to reach BY MAP KEY at the settle point, once every
   * registration has happened: field accessors named before populate
   * creates them, synthesized case-class ==/hashCode (no AST node to
   * find), demanded constructors, and String.== for the by-name
   * lowering paths. While registration force-reached every method
   * this timing hole was invisible.
   */
  #pendingMemberReaches = new GrowableArray<ClassMethodKey>();
  reachablyNamedClosures = new HashSet<WasmStruct>();
  reachablyNamedAnonStructs = new HashSet<WasmStruct>();
  /**
   * Record/tuple SEMANTIC types named in-queue, resolved to their
   * dispatch/struct at the settle point — resolving eagerly would call
   * typeToValType before nested dispatches exist. Insertion-ordered
   * array + key set: iteration order must not depend on Type.hashCode,
   * which is a process-global uid (the batch-nondeterminism bug).
   */
  #namedCompositeTypes = new GrowableArray<Type>();
  #namedCompositeKeys = new HashSet<String>();

  /**
   * True only while a queue referrer is being processed —
   * currentReachable is accurately set per referrer there, and there
   * alone. Everything else (init, layout, vtable passes, helper
   * ensures) runs with whatever the last referrer left behind, which
   * is exactly the ambient-phase hazard binary-size.md documents.
   * Naming evidence is only collected when this is true.
   */
  var inQueueWalk = false;
  var suppressNameEvidence = false;
  /** See ReachabilityContext.layingOutUnemittedClass. */
  var layingOutUnemittedClass = false;

  /** See ReachabilityContext.walkingTemplateOf. */
  var walkingTemplateOf: ClassType | null = null;
  var isRtaActive = true;
  referencedInterfaceMembers = new HashSet<String>();
  referencedReachableInterfaceMembers = new HashSet<String>();
  discoveredTypes = new HashSet<String>();
  reachedSemanticTypes = new HashSet<String>();
  specializedInterfaces = new GrowableArray<InterfaceType>();
  specializedClassTypes = new HashMap<SymbolId, GrowableArray<ClassType>>();
  reachedClassMembers = new HashMap<SymbolId, OrderedMap<i32, boolean>>();
  reachedReachableClassMembers = new HashMap<SymbolId, OrderedMap<i32, boolean>>();

  // Tracks for interface dispatches: which instantiated classes implement an interface
  instantiatedClassesByInterface = new HashMap<SymbolId, GrowableArray<ClassInterfacePair>>();
  referencedInterfaceMembersById = new HashMap<SymbolId, GrowableArray<String>>();

  var mixinToClasses = new HashMap<MixinKey, GrowableArray<ClassType>>();
  #preludeClassCache = new HashMap<String, ClassType>();
  #preludeInterfaceCache = new HashMap<String, InterfaceType>();

  reachableQueue = new GrowableArray<Referrer>();
  checkableQueue = new GrowableArray<Referrer>();
  var reachHead = 0;
  var checkHead = 0;
  var globalsHead = 0;
  visited = new HashSet<String>();
  reached = new HashSet<String>();

  reachedFunctionsSet = new HashSet<WasmFunction>();
  reachedTypesSet = new HashSet<WasmType>();
  emittedTypes = new GrowableArray<WasmType>();

  /**
   * Cell structs interned for `try`-body-assigned locals. Closure cells
   * reach the type section through their context struct's field type;
   * these have no such referrer — only the lowered body's struct.new —
   * so layout roots them explicitly.
   */
  tryCellStructs = new GrowableArray<WasmStruct>();

  /**
   * Interfaces something is actually packed into — recorded when a
   * class-interface vtable global is built. Their fat-pointer and
   * vtable structs are referenced from lowered pack sites, which run
   * after layout and so are invisible to signature-driven type
   * reachability, exactly like closure structs.
   */
  usedInterfaceTypes = new GrowableArray<InterfaceType>();

  /**
   * Set once struct layout begins. After that point a class that has
   * never been instantiated cannot become instantiated: Pass 1.05
   * populates every known class's struct exactly once, so a late
   * arrival would carry an empty layout and fail somewhere further on
   * — as `$stringCreate layout` and `operator dispatch` both did.
   * Closing it turns that into a named error at the point of the bug.
   */
  var instantiationClosed = false;

  var currentReachable = true;
  /** Whether a reached body can cause a cancellation (a call to
   * CancelScope's cancel, or to raiseCancellation from outside
   * zena:async) — the whole-program gate the async machinery is
   * emitted under. Aggregated from dependency records as bodies are
   * reached; `#activateCancellationMachinery` reacts to it at each
   * fixpoint juncture. */
  var cancellationPossible: boolean = false;
  /** Whether the machinery has been minted and queued. */
  var cancellationMachineryActive: boolean = false;
  /** Whether a reached body has a `for`-in through the Iterator
   * protocol — half of the generator-disposal gate. */
  var iteratorForInReached: boolean = false;
  /** Whether a reached body creates a generator — the other half. */
  var generatorReached: boolean = false;
  /** Every async function's frame Future instantiation, recorded so a
   * cause discovered late can still equip every frame. */
  asyncFrameFutures = new GrowableArray<Type>();
  asyncFrameFutureModels = new GrowableArray<SemanticModel>();

  /**
   * Mints the tag and queues the scope machinery for every recorded
   * async function, once, when a cancellation cause has been reached.
   * Called between queue drains: a cause can surface in any round,
   * and the machinery's own members never introduce one, so the
   * fixpoint still terminates.
   */
  activateCancellationMachinery(): void {
    if (this.cancellationMachineryActive || !this.cancellationPossible) {
      return;
    }
    if (!this.program.unitsByPath.has('zena:async')) {
      return;
    }
    this.cancellationMachineryActive = true;
    this.wasm.ensureCancellationInfra();
    this.wasm.scopeCancellationActive = true;
    var i = 0;
    while (i < this.asyncFrameFutures.length) {
      this.visitor.queueCancellationMachinery(
          this.asyncFrameFutures[i] as ClassType,
          this.asyncFrameFutureModels[i]);
      i += 1;
    }
  }

  /**
   * Opens the generator-disposal gate: a reached protocol `for`-in in
   * a program that also creates a generator means a loop may be
   * handed one and leave early. The tag is minted alone — disposal
   * raises and catches it entirely inside a generator's `next()`, so
   * none of the scope machinery is queued (`scopeCancellationActive`
   * stays with the causes gate). Called at the late-fixpoint juncture
   * because the exception-infra mint queues reaches that the next
   * drain must pick up; the split pass and the for-in lowering read
   * the flag after RTA.
   */
  activateGeneratorDisposal(): void {
    if (this.wasm.generatorDisposalActive ||
        !this.iteratorForInReached || !this.generatorReached) {
      return;
    }
    this.wasm.generatorDisposalActive = true;
    this.wasm.ensureCancellationInfra();
    // The for-in disposal finalizer is a full finally region: its
    // throw arm needs the exception infrastructure even in a program
    // that never throws.
    this.noteExceptionInfra(this.program.units[0].model);
  }


  parsedClassMethodRefs = new HashMap<String, ParsedMethodRef>();
  parsedInterfaceMemberRefs = new HashMap<String, ParsedInterfaceMemberRef>();
  parsedAdaptationRefs = new HashMap<String, ParsedAdaptationRef>();

  var typeIdGenerator = makeTypeIdGenerator(1);

  new(this.program, this.wasm, this.target = "zena-cli") {
    var idGen: IdGenerator<TypeId> | null = null;
    let {entryPoint} = program;
    if (entryPoint != null) {
      idGen = (entryPoint as CompilationUnit).model.typeIdGenerator;
    } else if (program.units.length > 0) {
      idGen = program.units[0].model.typeIdGenerator;
    }
    if (idGen != null) {
      this.typeIdGenerator = idGen;
    }

    this.#chaBacking = new ClassHierarchyAnalysis(this.program, this.instantiatedSpecializedClasses, this.wasm, this.classModels);
    this.#specializerBacking = new Specializer(this);
    this.#typeLowererBacking = new TypeLowerer(this);
    this.#visitorBacking = new ReachabilityVisitor(this);
  }

  recordReachedClassMember(classSymId: SymbolId, nodeId: i32, model: SemanticModel, isReachable: boolean): void {
    if (isReachable) {
      if (!this.reachedReachableClassMembers.has(classSymId)) {
        this.reachedReachableClassMembers[classSymId] = new OrderedMap<i32, boolean>();
      }
      let set = this.reachedReachableClassMembers[classSymId];
      if (!set.has(nodeId)) {
        set[nodeId] = true;
        if (let (true, specList) = this.specializedClassTypes.get(classSymId)) {
          for (let specCt in specList) {
            this.queueReferrer(new Referrer(false, noSymbolId, nodeId, model, specCt, true));
          }
        }
      }
    } else {
      if (!this.reachedClassMembers.has(classSymId)) {
        this.reachedClassMembers[classSymId] = new OrderedMap<i32, boolean>();
      }
      let set = this.reachedClassMembers[classSymId];
      if (!set.has(nodeId)) {
        set[nodeId] = true;
        if (let (true, specList) = this.specializedClassTypes.get(classSymId)) {
          for (let specCt in specList) {
            this.queueReferrer(new Referrer(false, noSymbolId, nodeId, model, specCt, false));
          }
        }
      }
    }
  }

  /**
   * Record a concrete specialization of a generic class, and fan the
   * members already reached on the generic out over it.
   *
   * This is the register of specializations the program asks for. It
   * is what carries a member reached on the template to every
   * specialization, and what `instantiateClassType` walks to
   * instantiate a generic's siblings, so a specialization listed here
   * is one the module will emit. Discovery lists a mention; a mention
   * from a class nothing reaches is not listed, and instantiation
   * lists whatever it instantiates — so a specialization that becomes
   * real after being passed over still arrives.
   */
  noteSpecialization(ct: ClassType, model: SemanticModel): void {
    let lookupId = (ct.genericSource ?? ct).symbolId;
    if (!this.specializedClassTypes.has(lookupId)) {
      this.specializedClassTypes[lookupId] = new GrowableArray<ClassType>();
    }
    let list = this.specializedClassTypes[lookupId];
    let ctKey = getClassKey(ct);
    for (let existing in list) {
      if (getClassKey(existing) == ctKey) { return; }
    }
    list.push(ct);
    if (let (true, reachedSet) = this.reachedClassMembers.get(lookupId)) {
      let rcKeys = reachedSet.keys();
      while (let (true, nid) = rcKeys.next()) {
        this.queueReferrer(new Referrer(false, noSymbolId, nid, model, ct, this.currentReachable));
      }
    }
    if (this.currentReachable) {
      if (let (true, reachedSet) = this.reachedReachableClassMembers.get(lookupId)) {
        let rrKeys = reachedSet.keys();
        while (let (true, nid) = rrKeys.next()) {
          this.queueReferrer(new Referrer(false, noSymbolId, nid, model, ct, true));
        }
      }
    }
  }

  queueReferrer(ref: Referrer): void {
    var suffix = if (ref.classType != null) "@" + (getClassKey(ref.classType as ClassType) as String) else "";
    let {typeArguments} = ref;
    if (typeArguments != null) {
      suffix += "<" + getSpecializedName("", typeArguments) + ">";
    }
    let key = (if (ref.isSymbol) "sym:" + i32ToString(ref.symId as i32) else "node:" + i32ToString(ref.nodeId)) + suffix;



    if (ref.isReachable) {
      if (!this.reached.has(key)) {
        this.reached.add(key);
        this.visited.add(key);
        this.reachableQueue.push(ref);
        if (!ref.isSymbol && ref.classType != null) {
          let ct = ref.classType as ClassType;
          // Only a referrer against the generic TEMPLATE is evidence
          // about every specialization. One against a concrete
          // specialization names its own, and fanning that out claims
          // `Array<i32>.push` is used because `Array<String>.push` is
          // — which emits a member on every instantiation as soon as
          // one of them uses it.
          if (!isConcrete(ct)) {
            let lookupId = (ct.genericSource ?? ct).symbolId;
            this.recordReachedClassMember(lookupId, ref.nodeId, ref.model, true);
          }
        }
      }
    } else {
      if (!this.visited.has(key)) {
        this.visited.add(key);
        this.checkableQueue.push(ref);
        if (!ref.isSymbol && ref.classType != null) {
          let ct = ref.classType as ClassType;
          if (!isConcrete(ct)) {
            let lookupId = (ct.genericSource ?? ct).symbolId;
            this.recordReachedClassMember(lookupId, ref.nodeId, ref.model, false);
          }
        }
      }
    }
  }

  /**
   * markFunctionReached regardless of the ambient phase flag. For
   * callers that KNOW the function will be emitted (a vtable of an
   * instantiated class references it), where checkable-phase gating
   * would leave an emitted body whose dependencies were never
   * traversed.
   */
  forceReachFunction(func: WasmFunction): void {
    let saved = this.currentReachable;
    this.currentReachable = true;
    this.markFunctionReached(func);
    this.currentReachable = saved;
  }

  markFunctionReached(func: WasmFunction): void {
    if (this.currentReachable) {
      if (!this.reachedFunctionsSet.has(func)) {
        // A STATIC is exempt: it takes no receiver and cannot name the
        // class's type parameters, so a copy on the template is a whole
        // function rather than half of one — `Holder.answer()` names it
        // with no way to spell arguments.
        if (func.classType != null && !isConcrete(func.classType as ClassType) &&
            !func.isStatic) {
          throw new Error("non-concrete function reached: " + (if (func.name != null) func.name as String else "<null>"));
        }



        this.reachedFunctionsSet.add(func);
        func.isReached = true;

        // A synthesized case-class == compares fields through the
        // equality diamond, which dispatches through class-vtable
        // ==/hashCode slots on erased fields. The eq/hash INTRINSICS
        // lower through the same diamond, whose string tier resolves
        // String.== by name.
        if (func.isCaseClassEq || func.isCaseClassHash ||
            (func.intrinsic != null &&
             ((func.intrinsic as String) == "eq" ||
              (func.intrinsic as String) == "hash"))) {
          this.equalityDispatchUsed = true;
          let {stringClass} = this.wasm;
          if (stringClass != null) {
            let sKey = getClassKey(stringClass);
            this.notePendingMemberReach(getClassMethodKey(sKey, "=="));
            this.notePendingMemberReach(getClassMethodKey(sKey, "hashCode"));
          }
        }
        if (!func.isImport) {
          this.wasm.addFunction(func);
        }
        this.markTypeReached(func.signature);

        // Reaching a linear-memory intrinsic means the module needs a
        // memory section (and the "memory" export). WASI targets get
        // this from registerWasiInfra, but the host target reaches
        // zena:memory only through user code — the compiler's own
        // time.zena, for the LSP — and previously emitted memory ops
        // with no declared memory (invalid wasm at instantiation).
        let {intrinsic} = func;
        if (intrinsic != null) {
          let iname = intrinsic;
          if (iname == 'memory.size' || iname == 'memory.grow' ||
              iname.contains('.load') || iname.contains('.store')) {
            this.wasm.ensureMemory();
          }
        }

        let {contextStruct} = func;
        if (contextStruct != null) {
          this.markTypeReached(contextStruct);
        }
        let {classType} = func;
        if (classType != null) {
          let ct = classType;
          let model = this.getClassModel(ct);

          this.specializer.instantiateClassType(ct, model);
        }
        let {node} = func;
        if (node != null) {
          let fnNode = node;
          this.nodeIdToNode[fnNode.id as i32] = fnNode;
          this.nodeIdToModel[fnNode.id as i32] = func.model;
          this.queueReferrer(new Referrer(
            false,
            noSymbolId,
            fnNode.id as i32,
            func.model,
            func.classType,
            this.currentReachable,
            func.typeArguments
          ));
        }
      }
    }
  }

  markTypeReached(t: WasmType | null): void {
    if (t == null) { return; }
    if (this.currentReachable) {
      if (t is WasmStruct) {

      }
      if (!this.reachedTypesSet.has(t)) {
        this.reachedTypesSet.add(t);
        this.emittedTypes.push(t);
      }
    }
  }

  markValTypeReached(vt: ValType): void {
    if (vt is ValTypeRefNull) {
      this.markTypeReached(vt.target);
    } else if (vt is ValTypeRef) {
      this.markTypeReached(vt.target);
    }
  }

  closeReachedTypes(): void {
    this.currentReachable = true;
    var head = 0;
    while (head < this.emittedTypes.length) {
      let t = this.emittedTypes[head];
      head += 1;
      
      if (t is WasmStruct) {
        for (let f in t.fields) {
          this.markValTypeReached(f.type);
        }
      } else if (t is WasmArray) {
        this.markValTypeReached(t.elementType);
      } else if (t is WasmSignature) {
        for (let p in t.params) {
          this.markValTypeReached(p);
        }
        for (let r in t.returns) {
          this.markValTypeReached(r);
        }
      }
    }
  }

  /**
   * Root `zena:component-abi`, the component target's string marshaling.
   *
   * Its functions are reached from nowhere inside the program: two of
   * them are called only by wrappers the compiler synthesizes after this
   * pass, and `realloc` is called only by the host, through the
   * lift's canonical options. So RTA has to be told, the same way
   * `zena:js` is.
   *
   * The gate is that a String actually crosses an export, which the root
   * loop above has just finished deciding — a component that moves no
   * strings links neither these nor the allocator behind them, and stays
   * as small as the timer components in binary-size_test. Only the
   * component target resolves this module at all, so no other target
   * reaches this branch with a unit to root.
   */
  #rootComponentAbi(): void {
    if (!this.wasm.componentMovesStrings) {
      return;
    }
    let prog = this.program;
    if (prog == null || !prog.unitsByPath.has(componentAbiModule)) {
      return;
    }
    let unit = prog.unitsByPath[componentAbiModule];
    let {model} = unit;
    let gKeys = model.globalDeclarations.keys();
    while (let (true, id) = gKeys.next()) {
      let decl = model.globalDeclarations[id];
      var isExported = false;
      if (decl is VariableDeclaration) {
        isExported = decl.exported;
      } else if (decl is FunctionDeclaration) {
        isExported = decl.exported;
      } else if (decl is DeclareFunction) {
        isExported = decl.exported;
      }
      if (isExported) {
        this.queueReferrer(new Referrer(true, id, -1, model, null, true));
      }
    }
  }

  /**
   * Root `zena:component-async`, the component target's async-import
   * driver — conditionally.
   *
   * Its `componentPoll`/`componentResume` are called only by the host,
   * through the callback-lifted entry, so nothing inside the program
   * references them and plain RTA would drop them. But rooting them
   * whenever the unit is linked would force the async entry — and its
   * `main(): void` requirement — onto every program that imports a WIT
   * interface *declaring* an async function and calls none of them,
   * because a synthesized WIT module always links the driver for its
   * wrappers. So the gate is that the program's own traversal, which
   * has just finished, reached `awaitPacked`: the one door into the
   * driver's registry. A program that never awaits an async-lowered
   * import keeps the synchronous lift.
   */
  #rootComponentAsyncDriver(): void {
    let driverPath = 'zena:component/async.zena';
    let prog = this.program;
    if (prog == null || !prog.unitsByPath.has(driverPath)) {
      return;
    }
    let awaitPacked = this.wasm.getStdlibFunc(driverPath, 'awaitPacked');
    if (awaitPacked == null || !(awaitPacked as WasmFunction).isReached) {
      return;
    }
    let unit = prog.unitsByPath[driverPath];
    let {model} = unit;
    let gKeys = model.globalDeclarations.keys();
    while (let (true, id) = gKeys.next()) {
      let decl = model.globalDeclarations[id];
      var isExported = false;
      if (decl is VariableDeclaration) {
        isExported = decl.exported;
      } else if (decl is FunctionDeclaration) {
        isExported = decl.exported;
      } else if (decl is DeclareFunction) {
        isExported = decl.exported;
      }
      if (isExported) {
        this.queueReferrer(new Referrer(true, id, -1, model, null, true));
      }
    }
    // The abi rooting above queues before the main drain; this one runs
    // after it, so it drains what it queued.
    this.processQueues();
  }

  #linkSuperAndVT(ct: ClassType, model: SemanticModel, linkedClasses: HashMap<ClassKey, boolean>): void {
    let ctKey = getClassKey(ct);
    if (linkedClasses.has(ctKey)) { return; }
    linkedClasses[ctKey] = true;
    
    let {superType} = ct;
    if (superType != null) {
      let superCt = superType;
      this.typeLowerer.discoverType(superCt, model);
      this.#linkSuperAndVT(superCt, model, linkedClasses);
      
      let cKey = getClassKey(ct);
      let superKey = getClassKey(superCt);
      
      if (let (true, info) = this.wasm.classInfos.get(cKey)) {
        if (let (true, superInfo) = this.wasm.classInfos.get(superKey)) {
          info.structType.superStruct = superInfo.structType;
          superInfo.subclasses.push(info);
          let {vtableStructType} = info;
          if (vtableStructType != null && superInfo.vtableStructType != null) {
            let vst = vtableStructType;
            let superVst = superInfo.vtableStructType as WasmStruct;
            vst.superStruct = superVst;
          }
        }
      }
      
      let ctVtable = this.wasm.classVtable(cKey);
      let superVtable = this.wasm.classVtable(superKey);
      if (superVtable.length > 0 || ctVtable.length > 0) {
        let newVTable = new GrowableArray<String>();
        let seen = new HashSet<String>();
        for (let methName in superVtable) {
          newVTable.push(methName);
          seen.add(methName);
        }
        for (let methName in ctVtable) {
          if (!seen.has(methName)) {
            newVTable.push(methName);
            seen.add(methName);
          }
        }
        while (ctVtable.length > 0) {
          ctVtable.pop();
        }
        for (let m in newVTable) {
          ctVtable.push(m);
        }
      }
    }
  }

  /**
   * Whether anything so far says a value of this class, or a mention of
   * its struct, can appear in the emitted module — the same question
   * the type section is rooted from in `run`, asked earlier.
   *
   * A `Box<prim>` specialization counts once registered, for the reason
   * the type-section root gives: the erased-`==` diamond ref_tests
   * every registered one, with no AST naming it.
   */
  #classHasEmissionEvidence(ct: ClassType): boolean {
    let cKeyStr = getClassKey(ct) as String;
    if (this.instantiatedSpecializedClasses.has(cKeyStr) ||
        this.reachablyNamedClasses.has(cKeyStr)) {
      return true;
    }
    let {boxClass} = this.wasm;
    if (boxClass != null && isConcrete(ct) &&
        (ct.genericSource ?? ct).symbolId == boxClass.symbolId) {
      let {typeArguments} = ct;
      if (typeArguments != null && typeArguments.length == 1 &&
          isBoxablePrimitive(typeArguments[0])) {
        return true;
      }
    }
    return false;
  }

  #populateClassStruct(ct: ClassType, populated: HashMap<ClassKey, boolean>): void {
    let key = getClassKey(ct);
    if (populated.has(key)) { return; }
    let {superType} = ct;
    if (superType != null) {
      this.#populateClassStruct(superType, populated);
    }
    populated[key] = true;
    let lookupId = (ct.genericSource ?? ct).symbolId;
    let cd: Node | null = if (this.classDecls.has(lookupId)) this.classDecls[lookupId] else null;
    let model = this.getClassModel(ct);
    // Every declared class is laid out, including the ones nothing
    // reaches: the layout is what registers a class's members, and a
    // class can pick up evidence after its turn here. But laying one
    // out is not evidence about the types its members' signatures
    // name. A field typed `Completer<i32>` on a class nothing reaches
    // used to specialize and emit `Completer<i32>` whole — all six of
    // its methods, plus the `Future<i32>` and `Box<i32>` they need —
    // whenever some other code had reached `Completer` at any type at
    // all. See docs/design/binary-size.md §18.
    let hasEvidence = this.#classHasEmissionEvidence(ct);
    let savedReachable = this.currentReachable;
    let savedLayingOut = this.layingOutUnemittedClass;
    if (!hasEvidence) {
      this.currentReachable = false;
      this.layingOutUnemittedClass = true;
    }
    this.specializer.populateClassStructAndMethods(ct, cd, model);
    this.currentReachable = savedReachable;
    this.layingOutUnemittedClass = savedLayingOut;
  }


  run(): void {
    let tInit = performance.start("codegen-discovery-init");
    // Pass 0: Register empty structs for all declared classes & interfaces to prevent cyclic dependencies
    for (let unit in this.program.units) {
      let {model} = unit;
      {
        // Populate class declarations and their members
        let classKeys = model.classDeclarations.keys();
        while (let (true, id) = classKeys.next()) {
          let classDecl = model.classDeclarations[id];
          this.nodeIdToNode[classDecl.id as i32] = classDecl;
          this.nodeIdToModel[classDecl.id as i32] = model;
          for (let member in classDecl.body) {
            this.nodeIdToNode[member.id as i32] = member;
            this.nodeIdToModel[member.id as i32] = model;
          }
        }

        // Populate interface declarations and their members
        let interfaceKeys = model.interfaceDeclarations.keys();
        while (let (true, id) = interfaceKeys.next()) {
          let ifaceDecl = model.interfaceDeclarations[id];
          this.nodeIdToNode[ifaceDecl.id as i32] = ifaceDecl;
          this.nodeIdToModel[ifaceDecl.id as i32] = model;
          for (let member in ifaceDecl.body) {
            this.nodeIdToNode[member.id as i32] = member;
            this.nodeIdToModel[member.id as i32] = model;
          }
        }

        // Populate mixin declarations and their members
        let mixinKeys = model.mixinDeclarations.keys();
        while (let (true, id) = mixinKeys.next()) {
          let mixinDecl = model.mixinDeclarations[id];
          this.classDecls[id] = mixinDecl;
          this.classModels[id] = model;
          this.symbolIdToDecl[id] = mixinDecl;
          this.symbolIdToModel[id] = model;
          this.nodeIdToNode[mixinDecl.id as i32] = mixinDecl;
          this.nodeIdToModel[mixinDecl.id as i32] = model;
          for (let member in mixinDecl.body) {
            this.nodeIdToNode[member.id as i32] = member;
            this.nodeIdToModel[member.id as i32] = model;
          }
        }

        // Populate global declarations
        let globalKeys = model.globalDeclarations.keys();
        while (let (true, id) = globalKeys.next()) {
          let decl = model.globalDeclarations[id];
          this.nodeIdToNode[decl.id as i32] = decl;
          this.nodeIdToModel[decl.id as i32] = model;
        }
      }
      
      // Classes
      let classKeys = model.classDeclarations.keys();
      while (let (true, id) = classKeys.next()) {
        let classDecl = model.classDeclarations[id];
        this.classDecls[id] = classDecl;
        this.classModels[id] = model;
        this.symbolIdToModel[id] = model;
        this.symbolIdToDecl[id] = classDecl;

        let rawClassType = this.getClassDeclType(classDecl, model);
        if (rawClassType != null) {
          let classType = rawClassType;
          let {superType} = classType;
          if (superType != null) {
            let superCt = superType;
            this.extendedClassSymbols.add((superCt.genericSource ?? superCt).symbolId);
          }
          if (classDecl.isSealed && classDecl.sealedVariants != null &&
              (classDecl.sealedVariants as GrowableArray<SealedVariant>).length > 0) {
            this.extendedClassSymbols.add((classType.genericSource ?? classType).symbolId);
          }
          if (isWellKnown(WellKnown.StringClass, classType.name,
              classType.sourcePath)) {
            this.wasm.stringClass = classType;
          } else if (isWellKnown(WellKnown.TemplateStringsArrayClass,
              classType.name, classType.sourcePath)) {
            this.wasm.templateStringsArrayClass = classType;
          } else if (isWellKnown(WellKnown.BoxClass, classType.name,
              classType.sourcePath)) {
            this.wasm.boxClass = classType;
          }
          var ctWalk: ClassType | null = classType;
          while (ctWalk != null) {
            let currCt = ctWalk;
            let cKey = getClassKey(currCt);
            if (!this.wasm.classInfos.has(cKey)) {
              let emptyStruct = new WasmStruct(currCt.name, new GrowableArray<WasmField>());
              emptyStruct.classType = currCt;
              if (!currCt.isExtension) {
                this.wasm.types.push(emptyStruct);
              }
              let info = new ClassCodegenInfo(emptyStruct);
              this.wasm.classInfos[cKey] = info;
              
              let emptyVTableStruct = new WasmStruct(currCt.name + "_VTable", new GrowableArray<WasmField>());
              emptyVTableStruct.classType = currCt;
              if (!currCt.isExtension) {
                this.wasm.types.push(emptyVTableStruct);
              }
              info.vtableStructType = emptyVTableStruct;
            }
            ctWalk = currCt.superType;
          }
        }
        
        if (classDecl.isSealed && classDecl.sealedVariants != null) {
          let variants = classDecl.sealedVariants as GrowableArray<SealedVariant>;
          for (let variant in variants) {
            let variantSym = model.resolve(variant);
            if (variantSym != null) {
              let vId = variantSym.id;
              if (!this.classDecls.has(vId) || !(this.classDecls[vId] is ClassDeclaration)) {
                this.classDecls[vId] = variant;
                this.classModels[vId] = model;
                this.symbolIdToDecl[vId] = variant;
              }
              this.symbolIdToModel[vId] = model;

              let rawVariantType = model.getNodeType(variant);
              if (rawVariantType is ClassType) {
                var vWalk: ClassType | null = rawVariantType;
                while (vWalk != null) {
                  let currV = vWalk;
                  let vKey = getClassKey(currV);
                  if (!this.wasm.classInfos.has(vKey)) {
                    let isIntermediate = currV.isMixinIntermediate;
                    let emptyStruct = new WasmStruct(currV.name, new GrowableArray<WasmField>());
                    emptyStruct.classType = currV;
                    if (!currV.isExtension && !isIntermediate) {
                      this.wasm.types.push(emptyStruct);
                    }
                    let info = new ClassCodegenInfo(emptyStruct);
                    this.wasm.classInfos[vKey] = info;
                    
                    let emptyVTableStruct = new WasmStruct(currV.name + "_VTable", new GrowableArray<WasmField>());
                    emptyVTableStruct.classType = currV;
                    if (!currV.isExtension && !isIntermediate) {
                      this.wasm.types.push(emptyVTableStruct);
                    }
                    info.vtableStructType = emptyVTableStruct;
                  }
                  vWalk = currV.superType;
                }
              }
            }
          }
        }
      }

      // Interfaces
      let interfaceKeys = model.interfaceDeclarations.keys();
      while (let (true, id) = interfaceKeys.next()) {
        let ifaceDecl = model.interfaceDeclarations[id];
        this.interfaceDecls[id] = ifaceDecl;
        this.interfaceModels[id] = model;
        this.symbolIdToModel[id] = model;
        this.symbolIdToDecl[id] = ifaceDecl;

        let ifaceType = model.getNodeType(ifaceDecl) as InterfaceType;

        let iKey = getInterfaceKey(ifaceType);
        if (!this.wasm.interfaceStructs.has(iKey)) {
          let emptyVTableStruct = new WasmStruct(ifaceType.name + "_VTable", new GrowableArray<WasmField>());
          this.wasm.types.push(emptyVTableStruct);
          this.wasm.interfaceVTableStructs[iKey] = emptyVTableStruct;

          let fatPtrFields = new GrowableArray<WasmField>();
          fatPtrFields.push(new WasmField("instance", new ValTypeAnyRef(), false));
          fatPtrFields.push(new WasmField("vtable", new ValTypeRef(emptyVTableStruct), false));
          let emptyStruct = new WasmStruct(ifaceType.name + "_FatPtr", fatPtrFields);
          this.wasm.types.push(emptyStruct);
          this.wasm.interfaceStructs[iKey] = emptyStruct;
        }
      }

      // Mixins
      let mixinKeys = model.mixinDeclarations.keys();
      while (let (true, id) = mixinKeys.next()) {
        let mixinDecl = model.mixinDeclarations[id];
        this.classDecls[id] = mixinDecl;
        this.classModels[id] = model;
        this.symbolIdToModel[id] = model;
        this.symbolIdToDecl[id] = mixinDecl;
      }

      // Enums
      let enumKeys = model.enumDeclarations.keys();
      while (let (true, id) = enumKeys.next()) {
        this.symbolIdToModel[id] = model;
        this.symbolIdToDecl[id] = model.enumDeclarations[id];
      }

      // Globals
      let globalKeys = model.globalDeclarations.keys();
      while (let (true, id) = globalKeys.next()) {
        this.symbolIdToModel[id] = model;
        this.symbolIdToDecl[id] = model.globalDeclarations[id];
        
        let decl = model.globalDeclarations[id];
        // Both `let f = <T>() => ...` and `function f<T>() { ... }` bind a
        // FunctionExpression; either can be generic.
        var initNode: Node | null = null;
        if (decl is VariableDeclaration) {
          initNode = decl.init;
        } else if (decl is FunctionDeclaration) {
          initNode = decl.func;
        }
        if (initNode is FunctionExpression) {
          let funcTypeNode = model.getNodeType(initNode);
          if (funcTypeNode is FunctionType) {
            let hasParams = funcTypeNode.typeParameters != null;
            let {typeParameters} = funcTypeNode;
            let len = if (typeParameters != null) typeParameters.length else 0;
            if (hasParams && len > 0) {
              this.wasm.genericFunctions[id] = initNode;
              this.wasm.genericFunctionModels[id] = model;
            }
          }
        }
      }
    }

    // The `$string*` four are host-interop exports letting an embedder
    // build and read a guest String. Creating them here rooted String's
    // constructor — and so the entire class — in every program, and
    // their bodies are synthesized against String's struct layout, so
    // they cannot exist for a module with no String at all. They are
    // created from ensureAllHelperFunctionsReached instead, once RTA
    // knows whether String was instantiated.
    if (this.wasm.stringClass != null && this.wasm.stringLiterals.size > 0) {
      this.wasm.ensureStringHelpers(this.program.units[0].model);
      this.wasm.ensureStringLiteralHelpers(this.program.units[0].model);
      this.markFunctionReached(this.wasm.stringFromSharedFunc as WasmFunction);
      this.markFunctionReached(this.wasm.getStringLiteralFunc as WasmFunction);
    }

    // Populate mixinToClasses mapping
    this.mixinToClasses = new HashMap<MixinKey, GrowableArray<ClassType>>();
    for (let unit in this.program.units) {
      let {model} = unit;
      let classKeys = model.classDeclarations.keys();
      while (let (true, id) = classKeys.next()) {
        let classDecl = model.classDeclarations[id];
        let rawClassType = this.getClassDeclType(classDecl, model);
        if (rawClassType != null) {
          let mixinMembers = new GrowableArray<Node>();
          let seenMixins = new HashMap<MixinKey, boolean>();
          collectMixinMembers(this.program, model, classDecl.mixins, mixinMembers, seenMixins);
          let mKeys = seenMixins.keys();
          while (let (true, mixKey) = mKeys.next()) {
            if (!this.mixinToClasses.has(mixKey)) {
              this.mixinToClasses[mixKey] = new GrowableArray<ClassType>();
            }
            this.mixinToClasses[mixKey].push(rawClassType);
          }
        }
      }
    }

    // Process all import declarations upfront for namespace objects and their closure trampolines
    for (let unit in this.program.units) {
      let mod = unit.ast;
      let {model} = unit;
      for (let stmt in mod.body) {
        if (stmt is ImportDeclaration) {
          this.visitor.discoverImportDeclaration(stmt, model);
        }
      }
    }

    // RTA Roots
    for (let unit in this.program.units) {
      let {model} = unit;
      let isEntry = this.program.entryPoint != null && unit.ast.path == (this.program.entryPoint as CompilationUnit).ast.path;
      // zena:js's exports are wasm exports too (async.md §4): the JS
      // host calls them to settle a future, so nothing inside the
      // program ever references them and RTA would drop them. Rooting
      // them here rather than force-reaching a hardcoded list keeps the
      // gate exact — the unit only exists when the program imports the
      // module, so a program that does no host I/O links none of it.
      // `zena:component-async` is a host boundary in the same sense —
      // the component's event loop calls `componentPoll` and
      // `componentResume` from outside the program — but its exports
      // root conditionally, after the main traversal below: see
      // `#rootComponentAsyncDriver`.
      let isHostBoundary = unit.ast.path == 'zena:js/index.zena';
      // The root set is `main` plus the exports of those two units.
      // Every other unit is a library: its globals are roots only if
      // something reaches them. Queuing them all — which is what this
      // did — made the checkable traversal walk the entire stdlib, and
      // walking it instantiates.
      let rootsExports = isEntry || isHostBoundary;
      if (!rootsExports) {
        continue;
      }
      let gKeys = model.globalDeclarations.keys();
      while (let (true, id) = gKeys.next()) {
        let decl = model.globalDeclarations[id];
        var isExported = false;
        var isMain = false;
        
        if (decl is VariableDeclaration) {
          let isFunction = decl.init is FunctionExpression;
          isExported = rootsExports && (decl.exported || (isEntry && !isFunction));
          if (isEntry && decl.pattern is IdentifierPattern && (decl.pattern as IdentifierPattern).name == "main") {
            isMain = true;
          }
        } else if (decl is FunctionDeclaration) {
          isExported = rootsExports && decl.exported;
          if (isEntry && decl.name.name == "main") {
            isMain = true;
          }
        } else if (decl is DeclareFunction) {
          isExported = rootsExports && decl.exported;
        }
        
        if (isMain || isExported) {
          this.queueReferrer(new Referrer(true, id, -1, model, null, true));
          // An export whose type mentions String is boundary evidence
          // that a String VALUE can exist: the host is entitled to
          // build one with $stringCreate and hand it in, even if the
          // guest never constructs a string itself
          // (`export let identity = (s: String) => s;`).
          let {stringClass} = this.wasm;
          if (stringClass != null) {
            // The type hangs off different nodes per declaration kind;
            // a VariableDeclaration's own node carries none, its
            // pattern and init do.
            var declType = model.getNodeType(decl);
            if (declType == null && decl is VariableDeclaration) {
              declType = model.getNodeType(decl.pattern);
              if (declType == null && decl.init != null) {
                declType = model.getNodeType(decl.init as Node);
              }
            } else if (declType == null && decl is FunctionDeclaration) {
              declType = model.getNodeType(decl.func);
            }
            if (declType != null &&
                this.#typeMentionsString(declType, 0)) {
              let sClass = stringClass;
              this.specializer.instantiateClassType(
                  sClass, this.getClassModel(sClass));
              if (targetEmitsComponent(this.target)) {
                // A component's boundary is not the core module's. The
                // `$string*` four exist for an embedder holding the core
                // module directly, and nothing inside a component can
                // reach them — its strings cross through the canonical
                // ABI instead, which is `zena:component-abi`'s job and
                // wants a flag of its own.
                this.wasm.componentMovesStrings = true;
              } else if (declType is FunctionType) {
                // Which DIRECTION does the boundary move strings?
                // Export parameters are host-written, returns are
                // host-read; a non-function String export is both.
                for (let p in declType.parameters) {
                  if (this.#typeMentionsString(p, 0)) {
                    this.wasm.hostWritesStrings = true;
                  }
                }
                if (this.#typeMentionsString(declType.returnType, 0)) {
                  this.wasm.hostReadsStrings = true;
                }
              } else {
                this.wasm.hostWritesStrings = true;
                this.wasm.hostReadsStrings = true;
              }
            }
          }
        } else {
          this.queueReferrer(new Referrer(true, id, -1, model, null, false));
        }
      }

      let mod = unit.ast;
      for (let stmt in mod.body) {
        if (!(stmt is VariableDeclaration) && !(stmt is FunctionDeclaration) && !(stmt is DeclareFunction) && !(stmt is ClassDeclaration) && !(stmt is InterfaceDeclaration) && !(stmt is MixinDeclaration) && !(stmt is ImportDeclaration) && !(stmt is ExportAllDeclaration) && !(stmt is ExportFromDeclaration)) {
          this.nodeIdToNode[stmt.id as i32] = stmt;
          this.nodeIdToModel[stmt.id as i32] = model;
          this.queueReferrer(new Referrer(false, noSymbolId, stmt.id as i32, model, null, true));
        }
      }
    }

    // String is NOT instantiated here. Discovering the class — which
    // every program does, through the prelude — is not evidence that a
    // String value exists. A program that builds one reaches its
    // constructor through the normal graph, and a string literal
    // instantiates it below through the literal helpers.
    let {templateStringsArrayClass} = this.wasm;
    if (templateStringsArrayClass != null) {
      let tsaClass = templateStringsArrayClass;
      this.specializer.instantiateClassType(tsaClass, this.getClassModel(tsaClass));
    }

    this.#rootComponentAbi();

    this.ensureAllHelperFunctionsReached();

    performance.end(tInit);
    let tQueues = performance.start("codegen-discovery-queues");
    // Main reachability queue traversal
    this.processQueues();

    this.ensureAllHelperFunctionsReached();
    this.processQueues();

    this.#rootComponentAsyncDriver();
    performance.end(tQueues);
    let tLayout = performance.start("codegen-discovery-layout");

    // Pass 0.6: Link superStruct for inheritance and inherit vtable slots recursively
    let linkedClasses = new HashMap<ClassKey, boolean>();

    // Pre-discover implemented interfaces of all reached/specialized and declared classes.
    let classesToDiscover = new GrowableArray<ClassType>();
    for (let cPair in this.wasm.classInfos) {
      let info = cPair.value;
      let {classType} = info.structType;
      if (classType != null) {
        classesToDiscover.push(classType);
      }
    }
    for (let pair in this.classDecls) {
      let classDecl = pair.value;
      let moduleModel = this.classModels[pair.key];
      let ct = this.getClassDeclType(classDecl, moduleModel);
      if (ct != null) {
        classesToDiscover.push(ct);
      }
    }
    for (let ct in classesToDiscover) {
      let model = this.getClassModel(ct);
       let specIfaces = this.cha.collectAllImplementedInterfaces(ct);
       for (let iface in specIfaces) {
         this.typeLowerer.discoverType(iface, model);
      }
    }

    let classesToLink = new GrowableArray<ClassType>();
    for (let cPair in this.wasm.classInfos) {
      let info = cPair.value;
      let {classType} = info.structType;
      if (classType != null) {
        classesToLink.push(classType);
      }
    }
    for (let ct in classesToLink) {
      let model = this.getClassModel(ct);
      this.#linkSuperAndVT(ct, model, linkedClasses);
    }

    // Pass 0.8: Populate interface vtable fields
    // Each interface is paired with the model to resolve its member types in:
    // the declaring module's model for declared interfaces, the root unit's
    // model for specializations.
    let allInterfaces = new GrowableArray<(InterfaceType, SemanticModel)>();
    for (let pair in this.interfaceDecls) {
      let ifaceDecl = pair.value;
      let moduleModel = this.interfaceModels[pair.key];
      let ifaceType = moduleModel.getNodeType(ifaceDecl) as InterfaceType;
      allInterfaces.push((ifaceType, moduleModel));
    }
    for (let it in this.specializedInterfaces) {
      allInterfaces.push((it, this.program.units[0].model));
    }

    for (let ifaceEntry in allInterfaces) {
      let (it, ifaceModel) = ifaceEntry;
      let iName = getInterfaceKey(it);
      let vst = this.wasm.interfaceVTableStructs[iName];
      if (vst.fields.length > 0) {
        continue;
      }
      // Discover member types first so signatures resolve to concrete wasm
      // types. Without this, types not yet lowered fall back to structref in
      // the vtable field while the trampolines created later use the concrete
      // type, producing an invalid module.
      let itParams = getInterfaceTypeParameters(it);
      for (let mPair in it.members) {
        let resolvedType = substituteTypeParamsInCodegen(this.wasm, itParams, it.typeArguments, mPair.value.type);
        this.typeLowerer.discoverType(resolvedType, ifaceModel);
      }
      let keys = it.members.keys();
      while (let (true, key) = keys.next()) {
        let member = it.members[key];
        match (member) {
          case FieldInfo as fi: {
            let sig = getInterfaceMemberSignature(this.wasm, it, "get#" + key);
            vst.fields.push(new WasmField("get#" + key, new ValTypeRef(sig), false));
            if (fi.isMutable) {
              let sigSet = getInterfaceMemberSignature(this.wasm, it, "set#" + key);
              vst.fields.push(new WasmField("set#" + key, new ValTypeRef(sigSet), false));
            }
          }
          case MethodInfo as mi: {
            var isGeneric = false;
            if (mi.type is FunctionType) {
              let ft = mi.type as FunctionType;
              let {typeParameters} = ft;
              if (typeParameters != null && typeParameters.length > 0) {
                isGeneric = true;
              }
            }
            if (!isGeneric) {
              let sig = getInterfaceMemberSignature(this.wasm, it, key);
              vst.fields.push(new WasmField(key, new ValTypeRef(sig), false));
            }
          }
          case _: {}
        }
      }
    }

    // Pass 1.05: Unified recursive class struct and vtable fields
    // population (superclass first). Populating a class registers its
    // methods, which can instantiate further classes — so this runs to
    // a fixpoint, and only then is instantiation CLOSED. After that a
    // class that has never been instantiated cannot become
    // instantiated, because nothing would populate its struct: it
    // would carry an empty layout and fail much further downstream
    // (`$stringCreate layout`, `operator dispatch`) with nothing
    // pointing back here.
    let populated = new HashMap<ClassKey, boolean>();
    this.#layoutClassStructs(populated);

    // Pass 1.1: Synthesize physical field getters/setters for virtual/inherited slots
    for (let cPair in this.wasm.classInfos) {
      let cName = cPair.key;
      let cStruct = cPair.value.structType;
      let {classType} = cStruct;
      if (classType != null) {
        let cType = classType;
        for (let methName in this.wasm.classVtable(cName)) {
          if (methName.startsWith("get#")) {
            let fieldName = methName.sliceBytes(4, methName.length);
            var hasPhysical = false;
            var backingName = "";
            let lookupName = fieldName;
            let lookupPrivateName = getClassPrivateFieldKey(cName, fieldName);
            let lookupPrivateHashName = getClassPrivateFieldKey(cName, "#" + fieldName);
            for (let f in cStruct.fields) {
              let {name} = f;
              if (name != null) {
                let fname = name;
                if (fname == lookupName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateHashName) {
                  hasPhysical = true;
                  backingName = "#" + fieldName;
                } else if (fname.endsWith("::" + fieldName)) {
                  hasPhysical = true;
                  backingName = fieldName;
                } else if (fname.endsWith("::#" + fieldName)) {
                  hasPhysical = true;
                  backingName = "#" + fieldName;
                }
              }
            }
            if (hasPhysical) {
              let hasGetter = this.wasm.classMethodMap.has(getClassMethodKey(getClassKey(cType), methName));
              if (!hasGetter) {
                this.specializer.registerClassMethod(cType, null, methName, null, true, false, backingName, this.program.units[0].model, null);
              }
            }
          } else if (methName.startsWith("set#")) {
            let fieldName = methName.sliceBytes(4, methName.length);
            var hasPhysical = false;
            var backingName = "";
            let lookupName = fieldName;
            let lookupPrivateName = getClassPrivateFieldKey(cName, fieldName);
            let lookupPrivateHashName = getClassPrivateFieldKey(cName, "#" + fieldName);
            for (let f in cStruct.fields) {
              let {name} = f;
              if (name != null) {
                let fname = name;
                if (fname == lookupName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateHashName) {
                  hasPhysical = true;
                  backingName = "#" + fieldName;
                } else if (fname.endsWith("::" + fieldName)) {
                  hasPhysical = true;
                  backingName = fieldName;
                } else if (fname.endsWith("::#" + fieldName)) {
                  hasPhysical = true;
                  backingName = "#" + fieldName;
                }
              }
            }
            if (hasPhysical) {
              let hasSetter = this.wasm.classMethodMap.has(getClassMethodKey(getClassKey(cType), methName));
              if (!hasSetter) {
                this.specializer.registerClassMethod(cType, null, methName, null, false, true, backingName, this.program.units[0].model, null);
              }
            }
          }
        }
      }
    }

    // Pass 1.15: Register any remaining vtable slots that haven't been registered yet (e.g. abstract fields/methods)
    for (let cPair in this.wasm.classInfos) {
      let cStruct = cPair.value.structType;
      let {classType} = cStruct;
      if (classType != null) {
        let cType = classType;
        for (let methName in this.wasm.classVtable(cPair.key)) {
          var hasImpl = false;
          var curr: ClassType | null = cType;
          while (curr != null) {
            let k = getClassMethodKey(getClassKey(curr), methName);
            if (this.wasm.classMethodMap.has(k)) {
              hasImpl = true;
              break;
            }
            curr = curr.superType;
          }
          if (!hasImpl) {
            let isGetter = methName.startsWith("get#");
            let isSetter = methName.startsWith("set#");
            let stub = this.specializer.registerClassMethod(cType, null, methName, null, isGetter, isSetter, null, this.program.units[0].model, null);
            stub.isVtableSlotStub = true;
          }
        }
      }
    }

    // Pass 1.2: Resolve indices for all synthesized getters and
    // setters — over every REGISTERED method, not `wasm.functions`.
    // Registration computes the backing index against the struct's
    // fields, which populate pushes only after its member walk, so an
    // early-registered getter carries -1 (an `unreachable` stub body)
    // until this fixes it up. While every registered method of an
    // instantiated class was force-reached, being in wasm.functions
    // was equivalent to being registered; with reaching driven by use,
    // a getter can be registered now and reached later.
    let synthFixups = new GrowableArray<WasmFunction>();
    for (let f in this.wasm.functions) {
      synthFixups.push(f);
    }
    for (let mPair in this.wasm.classMethods) {
      for (let f in mPair.value) {
        synthFixups.push(f);
      }
    }
    for (let f in synthFixups) {
      let {classType} = f;
      if (classType != null) {
        let cType = classType;
        if (!cType.isExtension) {
          let cKey = getClassKey(cType);
          if (let (true, info) = this.wasm.classInfos.get(cKey)) {
            let st = info.structType;
            let {methodName} = f;
            if (methodName != null) {
              let mName = methodName;
              if (mName.startsWith("get#")) {
                let fieldName = mName.sliceBytes(4, mName.length);
                let lookupName = fieldName;
                let lookupPrivateName = getClassPrivateFieldKey(cKey, fieldName);
                let lookupPrivateHashName = getClassPrivateFieldKey(cKey, "#" + fieldName);
                var foundIdx = -1;
                for (var fi = 0; fi < st.fields.length; fi += 1) {
                  let fname = st.fields[fi].name;
                  if (fname != null) {
                    if (fname == lookupName || fname == lookupPrivateName || fname == lookupPrivateHashName || fname.endsWith("::" + fieldName) || fname.endsWith("::#" + fieldName)) {
                      foundIdx = fi;
                      break;
                    }
                  }
                }
                f.getterStruct = st;
                f.getterFieldIndex = foundIdx;
              } else if (mName.startsWith("set#")) {
                let fieldName = mName.sliceBytes(4, mName.length);
                let lookupName = fieldName;
                let lookupPrivateName = getClassPrivateFieldKey(cKey, fieldName);
                let lookupPrivateHashName = getClassPrivateFieldKey(cKey, "#" + fieldName);
                var foundIdx = -1;
                for (var fi = 0; fi < st.fields.length; fi += 1) {
                  let fname = st.fields[fi].name;
                  if (fname != null) {
                    if (fname == lookupName || fname == lookupPrivateName || fname == lookupPrivateHashName || fname.endsWith("::" + fieldName) || fname.endsWith("::#" + fieldName)) {
                      foundIdx = fi;
                      break;
                    }
                  }
                }
                f.setterStruct = st;
                f.setterFieldIndex = foundIdx;
              }
            }
          }
        }
      }
    }

    // Pre-mark all singleton case classes as instantiated so they get class and interface vtables built
    for (let cPair in this.wasm.classInfos) {
      let info = cPair.value;
      let cStruct = info.structType;
      let {classType} = cStruct;
      if (classType != null) {
        let cType = classType;
        if (cType.isCaseClass && (cType.constructorType == null || (cType.constructorType as FunctionType).parameters.length == 0)) {
          let model = this.getClassModel(cType);
          this.specializer.instantiateClassType(cType, model);
        }
      }
    }

    this.currentReachable = true;

    this.#buildClassVTableGlobals();

    // Pass 1.25: Allocate singleton globals for unit variants
    for (let cPair in this.wasm.classInfos) {
      let cName = cPair.key;
      let info = cPair.value;
      let cStruct = info.structType;
      let {classType} = cStruct;
      if (classType != null) {
        let cType = classType;
        if (cType.isCaseClass && (cType.constructorType == null || (cType.constructorType as FunctionType).parameters.length == 0)) {
          if (info.singletonGlobal != null) {
            continue;
          }
          // Mirror the bootstrap: only unit variants with no user fields
          // (own or inherited) may be pre-allocated singletons. The
          // singleton is built with struct.new of default values, which
          // silently skips field initializers — e.g. a base-class
          // `uid: i32 = nextUid()` would stay 0 on every instance.
          var hasUserFields = false;
          var curr: ClassType | null = cType;
          while (curr != null && !hasUserFields) {
            let cc = curr;
            for (let mPair in cc.members) {
              if (mPair.value is FieldInfo && !mPair.value.isStatic) {
                hasUserFields = true;
                break;
              }
            }
            curr = cc.superType;
          }
          if (hasUserFields) {
            continue;
          }
          let globalName = getClassSingletonName(cName);
          // Non-nullable: the singleton is immutable and initialized in
          // place with a constant struct.new (the vtable global it reads
          // is always declared earlier). Reads flow directly into the
          // non-nullable locals that 8fae4045 introduced, with no cast.
          let globalType = new ValTypeRef(cStruct);
          let wasmGlobal = new WasmGlobal(
            globalName,
            globalName,
            globalType,
            false,
            null,
            null,
            this.program.units[0].model
          );
          wasmGlobal.initSingletonStruct = cType;
          // The WasmGlobal constructor nullifies ref types for globals it
          // cannot prove initialized in place (initSingletonStruct is only
          // attached after construction), so re-tighten here: the singleton
          // is immutable with a constant struct.new initializer, and its
          // reads flow into non-nullable locals with no cast.
          wasmGlobal.type = globalType;
          this.wasm.globals.push(wasmGlobal);
          info.singletonGlobal = wasmGlobal;
        }
      }
    }

    performance.end(tLayout);
    let tQueues2 = performance.start("codegen-discovery-queues");
    this.processQueues();
    performance.end(tQueues2);
    this.activateCancellationMachinery();
    this.processQueues();
    let tLayout2 = performance.start("codegen-discovery-layout");

    // Pass 2 and the queue drain feed each other; run them to fixpoint.
    var vtRound = true;
    while (vtRound) {
      vtRound = this.#buildClassInterfaceVTables();
      this.processQueues();
      this.activateCancellationMachinery();
    }
    
    performance.end(tLayout2);
    let tQueues3 = performance.start("codegen-discovery-queues");
    this.processQueues();
    performance.end(tQueues3);
    let tLayout3 = performance.start("codegen-discovery-layout");
    
    // Field accessors named by reachable referrers before populate
    // registered them: re-check now that populate has run, BEFORE the
    // settle layout — the drain can reach bodies that instantiate.
    this.currentReachable = true;
    // Index loop: draining can push MORE pending reaches (reaching a
    // case class's == pends String.== for its string fields).
    var pendIdx = 0;
    while (pendIdx < this.#pendingMemberReaches.length) {
      let pendingKey = this.#pendingMemberReaches[pendIdx];
      pendIdx += 1;
      if (let (true, f) = this.wasm.classMethodMap.get(pendingKey)) {
        this.markFunctionReached(f);
      }
    }
    this.processQueues();
    this.activateCancellationMachinery();
    this.processQueues();

    // The drains above can instantiate classes and record interface
    // adaptations the earlier vtable fixpoint never saw — a generic
    // method reached late packs a generic class at an interface slot,
    // and without another round the pair has a struct and no vtable
    // (lowering's iface_pack then fails). Re-run to fixpoint.
    var lateVtRound = true;
    while (lateVtRound) {
      lateVtRound = this.#buildClassInterfaceVTables();
      this.processQueues();
      this.activateCancellationMachinery();
      // Generator disposal activates here too: its exception-infra
      // mint queues reaches, and the loop's next round drains them
      // (the activation is once-only, so the fixpoint terminates).
      this.activateGeneratorDisposal();
    }

    // Discovery is settled. Catch layout up with anything the vtable
    // pass or the final drain instantiated, then CLOSE: from here a
    // new class cannot get a struct, so becoming instantiated now is a
    // bug, and a named one.
    this.#layoutClassStructs(populated);
    // Catching up is not only missing structs: a struct laid out early
    // can hold a field baked `structref` for a class a later walk then
    // registered — whose method signatures are precise, so the erased
    // field fails receiver conformance in lowering. Re-resolve those
    // fields against the settled registrations.
    this.specializer.refreshErasedFieldTypes();
    // The ==/hashCode slot decision bakes at each class's layout, and
    // equality evidence can legitimately arrive later — a body walked
    // in the vtable-fixpoint drains (array-sum's for-in machinery
    // does). Dispatching through a missing slot would be a silent
    // wrong answer, so REPAIR: re-add the two slots to every class
    // that pruned them, rebuild those classes' vtable globals, and
    // drain the newly reached slot methods.
    if (this.equalityDispatchUsed && this.#eqPrunedClasses.length > 0) {
      for (let prunedKey in this.#eqPrunedClasses) {
        if (let (true, prunedInfo) = this.wasm.classInfos.get(prunedKey)) {
          let prunedVst = prunedInfo.vtableStructType;
          if (prunedVst == null) { continue; }
          var addedSlot = false;
          for (let slotName in this.wasm.classVtable(prunedKey)) {
            if (slotName != "==" && slotName != "hashCode") { continue; }
            if (prunedVst.fieldIndexByName(slotName) >= 0) { continue; }
            prunedVst.fields.push(new WasmField(slotName, new ValTypeFuncRef(), false));
            addedSlot = true;
          }
          if (addedSlot && prunedInfo.vtableGlobal != null) {
            let staleGlobal = prunedInfo.vtableGlobal as WasmGlobal;
            let keptGlobals = new GrowableArray<WasmGlobal>();
            for (let g in this.wasm.globals) {
              if (g != staleGlobal) { keptGlobals.push(g); }
            }
            while (this.wasm.globals.length > 0) { this.wasm.globals.pop(); }
            for (let g in keptGlobals) { this.wasm.globals.push(g); }
            prunedInfo.vtableGlobal = null;
          }
        }
      }
      // Per-key rebuilds: the no-arg builder would also create globals
      // for late-instantiated classes Pass 1.5 deliberately skipped.
      for (let prunedKey in this.#eqPrunedClasses) {
        this.#buildClassVTableGlobals(prunedKey);
      }
      this.processQueues();
    }
    // And late-instantiated String needs its class vtable global,
    // exactly as it needs its struct — $stringCreate is synthesized
    // against it, and String can be instantiated as late as a literal
    // in a body walked here.
    let {stringClass} = this.wasm;
    if (stringClass != null) {
      let sKey = getClassKey(stringClass);
      if (this.instantiatedSpecializedClasses.has(sKey as String)) {
        this.#buildClassVTableGlobals(sKey);
      }
    }
    // Superclass constructor phases: every signature and struct these
    // derive from is final once the queues drain, and their bodies are
    // slices of already-walked constructor ASTs, so minting here adds
    // functions but no discovery.
    this.specializer.mintConstructorPhases();

    this.instantiationClosed = true;

    this.isRtaActive = false;

    // The type section is recomputed here rather than accumulated.
    // `markTypeReached` runs all through discovery, so `emittedTypes`
    // otherwise ends up as "every type anything ever looked at" — for
    // `return 42` that is 59 types and a third of the module, most of
    // them interface member signatures reached through vtable structs
    // of interfaces the program never mentions. Everything the emitted
    // module can actually reference is rooted below, and
    // closeReachedTypes takes the transitive closure; a type that is
    // genuinely needed and missing is a loud wasm validation failure,
    // not a silent miscompile.
    this.reachedTypesSet.clear();
    while (this.emittedTypes.length > 0) {
      this.emittedTypes.pop();
    }

    
    // A class struct is emitted on EVIDENCE, not declaration: the
    // class was instantiated (values exist), or reached code names the
    // type — a cast, a type test, a field read on a nullable reference
    // — recorded by discoverType during reachable traversal. This used
    // to mark every entry in classInfos, and classInfos holds every
    // DECLARED class (init pre-registers them all for circular
    // definitions), which put 134 struct types in `return 42`'s module.
    for (let cPair in this.wasm.classInfos) {
      let cKeyStr = cPair.key as String;
      // Box specializations are kept whenever registered: the
      // erased-== diamond (ir/equality.zena) ref_tests every
      // registered-and-shaped Box<prim> it finds, and the unbox cast
      // does the same for its target — both synthesized at lowering
      // with no AST naming the Box. Bounded at the five primitive
      // boxes, present only when something registered them.
      var isBoxSpecialization = false;
      let {boxClass} = this.wasm;
      if (boxClass != null) {
        let ct = cPair.value.structType.classType;
        if (ct != null) {
          isBoxSpecialization = isConcrete(ct) &&
              (ct.genericSource ?? ct).symbolId == boxClass.symbolId &&
              ct.typeArguments != null &&
              (ct.typeArguments as Array<Type>).length == 1 &&
              isBoxablePrimitive((ct.typeArguments as Array<Type>)[0]);
        }
      }
      // An EXTENSION class's struct is a placeholder: a value of the
      // class IS its representation type (typeToValType returns the
      // onType), so no cast, test, field read or signature can ever
      // name the struct — being named or instantiated keeps the
      // class's METHODS reachable, not this pair of dead types.
      var isExtensionPlaceholder = false;
      {
        let ctOpt = cPair.value.structType.classType;
        if (ctOpt != null && ctOpt.isExtension) {
          isExtensionPlaceholder = true;
        }
      }
      if (!isExtensionPlaceholder &&
          (this.instantiatedSpecializedClasses.has(cKeyStr) ||
          this.reachablyNamedClasses.has(cKeyStr) ||
          isBoxSpecialization)) {
        this.markTypeReached(cPair.value.structType);
        this.markTypeReached(cPair.value.vtableStructType);
      }
    }
    
    let keptGlobals = new GrowableArray<WasmGlobal>();
    for (let g in this.wasm.globals) {
      if (g.symbolId == noSymbolId || this.reachedGlobals.has(g.symbolId)) {
        keptGlobals.push(g);
      }
    }
    while (this.wasm.globals.length > 0) { this.wasm.globals.pop(); }
    for (let g in keptGlobals) { this.wasm.globals.push(g); }

    for (let g in this.wasm.globals) {
      this.markValTypeReached(g.type);
      let {initVTable} = g;
      if (initVTable != null) {
        let vtableInit = initVTable;
        this.markTypeReached(vtableInit.structType);
        for (let func in vtableInit.funcs) {
          this.markFunctionReached(func);
        }
      }
    }

    this.currentReachable = true;

    if (this.wasm.stringClass != null && this.wasm.stringLiterals.size > 0) {
      this.wasm.ensureStringLiteralHelpers(this.program.units[0].model);
      this.markFunctionReached(this.wasm.stringFromSharedFunc as WasmFunction);
      this.markFunctionReached(this.wasm.getStringLiteralFunc as WasmFunction);
    }

    this.ensureAllHelperFunctionsReached();
    this.processQueues();

    for (let iface in this.usedInterfaceTypes) {
      let iName = getInterfaceKey(iface);
      if (this.wasm.interfaceStructs.has(iName)) {
        this.markTypeReached(this.wasm.interfaceStructs[iName]);
      }
      if (this.wasm.interfaceVTableStructs.has(iName)) {
        this.markTypeReached(this.wasm.interfaceVTableStructs[iName]);
      }
    }

    for (let t in this.wasm.tags) {
      this.markTypeReached(t.signature);
    }
    for (let f in this.wasm.functionImports) {
      this.markTypeReached(f.signature);
    }
    
    let originalFunctions = this.wasm.functions;
    let reachedList = new GrowableArray<WasmFunction>();
    for (let f in originalFunctions) {
      let isReached = this.reachedFunctionsSet.has(f);
      if (isReached) {
        reachedList.push(f);
        this.markTypeReached(f.signature);
        // The captured-variable environment is referenced from the
        // lowered body, not from the signature.
        let {contextStruct} = f;
        if (contextStruct != null) {
          this.markTypeReached(contextStruct);
        }
      }
    }
    this.wasm.functions = reachedList;

    if (this.wasm.stringCreateFunc != null) { this.markTypeReached((this.wasm.stringCreateFunc as WasmFunction).signature); }
    if (this.wasm.stringSetByteFunc != null) { this.markTypeReached((this.wasm.stringSetByteFunc as WasmFunction).signature); }
    if (this.wasm.stringGetByteFunc != null) { this.markTypeReached((this.wasm.stringGetByteFunc as WasmFunction).signature); }
    if (this.wasm.stringGetLengthFunc != null) { this.markTypeReached((this.wasm.stringGetLengthFunc as WasmFunction).signature); }
    
    // Record-dispatch types are referenced from getter BODIES, which
    // are synthesized after this pruning and therefore invisible to
    // signature-driven reachability: the getters' signatures only
    // mention structref. Pruning them leaves index -1 references in
    // the synthesized code (invalid wasm). Keep every dispatch's
    // types; dispatches are few and their getters are in the
    // functions list whenever the dispatch is usable at all.
    // Resolve the record/tuple types reached code named into their
    // dispatch fat pointers and interned structs, now that discovery
    // has settled and every nested dispatch exists.
    for (let compT in this.#namedCompositeTypes) {
      if (compT is TupleType) {
        let tFields = new GrowableArray<WasmField>();
        for (var ti = 0; ti < compT.elementTypes.length; ti += 1) {
          tFields.push(new WasmField(i32ToString(ti), typeToValType(this.wasm, compT.elementTypes[ti]), false));
        }
        this.reachablyNamedAnonStructs.add(this.wasm.getStruct(null, tFields));
      } else if (compT is FunctionType) {
        this.reachablyNamedClosures.add(
            getClosureStruct(this.wasm, compT));
      } else if (compT is ArrayType) {
        // The raw wasm array of an array VALUE reached code names: an
        // index-loop for-in references it directly (array.new_fixed,
        // array.get) with no reached signature ever mentioning it.
        // typeToValType is the same derivation lowering uses, so the
        // marked array is the one the instructions will reference.
        let saved = this.currentReachable;
        this.currentReachable = true;
        this.markValTypeReached(typeToValType(this.wasm, compT));
        this.currentReachable = saved;
      }
    }

    // Dispatch types stay WHOLESALE for now, unlike the other roots:
    // getRecordDispatch pushes the dispatch's vtable global
    // unconditionally, the globals walk below force-reaches its getter
    // functions, and the getters' bodies struct.get the concrete type
    // — so an evidence gate here prunes types a getter that IS emitted
    // still references (`struct_get owner references unemitted
    // struct`). Gating these requires pruning unused dispatch GLOBALS
    // first, which is its own change.
    for (let rd in this.wasm.recordDispatchInfos) {
      this.markTypeReached(rd.concreteType);
      this.markTypeReached(rd.fatPtrType);
      this.markTypeReached(rd.vtableType);
    }
    for (let rd in this.wasm.adaptedDispatchInfos) {
      this.markTypeReached(rd.concreteType);
      this.markTypeReached(rd.fatPtrType);
      this.markTypeReached(rd.vtableType);
    }
    // Closure structs are referenced from lowered bodies, which run
    // after layout and are invisible to signature-driven reachability
    // — but "every closure struct ever interned" is not the root set:
    // plumbing walks mint shapes nothing emitted refers to, each
    // dragging its impl signature along. Root the ones RTA recorded
    // evidence for; a lowering-time lookup of an unrecorded one is a
    // loud index -1, not a silent miscompile.
    // Membership comes from the evidence set, but ITERATION follows
    // the interned map — a HashSet<WasmStruct> iterates in uid order,
    // which is process-global state (the batch-nondeterminism bug).
    for (let pair in this.wasm.closureStructs) {
      if (this.reachablyNamedClosures.has(pair.value)) {
        this.markTypeReached(pair.value);
      }
    }
    for (let cell in this.tryCellStructs) {
      this.markTypeReached(cell);
    }
    // Boxed tuples and records: named from lowered bodies only — of
    // reached functions, whose walks recorded them.
    for (let anon in this.wasm.anonymousStructs) {
      if (this.reachablyNamedAnonStructs.has(anon)) {
        this.markTypeReached(anon);
      }
    }
    this.closeReachedTypes();
    this.wasm.types = this.emittedTypes;
    performance.end(tLayout3);
  }

  /**
   * Pass 1.5: builds the class vtable global for every instantiated
   * class that does not have one yet. Incremental — classes with a
   * vtableGlobal are skipped. `onlyKey` restricts a re-run to one
   * class: at the settle point it runs again for String alone, because
   * $stringCreate is synthesized against String's vtable global and a
   * literal in a body walked late instantiates String after the main
   * pass. Other late-instantiated classes deliberately get NO vtable
   * global — nothing dispatches through one (building them for all
   * late classes cost array-sum 13 functions and 9 globals), and a
   * dispatch that does need one fails loudly at its site.
   */
  #buildClassVTableGlobals(onlyKey: ClassKey | null = null): void {
    // Slot functions WILL be emitted (the vtable global ref.funcs
    // them), so their bodies are walked as reachable — ambient
    // currentReachable here is whatever the last referrer left.
    this.currentReachable = true;
    for (let cPair in this.wasm.classInfos) {
      let cName = cPair.key;
      let info = cPair.value;
      if (onlyKey != null && cName != (onlyKey as ClassKey)) {
        continue;
      }
      if (info.vtableGlobal != null) {
        continue;
      }
      let {vtableStructType} = info;
      if (vtableStructType != null) {
        let vstVal = vtableStructType;
        let cType = vstVal.classType as ClassType;
        let {typeParameters} = cType;
        let isGenericTemplate = typeParameters != null && 
                                typeParameters.length > 0 && 
                                (cType.typeArguments == null || !isConcrete(cType));
        if (isGenericTemplate) {
          continue;
        }
        // Slot order must extend the base's: a dispatch through a
        // base-typed receiver indexes the base's layout, and the
        // instance's vtable is the subclass's. Both merge sites
        // (Pass 0.6 and registerSpecializedClass) prefix the super's
        // list, but a slot registered AFTER either merge lands
        // wherever registration put it — batch-history-dependent —
        // and a subclass whose base list filled late ends up with a
        // permuted layout that type-checks (every slot is funcref)
        // and dispatches the wrong method. Rebuild the order here,
        // super chain root-first, before the global bakes it.
        let chain = new GrowableArray<ClassType>();
        var cc: ClassType | null = cType;
        while (cc != null) {
          chain.push(cc as ClassType);
          cc = (cc as ClassType).superType;
        }
        let orderedNames = new GrowableArray<String>();
        let seenNames = new HashSet<String>();
        var ci = chain.length - 1;
        while (ci >= 0) {
          for (let n in this.wasm.classVtable(getClassKey(chain[ci]))) {
            if (!seenNames.has(n)) {
              seenNames.add(n);
              orderedNames.push(n);
            }
          }
          ci -= 1;
        }
        let fieldByName = new HashMap<String, WasmField>();
        for (let field in vstVal.fields) {
          fieldByName[field.name as String] = field;
        }
        // Names in ancestor lists whose slots this class does not
        // carry (pruned) are skipped; a field with no list entry
        // would be a bookkeeping bug and keeps its tail position.
        let orderedFields = new GrowableArray<WasmField>();
        for (let n in orderedNames) {
          if (let (true, f) = fieldByName.get(n)) {
            orderedFields.push(f);
            fieldByName.delete(n);
          }
        }
        for (let field in vstVal.fields) {
          if (fieldByName.has(field.name as String)) {
            orderedFields.push(field);
          }
        }

        let methods = new GrowableArray<WasmFunction>();
        let newFields = new GrowableArray<WasmField>();
        for (var i = 0; i < orderedFields.length; i += 1) {
          let field = orderedFields[i];
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = cType;
          while (currClass != null && foundFunc == null) {
            let key = getClassMethodKey(getClassKey(currClass), field.name as String);
            if (this.wasm.classMethodMap.has(key)) {
              foundFunc = this.wasm.classMethodMap[key];
              break;
            }
            currClass = currClass.superType;
          }
          if (foundFunc != null) {
            newFields.push(field);
            methods.push(foundFunc);
          } else {
            throw new Error("Internal error: class " + (cName as String) + " does not implement vtable method: " + (field.name as String));
          }
        }
        while (vstVal.fields.length > 0) {
          vstVal.fields.pop();
        }
        for (var fIdx = 0; fIdx < newFields.length; fIdx += 1) {
          vstVal.fields.push(newFields[fIdx]);
        }

        if (!this.instantiatedSpecializedClasses.has(cName as String)) {
          continue;
        }
        
        for (let m in methods) {
          this.markFunctionReached(m);
        }
        
        let vtableInit = new VTableInit(vstVal, methods);
        let vName = getClassVTableName(cName);
        let vtableGlobal = new WasmGlobal(
          vName,
          vName,
          new ValTypeRef(vstVal),
          false,
          null,
          vtableInit,
          this.program.units[0].model
        );
        this.wasm.globals.push(vtableGlobal);
        info.vtableGlobal = vtableGlobal;
      }
    }

  }

  /**
   * Builds the class-interface trampoline vtable globals, returning
   * whether it created any. Reaching an interface method's body can
   * instantiate further classes (`FixedArray<T>.:iterator` returns an
   * `ArrayIterator<T>` packed as `Iterator<T>`), and those need
   * class-interface vtables of their own — so `run` alternates this
   * with `processQueues` until neither adds anything, rather than
   * building once and leaving the last round's classes without one.
   * The pair set is finite and only ever grows, so this terminates.
   */
  #buildClassInterfaceVTables(): boolean {
    var created = false;
    // Pass 2: Generate class-interface trampoline vtables
    let classes = new GrowableArray<ClassType>();
    let seenClassKeys = new HashMap<ClassKey, boolean>();
    for (let cPair in this.wasm.classInfos) {
      let cStruct = cPair.value.structType;
      let {classType} = cStruct;
      if (classType != null) {
        let cType = classType;
        let cKey = getClassKey(cType);
        if (!seenClassKeys.has(cKey)) {
          seenClassKeys[cKey] = true;
          classes.push(cType);
        }
      }
    }
    // Only classes codegen has state for (the classInfos walk above).
    // This used to ALSO walk every declared class — and since a
    // class's interfaces are collected transitively, that instantiated
    // `FixedArray` at four element types for a program that mentions
    // none of them. The classInfos set already contains every class a
    // vtable could matter for: `usedInterfaceAdaptations`, checked
    // per-pair below, is only ever recorded against discovered classes.

    for (let cType in classes) {
      let {typeParameters} = cType;
      let isGenericTemplate = typeParameters != null &&
                              typeParameters.length > 0 &&
                              (cType.typeArguments == null || !isConcrete(cType));
      // An ERASURE passes `isConcrete` (an erased slot IS a type) but is
      // no more dispatchable than a template: it has a struct and no
      // methods, so there is nothing to put in a trampoline slot.
      if (isGenericTemplate || containsErasedType(cType as Type)) {
        continue;
      }
      let cName = getClassKey(cType);
      // An extension class has no `struct.new` — a value of it IS a
      // value of its `on` type — so "instantiated" never becomes true
      // for one now that mentioning the type no longer instantiates
      // it, and gating here would deny `FixedArray<T>` the
      // class-interface vtable its values genuinely dispatch through.
      // `usedInterfaceAdaptations` just below is the honest signal:
      // it is recorded from real pack sites, and gates each
      // class-interface pair on its own.
      if (!this.instantiatedSpecializedClasses.has(cName as String) &&
          !cType.isExtension) {
        continue;
      }
      let allIfaces = this.cha.collectAllImplementedInterfaces(cType);
      for (let iface in allIfaces) {
        let iName = getInterfaceKey(iface);
        let unspecCName = getClassKey(cType.genericSource ?? cType);
        let unspecIName = getInterfaceKey(iface.genericSource ?? iface);
        let unspecKey = getClassInterfaceKey(unspecCName, unspecIName);
        
        let key = getClassInterfaceKey(cName, iName);
        if (this.wasm.usedInterfaceAdaptations.has(unspecKey)) {
          if (this.wasm.classInterfaceVTables.has(key)) {
            continue;
          }
          if (!this.wasm.interfaceVTableStructs.has(iName)) {
            this.typeLowerer.discoverType(iface, this.getClassModel(cType));
          }
          let vst = this.wasm.interfaceVTableStructs[iName];
          
          let methods = new GrowableArray<WasmFunction>();
          for (var i = 0; i < vst.fields.length; i += 1) {
            let field = vst.fields[i];
            let fldName = field.name;
            if (fldName == null) {
              continue;
            }
            let fName = fldName;
            var foundFunc: WasmFunction | null = null;
            var currClass: ClassType | null = cType;
            
            while (currClass != null && foundFunc == null) {
              let mKey = getClassMethodKey(getClassKey(currClass), fName);
              if (this.wasm.classMethodMap.has(mKey)) {
                foundFunc = this.wasm.classMethodMap[mKey];
                break;
              }
              
              if (iface.members.has(fName)) {
                let mi = iface.members[fName];
                if (mi is MethodInfo && mi.type is FunctionType) {
                  let ft = mi.type as FunctionType;
                  let itParams = getInterfaceTypeParameters(iface);
                  let subFt = substituteTypeParamsInCodegen(this.wasm, itParams, iface.typeArguments, ft);
                  if (subFt is FunctionType) {
                    let resolvedFt = subFt as FunctionType;
                    let sigKey = getSignatureKey(resolvedFt);
                    let mKeyWithSig = getClassMethodKey(getClassKey(currClass), fName + sigKey);
                    if (this.wasm.classMethodMap.has(mKeyWithSig)) {
                      foundFunc = this.wasm.classMethodMap[mKeyWithSig];
                      break;
                    }
                  }
                }
              }
              
              currClass = currClass.superType;
            }
            
            if (foundFunc != null) {
              let trampSig = getInterfaceMemberSignature(this.wasm, iface, fName);
              let trampFunc = new WasmFunction(trampSig, null, this.program.units[0].model);
              trampFunc.name = getInterfaceTrampolineName(cName, iName, fName);
              trampFunc.interfaceTrampolineTarget = foundFunc;
              this.wasm.addFunction(trampFunc);
              this.markFunctionReached(trampFunc);
              this.markFunctionReached(foundFunc);
              methods.push(trampFunc);
            } else {
              var chain = "";
              var cw: ClassType | null = cType;
              while (cw != null) {
                let ccw = cw;
                let targsLen = if (ccw.typeArguments != null) i32ToString((ccw.typeArguments as Array<Type>).length) else "null";
                let tparamsLen = if (ccw.typeParameters != null) i32ToString((ccw.typeParameters as Array<TypeParameterType>).length) else "null";
                let conc = if (isConcrete(ccw)) "true" else "false";
                chain = chain + ccw.name + "[args:" + targsLen + ",params:" + tparamsLen + ",conc:" + conc + ",key:" + (getClassKey(ccw) as String) + "] -> ";
                cw = ccw.superType;
              }
              throw new Error("Internal error: class " + (cName as String) + " does not implement interface method: " + fName + "; chain: " + chain);
            }
          }
          
          let vtableInit = new VTableInit(vst, methods);
          let viName = getClassInterfaceVTableName(cName, iName);
          let vtableGlobal = new WasmGlobal(
            viName,
            viName,
            new ValTypeRef(vst),
            false,
            null,
            vtableInit,
            this.program.units[0].model
          );
          this.wasm.globals.push(vtableGlobal);
          this.wasm.classInterfaceVTables[key] = vtableGlobal;
          this.usedInterfaceTypes.push(iface);
          created = true;
        }
      }
    }
    return created;
  }


  /**
   * Populates every known class's struct and vtable slots, to a
   * fixpoint: populating a class registers its methods, and that can
   * instantiate further classes which then need laying out too.
   *
   * Called again once discovery has fully settled, immediately before
   * instantiation is closed — a class first instantiated by the
   * class-interface vtable pass or the final queue drain still has to
   * get a layout, and before this ran twice it silently did not.
   */
  #layoutClassStructs(populated: HashMap<ClassKey, boolean>): void {
    var round = true;
    while (round) {
      round = false;
      let pending = new GrowableArray<ClassType>();
      for (let cPair in this.wasm.classInfos) {
        let ct = cPair.value.structType.classType;
        if (ct != null && !populated.has(getClassKey(ct))) {
          pending.push(ct);
        }
      }
      for (let ct in pending) {
        this.#populateClassStruct(ct, populated);
        round = true;
      }
    }
  }

  /** Host-import boundary directions; see wasm.hostReadsStrings/hostWritesStrings. */
  noteHostImportSignature(ft: FunctionType): void {
    for (let p in ft.parameters) {
      if (this.#typeMentionsString(p, 0)) {
        this.wasm.hostReadsStrings = true;
      }
    }
    if (this.#typeMentionsString(ft.returnType, 0)) {
      this.wasm.hostWritesStrings = true;
    }
  }

  /** See extendedClassSymbols: can anything dispatch through this class's vtable? */
  classCanDispatchVirtually(ct: ClassType): boolean {
    if (ct.superType != null) {
      return true;
    }
    return this.extendedClassSymbols.has((ct.genericSource ?? ct).symbolId);
  }

  /**
   * Whether `t` mentions the stdlib String class anywhere a value
   * could cross a boundary typed by `t`: directly, in a function
   * type's parameters or return, through unions, tuples, records,
   * arrays and alias targets, or in a class/interface's type ARGUMENTS
   * (`Array<String>`). Class MEMBERS are not walked — a member's
   * String is produced by code, which instantiates through its own
   * body. Depth-bounded rather than seen-set-deduplicated: a set keyed
   * by symbol would conflate specializations of one generic, and the
   * types that reach an export boundary are shallow.
   */
  #typeMentionsString(t: Type, depth: i32): boolean {
    if (depth > 12) {
      return false;
    }
    return match (t) {
      case ClassType as ct: {
        if (isWellKnown(WellKnown.StringClass, ct.name, ct.sourcePath)) {
          true
        } else {
          var found = false;
          let {typeArguments} = ct;
          if (typeArguments != null) {
            for (let ta in typeArguments) {
              if (this.#typeMentionsString(ta, depth + 1)) { found = true; break; }
            }
          }
          found
        }
      }
      case InterfaceType as it: {
        var found = false;
        let {typeArguments} = it;
        if (typeArguments != null) {
          for (let ta in typeArguments) {
            if (this.#typeMentionsString(ta, depth + 1)) { found = true; break; }
          }
        }
        found
      }
      case FunctionType as ft: {
        var found = this.#typeMentionsString(ft.returnType, depth + 1);
        if (!found) {
          for (let p in ft.parameters) {
            if (this.#typeMentionsString(p, depth + 1)) { found = true; break; }
          }
        }
        found
      }
      case UnionType {types}: {
        var found = false;
        for (let m in types) {
          if (this.#typeMentionsString(m, depth + 1)) { found = true; break; }
        }
        found
      }
      case TupleType {elementTypes}: {
        var found = false;
        for (let e in elementTypes) {
          if (this.#typeMentionsString(e, depth + 1)) { found = true; break; }
        }
        found
      }
      case InlineTupleType {elementTypes}: {
        var found = false;
        for (let e in elementTypes) {
          if (this.#typeMentionsString(e, depth + 1)) { found = true; break; }
        }
        found
      }
      case ArrayType {elementType}: this.#typeMentionsString(elementType, depth + 1)
      case RecordType as rec: {
        var found = false;
        for (let pair in rec.properties) {
          if (this.#typeMentionsString(pair.value, depth + 1)) { found = true; break; }
        }
        found
      }
      case TypeAliasType as alias: this.#typeMentionsString(alias.target, depth + 1)
      case _: false
    };
  }

  /**
   * Ensures the exception infrastructure AND accounts for what it
   * implies: `ensureExceptionInfra` creates `$stringCreate` and
   * `$stringSetByte` (the host builds a String through them, e.g. for
   * a stack-trace message), and a created-but-unreached helper is a
   * dangling export — function index -1, an invalid module. Their
   * bodies are synthesized against String's layout and vtable, so
   * String is instantiated as their prerequisite. Exceptions are, for
   * now, String evidence.
   */
  /**
   * Records a closure struct that emitted code can reference, under
   * the same evidence gate as reachablyNamedClasses. See the interface
   * doc; `force` is for sites that create a REACHED function whose
   * synthesized body references the struct regardless of what walk
   * discovered it (value wrappers, adaptations).
   */
  noteCompositeType(t: Type): void {
    let key = getTypeUniqueKey(t);
    if (!this.#namedCompositeKeys.has(key)) {
      this.#namedCompositeKeys.add(key);
      this.#namedCompositeTypes.push(t);
    }
  }

  /** Deferred by-key member reach; drained with the field accessors at settle. */
  notePendingMemberReach(key: ClassMethodKey): void {
    this.#pendingMemberReaches.push(key);
  }

  noteClosureStruct(cs: WasmStruct): void {
    if (this.inQueueWalk && this.currentReachable) {
      this.reachablyNamedClosures.add(cs);
    }
  }

  noteEqSlotPruned(key: ClassKey): void {
    this.#eqPrunedClasses.push(key);
  }

  noteExceptionInfra(model: SemanticModel): void {
    this.wasm.ensureExceptionInfra(model);
    let {stringClass} = this.wasm;
    if (stringClass != null) {
      let sClass = stringClass;
      this.specializer.instantiateClassType(sClass, this.getClassModel(sClass));
      let {stringCreateFunc} = this.wasm;
      if (stringCreateFunc != null) {
        this.markFunctionReached(stringCreateFunc);
      }
      let {stringSetByteFunc} = this.wasm;
      if (stringSetByteFunc != null) {
        this.markFunctionReached(stringSetByteFunc);
      }
    }
  }

  ensureAllHelperFunctionsReached(): void {
    for (let unit in this.program.units) {
      let mod = unit.ast;
      let {model} = unit;
      for (let stmt in mod.body) {
        if (stmt is ImportDeclaration) {
          this.visitor.discoverImportDeclaration(stmt, model);
        }
      }
    }

    // Gated on String being INSTANTIATED, not declared: the $string*
    // helpers' bodies are synthesized against String's struct, and
    // they exist to hand String values across the host boundary — a
    // module with no String value has nothing to hand across.
    if (this.wasm.stringClass != null &&
        this.instantiatedSpecializedClasses.has(
            getClassKey(this.wasm.stringClass as ClassType) as String)) {
      this.wasm.stringClassIsInstantiated = true;
      this.wasm.ensureStringHelpers(this.program.units[0].model);
      if (this.wasm.stringCreateFunc != null) { this.markFunctionReached(this.wasm.stringCreateFunc as WasmFunction); }
      if (this.wasm.stringSetByteFunc != null) { this.markFunctionReached(this.wasm.stringSetByteFunc as WasmFunction); }
      if (this.wasm.stringGetByteFunc != null) { this.markFunctionReached(this.wasm.stringGetByteFunc as WasmFunction); }
      if (this.wasm.stringGetLengthFunc != null) { this.markFunctionReached(this.wasm.stringGetLengthFunc as WasmFunction); }
    }
    let {wasiWriteStringHelper} = this.wasm;
    if (wasiWriteStringHelper != null) {
      this.markFunctionReached(wasiWriteStringHelper);
    }
    // The string hash helper follows the equality evidence, like the
    // ==/hashCode slots it serves. If literal interning ever calls it
    // directly, the miss is a loud 'function index < 0', not a wrong
    // answer.
    let {stringHashFunc} = this.wasm;
    if (stringHashFunc != null && this.equalityDispatchUsed) {
      this.markFunctionReached(stringHashFunc);
    }
  }

  traverseDependencies(deps: SymbolDependencies, model: SemanticModel, classType: ClassType | null, typeArguments: Array<Type> | null = null, node: Node | null = null): void {
    let ctParams: Array<TypeParameterType> | null = if (classType != null) getClassTypeParameters(classType) else null;
    let ctArgs: Array<Type> | null = if (classType != null) classType.typeArguments else null;

    // A function's OWN type parameters, when this walk is of one
    // monomorphization of it. Both node shapes that carry them count: a
    // generic arrow (`FunctionExpression`) and a generic METHOD, which
    // is a `MethodDefinition`. Only the arrow was recognized, so a
    // generic method's body was walked with its parameters still open —
    // `new State<B>` inside `Box.make<B>` stayed `State<B>`, was erased
    // to `State<anyref>`, and the `State<i32>` the call really needs was
    // never discovered. Lowering then bailed "class not discovered" on
    // the specialization it had just been handed.
    // A CLOSURE's walk carries the ENCLOSING generic function's
    // arguments and has no parameters of its own, so the lookup walks
    // up to the nearest node that declares some.
    let ownTypeParams = if (node == null || typeArguments == null) {
      null
    } else {
      enclosingOwnTypeParameters(model, node as Node)
    };

    let resolveType = (t: Type): Type => {
      var res = substituteTypeParamsInClassContext(this.wasm, classType, t);
      if (ownTypeParams != null) {
        res = substituteTypeParamsInCodegen(
            this.wasm, ownTypeParams,
            typeArguments as Array<Type>, res);
      }
      return res;
    };

    // 0. Register used interface adaptations first
    for (let adaptKey in deps.usedInterfaceAdaptations) {
      var parsed: ParsedAdaptationRef | null = null;
      if (let (true, cached) = this.parsedAdaptationRefs.get(adaptKey)) {
        parsed = cached;
      } else {
        let keyStr = adaptKey;
        var colonIdx = -1;
        for (var i = 0; i < keyStr.length - 1; i += 1) {
          if (keyStr.getByteAt(i) == 58 && keyStr.getByteAt(i + 1) == 58) {
            colonIdx = i;
            break;
          }
        }
        if (colonIdx != -1) {
          let classIdStr = keyStr.sliceBytes(0, colonIdx);
          let ifaceIdStr = keyStr.sliceBytes(colonIdx + 2, keyStr.length);
          let classId = if (let (true, cid) = parseI32(classIdStr)) cid else -1;
          let ifaceId = if (let (true, iid) = parseI32(ifaceIdStr)) iid else -1;
          let newRef = new ParsedAdaptationRef(classId as SymbolId, ifaceId as SymbolId);
          this.parsedAdaptationRefs[adaptKey] = newRef;
          parsed = newRef;
        }
      }

      if (parsed != null) {
        let classId = parsed.classSymId;
        let ifaceId = parsed.ifaceSymId;
        if (this.interfaceDecls.has(ifaceId)) {
          let ifaceDecl = this.interfaceDecls[ifaceId];
          let ifaceModel = this.interfaceModels[ifaceId];
          let it = ifaceModel.getBindingType(ifaceModel.resolve(ifaceDecl) as Symbol) as InterfaceType;
          
          if (this.symbolIdToDecl.has(classId)) {
            let classDecl = this.symbolIdToDecl[classId];
            let classModel = this.symbolIdToModel[classId];
            let ct = this.getClassDeclType(classDecl, classModel);
            if (ct != null && it != null) {
              let unspecCName = getClassKey(ct.genericSource ?? ct);
              let unspecIName = getInterfaceKey(it.genericSource ?? it);
              let unspecKey = getClassInterfaceKey(unspecCName, unspecIName);
              this.wasm.usedInterfaceAdaptations[unspecKey] = true;
            }
          } else if (classType != null) {
            if (classType != null && it != null) {
              let unspecCName = getClassKey(classType.genericSource ?? classType);
              let unspecIName = getInterfaceKey(it.genericSource ?? it);
              let unspecKey = getClassInterfaceKey(unspecCName, unspecIName);
              this.wasm.usedInterfaceAdaptations[unspecKey] = true;
            }
          }
        }
      }
    }

    if (deps.needsExceptionInfra) {
      this.noteExceptionInfra(model);
    }
    if (deps.causesCancellation) {
      this.cancellationPossible = true;
    }
    if (deps.hasIteratorForIn) {
      this.iteratorForInReached = true;
    }
    if (deps.createsGenerator) {
      this.generatorReached = true;
    }

    // Enclosing locals assigned inside a `try` body live in heap cells,
    // exactly like closure-mutated captures: the handler is entered
    // from anywhere in the protected extent, so only a cell can show it
    // the assignments the body completed before it threw. Registering
    // the symbol here is all lowering needs — `isCelled` already routes
    // the declaration, reads, and writes through the cell. The struct
    // must be interned NOW: lowering runs after layout, where a miss is
    // a hard error.
    for (let symId in deps.tryMutatedSymbols) {
      let bindingType = model.getBindingTypeById(symId);
      if (bindingType == null) { continue; }
      let valType = typeToValType(this.wasm, resolveType(bindingType));
      this.tryCellStructs.push(getCellStruct(this.wasm, valType));
      this.wasm.mutableCapturedSymbols.add(symId);
    }

    // 1. Discover referenced types
    for (let t in deps.referencedTypes) {
      let resolved = resolveType(t);
      // A function-typed record is a SIGNATURE reference — the checker
      // records a callee's type for a plain call too, and a call needs
      // no closure struct. Genuine value uses of a named function are
      // handled by the wrapper registration just below (and arrows in
      // value position by the node walks), which mint the closure
      // struct themselves.
      if (resolved is FunctionType) {
        this.typeLowerer.discoverSignatureType(resolved, model);
      } else {
        this.typeLowerer.discoverType(resolved, model);
      }
      if (resolved is ClassType) {
        this.specializer.instantiateClassType(resolved, model);
      } else if (resolved is FunctionType) {
        // Generic instantiations only. The identifier-reference path
        // below cannot see these: at the reference site the specialized
        // function may not exist yet, so the wrapper has to be
        // registered from the type. Dropping this breaks
        // execution/functions/generic_closure_substitution.zena with
        // "non-local identifier @Holder_s788_i32.getVal".
        let resTargs = resolved.typeArguments;
        if (resTargs != null && resTargs.length > 0) {
          this.visitor.discoverFunctionValueWrapper(resolved, model);
        }
      }
      // A non-generic FunctionType here does NOT imply a value is needed.
      // `referencedTypes` collects every type the checker assigns to a
      // node (checker.zena setNodeType/resolveIdentifier), so a plain
      // call contributes its callee's FunctionType, and in Zena every
      // function is an arrow bound to a `let`. Registering a wrapper
      // from this set emitted one for every function in the program —
      // 51 dead wrappers in basic_bench, each with its own signature
      // and an entry in the declared-func elem table.
      //
      // Wrappers come from visitor.discoverIdentifierReferenceAsValue(),
      // which fires on identifier references outside callee position and
      // so covers arguments, field stores, returns and local bindings.
    }

    // 2. Queue referenced symbols
    for (let symId in deps.referencedSymbols) {
      var targetSymId = symId;
      if (this.symbolIdToTargetId.has(symId)) {
        targetSymId = this.symbolIdToTargetId[symId];
      }
      if (let (true, targetModel) = this.symbolIdToModel.get(targetSymId)) {
        this.queueReferrer(new Referrer(true, targetSymId, -1, targetModel, null, this.currentReachable));
      }
    }

    for (let methStr in deps.referencedClassMethods) {
      var parsed: ParsedMethodRef | null = null;
      if (let (true, cached) = this.parsedClassMethodRefs.get(methStr)) {
        parsed = cached;
      } else {
        var dotIdx = -1;
        for (var i = 0; i < methStr.length; i += 1) {
          if (methStr.getByteAt(i) == 46) {
            dotIdx = i;
            break;
          }
        }
        if (dotIdx != -1) {
          let classIdStr = methStr.sliceBytes(0, dotIdx);
          let mName = methStr.sliceBytes(dotIdx + 1, methStr.length);
          let classId = if (let (true, cid) = parseI32(classIdStr)) cid else -1;
          parsed = new ParsedMethodRef(classId as SymbolId, mName);
        } else {
          parsed = new ParsedMethodRef(noSymbolId, "");
        }
        this.parsedClassMethodRefs[methStr] = parsed;
      }

      if (parsed != null && parsed.classSymId as i32 != -1) {
        let {classSymId} = parsed;
        let {mName} = parsed;
        if (let (true, targetModel) = this.symbolIdToModel.get(classSymId)) {
          var targetClassType: ClassType | null = null;
          let t = targetModel.getBindingTypeById(classSymId);
          if (t is ClassType) {
            targetClassType = t;
            if (classType != null && classType.genericSource != null) {
              let genSrc = classType.genericSource as ClassType;
              if (genSrc.symbolId == classSymId) {
                targetClassType = classType;
              }
            }
            this.specializer.instantiateClassType(targetClassType, targetModel);
          } else if (targetModel.mixinDeclarations.has(classSymId)) {
            let mixinDecl = targetModel.mixinDeclarations[classSymId];
            targetClassType = new ClassType(this.typeIdGenerator.next(), classSymId, mixinDecl.name.name);
          }

          if (targetClassType != null) {
            let {cha} = this;
            let list = new GrowableArray<ClassType>();
            if (targetClassType.isExtension) {
              list.push(targetClassType);
            } else {
              let subclasses = cha.findInstantiatedSubclasses(targetClassType);
              for (let subCt in subclasses) {
                list.push(subCt);
              }
            }
            // The records are symbol-level, and findInstantiatedSubclasses
            // sees only specializations that exist NOW — a member dep
            // traversed before the receiver's specialization is
            // instantiated queues nothing, and the edge is lost. While
            // every method of an instantiated class was force-reached
            // that never showed (JsonObject.size reads its
            // OrderedMap's size before any OrderedMap is
            // instantiated). Record the member against the generic;
            // discovery and instantiation replay it per specialization.
            let recMds = cha.findImplementingMethods(targetClassType, mName);
            if (recMds.length > 0) {
              for (let md in recMds) {
                let mdNode = md as Node;
                this.nodeIdToNode[mdNode.id as i32] = mdNode;
                this.nodeIdToModel[mdNode.id as i32] = this.getNodeModel(mdNode, targetModel);
                this.recordReachedClassMember(classSymId, mdNode.id as i32,
                    this.getNodeModel(mdNode, targetModel), this.currentReachable);
              }
            } else {
              let recAcc = cha.findImplementingAccessor(targetClassType, mName);
              if (recAcc != null) {
                let accNode = recAcc as Node;
                this.nodeIdToNode[accNode.id as i32] = accNode;
                this.nodeIdToModel[accNode.id as i32] = this.getNodeModel(accNode, targetModel);
                this.recordReachedClassMember(classSymId, accNode.id as i32,
                    this.getNodeModel(accNode, targetModel), this.currentReachable);
              }
            }
            for (let subCt in list) {
              let subModel = this.getClassModel(subCt);
              let mds = cha.findImplementingMethods(subCt, mName);
              if (mds.length > 0) {
                for (let md in mds) {
                  this.queueReferrer(new Referrer(false, noSymbolId, (md as Node).id as i32, this.getNodeModel(md as Node, subModel), subCt, this.currentReachable));
                }
              } else {
                let acc = cha.findImplementingAccessor(subCt, mName);
                if (acc != null) {
                  this.queueReferrer(new Referrer(false, noSymbolId, (acc as Node).id as i32, this.getNodeModel(acc as Node, subModel), subCt, this.currentReachable));
                } else if (mName == "==" || mName == "hashCode" ||
                    (mName == ":dispose" && subCt.hasSyntheticDispose)) {
                  // A case class's synthesized ==/hashCode — and a
                  // resource's synthesized :dispose — have no AST node
                  // to find; reach the registered function by key,
                  // deferred past its registration.
                  if (this.currentReachable) {
                    this.notePendingMemberReach(getClassMethodKey(getClassKey(subCt), mName));
                  }
                } else if (mName.startsWith("get#") || mName.startsWith("set#")) {
                  let fieldName = mName.sliceBytes(4, mName.length);
                  let fd = cha.findImplementingField(subCt, fieldName);
                  if (fd != null) {
                    this.queueReferrer(new Referrer(false, noSymbolId, (fd as Node).id as i32, this.getNodeModel(fd as Node, subModel), subCt, this.currentReachable));
                  }
                }
              }
            }
          }
        }
      }
    }

    // 4. Queue referenced interface members
    for (let ifaceStr in deps.referencedInterfaceMembers) {
      var parsed: ParsedInterfaceMemberRef | null = null;
      if (let (true, cached) = this.parsedInterfaceMemberRefs.get(ifaceStr)) {
        parsed = cached;
      } else {
        var dotIdx = -1;
        for (var i = 0; i < ifaceStr.length; i += 1) {
          if (ifaceStr.getByteAt(i) == 46) {
            dotIdx = i;
            break;
          }
        }
        if (dotIdx != -1) {
          let ifaceIdStr = ifaceStr.sliceBytes(0, dotIdx);
          let mName = ifaceStr.sliceBytes(dotIdx + 1, ifaceStr.length);
          let ifaceId = if (let (true, iid) = parseI32(ifaceIdStr)) iid else -1;
          parsed = new ParsedInterfaceMemberRef(ifaceId as SymbolId, mName);
        } else {
          parsed = new ParsedInterfaceMemberRef(noSymbolId, "");
        }
        this.parsedInterfaceMemberRefs[ifaceStr] = parsed;
      }

      if (parsed != null && parsed.ifaceSymId as i32 != -1) {
        let ifaceId = parsed.ifaceSymId;
        let {mName} = parsed;
        if (let (true, targetModel) = this.symbolIdToModel.get(ifaceId)) {
          let ifaceDecl = this.interfaceDecls[ifaceId];
          if (ifaceDecl != null) {
            let baseIfaceType = targetModel.getNodeType(ifaceDecl) as InterfaceType;
            var targetIfaceType = baseIfaceType;
            if (classType != null) {
              let specIfaces = this.cha.collectAllImplementedInterfaces(classType);
              for (let specI in specIfaces) {
                let genSrc = specI.genericSource ?? specI;
                if (genSrc.symbolId == ifaceId) {
                  targetIfaceType = specI;
                  break;
                }
              }
            }
            let unspecIName = getInterfaceKey(targetIfaceType.genericSource ?? targetIfaceType);
            this.wasm.usedInterfaceMembers[getInterfaceMemberKey(unspecIName, mName)] = true;
            
            let resolvedIfaceStr = i32ToString((targetIfaceType.genericSource ?? targetIfaceType).symbolId as i32) + "." + mName;
            this.addReferencedInterfaceMember(resolvedIfaceStr);
          }
        }
      }
    }

    // 5. Record reached closures
    for (let closureDep in deps.closures) {
      let funcExpr = closureDep.node as FunctionExpression;
      this.nodeIdToNode[funcExpr.id as i32] = funcExpr;
      this.nodeIdToModel[funcExpr.id as i32] = model;
      let classKey = if (classType != null) getClassKey(classType) else "" as ClassKey;
      // A closure inside a generic FUNCTION (or generic method, or
      // generic static) exists once per instantiation of it: the
      // captures' and signature's types mention the function's type
      // parameters, and at a primitive argument nothing can share the
      // erased impl (i32 is not a subtype of anyref). The enclosing
      // function's argument vector is the key's second axis, next to
      // the class specialization.
      let enclosingFnParams = enclosingOwnTypeParameters(model, funcExpr as Node);
      let closureKey = getClosureSpecializationKey(funcExpr.id, classKey,
          enclosingFnParams, typeArguments);

      if (this.wasm.specializedClosures.has(closureKey)) {
        let existingFunc = this.wasm.specializedClosures[closureKey];
        // The function-axis template (registered by a walk of the
        // generic function's own body) is never a function to reach —
        // marking it here would emit the erased impl after all.
        let existingIsFuncTemplate = enclosingFnParams != null &&
            typeArguments == null;
        if (this.currentReachable && !existingIsFuncTemplate) {
          this.markFunctionReached(existingFunc);
        }
        this.queueReferrer(new Referrer(false, noSymbolId, funcExpr.id as i32, model, classType, this.currentReachable, typeArguments));
        continue;
      }

      let rawFuncTypeNode = model.getNodeType(funcExpr);
      var funcTypeNode = if (classType != null && ctParams != null) {
        substituteTypeParamsInCodegen(this.wasm, ctParams, ctArgs, rawFuncTypeNode as Type)
      } else {
        rawFuncTypeNode
      };
      if (closureKey.specializesFunction() && funcTypeNode != null) {
        funcTypeNode = substituteTypeParamsInCodegen(this.wasm,
            enclosingFnParams as Array<TypeParameterType>,
            typeArguments as Array<Type>, funcTypeNode as Type);
      }
      
      let params = new GrowableArray<ValType>();
      params.push(new ValTypeStructRef()); // ctx
      let returns = new GrowableArray<ValType>();
      
      if (funcTypeNode is FunctionType) {
        for (let p in funcTypeNode.parameters) {
          mapParamTypeToWasmParams(this.wasm, p, params);
        }
        mapReturnTypeToWasmResults(this.wasm, funcTypeNode.returnType, returns);
      } else {
        returns.push(new ValTypeI32());
      }
      
      let sig = this.wasm.getSignature(params, returns);
      let wasmFunc = new WasmFunction(sig, funcExpr, model);
      wasmFunc.isClosure = true;
      wasmFunc.isReferenceTaken = true;
      wasmFunc.classType = classType;
      if (closureKey.specializesFunction()) {
        // The impl's body mentions the enclosing function's type
        // parameters too; carrying the binding here is what routes
        // its lowering (and its body's own RTA walk, via
        // markFunctionReached) through the same substitution the
        // enclosing specialization uses.
        wasmFunc.typeParameters = enclosingFnParams;
        wasmFunc.typeArguments = typeArguments;
      }

      var suffix = if ((classKey as String).length > 0) "_" + (classKey as String) else "";
      suffix += closureKey.funcKey as String;

      let fileBase = sanitizeName(getFileNameBase(getNodeFilePath(model, funcExpr)));
      let locStr = if (funcExpr.loc != null) {
        let loc = funcExpr.loc as SourceLocation;
        "L" + i32ToString(loc.line) + "C" + i32ToString(loc.column)
      } else {
        i32ToString(funcExpr.id as i32)
      };

      wasmFunc.name = "closure_impl_" + fileBase + suffix + "_" + locStr;
      
      wasmFunc.capturesThis = closureDep.capturesThis;
      wasmFunc.mutableCaptures = closureDep.mutableCaptures;
      for (let symId in closureDep.captures) {
        let symName = if (model.symbolNames.has(symId)) {
          model.symbolNames[symId]
        } else {
          "captured_var"
        };
        this.wasm.symbolNames[symId] = symName;
        wasmFunc.captures.push(symId);
      }
      
      var enclosingClassType = classType;
      if (enclosingClassType == null && closureDep.capturesThis) {
        var curr = funcExpr as Node;
        while (true) {
          let parent = model.getParent(curr);
          if (parent == null) { break; }
          if (parent is ClassDeclaration) {
            let ct = model.getNodeType(parent);
            if (ct is ClassType) {
              enclosingClassType = ct;
            }
            break;
          }
          curr = parent;
        }
      }

      let fields = new GrowableArray<WasmField>();
      if (closureDep.capturesThis && enclosingClassType != null) {
        var thisValType: ValType = new ValTypeStructRef();
        if (let (true, info) = this.wasm.classInfos.get(getClassKey(enclosingClassType))) {
          thisValType = new ValTypeRefNull(info.structType);
        } else {
          thisValType = typeToValType(this.wasm, enclosingClassType);
        }
        fields.push(new WasmField("this", thisValType, false));
      }
      
      for (let symId in closureDep.captures) {
        let rawSymType = model.getBindingTypeById(symId);
        var symType = if (classType != null && ctParams != null) {
          substituteTypeParamsInCodegen(this.wasm, ctParams, ctArgs, rawSymType as Type)
        } else {
          rawSymType
        };
        if (closureKey.specializesFunction() && symType != null) {
          symType = substituteTypeParamsInCodegen(this.wasm,
              enclosingFnParams as Array<TypeParameterType>,
              typeArguments as Array<Type>, symType as Type);
        }
        let valType = typeToValType(this.wasm, symType as Type);
        var fieldType: ValType = valType;
        if (closureDep.mutableCaptures.has(symId)) {
          let cellStruct = getCellStruct(this.wasm, valType);
          fieldType = new ValTypeRefNull(cellStruct);
        }
        fields.push(new WasmField("capture_" + i32ToString(symId as i32), fieldType, false));
      }
      
      let typeParameters = if (classType != null) classType.typeParameters else null;
      let isGenericTemplate = classType != null &&
                              typeParameters != null &&
                              typeParameters.length > 0 &&
                              (classType.typeArguments == null || !isConcrete(classType));
      // The walk of a generic function's own body — its parameters
      // still open — is the FUNCTION-axis template, not a function:
      // registered so the erased shape exists, never emitted. The real
      // impls are minted above, one per instantiation, when the
      // specialized bodies are walked with their argument vectors.
      let isFuncTemplate = enclosingFnParams != null && typeArguments == null;
      let contextStructName = "ClosureCtx_" + fileBase + suffix + "_" + locStr;
      let contextStruct = new WasmStruct(contextStructName, fields);
      wasmFunc.contextStruct = contextStruct;
      if (!isGenericTemplate && !isFuncTemplate) {
        this.wasm.types.push(contextStruct);
        this.markTypeReached(contextStruct);

        this.wasm.addFunction(wasmFunc);
        this.markFunctionReached(wasmFunc);
      }
      if (!closureKey.specializesFunction()) {
        // The by-node fallback stays the per-node template; a
        // function-specialized impl must never be found through it,
        // or a missed specialization would silently reuse another
        // instantiation's context layout.
        this.wasm.closureFunctions[funcExpr] = wasmFunc;
      }

      this.wasm.specializedClosures[closureKey] = wasmFunc;

      this.queueReferrer(new Referrer(false, noSymbolId, funcExpr.id as i32, model, classType, this.currentReachable, typeArguments));
    }

    // 6. Record function adaptations
    for (let fAdapt in deps.functionAdaptations) {
      let src = resolveType(fAdapt.source) as FunctionType;
      let tgt = resolveType(fAdapt.target) as FunctionType;
      let expr = fAdapt.node;
      
      this.typeLowerer.discoverType(src, model);
      this.typeLowerer.discoverType(tgt, model);
      
      var expectedWasmSig: WasmSignature | null = null;
      var resolvedTargetStruct: WasmStruct | null = null;
      
      let parent = model.getParent(expr);
      if (parent is CallExpression) {
        var argIdx = -1;
        for (var idx = 0; idx < parent.args.length; idx += 1) {
          if (parent.args[idx] == expr) {
            argIdx = idx;
            break;
          }
        }
        if (argIdx >= 0 && parent.callee is MemberExpression) {
          let mem = parent.callee as MemberExpression;
          let calleeType = model.getNodeType(mem);
          if (calleeType is FunctionType) {
            if (argIdx < calleeType.parameters.length) {
              let paramType = calleeType.parameters[argIdx];
              if (paramType is FunctionType) {
                let paramCs = getClosureStruct(this.wasm, paramType);
                resolvedTargetStruct = paramCs;
                this.reachablyNamedClosures.add(paramCs);
                
                let paramValTypes = new GrowableArray<ValType>();
                paramValTypes.push(new ValTypeStructRef()); // context
                for (let p in paramType.parameters) {
                  mapParamTypeToWasmParams(this.wasm, p, paramValTypes);
                }
                let returnValTypes = new GrowableArray<ValType>();
                if (!isVoidOrNeverType(paramType.returnType)) {
                  returnValTypes.push(typeToValType(this.wasm, paramType.returnType));
                }
                expectedWasmSig = this.wasm.getSignature(paramValTypes, returnValTypes);
              }
            }
          }
        }
      }

      let wrapperSig = if (expectedWasmSig != null) {
        expectedWasmSig
      } else {
        let pValTypes = new GrowableArray<ValType>();
        pValTypes.push(new ValTypeStructRef()); // ctx
        for (let p in tgt.parameters) {
          mapParamTypeToWasmParams(this.wasm, p, pValTypes);
        }
        let rValTypes = new GrowableArray<ValType>();
        mapReturnTypeToWasmResults(this.wasm, tgt.returnType, rValTypes);
        this.wasm.getSignature(pValTypes, rValTypes)
      };

      let actualClosureStruct = getClosureStruct(this.wasm, src);
      this.reachablyNamedClosures.add(actualClosureStruct);
      if (resolvedTargetStruct == null) {
        let tgtCs = getClosureStruct(this.wasm, tgt);
        resolvedTargetStruct = tgtCs;
        this.reachablyNamedClosures.add(tgtCs);
      }
      
      let adaptKey = getFunctionAdaptationKey(src, tgt);
      let existingWrapper: WasmFunction | null = if (this.wasm.functionAdaptations.has(adaptKey)) {
        this.wasm.functionAdaptations[adaptKey]
      } else {
        null
      };

      if (existingWrapper != null) {
        existingWrapper.functionAdaptationResolvedSourceStruct = actualClosureStruct;
        existingWrapper.functionAdaptationResolvedTargetStruct = resolvedTargetStruct;
        this.wasm.functionAdaptationWrappers[expr] = existingWrapper;
        this.markFunctionReached(existingWrapper);
      } else {
        let wrapperFunc = new WasmFunction(wrapperSig, null, model);
        let fileBase = sanitizeName(getFileNameBase(getNodeFilePath(model, expr)));
        let locStr = if (expr.loc != null) {
          let loc = expr.loc as SourceLocation;
          "L" + i32ToString(loc.line) + "C" + i32ToString(loc.column)
        } else {
          i32ToString(expr.id as i32)
        };
        wrapperFunc.name = "function_adapt_" + fileBase + "_" + locStr;
        wrapperFunc.isFunctionAdaptation = true;
        wrapperFunc.isReferenceTaken = true;
        wrapperFunc.functionAdaptationSource = src;
        wrapperFunc.functionAdaptationTarget = tgt;
        wrapperFunc.functionAdaptationResolvedSourceStruct = actualClosureStruct;
        wrapperFunc.functionAdaptationResolvedTargetStruct = resolvedTargetStruct;
        
        this.wasm.addFunction(wrapperFunc);
        this.markFunctionReached(wrapperFunc);
        this.wasm.functionAdaptations[adaptKey] = wrapperFunc;
        this.wasm.functionAdaptationWrappers[expr] = wrapperFunc;
      }
    }

  }

  addReferencedInterfaceMember(ifaceStr: String): void {
    if (this.currentReachable) {
      if (this.referencedReachableInterfaceMembers.has(ifaceStr)) {
        return;
      }
      this.referencedReachableInterfaceMembers.add(ifaceStr);
      this.referencedInterfaceMembers.add(ifaceStr);
    } else {
      if (this.referencedInterfaceMembers.has(ifaceStr)) {
        return;
      }
      this.referencedInterfaceMembers.add(ifaceStr);
    }

    var parsed: ParsedInterfaceMemberRef | null = null;
    if (let (true, cached) = this.parsedInterfaceMemberRefs.get(ifaceStr)) {
      parsed = cached;
    } else {
      var dotIdx = -1;
      for (var i = 0; i < ifaceStr.length; i += 1) {
        if (ifaceStr.getByteAt(i) == 46) {
          dotIdx = i;
          break;
        }
      }
      if (dotIdx != -1) {
        let ifaceIdStr = ifaceStr.sliceBytes(0, dotIdx);
        let mName = ifaceStr.sliceBytes(dotIdx + 1, ifaceStr.length);
        let ifaceId = if (let (true, iid) = parseI32(ifaceIdStr)) iid else -1;
        let newRef = new ParsedInterfaceMemberRef(ifaceId as SymbolId, mName);
        this.parsedInterfaceMemberRefs[ifaceStr] = newRef;
        parsed = newRef;
      }
    }

    if (parsed != null) {
      let ifaceId = parsed.ifaceSymId;
      let {mName} = parsed;
      if (ifaceId as i32 != -1) {
        let symId = ifaceId;
        if (!this.referencedInterfaceMembersById.has(symId)) {
          this.referencedInterfaceMembersById[symId] = new GrowableArray<String>();
        }
        let list = this.referencedInterfaceMembersById[symId];
        var hasMem = false;
        for (let existing in list) {
          if (existing == mName) {
            hasMem = true;
            break;
          }
        }
        if (!hasMem) {
          list.push(mName);
        }

        if (let (true, pairList) = this.instantiatedClassesByInterface.get(symId)) {
          for (let pair in pairList) {
            let {cha} = this;
            let cType = pair.classType;
            let ifaceType = pair.interfaceType;
            let unspecIName = getInterfaceKey(ifaceType.genericSource ?? ifaceType);
            this.wasm.usedInterfaceMembers[getInterfaceMemberKey(unspecIName, mName)] = true;

            let mds = cha.findImplementingMethods(cType, mName);
            if (mds.length > 0) {
              for (let md in mds) {
                this.queueReferrer(new Referrer(false, noSymbolId, (md as Node).id as i32, this.getNodeModel(md as Node, this.getClassModel(cType)), cType, this.currentReachable));
              }
            } else {
              let acc = cha.findImplementingAccessor(cType, mName);
              if (acc != null) {
                this.queueReferrer(new Referrer(false, noSymbolId, (acc as Node).id as i32, this.getNodeModel(acc as Node, this.getClassModel(cType)), cType, this.currentReachable));
              } else if (mName.startsWith("get#") || mName.startsWith("set#")) {
                let fieldName = mName.sliceBytes(4, mName.length);
                let fd = cha.findImplementingField(cType, fieldName);
                if (fd != null) {
                  this.queueReferrer(new Referrer(false, noSymbolId, (fd as Node).id as i32, this.getNodeModel(fd as Node, this.getClassModel(cType)), cType, this.currentReachable));
                }
              }
            }
          }
        }
      }
    }
  }

  getModelPath(model: SemanticModel): String {
    return model.sourcePath;
  }

  getNodeModel(node: Node, defaultModel: SemanticModel): SemanticModel {
    let id = node.id as i32;
    if (this.nodeIdToModel.has(id)) {
      return this.nodeIdToModel[id];
    }
    return defaultModel;
  }

  getClassModel(ct: ClassType): SemanticModel {
    var curr: ClassType | null = ct;
    while (curr != null) {
      let lookupId = (curr.genericSource ?? curr).symbolId;
      if (this.classModels.has(lookupId)) {
        return this.classModels[lookupId];
      }
      if (this.program.modelIndex.symbolToModel.has(lookupId)) {
        return this.program.modelIndex.symbolToModel[lookupId];
      }
      curr = curr.superType;
    }
    return this.program.units[0].model;
  }

  getClassDeclType(classDecl: Node, model: SemanticModel): ClassType | null {
    let {cha} = this;
    if (cha.classDeclTypeCache.has(classDecl.id)) {
      return cha.classDeclTypeCache[classDecl.id];
    }
    let raw = model.getNodeType(classDecl);
    if (raw is ClassType) {
      cha.classDeclTypeCache[classDecl.id] = raw;
      return raw;
    }
    var sym = model.resolve(classDecl);
    if (sym == null && classDecl.loc != null) {
      sym = model.resolveByOffset((classDecl.loc as SourceLocation).start);
    }
    if (sym != null) {
      let bType = model.getBindingTypeDirect(sym);
      if (bType is ClassType) {
        cha.classDeclTypeCache[classDecl.id] = bType;
        return bType;
      }
    }
    return null;
  }

  findPreludeClass(name: String): ClassType | null {
    if (this.#preludeClassCache.has(name)) {
      return this.#preludeClassCache[name];
    }
    for (let unit in this.program.units) {
      let {model} = unit;
      let t = model.getExportType(name);
      if (t is ClassType) {
        this.#preludeClassCache[name] = t;
        return t;
      }
    }
    return null;
  }

  findPreludeInterface(name: String): InterfaceType | null {
    if (this.#preludeInterfaceCache.has(name)) {
      return this.#preludeInterfaceCache[name];
    }
    for (let unit in this.program.units) {
      let {model} = unit;
      let t = model.getExportType(name);
      if (t is InterfaceType) {
        this.#preludeInterfaceCache[name] = t;
        return t;
      }
    }
    return null;
  }

  /**
   * Is this a static the class TEMPLATE can carry? A static cannot name
   * the class's type parameters, so one that declares none of its own
   * has exactly one copy and the template holds it. One that DOES
   * declare its own is monomorphized per solved argument list, like a
   * generic function, and must not also be lowered at the erasure —
   * `Array.from<A>`'s body constructs an `Array<A>`, which at the
   * erasure is an `Array<anyref>` nothing ever instantiated.
   */
  #isMonomorphicStatic(mDef: MethodDefinition): boolean {
    if (!mDef.isStatic) { return false; }
    let tps = mDef.typeParameters;
    if (tps == null) { return true; }
    return tps.length == 0;
  }

  processQueues(): void {
    var lastInstantiatedCount = -1;
    while (this.instantiatedSpecializedClasses.size > lastInstantiatedCount) {
      lastInstantiatedCount = this.instantiatedSpecializedClasses.size;
      var progress = true;
      while (progress) {
        while (this.reachHead < this.reachableQueue.length || this.checkHead < this.checkableQueue.length) {
          var refItem: Referrer | null = null;
          if (this.reachHead < this.reachableQueue.length) {
            refItem = this.reachableQueue[this.reachHead];
            this.reachHead += 1;
          } else {
            refItem = this.checkableQueue[this.checkHead];
            this.checkHead += 1;
          }
          this.currentReachable = refItem.isReachable;
          this.inQueueWalk = true;
          this.walkingTemplateOf = if (refItem.classType != null &&
              !isConcrete(refItem.classType as ClassType)) {
            refItem.classType
          } else {
            null
          };
          let suffix = if (refItem.classType != null) "@" + (getClassKey(refItem.classType as ClassType) as String) else "";
          (if (refItem.isSymbol) "sym:" + i32ToString(refItem.symId as i32) else "node:" + i32ToString(refItem.nodeId)) + suffix;


          if (refItem.isSymbol) {
            let {symId} = refItem;
            let {model} = refItem;
            if (refItem.isReachable) {
              this.reachedGlobals.add(symId);
            }
            
            var funcExpr: Node | null = null;
            if (let (true, decl) = model.globalDeclarations.get(symId)) {
              let {visitor} = this;
              let resolver = (t: Type): Type => t;
              visitor.discoverNodeTypes(decl, model, resolver);
              if (decl is FunctionDeclaration) {
                visitor.discoverFunctionDeclaration(symId, decl, model);
              } else if (decl is VariableDeclaration) {
                visitor.discoverVariableDeclaration(symId, decl, model);
                if (decl.init is FunctionExpression) {
                  funcExpr = decl.init;
                }
              } else if (decl is DeclareFunction) {
                visitor.discoverDeclareFunction(decl, model);
              }
            }
            
            if (let (true, deps) = model.symbolDependencies.get(symId)) {
              this.traverseDependencies(deps, model, refItem.classType, refItem.typeArguments, funcExpr);
            }
          } else {
            let {nodeId} = refItem;
            var model = refItem.model;
            if (let (true, m) = this.nodeIdToModel.get(nodeId)) {
              model = m;
            }
            
            var memberSuffix = if (refItem.classType != null) "@" + (getClassKey(refItem.classType as ClassType) as String) else "";
            let {typeArguments} = refItem;
            if (typeArguments != null) {
              memberSuffix += "<" + getSpecializedName("", typeArguments) + ">";
            }
            let memberKey = i32ToString(nodeId) + memberSuffix;
            // A checkable visit records only `reachedMembers`, so a
            // later reachable visit of the same member still runs.
            // Collapsing the two skipped that second traversal, and
            // with it the marking of closures the first pass created
            // but left unreached — pruned from wasm.functions, they
            // kept index -1 while lowering still emitted a ref_func to
            // them.
            if (refItem.isReachable) {
              if (this.reachedReachableMembers.has(memberKey)) {
                continue;
              }
              this.reachedReachableMembers.add(memberKey);
              this.reachedMembers.add(memberKey);
            } else {
              if (this.reachedMembers.has(memberKey)) {
                continue;
              }
              this.reachedMembers.add(memberKey);
            }
            
            let node = if (this.nodeIdToNode.has(nodeId)) this.nodeIdToNode[nodeId] else null;
             if (node != null) {
              let {classType} = refItem;
              let {visitor} = this;
              let {specializer} = this;
              let resolver = (t: Type): Type => {
                var res = substituteTypeParamsInClassContext(this.wasm, classType, t);
                // The parameters these arguments bind, when this
                // referrer is one monomorphization of the walked node:
                // the node's own — a generic arrow (FunctionExpression)
                // or a generic METHOD (MethodDefinition) — or, for a
                // CLOSURE specialized per enclosing instantiation, the
                // enclosing generic function's. The same lookup
                // traverseDependencies uses.
                if (refItem.typeArguments != null) {
                  let typeParameters = enclosingOwnTypeParameters(model, node);
                  if (typeParameters != null) {
                    res = substituteTypeParamsInCodegen(this.wasm, typeParameters, refItem.typeArguments as Array<Type>, res);
                  }
                }
                return res;
              };
              if (!model.nodeDependencies.has(nodeId)) {
                visitor.discoverNodeTypes(node, model, resolver);
              } else {
                visitor.registerLiterals(node);
                visitor.registerInstantiations(node, model, resolver,
                    if (refItem.classType != null) refItem.classType as ClassType else null);
              }
              // A referrer whose class is an ERASURE registers nothing:
              // the erasure has a struct and no methods, and every value
              // it stands for belongs to some real specialization that
              // queues its own referrer.
              let refClassIsErasure = refItem.classType != null &&
                  containsErasedType(refItem.classType as Type);
              if (node is MethodDefinition && refItem.classType != null && !refClassIsErasure) {
                let ct = refItem.classType as ClassType;
                getClassKey(ct);
                let lookupId = (ct.genericSource ?? ct).symbolId;
                let cd = if (let (true, decl) = this.classDecls.get(lookupId)) decl else null;
                // Mixin-declared methods carry the mixin's private
                // scope key, and mixin PRIVATE methods register under
                // it — mirroring the member-collection loops, so this
                // node-driven path never creates an unscoped twin.
                let mixScope = mixinScopeOfMember(this.program, this.classModels[lookupId], cd, node);
                let nodeModel = mixinModelOfMember(this.program, this.classModels[lookupId], cd, node) ?? this.classModels[lookupId];
                var methName = getMethodName(node);
                if (mixScope != null && methName.length > 0 &&
                    methName.sliceBytes(0, 1) == "#") {
                  methName = mixScope + "::" + methName;
                }
                let regF = specializer.registerClassMethod(ct, cd, methName, node, false, false, null, nodeModel, null);
                regF.declaringType = findDeclaringMixinIntermediate(ct, this.classDecls, node);
                applyMixinPrivateScope(regF, node, mixScope);
                // A REACHABLE member referrer is the evidence that
                // used to be implied by the vtable force-reach:
                // registration alone is erased by layout()'s
                // classMethodMap rebuild (binary-size.md §3a). Only
                // for CONCRETE classes — a template referrer registers
                // the unspecialized copy, and reaching that is
                // 'non-concrete function reached'; the fan-out queues
                // a concrete referrer per specialization. NOT for
                // constructors: their evidence is a `new` site (which
                // pends them by key) — the checker's records name
                // ctors for paths that never call one, and reaching
                // here emitted a constructor in every literal-only
                // String program.
                // A static is the one exception to the concreteness
                // rule. It cannot name the class's type parameters, so
                // there is exactly one copy of it and the template
                // carries it: `Holder.answer()` has nothing to bind.
                //
                // A static that declares its OWN parameters is the
                // opposite case and is held out entirely: its copies are
                // the monomorphizations, which the call site looks up by
                // specialized name. Registering the unspecialized one
                // too lowers its body at the erasure, where
                // `new GrowableArray<A>` is an `Array<anyref>` nothing ever
                // constructed.
                let genericStatic = node.isStatic &&
                    !this.#isMonomorphicStatic(node);
                // A GENERIC method registered with no type arguments is
                // the body at the method's OWN erasure, and there is no
                // such function: `map<R>` exists once per R, each with
                // its own signature, minted by registerGenericMethodUse
                // at the call site. Reaching the erased registration
                // emitted one dead body per specialization of the class
                // (80 `Array<X>.map` in the compiler's own module,
                // referenced by nothing) — and each one built its result
                // with `new GrowableArray<R>`, which is the only thing that ever
                // made an ERASURE look constructible.
                let {typeParameters} = regF;
                let isGenericAtErasure = typeParameters != null &&
                    typeParameters.length > 0 &&
                    regF.typeArguments == null;
                if (refItem.isReachable && !genericStatic && !isGenericAtErasure &&
                    (isConcrete(ct) || this.#isMonomorphicStatic(node)) &&
                    methName != "<constructor>") {
                  // The statics' backing globals hang off reaching a
                  // static, not off instantiating the class — a generic
                  // class whose statics are all anyone uses is never
                  // instantiated, and its counter still has to exist.
                  if (node.isStatic && cd is ClassDeclaration) {
                    specializer.discoverStaticFields(
                        ct, cd, this.classModels[lookupId]);
                  }
                  this.wasm.addFunction(regF);
                  this.markFunctionReached(regF);
                }
              } else if (node is AccessorDeclaration && refItem.classType != null && !refClassIsErasure) {
                let ct = refItem.classType as ClassType;
                getClassKey(ct);
                let accName = match (node.name) {
                  case Identifier {name}: name
                  case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                    case Identifier {name}: name
                    case MemberExpression {property}: property.name
                    case _: "<symbol>"
                  }
                  case _: ""
                };
                if (accName != "") {
                  let lookupId = (ct.genericSource ?? ct).symbolId;
                  let cd = if (let (true, decl) = this.classDecls.get(lookupId)) decl else null;
                  let mixScope = mixinScopeOfMember(this.program, this.classModels[lookupId], cd, node);
                  let nodeModel = mixinModelOfMember(this.program, this.classModels[lookupId], cd, node) ?? this.classModels[lookupId];
                  // A mixin's PRIVATE accessor registers under the
                  // mixin's scope key, exactly as the method arm above
                  // and the member-collection loops do. Registering the
                  // bare name here would mint an unscoped twin on the
                  // host — a second function under the name the host's
                  // own accessor owns — and leave the name the mixin
                  // body actually looks up unregistered.
                  let isPrivateAcc = accName.length > 0 && accName.sliceBytes(0, 1) == "#";
                  let accPrefix = if (mixScope != null && isPrivateAcc) {
                    mixScope + "::"
                  } else {
                    ""
                  };
                  if (node.getter != null) {
                    let regG = specializer.registerClassMethod(ct, cd, accPrefix + "get#" + accName, node, false, false, null, nodeModel, null);
                    regG.declaringType = findDeclaringMixinIntermediate(ct, this.classDecls, node);
                    applyMixinPrivateScope(regG, node, mixScope);
                    if (refItem.isReachable && isConcrete(ct)) {
                      this.wasm.addFunction(regG);
                      this.markFunctionReached(regG);
                    }
                  }
                  let {setter} = node;
                  if (setter != null) {
                    let regS = specializer.registerClassMethod(ct, cd, accPrefix + "set#" + accName, setter, false, false, null, nodeModel, null);
                    regS.declaringType = findDeclaringMixinIntermediate(ct, this.classDecls, setter as Node);
                    applyMixinPrivateScope(regS, setter, mixScope);
                    if (refItem.isReachable && isConcrete(ct)) {
                      this.wasm.addFunction(regS);
                      this.markFunctionReached(regS);
                    }
                  }
                }
              } else if (node is FieldDefinition && refItem.classType != null) {
                let ct = refItem.classType as ClassType;
                let cKey = getClassKey(ct);
                let propName = match (node.name) {
                  case Identifier {name}: name
                  case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                    case Identifier {name}: name
                    case MemberExpression {property}: property.name
                    case _: "<symbol>"
                  }
                  case _: ""
                };
                let {typeParameters} = ct;
                let isGenericTemplate = typeParameters != null && 
                                        typeParameters.length > 0 && 
                                        (ct.typeArguments == null || !isConcrete(ct));
                if (propName != "" && !isGenericTemplate) {
                  let getterKey = getClassMethodKey(cKey, "get#" + propName);
                  if (let (true, f) = this.wasm.classMethodMap.get(getterKey)) {
                    this.markFunctionReached(f);
                  } else if (refItem.isReachable) {
                    this.#pendingMemberReaches.push(getterKey);
                  }
                  let setterKey = getClassMethodKey(cKey, "set#" + propName);
                  if (let (true, f) = this.wasm.classMethodMap.get(setterKey)) {
                    this.markFunctionReached(f);
                  } else if (refItem.isReachable) {
                    this.#pendingMemberReaches.push(setterKey);
                  }
                }
              }
            }
            
            if (let (true, deps) = model.nodeDependencies.get(nodeId)) {
              this.traverseDependencies(deps, model, refItem.classType, refItem.typeArguments, node);
            }
          }
        }
        this.inQueueWalk = false;
        this.walkingTemplateOf = null;
        
        progress = false;
        this.currentReachable = true;
        let endIdx = this.wasm.globals.length;
        while (this.globalsHead < endIdx) {
          let g = this.wasm.globals[this.globalsHead];
          this.globalsHead += 1;
          this.markValTypeReached(g.type);
          let {initVTable} = g;
          if (initVTable != null) {
            let vtableInit = initVTable;
            this.markTypeReached(vtableInit.structType);
            for (let func in vtableInit.funcs) {
              if (!this.reachedFunctionsSet.has(func)) {
                this.markFunctionReached(func);
                progress = true;
              }
            }
          }
        }
      }
    }
  }
}

/**
 * The function-own type-parameter list a node's walk substitutes
 * against: the node's own, when its checked type carries one, else the
 * nearest enclosing FunctionExpression or MethodDefinition's. A
 * closure has no parameters of its own, so this is how its walk finds
 * the axis its Referrer's typeArguments belong to — the enclosing
 * generic function's. Stops at a class boundary: the class's
 * parameters are a separate axis, substituted from the walk's
 * classType.
 */
let enclosingOwnTypeParameters = (model: SemanticModel, node: Node): Array<TypeParameterType> | null => {
  var curr: Node | null = node;
  while (curr != null) {
    let c = curr as Node;
    if (c is FunctionExpression || c is MethodDefinition) {
      let t = model.getNodeType(c);
      if (t is FunctionType) {
        let tps = t.typeParameters;
        if (tps != null && tps.length > 0) {
          return tps;
        }
      }
    }
    if (c is ClassDeclaration) {
      return null;
    }
    curr = model.getParent(c);
  }
  return null;
};

let getMethodName = (md: MethodDefinition): String => {
  return match (md.name) {
    case Identifier {name}: name
    case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
      case Identifier {name}: name
      case MemberExpression {property}: property.name
      case _: "<symbol>"
    }
    case _: ""
  };
};


let getNodeFilePath = (model: SemanticModel, node: Node): String => {
  var curr: Node | null = node;
  while (curr != null) {
    if (curr is Module) {
      return curr.path;
    }
    curr = model.getParent(curr);
  }
  return "";
};

let getFileNameBase = (path: String): String => {
  var lastSlash = -1;
  var i = 0;
  let len = path.length;
  while (i < len) {
    if (path.sliceBytes(i, i + 1) == "/" || path.sliceBytes(i, i + 1) == "\\") {
      lastSlash = i;
    }
    i += 1;
  }
  if (lastSlash >= 0) {
    return path.sliceBytes(lastSlash + 1, len);
  }
  return path;
};

let sanitizeName = (s: String): String => {
  let sb = new StringBuilder();
  var i = 0;
  let len = s.length;
  while (i < len) {
    let char = s.sliceBytes(i, i + 1);
    if (char == "." || char == "-" || char == "/" || char == "\\") {
      sb.append("_");
    } else {
      sb.append(char);
    }
    i += 1;
  }
  return sb.toString();
};

