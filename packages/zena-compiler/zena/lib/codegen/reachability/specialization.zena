import { Referrer, ReachabilityContext, SpecializerInterface, ClassInterfacePair, TypeLowererInterface } from './context.zena';
import { ClassHierarchyAnalysis } from './hierarchy.zena';
import { SemanticModel } from '../../semantic-model.zena';
import { Type, ClassType, InterfaceType, FunctionType, TypeParameterType, VoidType, BooleanType, I32Type, MethodInfo, FieldInfo } from '../../types.zena';
import { Node, ClassDeclaration, FieldDefinition, MethodDefinition, AccessorDeclaration, VariableDeclaration, FunctionDeclaration, IdentifierPattern, Decorator, Identifier, SymbolPropertyName, MemberExpression, TypeParameter, SealedVariant, TypeAnnotation, InterfaceDeclaration, Expression, MixinDeclaration } from '../../ast.zena';
import { WasmStruct, WasmField, WasmGlobal, WasmFunction, ClassCodegenInfo } from '../wasm-module.zena';
import { ValType, ValTypeVoid, ValTypeI32, ValTypeRefNull, ValTypeAnyRef, ValTypeRef, ValTypeStructRef, ValTypeFuncRef, valTypeToOpcode } from '../wasm.zena';
import { SymbolId, noSymbolId } from '../../scope/symbol.zena';
import { HashMap } from 'zena:map';
import { HashSet } from 'zena:set';
import { Array } from 'zena:array';
import { String } from 'zena:string';
import { i32ToString } from 'zena:string-convert';
import { getClassKey, getInterfaceKey, getClassMethodKey, getClassInterfaceKey, getSignatureKey, matchOverload, collectMixinMembers, getMemberRootClass, getClassPrivateFieldKey, getSpecializedFunctionKey, getSpecializedName, isConcrete, MixinKey, containsErasedType } from '../codegen-utils.zena';
import { typeToValType, mapReturnTypeToWasmResults, mapParamTypeToWasmParams, substituteTypeParamsInCodegen, getClassTypeParameters, getInterfaceTypeParameters, getInterfaceMemberSignature } from '../type-mapping.zena';

/**
 * A struct field whose class type was not yet registered when the
 * struct was laid out, so its valtype was baked as the `structref`
 * fallback. Discovery can register (and instantiate) the class AFTER
 * that bake — a body walked late does exactly this — and then the
 * class's method signatures are precise while the field is erased,
 * which fails receiver conformance in lowering. Recorded at the bake
 * site and re-resolved in place once discovery settles.
 */
final class ErasedFieldBake {
  field: WasmField;
  fieldType: Type;
  new(this.field, this.fieldType);
}

/**
 * Specializer handles the monomorphization of generic classes and functions,
 * generating runtime specialized structures, vtables, and method wrappers.
 */
export final class Specializer implements SpecializerInterface {
  pass: ReachabilityContext;

  /** Fields baked erased before their class type existed; see ErasedFieldBake. */
  #erasedFieldBakes = new Array<ErasedFieldBake>();

  new(this.pass);

  /**
   * Re-resolves fields that were baked as `structref` because their
   * class type had no registration at layout time. Runs once discovery
   * has fully settled — the same moment the settled layout pass
   * catches structs that were instantiated late — so a field of a
   * late-registered class agrees with that class's (now precise)
   * method signatures. A field whose type still does not resolve stays
   * erased, which is the pre-existing consistent-erasure behavior.
   *
   * Mutates the WasmField in place: inherited fields are shared
   * instances between super- and subclass structs, and the write must
   * be visible through both.
   */
  refreshErasedFieldTypes(): void {
    for (let bake in this.#erasedFieldBakes) {
      let valType = typeToValType(this.pass.wasm, bake.fieldType);
      if (valType is ValTypeRef) {
        bake.field.type = new ValTypeRefNull((valType as ValTypeRef).target);
      }
    }
  }

  /**
   * Create the globals backing a class's static fields. One global per
   * field, named for the class rather than any specialization, because a
   * static cannot name the class's type parameters and so does not vary
   * with them.
   *
   * Driven by reaching a static, NOT by instantiating the class: a
   * generic class whose statics are all anyone uses is never
   * instantiated, and its counter still has to exist.
   */
  discoverStaticFields(classType: ClassType, cd: ClassDeclaration,
      model: SemanticModel): void {
    for (let member in cd.body) {
      if (!(member is FieldDefinition)) { continue; }
      let fd = member as FieldDefinition;
      if (!fd.isStatic) { continue; }
      let fieldName = match (fd.name) {
        case Identifier {name}: name
        case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
          case Identifier {name}: name
          case MemberExpression {property}: property.name
          case _: "<symbol>"
        }
        case _: ""
      };
      if (fieldName == "") { continue; }
      let name = cd.name.name + "_" + fieldName;
      // One global per class, not per specialization: two instantiations
      // of a generic class share the cell, and reaching a static can now
      // get here without any instantiation at all.
      var already = false;
      for (let existing in this.pass.wasm.globals) {
        if (existing.name == name) { already = true; }
      }
      if (already) { continue; }
      let fType = if (classType.members.has(fieldName)) {
        classType.members[fieldName].type
      } else {
        model.getNodeType(fd)
      };
      let vType = typeToValType(this.pass.wasm, fType as Type);
      let initExp: Expression | null = if (fd.value != null) { fd.value as Expression } else { null };
      this.pass.wasm.globals.push(
          new WasmGlobal(name, fieldName, vType, true, initExp, null, model));
    }
  }

  instantiateClassType(classType: ClassType, model: SemanticModel): void {
    if (!this.pass.isRtaActive) {
      return;
    }
    if (!isConcrete(classType)) {
      return;
    }
    let cha = this.pass.cha;
    let typeLowerer = this.pass.typeLowerer;
    let cKey = getClassKey(classType) as String;
    if (this.pass.instantiatedSpecializedClasses.has(cKey)) {
      return;
    }
    if (this.pass.instantiationClosed) {
      throw new Error("class instantiated after layout began: " + cKey);
    }
    this.pass.instantiatedSpecializedClasses.add(cKey);
    cha.registerInstantiatedClass(classType);

    // Instantiation promotes constructors only for DEMANDED generics —
    // ones with a `new` site somewhere (queueExplicitCtor records the
    // demand; concrete sites also pend by key). Unconditional
    // promotion emitted a constructor nothing calls in every
    // literal-only String program — string_from_shared builds its
    // String with struct.new directly.
    if (this.pass.ctorDemandedGenerics.has((classType.genericSource ?? classType).symbolId)) {
      if (let (true, funcs) = this.pass.wasm.classMethods.get(cKey)) {
        for (let func in funcs) {
          if (func.methodName != null &&
              (func.methodName as String) == "<constructor>" &&
              !this.pass.reachedFunctionsSet.has(func)) {
            this.pass.wasm.addFunction(func);
            this.pass.markFunctionReached(func);
            // See #reachSuperConstructors: `: super(...)` calls it.
            this.#reachSuperConstructors(classType);
          }
        }
      }
    }

    /*
    if (let (true, funcs) = this.pass.wasm.classMethods.get(cKey)) {
      for (let func in funcs) {
        if (!this.pass.reachedFunctionsSet.has(func)) {
          this.pass.wasm.addFunction(func);
          this.pass.markFunctionReached(func);
        }
      }
    }
    */

    // A specialization's concrete class type arguments are
    // instantiated with it: if `FixedArray<String>` exists then String
    // values exist, and its `contains` lowers to String's `==`. While
    // String was instantiated unconditionally this held by accident.
    if (classType.typeArguments != null) {
      for (let ta in (classType.typeArguments as Array<Type>)) {
        if (ta is ClassType && isConcrete(ta as ClassType)) {
          let taCt = ta as ClassType;
          if (getClassKey(taCt) != getClassKey(classType)) {
            this.instantiateClassType(taCt, this.pass.getClassModel(taCt));
          }
        }
      }
    }

    let unspecC = classType.genericSource ?? classType;
    let classId = unspecC.symbolId;
    this.pass.instantiatedClasses.add(classId);
    if (this.pass.specializedClassTypes.has(classId)) {
      let list = this.pass.specializedClassTypes[classId];
      for (let specCt in list) {
        this.instantiateClassType(specCt, this.pass.getClassModel(specCt));
      }
    }

    // Keep == and hashCode for any instantiated class if they exist,
    // as they can be called virtually by generic operations and HashMap/HashSet.
    let unspecModel = this.pass.getClassModel(classType);

    // Propagate all reached members of the base class to this new instantiation
    if (let (true, reachedSet) = this.pass.reachedClassMembers.get(classId)) {
      let rcKeys = reachedSet.keys();
      while (let (true, memberNodeId) = rcKeys.next()) {
        let memberModel = if (this.pass.nodeIdToModel.has(memberNodeId)) {
          this.pass.nodeIdToModel[memberNodeId]
        } else {
          unspecModel
        };
        this.pass.queueReferrer(new Referrer(false, noSymbolId, memberNodeId, memberModel, classType, false));
      }
    }
    if (let (true, reachedSet) = this.pass.reachedReachableClassMembers.get(classId)) {
      let rrKeys = reachedSet.keys();
      while (let (true, memberNodeId) = rrKeys.next()) {
        let memberModel = if (this.pass.nodeIdToModel.has(memberNodeId)) {
          this.pass.nodeIdToModel[memberNodeId]
        } else {
          unspecModel
        };
        this.pass.queueReferrer(new Referrer(false, noSymbolId, memberNodeId, memberModel, classType, true));
      }
    }
    // ==/hashCode referrers follow the same evidence as their slots:
    // without erased equality anywhere, instantiation alone is not a
    // reason to emit them. Direct `a == b` on concrete receivers
    // reaches the operator through its own member records.
    if (this.pass.equalityDispatchUsed) {
      let eqMethod = cha.findImplementingMethod(classType, "==");
      if (eqMethod != null) {
        this.pass.queueReferrer(new Referrer(false, noSymbolId, (eqMethod as Node).id as i32, this.pass.getNodeModel(eqMethod as Node, unspecModel), classType, this.pass.currentReachable));
      }
      let hashMethod = cha.findImplementingMethod(classType, "hashCode");
      if (hashMethod != null) {
        this.pass.queueReferrer(new Referrer(false, noSymbolId, (hashMethod as Node).id as i32, this.pass.getNodeModel(hashMethod as Node, unspecModel), classType, this.pass.currentReachable));
      }
    }

    if (classType.superType != null) {
      let superType = classType.superType as ClassType;
      this.instantiateClassType(superType, this.pass.getClassModel(superType));
    }

    typeLowerer.discoverType(classType, model);

    let classDecl = this.pass.classDecls[classId];

    if (classDecl != null && classDecl is ClassDeclaration) {
      let cd = classDecl as ClassDeclaration;
      this.discoverStaticFields(classType, cd, model);

      // Check if there is an explicit constructor
      var hasExplicitCtor = false;
      for (let member in cd.body) {
        if (member is MethodDefinition) {
          let md = member as MethodDefinition;
          if (getMethodName(md) == "<constructor>") {
            hasExplicitCtor = true;
          }
        }
      }

      if (!hasExplicitCtor && !classType.isExtension) {
        this.registerClassMethod(classType, cd, "<constructor>", null, false, false, null, model);
      }

      // Discover constructor and field initializers
      for (let member in cd.body) {
        if (member is MethodDefinition) {
          let md = member as MethodDefinition;
          let mName = getMethodName(md);
          if (mName == "<constructor>") {
            this.pass.queueReferrer(new Referrer(false, noSymbolId, (md as Node).id as i32, model, classType, this.pass.currentReachable));
          }
        } else if (member is FieldDefinition) {
          let fd = member as FieldDefinition;
          if (fd.value != null) {
            this.pass.queueReferrer(new Referrer(false, noSymbolId, (fd as Node).id as i32, model, classType, this.pass.currentReachable));
          }
        }
      }
    } else if (classDecl != null && classDecl is SealedVariant) {
      if (!classType.isExtension) {
        this.registerClassMethod(classType, null, "<constructor>", null, false, false, null, model);
      }
    } else {
      if (!classType.isExtension) {
        this.registerClassMethod(classType, null, "<constructor>", null, false, false, null, model);
      }
    }
    
    // Implements list logic
    let allIfaces = cha.collectAllImplementedInterfaces(classType);
    for (let iface in allIfaces) {
      let unspecI = iface.genericSource ?? iface;
      let ifaceId = unspecI.symbolId;
      
      if (!this.pass.instantiatedClassesByInterface.has(ifaceId)) {
        this.pass.instantiatedClassesByInterface[ifaceId] = new Array<ClassInterfacePair>();
      }
      let list = this.pass.instantiatedClassesByInterface[ifaceId];
      var hasC = false;
      for (let existing in list) {
        if (getClassKey(existing.classType) == getClassKey(classType)) {
          hasC = true;
          break;
        }
      }
      if (!hasC) {
        list.push(new ClassInterfacePair(classType, iface));
        
        // Trigger RTA: for any already-referenced member of this interface,
        // the class's implementing method becomes reachable!
        if (let (true, refMems) = this.pass.referencedInterfaceMembersById.get(ifaceId)) {
          for (let mName in refMems) {
            let targetClassType = classType;
            let targetModel = this.pass.getClassModel(targetClassType);
            let refMemKey = i32ToString(ifaceId as i32) + "." + mName;
            let isReachable = this.pass.referencedReachableInterfaceMembers.has(refMemKey);
            let mds = cha.findImplementingMethods(targetClassType, mName);
            if (mds.length > 0) {
              for (let md in mds) {
                this.pass.queueReferrer(new Referrer(false, noSymbolId, (md as Node).id as i32, this.pass.getNodeModel(md as Node, targetModel), targetClassType, isReachable));
              }
            } else {
              let acc = cha.findImplementingAccessor(targetClassType, mName);
              if (acc != null) {
                this.pass.queueReferrer(new Referrer(false, noSymbolId, (acc as Node).id as i32, this.pass.getNodeModel(acc as Node, targetModel), targetClassType, isReachable));
              } else if (mName.startsWith("get#") || mName.startsWith("set#")) {
                let fieldName = mName.sliceBytes(4, mName.length);
                let fd = cha.findImplementingField(targetClassType, fieldName);
                if (fd != null) {
                  this.pass.queueReferrer(new Referrer(false, noSymbolId, (fd as Node).id as i32, this.pass.getNodeModel(fd as Node, targetModel), targetClassType, isReachable));
                }
              }
            }
          }
        }
      }
    }
  }

  registerSpecializedClass(ct: ClassType, classDecl: Node | null, sourceModel: SemanticModel): void {

    if (ct.name == "Node" || ct.name.endsWith("Node")) {
      throw new Error("registerSpecializedClass called for Node-like: " + ct.name + " id=" + i32ToString(ct.id as i32));
    }
    let cKey = getClassKey(ct);
    if (this.pass.wasm.classInfos.has(cKey)) {
      return;
    }
    let ctVtable = this.pass.wasm.classVtable(cKey);

    let ctParams = getClassTypeParameters(ct);
    let isErasedClass = containsErasedType(ct as Type);

    // 1. Pre-register empty structs
    let structName = cKey as String;
    let emptyStruct = new WasmStruct(structName, new Array<WasmField>());
    emptyStruct.classType = ct;
    this.pass.wasm.types.push(emptyStruct);
    let info = new ClassCodegenInfo(emptyStruct);
    this.pass.wasm.classInfos[cKey] = info;

    let emptyVTableStruct = new WasmStruct(structName + "_VTable", new Array<WasmField>());
    emptyVTableStruct.classType = ct;
    this.pass.wasm.types.push(emptyVTableStruct);
    info.vtableStructType = emptyVTableStruct;

    // 2. Link super types
    if (ct.superType != null) {
      let superCt = ct.superType as ClassType;
      this.pass.typeLowerer.discoverType(superCt, sourceModel);
      
      let superKey = getClassKey(superCt);
      if (let (true, superInfo) = this.pass.wasm.classInfos.get(superKey)) {
        emptyStruct.superStruct = superInfo.structType;
        if (superInfo.vtableStructType != null) {
          emptyVTableStruct.superStruct = superInfo.vtableStructType as WasmStruct;
        }
      }

      let superVtable = this.pass.wasm.classVtable(superKey);
      if (superVtable.length > 0 || ctVtable.length > 0) {
        let newVTable = new Array<String>();
        for (let methName in superVtable) {
          newVTable.push(methName);
        }
        for (let methName in ctVtable) {
          var hasMeth = false;
          for (let existing in newVTable) {
            if (existing == methName) { hasMeth = true; break; }
          }
          if (!hasMeth) {
            newVTable.push(methName);
          }
        }
        while (ctVtable.length > 0) {
          ctVtable.pop();
        }
        for (let m in newVTable) {
          ctVtable.push(m);
        }
      }
    }

    if (ct.isCaseClass && !isErasedClass) {
      var hasEq = false;
      var hasHash = false;
      for (let existing in ctVtable) {
        if (existing == "==") { hasEq = true; }
        if (existing == "hashCode") { hasHash = true; }
      }
      if (!hasEq) {
        ctVtable.push("==");
      }
      if (!hasHash) {
        ctVtable.push("hashCode");
      }
    }

    // 3. Discover referenced types in members (fields)
    let typeLowerer = this.pass.typeLowerer;
    let cha = this.pass.cha;
    for (let pair in ct.members) {
      if (pair.value is FieldInfo) {
        let resolvedType = substituteTypeParamsInCodegen(this.pass.wasm, ctParams, ct.typeArguments, pair.value.type);
        typeLowerer.discoverType(resolvedType, sourceModel);
      }
    }

    let specIfaces = cha.collectAllImplementedInterfaces(ct);
    for (let iface in specIfaces) {
      typeLowerer.discoverType(iface, sourceModel);
    }

    // An ERASURE gets a struct and nothing else. Erased signatures and
    // fields name the struct, so it has to exist — but no value is ever
    // of the erased class, so no method on it can be called. Registering
    // them anyway put one dead body per method per erased class in every
    // module (87 in the compiler's own, referenced by nothing), and gave
    // the vtable slots an erased body of every method to force-reach —
    // which is what fails to lower when a method uses `hash`/`eq`, since
    // those dispatch on their operand's type.
    if (isErasedClass) {
      this.populateClassStructAndMethods(ct, classDecl, sourceModel);
      return;
    }

    // 4. Populate VTable slots and structs
    let mixinMembers = new Array<Node>();
    let mixinScopes = new Array<String>();
    let seenMixins = new HashMap<MixinKey, boolean>();
    let classDeclCd = if (classDecl != null && classDecl is ClassDeclaration) classDecl as ClassDeclaration else null;
    if (classDeclCd != null) {
      collectMixinMembers(this.pass.program, sourceModel, classDeclCd.mixins, mixinMembers, seenMixins, mixinScopes);
    }

    let allMembers = new Array<Node>();
    let allScopes = new Array<String>();
    if (classDeclCd != null) {
      for (let ms in classDeclCd.body) {
        allMembers.push(ms);
        allScopes.push("");
      }
    }
    

    for (var mmi = 0; mmi < mixinMembers.length; mmi += 1) {
      allMembers.push(mixinMembers[mmi]);
      allScopes.push(mixinScopes[mmi]);
    }

    for (let ms in allMembers) {
      if (ms is MethodDefinition) {
        let mDef = ms as MethodDefinition;
        if (mDef.isStatic) { continue; }
        let methName = match (mDef.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: ""
        };
        if (methName != "") {
          var vtableMethName = methName;
          if (ct.members.has(methName)) {
            let mInfo = ct.members[methName];
            if (mInfo.type is FunctionType) {
              let ft = mInfo.type as FunctionType;
              let specificType = matchOverload(sourceModel, ft, mDef);
              if (specificType != null) {
                vtableMethName = methName + getSignatureKey(specificType as FunctionType);
              }
            }
          }
          
          var found = false;
          for (let existing in ctVtable) {
            if (existing == vtableMethName) { found = true; }
          }
          // Private methods are never virtual (member-lookup.md §6):
          // they get no vtable slot and are always called directly.
          let isPrivateMeth = methName.length > 0 && methName.sliceBytes(0, 1) == "#";
          // Neither is a GENERIC method: a slot holds one `ref.func`
          // of one signature, and a generic method has no single body
          // — it exists once per specialization, each with its own.
          let isGenericMeth = mDef.typeParameters != null &&
              (mDef.typeParameters as Array<TypeParameter>).length > 0;
          if (!found && methName != "<constructor>" && !isPrivateMeth && !isGenericMeth) {
            ctVtable.push(vtableMethName);
          }
        }
      } else if (ms is AccessorDeclaration) {
        let acc = ms as AccessorDeclaration;
        if (acc.isStatic) { continue; }
        let accName = match (acc.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: ""
        };
        // Private-named accessors are lexical, never virtual: no
        // vtable slots (like private methods).
        if (accName != "" &&
            !(accName.length > 0 && accName.sliceBytes(0, 1) == "#")) {
          if (acc.getter != null) {
            let getterName = "get#" + accName;
            var found = false;
            for (let existing in ctVtable) {
              if (existing == getterName) { found = true; break; }
            }
            if (!found) { ctVtable.push(getterName); }
          }
          if (acc.setter != null) {
            let setterName = "set#" + accName;
            var found = false;
            for (let existing in ctVtable) {
              if (existing == setterName) { found = true; break; }
            }
            if (!found) { ctVtable.push(setterName); }
          }
        }
      } else if (ms is FieldDefinition) {
        let fd = ms as FieldDefinition;
        if (fd.isStatic) { continue; }
        let fieldName = match (fd.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: ""
        };
        if (fd.setterName != null && fieldName != "") {
          let getterName = "get#" + fieldName;
          var found = false;
          for (let existing in ctVtable) {
            if (existing == getterName) { found = true; break; }
          }
          if (!found) { ctVtable.push(getterName); }
        }
        if (fd.isAbstract && fieldName != "") {
          let getterName = "get#" + fieldName;
          var found = false;
          for (let existing in ctVtable) {
            if (existing == getterName) { found = true; break; }
          }
          if (!found) { ctVtable.push(getterName); }
          if (fd.mutability != null && fd.mutability == "var") {
            let setterName = "set#" + fieldName;
            var foundS = false;
            for (let existing in ctVtable) {
              if (existing == setterName) { foundS = true; break; }
            }
            if (!foundS) { ctVtable.push(setterName); }
          }
        }
        if (fd.isDeclare && fieldName != "") {
          let getterName = "get#" + fieldName;
          var found = false;
          for (let existing in ctVtable) {
            if (existing == getterName) { found = true; break; }
          }
          if (!found) { ctVtable.push(getterName); }
        }
      }
    }

    // 5. Register specialized methods
    var msIdx = -1;
    for (let ms in allMembers) {
      msIdx += 1;
      // Mixin-declared members get the mixin's private scope key so
      // their bodies resolve "#" fields to the mixin's namespaced
      // struct fields (WasmFunction.privateScopeKey).
      let msScope = allScopes[msIdx];

      if (ms is MethodDefinition) {
        let method = ms as MethodDefinition;
        if (method.isAbstract) { continue; }
        if (method.typeParameters != null && (method.typeParameters as Array<TypeParameter>).length > 0) {
          continue;
        }
        let methName = match (method.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };
        // Mixin private methods register under the mixin's scope key
        // ("<scope>::#name") so a host's same-named private is a
        // different function; bodies from mixins carry the scope for
        // their own private accesses.
        var regName = methName;
        if (msScope != "" && methName.length > 0 && methName.sliceBytes(0, 1) == "#") {
          regName = msScope + "::" + methName;
        }
        let regFn = this.registerClassMethod(ct, classDecl, regName, method as Node, false, false, null, sourceModel);
        if (msScope != "") { regFn.privateScopeKey = msScope; }
      } else if (ms is AccessorDeclaration) {
        let acc = ms as AccessorDeclaration;
        let accName = match (acc.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };
        let isPrivateAcc = accName.length > 0 && accName.sliceBytes(0, 1) == "#";
        if (acc.getter != null) {
          var getterRegName = "get#" + accName;
          if (isPrivateAcc && msScope != "") {
            getterRegName = msScope + "::" + getterRegName;
          }
          let regG = this.registerClassMethod(ct, classDecl, getterRegName, acc as Node, false, false, null, sourceModel);
          if (msScope != "") { regG.privateScopeKey = msScope; }
        }
        if (acc.setter != null) {
          var setterRegName = "set#" + accName;
          if (isPrivateAcc && msScope != "") {
            setterRegName = msScope + "::" + setterRegName;
          }
          let regS = this.registerClassMethod(ct, classDecl, setterRegName, acc.setter as Node, false, false, null, sourceModel);
          if (msScope != "") { regS.privateScopeKey = msScope; }
        }
      } else if (ms is FieldDefinition) {
        let fd = ms as FieldDefinition;
        let fieldName = match (fd.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<unknown>"
          }
          case _: "<unknown>"
        };
        if (fieldName != "") {
          if (!fieldName.startsWith("#")) {
            this.registerClassMethod(ct, classDecl, "get#" + fieldName, null, true, false, fieldName, sourceModel);
            if (fd.mutability != null && fd.mutability == "var") {
              this.registerClassMethod(ct, classDecl, "set#" + fieldName, null, false, true, fieldName, sourceModel);
            }
          } else {
            if (fd.setterName != null) {
              this.registerClassMethod(ct, classDecl, "get#" + fieldName, null, true, false, fieldName, sourceModel);
            }
            if (fd.isAbstract) {
              this.registerClassMethod(ct, classDecl, "get#" + fieldName, null, true, false, fieldName, sourceModel);
              if (fd.mutability != null && fd.mutability == "var") {
                this.registerClassMethod(ct, classDecl, "set#" + fieldName, null, false, true, fieldName, sourceModel);
              }
            }
            if (fd.isDeclare) {
              this.registerClassMethod(ct, classDecl, "get#" + fieldName, null, true, false, fieldName, sourceModel);
            }
          }
        }
      }
    }

    var hasExplicitCtor = false;
    if (classDecl != null) {
      let cd = classDecl as Node;
      var bodyNodes: Array<Node> | null = null;
      if (cd is ClassDeclaration) {
        bodyNodes = (cd as ClassDeclaration).body;
      } else if (cd is InterfaceDeclaration) {
        bodyNodes = (cd as InterfaceDeclaration).body;
      } else if (cd is MixinDeclaration) {
        bodyNodes = (cd as MixinDeclaration).body;
      }
      if (bodyNodes != null) {
        for (let member in bodyNodes as Array<Node>) {
          if (member is MethodDefinition) {
            let md = member as MethodDefinition;
            if (getMethodName(md) == "<constructor>") {
              hasExplicitCtor = true;
            }
          }
        }
      }
    }

    if (!hasExplicitCtor && !ct.isExtension) {
      this.registerClassMethod(ct, classDecl, "<constructor>", null, false, false, null, sourceModel);
    }

    if (ct.isCaseClass) {
      let eqFunc = this.registerClassMethod(ct, classDecl, "==", null, false, false, null, sourceModel);
      eqFunc.isCaseClassEq = true;

      let hashFunc = this.registerClassMethod(ct, classDecl, "hashCode", null, false, false, null, sourceModel);
      hashFunc.isCaseClassHash = true;
    }

    // Register implicit interface getters/setters for specialized classes
    let allIfaces = this.pass.cha.collectAllImplementedInterfaces(ct);
    for (let iface in allIfaces) {
      let iName = getInterfaceKey(iface);
      let unspecializedKey = getClassInterfaceKey(getClassKey(ct.genericSource ?? ct), getInterfaceKey(iface.genericSource ?? iface));
      if (this.pass.wasm.usedInterfaceAdaptations.has(unspecializedKey)) {
        let keys = iface.members.keys();
        while (let (true, key) = keys.next()) {
          let member = iface.members[key];
          if (member is FieldInfo) {
            let fi = member as FieldInfo;
            let getterName = "get#" + key;
            let unspecIName = getInterfaceKey(iface.genericSource ?? iface);
            let hasGetter = this.pass.wasm.classMethodMap.has(getClassMethodKey(cKey, getterName));
            if (!hasGetter) {
              this.registerClassMethod(ct, classDecl, getterName, null, true, false, key, sourceModel);
            }
            
            if (fi.isMutable) {
              let setterName = "set#" + key;
              let hasSetter = this.pass.wasm.classMethodMap.has(getClassMethodKey(cKey, setterName));
              if (!hasSetter) {
                this.registerClassMethod(ct, classDecl, setterName, null, false, true, key, sourceModel);
              }
            }
          }
        }
      }
    }
    
    this.populateClassStructAndMethods(ct, classDecl, sourceModel);
  }

  registerSpecializedInterface(it: InterfaceType, ifaceDecl: InterfaceDeclaration | null, sourceModel: SemanticModel): void {
    let iKey = getInterfaceKey(it);

    if (this.pass.wasm.interfaceStructs.has(iKey)) {
      return;
    }

    let itParams = getInterfaceTypeParameters(it);

    // 1. Pre-register empty vtable and fat ptr structs
    let structName = iKey as String;
    let emptyVTableStruct = new WasmStruct(structName + "_VTable", new Array<WasmField>());
    this.pass.wasm.types.push(emptyVTableStruct);
    this.pass.wasm.interfaceVTableStructs[iKey] = emptyVTableStruct;

    let fatPtrFields = new Array<WasmField>();
    fatPtrFields.push(new WasmField("instance", new ValTypeAnyRef(), false));
    fatPtrFields.push(new WasmField("vtable", new ValTypeRef(emptyVTableStruct), false));
    let emptyStruct = new WasmStruct(structName + "_FatPtr", fatPtrFields);
    this.pass.wasm.types.push(emptyStruct);
    this.pass.wasm.interfaceStructs[iKey] = emptyStruct;

    // 2. Discover referenced types in members (fields, methods) — as
    // SIGNATURES: an interface method's function type is not a value,
    // and value-routing it minted a closure struct + impl signature
    // per member (22 of them from one Iterable-family interface).
    for (let pair in it.members) {
      let resolvedType = substituteTypeParamsInCodegen(this.pass.wasm, itParams, it.typeArguments, pair.value.type);
      this.pass.typeLowerer.discoverSignatureType(resolvedType, sourceModel);
    }

    let keys = it.members.keys();
    while (let (true, key) = keys.next()) {
      let member = it.members[key];
      match (member) {
        case FieldInfo as fi: {
          let sig = getInterfaceMemberSignature(this.pass.wasm, it, "get#" + key);
          emptyVTableStruct.fields.push(new WasmField("get#" + key, new ValTypeRef(sig), false));
          if (fi.isMutable) {
            let sigSet = getInterfaceMemberSignature(this.pass.wasm, it, "set#" + key);
            emptyVTableStruct.fields.push(new WasmField("set#" + key, new ValTypeRef(sigSet), false));
          }
        }
        case MethodInfo as mi: {
          var isGeneric = false;
          if (mi.type is FunctionType) {
            let ft = mi.type as FunctionType;
            if (ft.typeParameters != null && (ft.typeParameters as Array<TypeParameterType>).length > 0) {
              isGeneric = true;
            }
          }
          if (!isGeneric) {
            let sig = getInterfaceMemberSignature(this.pass.wasm, it, key);
            emptyVTableStruct.fields.push(new WasmField(key, new ValTypeRef(sig), false));
          }
        }
        case _: {}
      }
    }
    
    this.pass.specializedInterfaces.push(it);
  }

  registerClassMethod(
      cType: ClassType,
      cDecl: Node | null,
      methName: String,
      methodNode: Node | null,
      isSynthesizedGetter: boolean,
      isSynthesizedSetter: boolean,
      backingFieldName: String | null,
      model: SemanticModel,
      methodTypeArgs: Array<Type> | null = null): WasmFunction {

    var realMethName = methName;
    var methodTypeNode: Type | null = null;
    var origMethodFt: FunctionType | null = null;
    if (cType != null) {
      if (methName == "<constructor>") {
        methodTypeNode = cType.constructorType;
        // A self-referential generic class instantiates ITSELF while its
        // own declaration is mid-check — before constructorType is filled
        // — and that cached instantiation keeps the null forever (the
        // instantiation caches copy constructorType by value). Derive the
        // signature from the generic source instead of registering a
        // bogus receiver-only constructor.
        if (methodTypeNode == null && cType.genericSource != null) {
          let gs = cType.genericSource as ClassType;
          if (gs.constructorType != null) {
            methodTypeNode = substituteTypeParamsInCodegen(this.pass.wasm, 
                gs.typeParameters, cType.typeArguments,
                gs.constructorType as FunctionType);
          }
        }
      } else {
        var specificFuncType: FunctionType | null = null;
        var hasOverloads = false;
        if (methodNode != null && methodNode is MethodDefinition) {
          if (cType.members.has(methName)) {
            let mInfo = cType.members[methName];
            if (mInfo.type is FunctionType) {
              let ft = mInfo.type as FunctionType;
              if (ft.overloads != null) {
                hasOverloads = true;
                specificFuncType = matchOverload(model, ft, methodNode as MethodDefinition);
              }
            }
          }
        }
        
        if (hasOverloads && specificFuncType != null) {
          methodTypeNode = specificFuncType;
          realMethName = methName + getSignatureKey(specificFuncType as FunctionType);
        } else {
          var baseName = methName;
          var sigKey = "";
          var specIdx = -1;
          if (methName.length >= 6) {
            for (var idx = 0; idx <= methName.length - 6; idx += 1) {
              if (methName.getByteAt(idx) == 95 && // '_'
                  methName.getByteAt(idx + 1) == 115 && // 's'
                  methName.getByteAt(idx + 2) == 112 && // 'p'
                  methName.getByteAt(idx + 3) == 101 && // 'e'
                  methName.getByteAt(idx + 4) == 99 && // 'c'
                  methName.getByteAt(idx + 5) == 95) { // '_'
                specIdx = idx;
                break;
              }
            }
          }
          if (specIdx >= 0) {
            baseName = methName.sliceBytes(0, specIdx);
          } else {
            var dollarIdx = -1;
            for (var idx = 0; idx < methName.length; idx += 1) {
              if (methName.getByteAt(idx) == 36) {
                dollarIdx = idx;
                break;
              }
            }
            if (dollarIdx >= 0 && !methName.startsWith("get#") && !methName.startsWith("set#")) {
              baseName = methName.sliceBytes(0, dollarIdx);
              sigKey = methName.sliceBytes(dollarIdx, methName.length);
            }
          }

          var currClass: ClassType | null = cType;
          while (currClass != null && methodTypeNode == null) {
            let cc = currClass as ClassType;
            if (baseName != methName) {
              if (cc.members.has(baseName)) {
                let mInfo = cc.members[baseName];
                if (mInfo.type is FunctionType) {
                  let ft = mInfo.type as FunctionType;
                  if (specIdx >= 0) {
                    methodTypeNode = ft;
                  } else if (getSignatureKey(ft) == sigKey) {
                    methodTypeNode = ft;
                  } else if (ft.overloads != null) {
                    let ovs = ft.overloads as Array<FunctionType>;
                    for (let ov in ovs) {
                      if (getSignatureKey(ov) == sigKey) {
                        methodTypeNode = ov;
                        break;
                      }
                    }
                  }
                }
              }
            } else {
              if (cc.members.has(methName)) {
                let mInfo = cc.members[methName];
                // A METHOD registration must not take its signature from
                // a same-named FIELD: a distributed variant's case param
                // may shadow the sealed base's accessor method (docs()
                // over a docs field), and the walk must continue up to
                // the class that declares the method itself.
                let isMethodReg = methodNode != null &&
                    (methodNode as Node) is MethodDefinition;
                if (!isMethodReg || mInfo is MethodInfo) {
                  methodTypeNode = mInfo.type;
                }
              }
            }
            if (methodTypeNode == null) {
              currClass = cc.superType;
            }
          }
        }

        if (methodTypeNode == null) {
          if (methName == "==") {
            let eqParams = new Array<Type>();
            eqParams.push(cType);
            methodTypeNode = new FunctionType(eqParams, null, new BooleanType());
          } else if (methName == "hashCode") {
            methodTypeNode = new FunctionType(new Array<Type>(), null, new I32Type());
          } else if (methName.startsWith("get#")) {
            let fieldName = methName.sliceBytes(4, methName.length);
            var pType: Type | null = null;
            var curr: ClassType | null = cType;
            while (curr != null && pType == null) {
              let cc = curr as ClassType;
              if (cc.members.has(fieldName)) {
                let m = cc.members[fieldName];
                if (m is FieldInfo) {
                  pType = (m as FieldInfo).type;
                } else if (m is MethodInfo) {
                  let mi = m as MethodInfo;
                  if (mi.type is FunctionType) {
                    pType = (mi.type as FunctionType).returnType;
                  }
                }
              }
              if (pType == null && cc.members.has("#" + fieldName)) {
                let m = cc.members["#" + fieldName];
                if (m is FieldInfo) {
                  pType = (m as FieldInfo).type;
                }
              }
              curr = cc.superType;
            }
            if (pType != null) {
              methodTypeNode = new FunctionType(new Array<Type>(), null, pType as Type);
            }
          } else if (methName.startsWith("set#")) {
            let fieldName = methName.sliceBytes(4, methName.length);
            var pType: Type | null = null;
            var curr: ClassType | null = cType;
            while (curr != null && pType == null) {
              let cc = curr as ClassType;
              if (cc.members.has(fieldName)) {
                let m = cc.members[fieldName];
                if (m is FieldInfo) {
                  pType = (m as FieldInfo).type;
                } else if (m is MethodInfo) {
                  let mi = m as MethodInfo;
                  if (mi.type is FunctionType) {
                    let ft = mi.type as FunctionType;
                    if (ft.parameters.length > 0) {
                      pType = ft.parameters[0];
                    } else {
                      pType = ft.returnType;
                    }
                  }
                }
              }
              if (pType == null && cc.members.has("#" + fieldName)) {
                let m = cc.members["#" + fieldName];
                if (m is FieldInfo) {
                  pType = (m as FieldInfo).type;
                }
              }
              curr = cc.superType;
            }
            if (pType != null) {
              let params = new Array<Type>();
              params.push(pType as Type);
              methodTypeNode = new FunctionType(params, null, new VoidType());
            }
          }
        }
      }
    }

    if (methodTypeNode != null && methodTypeNode is FunctionType) {
      origMethodFt = methodTypeNode as FunctionType;
    }

    if (methodTypeNode != null && cType != null) {
      methodTypeNode = substituteTypeParamsInCodegen(this.pass.wasm, getClassTypeParameters(cType), cType.typeArguments, methodTypeNode as Type);
      if (methodTypeArgs != null && methodTypeNode is FunctionType) {
        let fType = methodTypeNode as FunctionType;
        if (fType.typeParameters != null) {
          methodTypeNode = substituteTypeParamsInCodegen(this.pass.wasm, fType.typeParameters as Array<TypeParameterType>, methodTypeArgs, methodTypeNode as Type);
        }
      }
    }
    if (methodTypeNode != null) {
      this.pass.typeLowerer.discoverSignatureType(methodTypeNode as Type, model);
    }

    let params = new Array<ValType>();
    let returns = new Array<ValType>();

    var rootClass = if (methName == "<constructor>") cType else getMemberRootClass(cType, methName);

    var isStatic = false;
    if (methodNode != null) {
      let nodeVal = methodNode as Node;
      if (nodeVal is MethodDefinition) {
        isStatic = (nodeVal as MethodDefinition).isStatic;
      } else if (nodeVal is AccessorDeclaration) {
        isStatic = (nodeVal as AccessorDeclaration).isStatic;
      } else if (nodeVal is FieldDefinition) {
        isStatic = (nodeVal as FieldDefinition).isStatic;
      }
    }

    if (!isStatic) {
      let isExtCtor = methName == "<constructor>" && cType.isExtension;
      if (!isExtCtor) {
        if (cType.isExtension && cType.onType != null) {
          params.push(typeToValType(this.pass.wasm, cType.onType as Type));
        } else {
          if (let (true, rootInfo) = this.pass.wasm.classInfos.get(getClassKey(rootClass))) {
            params.push(new ValTypeRefNull(rootInfo.structType));
          } else {
            params.push(new ValTypeStructRef());
          }
        }
      }
    }
    if (methodTypeNode is FunctionType) {
      let fType = methodTypeNode as FunctionType;
      for (let p in fType.parameters) {
        mapParamTypeToWasmParams(this.pass.wasm, p, params);
      }
      if (methName != "<constructor>") {
        mapReturnTypeToWasmResults(this.pass.wasm, fType.returnType, returns);
      } else if (cType.isExtension && cType.onType != null) {
        returns.push(typeToValType(this.pass.wasm, cType.onType as Type));
      }
    } else {
      if (methName != "<constructor>") {
        returns.push(new ValTypeI32());
      } else if (cType.isExtension && cType.onType != null) {
        returns.push(typeToValType(this.pass.wasm, cType.onType as Type));
      }
    }
    

    let sig = this.pass.wasm.getSignature(params, returns);
    let wasmFunc = new WasmFunction(sig, methodNode, model);
    if (origMethodFt != null && origMethodFt.typeParameters != null) {
      wasmFunc.typeParameters = origMethodFt.typeParameters;
      wasmFunc.typeArguments = methodTypeArgs;
    }

    var decs: Array<Decorator> | null = null;
    if (methodNode != null) {
      let nodeVal = methodNode as Node;
      if (nodeVal is MethodDefinition) {
        decs = (nodeVal as MethodDefinition).decorators;
      } else if (nodeVal is AccessorDeclaration) {
        decs = (nodeVal as AccessorDeclaration).decorators;
      } else if (nodeVal is FieldDefinition) {
        decs = (nodeVal as FieldDefinition).decorators;
      }
    } else if (backingFieldName != null && cDecl != null) {
      let cDeclVal = cDecl as Node;
      if (cDeclVal is ClassDeclaration) {
        let classDecl = cDeclVal as ClassDeclaration;
        for (let ms in classDecl.body) {
          if (ms is FieldDefinition) {
            let fd = ms as FieldDefinition;
            let fName = match (fd.name) {
              case Identifier {name}: name
              case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                case Identifier {name}: name
                case MemberExpression {property}: property.name
                case _: "<symbol>"
              }
              case _: ""
            };
            if (fName == backingFieldName as String) {
              decs = fd.decorators;
            }
          }
        }
      }
    }
    
    if (decs != null) {
      for (let dec in decs as Array<Decorator>) {
        if (dec.name == "intrinsic" && dec.args.length == 1) {
          wasmFunc.intrinsic = dec.args[0].value;
        }
      }
    }

    wasmFunc.isStatic = isStatic;
    let cName = getClassKey(cType) as String;
    wasmFunc.name = cName + "." + realMethName;
    wasmFunc.methodName = realMethName;
    wasmFunc.classDecl = cDecl;
    
    wasmFunc.classType = cType;
    if (let (true, cInfo) = this.pass.wasm.classInfos.get(getClassKey(cType))) {
      wasmFunc.structType = cInfo.structType;
    }

    if (isSynthesizedGetter && backingFieldName != null) {
      let st = wasmFunc.structType;
      if (st != null) {
        var idx = -1;
        let backingName = backingFieldName as String;
        let lookupBackingName = if (backingName.length > 0 && backingName.sliceBytes(0, 1) == "#") {
          getClassPrivateFieldKey(getClassKey(cType), backingName)
        } else {
          backingName
        };
        for (var fi = 0; fi < (st as WasmStruct).fields.length; fi += 1) {
          if ((st as WasmStruct).fields[fi].name == lookupBackingName) {
            idx = fi;
          }
        }
        wasmFunc.getterStruct = st;
        wasmFunc.getterFieldIndex = idx;
      }
    } else if (isSynthesizedSetter && backingFieldName != null) {
      let st = wasmFunc.structType;
      if (st != null) {
        var idx = -1;
        let backingName = backingFieldName as String;
        let lookupBackingName = if (backingName.length > 0 && backingName.sliceBytes(0, 1) == "#") {
          getClassPrivateFieldKey(getClassKey(cType), backingName)
        } else {
          backingName
        };
        for (var fi = 0; fi < (st as WasmStruct).fields.length; fi += 1) {
          if ((st as WasmStruct).fields[fi].name == lookupBackingName) {
            idx = fi;
          }
        }
        wasmFunc.setterStruct = st;
        wasmFunc.setterFieldIndex = idx;
      }
    }

    let isGenericTemplate = cType != null &&
                            cType.typeParameters != null && 
                            (cType.typeParameters as Array<TypeParameterType>).length > 0 && 
                            (cType.typeArguments == null || !isConcrete(cType));

    let registeredKey = getClassMethodKey(getClassKey(cType), realMethName);
    if (this.pass.wasm.classMethodMap.has(registeredKey)) {
      let func = this.pass.wasm.classMethodMap[registeredKey];
      if (func.node == null && methodNode != null) {
        func.node = methodNode;
      }
      if (func.classDecl == null && cDecl != null) {
        func.classDecl = cDecl;
      }
      // Registration is NOT reaching (binary-size.md §3a). The old
      // force-reach here — every registered method of an instantiated
      // class — was what the class vtable's all-methods slot list
      // required; with slots pruned to dispatchable methods, reaching
      // comes from the member referrers that name a method, and from
      // Pass 1.5 for the methods that genuinely hold slots.
      // CONSTRUCTORS keep it: they are never vtable-dispatched, and an
      // instantiated class's ctor must exist for its `new` sites
      // (instantiateClassType promotes ctors registered BEFORE
      // instantiation; this covers ones registered after). So do
      // MIXIN-SCOPED private members ("Scope::#name"): a mixin body
      // names them lexically, and no referrer machinery names them by
      // key, so nothing else reaches them. Lowering no longer falls
      // back to a host's same-named member when the registration is
      // missing — it bails — so dropping this force-reach would be a
      // loud compile failure rather than a silent wrong answer, but it
      // would still be a failure.
      let hasInst = this.pass.instantiatedSpecializedClasses.has(getClassKey(cType) as String);
      if (!isGenericTemplate && hasInst &&
          realMethName == "<constructor>" &&
          this.pass.ctorDemandedGenerics.has(((cType.genericSource ?? cType)).symbolId)) {
        if (!this.pass.reachedFunctionsSet.has(func)) {
          this.#reachRegisteredMethod(func);
        }
      }
      return func;
    }

    let hasInstNew = this.pass.instantiatedSpecializedClasses.has(getClassKey(cType) as String);
    if (!isGenericTemplate && hasInstNew &&
        realMethName == "<constructor>" &&
        this.pass.ctorDemandedGenerics.has(((cType.genericSource ?? cType)).symbolId)) {
      this.#reachRegisteredMethod(wasmFunc);
    }

    this.pass.wasm.classMethodMap[registeredKey] = wasmFunc;
    let cKey = getClassKey(cType) as String;
    if (!this.pass.wasm.classMethods.has(cKey)) {
      this.pass.wasm.classMethods[cKey] = new Array<WasmFunction>();
    }
    this.pass.wasm.classMethods[cKey].push(wasmFunc);
    return wasmFunc;
  }

  /**
   * Force-reach a method a registration decided must exist (the class
   * is instantiated or an extension, so its vtable references the
   * function and it WILL be emitted). markFunctionReached is a no-op
   * when the ambient phase flag says "checkable", but registration
   * added the function to wasm.functions unconditionally — leaving an
   * emitted body whose dependencies were never traversed. Whether the
   * flag happened to be true here depended on which referrer processed
   * last, so the miss was graph-order dependent (String.split lowering
   * without its FixedArray<String> extension constructor registered,
   * in wit-parser's graph but not others).
   */
  #reachRegisteredMethod(func: WasmFunction): void {
    this.pass.wasm.addFunction(func);
    this.pass.forceReachFunction(func);
    if (func.methodName != null && (func.methodName as String) == "<constructor>" &&
        func.classType != null) {
      this.#reachSuperConstructors(func.classType as ClassType);
    }
  }

  /**
   * A constructor drags its super chain's constructors with it: a
   * `: super(...)` lowers to a DIRECT call of the superclass's ctor,
   * resolved through `classMethodMap` — which `layout()` rebuilds from
   * REACHED functions only, so a super ctor that was merely registered
   * is gone by lowering (`zir unsupported: super constructor not
   * found`).
   *
   * This used to hold by accident: every class a subclass could name
   * was instantiated, so every super ctor was promoted on its own.
   * Instantiating on evidence broke the tie for the one shape where
   * the two halves disagree — a subclass whose class is instantiated
   * extending one whose class is not.
   *
   * Pending keys rather than direct reaches: the super's ctor may not
   * be registered yet when the subclass's is, and the settle drain
   * resolves by key after registration has finished.
   */
  #reachSuperConstructors(ct: ClassType): void {
    var curr: ClassType | null = ct.superType;
    while (curr != null) {
      let superCt = curr as ClassType;
      this.pass.notePendingMemberReach(
          getClassMethodKey(getClassKey(superCt), "<constructor>"));
      curr = superCt.superType;
    }
  }

  populateClassStructAndMethods(ct: ClassType, cd: Node | null, sourceModel: SemanticModel): void {
    let cKey = getClassKey(ct);
    let ctVtable = this.pass.wasm.classVtable(cKey);
    var vstOpt: WasmStruct | null = null;
    var stOpt: WasmStruct | null = null;
    if (let (true, info) = this.pass.wasm.classInfos.get(cKey)) {
      stOpt = info.structType;
      vstOpt = info.vtableStructType;
    }
    if (stOpt == null || vstOpt == null) {
      throw new Error("Class struct or vtable struct not found for class: " + ct.name);
    }
    let st = stOpt as WasmStruct;
    let vst = vstOpt as WasmStruct;
    if (st.fields.length > 0) {
      return;
    }
    
    let vtableSet = new HashSet<String>();
    for (let existing in ctVtable) {
      vtableSet.add(existing);
    }

    if (ct.superType != null) {
      let superCt = ct.superType as ClassType;
      let superLookupId = (superCt.genericSource ?? superCt).symbolId;
      let superDecl: Node | null = if (this.pass.classDecls.has(superLookupId)) this.pass.classDecls[superLookupId] else null;
      let superModel = this.pass.getClassModel(superCt);
      this.populateClassStructAndMethods(superCt, superDecl, superModel);

      let superVtable = this.pass.wasm.classVtable(getClassKey(superCt));
      for (let methName in superVtable) {
        if (!vtableSet.has(methName)) {
          ctVtable.push(methName);
          vtableSet.add(methName);
        }
      }
    }

    if (ct.isCaseClass) {
      if (!ct.members.has("==")) {
        let eqParams = new Array<Type>();
        eqParams.push(ct);
        let eqNames = new Array<String>();
        eqNames.push("other");
        ct.members["=="] = new MethodInfo(new FunctionType(eqParams, eqNames, new BooleanType()), false, false, false, false);
      }
      if (!vtableSet.has("==")) {
        ctVtable.push("==");
        vtableSet.add("==");
      }

      if (!ct.members.has("hashCode")) {
        ct.members["hashCode"] = new MethodInfo(new FunctionType(new Array<Type>(), null, new I32Type()), false, false, false, false);
      }
      if (!vtableSet.has("hashCode")) {
        ctVtable.push("hashCode");
        vtableSet.add("hashCode");
      }
    }

    let cdDecl = if (cd != null && cd is ClassDeclaration) cd as ClassDeclaration else null;
    // An erasure gets a struct and no methods — see registerSpecializedClass.
    let isErasedCt = containsErasedType(ct as Type);
    if (cdDecl != null && !isErasedCt) {
      let mixinMembers = new Array<Node>();
      let mixinScopes = new Array<String>();
      let seenMixins = new HashMap<MixinKey, boolean>();
      collectMixinMembers(this.pass.program, sourceModel, cdDecl.mixins, mixinMembers, seenMixins, mixinScopes);

      let allMembers = new Array<Node>();
      let allScopes = new Array<String>();
      for (let ms in cdDecl.body) {
        allMembers.push(ms);
        allScopes.push("");
      }
      for (var mmi = 0; mmi < mixinMembers.length; mmi += 1) {
        allMembers.push(mixinMembers[mmi]);
        allScopes.push(mixinScopes[mmi]);
      }

      var msIdx = -1;
      for (let ms in allMembers) {
        msIdx += 1;
        let msScope = allScopes[msIdx];
        if (ms is MethodDefinition) {
          let mDef = ms as MethodDefinition;
          if (mDef.isAbstract) { continue; }
          if (mDef.typeParameters != null && (mDef.typeParameters as Array<TypeParameter>).length > 0) {
            continue;
          }
          let methName = match (mDef.name) {
            case Identifier {name}: name
            case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
              case Identifier {name}: name
              case MemberExpression {property}: property.name
              case _: "<symbol>"
            }
            case _: ""
          };
          if (methName != "") {
            var vtableMethName = methName;
            if (ct.members.has(methName)) {
              let mInfo = ct.members[methName];
              if (mInfo.type is FunctionType) {
                let ft = mInfo.type as FunctionType;
                let specificType = matchOverload(sourceModel, ft, mDef);
                if (specificType != null) {
                  vtableMethName = methName + getSignatureKey(specificType as FunctionType);
                }
              }
            }
            
            // Privates: no vtable slot (never virtual); mixin
            // privates register under the mixin's scope key.
            let isPrivateMeth = methName.length > 0 && methName.sliceBytes(0, 1) == "#";
            // See above: a generic method has no single body to hold.
            let isGenericMeth = mDef.typeParameters != null &&
                (mDef.typeParameters as Array<TypeParameter>).length > 0;
            if (!mDef.isStatic && !vtableSet.has(vtableMethName) && methName != "<constructor>" && !isPrivateMeth && !isGenericMeth) {
              ctVtable.push(vtableMethName);
              vtableSet.add(vtableMethName);
            }
            var regName = methName;
            if (msScope != "" && isPrivateMeth) {
              regName = msScope + "::" + methName;
            }
            let regFn = this.registerClassMethod(ct, cdDecl, regName, mDef, false, false, null, sourceModel);
            if (msScope != "") { regFn.privateScopeKey = msScope; }
          }
        } else if (ms is AccessorDeclaration) {
          let acc = ms as AccessorDeclaration;
          if (acc.isStatic) { continue; }
          let accName = match (acc.name) {
            case Identifier {name}: name
            case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
              case Identifier {name}: name
              case MemberExpression {property}: property.name
              case _: "<symbol>"
            }
            case _: ""
          };
          if (accName != "") {
            // Private-named accessors: no vtable slot (lexical, never
            // virtual); mixin private accessors register under the
            // mixin's scope key like private methods.
            let isPrivateAcc = accName.length > 0 && accName.sliceBytes(0, 1) == "#";
            if (acc.getter != null) {
              var getterName = "get#" + accName;
              if (!isPrivateAcc && !vtableSet.has(getterName)) {
                ctVtable.push(getterName);
                vtableSet.add(getterName);
              }
              if (isPrivateAcc && msScope != "") {
                getterName = msScope + "::" + getterName;
              }
              let regG = this.registerClassMethod(ct, cdDecl, getterName, acc as Node, false, false, null, sourceModel);
              if (msScope != "") { regG.privateScopeKey = msScope; }
            }
            if (acc.setter != null) {
              var setterName = "set#" + accName;
              if (!isPrivateAcc && !vtableSet.has(setterName)) {
                ctVtable.push(setterName);
                vtableSet.add(setterName);
              }
              if (isPrivateAcc && msScope != "") {
                setterName = msScope + "::" + setterName;
              }
              let regS = this.registerClassMethod(ct, cdDecl, setterName, acc.setter as Node, false, false, null, sourceModel);
              if (msScope != "") { regS.privateScopeKey = msScope; }
            }
          }
        } else if (ms is FieldDefinition) {
          let fd = ms as FieldDefinition;
          if (fd.isStatic) { continue; }
          let fieldName = match (fd.name) {
            case Identifier {name}: name
            case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
              case Identifier {name}: name
              case MemberExpression {property}: property.name
              case _: "<symbol>"
            }
            case _: ""
          };
          if (fieldName != "") {
            if (!fieldName.startsWith("#")) {
              let getterName = "get#" + fieldName;
              if (!vtableSet.has(getterName)) {
                ctVtable.push(getterName);
                vtableSet.add(getterName);
              }
              this.registerClassMethod(ct, cdDecl, getterName, null, true, false, fieldName, sourceModel);
              if (fd.mutability != null && fd.mutability == "var") {
                let setterName = "set#" + fieldName;
                if (!vtableSet.has(setterName)) {
                  ctVtable.push(setterName);
                  vtableSet.add(setterName);
                }
                this.registerClassMethod(ct, cdDecl, setterName, null, false, true, fieldName, sourceModel);
              }
            } else {
              if (fd.setterName != null) {
                let getterName = "get#" + fieldName;
                if (!vtableSet.has(getterName)) {
                  ctVtable.push(getterName);
                  vtableSet.add(getterName);
                }
              }
              if (fd.isAbstract) {
                let getterName = "get#" + fieldName;
                if (!vtableSet.has(getterName)) {
                  ctVtable.push(getterName);
                  vtableSet.add(getterName);
                }
                this.registerClassMethod(ct, cdDecl, getterName, null, true, false, fieldName, sourceModel);
                if (fd.mutability != null && fd.mutability == "var") {
                  let setterName = "set#" + fieldName;
                  if (!vtableSet.has(setterName)) {
                    ctVtable.push(setterName);
                    vtableSet.add(setterName);
                  }
                  this.registerClassMethod(ct, cdDecl, setterName, null, false, true, fieldName, sourceModel);
                }
              }
              if (fd.isDeclare) {
                let getterName = "get#" + fieldName;
                if (!vtableSet.has(getterName)) {
                  ctVtable.push(getterName);
                  vtableSet.add(getterName);
                }
                this.registerClassMethod(ct, cdDecl, getterName, null, true, false, fieldName, sourceModel);
              }
            }
          }
        }
      }
    }

    if ((cdDecl != null || ct.isCaseClass || (cd != null && cd is SealedVariant)) && !ct.isExtension && !isErasedCt) {
      let wasmFunc = this.registerClassMethod(ct, cd, "<constructor>", null, false, false, null, sourceModel);
      if (wasmFunc.classDecl == null) {
        wasmFunc.classDecl = cd;
      }
      if (wasmFunc.structType == null) {
        wasmFunc.structType = st;
      }
      let params = new Array<ValType>();
      params.push(new ValTypeRefNull(st));
      for (var i = 1; i < wasmFunc.signature.params.length; i += 1) {
        params.push(wasmFunc.signature.params[i]);
      }
      let sig = this.pass.wasm.getSignature(params, wasmFunc.signature.returns);
      wasmFunc.signature = sig;
      this.pass.markTypeReached(sig);
      if (ct.isCaseClass) {
        let eqFunc = this.registerClassMethod(ct, cd, "==", null, false, false, null, sourceModel);
        eqFunc.isCaseClassEq = true;
        let hashFunc = this.registerClassMethod(ct, cd, "hashCode", null, false, false, null, sourceModel);
        hashFunc.isCaseClassHash = true;
      }
    }

    if (vst.fields.length == 0) {
      // A slot exists so something can dispatch through it. On a class
      // with no superclass that nothing extends, nothing ever can —
      // except `==`/`hashCode`, which HashMap and generic equality
      // dispatch through the class vtable regardless of hierarchy.
      // Every slot's function must be emitted (the vtable global is a
      // struct.new over ref.funcs), so an unneeded slot is not one
      // wasted field: it force-reaches an entire method. This is what
      // kept every String method in a program whose only string is a
      // literal it returns.
      let keepAll = this.pass.classCanDispatchVirtually(ct);
      // ==/hashCode slots exist for the equality diamond and the hash
      // intrinsic, which dispatch them through the class vtable on
      // ERASED receivers. A program with no erased equality use needs
      // neither — but the decision is baked per class at layout, so a
      // use discovered after pruning began throws (loud) rather than
      // dispatching through a missing slot (silent).
      let keepEq = this.pass.equalityDispatchUsed;
      for (let methName in ctVtable) {
        if (!keepAll) {
          if (methName != "==" && methName != "hashCode") {
            continue;
          }
          if (!keepEq) {
            this.pass.noteEqSlotPruned(cKey);
            continue;
          }
        }
        vst.fields.push(new WasmField(methName, new ValTypeFuncRef(), false));
      }
    }

    let fields = new Array<WasmField>();
    if (ct.superType != null) {
      let superKey = getClassKey(ct.superType as ClassType);
      if (let (true, superInfo) = this.pass.wasm.classInfos.get(superKey)) {
        let superSt = superInfo.structType;
        for (let f in superSt.fields) {
          fields.push(f);
        }
      }
    } else {
      var rootVst = vst;
      while (rootVst.superStruct != null) {
        rootVst = rootVst.superStruct as WasmStruct;
      }
      fields.push(new WasmField("<vtable>", new ValTypeRefNull(rootVst), true));
    }

    let isStaticField = (targetFieldName: String): boolean => {
      if (cd == null) return false;
      let cdDecl = if (cd is ClassDeclaration) cd as ClassDeclaration else null;
      if (cdDecl == null) return false;
      for (let ms in cdDecl.body) {
        if (ms is FieldDefinition) {
          let fd = ms as FieldDefinition;
          let fieldName = match (fd.name) {
            case Identifier {name}: name
            case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
              case Identifier {name}: name
              case MemberExpression {property}: property.name
              case _: "<symbol>"
            }
            case _: ""
          };
          if (fieldName == targetFieldName) {
            return fd.isStatic;
          }
        }
      }
      return false;
    };

    let ctParams = getClassTypeParameters(ct);
    for (let pair in ct.members) {
      if (pair.value is MethodInfo) {
        continue;
      }
      if (pair.value.isAbstract) {
        continue;
      }
      if (isStaticField(pair.key)) {
        continue;
      }
      var isInherited = false;
      if (ct.superType != null) {
        let superKey = getClassKey(ct.superType as ClassType);
        if (let (true, superInfo) = this.pass.wasm.classInfos.get(superKey)) {
          let superSt = superInfo.structType;
          for (let sf in superSt.fields) {
            if (sf.name == pair.key) {
              isInherited = true;
            }
          }
        }
      }
      if (!isInherited) {
        let fName = if (pair.key.contains("::#")) {
          // Mixin private fields arrive pre-scoped from the checker
          // ("<mixinScopeKey>::#name") — the member key IS the field
          // name, shared by every application of the mixin.
          pair.key
        } else if (pair.key.length > 0 && pair.key.sliceBytes(0, 1) == "#") {
          getClassPrivateFieldKey(cKey, pair.key)
        } else {
          pair.key
        };
        let resolvedType = substituteTypeParamsInCodegen(this.pass.wasm, ctParams, ct.typeArguments, pair.value.type);
        let valType = typeToValType(this.pass.wasm, resolvedType);
        if (valType is ValTypeVoid) {
          // A zero-width field (`Box<void>.value`) holds nothing, so it
          // gets no storage. Reads of it lower to no value and writes
          // to it lower to just their right-hand side's effects.
          continue;
        }
        let nullableValType = match (valType) {
          case ValTypeRef {target}: new ValTypeRefNull(target)
          case _: valType
        };
        let wf = new WasmField(fName, nullableValType, true);
        // `structref` for a class-typed field means the class had no
        // registration yet — discovery may still produce one, and then
        // its method signatures would be precise while this field is
        // erased. Remember the bake so it can be re-resolved once
        // discovery settles.
        if (valType is ValTypeStructRef && resolvedType is ClassType) {
          this.#erasedFieldBakes.push(new ErasedFieldBake(wf, resolvedType));
        }
        fields.push(wf);
      }
    }
    for (let f in fields) {
      st.fields.push(f);
    }

  }

  instantiateGenericFunction(symId: SymbolId, typeArgs: Array<Type>): WasmFunction {
    let funcExpr = this.pass.wasm.genericFunctions[symId];
    let model = this.pass.wasm.genericFunctionModels[symId];
    
    // Determine target name
    var originalName = "";
    let parentNode = model.getParent(funcExpr);
    if (parentNode != null && parentNode is VariableDeclaration) {
      let varDecl = parentNode as VariableDeclaration;
      if (varDecl.pattern is IdentifierPattern) {
        originalName = (varDecl.pattern as IdentifierPattern).name;
      }
    } else if (parentNode != null && parentNode is FunctionDeclaration) {
      originalName = (parentNode as FunctionDeclaration).name.name;
    }
    if (originalName == "") {
      originalName = "generic_func";
    }
    
    let specKey = getSpecializedFunctionKey(originalName, typeArgs);
    let specName = getSpecializedName(originalName, typeArgs);
    if (this.pass.wasm.specializedFunctions.has(specKey)) {
      let func = this.pass.wasm.specializedFunctions[specKey];
      this.pass.markFunctionReached(func);
      return func;
    }
    
    // Resolve the original generic FunctionType
    let funcTypeNode = model.getNodeType(funcExpr) as FunctionType;
    let typeParams = funcTypeNode.typeParameters as Array<TypeParameterType>;
    
    // Substitute typeParams with typeArgs in the function signature
    let concreteParams = new Array<ValType>();
    let concreteReturns = new Array<ValType>();
    
    for (let p in funcTypeNode.parameters) {
      let subType = substituteTypeParamsInCodegen(this.pass.wasm, typeParams, typeArgs, p);
      mapParamTypeToWasmParams(this.pass.wasm, subType, concreteParams);
    }
    
    let subReturn = substituteTypeParamsInCodegen(this.pass.wasm, typeParams, typeArgs, funcTypeNode.returnType);
    mapReturnTypeToWasmResults(this.pass.wasm, subReturn, concreteReturns);
    
    let sig = this.pass.wasm.getSignature(concreteParams, concreteReturns);
    let wasmFunc = new WasmFunction(sig, funcExpr, model);
    
    // Track type parameters and arguments for codegen context
    wasmFunc.typeParameters = typeParams;
    wasmFunc.typeArguments = typeArgs;
    wasmFunc.name = specName;
    
    // Register it
    this.pass.wasm.specializedFunctions[specKey] = wasmFunc;
    this.pass.wasm.addFunction(wasmFunc);
    // markFunctionReached queues a node referrer for the body with
    // this specialization's type arguments; without these entries the
    // referrer finds no node and the per-specialization traversal is
    // silently skipped, so classes the body constructs never
    // instantiate under the substituted type arguments.
    this.pass.nodeIdToNode[(funcExpr as Node).id as i32] = funcExpr;
    this.pass.nodeIdToModel[(funcExpr as Node).id as i32] = model;
    this.pass.markFunctionReached(wasmFunc);
    // A module-level function's checker-recorded dependencies live on
    // its SYMBOL, which the node referrer above never consults. Without
    // this substituted traversal, generic functions this body calls
    // only specialize during emission, after type layout is frozen.
    if (let (true, deps) = model.symbolDependencies.get(symId)) {
      this.pass.traverseDependencies(deps, model, null, typeArgs, funcExpr);
    }

    return wasmFunc;
  }

  instantiateGenericMethod(ct: ClassType, cd: Node | null, methName: String, methodNode: Node, typeArgs: Array<Type>, model: SemanticModel): WasmFunction {
    let specKey = getSpecializedName(methName, typeArgs);
    let registeredKey = getClassMethodKey(getClassKey(ct), specKey);
    if (this.pass.wasm.classMethodMap.has(registeredKey)) {
      return this.pass.wasm.classMethodMap[registeredKey];
    }
    return this.registerClassMethod(ct, cd, specKey, methodNode, false, false, null, model, typeArgs);
  }
}

let getMethodName = (md: MethodDefinition): String => {
  return match (md.name) {
    case Identifier {name}: name
    case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
      case Identifier {name}: name
      case MemberExpression {property}: property.name
      case _: "<symbol>"
    }
    case _: ""
  };
};
