import { Program } from '../../program.zena';
import { ClassType, FunctionType, MixinType, InterfaceType } from '../../types.zena';
import { Node, ClassDeclaration, MethodDefinition, FieldDefinition, AccessorDeclaration, TypeAnnotation, MixinDeclaration, Identifier, SymbolPropertyName, MemberExpression } from '../../ast.zena';
import { HashMap } from 'zena:map';
import { HashSet } from 'zena:set';
import { Array } from 'zena:array';
import { String } from 'zena:string';
import { i32ToString } from 'zena:string-convert';
import { SymbolId, Symbol } from '../../scope/symbol.zena';
import { SemanticModel } from '../../semantic-model.zena';
import { getClassKey, collectMixinMembers, findMixinDeclaration, MixinKey, getSignatureKey, InterfaceKey, getInterfaceKey } from '../codegen-utils.zena';
import { getClassTypeParameters, getInterfaceTypeParameters, substituteTypeParamsInCodegen } from '../type-mapping.zena';
import { WasmModule } from '../wasm-module.zena';

/**
 * ClassHierarchyAnalysis (CHA) manages caching and lookups for class hierarchies,
 * dynamic method overrides, field/accessor inheritance, and subclass relationships.
 */
export final class ClassHierarchyAnalysis {
  program: Program;
  instantiatedSpecializedClasses: HashSet<String>;
  wasm: WasmModule;

  implementingMethodCache = new HashMap<i32, HashMap<String, MethodDefinition>>();
  implementingMethodNulls = new HashMap<i32, HashSet<String>>();
  implementingMethodsCache = new HashMap<i32, HashMap<String, Array<MethodDefinition>>>();
  implementingFieldCache = new HashMap<i32, HashMap<String, FieldDefinition>>();
  implementingFieldNulls = new HashMap<i32, HashSet<String>>();
  implementingAccessorCache = new HashMap<i32, HashMap<String, AccessorDeclaration>>();
  implementingAccessorNulls = new HashMap<i32, HashSet<String>>();
  subclassRelationCache = new HashMap<i32, boolean>();
  subclassesByBaseId = new HashMap<SymbolId, Array<ClassType>>();
  classDeclTypeCache = new HashMap<i32, ClassType>();
  classMixinIdsCache = new HashMap<SymbolId, HashMap<SymbolId, boolean>>();
  classModels: HashMap<SymbolId, SemanticModel>;

  new(this.program, this.instantiatedSpecializedClasses, this.wasm, this.classModels);

  getClassMixinIds(cd: ClassDeclaration, model: SemanticModel): HashMap<SymbolId, boolean> {
    let lookupId = cd.id as SymbolId;
    if (let (true, cached) = this.classMixinIdsCache.get(lookupId)) {
      return cached;
    }
    let seenIds = new HashMap<SymbolId, boolean>();
    collectMixinSymbolIds(this.program, model, cd.mixins, seenIds);
    this.classMixinIdsCache[lookupId] = seenIds;
    return seenIds;
  }

  findImplementingMethod(cType: ClassType, mName: String): MethodDefinition | null {
    let startClassId = if (cType.genericSource != null) (cType.genericSource as ClassType).id else cType.id;
    if (let (true, nulls) = this.implementingMethodNulls.get(startClassId)) {
      if (nulls.has(mName)) {
        return null;
      }
    }
    if (let (true, cache) = this.implementingMethodCache.get(startClassId)) {
      if (let (true, cached) = cache.get(mName)) {
        return cached;
      }
    }

    var curr: ClassType | null = cType;
    while (curr != null) {
      let ct = curr as ClassType;
      let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
      var model: SemanticModel | null = null;
      if (ct.sourcePath != "") {
        if (let (true, unit) = this.program.unitsByPath.get(ct.sourcePath)) {
          model = unit.model;
        }
      }
      if (model != null) {
        let m = model as SemanticModel;
        if (m.classDeclarations.has(lookupId)) {
          let cd = m.classDeclarations[lookupId];
          let mixinMembers = new Array<Node>();
          let seenMixins = new HashMap<MixinKey, boolean>();
          collectMixinMembers(this.program, m, cd.mixins, mixinMembers, seenMixins);
          
          let allMembers = new Array<Node>();
          for (let member in cd.body) {
            allMembers.push(member);
          }
          for (let member in mixinMembers) {
            allMembers.push(member);
          }
          
          for (let member in allMembers) {
            if (member is MethodDefinition) {
              let md = member as MethodDefinition;
              if (md.isAbstract) { continue; }
              let name = getMethodName(md);
              if (matchMemberName(name, mName)) {
                if (!this.implementingMethodCache.has(startClassId)) {
                  this.implementingMethodCache[startClassId] = new HashMap<String, MethodDefinition>();
                }
                this.implementingMethodCache[startClassId][mName] = md;
                return md;
              }
            }
          }
        }
      } else {
        for (let unit in this.program.units) {
          let m = unit.model;
          if (m.classDeclarations.has(lookupId)) {
            let cd = m.classDeclarations[lookupId];
            let mixinMembers = new Array<Node>();
            let seenMixins = new HashMap<MixinKey, boolean>();
            collectMixinMembers(this.program, m, cd.mixins, mixinMembers, seenMixins);
            
            let allMembers = new Array<Node>();
            for (let member in cd.body) {
              allMembers.push(member);
            }
            for (let member in mixinMembers) {
              allMembers.push(member);
            }
            
            for (let member in allMembers) {
              if (member is MethodDefinition) {
                let md = member as MethodDefinition;
                if (md.isAbstract) { continue; }
                let name = getMethodName(md);
                if (matchMemberName(name, mName)) {
                  if (!this.implementingMethodCache.has(startClassId)) {
                    this.implementingMethodCache[startClassId] = new HashMap<String, MethodDefinition>();
                  }
                  this.implementingMethodCache[startClassId][mName] = md;
                  return md;
                }
              }
            }
          }
        }
      }
      curr = ct.superType;
    }
    if (!this.implementingMethodNulls.has(startClassId)) {
      this.implementingMethodNulls[startClassId] = new HashSet<String>();
    }
    this.implementingMethodNulls[startClassId].add(mName);
    return null;
  }

  findImplementingMethods(cType: ClassType, mName: String): Array<MethodDefinition> {
    let startClassId = if (cType.genericSource != null) (cType.genericSource as ClassType).id else cType.id;
    if (let (true, cache) = this.implementingMethodsCache.get(startClassId)) {
      if (let (true, cached) = cache.get(mName)) {
        return cached;
      }
    }

    let methods = new Array<MethodDefinition>();
    let seenSigs = new HashSet<String>();
    var curr: ClassType | null = cType;
    while (curr != null) {
      let ct = curr as ClassType;
      let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
      var model: SemanticModel | null = null;
      if (ct.sourcePath != "") {
        if (let (true, unit) = this.program.unitsByPath.get(ct.sourcePath)) {
          model = unit.model;
        }
      }
      if (model != null) {
        let m = model as SemanticModel;
        if (m.classDeclarations.has(lookupId)) {
          let cd = m.classDeclarations[lookupId];
          let mixinMembers = new Array<Node>();
          let seenMixins = new HashMap<MixinKey, boolean>();
          collectMixinMembers(this.program, m, cd.mixins, mixinMembers, seenMixins);
          
          let allMembers = new Array<Node>();
          for (let member in cd.body) {
            allMembers.push(member);
          }
          for (let member in mixinMembers) {
            allMembers.push(member);
          }
          
          for (let member in allMembers) {
            if (member is MethodDefinition) {
              let md = member as MethodDefinition;
              if (md.isAbstract) { continue; }
              let name = getMethodName(md);
              if (matchMemberName(name, mName)) {
                let mType = m.getNodeType(md);
                if (mType != null && mType is FunctionType) {
                  let ft = mType as FunctionType;
                  let sigKey = getSignatureKey(ft);
                  if (!seenSigs.has(sigKey)) {
                    methods.push(md);
                    seenSigs.add(sigKey);
                  }
                }
              }
            }
          }
        }
      } else {
        for (let unit in this.program.units) {
          let m = unit.model;
          if (m.classDeclarations.has(lookupId)) {
            let cd = m.classDeclarations[lookupId];
            let mixinMembers = new Array<Node>();
            let seenMixins = new HashMap<MixinKey, boolean>();
            collectMixinMembers(this.program, m, cd.mixins, mixinMembers, seenMixins);
            
            let allMembers = new Array<Node>();
            for (let member in cd.body) {
              allMembers.push(member);
            }
            for (let member in mixinMembers) {
              allMembers.push(member);
            }
            
            for (let member in allMembers) {
              if (member is MethodDefinition) {
                let md = member as MethodDefinition;
                if (md.isAbstract) { continue; }
                let name = getMethodName(md);
                if (matchMemberName(name, mName)) {
                  let mType = m.getNodeType(md);
                  if (mType != null && mType is FunctionType) {
                    let ft = mType as FunctionType;
                    let sigKey = getSignatureKey(ft);
                    if (!seenSigs.has(sigKey)) {
                      methods.push(md);
                      seenSigs.add(sigKey);
                    }
                  }
                }
              }
            }
          }
        }
      }
      curr = ct.superType;
    }
    if (!this.implementingMethodsCache.has(startClassId)) {
      this.implementingMethodsCache[startClassId] = new HashMap<String, Array<MethodDefinition>>();
    }
    this.implementingMethodsCache[startClassId][mName] = methods;
    return methods;
  }

  findImplementingField(cType: ClassType, fName: String): FieldDefinition | null {
    let startClassId = if (cType.genericSource != null) (cType.genericSource as ClassType).id else cType.id;
    if (let (true, nulls) = this.implementingFieldNulls.get(startClassId)) {
      if (nulls.has(fName)) {
        return null;
      }
    }
    if (let (true, cache) = this.implementingFieldCache.get(startClassId)) {
      if (let (true, cached) = cache.get(fName)) {
        return cached;
      }
    }

    var curr: ClassType | null = cType;
    while (curr != null) {
      let ct = curr as ClassType;
      let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
      var model: SemanticModel | null = null;
      if (ct.sourcePath != "") {
        if (let (true, unit) = this.program.unitsByPath.get(ct.sourcePath)) {
          model = unit.model;
        }
      }
      if (model != null) {
        let m = model as SemanticModel;
        if (m.classDeclarations.has(lookupId)) {
          let cd = m.classDeclarations[lookupId];
          let mixinMembers = new Array<Node>();
          let seenMixins = new HashMap<MixinKey, boolean>();
          collectMixinMembers(this.program, m, cd.mixins, mixinMembers, seenMixins);
          
          let allMembers = new Array<Node>();
          for (let member in cd.body) {
            allMembers.push(member);
          }
          for (let member in mixinMembers) {
            allMembers.push(member);
          }
          
          for (let member in allMembers) {
            if (member is FieldDefinition) {
              let fd = member as FieldDefinition;
              if (fd.isAbstract) { continue; }
              let name = match (fd.name) {
                case Identifier {name}: name
                case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                  case Identifier {name}: name
                  case MemberExpression {property}: property.name
                  case _: "<symbol>"
                }
                case _: ""
              };
              if (matchMemberName(name, fName)) {
                if (!this.implementingFieldCache.has(startClassId)) {
                  this.implementingFieldCache[startClassId] = new HashMap<String, FieldDefinition>();
                }
                this.implementingFieldCache[startClassId][fName] = fd;
                return fd;
              }
            }
          }
        }
      } else {
        for (let unit in this.program.units) {
          let m = unit.model;
          if (m.classDeclarations.has(lookupId)) {
            let cd = m.classDeclarations[lookupId];
            let mixinMembers = new Array<Node>();
            let seenMixins = new HashMap<MixinKey, boolean>();
            collectMixinMembers(this.program, m, cd.mixins, mixinMembers, seenMixins);
            
            let allMembers = new Array<Node>();
            for (let member in cd.body) {
              allMembers.push(member);
            }
            for (let member in mixinMembers) {
              allMembers.push(member);
            }
            
            for (let member in allMembers) {
              if (member is FieldDefinition) {
                let fd = member as FieldDefinition;
                if (fd.isAbstract) { continue; }
                let name = match (fd.name) {
                  case Identifier {name}: name
                  case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                    case Identifier {name}: name
                    case MemberExpression {property}: property.name
                    case _: "<symbol>"
                  }
                  case _: ""
                };
                if (matchMemberName(name, fName)) {
                  if (!this.implementingFieldCache.has(startClassId)) {
                    this.implementingFieldCache[startClassId] = new HashMap<String, FieldDefinition>();
                  }
                  this.implementingFieldCache[startClassId][fName] = fd;
                  return fd;
                }
              }
            }
          }
        }
      }
      curr = ct.superType;
    }
    if (!this.implementingFieldNulls.has(startClassId)) {
      this.implementingFieldNulls[startClassId] = new HashSet<String>();
    }
    this.implementingFieldNulls[startClassId].add(fName);
    return null;
  }

  findImplementingAccessor(cType: ClassType, accName: String): AccessorDeclaration | null {
    let startClassId = if (cType.genericSource != null) (cType.genericSource as ClassType).id else cType.id;
    if (let (true, nulls) = this.implementingAccessorNulls.get(startClassId)) {
      if (nulls.has(accName)) {
        return null;
      }
    }
    if (let (true, cache) = this.implementingAccessorCache.get(startClassId)) {
      if (let (true, cached) = cache.get(accName)) {
        return cached;
      }
    }

    var curr: ClassType | null = cType;
    while (curr != null) {
      let ct = curr as ClassType;
      let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
      var model: SemanticModel | null = null;
      if (ct.sourcePath != "") {
        if (let (true, unit) = this.program.unitsByPath.get(ct.sourcePath)) {
          model = unit.model;
        }
      }
      if (model != null) {
        let m = model as SemanticModel;
        if (m.classDeclarations.has(lookupId)) {
          let cd = m.classDeclarations[lookupId];
          let mixinMembers = new Array<Node>();
          let seenMixins = new HashMap<MixinKey, boolean>();
          collectMixinMembers(this.program, m, cd.mixins, mixinMembers, seenMixins);
          
          let allMembers = new Array<Node>();
          for (let member in cd.body) {
            allMembers.push(member);
          }
          for (let member in mixinMembers) {
            allMembers.push(member);
          }
          
          for (let member in allMembers) {
            if (member is AccessorDeclaration) {
              let acc = member as AccessorDeclaration;
              let name = getAccessorName(acc);
              if (accName.length > 4 && acc.getter != null && accName.sliceBytes(0, 4) == "get#") {
                let targetProp = accName.sliceBytes(4, accName.length);
                if (matchMemberName(name, targetProp)) {
                  if (!this.implementingAccessorCache.has(startClassId)) {
                    this.implementingAccessorCache[startClassId] = new HashMap<String, AccessorDeclaration>();
                  }
                  this.implementingAccessorCache[startClassId][accName] = acc;
                  return acc;
                }
              }
              if (accName.length > 4 && acc.setter != null && accName.sliceBytes(0, 4) == "set#") {
                let targetProp = accName.sliceBytes(4, accName.length);
                if (matchMemberName(name, targetProp)) {
                  if (!this.implementingAccessorCache.has(startClassId)) {
                    this.implementingAccessorCache[startClassId] = new HashMap<String, AccessorDeclaration>();
                  }
                  this.implementingAccessorCache[startClassId][accName] = acc;
                  return acc;
                }
              }
            }
          }
        }
      } else {
        for (let unit in this.program.units) {
          let m = unit.model;
          if (m.classDeclarations.has(lookupId)) {
            let cd = m.classDeclarations[lookupId];
            let mixinMembers = new Array<Node>();
            let seenMixins = new HashMap<MixinKey, boolean>();
            collectMixinMembers(this.program, m, cd.mixins, mixinMembers, seenMixins);
            
            let allMembers = new Array<Node>();
            for (let member in cd.body) {
              allMembers.push(member);
            }
            for (let member in mixinMembers) {
              allMembers.push(member);
            }
            
            for (let member in allMembers) {
              if (member is AccessorDeclaration) {
                let acc = member as AccessorDeclaration;
                let name = getAccessorName(acc);
                if (accName.length > 4 && acc.getter != null && accName.sliceBytes(0, 4) == "get#") {
                  let targetProp = accName.sliceBytes(4, accName.length);
                  if (matchMemberName(name, targetProp)) {
                    if (!this.implementingAccessorCache.has(startClassId)) {
                      this.implementingAccessorCache[startClassId] = new HashMap<String, AccessorDeclaration>();
                    }
                    this.implementingAccessorCache[startClassId][accName] = acc;
                    return acc;
                  }
                }
                if (accName.length > 4 && acc.setter != null && accName.sliceBytes(0, 4) == "set#") {
                  let targetProp = accName.sliceBytes(4, accName.length);
                  if (matchMemberName(name, targetProp)) {
                    if (!this.implementingAccessorCache.has(startClassId)) {
                      this.implementingAccessorCache[startClassId] = new HashMap<String, AccessorDeclaration>();
                    }
                    this.implementingAccessorCache[startClassId][accName] = acc;
                    return acc;
                  }
                }
              }
            }
          }
        }
      }
      curr = ct.superType;
    }
    if (!this.implementingAccessorNulls.has(startClassId)) {
      this.implementingAccessorNulls[startClassId] = new HashSet<String>();
    }
    this.implementingAccessorNulls[startClassId].add(accName);
    return null;
  }

  isSubclassOf(ct: ClassType, baseType: ClassType): boolean {
    let key = (ct.id << 16) | baseType.id;
    if (let (true, cached) = this.subclassRelationCache.get(key)) {
      return cached;
    }
    
    let res = this.isSubclassOfDirect(ct, baseType);
    this.subclassRelationCache[key] = res;
    return res;
  }

  isSubclassOfDirect(ct: ClassType, baseType: ClassType): boolean {
    var curr: ClassType | null = ct;
    while (curr != null) {
      let currVal = curr as ClassType;
      if (currVal.id == baseType.id) return true;
      if (currVal.genericSource != null && (currVal.genericSource as ClassType).id == baseType.id) return true;
      
      // Check mixins
      let lookupId = (if (currVal.genericSource != null) (currVal.genericSource as ClassType).id else currVal.id) as SymbolId;
      var model: SemanticModel | null = null;
      if (currVal.sourcePath != "") {
        if (let (true, unit) = this.program.unitsByPath.get(currVal.sourcePath)) {
          model = unit.model;
        }
      }
      if (model == null && this.classModels.has(lookupId)) {
        model = this.classModels[lookupId];
      }
      if (model != null) {
        let m = model as SemanticModel;
        if (m.classDeclarations.has(lookupId)) {
          let cd = m.classDeclarations[lookupId];
          let seenIds = this.getClassMixinIds(cd, m);
          if (seenIds.has(baseType.id as SymbolId)) {
            return true;
          }
        }
      } else {
        for (let unit in this.program.units) {
          let m = unit.model;
          if (m.classDeclarations.has(lookupId)) {
            let cd = m.classDeclarations[lookupId];
            let seenIds = this.getClassMixinIds(cd, m);
            if (seenIds.has(baseType.id as SymbolId)) {
              return true;
            }
          }
        }
      }
      
      curr = currVal.superType;
    }
    return false;
  }

  collectAllBaseClassIds(ct: ClassType, list: HashSet<SymbolId>): void {
    var curr: ClassType | null = ct;
    while (curr != null) {
      let currVal = curr as ClassType;
      list.add(currVal.id as SymbolId);
      if (currVal.genericSource != null) {
        list.add((currVal.genericSource as ClassType).id as SymbolId);
      }
      
      let lookupId = (if (currVal.genericSource != null) (currVal.genericSource as ClassType).id else currVal.id) as SymbolId;
      if (let (true, m) = this.classModels.get(lookupId)) {
        if (m.classDeclarations.has(lookupId)) {
          let cd = m.classDeclarations[lookupId];
          let seenIds = this.getClassMixinIds(cd, m);
          let keys = seenIds.keys();
          while (let (true, k) = keys.next()) {
            list.add(k);
          }
        }
      }
      
      curr = currVal.superType;
    }
  }

  registerInstantiatedClass(ct: ClassType): void {
    let baseIds = new HashSet<SymbolId>();
    this.collectAllBaseClassIds(ct, baseIds);
    for (let baseId in baseIds) {
      if (!this.subclassesByBaseId.has(baseId)) {
        this.subclassesByBaseId[baseId] = new Array<ClassType>();
      }
      this.subclassesByBaseId[baseId].push(ct);
    }
  }

  findInstantiatedSubclasses(baseType: ClassType): Array<ClassType> {
    let baseSymId = baseType.id as SymbolId;
    if (let (true, list) = this.subclassesByBaseId.get(baseSymId)) {
      return list;
    }
    return new Array<ClassType>();
  }

  collectAllImplementedInterfaces(ct: ClassType): Array<InterfaceType> {
    let list = new Array<InterfaceType>();
    let seen = new HashMap<InterfaceKey, boolean>();
    
    let ctParams = getClassTypeParameters(ct);
    for (let iface in ct.implementsList) {
      let resolved = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, iface) as InterfaceType;
      this.addInterfaceToTransitiveList(resolved, list, seen);
    }
    
    var curr = ct.superType;
    while (curr != null) {
      let superCt = curr as ClassType;
      let superCtParams = getClassTypeParameters(superCt);
      for (let iface in superCt.implementsList) {
        let resolved = substituteTypeParamsInCodegen(superCtParams, superCt.typeArguments, iface) as InterfaceType;
        this.addInterfaceToTransitiveList(resolved, list, seen);
      }
      curr = superCt.superType;
    }
    
    return list;
  }

  addInterfaceToTransitiveList(it: InterfaceType, list: Array<InterfaceType>, seen: HashMap<InterfaceKey, boolean>): void {
    let key = getInterfaceKey(it);
    if (!seen.has(key)) {
      seen[key] = true;
      list.push(it);
      for (let ext in it.extendsList) {
        let resolvedExt = substituteTypeParamsInCodegen(getInterfaceTypeParameters(it), it.typeArguments, ext) as InterfaceType;
        this.addInterfaceToTransitiveList(resolvedExt, list, seen);
      }
    }
  }
}

let matchMemberName = (name: String, target: String): boolean => {
  if (name == target) {
    return true;
  }
  if (name.length > 0 && name.sliceBytes(0, 1) == ":") {
    return name.sliceBytes(1, name.length) == target;
  }
  return false;
};

let getMethodName = (md: MethodDefinition): String => {
  return match (md.name) {
    case Identifier {name}: name
    case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
      case Identifier {name}: name
      case MemberExpression {property}: property.name
      case _: "<symbol>"
    }
    case _: ""
  };
};

let getAccessorName = (acc: AccessorDeclaration): String => {
  return match (acc.name) {
    case Identifier {name}: name
    case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
      case Identifier {name}: name
      case MemberExpression {property}: property.name
      case _: "<symbol>"
    }
    case _: ""
  };
};

let collectMixinSymbolIds = (
  program: Program,
  model: SemanticModel,
  mixinAnns: Array<TypeAnnotation> | null,
  seenIds: HashMap<SymbolId, boolean>
): void => {
  if (mixinAnns == null) { return; }
  for (let ann in (mixinAnns as Array<TypeAnnotation>)) {
    let sym = model.resolve(ann);
    if (sym != null) {
      let id = (sym as Symbol).id;
      if (!seenIds.has(id)) {
        seenIds[id] = true;
        let mt = model.getBindingType(sym as Symbol);
        if (mt != null && mt is MixinType) {
          let md = findMixinDeclaration(program, mt as MixinType);
          if (md != null) {
            collectMixinSymbolIds(program, model, (md as MixinDeclaration).mixins, seenIds);
          }
        }
      }
    }
  }
};
