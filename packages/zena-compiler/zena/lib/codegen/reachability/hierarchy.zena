import { Set } from 'zena:collections';
import { Program } from '../../program.zena';
import { ClassType, FunctionType, MixinType, InterfaceType, TypeId } from '../../types.zena';
import {
  Node, NodeId, ClassDeclaration, MethodDefinition, FieldDefinition, AccessorDeclaration, TypeAnnotation, Identifier, SymbolPropertyName, MemberExpression,
} from '../../ast.zena';
import { SymbolId } from '../../scope/symbol.zena';
import { SemanticModel, memberKeyOf } from '../../semantic-model.zena';
import {
  collectMixinMembers, findMixinDeclaration, MixinKey, getSignatureKey, InterfaceKey, getInterfaceKey,
} from '../codegen-utils.zena';
import { getClassTypeParameters, getInterfaceTypeParameters, substituteTypeParamsInCodegen } from '../type-mapping.zena';
import { WasmModule } from '../wasm-module.zena';

/**
 * ClassHierarchyAnalysis (CHA) manages caching and lookups for class hierarchies,
 * dynamic method overrides, field/accessor inheritance, and subclass relationships.
 */
export final class ClassHierarchyAnalysis {
  program: Program;
  instantiatedSpecializedClasses: Set<String>;
  wasm: WasmModule;

  implementingMethodCache = new Map<TypeId, Map<String, MethodDefinition>>();
  implementingMethodNulls = new Map<TypeId, Set<String>>();
  implementingMethodsCache = new Map<TypeId, Map<String, Array<MethodDefinition>>>();
  implementingFieldCache = new Map<TypeId, Map<String, FieldDefinition>>();
  implementingFieldNulls = new Map<TypeId, Set<String>>();
  implementingAccessorCache = new Map<TypeId, Map<String, AccessorDeclaration>>();
  implementingAccessorNulls = new Map<TypeId, Set<String>>();
  subclassRelationCache = new Map<i32, boolean>();
  subclassesByBaseId = new Map<SymbolId, GrowableArray<ClassType>>();
  classDeclTypeCache = new Map<NodeId, ClassType>();
  classMixinIdsCache = new Map<SymbolId, Map<SymbolId, boolean>>();
  classModels: Map<SymbolId, SemanticModel>;

  new(this.program, this.instantiatedSpecializedClasses, this.wasm, this.classModels);

  getClassMixinIds(cd: ClassDeclaration, symId: SymbolId, model: SemanticModel): Map<SymbolId, boolean> {
    if (let (true, cached) = this.classMixinIdsCache.get(symId)) {
      return cached;
    }
    let seenIds = new Map<SymbolId, boolean>();
    collectMixinSymbolIds(this.program, model, cd.mixins, seenIds);
    this.classMixinIdsCache[symId] = seenIds;
    return seenIds;
  }

  findImplementingMethod(cType: ClassType, mName: String): MethodDefinition | null {
    let startClassId = if (cType.genericSource != null) (cType.genericSource as ClassType).id else cType.id;
    if (let (true, nulls) = this.implementingMethodNulls.get(startClassId)) {
      if (nulls.has(mName)) {
        return null;
      }
    }
    if (let (true, cache) = this.implementingMethodCache.get(startClassId)) {
      if (let (true, cached) = cache.get(mName)) {
        return cached;
      }
    }

    var curr: ClassType | null = cType;
    while (curr != null) {
      let ct = curr;
      let lookupId = (ct.genericSource ?? ct).symbolId;
      var model: SemanticModel | null = null;
      if (ct.sourcePath != "") {
        if (let (true, unit) = this.program.unitsByPath.get(ct.sourcePath)) {
          model = unit.model;
        }
      }
      if (model == null) {
        if (let (true, m) = this.program.modelIndex.symbolToModel.get(lookupId)) {
          model = m;
        }
      }
      if (model != null) {
        var body: Array<Node> | null = null;
        if (model.classDeclarations.has(lookupId)) {
          body = model.classDeclarations[lookupId].body;
        } else if (model.mixinDeclarations.has(lookupId)) {
          body = model.mixinDeclarations[lookupId].body;
        }
        if (body != null) {
          for (let member in (body as Array<Node>)) {
            if (member is MethodDefinition) {
              if (member.isAbstract) { continue; }
              let name = getMethodName(model as SemanticModel, member);
              if (matchMemberName(name, mName)) {
                if (!this.implementingMethodCache.has(startClassId)) {
                  this.implementingMethodCache[startClassId] = new Map<String, MethodDefinition>();
                }
                this.implementingMethodCache[startClassId][mName] = member;
                return member;
              }
            }
          }
        }
      }
      curr = ct.superType;
    }
    if (!this.implementingMethodNulls.has(startClassId)) {
      this.implementingMethodNulls[startClassId] = new Set<String>();
    }
    this.implementingMethodNulls[startClassId].add(mName);
    return null;
  }

  findImplementingMethods(cType: ClassType, mName: String): Array<MethodDefinition> {
    let startClassId = if (cType.genericSource != null) (cType.genericSource as ClassType).id else cType.id;
    if (let (true, cache) = this.implementingMethodsCache.get(startClassId)) {
      if (let (true, cached) = cache.get(mName)) {
        return cached;
      }
    }

    let methods = new Array<MethodDefinition>();
    let seenSigs = new Set<String>();
    var curr: ClassType | null = cType;
    while (curr != null) {
      let ct = curr;
      let lookupId = (ct.genericSource ?? ct).symbolId;
      var model: SemanticModel | null = null;
      if (ct.sourcePath != "") {
        if (let (true, unit) = this.program.unitsByPath.get(ct.sourcePath)) {
          model = unit.model;
        }
      }
      if (model == null) {
        if (let (true, m) = this.program.modelIndex.symbolToModel.get(lookupId)) {
          model = m;
        }
      }
      if (model != null) {
        var body: Array<Node> | null = null;
        if (model.classDeclarations.has(lookupId)) {
          body = model.classDeclarations[lookupId].body;
        } else if (model.mixinDeclarations.has(lookupId)) {
          body = model.mixinDeclarations[lookupId].body;
        }
        if (body != null) {
          for (let member in (body as Array<Node>)) {
            if (member is MethodDefinition) {
              if (member.isAbstract) { continue; }
              let name = getMethodName(model as SemanticModel, member);
              if (matchMemberName(name, mName)) {
                let mType = model.getNodeType(member);
                if (mType is FunctionType) {
                  let sigKey = getSignatureKey(mType);
                  if (!seenSigs.has(sigKey)) {
                    methods.push(member);
                    seenSigs.add(sigKey);
                  }
                }
              }
            }
          }
        }
      }
      curr = ct.superType;
    }
    if (!this.implementingMethodsCache.has(startClassId)) {
      this.implementingMethodsCache[startClassId] = new Map<String, Array<MethodDefinition>>();
    }
    this.implementingMethodsCache[startClassId][mName] = methods;
    return methods;
  }

  findImplementingField(cType: ClassType, fName: String): FieldDefinition | null {
    let startClassId = if (cType.genericSource != null) (cType.genericSource as ClassType).id else cType.id;
    if (let (true, nulls) = this.implementingFieldNulls.get(startClassId)) {
      if (nulls.has(fName)) {
        return null;
      }
    }
    if (let (true, cache) = this.implementingFieldCache.get(startClassId)) {
      if (let (true, cached) = cache.get(fName)) {
        return cached;
      }
    }

    var curr: ClassType | null = cType;
    while (curr != null) {
      let ct = curr;
      let lookupId = (ct.genericSource ?? ct).symbolId;
      var model: SemanticModel | null = null;
      if (ct.sourcePath != "") {
        if (let (true, unit) = this.program.unitsByPath.get(ct.sourcePath)) {
          model = unit.model;
        }
      }
      if (model == null) {
        if (let (true, m) = this.program.modelIndex.symbolToModel.get(lookupId)) {
          model = m;
        }
      }
      if (model != null) {
        var body: Array<Node> | null = null;
        if (model.classDeclarations.has(lookupId)) {
          body = model.classDeclarations[lookupId].body;
        } else if (model.mixinDeclarations.has(lookupId)) {
          body = model.mixinDeclarations[lookupId].body;
        }
        if (body != null) {
          for (let member in (body as Array<Node>)) {
            if (member is FieldDefinition) {
              if (member.isAbstract) { continue; }
              let name = memberKeyOf(model, member.name as Node);
              if (matchMemberName(name, fName)) {
                if (!this.implementingFieldCache.has(startClassId)) {
                  this.implementingFieldCache[startClassId] = new Map<String, FieldDefinition>();
                }
                this.implementingFieldCache[startClassId][fName] = member;
                return member;
              }
            }
          }
        }
      }
      curr = ct.superType;
    }
    if (!this.implementingFieldNulls.has(startClassId)) {
      this.implementingFieldNulls[startClassId] = new Set<String>();
    }
    this.implementingFieldNulls[startClassId].add(fName);
    return null;
  }

  findImplementingAccessor(cType: ClassType, accName: String): AccessorDeclaration | null {
    let startClassId = if (cType.genericSource != null) (cType.genericSource as ClassType).id else cType.id;
    if (let (true, nulls) = this.implementingAccessorNulls.get(startClassId)) {
      if (nulls.has(accName)) {
        return null;
      }
    }
    if (let (true, cache) = this.implementingAccessorCache.get(startClassId)) {
      if (let (true, cached) = cache.get(accName)) {
        return cached;
      }
    }

    var curr: ClassType | null = cType;
    while (curr != null) {
      let ct = curr;
      let lookupId = (ct.genericSource ?? ct).symbolId;
      var model: SemanticModel | null = null;
      if (ct.sourcePath != "") {
        if (let (true, unit) = this.program.unitsByPath.get(ct.sourcePath)) {
          model = unit.model;
        }
      }
      if (model == null) {
        if (let (true, m) = this.program.modelIndex.symbolToModel.get(lookupId)) {
          model = m;
        }
      }
      if (model != null) {
        var body: Array<Node> | null = null;
        if (model.classDeclarations.has(lookupId)) {
          body = model.classDeclarations[lookupId].body;
        } else if (model.mixinDeclarations.has(lookupId)) {
          body = model.mixinDeclarations[lookupId].body;
        }
        if (body != null) {
          for (let member in (body as Array<Node>)) {
            if (member is AccessorDeclaration) {
              let name = getAccessorName(model as SemanticModel, member);
              if (accName.length > 4 && member.getter != null && accName.sliceBytes(0, 4) == "get#") {
                let targetProp = accName.sliceBytes(4, accName.length);
                if (matchMemberName(name, targetProp)) {
                  if (!this.implementingAccessorCache.has(startClassId)) {
                    this.implementingAccessorCache[startClassId] = new Map<String, AccessorDeclaration>();
                  }
                  this.implementingAccessorCache[startClassId][accName] = member;
                  return member;
                }
              }
              if (accName.length > 4 && member.setter != null && accName.sliceBytes(0, 4) == "set#") {
                let targetProp = accName.sliceBytes(4, accName.length);
                if (matchMemberName(name, targetProp)) {
                  if (!this.implementingAccessorCache.has(startClassId)) {
                    this.implementingAccessorCache[startClassId] = new Map<String, AccessorDeclaration>();
                  }
                  this.implementingAccessorCache[startClassId][accName] = member;
                  return member;
                }
              }
            }
          }
        }
      }
      curr = ct.superType;
    }
    if (!this.implementingAccessorNulls.has(startClassId)) {
      this.implementingAccessorNulls[startClassId] = new Set<String>();
    }
    this.implementingAccessorNulls[startClassId].add(accName);
    return null;
  }

  isSubclassOf(ct: ClassType, baseType: ClassType): boolean {
    let key = ((ct.id as i32) << 16) | (baseType.id as i32);
    if (let (true, cached) = this.subclassRelationCache.get(key)) {
      return cached;
    }
    
    let res = this.isSubclassOfDirect(ct, baseType);
    this.subclassRelationCache[key] = res;
    return res;
  }

  isSubclassOfDirect(ct: ClassType, baseType: ClassType): boolean {
    var curr: ClassType | null = ct;
    while (curr != null) {
      let currVal = curr;
      if (currVal.id == baseType.id) return true;
      if (currVal.genericSource != null && (currVal.genericSource as ClassType).id == baseType.id) return true;
      if (currVal.symbolId == baseType.symbolId) return true;
      if (currVal.genericSource != null && (currVal.genericSource as ClassType).symbolId == baseType.symbolId) return true;
      curr = currVal.superType;
    }
    return false;
  }

  collectAllBaseClassIds(ct: ClassType, list: Set<SymbolId>): void {
    var curr: ClassType | null = ct;
    while (curr != null) {
      let currVal = curr;
      list.add(currVal.symbolId);
      let {genericSource} = currVal;
      if (genericSource != null) {
        list.add(genericSource.symbolId);
      }
      curr = currVal.superType;
    }
  }

  registerInstantiatedClass(ct: ClassType): void {
    let baseIds = new Set<SymbolId>();
    this.collectAllBaseClassIds(ct, baseIds);
    for (let baseId in baseIds) {
      if (!this.subclassesByBaseId.has(baseId)) {
        this.subclassesByBaseId[baseId] = new Array<ClassType>();
      }
      this.subclassesByBaseId[baseId].push(ct);
    }
  }

  findInstantiatedSubclasses(baseType: ClassType): Array<ClassType> {
    let baseSymId = baseType.symbolId;
    if (let (true, list) = this.subclassesByBaseId.get(baseSymId)) {
      return list;
    }
    return new Array<ClassType>();
  }

  collectAllImplementedInterfaces(ct: ClassType): Array<InterfaceType> {
    let list = new Array<InterfaceType>();
    let seen = new Map<InterfaceKey, boolean>();
    
    let ctParams = getClassTypeParameters(ct);
    for (let iface in ct.implementsList) {
      let resolved = substituteTypeParamsInCodegen(this.wasm, ctParams, ct.typeArguments, iface) as InterfaceType;
      this.addInterfaceToTransitiveList(resolved, list, seen);
    }
    
    var curr = ct.superType;
    while (curr != null) {
      let superCt = curr;
      let superCtParams = getClassTypeParameters(superCt);
      for (let iface in superCt.implementsList) {
        let resolved = substituteTypeParamsInCodegen(this.wasm, superCtParams, superCt.typeArguments, iface) as InterfaceType;
        this.addInterfaceToTransitiveList(resolved, list, seen);
      }
      curr = superCt.superType;
    }
    
    return list;
  }

  addInterfaceToTransitiveList(it: InterfaceType, list: GrowableArray<InterfaceType>, seen: Map<InterfaceKey, boolean>): void {
    let key = getInterfaceKey(it);
    if (!seen.has(key)) {
      seen[key] = true;
      list.push(it);
      for (let ext in it.extendsList) {
        let resolvedExt = substituteTypeParamsInCodegen(this.wasm, getInterfaceTypeParameters(it), it.typeArguments, ext) as InterfaceType;
        this.addInterfaceToTransitiveList(resolvedExt, list, seen);
      }
    }
  }
}

let matchMemberName = (name: String, target: String): boolean => {
  if (name == target) {
    return true;
  }
  if (name.length > 0 && name.sliceBytes(0, 1) == ":") {
    return name.sliceBytes(1, name.length) == target;
  }
  return false;
};

let getMethodName = (model: SemanticModel, md: MethodDefinition): String => {
  return memberKeyOf(model, md.name as Node);
};

let getAccessorName =
    (model: SemanticModel, acc: AccessorDeclaration): String => {
  return memberKeyOf(model, acc.name as Node);
};

let collectMixinSymbolIds = (
  program: Program,
  model: SemanticModel,
  mixinAnns: GrowableArray<TypeAnnotation> | null,
  seenIds: Map<SymbolId, boolean>
): void => {
  if (mixinAnns == null) { return; }
  for (let ann in mixinAnns) {
    let sym = model.resolve(ann);
    if (sym != null) {
      let id = sym.id;
      if (!seenIds.has(id)) {
        seenIds[id] = true;
        let mt = model.getBindingType(sym);
        if (mt is MixinType) {
          let md = findMixinDeclaration(program, mt);
          if (md != null) {
            collectMixinSymbolIds(program, model, md.mixins, seenIds);
          }
        }
      }
    }
  }
};
