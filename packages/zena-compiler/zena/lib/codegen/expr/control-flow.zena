import { ValTypeVoid, ValTypeI32, ValTypeF32, ValTypeF64, ValTypeRefNull, ValTypeEqRef, ValTypeRef, valTypeEquals } from '../wasm.zena';
import { Node, IfExpression, Expression, BlockStatement, Statement, ExpressionStatement, ThrowExpression, TryExpression, CatchClause, Identifier, LetPatternCondition, TuplePattern, LiteralPattern, BooleanLiteral, NumberLiteral, StringLiteral, NullLiteral, PipelineExpression, PipePlaceholder } from '../../ast.zena';
import { Type, F64Type, F32Type, VoidType, InlineTupleType, UnionType, baseType, isVoidOrNeverType, NullType, HoleType, typeToString } from '../../types.zena';
import { ValType } from '../wasm.zena';
import { FunctionContext } from '../function-context.zena';
import { Error } from 'zena:error';
import { WasmTag, WasmGlobal, WasmStruct } from '../wasm-module.zena';
import { typeToValType, getExpressionType, typeToValTypeWithSub } from '../type-mapping.zena';
import { generatePatternBinding } from '../stmt/bindings.zena';
import { castRefNullIfNeeded } from './calls.zena';

export let generateIfExpression = (
  ctx: FunctionContext, 
  expr: IfExpression, 
  discardValue: boolean,
  genExpr: (e: Expression, discardValue: boolean) => void,
  genStmt: (s: Statement) => void
): void => {
  let nodeType = ctx.wasmFunction.model.getNodeType(expr);
  var resultValType: ValType = new ValTypeVoid();
  if (!discardValue && nodeType != null && !isVoidOrNeverType(nodeType as Type)) {
    // Substitute the enclosing class/method context: inside a
    // specialized generic body the if-expression may be checker-typed
    // by a type parameter that is concrete here — the plain mapping
    // yields anyref while both arms produce the concrete type.
    resultValType = typeToValTypeWithSub(ctx.wasm, nodeType as Type, ctx.wasmFunction);
  }
  let dropResult = discardValue || resultValType is ValTypeVoid;

  if (expr.test is LetPatternCondition) {
    let lpc = expr.test as LetPatternCondition;
    let pattern = lpc.pattern;
    if (pattern is TuplePattern) {
      let tp = pattern as TuplePattern;
      let initType = ctx.wasmFunction.model.getNodeType(lpc.init) as Type;
      var baseT = baseType(initType);
      var elementTypes: Array<Type> | null = null;
      if (baseT is InlineTupleType) {
        elementTypes = (baseT as InlineTupleType).elementTypes;
      } else if (baseT is UnionType) {
        for (let ut in (baseT as UnionType).types) {
          if (ut is InlineTupleType) {
            if (elementTypes == null) {
              elementTypes = (ut as InlineTupleType).elementTypes;
            }
          }
        }
      }
      
      if (elementTypes == null) {
        throw new Error("if-let expects inline tuple type");
      }
      let elemTypes = elementTypes as Array<Type>;
      
      // 1. Evaluate init (pushes values on stack)
      genExpr(lpc.init, false);
      
      // 2. Pop to temp locals in reverse order
      let tempLocals = new Array<i32>();
      for (var i = tp.elements.length - 1; i >= 0; i -= 1) {
        let elType = elemTypes[i];
        var valType = typeToValType(ctx.wasm, elType);
        if (baseT is UnionType) {
          var hasHoleOrNull = false;
          for (let ut in (baseT as UnionType).types) {
            if (ut is InlineTupleType) {
              let tupleTypes = (ut as InlineTupleType).elementTypes;
              if (i < tupleTypes.length) {
                let t_i = tupleTypes[i];
                if (t_i is HoleType || t_i is NullType) {
                  hasHoleOrNull = true;
                }
              }
            }
          }
          if (hasHoleOrNull) {
            valType = match (valType) {
              case ValTypeRef as vr: new ValTypeRefNull(vr.target)
              case _: valType
            };
          }
        }
        let temp = ctx.allocLocal(valType);
        tempLocals.push(temp);
        ctx.emitter.emitLocalSet(temp);
      }
      
      // 3. Emit condition (first element)
      ctx.emitter.emitLocalGet(tempLocals[tp.elements.length - 1]);
      
      // 4. Emit WASM if block with result type
      ctx.emitter.emitIf(resultValType);
      ctx.enterBlockStructure();
      
      let wasReachable = ctx.isReachable;
      
      // 5. Bind pattern variables
      for (var i = 0; i < tp.elements.length; i += 1) {
        let el = tp.elements[i];
        if (el != null && !(el is LiteralPattern) && !(el is BooleanLiteral) && !(el is NumberLiteral) && !(el is StringLiteral) && !(el is NullLiteral)) {
          let tempIndex = tempLocals[tp.elements.length - 1 - i];
          let localOffset = tempIndex - ctx.wasmFunction.signature.params.length;
          let tempValType = ctx.localTypes[localOffset];
          let loadValue = (): void => {
            ctx.emitter.emitLocalGet(tempIndex);
            let targetValType = typeToValTypeWithSub(ctx.wasm, elemTypes[i], ctx.wasmFunction);
            if (!valTypeEquals(tempValType, targetValType)) {
              match (targetValType) {
                case ValTypeRef as tr: { ctx.emitter.emitRefCast(tr.target.index); }
                case _: {}
              }
            }
          };
          generatePatternBinding(ctx, el as Node, elemTypes[i], loadValue);
        }
      }
      
      let expectedType = if (dropResult) null else (nodeType as Type);
      
      // 6. Generate consequent branch
      generateIfBranch(ctx, expr.consequent, expectedType, genExpr, genStmt);
      let consReachable = ctx.isReachable;
      
      // 7. Generate alternate branch (else)
      ctx.isReachable = wasReachable;
      if (expr.alternate != null) {
        ctx.emitter.emitElse();
        generateIfBranch(ctx, expr.alternate as Node, expectedType, genExpr, genStmt);
        let altReachable = ctx.isReachable;
        ctx.isReachable = consReachable || altReachable;
        if (!ctx.isReachable) {
          ctx.needsUnreachable = true;
        }
      } else {
        if (!(resultValType is ValTypeVoid)) {
          throw new Error("if-let expression returning value must have else branch");
        }
        ctx.isReachable = true;
      }
      
      ctx.exitBlockStructure();
      ctx.emitter.emitEnd();
      return;
    }
  }

  genExpr(expr.test as Expression, false);
  ctx.emitter.emitIf(resultValType);
  ctx.enterBlockStructure();

  let wasReachable = ctx.isReachable;

  let expectedType = if (dropResult) null else (nodeType as Type);

  generateIfBranch(ctx, expr.consequent, expectedType, genExpr, genStmt);
  let consReachable = ctx.isReachable;
  
  ctx.isReachable = wasReachable;
  if (expr.alternate != null) {
    ctx.emitter.emitElse();
    generateIfBranch(ctx, expr.alternate as Node, expectedType, genExpr, genStmt);
    let altReachable = ctx.isReachable;
    ctx.isReachable = consReachable || altReachable;
    if (!ctx.isReachable) {
      ctx.needsUnreachable = true;
    }
  } else {
    ctx.isReachable = wasReachable;
  }
  
  ctx.exitBlockStructure();
  ctx.emitter.emitEnd();
};


export let generateIfBranch = (
  ctx: FunctionContext,
  branch: Node,
  expectedType: Type | null,
  genExpr: (e: Expression, discardValue: boolean) => void,
  genStmt: (s: Statement) => void
): void => {
  if (branch is BlockStatement) {
    let block = branch as BlockStatement;
    if (expectedType == null) {
      genStmt(block);
    } else {
      // Evaluate all but last statement
      for (var i = 0; i < block.body.length - 1; i += 1) {
        genStmt(block.body[i]);
      }
      if (block.body.length > 0) {
        let lastStmt = block.body[block.body.length - 1];
        if (lastStmt is ExpressionStatement) {
          let exprStmt = lastStmt as ExpressionStatement;
          genExpr(exprStmt.expression, false);
          let argType = getExpressionType(ctx, exprStmt.expression);
          if (argType != null) {
            castRefNullIfNeeded(ctx, argType as Type, expectedType as Type);
          }
        } else {
          genStmt(lastStmt);
        }
      }
    }
  } else if (branch is Expression) {
    let expr = branch as Expression;
    genExpr(expr, expectedType == null);
    if (expectedType != null) {
      let argType = getExpressionType(ctx, expr);
      if (argType != null) {
        castRefNullIfNeeded(ctx, argType as Type, expectedType as Type);
      }
    }
  } else {
    throw new Error("Invalid if branch type in codegen");
  }
};

export let generateThrowExpression = (
  ctx: FunctionContext,
  expr: ThrowExpression,
  genExpr: (e: Expression) => void
): void => {
  ctx.wasm.ensureExceptionInfra(ctx.wasmFunction.model);
  
  genExpr(expr.argument);
  let payloadGlobal = ctx.wasm.exceptionPayload as WasmGlobal;
  ctx.emitter.emitGlobalSet(payloadGlobal.index);
  
  let tag = ctx.wasm.exceptionTag as WasmTag;
  ctx.emitter.emitThrow(tag.index);
  
  ctx.isReachable = false;
};

export let generateTryExpression = (
  ctx: FunctionContext,
  expr: TryExpression,
  discardValue: boolean,
  genExpr: (e: Expression, discardValue: boolean) => void,
  genStmt: (s: Statement) => void
): void => {
  let wasReachable = ctx.isReachable;
  ctx.wasm.ensureExceptionInfra(ctx.wasmFunction.model);
  let tag = ctx.wasm.exceptionTag as WasmTag;

  let nodeType = ctx.wasmFunction.model.getNodeType(expr as Node);
  let resultType = typeToValTypeWithSub(ctx.wasm, nodeType as Type, ctx.wasmFunction);

  var resultLocal: i32 = -1;
  var resultLocalType = resultType;
  if (!discardValue && !(resultType is ValTypeVoid)) {
    if (resultType is ValTypeRef) {
      let vr = resultType as ValTypeRef;
      resultLocalType = new ValTypeRefNull(vr.target);
    }
    resultLocal = ctx.allocLocal(resultLocalType);
  }

  let expectedType = if (resultLocal == -1) null else (nodeType as Type);

  if (expr.handler != null) {
    // block $done
    ctx.emitter.emitBlock(new ValTypeVoid());
    ctx.enterBlockStructure();

    // block $catch
    ctx.emitter.emitBlock(new ValTypeVoid());
    ctx.enterBlockStructure();

    // try_table with catch targeting block $catch (which is at depth 0 right now)
    ctx.emitter.emitTryTableCatch(new ValTypeVoid(), tag.index, 0);
    ctx.enterBlockStructure();

    // Generate try body
    generateIfBranch(ctx, expr.body as Node, expectedType, genExpr, genStmt);
    if (resultLocal != -1) {
      ctx.emitter.emitLocalSet(resultLocal);
    }

    // End try_table
    ctx.exitBlockStructure();
    ctx.emitter.emitEnd();

    // If we have finally, run it now (success path)
    if (expr.finalizer != null) {
      let tryReachable = ctx.isReachable;
      ctx.isReachable = wasReachable;
      generateIfBranch(ctx, expr.finalizer as Node, null, genExpr, genStmt);
      ctx.isReachable = tryReachable;
    }

    // Success - branch past catch block to done (block $done is at depth 1 right now)
    ctx.emitter.emitBr(1);

    // End block $catch
    ctx.exitBlockStructure();
    ctx.emitter.emitEnd();

    // Exception was caught - payload is in global.
    // Set up parameter if present
    ctx.isReachable = wasReachable;
    let handler = expr.handler as CatchClause;
    if (handler.param != null) {
      let paramIdent = handler.param as Identifier;
      let sym = ctx.wasmFunction.model.resolveDeclaration(paramIdent);
      if (sym != null) {
        var errorStruct: WasmStruct | null = null;
        for (let pair in ctx.wasm.classInfos) {
          let info = pair.value;
          let s = info.structType;
          if (s.name != null && (s.name as String) == "Error") {
            errorStruct = s;
          }
        }
        
        let localIdx = ctx.allocLocal(if (errorStruct != null) new ValTypeRefNull(errorStruct as WasmStruct) else new ValTypeEqRef());
        ctx.localIndices[sym.id] = localIdx;
        
        // Get payload from global
        let payloadGlobal = ctx.wasm.exceptionPayload as WasmGlobal;
        ctx.emitter.emitGlobalGet(payloadGlobal.index);
        
        // Cast to Error struct if found
        if (errorStruct != null) {
          ctx.emitter.emitRefCast((errorStruct as WasmStruct).index);
        }
        
        ctx.emitter.emitLocalSet(localIdx);
      }
    }

    // Generate catch body
    generateIfBranch(ctx, handler.body as Node, expectedType, genExpr, genStmt);
    if (resultLocal != -1) {
      ctx.emitter.emitLocalSet(resultLocal);
    }

    // If we have finally, run it (catch path)
    if (expr.finalizer != null) {
      let catchReachable = ctx.isReachable;
      ctx.isReachable = wasReachable;
      generateIfBranch(ctx, expr.finalizer as Node, null, genExpr, genStmt);
      ctx.isReachable = catchReachable;
    }

    // End block $done
    ctx.exitBlockStructure();
    ctx.emitter.emitEnd();

    // Load result on stack
    if (resultLocal != -1) {
      ctx.emitter.emitLocalGet(resultLocal);
      if (resultType is ValTypeRef) {
        ctx.emitter.emitRefAsNonNull();
      }
    }
  } else {
    // Only finally, no catch handler
    // We need to catch, run finally, then rethrow
    // Exception payload is in global, we save it to local for rethrowing

    // Local for exception payload
    let exnLocal = ctx.allocLocal(new ValTypeEqRef());
    let caughtLocal = ctx.allocLocal(new ValTypeI32());

    // Initialize caught flag to 0
    ctx.emitter.emitI32Const(0);
    ctx.emitter.emitLocalSet(caughtLocal);

    // Outer block $done
    ctx.emitter.emitBlock(new ValTypeVoid());
    ctx.enterBlockStructure();

    // Block $catch
    ctx.emitter.emitBlock(new ValTypeVoid());
    ctx.enterBlockStructure();

    // try_table with catch targeting block $catch (depth 0)
    ctx.emitter.emitTryTableCatch(new ValTypeVoid(), tag.index, 0);
    ctx.enterBlockStructure();

    // Generate try body
    generateIfBranch(ctx, expr.body as Node, expectedType, genExpr, genStmt);
    if (resultLocal != -1) {
      ctx.emitter.emitLocalSet(resultLocal);
    }

    // End try_table
    ctx.exitBlockStructure();
    ctx.emitter.emitEnd();

    // Success path - branch to done (depth 1)
    ctx.emitter.emitBr(1);

    // End block $catch
    ctx.exitBlockStructure();
    ctx.emitter.emitEnd();

    // Exception caught - read payload from global, save to local, set caught=1
    let payloadGlobal = ctx.wasm.exceptionPayload as WasmGlobal;
    ctx.emitter.emitGlobalGet(payloadGlobal.index);
    ctx.emitter.emitLocalSet(exnLocal);

    ctx.emitter.emitI32Const(1);
    ctx.emitter.emitLocalSet(caughtLocal);

    // End block $done
    ctx.exitBlockStructure();
    ctx.emitter.emitEnd();

    // Run finally (both paths end up here)
    ctx.isReachable = wasReachable;
    generateIfBranch(ctx, expr.finalizer as Node, null, genExpr, genStmt);

    // If we caught an exception, restore payload and rethrow
    ctx.emitter.emitLocalGet(caughtLocal);
    ctx.emitter.emitIf(new ValTypeVoid());
    ctx.enterBlockStructure();

    ctx.emitter.emitLocalGet(exnLocal);
    ctx.emitter.emitGlobalSet(payloadGlobal.index);
    ctx.emitter.emitThrow(tag.index);

    ctx.exitBlockStructure();
    ctx.emitter.emitEnd();

    // Load result
    if (resultLocal != -1) {
      ctx.emitter.emitLocalGet(resultLocal);
    }
  }
  
  ctx.isReachable = true;
};

export let generatePipelineExpression = (
  ctx: FunctionContext,
  expr: PipelineExpression,
  genExpr: (e: Expression, discardValue: boolean) => void
): void => {
  // Generate the left-hand side
  genExpr(expr.left, false);

  // Get the type of the piped value to determine the WASM type for the local
  let leftType = ctx.wasmFunction.model.getNodeType(expr.left);
  var wasmType: ValType = new ValTypeEqRef();
  if (leftType != null) {
    wasmType = typeToValType(ctx.wasm, leftType as Type);
  }

  // Store in a temporary local
  let tempLocal = ctx.allocLocal(wasmType);
  ctx.emitter.emitLocalSet(tempLocal);

  // Push the temp local index onto the pipeline stack
  ctx.pushPipelineLocal(tempLocal);

  // Generate the right-hand side (with $ available)
  genExpr(expr.right, false);

  // Pop the pipeline stack
  ctx.popPipelineLocal();
};

export let generatePipePlaceholder = (
  ctx: FunctionContext,
  expr: PipePlaceholder
): void => {
  let localIndex = ctx.getPipelineLocal();
  if (localIndex == -1) {
    throw new Error("Pipeline placeholder ($) used outside of pipeline expression");
  }

  ctx.emitter.emitLocalGet(localIndex);
};
