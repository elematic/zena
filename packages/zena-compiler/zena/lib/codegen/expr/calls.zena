import { Node, CallExpression, Identifier, Expression, ImportSpecifier, MemberExpression, SuperExpression, ClassDeclaration } from '../../ast.zena';
import { Type, FunctionType, ClassType, InterfaceType, typeToString } from '../../types.zena';
import { SymbolId, Symbol } from '../../scope/symbol.zena';
import { FunctionContext } from '../function-context.zena';
import { WasmType, ValTypeRef, ValTypeRefNull, ValTypeStructRef, ValType } from '../wasm.zena';
import { WasmFunction, getClassKey, getInterfaceKey, typeToValType, getInterfaceMemberSignature } from '../wasm-module.zena';
import { Error } from 'zena:error';
import { Array } from 'zena:array';
import { generateGlobalIntrinsic } from './intrinsics.zena';

export let generateCallExpression = (ctx: FunctionContext, call: CallExpression, genExpr: (e: Expression, discardValue: boolean) => void): void => {
  let calleeType = ctx.wasmFunction.model.getNodeType(call.callee);
  var ft: FunctionType | null = null;
  if (calleeType is FunctionType) {
    ft = calleeType as FunctionType;
  }

  match (call.callee) {
    case Identifier: {
      let ident = call.callee as Identifier;
      let model = ctx.wasmFunction.model;
      let sym = model.resolve(ident);
      
      if (sym == null) {
        throw new Error("Unresolved identifier in codegen: " + ident.name);
      }
      
      if (let (true, intrinsic) = ctx.wasm.intrinsics.get((sym as Symbol).id)) {
        generateGlobalIntrinsic(ctx, intrinsic, call, genExpr);
        return;
      }

      if (ctx.wasm.functionMap.has((sym as Symbol).id)) {
        var i = 0;
        while (i < call.args.length) {
          genExpr(call.args[i], false);
          if (ft != null && ft.parameterSymbols != null) {
            let syms = ft.parameterSymbols as Array<SymbolId>;
            if (i < syms.length && syms[i] != (-1 as SymbolId) && ctx.localIndices.has(syms[i])) {
              ctx.emitter.emitLocalTee(ctx.localIndices[syms[i]]);
            }
          }
          i += 1;
        }
        ctx.emitter.emitCall(ctx.wasm.functionMap[(sym as Symbol).id]);
        return;
      } else {
        if ((sym as Symbol).declaration is ImportSpecifier) {
          let spec = (sym as Symbol).declaration as ImportSpecifier;
          let importedName = spec.imported.name;
          if (ctx.wasm.exportMap.has(importedName)) {
            var i = 0;
            while (i < call.args.length) {
              genExpr(call.args[i], false);
              if (ft != null && ft.parameterSymbols != null) {
                let syms = ft.parameterSymbols as Array<SymbolId>;
                if (i < syms.length && syms[i] != (-1 as SymbolId) && ctx.localIndices.has(syms[i])) {
                  ctx.emitter.emitLocalTee(ctx.localIndices[syms[i]]);
                }
              }
              i += 1;
            }
            ctx.emitter.emitCall(ctx.wasm.exportMap[importedName]);
            return;
          }
          throw new Error("Export map missing: " + importedName);
        }
        throw new Error("Could not resolve function call target: " + ident.name);
      }
    }
    case MemberExpression: {
      let member = call.callee as MemberExpression;
      
      if (member.object is SuperExpression) {
        if (ctx.wasmFunction.classType == null) {
          throw new Error("Super call outside of class");
        }
        let currentClass = ctx.wasmFunction.classType as ClassType;
        if (currentClass.superType == null) {
          throw new Error("Super call in class without superType: " + currentClass.name);
        }
        let superType = currentClass.superType as ClassType;
        let targetName = member.property.name;
        
        // Find the specific WasmFunction for this static class method call starting from superType
        var foundFunc: WasmFunction | null = null;
        var currClass: ClassType | null = superType;
        while (currClass != null && foundFunc == null) {
          for (let f in ctx.wasm.functions) {
            if (f.classType != null && (f.classType as ClassType).id == (currClass as ClassType).id && f.methodName == targetName) {
              foundFunc = f;
            }
          }
          currClass = (currClass as ClassType).superType;
        }

        if (foundFunc == null) {
          throw new Error("Could not find super method for call: " + targetName);
        }

        // 1. Emit arguments: `this` first, then args.
        // `member.object` is SuperExpression which evaluates to `this` (param 0).
        genExpr(member.object, false);
        
        var argIdx = 0;
        while (argIdx < call.args.length) {
          genExpr(call.args[argIdx], false);
          argIdx += 1;
        }

        // 2. Direct static call
        ctx.emitter.emitCall(foundFunc as WasmFunction);
        return;
      }
      
      let objType = ctx.wasmFunction.model.getNodeType(member.object);
      
      if (objType is ClassType) {
        let ct = objType as ClassType;

        let isStaticAccess = ctx.wasmFunction.model.isStaticAccess(member);

        if (isStaticAccess) {
          let targetName = member.property.name;
          
          // Look up the specific WasmFunction for this static call
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = ct;
          while (currClass != null && foundFunc == null) {
            for (let f in ctx.wasm.functions) {
              if (f.classType != null && f.isStatic && (f.classType as ClassType).id == (currClass as ClassType).id && f.methodName == targetName) {
                foundFunc = f;
              }
            }
            currClass = (currClass as ClassType).superType;
          }

          if (foundFunc == null) {
            throw new Error("Could not find static function for method call: " + targetName);
          }

          // Generate arguments (static call has no `this` argument)
          var argIdx = 0;
          while (argIdx < call.args.length) {
            genExpr(call.args[argIdx], false);
            argIdx += 1;
          }

          // Direct static call
          ctx.emitter.emitCall(foundFunc as WasmFunction);
          return;
        }

        if (ct.isExtension) {
          let targetName = member.property.name;
          
          // Look up the specific WasmFunction for this call
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = ct;
          while (currClass != null && foundFunc == null) {
            for (let f in ctx.wasm.functions) {
              if (f.classType != null && (f.classType as ClassType).id == (currClass as ClassType).id && f.methodName == targetName) {
                foundFunc = f;
              }
            }
            currClass = (currClass as ClassType).superType;
          }

          if (foundFunc == null) {
            throw new Error("Could not find extension function for method call: " + targetName);
          }

          // 1. Emit arguments: `this` first, then args.
          genExpr(member.object, false);
          
          var argIdx = 0;
          while (argIdx < call.args.length) {
            genExpr(call.args[argIdx], false);
            argIdx += 1;
          }

          // 2. Direct static call
          ctx.emitter.emitCall(foundFunc as WasmFunction);
          return;
        }

        let structInfo = ctx.wasm.classStructs[getClassKey(ct)];
        let vtableStruct = ctx.wasm.classVTableStructs[getClassKey(ct)];
        
        let targetName = member.property.name;
        
        // Find method index in vtable
        var methodIndex = -1;
        for (var i = 0; i < vtableStruct.fields.length; i += 1) {
          if (vtableStruct.fields[i].name == targetName) {
            methodIndex = i;
          }
        }
        
        if (methodIndex == -1) {
          throw new Error("Method not found in vtable: " + targetName);
        }
        
        // 1. Emit arguments: `this` first, then args
        genExpr(member.object, false);
        // Cast to our struct type to grab vtable
        var scratchLocal = ctx.getStructScratchLocal(structInfo);
        ctx.emitter.emitLocalTee(scratchLocal);
        
        var argIdx = 0;
        while (argIdx < call.args.length) {
          genExpr(call.args[argIdx], false);
          argIdx += 1;
        }
        
        // 2. Load the vtable map and extract function ref
        ctx.emitter.emitLocalGet(scratchLocal);
        ctx.emitter.emitRefCast(structInfo.index);
        ctx.emitter.emitStructGet(structInfo.index, 0); // VTable is always field 0
        ctx.emitter.emitRefCast(vtableStruct.index);
        ctx.emitter.emitStructGet(vtableStruct.index, methodIndex); // Function ref
        
        // Look up the specific WasmFunction for this call to get its accurate signature type
        var foundFunc: WasmFunction | null = null;
        var currClass: ClassType | null = ct;
        while (currClass != null && foundFunc == null) {
          for (let f in ctx.wasm.functions) {
            if (f.classType != null && (f.classType as ClassType).id == (currClass as ClassType).id && f.methodName == targetName) {
              foundFunc = f;
            }
          }
          currClass = (currClass as ClassType).superType;
        }

        if (foundFunc == null) {
          throw new Error("Could not find function for method call: " + targetName);
        }

        // Cast the generic funcref from the vtable to the specific implementation signature type
        ctx.emitter.emitRefCast((foundFunc as WasmFunction).signature.index);

        // 3. Call reference
        ctx.emitter.emitCallRef((foundFunc as WasmFunction).signature.index);
        return;
      }
      
      if (objType is InterfaceType) {
        let it = objType as InterfaceType;
        let iName = getInterfaceKey(it);
        let vst = ctx.wasm.interfaceVTableStructs[iName];
        let fatPtr = ctx.wasm.interfaceStructs[iName];
        
        let targetName = member.property.name;
        
        var methodIndex = -1;
        for (var i = 0; i < vst.fields.length; i += 1) {
          if (vst.fields[i].name == targetName) {
            methodIndex = i;
          }
        }
        
        if (methodIndex == -1) {
          throw new Error("Method not found in interface vtable: " + targetName);
        }
        
        genExpr(member.object, false);
        var scratchLocal = ctx.getStructScratchLocal(fatPtr);
        ctx.emitter.emitLocalTee(scratchLocal);
        ctx.emitter.emitStructGet(fatPtr.index, 0); // Get Instance
        
        var argIdx = 0;
        while (argIdx < call.args.length) {
          genExpr(call.args[argIdx], false);
          argIdx += 1;
        }
        
        ctx.emitter.emitLocalGet(scratchLocal);
        ctx.emitter.emitStructGet(fatPtr.index, 1); // Get VTable
        ctx.emitter.emitRefCast(vst.index);
        ctx.emitter.emitStructGet(vst.index, methodIndex); // Get Function reference
        
        let sig = getInterfaceMemberSignature(ctx.wasm, it, targetName);
        ctx.emitter.emitRefCast(sig.index);
        ctx.emitter.emitCallRef(sig.index);
        return;
      }
      throw new Error("Unsupported method call on type: " + typeToString(objType));
    }
    case _: {
      throw new Error("Unsupported call expression");
    }        
  }
};
