import { Node, CallExpression, Identifier, Expression, ImportSpecifier, MemberExpression, SuperExpression, ClassDeclaration, ImportDeclaration, Module, IdentifierPattern, DeclareFunction, VariableDeclaration, InterfaceDeclaration, EnumDeclaration, MixinDeclaration, TypeAliasDeclaration, SymbolDeclaration } from '../../ast.zena';
import { Type, FunctionType, ClassType, InterfaceType, VoidType, ArrayType, UnionType, TypeParameterType, typeToString } from '../../types.zena';
import { SymbolId, Symbol } from '../../scope/symbol.zena';
import { SemanticModel } from '../../semantic-model.zena';
import { FunctionContext } from '../function-context.zena';
import { WasmType, ValTypeRef, ValTypeRefNull, ValTypeStructRef, ValType, ValTypeEqRef, ValTypeVoid, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeAnyRef, HeapType, heapTypeToSigned } from '../wasm.zena';
import { WasmFunction, WasmStruct, WasmSignature } from '../wasm-module.zena';
import { getClassKey, getInterfaceKey, getSignatureKey, ClassKey, InterfaceKey, ExportKey, getTypeKeyForSpecialization } from '../codegen-utils.zena';
import { typeToValType, getInterfaceMemberSignature, getClassMemberSignature, getClosureStruct, mapReturnTypeToWasmResults, getNodeType, getNonNullableType } from '../type-mapping.zena';
import { Error } from 'zena:error';
import { Array } from 'zena:array';
import { generateGlobalIntrinsic, generateArrayIntrinsic, isArrayIntrinsic } from './intrinsics.zena';
import { dirName, normalizePath } from '../../module-resolver.zena';
import { i32ToString } from 'zena:string-convert';
import { console } from 'zena:console';

let generateClosureCall = (
  ctx: FunctionContext,
  callee: Expression,
  args: Array<Expression>,
  ftVal: FunctionType,
  genExpr: (e: Expression, discardValue: boolean) => void
): void => {
  let closureStruct = getClosureStruct(ctx.wasm, ftVal);
  
  // 1. Evaluate callee (closure struct)
  genExpr(callee, false);
  let closureLocal = ctx.allocLocal(new ValTypeRefNull(closureStruct));
  ctx.emitter.emitLocalSet(closureLocal);
  
  // 2. Push context pointer onto stack (param 0)
  ctx.emitter.emitLocalGet(closureLocal);
  ctx.emitter.emitStructGet(closureStruct.index, 1);
  
  // 3. Push arguments (params 1..N)
  var i = 0;
  while (i < args.length) {
    let arg = args[i];
    genExpr(arg, false);
    i += 1;
  }
  
  // 4. Push function reference onto stack
  ctx.emitter.emitLocalGet(closureLocal);
  ctx.emitter.emitStructGet(closureStruct.index, 0);
  
  // 5. Get implementation signature and call_ref
  let params = new Array<ValType>();
  params.push(new ValTypeEqRef()); // ctx
  for (let p in ftVal.parameters) {
    params.push(typeToValType(ctx.wasm, p));
  }
  let returns = new Array<ValType>();
  if (!(ftVal.returnType is VoidType)) {
    returns.push(typeToValType(ctx.wasm, ftVal.returnType));
  }
  let implSig = ctx.wasm.getSignature(params, returns);
  
  ctx.emitter.emitCallRef(implSig.index);
};

export let generateCallExpression = (ctx: FunctionContext, call: CallExpression, genExpr: (e: Expression, discardValue: boolean) => void): void => {
  var genCallee = (): void => {
    genExpr(call.callee, false);
  };

  let customGenExpr = (e: Expression, discardValue: boolean): void => {
    if (e == call.callee) {
      genCallee();
    } else {
      genExpr(e, discardValue);
    }
  };

  var hasEnteredOptionalIf = false;

  let generateNonNullCall = (currentGenExpr: (e: Expression, discardValue: boolean) => void): void => {
    let unionCalleeType = ctx.wasmFunction.model.getUnionCallCalleeType(call.callee);
    if (unionCalleeType != null) {
      let ut = unionCalleeType as UnionType;
      currentGenExpr(call.callee, false);
      let calleeLocal = ctx.allocLocal(new ValTypeEqRef());
      ctx.emitter.emitLocalSet(calleeLocal);
      
      let argLocals = new Array<i32>();
      for (let arg in call.args) {
        currentGenExpr(arg, false);
        let argType = getNodeType(ctx, arg);
        if (argType == null) throw new Error("Missing union callee argument type info");
        let argLocal = ctx.allocLocal(typeToValType(ctx.wasm, argType));
        ctx.emitter.emitLocalSet(argLocal);
        argLocals.push(argLocal);
      }
      
      let callType = getNodeType(ctx, call);
      if (callType == null) throw new Error("Missing union call return type info");
      var resultLocal = -1;
      if (!(callType is VoidType)) {
        resultLocal = ctx.allocLocal(typeToValType(ctx.wasm, callType));
      }
      
      ctx.emitter.emitBlock(new ValTypeVoid());
      
      for (let member in ut.types) {
        if (member is FunctionType) {
          let ftVal = member as FunctionType;
          let closureStruct = getClosureStruct(ctx.wasm, ftVal);
          
          ctx.emitter.emitLocalGet(calleeLocal);
          ctx.emitter.emitRefTest(closureStruct.index);
          ctx.emitter.emitIf(new ValTypeVoid());
          
          ctx.emitter.emitLocalGet(calleeLocal);
          ctx.emitter.emitRefCast(closureStruct.index);
          ctx.emitter.emitStructGet(closureStruct.index, 1);
          
          let sigParams = new Array<ValType>();
          sigParams.push(new ValTypeEqRef());
          for (let p in ftVal.parameters) {
            sigParams.push(typeToValType(ctx.wasm, p));
          }
          let arity = sigParams.length - 1;
          var argIdx = 0;
          while (argIdx < arity) {
            ctx.emitter.emitLocalGet(argLocals[argIdx]);
            argIdx += 1;
          }
          
          ctx.emitter.emitLocalGet(calleeLocal);
          ctx.emitter.emitRefCast(closureStruct.index);
          ctx.emitter.emitStructGet(closureStruct.index, 0);
          
          let returns = new Array<ValType>();
          if (!(ftVal.returnType is VoidType)) {
            returns.push(typeToValType(ctx.wasm, ftVal.returnType));
          }
          let implSig = ctx.wasm.getSignature(sigParams, returns);
          ctx.emitter.emitCallRef(implSig.index);
          
          if (resultLocal != -1) {
            ctx.emitter.emitLocalSet(resultLocal);
          }
          
          ctx.emitter.emitBr(1);
          ctx.emitter.emitEnd();
        }
      }
      
      ctx.emitter.emitUnreachable();
      ctx.emitter.emitEnd();
      
      if (resultLocal != -1) {
        ctx.emitter.emitLocalGet(resultLocal);
      }
      return;
    }

    let calleeType = getNonNullableType(getNodeType(ctx, call.callee) as Type);
    var ft: FunctionType | null = null;
    if (calleeType is FunctionType) {
      ft = calleeType as FunctionType;
    }

    var isDirectCall = false;
    match (call.callee) {
      case Identifier: {
        let ident = call.callee as Identifier;
        let sym = ctx.wasmFunction.model.resolve(ident);
        if (sym != null) {
          let targetDecl = findDeclaration(ctx, sym as Symbol, ft);
          if (ctx.wasm.functionMap.has((sym as Symbol).id) || 
              (targetDecl != null && ctx.wasm.intrinsics.has((targetDecl as DeclareFunction).id)) || 
              (sym as Symbol).declaration is ImportSpecifier) {
            isDirectCall = true;
          }
        } else {
          if (isArrayIntrinsic(ident.name)) {
            isDirectCall = true;
          }
        }
      }
      case MemberExpression: {
        isDirectCall = true;
      }
      case SuperExpression: {
        isDirectCall = true;
      }
      case _: {}
    }

    if (!isDirectCall && ft != null) {
      let fType = ft as FunctionType;
      let paramValTypes = new Array<ValType>();
      paramValTypes.push(new ValTypeEqRef()); // context
      for (let p in fType.parameters) {
        paramValTypes.push(typeToValType(ctx.wasm, p));
      }
      let returnValTypes = new Array<ValType>();
      if (!(fType.returnType is VoidType)) {
        returnValTypes.push(typeToValType(ctx.wasm, fType.returnType));
      }
      
      let sig = ctx.wasm.getSignature(paramValTypes, returnValTypes);
      
      let closureStruct = getClosureStruct(ctx.wasm, fType);
      currentGenExpr(call.callee, false);
      let closureLocal = ctx.allocLocal(new ValTypeRefNull(closureStruct));
      ctx.emitter.emitLocalSet(closureLocal);
      
      ctx.emitter.emitLocalGet(closureLocal);
      ctx.emitter.emitStructGet(closureStruct.index, 1);
      
      var i = 0;
      while (i < call.args.length) {
        currentGenExpr(call.args[i], false);
        i += 1;
      }
      
      ctx.emitter.emitLocalGet(closureLocal);
      ctx.emitter.emitStructGet(closureStruct.index, 0);
      
      ctx.emitter.emitCallRef(sig.index);
      return;
    }

    match (call.callee) {
      case Identifier: {
        let ident = call.callee as Identifier;
        let sym = ctx.wasmFunction.model.resolve(ident);
        if (sym != null) {
          let symVal = sym as Symbol;
          let decl = findDeclaration(ctx, symVal, ft);
          
          if (decl != null && ctx.wasm.intrinsics.has((decl as DeclareFunction).id)) {
            let intrinsicName = ctx.wasm.intrinsics[(decl as DeclareFunction).id] as String;
            generateGlobalIntrinsic(ctx, intrinsicName, call, currentGenExpr);
            return;
          }
          
          if (decl == null && isArrayIntrinsic(ident.name)) {
            generateArrayIntrinsic(ctx, ident.name, call, currentGenExpr);
            return;
          }
          
          var isImport = false;
          var importedName = "";
          if (symVal.declaration != null && symVal.declaration is ImportSpecifier) {
            isImport = true;
            importedName = (symVal.declaration as ImportSpecifier).imported.name;
          }
          
          if (ctx.wasm.functionMap.has(symVal.id)) {
            let f = ctx.wasm.functionMap[symVal.id];
            var i = 0;
            while (i < call.args.length) {
              let arg = call.args[i];
              currentGenExpr(arg, false);
              if (ft != null && ft.parameterSymbols != null) {
                let syms = ft.parameterSymbols as Array<SymbolId>;
                if (i < syms.length && syms[i] != (-1 as SymbolId) && ctx.localIndices.has(syms[i])) {
                  ctx.emitter.emitLocalTee(ctx.localIndices[syms[i]]);
                }
              }
              i += 1;
            }
            ctx.emitter.emitCall(f);
            return;
          } else if (isImport) {
            // If we imported the function, check if it's in the functionMap by looking up
            // the imported symbol from its source module.
            let importedSymId = resolveImportedSymbolId(ctx, symVal.declaration as ImportSpecifier, ft);
            if (importedSymId != (-1 as SymbolId) && ctx.wasm.functionMap.has(importedSymId)) {
              let f = ctx.wasm.functionMap[importedSymId];
              var i = 0;
              while (i < call.args.length) {
                let arg = call.args[i];
                currentGenExpr(arg, false);
                if (ft != null && ft.parameterSymbols != null) {
                  let syms = ft.parameterSymbols as Array<SymbolId>;
                  if (i < syms.length && syms[i] != (-1 as SymbolId) && ctx.localIndices.has(syms[i])) {
                    ctx.emitter.emitLocalTee(ctx.localIndices[syms[i]]);
                  }
                }
                i += 1;
              }
              ctx.emitter.emitCall(f);
              return;
            }
            throw new Error("Export map missing: " + importedName);
          } else if (ft != null) {
            generateClosureCall(ctx, call.callee, call.args, ft as FunctionType, currentGenExpr);
            return;
          }
        } else {
          if (isArrayIntrinsic(ident.name)) {
            generateArrayIntrinsic(ctx, ident.name, call, currentGenExpr);
            return;
          }
          if (ft != null) {
            generateClosureCall(ctx, call.callee, call.args, ft as FunctionType, currentGenExpr);
            return;
          }
          throw new Error("Unresolved identifier in codegen: " + ident.name);
        }
      }
      case MemberExpression: {
        let member = call.callee as MemberExpression;
        let objType = getNonNullableType(getNodeType(ctx, member.object) as Type);
        let targetName = member.property.name;
        
        if (member.object is SuperExpression) {
          if (ctx.wasmFunction.classType == null) {
            throw new Error("Super call outside of class");
          }
          let currentClass = ctx.wasmFunction.classType as ClassType;
          if (currentClass.superType == null) {
            throw new Error("Super call in class without superType: " + currentClass.name);
          }
          let superType = currentClass.superType as ClassType;
          var lookupName = targetName;
          if (superType.members.has(targetName)) {
            let mInfo = superType.members[targetName];
            if (mInfo.type is FunctionType) {
              let baseFt = mInfo.type as FunctionType;
              if (baseFt.overloads != null && ft != null) {
                lookupName = targetName + getSignatureKey(ft as FunctionType);
              }
            }
          }
          
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = superType;
          while (currClass != null && foundFunc == null) {
            for (let f in ctx.wasm.functions) {
              if (f.classType != null && !f.isStatic && 
                  getClassKey(f.classType as ClassType) == getClassKey(currClass as ClassType) && 
                  f.methodName != null && (f.methodName as String) == lookupName) {
                foundFunc = f;
              }
            }
            currClass = (currClass as ClassType).superType;
          }
          
          if (foundFunc == null) {
            throw new Error("Could not find super method for call: " + targetName);
          }
          
          ctx.emitter.emitLocalGet(0);
          
          var argIdx = 0;
          while (argIdx < call.args.length) {
            let arg = call.args[argIdx];
            currentGenExpr(arg, false);
            argIdx += 1;
          }
          
          ctx.emitter.emitCall(foundFunc as WasmFunction);
          return;
        }
        
        var lookupName = targetName;
        if (objType is ClassType) {
          let ct = objType as ClassType;
          if (ct.members.has(targetName)) {
            let mInfo = ct.members[targetName];
            if (mInfo.type is FunctionType) {
              let baseFt = mInfo.type as FunctionType;
              if (baseFt.overloads != null && ft != null) {
                lookupName = targetName + getSignatureKey(ft as FunctionType);
              }
            }
          }
        }

        if (objType is ClassType && ctx.wasmFunction.model.isStaticAccess(member)) {
          let ct = objType as ClassType;
          
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = ct;
          while (currClass != null && foundFunc == null) {
            for (let f in ctx.wasm.functions) {
              if (f.classType != null && f.isStatic &&
                  getClassKey(f.classType as ClassType) == getClassKey(currClass as ClassType) && 
                  f.methodName != null && (f.methodName as String) == lookupName) {
                foundFunc = f;
              }
            }
            currClass = (currClass as ClassType).superType;
          }

          if (foundFunc != null) {
            var i = 0;
            while (i < call.args.length) {
              currentGenExpr(call.args[i], false);
              i += 1;
            }
            ctx.emitter.emitCall(foundFunc as WasmFunction);
            return;
          }
          throw new Error("Could not find static method: " + targetName + " on class: " + ct.name);
        }

        if (objType is ClassType) {
          let ct = objType as ClassType;
          
          if (ct.isExtension) {
            var foundFunc: WasmFunction | null = null;
            var currClass: ClassType | null = ct;
            while (currClass != null && foundFunc == null) {
              for (let f in ctx.wasm.functions) {
                if (f.classType != null && 
                    getClassKey(f.classType as ClassType) == getClassKey(currClass as ClassType) && 
                    f.methodName != null && (f.methodName as String) == lookupName) {
                  foundFunc = f;
                }
              }
              currClass = (currClass as ClassType).superType;
            }

            if (foundFunc == null) {
              throw new Error("Could not find extension function for method call: " + targetName);
            }

            currentGenExpr(member.object, false);
            
            let f = foundFunc as WasmFunction;
            var argIdx = 0;
            while (argIdx < call.args.length) {
              let arg = call.args[argIdx];
              currentGenExpr(arg, false);
              argIdx += 1;
            }

            ctx.emitter.emitCall(foundFunc as WasmFunction);
            return;
          }

          let ctKey = getClassKey(ct);
          if (!ctx.wasm.classStructs.has(ctKey)) {
            throw new Error("Class struct not found for: " + ct.name + " key: " + (ctKey as String));
          }
          if (!ctx.wasm.classVTableStructs.has(ctKey)) {
            throw new Error("Class VTable struct not found for: " + ct.name + " key: " + (ctKey as String));
          }
          let structInfo = ctx.wasm.classStructs[ctKey];
          let vtableStruct = ctx.wasm.classVTableStructs[ctKey];
          
          var methodIndex = -1;
          for (var i = 0; i < vtableStruct.fields.length; i += 1) {
            if (vtableStruct.fields[i].name != null && (vtableStruct.fields[i].name as String) == lookupName) {
              methodIndex = i;
            }
          }
          
          if (methodIndex == -1) {
            if (ft != null) {
              generateClosureCall(ctx, call.callee, call.args, ft as FunctionType, currentGenExpr);
              return;
            }
            throw new Error("Method not found in vtable: " + targetName);
          }
          
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = ct;
          while (currClass != null && foundFunc == null) {
            for (let f in ctx.wasm.functions) {
              if (f.classType != null && 
                  getClassKey(f.classType as ClassType) == getClassKey(currClass as ClassType) && 
                  f.methodName != null && (f.methodName as String) == lookupName) {
                foundFunc = f;
              }
            }
            currClass = (currClass as ClassType).superType;
          }

          let sig = if (foundFunc != null) (foundFunc as WasmFunction).signature else getClassMemberSignature(ctx.wasm, ct, targetName);
          let sigIndex = sig.index;

          currentGenExpr(member.object, false);
          var scratchLocal = ctx.getStructScratchLocal(structInfo);
          ctx.emitter.emitLocalTee(scratchLocal);
          
          var argIdx = 0;
          while (argIdx < call.args.length) {
            let arg = call.args[argIdx];
            currentGenExpr(arg, false);
            argIdx += 1;
          }
          
          ctx.emitter.emitLocalGet(scratchLocal);
          ctx.emitter.emitRefCast(structInfo.index);
          ctx.emitter.emitStructGet(structInfo.index, 0); 
          ctx.emitter.emitRefCast(vtableStruct.index);
          ctx.emitter.emitStructGet(vtableStruct.index, methodIndex); 

          ctx.emitter.emitRefCast(sigIndex);
          ctx.emitter.emitCallRef(sigIndex);
          return;
        }
        
        if (objType is InterfaceType) {
          let it = objType as InterfaceType;
          let iName = getInterfaceKey(it);
          let vst = ctx.wasm.interfaceVTableStructs[iName];
          let fatPtr = ctx.wasm.interfaceStructs[iName];
          
          var methodIndex = -1;
          for (var i = 0; i < vst.fields.length; i += 1) {
            if (vst.fields[i].name != null && (vst.fields[i].name as String) == targetName) {
              methodIndex = i;
            }
          }
          
          if (methodIndex == -1) {
            if (ft != null) {
              generateClosureCall(ctx, call.callee, call.args, ft as FunctionType, currentGenExpr);
              return;
            }
            throw new Error("Method not found in interface vtable: " + targetName);
          }
          
          let sig = getInterfaceMemberSignature(ctx.wasm, it, targetName);

          currentGenExpr(member.object, false);
          var scratchLocal = ctx.getStructScratchLocal(fatPtr);
          ctx.emitter.emitLocalTee(scratchLocal);
          ctx.emitter.emitStructGet(fatPtr.index, 0); 
          
          var argIdx = 0;
          while (argIdx < call.args.length) {
            let arg = call.args[argIdx];
            currentGenExpr(arg, false);
            argIdx += 1;
          }
          
          ctx.emitter.emitLocalGet(scratchLocal);
          ctx.emitter.emitStructGet(fatPtr.index, 1); 
          ctx.emitter.emitStructGet(vst.index, methodIndex); 
          
          ctx.emitter.emitCallRef(sig.index);
          return;
        }

        var isArray = false;
        var elemType: Type | null = null;
        match (objType) {
          case ArrayType as at: {
            isArray = true;
            elemType = at.elementType;
          }
          case ClassType as ct: {
            if (ct.name == "array" && ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0) {
              isArray = true;
              elemType = (ct.typeArguments as Array<Type>)[0];
            }
          }
          case _: {}
        }
        
        if (isArray) {
          var foundFunc: WasmFunction | null = null;
          for (let f in ctx.wasm.functions) {
            if (f.classType != null && f.methodName != null && (f.methodName as String) == targetName) {
              let fClass = f.classType as ClassType;
              let className = fClass.name;
              if (className == "FixedArray" || className == "ImmutableArray") {
                if (fClass.typeArguments != null && (fClass.typeArguments as Array<Type>).length > 0) {
                  let fTypeArg = (fClass.typeArguments as Array<Type>)[0];
                  if (getTypeKeyForSpecialization(elemType as Type) == getTypeKeyForSpecialization(fTypeArg)) {
                    foundFunc = f;
                  }
                }
              }
            }
          }
          
          if (foundFunc == null) {
            throw new Error("Could not find extension function for array method call: " + targetName + " for element type " + typeToString(elemType as Type));
          }

          let f = foundFunc as WasmFunction;
          currentGenExpr(member.object, false);
          
          var argIdx = 0;
          while (argIdx < call.args.length) {
            currentGenExpr(call.args[argIdx], false);
            argIdx += 1;
          }

          ctx.emitter.emitCall(foundFunc as WasmFunction);
          return;
        }

        throw new Error("Unsupported method call on type: " + typeToString(objType));
      }
      case SuperExpression: {
        if (ctx.wasmFunction.classType == null) {
          throw new Error("Super call outside of class");
        }
        let currentClass = ctx.wasmFunction.classType as ClassType;
        if (currentClass.superType == null) {
          throw new Error("Super call in class without superType: " + currentClass.name);
        }
        let superType = currentClass.superType as ClassType;
        let member = call.callee as MemberExpression;
        let targetName = member.property.name;
        var lookupName = targetName;
        if (superType.members.has(targetName)) {
          let mInfo = superType.members[targetName];
          if (mInfo.type is FunctionType) {
            let baseFt = mInfo.type as FunctionType;
            if (baseFt.overloads != null && ft != null) {
              lookupName = targetName + getSignatureKey(ft as FunctionType);
            }
          }
        }
        
        var foundFunc: WasmFunction | null = null;
        var currClass: ClassType | null = superType;
        while (currClass != null && foundFunc == null) {
          for (let f in ctx.wasm.functions) {
            if (f.classType != null && f.isStatic && 
                getClassKey(f.classType as ClassType) == getClassKey(currClass as ClassType) && 
                f.methodName != null && (f.methodName as String) == lookupName) {
              foundFunc = f;
            }
          }
          currClass = (currClass as ClassType).superType;
        }

        if (foundFunc == null) {
          throw new Error("Could not find super method for call: " + targetName);
        }

        currentGenExpr(member.object, false);
        
        let f = foundFunc as WasmFunction;
        var argIdx = 0;
        while (argIdx < call.args.length) {
          let arg = call.args[argIdx];
          currentGenExpr(arg, false);
          argIdx += 1;
        }

        ctx.emitter.emitCall(foundFunc as WasmFunction);
        return;
      }
      case _: {
        if (ft != null) {
          generateClosureCall(ctx, call.callee, call.args, ft as FunctionType, currentGenExpr);
          return;
        }
        throw new Error("Unsupported call expression");
      }        
    }
  };

  if (call.optional) {
    genExpr(call.callee, false);

    let calleeType = ctx.wasmFunction.model.getNodeType(call.callee);
    if (calleeType == null) throw new Error("Missing callee type info in semantic model");
    let calleeValType = typeToValType(ctx.wasm, calleeType);
    let calleeLocal = ctx.allocLocal(calleeValType);
    ctx.emitter.emitLocalSet(calleeLocal);

    ctx.emitter.emitLocalGet(calleeLocal);
    ctx.emitter.emitRefIsNull();
    ctx.emitter.emitI32Eqz();

    let overallType = ctx.wasmFunction.model.getNodeType(call);
    if (overallType == null) throw new Error("Missing call expression type info in semantic model");
    let overallValType = typeToValType(ctx.wasm, overallType);

    ctx.emitter.emitIf(overallValType);
    ctx.enterBlockStructure();
    hasEnteredOptionalIf = true;

    genCallee = (): void => {
      ctx.emitter.emitLocalGet(calleeLocal);
    };

    ctx.emitter.emitI32Const(0);
    ctx.emitter.emitLocalSet(ctx.getOptShortCircuitedLocal());
    generateNonNullCall(customGenExpr);

    ctx.emitter.emitElse();

    ctx.emitter.emitI32Const(1);
    ctx.emitter.emitLocalSet(ctx.getOptShortCircuitedLocal());

    match (overallValType) {
      case ValTypeVoid: {}
      case ValTypeI32: ctx.emitter.emitI32Const(0)
      case ValTypeI64: ctx.emitter.emitI64Const(0 as i64)
      case ValTypeF32: ctx.emitter.emitF32Const(0.0)
      case ValTypeF64: ctx.emitter.emitF64Const(0.0)
      case ValTypeRefNull as rn: ctx.emitter.emitRefNull(rn.target.index)
      case ValTypeRef as r: ctx.emitter.emitRefNull(r.target.index)
      case ValTypeEqRef: ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.eq))
      case ValTypeAnyRef: ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.any))
      case ValTypeStructRef: ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.struct))
      case _: ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.none))
    }

    ctx.exitBlockStructure();
    ctx.emitter.emitEnd();
  } else {
    generateNonNullCall(genExpr);
  }
};

let matchTypes = (t1: Type, t2: Type): boolean => {
  if (t1 is TypeParameterType) {
    return true;
  }
  match (t1) {
    case ArrayType {elementType}: {
      if (t2 is ArrayType) {
        return matchTypes(elementType, (t2 as ArrayType).elementType);
      }
      return false;
    }
    case ClassType as ct1: {
      if (t2 is ClassType) {
        let ct2 = t2 as ClassType;
        if (ct1.name != ct2.name) { return false; }
        if (ct1.typeArguments != null && ct2.typeArguments != null) {
          let args1 = ct1.typeArguments as Array<Type>;
          let args2 = ct2.typeArguments as Array<Type>;
          if (args1.length != args2.length) { return false; }
          var i = 0;
          while (i < args1.length) {
            if (!matchTypes(args1[i], args2[i])) { return false; }
            i += 1;
          }
        }
        return true;
      }
      return false;
    }
    case InterfaceType as it1: {
      if (t2 is InterfaceType) {
        let it2 = t2 as InterfaceType;
        if (it1.name != it2.name) { return false; }
        if (it1.typeArguments != null && it2.typeArguments != null) {
          let args1 = it1.typeArguments as Array<Type>;
          let args2 = it2.typeArguments as Array<Type>;
          if (args1.length != args2.length) { return false; }
          var i = 0;
          while (i < args1.length) {
            if (!matchTypes(args1[i], args2[i])) { return false; }
            i += 1;
          }
        }
        return true;
      }
      return false;
    }
    case _: {
      return typeToString(t1) == typeToString(t2);
    }
  }
};

let matchOverload = (t1: Type, t2: Type): boolean => {
  if (t1 is FunctionType && t2 is FunctionType) {
    let ft1 = t1 as FunctionType;
    let ft2 = t2 as FunctionType;
    if (ft1.parameters.length != ft2.parameters.length) {
      return false;
    }
    var i = 0;
    while (i < ft1.parameters.length) {
      if (!matchTypes(ft1.parameters[i], ft2.parameters[i])) {
        return false;
      }
      i += 1;
    }
    return true;
  }
  return matchTypes(t1, t2);
};

let findModuleNode = (model: SemanticModel, node: Node): Module | null => {
  var curr: Node | null = node;
  while (curr != null && !(curr is Module)) {
    curr = model.getParent(curr as Node);
  }
  if (curr == null) return null;
  return curr as Module;
};

let findDeclaration = (ctx: FunctionContext, sym: Symbol, expectedType: Type | null): DeclareFunction | null => {
  let decl = sym.declaration;
  if (decl == null) return null;
  
  if (decl is ImportSpecifier) {
    let spec = decl as ImportSpecifier;
    return resolveImportedSymbol(ctx, spec, expectedType);
  }
  
  if (decl is DeclareFunction) {
    let importedName = sym.name;
    let currentModule = findModuleNode(ctx.wasmFunction.model, ctx.wasmFunction.node);
    if (currentModule != null) {
      var fallback: DeclareFunction | null = null;
      for (let stmt in (currentModule as Module).body) {
        match (stmt) {
          case DeclareFunction as df: {
            if (df.name.name == importedName) {
              if (expectedType == null) {
                return df;
              }
              let stmtType = getNodeType(ctx, df);
              if (stmtType != null && matchOverload(stmtType, expectedType)) {
                return df;
              }
              fallback = df;
            }
          }
          case _: {}
        }
      }
      return fallback;
    }
  }
  return null;
};

let resolveImportedSymbol = (ctx: FunctionContext, spec: ImportSpecifier, expectedType: Type | null = null): DeclareFunction | null => {
  let parentNode = ctx.wasmFunction.model.getParent(spec);
  if (parentNode == null || !(parentNode is ImportDeclaration)) {
    return null;
  }
  let importDecl = parentNode as ImportDeclaration;
  let specifier = importDecl.moduleSpecifier.value;
  
  var canonicalPath = specifier;
  if (specifier.startsWith("./") || specifier.startsWith("../")) {
    let referrer = ctx.wasmFunction.model.getParent(importDecl);
    if (referrer != null && referrer is Module) {
      let mod = referrer as Module;
      let dir = dirName(mod.path);
      canonicalPath = normalizePath(dir + "/" + specifier);
    }
  }
  
  let prog = ctx.wasm.program;
  if (prog == null) {
    return null;
  }
  
  if (!prog.unitsByPath.has(canonicalPath)) {
    return null;
  }
  
  let targetUnit = prog.unitsByPath[canonicalPath];
  let importedName = spec.imported.name;
  
  var fallback: DeclareFunction | null = null;
  for (let stmt in targetUnit.ast.body) {
    match (stmt) {
      case DeclareFunction as df: {
        if (df.name.name == importedName) {
          if (expectedType == null) {
            return df;
          }
          let nodeType = targetUnit.model.getNodeType(df);
          if (nodeType != null && matchOverload(nodeType as Type, expectedType as Type)) {
            return df;
          }
          fallback = df;
        }
      }
      case _: {}
    }
  }
  return fallback;
};

let resolveImportedSymbolId = (ctx: FunctionContext, spec: ImportSpecifier, expectedType: Type | null = null): SymbolId => {
  let parentNode = ctx.wasmFunction.model.getParent(spec);
  if (parentNode == null || !(parentNode is ImportDeclaration)) {
    return -1 as SymbolId;
  }
  let importDecl = parentNode as ImportDeclaration;
  let specifier = importDecl.moduleSpecifier.value;
  
  var canonicalPath = specifier;
  if (specifier.startsWith("./") || specifier.startsWith("../")) {
    let referrer = ctx.wasmFunction.model.getParent(importDecl);
    if (referrer != null && referrer is Module) {
      let mod = referrer as Module;
      let dir = dirName(mod.path);
      canonicalPath = normalizePath(dir + "/" + specifier);
    }
  }
  
  let prog = ctx.wasm.program;
  if (prog == null) {
    return -1 as SymbolId;
  }
  
  if (!prog.unitsByPath.has(canonicalPath)) {
    return -1 as SymbolId;
  }
  
  let targetUnit = prog.unitsByPath[canonicalPath];
  let importedName = spec.imported.name;
  
  var fallback: Symbol | null = null;
  for (let stmt in targetUnit.ast.body) {
    match (stmt) {
      case DeclareFunction as df: {
        if (df.name.name == importedName) {
          let sym = targetUnit.model.resolveDeclaration(df);
          if (expectedType == null) {
            return (sym as Symbol).id;
          }
          let nodeType = targetUnit.model.getNodeType(df);
          if (nodeType != null && matchOverload(nodeType as Type, expectedType as Type)) {
            return (sym as Symbol).id;
          }
          fallback = sym;
        }
      }
      case VariableDeclaration as vd: {
        match (vd.pattern) {
          case IdentifierPattern {name} as pat: {
            if (name == importedName) {
              let sym = targetUnit.model.resolve(pat);
              if (sym != null) {
                if (expectedType == null) {
                  return (sym as Symbol).id;
                }
                let nodeType = targetUnit.model.getNodeType(pat);
                if (nodeType != null && matchOverload(nodeType as Type, expectedType as Type)) {
                  return (sym as Symbol).id;
                }
                fallback = sym;
              }
            }
          }
          case _: {}
        }
      }
      case _: {}
    }
  }
  if (fallback != null) {
    return (fallback as Symbol).id;
  }
  return -1 as SymbolId;
};
