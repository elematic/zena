import { Node, CallExpression, Identifier, Expression, ImportSpecifier, MemberExpression, SuperExpression, ClassDeclaration, ImportDeclaration, Module, IdentifierPattern, DeclareFunction, VariableDeclaration, InterfaceDeclaration, EnumDeclaration, MixinDeclaration, TypeAliasDeclaration, SymbolDeclaration, getMemberPropertyName, NewExpression } from '../../ast.zena';
import { Type, FunctionType, ClassType, InterfaceType, VoidType, ArrayType, UnionType, TypeParameterType, typeToString, isVoidOrNeverType, instantiateClassType, isRefType, baseType } from '../../types.zena';
import { SymbolId, Symbol } from '../../scope/symbol.zena';
import { SemanticModel } from '../../semantic-model.zena';
import { FunctionContext } from '../function-context.zena';
import { WasmType, ValTypeRef, ValTypeRefNull, ValTypeStructRef, ValType, ValTypeEqRef, ValTypeVoid, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeAnyRef, HeapType, heapTypeToSigned, ValTypeI8, ValTypeI16, valTypeToOpcode, valTypeEquals } from '../wasm.zena';
import { WasmFunction, WasmStruct, WasmSignature, ClassCodegenInfo } from '../wasm-module.zena';
import { getClassKey, getInterfaceKey, getSignatureKey, ClassKey, InterfaceKey, ExportKey, getTypeKeyForSpecialization, ClassMethodKey, getClassMethodKey, SpecializedFunctionKey, getSpecializedFunctionKey, getSpecializedName, getTypeUniqueKey } from '../codegen-utils.zena';
import { typeToValType, typeToValTypeWithSub, getInterfaceMemberSignature, getClassMemberSignature, getClosureStruct, mapReturnTypeToWasmResults, getNodeType, getNonNullableType, substituteTypeParamsInFunctionContext, eraseTypeParameters, getExpressionType } from '../type-mapping.zena';
import { Error } from 'zena:error';
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { generateGlobalIntrinsic, generateArrayIntrinsic, isArrayIntrinsic } from './intrinsics.zena';
import { dirName, normalizePath } from '../../module-resolver.zena';
import { i32ToString } from 'zena:string-convert';
import { console } from 'zena:console';

export let castValTypeRefNullIfNeeded = (ctx: FunctionContext, initWasmType: ValType, targetWasmType: ValType): void => {
  let isTargetRef = match (targetWasmType) {
    case ValTypeRef: true
    case ValTypeRefNull: true
    case ValTypeStructRef: true
    case _: false
  };
  if (isTargetRef && !valTypeEquals(initWasmType, targetWasmType)) {
    match (targetWasmType) {
      case ValTypeRefNull as trn: {
        let targetIdx = trn.target.index;
        if (targetIdx != -1) {
          ctx.emitter.emitRefCastNull(targetIdx);
        }
      }
      case ValTypeRef as tr: {
        let targetIdx = tr.target.index;
        if (targetIdx != -1) {
          ctx.emitter.emitRefCast(targetIdx);
        }
      }
      case ValTypeStructRef: {
        ctx.emitter.emitRefCastNull(heapTypeToSigned(HeapType.struct));
      }
      case _: {}
    }
  }
};

export let castRefNullIfNeeded = (ctx: FunctionContext, argType: Type, targetType: Type): void => {
  let initWasmType = typeToValTypeWithSub(ctx.wasm, argType, ctx.wasmFunction);
  let targetWasmType = typeToValTypeWithSub(ctx.wasm, targetType, ctx.wasmFunction);
  castValTypeRefNullIfNeeded(ctx, initWasmType, targetWasmType);
};

let generateCallArguments = (
  ctx: FunctionContext,
  call: CallExpression,
  ft: FunctionType | null,
  thisLocalIndex: i32,
  genExpr: (e: Expression, discardValue: boolean) => void
): void => {
  let model = ctx.wasmFunction.model;
  let originalArgCount = model.getOriginalArgCount(call);
  let defaultArgsOwner = model.getDefaultArgsOwner(call);

  let actualArgCount = call.args.length;
  let hasDefaults = originalArgCount != -1 && originalArgCount < actualArgCount;

  // Save original parameter local mappings that we overwrite
  // so we can restore them after the call.
  let savedLocalIndices = new HashMap<SymbolId, i32>();

  var i = 0;
  while (i < actualArgCount) {
    let arg = call.args[i];
    let isDefault = hasDefaults && i >= originalArgCount;

    let symId = if (ft != null && (ft as FunctionType).parameterSymbols != null && i < ((ft as FunctionType).parameterSymbols as Array<SymbolId>).length) {
      ((ft as FunctionType).parameterSymbols as Array<SymbolId>)[i]
    } else {
      -1 as SymbolId
    };

    let expectedParamType = if (ft != null && i < (ft as FunctionType).parameters.length) (ft as FunctionType).parameters[i] else null;

    if (isDefault) {
      let savedClass = ctx.wasmFunction.classType;
      let savedThisLocalIndex = ctx.thisLocalIndex;
      if (defaultArgsOwner != null) {
        ctx.wasmFunction.classType = defaultArgsOwner as ClassType;
        ctx.thisLocalIndex = thisLocalIndex;
      }
      
      genExpr(arg, false);

      ctx.wasmFunction.classType = savedClass;
      ctx.thisLocalIndex = savedThisLocalIndex;
    } else {
      genExpr(arg, false);
    }

    if (expectedParamType != null) {
      let argType = getExpressionType(ctx, arg);
      if (argType != null) {
        castRefNullIfNeeded(ctx, argType as Type, expectedParamType as Type);
      }
    }

    // Save parameter value for subsequent default arguments if needed
    if (symId != (-1 as SymbolId)) {
      let argTypeOpt = getExpressionType(ctx, arg);
      let expectedType = if (expectedParamType != null) (expectedParamType as Type) else (if (argTypeOpt == null) throw new Error("Missing parameter type for default arg save") else argTypeOpt as Type);
      let tempLocal = ctx.allocLocal(typeToValTypeWithSub(ctx.wasm, expectedType, ctx.wasmFunction));
      if (ctx.localIndices.has(symId)) {
        savedLocalIndices[symId] = ctx.localIndices[symId];
      }
      ctx.localIndices[symId] = tempLocal;
      ctx.emitter.emitLocalTee(tempLocal);
    }

    i += 1;
  }

  // Restore any overwritten local indices
  let keys = savedLocalIndices.keys();
  for (let key in keys) {
    ctx.localIndices[key] = savedLocalIndices[key];
  }
};

let generateClosureCall = (
  ctx: FunctionContext,
  call: CallExpression,
  ftVal: FunctionType,
  genExpr: (e: Expression, discardValue: boolean) => void
): void => {
  let closureStruct = getClosureStruct(ctx.wasm, ftVal);
  
  genExpr(call.callee, false);
  let closureLocal = ctx.allocLocal(new ValTypeRefNull(closureStruct));
  ctx.emitter.emitLocalSet(closureLocal);
  
  // 2. Push context pointer onto stack (param 0)
  ctx.emitter.emitLocalGet(closureLocal);
  ctx.emitter.emitStructGet(closureStruct.index, 1);
  
  // 3. Push arguments (params 1..N)
  generateCallArguments(ctx, call, ftVal, -1, genExpr);
  
  // 4. Push function reference onto stack
  ctx.emitter.emitLocalGet(closureLocal);
  ctx.emitter.emitStructGet(closureStruct.index, 0);
  
  // 5. Get implementation signature and call_ref
  let params = new Array<ValType>();
  params.push(new ValTypeStructRef()); // ctx
  for (let p in ftVal.parameters) {
    params.push(typeToValType(ctx.wasm, p));
  }
  let returns = new Array<ValType>();
  if (!isVoidOrNeverType(ftVal.returnType)) {
    returns.push(typeToValType(ctx.wasm, ftVal.returnType));
  }
  let implSig = ctx.wasm.getSignature(params, returns);
  
  ctx.emitter.emitCallRef(implSig.index);
};


export let generateCallExpression = (ctx: FunctionContext, call: CallExpression, genExpr: (e: Expression, discardValue: boolean) => void): void => {

  var genCallee = (): void => {
    genExpr(call.callee, false);
  };

  let customGenExpr = (e: Expression, discardValue: boolean): void => {
    if (e == call.callee) {
      genCallee();
    } else {
      genExpr(e, discardValue);
    }
  };

  var hasEnteredOptionalIf = false;

  let generateNonNullCall = (origGenExpr: (e: Expression, discardValue: boolean) => void): void => {
    var isDirectCall = false;
    var ft: FunctionType | null = null;
    let currentGenExpr = (e: Expression, discardValue: boolean): void => {
      origGenExpr(e, discardValue);
    };
    let unionCalleeType = ctx.wasmFunction.model.getUnionCallCalleeType(call.callee);
    if (unionCalleeType != null) {
      let ut = unionCalleeType as UnionType;
      currentGenExpr(call.callee, false);
      let calleeLocal = ctx.allocLocal(new ValTypeEqRef());
      ctx.emitter.emitLocalSet(calleeLocal);
      
      let argLocals = new Array<i32>();
      for (let arg in call.args) {
        currentGenExpr(arg, false);
        let argType = getNodeType(ctx, arg);
        if (argType == null) throw new Error("Missing union callee argument type info");
        let argLocal = ctx.allocLocal(typeToValType(ctx.wasm, argType));
        ctx.emitter.emitLocalSet(argLocal);
        argLocals.push(argLocal);
      }
      
      let callType = getNodeType(ctx, call);
      if (callType == null) throw new Error("Missing union call return type info");
      var resultLocal = -1;
      if (callType != null && !isVoidOrNeverType(callType as Type)) {
        resultLocal = ctx.allocLocal(typeToValType(ctx.wasm, callType as Type));
      }
      
      ctx.emitter.emitBlock(new ValTypeVoid());
      
      for (let member in ut.types) {
        if (member is FunctionType) {
          let ftVal = member as FunctionType;
          let closureStruct = getClosureStruct(ctx.wasm, ftVal);
          
          ctx.emitter.emitLocalGet(calleeLocal);
          ctx.emitter.emitRefTest(closureStruct.index);
          ctx.emitter.emitIf(new ValTypeVoid());
          
          ctx.emitter.emitLocalGet(calleeLocal);
          ctx.emitter.emitRefCast(closureStruct.index);
          ctx.emitter.emitStructGet(closureStruct.index, 1);
          
          let sigParams = new Array<ValType>();
          sigParams.push(new ValTypeStructRef());
          for (let p in ftVal.parameters) {
            sigParams.push(typeToValType(ctx.wasm, p));
          }
          let arity = sigParams.length - 1;
          var argIdx = 0;
          while (argIdx < arity) {
            ctx.emitter.emitLocalGet(argLocals[argIdx]);
            argIdx += 1;
          }
          
          ctx.emitter.emitLocalGet(calleeLocal);
          ctx.emitter.emitRefCast(closureStruct.index);
          ctx.emitter.emitStructGet(closureStruct.index, 0);
          
          let returns = new Array<ValType>();
          if (!isVoidOrNeverType(ftVal.returnType)) {
            returns.push(typeToValType(ctx.wasm, ftVal.returnType));
          }
          let implSig = ctx.wasm.getSignature(sigParams, returns);
          ctx.emitter.emitCallRef(implSig.index);
          
          if (resultLocal != -1) {
            ctx.emitter.emitLocalSet(resultLocal);
          }
          
          ctx.emitter.emitBr(1);
          ctx.emitter.emitEnd();
        }
      }
      
      ctx.emitter.emitUnreachable();
      ctx.emitter.emitEnd();
      
      if (resultLocal != -1) {
        ctx.emitter.emitLocalGet(resultLocal);
      }
      return;
    }

    let calleeType = getNonNullableType(getNodeType(ctx, call.callee) as Type);
    // console.log("CALL CALLEE: " + (if (call.callee is Identifier) (call.callee as Identifier).name else "other") + " type=" + typeToString(calleeType));
    ft = null;
    if (calleeType is FunctionType) {
      ft = calleeType as FunctionType;
    }

    isDirectCall = false;
    var resolvedArgs = new Array<Type>();
    if (ft != null && ft.typeArguments != null) {
      for (let arg in (ft.typeArguments as Array<Type>)) {
        resolvedArgs.push(substituteTypeParamsInFunctionContext(ctx.wasmFunction, arg));
      }
    }
    let isSpecialized = resolvedArgs.length > 0;
    if (isSpecialized) {
      isDirectCall = true;
    } else {
      match (call.callee) {
        case Identifier: {
          let ident = call.callee as Identifier;
          if (isArrayIntrinsic(ident.name)) {
            isDirectCall = true;
          } else {
            let sym = ctx.wasmFunction.model.resolve(ident);
            if (sym != null) {
              let targetDecl = findDeclaration(ctx, sym as Symbol, ft);
              if (ctx.wasm.functionMap.has((sym as Symbol).id) || 
                  (targetDecl != null && ctx.wasm.intrinsics.has((targetDecl as DeclareFunction).id)) || 
                  (sym as Symbol).declaration is ImportSpecifier) {
                isDirectCall = true;
              }
            }
          }
        }
        case MemberExpression: {
          isDirectCall = true;
        }
        case SuperExpression: {
          isDirectCall = true;
        }
        case _: {}
      }
    }

    if (!isDirectCall && ft != null) {
      let fType = substituteTypeParamsInFunctionContext(ctx.wasmFunction, ft as Type) as FunctionType;
      let paramValTypes = new Array<ValType>();
      paramValTypes.push(new ValTypeStructRef()); // context
      for (let p in fType.parameters) {
        paramValTypes.push(typeToValType(ctx.wasm, p));
      }
      let returnValTypes = new Array<ValType>();
      if (!isVoidOrNeverType(fType.returnType)) {
        returnValTypes.push(typeToValType(ctx.wasm, fType.returnType));
      }
      
      let sig = ctx.wasm.getSignature(paramValTypes, returnValTypes);
      
      let closureStruct = getClosureStruct(ctx.wasm, fType);
      currentGenExpr(call.callee, false);
      let closureLocal = ctx.allocLocal(new ValTypeRefNull(closureStruct));
      ctx.emitter.emitLocalSet(closureLocal);
      
      ctx.emitter.emitLocalGet(closureLocal);
      ctx.emitter.emitStructGet(closureStruct.index, 1);
      
      generateCallArguments(ctx, call, fType, -1, currentGenExpr);
      
      ctx.emitter.emitLocalGet(closureLocal);
      ctx.emitter.emitStructGet(closureStruct.index, 0);
      
      ctx.emitter.emitCallRef(sig.index);
      return;
    }


    match (call.callee) {
      case Identifier: {
        let ident = call.callee as Identifier;
        let sym = ctx.wasmFunction.model.resolve(ident);
        if (sym != null) {
          let symVal = sym as Symbol;
          let decl = findDeclaration(ctx, symVal, ft);

          if (decl != null && ctx.wasm.intrinsics.has((decl as DeclareFunction).id)) {
            let intrinsicName = ctx.wasm.intrinsics[(decl as DeclareFunction).id];
            generateGlobalIntrinsic(ctx, intrinsicName, call, currentGenExpr);
            return;
          }
          
          if (decl == null && isArrayIntrinsic(ident.name)) {
            generateArrayIntrinsic(ctx, ident.name, call, currentGenExpr);
            return;
          }
          
          let resolved = symVal.resolveTarget();
          var resolvedArgsCall = new Array<Type>();
          if (ft != null && (ft as FunctionType).typeArguments != null) {
            for (let arg in ((ft as FunctionType).typeArguments as Array<Type>)) {
              resolvedArgsCall.push(substituteTypeParamsInFunctionContext(ctx.wasmFunction, arg));
            }
          }
          let isSpecialized = resolvedArgsCall.length > 0;
          if (isSpecialized) {
            let specKey = getSpecializedFunctionKey(resolved.name, resolvedArgsCall);
            if (ctx.wasm.specializedFunctions.has(specKey)) {
              let f = ctx.wasm.specializedFunctions[specKey];
              generateCallArguments(ctx, call, ft, -1, currentGenExpr);
              ctx.emitter.emitCall(f);
              return;
            }
          }
          
          if (ctx.wasm.functionMap.has(resolved.id)) {
            let f = ctx.wasm.functionMap[resolved.id];
            generateCallArguments(ctx, call, ft, -1, currentGenExpr);
            ctx.emitter.emitCall(f);
            return;
          } else if (ft != null) {
            generateClosureCall(ctx, call, ft as FunctionType, currentGenExpr);
            return;
          }
        } else {
          if (isArrayIntrinsic(ident.name)) {
            generateArrayIntrinsic(ctx, ident.name, call, currentGenExpr);
            return;
          }
          if (ft != null) {
            generateClosureCall(ctx, call, ft as FunctionType, currentGenExpr);
            return;
          }
          throw new Error("Unresolved identifier in codegen: " + ident.name);
        }
      }
      case MemberExpression: {
        let member = call.callee as MemberExpression;
        let rawObjType = getNonNullableType(getNodeType(ctx, member.object) as Type);
        let objType = eraseTypeParameters(rawObjType);
        let targetName = getMemberPropertyName(member.isSymbolAccess, member.property.name);
        
        if (objType is ClassType && ft != null && ft.typeArguments != null && (ft.typeArguments as Array<Type>).length > 0) {
          let ct = objType as ClassType;
          var resolvedArgsMember = new Array<Type>();
          for (let arg in ((ft as FunctionType).typeArguments as Array<Type>)) {
            resolvedArgsMember.push(substituteTypeParamsInFunctionContext(ctx.wasmFunction, arg));
          }
          let specKey = getSpecializedFunctionKey((getClassKey(ct) as String) + "." + targetName, resolvedArgsMember);
          if (ctx.wasm.specializedFunctions.has(specKey)) {
            let f = ctx.wasm.specializedFunctions[specKey];
            if (!f.isStatic) {
              currentGenExpr(member.object, false);
            }
            generateCallArguments(ctx, call, ft, -1, currentGenExpr);
            ctx.emitter.emitCall(f);
            return;
          }
        }
        
        if (member.object is SuperExpression) {
          if (ctx.wasmFunction.classType == null) {
            throw new Error("Super call outside of class");
          }
          let currentClass = ctx.wasmFunction.classType as ClassType;
          if (currentClass.superType == null) {
            throw new Error("Super call in class without superType: " + currentClass.name);
          }
          let superType = currentClass.superType as ClassType;
          var lookupName = targetName;
          if (superType.members.has(targetName)) {
            let mInfo = superType.members[targetName];
            if (mInfo.type is FunctionType) {
              let baseFt = mInfo.type as FunctionType;
              if (baseFt.overloads != null && ft != null) {
                lookupName = targetName + getSignatureKey(ft as FunctionType);
              }
            }
          }
          
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = superType;
          while (currClass != null && foundFunc == null) {
            let key = getClassMethodKey(getClassKey(currClass as ClassType), lookupName);
            if (ctx.wasm.classMethodMap.has(key)) {
              let f = ctx.wasm.classMethodMap[key];
              if (!f.isStatic) {
                foundFunc = f;
              }
            }
            currClass = (currClass as ClassType).superType;
          }
          
          if (foundFunc == null) {
            throw new Error("Could not find super method for call: " + targetName);
          }
          
          ctx.emitter.emitLocalGet(0);
          generateCallArguments(ctx, call, ft, if (ctx.thisLocalIndex >= 0) ctx.thisLocalIndex else 0, currentGenExpr);
          
          ctx.emitter.emitCall(foundFunc as WasmFunction);
          return;
        }
        
        var lookupName = targetName;
        var methodTypeArgs: Array<Type> | null = null;
        if (objType is ClassType) {
          let ct = objType as ClassType;
          if (ct.members.has(targetName)) {
            let mInfo = ct.members[targetName];
            if (mInfo.type is FunctionType) {
              let baseFt = mInfo.type as FunctionType;
              if (baseFt.typeParameters != null && (baseFt.typeParameters as Array<TypeParameterType>).length > 0) {
                if (ft != null && (ft as FunctionType).typeArguments != null) {
                  methodTypeArgs = (ft as FunctionType).typeArguments as Array<Type>;
                  let resolvedArgsCall = new Array<Type>();
                  for (let arg in methodTypeArgs as Array<Type>) {
                    resolvedArgsCall.push(substituteTypeParamsInFunctionContext(ctx.wasmFunction, arg));
                  }
                   lookupName = getSpecializedName(targetName, resolvedArgsCall);
                }
              } else if (baseFt.overloads != null && ft != null) {
                lookupName = targetName + getSignatureKey(ft as FunctionType);
              }
            }
          }
        }

        if (objType is ClassType && ctx.wasmFunction.model.isStaticAccess(member)) {
          let ct = objType as ClassType;
          
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = ct;
          while (currClass != null && foundFunc == null) {
            let key = getClassMethodKey(getClassKey(currClass as ClassType), lookupName);
            if (ctx.wasm.classMethodMap.has(key)) {
              let f = ctx.wasm.classMethodMap[key];
              if (f.isStatic) {
                foundFunc = f;
              }
            }
            currClass = (currClass as ClassType).superType;
          }

          if (foundFunc != null) {
            generateCallArguments(ctx, call, ft, -1, currentGenExpr);
            ctx.emitter.emitCall(foundFunc as WasmFunction);
            return;
          }
          var debugInfo = "";
          let keys = ctx.wasm.classMethodMap.keys();
          while (let (true, k) = keys.next()) {
             debugInfo = debugInfo + ", mapKey=" + ((k.classKey as String) + "." + k.methodName);
          }
          throw new Error("Could not find static method: " + lookupName + " on class: " + ct.name + ", classKey=" + (getClassKey(ct) as String) + debugInfo);
        }

        if (objType is ClassType) {
          let ct = objType as ClassType;
          
          if (ct.isExtension) {
            var foundFunc: WasmFunction | null = null;
            var currClass: ClassType | null = ct;
            while (currClass != null && foundFunc == null) {
              let key = getClassMethodKey(getClassKey(currClass as ClassType), lookupName);
              if (ctx.wasm.classMethodMap.has(key)) {
                foundFunc = ctx.wasm.classMethodMap[key];
              }
              currClass = (currClass as ClassType).superType;
            }

            if (foundFunc == null) {
              throw new Error("Could not find extension function for method call: " + targetName);
            }

            currentGenExpr(member.object, false);
            
            let f = foundFunc as WasmFunction;
            generateCallArguments(ctx, call, ft, -1, currentGenExpr);

            ctx.emitter.emitCall(foundFunc as WasmFunction);
            return;
          }

          var receiverCt = ct;
          var isConcrete = false;
          if (member.object is NewExpression) {
            receiverCt = ct;
            isConcrete = true;
          } else if (member.object is Identifier) {
            let identObj = member.object as Identifier;
            let sym = ctx.wasmFunction.model.resolve(identObj);
            if (sym != null && ctx.localConcreteClassTypes.has((sym as Symbol).id)) {
              receiverCt = ctx.localConcreteClassTypes[(sym as Symbol).id];
              isConcrete = true;
            }
          }

          var intrinsicFunc: WasmFunction | null = null;
          var currClassForIntr: ClassType | null = receiverCt;
          while (currClassForIntr != null && intrinsicFunc == null) {
            let key = getClassMethodKey(getClassKey(currClassForIntr as ClassType), lookupName);
            if (ctx.wasm.classMethodMap.has(key)) {
              let f = ctx.wasm.classMethodMap[key];
              if (f.intrinsic != null) {
                intrinsicFunc = f;
              }
            }
            currClassForIntr = (currClassForIntr as ClassType).superType;
          }

          if (intrinsicFunc != null) {
            let intrName = (intrinsicFunc as WasmFunction).intrinsic as String;
            if (isArrayIntrinsic(intrName)) {
              generateArrayIntrinsic(ctx, intrName, call, currentGenExpr);
            } else {
              generateGlobalIntrinsic(ctx, intrName, call, currentGenExpr);
            }
            return;
          }

          let ctKey = getClassKey(ct);
          var structInfoOpt: WasmStruct | null = null;
          var vtableStructOpt: WasmStruct | null = null;
          if (let (true, info) = ctx.wasm.classInfos.get(ctKey)) {
            structInfoOpt = info.structType;
            vtableStructOpt = info.vtableStructType;
          }
          if (structInfoOpt == null) {
            throw new Error("Class struct not found for: " + ct.name + " key: " + (ctKey as String));
          }
          if (vtableStructOpt == null) {
            throw new Error("Class VTable struct not found for: " + ct.name + " key: " + (ctKey as String));
          }
          let structInfo = structInfoOpt as WasmStruct;
          let vtableStruct = vtableStructOpt as WasmStruct;
          
          var methodIndex = -1;
          for (var i = 0; i < vtableStruct.fields.length; i += 1) {
            if (vtableStruct.fields[i].name != null && (vtableStruct.fields[i].name as String) == lookupName) {
              methodIndex = i;
            }
          }
          
          if (methodIndex == -1) {
            if (methodTypeArgs != null) {
              var foundFunc: WasmFunction | null = null;
              var currClass: ClassType | null = receiverCt;
              while (currClass != null && foundFunc == null) {
                let key = getClassMethodKey(getClassKey(currClass as ClassType), lookupName);
                if (ctx.wasm.classMethodMap.has(key)) {
                  foundFunc = ctx.wasm.classMethodMap[key];
                }
                currClass = (currClass as ClassType).superType;
              }
              if (foundFunc != null) {
                currentGenExpr(member.object, false);
                generateCallArguments(ctx, call, ft, -1, currentGenExpr);
                ctx.emitter.emitCall(foundFunc as WasmFunction);
                return;
              }
            }
            if (ft != null) {
              generateClosureCall(ctx, call, ft as FunctionType, currentGenExpr);
              return;
            }
            throw new Error("Method not found in vtable: " + targetName);
          }
          
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = receiverCt;
          while (currClass != null && foundFunc == null) {
            let key = getClassMethodKey(getClassKey(currClass as ClassType), lookupName);
            if (ctx.wasm.classMethodMap.has(key)) {
              foundFunc = ctx.wasm.classMethodMap[key];
            }
            currClass = (currClass as ClassType).superType;
          }

          let receiverCtKey = getClassKey(receiverCt);
          var receiverInfo: ClassCodegenInfo | null = null;
          if (let (true, info) = ctx.wasm.classInfos.get(receiverCtKey)) {
            receiverInfo = info;
          }

          var canDevirtualize = false;
          if (foundFunc != null && receiverInfo != null) {
            let f = foundFunc as WasmFunction;
            if (f.node != null) {
              let nodeType = getNodeType(ctx, f.node as Node);
              var isMethodFinal = false;
              if (nodeType is FunctionType) {
                isMethodFinal = (nodeType as FunctionType).isFinal;
              }

              if (isMethodFinal || receiverCt.isFinal || isConcrete) {
                canDevirtualize = true;
              } else {
                let subclasses = new Array<ClassCodegenInfo>();
                (receiverInfo as ClassCodegenInfo).getTransitiveSubclasses(subclasses);
                var hasOverride = false;
                for (let sub in subclasses) {
                  var subFunc: WasmFunction | null = null;
                  var subCurr: ClassType | null = sub.structType.classType;
                  while (subCurr != null && subFunc == null) {
                    let key = getClassMethodKey(getClassKey(subCurr as ClassType), lookupName);
                    if (ctx.wasm.classMethodMap.has(key)) {
                      subFunc = ctx.wasm.classMethodMap[key];
                    }
                    subCurr = (subCurr as ClassType).superType;
                  }
                  
                  if (subFunc != null && (subFunc as WasmFunction).index != f.index) {
                    hasOverride = true;
                    break;
                  }
                }
                if (!hasOverride) {
                  canDevirtualize = true;
                }
              }
            }
          }

          let sig = if (foundFunc != null) (foundFunc as WasmFunction).signature else getClassMemberSignature(ctx.wasm, ct, targetName);
          let sigIndex = sig.index;

          currentGenExpr(member.object, false);
          var scratchLocal = ctx.getStructScratchLocal(structInfo);
          ctx.emitter.emitLocalTee(scratchLocal);
          
          generateCallArguments(ctx, call, ft, scratchLocal, currentGenExpr);
          
          if (canDevirtualize) {
            ctx.emitter.emitCall(foundFunc as WasmFunction);
          } else {
            ctx.emitter.emitLocalGet(scratchLocal);
            ctx.emitter.emitRefCast(structInfo.index);
            ctx.emitter.emitStructGet(structInfo.index, 0); 
            ctx.emitter.emitRefCast(vtableStruct.index);
            ctx.emitter.emitStructGet(vtableStruct.index, methodIndex); 

            ctx.emitter.emitRefCast(sigIndex);
            ctx.emitter.emitCallRef(sigIndex);
          }
          return;
        }
        
        if (objType is InterfaceType) {
          let it = objType as InterfaceType;
          let iName = getInterfaceKey(it);
          let vst = ctx.wasm.interfaceVTableStructs[iName];
          let fatPtr = ctx.wasm.interfaceStructs[iName];
          
          var methodIndex = -1;
          for (var i = 0; i < vst.fields.length; i += 1) {
            if (vst.fields[i].name != null && (vst.fields[i].name as String) == targetName) {
              methodIndex = i;
            }
          }
          
          if (methodIndex == -1) {
            if (ft != null) {
              generateClosureCall(ctx, call, ft as FunctionType, currentGenExpr);
              return;
            }
            throw new Error("Method not found in interface vtable: " + targetName);
          }
          
          let sig = getInterfaceMemberSignature(ctx.wasm, it, targetName);

          currentGenExpr(member.object, false);
          var scratchLocal = ctx.getStructScratchLocal(fatPtr);
          ctx.emitter.emitLocalTee(scratchLocal);
          ctx.emitter.emitRefCast(fatPtr.index);
          ctx.emitter.emitStructGet(fatPtr.index, 0); 
          
          generateCallArguments(ctx, call, ft, scratchLocal, currentGenExpr);
          
          ctx.emitter.emitLocalGet(scratchLocal);
          ctx.emitter.emitRefCast(fatPtr.index);
          ctx.emitter.emitStructGet(fatPtr.index, 1); 
          ctx.emitter.emitStructGet(vst.index, methodIndex); 
          
          ctx.emitter.emitCallRef(sig.index);
          return;
        }

        var isArray = false;
        var elemType: Type | null = null;
        match (objType) {
          case ArrayType as at: {
            isArray = true;
            elemType = at.elementType;
          }
          case ClassType as ct: {
            if (ct.name == "array" && ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0) {
              isArray = true;
              elemType = (ct.typeArguments as Array<Type>)[0];
            }
          }
          case _: {}
        }
        
        if (isArray) {
          var foundFunc: WasmFunction | null = null;
          for (let f in ctx.wasm.arrayMethods) {
            if (f.classType != null && f.methodName != null && (f.methodName as String) == targetName) {
              let fClass = f.classType as ClassType;
              let className = fClass.name;
              if (className == "FixedArray" || className == "ImmutableArray") {
                let isGenericElem = elemType is TypeParameterType;
                if (isGenericElem) {
                  if (fClass.typeArguments == null || (fClass.typeArguments as Array<Type>).length == 0) {
                    foundFunc = f;
                  }
                } else {
                  if (fClass.typeArguments != null && (fClass.typeArguments as Array<Type>).length > 0) {
                    let fTypeArg = (fClass.typeArguments as Array<Type>)[0];
                    if (getTypeKeyForSpecialization(elemType as Type) == getTypeKeyForSpecialization(fTypeArg)) {
                      foundFunc = f;
                    }
                  }
                }
              }
            }
          }
          
          if (foundFunc == null) {
             throw new Error("Could not find extension function for array method call: " + targetName + " for element type " + typeToString(elemType as Type) + " in function " + (ctx.wasmFunction.name as String));
          }

          let f = foundFunc as WasmFunction;
          currentGenExpr(member.object, false);
          generateCallArguments(ctx, call, ft, -1, currentGenExpr);

          ctx.emitter.emitCall(foundFunc as WasmFunction);
          return;
        }

        if (ft != null) {
          generateClosureCall(ctx, call, ft as FunctionType, currentGenExpr);
          return;
        }
        throw new Error("Unsupported method call on type: " + typeToString(objType));
      }
      case SuperExpression: {
        if (ctx.wasmFunction.classType == null) {
          throw new Error("Super call outside of class");
        }
        let currentClass = ctx.wasmFunction.classType as ClassType;
        if (currentClass.superType == null) {
          throw new Error("Super call in class without superType: " + currentClass.name);
        }
        let superType = currentClass.superType as ClassType;
        let member = call.callee as MemberExpression;
        let targetName = getMemberPropertyName(member.isSymbolAccess, member.property.name);
        var lookupName = targetName;
        if (superType.members.has(targetName)) {
          let mInfo = superType.members[targetName];
          if (mInfo.type is FunctionType) {
            let baseFt = mInfo.type as FunctionType;
            if (baseFt.overloads != null && ft != null) {
              lookupName = targetName + getSignatureKey(ft as FunctionType);
            }
          }
        }
        
        var foundFunc: WasmFunction | null = null;
        var currClass: ClassType | null = superType;
        while (currClass != null && foundFunc == null) {
          let key = getClassMethodKey(getClassKey(currClass as ClassType), lookupName);
          if (ctx.wasm.classMethodMap.has(key)) {
            let f = ctx.wasm.classMethodMap[key];
            if (f.isStatic) {
              foundFunc = f;
            }
          }
          currClass = (currClass as ClassType).superType;
        }

        if (foundFunc == null) {
          throw new Error("Could not find super method for call: " + targetName);
        }

        currentGenExpr(member.object, false);
        
        let f = foundFunc as WasmFunction;
        generateCallArguments(ctx, call, ft, if (ctx.thisLocalIndex >= 0) ctx.thisLocalIndex else 0, currentGenExpr);

        ctx.emitter.emitCall(foundFunc as WasmFunction);
        return;
      }
      case _: {
        if (ft != null) {
          generateClosureCall(ctx, call, ft as FunctionType, currentGenExpr);
          return;
        }
        throw new Error("Unsupported call expression");
      }        
    }
  };

  if (call.optional) {
    genExpr(call.callee, false);

    let calleeType = getNodeType(ctx, call.callee);
    if (calleeType == null) throw new Error("Missing callee type info in semantic model");
    let calleeValType = typeToValTypeWithSub(ctx.wasm, calleeType as Type, ctx.wasmFunction);
    let calleeLocal = ctx.allocLocal(calleeValType);
    ctx.emitter.emitLocalSet(calleeLocal);

    ctx.emitter.emitLocalGet(calleeLocal);
    ctx.emitter.emitRefIsNull();
    ctx.emitter.emitI32Eqz();

    let overallType = getNodeType(ctx, call);
    if (overallType == null) throw new Error("Missing call expression type info in semantic model");
    let overallValType = typeToValTypeWithSub(ctx.wasm, overallType as Type, ctx.wasmFunction);

    ctx.emitter.emitIf(overallValType);
    ctx.enterBlockStructure();
    hasEnteredOptionalIf = true;

    genCallee = (): void => {
      ctx.emitter.emitLocalGet(calleeLocal);
    };

    ctx.emitter.emitI32Const(0);
    ctx.emitter.emitLocalSet(ctx.getOptShortCircuitedLocal());
    generateNonNullCall(customGenExpr);

    ctx.emitter.emitElse();

    ctx.emitter.emitI32Const(1);
    ctx.emitter.emitLocalSet(ctx.getOptShortCircuitedLocal());

    match (overallValType) {
      case ValTypeVoid: {}
      case ValTypeI32: ctx.emitter.emitI32Const(0)
      case ValTypeI64: ctx.emitter.emitI64Const(0 as i64)
      case ValTypeF32: ctx.emitter.emitF32Const(0.0)
      case ValTypeF64: ctx.emitter.emitF64Const(0.0)
      case ValTypeRefNull as rn: ctx.emitter.emitRefNull(rn.target.index)
      case ValTypeRef as r: ctx.emitter.emitRefNull(r.target.index)
      case ValTypeEqRef: ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.eq))
      case ValTypeAnyRef: ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.any))
      case ValTypeStructRef: ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.struct))
      case _: ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.none))
    }

    ctx.exitBlockStructure();
    ctx.emitter.emitEnd();
  } else {
    generateNonNullCall(genExpr);
  }
};

let matchTypes = (t1: Type, t2: Type): boolean => {
  if (t1 is TypeParameterType) {
    return true;
  }
  match (t1) {
    case ArrayType {elementType}: {
      if (t2 is ArrayType) {
        return matchTypes(elementType, (t2 as ArrayType).elementType);
      }
      return false;
    }
    case ClassType as ct1: {
      if (t2 is ClassType) {
        let ct2 = t2 as ClassType;
        if (ct1.name != ct2.name) { return false; }
        if (ct1.typeArguments != null && ct2.typeArguments != null) {
          let args1 = ct1.typeArguments as Array<Type>;
          let args2 = ct2.typeArguments as Array<Type>;
          if (args1.length != args2.length) { return false; }
          var i = 0;
          while (i < args1.length) {
            if (!matchTypes(args1[i], args2[i])) { return false; }
            i += 1;
          }
        }
        return true;
      }
      return false;
    }
    case InterfaceType as it1: {
      if (t2 is InterfaceType) {
        let it2 = t2 as InterfaceType;
        if (it1.name != it2.name) { return false; }
        if (it1.typeArguments != null && it2.typeArguments != null) {
          let args1 = it1.typeArguments as Array<Type>;
          let args2 = it2.typeArguments as Array<Type>;
          if (args1.length != args2.length) { return false; }
          var i = 0;
          while (i < args1.length) {
            if (!matchTypes(args1[i], args2[i])) { return false; }
            i += 1;
          }
        }
        return true;
      }
      return false;
    }
    case _: {
      return getTypeUniqueKey(t1) == getTypeUniqueKey(t2);
    }
  }
};

let matchOverload = (t1: Type, t2: Type): boolean => {
  if (t1 is FunctionType && t2 is FunctionType) {
    let ft1 = t1 as FunctionType;
    let ft2 = t2 as FunctionType;
    if (ft1.parameters.length != ft2.parameters.length) {
      return false;
    }
    var i = 0;
    while (i < ft1.parameters.length) {
      if (!matchTypes(ft1.parameters[i], ft2.parameters[i])) {
        return false;
      }
      i += 1;
    }
    return true;
  }
  return matchTypes(t1, t2);
};

let findModuleNode = (model: SemanticModel, node: Node): Module | null => {
  var curr: Node | null = node;
  while (curr != null && !(curr is Module)) {
    curr = model.getParent(curr as Node);
  }
  if (curr == null) return null;
  return curr as Module;
};

let findDeclaration = (ctx: FunctionContext, sym: Symbol, expectedType: Type | null): DeclareFunction | null => {
  let resolved = sym.resolveTarget();
  let decl = resolved.declaration;
  if (decl == null) return null;

  let prog = ctx.wasm.program;
  if (prog != null && resolved.modulePath != "") {
    let canonicalPath = resolved.modulePath;
    if (prog.unitsByPath.has(canonicalPath)) {
      let targetUnit = prog.unitsByPath[canonicalPath];
      let importedName = resolved.name;
      
      let key = canonicalPath + "::" + importedName;
      if (let (true, list) = prog.exportedFunctions.get(key)) {
        var fallback: DeclareFunction | null = null;
        for (let df in list) {
          if (expectedType == null) {
            return df;
          }
          let nodeType = targetUnit.model.getNodeType(df);
          if (nodeType != null && matchOverload(nodeType as Type, expectedType as Type)) {
            return df;
          }
          fallback = df;
        }
        if (fallback != null) {
          return fallback;
        }
      }
    }
  }

  if (decl is DeclareFunction) {
    return decl as DeclareFunction;
  }
  return null;
};

let resolveImportedSymbol = (ctx: FunctionContext, spec: ImportSpecifier, expectedType: Type | null = null): DeclareFunction | null => {
  let sym = ctx.wasmFunction.model.resolve(spec as Node);
  if (sym != null) {
    let resolved = (sym as Symbol).resolveTarget();
    if (resolved.declaration != null && resolved.declaration is DeclareFunction) {
      return resolved.declaration as DeclareFunction;
    }
  }
  return null;
};

let resolveImportedSymbolId = (ctx: FunctionContext, spec: ImportSpecifier, expectedType: Type | null = null): SymbolId => {
  let sym = ctx.wasmFunction.model.resolve(spec as Node);
  if (sym != null) {
    return (sym as Symbol).resolveTarget().id;
  }
  return -1 as SymbolId;
};

let getSpecializedName = (baseName: String, typeArgs: Array<Type>): String => {
  var sb = baseName + "_spec";
  for (let arg in typeArgs) {
    sb = sb + "_" + getTypeKeyForSpecialization(arg);
  }
  return sb;
};
