import { FunctionContext } from '../function-context.zena';
import { RecordLiteral, TupleLiteral, PropertyAssignment, SpreadElement, ArrayLiteral, Expression, Node, Identifier } from '../../ast.zena';
import { RecordType, TupleType, InlineTupleType, ArrayType, F64Type, F32Type, Type, ClassType } from '../../types.zena';
import { ValType, ValTypeRefNull, ValTypeRef, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeStructRef, ValTypeEqRef, ValTypeAnyRef } from '../wasm.zena';
import { WasmField, WasmArray, sortWasmFields, WasmStruct, WasmGlobal } from '../wasm-module.zena';
import { typeToValType, getNonNullableType } from '../type-mapping.zena';
import { getClassKey } from '../codegen-utils.zena';
import { NodeMap } from '../../node-map.zena';
import { Array } from 'zena:array';
import { String } from 'zena:string';
import { HashMap } from 'zena:map';
import { i32ToString } from 'zena:string-convert';

let generateDefaultValue = (ctx: FunctionContext, type: ValType): void => {
  if (type is ValTypeI32) {
    ctx.emitter.emitI32Const(0);
  } else if (type is ValTypeI64) {
    ctx.emitter.emitI64Const(0 as i64);
  } else if (type is ValTypeF64) {
    ctx.emitter.emitF64Const(0.0);
  } else if (type is ValTypeF32) {
    ctx.emitter.emitF32Const(0.0);
  } else {
    match (type) {
      case ValTypeRefNull as refNullType: {
        ctx.emitter.emitRefNull(refNullType.target.index);
      }
      case ValTypeRef as refType: {
        ctx.emitter.emitRefNull(refType.target.index);
      }
      case ValTypeStructRef: {
        ctx.emitter.emitRefNull(-21);
      }
      case ValTypeEqRef: {
        ctx.emitter.emitRefNull(-19);
      }
      case ValTypeAnyRef: {
        ctx.emitter.emitRefNull(-18);
      }
      case _: {
        ctx.emitter.emitRefNull(-15);
      }
    }
  }
};

export let generateArrayLiteral = (
    ctx: FunctionContext,
    expr: ArrayLiteral,
    genExpr: (e: Expression, discardValue: boolean) => void): void => {
  let arrayType = ctx.wasmFunction.model.getNodeType(expr) as Type;
  let valType = typeToValType(ctx.wasm, arrayType);
  let wasmArrayType = match (valType) {
    case ValTypeRefNull as refNull: {
      refNull.target as WasmArray
    }
    case ValTypeRef as ref: {
      ref.target as WasmArray
    }
    case _: {
      throw new Error("Expected reference type for ArrayLiteral");
    }
  };
  
  for (let el in expr.elements) {
    genExpr(el, false);
  }
  
  ctx.emitter.emitArrayNewFixed(wasmArrayType.index, expr.elements.length);
};

export let generateTupleLiteral = (
    ctx: FunctionContext,
    expr: TupleLiteral,
    genExpr: (e: Expression, discardValue: boolean) => void): void => {
  let type = ctx.wasmFunction.model.getNodeType(expr);
  match (type) {
    case InlineTupleType as inlineTuple: {
      for (var i = 0; i < expr.elements.length; i += 1) {
        let el = expr.elements[i];
        if (el is Identifier && (el as Identifier).name == "_") {
          var valType: ValType = new ValTypeI32();
          if (i < ctx.wasmFunction.signature.returns.length) {
            valType = ctx.wasmFunction.signature.returns[i];
          }
          generateDefaultValue(ctx, valType);
        } else {
          genExpr(el, false);
        }
      }
    }
    case TupleType as tupleType: {
      let fields = new Array<WasmField>();
      for (var i = 0; i < tupleType.elementTypes.length; i += 1) {
        let type = tupleType.elementTypes[i];
        fields.push(new WasmField(i32ToString(i), typeToValType(ctx.wasm, type), false));
      }
      
      let structType = ctx.wasm.getStruct(null, fields);
      
      for (var i = 0; i < expr.elements.length; i += 1) {
        let el = expr.elements[i];
        if (el is Identifier && (el as Identifier).name == "_") {
          let valType = typeToValType(ctx.wasm, tupleType.elementTypes[i]);
          generateDefaultValue(ctx, valType);
        } else {
          genExpr(el, false);
        }
      }

      ctx.emitter.emitStructNew(structType.index);
    }
    case _: {
      throw new Error("Expected TupleType or InlineTupleType for TupleLiteral");
    }
  }
};

export let generateRecordLiteral = (
    ctx: FunctionContext,
    expr: RecordLiteral,
    genExpr: (e: Expression, discardValue: boolean) => void): void => {
  let recordType = ctx.wasmFunction.model.getNodeType(expr) as RecordType;
  
  let fields = new Array<WasmField>();
  for (let {key as name, value as type} in recordType.properties) {
     fields.push(new WasmField(name, typeToValType(ctx.wasm, type), false));
  }
  sortWasmFields(fields);
  
  // Dedup struct type.
  let dispatchInfo = ctx.wasm.getRecordDispatch(ctx.wasmFunction.model, fields);
  let structType = dispatchInfo.concreteType;
  
  // 1. Evaluate all SpreadElement sub-expressions and store their references in local variables.
  let spreadLocals = new NodeMap<i32>();
  for (let prop in expr.properties) {
    if (prop is SpreadElement) {
      let spread = prop as SpreadElement;
      genExpr(spread.argument, false);
      let spreadType = ctx.wasmFunction.model.getNodeType(spread.argument) as Type;
      let spreadValType = typeToValType(ctx.wasm, spreadType);
      let localIdx = ctx.allocLocal(spreadValType);
      ctx.emitter.emitLocalSet(localIdx);
      spreadLocals[spread] = localIdx;
    }
  }

  // 2. Generate values for each field in sorted order
  for (let field in fields) {
    let key = field.name as String;
    var found = false;
    var i = expr.properties.length - 1;
    while (i >= 0 && !found) {
      let prop = expr.properties[i];
      if (prop is PropertyAssignment) {
        let propAss = prop as PropertyAssignment;
        if (propAss.name.name == key) {
          genExpr(propAss.value, false);
          found = true;
        }
      } else if (prop is SpreadElement) {
        let spread = prop as SpreadElement;
        let spreadType = ctx.wasmFunction.model.getNodeType(spread.argument) as Type;
        let nonNullSpread = getNonNullableType(spreadType);
        match (nonNullSpread) {
          case RecordType as rt: {
            if (rt.properties.has(key)) {
              let localIndex = spreadLocals[spread];
              let fieldsArr = new Array<WasmField>();
              for (let {key as k, value as v} in rt.properties) {
                fieldsArr.push(new WasmField(k, typeToValType(ctx.wasm, v), false));
              }
              sortWasmFields(fieldsArr);
              let spreadDispatch = ctx.wasm.getRecordDispatch(ctx.wasmFunction.model, fieldsArr);
              
              var fieldIndex = -1;
              for (var fIdx = 0; fIdx < fieldsArr.length; fIdx += 1) {
                if (fieldsArr[fIdx].name != null && (fieldsArr[fIdx].name as String) == key) {
                  fieldIndex = fIdx;
                }
              }
              if (fieldIndex == -1) {
                throw new Error("Could not find spread record field index");
              }
              
              // Load the instance (field 0 of fat pointer)
              ctx.emitter.emitLocalGet(localIndex);
              ctx.emitter.emitStructGet(spreadDispatch.fatPtrType.index, 0);
              
              // Load the getter from vtable (field 1 of fat pointer, then fieldIndex of vtable)
              ctx.emitter.emitLocalGet(localIndex);
              ctx.emitter.emitStructGet(spreadDispatch.fatPtrType.index, 1);
              ctx.emitter.emitStructGet(spreadDispatch.vtableType.index, fieldIndex);
              
              // Call getter
              ctx.emitter.emitCallRef(spreadDispatch.getterTypes[fieldIndex].index);
              found = true;
            }
          }
          case ClassType as ctVar: {
            let ct = if (ctVar.name.length >= 5 && ctVar.name.sliceBytes(ctVar.name.length - 5, ctVar.name.length) == "_This") {
              ctx.wasmFunction.classType as ClassType
            } else {
              ctVar
            };
            if (ct.members.has(key) && !(key.length > 0 && key.sliceBytes(0, 1) == "#")) {
              let localIndex = spreadLocals[spread];
              let ctKey = getClassKey(ct);
              var structInfo: WasmStruct | null = null;
              if (let (true, info) = ctx.wasm.classInfos.get(ctKey)) {
                structInfo = info.structType;
              }
              if (structInfo == null) {
                throw new Error("Class struct not found: " + ct.name);
              }
              let structInfoVal = structInfo as WasmStruct;
              var fieldIndex = -1;
              for (var fIdx = 0; fIdx < structInfoVal.fields.length; fIdx += 1) {
                if (structInfoVal.fields[fIdx].name != null && (structInfoVal.fields[fIdx].name as String) == key) {
                  fieldIndex = fIdx;
                }
              }
              if (fieldIndex != -1) {
                ctx.emitter.emitLocalGet(localIndex);
                ctx.emitter.emitRefCast(structInfoVal.index);
                ctx.emitter.emitStructGet(structInfoVal.index, fieldIndex);
                found = true;
              }
            }
          }
          case _: {}
        }
      }
      i -= 1;
    }
    if (!found) {
      throw new Error("Missing value for field '" + key + "' in record literal");
    }
  }

  ctx.emitter.emitStructNew(structType.index);
  
  if (dispatchInfo.vtableGlobal.index < 0) {
     throw new Error("vtableGlobal.index < 0 in generateRecordLiteral! Key: " + dispatchInfo.vtableGlobal.name);
  }
  ctx.emitter.emitGlobalGet(dispatchInfo.vtableGlobal.index);
  ctx.emitter.emitStructNew(dispatchInfo.fatPtrType.index);
};