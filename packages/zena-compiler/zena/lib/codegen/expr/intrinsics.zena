import { FunctionContext } from '../function-context.zena';
import { CallExpression, Expression, Node } from '../../ast.zena';
import { String } from 'zena:string';
import { Error } from 'zena:error';
import { Opcode, ValType, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeAnyRef, ValTypeRefNull, ValTypeRef, ValTypeVoid, ValTypeEqRef } from '../wasm.zena';
import { WasmFunction, WasmStruct, WasmModule } from '../wasm-module.zena';
import { typeToValType, typeToValTypeWithSub, getNodeType, getClassMemberSignature } from '../type-mapping.zena';
import { Type, baseType, isRefType, isFloatType, isBooleanLike, I32Type, BooleanType, F32Type, F64Type, I64Type, U64Type, ClassType, InterfaceType, U32Type, StringLiteralType, MethodInfo, MemberInfo, instantiateClassType } from '../../types.zena';
import { getClassKey, unwrapAliases, ClassMethodKey, getClassMethodKey } from '../codegen-utils.zena';
import { Array } from 'zena:array';

let isWasmRefType = (wasm: WasmModule, t: Type): boolean => {
  let v = typeToValType(wasm, t);
  return !(v is ValTypeI32 || v is ValTypeI64 || v is ValTypeF32 || v is ValTypeF64 || v is ValTypeVoid);
};

let getArrayTypeWithFallback = (ctx: FunctionContext, node: Node): Type | null => {
  var t = getNodeType(ctx, node);
  if (t == null) {
    let parent = ctx.wasmFunction.model.getParent(node);
    if (parent != null) {
      t = getNodeType(ctx, parent as Node);
    }
  }
  return t;
};

export let generateGlobalIntrinsic = (
  ctx: FunctionContext,
  name: String,
  call: CallExpression,
  genExpr: (e: Expression, discardValue: boolean) => void
): void => {
  let args = call.args;
  
  if (name == 'memory.size') {
    ctx.emitter.emitMemorySize();
    return;
  }
  
  if (name == 'memory.grow') {
    genExpr(args[0], false);
    ctx.emitter.emitMemoryGrow();
    return;
  }
  
  if (name == 'wasi_write_string') {
    genExpr(args[0], false); // fd
    genExpr(args[1], false); // string
    let foundFunc = ctx.wasm.wasiWriteStringHelper;
    if (foundFunc == null) {
      throw new Error("wasi_write_string_helper not found in functions!");
    }
    ctx.emitter.emitCall(foundFunc as WasmFunction);
    return;
  }

  if (name == 'i32.load') {
    genExpr(args[0], false);
    ctx.emitter.emitI32Load(2, 0); // align=2 (4-byte alignment), offset=0
    return;
  }
  
  if (name == 'i32.store') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitI32Store(0, 0); // align=0, offset=0
    return;
  }
  
  if (name == 'i32.load8_u') {
    genExpr(args[0], false);
    ctx.emitter.emitI32Load8U(0, 0); // align=0, offset=0
    return;
  }

  if (name == 'i32.store8') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitI32Store8(0, 0); // align=0, offset=0
    return;
  }

  if (name == 'i64.load') {
    genExpr(args[0], false);
    ctx.emitter.emitI64Load(3, 0);
    return;
  }

  if (name == 'i64.store') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitI64Store(0, 0);
    return;
  }

  if (name == 'f32.load') {
    genExpr(args[0], false);
    ctx.emitter.emitF32Load(2, 0);
    return;
  }

  if (name == 'f32.store') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitF32Store(0, 0);
    return;
  }

  if (name == 'f64.load') {
    genExpr(args[0], false);
    ctx.emitter.emitF64Load(3, 0);
    return;
  }

  if (name == 'f64.store') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitF64Store(0, 0);
    return;
  }

  if (name == 'i32.clz') {
    genExpr(args[0], false);
    ctx.emitter.emitI32Clz();
    return;
  }
  
  if (name == 'i32.ctz') {
    genExpr(args[0], false);
    ctx.emitter.emitI32Ctz();
    return;
  }
  
  if (name == 'i32.popcnt') {
    genExpr(args[0], false);
    ctx.emitter.emitI32Popcnt();
    return;
  }

  if (name == 'i64.clz') {
    genExpr(args[0], false);
    ctx.emitter.emitI64Clz();
    return;
  }

  if (name == 'i64.ctz') {
    genExpr(args[0], false);
    ctx.emitter.emitI64Ctz();
    return;
  }

  if (name == 'i64.popcnt') {
    genExpr(args[0], false);
    ctx.emitter.emitI64Popcnt();
    return;
  }

  if (name == 'i64.div_s') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitI64DivS();
    return;
  }
  
  if (name == 'i64.div_u') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitI64DivU();
    return;
  }

  if (name == 'i32.div_s') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitI32DivS();
    return;
  }

  if (name == 'i32.div_u') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitI32DivU();
    return;
  }

  if (name == 'f32.abs') {
    genExpr(args[0], false);
    ctx.emitter.emitF32Abs();
    return;
  }

  if (name == 'f64.abs') {
    genExpr(args[0], false);
    ctx.emitter.emitF64Abs();
    return;
  }

  if (name == 'f32.neg') {
    genExpr(args[0], false);
    ctx.emitter.emitF32Neg();
    return;
  }

  if (name == 'f64.neg') {
    genExpr(args[0], false);
    ctx.emitter.emitF64Neg();
    return;
  }

  if (name == 'f32.ceil') {
    genExpr(args[0], false);
    ctx.emitter.emitF32Ceil();
    return;
  }

  if (name == 'f64.ceil') {
    genExpr(args[0], false);
    ctx.emitter.emitF64Ceil();
    return;
  }

  if (name == 'f32.floor') {
    genExpr(args[0], false);
    ctx.emitter.emitF32Floor();
    return;
  }

  if (name == 'f64.floor') {
    genExpr(args[0], false);
    ctx.emitter.emitF64Floor();
    return;
  }

  if (name == 'f32.trunc') {
    genExpr(args[0], false);
    ctx.emitter.emitF32Trunc();
    return;
  }

  if (name == 'f64.trunc') {
    genExpr(args[0], false);
    ctx.emitter.emitF64Trunc();
    return;
  }

  if (name == 'f32.sqrt') {
    genExpr(args[0], false);
    ctx.emitter.emitF32Sqrt();
    return;
  }

  if (name == 'f64.sqrt') {
    genExpr(args[0], false);
    ctx.emitter.emitF64Sqrt();
    return;
  }

  if (name == 'f32.min') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitF32Min();
    return;
  }

  if (name == 'f64.min') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitF64Min();
    return;
  }

  if (name == 'f32.max') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitF32Max();
    return;
  }

  if (name == 'f64.max') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitF64Max();
    return;
  }

  if (name == 'f32.copysign') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitF32Copysign();
    return;
  }

  if (name == 'f64.copysign') {
    genExpr(args[0], false);
    genExpr(args[1], false);
    ctx.emitter.emitF64Copysign();
    return;
  }

  if (name == 'f32.nearest') {
    genExpr(args[0], false);
    ctx.emitter.emitF32Nearest();
    return;
  }

  if (name == 'f64.nearest') {
    genExpr(args[0], false);
    ctx.emitter.emitF64Nearest();
    return;
  }

  if (name == 'i64.trunc_sat_f32_s') {
    genExpr(args[0], false);
    ctx.emitter.emitI64TruncSatF32S();
    return;
  }

  if (name == 'i64.trunc_sat_f32_u') {
    genExpr(args[0], false);
    ctx.emitter.emitI64TruncSatF32U();
    return;
  }

  if (name == 'i64.trunc_sat_f64_s') {
    genExpr(args[0], false);
    ctx.emitter.emitI64TruncSatF64S();
    return;
  }

  if (name == 'i64.trunc_sat_f64_u') {
    genExpr(args[0], false);
    ctx.emitter.emitI64TruncSatF64U();
    return;
  }

  if (name == 'i32.trunc_sat_f32_s') {
    genExpr(args[0], false);
    ctx.emitter.emitI32TruncSatF32S();
    return;
  }

  if (name == 'i32.trunc_sat_f32_u') {
    genExpr(args[0], false);
    ctx.emitter.emitI32TruncSatF32U();
    return;
  }

  if (name == 'i32.trunc_sat_f64_s') {
    genExpr(args[0], false);
    ctx.emitter.emitI32TruncSatF64S();
    return;
  }

  if (name == 'i32.trunc_sat_f64_u') {
    genExpr(args[0], false);
    ctx.emitter.emitI32TruncSatF64U();
    return;
  }

  if (name == 'i64.reinterpret_f64') {
    genExpr(args[0], false);
    ctx.emitter.emitI64ReinterpretF64();
    return;
  }

  if (name == 'f64.reinterpret_i64') {
    genExpr(args[0], false);
    ctx.emitter.emitF64ReinterpretI64();
    return;
  }

  if (name == 'i32.reinterpret_f32') {
    genExpr(args[0], false);
    ctx.emitter.emitI32ReinterpretF32();
    return;
  }

  if (name == 'f32.reinterpret_i32') {
    genExpr(args[0], false);
    ctx.emitter.emitF32ReinterpretI32();
    return;
  }

  if (name == 'eq') {
    let left = args[0];
    let right = args[1];
    var leftType = getNodeType(ctx, left);
    if (leftType == null) {
      let parent = ctx.wasmFunction.model.getParent(left);
      if (parent != null) {
        leftType = getNodeType(ctx, parent as Node);
      }
    }
    var rightType = getNodeType(ctx, right);
    if (rightType == null) {
      let parent = ctx.wasmFunction.model.getParent(right);
      if (parent != null) {
        rightType = getNodeType(ctx, parent as Node);
      }
    }
    if (leftType == null || rightType == null) {
      throw new Error("Missing type info for eq arguments");
    }
    let leftBase = unwrapAliases(leftType as Type);
    let rightBase = unwrapAliases(rightType as Type);

    if ((leftBase is I32Type || leftBase is BooleanType || leftBase is U32Type) &&
        (rightBase is I32Type || rightBase is BooleanType || rightBase is U32Type)) {
      genExpr(left, false);
      genExpr(right, false);
      ctx.emitter.emitI32Eq();
      return;
    }

    if (leftBase is F64Type && rightBase is F64Type) {
      genExpr(left, false);
      genExpr(right, false);
      ctx.emitter.emitF64Eq();
      return;
    }

    if ((leftBase is StringLiteralType || (leftBase is ClassType && (leftBase as ClassType).name == "String")) &&
        (rightBase is StringLiteralType || (rightBase is ClassType && (rightBase as ClassType).name == "String"))) {
      var foundFunc: WasmFunction | null = null;
      let key = getClassMethodKey(getClassKey(ctx.wasm.stringClass as ClassType), "==");
      if (ctx.wasm.classMethodMap.has(key)) {
        foundFunc = ctx.wasm.classMethodMap[key];
      }
      if (foundFunc == null) {
        throw new Error("String operator== not found!");
      }
      genExpr(left, false);
      genExpr(right, false);
      ctx.emitter.emitCall(foundFunc as WasmFunction);
      return;
    }

    // Default reference equality fallback
    genExpr(left, false);
    let leftWasmType = typeToValType(ctx.wasm, leftType as Type);
    if (leftWasmType is ValTypeAnyRef) {
      ctx.emitter.emitRefCastEqNull();
    }
    genExpr(right, false);
    let rightWasmType = typeToValType(ctx.wasm, rightType as Type);
    if (rightWasmType is ValTypeAnyRef) {
      ctx.emitter.emitRefCastEqNull();
    }

    let eqValType = new ValTypeEqRef();
    let leftLocal = ctx.allocLocal(eqValType);
    let rightLocal = ctx.allocLocal(eqValType);

    ctx.emitter.emitLocalSet(rightLocal);
    ctx.emitter.emitLocalSet(leftLocal);

    var openBlocks = 0;

    // 1. Reference equality check
    ctx.emitter.emitLocalGet(leftLocal);
    ctx.emitter.emitLocalGet(rightLocal);
    ctx.emitter.emitRefEq();
    ctx.emitter.emitIf(new ValTypeI32());
    ctx.enterBlockStructure();
    ctx.emitter.emitI32Const(1);
    ctx.emitter.emitElse();
    openBlocks += 1;

    // 2. Null check (since they are not ref-equal, if either is null they can't be equal)
    ctx.emitter.emitLocalGet(leftLocal);
    ctx.emitter.emitRefIsNull();
    ctx.emitter.emitLocalGet(rightLocal);
    ctx.emitter.emitRefIsNull();
    ctx.emitter.emitI32Or();
    ctx.emitter.emitIf(new ValTypeI32());
    ctx.enterBlockStructure();
    ctx.emitter.emitI32Const(0);
    ctx.emitter.emitElse();
    openBlocks += 1;

    // 3. String equality check
    let stringClass = ctx.wasm.stringClass;
    if (stringClass != null) {
      var stringStructOpt: WasmStruct | null = null;
      if (let (true, info) = ctx.wasm.classInfos.get(getClassKey(stringClass as ClassType))) {
        stringStructOpt = info.structType;
      }
      if (stringStructOpt != null) {
        let stringStruct = stringStructOpt as WasmStruct;
        ctx.emitter.emitLocalGet(leftLocal);
        ctx.emitter.emitRefTest(stringStruct.index);
        ctx.emitter.emitLocalGet(rightLocal);
        ctx.emitter.emitRefTest(stringStruct.index);
        ctx.emitter.emitI32And();
        ctx.emitter.emitIf(new ValTypeI32());
        ctx.enterBlockStructure();

        // Find String.== method
        let lookupName = "==";
        var foundFunc: WasmFunction | null = null;
        var currClass: ClassType | null = stringClass;
        while (currClass != null && foundFunc == null) {
          for (let f in ctx.wasm.functions) {
            if (f.classType != null && !f.isStatic && getClassKey(f.classType as ClassType) == getClassKey(currClass as ClassType) && f.methodName != null && (f.methodName as String) == lookupName) {
              foundFunc = f;
              break;
            }
          }
          currClass = (currClass as ClassType).superType;
        }

        if (foundFunc != null) {
          ctx.emitter.emitLocalGet(leftLocal);
          ctx.emitter.emitRefCast(stringStruct.index);
          ctx.emitter.emitLocalGet(rightLocal);
          ctx.emitter.emitRefCast(stringStruct.index);
          ctx.emitter.emitCall(foundFunc as WasmFunction);
        } else {
          ctx.emitter.emitI32Const(0);
        }

        ctx.emitter.emitElse();
        openBlocks += 1;
      }
    }

    // 4. Boxed primitives check
    let boxClass = ctx.wasm.boxClass;
    if (boxClass != null) {
      let types = new Array<Type>();
      types.push(new I32Type());
      types.push(new BooleanType());
      types.push(new F64Type());
      types.push(new F32Type());
      types.push(new I64Type());

      var idx = 0;
      while (idx < types.length) {
        let t = types[idx];
        let typeArgs = new Array<Type>();
        typeArgs.push(t);
        let concreteBoxType = instantiateClassType(boxClass as ClassType, typeArgs);
        let cKey = getClassKey(concreteBoxType);
        var structTypeOpt: WasmStruct | null = null;
        if (let (true, info) = ctx.wasm.classInfos.get(cKey)) {
          structTypeOpt = info.structType;
        }
        if (structTypeOpt != null) {
          let structType = structTypeOpt as WasmStruct;

          ctx.emitter.emitLocalGet(leftLocal);
          ctx.emitter.emitRefTest(structType.index);
          ctx.emitter.emitLocalGet(rightLocal);
          ctx.emitter.emitRefTest(structType.index);
          ctx.emitter.emitI32And();
          ctx.emitter.emitIf(new ValTypeI32());
          ctx.enterBlockStructure();

          ctx.emitter.emitLocalGet(leftLocal);
          ctx.emitter.emitRefCast(structType.index);
          ctx.emitter.emitStructGet(structType.index, 1);

          ctx.emitter.emitLocalGet(rightLocal);
          ctx.emitter.emitRefCast(structType.index);
          ctx.emitter.emitStructGet(structType.index, 1);

          match (t) {
            case I32Type: ctx.emitter.emitI32Eq()
            case BooleanType: ctx.emitter.emitI32Eq()
            case F64Type: ctx.emitter.emitF64Eq()
            case F32Type: ctx.emitter.emitF32Eq()
            case I64Type: ctx.emitter.emitI64Eq()
            case _: ctx.emitter.emitI32Const(0)
          };

          ctx.emitter.emitElse();
          openBlocks += 1;
        }
        idx += 1;
      }
    }

    // Fallback for non-boxed/different references (since we already checked ref.eq, they are false)
    ctx.emitter.emitI32Const(0);

    // Close all opened blocks
    while (openBlocks > 0) {
      ctx.exitBlockStructure();
      ctx.emitter.emitEnd();
      openBlocks -= 1;
    }
    return;
  }

  if (name == 'hash') {
    let arg = args[0];
    var argType = getNodeType(ctx, arg);
    if (argType == null) {
      let parent = ctx.wasmFunction.model.getParent(arg);
      if (parent != null) {
        argType = getNodeType(ctx, parent as Node);
      }
    }
    if (argType == null) {
      throw new Error("Missing type info for hash argument");
    }
    let baseT = unwrapAliases(argType as Type);

    // Primitives
    if (baseT is I32Type || baseT is BooleanType || baseT is U32Type) {
      genExpr(arg, false);
      return;
    }

    // String
    if (baseT is StringLiteralType || (baseT is ClassType && (baseT as ClassType).name == "String")) {
      genExpr(arg, false);
      
      let foundFunc = ctx.wasm.stringHashFunc;
      if (foundFunc == null) {
        throw new Error("$stringHash helper function not found!");
      }
      ctx.emitter.emitCall(foundFunc as WasmFunction);
      return;
    }

    // ClassTypes (vtable dispatch hashCode or direct call)
    if (baseT is ClassType) {
      let ct = baseT as ClassType;
      // We will look up hashCode on ct
      var methodInfo: MethodInfo | null = null;
      if (ct.members.has("hashCode")) {
        let member = ct.members["hashCode"];
        if (member is MethodInfo) {
          methodInfo = member as MethodInfo;
        }
      }
      
      if (methodInfo != null) {
        let mInfo = methodInfo as MethodInfo;
        genExpr(arg, false);
        
        if (ct.isFinal || mInfo.isFinal) {
          // Direct call
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = ct;
          while (currClass != null && foundFunc == null) {
            let key = getClassMethodKey(getClassKey(currClass as ClassType), "hashCode");
            if (ctx.wasm.classMethodMap.has(key)) {
              foundFunc = ctx.wasm.classMethodMap[key];
            }
            currClass = (currClass as ClassType).superType;
          }
          if (foundFunc == null) {
            throw new Error("hashCode WasmFunction not found for class: " + ct.name);
          }
          ctx.emitter.emitCall(foundFunc as WasmFunction);
        } else {
          // Dynamic dispatch via vtable
          var structInfoOpt: WasmStruct | null = null;
          var vtableStructOpt: WasmStruct | null = null;
          if (let (true, info) = ctx.wasm.classInfos.get(getClassKey(ct))) {
            structInfoOpt = info.structType;
            vtableStructOpt = info.vtableStructType;
          }
          if (structInfoOpt == null || vtableStructOpt == null) {
            throw new Error("Class struct or VTable struct not found for class: " + ct.name);
          }
          let structInfo = structInfoOpt as WasmStruct;
          let vtableStruct = vtableStructOpt as WasmStruct;
          
          var methodIndex = -1;
          for (var i = 0; i < vtableStruct.fields.length; i += 1) {
            if (vtableStruct.fields[i].name != null && (vtableStruct.fields[i].name as String) == "hashCode") {
              methodIndex = i;
            }
          }
          if (methodIndex == -1) {
            throw new Error("hashCode method not found in vtable for class: " + ct.name);
          }
          
          var scratchLocal = ctx.getStructScratchLocal(structInfo);
          ctx.emitter.emitLocalTee(scratchLocal);
          
          ctx.emitter.emitLocalGet(scratchLocal);
          ctx.emitter.emitRefCast(structInfo.index);
          ctx.emitter.emitStructGet(structInfo.index, 0); // vtable is field 0
          ctx.emitter.emitRefCast(vtableStruct.index);
          ctx.emitter.emitStructGet(vtableStruct.index, methodIndex);
          
          let sig = getClassMemberSignature(ctx.wasm, ct, "hashCode");
          ctx.emitter.emitRefCast(sig.index);
          ctx.emitter.emitCallRef(sig.index);
        }
        return;
      }
    }

    // Generic fallback (erased reference, e.g., type parameter type K or anyref)
    genExpr(arg, false); // Stack: [value]
    
    // We allocate a local to tee/get the value
    let targetWasmType = typeToValType(ctx.wasm, baseT);
    let valLocal = ctx.allocLocal(targetWasmType);
    ctx.emitter.emitLocalSet(valLocal);
    
    // Check if null
    ctx.emitter.emitLocalGet(valLocal);
    ctx.emitter.emitRefIsNull();
    ctx.emitter.emitIf(new ValTypeI32());
    ctx.emitter.emitI32Const(0);
    ctx.emitter.emitElse();
    
    // Check if it's String
    var stringStruct: WasmStruct | null = null;
    let stringClass = ctx.wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (let (true, info) = ctx.wasm.classInfos.get(key)) {
        stringStruct = info.structType;
      }
    }
    
    if (stringStruct != null) {
      let stringStructIdx = (stringStruct as WasmStruct).index;
      ctx.emitter.emitLocalGet(valLocal);
      ctx.emitter.emitRefTest(stringStructIdx);
      ctx.emitter.emitIf(new ValTypeI32());
      
      // If it is a String, cast and call string hash helper
      ctx.emitter.emitLocalGet(valLocal);
      ctx.emitter.emitRefCast(stringStructIdx);
      
      let foundHashFunc = ctx.wasm.stringHashFunc;
      if (foundHashFunc == null) {
        throw new Error("$stringHash helper function not found!");
      }
      ctx.emitter.emitCall(foundHashFunc as WasmFunction);
      
      ctx.emitter.emitElse();
      
      // If it is not a String:
      // Fallback: return 0
      ctx.emitter.emitI32Const(0);
      
      ctx.emitter.emitEnd(); // end String check if
    } else {
      ctx.emitter.emitI32Const(0);
    }
    
    ctx.emitter.emitEnd(); // end null check if
    return;
  }

  if (name == 'unreachable') {
    ctx.emitter.emitUnreachable();
    return;
  }

  if (name == 'eq') {
    let leftType = getNodeType(ctx, args[0]);
    let rightType = getNodeType(ctx, args[1]);
    if (leftType == null || rightType == null) {
      throw new Error("Missing type info for equals intrinsic operands");
    }
    let leftBase = unwrapAliases(leftType as Type);
    let rightBase = unwrapAliases(rightType as Type);

    let isRefContext = isWasmRefType(ctx.wasm, leftBase) || isWasmRefType(ctx.wasm, rightBase);
    let isFloatContext = isFloatType(leftBase) || isFloatType(rightBase);
    let isI64Context = leftBase is I64Type || leftBase is U64Type || rightBase is I64Type || rightBase is U64Type;

    if (leftBase is ClassType) {
      let ct = leftBase as ClassType;
      if (ct.members.has("==")) {
        genExpr(args[0], false);
        genExpr(args[1], false);

        let lookupName = "==";
        var foundFunc: WasmFunction | null = null;
        var currClass: ClassType | null = ct;
        while (currClass != null && foundFunc == null) {
          let key = getClassMethodKey(getClassKey(currClass as ClassType), lookupName);
          if (ctx.wasm.classMethodMap.has(key)) {
            foundFunc = ctx.wasm.classMethodMap[key];
          }
          currClass = (currClass as ClassType).superType;
        }

        if (foundFunc != null) {
          if (ct.isFinal) {
            ctx.emitter.emitCall(foundFunc as WasmFunction);
          } else {
            var structInfoOpt: WasmStruct | null = null;
            var vtableStructOpt: WasmStruct | null = null;
            if (let (true, info) = ctx.wasm.classInfos.get(getClassKey(ct))) {
              structInfoOpt = info.structType;
              vtableStructOpt = info.vtableStructType;
            }
            if (structInfoOpt == null || vtableStructOpt == null) {
              throw new Error("Class struct or VTable struct not found for class: " + ct.name);
            }
            let structInfo = structInfoOpt as WasmStruct;
            let vtableStruct = vtableStructOpt as WasmStruct;
            
            var methodIndex = -1;
            for (var i = 0; i < vtableStruct.fields.length; i += 1) {
              if (vtableStruct.fields[i].name != null && (vtableStruct.fields[i].name as String) == lookupName) {
                methodIndex = i;
              }
            }
            
            if (methodIndex != -1) {
              let rightValType = typeToValType(ctx.wasm, rightType as Type);
              let rightLocal = ctx.allocLocal(rightValType);
              ctx.emitter.emitLocalSet(rightLocal);
              
              let scratchLocal = ctx.getStructScratchLocal(structInfo);
              ctx.emitter.emitLocalTee(scratchLocal);
              
              ctx.emitter.emitLocalGet(rightLocal);
              
              ctx.emitter.emitLocalGet(scratchLocal);
              ctx.emitter.emitRefCast(structInfo.index);
              ctx.emitter.emitStructGet(structInfo.index, 0);
              ctx.emitter.emitRefCast(vtableStruct.index);
              ctx.emitter.emitStructGet(vtableStruct.index, methodIndex);
              
              let sig = getClassMemberSignature(ctx.wasm, ct, lookupName);
              ctx.emitter.emitRefCast(sig.index);
              ctx.emitter.emitCallRef(sig.index);
            } else {
              throw new Error("Method not found in vtable: " + lookupName);
            }
          }
          return;
        }
      }
    }

    if (isRefContext) {
      genExpr(args[0], false);
      let leftWasmType = typeToValType(ctx.wasm, leftType as Type);
      if (leftWasmType is ValTypeAnyRef) {
        ctx.emitter.emitRefCastEqNull();
      }

      genExpr(args[1], false);
      let rightWasmType = typeToValType(ctx.wasm, rightType as Type);
      if (rightWasmType is ValTypeAnyRef) {
        ctx.emitter.emitRefCastEqNull();
      }

      let eqValType = new ValTypeEqRef();
      let leftLocal = ctx.allocLocal(eqValType);
      let rightLocal = ctx.allocLocal(eqValType);

      ctx.emitter.emitLocalSet(rightLocal);
      ctx.emitter.emitLocalSet(leftLocal);

      var openBlocks = 0;

      // 1. Reference equality check
      ctx.emitter.emitLocalGet(leftLocal);
      ctx.emitter.emitLocalGet(rightLocal);
      ctx.emitter.emitRefEq();
      ctx.emitter.emitIf(new ValTypeI32());
      ctx.enterBlockStructure();
      ctx.emitter.emitI32Const(1);
      ctx.emitter.emitElse();
      openBlocks += 1;

      // 2. Null check (since they are not ref-equal, if either is null they can't be equal)
      ctx.emitter.emitLocalGet(leftLocal);
      ctx.emitter.emitRefIsNull();
      ctx.emitter.emitLocalGet(rightLocal);
      ctx.emitter.emitRefIsNull();
      ctx.emitter.emitI32Or();
      ctx.emitter.emitIf(new ValTypeI32());
      ctx.enterBlockStructure();
      ctx.emitter.emitI32Const(0);
      ctx.emitter.emitElse();
      openBlocks += 1;

      // 3. String equality check
      let stringClass = ctx.wasm.stringClass;
      if (stringClass != null) {
        var stringStructOpt: WasmStruct | null = null;
        if (let (true, info) = ctx.wasm.classInfos.get(getClassKey(stringClass as ClassType))) {
          stringStructOpt = info.structType;
        }
        if (stringStructOpt != null) {
          let stringStruct = stringStructOpt as WasmStruct;
          ctx.emitter.emitLocalGet(leftLocal);
          ctx.emitter.emitRefTest(stringStruct.index);
          ctx.emitter.emitLocalGet(rightLocal);
          ctx.emitter.emitRefTest(stringStruct.index);
          ctx.emitter.emitI32And();
          ctx.emitter.emitIf(new ValTypeI32());
          ctx.enterBlockStructure();

          // Find String.== method
          let lookupName = "==";
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = stringClass;
          while (currClass != null && foundFunc == null) {
            for (let f in ctx.wasm.functions) {
              if (f.classType != null && !f.isStatic && getClassKey(f.classType as ClassType) == getClassKey(currClass as ClassType) && f.methodName != null && (f.methodName as String) == lookupName) {
                foundFunc = f;
                break;
              }
            }
            currClass = (currClass as ClassType).superType;
          }

          if (foundFunc != null) {
            ctx.emitter.emitLocalGet(leftLocal);
            ctx.emitter.emitRefCast(stringStruct.index);
            ctx.emitter.emitLocalGet(rightLocal);
            ctx.emitter.emitRefCast(stringStruct.index);
            ctx.emitter.emitCall(foundFunc as WasmFunction);
          } else {
            ctx.emitter.emitI32Const(0);
          }

          ctx.emitter.emitElse();
          openBlocks += 1;
        }
      }

      // 4. Boxed primitives check
      let boxClass = ctx.wasm.boxClass;
      if (boxClass != null) {
        let types = new Array<Type>();
        types.push(new I32Type());
        types.push(new BooleanType());
        types.push(new F64Type());
        types.push(new F32Type());
        types.push(new I64Type());

        var idx = 0;
        while (idx < types.length) {
          let t = types[idx];
          let typeArgs = new Array<Type>();
          typeArgs.push(t);
          let concreteBoxType = instantiateClassType(boxClass as ClassType, typeArgs);
          let cKey = getClassKey(concreteBoxType);
          var structTypeOpt: WasmStruct | null = null;
          if (let (true, info) = ctx.wasm.classInfos.get(cKey)) {
            structTypeOpt = info.structType;
          }
          if (structTypeOpt != null) {
            let structType = structTypeOpt as WasmStruct;

            ctx.emitter.emitLocalGet(leftLocal);
            ctx.emitter.emitRefTest(structType.index);
            ctx.emitter.emitLocalGet(rightLocal);
            ctx.emitter.emitRefTest(structType.index);
            ctx.emitter.emitI32And();
            ctx.emitter.emitIf(new ValTypeI32());
            ctx.enterBlockStructure();

            ctx.emitter.emitLocalGet(leftLocal);
            ctx.emitter.emitRefCast(structType.index);
            ctx.emitter.emitStructGet(structType.index, 1);

            ctx.emitter.emitLocalGet(rightLocal);
            ctx.emitter.emitRefCast(structType.index);
            ctx.emitter.emitStructGet(structType.index, 1);

            match (t) {
              case I32Type: ctx.emitter.emitI32Eq()
              case BooleanType: ctx.emitter.emitI32Eq()
              case F64Type: ctx.emitter.emitF64Eq()
              case F32Type: ctx.emitter.emitF32Eq()
              case I64Type: ctx.emitter.emitI64Eq()
              case _: ctx.emitter.emitI32Const(0)
            };

            ctx.emitter.emitElse();
            openBlocks += 1;
          }
          idx += 1;
        }
      }

      // Fallback for non-boxed/different references (since we already checked ref.eq, they are false)
      ctx.emitter.emitI32Const(0);

      // Close all opened blocks
      while (openBlocks > 0) {
        ctx.exitBlockStructure();
        ctx.emitter.emitEnd();
        openBlocks -= 1;
      }
    } else if (isFloatContext) {
      if (leftBase is F32Type && rightBase is F32Type) {
        genExpr(args[0], false);
        genExpr(args[1], false);
        ctx.emitter.emitF32Eq();
      } else {
        if (!isFloatType(leftBase)) {
          genExpr(args[0], false);
          ctx.emitter.emitF64ConvertI32S();
        } else {
          genExpr(args[0], false);
        }
        if (!isFloatType(rightBase)) {
          genExpr(args[1], false);
          ctx.emitter.emitF64ConvertI32S();
        } else {
          genExpr(args[1], false);
        }
        ctx.emitter.emitF64Eq();
      }
    } else if (isI64Context) {
      genExpr(args[0], false);
      genExpr(args[1], false);
      ctx.emitter.emitI64Eq();
    } else {
      genExpr(args[0], false);
      genExpr(args[1], false);
      ctx.emitter.emitI32Eq();
    }
    return;
  }

  if (name == 'hash') {
    let type = getNodeType(ctx, args[0]);
    if (type == null) {
      throw new Error("Missing type info for hash intrinsic operand");
    }
    let bType = unwrapAliases(type as Type);

    if (bType is I32Type || bType is U32Type || isBooleanLike(bType)) {
      genExpr(args[0], false);
      return;
    }

    if (bType is ClassType && (bType as ClassType).name == "String") {
      genExpr(args[0], false);
      let foundFunc = ctx.wasm.stringHashHelper;
      if (foundFunc == null) {
        throw new Error("string_hash_helper not found in functions!");
      }
      ctx.emitter.emitCall(foundFunc as WasmFunction);
      return;
    }

    if (bType is ClassType) {
      let ct = bType as ClassType;
      if (ct.members.has("hashCode")) {
        genExpr(args[0], false);

        let lookupName = "hashCode";
        var foundFunc: WasmFunction | null = null;
        var currClass: ClassType | null = ct;
        while (currClass != null && foundFunc == null) {
          let key = getClassMethodKey(getClassKey(currClass as ClassType), lookupName);
          if (ctx.wasm.classMethodMap.has(key)) {
            foundFunc = ctx.wasm.classMethodMap[key];
          }
          currClass = (currClass as ClassType).superType;
        }

        if (foundFunc != null) {
          if (ct.isFinal) {
            ctx.emitter.emitCall(foundFunc as WasmFunction);
          } else {
            var structInfoOpt: WasmStruct | null = null;
            var vtableStructOpt: WasmStruct | null = null;
            if (let (true, info) = ctx.wasm.classInfos.get(getClassKey(ct))) {
              structInfoOpt = info.structType;
              vtableStructOpt = info.vtableStructType;
            }
            if (structInfoOpt == null || vtableStructOpt == null) {
              throw new Error("Class struct or VTable struct not found for class: " + ct.name);
            }
            let structInfo = structInfoOpt as WasmStruct;
            let vtableStruct = vtableStructOpt as WasmStruct;
            
            var methodIndex = -1;
            for (var i = 0; i < vtableStruct.fields.length; i += 1) {
              if (vtableStruct.fields[i].name != null && (vtableStruct.fields[i].name as String) == lookupName) {
                methodIndex = i;
              }
            }
            
            if (methodIndex != -1) {
              let scratchLocal = ctx.getStructScratchLocal(structInfo);
              ctx.emitter.emitLocalTee(scratchLocal);
              
              ctx.emitter.emitLocalGet(scratchLocal);
              ctx.emitter.emitRefCast(structInfo.index);
              ctx.emitter.emitStructGet(structInfo.index, 0);
              ctx.emitter.emitRefCast(vtableStruct.index);
              ctx.emitter.emitStructGet(vtableStruct.index, methodIndex);
              
              let sig = getClassMemberSignature(ctx.wasm, ct, lookupName);
              ctx.emitter.emitRefCast(sig.index);
              ctx.emitter.emitCallRef(sig.index);
            } else {
              throw new Error("Method not found in vtable: " + lookupName);
            }
          }
          return;
        }
      }
    }

    // Fallback: evaluate and drop, return 0
    genExpr(args[0], false);
    ctx.emitter.emitDrop();
    ctx.emitter.emitI32Const(0);
    return;
  }

  // TODO: Handle string matches against general math opcodes like the bootstrap compiler does.
  throw new Error("Unsupported global intrinsic codegen for: " + name);
};

export let isArrayIntrinsic = (name: String): boolean => {
  return name == "__array_len" || name == "__byte_array_length" ||
         name == "__array_get" || name == "__byte_array_get" ||
         name == "__array_set" || name == "__byte_array_set" ||
         name == "__array_new" || name == "__array_new_empty" ||
         name == "__byte_array_new" || name == "__byte_array_copy";
};

export let generateArrayIntrinsic = (
  ctx: FunctionContext,
  name: String,
  call: CallExpression,
  genExpr: (e: Expression, discardValue: boolean) => void
): void => {
  let args = call.args;
  
  if (name == "__array_len" || name == "__byte_array_length") {
    genExpr(args[0], false);
    ctx.emitter.emitArrayLen();
    return;
  }
  
  if (name == "__array_get" || name == "__byte_array_get") {
    let arrayType = getArrayTypeWithFallback(ctx, args[0]);
    if (arrayType == null) {
      throw new Error("generateArrayIntrinsic: arrayType is null for args[0] in __array_get");
    }
    let valType = typeToValTypeWithSub(ctx.wasm, arrayType as Type, ctx.wasmFunction);
    var typeIndex = -1;
    match (valType) {
      case ValTypeRefNull {target}: { typeIndex = target.index; }
      case ValTypeRef {target}: { typeIndex = target.index; }
      case _: { throw new Error("Expected reference type for array"); }
    }
    
    genExpr(args[0], false);
    genExpr(args[1], false);
    
    if (name == "__byte_array_get") {
      ctx.emitter.emitArrayGetU(typeIndex);
    } else {
      ctx.emitter.emitArrayGet(typeIndex);
    }
    return;
  }
  
  if (name == "__array_set" || name == "__byte_array_set") {
    let arrayType = getArrayTypeWithFallback(ctx, args[0]);
    if (arrayType == null) {
      throw new Error("generateArrayIntrinsic: arrayType is null for args[0] in __array_set");
    }
    let valType = typeToValTypeWithSub(ctx.wasm, arrayType as Type, ctx.wasmFunction);
    var typeIndex = -1;
    match (valType) {
      case ValTypeRefNull {target}: { typeIndex = target.index; }
      case ValTypeRef {target}: { typeIndex = target.index; }
      case _: { throw new Error("Expected reference type for array"); }
    }
    

    genExpr(args[0], false);
    genExpr(args[1], false);
    genExpr(args[2], false);
    
    ctx.emitter.emitArraySet(typeIndex);
    return;
  }
  
  if (name == "__array_new") {
    let arrayType = getArrayTypeWithFallback(ctx, call);
    if (arrayType == null) {
      throw new Error("generateArrayIntrinsic: arrayType is null for call in __array_new");
    }
    let valType = typeToValTypeWithSub(ctx.wasm, arrayType as Type, ctx.wasmFunction);
    var typeIndex = -1;
    match (valType) {
      case ValTypeRefNull {target}: { typeIndex = target.index; }
      case ValTypeRef {target}: { typeIndex = target.index; }
      case _: { throw new Error("Expected reference type for array"); }
    }
    
    genExpr(args[1], false); // value first
    genExpr(args[0], false); // size second
    
    ctx.emitter.emitArrayNew(typeIndex);
    return;
  }
  
  if (name == "__array_new_empty" || name == "__byte_array_new") {
    let arrayType = getArrayTypeWithFallback(ctx, call);
    if (arrayType == null) {
      throw new Error("generateArrayIntrinsic: arrayType is null for call in __array_new_empty");
    }
    let valType = typeToValTypeWithSub(ctx.wasm, arrayType as Type, ctx.wasmFunction);
    var typeIndex = -1;
    match (valType) {
      case ValTypeRefNull {target}: { typeIndex = target.index; }
      case ValTypeRef {target}: { typeIndex = target.index; }
      case _: { throw new Error("Expected reference type for array"); }
    }
    
    genExpr(args[0], false);
    ctx.emitter.emitArrayNewDefault(typeIndex);
    return;
  }
  
  if (name == "__byte_array_copy") {
    let destType = getArrayTypeWithFallback(ctx, args[0]);
    let srcType = getArrayTypeWithFallback(ctx, args[2]);
    if (destType == null) {
      throw new Error("generateArrayIntrinsic: destType is null for args[0] in __byte_array_copy");
    }
    if (srcType == null) {
      throw new Error("generateArrayIntrinsic: srcType is null for args[2] in __byte_array_copy");
    }
    let destValType = typeToValTypeWithSub(ctx.wasm, destType as Type, ctx.wasmFunction);
    let srcValType = typeToValTypeWithSub(ctx.wasm, srcType as Type, ctx.wasmFunction);
    
    var destTypeIndex = -1;
    var srcTypeIndex = -1;
    match (destValType) {
      case ValTypeRefNull {target}: { destTypeIndex = target.index; }
      case ValTypeRef {target}: { destTypeIndex = target.index; }
      case _: {}
    }
    match (srcValType) {
      case ValTypeRefNull {target}: { srcTypeIndex = target.index; }
      case ValTypeRef {target}: { srcTypeIndex = target.index; }
      case _: {}
    }
    
    genExpr(args[0], false);
    genExpr(args[1], false);
    genExpr(args[2], false);
    genExpr(args[3], false);
    genExpr(args[4], false);
    
    ctx.emitter.emitArrayCopy(destTypeIndex, srcTypeIndex);
    return;
  }
  
  throw new Error("Unsupported array intrinsic: " + name);
};

