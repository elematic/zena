import { Node, UnaryExpression, BinaryExpression, Expression, NullLiteral } from '../../ast.zena';
import { Type, F64Type, F32Type, I32Type, U32Type, I64Type, U64Type, RecordType, ClassType, ArrayType,
  AnyType, isFloatType, baseType, typeToString,
  InterfaceType, TypeParameterType, ThisType, AnyRefType, EqRefType, FunctionType, TupleType, NullType,
  isRefType
} from '../../types.zena';
import { FunctionContext } from '../function-context.zena';
import { Error } from 'zena:error';
import { ValType, ValTypeI32, ValTypeAnyRef, ValTypeRef, ValTypeRefNull, ValTypeVoid, ValTypeEqRef, ValTypeStructRef, ValTypeFuncRef, ValTypeExternRef, ValTypeOptRef } from '../wasm.zena';
import { WasmField, WasmFunction } from '../wasm-module.zena';
import { getClassKey, getSignatureKey } from '../codegen-utils.zena';
import { typeToValType, getClassMemberSignature, getNodeType } from '../type-mapping.zena';
import { Array } from 'zena:array';
 
export let generateUnaryExpression = (ctx: FunctionContext, un: UnaryExpression, genExpr: (e: Expression, discardValue: boolean) => void): void => {
  if (un.operator == "-") {
    let rawType = getNodeType(ctx, un);
    if (rawType == null) throw new Error("Missing type info");
    let nodeType = baseType(rawType);
    if (nodeType is F64Type) {
      ctx.emitter.emitF64Const(0.0);
      genExpr(un.argument, false);
      ctx.emitter.emitF64Sub();
    } else if (nodeType is I32Type) {
      ctx.emitter.emitI32Const(0);
      genExpr(un.argument, false);
      ctx.emitter.emitI32Sub();
    } else {
      throw new Error("Unsupported type for unary minus: " + typeToString(nodeType));
    }
  } else if (un.operator == "!") {
    genExpr(un.argument, false);
    ctx.emitter.emitI32Eqz();
  } else {
    throw new Error("Unsupported unary operator: " + un.operator);
  }
};
 
export let generateBinaryExpression = (ctx: FunctionContext, bin: BinaryExpression, genExpr: (e: Expression, discardValue: boolean) => void): void => {
  if (bin.operator == "??") {
    let model = ctx.wasmFunction.model;
    let leftType = model.getNodeType(bin.left);
    let rightType = model.getNodeType(bin.right);
    let overallType = model.getNodeType(bin);
    if (leftType == null || rightType == null || overallType == null) {
      throw new Error("Missing type info in semantic model for ?? expression");
    }

    // 1. Evaluate left operand
    genExpr(bin.left, false);

    // 2. Store left operand in a temporary local variable
    let leftValType = typeToValType(ctx.wasm, leftType);

    let isRef = match (leftValType) {
      case ValTypeRefNull: true
      case ValTypeRef: true
      case ValTypeEqRef: true
      case ValTypeAnyRef: true
      case ValTypeStructRef: true
      case ValTypeFuncRef: true
      case ValTypeExternRef: true
      case ValTypeOptRef: true
      case _: false
    };

    if (!isRef) {
      let leftLocal = ctx.allocLocal(leftValType);
      ctx.emitter.emitLocalSet(leftLocal);

      // Check if optShortCircuitedLocal == 1
      ctx.emitter.emitLocalGet(ctx.getOptShortCircuitedLocal());
      ctx.emitter.emitI32Const(1);
      ctx.emitter.emitI32Eq();

      // Reset optShortCircuitedLocal = 0
      ctx.emitter.emitI32Const(0);
      ctx.emitter.emitLocalSet(ctx.getOptShortCircuitedLocal());

      let overallValType = typeToValType(ctx.wasm, overallType);
      ctx.emitter.emitIf(overallValType);
      ctx.enterBlockStructure();

      // Then block (short-circuited/null): evaluate right operand
      genExpr(bin.right, false);

      ctx.emitter.emitElse();

      // Else block (not null): return left operand
      ctx.emitter.emitLocalGet(leftLocal);

      ctx.exitBlockStructure();
      ctx.emitter.emitEnd();
      return;
    }

    let leftLocal = ctx.allocLocal(leftValType);
    ctx.emitter.emitLocalTee(leftLocal);

    // 3. Check if not null
    ctx.emitter.emitRefIsNull();
    ctx.emitter.emitI32Eqz();

    // 4. Emit If block
    let overallValType = typeToValType(ctx.wasm, overallType);
    ctx.emitter.emitIf(overallValType);
    ctx.enterBlockStructure();

    // 5. Then block: return left (and cast if types don't match exactly)
    ctx.emitter.emitLocalGet(leftLocal);
    
    // Cast if needed
    if (leftValType is ValTypeRefNull && overallValType is ValTypeRefNull) {
      let lRef = leftValType as ValTypeRefNull;
      let oRef = overallValType as ValTypeRefNull;
      if (lRef.target.index != oRef.target.index) {
        ctx.emitter.emitRefCastNull(oRef.target.index);
      }
    } else if (leftValType is ValTypeRef && overallValType is ValTypeRef) {
      let lRef = leftValType as ValTypeRef;
      let oRef = overallValType as ValTypeRef;
      if (lRef.target.index != oRef.target.index) {
        ctx.emitter.emitRefCast(oRef.target.index);
      }
    } else if (leftValType is ValTypeRef && overallValType is ValTypeRefNull) {
      let lRef = leftValType as ValTypeRef;
      let oRef = overallValType as ValTypeRefNull;
      if (lRef.target.index != oRef.target.index) {
        ctx.emitter.emitRefCastNull(oRef.target.index);
      }
    } else if (leftValType is ValTypeRefNull && overallValType is ValTypeRef) {
      let lRef = leftValType as ValTypeRefNull;
      let oRef = overallValType as ValTypeRef;
      ctx.emitter.emitRefCast(oRef.target.index);
    }

    // 6. Else block: evaluate right operand
    ctx.emitter.emitElse();
    genExpr(bin.right, false);

    let rightValType = typeToValType(ctx.wasm, rightType);
    if (rightValType is ValTypeRefNull && overallValType is ValTypeRefNull) {
      let rRef = rightValType as ValTypeRefNull;
      let oRef = overallValType as ValTypeRefNull;
      if (rRef.target.index != oRef.target.index) {
        ctx.emitter.emitRefCastNull(oRef.target.index);
      }
    } else if (rightValType is ValTypeRef && overallValType is ValTypeRef) {
      let rRef = rightValType as ValTypeRef;
      let oRef = overallValType as ValTypeRef;
      if (rRef.target.index != oRef.target.index) {
        ctx.emitter.emitRefCast(rRef.target.index);
      }
    } else if (rightValType is ValTypeRef && overallValType is ValTypeRefNull) {
      let rRef = rightValType as ValTypeRef;
      let oRef = overallValType as ValTypeRefNull;
      if (rRef.target.index != oRef.target.index) {
        ctx.emitter.emitRefCastNull(oRef.target.index);
      }
    } else if (rightValType is ValTypeRefNull && overallValType is ValTypeRef) {
      let rRef = rightValType as ValTypeRefNull;
      let oRef = overallValType as ValTypeRef;
      ctx.emitter.emitRefCast(oRef.target.index);
    }

    // 7. End block
    ctx.exitBlockStructure();
    ctx.emitter.emitEnd();
    return;
  }

  // 1. Short-circuiting logical operators (&&, ||)
  if (bin.operator == "&&") {
    genExpr(bin.left, false);
    ctx.emitter.emitIf(new ValTypeI32());
    genExpr(bin.right, false);
    ctx.emitter.emitElse();
    ctx.emitter.emitI32Const(0);
    ctx.emitter.emitEnd();
    return;
  }
 
  if (bin.operator == "||") {
    genExpr(bin.left, false);
    ctx.emitter.emitIf(new ValTypeI32());
    ctx.emitter.emitI32Const(1);
    ctx.emitter.emitElse();
    genExpr(bin.right, false);
    ctx.emitter.emitEnd();
    return;
  }
  if (bin.operator == "==" || bin.operator == "!=" || bin.operator == "===" || bin.operator == "!==") {
    let model = ctx.wasmFunction.model;
    if (bin.right is NullLiteral) {
      let leftType = model.getNodeType(bin.left);
      if (leftType == null) throw new Error("Missing type info");
      let leftValType = typeToValType(ctx.wasm, leftType);
      let isLeftRef = match (leftValType) {
        case ValTypeRefNull: true
        case ValTypeRef: true
        case ValTypeEqRef: true
        case ValTypeAnyRef: true
        case ValTypeStructRef: true
        case ValTypeFuncRef: true
        case ValTypeExternRef: true
        case ValTypeOptRef: true
        case _: false
      };

      if (isLeftRef) {
        genExpr(bin.left, false);
        ctx.emitter.emitRefIsNull();
        if (bin.operator == "!=" || bin.operator == "!==") {
          ctx.emitter.emitI32Eqz();
        }
      } else {
        genExpr(bin.left, true); // discard value
        ctx.emitter.emitLocalGet(ctx.getOptShortCircuitedLocal());
        ctx.emitter.emitI32Const(0);
        ctx.emitter.emitLocalSet(ctx.getOptShortCircuitedLocal());
        if (bin.operator == "!=" || bin.operator == "!==") {
          ctx.emitter.emitI32Eqz();
        }
      }
      return;
    }
    if (bin.left is NullLiteral) {
      let rightType = model.getNodeType(bin.right);
      if (rightType == null) throw new Error("Missing type info");
      let rightValType = typeToValType(ctx.wasm, rightType);
      let isRightRef = match (rightValType) {
        case ValTypeRefNull: true
        case ValTypeRef: true
        case ValTypeEqRef: true
        case ValTypeAnyRef: true
        case ValTypeStructRef: true
        case ValTypeFuncRef: true
        case ValTypeExternRef: true
        case ValTypeOptRef: true
        case _: false
      };

      if (isRightRef) {
        genExpr(bin.right, false);
        ctx.emitter.emitRefIsNull();
        if (bin.operator == "!=" || bin.operator == "!==") {
          ctx.emitter.emitI32Eqz();
        }
      } else {
        genExpr(bin.right, true); // discard value
        ctx.emitter.emitLocalGet(ctx.getOptShortCircuitedLocal());
        ctx.emitter.emitI32Const(0);
        ctx.emitter.emitLocalSet(ctx.getOptShortCircuitedLocal());
        if (bin.operator == "!=" || bin.operator == "!==") {
          ctx.emitter.emitI32Eqz();
        }
      }
      return;
    }
  }
  let model = ctx.wasmFunction.model;
  let leftType = getNodeType(ctx, bin.left);
  let rightType = getNodeType(ctx, bin.right);
  
  if (leftType == null || rightType == null) {
    throw new Error("Missing type info in semantic model for binary expression operands");
  }
 
  let leftBase = baseType(leftType);
  let rightBase = baseType(rightType);
 
  let isRefContext = isRefType(leftBase) || isRefType(rightBase);
  let isFloatContext = isFloatType(leftBase) || isFloatType(rightBase);
  let isI64Context = leftBase is I64Type || leftBase is U64Type || rightBase is I64Type || rightBase is U64Type;
 
  // 2. Check for class overloaded operators (if the operator is overridable)
  // Non-overridable operators: ===, !==
  if (bin.operator != "===" && bin.operator != "!==") {
    if (leftBase is ClassType) {
      let ct = leftBase as ClassType;
      let opMember = if (bin.operator == "!=") "==" else bin.operator;
      if (ct.members.has(opMember)) {
        // Evaluate left and right operands onto the stack first
        genExpr(bin.left, false);
        genExpr(bin.right, false);
 
        // Find the operator function
        let lookupName = opMember;
        var foundFunc: WasmFunction | null = null;
        var currClass: ClassType | null = ct;
        while (currClass != null && foundFunc == null) {
          for (let f in ctx.wasm.functions) {
            if (f.classType != null && !f.isStatic && getClassKey(f.classType as ClassType) == getClassKey(currClass as ClassType) && f.methodName != null && (f.methodName as String) == lookupName) {
              foundFunc = f;
              break;
            }
          }
          currClass = (currClass as ClassType).superType;
        }
 
        if (foundFunc != null) {
          if (ct.isFinal) {
            // Direct static call
            ctx.emitter.emitCall(foundFunc as WasmFunction);
          } else {
            // Dynamic dispatch via vtable
            let structInfo = ctx.wasm.classStructs[getClassKey(ct)];
            let vtableStruct = ctx.wasm.classVTableStructs[getClassKey(ct)];
            
            var methodIndex = -1;
            for (var i = 0; i < vtableStruct.fields.length; i += 1) {
              if (vtableStruct.fields[i].name != null && (vtableStruct.fields[i].name as String) == lookupName) {
                methodIndex = i;
              }
            }
            
            if (methodIndex != -1) {
              let rightValType = typeToValType(ctx.wasm, rightType);
              let rightLocal = ctx.allocLocal(rightValType);
              ctx.emitter.emitLocalSet(rightLocal);
              
              let scratchLocal = ctx.getStructScratchLocal(structInfo);
              ctx.emitter.emitLocalTee(scratchLocal);
              
              ctx.emitter.emitLocalGet(rightLocal);
              
              ctx.emitter.emitLocalGet(scratchLocal);
              ctx.emitter.emitRefCast(structInfo.index);
              ctx.emitter.emitStructGet(structInfo.index, 0);
              ctx.emitter.emitRefCast(vtableStruct.index);
              ctx.emitter.emitStructGet(vtableStruct.index, methodIndex);
              
              let sig = getClassMemberSignature(ctx.wasm, ct, lookupName);
              ctx.emitter.emitRefCast(sig.index);
              ctx.emitter.emitCallRef(sig.index);
            } else {
              throw new Error("Method not found in vtable: " + lookupName);
            }
          }
 
          // If the operator was !=, negate the boolean result of ==
          if (bin.operator == "!=") {
            ctx.emitter.emitI32Eqz();
          }
          return;
        }
      }
    }
  }
 
  // 3. Built-in (non-overloaded) operations
  // Evaluate left operand
  if (isFloatContext && !isFloatType(leftBase)) {
    genExpr(bin.left, false);
    ctx.emitter.emitF64ConvertI32S();
  } else {
    genExpr(bin.left, false);
    if (leftBase is RecordType && (bin.operator == "===" || bin.operator == "!==" || bin.operator == "==" || bin.operator == "!=")) {
      let leftRT = leftBase as RecordType;
      let leftFields = new Array<WasmField>();
      for (let pair in leftRT.properties) {
        leftFields.push(new WasmField(pair.key, typeToValType(ctx.wasm, pair.value), false));
      }
      let dispatchInfo = ctx.wasm.getRecordDispatch(ctx.wasmFunction.model, leftFields);
      ctx.emitter.emitRefCast(dispatchInfo.fatPtrType.index);
      ctx.emitter.emitStructGet(dispatchInfo.fatPtrType.index, 0); // Get Instance AnyRef
      ctx.emitter.emitRefCastEq();
    } else if (isRefContext && (bin.operator == "===" || bin.operator == "!==" || bin.operator == "==" || bin.operator == "!=")) {
      let leftWasmType = typeToValType(ctx.wasm, leftType);
      if (leftWasmType is ValTypeAnyRef) {
        ctx.emitter.emitRefCastEq();
      }
    }
  }
 
  // Evaluate right operand
  if (isFloatContext && !isFloatType(rightBase)) {
    genExpr(bin.right, false);
    ctx.emitter.emitF64ConvertI32S();
  } else {
    genExpr(bin.right, false);
    if (rightBase is RecordType && (bin.operator == "===" || bin.operator == "!==" || bin.operator == "==" || bin.operator == "!=")) {
      let rightRT = rightBase as RecordType;
      let rightFields = new Array<WasmField>();
      for (let pair in rightRT.properties) {
        rightFields.push(new WasmField(pair.key, typeToValType(ctx.wasm, pair.value), false));
      }
      let dispatchInfo = ctx.wasm.getRecordDispatch(ctx.wasmFunction.model, rightFields);
      ctx.emitter.emitRefCast(dispatchInfo.fatPtrType.index);
      ctx.emitter.emitStructGet(dispatchInfo.fatPtrType.index, 0); // Get Instance AnyRef
      ctx.emitter.emitRefCastEq();
    } else if (isRefContext && (bin.operator == "===" || bin.operator == "!==" || bin.operator == "==" || bin.operator == "!=")) {
      let rightWasmType = typeToValType(ctx.wasm, rightType);
      if (rightWasmType is ValTypeAnyRef) {
        ctx.emitter.emitRefCastEq();
      }
    }
  }
 
  if (isRefContext) {
    match (bin.operator) {
      case "==": ctx.emitter.emitRefEq()
      case "!=": {
        ctx.emitter.emitRefEq();
        ctx.emitter.emitI32Eqz();
      }
      case "===": ctx.emitter.emitRefEq()
      case "!==": {
        ctx.emitter.emitRefEq();
        ctx.emitter.emitI32Eqz();
      }
      case _: throw new Error("Unsupported operator for references: " + bin.operator)
    }
  } else if (isFloatContext) {
    match (bin.operator) {
      case "+": ctx.emitter.emitF64Add()
      case "-": ctx.emitter.emitF64Sub()
      case "*": ctx.emitter.emitF64Mul()
      case "/": ctx.emitter.emitF64Div()
      case "==": ctx.emitter.emitF64Eq()
      case "!=": ctx.emitter.emitF64Ne()
      case "===": ctx.emitter.emitF64Eq()
      case "!==": ctx.emitter.emitF64Ne()
      case "<": ctx.emitter.emitF64Lt()
      case "<=": ctx.emitter.emitF64Le()
      case ">": ctx.emitter.emitF64Gt()
      case ">=": ctx.emitter.emitF64Ge()
      case _: throw new Error("Unsupported operator for f64: " + bin.operator)
    }
  } else if (isI64Context) {
    let useUnsigned = leftBase is U32Type || leftBase is U64Type || rightBase is U32Type || rightBase is U64Type;
    match (bin.operator) {
      case "+": ctx.emitter.emitI64Add()
      case "-": ctx.emitter.emitI64Sub()
      case "*": ctx.emitter.emitI64Mul()
      case "/": if (useUnsigned) ctx.emitter.emitI64DivU() else ctx.emitter.emitI64DivS()
      case "%": if (useUnsigned) ctx.emitter.emitI64RemU() else ctx.emitter.emitI64RemS()
      case "==": ctx.emitter.emitI64Eq()
      case "!=": ctx.emitter.emitI64Ne()
      case "===": ctx.emitter.emitI64Eq()
      case "!==": ctx.emitter.emitI64Ne()
      case "<": if (useUnsigned) ctx.emitter.emitI64LtU() else ctx.emitter.emitI64LtS()
      case "<=": if (useUnsigned) ctx.emitter.emitI64LeU() else ctx.emitter.emitI64LeS()
      case ">": if (useUnsigned) ctx.emitter.emitI64GtU() else ctx.emitter.emitI64GtS()
      case ">=": if (useUnsigned) ctx.emitter.emitI64GeU() else ctx.emitter.emitI64GeS()
      case "&": ctx.emitter.emitI64And()
      case "|": ctx.emitter.emitI64Or()
      case "^": ctx.emitter.emitI64Xor()
      case "<<": ctx.emitter.emitI64Shl()
      case ">>": if (useUnsigned) ctx.emitter.emitI64ShrU() else ctx.emitter.emitI64ShrS()
      case ">>>": ctx.emitter.emitI64ShrU()
      case _: throw new Error("Unsupported operator for i64: " + bin.operator)
    }
  } else {
    let useUnsigned = leftBase is U32Type || rightBase is U32Type;
    match (bin.operator) {
      case "+": ctx.emitter.emitI32Add()
      case "-": ctx.emitter.emitI32Sub()
      case "*": ctx.emitter.emitI32Mul()
      case "/": if (useUnsigned) ctx.emitter.emitI32DivU() else ctx.emitter.emitI32DivS()
      case "%": if (useUnsigned) ctx.emitter.emitI32RemU() else ctx.emitter.emitI32RemS()
      case "==": ctx.emitter.emitI32Eq()
      case "!=": ctx.emitter.emitI32Ne()
      case "===": ctx.emitter.emitI32Eq()
      case "!==": ctx.emitter.emitI32Ne()
      case "<": if (useUnsigned) ctx.emitter.emitI32LtU() else ctx.emitter.emitI32LtS()
      case "<=": if (useUnsigned) ctx.emitter.emitI32LeU() else ctx.emitter.emitI32LeS()
      case ">": if (useUnsigned) ctx.emitter.emitI32GtU() else ctx.emitter.emitI32GtS()
      case ">=": if (useUnsigned) ctx.emitter.emitI32GeU() else ctx.emitter.emitI32GeS()
      case "&": ctx.emitter.emitI32And()
      case "|": ctx.emitter.emitI32Or()
      case "^": ctx.emitter.emitI32Xor()
      case "<<": ctx.emitter.emitI32Shl()
      case ">>": if (useUnsigned) ctx.emitter.emitI32ShrU() else ctx.emitter.emitI32ShrS()
      case ">>>": ctx.emitter.emitI32ShrU()
      case _: throw new Error("Unsupported operator for i32: " + bin.operator)
    }
  }
};
