import { Node, UnaryExpression, BinaryExpression, Expression } from '../../ast.zena';
import { Type, F64Type, F32Type, I32Type, isFloatType, baseType, typeToString } from '../../types.zena';
import { FunctionContext } from '../function-context.zena';
import { Error } from 'zena:error';

export let generateUnaryExpression = (ctx: FunctionContext, un: UnaryExpression, genExpr: (e: Expression, discardValue: boolean) => void): void => {
  if (un.operator == "-") {
    let rawType = ctx.wasmFunction.model.getNodeType(un);
    if (rawType == null) throw new Error("Missing type info");
    let nodeType = baseType(rawType);
    if (nodeType is F64Type) {
      ctx.emitter.emitF64Const(0.0);
      genExpr(un.argument, false);
      ctx.emitter.emitF64Sub();
    } else if (nodeType is I32Type) {
      ctx.emitter.emitI32Const(0);
      genExpr(un.argument, false);
      ctx.emitter.emitI32Sub();
    } else {
      throw new Error("Unsupported type for unary minus: " + typeToString(nodeType));
    }
  } else if (un.operator == "!") {
    genExpr(un.argument, false);
    ctx.emitter.emitI32Eqz();
  } else {
    throw new Error("Unsupported unary operator: " + un.operator);
  }
};

export let generateBinaryExpression = (ctx: FunctionContext, bin: BinaryExpression, genExpr: (e: Expression, discardValue: boolean) => void): void => {
  let model = ctx.wasmFunction.model;
  let leftType = model.getNodeType(bin.left);
  let rightType = model.getNodeType(bin.right);
  
  if (leftType == null || rightType == null) {
    throw new Error("Missing type info in semantic model for binary expression operands");
  }
  
  var isFloatContext = false;
  if (leftType is F64Type || rightType is F64Type || leftType is F32Type || rightType is F32Type) {
      isFloatContext = true;
  }

  // Implicit F64 upconversion logic
  if (isFloatContext && !(leftType is F64Type) && !(leftType is F32Type)) {
    genExpr(bin.left, false);
    ctx.emitter.emitF64ConvertI32S();
  } else {
    genExpr(bin.left, false);
  }

  if (isFloatContext && !(rightType is F64Type) && !(rightType is F32Type)) {
    genExpr(bin.right, false);
    ctx.emitter.emitF64ConvertI32S();
  } else {
    genExpr(bin.right, false);
  }
  
  if (isFloatContext) {
    match (bin.operator) {
      case "+": ctx.emitter.emitF64Add()
      case "-": ctx.emitter.emitF64Sub()
      case "*": ctx.emitter.emitF64Mul()
      case "/": ctx.emitter.emitF64Div()
      case "==": ctx.emitter.emitF64Eq()
      case "!=": ctx.emitter.emitF64Ne()
      case "===": ctx.emitter.emitF64Eq()
      case "!==": ctx.emitter.emitF64Ne()
      case "<": ctx.emitter.emitF64Lt()
      case "<=": ctx.emitter.emitF64Le()
      case ">": ctx.emitter.emitF64Gt()
      case ">=": ctx.emitter.emitF64Ge()
      case _: throw new Error("Unsupported operator for f64: " + bin.operator)
    }
  } else {
    match (bin.operator) {
      case "+": ctx.emitter.emitI32Add()
      case "-": ctx.emitter.emitI32Sub()
      case "*": ctx.emitter.emitI32Mul()
      case "/": ctx.emitter.emitI32DivS()
      case "%": ctx.emitter.emitI32RemS()
      case "==": ctx.emitter.emitI32Eq()
      case "!=": ctx.emitter.emitI32Ne()
      case "===": ctx.emitter.emitI32Eq()
      case "!==": ctx.emitter.emitI32Ne()
      case "<": ctx.emitter.emitI32LtS()
      case "<=": ctx.emitter.emitI32LeS()
      case ">": ctx.emitter.emitI32GtS()
      case ">=": ctx.emitter.emitI32GeS()
      case "&": ctx.emitter.emitI32And()
      case "|": ctx.emitter.emitI32Or()
      case "^": ctx.emitter.emitI32Xor()
      case "<<": ctx.emitter.emitI32Shl()
      case ">>": ctx.emitter.emitI32ShrS()
      case ">>>": ctx.emitter.emitI32ShrU()
      case _: throw new Error("Unsupported operator for i32: " + bin.operator)
    }
  }
};
