import { ValTypeStructRef, ValTypeRefNull } from '../wasm.zena';
import { NewExpression, Expression, RangeExpression } from '../../ast.zena';
import { FunctionContext } from '../function-context.zena';
import { Error } from 'zena:error';
import { ClassType, FunctionType, Type } from '../../types.zena';
import { WasmField, WasmFunction } from '../wasm-module.zena';
import { getClassKey } from '../codegen-utils.zena';
import { typeToValType, getNodeType } from '../type-mapping.zena';
import { Array } from 'zena:array';

export let generateNewExpression = (
  ctx: FunctionContext,
  expr: NewExpression,
  genExpr: (e: Expression, discardValue: boolean) => void
): void => {
  let nodeType = getNodeType(ctx, expr);
  if (nodeType is ClassType) {
    let classType = nodeType as ClassType;
    let cKey = getClassKey(classType);
    if (ctx.wasm.classSingletonGlobals.has(cKey)) {
      let singletonGlobal = ctx.wasm.classSingletonGlobals[cKey];
      ctx.emitter.emitGlobalGet(singletonGlobal.index);
      return;
    }
    if (!ctx.wasm.classStructs.has(cKey)) {
      throw new Error("Class struct not found: " + classType.name);
    }
    let structType = ctx.wasm.classStructs[cKey];
    let emptyLocal = ctx.allocLocal(new ValTypeRefNull(structType));
    
    ctx.emitter.emitStructNewDefault(structType.index);
    ctx.emitter.emitLocalSet(emptyLocal);
    
    let hasVTable = ctx.wasm.classVTableGlobals.has(getClassKey(classType));
    if (hasVTable) {
        let vtableGlobal = ctx.wasm.classVTableGlobals[getClassKey(classType)];
        ctx.emitter.emitLocalGet(emptyLocal);
        ctx.emitter.emitGlobalGet(vtableGlobal.index);
        ctx.emitter.emitStructSet(structType.index, 0);
    }
    
    ctx.emitter.emitLocalGet(emptyLocal);
    
    // Check if the class has a constructor
    let ctorKey = (getClassKey(classType) as String) + ".<constructor>";
    var ctorFunc: WasmFunction | null = if (ctx.wasm.classMethodMap.has(ctorKey)) {
      ctx.wasm.classMethodMap[ctorKey]
    } else {
      null
    };
    
    if (ctorFunc != null) {
      for (let arg in expr.args) {
        genExpr(arg, false);
      }
      ctx.emitter.emitCall(ctorFunc as WasmFunction);
      ctx.emitter.emitLocalGet(emptyLocal);
    }
  } else {
    throw new Error("generateNewExpression: nodeType is not a ClassType");
  }
};

export let generateRangeExpression = (
  ctx: FunctionContext,
  expr: RangeExpression,
  genExpr: (e: Expression, discardValue: boolean) => void
): void => {
  let nodeType = getNodeType(ctx, expr);
  if (nodeType is ClassType) {
    let classType = nodeType as ClassType;
    let className = classType.name;
    let cKey = getClassKey(classType);
    if (!ctx.wasm.classStructs.has(cKey)) {
      throw new Error("Class struct not found: " + classType.name);
    }
    let structType = ctx.wasm.classStructs[cKey];
    let emptyLocal = ctx.allocLocal(new ValTypeRefNull(structType));
    
    ctx.emitter.emitStructNewDefault(structType.index);
    ctx.emitter.emitLocalSet(emptyLocal);
    
    let hasVTable = ctx.wasm.classVTableGlobals.has(getClassKey(classType));
    if (hasVTable) {
        let vtableGlobal = ctx.wasm.classVTableGlobals[getClassKey(classType)];
        ctx.emitter.emitLocalGet(emptyLocal);
        ctx.emitter.emitGlobalGet(vtableGlobal.index);
        ctx.emitter.emitStructSet(structType.index, 0);
    }
    
    ctx.emitter.emitLocalGet(emptyLocal);
    
    // Check if the class has a constructor
    let ctorKey = (getClassKey(classType) as String) + ".<constructor>";
    var ctorFunc: WasmFunction | null = if (ctx.wasm.classMethodMap.has(ctorKey)) {
      ctx.wasm.classMethodMap[ctorKey]
    } else {
      null
    };
    
    if (ctorFunc != null) {
      if (className == "BoundedRange") {
        if (expr.start == null || expr.end == null) {
          throw new Error("BoundedRange requires start and end expressions");
        }
        genExpr(expr.start as Expression, false);
        genExpr(expr.end as Expression, false);
      } else if (className == "FromRange") {
        if (expr.start == null) {
          throw new Error("FromRange requires start expression");
        }
        genExpr(expr.start as Expression, false);
      } else if (className == "ToRange") {
        if (expr.end == null) {
          throw new Error("ToRange requires end expression");
        }
        genExpr(expr.end as Expression, false);
      } else if (className == "FullRange") {
        // No constructor arguments
      } else {
        throw new Error("Unknown range type: " + className);
      }
      ctx.emitter.emitCall(ctorFunc as WasmFunction);
      ctx.emitter.emitLocalGet(emptyLocal);
    }
  } else {
    throw new Error("generateRangeExpression: nodeType is not a ClassType");
  }
};
