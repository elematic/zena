import { Node, AssignmentExpression, Identifier, Expression, BinaryExpression, MemberExpression, SuperExpression, ClassDeclaration, ImportSpecifier } from '../../ast.zena';
import { Type, F64Type, F32Type, ClassType, InterfaceType } from '../../types.zena';
import { SymbolId, Symbol } from '../../scope/symbol.zena';
import { FunctionContext } from '../function-context.zena';
import { Error } from 'zena:error';
import { generateBinaryExpression } from './operators.zena';
import { typeToValType, getClassKey, WasmFunction, getInterfaceKey, getInterfaceMemberSignature } from '../wasm-module.zena';

/**
 * Generates WASM code for an assignment expression.
 *
 * @param discardValue If true, the assigned value is not left on the stack
 *     (e.g., when used as an ExpressionStatement).
 */
export let generateAssignmentExpression = (
  ctx: FunctionContext,
  assign: AssignmentExpression,
  discardValue: boolean,
  genExpr: (e: Expression, discardValue: boolean) => void): void => {
  
  if (assign.operator != null) {
    if (assign.left is Identifier) {
      let ident = assign.left as Identifier;
      let sym = ctx.wasmFunction.model.resolve(ident);
      if (sym != null) {
        let binOp = assign.operator as String;
        let binExpr = new BinaryExpression(binOp, assign.left, assign.value, assign.loc);
        generateBinaryExpression(ctx, binExpr, genExpr);

        // Store back
        if (ctx.localIndices.has((sym as Symbol).id)) {
          if (discardValue) {
            ctx.emitter.emitLocalSet(ctx.localIndices[(sym as Symbol).id]);
          } else {
            ctx.emitter.emitLocalTee(ctx.localIndices[(sym as Symbol).id]);
          }
          return;
        } else if (ctx.wasm.globalMap.has((sym as Symbol).id)) {
          let index = ctx.wasm.globalMap[(sym as Symbol).id].index;
          ctx.emitter.emitGlobalSet(index);
          if (!discardValue) {
            ctx.emitter.emitGlobalGet(index);
          }
          return;
        }
      }
    }
    throw new Error("Compound assignment target must be an identifier.");
  }

  if (assign.left is Identifier) {
    let ident = assign.left as Identifier;
    let sym = ctx.wasmFunction.model.resolve(ident);
    if (sym != null) {
      if (ctx.localIndices.has((sym as Symbol).id)) {
        genExpr(assign.value, false);
        if (discardValue) {
          ctx.emitter.emitLocalSet(ctx.localIndices[(sym as Symbol).id]);
        } else {
          ctx.emitter.emitLocalTee(ctx.localIndices[(sym as Symbol).id]);
        }
        return;
      }
      if (ctx.wasm.globalMap.has((sym as Symbol).id)) {
        genExpr(assign.value, false);
        let index = ctx.wasm.globalMap[(sym as Symbol).id].index;
        ctx.emitter.emitGlobalSet(index);
        if (!discardValue) {
          ctx.emitter.emitGlobalGet(index);
        }
        return;
      }
    }
    throw new Error("Could not resolve assignment target: " + ident.name);
  } else if (assign.left is MemberExpression) {
    let memExpr = assign.left as MemberExpression;
    let objectType = ctx.wasmFunction.model.getNodeType(memExpr.object);
    
    match (objectType) {
      case ClassType as ct: {
        let isStaticAccess = ctx.wasmFunction.model.isStaticAccess(memExpr);

        if (isStaticAccess) {
          let propName = memExpr.property.name;
          let setterName = "set#" + propName;

          // 1. Look up static setter
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = ct;
          while (currClass != null && foundFunc == null) {
            for (let f in ctx.wasm.functions) {
              if (f.classType != null && f.isStatic && (f.classType as ClassType).id == (currClass as ClassType).id && f.methodName == setterName) {
                foundFunc = f;
              }
            }
            currClass = (currClass as ClassType).superType;
          }

          if (foundFunc != null) {
            let valType = typeToValType(ctx.wasm, ctx.wasmFunction.model.getNodeType(assign.value));
            var tempLocal = -1;
            if (!discardValue) {
              tempLocal = ctx.allocLocal(valType);
            }

            genExpr(assign.value, false);
            if (!discardValue) {
              ctx.emitter.emitLocalTee(tempLocal);
            }

            ctx.emitter.emitCall(foundFunc as WasmFunction);

            if (!discardValue) {
              ctx.emitter.emitLocalGet(tempLocal);
            }
            return;
          }

          // 2. Look up static field (global)
          var foundGlobalIndex = -1;
          currClass = ct;
          while (currClass != null && foundGlobalIndex == -1) {
            for (let g in ctx.wasm.globals) {
              if (g.name == (currClass as ClassType).name + "_" + propName) {
                foundGlobalIndex = g.index;
              }
            }
            currClass = (currClass as ClassType).superType;
          }

          if (foundGlobalIndex != -1) {
            genExpr(assign.value, false);
            ctx.emitter.emitGlobalSet(foundGlobalIndex);
            if (!discardValue) {
              ctx.emitter.emitGlobalGet(foundGlobalIndex);
            }
            return;
          }

          throw new Error("Could not find static member " + propName + " on class " + ct.name);
        }

        if (ct.isExtension) {
          let propName = memExpr.property.name;
          let setterName = "set#" + propName;
          
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = ct;
          while (currClass != null && foundFunc == null) {
            for (let f in ctx.wasm.functions) {
              if (f.classType != null && (f.classType as ClassType).id == (currClass as ClassType).id && f.methodName == setterName) {
                foundFunc = f;
              }
            }
            currClass = (currClass as ClassType).superType;
          }

          if (foundFunc == null) {
            throw new Error("Could not find implementation for extension setter: " + setterName);
          }

          let valType = typeToValType(ctx.wasm, ctx.wasmFunction.model.getNodeType(assign.value));
          var tempLocal = -1;
          if (!discardValue) {
            tempLocal = ctx.allocLocal(valType);
          }

          // Evaluate the object first
          genExpr(memExpr.object, false);
          
          // Evaluate the value being assigned
          genExpr(assign.value, false);
          if (!discardValue) {
            ctx.emitter.emitLocalTee(tempLocal);
          }

          // Emit direct call
          ctx.emitter.emitCall(foundFunc as WasmFunction);

          if (!discardValue) {
            ctx.emitter.emitLocalGet(tempLocal);
          }
          return;
        }

        if (!ctx.wasm.classStructs.has(getClassKey(ct))) {
          throw new Error("Class struct not found: " + ct.name);
        }
        let structInfo = ctx.wasm.classStructs[getClassKey(ct)];
        
        var fieldIndex = -1;
        let propName = memExpr.property.name;
        let lookupName = if (propName.length > 0 && propName.sliceBytes(0, 1) == "#") {
          if (ctx.wasmFunction.classType != null) {
            getClassKey(ctx.wasmFunction.classType as ClassType) + "::" + propName
          } else {
            propName
          }
        } else {
          propName
        };
        
        for (var i = 0; i < structInfo.fields.length; i += 1) {
          if (structInfo.fields[i].name == lookupName) {
             fieldIndex = i;
          }
        }

        let setterName = "set#" + propName;
        let vtableStruct = ctx.wasm.classVTableStructs[getClassKey(ct)];
        var vtableIndex = -1;
        for (var i = 0; i < vtableStruct.fields.length; i += 1) {
          if (vtableStruct.fields[i].name == setterName) {
            vtableIndex = i;
          }
        }
        
        if (vtableIndex != -1) {
          let valType = typeToValType(ctx.wasm, ctx.wasmFunction.model.getNodeType(assign.value));
          var tempLocal = -1;
          if (!discardValue) {
            tempLocal = ctx.allocLocal(valType);
          }

          if (memExpr.object is SuperExpression) {
            var superFunc: WasmFunction | null = null;
            var currClass: ClassType | null = ct; // ct is already the superclass (the type of SuperExpression)
            while (currClass != null && superFunc == null) {
              for (let f in ctx.wasm.functions) {
                if (f.classType != null && (f.classType as ClassType).id == (currClass as ClassType).id && f.methodName == setterName) {
                  superFunc = f;
                }
              }
              currClass = (currClass as ClassType).superType;
            }

            if (superFunc == null) {
              throw new Error("Could not find superclass setter implementation for " + setterName);
            }

            ctx.emitter.emitLocalGet(0);
            genExpr(assign.value, false);
            if (!discardValue) {
              ctx.emitter.emitLocalTee(tempLocal);
            }
            
            ctx.emitter.emitCall(superFunc as WasmFunction);
            if (!discardValue) {
              ctx.emitter.emitLocalGet(tempLocal);
            }
            return;
          } else {
            var foundFunc: WasmFunction | null = null;
            var currClass: ClassType | null = ct;
            while (currClass != null && foundFunc == null) {
              for (let f in ctx.wasm.functions) {
                if (f.classType != null && (f.classType as ClassType).id == (currClass as ClassType).id && f.methodName == setterName) {
                  foundFunc = f;
                }
              }
              currClass = (currClass as ClassType).superType;
            }

            if (foundFunc == null) {
              throw new Error("Could not find implementation for setter: " + setterName);
            }

            genExpr(memExpr.object, false);
            var scratchLocal = ctx.getStructScratchLocal(structInfo);
            ctx.emitter.emitLocalTee(scratchLocal);

            genExpr(assign.value, false);
            if (!discardValue) {
              ctx.emitter.emitLocalTee(tempLocal);
            }

            ctx.emitter.emitLocalGet(scratchLocal);
            ctx.emitter.emitRefCast(structInfo.index);
            ctx.emitter.emitStructGet(structInfo.index, 0); // VTable is at index 0
            ctx.emitter.emitRefCast(vtableStruct.index);
            ctx.emitter.emitStructGet(vtableStruct.index, vtableIndex);

            ctx.emitter.emitCallRef((foundFunc as WasmFunction).signature.index);

            if (!discardValue) {
              ctx.emitter.emitLocalGet(tempLocal);
            }
            return;
          }
        }
        
        if (fieldIndex == -1) {
          throw new Error("Could not find property " + propName + " or virtual setter " + setterName + " on class " + ct.name);
        }
        
        // Evaluate object first (the struct reference we're setting on)
        genExpr(memExpr.object, false);
        ctx.emitter.emitRefCast(structInfo.index);
        
        // Then evaluate the value to assign
        genExpr(assign.value, false);
        
        if (!discardValue) {
          let valType = typeToValType(ctx.wasm, ctx.wasmFunction.model.getNodeType(assign.value));
          let tempLocal = ctx.allocLocal(valType);
          ctx.emitter.emitLocalTee(tempLocal);
          ctx.emitter.emitStructSet(structInfo.index, fieldIndex);
          ctx.emitter.emitLocalGet(tempLocal);
        } else {
          ctx.emitter.emitStructSet(structInfo.index, fieldIndex);
        }
        return;
      }
      case InterfaceType as it: {
        let iName = getInterfaceKey(it);
        let vst = ctx.wasm.interfaceVTableStructs[iName];
        let fatPtr = ctx.wasm.interfaceStructs[iName];
        
        let propName = memExpr.property.name;
        let setterName = "set#" + propName;
        
        var vtableIndex = -1;
        for (var i = 0; i < vst.fields.length; i += 1) {
          if (vst.fields[i].name == setterName) {
            vtableIndex = i;
          }
        }
        
        if (vtableIndex == -1) {
          throw new Error("Property setter not found in interface vtable: " + setterName);
        }
        
        let valType = typeToValType(ctx.wasm, ctx.wasmFunction.model.getNodeType(assign.value));
        var tempLocal = -1;
        if (!discardValue) {
          tempLocal = ctx.allocLocal(valType);
        }
        
        genExpr(memExpr.object, false);
        var scratchLocal = ctx.getStructScratchLocal(fatPtr);
        ctx.emitter.emitLocalSet(scratchLocal);
        
        ctx.emitter.emitLocalGet(scratchLocal);
        ctx.emitter.emitStructGet(fatPtr.index, 0); // Get Instance
        
        genExpr(assign.value, false);
        if (!discardValue) {
          ctx.emitter.emitLocalTee(tempLocal);
        }
        
        ctx.emitter.emitLocalGet(scratchLocal);
        ctx.emitter.emitStructGet(fatPtr.index, 1); // Get VTable
        ctx.emitter.emitStructGet(vst.index, vtableIndex);
        
        let sig = getInterfaceMemberSignature(ctx.wasm, it, setterName);
        ctx.emitter.emitCallRef(sig.index);
        
        if (!discardValue) {
          ctx.emitter.emitLocalGet(tempLocal);
        }
        return;
      }
      case _: {
        throw new Error("Assigning to non-class member is not yet implemented.");
      }
    }
  } else {
    throw new Error("Unsupported assignment target");
  }
};
