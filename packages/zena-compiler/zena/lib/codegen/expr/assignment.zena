import { Node, AssignmentExpression, Identifier, Expression, BinaryExpression, MemberExpression, SuperExpression, ClassDeclaration, ImportSpecifier, IndexExpression, getMemberPropertyName } from '../../ast.zena';
import { Type, F64Type, F32Type, ClassType, InterfaceType, ArrayType, AnyRefType, typeToString, FunctionType, VoidType, ByteArrayType, FieldInfo } from '../../types.zena';
import { SymbolId, Symbol } from '../../scope/symbol.zena';
import { FunctionContext } from '../function-context.zena';
import { Error } from 'zena:error';
import { generateBinaryExpression } from './operators.zena';
import { WasmFunction, WasmArray, WasmStruct, ClassCodegenInfo } from '../wasm-module.zena';
import { getClassKey, getInterfaceKey, getSignatureKey, getClassPrivateFieldKey, ClassMethodKey, getClassMethodKey } from '../codegen-utils.zena';
import { typeToValType, getCellStruct, getInterfaceMemberSignature, getClassMemberSignature, substituteTypeParamsInCodegen, getNodeType, typeToValTypeWithSub, eraseTypeParameters, castValTypeRefNullIfNeeded } from '../type-mapping.zena';
import { ValTypeRefNull, ValTypeRef, ValType, ValTypeStructRef, valTypeEquals, isWasmSubtype, HeapType, heapTypeToSigned } from '../wasm.zena';

/**
 * Reconciles the wasm type of an assigned value with the binding's wasm
 * type, mirroring loadValueAndCast in stmt/bindings.zena. Needed when the
 * value's static type lowers to a wider wasm type than the target local,
 * cell field, or global — e.g. a match expression typed as a union of case
 * classes lowers to eqref, while the target local is a non-nullable
 * concrete ref (bindings became non-nullable by default in 8fae4045).
 */
let castAssignedValueIfNeeded = (ctx: FunctionContext, value: Expression, targetType: Type, targetIdent: Node | null = null): void => {
  var vType = getNodeType(ctx, value);
  if (vType == null && value is Identifier) {
    let sym = ctx.wasmFunction.model.resolve(value as Identifier);
    if (sym != null) {
      vType = ctx.wasmFunction.model.getBindingType(sym as Symbol);
    }
  }
  if (vType == null) {
    vType = new AnyRefType();
  }
  let valueWasmType = typeToValTypeWithSub(ctx.wasm, vType as Type, ctx.wasmFunction);
  var targetWasmType = typeToValTypeWithSub(ctx.wasm, targetType, ctx.wasmFunction);

  if (targetIdent != null && targetIdent is Identifier) {
    let idNode = targetIdent as Identifier;
    let sym = ctx.wasmFunction.model.resolve(idNode);
    if (sym != null) {
      let rSym = (sym as Symbol).resolveTarget();
      let symId = if (ctx.localIndices.has((sym as Symbol).id)) (sym as Symbol).id else rSym.id;
      if (ctx.localIndices.has(symId) && !ctx.isCelled(symId)) {
        let localIndex = ctx.localIndices[symId];
        let paramCount = ctx.wasmFunction.signature.params.length;
        targetWasmType = if (localIndex < paramCount) {
          ctx.wasmFunction.signature.params[localIndex]
        } else {
          ctx.localTypes[localIndex - paramCount]
        };
      }
    }
  }

  castValTypeRefNullIfNeeded(ctx, valueWasmType, targetWasmType);
};

let isArrayType = (t: Type): boolean => {
  return match (t) {
    case ArrayType: true
    case ByteArrayType: true
    case ClassType as ct: {
      if (ct.name == "array" || ct.name == "ByteArray") {
        true
      } else if (ct.isExtension && ct.onType != null) {
        isArrayType(ct.onType as Type)
      } else {
        false
      }
    }
    case _: false
  };
};

/**
 * Generates WASM code for an assignment expression.
 *
 * @param discardValue If true, the assigned value is not left on the stack
 *     (e.g., when used as an ExpressionStatement).
 */
export let generateAssignmentExpression = (
  ctx: FunctionContext,
  assign: AssignmentExpression,
  discardValue: boolean,
  genExpr: (e: Expression, discardValue: boolean) => void): void => {
  
  if (assign.operator != null) {
    let binOp = assign.operator as String;
    let binExpr = new BinaryExpression(binOp, assign.left, assign.value, assign.loc);
    // Prefer the checked type of the whole compound assignment: for `??=`
    // it is the NON-null result type, while the left side's type stays
    // nullable. Typing the synthetic nodes with the nullable left type
    // made the assignment-as-expression value (and its temp local)
    // nullable, which no longer composes with non-nullable bindings.
    var resultType = getNodeType(ctx, assign);
    if (resultType == null) {
      resultType = getNodeType(ctx, assign.left);
    }
    if (resultType != null) {
      ctx.wasmFunction.model.setNodeType(binExpr, resultType as Type);
    }
    let newAssign = new AssignmentExpression(assign.left, binExpr, null, assign.loc);
    if (resultType != null) {
      ctx.wasmFunction.model.setNodeType(newAssign, resultType as Type);
    }
    generateAssignmentExpression(ctx, newAssign, discardValue, genExpr);
    return;
  }

  if (assign.left is Identifier) {
    let ident = assign.left as Identifier;
    let sym = ctx.wasmFunction.model.resolve(ident);
    if (sym != null) {
      let s = sym as Symbol;
      if (ctx.localIndices.has(s.id)) {
        if (ctx.isCelled(s.id)) {
          let symType = ctx.wasmFunction.model.getBindingType(s);
          var innerType = symType as Type;
          if (innerType is ClassType && (innerType as ClassType).name == "Cell") {
            let ct = innerType as ClassType;
            if (ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0) {
              innerType = (ct.typeArguments as Array<Type>)[0];
            }
          }
          let valType = typeToValType(ctx.wasm, innerType);
          let cellStruct = getCellStruct(ctx.wasm, valType);

          genExpr(assign.value, false);
          castAssignedValueIfNeeded(ctx, assign.value, symType as Type, assign.left);
          let valLocal = ctx.allocLocal(valType);
          if (discardValue) {
            ctx.emitter.emitLocalSet(valLocal);
          } else {
            ctx.emitter.emitLocalTee(valLocal);
          }
          ctx.emitter.emitLocalGet(ctx.localIndices[(sym as Symbol).id]);
          ctx.emitter.emitLocalGet(valLocal);
          ctx.emitter.emitStructSet(cellStruct.index, 0);
        } else {
          genExpr(assign.value, false);
          let symType = ctx.wasmFunction.model.getBindingType(s);
          if (symType != null) {
            castAssignedValueIfNeeded(ctx, assign.value, symType as Type, assign.left);
          }
          if (discardValue) {
            ctx.emitter.emitLocalSet(ctx.localIndices[(sym as Symbol).id]);
          } else {
            ctx.emitter.emitLocalTee(ctx.localIndices[(sym as Symbol).id]);
          }
        }
        return;
      }
      if (ctx.wasm.globalMap.has((sym as Symbol).id)) {
        genExpr(assign.value, false);
        let symType = ctx.wasmFunction.model.getBindingType(sym as Symbol);
        if (symType != null) {
          castAssignedValueIfNeeded(ctx, assign.value, symType as Type);
        }
        let index = ctx.wasm.globalMap[(sym as Symbol).id].index;
        ctx.emitter.emitGlobalSet(index);
        if (!discardValue) {
          ctx.emitter.emitGlobalGet(index);
        }
        return;
      }
    }
    throw new Error("Could not resolve assignment target: " + ident.name);
  } else if (assign.left is MemberExpression) {
    let memExpr = assign.left as MemberExpression;
    let objectType = getNodeType(ctx, memExpr.object);
    
    match (objectType) {
      case ClassType as ctVar: {
        let rawCt = if (ctVar.name.length >= 5 && ctVar.name.sliceBytes(ctVar.name.length - 5, ctVar.name.length) == "_This") {
          ctx.wasmFunction.classType as ClassType
        } else {
          ctVar
        };
        let ct = eraseTypeParameters(rawCt) as ClassType;
        let isStaticAccess = ctx.wasmFunction.model.isStaticAccess(memExpr);

        if (isStaticAccess) {
          let propName = getMemberPropertyName(memExpr.isSymbolAccess, memExpr.property.name);
          let setterName = "set#" + propName;

          // 1. Look up static setter
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = ct;
          while (currClass != null && foundFunc == null) {
            let key = getClassMethodKey(getClassKey(currClass as ClassType), setterName);
            if (ctx.wasm.classMethodMap.has(key)) {
              let f = ctx.wasm.classMethodMap[key];
              if (f.isStatic) {
                foundFunc = f;
              }
            }
            currClass = (currClass as ClassType).superType;
          }

          if (foundFunc != null) {
            let valType = typeToValType(ctx.wasm, getNodeType(ctx, assign.value) as Type);
            var tempLocal = -1;
            if (!discardValue) {
              tempLocal = ctx.allocLocal(valType);
            }

            genExpr(assign.value, false);
            if (!discardValue) {
              ctx.emitter.emitLocalTee(tempLocal);
            }

            ctx.emitter.emitCall(foundFunc as WasmFunction);

            if (!discardValue) {
              ctx.emitter.emitLocalGet(tempLocal);
            }
            return;
          }

          // 2. Look up static field (global)
          var foundGlobalIndex = -1;
          currClass = ct;
          while (currClass != null && foundGlobalIndex == -1) {
            for (let g in ctx.wasm.globals) {
              if (g.name == (currClass as ClassType).name + "_" + propName) {
                foundGlobalIndex = g.index;
              }
            }
            currClass = (currClass as ClassType).superType;
          }

          if (foundGlobalIndex != -1) {
            genExpr(assign.value, false);
            ctx.emitter.emitGlobalSet(foundGlobalIndex);
            if (!discardValue) {
              ctx.emitter.emitGlobalGet(foundGlobalIndex);
            }
            return;
          }

          throw new Error("Could not find static member " + propName + " on class " + ct.name);
        }

        if (ct.isExtension) {
          let propName = getMemberPropertyName(memExpr.isSymbolAccess, memExpr.property.name);
          let setterName = "set#" + propName;
          
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = ct;
          while (currClass != null && foundFunc == null) {
            let key = getClassMethodKey(getClassKey(currClass as ClassType), setterName);
            if (ctx.wasm.classMethodMap.has(key)) {
              foundFunc = ctx.wasm.classMethodMap[key];
            }
            currClass = (currClass as ClassType).superType;
          }

          if (foundFunc == null) {
            throw new Error("Could not find implementation for extension setter: " + setterName);
          }

          let valType = typeToValType(ctx.wasm, getNodeType(ctx, assign.value) as Type);
          var tempLocal = -1;
          if (!discardValue) {
            tempLocal = ctx.allocLocal(valType);
          }

          // Evaluate the object first
          genExpr(memExpr.object, false);
          
          // Evaluate the value being assigned
          genExpr(assign.value, false);
          if (!discardValue) {
            ctx.emitter.emitLocalTee(tempLocal);
          }

          // Emit direct call
          ctx.emitter.emitCall(foundFunc as WasmFunction);

          if (!discardValue) {
            ctx.emitter.emitLocalGet(tempLocal);
          }
          return;
        }

        let ctKey = getClassKey(rawCt);
        var structInfoOpt: WasmStruct | null = null;
        var vtableStructOpt: WasmStruct | null = null;
        var classInfoOpt: ClassCodegenInfo | null = null;
        if (let (true, info) = ctx.wasm.classInfos.get(ctKey)) {
          structInfoOpt = info.structType;
          vtableStructOpt = info.vtableStructType;
          classInfoOpt = info;
        }
        if (structInfoOpt == null) {
          throw new Error("Class struct not found: " + ct.name);
        }
        if (vtableStructOpt == null) {
          throw new Error("Class VTable struct not found for: " + ct.name + " key: " + (ctKey as String));
        }
        let structInfo = structInfoOpt as WasmStruct;
        let vtableStruct = vtableStructOpt as WasmStruct;
        
        let propName = getMemberPropertyName(memExpr.isSymbolAccess, memExpr.property.name);
        var fieldIndex = -1;
        let lookupName = if (propName.length > 0 && propName.sliceBytes(0, 1) == "#") {
          // Functions compiled from a mixin body resolve privates
          // under the mixin's scope key ("<Mixin>_This::#x") — see
          // WasmFunction.privateScopeKey.
          let mixScope = ctx.wasmFunction.privateScopeKey;
          let scopedName = if (mixScope != null) {
            (mixScope as String) + "::" + propName
          } else {
            ""
          };
          if (scopedName != "" && structInfo.fieldIndexByName(scopedName) >= 0) {
            scopedName
          } else {
            // Struct-driven resolution (see WasmStruct.resolvePrivateFieldName).
            let resolved = structInfo.resolvePrivateFieldName(rawCt, propName);
            if (resolved != null) resolved as String
            else getClassPrivateFieldKey(ctKey, propName)
          }
        } else {
          propName
        };
        
        for (var i = 0; i < structInfo.fields.length; i += 1) {
          if (structInfo.fields[i].name != null && (structInfo.fields[i].name as String) == lookupName) {
             fieldIndex = i;
          }
        }

        // Private members are lexical, never virtual: write the field
        // when the struct carries it, else DIRECT-call the lexically
        // resolved private setter (mixin scope key first, then the
        // lexical chain incl. generic sources). No vtable, no
        // override machinery.
        if (propName.length > 0 && propName.sliceBytes(0, 1) == "#") {
          if (fieldIndex != -1) {
            genExpr(memExpr.object, false);
            ctx.emitter.emitRefCast(structInfo.index);
            genExpr(assign.value, false);
            if (!discardValue) {
              let valType = typeToValType(ctx.wasm, getNodeType(ctx, assign.value) as Type);
              let tempLocal = ctx.allocLocal(valType);
              ctx.emitter.emitLocalTee(tempLocal);
              ctx.emitter.emitStructSet(structInfo.index, fieldIndex);
              ctx.emitter.emitLocalGet(tempLocal);
            } else {
              ctx.emitter.emitStructSet(structInfo.index, fieldIndex);
            }
            return;
          }
          let privSetterName = "set#" + propName;
          var privSetter: WasmFunction | null = null;
          let privScope = ctx.wasmFunction.privateScopeKey;
          if (privScope != null) {
            let scopedName = (privScope as String) + "::" + privSetterName;
            var applied: ClassType | null = ct;
            while (applied != null) {
              let key = getClassMethodKey(getClassKey(applied), scopedName);
              if (let (true, f) = ctx.wasm.classMethodMap.get(key)) {
                privSetter = f;
                break;
              }
              applied = applied.superType;
            }
          }
          if (privSetter == null) {
            var lexical: ClassType | null = ct;
            while (lexical != null) {
              var candidate: ClassType | null = lexical;
              while (candidate != null) {
                let key = getClassMethodKey(getClassKey(candidate), privSetterName);
                if (let (true, f) = ctx.wasm.classMethodMap.get(key)) {
                  privSetter = f;
                  break;
                }
                candidate = candidate.genericSource;
              }
              if (privSetter != null) {
                break;
              }
              lexical = lexical.superType;
            }
          }
          if (privSetter == null) {
            throw new Error("Could not find private member " + propName + " or setter on class " + ct.name);
          }
          genExpr(memExpr.object, false);
          genExpr(assign.value, false);
          if (!discardValue) {
            let valType = typeToValType(ctx.wasm, getNodeType(ctx, assign.value) as Type);
            let tempLocal = ctx.allocLocal(valType);
            ctx.emitter.emitLocalTee(tempLocal);
            ctx.emitter.emitCall(privSetter as WasmFunction);
            ctx.emitter.emitLocalGet(tempLocal);
          } else {
            ctx.emitter.emitCall(privSetter as WasmFunction);
          }
          return;
        }

        let setterName = "set#" + propName;
        var vtableIndex = -1;
        for (var i = 0; i < vtableStruct.fields.length; i += 1) {
          if (vtableStruct.fields[i].name != null && (vtableStruct.fields[i].name as String) == setterName) {
            vtableIndex = i;
          }
        }

        var fieldDeclaringClass = ct;
        var curr: ClassType | null = ct;
        while (curr != null) {
          if (curr.members.has(propName) && curr.members[propName] is FieldInfo) {
            fieldDeclaringClass = curr;
          }
          curr = curr.superType;
        }

        let defaultSetterKey = getClassMethodKey(getClassKey(fieldDeclaringClass), setterName);
        var defaultSetter: WasmFunction | null = null;
        if (ctx.wasm.classMethodMap.has(defaultSetterKey)) {
          defaultSetter = ctx.wasm.classMethodMap[defaultSetterKey];
        }

        var foundFunc: WasmFunction | null = null;
        var currClass: ClassType | null = ct;
        while (currClass != null && foundFunc == null) {
          let key = getClassMethodKey(getClassKey(currClass as ClassType), setterName);
          if (ctx.wasm.classMethodMap.has(key)) {
            foundFunc = ctx.wasm.classMethodMap[key];
          }
          currClass = (currClass as ClassType).superType;
        }

        let resolvedSetter = foundFunc;
        var hasOverride = false;
        if (resolvedSetter != null && defaultSetter != null && resolvedSetter != defaultSetter) {
          hasOverride = true;
        }

        if (!hasOverride) {
          if (classInfoOpt != null) {
            let subclasses = new Array<ClassCodegenInfo>();
            (classInfoOpt as ClassCodegenInfo).getTransitiveSubclasses(subclasses);
            for (let sub in subclasses) {
              var subFunc: WasmFunction | null = null;
              var subCurr: ClassType | null = sub.structType.classType;
              while (subCurr != null && subFunc == null) {
                let subKey = getClassMethodKey(getClassKey(subCurr as ClassType), setterName);
                if (ctx.wasm.classMethodMap.has(subKey)) {
                  subFunc = ctx.wasm.classMethodMap[subKey];
                }
                subCurr = (subCurr as ClassType).superType;
              }
              if (subFunc != null && subFunc != resolvedSetter) {
                hasOverride = true;
                break;
              }
            }
          }
        }

        if (fieldIndex != -1 && !hasOverride && !(memExpr.object is SuperExpression)) {
          // Evaluate object first (the struct reference we're setting on)
          genExpr(memExpr.object, false);
          ctx.emitter.emitRefCast(structInfo.index);
          
          // Then evaluate the value to assign
          genExpr(assign.value, false);
          
          if (!discardValue) {
            let valType = typeToValType(ctx.wasm, getNodeType(ctx, assign.value) as Type);
            let tempLocal = ctx.allocLocal(valType);
            ctx.emitter.emitLocalTee(tempLocal);
            ctx.emitter.emitStructSet(structInfo.index, fieldIndex);
            ctx.emitter.emitLocalGet(tempLocal);
            let assignNodeType = getNodeType(ctx, assign);
            let expectedValType = if (assignNodeType != null) typeToValType(ctx.wasm, assignNodeType as Type) else valType;
            if (!isWasmSubtype(valType, expectedValType)) {
              match (expectedValType) {
                case ValTypeRef: { ctx.emitter.emitRefAsNonNull(); }
                case _: {}
              }
            }
          } else {
            ctx.emitter.emitStructSet(structInfo.index, fieldIndex);
          }
          return;
        }
        
        if (vtableIndex != -1) {
          let valType = typeToValType(ctx.wasm, getNodeType(ctx, assign.value) as Type);
          var tempLocal = -1;
          if (!discardValue) {
            tempLocal = ctx.allocLocal(valType);
          }

          if (memExpr.object is SuperExpression) {
            var superFunc: WasmFunction | null = null;
            var currClass: ClassType | null = ct; // ct is already the superclass (the type of SuperExpression)
            while (currClass != null && superFunc == null) {
              let key = getClassMethodKey(getClassKey(currClass as ClassType), setterName);
              if (ctx.wasm.classMethodMap.has(key)) {
                superFunc = ctx.wasm.classMethodMap[key];
              }
              currClass = (currClass as ClassType).superType;
            }

            if (superFunc == null) {
              throw new Error("Could not find superclass setter implementation for " + setterName);
            }

            ctx.emitter.emitLocalGet(0);
            genExpr(assign.value, false);
            if (!discardValue) {
              ctx.emitter.emitLocalTee(tempLocal);
            }
            
            ctx.emitter.emitCall(superFunc as WasmFunction);
            if (!discardValue) {
              ctx.emitter.emitLocalGet(tempLocal);
            }
            return;
          } else {
            genExpr(memExpr.object, false);
            var scratchLocal = ctx.getStructScratchLocal(structInfo);
            ctx.emitter.emitLocalTee(scratchLocal);

            genExpr(assign.value, false);
            if (!discardValue) {
              ctx.emitter.emitLocalTee(tempLocal);
            }

            ctx.emitter.emitLocalGet(scratchLocal);
            ctx.emitter.emitRefCast(structInfo.index);
            ctx.emitter.emitStructGet(structInfo.index, 0); // VTable is at index 0
            ctx.emitter.emitRefCast(vtableStruct.index);
            ctx.emitter.emitStructGet(vtableStruct.index, vtableIndex);

            let sig = getClassMemberSignature(ctx.wasm, rawCt, setterName);
            ctx.emitter.emitRefCast(sig.index);
            ctx.emitter.emitCallRef(sig.index);

            if (!discardValue) {
              ctx.emitter.emitLocalGet(tempLocal);
            }
            return;
          }
        }
        
        if (fieldIndex == -1) {
          throw new Error("Could not find property " + propName + " or virtual setter " + setterName + " on class " + ct.name);
        }
        
        // Evaluate object first (the struct reference we're setting on)
        genExpr(memExpr.object, false);
        ctx.emitter.emitRefCast(structInfo.index);
        
        // Then evaluate the value to assign
        genExpr(assign.value, false);
        
        if (!discardValue) {
          let valType = typeToValType(ctx.wasm, getNodeType(ctx, assign.value) as Type);
          let tempLocal = ctx.allocLocal(valType);
          ctx.emitter.emitLocalTee(tempLocal);
          ctx.emitter.emitStructSet(structInfo.index, fieldIndex);
          ctx.emitter.emitLocalGet(tempLocal);
        } else {
          ctx.emitter.emitStructSet(structInfo.index, fieldIndex);
        }
        return;
      }
      case InterfaceType as it: {
        let iName = getInterfaceKey(it);
        let vst = ctx.wasm.interfaceVTableStructs[iName];
        let fatPtr = ctx.wasm.interfaceStructs[iName];
        
        let propName = getMemberPropertyName(memExpr.isSymbolAccess, memExpr.property.name);
        let setterName = "set#" + propName;
        
        var vtableIndex = -1;
        for (var i = 0; i < vst.fields.length; i += 1) {
          if (vst.fields[i].name != null && (vst.fields[i].name as String) == setterName) {
            vtableIndex = i;
          }
        }
        
        if (vtableIndex == -1) {
          throw new Error("Property setter not found in interface vtable: " + setterName);
        }
        
        let valType = typeToValType(ctx.wasm, getNodeType(ctx, assign.value) as Type);
        var tempLocal = -1;
        if (!discardValue) {
          tempLocal = ctx.allocLocal(valType);
        }
        
        genExpr(memExpr.object, false);
        var scratchLocal = ctx.getStructScratchLocal(fatPtr);
        ctx.emitter.emitLocalSet(scratchLocal);
        
        ctx.emitter.emitLocalGet(scratchLocal);
        ctx.emitter.emitStructGet(fatPtr.index, 0); // Get Instance
        
        genExpr(assign.value, false);
        if (!discardValue) {
          ctx.emitter.emitLocalTee(tempLocal);
        }
        
        ctx.emitter.emitLocalGet(scratchLocal);
        ctx.emitter.emitStructGet(fatPtr.index, 1); // Get VTable
        ctx.emitter.emitStructGet(vst.index, vtableIndex);
        
        let sig = getInterfaceMemberSignature(ctx.wasm, it, setterName);
        ctx.emitter.emitCallRef(sig.index);
        
        if (!discardValue) {
          ctx.emitter.emitLocalGet(tempLocal);
        }
        return;
      }
      case _: {
        throw new Error("Assigning to non-class member is not yet implemented.");
      }
    }
  } else if (assign.left is IndexExpression) {
    let indexExpr = assign.left as IndexExpression;
    let objectType = getNodeType(ctx, indexExpr.object) as Type;
    
    match (objectType) {
      case InterfaceType as it: {
        let iName = getInterfaceKey(it);
        let vst = ctx.wasm.interfaceVTableStructs[iName];
        let fatPtr = ctx.wasm.interfaceStructs[iName];
        
        let targetName = "[]=";
        
        var methodIndex = -1;
        for (var i = 0; i < vst.fields.length; i += 1) {
          if (vst.fields[i].name != null && (vst.fields[i].name as String) == targetName) {
            methodIndex = i;
          }
        }
        
        if (methodIndex == -1) {
          throw new Error("Method []= not found in interface vtable of " + it.name);
        }
        
        let valType = typeToValType(ctx.wasm, getNodeType(ctx, assign.value) as Type);
        var tempLocal = -1;
        if (!discardValue) {
          tempLocal = ctx.allocLocal(valType);
        }
        
        genExpr(indexExpr.object, false);
        var scratchLocal = ctx.getStructScratchLocal(fatPtr);
        ctx.emitter.emitLocalSet(scratchLocal);
        
        ctx.emitter.emitLocalGet(scratchLocal);
        ctx.emitter.emitStructGet(fatPtr.index, 0); // Get Instance
        
        genExpr(indexExpr.index, false); // Evaluate index argument
        
        genExpr(assign.value, false); // Evaluate assigned value
        if (!discardValue) {
          ctx.emitter.emitLocalTee(tempLocal);
        }
        
        ctx.emitter.emitLocalGet(scratchLocal);
        ctx.emitter.emitStructGet(fatPtr.index, 1); // Get VTable
        ctx.emitter.emitStructGet(vst.index, methodIndex);
        
        let sig = getInterfaceMemberSignature(ctx.wasm, it, targetName);
        ctx.emitter.emitCallRef(sig.index);
        
        if (!discardValue) {
          ctx.emitter.emitLocalGet(tempLocal);
        }
        return;
      }
      case _: {
        var foundFunc: WasmFunction | null = null;
        match (objectType) {
          case ClassType as ctVar: {
            let ct = if (ctVar.name.length >= 5 && ctVar.name.sliceBytes(ctVar.name.length - 5, ctVar.name.length) == "_This") {
              ctx.wasmFunction.classType as ClassType
            } else {
              ctVar
            };
            let indexType = getNodeType(ctx, indexExpr.index) as Type;
            let valType = getNodeType(ctx, assign.value) as Type;
            let params = new Array<Type>();
            params.push(indexType);
            params.push(valType);
            let dummyFuncType = new FunctionType(params, null, new VoidType());
            let lookupName = "[]=" + getSignatureKey(dummyFuncType);

            var currClass: ClassType | null = ct;
            while (currClass != null && foundFunc == null) {
              let classKey = getClassKey(currClass as ClassType);
              let keyWithSig = getClassMethodKey(classKey, lookupName);
              let keyWithoutSig = getClassMethodKey(classKey, "[]=");
              
              if (ctx.wasm.classMethodMap.has(keyWithSig)) {
                let f = ctx.wasm.classMethodMap[keyWithSig];
                if (f.intrinsic != null) {
                  foundFunc = f;
                }
              }
              if (foundFunc == null && ctx.wasm.classMethodMap.has(keyWithoutSig)) {
                let f = ctx.wasm.classMethodMap[keyWithoutSig];
                if (f.intrinsic != null) {
                  foundFunc = f;
                }
              }
              if (foundFunc == null) {
                if (ctx.wasm.classMethodMap.has(keyWithSig)) {
                  foundFunc = ctx.wasm.classMethodMap[keyWithSig];
                } else if (ctx.wasm.classMethodMap.has(keyWithoutSig)) {
                  foundFunc = ctx.wasm.classMethodMap[keyWithoutSig];
                }
              }
              currClass = (currClass as ClassType).superType;
            }
          }
          case ArrayType as at: {}
          case _: {}
        }

        var isArraySet = false;
        var isStoreIntr = false;
        var storeIntrName = "";
        if (foundFunc != null) {
          if ((foundFunc as WasmFunction).intrinsic != null) {
            let intr = (foundFunc as WasmFunction).intrinsic as String;
            if (intr == "array.set") {
              isArraySet = true;
            } else if (intr == "i32.store8" || intr == "i32.store" || intr == "i64.store" || intr == "f32.store" || intr == "f64.store") {
              isStoreIntr = true;
              storeIntrName = intr;
            } else {
              throw new Error("Unsupported index intrinsic assignment operator: " + intr);
            }
          }
        } else if (isArrayType(objectType)) {
          isArraySet = true;
        }

        if (isStoreIntr) {
          let elementValType = typeToValType(ctx.wasm, getNodeType(ctx, assign.value) as Type);
          var tempLocal = -1;
          if (!discardValue) {
            tempLocal = ctx.allocLocal(elementValType);
          }

          genExpr(indexExpr.index, false);
          genExpr(assign.value, false);

          if (!discardValue) {
            ctx.emitter.emitLocalTee(tempLocal);
          }

          if (storeIntrName == "i32.store8") {
            ctx.emitter.emitI32Store8(0, 0);
          } else if (storeIntrName == "i32.store") {
            ctx.emitter.emitI32Store(0, 0);
          } else if (storeIntrName == "i64.store") {
            ctx.emitter.emitI64Store(0, 0);
          } else if (storeIntrName == "f32.store") {
            ctx.emitter.emitF32Store(0, 0);
          } else if (storeIntrName == "f64.store") {
            ctx.emitter.emitF64Store(0, 0);
          } else {
            throw new Error("Unsupported store intrinsic: " + storeIntrName);
          }

          if (!discardValue) {
            ctx.emitter.emitLocalGet(tempLocal);
          }
          return;
        }

        if (isArraySet) {
          let valType = typeToValType(ctx.wasm, objectType);
          let wasmArray = match (valType) {
            case ValTypeRefNull as refNull: {
              refNull.target as WasmArray
            }
            case ValTypeRef as ref: {
              ref.target as WasmArray
            }
            case _: {
              throw new Error("Expected array type for IndexExpression assignment");
            }
          };

          let elementValType = typeToValType(ctx.wasm, getNodeType(ctx, assign.value) as Type);
          var tempLocal = -1;
          if (!discardValue) {
            tempLocal = ctx.allocLocal(elementValType);
          }

          genExpr(indexExpr.object, false);
          genExpr(indexExpr.index, false);
          genExpr(assign.value, false);

          if (!discardValue) {
            ctx.emitter.emitLocalTee(tempLocal);
          }

          ctx.emitter.emitArraySet(wasmArray.index);

          if (!discardValue) {
            ctx.emitter.emitLocalGet(tempLocal);
          }
          return;
        }

        if (foundFunc != null) {
          let f = foundFunc as WasmFunction;
          let ct = f.classType as ClassType;
          
          let valType = typeToValType(ctx.wasm, getNodeType(ctx, assign.value) as Type);
          var tempLocal = -1;
          if (!discardValue) {
            tempLocal = ctx.allocLocal(valType);
          }

          let objType = getNodeType(ctx, indexExpr.object) as Type;
          let objWasmType = typeToValTypeWithSub(ctx.wasm, objType, ctx.wasmFunction);
          let indexType = getNodeType(ctx, indexExpr.index) as Type;
          let indexWasmType = typeToValTypeWithSub(ctx.wasm, indexType, ctx.wasmFunction);
          let valueType = getNodeType(ctx, assign.value) as Type;
          let valueWasmType = typeToValTypeWithSub(ctx.wasm, valueType, ctx.wasmFunction);

          if (ct.isExtension) {
            genExpr(indexExpr.object, false);
            castValTypeRefNullIfNeeded(ctx, objWasmType, f.signature.params[0]);
            
            genExpr(indexExpr.index, false);
            castValTypeRefNullIfNeeded(ctx, indexWasmType, f.signature.params[1]);
            
            genExpr(assign.value, false);
            castValTypeRefNullIfNeeded(ctx, valueWasmType, f.signature.params[2]);
            
            if (!discardValue) {
              ctx.emitter.emitLocalTee(tempLocal);
              let localValType = match (valType) {
                case ValTypeRef as r: new ValTypeRefNull(r.target) as ValType
                case _: valType
              };
              castValTypeRefNullIfNeeded(ctx, localValType, f.signature.params[2]);
            }
            ctx.emitter.emitCall(f);
            if (!discardValue) {
              ctx.emitter.emitLocalGet(tempLocal);
              castValTypeRefNullIfNeeded(ctx, valType, valType); // wait, not needed but keep simple
            }
            return;
          } else {
            let ctKey = getClassKey(ct);
            var structInfoOpt: WasmStruct | null = null;
            var vtableStructOpt: WasmStruct | null = null;
            if (let (true, info) = ctx.wasm.classInfos.get(ctKey)) {
              structInfoOpt = info.structType;
              vtableStructOpt = info.vtableStructType;
            }
            if (structInfoOpt == null) {
              throw new Error("Class struct not found for: " + ct.name + " key: " + (ctKey as String));
            }
            if (vtableStructOpt == null) {
              throw new Error("Class VTable struct not found for: " + ct.name + " key: " + (ctKey as String));
            }
            let structInfo = structInfoOpt as WasmStruct;
            let vtableStruct = vtableStructOpt as WasmStruct;
            let lookupName = f.methodName as String;
            
            var methodIndex = -1;
            for (var i = 0; i < vtableStruct.fields.length; i += 1) {
              if (vtableStruct.fields[i].name != null && (vtableStruct.fields[i].name as String) == lookupName) {
                methodIndex = i;
              }
            }
            if (methodIndex == -1) {
              throw new Error("Method not found in vtable: " + lookupName);
            }
            
            genExpr(indexExpr.object, false);
            castValTypeRefNullIfNeeded(ctx, objWasmType, f.signature.params[0]);
            var scratchLocal = ctx.getStructScratchLocal(structInfo);
            ctx.emitter.emitLocalTee(scratchLocal);
            
            genExpr(indexExpr.index, false);
            castValTypeRefNullIfNeeded(ctx, indexWasmType, f.signature.params[1]);
            
            genExpr(assign.value, false);
            castValTypeRefNullIfNeeded(ctx, valueWasmType, f.signature.params[2]);
            
            if (!discardValue) {
              ctx.emitter.emitLocalTee(tempLocal);
              let localValType = match (valType) {
                case ValTypeRef as r: new ValTypeRefNull(r.target) as ValType
                case _: valType
              };
              castValTypeRefNullIfNeeded(ctx, localValType, f.signature.params[2]);
            }
            
            ctx.emitter.emitLocalGet(scratchLocal);
            ctx.emitter.emitRefCast(structInfo.index);
            ctx.emitter.emitStructGet(structInfo.index, 0);
            ctx.emitter.emitRefCast(vtableStruct.index);
            ctx.emitter.emitStructGet(vtableStruct.index, methodIndex);
            
            ctx.emitter.emitRefCast(f.signature.index);
            ctx.emitter.emitCallRef(f.signature.index);
            
            if (!discardValue) {
              ctx.emitter.emitLocalGet(tempLocal);
            }
            return;
          }
        }

        throw new Error("Codegen for IndexExpression assignment on non-array is not yet implemented. Object type: " + typeToString(objectType));
      }
    }
  } else {
    throw new Error("Unsupported assignment target");
  }
};
