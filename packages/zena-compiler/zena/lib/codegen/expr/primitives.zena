import { Node, Identifier, NumberLiteral, BooleanLiteral, StringLiteral, ImportSpecifier, TemplateLiteral, Expression, TaggedTemplateExpression } from '../../ast.zena';
import { Type, F64Type, F32Type, I32Type, baseType, typeToString, ClassType, I64Type, U64Type, U32Type, BooleanType, AnyType, ArrayType, FunctionType, VoidType } from '../../types.zena';
import { SymbolId, Symbol } from '../../scope/symbol.zena';
import { parseI32, parseF64, i32ToString, parseI64 } from 'zena:string-convert';
import { FunctionContext } from '../function-context.zena';
import { Error } from 'zena:error';
import { WasmStruct, WasmFunction, WasmGlobal, WasmSignature, WasmArray } from '../wasm-module.zena';
import { typeToValType, typeToValTypeWithSub, getCellStruct, getClosureStruct, mapReturnTypeToWasmResults, getValTypeKey, substituteTypeParamsInClassContext } from '../type-mapping.zena';
import { ValTypeRefNull, HeapType, heapTypeToSigned, ValTypeVoid, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeRef, ValType, ValTypeEqRef, ValTypeStructRef, valTypeEquals } from '../wasm.zena';
import { ClassKey, ExportGlobalKey, ExportKey, getClassKey, getSpecializedName, getSignatureKey, ClassMethodKey, getClassMethodKey, FunctionValueWrapperKey, getFunctionValueWrapperKey } from '../codegen-utils.zena';
import { String } from 'zena:string';

// TODO: Consider moving `generateIdentifier` to a dedicated file (e.g.,
// `bindings.zena` or `variables.zena`). While it is parsed as a primary
// expression along with literals, its code generation handles scope resolution,
// locals, and globals, which is semantically distinct from emitting static
// primitives.
let castIdentifierIfNeeded = (ctx: FunctionContext, ident: Identifier, resolvedSym: Symbol): void => {
  let unionCalleeType = ctx.wasmFunction.model.getUnionCallCalleeType(ident);
  if (unionCalleeType != null) {
    return;
  }
  let symType = ctx.wasmFunction.model.getBindingType(resolvedSym);
  let nodeType = ctx.wasmFunction.model.getNodeType(ident);
  if (symType != null && nodeType != null) {
    let initWasmType = typeToValTypeWithSub(ctx.wasm, symType as Type, ctx.wasmFunction);
    let targetWasmType = typeToValTypeWithSub(ctx.wasm, nodeType as Type, ctx.wasmFunction);
    let isTargetRef = match (targetWasmType) {
      case ValTypeRef: true
      case ValTypeRefNull: true
      case ValTypeStructRef: true
      case _: false
    };
    if (isTargetRef && !valTypeEquals(initWasmType, targetWasmType)) {
      let targetIdx = match (targetWasmType) {
        case ValTypeRefNull as trn: trn.target.index
        case ValTypeRef as tr: tr.target.index
        case ValTypeStructRef: heapTypeToSigned(HeapType.struct)
        case _: -1
      };
      if (targetIdx != -1) {
        ctx.emitter.emitRefCastNull(targetIdx);
      }
    }
  }
};

export let generateIdentifier = (ctx: FunctionContext, ident: Identifier): void => {
  let sym = ctx.wasmFunction.model.resolve(ident);
  var resolvedSym: Symbol | null = null;
  if (sym != null) {
    resolvedSym = (sym as Symbol).resolveTarget();
    let rSym = resolvedSym as Symbol;
    if (ctx.localIndices.has(rSym.id)) {
      ctx.emitter.emitLocalGet(ctx.localIndices[rSym.id]);
      if (ctx.isCelled(rSym.id)) {
        let symType = ctx.wasmFunction.model.getBindingType(rSym);
        let valType = typeToValType(ctx.wasm, symType as Type);
        let cellStruct = getCellStruct(ctx.wasm, valType);
        ctx.emitter.emitStructGet(cellStruct.index, 0);
      }
      castIdentifierIfNeeded(ctx, ident, rSym);
      return;
    }
    if (ctx.wasm.globalMap.has(rSym.id)) {
      ctx.emitter.emitGlobalGet(ctx.wasm.globalMap[rSym.id].index);
      castIdentifierIfNeeded(ctx, ident, rSym);
      return;
    }
    let exportKey = rSym.name as ExportGlobalKey;
    if (ctx.wasm.exportGlobalMap.has(exportKey)) {
      ctx.emitter.emitGlobalGet(ctx.wasm.exportGlobalMap[exportKey].index);
      castIdentifierIfNeeded(ctx, ident, rSym);
      return;
    }
    
    // Check if the identifier is a function referenced as a value
    var nodeType = ctx.wasmFunction.model.getNodeType(ident);
    if (nodeType != null) {
      nodeType = substituteTypeParamsInClassContext(ctx.wasmFunction.classType, nodeType as Type);
    }
    if (nodeType != null && nodeType is FunctionType) {
      let ft = nodeType as FunctionType;
      let isSpecialized = ft.typeArguments != null && (ft.typeArguments as Array<Type>).length > 0;
      var keyName = "";
      if (isSpecialized) {
        keyName = getSpecializedName(ident.name, ft.typeArguments as Array<Type>);
      } else {
        keyName = i32ToString(rSym.id as i32);
      }
      
      let wrapperParams = new Array<ValType>();
      wrapperParams.push(new ValTypeStructRef()); // context
      for (let p in ft.parameters) {
        wrapperParams.push(typeToValType(ctx.wasm, p));
      }
      let wrapperReturns = new Array<ValType>();
      if (!(ft.returnType is VoidType)) {
        wrapperReturns.push(typeToValType(ctx.wasm, ft.returnType));
      }
      let sig = ctx.wasm.getSignature(wrapperParams, wrapperReturns);
      
      let wrapperKey = getFunctionValueWrapperKey(keyName, ft);
      if (ctx.wasm.functionValueWrappers.has(wrapperKey)) {
        let wrapperFunc = ctx.wasm.functionValueWrappers[wrapperKey];
        let closureStruct = getClosureStruct(ctx.wasm, ft);
        
        ctx.emitter.emitRefFunc(wrapperFunc.index);
        ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.none));
        ctx.emitter.emitStructNew(closureStruct.index);
        return;
      }
    }
  }
  throw new Error("Could not resolve identifier: " + ident.name);
};



export let parseI64OrU64Literal = (raw: String): inline (boolean, i64) => {
  if (raw.length == 0) return (false, 0 as i64);
  
  var isNeg = false;
  var start = 0;
  let first = raw.getByteAt(0);
  if (first == 45) { // '-'
    isNeg = true;
    start = 1;
  } else if (first == 43) { // '+'
    start = 1;
  }
  
  var isHex = false;
  if (start + 2 <= raw.length) {
    let c0 = raw.getByteAt(start);
    let c1 = raw.getByteAt(start + 1);
    if (c0 == 48 && (c1 == 120 || c1 == 88)) { // '0' and ('x' or 'X')
      isHex = true;
      start = start + 2;
    }
  }
  
  var res: u64 = 0 as u64;
  let ten = 10 as u64;
  let sixteen = 16 as u64;
  
  var i = start;
  var hasDigits = false;
  while (i < raw.length) {
    let code = raw.getByteAt(i);
    if (code == 95) { // '_'
      i += 1;
      continue;
    }
    var digit = 0 as u64;
    if (code >= 48 && code <= 57) { // '0'..'9'
      digit = (code - 48) as u64;
    } else if (isHex && code >= 97 && code <= 102) { // 'a'..'f'
      digit = (code - 97 + 10) as u64;
    } else if (isHex && code >= 65 && code <= 70) { // 'A'..'F'
      digit = (code - 65 + 10) as u64;
    } else {
      return (false, 0 as i64);
    }
    let base = if (isHex) sixteen else ten;
    res = res * base + digit;
    hasDigits = true;
    i += 1;
  }
  
  if (!hasDigits) return (false, 0 as i64);
  
  let finalVal = if (isNeg) (0 as i64) - (res as i64) else res as i64;
  return (true, finalVal);
};

export let generateNumberLiteral = (ctx: FunctionContext, expr: NumberLiteral): void => {
  let nodeType = ctx.wasmFunction.model.getNodeType(expr as Node);
  let baseT = baseType(nodeType as Type);

  if (baseT is F64Type) {
    let val = parseF64(expr.raw);
    ctx.emitter.emitF64Const(val);
  } else if (baseT is F32Type) {
    let val = parseF64(expr.raw);
    ctx.emitter.emitF32Const(val);
  } else if (baseT is I64Type || baseT is U64Type) {
    if (let (true, val) = parseI64OrU64Literal(expr.raw)) {
      ctx.emitter.emitI64Const(val);
    } else {
      ctx.emitter.emitI64Const(0 as i64);
    }
  } else {
    // Treat all other numeric types (i32, u32, i8, etc) as 32-bit integers in Wasm for now
    if (let (true, val) = parseI64OrU64Literal(expr.raw)) {
      ctx.emitter.emitI32Const(val as i32);
    } else {
      ctx.emitter.emitI32Const(0);
    }
  }
};

export let generateBooleanLiteral = (ctx: FunctionContext, expr: BooleanLiteral): void => {
  ctx.emitter.emitBooleanConst(expr.value);
};

export let generateStringLiteral = (ctx: FunctionContext, expr: StringLiteral): void => {
  if (ctx.wasm.stringLiteralIds.has(expr.value)) {
    let id = ctx.wasm.stringLiteralIds[expr.value];
    ctx.emitter.emitI32Const(id);
    ctx.emitter.emitCall(ctx.wasm.getStringLiteralFunc as WasmFunction);
    return;
  }

  let stringClass = ctx.wasm.stringClass;
  if (stringClass == null) {
    throw new Error("String class struct not found during string literal generation!");
  }
  let stringKey = getClassKey(stringClass as ClassType);
  var structTypeOpt: WasmStruct | null = null;
  var vtableGlobal: WasmGlobal | null = null;
  if (let (true, stringInfo) = ctx.wasm.classInfos.get(stringKey)) {
    structTypeOpt = stringInfo.structType;
    vtableGlobal = stringInfo.vtableGlobal;
  }
  if (structTypeOpt == null) {
    throw new Error("String class struct not found during string literal generation!");
  }
  let structType = structTypeOpt as WasmStruct;
  let tempLocal = ctx.allocLocal(new ValTypeRefNull(structType));

  // 1. Allocate String struct with default values
  ctx.emitter.emitStructNewDefault(structType.index);
  ctx.emitter.emitLocalSet(tempLocal);

  // 2. Set vtable (field 0)
  if (vtableGlobal != null) {
    ctx.emitter.emitLocalGet(tempLocal);
    ctx.emitter.emitGlobalGet((vtableGlobal as WasmGlobal).index);
    ctx.emitter.emitStructSet(structType.index, 0); // vtable is field 0
  }

  // 3. Find string field offsets
  var dataFieldIdx = -1;
  var startFieldIdx = -1;
  var endFieldIdx = -1;
  var encodingFieldIdx = -1;
  for (var f = 0; f < structType.fields.length; f += 1) {
    let fieldName = structType.fields[f].name;
    if (fieldName != null) {
      let nameStr = fieldName as String;
      if (nameStr.endsWith("::#data")) {
        dataFieldIdx = f;
      } else if (nameStr.endsWith("::#start")) {
        startFieldIdx = f;
      } else if (nameStr.endsWith("::#end")) {
        endFieldIdx = f;
      } else if (nameStr.endsWith("::#encoding")) {
        encodingFieldIdx = f;
      }
    }
  }
  if (dataFieldIdx == -1 || startFieldIdx == -1 || endFieldIdx == -1 || encodingFieldIdx == -1) {
    throw new Error("String fields not found in struct!");
  }

  // 4. Create the ByteArray from the data segment
  let dataIndex = ctx.wasm.getStringLiteralDataIndex(expr.value);
  let byteArrayType = ctx.wasm.getByteArrayType();
  let byteArrayTypeIndex = byteArrayType.index;
  
  ctx.emitter.emitLocalGet(tempLocal);
  ctx.emitter.emitI32Const(0); // offset
  ctx.emitter.emitI32Const(expr.value.length); // length
  ctx.emitter.emitArrayNewData(byteArrayTypeIndex, dataIndex);
  ctx.emitter.emitStructSet(structType.index, dataFieldIdx);

  // 5. Set #start (index startFieldIdx) to 0
  ctx.emitter.emitLocalGet(tempLocal);
  ctx.emitter.emitI32Const(0);
  ctx.emitter.emitStructSet(structType.index, startFieldIdx);

  // 6. Set #end (index endFieldIdx) to length
  ctx.emitter.emitLocalGet(tempLocal);
  ctx.emitter.emitI32Const(expr.value.length);
  ctx.emitter.emitStructSet(structType.index, endFieldIdx);

  // 7. Set #encoding (index encodingFieldIdx) to 0
  ctx.emitter.emitLocalGet(tempLocal);
  ctx.emitter.emitI32Const(0);
  ctx.emitter.emitStructSet(structType.index, encodingFieldIdx);

  // 8. Return the String instance by getting it to the stack
  ctx.emitter.emitLocalGet(tempLocal);
};

export let generateTemplateLiteral = (
  ctx: FunctionContext,
  expr: TemplateLiteral,
  genExpr: (e: Expression, discardValue: boolean) => void
): void => {
  let totalParts = expr.quasis.length + expr.expressions.length;

  if (totalParts == 0) {
    let dummyLiteral = new StringLiteral("", expr.loc);
    generateStringLiteral(ctx, dummyLiteral);
    return;
  }

  if (expr.expressions.length == 0) {
    let dummyLiteral = new StringLiteral(expr.quasis[0].cooked, expr.loc);
    generateStringLiteral(ctx, dummyLiteral);
    return;
  }

  // 1. Find String type representation and the fromParts function
  let stringClass = ctx.wasm.stringClass;
  if (stringClass == null) {
    throw new Error("String class struct not found during template literal generation!");
  }
  let stringKey = getClassKey(stringClass as ClassType);
  var stringStructOpt: WasmStruct | null = null;
  if (let (true, info) = ctx.wasm.classInfos.get(stringKey)) {
    stringStructOpt = info.structType;
  }
  if (stringStructOpt == null) {
    throw new Error("String class struct not found during template literal generation!");
  }
  let stringStruct = stringStructOpt as WasmStruct;
  let stringWasmType = new ValTypeRefNull(stringStruct);

  var fromPartsFunc: WasmFunction | null = null;
  let fromPartsKey = getClassMethodKey(getClassKey(ctx.wasm.stringClass as ClassType), "fromParts");
  if (ctx.wasm.classMethodMap.has(fromPartsKey)) {
    fromPartsFunc = ctx.wasm.classMethodMap[fromPartsKey];
  }
  if (fromPartsFunc == null) {
    throw new Error("String.fromParts not found in Wasm functions!");
  }

  // 2. Generate and push all parts on the stack
  var i = 0;
  while (i < expr.expressions.length) {
    // Push quasi[i]
    let quasiLit = new StringLiteral(expr.quasis[i].cooked, expr.quasis[i].loc);
    generateStringLiteral(ctx, quasiLit);

    // Push expression[i] (and convert to string if primitive)
    let subExpr = expr.expressions[i];
    genExpr(subExpr, false);

    let exprType = ctx.wasmFunction.model.getNodeType(subExpr);
    if (exprType != null) {
      let baseT = baseType(exprType as Type);
      if (baseT is I32Type || baseT is U32Type || baseT is I64Type || baseT is U64Type || baseT is F32Type || baseT is F64Type || baseT is BooleanType) {
        let helperName = match (baseT) {
          case I32Type: "i32ToString"
          case U32Type: "u32ToString"
          case I64Type: "i64ToString"
          case U64Type: "u64ToString"
          case F32Type: "f32ToString"
          case F64Type: "f64ToString"
          case BooleanType: "boolToString"
        };
        if (helperName != "") {
          let helperFunc = ctx.wasm.getStdlibFunc("zena:string-convert", helperName);
          if (helperFunc != null) {
            ctx.emitter.emitCall(helperFunc as WasmFunction);
          } else {
            throw new Error(helperName + " helper function not found in Wasm module!");
          }
        }
      } else if (baseT is ClassType && (baseT as ClassType).name == "String") {
        // Already a string, do nothing
      } else {
        throw new Error("Unsupported type in template literal expression conversion: " + typeToString(baseT));
      }
    }
    i += 1;
  }

  // Push final quasi
  let lastQuasiLit = new StringLiteral(expr.quasis[expr.quasis.length - 1].cooked, expr.quasis[expr.quasis.length - 1].loc);
  generateStringLiteral(ctx, lastQuasiLit);

  // 3. Create the array<String> with all parts and call String.fromParts
  if (totalParts >= 2 && totalParts <= 5) {
    let concatName = "__concat" + i32ToString(totalParts);
    let concatFunc = ctx.wasm.getStdlibFunc("zena:string", concatName);
    if (concatFunc != null) {
      ctx.emitter.emitCall(concatFunc as WasmFunction);
      return;
    }
  }
  let wasmArrayType = ctx.wasm.getArray(stringWasmType, true);
  ctx.emitter.emitArrayNewFixed(wasmArrayType.index, totalParts);
  ctx.emitter.emitCall(fromPartsFunc as WasmFunction);
};

export let generateTaggedTemplateExpression = (
  ctx: FunctionContext,
  expr: TaggedTemplateExpression,
  genExpr: (e: Expression, discardValue: boolean) => void
): void => {
  // 1. Identify TemplateStringsArray struct
  let tsaClass = ctx.wasm.templateStringsArrayClass;
  if (tsaClass == null) {
    throw new Error("TemplateStringsArray class struct not found during tagged template literal generation!");
  }
  let tsaKey = getClassKey(tsaClass as ClassType);
  var tsaStructOpt: WasmStruct | null = null;
  var tsaVtableGlobalOpt: WasmGlobal | null = null;
  if (let (true, tsaInfo) = ctx.wasm.classInfos.get(tsaKey)) {
    tsaStructOpt = tsaInfo.structType;
    tsaVtableGlobalOpt = tsaInfo.vtableGlobal;
  }
  if (tsaStructOpt == null) {
    throw new Error("TemplateStringsArray class struct not found during tagged template literal generation!");
  }
  let tsaStruct = tsaStructOpt as WasmStruct;
  let tsaVtableGlobal = tsaVtableGlobalOpt;

  // 2. Identify String class struct
  let stringClass = ctx.wasm.stringClass;
  if (stringClass == null) {
    throw new Error("String class struct not found during tagged template literal generation!");
  }
  let stringKey = getClassKey(stringClass as ClassType);
  var stringStructOpt: WasmStruct | null = null;
  if (let (true, stringInfo) = ctx.wasm.classInfos.get(stringKey)) {
    stringStructOpt = stringInfo.structType;
  }
  if (stringStructOpt == null) {
    throw new Error("String class struct not found during tagged template literal generation!");
  }
  let stringStruct = stringStructOpt as WasmStruct;
  let stringWasmType = new ValTypeRefNull(stringStruct);
  let wasmArrayType = ctx.wasm.getArray(stringWasmType, true);
  let stringsArrayTypeIndex = wasmArrayType.index;

  // 3. Find TemplateStringsArray field indexes
  var stringsFieldIdx = -1;
  var rawFieldIdx = -1;
  for (var f = 0; f < tsaStruct.fields.length; f += 1) {
    let fieldName = tsaStruct.fields[f].name;
    if (fieldName != null) {
      let nameStr = fieldName as String;
      if (nameStr.endsWith("::#strings")) {
        stringsFieldIdx = f;
      } else if (nameStr.endsWith("::#raw")) {
        rawFieldIdx = f;
      }
    }
  }
  if (stringsFieldIdx == -1 || rawFieldIdx == -1) {
    throw new Error("TemplateStringsArray private fields (#strings, #raw) not found in struct!");
  }

  // 4. Retrieve the pre-registered global cache variable
  if (!ctx.wasm.templateLiteralGlobals.has(expr)) {
    throw new Error("TemplateStringsArray global cache variable not registered during discovery pass!");
  }
  let wasmGlobal = ctx.wasm.templateLiteralGlobals[expr];

  // 5. Emit lazy initialization logic
  ctx.emitter.emitGlobalGet(wasmGlobal.index);
  ctx.emitter.emitRefIsNull();
  ctx.emitter.emitIf(new ValTypeVoid());

  // Cooked strings
  for (let quasi in expr.quasi.quasis) {
    let quasiLit = new StringLiteral(quasi.cooked, quasi.loc);
    generateStringLiteral(ctx, quasiLit);
  }
  ctx.emitter.emitArrayNewFixed(stringsArrayTypeIndex, expr.quasi.quasis.length);
  let cookedLocal = ctx.allocLocal(new ValTypeRefNull(wasmArrayType));
  ctx.emitter.emitLocalSet(cookedLocal);

  // Raw strings
  for (let quasi in expr.quasi.quasis) {
    let quasiLit = new StringLiteral(quasi.raw, quasi.loc);
    generateStringLiteral(ctx, quasiLit);
  }
  ctx.emitter.emitArrayNewFixed(stringsArrayTypeIndex, expr.quasi.quasis.length);
  let rawLocal = ctx.allocLocal(new ValTypeRefNull(wasmArrayType));
  ctx.emitter.emitLocalSet(rawLocal);

  // Instantiate TSA struct
  if (tsaVtableGlobal != null) {
    ctx.emitter.emitGlobalGet((tsaVtableGlobal as WasmGlobal).index);
  } else {
    ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.none));
  }

  for (var f = 1; f < tsaStruct.fields.length; f += 1) {
    if (f == stringsFieldIdx) {
      ctx.emitter.emitLocalGet(cookedLocal);
    } else if (f == rawFieldIdx) {
      ctx.emitter.emitLocalGet(rawLocal);
    } else {
      let fieldType = tsaStruct.fields[f].type;
      if (fieldType is ValTypeI32) {
        ctx.emitter.emitI32Const(0);
      } else if (fieldType is ValTypeF32) {
        ctx.emitter.emitF32Const(0.0);
      } else if (fieldType is ValTypeF64) {
        ctx.emitter.emitF64Const(0.0);
      } else {
        ctx.emitter.emitRefNull(heapTypeToSigned(HeapType.none));
      }
    }
  }

  ctx.emitter.emitStructNew(tsaStruct.index);
  ctx.emitter.emitGlobalSet(wasmGlobal.index);
  ctx.emitter.emitEnd();

  // Push TSA onto stack
  ctx.emitter.emitGlobalGet(wasmGlobal.index);

  // 6. Push values array
  var expectedValueType: Type = new AnyType();
  let calleeType = ctx.wasmFunction.model.getNodeType(expr.tag);
  if (calleeType is FunctionType) {
    let ft = calleeType as FunctionType;
    if (ft.parameters.length >= 2) {
      let valuesParamType = ft.parameters[1];
      if (valuesParamType is ClassType) {
        let ct = valuesParamType as ClassType;
        if (ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0) {
          expectedValueType = (ct.typeArguments as Array<Type>)[0];
        }
      } else if (valuesParamType is ArrayType) {
        let at = valuesParamType as ArrayType;
        expectedValueType = at.elementType;
      }
    }
  } else if (expr.quasi.expressions.length > 0) {
    let rawEvt = ctx.wasmFunction.model.getNodeType(expr.quasi.expressions[0]);
    if (rawEvt != null) {
      expectedValueType = rawEvt as Type;
    }
  }

  if (expectedValueType == null) {
    expectedValueType = new AnyType();
  }

  let valElemType = typeToValType(ctx.wasm, expectedValueType);
  let wasmValuesArray = ctx.wasm.getArray(valElemType, true);
  let valuesArrayTypeIndex = wasmValuesArray.index;

  for (let subExpr in expr.quasi.expressions) {
    let subExprType = ctx.wasmFunction.model.getNodeType(subExpr);
    if (subExprType == null) {
      throw new Error("Debug: subExprType is null!");
    } else {
      let bType = baseType(subExprType as Type);
      if (!(bType is I32Type || bType is F64Type || bType is F32Type || bType is I64Type || bType is U64Type || bType is U32Type || bType is BooleanType || (bType is ClassType && (bType as ClassType).name == "String"))) {
        throw new Error("Debug: subExprType is unexpected: " + typeToString(subExprType as Type));
      }
    }
    genExpr(subExpr, false);
  }
  ctx.emitter.emitArrayNewFixed(valuesArrayTypeIndex, expr.quasi.expressions.length);

  // 7. Invoke tag function
  match (expr.tag) {
    case Identifier: {
      let ident = expr.tag as Identifier;
      let model = ctx.wasmFunction.model;
      let sym = model.resolve(ident);

      if (sym == null) {
        throw new Error("Unresolved identifier in tagged template tag: " + ident.name);
      }

      if (ctx.wasm.functionMap.has((sym as Symbol).id)) {
        ctx.emitter.emitCall(ctx.wasm.functionMap[(sym as Symbol).id]);
      } else if ((sym as Symbol).declaration is ImportSpecifier) {
        let spec = (sym as Symbol).declaration as ImportSpecifier;
        let importedName = spec.imported.name;
        if (ctx.wasm.exportMap.has(importedName as ExportKey)) {
          ctx.emitter.emitCall(ctx.wasm.exportMap[importedName as ExportKey]);
        } else {
          throw new Error("Export map missing: " + importedName);
        }
      } else if (calleeType is FunctionType) {
        let fType = calleeType as FunctionType;
        let paramValTypes = new Array<ValType>();
        for (let p in fType.parameters) {
          paramValTypes.push(typeToValType(ctx.wasm, p));
        }
        let returnValTypes = new Array<ValType>();
        mapReturnTypeToWasmResults(ctx.wasm, fType.returnType, returnValTypes);
        
        let closureStruct = ctx.wasm.getClosureStruct(paramValTypes, returnValTypes);
        let funcFieldType = closureStruct.fields[0].type as ValTypeRef;
        let implSig = funcFieldType.target as WasmSignature;

        let valuesLocal = ctx.allocLocal(new ValTypeRefNull(wasmValuesArray));
        ctx.emitter.emitLocalSet(valuesLocal);
        
        let tsaLocal = ctx.allocLocal(new ValTypeRefNull(tsaStruct));
        ctx.emitter.emitLocalSet(tsaLocal);
        
        generateIdentifier(ctx, ident);
        ctx.emitter.emitRefCast(closureStruct.index);
        
        let closureLocal = ctx.allocLocal(new ValTypeRefNull(closureStruct));
        ctx.emitter.emitLocalSet(closureLocal);
        
        ctx.emitter.emitLocalGet(closureLocal);
        ctx.emitter.emitStructGet(closureStruct.index, 1);
        
        ctx.emitter.emitLocalGet(tsaLocal);
        ctx.emitter.emitLocalGet(valuesLocal);
        
        ctx.emitter.emitLocalGet(closureLocal);
        ctx.emitter.emitStructGet(closureStruct.index, 0);
        
        ctx.emitter.emitCallRef(implSig.index);
      } else {
        throw new Error("Could not resolve tagged template tag call target: " + ident.name);
      }
    }
    case _: {
      if (calleeType is FunctionType) {
        let fType = calleeType as FunctionType;
        let paramValTypes = new Array<ValType>();
        for (let p in fType.parameters) {
          paramValTypes.push(typeToValType(ctx.wasm, p));
        }
        let returnValTypes = new Array<ValType>();
        mapReturnTypeToWasmResults(ctx.wasm, fType.returnType, returnValTypes);
        
        let closureStruct = ctx.wasm.getClosureStruct(paramValTypes, returnValTypes);
        let funcFieldType = closureStruct.fields[0].type as ValTypeRef;
        let implSig = funcFieldType.target as WasmSignature;

        let valuesLocal = ctx.allocLocal(new ValTypeRefNull(wasmValuesArray));
        ctx.emitter.emitLocalSet(valuesLocal);
        
        let tsaLocal = ctx.allocLocal(new ValTypeRefNull(tsaStruct));
        ctx.emitter.emitLocalSet(tsaLocal);

        genExpr(expr.tag, false);
        ctx.emitter.emitRefCast(closureStruct.index);
        
        let closureLocal = ctx.allocLocal(new ValTypeRefNull(closureStruct));
        ctx.emitter.emitLocalSet(closureLocal);
        
        ctx.emitter.emitLocalGet(closureLocal);
        ctx.emitter.emitStructGet(closureStruct.index, 1);
        
        ctx.emitter.emitLocalGet(tsaLocal);
        ctx.emitter.emitLocalGet(valuesLocal);
        
        ctx.emitter.emitLocalGet(closureLocal);
        ctx.emitter.emitStructGet(closureStruct.index, 0);
        
        ctx.emitter.emitCallRef(implSig.index);
      } else {
        throw new Error("Unsupported tagged template tag expression type");
      }
    }
  }
};

