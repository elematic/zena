import { Node, Identifier, NumberLiteral, BooleanLiteral, StringLiteral, ImportSpecifier } from '../../ast.zena';
import { Type, F64Type, F32Type, I32Type, baseType, typeToString } from '../../types.zena';
import { SymbolId, Symbol } from '../../scope/symbol.zena';
import { parseI32, parseF64 } from 'zena:string-convert';
import { FunctionContext } from '../function-context.zena';
import { Error } from 'zena:error';
import { WasmStruct, typeToValType, getCellStruct } from '../wasm-module.zena';
import { ValTypeRefNull } from '../wasm.zena';

// TODO: Consider moving `generateIdentifier` to a dedicated file (e.g.,
// `bindings.zena` or `variables.zena`). While it is parsed as a primary
// expression along with literals, its code generation handles scope resolution,
// locals, and globals, which is semantically distinct from emitting static
// primitives.
export let generateIdentifier = (ctx: FunctionContext, ident: Identifier): void => {
  let sym = ctx.wasmFunction.model.resolve(ident);
  if (sym != null) {
    if (ctx.localIndices.has(sym.id)) {
      ctx.emitter.emitLocalGet(ctx.localIndices[sym.id]);
      if (ctx.isCelled(sym.id)) {
        let symType = ctx.wasmFunction.model.getBindingType(sym);
        let valType = typeToValType(ctx.wasm, symType);
        let cellStruct = getCellStruct(ctx.wasm, valType);
        ctx.emitter.emitStructGet(cellStruct.index, 0);
      }
      return;
    }
    if (ctx.wasm.globalMap.has(sym.id)) {
      ctx.emitter.emitGlobalGet(ctx.wasm.globalMap[sym.id].index);
      return;
    }
    if ((sym as Symbol).declaration is ImportSpecifier) {
      let spec = (sym as Symbol).declaration as ImportSpecifier;
      let importedName = spec.imported.name;
      if (ctx.wasm.exportGlobalMap.has(importedName)) {
        ctx.emitter.emitGlobalGet(ctx.wasm.exportGlobalMap[importedName].index);
        return;
      }
    }
  }
  throw new Error("Could not resolve identifier: " + ident.name);
};

export let generateNumberLiteral = (ctx: FunctionContext, expr: NumberLiteral): void => {
  let nodeType = ctx.wasmFunction.model.getNodeType(expr as Node);
  let baseT = baseType(nodeType);

  if (baseT is F64Type) {
    let val = parseF64(expr.raw);
    ctx.emitter.emitF64Const(val);
  } else if (baseT is F32Type) {
    let val = parseF64(expr.raw);
    ctx.emitter.emitF32Const(val);
  } else {
    // Treat all other numeric types (i32, u32, i8, etc) as 32-bit integers in Wasm for now
    let (ok, val) = parseI32(expr.raw);
    if (!ok) {
      throw new Error('Failed to parse i32: ' + expr.raw);
    }
    ctx.emitter.emitI32Const(val as i32);
  }
};

export let generateBooleanLiteral = (ctx: FunctionContext, expr: BooleanLiteral): void => {
  ctx.emitter.emitBooleanConst(expr.value);
};

export let generateStringLiteral = (ctx: FunctionContext, expr: StringLiteral): void => {
  var stringKey: String | null = null;
  for (let key in ctx.wasm.classStructs.keys()) {
    if (key.startsWith("String_")) {
      stringKey = key;
    }
  }
  if (stringKey == null) {
    throw new Error("String class struct not found during string literal generation!");
  }
  let structType = ctx.wasm.classStructs[stringKey as String];
  let tempLocal = ctx.allocLocal(new ValTypeRefNull(structType));

  // 1. Allocate String struct with default values
  ctx.emitter.emitStructNewDefault(structType.index);
  ctx.emitter.emitLocalSet(tempLocal);

  // 2. Set vtable (field 0)
  let hasVTable = ctx.wasm.classVTableGlobals.has(stringKey as String);
  if (hasVTable) {
    let vtableGlobal = ctx.wasm.classVTableGlobals[stringKey as String];
    ctx.emitter.emitLocalGet(tempLocal);
    ctx.emitter.emitGlobalGet(vtableGlobal.index);
    ctx.emitter.emitStructSet(structType.index, 0); // vtable is field 0
  }

  // 3. Find string field offsets
  var dataFieldIdx = -1;
  var startFieldIdx = -1;
  var endFieldIdx = -1;
  var encodingFieldIdx = -1;
  for (var f = 0; f < structType.fields.length; f += 1) {
    let fieldName = structType.fields[f].name;
    if (fieldName != null) {
      let nameStr = fieldName as String;
      if (nameStr.endsWith("::#data")) {
        dataFieldIdx = f;
      } else if (nameStr.endsWith("::#start")) {
        startFieldIdx = f;
      } else if (nameStr.endsWith("::#end")) {
        endFieldIdx = f;
      } else if (nameStr.endsWith("::#encoding")) {
        encodingFieldIdx = f;
      }
    }
  }
  if (dataFieldIdx == -1 || startFieldIdx == -1 || endFieldIdx == -1 || encodingFieldIdx == -1) {
    throw new Error("String fields not found in struct!");
  }

  // 4. Create the ByteArray from the data segment
  let dataIndex = ctx.wasm.getStringLiteralDataIndex(expr.value);
  let byteArrayType = ctx.wasm.getByteArrayType();
  let byteArrayTypeIndex = byteArrayType.index;
  
  ctx.emitter.emitLocalGet(tempLocal);
  ctx.emitter.emitI32Const(0); // offset
  ctx.emitter.emitI32Const(expr.value.length); // length
  ctx.emitter.emitArrayNewData(byteArrayTypeIndex, dataIndex);
  ctx.emitter.emitStructSet(structType.index, dataFieldIdx);

  // 5. Set #start (index startFieldIdx) to 0
  ctx.emitter.emitLocalGet(tempLocal);
  ctx.emitter.emitI32Const(0);
  ctx.emitter.emitStructSet(structType.index, startFieldIdx);

  // 6. Set #end (index endFieldIdx) to length
  ctx.emitter.emitLocalGet(tempLocal);
  ctx.emitter.emitI32Const(expr.value.length);
  ctx.emitter.emitStructSet(structType.index, endFieldIdx);

  // 7. Set #encoding (index encodingFieldIdx) to 0
  ctx.emitter.emitLocalGet(tempLocal);
  ctx.emitter.emitI32Const(0);
  ctx.emitter.emitStructSet(structType.index, encodingFieldIdx);

  // 8. Return the String instance by getting it to the stack
  ctx.emitter.emitLocalGet(tempLocal);
};
