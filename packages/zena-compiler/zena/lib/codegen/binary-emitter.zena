import { ByteBuffer } from 'zena:byte-buffer';
import { WasmEmitter } from './wasm-emitter.zena';
import { WasmType, WasmSignature, WasmFunction, WasmModule, DiscoveryPass } from './wasm-module.zena';
import { SectionId, ValType, Opcode, GcOpcode } from './wasm.zena';

/**
 * Implements the WasmEmitter interface by writing WebAssembly binary
 * formatted bytes to a ByteBuffer.
 */
export class BinaryEmitter implements WasmEmitter {
  mainBuffer: ByteBuffer;
  
  var currentSection: ByteBuffer | null = null;
  var currentBuffer: ByteBuffer | null = null;
  var currentLocals: Array<ValType> | null = null;
  
  new(this.mainBuffer);

  // Module lifecycle
  emitModuleStart(): void {
    // Magic: \0asm
    this.mainBuffer.writeU32(0x6D736100);
    // Version: 1
    this.mainBuffer.writeU32(0x00000001);
  }
  
  writeSection(id: i32, payload: ByteBuffer): void {
    this.mainBuffer.writeByte(id);
    this.mainBuffer.writeULEB128(payload.length);
    this.mainBuffer.writeBuffer(payload);
  }

  emitTypeSectionStart(count: i32): void {
    if (count == 0) return;
    this.currentSection = new ByteBuffer();
    (this.currentSection as ByteBuffer).writeULEB128(count);
  }
  
  emitFunctionTypeStart(index: i32): void {
    if (this.currentSection == null) return;
    (this.currentSection as ByteBuffer).writeByte(ValType.func as i32);
  }
  
  emitFunctionTypeParamsStart(count: i32): void {
    if (this.currentSection == null) return;
    (this.currentSection as ByteBuffer).writeULEB128(count);
  }
  
  emitFunctionTypeParam(type: ValType): void {
    if (this.currentSection == null) return;
    (this.currentSection as ByteBuffer).writeByte(type as i32);
  }
  
  emitFunctionTypeResultsStart(count: i32): void {
    if (this.currentSection == null) return;
    (this.currentSection as ByteBuffer).writeULEB128(count);
  }
  
  emitFunctionTypeResult(type: ValType): void {
    if (this.currentSection == null) return;
    (this.currentSection as ByteBuffer).writeByte(type as i32);
  }
  
  emitFunctionTypeEnd(): void {}

  emitStructTypeStart(index: i32, name: String | null): void {
    if (this.currentSection == null) {
      return;
    }
    // 0x5F is the type form for struct in Wasm GC
    (this.currentSection as ByteBuffer).writeByte(0x5F);
  }

  emitStructTypeFieldsStart(count: i32): void {
    if (this.currentSection == null) {
      return;
    }
    (this.currentSection as ByteBuffer).writeULEB128(count);
  }

  emitStructTypeField(type: ValType, isMutable: boolean): void {
    if (this.currentSection == null) {
      return;
    }
    (this.currentSection as ByteBuffer).writeByte(type as i32);
    (this.currentSection as ByteBuffer).writeByte(if (isMutable) 1 else 0);
  }

  emitStructTypeEnd(): void {}
  
  emitTypeSectionEnd(): void {
    if (this.currentSection != null) {
      this.writeSection(SectionId.Type as i32, this.currentSection as ByteBuffer);
      this.currentSection = null;
    }
  }

  emitImportSectionStart(count: i32): void {
    // TODO: Not yet implemented
  }
  emitGlobalImport(module: String, name: String, type: ValType, isMutable: boolean): void {
  }
  emitImportSectionEnd(): void {}

  emitGlobalSectionStart(count: i32): void {
    if (count == 0) {
      return;
    }
    this.currentSection = new ByteBuffer();
    this.currentBuffer = this.currentSection;
    (this.currentSection as ByteBuffer).writeULEB128(count);
  }

  emitGlobal(type: ValType, isMutable: boolean): void {
    let section = this.currentSection;
    if (section != null) {
      section.writeByte(type as i32);
      section.writeByte(if (isMutable) 1 else 0);
    }
  }

  emitGlobalEnd(): void {
    let section = this.currentSection;
    if (section != null) {
      section.writeByte(Opcode.end as i32);
    }
  }

  emitGlobalSectionEnd(): void {
    if (this.currentSection != null) {
      this.writeSection(SectionId.Global as i32, this.currentSection as ByteBuffer);
      this.currentSection = null;
      this.currentBuffer = null;
    }
  }

  emitFunctionSectionStart(count: i32): void {
    if (count == 0) return;
    this.currentSection = new ByteBuffer();
    (this.currentSection as ByteBuffer).writeULEB128(count);
  }

  emitFunctionDefinition(typeIndex: i32): void {
    if (this.currentSection != null) {
      (this.currentSection as ByteBuffer).writeULEB128(typeIndex);
    }
  }

  emitFunctionSectionEnd(): void {
    if (this.currentSection != null) {
      this.writeSection(SectionId.Function as i32, this.currentSection as ByteBuffer);
      this.currentSection = null;
    }
  }
  
  emitExportSectionStart(count: i32): void {
    if (count == 0) {
      return;
    }
    this.currentSection = new ByteBuffer();
    (this.currentSection as ByteBuffer).writeULEB128(count);
  }

  emitExport(name: String, func: WasmFunction): void {
    let section = this.currentSection;

    if (section == null) {
      return;
    }
    
    let nameLen = name.length;
    section.writeULEB128(nameLen);
    for (var j = 0; j < nameLen; j += 1) {
      section.writeByte(name.getByteAt(j));
    }
    section.writeByte(0); // func
    section.writeULEB128(func.index);
  }

  emitExportGlobal(name: String, globalIndex: i32): void {
    let section = this.currentSection;
    if (section == null) {
      return;
    }
    
    let nameLen = name.length;
    section.writeULEB128(nameLen);
    for (var j = 0; j < nameLen; j += 1) {
      section.writeByte(name.getByteAt(j));
    }
    section.writeByte(3); // global
    section.writeULEB128(globalIndex);
  }

  emitExportSectionEnd(): void {
    if (this.currentSection != null) {
      this.writeSection(SectionId.Export as i32, this.currentSection as ByteBuffer);
      this.currentSection = null;
    }
  }

  emitCodeSectionStart(count: i32): void {
    if (count == 0) return;
    this.currentSection = new ByteBuffer();
    (this.currentSection as ByteBuffer).writeULEB128(count);
  }
  
  emitFunctionCodeStart(func: WasmFunction): void {
    this.currentBuffer = new ByteBuffer();
  }
  
  emitFunctionCodeEnd(func: WasmFunction): void {
    let funcBody = new ByteBuffer();
    let locals = this.currentLocals;
    if (locals != null && (locals as Array<ValType>).length > 0) {
      let lArray = locals as Array<ValType>;
      // For now, simpler: one run per local. Optimization: RLE encode consecutive types.
      funcBody.writeULEB128(lArray.length);
      for (let l in lArray) {
        funcBody.writeULEB128(1); // count 1
        funcBody.writeByte(l as i32); 
      }
    } else {
      funcBody.writeULEB128(0); // local count 0
    }
    
    let currFunc = this.currentBuffer as ByteBuffer;
    funcBody.writeBuffer(currFunc);
    
    let section = this.currentSection as ByteBuffer;
    section.writeULEB128(funcBody.length);
    section.writeBuffer(funcBody);
    
    this.currentBuffer = null;
    this.currentLocals = null;
  }
  
  emitCodeSectionEnd(): void {
    if (this.currentSection != null) {
      this.writeSection(SectionId.Code as i32, this.currentSection as ByteBuffer);
      this.currentSection = null;
    }
  }

  emitModuleEnd(): void {}

  // Function lifecycle
  emitFunctionSignatureStart(name: String, typeIndex: i32): void {}
  emitFunctionLocalsStart(locals: Array<ValType>): void {
    this.currentLocals = locals;
  }
  
  emitFunctionEnd(): void {
    (this.currentBuffer as ByteBuffer).writeByte(Opcode.end as i32);
  }
    // Control flow
  emitUnreachable(): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.unreachable as i32);
  }

  emitBlock(resultType: ValType): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.block as i32);
    b.writeByte(resultType as i32);
  }

  emitLoop(resultType: ValType): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.loop as i32);
    b.writeByte(resultType as i32);
  }

  emitIf(resultType: ValType): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.if_ as i32);
    b.writeByte(resultType as i32);
  }

  emitElse(): void {
    (this.currentBuffer as ByteBuffer).writeByte(Opcode.else_ as i32);
  }

  emitEnd(): void {
    (this.currentBuffer as ByteBuffer).writeByte(Opcode.end as i32);
  }

  emitBr(depth: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.br as i32);
    b.writeULEB128(depth);
  }

  emitBrIf(depth: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.br_if as i32);
    b.writeULEB128(depth);
  }
  emitReturn(): void {
    (this.currentBuffer as ByteBuffer).writeByte(Opcode.return_ as i32);
  }
  
  emitCall(target: WasmFunction): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.call as i32);
    b.writeULEB128(target.index);
  }
  
  emitI32Const(value: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.i32_const as i32);
    b.writeSLEB128(value);
  }
  
  emitF64Const(value: f64): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.f64_const as i32);
    b.writeF64(value);
  }

  emitF32Const(value: f64): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.f32_const as i32);
    b.writeF32(value as f32);
  }

  emitBooleanConst(value: boolean): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.i32_const as i32);
    let v = if (value) 1 else 0;    
    b.writeSLEB128(v);
  }
  
  emitStringConst(value: String): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.i32_const as i32);
    b.writeSLEB128(0);
  }

  emitDrop(): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.drop as i32);
  }

  // GC operations
  emitStructNew(typeIndex: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.gc_prefix as i32);
    b.writeULEB128(GcOpcode.struct_new as i32);
    b.writeULEB128(typeIndex);
  }

  emitStructNewDefault(typeIndex: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.gc_prefix as i32);
    b.writeULEB128(GcOpcode.struct_new_default as i32);
    b.writeULEB128(typeIndex);
  }

  emitStructGet(typeIndex: i32, fieldIndex: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.gc_prefix as i32);
    b.writeULEB128(GcOpcode.struct_get as i32);
    b.writeULEB128(typeIndex);
    b.writeULEB128(fieldIndex);
  }

  emitStructSet(typeIndex: i32, fieldIndex: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.gc_prefix as i32);
    b.writeULEB128(GcOpcode.struct_set as i32);
    b.writeULEB128(typeIndex);
    b.writeULEB128(fieldIndex);
  }

  emitRefCastNull(typeIndex: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.gc_prefix as i32);
    b.writeULEB128(GcOpcode.ref_cast_null as i32);
    b.writeSLEB128(typeIndex);
  }

  // Variables
  emitLocalGet(index: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.local_get as i32);
    b.writeULEB128(index);
  }

  emitLocalSet(index: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.local_set as i32);
    b.writeULEB128(index);
  }
  
  emitLocalTee(index: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.local_tee as i32);
    b.writeULEB128(index);
  }

  emitGlobalGet(index: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.global_get as i32);
    b.writeULEB128(index);
  }

  emitGlobalSet(index: i32): void {
    let b = this.currentBuffer as ByteBuffer;
    b.writeByte(Opcode.global_set as i32);
    b.writeULEB128(index);
  }

  emitI32Add(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_add as i32); }
  emitI32Sub(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_sub as i32); }
  emitI32Mul(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_mul as i32); }
  emitI32DivS(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_div_s as i32); }
  emitI32Eq(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_eq as i32); }
  emitI32Eqz(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_eqz as i32); }
  emitI32Ne(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_ne as i32); }
  emitI32LtS(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_lt_s as i32); }
  emitI32LeS(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_le_s as i32); }
  emitI32GtS(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_gt_s as i32); }
  emitI32GeS(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_ge_s as i32); }
  emitI32RemS(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_rem_s as i32); }
  emitI32And(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_and as i32); }
  emitI32Or(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_or as i32); }
  emitI32Xor(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_xor as i32); }
  emitI32Shl(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_shl as i32); }
  emitI32ShrS(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_shr_s as i32); }
  emitI32ShrU(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_shr_u as i32); }
  emitI32Clz(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_clz as i32); }
  emitI32Ctz(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_ctz as i32); }
  emitI32Popcnt(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_popcnt as i32); }

  emitF64Add(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f64_add as i32); }
  emitF64Sub(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f64_sub as i32); }
  emitF64Mul(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f64_mul as i32); }
  emitF64Div(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f64_div as i32); }
  emitF64Eq(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f64_eq as i32); }
  emitF64Ne(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f64_ne as i32); }
  emitF64Lt(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f64_lt as i32); }
  emitF64Gt(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f64_gt as i32); }
  emitF64Le(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f64_le as i32); }
  emitF64Ge(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f64_ge as i32); }
  emitF64ConvertI32S(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f64_convert_i32_s as i32); }

  emitF32Add(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f32_add as i32); }
  emitF32Sub(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f32_sub as i32); }
  emitF32Mul(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f32_mul as i32); }
  emitF32Div(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f32_div as i32); }
  emitF32Eq(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f32_eq as i32); }
  emitF32Ne(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f32_ne as i32); }
  emitF32Lt(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f32_lt as i32); }
  emitF32Gt(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f32_gt as i32); }
  emitF32Le(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f32_le as i32); }
  emitF32Ge(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f32_ge as i32); }
  emitF32ConvertI32S(): void { (this.currentBuffer as ByteBuffer).writeByte(Opcode.f32_convert_i32_s as i32); }

  emitMemorySize(): void {
    (this.currentBuffer as ByteBuffer).writeByte(Opcode.memory_size as i32);
    (this.currentBuffer as ByteBuffer).writeByte(0);
  }
  emitMemoryGrow(): void {
    (this.currentBuffer as ByteBuffer).writeByte(Opcode.memory_grow as i32);
    (this.currentBuffer as ByteBuffer).writeByte(0);
  }
  emitI32Load(align: i32, offset: i32): void {
    (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_load as i32);
    (this.currentBuffer as ByteBuffer).writeULEB128(align);
    (this.currentBuffer as ByteBuffer).writeULEB128(offset);
  }
  emitI32Store(align: i32, offset: i32): void {
    (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_store as i32);
    (this.currentBuffer as ByteBuffer).writeULEB128(align);
    (this.currentBuffer as ByteBuffer).writeULEB128(offset);
  }
  emitI32Load8U(align: i32, offset: i32): void {
    (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_load8_u as i32);
    (this.currentBuffer as ByteBuffer).writeULEB128(align);
    (this.currentBuffer as ByteBuffer).writeULEB128(offset);
  }
  emitI32Store8(align: i32, offset: i32): void {
    (this.currentBuffer as ByteBuffer).writeByte(Opcode.i32_store8 as i32);
    (this.currentBuffer as ByteBuffer).writeULEB128(align);
    (this.currentBuffer as ByteBuffer).writeULEB128(offset);
  }
}