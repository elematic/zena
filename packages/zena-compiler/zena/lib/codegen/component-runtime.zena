/**
 * The component target's runtime memory module, compiled on demand.
 *
 * A component whose program touches linear memory embeds a second core
 * module owning the memory and the allocator
 * (docs/design/component-emission.md, 1.3). Its source is fixed —
 * `component-memory.zena` in the standard library — so this is a small,
 * deterministic nested compile, on the `freestanding` target of the
 * compiler that is already running the enclosing build. Drivers call it
 * once per component build and hand the bytes to `BinaryGenerator`; a
 * driver that skips it gets a loud error from `emitComponent` the
 * moment a program needs memory, not a component that fails validation.
 *
 * This lives beside the generators rather than in `compiler.zena`
 * because it needs both halves — the compiler to check the source and
 * `BinaryGenerator` to emit it — and `compiler.zena` deliberately does
 * not depend on codegen.
 */

import { ByteBuffer } from 'zena:core';
import { Compiler, checkCompilation } from '../compiler.zena';
import { DiagnosticSeverity } from '../diagnostics.zena';
import { Program, CompilationUnit } from '../program.zena';
import { BinaryGenerator } from './binary-generator.zena';

/** The runtime module's entry, relative to the standard library root. */
let runtimeEntry = "wasi/memory.zena";

/**
 * The bytes this process has already built, by standard library root.
 *
 * The module's source is fixed and the compile deterministic, so two
 * component builds in one process against the same standard library
 * want the same bytes, and the second compile is work for nothing. It
 * is not a small amount of work: compiling it costs about 1.2s, which
 * on a trivial program is more than compiling the program.
 *
 * This only helps a process that builds more than one component — a
 * test runner, or a batch compile. A single `zena build` still pays
 * once, and the way to fix that is to build these bytes ahead of time
 * rather than to cache them here.
 */
let cachedByStdlibRoot = new Map<String, ByteBuffer>();

/**
 * Compile the runtime memory module; the finished core-module bytes.
 *
 * It compiles on the compiler running the enclosing build, which
 * already has the host and the standard library root it needs — only
 * the target differs. On `freestanding`, `zena:memory` is the real
 * free-list allocator rather than the module that delegates to the
 * component's memory, which is the whole reason this is a second
 * compile rather than part of the first.
 */
export let compileComponentRuntimeModule = (
  compiler: Compiler,
  stdlibRoot: String
): ByteBuffer => {
  if (let (true, cached) = cachedByStdlibRoot.get(stdlibRoot)) {
    return cached;
  }
  let compResult = compiler.compile({
    entry: `${stdlibRoot}/${runtimeEntry}`,
    target: "freestanding",
  });
  let checkResults = checkCompilation(compResult);
  for (let diag in checkResults.diagnostics) {
    if (diag.severity == DiagnosticSeverity.Error) {
      // Program code cannot reach this compile; an error here means the
      // stdlib or the compiler itself regressed.
      throw new Error(
          "the component runtime memory module failed to compile: " +
          diag.message);
    }
  }
  let entryAst = compResult.entry.ast;
  let units = new Array<CompilationUnit>();
  var entryUnit: CompilationUnit | null = null;
  for (let file in compResult.files) {
    let res = checkResults.results[file.path];
    if (res != null) {
      let unit = {ast: file.ast, model: res.model};
      units.push(unit);
      if (file.ast.path == entryAst.path) {
        entryUnit = unit;
      }
    }
  }
  let bytes = new BinaryGenerator("freestanding", false)
      .generate(new Program(units, entryUnit));
  cachedByStdlibRoot[stdlibRoot] = bytes;
  return bytes;
};
