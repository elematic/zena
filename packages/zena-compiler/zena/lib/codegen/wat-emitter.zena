let escapeBytesForWat = (bytes: ByteBuffer): String => {
  let sb = new StringBuilder();
  let len = bytes.length;
  for (var i = 0; i < len; i += 1) {
    let b = bytes.getByte(i);
    sb.append('\\');
    let hexChars = "0123456789abcdef";
    let high = (b >> 4) & 0x0F;
    let low = b & 0x0F;
    sb.append(hexChars.sliceBytes(high, high + 1));
    sb.append(hexChars.sliceBytes(low, low + 1));
  }
  return sb.toString();
};

let getFunctionName = (func: WasmFunction): String => {
  return func.name ?? `func${func.index}`;
};

let getTypeName = (t: ValType): String => {
  return match (t) {
    case ValTypeVoid: 'void'
    case ValTypeFunc: 'func'
    case ValTypeI32: 'i32'
    case ValTypeI64: 'i64'
    case ValTypeF32: 'f32'
    case ValTypeF64: 'f64'
    case ValTypeV128: 'v128'
    case ValTypeFuncRef: 'funcref'
    case ValTypeExternRef: 'externref'
    case ValTypeAnyRef: 'anyref'
    case ValTypeEqRef: 'eqref'
    case ValTypeStructRef: 'structref'
    case ValTypeOptRef: 'optref'
    case ValTypeRef as r: '(ref ' + i32ToString(r.target.index) + ')'
    case ValTypeRefNull as r: '(ref null ' + i32ToString(r.target.index) + ')'
    case ValTypeI8: 'i8'
    case ValTypeI16: 'i16'
  };
};
