import { StringBuilder } from 'zena:string-builder';
import { WasmEmitter } from './wasm-emitter.zena';
import { WasmType, WasmFunction } from "./wasm-module.zena";
import { ValType } from "./wasm.zena";
import { WasmExport } from './wasm-module.zena';
import { String } from 'zena:string';
import { i32ToString, f64ToString } from 'zena:string-convert';
import { Array } from 'zena:array';

export class WatEmitter implements WasmEmitter {
  sb: StringBuilder;
  var indentDepth: i32 = 1;
  
  new(this.sb);

  indent(): void {    
    for (var i = 0; i < this.indentDepth; i += 1) {
      this.sb.append('  ');
    }
  }

  // Module lifecycle
  emitModuleStart(): void {
    this.sb.append('(module\n');
  }
  
  emitTypeSectionStart(count: i32): void {}
  
  emitFunctionTypeStart(index: i32): void {
    this.indent();
    this.sb.append('(type (;').append(i32ToString(index)).append(';) (func');
  }
  
  emitFunctionTypeParamsStart(count: i32): void {}
  
  emitFunctionTypeParam(type: ValType): void {
    this.sb.append(' (param ').append(getTypeName(type)).append(')');
  }
  
  emitFunctionTypeResultsStart(count: i32): void {}
  
  emitFunctionTypeResult(type: ValType): void {
    this.sb.append(' (result ').append(getTypeName(type)).append(')');
  }
  
  emitFunctionTypeEnd(): void {
    this.sb.append('))\n');
  }
  
  emitTypeSectionEnd(): void {}

  emitFunctionSectionStart(count: i32): void {}
  emitFunctionDefinition(typeIndex: i32): void {}
  emitFunctionSectionEnd(): void {}

  emitImportSectionStart(count: i32): void {}
  emitGlobalImport(module: String, name: String, type: ValType, isMutable: boolean): void {
    this.indent();
    this.sb.append('(import "').append(module).append('" "').append(name).append('" (global ');
    if (isMutable) {
      this.sb.append('(mut ').append(getTypeName(type)).append(')');
    } else {
      this.sb.append(getTypeName(type));
    }
    this.sb.append('))\n');
  }
  emitImportSectionEnd(): void {}

  emitGlobalSectionStart(count: i32): void {}
  emitGlobal(type: ValType, isMutable: boolean): void {
    this.indent();
    this.sb.append('(global ');
    if (isMutable) {
      this.sb.append('(mut ').append(getTypeName(type)).append(')');
    } else {
      this.sb.append(getTypeName(type));
    }
    this.sb.append(' ');
    // We expect an instruction next, we use the `(` on the instruction?
    // WAT format requires (i32.const 0). We should probably just let it generate `i32.const 0` 
    // Actually in some WAT formats:
    // (global $name i32 (i32.const 0))
    // We can just append `\n` here and not worry about it, or append `(\n` ?
    this.sb.append('(');
  }

  emitGlobalEnd(): void {
    // wait emitI32Const ends with \n. So if we had `(` from emitGlobal. It would be `(i32.const 0\n)` we need `)` at the end
    // But then there's a trailing newline inside the parenthesis.
    // To make it simpler we can trim the previous newline?
    // Let's just output `)\n` 
    this.indent();
    this.sb.append(')\n');
  }

  emitGlobalSectionEnd(): void {}
  
  emitExportSectionStart(count: i32): void {}
  
  emitExport(name: String, func: WasmFunction): void {
    this.indent();
    this.sb
        .append('(export "')
        .append(name)
        .append('" (func $')
        .append(getFunctionName(func))
        .append('))\n');
  }

  emitExportGlobal(name: String, globalIndex: i32): void {
    this.indent();
    this.sb
        .append('(export "')
        .append(name)
        .append('" (global ')
        .append(i32ToString(globalIndex))
        .append('))\n');
  }

  emitExportSectionEnd(): void {}
  
  emitCodeSectionStart(count: i32): void {}
  
  emitFunctionCodeStart(func: WasmFunction): void {}
  
  emitFunctionCodeEnd(func: WasmFunction): void {}
  emitCodeSectionEnd(): void {}
  
  emitModuleEnd(): void {
    this.sb.append(')\n');
  }

  // Instruction lifecycle
  emitFunctionSignatureStart(name: String, typeIndex: i32): void {
    this.indent();
    this.sb.append('(func $').append(name).append(' (type ').append(i32ToString(typeIndex)).append(')');
  }


  emitFunctionLocalsStart(locals: Array<ValType>): void {
    if (locals.length > 0) {
      this.sb.append('\n');
      this.indentDepth += 1;
      for (let l in locals) {
        this.indent();
        this.sb.append('(local ').append(getTypeName(l)).append(')\n');
      }
      this.indentDepth -= 1;
    }
    this.sb.append('\n');
    this.indentDepth += 1;
  }

  emitFunctionEnd(): void {
    this.indentDepth -= 1;
    this.indent();
    this.sb.append(')\n');
  }

  // Control flow
  emitUnreachable(): void {
    this.indent();
    this.sb.append('unreachable\n');
  }

  emitBlock(resultType: ValType): void {
    this.indent();
    if (resultType == ValType.void) {
      this.sb.append('block\n');
    } else {
      this.sb.append('block (result ').append(getTypeName(resultType)).append(')\n');
    }
    this.indentDepth += 1;
  }
  
  emitLoop(resultType: ValType): void {
    this.indent();
    if (resultType == ValType.void) {
      this.sb.append('loop\n');
    } else {
      this.sb.append('loop (result ').append(getTypeName(resultType)).append(')\n');
    }
    this.indentDepth += 1;
  }
  
  emitIf(resultType: ValType): void {
    this.indent();
    if (resultType == ValType.void) {
      this.sb.append('if\n');
    } else {
      this.sb.append('if (result ').append(getTypeName(resultType)).append(')\n');
    }
    this.indentDepth += 1;
  }
  
  emitElse(): void {
    this.indentDepth -= 1;
    this.indent();
    this.sb.append('else\n');
    this.indentDepth += 1;
  }
  
  emitEnd(): void {
    this.indentDepth -= 1;
    this.indent();
    this.sb.append('end\n');
  }
  
  emitBr(depth: i32): void {
    this.indent();
    this.sb.append('br ').append(i32ToString(depth)).append('\n');
  }
  
  emitBrIf(depth: i32): void {
    this.indent();
    this.sb.append('br_if ').append(i32ToString(depth)).append('\n');
  }

  emitReturn(): void {
    this.indent();
    this.sb.append('return\n');
  }

  emitCall(target: WasmFunction): void {
    this.indent();
    this.sb.append('call $').append(getFunctionName(target)).append('\n');
  }

  emitI32Const(value: i32): void {
    this.indent();
    this.sb.append('i32.const ').append(i32ToString(value)).append('\n');
  }

  emitF64Const(value: f64): void {
    this.indent();
    this.sb.append('f64.const ').append(f64ToString(value)).append('\n');
  }

  emitF32Const(value: f64): void {
    this.indent();
    this.sb.append('f32.const ').append(f64ToString(value)).append('\n');
  }

  emitBooleanConst(value: boolean): void {
    this.indent();
    var s = '0';
    if (value) {
      s = '1';
    }
    this.sb.append('i32.const ').append(s).append('\n');
  }

  emitStringConst(value: String): void {
    this.indent();
    this.sb.append(';; string "').append(value).append('"\n');
  }

  emitDrop(): void {
    this.indent();
    this.sb.append('drop\n');
  }

  // Variables
  emitLocalGet(index: i32): void {
    this.indent();
    this.sb.append('local.get ').append(i32ToString(index)).append('\n');
  }
  
  emitLocalSet(index: i32): void {
    this.indent();
    this.sb.append('local.set ').append(i32ToString(index)).append('\n');
  }
  
  emitLocalTee(index: i32): void {
    this.indent();
    this.sb.append('local.tee ').append(i32ToString(index)).append('\n');
  }

  emitGlobalGet(index: i32): void {
    this.indent();
    this.sb.append('global.get ').append(i32ToString(index)).append('\n');
  }
  
  emitGlobalSet(index: i32): void {
    this.indent();
    this.sb.append('global.set ').append(i32ToString(index)).append('\n');
  }

  // Binary operations
  emitI32Add(): void { this.indent(); this.sb.append('i32.add\n'); }
  emitI32Sub(): void { this.indent(); this.sb.append('i32.sub\n'); }
  emitI32Mul(): void { this.indent(); this.sb.append('i32.mul\n'); }
  emitI32DivS(): void { this.indent(); this.sb.append('i32.div_s\n'); }
  emitI32Eq(): void { this.indent(); this.sb.append('i32.eq\n'); }  emitI32Eqz(): void { this.indent(); this.sb.append('i32.eqz\\n'); }  emitI32Ne(): void { this.indent(); this.sb.append('i32.ne\n'); }
  emitI32LtS(): void { this.indent(); this.sb.append('i32.lt_s\n'); }
  emitI32LeS(): void { this.indent(); this.sb.append('i32.le_s\n'); }
  emitI32GtS(): void { this.indent(); this.sb.append('i32.gt_s\n'); }
  emitI32GeS(): void { this.indent(); this.sb.append('i32.ge_s\n'); }
  emitI32RemS(): void { this.indent(); this.sb.append('i32.rem_s\n'); }
  emitI32And(): void { this.indent(); this.sb.append('i32.and\n'); }
  emitI32Or(): void { this.indent(); this.sb.append('i32.or\n'); }
  emitI32Xor(): void { this.indent(); this.sb.append('i32.xor\n'); }
  emitI32Shl(): void { this.indent(); this.sb.append('i32.shl\n'); }
  emitI32ShrS(): void { this.indent(); this.sb.append('i32.shr_s\n'); }
  emitI32ShrU(): void { this.indent(); this.sb.append('i32.shr_u\n'); }
  emitI32Clz(): void { this.indent(); this.sb.append('i32.clz\n'); }
  emitI32Ctz(): void { this.indent(); this.sb.append('i32.ctz\n'); }
  emitI32Popcnt(): void { this.indent(); this.sb.append('i32.popcnt\n'); }

  emitF64Add(): void { this.indent(); this.sb.append('f64.add\n'); }
  emitF64Sub(): void { this.indent(); this.sb.append('f64.sub\n'); }
  emitF64Mul(): void { this.indent(); this.sb.append('f64.mul\n'); }
  emitF64Div(): void { this.indent(); this.sb.append('f64.div\n'); }
  emitF64Eq(): void { this.indent(); this.sb.append('f64.eq\n'); }
  emitF64Ne(): void { this.indent(); this.sb.append('f64.ne\n'); }
  emitF64Lt(): void { this.indent(); this.sb.append('f64.lt\n'); }
  emitF64Gt(): void { this.indent(); this.sb.append('f64.gt\n'); }
  emitF64Le(): void { this.indent(); this.sb.append('f64.le\n'); }
  emitF64Ge(): void { this.indent(); this.sb.append('f64.ge\n'); }
  emitF64ConvertI32S(): void { this.indent(); this.sb.append('f64.convert_i32_s\n'); }

  emitF32Add(): void { this.indent(); this.sb.append('f32.add\n'); }
  emitF32Sub(): void { this.indent(); this.sb.append('f32.sub\n'); }
  emitF32Mul(): void { this.indent(); this.sb.append('f32.mul\n'); }
  emitF32Div(): void { this.indent(); this.sb.append('f32.div\n'); }
  emitF32Eq(): void { this.indent(); this.sb.append('f32.eq\n'); }
  emitF32Ne(): void { this.indent(); this.sb.append('f32.ne\n'); }
  emitF32Lt(): void { this.indent(); this.sb.append('f32.lt\n'); }
  emitF32Le(): void { this.indent(); this.sb.append('f32.le\n'); }
  emitF32Gt(): void { this.indent(); this.sb.append('f32.gt\n'); }
  emitF32Ge(): void { this.indent(); this.sb.append('f32.ge\n'); }
  emitF32ConvertI32S(): void { this.indent(); this.sb.append('f32.convert_i32_s\n'); }

  emitMemorySize(): void { this.indent(); this.sb.append('memory.size\n'); }
  emitMemoryGrow(): void { this.indent(); this.sb.append('memory.grow\n'); }
  emitI32Load(align: i32, offset: i32): void { this.indent(); this.sb.append(`i32.load align=${i32ToString(align)} offset=${i32ToString(offset)}\n`); }
  emitI32Store(align: i32, offset: i32): void { this.indent(); this.sb.append(`i32.store align=${i32ToString(align)} offset=${i32ToString(offset)}\n`); }
  emitI32Load8U(align: i32, offset: i32): void { this.indent(); this.sb.append(`i32.load8_u align=${i32ToString(align)} offset=${i32ToString(offset)}\n`); }
  emitI32Store8(align: i32, offset: i32): void { this.indent(); this.sb.append(`i32.store8 align=${i32ToString(align)} offset=${i32ToString(offset)}\n`); }
}

let getFunctionName = (func: WasmFunction): String => {
  return func.name ?? `func${func.index}`;
};

let getTypeName = (t: ValType): String => {
  return match (t) {
    case ValType.i32: 'i32'
    case ValType.f32: 'f32'
    case ValType.f64: 'f64'
    // TODO: support primitives in template literals
    case _: throw new Error(`Unsupported type: ${i32ToString(t as i32)}`)
  };
};
