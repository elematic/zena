import { ValTypeVoid, ValTypeFunc, ValTypeStructRef, ValTypeI32, ValTypeF32, ValTypeF64, ValTypeI64, ValTypeI8, ValTypeI16, ValTypeV128, ValTypeOptRef, ValTypeAnyRef, ValTypeFuncRef, ValTypeExternRef, ValTypeEqRef, ValTypeRef, ValTypeRefNull } from './wasm.zena';
import { StringBuilder } from 'zena:string-builder';
import { WasmEmitter } from './wasm-emitter.zena';
import { ValType, WasmType } from "./wasm.zena";
import { WasmFunction } from "./wasm-module.zena";
import { WasmExport } from './wasm-module.zena';
import { String } from 'zena:string';
import { i32ToString, f64ToString, i64ToString } from 'zena:string-convert';
import { Array } from 'zena:array';
import { ByteBuffer } from 'zena:byte-buffer';

export class WatEmitter implements WasmEmitter {
  sb: StringBuilder;
  var indentDepth: i32 = 1;
  var currentSuperTypeIndex: i32 = -1;
  var emittedRecGroup: boolean = false;
  
  new(this.sb);

  indent(): void {    
    for (var i = 0; i < this.indentDepth; i += 1) {
      this.sb.append('  ');
    }
  }

  // Module lifecycle
  emitModuleStart(): void {
    this.sb.append('(module\n');
  }
  
  emitTypeSectionStart(count: i32): void {}

  emitRecGroupStart(count: i32): void {
    if (count > 1) {
      this.indent();
      this.sb.append('(rec\n');
      this.indentDepth += 1;
      this.emittedRecGroup = true;
    } else {
      this.emittedRecGroup = false;
    }
  }

  emitRecGroupEnd(): void {
    if (this.emittedRecGroup) {
      this.indentDepth -= 1;
      this.indent();
      this.sb.append(')\n');
      this.emittedRecGroup = false;
    }
  }

  emitFunctionTypeStart(index: i32): void {
    this.indent();
    this.sb.append('(type (;').append(i32ToString(index)).append(';) (func');
  }
  
  emitFunctionTypeParamsStart(count: i32): void {}
  
  emitFunctionTypeParam(type: ValType): void {
    this.sb.append(' (param ').append(getTypeName(type)).append(')');
  }
  
  emitFunctionTypeResultsStart(count: i32): void {}
  
  emitFunctionTypeResult(type: ValType): void {
    this.sb.append(' (result ').append(getTypeName(type)).append(')');
  }
  
  emitFunctionTypeEnd(): void {
    this.sb.append('))\n');
  }

  emitStructTypeStart(index: i32, name: String | null, superTypeIndex: i32): void {
    this.currentSuperTypeIndex = superTypeIndex;
    this.indent();
    if (name != null) {
      this.sb.append('(type $').append(name as String).append(' (;').append(i32ToString(index)).append(';) ');
    } else {
      this.sb.append('(type (;').append(i32ToString(index)).append(';) ');
    }
    
    if (superTypeIndex >= 0) {
      this.sb.append('(sub ').append(i32ToString(superTypeIndex)).append(' ');
    }
    this.sb.append('(struct');
  }

  emitStructTypeFieldsStart(count: i32): void {}

  emitStructTypeField(type: ValType, isMutable: boolean): void {
    this.sb.append(' (field ');
    if (isMutable) {
      this.sb.append('(mut ');
    }
    this.sb.append(getTypeName(type));
    if (isMutable) {
      this.sb.append(')');
    }
    this.sb.append(')');
  }

  emitStructTypeEnd(): void {
    if (this.currentSuperTypeIndex >= 0) {
      this.sb.append(')))\n');
    } else {
      this.sb.append('))\n');
    }
    this.currentSuperTypeIndex = -1;
  }
  
  emitTypeSectionEnd(): void {}

  emitFunctionSectionStart(count: i32): void {}
  emitFunctionDefinition(typeIndex: i32): void {}
  emitFunctionSectionEnd(): void {}

  emitImportSectionStart(count: i32): void {}
  emitFunctionImport(module: String, name: String, typeIndex: i32): void {
    this.indent();
    this.sb.append('(import "').append(module).append('" "').append(name).append('" (func (type ').append(i32ToString(typeIndex)).append(')))\n');
  }
  emitGlobalImport(module: String, name: String, type: ValType, isMutable: boolean): void {
    this.indent();
    this.sb.append('(import "').append(module).append('" "').append(name).append('" (global ');
    if (isMutable) {
      this.sb.append('(mut ').append(getTypeName(type)).append(')');
    } else {
      this.sb.append(getTypeName(type));
    }
    this.sb.append('))\n');
  }
  emitImportSectionEnd(): void {}

  emitGlobalSectionStart(count: i32): void {}
  emitGlobal(type: ValType, isMutable: boolean): void {
    this.indent();
    this.sb.append('(global ');
    if (isMutable) {
      this.sb.append('(mut ').append(getTypeName(type)).append(')');
    } else {
      this.sb.append(getTypeName(type));
    }
    this.sb.append('\n');
    this.indentDepth += 1;
  }

  emitGlobalEnd(): void {
    this.indentDepth -= 1;
    this.indent();
    this.sb.append(')\n');
  }

  emitGlobalSectionEnd(): void {}
  
  emitExportSectionStart(count: i32): void {}
  
  emitExport(name: String, func: WasmFunction): void {
    this.indent();
    this.sb
        .append('(export "')
        .append(name)
        .append('" (func $')
        .append(getFunctionName(func))
        .append('))\n');
  }

  emitExportGlobal(name: String, globalIndex: i32): void {
    this.indent();
    this.sb
        .append('(export "')
        .append(name)
        .append('" (global ')
        .append(i32ToString(globalIndex))
        .append('))\n');
  }

  emitExportTag(name: String, tagIndex: i32): void {
    this.indent();
    this.sb
        .append('(export "')
        .append(name)
        .append('" (tag ')
        .append(i32ToString(tagIndex))
        .append('))\n');
  }

  emitExportSectionEnd(): void {}

  emitTagSectionStart(count: i32): void {}
  emitTagDefinition(index: i32, typeIndex: i32): void {
    this.indent();
    this.sb
        .append('(tag (;')
        .append(i32ToString(index))
        .append(';) (type ')
        .append(i32ToString(typeIndex))
        .append('))\n');
  }
  emitTagSectionEnd(): void {}

  emitElementSection(indices: Array<i32>): void {
    if (indices.length == 0) return;
    this.indent();
    this.sb.append('(elem declare func');
    for (let idx in indices) {
      this.sb.append(' ').append(i32ToString(idx));
    }
    this.sb.append(')\n');
  }
  
  emitStartSection(funcIndex: i32): void {
    this.indent();
    this.sb.append('(start ').append(i32ToString(funcIndex)).append(')\n');
  }
  
  emitCodeSectionStart(count: i32): void {}
  
  emitFunctionCodeStart(func: WasmFunction): void {}
  
  emitFunctionCodeEnd(func: WasmFunction): void {}
  emitCodeSectionEnd(): void {}
  
  emitModuleEnd(): void {
    this.sb.append(')\n');
  }

  // Instruction lifecycle
  emitFunctionSignatureStart(name: String, typeIndex: i32): void {
    this.indent();
    this.sb.append('(func $').append(name).append(' (type ').append(i32ToString(typeIndex)).append(')');
  }


  emitFunctionLocalsStart(locals: Array<ValType>): void {
    if (locals.length > 0) {
      this.sb.append('\n');
      this.indentDepth += 1;
      for (let l in locals) {
        this.indent();
        this.sb.append('(local ').append(getTypeName(l)).append(')\n');
      }
      this.indentDepth -= 1;
    }
    this.sb.append('\n');
    this.indentDepth += 1;
  }

  emitFunctionEnd(): void {
    this.indentDepth -= 1;
    this.indent();
    this.sb.append(')\n');
  }

  // Control flow
  emitUnreachable(): void {
    this.indent();
    this.sb.append('unreachable\n');
  }

  emitBlock(resultType: ValType): void {
    this.indent();
    if (resultType is ValTypeVoid ) {
      this.sb.append('block\n');
    } else {
      this.sb.append('block (result ').append(getTypeName(resultType)).append(')\n');
    }
    this.indentDepth += 1;
  }
  
  emitLoop(resultType: ValType): void {
    this.indent();
    if (resultType is ValTypeVoid ) {
      this.sb.append('loop\n');
    } else {
      this.sb.append('loop (result ').append(getTypeName(resultType)).append(')\n');
    }
    this.indentDepth += 1;
  }
  
  emitIf(resultType: ValType): void {
    this.indent();
    if (resultType is ValTypeVoid ) {
      this.sb.append('if\n');
    } else {
      this.sb.append('if (result ').append(getTypeName(resultType)).append(')\n');
    }
    this.indentDepth += 1;
  }
  
  emitElse(): void {
    this.indentDepth -= 1;
    this.indent();
    this.sb.append('else\n');
    this.indentDepth += 1;
  }
  
  emitEnd(): void {
    this.indentDepth -= 1;
    this.indent();
    this.sb.append('end\n');
  }
  
  emitBr(depth: i32): void {
    this.indent();
    this.sb.append('br ').append(i32ToString(depth)).append('\n');
  }
  
  emitBrIf(depth: i32): void {
    this.indent();
    this.sb.append('br_if ').append(i32ToString(depth)).append('\n');
  }

  emitThrow(tagIndex: i32): void {
    this.indent();
    this.sb.append('throw ').append(i32ToString(tagIndex)).append('\n');
  }

  emitTryTableCatch(resultType: ValType, tagIndex: i32, destDepth: i32): void {
    this.indent();
    this.sb.append('try_table');
    if (!(resultType is ValTypeVoid)) {
      this.sb.append(' (result ').append(getTypeName(resultType)).append(')');
    }
    this.sb
        .append(' (catch ')
        .append(i32ToString(tagIndex))
        .append(' ')
        .append(i32ToString(destDepth))
        .append(')\n');
    this.indentDepth += 1;
  }

  emitReturn(): void {
    this.indent();
    this.sb.append('return\n');
  }

  emitCall(target: WasmFunction): void {
    this.indent();
    this.sb.append('call $').append(getFunctionName(target)).append('\n');
  }

  emitCallRef(typeIndex: i32): void {
    this.indent();
    this.sb.append('call_ref ').append(i32ToString(typeIndex)).append('\n');
  }

  emitRefEq(): void {
    this.indent();
    this.sb.append('ref.eq\n');
  }

  emitRefIsNull(): void {
    this.indent();
    this.sb.append('ref.is_null\n');
  }

  emitRefFunc(index: i32): void {
    this.indent();
    this.sb.append('ref.func ').append(i32ToString(index)).append('\n');
  }

  emitRefNull(typeIndex: i32): void {
    this.indent();
    let typeStr = if (typeIndex == 0x71 || typeIndex == -15) {
      "none"
    } else if (typeIndex == 0x6d || typeIndex == -19) {
      "eq"
    } else if (typeIndex == 0x6e || typeIndex == -18) {
      "any"
    } else if (typeIndex == -16) {
      "struct"
    } else {
      i32ToString(typeIndex)
    };
    this.sb.append('ref.null ').append(typeStr).append('\n');
  }

  emitAnyConvertExtern(): void {
    this.indent();
    this.sb.append('any.convert_extern\n');
  }

  emitExternConvertAny(): void {
    this.indent();
    this.sb.append('extern.convert_any\n');
  }

  // GC operations
  emitStructNew(typeIndex: i32): void {
    this.indent();
    this.sb.append('struct.new ').append(i32ToString(typeIndex)).append('\n');
  }

  emitStructNewDefault(typeIndex: i32): void {
    this.indent();
    this.sb.append('struct.new_default ').append(i32ToString(typeIndex)).append('\n');
  }

  emitStructGet(typeIndex: i32, fieldIndex: i32): void {
    this.indent();
    this.sb.append('struct.get ').append(i32ToString(typeIndex)).append(' ').append(i32ToString(fieldIndex)).append('\n');
  }

  emitStructSet(typeIndex: i32, fieldIndex: i32): void {
    this.indent();
    this.sb.append('struct.set ').append(i32ToString(typeIndex)).append(' ').append(i32ToString(fieldIndex)).append('\n');
  }

  emitRefCastEq(): void {
    this.indent();
    this.sb.append('ref.cast eq\n');
  }

  emitRefCastEqNull(): void {
    this.indent();
    this.sb.append('ref.cast (ref null eq)\n');
  }

  emitRefCast(typeIndex: i32): void {
    this.indent();
    this.sb.append('ref.cast ').append(i32ToString(typeIndex)).append('\n');
  }

  emitRefCastNull(typeIndex: i32): void {
    this.indent();
    this.sb.append('ref.cast (ref null ').append(i32ToString(typeIndex)).append(')\n');
  }

  emitRefTest(typeIndex: i32): void {
    this.indent();
    this.sb.append('ref.test ').append(i32ToString(typeIndex)).append('\n');
  }

  emitRefTestNull(typeIndex: i32): void {
    this.indent();
    this.sb.append('ref.test_null ').append(i32ToString(typeIndex)).append('\n');
  }

  emitI32Const(value: i32): void {
    this.indent();
    this.sb.append('i32.const ').append(i32ToString(value)).append('\n');
  }

  emitF64Const(value: f64): void {
    this.indent();
    this.sb.append('f64.const ').append(f64ToString(value)).append('\n');
  }

  emitF32Const(value: f64): void {
    this.indent();
    this.sb.append('f32.const ').append(f64ToString(value)).append('\n');
  }

  emitBooleanConst(value: boolean): void {
    this.indent();
    var s = '0';
    if (value) {
      s = '1';
    }
    this.sb.append('i32.const ').append(s).append('\n');
  }

  emitStringConst(value: String): void {
    this.indent();
    this.sb.append(';; string "').append(value).append('"\n');
  }

  emitDrop(): void {
    this.indent();
    this.sb.append('drop\n');
  }

  // Variables
  emitLocalGet(index: i32): void {
    this.indent();
    this.sb.append('local.get ').append(i32ToString(index)).append('\n');
  }
  
  emitLocalSet(index: i32): void {
    this.indent();
    this.sb.append('local.set ').append(i32ToString(index)).append('\n');
  }
  
  emitLocalTee(index: i32): void {
    this.indent();
    this.sb.append('local.tee ').append(i32ToString(index)).append('\n');
  }

  emitGlobalGet(index: i32): void {
    this.indent();
    this.sb.append('global.get ').append(i32ToString(index)).append('\n');
  }
  
  emitGlobalSet(index: i32): void {
    this.indent();
    this.sb.append('global.set ').append(i32ToString(index)).append('\n');
  }

  // Binary operations
  emitI32Add(): void { this.indent(); this.sb.append('i32.add\n'); }
  emitI32Sub(): void { this.indent(); this.sb.append('i32.sub\n'); }
  emitI32Mul(): void { this.indent(); this.sb.append('i32.mul\n'); }
  emitI32DivS(): void { this.indent(); this.sb.append('i32.div_s\n'); }
  emitI32DivU(): void { this.indent(); this.sb.append('i32.div_u\n'); }
  emitI32Eqz(): void { this.indent(); this.sb.append('i32.eqz\n'); }
  emitI32Eq(): void { this.indent(); this.sb.append('i32.eq\n'); }
  emitI32Ne(): void { this.indent(); this.sb.append('i32.ne\n'); }
  emitI32LtS(): void { this.indent(); this.sb.append('i32.lt_s\n'); }
  emitI32LtU(): void { this.indent(); this.sb.append('i32.lt_u\n'); }
  emitI32LeS(): void { this.indent(); this.sb.append('i32.le_s\n'); }
  emitI32LeU(): void { this.indent(); this.sb.append('i32.le_u\n'); }
  emitI32GtS(): void { this.indent(); this.sb.append('i32.gt_s\n'); }
  emitI32GtU(): void { this.indent(); this.sb.append('i32.gt_u\n'); }
  emitI32GeS(): void { this.indent(); this.sb.append('i32.ge_s\n'); }
  emitI32GeU(): void { this.indent(); this.sb.append('i32.ge_u\n'); }
  emitI32RemS(): void { this.indent(); this.sb.append('i32.rem_s\n'); }
  emitI32RemU(): void { this.indent(); this.sb.append('i32.rem_u\n'); }
  emitI32And(): void { this.indent(); this.sb.append('i32.and\n'); }
  emitI32Or(): void { this.indent(); this.sb.append('i32.or\n'); }
  emitI32Xor(): void { this.indent(); this.sb.append('i32.xor\n'); }
  emitI32Shl(): void { this.indent(); this.sb.append('i32.shl\n'); }
  emitI32ShrS(): void { this.indent(); this.sb.append('i32.shr_s\n'); }
  emitI32ShrU(): void { this.indent(); this.sb.append('i32.shr_u\n'); }
  emitI32Clz(): void { this.indent(); this.sb.append('i32.clz\n'); }
  emitI32Ctz(): void { this.indent(); this.sb.append('i32.ctz\n'); }
  emitI32Popcnt(): void { this.indent(); this.sb.append('i32.popcnt\n'); }

  emitF64Add(): void { this.indent(); this.sb.append('f64.add\n'); }
  emitF64Sub(): void { this.indent(); this.sb.append('f64.sub\n'); }
  emitF64Mul(): void { this.indent(); this.sb.append('f64.mul\n'); }
  emitF64Div(): void { this.indent(); this.sb.append('f64.div\n'); }
  emitF64Eq(): void { this.indent(); this.sb.append('f64.eq\n'); }
  emitF64Ne(): void { this.indent(); this.sb.append('f64.ne\n'); }
  emitF64Lt(): void { this.indent(); this.sb.append('f64.lt\n'); }
  emitF64Gt(): void { this.indent(); this.sb.append('f64.gt\n'); }
  emitF64Le(): void { this.indent(); this.sb.append('f64.le\n'); }
  emitF64Ge(): void { this.indent(); this.sb.append('f64.ge\n'); }
  emitF64ConvertI32S(): void { this.indent(); this.sb.append('f64.convert_i32_s\n'); }

  emitF32Add(): void { this.indent(); this.sb.append('f32.add\n'); }
  emitF32Sub(): void { this.indent(); this.sb.append('f32.sub\n'); }
  emitF32Mul(): void { this.indent(); this.sb.append('f32.mul\n'); }
  emitF32Div(): void { this.indent(); this.sb.append('f32.div\n'); }
  emitF32Eq(): void { this.indent(); this.sb.append('f32.eq\n'); }
  emitF32Ne(): void { this.indent(); this.sb.append('f32.ne\n'); }
  emitF32Lt(): void { this.indent(); this.sb.append('f32.lt\n'); }
  emitF32Le(): void { this.indent(); this.sb.append('f32.le\n'); }
  emitF32Gt(): void { this.indent(); this.sb.append('f32.gt\n'); }
  emitF32Ge(): void { this.indent(); this.sb.append('f32.ge\n'); }
  emitF32ConvertI32S(): void { this.indent(); this.sb.append('f32.convert_i32_s\n'); }

  emitMemorySize(): void { this.indent(); this.sb.append('memory.size\n'); }
  emitMemoryGrow(): void { this.indent(); this.sb.append('memory.grow\n'); }
  emitI32Load(align: i32, offset: i32): void { this.indent(); this.sb.append(`i32.load align=${i32ToString(align)} offset=${i32ToString(offset)}\n`); }
  emitI32Store(align: i32, offset: i32): void { this.indent(); this.sb.append(`i32.store align=${i32ToString(align)} offset=${i32ToString(offset)}\n`); }
  emitI32Load8U(align: i32, offset: i32): void { this.indent(); this.sb.append(`i32.load8_u align=${i32ToString(align)} offset=${i32ToString(offset)}\n`); }
  emitI32Store8(align: i32, offset: i32): void { this.indent(); this.sb.append(`i32.store8 align=${i32ToString(align)} offset=${i32ToString(offset)}\n`); }

  emitArrayType(index: i32, elementType: ValType, isMutable: boolean): void {
    this.indent();
    this.sb.append('(type (;').append(i32ToString(index)).append(';) (array ');
    if (isMutable) {
      this.sb.append('(mut ');
    }
    this.sb.append(getTypeName(elementType));
    if (isMutable) {
      this.sb.append(')');
    }
    this.sb.append('))\n');
  }

  emitMemorySection(minPages: i32): void {
    this.indent();
    this.sb.append('(memory (;0;) ').append(i32ToString(minPages)).append(')\n');
  }

  emitExportMemory(name: String, memIndex: i32): void {
    this.indent();
    this.sb.append('(export "').append(name).append('" (memory ').append(i32ToString(memIndex)).append('))\n');
  }

  emitDataCountSection(count: i32): void {}

  emitDataSection(datas: Array<ByteBuffer>, rawDatas: Array<ByteBuffer>): void {
    var i = 0;
    for (let data in rawDatas) {
      this.indent();
      this.sb.append('(data (;').append(i32ToString(i)).append(';) "').append(escapeBytesForWat(data)).append('")\n');
      i += 1;
    }
  }

  emitArrayNew(typeIndex: i32): void {
    this.indent();
    this.sb.append('array.new ').append(i32ToString(typeIndex)).append('\n');
  }

  emitArrayNewDefault(typeIndex: i32): void {
    this.indent();
    this.sb.append('array.new_default ').append(i32ToString(typeIndex)).append('\n');
  }

  emitArrayNewFixed(typeIndex: i32, count: i32): void {
    this.indent();
    this.sb.append('array.new_fixed ').append(i32ToString(typeIndex)).append(' ').append(i32ToString(count)).append('\n');
  }

  emitArrayNewData(typeIndex: i32, dataIndex: i32): void {
    this.indent();
    this.sb.append('array.new_data ').append(i32ToString(typeIndex)).append(' ').append(i32ToString(dataIndex)).append('\n');
  }

  emitArrayGet(typeIndex: i32): void {
    this.indent();
    this.sb.append('array.get ').append(i32ToString(typeIndex)).append('\n');
  }

  emitArrayGetU(typeIndex: i32): void {
    this.indent();
    this.sb.append('array.get_u ').append(i32ToString(typeIndex)).append('\n');
  }

  emitArraySet(typeIndex: i32): void {
    this.indent();
    this.sb.append('array.set ').append(i32ToString(typeIndex)).append('\n');
  }

  emitArrayLen(): void {
    this.indent();
    this.sb.append('array.len\n');
  }

  emitArrayCopy(destTypeIndex: i32, srcTypeIndex: i32): void {
    this.indent();
    this.sb.append('array.copy ').append(i32ToString(destTypeIndex)).append(' ').append(i32ToString(srcTypeIndex)).append('\n');
  }

  emitI64Const(value: i64): void {
    this.indent();
    this.sb.append('i64.const ').append(i64ToString(value)).append('\n');
  }

  emitI64Add(): void { this.indent(); this.sb.append('i64.add\n'); }
  emitI64Sub(): void { this.indent(); this.sb.append('i64.sub\n'); }
  emitI64Mul(): void { this.indent(); this.sb.append('i64.mul\n'); }
  emitI64DivS(): void { this.indent(); this.sb.append('i64.div_s\n'); }
  emitI64DivU(): void { this.indent(); this.sb.append('i64.div_u\n'); }
  emitI64RemS(): void { this.indent(); this.sb.append('i64.rem_s\n'); }
  emitI64RemU(): void { this.indent(); this.sb.append('i64.rem_u\n'); }
  emitI64And(): void { this.indent(); this.sb.append('i64.and\n'); }
  emitI64Or(): void { this.indent(); this.sb.append('i64.or\n'); }
  emitI64Xor(): void { this.indent(); this.sb.append('i64.xor\n'); }
  emitI64Shl(): void { this.indent(); this.sb.append('i64.shl\n'); }
  emitI64ShrS(): void { this.indent(); this.sb.append('i64.shr_s\n'); }
  emitI64ShrU(): void { this.indent(); this.sb.append('i64.shr_u\n'); }

  emitI64Eqz(): void { this.indent(); this.sb.append('i64.eqz\n'); }
