import { 
  Node, Module, VariableDeclaration, FunctionExpression, IdentifierPattern,
  Identifier, NumberLiteral, BooleanLiteral, StringLiteral, BlockStatement,
  ReturnStatement, ExpressionStatement, Statement, Expression, CallExpression,
  ImportDeclaration, ImportSpecifier, ClassDeclaration, InterfaceDeclaration, DeclareFunction,
  TypeAliasDeclaration, RecordLiteral, MethodDefinition, FieldDefinition,
  AccessorDeclaration, SetterInfo, SuperInitializer, TypeParameter, MixinDeclaration,
  Parameter, TypeAnnotation, Decorator, Pattern, MemberExpression, AssignmentExpression
} from '../ast.zena';
import { walk } from '../visitor.zena';
import { RecordType, TupleType } from '../types.zena';
import { SemanticModel, InterfaceAdaptation } from '../semantic-model.zena';
import { Program, CompilationUnit } from '../program.zena';
import { SymbolId, Symbol } from '../scope/symbol.zena';
import { Error } from 'zena:error';
import { ValType, ValTypeVoid, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeFuncRef, ValTypeAnyRef, ValTypeStructRef, ValTypeEqRef, ValTypeRefNull, ValTypeRef, valTypeToOpcode, WasmType, valTypeEquals } from './wasm.zena';
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { UsageAnalyzer, UsageAnalysisResult } from '../analysis/usage.zena';
import { Type, FunctionType, I32Type, F32Type, F64Type, VoidType, BooleanType, ClassType, InterfaceType, TypeAliasType, U32Type, I64Type, U64Type, ArrayType, NullType, UnknownType, ErrorType, AnyType, AnyRefType, EqRefType, NeverType, HoleType, UnionType, FieldInfo, MethodInfo, TypeParameterType, typeToString} from '../types.zena';
import { String } from "zena:string";
import { i32ToString } from "zena:string-convert";

export class WasmExport {
  name: String;
  func: WasmFunction;
  new(this.name, this.func);
}

// TODO: Add string comparison to the stdlib and use that instead.
let compareStrings = (a: String, b: String): i32 => {
  let lenA = a.length;
  let lenB = b.length;
  var minLen = lenA;
  if (lenB < lenA) {
    minLen = lenB;
  }
  
  for (var i = 0; i < minLen; i += 1) {
    let byteA = a.getByteAt(i);
    let byteB = b.getByteAt(i);
    if (byteA < byteB) return -1;
    if (byteA > byteB) return 1;
  }
  
  if (lenA < lenB) return -1;
  if (lenA > lenB) return 1;
  return 0;
};

export let getMemberRootClass = (ct: ClassType, memberName: String): ClassType => {
  var rootClass = ct;
  var currClass = ct.superType;
  while (currClass != null) {
    let superCt = currClass as ClassType;
    var hasMember = superCt.members.has(memberName);
    if (!hasMember && memberName.startsWith("get#")) {
      let propName = memberName.sliceBytes(4, memberName.length);
      hasMember = superCt.members.has(propName);
    }
    if (!hasMember && memberName.startsWith("set#")) {
      let propName = memberName.sliceBytes(4, memberName.length);
      hasMember = superCt.members.has(propName);
    }
    if (hasMember) {
      rootClass = superCt;
    }
    currClass = superCt.superType;
  }
  return rootClass;
};

export let sortWasmFields = (fields: Array<WasmField>): void => {
  // Use insertion sort which has very low overhead for the
  // small length of arrays expected here.
  // TODO: Add sorting to the stdlib and use that instead.
  let len = fields.length;
  for (var i = 1; i < len; i += 1) {
    let key = fields[i];
    var j = i - 1;
    while (j >= 0) {
      let a = fields[j].name;
      let b = key.name;
      if (a != null && b != null) {
        if (compareStrings(a as String, b as String) > 0) {
          fields[j + 1] = fields[j];
          j -= 1;
        } else {
          break;
        }
      } else {
        break;
      }
    }
    fields[j + 1] = key;
  }
};

/**
 * Represents a reference to an entity that has a WebAssembly type index.
 * Before layout runs, the index is -1.
 */
export class WasmField {
  name: String | null;
  type: ValType;
  isMutable: boolean;
  new(this.name, this.type, this.isMutable);
}

export class WasmStruct extends WasmType {
  var superStruct: WasmStruct | null = null;
  var classType: ClassType | null = null;
  name: String | null;
  fields: Array<WasmField>;
  new(this.name, this.fields) : super();
}

export let getClassKey = (ct: ClassType): String => {
  return ct.name + "_" + i32ToString(ct.id as i32);
};

export let getInterfaceKey = (it: InterfaceType): String => {
  return it.name + "_" + i32ToString(it.id as i32);
};

/**
 * A WebAssembly function signature.
 * Deduped by the module so identical signatures share the same type index.

 * Params and returns are represented by WebAssembly ValType enums (e.g. i32, f64).
 */
export class WasmSignature extends WasmType {
  params: Array<ValType>;
  returns: Array<ValType>;
  new(this.params, this.returns) : super();
}

/**
 * Represents a single compiled WebAssembly function.
 * Tracks its eventual index, signature, and the AST node it was derived from.
 */
export class WasmFunction {
  /** The semantic model of the module that declares this function. */
  model: SemanticModel;
  var index: i32 = -1;
  var name: String | null = null;
  var methodName: String | null = null;
  var structType: WasmStruct | null = null;
  var classType: ClassType | null = null;
  var classDecl: ClassDeclaration | null = null;
  signature: WasmSignature;
  node: Node;
  var isImport: boolean = false;
  var isStatic: boolean = false;
  var importModule: String | null = null;
  var importName: String | null = null;
  var isCaseClassEq: boolean = false;
  var isCaseClassHash: boolean = false;
  /** The target class struct for a synthesized field getter. */
  var getterStruct: WasmStruct | null = null;
  /** The index of the field in the class struct for the synthesized getter. */
  var getterFieldIndex: i32 = -1;
  /** The target class struct for a synthesized field setter. */
  var setterStruct: WasmStruct | null = null;
  /** The index of the field in the class struct for the synthesized setter. */
  var setterFieldIndex: i32 = -1;
  /** The concrete target function for an interface trampoline method/property call. */
  var interfaceTrampolineTarget: WasmFunction | null = null;

  new(this.signature, this.node, this.model);
}

export class VTableInit {
  structType: WasmStruct;
  funcs: Array<WasmFunction>;
  new(this.structType, this.funcs);
}

export class WasmGlobal {
  var index: i32 = -1;
  name: String;
  zenaName: String;
  type: ValType;
  isMutable: boolean;
  var initExpr: Expression | null = null;
  var initVTable: VTableInit | null = null;
  var initSingletonStruct: ClassType | null = null;
  model: SemanticModel;
  new(this.name, this.zenaName, this.type, this.isMutable, this.initExpr, this.initVTable, this.model);
}

/**
 * Owns the intermediate representation of the WebAssembly module layout.
 * Acts as the registry for all WebAssembly entities (types, functions).
 * The DiscoveryPass populates this during AST traversal.
 */
export class RecordDispatchInfo {
  fatPtrType: WasmStruct;
  vtableType: WasmStruct;
  concreteType: WasmStruct;
  vtableGlobal: WasmGlobal;
  fields: Array<WasmField>;
  getterTypes: Array<WasmSignature>;
  
  new(this.fatPtrType, this.vtableType, this.concreteType, this.vtableGlobal, this.fields, this.getterTypes);
}

export class WasmModule {
  types = new Array<WasmType>();
  var isLayoutLocked: boolean = false;
  
  /** 
   * A complete list of all imported functions.
   */
  functionImports = new Array<WasmFunction>();

  /** 
   * A complete list of all functions in the module, including anonymous
   * functions that do not have a corresponding symbol. Array order dictates
   * the final WebAssembly function index.
   */
  functions = new Array<WasmFunction>();
  
  globals = new Array<WasmGlobal>();

  /**
   * Maps a Zena symbol ID to its compiled WebAssembly function.
   * Used to resolve call targets. Anonymous functions will not be in this map.
   */
  functionMap = new HashMap<SymbolId, WasmFunction>();
  
  /**
   * Maps a Zena symbol ID to its compiler intrinsic name (e.g. `memory.size`).
   */
  intrinsics = new HashMap<SymbolId, String>();

  globalMap = new HashMap<SymbolId, WasmGlobal>();

  exportMap = new HashMap<String, WasmFunction>();
  exportGlobalMap = new HashMap<String, WasmGlobal>();
  classStructs = new HashMap<String, WasmStruct>();
  classVTableStructs = new HashMap<String, WasmStruct>();
  classVTableGlobals = new HashMap<String, WasmGlobal>();
  classSingletonGlobals = new HashMap<String, WasmGlobal>();
  interfaceStructs = new HashMap<String, WasmStruct>();
  interfaceVTableStructs = new HashMap<String, WasmStruct>();
  classInterfaceVTables = new HashMap<String, WasmGlobal>();
  usedInterfaceAdaptations = new HashMap<String, boolean>();
  usedInterfaceMembers = new HashMap<String, boolean>();
  
  recordDispatchInfos = new Array<RecordDispatchInfo>();
  adaptedDispatchInfos = new Array<RecordDispatchInfo>();
  
  findRecordDispatch(fields: Array<WasmField>): RecordDispatchInfo | null {
    for (var k = 0; k < this.recordDispatchInfos.length; k += 1) {
      let info = this.recordDispatchInfos[k];
      if (info.fields.length == fields.length) {
        var match = true;
        for (var i = 0; i < fields.length; i += 1) {
          if (info.fields[i].name != fields[i].name || !valTypeEquals(info.fields[i].type, fields[i].type)) {
            match = false;
            break;
          }
        }
        if (match) return info;
      }
    }
    return null;
  }
  
  findAdaptedDispatch(inFields: Array<WasmField>, outFields: Array<WasmField>): RecordDispatchInfo | null {
    for (var k = 0; k < this.adaptedDispatchInfos.length; k += 1) {
      let info = this.adaptedDispatchInfos[k];
      let s = info.concreteType;
      var inMatch = false;
      if (s.fields.length == inFields.length) {
        inMatch = true;
        for (var i = 0; i < inFields.length; i += 1) {
          if (s.fields[i].name != inFields[i].name || !valTypeEquals(s.fields[i].type, inFields[i].type)) {
            inMatch = false;
            break;
          }
        }
      }
      if (inMatch && info.fields.length == outFields.length) {
        var outMatch = true;
        for (var i = 0; i < outFields.length; i += 1) {
          if (info.fields[i].name != outFields[i].name || !valTypeEquals(info.fields[i].type, outFields[i].type)) {
            outMatch = false;
            break;
          }
        }
        if (outMatch) {
          return info;
        }
      }
    }
    return null;
  }
  
  /**
   * Gets an existing WasmSignature if one matches the given parameters and
   * returns, or creates a new one and adds it to the type pool.
   * 
   * This performs a linear search through the existing types to find a
   * structural match, deduplicating identical signatures so they share the same
   * WebAssembly type index.
   */
  getSignature(params: Array<ValType>, returns: Array<ValType>): WasmSignature {
    for (let t in this.types) {
      if (t is WasmSignature) {
        let sig = t as WasmSignature;
        if (sig.params.length == params.length &&
            sig.returns.length == returns.length) {
          var match = true;
          for (var i = 0; i < params.length; i += 1) {
            if (!valTypeEquals(sig.params[i], params[i])) {
              match = false;
              break;
            }
          }
          if (match) {
            for (var i = 0; i < returns.length; i += 1) {
              if (!valTypeEquals(sig.returns[i], returns[i])) {
                match = false;
                break;
              }
            }
          }
          if (match) {
            return sig;
          }
        }
      }
    }
    let sig = new WasmSignature(params, returns);
    this.types.push(sig);
    return sig;
  }

  getStruct(name: String | null, fields: Array<WasmField>): WasmStruct {
    for (let t in this.types) {
      if (t is WasmStruct) {
        let s = t as WasmStruct;
        if (s.fields.length == fields.length) {
          var match = true;
          for (var i = 0; i < fields.length; i += 1) {
            // A struct matches if fields have same type and mutability.
            // Name doesn't matter for structural identity.
            if (!valTypeEquals(s.fields[i].type, fields[i].type) || s.fields[i].isMutable != fields[i].isMutable) {
              match = false;
              break;
            }
          }
          if (match) {
            return s;
          }
        }
      }
    }
    let st = new WasmStruct(name, fields);
    this.types.push(st);
    return st;
  }
  
  getRecordDispatch(model: SemanticModel, fields: Array<WasmField>): RecordDispatchInfo {
    sortWasmFields(fields);
    
    let existing = this.findRecordDispatch(fields);
    if (existing != null) {
      return existing;
    }
    if (this.isLayoutLocked) {
      throw new Error("Struct allocated after layout");
    }
    
    let concreteType = this.getStruct(null, fields);
    let vtableFields = new Array<WasmField>();
    let getterTypes = new Array<WasmSignature>();
    let getters = new Array<WasmFunction>();
    
    for (var i = 0; i < fields.length; i += 1) {
      let getterValType = fields[i].type;
      
      let params = new Array<ValType>();
      params.push(new ValTypeStructRef());
      
      let returns = new Array<ValType>();
      if (getterValType != new ValTypeVoid()) {
        returns.push(getterValType);
      }
      
      let getterType = this.getSignature(params, returns);
      getterTypes.push(getterType);
      
      let getterFunc = new WasmFunction(getterType, null, model);
      getterFunc.getterStruct = concreteType;
      getterFunc.getterFieldIndex = i;
      this.addFunction(getterFunc);
      getters.push(getterFunc);
      
      vtableFields.push(new WasmField(
        fields[i].name,
        new ValTypeRef(getterType),
        false
      ));
    }
    
    let vtableType = this.getStruct(null, vtableFields);
    
    let fatPtrFields = new Array<WasmField>();
    fatPtrFields.push(new WasmField(null, new ValTypeStructRef(), false));
    fatPtrFields.push(new WasmField(null, new ValTypeRef(vtableType), false));
    
    let fatPtrType = this.getStruct(null, fatPtrFields);
    
    let vtableInit = new VTableInit(vtableType, getters);
    let vtableGlobal = new WasmGlobal("vtable_record", "vtable_record", new ValTypeRef(vtableType), false, null, vtableInit, model);
    this.globals.push(vtableGlobal);
    
    let info = new RecordDispatchInfo(fatPtrType, vtableType, concreteType, vtableGlobal, fields, getterTypes);
    this.recordDispatchInfos.push(info);
    
    return info;
  }
  
  getAdaptedRecordDispatch(model: SemanticModel, inFields: Array<WasmField>, outFields: Array<WasmField>): RecordDispatchInfo {
    sortWasmFields(inFields);
    sortWasmFields(outFields);
    
    let existing = this.findAdaptedDispatch(inFields, outFields);
    if (existing != null) {
      return existing;
    }
    if (this.isLayoutLocked) {
      throw new Error("Struct allocated after layout");
    }
      
    let inStructType = this.getStruct(null, inFields);
    
    let vtableFields = new Array<WasmField>();
    let getterTypes = new Array<WasmSignature>();
    let getters = new Array<WasmFunction>();
    
    for (var i = 0; i < outFields.length; i += 1) {
      let fieldValType = outFields[i].type;
      
      let params = new Array<ValType>();
      params.push(new ValTypeStructRef());
      
      let returns = new Array<ValType>();
      if (fieldValType != new ValTypeVoid()) {
        returns.push(fieldValType);
      }
      
      let getterType = this.getSignature(params, returns);
      getterTypes.push(getterType);
      
      let getterFunc = new WasmFunction(getterType, null, model);
      getterFunc.getterStruct = inStructType;
      
      // Find the corresponding field in the inFields by name
      var inIndex = -1;
      for (var j = 0; j < inFields.length; j += 1) {
        if (inFields[j].name == outFields[i].name) {
          inIndex = j;
          break;
        }
      }
      
      getterFunc.getterFieldIndex = inIndex;
      this.addFunction(getterFunc);
      getters.push(getterFunc);
      
      vtableFields.push(new WasmField(
        outFields[i].name,
        new ValTypeRef(getterType),
        false
      ));
    }
    
    let vtableType = this.getStruct(null, vtableFields);
    
    let fatPtrFields = new Array<WasmField>();
    fatPtrFields.push(new WasmField(null, new ValTypeStructRef(), false));
    fatPtrFields.push(new WasmField(null, new ValTypeRef(vtableType), false));
    
    let fatPtrType = this.getStruct(null, fatPtrFields);
    
    let vtableInit = new VTableInit(vtableType, getters);
    // TODO: better naming since keyStr is gone
    let vtableGlobal = new WasmGlobal("vtable_adapt", "vtable_adapt", new ValTypeRef(vtableType), false, null, vtableInit, model);
    this.globals.push(vtableGlobal);
    
    // We return information about the TARGET shape (outFields), but with a vtable matching our adapted getters
    let info = new RecordDispatchInfo(fatPtrType, vtableType, inStructType, vtableGlobal, outFields, getterTypes);
    this.adaptedDispatchInfos.push(info);
    
    return info;
  }

  addFunction(func: WasmFunction): void {
    this.functions.push(func);
  }
  
  /**
   * Locks in the module layout, assigning final WebAssembly indices (i32)
   * to all types, functions, and globals. Must be called after all
   * discoveries are made, but before the emission passes begin.
   */
  layout(): void {
    this.isLayoutLocked = true;
    for (var i = 0; i < this.types.length; i += 1) {
      let t = this.types[i];
      t.index = i;
    }
    var functionIndex = 0;
    for (var i = 0; i < this.functionImports.length; i += 1) {
      let f = this.functionImports[i];
      f.index = functionIndex;
      functionIndex += 1;
    }
    for (var i = 0; i < this.functions.length; i += 1) {
      let f = this.functions[i];
      f.index = functionIndex;
      functionIndex += 1;
    }
    for (var i = 0; i < this.globals.length; i += 1) {
      let g = this.globals[i];
      g.index = i;
    }
  }
}

/**
 * Traverses a Zena Program's AST to discover all functions, structs, and 
 * imports that need to be emitted into the WebAssembly module.
 * Dedupes signatures and assigns Zena Symbols to WasmFunctions.
 */
export class DiscoveryPass {
  program: Program;
  wasm: WasmModule;
  usage: UsageAnalysisResult;
  new(this.program, this.wasm, this.usage);
  
  getClassType(node: ClassDeclaration, model: SemanticModel): ClassType | null {
    let t = model.getNodeType(node);
    if (t is ClassType) {
      return t as ClassType;
    }
    let sym = model.resolve(node);
    if (sym != null) {
      let bt = model.getBindingType(sym);
      if (bt is ClassType) {
        return bt as ClassType;
      }
    }
    return null;
  }

  discoverType(t: Type | null, model: SemanticModel): void {
     if (t == null) { return; }
     if (t is RecordType) {
        let rec = t as RecordType;
        for (let pair in rec.properties) {
           this.discoverType(pair.value, model);
        }
        let fields = new Array<WasmField>();
        for (let pair in rec.properties) {
           fields.push(new WasmField(pair.key, typeToValType(this.wasm, pair.value), false));
        }
        this.wasm.getRecordDispatch(model, fields);
     } else if (t is TupleType) {
        let tup = t as TupleType;
        for (var i = 0; i < tup.elementTypes.length; i += 1) {
           this.discoverType(tup.elementTypes[i], model);
        }
        let fields = new Array<WasmField>();
        for (var i = 0; i < tup.elementTypes.length; i += 1) {
           let type = tup.elementTypes[i];
           fields.push(new WasmField(i32ToString(i), typeToValType(this.wasm, type), false));
        }
        this.wasm.getStruct(null, fields);
     } else if (t is FunctionType) {
        let ft = t as FunctionType;
        for (let paramType in ft.parameters) {
           this.discoverType(paramType, model);
        }
        this.discoverType(ft.returnType, model);
     } else if (t is ClassType) {
        let ct = t as ClassType;
        for (let pair in ct.members) {
           if (pair.value is FieldInfo) {
              this.discoverType(pair.value.type, model);
           }
        }
     }
  }

  registerClassMethod(
      cType: ClassType,
      cDecl: ClassDeclaration | null,
      methName: String,
      methodNode: Node | null,
      isSynthesizedGetter: boolean,
      isSynthesizedSetter: boolean,
      backingFieldName: String | null,
      model: SemanticModel): void {
    var methodTypeNode: Type | null = null;
    if (cType != null) {
      if (methName == "<constructor>") {
        methodTypeNode = cType.constructorType;
      } else {
        if (cType.members.has(methName)) {
          methodTypeNode = cType.members[methName].type;
        } else if (methName.startsWith("get#")) {
          let fieldName = methName.sliceBytes(4, methName.length);
          if (cType.members.has(fieldName) && cType.members[fieldName] is FieldInfo) {
            let fi = cType.members[fieldName] as FieldInfo;
            methodTypeNode = new FunctionType(new Array<Type>(), null, fi.type);
          }
        } else if (methName.startsWith("set#")) {
          let fieldName = methName.sliceBytes(4, methName.length);
          if (cType.members.has(fieldName) && cType.members[fieldName] is FieldInfo) {
            let fi = cType.members[fieldName] as FieldInfo;
            let params = new Array<Type>();
            params.push(fi.type);
            methodTypeNode = new FunctionType(params, null, new VoidType());
          }
        }
      }
    }

    let params = new Array<ValType>();
    let returns = new Array<ValType>();

    var rootClass = if (methName == "<constructor>") cType else getMemberRootClass(cType, methName);

    var isStatic = false;
    if (methodNode != null) {
      let nodeVal = methodNode as Node;
      if (nodeVal is MethodDefinition) {
        isStatic = (nodeVal as MethodDefinition).isStatic;
      } else if (nodeVal is AccessorDeclaration) {
        isStatic = (nodeVal as AccessorDeclaration).isStatic;
      } else if (nodeVal is FieldDefinition) {
        isStatic = (nodeVal as FieldDefinition).isStatic;
      }
    }

    if (!isStatic) {
      if (cType.isExtension && cType.onType != null) {
        params.push(typeToValType(this.wasm, cType.onType as Type));
      } else {
        if (this.wasm.classStructs.has(getClassKey(rootClass))) {
          params.push(new ValTypeRefNull(this.wasm.classStructs[getClassKey(rootClass)]));
        } else {
          params.push(new ValTypeStructRef());
        }
      }
    }
    if (methodTypeNode is FunctionType) {
      let fType = methodTypeNode as FunctionType;
      for (let p in fType.parameters) {
        params.push(typeToValType(this.wasm, p));
      }
      if (methName != "<constructor>") {
        let rType = fType.returnType;
        if (!(rType is VoidType)) returns.push(typeToValType(this.wasm, rType));
      }
    } else {
      if (methName != "<constructor>") {
        returns.push(new ValTypeI32());
      }
    }
    
    let sig = this.wasm.getSignature(params, returns);
    let wasmFunc = new WasmFunction(sig, methodNode, model);
    wasmFunc.isStatic = isStatic;
    this.wasm.addFunction(wasmFunc);
    let cName = if (cDecl != null) (cDecl as ClassDeclaration).name.name else cType.name;
    wasmFunc.name = cName + "." + methName;
    wasmFunc.methodName = methName;
    wasmFunc.classDecl = cDecl;
    
    wasmFunc.classType = cType;
    if (this.wasm.classStructs.has(getClassKey(cType))) {
        wasmFunc.structType = this.wasm.classStructs[getClassKey(cType)];
    }

    if (isSynthesizedGetter && backingFieldName != null) {
      let st = wasmFunc.structType;
      if (st != null) {
        var idx = -1;
        let backingName = backingFieldName as String;
        let lookupBackingName = if (backingName.length > 0 && backingName.sliceBytes(0, 1) == "#") {
          getClassKey(cType) + "::" + backingName
        } else {
          backingName
        };
        for (var fi = 0; fi < (st as WasmStruct).fields.length; fi += 1) {
          if ((st as WasmStruct).fields[fi].name == lookupBackingName) {
            idx = fi;
          }
        }
        wasmFunc.getterStruct = st;
        wasmFunc.getterFieldIndex = idx;
      }
    } else if (isSynthesizedSetter && backingFieldName != null) {
      let st = wasmFunc.structType;
      if (st != null) {
        var idx = -1;
        let backingName = backingFieldName as String;
        let lookupBackingName = if (backingName.length > 0 && backingName.sliceBytes(0, 1) == "#") {
          getClassKey(cType) + "::" + backingName
        } else {
          backingName
        };
        for (var fi = 0; fi < (st as WasmStruct).fields.length; fi += 1) {
          if ((st as WasmStruct).fields[fi].name == lookupBackingName) {
            idx = fi;
          }
        }
        wasmFunc.setterStruct = st;
        wasmFunc.setterFieldIndex = idx;
      }
    }
  }

  /**
   * Run the discovery pass on the program, populating the given WasmModule.
   */
  run(): void {
    // Preliminary Pass: Discover all referenced interface members across all compilation units
    for (let unit in this.program.units) {
      let mod = unit.ast;
      let moduleModel = unit.model;
      walk(mod as Node, (n: Node) => true, (n: Node) => {
        if (n is MemberExpression) {
          let mem = n as MemberExpression;
          let objType = moduleModel.getNodeType(mem.object);
          if (objType is InterfaceType) {
            let it = objType as InterfaceType;
            let iName = getInterfaceKey(it);
            let propName = mem.property.name;
            if (it.members.has(propName)) {
              let member = it.members[propName];
              if (member is MethodInfo) {
                this.wasm.usedInterfaceMembers[iName + "::" + propName] = true;
              } else if (member is FieldInfo) {
                this.wasm.usedInterfaceMembers[iName + "::get#" + propName] = true;
              }
            }
          }
        } else if (n is AssignmentExpression) {
          let assign = n as AssignmentExpression;
          if (assign.left is MemberExpression) {
            let mem = assign.left as MemberExpression;
            let objType = moduleModel.getNodeType(mem.object);
            if (objType is InterfaceType) {
              let it = objType as InterfaceType;
              let iName = getInterfaceKey(it);
              let propName = mem.property.name;
              if (it.members.has(propName)) {
                let member = it.members[propName];
                if (member is FieldInfo) {
                  let fi = member as FieldInfo;
                  if (fi.isMutable) {
                    this.wasm.usedInterfaceMembers[iName + "::set#" + propName] = true;
                  }
                }
              }
            }
          }
        }
      });
    }

    for (let unit in this.program.units) {
      let mod = unit.ast;
      let moduleModel = unit.model;
      
      // Pass 0: Pre-register empty WasmStructs for all nominal classes to break cyclic dependencies
      walk(mod as Node, (n: Node) => true, (n: Node) => {
        if (n is ClassDeclaration) {
          let classDecl = n as ClassDeclaration;
          let classType = this.getClassType(classDecl, moduleModel);
          if (classType is ClassType) {
            let cType = classType as ClassType;
            if (cType.isExtension) { return; }
            let cKey = getClassKey(cType);
            if (!this.wasm.classStructs.has(cKey)) {
              let emptyStruct = new WasmStruct(cType.name, new Array<WasmField>());
              emptyStruct.classType = cType;
              this.wasm.types.push(emptyStruct);
              this.wasm.classStructs[cKey] = emptyStruct;
              let emptyVTableStruct = new WasmStruct(cType.name + "_VTable", new Array<WasmField>());
              emptyVTableStruct.classType = cType;
              this.wasm.types.push(emptyVTableStruct);
              this.wasm.classVTableStructs[cKey] = emptyVTableStruct;
            }
            if (cType.sealedVariants != null) {
              let variants = cType.sealedVariants as Array<ClassType>;
              for (let vType in variants) {
                if (vType == null) { continue; }
                let vKey = getClassKey(vType);
                if (!this.wasm.classStructs.has(vKey)) {
                  let emptyStruct = new WasmStruct(vType.name, new Array<WasmField>());
                  emptyStruct.classType = vType;
                  this.wasm.types.push(emptyStruct);
                  this.wasm.classStructs[vKey] = emptyStruct;
                  let emptyVTableStruct = new WasmStruct(vType.name + "_VTable", new Array<WasmField>());
                  emptyVTableStruct.classType = vType;
                  this.wasm.types.push(emptyVTableStruct);
                  this.wasm.classVTableStructs[vKey] = emptyVTableStruct;
                }
              }
            }
          }
        } else if (n is InterfaceDeclaration) {
          let ifaceDecl = n as InterfaceDeclaration;
          let ifaceType = moduleModel.getNodeType(ifaceDecl);
          if (ifaceType is InterfaceType) {
            let it = ifaceType as InterfaceType;
            let emptyVTableStruct = new WasmStruct(it.name + "_VTable", new Array<WasmField>());
            this.wasm.types.push(emptyVTableStruct);
            this.wasm.interfaceVTableStructs[getInterfaceKey(it)] = emptyVTableStruct;

            let fatPtrFields = new Array<WasmField>();
            fatPtrFields.push(new WasmField("instance", new ValTypeStructRef(), false));
            fatPtrFields.push(new WasmField("vtable", new ValTypeRef(emptyVTableStruct), false));
            let emptyStruct = new WasmStruct(it.name + "_FatPtr", fatPtrFields);
            this.wasm.types.push(emptyStruct);
            this.wasm.interfaceStructs[getInterfaceKey(it)] = emptyStruct;
          }
        }
      });
      
      // Pass 0.5: Link superStruct for inheritance and figure out vtable array
      walk(mod as Node, (n: Node) => true, (n: Node) => {
        if (n is ClassDeclaration) {
          let classDecl = n as ClassDeclaration;
          let classType = this.getClassType(classDecl, moduleModel);
          if (classType is ClassType) {
            let cType = classType as ClassType;
            if (cType.isExtension) { return; }

            let linkSuperAndVT = (ct: ClassType) => {
              if (ct.superType != null) {
                let superCt = ct.superType as ClassType;
                let cKey = getClassKey(ct);
                let superKey = getClassKey(superCt);
                
                if (!this.wasm.classStructs.has(cKey) || !this.wasm.classStructs.has(superKey)) {
                  console.log("Error: linkSuperAndVT missing struct for cKey: " + cKey + " or superKey: " + superKey);
                  return;
                }
                
                let st = this.wasm.classStructs[cKey];
                st.superStruct = this.wasm.classStructs[superKey];
                
                if (this.wasm.classVTableStructs.has(cKey) && this.wasm.classVTableStructs.has(superKey)) {
                  let vst = this.wasm.classVTableStructs[cKey];
                  vst.superStruct = this.wasm.classVTableStructs[superKey];
                }
                
                // Inherit vtable slots from supertype
                if (superCt.vtable != null) {
                  for (let methName in superCt.vtable) {
                    var hasMeth = false;
                    for (let existing in ct.vtable) {
                      if (existing == methName) { hasMeth = true; }
                    }
                    if (!hasMeth) {
                      ct.vtable.push(methName);
                    }
                  }
                }
              }
            };

            linkSuperAndVT(cType);

            // Add new methods to vtable slots
            let mixinMembers = new Array<Node>();
            let seenMixins = new HashMap<String, boolean>();
            collectMixinMembers(moduleModel, classDecl.mixins, mixinMembers, seenMixins);

            let allMembers = new Array<Node>();
            for (let ms in classDecl.body) {
              allMembers.push(ms);
            }
            for (let ms in mixinMembers) {
              allMembers.push(ms);
            }

            for (let ms in allMembers) {
              if (ms is MethodDefinition) {
                let mDef = ms as MethodDefinition;
                if (mDef.isStatic) { continue; }
                if (mDef.name is Identifier) {
                  let methName = (mDef.name as Identifier).name;
                  var found = false;
                  for (let existing in cType.vtable) {
                    if (existing == methName) { found = true; }
                  }
                  if (!found && methName != "<constructor>") {
                    cType.vtable.push(methName);
                  }
                }
              } else if (ms is AccessorDeclaration) {
                let acc = ms as AccessorDeclaration;
                if (acc.isStatic) { continue; }
                if (acc.name is Identifier) {
                  let accName = (acc.name as Identifier).name;
                  if (acc.getter != null) {
                    let getterName = "get#" + accName;
                    var found = false;
                    for (let existing in cType.vtable) {
                      if (existing == getterName) {
                        found = true;
                        break;
                      }
                    }
                    if (!found) {
                      cType.vtable.push(getterName);
                    }
                  }
                  if (acc.setter != null) {
                    let setterName = "set#" + accName;
                    var found = false;
                    for (let existing in cType.vtable) {
                      if (existing == setterName) {
                        found = true;
                        break;
                      }
                    }
                    if (!found) {
                      cType.vtable.push(setterName);
                    }
                  }
                }
              } else if (ms is FieldDefinition) {
                let fd = ms as FieldDefinition;
                if (fd.isStatic) { continue; }
                if (fd.name is Identifier) {
                  let fieldName = (fd.name as Identifier).name;
                  if (fd.setterName != null) {
                    let getterName = "get#" + fieldName;
                    var found = false;
                    for (let existing in cType.vtable) {
                      if (existing == getterName) {
                        found = true;
                        break;
                      }
                    }
                    if (!found) {
                      cType.vtable.push(getterName);
                    }
                  }
                  if (fd.isAbstract) {
                    let getterName = "get#" + fieldName;
                    var found = false;
                    for (let existing in cType.vtable) {
                      if (existing == getterName) {
                        found = true;
                        break;
                      }
                    }
                    if (!found) {
                      cType.vtable.push(getterName);
                    }
                    if (fd.mutability != null && fd.mutability == "var") {
                      let setterName = "set#" + fieldName;
                      var foundS = false;
                      for (let existing in cType.vtable) {
                        if (existing == setterName) {
                          foundS = true;
                          break;
                        }
                      }
                      if (!foundS) {
                        cType.vtable.push(setterName);
                      }
                    }
                  }
                }
              }
            }

            if (cType.sealedVariants != null) {
              let variants = cType.sealedVariants as Array<ClassType>;
              for (let vType in variants) {
                if (vType == null) { continue; }
                let vKey = getClassKey(vType);
                if (!this.wasm.classStructs.has(vKey)) {
                  console.log("Error: classStructs missing key: " + vKey + " for variant of sealed class " + cType.name);
                  continue;
                }
                let vst = this.wasm.classStructs[vKey];
                if (vst.superStruct == null) {
                  linkSuperAndVT(vType);
                }
              }
            }
          }
        }
      });
      
      // First, discover any record types used in any node and register their Structs
      walk(mod as Node, (n: Node) => true, (n: Node) => {
        let nodeType = moduleModel.getNodeType(n);
        this.discoverType(nodeType, moduleModel);
        
        if (n is Expression) {
          let expr = n as Expression;
          let adaptation = moduleModel.getRecordAdaptation(expr);
          if (adaptation != null) {
            this.discoverType(adaptation.target, moduleModel);
            
            let inFields = new Array<WasmField>();
            for (let pair in adaptation.source.properties) {
              inFields.push(new WasmField(pair.key, typeToValType(this.wasm, pair.value), false));
            }
            let outFields = new Array<WasmField>();
            for (let pair in adaptation.target.properties) {
              outFields.push(new WasmField(pair.key, typeToValType(this.wasm, pair.value), false));
            }
            this.wasm.getAdaptedRecordDispatch(moduleModel, inFields, outFields);
          }
          
          let ifaceAdaptation = moduleModel.getInterfaceAdaptation(expr);
          if (ifaceAdaptation != null) {
            let adapt = ifaceAdaptation as InterfaceAdaptation;
            let cName = getClassKey(adapt.source);
            let iName = getInterfaceKey(adapt.target);
            this.wasm.usedInterfaceAdaptations[cName + "::" + iName] = true;
          }
        } else if (n is ClassDeclaration) {
          // Defer populating to Pass 1 statement loop
        } else if (n is InterfaceDeclaration) {
          let ifaceDecl = n as InterfaceDeclaration;
          let ifaceType = moduleModel.getNodeType(ifaceDecl);
          if (ifaceType is InterfaceType) {
            let it = ifaceType as InterfaceType;
            let iName = getInterfaceKey(it);
            let vst = this.wasm.interfaceVTableStructs[iName];
            let keys = it.members.keys();
            while (let (true, key) = keys.next()) {
              let member = it.members[key];
              match (member) {
                case FieldInfo as fi: {
                  let getterKey = iName + "::get#" + key;
                  if (this.wasm.usedInterfaceMembers.has(getterKey)) {
                    let sig = getInterfaceMemberSignature(this.wasm, it, "get#" + key);
                    vst.fields.push(new WasmField("get#" + key, new ValTypeRef(sig), false));
                  }
                  if (fi.isMutable) {
                    let setterKey = iName + "::set#" + key;
                    if (this.wasm.usedInterfaceMembers.has(setterKey)) {
                      let sig = getInterfaceMemberSignature(this.wasm, it, "set#" + key);
                      vst.fields.push(new WasmField("set#" + key, new ValTypeRef(sig), false));
                    }
                  }
                }
                case MethodInfo as mi: {
                  let methodKey = iName + "::" + key;
                  if (this.wasm.usedInterfaceMembers.has(methodKey)) {
                    let sig = getInterfaceMemberSignature(this.wasm, it, key);
                    vst.fields.push(new WasmField(key, new ValTypeRef(sig), false));
                  }
                }
                case _: {}
              }
            }
          }
        }
      });
      
      for (let stmt in mod.body) {
        if (stmt == null) {
          continue;
        }
        match (stmt) {
          case VariableDeclaration: {
            let varDecl = stmt as VariableDeclaration;
            var isNeeded = false;
            
            if (varDecl.exported) {
              isNeeded = true;
            } else if (varDecl.pattern is IdentifierPattern) {
              if (this.usage.isUsed(varDecl.pattern as Node)) {
                isNeeded = true;
              }
            }
            
            if (this.usage.isUsed(stmt as Node)) {
              isNeeded = true;
            }

            if (isNeeded) {
              let varDecl = stmt as VariableDeclaration;
              if (varDecl.init is FunctionExpression) {
                let funcExpr = varDecl.init as FunctionExpression;
                let funcTypeNode = moduleModel.getNodeType(funcExpr);
                let params = new Array<ValType>();
                let returns = new Array<ValType>();
                
                if (funcTypeNode is FunctionType) {
                  let fType = funcTypeNode as FunctionType;
                  for (let p in fType.parameters) {
                    params.push(typeToValType(this.wasm, p));
                  }
                  let rType = fType.returnType;
                  if (!(rType is VoidType)) returns.push(typeToValType(this.wasm, rType));
                } else {
                  returns.push(new ValTypeI32());
                }
                
                let sig = this.wasm.getSignature(params, returns);
                let wasmFunc = new WasmFunction(sig, funcExpr, moduleModel);
                this.wasm.addFunction(wasmFunc);
                
                if (varDecl.pattern is IdentifierPattern) {
                  let ident = varDecl.pattern as IdentifierPattern;
                  wasmFunc.name = ident.name;
                  let sym = moduleModel.resolveDeclaration(ident);
                  if (sym != null) {
                    this.wasm.functionMap[sym.id] = wasmFunc;
                    if (varDecl.exported) {
                      this.wasm.exportMap[ident.name] = wasmFunc;
                    }
                  }
                }
              } else {
                // Global Variable
                if (varDecl.pattern is IdentifierPattern && varDecl.init != null) {
                  let ident = varDecl.pattern as IdentifierPattern;
                  let expr = varDecl.init as Expression;
                  let nodeType = moduleModel.getNodeType(ident);
                  var isMutable = varDecl.kind == "var";
                  
                  var vType = typeToValType(this.wasm, nodeType);

                  let sym = moduleModel.resolveDeclaration(ident);
                  if (sym != null) {
                    let name = ident.name + "_" + i32ToString(sym.id as i32);
                    let wasmGlobal = new WasmGlobal(name, ident.name, vType, isMutable, expr, null, moduleModel);
                    this.wasm.globals.push(wasmGlobal);
                    this.wasm.globalMap[sym.id] = wasmGlobal;
                    
                    if (varDecl.exported) {
                      this.wasm.exportGlobalMap[ident.name] = wasmGlobal;
                    }
                  }
                }
              }
            }
          }
          case ImportDeclaration: {}
          case ClassDeclaration: {
            let classDecl = stmt as ClassDeclaration;
            let classType = this.getClassType(classDecl, moduleModel) as ClassType;

            // Register static fields as globals
            for (let member in classDecl.body) {
              if (member is FieldDefinition) {
                let fd = member as FieldDefinition;
                if (fd.isStatic && fd.name is Identifier) {
                  let fieldName = (fd.name as Identifier).name;
                  let fType = if (classType != null && (classType as ClassType).members.has(fieldName)) {
                    (classType as ClassType).members[fieldName].type
                  } else {
                    moduleModel.getNodeType(fd)
                  };
                  let vType = typeToValType(this.wasm, fType);
                  let name = classDecl.name.name + "_" + fieldName;
                  let initExp = if (fd.value != null) { fd.value as Expression } else { null as Expression };
                  let wasmGlobal = new WasmGlobal(name, fieldName, vType, true, initExp, null, moduleModel);
                  this.wasm.globals.push(wasmGlobal);
                }
              }
            }

            let registerClassMethod = (
                cType: ClassType,
                cDecl: ClassDeclaration | null,
                methName: String,
                methodNode: Node | null,
                isSynthesizedGetter: boolean,
                isSynthesizedSetter: boolean,
                backingFieldName: String | null) => {
              this.registerClassMethod(cType, cDecl, methName, methodNode, isSynthesizedGetter, isSynthesizedSetter, backingFieldName, moduleModel);
            };

            let populateClassStructAndMethods = (ct: ClassType, cd: ClassDeclaration | null) => {
              if (ct.isCaseClass) {
                if (!ct.members.has("==")) {
                  let eqParams = new Array<Type>();
                  eqParams.push(ct);
                  let eqNames = new Array<String>();
                  eqNames.push("other");
                  ct.members["=="] = new MethodInfo(new FunctionType(eqParams, eqNames, new BooleanType()), false, false, false, false);
                }
                var hasEqV = false;
                for (let existing in ct.vtable) {
                  if (existing == "==") { hasEqV = true; }
                }
                if (!hasEqV) {
                  ct.vtable.push("==");
                }

                if (!ct.members.has("hashCode")) {
                  ct.members["hashCode"] = new MethodInfo(new FunctionType(new Array<Type>(), null, new I32Type()), false, false, false, false);
                }
                var hasHashV = false;
                for (let existing in ct.vtable) {
                  if (existing == "hashCode") { hasHashV = true; }
                }
                if (!hasHashV) {
                  ct.vtable.push("hashCode");
                }
              }

              let vst = this.wasm.classVTableStructs[getClassKey(ct)];
              if (vst.fields.length == 0) {
                for (let methName in ct.vtable) {
                  vst.fields.push(new WasmField(methName, new ValTypeFuncRef(), false));
                }
              }

              let st = this.wasm.classStructs[getClassKey(ct)];
              if (st.fields.length == 0) {
                let fields = new Array<WasmField>();
                if (ct.superType != null) {
                  let superKey = getClassKey(ct.superType as ClassType);
                  let superSt = this.wasm.classStructs[superKey];
                  for (let f in superSt.fields) {
                    fields.push(f);
                  }
                } else {
                  var rootVst = vst;
                  while (rootVst.superStruct != null) {
                    rootVst = rootVst.superStruct as WasmStruct;
                  }
                  fields.push(new WasmField("<vtable>", new ValTypeRefNull(rootVst), true));
                }

                let isStaticField = (name: String): boolean => {
                  if (cd == null) return false;
                  for (let ms in (cd as ClassDeclaration).body) {
                    if (ms is FieldDefinition) {
                      let fd = ms as FieldDefinition;
                      if (fd.name is Identifier) {
                        if ((fd.name as Identifier).name == name) {
                          return fd.isStatic;
                        }
                      }
                    }
                  }
                  return false;
                };

                for (let pair in ct.members) {
                  if (pair.value is MethodInfo) {
                    continue;
                  }
                  if (pair.value.isAbstract) {
                    continue;
                  }
                  if (isStaticField(pair.key)) {
                    continue;
                  }
                  var isInherited = false;
                  if (ct.superType != null) {
                    let superKey = getClassKey(ct.superType as ClassType);
                    let superSt = this.wasm.classStructs[superKey];
                    for (let sf in superSt.fields) {
                      if (sf.name == pair.key) {
                        isInherited = true;
                      }
                    }
                  }
                  if (!isInherited) {
                    let fName = if (pair.key.length > 0 && pair.key.sliceBytes(0, 1) == "#") {
                      getClassKey(ct) + "::" + pair.key
                    } else {
                      pair.key
                    };
                    fields.push(new WasmField(fName, typeToValType(this.wasm, pair.value.type), true));
                  }
                }
                for (let f in fields) {
                  st.fields.push(f);
                }
              }

              if (ct.isCaseClass) {
                var hasCtor = false;
                for (let f in this.wasm.functions) {
                  if (f.classType != null && (f.classType as ClassType).id == ct.id && f.methodName == "<constructor>") {
                    hasCtor = true;
                    break;
                  }
                }
                if (!hasCtor) {
                  registerClassMethod(ct, cd, "<constructor>", null, false, false, null);
                }

                var hasEq = false;
                for (let f in this.wasm.functions) {
                  if (f.classType != null && (f.classType as ClassType).id == ct.id && f.methodName == "==") {
                    hasEq = true;
                    break;
                  }
                }
                if (!hasEq) {
                  registerClassMethod(ct, cd, "==", null, false, false, null);
                  let eqFunc = this.wasm.functions[this.wasm.functions.length - 1];
                  eqFunc.isCaseClassEq = true;
                }

                var hasHash = false;
                for (let f in this.wasm.functions) {
                  if (f.classType != null && (f.classType as ClassType).id == ct.id && f.methodName == "hashCode") {
                    hasHash = true;
                    break;
                  }
                }
                if (!hasHash) {
                  registerClassMethod(ct, cd, "hashCode", null, false, false, null);
                  let hashFunc = this.wasm.functions[this.wasm.functions.length - 1];
                  hashFunc.isCaseClassHash = true;
                }
              }
            };

            if (!classType.isExtension) {
              populateClassStructAndMethods(classType, classDecl);
              if (classType.sealedVariants != null) {
                let variants = classType.sealedVariants as Array<ClassType>;
                for (let vType in variants) {
                  if (vType == null) { continue; }
                  populateClassStructAndMethods(vType, null);
                }
              }
            }

            let mixinMembers = new Array<Node>();
            let seenMixins = new HashMap<String, boolean>();
            collectMixinMembers(moduleModel, classDecl.mixins, mixinMembers, seenMixins);

            let allMembers = new Array<Node>();
            for (let ms in classDecl.body) {
              allMembers.push(ms);
            }
            for (let ms in mixinMembers) {
              allMembers.push(ms);
            }

            for (let member in allMembers) {
              if (member is MethodDefinition) {
                let method = member as MethodDefinition;
                if (method.isAbstract) { continue; }
                let methName = match(method.name) {
                  case Identifier {name}: name
                  case _: "<unknown>"
                };
                registerClassMethod(classType, classDecl, methName, method as Node, false, false, null);
              } else if (member is AccessorDeclaration) {
                let acc = member as AccessorDeclaration;
                let accName = match(acc.name) {
                  case Identifier {name}: name
                  case _: "<unknown>"
                };
                if (acc.getter != null) {
                  registerClassMethod(classType, classDecl, "get#" + accName, acc as Node, false, false, null);
                }
                if (acc.setter != null) {
                  registerClassMethod(classType, classDecl, "set#" + accName, acc.setter as Node, false, false, null);
                }
              } else if (member is FieldDefinition) {
                let fd = member as FieldDefinition;
                if (fd.setterName != null && fd.name is Identifier) {
                  let fieldName = (fd.name as Identifier).name;
                  let backingName = match(fd.setterName) {
                    case Identifier {name}: name
                    case _: fieldName
                  };
                  registerClassMethod(classType, classDecl, "get#" + fieldName, null, true, false, backingName);
                }
              }
            }

            if (!classType.isExtension) {
              for (let iface in classType.implementsList) {
                let it = iface as InterfaceType;
                let iName = getInterfaceKey(it);
                let cName = getClassKey(classType);
                if (this.wasm.usedInterfaceAdaptations.has(cName + "::" + iName)) {
                  let keys = it.members.keys();
                  while (let (true, key) = keys.next()) {
                    let member = it.members[key];
                    if (member is FieldInfo) {
                      let fi = member as FieldInfo;
                      let getterName = "get#" + key;
                      if (this.wasm.usedInterfaceMembers.has(iName + "::" + getterName)) {
                        var hasGetter = false;
                        for (let f in this.wasm.functions) {
                          if (f.classType != null && (f.classType as ClassType).id == classType.id && f.methodName == getterName) {
                            hasGetter = true;
                          }
                        }
                        if (!hasGetter) {
                          registerClassMethod(classType, classDecl, getterName, null, true, false, key);
                        }
                      }
                      
                      if (fi.isMutable) {
                        let setterName = "set#" + key;
                        if (this.wasm.usedInterfaceMembers.has(iName + "::" + setterName)) {
                          var hasSetter = false;
                          for (let f in this.wasm.functions) {
                            if (f.classType != null && (f.classType as ClassType).id == classType.id && f.methodName == setterName) {
                              hasSetter = true;
                            }
                          }
                          if (!hasSetter) {
                            registerClassMethod(classType, classDecl, setterName, null, false, true, key);
                          }
                        }
                      }
                    }
                  }
                }
              }
            }

            var hasConstructor = false;
            for (let member in classDecl.body) {
              if (member is MethodDefinition) {
                let method = member as MethodDefinition;
                let methName = match(method.name) {
                  case Identifier {name}: name
                  case _: "<unknown>"
                };
                if (methName == "<constructor>") {
                  hasConstructor = true;
                }
              }
            }

            if (!hasConstructor && classType != null && !(classType as ClassType).isExtension && classDecl.caseParams == null) {
              let cType = classType as ClassType;
              let synthParams = new Array<Parameter>();
              let superInitArgs = new Array<Expression>();
              
              if (cType.superType != null) {
                let st = cType.superType as ClassType;
                if (st.constructorType != null) {
                  let superCtor = st.constructorType as FunctionType;
                  var pi = 0;
                  while (pi < superCtor.parameters.length) {
                    var pName = "p" + i32ToString(pi);
                    if (superCtor.parameterNames != null) {
                      let pNames = superCtor.parameterNames as Array<String>;
                      if (pNames.length > pi) {
                        pName = pNames[pi];
                      }
                    }
                    
                    let paramIdent = new Identifier(pName, classDecl.name.loc);
                    var pPattern: Pattern | null = null;
                    var pTypeAnno: TypeAnnotation | null = null;
                    var pDefValue: Expression | null = null;
                    let synthParam = new Parameter(
                      paramIdent,
                      pPattern,
                      pTypeAnno,
                      false,
                      pDefValue,
                      false,
                      classDecl.name.loc
                    );
                    synthParams.push(synthParam);
                    
                    let argExpr = new Identifier(pName, classDecl.name.loc) as Expression;
                    superInitArgs.push(argExpr);
                    
                    pi = pi + 1;
                  }
                }
              }
              
              var superInit: SuperInitializer | null = null;
              if (cType.superType != null) {
                superInit = new SuperInitializer(superInitArgs, classDecl.name.loc);
              }
              
              var typeParams: Array<TypeParameter> | null = null;
              var returnType: TypeAnnotation | null = null;
              var initList: Array<Node> | null = null;
              
              let syntheticDecorator = new Decorator("synthetic_constructor", new Array<StringLiteral>(), classDecl.name.loc);
              let synthDecorators = new Array<Decorator>();
              synthDecorators.push(syntheticDecorator);
              
              let synthCtor = new MethodDefinition(
                new Identifier("<constructor>", classDecl.name.loc),
                typeParams,
                synthParams,
                returnType,
                new BlockStatement(new Array<Statement>(), classDecl.name.loc),
                initList,
                superInit,
                false, // isFinal
                false, // isAbstract
                false, // isStatic
                false, // isDeclare
                synthDecorators,
                classDecl.name.loc
              );
              
              registerClassMethod(cType, classDecl, "<constructor>", synthCtor as Node, false, false, null);
            }
          }
          case DeclareFunction: {
            let decl = stmt as DeclareFunction;
            let sym = moduleModel.resolveDeclaration(decl);
            if (sym != null) {
              for (let dec in decl.decorators) {
                if (dec.name == 'intrinsic') {
                  if (dec.args.length == 1) {
                    this.wasm.intrinsics[sym.id] = dec.args[0].value;
                  } else {
                    throw new Error("Intrinsic decorator must have exactly one argument");
                  }
                } else if (dec.name == 'external') {
                  if (dec.args.length == 2) {
                     let moduleName = dec.args[0].value;
                     let exportName = dec.args[1].value;
                     let funcType = moduleModel.getNodeType(decl) as FunctionType;
                     let params = new Array<ValType>();
                     for (let pt in funcType.parameters) {
                       params.push(typeToValType(this.wasm, pt));
                     }
                     let returns = new Array<ValType>();
                     if (!(funcType.returnType is VoidType)) {
                        returns.push(typeToValType(this.wasm, funcType.returnType));
                     }
                     let sig = this.wasm.getSignature(params, returns);
                     let wasmFunc = new WasmFunction(sig, decl, moduleModel);
                     wasmFunc.isImport = true;
                     wasmFunc.importModule = moduleName;
                     wasmFunc.importName = exportName;
                     this.wasm.functionImports.push(wasmFunc);
                     this.wasm.functionMap[sym.id] = wasmFunc;
                  } else {
                    throw new Error("External decorator must have exactly two arguments");
                  }
                }
              }
            }
          }
          case TypeAliasDeclaration: {}
          // TODO: Divergence from design doc. Currently we don't emit a global
          // struct for the enum namespace, and instead we only constant-fold
          // MemberExpressions. We should converge either by emitting the struct
          // here, or updating the language to completely erase Enum namespaces
          // at runtime.
          case EnumDeclaration: {}
        }
      }
    }

    // Pass 1.1: Synthesize physical field getters/setters for virtual/inherited slots
    for (let cPair in this.wasm.classStructs) {
      let cName = cPair.key;
      let cStruct = cPair.value;
      if (cStruct.classType != null) {
        let cType = cStruct.classType as ClassType;
        for (let methName in cType.vtable) {
          if (methName.startsWith("get#")) {
            let fieldName = methName.sliceBytes(4, methName.length);
            var hasPhysical = false;
            var backingName = "";
            let lookupName = fieldName;
            let lookupPrivateName = cName + "::" + fieldName;
            for (let f in cStruct.fields) {
              if (f.name != null) {
                let fname = f.name as String;
                if (fname == lookupName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname.endsWith("::" + fieldName)) {
                  hasPhysical = true;
                  backingName = fieldName;
                }
              }
            }
            if (hasPhysical) {
              var hasGetter = false;
              for (let f in this.wasm.functions) {
                if (f.classType != null && (f.classType as ClassType).id == cType.id && f.methodName == methName) {
                  hasGetter = true;
                  break;
                }
              }
              if (!hasGetter) {
                this.registerClassMethod(cType, null, methName, null, true, false, backingName, this.program.units[0].model);
              }
            }
          } else if (methName.startsWith("set#")) {
            let fieldName = methName.sliceBytes(4, methName.length);
            var hasPhysical = false;
            var backingName = "";
            let lookupName = fieldName;
            let lookupPrivateName = cName + "::" + fieldName;
            for (let f in cStruct.fields) {
              if (f.name != null) {
                let fname = f.name as String;
                if (fname == lookupName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname.endsWith("::" + fieldName)) {
                  hasPhysical = true;
                  backingName = fieldName;
                }
              }
            }
            if (hasPhysical) {
              var hasSetter = false;
              for (let f in this.wasm.functions) {
                if (f.classType != null && (f.classType as ClassType).id == cType.id && f.methodName == methName) {
                  hasSetter = true;
                  break;
                }
              }
              if (!hasSetter) {
                this.registerClassMethod(cType, null, methName, null, false, true, backingName, this.program.units[0].model);
              }
            }
          }
        }
      }
    }

    // Pass 1.5: Build class vtable globals
    for (let cPair in this.wasm.classVTableStructs) {
       let cName = cPair.key;
       let vst = cPair.value;
       var methods = new Array<WasmFunction>();
       let fields = vst.fields;
       var newFields = new Array<WasmField>();
       let cType = vst.classType as ClassType;
       for (var i = 0; i < fields.length; i += 1) {
          let field = fields[i];
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = cType;
          while (currClass != null && foundFunc == null) {
             for (let f in this.wasm.functions) {
                if (f.classType != null && (f.classType as ClassType).id == (currClass as ClassType).id && f.methodName == field.name) {
                   foundFunc = f;
                   break;
                }
             }
             currClass = (currClass as ClassType).superType;
          }
           if (foundFunc != null) {
               newFields.push(new WasmField(field.name, new ValTypeRef((foundFunc as WasmFunction).signature), false));
               methods.push(foundFunc);
           } else {
             // push dummy? or fail?
             newFields.push(field);
             methods.push(this.wasm.functions[0]);
          }
       }
       while (vst.fields.length > 0) {
          let ignored = vst.fields.pop();
       }
       for (var fIdx = 0; fIdx < newFields.length; fIdx += 1) {
          vst.fields.push(newFields[fIdx]);
       }
       
       let vtableInit = new VTableInit(vst, methods);
       let vtableGlobal = new WasmGlobal(
         cName + "_vtable",
         cName + "_vtable",
         new ValTypeRef(vst),
         false,
         null,
         vtableInit,
         this.program.units[0].model
       );
       this.wasm.globals.push(vtableGlobal);
       this.wasm.classVTableGlobals[cName] = vtableGlobal;
    }

    // Pass 1.25: Allocate singleton globals for unit variants
    for (let cPair in this.wasm.classStructs) {
      let cName = cPair.key;
      let cStruct = cPair.value;
      if (cStruct.classType != null) {
        let cType = cStruct.classType as ClassType;
        if (cType.isCaseClass && (cType.constructorType == null || (cType.constructorType as FunctionType).parameters.length == 0)) {
          let globalName = cName + "_singleton";
          let globalType = new ValTypeRefNull(cStruct);
          let wasmGlobal = new WasmGlobal(
            globalName,
            globalName,
            globalType,
            false,
            null,
            null,
            this.program.units[0].model
          );
          wasmGlobal.initSingletonStruct = cType;
          this.wasm.globals.push(wasmGlobal);
          this.wasm.classSingletonGlobals[cName] = wasmGlobal;
        }
      }
    }

    for (let cPair in this.wasm.classStructs) {
       let cName = cPair.key;
       let cStruct = cPair.value;
       if (cStruct.classType != null) {
          let cType = cStruct.classType as ClassType;
          for (let iface in cType.implementsList) {
             let it = iface as InterfaceType;
             let iName = getInterfaceKey(it);
             let key = cName + "::" + iName;
             if (this.wasm.usedInterfaceAdaptations.has(key)) {
               let vst = this.wasm.interfaceVTableStructs[iName];
               
               var methods = new Array<WasmFunction>();
               for (var i = 0; i < vst.fields.length; i += 1) {
                  let field = vst.fields[i];
                  var foundFunc: WasmFunction | null = null;
                  var currClass: ClassType | null = cType;
                  while (currClass != null && foundFunc == null) {
                     for (let f in this.wasm.functions) {
                        if (f.classType != null && (f.classType as ClassType).id == (currClass as ClassType).id && f.methodName == field.name) {
                           foundFunc = f;
                           break;
                        }
                     }
                     currClass = (currClass as ClassType).superType;
                  }
                   if (foundFunc != null) {
                      let targetFunc = foundFunc as WasmFunction;
                      let trampSig = getInterfaceMemberSignature(this.wasm, it, field.name);
                      let trampFunc = new WasmFunction(trampSig, null, this.program.units[0].model);
                      trampFunc.name = cName + "_" + iName + "_" + field.name + "_trampoline";
                      trampFunc.interfaceTrampolineTarget = targetFunc;
                      this.wasm.functions.push(trampFunc);
                      methods.push(trampFunc);
                   } else {
                      methods.push(this.wasm.functions[0]);
                   }
               }
               
               let vtableInit = new VTableInit(vst, methods);
               let vtableGlobal = new WasmGlobal(
                  cName + "_" + iName + "_vtable",
                  cName + "_" + iName + "_vtable",
                  new ValTypeRef(vst),
                  false,
                  null,
                  vtableInit,
                  this.program.units[0].model
               );
               this.wasm.globals.push(vtableGlobal);
               this.wasm.classInterfaceVTables[key] = vtableGlobal;
             }
          }
       }
    }
  }
}


export let getInterfaceMemberSignature = (wasm: WasmModule, it: InterfaceType, fieldName: String): WasmSignature => {
  if (fieldName.startsWith("get#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    let fi = it.members[propName] as FieldInfo;
    let params = new Array<ValType>();
    params.push(new ValTypeStructRef());
    let returns = new Array<ValType>();
    returns.push(typeToValType(wasm, fi.type));
    return wasm.getSignature(params, returns);
  } else if (fieldName.startsWith("set#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    let fi = it.members[propName] as FieldInfo;
    let params = new Array<ValType>();
    params.push(new ValTypeStructRef());
    params.push(typeToValType(wasm, fi.type));
    let returns = new Array<ValType>();
    return wasm.getSignature(params, returns);
  } else {
    let mi = it.members[fieldName] as MethodInfo;
    let ft = mi.type as FunctionType;
    let params = new Array<ValType>();
    params.push(new ValTypeStructRef());
    for (let p in ft.parameters) {
      params.push(typeToValType(wasm, p));
    }
    let returns = new Array<ValType>();
    if (!(ft.returnType is VoidType)) {
      returns.push(typeToValType(wasm, ft.returnType));
    }
    return wasm.getSignature(params, returns);
  }
};


export let getClassMemberSignature = (wasm: WasmModule, ct: ClassType, fieldName: String): WasmSignature => {
  let rootClass = getMemberRootClass(ct, fieldName);
  let params = new Array<ValType>();
  let classStruct = wasm.classStructs[getClassKey(rootClass)];
  if (classStruct != null) {
    params.push(new ValTypeRefNull(classStruct));
  } else {
    params.push(new ValTypeStructRef());
  }

  let returns = new Array<ValType>();

  if (fieldName.startsWith("get#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var fieldType: Type = new VoidType();
    if (ct.members.has(propName)) {
      fieldType = ct.members[propName].type;
    } else if (ct.members.has(fieldName)) {
      let mi = ct.members[fieldName] as MethodInfo;
      let ft = mi.type as FunctionType;
      fieldType = ft.returnType;
    }
    returns.push(typeToValType(wasm, fieldType));
    return wasm.getSignature(params, returns);
  } else if (fieldName.startsWith("set#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var fieldType: Type = new VoidType();
    if (ct.members.has(propName)) {
      fieldType = ct.members[propName].type;
    } else if (ct.members.has(fieldName)) {
      let mi = ct.members[fieldName] as MethodInfo;
      let ft = mi.type as FunctionType;
      fieldType = ft.parameters[0];
    }
    params.push(typeToValType(wasm, fieldType));
    return wasm.getSignature(params, returns);
  } else {
    var ft: FunctionType | null = null;
    if (ct.members.has(fieldName)) {
      let mi = ct.members[fieldName] as MethodInfo;
      ft = mi.type as FunctionType;
    }
    if (ft != null) {
      let fType = ft as FunctionType;
      for (let p in fType.parameters) {
        params.push(typeToValType(wasm, p));
      }
      if (!(fType.returnType is VoidType)) {
        returns.push(typeToValType(wasm, fType.returnType));
      }
    }
    return wasm.getSignature(params, returns);
  }
};


export let typeToValType = (wasm: WasmModule, t: Type): ValType => match (t) {
  case TypeAliasType as a: typeToValType(wasm, a.target)
  case F64Type: new ValTypeF64()
  case F32Type: new ValTypeF32()
  case I32Type: new ValTypeI32()
  case U32Type: new ValTypeI32()
  case I64Type: new ValTypeI64()
  case U64Type: new ValTypeI64()
  case BooleanType: new ValTypeI32()
  case RecordType as rec: {
    let fields = new Array<WasmField>();
    for (let pair in rec.properties) {
       fields.push(new WasmField(pair.key, typeToValType(wasm, pair.value), false));
    }
    sortWasmFields(fields);
    let info_opt = wasm.findRecordDispatch(fields);
    match (info_opt) {
      case RecordDispatchInfo as info: new ValTypeRef(info.fatPtrType)
      case null: {
        var errStr = "";
        for (let f in fields) {
           if (f.name != null) errStr = errStr + (f.name as String) + ", ";
        }
        throw new Error("Record fat ptr type not generated during discovery pass! Fields: " + errStr);
      }
    }
  }
  case TupleType as tup: {
    let fields = new Array<WasmField>();
    for (var i = 0; i < tup.elementTypes.length; i += 1) {
      let t_i = tup.elementTypes[i];
      fields.push(new WasmField(i32ToString(i), typeToValType(wasm, t_i), false));
    }
    let structDef = wasm.getStruct(null, fields);
    new ValTypeRef(structDef);
  }
  case ClassType as ct: {
    if (ct.isExtension && ct.onType != null) {
      return typeToValType(wasm, ct.onType as Type);
    }
    if (ct.name == "String") {
      return new ValTypeI32();
    }
    if (wasm.classStructs.has(getClassKey(ct))) {
      new ValTypeRefNull(wasm.classStructs[getClassKey(ct)])
    } else {
      throw new Error("Class struct not found for: " + ct.name);
    }
  }
  case InterfaceType as it: {
    let key = getInterfaceKey(it);
    if (wasm.interfaceStructs.has(key)) {
      new ValTypeRefNull(wasm.interfaceStructs[key])
    } else {
      throw new Error("Interface fat pointer type not generated during discovery pass! Name: " + it.name);
    }
  }
  case ArrayType: {
    throw new Error("Codegen not implemented for type: " + typeToString(t));
  }
  case VoidType: new ValTypeVoid()
  case NullType: new ValTypeStructRef()
  case UnknownType: {
    throw new Error("Codegen should never see type: " + typeToString(t));
  }
  case ErrorType: {
    throw new Error("Codegen should never see type: " + typeToString(t));
  }
  case AnyType: new ValTypeAnyRef()
  case TypeParameterType: new ValTypeAnyRef()
  case AnyRefType: new ValTypeAnyRef()
  case EqRefType: new ValTypeEqRef()
  case NeverType: {
    throw new Error("Codegen should never see type: " + typeToString(t));
  }
  case HoleType: {
    throw new Error("Codegen should never see type: " + typeToString(t));
  }
  case FunctionType: {
    throw new Error("Codegen not implemented for type: " + typeToString(t));
  }
  case UnionType as ut: {
    var hasVoid = false;
    for (let t_i in ut.types) {
      if (t_i is VoidType) {
        hasVoid = true;
      }
    }
    if (hasVoid) {
      new ValTypeVoid()
    } else {
      let nonNeverTypes = new Array<Type>();
      for (let t_i in ut.types) {
        if (!(t_i is NeverType || t_i is HoleType)) {
          nonNeverTypes.push(t_i);
        }
      }
      if (nonNeverTypes.length == 0) {
        new ValTypeVoid()
      } else if (nonNeverTypes.length < ut.types.length) {
        if (nonNeverTypes.length == 1) {
          typeToValType(wasm, nonNeverTypes[0])
        } else {
          typeToValType(wasm, new UnionType(nonNeverTypes))
        }
      } else {
        let nonNullTypes = new Array<Type>();
        for (let t_i in ut.types) {
          if (!(t_i is NullType)) {
            nonNullTypes.push(t_i);
          }
        }
        if (nonNullTypes.length == 1) {
          typeToValType(wasm, nonNullTypes[0])
        } else {
          new ValTypeEqRef()
        }
      }
    }
  }
  case _: {
    throw new Error("typeToValType: unsupported type: " + typeToString(t));
  }
};


export let collectMixinMembers = (
  model: SemanticModel,
  mixinAnns: Array<TypeAnnotation> | null,
  methods: Array<Node>,
  seen: HashMap<String, boolean>
): void => {
  if (mixinAnns == null) { return; }
  for (let ann in (mixinAnns as Array<TypeAnnotation>)) {
    let sym = model.resolve(ann);
    if (sym != null && (sym as Symbol).declaration is MixinDeclaration) {
      let md = (sym as Symbol).declaration as MixinDeclaration;
      let mixinKey = md.name.name;
      if (!seen.has(mixinKey)) {
        seen[mixinKey] = true;
        collectMixinMembers(model, md.mixins, methods, seen);
        for (let member in md.body) {
          if (member is MethodDefinition || member is AccessorDeclaration || member is FieldDefinition) {
            methods.push(member);
          }
        }
      }
    }
  }
};


export let collectMixinFields = (
  model: SemanticModel,
  mixinAnns: Array<TypeAnnotation> | null,
  fields: Array<FieldDefinition>,
  seen: HashMap<String, boolean>
): void => {
  if (mixinAnns == null) { return; }
  for (let ann in (mixinAnns as Array<TypeAnnotation>)) {
    let sym = model.resolve(ann);
    if (sym != null && (sym as Symbol).declaration is MixinDeclaration) {
      let md = (sym as Symbol).declaration as MixinDeclaration;
      let mixinKey = md.name.name;
      if (!seen.has(mixinKey)) {
        seen[mixinKey] = true;
        collectMixinFields(model, md.mixins, fields, seen);
        for (let member in md.body) {
          if (member is FieldDefinition) {
            fields.push(member as FieldDefinition);
          }
        }
      }
    }
  }
};
