import { 
  Node, Expression, ClassDeclaration, NodeId, ImportSpecifier, FunctionExpression, MethodDefinition,
  DeclareFunction, VariableDeclaration, IdentifierPattern
} from '../ast.zena';
import { SemanticModel } from '../semantic-model.zena';
import { SymbolId, Symbol } from '../scope/symbol.zena';
import { Error } from 'zena:error';
import { Hashable } from 'zena:hashable';
import {
  ValType, ValTypeVoid, ValTypeStructRef, ValTypeRefNull, ValTypeRef, ValTypeEqRef,
  ValTypeAnyRef, ValTypeI8, WasmType, valTypeEquals, ValTypeExternRef, ValTypeI32,
  valTypeToOpcode, nextWasmTypeUid
} from './wasm.zena';
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { HashSet } from 'zena:set';
import { NodeMap } from '../node-map.zena';
import { ClassType, InterfaceType, FunctionType, Type, TypeParameterType } from '../types.zena';
import { String } from "zena:string";
import { i32ToString } from "zena:string-convert";
import { ByteBuffer } from 'zena:byte-buffer';
import { StringBuilder } from 'zena:string-builder';
import { Program } from '../program.zena';

import { 
  compareStrings, ClassKey, InterfaceKey, ClassInterfaceKey, InterfaceMemberKey, 
  CellKey, ClosureKey, ExportKey, ExportGlobalKey, getClassKey, getClassPrivateFieldKey, getTypeUniqueKey,
  FunctionAdaptationKey, getFunctionAdaptationKey, ClassMethodKey, getClassMethodKey,
  SpecializedFunctionKey, getSpecializedFunctionKey, ClosureSpecializationKey, getClosureSpecializationKey,
  FunctionValueWrapperKey, getFunctionValueWrapperKey
} from './codegen-utils.zena';

@intrinsic('hash')
declare function hash<T>(value: T): i32;

export let sortWasmFields = (fields: Array<WasmField>): void => {
  let len = fields.length;
  for (var i = 1; i < len; i += 1) {
    let key = fields[i];
    var j = i - 1;
    while (j >= 0) {
      let a = fields[j].name;
      let b = key.name;
      if (a != null && b != null) {
        if (compareStrings(a as String, b as String) > 0) {
          fields[j + 1] = fields[j];
          j -= 1;
        } else {
          break;
        }
      } else {
        break;
      }
    }
    fields[j + 1] = key;
  }
};

export final class WasmExport {
  name: String;
  func: WasmFunction;
  new(this.name, this.func);
}

/**
 * Represents a reference to an entity that has a WebAssembly type index.
 * Before layout runs, the index is -1.
 */
export final class WasmField {
  name: String | null;
  type: ValType;
  isMutable: boolean;
  new(this.name, this.type, this.isMutable);
}


/**
 * Cache keys for WasmModule's structural type pools (getSignature / getStruct /
 * getArray). Each is a compact string encoding of the requested type's
 * identity, so that a HashMap lookup replaces a linear scan over all types.
 *
 * The shared building block is the ValType unit appended by appendValTypeKey:
 *
 *   <opcode>['#'<target uid> | '?'<target uid>]','
 *
 * i.e. the valtype's wasm opcode, plus the referenced WasmType's uid for
 * concrete ref types ('#' non-null, '?' nullable). Two ValTypes produce the
 * same unit iff valTypeEquals considers them equal.
 *
 * On top of that:
 *   SignatureKey: <param unit>* '|' <result unit>*
 *   StructKey:    [<struct name>] '\n' (<field name>('m'|'c')<field unit>'\n')*
 *   ArrayKey:     ('m'|'c') <element unit>
 *
 * The keys are derived purely from the freshly-built inputs of each request
 * (there is no pre-existing object to cache them on, unlike e.g. ClassKey
 * which is memoized on the ClassType).
 */
let valTypeHashCode = (vt: ValType): i32 => {
  return match (vt) {
    case ValTypeRef {target}: target.uid * 2
    case ValTypeRefNull {target}: target.uid * 2 + 1
    case _: valTypeToOpcode(vt)
  };
};

/**
 * Identity-based ValType equality for the type-pool cache keys below.
 *
 * This deliberately does NOT use valTypeEquals: that compares ref targets
 * by their type-section INDEX, which is -1 for every type until layout()
 * runs and is reassigned there. Keys whose equality mutates break the
 * caches twice over — distinct keys can spuriously merge before layout
 * (all indices equal -1), and entries cached before layout become
 * unfindable afterwards. Comparing the target OBJECTS is stable across
 * layout, matches valTypeHashCode (uid-based) so hashCode/equals agree,
 * and is equivalent to index equality for laid-out types.
 */
let valTypeKeyEquals = (a: ValType, b: ValType): boolean => {
  if (valTypeToOpcode(a) != valTypeToOpcode(b)) {
    return false;
  }
  return match (a) {
    case ValTypeRef {target as ta}: match (b) {
      case ValTypeRef {target as tb}: ta == tb
      case _: false
    }
    case ValTypeRefNull {target as ta}: match (b) {
      case ValTypeRefNull {target as tb}: ta == tb
      case _: false
    }
    case _: true
  };
};

export final class SignatureKey implements Hashable {
  params: Array<ValType>;
  returns: Array<ValType>;
  new(this.params, this.returns);

  hashCode(): i32 {
    var h = 17;
    for (let p in this.params) {
      h = h * 31 + valTypeHashCode(p);
    }
    h = h * 31 + 12345;
    for (let r in this.returns) {
      h = h * 31 + valTypeHashCode(r);
    }
    return h;
  }

  operator ==(other: SignatureKey): boolean {
    if (this.params.length != other.params.length || this.returns.length != other.returns.length) {
      return false;
    }
    for (var i = 0; i < this.params.length; i += 1) {
      if (!valTypeKeyEquals(this.params[i], other.params[i])) { return false; }
    }
    for (var j = 0; j < this.returns.length; j += 1) {
      if (!valTypeKeyEquals(this.returns[j], other.returns[j])) { return false; }
    }
    return true;
  }
}

let stringEquals = (s1: String | null, s2: String | null): boolean => {
  if (s1 == null) {
    return s2 == null;
  }
  if (s2 == null) {
    return false;
  }
  return s1 as String == s2 as String;
};

export final class StructKey implements Hashable {
  name: String | null;
  fields: Array<WasmField>;
  new(this.name, this.fields);

  hashCode(): i32 {
    var h = if (this.name == null) 0 else hash(this.name as String);
    for (let f in this.fields) {
      if (f.name != null) {
        h = h * 31 + hash(f.name as String);
      }
      h = h * 31 + valTypeHashCode(f.type);
      if (f.isMutable) {
        h = h * 31 + 777;
      }
    }
    return h;
  }

  operator ==(other: StructKey): boolean {
    if (!stringEquals(this.name, other.name) || this.fields.length != other.fields.length) {
      return false;
    }
    for (var i = 0; i < this.fields.length; i += 1) {
      let f1 = this.fields[i];
      let f2 = other.fields[i];
      if (!stringEquals(f1.name, f2.name) || f1.isMutable != f2.isMutable || !valTypeKeyEquals(f1.type, f2.type)) {
        return false;
      }
    }
    return true;
  }
}

export final class ArrayKey implements Hashable {
  elementType: ValType;
  isMutable: boolean;
  new(this.elementType, this.isMutable);

  hashCode(): i32 {
    var h = valTypeHashCode(this.elementType);
    if (this.isMutable) {
      h = h * 31 + 999;
    }
    return h;
  }

  operator ==(other: ArrayKey): boolean {
    return this.isMutable == other.isMutable && valTypeKeyEquals(this.elementType, other.elementType);
  }
}

let getSignatureKey = (params: Array<ValType>, returns: Array<ValType>): SignatureKey => {
  return new SignatureKey(params, returns);
};

let getStructKey = (name: String | null, fields: Array<WasmField>): StructKey => {
  return new StructKey(name, fields);
};

let getArrayKey = (elementType: ValType, isMutable: boolean): ArrayKey => {
  return new ArrayKey(elementType, isMutable);
};

export final class WasmStruct extends WasmType {
  var superStruct: WasmStruct | null = null;
  var classType: ClassType | null = null;
  name: String | null;
  fields: Array<WasmField>;
  /** Lazy name→index cache; sized-guarded because RTA appends fields. */
  var #fieldIndexCache: HashMap<String, i32> | null = null;
  var #fieldIndexCacheSize = -1;
  new(this.name, this.fields) : super();

  /**
   * Resolves a private member's mangled field name against this
   * struct. Field names carry the key of the class the STRUCT was
   * built for — the specialized class for per-specialization structs,
   * the generic template for structs shared across erased-identical
   * specializations, and the declaring ancestor for inherited fields —
   * so no single caller-side mangle can be correct. The search order
   * preserves lexical privacy: first the accessor's written class
   * chain exactly (a subclass's shadowing private must not win), then
   * this struct's own class chain restricted to classes that are
   * specializations of the lexical class. Both backends share this.
   */
  resolvePrivateFieldName(lexicalCt: ClassType | null, propName: String): String | null {
    if (lexicalCt != null) {
      var l: ClassType | null = lexicalCt;
      while (l != null) {
        var g: ClassType | null = l as ClassType;
        while (g != null) {
          // A mixin's This class namespaces its private fields with
          // the mixin's scope key (ClassType.privateScopeKey), shared
          // by all applications of the mixin.
          let gc = g as ClassType;
          let key = if (gc.privateScopeKey != null) {
            getClassPrivateFieldKey(gc.privateScopeKey as String as ClassKey, propName)
          } else {
            getClassPrivateFieldKey(getClassKey(gc), propName)
          };
          if (this.fieldIndexByName(key) >= 0) {
            return key;
          }
          g = gc.genericSource;
        }
        l = (l as ClassType).superType;
      }
    }
    let lexCanonical = if (lexicalCt != null) canonicalClassKey(lexicalCt as ClassType) else null;
    var c = this.classType;
    while (c != null) {
      let cc = c as ClassType;
      if (lexCanonical == null ||
          (canonicalClassKey(cc) as String) == (lexCanonical as ClassKey) as String) {
        let key = getClassPrivateFieldKey(getClassKey(cc), propName);
        if (this.fieldIndexByName(key) >= 0) {
          return key;
        }
      }
      c = cc.superType;
    }
    return null;
  }

  /**
   * Index of the named field, or -1. Memoized: field lookups by name
   * happen once per field access during lowering and emission, and a
   * per-access linear scan would multiply out to O(accesses × fields)
   * on wide structs. The cache rebuilds if fields were appended since
   * it was built (interface vtable structs gain fields during RTA).
   */
  fieldIndexByName(fieldName: String): i32 {
    if (this.#fieldIndexCache == null ||
        this.#fieldIndexCacheSize != this.fields.length) {
      let cache = new HashMap<String, i32>();
      for (var i = 0; i < this.fields.length; i += 1) {
        let n = this.fields[i].name;
        if (n != null) {
          cache[n] = i;
        }
      }
      this.#fieldIndexCache = cache;
      this.#fieldIndexCacheSize = this.fields.length;
    }
    let cache = this.#fieldIndexCache as HashMap<String, i32>;
    return if (let (true, idx) = cache.get(fieldName)) idx else -1;
  }
}

/** The generic-source root's key: specializations compare equal to
 * their template through this. */
export let canonicalClassKey = (ct: ClassType): ClassKey => {
  var c = ct;
  while (c.genericSource != null) {
    c = c.genericSource as ClassType;
  }
  return getClassKey(c);
};

export final class WasmArray extends WasmType {
  elementType: ValType;
  isMutable: boolean;
  new(this.elementType, this.isMutable) : super();
}

/**
 * A WebAssembly function signature.
 * Deduped by the module so identical signatures share the same type index.
 * Params and returns are represented by WebAssembly ValType enums (e.g. i32, f64).
 */
export final class WasmSignature extends WasmType {
  params: Array<ValType>;
  returns: Array<ValType>;
  new(this.params, this.returns) : super();
}

/**
 * Wasm-level assignability between value types: may a value of type `a`
 * flow where `b` is expected? Conservative: scalar types must match
 * exactly; reference types allow dropping non-nullability, walking
 * struct supertype chains, and widening struct or array targets to
 * eqref/anyref (all Zena heap values are eq).
 */
export let isValSubtype = (a: ValType, b: ValType): boolean => {
  if (valTypeEquals(a, b)) {
    return true;
  }
  if (a is ValTypeStructRef) {
    // structref <: eqref <: anyref.
    return b is ValTypeAnyRef || b is ValTypeEqRef;
  }
  let aTarget = refTargetOf(a);
  if (aTarget == null) {
    return false;
  }
  // a is a concrete ref; non-null may widen to nullable, never the reverse.
  let aNullable = a is ValTypeRefNull;
  if (b is ValTypeAnyRef || b is ValTypeEqRef) {
    return true;
  }
  if (b is ValTypeStructRef) {
    return (aTarget as WasmType) is WasmStruct;
  }
  let bTarget = refTargetOf(b);
  if (bTarget == null) {
    return false;
  }
  let bNullable = b is ValTypeRefNull;
  if (aNullable && !bNullable) {
    return false;
  }
  return heapSubtype(aTarget as WasmType, bTarget as WasmType);
};

/** The heap type behind a concrete reference ValType, else null. */
let refTargetOf = (t: ValType): WasmType | null => {
  return match (t) {
    case ValTypeRef {target}: target
    case ValTypeRefNull {target}: target
    case _: null
  };
};

/** Declared-subtype check between heap types (struct super chains). */
let heapSubtype = (a: WasmType, b: WasmType): boolean => {
  if (a == b) {
    return true;
  }
  if (a is WasmStruct) {
    var current: WasmStruct | null = (a as WasmStruct).superStruct;
    while (current != null) {
      if ((current as WasmStruct) == b) {
        return true;
      }
      current = (current as WasmStruct).superStruct;
    }
  }
  return false;
};

/**
 * Represents a single compiled WebAssembly function.
 * Tracks its eventual index, signature, and the AST node it was derived from.
 */
export final class WasmFunction implements Hashable {
  /** The semantic model of the module that declares this function. */
  var model: SemanticModel;
  var index: i32 = -1;
  /** Process-unique id, used for identity-based hashing. */
  uid: i32 = nextWasmTypeUid();
  var name: String | null = null;
  var methodName: String | null = null;
  var structType: WasmStruct | null = null;
  var classType: ClassType | null = null;
  var classDecl: Node | null = null;
  var signature: WasmSignature;
  var node: Node | null = null;
  var isImport: boolean = false;
  var isStatic: boolean = false;
  var importModule: String | null = null;
  var importName: String | null = null;
  var isCaseClassEq: boolean = false;
  var isCaseClassHash: boolean = false;
  /**
   * Set on body-less functions that exist only to occupy a vtable
   * slot. A class's vtable struct declares one exactly-typed funcref
   * field per method of the hierarchy, so even a method that
   * reachability never saw a call to must put SOMETHING of the right
   * signature in its slot. Both backends emit a single `unreachable`
   * for these: a virtual dispatch landing on one means the liveness
   * analysis was wrong, and trapping loudly is the correct response.
   */
  var isVtableSlotStub: boolean = false;
  /**
   * Set on functions compiled from a mixin declaration's body: the
   * mixin's private scope key ("<Mixin>_This"). Private field
   * accesses in such functions resolve to "<scope>::#name" struct
   * fields — mixin privates are lexical to the mixin declaration and
   * never alias a host class's same-named private. Null for
   * functions written in a class body.
   */
  var privateScopeKey: String | null = null;
  /** The target class struct for a synthesized field getter. */
  var getterStruct: WasmStruct | null = null;
  /** The index of the field in the class struct for the synthesized getter. */
  var getterFieldIndex: i32 = -1;
  /** The target class struct for a synthesized field setter. */
  var setterStruct: WasmStruct | null = null;
  /** The index of the field in the class struct for the synthesized setter. */
  var setterFieldIndex: i32 = -1;
  /** The concrete target function for an interface trampoline method/property call. */
  var interfaceTrampolineTarget: WasmFunction | null = null;
  /** The target imported function for an external reference wrapper. */
  var importWrapperTarget: WasmFunction | null = null;
  var intrinsic: String | null = null;

  var isReached: boolean = false;
  var isAdded: boolean = false;
  var isClosure: boolean = false;
  var isReferenceTaken: boolean = false;
  var contextStruct: WasmStruct | null = null;
  var captures = new Array<SymbolId>();
  var mutableCaptures = new HashSet<SymbolId>();
  var capturesThis: boolean = false;
  var isFunctionAdaptation: boolean = false;
  var functionAdaptationSource: FunctionType | null = null;
  var functionAdaptationTarget: FunctionType | null = null;
  var functionAdaptationResolvedSourceStruct: WasmStruct | null = null;
  var functionAdaptationResolvedTargetStruct: WasmStruct | null = null;
  var isClosureWrapper: boolean = false;
  var closureWrapperTarget: WasmFunction | null = null;
  var typeParameters: Array<TypeParameterType> | null = null;
  var typeArguments: Array<Type> | null = null;
  /**
   * Memoized results of substituteTypeParamsInFunctionContext for this
   * function, keyed by input type identity (codegen/type-mapping.zena).
   */
  var codegenSubstCache: HashMap<Type, Type> | null = null;

  var closureTrampoline: WasmFunction | null = null;
  var isClosureTrampoline: boolean = false;
  var closureTrampolineTarget: WasmFunction | null = null;

  new(this.signature, this.node, this.model);
  hashCode(): i32 {
    return this.uid;
  }
}

export final class VTableInit {
  structType: WasmStruct;
  funcs: Array<WasmFunction>;
  new(this.structType, this.funcs) {
    for (let f in this.funcs) {
      f.isReferenceTaken = true;
    }
  }
}

export final class WasmGlobal {
  var index: i32 = -1;
  name: String;
  zenaName: String;
  /**
   * Mutable only so creators that attach an in-place constant initializer
   * AFTER construction (initSingletonStruct, initArraySize) can re-tighten
   * a reference type to non-nullable; the constructor below conservatively
   * nullifies ref types it cannot prove initialized in place.
   */
  var type: ValType;
  isMutable: boolean;
  var initExpr: Expression | null = null;
  var initVTable: VTableInit | null = null;
  var initSingletonStruct: ClassType | null = null;
  var initArraySize: i32 = -1;
  var namespaceImport: ImportSpecifier | null = null;
  model: SemanticModel;
  new(
    this.name,
    this.zenaName,
    type: ValType,
    this.isMutable,
    this.initExpr,
    this.initVTable,
    this.model
  ) : type = if (isMutable || (initExpr == null && initVTable == null)) {
        match (type) {
          case ValTypeRef {target}: new ValTypeRefNull(target)
          case _: type
        }
      } else {
        type
      } {}
}

export final class RecordDispatchInfo {
  fatPtrType: WasmStruct;
  vtableType: WasmStruct;
  concreteType: WasmStruct;
  vtableGlobal: WasmGlobal;
  fields: Array<WasmField>;
  getterTypes: Array<WasmSignature>;
  
  new(this.fatPtrType, this.vtableType, this.concreteType, this.vtableGlobal, this.fields, this.getterTypes);
}

export final class ClassCodegenInfo {
  structType: WasmStruct;
  var vtableStructType: WasmStruct | null = null;
  var vtableGlobal: WasmGlobal | null = null;
  var singletonGlobal: WasmGlobal | null = null;
  subclasses = new Array<ClassCodegenInfo>();
  new(this.structType);

  getTransitiveSubclasses(result: Array<ClassCodegenInfo>): void {
    for (let sub in this.subclasses) {
      result.push(sub);
      sub.getTransitiveSubclasses(result);
    }
  }
}

export final class WasmTag {
  var index: i32 = -1;
  signature: WasmSignature;
  new(this.signature);
}

export final class StringLiteralLocation {
  offset: i32;
  length: i32;
  new(this.offset, this.length);
}

export final class WasmModule {
  var types = new Array<WasmType>();
  tags = new Array<WasmTag>();
  exportTagMap = new HashMap<String, WasmTag>();
  var exceptionTag: WasmTag | null = null;
  var exceptionPayload: WasmGlobal | null = null;
  var isLayoutLocked: boolean = false;
  var startFunction: WasmFunction | null = null;
  
  /** 
   * A complete list of all imported functions.
   */
  functionImports = new Array<WasmFunction>();

  /** 
   * A complete list of all functions in the module, including anonymous
   * functions that do not have a corresponding symbol. Array order dictates
   * the final WebAssembly function index.
   */
  var functions = new Array<WasmFunction>();
  
  globals = new Array<WasmGlobal>();



  /**
   * Maps a Zena symbol ID to its compiled WebAssembly function.
   * Used to resolve call targets. Anonymous functions will not be in this map.
   */
  functionMap = new HashMap<SymbolId, WasmFunction>();
  
  /**
   * Maps a Zena AST Node ID to its compiler intrinsic name (e.g. `memory.size`).
   */
  intrinsics = new HashMap<NodeId, String>();

  globalMap = new HashMap<SymbolId, WasmGlobal>();

  var program: Program | null = null;
  var stringClass: ClassType | null = null;
  var templateStringsArrayClass: ClassType | null = null;
  var boxClass: ClassType | null = null;
  exportMap = new HashMap<ExportKey, WasmFunction>();
  exportGlobalMap = new HashMap<ExportGlobalKey, WasmGlobal>();
  classInfos = new HashMap<ClassKey, ClassCodegenInfo>();
  /**
   * Vtable method-name lists for specialized classes, keyed by class key.
   * The vtable belongs to the specialized class itself, not to whichever
   * ClassType instance mentions it: many instances share one class key, and
   * keeping this state per key (instead of mutating ClassType.vtable on
   * instances) lets substitution share instantiation objects safely.
   */
  vtables = new HashMap<ClassKey, Array<String>>();
  interfaceStructs = new HashMap<InterfaceKey, WasmStruct>();
  interfaceVTableStructs = new HashMap<InterfaceKey, WasmStruct>();
  classInterfaceVTables = new HashMap<ClassInterfaceKey, WasmGlobal>();
  #signatureCache = new HashMap<SignatureKey, WasmSignature>();
  #structCache = new HashMap<StructKey, WasmStruct>();
  #arrayCache = new HashMap<ArrayKey, WasmArray>();
  usedInterfaceAdaptations = new HashMap<ClassInterfaceKey, boolean>();
  usedInterfaceMembers = new HashMap<InterfaceMemberKey, boolean>();
  classMethodMap = new HashMap<ClassMethodKey, WasmFunction>();
  classMethods = new HashMap<String, Array<WasmFunction>>();
  var i32ToStringFunc: WasmFunction | null = null;
  var u32ToStringFunc: WasmFunction | null = null;
  var i64ToStringFunc: WasmFunction | null = null;
  var u64ToStringFunc: WasmFunction | null = null;
  var f32ToStringFunc: WasmFunction | null = null;
  var f64ToStringFunc: WasmFunction | null = null;
  var boolToStringFunc: WasmFunction | null = null;
  var wasiWriteStringHelper: WasmFunction | null = null;
  var stringHashHelper: WasmFunction | null = null;
  functionAdaptations = new HashMap<FunctionAdaptationKey, WasmFunction>();
  var arrayMethods = new Array<WasmFunction>();
  
  /**
   * The vtable global registered for exactly this (class, interface) pair,
   * or null. There is deliberately no fuzzy fallback here: a miss means the
   * key derivation at the call site disagrees with the key derivation at
   * registration, which is a bug to surface, not to paper over. (A previous
   * fallback matched entries by `_`-suffix prefix, which is not unique
   * across specializations — Foo would match both Foo_i32 and Foo_string —
   * and it had trapped unconditionally since the compound-key migration,
   * proving no passing path ever needed it.)
   */
  getClassInterfaceVTable(key: ClassInterfaceKey): WasmGlobal | null {
    if (this.classInterfaceVTables.has(key)) {
      return this.classInterfaceVTables[key];
    }
    return null;
  }

  #stdlibFuncCache = new HashMap<String, WasmFunction>();

  getStdlibFunc(moduleName: String, exportName: String): WasmFunction | null {
    let key = moduleName + "::" + exportName;
    if (this.#stdlibFuncCache.has(key)) {
      return this.#stdlibFuncCache[key];
    }
    let prog = this.program;
    if (prog == null) { return null; }
    if (!prog.unitsByPath.has(moduleName)) { return null; }
    let unit = prog.unitsByPath[moduleName];
    for (let stmt in unit.ast.body) {
      match (stmt) {
        case DeclareFunction as df: {
          if (df.name.name == exportName) {
            let sym = unit.model.resolveDeclaration(df);
            if (sym != null && this.functionMap.has((sym as Symbol).id)) {
              let f = this.functionMap[(sym as Symbol).id];
              this.#stdlibFuncCache[key] = f;
              return f;
            }
          }
        }
        case VariableDeclaration as vd: {
          if (vd.pattern is IdentifierPattern) {
            let pat = vd.pattern as IdentifierPattern;
            if (pat.name == exportName) {
              let sym = unit.model.resolve(pat);
              if (sym != null && this.functionMap.has((sym as Symbol).id)) {
                let f = this.functionMap[(sym as Symbol).id];
                this.#stdlibFuncCache[key] = f;
                return f;
              }
            }
          }
        }
        case _: {}
      }
    }
    return null;
  }
  mutableCapturedSymbols = new HashSet<SymbolId>();
  
  datas = new Array<ByteBuffer>();
  rawDatas = new Array<ByteBuffer>();
  stringLiterals = new HashMap<String, i32>();
  stringLiteralIds = new HashMap<String, i32>();
  stringLiteralLocations = new HashMap<String, StringLiteralLocation>();
  var sharedStringsGlobal: WasmGlobal | null = null;
  var stringFromSharedFunc: WasmFunction | null = null;
  var stringLiteralsArrayGlobal: WasmGlobal | null = null;
  var getStringLiteralFunc: WasmFunction | null = null;
  var stringArrayType: WasmArray | null = null;
  var sharedStringsDataIdx: i32 = -1;
  var sharedStringsLength: i32 = 0;
  var hasMemory: boolean = false;
  var wasiFdWriteIndex: i32 = -1;
  var wasiWriteStringIndex: i32 = -1;
  var stringHashFunc: WasmFunction | null = null;
  var stringCreateFunc: WasmFunction | null = null;
  var stringSetByteFunc: WasmFunction | null = null;
  var stringGetByteFunc: WasmFunction | null = null;
  var stringGetLengthFunc: WasmFunction | null = null;
  
  recordDispatchInfos = new Array<RecordDispatchInfo>();
  adaptedDispatchInfos = new Array<RecordDispatchInfo>();
  
  cellStructs = new HashMap<CellKey, WasmStruct>();
  closureStructs = new HashMap<ClosureKey, WasmStruct>();
  closureFunctions = new NodeMap<WasmFunction>();
  specializedClosures = new HashMap<ClosureSpecializationKey, WasmFunction>();
  functionValueWrappers = new HashMap<FunctionValueWrapperKey, WasmFunction>();
  templateLiteralGlobals = new NodeMap<WasmGlobal>();
  genericFunctions = new HashMap<SymbolId, FunctionExpression>();
  genericFunctionModels = new HashMap<SymbolId, SemanticModel>();
  genericMethods = new HashMap<ClassMethodKey, MethodDefinition>();
  genericMethodModels = new HashMap<ClassMethodKey, SemanticModel>();
  specializedFunctions = new HashMap<SpecializedFunctionKey, WasmFunction>();
  
  functionAdaptationWrappers = new NodeMap<WasmFunction>();
  symbolNames = new HashMap<SymbolId, String>();
  
  findRecordDispatch(fields: Array<WasmField>): RecordDispatchInfo | null {
    for (var k = 0; k < this.recordDispatchInfos.length; k += 1) {
      let info = this.recordDispatchInfos[k];
      if (info.fields.length == fields.length) {
        var match = true;
        for (var i = 0; i < fields.length; i += 1) {
          if (info.fields[i].name != fields[i].name || !valTypeEquals(info.fields[i].type, fields[i].type)) {
            match = false;
            break;
          }
        }
        if (match) return info;
      }
    }
    return null;
  }
  
  findAdaptedDispatch(inFields: Array<WasmField>, outFields: Array<WasmField>): RecordDispatchInfo | null {
    for (var k = 0; k < this.adaptedDispatchInfos.length; k += 1) {
      let info = this.adaptedDispatchInfos[k];
      let s = info.concreteType;
      var inMatch = false;
      if (s.fields.length == inFields.length) {
        inMatch = true;
        for (var i = 0; i < inFields.length; i += 1) {
          if (s.fields[i].name != inFields[i].name || !valTypeEquals(s.fields[i].type, inFields[i].type)) {
            inMatch = false;
            break;
          }
        }
      }
      if (inMatch && info.fields.length == outFields.length) {
        var outMatch = true;
        for (var i = 0; i < outFields.length; i += 1) {
          if (info.fields[i].name != outFields[i].name || !valTypeEquals(info.fields[i].type, outFields[i].type)) {
            outMatch = false;
            break;
          }
        }
        if (outMatch) {
          return info;
        }
      }
    }
    return null;
  }
  
  /**
   * Gets an existing WasmSignature if one matches the given parameters and
   * returns, or creates a new one and adds it to the type pool.
   *
   * Deduplicates by SignatureKey so identical signatures share the same
   * WebAssembly type index.
   */
  getSignature(params: Array<ValType>, returns: Array<ValType>): WasmSignature {
    let key = getSignatureKey(params, returns);
    if (let (true, cached) = this.#signatureCache.get(key)) {
      return cached;
    }
    if (this.isLayoutLocked) {
      var pStr = "";
      for (let p in params) {
        pStr = pStr + match (p) {
          case ValTypeRef as r: {
            if (r.target is WasmStruct) {
              let s = r.target as WasmStruct;
              "ref_" + (if (s.name == null) "anon" else s.name as String) + "(uid=" + i32ToString(s.uid) + ",idx=" + i32ToString(s.index) + ")"
            } else {
              "ref_non_struct(uid=" + i32ToString(r.target.uid) + ",idx=" + i32ToString(r.target.index) + ")"
            }
          }
          case ValTypeRefNull as rn: {
            if (rn.target is WasmStruct) {
              let s = rn.target as WasmStruct;
              "refnull_" + (if (s.name == null) "anon" else s.name as String) + "(uid=" + i32ToString(s.uid) + ",idx=" + i32ToString(s.index) + ")"
            } else {
              "refnull_non_struct(uid=" + i32ToString(rn.target.uid) + ",idx=" + i32ToString(rn.target.index) + ")"
            }
          }
          case _: i32ToString(valTypeToOpcode(p))
        } + ",";
      }
      var rStr = "";
      for (let r in returns) {
        rStr = rStr + match (r) {
          case ValTypeRef as r: {
            if (r.target is WasmStruct) {
              let s = r.target as WasmStruct;
              "ref_" + (if (s.name == null) "anon" else s.name as String) + "(uid=" + i32ToString(s.uid) + ",idx=" + i32ToString(s.index) + ")"
            } else {
              "ref_non_struct(uid=" + i32ToString(r.target.uid) + ",idx=" + i32ToString(r.target.index) + ")"
            }
          }
          case ValTypeRefNull as rn: {
            if (rn.target is WasmStruct) {
              let s = rn.target as WasmStruct;
              "refnull_" + (if (s.name == null) "anon" else s.name as String) + "(uid=" + i32ToString(s.uid) + ",idx=" + i32ToString(s.index) + ")"
            } else {
              "refnull_non_struct(uid=" + i32ToString(rn.target.uid) + ",idx=" + i32ToString(rn.target.index) + ")"
            }
          }
          case _: i32ToString(valTypeToOpcode(r))
        } + ",";
      }
      throw new Error("Signature allocated after layout! Params: " + pStr + " Returns: " + rStr);
    }
    let sig = new WasmSignature(params, returns);
    this.types.push(sig);
    this.#signatureCache[key] = sig;
    return sig;
  }

  getStruct(name: String | null, fields: Array<WasmField>): WasmStruct {
    let key = getStructKey(name, fields);
    if (let (true, cached) = this.#structCache.get(key)) {
      return cached;
    }
    if (this.isLayoutLocked) {
      throw new Error("Struct allocated after layout");
    }
    let st = new WasmStruct(name, fields);
    this.types.push(st);
    this.#structCache[key] = st;
    return st;
  }

  getClosureStruct(params: Array<ValType>, returns: Array<ValType>): WasmStruct {
    let implParams = new Array<ValType>();
    implParams.push(new ValTypeStructRef());
    for (let p in params) {
      implParams.push(p);
    }
    let implSig = this.getSignature(implParams, returns);
    
    let fields = new Array<WasmField>();
    fields.push(new WasmField("func", new ValTypeRef(implSig), false));
    fields.push(new WasmField("ctx", new ValTypeStructRef(), false));
    
    return this.getStruct(null, fields);
  }
  
  getRecordDispatch(model: SemanticModel, fields: Array<WasmField>): RecordDispatchInfo {
    sortWasmFields(fields);
    
    let existing = this.findRecordDispatch(fields);
    if (existing != null) {
      return existing;
    }
    if (this.isLayoutLocked) {
      throw new Error("Struct allocated after layout");
    }
    
    let concreteType = this.getStruct(null, fields);
    let vtableFields = new Array<WasmField>();
    let getterTypes = new Array<WasmSignature>();
    let getters = new Array<WasmFunction>();
    
    for (var i = 0; i < fields.length; i += 1) {
      let getterValType = fields[i].type;
      
      let params = new Array<ValType>();
      params.push(new ValTypeStructRef());
      
      let returns = new Array<ValType>();
      if (getterValType != new ValTypeVoid()) {
        returns.push(getterValType);
      }
      
      let getterType = this.getSignature(params, returns);
      getterTypes.push(getterType);
      
      let getterFunc = new WasmFunction(getterType, null, model);
      getterFunc.getterStruct = concreteType;
      getterFunc.getterFieldIndex = i;
      this.addFunction(getterFunc);
      getters.push(getterFunc);
      
      vtableFields.push(new WasmField(
        fields[i].name,
        new ValTypeRef(getterType),
        false
      ));
    }
    
    let vtableType = this.getStruct(null, vtableFields);
    
    let fatPtrFields = new Array<WasmField>();
    fatPtrFields.push(new WasmField(null, new ValTypeStructRef(), false));
    fatPtrFields.push(new WasmField(null, new ValTypeRef(vtableType), false));
    
    let fatPtrType = this.getStruct(null, fatPtrFields);
    
    let vtableInit = new VTableInit(vtableType, getters);
    let vtableGlobal = new WasmGlobal("vtable_record", "vtable_record", new ValTypeRef(vtableType), false, null, vtableInit, model);
    this.globals.push(vtableGlobal);
    
    let info = new RecordDispatchInfo(fatPtrType, vtableType, concreteType, vtableGlobal, fields, getterTypes);
    this.recordDispatchInfos.push(info);
    
    return info;
  }
  
  getAdaptedRecordDispatch(model: SemanticModel, inFields: Array<WasmField>, outFields: Array<WasmField>): RecordDispatchInfo {
    sortWasmFields(inFields);
    sortWasmFields(outFields);
    
    let existing = this.findAdaptedDispatch(inFields, outFields);
    if (existing != null) {
      return existing;
    }
    if (this.isLayoutLocked) {
      throw new Error("Struct allocated after layout");
    }
      
    let inStructType = this.getStruct(null, inFields);
    
    let vtableFields = new Array<WasmField>();
    let getterTypes = new Array<WasmSignature>();
    let getters = new Array<WasmFunction>();
    
    for (var i = 0; i < outFields.length; i += 1) {
      let fieldValType = outFields[i].type;
      
      let params = new Array<ValType>();
      params.push(new ValTypeStructRef());
      
      let returns = new Array<ValType>();
      if (fieldValType != new ValTypeVoid()) {
        returns.push(fieldValType);
      }
      
      let getterType = this.getSignature(params, returns);
      getterTypes.push(getterType);
      
      let getterFunc = new WasmFunction(getterType, null, model);
      getterFunc.getterStruct = inStructType;
      
      // Find the corresponding field in the inFields by name
      var inIndex = -1;
      for (var j = 0; j < inFields.length; j += 1) {
        if (inFields[j].name == outFields[i].name) {
          inIndex = j;
          break;
        }
      }
      
      getterFunc.getterFieldIndex = inIndex;
      this.addFunction(getterFunc);
      getters.push(getterFunc);
      
      vtableFields.push(new WasmField(
        outFields[i].name,
        new ValTypeRef(getterType),
        false
      ));
    }
    
    let vtableType = this.getStruct(null, vtableFields);
    
    let fatPtrFields = new Array<WasmField>();
    fatPtrFields.push(new WasmField(null, new ValTypeStructRef(), false));
    fatPtrFields.push(new WasmField(null, new ValTypeRef(vtableType), false));
    
    let fatPtrType = this.getStruct(null, fatPtrFields);
    
    let vtableInit = new VTableInit(vtableType, getters);
    // TODO: better naming since keyStr is gone
    let vtableGlobal = new WasmGlobal("vtable_adapt", "vtable_adapt", new ValTypeRef(vtableType), false, null, vtableInit, model);
    this.globals.push(vtableGlobal);
    
    // We return information about the TARGET shape (outFields), but with a vtable matching our adapted getters
    let info = new RecordDispatchInfo(fatPtrType, vtableType, inStructType, vtableGlobal, outFields, getterTypes);
    this.adaptedDispatchInfos.push(info);
    
    return info;
  }

  /** The shared vtable method-name list for a specialized class key. */
  classVtable(key: ClassKey): Array<String> {
    if (let (true, existing) = this.vtables.get(key)) {
      return existing;
    }
    let fresh = new Array<String>();
    this.vtables[key] = fresh;
    return fresh;
  }

  addFunction(func: WasmFunction): void {
    if (func.isAdded) {
      return;
    }
    func.isAdded = true;
    this.functions.push(func);
    if (func.classType != null && func.methodName != null) {
      let key = getClassMethodKey(getClassKey(func.classType as ClassType), func.methodName as String);
      this.classMethodMap[key] = func;
      let cKey = getClassKey(func.classType as ClassType) as String;
      if (!this.classMethods.has(cKey)) {
        this.classMethods[cKey] = new Array<WasmFunction>();
      }
      this.classMethods[cKey].push(func);
    }
    if (func.isFunctionAdaptation && func.functionAdaptationSource != null && func.functionAdaptationTarget != null) {
      let key = getFunctionAdaptationKey(func.functionAdaptationSource as Type, func.functionAdaptationTarget as Type);
      this.functionAdaptations[key] = func;
    }
    if (func.isClosure) {
      for (let symId in func.mutableCaptures) {
        this.mutableCapturedSymbols.add(symId);
      }
    }
  }

  getArray(elementType: ValType, isMutable: boolean): WasmArray {
    let finalElemType = match (elementType) {
      case ValTypeRef {target}: new ValTypeRefNull(target)
      case _: elementType
    };
    let key = getArrayKey(finalElemType, isMutable);
    if (let (true, cached) = this.#arrayCache.get(key)) {
      return cached;
    }
    let arr = new WasmArray(finalElemType, isMutable);
    this.types.push(arr);
    this.#arrayCache[key] = arr;
    return arr;
  }

  getByteArrayType(): WasmArray {
    return this.getArray(new ValTypeI8(), true);
  }

  addData(bytes: ByteBuffer): i32 {
    let segment = new ByteBuffer();
    segment.writeByte(1); // passive flag
    segment.writeULEB128(bytes.length);
    segment.writeBuffer(bytes);
    this.datas.push(segment);
    this.rawDatas.push(bytes);
    return this.datas.length - 1;
  }

  /**
   * Records a string literal for the shared registry. The packed
   * shared segment built at layout is the ONE store for literal
   * bytes: registration creates no per-literal data segment, and
   * every materialization is a zero-copy view into the shared
   * backing array. A literal missing from the registry at codegen
   * time is a discovery bug and fails the compile loudly.
   */
  registerStringLiteral(value: String): void {
    if (!this.stringLiterals.has(value)) {
      this.stringLiterals[value] = -1;
    }
  }

  ensureMemory(): void {
    this.hasMemory = true;
  }
  
  ensureExceptionInfra(model: SemanticModel): void {
    if (this.exceptionTag != null) {
      return;
    }
    
    var errorStruct: WasmStruct | null = null;
    for (let pair in this.classInfos) {
      let info = pair.value;
      let s = info.structType;
      if (s.name != null && (s.name as String) == "Error") {
        errorStruct = s;
      }
    }
    
    let payloadType = if (errorStruct != null) new ValTypeRefNull(errorStruct as WasmStruct) else new ValTypeEqRef();
    
    let params = new Array<ValType>();
    let sig = this.getSignature(params, new Array<ValType>());
    
    let tag = new WasmTag(sig);
    this.tags.push(tag);
    this.exceptionTag = tag;
    this.exportTagMap["__zena_exception"] = tag;
    
    let payloadGlobal = new WasmGlobal(
      "__zena_exception_payload",
      "__zena_exception_payload",
      payloadType,
      true,
      null,
      null,
      model
    );
    this.globals.push(payloadGlobal);
    this.exceptionPayload = payloadGlobal;

    this.ensureStringCreate(model);
    this.ensureStringSetByte(model);
  }

  ensureStringCreate(model: SemanticModel): void {
    if (this.stringCreateFunc != null) return;
    let createParams = new Array<ValType>();
    createParams.push(new ValTypeI32());
    let createReturns = new Array<ValType>();
    createReturns.push(new ValTypeExternRef());
    let createSig = this.getSignature(createParams, createReturns);
    let createFunc = new WasmFunction(createSig, null, model);
    createFunc.name = "$stringCreate";
    this.addFunction(createFunc);
    this.stringCreateFunc = createFunc;
  }

  ensureStringSetByte(model: SemanticModel): void {
    if (this.stringSetByteFunc != null) return;
    let setByteParams = new Array<ValType>();
    setByteParams.push(new ValTypeExternRef());
    setByteParams.push(new ValTypeI32());
    setByteParams.push(new ValTypeI32());
    let setByteReturns = new Array<ValType>();
    let setByteSig = this.getSignature(setByteParams, setByteReturns);
    let setByteFunc = new WasmFunction(setByteSig, null, model);
    setByteFunc.name = "$stringSetByte";
    this.addFunction(setByteFunc);
    this.stringSetByteFunc = setByteFunc;
  }

  ensureStringGetByte(model: SemanticModel): void {
    if (this.stringGetByteFunc != null) return;
    let getByteParams = new Array<ValType>();
    getByteParams.push(new ValTypeExternRef());
    getByteParams.push(new ValTypeI32());
    let getByteReturns = new Array<ValType>();
    getByteReturns.push(new ValTypeI32());
    let getByteSig = this.getSignature(getByteParams, getByteReturns);
    let getByteFunc = new WasmFunction(getByteSig, null, model);
    getByteFunc.name = "$stringGetByte";
    this.addFunction(getByteFunc);
    this.stringGetByteFunc = getByteFunc;
  }

  ensureStringGetLength(model: SemanticModel): void {
    if (this.stringGetLengthFunc != null) return;
    let getLengthParams = new Array<ValType>();
    getLengthParams.push(new ValTypeExternRef());
    let getLengthReturns = new Array<ValType>();
    getLengthReturns.push(new ValTypeI32());
    let getLengthSig = this.getSignature(getLengthParams, getLengthReturns);
    let getLengthFunc = new WasmFunction(getLengthSig, null, model);
    getLengthFunc.name = "$stringGetLength";
    this.addFunction(getLengthFunc);
    this.stringGetLengthFunc = getLengthFunc;
  }

  ensureStringHelpers(model: SemanticModel): void {
    this.ensureStringCreate(model);
    this.ensureStringSetByte(model);
    this.ensureStringGetByte(model);
    this.ensureStringGetLength(model);
  }

  ensureHashInfra(model: SemanticModel): void {
    if (this.stringHashFunc != null) {
      return;
    }
    var stringStruct: WasmStruct | null = null;
    for (let pair in this.classInfos) {
      let info = pair.value;
      let s = info.structType;
      if (s.name != null && (s.name as String) == "String") {
        stringStruct = s;
      }
    }
    if (stringStruct == null) {
      throw new Error("$stringHash discovery: String class struct not found!");
    }
    let params = new Array<ValType>();
    params.push(new ValTypeRefNull(stringStruct as WasmStruct));
    let returns = new Array<ValType>();
    returns.push(new ValTypeI32());
    let sig = this.getSignature(params, returns);
    let hashFunc = new WasmFunction(sig, null, model);
    hashFunc.name = "$stringHash";
    this.addFunction(hashFunc);
    this.stringHashFunc = hashFunc;
  }

  #visitTypeForLayout(t: WasmType, visited: HashSet<WasmType>, sortedTypes: Array<WasmType>): void {
    if (visited.has(t)) {
      return;
    }
    visited.add(t);
    if (t is WasmStruct) {
      let s = t as WasmStruct;
      if (s.superStruct != null) {
        this.#visitTypeForLayout(s.superStruct as WasmStruct, visited, sortedTypes);
      }
    }
    sortedTypes.push(t);
  }
  
  #referencesNominal(t: WasmType): boolean {
    if (t is WasmStruct || t is WasmArray) {
      return true;
    }
    if (t is WasmSignature) {
      let sig = t as WasmSignature;
      for (let param in sig.params) {
        match (param) {
          case ValTypeRef {target}: {
            if (this.#referencesNominal(target)) { return true; }
          }
          case ValTypeRefNull {target}: {
            if (this.#referencesNominal(target)) { return true; }
          }
          case _: {}
        }
      }
      for (let ret in sig.returns) {
        match (ret) {
          case ValTypeRef {target}: {
            if (this.#referencesNominal(target)) { return true; }
          }
          case ValTypeRefNull {target}: {
            if (this.#referencesNominal(target)) { return true; }
          }
          case _: {}
        }
      }
    }
    return false;
  }

  /**
   * Locks in the module layout, assigning final WebAssembly indices (i32)
   * to all types, functions, and globals. Must be called after all
   * discoveries are made, but before the emission passes begin.
   */
  layout(): void {
    // console.log("wasm.layout() called! types count = " + i32ToString(this.types.length));
    this.isLayoutLocked = true;
    
    this.classMethodMap.clear();
    this.classMethods.clear();
    this.functionAdaptations.clear();
    this.arrayMethods = new Array<WasmFunction>();
    for (let func in this.functions) {
      if (func.classType != null && func.methodName != null) {
        let key = getClassMethodKey(getClassKey(func.classType as ClassType), func.methodName as String);
        this.classMethodMap[key] = func;
        let cKey = getClassKey(func.classType as ClassType) as String;
        if (!this.classMethods.has(cKey)) {
          this.classMethods[cKey] = new Array<WasmFunction>();
        }
        this.classMethods[cKey].push(func);
      }
      if (func.isFunctionAdaptation && func.functionAdaptationSource != null && func.functionAdaptationTarget != null) {
        let key = getFunctionAdaptationKey(func.functionAdaptationSource as Type, func.functionAdaptationTarget as Type);
        this.functionAdaptations[key] = func;
      }
      if (func.classType != null) {
        let className = (func.classType as ClassType).name;
        if (className == "FixedArray" || className == "ImmutableArray") {
          this.arrayMethods.push(func);
        }
      }
    }
    
    let zone1 = new Array<WasmType>();
    let zone2 = new Array<WasmType>();
    
    for (let t in this.types) {
      if (t is WasmSignature) {
        if (!this.#referencesNominal(t)) {
          zone1.push(t);
        } else {
          zone2.push(t);
        }
      } else {
        zone2.push(t);
      }
    }
    
    let newTypes = new Array<WasmType>();
    for (let t in zone1) {
      newTypes.push(t);
    }
    for (let t in zone2) {
      newTypes.push(t);
    }
    
    let sortedTypes = new Array<WasmType>();
    let visited = new HashSet<WasmType>();
    for (let t in newTypes) {
      this.#visitTypeForLayout(t, visited, sortedTypes);
    }
    this.types = sortedTypes;

    for (var i = 0; i < this.types.length; i += 1) {
      let t = this.types[i];
      t.index = i;
      if (t is WasmStruct) {
        let ws = t as WasmStruct;
        if (ws.name != null && (ws.name as String).contains("Iterable_12_MapEntry_332_String_119_bool")) {
          console.log("layout assigned index: " + i32ToString(i) + " to " + (ws.name as String));
        }
      }
    }
    for (var i = 0; i < this.tags.length; i += 1) {
      let t = this.tags[i];
      t.index = i;
    }
    var functionIndex = 0;
    for (var i = 0; i < this.functionImports.length; i += 1) {
      let f = this.functionImports[i];
      f.index = functionIndex;
      functionIndex += 1;
    }
    for (var i = 0; i < this.functions.length; i += 1) {
      let f = this.functions[i];
      f.index = functionIndex;
      functionIndex += 1;
    }
    for (var i = 0; i < this.globals.length; i += 1) {
      let g = this.globals[i];
      g.index = i;
    }
  }
}
