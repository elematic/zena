import {
  Node, Expression, NodeId, ImportSpecifier, FunctionExpression, MethodDefinition, DeclareFunction, VariableDeclaration, FunctionDeclaration, IdentifierPattern,
} from '../ast.zena';
import { SemanticModel } from '../semantic-model.zena';
import { SymbolId } from '../scope/symbol.zena';
import { Error } from 'zena:error';
import { Hashable } from 'zena:hashable';
import {
  ValType, ValTypeVoid, ValTypeStructRef, ValTypeRefNull, ValTypeRef, ValTypeEqRef,
  ValTypeAnyRef, ValTypeI8, WasmType, valTypeEquals, ValTypeExternRef, ValTypeI32,
  valTypeToOpcode, nextWasmTypeUid, refTargetOf
} from './wasm.zena';
import { Array, MutableArray } from 'zena:array';
import { GrowableArray } from 'zena:growable-array';
import { HashMap } from 'zena:map';
import { HashSet } from 'zena:set';
import { NodeMap } from '../node-map.zena';
import {
  ClassType, FunctionType, Type, TypeParameterType,
} from '../types.zena';
import { String } from "zena:string";
import { i32ToString } from "zena:string-convert";
import { ByteBuffer } from 'zena:byte-buffer';
import { Program } from '../program.zena';

import {
  compareStrings, ClassKey, InterfaceKey, ClassInterfaceKey, InterfaceMemberKey, CellKey, ClosureKey, ExportKey, ExportGlobalKey, getClassKey, getClassPrivateFieldKey, isPresentWordName, presentWordCount, presentWordName, FunctionAdaptationKey, getFunctionAdaptationKey, ClassMethodKey, getClassMethodKey, SpecializedFunctionKey, ClosureSpecializationKey, FunctionValueWrapperKey,
} from './codegen-utils.zena';

@intrinsic('hash')
declare function hash<T>(value: T): i32;


export let sortWasmFields = (fields: GrowableArray<WasmField>): void => {
  let len = fields.length;
  for (var i = 1; i < len; i += 1) {
    let key = fields[i];
    var j = i - 1;
    while (j >= 0) {
      let a = fields[j].name;
      let b = key.name;
      if (a != null && b != null) {
        if (compareStrings(a, b) > 0) {
          fields[j + 1] = fields[j];
          j -= 1;
        } else {
          break;
        }
      } else {
        break;
      }
    }
    fields[j + 1] = key;
  }
};

export final class WasmExport {
  name: String;
  func: WasmFunction;
  new(this.name, this.func);
}

/**
 * Represents a reference to an entity that has a WebAssembly type index.
 * Before layout runs, the index is -1.
 */
export final class WasmField {
  name: String | null;
  /**
   * `var` for exactly one writer: struct layout can bake a field of a
   * not-yet-registered class as `structref`, and RTA re-resolves such
   * fields in place once discovery has settled (see
   * `Specializer.refreshErasedFieldTypes`). Inherited fields are
   * SHARED WasmField instances between super- and subclass structs, so
   * the in-place write is what keeps them consistent.
   */
  var type: ValType;
  isMutable: boolean;
  new(this.name, this.type, this.isMutable);
}


/**
 * Cache keys for WasmModule's structural type pools (getSignature / getStruct /
 * getArray). Each is a compact string encoding of the requested type's
 * identity, so that a HashMap lookup replaces a linear scan over all types.
 *
 * The shared building block is the ValType unit appended by appendValTypeKey:
 *
 *   <opcode>['#'<target uid> | '?'<target uid>]','
 *
 * i.e. the valtype's wasm opcode, plus the referenced WasmType's uid for
 * concrete ref types ('#' non-null, '?' nullable). Two ValTypes produce the
 * same unit iff valTypeEquals considers them equal.
 *
 * On top of that:
 *   SignatureKey: <param unit>* '|' <result unit>*
 *   StructKey:    [<struct name>] '\n' (<field name>('m'|'c')<field unit>'\n')*
 *   ArrayKey:     ('m'|'c') <element unit>
 *
 * The keys are derived purely from the freshly-built inputs of each request
 * (there is no pre-existing object to cache them on, unlike e.g. ClassKey
 * which is memoized on the ClassType).
 */
let valTypeHashCode = (vt: ValType): i32 => {
  return match (vt) {
    case ValTypeRef {target}: target.uid * 2
    case ValTypeRefNull {target}: target.uid * 2 + 1
    case _: valTypeToOpcode(vt)
  };
};

/**
 * Identity-based ValType equality for the type-pool cache keys below.
 *
 * This deliberately does NOT use valTypeEquals: that compares ref targets
 * by their type-section INDEX, which is -1 for every type until layout()
 * runs and is reassigned there. Keys whose equality mutates break the
 * caches twice over — distinct keys can spuriously merge before layout
 * (all indices equal -1), and entries cached before layout become
 * unfindable afterwards. Comparing the target OBJECTS is stable across
 * layout, matches valTypeHashCode (uid-based) so hashCode/equals agree,
 * and is equivalent to index equality for laid-out types.
 */
let valTypeKeyEquals = (a: ValType, b: ValType): boolean => {
  if (valTypeToOpcode(a) != valTypeToOpcode(b)) {
    return false;
  }
  return match (a) {
    case ValTypeRef {target as ta}: match (b) {
      case ValTypeRef {target as tb}: ta == tb
      case _: false
    }
    case ValTypeRefNull {target as ta}: match (b) {
      case ValTypeRefNull {target as tb}: ta == tb
      case _: false
    }
    case _: true
  };
};

export final class SignatureKey implements Hashable {
  params: GrowableArray<ValType>;
  returns: GrowableArray<ValType>;
  new(this.params, this.returns);

  hashCode(): i32 {
    var h = 17;
    for (let p in this.params) {
      h = h * 31 + valTypeHashCode(p);
    }
    h = h * 31 + 12345;
    for (let r in this.returns) {
      h = h * 31 + valTypeHashCode(r);
    }
    return h;
  }

  operator ==(other: SignatureKey): boolean {
    if (this.params.length != other.params.length || this.returns.length != other.returns.length) {
      return false;
    }
    for (var i = 0; i < this.params.length; i += 1) {
      if (!valTypeKeyEquals(this.params[i], other.params[i])) { return false; }
    }
    for (var j = 0; j < this.returns.length; j += 1) {
      if (!valTypeKeyEquals(this.returns[j], other.returns[j])) { return false; }
    }
    return true;
  }
}

let stringEquals = (s1: String | null, s2: String | null): boolean => {
  if (s1 == null) {
    return s2 == null;
  }
  if (s2 == null) {
    return false;
  }
  return s1 == s2;
};

export final class StructKey implements Hashable {
  name: String | null;
  fields: Array<WasmField>;
  new(this.name, this.fields);

  hashCode(): i32 {
    var h = if (this.name == null) 0 else hash(this.name as String);
    for (let f in this.fields) {
      if (f.name != null) {
        h = h * 31 + hash(f.name as String);
      }
      h = h * 31 + valTypeHashCode(f.type);
      if (f.isMutable) {
        h = h * 31 + 777;
      }
    }
    return h;
  }

  operator ==(other: StructKey): boolean {
    if (!stringEquals(this.name, other.name) || this.fields.length != other.fields.length) {
      return false;
    }
    for (var i = 0; i < this.fields.length; i += 1) {
      let f1 = this.fields[i];
      let f2 = other.fields[i];
      if (!stringEquals(f1.name, f2.name) || f1.isMutable != f2.isMutable || !valTypeKeyEquals(f1.type, f2.type)) {
        return false;
      }
    }
    return true;
  }
}

export final class ArrayKey implements Hashable {
  elementType: ValType;
  isMutable: boolean;
  new(this.elementType, this.isMutable);

  hashCode(): i32 {
    var h = valTypeHashCode(this.elementType);
    if (this.isMutable) {
      h = h * 31 + 999;
    }
    return h;
  }

  operator ==(other: ArrayKey): boolean {
    return this.isMutable == other.isMutable && valTypeKeyEquals(this.elementType, other.elementType);
  }
}

let getSignatureKey = (params: GrowableArray<ValType>, returns: GrowableArray<ValType>): SignatureKey => {
  return new SignatureKey(params, returns);
};

let getStructKey = (name: String | null, fields: Array<WasmField>): StructKey => {
  return new StructKey(name, fields);
};

let getArrayKey = (elementType: ValType, isMutable: boolean): ArrayKey => {
  return new ArrayKey(elementType, isMutable);
};

export final class WasmStruct extends WasmType {
  var superStruct: WasmStruct | null = null;
  var classType: ClassType | null = null;
  name: String | null;
  fields: GrowableArray<WasmField>;
  /** Lazy name→index cache; sized-guarded because RTA appends fields. */
  var #fieldIndexCache: HashMap<String, i32> | null = null;
  var #fieldIndexCacheSize = -1;
  new(this.name, this.fields) : super();

  /**
   * Resolves a private member's mangled field name against this
   * struct. Field names carry the key of the class the STRUCT was
   * built for — the specialized class for per-specialization structs,
   * the generic template for structs shared across erased-identical
   * specializations, and the declaring ancestor for inherited fields —
   * so no single caller-side mangle can be correct. The search order
   * preserves lexical privacy: first the accessor's written class
   * chain exactly (a subclass's shadowing private must not win), then
   * this struct's own class chain restricted to classes that are
   * specializations of the lexical class. Both backends share this.
   */
  resolvePrivateFieldName(lexicalCt: ClassType | null, propName: String): String | null {
    if (lexicalCt != null) {
      var l: ClassType | null = lexicalCt;
      while (l != null) {
        var g: ClassType | null = l;
        while (g != null) {
          // A mixin's This class namespaces its private fields with
          // the mixin's scope key (ClassType.privateScopeKey), shared
          // by all applications of the mixin.
          let gc = g;
          let key = if (gc.privateScopeKey != null) {
            getClassPrivateFieldKey(gc.privateScopeKey as String as ClassKey, propName)
          } else {
            getClassPrivateFieldKey(getClassKey(gc), propName)
          };
          if (this.fieldIndexByName(key) >= 0) {
            return key;
          }
          g = gc.genericSource;
        }
        l = l.superType;
      }
    }
    let lexCanonical = if (lexicalCt != null) canonicalClassKey(lexicalCt) else null;
    var c = this.classType;
    while (c != null) {
      let cc = c;
      if (lexCanonical == null ||
          (canonicalClassKey(cc) as String) == (lexCanonical as ClassKey) as String) {
        let key = getClassPrivateFieldKey(getClassKey(cc), propName);
        if (this.fieldIndexByName(key) >= 0) {
          return key;
        }
      }
      c = cc.superType;
    }
    return null;
  }

  /**
   * Index of the named field, or -1. Memoized: field lookups by name
   * happen once per field access during lowering and emission, and a
   * per-access linear scan would multiply out to O(accesses × fields)
   * on wide structs. The cache rebuilds if fields were appended since
   * it was built (interface vtable structs gain fields during RTA).
   */
  fieldIndexByName(fieldName: String): i32 {
    if (this.#fieldIndexCache == null ||
        this.#fieldIndexCacheSize != this.fields.length) {
      let cache = new HashMap<String, i32>();
      for (var i = 0; i < this.fields.length; i += 1) {
        let n = this.fields[i].name;
        if (n != null) {
          cache[n] = i;
        }
      }
      this.#fieldIndexCache = cache;
      this.#fieldIndexCacheSize = this.fields.length;
    }
    let cache = this.#fieldIndexCache as HashMap<String, i32>;
    return if (let (true, idx) = cache.get(fieldName)) idx else -1;
  }
}

/** The generic-source root's key: specializations compare equal to
 * their template through this. */
export let canonicalClassKey = (ct: ClassType): ClassKey => {
  var c = ct;
  while (c.genericSource != null) {
    c = c.genericSource as ClassType;
  }
  return getClassKey(c);
};

export final class WasmArray extends WasmType {
  elementType: ValType;
  isMutable: boolean;
  new(this.elementType, this.isMutable) : super();
}

/**
 * A WebAssembly function signature.
 * Deduped by the module so identical signatures share the same type index.
 * Params and returns are represented by WebAssembly ValType enums (e.g. i32, f64).
 */
export final class WasmSignature extends WasmType {
  params: GrowableArray<ValType>;
  returns: GrowableArray<ValType>;
  new(this.params, this.returns) : super();
}

/** The WasmStruct behind a reference ValType, or null. */
export let asWasmStruct = (vt: ValType): WasmStruct | null => {
  let t = refTargetOf(vt);
  if (t is WasmStruct) {
    return t;
  }
  return null;
};

/** The WasmSignature behind a reference ValType, or null. */
export let asWasmSignature = (vt: ValType): WasmSignature | null => {
  let t = refTargetOf(vt);
  if (t is WasmSignature) {
    return t;
  }
  return null;
};

/** The WasmArray behind a reference ValType, or null. */
export let asWasmArray = (vt: ValType): WasmArray | null => {
  let t = refTargetOf(vt);
  if (t is WasmArray) {
    return t;
  }
  return null;
};

/**
 * Wasm-level assignability between value types: may a value of type `a`
 * flow where `b` is expected? Conservative: scalar types must match
 * exactly; reference types allow dropping non-nullability, walking
 * struct supertype chains, and widening struct or array targets to
 * eqref/anyref (all Zena heap values are eq).
 */
/** Nullability-SENSITIVE structural equality. valTypeEquals treats
 * (ref T) and (ref null T) as equal (ref locals are declared nullable
 * and re-cast at uses), but subtyping must not: a nullable value
 * never conforms to a non-null slot. */
export let valTypeIdentical = (a: ValType, b: ValType): boolean => {
  return match (a) {
    case ValTypeRef as ta: match (b) {
      case ValTypeRef as tb: ta.target.index == tb.target.index
      case _: false
    }
    case ValTypeRefNull as ta: match (b) {
      case ValTypeRefNull as tb: ta.target.index == tb.target.index
      case _: false
    }
    case _: valTypeEquals(a, b)
  };
};

export let isValSubtype = (a: ValType, b: ValType): boolean => {
  if (valTypeEquals(a, b)) {
    return true;
  }
  if (a is ValTypeStructRef) {
    // structref <: eqref <: anyref.
    return b is ValTypeAnyRef || b is ValTypeEqRef;
  }
  let aTarget = refTargetOf(a);
  if (aTarget == null) {
    return false;
  }
  // a is a concrete ref; non-null may widen to nullable, never the reverse.
  let aNullable = a is ValTypeRefNull;
  if (b is ValTypeAnyRef || b is ValTypeEqRef) {
    return true;
  }
  if (b is ValTypeStructRef) {
    return aTarget is WasmStruct;
  }
  let bTarget = refTargetOf(b);
  if (bTarget == null) {
    return false;
  }
  let bNullable = b is ValTypeRefNull;
  if (aNullable && !bNullable) {
    return false;
  }
  return heapSubtype(aTarget, bTarget);
};

/** Declared-subtype check between heap types (struct super chains). */
let heapSubtype = (a: WasmType, b: WasmType): boolean => {
  if (a == b) {
    return true;
  }
  if (a is WasmStruct) {
    var current: WasmStruct | null = a.superStruct;
    while (current != null) {
      if (current == b) {
        return true;
      }
      current = current.superStruct;
    }
  }
  return false;
};

/**
 * Represents a single compiled WebAssembly function.
 * Tracks its eventual index, signature, and the AST node it was derived from.
 */
export final class WasmFunction implements Hashable {
  /** The semantic model of the module that declares this function. */
  var model: SemanticModel;
  var index: i32 = -1;
  /** Process-unique id, used for identity-based hashing. */
  uid: i32 = nextWasmTypeUid();
  var name: String | null = null;
  var methodName: String | null = null;
  var structType: WasmStruct | null = null;
  var classType: ClassType | null = null;
  var classDecl: Node | null = null;
  var signature: WasmSignature;
  var node: Node | null = null;
  var isImport: boolean = false;
  var isStatic: boolean = false;
  var importModule: String | null = null;
  var importName: String | null = null;
  /**
   * `@external(..., "async")`: lower the call with the canonical `async`
   * option, so it returns a subtask handle instead of waiting. Only the
   * component target can do anything with it — a core module has no
   * canonical ABI to lower through. See
   * docs/design/component-emission.md 1.6.
   */
  var importIsAsync: boolean = false;
  /**
   * `@external("canon", "stream.write", "stream<u8>")`: the WIT type a
   * typed canonical builtin operates on, spelled as WIT. The stream and
   * future builtins are per-type in the canon section — the immediate
   * is a component type index — so the declaration has to say which
   * type this builtin is an instance of. Empty for everything else.
   */
  var importCanonType: String = "";
  var isCaseClassEq: boolean = false;
  var isCaseClassHash: boolean = false;
  /**
   * Generator split-pass roles (ir/generators.zena): the generator
   * function itself becomes the frame-allocating ramp; its
   * synthesized companion carries the state-machine next() body.
   */
  var isGeneratorRamp: boolean = false;
  var isGeneratorNext: boolean = false;
  /**
   * Async split-pass roles (ir/async.zena), the same shape: the async
   * function itself becomes the frame-allocating ramp, and its
   * synthesized companion carries the state-machine step() body.
   */
  var isAsyncRamp: boolean = false;
  var isAsyncStep: boolean = false;
  /**
   * The synthesized export wrapper for an async `main`: starts the
   * ramp, drains the microtask queue, and unwraps the settled value
   * (async.md §4, Level 0).
   */
  var isAsyncMainWrapper: boolean = false;
  /**
   * A function the component target synthesizes to sit between the
   * canonical ABI and a Zena one: `main$componentRun`, which calls main
   * and then asks the p3 driver for the callback code, and the
   * `$componentExport` wrappers, which convert a signature's strings to
   * and from linear memory. Their bodies live in
   * ir/component-adapters.zena rather than in any source file.
   */
  var isComponentAdapter: boolean = false;
  /**
   * Set on body-less functions that exist only to occupy a vtable
   * slot. A class's vtable struct declares one exactly-typed funcref
   * field per method of the hierarchy, so even a method that
   * reachability never saw a call to must put SOMETHING of the right
   * signature in its slot. Both backends emit a single `unreachable`
   * for these: a virtual dispatch landing on one means the liveness
   * analysis was wrong, and trapping loudly is the correct response.
   */
  var isVtableSlotStub: boolean = false;
  /**
   * Set on functions compiled from a mixin declaration's body: the
   * mixin's private scope key ("<Mixin>_This@<path>"). Private
   * accesses in such functions resolve to "<scope>::#name" — mixin
   * privates are lexical to the mixin declaration and never alias a
   * host class's same-named private. Null for functions written in a
   * class body.
   *
   * Registration paths that know the scope set it directly; lowering
   * derives it from the function's node otherwise
   * (`mixinScopeOfNode`), which is what covers closures and
   * monomorphized generic methods. `privateScopeResolved` marks the
   * derivation as done, so a genuine null is not re-derived per
   * access.
   */
  var privateScopeKey: String | null = null;
  var privateScopeResolved: boolean = false;
  /** The target class struct for a synthesized field getter. */
  var getterStruct: WasmStruct | null = null;
  /** The index of the field in the class struct for the synthesized getter. */
  var getterFieldIndex: i32 = -1;
  /** The target class struct for a synthesized field setter. */
  var setterStruct: WasmStruct | null = null;
  /** The index of the field in the class struct for the synthesized setter. */
  var setterFieldIndex: i32 = -1;
  /**
   * For an adapted record dispatch's `$present` word getter: how each
   * target mask bit (globally indexed across all words) derives from
   * the source — -1 = absent (constant 0), -2 = required in the source
   * (constant 1), else the source's global bit index.
   */
  var getterMaskSpec: Array<i32> | null = null;
  /** Which 64-bit word of the target mask this getter assembles. */
  var getterMaskWord: i32 = 0;
  /**
   * An adapted getter for an optional target field the source shape
   * lacks: return the slot type's zero value (the mask reports the
   * absence; there is nothing to read).
   */
  var getterReturnsZero: boolean = false;
  /** The concrete target function for an interface trampoline method/property call. */
  var interfaceTrampolineTarget: WasmFunction | null = null;
  /** The target imported function for an external reference wrapper. */
  var importWrapperTarget: WasmFunction | null = null;
  var intrinsic: String | null = null;

  var isReached: boolean = false;
  var isAdded: boolean = false;
  var isClosure: boolean = false;
  var isReferenceTaken: boolean = false;
  var contextStruct: WasmStruct | null = null;
  var captures = new GrowableArray<SymbolId>();
  var mutableCaptures = new HashSet<SymbolId>();
  var capturesThis: boolean = false;
  var isFunctionAdaptation: boolean = false;
  var functionAdaptationSource: FunctionType | null = null;
  var functionAdaptationTarget: FunctionType | null = null;
  var functionAdaptationResolvedSourceStruct: WasmStruct | null = null;
  var functionAdaptationResolvedTargetStruct: WasmStruct | null = null;
  var isClosureWrapper: boolean = false;
  var closureWrapperTarget: WasmFunction | null = null;
  var typeParameters: Array<TypeParameterType> | null = null;
  var typeArguments: Array<Type> | null = null;
  /**
   * Memoized results of substituteTypeParamsInFunctionContext for this
   * function, keyed by input type identity (codegen/type-mapping.zena).
   */
  var codegenSubstCache: HashMap<Type, Type> | null = null;

  var closureTrampoline: WasmFunction | null = null;
  var isClosureTrampoline: boolean = false;
  var closureTrampolineTarget: WasmFunction | null = null;

  new(this.signature, this.node, this.model);
  hashCode(): i32 {
    return this.uid;
  }
}

export final class VTableInit {
  structType: WasmStruct;
  funcs: Array<WasmFunction>;
  new(this.structType, this.funcs) {
    for (let f in this.funcs) {
      f.isReferenceTaken = true;
    }
  }
}

export final class WasmGlobal {
  var index: i32 = -1;
  name: String;
  zenaName: String;
  /**
   * Mutable only so creators that attach an in-place constant initializer
   * AFTER construction (initSingletonStruct, initArraySize) can re-tighten
   * a reference type to non-nullable; the constructor below conservatively
   * nullifies ref types it cannot prove initialized in place.
   */
  var type: ValType;
  isMutable: boolean;
  var initExpr: Expression | null = null;
  var initVTable: VTableInit | null = null;
  var initSingletonStruct: ClassType | null = null;
  var initArraySize: i32 = -1;
  var namespaceImport: ImportSpecifier | null = null;
  model: SemanticModel;
  new(
    this.name,
    this.zenaName,
    type: ValType,
    this.isMutable,
    this.initExpr,
    this.initVTable,
    this.model
  ) : type = if (isMutable || (initExpr == null && initVTable == null)) {
        match (type) {
          case ValTypeRef {target}: new ValTypeRefNull(target)
          case _: type
        }
      } else {
        type
      } {}
}

export final class RecordDispatchInfo {
  fatPtrType: WasmStruct;
  vtableType: WasmStruct;
  concreteType: WasmStruct;
  vtableGlobal: WasmGlobal;
  fields: Array<WasmField>;
  getterTypes: Array<WasmSignature>;
  /**
   * Sorted optional field names of the (target) record type; position =
   * presence-bit index. Part of the dispatch key: two record types with
   * identical field lists but different optional sets have different
   * getter semantics.
   */
  optionalNames: Array<String>;
  /** For an adapted dispatch: the SOURCE shape's sorted optional names
   *  (equals optionalNames on a plain dispatch). */
  inOptionalNames: Array<String>;

  new(this.fatPtrType, this.vtableType, this.concreteType, this.vtableGlobal, this.fields, this.getterTypes, this.optionalNames, this.inOptionalNames);

  optionalBitOf(name: String): i32 {
    for (var i = 0; i < this.optionalNames.length; i += 1) {
      if (this.optionalNames[i] == name) { return i; }
    }
    return -1;
  }
}

let stringArraysEqual = (a: Array<String>, b: Array<String>): boolean => {
  if (a.length != b.length) { return false; }
  for (var i = 0; i < a.length; i += 1) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
};

export final class ClassCodegenInfo {
  structType: WasmStruct;
  var vtableStructType: WasmStruct | null = null;
  var vtableGlobal: WasmGlobal | null = null;
  var singletonGlobal: WasmGlobal | null = null;
  subclasses = new GrowableArray<ClassCodegenInfo>();
  new(this.structType);

  getTransitiveSubclasses(result: GrowableArray<ClassCodegenInfo>): void {
    for (let sub in this.subclasses) {
      result.push(sub);
      sub.getTransitiveSubclasses(result);
    }
  }
}

export final class WasmTag {
  var index: i32 = -1;
  signature: WasmSignature;
  new(this.signature);
}

export final class StringLiteralLocation {
  offset: i32;
  length: i32;
  new(this.offset, this.length);
}

/**
 * Codegen's memo tables for one class, owned by the `WasmModule` of the
 * compile that filled them.
 *
 * These were fields on `ClassType`. A checker type outlives the compile
 * that produced it whenever check results are reused — the point of
 * sharing an already-checked stdlib across entry points — so codegen
 * state parked on one is visible to every later compile. The entries are
 * pure functions of checker types, so sharing them is not *wrong*, but
 * they grow without bound in a long-lived process and the instantiations
 * table hands out `ClassType` identities that downstream codegen treats
 * as belonging to the current module.
 *
 * Owning them per compile also survives the compiler going async: a
 * module-global swept between compiles would pull the memo out from
 * under any compile that happened to be interleaved with the sweep, and
 * hand it a different `ClassType` for an instantiation it had already
 * used.
 */
export final class ClassSubstitutions {
  /** Type parameters and arguments in scope for the class, flattened. */
  var params: Array<TypeParameterType> | null = null;
  var args: Array<Type> | null = null;
  /** substituteTypeParamsInClassContext results, by input type identity. */
  substCache = new HashMap<Type, Type>();
  /** Instantiations of this class, keyed by substituted argument uids. */
  instantiations = new HashMap<String, ClassType>();

  new();
}

export final class WasmModule {
  /**
   * Per-class substitution memos for this compile. Keyed by
   * `ClassType.uid`, not by the type: `Type`'s cases are case classes, so
   * `==` is structural while `hashCode` is the uid — an inconsistent pair
   * to hash on. The uid is the identity these tables want ("type identity
   * is equality", types.zena).
   */
  classSubstitutions = new HashMap<i32, ClassSubstitutions>();

  /** The memo tables for `ct`, created on first use. */
  substitutionsFor(ct: ClassType): ClassSubstitutions {
    if (let (true, existing) = this.classSubstitutions.get(ct.uid)) {
      return existing;
    }
    let fresh = new ClassSubstitutions();
    this.classSubstitutions[ct.uid] = fresh;
    return fresh;
  }

  var types = new GrowableArray<WasmType>();
  tags = new GrowableArray<WasmTag>();
  exportTagMap = new HashMap<String, WasmTag>();
  var exceptionTag: WasmTag | null = null;
  var exceptionPayload: WasmGlobal | null = null;
  var cancellationTag: WasmTag | null = null;
  var isLayoutLocked: boolean = false;
  var startFunction: WasmFunction | null = null;
  
  /** 
   * A complete list of all imported functions.
   */
  functionImports = new GrowableArray<WasmFunction>();

  /** 
   * A complete list of all functions in the module, including anonymous
   * functions that do not have a corresponding symbol. Array order dictates
   * the final WebAssembly function index.
   */
  var functions = new GrowableArray<WasmFunction>();
  
  globals = new GrowableArray<WasmGlobal>();



  /**
   * Maps a Zena symbol ID to its compiled WebAssembly function.
   * Used to resolve call targets. Anonymous functions will not be in this map.
   */
  functionMap = new HashMap<SymbolId, WasmFunction>();
  
  /**
   * Maps a Zena AST Node ID to its compiler intrinsic name (e.g. `memory.size`).
   */
  intrinsics = new HashMap<NodeId, String>();

  globalMap = new HashMap<SymbolId, WasmGlobal>();

  var program: Program | null = null;
  var stringClass: ClassType | null = null;
  var templateStringsArrayClass: ClassType | null = null;
  var boxClass: ClassType | null = null;
  exportMap = new HashMap<ExportKey, WasmFunction>();
  exportGlobalMap = new HashMap<ExportGlobalKey, WasmGlobal>();
  classInfos = new HashMap<ClassKey, ClassCodegenInfo>();
  /**
   * Vtable method-name lists for specialized classes, keyed by class key.
   * The vtable belongs to the specialized class itself, not to whichever
   * ClassType instance mentions it: many instances share one class key, and
   * keeping this state per key (instead of mutating ClassType.vtable on
   * instances) lets substitution share instantiation objects safely.
   */
  vtables = new HashMap<ClassKey, GrowableArray<String>>();
  interfaceStructs = new HashMap<InterfaceKey, WasmStruct>();
  interfaceVTableStructs = new HashMap<InterfaceKey, WasmStruct>();
  /** One entry per emitted rec group, in emission order; a size of 1
   * emits the bare (header-free) form. Set by layout(). */
  var typeRecGroupSizes = new GrowableArray<i32>();
  classInterfaceVTables = new HashMap<ClassInterfaceKey, WasmGlobal>();
  #signatureCache = new HashMap<SignatureKey, WasmSignature>();
  #structCache = new HashMap<StructKey, WasmStruct>();
  /**
   * Interned structs with no name — boxed tuples and records. Lowered
   * bodies reference them directly and run after layout, so nothing in
   * a signature roots them; RTA roots this list wholesale, like
   * closure structs.
   */
  anonymousStructs = new GrowableArray<WasmStruct>();
  #arrayCache = new HashMap<ArrayKey, WasmArray>();
  usedInterfaceAdaptations = new HashMap<ClassInterfaceKey, boolean>();
  usedInterfaceMembers = new HashMap<InterfaceMemberKey, boolean>();
  classMethodMap = new HashMap<ClassMethodKey, WasmFunction>();
  classMethods = new HashMap<String, GrowableArray<WasmFunction>>();
  var wasiWriteStringHelper: WasmFunction | null = null;
  var stringHashHelper: WasmFunction | null = null;
  functionAdaptations = new HashMap<FunctionAdaptationKey, WasmFunction>();
  var arrayMethods = new GrowableArray<WasmFunction>();
  
  /**
   * The vtable global registered for exactly this (class, interface) pair,
   * or null. There is deliberately no fuzzy fallback here: a miss means the
   * key derivation at the call site disagrees with the key derivation at
   * registration, which is a bug to surface, not to paper over. (A previous
   * fallback matched entries by `_`-suffix prefix, which is not unique
   * across specializations — Foo would match both Foo_i32 and Foo_string —
   * and it had trapped unconditionally since the compound-key migration,
   * proving no passing path ever needed it.)
   */
  getClassInterfaceVTable(key: ClassInterfaceKey): WasmGlobal | null {
    if (this.classInterfaceVTables.has(key)) {
      return this.classInterfaceVTables[key];
    }
    return null;
  }

  #stdlibFuncCache = new HashMap<String, WasmFunction>();

  getStdlibFunc(moduleName: String, exportName: String): WasmFunction | null {
    let key = moduleName + "::" + exportName;
    if (this.#stdlibFuncCache.has(key)) {
      return this.#stdlibFuncCache[key];
    }
    let prog = this.program;
    if (prog == null) { return null; }
    if (!prog.unitsByPath.has(moduleName)) { return null; }
    let unit = prog.unitsByPath[moduleName];
    for (let stmt in unit.ast.body) {
      match (stmt) {
        case DeclareFunction as df: {
          if (df.name.name == exportName) {
            let sym = unit.model.resolveDeclaration(df);
            if (sym != null && this.functionMap.has(sym.id)) {
              let f = this.functionMap[sym.id];
              this.#stdlibFuncCache[key] = f;
              return f;
            }
          }
        }
        case VariableDeclaration as vd: {
          if (vd.pattern is IdentifierPattern) {
            let pat = vd.pattern as IdentifierPattern;
            if (pat.name == exportName) {
              let sym = unit.model.resolve(pat);
              if (sym != null && this.functionMap.has(sym.id)) {
                let f = this.functionMap[sym.id];
                this.#stdlibFuncCache[key] = f;
                return f;
              }
            }
          }
        }
        case FunctionDeclaration as fd: {
          if (fd.name.name == exportName) {
            let sym = unit.model.resolve(fd.name);
            if (sym != null && this.functionMap.has(sym.id)) {
              let f = this.functionMap[sym.id];
              this.#stdlibFuncCache[key] = f;
              return f;
            }
          }
        }
        case _: {}
      }
    }
    return null;
  }
  mutableCapturedSymbols = new HashSet<SymbolId>();
  
  datas = new GrowableArray<ByteBuffer>();
  rawDatas = new GrowableArray<ByteBuffer>();
  stringLiterals = new HashMap<String, i32>();
  stringLiteralIds = new HashMap<String, i32>();
  stringLiteralLocations = new HashMap<String, StringLiteralLocation>();
  var sharedStringsGlobal: WasmGlobal | null = null;
  var stringFromSharedFunc: WasmFunction | null = null;
  var stringLiteralsArrayGlobal: WasmGlobal | null = null;
  var getStringLiteralFunc: WasmFunction | null = null;
  var stringArrayType: WasmArray | null = null;
  var sharedStringsDataIdx: i32 = -1;
  var sharedStringsLength: i32 = 0;
  var hasMemory: boolean = false;
  var wasiFdWriteIndex: i32 = -1;
  var wasiWriteStringIndex: i32 = -1;
  var stringHashFunc: WasmFunction | null = null;
  /**
   * Set by RTA when String is genuinely instantiated. The `$string*`
   * host-interop helpers are synthesized against String's struct
   * layout and exist to hand String values across the host boundary,
   * so they follow instantiation — declaration is not evidence, since
   * every program declares String through the prelude.
   */
  var stringClassIsInstantiated = false;
  /**
   * Which DIRECTIONS the host boundary moves strings in. Writes = the
   * host builds a guest String ($stringCreate/$stringSetByte): an
   * entry-unit export takes a String(-containing) parameter, a
   * reached host import returns one, or the exception infrastructure
   * exists (the host builds trace messages). Reads = the host
   * consumes one ($stringGetByte/$stringGetLength): an export returns
   * a String, or a reached host import takes one. A program whose
   * boundary only RETURNS a string ships only the read half.
   */
  var hostWritesStrings = false;
  var hostReadsStrings = false;
  /**
   * The same evidence for the component target: a String crosses one of
   * this module's exports, so `zena:component-abi` is rooted and the
   * lifts carry the memory options.
   *
   * Separate from the two above because the boundaries are different.
   * The `$string*` helpers hand a String to an embedder holding the core
   * module; a component's host never sees the core module, and its
   * strings cross as bytes in linear memory. Setting both would emit
   * four exports a component cannot call.
   */
  var componentMovesStrings = false;
  var stringCreateFunc: WasmFunction | null = null;
  var stringSetByteFunc: WasmFunction | null = null;
  var stringGetByteFunc: WasmFunction | null = null;
  /**
   * The split async-main entry for hosts that cannot wait (async.md §4):
   * start the body and park its future, then unwrap it once pings have
   * driven it to completion. Null unless the program has an async main.
   */
  var asyncMainStartFunc: WasmFunction | null = null;
  var asyncMainResultFunc: WasmFunction | null = null;
  /**
   * The component target's async entry point and the callback the host
   * re-enters it through, present exactly when the program links a
   * driver that needs one (today: `zena:time`'s p3 clock). Null
   * otherwise, and then the entry is lifted synchronously.
   */
  var componentEntryFunc: WasmFunction | null = null;
  var componentCallbackFunc: WasmFunction | null = null;
  /**
   * The `$componentExport` wrapper for each export whose signature
   * carries a `string`, keyed by the export's own name. An export with
   * only flat scalars has none and is lifted directly; the map is empty
   * for every other target.
   */
  var componentExportWrappers = new HashMap<ExportKey, WasmFunction>();
  /**
   * `zena:component-abi`'s allocator and its `post-return`, exported
   * from the core module under the names the canonical options use.
   * Present exactly when something in the component moves a `string`.
   */
  var componentReallocFunc: WasmFunction | null = null;
  var componentPostReturnFunc: WasmFunction | null = null;
  var stringGetLengthFunc: WasmFunction | null = null;
  
  recordDispatchInfos = new GrowableArray<RecordDispatchInfo>();
  adaptedDispatchInfos = new GrowableArray<RecordDispatchInfo>();
  
  cellStructs = new HashMap<CellKey, WasmStruct>();
  closureStructs = new HashMap<ClosureKey, WasmStruct>();
  closureFunctions = new NodeMap<WasmFunction>();
  specializedClosures = new HashMap<ClosureSpecializationKey, WasmFunction>();
  functionValueWrappers = new HashMap<FunctionValueWrapperKey, WasmFunction>();
  templateLiteralGlobals = new NodeMap<WasmGlobal>();
  genericFunctions = new HashMap<SymbolId, FunctionExpression>();
  genericFunctionModels = new HashMap<SymbolId, SemanticModel>();
  genericMethods = new HashMap<ClassMethodKey, MethodDefinition>();
  genericMethodModels = new HashMap<ClassMethodKey, SemanticModel>();
  specializedFunctions = new HashMap<SpecializedFunctionKey, WasmFunction>();
  
  functionAdaptationWrappers = new NodeMap<WasmFunction>();
  symbolNames = new HashMap<SymbolId, String>();
  
  findRecordDispatch(fields: Array<WasmField>, optionalNames: Array<String>): RecordDispatchInfo | null {
    for (var k = 0; k < this.recordDispatchInfos.length; k += 1) {
      let info = this.recordDispatchInfos[k];
      if (info.fields.length == fields.length &&
          stringArraysEqual(info.optionalNames, optionalNames)) {
        var match = true;
        for (var i = 0; i < fields.length; i += 1) {
          if (info.fields[i].name != fields[i].name || !valTypeEquals(info.fields[i].type, fields[i].type)) {
            match = false;
            break;
          }
        }
        if (match) return info;
      }
    }
    return null;
  }
  
  findAdaptedDispatch(inFields: Array<WasmField>, inOptionalNames: Array<String>, outFields: Array<WasmField>, outOptionalNames: Array<String>): RecordDispatchInfo | null {
    for (var k = 0; k < this.adaptedDispatchInfos.length; k += 1) {
      let info = this.adaptedDispatchInfos[k];
      if (!stringArraysEqual(info.optionalNames, outOptionalNames) ||
          !stringArraysEqual(info.inOptionalNames, inOptionalNames)) {
        continue;
      }
      let s = info.concreteType;
      var inMatch = false;
      if (s.fields.length == inFields.length) {
        inMatch = true;
        for (var i = 0; i < inFields.length; i += 1) {
          if (s.fields[i].name != inFields[i].name || !valTypeEquals(s.fields[i].type, inFields[i].type)) {
            inMatch = false;
            break;
          }
        }
      }
      if (inMatch && info.fields.length == outFields.length) {
        var outMatch = true;
        for (var i = 0; i < outFields.length; i += 1) {
          if (info.fields[i].name != outFields[i].name || !valTypeEquals(info.fields[i].type, outFields[i].type)) {
            outMatch = false;
            break;
          }
        }
        if (outMatch) {
          return info;
        }
      }
    }
    return null;
  }
  
  /**
   * Gets an existing WasmSignature if one matches the given parameters and
   * returns, or creates a new one and adds it to the type pool.
   *
   * Deduplicates by SignatureKey so identical signatures share the same
   * WebAssembly type index.
   */
  getSignature(params: GrowableArray<ValType>, returns: GrowableArray<ValType>): WasmSignature {
    let key = getSignatureKey(params, returns);
    if (let (true, cached) = this.#signatureCache.get(key)) {
      return cached;
    }
    if (this.isLayoutLocked) {
      var pStr = "";
      for (let p in params) {
        pStr = pStr + match (p) {
          case ValTypeRef as r: {
            if (r.target is WasmStruct) {
              let s = r.target as WasmStruct;
              "ref_" + (if (s.name == null) "anon" else s.name as String) + "(uid=" + i32ToString(s.uid) + ",idx=" + i32ToString(s.index) + ")"
            } else {
              "ref_non_struct(uid=" + i32ToString(r.target.uid) + ",idx=" + i32ToString(r.target.index) + ")"
            }
          }
          case ValTypeRefNull as rn: {
            if (rn.target is WasmStruct) {
              let s = rn.target as WasmStruct;
              "refnull_" + (if (s.name == null) "anon" else s.name as String) + "(uid=" + i32ToString(s.uid) + ",idx=" + i32ToString(s.index) + ")"
            } else {
              "refnull_non_struct(uid=" + i32ToString(rn.target.uid) + ",idx=" + i32ToString(rn.target.index) + ")"
            }
          }
          case _: i32ToString(valTypeToOpcode(p))
        } + ",";
      }
      var rStr = "";
      for (let r in returns) {
        rStr = rStr + match (r) {
          case ValTypeRef as r: {
            if (r.target is WasmStruct) {
              let s = r.target as WasmStruct;
              "ref_" + (if (s.name == null) "anon" else s.name as String) + "(uid=" + i32ToString(s.uid) + ",idx=" + i32ToString(s.index) + ")"
            } else {
              "ref_non_struct(uid=" + i32ToString(r.target.uid) + ",idx=" + i32ToString(r.target.index) + ")"
            }
          }
          case ValTypeRefNull as rn: {
            if (rn.target is WasmStruct) {
              let s = rn.target as WasmStruct;
              "refnull_" + (if (s.name == null) "anon" else s.name as String) + "(uid=" + i32ToString(s.uid) + ",idx=" + i32ToString(s.index) + ")"
            } else {
              "refnull_non_struct(uid=" + i32ToString(rn.target.uid) + ",idx=" + i32ToString(rn.target.index) + ")"
            }
          }
          case _: i32ToString(valTypeToOpcode(r))
        } + ",";
      }
      throw new Error("Signature allocated after layout! Params: " + pStr + " Returns: " + rStr);
    }
    let sig = new WasmSignature(params, returns);
    this.types.push(sig);
    this.#signatureCache[key] = sig;
    return sig;
  }

  getStruct(name: String | null, fields: Array<WasmField>): WasmStruct {
    let key = getStructKey(name, fields);
    if (let (true, cached) = this.#structCache.get(key)) {
      return cached;
    }
    if (this.isLayoutLocked) {
      var fieldNames = "";
      for (let f in fields) {
        if (f.name != null) {
          fieldNames = fieldNames + " " + (f.name as String);
        }
      }
      throw new Error("Struct allocated after layout:" + fieldNames);
    }
    let stFields = if (fields is GrowableArray<WasmField>) fields else {
      let copy = new GrowableArray<WasmField>();
      for (let f in fields) {
        copy.push(f);
      }
      copy
    };
    let st = new WasmStruct(name, stFields);
    this.types.push(st);
    this.#structCache[key] = st;
    if (name == null) {
      this.anonymousStructs.push(st);
    }
    return st;
  }

  getClosureStruct(params: GrowableArray<ValType>, returns: GrowableArray<ValType>): WasmStruct {
    let implParams = new GrowableArray<ValType>();
    implParams.push(new ValTypeStructRef());
    for (let p in params) {
      implParams.push(p);
    }
    let implSig = this.getSignature(implParams, returns);
    
    let fields = new GrowableArray<WasmField>();
    fields.push(new WasmField("func", new ValTypeRef(implSig), false));
    fields.push(new WasmField("ctx", new ValTypeStructRef(), false));
    
    return this.getStruct(null, fields);
  }
  
  getRecordDispatch(model: SemanticModel, fields: GrowableArray<WasmField>, optionalNames: Array<String>): RecordDispatchInfo {
    sortWasmFields(fields);

    let existing = this.findRecordDispatch(fields, optionalNames);
    if (existing != null) {
      return existing;
    }
    if (this.isLayoutLocked) {
      throw new Error("Struct allocated after layout");
    }
    
    let concreteType = this.getStruct(null, fields);
    let vtableFields = new GrowableArray<WasmField>();
    let getterTypes = new GrowableArray<WasmSignature>();
    let getters = new GrowableArray<WasmFunction>();
    
    for (var i = 0; i < fields.length; i += 1) {
      let getterValType = fields[i].type;
      
      let params = new GrowableArray<ValType>();
      params.push(new ValTypeStructRef());
      
      let returns = new GrowableArray<ValType>();
      if (getterValType != new ValTypeVoid()) {
        returns.push(getterValType);
      }
      
      let getterType = this.getSignature(params, returns);
      getterTypes.push(getterType);
      
      let getterFunc = new WasmFunction(getterType, null, model);
      getterFunc.getterStruct = concreteType;
      getterFunc.getterFieldIndex = i;
      this.addFunction(getterFunc);
      getters.push(getterFunc);
      
      vtableFields.push(new WasmField(
        fields[i].name,
        new ValTypeRef(getterType),
        false
      ));
    }
    
    let vtableType = this.getStruct(null, vtableFields);
    
    let fatPtrFields = new GrowableArray<WasmField>();
    fatPtrFields.push(new WasmField(null, new ValTypeStructRef(), false));
    fatPtrFields.push(new WasmField(null, new ValTypeRef(vtableType), false));
    
    let fatPtrType = this.getStruct(null, fatPtrFields);
    
    let vtableInit = new VTableInit(vtableType, getters);
    let vtableGlobal = new WasmGlobal("vtable_record", "vtable_record", new ValTypeRef(vtableType), false, null, vtableInit, model);
    this.globals.push(vtableGlobal);
    
    let info = new RecordDispatchInfo(fatPtrType, vtableType, concreteType, vtableGlobal, fields, getterTypes, optionalNames, optionalNames);
    this.recordDispatchInfos.push(info);

    return info;
  }
  
  getAdaptedRecordDispatch(model: SemanticModel, inFields: GrowableArray<WasmField>, inOptionalNames: Array<String>, outFields: GrowableArray<WasmField>, outOptionalNames: Array<String>): RecordDispatchInfo {
    sortWasmFields(inFields);
    sortWasmFields(outFields);

    let existing = this.findAdaptedDispatch(inFields, inOptionalNames, outFields, outOptionalNames);
    if (existing != null) {
      return existing;
    }
    if (this.isLayoutLocked) {
      throw new Error("Struct allocated after layout");
    }
      
    let inStructType = this.getStruct(null, inFields);
    let vtableFields = new GrowableArray<WasmField>();
    let getterTypes = new GrowableArray<WasmSignature>();
    let getters = new GrowableArray<WasmFunction>();
    
    for (var i = 0; i < outFields.length; i += 1) {
      let fieldValType = outFields[i].type;
      
      let params = new GrowableArray<ValType>();
      params.push(new ValTypeStructRef());
      
      let returns = new GrowableArray<ValType>();
      if (fieldValType != new ValTypeVoid()) {
        returns.push(fieldValType);
      }
      
      let getterType = this.getSignature(params, returns);
      getterTypes.push(getterType);
      
      let getterFunc = new WasmFunction(getterType, null, model);
      getterFunc.getterStruct = inStructType;

      // Find the corresponding field in the inFields by name
      var inIndex = -1;
      for (var j = 0; j < inFields.length; j += 1) {
        if (inFields[j].name == outFields[i].name) {
          inIndex = j;
          break;
        }
      }

      let outName = outFields[i].name;
      if (outName != null && isPresentWordName(outName as String)) {
        // The target's mask derives per bit from the source shape:
        // constant 1 for fields the source holds unconditionally,
        // constant 0 for fields it lacks, the source's own bit where
        // the source also tracks it. The spec covers every word; the
        // getter's word index selects its 64-bit slice.
        let spec = new GrowableArray<i32>();
        for (let optName in outOptionalNames) {
          var srcBit = -1;
          for (var j = 0; j < inOptionalNames.length; j += 1) {
            if (inOptionalNames[j] == optName) { srcBit = j; }
          }
          if (srcBit >= 0) {
            spec.push(srcBit);
          } else {
            var inHas = false;
            for (var j = 0; j < inFields.length; j += 1) {
              if (inFields[j].name != null &&
                  (inFields[j].name as String) == optName) {
                inHas = true;
              }
            }
            spec.push(if (inHas) -2 else -1);
          }
        }
        var word = 0;
        let wordCount = presentWordCount(outOptionalNames.length);
        for (var w = 0; w < wordCount; w += 1) {
          if (presentWordName(w) == (outName as String)) { word = w; }
        }
        getterFunc.getterMaskSpec = spec;
        getterFunc.getterMaskWord = word;
        getterFunc.getterFieldIndex = -1;
      } else if (inIndex < 0) {
        var outOptional = false;
        if (outName != null) {
          for (let optName in outOptionalNames) {
            if (optName == (outName as String)) { outOptional = true; }
          }
        }
        if (outOptional) {
          // Absent in the source; the mask reports it, the getter just
          // needs a well-typed placeholder.
          getterFunc.getterReturnsZero = true;
        }
        getterFunc.getterFieldIndex = -1;
      } else {
        getterFunc.getterFieldIndex = inIndex;
      }
      this.addFunction(getterFunc);
      getters.push(getterFunc);
      
      vtableFields.push(new WasmField(
        outFields[i].name,
        new ValTypeRef(getterType),
        false
      ));
    }
    
    let vtableType = this.getStruct(null, vtableFields);
    
    let fatPtrFields = new GrowableArray<WasmField>();
    fatPtrFields.push(new WasmField(null, new ValTypeStructRef(), false));
    fatPtrFields.push(new WasmField(null, new ValTypeRef(vtableType), false));
    
    let fatPtrType = this.getStruct(null, fatPtrFields);
    
    let vtableInit = new VTableInit(vtableType, getters);
    // TODO: better naming since keyStr is gone
    let vtableGlobal = new WasmGlobal("vtable_adapt", "vtable_adapt", new ValTypeRef(vtableType), false, null, vtableInit, model);
    this.globals.push(vtableGlobal);
    
    // We return information about the TARGET shape (outFields), but with a vtable matching our adapted getters
    let info = new RecordDispatchInfo(fatPtrType, vtableType, inStructType, vtableGlobal, outFields, getterTypes, outOptionalNames, inOptionalNames);
    this.adaptedDispatchInfos.push(info);
    
    return info;
  }

  /** The shared vtable method-name list for a specialized class key. */
  classVtable(key: ClassKey): GrowableArray<String> {
    if (let (true, existing) = this.vtables.get(key)) {
      return existing;
    }
    let fresh = new GrowableArray<String>();
    this.vtables[key] = fresh;
    return fresh;
  }

  addFunction(func: WasmFunction): void {
    if (func.isAdded) {
      return;
    }
    func.isAdded = true;
    this.functions.push(func);
    let {classType} = func;
    if (classType != null && func.methodName != null) {
      let key = getClassMethodKey(getClassKey(classType), func.methodName as String);
      this.classMethodMap[key] = func;
      let cKey = getClassKey(classType) as String;
      if (!this.classMethods.has(cKey)) {
        this.classMethods[cKey] = new GrowableArray<WasmFunction>();
      }
      this.classMethods[cKey].push(func);
    }
    if (func.isFunctionAdaptation && func.functionAdaptationSource != null && func.functionAdaptationTarget != null) {
      let key = getFunctionAdaptationKey(func.functionAdaptationSource as Type, func.functionAdaptationTarget as Type);
      this.functionAdaptations[key] = func;
    }
    if (func.isClosure) {
      for (let symId in func.mutableCaptures) {
        this.mutableCapturedSymbols.add(symId);
      }
    }
  }

  getArray(elementType: ValType, isMutable: boolean): WasmArray {
    let finalElemType = match (elementType) {
      case ValTypeRef {target}: new ValTypeRefNull(target)
      case _: elementType
    };
    let key = getArrayKey(finalElemType, isMutable);
    if (let (true, cached) = this.#arrayCache.get(key)) {
      return cached;
    }
    let arr = new WasmArray(finalElemType, isMutable);
    this.types.push(arr);
    this.#arrayCache[key] = arr;
    return arr;
  }

  getByteArrayType(): WasmArray {
    return this.getArray(new ValTypeI8(), true);
  }

  addData(bytes: ByteBuffer): i32 {
    let segment = new ByteBuffer();
    segment.writeByte(1); // passive flag
    segment.writeULEB128(bytes.length);
    segment.writeBuffer(bytes);
    this.datas.push(segment);
    this.rawDatas.push(bytes);
    return this.datas.length - 1;
  }

  /**
   * Records a string literal for the shared registry. The packed
   * shared segment built at layout is the ONE store for literal
   * bytes: registration creates no per-literal data segment, and
   * every materialization is a zero-copy view into the shared
   * backing array. A literal missing from the registry at codegen
   * time is a discovery bug and fails the compile loudly.
   */
  registerStringLiteral(value: String): void {
    if (!this.stringLiterals.has(value)) {
      this.stringLiterals[value] = -1;
    }
  }

  ensureMemory(): void {
    this.hasMemory = true;
  }
  
  ensureExceptionInfra(model: SemanticModel): void {
    if (this.exceptionTag != null) {
      return;
    }
    
    var errorStruct: WasmStruct | null = null;
    for (let pair in this.classInfos) {
      let info = pair.value;
      let s = info.structType;
      let name = s.name;
      if (name != null && name == "Error") {
        errorStruct = s;
      }
    }
    
    let payloadType = if (errorStruct != null) new ValTypeRefNull(errorStruct) else new ValTypeEqRef();
    
    let params = new GrowableArray<ValType>();
    let sig = this.getSignature(params, new GrowableArray<ValType>());
    
    let tag = new WasmTag(sig);
    this.tags.push(tag);
    this.exceptionTag = tag;
    this.exportTagMap["__zena_exception"] = tag;
    
    let payloadGlobal = new WasmGlobal(
      "__zena_exception_payload",
      "__zena_exception_payload",
      payloadType,
      true,
      null,
      null,
      model
    );
    this.globals.push(payloadGlobal);
    this.exceptionPayload = payloadGlobal;

    this.hostWritesStrings = true;
    this.ensureStringCreate(model);
    this.ensureStringSetByte(model);
  }

  /**
   * The cancellation channel's tag (docs/design/cancellation.md). No
   * payload and no payload global: `catch (e)` cannot observe a
   * cancellation, so there is nothing to carry. Created by RTA when
   * `cancel.raise` is reached; a program that never raises
   * cancellation gets no second tag, and finalizer regions keep their
   * one-tag shape.
   */
  ensureCancellationInfra(): void {
    if (this.cancellationTag != null) {
      return;
    }
    let sig = this.getSignature(new GrowableArray<ValType>(), new GrowableArray<ValType>());
    let tag = new WasmTag(sig);
    this.tags.push(tag);
    this.cancellationTag = tag;
    this.exportTagMap["__zena_cancellation"] = tag;
  }

  ensureStringCreate(model: SemanticModel): void {
    if (this.stringCreateFunc != null) return;
    let createParams = new GrowableArray<ValType>();
    createParams.push(new ValTypeI32());
    let createReturns = new GrowableArray<ValType>();
    createReturns.push(new ValTypeExternRef());
    let createSig = this.getSignature(createParams, createReturns);
    let createFunc = new WasmFunction(createSig, null, model);
    createFunc.name = "$stringCreate";
    this.addFunction(createFunc);
    this.stringCreateFunc = createFunc;
  }

  ensureStringSetByte(model: SemanticModel): void {
    if (this.stringSetByteFunc != null) return;
    let setByteParams = new GrowableArray<ValType>();
    setByteParams.push(new ValTypeExternRef());
    setByteParams.push(new ValTypeI32());
    setByteParams.push(new ValTypeI32());
    let setByteReturns = new GrowableArray<ValType>();
    let setByteSig = this.getSignature(setByteParams, setByteReturns);
    let setByteFunc = new WasmFunction(setByteSig, null, model);
    setByteFunc.name = "$stringSetByte";
    this.addFunction(setByteFunc);
    this.stringSetByteFunc = setByteFunc;
  }

  ensureStringGetByte(model: SemanticModel): void {
    if (this.stringGetByteFunc != null) return;
    let getByteParams = new GrowableArray<ValType>();
    getByteParams.push(new ValTypeExternRef());
    getByteParams.push(new ValTypeI32());
    let getByteReturns = new GrowableArray<ValType>();
    getByteReturns.push(new ValTypeI32());
    let getByteSig = this.getSignature(getByteParams, getByteReturns);
    let getByteFunc = new WasmFunction(getByteSig, null, model);
    getByteFunc.name = "$stringGetByte";
    this.addFunction(getByteFunc);
    this.stringGetByteFunc = getByteFunc;
  }

  ensureStringGetLength(model: SemanticModel): void {
    if (this.stringGetLengthFunc != null) return;
    let getLengthParams = new GrowableArray<ValType>();
    getLengthParams.push(new ValTypeExternRef());
    let getLengthReturns = new GrowableArray<ValType>();
    getLengthReturns.push(new ValTypeI32());
    let getLengthSig = this.getSignature(getLengthParams, getLengthReturns);
    let getLengthFunc = new WasmFunction(getLengthSig, null, model);
    getLengthFunc.name = "$stringGetLength";
    this.addFunction(getLengthFunc);
    this.stringGetLengthFunc = getLengthFunc;
  }

  ensureStringHelpers(model: SemanticModel): void {
    if (this.hostWritesStrings) {
      this.ensureStringCreate(model);
      this.ensureStringSetByte(model);
    }
    if (this.hostReadsStrings) {
      this.ensureStringGetByte(model);
      this.ensureStringGetLength(model);
    }
  }

  ensureStringLiteralHelpers(model: SemanticModel): void {
    if (this.stringFromSharedFunc != null && this.getStringLiteralFunc != null) {
      return;
    }
    let sKey = getClassKey(this.stringClass as ClassType);
    let info = this.classInfos[sKey];
    let stringStruct = info.structType;
    let stringType = new ValTypeRefNull(stringStruct);
    let stringArrayType = this.getArray(stringType, true);
    this.stringArrayType = stringArrayType;

    let arrayValType = new ValTypeRef(stringArrayType);
    let literalsArrayGlobal = new WasmGlobal("string_literals_array", "string_literals_array", arrayValType, false, null, null, model);
    literalsArrayGlobal.initArraySize = this.stringLiterals.size;
    this.globals.push(literalsArrayGlobal);
    this.stringLiteralsArrayGlobal = literalsArrayGlobal;

    let byteArrayStruct = this.getByteArrayType();
    let byteArrayType = new ValTypeRefNull(byteArrayStruct);

    let sharedGlobalName = "shared_strings_data";
    let sharedGlobal = new WasmGlobal(sharedGlobalName, sharedGlobalName, byteArrayType, true, null, null, model);
    this.globals.push(sharedGlobal);
    this.sharedStringsGlobal = sharedGlobal;

    let sigParams = new GrowableArray<ValType>();
    sigParams.push(new ValTypeI32()); // offset
    sigParams.push(new ValTypeI32()); // length
    let sigReturns = new GrowableArray<ValType>();
    sigReturns.push(stringType);

    let sig = this.getSignature(sigParams, sigReturns);
    let helperFunc = new WasmFunction(sig, null, model);
    helperFunc.name = "string_from_shared";
    this.addFunction(helperFunc);
    this.stringFromSharedFunc = helperFunc;

    let getSigParams = new GrowableArray<ValType>();
    getSigParams.push(new ValTypeI32()); // id
    let getSigReturns = new GrowableArray<ValType>();
    let nonNullableStringType = new ValTypeRef(stringStruct);
    getSigReturns.push(nonNullableStringType);

    let getSig = this.getSignature(getSigParams, getSigReturns);
    let getHelperFunc = new WasmFunction(getSig, null, model);
    getHelperFunc.name = "get_string_literal";
    this.addFunction(getHelperFunc);
    this.getStringLiteralFunc = getHelperFunc;
  }

  ensureHashInfra(model: SemanticModel): void {
    if (this.stringHashFunc != null) {
      return;
    }
    var stringStruct: WasmStruct | null = null;
    for (let pair in this.classInfos) {
      let info = pair.value;
      let s = info.structType;
      let name = s.name;
      if (name != null && name == "String") {
        stringStruct = s;
      }
    }
    if (stringStruct == null) {
      throw new Error("$stringHash discovery: String class struct not found!");
    }
    let params = new GrowableArray<ValType>();
    params.push(new ValTypeRefNull(stringStruct));
    let returns = new GrowableArray<ValType>();
    returns.push(new ValTypeI32());
    let sig = this.getSignature(params, returns);
    let hashFunc = new WasmFunction(sig, null, model);
    hashFunc.name = "$stringHash";
    this.addFunction(hashFunc);
    this.stringHashFunc = hashFunc;
  }

  

  /**
   * Locks in the module layout, assigning final WebAssembly indices (i32)
   * to all types, functions, and globals. Must be called after all
   * discoveries are made, but before the emission passes begin.
   */
  layout(): void {
    // console.log("wasm.layout() called! types count = " + i32ToString(this.types.length));
    this.isLayoutLocked = true;
    
    this.classMethodMap.clear();
    this.classMethods.clear();
    this.functionAdaptations.clear();
    this.arrayMethods = new GrowableArray<WasmFunction>();
    for (let func in this.functions) {
      let {classType} = func;
      if (classType != null && func.methodName != null) {
        let key = getClassMethodKey(getClassKey(classType), func.methodName as String);
        this.classMethodMap[key] = func;
        let cKey = getClassKey(classType) as String;
        if (!this.classMethods.has(cKey)) {
          this.classMethods[cKey] = new GrowableArray<WasmFunction>();
        }
        this.classMethods[cKey].push(func);
      }
      if (func.isFunctionAdaptation && func.functionAdaptationSource != null && func.functionAdaptationTarget != null) {
        let key = getFunctionAdaptationKey(func.functionAdaptationSource as Type, func.functionAdaptationTarget as Type);
        this.functionAdaptations[key] = func;
      }
      if (func.classType != null) {
        let className = (func.classType as ClassType).name;
        if (className == "FixedArray" || className == "ImmutableArray") {
          this.arrayMethods.push(func);
        }
      }
    }
    
    // Minimal recursion groups: one rec group per strongly-connected
    // component of the type-reference graph (fields, array elements,
    // signature params/results, supertypes), in dependency order —
    // Tarjan pops a component only after every component it references,
    // so cross-group references always point to an earlier group, and
    // only intra-group references point forward. Wasm-gc canonicalizes
    // structural identity per GROUP, so the one-big-group layout this
    // replaces made every type's cross-module identity depend on every
    // other type in the module. In practice almost every component is
    // a singleton (99% in the compiler's own module; the largest
    // genuine cycle is 8 types), and a singleton emits with no group
    // header — a self-reference included, since the bare form IS a
    // one-member rec group.
    let uniqueTypes = new GrowableArray<WasmType>();
    let seenTypes = new HashSet<WasmType>();
    // `types` can contain duplicate entries (the generator/async split
    // passes push types the reachability pass already emitted).
    for (let t in this.types) {
      if (!seenTypes.has(t)) {
        seenTypes.add(t);
        uniqueTypes.push(t);
      }
    }
    let typeCount = uniqueTypes.length;
    let posOf = new HashMap<WasmType, i32>();
    for (var i = 0; i < typeCount; i += 1) {
      posOf[uniqueTypes[i]] = i;
    }
    let adjacency = new GrowableArray<GrowableArray<i32>>();
    let pushRef = (list: GrowableArray<i32>, vt: ValType): void => {
      match (vt) {
        case ValTypeRef {target}: {
          if (let (true, p) = posOf.get(target)) { list.push(p); }
        }
        case ValTypeRefNull {target}: {
          if (let (true, p) = posOf.get(target)) { list.push(p); }
        }
        case _: {}
      }
    };
    for (var i = 0; i < typeCount; i += 1) {
      let t = uniqueTypes[i];
      let list = new GrowableArray<i32>();
      if (t is WasmStruct) {
        if (t.superStruct != null) {
          if (let (true, p) = posOf.get(t.superStruct as WasmStruct)) {
            list.push(p);
          }
        }
        for (let f in t.fields) { pushRef(list, f.type); }
      } else if (t is WasmArray) {
        pushRef(list, t.elementType);
      } else if (t is WasmSignature) {
        for (let pv in t.params) { pushRef(list, pv); }
        for (let rv in t.returns) { pushRef(list, rv); }
      }
      adjacency.push(list);
    }

    // Iterative Tarjan. Deterministic: roots in first-seen order,
    // edges in declaration order — the fixpoint gate depends on it.
    let sccOf = new GrowableArray<i32>();
    let lowLink = new GrowableArray<i32>();
    let onStack = new GrowableArray<boolean>();
    for (var i = 0; i < typeCount; i += 1) {
      sccOf.push(-1);
      lowLink.push(0);
      onStack.push(false);
    }
    let componentStack = new GrowableArray<i32>();
    let componentMembers = new GrowableArray<GrowableArray<i32>>();
    var nextDiscovery = 0;
    let workNode = new GrowableArray<i32>();
    let workEdge = new GrowableArray<i32>();
    for (var root = 0; root < typeCount; root += 1) {
      if (sccOf[root] != -1) { continue; }
      workNode.push(root);
      workEdge.push(0);
      while (workNode.length > 0) {
        let v = workNode[workNode.length - 1];
        let ei = workEdge[workEdge.length - 1];
        if (ei == 0) {
          sccOf[v] = nextDiscovery;
          lowLink[v] = nextDiscovery;
          nextDiscovery += 1;
          componentStack.push(v);
          onStack[v] = true;
        }
        let edges = adjacency[v];
        var descended = false;
        var e = ei;
        while (e < edges.length) {
          let w = edges[e];
          if (sccOf[w] == -1) {
            workEdge[workEdge.length - 1] = e + 1;
            workNode.push(w);
            workEdge.push(0);
            descended = true;
            break;
          }
          if (onStack[w] && sccOf[w] < lowLink[v]) {
            lowLink[v] = sccOf[w];
          }
          e += 1;
        }
        if (descended) { continue; }
        if (lowLink[v] == sccOf[v]) {
          let members = new GrowableArray<i32>();
          while (true) {
            let w = componentStack.pop();
            onStack[w] = false;
            members.push(w);
            if (w == v) { break; }
          }
          componentMembers.push(members);
        }
        let ignoredNode = workNode.pop();
        let ignoredEdge = workEdge.pop();
        if (workNode.length > 0) {
          let parent = workNode[workNode.length - 1];
          if (lowLink[v] < lowLink[parent]) {
            lowLink[parent] = lowLink[v];
          }
        }
      }
    }

    // Canonically-identical groups MERGE into one rec group. Wasm-gc
    // type identity is structural per group: two singleton groups of
    // the same shape are THE SAME type, so structurally-identical
    // nominal classes (same fields, same super — sealed variants with
    // one payload; every slot-pruned empty vtable struct) would
    // collapse, and `is`/`as`/match would stop telling them apart —
    // position IN a shared group is the only brand the format offers.
    // A group's key encodes its emitted shape with external references
    // by (merged-group id, member index); groups arrive in dependency
    // order, so by induction two same-keyed groups have the SAME
    // merged dependencies, all of which precede the first twin — which
    // makes appending later twins to the first one's group always
    // order-valid.
    let groupOfType = new GrowableArray<i32>();
    let memberIndexOfType = new GrowableArray<i32>();
    for (var i = 0; i < typeCount; i += 1) {
      groupOfType.push(-1);
      memberIndexOfType.push(-1);
    }
    let mergedMembers = new GrowableArray<GrowableArray<i32>>();
    let groupByKey = new HashMap<String, i32>();
    for (let members in componentMembers) {
      // Ascending first-seen order inside a group: deterministic, and
      // independent of DFS pop order.
      var mi = 1;
      while (mi < members.length) {
        let mkey = members[mi];
        var mj = mi - 1;
        while (mj >= 0 && members[mj] > mkey) {
          members[mj + 1] = members[mj];
          mj -= 1;
        }
        members[mj + 1] = mkey;
        mi += 1;
      }
      let intraIndex = new HashMap<i32, i32>();
      for (var i = 0; i < members.length; i += 1) {
        intraIndex[members[i]] = i;
      }
      let parts = new GrowableArray<String>();
      let encodeTarget = (target: WasmType): void => {
        if (let (true, tp) = posOf.get(target)) {
          if (let (true, ii) = intraIndex.get(tp)) {
            parts.push("#");
            parts.push(i32ToString(ii));
            return;
          }
          parts.push("@");
          parts.push(i32ToString(groupOfType[tp]));
          parts.push(".");
          parts.push(i32ToString(memberIndexOfType[tp]));
          return;
        }
        // A reference to a type outside the layout would already be a
        // broken module; keep the key honest anyway.
        parts.push("?");
      };
      let encodeVal = (vt: ValType): void => {
        match (vt) {
          case ValTypeRef {target}: {
            parts.push("r");
            encodeTarget(target);
          }
          case ValTypeRefNull {target}: {
            parts.push("n");
            encodeTarget(target);
          }
          case _: {
            parts.push(i32ToString(valTypeToOpcode(vt)));
          }
        }
        parts.push(",");
      };
      for (let m in members) {
        let t = uniqueTypes[m];
        if (t is WasmStruct) {
          parts.push("S");
          if (t.superStruct != null) {
            encodeTarget(t.superStruct as WasmStruct);
          }
          parts.push("[");
          for (let f in t.fields) {
            encodeVal(f.type);
            parts.push(if (f.isMutable) "m" else "c");
          }
          parts.push("]");
        } else if (t is WasmArray) {
          parts.push("A");
          encodeVal(t.elementType);
          parts.push(if (t.isMutable) "m" else "c");
        } else if (t is WasmSignature) {
          parts.push("F");
          for (let pv in t.params) {
            encodeVal(pv);
          }
          parts.push(">");
          for (let rv in t.returns) {
            encodeVal(rv);
          }
        }
        parts.push(";");
      }
      let keyParts = new FixedArray<String>(parts.length, "");
      for (var pi = 0; pi < parts.length; pi += 1) {
        keyParts[pi] = parts[pi];
      }
      let key = String.fromParts(keyParts as array<String>);
      var g = -1;
      if (let (true, existing) = groupByKey.get(key)) {
        g = existing;
      } else {
        g = mergedMembers.length;
        mergedMembers.push(new GrowableArray<i32>());
        groupByKey[key] = g;
      }
      let bucket = mergedMembers[g];
      for (let m in members) {
        groupOfType[m] = g;
        memberIndexOfType[m] = bucket.length;
        bucket.push(m);
      }
    }

    let orderedTypes = new GrowableArray<WasmType>();
    let groupSizes = new GrowableArray<i32>();
    for (let bucket in mergedMembers) {
      for (let m in bucket) {
        orderedTypes.push(uniqueTypes[m]);
      }
      groupSizes.push(bucket.length);
    }
    this.types = orderedTypes;
    this.typeRecGroupSizes = groupSizes;

    for (var i = 0; i < this.types.length; i += 1) {
      this.types[i].index = i;
    }
    for (let rd in this.recordDispatchInfos) {
    }
    for (var i = 0; i < this.tags.length; i += 1) {
      let t = this.tags[i];
      t.index = i;
    }
    var functionIndex = 0;
    for (var i = 0; i < this.functionImports.length; i += 1) {
      let f = this.functionImports[i];
      f.index = functionIndex;
      functionIndex += 1;
    }
    for (var i = 0; i < this.functions.length; i += 1) {
      let f = this.functions[i];
      f.index = functionIndex;
      functionIndex += 1;
    }
    for (var i = 0; i < this.globals.length; i += 1) {
      let g = this.globals[i];
      g.index = i;
    }
  }
}
