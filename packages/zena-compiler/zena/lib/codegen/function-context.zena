import { SymbolId } from '../scope/symbol.zena';
import { ValType, ValTypeRefNull, WasmType, ValTypeI32 } from './wasm.zena';
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { WasmEmitter } from './wasm-emitter.zena';
import { WasmFunction, WasmModule } from './wasm-module.zena';
import { ClassType } from '../types.zena';

export final class FunctionContext {
  wasm: WasmModule;
  emitter: WasmEmitter;
  wasmFunction: WasmFunction;
  localIndices = new HashMap<SymbolId, i32>();
  localTypes = new Array<ValType>();
  localConcreteClassTypes = new HashMap<SymbolId, ClassType>();
  var isReachable: boolean = true;
  var needsUnreachable: boolean = false;
  var thisLocalIndex: i32 = -1;
  var optShortCircuitedLocal: i32 = -1;
  var ignoreCasts: boolean = false;
  
  structScratchLocals = new HashMap<i32, i32>();

  /// Stack of active loops for break/continue targets.
  /// Tuple holds: (breakDepth: i32, continueDepth: i32)
  loopStack = new Array<(i32, i32)>();

  /// Stack of active pipeline value local indices.
  pipelineLocalStack = new Array<i32>();

  new(this.wasm, this.emitter, this.wasmFunction);

  isCelled(symId: SymbolId): boolean {
    return this.wasm.mutableCapturedSymbols.has(symId);
  }

  allocLocal(type: ValType): i32 {
    let index = this.wasmFunction.signature.params.length + this.localTypes.length;
    this.localTypes.push(type);
    return index;
  }

  getStructScratchLocal(target: WasmType): i32 {
    let structIndex = target.index;
    if (this.structScratchLocals.has(structIndex)) {
      return this.structScratchLocals[structIndex];
    }
    let index = this.allocLocal(new ValTypeRefNull(target));
    this.structScratchLocals[structIndex] = index;
    return index;
  }

  enterLoop(): void {
    // For while loops: break=1 (br to outer block), continue=0 (br to loop)
    this.loopStack.push((1, 0));
  }

  enterForLoop(): void {
    // For for loops: break=2 (br to outer block), continue=0 (br to inner block where update happens)
    this.loopStack.push((2, 0));
  }

  exitLoop(): void {
    this.loopStack.pop();
  }

  enterBlockStructure(): void {
    var i = 0;
    while (i < this.loopStack.length) {
      let (b, c) = this.loopStack[i];
      this.loopStack[i] = (b + 1, c + 1);
      i += 1;
    }
  }

  exitBlockStructure(): void {
    var i = 0;
    while (i < this.loopStack.length) {
      let (b, c) = this.loopStack[i];
      this.loopStack[i] = (b - 1, c - 1);
      i += 1;
    }
  }

  /**
   * Lazily allocates and returns a WebAssembly local variable used to track
   * whether the most recent optional chaining operation short-circuited (evaluated to null).
   *
   * This is a boolean flag (represented as an i32) that is set to:
   * - 0 if the optional receiver/callee was not null,
   * - 1 if the optional receiver/callee was null.
   *
   * It allows null-coalescing (`??`) and null comparisons on primitive Wasm types
   * (which have no boxing support yet) to correctly determine if they evaluated to null.
   */
  getOptShortCircuitedLocal(): i32 {
    if (this.optShortCircuitedLocal != -1) {
      return this.optShortCircuitedLocal;
    }
    this.optShortCircuitedLocal = this.allocLocal(new ValTypeI32());
    return this.optShortCircuitedLocal;
  }

  pushPipelineLocal(localIndex: i32): void {
    this.pipelineLocalStack.push(localIndex);
  }

  popPipelineLocal(): void {
    this.pipelineLocalStack.pop();
  }

  getPipelineLocal(): i32 {
    if (this.pipelineLocalStack.length == 0) {
      return -1;
    }
    return this.pipelineLocalStack[this.pipelineLocalStack.length - 1];
  }
}
