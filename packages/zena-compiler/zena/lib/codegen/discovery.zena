import { Program, CompilationUnit } from '../program.zena';
import { walkEnter } from '../visitor.zena';
import { WasmModule, WasmFunction, WasmSignature, WasmGlobal, WasmStruct, WasmField, WasmArray, VTableInit, StringLiteralLocation, ClassCodegenInfo } from './wasm-module.zena';
import { SemanticModel, ClosureDependency, FunctionAdaptationDependency, SymbolDependencies, InterfaceAdaptation } from '../semantic-model.zena';
import { Type, ClassType, InterfaceType, FunctionType, TypeParameterType, RecordType, UnionType, TupleType, InlineTupleType, TypeAliasType, ArrayType, ByteArrayType, FieldInfo, MethodInfo, BooleanType, I32Type, VoidType, AnyType, instantiateClassType, instantiateInterfaceType, typeToString, MixinType, ThisType } from '../types.zena';
import { Node, ClassDeclaration, InterfaceDeclaration, MixinDeclaration, EnumDeclaration, MethodDefinition, AccessorDeclaration, FieldDefinition, VariableDeclaration, DeclareFunction, ImportDeclaration, ExportAllDeclaration, ExportFromDeclaration, IdentifierPattern, FunctionExpression, Pattern, Identifier, SuperInitializer, BlockStatement, Statement, Decorator, StringLiteral, SourceLocation, SymbolPropertyName, MemberExpression, TypeParameter, Module, Expression, ImportSpecifier, CallExpression, SealedVariant, TaggedTemplateExpression, TemplateElement, TypeAnnotation, NewExpression, ForInStatement, IndexExpression, AssignmentExpression, RangeExpression, ThrowExpression, TryExpression } from '../ast.zena';
import { HashMap } from 'zena:map';
import { HashSet } from 'zena:set';
import { Array } from 'zena:array';
import { String } from 'zena:string';
import { StringBuilder } from 'zena:string-builder';
import { parseI32, i32ToString } from 'zena:string-convert';
import { getClassKey, getInterfaceKey, getClassMethodKey, getInterfaceMemberKey, getClassInterfaceKey, getClassInterfaceVTableName, getClassVTableName, getClassSingletonName, getInterfaceTrampolineName, getSignatureKey, matchOverload, collectMixinMembers, getMemberRootClass, isConcrete, getClassPrivateFieldKey, MixinKey, InterfaceKey, ExportKey, ExportGlobalKey, getTypeUniqueKey, ClassKey, FunctionAdaptationKey, getFunctionAdaptationKey, getClosureSpecializationKey, getSpecializedFunctionKey, getFunctionValueWrapperKey, findMixinDeclaration, getMixinKeyFromSymbol } from './codegen-utils.zena';
import { typeToValType, getClosureStruct, getInterfaceMemberSignature, mapReturnTypeToWasmResults, substituteTypeParamsInCodegen, getClassTypeParameters, getInterfaceTypeParameters, getCellStruct } from './type-mapping.zena';
import { collectValueExports } from './function-generator.zena';
import { dirName, normalizePath } from '../module-resolver.zena';
import { Symbol, SymbolId } from '../scope/symbol.zena';
import { ValType, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeRefNull, ValTypeRef, ValTypeStructRef, ValTypeAnyRef, ValTypeFuncRef, ValTypeExternRef, ValTypeEqRef, WasmType } from './wasm.zena';
import { console } from 'zena:console';

let eraseType = (t: Type): Type => {
  return match (t) {
    case TypeParameterType: new AnyType()
    case FunctionType as ft: {
      let params = new Array<Type>();
      for (let p in ft.parameters) {
        params.push(eraseType(p));
      }
      let ret = new FunctionType(params, ft.parameterNames, eraseType(ft.returnType));
      if (ft.typeParameters != null) {
        ret.typeParameters = ft.typeParameters;
      }
      ret
    }
    case ClassType as ct: {
      if (ct.typeArguments != null) {
        let args = new Array<Type>();
        for (let arg in (ct.typeArguments as Array<Type>)) {
          args.push(eraseType(arg));
        }
        instantiateClassType(ct.genericSource ?? ct, args)
      } else {
        ct
      }
    }
    case InterfaceType as it: {
      if (it.typeArguments != null) {
        let args = new Array<Type>();
        for (let arg in (it.typeArguments as Array<Type>)) {
          args.push(eraseType(arg));
        }
        instantiateInterfaceType(it.genericSource ?? it, args)
      } else {
        it
      }
    }
    case ArrayType as at: {
      new ArrayType(eraseType(at.elementType))
    }
    case TupleType as tt: {
      let types = new Array<Type>();
      for (let type in tt.elementTypes) {
        types.push(eraseType(type));
      }
      new TupleType(types)
    }
    case InlineTupleType as itt: {
      let types = new Array<Type>();
      for (let type in itt.elementTypes) {
        types.push(eraseType(type));
      }
      new InlineTupleType(types)
    }
    case UnionType as ut: {
      let types = new Array<Type>();
      for (let type in ut.types) {
        types.push(eraseType(type));
      }
      new UnionType(types)
    }
    case RecordType as rt: {
      let props = new HashMap<String, Type>();
      let keys = rt.properties.keys();
      while (let (true, key) = keys.next()) {
        props[key] = eraseType(rt.properties[key]);
      }
      new RecordType(props, rt.optionalProperties)
    }
    case _: t
  };
};

class Referrer {
  isSymbol: boolean;
  symId: SymbolId;
  nodeId: i32;
  model: SemanticModel;
  classType: ClassType | null;
  isReachable: boolean;

  new(this.isSymbol, this.symId, this.nodeId, this.model, this.classType = null, this.isReachable = true);
}

class ClassInterfacePair {
  classType: ClassType;
  interfaceType: InterfaceType;
  new(this.classType, this.interfaceType);
}

class ParsedMethodRef {
  classSymId: SymbolId;
  mName: String;
  new(this.classSymId, this.mName);
}

class ParsedInterfaceMemberRef {
  ifaceSymId: SymbolId;
  mName: String;
  new(this.ifaceSymId, this.mName);
}

export final class Discovery {
  program: Program;
  wasm: WasmModule;
  target: String;

  // Global lookups
  classDecls = new HashMap<SymbolId, Node>();
  classModels = new HashMap<SymbolId, SemanticModel>();
  interfaceDecls = new HashMap<SymbolId, InterfaceDeclaration>();
  interfaceModels = new HashMap<SymbolId, SemanticModel>();
  
  symbolIdToModel = new HashMap<SymbolId, SemanticModel>();
  symbolIdToDecl = new HashMap<SymbolId, Node>();
  symbolIdToTargetId = new HashMap<SymbolId, SymbolId>();

  nodeIdToNode = new HashMap<i32, Node>();
  nodeIdToModel = new HashMap<i32, SemanticModel>();
  
  // RTA Reachability tracking state
  reachedGlobals = new HashSet<SymbolId>();
  reachedMembers = new HashSet<i32>();
  instantiatedClasses = new HashSet<SymbolId>();
  instantiatedSpecializedClasses = new HashSet<String>();
  var isRtaActive = true;
  referencedInterfaceMembers = new HashSet<String>();
  referencedReachableInterfaceMembers = new HashSet<String>();
  discoveredTypes = new HashSet<String>();
  specializedInterfaces = new Array<InterfaceType>();
  specializedClassTypes = new HashMap<SymbolId, Array<ClassType>>();
  reachedClassMembers = new HashMap<SymbolId, HashSet<i32>>();
  reachedReachableClassMembers = new HashMap<SymbolId, HashSet<i32>>();

  // Tracks for interface dispatches: which instantiated classes implement an interface
  instantiatedClassesByInterface = new HashMap<SymbolId, Array<ClassInterfacePair>>();
  referencedInterfaceMembersById = new HashMap<SymbolId, Array<String>>();

  var mixinToClasses = new HashMap<MixinKey, Array<ClassType>>();
  #subclassCache = new HashMap<SymbolId, Array<ClassType>>();
  var lastSubclassCacheVersion = -1;
  #classDeclTypeCache = new HashMap<i32, ClassType>();
  #parsedClassMethodRefs = new HashMap<String, ParsedMethodRef>();
  #parsedInterfaceMemberRefs = new HashMap<String, ParsedInterfaceMemberRef>();
  #implementingMethodCache = new HashMap<String, MethodDefinition>();
  #implementingMethodNulls = new HashSet<String>();
  #implementingMethodsCache = new HashMap<String, Array<MethodDefinition>>();
  #implementingFieldCache = new HashMap<String, FieldDefinition>();
  #implementingFieldNulls = new HashSet<String>();
  #implementingAccessorCache = new HashMap<String, AccessorDeclaration>();
  #implementingAccessorNulls = new HashSet<String>();
  #subclassRelationCache = new HashMap<String, boolean>();

  #reachableQueue = new Array<Referrer>();
  #checkableQueue = new Array<Referrer>();
  #visited = new HashSet<String>();
  #reached = new HashSet<String>();

  reachedFunctionsSet = new HashSet<WasmFunction>();
  reachedTypesSet = new HashSet<WasmType>();
  emittedTypes = new Array<WasmType>();

  var currentReachable = true;

  new(this.program, this.wasm, this.target = "zena-cli");

  recordReachedClassMember(classSymId: SymbolId, nodeId: i32, model: SemanticModel, isReachable: boolean): void {
    if (isReachable) {
      if (!this.reachedReachableClassMembers.has(classSymId)) {
        this.reachedReachableClassMembers[classSymId] = new HashSet<i32>();
      }
      let set = this.reachedReachableClassMembers[classSymId];
      if (!set.has(nodeId)) {
        set.add(nodeId);
        if (let (true, specList) = this.specializedClassTypes.get(classSymId)) {
          for (let specCt in specList) {
            this.queueReferrer(new Referrer(false, -1 as SymbolId, nodeId, model, specCt, true));
          }
        }
      }
    } else {
      if (!this.reachedClassMembers.has(classSymId)) {
        this.reachedClassMembers[classSymId] = new HashSet<i32>();
      }
      let set = this.reachedClassMembers[classSymId];
      if (!set.has(nodeId)) {
        set.add(nodeId);
        if (let (true, specList) = this.specializedClassTypes.get(classSymId)) {
          for (let specCt in specList) {
            this.queueReferrer(new Referrer(false, -1 as SymbolId, nodeId, model, specCt, false));
          }
        }
      }
    }
  }

  queueReferrer(ref: Referrer): void {
    let suffix = if (ref.classType != null) "@" + (getClassKey(ref.classType as ClassType) as String) else "";
    let key = (if (ref.isSymbol) "sym:" + i32ToString(ref.symId as i32) else "node:" + i32ToString(ref.nodeId)) + suffix;
    
    if (ref.isReachable) {
      if (!this.#reached.has(key)) {
        this.#reached.add(key);
        this.#visited.add(key);
        this.#reachableQueue.push(ref);
        if (!ref.isSymbol && ref.classType != null) {
          let ct = ref.classType as ClassType;
          let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
          this.recordReachedClassMember(lookupId, ref.nodeId, ref.model, true);
        }
      }
    } else {
      if (!this.#visited.has(key)) {
        this.#visited.add(key);
        this.#checkableQueue.push(ref);
        if (!ref.isSymbol && ref.classType != null) {
          let ct = ref.classType as ClassType;
          let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
          this.recordReachedClassMember(lookupId, ref.nodeId, ref.model, false);
        }
      }
    }
  }

  markFunctionReached(func: WasmFunction): void {
    if (this.currentReachable) {
      if (!this.reachedFunctionsSet.has(func)) {
        this.reachedFunctionsSet.add(func);
        func.isReached = true;
        this.markTypeReached(func.signature);
        if (func.node != null) {
          this.queueReferrer(new Referrer(
            false,
            -1 as SymbolId,
            (func.node as Node).id as i32,
            func.model,
            func.classType,
            this.currentReachable
          ));
        }
      }
    }
  }

  markTypeReached(t: WasmType | null): void {
    if (t == null) { return; }
    if (this.currentReachable) {
      if (!this.reachedTypesSet.has(t)) {
        this.reachedTypesSet.add(t);
        this.emittedTypes.push(t);
      }
    }
  }

  markValTypeReached(vt: ValType): void {
    if (vt is ValTypeRefNull) {
      this.markTypeReached((vt as ValTypeRefNull).target);
    } else if (vt is ValTypeRef) {
      this.markTypeReached((vt as ValTypeRef).target);
    }
  }

  closeReachedTypes(): void {
    this.currentReachable = true;
    var head = 0;
    while (head < this.emittedTypes.length) {
      let t = this.emittedTypes[head];
      head += 1;
      
      if (t is WasmStruct) {
        let st = t as WasmStruct;
        for (let f in st.fields) {
          this.markValTypeReached(f.type);
        }
      } else if (t is WasmArray) {
        let arr = t as WasmArray;
        this.markValTypeReached(arr.elementType);
      } else if (t is WasmSignature) {
        let sig = t as WasmSignature;
        for (let p in sig.params) {
          this.markValTypeReached(p);
        }
        for (let r in sig.returns) {
          this.markValTypeReached(r);
        }
      }
    }
  }

  run(): void {
    // Pass 0: Register empty structs for all declared classes & interfaces to prevent cyclic dependencies
    for (let unit in this.program.units) {
      let model = unit.model;
      walkEnter(unit.ast, (n: Node) => {
        this.nodeIdToNode[n.id as i32] = n;
        this.nodeIdToModel[n.id as i32] = model;
        let sym = model.resolve(n);
        if (sym != null) {
          this.symbolIdToTargetId[sym.id] = sym.resolveTarget().id;
        }
      });
      
      // Classes
      let classKeys = model.classDeclarations.keys();
      while (let (true, id) = classKeys.next()) {
        let classDecl = model.classDeclarations[id];
        this.classDecls[id] = classDecl;
        this.classModels[id] = model;
        this.symbolIdToModel[id] = model;
        this.symbolIdToDecl[id] = classDecl;

        let rawClassType = this.getClassDeclType(classDecl, model);
        if (rawClassType != null) {
          let classType = rawClassType as ClassType;
          let cId = if (classType.genericSource != null) (classType.genericSource as ClassType).id else classType.id;
          this.classDecls[cId as SymbolId] = classDecl;
          this.classModels[cId as SymbolId] = model;
          this.symbolIdToModel[cId as SymbolId] = model;
          this.symbolIdToDecl[cId as SymbolId] = classDecl;

          if (classType.name == "String" && classType.sourcePath == "zena:string") {
            this.wasm.stringClass = classType;
          } else if (classType.name == "TemplateStringsArray" && classType.sourcePath == "zena:template-strings-array") {
            this.wasm.templateStringsArrayClass = classType;
          } else if (classType.name == "Box" && classType.sourcePath == "zena:box") {
            this.wasm.boxClass = classType;
          }
          let cKey = getClassKey(classType);
          if (!this.wasm.classInfos.has(cKey)) {
            let emptyStruct = new WasmStruct(classType.name, new Array<WasmField>());
            emptyStruct.classType = classType;
            this.wasm.types.push(emptyStruct);
            let info = new ClassCodegenInfo(emptyStruct);
            this.wasm.classInfos[cKey] = info;
            
            let emptyVTableStruct = new WasmStruct(classType.name + "_VTable", new Array<WasmField>());
            emptyVTableStruct.classType = classType;
            this.wasm.types.push(emptyVTableStruct);
            info.vtableStructType = emptyVTableStruct;
          }
        }
        
        if (classDecl.isSealed && classDecl.sealedVariants != null) {
          let variants = classDecl.sealedVariants as Array<SealedVariant>;
          for (let variant in variants) {
            let variantSym = model.resolve(variant);
            if (variantSym != null) {
              let vId = variantSym.id;
              this.classDecls[vId] = variant;
              this.classModels[vId] = model;
              this.symbolIdToModel[vId] = model;
              this.symbolIdToDecl[vId] = variant;

              let rawVariantType = model.getNodeType(variant);
              if (rawVariantType != null && rawVariantType is ClassType) {
                let variantType = rawVariantType as ClassType;
                let vKey = getClassKey(variantType);
                if (!this.wasm.classInfos.has(vKey)) {
                  let emptyStruct = new WasmStruct(variantType.name, new Array<WasmField>());
                  emptyStruct.classType = variantType;
                  this.wasm.types.push(emptyStruct);
                  let info = new ClassCodegenInfo(emptyStruct);
                  this.wasm.classInfos[vKey] = info;
                  
                  let emptyVTableStruct = new WasmStruct(variantType.name + "_VTable", new Array<WasmField>());
                  emptyVTableStruct.classType = variantType;
                  this.wasm.types.push(emptyVTableStruct);
                  info.vtableStructType = emptyVTableStruct;
                }
              }
            }
          }
        }
      }

      // Interfaces
      let interfaceKeys = model.interfaceDeclarations.keys();
      while (let (true, id) = interfaceKeys.next()) {
        let ifaceDecl = model.interfaceDeclarations[id];
        this.interfaceDecls[id] = ifaceDecl;
        this.interfaceModels[id] = model;
        this.symbolIdToModel[id] = model;
        this.symbolIdToDecl[id] = ifaceDecl;

        let ifaceType = model.getNodeType(ifaceDecl) as InterfaceType;
        let itId = if (ifaceType.genericSource != null) (ifaceType.genericSource as InterfaceType).id else ifaceType.id;
        this.interfaceDecls[itId as SymbolId] = ifaceDecl;
        this.interfaceModels[itId as SymbolId] = model;

        let iKey = getInterfaceKey(ifaceType);
        if (!this.wasm.interfaceStructs.has(iKey)) {
          let emptyVTableStruct = new WasmStruct(ifaceType.name + "_VTable", new Array<WasmField>());
          this.wasm.types.push(emptyVTableStruct);
          this.wasm.interfaceVTableStructs[iKey] = emptyVTableStruct;

          let fatPtrFields = new Array<WasmField>();
          fatPtrFields.push(new WasmField("instance", new ValTypeAnyRef(), false));
          fatPtrFields.push(new WasmField("vtable", new ValTypeRef(emptyVTableStruct), false));
          let emptyStruct = new WasmStruct(ifaceType.name + "_FatPtr", fatPtrFields);
          this.wasm.types.push(emptyStruct);
          this.wasm.interfaceStructs[iKey] = emptyStruct;
        }
      }

      // Mixins
      let mixinKeys = model.mixinDeclarations.keys();
      while (let (true, id) = mixinKeys.next()) {
        this.symbolIdToModel[id] = model;
        this.symbolIdToDecl[id] = model.mixinDeclarations[id];
      }

      // Enums
      let enumKeys = model.enumDeclarations.keys();
      while (let (true, id) = enumKeys.next()) {
        this.symbolIdToModel[id] = model;
        this.symbolIdToDecl[id] = model.enumDeclarations[id];
      }

      // Globals
      let globalKeys = model.globalDeclarations.keys();
      while (let (true, id) = globalKeys.next()) {
        this.symbolIdToModel[id] = model;
        this.symbolIdToDecl[id] = model.globalDeclarations[id];
        
        let decl = model.globalDeclarations[id];
        if (decl is VariableDeclaration) {
          let varDecl = decl as VariableDeclaration;
          let initNode = varDecl.init;
          if (initNode != null && initNode is FunctionExpression) {
            let funcExpr = initNode as FunctionExpression;
            let funcTypeNode = model.getNodeType(funcExpr);
            if (funcTypeNode is FunctionType) {
              let fType = funcTypeNode as FunctionType;
              let hasParams = fType.typeParameters != null;
              let len = if (fType.typeParameters != null) (fType.typeParameters as Array<TypeParameterType>).length else 0;
              if (hasParams && len > 0) {
                this.wasm.genericFunctions[id] = funcExpr;
                this.wasm.genericFunctionModels[id] = model;
              }
            }
          }
        }
      }
    }

    // Ensure exception and string helper infrastructures are initialized before discovery analysis
    let exceptionFound = new Array<boolean>();
    for (let u in this.program.units) {
      walkEnter(u.ast, (n: Node) => {
        if (n is ThrowExpression) {
          exceptionFound.push(true);
        } else if (n is TryExpression) {
          exceptionFound.push(true);
        }
      });
    }
    let hasExceptions = exceptionFound.length > 0;
    if (hasExceptions) {
      this.wasm.ensureExceptionInfra(this.program.units[0].model);
    }
    if (this.wasm.stringClass != null) {
      this.wasm.ensureStringHelpers(this.program.units[0].model);
      this.markFunctionReached(this.wasm.stringCreateFunc as WasmFunction);
      this.markFunctionReached(this.wasm.stringSetByteFunc as WasmFunction);
      this.markFunctionReached(this.wasm.stringGetByteFunc as WasmFunction);
      this.markFunctionReached(this.wasm.stringGetLengthFunc as WasmFunction);
    }

    // Populate mixinToClasses mapping
    this.mixinToClasses = new HashMap<MixinKey, Array<ClassType>>();
    for (let unit in this.program.units) {
      let model = unit.model;
      let classKeys = model.classDeclarations.keys();
      while (let (true, id) = classKeys.next()) {
        let classDecl = model.classDeclarations[id];
        let rawClassType = this.getClassDeclType(classDecl, model);
        if (rawClassType != null) {
          let classType = rawClassType as ClassType;
          let mixinMembers = new Array<Node>();
          let seenMixins = new HashMap<MixinKey, boolean>();
          collectMixinMembers(this.program, model, classDecl.mixins, mixinMembers, seenMixins);
          let mKeys = seenMixins.keys();
          while (let (true, mixKey) = mKeys.next()) {
            if (!this.mixinToClasses.has(mixKey)) {
              this.mixinToClasses[mixKey] = new Array<ClassType>();
            }
            this.mixinToClasses[mixKey].push(classType);
          }
        }
      }
    }

    // Process all import declarations upfront for namespace objects and their closure trampolines
    for (let unit in this.program.units) {
      let mod = unit.ast;
      let model = unit.model;
      for (let stmt in mod.body) {
        if (stmt != null && stmt is ImportDeclaration) {
          this.discoverImportDeclaration(stmt as ImportDeclaration, model);
        }
      }
    }



    // RTA Roots
    for (let unit in this.program.units) {
      let model = unit.model;
      let gKeys = model.globalDeclarations.keys();
      while (let (true, id) = gKeys.next()) {
        let decl = model.globalDeclarations[id];
        var isExported = false;
        var isMain = false;
        
        if (decl is VariableDeclaration) {
          let vd = decl as VariableDeclaration;
          isExported = vd.exported;
          if (vd.pattern is IdentifierPattern && (vd.pattern as IdentifierPattern).name == "main") {
            isMain = true;
          }
        } else if (decl is DeclareFunction) {
          isExported = (decl as DeclareFunction).exported;
        }
        
        if (isMain || isExported) {
          this.queueReferrer(new Referrer(true, id, -1, model, null, true));
        } else {
          this.queueReferrer(new Referrer(true, id, -1, model, null, false));
        }
      }
    }

    if (this.wasm.stringClass != null) {
      let sClass = this.wasm.stringClass as ClassType;
      this.instantiateClassType(sClass, this.getClassModel(sClass));
    }
    if (this.wasm.templateStringsArrayClass != null) {
      let tsaClass = this.wasm.templateStringsArrayClass as ClassType;
      this.instantiateClassType(tsaClass, this.getClassModel(tsaClass));
    }

    // Main reachability queue traversal
    var reachHead = 0;
    var checkHead = 0;
    var lastInstantiatedCount = -1;
    while (this.instantiatedSpecializedClasses.size > lastInstantiatedCount) {
      lastInstantiatedCount = this.instantiatedSpecializedClasses.size;
      var progress = true;
      while (progress) {
      while (reachHead < this.#reachableQueue.length || checkHead < this.#checkableQueue.length) {
      var refItem: Referrer | null = null;
      if (reachHead < this.#reachableQueue.length) {
        refItem = this.#reachableQueue[reachHead];
        reachHead += 1;
      } else {
        refItem = this.#checkableQueue[checkHead];
        checkHead += 1;
      }
      let ref = refItem as Referrer;
      this.currentReachable = ref.isReachable;
      
      if (ref.isSymbol) {
        let symId = ref.symId;
        let model = ref.model;
        
        this.reachedGlobals.add(symId);
        
        if (model.globalDeclarations.has(symId)) {
          let decl = model.globalDeclarations[symId];
          let resolver = (t: Type): Type => t;
          this.discoverNodeTypes(decl, model, resolver);
          if (decl is VariableDeclaration) {
            this.discoverVariableDeclaration(symId, decl as VariableDeclaration, model);
          } else if (decl is DeclareFunction) {
            this.discoverDeclareFunction(decl as DeclareFunction, model);
          }
        }
        
        if (let (true, deps) = model.symbolDependencies.get(symId)) {
          this.traverseDependencies(deps, model, ref.classType);
        }
      } else {
        let nodeId = ref.nodeId;
        var model = ref.model;
        if (this.nodeIdToModel.has(nodeId)) {
          model = this.nodeIdToModel[nodeId];
        }
        
        this.reachedMembers.add(nodeId);
        if (this.nodeIdToNode.has(nodeId)) {
          let node = this.nodeIdToNode[nodeId];
          let classType = ref.classType;
          let ctParams = if (classType != null) getClassTypeParameters(classType as ClassType) else null as Array<TypeParameterType>;
          let ctArgs = if (classType != null) (classType as ClassType).typeArguments else null as Array<Type>;
          let resolver = (t: Type): Type => {
            if (classType != null && ctParams != null) {
              return substituteTypeParamsInCodegen(ctParams, ctArgs, t);
            }
            return t;
          };
          this.discoverNodeTypes(node, model, resolver);
          if (node is MethodDefinition && ref.classType != null) {
            let mDef = node as MethodDefinition;
            let ct = ref.classType as ClassType;
            let cKey = getClassKey(ct);
            let methName = getMethodName(mDef);
            let key = getClassMethodKey(cKey, methName);
            if (!this.wasm.classMethodMap.has(key)) {
              let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
              let cd: Node | null = if (this.classDecls.has(lookupId)) this.classDecls[lookupId] else null;
              this.registerClassMethod(ct, cd, methName, mDef, false, false, null, this.classModels[lookupId]);
            }
          } else if (node is AccessorDeclaration && ref.classType != null) {
            let acc = node as AccessorDeclaration;
            let ct = ref.classType as ClassType;
            let cKey = getClassKey(ct);
            let accName = match (acc.name) {
              case Identifier {name}: name
              case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                case Identifier {name}: name
                case MemberExpression {property}: property.name
                case _: "<symbol>"
              }
              case _: ""
            };
            if (accName != "") {
              let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
              let cd: Node | null = if (this.classDecls.has(lookupId)) this.classDecls[lookupId] else null;
              if (acc.getter != null) {
                let key = getClassMethodKey(cKey, "get#" + accName);
                if (!this.wasm.classMethodMap.has(key)) {
                  this.registerClassMethod(ct, cd, "get#" + accName, acc, false, false, null, this.classModels[lookupId]);
                }
              }
              if (acc.setter != null) {
                let key = getClassMethodKey(cKey, "set#" + accName);
                if (!this.wasm.classMethodMap.has(key)) {
                  this.registerClassMethod(ct, cd, "set#" + accName, acc.setter, false, false, null, this.classModels[lookupId]);
                }
              }
            }
          } else if (node is FieldDefinition && ref.classType != null) {
            let fd = node as FieldDefinition;
            let ct = ref.classType as ClassType;
            let cKey = getClassKey(ct);
            let propName = match (fd.name) {
              case Identifier {name}: name
              case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                case Identifier {name}: name
                case MemberExpression {property}: property.name
                case _: "<symbol>"
              }
              case _: ""
            };
            if (propName != "") {
              let getterKey = getClassMethodKey(cKey, "get#" + propName);
              if (let (true, f) = this.wasm.classMethodMap.get(getterKey)) {
                f.isReached = true;
              }
              let setterKey = getClassMethodKey(cKey, "set#" + propName);
              if (let (true, f) = this.wasm.classMethodMap.get(setterKey)) {
                f.isReached = true;
              }
            }
          }
        }
        
        if (let (true, deps) = model.nodeDependencies.get(nodeId)) {
          this.traverseDependencies(deps, model, ref.classType);
        }
      }
      }
      
      progress = false;
      this.currentReachable = true;
      for (let g in this.wasm.globals) {
        this.markValTypeReached(g.type);
        if (g.initVTable != null) {
          let vtableInit = g.initVTable as VTableInit;
          this.markTypeReached(vtableInit.structType);
          for (let func in vtableInit.funcs) {
            if (!this.reachedFunctionsSet.has(func)) {
              this.markFunctionReached(func);
              progress = true;
            }
          }
        }
      }
    }

    // Pass 0.6: Link superStruct for inheritance and inherit vtable slots recursively
    let linkedClasses = new HashMap<ClassKey, boolean>();
    let linkSuperAndVT = (ct: ClassType, model: SemanticModel): void => {
      let ctKey = getClassKey(ct);
      if (linkedClasses.has(ctKey)) { return; }
      linkedClasses[ctKey] = true;
      
      if (ct.superType != null) {
        let superCt = ct.superType as ClassType;
        this.discoverType(superCt, model);
        linkSuperAndVT(superCt, model);
        
        let cKey = getClassKey(ct);
        let superKey = getClassKey(superCt);
        
        if (let (true, info) = this.wasm.classInfos.get(cKey)) {
          if (let (true, superInfo) = this.wasm.classInfos.get(superKey)) {
            info.structType.superStruct = superInfo.structType;
            superInfo.subclasses.push(info);
            if (info.vtableStructType != null && superInfo.vtableStructType != null) {
              let vst = info.vtableStructType as WasmStruct;
              let superVst = superInfo.vtableStructType as WasmStruct;
              vst.superStruct = superVst;
            }
          }
        }
        
        if (superCt.vtable != null) {
          let newVTable = new Array<String>();
          let seen = new HashSet<String>();
          for (let methName in superCt.vtable) {
            newVTable.push(methName);
            seen.add(methName);
          }
          for (let methName in ct.vtable) {
            if (!seen.has(methName)) {
              newVTable.push(methName);
              seen.add(methName);
            }
          }
          while (ct.vtable.length > 0) {
            ct.vtable.pop();
          }
          for (let m in newVTable) {
            ct.vtable.push(m);
          }
        }
      }
    };

    // Pre-discover implemented interfaces of all reached/specialized and declared classes.
    let classesToDiscover = new Array<ClassType>();
    for (let cPair in this.wasm.classInfos) {
      let info = cPair.value;
      if (info.structType.classType != null) {
        classesToDiscover.push(info.structType.classType as ClassType);
      }
    }
    for (let pair in this.classDecls) {
      let classDecl = pair.value;
      let moduleModel = this.classModels[pair.key];
      let ct = this.getClassDeclType(classDecl, moduleModel);
      if (ct != null) {
        classesToDiscover.push(ct as ClassType);
      }
    }
    for (let ct in classesToDiscover) {
      let model = this.getClassModel(ct);
      let specIfaces = this.collectAllImplementedInterfaces(ct);
      for (let iface in specIfaces) {
        this.discoverType(iface, model);
      }
    }

    let classesToLink = new Array<ClassType>();
    for (let cPair in this.wasm.classInfos) {
      let info = cPair.value;
      if (info.structType.classType != null) {
        classesToLink.push(info.structType.classType as ClassType);
      }
    }
    for (let ct in classesToLink) {
      let model = this.getClassModel(ct);
      linkSuperAndVT(ct, model);
    }

    // Pass 0.8: Populate interface vtable fields
    let allInterfaces = new Array<InterfaceType>();
    for (let pair in this.interfaceDecls) {
      let ifaceDecl = pair.value;
      let moduleModel = this.interfaceModels[pair.key];
      let ifaceType = moduleModel.getNodeType(ifaceDecl) as InterfaceType;
      allInterfaces.push(ifaceType);
    }
    for (let it in this.specializedInterfaces) {
      allInterfaces.push(it);
    }

    for (let it in allInterfaces) {
      let iName = getInterfaceKey(it);
      let vst = this.wasm.interfaceVTableStructs[iName];
      if (vst.fields.length > 0) {
        continue;
      }
      let keys = it.members.keys();
      while (let (true, key) = keys.next()) {
        let member = it.members[key];
        match (member) {
          case FieldInfo as fi: {
            let sig = getInterfaceMemberSignature(this.wasm, it, "get#" + key);
            vst.fields.push(new WasmField("get#" + key, new ValTypeRef(sig), false));
            if (fi.isMutable) {
              let sigSet = getInterfaceMemberSignature(this.wasm, it, "set#" + key);
              vst.fields.push(new WasmField("set#" + key, new ValTypeRef(sigSet), false));
            }
          }
          case MethodInfo as mi: {
            var isGeneric = false;
            if (mi.type is FunctionType) {
              let ft = mi.type as FunctionType;
              if (ft.typeParameters != null && (ft.typeParameters as Array<TypeParameterType>).length > 0) {
                isGeneric = true;
              }
            }
            if (!isGeneric) {
              let sig = getInterfaceMemberSignature(this.wasm, it, key);
              vst.fields.push(new WasmField(key, new ValTypeRef(sig), false));
            }
          }
          case _: {}
        }
      }
    }



    // Pass 1.05: Unified recursive class struct and vtable fields population
    for (let cPair in this.wasm.classInfos) {
      let ct = cPair.value.structType.classType;
      if (ct != null) {
        let ctVal = ct as ClassType;
        let lookupId = (if (ctVal.genericSource != null) (ctVal.genericSource as ClassType).id else ctVal.id) as SymbolId;
        let cd: Node | null = if (this.classDecls.has(lookupId)) this.classDecls[lookupId] else null;
        let model = this.getClassModel(ctVal);
        this.populateClassStructAndMethods(ctVal, cd, model);
      }
    }

    // Pass 1.1: Synthesize physical field getters/setters for virtual/inherited slots
    for (let cPair in this.wasm.classInfos) {
      let cName = cPair.key;
      let cStruct = cPair.value.structType;
      if (cStruct.classType != null) {
        let cType = cStruct.classType as ClassType;
        for (let methName in cType.vtable) {
          if (methName.startsWith("get#")) {
            let fieldName = methName.sliceBytes(4, methName.length);
            var hasPhysical = false;
            var backingName = "";
            let lookupName = fieldName;
            let lookupPrivateName = getClassPrivateFieldKey(cName, fieldName);
            let lookupPrivateHashName = getClassPrivateFieldKey(cName, "#" + fieldName);
            for (let f in cStruct.fields) {
              if (f.name != null) {
                let fname = f.name as String;
                if (fname == lookupName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateHashName) {
                  hasPhysical = true;
                  backingName = "#" + fieldName;
                } else if (fname.endsWith("::" + fieldName)) {
                  hasPhysical = true;
                  backingName = fieldName;
                } else if (fname.endsWith("::#" + fieldName)) {
                  hasPhysical = true;
                  backingName = "#" + fieldName;
                }
              }
            }
            if (hasPhysical) {
              let hasGetter = this.wasm.classMethodMap.has(getClassMethodKey(getClassKey(cType), methName));
              if (!hasGetter) {
                this.registerClassMethod(cType, null, methName, null, true, false, backingName, this.program.units[0].model);
              }
            }
          } else if (methName.startsWith("set#")) {
            let fieldName = methName.sliceBytes(4, methName.length);
            var hasPhysical = false;
            var backingName = "";
            let lookupName = fieldName;
            let lookupPrivateName = getClassPrivateFieldKey(cName, fieldName);
            let lookupPrivateHashName = getClassPrivateFieldKey(cName, "#" + fieldName);
            for (let f in cStruct.fields) {
              if (f.name != null) {
                let fname = f.name as String;
                if (fname == lookupName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateHashName) {
                  hasPhysical = true;
                  backingName = "#" + fieldName;
                } else if (fname.endsWith("::" + fieldName)) {
                  hasPhysical = true;
                  backingName = fieldName;
                } else if (fname.endsWith("::#" + fieldName)) {
                  hasPhysical = true;
                  backingName = "#" + fieldName;
                }
              }
            }
            if (hasPhysical) {
              let hasSetter = this.wasm.classMethodMap.has(getClassMethodKey(getClassKey(cType), methName));
              if (!hasSetter) {
                this.registerClassMethod(cType, null, methName, null, false, true, backingName, this.program.units[0].model);
              }
            }
          }
        }
      }
    }

    // Pass 1.15: Register any remaining vtable slots that haven't been registered yet (e.g. abstract fields/methods)
    for (let cPair in this.wasm.classInfos) {
      let cStruct = cPair.value.structType;
      if (cStruct.classType != null) {
        let cType = cStruct.classType as ClassType;
        for (let methName in cType.vtable) {
          var hasImpl = false;
          var curr: ClassType | null = cType;
          while (curr != null) {
            let k = getClassMethodKey(getClassKey(curr), methName);
            if (this.wasm.classMethodMap.has(k)) {
              hasImpl = true;
              break;
            }
            curr = curr.superType;
          }
          if (!hasImpl) {
            let isGetter = methName.startsWith("get#");
            let isSetter = methName.startsWith("set#");
            this.registerClassMethod(cType, null, methName, null, isGetter, isSetter, null, this.program.units[0].model);
          }
        }
      }
    }

    // Pass 1.2: Resolve indices for all synthesized getters and setters
    for (let f in this.wasm.functions) {
      if (f.classType != null) {
        let cType = f.classType as ClassType;
        if (!cType.isExtension) {
          let cKey = getClassKey(cType);
          if (let (true, info) = this.wasm.classInfos.get(cKey)) {
            let st = info.structType;
            if (f.methodName != null) {
              let mName = f.methodName as String;
              if (mName.startsWith("get#")) {
                let fieldName = mName.sliceBytes(4, mName.length);
                let lookupName = fieldName;
                let lookupPrivateName = getClassPrivateFieldKey(cKey, fieldName);
                let lookupPrivateHashName = getClassPrivateFieldKey(cKey, "#" + fieldName);
                var foundIdx = -1;
                for (var fi = 0; fi < st.fields.length; fi += 1) {
                  let fname = st.fields[fi].name;
                  if (fname != null) {
                    let fnm = fname as String;
                    if (fnm == lookupName || fnm == lookupPrivateName || fnm == lookupPrivateHashName || fnm.endsWith("::" + fieldName) || fnm.endsWith("::#" + fieldName)) {
                      foundIdx = fi;
                      break;
                    }
                  }
                }
                f.getterStruct = st;
                f.getterFieldIndex = foundIdx;
              } else if (mName.startsWith("set#")) {
                let fieldName = mName.sliceBytes(4, mName.length);
                let lookupName = fieldName;
                let lookupPrivateName = getClassPrivateFieldKey(cKey, fieldName);
                let lookupPrivateHashName = getClassPrivateFieldKey(cKey, "#" + fieldName);
                var foundIdx = -1;
                for (var fi = 0; fi < st.fields.length; fi += 1) {
                  let fname = st.fields[fi].name;
                  if (fname != null) {
                    let fnm = fname as String;
                    if (fnm == lookupName || fnm == lookupPrivateName || fnm == lookupPrivateHashName || fnm.endsWith("::" + fieldName) || fnm.endsWith("::#" + fieldName)) {
                      foundIdx = fi;
                      break;
                    }
                  }
                }
                f.setterStruct = st;
                f.setterFieldIndex = foundIdx;
              }
            }
          }
        }
      }
    }

    // Pre-mark all singleton case classes as instantiated so they get class and interface vtables built
    for (let cPair in this.wasm.classInfos) {
      let info = cPair.value;
      let cStruct = info.structType;
      if (cStruct.classType != null) {
        let cType = cStruct.classType as ClassType;
        if (cType.isCaseClass && (cType.constructorType == null || (cType.constructorType as FunctionType).parameters.length == 0)) {
          let classId = (cType.genericSource ?? cType).id as SymbolId;
          this.instantiatedClasses.add(classId);
          this.instantiatedSpecializedClasses.add(getClassKey(cType) as String);
        }
      }
    }

    this.currentReachable = true;

    // Pass 1.5: Build class vtable globals
    for (let cPair in this.wasm.classInfos) {
      let cName = cPair.key;
      let info = cPair.value;
      if (info.vtableGlobal != null) {
        continue;
      }
      if (info.vtableStructType != null) {
        let vstVal = info.vtableStructType as WasmStruct;
        let cType = vstVal.classType as ClassType;
        let isGenericTemplate = cType.typeParameters != null && 
                                (cType.typeParameters as Array<TypeParameterType>).length > 0 && 
                                (cType.typeArguments == null || !isConcrete(cType));
        if (isGenericTemplate) {
          continue;
        }
        var methods = new Array<WasmFunction>();
        let fields = vstVal.fields;
        var newFields = new Array<WasmField>();
        let classId = (cType.genericSource ?? cType).id as SymbolId;
        for (var i = 0; i < fields.length; i += 1) {
          let field = fields[i];
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = cType;
          while (currClass != null && foundFunc == null) {
            let key = getClassMethodKey(getClassKey(currClass as ClassType), field.name as String);
            if (this.wasm.classMethodMap.has(key)) {
              foundFunc = this.wasm.classMethodMap[key];
              break;
            }
            currClass = (currClass as ClassType).superType;
          }
          if (foundFunc != null) {
            newFields.push(field);
            methods.push(foundFunc);
          } else {
            throw new Error("Internal error: class " + (cName as String) + " does not implement vtable method: " + (field.name as String));
          }
        }
        while (vstVal.fields.length > 0) {
          let ignored = vstVal.fields.pop();
        }
        for (var fIdx = 0; fIdx < newFields.length; fIdx += 1) {
          vstVal.fields.push(newFields[fIdx]);
        }

        if (!this.instantiatedSpecializedClasses.has(cName as String)) {
          continue;
        }
        
        for (let m in methods) {
          this.markFunctionReached(m);
        }
        
        let vtableInit = new VTableInit(vstVal, methods);
        let vName = getClassVTableName(cName);
        let vtableGlobal = new WasmGlobal(
          vName,
          vName,
          new ValTypeRef(vstVal),
          false,
          null,
          vtableInit,
          this.program.units[0].model
        );
        this.wasm.globals.push(vtableGlobal);
        info.vtableGlobal = vtableGlobal;
      }
    }

    // Pass 1.25: Allocate singleton globals for unit variants
    for (let cPair in this.wasm.classInfos) {
      let cName = cPair.key;
      let info = cPair.value;
      let cStruct = info.structType;
      if (cStruct.classType != null) {
        let cType = cStruct.classType as ClassType;
        if (cType.isCaseClass && (cType.constructorType == null || (cType.constructorType as FunctionType).parameters.length == 0)) {
          if (info.singletonGlobal != null) {
            continue;
          }
          let globalName = getClassSingletonName(cName);
          let globalType = new ValTypeRefNull(cStruct);
          let wasmGlobal = new WasmGlobal(
            globalName,
            globalName,
            globalType,
            false,
            null,
            null,
            this.program.units[0].model
          );
          wasmGlobal.initSingletonStruct = cType;
          this.wasm.globals.push(wasmGlobal);
          info.singletonGlobal = wasmGlobal;
        }
      }
    }

    // Pass 2: Generate class-interface trampoline vtables
    let classes = new Array<ClassType>();
    let seenClassKeys = new HashMap<ClassKey, boolean>();
    for (let cPair in this.wasm.classInfos) {
      let cStruct = cPair.value.structType;
      if (cStruct.classType != null) {
        let cType = cStruct.classType as ClassType;
        let cKey = getClassKey(cType);
        if (!seenClassKeys.has(cKey)) {
          seenClassKeys[cKey] = true;
          classes.push(cType);
        }
      }
    }
    for (let pair in this.classDecls) {
      let classDecl = pair.value;
      let moduleModel = this.classModels[pair.key];
      let ct = this.getClassDeclType(classDecl, moduleModel);
      if (ct != null) {
        let cKey = getClassKey(ct as ClassType);
        if (!seenClassKeys.has(cKey)) {
          seenClassKeys[cKey] = true;
          classes.push(ct as ClassType);
        }
      }
    }

    for (let cType in classes) {
      let isGenericTemplate = cType.typeParameters != null && 
                              (cType.typeParameters as Array<TypeParameterType>).length > 0 && 
                              (cType.typeArguments == null || !isConcrete(cType));
      if (isGenericTemplate) {
        continue;
      }
      let cName = getClassKey(cType);
      if (!this.instantiatedSpecializedClasses.has(cName as String)) {
        continue;
      }
      let allIfaces = this.collectAllImplementedInterfaces(cType);
      for (let iface in allIfaces) {
        let iName = getInterfaceKey(iface);
        let unspecCName = getClassKey(cType.genericSource ?? cType);
        let unspecIName = getInterfaceKey(iface.genericSource ?? iface);
        let unspecKey = getClassInterfaceKey(unspecCName, unspecIName);
        
        if (this.wasm.usedInterfaceAdaptations.has(unspecKey)) {
          let key = getClassInterfaceKey(cName, iName);
          if (this.wasm.classInterfaceVTables.has(key)) {
            continue;
          }
          if (!this.wasm.interfaceVTableStructs.has(iName)) {
            this.discoverType(iface, this.getClassModel(cType));
          }
          let vst = this.wasm.interfaceVTableStructs[iName];
          
          var methods = new Array<WasmFunction>();
          for (var i = 0; i < vst.fields.length; i += 1) {
            let field = vst.fields[i];
            var foundFunc: WasmFunction | null = null;
            var currClass: ClassType | null = cType;
            
            while (currClass != null && foundFunc == null) {
              let mKey = getClassMethodKey(getClassKey(currClass as ClassType), field.name as String);
              if (this.wasm.classMethodMap.has(mKey)) {
                foundFunc = this.wasm.classMethodMap[mKey];
                break;
              }
              
              if (iface.members.has(field.name)) {
                let mi = iface.members[field.name];
                if (mi is MethodInfo) {
                  let ft = (mi as MethodInfo).type as FunctionType;
                  let itParams = getInterfaceTypeParameters(iface);
                  let resolvedFt = substituteTypeParamsInCodegen(itParams, iface.typeArguments, ft) as FunctionType;
                  let sigKey = getSignatureKey(resolvedFt);
                  let mKeyWithSig = getClassMethodKey(getClassKey(currClass as ClassType), (field.name as String) + sigKey);
                  if (this.wasm.classMethodMap.has(mKeyWithSig)) {
                    foundFunc = this.wasm.classMethodMap[mKeyWithSig];
                    break;
                  }
                }
              }
              
              currClass = (currClass as ClassType).superType;
            }
            
            if (foundFunc != null) {
              let targetFunc = foundFunc as WasmFunction;
              let trampSig = getInterfaceMemberSignature(this.wasm, iface, field.name);
              let trampFunc = new WasmFunction(trampSig, null, this.program.units[0].model);
              trampFunc.name = getInterfaceTrampolineName(cName, iName, field.name);
              trampFunc.interfaceTrampolineTarget = targetFunc;
              this.wasm.addFunction(trampFunc);
              this.markFunctionReached(trampFunc);
              this.markFunctionReached(targetFunc);
              methods.push(trampFunc);
            } else {
              throw new Error("Internal error: class " + (cName as String) + " does not implement interface method: " + (field.name as String));
            }
          }
          
          let vtableInit = new VTableInit(vst, methods);
          let viName = getClassInterfaceVTableName(cName, iName);
          let vtableGlobal = new WasmGlobal(
            viName,
            viName,
            new ValTypeRef(vst),
            false,
            null,
            vtableInit,
            this.program.units[0].model
          );
          this.wasm.globals.push(vtableGlobal);
          this.wasm.classInterfaceVTables[key] = vtableGlobal;
        }
      }
    }
    }
    this.isRtaActive = false;
    
    if (this.wasm.stringClass != null) {
      if (let (true, info) = this.wasm.classInfos.get(getClassKey(this.wasm.stringClass as ClassType))) {
        this.markTypeReached(info.structType);
        this.markTypeReached(info.vtableStructType);
      }
    }

    if (this.wasm.templateStringsArrayClass != null) {
      if (let (true, info) = this.wasm.classInfos.get(getClassKey(this.wasm.templateStringsArrayClass as ClassType))) {
        this.markTypeReached(info.structType);
        this.markTypeReached(info.vtableStructType);
      }
    }
    
    for (let cKey in this.instantiatedSpecializedClasses) {
      if (let (true, info) = this.wasm.classInfos.get(cKey as ClassKey)) {
        this.markTypeReached(info.structType);
        this.markTypeReached(info.vtableStructType);
      }
    }
    
    for (let g in this.wasm.globals) {
      this.markValTypeReached(g.type);
      if (g.initVTable != null) {
        let vtableInit = g.initVTable as VTableInit;
        this.markTypeReached(vtableInit.structType);
        for (let func in vtableInit.funcs) {
          this.markFunctionReached(func);
        }
      }
    }

    for (let t in this.wasm.tags) {
      this.markTypeReached(t.signature);
    }
    for (let f in this.wasm.functionImports) {
      this.markTypeReached(f.signature);
    }
    
    let originalFunctions = this.wasm.functions;
    let reachedList = new Array<WasmFunction>();
    for (let f in originalFunctions) {
      let isReached = this.reachedFunctionsSet.has(f);
      if (isReached) {
        reachedList.push(f);
      }
    }
    this.wasm.functions = reachedList;
    
    this.closeReachedTypes();
    this.wasm.types = this.emittedTypes;
  }

  traverseDependencies(deps: SymbolDependencies, model: SemanticModel, classType: ClassType | null): void {
    let ctParams = if (classType != null) getClassTypeParameters(classType as ClassType) else null as Array<TypeParameterType>;
    let ctArgs = if (classType != null) (classType as ClassType).typeArguments else null as Array<Type>;

    let resolveType = (t: Type): Type => {
      if (classType != null && ctParams != null) {
        return substituteTypeParamsInCodegen(ctParams, ctArgs, t);
      }
      return t;
    };



    // 1. Discover referenced types
    for (let t in deps.referencedTypes) {
      this.discoverType(resolveType(t), model);
    }

    // 2. Queue referenced symbols
    for (let symId in deps.referencedSymbols) {
      var targetSymId = symId;
      if (this.symbolIdToTargetId.has(symId)) {
        targetSymId = this.symbolIdToTargetId[symId];
      }
      if (let (true, targetModel) = this.symbolIdToModel.get(targetSymId)) {
        this.queueReferrer(new Referrer(true, targetSymId, -1, targetModel, null, this.currentReachable));
      }
    }

    for (let methStr in deps.referencedClassMethods) {
      var parsed: ParsedMethodRef | null = null;
      if (let (true, cached) = this.#parsedClassMethodRefs.get(methStr)) {
        parsed = cached;
      } else {
        var dotIdx = -1;
        for (var i = 0; i < methStr.length; i += 1) {
          if (methStr.getByteAt(i) == 46) {
            dotIdx = i;
            break;
          }
        }
        if (dotIdx != -1) {
          let classIdStr = methStr.sliceBytes(0, dotIdx);
          let mName = methStr.sliceBytes(dotIdx + 1, methStr.length);
          let classId = if (let (true, cid) = parseI32(classIdStr)) cid else -1;
          parsed = new ParsedMethodRef(classId as SymbolId, mName);
        } else {
          parsed = new ParsedMethodRef(-1 as SymbolId, "");
        }
        this.#parsedClassMethodRefs[methStr] = parsed as ParsedMethodRef;
      }

      if (parsed != null && (parsed as ParsedMethodRef).classSymId as i32 != -1) {
        let p = parsed as ParsedMethodRef;
        let classSymId = p.classSymId;
        let mName = p.mName;
        let classId = classSymId as i32;

        if (let (true, targetModel) = this.symbolIdToModel.get(classSymId)) {
          var targetClassType: ClassType | null = null;
          let t = targetModel.getBindingTypeById(classSymId);
          if (t != null && t is ClassType) {
            targetClassType = t as ClassType;
            if (classType != null && (classType as ClassType).genericSource != null) {
              let genSrc = (classType as ClassType).genericSource as ClassType;
              if (genSrc.id == classId) {
                targetClassType = classType as ClassType;
              }
            }
            this.instantiateClassType(targetClassType as ClassType, targetModel);
          } else if (targetModel.mixinDeclarations.has(classSymId)) {
            let mixinDecl = targetModel.mixinDeclarations[classSymId];
            targetClassType = new ClassType(classId, mixinDecl.name.name);
          }

          if (targetClassType != null) {
            let subclasses = this.findInstantiatedSubclasses(targetClassType as ClassType);
            for (let subCt in subclasses) {
              let subModel = this.getClassModel(subCt);
              let mds = this.findImplementingMethods(subCt, mName);
              if (mds.length > 0) {
                for (let md in mds) {
                  this.queueReferrer(new Referrer(false, -1 as SymbolId, (md as Node).id as i32, this.getNodeModel(md as Node, subModel), subCt, this.currentReachable));
                }
              } else {
                let acc = this.findImplementingAccessor(subCt, mName);
                if (acc != null) {
                  this.queueReferrer(new Referrer(false, -1 as SymbolId, (acc as Node).id as i32, this.getNodeModel(acc as Node, subModel), subCt, this.currentReachable));
                } else if (mName.startsWith("get#") || mName.startsWith("set#")) {
                  let fieldName = mName.sliceBytes(4, mName.length);
                  let fd = this.findImplementingField(subCt, fieldName);
                  if (fd != null) {
                    this.queueReferrer(new Referrer(false, -1 as SymbolId, (fd as Node).id as i32, this.getNodeModel(fd as Node, subModel), subCt, this.currentReachable));
                  }
                }
              }
            }
          }
        }
      }
    }

    // 4. Queue referenced interface members
    for (let ifaceStr in deps.referencedInterfaceMembers) {
      var parsed: ParsedInterfaceMemberRef | null = null;
      if (let (true, cached) = this.#parsedInterfaceMemberRefs.get(ifaceStr)) {
        parsed = cached;
      } else {
        var dotIdx = -1;
        for (var i = 0; i < ifaceStr.length; i += 1) {
          if (ifaceStr.getByteAt(i) == 46) {
            dotIdx = i;
            break;
          }
        }
        if (dotIdx != -1) {
          let ifaceIdStr = ifaceStr.sliceBytes(0, dotIdx);
          let mName = ifaceStr.sliceBytes(dotIdx + 1, ifaceStr.length);
          let ifaceId = if (let (true, iid) = parseI32(ifaceIdStr)) iid else -1;
          parsed = new ParsedInterfaceMemberRef(ifaceId as SymbolId, mName);
        } else {
          parsed = new ParsedInterfaceMemberRef(-1 as SymbolId, "");
        }
        this.#parsedInterfaceMemberRefs[ifaceStr] = parsed as ParsedInterfaceMemberRef;
      }

      if (parsed != null && (parsed as ParsedInterfaceMemberRef).ifaceSymId as i32 != -1) {
        let p = parsed as ParsedInterfaceMemberRef;
        let ifaceId = p.ifaceSymId;
        let mName = p.mName;
        
        if (let (true, targetModel) = this.symbolIdToModel.get(ifaceId)) {
          let ifaceDecl = this.interfaceDecls[ifaceId];
          if (ifaceDecl != null) {
            let baseIfaceType = targetModel.getNodeType(ifaceDecl) as InterfaceType;
            var targetIfaceType = baseIfaceType;
            if (classType != null) {
              let specIfaces = this.collectAllImplementedInterfaces(classType as ClassType);
              for (let specI in specIfaces) {
                let genSrc = specI.genericSource ?? specI;
                if (genSrc.id == (ifaceId as i32)) {
                  targetIfaceType = specI;
                  break;
                }
              }
            }
            let unspecIName = getInterfaceKey(targetIfaceType.genericSource ?? targetIfaceType);
            this.wasm.usedInterfaceMembers[getInterfaceMemberKey(unspecIName, mName)] = true;
            
            let resolvedIfaceStr = i32ToString((targetIfaceType.genericSource ?? targetIfaceType).id) + "." + mName;
            this.addReferencedInterfaceMember(resolvedIfaceStr);
          }
        }
      }
    }

    // 5. Record reached closures
    for (let closureDep in deps.closures) {
      let funcExpr = closureDep.node as FunctionExpression;
      
      let rawFuncTypeNode = model.getNodeType(funcExpr);
      let funcTypeNode = if (classType != null && ctParams != null) {
        substituteTypeParamsInCodegen(ctParams, ctArgs, rawFuncTypeNode as Type)
      } else {
        rawFuncTypeNode
      };
      
      let params = new Array<ValType>();
      params.push(new ValTypeStructRef()); // ctx
      let returns = new Array<ValType>();
      
      if (funcTypeNode is FunctionType) {
        let ft = funcTypeNode as FunctionType;
        for (let p in ft.parameters) {
          params.push(typeToValType(this.wasm, p));
        }
        mapReturnTypeToWasmResults(this.wasm, ft.returnType, returns);
      } else {
        returns.push(new ValTypeI32());
      }
      
      let sig = this.wasm.getSignature(params, returns);
      let wasmFunc = new WasmFunction(sig, funcExpr, model);
      wasmFunc.isClosure = true;
      wasmFunc.isReferenceTaken = true;
      wasmFunc.classType = classType;
      
      let classKey = if (classType != null) getClassKey(classType as ClassType) else "" as ClassKey;
      let suffix = if ((classKey as String).length > 0) "_" + (classKey as String) else "";



      let fileBase = sanitizeName(getFileNameBase(getNodeFilePath(model, funcExpr)));
      let locStr = if (funcExpr.loc != null) {
        let loc = funcExpr.loc as SourceLocation;
        "L" + i32ToString(loc.line) + "C" + i32ToString(loc.column)
      } else {
        i32ToString(funcExpr.id as i32)
      };

      wasmFunc.name = "closure_impl_" + fileBase + suffix + "_" + locStr;
      
      wasmFunc.capturesThis = closureDep.capturesThis;
      wasmFunc.mutableCaptures = closureDep.mutableCaptures;
      for (let symId in closureDep.captures) {
        let symName = if (model.symbolNames.has(symId)) {
          model.symbolNames[symId]
        } else {
          "captured_var"
        };
        this.wasm.symbolNames[symId] = symName;
        wasmFunc.captures.push(symId);
      }
      
      var enclosingClassType = classType;
      if (enclosingClassType == null && closureDep.capturesThis) {
        var curr = funcExpr as Node;
        while (true) {
          let parent = model.getParent(curr);
          if (parent == null) { break; }
          if (parent is ClassDeclaration) {
            let cd = parent as ClassDeclaration;
            let ct = model.getNodeType(cd);
            if (ct != null && ct is ClassType) {
              enclosingClassType = ct as ClassType;
            }
            break;
          }
          curr = parent as Node;
        }
      }

      let fields = new Array<WasmField>();
      if (closureDep.capturesThis && enclosingClassType != null) {
        let ct = enclosingClassType as ClassType;
        var thisValType: ValType = new ValTypeAnyRef();
        if (let (true, info) = this.wasm.classInfos.get(getClassKey(ct))) {
          thisValType = new ValTypeRefNull(info.structType);
        } else {
          thisValType = typeToValType(this.wasm, ct);
        }
        fields.push(new WasmField("this", thisValType, false));
      }
      
      for (let symId in closureDep.captures) {
        let rawSymType = model.getBindingTypeById(symId);
        let symType = if (classType != null && ctParams != null) {
          substituteTypeParamsInCodegen(ctParams, ctArgs, rawSymType as Type)
        } else {
          rawSymType
        };
        let valType = typeToValType(this.wasm, symType);
        var fieldType: ValType = valType;
        if (closureDep.mutableCaptures.has(symId)) {
          let cellStruct = getCellStruct(this.wasm, valType);
          fieldType = new ValTypeRefNull(cellStruct);
        }
        fields.push(new WasmField("capture_" + i32ToString(symId as i32), fieldType, false));
      }
      
      let contextStructName = "ClosureCtx_" + fileBase + suffix + "_" + locStr;
      let contextStruct = new WasmStruct(contextStructName, fields);
      this.wasm.types.push(contextStruct);
      this.markTypeReached(contextStruct);
      wasmFunc.contextStruct = contextStruct;

      this.wasm.addFunction(wasmFunc);
      this.markFunctionReached(wasmFunc);
      this.wasm.closureFunctions[funcExpr] = wasmFunc;
      
      let closureKey = getClosureSpecializationKey(funcExpr.id, classKey);
      this.wasm.specializedClosures[closureKey] = wasmFunc;

      this.queueReferrer(new Referrer(false, -1 as SymbolId, funcExpr.id as i32, model, classType, this.currentReachable));
    }

    // 6. Record function adaptations
    for (let fAdapt in deps.functionAdaptations) {
      let src = resolveType(fAdapt.source) as FunctionType;
      let tgt = resolveType(fAdapt.target) as FunctionType;
      let expr = fAdapt.node;
      
      this.discoverType(src, model);
      this.discoverType(tgt, model);
      
      let pValTypes = new Array<ValType>();
      pValTypes.push(new ValTypeStructRef()); // ctx
      for (let p in tgt.parameters) {
        pValTypes.push(typeToValType(this.wasm, p));
      }
      let rValTypes = new Array<ValType>();
      mapReturnTypeToWasmResults(this.wasm, tgt.returnType, rValTypes);
      let wrapperSig = this.wasm.getSignature(pValTypes, rValTypes);
      
      let adaptKey = getFunctionAdaptationKey(src, tgt);
      let existingWrapper = if (this.wasm.functionAdaptations.has(adaptKey)) {
        this.wasm.functionAdaptations[adaptKey]
      } else {
        null as WasmFunction
      };

      if (existingWrapper != null) {
        this.wasm.functionAdaptationWrappers[expr] = existingWrapper;
        this.markFunctionReached(existingWrapper);
      } else {
        let wrapperFunc = new WasmFunction(wrapperSig, null, model);
        let fileBase = sanitizeName(getFileNameBase(getNodeFilePath(model, expr)));
        let locStr = if (expr.loc != null) {
          let loc = expr.loc as SourceLocation;
          "L" + i32ToString(loc.line) + "C" + i32ToString(loc.column)
        } else {
          i32ToString(expr.id as i32)
        };
        wrapperFunc.name = "function_adapt_" + fileBase + "_" + locStr;
        wrapperFunc.isFunctionAdaptation = true;
        wrapperFunc.isReferenceTaken = true;
        wrapperFunc.functionAdaptationSource = src;
        wrapperFunc.functionAdaptationTarget = tgt;
        
        this.wasm.addFunction(wrapperFunc);
        this.markFunctionReached(wrapperFunc);
        this.wasm.functionAdaptations[adaptKey] = wrapperFunc;
        this.wasm.functionAdaptationWrappers[expr] = wrapperFunc;
      }
      
      let srcClosure = getClosureStruct(this.wasm, src);
      let tgtClosure = getClosureStruct(this.wasm, tgt);
    }

    // 7. Record string literals
    for (let s in deps.stringLiterals) {
      this.wasm.getStringLiteralDataIndex(s);
    }
  }

  addReferencedInterfaceMember(ifaceStr: String): void {
    if (this.currentReachable) {
      if (this.referencedReachableInterfaceMembers.has(ifaceStr)) {
        return;
      }
      this.referencedReachableInterfaceMembers.add(ifaceStr);
      this.referencedInterfaceMembers.add(ifaceStr);
    } else {
      if (this.referencedInterfaceMembers.has(ifaceStr)) {
        return;
      }
      this.referencedInterfaceMembers.add(ifaceStr);
    }

    var dotIdx = -1;
    for (var i = 0; i < ifaceStr.length; i += 1) {
      if (ifaceStr.getByteAt(i) == 46) {
        dotIdx = i;
        break;
      }
    }
    if (dotIdx != -1) {
      let ifaceIdStr = ifaceStr.sliceBytes(0, dotIdx);
      let mName = ifaceStr.sliceBytes(dotIdx + 1, ifaceStr.length);
      let ifaceId = if (let (true, iid) = parseI32(ifaceIdStr)) iid else -1;
      if (ifaceId != -1) {
        let symId = ifaceId as SymbolId;
        if (!this.referencedInterfaceMembersById.has(symId)) {
          this.referencedInterfaceMembersById[symId] = new Array<String>();
        }
        let list = this.referencedInterfaceMembersById[symId];
        var hasMem = false;
        for (let existing in list) {
          if (existing == mName) {
            hasMem = true;
            break;
          }
        }
        if (!hasMem) {
          list.push(mName);
        }

        if (let (true, pairList) = this.instantiatedClassesByInterface.get(symId)) {
          for (let pair in pairList) {
            let cType = pair.classType;
            let ifaceType = pair.interfaceType;
            let unspecIName = getInterfaceKey(ifaceType.genericSource ?? ifaceType);
            this.wasm.usedInterfaceMembers[getInterfaceMemberKey(unspecIName, mName)] = true;

            let mds = this.findImplementingMethods(cType, mName);
            if (mds.length > 0) {
              for (let md in mds) {
                this.queueReferrer(new Referrer(false, -1 as SymbolId, (md as Node).id as i32, this.getNodeModel(md as Node, this.getClassModel(cType)), cType, this.currentReachable));
              }
            } else {
              let acc = this.findImplementingAccessor(cType, mName);
              if (acc != null) {
                this.queueReferrer(new Referrer(false, -1 as SymbolId, (acc as Node).id as i32, this.getNodeModel(acc as Node, this.getClassModel(cType)), cType, this.currentReachable));
              } else if (mName.startsWith("get#") || mName.startsWith("set#")) {
                let fieldName = mName.sliceBytes(4, mName.length);
                let fd = this.findImplementingField(cType, fieldName);
                if (fd != null) {
                  this.queueReferrer(new Referrer(false, -1 as SymbolId, (fd as Node).id as i32, this.getNodeModel(fd as Node, this.getClassModel(cType)), cType, this.currentReachable));
                }
              }
            }
          }
        }
      }
    }
  }

  instantiateClassType(classType: ClassType, model: SemanticModel): void {
    if (!this.isRtaActive) {
      return;
    }
    let cKey = getClassKey(classType) as String;
    if (this.instantiatedSpecializedClasses.has(cKey)) {
      return;
    }
    this.instantiatedSpecializedClasses.add(cKey);

    let unspecC = classType.genericSource ?? classType;
    let classId = unspecC.id as SymbolId;
    this.instantiatedClasses.add(classId);
    if (this.specializedClassTypes.has(classId)) {
      let list = this.specializedClassTypes[classId];
      for (let specCt in list) {
        this.instantiateClassType(specCt, this.getClassModel(specCt));
      }
    }

    // Keep == and hashCode for any instantiated class if they exist,
    // as they can be called virtually by generic operations and HashMap/HashSet.
    let unspecModel = this.getClassModel(classType);
    let eqMethod = this.findImplementingMethod(classType, "==");
    if (eqMethod != null) {
      this.queueReferrer(new Referrer(false, -1 as SymbolId, (eqMethod as Node).id as i32, this.getNodeModel(eqMethod as Node, unspecModel), classType, this.currentReachable));
    }
    let hashMethod = this.findImplementingMethod(classType, "hashCode");
    if (hashMethod != null) {
      this.queueReferrer(new Referrer(false, -1 as SymbolId, (hashMethod as Node).id as i32, this.getNodeModel(hashMethod as Node, unspecModel), classType, this.currentReachable));
    }

    if (classType.superType != null) {
      let superType = classType.superType as ClassType;
      this.instantiateClassType(superType, this.getClassModel(superType));
    }

    this.discoverType(classType, model);

    let classDecl = this.classDecls[classId];
    if (classDecl != null && classDecl is ClassDeclaration) {
      let cd = classDecl as ClassDeclaration;
      // Discover static fields
      for (let member in cd.body) {
        if (member is FieldDefinition) {
          let fd = member as FieldDefinition;
          if (fd.isStatic) {
            let fieldName = match (fd.name) {
              case Identifier {name}: name
              case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                case Identifier {name}: name
                case MemberExpression {property}: property.name
                case _: "<symbol>"
              }
              case _: ""
            };
            if (fieldName != "") {
              let fType = if (classType.members.has(fieldName)) {
                classType.members[fieldName].type
              } else {
                model.getNodeType(fd)
              };
              let vType = typeToValType(this.wasm, fType);
              let name = cd.name.name + "_" + fieldName;
              let initExp = if (fd.value != null) { fd.value as Expression } else { null as Expression };
              let wasmGlobal = new WasmGlobal(name, fieldName, vType, true, initExp, null, model);
              this.wasm.globals.push(wasmGlobal);
            }
          }
        }
      }

      // Check if there is an explicit constructor
      var hasExplicitCtor = false;
      for (let member in cd.body) {
        if (member is MethodDefinition) {
          let md = member as MethodDefinition;
          if (getMethodName(md) == "<constructor>") {
            hasExplicitCtor = true;
          }
        }
      }

      if (!hasExplicitCtor) {
        let cKey = getClassKey(classType);
        let hasCtor = this.wasm.classMethodMap.has(getClassMethodKey(cKey, "<constructor>"));
        if (!hasCtor) {
          this.registerClassMethod(classType, cd, "<constructor>", null, false, false, null, model);
        }
      }

      // Discover constructor and field initializers
      for (let member in cd.body) {
        if (member is MethodDefinition) {
          let md = member as MethodDefinition;
          let mName = getMethodName(md);
          if (mName == "<constructor>") {
            this.queueReferrer(new Referrer(false, -1 as SymbolId, (md as Node).id as i32, model, classType, this.currentReachable));
          }
        } else if (member is FieldDefinition) {
          let fd = member as FieldDefinition;
          if (fd.value != null) {
            this.queueReferrer(new Referrer(false, -1 as SymbolId, (fd as Node).id as i32, model, classType, this.currentReachable));
          }
        }
      }
    } else if (classDecl != null && classDecl is SealedVariant) {
      let cKey = getClassKey(classType);
      let hasCtor = this.wasm.classMethodMap.has(getClassMethodKey(cKey, "<constructor>"));
      if (!hasCtor) {
        this.registerClassMethod(classType, null, "<constructor>", null, false, false, null, model);
      }
    } else {
      let cKey = getClassKey(classType);
      let hasCtor = this.wasm.classMethodMap.has(getClassMethodKey(cKey, "<constructor>"));
      if (!hasCtor) {
        this.registerClassMethod(classType, null, "<constructor>", null, false, false, null, model);
      }
    }
    
    // Implements list logic
    let allIfaces = this.collectAllImplementedInterfaces(classType);
    for (let iface in allIfaces) {
      let unspecI = iface.genericSource ?? iface;
      let ifaceId = unspecI.id as SymbolId;
      
      if (!this.instantiatedClassesByInterface.has(ifaceId)) {
        this.instantiatedClassesByInterface[ifaceId] = new Array<ClassInterfacePair>();
      }
      let list = this.instantiatedClassesByInterface[ifaceId];
      var hasC = false;
      for (let existing in list) {
        if (getClassKey(existing.classType) == getClassKey(classType)) {
          hasC = true;
          break;
        }
      }
      if (!hasC) {
        list.push(new ClassInterfacePair(classType, iface));
        
        // Trigger RTA: for any already-referenced member of this interface,
        // the class's implementing method becomes reachable!
        if (let (true, refMems) = this.referencedInterfaceMembersById.get(ifaceId)) {
          for (let mName in refMems) {
            let targetClassType = classType;
            let targetModel = this.getClassModel(targetClassType);
            let refMemKey = i32ToString(ifaceId as i32) + "." + mName;
            let isReachable = this.referencedReachableInterfaceMembers.has(refMemKey);
            let mds = this.findImplementingMethods(targetClassType, mName);
            if (mds.length > 0) {
              for (let md in mds) {
                this.queueReferrer(new Referrer(false, -1 as SymbolId, (md as Node).id as i32, this.getNodeModel(md as Node, targetModel), targetClassType, isReachable));
              }
            } else {
              let acc = this.findImplementingAccessor(targetClassType, mName);
              if (acc != null) {
                this.queueReferrer(new Referrer(false, -1 as SymbolId, (acc as Node).id as i32, this.getNodeModel(acc as Node, targetModel), targetClassType, isReachable));
              } else if (mName.startsWith("get#") || mName.startsWith("set#")) {
                let fieldName = mName.sliceBytes(4, mName.length);
                let fd = this.findImplementingField(targetClassType, fieldName);
                if (fd != null) {
                  this.queueReferrer(new Referrer(false, -1 as SymbolId, (fd as Node).id as i32, this.getNodeModel(fd as Node, targetModel), targetClassType, isReachable));
                }
              }
            }
          }
        }
      }
    }
  }

  discoverType(t: Type | null, model: SemanticModel): void {
    if (t == null) { return; }
    let typeStr = getTypeUniqueKey(t as Type);
    if (this.discoveredTypes.has(typeStr)) {
      return;
    }
    this.discoveredTypes.add(typeStr);
    
    if (t is RecordType) {
      let rec = t as RecordType;
      for (let pair in rec.properties) {
        this.discoverType(pair.value, model);
      }
      let fields = new Array<WasmField>();
      for (let pair in rec.properties) {
        fields.push(new WasmField(pair.key, typeToValType(this.wasm, pair.value), false));
      }
      let st = this.wasm.getRecordDispatch(model, fields);
      this.markTypeReached(st.fatPtrType);
      this.markTypeReached(st.vtableType);
      this.markTypeReached(st.concreteType);
    } else if (t is TupleType) {
      let tup = t as TupleType;
      for (var i = 0; i < tup.elementTypes.length; i += 1) {
        this.discoverType(tup.elementTypes[i], model);
      }
      let fields = new Array<WasmField>();
      for (var i = 0; i < tup.elementTypes.length; i += 1) {
        let type = tup.elementTypes[i];
        fields.push(new WasmField(i32ToString(i), typeToValType(this.wasm, type), false));
      }
      let st = this.wasm.getStruct(null, fields);
      this.markTypeReached(st);
    } else if (t is InlineTupleType) {
      let tup = t as InlineTupleType;
      for (var i = 0; i < tup.elementTypes.length; i += 1) {
        this.discoverType(tup.elementTypes[i], model);
      }
    } else if (t is UnionType) {
      let ut = t as UnionType;
      for (let member in ut.types) {
        this.discoverType(member, model);
      }
    } else if (t is TypeAliasType) {
      this.discoverType((t as TypeAliasType).target, model);
    } else if (t is FunctionType) {
      let ft = t as FunctionType;
      for (let paramType in ft.parameters) {
        this.discoverType(paramType, model);
      }
      this.discoverType(ft.returnType, model);
      let contextStruct = getClosureStruct(this.wasm, eraseType(ft) as FunctionType);
      this.markTypeReached(contextStruct);
    } else if (t is ClassType) {
      let ct = t as ClassType;
      if (ct.name == "array" && ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0) {
        let elemType = (ct.typeArguments as Array<Type>)[0];
        this.discoverType(elemType, model);
        let elemValType = typeToValType(this.wasm, elemType);
        let arr = this.wasm.getArray(elemValType, true);
        this.markTypeReached(arr);
        return;
      }
      let cKey = getClassKey(ct);
      let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
      if (this.wasm.classInfos.has(cKey)) {
        return;
      }
      if (ct.name == "String" && ct.sourcePath == "zena:string") {
        this.wasm.stringClass = ct;
      } else if (ct.name == "TemplateStringsArray" && ct.sourcePath == "zena:template-strings-array") {
        this.wasm.templateStringsArrayClass = ct;
      }
      
      // Register specialized class struct & methods if generic instantiation
      if (ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0 && isConcrete(ct)) {
        if (!this.specializedClassTypes.has(lookupId)) {
          this.specializedClassTypes[lookupId] = new Array<ClassType>();
        }
        let list = this.specializedClassTypes[lookupId];
        var found = false;
        for (let existing in list) {
          if (getClassKey(existing) == getClassKey(ct)) { found = true; break; }
        }
        if (!found) {
          list.push(ct);
          if (let (true, reachedSet) = this.reachedClassMembers.get(lookupId)) {
            for (let nid in reachedSet) {
              this.queueReferrer(new Referrer(false, -1 as SymbolId, nid, model, ct, this.currentReachable));
            }
          }
          if (this.currentReachable) {
            if (let (true, reachedSet) = this.reachedReachableClassMembers.get(lookupId)) {
              for (let nid in reachedSet) {
                this.queueReferrer(new Referrer(false, -1 as SymbolId, nid, model, ct, true));
              }
            }
          }
        }

        if (this.isRtaActive && this.instantiatedClasses.has(lookupId)) {
          this.instantiateClassType(ct, model);
        }

        if (this.classDecls.has(lookupId)) {
          let classDecl = this.classDecls[lookupId];
          let sourceModel = this.classModels[lookupId];
          this.registerSpecializedClass(ct, classDecl, sourceModel);
        }
      }
      
      if (ct.isExtension && ct.onType != null) {
        this.discoverType(ct.onType, model);
      }
      for (let pair in ct.members) {
        if (pair.value is FieldInfo) {
          let resolvedType = substituteTypeParamsInCodegen(getClassTypeParameters(ct), ct.typeArguments, pair.value.type);
          this.discoverType(resolvedType, model);
        }
      }
    } else if (t is InterfaceType) {
      let it = t as InterfaceType;
      let iKey = getInterfaceKey(it);
      if (this.wasm.interfaceStructs.has(iKey)) {
        let emptyStruct = this.wasm.interfaceStructs[iKey];
        if (this.currentReachable) {
          this.markTypeReached(emptyStruct);
          let emptyVTableStruct = this.wasm.interfaceVTableStructs[iKey];
          this.markTypeReached(emptyVTableStruct);
        }
        return;
      }
      
      // Register specialized interface struct & methods if generic instantiation
      if (it.typeArguments != null && (it.typeArguments as Array<Type>).length > 0 && isConcrete(it)) {
        let lookupId = (if (it.genericSource != null) (it.genericSource as InterfaceType).id else it.id) as SymbolId;
        if (this.interfaceDecls.has(lookupId)) {
          let ifaceDecl = this.interfaceDecls[lookupId];
          let sourceModel = this.interfaceModels[lookupId];
          this.registerSpecializedInterface(it, ifaceDecl, sourceModel);
        }
      }

      if (this.wasm.interfaceStructs.has(iKey)) {
        let emptyStruct = this.wasm.interfaceStructs[iKey];
        if (this.currentReachable) {
          this.markTypeReached(emptyStruct);
          let emptyVTableStruct = this.wasm.interfaceVTableStructs[iKey];
          this.markTypeReached(emptyVTableStruct);
        }
      }
      for (let pair in it.members) {
        if (pair.value is FieldInfo) {
          let resolvedType = substituteTypeParamsInCodegen(getInterfaceTypeParameters(it), it.typeArguments, pair.value.type);
          this.discoverType(resolvedType, model);
        }
      }
    } else if (t is ArrayType) {
      let at = t as ArrayType;
      this.discoverType(at.elementType, model);
      let elemValType = typeToValType(this.wasm, at.elementType);
      this.wasm.getArray(elemValType, true);

      if (isConcrete(at)) {
        let faClass = this.findPreludeClass("FixedArray");
        if (faClass != null) {
          let typeArgs = new Array<Type>();
          typeArgs.push(at.elementType);
          this.discoverType(instantiateClassType(faClass as ClassType, typeArgs), model);
        }
        let iaClass = this.findPreludeClass("ImmutableArray");
        if (iaClass != null) {
          let typeArgs = new Array<Type>();
          typeArgs.push(at.elementType);
          this.discoverType(instantiateClassType(iaClass as ClassType, typeArgs), model);
        }
      }
    } else if (t is ByteArrayType) {
      this.wasm.getByteArrayType();
    }
  }

  registerSpecializedClass(ct: ClassType, classDecl: Node | null, sourceModel: SemanticModel): void {
    if (ct.name == "Node") {
      throw new Error("registerSpecializedClass called for Node! classDeclIsNull=" + (if (classDecl == null) "1" else "0") + ", ct.id=" + i32ToString(ct.id));
    }
    let cKey = getClassKey(ct);
    if (this.wasm.classInfos.has(cKey)) {
      return;
    }

    let ctParams = getClassTypeParameters(ct);

    // 1. Pre-register empty structs
    let structName = cKey as String;
    let emptyStruct = new WasmStruct(structName, new Array<WasmField>());
    emptyStruct.classType = ct;
    this.wasm.types.push(emptyStruct);
    let info = new ClassCodegenInfo(emptyStruct);
    this.wasm.classInfos[cKey] = info;

    let emptyVTableStruct = new WasmStruct(structName + "_VTable", new Array<WasmField>());
    emptyVTableStruct.classType = ct;
    this.wasm.types.push(emptyVTableStruct);
    info.vtableStructType = emptyVTableStruct;

    // 2. Link super types
    if (ct.superType != null) {
      let superCt = ct.superType as ClassType;
      this.discoverType(superCt, sourceModel);
      
      let superKey = getClassKey(superCt);
      if (let (true, superInfo) = this.wasm.classInfos.get(superKey)) {
        emptyStruct.superStruct = superInfo.structType;
        if (superInfo.vtableStructType != null) {
          emptyVTableStruct.superStruct = superInfo.vtableStructType as WasmStruct;
        }
      }
      
      if (superCt.vtable != null) {
        let newVTable = new Array<String>();
        for (let methName in superCt.vtable) {
          newVTable.push(methName);
        }
        for (let methName in ct.vtable) {
          var hasMeth = false;
          for (let existing in newVTable) {
            if (existing == methName) { hasMeth = true; break; }
          }
          if (!hasMeth) {
            newVTable.push(methName);
          }
        }
        while (ct.vtable.length > 0) {
          ct.vtable.pop();
        }
        for (let m in newVTable) {
          ct.vtable.push(m);
        }
      }
    }

    if (ct.isCaseClass) {
      var hasEq = false;
      var hasHash = false;
      for (let existing in ct.vtable) {
        if (existing == "==") { hasEq = true; }
        if (existing == "hashCode") { hasHash = true; }
      }
      if (!hasEq) {
        ct.vtable.push("==");
      }
      if (!hasHash) {
        ct.vtable.push("hashCode");
      }
    }

    // 3. Discover referenced types in members (fields)
    for (let pair in ct.members) {
      if (pair.value is FieldInfo) {
        let resolvedType = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, pair.value.type);
        this.discoverType(resolvedType, sourceModel);
      }
    }

    let specIfaces = this.collectAllImplementedInterfaces(ct);
    for (let iface in specIfaces) {
      this.discoverType(iface, sourceModel);
    }

    // 4. Populate VTable slots and structs
    let mixinMembers = new Array<Node>();
    let seenMixins = new HashMap<MixinKey, boolean>();
    let classDeclCd = if (classDecl != null && classDecl is ClassDeclaration) classDecl as ClassDeclaration else null;
    if (classDeclCd != null) {
      collectMixinMembers(this.program, sourceModel, classDeclCd.mixins, mixinMembers, seenMixins);
    }

    let allMembers = new Array<Node>();
    if (classDeclCd != null) {
      for (let ms in classDeclCd.body) {
        allMembers.push(ms);
      }
    }
    for (let ms in mixinMembers) {
      allMembers.push(ms);
    }



    for (let ms in allMembers) {
      if (ms is MethodDefinition) {
        let mDef = ms as MethodDefinition;
        if (mDef.isStatic) { continue; }
        let methName = match (mDef.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: ""
        };
        if (methName != "") {
          var vtableMethName = methName;
          if (ct.members.has(methName)) {
            let mInfo = ct.members[methName];
            if (mInfo.type is FunctionType) {
              let ft = mInfo.type as FunctionType;
              let specificType = matchOverload(sourceModel, ft, mDef);
              if (specificType != null) {
                vtableMethName = methName + getSignatureKey(specificType as FunctionType);
              }
            }
          }
          
          var found = false;
          for (let existing in ct.vtable) {
            if (existing == vtableMethName) { found = true; }
          }
          if (!found && methName != "<constructor>") {
            ct.vtable.push(vtableMethName);
          }
        }
      } else if (ms is AccessorDeclaration) {
        let acc = ms as AccessorDeclaration;
        if (acc.isStatic) { continue; }
        let accName = match (acc.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: ""
        };
        if (accName != "") {
          if (acc.getter != null) {
            let getterName = "get#" + accName;
            var found = false;
            for (let existing in ct.vtable) {
              if (existing == getterName) { found = true; break; }
            }
            if (!found) { ct.vtable.push(getterName); }
          }
          if (acc.setter != null) {
            let setterName = "set#" + accName;
            var found = false;
            for (let existing in ct.vtable) {
              if (existing == setterName) { found = true; break; }
            }
            if (!found) { ct.vtable.push(setterName); }
          }
        }
      } else if (ms is FieldDefinition) {
        let fd = ms as FieldDefinition;
        if (fd.isStatic) { continue; }
        let fieldName = match (fd.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: ""
        };
        if (fd.setterName != null && fieldName != "") {
          let getterName = "get#" + fieldName;
          var found = false;
          for (let existing in ct.vtable) {
            if (existing == getterName) { found = true; break; }
          }
          if (!found) { ct.vtable.push(getterName); }
        }
        if (fieldName == "loc") {
          throw new Error("registerSpecializedClass Node: name=" + ct.name + ", isAbstract=" + (if (fd.isAbstract) "1" else "0") + ", mut=" + (if (fd.mutability == null) "null" else fd.mutability as String));
        }
        if (fd.isAbstract && fieldName != "") {
          let getterName = "get#" + fieldName;
          var found = false;
          for (let existing in ct.vtable) {
            if (existing == getterName) { found = true; break; }
          }
          if (!found) { ct.vtable.push(getterName); }
          if (fd.mutability != null && fd.mutability == "var") {
            let setterName = "set#" + fieldName;
            var foundS = false;
            for (let existing in ct.vtable) {
              if (existing == setterName) { foundS = true; break; }
            }
            if (!foundS) { ct.vtable.push(setterName); }
          }
        }
        if (fd.isDeclare && fieldName != "") {
          let getterName = "get#" + fieldName;
          var found = false;
          for (let existing in ct.vtable) {
            if (existing == getterName) { found = true; break; }
          }
          if (!found) { ct.vtable.push(getterName); }
        }
      }
    }

    // 5. Register specialized methods
    for (let ms in allMembers) {
      if (ms is MethodDefinition) {
        let method = ms as MethodDefinition;
        if (method.isAbstract) { continue; }
        if (method.typeParameters != null && (method.typeParameters as Array<TypeParameter>).length > 0) {
          continue;
        }
        let methName = match (method.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };
        this.registerClassMethod(ct, classDecl, methName, method as Node, false, false, null, sourceModel);
      } else if (ms is AccessorDeclaration) {
        let acc = ms as AccessorDeclaration;
        let accName = match (acc.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };
        if (acc.getter != null) {
          this.registerClassMethod(ct, classDecl, "get#" + accName, acc as Node, false, false, null, sourceModel);
        }
        if (acc.setter != null) {
          this.registerClassMethod(ct, classDecl, "set#" + accName, acc.setter as Node, false, false, null, sourceModel);
        }
      } else if (ms is FieldDefinition) {
        let fd = ms as FieldDefinition;
        let fieldName = match (fd.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<unknown>"
          }
          case _: "<unknown>"
        };
        if (fieldName != "") {
          if (!fieldName.startsWith("#")) {
            this.registerClassMethod(ct, classDecl, "get#" + fieldName, null, true, false, fieldName, sourceModel);
            if (fd.mutability != null && fd.mutability == "var") {
              this.registerClassMethod(ct, classDecl, "set#" + fieldName, null, false, true, fieldName, sourceModel);
            }
          } else {
            if (fd.setterName != null) {
              this.registerClassMethod(ct, classDecl, "get#" + fieldName, null, true, false, fieldName, sourceModel);
            }
            if (fd.isAbstract) {
              this.registerClassMethod(ct, classDecl, "get#" + fieldName, null, true, false, fieldName, sourceModel);
              if (fd.mutability != null && fd.mutability == "var") {
                this.registerClassMethod(ct, classDecl, "set#" + fieldName, null, false, true, fieldName, sourceModel);
              }
            }
            if (fd.isDeclare) {
              this.registerClassMethod(ct, classDecl, "get#" + fieldName, null, true, false, fieldName, sourceModel);
            }
          }
        }
      }
    }

    if (ct.isCaseClass) {
      let hasCtor = this.wasm.classMethodMap.has(getClassMethodKey(cKey, "<constructor>"));
      if (!hasCtor) {
        this.registerClassMethod(ct, classDecl, "<constructor>", null, false, false, null, sourceModel);
      }
 
      let hasEq = this.wasm.classMethodMap.has(getClassMethodKey(cKey, "=="));
      if (!hasEq) {
        let eqFunc = this.registerClassMethod(ct, classDecl, "==", null, false, false, null, sourceModel);
        eqFunc.isCaseClassEq = true;
      }
 
      let hasHash = this.wasm.classMethodMap.has(getClassMethodKey(cKey, "hashCode"));
      if (!hasHash) {
        let hashFunc = this.registerClassMethod(ct, classDecl, "hashCode", null, false, false, null, sourceModel);
        hashFunc.isCaseClassHash = true;
      }
    }

    // Register implicit interface getters/setters for specialized classes
    let allIfaces = this.collectAllImplementedInterfaces(ct);
    for (let iface in allIfaces) {
      let iName = getInterfaceKey(iface);
      let unspecializedKey = getClassInterfaceKey(getClassKey(ct.genericSource ?? ct), getInterfaceKey(iface.genericSource ?? iface));
      if (this.wasm.usedInterfaceAdaptations.has(unspecializedKey)) {
        let keys = iface.members.keys();
        while (let (true, key) = keys.next()) {
          let member = iface.members[key];
          if (member is FieldInfo) {
            let fi = member as FieldInfo;
            let getterName = "get#" + key;
            let unspecIName = getInterfaceKey(iface.genericSource ?? iface);
            let hasGetter = this.wasm.classMethodMap.has(getClassMethodKey(cKey, getterName));
            if (!hasGetter) {
              this.registerClassMethod(ct, classDecl, getterName, null, true, false, key, sourceModel);
            }
            
            if (fi.isMutable) {
              let setterName = "set#" + key;
              let hasSetter = this.wasm.classMethodMap.has(getClassMethodKey(cKey, setterName));
              if (!hasSetter) {
                this.registerClassMethod(ct, classDecl, setterName, null, false, true, key, sourceModel);
              }
            }
          }
        }
      }
    }
    
    this.populateClassStructAndMethods(ct, classDecl, sourceModel);
  }

  registerSpecializedInterface(it: InterfaceType, ifaceDecl: InterfaceDeclaration | null, sourceModel: SemanticModel): void {
    let iKey = getInterfaceKey(it);
    if (this.wasm.interfaceStructs.has(iKey)) {
      return;
    }

    let itParams = getInterfaceTypeParameters(it);

    // 1. Pre-register empty vtable and fat ptr structs
    let structName = iKey as String;
    let emptyVTableStruct = new WasmStruct(structName + "_VTable", new Array<WasmField>());
    this.wasm.types.push(emptyVTableStruct);
    this.wasm.interfaceVTableStructs[iKey] = emptyVTableStruct;



    let fatPtrFields = new Array<WasmField>();
    fatPtrFields.push(new WasmField("instance", new ValTypeAnyRef(), false));
    fatPtrFields.push(new WasmField("vtable", new ValTypeRef(emptyVTableStruct), false));
    let emptyStruct = new WasmStruct(structName + "_FatPtr", fatPtrFields);
    this.wasm.types.push(emptyStruct);
    this.wasm.interfaceStructs[iKey] = emptyStruct;

    // 2. Discover referenced types in members (fields, methods)
    for (let pair in it.members) {
      let resolvedType = substituteTypeParamsInCodegen(itParams, it.typeArguments, pair.value.type);
      this.discoverType(resolvedType, sourceModel);
    }

    let keys = it.members.keys();
    while (let (true, key) = keys.next()) {
      let member = it.members[key];
      match (member) {
        case FieldInfo as fi: {
          let sig = getInterfaceMemberSignature(this.wasm, it, "get#" + key);
          emptyVTableStruct.fields.push(new WasmField("get#" + key, new ValTypeRef(sig), false));
          if (fi.isMutable) {
            let sigSet = getInterfaceMemberSignature(this.wasm, it, "set#" + key);
            emptyVTableStruct.fields.push(new WasmField("set#" + key, new ValTypeRef(sigSet), false));
          }
        }
        case MethodInfo as mi: {
          var isGeneric = false;
          if (mi.type is FunctionType) {
            let ft = mi.type as FunctionType;
            if (ft.typeParameters != null && (ft.typeParameters as Array<TypeParameterType>).length > 0) {
              isGeneric = true;
            }
          }
          if (!isGeneric) {
            let sig = getInterfaceMemberSignature(this.wasm, it, key);
            emptyVTableStruct.fields.push(new WasmField(key, new ValTypeRef(sig), false));
          }
        }
        case _: {}
      }
    }
    
    this.specializedInterfaces.push(it);
  }

  registerClassMethod(
      cType: ClassType,
      cDecl: Node | null,
      methName: String,
      methodNode: Node | null,
      isSynthesizedGetter: boolean,
      isSynthesizedSetter: boolean,
      backingFieldName: String | null,
      model: SemanticModel): WasmFunction {

    var realMethName = methName;
    var methodTypeNode: Type | null = null;
    if (cType != null) {
      if (methName == "<constructor>") {
        methodTypeNode = cType.constructorType;
      } else {
        var specificFuncType: FunctionType | null = null;
        var hasOverloads = false;
        if (methodNode != null && methodNode is MethodDefinition) {
          if (cType.members.has(methName)) {
            let mInfo = cType.members[methName];
            if (mInfo.type is FunctionType) {
              let ft = mInfo.type as FunctionType;
              if (ft.overloads != null) {
                hasOverloads = true;
                specificFuncType = matchOverload(model, ft, methodNode as MethodDefinition);
              }
            }
          }
        }
        
        if (hasOverloads && specificFuncType != null) {
          methodTypeNode = specificFuncType;
          realMethName = methName + getSignatureKey(specificFuncType as FunctionType);
        } else {
          var baseName = methName;
          var sigKey = "";
          var dollarIdx = -1;
          for (var idx = 0; idx < methName.length; idx += 1) {
            if (methName.getByteAt(idx) == 36) {
              dollarIdx = idx;
              break;
            }
          }
          if (dollarIdx >= 0 && !methName.startsWith("get#") && !methName.startsWith("set#")) {
            baseName = methName.sliceBytes(0, dollarIdx);
            sigKey = methName.sliceBytes(dollarIdx, methName.length);
          }

          var currClass: ClassType | null = cType;
          while (currClass != null && methodTypeNode == null) {
            if (baseName != methName) {
              if (currClass.members.has(baseName)) {
                let mInfo = currClass.members[baseName];
                if (mInfo.type is FunctionType) {
                  let ft = mInfo.type as FunctionType;
                  if (getSignatureKey(ft) == sigKey) {
                    methodTypeNode = ft;
                  } else if (ft.overloads != null) {
                    let ovs = ft.overloads as Array<FunctionType>;
                    for (let ov in ovs) {
                      if (getSignatureKey(ov) == sigKey) {
                        methodTypeNode = ov;
                        break;
                      }
                    }
                  }
                }
              }
            } else {
              if (currClass.members.has(methName)) {
                methodTypeNode = currClass.members[methName].type;
              }
            }
            if (methodTypeNode == null) {
              currClass = currClass.superType;
            }
          }
        }

        if (methodTypeNode == null) {
          if (methName == "==") {
            let eqParams = new Array<Type>();
            eqParams.push(cType);
            methodTypeNode = new FunctionType(eqParams, null, new BooleanType());
          } else if (methName == "hashCode") {
            methodTypeNode = new FunctionType(new Array<Type>(), null, new I32Type());
          } else if (methName.startsWith("get#")) {
            let fieldName = methName.sliceBytes(4, methName.length);
            var pType: Type | null = null;
            if (cType.members.has(fieldName)) {
              let m = cType.members[fieldName];
              if (m is FieldInfo) {
                pType = (m as FieldInfo).type;
              } else if (m is MethodInfo) {
                let mi = m as MethodInfo;
                if (mi.type is FunctionType) {
                  pType = (mi.type as FunctionType).returnType;
                }
              }
            }
            if (pType == null && cType.members.has("#" + fieldName)) {
              let m = cType.members["#" + fieldName];
              if (m is FieldInfo) {
                pType = (m as FieldInfo).type;
              }
            }
            if (pType != null) {
              methodTypeNode = new FunctionType(new Array<Type>(), null, pType as Type);
            }
          } else if (methName.startsWith("set#")) {
            let fieldName = methName.sliceBytes(4, methName.length);
            var pType: Type | null = null;
            if (cType.members.has(fieldName)) {
              let m = cType.members[fieldName];
              if (m is FieldInfo) {
                pType = (m as FieldInfo).type;
              } else if (m is MethodInfo) {
                let mi = m as MethodInfo;
                if (mi.type is FunctionType) {
                  let ft = mi.type as FunctionType;
                  if (ft.parameters.length > 0) {
                    pType = ft.parameters[0];
                  } else {
                    pType = ft.returnType;
                  }
                }
              }
            }
            if (pType == null && cType.members.has("#" + fieldName)) {
              let m = cType.members["#" + fieldName];
              if (m is FieldInfo) {
                pType = (m as FieldInfo).type;
              }
            }
            if (pType != null) {
              let params = new Array<Type>();
              params.push(pType as Type);
              methodTypeNode = new FunctionType(params, null, new VoidType());
            }
          }
        }
      }
    }

    if (methodTypeNode != null && cType != null) {
      methodTypeNode = substituteTypeParamsInCodegen(getClassTypeParameters(cType), cType.typeArguments, methodTypeNode as Type);
    }
    if (methodTypeNode != null) {
      this.discoverType(methodTypeNode as Type, model);
    }

    let params = new Array<ValType>();
    let returns = new Array<ValType>();

    var rootClass = if (methName == "<constructor>") cType else getMemberRootClass(cType, methName);

    var isStatic = false;
    if (methodNode != null) {
      let nodeVal = methodNode as Node;
      if (nodeVal is MethodDefinition) {
        isStatic = (nodeVal as MethodDefinition).isStatic;
      } else if (nodeVal is AccessorDeclaration) {
        isStatic = (nodeVal as AccessorDeclaration).isStatic;
      } else if (nodeVal is FieldDefinition) {
        isStatic = (nodeVal as FieldDefinition).isStatic;
      }
    }

    if (!isStatic) {
      if (cType.isExtension && cType.onType != null) {
        params.push(typeToValType(this.wasm, cType.onType as Type));
      } else {
        if (let (true, rootInfo) = this.wasm.classInfos.get(getClassKey(rootClass))) {
          params.push(new ValTypeRefNull(rootInfo.structType));
        } else {
          params.push(new ValTypeAnyRef());
        }
      }
    }
    if (methodTypeNode is FunctionType) {
      let fType = methodTypeNode as FunctionType;
      for (let p in fType.parameters) {
        params.push(typeToValType(this.wasm, p));
      }
      if (methName != "<constructor>") {
        mapReturnTypeToWasmResults(this.wasm, fType.returnType, returns);
      }
    } else {
      if (methName != "<constructor>") {
        returns.push(new ValTypeI32());
      }
    }
    
    let sig = this.wasm.getSignature(params, returns);
    let wasmFunc = new WasmFunction(sig, methodNode, model);

    var decs: Array<Decorator> | null = null;
    if (methodNode != null) {
      let nodeVal = methodNode as Node;
      if (nodeVal is MethodDefinition) {
        decs = (nodeVal as MethodDefinition).decorators;
      } else if (nodeVal is AccessorDeclaration) {
        decs = (nodeVal as AccessorDeclaration).decorators;
      } else if (nodeVal is FieldDefinition) {
        decs = (nodeVal as FieldDefinition).decorators;
      }
    } else if (backingFieldName != null && cDecl != null) {
      let cDeclVal = cDecl as Node;
      if (cDeclVal is ClassDeclaration) {
        let classDecl = cDeclVal as ClassDeclaration;
        for (let ms in classDecl.body) {
          if (ms is FieldDefinition) {
            let fd = ms as FieldDefinition;
            let fName = match (fd.name) {
              case Identifier {name}: name
              case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                case Identifier {name}: name
                case MemberExpression {property}: property.name
                case _: "<symbol>"
              }
              case _: ""
            };
            if (fName == backingFieldName as String) {
              decs = fd.decorators;
            }
          }
        }
      }
    }
    
    if (decs != null) {
      for (let dec in decs as Array<Decorator>) {
        if (dec.name == "intrinsic" && dec.args.length == 1) {
          wasmFunc.intrinsic = dec.args[0].value;
        }
      }
    }

    wasmFunc.isStatic = isStatic;
    let cName = getClassKey(cType) as String;
    wasmFunc.name = cName + "." + realMethName;
    wasmFunc.methodName = realMethName;
    wasmFunc.classDecl = cDecl;
    
    wasmFunc.classType = cType;
    if (let (true, cInfo) = this.wasm.classInfos.get(getClassKey(cType))) {
      wasmFunc.structType = cInfo.structType;
    }

    if (isSynthesizedGetter && backingFieldName != null) {
      let st = wasmFunc.structType;
      if (st != null) {
        var idx = -1;
        let backingName = backingFieldName as String;
        let lookupBackingName = if (backingName.length > 0 && backingName.sliceBytes(0, 1) == "#") {
          getClassPrivateFieldKey(getClassKey(cType), backingName)
        } else {
          backingName
        };
        for (var fi = 0; fi < (st as WasmStruct).fields.length; fi += 1) {
          if ((st as WasmStruct).fields[fi].name == lookupBackingName) {
            idx = fi;
          }
        }
        wasmFunc.getterStruct = st;
        wasmFunc.getterFieldIndex = idx;
      }
    } else if (isSynthesizedSetter && backingFieldName != null) {
      let st = wasmFunc.structType;
      if (st != null) {
        var idx = -1;
        let backingName = backingFieldName as String;
        let lookupBackingName = if (backingName.length > 0 && backingName.sliceBytes(0, 1) == "#") {
          getClassPrivateFieldKey(getClassKey(cType), backingName)
        } else {
          backingName
        };
        for (var fi = 0; fi < (st as WasmStruct).fields.length; fi += 1) {
          if ((st as WasmStruct).fields[fi].name == lookupBackingName) {
            idx = fi;
          }
        }
        wasmFunc.setterStruct = st;
        wasmFunc.setterFieldIndex = idx;
      }
    }

    let registeredKey = getClassMethodKey(getClassKey(cType), realMethName);
    if (this.wasm.classMethodMap.has(registeredKey)) {
      let func = this.wasm.classMethodMap[registeredKey];
      this.markFunctionReached(func);
      return func;
    }

    let isGenericTemplate = cType != null &&
                            cType.typeParameters != null && 
                            (cType.typeParameters as Array<TypeParameterType>).length > 0 && 
                            (cType.typeArguments == null || !isConcrete(cType));
    if (!isGenericTemplate) {
      this.wasm.addFunction(wasmFunc);
      this.markFunctionReached(wasmFunc);
    }
    this.wasm.classMethodMap[registeredKey] = wasmFunc;
    return wasmFunc;
  }

  populateClassStructAndMethods(ct: ClassType, cd: Node | null, sourceModel: SemanticModel): void {
    let cKey = getClassKey(ct);
    var vstOpt: WasmStruct | null = null;
    var stOpt: WasmStruct | null = null;
    if (let (true, info) = this.wasm.classInfos.get(cKey)) {
      stOpt = info.structType;
      vstOpt = info.vtableStructType;
    }
    if (stOpt == null || vstOpt == null) {
      throw new Error("Class struct or vtable struct not found for class: " + ct.name);
    }
    let st = stOpt as WasmStruct;
    let vst = vstOpt as WasmStruct;
    if (st.fields.length > 0) {
      return;
    }
    
    let vtableSet = new HashSet<String>();
    for (let existing in ct.vtable) {
      vtableSet.add(existing);
    }

    if (ct.superType != null) {
      let superCt = ct.superType as ClassType;
      let superLookupId = (if (superCt.genericSource != null) (superCt.genericSource as ClassType).id else superCt.id) as SymbolId;
      let superDecl: Node | null = if (this.classDecls.has(superLookupId)) this.classDecls[superLookupId] else null;
      let superModel = this.getClassModel(superCt);
      this.populateClassStructAndMethods(superCt, superDecl, superModel);

      for (let methName in superCt.vtable) {
        if (!vtableSet.has(methName)) {
          ct.vtable.push(methName);
          vtableSet.add(methName);
        }
      }
    }

    if (ct.isCaseClass) {
      if (!ct.members.has("==")) {
        let eqParams = new Array<Type>();
        eqParams.push(ct);
        let eqNames = new Array<String>();
        eqNames.push("other");
        ct.members["=="] = new MethodInfo(new FunctionType(eqParams, eqNames, new BooleanType()), false, false, false, false);
      }
      if (!vtableSet.has("==")) {
        ct.vtable.push("==");
        vtableSet.add("==");
      }

      if (!ct.members.has("hashCode")) {
        ct.members["hashCode"] = new MethodInfo(new FunctionType(new Array<Type>(), null, new I32Type()), false, false, false, false);
      }
      if (!vtableSet.has("hashCode")) {
        ct.vtable.push("hashCode");
        vtableSet.add("hashCode");
      }
    }

    let cdDecl = if (cd != null && cd is ClassDeclaration) cd as ClassDeclaration else null;
    if (cdDecl != null) {
      let mixinMembers = new Array<Node>();
      let seenMixins = new HashMap<MixinKey, boolean>();
      collectMixinMembers(this.program, sourceModel, cdDecl.mixins, mixinMembers, seenMixins);

      let allMembers = new Array<Node>();
      for (let ms in cdDecl.body) {
        allMembers.push(ms);
      }
      for (let ms in mixinMembers) {
        allMembers.push(ms);
      }

      for (let ms in allMembers) {
        if (ms is MethodDefinition) {
          let mDef = ms as MethodDefinition;
          if (mDef.isAbstract) { continue; }
          if (mDef.typeParameters != null && (mDef.typeParameters as Array<TypeParameter>).length > 0) {
            continue;
          }
          let methName = match (mDef.name) {
            case Identifier {name}: name
            case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
              case Identifier {name}: name
              case MemberExpression {property}: property.name
              case _: "<symbol>"
            }
            case _: ""
          };
          if (methName != "") {
            var vtableMethName = methName;
            if (ct.members.has(methName)) {
              let mInfo = ct.members[methName];
              if (mInfo.type is FunctionType) {
                let ft = mInfo.type as FunctionType;
                let specificType = matchOverload(sourceModel, ft, mDef);
                if (specificType != null) {
                  vtableMethName = methName + getSignatureKey(specificType as FunctionType);
                }
              }
            }
            
            if (!mDef.isStatic && !vtableSet.has(vtableMethName) && methName != "<constructor>") {
              ct.vtable.push(vtableMethName);
              vtableSet.add(vtableMethName);
            }
            this.registerClassMethod(ct, cdDecl, methName, mDef, false, false, null, sourceModel);
          }
        } else if (ms is AccessorDeclaration) {
          let acc = ms as AccessorDeclaration;
          if (acc.isStatic) { continue; }
          let accName = match (acc.name) {
            case Identifier {name}: name
            case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
              case Identifier {name}: name
              case MemberExpression {property}: property.name
              case _: "<symbol>"
            }
            case _: ""
          };
          if (accName != "") {
             if (acc.getter != null) {
              let getterName = "get#" + accName;
              if (!vtableSet.has(getterName)) {
                ct.vtable.push(getterName);
                vtableSet.add(getterName);
              }
              this.registerClassMethod(ct, cdDecl, getterName, acc as Node, false, false, null, sourceModel);
            }
            if (acc.setter != null) {
              let setterName = "set#" + accName;
              if (!vtableSet.has(setterName)) {
                ct.vtable.push(setterName);
                vtableSet.add(setterName);
              }
              this.registerClassMethod(ct, cdDecl, setterName, acc.setter as Node, false, false, null, sourceModel);
            }
          }
        } else if (ms is FieldDefinition) {
          let fd = ms as FieldDefinition;
          if (fd.isStatic) { continue; }
          let fieldName = match (fd.name) {
            case Identifier {name}: name
            case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
              case Identifier {name}: name
              case MemberExpression {property}: property.name
              case _: "<symbol>"
            }
            case _: ""
          };
          if (fieldName != "") {
            if (!fieldName.startsWith("#")) {
              let getterName = "get#" + fieldName;
              if (!vtableSet.has(getterName)) {
                ct.vtable.push(getterName);
                vtableSet.add(getterName);
              }
              this.registerClassMethod(ct, cdDecl, getterName, null, true, false, fieldName, sourceModel);
              if (fd.mutability != null && fd.mutability == "var") {
                let setterName = "set#" + fieldName;
                if (!vtableSet.has(setterName)) {
                  ct.vtable.push(setterName);
                  vtableSet.add(setterName);
                }
                this.registerClassMethod(ct, cdDecl, setterName, null, false, true, fieldName, sourceModel);
              }
            } else {
              if (fd.setterName != null) {
                let getterName = "get#" + fieldName;
                if (!vtableSet.has(getterName)) {
                  ct.vtable.push(getterName);
                  vtableSet.add(getterName);
                }
              }
              if (fd.isAbstract) {
                let getterName = "get#" + fieldName;
                if (!vtableSet.has(getterName)) {
                  ct.vtable.push(getterName);
                  vtableSet.add(getterName);
                }
                this.registerClassMethod(ct, cdDecl, getterName, null, true, false, fieldName, sourceModel);
                if (fd.mutability != null && fd.mutability == "var") {
                  let setterName = "set#" + fieldName;
                  if (!vtableSet.has(setterName)) {
                    ct.vtable.push(setterName);
                    vtableSet.add(setterName);
                  }
                  this.registerClassMethod(ct, cdDecl, setterName, null, false, true, fieldName, sourceModel);
                }
              }
              if (fd.isDeclare) {
                let getterName = "get#" + fieldName;
                if (!vtableSet.has(getterName)) {
                  ct.vtable.push(getterName);
                  vtableSet.add(getterName);
                }
                this.registerClassMethod(ct, cdDecl, getterName, null, true, false, fieldName, sourceModel);
              }
            }
          }
        }
      }
    }

    if (cdDecl != null || ct.isCaseClass || (cd != null && cd is SealedVariant)) {
      let hasCtor = this.wasm.classMethodMap.has(getClassMethodKey(cKey, "<constructor>"));
      if (!hasCtor) {
        this.registerClassMethod(ct, cd, "<constructor>", null, false, false, null, sourceModel);
      }
      if (ct.isCaseClass) {
        let hasEq = this.wasm.classMethodMap.has(getClassMethodKey(cKey, "=="));
        if (!hasEq) {
          let eqFunc = this.registerClassMethod(ct, cd, "==", null, false, false, null, sourceModel);
          eqFunc.isCaseClassEq = true;
        }
        let hasHash = this.wasm.classMethodMap.has(getClassMethodKey(cKey, "hashCode"));
        if (!hasHash) {
          let hashFunc = this.registerClassMethod(ct, cd, "hashCode", null, false, false, null, sourceModel);
          hashFunc.isCaseClassHash = true;
        }
      }
    }

    if (vst.fields.length == 0) {
      for (let methName in ct.vtable) {
        vst.fields.push(new WasmField(methName, new ValTypeFuncRef(), false));
      }
    }





    let fields = new Array<WasmField>();
    if (ct.superType != null) {
      let superKey = getClassKey(ct.superType as ClassType);
      if (let (true, superInfo) = this.wasm.classInfos.get(superKey)) {
        let superSt = superInfo.structType;
        for (let f in superSt.fields) {
          fields.push(f);
        }
      }
    } else {
      var rootVst = vst;
      while (rootVst.superStruct != null) {
        rootVst = rootVst.superStruct as WasmStruct;
      }
      fields.push(new WasmField("<vtable>", new ValTypeRefNull(rootVst), true));
    }

    let isStaticField = (targetFieldName: String): boolean => {
      if (cd == null) return false;
      let cdDecl = if (cd is ClassDeclaration) cd as ClassDeclaration else null;
      if (cdDecl == null) return false;
      for (let ms in cdDecl.body) {
        if (ms is FieldDefinition) {
          let fd = ms as FieldDefinition;
          let fieldName = match (fd.name) {
            case Identifier {name}: name
            case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
              case Identifier {name}: name
              case MemberExpression {property}: property.name
              case _: "<symbol>"
            }
            case _: ""
          };
          if (fieldName == targetFieldName) {
            return fd.isStatic;
          }
        }
      }
      return false;
    };

    let ctParams = getClassTypeParameters(ct);
    for (let pair in ct.members) {
      if (pair.value is MethodInfo) {
        continue;
      }
      if (pair.value.isAbstract) {
        continue;
      }
      if (isStaticField(pair.key)) {
        continue;
      }
      var isInherited = false;
      if (ct.superType != null) {
        let superKey = getClassKey(ct.superType as ClassType);
        if (let (true, superInfo) = this.wasm.classInfos.get(superKey)) {
          let superSt = superInfo.structType;
          for (let sf in superSt.fields) {
            if (sf.name == pair.key) {
              isInherited = true;
            }
          }
        }
      }
      if (!isInherited) {
        let fName = if (pair.key.length > 0 && pair.key.sliceBytes(0, 1) == "#") {
          getClassPrivateFieldKey(cKey, pair.key)
        } else {
          pair.key
        };
        let resolvedType = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, pair.value.type);
        fields.push(new WasmField(fName, typeToValType(this.wasm, resolvedType), true));
      }
    }
    for (let f in fields) {
      st.fields.push(f);
    }
  }

  getModelPath(model: SemanticModel): String {
    for (let unit in this.program.units) {
      if (unit.model == model) {
        return unit.ast.path;
      }
    }
    return "unknown-model";
  }

  getNodeModel(node: Node, defaultModel: SemanticModel): SemanticModel {
    let id = node.id as i32;
    if (this.nodeIdToModel.has(id)) {
      return this.nodeIdToModel[id];
    }
    return defaultModel;
  }

  getClassModel(ct: ClassType): SemanticModel {
    var curr: ClassType | null = ct;
    while (curr != null) {
      let lookupId = (if ((curr as ClassType).genericSource != null) ((curr as ClassType).genericSource as ClassType).id else (curr as ClassType).id) as SymbolId;
      if (this.classModels.has(lookupId)) {
        return this.classModels[lookupId];
      }
      curr = (curr as ClassType).superType;
    }
    return this.program.units[0].model;
  }

  getClassDeclType(classDecl: Node, model: SemanticModel): ClassType | null {
    if (this.#classDeclTypeCache.has(classDecl.id as i32)) {
      return this.#classDeclTypeCache[classDecl.id as i32];
    }
    let raw = model.getNodeType(classDecl);
    if (raw != null && raw is ClassType) {
      let ct = raw as ClassType;
      this.#classDeclTypeCache[classDecl.id as i32] = ct;
      return ct;
    }
    var sym = model.resolve(classDecl);
    if (sym == null && classDecl.loc != null) {
      sym = model.resolveByOffset((classDecl.loc as SourceLocation).start);
    }
    if (sym != null) {
      let bType = model.getBindingTypeDirect(sym);
      if (bType != null && bType is ClassType) {
        let ct = bType as ClassType;
        this.#classDeclTypeCache[classDecl.id as i32] = ct;
        return ct;
      }
    }
    return null;
  }

  findPreludeClass(name: String): ClassType | null {
    for (let unit in this.program.units) {
      let model = unit.model;
      let t = model.getExportType(name);
      if (t != null && t is ClassType) {
        return t as ClassType;
      }
    }
    return null;
  }

  findPreludeInterface(name: String): InterfaceType | null {
    for (let unit in this.program.units) {
      let model = unit.model;
      let t = model.getExportType(name);
      if (t != null && t is InterfaceType) {
        return t as InterfaceType;
      }
    }
    return null;
  }

  findInstantiatedSubclasses(baseType: ClassType): Array<ClassType> {
    if (this.lastSubclassCacheVersion != this.instantiatedSpecializedClasses.size) {
      this.#subclassCache.clear();
      this.lastSubclassCacheVersion = this.instantiatedSpecializedClasses.size;
    }
    let baseSymId = baseType.id as SymbolId;
    if (let (true, cachedList) = this.#subclassCache.get(baseSymId)) {
      return cachedList;
    }

    let list = new Array<ClassType>();
    let keys = this.wasm.classInfos.keys();
    while (let (true, k) = keys.next()) {
      let info = this.wasm.classInfos[k];
      let ct = info.structType.classType;
      if (ct != null) {
        let classType = ct as ClassType;
        if (this.isSubclassOf(classType, baseType)) {
          list.push(classType);
        }
      }
    }
    this.#subclassCache[baseSymId] = list;
    return list;
  }

  collectAllImplementedInterfaces(ct: ClassType): Array<InterfaceType> {
    let list = new Array<InterfaceType>();
    let seen = new HashMap<InterfaceKey, boolean>();
    
    let ctParams = getClassTypeParameters(ct);
    for (let iface in ct.implementsList) {
      let resolved = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, iface) as InterfaceType;
      this.#addInterfaceToTransitiveList(resolved, list, seen);
    }
    
    var curr = ct.superType;
    while (curr != null) {
      let superCt = curr as ClassType;
      let superCtParams = getClassTypeParameters(superCt);
      for (let iface in superCt.implementsList) {
        let resolved = substituteTypeParamsInCodegen(superCtParams, superCt.typeArguments, iface) as InterfaceType;
        this.#addInterfaceToTransitiveList(resolved, list, seen);
      }
      curr = superCt.superType;
    }
    
    return list;
  }

  #addInterfaceToTransitiveList(it: InterfaceType, list: Array<InterfaceType>, seen: HashMap<InterfaceKey, boolean>): void {
    let key = getInterfaceKey(it);
    if (!seen.has(key)) {
      seen[key] = true;
      list.push(it);
      for (let ext in it.extendsList) {
        let resolvedExt = substituteTypeParamsInCodegen(getInterfaceTypeParameters(it), it.typeArguments, ext) as InterfaceType;
        this.#addInterfaceToTransitiveList(resolvedExt, list, seen);
      }
    }
  }

  discoverNodeTypes(root: Node, model: SemanticModel, resolveType: (t: Type) => Type): void {
    walkEnter(root, (n: Node) => {
      let t = model.getNodeType(n);
      if (t != null) {
        this.discoverType(resolveType(t), model);
      }
      if (n is NewExpression) {
        let ne = n as NewExpression;
        let neType = model.getNodeType(ne);
        if (neType != null && neType is ClassType) {
          let resolved = resolveType(neType as ClassType) as ClassType;
          this.instantiateClassType(resolved, model);
        }
      }
      if (n is RangeExpression) {
        let re = n as RangeExpression;
        let reType = model.getNodeType(re);
        if (reType != null && reType is ClassType) {
          this.instantiateClassType(resolveType(reType as ClassType) as ClassType, model);
        }
      }
      if (n is Expression) {
        let expr = n as Expression;
        let adaptation = model.getRecordAdaptation(expr);
        if (adaptation != null) {
          this.discoverType(resolveType(adaptation.target), model);
          
          let inFields = new Array<WasmField>();
          for (let pair in adaptation.source.properties) {
            inFields.push(new WasmField(pair.key, typeToValType(this.wasm, resolveType(pair.value)), false));
          }
          let outFields = new Array<WasmField>();
          for (let pair in adaptation.target.properties) {
            outFields.push(new WasmField(pair.key, typeToValType(this.wasm, resolveType(pair.value)), false));
          }
          this.wasm.getAdaptedRecordDispatch(model, inFields, outFields);
        }
        
        let ifaceAdaptation = model.getInterfaceAdaptation(expr);
        if (ifaceAdaptation != null) {
          let adapt = ifaceAdaptation as InterfaceAdaptation;
          let cName = getClassKey(resolveType(adapt.source) as ClassType);
          let iName = getInterfaceKey(resolveType(adapt.target) as InterfaceType);
          this.wasm.usedInterfaceAdaptations[getClassInterfaceKey(cName, iName)] = true;
          
          let unspecCName = getClassKey((resolveType(adapt.source) as ClassType).genericSource ?? (resolveType(adapt.source) as ClassType));
          let unspecIName = getInterfaceKey((resolveType(adapt.target) as InterfaceType).genericSource ?? (resolveType(adapt.target) as InterfaceType));
          let unspecKey = getClassInterfaceKey(unspecCName, unspecIName);
          this.wasm.usedInterfaceAdaptations[unspecKey] = true;
        }
      }
      if (n is TemplateElement) {
        let tmplEl = n as TemplateElement;
        this.wasm.getStringLiteralDataIndex(tmplEl.cooked);
      }
      if (n is TaggedTemplateExpression) {
        let expr = n as TaggedTemplateExpression;
        if (!this.wasm.templateLiteralGlobals.has(expr)) {
          var tsaStruct: WasmStruct | null = null;
          let tsaClass = this.wasm.templateStringsArrayClass;
          if (tsaClass != null) {
            let key = getClassKey(tsaClass as ClassType);
            if (let (true, tsaInfo) = this.wasm.classInfos.get(key)) {
              tsaStruct = tsaInfo.structType;
            }
          }
          if (tsaStruct == null) {
            throw new Error("TemplateStringsArray class struct not found during tagged template literal discovery!");
          }
          
          let globalName = "tsa_cache_" + i32ToString(expr.id as i32);
          let globalType = new ValTypeRefNull(tsaStruct);
          let g = new WasmGlobal(
            globalName,
            globalName,
            globalType,
            true, // isMutable
            null, // initExpr
            null, // initVTable
            model
          );
          this.wasm.globals.push(g);
          this.wasm.templateLiteralGlobals[expr] = g;
        }
      }
      if (n is ForInStatement) {
        let forIn = n as ForInStatement;
        let iterableType = model.getNodeType(forIn.iterable);
        if (iterableType != null) {
          let resolvedIterable = resolveType(iterableType as Type);
          
          if (resolvedIterable is InterfaceType) {
            let it = resolvedIterable as InterfaceType;
            let iName = getInterfaceKey(it.genericSource ?? it);
            this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, ":iterator")] = true;
          }
          
          let resolvedIterableTypes = new Array<ClassType>();
          if (resolvedIterable is ClassType) {
            let ct = resolvedIterable as ClassType;
            if (ct.name.length >= 5 && ct.name.sliceBytes(ct.name.length - 5, ct.name.length) == "_This") {
              // Find enclosing mixin declaration
              var enclosingMixinDecl: MixinDeclaration | null = null;
              var curr = forIn as Node;
              while (true) {
                let parent = model.getParent(curr);
                if (parent == null) { break; }
                if (parent is MixinDeclaration) {
                  enclosingMixinDecl = parent as MixinDeclaration;
                  break;
                }
                curr = parent;
              }
              if (enclosingMixinDecl != null) {
                var mixinSym = model.resolve(enclosingMixinDecl.name);
                if (mixinSym == null) {
                  mixinSym = model.resolve(enclosingMixinDecl);
                }
                if (mixinSym != null) {
                  let mixKey = getMixinKeyFromSymbol(model, mixinSym as Symbol);
                  if (this.mixinToClasses.has(mixKey)) {
                    let classes = this.mixinToClasses[mixKey];
                    for (let cType in classes) {
                      resolvedIterableTypes.push(cType);
                    }
                  }
                }
              }
            } else {
              resolvedIterableTypes.push(ct);
            }
          } else if (resolvedIterable is ThisType) {
            // Find enclosing ClassDeclaration or MixinDeclaration
            var enclosingClassDecl: ClassDeclaration | null = null;
            var enclosingMixinDecl: MixinDeclaration | null = null;
            var curr = forIn as Node;
            while (true) {
              let parent = model.getParent(curr);
              if (parent == null) { break; }
              if (parent is ClassDeclaration) {
                enclosingClassDecl = parent as ClassDeclaration;
                break;
              }
              if (parent is MixinDeclaration) {
                enclosingMixinDecl = parent as MixinDeclaration;
                break;
              }
              curr = parent;
            }
            if (enclosingClassDecl != null) {
              let ct = this.getClassDeclType(enclosingClassDecl as ClassDeclaration, model);
              if (ct != null) {
                resolvedIterableTypes.push(ct as ClassType);
              }
            } else if (enclosingMixinDecl != null) {
              var mixinSym = model.resolve((enclosingMixinDecl as MixinDeclaration).name);
              if (mixinSym == null) {
                mixinSym = model.resolve(enclosingMixinDecl as MixinDeclaration);
              }
              if (mixinSym != null) {
                let mixKey = getMixinKeyFromSymbol(model, mixinSym as Symbol);
                if (this.mixinToClasses.has(mixKey)) {
                  let classes = this.mixinToClasses[mixKey];
                  for (let cType in classes) {
                    resolvedIterableTypes.push(cType);
                  }
                }
              }
            }
          } else if (resolvedIterable is ArrayType) {
            let faClass = this.findPreludeClass("FixedArray");
            if (faClass != null) {
              let arrType = resolvedIterable as ArrayType;
              let typeArgs = new Array<Type>();
              typeArgs.push(arrType.elementType);
              let instantiated = instantiateClassType(faClass as ClassType, typeArgs);
              resolvedIterableTypes.push(instantiated);
              this.discoverType(instantiated, model);
            }
          }

          let iterableIface = this.findPreludeInterface("Iterable");
          let iteratorIface = this.findPreludeInterface("Iterator");

          if (iterableIface != null) {
            let iterableKey = getInterfaceKey(iterableIface as InterfaceType);
            let itKey = getInterfaceMemberKey(iterableKey, ":iterator");
            this.wasm.usedInterfaceMembers[itKey] = true;
            
            let resolvedIfaceStr = i32ToString((iterableIface.genericSource ?? iterableIface).id) + ".:iterator";
            this.addReferencedInterfaceMember(resolvedIfaceStr);

            for (let resolvedClass in resolvedIterableTypes) {
              let cName = getClassKey(resolvedClass);
              this.wasm.usedInterfaceAdaptations[getClassInterfaceKey(cName, iterableKey)] = true;
              
              let unspecCName = getClassKey(resolvedClass.genericSource ?? resolvedClass);
              let unspecKey = getClassInterfaceKey(unspecCName, iterableKey);
              this.wasm.usedInterfaceAdaptations[unspecKey] = true;

              let targetModel = this.getClassModel(resolvedClass);
              let mds = this.findImplementingMethods(resolvedClass, ":iterator");
              for (let md in mds) {
                this.queueReferrer(new Referrer(false, -1 as SymbolId, (md as Node).id as i32, this.getNodeModel(md as Node, targetModel), resolvedClass, this.currentReachable));
              }
            }
          }

          if (iteratorIface != null) {
            let iteratorKey = getInterfaceKey(iteratorIface as InterfaceType);
            let nextKey = getInterfaceMemberKey(iteratorKey, "next");
            this.wasm.usedInterfaceMembers[nextKey] = true;
            
            let resolvedIfaceStr = i32ToString((iteratorIface.genericSource ?? iteratorIface).id) + ".next";
            this.addReferencedInterfaceMember(resolvedIfaceStr);
          }
        }
      }
      if (n is MemberExpression) {
        let mem = n as MemberExpression;
        let objType = model.getNodeType(mem.object);
        if (objType != null) {
          let resolvedObj = resolveType(objType as Type);
          let propName = if (mem.isSymbolAccess) ":" + mem.property.name else mem.property.name;
          
          if (resolvedObj is InterfaceType) {
            let it = resolvedObj as InterfaceType;
            let iName = getInterfaceKey(it.genericSource ?? it);
            
            var isMethod = false;
            if (it.members.has(propName)) {
              let mi = it.members[propName];
              if (mi is MethodInfo) {
                isMethod = true;
              }
            }
            
            let resolvedName = if (isMethod) propName else "get#" + propName;
            this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, resolvedName)] = true;
            let resolvedIfaceStr = i32ToString((it.genericSource ?? it).id) + "." + resolvedName;
            this.addReferencedInterfaceMember(resolvedIfaceStr);
          } else if (resolvedObj is ClassType) {
            let ct = resolvedObj as ClassType;
            let targetModel = this.getClassModel(ct);
            
            var isMethod = false;
            if (ct.members.has(propName)) {
              let mi = ct.members[propName];
              if (mi is MethodInfo) {
                isMethod = true;
              }
            }
            
            let resolvedName = if (isMethod) propName else "get#" + propName;
            let mds = this.findImplementingMethods(ct, resolvedName);
            for (let md in mds) {
              this.queueReferrer(new Referrer(false, -1 as SymbolId, (md as Node).id as i32, this.getNodeModel(md as Node, targetModel), ct, this.currentReachable));
            }
            if (!isMethod) {
              let fd = this.findImplementingField(ct, propName);
              if (fd != null) {
                this.queueReferrer(new Referrer(false, -1 as SymbolId, (fd as Node).id as i32, this.getNodeModel(fd as Node, targetModel), ct, this.currentReachable));
              }
              let acc = this.findImplementingAccessor(ct, resolvedName);
              if (acc != null) {
                this.queueReferrer(new Referrer(false, -1 as SymbolId, (acc as Node).id as i32, this.getNodeModel(acc as Node, targetModel), ct, this.currentReachable));
              }
            }
          }
        }
      }
      if (n is IndexExpression) {
        let idxExpr = n as IndexExpression;
        let objType = model.getNodeType(idxExpr.object);
        if (objType != null) {
          let resolvedObj = resolveType(objType as Type);
          if (resolvedObj is InterfaceType) {
            let it = resolvedObj as InterfaceType;
            let iName = getInterfaceKey(it.genericSource ?? it);
            let targetName = "[]";
            if (it.members.has(targetName)) {
              this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, "[]")] = true;
              let resolvedIfaceStr = i32ToString((it.genericSource ?? it).id) + ".[]";
              this.addReferencedInterfaceMember(resolvedIfaceStr);
            }
          }
        }
      }
      if (n is AssignmentExpression) {
        let assign = n as AssignmentExpression;
        if (assign.left is MemberExpression) {
          let mem = assign.left as MemberExpression;
          let objType = model.getNodeType(mem.object);
          if (objType != null) {
            let resolvedObj = resolveType(objType as Type);
            if (resolvedObj is InterfaceType) {
              let it = resolvedObj as InterfaceType;
              let iName = getInterfaceKey(it.genericSource ?? it);
              let propName = if (mem.isSymbolAccess) ":" + mem.property.name else mem.property.name;
              let setterName = "set#" + propName;
              if (it.members.has(propName)) {
                let member = it.members[propName];
                if (member is FieldInfo) {
                  let fi = member as FieldInfo;
                  if (fi.isMutable) {
                    this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, "set#" + propName)] = true;
                    let resolvedIfaceStr = i32ToString((it.genericSource ?? it).id) + ".set#" + propName;
                    this.addReferencedInterfaceMember(resolvedIfaceStr);
                  }
                }
              }
              if (it.members.has(setterName)) {
                this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, setterName)] = true;
                let resolvedIfaceStr = i32ToString((it.genericSource ?? it).id) + "." + setterName;
                this.addReferencedInterfaceMember(resolvedIfaceStr);
              }
            }
          }
        } else if (assign.left is IndexExpression) {
          let idxExpr = assign.left as IndexExpression;
          let objType = model.getNodeType(idxExpr.object);
          if (objType != null) {
            let resolvedObj = resolveType(objType as Type);
            if (resolvedObj is InterfaceType) {
              let it = resolvedObj as InterfaceType;
              let iName = getInterfaceKey(it.genericSource ?? it);
              let targetName = "[]=";
              if (it.members.has(targetName)) {
                this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, "[]=")] = true;
                let resolvedIfaceStr = i32ToString((it.genericSource ?? it).id) + ".[]=";
                this.addReferencedInterfaceMember(resolvedIfaceStr);
              }
            }
          }
        }
      }
      if (n is Identifier) {
        let parentNode = model.getParent(n);
        var isCallee = false;
        if (parentNode != null && parentNode is CallExpression) {
          let call = parentNode as CallExpression;
          if (call.callee == n) {
            isCallee = true;
          }
        }
        
        let rawNodeType = model.getNodeType(n);
        if (rawNodeType != null) {
          let nodeType = resolveType(rawNodeType);
          if (isCallee) {
            if (nodeType is FunctionType) {
              let ft = nodeType as FunctionType;
              let sym = model.resolve(n as Identifier);
              if (sym != null) {
                let symVal = sym as Symbol;
                var targetSymId = symVal.id;
                if (symVal.declaration != null && symVal.declaration is ImportSpecifier) {
                  targetSymId = resolveImportedSymbolId(this.program, model, symVal.declaration as ImportSpecifier);
                }
                var resolvedArgs = new Array<Type>();
                if (ft.typeArguments != null) {
                  for (let arg in (ft.typeArguments as Array<Type>)) {
                    resolvedArgs.push(arg);
                  }
                }
                let isSpecialized = resolvedArgs.length > 0;
                if (isSpecialized && targetSymId != (-1 as SymbolId) && this.wasm.genericFunctions.has(targetSymId)) {
                  this.instantiateGenericFunction(targetSymId, resolvedArgs);
                }
              }
            }
          } else {
            this.discoverIdentifierReferenceAsValue(n as Identifier, model, nodeType);
          }
        }
      }
    });
  }

  discoverIdentifierReferenceAsValue(ident: Identifier, model: SemanticModel, nodeType: Type): void {
    if (!(nodeType is FunctionType)) {
      return;
    }
    let ft = nodeType as FunctionType;
    let sym = model.resolve(ident);
    if (sym == null) {
      return;
    }
    let symVal = sym as Symbol;
    var targetSymId = symVal.id;
    if (symVal.declaration != null && symVal.declaration is ImportSpecifier) {
      targetSymId = resolveImportedSymbolId(this.program, model, symVal.declaration as ImportSpecifier);
    }
    var resolvedArgs = new Array<Type>();
    if (ft.typeArguments != null) {
      for (let arg in (ft.typeArguments as Array<Type>)) {
        resolvedArgs.push(arg);
      }
    }
    let isSpecialized = resolvedArgs.length > 0;
    if (isSpecialized && targetSymId != (-1 as SymbolId) && this.wasm.genericFunctions.has(targetSymId)) {
      this.instantiateGenericFunction(targetSymId, resolvedArgs);
    }
    
    var targetWasmFunc: WasmFunction | null = null;
    var keyName = "";
    if (isSpecialized) {
      let specKey = getSpecializedFunctionKey(ident.name, resolvedArgs);
      keyName = specKey as String;
      if (this.wasm.specializedFunctions.has(specKey)) {
        targetWasmFunc = this.wasm.specializedFunctions[specKey];
      }
    } else {
      keyName = i32ToString(symVal.id as i32);
      if (this.wasm.functionMap.has(targetSymId)) {
        targetWasmFunc = this.wasm.functionMap[targetSymId];
      }
    }
    if (targetWasmFunc != null) {
      this.registerWrapper(keyName, ft, targetWasmFunc as WasmFunction, model);
      
      if (ft.typeArguments != null && (ft.typeArguments as Array<Type>).length > 0) {
        let erasedArgs = new Array<Type>();
        for (let arg in (ft.typeArguments as Array<Type>)) {
          erasedArgs.push(eraseType(arg));
        }
        let erasedFt = eraseType(ft) as FunctionType;
        let erasedSpecKey = getSpecializedFunctionKey(ident.name, erasedArgs);
        
        var erasedTargetWasmFunc: WasmFunction | null = null;
        if (this.wasm.specializedFunctions.has(erasedSpecKey)) {
          erasedTargetWasmFunc = this.wasm.specializedFunctions[erasedSpecKey];
        } else if (targetSymId != (-1 as SymbolId) && this.wasm.genericFunctions.has(targetSymId)) {
          erasedTargetWasmFunc = this.instantiateGenericFunction(targetSymId, erasedArgs);
        }
        
        if (erasedTargetWasmFunc != null) {
          this.registerWrapper(erasedSpecKey as String, erasedFt, erasedTargetWasmFunc as WasmFunction, model);
        }
      }
    }
  }

  registerWrapper(keyName: String, ft: FunctionType, targetWasmFunc: WasmFunction, model: SemanticModel): void {
    let wrapperParams = new Array<ValType>();
    wrapperParams.push(new ValTypeStructRef());
    for (let p in ft.parameters) {
      wrapperParams.push(typeToValType(this.wasm, p));
    }
    let wrapperReturns = new Array<ValType>();
    if (!(ft.returnType is VoidType)) {
      wrapperReturns.push(typeToValType(this.wasm, ft.returnType));
    }
    let sig = this.wasm.getSignature(wrapperParams, wrapperReturns);
    
    let wrapperKey = getFunctionValueWrapperKey(keyName, ft);
    this.markFunctionReached(targetWasmFunc);
    if (!this.wasm.functionValueWrappers.has(wrapperKey)) {
      let wrapperFunc = new WasmFunction(sig, null, model);
      let targetName = if (targetWasmFunc.name != null) targetWasmFunc.name as String else "func";
      wrapperFunc.name = targetName + "_valwrapper_" + getSignatureKey(ft);
      wrapperFunc.isClosureWrapper = true;
      wrapperFunc.closureWrapperTarget = targetWasmFunc;
      wrapperFunc.isReferenceTaken = true;
      
      this.wasm.functionValueWrappers[wrapperKey] = wrapperFunc;
      this.wasm.addFunction(wrapperFunc);
      this.markFunctionReached(wrapperFunc);
      
      getClosureStruct(this.wasm, ft);
    }
  }

  instantiateGenericFunction(symId: SymbolId, typeArgs: Array<Type>): WasmFunction {
    let funcExpr = this.wasm.genericFunctions[symId];
    let model = this.wasm.genericFunctionModels[symId];
    
    // Determine target name
    var originalName = "";
    let parentNode = model.getParent(funcExpr);
    if (parentNode != null && parentNode is VariableDeclaration) {
      let varDecl = parentNode as VariableDeclaration;
      if (varDecl.pattern is IdentifierPattern) {
        originalName = (varDecl.pattern as IdentifierPattern).name;
      }
    }
    if (originalName == "") {
      originalName = "generic_func";
    }
    
    let specKey = getSpecializedFunctionKey(originalName, typeArgs);
    let specName = specKey as String;
    if (this.wasm.specializedFunctions.has(specKey)) {
      let func = this.wasm.specializedFunctions[specKey];
      this.markFunctionReached(func);
      return func;
    }
    
    // Resolve the original generic FunctionType
    let funcTypeNode = model.getNodeType(funcExpr) as FunctionType;
    let typeParams = funcTypeNode.typeParameters as Array<TypeParameterType>;
    
    // Substitute typeParams with typeArgs in the function signature
    let concreteParams = new Array<ValType>();
    let concreteReturns = new Array<ValType>();
    
    for (let p in funcTypeNode.parameters) {
      let subType = substituteTypeParamsInCodegen(typeParams, typeArgs, p);
      concreteParams.push(typeToValType(this.wasm, subType));
    }
    
    let subReturn = substituteTypeParamsInCodegen(typeParams, typeArgs, funcTypeNode.returnType);
    mapReturnTypeToWasmResults(this.wasm, subReturn, concreteReturns);
    
    let sig = this.wasm.getSignature(concreteParams, concreteReturns);
    let wasmFunc = new WasmFunction(sig, funcExpr, model);
    
    // Track type parameters and arguments for codegen context
    wasmFunc.typeParameters = typeParams;
    wasmFunc.typeArguments = typeArgs;
    wasmFunc.name = specName;
    
    // Register it
    this.wasm.specializedFunctions[specKey] = wasmFunc;
    this.wasm.addFunction(wasmFunc);
    this.markFunctionReached(wasmFunc);
    
    return wasmFunc;
  }

  discoverVariableDeclaration(symId: SymbolId, varDecl: VariableDeclaration, moduleModel: SemanticModel): void {
    let varType = moduleModel.getNodeType(varDecl);
    if (varType != null) {
      this.discoverType(varType, moduleModel);
    }
    if (varDecl.init != null) {
      let initType = moduleModel.getNodeType(varDecl.init);
      if (initType != null) {
        this.discoverType(initType, moduleModel);
      }
    }

    if (varDecl.init is FunctionExpression) {
      let funcExpr = varDecl.init as FunctionExpression;
      let funcTypeNode = moduleModel.getNodeType(funcExpr);
      var isGeneric = false;
      if (funcTypeNode is FunctionType) {
        let fType = funcTypeNode as FunctionType;
        if (fType.typeParameters != null && (fType.typeParameters as Array<TypeParameterType>).length > 0) {
          isGeneric = true;
        }
      }
      
      if (isGeneric) {
        if (varDecl.pattern is IdentifierPattern) {
          let ident = varDecl.pattern as IdentifierPattern;
          let sym = moduleModel.resolveDeclaration(ident);
          if (sym != null) {
            this.wasm.genericFunctions[sym.id] = funcExpr;
            this.wasm.genericFunctionModels[sym.id] = moduleModel;
          }
        }
      } else {
        if (varDecl.pattern is IdentifierPattern) {
          let ident = varDecl.pattern as IdentifierPattern;
          let sym = moduleModel.resolveDeclaration(ident);
          if (sym != null && this.wasm.functionMap.has(sym.id)) {
            let existingFunc = this.wasm.functionMap[sym.id];
            if (this.currentReachable) {
              this.markFunctionReached(existingFunc);
            }
            return;
          }
        }

        let params = new Array<ValType>();
        let returns = new Array<ValType>();
        
        if (funcTypeNode is FunctionType) {
          let fType = funcTypeNode as FunctionType;
          for (let p in fType.parameters) {
            params.push(typeToValType(this.wasm, p));
          }
          mapReturnTypeToWasmResults(this.wasm, fType.returnType, returns);
        } else {
          returns.push(new ValTypeI32());
        }
        
        let sig = this.wasm.getSignature(params, returns);
        let wasmFunc = new WasmFunction(sig, funcExpr, moduleModel);
        this.wasm.addFunction(wasmFunc);
        
        if (varDecl.pattern is IdentifierPattern) {
          let ident = varDecl.pattern as IdentifierPattern;
          wasmFunc.name = ident.name;
          let sym = moduleModel.resolveDeclaration(ident);
          if (sym != null) {
            this.wasm.functionMap[sym.id] = wasmFunc;
            if (varDecl.exported) {
              this.wasm.exportMap[ident.name as ExportKey] = wasmFunc;
            }
            if (this.currentReachable) {
              this.markFunctionReached(wasmFunc);
            }
          }
          if (varDecl.pattern is IdentifierPattern) {
            let name = (varDecl.pattern as IdentifierPattern).name;
            if (name == "i32ToString") { this.wasm.i32ToStringFunc = wasmFunc; }
            else if (name == "u32ToString") { this.wasm.u32ToStringFunc = wasmFunc; }
            else if (name == "i64ToString") { this.wasm.i64ToStringFunc = wasmFunc; }
            else if (name == "u64ToString") { this.wasm.u64ToStringFunc = wasmFunc; }
            else if (name == "f32ToString") { this.wasm.f32ToStringFunc = wasmFunc; }
            else if (name == "f64ToString") { this.wasm.f64ToStringFunc = wasmFunc; }
            else if (name == "boolToString") { this.wasm.boolToStringFunc = wasmFunc; }
          }
        }
      }
    } else {
      // Global Variable
      if (varDecl.pattern is IdentifierPattern && varDecl.init != null) {
        let ident = varDecl.pattern as IdentifierPattern;
        let expr = varDecl.init;
        let nodeType = moduleModel.getNodeType(ident);
        var isMutable = true;
        
        var vType = typeToValType(this.wasm, nodeType);

        let sym = moduleModel.resolveDeclaration(ident);
        if (sym != null) {
          let name = ident.name + "_" + i32ToString(sym.id as i32);
          let wasmGlobal = new WasmGlobal(name, ident.name, vType, isMutable, expr, null, moduleModel);
          this.wasm.globals.push(wasmGlobal);
          this.wasm.globalMap[sym.id] = wasmGlobal;
          
          if (varDecl.exported) {
            this.wasm.exportGlobalMap[ident.name as ExportGlobalKey] = wasmGlobal;
          }
        }
      }
    }
  }

  discoverImportDeclaration(importDecl: ImportDeclaration, moduleModel: SemanticModel): void {
    for (let spec in importDecl.imports) {
      if (spec.imported.name == "*") {
        let localIdent = spec.local;
        let sym = moduleModel.resolveDeclaration(spec as Node);
        if (sym != null) {
          let nodeType = moduleModel.getBindingType(sym as Symbol);
          if (nodeType != null) {
            this.discoverType(nodeType as Type, moduleModel);
            let vType = typeToValType(this.wasm, nodeType as Type);
            let name = localIdent.name + "_" + i32ToString(sym.id as i32);
            
            let wasmGlobal = new WasmGlobal(name, localIdent.name, vType, true, null, null, moduleModel);
            wasmGlobal.namespaceImport = spec;
            this.wasm.globals.push(wasmGlobal);
            this.wasm.globalMap[sym.id] = wasmGlobal;

            // Mark exported functions in target module as reference taken so they are emitted in Wasm element section
            let parentNode = moduleModel.getParent(spec);
            if (parentNode != null && parentNode is ImportDeclaration) {
              let parentImport = parentNode as ImportDeclaration;
              let specifier = parentImport.moduleSpecifier.value;
              var canonicalPath = specifier;
              if (specifier.startsWith("./") || specifier.startsWith("../")) {
                let referrer = moduleModel.getParent(parentImport);
                if (referrer != null && referrer is Module) {
                  let mod = referrer as Module;
                  let dir = dirName(mod.path);
                  canonicalPath = normalizePath(dir + "/" + specifier);
                }
              }
              
              let prog = this.wasm.program as Program;
              let hasInMap = prog.unitsByPath.has(canonicalPath);

              if (prog.unitsByPath.has(canonicalPath)) {
                let targetUnit = prog.unitsByPath[canonicalPath];
                let exports = new HashMap<String, Symbol>();
                collectValueExports(prog, targetUnit, exports);
                
                for (let key in exports.keys()) {
                  if (let (true, exportSym) = exports.get(key)) {
                    if (this.wasm.functionMap.has(exportSym.id)) {
                      let f = this.wasm.functionMap[exportSym.id];
                      f.isReferenceTaken = true;
                      if (f.closureTrampoline == null) {
                        let tParams = new Array<ValType>();
                        tParams.push(new ValTypeStructRef());
                        for (let p in f.signature.params) {
                          tParams.push(p);
                        }
                        let tSig = this.wasm.getSignature(tParams, f.signature.returns);
                        let trampoline = new WasmFunction(tSig, null, f.model);
                        let fName = if (f.name != null) (f.name as String) else "anonymous";
                        trampoline.name = fName + "$trampoline";
                        trampoline.isClosureTrampoline = true;
                        trampoline.closureTrampolineTarget = f;
                        trampoline.isReferenceTaken = true;
                        f.closureTrampoline = trampoline;
                        this.wasm.addFunction(trampoline);
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  discoverDeclareFunction(decl: DeclareFunction, moduleModel: SemanticModel): void {
    let sym = moduleModel.resolveDeclaration(decl);
    if (sym == null) {
      return;
    }

    if (this.wasm.functionMap.has(sym.id)) {
      let existingFunc = this.wasm.functionMap[sym.id];
      if (this.currentReachable) {
        this.markFunctionReached(existingFunc);
      }
      return;
    }

    var isIntrinsic = false;
    var intrinsicName = "";
    var isExternal = false;
    var externalModule = "";
    var externalName = "";
    for (let dec in decl.decorators) {
      if (dec.name == "intrinsic") {
        if (dec.args.length == 1) {
          intrinsicName = dec.args[0].value;
          isIntrinsic = true;
        } else {
          throw new Error("Intrinsic decorator must have exactly one argument");
        }
      } else if (dec.name == "external") {
        if (dec.args.length == 2) {
          externalModule = dec.args[0].value;
          externalName = dec.args[1].value;
          isExternal = true;
        } else {
          throw new Error("External decorator must have exactly two arguments");
        }
      }
    }

    if (isIntrinsic) {
      var targetUnit: CompilationUnit | null = null;
      for (let u in this.program.units) {
        if (u.model == moduleModel) {
          targetUnit = u;
        }
      }
      if (targetUnit != null) {
        let unitNode = targetUnit as CompilationUnit;
        for (let stmt in unitNode.ast.body) {
          match (stmt) {
            case DeclareFunction as df: {
              if (df.name.name == decl.name.name) {
                var dfIntrinsicName = "";
                for (let dec in df.decorators) {
                  if (dec.name == "intrinsic" && dec.args.length == 1) {
                    dfIntrinsicName = dec.args[0].value;
                  }
                }
                if (dfIntrinsicName != "") {
                  this.wasm.intrinsics[df.id] = dfIntrinsicName;
                  if (dfIntrinsicName == "wasi_write_string") {
                    this.registerWasiInfra(moduleModel);
                  } else if (dfIntrinsicName == "hash") {
                    this.registerStringHashHelper(moduleModel);
                    this.wasm.ensureHashInfra(moduleModel);
                    this.markFunctionReached(this.wasm.stringHashFunc as WasmFunction);
                  }
                }
              }
            }
            case _: {}
          }
        }
      }
    } else if (isExternal) {
      let funcType = moduleModel.getNodeType(decl) as FunctionType;
      let params = new Array<ValType>();
      for (let pt in funcType.parameters) {
        params.push(typeToValType(this.wasm, pt));
      }
      let returns = new Array<ValType>();
      mapReturnTypeToWasmResults(this.wasm, funcType.returnType, returns);

      let isWasi = (externalModule == "wasi_snapshot_preview1");
      var isGcRef = false;
      if (returns.length == 1) {
        match (returns[0]) {
          case ValTypeAnyRef: { isGcRef = true; }
          case ValTypeEqRef: { isGcRef = true; }
          case ValTypeStructRef: { isGcRef = true; }
          case ValTypeRef: { isGcRef = true; }
          case ValTypeRefNull: { isGcRef = true; }
          case _: {}
        }
      }

      if (isGcRef && !isWasi) {
        let importReturns = new Array<ValType>();
        importReturns.push(new ValTypeExternRef());
        let importSig = this.wasm.getSignature(params, importReturns);
        let importFunc = new WasmFunction(importSig, decl, moduleModel);
        importFunc.isImport = true;
        importFunc.importModule = externalModule;
        importFunc.importName = externalName;
        importFunc.name = decl.name.name + "_raw_import";
        this.wasm.functionImports.push(importFunc);

        let wrapperSig = this.wasm.getSignature(params, returns);
        let wrapperFunc = new WasmFunction(wrapperSig, decl, moduleModel);
        wrapperFunc.name = decl.name.name;
        wrapperFunc.importWrapperTarget = importFunc;
        this.wasm.addFunction(wrapperFunc);

        this.wasm.functionMap[sym.id] = wrapperFunc;
      } else {
        let sig = this.wasm.getSignature(params, returns);
        let wasmFunc = new WasmFunction(sig, decl, moduleModel);
        wasmFunc.isImport = true;
        wasmFunc.importModule = externalModule;
        wasmFunc.importName = externalName;
        this.wasm.functionImports.push(wasmFunc);
        this.wasm.functionMap[sym.id] = wasmFunc;
      }
      
      let finalFunc = this.wasm.functionMap[sym.id];
      if (this.currentReachable) {
        this.markFunctionReached(finalFunc);
      }
    }
  }

  registerStringHashHelper(model: SemanticModel): void {
    if (this.wasm.stringHashHelper != null) {
      return;
    }

    var stringStruct: WasmStruct | null = null;
    let stringClass = this.wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (let (true, stringInfo) = this.wasm.classInfos.get(key)) {
        stringStruct = stringInfo.structType;
      }
    }
    if (stringStruct == null) {
      throw new Error("string_hash_helper discovery: String class struct not found!");
    }
    
    let helperParams = new Array<ValType>();
    helperParams.push(new ValTypeRefNull(stringStruct as WasmStruct));
    let helperReturns = new Array<ValType>();
    helperReturns.push(new ValTypeI32());
    let helperSig = this.wasm.getSignature(helperParams, helperReturns);
    
    let helperFunc = new WasmFunction(helperSig, null, model);
    helperFunc.name = "string_hash_helper";
    this.wasm.addFunction(helperFunc);
    this.wasm.stringHashHelper = helperFunc;
    this.markFunctionReached(helperFunc);
  }

  registerWasiInfra(model: SemanticModel): void {
    if (this.wasm.wasiFdWriteIndex >= 0) return;
    
    this.wasm.ensureMemory();
    
    let fdWriteParams = new Array<ValType>();
    fdWriteParams.push(new ValTypeI32());
    fdWriteParams.push(new ValTypeI32());
    fdWriteParams.push(new ValTypeI32());
    fdWriteParams.push(new ValTypeI32());
    let fdWriteReturns = new Array<ValType>();
    fdWriteReturns.push(new ValTypeI32());
    let fdWriteSig = this.wasm.getSignature(fdWriteParams, fdWriteReturns);
    
    let fdWriteFunc = new WasmFunction(fdWriteSig, null, model);
    fdWriteFunc.isImport = true;
    fdWriteFunc.importModule = "wasi_snapshot_preview1";
    fdWriteFunc.importName = "fd_write";
    this.wasm.functionImports.push(fdWriteFunc);
    this.wasm.wasiFdWriteIndex = 1;
    
    var stringStruct: WasmStruct | null = null;
    let stringClass = this.wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (let (true, stringInfo) = this.wasm.classInfos.get(key)) {
        stringStruct = stringInfo.structType;
      }
    }
    if (stringStruct == null) {
      throw new Error("wasi_write_string_helper discovery: String class struct not found!");
    }
    
    let helperParams = new Array<ValType>();
    helperParams.push(new ValTypeI32());
    helperParams.push(new ValTypeRefNull(stringStruct as WasmStruct));
    let helperReturns = new Array<ValType>();
    let helperSig = this.wasm.getSignature(helperParams, helperReturns);
    
    let helperFunc = new WasmFunction(helperSig, null, model);
    helperFunc.name = "wasi_write_string_helper";
    this.wasm.addFunction(helperFunc);
    this.wasm.wasiWriteStringHelper = helperFunc;
    this.markFunctionReached(helperFunc);
    this.wasm.wasiWriteStringIndex = 1;
  }

  findImplementingMethod(cType: ClassType, mName: String): MethodDefinition | null {
    let key = (getClassKey(cType) as String) + "." + mName;
    if (this.#implementingMethodNulls.has(key)) {
      return null;
    }
    if (let (true, cached) = this.#implementingMethodCache.get(key)) {
      return cached;
    }

    var curr: ClassType | null = cType;
    while (curr != null) {
      let ct = curr as ClassType;
      let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
      for (let unit in this.program.units) {
        let model = unit.model;
        if (model.classDeclarations.has(lookupId)) {
          let cd = model.classDeclarations[lookupId];
          let mixinMembers = new Array<Node>();
          let seenMixins = new HashMap<MixinKey, boolean>();
          collectMixinMembers(this.program, model, cd.mixins, mixinMembers, seenMixins);
          
          let allMembers = new Array<Node>();
          for (let member in cd.body) {
            allMembers.push(member);
          }
          for (let member in mixinMembers) {
            allMembers.push(member);
          }
          
          for (let member in allMembers) {
            if (member is MethodDefinition) {
              let md = member as MethodDefinition;
              if (md.isAbstract) { continue; }
              let name = getMethodName(md);
              if (matchMemberName(name, mName)) {
                this.#implementingMethodCache[key] = md;
                return md;
              }
            }
          }
        }
      }
      curr = ct.superType;
    }
    this.#implementingMethodNulls.add(key);
    return null;
  }

  findImplementingMethods(cType: ClassType, mName: String): Array<MethodDefinition> {
    let key = (getClassKey(cType) as String) + "." + mName;
    if (let (true, cached) = this.#implementingMethodsCache.get(key)) {
      return cached;
    }

    let methods = new Array<MethodDefinition>();
    let seenSigs = new HashSet<String>();
    var curr: ClassType | null = cType;
    while (curr != null) {
      let ct = curr as ClassType;
      let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
      for (let unit in this.program.units) {
        let model = unit.model;
        if (model.classDeclarations.has(lookupId)) {
          let cd = model.classDeclarations[lookupId];

          let mixinMembers = new Array<Node>();
          let seenMixins = new HashMap<MixinKey, boolean>();
          collectMixinMembers(this.program, model, cd.mixins, mixinMembers, seenMixins);
          
          let allMembers = new Array<Node>();
          for (let member in cd.body) {
            allMembers.push(member);
          }
          for (let member in mixinMembers) {
            allMembers.push(member);
          }
          
          for (let member in allMembers) {
            if (member is MethodDefinition) {
              let md = member as MethodDefinition;
              if (md.isAbstract) { continue; }
              let name = getMethodName(md);
              if (matchMemberName(name, mName)) {
                let mType = model.getNodeType(md);
                if (mType != null && mType is FunctionType) {
                  let ft = mType as FunctionType;
                  let sigKey = getSignatureKey(ft);
                  if (!seenSigs.has(sigKey)) {
                    methods.push(md);
                    seenSigs.add(sigKey);
                  }
                }
              }
            }
          }
        }
      }
      curr = ct.superType;
    }
    this.#implementingMethodsCache[key] = methods;
    return methods;
  }

  findImplementingField(cType: ClassType, fName: String): FieldDefinition | null {
    let key = (getClassKey(cType) as String) + "." + fName;
    if (this.#implementingFieldNulls.has(key)) {
      return null;
    }
    if (let (true, cached) = this.#implementingFieldCache.get(key)) {
      return cached;
    }

    var curr: ClassType | null = cType;
    while (curr != null) {
      let ct = curr as ClassType;
      let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
      for (let unit in this.program.units) {
        let model = unit.model;
        if (model.classDeclarations.has(lookupId)) {
          let cd = model.classDeclarations[lookupId];
          let mixinMembers = new Array<Node>();
          let seenMixins = new HashMap<MixinKey, boolean>();
          collectMixinMembers(this.program, model, cd.mixins, mixinMembers, seenMixins);
          
          let allMembers = new Array<Node>();
          for (let member in cd.body) {
            allMembers.push(member);
          }
          for (let member in mixinMembers) {
            allMembers.push(member);
          }
          
          for (let member in allMembers) {
            if (member is FieldDefinition) {
              let fd = member as FieldDefinition;
              if (fd.isAbstract) { continue; }
              let name = match (fd.name) {
                case Identifier {name}: name
                case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                  case Identifier {name}: name
                  case MemberExpression {property}: property.name
                  case _: "<symbol>"
                }
                case _: ""
              };
              if (matchMemberName(name, fName)) {
                this.#implementingFieldCache[key] = fd;
                return fd;
              }
            }
          }
        }
      }
      curr = ct.superType;
    }
    this.#implementingFieldNulls.add(key);
    return null;
  }

  findImplementingAccessor(cType: ClassType, accName: String): AccessorDeclaration | null {
    let key = (getClassKey(cType) as String) + "." + accName;
    if (this.#implementingAccessorNulls.has(key)) {
      return null;
    }
    if (let (true, cached) = this.#implementingAccessorCache.get(key)) {
      return cached;
    }

    var curr: ClassType | null = cType;
    while (curr != null) {
      let ct = curr as ClassType;
      let lookupId = (if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id) as SymbolId;
      for (let unit in this.program.units) {
        let model = unit.model;
        if (model.classDeclarations.has(lookupId)) {
          let cd = model.classDeclarations[lookupId];
          let mixinMembers = new Array<Node>();
          let seenMixins = new HashMap<MixinKey, boolean>();
          collectMixinMembers(this.program, model, cd.mixins, mixinMembers, seenMixins);
          
          let allMembers = new Array<Node>();
          for (let member in cd.body) {
            allMembers.push(member);
          }
          for (let member in mixinMembers) {
            allMembers.push(member);
          }
          
          for (let member in allMembers) {
            if (member is AccessorDeclaration) {
              let acc = member as AccessorDeclaration;
              let name = getAccessorName(acc);
              if (accName.length > 4 && acc.getter != null && accName.sliceBytes(0, 4) == "get#") {
                let targetProp = accName.sliceBytes(4, accName.length);
                if (matchMemberName(name, targetProp)) {
                  this.#implementingAccessorCache[key] = acc;
                  return acc;
                }
              }
              if (accName.length > 4 && acc.setter != null && accName.sliceBytes(0, 4) == "set#") {
                let targetProp = accName.sliceBytes(4, accName.length);
                if (matchMemberName(name, targetProp)) {
                  this.#implementingAccessorCache[key] = acc;
                  return acc;
                }
              }
            }
          }
        }
      }
      curr = ct.superType;
    }
    this.#implementingAccessorNulls.add(key);
    return null;
  }

  isSubclassOf(ct: ClassType, baseType: ClassType): boolean {
    let key = i32ToString(ct.id) + "<:" + i32ToString(baseType.id);
    if (let (true, cached) = this.#subclassRelationCache.get(key)) {
      return cached;
    }
    
    let res = this.#isSubclassOfDirect(ct, baseType);
    this.#subclassRelationCache[key] = res;
    return res;
  }

  #isSubclassOfDirect(ct: ClassType, baseType: ClassType): boolean {
    var curr: ClassType | null = ct;
    while (curr != null) {
      let currVal = curr as ClassType;
      if (currVal.id == baseType.id) return true;
      if (currVal.genericSource != null && (currVal.genericSource as ClassType).id == baseType.id) return true;
      
      // Check mixins
      let lookupId = (if (currVal.genericSource != null) (currVal.genericSource as ClassType).id else currVal.id) as SymbolId;
      for (let unit in this.program.units) {
        let model = unit.model;
        if (model.classDeclarations.has(lookupId)) {
          let cd = model.classDeclarations[lookupId];
          let seenIds = new HashMap<SymbolId, boolean>();
          collectMixinSymbolIds(this.program, model, cd.mixins, seenIds);
          
          if (seenIds.has(baseType.id as SymbolId)) {
            return true;
          }
        }
      }
      
      curr = currVal.superType;
    }
    return false;
  }
}
let matchMemberName = (name: String, target: String): boolean => {
  if (name == target) {
    return true;
  }
  if (name.length > 0 && name.sliceBytes(0, 1) == ":") {
    return name.sliceBytes(1, name.length) == target;
  }
  return false;
};

let getMethodName = (md: MethodDefinition): String => {
  return match (md.name) {
    case Identifier {name}: name
    case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
      case Identifier {name}: name
      case MemberExpression {property}: property.name
      case _: "<symbol>"
    }
    case _: ""
  };
};

let getAccessorName = (acc: AccessorDeclaration): String => {
  return match (acc.name) {
    case Identifier {name}: name
    case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
      case Identifier {name}: name
      case MemberExpression {property}: property.name
      case _: "<symbol>"
    }
    case _: ""
  };
};

let getNodeFilePath = (model: SemanticModel, node: Node): String => {
  var curr: Node | null = node;
  while (curr != null) {
    if (curr is Module) {
      return (curr as Module).path;
    }
    curr = model.getParent(curr as Node);
  }
  return "";
};

let getFileNameBase = (path: String): String => {
  var lastSlash = -1;
  var i = 0;
  let len = path.length;
  while (i < len) {
    if (path.sliceBytes(i, i + 1) == "/" || path.sliceBytes(i, i + 1) == "\\") {
      lastSlash = i;
    }
    i += 1;
  }
  if (lastSlash >= 0) {
    return path.sliceBytes(lastSlash + 1, len);
  }
  return path;
};

let sanitizeName = (s: String): String => {
  let sb = new StringBuilder();
  var i = 0;
  let len = s.length;
  while (i < len) {
    let char = s.sliceBytes(i, i + 1);
    if (char == "." || char == "-" || char == "/" || char == "\\") {
      sb.append("_");
    } else {
      sb.append(char);
    }
    i += 1;
  }
  return sb.toString();
};

let resolveImportedSymbolId = (program: Program, model: SemanticModel, spec: ImportSpecifier, expectedType: Type | null = null): SymbolId => {
  let parentNode = model.getParent(spec);
  if (parentNode == null || !(parentNode is ImportDeclaration)) {
    return -1 as SymbolId;
  }
  let importDecl = parentNode as ImportDeclaration;
  let specifier = importDecl.moduleSpecifier.value;
  
  var canonicalPath = specifier;
  if (specifier.startsWith("./") || specifier.startsWith("../")) {
    let referrer = model.getParent(importDecl);
    if (referrer != null && referrer is Module) {
      let mod = referrer as Module;
      let dir = dirName(mod.path);
      canonicalPath = normalizePath(dir + "/" + specifier);
    }
  }
  
  if (!program.unitsByPath.has(canonicalPath)) {
    return -1 as SymbolId;
  }
  
  let targetUnit = program.unitsByPath[canonicalPath];
  let importedName = spec.imported.name;
  
  var fallback: Symbol | null = null;
  for (let stmt in targetUnit.ast.body) {
    match (stmt) {
      case DeclareFunction as df: {
        if (df.name.name == importedName) {
          let sym = targetUnit.model.resolveDeclaration(df);
          if (expectedType == null) {
            return (sym as Symbol).id;
          }
          let nodeType = targetUnit.model.getNodeType(df);
          if (nodeType != null && matchOverloadForImport(nodeType as Type, expectedType as Type)) {
            return (sym as Symbol).id;
          }
          fallback = sym;
        }
      }
      case VariableDeclaration as vd: {
        match (vd.pattern) {
          case IdentifierPattern {name} as pat: {
            if (name == importedName) {
              let sym = targetUnit.model.resolve(pat);
              if (sym != null) {
                if (expectedType == null) {
                  return (sym as Symbol).id;
                }
                let nodeType = targetUnit.model.getNodeType(pat);
                if (nodeType != null && matchOverloadForImport(nodeType as Type, expectedType as Type)) {
                  return (sym as Symbol).id;
                }
                fallback = sym;
              }
            }
          }
          case _: {}
        }
      }
      case _: {}
    }
  }
  if (fallback != null) {
    return (fallback as Symbol).id;
  }
  return -1 as SymbolId;
};

let matchTypesForImport = (t1: Type, t2: Type): boolean => {
  if (t1 is TypeParameterType) {
    return true;
  }
  match (t1) {
    case ArrayType {elementType}: {
      if (t2 is ArrayType) {
        return matchTypesForImport(elementType, (t2 as ArrayType).elementType);
      }
      return false;
    }
    case ClassType as ct1: {
      if (t2 is ClassType) {
        let ct2 = t2 as ClassType;
        if (ct1.name != ct2.name) { return false; }
        if (ct1.typeArguments != null && ct2.typeArguments != null) {
          let args1 = ct1.typeArguments as Array<Type>;
          let args2 = ct2.typeArguments as Array<Type>;
          if (args1.length != args2.length) { return false; }
          var i = 0;
          while (i < args1.length) {
            if (!matchTypesForImport(args1[i], args2[i])) { return false; }
            i += 1;
          }
        }
        return true;
      }
      return false;
    }
    case InterfaceType as it1: {
      if (t2 is InterfaceType) {
        let it2 = t2 as InterfaceType;
        if (it1.name != it2.name) { return false; }
        if (it1.typeArguments != null && it2.typeArguments != null) {
          let args1 = it1.typeArguments as Array<Type>;
          let args2 = it2.typeArguments as Array<Type>;
          if (args1.length != args2.length) { return false; }
          var i = 0;
          while (i < args1.length) {
            if (!matchTypesForImport(args1[i], args2[i])) { return false; }
            i += 1;
          }
        }
        return true;
      }
      return false;
    }
    case _: {
      return typeToString(t1) == typeToString(t2);
    }
  }
};

let matchOverloadForImport = (t1: Type, t2: Type): boolean => {
  if (t1 is FunctionType && t2 is FunctionType) {
    let ft1 = t1 as FunctionType;
    let ft2 = t2 as FunctionType;
    if (ft1.parameters.length != ft2.parameters.length) {
      return false;
    }
    var i = 0;
    while (i < ft1.parameters.length) {
      if (!matchTypesForImport(ft1.parameters[i], ft2.parameters[i])) {
        return false;
      }
      i += 1;
    }
    return true;
  }
};


let collectMixinSymbolIds = (
  program: Program,
  model: SemanticModel,
  mixinAnns: Array<TypeAnnotation> | null,
  seenIds: HashMap<SymbolId, boolean>
): void => {
  if (mixinAnns == null) { return; }
  for (let ann in (mixinAnns as Array<TypeAnnotation>)) {
    let sym = model.resolve(ann);
    if (sym != null) {
      let id = (sym as Symbol).id;
      if (!seenIds.has(id)) {
        seenIds[id] = true;
        let mt = model.getBindingType(sym as Symbol);
        if (mt != null && mt is MixinType) {
          let md = findMixinDeclaration(program, mt as MixinType);
          if (md != null) {
            collectMixinSymbolIds(program, model, (md as MixinDeclaration).mixins, seenIds);
          }
        }
      }
    }
  }
};


