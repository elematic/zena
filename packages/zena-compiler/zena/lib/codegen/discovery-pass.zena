import { 
  Node, Module, VariableDeclaration, FunctionExpression, IdentifierPattern,
  Identifier, NumberLiteral, BooleanLiteral, StringLiteral, BlockStatement,
  ReturnStatement, ExpressionStatement, Statement, Expression, CallExpression,
  ImportDeclaration, ImportSpecifier, ClassDeclaration, InterfaceDeclaration, DeclareFunction,
  TypeAliasDeclaration, RecordLiteral, MethodDefinition, FieldDefinition,
  AccessorDeclaration, SetterInfo, SuperInitializer, TypeParameter, MixinDeclaration,
  Parameter, TypeAnnotation, Decorator, Pattern, MemberExpression, AssignmentExpression, IndexExpression,
  SymbolPropertyName, TemplateElement, EnumDeclaration, ForInStatement, TaggedTemplateExpression,
  SourceLocation
} from '../ast.zena';
import { walk } from '../visitor.zena';
import { RecordType, TupleType } from '../types.zena';
import { SemanticModel, InterfaceAdaptation, FunctionAdaptation, RecordAdaptation } from '../semantic-model.zena';
import { Program, CompilationUnit } from '../program.zena';
import { SymbolId, Symbol } from '../scope/symbol.zena';
import { Error } from 'zena:error';
import { ValType, ValTypeVoid, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeFuncRef, ValTypeAnyRef, ValTypeStructRef, ValTypeEqRef, ValTypeRefNull, ValTypeRef, ValTypeExternRef, WasmType } from './wasm.zena';
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { HashSet } from 'zena:set';
import { analyzeCaptures } from '../analysis/capture.zena';
import { NodeMap } from '../node-map.zena';
import { UsageAnalyzer, UsageAnalysisResult } from '../analysis/usage.zena';
import { Type, FunctionType, I32Type, F32Type, F64Type, VoidType, BooleanType, ClassType, InterfaceType, TypeAliasType, U32Type, I64Type, U64Type, ArrayType, NullType, UnknownType, ErrorType, AnyType, AnyRefType, EqRefType, NeverType, HoleType, FieldInfo, MethodInfo, typeToString, ByteArrayType, TypeParameterType, ThisType, UnionType, InlineTupleType, baseType, BoolLiteralType, NumLiteralType, StringLiteralType, instantiateClassType} from '../types.zena';
import { String } from "zena:string";
import { i32ToString } from "zena:string-convert";
import { console } from 'zena:console';

import { 
  WasmModule, WasmFunction, WasmStruct, WasmField, WasmSignature, WasmGlobal, 
  VTableInit, RecordDispatchInfo, WasmArray
} from './wasm-module.zena';
import { 
  getClassKey, getInterfaceKey, getSignatureKey, matchOverload, 
  collectMixinMembers, collectMixinFields, getMemberRootClass,
  ClassKey, InterfaceKey, ClassInterfaceKey, InterfaceMemberKey,
  isConcrete,
  ExportKey, ExportGlobalKey, getClassInterfaceKey, getInterfaceMemberKey,
  getClassPrivateFieldKey, getClassVTableName, getClassSingletonName,
  getInterfaceTrampolineName, getClassInterfaceVTableName,
  MixinKey, getMixinKey, classInterfaceKeyToString, getMixinKeyFromSymbol,
  substituteTypeParams
} from './codegen-utils.zena';
import { 
  typeToValType, getClosureStruct, getCellStruct, getInterfaceMemberSignature, 
  mapReturnTypeToWasmResults, substituteTypeParamsInCodegen,
  getClassTypeParameters, getInterfaceTypeParameters
} from './type-mapping.zena';
import { StringBuilder } from 'zena:string-builder';

let getTypeUniqueKey = (t: Type): String => {
  match (t) {
    case ClassType as ct: {
      let baseId = if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id;
      let base = ct.name + "_" + i32ToString(baseId as i32);
      if (ct.typeArguments != null) {
        let args = ct.typeArguments as Array<Type>;
        var s = base + "<";
        var i = 0;
        while (i < args.length) {
          if (i > 0) { s = s + ", "; }
          s = s + getTypeUniqueKey(args[i]);
          i += 1;
        }
        s + ">"
      } else {
        base
      }
    }
    case InterfaceType as it: {
      let baseId = if (it.genericSource != null) (it.genericSource as InterfaceType).id else it.id;
      let base = it.name + "_" + i32ToString(baseId as i32);
      if (it.typeArguments != null) {
        let args = it.typeArguments as Array<Type>;
        var s = base + "<";
        var i = 0;
        while (i < args.length) {
          if (i > 0) { s = s + ", "; }
          s = s + getTypeUniqueKey(args[i]);
          i += 1;
        }
        s + ">"
      } else {
        base
      }
    }
    case ArrayType {elementType}: "Array<" + getTypeUniqueKey(elementType) + ">"
    case TupleType {elementTypes}: {
      var s = "[";
      var i = 0;
      while (i < elementTypes.length) {
        if (i > 0) { s = s + ", "; }
        s = s + getTypeUniqueKey(elementTypes[i]);
        i += 1;
      }
      s + "]"
    }
    case InlineTupleType {elementTypes}: {
      var s = "(";
      var i = 0;
      while (i < elementTypes.length) {
        if (i > 0) { s = s + ", "; }
        s = s + getTypeUniqueKey(elementTypes[i]);
        i += 1;
      }
      s + ")"
    }
    case UnionType {types}: {
      var s = "";
      var i = 0;
      while (i < types.length) {
        if (i > 0) { s = s + " | "; }
        s = s + getTypeUniqueKey(types[i]);
        i += 1;
      }
      s
    }
    case RecordType {properties}: {
      var s = "{ ";
      let keys = properties.keys();
      var first = true;
      while (let (true, key) = keys.next()) {
        if (!first) { s = s + ", "; }
        s = s + key + ": " + getTypeUniqueKey(properties[key]);
        first = false;
      }
      s + " }"
    }
    case FunctionType as ft: {
      var s = "(";
      var i = 0;
      while (i < ft.parameters.length) {
        if (i > 0) { s = s + ", "; }
        if (ft.parameterNames != null) {
          let names = ft.parameterNames as Array<String>;
          if (i < names.length) {
            s = s + names[i] + ": ";
          }
        }
        s = s + getTypeUniqueKey(ft.parameters[i]);
        i += 1;
      }
      s + ") => " + getTypeUniqueKey(ft.returnType)
    }
    case TypeAliasType as a: "alias_" + getTypeUniqueKey(a.target)
    case _: typeToString(t)
  }
};


/**
 * Traverses a Zena Program's AST to discover all functions, structs, and 
 * imports that need to be emitted into the WebAssembly module.
 * Dedupes signatures and assigns Zena Symbols to WasmFunctions.
 */
export class DiscoveryPass {
  program: Program;
  wasm: WasmModule;
  usage: UsageAnalysisResult;
  discoveredTypes = new HashSet<String>();
  classDecls = new HashMap<i32, ClassDeclaration>();
  classModels = new HashMap<i32, SemanticModel>();
  interfaceDecls = new HashMap<i32, InterfaceDeclaration>();
  interfaceModels = new HashMap<i32, SemanticModel>();
  new(this.program, this.wasm, this.usage);

  getClassModel(ct: ClassType): SemanticModel {
    var curr: ClassType | null = ct;
    while (curr != null) {
      let lookupId = if ((curr as ClassType).genericSource != null) ((curr as ClassType).genericSource as ClassType).id else (curr as ClassType).id;
      if (this.classModels.has(lookupId)) {
        return this.classModels[lookupId];
      }
      curr = (curr as ClassType).superType;
    }
    return this.program.units[0].model;
  }

  populateClassStructAndMethods(ct: ClassType, cd: ClassDeclaration | null, sourceModel: SemanticModel): void {
    let cKey = getClassKey(ct);
    console.log("POPULATING CLASS: name=" + ct.name + " key=" + (cKey as String) + " super=" + (if (ct.superType != null) (ct.superType as ClassType).name else "null"));
    let vst = this.wasm.classVTableStructs[cKey];
    let st = this.wasm.classStructs[cKey];
    
    // If already populated, return
    if (st.fields.length > 0) {
      return;
    }
    
    // 1. Populate superclass first recursively
    if (ct.superType != null) {
      let superCt = ct.superType as ClassType;
      let superLookupId = if (superCt.genericSource != null) (superCt.genericSource as ClassType).id else superCt.id;
      let superDecl = if (this.classDecls.has(superLookupId)) this.classDecls[superLookupId] else null as ClassDeclaration;
      let superModel = this.getClassModel(superCt);
      this.populateClassStructAndMethods(superCt, superDecl, superModel);
    }
    
    // 2. Add case class extra methods (==, hashCode) in members and vtable slots
    if (ct.isCaseClass) {
      if (!ct.members.has("==")) {
        let eqParams = new Array<Type>();
        eqParams.push(ct);
        let eqNames = new Array<String>();
        eqNames.push("other");
        ct.members["=="] = new MethodInfo(new FunctionType(eqParams, eqNames, new BooleanType()), false, false, false, false);
      }
      var hasEqV = false;
      for (let existing in ct.vtable) {
        if (existing == "==") { hasEqV = true; }
      }
      if (!hasEqV) {
        ct.vtable.push("==");
      }

      if (!ct.members.has("hashCode")) {
        ct.members["hashCode"] = new MethodInfo(new FunctionType(new Array<Type>(), null, new I32Type()), false, false, false, false);
      }
      var hasHashV = false;
      for (let existing in ct.vtable) {
        if (existing == "hashCode") { hasHashV = true; }
      }
      if (!hasHashV) {
        ct.vtable.push("hashCode");
      }
    }

    // 3. Populate vst fields if empty
    if (vst.fields.length == 0) {
      for (let methName in ct.vtable) {
        vst.fields.push(new WasmField(methName, new ValTypeFuncRef(), false));
      }
    }

    // 4. Populate class struct fields
    let fields = new Array<WasmField>();
    if (ct.superType != null) {
      let superKey = getClassKey(ct.superType as ClassType);
      let superSt = this.wasm.classStructs[superKey];
      for (let f in superSt.fields) {
        fields.push(f);
      }
    } else {
      var rootVst = vst;
      while (rootVst.superStruct != null) {
        rootVst = rootVst.superStruct as WasmStruct;
      }
      fields.push(new WasmField("<vtable>", new ValTypeRefNull(rootVst), true));
    }

    let isStaticField = (name: String): boolean => {
      if (cd == null) return false;
      for (let ms in (cd as ClassDeclaration).body) {
        if (ms is FieldDefinition) {
          let fd = ms as FieldDefinition;
          let fieldName = match (fd.name) {
            case Identifier {name}: name
            case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
              case Identifier {name}: name
              case MemberExpression {property}: property.name
              case _: "<symbol>"
            }
            case _: ""
          };
          if (fieldName == name) {
            return fd.isStatic;
          }
        }
      }
      return false;
    };

    let ctParams = getClassTypeParameters(ct);
    for (let pair in ct.members) {
      if (pair.value is MethodInfo) {
        continue;
      }
      if (pair.value.isAbstract) {
        continue;
      }
      if (isStaticField(pair.key)) {
        continue;
      }
      var isInherited = false;
      if (ct.superType != null) {
        let superKey = getClassKey(ct.superType as ClassType);
        let superSt = this.wasm.classStructs[superKey];
        for (let sf in superSt.fields) {
          if (sf.name == pair.key) {
            isInherited = true;
          }
        }
      }
      if (!isInherited) {
        let fName = if (pair.key.length > 0 && pair.key.sliceBytes(0, 1) == "#") {
          getClassPrivateFieldKey(cKey, pair.key)
        } else {
          pair.key
        };
        let resolvedType = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, pair.value.type);
        fields.push(new WasmField(fName, typeToValType(this.wasm, resolvedType), true));
      }
    }
    for (let f in fields) {
      st.fields.push(f);
    }
  }

  getClassType(node: ClassDeclaration, model: SemanticModel): ClassType | null {
    let t = model.getNodeType(node);
    var ret: ClassType | null = null;
    if (t is ClassType) {
      ret = t as ClassType;
    } else {
      let sym = model.resolve(node);
      if (sym != null) {
        let bt = model.getBindingType(sym);
        if (bt is ClassType) {
          ret = bt as ClassType;
        }
      }
    }
    if (ret != null) {
      let r = ret as ClassType;
      if (r.name == "String" && r.sourcePath == "zena:string") {
        this.wasm.stringClass = r;
      } else if (r.name == "TemplateStringsArray" && r.sourcePath == "zena:template-strings-array") {
        this.wasm.templateStringsArrayClass = r;
      } else if (r.name == "Box" && r.sourcePath == "zena:box") {
        this.wasm.boxClass = r;
      }
    }
    return ret;
  }

  findPreludeInterface(name: String): InterfaceType | null {
    for (let unit in this.program.units) {
      let model = unit.model;
      let t = model.getExportType(name);
      if (t != null && t is InterfaceType) {
        return t as InterfaceType;
      }
    }
    return null;
  }

  findPreludeClass(name: String): ClassType | null {
    for (let unit in this.program.units) {
      let model = unit.model;
      let t = model.getExportType(name);
      if (t != null && t is ClassType) {
        return t as ClassType;
      }
    }
    return null;
  }

  discoverSpecializedBody(ct: ClassType, body: Node, sourceModel: SemanticModel): void {
    let ctParams = getClassTypeParameters(ct);
    walk(body, (n: Node) => true, (n: Node) => {
      let t = sourceModel.getNodeType(n);
      if (t != null) {
        let resolved = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, t as Type);
        this.discoverType(resolved, sourceModel);
      }
      if (n is Expression) {
        let expr = n as Expression;
        let ia = sourceModel.getInterfaceAdaptation(expr);
        if (ia != null) {
          let resolvedSrc = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, ia.source) as ClassType;
          let resolvedTgt = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, ia.target) as InterfaceType;
          this.discoverType(resolvedSrc, sourceModel);
          this.discoverType(resolvedTgt, sourceModel);
          
          let cName = getClassKey(resolvedSrc);
          let iName = getInterfaceKey(resolvedTgt);
          this.wasm.usedInterfaceAdaptations[getClassInterfaceKey(cName, iName)] = true;
          
          let unspecCName = getClassKey(resolvedSrc.genericSource ?? resolvedSrc);
          let unspecIName = getInterfaceKey(resolvedTgt.genericSource ?? resolvedTgt);
          let unspecKey = getClassInterfaceKey(unspecCName, unspecIName);
          this.wasm.usedInterfaceAdaptations[unspecKey] = true;
          console.log("DISCOVER SPEC ADAPT: resolved=" + classInterfaceKeyToString(getClassInterfaceKey(cName, iName)) + " unspec=" + classInterfaceKeyToString(unspecKey));
        }
        let ra = sourceModel.getRecordAdaptation(expr);
        if (ra != null) {
          let resolvedSrc = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, ra.source);
          let resolvedTgt = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, ra.target);
          this.discoverType(resolvedSrc, sourceModel);
          this.discoverType(resolvedTgt, sourceModel);
        }
        let fa = sourceModel.getFunctionAdaptation(expr);
        if (fa != null) {
          let resolvedSrc = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, fa.source);
          let resolvedTgt = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, fa.target);
          this.discoverType(resolvedSrc, sourceModel);
          this.discoverType(resolvedTgt, sourceModel);
        }
      }
    });
  }

  registerSpecializedClass(ct: ClassType, classDecl: ClassDeclaration | null, sourceModel: SemanticModel): void {
    console.log("REGISTER SPECIALIZED CLASS: ct=" + ct.name + " id=" + i32ToString(ct.id as i32) + " cKey=" + (getClassKey(ct) as String));
    let cKey = getClassKey(ct);
    if (this.wasm.classStructs.has(cKey)) {
      return;
    }

    let ctParams = getClassTypeParameters(ct);

    // 1. Pre-register empty structs
    let structName = cKey as String;
    let emptyStruct = new WasmStruct(structName, new Array<WasmField>());
    emptyStruct.classType = ct;
    this.wasm.types.push(emptyStruct);
    this.wasm.classStructs[cKey] = emptyStruct;

    let emptyVTableStruct = new WasmStruct(structName + "_VTable", new Array<WasmField>());
    emptyVTableStruct.classType = ct;
    this.wasm.types.push(emptyVTableStruct);
    this.wasm.classVTableStructs[cKey] = emptyVTableStruct;

    // 2. Link super types
    if (ct.superType != null) {
      let superCt = ct.superType as ClassType;
      this.discoverType(superCt, sourceModel);
      
      let superKey = getClassKey(superCt);
      if (this.wasm.classStructs.has(superKey)) {
        emptyStruct.superStruct = this.wasm.classStructs[superKey];
      }
      if (this.wasm.classVTableStructs.has(superKey)) {
        emptyVTableStruct.superStruct = this.wasm.classVTableStructs[superKey];
      }
      
      // Inherit vtable slots (prefix-preserving)
      if (superCt.vtable != null) {
        let newVTable = new Array<String>();
        for (let methName in superCt.vtable) {
          newVTable.push(methName);
        }
        for (let methName in ct.vtable) {
          var hasMeth = false;
          for (let existing in newVTable) {
            if (existing == methName) { hasMeth = true; break; }
          }
          if (!hasMeth) {
            newVTable.push(methName);
          }
        }
          while (ct.vtable.length > 0) {
            ct.vtable.pop();
          }
          for (let m in newVTable) {
            ct.vtable.push(m);
          }
        }
    }

    if (ct.isCaseClass) {
      var hasEq = false;
      var hasHash = false;
      for (let existing in ct.vtable) {
        if (existing == "==") { hasEq = true; }
        if (existing == "hashCode") { hasHash = true; }
      }
      if (!hasEq) {
        ct.vtable.push("==");
      }
      if (!hasHash) {
        ct.vtable.push("hashCode");
      }
    }

    // 3. Discover referenced types in members (fields)
    for (let pair in ct.members) {
      if (pair.value is FieldInfo) {
        let resolvedType = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, pair.value.type);
        this.discoverType(resolvedType, sourceModel);
      }
    }

    let specIfaces = this.collectAllImplementedInterfaces(ct);
    for (let iface in specIfaces) {
      this.discoverType(iface, sourceModel);
    }

    // 4. Populate VTable slots and structs
    let mixinMembers = new Array<Node>();
    let seenMixins = new HashMap<MixinKey, boolean>();
    if (classDecl != null) {
      collectMixinMembers(this.program, sourceModel, (classDecl as ClassDeclaration).mixins, mixinMembers, seenMixins);
    }

    let allMembers = new Array<Node>();
    if (classDecl != null) {
      for (let ms in (classDecl as ClassDeclaration).body) {
        allMembers.push(ms);
      }
    }
    for (let ms in mixinMembers) {
      allMembers.push(ms);
    }

    // Add methods to vtable slots
    for (let ms in allMembers) {
      if (ms is MethodDefinition) {
        let mDef = ms as MethodDefinition;
        if (mDef.isStatic) { continue; }
        let methName = match (mDef.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: ""
        };
        if (methName != "") {
          var vtableMethName = methName;
          if (ct.members.has(methName)) {
            let mInfo = ct.members[methName];
            if (mInfo.type is FunctionType) {
              let ft = mInfo.type as FunctionType;
              let specificType = matchOverload(sourceModel, ft, mDef);
              if (specificType != null) {
                vtableMethName = methName + getSignatureKey(specificType as FunctionType);
              }
            }
          }
          
          var found = false;
          for (let existing in ct.vtable) {
            if (existing == vtableMethName) { found = true; }
          }
          if (!found && methName != "<constructor>") {
            ct.vtable.push(vtableMethName);
          }
        }
      } else if (ms is AccessorDeclaration) {
        let acc = ms as AccessorDeclaration;
        if (acc.isStatic) { continue; }
        let accName = match (acc.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: ""
        };
        if (accName != "") {
          if (acc.getter != null) {
            let getterName = "get#" + accName;
            var found = false;
            for (let existing in ct.vtable) {
              if (existing == getterName) { found = true; break; }
            }
            if (!found) { ct.vtable.push(getterName); }
          }
          if (acc.setter != null) {
            let setterName = "set#" + accName;
            var found = false;
            for (let existing in ct.vtable) {
              if (existing == setterName) { found = true; break; }
            }
            if (!found) { ct.vtable.push(setterName); }
          }
        }
      } else if (ms is FieldDefinition) {
        let fd = ms as FieldDefinition;
        if (fd.isStatic) { continue; }
        let fieldName = match (fd.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: ""
        };
        if (fd.setterName != null && fieldName != "") {
          let getterName = "get#" + fieldName;
          var found = false;
          for (let existing in ct.vtable) {
            if (existing == getterName) { found = true; break; }
          }
          if (!found) { ct.vtable.push(getterName); }
        }
        if (fd.isAbstract && fieldName != "") {
          let getterName = "get#" + fieldName;
          var found = false;
          for (let existing in ct.vtable) {
            if (existing == getterName) { found = true; break; }
          }
          if (!found) { ct.vtable.push(getterName); }
          if (fd.mutability != null && fd.mutability == "var") {
            let setterName = "set#" + fieldName;
            var foundS = false;
            for (let existing in ct.vtable) {
              if (existing == setterName) { foundS = true; break; }
            }
            if (!foundS) { ct.vtable.push(setterName); }
          }
        }
      }
    }



    // 5. Register specialized methods
    for (let ms in allMembers) {
      if (ms is MethodDefinition) {
        let method = ms as MethodDefinition;
        if (method.isAbstract) { continue; }
        if (method.typeParameters != null && (method.typeParameters as Array<TypeParameter>).length > 0) {
          continue;
        }
        let methName = match(method.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };
        this.registerClassMethod(ct, classDecl, methName, method as Node, false, false, null, sourceModel);
      } else if (ms is AccessorDeclaration) {
        let acc = ms as AccessorDeclaration;
        let accName = match(acc.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };
        if (acc.getter != null) {
          this.registerClassMethod(ct, classDecl, "get#" + accName, acc as Node, false, false, null, sourceModel);
        }
        if (acc.setter != null) {
          this.registerClassMethod(ct, classDecl, "set#" + accName, acc.setter as Node, false, false, null, sourceModel);
        }
      } else if (ms is FieldDefinition) {
        let fd = ms as FieldDefinition;
        let fieldName = match(fd.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<unknown>"
          }
          case _: "<unknown>"
        };
        if (fd.setterName != null) {
          this.registerClassMethod(ct, classDecl, "get#" + fieldName, fd as Node, true, false, null, sourceModel);
        }
        if (fd.isAbstract) {
          this.registerClassMethod(ct, classDecl, "get#" + fieldName, fd as Node, true, false, null, sourceModel);
          if (fd.mutability != null && fd.mutability == "var") {
            this.registerClassMethod(ct, classDecl, "set#" + fieldName, null, false, true, fieldName, sourceModel);
          }
        }
        if (fd.isDeclare) {
          this.registerClassMethod(ct, classDecl, "get#" + fieldName, fd as Node, true, false, null, sourceModel);
        }
      }
    }

    // Register implicit constructor for specialized case classes if needed
    if (ct.isCaseClass) {
      var hasCtor = false;
      for (let f in this.wasm.functions) {
        if (f.classType != null && getClassKey(f.classType as ClassType) == cKey && f.methodName != null && (f.methodName as String) == "<constructor>") {
          hasCtor = true;
          break;
        }
      }
      if (!hasCtor) {
        this.registerClassMethod(ct, classDecl, "<constructor>", null, false, false, null, sourceModel);
      }

      var hasEq = false;
      for (let f in this.wasm.functions) {
        if (f.classType != null && getClassKey(f.classType as ClassType) == cKey && f.methodName != null && (f.methodName as String) == "==") {
          hasEq = true;
          break;
        }
      }
      if (!hasEq) {
        this.registerClassMethod(ct, classDecl, "==", null, false, false, null, sourceModel);
        let eqFunc = this.wasm.functions[this.wasm.functions.length - 1];
        eqFunc.isCaseClassEq = true;
      }

      var hasHash = false;
      for (let f in this.wasm.functions) {
        if (f.classType != null && getClassKey(f.classType as ClassType) == cKey && f.methodName != null && (f.methodName as String) == "hashCode") {
          hasHash = true;
          break;
        }
      }
      if (!hasHash) {
        this.registerClassMethod(ct, classDecl, "hashCode", null, false, false, null, sourceModel);
        let hashFunc = this.wasm.functions[this.wasm.functions.length - 1];
        hashFunc.isCaseClassHash = true;
      }
    }

    // Register implicit interface getters/setters for specialized classes
    let allIfaces = this.collectAllImplementedInterfaces(ct);
    for (let iface in allIfaces) {
      let it = iface as InterfaceType;
      let iName = getInterfaceKey(it);
      let unspecializedKey = getClassInterfaceKey(getClassKey(ct.genericSource ?? ct), getInterfaceKey(it.genericSource ?? it));
      if (this.wasm.usedInterfaceAdaptations.has(unspecializedKey)) {
        let keys = it.members.keys();
        while (let (true, key) = keys.next()) {
          let member = it.members[key];
          if (member is FieldInfo) {
            let fi = member as FieldInfo;
            let getterName = "get#" + key;
            // Get unspecialized interface key
            let unspecIName = getInterfaceKey(it.genericSource ?? it);
            if (this.wasm.usedInterfaceMembers.has(getInterfaceMemberKey(unspecIName, getterName))) {
              var hasGetter = false;
              for (let f in this.wasm.functions) {
                if (f.classType != null && getClassKey(f.classType as ClassType) == cKey && f.methodName != null && (f.methodName as String) == getterName) {
                  hasGetter = true;
                }
              }
              if (!hasGetter) {
                this.registerClassMethod(ct, classDecl, getterName, null, true, false, key, sourceModel);
              }
            }
            
            if (fi.isMutable) {
              let setterName = "set#" + key;
              if (this.wasm.usedInterfaceMembers.has(getInterfaceMemberKey(unspecIName, setterName))) {
                var hasSetter = false;
                for (let f in this.wasm.functions) {
                  if (f.classType != null && getClassKey(f.classType as ClassType) == cKey && f.methodName != null && (f.methodName as String) == setterName) {
                    hasSetter = true;
                  }
                }
                if (!hasSetter) {
                  this.registerClassMethod(ct, classDecl, setterName, null, false, true, key, sourceModel);
                }
              }
            }
          }
        }
      }
      for (let ms in (classDecl as ClassDeclaration).body) {
        this.discoverSpecializedBody(ct, ms, sourceModel);
      }
    }
  }

  registerSpecializedInterface(it: InterfaceType, ifaceDecl: InterfaceDeclaration | null, sourceModel: SemanticModel): void {
    let iKey = getInterfaceKey(it);
    if (this.wasm.interfaceStructs.has(iKey)) {
      return;
    }

    let itParams = getInterfaceTypeParameters(it);

    // 1. Pre-register empty vtable and fat ptr structs
    let structName = iKey as String;
    let emptyVTableStruct = new WasmStruct(structName + "_VTable", new Array<WasmField>());
    this.wasm.types.push(emptyVTableStruct);
    this.wasm.interfaceVTableStructs[iKey] = emptyVTableStruct;

    let fatPtrFields = new Array<WasmField>();
    fatPtrFields.push(new WasmField("instance", new ValTypeAnyRef(), false));
    fatPtrFields.push(new WasmField("vtable", new ValTypeRef(emptyVTableStruct), false));
    let emptyStruct = new WasmStruct(structName + "_FatPtr", fatPtrFields);
    this.wasm.types.push(emptyStruct);
    this.wasm.interfaceStructs[iKey] = emptyStruct;

    // 2. Discover referenced types in members (fields, methods)
    for (let pair in it.members) {
      let resolvedType = substituteTypeParamsInCodegen(itParams, it.typeArguments, pair.value.type);
      this.discoverType(resolvedType, sourceModel);
    }

    // 3. Populate VTable fields
    let unspecIName = getInterfaceKey(it.genericSource ?? it);
    let keys = it.members.keys();
    while (let (true, key) = keys.next()) {
      let member = it.members[key];
      match (member) {
        case FieldInfo as fi: {
          let getterKey = getInterfaceMemberKey(unspecIName, "get#" + key);
          if (this.wasm.usedInterfaceMembers.has(getterKey)) {
            let sig = getInterfaceMemberSignature(this.wasm, it, "get#" + key);
            emptyVTableStruct.fields.push(new WasmField("get#" + key, new ValTypeRef(sig), false));
          }
          if (fi.isMutable) {
            let setterKey = getInterfaceMemberKey(unspecIName, "set#" + key);
            if (this.wasm.usedInterfaceMembers.has(setterKey)) {
              let sig = getInterfaceMemberSignature(this.wasm, it, "set#" + key);
              emptyVTableStruct.fields.push(new WasmField("set#" + key, new ValTypeRef(sig), false));
            }
          }
        }
        case MethodInfo as mi: {
          let methodKey = getInterfaceMemberKey(unspecIName, key);
          if (this.wasm.usedInterfaceMembers.has(methodKey)) {
            let sig = getInterfaceMemberSignature(this.wasm, it, key);
            emptyVTableStruct.fields.push(new WasmField(key, new ValTypeRef(sig), false));
          }
        }
        case _: {}
      }
    }
  }

  discoverType(t: Type | null, model: SemanticModel): void {
     if (t == null) { return; }
     let typeStr = getTypeUniqueKey(t as Type);
     if (this.discoveredTypes.has(typeStr)) {
        return;
     }
     this.discoveredTypes.add(typeStr);
     
     if (t is RecordType) {
        let rec = t as RecordType;
        for (let pair in rec.properties) {
           this.discoverType(pair.value, model);
        }
        let fields = new Array<WasmField>();
        for (let pair in rec.properties) {
           fields.push(new WasmField(pair.key, typeToValType(this.wasm, pair.value), false));
        }
        this.wasm.getRecordDispatch(model, fields);
     } else if (t is TupleType) {
        let tup = t as TupleType;
        for (var i = 0; i < tup.elementTypes.length; i += 1) {
           this.discoverType(tup.elementTypes[i], model);
        }
        let fields = new Array<WasmField>();
        for (var i = 0; i < tup.elementTypes.length; i += 1) {
           let type = tup.elementTypes[i];
           fields.push(new WasmField(i32ToString(i), typeToValType(this.wasm, type), false));
        }
        this.wasm.getStruct(null, fields);
     } else if (t is InlineTupleType) {
        let tup = t as InlineTupleType;
        for (var i = 0; i < tup.elementTypes.length; i += 1) {
           this.discoverType(tup.elementTypes[i], model);
        }
     } else if (t is UnionType) {
        let ut = t as UnionType;
        for (let member in ut.types) {
           this.discoverType(member, model);
        }
     } else if (t is TypeAliasType) {
        this.discoverType((t as TypeAliasType).target, model);
     } else if (t is FunctionType) {
        let ft = t as FunctionType;
        for (let paramType in ft.parameters) {
           this.discoverType(paramType, model);
        }
        this.discoverType(ft.returnType, model);
        if (isConcrete(ft)) {
           getClosureStruct(this.wasm, ft);
        }
      } else if (t is ClassType) {
         let ct = t as ClassType;
         if (ct.name == "array" && ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0) {
            let elemType = (ct.typeArguments as Array<Type>)[0];
            this.discoverType(elemType, model);
            let elemValType = typeToValType(this.wasm, elemType);
            this.wasm.getArray(elemValType, true);
            return;
         }
         let cKey = getClassKey(ct);
         if (ct.name == "Box") {
             let lookupId = if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id;
             console.log("DISCOVER BOX: id=" + i32ToString(ct.id as i32) + " cKey=" + (cKey as String) + " lookupId=" + i32ToString(lookupId as i32) + " hasDecls=" + (if (this.classDecls.has(lookupId)) "true" else "false") + " isConcrete=" + (if (isConcrete(ct)) "true" else "false"));
          }
          let lookupId = if (ct.genericSource != null) (ct.genericSource as ClassType).id else ct.id;
          if (this.wasm.classStructs.has(cKey)) {
             return;
          }
        if (ct.name == "String" && ct.sourcePath == "zena:string") {
           this.wasm.stringClass = ct;
        } else if (ct.name == "TemplateStringsArray" && ct.sourcePath == "zena:template-strings-array") {
           this.wasm.templateStringsArrayClass = ct;
        }
        
        // Register specialized class struct & methods if generic instantiation
        if (ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0 && isConcrete(ct)) {
          if (this.classDecls.has(lookupId)) {
            let classDecl = this.classDecls[lookupId];
            let sourceModel = this.classModels[lookupId];
            this.registerSpecializedClass(ct, classDecl, sourceModel);
          }
        }
        
        if (ct.isExtension && ct.onType != null) {
           this.discoverType(ct.onType, model);
        }
        for (let pair in ct.members) {
           if (pair.value is FieldInfo) {
              let resolvedType = substituteTypeParamsInCodegen(getClassTypeParameters(ct), ct.typeArguments, pair.value.type);
              this.discoverType(resolvedType, model);
           }
        }
     } else if (t is InterfaceType) {
        let it = t as InterfaceType;
        let iKey = getInterfaceKey(it);
        if (this.wasm.interfaceStructs.has(iKey)) {
           return;
        }
        
        // Register specialized interface struct & methods if generic instantiation
        if (it.typeArguments != null && (it.typeArguments as Array<Type>).length > 0 && isConcrete(it)) {
          let lookupId = if (it.genericSource != null) (it.genericSource as InterfaceType).id else it.id;
          if (this.interfaceDecls.has(lookupId)) {
            let ifaceDecl = this.interfaceDecls[lookupId];
            let sourceModel = this.interfaceModels[lookupId];
            this.registerSpecializedInterface(it, ifaceDecl, sourceModel);
          }
        }
        for (let pair in it.members) {
           if (pair.value is FieldInfo) {
              let resolvedType = substituteTypeParamsInCodegen(getInterfaceTypeParameters(it), it.typeArguments, pair.value.type);
              this.discoverType(resolvedType, model);
           }
        }
     } else if (t is ArrayType) {
         let at = t as ArrayType;
         this.discoverType(at.elementType, model);
         let elemValType = typeToValType(this.wasm, at.elementType);
         this.wasm.getArray(elemValType, true);

         if (isConcrete(at)) {
           let faClass = this.findPreludeClass("FixedArray");
           if (faClass != null) {
             let typeArgs = new Array<Type>();
             typeArgs.push(at.elementType);
             this.discoverType(instantiateClassType(faClass as ClassType, typeArgs), model);
           }
           let iaClass = this.findPreludeClass("ImmutableArray");
           if (iaClass != null) {
             let typeArgs = new Array<Type>();
             typeArgs.push(at.elementType);
             this.discoverType(instantiateClassType(iaClass as ClassType, typeArgs), model);
           }
         }
     } else if (t is ByteArrayType) {
        this.wasm.getByteArrayType();
     }
  }

  registerClassMethod(
      cType: ClassType,
      cDecl: ClassDeclaration | null,
      methName: String,
      methodNode: Node | null,
      isSynthesizedGetter: boolean,
      isSynthesizedSetter: boolean,
      backingFieldName: String | null,
      model: SemanticModel): void {
    console.log("  REGISTER METHOD: class=" + cType.name + " method=" + methName);
    var realMethName = methName;
    var methodTypeNode: Type | null = null;
    if (cType != null) {
      if (methName == "<constructor>") {
        methodTypeNode = cType.constructorType;
      } else {
        var specificFuncType: FunctionType | null = null;
        var hasOverloads = false;
        if (methodNode != null && methodNode is MethodDefinition) {
          if (cType.members.has(methName)) {
            let mInfo = cType.members[methName];
            if (mInfo.type is FunctionType) {
              let ft = mInfo.type as FunctionType;
              if (ft.overloads != null) {
                hasOverloads = true;
                specificFuncType = matchOverload(model, ft, methodNode as MethodDefinition);
              }
            }
          }
        }
        
        if (hasOverloads && specificFuncType != null) {
          methodTypeNode = specificFuncType;
          realMethName = methName + getSignatureKey(specificFuncType as FunctionType);
        } else if (cType.members.has(methName)) {
          methodTypeNode = cType.members[methName].type;
        } else if (methName == "==") {
          let eqParams = new Array<Type>();
          eqParams.push(cType);
          methodTypeNode = new FunctionType(eqParams, null, new BooleanType());
        } else if (methName == "hashCode") {
          methodTypeNode = new FunctionType(new Array<Type>(), null, new I32Type());
        } else if (methName.startsWith("get#")) {
          let fieldName = methName.sliceBytes(4, methName.length);
          if (cType.members.has(fieldName) && cType.members[fieldName] is FieldInfo) {
            let fi = cType.members[fieldName] as FieldInfo;
            methodTypeNode = new FunctionType(new Array<Type>(), null, fi.type);
          }
        } else if (methName.startsWith("set#")) {
          let fieldName = methName.sliceBytes(4, methName.length);
          if (cType.members.has(fieldName) && cType.members[fieldName] is FieldInfo) {
            let fi = cType.members[fieldName] as FieldInfo;
            let params = new Array<Type>();
            params.push(fi.type);
            methodTypeNode = new FunctionType(params, null, new VoidType());
          }
        }
      }
    }

    if (methodTypeNode != null && cType != null) {
      methodTypeNode = substituteTypeParamsInCodegen(getClassTypeParameters(cType), cType.typeArguments, methodTypeNode as Type);
    }
    if (methodTypeNode != null) {
      this.discoverType(methodTypeNode as Type, model);
    }

    let params = new Array<ValType>();
    let returns = new Array<ValType>();

    var rootClass = if (methName == "<constructor>") cType else getMemberRootClass(cType, methName);

    var isStatic = false;
    if (methodNode != null) {
      let nodeVal = methodNode as Node;
      if (nodeVal is MethodDefinition) {
        isStatic = (nodeVal as MethodDefinition).isStatic;
      } else if (nodeVal is AccessorDeclaration) {
        isStatic = (nodeVal as AccessorDeclaration).isStatic;
      } else if (nodeVal is FieldDefinition) {
        isStatic = (nodeVal as FieldDefinition).isStatic;
      }
    }

    if (!isStatic) {
      if (cType.isExtension && cType.onType != null) {
        params.push(typeToValType(this.wasm, cType.onType as Type));
      } else {
        if (this.wasm.classStructs.has(getClassKey(rootClass))) {
          params.push(new ValTypeRefNull(this.wasm.classStructs[getClassKey(rootClass)]));
        } else {
          params.push(new ValTypeAnyRef());
        }
      }
    }
    if (methodTypeNode is FunctionType) {
      let fType = methodTypeNode as FunctionType;
      for (let p in fType.parameters) {
        params.push(typeToValType(this.wasm, p));
      }
      if (methName != "<constructor>") {
        mapReturnTypeToWasmResults(this.wasm, fType.returnType, returns);
      }
    } else {
      if (methName != "<constructor>") {
        returns.push(new ValTypeI32());
      }
    }
    
    let sig = this.wasm.getSignature(params, returns);
    let wasmFunc = new WasmFunction(sig, methodNode, model);

    if (methodNode != null) {
      let nodeVal = methodNode as Node;
      var decs: Array<Decorator> | null = null;
      if (nodeVal is MethodDefinition) {
        decs = (nodeVal as MethodDefinition).decorators;
      } else if (nodeVal is AccessorDeclaration) {
        decs = (nodeVal as AccessorDeclaration).decorators;
      } else if (nodeVal is FieldDefinition) {
        decs = (nodeVal as FieldDefinition).decorators;
      }
      
      if (decs != null) {
        for (let dec in decs as Array<Decorator>) {
          if (dec.name == "intrinsic" && dec.args.length == 1) {
            wasmFunc.intrinsic = dec.args[0].value;
          }
        }
      }
    }

    wasmFunc.isStatic = isStatic;
    this.wasm.addFunction(wasmFunc);
    let cName = getClassKey(cType) as String;
    wasmFunc.name = cName + "." + realMethName;
    wasmFunc.methodName = realMethName;
    wasmFunc.classDecl = cDecl;
    
    wasmFunc.classType = cType;
    if (this.wasm.classStructs.has(getClassKey(cType))) {
        wasmFunc.structType = this.wasm.classStructs[getClassKey(cType)];
    }

    if (isSynthesizedGetter && backingFieldName != null) {
      let st = wasmFunc.structType;
      if (st != null) {
        var idx = -1;
        let backingName = backingFieldName as String;
        let lookupBackingName = if (backingName.length > 0 && backingName.sliceBytes(0, 1) == "#") {
          getClassPrivateFieldKey(getClassKey(cType), backingName)
        } else {
          backingName
        };
        for (var fi = 0; fi < (st as WasmStruct).fields.length; fi += 1) {
          if ((st as WasmStruct).fields[fi].name == lookupBackingName) {
            idx = fi;
          }
        }
        wasmFunc.getterStruct = st;
        wasmFunc.getterFieldIndex = idx;
      }
    } else if (isSynthesizedSetter && backingFieldName != null) {
      let st = wasmFunc.structType;
      if (st != null) {
        var idx = -1;
        let backingName = backingFieldName as String;
        let lookupBackingName = if (backingName.length > 0 && backingName.sliceBytes(0, 1) == "#") {
          getClassPrivateFieldKey(getClassKey(cType), backingName)
        } else {
          backingName
        };
        for (var fi = 0; fi < (st as WasmStruct).fields.length; fi += 1) {
          if ((st as WasmStruct).fields[fi].name == lookupBackingName) {
            idx = fi;
          }
        }
        wasmFunc.setterStruct = st;
        wasmFunc.setterFieldIndex = idx;
      }
    }
  }

  registerStringHashHelper(model: SemanticModel): void {
    for (let f in this.wasm.functions) {
      if (f.name != null && (f.name as String) == "string_hash_helper") {
        return;
      }
    }

    var stringStruct: WasmStruct | null = null;
    let stringClass = this.wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (this.wasm.classStructs.has(key)) {
        stringStruct = this.wasm.classStructs[key];
      }
    }
    if (stringStruct == null) {
      throw new Error("string_hash_helper discovery: String class struct not found!");
    }
    
    let helperParams = new Array<ValType>();
    helperParams.push(new ValTypeRefNull(stringStruct as WasmStruct));
    let helperReturns = new Array<ValType>();
    helperReturns.push(new ValTypeI32());
    let helperSig = this.wasm.getSignature(helperParams, helperReturns);
    
    let helperFunc = new WasmFunction(helperSig, null, model);
    helperFunc.name = "string_hash_helper";
    this.wasm.functions.push(helperFunc);
  }

  registerWasiInfra(model: SemanticModel): void {
    if (this.wasm.wasiFdWriteIndex >= 0) return;
    
    // 1. Enable memory
    this.wasm.ensureMemory();
    
    // 2. Add signature: (i32, i32, i32, i32) -> i32 for fd_write
    let fdWriteParams = new Array<ValType>();
    fdWriteParams.push(new ValTypeI32());
    fdWriteParams.push(new ValTypeI32());
    fdWriteParams.push(new ValTypeI32());
    fdWriteParams.push(new ValTypeI32());
    let fdWriteReturns = new Array<ValType>();
    fdWriteReturns.push(new ValTypeI32());
    let fdWriteSig = this.wasm.getSignature(fdWriteParams, fdWriteReturns);
    
    // 3. Create WasmFunction for fd_write import
    let fdWriteFunc = new WasmFunction(fdWriteSig, null, model);
    fdWriteFunc.isImport = true;
    fdWriteFunc.importModule = "wasi_snapshot_preview1";
    fdWriteFunc.importName = "fd_write";
    this.wasm.functionImports.push(fdWriteFunc);
    this.wasm.wasiFdWriteIndex = 1; // dummy placeholder
    
    // 4. Register signature: (i32, ref null $String) -> void for wasi_write_string_helper
    var stringStruct: WasmStruct | null = null;
    let stringClass = this.wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (this.wasm.classStructs.has(key)) {
        stringStruct = this.wasm.classStructs[key];
      }
    }
    if (stringStruct == null) {
      throw new Error("wasi_write_string_helper discovery: String class struct not found!");
    }
    
    let helperParams = new Array<ValType>();
    helperParams.push(new ValTypeI32());
    helperParams.push(new ValTypeRefNull(stringStruct as WasmStruct));
    let helperReturns = new Array<ValType>();
    let helperSig = this.wasm.getSignature(helperParams, helperReturns);
    
    // 5. Create WasmFunction for helper (synthetic, node is null)
    let helperFunc = new WasmFunction(helperSig, null, model);
    helperFunc.name = "wasi_write_string_helper";
    this.wasm.functions.push(helperFunc);
    this.wasm.wasiWriteStringIndex = 1; // dummy placeholder
  }

  #addInterfaceToTransitiveList(it: InterfaceType, list: Array<InterfaceType>, seen: HashMap<InterfaceKey, boolean>): void {
    let key = getInterfaceKey(it);
    if (!seen.has(key)) {
      seen[key] = true;
      list.push(it);
      for (let ext in it.extendsList) {
        let resolvedExt = substituteTypeParamsInCodegen(getInterfaceTypeParameters(it), it.typeArguments, ext) as InterfaceType;
        this.#addInterfaceToTransitiveList(resolvedExt, list, seen);
      }
    }
  }

  collectAllImplementedInterfaces(ct: ClassType): Array<InterfaceType> {
    let list = new Array<InterfaceType>();
    let seen = new HashMap<InterfaceKey, boolean>();
    
    var tParamStr = "null";
    let ctParams = getClassTypeParameters(ct);
    if (ctParams != null) {
      tParamStr = "[";
      let tp = ctParams as Array<TypeParameterType>;
      for (var idx = 0; idx < tp.length; idx += 1) {
        if (idx > 0) { tParamStr = tParamStr + ", "; }
        tParamStr = tParamStr + tp[idx].name;
      }
      tParamStr = tParamStr + "]";
    }
    var tArgStr = "null";
    if (ct.typeArguments != null) {
      tArgStr = "[";
      let ta = ct.typeArguments as Array<Type>;
      for (var idx = 0; idx < ta.length; idx += 1) {
        if (idx > 0) { tArgStr = tArgStr + ", "; }
        tArgStr = tArgStr + typeToString(ta[idx]);
      }
      tArgStr = tArgStr + "]";
    }
    console.log("COLLECT IFACE: Class=" + ct.name + " typeParams=" + tParamStr + " typeArgs=" + tArgStr);

    for (let iface in ct.implementsList) {
      let resolved = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, iface) as InterfaceType;
      console.log("  Resolved implements: " + typeToString(iface) + " -> " + typeToString(resolved));
      this.#addInterfaceToTransitiveList(resolved, list, seen);
    }
    
    var curr = ct.superType;
    while (curr != null) {
      let superCt = curr as ClassType;
      let superCtParams = getClassTypeParameters(superCt);
      for (let iface in superCt.implementsList) {
        let resolved = substituteTypeParamsInCodegen(superCtParams, superCt.typeArguments, iface) as InterfaceType;
        this.#addInterfaceToTransitiveList(resolved, list, seen);
      }
      curr = superCt.superType;
    }
    
    return list;
  }

  /**
   * Run the discovery pass on the program, populating the given WasmModule.
   */
  run(): void {
    let mixinToClasses = new HashMap<MixinKey, Array<ClassType>>();
    for (let unit in this.program.units) {
      let mod = unit.ast;
      let moduleModel = unit.model;
      walk(mod as Node, (n: Node) => true, (n: Node) => {
        if (n is ClassDeclaration) {
          let classDecl = n as ClassDeclaration;
          let classType = this.getClassType(classDecl, moduleModel);
          if (classType is ClassType) {
            let cType = classType as ClassType;
            let mixinMembers = new Array<Node>();
            let seenMixins = new HashMap<MixinKey, boolean>();
            collectMixinMembers(this.program, moduleModel, classDecl.mixins, mixinMembers, seenMixins);
            let mKeys = seenMixins.keys();
            while (let (true, mixKey) = mKeys.next()) {
              if (!mixinToClasses.has(mixKey)) {
                mixinToClasses[mixKey] = new Array<ClassType>();
              }
              mixinToClasses[mixKey].push(cType);
            }
          }
        }
      });
    }

    // Preliminary Pass: Discover all referenced interface members across all compilation units
    for (let unit in this.program.units) {
      let mod = unit.ast;
      let moduleModel = unit.model;
      walk(mod as Node, (n: Node) => true, (n: Node) => {
        if (n is MemberExpression) {
          let mem = n as MemberExpression;
          let objType = moduleModel.getNodeType(mem.object);
          if (objType is InterfaceType) {
            let it = objType as InterfaceType;
            let iName = getInterfaceKey(it.genericSource ?? it);
            let propName = if (mem.isSymbolAccess) ":" + mem.property.name else mem.property.name;
            let getterName = "get#" + propName;
            let setterName = "set#" + propName;
            if (it.members.has(propName)) {
              let member = it.members[propName];
              if (member is MethodInfo) {
                this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, propName)] = true;
              } else if (member is FieldInfo) {
                this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, "get#" + propName)] = true;
              }
            }
            if (it.members.has(getterName)) {
              this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, getterName)] = true;
            }
            if (it.members.has(setterName)) {
              this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, setterName)] = true;
            }
          }
        } else if (n is IndexExpression) {
          let idxExpr = n as IndexExpression;
          let objType = moduleModel.getNodeType(idxExpr.object);
          if (objType is InterfaceType) {
            let it = objType as InterfaceType;
            let iName = getInterfaceKey(it.genericSource ?? it);
            let targetName = "[]";
            if (it.members.has(targetName)) {
              this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, "[]")] = true;
            }
          }
        } else if (n is AssignmentExpression) {
          let assign = n as AssignmentExpression;
          if (assign.left is MemberExpression) {
            let mem = assign.left as MemberExpression;
            let objType = moduleModel.getNodeType(mem.object);
            if (objType is InterfaceType) {
              let it = objType as InterfaceType;
              let iName = getInterfaceKey(it.genericSource ?? it);
              let propName = if (mem.isSymbolAccess) ":" + mem.property.name else mem.property.name;
              let setterName = "set#" + propName;
              if (it.members.has(propName)) {
                let member = it.members[propName];
                if (member is FieldInfo) {
                  let fi = member as FieldInfo;
                  if (fi.isMutable) {
                    this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, "set#" + propName)] = true;
                  }
                }
              }
              if (it.members.has(setterName)) {
                this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, setterName)] = true;
              }
            }
          } else if (assign.left is IndexExpression) {
            let idxExpr = assign.left as IndexExpression;
            let objType = moduleModel.getNodeType(idxExpr.object);
            if (objType is InterfaceType) {
              let it = objType as InterfaceType;
              let iName = getInterfaceKey(it.genericSource ?? it);
              let targetName = "[]=";
              if (it.members.has(targetName)) {
                this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, "[]=")] = true;
              }
            }
          }
        } else if (n is ForInStatement) {
          let forIn = n as ForInStatement;
          let iterableType = moduleModel.getNodeType(forIn.iterable);
          if (iterableType != null) {
            if (iterableType is InterfaceType) {
              let it = iterableType as InterfaceType;
              let iName = getInterfaceKey(it.genericSource ?? it);
              this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iName, ":iterator")] = true;
            }
            
            let resolvedIterableTypes = new Array<ClassType>();
            if (iterableType is ClassType) {
              let ct = iterableType as ClassType;
              if (ct.name.length >= 5 && ct.name.sliceBytes(ct.name.length - 5, ct.name.length) == "_This") {
                // Find enclosing mixin declaration
                var enclosingMixinDecl: MixinDeclaration | null = null;
                var curr = forIn as Node;
                while (true) {
                  let parent = moduleModel.getParent(curr);
                  if (parent == null) { break; }
                  if (parent is MixinDeclaration) {
                    enclosingMixinDecl = parent as MixinDeclaration;
                    break;
                  }
                  curr = parent;
                }
                if (enclosingMixinDecl != null) {
                  var mixinSym = moduleModel.resolve(enclosingMixinDecl.name);
                  if (mixinSym == null) {
                    mixinSym = moduleModel.resolve(enclosingMixinDecl);
                  }
                  if (mixinSym != null) {
                    let mixKey = getMixinKeyFromSymbol(moduleModel, mixinSym as Symbol);
                    if (mixinToClasses.has(mixKey)) {
                      let classes = mixinToClasses[mixKey];
                      for (let cType in classes) {
                        resolvedIterableTypes.push(cType);
                      }
                    }
                  }
                }
              } else {
                resolvedIterableTypes.push(ct);
              }
            } else if (iterableType is ThisType) {
              // Find enclosing ClassDeclaration or MixinDeclaration
              var enclosingClassDecl: ClassDeclaration | null = null;
              var enclosingMixinDecl: MixinDeclaration | null = null;
              var curr = forIn as Node;
              while (true) {
                let parent = moduleModel.getParent(curr);
                if (parent == null) { break; }
                if (parent is ClassDeclaration) {
                  enclosingClassDecl = parent as ClassDeclaration;
                  break;
                }
                if (parent is MixinDeclaration) {
                  enclosingMixinDecl = parent as MixinDeclaration;
                  break;
                }
                curr = parent;
              }
              if (enclosingClassDecl != null) {
                let ct = this.getClassType(enclosingClassDecl as ClassDeclaration, moduleModel);
                if (ct != null) {
                  resolvedIterableTypes.push(ct as ClassType);
                }
              } else if (enclosingMixinDecl != null) {
                var mixinSym = moduleModel.resolve((enclosingMixinDecl as MixinDeclaration).name);
                if (mixinSym == null) {
                  mixinSym = moduleModel.resolve(enclosingMixinDecl as MixinDeclaration);
                }
                if (mixinSym != null) {
                  let mixKey = getMixinKeyFromSymbol(moduleModel, mixinSym as Symbol);
                  if (mixinToClasses.has(mixKey)) {
                    let classes = mixinToClasses[mixKey];
                    for (let cType in classes) {
                      resolvedIterableTypes.push(cType);
                    }
                  }
                }
              }
            } else if (iterableType is ArrayType) {
              let faClass = this.findPreludeClass("FixedArray");
              if (faClass != null) {
                let arrType = iterableType as ArrayType;
                let typeArgs = new Array<Type>();
                typeArgs.push(arrType.elementType);
                let instantiated = instantiateClassType(faClass as ClassType, typeArgs);
                resolvedIterableTypes.push(instantiated);
                this.discoverType(instantiated, moduleModel);
              }
            }

            for (let resolvedClass in resolvedIterableTypes) {
              let iterableIface = this.findPreludeInterface("Iterable");
              if (iterableIface != null) {
                let iterableKey = getInterfaceKey(iterableIface as InterfaceType);
                this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iterableKey, ":iterator")] = true;
                
                let cName = getClassKey(resolvedClass);
                this.wasm.usedInterfaceAdaptations[getClassInterfaceKey(cName, iterableKey)] = true;
                
                let unspecCName = getClassKey(resolvedClass.genericSource ?? resolvedClass);
                let unspecKey = getClassInterfaceKey(unspecCName, iterableKey);
                this.wasm.usedInterfaceAdaptations[unspecKey] = true;
              }
            }

            let iteratorIface = this.findPreludeInterface("Iterator");
            if (iteratorIface != null) {
              let iteratorKey = getInterfaceKey(iteratorIface as InterfaceType);
              this.wasm.usedInterfaceMembers[getInterfaceMemberKey(iteratorKey, "next")] = true;
            }
          }
        }
      });
    }

    // Pass 0: Pre-register empty WasmStructs for all nominal classes and interfaces across all units to break cyclic dependencies
    for (let unit in this.program.units) {
      let mod = unit.ast;
      let moduleModel = unit.model;
      walk(mod as Node, (n: Node) => true, (n: Node) => {
        if (n is ClassDeclaration) {
          let classDecl = n as ClassDeclaration;
          let classType = this.getClassType(classDecl, moduleModel);
          if (classType is ClassType) {
            let cType = classType as ClassType;
            console.log("PASS 0 REGISTER CLASS DECL: name=" + cType.name + " id=" + i32ToString(cType.id as i32) + " unit=" + unit.ast.path);
            this.classDecls[cType.id] = classDecl;
            this.classModels[cType.id] = moduleModel;
            if (cType.isExtension) { return; }
            let cKey = getClassKey(cType);
            if (!this.wasm.classStructs.has(cKey)) {
              let emptyStruct = new WasmStruct(cType.name, new Array<WasmField>());
              emptyStruct.classType = cType;
              this.wasm.types.push(emptyStruct);
              this.wasm.classStructs[cKey] = emptyStruct;
              let emptyVTableStruct = new WasmStruct(cType.name + "_VTable", new Array<WasmField>());
              emptyVTableStruct.classType = cType;
              this.wasm.types.push(emptyVTableStruct);
              this.wasm.classVTableStructs[cKey] = emptyVTableStruct;
            }
            if (cType.sealedVariants != null) {
              let variants = cType.sealedVariants as Array<ClassType>;
              for (let vType in variants) {
                if (vType == null) { continue; }
                let vKey = getClassKey(vType);
                if (!this.wasm.classStructs.has(vKey)) {
                  let emptyStruct = new WasmStruct(vType.name, new Array<WasmField>());
                  emptyStruct.classType = vType;
                  this.wasm.types.push(emptyStruct);
                  this.wasm.classStructs[vKey] = emptyStruct;
                  let emptyVTableStruct = new WasmStruct(vType.name + "_VTable", new Array<WasmField>());
                  emptyVTableStruct.classType = vType;
                  this.wasm.types.push(emptyVTableStruct);
                  this.wasm.classVTableStructs[vKey] = emptyVTableStruct;
                }
              }
            }
            let p0Ifaces = this.collectAllImplementedInterfaces(cType);
            for (let iface in p0Ifaces) {
              this.discoverType(iface, moduleModel);
            }
          }
        } else if (n is InterfaceDeclaration) {
          let ifaceDecl = n as InterfaceDeclaration;
          let ifaceType = moduleModel.getNodeType(ifaceDecl);
          if (ifaceType is InterfaceType) {
            let it = ifaceType as InterfaceType;
            this.interfaceDecls[it.id] = ifaceDecl;
            this.interfaceModels[it.id] = moduleModel;
            let emptyVTableStruct = new WasmStruct(it.name + "_VTable", new Array<WasmField>());
            this.wasm.types.push(emptyVTableStruct);
            this.wasm.interfaceVTableStructs[getInterfaceKey(it)] = emptyVTableStruct;

            let fatPtrFields = new Array<WasmField>();
            fatPtrFields.push(new WasmField("instance", new ValTypeAnyRef(), false));
            fatPtrFields.push(new WasmField("vtable", new ValTypeRef(emptyVTableStruct), false));
            let emptyStruct = new WasmStruct(it.name + "_FatPtr", fatPtrFields);
            this.wasm.types.push(emptyStruct);
            this.wasm.interfaceStructs[getInterfaceKey(it)] = emptyStruct;
          }
        }
      });
    }

    for (let unit in this.program.units) {
      let mod = unit.ast;
      let moduleModel = unit.model;
      
      // Pass 0.5: Populate each class's own vtable slots
      walk(mod as Node, (n: Node) => true, (n: Node) => {
        if (n is ClassDeclaration) {
          let classDecl = n as ClassDeclaration;
          let classType = this.getClassType(classDecl, moduleModel);
          if (classType is ClassType) {
            let cType = classType as ClassType;
            if (cType.isExtension) { return; }

            if (cType.isCaseClass) {
              var hasEq = false;
              var hasHash = false;
              for (let existing in cType.vtable) {
                if (existing == "==") { hasEq = true; }
                if (existing == "hashCode") { hasHash = true; }
              }
              if (!hasEq) {
                cType.vtable.push("==");
              }
              if (!hasHash) {
                cType.vtable.push("hashCode");
              }
            }

            // Add new methods to vtable slots
            let mixinMembers = new Array<Node>();
            let seenMixins = new HashMap<MixinKey, boolean>();
            collectMixinMembers(this.program, moduleModel, classDecl.mixins, mixinMembers, seenMixins);

            let allMembers = new Array<Node>();
            for (let ms in classDecl.body) {
              allMembers.push(ms);
            }
            for (let ms in mixinMembers) {
              allMembers.push(ms);
            }

            for (let ms in allMembers) {
              if (ms is MethodDefinition) {
                let mDef = ms as MethodDefinition;
                if (mDef.isStatic) { continue; }
                 if (mDef.typeParameters != null && (mDef.typeParameters as Array<TypeParameter>).length > 0) {
                  continue;
                }
                let methName = match (mDef.name) {
                  case Identifier {name}: name
                  case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                    case Identifier {name}: name
                    case MemberExpression {property}: property.name
                    case _: "<symbol>"
                  }
                  case _: ""
                };
                if (methName != "") {
                  var vtableMethName = methName;
                  if (cType.members.has(methName)) {
                    let mInfo = cType.members[methName];
                    if (mInfo.type is FunctionType) {
                      let ft = mInfo.type as FunctionType;
                      let specificType = matchOverload(moduleModel, ft, mDef);
                      if (specificType != null) {
                        vtableMethName = methName + getSignatureKey(specificType as FunctionType);
                      }
                    }
                  }
                  
                  var found = false;
                  for (let existing in cType.vtable) {
                    if (existing == vtableMethName) { found = true; }
                  }
                  if (!found && methName != "<constructor>") {
                    cType.vtable.push(vtableMethName);
                  }
                }
              } else if (ms is AccessorDeclaration) {
                let acc = ms as AccessorDeclaration;
                if (acc.isStatic) { continue; }
                let accName = match (acc.name) {
                  case Identifier {name}: name
                  case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                    case Identifier {name}: name
                    case MemberExpression {property}: property.name
                    case _: "<symbol>"
                  }
                  case _: ""
                };
                if (accName != "") {
                  if (acc.getter != null) {
                    let getterName = "get#" + accName;
                    var found = false;
                    for (let existing in cType.vtable) {
                      if (existing == getterName) { found = true; break; }
                    }
                    if (!found) { cType.vtable.push(getterName); }
                  }
                  if (acc.setter != null) {
                    let setterName = "set#" + accName;
                    var found = false;
                    for (let existing in cType.vtable) {
                      if (existing == setterName) { found = true; break; }
                    }
                    if (!found) { cType.vtable.push(setterName); }
                  }
                }
              } else if (ms is FieldDefinition) {
                let fd = ms as FieldDefinition;
                if (fd.isStatic) { continue; }
                let fieldName = match (fd.name) {
                  case Identifier {name}: name
                  case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                    case Identifier {name}: name
                    case MemberExpression {property}: property.name
                    case _: "<symbol>"
                  }
                  case _: ""
                };
                if (fd.setterName != null && fieldName != "") {
                  let getterName = "get#" + fieldName;
                  var found = false;
                  for (let existing in cType.vtable) {
                    if (existing == getterName) { found = true; break; }
                  }
                  if (!found) { cType.vtable.push(getterName); }
                }
                if (fd.isAbstract && fieldName != "") {
                  let getterName = "get#" + fieldName;
                  var found = false;
                  for (let existing in cType.vtable) {
                    if (existing == getterName) { found = true; break; }
                  }
                  if (!found) {
                    cType.vtable.push(getterName);
                  }
                  if (fd.mutability != null && fd.mutability == "var") {
                    let setterName = "set#" + fieldName;
                    var foundS = false;
                    for (let existing in cType.vtable) {
                      if (existing == setterName) { foundS = true; break; }
                    }
                    if (!foundS) {
                      cType.vtable.push(setterName);
                    }
                  }
                }
              }
            }
          }
        }
      });
    }

    // Pass 0.6: Link superStruct for inheritance and inherit vtable slots recursively
    let linkedClasses = new HashMap<ClassKey, boolean>();
    
    let linkSuperAndVT = (ct: ClassType, model: SemanticModel): void => {
      let ctKey = getClassKey(ct);
      if (linkedClasses.has(ctKey)) { return; }
      linkedClasses[ctKey] = true;
      
      if (ct.superType != null) {
        let superCt = ct.superType as ClassType;
        this.discoverType(superCt, model);
        linkSuperAndVT(superCt, model);
        
        let cKey = getClassKey(ct);
        let superKey = getClassKey(superCt);
        
        if (this.wasm.classStructs.has(cKey) && this.wasm.classStructs.has(superKey)) {
          let st = this.wasm.classStructs[cKey];
          let superSt = this.wasm.classStructs[superKey];
          st.superStruct = superSt;
        }
        
        if (this.wasm.classVTableStructs.has(cKey) && this.wasm.classVTableStructs.has(superKey)) {
          let vst = this.wasm.classVTableStructs[cKey];
          let superVst = this.wasm.classVTableStructs[superKey];
          vst.superStruct = superVst;
        }
        
        // Inherit vtable slots (prefix-preserving)
        if (superCt.vtable != null) {
          let newVTable = new Array<String>();
          for (let methName in superCt.vtable) {
            newVTable.push(methName);
          }
          for (let methName in ct.vtable) {
            var hasMeth = false;
            for (let existing in newVTable) {
              if (existing == methName) { hasMeth = true; break; }
            }
            if (!hasMeth) {
              newVTable.push(methName);
            }
          }
          while (ct.vtable.length > 0) {
            ct.vtable.pop();
          }
          for (let m in newVTable) {
            ct.vtable.push(m);
          }
        }
      }
    };

    let classesToLink = new Array<ClassType>();
    for (let cPair in this.wasm.classStructs) {
      let cStruct = cPair.value;
      if (cStruct.classType != null) {
        classesToLink.push(cStruct.classType as ClassType);
      }
    }

    for (let ct in classesToLink) {
      let model = this.getClassModel(ct);
      linkSuperAndVT(ct, model);
    }

    // Pass 0.7: Discover all referenced types, templates, records, and functions
    for (let unit in this.program.units) {
      let mod = unit.ast;
      let moduleModel = unit.model;
      
      walk(mod as Node, (n: Node) => true, (n: Node) => {
        let nodeType = moduleModel.getNodeType(n);
        if (n is VariableDeclaration) {
          let vd = n as VariableDeclaration;
          console.log("WALK VariableDeclaration: name=" + match (vd.pattern) { case IdentifierPattern {name}: name case _: "other" } + " type=" + (if (nodeType == null) "null" else typeToString(nodeType as Type)));
        }
        if (n is IdentifierPattern) {
          let ip = n as IdentifierPattern;
          let typeStr = if (nodeType == null) {
            "null"
          } else if (nodeType is ClassType) {
            "ClassType(name=" + (nodeType as ClassType).name + ", id=" + i32ToString((nodeType as ClassType).id as i32) + ")"
          } else {
            "other"
          };
          console.log("WALK IdentifierPattern: name=" + ip.name + " type=" + typeStr);
        }
        this.discoverType(nodeType, moduleModel);
        
        if (n is StringLiteral) {
          let strLit = n as StringLiteral;
          this.wasm.getStringLiteralDataIndex(strLit.value);
        }
        
        if (n is TemplateElement) {
          let tmplEl = n as TemplateElement;
          this.wasm.getStringLiteralDataIndex(tmplEl.cooked);
        }
        
        if (n is TaggedTemplateExpression) {
          let expr = n as TaggedTemplateExpression;
          if (!this.wasm.templateLiteralGlobals.has(expr)) {
            var tsaStruct: WasmStruct | null = null;
            let tsaClass = this.wasm.templateStringsArrayClass;
            if (tsaClass != null) {
              let key = getClassKey(tsaClass as ClassType);
              if (this.wasm.classStructs.has(key)) {
                tsaStruct = this.wasm.classStructs[key];
              }
            }
            if (tsaStruct == null) {
              throw new Error("TemplateStringsArray class struct not found during tagged template literal discovery!");
            }
            
            let globalName = "tsa_cache_" + i32ToString(expr.id as i32);
            let globalType = new ValTypeRefNull(tsaStruct);
            let g = new WasmGlobal(
              globalName,
              globalName,
              globalType,
              true, // isMutable
              null, // initExpr
              null, // initVTable
              moduleModel
            );
            this.wasm.globals.push(g);
            this.wasm.templateLiteralGlobals[expr] = g;
          }
        }
        
        if (n is Expression) {
          let expr = n as Expression;
          let adaptation = moduleModel.getRecordAdaptation(expr);
          if (adaptation != null) {
            this.discoverType(adaptation.target, moduleModel);
            
            let inFields = new Array<WasmField>();
            for (let pair in adaptation.source.properties) {
              inFields.push(new WasmField(pair.key, typeToValType(this.wasm, pair.value), false));
            }
            let outFields = new Array<WasmField>();
            for (let pair in adaptation.target.properties) {
              outFields.push(new WasmField(pair.key, typeToValType(this.wasm, pair.value), false));
            }
            this.wasm.getAdaptedRecordDispatch(moduleModel, inFields, outFields);
          }
          
          let ifaceAdaptation = moduleModel.getInterfaceAdaptation(expr);
          if (ifaceAdaptation != null) {
            let adapt = ifaceAdaptation as InterfaceAdaptation;
            let cName = getClassKey(adapt.source);
            let iName = getInterfaceKey(adapt.target);
            this.wasm.usedInterfaceAdaptations[getClassInterfaceKey(cName, iName)] = true;
            
            let unspecCName = getClassKey(adapt.source.genericSource ?? adapt.source);
            let unspecIName = getInterfaceKey(adapt.target.genericSource ?? adapt.target);
            let unspecKey = getClassInterfaceKey(unspecCName, unspecIName);
            this.wasm.usedInterfaceAdaptations[unspecKey] = true;
            console.log("PASS 1 ADAPT: " + classInterfaceKeyToString(getClassInterfaceKey(cName, iName)) + " unspec=" + classInterfaceKeyToString(unspecKey));
          }

          let funcAdaptation = moduleModel.getFunctionAdaptation(expr);
          if (funcAdaptation != null) {
            let src = funcAdaptation.source;
            let tgt = funcAdaptation.target;
            
            this.discoverType(src, moduleModel);
            this.discoverType(tgt, moduleModel);
            
            let pValTypes = new Array<ValType>();
            pValTypes.push(new ValTypeEqRef()); // ctx
            for (let p in tgt.parameters) {
              pValTypes.push(typeToValType(this.wasm, p));
            }
            let rValTypes = new Array<ValType>();
            mapReturnTypeToWasmResults(this.wasm, tgt.returnType, rValTypes);
            let wrapperSig = this.wasm.getSignature(pValTypes, rValTypes);
            
            var existingWrapper: WasmFunction | null = null;
            for (let w in this.wasm.functions) {
              if (w.isFunctionAdaptation &&
                  w.functionAdaptationSource != null && w.functionAdaptationTarget != null &&
                  getTypeUniqueKey(w.functionAdaptationSource as Type) == getTypeUniqueKey(src) &&
                  getTypeUniqueKey(w.functionAdaptationTarget as Type) == getTypeUniqueKey(tgt)) {
                existingWrapper = w;
                break;
              }
            }

            if (existingWrapper != null) {
              this.wasm.functionAdaptationWrappers[expr] = existingWrapper as WasmFunction;
            } else {
              let wrapperFunc = new WasmFunction(wrapperSig, null, moduleModel);
              let fileBase = sanitizeName(getFileNameBase(getNodeFilePath(moduleModel, expr)));
              let locStr = if (expr.loc != null) {
                let loc = expr.loc as SourceLocation;
                "L" + i32ToString(loc.line) + "C" + i32ToString(loc.column)
              } else {
                i32ToString(expr.id as i32)
              };
              wrapperFunc.name = "function_adapt_" + fileBase + "_" + locStr;
              wrapperFunc.isFunctionAdaptation = true;
              wrapperFunc.isReferenceTaken = true;
              wrapperFunc.functionAdaptationSource = src;
              wrapperFunc.functionAdaptationTarget = tgt;
              
              this.wasm.addFunction(wrapperFunc);
              this.wasm.functionAdaptationWrappers[expr] = wrapperFunc;
            }
            
            let srcClosure = getClosureStruct(this.wasm, src);
            let tgtClosure = getClosureStruct(this.wasm, tgt);
          }
        } else if (n is ClassDeclaration) {
          // Defer populating to Pass 1 statement loop
        } else if (n is InterfaceDeclaration) {
          let ifaceDecl = n as InterfaceDeclaration;
          let ifaceType = moduleModel.getNodeType(ifaceDecl);
          if (ifaceType is InterfaceType) {
            let it = ifaceType as InterfaceType;
            let iName = getInterfaceKey(it);
            let vst = this.wasm.interfaceVTableStructs[iName];
            let keys = it.members.keys();
            while (let (true, key) = keys.next()) {
              let member = it.members[key];
              match (member) {
                case FieldInfo as fi: {
                  let getterKey = getInterfaceMemberKey(iName, "get#" + key);
                  if (this.wasm.usedInterfaceMembers.has(getterKey)) {
                    let sig = getInterfaceMemberSignature(this.wasm, it, "get#" + key);
                    vst.fields.push(new WasmField("get#" + key, new ValTypeRef(sig), false));
                  }
                  if (fi.isMutable) {
                    let setterKey = getInterfaceMemberKey(iName, "set#" + key);
                    if (this.wasm.usedInterfaceMembers.has(setterKey)) {
                      let sig = getInterfaceMemberSignature(this.wasm, it, "set#" + key);
                      vst.fields.push(new WasmField("set#" + key, new ValTypeRef(sig), false));
                    }
                  }
                }
                case MethodInfo as mi: {
                  let methodKey = getInterfaceMemberKey(iName, key);
                  if (this.wasm.usedInterfaceMembers.has(methodKey)) {
                    let sig = getInterfaceMemberSignature(this.wasm, it, key);
                    vst.fields.push(new WasmField(key, new ValTypeRef(sig), false));
                  }
                }
                case _: {}
              }
            }
          }
        }
      });
      
      for (let stmt in mod.body) {
        if (stmt == null) {
          continue;
        }
        match (stmt) {
          case VariableDeclaration: {
            let varDecl = stmt as VariableDeclaration;
            var isNeeded = false;
            
            if (varDecl.exported) {
              isNeeded = true;
            } else if (varDecl.pattern is IdentifierPattern) {
              if (this.usage.isUsed(varDecl.pattern as Node)) {
                isNeeded = true;
              }
            }
            
            if (this.usage.isUsed(stmt as Node)) {
              isNeeded = true;
            }

            if (isNeeded) {
              let varDecl = stmt as VariableDeclaration;
              if (varDecl.init is FunctionExpression) {
                let funcExpr = varDecl.init as FunctionExpression;
                let funcTypeNode = moduleModel.getNodeType(funcExpr);
                let params = new Array<ValType>();
                let returns = new Array<ValType>();
                
                if (funcTypeNode is FunctionType) {
                  let fType = funcTypeNode as FunctionType;
                  for (let p in fType.parameters) {
                    params.push(typeToValType(this.wasm, p));
                  }
                  mapReturnTypeToWasmResults(this.wasm, fType.returnType, returns);
                } else {
                  returns.push(new ValTypeI32());
                }
                
                let sig = this.wasm.getSignature(params, returns);
                let wasmFunc = new WasmFunction(sig, funcExpr, moduleModel);
                this.wasm.addFunction(wasmFunc);
                
                if (varDecl.pattern is IdentifierPattern) {
                  let ident = varDecl.pattern as IdentifierPattern;
                  wasmFunc.name = ident.name;
                  let sym = moduleModel.resolveDeclaration(ident);
                  if (sym != null) {
                    this.wasm.functionMap[sym.id] = wasmFunc;
                    if (varDecl.exported) {
                      this.wasm.exportMap[ident.name as ExportKey] = wasmFunc;
                    }
                  }
                }
              } else {
                // Global Variable
                if (varDecl.pattern is IdentifierPattern && varDecl.init != null) {
                  let ident = varDecl.pattern as IdentifierPattern;
                  let expr = varDecl.init as Expression;
                  let nodeType = moduleModel.getNodeType(ident);
                  var isMutable = true;
                  
                  var vType = typeToValType(this.wasm, nodeType);

                  let sym = moduleModel.resolveDeclaration(ident);
                  if (sym != null) {
                    let name = ident.name + "_" + i32ToString(sym.id as i32);
                    let wasmGlobal = new WasmGlobal(name, ident.name, vType, isMutable, expr, null, moduleModel);
                    this.wasm.globals.push(wasmGlobal);
                    this.wasm.globalMap[sym.id] = wasmGlobal;
                    
                    if (varDecl.exported) {
                      this.wasm.exportGlobalMap[ident.name as ExportGlobalKey] = wasmGlobal;
                    }
                  }
                }
              }
            }
          }
          case ImportDeclaration: {}
          case ClassDeclaration: {
            let classDecl = stmt as ClassDeclaration;
            let classType = this.getClassType(classDecl, moduleModel) as ClassType;
            let isGeneric = classType != null && 
                            classType.typeParameters != null && 
                            (classType.typeParameters as Array<TypeParameterType>).length > 0;

            if (!isGeneric) {

            // Register static fields as globals
            for (let member in classDecl.body) {
              if (member is FieldDefinition) {
                let fd = member as FieldDefinition;
                if (fd.isStatic) {
                  let fieldName = match (fd.name) {
                    case Identifier {name}: name
                    case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                      case Identifier {name}: name
                      case MemberExpression {property}: property.name
                      case _: "<symbol>"
                    }
                    case _: ""
                  };
                  if (fieldName != "") {
                    let fType = if (classType != null && (classType as ClassType).members.has(fieldName)) {
                      (classType as ClassType).members[fieldName].type
                    } else {
                      moduleModel.getNodeType(fd)
                    };
                    let vType = typeToValType(this.wasm, fType);
                    let name = classDecl.name.name + "_" + fieldName;
                    let initExp = if (fd.value != null) { fd.value as Expression } else { null as Expression };
                    let wasmGlobal = new WasmGlobal(name, fieldName, vType, true, initExp, null, moduleModel);
                    this.wasm.globals.push(wasmGlobal);
                  }
                }
              }
            }

            let registerClassMethod = (
                cType: ClassType,
                cDecl: ClassDeclaration | null,
                methName: String,
                methodNode: Node | null,
                isSynthesizedGetter: boolean,
                isSynthesizedSetter: boolean,
                backingFieldName: String | null) => {
              this.registerClassMethod(cType, cDecl, methName, methodNode, isSynthesizedGetter, isSynthesizedSetter, backingFieldName, moduleModel);
            };


            let mixinMembers = new Array<Node>();
            let seenMixins = new HashMap<MixinKey, boolean>();
            collectMixinMembers(this.program, moduleModel, classDecl.mixins, mixinMembers, seenMixins);

            let allMembers = new Array<Node>();
            for (let ms in classDecl.body) {
              allMembers.push(ms);
            }
            for (let ms in mixinMembers) {
              allMembers.push(ms);
            }

            for (let member in allMembers) {
              if (member is MethodDefinition) {
                let method = member as MethodDefinition;
                if (method.isAbstract) { continue; }
                 if (method.typeParameters != null && (method.typeParameters as Array<TypeParameter>).length > 0) {
                  continue;
                }
                 let methName = match(method.name) {
                  case Identifier {name}: name
                  case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                    case Identifier {name}: name
                    case MemberExpression {property}: property.name
                    case _: "<symbol>"
                  }
                  case _: "<unknown>"
                };
                registerClassMethod(classType, classDecl, methName, method as Node, false, false, null);
              } else if (member is AccessorDeclaration) {
                let acc = member as AccessorDeclaration;
                let accName = match(acc.name) {
                  case Identifier {name}: name
                  case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                    case Identifier {name}: name
                    case MemberExpression {property}: property.name
                    case _: "<symbol>"
                  }
                  case _: "<unknown>"
                };
                if (acc.getter != null) {
                  registerClassMethod(classType, classDecl, "get#" + accName, acc as Node, false, false, null);
                }
                if (acc.setter != null) {
                  registerClassMethod(classType, classDecl, "set#" + accName, acc.setter as Node, false, false, null);
                }
              } else if (member is FieldDefinition) {
                let fd = member as FieldDefinition;
                let fieldName = match (fd.name) {
                  case Identifier {name}: name
                  case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                    case Identifier {name}: name
                    case MemberExpression {property}: property.name
                    case _: "<symbol>"
                  }
                  case _: ""
                };
                if (fieldName != "") {
                  if (fd.setterName != null) {
                    let backingName = match(fd.setterName as Node) {
                      case Identifier {name}: name
                      case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
                        case Identifier {name}: name
                        case MemberExpression {property}: property.name
                        case _: "<symbol>"
                      }
                      case _: fieldName
                    };
                    registerClassMethod(classType, classDecl, "get#" + fieldName, null, true, false, backingName);
                  } else if (fd.isDeclare) {
                    registerClassMethod(classType, classDecl, "get#" + fieldName, fd as Node, true, false, null);
                  }
                }
              }
            }

            if (!classType.isExtension) {
              for (let iface in classType.implementsList) {
                let it = iface as InterfaceType;
                let iName = getInterfaceKey(it);
                let cName = getClassKey(classType);
                if (this.wasm.usedInterfaceAdaptations.has(getClassInterfaceKey(cName, iName))) {
                  let keys = it.members.keys();
                  while (let (true, key) = keys.next()) {
                    let member = it.members[key];
                    if (member is FieldInfo) {
                      let fi = member as FieldInfo;
                      let getterName = "get#" + key;
                      if (this.wasm.usedInterfaceMembers.has(getInterfaceMemberKey(iName, getterName))) {
                        var hasGetter = false;
                        for (let f in this.wasm.functions) {
                          if (f.classType != null && getClassKey(f.classType as ClassType) == getClassKey(classType) && f.methodName != null && (f.methodName as String) == getterName) {
                            hasGetter = true;
                          }
                        }
                        if (!hasGetter) {
                          registerClassMethod(classType, classDecl, getterName, null, true, false, key);
                        }
                      }
                      
                      if (fi.isMutable) {
                        let setterName = "set#" + key;
                        if (this.wasm.usedInterfaceMembers.has(getInterfaceMemberKey(iName, setterName))) {
                          var hasSetter = false;
                          for (let f in this.wasm.functions) {
                            if (f.classType != null && getClassKey(f.classType as ClassType) == getClassKey(classType) && f.methodName != null && (f.methodName as String) == setterName) {
                              hasSetter = true;
                            }
                          }
                          if (!hasSetter) {
                            registerClassMethod(classType, classDecl, setterName, null, false, true, key);
                          }
                        }
                      }
                    }
                  }
                }
              }
            }

            var hasConstructor = false;
            for (let member in classDecl.body) {
              if (member is MethodDefinition) {
                let method = member as MethodDefinition;
                let methName = match(method.name) {
                  case Identifier {name}: name
                  case _: "<unknown>"
                };
                if (methName == "<constructor>") {
                  hasConstructor = true;
                }
              }
            }

            if (!hasConstructor && classType != null && !(classType as ClassType).isExtension && classDecl.caseParams == null) {
              let cType = classType as ClassType;
              let synthParams = new Array<Parameter>();
              let superInitArgs = new Array<Expression>();
              
              if (cType.superType != null) {
                let st = cType.superType as ClassType;
                if (st.constructorType != null) {
                  let superCtor = st.constructorType as FunctionType;
                  var pi = 0;
                  while (pi < superCtor.parameters.length) {
                    var pName = "p" + i32ToString(pi);
                    if (superCtor.parameterNames != null) {
                      let pNames = superCtor.parameterNames as Array<String>;
                      if (pNames.length > pi) {
                        pName = pNames[pi];
                      }
                    }
                    
                    let paramIdent = new Identifier(pName, classDecl.name.loc);
                    var pPattern: Pattern | null = null;
                    var pTypeAnno: TypeAnnotation | null = null;
                    var pDefValue: Expression | null = null;
                    let synthParam = new Parameter(
                      paramIdent,
                      pPattern,
                      pTypeAnno,
                      false,
                      pDefValue,
                      false,
                      classDecl.name.loc
                    );
                    synthParams.push(synthParam);
                    
                    let argExpr = new Identifier(pName, classDecl.name.loc) as Expression;
                    superInitArgs.push(argExpr);
                    
                    pi = pi + 1;
                  }
                }
              }
              
              var superInit: SuperInitializer | null = null;
              if (cType.superType != null) {
                superInit = new SuperInitializer(superInitArgs, classDecl.name.loc);
              }
              
              var typeParams: Array<TypeParameter> | null = null;
              var returnType: TypeAnnotation | null = null;
              var initList: Array<Node> | null = null;
              
              let syntheticDecorator = new Decorator("synthetic_constructor", new Array<StringLiteral>(), classDecl.name.loc);
              let synthDecorators = new Array<Decorator>();
              synthDecorators.push(syntheticDecorator);
              
              let synthCtor = new MethodDefinition(
                new Identifier("<constructor>", classDecl.name.loc),
                typeParams,
                synthParams,
                returnType,
                new BlockStatement(new Array<Statement>(), classDecl.name.loc),
                initList,
                superInit,
                false, // isFinal
                false, // isAbstract
                false, // isStatic
                false, // isDeclare
                synthDecorators,
                classDecl.name.loc
              );
              
              registerClassMethod(cType, classDecl, "<constructor>", synthCtor as Node, false, false, null);
            }
            
            if (classType != null && (classType as ClassType).isCaseClass) {
              let cType = classType as ClassType;
              let cKey = getClassKey(cType);
              
              // Register implicit constructor
              var hasCtor = false;
              for (let f in this.wasm.functions) {
                if (f.classType != null && getClassKey(f.classType as ClassType) == cKey && f.methodName != null && (f.methodName as String) == "<constructor>") {
                  hasCtor = true;
                  break;
                }
              }
              if (!hasCtor) {
                this.registerClassMethod(cType, classDecl, "<constructor>", null, false, false, null, moduleModel);
              }

              // Register implicit ==
              var hasEq = false;
              for (let f in this.wasm.functions) {
                if (f.classType != null && getClassKey(f.classType as ClassType) == cKey && f.methodName != null && (f.methodName as String) == "==") {
                  hasEq = true;
                  break;
                }
              }
              if (!hasEq) {
                this.registerClassMethod(cType, classDecl, "==", null, false, false, null, moduleModel);
                let eqFunc = this.wasm.functions[this.wasm.functions.length - 1];
                eqFunc.isCaseClassEq = true;
              }

              // Register implicit hashCode
              var hasHash = false;
              for (let f in this.wasm.functions) {
                if (f.classType != null && getClassKey(f.classType as ClassType) == cKey && f.methodName != null && (f.methodName as String) == "hashCode") {
                  hasHash = true;
                  break;
                }
              }
              if (!hasHash) {
                this.registerClassMethod(cType, classDecl, "hashCode", null, false, false, null, moduleModel);
                let hashFunc = this.wasm.functions[this.wasm.functions.length - 1];
                hashFunc.isCaseClassHash = true;
              }
            }

            if (classType != null) {
              let cType = classType as ClassType;
              if (cType.sealedVariants != null) {
                let variants = cType.sealedVariants as Array<ClassType>;
                for (let vType in variants) {
                  if (vType == null) { continue; }
                  if (vType.isCaseClass) {
                    let vKey = getClassKey(vType);
                    
                    // Register implicit constructor for variants
                    var hasCtor = false;
                    for (let f in this.wasm.functions) {
                      if (f.classType != null && getClassKey(f.classType as ClassType) == vKey && f.methodName != null && (f.methodName as String) == "<constructor>") {
                        hasCtor = true;
                        break;
                      }
                    }
                    if (!hasCtor) {
                      this.registerClassMethod(vType, null, "<constructor>", null, false, false, null, moduleModel);
                    }

                    // Register implicit == for variants
                    var hasEq = false;
                    for (let f in this.wasm.functions) {
                      if (f.classType != null && getClassKey(f.classType as ClassType) == vKey && f.methodName != null && (f.methodName as String) == "==") {
                        hasEq = true;
                        break;
                      }
                    }
                    if (!hasEq) {
                      this.registerClassMethod(vType, null, "==", null, false, false, null, moduleModel);
                      let eqFunc = this.wasm.functions[this.wasm.functions.length - 1];
                      eqFunc.isCaseClassEq = true;
                    }

                    // Register implicit hashCode for variants
                    var hasHash = false;
                    for (let f in this.wasm.functions) {
                      if (f.classType != null && getClassKey(f.classType as ClassType) == vKey && f.methodName != null && (f.methodName as String) == "hashCode") {
                        hasHash = true;
                        break;
                      }
                    }
                    if (!hasHash) {
                      this.registerClassMethod(vType, null, "hashCode", null, false, false, null, moduleModel);
                      let hashFunc = this.wasm.functions[this.wasm.functions.length - 1];
                      hashFunc.isCaseClassHash = true;
                    }
                  }
                }
              }
            }
            }
          }
          case DeclareFunction: {
            let decl = stmt as DeclareFunction;
            let sym = moduleModel.resolveDeclaration(decl);
            if (sym != null) {
              for (let dec in decl.decorators) {
                if (dec.name == 'intrinsic') {
                  if (dec.args.length == 1) {
                    let intrinsicName = dec.args[0].value;
                    this.wasm.intrinsics[decl.id] = intrinsicName;
                    console.log("REGISTER INTRINSIC: name=" + decl.name.name + " id=" + i32ToString(decl.id as i32) + " intrinsic=" + intrinsicName + " unit=" + unit.ast.path);
                    if (intrinsicName == "wasi_write_string") {
                      this.registerWasiInfra(moduleModel);
                    } else if (intrinsicName == "hash") {
                      this.registerStringHashHelper(moduleModel);
                    }
                    if (intrinsicName == "hash") {
                      this.wasm.ensureHashInfra(moduleModel);
                    }
                  } else {
                    throw new Error("Intrinsic decorator must have exactly one argument");
                  }
                } else if (dec.name == 'external') {
                  if (dec.args.length == 2) {
                     let moduleName = dec.args[0].value;
                     let exportName = dec.args[1].value;
                     let funcType = moduleModel.getNodeType(decl) as FunctionType;
                     let params = new Array<ValType>();
                     for (let pt in funcType.parameters) {
                       params.push(typeToValType(this.wasm, pt));
                     }
                     let returns = new Array<ValType>();
                     mapReturnTypeToWasmResults(this.wasm, funcType.returnType, returns);

                     let isWasi = (moduleName == "wasi_snapshot_preview1");
                     var isGcRef = false;
                     if (returns.length == 1) {
                       match (returns[0]) {
                         case ValTypeAnyRef: { isGcRef = true; }
                         case ValTypeEqRef: { isGcRef = true; }
                         case ValTypeStructRef: { isGcRef = true; }
                         case ValTypeRef: { isGcRef = true; }
                         case ValTypeRefNull: { isGcRef = true; }
                         case _: {}
                       }
                     }

                     if (isGcRef && !isWasi) {
                       let importReturns = new Array<ValType>();
                       importReturns.push(new ValTypeExternRef());
                       let importSig = this.wasm.getSignature(params, importReturns);
                       let importFunc = new WasmFunction(importSig, decl, moduleModel);
                       importFunc.isImport = true;
                       importFunc.importModule = moduleName;
                       importFunc.importName = exportName;
                       importFunc.name = decl.name.name + "_raw_import";
                       this.wasm.functionImports.push(importFunc);

                       let wrapperSig = this.wasm.getSignature(params, returns);
                       let wrapperFunc = new WasmFunction(wrapperSig, decl, moduleModel);
                       wrapperFunc.name = decl.name.name;
                       wrapperFunc.importWrapperTarget = importFunc;
                       this.wasm.functions.push(wrapperFunc);

                       this.wasm.functionMap[sym.id] = wrapperFunc;
                     } else {
                       let sig = this.wasm.getSignature(params, returns);
                       let wasmFunc = new WasmFunction(sig, decl, moduleModel);
                       wasmFunc.isImport = true;
                       wasmFunc.importModule = moduleName;
                       wasmFunc.importName = exportName;
                       this.wasm.functionImports.push(wasmFunc);
                       this.wasm.functionMap[sym.id] = wasmFunc;
                     }
                  } else {
                     throw new Error("External decorator must have exactly two arguments");
                  }
                }
              }
            }
          }
          case TypeAliasDeclaration: {}
          // TODO: Divergence from design doc. Currently we don't emit a global
          // struct for the enum namespace, and instead we only constant-fold
          // MemberExpressions. We should converge either by emitting the struct
          // here, or updating the language to completely erase Enum namespaces
          // at runtime.
          case EnumDeclaration: {}
          case _: {}
        }
      }
    }

    // Pass 1.05: Unified recursive class struct and vtable fields population
    for (let cPair in this.wasm.classStructs) {
      let ct = cPair.value.classType;
      if (ct != null) {
        let ctVal = ct as ClassType;
        let lookupId = if (ctVal.genericSource != null) (ctVal.genericSource as ClassType).id else ctVal.id;
        let cd = if (this.classDecls.has(lookupId)) this.classDecls[lookupId] else null as ClassDeclaration;
        let model = this.getClassModel(ctVal);
        this.populateClassStructAndMethods(ctVal, cd, model);
      }
    }

    // Pass 1.1: Synthesize physical field getters/setters for virtual/inherited slots
    for (let cPair in this.wasm.classStructs) {
      let cName = cPair.key;
      let cStruct = cPair.value;
      if (cStruct.classType != null) {
        let cType = cStruct.classType as ClassType;
        for (let methName in cType.vtable) {
          if (methName.startsWith("get#")) {
            let fieldName = methName.sliceBytes(4, methName.length);
            var hasPhysical = false;
            var backingName = "";
            let lookupName = fieldName;
            let lookupPrivateName = getClassPrivateFieldKey(cName, fieldName);
            let lookupPrivateHashName = getClassPrivateFieldKey(cName, "#" + fieldName);
            for (let f in cStruct.fields) {
              if (f.name != null) {
                let fname = f.name as String;
                if (fname == lookupName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateHashName) {
                  hasPhysical = true;
                  backingName = "#" + fieldName;
                } else if (fname.endsWith("::" + fieldName)) {
                  hasPhysical = true;
                  backingName = fieldName;
                } else if (fname.endsWith("::#" + fieldName)) {
                  hasPhysical = true;
                  backingName = "#" + fieldName;
                }
              }
            }
            if (hasPhysical) {
              var hasGetter = false;
              for (let f in this.wasm.functions) {
                if (f.classType != null && getClassKey(f.classType as ClassType) == getClassKey(cType) && f.methodName != null && (f.methodName as String) == methName) {
                  hasGetter = true;
                  break;
                }
              }
              if (!hasGetter) {
                this.registerClassMethod(cType, null, methName, null, true, false, backingName, this.program.units[0].model);
              }
            }
          } else if (methName.startsWith("set#")) {
            let fieldName = methName.sliceBytes(4, methName.length);
            var hasPhysical = false;
            var backingName = "";
            let lookupName = fieldName;
            let lookupPrivateName = getClassPrivateFieldKey(cName, fieldName);
            let lookupPrivateHashName = getClassPrivateFieldKey(cName, "#" + fieldName);
            for (let f in cStruct.fields) {
              if (f.name != null) {
                let fname = f.name as String;
                if (fname == lookupName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateName) {
                  hasPhysical = true;
                  backingName = lookupName;
                } else if (fname == lookupPrivateHashName) {
                  hasPhysical = true;
                  backingName = "#" + fieldName;
                } else if (fname.endsWith("::" + fieldName)) {
                  hasPhysical = true;
                  backingName = fieldName;
                } else if (fname.endsWith("::#" + fieldName)) {
                  hasPhysical = true;
                  backingName = "#" + fieldName;
                }
              }
            }
            if (hasPhysical) {
              var hasSetter = false;
              for (let f in this.wasm.functions) {
                if (f.classType != null && getClassKey(f.classType as ClassType) == getClassKey(cType) && f.methodName != null && (f.methodName as String) == methName) {
                  hasSetter = true;
                  break;
                }
              }
              if (!hasSetter) {
                this.registerClassMethod(cType, null, methName, null, false, true, backingName, this.program.units[0].model);
              }
            }
          }
        }
      }
    }

    // Pass 1.2: Resolve indices for all synthesized getters and setters
    for (let f in this.wasm.functions) {
      if (f.classType != null) {
        let cType = f.classType as ClassType;
        let cKey = getClassKey(cType);
        if (this.wasm.classStructs.has(cKey)) {
          let st = this.wasm.classStructs[cKey];
          if (f.methodName != null) {
            let mName = f.methodName as String;
            if (mName.startsWith("get#")) {
              let fieldName = mName.sliceBytes(4, mName.length);
              let lookupName = fieldName;
              let lookupPrivateName = getClassPrivateFieldKey(cKey, fieldName);
              let lookupPrivateHashName = getClassPrivateFieldKey(cKey, "#" + fieldName);
              var foundIdx = -1;
              for (var fi = 0; fi < st.fields.length; fi += 1) {
                let fname = st.fields[fi].name;
                if (fname != null) {
                  let fnm = fname as String;
                  if (fnm == lookupName || fnm == lookupPrivateName || fnm == lookupPrivateHashName || fnm.endsWith("::" + fieldName) || fnm.endsWith("::#" + fieldName)) {
                    foundIdx = fi;
                    break;
                  }
                }
              }
              f.getterStruct = st;
              f.getterFieldIndex = foundIdx;
            } else if (mName.startsWith("set#")) {
              let fieldName = mName.sliceBytes(4, mName.length);
              let lookupName = fieldName;
              let lookupPrivateName = getClassPrivateFieldKey(cKey, fieldName);
              let lookupPrivateHashName = getClassPrivateFieldKey(cKey, "#" + fieldName);
              var foundIdx = -1;
              for (var fi = 0; fi < st.fields.length; fi += 1) {
                let fname = st.fields[fi].name;
                if (fname != null) {
                  let fnm = fname as String;
                  if (fnm == lookupName || fnm == lookupPrivateName || fnm == lookupPrivateHashName || fnm.endsWith("::" + fieldName) || fnm.endsWith("::#" + fieldName)) {
                    foundIdx = fi;
                    break;
                  }
                }
              }
              f.setterStruct = st;
              f.setterFieldIndex = foundIdx;
            }
          }
        }
      }
    }

    // Pass 1.5: Build class vtable globals
    for (let cPair in this.wasm.classVTableStructs) {
       let cName = cPair.key;
       let vst = cPair.value;
       var methods = new Array<WasmFunction>();
       let fields = vst.fields;
       var newFields = new Array<WasmField>();
       let cType = vst.classType as ClassType;
       for (var i = 0; i < fields.length; i += 1) {
          let field = fields[i];
          var foundFunc: WasmFunction | null = null;
          var currClass: ClassType | null = cType;
          while (currClass != null && foundFunc == null) {
             for (let f in this.wasm.functions) {
                if (f.classType != null && getClassKey(f.classType as ClassType) == getClassKey(currClass as ClassType) && f.methodName != null && (f.methodName as String) == field.name) {
                   foundFunc = f;
                   break;
                }
             }
             currClass = (currClass as ClassType).superType;
          }
           if (foundFunc != null) {
               newFields.push(new WasmField(field.name, new ValTypeRef((foundFunc as WasmFunction).signature), false));
               methods.push(foundFunc);
           } else {
             // push dummy? or fail?
             newFields.push(field);
             methods.push(this.wasm.functions[0]);
          }
       }
       while (vst.fields.length > 0) {
          let ignored = vst.fields.pop();
       }
       for (var fIdx = 0; fIdx < newFields.length; fIdx += 1) {
          vst.fields.push(newFields[fIdx]);
       }
       
       let vtableInit = new VTableInit(vst, methods);
       let vName = getClassVTableName(cName);
       let vtableGlobal = new WasmGlobal(
         vName,
         vName,
         new ValTypeRef(vst),
         false,
         null,
         vtableInit,
         this.program.units[0].model
       );
       this.wasm.globals.push(vtableGlobal);
       this.wasm.classVTableGlobals[cName] = vtableGlobal;
     }

    // Pass 1.25: Allocate singleton globals for unit variants
    for (let cPair in this.wasm.classStructs) {
      let cName = cPair.key;
      let cStruct = cPair.value;
      if (cStruct.classType != null) {
        let cType = cStruct.classType as ClassType;
        if (cType.isCaseClass && (cType.constructorType == null || (cType.constructorType as FunctionType).parameters.length == 0)) {
          let globalName = getClassSingletonName(cName);
          let globalType = new ValTypeRefNull(cStruct);
          let wasmGlobal = new WasmGlobal(
            globalName,
            globalName,
            globalType,
            false,
            null,
            null,
            this.program.units[0].model
          );
          wasmGlobal.initSingletonStruct = cType;
          this.wasm.globals.push(wasmGlobal);
          this.wasm.classSingletonGlobals[cName] = wasmGlobal;
        }
      }
    }

    let classes = new Array<ClassType>();
    let seenClassKeys = new HashMap<ClassKey, boolean>();

    for (let cPair in this.wasm.classStructs) {
       let cStruct = cPair.value;
       if (cStruct.classType != null) {
          let cType = cStruct.classType as ClassType;
          let cKey = getClassKey(cType);
          if (!seenClassKeys.has(cKey)) {
             seenClassKeys[cKey] = true;
             classes.push(cType);
          }
       }
    }

    for (let unit in this.program.units) {
       let moduleModel = unit.model;
       walk(unit.ast as Node, (n: Node) => true, (n: Node) => {
          if (n is ClassDeclaration) {
             let classDecl = n as ClassDeclaration;
             let ct = this.getClassType(classDecl, moduleModel);
             if (ct != null) {
                let cType = ct as ClassType;
                let cKey = getClassKey(cType);
                if (!seenClassKeys.has(cKey)) {
                   seenClassKeys[cKey] = true;
                   classes.push(cType);
                }
             }
          }
       });
    }

    for (let cType in classes) {
        let isGenericTemplate = cType.typeParameters != null && 
                                (cType.typeParameters as Array<TypeParameterType>).length > 0 && 
                                (cType.typeArguments == null || !isConcrete(cType));
        if (isGenericTemplate) {
           continue;
        }
        let cName = getClassKey(cType);
        let allIfaces = this.collectAllImplementedInterfaces(cType);
       for (let iface in allIfaces) {
           let it = iface as InterfaceType;
            let iName = getInterfaceKey(it);
            let unspecCName = getClassKey(cType.genericSource ?? cType);
            let unspecIName = getInterfaceKey(it.genericSource ?? it);
            let unspecKey = getClassInterfaceKey(unspecCName, unspecIName);
             if (this.wasm.usedInterfaceAdaptations.has(unspecKey)) {
               console.log("PASS 2 GENERATE VTABLE FOR: " + classInterfaceKeyToString(getClassInterfaceKey(cName, iName)) + " (unspec=" + classInterfaceKeyToString(unspecKey) + ")");
               let key = getClassInterfaceKey(cName, iName);
              // Retrieve the interface's vtable structure definition.
              let vst = this.wasm.interfaceVTableStructs[iName];
             
             // Resolve the implementing function for each method slot in the interface vtable.
             var methods = new Array<WasmFunction>();
             for (var i = 0; i < vst.fields.length; i += 1) {
                let field = vst.fields[i];
                var foundFunc: WasmFunction | null = null;
                var currClass: ClassType | null = cType;
                
                // Look up the method in the inheritance hierarchy (traversing up through superclasses).
                 while (currClass != null && foundFunc == null) {
                    for (let f in this.wasm.functions) {
                        // Match functions where the class and method name match the current slot.
                        let isMatch = f.methodName != null && field.name != null && 
                                      (f.methodName as String) == (field.name as String);
                        if (f.classType != null && getClassKey(f.classType as ClassType) == getClassKey(currClass as ClassType) && isMatch) {
                           foundFunc = f;
                           break;
                        }
                     }currClass = (currClass as ClassType).superType;
                }
                  if (foundFunc != null) {
                     console.log("VTABLE OK: Class: " + (cName as String) + " Interface: " + (iName as String) + " Method: " + (field.name as String));
                     // Generate a trampoline function to adapt the interface-level call signature
                     // to the specific class method signature.
                     let targetFunc = foundFunc as WasmFunction;
                     let trampSig = getInterfaceMemberSignature(this.wasm, it, field.name);
                     let trampFunc = new WasmFunction(trampSig, null, this.program.units[0].model);
                     trampFunc.name = getInterfaceTrampolineName(cName, iName, field.name);
                     trampFunc.interfaceTrampolineTarget = targetFunc;
                     this.wasm.functions.push(trampFunc);
                     methods.push(trampFunc);
                  } else {
                     console.log("VTABLE FAIL: Class: " + (cName as String) + " Interface: " + (iName as String) + " Method: " + (field.name as String));
                     // Fallback to a placeholder function (index 0) if no implementation was found.
                     methods.push(this.wasm.functions[0]);
                  }
             }
             
             let vtableInit = new VTableInit(vst, methods);
             let viName = getClassInterfaceVTableName(cName, iName);
             let vtableGlobal = new WasmGlobal(
                viName,
                viName,
                new ValTypeRef(vst),
                false,
                null,
                vtableInit,
                this.program.units[0].model
             );
             this.wasm.globals.push(vtableGlobal);
             this.wasm.classInterfaceVTables[key] = vtableGlobal;
           }
       }
    }

    // Pass 2: Walk the AST of registered functions (including newly registered closures)
    // to discover and register nested closures.
    var fIdx = 0;
    while (fIdx < this.wasm.functions.length) {
      let f = this.wasm.functions[fIdx];
      if (f.node != null) {
        let funcNode = f.node as Node;
        var bodyNode: Node | null = null;
        match (funcNode) {
          case FunctionExpression as fExpr: {
            bodyNode = fExpr.body as Node;
          }
          case MethodDefinition as mDef: {
            bodyNode = mDef.body;
          }
          case AccessorDeclaration as acc: {
            bodyNode = acc.getter;
          }
          case SetterInfo as si: {
            bodyNode = si.body;
          }
          case _: {}
        }
        
        if (bodyNode != null) {
          walk(bodyNode as Node, (n: Node) => true, (n: Node) => {
            if (n is FunctionExpression) {
              let funcExpr = n as FunctionExpression;
              var isRegistered = false;
              
              let targetClassType = f.classType;
              let targetClassKey = if (targetClassType != null) (getClassKey(targetClassType as ClassType) as String) else "";
              
              for (let otherF in this.wasm.functions) {
                if (otherF.node != null && otherF.node.id == funcExpr.id) {
                  let otherClassType = otherF.classType;
                  let otherClassKey = if (otherClassType != null) (getClassKey(otherClassType as ClassType) as String) else "";
                  if (otherClassKey == targetClassKey) {
                    isRegistered = true;
                  }
                }
              }
              if (!isRegistered) {
                this.registerClosure(funcExpr, f.model, f);
              }
            }
          });
        }
      }
      fIdx += 1;
    }


  }

  registerClosure(funcExpr: FunctionExpression, model: SemanticModel, enclosingFunc: WasmFunction): void {
    let captureInfo = analyzeCaptures(funcExpr, model);
    let rawFuncTypeNode = model.getNodeType(funcExpr);
    let classType = enclosingFunc.classType;
    let ctParams = if (classType != null) getClassTypeParameters(classType as ClassType) else null;
    let funcTypeNode = if (classType != null) {
      substituteTypeParamsInCodegen(ctParams, (classType as ClassType).typeArguments, rawFuncTypeNode as Type)
    } else {
      rawFuncTypeNode
    };
    
    let params = new Array<ValType>();
    params.push(new ValTypeEqRef()); // ctx
    let returns = new Array<ValType>();
    
    if (funcTypeNode is FunctionType) {
      let ft = funcTypeNode as FunctionType;
      for (let p in ft.parameters) {
        params.push(typeToValType(this.wasm, p));
      }
      mapReturnTypeToWasmResults(this.wasm, ft.returnType, returns);
    } else {
      returns.push(new ValTypeI32());
    }
    
    let sig = this.wasm.getSignature(params, returns);
    let wasmFunc = new WasmFunction(sig, funcExpr, model);
    wasmFunc.isClosure = true;
    wasmFunc.isReferenceTaken = true;
    wasmFunc.classType = classType;
    
    let classKey = if (classType != null) (getClassKey(classType as ClassType) as String) else "";
    let suffix = if (classKey.length > 0) "_" + classKey else "";

    // Generate location-based stable identifier
    let fileBase = sanitizeName(getFileNameBase(getNodeFilePath(model, funcExpr)));
    let locStr = if (funcExpr.loc != null) {
      let loc = funcExpr.loc as SourceLocation;
      "L" + i32ToString(loc.line) + "C" + i32ToString(loc.column)
    } else {
      i32ToString(funcExpr.id as i32)
    };

    wasmFunc.name = "closure_impl_" + fileBase + suffix + "_" + locStr;
    
    wasmFunc.capturesThis = captureInfo.capturesThis;
    wasmFunc.mutableCaptures = captureInfo.mutableCaptures;
    for (let sym in captureInfo.captures) {
      this.wasm.symbolNames[sym.id] = sym.name;
      wasmFunc.captures.push(sym.id);
    }
    
    // Find enclosing class if 'this' is captured
    var enclosingClassType = classType;
    if (enclosingClassType == null && captureInfo.capturesThis) {
      var curr = funcExpr as Node;
      while (true) {
        let parent = model.getParent(curr);
        if (parent == null) { break; }
        if (parent is ClassDeclaration) {
          let cd = parent as ClassDeclaration;
          let ct = model.getNodeType(cd);
          if (ct is ClassType) {
            enclosingClassType = ct as ClassType;
            break;
          }
        }
        curr = parent as Node;
      }
    }
    
    let fields = new Array<WasmField>();
    if (captureInfo.capturesThis && enclosingClassType != null) {
      let ct = enclosingClassType as ClassType;
      var thisValType: ValType = new ValTypeAnyRef();
      if (this.wasm.classStructs.has(getClassKey(ct))) {
        thisValType = new ValTypeRefNull(this.wasm.classStructs[getClassKey(ct)] as WasmStruct);
      } else {
        thisValType = typeToValType(this.wasm, ct);
      }
      fields.push(new WasmField("this", thisValType, false));
    }
    
    for (let sym in captureInfo.captures) {
      let rawSymType = model.getBindingType(sym);
      let symType = if (classType != null) {
        substituteTypeParamsInCodegen(ctParams, (classType as ClassType).typeArguments, rawSymType as Type)
      } else {
        rawSymType
      };
      let valType = typeToValType(this.wasm, symType);
      var fieldType: ValType = valType;
      if (captureInfo.mutableCaptures.has(sym.id)) {
        let cellStruct = getCellStruct(this.wasm, valType);
        fieldType = new ValTypeRefNull(cellStruct);
      }
      fields.push(new WasmField("capture_" + i32ToString(sym.id as i32), fieldType, false));
    }
    
    let contextStructName = "ClosureCtx_" + fileBase + suffix + "_" + locStr;
    let contextStruct = new WasmStruct(contextStructName, fields);
    this.wasm.types.push(contextStruct);
    wasmFunc.contextStruct = contextStruct;
    
    this.wasm.addFunction(wasmFunc);
    this.wasm.closureFunctions[funcExpr] = wasmFunc;
    
    let closureKey = i32ToString(funcExpr.id as i32) + "_" + classKey;
    this.wasm.specializedClosures[closureKey] = wasmFunc;
  }
}

let getNodeFilePath = (model: SemanticModel, node: Node): String => {
  var curr: Node | null = node;
  while (curr != null) {
    if (curr is Module) {
      return (curr as Module).path;
    }
    curr = model.getParent(curr as Node);
  }
  return "";
};

let getFileNameBase = (path: String): String => {
  var lastSlash = -1;
  var i = 0;
  let len = path.length;
  while (i < len) {
    if (path.sliceBytes(i, i + 1) == "/" || path.sliceBytes(i, i + 1) == "\\") {
      lastSlash = i;
    }
    i += 1;
  }
  if (lastSlash >= 0) {
    return path.sliceBytes(lastSlash + 1, len);
  }
  return path;
};

let sanitizeName = (s: String): String => {
  let sb = new StringBuilder();
  var i = 0;
  let len = s.length;
  while (i < len) {
    let char = s.sliceBytes(i, i + 1);
    if (char == "." || char == "-" || char == "/" || char == "\\") {
      sb.append("_");
    } else {
      sb.append(char);
    }
    i += 1;
  }
  return sb.toString();
};
