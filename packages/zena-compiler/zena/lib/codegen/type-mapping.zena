import { 
  Type, FunctionType, I32Type, F32Type, F64Type, VoidType, BooleanType, ClassType, 
  InterfaceType, TypeAliasType, EnumType, applyTypeIntrinsic, U32Type, I64Type, U64Type, ArrayType, NullType,
  U8Type, U16Type, I8Type, I16Type, V128Type,
  UnknownType, ErrorType, AnyRefType, EqRefType, ExternRefType, NeverType, HoleType,
  FieldInfo, MethodInfo, typeToString, TypeParameterType, ThisType,
  UnionType, InlineTupleType, InlineParamType, inlineOf, baseType, BoolLiteralType, NumLiteralType, StringLiteralType,
  RecordType, TupleType, MixinType, ErasedType, countCodegenFunctionType,
  countCodegenSubstitution, classShapeStamp, interfaceShapeStamp, internFunctionType, mergeRow, mergeTupleRow } from '../types.zena';
import { 
  WasmModule, WasmStruct, WasmField, WasmSignature, WasmFunction, RecordDispatchInfo,
  sortWasmFields, WasmArray
} from './wasm-module.zena';
import {
  ValType, ValTypeVoid, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeI8, ValTypeI16, ValTypeV128, ValTypeAnyRef, ValTypeStructRef, ValTypeEqRef, ValTypeRefNull, ValTypeRef, ValTypeRefExtern, ValTypeExternRef, ValTypeNullRef, isNullableAnyRef, valTypeToOpcode, valTypeEquals, WasmType,
} from './wasm.zena';
import { compareStrings, presentWordCount, presentWordName, getSignatureKey } from './codegen-utils.zena';
import {
  getMemberRootClass, getClassKey, getClassMethodKey, getInterfaceKey, InterfaceKey, CellKey, ClosureKey,
  unwrapAliases,
} from './codegen-utils.zena';
import { HashMap } from 'zena:collections';
import { growable } from 'zena:core';

export function getClassTypeParameters(ct: ClassType): Array<TypeParameterType> | null {
  return (ct.genericSource ?? ct).typeParameters;
}

export function getInterfaceTypeParameters(it: InterfaceType): Array<TypeParameterType> | null {
  return (it.genericSource ?? it).typeParameters;
}

/**
 * Counts each outermost call for the census; the recursion below goes
 * through `substituteTypeParamsInCodegenInner` directly.
 */
export function substituteTypeParamsInCodegen(
  wasm: WasmModule,
  typeParams: Array<TypeParameterType> | null,
  typeArgs: Array<Type> | null,
  t: Type
): Type {
  if (typeParams == null || typeArgs == null || typeParams.length == 0 || typeArgs.length == 0) {
    return t;
  }
  // Memoized per module on (input, parameters, arguments), all by
  // identity. The class and interface cases below have tables of their
  // own; this one covers the function, union, array and tuple results
  // they return — which were built afresh at every call, 137K
  // function types in the `zena` module compile.
  // The parameters, a separator, the arguments.
  let memo = wasm.substitutionResultsFor(t).begin();
  for (let p in typeParams) {
    memo.add(p.uid);
  }
  let node = memo.sep().addAll(typeArgs).entry();
  let done = node.value;
  if (done != null) {
    return done;
  }
  let result = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, t);
  node.value = result;
  countCodegenSubstitution(t, typeArgs, result);
  return result;
}

function substituteTypeParamsInCodegenInner(
  wasm: WasmModule,
  typeParams: Array<TypeParameterType> | null,
  typeArgs: Array<Type> | null,
  t: Type
): Type {
  if (typeParams == null || typeArgs == null || typeParams.length == 0 || typeArgs.length == 0) {
    return t;
  }
  return match (t) {
    case TypeParameterType as tp: {
      var found: Type | null = null;
      for (var i = 0; i < typeParams.length; i += 1) {
        if (typeParams[i] === tp && i < typeArgs.length) {
          found = typeArgs[i];
          break;
        }
      }
      if (found != null) {
        return found;
      }
      t
    }
    case ArrayType {elementType, elementsMutable}: {
      let sub = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, elementType);
      if (sub === elementType) {
        return t;
      }
      new ArrayType(sub, elementsMutable)
    }
    case TupleType {elementTypes, row, rowIndex}: {
      let newElems = new Array<Type>(elementTypes.length);
      var elemsChanged = false;
      for (let el in elementTypes) {
        let sub = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, el);
        newElems.push(sub);
        if (sub !== el) {
          elemsChanged = true;
        }
      }
      if (row != null) {
        return mergeTupleRow(newElems, rowIndex,
            substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, row));
      }
      if (!elemsChanged) {
        return t;
      }
      new TupleType(newElems, null, 0)
    }
    case InlineTupleType {elementTypes}: {
      let newElems = new Array<Type>(elementTypes.length);
      var elemsChanged = false;
      for (let el in elementTypes) {
        let sub = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, el);
        newElems.push(sub);
        if (sub !== el) {
          elemsChanged = true;
        }
      }
      if (!elemsChanged) {
        return t;
      }
      new InlineTupleType(newElems)
    }
    case InlineParamType {param}: {
      let sub = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, param);
      if (sub === param) t else inlineOf(sub)
    }
    case UnionType {types}: {
      let newTypes = new Array<Type>(types.length);
      var typesChanged = false;
      for (let ut in types) {
        let sub = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, ut);
        newTypes.push(sub);
        if (sub !== ut) {
          typesChanged = true;
        }
      }
      if (!typesChanged) {
        return t;
      }
      wasm.interner.union(newTypes)
    }
    case RecordType as rec: {
      var propsChanged = false;
      let newProps = new Map<String, Type>();
      let keys = rec.properties.keys();
      for (let key in keys) {
        let original = rec.properties[key];
        let sub = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, original);
        newProps[key] = sub;
        if (sub !== original) {
          propsChanged = true;
        }
      }
      let row = rec.row;
      if (row != null) {
        return mergeRow(newProps, rec.optionalProperties,
            substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, row));
      }
      if (!propsChanged) {
        return rec;
      }
      let newRec = new RecordType(newProps, rec.optionalProperties, null, rec.isExistential);
      newRec
    }
    case FunctionType as ft: {
      let newParams = new Array<Type>(ft.parameters.length);
      var paramsChanged = false;
      for (let p in ft.parameters) {
        let sub = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, p);
        newParams.push(sub);
        if (sub !== p) {
          paramsChanged = true;
        }
      }
      let newRet = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, ft.returnType);
      let retChanged = newRet !== ft.returnType;
      
      var argsChanged = false;
      var newArgs: Array<Type> | null = null;
      let {typeArguments} = ft;
      if (typeArguments != null) {
        newArgs = new Array<Type>(typeArguments.length);
        for (let arg in typeArguments) {
          let sub = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, arg);
          newArgs.push(sub);
          if (sub !== arg) {
            argsChanged = true;
          }
        }
      }
      
      if (!paramsChanged && !retChanged && !argsChanged) {
        return ft;
      }
      
      let newFt = internFunctionType(newParams, newRet, ft.info, ft.typeParameters, newArgs, ft.genericSource, ft.overloads);
      newFt.functionSymbolId = ft.functionSymbolId;
      newFt.functionSymbolName = ft.functionSymbolName;
      countCodegenFunctionType(0);
      newFt
    }
    case TypeAliasType as ta: {
      // `Cell<T>` in a body specialized at `T = i32` is `Cell<i32>`, whose
      // representation is i32. Without this case the alias came back
      // unsubstituted, `typeToValType` read its still-generic `target` as
      // anyref, and a cast that should have been a no-op reached
      // `scalarConvert` as anyref-to-i32 and bailed with "cast kind".
      //
      // Both halves have to move: the arguments feed `eraseTypeParameters`,
      // and `target` is what `typeToValType` reads. An alias's own type
      // parameters are distinct objects from the enclosing function's, and
      // substitution matches by identity, so no capture is possible here.
      var changed = false;
      var newArgs: Array<Type> | null = null;
      let {typeArguments} = ta;
      if (typeArguments != null) {
        let srcArgs = typeArguments;
        let acc = new Array<Type>(srcArgs.length);
        for (let arg in srcArgs) {
          let sub = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, arg);
          acc.push(sub);
          if (sub !== arg) { changed = true; }
        }
        newArgs = acc;
      }
      // `resolving` marks an alias whose target is mid-computation; reading
      // it would not terminate.
      let newTarget = if (ta.resolving) {
        ta.target
      } else {
        ta.resolving = true;
        let subTarget = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, ta.target);
        ta.resolving = false;
        subTarget
      };
      if (newTarget !== ta.target) { changed = true; }
      if (!changed) { return ta; }
      let inst = new TypeAliasType(
        ta.name, ta.typeParameters, newTarget, ta.isDistinct, newArgs,
        ta.isOpaque, ta.declaringModule
      );
      inst.resolving = ta.resolving;
      inst.intrinsicName = ta.intrinsicName;
      // A substitution that closes an intrinsic alias's argument
      // normalizes the alias away, mirroring the checker's
      // substitution (the sibling-match rule).
      if (inst.intrinsicName != null) {
        applyTypeIntrinsic(inst)
      } else {
        inst
      }
    }
    case ClassType as ct: {
      var hasArgs = false;
      let ctArgsVal = new Array<Type>();
      let ctParams = getClassTypeParameters(ct);
      let {typeArguments} = ct;
      if (typeArguments != null) {
        hasArgs = true;
        for (let arg in typeArguments) {
          ctArgsVal.push(arg);
        }
      } else if (typeParams != null && typeArgs != null && ctParams != null) {
        hasArgs = true;
        for (let param in ctParams) {
          ctArgsVal.push(param as Type);
        }
      }
      if (hasArgs && ctArgsVal.length > 0) {
        let newArgs = new Array<Type>(ctArgsVal.length);
        var argsChanged = false;
        for (let arg in ctArgsVal) {
          let sub = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, arg);
          newArgs.push(sub);
          if (sub !== arg) {
            argsChanged = true;
          }
        }
        if (!argsChanged && ct.typeArguments != null) {
          return ct;
        }

        // Share one instantiation per argument list when the source is a
        // pure generic template. Instantiations of a partially-substituted
        // source have their outer context baked into their supertypes, so
        // those are never shared.
        // Share one instantiation per (source instance, argument uids).
        // Method signatures mention the same generic classes over and over;
        // without this every mention deep-copies the class (supertypes,
        // constructor type). The result is determined by the source and the
        // substituted arguments: names free in the source's supertypes are
        // either its own parameters (bound through newArgs, which the key
        // covers) or already concrete.
        var instKey = "";
        for (let arg in newArgs) {
          instKey = `${instKey}${i32ToString(arg.uid)},`;
        }
        let icacheVal = wasm.substitutionsFor(ct).instantiations;
        if (let (true, hit) = icacheVal.get(instKey)) {
          return hit;
        }

        let inst = new ClassType(ct.id, ct.symbolId, ct.name);
        // Registered before its supertypes and constructor are
        // substituted: a class whose constructor or supertype mentions
        // its own instantiation (`MapEntry<K, V>`'s `next` parameter)
        // reaches this same entry on the way down and gets the object
        // under construction back, as the checker's substitution frames
        // do. Registering only once built made that recursion
        // unbounded on any cyclic input.
        icacheVal[instKey] = inst;
        // One object per (source, arguments) for this module, which is
        // what the stamp marks: union interning keys on it.
        inst.shapeStamp = classShapeStamp(ct);
        inst.typeParameters = ctParams;
        inst.typeArguments = newArgs;
        inst.genericSource = ct.genericSource ?? ct;
        let ctParamsLen = if (ctParams != null) {
          ctParams.length
        } else {
          0
        };
        let combinedParams = new Array<TypeParameterType>(ctParamsLen + typeParams.length);
        let combinedArgs = new Array<Type>(ctParamsLen + typeArgs.length);
        if (ctParams != null) {
          for (let p in ctParams) {
            combinedParams.push(p);
          }
          for (let a in newArgs) {
            combinedArgs.push(a);
          }
        }
        for (let p in typeParams) {
          combinedParams.push(p);
        }
        for (let a in typeArgs) {
          combinedArgs.push(a);
        }

        let {superType} = ct;
        if (superType != null) {
          inst.superType = substituteTypeParamsInCodegenInner(wasm, combinedParams, combinedArgs, superType as Type) as ClassType;
        }
        for (let impl in ct.implementsList) {
          inst.implementsList.push(substituteTypeParamsInCodegenInner(wasm, combinedParams, combinedArgs, impl) as InterfaceType);
        }
        for (let m in ct.mixins) {
          let subM = substituteTypeParamsInCodegenInner(wasm, combinedParams, combinedArgs, m);
          inst.mixins.push(subM as MixinType);
        }
        inst.members = ct.members;
        inst.constructorType = if (ct.constructorType != null) {
          let ctor = ct.constructorType as FunctionType;
          let newParams = new Array<Type>(ctor.parameters.length);
          for (let p in ctor.parameters) {
            let sub = substituteTypeParamsInCodegenInner(wasm, combinedParams, combinedArgs, p);
            newParams.push(sub);
          }
          let newFt = internFunctionType(newParams, ctor.returnType, ctor.info);
          newFt.functionSymbolId = ctor.functionSymbolId;
          newFt.functionSymbolName = ctor.functionSymbolName;
          countCodegenFunctionType(1);
          newFt
        } else {
          null
        };
        inst.fieldSetterNames = ct.fieldSetterNames;
        inst.decoratorSubjectName = ct.decoratorSubjectName;
        inst.decoratorFieldName = ct.decoratorFieldName;
        inst.decoratedFields = ct.decoratedFields;
        inst.decoratorSharedScopeKey = ct.decoratorSharedScopeKey;
        inst.isFinal = ct.isFinal;
        inst.isCaseClass = ct.isCaseClass;
        inst.derivesEquality = ct.derivesEquality;
        inst.isAbstract = ct.isAbstract;
        inst.isExtension = ct.isExtension;
        inst.isSealed = ct.isSealed;
        inst.isMixinIntermediate = ct.isMixinIntermediate;
        inst.privateScopeKey = ct.privateScopeKey;
        inst.sealedVariants = ct.sealedVariants;
        inst.declaredFields = ct.declaredFields;
        inst.forwardVariantNames = ct.forwardVariantNames;
        let {onType} = ct;
        if (onType != null) {
          inst.onType = substituteTypeParamsInCodegenInner(wasm, combinedParams, combinedArgs, onType);
        }
        inst.sourcePath = ct.sourcePath;
        inst
      } else {
        ct
      }
    }
    case InterfaceType as it: {
      var hasArgs = false;
      let itArgsVal = new Array<Type>();
      let itParams = getInterfaceTypeParameters(it);
      let {typeArguments} = it;
      if (typeArguments != null) {
        hasArgs = true;
        for (let arg in typeArguments) {
          itArgsVal.push(arg);
        }
      } else if (typeParams != null && typeArgs != null && itParams != null) {
        hasArgs = true;
        for (let param in itParams) {
          itArgsVal.push(param as Type);
        }
      }
      if (hasArgs && itArgsVal.length > 0) {
        let newArgs = new Array<Type>(itArgsVal.length);
        var argsChanged = false;
        for (let arg in itArgsVal) {
          let sub = substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, arg);
          newArgs.push(sub);
          if (sub !== arg) {
            argsChanged = true;
          }
        }
        if (!argsChanged && it.typeArguments != null) {
          return it;
        }
        // One instantiation per (source, argument uids), registered
        // before its extends list is substituted so that an interface
        // whose extends list mentions it again (`Iterable<T>` through
        // `Iterator<T>`) gets this one back rather than recursing
        // without end.
        var instKey = "";
        for (let arg in newArgs) {
          instKey = `${instKey}${i32ToString(arg.uid)},`;
        }
        let icacheVal = wasm.interfaceInstantiationsFor(it);
        if (let (true, hit) = icacheVal.get(instKey)) {
          return hit;
        }
        let inst = new InterfaceType(it.id, it.symbolId, it.name);
        icacheVal[instKey] = inst;
        inst.shapeStamp = interfaceShapeStamp(it);
        inst.typeParameters = itParams;
        inst.typeArguments = newArgs;
        inst.genericSource = it.genericSource ?? it;
        let combinedParams = new Array<TypeParameterType>();
        let combinedArgs = new Array<Type>();
        if (itParams != null) {
          for (let p in itParams) {
            combinedParams.push(p);
          }
          for (let a in newArgs) {
            combinedArgs.push(a);
          }
        }
        for (let p in typeParams) {
          combinedParams.push(p);
        }
        for (let a in typeArgs) {
          combinedArgs.push(a);
        }
        let newExtends = new Array<InterfaceType>(it.extendsList.length);
        for (let ext in it.extendsList) {
          newExtends.push(substituteTypeParamsInCodegenInner(wasm, combinedParams, combinedArgs, ext) as InterfaceType);
        }
        inst.extendsList = newExtends;
        inst.members = it.members;
        inst.sourcePath = it.sourcePath;
        inst
      } else {
        it
      }
    }
    case MixinType as mt: {
      var hasArgs = false;
      let mtArgsVal = new Array<Type>();
      let mtParams = mt.typeParameters;
      let {typeArguments} = mt;
      if (typeArguments != null) {
        hasArgs = true;
        for (let arg in typeArguments) {
          mtArgsVal.push(arg);
        }
      } else if (typeParams != null && typeArgs != null && mtParams != null) {
        hasArgs = true;
        for (let param in mtParams) {
          mtArgsVal.push(param as Type);
        }
      }
      if (hasArgs && mtArgsVal.length > 0) {
        let newArgs = new Array<Type>(mtArgsVal.length);
        for (let arg in mtArgsVal) {
          newArgs.push(substituteTypeParamsInCodegenInner(wasm, typeParams, typeArgs, arg));
        }
        let inst = new MixinType(mt.name);
        inst.typeParameters = mtParams;
        inst.typeArguments = newArgs;
        inst.genericSource = mt.genericSource ?? mt;
        let combinedParams = new Array<TypeParameterType>();
        let combinedArgs = new Array<Type>();
        if (mtParams != null) {
          for (let p in mtParams) {
            combinedParams.push(p);
          }
          for (let a in newArgs) {
            combinedArgs.push(a);
          }
        }
        for (let p in typeParams) {
          combinedParams.push(p);
        }
        for (let a in typeArgs) {
          combinedArgs.push(a);
        }
        let {onType} = mt;
        if (onType != null) {
          inst.onType = substituteTypeParamsInCodegenInner(wasm, combinedParams, combinedArgs, onType);
        }
        for (let m in mt.mixins) {
          let subM = substituteTypeParamsInCodegenInner(wasm, combinedParams, combinedArgs, m);
          inst.mixins.push(subM as MixinType);
        }
        inst.members = mt.members;
        inst.sourcePath = mt.sourcePath;
        inst
      } else {
        mt
      }
    }
    case _: t
  };
}

function addTransitiveInterfaces(
  wasm: WasmModule,
  it: InterfaceType,
  allParams: GrowableArray<TypeParameterType>,
  allArgs: GrowableArray<Type>,
  seen: HashMap<String, boolean>
): void {
  let key = getInterfaceKey(it) as String;
  if (seen.has(key)) {
    return;
  }
  seen[key] = true;
  
  let genericSource = it.genericSource ?? it;
  let itParams = getInterfaceTypeParameters(it);
  let {typeParameters} = genericSource;
  if (typeParameters != null && it.typeArguments != null && itParams != null) {
    let tps = typeParameters;
    let tas = it.typeArguments as Array<Type>;
    for (var i = 0; i < tps.length; i += 1) {
      allParams.push(tps[i]);
      if (i < tas.length) {
        allArgs.push(tas[i]);
      } else {
        allArgs.push(new ErasedType());
      }
    }
  }
  
  for (let ext in it.extendsList) {
    let itParamsVal = getInterfaceTypeParameters(it);
    let resolvedExt = substituteTypeParamsInCodegen(wasm, itParamsVal, it.typeArguments, ext) as InterfaceType;
    addTransitiveInterfaces(wasm, resolvedExt, allParams, allArgs, seen);
  }
}

function addClassTransitiveInterfaces(
  wasm: WasmModule,
  ct: ClassType,
  allParams: GrowableArray<TypeParameterType>,
  allArgs: GrowableArray<Type>,
  seen: HashMap<String, boolean>
): void {
  let ctParams = getClassTypeParameters(ct);
  for (let impl in ct.implementsList) {
    if (impl is InterfaceType) {
      let resolved = substituteTypeParamsInCodegen(wasm, ctParams, ct.typeArguments, impl) as InterfaceType;
      addTransitiveInterfaces(wasm, resolved, allParams, allArgs, seen);
    }
  }
  let {superType} = ct;
  if (superType != null) {
    let superCt = superType;
    let superResolved = substituteTypeParamsInCodegen(wasm, ctParams, ct.typeArguments, superCt) as ClassType;
    
    // Add superclass's own type parameters
    let genericSource = superResolved.genericSource ?? superResolved;
    let superCtParams = getClassTypeParameters(superResolved);
    let {typeParameters} = genericSource;
    if (typeParameters != null && superResolved.typeArguments != null && superCtParams != null) {
      let tps = typeParameters;
      let tas = superResolved.typeArguments as Array<Type>;
      for (var i = 0; i < tps.length; i += 1) {
        allParams.push(tps[i]);
        if (i < tas.length) {
          allArgs.push(tas[i]);
        } else {
          allArgs.push(new ErasedType());
        }
      }
    }
    
    // Recursively add superclass's interfaces and superclasses
    addClassTransitiveInterfaces(wasm, superResolved, allParams, allArgs, seen);
  }
}

function addTransitiveMixins(
  mt: MixinType,
  allParams: GrowableArray<TypeParameterType>,
  allArgs: GrowableArray<Type>,
  seen: HashMap<String, boolean>
): void {
  let key = `${mt.sourcePath}::${mt.name}`;
  if (seen.has(key)) {
    return;
  }
  seen[key] = true;
  
  let mtParams = mt.typeParameters;
  if (mtParams != null && mt.typeArguments != null) {
    let tas = mt.typeArguments as Array<Type>;
    for (var i = 0; i < mtParams.length; i += 1) {
      allParams.push(mtParams[i]);
      if (i < tas.length) {
        allArgs.push(tas[i]);
      } else {
        allArgs.push(new ErasedType());
      }
    }
  }
  
  for (let composed in mt.mixins) {
    addTransitiveMixins(composed, allParams, allArgs, seen);
  }
}

function addClassTransitiveMixins(
  ct: ClassType,
  allParams: GrowableArray<TypeParameterType>,
  allArgs: GrowableArray<Type>,
  seen: HashMap<String, boolean>
): void {
  for (let m in ct.mixins) {
    addTransitiveMixins(m, allParams, allArgs, seen);
  }
  let {superType} = ct;
  if (superType != null) {
    addClassTransitiveMixins(superType, allParams, allArgs, seen);
  }
}

export function substituteTypeParamsInClassContext(
    wasm: WasmModule, classType: ClassType | null, t: Type): Type {
  if (classType == null) {
    return t;
  }

  let subs = wasm.substitutionsFor(classType);
  if (subs.params == null || subs.args == null) {
    let params = new Array<TypeParameterType>();
    let args = new Array<Type>();
    
    // 1. Add class's own type arguments
    let ctParams = getClassTypeParameters(classType);
    if (ctParams != null && classType.typeArguments != null) {
      let tas = classType.typeArguments as Array<Type>;
      for (var i = 0; i < ctParams.length; i += 1) {
        params.push(ctParams[i]);
        if (i < tas.length) {
          args.push(tas[i]);
        } else {
          args.push(new ErasedType());
        }
      }
    }
    
    // 2. Add implements list and superType recursively
    let seen = new Map<String, boolean>();
    addClassTransitiveInterfaces(wasm, classType, params, args, seen);
    
    // 3. Add mixins transitively
    let seenMixins = new Map<String, boolean>();
    addClassTransitiveMixins(classType, params, args, seenMixins);
    
    subs.params = params;
    subs.args = args;
  }

  let cacheVal = subs.substCache;
  if (let (true, hit) = cacheVal.get(t)) {
    return hit;
  }

  let substituted = substituteTypeParamsInCodegen(wasm, subs.params, subs.args, t);
  let result = mapMixinThisInType(classType, substituted);
  cacheVal[t] = result;
  return result;
}

/**
 * The (substituted) InterfaceType named `name` that `ct` implements,
 * searching the class's own implements list, its superclasses', and
 * every interface's transitive extends chain. Was duplicated
 * per-module (stmt/loops.zena, reachability/visitor.zena, ir/); this
 * is the one shared copy.
 */
export function findImplementedInterfaceTransitive(wasm: WasmModule, ct: ClassType, name: String): InterfaceType | null {
  let seen = new Map<InterfaceKey, boolean>();
  let queue = new Array<InterfaceType>();

  let ctParams = getClassTypeParameters(ct);
  for (let impl in ct.implementsList) {
    let resolved = substituteTypeParamsInCodegen(wasm, ctParams, ct.typeArguments, impl) as InterfaceType;
    queue.push(resolved);
  }

  var currSuper = ct.superType;
  while (currSuper != null) {
    let superCt = currSuper;
    let superCtParams = getClassTypeParameters(superCt);
    for (let impl in superCt.implementsList) {
      let resolved = substituteTypeParamsInCodegen(wasm, superCtParams, superCt.typeArguments, impl) as InterfaceType;
      queue.push(resolved);
    }
    currSuper = superCt.superType;
  }

  var head = 0;
  while (head < queue.length) {
    let it = queue[head];
    head += 1;

    let key = getInterfaceKey(it);
    if (!seen.has(key)) {
      seen[key] = true;
      if (it.name == name) {
        return it;
      }
      let itParams = getInterfaceTypeParameters(it);
      for (let ext in it.extendsList) {
        let resolvedExt = substituteTypeParamsInCodegen(wasm, itParams, it.typeArguments, ext) as InterfaceType;
        queue.push(resolvedExt);
      }
    }
  }
  return null;
}

/**
 * The (substituted) InterfaceType named `name` that `it` is or extends,
 * transitively — findImplementedInterfaceTransitive for a receiver that
 * is an interface value rather than a class.
 */
export function findExtendedInterfaceTransitive(wasm: WasmModule, it: InterfaceType, name: String): InterfaceType | null {
  let seen = new Map<InterfaceKey, boolean>();
  let queue = growable<InterfaceType>([it]);
  var head = 0;
  while (head < queue.length) {
    let cur = queue[head];
    head += 1;
    let key = getInterfaceKey(cur);
    if (!seen.has(key)) {
      seen[key] = true;
      if (cur.name == name) {
        return cur;
      }
      let curParams = getInterfaceTypeParameters(cur);
      for (let ext in cur.extendsList) {
        let resolvedExt = substituteTypeParamsInCodegen(wasm, curParams, cur.typeArguments, ext) as InterfaceType;
        queue.push(resolvedExt);
      }
    }
  }
  return null;
}

export function substituteTypeParamsInFunctionContext(wasm: WasmModule, wasmFunction: WasmFunction | null, t: Type): Type {
  if (wasmFunction == null) {
    return t;
  }
  
  var cache = wasmFunction.codegenSubstCache;
  if (cache == null) {
    let fresh = new Map<Type, Type>();
    wasmFunction.codegenSubstCache = fresh;
    cache = fresh;
  }
  if (let (true, hit) = cache.get(t)) {
    return hit;
  }

  var substituted = t;
  // A field decorator's body is compiled once per application, and one
  // class may apply the same generic decorator to fields of different
  // types. The host's flattened context holds the decorator's parameter
  // once per application and answers with whichever came first, so the
  // body's own application binds it before the host context runs. A
  // host constructor lowering a decorator's initializer names the
  // application the same way (`substitutionApplication`).
  let declaring = wasmFunction.substitutionApplication ?? wasmFunction.declaringType;
  if (declaring != null && declaring.decoratorSubjectName != null &&
      declaring.typeArguments != null) {
    let declaringParams = getClassTypeParameters(declaring);
    if (declaringParams != null) {
      substituted = substituteTypeParamsInCodegen(
          wasm, declaringParams, declaring.typeArguments, substituted);
    }
  }
  if (wasmFunction.classType != null) {
    substituted = substituteTypeParamsInClassContext(wasm, wasmFunction.classType, substituted);
  }

  let {typeParameters} = wasmFunction;
  if (typeParameters != null && wasmFunction.typeArguments != null) {
    let tps = typeParameters;
    let tas = wasmFunction.typeArguments as Array<Type>;
    substituted = substituteTypeParamsInCodegen(wasm, tps, tas, substituted);
  }

  cache[t] = substituted;
  return substituted;
}

export function getInterfaceMemberSignature(wasm: WasmModule, it: InterfaceType, fieldName: String): WasmSignature {
  let itParams = getInterfaceTypeParameters(it);
  if (fieldName.startsWith("get#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var memberType: Type | null = null;
    if (it.members.has(propName)) {
      let fi = it.members[propName];
      if (fi is FieldInfo) {
        memberType = substituteTypeParamsInCodegen(wasm, itParams, it.typeArguments, fi.type);
      } else if (fi is MethodInfo) {
        let ft = fi.type as FunctionType;
        let resolvedFt = substituteTypeParamsInCodegen(wasm, itParams, it.typeArguments, ft) as FunctionType;
        memberType = resolvedFt.returnType;
      }
    } else if (it.members.has(fieldName)) {
      let mi = it.members[fieldName];
      if (mi is MethodInfo) {
        let ft = mi.type as FunctionType;
        let resolvedFt = substituteTypeParamsInCodegen(wasm, itParams, it.typeArguments, ft) as FunctionType;
        memberType = resolvedFt.returnType;
      } else if (mi is FieldInfo) {
        memberType = substituteTypeParamsInCodegen(wasm, itParams, it.typeArguments, mi.type);
      }
    }
    if (memberType == null) {
      throw new Error(`Interface getter member ${fieldName} not found on interface ${it.name}`);
    }
    let params = growable<ValType>([new ValTypeAnyRef()]);
    let returns = growable<ValType>([typeToValType(wasm, memberType)]);
    return wasm.getSignature(params, returns);
  } else if (fieldName.startsWith("set#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var memberType: Type | null = null;
    if (it.members.has(propName)) {
      let fi = it.members[propName];
      if (fi is FieldInfo) {
        memberType = substituteTypeParamsInCodegen(wasm, itParams, it.typeArguments, fi.type);
      } else if (fi is MethodInfo) {
        let ft = fi.type as FunctionType;
        let resolvedFt = substituteTypeParamsInCodegen(wasm, itParams, it.typeArguments, ft) as FunctionType;
        if (resolvedFt.parameters.length > 0) {
          memberType = resolvedFt.parameters[0];
        }
      }
    } else if (it.members.has(fieldName)) {
      let mi = it.members[fieldName];
      if (mi is MethodInfo) {
        let ft = mi.type as FunctionType;
        let resolvedFt = substituteTypeParamsInCodegen(wasm, itParams, it.typeArguments, ft) as FunctionType;
        if (resolvedFt.parameters.length > 0) {
          memberType = resolvedFt.parameters[0];
        }
      } else if (mi is FieldInfo) {
        memberType = substituteTypeParamsInCodegen(wasm, itParams, it.typeArguments, mi.type);
      }
    }
    if (memberType == null) {
      throw new Error(`Interface setter member ${fieldName} not found on interface ${it.name}`);
    }
    let params = growable<ValType>([new ValTypeAnyRef()]);
    mapParamTypeToWasmParams(wasm, memberType, params);
    let returns = new Array<ValType>();
    return wasm.getSignature(params, returns);
  } else {
    var resolvedFt: FunctionType | null = null;
    if (it.members.has(fieldName)) {
      let mi = it.members[fieldName];
      if (mi.type is FunctionType) {
        let ft = mi.type as FunctionType;
        resolvedFt = substituteTypeParamsInCodegen(wasm, itParams, it.typeArguments, ft) as FunctionType;
      }
    }
    if (resolvedFt == null) {
      throw new Error(`Interface method ${fieldName} not found on interface ${it.name}`);
    }
    let rFt = resolvedFt;
    let params = growable<ValType>([new ValTypeAnyRef()]);
    for (let p in rFt.parameters) {
      mapParamTypeToWasmParams(wasm, p, params);
    }
    let returns = new Array<ValType>();
    mapReturnTypeToWasmResults(wasm, rFt.returnType, returns);
    return wasm.getSignature(params, returns);
  }
}

/**
 * The overloads of interface method `name`, each with the interface's
 * type arguments substituted, or null when the method has a single
 * signature. Each overload has its own vtable slot, named by
 * `interfaceOverloadSlotName`; a method with one signature keeps the
 * slot named after the method.
 */
export function interfaceMethodOverloads(wasm: WasmModule, iface: InterfaceType,
    name: String): GrowableArray<FunctionType> | null {
  if (let (true, member) = iface.members.get(name)) {
    let memberType = member.type;
    if (memberType is FunctionType) {
      let {overloads} = memberType;
      if (overloads != null) {
        let typeParameters = getInterfaceTypeParameters(iface);
        return overloads.map((overload) => substituteTypeParamsInCodegen(wasm,
            typeParameters, iface.typeArguments, overload) as FunctionType);
      }
    }
  }
  return null;
}

/** The vtable slot of one overload of an interface method. */
export function interfaceOverloadSlotName(name: String,
    overload: FunctionType): String {
  return name + getSignatureKey(overload);
}

/** The signature of an interface vtable slot for one overload. */
export function interfaceOverloadSignature(wasm: WasmModule,
    overload: FunctionType): WasmSignature {
  let params = growable<ValType>([new ValTypeAnyRef()]);
  for (let parameter in overload.parameters) {
    mapParamTypeToWasmParams(wasm, parameter, params);
  }
  let returns = new Array<ValType>();
  mapReturnTypeToWasmResults(wasm, overload.returnType, returns);
  return wasm.getSignature(params, returns);
}

/**
 * Which overload of which method an interface vtable slot holds, when the
 * slot belongs to an overloaded method; null for any other slot.
 */
export function interfaceSlotOverload(wasm: WasmModule, iface: InterfaceType,
    slotName: String): InterfaceSlotOverload | null {
  for (let name in iface.members.keys()) {
    if (!slotName.startsWith(name)) {
      continue;
    }
    let overloads = interfaceMethodOverloads(wasm, iface, name);
    if (overloads != null) {
      if (let (true, overload) = overloads.find(
          (overload) => interfaceOverloadSlotName(name, overload) == slotName)) {
        return new InterfaceSlotOverload(name, overload);
      }
    }
  }
  return null;
}

/**
 * Appends the vtable slots of interface method `name` to `vtable`: one
 * per overload, or one named after the method when it has a single
 * signature. A generic overload has no slot of its own; its uses get
 * slots per specialization (`#syncGenericInterfaceSlots`).
 */
export function pushInterfaceMethodSlots(wasm: WasmModule, iface: InterfaceType,
    name: String, vtable: WasmStruct): void {
  let overloads = interfaceMethodOverloads(wasm, iface, name);
  if (overloads == null) {
    let signature = getInterfaceMemberSignature(wasm, iface, name);
    vtable.fields.push(new WasmField(name, new ValTypeRef(signature), false));
    return;
  }
  for (let overload in overloads) {
    let {typeParameters} = overload;
    if (typeParameters != null && typeParameters.length > 0) {
      continue;
    }
    vtable.fields.push(new WasmField(interfaceOverloadSlotName(name, overload),
        new ValTypeRef(interfaceOverloadSignature(wasm, overload)), false));
  }
}

/**
 * The vtable slot a use of interface method `name` goes through, given
 * the overload the checker chose for it (`getResolvedOverload`, null when
 * the method has one signature). The checker records the overload as
 * declared or with the receiver's type arguments substituted, so both
 * forms are matched.
 */
export function interfaceCallSlotName(wasm: WasmModule, iface: InterfaceType,
    name: String, chosen: FunctionType | null): String {
  let overloads = interfaceMethodOverloads(wasm, iface, name);
  if (overloads == null) {
    return name;
  }
  if (chosen == null) {
    throw new Error(`No overload was chosen for interface method ${name} of ${iface.name}`);
  }
  let declaredKey = getSignatureKey(chosen);
  let substituted = substituteTypeParamsInCodegen(wasm,
      getInterfaceTypeParameters(iface), iface.typeArguments, chosen) as FunctionType;
  let substitutedKey = getSignatureKey(substituted);
  if (let (true, overload) = overloads.find((overload) => {
    let key = getSignatureKey(overload);
    return key == substitutedKey || key == declaredKey;
  })) {
    return interfaceOverloadSlotName(name, overload);
  }
  throw new Error(`Interface method ${name} of ${iface.name} has no overload ${declaredKey}`);
}

/** An overloaded interface method's name and one of its overloads. */
export final class InterfaceSlotOverload {
  methodName: String;
  overload: FunctionType;
  new(this.methodName, this.overload);
}

/**
 * `this` as seen through an interface receiver: the interface type
 * itself. The caller of a virtual generic method types its arguments
 * against this view (the checker substitutes the same way), so the
 * vtable slot's signature must too — a `this`-typed callback parameter
 * left unsubstituted would lower to anyref and mint a closure struct
 * the call site's closure does not have.
 */
export function substituteThisTypeInCodegen(receiverType: Type, t: Type): Type {
  match (t) {
    case ThisType: { return receiverType; }
    case FunctionType as ft: {
      let subParams = new Array<Type>();
      var changed = false;
      for (let param in ft.parameters) {
        let sub = substituteThisTypeInCodegen(receiverType, param);
        if (sub !== param) { changed = true; }
        subParams.push(sub);
      }
      let subRet = substituteThisTypeInCodegen(receiverType, ft.returnType);
      if (!changed && subRet === ft.returnType) { return t; }
      let newFt = internFunctionType(subParams, subRet, ft.info, ft.typeParameters);
      newFt.functionSymbolId = ft.functionSymbolId;
      newFt.functionSymbolName = ft.functionSymbolName;
      countCodegenFunctionType(2);
      return newFt;
    }
    case UnionType {types}: {
      let substituted = new Array<Type>();
      var changed = false;
      for (let type in types) {
        let sub = substituteThisTypeInCodegen(receiverType, type);
        if (sub !== type) { changed = true; }
        substituted.push(sub);
      }
      if (!changed) { return t; }
      return new UnionType(substituted);
    }
    case ArrayType {elementType, elementsMutable}: {
      let sub = substituteThisTypeInCodegen(receiverType, elementType);
      if (sub === elementType) { return t; }
      return new ArrayType(sub, elementsMutable);
    }
    case _: { return t; }
  }
}

/**
 * The interface-view function type of a generic interface method at
 * one solved type-argument list: interface type parameters bound to
 * the specialization's arguments, `this` bound to the interface, and
 * the method's own type parameters bound to `typeArgs`. This is the
 * type the checker gives the call site, so it is what the vtable
 * slot's signature — and any trampoline adaptation against an
 * implementing class's own view — derives from.
 */
export function getGenericInterfaceMethodType(wasm: WasmModule, it: InterfaceType, methName: String, typeArgs: Array<Type>): FunctionType {
  let itParams = getInterfaceTypeParameters(it);
  var resolvedFt: FunctionType | null = null;
  if (it.members.has(methName)) {
    let mi = it.members[methName];
    if (mi.type is FunctionType) {
      let ft = mi.type as FunctionType;
      resolvedFt = substituteTypeParamsInCodegen(wasm, itParams, it.typeArguments, ft) as FunctionType;
    }
  }
  if (resolvedFt == null) {
    throw new Error(`Interface method ${methName} not found on interface ${it.name}`);
  }
  var rFt = substituteThisTypeInCodegen(it as Type, resolvedFt) as FunctionType;
  let mtps = rFt.typeParameters;
  if (mtps != null && mtps.length > 0) {
    rFt = substituteTypeParamsInCodegen(wasm, mtps, typeArgs, rFt) as FunctionType;
  }
  return rFt;
}

/**
 * The vtable slot signature for one monomorphized instantiation of a
 * generic interface method: anyref receiver plus the interface-view
 * parameter and result types at `typeArgs`.
 */
export function getGenericInterfaceMemberSignature(wasm: WasmModule, it: InterfaceType, methName: String, typeArgs: Array<Type>): WasmSignature {
  let rFt = getGenericInterfaceMethodType(wasm, it, methName, typeArgs);
  let params = growable<ValType>([new ValTypeAnyRef()]);
  for (let p in rFt.parameters) {
    mapParamTypeToWasmParams(wasm, p, params);
  }
  let returns = new Array<ValType>();
  mapReturnTypeToWasmResults(wasm, rFt.returnType, returns);
  return wasm.getSignature(params, returns);
}

export function eraseTypeParameters(wasm: WasmModule, t: Type): Type {
  return match (t) {
    case TypeParameterType: new ErasedType()
    // An enum is nominally distinct only to the checker; it is carried
    // as its backing type.
    case EnumType as et: eraseTypeParameters(wasm, et.backingType)
    case TypeAliasType as ta: {
      // Codegen wants representations, and a `distinct type` is nominally
      // distinct only to the checker — it shares its target's representation.
      // This is what makes the ownership handles cost nothing at runtime:
      // `Own<Descriptor>`, `Borrow<Descriptor>` and `Descriptor` all lower to
      // the same wasm type. Without it, lowering sees a handle as a type it
      // has no class for and bails (`new of non-class`, `method receiver
      // kind`, `constructor arity adaptation`).
      //
      // instantiateTypeAliasType keeps the *unsubstituted* target and carries
      // the arguments alongside (types.zena), so substitute before recursing —
      // otherwise `Own<T> = T` erases to the bare type parameter, and
      // `Ptr<T> = i32` would wrongly erase to `T`.
      if (!ta.isDistinct && ta.typeParameters == null && ta.intrinsicName == null) {
        return ta;
      }
      if (let (true, done) = wasm.erasures.get(ta.uid)) {
        return done;
      }
      wasm.erasures[ta.uid] = ta;
      let tps = ta.typeParameters;
      let targs = ta.typeArguments;
      let erased = if (tps != null && targs != null) {
        eraseTypeParameters(wasm, substituteTypeParamsInCodegen(wasm, 
            tps, targs, ta.target))
      } else {
        eraseTypeParameters(wasm, ta.target)
      };
      wasm.erasures[ta.uid] = erased;
      erased
    }
    case ArrayType {elementType, elementsMutable}: {
      let sub = eraseTypeParameters(wasm, elementType);
      if (sub === elementType) { return t; }
      new ArrayType(sub, elementsMutable)
    }
    case ClassType as ct: {
      let {typeArguments} = ct;
      if (typeArguments != null && typeArguments.length > 0) {
        if (let (true, done) = wasm.erasures.get(ct.uid)) {
          return done;
        }
        let args = typeArguments;
        let newArgs = new Array<Type>();
        var changed = false;
        for (let arg in args) {
          let sub = eraseTypeParameters(wasm, arg);
          if (sub !== arg) { changed = true; }
          newArgs.push(sub);
        }
        if (!changed) {
          wasm.erasures[ct.uid] = t;
          return t;
        }

        let inst = new ClassType(ct.id, ct.symbolId, ct.name);
        // Registered before the supertypes and constructor are erased;
        // see `WasmModule.erasures`.
        wasm.erasures[ct.uid] = inst;
        inst.typeArguments = newArgs;
        let {superType} = ct;
        if (superType != null) {
          inst.superType = eraseTypeParameters(wasm, superType as Type) as ClassType;
        }
        inst.members = ct.members;
        inst.typeParameters = ct.typeParameters;
        inst.isExtension = ct.isExtension;
        if (ct.isExtension && ct.onType != null) {
          inst.onType = eraseTypeParameters(wasm, ct.onType as Type);
        }
        inst.genericSource = ct.genericSource ?? ct;
        inst.sourcePath = ct.sourcePath;
        inst.isMixinIntermediate = ct.isMixinIntermediate;
        inst.privateScopeKey = ct.privateScopeKey;
        for (let impl in ct.implementsList) {
          inst.implementsList.push(eraseTypeParameters(wasm, impl) as InterfaceType);
        }
        for (let m in ct.mixins) {
          inst.mixins.push(eraseTypeParameters(wasm, m) as MixinType);
        }
        inst.fieldSetterNames = ct.fieldSetterNames;
        inst.decoratorSubjectName = ct.decoratorSubjectName;
        inst.decoratorFieldName = ct.decoratorFieldName;
        inst.decoratedFields = ct.decoratedFields;
        inst.decoratorSharedScopeKey = ct.decoratorSharedScopeKey;
        inst.isFinal = ct.isFinal;
        inst.isCaseClass = ct.isCaseClass;
        inst.derivesEquality = ct.derivesEquality;
        inst.isAbstract = ct.isAbstract;
        inst.isSealed = ct.isSealed;
        inst.sealedVariants = ct.sealedVariants;
        inst.declaredFields = ct.declaredFields;
        inst.forwardVariantNames = ct.forwardVariantNames;
        inst.constructorType = if (ct.constructorType != null) {
          let ctor = ct.constructorType as FunctionType;
          let newParams = new Array<Type>(ctor.parameters.length);
          for (let p in ctor.parameters) {
            newParams.push(eraseTypeParameters(wasm, p));
          }
          let newFt = internFunctionType(newParams, eraseTypeParameters(wasm, ctor.returnType), ctor.info);
          newFt.functionSymbolId = ctor.functionSymbolId;
          newFt.functionSymbolName = ctor.functionSymbolName;
          countCodegenFunctionType(3);
          newFt
        } else {
          null
        };
        inst.isMixinIntermediate = ct.isMixinIntermediate;
        inst.privateScopeKey = ct.privateScopeKey;
        inst as Type
      } else {
        t as Type
      }
    }
    case InterfaceType as it: {
      let {typeArguments} = it;
      if (typeArguments != null && typeArguments.length > 0) {
        if (let (true, done) = wasm.erasures.get(it.uid)) {
          return done;
        }
        let args = typeArguments;
        let newArgs = new Array<Type>();
        var changed = false;
        for (let arg in args) {
          let sub = eraseTypeParameters(wasm, arg);
          if (sub !== arg) { changed = true; }
          newArgs.push(sub);
        }
        if (!changed) {
          wasm.erasures[it.uid] = t;
          return t;
        }
        let inst = new InterfaceType(it.id, it.symbolId, it.name);
        wasm.erasures[it.uid] = inst;
        inst.typeArguments = newArgs;
        inst.members = it.members;
        inst.typeParameters = it.typeParameters;
        inst.genericSource = it.genericSource ?? it;
        inst.sourcePath = it.sourcePath;
        for (let ext in it.extendsList) {
          inst.extendsList.push(eraseTypeParameters(wasm, ext) as InterfaceType);
        }
        inst as Type
      } else {
        t as Type
      }
    }
    case FunctionType as ft: {
      let newParams = new Array<Type>();
      var changed = false;
      for (let p in ft.parameters) {
        let sub = eraseTypeParameters(wasm, p);
        if (sub !== p) { changed = true; }
        newParams.push(sub);
      }
      let newRet = eraseTypeParameters(wasm, ft.returnType);
      if (newRet !== ft.returnType) { changed = true; }
      if (!changed) { return t; }
      let inst = internFunctionType(newParams, newRet, ft.info, ft.typeParameters, ft.typeArguments, ft.genericSource, ft.overloads);
      inst.functionSymbolId = ft.functionSymbolId;
      inst.functionSymbolName = ft.functionSymbolName;
      countCodegenFunctionType(4);
      inst
    }
    case MixinType as mt: {
      let {typeArguments} = mt;
      if (typeArguments != null && typeArguments.length > 0) {
        let args = typeArguments;
        let newArgs = new Array<Type>();
        var changed = false;
        for (let arg in args) {
          let sub = eraseTypeParameters(wasm, arg);
          if (sub !== arg) { changed = true; }
          newArgs.push(sub);
        }
        if (!changed) { return t; }
        let inst = new MixinType(mt.name);
        inst.typeParameters = mt.typeParameters;
        inst.typeArguments = newArgs;
        inst.genericSource = mt.genericSource ?? mt;
        inst.onType = mt.onType;
        inst.members = mt.members;
        inst.sourcePath = mt.sourcePath;
        for (let composed in mt.mixins) {
          inst.mixins.push(eraseTypeParameters(wasm, composed) as MixinType);
        }
        inst as Type
      } else {
        t as Type
      }
    }
    case UnionType {types}: {
      let newTypes = new Array<Type>();
      var changed = false;
      for (let subT in types) {
        let sub = eraseTypeParameters(wasm, subT);
        if (sub !== subT) { changed = true; }
        newTypes.push(sub);
      }
      if (!changed) { return t; }
      wasm.interner.union(newTypes)
    }
    case TupleType {elementTypes, row}: {
      let newElems = new Array<Type>();
      var changed = false;
      for (let subT in elementTypes) {
        let sub = eraseTypeParameters(wasm, subT);
        if (sub !== subT) { changed = true; }
        newElems.push(sub);
      }
      // An erased row is no elements: nothing is emitted at an erasure,
      // so this only names a struct.
      if (!changed && row == null) { return t; }
      new TupleType(newElems, null, 0)
    }
    case InlineTupleType {elementTypes}: {
      let newElems = new Array<Type>();
      var changed = false;
      for (let subT in elementTypes) {
        let sub = eraseTypeParameters(wasm, subT);
        if (sub !== subT) { changed = true; }
        newElems.push(sub);
      }
      if (!changed) { return t; }
      new InlineTupleType(newElems)
    }
    // An erased element is a reference, never a tuple.
    case InlineParamType {param}: eraseTypeParameters(wasm, param)
    case RecordType as rec: {
      let newProps = new Map<String, Type>();
      var changed = false;
      let keys = rec.properties.keys();
      for (let key in keys) {
        let propType = rec.properties[key];
        let sub = eraseTypeParameters(wasm, propType);
        if (sub !== propType) { changed = true; }
        newProps[key] = sub;
      }
      // An erased row is no fields at all: nothing is emitted at an
      // erasure (reachability/CONTEXT.md), so this only names a struct.
      if (!changed && rec.row == null) { return t; }
      let newRec = new RecordType(newProps, rec.optionalProperties, null, rec.isExistential);
      newRec
    }
    case _: t
  };
}

export function getClassMemberSignature(wasm: WasmModule, ct: ClassType, fieldName: String): WasmSignature {
  let key = getClassMethodKey(getClassKey(ct), fieldName);
  if (let (true, f) = wasm.classMethodMap.get(key)) {
    return f.signature;
  }
  let erasedCt = eraseTypeParameters(wasm, ct) as ClassType;
  let erasedKey = getClassMethodKey(getClassKey(erasedCt), fieldName);
  if (let (true, f) = wasm.classMethodMap.get(erasedKey)) {
    return f.signature;
  }
  var curr: ClassType | null = ct;
  while (curr != null) {
    let k = getClassMethodKey(getClassKey(curr), fieldName);
    if (let (true, f) = wasm.classMethodMap.get(k)) {
      return f.signature;
    }
    curr = curr.superType;
  }

  let rootClass = getMemberRootClass(erasedCt, fieldName);
  let params = new Array<ValType>();
  let rootKey = getClassKey(rootClass);
  let classStruct = if (let (true, rootInfo) = wasm.classInfos.get(rootKey)) rootInfo.structType else null;
  if (classStruct != null) {
    params.push(new ValTypeRef(classStruct));
  } else {
    params.push(new ValTypeAnyRef());
  }

  let returns = new Array<ValType>();

  if (fieldName.startsWith("get#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var fieldType: Type = new VoidType();
    if (erasedCt.members.has(propName)) {
      fieldType = substituteTypeParamsInClassContext(wasm, erasedCt, erasedCt.members[propName].type);
    } else if (erasedCt.members.has(fieldName)) {
      let mi = erasedCt.members[fieldName] as MethodInfo;
      let ft = mi.type as FunctionType;
      let resolvedFt = substituteTypeParamsInClassContext(wasm, erasedCt, ft) as FunctionType;
      fieldType = resolvedFt.returnType;
    }
    returns.push(typeToValType(wasm, fieldType));
    return wasm.getSignature(params, returns);
  } else if (fieldName.startsWith("set#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var fieldType: Type = new VoidType();
    if (erasedCt.members.has(propName)) {
      fieldType = substituteTypeParamsInClassContext(wasm, erasedCt, erasedCt.members[propName].type);
    } else if (erasedCt.members.has(fieldName)) {
      let mi = erasedCt.members[fieldName] as MethodInfo;
      let ft = mi.type as FunctionType;
      let resolvedFt = substituteTypeParamsInClassContext(wasm, erasedCt, ft) as FunctionType;
      fieldType = resolvedFt.parameters[0];
    }
    mapParamTypeToWasmParams(wasm, fieldType, params);
    return wasm.getSignature(params, returns);
  } else {
    var ft: FunctionType | null = null;
    if (erasedCt.members.has(fieldName)) {
      let mi = erasedCt.members[fieldName] as MethodInfo;
      let rawFt = mi.type as FunctionType;
      ft = substituteTypeParamsInClassContext(wasm, erasedCt, rawFt) as FunctionType;
    }
    if (ft != null) {
      for (let p in ft.parameters) {
        mapParamTypeToWasmParams(wasm, p, params);
      }
      mapReturnTypeToWasmResults(wasm, ft.returnType, returns);
    }
    return wasm.getSignature(params, returns);
  }
}

function getWasmTypeKey(target: WasmType) {
  if (target is WasmStruct) {
    let {name} = target;
    if (name != null) {
      // The uid, not the name alone. A specialized class's struct is
      // named for its full class key, but a non-generic class's struct
      // is named for the class alone, so two same-named classes from
      // different modules produce two structs both called (say)
      // "Payload". These keys intern closure and cell structs, so the
      // bare name handed `(x: A.Payload) => i32` the struct built for
      // `(x: B.Payload) => i32`. uid is the identity WasmType hashes
      // on everywhere else.
      return `${name as String}#${i32ToString(target.uid)}`;
    }
    var structKey = "struct_anon_";
    for (let f in target.fields) {
      structKey = `${structKey}${if (f.name == null) "null" else f.name as String}_${if (f.isMutable) "mut_" else "imm_"}${getValTypeKey(f.type)}_`;
    }
    return structKey;
  }
  if (target is WasmArray) {
    return `array_${if (target.isMutable) "mut_" else "imm_"}${getValTypeKey(target.elementType)}`;
  }
  if (target is WasmSignature) {
    var s = "sig_";
    for (let p in target.params) {
      s = `${s}${getValTypeKey(p)}_`;
    }
    s = s + "returns_";
    for (let ret in target.returns) {
      s = `${s}${getValTypeKey(ret)}_`;
    }
    return s;
  }
  return "anon";
}

export function getValTypeKey(type: ValType): String {
  return match (type) {
  case ValTypeRef {target}: "ref_" + getWasmTypeKey(target)
  case ValTypeRefNull {target}: "refnull_" + getWasmTypeKey(target)
  case ValTypeRefExtern: "ref_extern"
  case _: i32ToString(valTypeToOpcode(type))
};
}

export function getClosureKey(params: GrowableArray<ValType>, returns: GrowableArray<ValType>): ClosureKey {
  var keyStr = "";
  for (let p in params) {
    keyStr = `${keyStr}${getValTypeKey(p)},`;
  }
  keyStr = keyStr + "=>";
  for (let r in returns) {
    keyStr = `${keyStr}${getValTypeKey(r)},`;
  }
  return keyStr as ClosureKey;
}

export function getCellKey(valType: ValType): CellKey {
  let normalizedType = match (valType) {
    case ValTypeRef {target}: new ValTypeRefNull(target)
    case ValTypeRefExtern: new ValTypeExternRef()
    case _: valType
  };
  return getValTypeKey(normalizedType) as CellKey;
}

export function getClosureStruct(wasm: WasmModule, ftVal: anyref): WasmStruct {
  let ft = ftVal as FunctionType;
  let params = growable<ValType>([new ValTypeStructRef()]); // ctx
  for (let p in ft.parameters) {
    mapParamTypeToWasmParams(wasm, p, params);
  }
  let returns = new Array<ValType>();
  mapReturnTypeToWasmResults(wasm, ft.returnType, returns);

  let implSig = wasm.getSignature(params, returns);

  let key = getClosureKey(params, returns);

  if (wasm.closureStructs.has(key)) {
    return wasm.closureStructs[key];
  }



  let fields = growable<WasmField>([
    new WasmField("func", new ValTypeRef(implSig), false),
    new WasmField("ctx", new ValTypeStructRef(), false),
  ]);
  let st = wasm.getStruct(null, fields);
  wasm.closureStructs[key] = st;
  return st;
}

export function getCellStruct(wasm: WasmModule, valType: ValType): WasmStruct {
  let valTypeNull = match (valType) {
    case ValTypeRef {target}: new ValTypeRefNull(target)
    case ValTypeRefExtern: new ValTypeExternRef()
    case _: valType
  };
  let key = getCellKey(valTypeNull);
  if (wasm.cellStructs.has(key)) {
    return wasm.cellStructs[key];
  }
  let fields = growable<WasmField>([new WasmField("value", valTypeNull, true)]); // mutable
  let name = "Cell_" + (key as String);
  let st = new WasmStruct(name, fields);
  wasm.types.push(st);
  wasm.cellStructs[key] = st;
  return st;
}

/**
 * The wasm type a value of `t` occupies in *storage* — an array element
 * or (eventually) a struct field — as opposed to the type it has as a
 * live value.
 *
 * The two differ only for the narrow integers, which are packed into
 * wasm `i8`/`i16` when stored and unpacked to `i32` everywhere else.
 * Packed storage has no signedness of its own: `u8` and `i8` share the
 * single wasm type `(array (mut i8))`, and the choice between a
 * zero-extending and a sign-extending read is made by the instruction
 * (`array.get_u` vs `array.get_s`), not by the type. Lowering therefore
 * has to consult the *semantic* element type at each read; see
 * `packedArrayElementSigned` in `ir/intrinsics.zena`.
 */
export function typeToStorageValType(wasm: WasmModule, t: Type): ValType {
  let b = baseType(t);
  if (b is U8Type || b is I8Type) {
    return new ValTypeI8();
  }
  if (b is U16Type || b is I16Type) {
    return new ValTypeI16();
  }
  let vt = typeToValType(wasm, t);
  if (vt is ValTypeVoid) {
    // A zero-width element (`GrowableArray<void>`, via e.g.
    // `Future.all` at `A = void`). A wasm array cannot have no element
    // type, so zero-width elements store as packed i8: reads yield
    // nothing and writes store a constant (ir/intrinsics.zena), while
    // everything element-agnostic — length, growth, array.copy — runs
    // unchanged.
    return new ValTypeI8();
  }
  return vt;
}

export function typeToValType(wasm: WasmModule, t: Type): ValType {
  let erasedT = eraseTypeParameters(wasm, t);
  return match (erasedT) {
    case TypeAliasType as a: typeToValType(wasm, a.target)
    case EnumType as e: typeToValType(wasm, e.backingType)
  case BoolLiteralType: new ValTypeI32()
  case NumLiteralType as num: typeToValType(wasm, baseType(num))
  case StringLiteralType: {
    var stringStruct: WasmStruct | null = null;
    let {stringClass} = wasm;
    if (stringClass != null) {
      let key = getClassKey(stringClass);
      if (let (true, stringInfo) = wasm.classInfos.get(key)) {
        stringStruct = stringInfo.structType;
      }
    }
    if (stringStruct != null) {
      new ValTypeRef(stringStruct)
    } else {
      new ValTypeStructRef()
    }
  }
  case F64Type: new ValTypeF64()
  case F32Type: new ValTypeF32()
  case I32Type: new ValTypeI32()
  case U32Type: new ValTypeI32()
  case I64Type: new ValTypeI64()
  case U64Type: new ValTypeI64()
  // The narrow integers are carried unpacked, in an i32, everywhere a
  // value type is asked for. Packed storage (`i8`/`i16` array elements
  // and struct fields) is a separate representation choice that belongs
  // to the array work, not to the value model.
  case U8Type: new ValTypeI32()
  case U16Type: new ValTypeI32()
  case I8Type: new ValTypeI32()
  case I16Type: new ValTypeI32()
  case V128Type: new ValTypeV128()
  case BooleanType: new ValTypeI32()
  case RecordType as rec: {
    let fields = recordWasmFields(wasm, rec, null);
    let info_opt = if (rec.isExistential)
        wasm.findExistentialDispatch(fields, sortedOptionalNames(rec))
        else wasm.findRecordDispatch(fields, sortedOptionalNames(rec));
    match (info_opt) {
      case RecordDispatchInfo as info: new ValTypeRef(info.fatPtrType)
      case null: {
        var errStr = "";
        for (let f in fields) {
           if (f.name != null) errStr = `${errStr}${f.name as String}, `;
        }
        throw new Error("Record fat ptr type not generated during discovery pass! Fields: " + errStr);
      }
    }
  }
  case TupleType as tup: {
    // A zero-width element (`void`) has no field; the others keep the
    // name of their position, so `(true, void)` is one field named "0".
    let fields = new Array<WasmField>();
    for (var i = 0; i < tup.elementTypes.length; i += 1) {
      let vt = typeToValType(wasm, tup.elementTypes[i]);
      if (!(vt is ValTypeVoid)) {
        fields.push(new WasmField(i32ToString(i), vt, false));
      }
    }
    let structDef = wasm.getStruct(null, fields);
    new ValTypeRef(structDef);
  }
  case ClassType as ct: {
    let targs = ct.typeArguments;
    if (ct.name == "array" && targs != null && targs.length > 0) {
      let elemValType = typeToStorageValType(wasm, targs[0]);
      // A class-shaped mention of `array` carries no element-mutability
      // bit; every such mention is the mutable builtin today.
      return new ValTypeRef(wasm.getArray(elemValType, true));
    }
    if (ct.name == "ByteArray") {
      return new ValTypeRef(wasm.getByteArrayType());
    }
    if (ct.isExtension && ct.onType != null) {
      // `on` can only name the class's own type parameters (an inherited
      // clause arrives already rewritten in them), so substitute just
      // those. The flattened class context would also walk the class's
      // supertypes and interfaces and key each — once per mention of
      // `FixedArray<T>`, whose instantiations are rarely shared — which
      // was most of the strings a compile built.
      let subOn = substituteTypeParamsInCodegen(wasm,
          getClassTypeParameters(ct), ct.typeArguments, ct.onType as Type);
      return typeToValType(wasm, subOn);
    }
    if (let (true, ctInfo) = wasm.classInfos.get(getClassKey(ct))) {
      new ValTypeRef(ctInfo.structType)
    } else {
      new ValTypeStructRef()
    }
  }
  case InterfaceType as it: {
    let key = getInterfaceKey(it);
    if (wasm.interfaceStructs.has(key)) {
      new ValTypeRef(wasm.interfaceStructs[key])
    } else {
      new ValTypeStructRef()
    }
  }
  case ArrayType as at: {
    let elemValType = typeToStorageValType(wasm, at.elementType);
    new ValTypeRef(wasm.getArray(elemValType, at.elementsMutable))
  }
  case VoidType: new ValTypeVoid()
  case NullType: new ValTypeStructRef()
  case UnknownType: new ValTypeAnyRef()
  case ErrorType: new ValTypeAnyRef()
  case TypeParameterType: new ValTypeAnyRef()
  case AnyRefType: new ValTypeAnyRef()
  // An erased slot is a top-typed reference slot — that much erasure
  // and `anyref` DO share; see ErasedType in types.zena for the rest.
  case ErasedType: new ValTypeAnyRef()
  case EqRefType: new ValTypeEqRef()
  case ExternRefType: new ValTypeExternRef()
  case TypeParameterType: new ValTypeAnyRef()
  case ThisType: new ValTypeAnyRef()
  case NeverType: new ValTypeVoid()
  case HoleType: new ValTypeI32()
  case FunctionType: {
    new ValTypeRef(getClosureStruct(wasm, t))
  }
  case UnionType as ut: {
    var hasVoid = false;
    for (let t_i in ut.types) {
      if (t_i is VoidType) {
        hasVoid = true;
      }
    }
    if (hasVoid) {
      new ValTypeVoid()
    } else {
      let nonNeverTypes = new Array<Type>();
      for (let t_i in ut.types) {
        if (!(t_i is NeverType || t_i is HoleType || t_i is ErrorType || t_i is UnknownType)) {
          nonNeverTypes.push(t_i);
        }
      }
      if (nonNeverTypes.length == 0) {
        new ValTypeVoid()
      } else if (nonNeverTypes.length < ut.types.length) {
        if (nonNeverTypes.length == 1) {
          let v = typeToValType(wasm, nonNeverTypes[0]);
          match (v) {
            case ValTypeRef as vr: new ValTypeRefNull(vr.target)
            case ValTypeRefExtern: new ValTypeExternRef()
            case _: v
          }
        } else {
          typeToValType(wasm, wasm.interner.union(nonNeverTypes))
        }
      } else {
        let nonNullTypes = new Array<Type>();
        for (let t_i in ut.types) {
          if (!(t_i is NullType)) {
            nonNullTypes.push(t_i);
          }
        }
        let mappedValTypes = new Array<ValType>();
        for (let t_i in nonNullTypes) {
          mappedValTypes.push(typeToValType(wasm, t_i));
        }
        var allSame = true;
        let firstKey = if (mappedValTypes.length > 0) getValTypeKey(mappedValTypes[0]) else "";
        for (let mv in mappedValTypes) {
          if (getValTypeKey(mv) != firstKey) {
            allSame = false;
            break;
          }
        }
        if (allSame && mappedValTypes.length > 0) {
          let commonValType = mappedValTypes[0];
          var hasNull = false;
          for (let t_i in ut.types) {
            if (t_i is NullType) {
              hasNull = true;
              break;
            }
          }
          if (hasNull) {
            match (commonValType) {
              case ValTypeRef as vr: new ValTypeRefNull(vr.target)
              case ValTypeRefExtern: new ValTypeExternRef()
              case _: commonValType
            }
          } else {
            commonValType
          }
        } else {
          new ValTypeEqRef()
        }
      }
    }
  }
  case _: {
    throw new Error("typeToValType: unsupported type: " + typeToString(t));
  }
  };
}

/**
 * The per-SEMANTIC-lane value types of an inline-tuple type or a
 * union of inline tuples, or null when `type` is neither. A
 * zero-width lane — one whose representative type is `void` in this
 * instantiation — comes back as `ValTypeVoid`: it occupies no wasm
 * slot, and every encoder and decoder of the multi-value shape walks
 * these lanes with a separate wasm cursor, exactly as zero-width
 * arguments already pair against parameter lists.
 */
export function inlineLaneValTypes(wasm: WasmModule, type: Type): GrowableArray<ValType> | null {
  if (type is InlineTupleType) {
    let lanes = new Array<ValType>();
    for (let el in type.elementTypes) {
      lanes.push(typeToValType(wasm, el));
    }
    return lanes;
  }
  if (!(type is UnionType)) {
    return null;
  }
  let memberTuples = new Array<InlineTupleType>();
  for (let t in type.types) {
    if (t is InlineTupleType) {
      memberTuples.push(t);
    }
  }
  if (memberTuples.length == 0) {
    return null;
  }
  let lanes = new Array<ValType>();
  let arity = memberTuples[0].elementTypes.length;
  var i = 0;
  while (i < arity) {
    let elementTypes = new Array<Type>();
    for (let t in memberTuples) {
      elementTypes.push(t.elementTypes[i]);
    }
    var hasHole = false;
    for (let t in elementTypes) {
      if (t is HoleType || t is NullType) {
        hasHole = true;
      }
    }
    var nonHoleType: Type | null = null;
    for (let t in elementTypes) {
      if (!(t is HoleType || t is NullType)) {
        nonHoleType = t;
        break;
      }
    }
    if (nonHoleType == null) {
      // No arm puts a value in this lane. A `null` element is still
      // a value (a `V = null` instantiation writes one), and keeps the
      // `structref` slot `null` lowers to. A lane every arm leaves as
      // `_` lowers to `nullref`, a subtype of every nullable
      // reference, so a union that narrows a wider one by dropping
      // the arms that fill the lane — `Step<T>` against
      // `AsyncStep<T>` — still forwards through the wider slot.
      for (let t in elementTypes) {
        if (t is NullType) {
          nonHoleType = t;
          break;
        }
      }
      if (nonHoleType == null) {
        lanes.push(new ValTypeNullRef());
        i += 1;
        continue;
      }
    }
    let vType = typeToValType(wasm, nonHoleType as Type);
    let finalVType = if (hasHole) {
      match (vType) {
        case ValTypeRef as r: new ValTypeRefNull(r.target)
        case _: vType
      }
    } else {
      vType
    };
    lanes.push(finalVType);

    i += 1;
  }
  return lanes;
}

/**
 * The wasm slots an inline tuple, or a union of them, occupies: a
 * function's results, and the values its caller reads back.
 *
 * Each element that holds a value gets a slot keyed by its position and
 * its wasm type, ignoring nullability. Members whose elements at one
 * position have the same wasm type share a slot, and a different wasm
 * type gets a slot of its own. In `inline (true, i32) | (false, String)`
 * position 0 has one `i32` slot, and position 1 has an `i32` slot and a
 * `String` slot. A member leaves the slots it does not use at their
 * default (0 or null), so a reference slot that some member does not
 * use is nullable.
 *
 * `_` takes no slot, and neither does an element whose type is
 * zero-width at this instantiation (`void`). A position where every
 * member writes `_` still keeps one `nullref` slot (unless some member
 * is zero-width there, as in `Step<void>`): a union that drops
 * the members filling a position of a wider one — `Step<T>` against
 * `AsyncStep<T>` — then has the same slots, and forwards into it. A
 * `null` element shares the position's reference slot when there is
 * one.
 */
export final class InlineLayout {
  slots: GrowableArray<ValType>;
  /**
   * The members with their nested inline tuples spliced in
   * (`flattenInlineTuple`): positions below, and in `memberSlots`, are
   * positions of these.
   */
  members: GrowableArray<InlineTupleType>;
  /** The members as written, nested inline tuples and all. */
  originals: GrowableArray<InlineTupleType>;
  /** The path each slot belongs to, parallel to `slots`. */
  slotPaths: GrowableArray<String>;
  /**
   * For member `m` and position `p`, the slot its element occupies, or
   * -1 when it occupies none (`_`, or a zero-width element).
   */
  memberSlots: GrowableArray<GrowableArray<i32>>;
  /** The longest member's length. */
  arity: i32;
  /**
   * The position of the literal that tells the members apart: 0, where
   * the checker requires it, or -1 for a single member.
   */
  discriminant: i32;

  /**
   * For member `m` and flat position `i`, the path of its leaf: "p" at a
   * top-level position, "p.k" for the k-th leaf of a nested inline tuple
   * at p. Slots are keyed by path, so a `Step` and an `AsyncStep` over
   * the same tuple line up although their members flatten to different
   * lengths.
   */
  memberPaths: GrowableArray<GrowableArray<String>>;

  new(this.slots, this.members, this.originals, this.slotPaths, this.memberSlots,
      this.memberPaths, this.arity, this.discriminant);

  /** The slot member `m`'s leaf at `path` occupies, or -1. */
  slotAt(m: i32, path: String): i32 {
    let i = pathIndex(this.memberPaths[m], path);
    return if (i >= 0) this.memberSlots[m][i] else -1;
  }

  /**
   * The one slot `path` reads from for the members `allowed` keeps, as
   * `positionSlot` does for a flat position: -1 when none has a value
   * there, -2 when they use different slots.
   */
  pathSlot(path: String, allowed: GrowableArray<boolean> | null): i32 {
    var found = -1;
    for (var m = 0; m < this.members.length; m += 1) {
      if (allowed != null && !allowed[m]) {
        continue;
      }
      let s = this.slotAt(m, path);
      if (s < 0) {
        continue;
      }
      if (found == -1) {
        found = s;
      } else if (found != s) {
        return -2;
      }
    }
    return found;
  }

  /** Whether the layout has a nested inline tuple anywhere. */
  isNested(): boolean {
    for (let paths in this.memberPaths) {
      for (let path in paths) {
        if (path.contains(".")) {
          return true;
        }
      }
    }
    return false;
  }

  /** The slot member `m`'s element at position `p` occupies, or -1. */
  slotOf(m: i32, p: i32): i32 {
    let row = this.memberSlots[m];
    return if (p < row.length) row[p] else -1;
  }

  /**
   * The one slot position `p` reads from for the members `allowed`
   * keeps (every member when null): -1 when none of them has a value
   * there, -2 when they use different slots.
   */
  positionSlot(p: i32, allowed: GrowableArray<boolean> | null): i32 {
    var found = -1;
    for (var m = 0; m < this.members.length; m += 1) {
      if (allowed != null && !allowed[m]) {
        continue;
      }
      let s = this.slotOf(m, p);
      if (s < 0) {
        continue;
      }
      if (found == -1) {
        found = s;
      } else if (found != s) {
        return -2;
      }
    }
    return found;
  }

  /** Whether every member puts each position in the same slot. */
  isPositional(): boolean {
    for (var p = 0; p < this.arity; p += 1) {
      if (this.positionSlot(p, null) == -2) {
        return false;
      }
    }
    return true;
  }
}

/**
 * The slot layout of an inline tuple or a union of them, or null when
 * `type` is neither. See `InlineLayout`.
 */
export function inlineLayoutOf(wasm: WasmModule, type: Type): InlineLayout | null {
  let originals = new Array<InlineTupleType>();
  if (type is InlineTupleType) {
    originals.push(type);
  } else if (type is UnionType) {
    for (let t in type.types) {
      if (t is InlineTupleType) {
        originals.push(t);
      }
    }
  }
  if (originals.length == 0) {
    return null;
  }
  // Each member's leaves, with the path of each: "p" for a top-level
  // position, "p.k" for the k-th leaf of a nested inline tuple at p.
  let members = new Array<InlineTupleType>();
  let memberPaths = new Array<GrowableArray<String>>();
  var origArity = 0;
  for (let original in originals) {
    let flat = new Array<Type>();
    let paths = new Array<String>();
    for (var p = 0; p < original.elementTypes.length; p += 1) {
      appendLeaves(original.elementTypes[p], `${p}`, flat, paths);
    }
    members.push(new InlineTupleType(flat));
    memberPaths.push(paths);
    if (original.elementTypes.length > origArity) {
      origArity = original.elementTypes.length;
    }
  }
  var arity = 0;
  for (let member in members) {
    if (member.elementTypes.length > arity) {
      arity = member.elementTypes.length;
    }
  }
  let slots = new Array<ValType>();
  let slotPaths = new Array<String>();
  let memberSlots = new Array<GrowableArray<i32>>();
  for (let member in members) {
    let row = new Array<i32>();
    for (var p = 0; p < member.elementTypes.length; p += 1) {
      row.push(-1);
    }
    memberSlots.push(row);
  }
  // The paths in order: by position, then as the members first use them.
  let order = new Array<String>();
  for (var p = 0; p < origArity; p += 1) {
    let top = `${p}`;
    let nested = `${p}.`;
    for (let paths in memberPaths) {
      for (let path in paths) {
        if ((path == top || path.startsWith(nested)) && !order.contains(path)) {
          order.push(path);
        }
      }
    }
  }
  for (let path in order) {
    let firstSlot = slots.length;
    var anyHole = false;
    var anyNull = false;
    var anyZeroWidth = false;
    // Values first: a slot per distinct wasm type, in member order.
    for (var m = 0; m < members.length; m += 1) {
      let i = pathIndex(memberPaths[m], path);
      if (i < 0) {
        continue;
      }
      let el = members[m].elementTypes[i];
      if (el is HoleType) {
        anyHole = true;
        continue;
      }
      if (el is NullType) {
        anyNull = true;
        continue;
      }
      let vt = typeToValType(wasm, el);
      if (vt is ValTypeVoid) {
        anyZeroWidth = true;
        continue;
      }
      var slot = -1;
      for (var s = firstSlot; s < slots.length; s += 1) {
        if (valTypeEquals(slots[s], vt)) {
          slot = s;
          break;
        }
      }
      if (slot == -1) {
        slot = slots.length;
        slots.push(vt);
        slotPaths.push(path);
      } else if (isNullableValType(vt)) {
        slots[slot] = vt;
      }
      memberSlots[m][i] = slot;
    }
    // `null` shares the path's first reference slot, or gets one.
    if (anyNull) {
      var refSlot = -1;
      for (var s = firstSlot; s < slots.length; s += 1) {
        if (isRefValType(slots[s])) {
          refSlot = s;
          break;
        }
      }
      if (refSlot == -1) {
        refSlot = slots.length;
        slots.push(typeToValType(wasm, new NullType()));
        slotPaths.push(path);
      }
      slots[refSlot] = nullableValType(slots[refSlot]);
      for (var m = 0; m < members.length; m += 1) {
        let i = pathIndex(memberPaths[m], path);
        if (i >= 0 && members[m].elementTypes[i] is NullType) {
          memberSlots[m][i] = refSlot;
        }
      }
    }
    // A path every member leaves as `_` keeps a `nullref` slot, unless
    // another member nests a tuple there: then the hole covers that
    // tuple's leaves, which have slots of their own.
    var covers = false;
    let prefix = `${path}.`;
    for (let other in order) {
      if (other.startsWith(prefix)) {
        covers = true;
      }
    }
    if (slots.length == firstSlot && anyHole && !anyZeroWidth && !covers) {
      slots.push(new ValTypeNullRef());
      slotPaths.push(path);
      for (var m = 0; m < members.length; m += 1) {
        let i = pathIndex(memberPaths[m], path);
        if (i >= 0 && members[m].elementTypes[i] is HoleType) {
          memberSlots[m][i] = firstSlot;
        }
      }
    }
    // A slot some member leaves unused holds that member's default.
    for (var s = firstSlot; s < slots.length; s += 1) {
      var allUse = true;
      for (var m = 0; m < members.length; m += 1) {
        let i = pathIndex(memberPaths[m], path);
        if (i < 0 || memberSlots[m][i] != s) {
          allUse = false;
        }
      }
      if (!allUse) {
        slots[s] = nullableValType(slots[s]);
      }
    }
  }
  // The checker requires a union of several to start each member with
  // a distinct literal (`checkTupleUnionMembers`).
  return new InlineLayout(slots, members, originals, slotPaths, memberSlots,
      memberPaths, arity, if (members.length < 2) -1 else 0);
}

/** Where `path` is in `paths`, or -1. */
export function pathIndex(paths: GrowableArray<String>, path: String): i32 {
  for (var i = 0; i < paths.length; i += 1) {
    if (paths[i] == path) {
      return i;
    }
  }
  return -1;
}

/** The leaves of an element at `path`: itself, or a nested inline tuple's
 * leaves at `path.k`. */
function appendLeaves(t: Type, path: String, flat: GrowableArray<Type>,
    paths: GrowableArray<String>): void {
  let inner = nestedInlineTuple(t);
  if (inner == null) {
    flat.push(t);
    paths.push(path);
    return;
  }
  for (var k = 0; k < inner.elementTypes.length; k += 1) {
    appendLeaves(inner.elementTypes[k], `${path}.${k}`, flat, paths);
  }
}

/**
 * An inline tuple with its nested inline tuples spliced in, recursively:
 * `inline (1, inline (A, B), _)` lays out as `(1, A, B, _)`, since the
 * inner tuple's values are the outer one's.
 */
export function flattenInlineTuple(t: InlineTupleType): InlineTupleType {
  var nested = false;
  for (let el in t.elementTypes) {
    if (nestedInlineTuple(el) != null) {
      nested = true;
    }
  }
  if (!nested) {
    return t;
  }
  let flat = new Array<Type>();
  for (let el in t.elementTypes) {
    let inner = nestedInlineTuple(el);
    if (inner != null) {
      for (let e in flattenInlineTuple(inner).elementTypes) {
        flat.push(e);
      }
    } else {
      flat.push(el);
    }
  }
  return new InlineTupleType(flat);
}

/** The inline tuple an element of an inline tuple is, or null. */
export function nestedInlineTuple(t: Type): InlineTupleType | null {
  var u = t;
  while (u is TypeAliasType) {
    u = (u as TypeAliasType).target;
  }
  return if (u is InlineTupleType) u else null;
}

/** How many positions a nested element takes once flattened: 1 for an
 * element that is not an inline tuple. */
export function flatWidth(t: Type): i32 {
  let inner = nestedInlineTuple(t);
  return if (inner != null) flattenInlineTuple(inner).elementTypes.length else 1;
}

function isNullableValType(vt: ValType): boolean {
  return match (vt) {
    case ValTypeRef {}: false
    case ValTypeRefExtern {}: false
    case ValTypeI32 {}: false
    case ValTypeI64 {}: false
    case ValTypeF32 {}: false
    case ValTypeF64 {}: false
    case ValTypeV128 {}: false
    case ValTypeI8 {}: false
    case ValTypeI16 {}: false
    case _: true
  };
}

function isRefValType(vt: ValType): boolean {
  return match (vt) {
    case ValTypeI32 {}: false
    case ValTypeI64 {}: false
    case ValTypeF32 {}: false
    case ValTypeF64 {}: false
    case ValTypeV128 {}: false
    case ValTypeI8 {}: false
    case ValTypeI16 {}: false
    case ValTypeVoid {}: false
    case _: true
  };
}

/** `vt` widened to admit null, when it is a non-null reference. */
function nullableValType(vt: ValType): ValType {
  return match (vt) {
    case ValTypeRef as r: new ValTypeRefNull(r.target) as ValType
    case ValTypeRefExtern {}: new ValTypeExternRef()
    case _: vt
  };
}

function mapUnionOfInlineTuplesToWasmResults(wasm: WasmModule, unionType: UnionType, returns: GrowableArray<ValType>): boolean {
  let layout = inlineLayoutOf(wasm, unionType as Type);
  if (layout == null) {
    return false;
  }
  for (let vt in layout.slots) {
    returns.push(vt);
  }
  return true;
}

/**
 * Appends the wasm parameter slots for one source parameter.
 *
 * The dual of mapReturnTypeToWasmResults: `void` is a ZERO-WIDTH type,
 * so a void-typed parameter contributes NO slot at all, exactly as a
 * void return contributes no result. That is what lets `void` be used
 * as a type argument — `Future<void>` specializes `complete(value: T)`
 * to a one-argument-in-source, zero-parameter-in-wasm function.
 *
 * Every site that builds a parameter list must go through here, and
 * every site that lowers an argument list must skip the matching
 * arguments (isZeroWidthValType), or the arity gates in lowering fire.
 */
export function mapParamTypeToWasmParams(wasm: WasmModule, type: Type, params: GrowableArray<ValType>): void {
  let vt = typeToValType(wasm, type);
  if (vt is ValTypeVoid) {
    return;
  }
  params.push(vt);
}

/** Whether a lowered value of this type occupies a wasm slot. */
export function isZeroWidthValType(vt: ValType): boolean {
  return vt is ValTypeVoid;
}

export function mapReturnTypeToWasmResults(wasm: WasmModule, type: Type, returns: GrowableArray<ValType>): void {
  if (type is VoidType || type is NeverType || type is HoleType) {
    return;
  }
  if (type is InlineTupleType) {
    for (let el in flattenInlineTuple(type).elementTypes) {
      let vt = typeToValType(wasm, el);
      if (!(vt is ValTypeVoid)) {
        returns.push(vt);
      }
    }
    return;
  }
  if (type is UnionType) {
    var hasVoid = false;
    for (let t in type.types) {
      if (t is VoidType) {
        hasVoid = true;
      }
    }
    if (hasVoid) {
      return;
    }
    if (mapUnionOfInlineTuplesToWasmResults(wasm, type, returns)) {
      return;
    }
  }
  returns.push(typeToValType(wasm, type));
}

export function getNonNullableType(type: Type): Type {
  return if (let UnionType {types} = type) {
    let nonNullTypes = new Array<Type>();
    for (let t_i in types) {
      if (!(t_i is NullType)) {
        nonNullTypes.push(t_i);
      }
    }
    if (nonNullTypes.length == 1) {
      nonNullTypes[0]
    } else {
      type
    }
  } else {
    type
  };
}

/** A record type's optional field names in sorted order — the canonical
 *  presence-bit assignment shared by every consumer of the mask. */
export function sortedOptionalNames(rec: RecordType): GrowableArray<String> {
  let names = new Array<String>();
  let optionals = rec.optionalProperties;
  if (optionals != null) {
    for (let name in optionals) {
      names.push(name);
    }
    let len = names.length;
    for (var i = 1; i < len; i += 1) {
      let key = names[i];
      var j = i - 1;
      while (j >= 0 && compareStrings(names[j], key) > 0) {
        names[j + 1] = names[j];
        j -= 1;
      }
      names[j + 1] = key;
    }
  }
  return names;
}

/** An optional field's slot must be able to hold a placeholder when the
 *  field is absent, so reference slots widen to nullable. */
function optionalSlotValType(vt: ValType): ValType {
  return match (vt) {
    case ValTypeRef as r: new ValTypeRefNull(r.target)
    case ValTypeRefExtern: new ValTypeExternRef()
    case _: vt
  };
}

/**
 * The canonical wasm field list for a record type: one slot per
 * property (optional properties' reference slots nullable-ized), plus
 * the `$present` mask when the type has optional fields, sorted.
 */
export function recordWasmFields(wasm: WasmModule, recIn: RecordType,
    subFunc: WasmFunction | null): GrowableArray<WasmField> {
  // A row is fields only the whole substitution supplies.
  var rec = recIn;
  if (recIn.row != null && subFunc != null) {
    let whole = substituteTypeParamsInFunctionContext(wasm, subFunc, recIn);
    if (whole is RecordType) {
      rec = whole;
    }
  }
  let fields = new Array<WasmField>();
  for (let pair in rec.properties) {
    var vt = typeToValTypeWithSub(wasm, pair.value, subFunc);
    if (rec.isOptional(pair.key)) {
      vt = optionalSlotValType(vt);
    }
    fields.push(new WasmField(pair.key, vt, false));
  }
  let optionals = rec.optionalProperties;
  if (optionals != null && optionals.size > 0) {
    let words = presentWordCount(optionals.size);
    for (var w = 0; w < words; w += 1) {
      fields.push(new WasmField(presentWordName(w), new ValTypeI64(), false));
    }
  }
  sortWasmFields(fields);
  return fields;
}

export function typeToValTypeWithSub(wasm: WasmModule, t: Type, wasmFunction: WasmFunction | null): ValType {
  if (wasmFunction != null) {
    return typeToValType(wasm, substituteTypeParamsInFunctionContext(wasm, wasmFunction, t));
  }
  return typeToValType(wasm, t);
}

export function mapReturnTypeToWasmResultsWithSub(wasm: WasmModule, type: Type, returns: GrowableArray<ValType>, wasmFunction: WasmFunction | null): void {
  if (wasmFunction != null) {
    mapReturnTypeToWasmResults(wasm, substituteTypeParamsInFunctionContext(wasm, wasmFunction, type), returns);
  } else {
    mapReturnTypeToWasmResults(wasm, type, returns);
  }
}

export function containsMixinThis(type: Type): boolean {
  return match (type) {
  case ThisType: true
  case ClassType as resolvedCt: {
    if (resolvedCt.name.length >= 5 && resolvedCt.name.sliceBytes(resolvedCt.name.length - 5, resolvedCt.name.length) == "_This") {
      true
    } else if (resolvedCt.typeArguments != null) {
      var found = false;
      for (let arg in (resolvedCt.typeArguments as Array<Type>)) {
        if (containsMixinThis(arg)) {
          found = true;
          break;
        }
      }
      found
    } else {
      false
    }
  }
  case UnionType {types}: {
    var found = false;
    for (let ut in types) {
      if (containsMixinThis(ut)) {
        found = true;
        break;
      }
    }
    found
  }
  case ArrayType {elementType}: {
    containsMixinThis(elementType)
  }
  case TupleType {elementTypes}: {
    var found = false;
    for (let el in elementTypes) {
      if (containsMixinThis(el)) {
        found = true;
        break;
      }
    }
    found
  }
  case InlineParamType: false
  case InlineTupleType {elementTypes}: {
    var found = false;
    for (let el in elementTypes) {
      if (containsMixinThis(el)) {
        found = true;
        break;
      }
    }
    found
  }
  case FunctionType as ft: {
    var found = false;
    for (let p in ft.parameters) {
      if (containsMixinThis(p)) {
        found = true;
        break;
      }
    }
    if (!found) {
      found = containsMixinThis(ft.returnType);
    }
    found
  }
  case _: false
};
}

export function mapMixinThisInType(ct: ClassType, type: Type): Type {
  if (!containsMixinThis(type)) {
    return type;
  }
  return match (type) {
    case ThisType: ct as Type
    case ClassType as resolvedCt: {
      if (resolvedCt.name.length >= 5 && resolvedCt.name.sliceBytes(resolvedCt.name.length - 5, resolvedCt.name.length) == "_This") {
        ct as Type
      } else {
        let {typeArguments} = resolvedCt;
        if (typeArguments != null) {
          let newArgs = new Array<Type>();
          for (let arg in typeArguments) {
            newArgs.push(mapMixinThisInType(ct, arg));
          }
          let inst = new ClassType(resolvedCt.id, resolvedCt.symbolId, resolvedCt.name);
          inst.typeParameters = resolvedCt.typeParameters;
          inst.typeArguments = newArgs;
          inst.genericSource = resolvedCt.genericSource;
          inst.superType = resolvedCt.superType;
          for (let impl in resolvedCt.implementsList) {
            inst.implementsList.push(impl);
          }
          for (let m in resolvedCt.mixins) {
            inst.mixins.push(mapMixinThisInType(ct, m) as MixinType);
          }
          inst.members = resolvedCt.members;
          inst.constructorType = if (resolvedCt.constructorType != null) {
            let ctor = resolvedCt.constructorType as FunctionType;
            let newParams = new Array<Type>();
            for (let p in ctor.parameters) {
              newParams.push(mapMixinThisInType(ct, p));
            }
            let newFt = internFunctionType(newParams, ctor.returnType, ctor.info);
            newFt.functionSymbolId = ctor.functionSymbolId;
            newFt.functionSymbolName = ctor.functionSymbolName;
            countCodegenFunctionType(8);
            newFt
          } else {
            null
          };
          inst.fieldSetterNames = resolvedCt.fieldSetterNames;
          inst.decoratorSubjectName = resolvedCt.decoratorSubjectName;
          inst.decoratorFieldName = resolvedCt.decoratorFieldName;
          inst.decoratedFields = resolvedCt.decoratedFields;
          inst.decoratorSharedScopeKey = resolvedCt.decoratorSharedScopeKey;
          inst.isFinal = resolvedCt.isFinal;
          inst.isCaseClass = resolvedCt.isCaseClass;
          inst.derivesEquality = resolvedCt.derivesEquality;
          inst.isAbstract = resolvedCt.isAbstract;
           inst.isExtension = resolvedCt.isExtension;
          if (resolvedCt.isExtension && resolvedCt.onType != null) {
            inst.onType = mapMixinThisInType(ct, resolvedCt.onType as Type);
          }
          inst.isSealed = resolvedCt.isSealed;
          inst.sourcePath = resolvedCt.sourcePath;
          inst.sealedVariants = resolvedCt.sealedVariants;
          inst.declaredFields = resolvedCt.declaredFields;
          inst.forwardVariantNames = resolvedCt.forwardVariantNames;
          inst.isMixinIntermediate = resolvedCt.isMixinIntermediate;
          inst.privateScopeKey = resolvedCt.privateScopeKey;
          inst as Type
        } else {
          resolvedCt as Type
        }
      }
    }
    case UnionType {types}: {
      let newTypes = new Array<Type>();
      for (let ut in types) {
        newTypes.push(mapMixinThisInType(ct, ut));
      }
      new UnionType(newTypes) as Type
    }
    case ArrayType {elementType, elementsMutable}: {
      new ArrayType(mapMixinThisInType(ct, elementType), elementsMutable) as Type
    }
    case TupleType {elementTypes, row, rowIndex}: {
      let newElems = new Array<Type>();
      for (let el in elementTypes) {
        newElems.push(mapMixinThisInType(ct, el));
      }
      new TupleType(newElems, row, rowIndex) as Type
    }
    case InlineParamType: type
    case InlineTupleType {elementTypes}: {
      let newElems = new Array<Type>();
      for (let el in elementTypes) {
        newElems.push(mapMixinThisInType(ct, el));
      }
      new InlineTupleType(newElems) as Type
    }
    case FunctionType as ft: {
      let newParams = new Array<Type>();
      for (let p in ft.parameters) {
        newParams.push(mapMixinThisInType(ct, p));
      }
      let newRet = mapMixinThisInType(ct, ft.returnType);
      let newFt = internFunctionType(newParams, newRet, ft.info, ft.typeParameters, ft.typeArguments, ft.genericSource, ft.overloads);
      newFt.functionSymbolId = ft.functionSymbolId;
      newFt.functionSymbolName = ft.functionSymbolName;
      countCodegenFunctionType(7);
      newFt as Type
    }
    case _: type
  };
}

export function isStructSubtype(sub: WasmType, superType: WasmType): boolean {
  if (sub.index == superType.index && sub.index != -1) {
    return true;
  }
  if (sub.uid == superType.uid) {
    return true;
  }
  if (sub is WasmStruct) {
    var curr = sub.superStruct;
    while (curr != null) {
      let c = curr;
      if ((c.index != -1 && c.index == superType.index) || c.uid == superType.uid) {
        return true;
      }
      curr = c.superStruct;
    }
  }
  return false;
}

export function isWasmSubtypeWithStructs(sub: ValType, superType: ValType): boolean {
  return match (sub) {
  case ValTypeRef as ta: match (superType) {
    case ValTypeRef as tb: isStructSubtype(ta.target, tb.target)
    case ValTypeRefNull as tb: isStructSubtype(ta.target, tb.target)
    case ValTypeEqRef: true
    case ValTypeStructRef: true
    case ValTypeAnyRef: true
    case _: false
  }
  case ValTypeRefNull as ta: match (superType) {
    case ValTypeRefNull as tb: isStructSubtype(ta.target, tb.target)
    case ValTypeEqRef: true
    case ValTypeStructRef: true
    case ValTypeAnyRef: true
    case _: false
  }
  case ValTypeNullRef: isNullableAnyRef(superType)
  case ValTypeRefExtern: match (superType) {
    case ValTypeRefExtern: true
    case ValTypeExternRef: true
    case _: false
  }
  case ValTypeExternRef: superType is ValTypeExternRef
  case _: valTypeToOpcode(sub) == valTypeToOpcode(superType)
};
}

/**
 * `Future<Option<V>>`, out of an `AsyncIterator<V>` instantiation: the
 * future carried by the Pending arm (`inline (2, _, Future<Option<V>>)`)
 * of `next(): AsyncStep<V>`, with `V` substituted at `iterType`'s type
 * arguments. Null for a synchronous `Iterator<V>` or anything else.
 */
export function asyncIteratorPendingFuture(
  wasm: WasmModule,
  iterType: InterfaceType
): ClassType | null {
  if (!iterType.members.has('next')) {
    return null;
  }
  let mi = iterType.members['next'];
  if (!(mi is MethodInfo) || !(mi.type is FunctionType)) {
    return null;
  }
  let itParams = getInterfaceTypeParameters(iterType);
  let resolvedFt = substituteTypeParamsInCodegen(
      wasm, itParams, iterType.typeArguments, mi.type) as FunctionType;
  let stepT = unwrapAliases(resolvedFt.returnType);
  if (!(stepT is UnionType)) {
    return null;
  }
  for (let arm in (stepT as UnionType).types) {
    let rawArm = unwrapAliases(arm);
    if (rawArm is InlineTupleType) {
      let elems = (rawArm as InlineTupleType).elementTypes;
      if (elems.length == 3) {
        let third = unwrapAliases(elems[2]);
        if (third is ClassType) {
          return third as ClassType;
        }
      }
    }
  }
  return null;
}
