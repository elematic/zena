import { 
  Type, FunctionType, I32Type, F32Type, F64Type, VoidType, BooleanType, ClassType, 
  InterfaceType, TypeAliasType, U32Type, I64Type, U64Type, ArrayType, NullType, 
  UnknownType, ErrorType, AnyType, AnyRefType, EqRefType, NeverType, HoleType, 
  FieldInfo, MethodInfo, typeToString, ByteArrayType, TypeParameterType, ThisType, 
  UnionType, InlineTupleType, baseType, BoolLiteralType, NumLiteralType, StringLiteralType,
  RecordType, TupleType
} from '../types.zena';
import { SemanticModel } from '../semantic-model.zena';
import { Node } from '../ast.zena';
import { FunctionContext } from './function-context.zena';
import { 
  WasmModule, WasmStruct, WasmField, WasmSignature, WasmFunction, RecordDispatchInfo,
  sortWasmFields
} from './wasm-module.zena';
import { 
  ValType, ValTypeVoid, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeFuncRef, 
  ValTypeAnyRef, ValTypeStructRef, ValTypeEqRef, ValTypeRefNull, ValTypeRef, valTypeToOpcode 
} from './wasm.zena';
import { String } from "zena:string";
import { i32ToString } from "zena:string-convert";
import { HashMap } from 'zena:map';
import { Array } from 'zena:array';
import { 
  getMemberRootClass, getClassKey, getInterfaceKey, ClassKey, InterfaceKey, 
  ClassInterfaceKey, InterfaceMemberKey, CellKey, ClosureKey, ExportKey, ExportGlobalKey
} from './codegen-utils.zena';

export let getClassTypeParameters = (ct: ClassType): Array<TypeParameterType> | null => {
  return (ct.genericSource ?? ct).typeParameters;
};

export let getInterfaceTypeParameters = (it: InterfaceType): Array<TypeParameterType> | null => {
  return (it.genericSource ?? it).typeParameters;
};

export let substituteTypeParamsInCodegen = (
  typeParams: Array<TypeParameterType> | null,
  typeArgs: Array<Type> | null,
  t: Type
): Type => {
  let params = typeParams;
  let args = typeArgs;
  return match (t) {
    case TypeParameterType as tp: {
      if (params != null && args != null) {
        let paramsVal = params as Array<TypeParameterType>;
        let argsVal = args as Array<Type>;
        var found: Type | null = null;
        for (var i = 0; i < paramsVal.length; i += 1) {
          if (paramsVal[i].name == tp.name && i < argsVal.length) {
            found = argsVal[i];
            break;
          }
        }
        if (found != null) {
          return found as Type;
        }
      }
      t
    }
    case ArrayType {elementType}: {
      new ArrayType(substituteTypeParamsInCodegen(params, args, elementType))
    }
    case TupleType {elementTypes}: {
      let newElems = new Array<Type>();
      for (let el in elementTypes) {
        newElems.push(substituteTypeParamsInCodegen(params, args, el));
      }
      new TupleType(newElems)
    }
    case InlineTupleType {elementTypes}: {
      let newElems = new Array<Type>();
      for (let el in elementTypes) {
        newElems.push(substituteTypeParamsInCodegen(params, args, el));
      }
      new InlineTupleType(newElems)
    }
    case UnionType {types}: {
      let newTypes = new Array<Type>();
      for (let ut in types) {
        newTypes.push(substituteTypeParamsInCodegen(params, args, ut));
      }
      new UnionType(newTypes)
    }
    case RecordType as rec: {
      let newProps = new HashMap<String, Type>();
      let keys = rec.properties.keys();
      while (let (true, key) = keys.next()) {
        newProps[key] = substituteTypeParamsInCodegen(params, args, rec.properties[key]);
      }
      let newRec = new RecordType(newProps, rec.optionalProperties);
      newRec.enumDeclaration = rec.enumDeclaration;
      newRec
    }
    case FunctionType as ft: {
      let newParams = new Array<Type>();
      for (let p in ft.parameters) {
        newParams.push(substituteTypeParamsInCodegen(params, args, p));
      }
      let newRet = substituteTypeParamsInCodegen(params, args, ft.returnType);
      let newFt = new FunctionType(newParams, ft.parameterNames, newRet);
      newFt.typeParameters = ft.typeParameters;
      newFt.typeArguments = ft.typeArguments;
      newFt.genericSource = ft.genericSource;
      newFt.parameterInitializers = ft.parameterInitializers;
      newFt.parameterSymbols = ft.parameterSymbols;
      newFt.optionalParameters = ft.optionalParameters;
      newFt.isFinal = ft.isFinal;
      newFt.isAbstract = ft.isAbstract;
      newFt.overloads = ft.overloads;
      newFt
    }
    case ClassType as ct: {
      var hasArgs = false;
      let ctArgsVal = new Array<Type>();
      let ctParams = getClassTypeParameters(ct);
      if (ct.typeArguments != null) {
        hasArgs = true;
        for (let arg in (ct.typeArguments as Array<Type>)) {
          ctArgsVal.push(arg);
        }
      } else if (params != null && args != null && ctParams != null) {
        hasArgs = true;
        for (let param in (ctParams as Array<TypeParameterType>)) {
          ctArgsVal.push(param as Type);
        }
      }
      if (hasArgs && ctArgsVal.length > 0) {
        let newArgs = new Array<Type>();
        for (let arg in ctArgsVal) {
          newArgs.push(substituteTypeParamsInCodegen(params, args, arg));
        }
        let inst = new ClassType(ct.id, ct.name);
        inst.typeParameters = ctParams;
        inst.typeArguments = newArgs;
        inst.genericSource = ct.genericSource ?? ct;
        let combinedParams = new Array<TypeParameterType>();
        let combinedArgs = new Array<Type>();
        if (ctParams != null) {
          for (let p in (ctParams as Array<TypeParameterType>)) {
            combinedParams.push(p);
          }
          for (let a in newArgs) {
            combinedArgs.push(a);
          }
        }
        if (params != null && args != null) {
          for (let p in (params as Array<TypeParameterType>)) {
            combinedParams.push(p);
          }
          for (let a in (args as Array<Type>)) {
            combinedArgs.push(a);
          }
        }

        if (ct.superType != null) {
          inst.superType = substituteTypeParamsInCodegen(combinedParams, combinedArgs, ct.superType as Type) as ClassType;
        }
        for (let impl in ct.implementsList) {
          inst.implementsList.push(substituteTypeParamsInCodegen(combinedParams, combinedArgs, impl) as InterfaceType);
        }
        inst.members = ct.members;
        inst.constructorType = ct.constructorType;
        inst.fieldSetterNames = ct.fieldSetterNames;
        for (let vt in ct.vtable) {
          inst.vtable.push(vt);
        }
        inst.isFinal = ct.isFinal;
        inst.isCaseClass = ct.isCaseClass;
        inst.isAbstract = ct.isAbstract;
        inst.isExtension = ct.isExtension;
        inst.isSealed = ct.isSealed;
        inst.sealedVariants = ct.sealedVariants;
        if (ct.onType != null) {
          inst.onType = substituteTypeParamsInCodegen(combinedParams, combinedArgs, ct.onType as Type);
        }
        inst.sourcePath = ct.sourcePath;
        inst
      } else {
        ct
      }
    }
    case InterfaceType as it: {
      var hasArgs = false;
      let itArgsVal = new Array<Type>();
      let itParams = getInterfaceTypeParameters(it);
      if (it.typeArguments != null) {
        hasArgs = true;
        for (let arg in (it.typeArguments as Array<Type>)) {
          itArgsVal.push(arg);
        }
      } else if (params != null && args != null && itParams != null) {
        hasArgs = true;
        for (let param in (itParams as Array<TypeParameterType>)) {
          itArgsVal.push(param as Type);
        }
      }
      if (hasArgs && itArgsVal.length > 0) {
        let newArgs = new Array<Type>();
        for (let arg in itArgsVal) {
          newArgs.push(substituteTypeParamsInCodegen(params, args, arg));
        }
        let inst = new InterfaceType(it.id, it.name);
        inst.typeParameters = itParams;
        inst.typeArguments = newArgs;
        inst.genericSource = it.genericSource ?? it;
        let combinedParams = new Array<TypeParameterType>();
        let combinedArgs = new Array<Type>();
        if (itParams != null) {
          for (let p in (itParams as Array<TypeParameterType>)) {
            combinedParams.push(p);
          }
          for (let a in newArgs) {
            combinedArgs.push(a);
          }
        }
        if (params != null && args != null) {
          for (let p in (params as Array<TypeParameterType>)) {
            combinedParams.push(p);
          }
          for (let a in (args as Array<Type>)) {
            combinedArgs.push(a);
          }
        }
        let newExtends = new Array<InterfaceType>();
        for (let ext in it.extendsList) {
          newExtends.push(substituteTypeParamsInCodegen(combinedParams, combinedArgs, ext) as InterfaceType);
        }
        inst.extendsList = newExtends;
        inst.members = it.members;
        inst
      } else {
        it
      }
    }
    case _: t
  };
};

let addTransitiveInterfaces = (
  it: InterfaceType,
  allParams: Array<TypeParameterType>,
  allArgs: Array<Type>,
  seen: HashMap<String, boolean>
): void => {
  let key = getInterfaceKey(it) as String;
  if (seen.has(key)) {
    return;
  }
  seen[key] = true;
  
  let genericSource = it.genericSource ?? it;
  let itParams = getInterfaceTypeParameters(it);
  if (genericSource.typeParameters != null && it.typeArguments != null && itParams != null) {
    let tps = genericSource.typeParameters as Array<TypeParameterType>;
    let tas = it.typeArguments as Array<Type>;
    for (var i = 0; i < tps.length; i += 1) {
      allParams.push(tps[i]);
      if (i < tas.length) {
        allArgs.push(tas[i]);
      } else {
        allArgs.push(new AnyType());
      }
    }
  }
  
  for (let ext in it.extendsList) {
    let itParamsVal = getInterfaceTypeParameters(it);
    let resolvedExt = substituteTypeParamsInCodegen(itParamsVal, it.typeArguments, ext) as InterfaceType;
    addTransitiveInterfaces(resolvedExt, allParams, allArgs, seen);
  }
};

let addClassTransitiveInterfaces = (
  ct: ClassType,
  allParams: Array<TypeParameterType>,
  allArgs: Array<Type>,
  seen: HashMap<String, boolean>
): void => {
  let ctParams = getClassTypeParameters(ct);
  for (let impl in ct.implementsList) {
    if (impl is InterfaceType) {
      let resolved = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, impl) as InterfaceType;
      addTransitiveInterfaces(resolved, allParams, allArgs, seen);
    }
  }
  if (ct.superType != null) {
    let superCt = ct.superType as ClassType;
    let superResolved = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, superCt) as ClassType;
    
    // Add superclass's own type parameters
    let genericSource = superResolved.genericSource ?? superResolved;
    let superCtParams = getClassTypeParameters(superResolved);
    if (genericSource.typeParameters != null && superResolved.typeArguments != null && superCtParams != null) {
      let tps = genericSource.typeParameters as Array<TypeParameterType>;
      let tas = superResolved.typeArguments as Array<Type>;
      for (var i = 0; i < tps.length; i += 1) {
        allParams.push(tps[i]);
        if (i < tas.length) {
          allArgs.push(tas[i]);
        } else {
          allArgs.push(new AnyType());
        }
      }
    }
    
    // Recursively add superclass's interfaces and superclasses
    addClassTransitiveInterfaces(superResolved, allParams, allArgs, seen);
  }
};

export let substituteTypeParamsInClassContext = (classType: ClassType | null, t: Type): Type => {
  if (classType == null) {
    return t;
  }
  
  let allParams = new Array<TypeParameterType>();
  let allArgs = new Array<Type>();
  
  // 1. Add class's own type arguments
  let ct = classType as ClassType;
  let ctParams = getClassTypeParameters(ct);
  if (ctParams != null && ct.typeArguments != null) {
    let tps = ctParams as Array<TypeParameterType>;
    let tas = ct.typeArguments as Array<Type>;
    for (var i = 0; i < tps.length; i += 1) {
      allParams.push(tps[i]);
      if (i < tas.length) {
        allArgs.push(tas[i]);
      } else {
        allArgs.push(new AnyType());
      }
    }
  }
  
  // 2. Add implements list and superType recursively
  let seen = new HashMap<String, boolean>();
  addClassTransitiveInterfaces(ct, allParams, allArgs, seen);
  
  let substituted = substituteTypeParamsInCodegen(allParams, allArgs, t);
  return mapMixinThisInType(ct, substituted);
};

export let getNodeType = (ctx: FunctionContext, node: Node): Type | null => {
  let t = ctx.wasmFunction.model.getNodeType(node);
  if (t == null) { return null as Type; }
  let ct = ctx.wasmFunction.classType;
  if (t is ThisType && ct != null) {
    return ct;
  }
  if (ct != null) {
    return substituteTypeParamsInClassContext(ct, t);
  } else {
    return substituteTypeParamsInCodegen(null, null, t);
  }
};

export let getInterfaceMemberSignature = (wasm: WasmModule, it: InterfaceType, fieldName: String): WasmSignature => {
  let itParams = getInterfaceTypeParameters(it);
  if (fieldName.startsWith("get#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var memberType: Type | null = null;
    if (it.members.has(propName)) {
      let fi = it.members[propName] as FieldInfo;
      memberType = substituteTypeParamsInCodegen(itParams, it.typeArguments, fi.type);
    } else if (it.members.has(fieldName)) {
      let mi = it.members[fieldName] as MethodInfo;
      let ft = mi.type as FunctionType;
      let resolvedFt = substituteTypeParamsInCodegen(itParams, it.typeArguments, ft) as FunctionType;
      memberType = resolvedFt.returnType;
    }
    if (memberType == null) {
      throw new Error("Interface getter member " + fieldName + " not found on interface " + it.name);
    }
    let params = new Array<ValType>();
    params.push(new ValTypeAnyRef());
    let returns = new Array<ValType>();
    returns.push(typeToValType(wasm, memberType as Type));
    return wasm.getSignature(params, returns);
  } else if (fieldName.startsWith("set#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var memberType: Type | null = null;
    if (it.members.has(propName)) {
      let fi = it.members[propName] as FieldInfo;
      memberType = substituteTypeParamsInCodegen(itParams, it.typeArguments, fi.type);
    } else if (it.members.has(fieldName)) {
      let mi = it.members[fieldName] as MethodInfo;
      let ft = mi.type as FunctionType;
      let resolvedFt = substituteTypeParamsInCodegen(itParams, it.typeArguments, ft) as FunctionType;
      if (resolvedFt.parameters.length > 0) {
        memberType = resolvedFt.parameters[0];
      }
    }
    if (memberType == null) {
      throw new Error("Interface setter member " + fieldName + " not found on interface " + it.name);
    }
    let params = new Array<ValType>();
    params.push(new ValTypeAnyRef());
    params.push(typeToValType(wasm, memberType as Type));
    let returns = new Array<ValType>();
    return wasm.getSignature(params, returns);
  } else {
    let mi = it.members[fieldName] as MethodInfo;
    let ft = mi.type as FunctionType;
    let resolvedFt = substituteTypeParamsInCodegen(itParams, it.typeArguments, ft) as FunctionType;
    let params = new Array<ValType>();
    params.push(new ValTypeAnyRef());
    for (let p in resolvedFt.parameters) {
      params.push(typeToValType(wasm, p));
    }
    let returns = new Array<ValType>();
    mapReturnTypeToWasmResults(wasm, resolvedFt.returnType, returns);
    return wasm.getSignature(params, returns);
  }
};

export let getClassMemberSignature = (wasm: WasmModule, ct: ClassType, fieldName: String): WasmSignature => {
  let rootClass = getMemberRootClass(ct, fieldName);
  let params = new Array<ValType>();
  let rootKey = getClassKey(rootClass);
  let classStruct = if (wasm.classStructs.has(rootKey)) wasm.classStructs[rootKey] else null;
  if (classStruct != null) {
    params.push(new ValTypeRefNull(classStruct as WasmStruct));
  } else {
    params.push(new ValTypeAnyRef());
  }

  let returns = new Array<ValType>();

  if (fieldName.startsWith("get#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var fieldType: Type = new VoidType();
    if (ct.members.has(propName)) {
      fieldType = substituteTypeParamsInClassContext(ct, ct.members[propName].type);
    } else if (ct.members.has(fieldName)) {
      let mi = ct.members[fieldName] as MethodInfo;
      let ft = mi.type as FunctionType;
      let resolvedFt = substituteTypeParamsInClassContext(ct, ft) as FunctionType;
      fieldType = resolvedFt.returnType;
    }
    returns.push(typeToValType(wasm, fieldType));
    return wasm.getSignature(params, returns);
  } else if (fieldName.startsWith("set#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var fieldType: Type = new VoidType();
    if (ct.members.has(propName)) {
      fieldType = substituteTypeParamsInClassContext(ct, ct.members[propName].type);
    } else if (ct.members.has(fieldName)) {
      let mi = ct.members[fieldName] as MethodInfo;
      let ft = mi.type as FunctionType;
      let resolvedFt = substituteTypeParamsInClassContext(ct, ft) as FunctionType;
      fieldType = resolvedFt.parameters[0];
    }
    params.push(typeToValType(wasm, fieldType));
    return wasm.getSignature(params, returns);
  } else {
    var ft: FunctionType | null = null;
    if (ct.members.has(fieldName)) {
      let mi = ct.members[fieldName] as MethodInfo;
      let rawFt = mi.type as FunctionType;
      ft = substituteTypeParamsInClassContext(ct, rawFt) as FunctionType;
    }
    if (ft != null) {
      let fType = ft as FunctionType;
      for (let p in fType.parameters) {
        params.push(typeToValType(wasm, p));
      }
      mapReturnTypeToWasmResults(wasm, fType.returnType, returns);
    }
    return wasm.getSignature(params, returns);
  }
};

export let getValTypeKey = (type: ValType): String => {
  match (type) {
    case ValTypeRef as r: {
      if (r.target is WasmStruct) {
        let s = r.target as WasmStruct;
        if (s.name != null) {
          return "ref_" + (s.name as String);
        }
      }
      return "ref_anon";
    }
    case ValTypeRefNull as r: {
      if (r.target is WasmStruct) {
        let s = r.target as WasmStruct;
        if (s.name != null) {
          return "refnull_" + (s.name as String);
        }
      }
      return "refnull_anon";
    }
    case _: {
      return i32ToString(valTypeToOpcode(type));
    }
  }
};

export let getClosureKey = (params: Array<ValType>, returns: Array<ValType>): ClosureKey => {
  var keyStr = "";
  for (let p in params) {
    keyStr = keyStr + getValTypeKey(p) + ",";
  }
  keyStr = keyStr + "=>";
  for (let r in returns) {
    keyStr = keyStr + getValTypeKey(r) + ",";
  }
  return keyStr as ClosureKey;
};

export let getCellKey = (valType: ValType): CellKey => {
  return getValTypeKey(valType) as CellKey;
};

export let getClosureStruct = (wasm: WasmModule, ftVal: any): WasmStruct => {
  let ft = ftVal as FunctionType;
  let params = new Array<ValType>();
  params.push(new ValTypeEqRef()); // ctx
  for (let p in ft.parameters) {
    params.push(typeToValType(wasm, p));
  }
  let returns = new Array<ValType>();
  mapReturnTypeToWasmResults(wasm, ft.returnType, returns);

  let implSig = wasm.getSignature(params, returns);

  let key = getClosureKey(params, returns);

  if (wasm.closureStructs.has(key)) {
    return wasm.closureStructs[key];
  }

  let fields = new Array<WasmField>();
  fields.push(new WasmField("func", new ValTypeRef(implSig), false));
  fields.push(new WasmField("ctx", new ValTypeEqRef(), false));
  let st = new WasmStruct("Closure", fields);
  wasm.types.push(st);
  wasm.closureStructs[key] = st;
  return st;
};

export let getCellStruct = (wasm: WasmModule, valType: ValType): WasmStruct => {
  let key = getCellKey(valType);
  if (wasm.cellStructs.has(key)) {
    return wasm.cellStructs[key];
  }
  let fields = new Array<WasmField>();
  fields.push(new WasmField("value", valType, true)); // mutable
  let name = "Cell_" + (key as String);
  let st = new WasmStruct(name, fields);
  wasm.types.push(st);
  wasm.cellStructs[key] = st;
  return st;
};

export let typeToValType = (wasm: WasmModule, t: Type): ValType => match (t) {
  case TypeAliasType as a: typeToValType(wasm, a.target)
  case BoolLiteralType: new ValTypeI32()
  case NumLiteralType as num: typeToValType(wasm, baseType(num))
  case StringLiteralType: {
    var stringStruct: WasmStruct | null = null;
    let stringClass = wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (wasm.classStructs.has(key)) {
        stringStruct = wasm.classStructs[key];
      }
    }
    if (stringStruct != null) {
      new ValTypeRefNull(stringStruct as WasmStruct)
    } else {
      new ValTypeStructRef()
    }
  }
  case F64Type: new ValTypeF64()
  case F32Type: new ValTypeF32()
  case I32Type: new ValTypeI32()
  case U32Type: new ValTypeI32()
  case I64Type: new ValTypeI64()
  case U64Type: new ValTypeI64()
  case BooleanType: new ValTypeI32()
  case RecordType as rec: {
    let fields = new Array<WasmField>();
    for (let pair in rec.properties) {
       fields.push(new WasmField(pair.key, typeToValType(wasm, pair.value), false));
    }
    sortWasmFields(fields);
    let info_opt = wasm.findRecordDispatch(fields);
    match (info_opt) {
      case RecordDispatchInfo as info: new ValTypeRef(info.fatPtrType)
      case null: {
        var errStr = "";
        for (let f in fields) {
           if (f.name != null) errStr = errStr + (f.name as String) + ", ";
        }
        throw new Error("Record fat ptr type not generated during discovery pass! Fields: " + errStr);
      }
    }
  }
  case TupleType as tup: {
    let fields = new Array<WasmField>();
    for (var i = 0; i < tup.elementTypes.length; i += 1) {
      let t_i = tup.elementTypes[i];
      fields.push(new WasmField(i32ToString(i), typeToValType(wasm, t_i), false));
    }
    let structDef = wasm.getStruct(null, fields);
    new ValTypeRef(structDef);
  }
  case ClassType as ct: {
    if (ct.name == "array" && ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0) {
      let elemValType = typeToValType(wasm, (ct.typeArguments as Array<Type>)[0]);
      return new ValTypeRefNull(wasm.getArray(elemValType, true));
    }
    if (ct.name == "ByteArray") {
      return new ValTypeRefNull(wasm.getByteArrayType());
    }
    if (ct.isExtension && ct.onType != null) {
      return typeToValType(wasm, ct.onType as Type);
    }
    if (wasm.classStructs.has(getClassKey(ct))) {
      new ValTypeRefNull(wasm.classStructs[getClassKey(ct)])
    } else {
      throw new Error("Class struct not found for: " + ct.name);
    }
  }
  case InterfaceType as it: {
    let key = getInterfaceKey(it);
    if (wasm.interfaceStructs.has(key)) {
      new ValTypeRefNull(wasm.interfaceStructs[key])
    } else {
      throw new Error("Interface fat pointer type not generated during discovery pass! Key: " + (key as String) + " Name: " + it.name);
    }
  }
  case ArrayType as at: {
    let elemValType = typeToValType(wasm, at.elementType);
    new ValTypeRefNull(wasm.getArray(elemValType, true))
  }
  case ByteArrayType: {
    new ValTypeRefNull(wasm.getByteArrayType())
  }
  case VoidType: new ValTypeVoid()
  case NullType: new ValTypeStructRef()
  case UnknownType: {
    throw new Error("Codegen should never see type: " + typeToString(t));
  }
  case ErrorType: {
    throw new Error("Codegen should never see type: " + typeToString(t));
  }
  case AnyType: new ValTypeAnyRef()
  case TypeParameterType: new ValTypeAnyRef()
  case AnyRefType: new ValTypeAnyRef()
  case EqRefType: new ValTypeEqRef()
  case TypeParameterType: new ValTypeAnyRef()
  case ThisType: new ValTypeAnyRef()
  case NeverType: new ValTypeVoid()
  case HoleType: new ValTypeI32()
  case FunctionType: {
    new ValTypeRefNull(getClosureStruct(wasm, t))
  }
  case UnionType as ut: {
    var hasVoid = false;
    for (let t_i in ut.types) {
      if (t_i is VoidType) {
        hasVoid = true;
      }
    }
    if (hasVoid) {
      new ValTypeVoid()
    } else {
      let nonNeverTypes = new Array<Type>();
      for (let t_i in ut.types) {
        if (!(t_i is NeverType || t_i is HoleType)) {
          nonNeverTypes.push(t_i);
        }
      }
      if (nonNeverTypes.length == 0) {
        new ValTypeVoid()
      } else if (nonNeverTypes.length < ut.types.length) {
        if (nonNeverTypes.length == 1) {
          let v = typeToValType(wasm, nonNeverTypes[0]);
          match (v) {
            case ValTypeRef as vr: new ValTypeRefNull(vr.target)
            case _: v
          }
        } else {
          typeToValType(wasm, new UnionType(nonNeverTypes))
        }
      } else {
        let nonNullTypes = new Array<Type>();
        for (let t_i in ut.types) {
          if (!(t_i is NullType)) {
            nonNullTypes.push(t_i);
          }
        }
        if (nonNullTypes.length == 1) {
          let v = typeToValType(wasm, nonNullTypes[0]);
          match (v) {
            case ValTypeRef as vr: new ValTypeRefNull(vr.target)
            case _: v
          }
        } else {
          new ValTypeEqRef()
        }
      }
    }
  }
  case _: {
    throw new Error("typeToValType: unsupported type: " + typeToString(t));
  }
};

export let mapReturnTypeToWasmResults = (wasm: WasmModule, type: Type, returns: Array<ValType>): void => {
  if (type is VoidType || type is NeverType || type is HoleType) {
    return;
  }
  if (type is InlineTupleType) {
    let tupleType = type as InlineTupleType;
    for (let el in tupleType.elementTypes) {
      returns.push(typeToValType(wasm, el));
    }
    return;
  }
  if (type is UnionType) {
    let unionType = type as UnionType;
    var hasVoid = false;
    for (let t in unionType.types) {
      if (t is VoidType) {
        hasVoid = true;
      }
    }
    if (hasVoid) {
      return;
    }
    // Find the first inline tuple in the union to get the WASM signature
    for (let t in unionType.types) {
      if (t is InlineTupleType) {
        let tupleType = t as InlineTupleType;
        for (let el in tupleType.elementTypes) {
          returns.push(typeToValType(wasm, el));
        }
        return;
      }
    }
  }
  returns.push(typeToValType(wasm, type));
};

export let getNonNullableType = (type: Type): Type => match (type) {
  case UnionType {types}: {
    let nonNullTypes = new Array<Type>();
    for (let t_i in types) {
      if (!(t_i is NullType)) {
        nonNullTypes.push(t_i);
      }
    }
    if (nonNullTypes.length == 1) {
      nonNullTypes[0]
    } else {
      type
    }
  }
  case _: type
};

export let typeToValTypeWithSub = (wasm: WasmModule, t: Type, classType: ClassType | null): ValType => {
  if (classType != null) {
    return typeToValType(wasm, substituteTypeParamsInClassContext(classType, t));
  }
  return typeToValType(wasm, t);
};

export let mapReturnTypeToWasmResultsWithSub = (wasm: WasmModule, type: Type, returns: Array<ValType>, classType: ClassType | null): void => {
  if (classType != null) {
    mapReturnTypeToWasmResults(wasm, substituteTypeParamsInClassContext(classType, type), returns);
  } else {
    mapReturnTypeToWasmResults(wasm, type, returns);
  }
};

export let containsMixinThis = (type: Type): boolean => match (type) {
  case ClassType as resolvedCt: {
    if (resolvedCt.name.length >= 5 && resolvedCt.name.sliceBytes(resolvedCt.name.length - 5, resolvedCt.name.length) == "_This") {
      true
    } else if (resolvedCt.typeArguments != null) {
      var found = false;
      for (let arg in (resolvedCt.typeArguments as Array<Type>)) {
        if (containsMixinThis(arg)) {
          found = true;
          break;
        }
      }
      found
    } else {
      false
    }
  }
  case UnionType {types}: {
    var found = false;
    for (let ut in types) {
      if (containsMixinThis(ut)) {
        found = true;
        break;
      }
    }
    found
  }
  case ArrayType {elementType}: {
    containsMixinThis(elementType)
  }
  case TupleType {elementTypes}: {
    var found = false;
    for (let el in elementTypes) {
      if (containsMixinThis(el)) {
        found = true;
        break;
      }
    }
    found
  }
  case InlineTupleType {elementTypes}: {
    var found = false;
    for (let el in elementTypes) {
      if (containsMixinThis(el)) {
        found = true;
        break;
      }
    }
    found
  }
  case FunctionType as ft: {
    var found = false;
    for (let p in ft.parameters) {
      if (containsMixinThis(p)) {
        found = true;
        break;
      }
    }
    if (!found) {
      found = containsMixinThis(ft.returnType);
    }
    found
  }
  case _: false
};

export let mapMixinThisInType = (ct: ClassType, type: Type): Type => {
  if (!containsMixinThis(type)) {
    return type;
  }
  return match (type) {
    case ClassType as resolvedCt: {
      if (resolvedCt.name.length >= 5 && resolvedCt.name.sliceBytes(resolvedCt.name.length - 5, resolvedCt.name.length) == "_This") {
        ct as Type
      } else {
        if (resolvedCt.typeArguments != null) {
          let newArgs = new Array<Type>();
          for (let arg in (resolvedCt.typeArguments as Array<Type>)) {
            newArgs.push(mapMixinThisInType(ct, arg));
          }
          let inst = new ClassType(resolvedCt.id, resolvedCt.name);
          inst.typeParameters = resolvedCt.typeParameters;
          inst.typeArguments = newArgs;
          inst.genericSource = resolvedCt.genericSource;
          inst.superType = resolvedCt.superType;
          for (let impl in resolvedCt.implementsList) {
            inst.implementsList.push(impl);
          }
          inst as Type
        } else {
          resolvedCt as Type
        }
      }
    }
    case UnionType {types}: {
      let newTypes = new Array<Type>();
      for (let ut in types) {
        newTypes.push(mapMixinThisInType(ct, ut));
      }
      new UnionType(newTypes) as Type
    }
    case ArrayType {elementType}: {
      new ArrayType(mapMixinThisInType(ct, elementType)) as Type
    }
    case TupleType {elementTypes}: {
      let newElems = new Array<Type>();
      for (let el in elementTypes) {
        newElems.push(mapMixinThisInType(ct, el));
      }
      new TupleType(newElems) as Type
    }
    case InlineTupleType {elementTypes}: {
      let newElems = new Array<Type>();
      for (let el in elementTypes) {
        newElems.push(mapMixinThisInType(ct, el));
      }
      new InlineTupleType(newElems) as Type
    }
    case FunctionType as ft: {
      let newParams = new Array<Type>();
      for (let p in ft.parameters) {
        newParams.push(mapMixinThisInType(ct, p));
      }
      let newRet = mapMixinThisInType(ct, ft.returnType);
      let newFt = new FunctionType(newParams, ft.parameterNames, newRet);
      newFt.typeParameters = ft.typeParameters;
      newFt.typeArguments = ft.typeArguments;
      newFt.genericSource = ft.genericSource;
      newFt.parameterInitializers = ft.parameterInitializers;
      newFt.parameterSymbols = ft.parameterSymbols;
      newFt.optionalParameters = ft.optionalParameters;
      newFt.isFinal = ft.isFinal;
      newFt.isAbstract = ft.isAbstract;
      newFt.overloads = ft.overloads;
      newFt as Type
    }
    case _: type
  };
};


