import { 
  Type, FunctionType, I32Type, F32Type, F64Type, VoidType, BooleanType, ClassType, 
  InterfaceType, TypeAliasType, U32Type, I64Type, U64Type, ArrayType, NullType, 
  UnknownType, ErrorType, AnyType, AnyRefType, EqRefType, NeverType, HoleType, 
  FieldInfo, MethodInfo, typeToString, ByteArrayType, TypeParameterType, ThisType, 
  UnionType, InlineTupleType, baseType, BoolLiteralType, NumLiteralType, StringLiteralType,
  RecordType, TupleType, MixinType
} from '../types.zena';
import { SemanticModel } from '../semantic-model.zena';
import { Node, Identifier, ThisExpression } from '../ast.zena';
import { FunctionContext } from './function-context.zena';
import { 
  WasmModule, WasmStruct, WasmField, WasmSignature, WasmFunction, RecordDispatchInfo,
  sortWasmFields, WasmArray
} from './wasm-module.zena';
import { 
  ValType, ValTypeVoid, ValTypeI32, ValTypeI64, ValTypeF32, ValTypeF64, ValTypeFuncRef, 
  ValTypeAnyRef, ValTypeStructRef, ValTypeEqRef, ValTypeRefNull, ValTypeRef, valTypeToOpcode,
  WasmType
} from './wasm.zena';
import { String } from "zena:string";
import { i32ToString } from "zena:string-convert";
import { HashMap } from 'zena:map';
import { OrderedMap } from 'zena:ordered-map';
import { Array } from 'zena:array';
import { 
  getMemberRootClass, getClassKey, getInterfaceKey, ClassKey, InterfaceKey, 
  ClassInterfaceKey, InterfaceMemberKey, CellKey, ClosureKey, ExportKey, ExportGlobalKey
} from './codegen-utils.zena';

export let getClassTypeParameters = (ct: ClassType): Array<TypeParameterType> | null => {
  return (ct.genericSource ?? ct).typeParameters;
};

export let getInterfaceTypeParameters = (it: InterfaceType): Array<TypeParameterType> | null => {
  return (it.genericSource ?? it).typeParameters;
};

export let substituteTypeParamsInCodegen = (
  typeParams: Array<TypeParameterType> | null,
  typeArgs: Array<Type> | null,
  t: Type
): Type => {
  if (typeParams == null || typeArgs == null || typeParams.length == 0 || typeArgs.length == 0) {
    return t;
  }
  let params = typeParams;
  let args = typeArgs;
  return match (t) {
    case TypeParameterType as tp: {
      var found: Type | null = null;
      for (var i = 0; i < params.length; i += 1) {
        if (params[i].name == tp.name && i < args.length) {
          found = args[i];
          break;
        }
      }
      if (found != null) {
        return found as Type;
      }
      t
    }
    case ArrayType {elementType}: {
      let sub = substituteTypeParamsInCodegen(params, args, elementType);
      if (sub == elementType) {
        return t;
      }
      new ArrayType(sub)
    }
    case TupleType {elementTypes}: {
      let newElems = new Array<Type>(elementTypes.length);
      var elemsChanged = false;
      for (let el in elementTypes) {
        let sub = substituteTypeParamsInCodegen(params, args, el);
        newElems.push(sub);
        if (sub != el) {
          elemsChanged = true;
        }
      }
      if (!elemsChanged) {
        return t;
      }
      new TupleType(newElems)
    }
    case InlineTupleType {elementTypes}: {
      let newElems = new Array<Type>(elementTypes.length);
      var elemsChanged = false;
      for (let el in elementTypes) {
        let sub = substituteTypeParamsInCodegen(params, args, el);
        newElems.push(sub);
        if (sub != el) {
          elemsChanged = true;
        }
      }
      if (!elemsChanged) {
        return t;
      }
      new InlineTupleType(newElems)
    }
    case UnionType {types}: {
      let newTypes = new Array<Type>(types.length);
      var typesChanged = false;
      for (let ut in types) {
        let sub = substituteTypeParamsInCodegen(params, args, ut);
        newTypes.push(sub);
        if (sub != ut) {
          typesChanged = true;
        }
      }
      if (!typesChanged) {
        return t;
      }
      new UnionType(newTypes)
    }
    case RecordType as rec: {
      var propsChanged = false;
      let newProps = new HashMap<String, Type>();
      let keys = rec.properties.keys();
      while (let (true, key) = keys.next()) {
        let original = rec.properties[key];
        let sub = substituteTypeParamsInCodegen(params, args, original);
        newProps[key] = sub;
        if (sub != original) {
          propsChanged = true;
        }
      }
      if (!propsChanged) {
        return rec;
      }
      let newRec = new RecordType(newProps, rec.optionalProperties);
      newRec.enumDeclaration = rec.enumDeclaration;
      newRec
    }
    case FunctionType as ft: {
      let newParams = new Array<Type>(ft.parameters.length);
      var paramsChanged = false;
      for (let p in ft.parameters) {
        let sub = substituteTypeParamsInCodegen(params, args, p);
        newParams.push(sub);
        if (sub != p) {
          paramsChanged = true;
        }
      }
      let newRet = substituteTypeParamsInCodegen(params, args, ft.returnType);
      var retChanged = newRet != ft.returnType;
      
      var argsChanged = false;
      var newArgs: Array<Type> | null = null;
      if (ft.typeArguments != null) {
        newArgs = new Array<Type>((ft.typeArguments as Array<Type>).length);
        for (let arg in (ft.typeArguments as Array<Type>)) {
          let sub = substituteTypeParamsInCodegen(params, args, arg);
          (newArgs as Array<Type>).push(sub);
          if (sub != arg) {
            argsChanged = true;
          }
        }
      }
      
      if (!paramsChanged && !retChanged && !argsChanged) {
        return ft;
      }
      
      let newFt = new FunctionType(newParams, ft.parameterNames, newRet);
      newFt.typeParameters = ft.typeParameters;
      newFt.typeArguments = newArgs;
      newFt.genericSource = ft.genericSource;
      newFt.parameterInitializers = ft.parameterInitializers;
      newFt.parameterSymbols = ft.parameterSymbols;
      newFt.optionalParameters = ft.optionalParameters;
      newFt.isFinal = ft.isFinal;
      newFt.isAbstract = ft.isAbstract;
      newFt.overloads = ft.overloads;
      newFt.functionSymbolId = ft.functionSymbolId;
      newFt.functionSymbolName = ft.functionSymbolName;
      newFt
    }
    case ClassType as ct: {
      var hasArgs = false;
      let ctArgsVal = new Array<Type>();
      let ctParams = getClassTypeParameters(ct);
      if (ct.typeArguments != null) {
        hasArgs = true;
        for (let arg in (ct.typeArguments as Array<Type>)) {
          ctArgsVal.push(arg);
        }
      } else if (params != null && args != null && ctParams != null) {
        hasArgs = true;
        for (let param in (ctParams as Array<TypeParameterType>)) {
          ctArgsVal.push(param as Type);
        }
      }
      if (hasArgs && ctArgsVal.length > 0) {
        let newArgs = new Array<Type>(ctArgsVal.length);
        var argsChanged = false;
        for (let arg in ctArgsVal) {
          let sub = substituteTypeParamsInCodegen(params, args, arg);
          newArgs.push(sub);
          if (sub != arg) {
            argsChanged = true;
          }
        }
        if (!argsChanged && ct.typeArguments != null) {
          return ct;
        }

        // Share one instantiation per argument list when the source is a
        // pure generic template. Instantiations of a partially-substituted
        // source have their outer context baked into their supertypes, so
        // those are never shared.
        // Share one instantiation per (source instance, argument uids).
        // Method signatures mention the same generic classes over and over;
        // without this every mention deep-copies the class (supertypes,
        // constructor type). The result is determined by the source and the
        // substituted arguments: names free in the source's supertypes are
        // either its own parameters (bound through newArgs, which the key
        // covers) or already concrete.
        var instKey = "";
        for (let arg in newArgs) {
          instKey = instKey + i32ToString(arg.uid) + ",";
        }
        var icache = ct.codegenInstantiations;
        if (icache == null) {
          let fresh = new HashMap<String, ClassType>();
          ct.codegenInstantiations = fresh;
          icache = fresh;
        }
        let icacheVal = icache as HashMap<String, ClassType>;
        if (let (true, hit) = icacheVal.get(instKey)) {
          return hit;
        }

        let inst = new ClassType(ct.id, ct.symbolId, ct.name);
        inst.typeParameters = ctParams;
        inst.typeArguments = newArgs;
        inst.genericSource = ct.genericSource ?? ct;
        let ctParamsLen = if (ctParams != null) {
          (ctParams as Array<TypeParameterType>).length
        } else {
          0
        };
        let combinedParams = new Array<TypeParameterType>(ctParamsLen + params.length);
        let combinedArgs = new Array<Type>(ctParamsLen + args.length);
        if (ctParams != null) {
          for (let p in (ctParams as Array<TypeParameterType>)) {
            combinedParams.push(p);
          }
          for (let a in newArgs) {
            combinedArgs.push(a);
          }
        }
        for (let p in params) {
          combinedParams.push(p);
        }
        for (let a in args) {
          combinedArgs.push(a);
        }

        if (ct.superType != null) {
          inst.superType = substituteTypeParamsInCodegen(combinedParams, combinedArgs, ct.superType as Type) as ClassType;
        }
        for (let impl in ct.implementsList) {
          inst.implementsList.push(substituteTypeParamsInCodegen(combinedParams, combinedArgs, impl) as InterfaceType);
        }
        for (let m in ct.mixins) {
          let subM = substituteTypeParamsInCodegen(combinedParams, combinedArgs, m);
          inst.mixins.push(subM as MixinType);
        }
        inst.members = ct.members;
        inst.constructorType = if (ct.constructorType != null) {
          let ctor = ct.constructorType as FunctionType;
          let newParams = new Array<Type>(ctor.parameters.length);
          for (let p in ctor.parameters) {
            let sub = substituteTypeParamsInCodegen(combinedParams, combinedArgs, p);
            newParams.push(sub);
          }
          let newFt = new FunctionType(newParams, ctor.parameterNames, ctor.returnType);
          newFt.parameterInitializers = ctor.parameterInitializers;
          newFt.parameterSymbols = ctor.parameterSymbols;
          newFt.optionalParameters = ctor.optionalParameters;
          newFt.functionSymbolId = ctor.functionSymbolId;
          newFt.functionSymbolName = ctor.functionSymbolName;
          newFt
        } else {
          null
        };
        inst.fieldSetterNames = ct.fieldSetterNames;
        inst.isFinal = ct.isFinal;
        inst.isCaseClass = ct.isCaseClass;
        inst.isAbstract = ct.isAbstract;
        inst.isExtension = ct.isExtension;
        inst.isSealed = ct.isSealed;
        inst.sealedVariants = ct.sealedVariants;
        inst.declaredFields = ct.declaredFields;
        inst.forwardVariantNames = ct.forwardVariantNames;
        if (ct.onType != null) {
          inst.onType = substituteTypeParamsInCodegen(combinedParams, combinedArgs, ct.onType as Type);
        }
        inst.sourcePath = ct.sourcePath;
        // Register only after the instantiation is fully built: a
        // half-built instance escaping into identity-keyed caches would
        // memoize wrong context for every later user.
        icacheVal[instKey] = inst;
        inst
      } else {
        ct
      }
    }
    case InterfaceType as it: {
      var hasArgs = false;
      let itArgsVal = new Array<Type>();
      let itParams = getInterfaceTypeParameters(it);
      if (it.typeArguments != null) {
        hasArgs = true;
        for (let arg in (it.typeArguments as Array<Type>)) {
          itArgsVal.push(arg);
        }
      } else if (params != null && args != null && itParams != null) {
        hasArgs = true;
        for (let param in (itParams as Array<TypeParameterType>)) {
          itArgsVal.push(param as Type);
        }
      }
      if (hasArgs && itArgsVal.length > 0) {
        let newArgs = new Array<Type>(itArgsVal.length);
        var argsChanged = false;
        for (let arg in itArgsVal) {
          let sub = substituteTypeParamsInCodegen(params, args, arg);
          newArgs.push(sub);
          if (sub != arg) {
            argsChanged = true;
          }
        }
        if (!argsChanged && it.typeArguments != null) {
          return it;
        }
        let inst = new InterfaceType(it.id, it.symbolId, it.name);
        inst.typeParameters = itParams;
        inst.typeArguments = newArgs;
        inst.genericSource = it.genericSource ?? it;
        let combinedParams = new Array<TypeParameterType>();
        let combinedArgs = new Array<Type>();
        if (itParams != null) {
          for (let p in (itParams as Array<TypeParameterType>)) {
            combinedParams.push(p);
          }
          for (let a in newArgs) {
            combinedArgs.push(a);
          }
        }
        for (let p in params) {
          combinedParams.push(p);
        }
        for (let a in args) {
          combinedArgs.push(a);
        }
        let newExtends = new Array<InterfaceType>(it.extendsList.length);
        for (let ext in it.extendsList) {
          newExtends.push(substituteTypeParamsInCodegen(combinedParams, combinedArgs, ext) as InterfaceType);
        }
        inst.extendsList = newExtends;
        inst.members = it.members;
        inst.sourcePath = it.sourcePath;
        inst
      } else {
        it
      }
    }
    case MixinType as mt: {
      var hasArgs = false;
      let mtArgsVal = new Array<Type>();
      let mtParams = mt.typeParameters;
      if (mt.typeArguments != null) {
        hasArgs = true;
        for (let arg in (mt.typeArguments as Array<Type>)) {
          mtArgsVal.push(arg);
        }
      } else if (params != null && args != null && mtParams != null) {
        hasArgs = true;
        for (let param in (mtParams as Array<TypeParameterType>)) {
          mtArgsVal.push(param as Type);
        }
      }
      if (hasArgs && mtArgsVal.length > 0) {
        let newArgs = new Array<Type>(mtArgsVal.length);
        for (let arg in mtArgsVal) {
          newArgs.push(substituteTypeParamsInCodegen(params, args, arg));
        }
        let inst = new MixinType(mt.name);
        inst.typeParameters = mtParams;
        inst.typeArguments = newArgs;
        inst.genericSource = mt.genericSource ?? mt;
        let combinedParams = new Array<TypeParameterType>();
        let combinedArgs = new Array<Type>();
        if (mtParams != null) {
          for (let p in (mtParams as Array<TypeParameterType>)) {
            combinedParams.push(p);
          }
          for (let a in newArgs) {
            combinedArgs.push(a);
          }
        }
        for (let p in params) {
          combinedParams.push(p);
        }
        for (let a in args) {
          combinedArgs.push(a);
        }
        if (mt.onType != null) {
          inst.onType = substituteTypeParamsInCodegen(combinedParams, combinedArgs, mt.onType as Type);
        }
        for (let m in mt.mixins) {
          let subM = substituteTypeParamsInCodegen(combinedParams, combinedArgs, m);
          inst.mixins.push(subM as MixinType);
        }
        inst.members = mt.members;
        inst.sourcePath = mt.sourcePath;
        inst
      } else {
        mt
      }
    }
    case _: t
  };
};

let addTransitiveInterfaces = (
  it: InterfaceType,
  allParams: Array<TypeParameterType>,
  allArgs: Array<Type>,
  seen: HashMap<String, boolean>
): void => {
  let key = getInterfaceKey(it) as String;
  if (seen.has(key)) {
    return;
  }
  seen[key] = true;
  
  let genericSource = it.genericSource ?? it;
  let itParams = getInterfaceTypeParameters(it);
  if (genericSource.typeParameters != null && it.typeArguments != null && itParams != null) {
    let tps = genericSource.typeParameters as Array<TypeParameterType>;
    let tas = it.typeArguments as Array<Type>;
    for (var i = 0; i < tps.length; i += 1) {
      allParams.push(tps[i]);
      if (i < tas.length) {
        allArgs.push(tas[i]);
      } else {
        allArgs.push(new AnyType());
      }
    }
  }
  
  for (let ext in it.extendsList) {
    let itParamsVal = getInterfaceTypeParameters(it);
    let resolvedExt = substituteTypeParamsInCodegen(itParamsVal, it.typeArguments, ext) as InterfaceType;
    addTransitiveInterfaces(resolvedExt, allParams, allArgs, seen);
  }
};

let addClassTransitiveInterfaces = (
  ct: ClassType,
  allParams: Array<TypeParameterType>,
  allArgs: Array<Type>,
  seen: HashMap<String, boolean>
): void => {
  let ctParams = getClassTypeParameters(ct);
  for (let impl in ct.implementsList) {
    if (impl is InterfaceType) {
      let resolved = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, impl) as InterfaceType;
      addTransitiveInterfaces(resolved, allParams, allArgs, seen);
    }
  }
  if (ct.superType != null) {
    let superCt = ct.superType as ClassType;
    let superResolved = substituteTypeParamsInCodegen(ctParams, ct.typeArguments, superCt) as ClassType;
    
    // Add superclass's own type parameters
    let genericSource = superResolved.genericSource ?? superResolved;
    let superCtParams = getClassTypeParameters(superResolved);
    if (genericSource.typeParameters != null && superResolved.typeArguments != null && superCtParams != null) {
      let tps = genericSource.typeParameters as Array<TypeParameterType>;
      let tas = superResolved.typeArguments as Array<Type>;
      for (var i = 0; i < tps.length; i += 1) {
        allParams.push(tps[i]);
        if (i < tas.length) {
          allArgs.push(tas[i]);
        } else {
          allArgs.push(new AnyType());
        }
      }
    }
    
    // Recursively add superclass's interfaces and superclasses
    addClassTransitiveInterfaces(superResolved, allParams, allArgs, seen);
  }
};

let addTransitiveMixins = (
  mt: MixinType,
  allParams: Array<TypeParameterType>,
  allArgs: Array<Type>,
  seen: HashMap<String, boolean>
): void => {
  let key = mt.sourcePath + "::" + mt.name;
  if (seen.has(key)) {
    return;
  }
  seen[key] = true;
  
  let mtParams = mt.typeParameters;
  if (mtParams != null && mt.typeArguments != null) {
    let tps = mtParams as Array<TypeParameterType>;
    let tas = mt.typeArguments as Array<Type>;
    for (var i = 0; i < tps.length; i += 1) {
      allParams.push(tps[i]);
      if (i < tas.length) {
        allArgs.push(tas[i]);
      } else {
        allArgs.push(new AnyType());
      }
    }
  }
  
  for (let composed in mt.mixins) {
    addTransitiveMixins(composed, allParams, allArgs, seen);
  }
};

let addClassTransitiveMixins = (
  ct: ClassType,
  allParams: Array<TypeParameterType>,
  allArgs: Array<Type>,
  seen: HashMap<String, boolean>
): void => {
  for (let m in ct.mixins) {
    addTransitiveMixins(m, allParams, allArgs, seen);
  }
  if (ct.superType != null) {
    addClassTransitiveMixins(ct.superType as ClassType, allParams, allArgs, seen);
  }
};

export let substituteTypeParamsInClassContext = (classType: ClassType | null, t: Type): Type => {
  if (classType == null) {
    return t;
  }
  
  let ct = classType as ClassType;
  if (ct.cachedParams == null || ct.cachedArgs == null) {
    let params = new Array<TypeParameterType>();
    let args = new Array<Type>();
    
    // 1. Add class's own type arguments
    let ctParams = getClassTypeParameters(ct);
    if (ctParams != null && ct.typeArguments != null) {
      let tps = ctParams as Array<TypeParameterType>;
      let tas = ct.typeArguments as Array<Type>;
      for (var i = 0; i < tps.length; i += 1) {
        params.push(tps[i]);
        if (i < tas.length) {
          args.push(tas[i]);
        } else {
          args.push(new AnyType());
        }
      }
    }
    
    // 2. Add implements list and superType recursively
    let seen = new HashMap<String, boolean>();
    addClassTransitiveInterfaces(ct, params, args, seen);
    
    // 3. Add mixins transitively
    let seenMixins = new HashMap<String, boolean>();
    addClassTransitiveMixins(ct, params, args, seenMixins);
    
    ct.cachedParams = params;
    ct.cachedArgs = args;
  }
  
  var cache = ct.codegenSubstCache;
  if (cache == null) {
    let fresh = new HashMap<Type, Type>();
    ct.codegenSubstCache = fresh;
    cache = fresh;
  }
  let cacheVal = cache as HashMap<Type, Type>;
  if (let (true, hit) = cacheVal.get(t)) {
    return hit;
  }

  let substituted = substituteTypeParamsInCodegen(ct.cachedParams as Array<TypeParameterType>, ct.cachedArgs as Array<Type>, t);
  let result = mapMixinThisInType(ct, substituted);
  cacheVal[t] = result;
  return result;
};

export let substituteTypeParamsInFunctionContext = (wasmFunction: WasmFunction | null, t: Type): Type => {
  if (wasmFunction == null) {
    return t;
  }
  
  var cache = wasmFunction.codegenSubstCache;
  if (cache == null) {
    let fresh = new HashMap<Type, Type>();
    wasmFunction.codegenSubstCache = fresh;
    cache = fresh;
  }
  let cacheVal = cache as HashMap<Type, Type>;
  if (let (true, hit) = cacheVal.get(t)) {
    return hit;
  }

  var substituted = t;
  if (wasmFunction.classType != null) {
    substituted = substituteTypeParamsInClassContext(wasmFunction.classType, substituted);
  }

  if (wasmFunction.typeParameters != null && wasmFunction.typeArguments != null) {
    let tps = wasmFunction.typeParameters as Array<TypeParameterType>;
    let tas = wasmFunction.typeArguments as Array<Type>;
    substituted = substituteTypeParamsInCodegen(tps, tas, substituted);
  }

  cacheVal[t] = substituted;
  return substituted;
};

export let getNodeType = (ctx: FunctionContext, node: Node): Type | null => {
  let t = ctx.wasmFunction.model.getNodeType(node);
  if (t == null) { return null; }
  let ct = ctx.wasmFunction.classType;
  if (t is ThisType && ct != null) {
    return ct;
  }
  return substituteTypeParamsInFunctionContext(ctx.wasmFunction, t);
};

export let getExpressionType = (ctx: FunctionContext, node: Node): Type | null => {
  let t = getNodeType(ctx, node);
  if (t != null) {
    if (node is ThisExpression) {
      let types = new Array<Type>();
      types.push(t);
      types.push(new NullType());
      return new UnionType(types);
    }
    return t;
  }
  if (node is Identifier) {
    let sym = ctx.wasmFunction.model.resolve(node as Identifier);
    if (sym != null) {
      let bType = ctx.wasmFunction.model.getBindingType(sym);
      if (bType != null) {
        return substituteTypeParamsInFunctionContext(ctx.wasmFunction, bType);
      }
    }
  }
  return null;
};

export let getInterfaceMemberSignature = (wasm: WasmModule, it: InterfaceType, fieldName: String): WasmSignature => {
  let itParams = getInterfaceTypeParameters(it);
  if (fieldName.startsWith("get#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var memberType: Type | null = null;
    if (it.members.has(propName)) {
      let fi = it.members[propName] as FieldInfo;
      memberType = substituteTypeParamsInCodegen(itParams, it.typeArguments, fi.type);
    } else if (it.members.has(fieldName)) {
      let mi = it.members[fieldName] as MethodInfo;
      let ft = mi.type as FunctionType;
      let resolvedFt = substituteTypeParamsInCodegen(itParams, it.typeArguments, ft) as FunctionType;
      memberType = resolvedFt.returnType;
    }
    if (memberType == null) {
      throw new Error("Interface getter member " + fieldName + " not found on interface " + it.name);
    }
    let params = new Array<ValType>();
    params.push(new ValTypeAnyRef());
    let returns = new Array<ValType>();
    returns.push(typeToValType(wasm, memberType as Type));
    return wasm.getSignature(params, returns);
  } else if (fieldName.startsWith("set#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var memberType: Type | null = null;
    if (it.members.has(propName)) {
      let fi = it.members[propName] as FieldInfo;
      memberType = substituteTypeParamsInCodegen(itParams, it.typeArguments, fi.type);
    } else if (it.members.has(fieldName)) {
      let mi = it.members[fieldName] as MethodInfo;
      let ft = mi.type as FunctionType;
      let resolvedFt = substituteTypeParamsInCodegen(itParams, it.typeArguments, ft) as FunctionType;
      if (resolvedFt.parameters.length > 0) {
        memberType = resolvedFt.parameters[0];
      }
    }
    if (memberType == null) {
      throw new Error("Interface setter member " + fieldName + " not found on interface " + it.name);
    }
    let params = new Array<ValType>();
    params.push(new ValTypeAnyRef());
    params.push(typeToValType(wasm, memberType as Type));
    let returns = new Array<ValType>();
    return wasm.getSignature(params, returns);
  } else {
    let mi = it.members[fieldName] as MethodInfo;
    let ft = mi.type as FunctionType;
    let resolvedFt = substituteTypeParamsInCodegen(itParams, it.typeArguments, ft) as FunctionType;
    let params = new Array<ValType>();
    params.push(new ValTypeAnyRef());
    for (let p in resolvedFt.parameters) {
      params.push(typeToValType(wasm, p));
    }
    let returns = new Array<ValType>();
    mapReturnTypeToWasmResults(wasm, resolvedFt.returnType, returns);
    return wasm.getSignature(params, returns);
  }
};

export let eraseTypeParameters = (t: Type): Type => {
  return match (t) {
    case TypeParameterType: new AnyRefType()
    case ArrayType {elementType}: {
      let sub = eraseTypeParameters(elementType);
      if (sub == elementType) { return t; }
      new ArrayType(sub)
    }
    case ClassType as ct: {
      if (ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0) {
        let args = ct.typeArguments as Array<Type>;
        let newArgs = new Array<Type>();
        var changed = false;
        for (let arg in args) {
          let sub = eraseTypeParameters(arg);
          if (sub != arg) { changed = true; }
          newArgs.push(sub);
        }
        if (!changed) { return t; }

        let inst = new ClassType(ct.id, ct.symbolId, ct.name);
        inst.typeArguments = newArgs;
        if (ct.superType != null) {
          inst.superType = eraseTypeParameters(ct.superType as Type) as ClassType;
        }
        inst.members = ct.members;
        inst.typeParameters = ct.typeParameters;
        inst.isExtension = ct.isExtension;
        if (ct.isExtension && ct.onType != null) {
          inst.onType = eraseTypeParameters(ct.onType as Type);
        }
        inst.genericSource = ct.genericSource ?? ct;
        inst.sourcePath = ct.sourcePath;
        for (let impl in ct.implementsList) {
          inst.implementsList.push(eraseTypeParameters(impl) as InterfaceType);
        }
        for (let m in ct.mixins) {
          inst.mixins.push(eraseTypeParameters(m) as MixinType);
        }
        inst.fieldSetterNames = ct.fieldSetterNames;
        inst.isFinal = ct.isFinal;
        inst.isCaseClass = ct.isCaseClass;
        inst.isAbstract = ct.isAbstract;
        inst.isSealed = ct.isSealed;
        inst.sealedVariants = ct.sealedVariants;
        inst.declaredFields = ct.declaredFields;
        inst.forwardVariantNames = ct.forwardVariantNames;
        inst.constructorType = if (ct.constructorType != null) {
          let ctor = ct.constructorType as FunctionType;
          let newParams = new Array<Type>(ctor.parameters.length);
          for (let p in ctor.parameters) {
            newParams.push(eraseTypeParameters(p));
          }
          let newFt = new FunctionType(newParams, ctor.parameterNames, eraseTypeParameters(ctor.returnType));
          newFt.parameterInitializers = ctor.parameterInitializers;
          newFt.parameterSymbols = ctor.parameterSymbols;
          newFt.optionalParameters = ctor.optionalParameters;
          newFt.functionSymbolId = ctor.functionSymbolId;
          newFt.functionSymbolName = ctor.functionSymbolName;
          newFt
        } else {
          null
        };
        inst as Type
      } else {
        t as Type
      }
    }
    case InterfaceType as it: {
      if (it.typeArguments != null && (it.typeArguments as Array<Type>).length > 0) {
        let args = it.typeArguments as Array<Type>;
        let newArgs = new Array<Type>();
        var changed = false;
        for (let arg in args) {
          let sub = eraseTypeParameters(arg);
          if (sub != arg) { changed = true; }
          newArgs.push(sub);
        }
        if (!changed) { return t; }
        let inst = new InterfaceType(it.id, it.symbolId, it.name);
        inst.typeArguments = newArgs;
        inst.members = it.members;
        inst.typeParameters = it.typeParameters;
        inst.genericSource = it.genericSource ?? it;
        inst.sourcePath = it.sourcePath;
        for (let ext in it.extendsList) {
          inst.extendsList.push(eraseTypeParameters(ext) as InterfaceType);
        }
        inst as Type
      } else {
        t as Type
      }
    }
    case FunctionType as ft: {
      let newParams = new Array<Type>();
      var changed = false;
      for (let p in ft.parameters) {
        let sub = eraseTypeParameters(p);
        if (sub != p) { changed = true; }
        newParams.push(sub);
      }
      let newRet = eraseTypeParameters(ft.returnType);
      if (newRet != ft.returnType) { changed = true; }
      if (!changed) { return t; }
      let inst = new FunctionType(newParams, ft.parameterNames, newRet);
      inst.typeParameters = ft.typeParameters;
      inst.typeArguments = ft.typeArguments;
      inst.genericSource = ft.genericSource;
      inst.parameterInitializers = ft.parameterInitializers;
      inst.parameterSymbols = ft.parameterSymbols;
      inst.optionalParameters = ft.optionalParameters;
      inst.isFinal = ft.isFinal;
      inst.isAbstract = ft.isAbstract;
      inst.overloads = ft.overloads;
      inst.functionSymbolId = ft.functionSymbolId;
      inst.functionSymbolName = ft.functionSymbolName;
      inst
    }
    case MixinType as mt: {
      if (mt.typeArguments != null && (mt.typeArguments as Array<Type>).length > 0) {
        let args = mt.typeArguments as Array<Type>;
        let newArgs = new Array<Type>();
        var changed = false;
        for (let arg in args) {
          let sub = eraseTypeParameters(arg);
          if (sub != arg) { changed = true; }
          newArgs.push(sub);
        }
        if (!changed) { return t; }
        let inst = new MixinType(mt.name);
        inst.typeParameters = mt.typeParameters;
        inst.typeArguments = newArgs;
        inst.genericSource = mt.genericSource ?? mt;
        inst.onType = mt.onType;
        inst.members = mt.members;
        inst.sourcePath = mt.sourcePath;
        for (let composed in mt.mixins) {
          inst.mixins.push(eraseTypeParameters(composed) as MixinType);
        }
        inst as Type
      } else {
        t as Type
      }
    }
    case UnionType {types}: {
      let newTypes = new Array<Type>();
      var changed = false;
      for (let subT in types) {
        let sub = eraseTypeParameters(subT);
        if (sub != subT) { changed = true; }
        newTypes.push(sub);
      }
      if (!changed) { return t; }
      new UnionType(newTypes)
    }
    case TupleType {elementTypes}: {
      let newElems = new Array<Type>();
      var changed = false;
      for (let subT in elementTypes) {
        let sub = eraseTypeParameters(subT);
        if (sub != subT) { changed = true; }
        newElems.push(sub);
      }
      if (!changed) { return t; }
      new TupleType(newElems)
    }
    case InlineTupleType {elementTypes}: {
      let newElems = new Array<Type>();
      var changed = false;
      for (let subT in elementTypes) {
        let sub = eraseTypeParameters(subT);
        if (sub != subT) { changed = true; }
        newElems.push(sub);
      }
      if (!changed) { return t; }
      new InlineTupleType(newElems)
    }
    case RecordType as rec: {
      let newProps = new HashMap<String, Type>();
      var changed = false;
      let keys = rec.properties.keys();
      while (let (true, key) = keys.next()) {
        let propType = rec.properties[key];
        let sub = eraseTypeParameters(propType);
        if (sub != propType) { changed = true; }
        newProps[key] = sub;
      }
      if (!changed) { return t; }
      let newRec = new RecordType(newProps, rec.optionalProperties);
      newRec.enumDeclaration = rec.enumDeclaration;
      newRec
    }
    case _: t
  };
};

export let getClassMemberSignature = (wasm: WasmModule, ct: ClassType, fieldName: String): WasmSignature => {
  let erasedCt = eraseTypeParameters(ct) as ClassType;
  let rootClass = getMemberRootClass(erasedCt, fieldName);
  let params = new Array<ValType>();
  let rootKey = getClassKey(rootClass);
  let classStruct = if (let (true, rootInfo) = wasm.classInfos.get(rootKey)) rootInfo.structType else null;
  if (classStruct != null) {
    params.push(new ValTypeRefNull(classStruct as WasmStruct));
  } else {
    params.push(new ValTypeAnyRef());
  }

  let returns = new Array<ValType>();

  if (fieldName.startsWith("get#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var fieldType: Type = new VoidType();
    if (erasedCt.members.has(propName)) {
      fieldType = substituteTypeParamsInClassContext(erasedCt, erasedCt.members[propName].type);
    } else if (erasedCt.members.has(fieldName)) {
      let mi = erasedCt.members[fieldName] as MethodInfo;
      let ft = mi.type as FunctionType;
      let resolvedFt = substituteTypeParamsInClassContext(erasedCt, ft) as FunctionType;
      fieldType = resolvedFt.returnType;
    }
    returns.push(typeToValType(wasm, fieldType));
    return wasm.getSignature(params, returns);
  } else if (fieldName.startsWith("set#")) {
    let propName = fieldName.sliceBytes(4, fieldName.length);
    var fieldType: Type = new VoidType();
    if (erasedCt.members.has(propName)) {
      fieldType = substituteTypeParamsInClassContext(erasedCt, erasedCt.members[propName].type);
    } else if (erasedCt.members.has(fieldName)) {
      let mi = erasedCt.members[fieldName] as MethodInfo;
      let ft = mi.type as FunctionType;
      let resolvedFt = substituteTypeParamsInClassContext(erasedCt, ft) as FunctionType;
      fieldType = resolvedFt.parameters[0];
    }
    params.push(typeToValType(wasm, fieldType));
    return wasm.getSignature(params, returns);
  } else {
    var ft: FunctionType | null = null;
    if (erasedCt.members.has(fieldName)) {
      let mi = erasedCt.members[fieldName] as MethodInfo;
      let rawFt = mi.type as FunctionType;
      ft = substituteTypeParamsInClassContext(erasedCt, rawFt) as FunctionType;
    }
    if (ft != null) {
      let fType = ft as FunctionType;
      for (let p in fType.parameters) {
        params.push(typeToValType(wasm, p));
      }
      mapReturnTypeToWasmResults(wasm, fType.returnType, returns);
    }
    return wasm.getSignature(params, returns);
  }
};

let getWasmTypeKey = (target: WasmType): String => {
  if (target is WasmStruct) {
    let s = target as WasmStruct;
    if (s.name != null) {
      return s.name as String;
    }
    var structKey = "struct_anon_";
    for (let f in s.fields) {
      structKey = structKey + (if (f.name == null) "null" else f.name as String) + "_" + (if (f.isMutable) "mut_" else "imm_") + getValTypeKey(f.type) + "_";
    }
    return structKey;
  }
  if (target is WasmArray) {
    let a = target as WasmArray;
    return "array_" + (if (a.isMutable) "mut_" else "imm_") + getValTypeKey(a.elementType);
  }
  if (target is WasmSignature) {
    let sig = target as WasmSignature;
    var s = "sig_";
    for (let p in sig.params) {
      s = s + getValTypeKey(p) + "_";
    }
    s = s + "returns_";
    for (let ret in sig.returns) {
      s = s + getValTypeKey(ret) + "_";
    }
    return s;
  }
  return "anon";
};

export let getValTypeKey = (type: ValType): String => match (type) {
  case ValTypeRef {target}: "ref_" + getWasmTypeKey(target)
  case ValTypeRefNull {target}: "refnull_" + getWasmTypeKey(target)
  case _: i32ToString(valTypeToOpcode(type))
};

export let getClosureKey = (params: Array<ValType>, returns: Array<ValType>): ClosureKey => {
  var keyStr = "";
  for (let p in params) {
    keyStr = keyStr + getValTypeKey(p) + ",";
  }
  keyStr = keyStr + "=>";
  for (let r in returns) {
    keyStr = keyStr + getValTypeKey(r) + ",";
  }
  return keyStr as ClosureKey;
};

export let getCellKey = (valType: ValType): CellKey => {
  return getValTypeKey(valType) as CellKey;
};

export let getClosureStruct = (wasm: WasmModule, ftVal: any): WasmStruct => {
  let ft = ftVal as FunctionType;
  let params = new Array<ValType>();
  params.push(new ValTypeStructRef()); // ctx
  for (let p in ft.parameters) {
    params.push(typeToValType(wasm, p));
  }
  let returns = new Array<ValType>();
  mapReturnTypeToWasmResults(wasm, ft.returnType, returns);

  let implSig = wasm.getSignature(params, returns);

  let key = getClosureKey(params, returns);

  if (wasm.closureStructs.has(key)) {
    return wasm.closureStructs[key];
  }



  let fields = new Array<WasmField>();
  fields.push(new WasmField("func", new ValTypeRef(implSig), false));
  fields.push(new WasmField("ctx", new ValTypeStructRef(), false));
  let st = wasm.getStruct(null, fields);
  wasm.closureStructs[key] = st;
  return st;
};

export let getCellStruct = (wasm: WasmModule, valType: ValType): WasmStruct => {
  let key = getCellKey(valType);
  if (wasm.cellStructs.has(key)) {
    return wasm.cellStructs[key];
  }
  let fields = new Array<WasmField>();
  fields.push(new WasmField("value", valType, true)); // mutable
  let name = "Cell_" + (key as String);
  let st = new WasmStruct(name, fields);
  wasm.types.push(st);
  wasm.cellStructs[key] = st;
  return st;
};

export let typeToValType = (wasm: WasmModule, t: Type): ValType => {
  let erasedT = eraseTypeParameters(t);
  return match (erasedT) {
    case TypeAliasType as a: typeToValType(wasm, a.target)
  case BoolLiteralType: new ValTypeI32()
  case NumLiteralType as num: typeToValType(wasm, baseType(num))
  case StringLiteralType: {
    var stringStruct: WasmStruct | null = null;
    let stringClass = wasm.stringClass;
    if (stringClass != null) {
      let key = getClassKey(stringClass as ClassType);
      if (let (true, stringInfo) = wasm.classInfos.get(key)) {
        stringStruct = stringInfo.structType;
      }
    }
    if (stringStruct != null) {
      new ValTypeRef(stringStruct as WasmStruct)
    } else {
      new ValTypeStructRef()
    }
  }
  case F64Type: new ValTypeF64()
  case F32Type: new ValTypeF32()
  case I32Type: new ValTypeI32()
  case U32Type: new ValTypeI32()
  case I64Type: new ValTypeI64()
  case U64Type: new ValTypeI64()
  case BooleanType: new ValTypeI32()
  case RecordType as rec: {
    let fields = new Array<WasmField>();
    for (let pair in rec.properties) {
       fields.push(new WasmField(pair.key, typeToValType(wasm, pair.value), false));
    }
    sortWasmFields(fields);
    let info_opt = wasm.findRecordDispatch(fields);
    match (info_opt) {
      case RecordDispatchInfo as info: new ValTypeRef(info.fatPtrType)
      case null: {
        var errStr = "";
        for (let f in fields) {
           if (f.name != null) errStr = errStr + (f.name as String) + ", ";
        }
        throw new Error("Record fat ptr type not generated during discovery pass! Fields: " + errStr);
      }
    }
  }
  case TupleType as tup: {
    let fields = new Array<WasmField>();
    for (var i = 0; i < tup.elementTypes.length; i += 1) {
      let t_i = tup.elementTypes[i];
      fields.push(new WasmField(i32ToString(i), typeToValType(wasm, t_i), false));
    }
    let structDef = wasm.getStruct(null, fields);
    new ValTypeRef(structDef);
  }
  case ClassType as ct: {
    if (ct.name == "array" && ct.typeArguments != null && (ct.typeArguments as Array<Type>).length > 0) {
      let elemValType = typeToValType(wasm, (ct.typeArguments as Array<Type>)[0]);
      return new ValTypeRef(wasm.getArray(elemValType, true));
    }
    if (ct.name == "ByteArray") {
      return new ValTypeRef(wasm.getByteArrayType());
    }
    if (ct.isExtension && ct.onType != null) {
      let subOn = substituteTypeParamsInClassContext(ct, ct.onType as Type);
      return typeToValType(wasm, subOn);
    }
    if (let (true, ctInfo) = wasm.classInfos.get(getClassKey(ct))) {
      new ValTypeRef(ctInfo.structType)
    } else {
      new ValTypeStructRef()
    }
  }
  case InterfaceType as it: {
    let key = getInterfaceKey(it);
    if (wasm.interfaceStructs.has(key)) {
      new ValTypeRef(wasm.interfaceStructs[key])
    } else {
      new ValTypeStructRef()
    }
  }
  case ArrayType as at: {
    let elemValType = typeToValType(wasm, at.elementType);
    new ValTypeRef(wasm.getArray(elemValType, true))
  }
  case ByteArrayType: {
    new ValTypeRef(wasm.getByteArrayType())
  }
  case VoidType: new ValTypeVoid()
  case NullType: new ValTypeStructRef()
  case UnknownType: new ValTypeAnyRef()
  case ErrorType: new ValTypeAnyRef()
  case AnyType: new ValTypeAnyRef()
  case TypeParameterType: new ValTypeAnyRef()
  case AnyRefType: new ValTypeAnyRef()
  case EqRefType: new ValTypeEqRef()
  case TypeParameterType: new ValTypeAnyRef()
  case ThisType: new ValTypeAnyRef()
  case NeverType: new ValTypeVoid()
  case HoleType: new ValTypeI32()
  case FunctionType: {
    new ValTypeRef(getClosureStruct(wasm, t))
  }
  case UnionType as ut: {
    var hasVoid = false;
    for (let t_i in ut.types) {
      if (t_i is VoidType) {
        hasVoid = true;
      }
    }
    if (hasVoid) {
      new ValTypeVoid()
    } else {
      let nonNeverTypes = new Array<Type>();
      for (let t_i in ut.types) {
        if (!(t_i is NeverType || t_i is HoleType || t_i is ErrorType || t_i is UnknownType)) {
          nonNeverTypes.push(t_i);
        }
      }
      if (nonNeverTypes.length == 0) {
        new ValTypeVoid()
      } else if (nonNeverTypes.length < ut.types.length) {
        if (nonNeverTypes.length == 1) {
          let v = typeToValType(wasm, nonNeverTypes[0]);
          match (v) {
            case ValTypeRef as vr: new ValTypeRefNull(vr.target)
            case _: v
          }
        } else {
          typeToValType(wasm, new UnionType(nonNeverTypes))
        }
      } else {
        let nonNullTypes = new Array<Type>();
        for (let t_i in ut.types) {
          if (!(t_i is NullType)) {
            nonNullTypes.push(t_i);
          }
        }
        let mappedValTypes = new Array<ValType>();
        for (let t_i in nonNullTypes) {
          mappedValTypes.push(typeToValType(wasm, t_i));
        }
        var allSame = true;
        let firstKey = if (mappedValTypes.length > 0) getValTypeKey(mappedValTypes[0]) else "";
        for (let mv in mappedValTypes) {
          if (getValTypeKey(mv) != firstKey) {
            allSame = false;
            break;
          }
        }
        if (allSame && mappedValTypes.length > 0) {
          let commonValType = mappedValTypes[0];
          var hasNull = false;
          for (let t_i in ut.types) {
            if (t_i is NullType) {
              hasNull = true;
              break;
            }
          }
          if (hasNull) {
            match (commonValType) {
              case ValTypeRef as vr: new ValTypeRefNull(vr.target)
              case _: commonValType
            }
          } else {
            commonValType
          }
        } else {
          new ValTypeEqRef()
        }
      }
    }
  }
  case _: {
    throw new Error("typeToValType: unsupported type: " + typeToString(t));
  }
  };
};

let mapUnionOfInlineTuplesToWasmResults = (wasm: WasmModule, unionType: UnionType, returns: Array<ValType>): boolean => {
  let memberTuples = new Array<InlineTupleType>();
  for (let t in unionType.types) {
    if (t is InlineTupleType) {
      memberTuples.push(t as InlineTupleType);
    }
  }
  if (memberTuples.length == 0) return false;

  let arity = memberTuples[0].elementTypes.length;
  var i = 0;
  while (i < arity) {
    let elementTypes = new Array<Type>();
    for (let t in memberTuples) {
      elementTypes.push(t.elementTypes[i]);
    }
    var hasHole = false;
    for (let t in elementTypes) {
      if (t is HoleType || t is NullType) {
        hasHole = true;
      }
    }
    var nonHoleType: Type | null = null;
    for (let t in elementTypes) {
      if (!(t is HoleType || t is NullType)) {
        nonHoleType = t;
        break;
      }
    }
    let finalType = if (nonHoleType != null) nonHoleType as Type else elementTypes[0];
    
    let vType = typeToValType(wasm, finalType);
    let finalVType = if (hasHole) {
      match (vType) {
        case ValTypeRef as r: new ValTypeRefNull(r.target)
        case _: vType
      }
    } else {
      vType
    };
    returns.push(finalVType);
    
    i += 1;
  }
  return true;
};

export let mapReturnTypeToWasmResults = (wasm: WasmModule, type: Type, returns: Array<ValType>): void => {
  if (type is VoidType || type is NeverType || type is HoleType) {
    return;
  }
  if (type is InlineTupleType) {
    let tupleType = type as InlineTupleType;
    for (let el in tupleType.elementTypes) {
      returns.push(typeToValType(wasm, el));
    }
    return;
  }
  if (type is UnionType) {
    let unionType = type as UnionType;
    var hasVoid = false;
    for (let t in unionType.types) {
      if (t is VoidType) {
        hasVoid = true;
      }
    }
    if (hasVoid) {
      return;
    }
    if (mapUnionOfInlineTuplesToWasmResults(wasm, unionType, returns)) {
      return;
    }
  }
  returns.push(typeToValType(wasm, type));
};

export let getNonNullableType = (type: Type): Type => match (type) {
  case UnionType {types}: {
    let nonNullTypes = new Array<Type>();
    for (let t_i in types) {
      if (!(t_i is NullType)) {
        nonNullTypes.push(t_i);
      }
    }
    if (nonNullTypes.length == 1) {
      nonNullTypes[0]
    } else {
      type
    }
  }
  case _: type
};

export let typeToValTypeWithSub = (wasm: WasmModule, t: Type, wasmFunction: WasmFunction | null): ValType => {
  if (wasmFunction != null) {
    return typeToValType(wasm, substituteTypeParamsInFunctionContext(wasmFunction, t));
  }
  return typeToValType(wasm, t);
};

export let mapReturnTypeToWasmResultsWithSub = (wasm: WasmModule, type: Type, returns: Array<ValType>, wasmFunction: WasmFunction | null): void => {
  if (wasmFunction != null) {
    mapReturnTypeToWasmResults(wasm, substituteTypeParamsInFunctionContext(wasmFunction, type), returns);
  } else {
    mapReturnTypeToWasmResults(wasm, type, returns);
  }
};

export let containsMixinThis = (type: Type): boolean => match (type) {
  case ThisType: true
  case ClassType as resolvedCt: {
    if (resolvedCt.name.length >= 5 && resolvedCt.name.sliceBytes(resolvedCt.name.length - 5, resolvedCt.name.length) == "_This") {
      true
    } else if (resolvedCt.typeArguments != null) {
      var found = false;
      for (let arg in (resolvedCt.typeArguments as Array<Type>)) {
        if (containsMixinThis(arg)) {
          found = true;
          break;
        }
      }
      found
    } else {
      false
    }
  }
  case UnionType {types}: {
    var found = false;
    for (let ut in types) {
      if (containsMixinThis(ut)) {
        found = true;
        break;
      }
    }
    found
  }
  case ArrayType {elementType}: {
    containsMixinThis(elementType)
  }
  case TupleType {elementTypes}: {
    var found = false;
    for (let el in elementTypes) {
      if (containsMixinThis(el)) {
        found = true;
        break;
      }
    }
    found
  }
  case InlineTupleType {elementTypes}: {
    var found = false;
    for (let el in elementTypes) {
      if (containsMixinThis(el)) {
        found = true;
        break;
      }
    }
    found
  }
  case FunctionType as ft: {
    var found = false;
    for (let p in ft.parameters) {
      if (containsMixinThis(p)) {
        found = true;
        break;
      }
    }
    if (!found) {
      found = containsMixinThis(ft.returnType);
    }
    found
  }
  case _: false
};

export let mapMixinThisInType = (ct: ClassType, type: Type): Type => {
  if (!containsMixinThis(type)) {
    return type;
  }
  return match (type) {
    case ThisType: ct as Type
    case ClassType as resolvedCt: {
      if (resolvedCt.name.length >= 5 && resolvedCt.name.sliceBytes(resolvedCt.name.length - 5, resolvedCt.name.length) == "_This") {
        ct as Type
      } else {
        if (resolvedCt.typeArguments != null) {
          let newArgs = new Array<Type>();
          for (let arg in (resolvedCt.typeArguments as Array<Type>)) {
            newArgs.push(mapMixinThisInType(ct, arg));
          }
          let inst = new ClassType(resolvedCt.id, resolvedCt.symbolId, resolvedCt.name);
          inst.typeParameters = resolvedCt.typeParameters;
          inst.typeArguments = newArgs;
          inst.genericSource = resolvedCt.genericSource;
          inst.superType = resolvedCt.superType;
          for (let impl in resolvedCt.implementsList) {
            inst.implementsList.push(impl);
          }
          for (let m in resolvedCt.mixins) {
            inst.mixins.push(mapMixinThisInType(ct, m) as MixinType);
          }
          inst.members = resolvedCt.members;
          inst.constructorType = if (resolvedCt.constructorType != null) {
            let ctor = resolvedCt.constructorType as FunctionType;
            let newParams = new Array<Type>();
            for (let p in ctor.parameters) {
              newParams.push(mapMixinThisInType(ct, p));
            }
            let newFt = new FunctionType(newParams, ctor.parameterNames, ctor.returnType);
            newFt.parameterInitializers = ctor.parameterInitializers;
            newFt.parameterSymbols = ctor.parameterSymbols;
            newFt.optionalParameters = ctor.optionalParameters;
            newFt.functionSymbolId = ctor.functionSymbolId;
            newFt.functionSymbolName = ctor.functionSymbolName;
            newFt
          } else {
            null
          };
          inst.fieldSetterNames = resolvedCt.fieldSetterNames;
          inst.isFinal = resolvedCt.isFinal;
          inst.isCaseClass = resolvedCt.isCaseClass;
          inst.isAbstract = resolvedCt.isAbstract;
           inst.isExtension = resolvedCt.isExtension;
          if (resolvedCt.isExtension && resolvedCt.onType != null) {
            inst.onType = mapMixinThisInType(ct, resolvedCt.onType as Type);
          }
          inst.isSealed = resolvedCt.isSealed;
          inst.sourcePath = resolvedCt.sourcePath;
          inst.sealedVariants = resolvedCt.sealedVariants;
          inst.declaredFields = resolvedCt.declaredFields;
          inst.forwardVariantNames = resolvedCt.forwardVariantNames;
          inst as Type
        } else {
          resolvedCt as Type
        }
      }
    }
    case UnionType {types}: {
      let newTypes = new Array<Type>();
      for (let ut in types) {
        newTypes.push(mapMixinThisInType(ct, ut));
      }
      new UnionType(newTypes) as Type
    }
    case ArrayType {elementType}: {
      new ArrayType(mapMixinThisInType(ct, elementType)) as Type
    }
    case TupleType {elementTypes}: {
      let newElems = new Array<Type>();
      for (let el in elementTypes) {
        newElems.push(mapMixinThisInType(ct, el));
      }
      new TupleType(newElems) as Type
    }
    case InlineTupleType {elementTypes}: {
      let newElems = new Array<Type>();
      for (let el in elementTypes) {
        newElems.push(mapMixinThisInType(ct, el));
      }
      new InlineTupleType(newElems) as Type
    }
    case FunctionType as ft: {
      let newParams = new Array<Type>();
      for (let p in ft.parameters) {
        newParams.push(mapMixinThisInType(ct, p));
      }
      let newRet = mapMixinThisInType(ct, ft.returnType);
      let newFt = new FunctionType(newParams, ft.parameterNames, newRet);
      newFt.typeParameters = ft.typeParameters;
      newFt.typeArguments = ft.typeArguments;
      newFt.genericSource = ft.genericSource;
      newFt.parameterInitializers = ft.parameterInitializers;
      newFt.parameterSymbols = ft.parameterSymbols;
      newFt.optionalParameters = ft.optionalParameters;
      newFt.isFinal = ft.isFinal;
      newFt.isAbstract = ft.isAbstract;
      newFt.overloads = ft.overloads;
      newFt.functionSymbolId = ft.functionSymbolId;
      newFt.functionSymbolName = ft.functionSymbolName;
      newFt as Type
    }
    case _: type
  };
};


