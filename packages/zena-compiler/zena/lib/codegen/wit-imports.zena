/**
 * The component's imported interfaces, encoded by the WIT type encoder.
 *
 * The emitter used to hand-write each imported interface's instance
 * type — possible only while every signature was flat scalars. Now the
 * shape's imports are rendered as a WIT document and pushed through
 * `wit-parser`'s component encoder, the same code path that round-trips
 * real WIT through `wasm-tools component wit`. For scalar interfaces
 * the bytes are identical to the hand-written ones; what changes is
 * what becomes *possible*, because the encoder already speaks records,
 * variants, resources and `use`, and the emitter no longer has an
 * opinion.
 *
 * The derivation is per-interface WIT text, not per-program: each
 * `@external("ns:pkg/iface@ver", "field")` group becomes an interface
 * in a nested package, and a synthetic world imports them all. When an
 * interface's true WIT is richer than a Zena declaration can spell
 * (resources, lists — stdio's case), this is where its real source
 * will be substituted for the derived one.
 */

import { String } from 'zena:string';
import { Array } from 'zena:array';
import { StringBuilder } from 'zena:string-builder';
import { Error } from 'zena:error';
import { i32ToString } from 'zena:string-convert';
import { parse } from 'wit-parser:wit';
import {
  ComponentTypeEncoder, EncodedWorld, funcFlatMeta, WitFuncMeta,
  worldNames, qualifiedInterfaceName
} from 'wit-parser:component-encoder';
import {
  Ast, AstItemTag, WorldDef, WorldItemTag, Import, Export, ExternKind,
  ExternKindTag, UsePath, UsePathTag, Id, Func, Type, TypeTag, PackageName,
  AstItem, InterfaceDef
} from 'wit-parser:parser';
import {
  ComponentShape, ComponentImportFunc, ComponentExportFunc,
  ComponentFuncType, noComponentResult, EncodedImports, EncodedImportPiece,
  ImportTypeEncoder
} from './component-emitter.zena';
import {
  knownWasiPackagesWit, isKnownWasiInterface, isKnownWasiPackage
} from './wasi-interfaces.zena';

/** The WIT spelling of a flat-scalar component value type opcode. */
let scalarWitName = (opcode: i32): String => {
  if (opcode == 0x7f) { return "bool"; }
  if (opcode == 0x7e) { return "s8"; }
  if (opcode == 0x7d) { return "u8"; }
  if (opcode == 0x7c) { return "s16"; }
  if (opcode == 0x7b) { return "u16"; }
  if (opcode == 0x7a) { return "s32"; }
  if (opcode == 0x79) { return "u32"; }
  if (opcode == 0x78) { return "s64"; }
  if (opcode == 0x77) { return "u64"; }
  if (opcode == 0x76) { return "f32"; }
  if (opcode == 0x75) { return "f64"; }
  if (opcode == 0x74) { return "char"; }
  if (opcode == 0x73) { return "string"; }
  // Only the shape builder produces these opcodes, and it only
  // produces the scalars and string; anything else is a bug there.
  throw new Error(
      "no WIT spelling for component type opcode " + i32ToString(opcode));
};

/** One imported interface: its qualified name split into WIT's parts. */
final class InterfacePath {
  /** `ns:pkg`, the package half. */
  packageName: String;
  /** The interface's own name. */
  interfaceName: String;
  /** The `@version`, or empty. */
  version: String;
  new(this.packageName, this.interfaceName, this.version);
}

let splitInterfaceName = (name: String): InterfacePath => {
  var slash = -1;
  for (var i = 0; i < name.length; i += 1) {
    if (name.getByteAt(i) == 47) { // '/'
      slash = i;
    }
  }
  if (slash < 0) {
    throw new Error(
      "The component target cannot import from '" + name +
        "': a WIT interface is named ns:pkg/interface, optionally with " +
        "@version, and this has no '/'.");
  }
  let packageName = name.sliceBytes(0, slash);
  var rest = name.sliceBytes(slash + 1, name.length);
  var version = "";
  var at = -1;
  for (var i = 0; i < rest.length; i += 1) {
    if (rest.getByteAt(i) == 64) { // '@'
      at = i;
    }
  }
  if (at >= 0) {
    version = rest.sliceBytes(at + 1, rest.length);
    rest = rest.sliceBytes(0, at);
  }
  return new InterfacePath(packageName, rest, version);
};

/** One function of an interface, as WIT source. */
let renderFunc = (sb: StringBuilder, f: ComponentImportFunc): void => {
  let sig = f.signature;
  sb.append("    ").append(f.fieldName).append(": ");
  if (sig.isAsync) {
    sb.append("async ");
  }
  sb.append("func(");
  for (var i = 0; i < sig.paramTypes.length; i += 1) {
    if (i > 0) {
      sb.append(", ");
    }
    sb.append(sig.paramNames[i]).append(": ")
        .append(scalarWitName(sig.paramTypes[i]));
  }
  sb.append(")");
  if (sig.result != noComponentResult) {
    sb.append(" -> ").append(scalarWitName(sig.result));
  }
  sb.append(";\n");
};

/** The name of the synthetic world the derived document declares. */
let derivedWorldName = "imports";

/**
 * Whether a parsed document declares the interface `qualified` names —
 * package, interface and version all matching. This is what makes a
 * WIT-backed package's interfaces "provided": their real source
 * substitutes for the derived spelling, exactly as the compiler's own
 * baked WASI blocks do.
 */
let docDeclaresInterface = (ast: Ast, qualified: String): boolean => {
  let path = splitInterfaceName(qualified);
  let matches = (pkg: PackageName | null, items: Array<AstItem>): boolean => {
    if (pkg == null) {
      return false;
    }
    let p = pkg as PackageName;
    if (p.namespace.name + ":" + p.name.name != path.packageName) {
      return false;
    }
    var version = "";
    if (p.version != null) {
      version = p.version as String;
    }
    if (version != path.version) {
      return false;
    }
    for (let item in items) {
      if (item.tag != AstItemTag.Interface) {
        continue;
      }
      if ((item.interfaceDef as InterfaceDef).name.name ==
          path.interfaceName) {
        return true;
      }
    }
    return false;
  };
  if (matches(ast.packageName, ast.items)) {
    return true;
  }
  for (let nested in ast.nestedPackages) {
    if (matches(nested.name, nested.items)) {
      return true;
    }
  }
  return false;
};

/**
 * The shape's imports as a WIT document: one interface per `@external`
 * namespace, grouped into their packages, and a world importing each.
 *
 * `packagesWit` is the concatenated source of the program's WIT-backed
 * packages. An interface it declares is spliced whole rather than
 * derived, like the compiler's own baked WASI blocks — the synthesized
 * declarations for such interfaces are canonically flattened core
 * shapes, and deriving from those would declare the flattening as the
 * interface's type.
 */
export let deriveImportsWit = (
  shape: ComponentShape,
  packagesWit: String = ""
): String => {
  let packagesAst = if (packagesWit == "") null else parse(packagesWit);
  let provided = (name: String): boolean => {
    if (isKnownWasiInterface(name)) {
      return true;
    }
    return packagesAst != null &&
        docDeclaresInterface(packagesAst as Ast, name);
  };
  // Group by interface, preserving first-appearance order (the same
  // grouping the emitter's aliases use), then group interfaces by
  // package for the nested-package declarations.
  let interfaceNames = new GrowableArray<String>();
  for (let imp in shape.imports) {
    var seen = false;
    for (let n in interfaceNames) {
      if (n == imp.interfaceName) { seen = true; }
    }
    if (!seen) { interfaceNames.push(imp.interfaceName); }
  }

  let sb = new StringBuilder();
  sb.append("package zena:derived;\n\n");

  // Interfaces whose real WIT the compiler carries — its own baked
  // blocks, or a WIT-backed package's — are not derived: their package
  // blocks are appended whole, and the world imports them by name like
  // any other.
  var anyKnown = false;
  var anyPackaged = false;
  for (let name in interfaceNames) {
    if (isKnownWasiInterface(name)) {
      anyKnown = true;
    } else if (provided(name)) {
      anyPackaged = true;
    }
  }
  if (anyKnown) {
    sb.append(knownWasiPackagesWit()).append("\n");
  }
  // `packagesWit` is appended at the END of the document (after the
  // world): its files declare their packages unbraced, and an unbraced
  // `package` declaration switches the rest of the document into that
  // package — spliced here, it would swallow the world.

  let renderedPackages = new GrowableArray<String>();
  for (let name in interfaceNames) {
    if (provided(name)) { continue; }
    let path = splitInterfaceName(name);
    let packageKey = path.packageName + "@" + path.version;
    if (anyKnown && isKnownWasiPackage(packageKey)) {
      throw new Error(
        "The component target cannot import '" + name + "': its package " +
          "is one the compiler carries real WIT for, and this interface " +
          "is not in it.");
    }
    var rendered = false;
    for (let p in renderedPackages) {
      if (p == packageKey) { rendered = true; }
    }
    if (rendered) { continue; }
    renderedPackages.push(packageKey);

    sb.append("package ").append(path.packageName);
    if (path.version != "") {
      sb.append("@").append(path.version);
    }
    sb.append(" {\n");
    // Every interface of this package, in first-appearance order.
    for (let other in interfaceNames) {
      if (provided(other)) { continue; }
      let otherPath = splitInterfaceName(other);
      if (otherPath.packageName + "@" + otherPath.version != packageKey) {
        continue;
      }
      sb.append("  interface ").append(otherPath.interfaceName)
          .append(" {\n");
      for (let imp in shape.imports) {
        if (imp.interfaceName == other) {
          renderFunc(sb, imp);
        }
      }
      sb.append("  }\n");
    }
    sb.append("}\n\n");
  }

  sb.append("world ").append(derivedWorldName).append(" {\n");
  for (let name in interfaceNames) {
    sb.append("  import ").append(name).append(";\n");
  }
  sb.append("}\n");
  if (anyPackaged) {
    sb.append("\n").append(packagesWit);
  }
  return sb.toString();
};

/**
 * Encode the shape's imported interfaces; the emitter's front matter.
 *
 * Also the point where WIT-provided imports meet the document: each is
 * checked to actually exist in its interface, and its flattening
 * decides whether the lowering carries the canonical memory options.
 * An empty import list encodes to an empty world — no pieces, every
 * count zero — so the caller need not special-case it.
 */
export let encodeImportTypes = (
  shape: ComponentShape,
  packagesWit: String = ""
): EncodedImports => {
  if (shape.imports.length == 0) {
    return new EncodedImports();
  }
  let text = deriveImportsWit(shape, packagesWit);
  let ast = parse(text);
  for (let imp in shape.imports) {
    if (!imp.witProvided) {
      continue;
    }
    let meta = funcFlatMeta(ast, imp.interfaceName, imp.fieldName);
    if (meta == null) {
      throw new Error(
        "The component target cannot import '" + imp.fieldName +
          "' from '" + imp.interfaceName + "': the interface's WIT " +
          "declares no such function.");
    }
    imp.needsMemoryLower = (meta as WitFuncMeta).needsMemory;
  }
  let encoder = new ComponentTypeEncoder(ast);
  let world = encoder.encodeWorld(derivedWorldName);
  // Mirrored into codegen's own classes: codegen calls the encoder
  // through the injected interface and does not link the WIT parser,
  // so it cannot name `EncodedWorld` itself.
  let out = new EncodedImports();
  for (let piece in world.pieces) {
    out.pieces.push(new EncodedImportPiece(piece.id, piece.payload));
  }
  out.typeCount = world.typeCount;
  out.instanceCount = world.instanceCount;
  let names = world.instanceIndices.keys();
  while (let (true, name) = names.next()) {
    out.instanceIndices[name] = world.instanceIndices[name];
  }
  return out;
};

/** `EncodedWorld`, mirrored into codegen's own classes. */
let mirrorEncodedWorld = (world: EncodedWorld): EncodedImports => {
  let out = new EncodedImports();
  for (let piece in world.pieces) {
    out.pieces.push(new EncodedImportPiece(piece.id, piece.payload));
  }
  out.typeCount = world.typeCount;
  out.instanceCount = world.instanceCount;
  let names = world.instanceIndices.keys();
  while (let (true, name) = names.next()) {
    out.instanceIndices[name] = world.instanceIndices[name];
  }
  return out;
};

/**
 * The default encoder: no world was declared, so each interface's WIT
 * is derived from the Zena declarations, except for the interfaces the
 * compiler carries real source for.
 */
final class DerivedImportEncoder implements ImportTypeEncoder {
  /** The concatenated WIT of the program's WIT-backed packages. */
  #packagesWit: String;
  var #packagesAst: Ast | null = null;
  new(packagesWit: String = "") : #packagesWit = packagesWit;

  witProvided(interfaceName: String): boolean {
    if (isKnownWasiInterface(interfaceName)) {
      return true;
    }
    if (this.#packagesWit == "") {
      return false;
    }
    if (this.#packagesAst == null) {
      this.#packagesAst = parse(this.#packagesWit);
    }
    return docDeclaresInterface(this.#packagesAst as Ast, interfaceName);
  }

  encode(shape: ComponentShape): EncodedImports {
    return encodeImportTypes(shape, this.#packagesWit);
  }
}

/** The WIT spelling of a declared export's WIT type, for messages. */
let witTypeName = (t: Type): String => {
  let opcode = exportableWitOpcode(t);
  if (opcode >= 0) {
    return scalarWitName(opcode);
  }
  return "<not a flat scalar or string>";
};

/**
 * The component opcode of a WIT type a program export can carry today —
 * the flat scalars and `string` — or -1. Richer world exports need the
 * marshaling C-track work and are rejected by name.
 */
let exportableWitOpcode = (t: Type): i32 => {
  if (t.tag == TypeTag.Bool) { return 0x7f; }
  if (t.tag == TypeTag.S8) { return 0x7e; }
  if (t.tag == TypeTag.U8) { return 0x7d; }
  if (t.tag == TypeTag.S16) { return 0x7c; }
  if (t.tag == TypeTag.U16) { return 0x7b; }
  if (t.tag == TypeTag.S32) { return 0x7a; }
  if (t.tag == TypeTag.U32) { return 0x79; }
  if (t.tag == TypeTag.S64) { return 0x78; }
  if (t.tag == TypeTag.U64) { return 0x77; }
  if (t.tag == TypeTag.F32) { return 0x76; }
  if (t.tag == TypeTag.F64) { return 0x75; }
  if (t.tag == TypeTag.String) { return 0x73; }
  return -1;
};

/**
 * Parse a declared world's document, with the compiler's own WASI WIT
 * riding along so a world can `import wasi:cli/stdout@0.3.0;` without
 * vendoring it — unless the document declares those packages itself,
 * in which case its definitions win and ours stay out of the way.
 */
let parseWithWasi = (witSource: String): Ast => {
  var source = witSource;
  if (!source.contains("package wasi:cli@0.3.0")) {
    source = source + "\n" + knownWasiPackagesWit();
  }
  return parse(source);
};

/** One function export a declared world demands of the program. */
final class DeclaredExport {
  name: String;
  func: Func;
  new(this.name, this.func);
}

/**
 * The encoder for a program compiled against a declared world
 * (`--wit`/`--world`): the world is the authority, emission follows it,
 * and every disagreement between the WIT and the Zena program is a
 * compile error.
 *
 * Concretely: the component imports exactly what the world imports
 * (plus `use` dependencies, which WIT implies); every `@external` must
 * name a function of an interface the world explicitly imports, with a
 * core signature matching the WIT's canonical flattening; and the
 * export surfaces must agree in both directions — a world export the
 * program does not provide, or a program export the world does not
 * declare, is an error, as is a type or asyncness mismatch on one they
 * share.
 */
final class DeclaredWorldEncoder implements ImportTypeEncoder {
  #ast: Ast;
  var #worldName = "";
  /** The world's explicit interface imports, by qualified name. */
  #importedInterfaces = new GrowableArray<String>();
  /** The world's function exports, in declaration order. */
  #declaredExports = new GrowableArray<DeclaredExport>();

  new(witSource: String, worldName: String) : #ast = parseWithWasi(witSource) {
    var name = worldName;
    if (name == "") {
      let names = worldNames(this.#ast);
      if (names.length != 1) {
        var listed = "";
        for (let n in names) {
          if (listed != "") { listed = listed + ", "; }
          listed = listed + "'" + n + "'";
        }
        throw new Error(if (names.length == 0) {
          "--wit names a document with no world; declare one, or pass " +
          "--world if it lives in another file."
        } else {
          "--wit names a document with more than one world (" + listed +
          "); say which with --world."
        });
      }
      name = names[0];
    }
    this.#worldName = name;

    var found = false;
    for (let item in this.#ast.items) {
      if (item.tag != AstItemTag.World) { continue; }
      let world = item.worldDef as WorldDef;
      if (world.name.name != name) { continue; }
      found = true;
      for (let wi in world.items) {
        if (wi.tag == WorldItemTag.Import) {
          this.#collectImport((wi.importItem as Import).kind);
        } else if (wi.tag == WorldItemTag.Export) {
          this.#collectExport((wi.exportItem as Export).kind);
        }
        // use / typedef / include fail in the encoder with their own
        // messages; collecting nothing here keeps that the one error.
      }
    }
    if (!found) {
      throw new Error("--world '" + name + "' is not a world the --wit " +
          "document declares.");
    }
  }

  #collectImport(kind: ExternKind): void {
    if (kind.tag == ExternKindTag.Path) {
      let path = kind.path as UsePath;
      let qualified = if (path.tag == UsePathTag.Id) {
        qualifiedInterfaceName(this.#ast.packageName, (path.id as Id).name)
      } else {
        qualifiedInterfaceName(path.packageId, (path.name as Id).name)
      };
      this.#importedInterfaces.push(qualified);
    } else if (kind.tag == ExternKindTag.Interface) {
      // An inline interface imports under its plain name.
      this.#importedInterfaces.push((kind.name as Id).name);
    }
    // A world-level function import is legal WIT and is encoded, but a
    // program has no way to bind one yet — `@external` names an
    // interface and a field — so it is import surface the program
    // simply does not call.
  }

  #collectExport(kind: ExternKind): void {
    if (kind.tag == ExternKindTag.Func) {
      this.#declaredExports.push(
          new DeclaredExport((kind.name as Id).name, kind.funcDef as Func));
      return;
    }
    throw new Error("The declared world exports an interface, which a " +
        "program cannot implement yet — only function exports are " +
        "supported (interface exports arrive with bindgen).");
  }

  witProvided(interfaceName: String): boolean {
    return true;
  }

  encode(shape: ComponentShape): EncodedImports {
    this.#checkImports(shape);
    this.#checkExports(shape);
    let encoder = new ComponentTypeEncoder(this.#ast);
    return mirrorEncodedWorld(encoder.encodeWorld(this.#worldName));
  }

  /**
   * Every `@external` must name a function of an interface the world
   * explicitly imports, and the Zena declaration's core signature must
   * match the WIT's canonical flattening. The flattening determines
   * counts, not core value types, so this is a count-level check —
   * enough to catch a missing retptr, a forgotten parameter, or a sync
   * declaration against an async function.
   */
  #checkImports(shape: ComponentShape): void {
    for (let imp in shape.imports) {
      var declared = false;
      for (let name in this.#importedInterfaces) {
        if (name == imp.interfaceName) { declared = true; }
      }
      if (!declared) {
        throw new Error("The program imports '" + imp.fieldName +
            "' from '" + imp.interfaceName + "', which the declared " +
            "world does not import. Add `import " + imp.interfaceName +
            ";` to the world, or drop the @external.");
      }
      let metaOpt = funcFlatMeta(this.#ast, imp.interfaceName, imp.fieldName);
      if (metaOpt == null) {
        throw new Error("The program imports '" + imp.fieldName +
            "' from '" + imp.interfaceName + "', and the interface's WIT " +
            "declares no such function.");
      }
      let meta = metaOpt as WitFuncMeta;
      if (imp.lowerAsync != meta.isAsync) {
        throw new Error("The program and the WIT disagree about whether '" +
            imp.fieldName + "' of '" + imp.interfaceName + "' is async: " +
            (if (meta.isAsync) {
              "the WIT says async, so the @external needs the \"async\" " +
              "option."
            } else {
              "the @external says async, and the WIT function is not."
            }));
      }
      // The core signature the canonical ABI will call with: flattened
      // parameters (or one pointer once they spill past sixteen), a
      // trailing return-area address when the result flattens to more
      // than one value, and for an async lowering a subtask handle as
      // the one result.
      var expectedParams =
          if (meta.paramFlatCount > 16) 1 else meta.paramFlatCount;
      var expectedResults = 0;
      if (imp.lowerAsync) {
        expectedResults = 1;
      } else if (meta.resultFlatCount > 1) {
        expectedParams += 1;
      } else {
        expectedResults = meta.resultFlatCount;
      }
      if (imp.coreParamCount != expectedParams ||
          imp.coreResultCount != expectedResults) {
        throw new Error("The @external declaration for '" + imp.fieldName +
            "' of '" + imp.interfaceName + "' does not match the WIT's " +
            "canonical flattening: the declaration has " +
            i32ToString(imp.coreParamCount) + " parameter(s) and " +
            i32ToString(imp.coreResultCount) + " result(s), and the " +
            "flattening needs " + i32ToString(expectedParams) +
            " and " + i32ToString(expectedResults) + ".");
      }
      imp.needsMemoryLower = meta.needsMemory;
    }
  }

  /**
   * The export surfaces must agree exactly: name for name, type for
   * type, and async for async. The world's export types are limited to
   * what the program can marshal today — flat scalars and `string` —
   * and anything richer is rejected by name rather than emitted as a
   * lift the wrappers cannot satisfy.
   */
  #checkExports(shape: ComponentShape): void {
    for (let declared in this.#declaredExports) {
      var found = false;
      for (let e in shape.exports) {
        if (e.exportName == declared.name) { found = true; }
      }
      if (!found) {
        throw new Error("The declared world exports '" + declared.name +
            "', and the program does not export it.");
      }
    }
    for (let e in shape.exports) {
      var declaredOpt: DeclaredExport | null = null;
      for (let d in this.#declaredExports) {
        if (d.name == e.exportName) { declaredOpt = d; }
      }
      if (declaredOpt == null) {
        throw new Error("The program exports '" + e.exportName +
            "', which the declared world does not export. Add `export " +
            e.exportName + ": func(...);` to the world, or stop " +
            "exporting it.");
      }
      this.#checkExportSignature(declaredOpt as DeclaredExport, e);
    }
  }

  #checkExportSignature(declared: DeclaredExport, e: ComponentExportFunc): void {
    let witFunc = declared.func;
    let sig = e.signature;
    if (witFunc.isAsync != sig.isAsync) {
      throw new Error("The program and the WIT disagree about whether " +
          "export '" + declared.name + "' is async" +
          (if (sig.isAsync) {
            " — a program that sleeps is entered through an async lift, " +
            "so the world must declare `export " + declared.name +
            ": async func();`."
          } else {
            "."
          }));
    }
    if (witFunc.params.length != sig.paramTypes.length) {
      throw new Error("Export '" + declared.name + "': the WIT declares " +
          i32ToString(witFunc.params.length) + " parameter(s) and the " +
          "program's signature has " + i32ToString(sig.paramTypes.length) +
          ".");
    }
    for (var i = 0; i < witFunc.params.length; i += 1) {
      let want = exportableWitOpcode(witFunc.params[i].type);
      if (want < 0) {
        throw new Error("Export '" + declared.name + "', parameter '" +
            witFunc.params[i].name.name + "': the WIT type is not yet " +
            "expressible by a program export — only flat scalars and " +
            "string cross today.");
      }
      if (want != sig.paramTypes[i]) {
        throw new Error("Export '" + declared.name + "', parameter '" +
            witFunc.params[i].name.name + "': the WIT says '" +
            witTypeName(witFunc.params[i].type) + "' and the program's " +
            "signature says '" + scalarWitName(sig.paramTypes[i]) + "'.");
      }
    }
    let witResult = witFunc.result;
    if (witResult == null) {
      if (sig.result != noComponentResult) {
        throw new Error("Export '" + declared.name + "': the WIT declares " +
            "no result and the program's signature returns '" +
            scalarWitName(sig.result) + "'.");
      }
      return;
    }
    let want = exportableWitOpcode(witResult as Type);
    if (want < 0) {
      throw new Error("Export '" + declared.name + "': the WIT result " +
          "type is not yet expressible by a program export — only flat " +
          "scalars and string cross today.");
    }
    if (sig.result == noComponentResult) {
      throw new Error("Export '" + declared.name + "': the WIT declares " +
          "a '" + witTypeName(witResult as Type) + "' result and the " +
          "program's signature returns nothing.");
    }
    if (want != sig.result) {
      throw new Error("Export '" + declared.name + "': the WIT says '" +
          witTypeName(witResult as Type) + "' and the program's " +
          "signature says '" + scalarWitName(sig.result) + "'.");
    }
  }
}

/**
 * The encoder as drivers inject it (`BinaryGenerator.importEncoder`) —
 * the one edge from the compiler's build to the WIT parser. With no
 * arguments, the derived-world default; with `--wit`'s document text
 * (and `--world`'s name, or "" to take the document's sole world), the
 * declared world becomes the authority and disagreements are errors.
 */
export let makeImportEncoder = (
  witSource: String | null = null,
  worldName: String = "",
  packagesWit: String = ""
): ImportTypeEncoder => {
  if (witSource == null) {
    return new DerivedImportEncoder(packagesWit);
  }
  return new DeclaredWorldEncoder(witSource as String, worldName);
};
