// Package manifest parsing for the Zena compiler.
//
// Parses `zena-packages.json` files into `PackageConfig` maps. The manifest
// format is:
//
//   {
//     "packages": {
//       "my-lib": "./packages/my-lib/zena/lib",         // shorthand
//       "my-other-lib": {                                // full form
//         "root": "./packages/other/zena/lib",
//         "exports": {
//           "utils": {},
//           "widgets": { "path": "widgets/index.zena" },
//           "console": { "virtual": { "js": "console/host.zena", ... } }
//         }
//       }
//     }
//   }
//
// `path` and `virtual` values are entry file paths relative to the package
// root. Files not listed in `exports` are private to the package and are
// reachable only via relative imports from its own files.
//
// A project that uses published packages also has `dependencies` and
// `resolved` sections; see `addResolvedPackages`.

import { parseJson, JsonValue, JsonObject } from 'zena:json';
import { PackageConfig, ModuleExport } from './module-resolver.zena';
import { CompilerHost } from './library-loader.zena';
import { dirName, normalizePath } from './module-resolver.zena';
import { canonicalTarget } from './targets.zena';
import { HashMap } from 'zena:collections';

// ============================================================================
// Package Map Loading
// ============================================================================

// Load and parse a `zena-packages.json` file.
//
// Relative paths in the manifest are resolved against the manifest's
// directory, and absolute paths are kept as written. When `manifestPath` is
// relative (the compiler reads `zena-packages.json` from its working
// directory, the project root), a path that climbs out of the project,
// such as `../zena/packages/lib`, cannot be read relative to that working
// directory; `projectRoot`, the project's absolute path, turns it into an
// absolute path. Without `projectRoot` it stays relative.
//
// Returns a map of package name → PackageConfig. The "zena" package (stdlib)
// is NOT included — the compiler adds that automatically.
//
// With `packageCache`, the map also holds the packages the file pins in
// its `resolved` section, and the project's names for them from its
// `dependencies` section (see `addResolvedPackages`). A tool without a
// package cache sees only the packages listed by path.
export function loadPackageMap(
  host: CompilerHost,
  manifestPath: String,
  projectRoot: String | null = null,
  packageCache: String | null = null
): HashMap<String, PackageConfig> {
  let source = host.readFile(manifestPath);
  let json = parseJson(source);
  let root = json as JsonObject;
  let manifestDir = dirName(manifestPath);
  let result = new Map<String, PackageConfig>();

  if (root.has("packages")) {
    let packages = root["packages"] as JsonObject;
    packages.forEach((name, value) => {
      // Skip "zena" — stdlib is handled by the compiler.
      if (name == "zena") {
        return;
      }
      let config = parsePackageEntry(value, manifestDir, projectRoot);
      result[name] = config;
    });
  }

  if (packageCache != null) {
    addResolvedPackages(root, packageCache, result);
  }
  return result;
}

// Adds the packages a resolution file pins, and the project's names for
// them (docs/design/package-manager.md, "The resolution file"):
//
//   "dependencies": {"router": "did:plc:...@1"},
//   "resolved": {
//     "did:plc:...@1": {
//       "version": "1.4.2", "release": "bafyrei...", "source": "bafkrei...",
//       "dependencies": {"json": "did:web:json.example.com@2"}
//     }
//   }
//
// Each resolved package is keyed by DID and major version and rooted at
// its unpacked source archive, `<packageCache>/sources/<source CID>`. Its
// own `dependencies` are the names its files import. Each of the
// project's `dependencies` becomes an alias of the key it names.
function addResolvedPackages(
  manifest: JsonObject,
  packageCache: String,
  result: HashMap<String, PackageConfig>
): void {
  let keys = new Array<String>();
  let sources = new Map<String, String>();
  if (manifest.has("resolved")) {
    let resolved = manifest["resolved"] as JsonObject;
    resolved.forEach((key, value) => {
      if (!isPackageKey(key)) {
        throw new Error(
            `zena-packages.json: "resolved" has '${key}', which is not a DID and major version such as did:plc:example@1`);
      }
      if (!(value is JsonObject)) {
        throw new Error(`zena-packages.json: "resolved" entry ${key} is not an object`);
      }
      let entry = value as JsonObject;
      let source = stringMember(entry, "source", key);
      if (!isCidText(source)) {
        throw new Error(`zena-packages.json: ${key} has source '${source}', which is not a CID`);
      }
      if (let (true, other) = sources.get(source)) {
        throw new Error(`zena-packages.json: ${other} and ${key} have the same source archive, ${source}`);
      }
      sources[source] = key;
      let config = new PackageConfig(`${packageCache}/sources/${source}`, null);
      config.dependencies = nameMap(entry, key);
      result[key] = config;
      keys.push(key);
    });
  }
  for (let key in keys) {
    let dependencies = result[key].dependencies as HashMap<String, String>;
    dependencies.forEach((name, target) => {
      if (!isResolved(result, target)) {
        throw new Error(
            `zena-packages.json: ${key} depends on ${target}, as '${name}', but "resolved" has no ${target}`);
      }
    });
  }
  let projectNames = nameMap(manifest, "the project");
  projectNames.forEach((name, target) => {
    if (result.has(name)) {
      throw new Error(`zena-packages.json: '${name}' is both a package and a dependency`);
    }
    if (!isResolved(result, target)) {
      throw new Error(
          `zena-packages.json: dependency '${name}' is ${target}, but "resolved" has no ${target}`);
    }
    let alias = new PackageConfig("", null);
    alias.aliasOf = target;
    result[name] = alias;
  });
}

// The `dependencies` member of `object`: local names, each mapped to a
// package key. Empty when there is none.
function nameMap(object: JsonObject, owner: String): HashMap<String, String> {
  let names = new Map<String, String>();
  if (!object.has("dependencies")) {
    return names;
  }
  let dependencies = object["dependencies"];
  if (!(dependencies is JsonObject)) {
    throw new Error(`zena-packages.json: the dependencies of ${owner} are not an object`);
  }
  (dependencies as JsonObject).forEach((name, target) => {
    if (name == "" || name == "zena" || name.contains(":")) {
      throw new Error(`zena-packages.json: ${owner} has a dependency named '${name}'`);
    }
    if (!(target is String)) {
      throw new Error(`zena-packages.json: ${owner}'s dependency '${name}' is not a string`);
    }
    names[name] = target as String;
  });
  return names;
}

function isResolved(packages: HashMap<String, PackageConfig>, key: String): boolean {
  if (let (true, config) = packages.get(key)) {
    return config.dependencies != null;
  }
  return false;
}

function stringMember(object: JsonObject, member: String, owner: String): String {
  let value = object[member];
  if (!(value is String)) {
    throw new Error(`zena-packages.json: ${owner} has no "${member}" string`);
  }
  return value as String;
}

// Whether `key` names a package by DID and major version: `did:`, more
// text, `@`, and a number.
function isPackageKey(key: String): boolean {
  if (!key.startsWith("did:")) {
    return false;
  }
  var at = -1;
  for (var i = 0; i < key.length; i += 1) {
    if (key.getByteAt(i) == 64) { // '@'
      at = i;
    }
  }
  if (at <= 4 || at == key.length - 1) {
    return false;
  }
  for (var i = at + 1; i < key.length; i += 1) {
    let b = key.getByteAt(i);
    if (b < 48 || b > 57) {
      return false;
    }
  }
  return true;
}

// Whether `text` looks like a base32 CID string: `b` and then lowercase
// base32. It becomes a directory name in the package cache, so nothing
// else, a `/` or `..` least of all, may pass.
function isCidText(text: String): boolean {
  if (text.length < 2 || text.getByteAt(0) != 98) { // 'b'
    return false;
  }
  for (var i = 1; i < text.length; i += 1) {
    let b = text.getByteAt(i);
    if (!((b >= 97 && b <= 122) || (b >= 50 && b <= 55))) {
      return false;
    }
  }
  return true;
}

// Parse a single package entry from the manifest.
//
// Supports two forms:
// - String shorthand: "./path/to/lib" → open package with that root
// - Object form: { root, exports? }
function parsePackageEntry(value: JsonValue, manifestDir: String, projectRoot: String | null): PackageConfig {
  // String shorthand: just a path.
  if (value is String) {
    return new PackageConfig(resolveManifestPath(value, manifestDir, projectRoot), null);
  }

  // Object form.
  let obj = value as JsonObject;

  // WIT-backed form: {"wit": "./path"} — the package's modules are WIT
  // interfaces, synthesized by the host from the .wit source there.
  if (obj.has("wit")) {
    let witValue = obj["wit"] as String;
    let config = new PackageConfig("", null);
    config.witRoot = resolveManifestPath(witValue, manifestDir, projectRoot);
    return config;
  }

  let rootValue = obj["root"] as String;
  let root = resolveManifestPath(rootValue, manifestDir, projectRoot);

  // Parse exports (optional).
  var exports: HashMap<String, ModuleExport> | null = null;
  if (obj.has("exports")) {
    let exportsMap = new Map<String, ModuleExport>();
    let exportsObj = obj["exports"] as JsonObject;
    exportsObj.forEach((moduleName, moduleValue) => {
      let moduleExport = parseModuleExport(moduleValue);
      exportsMap[moduleName] = moduleExport;
    });
    exports = exportsMap;
  }

  return new PackageConfig(root, exports);
}

// A directory the manifest names, as `loadPackageMap` describes.
function resolveManifestPath(value: String, manifestDir: String, projectRoot: String | null): String {
  if (value.startsWith("/")) {
    return normalizePath(value);
  }
  let resolved = normalizePath(`${manifestDir}/${value}`);
  if (projectRoot != null && (resolved == ".." || resolved.startsWith("../"))) {
    return normalizePath(`${projectRoot}/${resolved}`);
  }
  return resolved;
}

// Parse a module export entry: {}, { "path": "..." }, or { "virtual": { ... } },
// any of which may carry "internal": true.
function parseModuleExport(value: JsonValue): ModuleExport {
  let obj = value as JsonObject;
  let internalValue = obj["internal"];
  let internal = internalValue is Box<boolean> &&
      (internalValue as Box<boolean>).value;

  if (obj.has("virtual")) {
    let virtualObj = obj["virtual"] as JsonObject;
    let virtual = new Map<String, String>();
    // Keyed by current target names, as the resolver looks them up; a
    // manifest that still says "host" keeps working.
    virtualObj.forEach((target, entryPath) => {
      virtual[canonicalTarget(target)] = entryPath as String;
    });
    return new ModuleExport(virtual, null, internal);
  }

  if (obj.has("path")) {
    return new ModuleExport(null, obj["path"] as String, internal);
  }

  return new ModuleExport(null, null, internal);
}

/**
 * The user's packages plus the ones the stdlib carries: `wasi`, the
 * WIT-backed package whose interfaces the stdlib itself imports
 * (`zena:fetch` on the component target speaks `wasi:http`), rooted
 * at the WIT shipped under the stdlib. A user manifest that declares
 * `wasi` keeps its own — a test's fixture package, say. The `zena`
 * package is not here: it is built from the manifest, not a path.
 */
export function withBuiltinPackages(
  stdlibRoot: String,
  packages: Map<String, PackageConfig>
): HashMap<String, PackageConfig> {
  let all = new Map<String, PackageConfig>();
  for (let name in packages.keys()) {
    all[name] = packages[name];
  }
  if (!all.has("wasi")) {
    let wasi = new PackageConfig("", null);
    wasi.witRoot = `${stdlibRoot}/wit`;
    all["wasi"] = wasi;
  }
  // The `zena` command's host interfaces (`zena-cli:host`): what the
  // standard library's process, wasm and error-stack modules import on
  // that host's target. Only a program that uses one of those links
  // any of it.
  if (!all.has("zena-cli")) {
    let host = new PackageConfig("", null);
    host.witRoot = `${stdlibRoot}/host-wit`;
    all["zena-cli"] = host;
  }
  return all;
}

// The stdlib's own manifest lives in ./stdlib-manifest.zena; re-exported
// here so callers keep one import for both manifests.
export { buildStdlibConfig } from './stdlib-manifest.zena';
