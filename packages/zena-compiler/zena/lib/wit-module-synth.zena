/**
 * WIT-typed modules, synthesized: the source text behind an
 * `import {now} from 'wasi:clocks/monotonic-clock'`.
 *
 * A WIT-backed package (`{"wit": "./path"}` in the manifest) resolves
 * its modules to `wit:<root>#<namespace>:<interface-path>` canonical
 * paths, and the compiler host answers `readFile` for those by calling
 * `synthesizeWitModule` here: parse the package's WIT, find the
 * interface, and render its declarations as Zena typed *from the WIT*
 * — the checker then sees the interface's real signatures rather than
 * whatever an author transcribed.
 *
 * This module is imported by the drivers (the CLI's host, the test
 * hosts), never by compiler-lib code — the same edge as
 * `wit-imports.zena`, and for the same reason: it keeps the WIT parser
 * out of the module graphs of hosts that do not serve WIT-backed
 * packages, like the language service.
 *
 * The rendered surface, per Part 5's mapping
 * (docs/design/component-model.md):
 *
 * - Named types are declared: `enum` → Zena enum with explicit
 *   ordinals, `flags` → distinct u32 with per-label constants,
 *   `record` → case class, `variant` → sealed case-class hierarchy
 *   (case classes prefixed with the variant's name, because two
 *   variants in one interface may declare same-named cases).
 * - A flat-scalar function is one `@external` declaration. Staged
 *   parameters (`string`, `list<u8>`) and lifted results ride a
 *   wrapper over `zena:component-abi`, as before.
 * - A result that flattens past one core value spills: the raw call
 *   takes a return-area address, the canonical ABI writes the value
 *   there with our `realloc`, and generated lift code reads it out at
 *   the canonical offsets — records, variants, options, tuples and
 *   lists of all of these, recursively, freeing every host-written
 *   buffer as it goes. A top-level `result<T, E>` lifts into the
 *   inline `Result<T, E>`; a nested one would need `Outcome` and
 *   waits.
 *
 * A function whose signature needs more — aggregate *parameters* (the
 * flat-lowering half), resources, async results — is listed in the
 * synthesized module's header comment with its reason, and importing
 * it reports a missing export.
 */

import { String } from 'zena:string';
import { Array } from 'zena:array';
import { StringBuilder } from 'zena:string-builder';
import { Error } from 'zena:error';
import { i32ToString } from 'zena:string-convert';
import { parse } from 'wit-parser:wit';
import {
  readWitSource, findInterface, FoundInterface
} from 'wit-parser:document';
import {
  InterfaceItem, InterfaceItemTag, NamedFunc, Type, TypeTag, TypeDef,
  TypeDefTag, Id, EnumCaseDef, FlagDef, Field, Case, ResourceFunc,
  ResourceFuncTag
} from 'wit-parser:parser';


/** Whether `path` is a synthesized WIT module's canonical path. */
export function isWitModulePath(path: String): boolean {
  return path.startsWith("wit:");
}

/** How a WIT type crosses the boundary in the rendered slice. */
enum TyKind {
  /** One core value, passed through: the Zena spelling is `scalar`. */
  Scalar,
  /** `string`: `(ptr, len)` on the wire. */
  Str,
  /** `list<u8>`: the same wire shape as a string. */
  BytesList,
  /** `list<T>` for any other liftable `T`. */
  ListT,
  /** A WIT `enum`: one discriminant on the wire, a Zena enum here. */
  Enumeration,
  /** A WIT `flags`: one bitset word on the wire, a distinct u32 here. */
  Flags,
  /** A WIT `record`: a case class. */
  RecordT,
  /** A WIT `variant`: a sealed case-class hierarchy. */
  VariantT,
  /** `option<T>`: `Option<T>`. */
  OptionT,
  /** `result<T, E>`: inline `Result<T, E>` at top level. */
  ResultT,
  /** `tuple<...>`: an inline tuple. */
  TupleT,
  /** A resource handle (`own`, `borrow`, or a bare resource name):
   * one i32 index on the wire, a Disposable wrapper class here. */
  ResourceH,
  /** Waits on the interop stages; `reason` says which. */
  Unsupported
}

/**
 * A classified WIT type with its canonical layout: `size`/`align` are
 * the canonical ABI's, `flats` the count of core values the type
 * flattens to. Children: a record's or tuple's members, a list's
 * element, an option's inner, a result's ok/err, a variant's payloads
 * — with the void sentinel standing in for an absent payload.
 */
final class Ty {
  kind: TyKind;
  /** The Zena spelling of a Scalar; "" otherwise. */
  scalar: String;
  /** The synthesized Zena type name of a named type. */
  typeName: String;
  reason: String;
  /** Enum/variant case count, or flags label count. */
  var caseCount = 0;
  children = new GrowableArray<Ty>();
  /** Record field names (camelCase) or variant case names (Pascal,
   * already prefixed with the variant's own name). */
  childNames = new GrowableArray<String>();
  var size = 0;
  var align = 1;
  var flats = 0;
  /** ResourceH only: whether this position borrows rather than owns.
   * Everywhere else a resource in value position is an implicit
   * `own`, which consumes — the wrapper is marked moved when lowered. */
  var isBorrow = false;
  new(this.kind, this.scalar = "", this.typeName = "", this.reason = "");
}

let unsupported = (reason: String): Ty =>
    new Ty(TyKind.Unsupported, "", "", reason);

/** The stand-in for an absent variant payload or result arm. */
let voidTy = (): Ty => {
  let ty = new Ty(TyKind.Scalar, "void");
  ty.size = 0;
  ty.align = 1;
  ty.flats = 0;
  return ty;
};

let isVoid = (ty: Ty): boolean =>
    ty.kind == TyKind.Scalar && ty.scalar == "void";

/** `x` rounded up to a power-of-two alignment `a`. */
let alignTo = (x: i32, a: i32): i32 => {
  if (a <= 1) {
    return x;
  }
  let r = x & (a - 1);
  return if (r == 0) x else x + a - r;
};

/** The canonical discriminant size for `count` cases. */
let discSize = (count: i32): i32 => {
  if (count <= 256) { return 1; }
  if (count <= 65536) { return 2; }
  return 4;
};

let scalarTy = (spelling: String, size: i32): Ty => {
  let ty = new Ty(TyKind.Scalar, spelling);
  ty.size = size;
  ty.align = size;
  ty.flats = 1;
  return ty;
};

let pairTy = (kind: TyKind): Ty => {
  let ty = new Ty(kind);
  ty.size = 8;
  ty.align = 4;
  ty.flats = 2;
  return ty;
};

/** Lay out a variant-shaped type: a discriminant then the aligned
 * payload area, sized for the largest case. */
let layoutVariant = (ty: Ty, count: i32): void => {
  let disc = discSize(count);
  var payloadAlign = 1;
  var payloadSize = 0;
  var maxFlats = 0;
  for (let child in ty.children) {
    if (child.align > payloadAlign) { payloadAlign = child.align; }
    if (child.size > payloadSize) { payloadSize = child.size; }
    if (child.flats > maxFlats) { maxFlats = child.flats; }
  }
  ty.align = if (disc > payloadAlign) disc else payloadAlign;
  ty.size = alignTo(alignTo(disc, payloadAlign) + payloadSize, ty.align);
  ty.flats = 1 + maxFlats;
  ty.caseCount = count;
};

/** A variant-shaped type's payload offset. */
let payloadOffset = (ty: Ty): i32 => {
  var payloadAlign = 1;
  for (let child in ty.children) {
    if (child.align > payloadAlign) { payloadAlign = child.align; }
  }
  return alignTo(discSize(ty.caseCount), payloadAlign);
};

/** Lay out a record-shaped type: fields at their aligned offsets. */
let layoutRecord = (ty: Ty): void => {
  var offset = 0;
  var maxAlign = 1;
  var flats = 0;
  for (let child in ty.children) {
    if (child.align > maxAlign) { maxAlign = child.align; }
    offset = alignTo(offset, child.align) + child.size;
    flats += child.flats;
  }
  ty.align = maxAlign;
  ty.size = alignTo(offset, maxAlign);
  ty.flats = flats;
};

/** A record-shaped type's field offsets, in declaration order. */
let fieldOffsets = (ty: Ty): GrowableArray<i32> => {
  let offsets = new GrowableArray<i32>();
  var offset = 0;
  for (let child in ty.children) {
    offset = alignTo(offset, child.align);
    offsets.push(offset);
    offset += child.size;
  }
  return offsets;
};

/**
 * Classify a WIT type for rendering, with its canonical layout. A
 * named type resolves through the interface's own declarations —
 * aliases transparently, enums/flags/records/variants to their
 * synthesized Zena types.
 */
function classifyType(t: Type, ifaceItems: Array<InterfaceItem>): Ty {
  match (t.tag) {
    case TypeTag.Bool: { return scalarTy("boolean", 1); }
    case TypeTag.U8: { return scalarTy("u8", 1); }
    case TypeTag.U16: { return scalarTy("u16", 2); }
    case TypeTag.U32: { return scalarTy("u32", 4); }
    case TypeTag.U64: { return scalarTy("u64", 8); }
    case TypeTag.S8: { return scalarTy("i8", 1); }
    case TypeTag.S16: { return scalarTy("i16", 2); }
    case TypeTag.S32: { return scalarTy("i32", 4); }
    case TypeTag.S64: { return scalarTy("i64", 8); }
    case TypeTag.F32: { return scalarTy("f32", 4); }
    case TypeTag.F64: { return scalarTy("f64", 8); }
    case _: {}
  }
  if (t.tag == TypeTag.String) {
    return pairTy(TyKind.Str);
  }
  if (t.tag == TypeTag.List) {
    if (t.fixedLength >= 0) {
      return unsupported("fixed-length lists wait on the interop stages");
    }
    let element = classifyType(t.inner as Type, ifaceItems);
    if (element.kind == TyKind.Unsupported) {
      return element;
    }
    if (element.kind == TyKind.Scalar && element.scalar == "u8") {
      return pairTy(TyKind.BytesList);
    }
    let ty = pairTy(TyKind.ListT);
    ty.children.push(element);
    return ty;
  }
  if (t.tag == TypeTag.Option) {
    let inner = classifyType(t.inner as Type, ifaceItems);
    if (inner.kind == TyKind.Unsupported) {
      return inner;
    }
    let ty = new Ty(TyKind.OptionT);
    ty.children.push(inner);
    layoutVariant(ty, 2);
    return ty;
  }
  if (t.tag == TypeTag.Result) {
    let ok = t.okType;
    let err = t.errType;
    let okTy = if (ok == null) voidTy()
        else classifyType(ok as Type, ifaceItems);
    let errTy = if (err == null) voidTy()
        else classifyType(err as Type, ifaceItems);
    if (okTy.kind == TyKind.Unsupported) { return okTy; }
    if (errTy.kind == TyKind.Unsupported) { return errTy; }
    let ty = new Ty(TyKind.ResultT);
    ty.children.push(okTy);
    ty.children.push(errTy);
    layoutVariant(ty, 2);
    return ty;
  }
  if (t.tag == TypeTag.Tuple) {
    let ty = new Ty(TyKind.TupleT);
    for (let member in t.types as GrowableArray<Type>) {
      let child = classifyType(member, ifaceItems);
      if (child.kind == TyKind.Unsupported) {
        return child;
      }
      ty.children.push(child);
    }
    layoutRecord(ty);
    return ty;
  }
  if (t.tag == TypeTag.Own || t.tag == TypeTag.Borrow) {
    let inner = t.inner as Type;
    if (inner.tag != TypeTag.Name) {
      return unsupported("own/borrow of an unnamed type");
    }
    let resolved = classifyNamed((inner.name as Id).name, ifaceItems);
    if (resolved.kind != TyKind.ResourceH &&
        resolved.kind != TyKind.Unsupported) {
      return unsupported("own/borrow of a non-resource type");
    }
    if (resolved.kind == TyKind.ResourceH) {
      resolved.isBorrow = t.tag == TypeTag.Borrow;
    }
    return resolved;
  }
  if (t.tag == TypeTag.Name) {
    return classifyNamed((t.name as Id).name, ifaceItems);
  }
  return unsupported("this type waits on the interop stages");
}

/** Classify a type by its declared name in the interface. */
function classifyNamed(name: String, ifaceItems: Array<InterfaceItem>): Ty {
  for (let item in ifaceItems) {
      if (item.tag != InterfaceItemTag.TypeDef) { continue; }
      let td = item.typeDef as TypeDef;
      if (td.name.name != name) { continue; }
      if (td.tag == TypeDefTag.Alias) {
        return classifyType(td.aliasType as Type, ifaceItems);
      }
      if (td.tag == TypeDefTag.Resource) {
        let ty = new Ty(TyKind.ResourceH, "", pascalName(name));
        ty.size = 4;
        ty.align = 4;
        ty.flats = 1;
        return ty;
      }
      if (td.tag == TypeDefTag.Enum) {
        let cases = td.enumCases as GrowableArray<EnumCaseDef>;
        let ty = new Ty(TyKind.Enumeration, "", pascalName(name));
        ty.caseCount = cases.length;
        ty.size = discSize(cases.length);
        ty.align = ty.size;
        ty.flats = 1;
        return ty;
      }
      if (td.tag == TypeDefTag.Flags) {
        let flags = td.flags as GrowableArray<FlagDef>;
        let ty = new Ty(TyKind.Flags, "", pascalName(name));
        ty.caseCount = flags.length;
        ty.size = if (flags.length <= 8) 1
            else if (flags.length <= 16) 2 else 4;
        ty.align = ty.size;
        ty.flats = 1;
        return ty;
      }
      if (td.tag == TypeDefTag.Record) {
        let ty = new Ty(TyKind.RecordT, "", pascalName(name));
        for (let f in td.fields as GrowableArray<Field>) {
          let child = classifyType(f.type, ifaceItems);
          if (child.kind == TyKind.Unsupported) {
            return child;
          }
          ty.children.push(child);
          ty.childNames.push(camelName(f.name.name));
        }
        layoutRecord(ty);
        return ty;
      }
      if (td.tag == TypeDefTag.Variant) {
        let ty = new Ty(TyKind.VariantT, "", pascalName(name));
        let cases = td.cases as GrowableArray<Case>;
        for (let c in cases) {
          let payload = c.type;
          let child = if (payload == null) voidTy()
              else classifyType(payload as Type, ifaceItems);
          if (child.kind == TyKind.Unsupported) {
            return child;
          }
          ty.children.push(child);
          // Prefixed with the variant's name: two variants in one
          // interface may declare same-named cases, and sealed cases
          // are module-level classes.
          ty.childNames.push(pascalName(name) + pascalName(c.name.name));
        }
        layoutVariant(ty, cases.length);
        return ty;
      }
    break;
  }
  return unsupported("the named type '" + name +
      "' waits on the interop stages");
}

/**
 * `wait-for` → `waitFor`: a WIT name as a Zena identifier
 * (docs/design/component-model.md, Part 5's name mapping).
 *
 * TODO: consider moving this into a utilities package, and benchmark a
 * linear character copy against this slicing — the output can be
 * pre-allocated at `kebab.length`, since it only ever shrinks.
 */
function camelName(kebab: String): String {
  var out = "";
  var upper = false;
  for (var i = 0; i < kebab.length; i += 1) {
    let c = kebab.getByteAt(i);
    if (c == 45) { // '-'
      upper = true;
      continue;
    }
    var piece = kebab.sliceBytes(i, i + 1);
    if (upper) {
      piece = piece.asciiUpperCase();
      upper = false;
    }
    out = out + piece;
  }
  return out;
}

/** `error-code` → `ErrorCode`: a WIT type name as a Zena type name. */
function pascalName(kebab: String): String {
  let camel = camelName(kebab);
  if (camel.length == 0) {
    return camel;
  }
  return camel.sliceBytes(0, 1).asciiUpperCase() +
      camel.sliceBytes(1, camel.length);
}

/** One memory-lift helper owed to the module: `name(ptr) -> ty`. */
final class LiftEntry {
  key: String;
  name: String;
  ty: Ty;
  new(this.key, this.name, this.ty);
}

/** What one module's rendering pulled in, for its import lines. */
final class SynthUses {
  var hasAsync = false;
  var fixedArray = false;
  var array = false;
  var error = false;
  var option = false;
  var result = false;
  /** The `zena:component-abi` names used, in first-use order. */
  abi = new GrowableArray<String>();
  /** Enums lifted from discriminants, each owed a range-checked lift. */
  enumLifts = new GrowableArray<Ty>();
  /** Memory-lift helpers owed, discovered recursively; `emitted`
   * tracks how many have been rendered so far. */
  lifts = new GrowableArray<LiftEntry>();
  var emittedLifts = 0;
  /** Whether anything was staged through the arena — the wrapper then
   * ends its call with `releaseStaged()`. */
  var stagedAny = false;
  /** Fresh-name counter for generated locals. */
  var tmpCount = 0;
  /** Whether any resource class rendered — pulls in Disposable and
   * the module's handle symbol. */
  var anyResource = false;
  /** Whether an async result rendered — pulls in Outcome/Ok/Err. */
  var outcome = false;
  new();

  nextTmp(): i32 {
    let n = this.tmpCount;
    this.tmpCount += 1;
    return n;
  }

  useAbi(name: String): void {
    for (let existing in this.abi) {
      if (existing == name) { return; }
    }
    this.abi.push(name);
  }

  needEnumLift(ty: Ty): void {
    for (let existing in this.enumLifts) {
      if (existing.typeName == ty.typeName) { return; }
    }
    this.error = true;
    this.enumLifts.push(ty);
  }

  /** The helper name for lifting `ty` from memory, registering it. */
  liftNameOf(ty: Ty): String {
    let key = structuralKey(ty);
    for (let existing in this.lifts) {
      if (existing.key == key) { return existing.name; }
    }
    let name = if (ty.typeName != "") {
      "lift" + ty.typeName
    } else {
      "liftVal" + i32ToString(this.lifts.length)
    };
    this.lifts.push(new LiftEntry(key, name, ty));
    return name;
  }
}

/** A structural key for lift-helper dedup. Named types key by name —
 * one interface, one namespace — and anonymous ones by shape. */
function structuralKey(ty: Ty): String {
  if (ty.typeName != "") {
    return ty.typeName;
  }
  if (ty.kind == TyKind.Scalar) { return ty.scalar; }
  if (ty.kind == TyKind.Str) { return "string"; }
  if (ty.kind == TyKind.BytesList) { return "bytes"; }
  var key = if (ty.kind == TyKind.ListT) "list("
      else if (ty.kind == TyKind.OptionT) "option("
      else if (ty.kind == TyKind.ResultT) "result("
      else "tuple(";
  for (var i = 0; i < ty.children.length; i += 1) {
    if (i > 0) { key = key + ","; }
    key = key + structuralKey(ty.children[i]);
  }
  return key + ")";
}

/** The Zena spelling of a lifted `ty`, for signatures and fields. */
function zenaTypeOf(ty: Ty, uses: SynthUses): String {
  if (ty.kind == TyKind.Scalar) { return ty.scalar; }
  if (ty.kind == TyKind.Str) { return "String"; }
  if (ty.kind == TyKind.BytesList) {
    uses.fixedArray = true;
    return "FixedArray<u8>";
  }
  if (ty.kind == TyKind.ListT) {
    uses.array = true;
    return "Array<" + zenaTypeOf(ty.children[0], uses) + ">";
  }
  if (ty.kind == TyKind.OptionT) {
    uses.option = true;
    return "Option<" + zenaTypeOf(ty.children[0], uses) + ">";
  }
  if (ty.kind == TyKind.TupleT) {
    var out = "(";
    for (var i = 0; i < ty.children.length; i += 1) {
      if (i > 0) { out = out + ", "; }
      out = out + zenaTypeOf(ty.children[i], uses);
    }
    return out + ")";
  }
  // Enumeration, Flags, RecordT, VariantT — all named. ResultT never
  // reaches here: top-level results are handled in renderFunc, and
  // nested ones are refused before rendering.
  return ty.typeName;
}

/** Whether `ty` (or anything inside it) cannot be lifted yet. */
function liftBlocker(ty: Ty, nested: boolean): String {
  if (ty.kind == TyKind.Unsupported) {
    return ty.reason;
  }
  if (ty.kind == TyKind.ResultT && nested) {
    return "a nested result waits on the interop stages (Outcome " +
        "construction at void arms)";
  }
  for (let child in ty.children) {
    if (isVoid(child)) { continue; }
    let blocked = liftBlocker(child, true);
    if (blocked != "") {
      return blocked;
    }
  }
  return "";
}

/** The abi load call for a discriminant or flags word of `size`. */
let discLoad = (size: i32, ptrExpr: String, uses: SynthUses): String => {
  if (size == 1) {
    uses.useAbi("loadU8");
    return "loadU8(" + ptrExpr + ")";
  }
  if (size == 2) {
    uses.useAbi("loadU16");
    return "loadU16(" + ptrExpr + ")";
  }
  uses.useAbi("loadI32");
  return "loadI32(" + ptrExpr + ")";
};

/**
 * The expression lifting `ty` from memory at `ptrExpr`. Simple types
 * inline; aggregates call a helper this registers for emission.
 */
function liftExprOf(ty: Ty, ptrExpr: String, uses: SynthUses): String {
  if (ty.kind == TyKind.Scalar) {
    let s = ty.scalar;
    if (s == "boolean") {
      uses.useAbi("loadU8");
      return "(loadU8(" + ptrExpr + ") != 0)";
    }
    if (s == "u8") {
      uses.useAbi("loadU8");
      return "(loadU8(" + ptrExpr + ") as u8)";
    }
    if (s == "i8") {
      uses.useAbi("loadS8");
      return "(loadS8(" + ptrExpr + ") as i8)";
    }
    if (s == "u16") {
      uses.useAbi("loadU16");
      return "(loadU16(" + ptrExpr + ") as u16)";
    }
    if (s == "i16") {
      uses.useAbi("loadS16");
      return "(loadS16(" + ptrExpr + ") as i16)";
    }
    if (s == "i32") {
      uses.useAbi("loadI32");
      return "loadI32(" + ptrExpr + ")";
    }
    if (s == "u32") {
      uses.useAbi("loadI32");
      return "(loadI32(" + ptrExpr + ") as u32)";
    }
    if (s == "i64") {
      uses.useAbi("loadI64");
      return "loadI64(" + ptrExpr + ")";
    }
    if (s == "u64") {
      uses.useAbi("loadI64");
      return "(loadI64(" + ptrExpr + ") as u64)";
    }
    if (s == "f32") {
      uses.useAbi("loadF32");
      return "loadF32(" + ptrExpr + ")";
    }
    uses.useAbi("loadF64");
    return "loadF64(" + ptrExpr + ")";
  }
  if (ty.kind == TyKind.Str) {
    uses.useAbi("liftStringAt");
    return "liftStringAt(" + ptrExpr + ")";
  }
  if (ty.kind == TyKind.BytesList) {
    uses.useAbi("liftBytesAt");
    return "liftBytesAt(" + ptrExpr + ")";
  }
  if (ty.kind == TyKind.Enumeration) {
    uses.needEnumLift(ty);
    return "lift" + ty.typeName + "(" +
        discLoad(ty.size, ptrExpr, uses) + ")";
  }
  if (ty.kind == TyKind.Flags) {
    return "((" + discLoad(ty.size, ptrExpr, uses) + " as u32) as " +
        ty.typeName + ")";
  }
  if (ty.kind == TyKind.ResourceH) {
    uses.useAbi("loadI32");
    return "new " + ty.typeName + "(loadI32(" + ptrExpr + "))";
  }
  // RecordT, VariantT, OptionT, TupleT, ListT: a generated helper.
  return uses.liftNameOf(ty) + "(" + ptrExpr + ")";
}

/** `ptr` displaced by a field offset, elided when zero. */
let atOffset = (offset: i32): String =>
    if (offset == 0) "ptr" else "ptr + " + i32ToString(offset);

// ============================================================================
// The lowering half: parameters into flat slots and staged memory
// ============================================================================

/** The core value type one scalar spelling flattens to. */
let coreOf = (scalar: String): String => {
  if (scalar == "u64" || scalar == "i64") { return "i64"; }
  if (scalar == "f32") { return "f32"; }
  if (scalar == "f64") { return "f64"; }
  return "i32";
};

/** `value` cast to its core flat type, as source text. */
let castToCore = (scalar: String, value: String): String => {
  if (scalar == "boolean") {
    return "(if (" + value + ") 1 else 0)";
  }
  if (scalar == "i32" || scalar == "i64" || scalar == "f32" ||
      scalar == "f64") {
    return value;
  }
  if (scalar == "u64") {
    return "(" + value + " as i64)";
  }
  return "(" + value + " as i32)";
};

/**
 * The core value types `ty` flattens to, or null when a variant's
 * payloads would join across core types — a joined slot then needs
 * bit-casts the generated source cannot spell yet. Only the flat form
 * cares: the same variant inside a list lowers through memory, where
 * every case writes its own layout.
 */
function flatCoreSlots(ty: Ty): GrowableArray<String> | null {
  let out = new GrowableArray<String>();
  if (ty.kind == TyKind.Scalar) {
    out.push(coreOf(ty.scalar));
    return out;
  }
  if (ty.kind == TyKind.Enumeration || ty.kind == TyKind.Flags ||
      ty.kind == TyKind.ResourceH) {
    out.push("i32");
    return out;
  }
  if (ty.kind == TyKind.Str || ty.kind == TyKind.BytesList ||
      ty.kind == TyKind.ListT) {
    out.push("i32");
    out.push("i32");
    return out;
  }
  if (ty.kind == TyKind.RecordT || ty.kind == TyKind.TupleT) {
    for (let child in ty.children) {
      let inner = flatCoreSlots(child);
      if (inner == null) {
        return null;
      }
      for (let slot in inner as GrowableArray<String>) {
        out.push(slot);
      }
    }
    return out;
  }
  // OptionT, ResultT, VariantT: a discriminant, then the slotwise
  // join of the arms.
  out.push("i32");
  let joined = new GrowableArray<String>();
  for (let child in ty.children) {
    if (isVoid(child)) { continue; }
    let inner = flatCoreSlots(child);
    if (inner == null) {
      return null;
    }
    let arm = inner as GrowableArray<String>;
    for (var i = 0; i < arm.length; i += 1) {
      if (i < joined.length) {
        if (joined[i] != arm[i]) {
          return null;
        }
      } else {
        joined.push(arm[i]);
      }
    }
  }
  for (let slot in joined) {
    out.push(slot);
  }
  return out;
}

/** Whether `ty` (or anything inside it) cannot be lowered yet. */
function lowerBlocker(ty: Ty): String {
  if (ty.kind == TyKind.Unsupported) {
    return ty.reason;
  }
  if (ty.kind == TyKind.ResultT) {
    return "a result parameter waits on the interop stages (the " +
        "inline Result is return-position-only)";
  }
  for (let child in ty.children) {
    if (isVoid(child)) { continue; }
    let blocked = lowerBlocker(child);
    if (blocked != "") {
      return blocked;
    }
  }
  return "";
}

/** Whether lowering `ty` may stage arena buffers. */
function mayStage(ty: Ty): boolean {
  if (ty.kind == TyKind.Str || ty.kind == TyKind.BytesList ||
      ty.kind == TyKind.ListT) {
    return true;
  }
  for (let child in ty.children) {
    if (mayStage(child)) {
      return true;
    }
  }
  return false;
}

/** The abi store call for a value of `size` bytes at `ptrExpr`. */
let storeCall = (size: i32, isFloat: boolean, ptrExpr: String,
    value: String, uses: SynthUses): String => {
  var name = "storeI32";
  if (isFloat) {
    name = if (size == 4) "storeF32" else "storeF64";
  } else if (size == 1) {
    name = "storeU8";
  } else if (size == 2) {
    name = "storeU16";
  } else if (size == 8) {
    name = "storeI64";
  }
  uses.useAbi(name);
  return name + "(" + ptrExpr + ", " + value + ")";
};

/** `ptrExpr` displaced by `offset`, elided when zero. */
let displaced = (ptrExpr: String, offset: i32): String =>
    if (offset == 0) ptrExpr
    else "(" + ptrExpr + ") + " + i32ToString(offset);

/**
 * Emit statements writing `value` (of type `ty`) into memory at
 * `ptrExpr`, per the canonical layout — the element form a staged
 * list buffer is filled with. Buffers staged along the way register
 * with the arena; `releaseStaged()` after the call frees them all.
 */
function lowerMemStmts(sb: StringBuilder, ty: Ty, value: String,
    ptrExpr: String, indent: String, uses: SynthUses): void {
  if (ty.kind == TyKind.Scalar) {
    let isFloat = ty.scalar == "f32" || ty.scalar == "f64";
    sb.append(indent).append(storeCall(ty.size, isFloat, ptrExpr,
        castToCore(ty.scalar, value), uses)).append(";\n");
    return;
  }
  if (ty.kind == TyKind.Enumeration) {
    sb.append(indent).append(storeCall(ty.size, false, ptrExpr,
        "(" + value + " as i32)", uses)).append(";\n");
    return;
  }
  if (ty.kind == TyKind.Flags) {
    sb.append(indent).append(storeCall(ty.size, false, ptrExpr,
        "((" + value + " as u32) as i32)", uses)).append(";\n");
    return;
  }
  if (ty.kind == TyKind.ResourceH) {
    uses.useAbi("storeI32");
    sb.append(indent).append("storeI32(").append(ptrExpr).append(", ")
        .append(value).append(".[rawHandle]());\n");
    if (!ty.isBorrow) {
      sb.append(indent).append(value).append(".[markMoved]();\n");
    }
    return;
  }
  if (ty.kind == TyKind.Str || ty.kind == TyKind.BytesList) {
    let stage = if (ty.kind == TyKind.Str) "stageString"
        else "stageByteList";
    uses.useAbi(stage);
    uses.stagedAny = true;
    let p = "p" + i32ToString(uses.nextTmp());
    let l = "l" + i32ToString(uses.nextTmp());
    sb.append(indent).append("let (").append(p).append(", ").append(l)
        .append(") = ").append(stage).append("(").append(value)
        .append(");\n");
    sb.append(indent).append("storeI32(").append(ptrExpr).append(", ")
        .append(p).append(");\n");
    sb.append(indent).append("storeI32(").append(displaced(ptrExpr, 4))
        .append(", ").append(l).append(");\n");
    uses.useAbi("storeI32");
    return;
  }
  if (ty.kind == TyKind.ListT) {
    emitListStaging(sb, ty, value, indent, uses,
        (buf: String, count: String): void => {
      sb.append(indent).append("storeI32(").append(ptrExpr).append(", ")
          .append(buf).append(");\n");
      sb.append(indent).append("storeI32(").append(displaced(ptrExpr, 4))
          .append(", ").append(count).append(");\n");
      uses.useAbi("storeI32");
    });
    return;
  }
  if (ty.kind == TyKind.RecordT || ty.kind == TyKind.TupleT) {
    let offsets = fieldOffsets(ty);
    var names = new GrowableArray<String>();
    if (ty.kind == TyKind.RecordT) {
      for (let field in ty.childNames) {
        names.push(value + "." + field);
      }
    } else {
      let t = "t" + i32ToString(uses.nextTmp());
      sb.append(indent).append("let (");
      for (var i = 0; i < ty.children.length; i += 1) {
        if (i > 0) { sb.append(", "); }
        sb.append(t).append("v").append(i32ToString(i));
        names.push(t + "v" + i32ToString(i));
      }
      sb.append(") = ").append(value).append(";\n");
    }
    for (var i = 0; i < ty.children.length; i += 1) {
      lowerMemStmts(sb, ty.children[i], names[i],
          displaced(ptrExpr, offsets[i]), indent, uses);
    }
    return;
  }
  if (ty.kind == TyKind.OptionT) {
    uses.option = true;
    uses.useAbi("storeU8");
    let inner = ty.children[0];
    let payoff = payloadOffset(ty);
    sb.append(indent).append("if (").append(value).append(" is Some<")
        .append(zenaTypeOf(inner, uses)).append(">) {\n");
    sb.append(indent).append("  storeU8(").append(ptrExpr)
        .append(", 1);\n");
    lowerMemStmts(sb, inner,
        "(" + value + " as Some<" + zenaTypeOf(inner, uses) + ">).value",
        displaced(ptrExpr, payoff), indent + "  ", uses);
    sb.append(indent).append("} else {\n");
    sb.append(indent).append("  storeU8(").append(ptrExpr)
        .append(", 0);\n");
    sb.append(indent).append("}\n");
    return;
  }
  // VariantT: an if chain over the sealed cases, each storing the
  // discriminant and its own payload layout.
  let payoff = payloadOffset(ty);
  for (var i = 0; i < ty.children.length; i += 1) {
    sb.append(indent);
    if (i > 0) { sb.append("} else "); }
    sb.append("if (").append(value).append(" is ")
        .append(ty.childNames[i]).append(") {\n");
    sb.append(indent).append("  ").append(storeCall(
        discSize(ty.caseCount), false, ptrExpr, i32ToString(i), uses))
        .append(";\n");
    if (!isVoid(ty.children[i])) {
      lowerMemStmts(sb, ty.children[i],
          "(" + value + " as " + ty.childNames[i] + ").value",
          displaced(ptrExpr, payoff), indent + "  ", uses);
    }
  }
  sb.append(indent).append("}\n");
}

/**
 * Stage a list value's element buffer: allocates `length * stride`
 * arena bytes, fills each element through `lowerMemStmts`, and hands
 * the buffer and count to `finish`. An empty list stages nothing and
 * passes `(0, 0)` — the canonical empty form, and `stageBuffer(0)`
 * would return an unowned sentinel.
 */
function emitListStaging(sb: StringBuilder, ty: Ty, value: String,
    indent: String, uses: SynthUses,
    finish: (buf: String, count: String) => void): void {
  let element = ty.children[0];
  uses.useAbi("stageBuffer");
  uses.stagedAny = true;
  let b = "b" + i32ToString(uses.nextTmp());
  let n = "n" + i32ToString(uses.nextTmp());
  let idx = "i" + i32ToString(uses.nextTmp());
  sb.append(indent).append("var ").append(b).append(" = 0;\n");
  sb.append(indent).append("let ").append(n).append(" = ")
      .append(value).append(".length;\n");
  sb.append(indent).append("if (").append(n).append(" > 0) {\n");
  sb.append(indent).append("  ").append(b).append(" = stageBuffer(")
      .append(n).append(" * ").append(i32ToString(element.size))
      .append(");\n");
  sb.append(indent).append("  for (var ").append(idx)
      .append(" = 0; ").append(idx).append(" < ").append(n)
      .append("; ").append(idx).append(" += 1) {\n");
  lowerMemStmts(sb, element, value + "[" + idx + "]",
      b + " + " + idx + " * " + i32ToString(element.size),
      indent + "    ", uses);
  sb.append(indent).append("  }\n");
  sb.append(indent).append("}\n");
  finish(b, n);
}

/**
 * Emit statements assigning `value`'s flattened form into the slot
 * variables `slots[base..]`; returns the number of slots consumed.
 * Unwritten slots keep their zero initializers, which is what an
 * absent option payload or a shorter variant arm leaves behind.
 */
function lowerFlatStmts(sb: StringBuilder, ty: Ty, value: String,
    slots: GrowableArray<String>, base: i32, indent: String,
    uses: SynthUses): i32 {
  if (ty.kind == TyKind.Scalar) {
    sb.append(indent).append(slots[base]).append(" = ")
        .append(castToCore(ty.scalar, value)).append(";\n");
    return 1;
  }
  if (ty.kind == TyKind.Enumeration) {
    sb.append(indent).append(slots[base]).append(" = (").append(value)
        .append(" as i32);\n");
    return 1;
  }
  if (ty.kind == TyKind.Flags) {
    sb.append(indent).append(slots[base]).append(" = ((").append(value)
        .append(" as u32) as i32);\n");
    return 1;
  }
  if (ty.kind == TyKind.ResourceH) {
    sb.append(indent).append(slots[base]).append(" = ").append(value)
        .append(".[rawHandle]();\n");
    if (!ty.isBorrow) {
      // An owned handle transfers to the callee: the wrapper's later
      // dispose must not drop an index it no longer owns.
      sb.append(indent).append(value).append(".[markMoved]();\n");
    }
    return 1;
  }
  if (ty.kind == TyKind.Str || ty.kind == TyKind.BytesList) {
    let stage = if (ty.kind == TyKind.Str) "stageString"
        else "stageByteList";
    uses.useAbi(stage);
    uses.stagedAny = true;
    let p = "p" + i32ToString(uses.nextTmp());
    let l = "l" + i32ToString(uses.nextTmp());
    sb.append(indent).append("let (").append(p).append(", ").append(l)
        .append(") = ").append(stage).append("(").append(value)
        .append(");\n");
    sb.append(indent).append(slots[base]).append(" = ").append(p)
        .append(";\n");
    sb.append(indent).append(slots[base + 1]).append(" = ").append(l)
        .append(";\n");
    return 2;
  }
  if (ty.kind == TyKind.ListT) {
    emitListStaging(sb, ty, value, indent, uses,
        (buf: String, count: String): void => {
      sb.append(indent).append(slots[base]).append(" = ").append(buf)
          .append(";\n");
      sb.append(indent).append(slots[base + 1]).append(" = ")
          .append(count).append(";\n");
    });
    return 2;
  }
  if (ty.kind == TyKind.RecordT) {
    var consumed = 0;
    for (var i = 0; i < ty.children.length; i += 1) {
      consumed += lowerFlatStmts(sb, ty.children[i],
          value + "." + ty.childNames[i], slots, base + consumed,
          indent, uses);
    }
    return consumed;
  }
  if (ty.kind == TyKind.TupleT) {
    let t = "t" + i32ToString(uses.nextTmp());
    sb.append(indent).append("let (");
    for (var i = 0; i < ty.children.length; i += 1) {
      if (i > 0) { sb.append(", "); }
      sb.append(t).append("v").append(i32ToString(i));
    }
    sb.append(") = ").append(value).append(";\n");
    var consumed = 0;
    for (var i = 0; i < ty.children.length; i += 1) {
      consumed += lowerFlatStmts(sb, ty.children[i],
          t + "v" + i32ToString(i), slots, base + consumed, indent,
          uses);
    }
    return consumed;
  }
  if (ty.kind == TyKind.OptionT) {
    uses.option = true;
    let inner = ty.children[0];
    sb.append(indent).append("if (").append(value).append(" is Some<")
        .append(zenaTypeOf(inner, uses)).append(">) {\n");
    sb.append(indent).append("  ").append(slots[base])
        .append(" = 1;\n");
    lowerFlatStmts(sb, inner,
        "(" + value + " as Some<" + zenaTypeOf(inner, uses) + ">).value",
        slots, base + 1, indent + "  ", uses);
    sb.append(indent).append("}\n");
    let total = flatCoreSlots(ty);
    return (total as GrowableArray<String>).length;
  }
  // VariantT: an if chain; every arm writes the discriminant and its
  // own prefix of the shared payload slots.
  for (var i = 0; i < ty.children.length; i += 1) {
    sb.append(indent);
    if (i > 0) { sb.append("} else "); }
    sb.append("if (").append(value).append(" is ")
        .append(ty.childNames[i]).append(") {\n");
    sb.append(indent).append("  ").append(slots[base]).append(" = ")
        .append(i32ToString(i)).append(";\n");
    if (!isVoid(ty.children[i])) {
      lowerFlatStmts(sb, ty.children[i],
          "(" + value + " as " + ty.childNames[i] + ").value", slots,
          base + 1, indent + "  ", uses);
    }
  }
  sb.append(indent).append("}\n");
  let total = flatCoreSlots(ty);
  return (total as GrowableArray<String>).length;
}

/** Emit the body of one registered lift helper. */
function emitLiftHelper(sb: StringBuilder, entry: LiftEntry,
    uses: SynthUses): void {
  let ty = entry.ty;
  sb.append("function ").append(entry.name).append("(ptr: i32): ")
      .append(zenaTypeOf(ty, uses)).append(" {\n");
  if (ty.kind == TyKind.RecordT || ty.kind == TyKind.TupleT) {
    let offsets = fieldOffsets(ty);
    var args = "";
    for (var i = 0; i < ty.children.length; i += 1) {
      if (i > 0) { args = args + ",\n      "; }
      args = args + liftExprOf(ty.children[i], atOffset(offsets[i]), uses);
    }
    if (ty.kind == TyKind.RecordT) {
      sb.append("  return new ").append(ty.typeName).append("(\n      ")
          .append(args).append(");\n");
    } else {
      sb.append("  return (\n      ").append(args).append(");\n");
    }
  } else if (ty.kind == TyKind.OptionT) {
    uses.option = true;
    let payoff = payloadOffset(ty);
    sb.append("  if (").append(discLoad(1, "ptr", uses))
        .append(" == 0) {\n    return none;\n  }\n  return some(")
        .append(liftExprOf(ty.children[0],
            "ptr + " + i32ToString(payoff), uses))
        .append(");\n");
  } else if (ty.kind == TyKind.VariantT) {
    uses.error = true;
    let payoff = payloadOffset(ty);
    sb.append("  let disc = ")
        .append(discLoad(discSize(ty.caseCount), "ptr", uses))
        .append(";\n");
    for (var i = 0; i < ty.children.length; i += 1) {
      sb.append("  if (disc == ").append(i32ToString(i))
          .append(") {\n    return new ").append(ty.childNames[i]);
      if (isVoid(ty.children[i])) {
        sb.append("();\n  }\n");
      } else {
        sb.append("(").append(liftExprOf(ty.children[i],
            "ptr + " + i32ToString(payoff), uses)).append(");\n  }\n");
      }
    }
    sb.append("  throw new Error('invalid ").append(ty.typeName)
        .append(" discriminant');\n");
  } else {
    // ListT: the elements are laid out back to back at the element
    // type's (already padding-inclusive) size, in a buffer that is
    // ours to free once the last element is lifted.
    let element = ty.children[0];
    uses.useAbi("loadI32");
    uses.useAbi("freeLifted");
    uses.array = true;
    sb.append("  let base = loadI32(ptr);\n");
    sb.append("  let count = loadI32(ptr + 4);\n");
    sb.append("  let out = new GrowableArray<")
        .append(zenaTypeOf(element, uses)).append(">();\n");
    sb.append("  for (var i = 0; i < count; i += 1) {\n");
    sb.append("    out.push(").append(liftExprOf(element,
        "base + i * " + i32ToString(element.size), uses))
        .append(");\n  }\n");
    sb.append("  if (count > 0) {\n    freeLifted(base);\n  }\n");
    sb.append("  return out;\n");
  }
  sb.append("}\n");
}

/**
 * A WIT `enum`, as a Zena enum: PascalCase members with explicit
 * ordinals, because the ordinal IS the wire discriminant and must not
 * drift from declaration order by accident.
 */
function renderEnum(sb: StringBuilder, td: TypeDef): void {
  let cases = td.enumCases as GrowableArray<EnumCaseDef>;
  sb.append("/** WIT `enum ").append(td.name.name).append("`. */\n");
  sb.append("export enum ").append(pascalName(td.name.name))
      .append(" {\n");
  for (var i = 0; i < cases.length; i += 1) {
    sb.append("  ").append(pascalName(cases[i].name.name)).append(" = ")
        .append(i32ToString(i)).append(",\n");
  }
  sb.append("}\n");
}

/**
 * A WIT `flags`, as a distinct u32 bitset with one constant per label
 * (`modes` with `read` → `modesRead`). Distinct rather than opaque:
 * combining flags is the caller's arithmetic, through `u32` casts.
 */
function renderFlags(sb: StringBuilder, td: TypeDef): void {
  let flags = td.flags as GrowableArray<FlagDef>;
  let typeName = pascalName(td.name.name);
  sb.append("/** WIT `flags ").append(td.name.name)
      .append("`, as a bitset. */\n");
  sb.append("export distinct type ").append(typeName)
      .append(" = u32;\n");
  for (var i = 0; i < flags.length; i += 1) {
    sb.append("export let ").append(camelName(td.name.name))
        .append(pascalName(flags[i].name.name)).append(" = (")
        .append(i32ToString(1 << i)).append(" as u32) as ")
        .append(typeName).append(";\n");
  }
}

/**
 * A WIT `resource`, as a Disposable handle-wrapping class: the class
 * owns the imported handle, methods and statics ride the same
 * marshaling machinery as free functions (a method's raw call leads
 * with the handle), a WIT constructor becomes `static create`, and
 * disposal is the canonical `resource.drop` — idempotent behind a
 * flag, because nothing prevents a double call until affine checking
 * covers these wrappers. Members that cannot render yet are skipped
 * per member; the class itself always renders, so a handle received
 * from elsewhere is at least holdable and droppable.
 */
function renderResource(
  body: StringBuilder,
  skipped: StringBuilder,
  td: TypeDef,
  interfaceName: String,
  ifaceItems: Array<InterfaceItem>,
  uses: SynthUses
): void {
  uses.anyResource = true;
  let resourceName = td.name.name;
  let typeName = pascalName(resourceName);
  let rawPrefix = camelName(resourceName);
  let members = new StringBuilder();
  let raws = new StringBuilder();
  let funcs = td.resourceFuncs;
  if (funcs != null) {
    for (let rf in funcs as GrowableArray<ResourceFunc>) {
      var mode = new FnMode("", "", "", "", false);
      var label = "";
      if (rf.tag == ResourceFuncTag.Constructor) {
        mode = new FnMode("[constructor]" + resourceName, "create",
            rawPrefix + "Create", "static ", false, resourceName);
        label = resourceName + " constructor";
      } else if (rf.tag == ResourceFuncTag.Static) {
        let fnName = rf.func.name.name;
        mode = new FnMode("[static]" + resourceName + "." + fnName,
            zenaMemberName(fnName), rawPrefix + pascalName(fnName),
            "static ", false);
        label = resourceName + "." + fnName;
      } else {
        let fnName = rf.func.name.name;
        mode = new FnMode("[method]" + resourceName + "." + fnName,
            zenaMemberName(fnName), rawPrefix + pascalName(fnName), "",
            true);
        label = resourceName + "." + fnName;
      }
      let reason = renderFuncIn(members, raws, rf.func, interfaceName,
          ifaceItems, uses, mode);
      if (reason != "") {
        skipped.append("//   ").append(label).append(": ")
            .append(reason).append("\n");
      }
    }
  }
  body.append("/** WIT `resource ").append(resourceName)
      .append("`. */\n");
  body.append("export final class ").append(typeName)
      .append(" implements Disposable {\n");
  body.append("  #handle: i32;\n");
  body.append("  var #dropped = false;\n");
  body.append("  new(handle: i32) : #handle = handle;\n\n");
  body.append("  /** The wire handle, module-internal. */\n");
  body.append("  [rawHandle](): i32 {\n    return this.#handle;\n");
  body.append("  }\n\n");
  body.append("  /** The handle transferred to the host (an own\n");
  body.append("   * parameter consumed it): dispose becomes a no-op,\n");
  body.append("   * because the callee owns the drop now. Until affine\n");
  body.append("   * checking covers these wrappers, a *use* after the\n");
  body.append("   * move is a runtime trap rather than a compile\n");
  body.append("   * error. */\n");
  body.append("  [markMoved](): void {\n");
  body.append("    this.#dropped = true;\n  }\n\n");
  body.append("  [Disposable.dispose](): void {\n");
  body.append("    if (!this.#dropped) {\n");
  body.append("      this.#dropped = true;\n");
  body.append("      ").append(rawPrefix).append("Drop_raw(this.#handle);\n");
  body.append("    }\n  }\n\n");
  body.append(members.toString());
  body.append("}\n");
  body.append("@external(\"canon\", \"resource.drop\", \"resource:")
      .append(interfaceName).append("#").append(resourceName)
      .append("\")\n");
  body.append("declare function ").append(rawPrefix)
      .append("Drop_raw(handle: i32): void;\n");
  body.append(raws.toString());
}

/** A WIT `record`, as a case class. */
function renderRecord(sb: StringBuilder, td: TypeDef,
    ifaceItems: Array<InterfaceItem>, uses: SynthUses): String {
  let ty = classifyNamed(td.name.name, ifaceItems);
  let blocked = liftBlocker(ty, false);
  if (blocked != "") {
    return blocked;
  }
  sb.append("/** WIT `record ").append(td.name.name).append("`. */\n");
  sb.append("export class ").append(ty.typeName).append("(");
  for (var i = 0; i < ty.children.length; i += 1) {
    if (i > 0) { sb.append(", "); }
    sb.append(ty.childNames[i]).append(": ")
        .append(zenaTypeOf(ty.children[i], uses));
  }
  sb.append(")\n");
  return "";
}

/** A WIT `variant`, as a sealed case-class hierarchy. */
function renderVariant(sb: StringBuilder, td: TypeDef,
    ifaceItems: Array<InterfaceItem>, uses: SynthUses): String {
  let ty = classifyNamed(td.name.name, ifaceItems);
  let blocked = liftBlocker(ty, false);
  if (blocked != "") {
    return blocked;
  }
  sb.append("/** WIT `variant ").append(td.name.name).append("`. */\n");
  sb.append("export sealed class ").append(ty.typeName).append(" {\n");
  for (var i = 0; i < ty.children.length; i += 1) {
    sb.append("  case ").append(ty.childNames[i]);
    if (!isVoid(ty.children[i])) {
      sb.append("(value: ").append(zenaTypeOf(ty.children[i], uses))
          .append(")");
    }
    sb.append("\n");
  }
  sb.append("}\n");
  return "";
}

/**
 * The synthesized Zena source for a `wit:<root>#<ns>:<iface-path>`
 * canonical path.
 */
export function synthesizeWitModule(canonicalPath: String): String {
  let rest = canonicalPath.sliceBytes(4, canonicalPath.length);
  var hash = -1;
  for (var i = 0; i < rest.length; i += 1) {
    if (rest.getByteAt(i) == 35) { // '#'
      hash = i;
    }
  }
  if (hash < 0) {
    throw new Error("Malformed WIT module path: " + canonicalPath);
  }
  let witRoot = rest.sliceBytes(0, hash);
  let spec = rest.sliceBytes(hash + 1, rest.length);
  var colon = -1;
  for (var i = 0; i < spec.length; i += 1) {
    if (spec.getByteAt(i) == 58) { // ':'
      colon = i;
      break;
    }
  }
  let namespace = spec.sliceBytes(0, colon);
  let interfacePath = spec.sliceBytes(colon + 1, spec.length);

  let ast = parse(readWitSource(witRoot));
  let iface = findInterface(ast, namespace, interfacePath);
  let version = iface.packageName.version;
  var interfaceName = namespace + ":" + interfacePath;
  if (version != null) {
    interfaceName = interfaceName + "@" + (version as String);
  }

  let sb = new StringBuilder();
  sb.append("// Synthesized from WIT: ").append(interfaceName)
      .append(". Do not edit.\n");
  let body = new StringBuilder();
  let skipped = new StringBuilder();
  let uses = new SynthUses();
  for (let item in iface.def.items) {
    if (item.tag != InterfaceItemTag.Func) {
      if (item.tag == InterfaceItemTag.TypeDef) {
        let td = item.typeDef as TypeDef;
        var reason = "";
        if (td.tag == TypeDefTag.Enum) {
          renderEnum(body, td);
        } else if (td.tag == TypeDefTag.Flags) {
          renderFlags(body, td);
        } else if (td.tag == TypeDefTag.Record) {
          reason = renderRecord(body, td, iface.def.items, uses);
        } else if (td.tag == TypeDefTag.Variant) {
          reason = renderVariant(body, td, iface.def.items, uses);
        } else if (td.tag == TypeDefTag.Resource) {
          renderResource(body, skipped, td, interfaceName,
              iface.def.items, uses);
        } else if (td.tag != TypeDefTag.Alias) {
          reason = "types wait on the interop stages";
        }
        if (reason != "") {
          skipped.append("//   ").append(td.name.name).append(": ")
              .append(reason).append("\n");
        }
      }
      continue;
    }
    let nf = item.func as NamedFunc;
    let rendered = renderFunc(body, nf, interfaceName, iface.def.items,
        uses);
    if (rendered != "") {
      skipped.append("//   ").append(nf.name.name).append(": ")
          .append(rendered).append("\n");
    }
  }
  // Lift helpers registered while rendering may register more as they
  // are emitted (a record's field lifting a nested option), so this
  // drains a worklist rather than walking a snapshot.
  while (uses.emittedLifts < uses.lifts.length) {
    let entry = uses.lifts[uses.emittedLifts];
    uses.emittedLifts += 1;
    emitLiftHelper(body, entry, uses);
  }
  for (let lifted in uses.enumLifts) {
    // The host is obligated to produce a valid discriminant, but a
    // range check is one compare, and an out-of-range value cast
    // silently into an enum would defeat exhaustive matching somewhere
    // far from here.
    body.append("function lift").append(lifted.typeName)
        .append("(disc: i32): ").append(lifted.typeName)
        .append(" {\n  if (disc < 0 || disc >= ")
        .append(i32ToString(lifted.caseCount))
        .append(") {\n    throw new Error('invalid ")
        .append(lifted.typeName).append(" discriminant');\n  }\n")
        .append("  return disc as ").append(lifted.typeName)
        .append(";\n}\n");
  }
  if (uses.fixedArray) {
    sb.append("import { FixedArray } from 'zena:fixed-array';\n");
  }
  if (uses.array) {
    sb.append("import { Array } from 'zena:array';\n");
  }
  if (uses.option) {
    sb.append("import { Option, Some, some, none } from 'zena:option';\n");
  }
  if (uses.result) {
    sb.append("import { Result } from 'zena:result';\n");
  }
  if (uses.outcome) {
    sb.append("import { Outcome, Ok, Err } from 'zena:result';\n");
  }
  if (uses.abi.length > 0) {
    sb.append("import { ");
    for (var i = 0; i < uses.abi.length; i += 1) {
      if (i > 0) { sb.append(", "); }
      sb.append(uses.abi[i]);
    }
    sb.append(" } from 'zena:component-abi';\n");
  }
  if (uses.anyResource) {
    sb.append("import { Disposable } from 'zena:ownership';\n");
  }
  if (uses.error) {
    sb.append("import { Error } from 'zena:error';\n");
  }
  if (uses.hasAsync) {
    sb.append("import { Future } from 'zena:async';\n");
    sb.append("import { awaitPacked } from 'zena:component-async';\n");
  }
  if (uses.anyResource) {
    // After the imports: a declaration among them is a parse error.
    sb.append("symbol rawHandle;\n");
    sb.append("symbol markMoved;\n");
  }
  sb.append(body.toString());
  let skippedText = skipped.toString();
  if (skippedText != "") {
    sb.append("// Not yet importable from this interface ")
        .append("(docs/design/component-model.md):\n")
        .append(skippedText);
  }
  return sb.toString();
}

/**
 * Render one function — a plain `@external` declaration when
 * everything is a flat scalar, a raw declaration plus a marshaling or
 * future wrapper otherwise — or return the reason it cannot be
 * rendered yet.
 */
/** How one WIT function renders: as a free function, or as a member
 * of a synthesized resource class. */
final class FnMode {
  /** The `@external` field name: the WIT name, or a mangled
   * `[method]r.f` / `[static]r.f` / `[constructor]r`. */
  externField: String;
  /** The Zena name of the wrapper. */
  zenaName: String;
  /** The raw declaration's name (module-level, so resource-prefixed). */
  rawName: String;
  /** The wrapper's declaration head: `"export function "` for a free
   * function, `""` for a method, `"static "` for a static or a WIT
   * constructor. */
  declHead: String;
  /** Whether the raw call leads with `this.#handle`. */
  selfHandle: boolean;
  /** A WIT constructor's implicit `own` result: the resource's WIT
   * name, or "" for everything else. */
  ctorResource: String;
  new(this.externField, this.zenaName, this.rawName, this.declHead,
      this.selfHandle, this.ctorResource = "");
}

/** Zena keywords a WIT name may collide with (`new: static func` is
 * real, in wasi:http); the member gets a trailing underscore, which no
 * other synthesized name contains. */
let zenaMemberName = (witName: String): String => {
  let camel = camelName(witName);
  if (camel == "new" || camel == "match" || camel == "let" ||
      camel == "var" || camel == "function" || camel == "return" ||
      camel == "this" || camel == "class" || camel == "enum" ||
      camel == "type" || camel == "import" || camel == "export" ||
      camel == "using" || camel == "true" || camel == "false" ||
      camel == "null" || camel == "if" || camel == "else" ||
      camel == "for" || camel == "while" || camel == "in" ||
      camel == "is" || camel == "as" || camel == "case") {
    return camel + "_";
  }
  return camel;
};

function renderFunc(
  sb: StringBuilder,
  nf: NamedFunc,
  interfaceName: String,
  ifaceItems: Array<InterfaceItem>,
  uses: SynthUses
): String {
  let zenaName = camelName(nf.name.name);
  return renderFuncIn(sb, sb, nf, interfaceName, ifaceItems, uses,
      new FnMode(nf.name.name, zenaName, zenaName, "export function ",
          false));
}

/**
 * Render one function into `wrapSink` (the wrapper) and `rawSink`
 * (the raw declaration — module level, which for a resource member is
 * a different sink than the class body). Returns the reason it cannot
 * be rendered yet, or "".
 */
function renderFuncIn(
  wrapSink: StringBuilder,
  rawSink: StringBuilder,
  nf: NamedFunc,
  interfaceName: String,
  ifaceItems: Array<InterfaceItem>,
  uses: SynthUses,
  mode: FnMode
): String {
  let func = nf.func;
  let params = new GrowableArray<Ty>();
  let paramNames = new GrowableArray<String>();
  var anyRich = false;
  for (var i = 0; i < func.params.length; i += 1) {
    let wire = classifyType(func.params[i].type, ifaceItems);
    if (wire.kind == TyKind.Unsupported) {
      return "parameter '" + func.params[i].name.name + "': " + wire.reason;
    }
    let blocked = lowerBlocker(wire);
    if (blocked != "") {
      return "parameter '" + func.params[i].name.name + "': " + blocked;
    }
    if (flatCoreSlots(wire) == null) {
      return "parameter '" + func.params[i].name.name +
          "': its variant payloads join across core types, which " +
          "waits on the interop stages";
    }
    if (wire.kind != TyKind.Scalar) {
      anyRich = true;
    }
    params.push(wire);
    paramNames.push(camelName(func.params[i].name.name));
  }
  var paramFlats = 0;
  for (let p in params) {
    paramFlats += (flatCoreSlots(p) as GrowableArray<String>).length;
  }
  if (paramFlats > 16) {
    return "parameters spilling past sixteen core values wait on the " +
        "interop stages";
  }
  var resultTy = voidTy();
  var hasResult = false;
  if (mode.ctorResource != "") {
    // A WIT constructor returns `own<resource>` implicitly.
    hasResult = true;
    resultTy = classifyNamed(mode.ctorResource, ifaceItems);
  }
  let result = func.result;
  if (result != null) {
    hasResult = true;
    resultTy = classifyType(result as Type, ifaceItems);
    if (resultTy.kind == TyKind.Unsupported) {
      return "the result: " + resultTy.reason;
    }
    let blocked = liftBlocker(resultTy, false);
    if (blocked != "") {
      return "the result: " + blocked;
    }
    if (resultTy.kind == TyKind.ResultT) {
      if (isVoid(resultTy.children[0]) || isVoid(resultTy.children[1])) {
        return "a bare result arm waits on zero-width Result lanes";
      }
    }
    if (resultTy.kind != TyKind.Scalar) {
      anyRich = true;
    }
    if (resultTy.flats == 1 && resultTy.kind != TyKind.Enumeration &&
        resultTy.kind != TyKind.Flags && resultTy.kind != TyKind.Scalar &&
        resultTy.kind != TyKind.ResourceH) {
      return "a single-flat aggregate result waits on the interop stages";
    }
  }
  let zenaName = mode.zenaName;
  let freeMode = mode.declHead == "export function " && !mode.selfHandle;

  if (func.isAsync) {
    if (!freeMode) {
      return "an async resource function waits on the interop stages";
    }
    // The async lowering flattens at most four core parameter values
    // before spilling all of them through one pointer, which is not
    // rendered yet.
    if (paramFlats > 4) {
      return "async parameters spilling past four core values wait " +
          "on the interop stages";
    }
    if (!anyRich && !hasResult) {
      // Flat scalars, no result: the thin form. The raw import's core
      // result is the packed `(subtask << 4) | state` the canonical
      // `async` lowering returns; `awaitPacked` turns it into the
      // future. The `_raw` suffix cannot collide with another
      // rendered function: WIT names are kebab-case, so no camelName
      // output contains an underscore.
      uses.hasAsync = true;
      let sig = new StringBuilder();
      let args = new StringBuilder();
      for (var i = 0; i < params.length; i += 1) {
        if (i > 0) {
          sig.append(", ");
          args.append(", ");
        }
        sig.append(paramNames[i]).append(": ").append(params[i].scalar);
        args.append(paramNames[i]);
      }
      rawSink.append("@external(\"").append(interfaceName)
          .append("\", \"").append(nf.name.name)
          .append("\", \"async\")\n");
      rawSink.append("declare function ").append(zenaName)
          .append("_raw(").append(sig.toString()).append("): i32;\n");
      rawSink.append("export function ").append(zenaName)
          .append("(").append(sig.toString())
          .append("): Future<void> {\n  return awaitPacked(")
          .append(zenaName).append("_raw(").append(args.toString())
          .append("));\n}\n");
      return "";
    }
    // Anything richer takes the general path below as an async
    // wrapper: stage, call, await the subtask, then lift the result
    // the host wrote through the trailing return area — an async
    // lowering spills any result, whatever its flat count.
  }

  // The result spills — the raw call takes a return area address and
  // returns nothing — exactly when it flattens to more than one core
  // value. An async result always spills.
  let resultSpills = if (func.isAsync) hasResult else resultTy.flats > 1;

  if (!anyRich && freeMode) {
    // Every type is a flat scalar: one declaration, no wrapper.
    let sig = new StringBuilder();
    for (var i = 0; i < params.length; i += 1) {
      if (i > 0) { sig.append(", "); }
      sig.append(paramNames[i]).append(": ").append(params[i].scalar);
    }
    rawSink.append("@external(\"").append(interfaceName).append("\", \"")
        .append(nf.name.name).append("\")\n");
    rawSink.append("export declare function ").append(zenaName)
        .append("(").append(sig.toString()).append("): ")
        .append(if (hasResult) resultTy.scalar else "void")
        .append(";\n");
    return "";
  }

  // The raw declaration: staged strings and lists are (ptr, len)
  // pairs, an aggregate is its flattened core slots, and a spilled
  // result appends the return area address.
  let aggregate = (kind: TyKind): boolean =>
      kind == TyKind.ListT || kind == TyKind.RecordT ||
      kind == TyKind.VariantT || kind == TyKind.OptionT ||
      kind == TyKind.TupleT;
  let rawSig = new StringBuilder();
  var rawIndex = 0;
  if (mode.selfHandle) {
    rawSig.append("self: i32");
    rawIndex += 1;
  }
  for (var i = 0; i < params.length; i += 1) {
    if (rawIndex > 0) { rawSig.append(", "); }
    if (params[i].kind == TyKind.Scalar) {
      rawSig.append("a").append(i32ToString(i)).append(": ")
          .append(params[i].scalar);
      rawIndex += 1;
    } else if (params[i].kind == TyKind.Enumeration) {
      rawSig.append("a").append(i32ToString(i)).append(": i32");
      rawIndex += 1;
    } else if (params[i].kind == TyKind.Flags) {
      rawSig.append("a").append(i32ToString(i)).append(": u32");
      rawIndex += 1;
    } else if (params[i].kind == TyKind.ResourceH) {
      rawSig.append("a").append(i32ToString(i)).append(": i32");
      rawIndex += 1;
    } else if (aggregate(params[i].kind)) {
      let slots = flatCoreSlots(params[i]) as GrowableArray<String>;
      for (var k = 0; k < slots.length; k += 1) {
        if (k > 0) { rawSig.append(", "); }
        rawSig.append("s").append(i32ToString(i)).append("_")
            .append(i32ToString(k)).append(": ").append(slots[k]);
      }
      rawIndex += slots.length;
    } else {
      rawSig.append("p").append(i32ToString(i)).append(": i32, l")
          .append(i32ToString(i)).append(": i32");
      rawIndex += 2;
    }
  }
  if (resultSpills) {
    if (rawIndex > 0) { rawSig.append(", "); }
    rawSig.append("ret: i32");
  }
  let rawResult = if (func.isAsync) {
    "i32"
  } else if (resultSpills || !hasResult) {
    "void"
  } else if (resultTy.kind == TyKind.Enumeration) {
    "i32"
  } else if (resultTy.kind == TyKind.Flags) {
    "u32"
  } else if (resultTy.kind == TyKind.ResourceH) {
    "i32"
  } else {
    resultTy.scalar
  };
  rawSink.append("@external(\"").append(interfaceName).append("\", \"")
      .append(mode.externField);
  if (func.isAsync) {
    rawSink.append("\", \"async");
  }
  rawSink.append("\")\n");
  rawSink.append("declare function ").append(mode.rawName)
      .append("_raw(").append(rawSig.toString()).append("): ")
      .append(rawResult).append(";\n");

  // The wrapper: the WIT signature in Zena spellings, staging in,
  // lifting out. Built into its own buffer so a member wrapper can be
  // reindented into the class body.
  let sb = new StringBuilder();
  let wrapSig = new StringBuilder();
  for (var i = 0; i < params.length; i += 1) {
    if (i > 0) { wrapSig.append(", "); }
    wrapSig.append(paramNames[i]).append(": ")
        .append(zenaTypeOf(params[i], uses));
  }
  var wrapResult = "void";
  if (hasResult) {
    if (resultTy.kind == TyKind.ResultT) {
      if (func.isAsync) {
        // A future's payload must be storable, which the inline
        // Result is not (return-position-only): the async form
        // carries Outcome, its heap counterpart.
        uses.outcome = true;
        wrapResult = "Outcome<" +
            zenaTypeOf(resultTy.children[0], uses) + ", " +
            zenaTypeOf(resultTy.children[1], uses) + ">";
      } else {
        uses.result = true;
        wrapResult = "Result<" +
            zenaTypeOf(resultTy.children[0], uses) + ", " +
            zenaTypeOf(resultTy.children[1], uses) + ">";
      }
    } else {
      wrapResult = zenaTypeOf(resultTy, uses);
    }
  }
  var declHead = mode.declHead;
  if (func.isAsync) {
    uses.hasAsync = true;
    declHead = "export async function ";
    wrapResult = "Future<" + wrapResult + ">";
  }
  sb.append(declHead).append(zenaName).append("(")
      .append(wrapSig.toString()).append("): ").append(wrapResult)
      .append(" {\n");
  // Release is by arena range: an async wrapper suspended on its
  // subtask still owns live staging (the callee may lift arguments
  // after the call returns), so each wrapper frees exactly what it
  // staged and nothing an interleaved wrapper still owes.
  var anyStaging = false;
  for (let p in params) {
    if (mayStage(p)) {
      anyStaging = true;
    }
  }
  if (anyStaging) {
    uses.useAbi("stagedMark");
    uses.useAbi("releaseStagedFrom");
    sb.append("  let m0 = stagedMark();\n");
  }
  let callArgs = new StringBuilder();
  var argIndex = 0;
  for (var i = 0; i < params.length; i += 1) {
    if (argIndex > 0) { callArgs.append(", "); }
    if (params[i].kind == TyKind.Scalar) {
      callArgs.append(paramNames[i]);
      argIndex += 1;
      continue;
    }
    if (params[i].kind == TyKind.Enumeration) {
      callArgs.append(paramNames[i]).append(" as i32");
      argIndex += 1;
      continue;
    }
    if (params[i].kind == TyKind.Flags) {
      callArgs.append(paramNames[i]).append(" as u32");
      argIndex += 1;
      continue;
    }
    if (params[i].kind == TyKind.ResourceH) {
      let h = "h" + i32ToString(i);
      sb.append("  let ").append(h).append(" = ").append(paramNames[i])
          .append(".[rawHandle]();\n");
      if (!params[i].isBorrow) {
        // An owned handle transfers to the callee: the wrapper's
        // later dispose must not drop an index it no longer owns.
        sb.append("  ").append(paramNames[i])
            .append(".[markMoved]();\n");
      }
      callArgs.append(h);
      argIndex += 1;
      continue;
    }
    if (aggregate(params[i].kind)) {
      // Zero-initialized slot variables, then the lowering statements:
      // an untaken option or a shorter variant arm leaves its slots at
      // zero, which the canonical ABI never reads.
      let slots = flatCoreSlots(params[i]) as GrowableArray<String>;
      let slotNames = new GrowableArray<String>();
      for (var k = 0; k < slots.length; k += 1) {
        let slotName = "s" + i32ToString(i) + "_" + i32ToString(k);
        slotNames.push(slotName);
        let zero = if (slots[k] == "f32" || slots[k] == "f64") "0.0"
            else "0";
        sb.append("  var ").append(slotName).append(": ")
            .append(slots[k]).append(" = ").append(zero).append(";\n");
      }
      lowerFlatStmts(sb, params[i], paramNames[i], slotNames, 0, "  ",
          uses);
      for (var k = 0; k < slotNames.length; k += 1) {
        if (k > 0) { callArgs.append(", "); }
        callArgs.append(slotNames[k]);
      }
      argIndex += slotNames.length;
      continue;
    }
    let stage = if (params[i].kind == TyKind.Str) {
      "stageString"
    } else {
      "stageByteList"
    };
    uses.useAbi(stage);
    uses.stagedAny = true;
    sb.append("  let (p").append(i32ToString(i)).append(", l")
        .append(i32ToString(i)).append(") = ").append(stage)
        .append("(").append(paramNames[i]).append(");\n");
    callArgs.append("p").append(i32ToString(i)).append(", l")
        .append(i32ToString(i));
    argIndex += 2;
  }
  if (resultSpills) {
    uses.useAbi("resultArea");
    sb.append("  let ret = resultArea(")
        .append(i32ToString(resultTy.size)).append(");\n");
    if (argIndex > 0) { callArgs.append(", "); }
    callArgs.append("ret");
  }
  var callPrefix = "";
  if (mode.selfHandle) {
    callPrefix = if (callArgs.toString() == "") "this.#handle"
        else "this.#handle, ";
  }
  let call = mode.rawName + "_raw(" + callPrefix + callArgs.toString() +
      ")";
  if (func.isAsync) {
    // The call hands back the packed subtask; the await parks until
    // the host reports it returned — which is also when the trailing
    // return area holds the result and the staged arguments are
    // certainly consumed.
    sb.append("  let packed = ").append(call).append(";\n");
    sb.append("  await awaitPacked(packed);\n");
  } else if (resultSpills || rawResult == "void") {
    sb.append("  ").append(call).append(";\n");
  } else {
    sb.append("  let got = ").append(call).append(";\n");
  }
  // A synchronous lowering consumed the staged arguments during the
  // call; an asynchronous one has by the time the subtask returned.
  if (anyStaging) {
    sb.append("  releaseStagedFrom(m0);\n");
  }
  if (resultSpills) {
    uses.useAbi("freeLifted");
    if (resultTy.kind == TyKind.ResultT) {
      // A top-level result lifts into the inline Result — or, from an
      // async wrapper, into Outcome, because a future's payload must
      // be storable and the inline form is return-position-only.
      let payoff = payloadOffset(resultTy);
      let okZ = zenaTypeOf(resultTy.children[0], uses);
      let errZ = zenaTypeOf(resultTy.children[1], uses);
      sb.append("  if (").append(discLoad(1, "ret", uses))
          .append(" == 0) {\n    let ok = ")
          .append(liftExprOf(resultTy.children[0],
              "ret + " + i32ToString(payoff), uses))
          .append(";\n    freeLifted(ret);\n");
      if (func.isAsync) {
        sb.append("    return new Ok<").append(okZ).append(", ")
            .append(errZ).append(">(ok);\n  }\n");
      } else {
        sb.append("    return (true, ok, _);\n  }\n");
      }
      sb.append("  let err = ")
          .append(liftExprOf(resultTy.children[1],
              "ret + " + i32ToString(payoff), uses))
          .append(";\n  freeLifted(ret);\n");
      if (func.isAsync) {
        sb.append("  return new Err<").append(okZ).append(", ")
            .append(errZ).append(">(err);\n");
      } else {
        sb.append("  return (false, _, err);\n");
      }
    } else {
      sb.append("  let out = ")
          .append(liftExprOf(resultTy, "ret", uses)).append(";\n");
      sb.append("  freeLifted(ret);\n");
      sb.append("  return out;\n");
    }
  } else if (resultTy.kind == TyKind.Enumeration) {
    uses.needEnumLift(resultTy);
    sb.append("  return lift").append(resultTy.typeName)
        .append("(got);\n");
  } else if (resultTy.kind == TyKind.Flags) {
    sb.append("  return got as ").append(resultTy.typeName)
        .append(";\n");
  } else if (resultTy.kind == TyKind.ResourceH) {
    sb.append("  return new ").append(resultTy.typeName)
        .append("(got);\n");
  } else if (!func.isAsync && rawResult != "void") {
    sb.append("  return got;\n");
  }
  sb.append("}\n");
  if (freeMode) {
    wrapSink.append(sb.toString());
  } else {
    // A member: two spaces onto every non-empty line.
    for (let line in sb.toString().split("\n")) {
      if (line != "") {
        wrapSink.append("  ").append(line);
      }
      wrapSink.append("\n");
    }
  }
  return "";
}
