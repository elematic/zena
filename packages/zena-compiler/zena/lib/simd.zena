  add('i32x4.ge_u', 0x40, SimdShape.Binary, SimdResult.V128, -1);
  add('i64x2.eq', 0xD6, SimdShape.Binary, SimdResult.V128, -1);
  add('i64x2.ne', 0xD7, SimdShape.Binary, SimdResult.V128, -1);
  add('i64x2.lt_s', 0xD8, SimdShape.Binary, SimdResult.V128, -1);
