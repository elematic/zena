  add('f32x4.trunc', 0x69, SimdShape.Unary, SimdResult.V128, -1);
  add('f32x4.nearest', 0x6A, SimdShape.Unary, SimdResult.V128, -1);
  add('f32x4.abs', 0xE0, SimdShape.Unary, SimdResult.V128, -1);
  add('f32x4.neg', 0xE1, SimdShape.Unary, SimdResult.V128, -1);
  add('f32x4.sqrt', 0xE3, SimdShape.Unary, SimdResult.V128, -1);
  add('f32x4.add', 0xE4, SimdShape.Binary, SimdResult.V128, -1);
  add('f32x4.sub', 0xE5, SimdShape.Binary, SimdResult.V128, -1);
  add('f32x4.mul', 0xE6, SimdShape.Binary, SimdResult.V128, -1);
  add('f32x4.div', 0xE7, SimdShape.Binary, SimdResult.V128, -1);
  add('f32x4.min', 0xE8, SimdShape.Binary, SimdResult.V128, -1);
  add('f32x4.max', 0xE9, SimdShape.Binary, SimdResult.V128, -1);
  add('f32x4.pmin', 0xEA, SimdShape.Binary, SimdResult.V128, -1);
  add('f32x4.pmax', 0xEB, SimdShape.Binary, SimdResult.V128, -1);
  add('f64x2.ceil', 0x74, SimdShape.Unary, SimdResult.V128, -1);
  add('f64x2.floor', 0x75, SimdShape.Unary, SimdResult.V128, -1);
  add('f64x2.trunc', 0x7A, SimdShape.Unary, SimdResult.V128, -1);
  add('f64x2.nearest', 0x94, SimdShape.Unary, SimdResult.V128, -1);
  add('f64x2.abs', 0xEC, SimdShape.Unary, SimdResult.V128, -1);
  add('f64x2.neg', 0xED, SimdShape.Unary, SimdResult.V128, -1);
  add('f64x2.sqrt', 0xEF, SimdShape.Unary, SimdResult.V128, -1);
  add('f64x2.add', 0xF0, SimdShape.Binary, SimdResult.V128, -1);
  add('f64x2.sub', 0xF1, SimdShape.Binary, SimdResult.V128, -1);
  add('f64x2.mul', 0xF2, SimdShape.Binary, SimdResult.V128, -1);
  add('f64x2.div', 0xF3, SimdShape.Binary, SimdResult.V128, -1);
  add('f64x2.min', 0xF4, SimdShape.Binary, SimdResult.V128, -1);
  add('f64x2.max', 0xF5, SimdShape.Binary, SimdResult.V128, -1);
  add('f64x2.pmin', 0xF6, SimdShape.Binary, SimdResult.V128, -1);
  add('f64x2.pmax', 0xF7, SimdShape.Binary, SimdResult.V128, -1);
  add('i32x4.trunc_sat_f32x4_s', 0xF8, SimdShape.Unary, SimdResult.V128, -1);
  add('i32x4.trunc_sat_f32x4_u', 0xF9, SimdShape.Unary, SimdResult.V128, -1);
  add('f32x4.convert_i32x4_s', 0xFA, SimdShape.Unary, SimdResult.V128, -1);
  add('f32x4.convert_i32x4_u', 0xFB, SimdShape.Unary, SimdResult.V128, -1);
  add('i32x4.trunc_sat_f64x2_s_zero', 0xFC, SimdShape.Unary, SimdResult.V128, -1);
  add('i32x4.trunc_sat_f64x2_u_zero', 0xFD, SimdShape.Unary, SimdResult.V128, -1);
  add('f64x2.convert_low_i32x4_s', 0xFE, SimdShape.Unary, SimdResult.V128, -1);
  add('f64x2.convert_low_i32x4_u', 0xFF, SimdShape.Unary, SimdResult.V128, -1);
  add('f32x4.demote_f64x2_zero', 0x5E, SimdShape.Unary, SimdResult.V128, -1);
  add('f64x2.promote_low_f32x4', 0x5F, SimdShape.Unary, SimdResult.V128, -1);
  byOpcode = byOp;
  return t;
};

/** The name index, built on first use. */
let nameIndex = (): HashMap<String, SimdInstruction> => {
  var t = table;
  if (t == null) {
    t = buildTable();
    table = t;
  }
  return t;
};

/**
 * The instruction named `name`, or null if it is not a SIMD instruction.
 * A null answer is the caller's cue to keep looking, not an error.
 */
export let simdInstruction = (name: String): SimdInstruction | null => {
  if (let (true, instr) = nameIndex().get(name)) {
    return instr;
  }
  return null;
};

/**
 * The wasm name of the instruction with this opcode. Only the WAT
 * emitter and the ZIR printer need this direction, and both are
 * printing something a human will read, so an unknown opcode formats as
 * itself rather than throwing mid-dump.
 */
export let simdName = (opcode: i32): String => {
  nameIndex();
  let m = byOpcode;
  if (m != null) {
    if (let (true, instr) = m.get(opcode)) {
      return instr.name;
    }
  }
  return 'simd:' + i32ToString(opcode);
};

/**
 * How many lanes `instr` sees the vector as having — the bound its lane
 * immediate must fall under. The lane-MEMORY instructions name the lane
 * width (`v128.load32_lane` moves one of four 32-bit lanes) while the
 * lane-ACCESS ones name the shape (`i32x4.extract_lane`), so the count
 * is read from whichever the name carries.
 *
 * `i8x16.shuffle` is not here: its sixteen selectors index the
 * CONCATENATION of two vectors, so they run to 32 and are bounded at
 * the call site instead.
 */
export let simdLaneCount = (instr: SimdInstruction): i32 => {
  let n = instr.name;
  if (n.startsWith('v128.load8_') || n.startsWith('v128.store8_') ||
      n.startsWith('i8x16')) {
    return 16;
  }
  if (n.startsWith('v128.load16_') || n.startsWith('v128.store16_') ||
      n.startsWith('i16x8')) {
    return 8;
  }
  if (n.startsWith('v128.load32_') || n.startsWith('v128.store32_') ||
      n.startsWith('i32x4') || n.startsWith('f32x4')) {
    return 4;
  }
  return 2;
};

/** How many arguments a call to `instr` must supply. */
export let simdArgCount = (instr: SimdInstruction): i32 => match (instr.shape) {
  case SimdShape.Unary: 1
  case SimdShape.Binary: 2
  case SimdShape.Ternary: 3
  case SimdShape.ExtractLane: 2
  case SimdShape.ReplaceLane: 3
  case SimdShape.Load: 1
  case SimdShape.Store: 2
  case SimdShape.LoadLane: 3
  case SimdShape.StoreLane: 3
  case SimdShape.Const: 4
  case SimdShape.Shuffle: 18
};
