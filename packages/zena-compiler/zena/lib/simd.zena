/**
 * The fixed-width WebAssembly SIMD instruction set: the one place that
 * knows an instruction's opcode, operand shape, result type and natural
 * alignment. Both the `@intrinsic` name validator (intrinsics.zena) and
 * the ZIR lowering router (codegen/ir/intrinsics.zena) read this table,
 * so a name that type-checks is a name that lowers.
 *
 * Every row was read back out of an assembled module rather than
 * transcribed: one function per instruction, assembled with wasm-tools,
 * and the `0xFD`-prefixed opcode and memarg alignment taken from the
 * disassembly. See docs/design/simd.md.
 *
 * Relaxed SIMD is deliberately absent. Its instructions are
 * non-deterministic by design and off by default in the engines Zena
 * targets, so they need their own decision rather than a row here.
 */
import { HashMap } from 'zena:map';
import { String } from 'zena:string';
import { i32ToString } from 'zena:string-convert';

/**
 * How an instruction's operands and immediates are laid out. The shape
 * decides which ZIR op carries it and how many arguments the intrinsic
 * call must supply — the opcode alone does not.
 */
export enum SimdShape {
  /** One v128 (or scalar, for the splats) operand. */
  Unary,
  /** Two operands: v128 pairs, the shifts' (v128, i32), swizzle. */
  Binary,
  /** Three v128 operands. Only `v128.bitselect`. */
  Ternary,
  /** `(vec, lane)` — the lane index is an immediate, so it must be a literal. */
  ExtractLane,
  /** `(vec, lane, value)` — lane immediate, value operand. */
  ReplaceLane,
  /** `(ptr)` — the memarg is the compiler's, not the caller's. */
  Load,
  /** `(ptr, value)`. */
  Store,
  /** `(ptr, vec, lane)`. */
  LoadLane,
  /** `(ptr, vec, lane)`. */
  StoreLane,
  /** `(lane0, lane1, lane2, lane3)` i32 literals — 16 immediate bytes. */
  Const,
  /** `(a, b, l0..l15)` — two operands and sixteen lane literals. */
  Shuffle,
}

/** The wasm value type an instruction leaves on the stack. */
export enum SimdResult {
  V128,
  I32,
  I64,
  F32,
  F64,
  Void,
}

/** One row of the instruction table. */
export final class SimdInstruction {
  /** The wasm name, e.g. `i32x4.add`. */
  name: String;
  /** The opcode following the `0xFD` prefix, encoded as a ULEB128. */
  opcode: i32;
  shape: SimdShape;
  result: SimdResult;
  /** log2 of the natural alignment, or -1 for a non-memory instruction. */
  align: i32;

  new(this.name, this.opcode, this.shape, this.result, this.align);
}

var table: HashMap<String, SimdInstruction> | null = null;
var byOpcode: HashMap<i32, SimdInstruction> | null = null;

/**
 * Fills both indexes on first use. They are built together so a row can
 * only ever be in both or neither — the opcode index is the same rows
 * read the other way, not a second list to keep in step.
 */
let buildTable = (): HashMap<String, SimdInstruction> => {
  let t = new HashMap<String, SimdInstruction>();
  let byOp = new HashMap<i32, SimdInstruction>();
  let add = (name: String, opcode: i32, shape: SimdShape, result: SimdResult,
      align: i32): void => {
    let instr = new SimdInstruction(name, opcode, shape, result, align);
    t[name] = instr;
    byOp[opcode] = instr;
  };
  add('v128.load', 0x00, SimdShape.Load, SimdResult.V128, 4);
  add('v128.load8x8_s', 0x01, SimdShape.Load, SimdResult.V128, 3);
  add('v128.load8x8_u', 0x02, SimdShape.Load, SimdResult.V128, 3);
  add('v128.load16x4_s', 0x03, SimdShape.Load, SimdResult.V128, 3);
  add('v128.load16x4_u', 0x04, SimdShape.Load, SimdResult.V128, 3);
  add('v128.load32x2_s', 0x05, SimdShape.Load, SimdResult.V128, 3);
  add('v128.load32x2_u', 0x06, SimdShape.Load, SimdResult.V128, 3);
  add('v128.load8_splat', 0x07, SimdShape.Load, SimdResult.V128, 0);
  add('v128.load16_splat', 0x08, SimdShape.Load, SimdResult.V128, 1);
  add('v128.load32_splat', 0x09, SimdShape.Load, SimdResult.V128, 2);
  add('v128.load64_splat', 0x0A, SimdShape.Load, SimdResult.V128, 3);
  add('v128.load32_zero', 0x5C, SimdShape.Load, SimdResult.V128, 2);
  add('v128.load64_zero', 0x5D, SimdShape.Load, SimdResult.V128, 3);
  add('v128.store', 0x0B, SimdShape.Store, SimdResult.Void, 4);
  add('v128.load8_lane', 0x54, SimdShape.LoadLane, SimdResult.V128, 0);
  add('v128.load16_lane', 0x55, SimdShape.LoadLane, SimdResult.V128, 1);
  add('v128.load32_lane', 0x56, SimdShape.LoadLane, SimdResult.V128, 2);
  add('v128.load64_lane', 0x57, SimdShape.LoadLane, SimdResult.V128, 3);
  add('v128.store8_lane', 0x58, SimdShape.StoreLane, SimdResult.Void, 0);
  add('v128.store16_lane', 0x59, SimdShape.StoreLane, SimdResult.Void, 1);
  add('v128.store32_lane', 0x5A, SimdShape.StoreLane, SimdResult.Void, 2);
  add('v128.store64_lane', 0x5B, SimdShape.StoreLane, SimdResult.Void, 3);
  add('v128.const', 0x0C, SimdShape.Const, SimdResult.V128, -1);
  add('i8x16.shuffle', 0x0D, SimdShape.Shuffle, SimdResult.V128, -1);
  add('i8x16.swizzle', 0x0E, SimdShape.Binary, SimdResult.V128, -1);
  add('i8x16.splat', 0x0F, SimdShape.Unary, SimdResult.V128, -1);
  add('i16x8.splat', 0x10, SimdShape.Unary, SimdResult.V128, -1);
  add('i32x4.splat', 0x11, SimdShape.Unary, SimdResult.V128, -1);
  add('i64x2.splat', 0x12, SimdShape.Unary, SimdResult.V128, -1);
  add('f32x4.splat', 0x13, SimdShape.Unary, SimdResult.V128, -1);
  add('f64x2.splat', 0x14, SimdShape.Unary, SimdResult.V128, -1);
  add('i8x16.extract_lane_s', 0x15, SimdShape.ExtractLane, SimdResult.I32, -1);
  add('i8x16.extract_lane_u', 0x16, SimdShape.ExtractLane, SimdResult.I32, -1);
  add('i8x16.replace_lane', 0x17, SimdShape.ReplaceLane, SimdResult.V128, -1);
  add('i16x8.extract_lane_s', 0x18, SimdShape.ExtractLane, SimdResult.I32, -1);
  add('i16x8.extract_lane_u', 0x19, SimdShape.ExtractLane, SimdResult.I32, -1);
  add('i16x8.replace_lane', 0x1A, SimdShape.ReplaceLane, SimdResult.V128, -1);
  add('i32x4.extract_lane', 0x1B, SimdShape.ExtractLane, SimdResult.I32, -1);
  add('i32x4.replace_lane', 0x1C, SimdShape.ReplaceLane, SimdResult.V128, -1);
  add('i64x2.extract_lane', 0x1D, SimdShape.ExtractLane, SimdResult.I64, -1);
  add('i64x2.replace_lane', 0x1E, SimdShape.ReplaceLane, SimdResult.V128, -1);
  add('f32x4.extract_lane', 0x1F, SimdShape.ExtractLane, SimdResult.F32, -1);
  add('f32x4.replace_lane', 0x20, SimdShape.ReplaceLane, SimdResult.V128, -1);
  add('f64x2.extract_lane', 0x21, SimdShape.ExtractLane, SimdResult.F64, -1);
  add('f64x2.replace_lane', 0x22, SimdShape.ReplaceLane, SimdResult.V128, -1);
  add('i8x16.eq', 0x23, SimdShape.Binary, SimdResult.V128, -1);
  add('i8x16.ne', 0x24, SimdShape.Binary, SimdResult.V128, -1);
  add('i8x16.lt_s', 0x25, SimdShape.Binary, SimdResult.V128, -1);
  add('i8x16.lt_u', 0x26, SimdShape.Binary, SimdResult.V128, -1);
  add('i8x16.gt_s', 0x27, SimdShape.Binary, SimdResult.V128, -1);
  add('i8x16.gt_u', 0x28, SimdShape.Binary, SimdResult.V128, -1);
  add('i8x16.le_s', 0x29, SimdShape.Binary, SimdResult.V128, -1);
  add('i8x16.le_u', 0x2A, SimdShape.Binary, SimdResult.V128, -1);
  add('i8x16.ge_s', 0x2B, SimdShape.Binary, SimdResult.V128, -1);
  add('i8x16.ge_u', 0x2C, SimdShape.Binary, SimdResult.V128, -1);
  add('i16x8.eq', 0x2D, SimdShape.Binary, SimdResult.V128, -1);
  add('i16x8.ne', 0x2E, SimdShape.Binary, SimdResult.V128, -1);
  add('i16x8.lt_s', 0x2F, SimdShape.Binary, SimdResult.V128, -1);
  add('i16x8.lt_u', 0x30, SimdShape.Binary, SimdResult.V128, -1);
  add('i16x8.gt_s', 0x31, SimdShape.Binary, SimdResult.V128, -1);
  add('i16x8.gt_u', 0x32, SimdShape.Binary, SimdResult.V128, -1);
  add('i16x8.le_s', 0x33, SimdShape.Binary, SimdResult.V128, -1);
  add('i16x8.le_u', 0x34, SimdShape.Binary, SimdResult.V128, -1);
  add('i16x8.ge_s', 0x35, SimdShape.Binary, SimdResult.V128, -1);
  add('i16x8.ge_u', 0x36, SimdShape.Binary, SimdResult.V128, -1);
  add('i32x4.eq', 0x37, SimdShape.Binary, SimdResult.V128, -1);
