  add('f32x4.eq', 0x41, SimdShape.Binary, SimdResult.V128, -1);
  add('f32x4.ne', 0x42, SimdShape.Binary, SimdResult.V128, -1);
  add('f32x4.lt', 0x43, SimdShape.Binary, SimdResult.V128, -1);
  add('f32x4.gt', 0x44, SimdShape.Binary, SimdResult.V128, -1);
  add('f32x4.le', 0x45, SimdShape.Binary, SimdResult.V128, -1);
