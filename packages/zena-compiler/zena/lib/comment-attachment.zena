/**
 * Comment Attachment — assigns each comment to the nearest AST node.
 *
 * Implements Babel-style comment attachment: for every comment we find the
 * enclosing node list (module body, class body, block body) and decide:
 *   - Leading:   comment before the following node
 *   - Trailing:  comment on the same line as the preceding node's end
 *   - Inner:     comment inside an empty body (no preceding/following node)
 *
 * File-level comments: comments at the start of a file that are followed by
 * a blank line are attached as leading on the Module, not on the first
 * declaration. Comments without a blank line separator are leading on the
 * first declaration.
 *
 * The result is a CommentMap keyed by Node reference that any tool can query.
 */

import { NodeMap } from './node-map.zena';
import {
  Comment, Node, Module, Statement, Expression, BlockStatement, ClassDeclaration, InterfaceDeclaration, MixinDeclaration, EnumDeclaration, EnumMember, VariableDeclaration, FunctionDeclaration, FunctionExpression, BinaryExpression, UnaryExpression, AssignmentExpression, CallExpression, MemberExpression, IndexExpression, NewExpression, ArrayLiteral, IfExpression, MatchExpression, MatchCase, AsExpression, IsExpression, SpreadElement, IfStatement, WhileStatement, ForStatement, ForInStatement, ReturnStatement, YieldStatement, ExpressionStatement, UsingStatement, ShieldedStatement, MethodDefinition, AccessorDeclaration, SetterInfo, FieldDefinition,
} from './ast.zena';
import { growable } from 'zena:core';

/**
 * A collection of comments that maps AST nodes to their attached comments
 */
export final class CommentMap {
  // Keyed by NodeId (via NodeMap): node ids are assigned during parse, and id
  // keys give identity semantics with a real hash — Node itself is not
  // Hashable.
  #leading = new NodeMap<GrowableArray<Comment>>();
  #trailing = new NodeMap<GrowableArray<Comment>>();
  #inner = new NodeMap<GrowableArray<Comment>>();

  addLeading(node: Node, comment: Comment) {
    if (!this.#leading.has(node)) {
      this.#leading[node] = new Array<Comment>(2);
    }
    this.#leading[node].push(comment);
  }

  addTrailing(node: Node, comment: Comment) {
    if (!this.#trailing.has(node)) {
      this.#trailing[node] = new Array<Comment>(2);
    }
    this.#trailing[node].push(comment);
  }

  addInner(node: Node, comment: Comment) {
    if (!this.#inner.has(node)) {
      this.#inner[node] = new Array<Comment>(2);
    }
    this.#inner[node].push(comment);
  }

  getLeading(node: Node): GrowableArray<Comment> | null {
    if (this.#leading.has(node)) {
      return this.#leading[node];
    }
    return null;
  }

  getTrailing(node: Node): GrowableArray<Comment> | null {
    if (this.#trailing.has(node)) {
      return this.#trailing[node];
    }
    return null;
  }

  getInner(node: Node): GrowableArray<Comment> | null {
    if (this.#inner.has(node)) {
      return this.#inner[node];
    }
    return null;
  }
}

function getNodeStart(node: Node): i32 {
  let loc = node.loc;
  if (loc != null) {
    return loc.start;
  }
  return 0 - 1;
}

function getNodeEnd(node: Node): i32 {
  let loc = node.loc;
  if (loc != null) {
    return loc.end;
  }
  return 0 - 1;
}

function getNodeEndLine(source: String, node: Node): i32 {
  let loc = node.loc;
  if (loc == null) { return 0 - 1; }
  let {end} = loc;
  var line = 1;
  var i = 0;
  while (i < end && i < source.length) {
    if (source.getByteAt(i) == 10) {
      line += 1;
    }
    i += 1;
  }
  return line;
}

/**
 * Check if there is a blank line (two newlines with only whitespace between)
 * in the source text between positions `from` (exclusive) and `to` (exclusive).
 */
function hasBlankLineBetween(source: String, from: i32, to: i32): boolean {
  var newlineCount = 0;
  var i = from;
  while (i < to && i < source.length) {
    let ch = source.getByteAt(i);
    if (ch == 10) { // \n
      newlineCount += 1;
      if (newlineCount >= 2) { return true; }
    } else if (ch != 13 && ch != 32 && ch != 9) { // not \r, space, tab
      // Non-whitespace resets the counter
      newlineCount = 0;
    }
    i += 1;
  }
  return false;
}

/** Convert Array<Statement> to Array<Node> (WASM-GC arrays are invariant). */
function statementsToNodes(stmts: GrowableArray<Statement>) {
  let result = new Array<Node>(stmts.length);
  var i = 0;
  while (i < stmts.length) {
    result.push(stmts[i]);
    i += 1;
  }
  return result;
}


/** Convert Array<EnumMember> to Array<Node> (WASM-GC arrays are invariant). */
function enumMembersToNodes(members: GrowableArray<EnumMember>) {
  let result = new Array<Node>(members.length);
  var i = 0;
  while (i < members.length) {
    result.push(members[i]);
    i += 1;
  }
  return result;
}

/**
 * Wrap a single node as a one-element Array<Node>.
 */
function singleNode(node: Node) {
  let arr = growable<Node>([node]);
  return arr;
}

/** Convert Array<Expression> to Array<Node>. */
function expressionsToNodes(exprs: GrowableArray<Expression>) {
  let result = new Array<Node>(exprs.length);
  var i = 0;
  while (i < exprs.length) {
    result.push(exprs[i]);
    i += 1;
  }
  return result;
}

/** Build a two-element Array<Node>. */
function twoNodes(a: Node, b: Node) {
  let arr = growable<Node>([a, b]);
  return arr;
}

/**
 * Extract the child body (Array<Node>) from nodes that contain bodies.
 * Also handles variable declarations and function expressions so that
 * comments inside nested blocks (e.g. `let f = () => { ... };`)
 * are correctly attached.
 */
function getChildBody(node: Node): GrowableArray<Node> | null {
  return match (node) {
  case BlockStatement {body}: statementsToNodes(body)
  case ClassDeclaration {body}: body
  case InterfaceDeclaration {body}: body
  case MixinDeclaration {body}: body
  case EnumDeclaration {members}: enumMembersToNodes(members)
  // Statements that hold a body. Without these a comment written inside the
  // body is not descended into, and ends up attached outside the statement.
  case IfStatement {test, consequent, alternate}: {
    let result = growable<Node>([test, consequent]);
    if (alternate != null) { result.push(alternate as Node); }
    result
  }
  case WhileStatement {test, body}: twoNodes(test, body)
  case ForStatement {init, test, update, body}: {
    let result = new Array<Node>(4);
    if (init != null) { result.push(init as Node); }
    if (test != null) { result.push(test as Node); }
    if (update != null) { result.push(update as Node); }
    result.push(body);
    result
  }
  case ForInStatement {iterable, body}: twoNodes(iterable, body)
  case ReturnStatement {argument}: {
    if (argument == null) { null } else { singleNode(argument as Node) }
  }
  case YieldStatement {argument}: singleNode(argument)
  case ExpressionStatement {expression}: singleNode(expression)
  case UsingStatement {init}: singleNode(init)
  case ShieldedStatement {body}: singleNode(body)
  // Class members that hold a body, so a comment in a method or an accessor
  // stays in it rather than becoming a trailing comment on the member before.
  case MethodDefinition {body}: {
    if (body == null) { null } else { singleNode(body as Node) }
  }
  case AccessorDeclaration {getter, setter}: {
    let result = new Array<Node>(2);
    if (getter != null) { result.push(getter as Node); }
    if (setter != null) { result.push(setter as Node); }
    if (result.length == 0) { null } else { result }
  }
  case SetterInfo {body}: singleNode(body)
  case FieldDefinition {value}: {
    if (value == null) { null } else { singleNode(value as Node) }
  }
  case MatchCase {body}: singleNode(body)
  case VariableDeclaration {init}: {
    if (init.loc == null) { null } else { singleNode(init as Node) }
  }
  case FunctionDeclaration {func}: singleNode(func as Node)
  case FunctionExpression {body}: singleNode(body)
  case BinaryExpression {left, right}: twoNodes(left, right)
  case AssignmentExpression {left, value}: twoNodes(left, value)
  case UnaryExpression {argument}: singleNode(argument)
  case CallExpression {callee, args}: {
    let result = growable<Node>([callee]);
    var i = 0;
    while (i < args.length) {
      result.push(args[i]);
      i += 1;
    }
    result
  }
  case NewExpression {callee, args}: {
    let result = growable<Node>([callee]);
    var i = 0;
    while (i < args.length) {
      result.push(args[i]);
      i += 1;
    }
    result
  }
  case MemberExpression {object}: singleNode(object)
  case IndexExpression {object, index}: twoNodes(object, index)
  case ArrayLiteral {elements}: expressionsToNodes(elements)
  case IfExpression {test, consequent, alternate}: {
    let result = growable<Node>([test, consequent]);
    if (alternate != null) { result.push(alternate); }
    result
  }
  case MatchExpression {discriminant, cases}: {
    let result = growable<Node>([discriminant]);
    for (let c in cases) { result.push(c); }
    result
  }
  case AsExpression {expression}: singleNode(expression)
  case IsExpression {expression}: singleNode(expression)
  case SpreadElement {argument}: singleNode(argument)
  case _: null
};
}

/**
 * Attach comments to nodes in a list. Recurses into sub-bodies.
 */
function attachToNodeList(
  comments: GrowableArray<Comment>,
  nodes: GrowableArray<Node>,
  source: String,
  map: CommentMap
): void {
  if (comments.length == 0) { return; }

  // For each comment, find where it belongs
  for (let comment in comments) {
    var attached = false;

    // Check if comment belongs inside a child node's body — if so, recurse
    for (let node in nodes) {
      let childBody = getChildBody(node);
      if (childBody != null) {
        let nStart = getNodeStart(node);
        let nEnd = getNodeEnd(node);
        if (nStart >= 0 && nEnd >= 0 && comment.start > nStart && comment.end < nEnd) {
          let singleComment = growable<Comment>([comment]);
          attachToNodeList(singleComment, childBody, source, map);
          // If the body was empty, the comment dangles — attach as inner
          if (childBody.length == 0) {
            map.addInner(node, comment);
          }
          attached = true;
          break;
        }
      }
    }

    if (!attached) {
      // Find preceding and following nodes
      var preceding: Node | null = null;
      var following: Node | null = null;

      for (let node in nodes) {
        let nEnd = getNodeEnd(node);
        let nStart = getNodeStart(node);
        if (nEnd >= 0 && nEnd <= comment.start) {
          preceding = node;
        }
        if (nStart >= 0 && nStart >= comment.end && following == null) {
          following = node;
        }
      }

      if (preceding != null && comment.line == getNodeEndLine(source, preceding)) {
        map.addTrailing(preceding, comment);
      } else if (following != null) {
        map.addLeading(following, comment);
      } else if (preceding != null) {
        map.addTrailing(preceding, comment);
      }
      // Note: inner comments on empty containers are handled above in the recurse branch
    }

  }
}

/**
 * Attach all comments from the module to their nearest AST nodes.
 * Returns a CommentMap keyed by Node reference.
 */
export function attachComments(module: Module): CommentMap {
  let map = new CommentMap();
  let {comments} = module;
  if (comments.length == 0) {
    return map;
  }
  let {source} = module;
  let nodes = statementsToNodes(module.body);

  // Empty module: all comments are file-level (leading on Module)
  if (nodes.length == 0) {
    var ei = 0;
    while (ei < comments.length) {
      map.addLeading(module, comments[ei]);
      ei += 1;
    }
    return map;
  }

  // Comments at the top of the file separated from the first declaration
  // (or the next comment group) by a blank line are file-level: leading on Module.
  let firstNodeStart = getNodeStart(nodes[0]);

  // Collect comments that appear before the first statement
  var prefixEnd = 0;
  while (prefixEnd < comments.length && comments[prefixEnd].start < firstNodeStart) {
    prefixEnd += 1;
  }

  // Find the split point: the last comment before a blank line gap
  var fileLevelEnd = 0;
  if (prefixEnd > 0) {
    var ci = 0;
    while (ci < prefixEnd) {
      let commentEnd = comments[ci].end;
      // What comes after this comment?
      let nextStart = if (ci + 1 < prefixEnd) {
        comments[ci + 1].start;
      } else {
        firstNodeStart;
      };
      if (hasBlankLineBetween(source, commentEnd, nextStart)) {
        fileLevelEnd = ci + 1;
      }
      ci += 1;
    }
  }

  // Attach file-level comments as leading on the Module node
  var fi = 0;
  while (fi < fileLevelEnd) {
    map.addLeading(module, comments[fi]);
    fi += 1;
  }

  // Build the remaining comments array (skip file-level ones)
  let remaining = new Array<Comment>(comments.length - fileLevelEnd);
  var ri = fileLevelEnd;
  while (ri < comments.length) {
    remaining.push(comments[ri]);
    ri += 1;
  }

  // Attach remaining comments to nodes in the body
  attachToNodeList(remaining, nodes, source, map);

  return map;
}
