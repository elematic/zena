/**
 * Scope system for the Zena compiler.
 *
 * Manages name resolution, nested lexical scopes, and module export catalogs.
 *
 * Scopes form a parent-linked chain: block → function → module.
 * Names are resolved by walking the chain from innermost to outermost.
 */

export {Symbol, SymbolId} from './scope/symbol.zena';
export {Scope, ScopeKind} from './scope/scope.zena';
export {ScopeBuilder, ScopeResult, ModuleExports, UnresolvedName, SymbolMap} from './scope/scope-builder.zena';
