// The standard library's own package manifest, and the mapping from a
// stdlib module id back to the library that owns it.
//
// This lives apart from `package-manifest.zena`, which parses user
// `zena-packages.json` files and therefore depends on `CompilerHost` and the
// loader. Nothing here needs either, so files as low in the import graph as
// `types.zena` can reach the stdlib layout without a cycle.

import { PackageConfig, ModuleExport } from './module-resolver.zena';

// Build the standard library PackageConfig.
//
// The `stdlibRoot` is the absolute path to the stdlib's zena source
// directory (e.g., "/path/to/packages/stdlib/zena").
//
// This is kept separate from user packages because the stdlib is a
// language-level concept, not a user dependency. The compiler always
// includes it. Eventually, the stdlib source could be embedded in the
// compiler binary, eliminating the need for a path.
export let buildStdlibConfig = (stdlibRoot: String): PackageConfig => {
  let exports = new Map<String, ModuleExport>();

  // Public modules (no virtual mapping).
  // Keep in sync with packages/stdlib/stdlib-manifest.json.
  let publicModules = [
    "args",
    "assert",
    "async",
    "cli",
    "fs",
    "glob",
    "json",
    "math",
    "path",
    "regex",
    "task",
    "test"
  ];
  var i = 0;
  while (i < publicModules.length) {
    exports[publicModules[i]] = new ModuleExport(null);
    i += 1;
  }

  // Virtual module: console → per-target entry file. The implementation
  // files live under console/ and are not importable by name. Every
  // target has one, because `console` is in every target's prelude and
  // code that prints has to be portable.
  //
  // Virtual module: memory → the linear-memory allocator. One
  // implementation everywhere but the component target, where the
  // memory belongs to the runtime memory module and the allocator
  // delegates to its `realloc` — two allocators handing out blocks from
  // the same pages would corrupt each other, so the component entry
  // keeps no allocation state at all.
  let memoryVirtual = new Map<String, String>();
  memoryVirtual["host"] = "memory.zena";
  memoryVirtual["js"] = "memory.zena";
  memoryVirtual["wasi"] = "memory.zena";
  memoryVirtual["zena-cli"] = "memory.zena";
  memoryVirtual["freestanding"] = "memory.zena";
  memoryVirtual["component"] = "memory/component.zena";
  exports["memory"] = new ModuleExport(memoryVirtual);

  let consoleVirtual = new Map<String, String>();
  consoleVirtual["host"] = "console/host.zena";
  consoleVirtual["js"] = "console/host.zena";
  consoleVirtual["wasi"] = "console/wasi.zena";
  consoleVirtual["zena-cli"] = "console/wasi.zena";
  // The component console prints over p3 stdio. `freestanding` shares
  // it: a freestanding build is a component's core module without the
  // wrapper, and the two must load the same prelude for the wrapper to
  // embed exactly the module the freestanding build emits.
  consoleVirtual["component"] = "console/component.zena";
  consoleVirtual["freestanding"] = "console/component.zena";
  exports["console"] = new ModuleExport(consoleVirtual);

  // Virtual module: wasi → the guest side of the Component Model. The
  // canonical ABI's string marshaling and allocator, the async-import
  // driver that turns the subtask protocol into a `Future`, and the
  // guest half of `stream<u8>`. Only a component has any of that
  // beneath it, so the component target resolves it, and `freestanding`
  // with it: a freestanding build is a component's core module without
  // the wrapper, and its prelude's console is the component's. The
  // component runtime's own memory entry sits beside these files
  // without being one of them.
  exports["wasi"] = new ModuleExport(null, "wasi/index.zena");

  // Virtual module: error-stack → the `Error` stack-trace hooks. The host
  // hooks trade in `anyref`/`externref`, which have no Component Model
  // representation, so a component (and a freestanding module, which has
  // no host to call) gets the null implementation instead. Every module
  // pulls this in through `zena:error`, so it is the one import that a
  // target cannot opt out of by writing less code — see
  // docs/design/component-emission.md, Part 2.
  let errorStackVirtual = new Map<String, String>();
  errorStackVirtual["host"] = "core/error/stack-host.zena";
  errorStackVirtual["js"] = "core/error/stack-host.zena";
  errorStackVirtual["wasi"] = "core/error/stack-host.zena";
  errorStackVirtual["zena-cli"] = "core/error/stack-host.zena";
  errorStackVirtual["freestanding"] = "core/error/stack-none.zena";
  errorStackVirtual["component"] = "core/error/stack-none.zena";
  // Internal: `zena:core` is the only thing that reaches it, through
  // `core/error.zena` and its own entry point. The manifest entry is
  // what picks the file per target, which is the only reason the name
  // exists at all.
  exports["error-stack"] = new ModuleExport(errorStackVirtual, null, true);

  // Virtual module: process → host process spawning. Only wasi-family
  // targets can compile it, and only the zena-cli host links real
  // implementations (for trusted invocations); see the library header.
  let processVirtual = new Map<String, String>();
  processVirtual["wasi"] = "process/wasi.zena";
  processVirtual["zena-cli"] = "process/wasi.zena";
  exports["process"] = new ModuleExport(processVirtual);

  // Virtual module: wasm → running other Wasm modules, on zena-cli only:
  // it needs the zena_wasm host imports. Granted with
  // process spawning and linked by the same hosts; see the library
  // header.
  let wasmVirtual = new Map<String, String>();
  wasmVirtual["zena-cli"] = "wasm/wasi.zena";
  exports["wasm"] = new ModuleExport(wasmVirtual);

  // Virtual module: js → JavaScript-host interop, currently the
  // host-async completion registry. Only the JS-hosted targets have an
  // embedder that pushes completions back in through the module's
  // exports: WASI p1 blocks in a parker and the component target's
  // futures ride the canonical ABI's waitables, so neither resolves it.
  let jsVirtual = new Map<String, String>();
  jsVirtual["host"] = "js/index.zena";
  jsVirtual["js"] = "js/index.zena";
  exports["js"] = new ModuleExport(jsVirtual);

  // Virtual module: fetch → HTTP requests. The JS-hosted targets go
  // through the host's own fetch(); the component target speaks
  // wasi:http through the bindings synthesized from the stdlib's WIT.
  // A WASI p1 build fails at import resolution rather than linking an
  // import no host provides.
  let fetchVirtual = new Map<String, String>();
  fetchVirtual["host"] = "fetch/host.zena";
  fetchVirtual["js"] = "fetch/host.zena";
  fetchVirtual["component"] = "fetch/component.zena";
  exports["fetch"] = new ModuleExport(fetchVirtual);

  // Virtual module: http → the service side of wasi:http, a handler's
  // request and response helpers over the same synthesized bindings.
  // Component target only: the resources it handles have no host
  // elsewhere.
  let httpVirtual = new Map<String, String>();
  httpVirtual["component"] = "http/index.zena";
  exports["http"] = new ModuleExport(httpVirtual);

  // Virtual module: time → sleeping and the monotonic clock. Both
  // entries park synchronously and share time/queue.zena; only the
  // clock differs (poll_oneoff vs a host import). See async.md §4.
  let timeVirtual = new Map<String, String>();
  timeVirtual["host"] = "time/host.zena";
  timeVirtual["js"] = "time/host.zena";
  timeVirtual["wasi"] = "time/wasi.zena";
  timeVirtual["zena-cli"] = "time/wasi.zena";
  // The component target's clock is p3's, and p3's wait is asynchronous:
  // see docs/design/component-emission.md, Part 5.
  timeVirtual["component"] = "time/p3.zena";
  exports["time"] = new ModuleExport(timeVirtual);


  // Directory-based modules: entry file inside a library directory. The
  // sibling implementation files are private — reachable only via relative
  // imports from the library's own files.
  // The rendezvous stream is its own library, not part of zena:async: the
  // prelude names zena:async, so anything folded in is parsed and checked
  // by every compilation whether or not it is used.
  exports["stream"] = new ModuleExport(null, "stream/index.zena");
  // Its twenty-three members have no module name of their own: they are
  // private files of this library, reached through this entry point or by
  // relative import from inside it. `error-stack` is the exception, and it
  // is virtual — the manifest is what picks a file per target, so a
  // relative import would nail one of them.
  exports["core"] = new ModuleExport(null, "core/index.zena");
  exports["url"] = new ModuleExport(null, "url/index.zena");
  exports["bench"] = new ModuleExport(null, "bench/index.zena");
  exports["collections"] = new ModuleExport(null, "collections/index.zena");
  exports["simd"] = new ModuleExport(null, "simd/index.zena");

  return new PackageConfig(stdlibRoot, exports);
};

// ============================================================================
// Module id → owning library
// ============================================================================

// Module id (without the "zena:" prefix) → the library that owns it.
//
// Built once. The stdlib layout is compiled into the compiler rather than
// read from the program being compiled, so the index is the same for every
// compilation and a long-lived compiler can keep it.
var libraryIndex: Map<String, String> | null = null;

// Every id the manifest names outright: each library's own name, and each
// entry file a `path` or `virtual` mapping points at. A library's private
// files are not in here — `stdlibLibraryOf` attributes those by directory.
let buildLibraryIndex = (): Map<String, String> => {
  let index = new Map<String, String>();
  // The root is only used to resolve entry files on disk, which nothing
  // reading this index does.
  let config = buildStdlibConfig("");
  let exports = config.exports as Map<String, ModuleExport>;
  exports.forEach((name: String, entry: ModuleExport): void => {
    index[name] = name;
    let path = entry.path;
    if (path != null) {
      index[path as String] = name;
    }
    let virtual = entry.virtual;
    if (virtual != null) {
      (virtual as Map<String, String>).forEach(
        (target: String, entryPath: String): void => {
          index[entryPath] = name;
        });
    }
  });
  libraryIndex = index;
  return index;
};

// The first path segment of `id`, or the whole id if it has no "/".
let firstSegment = (id: String): String => {
  var i = 0;
  while (i < id.length) {
    if (id.getByteAt(i) == 47) { // 47 = '/'
      return id.sliceBytes(0, i);
    }
    i += 1;
  }
  return id;
};

/**
 * The stdlib library that owns `moduleId`, or null if no library does.
 *
 * `moduleId` is a canonical module id as the resolver produces it, in
 * either of its two forms: a name id for a library's default entry file
 * ("zena:string"), or a path id for every other stdlib file
 * ("zena:async/future.zena", "zena:console/host.zena"). Anything without
 * the "zena:" prefix is a user module and owned by no library, which is
 * the answer for most calls and is why it is the first thing tested.
 *
 * A path id the manifest names is owned by the library it is an entry for,
 * which is why "core/error/stack-host.zena" belongs to `error-stack` and not
 * to `core` despite sitting under `core/`. A path id the manifest does not name
 * is one of a library's private implementation files, and belongs to the
 * library its directory is named for.
 *
 * Every comparison is exact. The directory rule tests one path segment for
 * membership in the set of published libraries; nothing here matches a
 * prefix, suffix or substring, so a module cannot be attributed to a
 * library whose name it merely begins with.
 */
/**
 * The published module name whose entry file is `entryPath`, or null if
 * the manifest names no module for it.
 *
 * `entryPath` is relative to the stdlib source root — "component-stream.zena",
 * "console/host.zena" — which is the form a canonical path id carries after
 * its "zena:" prefix. Only entry files match: a library's private
 * implementation files have no module name, and this reports that rather
 * than inventing one from the file name.
 */
export let stdlibModuleNameForEntryPath = (entryPath: String): String | null => {
  let index = if (libraryIndex != null) {
    libraryIndex as Map<String, String>
  } else {
    buildLibraryIndex()
  };
  if (let (true, name) = index.get(entryPath)) {
    return name;
  }
  return null;
};

export let stdlibLibraryOf = (moduleId: String): String | null => {
  if (!moduleId.startsWith("zena:")) {
    return null;
  }
  let index = if (libraryIndex != null) {
    libraryIndex as Map<String, String>
  } else {
    buildLibraryIndex()
  };
  let id = moduleId.sliceBytes(5, moduleId.length);
  if (let (true, library) = index.get(id)) {
    return library;
  }
  let dir = firstSegment(id);
  if (dir == id) {
    // No directory to fall back on: an unrecognized top-level id.
    return null;
  }
  if (let (true, library) = index.get(dir)) {
    // A private file of `library`, but only if the directory is the
    // library's own name — an entry path that happens to sit one level
    // down was already matched above.
    if (library == dir) {
      return library;
    }
  }
  return null;
};

/**
 * The library a library's files are moving into, for the length of the move.
 *
 * The counterpart of `movingTo` in the well-known registry, which does this
 * for a single declaration. A lookup that names a library instead — the
 * roots taken by `queueStdlibFunction` and `getStdlibFunc` — needs the same
 * grace for the same reason: the checked-in bootstrap answers with ITS
 * manifest, which does not name the new path until the reseed after the
 * files land, so until then `stdlibLibraryOf` attributes a moved file to
 * the directory it now sits in.
 *
 * An entry is one exact destination, not a relaxation. There is deliberately
 * no fallback to `core` for libraries with no entry here: that would let a
 * lookup that should have failed find something plausible in another
 * library. Each entry is deleted by the reseed after its files land.
 */
var libraryMoves: Map<String, String> | null = null;

let buildLibraryMoves = (): Map<String, String> => {
  // Empty between migrations, which is the resting state: every library is
  // where the manifest says it is, so a lookup naming one has exactly one
  // answer. An entry is added for the length of a move and deleted by the
  // reseed after its files land. See docs/design/stdlib-organization.md.
  let t = new Map<String, String>();
  libraryMoves = t;
  return t;
};

/**
 * Whether a module owned by `owner` answers a lookup for `library` — the
 * same library, or the one it is moving into while it moves.
 */
export let stdlibLibraryAnswers = (owner: String, library: String): boolean => {
  if (owner == library) {
    return true;
  }
  let moves = if (libraryMoves != null) {
    libraryMoves as Map<String, String>
  } else {
    buildLibraryMoves()
  };
  if (let (true, destination) = moves.get(library)) {
    return owner == destination;
  }
  return false;
};
