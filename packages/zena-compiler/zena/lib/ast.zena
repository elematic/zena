/**
 * Abstract Syntax Tree types for the Zena language
 */

import { Array } from 'zena:array';
import { GrowableArray } from 'zena:growable-array';

/**
 * Distinct type for Node identity keys.
 * Prevents accidental use of source offsets or other i32 values as Node IDs.
 */
export distinct type NodeId = i32;

/**
 * A monotonic ID counter, generic over the ID type it mints.
 *
 * The forging cast is not in here — it arrives as `mint`, a closure written
 * beside the type it produces. That keeps one counter implementation while
 * putting each `i32 -> Id` conversion in the file that declares that Id, which
 * is where it would have to be if any of these became `opaque`. It also means
 * this body contains no cast at all, so it does not need the type-parameter
 * exemption that `return id as T` would (and could not get — see
 * docs/design/opaque-types.md).
 *
 * `mint` is private, so a generator hands out IDs but never the conversion
 * that made them.
 */
export final class IdGenerator<T> {
  #mint: (id: i32) => T;
  var #nextId: i32;
  new(mint: (id: i32) => T, nextId: i32 = 1)
    : #mint = mint,
      #nextId = nextId;
  next(): T {
    let id = this.#nextId;
    this.#nextId += 1;
    return this.#mint(id);
  }
}

/**
 * The only way to get NodeIds. There is deliberately no `makeNodeId(i32)`:
 * what matters about these is that they are unique within a compilation, and
 * a public conversion hands that away to every caller.
 */
export let makeNodeIdGenerator = (nextId: i32 = 1): IdGenerator<NodeId> =>
  new IdGenerator<NodeId>((id: i32): NodeId => id as NodeId, nextId);

export final class SourceLocation(
  /** 1-based line number */
  line: i32,
  /** 1-based column number */
  column: i32,
  /** 0-based start index (inclusive) */
  start: i32,
  /** 0-based end index (exclusive) */
  end: i32,
  /**
   * Path of the source file this location belongs to. Lets diagnostics
   * report the correct file when an error is raised against a node from
   * another module than the one being checked.
   */
  path?: String)

/**
 * A source comment collected during tokenization.
 */
export final class Comment(
  /** The comment text without delimiters. */
  value: String,
  /** True for block comments, false for line comments. */
  isBlock: boolean,
  /** 0-based start byte offset (inclusive, includes delimiter). */
  start: i32,
  /** 0-based end byte offset (exclusive, includes delimiter). */
  end: i32,
  /** 1-based line number where the comment starts. */
  line: i32,
  /** 1-based column where the comment starts. */
  column: i32)

export sealed class Node {
  // Sub-hierarchies
  case Expression, Statement, Pattern, TypeAnnotation

  // Direct case classes
  case Module
  case TemplateElement, PropertyAssignment, SpreadElement, MapEntry
  case BindingProperty, MatchCase, LetPatternCondition
  case TypeParameter, Parameter
  case CaseClassParam, SealedVariant
  case FieldDefinition, MethodDefinition, AccessorDeclaration, SetterInfo
  case FieldInitializer, SuperInitializer
  case MethodSignature, AccessorSignature
  case EnumMember, CatchClause
  case PropertySignature
  case ImportSpecifier
  case Decorator
  case SymbolPropertyName

  abstract loc: SourceLocation | null;

  /**
   * Unique ID assigned to this node instance.
   * Useful for mapping nodes to semantic information without relying on
   * object identity (which is tricky for case classes) or source location.
   */
  var id: NodeId = 0 as NodeId;
}

// ============================================================================
// Module
// ============================================================================

export final class Module(
  body: GrowableArray<Statement>,
  path: String,
  source: String,
  comments: GrowableArray<Comment>,
  loc?: SourceLocation) extends Node

// ============================================================================
// Expressions
// ============================================================================

export sealed class Expression extends Node {
  // Identifiers & Literals
  case Identifier(name: String, loc?: SourceLocation)
  case NumberLiteral(raw: String, loc?: SourceLocation)
  case StringLiteral(value: String, loc?: SourceLocation)
  case BooleanLiteral(value: boolean, loc?: SourceLocation)
  case NullLiteral(loc?: SourceLocation)

  // Templates
  case TemplateLiteral(
    quasis: GrowableArray<TemplateElement>,
    expressions: GrowableArray<Expression>,
    loc?: SourceLocation)
  case TaggedTemplateExpression(
    tag: Expression,
    quasi: TemplateLiteral,
    loc?: SourceLocation)

  // Operators
  case BinaryExpression(
    operator: String,
    left: Expression,
    right: Expression,
    loc?: SourceLocation)
  case UnaryExpression(
    operator: String,
    argument: Expression,
    prefix: boolean,
    loc?: SourceLocation)
  case AssignmentExpression(
    left: Expression,
    value: Expression,
    operator?: String,
    loc?: SourceLocation)
  case AsExpression(
    expression: Expression,
    typeAnnotation: TypeAnnotation,
    loc?: SourceLocation)
  case IsExpression(
    expression: Expression,
    typeAnnotation: TypeAnnotation,
    loc?: SourceLocation)
  case RangeExpression(
    start: Expression | null,
    end: Expression | null,
    loc?: SourceLocation)
  case PipelineExpression(
    left: Expression,
    right: Expression,
    loc?: SourceLocation)
  case PipePlaceholder(loc?: SourceLocation)

  // Functions & Calls
  case FunctionExpression(
    typeParameters: GrowableArray<TypeParameter> | null,
    params: GrowableArray<Parameter>,
    returnType: TypeAnnotation | null,
    body: BlockStatement | Expression,
    isGenerator: boolean,
    isAsync: boolean,
    loc?: SourceLocation)
  case AwaitExpression(argument: Expression, loc?: SourceLocation)
  case CallExpression(
    callee: Expression,
    args: GrowableArray<Expression>,
    typeArguments: GrowableArray<TypeAnnotation> | null,
    optional: boolean,
    loc?: SourceLocation)

  // Member Access
  case MemberExpression(
    object: Expression,
    property: Identifier,
    optional: boolean,
    isSymbolAccess: boolean,
    symbolPath: Expression | null,
    loc?: SourceLocation)
  case IndexExpression(
    object: Expression,
    index: Expression,
    optional: boolean,
    loc?: SourceLocation)
  case ThisExpression(loc?: SourceLocation)
  case SuperExpression(loc?: SourceLocation)
  case NewExpression(
    callee: Identifier,
    typeArguments: GrowableArray<TypeAnnotation> | null,
    args: GrowableArray<Expression>,
    loc?: SourceLocation)

  // Collection Literals
  case ArrayLiteral(elements: GrowableArray<Expression>, loc?: SourceLocation)
  case RecordLiteral(properties: GrowableArray<Node>, loc?: SourceLocation)
  case MapLiteral(entries: GrowableArray<MapEntry>, loc?: SourceLocation)
  case TupleLiteral(elements: GrowableArray<Expression>, loc?: SourceLocation)

  // Control Flow Expressions
  case MatchExpression(
    discriminant: Expression,
    cases: GrowableArray<MatchCase>,
    loc?: SourceLocation)
  case IfExpression(
    test: Node,
    consequent: Node,
    alternate: Node | null,
    loc?: SourceLocation)

  // Error Handling Expressions
  case ThrowExpression(argument: Expression, loc?: SourceLocation)
  case TryExpression(
    body: BlockStatement,
    handler: CatchClause | null,
    cancelBlock: BlockStatement | null,
    finalizer: BlockStatement | null,
    loc?: SourceLocation)
}

// ============================================================================
// Statements
// ============================================================================

export sealed class Statement extends Node {
  case VariableDeclaration(
    kind: String,
    pattern: Pattern,
    typeAnnotation: TypeAnnotation | null,
    init: Expression,
    exported: boolean,
    loc?: SourceLocation)
  /**
   * A top-level `function` declaration.
   *
   * `name` is an `IdentifierPattern`, not an `Identifier`, so the binding
   * site has the same shape as `let f = () => ...`: the scope builder
   * records the symbol on the pattern, and everything downstream that
   * reads `Symbol.declaration` (documented to be an `IdentifierPattern`
   * for function bindings) keeps working unchanged.
   *
   * `func` holds the signature and body, and is the same
   * `FunctionExpression` an arrow produces, so the checker, reachability
   * and lowering paths are shared. What differs is a static guarantee:
   * a `function` never closes over anything, so it needs no context
   * struct and no closure wrapper. See language-reference.md §4.
   */
  case FunctionDeclaration(
    name: IdentifierPattern,
    func: FunctionExpression,
    exported: boolean,
    loc?: SourceLocation)
  /**
   * A `using` statement: `using let file = open(path);`, or the unbound
   * `using acquire(lock);` when there is nothing worth naming.
   *
   * One node covers both forms because they differ only in whether the
   * value is named: `pattern` is null for the unbound form, and `init` is
   * the disposable either way. The value is released on every path leaving
   * the enclosing block — normal exit, `return`, `break`/`continue`, and
   * exception unwind — in reverse declaration order. See
   * docs/design/ownership.md §`using`.
   */
  case UsingStatement(
    pattern: Pattern | null,
    typeAnnotation: TypeAnnotation | null,
    init: Expression,
    loc?: SourceLocation)
  /**
   * `shielded { ... }` — a region where cancellation checkpoints do
   * not deliver, for cleanup that must await after cancellation has
   * arrived. Level-triggering resumes at the closing brace. Legal only
   * in async bodies. See docs/design/cancellation.md §Shields.
   */
  case ShieldedStatement(body: BlockStatement, loc?: SourceLocation)
  case ExpressionStatement(expression: Expression, loc?: SourceLocation)
  case BlockStatement(body: GrowableArray<Statement>, loc?: SourceLocation)
  case ReturnStatement(argument: Expression | null, loc?: SourceLocation)
  case YieldStatement(argument: Expression, loc?: SourceLocation)
  case BreakStatement(loc?: SourceLocation)
  case ContinueStatement(loc?: SourceLocation)
  case IfStatement(
    test: Node,
    consequent: Statement,
    alternate: Statement | null,
    loc?: SourceLocation)
  case WhileStatement(test: Node, body: Statement, loc?: SourceLocation)
  case ForStatement(
    init: Node | null,
    test: Expression | null,
    update: Expression | null,
    body: Statement,
    loc?: SourceLocation)
  case ForInStatement(
    pattern: Pattern,
    iterable: Expression,
    body: Statement,
    loc?: SourceLocation)
  case ClassDeclaration(
    name: Identifier,
    typeParameters: GrowableArray<TypeParameter> | null,
    caseParams: GrowableArray<CaseClassParam> | null,
    superClass: TypeAnnotation | null,
    mixins: GrowableArray<TypeAnnotation> | null,
    implementsList: GrowableArray<TypeAnnotation> | null,
    body: GrowableArray<Node>,
    exported: boolean,
    isFinal: boolean,
    isAbstract: boolean,
    isExtension: boolean,
    isSealed: boolean,
    sealedVariants: GrowableArray<SealedVariant> | null,
    onType: TypeAnnotation | null,
    /**
     * `resource class C` — the class has no unwrapped form. Every mention of
     * `C` in a type position must be `Own<C>`, `Borrow<C>` or `Unmanaged<C>`.
     * See docs/design/ownership.md §"Resource-ness and affineness are
     * different properties": this declares resource-ness, not affineness —
     * affineness comes from the `Own<T>` wrapper.
     */
    isResource: boolean,
    loc?: SourceLocation)
  case InterfaceDeclaration(
    name: Identifier,
    typeParameters: GrowableArray<TypeParameter> | null,
    extendsList: GrowableArray<TypeAnnotation> | null,
    body: GrowableArray<Node>,
    exported: boolean,
    loc?: SourceLocation)
  case EnumDeclaration(
    name: Identifier,
    members: GrowableArray<EnumMember>,
    exported: boolean,
    loc?: SourceLocation)
  case MixinDeclaration(
    name: Identifier,
    typeParameters: GrowableArray<TypeParameter> | null,
    on: TypeAnnotation | null,
    mixins: GrowableArray<TypeAnnotation> | null,
    body: GrowableArray<Node>,
    exported: boolean,
    loc?: SourceLocation)
  // `isOpaque` implies `isDistinct`: an opaque alias is a distinct type that
  // additionally restricts casts *to* it to the file that declares it. Every
  // pass that only cares about nominal identity keeps reading `isDistinct`.
  case TypeAliasDeclaration(
    name: Identifier,
    typeParameters: GrowableArray<TypeParameter> | null,
    typeAnnotation: TypeAnnotation,
    exported: boolean,
    isDistinct: boolean,
    isOpaque: boolean,
    loc?: SourceLocation)
  case ImportDeclaration(
    moduleSpecifier: StringLiteral,
    imports: GrowableArray<ImportSpecifier>,
    loc?: SourceLocation)
  case ExportAllDeclaration(
    moduleSpecifier: StringLiteral,
    loc?: SourceLocation)
  case ExportFromDeclaration(
    specifiers: GrowableArray<ImportSpecifier>,
    moduleSpecifier: StringLiteral,
    loc?: SourceLocation)
  case DeclareFunction(
    name: Identifier,
    typeParameters: GrowableArray<TypeParameter> | null,
    params: GrowableArray<Parameter>,
    returnType: TypeAnnotation,
    externalModule: String | null,
    externalName: String | null,
    exported: boolean,
    decorators: GrowableArray<Decorator>,
    loc?: SourceLocation)
  case SymbolDeclaration(
    name: Identifier,
    exported: boolean,
    loc?: SourceLocation)
}

// ============================================================================
// Patterns
// ============================================================================

export sealed class Pattern extends Node {
  case BindingPattern(
    kind: String,
    pattern: Pattern,
    loc?: SourceLocation)
  case IdentifierPattern(name: String, loc?: SourceLocation)
  case RecordPattern(properties: GrowableArray<BindingProperty>, loc?: SourceLocation)
  case TuplePattern(elements: GrowableArray<Node | null>, loc?: SourceLocation)
  case AsPattern(pattern: Node, name: Identifier, loc?: SourceLocation)
  case ClassPattern(
    name: Identifier,
    properties: GrowableArray<BindingProperty>,
    loc?: SourceLocation)
  case LogicalPattern(
    operator: String,
    left: Node,
    right: Node,
    loc?: SourceLocation)
  case AssignmentPattern(
    left: Node,
    right: Expression,
    loc?: SourceLocation)
  case LiteralPattern(value: Expression, loc?: SourceLocation)
  // `{!field}` — asserts an optional record field is absent. Binds
  // nothing; only valid as a record-pattern property value.
  case AbsencePattern(loc?: SourceLocation)
}

// ============================================================================
// Type Annotations
// ============================================================================

export sealed class TypeAnnotation extends Node {
  case NamedTypeAnnotation(
    name: String,
    typeArguments: GrowableArray<TypeAnnotation> | null,
    loc?: SourceLocation)
  case UnionTypeAnnotation(
    types: GrowableArray<TypeAnnotation>,
    loc?: SourceLocation)
  case NullableTypeAnnotation(
    typeAnnotation: TypeAnnotation,
    loc?: SourceLocation)
  case FunctionTypeAnnotation(
    paramNames: GrowableArray<String>,
    params: GrowableArray<TypeAnnotation>,
    returnType: TypeAnnotation,
    loc?: SourceLocation)
  case LiteralTypeAnnotation(
    value: Node,
    loc?: SourceLocation)
  case RecordTypeAnnotation(
    properties: GrowableArray<PropertySignature>,
    loc?: SourceLocation)
  case TupleTypeAnnotation(
    elementTypes: GrowableArray<TypeAnnotation>,
    loc?: SourceLocation)
  case InlineTupleTypeAnnotation(
    elementTypes: GrowableArray<TypeAnnotation>,
    loc?: SourceLocation)
  case ThisTypeAnnotation(
    loc?: SourceLocation)
}

// ============================================================================
// Import/Export Helpers
// ============================================================================

export final class ImportSpecifier(
  imported: Identifier,
  local: Identifier,
  loc?: SourceLocation) extends Node

// ============================================================================
// Template Elements
// ============================================================================

export final class TemplateElement(
  cooked: String,
  raw: String,
  tail: boolean,
  loc?: SourceLocation) extends Node

// ============================================================================
// Record & Map Entries
// ============================================================================

export final class PropertyAssignment(
  name: Identifier,
  value: Expression,
  loc?: SourceLocation) extends Node

export final class SpreadElement(
  argument: Expression,
  loc?: SourceLocation) extends Node

export final class MapEntry(
  key: Expression,
  value: Expression,
  loc?: SourceLocation) extends Node

// ============================================================================
// Pattern Helpers
// ============================================================================

export final class BindingProperty(
  name: Identifier,
  value: Node,
  loc?: SourceLocation) extends Node

// ============================================================================
// Match Expression Helpers
// ============================================================================

export final class MatchCase(
  pattern: Node,
  guard: Expression | null,
  body: Node,
  loc?: SourceLocation) extends Node

// ============================================================================
// Control Flow Helpers
// ============================================================================

export final class LetPatternCondition(
  pattern: Pattern,
  init: Expression,
  loc?: SourceLocation) extends Node

// ============================================================================
// Type Parameters
// ============================================================================

export final class TypeParameter(
  name: String,
  constraint: TypeAnnotation | null,
  defaultType: TypeAnnotation | null,
  loc?: SourceLocation) extends Node

// ============================================================================
// Parameters
// ============================================================================

export final class Parameter(
  name: Identifier,
  pattern: Pattern | null,
  typeAnnotation: TypeAnnotation | null,
  optional: boolean,
  defaultValue: Expression | null,
  isThisParam: boolean,
  loc?: SourceLocation) extends Node

// ============================================================================
// Case Class & Sealed Variant Helpers
// ============================================================================

export final class CaseClassParam(
  name: Identifier,
  typeAnnotation: TypeAnnotation,
  mutability: String | null,
  optional: boolean,
  loc?: SourceLocation) extends Node

export final class SealedVariant(
  name: Identifier,
  params: GrowableArray<CaseClassParam> | null,
  loc?: SourceLocation) extends Node

// ============================================================================
// Class Members
// ============================================================================

export final class FieldDefinition(
  name: Node,
  typeAnnotation: TypeAnnotation | null,
  value: Expression | null,
  isFinal: boolean,
  isAbstract: boolean,
  isStatic: boolean,
  isDeclare: boolean,
  mutability: String | null,
  decorators: GrowableArray<Decorator>,
  setterName: Node | null,
  loc?: SourceLocation) extends Node

export final class MethodDefinition(
  name: Node,
  typeParameters: GrowableArray<TypeParameter> | null,
  /**
   * An explicitly declared receiver — the `this: Own<this>` of a method that
   * consumes what it is called on. Null when the method takes the default
   * borrowing receiver, which is nearly every method.
   *
   * Kept out of `params` because it is not one: every method already has a
   * receiver, and putting it there would shift each argument's position for
   * codegen and for every arity check. See docs/design/ownership.md
   * §"Release consumes its receiver".
   */
  receiver: TypeAnnotation | null,
  params: GrowableArray<Parameter>,
  returnType: TypeAnnotation | null,
  body: Node | null,
  initializerList: GrowableArray<Node> | null,
  superInitializer: Node | null,
  isFinal: boolean,
  isAbstract: boolean,
  isStatic: boolean,
  isDeclare: boolean,
  isGenerator: boolean,
  isAsync: boolean,
  decorators: GrowableArray<Decorator>,
  loc?: SourceLocation) extends Node

// ============================================================================
// Accessors
// ============================================================================

export final class AccessorDeclaration(
  name: Node,
  typeAnnotation: TypeAnnotation,
  getter: BlockStatement | null,
  setter: Node | null,
  isFinal: boolean,
  isStatic: boolean,
  decorators: GrowableArray<Decorator>,
  loc?: SourceLocation) extends Node

export final class SetterInfo(
  param: Identifier,
  body: BlockStatement,
  loc?: SourceLocation) extends Node

// ============================================================================
// Initializer List Entries
// ============================================================================

export final class FieldInitializer(
  field: Identifier,
  value: Expression,
  loc?: SourceLocation) extends Node

export final class SuperInitializer(
  args: GrowableArray<Expression>,
  loc?: SourceLocation) extends Node

// ============================================================================
// Interface Members
// ============================================================================

export final class MethodSignature(
  name: Node,
  typeParameters: GrowableArray<TypeParameter> | null,
  params: GrowableArray<Parameter>,
  returnType: TypeAnnotation | null,
  loc?: SourceLocation) extends Node

export final class AccessorSignature(
  name: Identifier,
  typeAnnotation: TypeAnnotation,
  hasGetter: boolean,
  hasSetter: boolean,
  loc?: SourceLocation) extends Node

// ============================================================================
// Enum Members
// ============================================================================

export final class EnumMember(
  name: Identifier,
  initializer: Expression | null,
  loc?: SourceLocation) extends Node

// ============================================================================
// Error Handling Helpers
// ============================================================================

export final class CatchClause(
  param: Identifier | null,
  body: BlockStatement,
  loc?: SourceLocation) extends Node

// ============================================================================
// Property Signatures (for Record Type Annotations)
// ============================================================================

export final class PropertySignature(
  name: Identifier,
  typeAnnotation: TypeAnnotation,
  optional: boolean,
  loc?: SourceLocation) extends Node

// ============================================================================
// Decorators
// ============================================================================

export final class Decorator(
  name: String,
  args: GrowableArray<StringLiteral>,
  loc?: SourceLocation) extends Node

// ============================================================================
// Symbol Property Names
// ============================================================================

export final class SymbolPropertyName(
  symbolRef: Expression,
  loc?: SourceLocation) extends Node

export let getMemberPropertyName = (isSymbolAccess: boolean, name: String): String => {
  return if (isSymbolAccess) ":" + name else name;
};
