/**
 * Type system for the Zena compiler.
 *
 * Types are the semantic representation of Zena's type system. They are
 * produced by the checker and consumed by codegen and analysis passes.
 *
 * Design:
 * - Sealed hierarchy enables exhaustive pattern matching.
 * - Primitive types are singletons (created once in TypeContext).
 * - Complex types (Class, Interface) are mutable classes built incrementally.
 * - Type identity is used for equality (interned generic instantiations).
 * - The AST is never mutated — types live in the SemanticModel side table.
 */
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { OrderedMap } from 'zena:ordered-map';
import { HashSet } from 'zena:set';
import { StringBuilder } from 'zena:string-builder';
import { i32ToString } from 'zena:string-convert';


import { Expression, Statement, IdGenerator } from './ast.zena';
import { SymbolId, noSymbolId } from './scope/symbol.zena';
import { Hashable } from 'zena:hashable';

@intrinsic('hash')
declare function hash<T>(value: T): i32;

export distinct type TypeId = i32;

/**
 * The only way to get TypeIds. See `makeNodeIdGenerator` in ast.zena for why
 * the conversion lives here rather than being exported on its own.
 */
export let makeTypeIdGenerator = (nextId: i32 = 1): IdGenerator<TypeId> =>
  new IdGenerator<TypeId>((id: i32): TypeId => id as TypeId, nextId);

var _nextTypeUid: i32 = 1;
let nextTypeUid = (): i32 => {
  let id = _nextTypeUid;
  _nextTypeUid += 1;
  return id;
};

export sealed class Type implements Hashable {
  var uniqueKeyCache: String | null = null;
  var specializationKeyCache: String | null = null;

  /** Process-unique id for identity hashing (type identity is equality). */
  uid: i32 = nextTypeUid();

  /**
   * Identity hash. Without this, HashMap/HashSet keyed by Type fall back to a
   * constant hash and degenerate into linear scans.
   */
  hashCode(): i32 {
    return this.uid;
  }

  // Numeric primitives
  case I32Type
  case U32Type
  case I64Type
  case U64Type
  case F32Type
  case F64Type

  // Narrow integer primitives. These are storage widths, not arithmetic
  // widths: every one is carried in a wasm i32 (unsigned zero-extended,
  // signed sign-extended) and promotes to its 32-bit counterpart the
  // moment it takes part in an operation. See
  // docs/design/arithmetic-conversions.md.
  case U8Type
  case U16Type
  case I8Type
  case I16Type

  /**
   * The WebAssembly SIMD vector, 128 bits with no interpretation of its
   * own: what the bits mean is chosen by each instruction that reads
   * them, not by the type. So there is no literal syntax, no arithmetic,
   * no conversion to or from anything — a `v128` is produced and consumed
   * by the `zena:simd` intrinsics and otherwise only moves.
   *
   * Not a reference type at the wasm level, so it is absent from
   * `isRefType` and from `isBoxablePrimitive`. That constrains it no
   * more than it constrains `i32`: nothing converts a primitive to a
   * reference implicitly, and wasm GC accepts `v128` as a struct field
   * and array element type, so a generic instantiated at `v128` stores
   * one directly.
   */
  case V128Type

  // Other primitives
  case BooleanType
  case VoidType
  case NullType
  case NeverType
  case HoleType
  case ErrorType
  case UnknownType
  case AnyRefType
  case EqRefType

  /**
   * The erasure of a type parameter — CODEGEN-INTERNAL, never produced
   * by the checker and never written in source.
   *
   * It is deliberately NOT `anyref`. A type parameter's erasure and the
   * real top type are different things that happen to share a wasm
   * representation: `FixedArray<anyref>` is a type a program can write
   * and construct, while `FixedArray<T>` erased is a shape used to give
   * one funcref signature to a generic function used as a VALUE. While
   * both spelled `anyref`, the specialization key could not tell them
   * apart, so an erasure passed `isConcrete` and RTA built classes,
   * vtables and method bodies for types no value can ever have — see
   * docs/design/binary-size.md §15.
   *
   * Erasure is not a substitute for monomorphization and cannot be one:
   * `Array<i32>` stores an i32 field where `Array<anyref>` stores a
   * reference, so the erased form is a different struct, not a
   * supertype. Anything reaching a value across an erased boundary
   * boxes it. That is why `isConcrete` is FALSE here — an erasure is
   * never a specialization — and why lowering an erased body is a
   * compiler bug rather than a coverage gap.
   */
  case ErasedType

  // Literal types (narrower than their base type)
  case BoolLiteralType(value: boolean)
  case StringLiteralType(value: String)
  case NumLiteralType(raw: String)

  // Compound types
  case ArrayType(elementType: Type)
  case TupleType(elementTypes: GrowableArray<Type>)
  case InlineTupleType(elementTypes: GrowableArray<Type>)
  case UnionType(types: GrowableArray<Type>)
  case RecordType, FunctionType, ClassType, InterfaceType
  case MixinType, TypeParameterType, TypeAliasType
  case SymbolType, ThisType
}

export class MemberInfo {
  var type: Type;
  var isAbstract: boolean;
  var isStatic: boolean;
  var isPrivate: boolean;

  /**
   * The `SymbolType` id of the symbol that named this member, for a
   * member declared as `:sym`; -1 when the member is name-keyed, or when
   * the key is the qualified `:Iface.sym` form (whose visibility is the
   * interface's, not a symbol binding's).
   *
   * Member keys mangle a symbol to `":" + name`, so the key alone cannot
   * tell two same-named symbols apart — which is what let a consumer read
   * a private symbol-keyed member by declaring a symbol of its own.
   * Access compares this id; -1 means "unknown", and the check is skipped
   * rather than guessed (an inherited member copied into a subtype's
   * table loses it).
   */
  var symbolTypeId: i32 = -1;

  new(
    this.type,
    this.isAbstract = false,
    this.isStatic = false,
    this.isPrivate = false
  );
}

export final class FieldInfo extends MemberInfo {
  var isMutable: boolean;
  var hasInitializer: boolean;

  new(
    type: Type,
    this.isMutable = false,
    isAbstract: boolean = false,
    isStatic: boolean = false,
    isPrivate: boolean = false,
    this.hasInitializer = false
  ) : super(type, isAbstract, isStatic, isPrivate);
}

/**
 * What a method does to the object it is called on.
 *
 * Nearly every method borrows its receiver, and says so by declaring nothing.
 * A release action ends the object's life, so it declares `this: Own<this>`
 * and may only be reached through the owner. See docs/design/ownership.md
 * §"Release consumes its receiver".
 */
export enum ReceiverKind {
  /** No receiver declared: borrowing, the default. */
  Implicit,
  /** `this: Borrow<this>` — the default, spelled out. */
  Borrowing,
  /** `this: Own<this>` — the method consumes what it is called on. */
  Owning,
  /** Declared, but not a receiver the language admits; already reported. */
  Invalid,
}

export final class MethodInfo extends MemberInfo {
  // TODO: Move to MemberInfo
  var isFinal: boolean;

  /**
   * The receiver this method declared. Call sites read it to keep a
   * consuming method out of reach of a borrow, and an override is checked
   * against the one it inherits — a receiver is part of the signature.
   */
  var receiverKind: ReceiverKind = ReceiverKind.Implicit;

  /** Whether this method consumes what it is called on. */
  consumesReceiver(): boolean { return this.receiverKind == ReceiverKind.Owning; }

  new(
    // TODO: Make this FunctionType
    type: Type,
    isAbstract: boolean = false,
    isStatic: boolean = false,
    isPrivate: boolean = false,
    this.isFinal = false
  ) : super(type, isAbstract, isStatic, isPrivate);
}

export final class RecordType(
  properties: HashMap<String, Type>,
  optionalProperties: HashSet<String> | null
) extends Type {
  // If this RecordType represents the constant namespace for an enum (e.g.
  // `Color`), this points back to the original AST node (`EnumDeclaration`).
  // This allows the code generator to bridge the gap between structural Record
  // properties and static enum literal generation, bypassing physical struct
  // allocation at runtime.
  var enumDeclaration: Statement | null = null;

  isOptional(name: String): boolean {
    let optionals = this.optionalProperties;
    return optionals != null && optionals.has(name);
  }

  hasOptionalProperties(): boolean {
    let optionals = this.optionalProperties;
    return optionals != null && optionals.size > 0;
  }
}

export final class FunctionType extends Type {
  parameters: Array<Type>;
  parameterNames: Array<String> | null = null;
  var returnType: Type;
  var typeParameters: Array<TypeParameterType> | null = null;
  var typeArguments: Array<Type> | null = null;
  var genericSource: FunctionType | null = null;
  var parameterInitializers: Array<Expression | null> | null = null;
  var parameterSymbols: Array<SymbolId> | null = null;
  var optionalParameters: Array<boolean> | null = null;
  var isFinal: boolean = false;
  var isAbstract: boolean = false;
  var overloads: GrowableArray<FunctionType> | null = null;
  var functionSymbolId: SymbolId = noSymbolId;
  var functionSymbolName: String = "";

  new(
    parameters: Array<Type>,
    parameterNames: Array<String> | null,
    returnType: Type
  ) : parameters = parameters,
      parameterNames = parameterNames,
      returnType = returnType,
      super();
}

export final class ClassType extends Type {
  id: TypeId;
  symbolId: SymbolId;
  name: String;
  var typeParameters: Array<TypeParameterType> | null = null;
  var typeArguments: Array<Type> | null = null;
  var superType: ClassType | null = null;
  var implementsList: GrowableArray<InterfaceType> = new GrowableArray<InterfaceType>();
  var mixins: GrowableArray<MixinType> = new GrowableArray<MixinType>();
  var classKey: String | null = null;
  /**
   * For the synthetic `This` class of a mixin declaration: the scope
   * key under which the mixin's private fields are namespaced in
   * every host class that applies it (shared across applications —
   * mixin privates are lexical to the mixin declaration). Null for
   * ordinary classes.
   */
  var privateScopeKey: String | null = null;
  /**
   * Declared `resource class` — the class has no unwrapped form, so naming it
   * bare in a type position is an error. Declares resource-ness, not
   * affineness: affineness comes from `Own<T>`. See
   * docs/design/ownership.md §"Resource-ness and affineness are different
   * properties".
   */
  var isResource: boolean = false;
  /**
   * The members of the class (fields, methods, and accessors).
   * Fields are preserved in their concrete memory layout order.
   * Superclass fields always appear first, followed by subclass fields.
   * If a subclass implements an abstract field or overrides a field type,
   * the field preserves its original position from the superclass.
   * This map is mutated incrementally by the checker during class resolution,
   * but is treated as immutable during codegen to emit `WasmStruct`s.
   */
  var members: OrderedMap<String, MemberInfo> = new OrderedMap<String, MemberInfo>();
  var constructorType: FunctionType | null = null;
  var fieldSetterNames: HashMap<String, String> | null = null;
  var isFinal = false;
  var isCaseClass = false;
  var isAbstract = false;
  var isExtension = false;
  var isSealed = false;
  var isMixinIntermediate = false;
  var onType: Type | null = null;
  var genericSource: ClassType | null = null;
  var declaredFields: HashSet<String> | null = null;
  var sealedVariants: GrowableArray<ClassType> | null = null;
  var forwardVariantNames: HashSet<String> | null = null;
  instantiations = new HashMap<String, ClassType>();

  /** The file path where this class was declared (set by the checker). */
  var sourcePath: String = "";

  // TODO: Implement a "copy constructor" or static `instantiate` method
  // that takes a generic class to copy. This will allow us to make as many
  // of these fields immutable as possible instead of reassigning them in
  // `instantiateClassType`.
  new(id: TypeId, symbolId: SymbolId, name: String) : id = id, symbolId = symbolId, name = name, super();

  /**
   * The original declaration this class was instantiated from:
   * follows genericSource to the root. Specializations of one
   * generic class compare equal through this; a non-generic class is
   * its own canonical.
   */
  canonical(): ClassType {
    var c = this;
    while (c.genericSource != null) {
      c = c.genericSource as ClassType;
    }
    return c;
  }
}

let substituteInType = (
  t: Type | null,
  typeParameters: Array<TypeParameterType> | null,
  typeArguments: Array<Type>
): Type | null => {
  if (t == null) return null;
  return match (t) {
    case TypeParameterType as tp: {
      var found: Type | null = null;
      if (typeParameters != null) {
        for (var i = 0; i < typeParameters.length; i += 1) {
          if (typeParameters[i] === tp && i < typeArguments.length) {
            found = typeArguments[i];
            break;
          }
        }
      }
      if (found != null) {
        found
      } else {
        tp
      }
    }
    case ArrayType {elementType}: {
      let subElem = substituteInType(elementType, typeParameters, typeArguments);
      if (subElem != null) {
        new ArrayType(subElem)
      } else {
        t
      }
    }
    case TupleType {elementTypes}: {
      let newElems = new GrowableArray<Type>();
      for (let el in elementTypes) {
        let sub = substituteInType(el, typeParameters, typeArguments);
        newElems.push((sub ?? el));
      }
      new TupleType(newElems)
    }
    case InlineTupleType {elementTypes}: {
      let newElems = new GrowableArray<Type>();
      for (let el in elementTypes) {
        let sub = substituteInType(el, typeParameters, typeArguments);
        newElems.push((sub ?? el));
      }
      new InlineTupleType(newElems)
    }
    case UnionType {types}: {
      let newTypes = new GrowableArray<Type>();
      for (let ut in types) {
        let sub = substituteInType(ut, typeParameters, typeArguments);
        newTypes.push((sub ?? ut));
      }
      new UnionType(newTypes)
    }
    case RecordType as rec: {
      let newProps = new HashMap<String, Type>();
      let keys = rec.properties.keys();
      while (let (true, key) = keys.next()) {
        let sub = substituteInType(rec.properties[key], typeParameters, typeArguments);
        newProps[key] = (sub ?? rec.properties[key]);
      }
      let newRec = new RecordType(newProps, rec.optionalProperties);
      newRec.enumDeclaration = rec.enumDeclaration;
      newRec
    }
    case FunctionType as ft: {
      let newParams = new GrowableArray<Type>();
      for (let p in ft.parameters) {
        let sub = substituteInType(p, typeParameters, typeArguments);
        newParams.push((sub ?? p));
      }
      let newRet = substituteInType(ft.returnType, typeParameters, typeArguments);
      let newFt = new FunctionType(newParams, ft.parameterNames, (newRet ?? ft.returnType));
      newFt.typeParameters = ft.typeParameters;
      newFt.typeArguments = ft.typeArguments;
      newFt.genericSource = ft.genericSource;
      newFt.parameterInitializers = ft.parameterInitializers;
      newFt.parameterSymbols = ft.parameterSymbols;
      newFt.optionalParameters = ft.optionalParameters;
      newFt.isFinal = ft.isFinal;
      newFt.isAbstract = ft.isAbstract;
      newFt.overloads = ft.overloads;
      newFt.functionSymbolId = ft.functionSymbolId;
      newFt.functionSymbolName = ft.functionSymbolName;
      newFt
    }
    case ClassType as ct: {
      var hasArgs = false;
      let ctArgsVal = new GrowableArray<Type>();
      let ctParams = (ct.genericSource ?? ct).typeParameters;
      if (ct.typeArguments != null) {
        hasArgs = true;
        let targs = ct.typeArguments as Array<Type>;
        var i = 0;
        let len = targs.length;
        while (i < len) {
          ctArgsVal.push(targs[i]);
          i += 1;
        }
      } else if (typeParameters != null && ctParams != null) {
        hasArgs = true;
        var i = 0;
        let len = ctParams.length;
        while (i < len) {
          ctArgsVal.push(ctParams[i] as Type);
          i += 1;
        }
      }
      if (hasArgs && ctArgsVal.length > 0) {
        let newArgs = new GrowableArray<Type>(ctArgsVal.length);
        for (let arg in ctArgsVal) {
          let sub = substituteInType(arg, typeParameters, typeArguments);
          newArgs.push((sub ?? arg));
        }

        let inst = new ClassType(ct.id, ct.symbolId, ct.name);
        inst.typeParameters = ctParams;
        inst.typeArguments = newArgs;
        inst.genericSource = ct.genericSource ?? ct;
        let combinedParams = new GrowableArray<TypeParameterType>();
        let combinedArgs = new GrowableArray<Type>();
        if (ctParams != null) {
          for (let p in ctParams) {
            combinedParams.push(p);
          }
          for (let a in newArgs) {
            combinedArgs.push(a);
          }
        }
        if (typeParameters != null) {
          for (let p in typeParameters) {
            combinedParams.push(p);
          }
          for (let a in typeArguments) {
            combinedArgs.push(a);
          }
        }

        if (ct.superType != null) {
          let subSuper = substituteInType(ct.superType, combinedParams, combinedArgs);
          inst.superType = (subSuper ?? ct.superType) as ClassType;
        }
        for (let impl in ct.implementsList) {
          let subImpl = substituteInType(impl, combinedParams, combinedArgs);
          inst.implementsList.push((subImpl ?? impl) as InterfaceType);
        }
        for (let m in ct.mixins) {
          let subM = substituteInType(m, combinedParams, combinedArgs);
          inst.mixins.push((subM ?? m) as MixinType);
        }
        inst.constructorType = if (ct.constructorType != null) {
          let ctor = ct.constructorType as FunctionType;
          let newParams = new GrowableArray<Type>();
          for (let p in ctor.parameters) {
            let sub = substituteInType(p, combinedParams, combinedArgs);
            newParams.push((sub ?? p));
          }
          let newFt = new FunctionType(newParams, ctor.parameterNames, ctor.returnType);
          newFt.parameterInitializers = ctor.parameterInitializers;
          newFt.parameterSymbols = ctor.parameterSymbols;
          newFt.optionalParameters = ctor.optionalParameters;
          newFt.functionSymbolId = ctor.functionSymbolId;
          newFt.functionSymbolName = ctor.functionSymbolName;
          newFt
        } else {
          null
        };
        inst.fieldSetterNames = ct.fieldSetterNames;
        inst.isFinal = ct.isFinal;
        inst.isCaseClass = ct.isCaseClass;
        // Resource-ness is a property of the class, uniform across every
        // mention of it (ownership.md §"Resource-ness and affineness are
        // separate"), so an instantiation of a generic resource class is
        // still a resource class. Codegen keys the hidden lifecycle field
        // off this flag, and an instantiation that dropped it would get
        // no field and silently skip disown/adopt's state check.
        inst.isResource = ct.isResource;
        inst.isAbstract = ct.isAbstract;
        inst.isExtension = ct.isExtension;
        inst.isSealed = ct.isSealed;
        inst.isMixinIntermediate = ct.isMixinIntermediate;
        inst.privateScopeKey = ct.privateScopeKey;
        inst.sealedVariants = ct.sealedVariants;
        inst.declaredFields = ct.declaredFields;
        inst.forwardVariantNames = ct.forwardVariantNames;
        inst.members = ct.members;
        if (ct.onType != null) {
          inst.onType = substituteInType(ct.onType, combinedParams, combinedArgs);
        }
        inst.sourcePath = ct.sourcePath;
        inst
      } else {
        ct
      }
    }
    case InterfaceType as it: {
      var hasArgs = false;
      let itArgsVal = new GrowableArray<Type>();
      let itParams = (it.genericSource ?? it).typeParameters;
      if (it.typeArguments != null) {
        hasArgs = true;
        let targs = it.typeArguments as Array<Type>;
        var i = 0;
        let len = targs.length;
        while (i < len) {
          itArgsVal.push(targs[i]);
          i += 1;
        }
      } else if (typeParameters != null && itParams != null) {
        hasArgs = true;
        var i = 0;
        let len = itParams.length;
        while (i < len) {
          itArgsVal.push(itParams[i] as Type);
          i += 1;
        }
      }
      if (hasArgs && itArgsVal.length > 0) {
        let newArgs = new GrowableArray<Type>();
        for (let arg in itArgsVal) {
          let sub = substituteInType(arg, typeParameters, typeArguments);
          newArgs.push((sub ?? arg));
        }
        let inst = new InterfaceType(it.id, it.symbolId, it.name);
        inst.typeParameters = itParams;
        inst.typeArguments = newArgs;
        inst.genericSource = it.genericSource ?? it;
        let combinedParams = new GrowableArray<TypeParameterType>();
        let combinedArgs = new GrowableArray<Type>();
        if (itParams != null) {
          for (let p in itParams) {
            combinedParams.push(p);
          }
          for (let a in newArgs) {
            combinedArgs.push(a);
          }
        }
        if (typeParameters != null) {
          for (let p in typeParameters) {
            combinedParams.push(p);
          }
          for (let a in typeArguments) {
            combinedArgs.push(a);
          }
        }
        let newExtends = new GrowableArray<InterfaceType>();
        for (let ext in it.extendsList) {
          let subExt = substituteInType(ext, combinedParams, combinedArgs);
          newExtends.push((subExt ?? ext) as InterfaceType);
        }
        inst.extendsList = newExtends;
        inst.members = it.members;
        inst.sourcePath = it.sourcePath;
        inst
      } else {
        it
      }
    }
    case TypeAliasType as alias: {
      var hasArgs = false;
      let aliasArgsVal = new GrowableArray<Type>();
      let aliasParams = alias.typeParameters;
      if (alias.typeArguments != null) {
        hasArgs = true;
        let targs = alias.typeArguments as Array<Type>;
        var i = 0;
        let len = targs.length;
        while (i < len) {
          aliasArgsVal.push(targs[i]);
          i += 1;
        }
      } else if (typeParameters != null && aliasParams != null) {
        hasArgs = true;
        var i = 0;
        let len = aliasParams.length;
        while (i < len) {
          aliasArgsVal.push(aliasParams[i] as Type);
          i += 1;
        }
      }
      if (hasArgs && aliasArgsVal.length > 0) {
        let newArgs = new GrowableArray<Type>();
        for (let arg in aliasArgsVal) {
          let sub = substituteInType(arg, typeParameters, typeArguments);
          newArgs.push((sub ?? arg));
        }
        let inst = new TypeAliasType(
          alias.name,
          alias.typeParameters,
          alias.target,
          alias.isDistinct,
          newArgs,
          alias.isOpaque,
          alias.declaringModule
        );
        inst
      } else {
        alias
      }
    }
    case MixinType as mt: {
      var hasArgs = false;
      let mtArgsVal = new GrowableArray<Type>();
      let mtParams = mt.typeParameters;
      if (mt.typeArguments != null) {
        hasArgs = true;
        let targs = mt.typeArguments as Array<Type>;
        var i = 0;
        let len = targs.length;
        while (i < len) {
          mtArgsVal.push(targs[i]);
          i += 1;
        }
      } else if (typeParameters != null && mtParams != null) {
        hasArgs = true;
        var i = 0;
        let len = mtParams.length;
        while (i < len) {
          mtArgsVal.push(mtParams[i] as Type);
          i += 1;
        }
      }
      if (hasArgs && mtArgsVal.length > 0) {
        let newArgs = new GrowableArray<Type>();
        for (let arg in mtArgsVal) {
          let sub = substituteInType(arg, typeParameters, typeArguments);
          newArgs.push((sub ?? arg));
        }
        let inst = new MixinType(mt.name);
        inst.typeParameters = mtParams;
        inst.typeArguments = newArgs;
        inst.genericSource = mt.genericSource ?? mt;
        inst.onType = mt.onType;
        inst.members = mt.members;
        inst.sourcePath = mt.sourcePath;
        inst
      } else {
        mt
      }
    }
    case _: t
  };
};

/**
 * Identity suffix for a nominal type, so that two same-named
 * declarations never share a cache entry. Mirrors codegen's
 * `getTypeKeyForSpecialization`: the declaring Symbol when there is
 * one, else the TypeId. Both are copied onto every instantiation and
 * substitution copy, so `Foo<i32>` keys the same however it was
 * reached — unlike `Type.uid`, which is fresh per object.
 */
let nominalIdentity = (name: String, symbolId: SymbolId, typeId: TypeId): String =>
  if (symbolId != noSymbolId) {
    name + "#s" + i32ToString(symbolId as i32)
  } else {
    name + "#t" + i32ToString(typeId as i32)
  };

/**
 * Cache key for one type argument. A type parameter keys by identity
 * (name plus the base Type uid) at any nesting depth: same-named
 * parameters of different declarations are different parameters and
 * must not share a cached instantiation. This matters doubly because
 * instantiate* re-assigns the cached object's fields on every call, so
 * a key collision would not just return the wrong object, it would
 * mutate the shared one.
 *
 * Nominal types key by identity for the same reason, and it is not
 * hypothetical: the `instantiations` cache hangs off the generic
 * source, and a generic source in the stdlib outlives any one entry
 * point. Keying `class Item` as `"Item"` let two entry points sharing
 * one `Compiler` collide on `Iterable`'s cache — the second got the
 * first's `Iterable<Item>` object, complete with the `interfaceKey`
 * codegen had already cached on it, and emitted an interface
 * trampoline that downcast its receiver to the wrong struct.
 *
 * Composite arms mirror typeToString and recurse; anything that cannot
 * embed a type parameter falls through to typeToString.
 */
let instantiationKeyOf = (t: Type): String => match (t) {
  case TypeParameterType as tp: tp.name + "#" + i32ToString(tp.uid)
  case ArrayType {elementType}: "Array<" + instantiationKeyOf(elementType) + ">"
  case TupleType {elementTypes}: {
    var s = "[";
    var first = true;
    for (let elem in elementTypes) {
      if (!first) { s = s + ","; }
      first = false;
      s = s + instantiationKeyOf(elem);
    }
    s + "]"
  }
  case InlineTupleType {elementTypes}: {
    var s = "(";
    var first = true;
    for (let elem in elementTypes) {
      if (!first) { s = s + ","; }
      first = false;
      s = s + instantiationKeyOf(elem);
    }
    s + ")"
  }
  case UnionType {types}: {
    var s = "";
    var first = true;
    for (let member in types) {
      if (!first) { s = s + "|"; }
      first = false;
      s = s + instantiationKeyOf(member);
    }
    s
  }
  case RecordType {properties}: {
    var s = "{";
    var first = true;
    for (let key in properties.keys()) {
      if (!first) { s = s + ","; }
      first = false;
      s = s + key + ":" + instantiationKeyOf(properties[key]);
    }
    s + "}"
  }
  case FunctionType as ft: {
    var s = "(";
    var first = true;
    for (let param in ft.parameters) {
      if (!first) { s = s + ","; }
      first = false;
      s = s + instantiationKeyOf(param);
    }
    s + ")=>" + instantiationKeyOf(ft.returnType)
  }
  case ClassType as ct: {
    let src = ct.genericSource ?? ct;
    let base = nominalIdentity(ct.name, src.symbolId, src.id);
    if (ct.typeArguments != null) {
      namedKey(base, ct.typeArguments as Array<Type>)
    } else {
      base
    }
  }
  case InterfaceType as it: {
    let src = it.genericSource ?? it;
    let base = nominalIdentity(it.name, src.symbolId, src.id);
    if (it.typeArguments != null) {
      namedKey(base, it.typeArguments as Array<Type>)
    } else {
      base
    }
  }
  case MixinType as mt: {
    // MixinType carries no Symbol or TypeId; `sourcePath` plus the name
    // is what `getMixinKey` already treats as a mixin's identity.
    let src = mt.genericSource ?? mt;
    let base = mt.name + "#m" + src.sourcePath;
    if (mt.typeArguments != null) {
      namedKey(base, mt.typeArguments as Array<Type>)
    } else {
      base
    }
  }
  case TypeAliasType as ta: {
    // Aliases have no generic source to normalise through, so key by
    // the declaring module — two aliases of one name cannot share it.
    let base = ta.name + "#a" + ta.declaringModule;
    if (ta.typeArguments != null) {
      namedKey(base, ta.typeArguments as Array<Type>)
    } else {
      base
    }
  }
  case _: typeToString(t)
};

/** `Name<key,key,...>` for a generic nominal type's cache key. */
let namedKey = (name: String, args: Array<Type>): String => {
  var s = name + "<";
  var i = 0;
  let len = args.length;
  while (i < len) {
    if (i > 0) { s = s + ","; }
    s = s + instantiationKeyOf(args[i]);
    i += 1;
  }
  return s + ">";
};

let toGrowable = (arr: Array<Type>): GrowableArray<Type> => {
  if (arr is GrowableArray<Type>) {
    return arr as GrowableArray<Type>;
  }
  let g = new GrowableArray<Type>(arr.length);
  var i = 0;
  let len = arr.length;
  while (i < len) {
    g.push(arr[i]);
    i += 1;
  }
  return g;
};

let getInstantiationKey = (typeArguments: Array<Type>): String => {
  var sb = "";
  var i = 0;
  let len = typeArguments.length;
  while (i < len) {
    if (i > 0) {
      sb = sb + ",";
    }
    sb = sb + instantiationKeyOf(typeArguments[i]);
    i += 1;
  }
  return sb;
};

/**
 * Create an instantiated copy of a generic ClassType with concrete type arguments.
 * This is a factory function that properly initializes all fields from the source.
 */

export let instantiateClassType = (
  source: ClassType,
  typeArguments: Array<Type>,
): ClassType => {
  let key = getInstantiationKey(typeArguments);
  let result = if (let (true, cached) = source.instantiations.get(key)) {
    cached
  } else {
    let res = new ClassType(source.id, source.symbolId, source.name);
    source.instantiations[key] = res;
    res
  };
  result.typeParameters = source.typeParameters;
  result.typeArguments = toGrowable(typeArguments);
  result.genericSource = source;
  result.superType = if (source.superType != null) {
    let subSuper = substituteInType(source.superType as Type, source.typeParameters, typeArguments);
    (subSuper ?? source.superType) as ClassType
  } else {
    null
  };
  // Copy and substitute implementsList entries
  result.implementsList = new GrowableArray<InterfaceType>();
  var i = 0;
  while (i < source.implementsList.length) {
    let subImpl = substituteInType(source.implementsList[i] as Type, source.typeParameters, typeArguments);
    result.implementsList.push((subImpl ?? source.implementsList[i]) as InterfaceType);
    i += 1;
  }
  // Copy and substitute mixins list
  result.mixins = new GrowableArray<MixinType>();
  for (let m in source.mixins) {
    let subM = substituteInType(m, source.typeParameters, typeArguments);
    result.mixins.push((subM ?? m) as MixinType);
  }
  result.members = source.members;
  result.constructorType = if (source.constructorType != null) {
    let ctor = source.constructorType as FunctionType;
    let newParams = new GrowableArray<Type>();
    for (let p in ctor.parameters) {
      let sub = substituteInType(p, source.typeParameters, typeArguments);
      newParams.push((sub ?? p));
    }
    let newFt = new FunctionType(newParams, ctor.parameterNames, ctor.returnType);
    newFt.parameterInitializers = ctor.parameterInitializers;
    newFt.parameterSymbols = ctor.parameterSymbols;
    newFt.optionalParameters = ctor.optionalParameters;
    newFt.functionSymbolId = ctor.functionSymbolId;
    newFt.functionSymbolName = ctor.functionSymbolName;
    newFt
  } else {
    null
  };
  result.fieldSetterNames = source.fieldSetterNames;
  result.isFinal = source.isFinal;
  result.isCaseClass = source.isCaseClass;
  // See the matching copy in instantiateClassType: resource-ness is
  // declared at the class and survives instantiation.
  result.isResource = source.isResource;
  result.isAbstract = source.isAbstract;
  result.isExtension = source.isExtension;
  if (source.isExtension) {
    result.onType = substituteInType(source.onType, source.typeParameters, typeArguments);
  }
  result.isSealed = source.isSealed;
  result.isMixinIntermediate = source.isMixinIntermediate;
  result.privateScopeKey = source.privateScopeKey;
  result.sourcePath = source.sourcePath;
  result.sealedVariants = source.sealedVariants;
  result.declaredFields = source.declaredFields;
  result.forwardVariantNames = source.forwardVariantNames;
  
  return result;
};

export let instantiateFunctionType = (
  source: FunctionType,
  typeArguments: Array<Type>,
): FunctionType => {
  let newParams = new GrowableArray<Type>();
  for (let p in source.parameters) {
    let sub = substituteInType(p, source.typeParameters, typeArguments);
    newParams.push((sub ?? p));
  }
  let newRet = substituteInType(source.returnType, source.typeParameters, typeArguments);
  let newFt = new FunctionType(newParams, source.parameterNames, (newRet ?? source.returnType));
  newFt.typeParameters = null;
  newFt.typeArguments = toGrowable(typeArguments);
  newFt.genericSource = source.genericSource ?? source;
  newFt.parameterInitializers = source.parameterInitializers;
  newFt.parameterSymbols = source.parameterSymbols;
  newFt.optionalParameters = source.optionalParameters;
  newFt.isFinal = source.isFinal;
  newFt.isAbstract = source.isAbstract;
  newFt.overloads = source.overloads;
  newFt.functionSymbolId = source.functionSymbolId;
  newFt.functionSymbolName = source.functionSymbolName;
  return newFt;
};

export final class InterfaceType extends Type {
  id: TypeId;
  symbolId: SymbolId;
  name: String;
  var typeParameters: Array<TypeParameterType> | null = null;
  var typeArguments: Array<Type> | null = null;
  var extendsList: GrowableArray<InterfaceType> = new GrowableArray<InterfaceType>();
  var members: OrderedMap<String, MemberInfo> = new OrderedMap<String, MemberInfo>();
  var genericSource: InterfaceType | null = null;
  var interfaceKey: String | null = null;
  var sourcePath: String = "";
  instantiations = new HashMap<String, InterfaceType>();

  new(id: TypeId, symbolId: SymbolId, name: String) : id = id, symbolId = symbolId, name = name, super();
}

/**
 * Create an instantiated copy of a generic InterfaceType with concrete type arguments.
 */
export let instantiateInterfaceType = (
  source: InterfaceType,
  typeArguments: Array<Type>,
): InterfaceType => {
  let key = getInstantiationKey(typeArguments);
  let result = if (let (true, cached) = source.instantiations.get(key)) {
    cached
  } else {
    let res = new InterfaceType(source.id, source.symbolId, source.name);
    source.instantiations[key] = res;
    res
  };
  result.typeParameters = source.typeParameters;
  result.typeArguments = toGrowable(typeArguments);
  result.genericSource = source;
  // Sharing mutable arrays is technically unsafe, but we never modify these
  // after instantiation so it should be fine in practice. If this becomes an
  // issue we can copy the arrays here.
  result.extendsList = source.extendsList;
  result.members = source.members;
  result.sourcePath = source.sourcePath;
  return result;
};

/**
 * MixinKey serves as a mixin declaration key (uniquely identified by sourcePath
 * and name) rather than a type key. While MixinType represents a specific type-parameterized
 * instantiation (e.g. MyMixin<i32> vs MyMixin<String>), MixinKey is used during codegen layout
 * and reachability analysis to identify the base mixin declaration itself, ensuring that
 * mixin fields/methods are mixed in only once and RTA lookups find all target classes.
 */
export final class MixinKey implements Hashable {
  sourcePath: String;
  name: String;
  new(this.sourcePath, this.name);

  hashCode(): i32 {
    return hash(this.sourcePath) ^ hash(this.name);
  }

  operator ==(other: MixinKey): boolean {
    return this.sourcePath == other.sourcePath && this.name == other.name;
  }
}

export final class MixinType extends Type {
  name: String;
  var symbolId: SymbolId = noSymbolId;
  var typeParameters: Array<TypeParameterType> | null = null;
  var typeArguments: Array<Type> | null = null;
  var onType: Type | null = null;
  var members: OrderedMap<String, MemberInfo> = new OrderedMap<String, MemberInfo>();
  var genericSource: MixinType | null = null;
  var sourcePath: String = "";
  var mixins: GrowableArray<MixinType> = new GrowableArray<MixinType>();
  var mixinKeyCache: MixinKey | null = null;
  /**
   * Scope key namespacing this mixin's private fields in host
   * classes (see ClassType.privateScopeKey). Set at mixin
   * registration on the declaration's MixinType; instantiations
   * reach it through genericSource.
   */
  var privateScopeKey: String | null = null;
  instantiations = new HashMap<String, MixinType>();

  new(name: String) : name = name, super();
}

export let instantiateMixinType = (
  source: MixinType,
  typeArguments: Array<Type>,
): MixinType => {
  let key = getInstantiationKey(typeArguments);
  let result = if (let (true, cached) = source.instantiations.get(key)) {
    cached
  } else {
    let res = new MixinType(source.name);
    source.instantiations[key] = res;
    res
  };
  result.symbolId = source.symbolId;
  result.privateScopeKey = source.privateScopeKey;
  result.typeParameters = source.typeParameters;
  result.typeArguments = toGrowable(typeArguments);
  result.genericSource = source;
  result.onType = source.onType;
  result.members = source.members;
  result.sourcePath = source.sourcePath;
  result.mixins = new GrowableArray<MixinType>();
  // Copy and substitute mixins
  for (let m in source.mixins) {
    let subM = substituteInType(m, source.typeParameters, typeArguments);
    result.mixins.push((subM ?? m) as MixinType);
  }
  return result;
};

export final class TypeParameterType extends Type {
  name: String;
  var constraint: Type | null;
  var defaultType: Type | null;

  new(this.name, this.constraint, this.defaultType) : super();
}


export final class TypeAliasType(
  name: String,
  var typeParameters: Array<TypeParameterType> | null,
  var target: Type,
  isDistinct: boolean,
  var typeArguments: Array<Type> | null,
  /**
   * True for `opaque type X = Y`. Always implies `isDistinct`, so the nominal
   * behaviour (assignability, erasure, codegen) needs no extra cases — the
   * only thing opacity adds is that casting *to* this alias is restricted to
   * `declaringModule`. See docs/design/opaque-types.md.
   */
  isOpaque: boolean,
  /**
   * Canonical path of the module that declared this alias, in the same string
   * space as `Symbol.modulePath` and `CheckerContext.filePath`. Empty for
   * synthesized aliases (enum backing types) that are never opaque.
   */
  declaringModule: String
) extends Type {
  /**
   * Ephemeral flag used by the checker to detect generic type resolution cycles.
   * When this is true, the checker is currently computing this alias's target.
   * If a code path reads `target` while `.resolving` is true, it MUST stop
   * unwrapping and treat this TypeAliasType as an opaque bound. Otherwise,
   * recursive aliases (e.g., `type T = T[]`) will trigger an infinite loop.
   */
  var resolving: boolean = false;
}

/**
 * Whether `t` is one of the three ownership handles from `zena:ownership`.
 * A `resource class` may only be named as a type argument of one of these —
 * see docs/design/ownership.md §"Resource-ness and affineness are different
 * properties".
 */
export let isOwnershipWrapper = (t: Type): boolean => {
  if (!(t is TypeAliasType)) { return false; }
  if (!t.isDistinct) { return false; }
  return t.name == "Own" || t.name == "Borrow" || t.name == "Unmanaged";
};

/**
 * The sole non-null member of a `T | null` union, or null when `t` is
 * not exactly that shape. `using` and implicit drop accept a nullable
 * handle by skipping the release when the value is null, so both the
 * checker and lowering peel exactly this union form; wider unions have
 * no single release path and stay rejected.
 */
export let soleNonNullMember = (t: Type): Type | null => {
  if (!(t is UnionType)) { return null; }
  var nonNull: Type | null = null;
  var sawNull = false;
  for (let m in t.types) {
    if (m is NullType) {
      sawNull = true;
    } else {
      if (nonNull != null) { return null; }
      nonNull = m;
    }
  }
  if (!sawNull) { return null; }
  return nonNull;
};

/** The name of the handle `t` is, or "" if it is not one. */
export let ownershipHandleName = (t: Type): String => {
  if (!isOwnershipWrapper(t)) { return ""; }
  return (t as TypeAliasType).name;
};

/**
 * The resource type behind a handle, or null if `t` is not a handle.
 *
 * This reads `typeArguments` rather than following `target`, and the
 * difference is load-bearing: the handles are *generic* aliases, so
 * `Own<T> = T` has the bare type parameter as its target. Walking `target`
 * — which is what `unwrapAliases` does — lands on `T` rather than on the
 * resource, so a caller that wants the class must come through here.
 */
export let ownershipHandleInner = (t: Type): Type | null => {
  if (!isOwnershipWrapper(t)) { return null; }
  let args = (t as TypeAliasType).typeArguments;
  if (args == null) { return null; }
  if (args.length != 1) { return null; }
  return args[0];
};

export let typeContainsTypeParameter = (t: Type): boolean => {
  return match (t) {
    case TypeParameterType: true
    case UnionType {types}: {
      for (let subtype in types) {
        if (typeContainsTypeParameter(subtype)) { return true; }
      }
      false
    }
    case ArrayType {elementType}: typeContainsTypeParameter(elementType)
    case TupleType {elementTypes}: {
      for (let elem in elementTypes) {
        if (typeContainsTypeParameter(elem)) { return true; }
      }
      false
    }
    case InlineTupleType {elementTypes}: {
      for (let elem in elementTypes) {
        if (typeContainsTypeParameter(elem)) { return true; }
      }
      false
    }
    case RecordType {properties}: {
      for (let pair in properties) {
        if (typeContainsTypeParameter(pair.value)) { return true; }
      }
      false
    }
    case FunctionType as ft: {
      for (let param in ft.parameters) {
        if (typeContainsTypeParameter(param)) { return true; }
      }
      typeContainsTypeParameter(ft.returnType)
    }
    case ClassType as ct: {
      let {typeParameters} = ct;
      if (typeParameters != null && typeParameters.length > 0 && ct.typeArguments == null) {
        return true;
      }
      if (ct.typeArguments != null) {
        let targs = ct.typeArguments as Array<Type>;
        var i = 0;
        let len = targs.length;
        while (i < len) {
          if (typeContainsTypeParameter(targs[i])) { return true; }
          i += 1;
        }
      }
      false
    }
    case InterfaceType as it: {
      let {typeParameters} = it;
      if (typeParameters != null && typeParameters.length > 0 && it.typeArguments == null) {
        return true;
      }
      if (it.typeArguments != null) {
        let targs = it.typeArguments as Array<Type>;
        var i = 0;
        let len = targs.length;
        while (i < len) {
          if (typeContainsTypeParameter(targs[i])) { return true; }
          i += 1;
        }
      }
      false
    }
    case TypeAliasType as ta: {
      let {typeParameters} = ta;
      if (typeParameters != null && typeParameters.length > 0 && ta.typeArguments == null) {
        return true;
      }
      if (ta.typeArguments != null) {
        let targs = ta.typeArguments as Array<Type>;
        var i = 0;
        let len = targs.length;
        while (i < len) {
          if (typeContainsTypeParameter(targs[i])) { return true; }
          i += 1;
        }
      }
      false
    }
    case MixinType as mt: {
      let {typeParameters} = mt;
      if (typeParameters != null && typeParameters.length > 0 && mt.typeArguments == null) {
        return true;
      }
      if (mt.typeArguments != null) {
        let targs = mt.typeArguments as Array<Type>;
        var i = 0;
        let len = targs.length;
        while (i < len) {
          if (typeContainsTypeParameter(targs[i])) { return true; }
          i += 1;
        }
      }
      let {onType} = mt;
      if (onType != null && typeContainsTypeParameter(onType)) {
        return true;
      }
      false
    }
    case _: false
  };
};

export let instantiateTypeAliasType = (
  source: TypeAliasType,
  typeArguments: Array<Type>
): TypeAliasType => {
  return new TypeAliasType(
    source.name,
    source.typeParameters,
    source.target, // We substitute the target in the checker since it needs the map
    source.isDistinct,
    typeArguments,
    source.isOpaque,
    source.declaringModule
  );
};

export type GenericNamedType = ClassType | InterfaceType | MixinType | TypeAliasType;

export final class SymbolType(
  id: TypeId,
  debugName: String | null
) extends Type

export final class ThisType extends Type {
  new() : super();
}

/**
 * Check if a type is a numeric primitive.
 */
export let isNumericType = (t: Type): boolean => match (baseType(t)) {
  case I32Type: true
  case U32Type: true
  case I64Type: true
  case U64Type: true
  case F32Type: true
  case F64Type: true
  case U8Type: true
  case U16Type: true
  case I8Type: true
  case I16Type: true
  case _: false
};

/**
 * Check if a type is an integer type.
 */
export let isIntegerType = (t: Type): boolean => match (baseType(t)) {
  case I32Type: true
  case U32Type: true
  case I64Type: true
  case U64Type: true
  case U8Type: true
  case U16Type: true
  case I8Type: true
  case I16Type: true
  case _: false
};

/**
 * Check if a type is one of the narrow integer types — the ones stored in
 * fewer than 32 bits and promoted before use.
 */
export let isNarrowIntType = (t: Type): boolean => match (baseType(t)) {
  case U8Type: true
  case U16Type: true
  case I8Type: true
  case I16Type: true
  case _: false
};

/**
 * Check if an integer type is unsigned. Signedness drives operator
 * selection (`_u` vs `_s` variants) and cast normalization.
 */
export let isUnsignedIntType = (t: Type): boolean => match (baseType(t)) {
  case U32Type: true
  case U64Type: true
  case U8Type: true
  case U16Type: true
  case _: false
};

/**
 * Storage width in bits of a narrow integer type, or 32 for everything
 * else. Used to build the normalizing mask/sign-extend on a cast.
 */
export let narrowIntBits = (t: Type): i32 => match (baseType(t)) {
  case U8Type: 8
  case I8Type: 8
  case U16Type: 16
  case I16Type: 16
  case _: 32
};

/**
 * The 32-bit type a narrow integer promotes to. Non-narrow types are
 * returned unchanged, so this is safe to apply to any operand.
 */
export let promoteNarrowInt = (t: Type): Type => match (baseType(t)) {
  case U8Type: new U32Type()
  case U16Type: new U32Type()
  case I8Type: new I32Type()
  case I16Type: new I32Type()
  case _: t
};

/**
 * Check if a type is a floating point type.
 */
export let isFloatType = (t: Type): boolean => match (baseType(t)) {
  case F32Type: true
  case F64Type: true
  case _: false
};

/**
 * Check if a type is a 64-bit type.
 */
export let is64BitType = (t: Type): boolean => match (baseType(t)) {
  case I64Type: true
  case U64Type: true
  case F64Type: true
  case _: false
};

/**
 * Check if a type is a Wasm GC reference type.
 */
export let isRefType = (t: Type): boolean => {
  let b = baseType(t);
  return b is RecordType || b is ClassType || b is ArrayType || 
         b is InterfaceType || b is TypeParameterType || b is ThisType || 
         b is AnyRefType || b is EqRefType || b is FunctionType || 
         b is TupleType || b is NullType || b is UnionType || b is StringLiteralType ||
         b is StringLiteralType;
};

export let isVoidOrNeverType = (t: Type): boolean => {
  let b = baseType(t);
  return b is VoidType || b is NeverType || b is HoleType;
};

/**
 * How many arguments a call must actually supply.
 *
 * Optional parameters are omittable, and so are ZERO-WIDTH ones. A
 * `void` parameter carries no value: codegen erases it (it takes no
 * wasm slot), and there is no way to spell a `void` argument except by
 * calling a void-returning function. That is what makes `void` usable
 * as a type argument — `Completer<void>` instantiates
 * `complete(value: T)` into a parameter nothing can be passed for, so
 * callers write `c.complete()`.
 *
 * Omitting is permitted, not required: an explicit void-typed
 * expression still type-checks in the slot, and still runs for its
 * side effects.
 *
 * Counting (rather than position-matching) is safe here because void
 * accepts nothing but void: an argument that slides into a void
 * parameter's position fails its own assignability check.
 */
export let requiredParameterCount = (
    parameters: Array<Type>, optionals: Array<boolean> | null): i32 => {
  var required = 0;
  for (var i = 0; i < parameters.length; i += 1) {
    let isOptional = if (optionals != null) {
      i < optionals.length && optionals[i]
    } else {
      false
    };
    if (!isOptional && !isVoidOrNeverType(parameters[i])) {
      required += 1;
    }
  }
  return required;
};

/**
 * Get the name of a numeric type.
 */
export let numericTypeName = (t: Type): String => match (t) {
  case I32Type: "i32"
  case U32Type: "u32"
  case I64Type: "i64"
  case U64Type: "u64"
  case F32Type: "f32"
  case F64Type: "f64"
  case U8Type: "u8"
  case U16Type: "u16"
  case I8Type: "i8"
  case I16Type: "i16"
  case _: "unknown"
};

/**
 * Check if a type is a boolean or boolean literal.
 */
export let isBooleanLike = (t: Type): boolean => match (t) {
  case BooleanType: true
  case BoolLiteralType {}: true
  case UnionType {types}: {
    var allBool = true;
    for (let member in types) {
      if (!isBooleanLike(member)) {
        allBool = false;
      }
    }
    allBool
  }
  case _: false
};

/**
 * Get the base type of a literal type, or the type itself if not literal.
 */
export let baseType = (t: Type): Type => match (t) {
  case BoolLiteralType {}: new BooleanType()
  case NumLiteralType {raw}: {
    var isFloat = false;
    var i = 0;
    while (i < raw.length) {
      if (raw.getByteAt(i) == 46) { // '.'
        isFloat = true;
        break;
      }
      i += 1;
    }
    if (isFloat) new F64Type() else new I32Type()
  }
  case _: t
};

/**
 * Compute the promoted numeric type for a binary operation.
 * Returns null if the types are incompatible.
 */
export let promoteNumeric = (leftOrig: Type, rightOrig: Type): Type | null => {
  let leftLit = match (leftOrig) { case NumLiteralType: baseType(leftOrig) case _: leftOrig };
  let rightLit = match (rightOrig) { case NumLiteralType: baseType(rightOrig) case _: rightOrig };
  // Narrow integers are storage widths, not arithmetic widths: each side
  // promotes to its 32-bit counterpart before anything else is decided.
  // Mixed sizes within one signedness therefore just work (u8 + u16 is
  // u32), while mixed signedness stays an error at every width, and a
  // narrow type never survives the operation.
  let left = promoteNarrowInt(leftLit);
  let right = promoteNarrowInt(rightLit);
  // f64 dominates everything
  if (left is F64Type || right is F64Type) {
    return new F64Type();
  }
  // f32 + 64-bit → f64
  if (left is F32Type && is64BitType(right)) {
    return new F64Type();
  }
  if (right is F32Type && is64BitType(left)) {
    return new F64Type();
  }
  // f32 dominates remaining
  if (left is F32Type || right is F32Type) {
    return new F32Type();
  }
  // u64 dominates integers
  if (left is U64Type || right is U64Type) {
    // Reject mixed signedness: u64 + i32/i64 is an error
    if (left is U64Type && right is U64Type) {
      return new U64Type();
    }
    return null;
  }
  // i64 dominates remaining integers
  if (left is I64Type || right is I64Type) {
    return new I64Type();
  }
  // Same signedness 32-bit integers
  if (left is U32Type && right is U32Type) {
    return new U32Type();
  }
  if (left is I32Type && right is I32Type) {
    return new I32Type();
  }
  // Mixed signedness i32/u32 — reject
  if (isIntegerType(left) && isIntegerType(right)) {
    return null;
  }
  return null;
};

/**
 * Parse the magnitude of an integer literal, reporting overflow rather
 * than wrapping. `raw` is the literal's source text without a sign;
 * underscores are ignored and a `0x` prefix selects hex. Returns
 * `(false, _)` for a malformed literal or one that does not fit in 64
 * bits, which is the widest magnitude any Zena integer type can hold.
 */
export let integerLiteralMagnitude = (raw: String): inline (boolean, u64) => {
  var start = 0;
  var isHex = false;
  if (start + 2 <= raw.length) {
    let c0 = raw.getByteAt(start);
    let c1 = raw.getByteAt(start + 1);
    if (c0 == 48 && (c1 == 120 || c1 == 88)) { // '0' then 'x'/'X'
      isHex = true;
      start = start + 2;
    }
  }

  // Largest value that can still absorb another digit, and the largest
  // digit it can absorb: u64Max / base and u64Max % base. Written as
  // constants because `/` on integers promotes to a float in Zena.
  let limit = if (isHex) 1152921504606846975 as u64 else 1844674407370955161 as u64;
  let lastDigit = if (isHex) 15 as u64 else 5 as u64;
  let base = if (isHex) 16 as u64 else 10 as u64;

  var res = 0 as u64;
  var i = start;
  var hasDigits = false;
  while (i < raw.length) {
    let code = raw.getByteAt(i);
    if (code == 95) { // '_'
      i += 1;
      continue;
    }
    var digit = 0 as u64;
    if (code >= 48 && code <= 57) { // '0'..'9'
      digit = (code - 48) as u64;
    } else if (isHex && code >= 97 && code <= 102) { // 'a'..'f'
      digit = (code - 97 + 10) as u64;
    } else if (isHex && code >= 65 && code <= 70) { // 'A'..'F'
      digit = (code - 65 + 10) as u64;
    } else {
      return (false, 0 as u64);
    }
    if (res > limit) {
      return (false, 0 as u64);
    }
    if (res == limit && digit > lastDigit) {
      return (false, 0 as u64);
    }
    res = res * base + digit;
    hasDigits = true;
    i += 1;
  }

  if (!hasDigits) {
    return (false, 0 as u64);
  }
  return (true, res);
};

/**
 * The element type of an array-shaped type: the intrinsic `array<T>`,
 * or a generic class over it (`FixedArray<T>`, `Array<T>`) whose first
 * type argument is the element. Returns null for anything else.
 *
 * Callers use this to recover the *semantic* element type when the wasm
 * type cannot answer a question — chiefly whether a packed element
 * should be read sign-extended, since `u8` and `i8` share one wasm
 * array type.
 */
export let arrayElementType = (t: Type): Type | null => match (baseType(t)) {
  case ArrayType {elementType}: elementType
  case ClassType as ct: {
    let {typeArguments} = ct;
    if (typeArguments != null && typeArguments.length > 0) {
      typeArguments[0]
    } else {
      null
    }
  }
  case _: null
};

/**
 * Whether a narrow integer type is one of the signed ones, i.e. whether
 * a packed load of it must sign-extend. False for everything that is not
 * a narrow type, so a caller that has already established packing can
 * read this as "use array.get_s".
 */
export let isSignedNarrowIntType = (t: Type): boolean => match (baseType(t)) {
  case I8Type: true
  case I16Type: true
  case _: false
};

/**
 * Whether an integer literal fits a type with a checked range. `raw` is
 * the unsigned source text and `negative` reports a leading unary minus,
 * kept separate so that `-128` fits `i8` even though `128` alone does
 * not. Callers must have established `integerTypeHasCheckedRange(t)`.
 */
export let integerLiteralFits = (raw: String, negative: boolean, t: Type): boolean => {
  if (let (true, mag) = integerLiteralMagnitude(raw)) {
    let zero = 0 as u64;
    if (negative) {
      // Negative zero is still zero, and so fits anywhere.
      if (mag == zero) { return true; }
      return match (baseType(t)) {
        case I8Type: mag <= (128 as u64)
        case I16Type: mag <= (32768 as u64)
        // The unsigned types hold no negative value at all.
        case _: false
      };
    }
    return match (baseType(t)) {
      case U8Type: mag <= (255 as u64)
      case U16Type: mag <= (65535 as u64)
      case I8Type: mag <= (127 as u64)
      case I16Type: mag <= (32767 as u64)
      case U32Type: mag <= (4294967295 as u64)
      // Any magnitude that parsed at all fits u64.
      case U64Type: true
      case _: false
    };
  }
  // Malformed, or wider than 64 bits: fits nothing.
  return false;
};

/**
 * Format a type as a human-readable string for diagnostics.
 */
export let typeToString = (t: Type): String => match (t) {
  case I32Type: "i32"
  case U32Type: "u32"
  case I64Type: "i64"
  case U64Type: "u64"
  case F32Type: "f32"
  case F64Type: "f64"
  case U8Type: "u8"
  case U16Type: "u16"
  case I8Type: "i8"
  case I16Type: "i16"
  case V128Type: "v128"
  case BooleanType: "boolean"
  case VoidType: "void"
  case NullType: "null"
  case NeverType: "never"
  case HoleType: "_"
  case ErrorType: "<error>"
  case UnknownType: "unknown"
  case AnyRefType: "anyref"
  case ErasedType: "erased"
  case EqRefType: "eqref"
  case BoolLiteralType {value}: if (value) "true" else "false"
  case StringLiteralType {value}: "'" + value + "'"
  case NumLiteralType {raw}: raw
  case ArrayType {elementType}: "Array<" + typeToString(elementType) + ">"
  case TupleType {elementTypes}: {
    var s = "[";
    var i = 0;
    while (i < elementTypes.length) {
      if (i > 0) { s = s + ", "; }
      s = s + typeToString(elementTypes[i]);
      i += 1;
    }
    s + "]"
  }
  case InlineTupleType {elementTypes}: {
    var s = "(";
    var i = 0;
    while (i < elementTypes.length) {
      if (i > 0) { s = s + ", "; }
      s = s + typeToString(elementTypes[i]);
      i += 1;
    }
    s + ")"
  }
  case UnionType {types}: {
    // A union of one type with null prints as the nullable shorthand.
    var nullableInner: Type | null = null;
    if (types.length == 2) {
      if (types[0] is NullType) { nullableInner = types[1]; }
      else if (types[1] is NullType) { nullableInner = types[0]; }
    }
    if (nullableInner != null) {
      let inner = nullableInner;
      if (inner is FunctionType) {
        "(" + typeToString(inner) + ")?"
      } else {
        typeToString(inner) + "?"
      }
    } else {
      var s = "";
      var i = 0;
      while (i < types.length) {
        if (i > 0) { s = s + " | "; }
        s = s + typeToString(types[i]);
        i += 1;
      }
      s
    }
  }
  case RecordType {properties}: {
    var s = "{ ";
    let keys = properties.keys();
    var first = true;
    while (let (true, key) = keys.next()) {
      if (!first) { s = s + ", "; }
      s = s + key + ": " + typeToString(properties[key]);
      first = false;
    }
    s + " }"
  }
  case FunctionType as ft: {
    var s = "(";
    var i = 0;
    while (i < ft.parameters.length) {
      if (i > 0) { s = s + ", "; }
      let {parameterNames} = ft;
      if (parameterNames != null) {
        let names = parameterNames;
        if (i < names.length) {
          s = s + names[i] + ": ";
        }
      }
      s = s + typeToString(ft.parameters[i]);
      i += 1;
    }
    s + ") => " + typeToString(ft.returnType)
  }
  case ClassType as ct: {
    let {typeArguments} = ct;
    if (typeArguments != null) {
      let args = typeArguments;
      var s = ct.name + "<";
      var i = 0;
      while (i < args.length) {
        if (i > 0) { s = s + ", "; }
        s = s + typeToString(args[i]);
        i += 1;
      }
      s + ">"
    } else {
      ct.name
    }
  }
  case InterfaceType as it: {
    let {typeArguments} = it;
    if (typeArguments != null) {
      let args = typeArguments;
      var s = it.name + "<";
      var i = 0;
      while (i < args.length) {
        if (i > 0) { s = s + ", "; }
        s = s + typeToString(args[i]);
        i += 1;
      }
      s + ">"
    } else {
      it.name
    }
  }
  case MixinType as mt: {
    let {typeArguments} = mt;
    if (typeArguments != null) {
      let args = typeArguments;
      var s = mt.name + "<";
      var i = 0;
      while (i < args.length) {
        if (i > 0) { s = s + ", "; }
        s = s + typeToString(args[i]);
        i += 1;
      }
      s + ">"
    } else {
      mt.name
    }
  }
  case TypeParameterType as tp: tp.name
  case TypeAliasType as ta: {
    let {typeArguments} = ta;
    if (typeArguments != null) {
      let sb = new StringBuilder();
      let args = typeArguments;
      sb.append(ta.name);
      sb.append("<");
      for (var i = 0; i < args.length; i += 1) {
        if (i > 0) {
          sb.append(", ");
        }
        sb.append(typeToString(args[i]));
      }
      sb.append(">");
      sb.toString()
    } else {
      ta.name
    }
  }
  case SymbolType as sym: {
    let {debugName} = sym;
    if (debugName != null) {
      "symbol(" + debugName + ")"
    } else {
      "symbol"
    }
  }
  case ThisType: "this"
};


