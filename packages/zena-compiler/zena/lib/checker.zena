/**
 * Type checker for the Zena compiler.
 *
 * The checker walks the AST, infers types, validates compatibility,
 * and populates the SemanticModel with type information. The AST is
 * never mutated — all semantic data lives in the SemanticModel.
 *
 * Architecture:
 *
 * Two-phase checking (checkModule):
 *   Phase 1 — Register all declaration signatures: imports, classes,
 *     interfaces, enums, mixins, type aliases, declared functions, and
 *     symbols. After Phase 1, every type identity and member signature
 *     is available for lookup.
 *   Phase 2 — Check all bodies: class method bodies, field initializers,
 *     accessor bodies, variable declarations, expression statements, and
 *     all other non-declaration statements. Interface conformance and
 *     abstract-field validation also run here.
 *   This separation ensures that forward references between classes work:
 *   class A's method can call class B's method even when B is declared
 *   after A, because B's member signatures are registered in Phase 1
 *   before A's method body is checked in Phase 2.
 *
 * Name resolution:
 * - Value names delegate to the scope pass's ReferenceMap
 *   (Identifier → Symbol → binding type). The checker has no value
 *   scope stack.
 * - Binding types are stored in SemanticModel via Symbol.id keys,
 *   set at declaration time and read at reference time.
 * - Type annotation resolution also delegates to the scope pass's
 *   ReferenceMap (NamedTypeAnnotation → Symbol), then materializes
 *   declaration types on demand by Symbol identity.
 * - Built-in type objects (primitives, prelude types) are pre-registered
 *   in the checker's internal type scope so annotation resolution works
 *   even before stdlib module exports are wired in.
 *
 * On-demand type materialization:
 * - Type declarations (classes, interfaces, etc.) are materialized
 *   on demand by resolveTypeName when first referenced, before their
 *   full Phase 1 registration runs.
 *
 * Other:
 * - Narrowing uses Symbol.id keys for identity-based precision.
 * - The checker produces a SemanticModel + diagnostics as output.
 */

import { isValidIntrinsic } from './intrinsics.zena';
import { console } from 'zena:console';
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { analyzeCaptures, analyzeTryBodyAssignments } from './analysis/capture.zena';
import { HashSet } from 'zena:set';
import { Error } from 'zena:error';
import { parseI32, i32ToString } from 'zena:string-convert';
import { walkEnter } from './visitor.zena';
import {
  Node, Module, SourceLocation,
  // Expressions
  Expression, Identifier, NumberLiteral, StringLiteral, BooleanLiteral,
  NullLiteral, BinaryExpression, UnaryExpression, AssignmentExpression,
  FunctionExpression, CallExpression, MemberExpression, IndexExpression,
  ThisExpression, SuperExpression, NewExpression, AsExpression, IsExpression,
  ArrayLiteral, RecordLiteral, TupleLiteral, MapLiteral,
  TemplateLiteral, TaggedTemplateExpression, MatchExpression, IfExpression,
  ThrowExpression, TryExpression, AwaitExpression, RangeExpression, PipelineExpression,
  PipePlaceholder,
  // Statements
  Statement, VariableDeclaration, FunctionDeclaration, ExpressionStatement, BlockStatement,
  ReturnStatement, YieldStatement, BreakStatement, ContinueStatement, IfStatement,
  WhileStatement, ForStatement, ForInStatement, ClassDeclaration,
  InterfaceDeclaration, EnumDeclaration, MixinDeclaration,
  TypeAliasDeclaration, ImportDeclaration, ExportAllDeclaration,
  ExportFromDeclaration, DeclareFunction, SymbolDeclaration, Decorator,
  SymbolPropertyName,
  // Patterns
  Pattern, BindingPattern, IdentifierPattern, RecordPattern, TuplePattern, AsPattern,
  ClassPattern, LogicalPattern, AssignmentPattern, LiteralPattern,
  // Type Annotations
  TypeAnnotation, NamedTypeAnnotation, UnionTypeAnnotation,
  FunctionTypeAnnotation, LiteralTypeAnnotation, RecordTypeAnnotation,
  TupleTypeAnnotation, InlineTupleTypeAnnotation, ThisTypeAnnotation,
  // Helpers
  TypeParameter, Parameter, FieldDefinition, MethodDefinition,
  AccessorDeclaration, MatchCase, PropertyAssignment, SpreadElement,
  LetPatternCondition, BindingProperty, PropertySignature, CatchClause,
  CaseClassParam, FieldInitializer, SuperInitializer, EnumMember, MapEntry,
  MethodSignature, AccessorSignature, SetterInfo, SealedVariant,
  ImportSpecifier, getMemberPropertyName, IdGenerator
} from './ast.zena';
import {
  Type, TypeId, I32Type, U32Type, I64Type, U64Type, F32Type, F64Type,
  U8Type, U16Type, I8Type, I16Type,
  BooleanType, VoidType, NullType, NeverType, HoleType, ErrorType, UnknownType,
  AnyRefType, EqRefType,
  BoolLiteralType, StringLiteralType, NumLiteralType,
  ArrayType, TupleType as TupleT, InlineTupleType as InlineTupleT,
  UnionType as UnionT, RecordType as RecordT,
  FunctionType, ClassType, InterfaceType, MixinType, MemberInfo, FieldInfo, MethodInfo,
  TypeParameterType, TypeAliasType, SymbolType, ThisType,
  instantiateClassType, instantiateInterfaceType, instantiateMixinType,
  instantiateTypeAliasType, instantiateFunctionType, GenericNamedType,
  isNumericType, isIntegerType, isFloatType, is64BitType,
  numericTypeName, isBooleanLike, baseType,
  integerLiteralFits,
  promoteNumeric, typeToString
} from './types.zena';
import { SemanticModel, InterfaceAdaptation, SymbolDependencies, ClosureDependency, FunctionAdaptationDependency } from './semantic-model.zena';
import {
  Diagnostic, DiagnosticBag, DiagnosticCode, DiagnosticSeverity
} from './diagnostics.zena';
import { Symbol, SymbolId } from './scope/symbol.zena';
import { ScopeResult, ModuleExports } from './scope/scope-builder.zena';

let lookupBindingTypeInDeps = (ctx: CheckerContext, sym: Symbol): Type | null => {
  let models = ctx.depModels;
  if (models != null) {
    let depModels = models as HashMap<String, SemanticModel>;
    for (let depKey in depModels.keys()) {
      if (let (true, depModel) = depModels.get(depKey)) {
        let dbt = depModel.getBindingTypeDirect(sym);
        if (dbt != null) { return dbt; }
      }
    }
  }
  return null;
};

/**
 * Internal state for the type checker.
 *
 * Name resolution for values (variables, parameters, functions) is
 * delegated to the scope pass's ReferenceMap. The checker no longer
 * maintains its own value scope stack. Instead:
 *
 *   Declaration time: the checker stores a binding's type in the
 *   SemanticModel via `model.setBindingType(symbolInfo, type)`.
 *
 *   Reference time: an Identifier is resolved through the ReferenceMap
 *   to its Symbol, then `model.getBindingType(info)` recovers the
 *   type. Narrowings are checked first (keyed by Symbol.id).
 *
 * The checker keeps a flat type-name map for built-in primitive types
 * (i32, f64, etc.) at #typeScopes[0]. Type annotation resolution for
 * all other names — including type parameters — delegates to the scope
 * pass's ReferenceMap: model.resolve(node) → Symbol.id →
 * #materializedTypes. Type parameters are registered there via
 * registerTypeParameter() as soon as each TypeParameterType is created.
 */
export final class SharedCheckerState {
  var typeIdGenerator = new IdGenerator<TypeId>();
  preludeTypes = new HashMap<String, Type>();
  preludeValues = new HashMap<String, Type>();
  var preludeRegistered: boolean = false;

  /**
   * The canonical nominal type for each class/interface/variant
   * declaration, keyed by its declaring symbol. Shared across every
   * checking pass of a compilation so a declaration has exactly ONE
   * type object no matter how many times its module is checked or
   * which module materializes it first: an importer across a cycle's
   * back edge creates a shell here from the origin's AST, and the
   * origin's own registration later fills the same object
   * (docs/design/import-cycles.md).
   */
  declaredNominalTypes = new HashMap<SymbolId, Type>();

  /**
   * The canonical TypeParameterType per declared type parameter, keyed
   * by "<source path>#<byte offset>" of the parameter's declaration
   * (importers re-materialize an exporter's signature from its AST,
   * where the importer's model has no Symbol for the foreign parameter
   * — the location is shared). NOT keyed by node id: node id spaces
   * restart per compilation while shared state (prelude/stdlib types)
   * can carry forward across compilations in one process, so ids
   * collide across programs; source locations are stable. Substitution
   * matches parameters by object identity, so every pass and every
   * importing module must see the same object — same reasoning as
   * declaredNominalTypes.
   */
  typeParameterTypes = new HashMap<String, Type>();
}

/**
 * Internal state for the type checker.
 *
 * Name resolution for values (variables, parameters, functions) is
 * delegated to the scope pass's ReferenceMap. The checker no longer
 * maintains its own value scope stack. Instead:
 *
 *   Declaration time: the checker stores a binding's type in the
 *   SemanticModel via `model.setBindingType(symbolInfo, type)`.
 *
 *   Reference time: an Identifier is resolved through the ReferenceMap
 *   to its Symbol, then `model.getBindingType(info)` recovers the
 *   type. Narrowings are checked first (keyed by Symbol.id).
 *
 * The checker keeps a flat type-name map for built-in primitive types
 * (i32, f64, etc.) at #typeScopes[0]. Type annotation resolution for
 * all other names — including type parameters — delegates to the scope
 * pass's ReferenceMap: model.resolve(node) → Symbol.id →
 * #materializedTypes. Type parameters are registered there via
 * registerTypeParameter() as soon as each TypeParameterType is created.
 */
final class CheckerContext {
  model = new SemanticModel();

  /**
   * The same file's model from the previous checking pass, when this is
   * a cycle-driven re-check (compiler.zena's second pass). Guards
   * against re-resolving previously-spliced default arguments in the
   * caller's scope; see splicedArgCountOf.
   */
  var priorModel: SemanticModel | null = null;
  diagnostics: DiagnosticBag;
  #sharedState: SharedCheckerState;

  /**
   * Module paths that run AFTER this module in evaluation order —
   * an import whose declaration ORIGINATES in one of them crosses an
   * import cycle's back edge (docs/design/import-cycles.md). Null when
   * the compilation has no cycles.
   */
  var cyclicLaterPaths: HashSet<String> | null = null;

  /**
   * Modules the compiler re-checks because of import cycles. A type
   * or inferred signature may cross a back edge only when it
   * originates OUTSIDE this set: such an origin is checked exactly
   * once, so its type objects are unique and stable.
   */
  var cyclicRecheckPaths: HashSet<String> | null = null;

  /**
   * Type namespace map for built-in primitive types (i32, u32, f64, etc.).
   * Only index 0 is meaningful; the stack structure is retained because
   * enterScope/exitScope still push/pop frames for narrowing bookkeeping.
   */
  #typeScopes = new Array<HashMap<String, Type>>();

  /**
   * Optional-chain nodes sanctioned as the immediate left operand of
   * `??`. A chain yielding a boxable primitive is only legal there:
   * the miss becomes the coalesce arm, so `primitive | null` never
   * materializes as a value. Any unsanctioned primitive chain errors.
   */
  nullishSanctioned = new HashSet<i32>();

  /**
   * Narrowed types (control-flow narrowing) per scope level.
   * Keyed by Symbol.id so narrowing survives across scopes that
   * reference the same binding, and is robust against shadowing.
   * Kept as a stack so narrowings are automatically discarded when
   * their enclosing scope exits.
   */
  /**
   * Set immediately before resolving a type argument of `Own`/`Borrow`/
   * `Unmanaged`, and consumed (cleared) by the next named-type resolution.
   * It is what permits a `resource class` to be named there and nowhere else.
   *
   * A flag rather than a parameter on `resolveTypeAnnotation` because that
   * function is forward-referenced from callers above its definition, and
   * adding a defaulted parameter makes those call sites fail arity checking.
   */
  var resourceMentionOk: boolean = false;
  #narrowings = new Array<HashMap<SymbolId, Type>>();

  /**
   * Narrowed types for member paths (for example, "symbolId.inner").
   * Only immutable field paths are eligible for these narrowings.
   */
  #memberPathNarrowings = new Array<HashMap<String, Type>>();

  /**
   * The current function's expected return type, or null if not in a function.
   */
  var #returnType: Type | null = null;

  /**
   * Inferred return types collected from return statements.
   * Used when a function has no explicit return type annotation.
   */
  var #inferredReturnTypes = new Array<Type>();

  /**
   * The current generator's expected yield type, or null when the
   * nearest enclosing function is not a `gen` function. VoidType is
   * the inference sentinel, mirroring #returnType's convention.
   */
  var #yieldType: Type | null = null;

  /**
   * Inferred yield types collected from yield statements.
   * Used when a generator has no explicit yield type annotation.
   */
  var #inferredYieldTypes = new Array<Type>();

  /**
   * Depth of enclosing try blocks within the current function body.
   * `yield`/`await` inside `try` are rejected in v1 (generators.md §6,
   * async.md §1).
   */
  var #tryDepth: i32 = 0;

  /**
   * The value type T of the enclosing async function's Future<T>, or
   * null when the nearest enclosing function is not async. VoidType is
   * the inference sentinel, mirroring #returnType's convention.
   */
  var #asyncValueType: Type | null = null;

  /**
   * The declared Future<T> of the enclosing async function — the
   * return-adoption target (async.md §2). Null while inferring (no
   * adoption during inference) and outside async bodies.
   */
  var #asyncFutureType: Type | null = null;

  /**
   * Stack of class types being checked. The top is the innermost class.
   * Used by ThisExpression, super resolution, and member access validation.
   */
  #classStack = new Array<ClassType>();

  /** Whether we are currently checking an interface declaration body. */
  var #inInterface = false;

  /**
   * Loop nesting depth (for break/continue validation).
   */
  var #loopDepth = 0;

  /**
   * Pending function declarations indexed by Symbol.id.
   * Populated by a pre-scan in checkModule so that resolveIdentifier
   * can lazily resolve forward-referenced function types from their
   * annotations without waiting for the main pass to reach them.
   */
  #pendingFunctions = new HashMap<SymbolId, Node>();

  /**
   * Symbol IDs currently being lazily resolved.
   * Used for cycle detection: if we re-enter resolution for an ID
   * already in this set, we've found a recursive reference.
   */
  #resolving = new HashSet<SymbolId>();

  /**
   * Pipeline value stack for `|>` operator.
   * `$` placeholder resolves to the top of this stack.
   */
  #pipelineStack = new Array<Type>();

  #referrerStack = new Array<String>();
  #referrerSymbolStack = new Array<SymbolId>();
  #referrerNodeStack = new Array<i32>();
  #dependencyStack = new Array<SymbolDependencies>();

  enterSymbolReferrer(symId: SymbolId): void {
    this.#referrerStack.push("sym");
    this.#referrerSymbolStack.push(symId);
    this.#dependencyStack.push(new SymbolDependencies());
  }

  exitSymbolReferrer(symId: SymbolId): void {
    if (this.#referrerStack.length > 0) {
      this.#referrerStack.pop();
      this.#referrerSymbolStack.pop();
      let deps = this.#dependencyStack.pop();
      this.model.setSymbolDependencies(symId, deps);

    }
  }

  enterNodeReferrer(nodeId: i32): void {
    this.#referrerStack.push("node");
    this.#referrerNodeStack.push(nodeId);
    this.#dependencyStack.push(new SymbolDependencies());
  }

  exitNodeReferrer(nodeId: i32): void {
    if (this.#referrerStack.length > 0) {
      this.#referrerStack.pop();
      this.#referrerNodeStack.pop();
      let deps = this.#dependencyStack.pop();
      this.model.setNodeDependencies(nodeId, deps);
    }
  }

  currentDependencies(): SymbolDependencies | null {
    if (this.#dependencyStack.length > 0) {
      return this.#dependencyStack[this.#dependencyStack.length - 1];
    }
    return null;
  }

  setNodeType(node: Node, type: Type): void {
    this.model.setNodeType(node, type);
    if (type is FunctionType) {
      let ft = type as FunctionType;
      if (ft.functionSymbolId != (-1 as SymbolId)) {
        let deps = this.currentDependencies();
        if (deps != null) {
          deps.referencedTypes.add(ft);
        }
      }
    }
  }

  referrerStack: Array<String> {
    get { return this.#referrerStack; }
  }

  currentReferrerNodeId(): i32 {
    if (this.#referrerNodeStack.length > 0) {
      return this.#referrerNodeStack[this.#referrerNodeStack.length - 1];
    }
    return -1;
  }

  enterClosureReferrer(): void {
    this.#dependencyStack.push(new SymbolDependencies());
  }

  exitClosureReferrer(fe: FunctionExpression, capturesThis: boolean, captures: Array<SymbolId>, mutableCaptures: HashSet<SymbolId>): void {
    if (this.#dependencyStack.length > 1) {
      let deps = this.#dependencyStack.pop();
      let parentDeps = this.#dependencyStack[this.#dependencyStack.length - 1];
      let clDep = new ClosureDependency(fe.id as i32, fe as Node, capturesThis, captures, mutableCaptures, deps);
      parentDeps.closures.push(clDep);
      this.model.setNodeDependencies(fe.id as i32, deps);
    }
  }

  /**
   * The scope result from name resolution (for reference lookups).
   */
  #scopeResult: ScopeResult;

  /**
   * Symbol IDs currently being materialized (cycle detection).
   * Prevents infinite recursion when type A references type B
   * which references type A. Keyed by Symbol.id rather than
   * name strings, since names only have meaning within a scope.
   */
  #pendingTypes = new HashSet<SymbolId>();

  /**
   * Materialized type declarations keyed by type-symbol identity.
   * Avoids name-based caching bugs under lexical shadowing.
   */
  #materializedTypes = new HashMap<SymbolId, Type>();

  /**
   * Materialized declaration types keyed by declaration offset.
   * Keeps type/value namespace symbols for the same declaration unified.
   */
  #materializedDeclTypes = new HashMap<i32, Type>();

  /**
   * Dependency exports map: import specifier → ModuleExports.
   * Populated by the compiler so the checker can resolve imported types.
   */
  var #depExports?: HashMap<String, ModuleExports> | null = null;

  /**
   * Dependency semantic models: import specifier → SemanticModel.
   * When provided, the checker can look up actual resolved types from
   * already-checked dependency modules instead of creating empty stubs.
   */
  var #depModels?: HashMap<String, SemanticModel> | null = null;

  /** The file path of the module being checked. */
  #filePath: String;

  emitLocations: boolean;
  warnUnnecessaryCasts: boolean;

  new(
      sharedState: SharedCheckerState,
      file: String,
      scopeResult: ScopeResult,
      depExports: HashMap<String, ModuleExports> | null,
      depModels: HashMap<String, SemanticModel> | null,
      emitLocations: boolean = false,
      warnUnnecessaryCasts: boolean = false)
    : diagnostics = new DiagnosticBag(file),
      #sharedState = sharedState,
      #filePath = file,
      #scopeResult = scopeResult,
      #depExports = depExports,
      #depModels = depModels,
      emitLocations = emitLocations,
      warnUnnecessaryCasts = warnUnnecessaryCasts {
    
    // Initialize with module-level scope.
    this.#typeScopes.push(new HashMap<String, Type>());
    this.#narrowings.push(new HashMap<SymbolId, Type>());
    this.#memberPathNarrowings.push(new HashMap<String, Type>());

    // Wire the scope pass's maps into the SemanticModel
    // so consumers have a single object for all queries.
    this.model.setSymbols(scopeResult.symbols);
    this.model.setParents(scopeResult.parents);
    

    // Pre-register built-in types in the type namespace.
    this.declareBuiltinType("i32", new I32Type());
    this.declareBuiltinType("u32", new U32Type());
    this.declareBuiltinType("i64", new I64Type());
    this.declareBuiltinType("u64", new U64Type());
    this.declareBuiltinType("f32", new F32Type());
    this.declareBuiltinType("f64", new F64Type());
    this.declareBuiltinType("u8", new U8Type());
    this.declareBuiltinType("u16", new U16Type());
    this.declareBuiltinType("i8", new I8Type());
    this.declareBuiltinType("i16", new I16Type());
    this.declareBuiltinType("boolean", new BooleanType());
    this.declareBuiltinType("void", new VoidType());
    this.declareBuiltinType("null", new NullType());
    this.declareBuiltinType("never", new NeverType());
    this.declareBuiltinType("_", new HoleType());
  }

  /**
   * Register a built-in type in the type namespace.
   */
  declareBuiltinType(name: String, t: Type): void {
    this.#typeScopes[0][name] = t;
  }

  /**
   * Generate a fresh type ID.
   */
  freshTypeId(): TypeId {
    return this.#sharedState.typeIdGenerator.next();
  }

  /**
   * The caller-written argument count for a node whose args the checker
   * extended with spliced default initializers. Splicing MUTATES the
   * shared AST, but a re-checked file (the cycle-driven second pass)
   * starts a fresh SemanticModel — so when the current model has no
   * record, consult the same file's previous-pass model (priorModel).
   * Per-file models keep this safe under compilation reuse, where node
   * ids restart across unrelated programs.
   */
  splicedArgCountOf(node: Node): i32 {
    let c = this.model.getOriginalArgCountDirect(node);
    if (c != -1) { return c; }
    let prior = this.priorModel;
    if (prior != null) {
      return (prior as SemanticModel).getOriginalArgCountDirect(node);
    }
    return -1;
  }

  // --- Scope management ---

  /**
   * Push a new scope frame (for narrowings).
   * Value-namespace scoping is handled by the scope pass's ReferenceMap.
   * Type-parameter scoping is handled by registerTypeParameter → #materializedTypes.
   */
  enterScope(): void {
    this.#typeScopes.push(new HashMap<String, Type>());
    this.#narrowings.push(new HashMap<SymbolId, Type>());
    this.#memberPathNarrowings.push(new HashMap<String, Type>());
  }

  exitScope(): void {
    this.#typeScopes.pop();
    this.#narrowings.pop();
    this.#memberPathNarrowings.pop();
  }

  // --- Value binding (via SemanticModel + Symbol) ---

  /**
   * Store a binding's type in the SemanticModel, keyed by Symbol.
   * Called when processing declarations (VariableDeclaration, parameters).
   */
  declareBinding(info: Symbol, t: Type): void {
    this.model.setBindingType(info, t);
    // Also store on the declaration node for getNodeType() queries.
    if (info.declaration != null) {
      this.setNodeType(info.declaration as Node, t);
    }
  }

  /**
   * Resolve an identifier's type via the ReferenceMap.
   * Checks narrowings first, then falls back to the binding type.
   * If no type is stored yet, attempts lazy resolution for function
   * declarations (enabling forward references and self-recursion).
   */
  resolveIdentifier(node: Node): Type | null {
    let t = this.resolveIdentifierInternal(node);
    if (t != null) {
      let info = this.model.resolve(node);
      if (info != null) {
        let si = info as Symbol;
        let resolvedSym = si.resolveTarget();
        if (t is FunctionType) {
          let ft = t as FunctionType;
          ft.functionSymbolId = resolvedSym.id;
          ft.functionSymbolName = resolvedSym.name;
          let deps = this.currentDependencies();
          if (deps != null) {
            deps.referencedTypes.add(ft);
          }
        }
      }
    }
    return t;
  }

  resolveIdentifierInternal(node: Node): Type | null {
    let info = this.model.resolve(node);
    if (info == null) { return null; }
    let si = info as Symbol;
    this.model.symbolNames[si.id] = si.name;
    let resolvedSym = si.resolveTarget();
    this.model.symbolNames[resolvedSym.id] = resolvedSym.name;

    let deps = this.currentDependencies();
    if (deps != null) {
      deps.referencedSymbols.add(resolvedSym.id);
    }

    var i = this.#narrowings.length - 1;
    while (i >= 0) {
      let narrowing = this.#narrowings[i];
      if (let (true, v) = narrowing.get(si.id)) {
        return v;
      }
      i = i - 1;
    }

    // Fall back to member path narrowings (using identifier key "s" + symbol.id).
    let pathKey = "s" + i32ToString(si.id as i32);
    let pathNarrowing = this.resolveNarrowedMemberPath(pathKey);
    if (pathNarrowing != null) {
      return pathNarrowing;
    }

    // Fall back to the binding type stored by the checker.
    let bt = this.model.getBindingType(si);
    if (bt != null) { return bt as Type; }

    // Check dependency models in case this binding came from an import.
    let models = this.#depModels;
    if (models != null) {
      let depModels = models as HashMap<String, SemanticModel>;
      for (let depKey in depModels.keys()) {
        if (let (true, depModel) = depModels.get(depKey)) {
          let dbt = depModel.getBindingType(si);
          if (dbt != null) { return dbt as Type; }
        }
      }
    }

    // No type stored yet — attempt lazy resolution for pending functions.
    if (let (true, pendingFunc) = this.#pendingFunctions.get(si.id)) {
      return this.lazyResolveFunction(si, pendingFunc);
    }

    // On-demand: if the declaration is a type (class, interface, mixin,
    // sealed variant), materialize it via resolveTypeName so forward
    // references work.
    // For DeclareFunction, register a placeholder so forward refs don't fail.
    // TODO: It feels like this might be duplicating some functionality...
    let decl = si.declaration;
    if (decl != null) {
      // Extract type name from declaration node
      // TODO: Let's make a named Node interface or at least
      // a getName() utility. We should definitely add an isType() utility.
      let tn = match (decl) {
        case ClassDeclaration {name}: { name.name }
        case InterfaceDeclaration {name}: { name.name }
        case MixinDeclaration {name}: { name.name }
        case SealedVariant {name}: { name.name }
        case DeclareFunction: {
          this.declareBinding(si, new ErrorType());
          null
        }
        case _: { null }
      };
      
      if (tn != null) {
        let t = this.resolveTypeName(tn);
        if (t != null) { return t; }
      }
      
      
    }
    return null;
  }

  /**
   * Register a function declaration for lazy resolution.
   * Called during the checkModule pre-scan.
   */
  registerPendingFunction(id: SymbolId, funcExpr: Node): void {
    this.#pendingFunctions[id] = funcExpr;
  }

  /**
   * Lazily resolve a function's type from its annotations or body.
   *
   * If the function is fully annotated (all params + return type),
   * resolves the exact FunctionType from annotations. If it has no
   * return type but is a pure forward reference (no cycle), eagerly
   * checks the function body to infer the type. If it's in a recursive
   * cycle without a return type annotation, reports an error.
   */
  lazyResolveFunction(si: Symbol, funcNode: Node): Type | null {
    match (funcNode) {
      case FunctionExpression as fe: {
        let typeParameters = fe.typeParameters;
        let params = fe.params;
        let returnType = fe.returnType;
        let body = fe.body;
        let loc = fe.loc;
        // Check for cycle — if we're already resolving this symbol,
        // it's a recursive reference.
        if (this.#resolving.has(si.id)) {
          // Recursive call. If fully annotated, we can resolve from annotations.
          if (returnType != null) {
            // Resolve from annotations only (no body check needed).
            return this.resolveFunctionFromAnnotations(typeParameters, params, returnType as TypeAnnotation, si);
          } else {
            // Recursive without return type annotation — error.
            this.error(
              "Recursive function requires an explicit return type annotation.",
              DiagnosticCode.TypeMismatch,
              loc
            );
            return new ErrorType();
          }
        }

        // Not a cycle. Mark as resolving.
        this.#resolving.add(si.id);

        let funcType = if (returnType != null) {
          // Fully annotated — resolve from annotations.
          this.resolveFunctionFromAnnotations(typeParameters, params, returnType as TypeAnnotation, si)
        } else {
          // No return type annotation — eagerly check the function body.
          checkFunctionExpression(this, fe, null)
        };

        // Store result so subsequent references find it immediately.
        this.declareBinding(si, funcType);

        // Clean up resolving state.
        this.#resolving.delete(si.id);

        return funcType;
      }
      case _: { return null; }
    }
  }

  /**
   * Resolve a function type from its annotations only (no body check).
   * Used for fully-annotated functions and recursive references.
   */
  resolveFunctionFromAnnotations(
    typeParameters: Array<TypeParameter> | null,
    params: Array<Parameter>,
    returnTypeAnn: TypeAnnotation,
    si: Symbol
  ): Type {
    // Enter a temporary scope for type parameter names.
    this.enterScope();
    var resolvedTypeParams: Array<TypeParameterType> | null = null;
    if (typeParameters != null) {
      let tps = typeParameters as Array<TypeParameter>;
      resolvedTypeParams = new Array<TypeParameterType>();
      for (let tp in tps) {
        var constraint: Type | null = null;
        if (tp.constraint != null) {
          constraint = resolveTypeAnnotation(this, tp.constraint as TypeAnnotation, false);
        }
        let tpType = this.getOrCreateTypeParameter(tp, constraint, null);
        this.declareTypeName(tp.name, tpType);
        (resolvedTypeParams as Array<TypeParameterType>).push(tpType);
      }
    }

    // Resolve parameter types.
    let paramTypes = new Array<Type>();
    let paramNames = new Array<String>();
    for (let param in params) {
      paramNames.push(param.name.name);
      if (param.typeAnnotation != null) {
        paramTypes.push(resolveTypeAnnotation(this, param.typeAnnotation as TypeAnnotation, false));
      } else {
        paramTypes.push(new ErrorType());
      }
    }

    // Resolve return type. For generators the annotation is the full
    // Iterator<T> type (validated when the body is checked).
    var retType = resolveTypeAnnotation(this, returnTypeAnn, true);

    this.exitScope();

    // Build the FunctionType.
    let funcType = new FunctionType(paramTypes, paramNames, retType);
    if (resolvedTypeParams != null) {
      funcType.typeParameters = resolvedTypeParams;
    }

    return funcType as Type;
  }

  // --- Type name resolution ---

  /**
   * Declare a type name in the current scope.
   */
  declareTypeName(name: String, t: Type): void {
    let top = this.#typeScopes[this.#typeScopes.length - 1];
    top[name] = t;
  }
  
  registerType(info: Symbol, t: Type): void {
    this.#materializedTypes[info.id] = t;
    this.model.setBindingType(info, t);
  }

  /**
   * Register a TypeParameterType in the materialized types cache by the
   * Symbol identity of the corresponding TypeParameter AST node.
   *
   * Called immediately after creating each TypeParameterType so that
   * resolveTypeReference → model.resolve → #materializeFromSymbol finds
   * the correct object (by Symbol.id) instead of falling back to the
   * name-string #typeScopes stack.
   */
  registerTypeParameter(tp: TypeParameter, tpType: TypeParameterType): void {
    let info = this.model.resolveDeclaration(tp as Node);
    if (info != null) {
      this.#materializedTypes[(info as Symbol).id] = tpType as Type;
      this.model.setBindingType(info as Symbol, tpType as Type);
    }
  }

  /**
   * The ONE TypeParameterType for a declared type parameter.
   * Substitution matches parameters by object identity, so every
   * resolution of the same declaration — lazy annotation resolution,
   * signature checks, body checks — must see the same object.
   * Creation therefore goes through a shared registry keyed by the
   * parameter's AST node id; constraint/default stick from the first
   * call that resolves them.
   */
  getOrCreateTypeParameter(
    tp: TypeParameter,
    constraint: Type | null,
    defaultType: Type | null
  ): TypeParameterType {
    // Location-based key: stable across re-parses and across the
    // compilations that share this state (node ids are not). Synthesized
    // parameters without a location fall back to the node id, which is
    // unique within one compilation.
    var key = "id:" + i32ToString(tp.id as i32);
    if (tp.loc != null) {
      let loc = tp.loc as SourceLocation;
      key = (loc.path ?? "") + "#" + i32ToString(loc.start);
    }
    var result: TypeParameterType | null = null;
    if (let (true, existing) = this.#sharedState.typeParameterTypes.get(key)) {
      if (existing is TypeParameterType) {
        result = existing as TypeParameterType;
      }
    }
    if (result == null) {
      let created = new TypeParameterType(tp.name, constraint, defaultType);
      this.#sharedState.typeParameterTypes[key] = created as Type;
      result = created;
    }
    let tpType = result as TypeParameterType;
    // A resolution can reach the parameter before the declaring pass has
    // resolved its constraint/default annotations (creating the canonical
    // object with nulls). Later calls carry the resolved types — fill
    // them in; never null out what an earlier call established.
    if (constraint != null && tpType.constraint == null) {
      tpType.constraint = constraint;
    }
    if (defaultType != null && tpType.defaultType == null) {
      tpType.defaultType = defaultType;
    }
    // Register for name resolution in THIS module's model too (the
    // symbol exists when the parameter is declared locally).
    let info = this.model.resolveDeclaration(tp as Node);
    if (info != null) {
      this.#materializedTypes[(info as Symbol).id] = tpType as Type;
      this.model.setBindingType(info as Symbol, tpType as Type);
    }
    return tpType;
  }

  /**
   * Declare a type name in the module (outermost) scope. Used for sealed
   * variant types that need to be visible outside the class scope.
   */
  declareModuleTypeName(name: String, t: Type): void {
    this.#typeScopes[0][name] = t;
  }

  /**
   * Resolve a type name through scope analysis and materialization.
   * This path is for name-only lookups (for example declaration self-lookups).
   */
  resolveTypeName(name: String): Type | null {
    let localType = this.#materializeFromScope(name);
    if (localType != null) {
      return localType;
    }
    return this.#resolveBuiltinOrPreludeType(name);
  }

  /**
   * Resolve a type reference site (e.g. NamedTypeAnnotation) using
   * the scope pass's ReferenceMap.
   */
  resolveTypeReference(node: Node, fallbackName: String): Type | null {
    let info = this.model.resolve(node);
    if (info != null) {
      let t = this.#materializeFromSymbol(info as Symbol, fallbackName);
      if (t != null) {
        return t;
      }
    }

    // Fall back to scope root by name and builtins/prelude.
    return this.resolveTypeName(fallbackName);
  }

  /**
   * Materialize a type for its declaration node.
   */
  materializeDeclaration(node: Node, fallbackName: String): Type | null {
    let info = this.model.resolveDeclaration(node);
    if (info != null) {
      let t = this.#materializeFromSymbol(info as Symbol, fallbackName);
      if (t != null) {
        return t;
      }
    }
    return this.resolveTypeName(fallbackName);
  }

  /**
   * Look up a type name in scope analysis and materialize a Type object
   * on demand. Returns null if the name doesn't exist in scope analysis.
   * Sets all boolean flags from the AST node at creation time.
   */
  /**
   * Materialize the canonical type for an imported nominal declaration
   * (class, interface, sealed variant) whose module has no model yet —
   * a cycle back edge in the first checking pass. The shell created
   * here is the same object the origin module's own registration later
   * fills (SharedCheckerState.declaredNominalTypes).
   */
  materializeCyclicImport(info: Symbol, name: String): Type | null {
    let target = info.resolveTarget();
    // Only a genuine back edge of the current compilation may create a
    // shell: the origin evaluates later, so it has no model YET and its
    // own registration is guaranteed to fill this object. Any other
    // model miss is stale state — e.g. an incremental host re-loaded
    // the origin after its model was computed, so lookups against the
    // old model miss on the new Symbols. Minting a shell there would
    // give the declaration a second nominal identity.
    let later = this.cyclicLaterPaths;
    if (later == null) {
      return null;
    }
    if (!(later as HashSet<String>).has(target.modulePath)) {
      return null;
    }
    let d = target.declaration;
    if (d == null) {
      return null;
    }
    var nominal = false;
    match (d as Node) {
      case ClassDeclaration: { nominal = true; }
      case InterfaceDeclaration: { nominal = true; }
      case SealedVariant: { nominal = true; }
      case _: {}
    }
    if (!nominal) {
      return null;
    }
    return this.#materializeFromSymbol(info, name, target);
  }

  #materializeFromScope(name: String): Type | null {
    let si = this.#scopeResult.rootScope.resolve(name);
    if (si == null) { return null; }
    return this.#materializeFromSymbol(si as Symbol, name);
  }

  #materializeFromSymbol(info: Symbol, nameHint: String, target: Symbol = info): Type | null {
    if (let (true, mat) = this.#materializedTypes.get(info.id)) {
      return mat;
    }
    
    let btType = this.model.getBindingType(info);
    if (btType != null) {
      return btType as Type;
    }
    let btTarget = this.model.getBindingType(target);
    if (btTarget != null) {
      return btTarget as Type;
    }

    let models = this.#depModels;
    if (models != null) {
      let depModels = models as HashMap<String, SemanticModel>;
      for (let depKey in depModels.keys()) {
        if (let (true, depModel) = depModels.get(depKey)) {
          let bt = depModel.getBindingType(target);
          if (bt != null) {
            this.#materializedTypes[info.id] = bt as Type;
            this.#materializedTypes[target.id] = bt as Type;
            this.model.setBindingType(info, bt as Type);
            return bt as Type;
          }
        }
      }
    }

    if (target.declaration != null) {
      let declNode = target.declaration as Node;
      if (declNode.loc != null) {
        let declLoc = declNode.loc as SourceLocation;
        if (let (true, cached) = this.#materializedDeclTypes.get(declLoc.start)) {
          this.#materializedTypes[info.id] = cached;
          this.#materializedTypes[target.id] = cached;
          this.model.setBindingType(info, cached);
          return cached;
        }
      }
    }

    if (target.declaration == null) {
      return this.#resolveBuiltinOrPreludeType(nameHint);
    }

    // Canonical nominal types are shared across checking passes: if any
    // pass (of any module) already materialized this declaration, reuse
    // that object — never mint a second identity for one declaration.
    match (target.declaration) {
      case ClassDeclaration: {
        if (let (true, cached) = this.#sharedState.declaredNominalTypes.get(target.id)) {
          this.#materializedTypes[info.id] = cached;
          this.#materializedTypes[target.id] = cached;
          this.model.setBindingType(info, cached);
          return cached;
        }
      }
      case InterfaceDeclaration: {
        if (let (true, cached) = this.#sharedState.declaredNominalTypes.get(target.id)) {
          this.#materializedTypes[info.id] = cached;
          this.#materializedTypes[target.id] = cached;
          this.model.setBindingType(info, cached);
          return cached;
        }
      }
      case SealedVariant: {
        if (let (true, cached) = this.#sharedState.declaredNominalTypes.get(target.id)) {
          this.#materializedTypes[info.id] = cached;
          this.#materializedTypes[target.id] = cached;
          this.model.setBindingType(info, cached);
          return cached;
        }
      }
      case _: {}
    }

    // Cycle detection — keyed by Symbol.id, not name.
    if (this.#pendingTypes.has(target.id)) {
      return null;
    }
    if (this.#pendingTypes.has(info.id)) {
      return null;
    }
    this.#pendingTypes.add(target.id);
    this.#pendingTypes.add(info.id);

    var t: Type | null = this.#materializeType(target);
    if (t != null) {
      let materialized = t as Type;
      this.#materializedTypes[info.id] = materialized;
      this.#materializedTypes[target.id] = materialized;
      this.model.setBindingType(info, materialized);
      if (target.declaration != null) {
        let declNode = target.declaration as Node;
        if (declNode.loc != null) {
          let declLoc = declNode.loc as SourceLocation;
          this.#materializedDeclTypes[declLoc.start] = materialized;
        }
        match (declNode) {
          case ClassDeclaration: {
            this.#sharedState.declaredNominalTypes[target.id] = materialized;
          }
          case InterfaceDeclaration: {
            this.#sharedState.declaredNominalTypes[target.id] = materialized;
          }
          case SealedVariant: {
            this.#sharedState.declaredNominalTypes[target.id] = materialized;
          }
          case _: {}
        }
        // Mirror into the value namespace only for class-like declarations
        // where type and value are intentionally the same constructor value.
        match (declNode) {
          case ClassDeclaration: {
            let valueInfo = this.model.resolveDeclaration(declNode);
            if (valueInfo != null) {
              this.declareBinding(valueInfo as Symbol, materialized);
            }
          }
          case InterfaceDeclaration: {
            let valueInfo = this.model.resolveDeclaration(declNode);
            if (valueInfo != null) {
              this.declareBinding(valueInfo as Symbol, materialized);
            }
          }
          case MixinDeclaration: {
            let valueInfo = this.model.resolveDeclaration(declNode);
            if (valueInfo != null) {
              this.declareBinding(valueInfo as Symbol, materialized);
            }
          }
          case SealedVariant: {
            let valueInfo = this.model.resolveDeclaration(declNode);
            if (valueInfo != null) {
              this.declareBinding(valueInfo as Symbol, materialized);
            }
          }
          case TypeAliasDeclaration: {
            let valueInfo = this.model.resolveDeclaration(declNode);
            if (valueInfo != null) {
              this.declareBinding(valueInfo as Symbol, materialized);
            }
          }
          case EnumDeclaration as ed: {
            let isStringEnum = ed.members.length > 0 && ed.members[0].initializer is StringLiteral;
            let backingType = if (isStringEnum) { this.resolvePreludeType("String") as Type } else { new I32Type() as Type };
            let enumType = new TypeAliasType(ed.name.name, null, backingType, true, null, false, "");
            let fields = new HashMap<String, Type>();
            for (let member in ed.members) {
              fields[member.name.name] = enumType;
            }
            let enumValueType = new RecordT(fields, null);
            enumValueType.enumDeclaration = ed;
            let valueInfo = this.model.resolveDeclaration(declNode);
            if (valueInfo != null) {
              this.declareBinding(valueInfo as Symbol, enumValueType);
            }
            // An enum's BINDING (value-namespace) type is its member record,
            // not the alias type #materializeType produced — the alias would
            // make `Enum.Member` resolve against the backing type. Rebind the
            // import-alias symbols and caches that were set above.
            this.#materializedTypes[info.id] = enumValueType;
            this.#materializedTypes[target.id] = enumValueType;
            this.model.setBindingType(info, enumValueType);
            if (declNode.loc != null) {
              let declLoc = declNode.loc as SourceLocation;
              this.#materializedDeclTypes[declLoc.start] = enumValueType;
            }
            t = enumValueType;
          }
          case _: {}
        }
      }
    }

    this.#pendingTypes.delete(target.id);
    this.#pendingTypes.delete(info.id);
    return t;
  }

  #resolveBuiltinOrPreludeType(name: String): Type | null {
    if (this.#typeScopes.length > 0) {
      if (let (true, t) = this.#typeScopes[0].get(name)) {
        return t;
      }
    }
    if (let (true, t) = this.#sharedState.preludeTypes.get(name)) {
      return t;
    }
    return null;
  }

  #resolveCheckerTypeName(name: String): Type | null {
    for (var i = this.#typeScopes.length - 1; i >= 0; i -= 1) {
      if (let (true, t) = this.#typeScopes[i].get(name)) {
        return t;
      }
    }
    return null;
  }

  /**
   * Create a Type from a Symbol's declaration node.
   * Sets all boolean flags immediately from the AST.
   */
  #materializeType(info: Symbol): Type | null {
    let decl = info.declaration;
    if (decl == null) {
      return null;
    }
    let node = decl as Node;
    match (node) {
      case ClassDeclaration as cd: {
        let typeId = this.freshTypeId();
        var symbolId = info.id;
        let sym = this.model.resolve(cd);
        if (sym != null) {
          symbolId = (sym as Symbol).id;
        } else {
          let isPrelude = this.filePath.startsWith("zena:");
          if (isPrelude) {
            if (let (true, stub) = this.#sharedState.preludeTypes.get(cd.name.name)) {
              match (stub) {
                case ClassType as pt: { symbolId = pt.symbolId; }
                case _: {}
              }
            }
          }
        }
        let ct = new ClassType(typeId, symbolId, cd.name.name);
        let isPrelude = this.filePath.startsWith("zena:");
        if (isPrelude) { this.#sharedState.preludeTypes[cd.name.name] = ct; }
        ct.isFinal = cd.isFinal;
        ct.isAbstract = cd.isAbstract;
        ct.isSealed = cd.isSealed;
        if (cd.isSealed) {
          ct.isAbstract = true;
        }
        if (cd.caseParams != null && !cd.isSealed) {
          ct.isFinal = true;
          ct.isCaseClass = true;
        }
        ct.isExtension = cd.isExtension;
        ct.isResource = cd.isResource;
        // Pre-register forward variant names for sealed classes.
        if (cd.isSealed && cd.sealedVariants != null) {
          let variants = cd.sealedVariants as Array<SealedVariant>;
          for (let variant in variants) {
            if (variant.params == null) {
              let forwardVariantNames = ct.forwardVariantNames ??= new HashSet<String>();
              forwardVariantNames.add(variant.name.name);
            }
          }
        }
        return ct;
      }
      case InterfaceDeclaration as id: {
        let typeId = this.freshTypeId();
        var symbolId = info.id;
        let sym = this.model.resolve(id);
        if (sym != null) {
          symbolId = (sym as Symbol).id;
        } else {
          let isPrelude = this.filePath.startsWith("zena:");
          if (isPrelude) {
            if (let (true, stub) = this.#sharedState.preludeTypes.get(id.name.name)) {
              match (stub) {
                case InterfaceType as pt: { symbolId = pt.symbolId; }
                case _: {}
              }
            }
          }
        }
        let it = new InterfaceType(typeId, symbolId, id.name.name);
        let isPrelude = this.filePath.startsWith("zena:");
        if (isPrelude) { this.#sharedState.preludeTypes[id.name.name] = it; }
        return it;
      }
      case MixinDeclaration as md: {
        let mt = new MixinType(md.name.name);
        mt.sourcePath = this.filePath;
        return mt;
      }
      case SealedVariant as sv: {
        let typeId = this.freshTypeId();
        var symbolId = info.id;
        let sym = this.model.resolve(sv);
        if (sym != null) {
          symbolId = (sym as Symbol).id;
        }
        let ct = new ClassType(typeId, symbolId, sv.name.name);
        ct.isCaseClass = true;
        ct.isFinal = true;
        return ct;
      }
      case EnumDeclaration as ed: {
        let isStringEnum = ed.members.length > 0 && ed.members[0].initializer is StringLiteral;
        let backingType = if (isStringEnum) { this.resolvePreludeType("String") as Type } else { new I32Type() as Type };
        return new TypeAliasType(ed.name.name, null, backingType, true, null, false, "");
      }
      case TypeAliasDeclaration as ta: {
        this.enterScope();
        let declarationParams = ta.typeParameters;
        var typeParams: Array<TypeParameterType> | null = null;
        if (declarationParams != null) {
          let tempTypeParams = new Array<TypeParameterType>();
          typeParams = tempTypeParams;
          for (let param in declarationParams) {
            let tpType = this.getOrCreateTypeParameter(param, null, null);
            tempTypeParams.push(tpType);
            this.declareTypeName(tpType.name, tpType);
            this.registerTypeParameter(param, tpType);
          }

          // Resolve constraints
          for (var i = 0; i < declarationParams.length; i += 1) {
            let param = declarationParams[i];
            if (param.constraint != null) {
              tempTypeParams[i].constraint =
                resolveTypeAnnotation(this, param.constraint as TypeAnnotation, false);
            }
            if (param.defaultType != null) {
              tempTypeParams[i].defaultType =
                resolveTypeAnnotation(this, param.defaultType as TypeAnnotation, false);
            }
          }
        }
        
        let aliasType = new TypeAliasType(
          ta.name.name, typeParams, new HoleType(), ta.isDistinct, null,
          ta.isOpaque, info.modulePath);
        this.#materializedTypes[info.id] = aliasType;
        
        // Permitted here for the same reason as in checkTypeAliasDeclaration:
        // naming an inline tuple is legal, using it outside a return type is
        // not, and containsInlineTuple sees through the alias at each use.
        let targetType: Type = resolveTypeAnnotation(this, ta.typeAnnotation, true);
        checkAliasTargetInlineTuples(this, targetType, ta.typeAnnotation.loc);
        aliasType.target = targetType;
        this.exitScope();
        
        return aliasType;
      }
      case _: {
        return null;
      }
    }
  }

  /**
   * Register a prelude type (available globally without import).
   */
  registerPreludeType(name: String, t: Type): void {
    this.#sharedState.preludeTypes[name] = t;
  }

  /**
   * Register a prelude value (available globally without import).
   */
  registerPreludeValue(name: String, t: Type): void {
    this.#sharedState.preludeValues[name] = t;
  }

  /**
   * Resolve a prelude value by name.
   */
  resolvePreludeValue(name: String): Type | null {
    if (let (true, t) = this.#sharedState.preludeValues.get(name)) {
      return t;
    }
    return null;
  }

  /**
   * Resolve a prelude type by name. Used for identity-based type comparisons
   * (e.g. checking if a ClassType is the prelude Array).
   */
  resolvePreludeType(name: String): Type | null {
    if (let (true, t) = this.#sharedState.preludeTypes.get(name)) {
      return t;
    }
    return null;
  }

  // --- Pipeline ---

  pushPipelineValue(t: Type): void { this.#pipelineStack.push(t); }
  popPipelineValue(): void { this.#pipelineStack.pop(); }
  pipelineValueType: Type | null {
    get {
      if (this.#pipelineStack.length == 0) { return null; }
      return this.#pipelineStack[this.#pipelineStack.length - 1];
    }
  }

  // --- Dependency exports ---

  /**
   * Get the file path of the module being checked.
   */
  filePath: String {
    get { return this.#filePath; }
  }

  /**
   * Get the dependency exports map (import specifier → ModuleExports).
   */
  depExports: HashMap<String, ModuleExports> | null {
    get { return this.#depExports; }
  }

  /**
   * Get the dependency semantic models (import specifier → SemanticModel).
   */
  depModels: HashMap<String, SemanticModel> | null {
    get { return this.#depModels; }
  }

  // --- Return type ---

  returnType: Type | null {
    get { return this.#returnType; }
  }

  setReturnType(t: Type | null): void {
    this.#returnType = t;
  }

  // --- Inferred return types ---

  inferredReturnTypes: Array<Type> {
    get { return this.#inferredReturnTypes; }
  }

  setInferredReturnTypes(a: Array<Type>): void {
    this.#inferredReturnTypes = a;
  }

  addInferredReturnType(t: Type): void {
    this.#inferredReturnTypes.push(t);
  }

  // --- Yield type (generators) ---

  yieldType: Type | null {
    get { return this.#yieldType; }
  }

  setYieldType(t: Type | null): void {
    this.#yieldType = t;
  }

  inferredYieldTypes: Array<Type> {
    get { return this.#inferredYieldTypes; }
  }

  setInferredYieldTypes(a: Array<Type>): void {
    this.#inferredYieldTypes = a;
  }

  addInferredYieldType(t: Type): void {
    this.#inferredYieldTypes.push(t);
  }

  // --- Try depth (yield-in-try rejection) ---

  tryDepth: i32 {
    get { return this.#tryDepth; }
  }

  setTryDepth(d: i32): void {
    this.#tryDepth = d;
  }

  enterTry(): void { this.#tryDepth = this.#tryDepth + 1; }
  exitTry(): void { this.#tryDepth = this.#tryDepth - 1; }

  // --- Async context ---

  asyncValueType: Type | null {
    get { return this.#asyncValueType; }
  }

  setAsyncValueType(t: Type | null): void {
    this.#asyncValueType = t;
  }

  asyncFutureType: Type | null {
    get { return this.#asyncFutureType; }
  }

  setAsyncFutureType(t: Type | null): void {
    this.#asyncFutureType = t;
  }

  // --- Loop depth ---

  enterLoop(): void { this.#loopDepth = this.#loopDepth + 1; }
  exitLoop(): void { this.#loopDepth = this.#loopDepth - 1; }
  inLoop(): boolean { return this.#loopDepth > 0; }

  // --- Class stack ---

  enterClass(ct: ClassType): void { this.#classStack.push(ct); }
  exitClass(): void { this.#classStack.pop(); }
  currentClass: ClassType | null {
    get {
      if (this.#classStack.length == 0) { return null; }
      return this.#classStack[this.#classStack.length - 1];
    }
  }

  /** Enter an interface declaration context (for ThisType resolution). */
  enterInterface(): void { this.#inInterface = true; }
  /** Exit an interface declaration context. */
  exitInterface(): void { this.#inInterface = false; }
  /** Whether we are currently checking an interface declaration body. */
  inInterface: boolean { get { return this.#inInterface; } }

  // --- Narrowing ---

  /**
   * Narrow a binding's type within the current scope.
   * Keyed by Symbol.id for identity-based precision.
   */
  narrowBinding(info: Symbol, t: Type): void {
    let top = this.#narrowings[this.#narrowings.length - 1];
    top[info.id] = t;
  }

  narrowBindingById(id: SymbolId, t: Type): void {
    let top = this.#narrowings[this.#narrowings.length - 1];
    top[id] = t;
  }

  narrowMemberPath(path: String, t: Type): void {
    let top = this.#memberPathNarrowings[this.#memberPathNarrowings.length - 1];
    top[path] = t;
  }

  resolveNarrowedMemberPath(path: String): Type | null {    
    for (var i = this.#memberPathNarrowings.length - 1; i >= 0; i -= 1) {
      if (let (true, t) = this.#memberPathNarrowings[i].get(path)) {
        return t;
      }
    }
    return null;
  }

  isExpressionNarrowed(expr: Expression): boolean {
    let key = getMemberPathKey(this, expr);
    if (key == null) { return false; }
    
    match (expr) {
      case Identifier: {
        let sym = this.model.resolve(expr);
        if (sym == null) { return false; }
        let si = sym as Symbol;
        var i = this.#narrowings.length - 1;
        while (i >= 0) {
          if (this.#narrowings[i].has(si.id)) { return true; }
          i -= 1;
        }
        if (this.resolveNarrowedMemberPath(key as String) != null) { return true; }
        return false;
      }
      case _: {
        return this.resolveNarrowedMemberPath(key as String) != null;
      }
    }
  }

  // --- Scope result access ---

  scopeResult: ScopeResult {
    get { return this.#scopeResult; }
  }

  // --- Error helpers ---

  error(message: String, code: DiagnosticCode, loc: SourceLocation | null): void {
    this.diagnostics.reportError(message, code, loc);
  }

  warning(message: String, code: DiagnosticCode, loc: SourceLocation | null): void {
    this.diagnostics.reportWarning(message, code, loc);
  }
}

/**
 * Register internal compiler intrinsics that are not defined in stdlib source.
 */
let registerCompilerIntrinsics = (ctx: CheckerContext): void => {
  // Builtin types
  ctx.registerPreludeType("anyref", new AnyRefType());

  // =========================
  // Compiler Intrinsics
  // =========================
  // `ByteArray` used to be a primitive of its own (`ByteArrayType`),
  // with hand-written `length`/`[]`/`[]=` handling in the checker and a
  // dedicated wasm array type. It is now simply `array<u8>`: narrow
  // integers give the element a real type, and packed array storage
  // gives it the same `(array (mut i8))` representation as before, so
  // nothing changes at the wasm level.
  //
  // Deliberately registered here rather than as a stdlib type alias.
  // The stdlib is compiled by the PINNED SEED when the compiler is
  // built, and the seed predates narrow integers — a stdlib source file
  // saying `u8` would not compile until the seed was re-cut. Keeping
  // the definition inside the checker means the stdlib text is
  // unchanged and only the compiler's own `U8Type` class is involved,
  // which any seed can compile.
  let byteArrayType = new ArrayType(new U8Type());
  ctx.registerPreludeType("ByteArray", byteArrayType);

  // __byte_array_new(size: i32): ByteArray
  let baNewParams = new Array<Type>();
  baNewParams.push(new I32Type());
  let baNewType = new FunctionType(baNewParams, null, byteArrayType);
  ctx.registerPreludeValue("__byte_array_new", baNewType);

  // __byte_array_length(arr: ByteArray): i32
  let baLenParams = new Array<Type>();
  baLenParams.push(byteArrayType);
  let baLenType = new FunctionType(baLenParams, null, new I32Type());
  ctx.registerPreludeValue("__byte_array_length", baLenType);

  // __byte_array_get(arr: ByteArray, index: i32): i32
  let baGetParams = new Array<Type>();
  baGetParams.push(byteArrayType);
  baGetParams.push(new I32Type());
  let baGetType = new FunctionType(baGetParams, null, new I32Type());
  ctx.registerPreludeValue("__byte_array_get", baGetType);

  // __byte_array_set(arr: ByteArray, index: i32, value: i32): void
  let baSetParams = new Array<Type>();
  baSetParams.push(byteArrayType);
  baSetParams.push(new I32Type());
  baSetParams.push(new I32Type());
  let baSetType = new FunctionType(baSetParams, null, new VoidType());
  ctx.registerPreludeValue("__byte_array_set", baSetType);

  // __byte_array_copy(dest: ByteArray, destOffset: i32, src: ByteArray, srcOffset: i32, len: i32): void
  let baCopyParams = new Array<Type>();
  baCopyParams.push(byteArrayType);
  baCopyParams.push(new I32Type());
  baCopyParams.push(byteArrayType);
  baCopyParams.push(new I32Type());
  baCopyParams.push(new I32Type());
  let baCopyType = new FunctionType(baCopyParams, null, new VoidType());
  ctx.registerPreludeValue("__byte_array_copy", baCopyType);

  // Primitive array intrinsics
  let primArrayTParam = new TypeParameterType("T", null, null);
  let primArrayTParams = new Array<TypeParameterType>();
  primArrayTParams.push(primArrayTParam);
  let primArrayType = new ArrayType(primArrayTParam);
  ctx.registerPreludeType("array", primArrayType);

  // __array_len<T>(arr: array<T>): i32
  let arrLenParams = new Array<Type>();
  arrLenParams.push(primArrayType);
  let arrLenType = new FunctionType(arrLenParams, null, new I32Type());
  arrLenType.typeParameters = primArrayTParams;
  ctx.registerPreludeValue("__array_len", arrLenType);

  // __array_get<T>(arr: array<T>, index: i32): T
  let arrGetParams = new Array<Type>();
  arrGetParams.push(primArrayType);
  arrGetParams.push(new I32Type());
  let arrGetType = new FunctionType(arrGetParams, null, primArrayTParam);
  arrGetType.typeParameters = primArrayTParams;
  ctx.registerPreludeValue("__array_get", arrGetType);

  // __array_set<T>(arr: array<T>, index: i32, value: T): void
  let arrSetParams = new Array<Type>();
  arrSetParams.push(primArrayType);
  arrSetParams.push(new I32Type());
  arrSetParams.push(primArrayTParam);
  let arrSetType = new FunctionType(arrSetParams, null, new VoidType());
  arrSetType.typeParameters = primArrayTParams;
  ctx.registerPreludeValue("__array_set", arrSetType);

  // __array_new<T>(size: i32, value: T): array<T>
  let arrNewParams = new Array<Type>();
  arrNewParams.push(new I32Type());
  arrNewParams.push(primArrayTParam);
  let arrNewType = new FunctionType(arrNewParams, null, primArrayType);
  arrNewType.typeParameters = primArrayTParams;
  ctx.registerPreludeValue("__array_new", arrNewType);

  // __array_new_empty<T>(size: i32): array<T>
  let arrNewEmptyParams = new Array<Type>();
  arrNewEmptyParams.push(new I32Type());
  let arrNewEmptyType = new FunctionType(arrNewEmptyParams, null, primArrayType);
  arrNewEmptyType.typeParameters = primArrayTParams;
  ctx.registerPreludeValue("__array_new_empty", arrNewEmptyType);
};

// ============================================================================
// Public API
// ============================================================================

/**
 * Result of checking a module.
 */
export final class CheckResult(
  model: SemanticModel,
  diagnostics: Array<Diagnostic>
)

let collectPatternSymbols = (ctx: CheckerContext, pattern: Pattern, symbols: Array<Symbol>): void => {
  match (pattern) {
    case IdentifierPattern as ip: {
      let sym = ctx.model.resolveDeclaration(ip);
      if (sym != null) {
        symbols.push(sym as Symbol);
      }
    }
    case RecordPattern {properties}: {
      for (let prop in properties) {
        collectPatternSymbols(ctx, prop.value as Pattern, symbols);
      }
    }
    case TuplePattern {elements}: {
      for (let el in elements) {
        if (el != null && el is Pattern) {
          collectPatternSymbols(ctx, el as Pattern, symbols);
        }
      }
    }
    case AsPattern {pattern as inner, name}: {
      let sym = ctx.model.resolveDeclaration(name);
      if (sym != null) {
        symbols.push(sym as Symbol);
      }
      collectPatternSymbols(ctx, inner as Pattern, symbols);
    }
    case _: {}
  }
};

/**
 * Check a module AST and produce type information.
 *
 * `scopeResult` is the output of scope analysis for this module.
 *
 * `depExports` maps import specifiers (as written in source) to the
 * ModuleExports of the resolved dependency module. When provided, the
 * checker resolves imported type and value names from these exports.
 *
 * This version loads the standard prelude types (String, Array, etc.)
 * automatically.
 */
/**
 * Enforce the import-cycle rules (docs/design/import-cycles.md) for one
 * imported name. When the name's declaration ORIGINATES in a module
 * that runs later in evaluation order (a cycle back edge):
 *  - module-level value bindings are rejected — their initializers
 *    have not run when this module initializes, so a read would
 *    observe the wasm default value;
 *  - functions must carry a fully written signature (every parameter
 *    and the return type) — inference has no stable order across a
 *    cycle. A function-typed binding annotation also satisfies this.
 * Type declarations pass through: they resolve on the second checking
 * pass and involve no initialization order.
 */
let checkCyclicImportRules = (
  ctx: CheckerContext,
  depMod: ModuleExports,
  importedName: String,
  spec: Node
): void => {
  let later = ctx.cyclicLaterPaths;
  if (later == null) {
    return;
  }
  let exp = if (let (true, e) = depMod.get(importedName)) { e } else { null };
  if (exp == null) {
    return;
  }
  let origin = (exp as Symbol).resolveTarget();
  if (!(later as HashSet<String>).has(origin.modulePath)) {
    return;
  }
  // Whether the origin module is itself re-checked (it is inside a
  // cycle). Origins outside the re-check set are checked exactly once,
  // so their types and inferred signatures are unique and stable and
  // may cross freely — only the value/init-order rule applies to them.
  var originRechecked = false;
  if (ctx.cyclicRecheckPaths != null &&
      (ctx.cyclicRecheckPaths as HashSet<String>).has(origin.modulePath)) {
    originRechecked = true;
  }
  match (origin.declaration) {
    case IdentifierPattern {}: {
      // A module-level `let`/`var` binding (the scope builder records
      // the pattern node and stamps the binding's shape on the symbol).
      if (!origin.isFunctionBinding) {
        ctx.error(
          "Cyclic import of value '" + importedName +
            "': module-level bindings cannot cross an import cycle (the exporting module's initializers have not run)",
          DiagnosticCode.CyclicImport, spec.loc);
      } else if (!origin.hasFullSignature && originRechecked) {
        ctx.error(
          "Cyclic import of '" + importedName +
            "': a function crossing an import cycle needs an explicit signature (annotate every parameter and the return type)",
          DiagnosticCode.CyclicImport, spec.loc);
      }
    }
    case EnumDeclaration {}: {
      if (originRechecked) {
        ctx.error(
          "Cyclic import of enum '" + importedName +
            "': enums cannot cross an import cycle",
          DiagnosticCode.CyclicImport, spec.loc);
      }
    }
    case TypeAliasDeclaration {}: {
      if (originRechecked) {
        ctx.error(
          "Cyclic import of type alias '" + importedName +
            "': type aliases cannot cross an import cycle",
          DiagnosticCode.CyclicImport, spec.loc);
      }
    }
    case MixinDeclaration {}: {
      if (originRechecked) {
        ctx.error(
          "Cyclic import of mixin '" + importedName +
            "': mixins cannot cross an import cycle (mixin members are copied at application time)",
          DiagnosticCode.CyclicImport, spec.loc);
      }
    }
    case _: {}
  }
};

/**
 * Index `let f = (…) => …` bindings in a statement list for lazy
 * resolution, enabling forward references and mutual recursion between
 * function bindings. Run over the module body AND over every block's
 * statements: block-scoped function bindings (recursive local `visit`
 * closures, forward references between siblings) resolve through the
 * same pending-function machinery.
 */
let prescanPendingFunctions = (ctx: CheckerContext, body: Array<Statement>): void => {
  var fi = 0;
  while (fi < body.length) {
    match (body[fi]) {
      case VariableDeclaration {pattern, init}: {
        match (pattern) {
          case IdentifierPattern as pat: {
            match (init) {
              case FunctionExpression as fe: {
                let info = ctx.model.resolveDeclaration(pat);
                if (info != null) {
                  ctx.registerPendingFunction((info as Symbol).id, fe as Node);
                }
              }
              case _: {}
            }
          }
          case _: {}
        }
      }
      case FunctionDeclaration {name as namePat, func}: {
        let info = ctx.model.resolveDeclaration(namePat as Node);
        if (info != null) {
          ctx.registerPendingFunction((info as Symbol).id, func as Node);
        }
      }
      case _: {}
    }
    fi += 1;
  }
};

export let checkModule = (
  ast: Module,
  scopeResult: ScopeResult,
  depExports: HashMap<String, ModuleExports> | null,
  depModels: HashMap<String, SemanticModel> | null = null,
  emitLocations: boolean = false,
  sharedState: SharedCheckerState | null = null,
  warnUnnecessaryCasts: boolean = false,
  cyclicLaterPaths: HashSet<String> | null = null,
  cyclicRecheckPaths: HashSet<String> | null = null,
  priorModel: SemanticModel | null = null
): CheckResult => {
  let state = if (sharedState != null) sharedState as SharedCheckerState else new SharedCheckerState();
  let ctx = new CheckerContext(state, ast.path, scopeResult, depExports, depModels, emitLocations, warnUnnecessaryCasts);
  ctx.cyclicLaterPaths = cyclicLaterPaths;
  ctx.cyclicRecheckPaths = cyclicRecheckPaths;
  ctx.priorModel = priorModel;
  ctx.model.typeIdGenerator = state.typeIdGenerator;

  // Register standard prelude types only once per shared state.
  if (!state.preludeRegistered) {
    registerCompilerIntrinsics(ctx);
    state.preludeRegistered = true;
  }

  // Pre-pass: index function declarations for lazy resolution.
  // This enables forward references and mutual recursion for annotated functions.
  // Type declarations (classes, interfaces, etc.) are registered eagerly in
  // Phase 1 below, but are also materialized on demand by resolveTypeName when
  // first referenced (e.g. during Phase 1 superclass resolution).
  prescanPendingFunctions(ctx, ast.body);

  // Emit errors for same-scope redeclarations detected by the scope builder.
  for (let dup in scopeResult.duplicateDeclarations) {
    var loc: SourceLocation | null = null;
    match (dup.node) {
      case TypeAliasDeclaration {name}: { loc = name.loc; }
      case _: {}
    }
    ctx.error("Type '" + dup.name + "' is already declared in this scope.", DiagnosticCode.DuplicateDeclaration, loc);
  }

  // Emit warnings for unused and never-mutated variables.
  for (let unused in scopeResult.unusedVariables) {
    if (unused.name.startsWith("_")) { continue; }
    let loc = if (unused.declaration != null) unused.declaration.loc else null;
    ctx.diagnostics.reportWarning("Variable '" + unused.name + "' is never read.", DiagnosticCode.UnusedVariable, loc);
  }
  
  for (let neverMut in scopeResult.neverMutatedVariables) {
    if (neverMut.name.startsWith("_")) { continue; }
    let loc = if (neverMut.declaration != null) neverMut.declaration.loc else null;
    ctx.diagnostics.reportWarning("Variable '" + neverMut.name + "' is declared as mutable but never written to. Use 'let' instead.", DiagnosticCode.NeverMutatedVariable, loc);
  }

  // === Phase 1: Register all declaration signatures ===
  // Process imports and register type declarations (classes, interfaces,
  // enums, mixins, type aliases, declared functions, symbols) so that ALL
  // member signatures are available before any bodies are checked.
  var ri = 0;
  while (ri < ast.body.length) {
    let stmt = ast.body[ri];
    match (stmt) {
      case ImportDeclaration {}: { checkStatement(ctx, stmt); }
      case ClassDeclaration as cd: { registerClassDeclaration(ctx, cd); }
      case InterfaceDeclaration as id: { checkInterfaceDeclaration(ctx, id); }
      case EnumDeclaration as ed: { checkEnumDeclaration(ctx, ed); }
      case MixinDeclaration as md: { checkMixinDeclaration(ctx, md); }
      case TypeAliasDeclaration {name}: {
        ctx.resolveTypeName(name.name);
      }
      case DeclareFunction as df: { checkDeclareFunction(ctx, df); }
      case SymbolDeclaration as sd: { checkSymbolDeclaration(ctx, sd); }
      case _: {} // Non-declaration statements handled in Phase 2.
    }
    ri += 1;
  }

  // === Phase 2: Main Checking Phase ===
  // This is the actual checking phase where the full structure is validated
  // (bodies, statements, type aliases, etc.), relying on the signatures
  // registered in Phase 1 to seamlessly resolve forward references.
  for (let stmt in ast.body) {
    match (stmt) {
      case ClassDeclaration as cd: { checkClassBodies(ctx, cd); }
      // Already fully handled in Phase 1.
      case ImportDeclaration {}: {}
      case InterfaceDeclaration {}: {}
      case EnumDeclaration {}: {}
      case MixinDeclaration {}: {}
      case TypeAliasDeclaration as ta: { checkTypeAliasDeclaration(ctx, ta); }
      case DeclareFunction {}: {}
      case SymbolDeclaration {}: {}
      case ExportAllDeclaration {}: {}
      case ExportFromDeclaration {}: {}
      case FunctionDeclaration as fd: {
        let sym = ctx.model.resolveDeclaration(fd.name as Node);
        if (sym != null) {
          let symId = (sym as Symbol).id;
          ctx.model.addDeclaredGlobal(symId, fd);
          ctx.enterSymbolReferrer(symId);
          checkStatement(ctx, fd);
          ctx.exitSymbolReferrer(symId);
        } else {
          checkStatement(ctx, fd);
        }
      }
      // Everything else: variable declarations, expression statements, etc.
      case VariableDeclaration as vd: {
        let syms = new Array<Symbol>();
        collectPatternSymbols(ctx, vd.pattern, syms);
        if (syms.length > 0) {
          for (let s in syms) {
            ctx.model.addDeclaredGlobal(s.id, vd);
          }
          let primarySymId = syms[0].id;
          ctx.enterSymbolReferrer(primarySymId);
          checkStatement(ctx, vd);
          ctx.exitSymbolReferrer(primarySymId);
        } else {
          checkStatement(ctx, vd);
        }
      }
      case _: {
        ctx.enterNodeReferrer(stmt.id as i32);
        checkStatement(ctx, stmt);
        ctx.exitNodeReferrer(stmt.id as i32);
      }
    }
  }

  // Collect diagnostics from the bag into the model.
  for (let diagnostic in ctx.diagnostics.diagnostics) {
    ctx.model.addDiagnostic(diagnostic);
  }

  // Finalize: bind exported types directly onto export Symbols
  // so importers can resolve them cleanly.
  for (let {key as expName, value as exInfo} in scopeResult.exports) {
    let declaration = exInfo.declaration;
    
    var exportType = ctx.resolveTypeName(expName);
    if (exportType == null) {
      // Re-exported types (export {X} from './dep'): this module has no local
      // type registration for the name, so forward the origin module's export
      // type. Without this, importers fall back to the export symbol's VALUE
      // binding for the type — wrong for enums, whose type (the alias) and
      // value (the member record) differ.
      let models = ctx.depModels;
      if (models != null) {
        let depModels = models as HashMap<String, SemanticModel>;
        for (let depKey in depModels.keys()) {
          if (let (true, depModel) = depModels.get(depKey)) {
            let depExportType = depModel.getExportType(expName);
            if (depExportType != null) {
              exportType = depExportType;
              break;
            }
          }
        }
      }
    }
    if (exportType != null) {
      ctx.model.setExportType(expName, exportType);
    }

    var valueType: Type | null = null;
    if (declaration != null) {
      let localSi = ctx.model.resolveDeclaration(declaration);
      if (localSi != null) {
        valueType = ctx.model.getBindingType(localSi);
      }
    }
    if (valueType == null) {
      // Re-exported symbols (export {X} from './dep') were already bound by
      // the origin module's finalize pass — reuse that binding. Falling
      // through to `exportType` here would bind the TYPE, which is wrong for
      // enums: their value namespace is the member record, and the stale
      // type binding would shadow the origin's record for importers.
      valueType = lookupBindingTypeInDeps(ctx, exInfo);
    }
    if (valueType == null) {
      valueType = exportType;
    }
    if (valueType != null) {
      ctx.model.setBindingType(exInfo, valueType);
    }
  }

  return new CheckResult(ctx.model, ctx.diagnostics.diagnostics);
};

/**
 * Maximum alias hops `containsInlineTuple` will follow. Aliases nest only a
 * few deep in practice; the bound exists because a recursive alias
 * (`type T = Array<T>`) otherwise cycles forever between the structural and
 * alias steps — `resolving` guards only the declaration, not later uses. A
 * chain this long is already an error elsewhere, and an endlessly expanding
 * alias cannot name a concrete inline tuple, so giving up is safe.
 */
let maxAliasHops = 32;

let containsInlineTuple = (t: Type, aliasHops: i32 = 0): boolean => {
  if (t is InlineTupleT) { return true; }
  match (t) {
    case InlineTupleT as _tut: true
    // Aliases are transparent here — `type Pair = inline (i32, i32)` is
    // legal to declare, so the restriction has to be enforced through the
    // name at each use. `resolving` means we are inside this alias's own
    // target resolution, where reading `target` would not terminate.
    case TypeAliasType as alias: {
      if (alias.resolving || aliasHops >= maxAliasHops) {
        false
      } else {
        containsInlineTuple(alias.target, aliasHops + 1)
      }
    }
    case UnionT {types}: {
      for (let subtype in types) {
        if (containsInlineTuple(subtype, aliasHops)) return true;
      }
      false
    }
    case ArrayType {elementType}: containsInlineTuple(elementType, aliasHops)
    case TupleT {elementTypes}: {
      for (let subtype in elementTypes) {
        if (containsInlineTuple(subtype, aliasHops)) return true;
      }
      false
    }
    case RecordT {properties}: {
      for (let entry in properties) {
        if (containsInlineTuple(entry.value, aliasHops)) return true;
      }
      false
    }
    case FunctionType {parameters, typeArguments}: {
      for (let param in parameters) {
        if (containsInlineTuple(param, aliasHops)) return true;
      }
      if (typeArguments != null) {
        let args = typeArguments as Array<Type>;
        for (let arg in args) {
          if (containsInlineTuple(arg, aliasHops)) return true;
        }
      }
      false
    }
    case ClassType {typeArguments}: {
      if (typeArguments != null) {
        let args = typeArguments as Array<Type>;
        for (let arg in args) {
          if (containsInlineTuple(arg, aliasHops)) return true;
        }
      }
      false
    }
    case InterfaceType {typeArguments}: {
      if (typeArguments != null) {
        let args = typeArguments as Array<Type>;
        for (let arg in args) {
          if (containsInlineTuple(arg, aliasHops)) return true;
        }
      }
      false
    }
    case _: false
  }
  // TODO: this is unreachable, shouldn't be neccessary
  return false;
};


/**
 * Report inline tuples that a type alias may not contain.
 *
 * An alias may *name* an inline tuple — `type Pair = inline (i32, i32)` — so
 * the target's top level is allowed to be one, or a union of them. That is the
 * position the alias stands for, and every use of the name is re-checked
 * against the position it appears in.
 *
 * Anything deeper is illegal no matter where the alias is used: an inline
 * tuple in a parameter, an array element, or a record field has no legal
 * position to be used *from*. Those are reported here, at the declaration,
 * which is where the author can see them.
 */
let checkAliasTargetInlineTuples = (
  ctx: CheckerContext,
  target: Type,
  loc: SourceLocation | null,
): void => {
  let reportNested = (t: Type): void => {
    if (containsInlineTuple(t)) {
      ctx.error(
        "Inline tuple types can only appear in function return types, not here.",
        DiagnosticCode.TypeMismatch,
        loc,
      );
    }
  };
  // A top-level inline tuple is fine, but its own elements are not.
  let checkMember = (member: Type): void => {
    if (member is InlineTupleT) {
      for (let element in (member as InlineTupleT).elementTypes) {
        reportNested(element);
      }
    } else {
      reportNested(member);
    }
  };
  match (target) {
    case UnionT {types}: {
      for (let member in types) {
        checkMember(member);
      }
    }
    case _: { checkMember(target); }
  }
};

/**
 * Resolve a type annotation AST node to a Type.
 */
/**
 * The three ownership wrappers from `zena:ownership`. A `resource class` may
 * only be named as a type argument of one of these — see
 * docs/design/ownership.md §"Resource-ness and affineness are different
 * properties".
 */
/** The resource type behind a handle, or null if `t` is not a handle. */
let ownershipHandleInner = (t: Type): Type | null => {
  if (!isOwnershipWrapper(t)) { return null; }
  let args = (t as TypeAliasType).typeArguments;
  if (args == null) { return null; }
  let a = args as Array<Type>;
  if (a.length != 1) { return null; }
  return a[0];
};

let isOwnershipWrapper = (t: Type): boolean => {
  if (!(t is TypeAliasType)) { return false; }
  let ta = t as TypeAliasType;
  if (!ta.isDistinct) { return false; }
  return ta.name == "Own" || ta.name == "Borrow" || ta.name == "Unmanaged";
};

/** The name of the handle `t` is, or "" if it is not one. */
let ownershipHandleName = (t: Type): String => {
  if (!isOwnershipWrapper(t)) { return ""; }
  return (t as TypeAliasType).name;
};

let resolveTypeAnnotation = (ctx: CheckerContext, ann: TypeAnnotation, allowInlineTuple: boolean = false): Type => {
  let t = resolveTypeAnnotationInner(ctx, ann, allowInlineTuple);
  if (!allowInlineTuple) {
    if (containsInlineTuple(t)) {
    ctx.error("Inline tuple types can only appear in function return types, not here.", DiagnosticCode.TypeMismatch, ann.loc);
    }
  }
  return t;
};

let resolveTypeAnnotationInner = (ctx: CheckerContext, ann: TypeAnnotation, allowInlineTuple: boolean): Type => match (ann) {
  case NamedTypeAnnotation {name, typeArguments}: {
    // Resolve through scope analysis so lexical shadowing is honored.
    let resolved = ctx.resolveTypeReference(ann, name);
    if (resolved == null) {
      ctx.error(
        "Type '" + name + "' not found.",
        DiagnosticCode.SymbolNotFound,
        ann.loc
      );
      return new ErrorType();
    }
    
    // A `resource class` has no unwrapped form, so naming it bare is an
    // error. Own/Borrow/Unmanaged are the only contexts that may.
    let resourceOk = ctx.resourceMentionOk;
    ctx.resourceMentionOk = false;
    if (resolved is ClassType && (resolved as ClassType).isResource && !resourceOk) {
      ctx.error(
        "'" + name + "' is a resource class and has no unwrapped form. " +
        "Write 'Own<" + name + ">', 'Borrow<" + name + ">' or 'Unmanaged<" + name + ">'.",
        DiagnosticCode.TypeMismatch,
        ann.loc
      );
      return new ErrorType();
    }

    // Handle generic type arguments
    let resolvedArgs = new Array<Type>();
    var hasTypeArgs = false;
    let argsMayBeResource = isOwnershipWrapper(resolved as Type);

    if (typeArguments != null) {
      if (typeArguments.length > 0) {
        hasTypeArgs = true;
        for (let typeArgument in typeArguments) {
          ctx.resourceMentionOk = argsMayBeResource;
          let resolvedArg = resolveTypeAnnotation(ctx, typeArgument, allowInlineTuple);
                    resolvedArgs.push(resolvedArg);
        }
      }
    }

    match (resolved as Type) {
      case ClassType as ct: {
        if (ct.typeParameters != null) {
          applyAndCheckTypeArguments(ctx, ct.typeParameters as Array<TypeParameterType>, resolvedArgs, ann.loc);
          return instantiateClassType(ct, resolvedArgs);
        }
      }
      case MixinType as mt: {
        if (mt.typeParameters != null) {
          applyAndCheckTypeArguments(ctx, mt.typeParameters as Array<TypeParameterType>, resolvedArgs, ann.loc);
          let inst = instantiateMixinType(mt, resolvedArgs);
          if (mt.onType != null) {
            inst.onType = substituteTypeParams(mt.typeParameters, resolvedArgs, mt.onType as Type);
          }
          return inst;
        }
      }
      case InterfaceType as it: {
        if (it.typeParameters != null) {
          applyAndCheckTypeArguments(ctx, it.typeParameters as Array<TypeParameterType>, resolvedArgs, ann.loc);
          return instantiateInterfaceType(it, resolvedArgs);
        }
      }
      case TypeAliasType as tat: {
        if (tat.typeParameters != null) {
          applyAndCheckTypeArguments(ctx, tat.typeParameters as Array<TypeParameterType>, resolvedArgs, ann.loc);
          let target = substituteTypeParams(tat.typeParameters, resolvedArgs, tat.target);
          if (tat.isDistinct || tat.resolving) {
            let inst = instantiateTypeAliasType(tat, resolvedArgs);
            inst.target = target;
            return inst;
          }
          return target;
        } else {
          if (hasTypeArgs) {
            ctx.error("Type '" + name + "' is not generic.", DiagnosticCode.TypeMismatch, ann.loc);
          }
          return if (tat.isDistinct || tat.resolving) tat else tat.target;
        }
      }
      case ArrayType as at: {
        // Only the bare `array` prelude type is generic — its element is
        // a type parameter awaiting an argument. A name that already
        // resolves to a concrete array (`ByteArray` is `array<u8>`) is
        // complete, and demanding an argument for it would reject every
        // use of the name.
        if (!(at.elementType is TypeParameterType)) {
          if (hasTypeArgs) {
            ctx.error("Type '" + name + "' is not generic.", DiagnosticCode.TypeMismatch, ann.loc);
          }
          return at;
        }
        if (!hasTypeArgs || resolvedArgs.length != 1) {
          ctx.error("Type 'array' is generic and requires exactly 1 type argument.", DiagnosticCode.TypeMismatch, ann.loc);
          return new ErrorType();
        }
        return new ArrayType(resolvedArgs[0]);
      }
      case _: {
        if (hasTypeArgs) {
          console.log("resolveTypeAnnotation Type not generic: '" + name + "' resolved to: " + typeToString(resolved as Type));
          ctx.error("Type '" + name + "' is not generic.", DiagnosticCode.TypeMismatch, ann.loc);
        }
      }
    }
    
    resolved as Type
  }
  case UnionTypeAnnotation {types}: {
    let resolved = new Array<Type>();
    var i = 0;
    while (i < types.length) {
      let t = resolveTypeAnnotation(ctx, types[i], allowInlineTuple);
      resolved.push(t);
      i += 1;
    }

    // Check for multiple extension types on the same underlying type.
    var ei = 0;
    while (ei < resolved.length) {
      var ext1: ClassType | null = null;
      match (resolved[ei]) {
        case ClassType as ct: {
          if (ct.isExtension && ct.onType != null) {
            ext1 = ct;
          }
        }
        case _: {}
      }
      
      if (ext1 != null) {
        var ej = ei + 1;
        while (ej < resolved.length) {
          var ext2: ClassType | null = null;
          match (resolved[ej]) {
            case ClassType as ct: {
              if (ct.isExtension && ct.onType != null) {
                ext2 = ct;
              }
            }
            case _: {}
          }
          
          if (ext2 != null && ext1 != null) {
            let onType1 = ext1.onType;
            let onType2 = ext2.onType;
            if (onType1 != null && onType2 != null) {
              if (isAssignableTo(ctx, onType1 as Type, onType2 as Type) && isAssignableTo(ctx, onType2 as Type, onType1 as Type)) {
                ctx.error(
                  "Union types cannot contain multiple extension types on the same underlying type: '" +
                  typeToString(ext1) + "' and '" + typeToString(ext2) + "'.",
                  DiagnosticCode.TypeMismatch,
                  ann.loc
                );
              }
            }
          }
          ej += 1;
        }
      }
      ei += 1;
    }

    createUnionType(resolved, ctx, ann.loc)
  }
  case FunctionTypeAnnotation {params, returnType}: {
    let paramTypes = new Array<Type>();
    var i = 0;
    while (i < params.length) {
      let paramType = resolveTypeAnnotation(ctx, params[i], allowInlineTuple);
            paramTypes.push(paramType);
      i += 1;
    }
    let retType = resolveTypeAnnotation(ctx, returnType, true);
    new FunctionType(paramTypes, null, retType)
  }
  case LiteralTypeAnnotation {value}: {
    match (value) {
      case BooleanLiteral {value}: new BoolLiteralType(value)
      case NumberLiteral {raw}: {
        // Number literal type — check for decimal point to decide base type.
        // Or rather, instantiate NumLiteralType.
        new NumLiteralType(raw)
      }
      case StringLiteral {value}: new StringLiteralType(value)
      case NullLiteral {}: new NullType()
      case _: new ErrorType()
    }
  }
  case RecordTypeAnnotation {properties}: {
    let props = new HashMap<String, Type>();
    var optionals: HashSet<String> | null = null;
    for (let prop in properties) {
      let resolved = resolveTypeAnnotation(ctx, prop.typeAnnotation, allowInlineTuple);
            props[prop.name.name] = resolved;
      if (prop.optional) {
        optionals ??= new HashSet<String>();
        optionals.add(prop.name.name);
      }
    }
    new RecordT(props, optionals)
  }
  case TupleTypeAnnotation {elementTypes}: {
    let elTypes = new Array<Type>();
    var i = 0;
    while (i < elementTypes.length) {
      let resolved = resolveTypeAnnotation(ctx, elementTypes[i], allowInlineTuple);
            elTypes.push(resolved);
      i += 1;
    }
    new TupleT(elTypes)
  }
  case InlineTupleTypeAnnotation {elementTypes}: {
    let elTypes = new Array<Type>();
    var i = 0;
    while (i < elementTypes.length) {
      elTypes.push(resolveTypeAnnotation(ctx, elementTypes[i], allowInlineTuple));
      i += 1;
    }
    new InlineTupleT(elTypes)
  }
  case ThisTypeAnnotation {loc}: {
    if (ctx.currentClass != null || ctx.inInterface) {
      new ThisType()
    } else {
      ctx.error(
        "'this' type is only valid inside a class or interface.",
        DiagnosticCode.TypeMismatch,
        loc
      );
      new ErrorType()
    }
  }
};

/**
 * Check if an array of types already contains a type equal to target.
 */
let containsType = (types: Array<Type>, target: Type): boolean => {
  var i = 0;
  while (i < types.length) {
    if (typesEqual(types[i], target)) { return true; }
    i += 1;
  }
  return false;
};

/**
 * Combines the arm types of a `match` or `try` into the type of the
 * whole expression.
 *
 * `never` arms drop out — they never complete, so they contribute no
 * value (createUnionType does this). A `void` arm instead ABSORBS: it
 * completes, and completes with nothing, so no value survives every
 * path and the expression as a whole has none. `T | void` is not a
 * type any binding can hold and has no wasm representation, so
 * producing it here only defers the failure to codegen.
 *
 * This is what makes a statement-position `try`/`match` whose arms end
 * in an assignment (`{ … x = v; }`, an expression statement with a
 * value) come out `void` rather than `T | void`.
 */
let combineArmTypes = (types: Array<Type>, ctx: CheckerContext | null = null, loc: SourceLocation | null = null): Type => {
  for (let t in types) {
    if (t is VoidType) {
      return new VoidType();
    }
  }
  return createUnionType(types, ctx, loc);
};

/**
 * Create a union type, flattening nested unions and deduplicating.
 */
let createUnionType = (types: Array<Type>, ctx: CheckerContext | null = null, loc: SourceLocation | null = null): Type => {
  var deduped = new Array<Type>();
  var hasBoolean = false;

  // Flatten nested unions and collect types
  for (let type in types) {
    match (type) {
      case UnionT {types as inner}: {
        for (let innerType in inner) {
          if (innerType is BooleanType) { hasBoolean = true; }
          if (!containsType(deduped, innerType)) { deduped.push(innerType); }
        }
      }
      case NeverType: {}
      case BooleanType: {
        hasBoolean = true;
        if (!containsType(deduped, type)) { deduped.push(type); }
      }
      case _: {
        if (!containsType(deduped, type)) { deduped.push(type); }
      }
    }
  }

  // If the union contains boolean, remove BoolLiteralTypes.
  if (hasBoolean) {
    let withoutLits = new Array<Type>();
    for (let t in deduped) {
      if (!(t is BoolLiteralType)) {
        withoutLits.push(t);
      }
    }
    deduped = withoutLits;
  }

  // Compact NumberLiteralTypes if NumberType exists
  var hasNum = false;
  for (let t in deduped) {
    if (isNumericType(t)) {
       // Wait, we don't have a single NumberType, but many numeric types like f64.
       // However, we mainly care about boolean for this bug.
    }
  }

  if (deduped.length == 0) { return new NeverType(); }
  if (deduped.length == 1) { return deduped[0]; }

  if (ctx != null) {
    var hasPrimitive = false;
    var hasReference = false;
    var hasInlineTuple = false;
    let primitiveBases = new Array<String>();

    for (let t in deduped) {
      if (t is InlineTupleT) {
        hasInlineTuple = true;
      }
      var baseName: String | null = null;
      if (isNumericType(t)) {
        baseName = typeToString(baseType(t));
      } else if (t is BooleanType || t is BoolLiteralType) {
        baseName = "boolean";
      }

      if (baseName != null) {
        hasPrimitive = true;
        var found = false;
        for (let primitiveBase in primitiveBases) {
          if (primitiveBase == baseName) {
            found = true;
            break;
          }
        }
        if (!found) {
          primitiveBases.push(baseName);
        }
      } else if (t is VoidType || t is NeverType || t is ErrorType || t is UnknownType || t is HoleType || t is InlineTupleT) {
        // Neither primitive nor reference.
      } else {
        hasReference = true;
      }      
    }

    if (hasInlineTuple && (hasPrimitive || hasReference)) {
      ctx.error("cannot mix inline tuple types with other representations", DiagnosticCode.TypeMismatch, loc);
    } else if (hasPrimitive && hasReference) {
      ctx.error("Union types cannot mix primitive types with reference types", DiagnosticCode.TypeMismatch, loc);
    } else if (primitiveBases.length > 1) {
      ctx.error("Union types cannot mix primitives of different base types", DiagnosticCode.TypeMismatch, loc);
    }
  }

  return new UnionT(deduped);
};

/**
 * Extract the element type from an iterable type for for-in loops.
 * Checks if the type implements Iterable<T> by identity-based comparison
 * against the prelude Iterable interface.
 * Reports an error if the type is not iterable.
 */
let getElementType = (
  ctx: CheckerContext,
  iterableType: Type,
  iterableExpr: Expression
): Type => {
  match (iterableType) {
    case ArrayType {elementType}: {
      return elementType;
    }
    case ClassType as ct: {
      return getElementTypeFromClass(ctx, ct, iterableExpr);
    }
    case InterfaceType as it: {
      // If the interface IS Iterator, use its first type argument.
      if (it.name == "Iterator" || it.name == "Iterable") {
         if (it.typeArguments != null) {
            let args = it.typeArguments as Array<Type>;
            if (args.length > 0) { return args[0]; }
         }
      }

      let elemType = findIterableInterface(ctx, it);
      if (elemType != null) {
        return elemType as Type;
      }
      ctx.error(
        "Type '" + it.name + "' is not iterable.",
        DiagnosticCode.TypeMismatch,
        iterableExpr.loc
      );
      return new ErrorType();
    }
    case ErrorType: {
      return new ErrorType();
    }
    case _: {
      ctx.error(
        "Type is not iterable.",
        DiagnosticCode.TypeMismatch,
        iterableExpr.loc
      );
      return new ErrorType();
    }
  }
};

let getElementTypeFromClass = (
  ctx: CheckerContext,
  ct: ClassType,
  iterableExpr: Expression
): Type => {
  // If the class IS Iterator, use its first type argument.
  let iteratorPrelude = ctx.resolvePreludeType("Iterator");
  if (iteratorPrelude != null && iteratorPrelude is InterfaceType) {
    let pt = iteratorPrelude as InterfaceType;
    if (ct.id == pt.id) {
       if (ct.typeArguments != null) {
          let args = ct.typeArguments as Array<Type>;
          if (args.length > 0) { return args[0]; }
       }
    }
  }

  // Check if the class implements Iterable<T> (walk implementsList).
  var i = 0;
  while (i < ct.implementsList.length) {
    let iface = ct.implementsList[i];
    let elemType = findIterableInterface(ctx, iface);
    if (elemType != null) {
      let result = elemType as Type;
      return substituteTypeParams(ct.typeParameters, ct.typeArguments, result);
    }
    i += 1;
  }
  // Walk superclass chain.
  if (ct.superType != null) {
    return getElementType(ctx, ct.superType as Type, iterableExpr);
  }
  ctx.error(
    "Type '" + ct.name + "' is not iterable.",
    DiagnosticCode.TypeMismatch,
    iterableExpr.loc
  );
  return new ErrorType();
};

/**
 * Check if an interface type is Iterable<T> or extends Iterable<T>.
 * Uses identity-based comparison against the prelude Iterable type.
 * Returns the element type T if found, null otherwise.
 */
let findIterableInterface = (ctx: CheckerContext, iface: InterfaceType): Type | null => {
  let prelude = ctx.resolvePreludeType("Iterable");
  if (prelude == null) { return null; }
  match (prelude as Type) {
    case InterfaceType as iterableType: {
      // Compare by type id — instantiateInterfaceType preserves the source id.
      let sourceId = if (iface.genericSource != null) {
        (iface.genericSource as InterfaceType).id
      } else {
        iface.id
      };
      if (sourceId == iterableType.id) {
        if (iface.typeArguments != null) {
          let args = iface.typeArguments as Array<Type>;
          if (args.length > 0) { return args[0]; }
        }
        return null;
      }
      // Walk the extends list, substituting this instantiation's type
      // arguments into inherited entries first — the extendsList is
      // shared by reference with the generic source, so its entries
      // mention the SOURCE's parameters.
      for (let ext in iface.extendsList) {
        var parent: Type = ext as Type;
        if (iface.typeArguments != null) {
          parent = substituteTypeParams(
              iface.typeParameters, iface.typeArguments, parent);
        }
        if (parent is InterfaceType) {
          let result = findIterableInterface(ctx, parent as InterfaceType);
          if (result != null) { return result; }
        }
      }
      return null;
    }
    case _: { return null; }
  }
};

/**
 * Substitute type parameters with their corresponding type arguments.
 * typeParams: the type parameter names/types from the generic class
 * typeArgs: the actual type arguments
 * t: the type to substitute within
 *
 * TODO: Consider making this generic over the Type t so that it returns the
 * same type it's given. The only problem is that we don't really want it
 * monomorphized.
 */
let substituteTypeParams = (
  typeParams: Array<TypeParameterType> | null,
  typeArgs: Array<Type> | null,
  t: Type
): Type => {
  if (typeParams == null || typeArgs == null) { return t; }
  let params = typeParams as Array<TypeParameterType>;
  let args = typeArgs as Array<Type>;
  let tpLen = params.length;
  let taLen = args.length;

  match (t) {
    case TypeParameterType as tpRef: {
      // Find the matching type parameter (by identity) and substitute.
      for (var i = 0; i < tpLen && i < taLen; i += 1) {
        if (params[i] === tpRef) {
          return args[i];
        }
      }
      // No match found, return original.
      return t;
    }
    case UnionT {types}: {
      let substituted = new Array<Type>();
      for (let t in types) {
        substituted.push(substituteTypeParams(typeParams, typeArgs, t));
      }
      return createUnionType(substituted);
    }
    case ArrayType {elementType}: {
      let subElem = substituteTypeParams(typeParams, typeArgs, elementType);
      return new ArrayType(subElem);
    }
    case TupleT {elementTypes}: {
      let subElems = new Array<Type>();
      for (let elem in elementTypes) {
        subElems.push(substituteTypeParams(typeParams, typeArgs, elem));
      }
      return new TupleT(subElems);
    }
    case InlineTupleT {elementTypes}: {
      let subElems = new Array<Type>();
      for (let elem in elementTypes) {
        subElems.push(substituteTypeParams(typeParams, typeArgs, elem));
      }
      return new InlineTupleT(subElems);
    }
    case RecordT {properties, optionalProperties}: {
      let subProps = new HashMap<String, Type>();
      for (let {key} in properties) {
        subProps[key] = substituteTypeParams(typeParams, typeArgs, properties[key]);
      }
      return new RecordT(subProps, optionalProperties);
    }
    case FunctionType as ft: {
      let subParams = new Array<Type>();
      for (let param in ft.parameters) {
        subParams.push(substituteTypeParams(typeParams, typeArgs, param));
      }
      let subRet = substituteTypeParams(typeParams, typeArgs, ft.returnType);
      let res = new FunctionType(subParams, ft.parameterNames, subRet);
      res.typeParameters = ft.typeParameters;
      res.optionalParameters = ft.optionalParameters;
      res.parameterInitializers = ft.parameterInitializers;
      res.parameterSymbols = ft.parameterSymbols;
      if (ft.overloads != null) {
        let subOvs = new Array<FunctionType>();
        let ovs = ft.overloads as Array<FunctionType>;
        for (let ov in ovs) {
          if (ov == ft) {
            subOvs.push(res);
          } else {
            subOvs.push(substituteTypeParams(typeParams, typeArgs, ov) as FunctionType);
          }
        }
        res.overloads = subOvs;
      }
      res.isFinal = ft.isFinal;
      res.isAbstract = ft.isAbstract;
      res.typeArguments = ft.typeArguments;
      res.genericSource = ft.genericSource;
      res.functionSymbolId = ft.functionSymbolId;
      res.functionSymbolName = ft.functionSymbolName;
      return res;
    }
    case ClassType as ct: {
      if (ct.typeArguments != null) {
        let srcArgs = ct.typeArguments as Array<Type>;
        let subArgs = new Array<Type>();
        var changed = false;
        for (let arg in srcArgs) {
          let sub = substituteTypeParams(typeParams, typeArgs, arg);
          subArgs.push(sub);
          if (sub !== arg) {
            changed = true;
          }
        }
        if (changed) {
          return instantiateClassType(ct.genericSource ?? ct, subArgs);
        }
      }
      return t;
    }
    case InterfaceType as it: {
      if (it.typeArguments != null) {
        let srcArgs = it.typeArguments as Array<Type>;
        let subArgs = new Array<Type>();
        var changed = false;
        for (let arg in srcArgs) {
          let sub = substituteTypeParams(typeParams, typeArgs, arg);
          subArgs.push(sub);
          if (sub !== arg) {
            changed = true;
          }
        }
        if (changed) {
          return instantiateInterfaceType(it.genericSource ?? it, subArgs);
        }
      }
      return t;
    }
    case MixinType as mt: {
      if (mt.typeArguments != null) {
        let srcArgs = mt.typeArguments as Array<Type>;
        let subArgs = new Array<Type>();
        var changed = false;
        for (let arg in srcArgs) {
          let sub = substituteTypeParams(typeParams, typeArgs, arg);
          subArgs.push(sub);
          if (sub !== arg) {
            changed = true;
          }
        }
        if (changed) {
          let genSource = mt.genericSource ?? mt;
          let inst = instantiateMixinType(genSource, subArgs);
          if (genSource.onType != null && genSource.typeParameters != null) {
            inst.onType = substituteTypeParams(genSource.typeParameters, subArgs, genSource.onType as Type);
          }
          return inst;
        }
      }
      return t;
    }
    case _: { return t; }
  }
};

/**
 * Substitutes ThisType with a concrete receiver type.
 * Used when resolving method types at call sites and method body checking.
 */
let substituteThisType = (receiverType: Type, t: Type): Type => {
  match (t) {
    case ThisType: { return receiverType; }
    case FunctionType as ft: {
      let subParams = new Array<Type>();
      var changed = false;
      for (let param in ft.parameters) {
        let sub = substituteThisType(receiverType, param);
        if (sub !== param) { changed = true; }
        subParams.push(sub);
      }
      let subRet = substituteThisType(receiverType, ft.returnType);
      if (!changed && subRet === ft.returnType) { return t; }
      let newFt = new FunctionType(subParams, ft.parameterNames, subRet);
      newFt.typeParameters = ft.typeParameters;
      newFt.optionalParameters = ft.optionalParameters;
      newFt.parameterInitializers = ft.parameterInitializers;
      newFt.parameterSymbols = ft.parameterSymbols;
      if (ft.overloads != null) {
        let subOvs = new Array<FunctionType>();
        let ovs = ft.overloads as Array<FunctionType>;
        for (let ov in ovs) {
          if (ov == ft) {
            subOvs.push(newFt);
          } else {
            subOvs.push(substituteThisType(receiverType, ov) as FunctionType);
          }
        }
        newFt.overloads = subOvs;
      }
      newFt.isFinal = ft.isFinal;
      newFt.isAbstract = ft.isAbstract;
      newFt.functionSymbolId = ft.functionSymbolId;
      newFt.functionSymbolName = ft.functionSymbolName;
      return newFt;
    }
    case UnionT {types}: {
      let substituted = new Array<Type>();
      for (let type in types) {
        substituted.push(substituteThisType(receiverType, type));
      }
      return createUnionType(substituted);
    }
    case ArrayType {elementType}: {
      return new ArrayType(substituteThisType(receiverType, elementType));
    }
    case _: { return t; }
  }
};

/**
 * Applies default type arguments and checks constraints.
 * Modifies `typeArgs` in place if defaults are applied.
 */
let applyAndCheckTypeArguments = (
  ctx: CheckerContext,
  typeParams: Array<TypeParameterType>,
  typeArgs: Array<Type>,
  loc: SourceLocation | null
): void => {
  // Apply defaults if type arguments are missing
  for (var i = typeArgs.length; i < typeParams.length; i += 1) {
    let param = typeParams[i];
    if (param.defaultType != null) {
      typeArgs.push(substituteTypeParams(typeParams, typeArgs, param.defaultType as Type));
    } else {
      ctx.error(
        `Expected ${typeParams.length} type arguments, but got ${i}.`,
        DiagnosticCode.ArgumentCountMismatch,
        loc
      );
      while (typeArgs.length < typeParams.length) {
        typeArgs.push(new ErrorType());
      }
      break;
    }
  }

  if (typeArgs.length > typeParams.length) {
    ctx.error(
      `Expected ${typeParams.length} type arguments, but got ${typeArgs.length}.`,
      DiagnosticCode.ArgumentCountMismatch,
      loc
    );
    // Truncate to avoid issues later
    while (typeArgs.length > typeParams.length) {
      typeArgs.pop();
    }
  }

  // Check constraints
  for (var j = 0; j < typeParams.length && j < typeArgs.length; j += 1) {
    let param = typeParams[j];
    if (param.constraint != null) {
      let expectedConstraint = substituteTypeParams(typeParams, typeArgs, param.constraint as Type);

      // If the argument is itself a type parameter with a constraint, check
      // whether its constraint satisfies the required constraint (e.g.
      // `class HashMap<K extends Hashable> implements Map<K, V>`).
      var effectiveArg = typeArgs[j];
      if (effectiveArg is TypeParameterType) {
        let argParam = effectiveArg as TypeParameterType;
        if (argParam.constraint != null) {
          effectiveArg = argParam.constraint as Type;
        }
      }

      if (!isAssignableTo(ctx, effectiveArg, expectedConstraint) &&
          !satisfiesHashableConstraint(ctx, effectiveArg, expectedConstraint)) {
        ctx.error(
          "Type '" + typeToString(typeArgs[j]) + "' does not satisfy constraint '" +
            typeToString(expectedConstraint) + "' for type parameter '" + param.name + "'.",
          DiagnosticCode.TypeMismatch,
          loc
        );
      }
    }
  }
};

/**
 * Special satisfaction rule for the well-known `Hashable` interface
 * (zena:hashable). Types that cannot nominally implement an interface still
 * hash correctly via the `hash`/`eq` intrinsics, so they satisfy a Hashable
 * constraint:
 *
 * - Numeric primitives and boolean, which hash by value (i64/u64 fold to
 *   i32, floats hash their bits with -0.0 normalized to +0.0).
 * - Enums and distinct type aliases, judged by their underlying type.
 * - Case classes, whose hashCode()/operator == are compiler-generated.
 */
let satisfiesHashableConstraint = (
  ctx: CheckerContext,
  arg: Type,
  constraint: Type
): boolean => {
  if (!(constraint is InterfaceType)) {
    return false;
  }
  let iface = constraint as InterfaceType;
  if (iface.name != "Hashable" || iface.sourcePath != "zena:hashable") {
    return false;
  }

  // Unwrap type aliases (including distinct types and enums).
  var t = arg;
  while (t is TypeAliasType) {
    t = (t as TypeAliasType).target;
  }

  // A distinct type over a nominally-Hashable type (e.g. distinct T = String)
  // is hashable via its underlying type.
  if (t !== arg && isAssignableTo(ctx, t, constraint)) {
    return true;
  }

  match (t) {
    case I32Type: { return true; }
    case U32Type: { return true; }
    case I64Type: { return true; }
    case U64Type: { return true; }
    case F32Type: { return true; }
    case F64Type: { return true; }
    case U8Type: { return true; }
    case U16Type: { return true; }
    case I8Type: { return true; }
    case I16Type: { return true; }
    case BooleanType: { return true; }
    // Enum member types: i32-backed enums unwrap to number literals, string
    // enums to string literals. Both hash by value via the intrinsics.
    case BoolLiteralType: { return true; }
    case NumLiteralType: { return true; }
    case StringLiteralType: { return true; }
    case UnionT as ut: {
      for (let member in ut.types) {
        if (!satisfiesHashableConstraint(ctx, member, constraint)) {
          return false;
        }
      }
      return true;
    }
    case ClassType as ct: { return ct.isCaseClass; }
    case _: { return false; }
  }
};

/**
 * Infer type arguments from constructor arguments for a generic class.
 * Returns a new ClassType with typeArguments set, or the original if not generic.
 */
let instantiateGenericClass = (
  ctx: CheckerContext,
  ct: ClassType,
  explicitTypeArgs: Array<TypeAnnotation> | null,
  args: Array<Expression>,
  loc: SourceLocation | null
): ClassType => {
  let typeParams = ct.typeParameters;
  if (typeParams == null) { return ct; }
  let params = typeParams as Array<TypeParameterType>;
  if (params.length == 0) { return ct; }

  // If explicit type arguments provided, use those.
  if (explicitTypeArgs != null) {
    let explicit = explicitTypeArgs as Array<TypeAnnotation>;
    let typeArgs = new Array<Type>();
    var i = 0;
    while (i < explicit.length) {
      typeArgs.push(resolveTypeAnnotation(ctx, explicit[i]));
      i += 1;
    }
    applyAndCheckTypeArguments(ctx, params, typeArgs, loc);
    return instantiateClassType(ct, typeArgs);
  }

  // Infer type arguments from constructor arguments.
  let ctorOpt = ct.constructorType;
  if (ctorOpt == null) { return ct; }
  let ctor = ctorOpt as FunctionType;

  // Build a map from type param names to inferred types.
  let inferred = new HashMap<String, Type>();
  var ai = 0;
  while (ai < args.length && ai < ctor.parameters.length) {
    let paramType = ctor.parameters[ai];
    let argType = checkExpression(ctx, args[ai], null);
    inferTypeArg(paramType, argType, inferred);
    ai += 1;
  }

  // Build typeArguments array from inferred map.
  let typeArgs = new Array<Type>();
  for (let param in params) {
    let paramName = param.name;
    if (let (true, t) = inferred.get(paramName)) {
      typeArgs.push(t);
    } else {
      // No inference possible; use unknown.
      typeArgs.push(new ErrorType());
    }
  }

  // Apply missing default types and check constraints before instantiating.
  applyAndCheckTypeArguments(ctx, params, typeArgs, loc);
  
  // Create instantiated class type using factory function.
  return instantiateClassType(ct, typeArgs);
};

/**
 * Infer a type argument by matching a parameter type against an argument type.
 * paramType: the expected param type (may be TypeParameterType)
 * argType: the actual argument type
 * inferred: map to store inferred type params
 */
let inferTypeArg = (paramType: Type, argType: Type, inferred: HashMap<String, Type>): void => {
  match (paramType) {
    case TypeParameterType {name}: {
      // Direct type parameter — infer from arg type.
      if (!inferred.has(name)) {
        inferred[name] = argType;
      }
    }
    case ArrayType {elementType}: {
      // Array<T> against Array<i32> → infer T = i32.
      match (argType) {
        case ArrayType as argArr: {
          inferTypeArg(elementType, argArr.elementType, inferred);
        }
        case _: {}
      }
    }
    case ClassType as pt: {
      // Box<T> against Box<i32> → infer T = i32.
      match (argType) {
        case ClassType as at: {
          if (pt.id == at.id && pt.typeArguments != null && at.typeArguments != null) {
            let ptArgs = pt.typeArguments as Array<Type>;
            let atArgs = at.typeArguments as Array<Type>;
            var i = 0;
            while (i < ptArgs.length && i < atArgs.length) {
              inferTypeArg(ptArgs[i], atArgs[i], inferred);
              i += 1;
            }
          }
        }
        case _: {}
      }
    }
    case FunctionType as pt: {
      // (T) => U against (i32) => String → infer T = i32, U = String.
      match (argType) {
        case FunctionType as at: {
          var i = 0;
          while (i < pt.parameters.length && i < at.parameters.length) {
            inferTypeArg(pt.parameters[i], at.parameters[i], inferred);
            i += 1;
          }
          inferTypeArg(pt.returnType, at.returnType, inferred);
        }
        case _: {}
      }
    }
    case _: {}
  }
};

/**
 * Check if `source` is assignable to `target`.
 */
/**
 * Check if a ClassType is a specific prelude type by identity (type id comparison).
 * Works for both uninstantiated and instantiated generic types because
 * instantiateClassType preserves the source type's id.
 */
let isPreludeClassType = (ctx: CheckerContext, ct: ClassType, preludeName: String): boolean => {
  let prelude = ctx.resolvePreludeType(preludeName);
  if (prelude == null) { return false; }
  match (prelude as Type) {
    case ClassType as pt: { return ct.id == pt.id; }
    case _: { return false; }
  }
};

/**
 * Widen a literal type to its base type.
 * Used for `var` bindings: `var x = true` → x: boolean (not x: true).
 */
let widenType = (ctx: CheckerContext, t: Type): Type => match (t) {
  case BoolLiteralType {}: new BooleanType()
  case StringLiteralType {}: {
    let stringType = ctx.resolvePreludeType("String");
    if (stringType != null) {
      stringType as Type
    } else {
      t
    }
  }
  case NumLiteralType {raw}: {
    var isFloat = false;
    var i = 0;
    while (i < raw.length) {
      if (raw.getByteAt(i) == 46) { // '.'
        isFloat = true;
        break;
      }
      i += 1;
    }
    if (isFloat) {
      let expected = new F64Type();
      expected as Type
    } else {
      let expected = new I32Type();
      expected as Type
    }
  }
  case _: t
};

let isValuePrimitive = (type: Type): boolean => {
  return match (type) {
    case I32Type: true
    case U32Type: true
    case I64Type: true
    case U64Type: true
    case F32Type: true
    case F64Type: true
    case U8Type: true
    case U16Type: true
    case I8Type: true
    case I16Type: true
    case BooleanType: true
    case BoolLiteralType: true
    case NumLiteralType: true
    case _: false
  };
};

let isReferenceType = (type: Type): boolean => {
  return match (type) {
    case ClassType as ct: {
      if (ct.isExtension && ct.onType != null) {
        !isValuePrimitive(ct.onType as Type)
      } else {
        true
      }
    }
    case InterfaceType: true
    case ArrayType: true
    case RecordT: true
    case TupleT: true
    case InlineTupleT: true
    case FunctionType: true
    case NullType: true
    case AnyRefType: true
    case EqRefType: true
    case StringLiteralType: true
    case _: false
  };
};

let isNullableType = (t: Type): boolean => match (t) {
  case NullType: true
  case UnionT as u: {
    var hasNull = false;
    for (let member in u.types) {
      if (member is NullType) {
        hasNull = true;
      }
    }
    hasNull
  }
  case _: false
};

let isValidCast = (sourceType: Type, targetType: Type): boolean => {
  // Primitive → Primitive: VALID only if both are numeric or both are boolean
  if (isValuePrimitive(sourceType) && isValuePrimitive(targetType)) {
    let isSrcNum: boolean = match (sourceType) {
      case I32Type | U32Type | I64Type | U64Type | F32Type | F64Type |
          U8Type | U16Type | I8Type | I16Type | NumLiteralType: true
      case _: false
    };
    let isTgtNum: boolean = match (targetType) {
      case I32Type | U32Type | I64Type | U64Type | F32Type | F64Type |
          U8Type | U16Type | I8Type | I16Type | NumLiteralType: true
      case _: false
    };
    let isSrcBool: boolean = match (sourceType) {
      case BooleanType | BoolLiteralType: true
      case _: false
    };
    let isTgtBool: boolean = match (targetType) {
      case BooleanType | BoolLiteralType: true
      case _: false
    };
    if ((isSrcNum && isTgtNum) || (isSrcBool && isTgtBool)) {
      return true;
    }
    return false;
  }

  // Primitive → Extension on same primitive: VALID (distinct type wrapping)
  if (isValuePrimitive(sourceType) && targetType is ClassType) {
    let ct = targetType as ClassType;
    if (ct.isExtension && ct.onType != null) {
      let onType = ct.onType as Type;
      let isSrcNum: boolean = match (sourceType) {
        case I32Type | U32Type | I64Type | U64Type | F32Type | F64Type |
          U8Type | U16Type | I8Type | I16Type | NumLiteralType: true
        case _: false
      };
      let isOnNum: boolean = match (onType) {
        case I32Type | U32Type | I64Type | U64Type | F32Type | F64Type |
          U8Type | U16Type | I8Type | I16Type | NumLiteralType: true
        case _: false
      };
      if (isSrcNum && isOnNum) {
        return true;
      }
      let isSrcBool: boolean = match (sourceType) {
        case BooleanType | BoolLiteralType: true
        case _: false
      };
      let isOnBool: boolean = match (onType) {
        case BooleanType | BoolLiteralType: true
        case _: false
      };
      if (isSrcBool && isOnBool) {
        return true;
      }
    }
  }

  // Primitive → Reference (not an extension on primitive): INVALID
  if (isValuePrimitive(sourceType) && isReferenceType(targetType)) {
    return false;
  }

  // Null → Non-nullable: INVALID
  if (sourceType is NullType && !isNullableType(targetType)) {
    return false;
  }

  // All other casts are allowed (checked at runtime)
  return true;
};

/**
 * Find an opaque alias reachable from `t` that was declared somewhere other
 * than `currentFile`, or null if there is none.
 *
 * The search is not limited to the head of the type: `Array<i32> as
 * Array<Token>` forges just as effectively as `0 as Token`, because distinct
 * types are erased and the two have identical runtime representations. So
 * every position that a cast could reinterpret is visited — element types,
 * union members, record fields, function parameters and returns, and type
 * arguments.
 *
 * An alias's `target` is followed too. `distinct type Tokens = Array<Token>`
 * is not itself opaque, but casting to it would mint `Token`s all the same.
 *
 * `depth` bounds the walk instead of a visited set: recursive aliases and
 * self-referential generic instantiations would otherwise not terminate, and
 * a cast target deep enough to exhaust the budget is not something anyone
 * writes deliberately. Running out of budget reports "no opaque type found",
 * which errs toward accepting the cast rather than rejecting valid code.
 */
let findForeignOpaque = (t: Type, currentFile: String, depth: i32): TypeAliasType | null => {
  if (depth <= 0) { return null; }
  let next = depth - 1;
  return match (t) {
    case TypeAliasType as alias: {
      if (alias.isOpaque && alias.declaringModule != currentFile) {
        return alias;
      }
      let inArgs = findForeignOpaqueInList(alias.typeArguments, currentFile, next);
      if (inArgs != null) { return inArgs; }
      // `resolving` means the checker is mid-way through computing this
      // alias's target; reading it now would recurse forever.
      if (alias.resolving) { return null; }
      findForeignOpaque(alias.target, currentFile, next)
    }
    case ArrayType {elementType}: findForeignOpaque(elementType, currentFile, next)
    case TupleT {elementTypes}: findForeignOpaqueInList(elementTypes, currentFile, next)
    case InlineTupleT {elementTypes}: findForeignOpaqueInList(elementTypes, currentFile, next)
    case UnionT {types}: findForeignOpaqueInList(types, currentFile, next)
    case RecordT as rec: {
      for (let key in rec.properties.keys()) {
        if (let (true, propType) = rec.properties.get(key)) {
          let found = findForeignOpaque(propType, currentFile, next);
          if (found != null) { return found; }
        }
      }
      null
    }
    case FunctionType as fn: {
      let inParams = findForeignOpaqueInList(fn.parameters, currentFile, next);
      if (inParams != null) { return inParams; }
      findForeignOpaque(fn.returnType, currentFile, next)
    }
    case ClassType as ct: findForeignOpaqueInList(ct.typeArguments, currentFile, next)
    case InterfaceType as it: findForeignOpaqueInList(it.typeArguments, currentFile, next)
    case MixinType as mt: findForeignOpaqueInList(mt.typeArguments, currentFile, next)
    case _: null
  };
};

/** The first foreign opaque type in `types`, or null. A null list scans as empty. */
let findForeignOpaqueInList = (
  types: Array<Type> | null,
  currentFile: String,
  depth: i32
): TypeAliasType | null => {
  if (types == null) { return null; }
  for (let t in types as Array<Type>) {
    let found = findForeignOpaque(t, currentFile, depth);
    if (found != null) { return found; }
  }
  return null;
};

/**
 * Reject `expr as T` when T mentions an opaque type declared in another file
 * and the cast would actually mint a value of it.
 *
 * The point of `opaque` is that outside its defining file the only way to get
 * one is from code that file hands you. A cast whose source and target already
 * overlap cannot manufacture anything: `p as Password` where `p: Password` is
 * redundant, and `p as Password` where `p: Password | null` is narrowing. Both
 * stay legal, which matters because narrowing a nullable opaque value is
 * ordinary code at every call site. Only a cast that reinterprets an unrelated
 * representation — `42 as Password` — is a forge, and that is exactly the case
 * where neither type is assignable to the other.
 *
 * Casting *out* of an opaque type (`pw as String`) is deliberately allowed:
 * the restriction is on forging values, not on reading them.
 */
let checkOpaqueCast = (
  ctx: CheckerContext,
  sourceType: Type,
  targetType: Type,
  loc: SourceLocation | null
): void => {
  let alias = findForeignOpaque(targetType, ctx.filePath, 16);
  if (alias == null) { return; }
  let opaque = alias as TypeAliasType;
  if (isAssignableTo(ctx, sourceType, targetType)
      || isAssignableTo(ctx, targetType, sourceType)) {
    return;
  }
  ctx.error(
    "Cannot cast to opaque type '" + opaque.name + "'. Values of an opaque "
      + "type can only be created in the file that declares it ('"
      + opaque.declaringModule + "'); use a function exported from that file.",
    DiagnosticCode.OpaqueTypeCast,
    loc
  );
};

let checkAndRegisterInterfaceAdaptation = (ctx: CheckerContext, node: Node, sourceType: Type, targetType: Type): void => {
  var effectiveTarget = targetType;
  match (targetType) {
    case UnionT {types}: {
      for (let member in types) {
        if (isAssignableTo(ctx, sourceType, member)) {
          effectiveTarget = member;
          break;
        }
      }
    }
    case _: {}
  }

  if (sourceType is ClassType && effectiveTarget is InterfaceType) {
    ctx.model.setInterfaceAdaptation(node, sourceType as ClassType, effectiveTarget as InterfaceType);
    let deps = ctx.currentDependencies();
    if (deps != null) {
      let ct = sourceType as ClassType;
      let it = effectiveTarget as InterfaceType;
      let classSymId = (ct.genericSource ?? ct).symbolId;
      let ifaceSymId = (it.genericSource ?? it).symbolId;
      let key = i32ToString(classSymId as i32) + "::" + i32ToString(ifaceSymId as i32);
      deps.usedInterfaceAdaptations.add(key);
    }
  } else if (sourceType is FunctionType && effectiveTarget is FunctionType) {
    let src = sourceType as FunctionType;
    let tgt = effectiveTarget as FunctionType;
    if (!typesEqual(src, tgt)) {
      ctx.model.setFunctionAdaptation(node, src, tgt);
      let deps = ctx.currentDependencies();
      if (deps != null) {
        deps.functionAdaptations.push(new FunctionAdaptationDependency(node, src, tgt));
      }
    }
  }

  let nonNullSrc = subtractNullFromType(sourceType);
  let nonNullTgt = subtractNullFromType(effectiveTarget);
  if (nonNullSrc is RecordT && nonNullTgt is RecordT) {
    let itR = nonNullSrc as RecordT;
    let expR = nonNullTgt as RecordT;
    var needsAdaptation = itR.properties.size != expR.properties.size;
    if (!needsAdaptation) {
      let keys = itR.properties.keys();
      while (let (true, key) = keys.next()) {
        if (expR.properties.has(key)) {
          let t1 = itR.properties[key];
          let t2 = expR.properties[key];
          if (!isAssignableTo(ctx, t1, t2) || !isAssignableTo(ctx, t2, t1)) {
            needsAdaptation = true;
          }
        } else {
          needsAdaptation = true;
        }
      }
    }
    if (needsAdaptation) {
      ctx.model.setRecordAdaptation(node, itR, expR);
    }
  }
};

let inferTypeParameter = (sourceType: Type, targetType: Type, tpName: String, inferred: HashMap<String, Type>): boolean => {
  if (sourceType is TypeParameterType && (sourceType as TypeParameterType).name == tpName) {
    inferred[tpName] = targetType;
    return true;
  }
  if (sourceType is ArrayType) {
    let at = sourceType as ArrayType;
    if (targetType is ArrayType) {
      let att = targetType as ArrayType;
      return inferTypeParameter(at.elementType, att.elementType, tpName, inferred);
    }
  }
  if (sourceType is ClassType) {
    let ct = sourceType as ClassType;
    if (targetType is ClassType) {
      let ctt = targetType as ClassType;
      if (ct.typeArguments != null && ctt.typeArguments != null) {
        let sArgs = ct.typeArguments as Array<Type>;
        let tArgs = ctt.typeArguments as Array<Type>;
        if (sArgs.length == tArgs.length) {
          var i = 0;
          while (i < sArgs.length) {
            if (inferTypeParameter(sArgs[i], tArgs[i], tpName, inferred)) {
              return true;
            }
            i += 1;
          }
        }
      }
    }
  }
  return false;
};

let tryInstantiateGenericFunction = (
  ctx: CheckerContext,
  source: Type,
  target: Type,
): Type => {
  if (source is FunctionType && target is FunctionType) {
    let srcFunc = source as FunctionType;
    let tgtFunc = target as FunctionType;
    if (srcFunc.typeParameters != null && (srcFunc.typeParameters as Array<TypeParameterType>).length > 0) {
      let tps = srcFunc.typeParameters as Array<TypeParameterType>;
      let inferred = new HashMap<String, Type>();
      for (let tp in tps) {
        var found = false;
        var pIdx = 0;
        while (pIdx < srcFunc.parameters.length && !found) {
          if (pIdx < tgtFunc.parameters.length) {
            if (inferTypeParameter(srcFunc.parameters[pIdx], tgtFunc.parameters[pIdx], tp.name, inferred)) {
              found = true;
            }
          }
          pIdx += 1;
        }
        if (!found) {
          inferTypeParameter(srcFunc.returnType, tgtFunc.returnType, tp.name, inferred);
        }
      }
      if (inferred.size == tps.length) {
        let typeArgs = new Array<Type>();
        for (let tp in tps) {
          typeArgs.push(inferred[tp.name]);
        }
        return instantiateFunctionType(srcFunc, typeArgs);
      }
    }
  }
  return source;
};

let isBoxablePrimitive = (t: Type): boolean => match (baseType(t)) {
  case I32Type: true
  case U32Type: true
  case I64Type: true
  case U64Type: true
  case F32Type: true
  case F64Type: true
  case U8Type: true
  case U16Type: true
  case I8Type: true
  case I16Type: true
  case BooleanType: true
  case _: false
};

/**
 * Types with a heap (reference) runtime representation — the sources
 * `anyref` accepts. Inline tuples are excluded: they are flattened
 * multi-value aggregates, not single references.
 */
let isAnyRefSource = (t: Type): boolean => {
  if (t is ClassType || t is InterfaceType || t is ArrayType ||
      t is RecordT || t is TupleT || t is FunctionType ||
      t is NullType || t is AnyRefType ||
      t is StringLiteralType) {
    return true;
  }
  if (t is TypeAliasType) {
    return isAnyRefSource((t as TypeAliasType).target);
  }
  if (t is UnionT) {
    for (let member in (t as UnionT).types) {
      if (!isAnyRefSource(member)) {
        return false;
      }
    }
    return true;
  }
  return false;
};

let isAssignableTo = (ctx: CheckerContext, source: Type, target: Type): boolean => {
  // Automatically unwrap non-distinct type aliases
  match (source) {
    case TypeAliasType as ta: { if (!ta.isDistinct) { return isAssignableTo(ctx, ta.target, target); } }
    case _: {}
  }
  match (target) {
    case TypeAliasType as tb: { if (!tb.isDistinct) { return isAssignableTo(ctx, source, tb.target); } }
    case _: {}
  }
  // Same type (identity check via match).
  if (typesEqual(source, target)) { return true; }

  // Borrowing at a call site is implicit: an `Own<R>` is accepted where a
  // `Borrow<R>` is expected, and borrowing does not consume. The reverse is
  // not true — a borrow is not an owner — and `Unmanaged<R>` is reached only
  // through an explicit `disown`. See docs/design/ownership.md §Borrowing.
  if (isOwnershipWrapper(source) && isOwnershipWrapper(target)) {
    if (ownershipHandleName(source) == "Own" && ownershipHandleName(target) == "Borrow") {
      let si = ownershipHandleInner(source);
      let ti = ownershipHandleInner(target);
      if (si != null && ti != null && typesEqual(si as Type, ti as Type)) {
        return true;
      }
    }
  }

  // `never` is assignable to anything.
  if (source is NeverType) { return true; }
  if (source is ErrorType || target is ErrorType) { return true; }

  if (source is UnknownType || target is UnknownType) {
    ctx.error(
      "Internal compiler error: Unknown type encountered during validation.",
      DiagnosticCode.UnknownError,
      null
    );
    return true;
  }

  // Handle distinct types explicitly
  match (source) {
    case TypeAliasType as srcAlias: {
      if (srcAlias.isDistinct) {
        match (target) {
          case UnionT {types}: {
            for (let t in types) {
              if (isAssignableTo(ctx, source, t)) { return true; }
            }
            return false;
          }
          case TypeAliasType as tgtAlias: {
            if (tgtAlias.isDistinct) {
              return srcAlias.name == tgtAlias.name && isAssignableTo(ctx, srcAlias.target, tgtAlias.target);
            }
          }
          case _: {}
        }
        return false;
      }
    }
    case _: {}
  }

  match (target) {
    case TypeAliasType as tgtAlias: {
      if (tgtAlias.isDistinct) {
        return false;
      }
    }
    case _: {}
  }

  // Automatically unwrap non-distinct type aliases
  match (source) {
    case TypeAliasType as ta: { return isAssignableTo(ctx, ta.target, target); }
    case _: {}
  }
  match (target) {
    case TypeAliasType as tb: { return isAssignableTo(ctx, source, tb.target); }
    case _: {}
  }

  // `anyref` is the top type for references: anything with a heap
  // representation is assignable; primitives are not.
  if (target is AnyRefType) { return isAnyRefSource(source); }

  // `null` is assignable to nullable unions.
  if (source is NullType) {
    match (target) {
      case UnionT {types}: {
        for (let type in types) {
          if (type is NullType) {
            return true;
          }
        }
      }
      case _: {}
    }
    return false;
  }

  // Literal assignable to base.
  if (source is BoolLiteralType && target is BooleanType) { return true; }
  if (source is StringLiteralType &&
      target is ClassType &&
      isPreludeClassType(ctx, target as ClassType, "String")) {
    return true;
  }
  if (source is NumLiteralType && isNumericType(target)) {
    let base = baseType(source);
    if (base is F64Type && !isFloatType(target)) {
      // floats not assignable to int
    } else {
      return true;
    }
  }

  // Union source: all members must be assignable to target.
  match (source) {
    case UnionT {types as sourceTypes}: {
      for (let st in sourceTypes) {
        if (!isAssignableTo(ctx, st, target)) { return false; }
      }
      return true;
    }
    case _: {}
  }

  // Union target: source must be assignable to at least one member.
  match (target) {
    case UnionT {types as targetTypes}: {
      for (let tt in targetTypes) {
        if (isAssignableTo(ctx, source, tt)) { return true; }
      }
      return false;
    }
    case _: {}
  }

  // Numeric: allow implicit widening in some cases.
  // For now, require exact numeric type match (strict).
  // This matches Zena's no-coercion design.

  match (source) {
    case FunctionType as srcFunc: {
      match (target) {
        case FunctionType as tgtFunc: {
          let finalSrcFunc = tryInstantiateGenericFunction(ctx, srcFunc, tgtFunc) as FunctionType;

          // Allow argument adaptation: source can have fewer parameters.
          if (finalSrcFunc.parameters.length > tgtFunc.parameters.length) { return false; }
          // Covariant return type
          if (!isAssignableTo(ctx, finalSrcFunc.returnType, tgtFunc.returnType)) { return false; }
          for (var i = 0; i < finalSrcFunc.parameters.length; i += 1) {
            // Contravariant parameter types
            if (!isAssignableTo(ctx, tgtFunc.parameters[i], finalSrcFunc.parameters[i])) { return false; }
          }
          return true;
        }
        case _: {}
      }
    }
    case _: {}
  }

  // Class subtyping: a subclass is assignable to its superclass chain.
  match (source) {
    case ClassType as srcClass: {
      match (target) {
        case ClassType as tgtClass: {
          // If they match by id but didn't pass typesEqual early, they have different
          // type arguments. For invariant nominal types, they are not assignable.
          if (srcClass.id == tgtClass.id) { return false; }
          // Walk the supertype chain.
          var current: ClassType | null = srcClass.superType;
          while (current != null) {
            let cur = current as ClassType;
            if (typesEqual(cur, tgtClass)) { return true; }
            if (cur.id == tgtClass.id) { return false; }
            current = cur.superType;
          }
        }
        case InterfaceType as tgtIface: {
          var implList = srcClass.implementsList;
          if (implList.length == 0 && srcClass.genericSource != null) {
            let srcGen = srcClass.genericSource as ClassType;
            if (srcGen.implementsList.length > 0 && srcClass.typeArguments != null) {
              implList = srcGen.implementsList;
            }
          }
          for (let impl in implList) {
            var substitutedImpl = impl as Type;
            let typeParamsList = (srcClass.genericSource ?? srcClass).typeParameters;
            if (typeParamsList != null && srcClass.typeArguments != null) {
              substitutedImpl = substituteTypeParams(typeParamsList, srcClass.typeArguments, substitutedImpl);
            }
            if (typesEqual(substitutedImpl, tgtIface) || isAssignableTo(ctx, substitutedImpl, target)) { return true; }
          }
          var current: ClassType | null = srcClass.superType;
          while (current != null) {
            let cur = current as ClassType;
            var curImplList = cur.implementsList;
            if (curImplList.length == 0 && cur.genericSource != null) {
              let curGen = cur.genericSource as ClassType;
              if (curGen.implementsList.length > 0 && cur.typeArguments != null) {
                curImplList = curGen.implementsList;
              }
            }
            for (let impl in curImplList) {
              var substitutedImpl = impl as Type;
              let typeParamsList = (cur.genericSource ?? cur).typeParameters;
              if (typeParamsList != null && cur.typeArguments != null) {
                substitutedImpl = substituteTypeParams(typeParamsList, cur.typeArguments, substitutedImpl);
              }
              if (typesEqual(substitutedImpl, tgtIface) || isAssignableTo(ctx, substitutedImpl, target)) { return true; }
            }
            current = cur.superType;
          }
        }
        case _: {}
      }
    }
    case InterfaceType as srcIface: {
      match (target) {
        case InterfaceType as tgtIface: {
          for (let p in srcIface.extendsList) {
            var substitutedP = p as Type;
            let typeParamsList = (srcIface.genericSource ?? srcIface).typeParameters;
            if (typeParamsList != null && srcIface.typeArguments != null) {
              substitutedP = substituteTypeParams(typeParamsList, srcIface.typeArguments, substitutedP);
            }
            if (typesEqual(substitutedP, tgtIface) || isAssignableTo(ctx, substitutedP, target)) { return true; }
          }
        }
        case _: {}
      }
    }
    case _: {}
  }

  // Record structural assignability: all target properties must exist in source
  // with assignable types.
  match (source) {
    case RecordT {properties as srcProps}: {
      match (target) {
        case RecordT {properties as tgtProps}: {
          for (let key in tgtProps.keys()) {
            if (let (true, srcType) = srcProps.get(key)) {
              if (let (true, tgtType) = tgtProps.get(key)) {
                if (!isAssignableTo(ctx, srcType, tgtType)) {
                  return false;
                }
              }
            } else {
              return false;
            }
          }
          return true;
        }
        case _: {}
      }
    }
    case _: {}
  }

  // ArrayType(elementType) is assignable to Array<T>/FixedArray<T> when elementType assignable to T.
  match (source) {
    case ArrayType {elementType}: {
      match (target) {
        case ClassType as tgtClass: {
          let isArrayLike = isPreludeClassType(ctx, tgtClass, "Array") || isPreludeClassType(ctx, tgtClass, "FixedArray");
          if (isArrayLike && tgtClass.typeArguments != null) {
            let tgtArgs = tgtClass.typeArguments as Array<Type>;
            if (tgtArgs.length > 0) {
              return isAssignableTo(ctx, elementType, tgtArgs[0]);
            }
          }
          // Also match uninstantiated Array/FixedArray (bare type)
          if (isArrayLike) {
            return true;
          }
        }
        case ArrayType {elementType as tgtElem}: {
          return isAssignableTo(ctx, elementType, tgtElem);
        }
        case _: {}
      }
    }
    case TupleT {elementTypes as srcElems}: {
      match (target) {
        case TupleT {elementTypes as tgtElems}: {
          if (srcElems.length != tgtElems.length) { return false; }
          for (var i = 0; i < srcElems.length; i += 1) {
            if (!isAssignableTo(ctx, srcElems[i], tgtElems[i])) { return false; }
          }
          return true;
        }
        case _: {}
      }
    }
    case InlineTupleT {elementTypes as srcElems}: {
      match (target) {
        case InlineTupleT {elementTypes as tgtElems}: {
          if (srcElems.length != tgtElems.length) { return false; }
          for (var i = 0; i < srcElems.length; i += 1) {
            if (!isAssignableTo(ctx, srcElems[i], tgtElems[i])) { return false; }
          }
          return true;
        }
        case _: {}
      }
    }
    case _: {}
  }

  return false;
};

/**
 * Check if two type arrays (tuple elements) are structurally equal.

 */
let tupleElementsEqual = (ea: Array<Type>, eb: Array<Type>): boolean => {
  if (ea.length != eb.length) {
    return false;
  }
  for (var i = 0; i < ea.length; i += 1) {
    if (!typesEqual(ea[i], eb[i])) {
      return false;
    }
  }
  return true;
};

/**
 * Check if two types are structurally equal.
 */
let typesEqual = (a: Type, b: Type): boolean => {
  // For now, use a simple structural comparison based on type kind.
  // Identity-based comparison will come with interning.
  return match (a) {
    case I32Type: b is I32Type
    case U32Type: b is U32Type
    case I64Type: b is I64Type
    case U64Type: b is U64Type
    case F32Type: b is F32Type
    case F64Type: b is F64Type
    case U8Type: b is U8Type
    case U16Type: b is U16Type
    case I8Type: b is I8Type
    case I16Type: b is I16Type
    case BooleanType: b is BooleanType
    case VoidType: b is VoidType
    case NullType: b is NullType
    case NeverType: true
    case HoleType: b is HoleType
    case ErrorType: b is ErrorType
    case UnknownType: b is UnknownType
    case AnyRefType: b is AnyRefType
    case EqRefType: b is EqRefType
    case BoolLiteralType {value as va}: {
      match (b) {
        case BoolLiteralType {value as vb}: va == vb
        case _: false
      }
    }
    case StringLiteralType {value as va}: {
      match (b) {
        case StringLiteralType {value as vb}: va == vb
        case _: false
      }
    }
    case NumLiteralType {raw as va}: {
      match (b) {
        case NumLiteralType {raw as vb}: va == vb
        case _: false
      }
    }
    case ClassType as ca: {
      match (b) {
        case ClassType as cb: {
          // Compare canonical base type (follow genericSource chain)
          let baseA = if (ca.genericSource != null) (ca.genericSource as ClassType).id else ca.id;
          let baseB = if (cb.genericSource != null) (cb.genericSource as ClassType).id else cb.id;
          if (baseA != baseB) { return false; }
          // Compare type arguments for generic instantiations
          if (ca.typeArguments == null && cb.typeArguments == null) { return true; }
          if (ca.typeArguments == null || cb.typeArguments == null) { return false; }
          let argsA = ca.typeArguments as Array<Type>;
          let argsB = cb.typeArguments as Array<Type>;
          if (argsA.length != argsB.length) { return false; }
          for (var i = 0; i < argsA.length; i += 1) {
            if (!typesEqual(argsA[i], argsB[i])) { return false; }
          }
          true
        }
        case _: false
      }
    }
    case InterfaceType as ia: {
      match (b) {
        case InterfaceType as ib: {
          // Compare canonical base type (follow genericSource chain)
          let baseA = if (ia.genericSource != null) (ia.genericSource as InterfaceType).id else ia.id;
          let baseB = if (ib.genericSource != null) (ib.genericSource as InterfaceType).id else ib.id;
          if (baseA != baseB) { return false; }
          // Compare type arguments for generic instantiations
          if (ia.typeArguments == null && ib.typeArguments == null) { return true; }
          if (ia.typeArguments == null || ib.typeArguments == null) { return false; }
          let argsA = ia.typeArguments as Array<Type>;
          let argsB = ib.typeArguments as Array<Type>;
          if (argsA.length != argsB.length) { return false; }
          for (var i = 0; i < argsA.length; i += 1) {
            if (!typesEqual(argsA[i], argsB[i])) { return false; }
          }
          true
        }
        case _: false
      }
    }
    case TypeParameterType {name as na}: {
      match (b) {
        case TypeParameterType {name as nb}: na == nb
        case _: false
      }
    }
    case ArrayType {elementType as ea}: {
      match (b) {
        case ArrayType {elementType as eb}: typesEqual(ea, eb)
        case _: false
      }
    }
    case TupleT {elementTypes as ea}: {
      match (b) {
        case TupleT {elementTypes as eb}: tupleElementsEqual(ea, eb)
        case _: false
      }
    }
    case InlineTupleT {elementTypes as ea}: {
      match (b) {
        case InlineTupleT {elementTypes as eb}: tupleElementsEqual(ea, eb)
        case _: false
      }
    }
    case FunctionType as fa: {
      match (b) {
        case FunctionType as fb: {
          if (fa.parameters.length != fb.parameters.length) { return false; }
          if (!typesEqual(fa.returnType, fb.returnType)) { return false; }
          for (var i = 0; i < fa.parameters.length; i += 1) {
            if (!typesEqual(fa.parameters[i], fb.parameters[i])) { return false; }
          }
          true
        }
        case _: false
      }
    }
    case UnionT {types as ua}: {
      match (b) {
        case UnionT {types as ub}: {
          if (ua.length != ub.length) { return false; }
          for (var i = 0; i < ua.length; i += 1) {
            if (!typesEqual(ua[i], ub[i])) { return false; }
          }
          true
        }
        case _: false
      }
    }
    case RecordT {properties as pa}: {
      match (b) {
        case RecordT {properties as pb}: {
          if (pa.size != pb.size) { return false; }
          let keys = pa.keys();
          while (let (true, key) = keys.next()) {
            if (!pb.has(key)) { return false; }
            if (!typesEqual(pa[key], pb[key])) { return false; }
          }
          true
        }
        case _: false
      }
    }
    case MixinType as ma: {
      match (b) {
        case MixinType as mb: ma.name == mb.name
        case _: false
      }
    }
    case SymbolType as sa: {
      match (b) {
        case SymbolType as sb: sa.id == sb.id
        case _: false
      }
    }
    case ThisType: b is ThisType
    case TypeAliasType as ta: {
      match (b) {
        case TypeAliasType as tb: {
          if (ta.name != tb.name) {
            return false;
          }
          if (ta.typeArguments == null && tb.typeArguments == null) {
            return true;
          }
          if (ta.typeArguments == null || tb.typeArguments == null) {
            return false;
          }
          let argsA = ta.typeArguments as Array<Type>;
          let argsB = tb.typeArguments as Array<Type>;
          if (argsA.length != argsB.length) {
            return false;
          }
          for (var i = 0; i < argsA.length; i += 1) {
            if (!typesEqual(argsA[i], argsB[i])) {
              return false;
            }
          }
          true
        }
        case _: false
      }
    }
  };
};

// ============================================================================
// Control-Flow Narrowing Helpers
// ============================================================================

/**
 * Check if a statement definitely exits (return, break, continue, throw).
 * Used to propagate narrowing past null-guard patterns like:
 *   if (x == null) { return; }
 *   // x is now non-null here
 */
let exprDefinitelyExits = (expr: Expression): boolean => {
  return match (expr) {
    case ThrowExpression {}: true
    case MatchExpression {cases}: {
      if (cases.length == 0) { return false; }
      var allExit = true;
      for (let c in cases) {
        let caseExits = if (c.body is Statement) {
          branchDefinitelyExits(c.body as Statement)
        } else {
          exprDefinitelyExits(c.body as Expression)
        };
        if (!caseExits) { allExit = false; }
      }
      allExit
    }
    case IfExpression {consequent, alternate}: {
      let consExits = if (consequent is Statement) {
        branchDefinitelyExits(consequent as Statement)
      } else {
        exprDefinitelyExits(consequent as Expression)
      };
      let altExits = if (alternate == null) {
        false
      } else if (alternate is Statement) {
        branchDefinitelyExits(alternate as Statement)
      } else {
        exprDefinitelyExits(alternate as Expression)
      };
      consExits && altExits
    }
    case _: false
  };
};

let branchDefinitelyExits = (stmt: Statement): boolean => {
  return match (stmt) {
    case ReturnStatement {}: true
    case BreakStatement {}: true
    case ContinueStatement {}: true
    case ExpressionStatement {expression}: exprDefinitelyExits(expression)
    case BlockStatement {body}: {
      if (body.length == 0) { false }
      else { branchDefinitelyExits(body[body.length - 1]) }
    }
    case IfStatement {consequent, alternate}: {
      if (alternate == null) { false }
      else { branchDefinitelyExits(consequent) && branchDefinitelyExits(alternate as Statement) }
    }
    case _: false
  };
};

/**
 * Remove null from a type. For unions, filters out NullType members.
 * Returns the narrowed type.
 */
let subtractNullFromType = (t: Type): Type => {
  match (t) {
    case UnionT as u: {
      let remaining = new Array<Type>();
      let types = u.types;
      var i = 0;
      while (i < types.length) {
        match (types[i]) {
          case NullType: {}
          case _: { remaining.push(types[i]); }
        }
        i = i + 1;
      }
      if (remaining.length == 0) { return new NeverType(); }
      if (remaining.length == 1) { return remaining[0]; }
      return new UnionT(remaining);
    }
    case NullType: { return new NeverType(); }
    case _: { return t; }
  }
};

/**
 * Subtract a specific type from a union type.
 * For example, subtractTypeFromUnion(Cat | Fish, Cat) => Fish.
 * For non-union types, returns never if equal, or the original type unchanged.
 */
let subtractTypeFromUnion = (original: Type, toRemove: Type): Type => {
  match (original) {
    case UnionT as u: {
      let remaining = new Array<Type>();
      let types = u.types;
      var i = 0;
      while (i < types.length) {
        if (!typesEqual(types[i], toRemove)) {
          remaining.push(types[i]);
        }
        i = i + 1;
      }
      if (remaining.length == 0) { return new NeverType(); }
      if (remaining.length == 1) { return remaining[0]; }
      return new UnionT(remaining);
    }
    case _: {
      if (typesEqual(original, toRemove)) { return new NeverType(); }
      return original;
    }
  }
};

let unwrapNullableForMemberLookup = (t: Type): Type | null => {
  match (t) {
    case NullType: {
      return null;
    }
    case UnionT as u: {
      let remaining = new Array<Type>();
      let members = u.types;
      for (let member in members) {
        if (!(member is NullType)) {
          remaining.push(member);
        }
      }
      if (remaining.length == 0) {
        return null;
      }
      if (remaining.length == 1) {
        return remaining[0];
      }
      return new UnionT(remaining);
    }
    case _: {
      return t;
    }
  }
};

let getMemberPathKey = (ctx: CheckerContext, expr: Expression): String | null => {
  match (expr) {
    case Identifier: {
      let info = ctx.model.resolve(expr);
      if (info == null) {
        return null;
      }
      return "s" + i32ToString((info as Symbol).id as i32);
    }
    case ThisExpression: {
      return "this";
    }
    case MemberExpression {object, property, isSymbolAccess}: {
      let base = getMemberPathKey(ctx, object);
      if (base == null) {
        return null;
      }
      let propStr = getMemberPropertyName(isSymbolAccess, property.name);
      return (base as String) + "." + propStr;
    }
    case _: {
      return null;
    }
  }
};

let getMemberPathKeyFromAccess = (
  ctx: CheckerContext,
  object: Expression,
  property: Identifier,
  isSymbolAccess: boolean
): String | null => {
  let base = getMemberPathKey(ctx, object);
  if (base == null) {
    return null;
  }
  let propStr = getMemberPropertyName(isSymbolAccess, property.name);
  return (base as String) + "." + propStr;
};

let isImmutableFieldAccess = (objectType: Type, propName: String): boolean => {
  let base = unwrapNullableForMemberLookup(objectType);
  if (base == null) {
    return false;
  }

  match (base as Type) {
    case ClassType as ct: {
      if (!ct.members.has(propName)) {
        return false;
      }
      let m = ct.members[propName];
      match (m) {
        case FieldInfo as fi: {
          return !fi.isMutable;
        }
        case _: { return false; }
      }
    }
    case InterfaceType as it: {
      if (!it.members.has(propName)) {
        return false;
      }
      let m = it.members[propName];
      match (m) {
        case FieldInfo as fi: {
          return !fi.isMutable;
        }
        case _: { return false; }
      }
    }
    case RecordT {properties}: {
      return properties.has(propName);
    }
    case _: {
      return false;
    }
  }
};

let isImmutableMemberPath = (ctx: CheckerContext, expr: Expression): boolean => {
  match (expr) {
    case MemberExpression {object, property, isSymbolAccess}: {
      let objectType = checkExpression(ctx, object, null);
      let propName = getMemberPropertyName(isSymbolAccess, property.name);
      if (!isImmutableFieldAccess(objectType, propName)) {
        return false;
      }

      match (object) {
        case Identifier: {
          return true;
        }
        case ThisExpression: {
          return true;
        }
        case MemberExpression: {
          return isImmutableMemberPath(ctx, object);
        }
        case _: {
          return false;
        }
      }
    }
    case _: {
      return false;
    }
  }
};

/**
 * Extract is-expression narrowing from a condition like `x is T`.
 * Returns the Symbol, the target type, and the original type.
 */
let extractIsNarrowing = (
  ctx: CheckerContext,
  condition: Expression
): (Symbol | null, Type | null, Type | null) => {
  match (condition) {
    case IsExpression {expression, typeAnnotation}: {
      match (expression) {
        case Identifier {}: {
          let info = ctx.model.resolve(expression as Node);
          if (info == null) {
            return (null, null, null);
          }
          let si = info as Symbol;
          let originalType = ctx.resolveIdentifier(expression as Node);
          if (originalType == null) {
            return (null, null, null);
          }
          let targetType = resolveTypeAnnotation(ctx, typeAnnotation);
          return (si, targetType, originalType as Type);
        }
        case _: { return (null, null, null); }
      }
    }
    case _: { return (null, null, null); }
  }
};

/**
 * Extract null-guard narrowing from a condition like `x == null` or `x != null`.
 * Returns the Symbol and the narrowed type for the "after-exit" context.
 *
 * For `x == null` with definite exit: inverse narrowing removes null from x.
 * For `x != null` with definite exit: inverse narrowing narrows x to null.
 */
let extractNullGuardNarrowing = (
  ctx: CheckerContext,
  condition: Expression
): (Symbol | null, Type | null, boolean) => {
  match (condition) {
    case BinaryExpression {operator, left, right}: {
      if (operator == "==" || operator == "!=" || operator == "===" || operator == "!==") {
        // Check for `x == null` or `null == x`
        var target: Expression | null = null;
        match (right) {
          case NullLiteral {}: { target = left; }
          case _: {
            match (left) {
              case NullLiteral {}: { target = right; }
              case _: {}
            }
          }
        }
        if (target == null) {
          return (null, null, false);
        }

        let targetExpr = target as Expression;
        match (targetExpr) {
          case Identifier {name}: {
            let info = ctx.model.resolve(targetExpr as Node);
            if (info == null) {
              return (null, null, false);
            }
            if (!(info is Symbol)) {
              return (null, null, false);
            }
            let si = info as Symbol;
            var originalType = ctx.model.getNodeType(targetExpr as Node);
            if (originalType == null) {
              originalType = ctx.resolveIdentifier(targetExpr as Node);
            }
            if (originalType == null || !(originalType is Type)) {
              return (null, null, false);
            }
            let isEqualNull = operator == "==" || operator == "===";
            return (si, originalType as Type, isEqualNull);
          }
          case _: {
            return (null, null, false);
          }
        }
      } else {
        return (null, null, false);
      }
    }
    case _: { return (null, null, false); }
  }
};

let extractNullGuardPathNarrowing = (
  ctx: CheckerContext,
  condition: Expression
): (String | null, Type | null, boolean) => {
  match (condition) {
    case BinaryExpression {operator, left, right}: {
      if (operator != "==" && operator != "!=" && operator != "===" && operator != "!==") {
        return (null, null, false);
      }

      var target: Expression | null = null;
      match (right) {
        case NullLiteral {}: { target = left; }
        case _: {
          match (left) {
            case NullLiteral {}: { target = right; }
            case _: {}
          }
        }
      }
      if (target == null) {
        return (null, null, false);
      }

      let targetExpr = target as Expression;
      if (!(targetExpr is MemberExpression)) {
        return (null, null, false);
      }
      if (!isImmutableMemberPath(ctx, targetExpr)) {
        return (null, null, false);
      }

      let key = getMemberPathKey(ctx, targetExpr);
      if (key == null) {
        return (null, null, false);
      }

      var originalType = ctx.model.getNodeType(targetExpr);
      if (originalType == null) {
        originalType = checkExpression(ctx, targetExpr, null);
      }
      return (key, originalType, operator == "==" || operator == "===");
    }
    case _: { return (null, null, false); }
  }
};

final class ConditionNarrowings {
  bindings: HashMap<SymbolId, Type>;
  paths: HashMap<String, Type>;
  new() :
    bindings = new HashMap<SymbolId, Type>(),
    paths = new HashMap<String, Type>();
}

let applyNarrowings = (ctx: CheckerContext, ns: ConditionNarrowings): void => {
  for (let id in ns.bindings.keys()) {
    if (let (true, t) = ns.bindings.get(id)) {
      ctx.narrowBindingById(id, t);
    }
  }
  for (let path in ns.paths.keys()) {
    if (let (true, t) = ns.paths.get(path)) {
      ctx.narrowMemberPath(path, t);
    }
  }
};

let mergeNarrowings = (ctx: CheckerContext, dest: ConditionNarrowings, src: ConditionNarrowings): void => {
  for (let id in src.bindings.keys()) {
    if (let (true, t) = src.bindings.get(id)) {
      dest.bindings[id] = t;
    }
  }
  for (let path in src.paths.keys()) {
    if (let (true, t) = src.paths.get(path)) {
      dest.paths[path] = t;
    }
  }
};

let intersectNarrowings = (
  ctx: CheckerContext,
  dest: ConditionNarrowings,
  left: ConditionNarrowings,
  right: ConditionNarrowings
): void => {
  for (let id in left.bindings.keys()) {
    if (let (true, leftType) = left.bindings.get(id)) {
      if (let (true, rightType) = right.bindings.get(id)) {
        let types = new Array<Type>();
        types.push(leftType);
        types.push(rightType);
        dest.bindings[id] = createUnionType(types, ctx, null);
      }
    }
  }
  for (let path in left.paths.keys()) {
    if (let (true, leftType) = left.paths.get(path)) {
      if (let (true, rightType) = right.paths.get(path)) {
        let types = new Array<Type>();
        types.push(leftType);
        types.push(rightType);
        dest.paths[path] = createUnionType(types, ctx, null);
      }
    }
  }
};

let getNarrowedTypesFromCondition = (
  ctx: CheckerContext,
  condition: Expression,
  truthValue: boolean
): ConditionNarrowings => {
  let result = new ConditionNarrowings();

  match (condition) {
    case UnaryExpression {operator, argument}: {
      if (operator == "!") {
        return getNarrowedTypesFromCondition(ctx, argument, !truthValue);
      }
    }
    case BinaryExpression {operator, left, right}: {
      if (operator == "&&") {
        if (truthValue) {
          let leftNarrowings = getNarrowedTypesFromCondition(ctx, left, true);
          ctx.enterScope();
          applyNarrowings(ctx, leftNarrowings);
          let rightNarrowings = getNarrowedTypesFromCondition(ctx, right, true);
          ctx.exitScope();

          mergeNarrowings(ctx, result, leftNarrowings);
          mergeNarrowings(ctx, result, rightNarrowings);
        } else {
          let leftNarrowings = getNarrowedTypesFromCondition(ctx, left, false);
          let rightNarrowings = getNarrowedTypesFromCondition(ctx, right, false);
          intersectNarrowings(ctx, result, leftNarrowings, rightNarrowings);
        }
        return result;
      }
      if (operator == "||") {
        if (truthValue) {
          let leftNarrowings = getNarrowedTypesFromCondition(ctx, left, true);
          let rightNarrowings = getNarrowedTypesFromCondition(ctx, right, true);
          intersectNarrowings(ctx, result, leftNarrowings, rightNarrowings);
        } else {
          let leftNarrowings = getNarrowedTypesFromCondition(ctx, left, false);
          ctx.enterScope();
          applyNarrowings(ctx, leftNarrowings);
          let rightNarrowings = getNarrowedTypesFromCondition(ctx, right, false);
          ctx.exitScope();

          mergeNarrowings(ctx, result, leftNarrowings);
          mergeNarrowings(ctx, result, rightNarrowings);
        }
        return result;
      }
    }
    case _: {}
  }

  // Base cases
  if (truthValue) {
    let (guardInfo, guardOrigType, isEqualNull) = extractNullGuardNarrowing(ctx, condition);
    if (guardInfo != null) {
      let si = guardInfo as Symbol;
      let origType = guardOrigType as Type;
      if (isEqualNull) {
        result.bindings[si.id] = new NullType();
      } else {
        result.bindings[si.id] = subtractNullFromType(origType);
      }
      return result;
    }

    let (guardPathKey, guardPathOrigType, pathIsEqualNull) = extractNullGuardPathNarrowing(ctx, condition);
    if (guardPathKey != null) {
      let pathKey = guardPathKey as String;
      let origType = guardPathOrigType as Type;
      if (pathIsEqualNull) {
        result.paths[pathKey] = new NullType();
      } else {
        result.paths[pathKey] = subtractNullFromType(origType);
      }
      return result;
    }

    let (isInfo, isTargetType, isOrigType) = extractIsNarrowing(ctx, condition);
    if (isInfo != null) {
      let si = isInfo as Symbol;
      result.bindings[si.id] = isTargetType as Type;
      return result;
    }

    let (isPathKey, isPathTargetType, isPathOrigType_) = extractIsPathNarrowing(ctx, condition);
    if (isPathKey != null) {
      result.paths[isPathKey as String] = isPathTargetType as Type;
      return result;
    }
  } else {
    let (guardInfo, guardOrigType, isEqualNull) = extractNullGuardNarrowing(ctx, condition);
    if (guardInfo != null) {
      let si = guardInfo as Symbol;
      let origType = guardOrigType as Type;
      if (isEqualNull) {
        result.bindings[si.id] = subtractNullFromType(origType);
      } else {
        result.bindings[si.id] = new NullType();
      }
      return result;
    }

    let (guardPathKey, guardPathOrigType, pathIsEqualNull) = extractNullGuardPathNarrowing(ctx, condition);
    if (guardPathKey != null) {
      let pathKey = guardPathKey as String;
      let origType = guardPathOrigType as Type;
      if (pathIsEqualNull) {
        result.paths[pathKey] = subtractNullFromType(origType);
      } else {
        result.paths[pathKey] = new NullType();
      }
      return result;
    }

    let (isInfo, isTargetType, isOrigType) = extractIsNarrowing(ctx, condition);
    if (isInfo != null) {
      let si = isInfo as Symbol;
      result.bindings[si.id] = subtractTypeFromUnion(isOrigType as Type, isTargetType as Type);
      return result;
    }

    let (isPathKey, isPathTargetType, isPathOrigType_) = extractIsPathNarrowing(ctx, condition);
    if (isPathKey != null) {
      result.paths[isPathKey as String] = subtractTypeFromUnion(isPathOrigType_ as Type, isPathTargetType as Type);
      return result;
    }
  }

  return result;
};

let applyTrueNarrowingFromCondition = (ctx: CheckerContext, condition: Expression): void => {
  let narrowings = getNarrowedTypesFromCondition(ctx, condition, true);
  applyNarrowings(ctx, narrowings);
};

let applyFalseNarrowingFromCondition = (ctx: CheckerContext, condition: Expression): void => {
  let narrowings = getNarrowedTypesFromCondition(ctx, condition, false);
  applyNarrowings(ctx, narrowings);
};

let extractIsPathNarrowing = (
  ctx: CheckerContext,
  condition: Expression
): (String | null, Type | null, Type | null) => {
  match (condition) {
    case IsExpression {expression, typeAnnotation}: {
      if (!(expression is MemberExpression)) {
        return (null, null, null);
      }
      if (!isImmutableMemberPath(ctx, expression)) {
        return (null, null, null);
      }

      let key = getMemberPathKey(ctx, expression);
      if (key == null) {
        return (null, null, null);
      }

      let originalType = checkExpression(ctx, expression, null);
      let targetType = resolveTypeAnnotation(ctx, typeAnnotation);
      return (key, targetType, originalType);
    }
    case _: {
      return (null, null, null);
    }
  }
};

enum NullGuardAssignKind {
  NotAnAssignment,
  AssignsNonNull,
  AssignsMaybeNull
}

/**
 * True if `node` contains, anywhere inside it (expression positions,
 * nested statements), an assignment to the variable identified by
 * targetId.
 */
let containsAssignmentToVariable = (ctx: CheckerContext, node: Node, targetId: SymbolId): boolean => {
  var found = false;
  walkEnter(node, (n: Node): void => {
    if (n is AssignmentExpression) {
      let ae = n as AssignmentExpression;
      if (ae.left is Identifier) {
        let info = ctx.model.resolve(ae.left);
        if (info != null && (info as Symbol).id == targetId) {
          found = true;
        }
      }
    }
  });
  return found;
};

/**
 * Classifies a top-level statement of a null-guard body with respect to
 * assignments to the variable identified by targetId. A plain
 * `x = value;` statement is classified by the checked type of `value`
 * (the outermost assignment stores last, so it governs even if `value`
 * contains further assignments to x). Any OTHER statement containing an
 * assignment to x — in an expression position or nested control flow —
 * is conservatively AssignsMaybeNull: it may run conditionally or leave
 * x null.
 */
let classifyNullGuardAssignment = (ctx: CheckerContext, stmt: Statement, targetId: SymbolId): NullGuardAssignKind => {
  if (stmt is ExpressionStatement) {
    let expression = (stmt as ExpressionStatement).expression;
    if (expression is AssignmentExpression) {
      let ae = expression as AssignmentExpression;
      if (ae.left is Identifier) {
        let info = ctx.model.resolve(ae.left);
        if (info != null && (info as Symbol).id == targetId) {
          let vt = ctx.model.getNodeType(ae.value);
          if (vt != null && !isNullableType(vt as Type) && !(vt is NullType)) {
            return NullGuardAssignKind.AssignsNonNull;
          }
          return NullGuardAssignKind.AssignsMaybeNull;
        }
      }
    }
  }
  if (containsAssignmentToVariable(ctx, stmt, targetId)) {
    return NullGuardAssignKind.AssignsMaybeNull;
  }
  return NullGuardAssignKind.NotAnAssignment;
};

/**
 * Check if a statement (or block) definitely assigns a NON-NULL value to
 * a variable identified by its Symbol id. Used to detect patterns like:
 *   if (x == null) { x = value; }
 * for post-if narrowing — sound only when `value` cannot itself be null,
 * and only for assignments at the top level of the guarded block (nested
 * or expression-position assignments may not run on every path, so they
 * defeat the narrowing). When several top-level assignments exist, the
 * last one governs.
 */
let bodyAssignsToVariable = (ctx: CheckerContext, stmt: Statement, targetId: SymbolId): boolean => {
  if (stmt is BlockStatement) {
    var state = NullGuardAssignKind.NotAnAssignment;
    for (let s in (stmt as BlockStatement).body) {
      let c = classifyNullGuardAssignment(ctx, s, targetId);
      if (c != NullGuardAssignKind.NotAnAssignment) {
        state = c;
      }
    }
    return state == NullGuardAssignKind.AssignsNonNull;
  }
  return classifyNullGuardAssignment(ctx, stmt, targetId) == NullGuardAssignKind.AssignsNonNull;
};
let unwrapAliases = (t: Type): Type => {
  var curr = t;
  while (curr is TypeAliasType) {
    let ta = curr as TypeAliasType;
    if (ta.isDistinct) { break; }
    curr = ta.target;
  }
  return curr;
};

let findImplementedInterfaceTransitiveInChecker = (ct: ClassType, name: String): InterfaceType | null => {
  let seen = new HashMap<String, boolean>();
  let queue = new Array<InterfaceType>();
  
  for (let impl in ct.implementsList) {
    let resolved = substituteTypeParams(ct.typeParameters, ct.typeArguments, impl) as InterfaceType;
    queue.push(resolved);
  }
  
  var currSuper = ct.superType;
  while (currSuper != null) {
    let superCt = currSuper as ClassType;
    for (let impl in superCt.implementsList) {
      let resolved = substituteTypeParams(superCt.typeParameters, superCt.typeArguments, impl) as InterfaceType;
      queue.push(resolved);
    }
    currSuper = superCt.superType;
  }
  
  var head = 0;
  while (head < queue.length) {
    let it = queue[head];
    head += 1;
    
    let sourceName = if (it.genericSource != null) (it.genericSource as InterfaceType).name else it.name;
    let key = sourceName + "_" + i32ToString(it.id as i32);
    if (!seen.has(key)) {
      seen[key] = true;
      if (sourceName == name) {
        return it;
      }
      for (let ext in it.extendsList) {
        let resolvedExt = substituteTypeParams(it.typeParameters, it.typeArguments, ext) as InterfaceType;
        queue.push(resolvedExt);
      }
    }
  }
  return null;
};

let checkStatement = (ctx: CheckerContext, stmt: Statement): void => {
  match (stmt) {
    case VariableDeclaration {kind, pattern, typeAnnotation, init, loc}: {
      checkVariableDeclaration(ctx, kind, pattern, typeAnnotation, init, loc);
    }
    case FunctionDeclaration {name as namePat, func}: {
      // A `function` is a `let` binding of a function value that happens to
      // be spelled with its name in front, so it checks the same way.
      let funcType = checkExpression(ctx, func as Expression, null);
      bindPattern(ctx, namePat as Pattern, funcType);
    }
    case ExpressionStatement {expression}: {
      checkExpression(ctx, expression, new VoidType());
    }
    case BlockStatement {body}: {
      ctx.enterScope();
      prescanPendingFunctions(ctx, body);
      var i = 0;
      while (i < body.length) {
        let stmtNode = body[i];
        checkStatement(ctx, stmtNode);
        if (branchDefinitelyExits(stmtNode) && i < body.length - 1) {
          ctx.error(
            "Unreachable code detected.",
            DiagnosticCode.UnreachableCode,
            body[i + 1].loc
          );
          break;
        }
        i += 1;
      }
      ctx.exitScope();
    }
    case ReturnStatement {argument, loc}: {
      let expectedReturn = ctx.returnType;
      if (ctx.yieldType != null && argument != null) {
        // Generators complete via bare `return;` or falling off the end;
        // the iteration protocol has no completion payload
        // (generators.md §2.2).
        ctx.error(
          "Generators cannot return a value; use 'yield' to produce values and bare 'return;' to finish.",
          DiagnosticCode.TypeMismatch,
          loc
        );
        checkExpression(ctx, argument as Expression, null);
      } else if (argument != null) {
        let argExpr = argument as Expression;
        // By convention, if expectedReturn is VoidType, we are inferring the return type.
        // We should not pass it down as expectedType since it will force if-expressions to void.
        let isInferring = expectedReturn != null && expectedReturn is VoidType;
        let passedExpected = if (isInferring) { null } else { expectedReturn };
        let argType = checkExpression(ctx, argExpr, passedExpected);
        if (expectedReturn != null) {
          let expected = expectedReturn as Type;
          if (expected is VoidType) {
            // No explicit return type - infer from return statements
            ctx.addInferredReturnType(argType);
          } else if (!isAssignableTo(ctx, argType, expected)) {
            // Async return-adoption (async.md §2): `return e` in an
            // annotated async body also accepts the declared Future<T>
            // itself, forwarding its result — legal only when T is
            // distinguishable from Future<T>.
            let adoptTarget = ctx.asyncFutureType;
            var adopted = false;
            if (adoptTarget != null &&
                extractFutureValueType(ctx, expected) == null &&
                isAssignableTo(ctx, argType, adoptTarget as Type)) {
              adopted = true;
            }
            if (!adopted) {
              ctx.error(
                "Type mismatch: cannot return '" + typeToString(argType) +
                "' from function expecting '" + typeToString(expected) + "'.",
                DiagnosticCode.TypeMismatch,
                loc
              );
            }
          } else {
            let instantiated = tryInstantiateGenericFunction(ctx, argType, expected);
            if (instantiated != argType) {
              ctx.setNodeType(argExpr, instantiated);
            }
            checkAndRegisterInterfaceAdaptation(ctx, argExpr, instantiated, expected);
          }
        } else {
          // No expected return type at all (shouldn't happen in a function, but collect anyway)
          ctx.addInferredReturnType(argType);
        }
      } else {
        // return; — function should return void.
        if (expectedReturn != null) {
          let expected = expectedReturn as Type;
          if (!(expected is VoidType)) {
            ctx.error(
              "Missing return value. Expected '" + typeToString(expected) + "'.",
              DiagnosticCode.TypeMismatch,
              loc
            );
          }
        }
      }
    }
    case YieldStatement {argument, loc}: {
      let expectedYield = ctx.yieldType;
      if (expectedYield == null) {
        // Not in a `gen` body. A closure nested inside a generator hits
        // this too: it is its own function and cannot suspend its
        // lexical parent (generators.md §2.2).
        ctx.error(
          "'yield' is only valid inside the body of a 'gen' function.",
          DiagnosticCode.TypeMismatch,
          loc
        );
        checkExpression(ctx, argument, null);
      } else {
        if (ctx.tryDepth > 0) {
          ctx.error(
            "'yield' may not appear inside 'try' (not yet supported).",
            DiagnosticCode.TypeMismatch,
            loc
          );
        }
        let expected = expectedYield as Type;
        if (expected is VoidType) {
          // No yield type annotation — infer from yield statements.
          let argType = checkExpression(ctx, argument, null);
          ctx.addInferredYieldType(argType);
        } else {
          let argType = checkExpression(ctx, argument, expected);
          if (!isAssignableTo(ctx, argType, expected)) {
            ctx.error(
              "Type mismatch: cannot yield '" + typeToString(argType) +
              "' from a generator with yield type '" + typeToString(expected) + "'.",
              DiagnosticCode.TypeMismatch,
              loc
            );
          } else {
            let instantiated = tryInstantiateGenericFunction(ctx, argType, expected);
            if (instantiated != argType) {
              ctx.setNodeType(argument, instantiated);
            }
            checkAndRegisterInterfaceAdaptation(ctx, argument, instantiated, expected);
          }
        }
      }
    }
    case IfStatement {test, consequent, alternate, loc}: {
      // Check condition.
      match (test) {
        case LetPatternCondition as lpc: {
          let initType = checkExpression(ctx, lpc.init, null);
          let narrowedInitType = narrowTypeByPattern(ctx, lpc.pattern, initType);
          ctx.enterScope();
          checkPattern(ctx, lpc.pattern, narrowedInitType);
          checkStatement(ctx, consequent);
          ctx.exitScope();
          if (alternate != null) {
            ctx.enterScope();
            checkStatement(ctx, alternate as Statement);
            ctx.exitScope();
          }
        }
case _: {
          let testExpr = test as Expression;
          let testType = checkExpression(ctx, testExpr, null);
          validateConditionType(ctx, testType, testExpr);

          // Consequent body with TRUE narrowings
          ctx.enterScope();
          applyTrueNarrowingFromCondition(ctx, testExpr);
          checkStatement(ctx, consequent);
          ctx.exitScope();

          // Alternate body with FALSE narrowings
          if (alternate != null) {
            ctx.enterScope();
            applyFalseNarrowingFromCondition(ctx, testExpr);
            checkStatement(ctx, alternate as Statement);
            ctx.exitScope();
          }

          // Narrowing past definite exits:
          // If the consequent always exits and there is no else branch,
          // the inverse narrowing holds for subsequent code.
          if (alternate == null && branchDefinitelyExits(consequent)) {
            applyFalseNarrowingFromCondition(ctx, testExpr);
          }

          // If the alternate always exits, the regular narrowing holds.
          if (alternate != null && branchDefinitelyExits(alternate as Statement)) {
            applyTrueNarrowingFromCondition(ctx, testExpr);
          }

          // Narrowing via assignment in null-guard body:
          // `if (x == null) { x = value; }` → x is non-null after
          if (alternate == null && !branchDefinitelyExits(consequent)) {
            let (guardInfo, guardOrigType, isEqualNull) = extractNullGuardNarrowing(ctx, testExpr);
            if (guardInfo != null && isEqualNull) {
              let si = guardInfo as Symbol;
              let origType = guardOrigType as Type;
              if (bodyAssignsToVariable(ctx, consequent, si.id)) {
                ctx.narrowBinding(si, subtractNullFromType(origType));
              }
            }
            let (guardPathKey, guardPathOrigType, pathIsEqualNull) = extractNullGuardPathNarrowing(ctx, testExpr);
            if (guardPathKey != null && pathIsEqualNull) {
              // Path assignment checking not yet implemented
            }
          }
        }
      }
    }
    case WhileStatement {test, body, loc}: {
      match (test) {
        case LetPatternCondition as lpc: {
          let initType = checkExpression(ctx, lpc.init, null);
          let narrowedInitType = narrowTypeByPattern(ctx, lpc.pattern, initType);
          ctx.enterLoop();
          ctx.enterScope();
          checkPattern(ctx, lpc.pattern, narrowedInitType);
          checkStatement(ctx, body);
          ctx.exitScope();
          ctx.exitLoop();
        }
        case _: {
          let testExpr = test as Expression;
          let testType = checkExpression(ctx, testExpr, null);
          validateConditionType(ctx, testType, testExpr);
          let (guardInfo, guardOrigType, isEqualNull) = extractNullGuardNarrowing(ctx, testExpr);
          let (guardPathKey, guardPathOrigType, pathIsEqualNull) = extractNullGuardPathNarrowing(ctx, testExpr);
          ctx.enterLoop();
          if (guardInfo != null || guardPathKey != null) {
            ctx.enterScope();
            if (guardInfo != null) {
              let si = guardInfo as Symbol;
              let origType = guardOrigType as Type;
              if (isEqualNull) {
                ctx.narrowBinding(si, new NullType());
              } else {
                ctx.narrowBinding(si, subtractNullFromType(origType));
              }
            } else {
              let pathKey = guardPathKey as String;
              let origType = guardPathOrigType as Type;
              if (pathIsEqualNull) {
                ctx.narrowMemberPath(pathKey, new NullType());
              } else {
                ctx.narrowMemberPath(pathKey, subtractNullFromType(origType));
              }
            }
            checkStatement(ctx, body);
            ctx.exitScope();
          } else {
            checkStatement(ctx, body);
          }
          ctx.exitLoop();
        }
      }
    }
    case ForStatement {init, test, update, body, loc}: {
      ctx.enterScope();
      if (init != null) {
        match (init as Node) {
          case VariableDeclaration as vd: {
            checkStatement(ctx, vd);
          }
          case _: {
            let initExpr = init as Expression;
            checkExpression(ctx, initExpr, null);
          }
        }
      }
      if (test != null) {
        let testExpr = test as Expression;
        let testType = checkExpression(ctx, testExpr, null);
        validateConditionType(ctx, testType, testExpr);
      }
      if (update != null) {
        let updateExpr = update as Expression;
        checkExpression(ctx, updateExpr, null);
      }
      ctx.enterLoop();
      checkStatement(ctx, body);
      ctx.exitLoop();
      ctx.exitScope();
    }
    case BreakStatement {loc}: {
      if (!ctx.inLoop()) {
        ctx.error("'break' outside of loop.", DiagnosticCode.BreakOutsideLoop, loc);
      }
    }
    case ContinueStatement {loc}: {
      if (!ctx.inLoop()) {
        ctx.error("'continue' outside of loop.", DiagnosticCode.ContinueOutsideLoop, loc);
      }
    }
    // Declarations that are handled during pre-pass or skipped for now.
    case ImportDeclaration {moduleSpecifier, imports}: {
      let deps = ctx.depExports;
      if (deps != null) {
        let depsMap = deps as HashMap<String, ModuleExports>;
        let specifier = moduleSpecifier.value;
        if (depsMap.has(specifier)) {
          let depMod = depsMap[specifier];

          // Look up the dependency's SemanticModel for resolved types.
          var depModel: SemanticModel | null = null;
          let models = ctx.depModels;
          if (models != null) {
            if (let (true, m) = models.get(specifier)) {
              depModel = m;
            }
          }

          for (let spec in imports) {
            let importedName = spec.imported.name;
            let localName = spec.local.name;

            if (importedName != "*") {
              checkCyclicImportRules(ctx, depMod, importedName, spec);
            }

            if (importedName == "*") {
              // It's a namespace import: import * as ns from 'mod'
              // We construct a RecordType populated with all value exports of the dependency.
              // The record is materialized eagerly in __start, so any
              // value originating across a cycle back edge would be
              // read before its initializer runs — reject those
              // (docs/design/import-cycles.md).
              let laterForNs = ctx.cyclicLaterPaths;
              if (laterForNs != null) {
                for (let expKey in depMod.keys()) {
                  if (let (true, exp) = depMod.get(expKey)) {
                    if (exp.isValue() &&
                        (laterForNs as HashSet<String>).has(exp.resolveTarget().modulePath)) {
                      ctx.error(
                        "Cyclic namespace import: '" + expKey +
                          "' originates in a module that has not initialized yet",
                        DiagnosticCode.CyclicImport, spec.loc);
                    }
                  }
                }
              }
              let properties = new HashMap<String, Type>();
              for (let expKey in depMod.keys()) {
                if (let (true, exp) = depMod.get(expKey)) {
                  if (exp.isValue()) {
                    let resolvedValType = if (depModel != null) {
                      let t = depModel.getBindingType(exp);
                      if (t != null) { t } else { lookupBindingTypeInDeps(ctx, exp) }
                    } else {
                      lookupBindingTypeInDeps(ctx, exp)
                    };
                    if (resolvedValType != null) {
                      properties[expKey] = resolvedValType as Type;
                    } else {
                      properties[expKey] = new ErrorType();
                    }
                  }
                }
              }
              let recordType = new RecordT(properties, null);
              
              // Register it as a value import in the local scope.
              let localValInfo = ctx.scopeResult.rootScope.getLocal(localName);
              if (localValInfo != null) {
                ctx.declareBinding(localValInfo, recordType);
              }
            } else {
              // Register type imports (classes, interfaces, etc.)
              let typeExport = if (let (true, exp) = depMod.get(importedName)) {
                if (exp.isType()) { exp } else { null }
              } else { null };
              if (typeExport != null) {
                var resolvedType: Type | null = null;
                if (depModel != null) {
                  let dm = depModel as SemanticModel;
                  resolvedType = dm.getExportType(importedName);
                  if (resolvedType == null) {
                    resolvedType = dm.getBindingType(typeExport);
                  }
                }
                if (resolvedType == null) {
                  resolvedType = lookupBindingTypeInDeps(ctx, typeExport);
                }
                if (resolvedType == null) {
                  // Cycle back edge on the first pass: the origin has
                  // no model yet. Materialize (or reuse) the canonical
                  // shell for nominal declarations; the origin's own
                  // registration fills the same object.
                  resolvedType = ctx.materializeCyclicImport(typeExport as Symbol, importedName);
                }

                if (resolvedType != null) {
                  // Use the actual resolved type from the dependency.
                  ctx.declareTypeName(localName, resolvedType);
                  
                  // Bind directly to the local TYPE symbol for this import.
                  let localTypeInfo = ctx.scopeResult.rootScope.getLocal(localName);
                  if (localTypeInfo != null) {
                    ctx.registerType(localTypeInfo, resolvedType);
                  }
                } else {
                  // Fallback: create stub types from the declaration AST node.
                  // For stdlib types, prefer the prelude type which has full
                  // member definitions (fields, methods, constructors).
                  let decl = typeExport.declaration;
                  if (decl != null) {
                    let localTypeInfo = ctx.scopeResult.rootScope.getLocal(localName);
                    match (decl) {
                      case ClassDeclaration {name}: {
                        let preludeType = ctx.resolveTypeName(name.name);
                        if (preludeType != null) {
                          ctx.declareTypeName(localName, preludeType);
                          if (localTypeInfo != null) {
                            ctx.declareBinding(localTypeInfo, preludeType);
                          }
                        } else {
                          let ct = new ClassType(ctx.freshTypeId(), -1 as SymbolId, name.name);
                          ctx.declareTypeName(localName, ct);
                          if (localTypeInfo != null) {
                            ctx.declareBinding(localTypeInfo, ct);
                          }
                        }
                      }
                      case InterfaceDeclaration {name}: {
                        let it = new InterfaceType(ctx.freshTypeId(), -1 as SymbolId, name.name);
                        ctx.declareTypeName(localName, it);
                        if (localTypeInfo != null) {
                          ctx.declareBinding(localTypeInfo, it);
                        }
                      }
                      case SealedVariant {name}: {
                        let ct = new ClassType(ctx.freshTypeId(), -1 as SymbolId, name.name);
                        ct.isCaseClass = true;
                        ctx.declareTypeName(localName, ct);
                        if (localTypeInfo != null) {
                          ctx.declareBinding(localTypeInfo, ct);
                        }
                      }
                      case _: {
                        ctx.declareTypeName(localName, new ErrorType());
                      }
                    }
                  } else {
                    ctx.declareTypeName(localName, new ErrorType());
                  }
                }
              }

              // Register value imports (functions, variables).
              let valueExport = if (let (true, exp) = depMod.get(importedName)) {
                if (exp.isValue()) { exp } else { null }
              } else { null };
              if (valueExport != null) {
                let localValInfo = ctx.scopeResult.rootScope.getLocal(localName);
                if (localValInfo != null) {
                  var resolvedValType = if (depModel != null) {
                    let t = depModel.getBindingType(valueExport as Symbol);
                    if (t != null) { t } else { lookupBindingTypeInDeps(ctx, valueExport as Symbol) }
                  } else {
                    lookupBindingTypeInDeps(ctx, valueExport as Symbol)
                  };
                  if (resolvedValType == null) {
                    // Cycle back edge, first pass: nominal declarations
                    // (class constructor values) resolve via their
                    // canonical shell.
                    resolvedValType = ctx.materializeCyclicImport(valueExport as Symbol, importedName);
                  }
                  if (resolvedValType != null) {
                    ctx.declareBinding(localValInfo, resolvedValType);
                  } else if (typeExport == null) {
                    ctx.declareBinding(localValInfo, new ErrorType());
                  }
                }
              }
            }
          }
        }
      }
    }
    case ExportAllDeclaration {}: {}
    case ExportFromDeclaration {}: {}
    case ClassDeclaration as cd: {
      registerClassDeclaration(ctx, cd);
      checkClassBodies(ctx, cd);
    }
    case InterfaceDeclaration as id: {
      checkInterfaceDeclaration(ctx, id);
    }
    case EnumDeclaration as ed: {
      checkEnumDeclaration(ctx, ed);
    }
    case MixinDeclaration as md: {
      checkMixinDeclaration(ctx, md);
    }
    case TypeAliasDeclaration as ta: {
      // Force materialization so errors inside constraints or the target type
      // are reported once (in their proper generic scope).
      ctx.materializeDeclaration(ta, ta.name.name);
      checkTypeAliasDeclaration(ctx, ta);
    }
    case DeclareFunction as df: {
      checkDeclareFunction(ctx, df);
    }
    case SymbolDeclaration as sd: {
      checkSymbolDeclaration(ctx, sd);
    }
    case ForInStatement {pattern, iterable, body, loc}: {
      let iterableType = checkExpression(ctx, iterable, null);
      let baseT = unwrapAliases(iterableType);
      if (baseT is ClassType) {
        let ct = baseT as ClassType;
        let iterableIface = findImplementedInterfaceTransitiveInChecker(ct, "Iterable");
        if (iterableIface != null) {
          checkAndRegisterInterfaceAdaptation(ctx, iterable, ct, iterableIface as InterfaceType);
        }
        let iteratorIface = findImplementedInterfaceTransitiveInChecker(ct, "Iterator");
        if (iteratorIface != null) {
          checkAndRegisterInterfaceAdaptation(ctx, iterable, ct, iteratorIface as InterfaceType);
        }
      }
      let elementType = getElementType(ctx, iterableType, iterable);
      ctx.enterScope();
      ctx.enterLoop();
      if (isRefutableDeclarationPattern(pattern)) {
        ctx.error(
          "Refutable pattern in variable declaration; use `if (let ...)` or `while (let ...)` for patterns that may not match.",
          DiagnosticCode.TypeMismatch,
          pattern.loc
        );
      }
      bindPattern(ctx, pattern, elementType);
      checkStatement(ctx, body);
      ctx.exitLoop();
      ctx.exitScope();
    }
  }
};

let checkVariableDeclaration = (
  ctx: CheckerContext,
  kind: String,
  pattern: Pattern,
  typeAnnotation: TypeAnnotation | null,
  init: Expression,
  loc: SourceLocation | null
): void => {
  // Infer the type of the initializer.
  let expectedType = if (typeAnnotation != null) {
    resolveTypeAnnotation(ctx, typeAnnotation as TypeAnnotation)
  } else {
    null
  };

  let initType = checkExpression(ctx, init, expectedType);
  if (typeAnnotation == null && pattern is IdentifierPattern) {
      }

  // For `var` bindings, widen literal types.
  var declType = initType;
  if (kind == "var" && typeAnnotation == null) {
    declType = widenType(ctx, initType);
  }

  // If an explicit type annotation is present, validate assignability.
  if (expectedType != null) {
    if (!isAssignableTo(ctx, initType, expectedType)) {
      ctx.error(
        `Type mismatch: '${typeToString(initType)}' is not assignable to '${typeToString(expectedType)}'.`,
        DiagnosticCode.TypeMismatch,
        loc
      );
    } else {
      let instantiated = tryInstantiateGenericFunction(ctx, initType, expectedType);
      if (instantiated != initType) {
        ctx.setNodeType(init, instantiated);
      }
      if (instantiated is RecordT && expectedType is RecordT) {
        // TODO: Fix narrowing here
        let itR = instantiated as RecordT;
        let expR = expectedType as RecordT;
        if (itR.properties.size != expR.properties.size) {
          ctx.model.setRecordAdaptation(init, itR, expR);
        }
      }
      checkAndRegisterInterfaceAdaptation(ctx, init, instantiated, expectedType);
    }
    declType = expectedType;
  }

  if (isRefutableDeclarationPattern(pattern)) {
    ctx.error(
      "Refutable pattern in variable declaration; use `if (let ...)` or `while (let ...)` for patterns that may not match.",
      DiagnosticCode.TypeMismatch,
      pattern.loc
    );
  }

  // Bind the declared names in the pattern.
  bindPattern(ctx, pattern, declType);
};

let isRefutableDeclarationPattern = (pattern: Pattern): boolean => {
  match (pattern) {
    case BindingPattern as bp: {
      return isRefutableDeclarationPattern(bp.pattern);
    }
    case IdentifierPattern: {
      return false;
    }
    case ClassPattern: {
      return true;
    }
    case LogicalPattern: {
      return true;
    }
    case LiteralPattern: {
      return true;
    }
    case AsPattern {pattern as inner}: {
      return if (inner is Pattern) {
        isRefutableDeclarationPattern(inner as Pattern)
      } else {
        true
      };
    }
    case AssignmentPattern {left}: {
      return isRefutableDeclarationPattern(left as Pattern);
    }
    case RecordPattern {properties}: {
      for (let property in properties) {
        if (isRefutableDeclarationPattern((property.value) as Pattern)) {
          return true;
        }
      }
      return false;
    }
    case TuplePattern {elements}: {
      for (let element in elements) {
        if (element != null) {
          if (isRefutableDeclarationPattern((element) as Pattern)) {
            return true;
          }
        }
      }
      return false;
    }
  }
};

/**
 * Extract element types for tuple-pattern binding/checking.
 * Supports TupleType, InlineTupleType, and unions of tuple-like members.
 */
let getTuplePatternElementTypes = (t: Type): Array<Type> | null => {
  match (t) {
    case TupleT {elementTypes}: {
      return elementTypes;
    }
    case InlineTupleT {elementTypes}: {
      return elementTypes;
    }
    case UnionT {types}: {
      if (types.length == 0) {
        return null;
      }

      let tupleMembers = new Array<Array<Type>>();
      for (let member in types) {
        match (member) {
          case TupleT {elementTypes}: {
            tupleMembers.push(elementTypes);
          }
          case InlineTupleT {elementTypes}: {
            tupleMembers.push(elementTypes);
          }
          case _: {
            return null;
          }
        }
      }

      if (tupleMembers.length == 0) {
        return null;
      }
      let arity = tupleMembers[0].length;

      for (let member in tupleMembers) {
        if (member.length != arity) {
          return null;
        }
      }

      let merged = new Array<Type>();
      
      for (var i = 0; i < arity; i += 1) {
        let atIndex = new Array<Type>();
        for (let member in tupleMembers) {
          let slotType = member[i];
          if (slotType is NeverType) {
            atIndex.push(new HoleType());
          } else {
            atIndex.push(slotType);
          }
        }
        merged.push(createUnionType(atIndex));
      }

      return merged;
    }
    case _: {
      return null;
    }
  }
};

let literalPatternCanMatchType = (value: Expression, t: Type): boolean => {
  match (t) {
    case BoolLiteralType {value as expected}: {
      return value is BooleanLiteral && (value as BooleanLiteral).value == expected;
    }
    case BooleanType: {
      return value is BooleanLiteral;
    }
    case StringLiteralType {value as expected}: {
      return value is StringLiteral && (value as StringLiteral).value == expected;
    }
    case ClassType {name}: {
      return name == "String" && value is StringLiteral;
    }
    case NumLiteralType {raw as expected}: {
      return value is NumberLiteral && (value as NumberLiteral).raw == expected;
    }
    case UnionT {types}: {
      for (let member in types) {
        if (literalPatternCanMatchType(value, member)) {
          return true;
        }
      }
      return false;
    }
    case _: {
      if (isNumericType(t)) {
        return value is NumberLiteral;
      }
      return false;
    }
  }
};

let patternCanMatchType = (ctx: CheckerContext, pattern: Node, t: Type): boolean => {
  match (pattern) {
    case IdentifierPattern: { return true; }
    case Identifier: { return true; }
    case BooleanLiteral as lit: {
      return literalPatternCanMatchType(lit, t);
    }
    case StringLiteral as lit: {
      return literalPatternCanMatchType(lit, t);
    }
    case NumberLiteral as lit: {
      return literalPatternCanMatchType(lit, t);
    }
    case LiteralPattern {value}: {
      return literalPatternCanMatchType(value, t);
    }
    case AssignmentPattern {left}: {
      return patternCanMatchType(ctx, left, t);
    }
    case AsPattern {pattern as inner}: {
      return patternCanMatchType(ctx, inner, t);
    }
    case LogicalPattern {operator, left, right}: {
      if (operator == "|") {
        return patternCanMatchType(ctx, left, t)
          || patternCanMatchType(ctx, right, t);
      }
      return patternCanMatchType(ctx, left, t)
        && patternCanMatchType(ctx, right, t);
    }
    case TuplePattern {elements}: {
      match (t) {
        case TupleT {elementTypes}: {
          if (elements.length > elementTypes.length) { return false; }
          for (var i = 0; i < elements.length; i += 1) {
            let elem = elements[i];
            if (elem != null && !patternCanMatchType(ctx, elem as Node, elementTypes[i])) {
              return false;
            }
          }
          return true;
        }
        case InlineTupleT {elementTypes}: {
          if (elements.length > elementTypes.length) { return false; }
          for (var i = 0; i < elements.length; i += 1) {
            let elem = elements[i];
            if (elem != null && !patternCanMatchType(ctx, elem as Node, elementTypes[i])) {
              return false;
            }
          }
          return true;
        }
        case UnionT {types}: {
          for (let member in types) {
            if (patternCanMatchType(ctx, pattern, member)) {
              return true;
            }
          }
          return false;
        }
        case _: {
          return false;
        }
      }
    }
    case _: {
      // Keep non-literal complex patterns conservative for narrowing.
      return true;
    }
  }
};

let narrowTypeByPattern = (ctx: CheckerContext, pattern: Pattern, t: Type): Type => {
  match (t) {
    case UnionT {types}: {
      let matched = new Array<Type>();
      for (let member in types) {
        if (patternCanMatchType(ctx, pattern, member)) {
          matched.push(member);
        }
      }
      if (matched.length > 0) {
        return createUnionType(matched);
      }
      return t;
    }
    case _: {
      return t;
    }
  }
};

/**
 * Bind names from a pattern, registering their types via the
 * DeclarationMap → Symbol → SemanticModel.setBindingType path.
 */
let bindPattern = (ctx: CheckerContext, pattern: Pattern, t: Type): void => {
  match (pattern) {
    case BindingPattern as bp: {
      bindPattern(ctx, bp.pattern, t);
    }
    case IdentifierPattern as pat: {
      let info = ctx.model.resolveDeclaration(pat);
      if (info != null) {
        let si = info as Symbol;
        if (si.declaration != null && (si.declaration as Node) != pat) {
          ctx.error(
            "Variable '" + pat.name + "' is already declared in this scope.",
            DiagnosticCode.DuplicateDeclaration,
            pat.loc
          );
        } else {
          ctx.declareBinding(si, t);
        }
      }
    }
    case RecordPattern {properties}: {
      // For record destructuring: { x, y } = record.
      match (t) {
        case RecordT {properties as recordProps, optionalProperties}: {
          for (let prop in properties) {
            let propName = prop.name.name;
            if (recordProps.has(propName)) {
              // Check if the property is optional and requires a default value
              let isOptional = optionalProperties != null &&
                (optionalProperties as HashSet<String>).has(propName);
              let hasDefault = prop.value is AssignmentPattern;
              if (isOptional && !hasDefault) {
                ctx.error(
                  "Optional field '" + propName + "' requires a default value when destructuring.",
                  DiagnosticCode.TypeMismatch,
                  prop.loc
                );
              } else {
                let propType = recordProps[propName];
                bindPattern(ctx, prop.value as Pattern, propType);
              }
            } else {
              ctx.error(
                "Type '" + typeToString(t) + "' has no property '" + propName + "'.",
                DiagnosticCode.PropertyNotFound,
                prop.loc
              );
            }
          }
        }
        case ClassType as ct: {
          for (let prop in properties) {
            let propName = prop.name.name;
            let propType = resolveClassFieldType(ctx, ct, propName, prop.loc);
            bindPattern(ctx, prop.value as Pattern, propType);
          }
        }
        case _: {
          // If not a record or class, just bind the property names as unknown.
          for (let property in properties) {
            bindPattern(ctx, property.value as Pattern, new ErrorType());
          }
        }
      }
    }
    case TuplePattern {elements, loc}: {
      let elementTypes = getTuplePatternElementTypes(t);
      if (elementTypes == null) {
        for (let element in elements) {
          if (element != null) {
            bindPattern(ctx, element as Pattern, new ErrorType());
          }
        }
        return;
      }
      // TODO: we seem to have a narrowing bug here. `elementTypes` should
      // already be non-null.
      let tupleElementTypes = elementTypes as Array<Type>;
      if (elements.length > tupleElementTypes.length) {
        ctx.error(
          "Tuple pattern has more elements than the tuple type.",
          DiagnosticCode.TypeMismatch,
          loc
        );
      }

      
      for (var i = 0; i < elements.length; i += 1) {
        let element = elements[i];
        if (element != null) {
          if (i < tupleElementTypes.length) {
            bindPattern(ctx, element as Pattern, tupleElementTypes[i]);
          } else {
            bindPattern(ctx, element as Pattern, new ErrorType());
          }
        }
      }
    }
    case AsPattern {pattern as inner, name}: {
      // `pattern as name` — bind both the inner pattern and the alias.
      bindPattern(ctx, inner as Pattern, t);
      // Narrow the alias to the matched type, not the scrutinee type.
      var narrowedType: Type = t;
      if (inner is ClassPattern) {
        let cp = inner as ClassPattern;
        let cls = ctx.resolveTypeName(cp.name.name);
        if (cls != null) {
          narrowedType = cls;
        }
      } else if (inner is Identifier) {
        let ident = inner as Identifier;
        let cls = ctx.resolveTypeName(ident.name);
        if (cls != null) {
          narrowedType = cls;
        }
      }
      let info = ctx.model.resolveDeclaration(name);
      if (info != null) {
        ctx.declareBinding(info, narrowedType);
      }
    }
    case AssignmentPattern {left, right}: {
      // `name = default` — default expression must be assignable to the
      // target binding type, then bind the left-hand pattern.
      let defaultType = checkExpression(ctx, right, t);
      if (!isAssignableTo(ctx, defaultType, t)) {
        ctx.error(
          `Type mismatch: '${typeToString(defaultType)}' is not assignable to '${typeToString(t)}'.`,
          DiagnosticCode.TypeMismatch,
          pattern.loc
        );
      }
      bindPattern(ctx, left as Pattern, t);
    }
    case ClassPattern as cp: {
      // Look up the class type.
      let clsName = cp.name.name;
      let classType = ctx.resolveTypeName(clsName);
      if (classType == null) {
        ctx.error(
          `'${clsName}' is not a class.`,
          DiagnosticCode.SymbolNotFound,
          cp.loc
        );
        return;
      }
      // Bind property patterns with field types from the class.
      for (let prop in cp.properties) {
        let propName = prop.name.name;
        let propType = resolveClassFieldType(ctx, classType as Type, propName, prop.loc);
        bindPattern(ctx, prop.value as Pattern, propType);
      }
    }
    case LogicalPattern {operator, left, right}: {
      // For | (or) and & (and) patterns, bind variables from both sides.
      bindPattern(ctx, left as Pattern, t);
      bindPattern(ctx, right as Pattern, t);
    }
    case LiteralPattern: {
      // Literal patterns introduce no bindings.
    }
  }
};

/**
 * Check an expression and return its inferred type.
 * `expectedType` is a contextual type hint (may be null).
 */
/**
 * Check a branch node of an IfExpression (Expression or BlockStatement).
 */
let checkIfBranchNode = (ctx: CheckerContext, node: Node, expectedType: Type | null): Type => {
  if (node is BlockStatement) {
    let b = node as BlockStatement;
    ctx.enterScope();
    // Check all statements except the last
    for (let statement in b.body) {
      checkStatement(ctx, statement);
    }
    // The type of the block is the type of the last expression statement
    var resultType: Type = new VoidType();
    if (b.body.length > 0) {
      let lastStmt = b.body[b.body.length - 1];
      if (lastStmt is ExpressionStatement) {
        let es = lastStmt as ExpressionStatement;
        resultType = checkExpression(ctx, es.expression, expectedType);
      } else {
        checkStatement(ctx, lastStmt);
      }
    }
    ctx.exitScope();
    return resultType;
  }
  if (node is Expression) {
    return checkExpression(ctx, node as Expression, expectedType);
  }
  return new VoidType();
};

let getMatchedLiteralType = (expr: Expression, expected: Type): Type | null => {
  match (expected) {
    case BoolLiteralType {value}: {
      if (expr is BooleanLiteral && (expr as BooleanLiteral).value == value) {
        return expected;
      }
    }
    case StringLiteralType {value}: {
      if (expr is StringLiteral && (expr as StringLiteral).value == value) {
        return expected;
      }
    }
    case NumLiteralType {raw}: {
      if (expr is NumberLiteral && (expr as NumberLiteral).raw == raw) {
        return expected;
      }
    }
    case UnionT {types}: {
      for (let type in types) {
        let matched = getMatchedLiteralType(expr, type);
        if (matched != null) {
          return matched;
        }
      }
    }
    case _: {}
  }
  return null;
};

/**
 * The integer types whose literal range the checker enforces: the narrow
 * types, which exist to describe exact storage widths, and the unsigned
 * types, which previously rejected every literal outright. Deliberately
 * direct `is` tests — a `baseType`-based predicate would also capture a
 * `NumLiteralType` expectation, which must keep falling through to i32.
 */
let isRangeCheckedIntType = (t: Type): boolean => {
  return t is U8Type || t is U16Type || t is I8Type || t is I16Type ||
      t is U32Type || t is U64Type;
};

/**
 * Type an integer literal against its context. The literal adopts a
 * numeric expected type when there is one, and for the types whose range
 * the checker enforces — the narrow types and the unsigned types — it
 * must also fit, so a byte-sized constant that cannot be stored is
 * reported rather than silently wrapped.
 *
 * `negative` reports a unary minus applied directly to this literal. It
 * is threaded in rather than inferred so that `-128` is measured against
 * i8's lower bound instead of its upper one.
 */
let checkIntegerLiteral = (
  ctx: CheckerContext,
  raw: String,
  negative: boolean,
  expectedType: Type | null,
  loc: SourceLocation | null
): Type => {
  if (expectedType == null) {
    return new I32Type();
  }
  let expected = expectedType as Type;
  // i32/i64/f32/f64 adopt the context without a range check, exactly as
  // they always have. Tightening them is a separate change with its own
  // fallout. Note these are deliberately direct `is` tests rather than
  // `isIntegerType`, which looks through `baseType` and would therefore
  // also capture a `NumLiteralType` expectation and hand it back as the
  // literal's type instead of i32.
  if (expected is I32Type || expected is I64Type ||
      expected is F32Type || expected is F64Type) {
    return expected;
  }
  if (!isRangeCheckedIntType(expected)) {
    return new I32Type();
  }
  if (integerLiteralFits(raw, negative, expected)) {
    return expected;
  }
  let sign = if (negative) "-" else "";
  ctx.error(
    "Integer literal " + sign + raw + " is out of range for type '" +
    typeToString(expected) + "'.",
    DiagnosticCode.TypeMismatch,
    loc
  );
  // Carry on as the expected type: the range is the only thing wrong, and
  // reporting a cascade of operator errors on top would not help.
  return expected;
};

let checkExpression = (ctx: CheckerContext, expr: Expression, expectedType: Type | null): Type => {
  let t = checkExpressionInner(ctx, expr, expectedType);
  // Record the inferred type in the semantic model.
  ctx.setNodeType(expr, t);
  return t;
};

let checkExpressionInner = (ctx: CheckerContext, expr: Expression, expectedType: Type | null): Type => {
  if (expectedType != null) {
    let matched = getMatchedLiteralType(expr, expectedType);
    if (matched != null) {
      return matched;
    }
  }
  
  return match (expr) {
  // --- Literals ---

  case NumberLiteral {raw, loc}: {
    // Check if the literal has a decimal point → float.
    if (raw.contains('.')) {
      // Float literal — default to f64; use context to pick f32.
      if (expectedType is F32Type || expectedType is F64Type) {
        // TODO: Fix the type narrowing issue that's requiring a cast here
        expectedType as Type
      } else {
        new F64Type()
      }
    } else {
      // Integer literal — default to i32; use context to pick other int or
      // float types.
      checkIntegerLiteral(ctx, raw, false, expectedType, loc)
    }
  }

  case StringLiteral {value, loc}: {
    // String literals ALWAYS have type String (the stdlib class from the prelude).
    let stringType = ctx.resolvePreludeType("String");
    if (stringType != null) {
      return stringType as Type;
    }
    // String not in scope — prelude was not loaded correctly.
    ctx.error(
      "Built-in type 'String' is not available. Ensure the standard prelude is loaded.",
      DiagnosticCode.SymbolNotFound,
      loc
    );
    new ErrorType()
  }

  case BooleanLiteral {value, loc}: {
    // Boolean literals get literal types (true or false).
    new BoolLiteralType(value)
  }

  case NullLiteral {loc}: new NullType()

  // --- Identifiers ---

  case Identifier {name, loc}: {
    // The hole literal `_` carries an internal unreadable placeholder type.
    // It is intended for inline tuple hole slots and requires control-flow
    // narrowing before safe use.
    if (name == "_") { return new HoleType(); }

    if (name == "__LOCATION__") {
      let stringType = ctx.resolveTypeName("String");
      if (stringType != null) {
        let uTypes = new Array<Type>();
        uTypes.push(stringType as Type);
        uTypes.push(new NullType());
        return createUnionType(uTypes);
      }
      return new UnknownType();
    }

    // Resolve through the scope pass's ReferenceMap → Symbol → binding type.
    let resolved = ctx.resolveIdentifier(expr);
    if (resolved != null) {
      resolved as Type
    } else {
      // Fall back to prelude values (intrinsics / built-ins without scope info)
      let preludeVal = ctx.resolvePreludeValue(name);
      if (preludeVal != null) {
        preludeVal as Type
      } else {
        ctx.error(
          "Variable '" + name + "' not found.",
          DiagnosticCode.SymbolNotFound,
          loc
        );
        new ErrorType() as Type
      }
    }
  }

  // --- Binary Expressions ---

  case BinaryExpression {operator, left, right, loc}: {
    checkBinaryExpression(ctx, expectedType, operator, left, right, loc)
  }

  // --- Unary Expressions ---

  case UnaryExpression {operator, argument, loc}: {
    // A negated integer literal is typed as a single unit, because the
    // bound that applies to `-128` is i8's lower bound, which the bare
    // literal `128` would fail. Only the range-checked types need this;
    // every other context keeps its original path exactly.
    if (operator == "-" && argument is NumberLiteral && expectedType != null &&
        isRangeCheckedIntType(expectedType as Type)) {
      let numArg = argument as NumberLiteral;
      if (!numArg.raw.contains('.')) {
        let litType = checkIntegerLiteral(ctx, numArg.raw, true, expectedType, loc);
        ctx.setNodeType(argument, litType);
        return litType;
      }
    }

    let argType = checkExpression(ctx, argument, expectedType);

    if (operator == "-") {
      if (isNumericType(argType)) {
        return argType;
      }
      ctx.error(
        "Unary '-' requires a numeric type, got '" + typeToString(argType) + "'.",
        DiagnosticCode.InvalidOperator,
        loc
      );
      return new ErrorType();
    }
    if (operator == "!") {
      if (isBooleanLike(argType)) {
        return new BooleanType();
      }
      ctx.error(
        "Unary '!' requires a boolean type, got '" + typeToString(argType) + "'.",
        DiagnosticCode.InvalidOperator,
        loc
      );
      return new BooleanType();
    }
    new ErrorType()
  }

  // --- Assignment ---

  case AssignmentExpression {left, value, operator, loc}: {
    // Check for assignment to immutable let binding
    match (left) {
      case Identifier {name}: {
        let info = ctx.model.resolve(left);
        if (info != null) {
          let si = info as Symbol;
          if (!si.isMutable) {
            ctx.error(
              "Cannot assign to immutable variable '" + name + "'.",
              DiagnosticCode.InvalidAssignment,
              loc
            );
            return new ErrorType();
          }
        }
      }
      case _: {}
    }

    // Check for read-only indexer assignment: arr[i] = x
    match (left) {
      case IndexExpression {object, index}: {
        let objectType = checkExpression(ctx, object, null);
        match (objectType) {
          case ClassType as ct: {
            // Check for setter []=
            if (!ct.members.has("[]=")) {
              // Check if there's a getter only (read-only indexer)
              if (ct.members.has("[]")) {
                ctx.error(
                  "Cannot assign to read-only indexer.",
                  DiagnosticCode.InvalidAssignment,
                  loc
                );
                return new ErrorType();
              }
            } else {
              let deps = ctx.currentDependencies();
              if (deps != null) {
                let classSymId = (ct.genericSource ?? ct).symbolId;
                deps.referencedSymbols.add(classSymId);
                deps.referencedClassMethods.add(i32ToString(classSymId as i32) + ".[]=");
              }
            }
          }
          case InterfaceType as it: {
            if (!it.members.has("[]=")) {
              if (it.members.has("[]")) {
                ctx.error(
                  "Cannot assign to read-only indexer.",
                  DiagnosticCode.InvalidAssignment,
                  loc
                );
                return new ErrorType();
              }
            } else {
              let deps = ctx.currentDependencies();
              if (deps != null) {
                let ifaceSymId = (it.genericSource ?? it).symbolId;
                deps.referencedSymbols.add(ifaceSymId);
                deps.referencedInterfaceMembers.add(i32ToString(ifaceSymId as i32) + ".[]=");
              }
            }
          }
          case _: {}
        }
      }
      case MemberExpression {object, property, isSymbolAccess}: {
        let propName = getMemberPropertyName(isSymbolAccess, property.name);
        // Handle private field assignment outside class
        if (propName.length > 0 && propName.sliceBytes(0, 1) == "#") {
          if (ctx.currentClass == null) {
            ctx.error(
              "Private field '" + propName + "' can only be accessed within a class.",
              DiagnosticCode.PrivateAccess,
              loc
            );
            return new ErrorType();
          }
        }
        // Check for read-only property assignment
        let objectType = checkExpression(ctx, object, null);
        match (objectType) {
          case ClassType as ct: {
            // Check if it's a field
            if (ct.members.has(propName)) {
              let m = ct.members[propName];
              match (m) {
                case FieldInfo as fi: {
                  if (!fi.isMutable) {
                    ctx.error(
                      "Cannot assign to read-only property '" + propName + "'.",
                      DiagnosticCode.InvalidAssignment,
                      loc
                    );
                    return new ErrorType();
                  }
                }
                case _: {
                  // Check for setter method (set#propName)
                  let setterName = "set#" + propName;
                  if (!ct.members.has(setterName)) {
                    // Check if there's a getter only (read-only property)
                    let getterName = "get#" + propName;
                    if (ct.members.has(getterName)) {
                      ctx.error(
                        "Cannot assign to read-only property '" + propName + "'.",
                        DiagnosticCode.InvalidAssignment,
                        loc
                      );
                      return new ErrorType();
                    }
                  }
                }
              }
            } else {
              // Check for setter method (set#propName)
              let setterName = "set#" + propName;
              if (!ct.members.has(setterName)) {
                // Check if there's a getter only (read-only property)
                let getterName = "get#" + propName;
                if (ct.members.has(getterName)) {
                  ctx.error(
                    "Cannot assign to read-only property '" + propName + "'.",
                    DiagnosticCode.InvalidAssignment,
                    loc
                  );
                  return new ErrorType();
                }
              }
            }
          }
          case _: {}
        }
      }
      case _: {}
    }

    // Null-coalescing assignment: x ??= value
    // Result type is the non-null part of left's type.
    // Narrows the binding to non-null afterward.
    if (operator != null && (operator as String) == "??") {
      let leftType = checkExpression(ctx, left, null);

      // Warn if LHS is not nullable (??= is a no-op).
      var leftIsNullable = false;
      var leftIsAlwaysNull = false;
      match (leftType) {
        case NullType: { leftIsNullable = true; leftIsAlwaysNull = true; }
        case UnionT as u: {
          let members = u.types;
          var ni = 0;
          while (ni < members.length) {
            if (members[ni] is NullType) { leftIsNullable = true; }
            ni += 1;
          }
        }
        case _: {}
      }
      if (!leftIsNullable) {
        ctx.warning(
          "Left operand of '??=' is not nullable and will always be returned.",
          DiagnosticCode.UnnecessaryNullish,
          loc
        );
        return leftType;
      }
      if (leftIsAlwaysNull) {
        ctx.warning(
          "Left operand of '??=' is always null and will never be returned.",
          DiagnosticCode.UnnecessaryNullish,
          loc
        );
      }

      let nonNullType = subtractNullFromType(leftType);
      let rightType = checkExpression(ctx, value, nonNullType);
      if (!isAssignableTo(ctx, rightType, nonNullType)) {
        ctx.error(
          "Type mismatch in '??=' assignment: '" + typeToString(rightType) +
          "' is not assignable to '" + typeToString(nonNullType) + "'.",
          DiagnosticCode.TypeMismatch,
          loc
        );
      }
      // Narrow the binding to non-null.
      match (left) {
        case Identifier: {
          let info = ctx.model.resolve(left);
          if (info != null) {
            ctx.narrowBinding(info as Symbol, nonNullType);
          }
        }
        case _: {}
      }
      return nonNullType;
    }

    // For assignment, use the declared (binding) type of the LHS,
    // not the narrowed type. The RHS must be compatible with what the
    // variable was declared as, not what it was narrowed to.
    var leftType: Type = checkExpression(ctx, left, null);
    match (left) {
      case Identifier: {
        let info = ctx.model.resolve(left);
        if (info != null) {
          let bindingType = ctx.model.getBindingType(info as Symbol);
          if (bindingType != null) {
            leftType = bindingType as Type;
          }
        }
      }
      case _: {}
    }
    var effectiveType = checkExpression(ctx, value, leftType);
    if (operator != null) {
      // We know op is set and not "??". Act like a binary expression: left + right.
      effectiveType = checkBinaryExpression(ctx, leftType, operator, left, value, loc);
      ctx.setNodeType(value, effectiveType);
    }

    // Index writes: record the []= overload selection for codegen
    // (member-lookup.md §5.1/§5.2). Selection is most-specific over
    // (index, value) and recorded on the ASSIGNMENT node — the read
    // half of a compound assignment records separately on the
    // IndexExpression. Only recorded when the setter is overloaded:
    // no record means the plain name is unambiguous.
    if (left is IndexExpression) {
      let idxExpr = left as IndexExpression;
      let recvType = ctx.model.getNodeType(idxExpr.object);
      let idxNodeType = ctx.model.getNodeType(idxExpr.index);
      if (recvType != null && idxNodeType != null) {
          var setterFt: FunctionType | null = null;
          var ownerParams: Array<TypeParameterType> | null = null;
          var ownerArgs: Array<Type> | null = null;
          match (baseType(recvType as Type)) {
            case ClassType as ct: {
              if (ct.members.has("[]=")) {
                setterFt = ct.members["[]="].type as FunctionType;
                ownerParams = ct.typeParameters;
                ownerArgs = ct.typeArguments;
              }
            }
            case InterfaceType as it: {
              if (it.members.has("[]=")) {
                setterFt = it.members["[]="].type as FunctionType;
                ownerParams = it.typeParameters;
                ownerArgs = it.typeArguments;
              }
            }
            case _: {}
          }
          if (setterFt != null && (setterFt as FunctionType).overloads != null) {
            let baseSetter = setterFt as FunctionType;
            let candidates = new Array<FunctionType>();
            candidates.push(baseSetter);
            for (let ov in baseSetter.overloads as Array<FunctionType>) {
              candidates.push(ov);
            }
            let applicableRaw = new Array<FunctionType>();
            let applicableRes = new Array<FunctionType>();
            for (let candidate in candidates) {
              let resolvedCandidate = substituteTypeParams(ownerParams, ownerArgs, candidate) as FunctionType;
              if (resolvedCandidate.parameters.length == 2 &&
                  isAssignableTo(ctx, idxNodeType as Type, resolvedCandidate.parameters[0]) &&
                  isAssignableTo(ctx, effectiveType, resolvedCandidate.parameters[1])) {
                applicableRaw.push(candidate);
                applicableRes.push(resolvedCandidate);
              }
            }
            let selIdx = selectMostSpecificIndex(ctx, applicableRes, 2, loc);
            if (selIdx >= 0) {
              ctx.model.setResolvedOverload(expr, applicableRaw[selIdx]);
            }
          }
        }
    }

    if (!isAssignableTo(ctx, effectiveType, leftType)) {
      ctx.error(
        "Type mismatch in assignment: '" + typeToString(effectiveType) +
        "' is not assignable to '" + typeToString(leftType) + "'.",
        DiagnosticCode.TypeMismatch,
        loc
      );
    } else {
      let instantiated = tryInstantiateGenericFunction(ctx, effectiveType, leftType);
      if (instantiated != effectiveType) {
        ctx.setNodeType(value, instantiated);
        effectiveType = instantiated;
      }
      checkAndRegisterInterfaceAdaptation(ctx, value, effectiveType, leftType);
    }

    leftType
  }

  // --- Functions ---

  case FunctionExpression as fe: {
    checkFunctionExpression(ctx, fe, expectedType)
  }

  case CallExpression as call: {
    checkCallExpression(ctx, call, expectedType)
  }

  // --- If Expression ---

  case IfExpression {test, consequent, alternate, loc}: {
    match (test) {
      case LetPatternCondition as lpc: {
        let initType = checkExpression(ctx, lpc.init, null);
        let narrowedInitType = narrowTypeByPattern(ctx, lpc.pattern, initType);
        ctx.enterScope();
        checkPattern(ctx, lpc.pattern, narrowedInitType);
        let consType = checkIfBranchNode(ctx, consequent, expectedType);
        ctx.exitScope();

        var altType: Type = new VoidType();
        if (alternate != null) {
          ctx.enterScope();
          altType = checkIfBranchNode(ctx, alternate as Node, expectedType);
          ctx.exitScope();
        }

        if (expectedType != null && expectedType is VoidType) {
          return new VoidType();
        }
        let branches = new Array<Type>();
        branches.push(consType);
        branches.push(altType);
        createUnionType(branches, ctx, loc)
      }
      case _: {
        let testExpr = test as Expression;
        let testType = checkExpression(ctx, testExpr, null);
        validateConditionType(ctx, testType, testExpr);

        // Extract null-guard narrowing from the condition.
        let (guardInfo, guardOrigType, isEqualNull) = extractNullGuardNarrowing(ctx, testExpr);
        let (guardPathKey, guardPathOrigType, pathIsEqualNull) = extractNullGuardPathNarrowing(ctx, testExpr);

        var isInfo: Symbol | null = null;
        var isTargetType: Type | null = null;
        var isOrigType: Type | null = null;
        var isPathKey: String | null = null;
        var isPathTargetType: Type | null = null;
        var isPathOrigType: Type | null = null;
        if (guardInfo == null && guardPathKey == null) {
          let (info, target, orig) = extractIsNarrowing(ctx, testExpr);
          isInfo = info;
          isTargetType = target;
          isOrigType = orig;
          if (isInfo == null) {
            let (pathKey, pathTarget, pathOrig) = extractIsPathNarrowing(ctx, testExpr);
            isPathKey = pathKey;
            isPathTargetType = pathTarget;
            isPathOrigType = pathOrig;
          }
        }

        // Check consequent with narrowing applied.
        if (guardInfo != null || guardPathKey != null || isInfo != null || isPathKey != null) {
          ctx.enterScope();
        }
        if (guardInfo != null) {
          let si = guardInfo as Symbol;
          let origType = guardOrigType as Type;
          if (isEqualNull) {
            ctx.narrowBinding(si, new NullType());
          } else {
            ctx.narrowBinding(si, subtractNullFromType(origType));
          }
        } else if (guardPathKey != null) {
          let pathKey = guardPathKey as String;
          let origType = guardPathOrigType as Type;
          if (pathIsEqualNull) {
            ctx.narrowMemberPath(pathKey, new NullType());
          } else {
            ctx.narrowMemberPath(pathKey, subtractNullFromType(origType));
          }
        } else if (isInfo != null) {
          ctx.narrowBinding(isInfo as Symbol, isTargetType as Type);
        } else if (isPathKey != null) {
          ctx.narrowMemberPath(isPathKey as String, isPathTargetType as Type);
        }
        let consType = checkIfBranchNode(ctx, consequent, expectedType);
        if (guardInfo != null || guardPathKey != null || isInfo != null || isPathKey != null) {
          ctx.exitScope();
        }

        // Check alternate with inverse narrowing applied.
        var altType: Type = new VoidType();
        if (alternate != null) {
          if (guardInfo != null || guardPathKey != null || isInfo != null || isPathKey != null) {
            ctx.enterScope();
          }
          if (guardInfo != null) {
            let si = guardInfo as Symbol;
            let origType = guardOrigType as Type;
            if (isEqualNull) {
              ctx.narrowBinding(si, subtractNullFromType(origType));
            } else {
              ctx.narrowBinding(si, new NullType());
            }
          } else if (guardPathKey != null) {
            let pathKey = guardPathKey as String;
            let origType = guardPathOrigType as Type;
            if (pathIsEqualNull) {
              ctx.narrowMemberPath(pathKey, subtractNullFromType(origType));
            } else {
              ctx.narrowMemberPath(pathKey, new NullType());
            }
          } else if (isInfo != null) {
            let narrowed = subtractTypeFromUnion(isOrigType as Type, isTargetType as Type);
            ctx.narrowBinding(isInfo as Symbol, narrowed);
          } else if (isPathKey != null) {
            let narrowed = subtractTypeFromUnion(isPathOrigType as Type, isPathTargetType as Type);
            ctx.narrowMemberPath(isPathKey as String, narrowed);
          }
          altType = checkIfBranchNode(ctx, alternate as Node, expectedType);
          if (guardInfo != null || guardPathKey != null || isInfo != null || isPathKey != null) {
            ctx.exitScope();
          }
        }

        // Result type is the union of both branches.
        if (expectedType != null && expectedType is VoidType) {
          return new VoidType();
        }
        let branches = new Array<Type>();
        branches.push(consType);
        branches.push(altType);
        createUnionType(branches, ctx, loc)
      }
    }
  }

  // --- TODO: Other expression types ---

  case MemberExpression as memExpr: {
    checkMemberExpression(ctx, memExpr, memExpr.object, memExpr.property, memExpr.optional, memExpr.isSymbolAccess, memExpr.loc)
  }
  case IndexExpression as idxExpr: {
    checkIndexExpression(ctx, idxExpr.object, idxExpr.index, idxExpr.optional, idxExpr.loc, idxExpr)
  }
  case ThisExpression {loc}: {
    let cc = ctx.currentClass;
    if (cc == null) {
      ctx.error("'this' used outside of a class.", DiagnosticCode.SymbolNotFound, loc);
      new ErrorType()
    } else {
      let cls = cc as ClassType;
      // In extension classes, 'this' resolves to the underlying type, not the extension class.
      if (cls.isExtension && cls.onType != null) {
        cls.onType as Type
      } else {
        cc as Type
      }
    }
  }
  case SuperExpression {loc}: {
    let cc = ctx.currentClass;
    if (cc == null) {
      ctx.error("'super' can only be used inside a class.", DiagnosticCode.SymbolNotFound, loc);
      new ErrorType()
    } else {
      let cls = cc as ClassType;
      let st = cls.superType;
      if (st == null) {
        ctx.error("Class '" + cls.name + "' does not have a superclass.", DiagnosticCode.SymbolNotFound, loc);
        new ErrorType()
      } else {
        st as Type
      }
    }
  }
  case NewExpression as newExpr: {
    checkNewExpression(ctx, newExpr, newExpr.callee, newExpr.typeArguments, newExpr.args, newExpr.loc)
  }
  case AsExpression {expression, typeAnnotation, loc}: {
    let sourceType = checkExpression(ctx, expression, null);
    let targetType = resolveTypeAnnotation(ctx, typeAnnotation);
    // The ownership handles are `distinct type` aliases, and casting into a
    // distinct type is otherwise allowed — which would let a Borrow<R> be
    // forged into an Own<R> (two owners, so two drops) or an Unmanaged<R> be
    // promoted without adopt()'s state-flag check. Both defeat the static
    // guarantee rather than degrading to a runtime error, so the handles are
    // only convertible inside zena:ownership, where disown/adopt live.
    // Generalizes to `opaque distinct type`; see docs/design/ownership.md.
    if (!ctx.filePath.startsWith("zena:ownership")) {
      let handleName = if (isOwnershipWrapper(targetType)) {
        ownershipHandleName(targetType)
      } else {
        ownershipHandleName(sourceType)
      };
      if (handleName != "" && !typesEqual(sourceType, targetType)) {
        ctx.error(
          "Cannot cast to or from '" + handleName + "': ownership handles are " +
          "not forgeable. Use 'disown'/'adopt' to change regime, or pass an " +
          "'Own' where a 'Borrow' is expected — that borrows implicitly.",
          DiagnosticCode.TypeMismatch,
          loc
        );
        return targetType;
      }
    }
    let isNarrowed = ctx.isExpressionNarrowed(expression);
    let isAutoCasted = if (expression is Identifier) {
      targetType is ClassType || targetType is InterfaceType
    } else {
      false
    };
    let warnCast = (!isNarrowed || isAutoCasted) && !(expression is ThisExpression);
    if (ctx.warnUnnecessaryCasts && warnCast && typesEqual(sourceType, targetType)) {
      ctx.warning("Unnecessary cast: expression is already of type '" + typeToString(targetType) + "'.", DiagnosticCode.UnnecessaryCast, loc);
    }
    if (targetType is UnionT) {
      ctx.error(
        "Cannot use union type '" + typeToString(targetType) + "' as cast target. Cast to each type separately.",
        DiagnosticCode.TypeMismatch,
        typeAnnotation.loc
      );
    }
    let validCast = isValidCast(sourceType, targetType);
    if (!validCast) {
      var errorMsg = "Cannot cast type '" + typeToString(sourceType) + "' to '" + typeToString(targetType) + "'.";
      if (sourceType is NullType && !isNullableType(targetType)) {
        errorMsg = "Cannot cast 'null' to non-nullable type '" + typeToString(targetType) + "'.";
      } else if (isValuePrimitive(sourceType) && !isValuePrimitive(targetType)) {
        errorMsg = "Cannot cast primitive type '" + typeToString(sourceType) + "' to reference type '" + typeToString(targetType) + "'. " +
                   "Use string concatenation or a conversion function instead.";
      }
      ctx.error(
        errorMsg,
        DiagnosticCode.TypeMismatch,
        loc
      );
    }
    // Only when the cast is otherwise well-formed: a cast already rejected as
    // impossible does not also need to be reported as a forge.
    if (validCast) {
      checkOpaqueCast(ctx, sourceType, targetType, loc);
    }
    checkAndRegisterInterfaceAdaptation(ctx, expr, sourceType, targetType);
    targetType
  }
  case IsExpression {expression, typeAnnotation, loc}: {
    checkExpression(ctx, expression, null);
    let targetType = resolveTypeAnnotation(ctx, typeAnnotation);
    ctx.setNodeType(typeAnnotation, targetType);
    new BooleanType()
  }
  case ArrayLiteral {elements, loc}: {
    var inferredElementType: Type = new ErrorType() as Type;
    if (elements.length == 0) {
      // Empty array — need contextual type or return unknown element type.
      if (expectedType != null) {
        match (expectedType as Type) {
          case ClassType as ct: {
            if ((isPreludeClassType(ctx, ct, "Array") || isPreludeClassType(ctx, ct, "FixedArray")) && ct.typeArguments != null) {
              let typeArgs = ct.typeArguments as Array<Type>;
              if (typeArgs.length > 0) {
                inferredElementType = typeArgs[0];
              }
            }
          }
          case ArrayType {elementType}: {
            inferredElementType = elementType;
          }
          case _: {}
        }
      }
    } else {
      // Infer element type from first element.
      let firstType = checkExpression(ctx, elements[0], null);
      var i = 1;
      while (i < elements.length) {
        let elemType = checkExpression(ctx, elements[i], null);
        if (!isAssignableTo(ctx, elemType, firstType)) {
          ctx.error(
            "Array element type mismatch: '" + typeToString(elemType) + "' is not assignable to '" + typeToString(firstType) + "'.",
            DiagnosticCode.TypeMismatch,
            elements[i].loc
          );
        }
        i += 1;
      }
      inferredElementType = firstType;
    }

    var faType = ctx.resolvePreludeType("FixedArray");
    if (ctx.currentClass != null && (ctx.currentClass as ClassType).name == "FixedArray") {
      faType = ctx.currentClass as Type;
    }
    if (faType == null) {
      throw new Error("prelude FixedArray class not found");
    }
    match (faType as Type) {
      case ClassType as faCt: {
        let typeArgs = new Array<Type>();
        typeArgs.push(inferredElementType);
        instantiateClassType(faCt, typeArgs) as Type
      }
      case _: {
        throw new Error("prelude FixedArray is not a ClassType");
      }
    }
  }
  case RecordLiteral {properties, loc}: {
    // Contextual typing: expected property types flow into the property
    // values, and (below) an assignable literal takes the expected record
    // type as its own. Codegen mints one struct per distinct record type,
    // so two literals of the same declared type must not come out as two
    // different mints ({p: null} and {p: somePofTypeP} against {p: P | null}) —
    // record dispatch casts the receiver to the declared type's mint.
    var expectedProps: HashMap<String, Type> | null = null;
    if (expectedType != null) {
      let baseExpected = baseType(expectedType as Type);
      if (baseExpected is RecordT) {
        expectedProps = (baseExpected as RecordT).properties;
      }
    }
    let propTypes = new HashMap<String, Type>();
    var i = 0;
    while (i < properties.length) {
      match (properties[i]) {
        case PropertyAssignment {name, value}: {
          var propExpected: Type | null = null;
          if (expectedProps != null &&
              (expectedProps as HashMap<String, Type>).has(name.name)) {
            propExpected = (expectedProps as HashMap<String, Type>)[name.name];
          }
          let valType = checkExpression(ctx, value, propExpected);
          propTypes[name.name] = valType;
        }
        case SpreadElement {argument}: {
          // Spread: merge properties from the argument's record/class type.
          let spreadType = checkExpression(ctx, argument, null);
          let nonNullSpread = subtractNullFromType(spreadType);
          match (nonNullSpread) {
            case RecordT {properties as spreadProps}: {
              let keys = spreadProps.keys();
              while (let (true, key) = keys.next()) {
                propTypes[key] = spreadProps[key];
              }
            }
            case ClassType as ct: {
              let keys = ct.members.keys();
              while (let (true, key) = keys.next()) {
                let member = ct.members[key];
                if (member is FieldInfo && !member.isStatic && !member.isPrivate && !(key.length > 0 && key.sliceBytes(0, 1) == "#")) {
                  propTypes[key] = member.type;
                }
              }
            }
            case _: {}
          }
        }
        case _: {}
      }
      i += 1;
    }
    let recT = new RecordT(propTypes, null);
    if (expectedType != null) {
      let baseExpected = baseType(expectedType as Type);
      if (baseExpected is RecordT && isAssignableTo(ctx, recT, baseExpected)) {
        return baseExpected;
      }
    }
    recT
  }
  case TupleLiteral {elements, loc}: {
    // Inline tuple literals are parsed as TupleLiteral nodes.
    // If the expected type is an inline tuple (or union of inline tuples),
    // check against those element expectations and produce an InlineTupleType.
    var expectedElementTypes: Array<Type> | null = null;
    var useInlineTuple = false;
    if (expectedType != null) {
      let maybeElems = getTuplePatternElementTypes(expectedType as Type);
      if (maybeElems != null) {
        expectedElementTypes = maybeElems as Array<Type>;
      }
      match (expectedType as Type) {
        case InlineTupleT {}: {
          useInlineTuple = true;
        }
        case UnionT {types}: {
          for (let member in types) {
            if (member is InlineTupleT) {
              useInlineTuple = true;
              break;
            }
          }
        }
        case _: {}
      }
    }

    // Check each element and collect their types.
    let elementTypes = new Array<Type>();
    var i = 0;
    while (i < elements.length) {
      var elemExpected: Type | null = null;
      if (expectedElementTypes != null && i < (expectedElementTypes as Array<Type>).length) {
        elemExpected = (expectedElementTypes as Array<Type>)[i];
      }
      let elemType = checkExpression(ctx, elements[i], elemExpected);
      elementTypes.push(elemType);
      i += 1;
    }
    if (useInlineTuple) {
      let inlineT = new InlineTupleT(elementTypes);
      if (expectedType != null) {
        let baseExpected = baseType(expectedType as Type);
        if (baseExpected is InlineTupleT && isAssignableTo(ctx, inlineT, baseExpected)) {
          return baseExpected;
        }
      }
      return inlineT;
    }
    let tupleT = new TupleT(elementTypes);
    if (expectedType != null) {
      let baseExpected = baseType(expectedType as Type);
      if (baseExpected is TupleT && isAssignableTo(ctx, tupleT, baseExpected)) {
        return baseExpected;
      }
    }
    tupleT
  }
  case MapLiteral {entries, loc}: {
    if (entries.length == 0) {
      ctx.error("Empty map literal requires type annotation. Use 'new HashMap<K, V>()' instead.", DiagnosticCode.TypeMismatch, loc);
      new ErrorType()
    } else {
      // Check all entries and unify key/value types.
      let firstKeyType = checkExpression(ctx, entries[0].key, null);
      let firstValType = checkExpression(ctx, entries[0].value, null);
      var ei = 1;
      while (ei < entries.length) {
        let kt = checkExpression(ctx, entries[ei].key, null);
        if (!isAssignableTo(ctx, kt, firstKeyType)) {
          ctx.error(
            "Map key type mismatch: expected '" + typeToString(firstKeyType) + "', got '" + typeToString(kt) + "'.",
            DiagnosticCode.TypeMismatch, entries[ei].key.loc
          );
        }
        let vt = checkExpression(ctx, entries[ei].value, null);
        if (!isAssignableTo(ctx, vt, firstValType)) {
          ctx.error(
            "Map value type mismatch: expected '" + typeToString(firstValType) + "', got '" + typeToString(vt) + "'.",
            DiagnosticCode.TypeMismatch, entries[ei].value.loc
          );
        }
        ei += 1;
      }
      // Return HashMap<K, V> if available, otherwise ErrorType.
      let hashMapType = ctx.resolveTypeName("HashMap");
      if (hashMapType != null) {
        match (hashMapType as Type) {
          case ClassType as hm: {
            let typeArgs = new Array<Type>();
            typeArgs.push(firstKeyType);
            typeArgs.push(firstValType);
            instantiateClassType(hm, typeArgs) as Type
          }
          case _: new ErrorType()
        }
      } else {
        new ErrorType()
      }
    }
  }
  case TemplateLiteral {expressions, loc}: {
    for (let subExpr in expressions) {
      checkExpression(ctx, subExpr, null);
    }
    let stringType = ctx.resolveTypeName("String");
    if (stringType != null) {
      let deps = ctx.currentDependencies();
      if (deps != null) {
        if (stringType is ClassType) {
          let stringCt = stringType as ClassType;
          let classSymId = (stringCt.genericSource ?? stringCt).symbolId;
          let sDeps = deps as SymbolDependencies;
          sDeps.referencedSymbols.add(classSymId);
          sDeps.referencedClassMethods.add(i32ToString(classSymId as i32) + ".fromParts");
        }
      }
      return stringType as Type;
    }
    ctx.error(
      "Built-in type 'String' is not available. Ensure the standard prelude is loaded.",
      DiagnosticCode.SymbolNotFound,
      loc
    );
    new ErrorType()
  }
  case TaggedTemplateExpression {tag, quasi, loc}: {
    // Check the interpolated expressions.
    var qi = 0;
    while (qi < quasi.expressions.length) {
      checkExpression(ctx, quasi.expressions[qi], null);
      qi += 1;
    }
    // Check the tag function and return its return type.
    let tagType = checkExpression(ctx, tag, null);
    match (tagType) {
      case FunctionType as ft: ft.returnType
      case _: {
        ctx.error(
          "Tagged template tag must be a function, got '" + typeToString(tagType) + "'.",
          DiagnosticCode.TypeMismatch, loc
        );
        new ErrorType()
      }
    }
  }
  case MatchExpression {discriminant, cases, loc}: {
    checkMatchExpr(ctx, discriminant, cases, loc, expectedType)
  }
  case AwaitExpression as aw: {
    checkAwaitExpression(ctx, aw)
  }

  case ThrowExpression {argument, loc}: {
    let deps = ctx.currentDependencies();
    if (deps != null) {
      deps.needsExceptionInfra = true;
    }
    let argType = checkExpression(ctx, argument, null);
    let errorType = ctx.resolveTypeName("Error");
    if (errorType != null) {
      let isError = isAssignableTo(ctx, argType, errorType as Type);
      var isActuallyError = isError;
      if (!isError) {
        match (argType) {
          case ClassType as cType: {
            var cur: ClassType | null = cType;
            while (cur != null) {
              let c = cur as ClassType;
              if (c.name == "Error") { isActuallyError = true; }
              cur = c.superType;
            }
          }
          case _: {}
        }
      }

      if (!isActuallyError) {
        ctx.error(
          "Thrown value must be an instance of Error, got '" + typeToString(argType) + "'.",
          DiagnosticCode.TypeMismatch, loc
        );
      }
    }
    new NeverType()
  }
  case TryExpression {body, handler, finalizer, loc}: {
    let deps = ctx.currentDependencies();
    if (deps != null) {
      deps.needsExceptionInfra = true;
    }
    // yield is rejected anywhere inside try/catch/finally (v1).
    ctx.enterTry();
    let tryType = checkMatchCaseBody(ctx, body as Node, expectedType);
    var catchType: Type | null = null;
    if (handler != null) {
      let clause = handler as CatchClause;
      ctx.enterScope();
      if (clause.param != null) {
        let paramId = clause.param as Identifier;
        let info = ctx.model.resolveDeclaration(paramId);
        if (info != null) {
          let errorType = ctx.resolveTypeName("Error");
          ctx.declareBinding(info as Symbol, if (errorType != null) errorType as Type else new ErrorType());
        }
      }
      catchType = checkMatchCaseBody(ctx, clause.body as Node, expectedType);
      ctx.exitScope();
    }
    if (finalizer != null) {
      checkMatchCaseBody(ctx, finalizer as Node, null);
    }
    ctx.exitTry();
    if (deps != null && (ctx.yieldType != null || ctx.asyncFutureType != null)) {
      // Enclosing locals the body assigns cannot ride the protected
      // edge (see analyzeTryBodyAssignments). In an ordinary function
      // ZIR mirrors them into a wasm local; inside a `gen`/`async`
      // body a local does not survive a suspension, so those are
      // celled instead — which is what this records. Runs after the
      // body is checked, so its identifiers resolve.
      for (let symId in analyzeTryBodyAssignments(body as Node, ctx.model)) {
        (deps as SymbolDependencies).tryMutatedSymbols.add(symId);
      }
    }
    if (catchType != null) {
      let types = new Array<Type>();
      types.push(tryType);
      types.push(catchType as Type);
      combineArmTypes(types)
    } else {
      tryType
    }
  }
  case RangeExpression {start, end, loc}: {
    // Check start/end are i32.
    if (start != null) {
      let startType = checkExpression(ctx, start as Expression, null);
      if (!isAssignableTo(ctx, startType, new I32Type())) {
        ctx.error(
          "Range start must be i32, got '" + typeToString(startType) + "'.",
          DiagnosticCode.TypeMismatch, loc
        );
      }
    }
    if (end != null) {
      let endType = checkExpression(ctx, end as Expression, null);
      if (!isAssignableTo(ctx, endType, new I32Type())) {
        ctx.error(
          "Range end must be i32, got '" + typeToString(endType) + "'.",
          DiagnosticCode.TypeMismatch, loc
        );
      }
    }
    // Determine which range variant to return.
    let rangeTypeName = if (start != null && end != null) { "BoundedRange" }
      else if (start != null) { "FromRange" }
      else if (end != null) { "ToRange" }
      else { "FullRange" };
    let rangeType = ctx.resolveTypeName(rangeTypeName);
    if (rangeType != null) { rangeType as Type }
    else { new ErrorType() }
  }
  case PipelineExpression {left, right, loc}: {
    let leftType = checkExpression(ctx, left, null);
    ctx.pushPipelineValue(leftType);
    let resultType = checkExpression(ctx, right, null);
    ctx.popPipelineValue();
    resultType
  }
  case PipePlaceholder {loc}: {
    let pipeType = ctx.pipelineValueType;
    if (pipeType == null) {
      ctx.error("'$' can only be used inside a pipeline expression (|>).", DiagnosticCode.SymbolNotFound, loc);
      new ErrorType()
    } else {
      pipeType as Type
    }
  }
  };
};

// ============================================================================
// Class & Interface Checking
// ============================================================================

let hasSameSignature = (a: FunctionType, b: FunctionType): boolean => {
  if (a.parameters.length != b.parameters.length) {
    return false;
  }
  for (var i = 0; i < a.parameters.length; i += 1) {
    if (!typesEqual(a.parameters[i], b.parameters[i])) {
      return false;
    }
  }
  return true;
};

let findMatchingOverload = (
  method: FunctionType,
  signature: FunctionType
): FunctionType | null => {
  if (hasSameSignature(method, signature)) {
    return method;
  }
  if (method.overloads != null) {
    let overloads = method.overloads as Array<FunctionType>;
    for (let overload in overloads) {
      if (hasSameSignature(overload, signature)) {
        return overload;
      }
    }
  }
  return null;
};

/**
 * Overload selection (member-lookup.md §5.1): X is at least as
 * specific as Y, over the call's first argCount parameters, when
 * every parameter of X is assignable to Y's corresponding parameter.
 */
let atLeastAsSpecific = (
  ctx: CheckerContext,
  x: FunctionType,
  y: FunctionType,
  argCount: i32
): boolean => {
  var i = 0;
  while (i < argCount && i < x.parameters.length && i < y.parameters.length) {
    if (!isAssignableTo(ctx, x.parameters[i], y.parameters[i])) {
      return false;
    }
    i += 1;
  }
  return true;
};

/**
 * Picks the most-specific applicable overload (member-lookup.md
 * §5.1): the unique applicable candidate at least as specific as
 * every other. Parameter-equivalent ties break toward the
 * exact-arity candidate; a set with no unique maximum is AMBIGUOUS —
 * returns (first-declared, true) so the caller can report the error
 * and still recover deterministically.
 */
let pickMostSpecificOverload = (
  ctx: CheckerContext,
  applicable: Array<FunctionType>,
  argCount: i32
): (FunctionType, boolean) => {
  var best = applicable[0];
  for (var i = 1; i < applicable.length; i += 1) {
    let c = applicable[i];
    let cBeatsBest = atLeastAsSpecific(ctx, c, best, argCount);
    let bestBeatsC = atLeastAsSpecific(ctx, best, c, argCount);
    if (cBeatsBest && !bestBeatsC) {
      best = c;
    } else if (cBeatsBest && bestBeatsC &&
        c.parameters.length == argCount &&
        best.parameters.length != argCount) {
      best = c;
    }
  }
  for (var i = 0; i < applicable.length; i += 1) {
    if (!atLeastAsSpecific(ctx, best, applicable[i], argCount)) {
      return (applicable[0], true);
    }
  }
  return (best, false);
};

/**
 * Shared tail of overload selection (member-lookup.md §5.1): the
 * most-specific candidate among the applicable ones, compared over
 * the (substituted) resolved forms, reporting the ambiguity error at
 * `loc`. Returns an index into the array so callers holding parallel
 * raw/resolved arrays can recover the declared signature; -1 when
 * nothing is applicable. Every overloaded selection site — calls,
 * index reads, index writes — funnels through this.
 */
let selectMostSpecificIndex = (
  ctx: CheckerContext,
  applicableRes: Array<FunctionType>,
  argCount: i32,
  loc: SourceLocation | null
): i32 => {
  if (applicableRes.length == 0) {
    return -1;
  }
  if (applicableRes.length == 1) {
    return 0;
  }
  let (winner, ambiguous) = pickMostSpecificOverload(ctx, applicableRes, argCount);
  if (ambiguous) {
    ctx.error(
      "Ambiguous overload call: multiple overloads match and none is most specific. Cast an argument to select one.",
      DiagnosticCode.TypeMismatch,
      loc
    );
  }
  for (var i = 0; i < applicableRes.length; i += 1) {
    if (applicableRes[i] == winner) {
      return i;
    }
  }
  return 0;
};

/**
 * Conservative value-overlap test for the overlap restriction on
 * subclass-added overloads (member-lookup.md §5.1): true when some
 * runtime value could satisfy both types. Exact for class-class
 * (single inheritance: unrelated classes share no subtype) and
 * primitive pairs; conservatively true when interfaces, type
 * parameters, or other open-world types are involved.
 */
let typesMayOverlap = (ctx: CheckerContext, a: Type, b: Type): boolean => {
  if (isAssignableTo(ctx, a, b) || isAssignableTo(ctx, b, a)) {
    return true;
  }
  return match (a) {
    case UnionT {types}: {
      for (let arm in types) {
        if (typesMayOverlap(ctx, arm, b)) { return true; }
      }
      false
    }
    case _: match (b) {
      case UnionT {types}: {
        for (let arm in types) {
          if (typesMayOverlap(ctx, a, arm)) { return true; }
        }
        false
      }
      case _: {
        let aIsClass = a is ClassType;
        let bIsClass = b is ClassType;
        if (aIsClass && bIsClass) {
          // Unrelated classes (neither assignable) share no common
          // subtype under single inheritance.
          false
        } else if (a is InterfaceType || b is InterfaceType ||
            a is TypeParameterType || b is TypeParameterType) {
          // A class can implement any interface; type parameters are
          // open. Conservatively overlapping.
          true
        } else {
          // Distinct primitives / other closed leaf types with no
          // assignability relation are disjoint.
          false
        }
      }
    }
  };
};

/**
 * True when some argument tuple could be applicable to both
 * signatures: their arity ranges intersect and every shared
 * parameter position may overlap in values.
 */
let signaturesMayOverlap = (
  ctx: CheckerContext,
  a: FunctionType,
  b: FunctionType
): boolean => {
  var aRequired = a.parameters.length;
  let aOpt = a.optionalParameters;
  if (aOpt != null) {
    aRequired = 0;
    for (let o in aOpt) { if (!o) { aRequired += 1; } }
  }
  var bRequired = b.parameters.length;
  let bOpt = b.optionalParameters;
  if (bOpt != null) {
    bRequired = 0;
    for (let o in bOpt) { if (!o) { bRequired += 1; } }
  }
  let lo = if (aRequired > bRequired) aRequired else bRequired;
  let hiA = a.parameters.length;
  let hiB = b.parameters.length;
  let hi = if (hiA < hiB) hiA else hiB;
  if (lo > hi) {
    return false;
  }
  var i = 0;
  while (i < lo) {
    if (!typesMayOverlap(ctx, a.parameters[i], b.parameters[i])) {
      return false;
    }
    i += 1;
  }
  return true;
};


/**
 * Register a class declaration's type identity, flags, superclass,
 * case-class params, member signatures (fields, methods, accessors),
 * and sealed variant types. Does NOT check method bodies, field
 * initializers, or accessor bodies — that happens in checkClassBodies.
 */
let synthesizeCaseClassMembers = (ctx: CheckerContext, ct: ClassType): void => {
  let hashType = new FunctionType(new Array<Type>(), null, new I32Type());
  ct.members["hashCode"] = new MethodInfo(hashType, false, false, false, false);

  let eqParams = new Array<Type>();
  eqParams.push(ct);
  let eqType = new FunctionType(eqParams, null, new BooleanType());
  ct.members["=="] = new MethodInfo(eqType, false, false, false, false);

  // Case classes nominally implement Hashable: their synthesized
  // hashCode()/== make them valid hash keys, so they are assignable to the
  // well-known Hashable interface without an explicit implements clause.
  let hashable = ctx.resolvePreludeType("Hashable");
  if (hashable != null && hashable is InterfaceType) {
    let ht = hashable as InterfaceType;
    var already = false;
    for (let impl in ct.implementsList) {
      if (impl === ht) { already = true; }
    }
    if (!already) {
      ct.implementsList.push(ht);
    }
  }
};

let registerClassDeclaration = (ctx: CheckerContext, cd: ClassDeclaration): void => {
  // Access Identifier.name directly. In Zena AST, ClassDeclaration.name is an Identifier
  // which has a .name: String field. Use cd.name.name directly.
  let className = cd.name.name;

  // Look up the pre-registered ClassType from the forward-declaration pass.
  // If not found (shouldn't happen), create one.
  var classType: ClassType = new ClassType(ctx.freshTypeId(), -1 as SymbolId, className);
  let preRegistered = ctx.resolveTypeName(className);
  if (preRegistered != null) {
    match (preRegistered as Type) {
      case ClassType as existing: { classType = existing; }
      case _: {}
    }
  }

  // Record the declaring file for cross-module goto-definition.
  classType.sourcePath = ctx.filePath;

  // Flags — ClassDeclaration is authoritative, overriding any
  // previously materialized flags (e.g., from SealedVariant).
  classType.isFinal = cd.isFinal;
  classType.isAbstract = cd.isAbstract;
  classType.isExtension = cd.isExtension;
  classType.isSealed = cd.isSealed;
  classType.isCaseClass = false;

  // Registration must be idempotent: the ClassType object may be
  // shared with an earlier registration (compiler intrinsics, or a
  // prior checking pass over the same module — identity-stable types
  // across import-cycle re-checks). Reset everything this pass
  // rebuilds rather than appending to or layering over stale state;
  // in particular a stale own-field entry in `members` would be
  // mistaken for an inherited field.
  classType.members.clear();
  classType.implementsList = new Array<InterfaceType>();
  classType.mixins = new Array<MixinType>();
  classType.constructorType = null;
  classType.fieldSetterNames = null;
  classType.declaredFields = null;
  classType.sealedVariants = null;

  ctx.enterScope();
  if (cd.typeParameters != null) {
    let tps = cd.typeParameters as Array<TypeParameter>;
    let freshParams = new Array<TypeParameterType>();
    var tpi = 0;
    while (tpi < tps.length) {
      let tp = tps[tpi];
      var constraint: Type | null = null;
      if (tp.constraint != null) {
        constraint = resolveTypeAnnotation(ctx, tp.constraint as TypeAnnotation);
      }
      var defaultT: Type | null = null;
      if (tp.defaultType != null) {
        defaultT = resolveTypeAnnotation(ctx, tp.defaultType as TypeAnnotation);
      }
      let tpType = ctx.getOrCreateTypeParameter(tp, constraint, defaultT);
      ctx.declareTypeName(tp.name, tpType);
      freshParams.push(tpType);
      tpi = tpi + 1;
    }
    classType.typeParameters = freshParams;
  }

  // Extension classes: resolve the underlying type from the 'on' clause.
  if (cd.isExtension && cd.onType != null) {
    classType.onType = resolveTypeAnnotation(ctx, cd.onType as TypeAnnotation);
  }

  // Sealed classes are implicitly abstract (cannot be instantiated directly).
  if (cd.isSealed) {
    classType.isAbstract = true;
  }

  // Case class: implicitly final (unless sealed).
  if (cd.caseParams != null && !cd.isSealed) {
    classType.isFinal = true;
    classType.isCaseClass = true;
    synthesizeCaseClassMembers(ctx, classType);
  }

  // Sealed classes: register forward variant names.
  if (cd.isSealed && cd.sealedVariants != null) {
    let variants = cd.sealedVariants as Array<SealedVariant>;
    var fvi = 0;
    while (fvi < variants.length) {
      let variant = variants[fvi];
      if (variant.params == null) {
        if (classType.forwardVariantNames != null) {
          (classType.forwardVariantNames as HashSet<String>).add(variant.name.name);
        } else {
          let set = new HashSet<String>();
          set.add(variant.name.name);
          classType.forwardVariantNames = set;
        }
      }
      fvi = fvi + 1;
    }
  }

  // Resolve superclass.
  if (cd.superClass != null) {
    let superAnn = cd.superClass as TypeAnnotation;
    let superType = resolveTypeAnnotation(ctx, superAnn);
    match (superType) {
      case ClassType as st: {
        if (st.isFinal || st.isCaseClass) {
          ctx.error(
            "Cannot extend final class '" + st.name + "'." +
            if (st.isCaseClass) " Case classes are implicitly final." else "",
            DiagnosticCode.IncompatibleTypes,
            cd.loc
          );
        }
        // Sealed classes can only be extended by their declared variants.
        if (st.isSealed) {
          // Check if this class is a forward-declared variant
          var isForwardVariant = false;
          if (st.forwardVariantNames != null) {
            let fwdNames = st.forwardVariantNames as HashSet<String>;
            if (fwdNames.has(className)) {
              isForwardVariant = true;
            }
          }
          if (!isForwardVariant) {
            ctx.error(
              "cannot extend sealed class '" + st.name + "'. " +
              "Sealed classes can only be extended by their declared variants.",
              DiagnosticCode.IncompatibleTypes,
              cd.loc
            );
          } else {
            // Distributed variant (`case X` in the sealed class, defined
            // as a standalone `final class X(...) extends Base`): this
            // class IS the variant — link it into the sealed class's
            // variant list so match exhaustiveness can enumerate it.
            // Dedup by name: re-check passes revisit this declaration
            // against the same shared ClassType.
            if (st.sealedVariants == null) {
              st.sealedVariants = new Array<ClassType>();
            }
            let variantList = st.sealedVariants as Array<ClassType>;
            var alreadyLinked = false;
            for (let v in variantList) {
              if (v.name == className) {
                alreadyLinked = true;
              }
            }
            if (!alreadyLinked) {
              variantList.push(classType);
            }
          }
        }
        classType.superType = st;
        // Inherit members from superclass.
        let memberKeys = st.members.keys();
        while (let (true, key) = memberKeys.next()) {
          // Privates are never inherited: skip "#..." members and the
          // get##/set## entries of private accessors.
          if ((key.length == 0 || key.sliceBytes(0, 1) != "#") &&
              !key.startsWith("get##") && !key.startsWith("set##")) {
            let parentMember = st.members[key];
            // With no type parameters to substitute, share the parent's
            // MemberInfo instead of cloning it. An unannotated field holds
            // an ErrorType placeholder until its initializer is inferred,
            // and that inference patches the FieldInfo in place — a clone
            // taken by a subclass materialized on demand before the base's
            // body check (e.g. a sealed variant mentioned by an earlier
            // base method) would keep the stale placeholder forever.
            let stParams = st.typeParameters;
            var noSubstitution = true;
            if (stParams != null) {
              noSubstitution = (stParams as Array<TypeParameterType>).length == 0;
            }
            if (noSubstitution) {
              classType.members[key] = parentMember;
              continue;
            }
            let subType = substituteTypeParams(st.typeParameters, st.typeArguments, parentMember.type);
            classType.members[key] = match (parentMember) {
              case FieldInfo as fi: {
                new FieldInfo(
                  subType,
                  fi.isMutable,
                  fi.isAbstract,
                  fi.isStatic,
                  fi.isPrivate,
                  fi.hasInitializer
                ) as MemberInfo
              }
              case MethodInfo as mi: {
                new MethodInfo(
                  subType,
                  mi.isAbstract,
                  mi.isStatic,
                  mi.isPrivate,
                  mi.isFinal
                ) as MemberInfo
              }
              case _: parentMember
            };
          }
        }
      }
      case _: {
        ctx.error(
          "Superclass must be a class type, got '" + typeToString(superType) + "'.",
          DiagnosticCode.IncompatibleTypes,
          cd.loc
        );
      }
    }
  }

  // Resolve and populate implementsList.
  if (cd.implementsList != null) {
    let implList = cd.implementsList as Array<TypeAnnotation>;
    for (let ifaceAnn in implList) {
      let ifaceType = resolveTypeAnnotation(ctx, ifaceAnn);
      match (ifaceType) {
        case InterfaceType as iface: {
          classType.implementsList.push(iface);
        }
        case _: {}
      }
    }
  }

  // Apply mixins
  if (cd.mixins != null) {
    let mixinAnns = cd.mixins as Array<TypeAnnotation>;
    var mi = 0;
    while (mi < mixinAnns.length) {
      let mixinAnn = mixinAnns[mi];
      let resolvedMixin = resolveTypeAnnotation(ctx, mixinAnn);
      
      match (resolvedMixin) {
        case MixinType as mt: {
          classType.mixins.push(mt);
          // Check 'on' constraint
          if (mt.onType != null) {
            let mtOnType = mt.onType as Type;
            var satisfied = false;
            var st: Type | null = null;
            if (cd.superClass != null && classType.superType != null) {
              st = classType.superType as Type;
            }
            if (st != null && isAssignableTo(ctx, st, mtOnType)) {
              satisfied = true;
            }

            if (!satisfied && cd.implementsList != null && classType.implementsList != null) {
              var i = 0;
              while (i < classType.implementsList.length) {
                if (isAssignableTo(ctx, classType.implementsList[i] as Type, mtOnType)) {
                  satisfied = true;
                }
                i += 1;
              }
            }
            
            if (!satisfied) {
              ctx.error(
                "Mixin '" + mt.name + "' requires target to extend or implement '" + 
                typeToString(mt.onType as Type) + "'.",
                DiagnosticCode.TypeMismatch,
                mixinAnn.loc
              );
            }
          }
          
          // Copy members
          let memberKeys = mt.members.keys();
          while (let (true, key) = memberKeys.next()) {
            let mtMember = mt.members[key];
            let isPrivateKey = (key.length > 0 && key.sliceBytes(0, 1) == "#") ||
                key.startsWith("get##") || key.startsWith("set##");
            if (mtMember is MethodInfo && !isPrivateKey) {
              if (classType.members.has(key)) {
                let existingMember = classType.members[key];
                if (!isAssignableTo(ctx, mtMember.type, existingMember.type)) {
                  ctx.error(
                    "Type mismatch in overridden method '" + key + "' is not compatible.",
                    DiagnosticCode.TypeMismatch,
                    mixinAnn.loc
                  );
                }
              }
            }
            if (mtMember.isAbstract && classType.members.has(key) && !classType.members[key].isAbstract) {
              continue;
            }
            let subType = substituteTypeParams(mt.typeParameters, mt.typeArguments, mtMember.type);
            // Mixin private FIELDS are stored under a mixin-scoped
            // key ("<scopeKey>::#name") so they never collide with a
            // host class's same-named private: privacy is lexical to
            // the mixin declaration, and code in mixin bodies reaches
            // these through the mixin's This type (whose
            // privateScopeKey matches). Private methods are not yet
            // namespaced this way (tracked in BUGS.md).
            // Mixin private FIELDS AND METHODS are stored under a
            // mixin-scoped key: privacy is lexical to the mixin
            // declaration, so a host's same-named private is a
            // different member entirely.
            var storeKey = key;
            if (isPrivateKey && (mtMember is FieldInfo || mtMember is MethodInfo)) {
              let scope = (mt.genericSource ?? mt).privateScopeKey;
              storeKey = if (scope != null) {
                (scope as String) + "::" + key
              } else {
                mt.name + "_This::" + key
              };
            }
            classType.members[storeKey] = match (mtMember) {
              case FieldInfo as fi: {
                new FieldInfo(
                  subType,
                  fi.isMutable,
                  fi.isAbstract,
                  fi.isStatic,
                  fi.isPrivate,
                  fi.hasInitializer
                ) as MemberInfo
              }
              case MethodInfo as mi: {
                new MethodInfo(
                  subType,
                  mi.isAbstract,
                  mi.isStatic,
                  mi.isPrivate,
                  mi.isFinal
                ) as MemberInfo
              }
              case _: mtMember
            };
          }
        }
        case _: {
          if (!(resolvedMixin is ErrorType)) {
            ctx.error(
              "'" + typeToString(resolvedMixin) + "' is not a mixin.",
              DiagnosticCode.TypeMismatch,
              mixinAnn.loc
            );
          }
        }
      }
      mi += 1;
    }
  }

  // Process case class parameters → generate fields and constructor.
  if (cd.caseParams != null) {
    let caseParams = cd.caseParams as Array<CaseClassParam>;
    let ctorParamTypes = new Array<Type>();
    let ctorParamNames = new Array<String>();
    let ctorOptionalParams = new Array<boolean>();

    var cpi = 0;
    while (cpi < caseParams.length) {
      let cp = caseParams[cpi];
      let fieldName = cp.name.name;
      var fieldType = resolveTypeAnnotation(ctx, cp.typeAnnotation);

      // Optional case params get nullable field type
      if (cp.optional) {
        let unionTypes = new Array<Type>();
        unionTypes.push(fieldType);
        unionTypes.push(new NullType());
        fieldType = createUnionType(unionTypes);
      }

      // Check for duplicate fields (but allow implementing abstract fields).
      var isImplementingAbstract = false;
      if (classType.members.has(fieldName) && classType.members[fieldName].isAbstract) {
        isImplementingAbstract = true;
      }
      // A case param may share its name with an INHERITED METHOD (a
      // sealed base's polymorphic accessor, e.g. docs(): Docs over a
      // variant's docs field) — the bootstrap accepts this and
      // wit-parser depends on it. Only a genuine field duplicate errors.
      var shadowsInheritedMethod = false;
      if (classType.members.has(fieldName) &&
          classType.members[fieldName] is MethodInfo) {
        shadowsInheritedMethod = true;
      }

      if (classType.members.has(fieldName) && !isImplementingAbstract &&
          !shadowsInheritedMethod) {
        ctx.error(
          "Duplicate field '" + fieldName + "' in class '" + className + "'.",
          DiagnosticCode.DuplicateField,
          cp.loc
        );
      }

      let isMutable = cp.mutability != null && cp.mutability == "var";
      classType.members[fieldName] = new FieldInfo(fieldType, isMutable, false, false, false, false);

      ctorParamTypes.push(fieldType);
      ctorParamNames.push(fieldName);
      ctorOptionalParams.push(cp.optional);
      cpi = cpi + 1;
    }

    // Auto-generate constructor type.
    let ctorType = new FunctionType(ctorParamTypes, ctorParamNames, classType);
    ctorType.optionalParameters = ctorOptionalParams;
    classType.constructorType = ctorType;
  }

  // Register the class type in both namespaces.
  ctx.declareTypeName(className, classType);

  // Also register in the value namespace (for `new ClassName` and as a binding).
  let classInfo = ctx.model.resolveDeclaration(cd);
  if (classInfo != null) {
    ctx.declareBinding(classInfo as Symbol, classType);
    ctx.model.addDeclaredClass((classInfo as Symbol).id, cd);
  }

  // Enter class context for body checking.
  ctx.enterClass(classType);

  // === Pass 1: Register all field types and method signatures ===
  // This allows forward references between methods (e.g. this.#foo() calling
  // a private method defined later in the class body).
  // Track fields declared directly in this class body (not inherited).
  let ownFieldNames = new HashSet<String>();
  let ownMethodNames = new HashSet<String>();
  for (let member in cd.body) {
    match (member) {
      case FieldDefinition as fd: {
        let fieldName = match (fd.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };
        var fieldType = if (fd.typeAnnotation != null) {
          let resolved = resolveTypeAnnotation(ctx, fd.typeAnnotation as TypeAnnotation);
          resolved
        } else {
          new ErrorType() as Type
        };

        if (fd.isOptional) {
          let isPrimitive = isNumericType(fieldType) || fieldType is BooleanType;
          if (isPrimitive) {
            ctx.error(
              "Optional field '" + fieldName + "' cannot have primitive type '" +
              typeToString(fieldType) + "'. Primitives are not nullable.",
              DiagnosticCode.IncompatibleTypes,
              fd.loc
            );
          }
          var alreadyNullable = false;
          match (fieldType) {
            case NullType: { alreadyNullable = true; }
            case UnionT {types}: {
              var ui = 0;
              while (ui < types.length) {
                if (types[ui] is NullType) { alreadyNullable = true; }
                ui += 1;
              }
            }
            case _: {}
          }
          if (!alreadyNullable) {
            let unionTypes = new Array<Type>();
            unionTypes.push(fieldType);
            unionTypes.push(new NullType());
            fieldType = createUnionType(unionTypes);
          }
        }

        // Extension classes cannot have instance fields.
        if (cd.isExtension && !fd.isStatic && !fd.isDeclare) {
          ctx.error(
            "Extension classes cannot have instance fields.",
            DiagnosticCode.IncompatibleTypes,
            fd.loc
          );
        }

        // Abstract fields can only appear in abstract or sealed classes.
        if (fd.isAbstract) {
          if (!cd.isAbstract && !cd.isSealed) {
            ctx.error(
              "Abstract field '" + fieldName + "' can only appear within an abstract or sealed class.",
              DiagnosticCode.IncompatibleTypes,
              fd.loc
            );
          }
          // Track abstract field.
          let isMutable = fd.mutability != null && fd.mutability == "var";
          classType.members[fieldName] = new FieldInfo(
            fieldType,
            isMutable,
            true, // isAbstract
            fd.isStatic,
            fieldName.length > 0 && fieldName.sliceBytes(0, 1) == "#", // isPrivate
            fd.value != null // hasInitializer
          );

          // An abstract field reserves a getter in the members table.
          let getterName = "get#" + fieldName;
          if (!classType.members.has(getterName)) {
            let isPrivate = getterName.length > 0 && getterName.sliceBytes(0, 1) == "#";
            classType.members[getterName] = new MethodInfo(
              new FunctionType(new Array<Type>(), null, fieldType),
              true, // isAbstract
              fd.isStatic,
              isPrivate,
              false // isFinal
            );
          }

          // If mutable, it also requires a setter.
          if (fd.mutability != null && fd.mutability == "var") {
            let setterName = "set#" + fieldName;
            if (!classType.members.has(setterName)) {
              let setterParams = new Array<Type>();
              setterParams.push(fieldType);
              let isPrivate = setterName.length > 0 && setterName.sliceBytes(0, 1) == "#";
              classType.members[setterName] = new MethodInfo(
                new FunctionType(setterParams, null, new VoidType()),
                true, // isAbstract
                fd.isStatic,
                isPrivate,
                false // isFinal
              );
            }
          }
        } else {
          // Concrete field may satisfy an inherited abstract field.
          if (classType.members.has(fieldName) && classType.members[fieldName].isAbstract) {
            // It replaces the abstract field.
          }



          var actualFieldName = fieldName;
          var hasPrivateSetter = false;
          if (fd.setterName != null) {
            hasPrivateSetter = true;
            actualFieldName = match (fd.setterName) {
              case Identifier {name}: name
              case _: fieldName
            };
            if (fd.setterName is Identifier) {
              if (classType.fieldSetterNames == null) {
                classType.fieldSetterNames = new HashMap<String, String>();
              }
              let m = classType.fieldSetterNames as HashMap<String, String>;
              m[fieldName] = (fd.setterName as Identifier).name;
            }
          }

          if (ownFieldNames.has(actualFieldName)) {
            ctx.error(
              "Duplicate field '" + actualFieldName + "' in class '" + className + "'.",
              DiagnosticCode.DuplicateField,
              fd.loc
            );
          } else if (classType.members.has(actualFieldName)) {
            // Field was inherited from superclass — check type compatibility.
            let inheritedField = classType.members[actualFieldName];
            if (!isAssignableTo(ctx, fieldType, inheritedField.type)) {
              ctx.error(
                "Field '" + actualFieldName + "' in subclass '" + className +
                "' must be compatible with inherited field of type '" +
                typeToString(inheritedField.type) + "'.",
                DiagnosticCode.IncompatibleTypes,
                fd.loc
              );
            }
          }
          ownFieldNames.add(actualFieldName);

          let isMutable = (fd.mutability != null && fd.mutability == "var") || hasPrivateSetter;
          classType.members[actualFieldName] = new FieldInfo(
            fieldType,
            isMutable,
            false, // isAbstract
            fd.isStatic,
            actualFieldName.length > 0 && actualFieldName.sliceBytes(0, 1) == "#", // isPrivate
            fd.value != null // hasInitializer
          );

          if (fd.isDeclare) {
            let df = classType.declaredFields;
            let dfNonNull = if (df == null) {
              let newSet = new HashSet<String>();
              classType.declaredFields = newSet;
              newSet
            } else {
              df as HashSet<String>
            };
            dfNonNull.add(actualFieldName);
          }

          if (hasPrivateSetter) {
            let getterName = "get#" + fieldName;
            if (!classType.members.has(getterName)) {
              let isPrivate = getterName.length > 0 && getterName.sliceBytes(0, 1) == "#";
              classType.members[getterName] = new MethodInfo(
                new FunctionType(new Array<Type>(), null, fieldType),
                false, // isAbstract
                fd.isStatic,
                isPrivate,
                false // isFinal
              );
            }
          }
        }      }
      case MethodDefinition as md: {
        let methodName = match (md.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };

        if (methodName == "<constructor>") {
          if (cd.caseParams != null && classType.constructorType != null) {
            ctx.error(
              "Duplicate constructor in case class '" + className +
              "'. Case classes auto-generate a constructor from their parameters.",
              DiagnosticCode.DuplicateMethod,
              md.loc
            );
          } else {
            let ctorType = checkMethodSignature(ctx, classType, md);
            ctorType.returnType = classType;
            classType.constructorType = ctorType;
          }
        } else {
          // Regular method.

          // Check for field/method name conflict.
          if (ownFieldNames.has(methodName)) {
            ctx.error(
              "Method '" + methodName + "' conflicts with field '" + methodName + "'.",
              DiagnosticCode.DuplicateDeclaration,
              md.loc
            );
          }

          // Check abstract method in concrete class.
          if (md.isAbstract && !cd.isAbstract && !cd.isSealed) {
            ctx.error(
              "Abstract method '" + methodName + "' can only appear within an abstract class.",
              DiagnosticCode.IncompatibleTypes,
              md.loc
            );
          }

          // Check final method override.
          if (classType.superType != null) {
            let superCt = classType.superType as ClassType;
            if (superCt.members.has(methodName)) {
              let inheritedMethod = superCt.members[methodName];
              match (inheritedMethod) {
                case MethodInfo as mi: {
                  if (mi.isFinal) {
                    ctx.error(
                      "Cannot override final method '" + methodName + "'.",
                      DiagnosticCode.IncompatibleTypes,
                      md.loc
                    );
                  }
                }
                case _: {}
              }
            }
          }

          let methodType = checkMethodSignature(ctx, classType, md);
          if (ownMethodNames.has(methodName)) {
            let existingInfo = classType.members[methodName];
            let existing = existingInfo.type as FunctionType;
            if (existing.overloads == null) {
              let ovArray = new Array<FunctionType>();
              ovArray.push(existing);
              existing.overloads = ovArray;
            }
            let ovs = existing.overloads as Array<FunctionType>;
            ovs.push(methodType);
          } else {
            let isPrivate = methodName.length > 0 && methodName.sliceBytes(0, 1) == "#";
            if (!isPrivate && classType.members.has(methodName) && classType.members[methodName] is MethodInfo) {
              let inheritedMethodInfo = classType.members[methodName] as MethodInfo;
              let superMethod = inheritedMethodInfo.type as FunctionType;
              let matchingSuper = findMatchingOverload(superMethod, methodType);
              if (matchingSuper != null) {
                if (matchingSuper.isFinal) {
                  ctx.error(
                    "Cannot override final method '" + methodName + "'.",
                    DiagnosticCode.IncompatibleTypes,
                    md.loc
                  );
                }

                let newOverloads = new Array<FunctionType>();
                if (!hasSameSignature(superMethod, methodType)) {
                  newOverloads.push(superMethod);
                }
                if (superMethod.overloads != null) {
                  let superOvs = superMethod.overloads as Array<FunctionType>;
                  for (let overload in superOvs) {
                    if (!hasSameSignature(overload, methodType)) {
                      newOverloads.push(overload);
                    }
                  }
                }
                if (newOverloads.length > 0) {
                  methodType.overloads = newOverloads;
                }

                classType.members[methodName] = new MethodInfo(
                  methodType,
                  md.isAbstract,
                  md.isStatic,
                  isPrivate,
                  md.isFinal
                );
                ownMethodNames.add(methodName);
              } else {
                // Overlap restriction (member-lookup.md §5.1): a
                // subclass may not ADD an overload whose parameters
                // overlap an inherited signature — some argument
                // tuple would then select differently through
                // supertype- vs subclass-typed references. Declare
                // overlapping alternatives at the base class and
                // override per-signature instead.
                let inheritedMethod = inheritedMethodInfo.type as FunctionType;
                var overlapsInherited = signaturesMayOverlap(ctx, methodType, inheritedMethod);
                if (!overlapsInherited && inheritedMethod.overloads != null) {
                  let inhOvs = inheritedMethod.overloads as Array<FunctionType>;
                  for (let inh in inhOvs) {
                    if (signaturesMayOverlap(ctx, methodType, inh)) {
                      overlapsInherited = true;
                    }
                  }
                }
                if (overlapsInherited) {
                  ctx.error(
                    "Overload of '" + methodName + "' overlaps an inherited signature; declare overlapping overloads in the base class and override per-signature.",
                    DiagnosticCode.IncompatibleTypes,
                    md.loc
                  );
                }
                if (inheritedMethod.overloads == null) {
                  let ovArray = new Array<FunctionType>();
                  ovArray.push(inheritedMethod);
                  inheritedMethod.overloads = ovArray;
                }
                let ovs = inheritedMethod.overloads as Array<FunctionType>;
                ovs.push(methodType);

                ownMethodNames.add(methodName);
              }
            } else {
              classType.members[methodName] = new MethodInfo(
                methodType,
                md.isAbstract, // isAbstract
                md.isStatic,
                isPrivate,
                md.isFinal
              );
              ownMethodNames.add(methodName);
            }
          }
        }
      }
      case AccessorDeclaration as acc: {
        let accName = match (acc.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };
        let accType = resolveTypeAnnotation(ctx, acc.typeAnnotation);
        
        // Getter creates get#accName method.
        if (acc.getter != null) {
          let getterName = "get#" + accName;
          // Check for final override.
          if (classType.superType != null) {
            let superCt = classType.superType as ClassType;
            if (superCt.members.has(getterName)) {
              let superMethod = superCt.members[getterName];
              match (superMethod) {
                case MethodInfo as mi: {
                  if (mi.isFinal) {
                    ctx.error(
                      "Cannot override final method '" + getterName + "'.",
                      DiagnosticCode.IncompatibleTypes,
                      acc.loc
                    );
                  }
                }
                case _: {}
              }
            }
          }
          let getterType = new FunctionType(new Array<Type>(), null, accType);
          getterType.isFinal = acc.isFinal;
          let isPrivate = getterName.length > 0 && getterName.sliceBytes(0, 1) == "#";
          classType.members[getterName] = new MethodInfo(
            getterType,
            false, // isAbstract
            acc.isStatic,
            isPrivate,
            acc.isFinal
          );
        }

        // Setter creates a method set#accName with param type = accType.
        if (acc.setter != null) {
          let setterName = "set#" + accName;
          // Check for final override.
          if (classType.superType != null) {
            let superCt = classType.superType as ClassType;
            if (superCt.members.has(setterName)) {
              let superMethod = superCt.members[setterName];
              match (superMethod) {
                case MethodInfo as mi: {
                  if (mi.isFinal) {
                    ctx.error(
                      "Cannot override final method '" + setterName + "'.",
                      DiagnosticCode.IncompatibleTypes,
                      acc.loc
                    );
                  }
                }
                case _: {}
              }
            }
          }
          let setterParams = new Array<Type>();
          setterParams.push(accType);
          let setterType = new FunctionType(setterParams, null, new VoidType());
          setterType.isFinal = acc.isFinal;
          let isPrivate = setterName.length > 0 && setterName.sliceBytes(0, 1) == "#";
          classType.members[setterName] = new MethodInfo(
            setterType,
            false, // isAbstract
            acc.isStatic,
            isPrivate,
            acc.isFinal
          );
        }
      }
      case MethodSignature as ms: {
        let methodName = (ms.name as Identifier).name;
        
        if (methodName == "new") {
          if (cd.caseParams != null && classType.constructorType != null) {
            ctx.error(
              "Duplicate constructor in case class '" + className +
              "'. Case classes auto-generate a constructor from their parameters.",
              DiagnosticCode.DuplicateMethod,
              ms.loc
            );
          } else {
            let paramTypes = new Array<Type>();
            let paramNames = new Array<String>();
            var pi = 0;
            while (pi < ms.params.length) {
              let param = ms.params[pi];
              let paramName = param.name.name;
              var paramType: Type = new ErrorType();
              var lookupName = paramName;
              if (classType.fieldSetterNames != null) {
                let m = classType.fieldSetterNames as HashMap<String, String>;
                if (m.has(paramName)) {
                  lookupName = m[paramName];
                }
              }
              if (param.isThisParam && classType.members.has(lookupName)) {
                paramType = classType.members[lookupName].type;
              } else if (param.typeAnnotation != null) {
                paramType = resolveTypeAnnotation(ctx, param.typeAnnotation as TypeAnnotation);
              }
              paramTypes.push(paramType);
              paramNames.push(paramName);
              pi = pi + 1;
            }
            let ctorType = new FunctionType(paramTypes, paramNames, classType);
            classType.constructorType = ctorType;
          }
        } else {
          let paramTypes = new Array<Type>();
          var pi = 0;
          while (pi < ms.params.length) {
            let param = ms.params[pi];
            var paramType: Type = new ErrorType();
            if (param.typeAnnotation != null) {
              paramType = resolveTypeAnnotation(ctx, param.typeAnnotation as TypeAnnotation);
            }
            paramTypes.push(paramType);
            pi = pi + 1;
          }
          var retType: Type = new VoidType();
          if (ms.returnType != null) {
            retType = resolveTypeAnnotation(ctx, ms.returnType as TypeAnnotation, true);
          }
          let isPrivate = methodName.length > 0 && methodName.sliceBytes(0, 1) == "#";
          classType.members[methodName] = new MethodInfo(
            new FunctionType(paramTypes, null, retType),
            false, // isAbstract
            false, // isStatic
            isPrivate,
            false // isFinal
          );
        }
      }
      case _: {}
    }
  }

  // Handle sealed class variants.
  if (cd.isSealed && cd.sealedVariants != null) {
    let variants = cd.sealedVariants as Array<SealedVariant>;
    classType.sealedVariants = new Array<ClassType>();
    for (let variant in variants) {
      let variantName = variant.name.name;

      // Forward-declared variants (null params, like `case Circle, Rect`)
      // are defined as separate classes - skip creating inline types.
      if (variant.params != null) {
        // On-demand: resolveTypeName will materialize from the SealedVariant
        // declaration in scope analysis if this variant was referenced earlier.
        // If not, create a fresh ClassType.
        let existingType = ctx.resolveTypeName(variantName);
        var variantType: ClassType = new ClassType(ctx.freshTypeId(), -1 as SymbolId, variantName);
        if (existingType != null) {
          // Check scope analysis: if the name's declaration is a SealedVariant,
          // the existing type was forward-materialized from this variant — reuse.
          // If it's a ClassDeclaration or other node, it's a name conflict.
          var isForwardVariant = false;
          if (ctx.scopeResult != null) {
            let scopeInfo = ctx.scopeResult.rootScope.resolve(variantName);
            if (scopeInfo?.declaration is SealedVariant) {
              isForwardVariant = true;
            }
          }
          if (isForwardVariant && existingType is ClassType) {
            variantType = existingType as ClassType;
          } else {
            ctx.error(
              "Duplicate declaration of '" + variantName + "' as inline variant. " +
              "The name conflicts with an existing type.",
              DiagnosticCode.DuplicateDeclaration,
              variant.name.loc
            );
          }
        }
        variantType.superType = classType;
        variantType.isCaseClass = true;
        variantType.isFinal = true;

        // Inherit members from parent.
        let parentMemberKeys = classType.members.keys();
        while (let (true, key) = parentMemberKeys.next()) {
          variantType.members[key] = classType.members[key];
        }

        // Process variant parameters as fields + constructor.
        let vParams = variant.params as Array<CaseClassParam>;
        let vCtorParams = new Array<Type>();
        let vCtorNames = new Array<String>();
        let vCtorOptionalParams = new Array<boolean>();
        var vpi = 0;
        while (vpi < vParams.length) {
          let vp = vParams[vpi];
          var vpType = resolveTypeAnnotation(ctx, vp.typeAnnotation);

          if (vp.optional) {
            let unionTypes = new Array<Type>();
            unionTypes.push(vpType);
            unionTypes.push(new NullType());
            vpType = createUnionType(unionTypes);
          }

          let isMut = vp.mutability != null && vp.mutability == "var";
          variantType.members[vp.name.name] = new FieldInfo(vpType, isMut, false, false, false, false);
          vCtorParams.push(vpType);
          vCtorNames.push(vp.name.name);
          vCtorOptionalParams.push(vp.optional);
          vpi = vpi + 1;
        }
        let vCtorType = new FunctionType(
          vCtorParams, vCtorNames, variantType
        );
        vCtorType.optionalParameters = vCtorOptionalParams;
        variantType.constructorType = vCtorType;
        synthesizeCaseClassMembers(ctx, variantType);

        (classType.sealedVariants as Array<ClassType>).push(variantType);

        // Register variant in type and value namespaces (module scope
        // so the name is visible in match patterns outside the class).
        ctx.declareModuleTypeName(variant.name.name, variantType);
        // Also bind the variant type to its Symbol so cross-module
        // import resolution can find the fully-typed ClassType.
        let variantInfo = ctx.model.resolveDeclaration(variant);
        if (variantInfo != null) {
          ctx.declareBinding(variantInfo as Symbol, variantType);
        }
      } else {
        // Forward-declared variant or unit variant (no params).
        // Look up an existing class type (distributed variant pattern),
        // otherwise create an inline unit variant.
        match (ctx.resolveTypeName(variantName)) {
          case ClassType as ct: {
            // If this ClassType was forward-materialized on-demand from a
            // SealedVariant, it won't have superType/constructor yet.
            // Complete it now.
            if (ct.superType == null) {
              ct.superType = classType;
              // Only fully set up unit variants (not forward-declared ones
              // which have their own ClassDeclaration that handles fields).
              var isForwardVariant2 = false;
              if (classType.forwardVariantNames != null) {
                let fvn = classType.forwardVariantNames as HashSet<String>;
                if (fvn.has(variantName)) { isForwardVariant2 = true; }
              }
              if (!isForwardVariant2) {
                ct.isCaseClass = true;
                ct.isFinal = true;
                // Inherit members from parent.
                let pmKeys = classType.members.keys();
                while (let (true, pmk) = pmKeys.next()) {
                  ct.members[pmk] = classType.members[pmk];
                }
                if (ct.constructorType == null) {
                  ct.constructorType = new FunctionType(
                    new Array<Type>(), new Array<String>(), ct
                  );
                }
                synthesizeCaseClassMembers(ctx, ct);
              }
            }
            let sealedVars = classType.sealedVariants as Array<ClassType>;
            sealedVars.push(ct);
          }
          case _: {
            let unitType = new ClassType(ctx.freshTypeId(), -1 as SymbolId, variantName);
            unitType.superType = classType;
            unitType.isCaseClass = true;
            unitType.isFinal = true;

            // Inherit members from parent.
            let parentMemberKeys2 = classType.members.keys();
            while (let (true, key2) = parentMemberKeys2.next()) {
              unitType.members[key2] = classType.members[key2];
            }
            // Unit variant: zero-arg constructor.
            unitType.constructorType = new FunctionType(
              new Array<Type>(), new Array<String>(), unitType
            );
            synthesizeCaseClassMembers(ctx, unitType);

            (classType.sealedVariants as Array<ClassType>).push(unitType);
            ctx.declareModuleTypeName(variantName, unitType);
          }
        }
      }
    }
  }

  if (classType.constructorType == null && classType.superType != null && !classType.isExtension && cd.caseParams == null) {
    let superCtor = (classType.superType as ClassType).constructorType;
    if (superCtor != null) {
      classType.constructorType = superCtor;
    }
  }

  ctx.exitClass();
  ctx.exitScope();
};

/**
 * Check class method bodies, field initializers, accessor bodies, interface
 * conformance, and abstract field/method implementation. Called in Phase 2
 * after all declaration signatures have been registered.
 */
let checkClassBodies = (ctx: CheckerContext, cd: ClassDeclaration): void => {
  let className = cd.name.name;

  // Look up the ClassType registered by registerClassDeclaration.
  var classType: ClassType = new ClassType(ctx.freshTypeId(), -1 as SymbolId, className);
  let resolved = ctx.resolveTypeName(className);
  if (resolved != null) {
    match (resolved as Type) {
      case ClassType as ct: { classType = ct; }
      case _: {}
    }
  }

  // Re-enter scope for type parameters so method bodies can reference them.
  ctx.enterScope();
  if (classType.typeParameters != null) {
    let tps = classType.typeParameters as Array<TypeParameterType>;
    var tpi = 0;
    for (let tp in tps) {
      ctx.declareTypeName(tp.name, tp);
    }
  }

  ctx.enterClass(classType);

  // Check method bodies and field initializers.
  // Collect field names in declaration order for forward-reference detection.
  let fieldOrder = new Array<String>();
  for (let bodyMember in cd.body) {
    match (bodyMember) {
      case FieldDefinition as fd: {
        let fn = match (fd.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };
        fieldOrder.push(fn);
      }
      case _: {}
    }
  }

  var fieldIndex = 0;
  var bi = 0;
  for (let member in cd.body) {
    match (member) {
      case FieldDefinition as fd: {
        if (fd.value != null) {
          ctx.enterNodeReferrer(fd.id as i32);
          let fieldName = match (fd.name) {
            case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
          };

          // Temporarily hide fields declared after this one or inherited from superclasses,
          // so that they cannot be accessed within the field's default initializer.
          let hiddenFields = new HashMap<String, MemberInfo>();
          let keysToHide = new Array<String>();
          
          let allFieldKeys = classType.members.keys();
          while (let (true, k) = allFieldKeys.next()) {
            if (classType.members[k] is FieldInfo) {
              var isPriorLocal = false;
              var fi = 0;
              while (fi <= fieldIndex) {
                if (fieldOrder[fi] == k) {
                  isPriorLocal = true;
                }
                fi = fi + 1;
              }
              if (!isPriorLocal) {
                keysToHide.push(k);
              }
            }
          }
          
          var kh = 0;
          while (kh < keysToHide.length) {
            let k = keysToHide[kh];
            hiddenFields[k] = classType.members[k];
            classType.members.delete(k);
            kh = kh + 1;
          }

          let fieldInfo = classType.members[fieldName];
          let fieldType = fieldInfo.type;
          let initType = checkExpression(ctx, fd.value as Expression, fieldType);

          // Restore hidden fields.
          let restoreKeys = hiddenFields.keys();
          while (let (true, key) = restoreKeys.next()) {
            classType.members[key] = hiddenFields[key];
          }

          // Infer field type from initializer when no explicit annotation.
          if (fieldType is ErrorType && !(initType is ErrorType)) {
            var inferredType = initType;
            if (fd.mutability != null && fd.mutability == "var") {
              inferredType = widenType(ctx, initType);
            }
            fieldInfo.type = inferredType;
          } else if (!isAssignableTo(ctx, initType, fieldType)) {
            ctx.error(
              "Type mismatch: field '" + fieldName + "' has type '" +
              typeToString(fieldType) + "' but initializer has type '" +
              typeToString(initType) + "'.",
              DiagnosticCode.TypeMismatch,
              fd.loc
            );
          } else {
            let instantiatedVal = tryInstantiateGenericFunction(ctx, initType, fieldType);
            if (instantiatedVal != initType) {
              ctx.setNodeType(fd.value as Expression, instantiatedVal);
            }
          }
          ctx.exitNodeReferrer(fd.id as i32);
        }
        fieldIndex = fieldIndex + 1;
      }
      case MethodDefinition as md: {
        if (md.body != null) {
          ctx.enterNodeReferrer(md.id as i32);
          let methodName = match (md.name) {
            case Identifier {name}: name
            case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
              case Identifier {name}: name
              case MemberExpression {property}: property.name
              case _: "<symbol>"
            }
            case _: "<unknown>"
          };
          if (methodName == "<constructor>") {
            if (classType.constructorType != null) {
              checkMethodBody(ctx, classType, classType.constructorType as FunctionType, md);
            }
            // Derived class constructors must call super().
            if (classType.superType != null && md.superInitializer == null && !classType.isCaseClass) {
              ctx.error(
                "Constructors in derived classes must call super().",
                DiagnosticCode.IncompatibleTypes,
                md.loc
              );
            }
          } else {
            if (classType.members.has(methodName)) {
              let methodType = checkMethodSignature(ctx, classType, md);
              checkMethodBody(ctx, classType, methodType, md);
            }
          }
          ctx.exitNodeReferrer(md.id as i32);
        }
      }
      case AccessorDeclaration as acc: {
        let accName = match (acc.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };
        let accType = resolveTypeAnnotation(ctx, acc.typeAnnotation);

        // Check getter body.
        if (acc.getter != null) {
          ctx.enterNodeReferrer(acc.id as i32);
          let getterBlock = acc.getter as BlockStatement;
          ctx.enterScope();
          let prevReturnType = ctx.returnType;
          ctx.setReturnType(accType);
          var gi = 0;
          while (gi < getterBlock.body.length) {
            checkStatement(ctx, getterBlock.body[gi]);
            gi += 1;
          }
          ctx.setReturnType(prevReturnType);
          ctx.exitScope();
          ctx.exitNodeReferrer(acc.id as i32);
        }

        // Check setter body.
        if (acc.setter != null) {
          match (acc.setter as Node) {
            case SetterInfo as si: {
              ctx.enterNodeReferrer(si.id as i32);
              ctx.enterScope();
              let paramInfo = ctx.model.resolveDeclaration(si.param);
              if (paramInfo != null) {
                ctx.declareBinding(paramInfo as Symbol, accType);
              }
              for (let stmt in si.body.body) {
                checkStatement(ctx, stmt);
              }
              ctx.exitScope();
              ctx.exitNodeReferrer(si.id as i32);
            }
            case _: {}
          }
        }
      }
      case _: {}
    }
  }

  // Check interface conformance.
  if (cd.implementsList != null) {
    let implList = cd.implementsList as Array<TypeAnnotation>;
    for (let ifaceAnn in implList) {
      let ifaceType = resolveTypeAnnotation(ctx, ifaceAnn);
      match (ifaceType) {
        case InterfaceType as iface: {
          // Check all interface methods are implemented.
          for (let methodName in iface.members.keys()) {
            let ifaceMethodInfo = iface.members[methodName];
            if (ifaceMethodInfo is MethodInfo) {
              let ifaceMethod = ifaceMethodInfo.type;
              if (classType.members.has(methodName) && classType.members[methodName] is MethodInfo) {
                let classMethodInfo = classType.members[methodName];
                let classMethod = classMethodInfo.type;
                // Check signature compatibility.
                let expectedMethodType0 = substituteTypeParams(iface.typeParameters, iface.typeArguments, ifaceMethod);
                
                var receiverType: Type = classType as Type;
                let tParams = classType.typeParameters;
                if (tParams != null) {
                  if (tParams.length > 0) {
                    let typeArgs = new Array<Type>();
                    for (let tp in tParams) { typeArgs.push(tp as Type); }
                    receiverType = instantiateClassType(classType, typeArgs) as Type;
                  }
                }
                
                let expectedMethodType = substituteThisType(receiverType, expectedMethodType0);
                if (!isAssignableTo(ctx, classMethod, expectedMethodType)) {
                  ctx.error(
                    "Class '" + className + "' incorrectly implements interface '" + iface.name +
                    "': Method '" + methodName + "' is type '" + typeToString(classMethod) +
                    "' but expected '" + typeToString(expectedMethodType) + "'.",
                    DiagnosticCode.IncompatibleTypes,
                    cd.loc
                  );
                }
              } else if (methodName.startsWith("get#") && classType.members.has(methodName.sliceBytes(4, methodName.length)) && classType.members[methodName.sliceBytes(4, methodName.length)] is FieldInfo) {
                // A field can satisfy a getter interface method.
              } else if (methodName.startsWith("set#") && classType.members.has(methodName.sliceBytes(4, methodName.length)) && classType.members[methodName.sliceBytes(4, methodName.length)] is FieldInfo) {
                // A field can satisfy a setter interface method.
              } else {
                ctx.error(
                  "Class '" + className + "' incorrectly implements interface '" + iface.name +
                  "': Method '" + methodName + "' is missing.",
                  DiagnosticCode.IncompatibleTypes,
                  cd.loc
                );
              }
            }
          }
          // Check all interface fields are implemented.
          for (let fieldName in iface.members.keys()) {
            let ifaceFieldInfo = iface.members[fieldName];
            if (ifaceFieldInfo is FieldInfo) {
              // Interface field requires at least a getter.
              let getterName = "get#" + fieldName;
              let hasField = classType.members.has(fieldName) && classType.members[fieldName] is FieldInfo;
              let hasGetter = classType.members.has(getterName) && classType.members[getterName] is MethodInfo;
              if (!hasField && !hasGetter) {
                ctx.error(
                  "Class '" + className + "' incorrectly implements interface '" + iface.name +
                  "': Getter for '" + fieldName + "' is missing.",
                  DiagnosticCode.IncompatibleTypes,
                  cd.loc
                );
              }
            }
          }
        }
        case _: {}
      }
    }
  }

  // A resource class is defined by holding something the GC cannot reclaim,
  // so it always has a release action. `resource` is itself the Disposable
  // conformance — no `implements Disposable` clause is written, following the
  // way case classes nominally implement Hashable — but the member must
  // exist, or implicit drop would have nothing to call and `Own<R>` would
  // mean "unique but never released". See docs/design/ownership.md §Resource.
  if (cd.isResource && !cd.isAbstract) {
    if (!classType.members.has(":dispose")) {
      ctx.error(
        "Resource class '" + className + "' must define ':Disposable.dispose(): void'. " +
        "A resource class always has a release action; a class that needs uniqueness " +
        "but has nothing to release should be an ordinary class used as 'Own<" +
        className + ">'.",
        DiagnosticCode.AbstractMethodNotImplemented,
        cd.loc
      );
    }
  }

  // Check for unimplemented abstract fields in non-abstract classes.
  if (!cd.isAbstract && !cd.isSealed) {
    let fieldKeys = classType.members.keys();
    while (let (true, absName) = fieldKeys.next()) {
      let memberInfo = classType.members[absName];
      if (memberInfo is FieldInfo && memberInfo.isAbstract) {
        ctx.error(
          "Non-abstract class '" + className + "' does not implement abstract field '" + absName + "'.",
          DiagnosticCode.AbstractMethodNotImplemented,
          cd.loc
        );
      }
    }
    // Check for unimplemented abstract methods in non-abstract classes.
    for (let name in classType.members.keys()) {
      let memberInfo = classType.members[name];
      if (memberInfo is MethodInfo && memberInfo.isAbstract) {
        var isSatisfiedByField = false;
        if (name.startsWith("get#")) {
          let fieldName = name.sliceBytes(4, name.length);
          if (classType.members.has(fieldName)) {
            let fieldInfo = classType.members[fieldName];
            if (fieldInfo is FieldInfo && !fieldInfo.isAbstract) {
              isSatisfiedByField = true;
            }
          }
        } else if (name.startsWith("set#")) {
          let fieldName = name.sliceBytes(4, name.length);
          if (classType.members.has(fieldName)) {
            let fieldInfo = classType.members[fieldName];
            if (fieldInfo is FieldInfo && !fieldInfo.isAbstract) {
              isSatisfiedByField = true;
            }
          }
        }
        if (!isSatisfiedByField) {
          ctx.error(
            "Non-abstract class '" + className + "' does not implement abstract method '" + name + "'.",
            DiagnosticCode.AbstractMethodNotImplemented,
            cd.loc
          );
        }
      }
    }
  }

  ctx.exitClass();
  ctx.exitScope();
};

/**
 * Build a FunctionType for a method from its MethodDefinition.
 */
let checkMethodSignature = (
    ctx: CheckerContext,
    classType: ClassType,
    md: MethodDefinition
  ): FunctionType => {
    // Check decorators
    validateFunctionDecorators(ctx, md.decorators, false, md.loc);

    ctx.enterScope();
  let astTypeParameters = md.typeParameters;
  var resolvedTypeParams: Array<TypeParameterType> | null = null;
  if (astTypeParameters != null) {
    let typeParameters = new Array<TypeParameterType>();
    for (let astParam in astTypeParameters) {
      let tpType = ctx.getOrCreateTypeParameter(astParam, null, null);
      typeParameters.push(tpType);
      ctx.declareTypeName(astParam.name, tpType);
      ctx.registerTypeParameter(astParam, tpType);
    }
    resolvedTypeParams = typeParameters;
  }

  let paramTypes = new Array<Type>();
  let paramNames = new Array<String>();
  var hasOptionals = false;
  let optionals = new Array<boolean>();
  var hasInitializers = false;
  let initializers = new Array<Expression | null>();

  var i = 0;
  while (i < md.params.length) {
    let param = md.params[i];
    let paramName = param.name.name;
    var paramType: Type = new ErrorType();
    var lookupName = paramName;
    if (classType != null && classType.fieldSetterNames != null) {
      let m = classType.fieldSetterNames as HashMap<String, String>;
      if (m.has(paramName)) {
        lookupName = m[paramName];
      }
    }
    if (param.isThisParam && classType != null && classType.members.has(lookupName)) {
      // this.-style param inherits type from the class field.
      paramType = classType.members[lookupName].type;
    } else if (param.typeAnnotation != null) {
      paramType = resolveTypeAnnotation(ctx, param.typeAnnotation as TypeAnnotation);
          }

    // Track optional parameters and widen to T | null.
    let isOptional = param.optional || param.defaultValue != null;
    optionals.push(isOptional);

    // Bind parameter type early so subsequent default arguments can reference it.
    let paramInfo = ctx.model.resolveDeclaration(param);
    if (paramInfo != null) {
      ctx.declareBinding(paramInfo as Symbol, paramType);
    }
    if (param.pattern != null) {
      bindPattern(ctx, param.pattern as Pattern, paramType);
    }

    if (param.defaultValue != null) { 
      hasInitializers = true; 
      let initExp = param.defaultValue as Expression;
      let initType = checkExpression(ctx, initExp, paramType);
      if (!isAssignableTo(ctx, initType, paramType)) {
        ctx.error(
          "Type mismatch: default value of type '" + typeToString(initType) +
          "' is not assignable to parameter type '" + typeToString(paramType) + "'.",
          DiagnosticCode.TypeMismatch,
          initExp.loc
        );
      } else {
        let instantiatedVal = tryInstantiateGenericFunction(ctx, initType, paramType);
        if (instantiatedVal != initType) {
          ctx.setNodeType(initExp, instantiatedVal);
        }
      }
    }
    initializers.push(param.defaultValue);
    if (isOptional) {
      hasOptionals = true;
      // Only widen to T | null for ?-style optionals without a default value.
      // Params with default values keep their declared type.
      if (param.optional && param.defaultValue == null) {
        var alreadyNullable = false;
        match (paramType) {
          case NullType: { alreadyNullable = true; }
          case UnionT {types}: {
            var ui = 0;
            while (ui < types.length) {
              if (types[ui] is NullType) { alreadyNullable = true; }
              ui += 1;
            }
          }
          case _: {}
        }
        if (!alreadyNullable) {
          let unionTypes = new Array<Type>();
          unionTypes.push(paramType);
          unionTypes.push(new NullType());
          paramType = createUnionType(unionTypes);
        }
      }
    }

    paramTypes.push(paramType);
    paramNames.push(paramName);
    i += 1;
  }

  var retType: Type = new VoidType();
  if (md.returnType != null) {
    retType = resolveTypeAnnotation(ctx, md.returnType as TypeAnnotation, true);
  }

  // Generator methods: the annotation is the full Iterator<T> return
  // type. Methods do not infer return types, so it is required.
  if (md.isGenerator) {
    if (md.returnType == null) {
      ctx.error(
        "A generator method requires a return type annotation of 'Iterator<T>'.",
        DiagnosticCode.TypeMismatch,
        md.loc
      );
      retType = makeIteratorType(ctx, new ErrorType(), md.loc);
    } else if (extractIteratorYieldType(ctx, retType) == null) {
      ctx.error(
        "A generator's return type must be 'Iterator<T>', got '" +
        typeToString(retType) + "'.",
        DiagnosticCode.TypeMismatch,
        md.loc
      );
      retType = makeIteratorType(ctx, new ErrorType(), md.loc);
    }
  }

  // Async methods: the annotation is the full Future<T> return type.
  if (md.isAsync) {
    // Same as async functions: the transform's failure-capture region
    // needs the exception infrastructure.
    let asyncDeps = ctx.currentDependencies();
    if (asyncDeps != null) {
      asyncDeps.needsExceptionInfra = true;
    }
    if (md.returnType == null) {
      ctx.error(
        "An async method requires a return type annotation of 'Future<T>'.",
        DiagnosticCode.TypeMismatch,
        md.loc
      );
      retType = makeFutureType(ctx, new ErrorType(), md.loc);
    } else if (extractFutureValueType(ctx, retType) == null) {
      ctx.error(
        "An async function's return type must be 'Future<T>', got '" +
        typeToString(retType) + "'.",
        DiagnosticCode.TypeMismatch,
        md.loc
      );
      retType = makeFutureType(ctx, new ErrorType(), md.loc);
    }
  }

  let paramSymbols = new Array<SymbolId>();
  var pi = 0;
  while (pi < md.params.length) {
    let paramInfo = ctx.model.resolveDeclaration(md.params[pi].name);
    if (paramInfo != null) {
      let symId = (paramInfo as Symbol).id;
      // Mark as -1 if the parameter is never actually referenced in subsequent default parameters.
      let isReferenced = new Array<boolean>();
      isReferenced.push(false);
      var pi2 = pi + 1;
      while (pi2 < md.params.length) {
        if (md.params[pi2].defaultValue != null) {
           walkEnter(md.params[pi2].defaultValue as Node, (n: Node): void => {
             if (n is Identifier) {
               let nSym = ctx.model.resolve(n as Identifier);
               if (nSym != null) {
                 if ((nSym as Symbol).id == symId) {
                   isReferenced[0] = true;
                 }
               }
             }
           });
        }
        pi2 += 1;
      }
      if (isReferenced[0]) {
        paramSymbols.push(symId);
      } else {
        paramSymbols.push(-1 as SymbolId);
      }
    } else {
      paramSymbols.push(-1 as SymbolId);
    }
    pi += 1;
  }

  let ft = new FunctionType(paramTypes, paramNames, retType);
  ft.parameterSymbols = paramSymbols;
  ft.typeParameters = resolvedTypeParams;
  ft.isFinal = md.isFinal;
  ft.isAbstract = md.isAbstract;
  if (hasOptionals) {
    ft.optionalParameters = optionals;
  }
  if (hasInitializers) {
    ft.parameterInitializers = initializers;
  }
  ctx.setNodeType(md, ft);
  ctx.exitScope();
  return ft;
};

/**
 * Check a method body: push method scope, declare params, check body.
 */
let checkMethodBody = (
  ctx: CheckerContext,
  classType: ClassType,
  methodType: FunctionType,
  md: MethodDefinition
): void => {
  ctx.enterScope();

  let {typeParameters} = methodType;
  if (typeParameters != null) {
    for (let tpType in typeParameters) {
      ctx.declareTypeName(tpType.name, tpType);
    }
  }

  // Substitute ThisType with the concrete class type for params and return type.
  let effectiveReturnType = substituteThisType(classType as Type, methodType.returnType);

  // Declare parameters.
  var i = 0;
  while (i < md.params.length) {
    let param = md.params[i];
    let paramType = substituteThisType(classType as Type, methodType.parameters[i]);
    let paramInfo = ctx.model.resolveDeclaration(param);
    if (paramInfo != null) {
      ctx.declareBinding(paramInfo as Symbol, paramType);
    }
    // For destructured params, also bind the pattern fields.
    if (param.pattern != null) {
      bindPattern(ctx, param.pattern as Pattern, paramType);
    }
    i += 1;
  }

  // Set expected return type. Generator methods check their body
  // against the yield type (extracted back out of Iterator<T>) with a
  // void return type; async methods check against the Future's value
  // type; everything else checks against the return type.
  let prevReturnType = ctx.returnType;
  let prevYieldType = ctx.yieldType;
  let prevAsyncValue = ctx.asyncValueType;
  let prevAsyncFuture = ctx.asyncFutureType;
  if (md.isGenerator) {
    var yieldT: Type = new ErrorType();
    match (effectiveReturnType) {
      case InterfaceType {typeArguments}: {
        if (typeArguments != null) {
          let args = typeArguments as Array<Type>;
          if (args.length > 0) { yieldT = args[0]; }
        }
      }
      case _: {}
    }
    ctx.setReturnType(new VoidType());
    ctx.setYieldType(yieldT);
    ctx.setAsyncValueType(null);
    ctx.setAsyncFutureType(null);
  } else if (md.isAsync) {
    var valueT: Type = new ErrorType();
    let fv = extractFutureValueType(ctx, effectiveReturnType);
    if (fv != null) {
      valueT = fv as Type;
    }
    ctx.setReturnType(valueT);
    ctx.setYieldType(null);
    ctx.setAsyncValueType(valueT);
    ctx.setAsyncFutureType(effectiveReturnType);
  } else {
    ctx.setReturnType(effectiveReturnType);
    ctx.setYieldType(null);
    ctx.setAsyncValueType(null);
    ctx.setAsyncFutureType(null);
  }

  // Check body.
  match (md.body as Node) {
    case BlockStatement as block: {
      prescanPendingFunctions(ctx, block.body);
      var j = 0;
      while (j < block.body.length) {
        checkStatement(ctx, block.body[j]);
        j = j + 1;
      }
    }
    case Expression as bodyExpr: {
      let bodyType = checkExpression(ctx, bodyExpr, effectiveReturnType);
      if (!isAssignableTo(ctx, bodyType, effectiveReturnType)) {
        ctx.error(
          "Type mismatch: method body returns '" + typeToString(bodyType) +
          "' but expects '" + typeToString(effectiveReturnType) + "'.",
          DiagnosticCode.TypeMismatch,
          md.loc
        );
      }
    }
    case _: {}
  }

  let methodName = match (md.name) {
    case Identifier {name}: name
    case _: ""
  };
  if (methodName == "<constructor>") {
    if (classType.isExtension && !md.isStatic) {
      // An extension-class constructor produces its value solely
      // through super(<underlying value>): required, exactly one
      // argument, assignable to the extended type.
      if (md.superInitializer == null) {
        ctx.error(
          "Extension class constructor must call 'super' with the underlying value.",
          DiagnosticCode.ArgumentCountMismatch,
          md.loc
        );
      } else {
        let superInit = md.superInitializer as SuperInitializer;
        if (superInit.args.length != 1) {
          ctx.error(
            "Extension class constructor must call 'super' with exactly one argument.",
            DiagnosticCode.ArgumentCountMismatch,
            superInit.loc
          );
          for (let arg in superInit.args) {
            checkExpression(ctx, arg, null);
          }
        } else {
          let argType = checkExpression(ctx, superInit.args[0], null);
          if (classType.onType != null &&
              !isAssignableTo(ctx, argType, classType.onType as Type)) {
            ctx.error(
              "Type mismatch in super call: expected " +
              typeToString(classType.onType as Type) + ", got " +
              typeToString(argType),
              DiagnosticCode.TypeMismatch,
              superInit.args[0].loc
            );
          }
        }
      }
    } else if (md.superInitializer != null) {
      let superInit = md.superInitializer as SuperInitializer;
      for (let arg in superInit.args) {
        checkExpression(ctx, arg, null);
      }
    }
    let fieldsInInitializerList = new HashSet<String>();
    if (md.initializerList != null) {
      for (let item in md.initializerList as Array<Node>) {
        if (item is FieldInitializer) {
          let fi = item as FieldInitializer;
          fieldsInInitializerList.add(fi.field.name);
          let fieldName = fi.field.name;
          let fieldType: Type | null = if (classType.members.has(fieldName)) {
            classType.members[fieldName].type
          } else {
            null
          };
          checkExpression(ctx, fi.value, fieldType);
        }
      }
    }
    for (let param in md.params) {
      if (param.isThisParam) {
        let paramName = param.name.name;
        let actualFieldName = if (classType.fieldSetterNames != null && (classType.fieldSetterNames as HashMap<String, String>).has(paramName)) {
          (classType.fieldSetterNames as HashMap<String, String>)[paramName]
        } else {
          paramName
        };
        fieldsInInitializerList.add(actualFieldName);
      }
    }

    // Validate that all non-nullable fields are initialized
    let superType = classType.superType;
    let keys = classType.members.keys();
    while (let (true, fieldName) = keys.next()) {
      let member = classType.members[fieldName];
      if (member is FieldInfo && !fieldName.startsWith(":")) {
        let fd = member as FieldInfo;

        // Skip inherited fields (they're already initialized by superclass)
        var isInherited = false;
        if (superType != null) {
          let st = superType as ClassType;
          if (st.members.has(fieldName) && !fieldName.startsWith("#")) {
            isInherited = true;
          }
        }
        if (isInherited) {
          continue;
        }

        // Skip declared fields (e.g., @intrinsic fields)
        var isDeclared = false;
        if (classType.declaredFields != null && (classType.declaredFields as HashSet<String>).has(fieldName)) {
          isDeclared = true;
        }
        if (classType.genericSource != null) {
          let gs = classType.genericSource as ClassType;
          if (gs.declaredFields != null && (gs.declaredFields as HashSet<String>).has(fieldName)) {
            isDeclared = true;
          }
        }
        if (isDeclared) {
          continue;
        }

        // Skip fields with inline initializers
        if (fd.hasInitializer) {
          continue;
        }

        // Skip fields initialized in the initializer list or via this.field parameters
        if (fieldsInInitializerList.has(fieldName)) {
          continue;
        }

        // Skip nullable fields (they default to null)
        if (isNullableType(fd.type)) {
          continue;
        }

        // Error: non-nullable field without initializer
        ctx.error(
          "Field '" + fieldName + "' must be initialized. Add an initializer or a constructor.",
          DiagnosticCode.UninitializedField,
          md.name.loc
        );
      }
    }
  }

  ctx.setReturnType(prevReturnType);
  ctx.setYieldType(prevYieldType);
  ctx.setAsyncValueType(prevAsyncValue);
  ctx.setAsyncFutureType(prevAsyncFuture);
  ctx.exitScope();
};

/**
 * Check an interface declaration: build an InterfaceType with method/field signatures.
 */
let checkInterfaceDeclaration = (ctx: CheckerContext, id: InterfaceDeclaration): void => {
  let ifaceName = id.name.name;

  // Look up the pre-registered InterfaceType from the forward-declaration pass.
  var ifaceType: InterfaceType = new InterfaceType(ctx.freshTypeId(), -1 as SymbolId, ifaceName);
  let preRegistered = ctx.resolveTypeName(ifaceName);
  if (preRegistered != null) {
    match (preRegistered as Type) {
      case InterfaceType as existing: { ifaceType = existing; }
      case _: {}
    }
  }

  ifaceType.sourcePath = ctx.filePath;

  // Type parameters.
  ctx.enterScope();
  if (id.typeParameters != null) {
    let tps = id.typeParameters as Array<TypeParameter>;
    ifaceType.typeParameters = new Array<TypeParameterType>();
    for (let tp in tps) {
      var constraint: Type | null = null;
      if (tp.constraint != null) {
        constraint = resolveTypeAnnotation(ctx, tp.constraint as TypeAnnotation);
      }
      let tpType = ctx.getOrCreateTypeParameter(tp, constraint, null);
      ctx.declareTypeName(tp.name, tpType);
      (ifaceType.typeParameters as Array<TypeParameterType>).push(tpType);
    }
  }

  // Resolve extends list.
  if (id.extendsList != null) {
    let extends_ = id.extendsList as Array<TypeAnnotation>;
    for (let currentExtends in extends_) {
      let parentType = resolveTypeAnnotation(ctx, currentExtends);
      match (parentType) {
        case InterfaceType as pt: {
          ifaceType.extendsList.push(pt);
          // Inherit members.
          for (let key in pt.members.keys()) {
            if (let (true, parentMember) = pt.members.get(key)) {
              let subType = substituteTypeParams(pt.typeParameters, pt.typeArguments, parentMember.type);
              ifaceType.members[key] = match (parentMember) {
                case FieldInfo as fi: {
                  new FieldInfo(
                    subType,
                    fi.isMutable,
                    fi.isAbstract,
                    fi.isStatic,
                    fi.isPrivate,
                    fi.hasInitializer
                  ) as MemberInfo
                }
                case MethodInfo as mi: {
                  new MethodInfo(
                    subType,
                    mi.isAbstract,
                    mi.isStatic,
                    mi.isPrivate,
                    mi.isFinal
                  ) as MemberInfo
                }
                case _: parentMember
              };
            }
          }
        }
        case _: {}
      }
    }
  }

  // Process body members.
  ctx.enterInterface();
  for (let member in id.body) {
    match (member) {
      case MethodSignature as ms: {
        ctx.enterScope();
        var typeParams: Array<TypeParameterType> | null = null;
        if (ms.typeParameters != null) {
          let tpArr = new Array<TypeParameterType>();
          let tps = ms.typeParameters as Array<TypeParameter>;
          for (let tp in tps) {
            var constraint: Type | null = null;
            if (tp.constraint != null) {
              constraint = resolveTypeAnnotation(ctx, tp.constraint as TypeAnnotation);
            }
            let tpType = ctx.getOrCreateTypeParameter(tp, constraint, null);
            ctx.declareTypeName(tp.name, tpType);
            tpArr.push(tpType);
          }
          typeParams = tpArr;
        }
        let paramTypes = new Array<Type>();
        for (let param in ms.params) {
          var paramType: Type = new ErrorType();
          if (param.typeAnnotation != null) {
            paramType = resolveTypeAnnotation(ctx, param.typeAnnotation as TypeAnnotation);
                      }
          paramTypes.push(paramType);
        }
        var retType: Type = new VoidType();
        if (ms.returnType != null) {
          retType = resolveTypeAnnotation(ctx, ms.returnType as TypeAnnotation, true);
        }
        let methodName = match (ms.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };
        let ft = new FunctionType(paramTypes, null, retType);
        ft.typeParameters = typeParams;
        let isPrivate = methodName.length > 0 && methodName.sliceBytes(0, 1) == "#";
        ifaceType.members[methodName] = new MethodInfo(
          ft,
          true, // isAbstract
          false, // isStatic
          isPrivate,
          false // isFinal
        );
        ctx.exitScope();
      }
      case PropertySignature as ps: {
        let propType = resolveTypeAnnotation(ctx, ps.typeAnnotation);
        let isPrivate = ps.name.name.length > 0 && ps.name.name.sliceBytes(0, 1) == "#";
        ifaceType.members[ps.name.name] = new FieldInfo(
          propType,
          false, // isMutable
          true, // isAbstract
          false, // isStatic
          isPrivate,
          false // hasInitializer
        );
      }
      case FieldDefinition as fd: {
        let fieldName = match (fd.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
         };
        let fieldType = resolveTypeAnnotation(ctx, fd.typeAnnotation as TypeAnnotation);
        let isMutable = fd.mutability != null && fd.mutability == "var";
        let isPrivate = fieldName.length > 0 && fieldName.sliceBytes(0, 1) == "#";
        ifaceType.members[fieldName] = new FieldInfo(
          fieldType,
          isMutable,
          true, // isAbstract
          fd.isStatic,
          isPrivate,
          false // hasInitializer
        );
      }
      case AccessorSignature as as_: {
        let accType = resolveTypeAnnotation(ctx, as_.typeAnnotation);
        if (as_.hasGetter) {
          let getterFt = new FunctionType(new Array<Type>(), null, accType);
          let isPrivate = as_.name.name.length > 0 && as_.name.name.sliceBytes(0, 1) == "#";
          ifaceType.members["get#" + as_.name.name] = new MethodInfo(
            getterFt,
            true, // isAbstract
            false, // isStatic
            isPrivate,
            false // isFinal
          );
        }
      }
      case _: {}
    }
  }
  ctx.exitInterface();

  // Register interface in type namespace.
  ctx.declareTypeName(ifaceName, ifaceType);
  let ifaceInfo = ctx.model.resolveDeclaration(id);
  if (ifaceInfo != null) {
    ctx.declareBinding(ifaceInfo as Symbol, ifaceType);
    ctx.model.addDeclaredInterface((ifaceInfo as Symbol).id, id);
  }

  ctx.exitScope();
};

// ============================================================================
// Enum Declaration
// ============================================================================

// ============================================================================
// Type Alias Declaration
// ============================================================================

let checkTypeAliasDeclaration = (ctx: CheckerContext, ta: TypeAliasDeclaration): void => {
  let tat = ctx.materializeDeclaration(ta, ta.name.name);
  if (tat != null) {
    match (tat as Type) {
      case TypeAliasType as t: {
        ctx.enterScope();
        let {typeParameters} = t;
        if (typeParameters != null) {
          for (let param in typeParameters) {
            ctx.declareTypeName(param.name, param);
          }
        }
        
        t.resolving = true;
        // An alias may name an inline tuple. The alias is a name for the
        // type, not a new position for it: `containsInlineTuple` looks
        // through TypeAliasType, so every use site still reports the
        // restriction after expansion.
        t.target = resolveTypeAnnotation(ctx, ta.typeAnnotation, true);
        checkAliasTargetInlineTuples(ctx, t.target, ta.typeAnnotation.loc);
        t.resolving = false;
        
        ctx.exitScope();
      }
      case _: {}
    }
  }
};

// ============================================================================
// Enum Declaration
// ============================================================================

let checkEnumDeclaration = (ctx: CheckerContext, ed: EnumDeclaration): void => {
  let i32Type = new I32Type();
  let stringType = ctx.resolvePreludeType("String");
  let name = ed.name.name;
  let members = ed.members;
  var isStringEnum = false;

  if (members.length == 0) {
    ctx.error(
      "Enum '" + name + "' must have at least one member.",
      DiagnosticCode.TypeMismatch,
      ed.loc
    );
    // We don't return early so that we still register type and value names for
    // the enum.
  } else {
    // Validate members in a single pass. The first enum member determins the
    // enum type: numeric by default, or based on the initializer.
    isStringEnum = members[0].initializer is StringLiteral;

    if (isStringEnum) {
      for (let member in members) {
        if (member.initializer == null) {
          ctx.error(
            "String enum member '" + member.name.name + "' must have an initializer.",
            DiagnosticCode.TypeMismatch,
            member.loc
          );
        } else {
          let initType = checkExpression(ctx, member.initializer, null);
          if (!(member.initializer is StringLiteral)) {
            ctx.error(
              "Enum member initializer must be a string literal.",
              DiagnosticCode.TypeMismatch,
              member.loc
            );
          }
        }
      }
    } else {
      for (let member in members) {
        if (member.initializer != null) {
          let initType = checkExpression(ctx, member.initializer, null);
          if (!isAssignableTo(ctx, initType, i32Type) || 
              !(member.initializer is NumberLiteral)) {
            ctx.error(
              "Enum member initializer must be an i32 literal.",
              DiagnosticCode.TypeMismatch,
              member.loc
            );
          }
        }
      }
    }
  }

  let strType = if (stringType != null) { stringType as Type } else { new ErrorType() as Type };
  let backingType = if (isStringEnum) { strType } else { i32Type as Type };
  let enumType = new TypeAliasType(name, null, backingType, true, null, false, "");

  // Register the enum in the type namespace.
  ctx.declareTypeName(name, enumType);
  let info2 = ctx.model.resolveDeclaration(ed);
  if (info2 != null) {
    ctx.registerType(info2, enumType as Type);
  }
  // Create a record type for the value namespace (e.g., Color.Red).
  let fields = new HashMap<String, Type>();
  for (let member in members) {
    fields[member.name.name] = enumType;
  }
  let enumValueType = new RecordT(fields, null);
  enumValueType.enumDeclaration = ed;

  // Register the enum value in the value namespace.
  let info = ctx.model.resolveDeclaration(ed);
  if (info != null) {
    ctx.declareBinding(info, enumValueType);
    ctx.model.addDeclaredEnum(info.id, ed);
  }
};

// ============================================================================
// Mixin Declaration
// ============================================================================

let checkMixinDeclaration = (ctx: CheckerContext, md: MixinDeclaration): void => {
  let mixinName = md.name.name;

  // Look up pre-registered MixinType, or create one.
  var mixinType: MixinType = new MixinType(mixinName);
  let preRegistered = ctx.resolveTypeName(mixinName);
  if (preRegistered != null) {
    match (preRegistered as Type) {
      case MixinType as existing: { mixinType = existing; }
      case _: {}
    }
  }

  // Type parameters.
  ctx.enterScope();
  if (md.typeParameters != null) {
    let tps = md.typeParameters as Array<TypeParameter>;
    var resolvedTps = new Array<TypeParameterType>();
    for (let tp in tps) {
      var constraint: Type | null = null;
      if (tp.constraint != null) {
        constraint = resolveTypeAnnotation(ctx, tp.constraint as TypeAnnotation);
      }
      let tpType = ctx.getOrCreateTypeParameter(tp, constraint, null);
      ctx.declareTypeName(tp.name, tpType);
      resolvedTps.push(tpType);
    }
    mixinType.typeParameters = resolvedTps;
  }

  // Resolve 'on' type.
  if (md.on != null) {
    let onTypeId = md.on as TypeAnnotation;
    let onResolved = resolveTypeAnnotation(ctx, onTypeId);
    if (onResolved != null) {
      match (onResolved) {
        case ClassType as onClass: {
          mixinType.onType = onClass;
        }
        case InterfaceType as onIface: {
          mixinType.onType = onIface;
        }
        case _: {
          ctx.error(
            "Mixin 'on' type must be a class or interface, got '" + typeToString(onResolved) + "'.",
            DiagnosticCode.TypeMismatch,
            md.loc
          );
        }
      }
    } else {
      ctx.error(
        "Type not found in 'on' clause.",
        DiagnosticCode.SymbolNotFound,
        md.loc
      );
    }
  }

  // Resolve composed mixins.
  if (md.mixins != null) {
    let mixinAnns = md.mixins as Array<TypeAnnotation>;
    for (let ma in mixinAnns) {
      let composedType = resolveTypeAnnotation(ctx, ma);
      match (composedType) {
        case MixinType as composedMixin: {
          mixinType.mixins.push(composedMixin);
          // Copy members from composed mixin. Composed private FIELDS
          // keep the COMPOSED mixin's private scope key: privacy is
          // lexical to the declaring mixin, so the composing mixin's
          // body cannot see them and applications name their struct
          // fields with the inner mixin's scope.
          for (let key in composedMixin.members.keys()) {
            if (let (true, mInfo) = composedMixin.members.get(key)) {
              var composedKey = key;
              if ((mInfo is FieldInfo || mInfo is MethodInfo) && key.length > 0 &&
                  key.sliceBytes(0, 1) == "#") {
                let scope = (composedMixin.genericSource ?? composedMixin).privateScopeKey;
                composedKey = if (scope != null) {
                  (scope as String) + "::" + key
                } else {
                  composedMixin.name + "_This::" + key
                };
              }
              mixinType.members[composedKey] = mInfo;
            }
          }
        }
        case _: {
          if (!(composedType is ErrorType)) {
            ctx.error(
              "'" + typeToString(composedType) + "' is not a mixin.",
              DiagnosticCode.TypeMismatch,
              md.loc
            );
          }
        }
      }
    }
  }

  // 1. Create a synthetic ClassType for "this" inside the mixin early
  let thisType = new ClassType(ctx.freshTypeId(), -1 as SymbolId, mixinName + "_This");
  // Mixin privates are lexically scoped to the mixin declaration and
  // shared across applications (member-lookup.md §6). This key
  // namespaces the mixin's private FIELDS inside every host class:
  // the checker stores them under "<scopeKey>::#name" at application
  // and codegen names the struct fields identically, so host and
  // mixin same-named privates never collide. Names alone are not
  // unique, so the key is the same identity MixinKey uses — the
  // declaration's name plus its source path — making two same-named
  // mixins from different modules distinct scopes. Every consumer
  // reads the key from the MixinType / This type (never rederives it
  // from the name).
  let mixinScopeKey = mixinName + "_This@" + mixinType.sourcePath;
  thisType.privateScopeKey = mixinScopeKey;
  mixinType.privateScopeKey = mixinScopeKey;
  
  let onType = mixinType.onType;
  if (onType != null) {
    match (baseType(onType)) {
      case ClassType as ct: {
        thisType.superType = onType as ClassType;
        for (let k in ct.members.keys()) {
          if (!k.startsWith("#") && !thisType.members.has(k)) {
            if (let (true, mInfo) = ct.members.get(k)) {
              thisType.members[k] = mInfo;
            }
          }
        }
      }
      case InterfaceType as it: {
        thisType.implementsList.push(onType as InterfaceType);
        for (let k in it.members.keys()) {
          if (!k.startsWith("#") && !thisType.members.has(k)) {
            if (let (true, mInfo) = it.members.get(k)) {
              thisType.members[k] = mInfo;
            }
          }
        }
      }
      case _: {}
    }
  }

  // Populate composed mixin members onto `thisType` as well
  for (let k in mixinType.members.keys()) {
    if (let (true, mInfo) = mixinType.members.get(k)) {
      thisType.members[k] = mInfo;
    }
  }

  // Process body members.
  ctx.enterInterface();
  var b_idx = 0;
  while (b_idx < md.body.length) {
    let member = md.body[b_idx];
    match (member) {
      case FieldDefinition as fd: {
        let fieldName = match (fd.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };
        let fieldType = if (fd.typeAnnotation != null) {
          resolveTypeAnnotation(ctx, fd.typeAnnotation as TypeAnnotation)
        } else {
          new ErrorType() as Type
        };
        let isMutable = fd.mutability != null && fd.mutability == "var";
        let isPrivate = fieldName.length > 0 && fieldName.sliceBytes(0, 1) == "#";
        let fdInfo = new FieldInfo(
          fieldType,
          isMutable,
          fd.isAbstract,
          fd.isStatic,
          isPrivate,
          fd.value != null // hasInitializer
        );
        mixinType.members[fieldName] = fdInfo;
        thisType.members[fieldName] = fdInfo;

        // Check initializer if present.
        if (fd.value != null) {
          let initType = checkExpression(ctx, fd.value as Expression, fieldType);
          if (!isAssignableTo(ctx, initType, fieldType)) {
            ctx.error(
              "Type mismatch: field '" + fieldName + "' has type '" +
              typeToString(fieldType) + "' but initializer has type '" +
              typeToString(initType) + "'.",
              DiagnosticCode.TypeMismatch,
              fd.loc
            );
          }
        }
      }
      case MethodDefinition as methDef: {
        let methodName = match (methDef.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
        };

        // Reject constructors in mixins.
        if (methodName == "<constructor>") {
          ctx.error(
            "Mixins cannot define constructors.",
            DiagnosticCode.IncompatibleTypes,
            methDef.loc
          );
        } else {
          let ft = checkMethodSignature(ctx, thisType, methDef);
          let isPrivate = methodName.length > 0 && methodName.sliceBytes(0, 1) == "#";
          let mi = new MethodInfo(
            ft,
            methDef.isAbstract,
            methDef.isStatic,
            isPrivate,
            methDef.isFinal
          );
          mixinType.members[methodName] = mi;
          thisType.members[methodName] = mi;
        }
      }
      case AccessorDeclaration as acc: {
        let accType = resolveTypeAnnotation(ctx, acc.typeAnnotation);
        let accName = match (acc.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
         };
        let isPrivate = accName.length > 0 && accName.sliceBytes(0, 1) == "#";
        if (isPrivate) {
          // Private accessors register only their get#/set# methods,
          // like class accessors: no bare-name entry (a bare
          // FieldInfo would create a phantom struct field at
          // application, and the bare getter-MethodInfo mistyped
          // reads as '() => T').
          if (acc.getter != null) {
            let getterFt = new FunctionType(new Array<Type>(), null, accType);
            let gi = new MethodInfo(getterFt, false, acc.isStatic, true, acc.isFinal);
            mixinType.members["get#" + accName] = gi;
            thisType.members["get#" + accName] = gi;
          }
          if (acc.setter != null) {
            let setterParams = new Array<Type>();
            setterParams.push(accType);
            let setterFt = new FunctionType(setterParams, null, new VoidType());
            let si = new MethodInfo(setterFt, false, acc.isStatic, true, acc.isFinal);
            mixinType.members["set#" + accName] = si;
            thisType.members["set#" + accName] = si;
          }
        } else {
          let fdInfo = new FieldInfo(
            accType,
            false, // isMutable
            false, // isAbstract
            acc.isStatic,
            isPrivate,
            false // hasInitializer
          );
          mixinType.members[accName] = fdInfo;
          thisType.members[accName] = fdInfo;
          if (acc.getter != null) {
            let getterFt = new FunctionType(new Array<Type>(), null, accType);
            let mi = new MethodInfo(
              getterFt,
              false, // isAbstract
              acc.isStatic,
              isPrivate,
              acc.isFinal
            );
            mixinType.members[accName] = mi;
            thisType.members[accName] = mi;
          }
        }
      }
      case _: {}
    }
    b_idx += 1;
  }
  ctx.exitInterface();

  // Register mixin type early so it's available in model during body checking.
  ctx.declareTypeName(mixinName, mixinType);
  let info = ctx.model.resolveDeclaration(md);
  if (info != null) {
    ctx.declareBinding(info as Symbol, mixinType);
    ctx.model.addDeclaredMixin((info as Symbol).id, md);
  }

  // 2. Check bodies
  ctx.enterClass(thisType);

  var bmi = 0;
  while (bmi < md.body.length) {
    let member = md.body[bmi];
    match (member) {
      case MethodDefinition as methDef: {
        let methodName = match (methDef.name) {
          case Identifier {name}: name
          case SymbolPropertyName {symbolRef}: ":" + match (symbolRef) {
            case Identifier {name}: name
            case MemberExpression {property}: property.name
            case _: "<symbol>"
          }
          case _: "<unknown>"
         };
         if (methodName != "<constructor>" && methDef.body != null && mixinType.members.has(methodName)) {
           if (let (true, methodTypeInfo) = mixinType.members.get(methodName)) {
             ctx.enterNodeReferrer(methDef.id as i32);
             checkMethodBody(ctx, thisType, methodTypeInfo.type as FunctionType, methDef);
             ctx.exitNodeReferrer(methDef.id as i32);
           }
         }
      }
      case AccessorDeclaration as acc: {
        // Mirrors class accessor body checking: getter with the
        // accessor type as return context, setter with its parameter
        // bound to the accessor type.
        let accType = resolveTypeAnnotation(ctx, acc.typeAnnotation);
        if (acc.getter != null) {
          ctx.enterNodeReferrer(acc.id as i32);
          let getterBlock = acc.getter as BlockStatement;
          ctx.enterScope();
          let prevReturnType = ctx.returnType;
          ctx.setReturnType(accType);
          var gi = 0;
          while (gi < getterBlock.body.length) {
            checkStatement(ctx, getterBlock.body[gi]);
            gi += 1;
          }
          ctx.setReturnType(prevReturnType);
          ctx.exitScope();
          ctx.exitNodeReferrer(acc.id as i32);
        }
        if (acc.setter != null) {
          match (acc.setter as Node) {
            case SetterInfo as si: {
              ctx.enterNodeReferrer(si.id as i32);
              ctx.enterScope();
              let paramInfo = ctx.model.resolveDeclaration(si.param);
              if (paramInfo != null) {
                ctx.declareBinding(paramInfo as Symbol, accType);
              }
              for (let stmt in si.body.body) {
                checkStatement(ctx, stmt);
              }
              ctx.exitScope();
              ctx.exitNodeReferrer(si.id as i32);
            }
            case _: {}
          }
        }
      }
      case _: {}
    }
    bmi += 1;
  }

  ctx.exitClass();

  ctx.exitScope();
};




let validateFunctionDecorators = (ctx: CheckerContext, decorators: Array<Decorator> | null, needsIntrinsicOrExternal: boolean, loc: SourceLocation | null): void => {
  var paramCount = 0;
  var hasExternal = false;
  if (decorators != null) {
    let decs = decorators as Array<Decorator>;
    for (let dec in decs) {
      if (dec.name == 'intrinsic') {
        paramCount += 1;
        // isDeclare function check is omitted since it is only allowed on declare functions and methods
        if (false) {
          ctx.error("@intrinsic decorator is only allowed on declare functions and methods.", DiagnosticCode.TypeMismatch, dec.loc);
        }
        if (dec.args.length != 1) {
          ctx.error("Intrinsic decorator must have exactly one argument (the intrinsic name).", DiagnosticCode.TypeMismatch, dec.loc);
        } else {
          let name = dec.args[0].value;
          if (!isValidIntrinsic(name)) {
            ctx.error("Unknown intrinsic '" + name + "'.", DiagnosticCode.TypeMismatch, dec.loc);
          }
        }
      } else if (dec.name == 'external') {
        hasExternal = true;
      }
    }
  }

  if (needsIntrinsicOrExternal) {
    var count = paramCount;
    if (hasExternal) {
      count += 1;
    }
    if (count != 1) {
      ctx.error("A declare function must have exactly one of an @intrinsic or @external decorator.", DiagnosticCode.TypeMismatch, loc);
    }
  } else if (paramCount > 1) {
    ctx.error("A function cannot have more than one @intrinsic decorator.", DiagnosticCode.TypeMismatch, loc);
  }
};

// ============================================================================
// Declare Function (External Declarations)
// ============================================================================


let checkDeclareFunction = (ctx: CheckerContext, df: DeclareFunction): void => {
  // Resolve from annotations (type params, params, return type).
  // DeclareFunction always has full annotations — no body to check.
  ctx.enterScope();

  // Type parameters.
  var resolvedTypeParams: Array<TypeParameterType> | null = null;
  if (df.typeParameters != null) {
    let tps = df.typeParameters as Array<TypeParameter>;
    resolvedTypeParams = new Array<TypeParameterType>();
    var tpi = 0;
    while (tpi < tps.length) {
      let tp = tps[tpi];
      var constraint: Type | null = null;
      if (tp.constraint != null) {
        constraint = resolveTypeAnnotation(ctx, tp.constraint as TypeAnnotation);
      }
      let tpType = ctx.getOrCreateTypeParameter(tp, constraint, null);
      ctx.declareTypeName(tp.name, tpType);
      (resolvedTypeParams as Array<TypeParameterType>).push(tpType);
      tpi += 1;
    }
  }

  // Parameter types.
  let paramTypes = new Array<Type>();
  let paramNames = new Array<String>();
  let optionals = new Array<boolean>();
  let initializers = new Array<Expression | null>();
  var pi = 0;
  while (pi < df.params.length) {
    let param = df.params[pi];
    paramNames.push(param.name.name);
    optionals.push(param.optional || param.defaultValue != null);
    initializers.push(param.defaultValue);
    if (param.typeAnnotation != null) {
      paramTypes.push(resolveTypeAnnotation(ctx, param.typeAnnotation as TypeAnnotation));
    } else {
      paramTypes.push(new ErrorType());
    }
    pi += 1;
  }

  // Return type.
  let retType = resolveTypeAnnotation(ctx, df.returnType, true);

  ctx.exitScope();

  // Build function type.
  let funcType = new FunctionType(paramTypes, paramNames, retType);
  funcType.optionalParameters = optionals;
  funcType.parameterInitializers = initializers;
  if (resolvedTypeParams != null) {
    funcType.typeParameters = resolvedTypeParams;
  }

  // Declare in value namespace.
  let info = ctx.model.resolveDeclaration(df);
  if (info != null) {
    ctx.model.addDeclaredGlobal((info as Symbol).id, df);
    let existingType = ctx.model.getBindingType(info as Symbol);
    if (existingType != null && existingType is FunctionType) {
      let existingFunc = existingType as FunctionType;
      if (existingFunc.overloads == null) {
        let ovArray = new Array<FunctionType>();
        ovArray.push(existingFunc);
        existingFunc.overloads = ovArray;
      }
      let ovs = existingFunc.overloads as Array<FunctionType>;
      ovs.push(funcType);
      ctx.setNodeType(df, funcType);
    } else {
      ctx.declareBinding(info as Symbol, funcType);
      if (info.declaration != df) {
        ctx.setNodeType(df, funcType);
      }
    }
  }

  // Check decorators
  validateFunctionDecorators(ctx, df.decorators, true, df.loc);
};

// ============================================================================
// Symbol Declaration
// ============================================================================

let checkSymbolDeclaration = (ctx: CheckerContext, sd: SymbolDeclaration): void => {
  let name = sd.name.name;

  let symbolType = new SymbolType(ctx.freshTypeId(), name);

  // Declare in value namespace.
  let info = ctx.model.resolveDeclaration(sd);
  if (info != null) {
    ctx.declareBinding(info as Symbol, symbolType);
  }
};

// ============================================================================
// New Expression
// ============================================================================

let checkNewExpression = (
  ctx: CheckerContext,
  newExpr: NewExpression,
  callee: Identifier,
  typeArguments: Array<TypeAnnotation> | null,
  args: Array<Expression>,
  loc: SourceLocation | null
): Type => {
  let className = callee.name;

  // Resolve the class from the type namespace.
  var resolved = ctx.resolveTypeReference(callee, className);
  if (resolved == null) {
    // Try value namespace (might be imported as a value binding).
    let valueResolved = ctx.resolveIdentifier(callee);
    if (valueResolved != null) {
      match (valueResolved as Type) {
        case ClassType as ct: { resolved = ct; }
        case _: {}
      }
    }
  }

  if (resolved == null) {
    ctx.error(
      "Class '" + className + "' not found.",
      DiagnosticCode.SymbolNotFound,
      loc
    );
    return new ErrorType();
  }

  match (resolved as Type) {
    case ClassType as ct: {
      // Cannot instantiate abstract classes.
      if (ct.isAbstract) {
        ctx.error(
          "Cannot instantiate abstract class '" + ct.name + "'.",
          DiagnosticCode.CannotInstantiateAbstractClass,
          loc
        );
      }

      // Closure bodies can be checked more than once. If defaults were already
      // spliced into this node's arguments on an earlier pass, restore the
      // recorded caller-written argument count so the spliced initializers
      // (already checked in the callee's scope at definition time) are not
      // re-checked as caller-supplied arguments.
      let previousOriginal = ctx.splicedArgCountOf(newExpr);
      let callerArgCount = if (previousOriginal != -1 && previousOriginal < args.length) {
        previousOriginal
      } else {
        args.length
      };

      // Instantiate generic class (infers type arguments if not explicit),
      // inferring only from caller-written arguments.
      let inferArgs = if (callerArgCount < args.length) {
        let trimmed = new Array<Expression>();
        var ti = 0;
        while (ti < callerArgCount) { trimmed.push(args[ti]); ti += 1; }
        trimmed
      } else {
        args
      };
      let instantiated = instantiateGenericClass(ctx, ct, typeArguments, inferArgs, loc);

      let ctorType = instantiated.constructorType;
      let deps = ctx.currentDependencies();
      if (deps != null) {
        deps.referencedTypes.add(instantiated as Type);
           deps.referencedClassMethods.add(i32ToString((ct.genericSource ?? ct).symbolId as i32) + ".<constructor>");
      }
      if (ctorType == null) {
        // No explicit constructor — must have zero args.
        if (args.length > 0) {
          ctx.error(
            `Class '${instantiated.name}' has no constructor, but ${args.length} arguments were provided.`,
            DiagnosticCode.ArgumentCountMismatch,
            loc
          );
        }
        return instantiated;
      }

      let ctor = ctorType as FunctionType;

      // Fill in missing arguments with default values
      if (ctor.parameterInitializers != null) {
        var a = args.length;
        while (a < ctor.parameters.length) {
          let init = (ctor.parameterInitializers as Array<Expression | null>)[a];
          if (init != null) {
            let initializer = init as Expression;
            match (initializer) {
              case Identifier {name}: {
                if (name == "__LOCATION__") {
                  if (ctx.emitLocations) {
                    let locStr = if (loc != null) {
                      `${ctx.filePath}:${(loc as SourceLocation).line}`
                    } else {
                      `${ctx.filePath}:0`
                    };
                    args.push(new StringLiteral(locStr, loc));
                  } else {
                    args.push(new NullLiteral(loc));
                  }
                } else {
                  args.push(initializer);
                }
              }
              case _: { args.push(initializer); }
            }
          } else {
            // Optional but no default? Inject null.
            args.push(new NullLiteral(loc));
          }
          a += 1;
        }
      }

      // Record the caller-written argument count so later re-checks of this
      // node don't treat the spliced defaults as caller-supplied arguments.
      // (Runs on re-check passes too, re-seeding the fresh model.)
      if (args.length > callerArgCount) {
        ctx.model.setOriginalArgCount(newExpr, callerArgCount);
      }

      // Check argument count (accounting for optional parameters).
      let expectedCount = ctor.parameters.length;
      var requiredCount = expectedCount;
      if (ctor.optionalParameters != null) {
        let optionals = ctor.optionalParameters as Array<boolean>;
        requiredCount = 0;
        var oi = 0;
        while (oi < optionals.length) {
          if (!optionals[oi]) { requiredCount = requiredCount + 1; }
          oi += 1;
        }
      }
      if (callerArgCount < requiredCount || callerArgCount > expectedCount) {
        let expectedMsg = if (requiredCount == expectedCount) {
          `${expectedCount}`
        } else {
          `${requiredCount}-${expectedCount}`
        };
        ctx.error(
          `Expected ${expectedMsg} arguments, got ${callerArgCount}.`,
          DiagnosticCode.ArgumentCountMismatch,
          loc
        );
      }

      // Check argument types with substituted parameter types. Only check
      // caller-written arguments: spliced defaults were already checked in
      // the callee's scope when the constructor was defined.
      var ai = 0;
      while (ai < callerArgCount && ai < expectedCount) {
        let paramType = ctor.parameters[ai];
        // Substitute type parameters with type arguments.
        let expectedParamType = substituteTypeParams(
          instantiated.typeParameters, instantiated.typeArguments, paramType
        );
        // Args were already checked during inference; just validate here.
        let argType = checkExpression(ctx, args[ai], expectedParamType);
        if (!isAssignableTo(ctx, argType, expectedParamType)) {
          ctx.error(
            "Type mismatch: argument '" + typeToString(argType) +
            "' is not assignable to parameter '" +
            typeToString(expectedParamType) + "'.",
            DiagnosticCode.TypeMismatch,
            loc
          );
        } else {
          let instantiatedVal = tryInstantiateGenericFunction(ctx, argType, expectedParamType);
          if (instantiatedVal != argType) {
            ctx.setNodeType(args[ai], instantiatedVal);
          }
          checkAndRegisterInterfaceAdaptation(ctx, args[ai], instantiatedVal, expectedParamType);
        }
        ai = ai + 1;
      }

      return instantiated;
    }
    case _: {
      ctx.error(
        "'" + className + "' is not a class.",
        DiagnosticCode.NotCallable,
        loc
      );
      return new ErrorType();
    }
  }
};

// ============================================================================
// Member Expression
// ============================================================================

let checkMemberExpression = (
  ctx: CheckerContext,
  expr: MemberExpression,
  object: Expression,
  property: Identifier,
  optional: boolean,
  isSymbolAccess: boolean,
  loc: SourceLocation | null
): Type => {
  let objectTypeRaw = checkExpression(ctx, object, null);
  var objectType = objectTypeRaw;
  if (objectType is ThisType) {
    if (ctx.currentClass != null) {
      objectType = ctx.currentClass as Type;
    }
  }

  var isStatic = false;
  if (object is Identifier) {
    let ident = object as Identifier;
    let sym = ctx.model.resolve(ident);
    if (sym != null) {
      let s = sym as Symbol;
      if (s.declaration is ClassDeclaration) {
        isStatic = true;
      } else if (s.declaration is ImportSpecifier) {
        let spec = s.declaration as ImportSpecifier;
        let importedName = spec.imported.name;
        let deps = ctx.depExports;
        if (deps != null) {
          let depsMap = deps as HashMap<String, ModuleExports>;
          var foundType = false;
          for (let specifier in depsMap.keys()) {
            if (let (true, depMod) = depsMap.get(specifier)) {
              if (let (true, exp) = depMod.get(importedName)) {
                if (exp.isType()) {
                  foundType = true;
                }
              }
            }
          }
          isStatic = foundType;
        }
      }
    }
  }
  ctx.model.setStaticAccess(expr, isStatic);

  let propName = getMemberPropertyName(isSymbolAccess, property.name);

  let pathKey = getMemberPathKeyFromAccess(ctx, object, property, isSymbolAccess);
  let narrowedPathType = if (pathKey != null) {
    ctx.resolveNarrowedMemberPath(pathKey as String)
  } else {
    null
  };

  // Check for private field access outside class
  if (propName.length > 0 && propName.sliceBytes(0, 1) == "#") {
    if (ctx.currentClass == null) {
      ctx.error(
        "Private field '" + propName + "' can only be accessed within a class.",
        DiagnosticCode.PrivateAccess,
        loc
      );
      return new ErrorType();
    }
  }

  // Unwrap union types for optional chaining.
  var receiverType: Type = objectType;
  var isNullable = false;
  match (objectType) {
    case UnionT {types}: {
      // If the union includes null, strip it for the member check.
      let nonNull = new Array<Type>();
      var ui = 0;
      while (ui < types.length) {
        if (types[ui] is NullType) {
          isNullable = true;
        } else {
          nonNull.push(types[ui]);
        }
        ui = ui + 1;
      }
      if (nonNull.length == 1) {
        receiverType = nonNull[0];
      } else if (nonNull.length > 1) {
        receiverType = new UnionT(nonNull);
      }
    }
    case NullType: { isNullable = true; }
    case _: {}
  }

  // Private access is lexical-only (docs/design/member-lookup.md §6):
  // the enclosing class must itself declare the private, and the
  // receiver must be that same lexical class — any specialization of
  // it, since privacy is unaffected by specialization — or a subclass
  // instance, which physically carries the ancestor's private state.
  // Receivers that are not plain class types (type parameters, mixin
  // This) are left to the receiver-side member lookup below.
  if (propName.length > 0 && propName.sliceBytes(0, 1) == "#" &&
      ctx.currentClass != null && !(receiverType is ErrorType)) {
    let cur = ctx.currentClass as ClassType;
    if (!cur.members.has(propName) &&
        !cur.members.has("get#" + propName) &&
        !cur.members.has("set#" + propName)) {
      ctx.error(
        "Property '" + propName + "' does not exist on type '" + cur.name + "'.",
        DiagnosticCode.PropertyNotFound,
        loc
      );
      return new ErrorType();
    }
    if (receiverType is ClassType) {
      // The receiver shares the lexical class when its own class —
      // or any superclass, for subclass instances carrying an
      // ancestor's private state — is a specialization of it.
      let lexicalCanonical = cur.canonical();
      var shares = false;
      var r: ClassType | null = receiverType as ClassType;
      while (r != null && !shares) {
        // Casts: the self-hosted checker does not narrow the loop
        // var through a compound while condition (bootstrap does) —
        // see BUGS.md "no narrowing through compound while".
        if ((r as ClassType).canonical() == lexicalCanonical) {
          shares = true;
        }
        r = (r as ClassType).superType;
      }
      if (!shares) {
        ctx.error(
          "Type '" + typeToString(receiverType) + "' does not have private member '" +
            propName + "' from class '" + cur.name + "'.",
          DiagnosticCode.TypeMismatch,
          loc
        );
        return new ErrorType();
      }
    }
  }

  let resultType = resolveMemberType(ctx, receiverType, propName, loc);

  if (isNullable && !optional) {
    ctx.error(
      "Object may be null when accessing '" + propName + "'.",
      DiagnosticCode.TypeMismatch,
      loc
    );
    return new ErrorType();
  }

  if (narrowedPathType != null) {
    return narrowedPathType as Type;
  }

  // If the original type was nullable and this is optional chaining,
  // wrap the result in a union with null. A boxable-primitive result
  // has no wasm representation for that union, so the chain is only
  // legal as the immediate left operand of `??` — where the miss is
  // the coalesce arm and no `primitive | null` value ever exists.
  if (isNullable && optional) {
    if (isBoxablePrimitive(resultType) &&
        !ctx.nullishSanctioned.has(expr.id as i32)) {
      ctx.error(
        "Optional access to a primitive member requires immediate coalescence: follow it with '?? <default>'.",
        DiagnosticCode.InvalidOperator,
        loc
      );
      return new ErrorType();
    }
    let types = new Array<Type>();
    types.push(resultType);
    types.push(new NullType());
    return createUnionType(types);
  }

  return resultType;
};

/**
 * Look up a member (field or method) on a type.
 */
let resolveMemberType = (
  ctx: CheckerContext,
  objectType: Type,
  propName: String,
  loc: SourceLocation | null
): Type => {
  // Member access forwards through the ownership handles. `Own<R>`,
  // `Borrow<R>` and `Unmanaged<R>` carry no members of their own — they
  // differ in permissions, not data — so `d.read()` on an `Own<Descriptor>`
  // resolves against `Descriptor`. A resource class has no unwrapped form, so
  // forwarding is the only way its members are reachable at all.
  // See docs/design/ownership.md §Handles.
  let handleInner = ownershipHandleInner(objectType);
  if (handleInner != null) {
    return resolveMemberType(ctx, handleInner as Type, propName, loc);
  }

  match (objectType) {
    case ClassType as ct: {
      let deps = ctx.currentDependencies();
      if (deps != null) {
        var classSymId = (ct.genericSource ?? ct).symbolId;
        if (ct.name.length >= 5 && ct.name.sliceBytes(ct.name.length - 5, ct.name.length) == "_This") {
          let mixinName = ct.name.sliceBytes(0, ct.name.length - 5);
          var foundId = -1 as SymbolId;
          let mixinKeys = ctx.model.mixinDeclarations.keys();
          while (let (true, k) = mixinKeys.next()) {
            let decl = ctx.model.mixinDeclarations[k];
            if (decl.name.name == mixinName) {
              foundId = k;
              break;
            }
          }
          if (foundId as i32 != -1) {
            classSymId = foundId;
          } else {
            let classKeys = ctx.model.classDeclarations.keys();
            while (let (true, k) = classKeys.next()) {
              let decl = ctx.model.classDeclarations[k];
              if (decl.name.name == mixinName) {
                foundId = k;
                break;
              }
            }
            if (foundId as i32 != -1) {
              classSymId = foundId;
            }
          }
        }
        deps.referencedSymbols.add(classSymId);
        if (ct.isExtension) {
          deps.referencedTypes.add(ct);
        }
        if (ct.members.has(propName) && ct.members[propName] is MethodInfo) {
          deps.referencedClassMethods.add(i32ToString(classSymId as i32) + "." + propName);
        } else if (ct.members.has(propName) && ct.members[propName] is FieldInfo) {
          let fi = ct.members[propName] as FieldInfo;
          if (ct.isExtension || fi.isAbstract) {
            deps.referencedClassMethods.add(i32ToString(classSymId as i32) + ".get#" + propName);
          }
        } else if (ct.members.has("get#" + propName)) {
          deps.referencedClassMethods.add(i32ToString(classSymId as i32) + ".get#" + propName);
        }
      }
      // Check fields first.
      if (ct.members.has(propName) && ct.members[propName] is FieldInfo) {
        let fieldType = ct.members[propName].type;
        // Substitute type parameters if this is an instantiated generic class.
        let subField = substituteTypeParams(ct.typeParameters, ct.typeArguments, fieldType);
        return substituteThisType(ct as Type, subField);
      }
      // Check methods.
      if (ct.members.has(propName) && ct.members[propName] is MethodInfo) {
        let methodInfo = ct.members[propName];
        let subMethod = substituteTypeParams(ct.typeParameters, ct.typeArguments, methodInfo.type);
        return substituteThisType(ct as Type, subMethod);
      }
      // Check for getter method (get#propName)
      let getterName = "get#" + propName;
      if (ct.members.has(getterName)) {
        let getterInfo = ct.members[getterName];
        // Return the return type of the getter
        let subGetter = substituteTypeParams(ct.typeParameters, ct.typeArguments, (getterInfo.type as FunctionType).returnType);
        return substituteThisType(ct as Type, subGetter);
      }
      ctx.error(
        "Property '" + propName + "' does not exist on type '" + ct.name + "'.",
        DiagnosticCode.PropertyNotFound,
        loc
      );
      return new ErrorType();
    }
    case InterfaceType as it: {
      let deps = ctx.currentDependencies();
      if (deps != null) {
        let ifaceSymId = (it.genericSource ?? it).symbolId;
        deps.referencedSymbols.add(ifaceSymId);
        if (it.members.has(propName) && it.members[propName] is MethodInfo) {
          deps.referencedInterfaceMembers.add(i32ToString(ifaceSymId as i32) + "." + propName);
        } else if (it.members.has(propName) && it.members[propName] is FieldInfo) {
          deps.referencedInterfaceMembers.add(i32ToString(ifaceSymId as i32) + ".get#" + propName);
          let fi = it.members[propName] as FieldInfo;
          if (fi.isMutable) {
            deps.referencedInterfaceMembers.add(i32ToString(ifaceSymId as i32) + ".set#" + propName);
          }
        } else if (it.members.has("get#" + propName)) {
          deps.referencedInterfaceMembers.add(i32ToString(ifaceSymId as i32) + ".get#" + propName);
        }
      }
      if (it.members.has(propName) && it.members[propName] is FieldInfo) {
        let fieldType = it.members[propName].type;
        let subField = substituteTypeParams(it.typeParameters, it.typeArguments, fieldType);
        return substituteThisType(it as Type, subField);
      }
      if (it.members.has(propName) && it.members[propName] is MethodInfo) {
        let methodInfo = it.members[propName];
        // Generic methods have no interface dispatch slot (one slot
        // cannot serve every type argument), so a call through an
        // interface receiver has no implementation strategy yet —
        // codegen used to crash on it. Reject it here until erased
        // dispatch (or a ruling to drop such members) exists. See
        // BUGS.md "Generic interface methods...".
        if (methodInfo.type is FunctionType &&
            (methodInfo.type as FunctionType).typeParameters != null) {
          ctx.error(
            "Generic method '" + propName + "' cannot be called through interface '" +
                it.name + "'; call it on a concrete type instead.",
            DiagnosticCode.NotCallable,
            loc
          );
          return new ErrorType();
        }
        let subMethod = substituteTypeParams(it.typeParameters, it.typeArguments, methodInfo.type);
        return substituteThisType(it as Type, subMethod);
      }
      // Check for getter method
      let getterName = "get#" + propName;
      if (it.members.has(getterName)) {
        let getterInfo = it.members[getterName];
        let subGetter = substituteTypeParams(it.typeParameters, it.typeArguments, (getterInfo.type as FunctionType).returnType);
        return substituteThisType(it as Type, subGetter);
      }
      ctx.error(
        "Property '" + propName + "' does not exist on interface '" + it.name + "'.",
        DiagnosticCode.PropertyNotFound,
        loc
      );
      return new ErrorType();
    }
    case RecordT {properties}: {
      if (properties.has(propName)) {
        return properties[propName];
      }
      ctx.error(
        "Property '" + propName + "' does not exist on record type.",
        DiagnosticCode.PropertyNotFound,
        loc
      );
      return new ErrorType();
    }
    case ArrayType {elementType}: {
      // ArrayType is produced by array literals [1, 2, 3].
      // Delegate to FixedArray<T> prelude type with T = elementType.
      var faType = ctx.resolvePreludeType("FixedArray");
      if (ctx.currentClass != null && (ctx.currentClass as ClassType).name == "FixedArray") {
        faType = ctx.currentClass as Type;
      }
      if (faType != null) {
        match (faType as Type) {
          case ClassType as faCt: {
            let classSymId = (faCt.genericSource ?? faCt).symbolId;
            let deps = ctx.currentDependencies();
            if (deps != null) {
              deps.referencedSymbols.add(classSymId);
              if (faCt.members.has(propName) && faCt.members[propName] is MethodInfo) {
                deps.referencedClassMethods.add(i32ToString(classSymId as i32) + "." + propName);
              } else if (faCt.members.has(propName) && faCt.members[propName] is FieldInfo) {
                let fi = faCt.members[propName] as FieldInfo;
                if (faCt.isExtension || fi.isAbstract) {
                  deps.referencedClassMethods.add(i32ToString(classSymId as i32) + ".get#" + propName);
                }
              } else if (faCt.members.has("get#" + propName)) {
                deps.referencedClassMethods.add(i32ToString(classSymId as i32) + ".get#" + propName);
              }
            }

            // Build type arguments [elementType] for substitution.
            let typeArgs = new Array<Type>();
            typeArgs.push(elementType);
            // Check getter first.
            let getterName = "get#" + propName;
            if (faCt.members.has(getterName)) {
              let getterInfo = faCt.members[getterName];
              return substituteTypeParams(faCt.typeParameters, typeArgs, (getterInfo.type as FunctionType).returnType);
            }
            if (faCt.members.has(propName)) {
              let memberInfo = faCt.members[propName];
              return substituteTypeParams(faCt.typeParameters, typeArgs, memberInfo.type);
            }
          }
          case _: {}
        }
      }
      ctx.error(
        "Property '" + propName + "' does not exist on type 'Array<" + typeToString(elementType) + ">'.",
        DiagnosticCode.PropertyNotFound,
        loc
      );
      return new ErrorType();
    }
    case TypeParameterType {name as tname, constraint}: {
      if (constraint != null) {
        return resolveMemberType(ctx, constraint as Type, propName, loc);
      }
      ctx.error(
        "Property '" + propName + "' does not exist on type '" + tname + "'.",
        DiagnosticCode.PropertyNotFound,
        loc
      );
      return new ErrorType();
    }
    case TypeAliasType as tat: {
      return resolveMemberType(ctx, tat.target, propName, loc);
    }
    case ErrorType: { return new ErrorType(); }
    case _: {
      ctx.error(
        "Property access not supported on type '" + typeToString(objectType) + "'.",
        DiagnosticCode.PropertyNotFound,
        loc
      );
      return new ErrorType();
    }
  }
};

let checkIndexExpression = (
  ctx: CheckerContext,
  object: Expression,
  index: Expression,
  optional: boolean,
  loc: SourceLocation | null,
  node: Node | null = null
): Type => {
  let objectType = checkExpression(ctx, object, null);

  // Handle optional chaining on nullable object.
  var baseType_: Type = objectType;
  var isNullable = false;
  match (objectType) {
    case UnionT {types}: {
      let nonNull = new Array<Type>();
      var ui = 0;
      while (ui < types.length) {
        if (types[ui] is NullType) {
          isNullable = true;
        } else {
          nonNull.push(types[ui]);
        }
        ui = ui + 1;
      }
      if (nonNull.length == 1) {
        baseType_ = nonNull[0];
      } else if (nonNull.length > 1) {
        baseType_ = new UnionT(nonNull);
      }
    }
    case NullType: { isNullable = true; }
    case _: {}
  }

  let resultType = resolveIndexType(ctx, baseType_, index, loc, node);

  if (isNullable && optional) {
    if (isBoxablePrimitive(resultType) && (node == null ||
        !ctx.nullishSanctioned.has((node as Node).id as i32))) {
      ctx.error(
        "Optional access to a primitive element requires immediate coalescence: follow it with '?? <default>'.",
        DiagnosticCode.InvalidOperator,
        loc
      );
      return new ErrorType();
    }
    let types = new Array<Type>();
    types.push(resultType);
    types.push(new NullType());
    return createUnionType(types);
  }

  return resultType;
};

/**
 * Resolve the result type of an index operation.
 */
let resolveIndexType = (
  ctx: CheckerContext,
  objectType: Type,
  index: Expression,
  loc: SourceLocation | null,
  node: Node | null = null
): Type => {
  // Check the index.
  let indexType = checkExpression(ctx, index, null);

  match (objectType) {
    case ArrayType {elementType}: {
      // Check for extension class operator[] on Array types (e.g., FixedArray<T>.operator[](Range))
      let fixedArrayPrelude = ctx.resolvePreludeType("FixedArray");
      if (fixedArrayPrelude != null && fixedArrayPrelude is ClassType) {
        let faCt = fixedArrayPrelude as ClassType;
        let typeArgs = new Array<Type>();
        typeArgs.push(elementType);
        let ct = instantiateClassType(faCt, typeArgs);
        if (ct.members.has("[]")) {
          let opMethodInfo = ct.members["[]"];
          let baseMethod = opMethodInfo.type as FunctionType;
          let candidates = new Array<FunctionType>();
          candidates.push(baseMethod);
          if (baseMethod.overloads != null) {
            let ovs = baseMethod.overloads as Array<FunctionType>;
            var oi = 0;
            while (oi < ovs.length) {
              candidates.push(ovs[oi]);
              oi = oi + 1;
            }
          }
          // Most-specific selection over the applicable candidates
          // (member-lookup.md §5.1).
          let applicableRaw = new Array<FunctionType>();
          let applicableRes = new Array<FunctionType>();
          for (let candidate in candidates) {
            let resolvedCandidate = substituteTypeParams(ct.typeParameters, ct.typeArguments, candidate) as FunctionType;
            if (resolvedCandidate.parameters.length == 1 &&
                isAssignableTo(ctx, indexType, resolvedCandidate.parameters[0])) {
              applicableRaw.push(candidate);
              applicableRes.push(resolvedCandidate);
            }
          }
          if (applicableRaw.length > 0) {
            let selIdx = selectMostSpecificIndex(ctx, applicableRes, 1, loc);
            if (node != null && candidates.length > 1) {
              // Record the subtype-sensitive selection for codegen.
              ctx.model.setResolvedOverload(node as Node, applicableRaw[selIdx]);
            }
            return substituteTypeParams(ct.typeParameters, ct.typeArguments, applicableRaw[selIdx].returnType);
          }
        }
      }

      // Array indexing — index must be i32.
      if (!isIntegerType(indexType)) {
        ctx.error(
          "Array index must be an integer, got '" + typeToString(indexType) + "'.",
          DiagnosticCode.TypeMismatch,
          loc
        );
      }
      return elementType;
    }
    case TupleT {elementTypes}: {
      // Tuple indexing — return specific element type for literal index.
      match (index) {
        case NumberLiteral {raw}: {
          while (let (true, idx) = parseI32(raw)) {
            if (idx >= 0 && idx < elementTypes.length) {
              return elementTypes[idx];
            }
            break;
          }
          ctx.error(
            `Tuple index out of bounds: ${raw} (tuple has ${elementTypes.length} elements).`,
            DiagnosticCode.IndexOutOfBounds,
            loc
          );
          return new ErrorType();
        }
        case _: {
          // Non-literal index — return union of all element types.
          return createUnionType(elementTypes);
        }
      }
    }
    case ClassType as ct: {
      // Check for operator [] method.
      if (ct.members.has("[]")) {
        let deps = ctx.currentDependencies();
        if (deps != null) {
          let classSymId = (ct.genericSource ?? ct).symbolId;
          deps.referencedSymbols.add(classSymId);
          deps.referencedClassMethods.add(i32ToString(classSymId as i32) + ".[]");
        }
        let opMethodInfo = ct.members["[]"];
        let baseMethod = opMethodInfo.type as FunctionType;
        let candidates = new Array<FunctionType>();
        candidates.push(baseMethod);
        if (baseMethod.overloads != null) {
          let ovs = baseMethod.overloads as Array<FunctionType>;
          var oi = 0;
          while (oi < ovs.length) {
            candidates.push(ovs[oi]);
            oi = oi + 1;
          }
        }
        // Most-specific selection over the applicable candidates
        // (member-lookup.md §5.1).
        var selectedMethod = baseMethod;
        let applicableRaw = new Array<FunctionType>();
        let applicableRes = new Array<FunctionType>();
        for (let candidate in candidates) {
          let resolvedCandidate = substituteTypeParams(ct.typeParameters, ct.typeArguments, candidate) as FunctionType;
          if (resolvedCandidate.parameters.length == 1 &&
              isAssignableTo(ctx, indexType, resolvedCandidate.parameters[0])) {
            applicableRaw.push(candidate);
            applicableRes.push(resolvedCandidate);
          }
        }
        let selIdx = selectMostSpecificIndex(ctx, applicableRes, 1, loc);
        if (selIdx >= 0) {
          selectedMethod = applicableRaw[selIdx];
        }
        if (node != null && candidates.length > 1) {
          // Record the subtype-sensitive selection for codegen.
          ctx.model.setResolvedOverload(node as Node, selectedMethod);
        }
        return substituteTypeParams(ct.typeParameters, ct.typeArguments, selectedMethod.returnType);
      }
      ctx.error(
        "Type '" + ct.name + "' does not support indexing (no 'operator []' method).",
        DiagnosticCode.PropertyNotFound,
        loc
      );
      return new ErrorType();
    }
    case InterfaceType as it: {
      if (it.members.has("[]")) {
        let opMethodInfo = it.members["[]"];
        let baseMethod = opMethodInfo.type as FunctionType;
        let candidates = new Array<FunctionType>();
        candidates.push(baseMethod);
        if (baseMethod.overloads != null) {
          let ovs = baseMethod.overloads as Array<FunctionType>;
          var oi = 0;
          while (oi < ovs.length) {
            candidates.push(ovs[oi]);
            oi = oi + 1;
          }
        }
        // Most-specific selection over the applicable candidates
        // (member-lookup.md §5.1).
        var selectedMethod = baseMethod;
        let applicableRaw = new Array<FunctionType>();
        let applicableRes = new Array<FunctionType>();
        for (let candidate in candidates) {
          let resolvedCandidate = substituteTypeParams(it.typeParameters, it.typeArguments, candidate) as FunctionType;
          if (resolvedCandidate.parameters.length == 1 &&
              isAssignableTo(ctx, indexType, resolvedCandidate.parameters[0])) {
            applicableRaw.push(candidate);
            applicableRes.push(resolvedCandidate);
          }
        }
        let selIdx = selectMostSpecificIndex(ctx, applicableRes, 1, loc);
        if (selIdx >= 0) {
          selectedMethod = applicableRaw[selIdx];
        }
        if (node != null && candidates.length > 1) {
          ctx.model.setResolvedOverload(node as Node, selectedMethod);
        }
        return substituteTypeParams(it.typeParameters, it.typeArguments, selectedMethod.returnType);
      }
      ctx.error(
        "Interface '" + it.name + "' does not support indexing (no 'operator []' method).",
        DiagnosticCode.PropertyNotFound,
        loc
      );
      return new ErrorType();
    }
    case ErrorType: { return new ErrorType(); }
    case _: {
      ctx.error(
        "Index access not supported on type '" + typeToString(objectType) + "'.",
        DiagnosticCode.PropertyNotFound,
        loc
      );
      return new ErrorType();
    }
  }
};

let checkBinaryExpression = (
  ctx: CheckerContext,
  expectedType: Type | null,
  operator: String,
  left: Expression,
  right: Expression,
  loc: SourceLocation | null
): Type => {
  // For && and ||, handle short-circuit evaluation and narrowing.
  if (operator == "&&") {
    let leftType = checkExpression(ctx, left, null);
    ctx.enterScope();
    applyTrueNarrowingFromCondition(ctx, left);
    let rightType = checkExpression(ctx, right, null);
    ctx.exitScope();
    // && returns the type of the right operand (if left is truthy).
    return rightType;
  }
  if (operator == "||") {
    let leftType = checkExpression(ctx, left, null);
    ctx.enterScope();
    applyFalseNarrowingFromCondition(ctx, left);
    let rightType = checkExpression(ctx, right, null);
    ctx.exitScope();
    // || returns union of both types.
    let types = new Array<Type>();
    types.push(leftType);
    types.push(rightType);
    return createUnionType(types, ctx, left.loc);
  }

  // Arithmetic operators: +, -, *, /, %
  if (operator == "+" || operator == "-" || operator == "*" ||
      operator == "/" || operator == "%") {
    
    // Determine the contextual type from expectedType (only for numeric context)
    var contextualType: Type | null = null;
    if (expectedType != null && isNumericType(expectedType)) {
      contextualType = expectedType;
    }

    // Check left first with expected context
    let leftType = checkExpression(ctx, left, contextualType);
    let rightContext = if (isNumericType(leftType)) { leftType } else { contextualType };
    let rightType = checkExpression(ctx, right, rightContext);

    // If left is numeric and right was checked without context, re-check
    // right with left's type as context.
    if (isNumericType(leftType) && !isNumericType(rightType)) {
      // Right wasn't numeric — error.
      ctx.error(
        "Type mismatch: cannot apply operator '" + operator + "' to " +
        typeToString(leftType) + " and " + typeToString(rightType),
        DiagnosticCode.InvalidOperator,
        loc
      );
      return new ErrorType();
    }

    if (!isNumericType(leftType)) {
      // Check for operator overloading on class types (e.g., String.+).
      match (leftType) {
        case ClassType as ct: {
          if (ct.members.has(operator)) {
            let deps = ctx.currentDependencies();
            if (deps != null) {
              let classSymId = (ct.genericSource ?? ct).symbolId;
              deps.referencedSymbols.add(classSymId);
              deps.referencedClassMethods.add(i32ToString(classSymId as i32) + "." + operator);
            }
            let methodInfo = ct.members[operator];
            let method = methodInfo.type as FunctionType;
            if (method.parameters.length != 1) {
              ctx.error(
                "Operator '" + operator + "' must take exactly one argument.",
                DiagnosticCode.ArgumentCountMismatch,
                loc
              );
              return new ErrorType();
            }
            if (!isAssignableTo(ctx, rightType, method.parameters[0])) {
              ctx.error(
                "Type mismatch in operator '" + operator + "': expected '" +
                typeToString(method.parameters[0]) + "', got '" + typeToString(rightType) + "'.",
                DiagnosticCode.TypeMismatch,
                loc
              );
              return new ErrorType();
            }
            return method.returnType;
          }
        }
        case _: {}
      }
      ctx.error(
        "Type mismatch: cannot apply operator '" + operator + "' to " +
        typeToString(leftType) + " and " + typeToString(rightType),
        DiagnosticCode.InvalidOperator,
        loc
      );
      return new ErrorType();
    }

    let promoted = promoteNumeric(leftType, rightType);
    if (promoted == null) {
      ctx.error(
        "Type mismatch: cannot apply operator '" + operator + "' to " +
        typeToString(leftType) + " and " + typeToString(rightType),
        DiagnosticCode.InvalidOperator,
        loc
      );
      return new ErrorType();
    }
    // Division always returns a float type.
    if (operator == "/") {
      if (promoted is F64Type || promoted is I64Type || promoted is U64Type) {
        return new F64Type();
      }
      return new F32Type();
    }
    return promoted as Type;
  }

  // Comparison operators: <, <=, >, >=
  if (operator == "<" || operator == "<=" || operator == ">" || operator == ">=") {
    let rightType = checkExpression(ctx, right, null);
    var contextualType: Type | null = null;
    if (isNumericType(rightType)) { contextualType = rightType; }
    let leftType = checkExpression(ctx, left, contextualType);

    if (!isNumericType(leftType) || !isNumericType(rightType)) {
      if (!(leftType is TypeParameterType && rightType is TypeParameterType && isAssignableTo(ctx, leftType, rightType) && isAssignableTo(ctx, rightType, leftType))) {
        ctx.error(
          "Type mismatch: cannot apply operator '" + operator + "' to " +
          typeToString(leftType) + " and " + typeToString(rightType),
          DiagnosticCode.InvalidOperator,
          loc
        );
      }
    } else {
      // Reject mixed signedness (e.g., u32 < i32)
      let promoted = promoteNumeric(leftType, rightType);
      if (promoted == null) {
        ctx.error(
          "Type mismatch: cannot apply operator '" + operator + "' to " +
          typeToString(leftType) + " and " + typeToString(rightType),
          DiagnosticCode.InvalidOperator,
          loc
        );
      }
    }
    return new BooleanType();
  }

  // Equality operators: ==, !=, ===, !==
  if (operator == "==" || operator == "!=" || operator == "===" || operator == "!==") {
    let leftType = checkExpression(ctx, left, null);
    
    // For numeric equality, if left side is a float literal (f32 fallback), 
    // it will be checked with contextualType if expectedType was passed. But ==
    // returns bool, and hasn't been passing contextualType here correctly.
    // Instead we'll pass expectedType=null and do numeric resolution later if they mismatch.
    
    // Check left with null.
    // Check right with leftType as contextual type, but only if it's numeric.
    var rightContext: Type | null = null;
    if (isNumericType(leftType)) {
      rightContext = leftType;
    }
    
    let rightType = checkExpression(ctx, right, rightContext);
    // Validate that types are comparable:
    // - Both boolean: always allowed
    // - Both numeric: always allowed
    // - Both class or interface: always allowed (reference equality)
    // - Otherwise: at least one direction must be assignable
    let typesMatch = (leftType is BooleanType && rightType is BooleanType) ||
      (leftType is BoolLiteralType && (rightType is BooleanType || rightType is BoolLiteralType)) ||
      (rightType is BoolLiteralType && (leftType is BooleanType || leftType is BoolLiteralType)) ||
      (isNumericType(leftType) && isNumericType(rightType)) ||
      (leftType is ClassType && rightType is ClassType) ||
      (leftType is InterfaceType && rightType is InterfaceType) ||
      leftType is NullType || rightType is NullType ||
      leftType is ErrorType || rightType is ErrorType ||
      isAssignableTo(ctx, leftType, rightType) ||
      isAssignableTo(ctx, rightType, leftType);
    if (!typesMatch) {
      ctx.error(
        "Type mismatch: cannot apply operator '" + operator + "' to '" +
        typeToString(leftType) + "' and '" + typeToString(rightType) + "'.",
        DiagnosticCode.TypeMismatch,
        loc
      );
    }
    return new BooleanType();
  }

  // Bitwise operators: &, |, ^, <<, >>, >>>
  if (operator == "&" || operator == "|" || operator == "^" ||
      operator == "<<" || operator == ">>" || operator == ">>>") {
    let leftType = checkExpression(ctx, left, null);
    let rightType = checkExpression(ctx, right, leftType);

    if (!isIntegerType(leftType) || !isIntegerType(rightType)) {
      ctx.error(
        "Operator '" + operator + "' cannot be applied to type '" +
        typeToString(leftType) + "' and '" + typeToString(rightType) + "'.",
        DiagnosticCode.InvalidOperator,
        loc
      );
    }

    let promoted = promoteNumeric(leftType, rightType);
    if (promoted != null) { return promoted as Type; }
    return leftType;
  }

  // Null coalescing operator: ??
  // Returns the left operand if not null, otherwise the right operand.
  // Type is the union of (non-null left type) and right type, or just right type
  // if left is definitely nullable.
  if (operator == "??") {
    // The immediate left operand may be a primitive-yielding optional
    // chain: sanction exactly this node before typing it (see
    // CheckerContext.nullishSanctioned).
    ctx.nullishSanctioned.add(left.id as i32);
    let leftType = checkExpression(ctx, left, null);
    let rightType = checkExpression(ctx, right, null);

    // Extract non-null part of left type.
    // For T | null, result is T | rightType (simplified to rightType if T = rightType).
    match (leftType) {
      case UnionT as u: {
        // Filter out null from union members.
        let nonNullMembers = new Array<Type>();
        let members = u.types;
        var i = 0;
        while (i < members.length) {
          match (members[i]) {
            case NullType: {}
            case _: { nonNullMembers.push(members[i]); }
          }
          i += 1;
        }
        // Result type: union of non-null left members with right type.
        nonNullMembers.push(rightType);
        return createUnionType(nonNullMembers, ctx, left.loc);
      }
      case NullType: {
        // Left is just null, result is right type.
        ctx.warning(
          "Left operand of '??' is always null and will never be returned.",
          DiagnosticCode.UnnecessaryNullish,
          loc
        );
        return rightType;
      }
      case _: {
        // Left is not nullable, ?? is redundant but valid. Return left type.
        ctx.warning(
          "Left operand of '??' is not nullable and will always be returned.",
          DiagnosticCode.UnnecessaryNullish,
          loc
        );
        return leftType;
      }
    }
  }

  ctx.error(
    "Unknown operator '" + operator + "'.",
    DiagnosticCode.InvalidOperator,
    loc
  );
  return new ErrorType();
};

/**
 * Collect all concrete (non-sealed) leaf variants of a sealed class type,
 * recursing into sub-sealed variants (sum of sums).
 */
let collectLeafVariants = (ct: ClassType): Array<ClassType> => {
  let result = new Array<ClassType>();
  if (ct.sealedVariants == null) { return result; }
  let variants = ct.sealedVariants as Array<ClassType>;
  var i = 0;
  while (i < variants.length) {
    let v = variants[i];
    if (v.isSealed && v.sealedVariants != null) {
      // Recurse: this variant is itself sealed
      let leaves = collectLeafVariants(v);
      var li = 0;
      while (li < leaves.length) {
        result.push(leaves[li]);
        li += 1;
      }
    } else {
      result.push(v);
    }
    i += 1;
  }
  return result;
};

/**
 * Returns true if a type has a finite, enumerable set of values that can be
 * fully covered by match patterns (sealed classes, booleans, literal types).
 */
let isFiniteType = (t: Type): boolean => {
  return match (t) {
    case BooleanType: true
    case BoolLiteralType: true
    case StringLiteralType: true
    case NullType: true
    case ClassType as ct: ct.isSealed
    case UnionT {types}: {
      var allFinite = true;
      var i = 0;
      while (i < types.length) {
        if (!isFiniteType(types[i])) { allFinite = false; }
        i += 1;
      }
      allFinite
    }
    case _: false
  };
};

/**
 * Subtract a pattern from a type, returning the remaining uncovered type.
 * Returns NeverType when the pattern fully covers the type.
 */
let subtractPatternFromType = (ctx: CheckerContext, t: Type, pattern: Node): Type => {
  // Wildcard or variable pattern covers everything.
  match (pattern) {
    case IdentifierPattern {name}: {
      if (name == "_") {
        return new NeverType();
      }
      // Check if this identifier names a sealed variant (unit variant pattern).
      let resolved = ctx.resolveTypeName(name);
      if (resolved != null) {
        match (resolved as Type) {
          case ClassType as patClass: {
            return subtractClassFromType(ctx, t, patClass);
          }
          case _: {}
        }
      }
      // Regular variable binding — covers everything.
      return new NeverType();
    }
    case Identifier {name}: {
      // Plain identifier in match pattern (e.g., case _, case Red).
      if (name == "_") {
        return new NeverType();
      }
      // Check if this identifier names a sealed variant (unit variant pattern).
      let resolved = ctx.resolveTypeName(name);
      if (resolved != null) {
        match (resolved as Type) {
          case ClassType as patClass: {
            return subtractClassFromType(ctx, t, patClass);
          }
          case _: {}
        }
      }
      // Regular variable binding — covers everything.
      return new NeverType();
    }
    case ClassPattern as cp: {
      let clsName = cp.name.name;
      let resolved = ctx.resolveTypeName(clsName);
      if (resolved != null) {
        match (resolved as Type) {
          case ClassType as patClass: {
            return subtractClassFromType(ctx, t, patClass);
          }
          case _: {}
        }
      }
      return t;
    }
    case AsPattern as ap: {
      return subtractPatternFromType(ctx, t, ap.pattern);
    }
    case BindingPattern as bp: {
      // `case let Leaf {size}: …` — the binding prefix doesn't change
      // what the inner pattern covers.
      return subtractPatternFromType(ctx, t, bp.pattern);
    }
    case BooleanLiteral {value}: {
      // Subtract the specific boolean literal from the remaining type.
      let lit: Type = new BoolLiteralType(value);
      match (t) {
        case BooleanType: {
          // BooleanType = true | false. Subtracting one literal leaves the other.
          if (value) {
            return new BoolLiteralType(false);
          } else {
            return new BoolLiteralType(true);
          }
        }
        case _: {
          return subtractTypeFromUnion(t, lit);
        }
      }
    }
    case StringLiteral {value}: {
      // Subtract the specific string literal from the remaining type.
      let lit: Type = new StringLiteralType(value);
      return subtractTypeFromUnion(t, lit);
    }
    case NumberLiteral {}: {
      // Number literal patterns: no subtraction (no numeric literal types yet).
      return t;
    }
    case NullLiteral {}: {
      return subtractNullFromType(t);
    }
    case _: {
      // Literal patterns, etc. — don't subtract from sealed types for now.
      return t;
    }
  }
};

/**
 * Subtract a class type (from a pattern) from the scrutinee type.
 * Handles sealed class variant tracking and transitive hierarchies.
 */
let subtractClassFromType = (ctx: CheckerContext, t: Type, patClass: ClassType): Type => {
  match (t) {
    case ClassType as scrutClass: {
      // If the pattern class IS the scrutinee class (or a supertype), covers it.
      if (scrutClass.id == patClass.id) {
        return new NeverType();
      }
      // If the scrutinee is a sealed class, subtract the variant from its set.
      if (scrutClass.isSealed && scrutClass.sealedVariants != null) {
        let variants = scrutClass.sealedVariants as Array<ClassType>;
        let remaining = new Array<ClassType>();
        var i = 0;
        while (i < variants.length) {
          let v = variants[i];
          if (v.id == patClass.id) {
            // Directly matched — don't add to remaining.
          } else if (v.isSealed && v.sealedVariants != null) {
            // Variant is itself sealed — recurse into its sub-variants.
            let subResult = subtractClassFromType(ctx, v, patClass);
            match (subResult) {
              case NeverType: {
                // Fully covered — don't add to remaining.
              }
              case ClassType as remainingVariant: {
                remaining.push(remainingVariant);
              }
              case _: {
                remaining.push(v);
              }
            }
          } else {
            // Check if patClass is a subtype of this variant.
            var isSubtype = false;
            var current: ClassType | null = patClass.superType;
            while (current != null) {
              let cur = current as ClassType;
              if (cur.id == v.id) {
                isSubtype = true;
                break;
              }
              current = cur.superType;
            }
            if (!isSubtype) {
              remaining.push(v);
            }
          }
          i += 1;
        }
        if (remaining.length == 0) {
          return new NeverType();
        }
        // Return a synthetic sealed type with remaining variants.
        let remainingType = new ClassType(scrutClass.id, scrutClass.symbolId, scrutClass.name);
        remainingType.isSealed = true;
        remainingType.isAbstract = true;
        remainingType.superType = scrutClass.superType;
        remainingType.sealedVariants = remaining;
        return remainingType;
      }
    }
    case _: {}
  }
  return t;
};

/**
 * Look up a field type on a class or interface type for pattern destructuring.
 * Returns ErrorType if the field is not found.
 */
let resolveClassFieldType = (
  ctx: CheckerContext,
  classType: Type,
  propName: String,
  loc: SourceLocation | null
): Type => {
  match (classType) {
    case ClassType as ct: {
      if (ct.members.has(propName) && ct.members[propName] is FieldInfo) {
        return substituteTypeParams(ct.typeParameters, ct.typeArguments, ct.members[propName].type);
      }
      // Check for getter.
      let getterName = "get#" + propName;
      if (ct.members.has(getterName)) {
        let getterInfo = ct.members[getterName];
        return substituteTypeParams(ct.typeParameters, ct.typeArguments, (getterInfo.type as FunctionType).returnType);
      }
      // Walk superclass.
      if (ct.superType != null) {
        return resolveClassFieldType(ctx, ct.superType as Type, propName, loc);
      }
      ctx.error(
        "Property '" + propName + "' does not exist on type '" + ct.name + "'.",
        DiagnosticCode.PropertyNotFound,
        loc
      );
      return new ErrorType();
    }
    case _: {
      return new ErrorType();
    }
  }
};

let getNarrowedTypeFromPattern = (ctx: CheckerContext, pattern: Node): Type | null => {
  match (pattern) {
    case ClassPattern as cp: {
      return ctx.model.getNodeType(cp);
    }
    case AsPattern as ap: {
      return getNarrowedTypeFromPattern(ctx, ap.pattern);
    }
    case IdentifierPattern as id: {
      if (id.name == "_") {
        return null;
      }
      let resolved = ctx.resolveTypeName(id.name);
      if (resolved != null) {
        return resolved;
      }
      return ctx.model.getNodeType(id);
    }
    case Identifier as id: {
      if (id.name == "_") {
        return null;
      }
      let resolved = ctx.resolveTypeName(id.name);
      if (resolved != null) {
        return resolved;
      }
      return ctx.model.getNodeType(id);
    }
    case _: {
      return null;
    }
  }
};

/**
 * Check a match expression: discriminant against patterns, return union of case body types.
 * Also checks exhaustiveness for sealed class discriminants.
 */
let checkMatchExpr = (
  ctx: CheckerContext,
  discriminant: Expression,
  cases: Array<MatchCase>,
  loc: SourceLocation | null,
  expectedType: Type | null
): Type => {
  // Check the discriminant expression.
  let scrutineeType = checkExpression(ctx, discriminant, null);

  // Track remaining type for exhaustiveness checking.
  var remainingType: Type = scrutineeType;

  // Collect result types from each case.
  let resultTypes = new Array<Type>();
  
  // Track matched pattern types for ambiguity detection.
  let matchedTypes = new Array<Type>();

  var i = 0;
  while (i < cases.length) {
    let matchCase = cases[i];

    // Check for unreachable case: if remaining type is Never, nothing can reach this case.
    if (remainingType is NeverType) {
      ctx.error(
        "Unreachable case.",
        DiagnosticCode.TypeMismatch,
        matchCase.loc
      );
    }

    // Enter a new scope for pattern bindings.
    ctx.enterScope();

    // Check the pattern and bind variables. Pass remainingType (not scrutineeType) so
    // catch-all identifier bindings get the type narrowed by the earlier arms.
    checkPattern(ctx, matchCase.pattern, remainingType);

    let discPath = getMemberPathKey(ctx, discriminant);
    let isImmutableDisc = discriminant is Identifier || (discriminant is MemberExpression && isImmutableMemberPath(ctx, discriminant));
    if (discPath != null && isImmutableDisc) {
      let narrowedType = getNarrowedTypeFromPattern(ctx, matchCase.pattern);
      if (narrowedType != null) {
        ctx.narrowMemberPath(discPath as String, narrowedType as Type);
      }
    }

    // Get pattern type for ambiguity detection.
    var patternType: Type | null = null;
    match (matchCase.pattern) {
      case ClassPattern as cp: {
        let clsName = cp.name.name;
        let classType = ctx.resolveTypeName(clsName);
        if (classType != null) {
          patternType = classType as Type;
        }
      }
      case Identifier as ident: {
        let classType = ctx.resolveTypeName(ident.name);
        if (classType != null) {
          match (classType as Type) {
            case ClassType: {
              patternType = classType as Type;
            }
            case _: {}
          }
        }
      }
      case _: {}
    }

    // Check for ambiguous extension types.
    if (patternType != null) {
      var pi = 0;
      while (pi < matchedTypes.length) {
        let prev = matchedTypes[pi];

        var ext1: ClassType | null = null;
        var ext2: ClassType | null = null;

        match (patternType) {
          case ClassType as ct: {
            if (ct.isExtension && ct.onType != null) {
              ext1 = ct;
            }
          }
          case _: {}
        }

        match (prev) {
          case ClassType as ct: {
            if (ct.isExtension && ct.onType != null) {
              ext2 = ct;
            }
          }
          case _: {}
        }

        if (ext1 != null) {
          if (ext2 != null) {
            let onType1 = ext1.onType;
            let onType2 = ext2.onType;
            if (onType1 != null && onType2 != null) {
              if (isAssignableTo(ctx, onType1 as Type, onType2 as Type) && isAssignableTo(ctx, onType2 as Type, onType1 as Type)) {
                ctx.error(
                  "Ambiguous match case: '" + typeToString(patternType) + "' and '" +
                  typeToString(prev) + "' extend the same underlying type and are indistinguishable at runtime.",
                  DiagnosticCode.TypeMismatch,
                  matchCase.loc
                );
              }
            }
          }
        }

        pi = pi + 1;
      }
      matchedTypes.push(patternType);
    }

    // Update remaining type (only if no guard — guards prevent exhaustiveness).
    if (matchCase.guard == null) {
      remainingType = subtractPatternFromType(ctx, remainingType, matchCase.pattern);
    }

    // Check the guard if present.
    if (matchCase.guard != null) {
      let guardType = checkExpression(ctx, matchCase.guard as Expression, null);
      if (!isBooleanLike(guardType)) {
        ctx.error(
          "Match guard must be a boolean expression.",
          DiagnosticCode.TypeMismatch,
          matchCase.loc
        );
      }
    }

    // Check the body and collect its type.
    let bodyType = checkMatchCaseBody(ctx, matchCase.body, expectedType);
    resultTypes.push(bodyType);

    ctx.exitScope();
    i += 1;
  }

  // Check exhaustiveness: if the scrutinee is a finite type (sealed class,
  // boolean, literal union, etc.) and remainingType is not Never, report error.
  if (isFiniteType(scrutineeType) && !(remainingType is NeverType)) {
    ctx.error(
      "Non-exhaustive match. Not all cases are covered.",
      DiagnosticCode.TypeMismatch,
      loc
    );
  }

  // Result is union of all case body types.
  if (expectedType != null && expectedType is VoidType) {
    return new VoidType();
  }
  if (resultTypes.length == 0) {
    return new NeverType();
  }
  if (resultTypes.length == 1) {
    return resultTypes[0];
  }
  return combineArmTypes(resultTypes, ctx, loc);
};

/**
 * Check the body of a match case (expression or block) and return its type.
 */
let checkMatchCaseBody = (ctx: CheckerContext, body: Node, expectedType: Type | null): Type => {
  match (body) {
    case BlockStatement as block: {
      // Execute statements; need to track return type.
      let stmts = block.body;
      prescanPendingFunctions(ctx, stmts);
      var lastType: Type = new VoidType();
      var si = 0;
      while (si < stmts.length) {
        let isLast = si == stmts.length - 1;
        let et = if (isLast) { expectedType } else { new VoidType() as Type };
        match (stmts[si]) {
          case ExpressionStatement {expression}: {
            lastType = checkExpression(ctx, expression, et);
          }
          case ReturnStatement {argument}: {
            if (argument != null) {
              checkExpression(ctx, argument as Expression, ctx.returnType);
            }
            // The value leaves the function, it does not flow to the
            // enclosing match/try expression — which therefore gets no
            // value from this arm at all. `never`, exactly like an arm
            // ending in `throw`.
            lastType = new NeverType();
          }
          case _: {
            checkStatement(ctx, stmts[si]);
            lastType = if (branchDefinitelyExits(stmts[si])) {
              new NeverType() as Type
            } else {
              new VoidType() as Type
            };
          }
        }
        si = si + 1;
      }
      return lastType;
    }
    case _: {
      // Expression body.
      return checkExpression(ctx, body as Expression, expectedType);
    }
  }
};

/**
 * Levenshtein edit distance, used only to suggest a correction for a name that
 * failed to resolve. Byte-wise, which is exact for the ASCII identifiers this
 * is called with.
 */
let editDistance = (a: String, b: String): i32 => {
  let n = a.length;
  let m = b.length;
  if (n == 0) { return m; }
  if (m == 0) { return n; }
  let prev = new Array<i32>(m + 1);
  let curr = new Array<i32>(m + 1);
  var j = 0;
  while (j <= m) {
    prev.push(j);
    curr.push(0);
    j += 1;
  }
  var i = 1;
  while (i <= n) {
    curr[0] = i;
    var k = 1;
    while (k <= m) {
      let cost = if (a.getByteAt(i - 1) == b.getByteAt(k - 1)) { 0 } else { 1 };
      var best = prev[k] + 1;
      let insertion = curr[k - 1] + 1;
      if (insertion < best) { best = insertion; }
      let substitution = prev[k - 1] + cost;
      if (substitution < best) { best = substitution; }
      curr[k] = best;
      k += 1;
    }
    var c = 0;
    while (c <= m) {
      prev[c] = curr[c];
      c += 1;
    }
    i += 1;
  }
  return prev[m];
};

/**
 * Names a bare identifier pattern plausibly meant, given the type being
 * matched: the type's own name plus, for a sealed class, its variants.
 * Unions contribute the candidates of each member.
 */
let collectPatternNameCandidates = (t: Type, out: Array<String>): void => {
  match (t) {
    case ClassType as ct: {
      out.push(ct.name);
      let variants = ct.sealedVariants;
      if (variants != null) {
        for (let variant in variants as Array<ClassType>) {
          out.push(variant.name);
        }
      }
    }
    case UnionT {types}: {
      for (let member in types) {
        collectPatternNameCandidates(member, out);
      }
    }
    case _: {}
  }
};

/**
 * The diagnostic for a bare identifier in a pattern that names no class.
 * Suggests the closest variant of the scrutinee when there is a near miss —
 * this error exists to catch mistyped variant names, so the suggestion is the
 * whole point.
 *
 * @param namesNonClassType True when the identifier resolved to a type that
 *   just isn't a class (a primitive, an alias); the advice differs from a name
 *   that resolved to nothing at all.
 */
let unresolvedPatternNameMessage = (
  name: String,
  expectedType: Type,
  namesNonClassType: boolean
): String => {
  if (namesNonClassType) {
    return "'" + name + "' names a type, but only classes can be matched by name. " +
      "Write 'let " + name + "' to bind the matched value to a new variable.";
  }
  let candidates = new Array<String>(8);
  collectPatternNameCandidates(expectedType, candidates);
  var closest: String | null = null;
  var closestDistance = 0;
  for (let candidate in candidates) {
    let distance = editDistance(name.asciiLowerCase(), candidate.asciiLowerCase());
    if (closest == null || distance < closestDistance) {
      closest = candidate;
      closestDistance = distance;
    }
  }
  // Allow one edit per three characters, at least one, so short names don't
  // suggest an unrelated variant.
  var threshold = name.length / 3;
  if (threshold < 1) { threshold = 1; }
  if (threshold > 3) { threshold = 3; }
  var suggestion = "";
  if (closest != null && closestDistance <= threshold) {
    suggestion = " Did you mean '" + (closest as String) + "'?";
  }
  return "'" + name + "' does not name a class, so it cannot be used as a pattern." +
    suggestion +
    " Write 'let " + name + "' to bind the matched value to a new variable.";
};

/**
 * Check a pattern against an expected type and bind pattern variables.
 * Uses bindPattern for identifier bindings through the DeclarationMap → Symbol path.
 *
 * @param expectedType The type to match against. For top-level match arms this is the
 *   remaining scrutinee type after earlier arms have been subtracted, so an explicit
 *   catch-all binding (`case let b:`) gets the narrowed type automatically. For nested
 *   patterns (class fields, tuple elements, etc.) it is the field/element type.
 */
let checkPattern = (ctx: CheckerContext, pattern: Node, expectedType: Type): void => {
  match (pattern) {
    case BindingPattern as bp: {
      checkPattern(ctx, bp.pattern, expectedType);
    }
    case IdentifierPattern as pat: {
      if (pat.name != "_") {
        // Use the same binding mechanism as variable declarations.
        let info = ctx.model.resolveDeclaration(pat);
        if (info != null) {
          ctx.declareBinding(info as Symbol, expectedType);
        } else {
          // Fallback: register in type scope.
          ctx.declareTypeName(pat.name, expectedType);
        }
      }
    }
    case ClassPattern as cp: {
      // Look up the class type.
      let clsName = cp.name.name;
      let classType = ctx.resolveTypeName(clsName);
      if (classType == null) {
        ctx.error(
          "'" + clsName + "' is not a class.",
          DiagnosticCode.SymbolNotFound,
          cp.loc
        );
        return;
      }
      ctx.setNodeType(cp.name, classType as Type);
      ctx.setNodeType(cp, classType as Type);
      // Resolve field types from the class.
      let props = cp.properties;
      var pi = 0;
      while (pi < props.length) {
        let prop = props[pi];
        let propName = prop.name.name;
        let propType = resolveClassFieldType(ctx, classType as Type, propName, prop.loc);
        checkPattern(ctx, prop.value, propType);
        pi = pi + 1;
      }
    }
    case RecordPattern {properties, loc}: {
      var pi = 0;
      while (pi < properties.length) {
        let prop = properties[pi];
        let propName = prop.name.name;
        var propType: Type = new ErrorType();
        match (expectedType) {
          case RecordT {properties as recordProps}: {
            if (recordProps.has(propName)) {
              propType = recordProps[propName];
            }
          }
          case _: {}
        }
        checkPattern(ctx, prop.value, propType);
        pi = pi + 1;
      }
    }
    case TuplePattern {elements}: {
      let elementTypes = getTuplePatternElementTypes(expectedType);
      if (elementTypes == null) {
        for (let element in elements) {
          if (element != null) {
            checkPattern(ctx, element, new ErrorType());
          }
        }
        return;
      }

      let tupleElementTypes = elementTypes as Array<Type>;

      for (var i = 0; i < elements.length; i += 1) {
        let elem = elements[i];
        if (elem != null) {
          if (i < tupleElementTypes.length) {
            checkPattern(ctx, elem, tupleElementTypes[i]);
          } else {
            checkPattern(ctx, elem, new ErrorType());
          }
        }
      }
    }
    case AsPattern as ap: {
      checkPattern(ctx, ap.pattern, expectedType);
      // Narrow the alias to the matched type, not the scrutinee type.
      var narrowedType: Type = expectedType;
      if (ap.pattern is ClassPattern) {
        let cp = ap.pattern as ClassPattern;
        let cls = ctx.resolveTypeName(cp.name.name);
        if (cls != null) {
          narrowedType = cls as Type;
        }
      } else if (ap.pattern is Identifier) {
        let ident = ap.pattern as Identifier;
        let cls = ctx.resolveTypeName(ident.name);
        if (cls != null) {
          narrowedType = cls as Type;
        }
      }
      let info = ctx.model.resolveDeclaration(ap.name);
      if (info != null) {
        ctx.declareBinding(info as Symbol, narrowedType);
      } else {
        ctx.declareTypeName(ap.name.name, narrowedType);
      }
    }
    case LogicalPattern {operator, left, right, loc}: {
      checkPattern(ctx, left, expectedType);
      checkPattern(ctx, right, expectedType);
    }
    case Identifier as ident: {
      // Match-context patterns produce Identifier nodes; `let x` / `var x`
      // produces an IdentifierPattern under a BindingPattern instead. So a
      // bare identifier here is a *reference*, never a binding, and has to
      // resolve to a class (a variant test). If it doesn't, say so: silently
      // treating it as a fresh binding turns a mistyped variant name into a
      // catch-all that swallows every remaining case.
      if (ident.name != "_") {
        let resolvedType = ctx.resolveTypeName(ident.name);
        if (resolvedType != null) {
          ctx.setNodeType(ident, resolvedType as Type);
        }
        var isVariant = false;
        if (resolvedType != null) {
          match (resolvedType as Type) {
            case ClassType: { isVariant = true; }
            case _: {}
          }
        }
        if (!isVariant) {
          ctx.error(
            unresolvedPatternNameMessage(ident.name, expectedType, resolvedType != null),
            DiagnosticCode.InvalidPattern,
            ident.loc
          );
          // Bind it anyway so the case body reports its own errors rather than
          // a cascade of "Variable not found" on top of the real diagnostic.
          let info = ctx.model.resolveDeclaration(ident);
          if (info != null) {
            ctx.declareBinding(info as Symbol, expectedType);
          } else {
            ctx.declareTypeName(ident.name, expectedType);
          }
        }
      }
    }
    case LiteralPattern {value}: {
      checkExpression(ctx, value, expectedType);
    }
    case MemberExpression as me: {
      checkExpression(ctx, me as Expression, expectedType);
    }
    case NumberLiteral as lit: {
      checkExpression(ctx, lit as Expression, expectedType);
    }
    case StringLiteral as lit: {
      checkExpression(ctx, lit as Expression, expectedType);
    }
    case BooleanLiteral as lit: {
      checkExpression(ctx, lit as Expression, expectedType);
    }
    case NullLiteral as lit: {
      checkExpression(ctx, lit as Expression, expectedType);
    }
    case _: {
      // Wildcard, etc. - no bindings needed.
    }
  }
};

/**
 * If `t` is the prelude Iterator<T> instantiation, returns T;
 * otherwise null. A generator's declared return type must satisfy
 * this (generators.md §2.2); the annotation is the call expression's
 * type, and the yield type is its argument.
 */
let extractIteratorYieldType = (ctx: CheckerContext, t: Type): Type | null => {
  if (!(t is InterfaceType)) {
    return null;
  }
  let it = t as InterfaceType;
  let prelude = ctx.resolvePreludeType("Iterator");
  if (prelude == null || !(prelude is InterfaceType)) {
    return null;
  }
  if (it.id != (prelude as InterfaceType).id) {
    return null;
  }
  if (it.typeArguments == null) {
    return null;
  }
  let args = it.typeArguments as Array<Type>;
  if (args.length != 1) {
    return null;
  }
  return args[0];
};

/**
 * The external type of a `gen` function with no annotation:
 * Iterator<inferredYieldType> from the prelude.
 */
let makeIteratorType = (
  ctx: CheckerContext,
  yieldType: Type,
  loc: SourceLocation | null
): Type => {
  let prelude = ctx.resolvePreludeType("Iterator");
  if (prelude == null || !(prelude is InterfaceType)) {
    ctx.error(
      "Generator functions require the 'Iterator' interface from the prelude.",
      DiagnosticCode.TypeMismatch,
      loc
    );
    return new ErrorType();
  }
  let args = new Array<Type>();
  args.push(yieldType);
  return instantiateInterfaceType(prelude as InterfaceType, args);
};

/**
 * If `t` is the prelude Future<T> instantiation, returns T; otherwise
 * null. An async function's declared return type must satisfy this
 * (async.md §1); the annotation is the call expression's type.
 */
let extractFutureValueType = (ctx: CheckerContext, t: Type): Type | null => {
  if (!(t is ClassType)) {
    return null;
  }
  let ct = t as ClassType;
  let prelude = ctx.resolvePreludeType('Future');
  if (prelude == null || !(prelude is ClassType)) {
    return null;
  }
  if (ct.id != (prelude as ClassType).id) {
    return null;
  }
  if (ct.typeArguments == null) {
    return null;
  }
  let args = ct.typeArguments as Array<Type>;
  if (args.length != 1) {
    return null;
  }
  return args[0];
};

/**
 * The external type of an `async` function with no annotation:
 * Future<inferredValueType> from the prelude.
 */
let makeFutureType = (
  ctx: CheckerContext,
  valueType: Type,
  loc: SourceLocation | null
): Type => {
  let prelude = ctx.resolvePreludeType('Future');
  if (prelude == null || !(prelude is ClassType)) {
    ctx.error(
      "Async functions require the 'Future' class from the prelude.",
      DiagnosticCode.TypeMismatch,
      loc
    );
    return new ErrorType();
  }
  let args = new Array<Type>();
  args.push(valueType);
  return instantiateClassType(prelude as ClassType, args);
};

/**
 * Types `await e` (async.md §1): the operand must be Future<T>
 * (result T) or a distinguishable union T | Future<T> (result T).
 */
let checkAwaitExpression = (ctx: CheckerContext, aw: AwaitExpression): Type => {
  let operandType = checkExpression(ctx, aw.argument, null);
  if (ctx.asyncValueType == null) {
    // Includes non-async closures nested in async bodies: they are
    // their own functions and cannot suspend their lexical parent.
    ctx.error(
      "'await' is only valid inside the body of an 'async' function.",
      DiagnosticCode.TypeMismatch,
      aw.loc
    );
    return new ErrorType();
  }
  let direct = extractFutureValueType(ctx, operandType);
  if (direct != null) {
    return direct as Type;
  }
  if (operandType is UnionT) {
    let arms = (operandType as UnionT).types;
    let valueArms = new Array<Type>();
    var futureValue: Type | null = null;
    var futureCount = 0;
    for (let arm in arms) {
      let fv = extractFutureValueType(ctx, arm);
      if (fv != null) {
        futureValue = fv;
        futureCount += 1;
      } else {
        valueArms.push(arm);
      }
    }
    if (futureCount == 1 && valueArms.length > 0) {
      let valueType = if (valueArms.length == 1) {
        valueArms[0]
      } else {
        createUnionType(valueArms)
      };
      if (typesEqual(valueType, futureValue as Type)) {
        return valueType;
      }
      ctx.error(
        "Type mismatch: 'await' on a union requires 'T | Future<T>' with matching T, got '" +
        typeToString(operandType) + "'.",
        DiagnosticCode.TypeMismatch,
        aw.loc
      );
      return new ErrorType();
    }
  }
  if (operandType is ErrorType) {
    return new ErrorType();
  }
  ctx.error(
    "Type mismatch: 'await' operand must be 'Future<T>' or 'T | Future<T>', got '" +
    typeToString(operandType) + "'.",
    DiagnosticCode.TypeMismatch,
    aw.loc
  );
  return new ErrorType();
};

let checkFunctionExpression = (
  ctx: CheckerContext,
  fe: FunctionExpression,
  expectedType: Type | null
): Type => {
  let typeParameters = fe.typeParameters;
  let params = fe.params;
  let returnTypeAnn = fe.returnType;
  let body = fe.body;
  let loc = fe.loc;

  var isClosure = !(ctx.referrerStack.length == 1 && ctx.referrerStack[0] == "sym");
  if (!isClosure) {
    let parent = ctx.model.getParent(fe);
    if (parent == null ||
        !(parent is VariableDeclaration || parent is FunctionDeclaration)) {
      isClosure = true;
    }
  }
  if (isClosure) {
    ctx.enterClosureReferrer();
  }
  ctx.referrerStack.push("func");

  ctx.enterScope();

  // Register type parameters in the type scope.
  var resolvedTypeParams: Array<TypeParameterType> | null = null;
  if (typeParameters != null) {
    let tps = typeParameters as Array<TypeParameter>;
    if (tps.length > 0) {
      let tpTypes = new Array<TypeParameterType>();
      var tpi = 0;
      while (tpi < tps.length) {
        let tp = tps[tpi];
        var constraint: Type | null = null;
        if (tp.constraint != null) {
          constraint = resolveTypeAnnotation(ctx, tp.constraint as TypeAnnotation);
        }
        let tpType = ctx.getOrCreateTypeParameter(tp, constraint, null);
        ctx.declareTypeName(tp.name, tpType);
        tpTypes.push(tpType);
        tpi += 1;
      }
      resolvedTypeParams = tpTypes;
    }
  }

  // Resolve parameter types.
  let paramTypes = new Array<Type>();
  let paramNames = new Array<String>();

  // If there's a contextual function type, use it for parameter inference.
  var contextualFn: FunctionType | null = null;
  if (expectedType != null) {
    match (expectedType as Type) {
      case FunctionType as ft: { contextualFn = ft; }
      case _: {}
    }
  }

  var i = 0;
  var hasOptionals = false;
  let optionals = new Array<boolean>();
  var hasInitializers = false;
  let initializers = new Array<Expression | null>();
  while (i < params.length) {
    let param = params[i];
    let paramName = param.name.name;
    paramNames.push(paramName);

    var paramType: Type = new ErrorType();
    if (param.typeAnnotation != null) {
      paramType = resolveTypeAnnotation(ctx, param.typeAnnotation as TypeAnnotation);
          } else if (contextualFn != null) {
      let cfn = contextualFn as FunctionType;
      if (i < cfn.parameters.length) {
        paramType = cfn.parameters[i];
      }
    } else {
      // No annotation and no contextual type — report an error.
      ctx.error(
        "Parameter '" + paramName + "' has no type annotation and cannot be inferred from context.",
        DiagnosticCode.TypeMismatch,
        loc
      );
    }

    // Optional parameters have their type widened to T | null
    let isOptional = param.optional || param.defaultValue != null;
    optionals.push(isOptional);

    // Bind parameter type early so subsequent default arguments can reference it.
    let paramInfo = ctx.model.resolveDeclaration(param);
    if (paramInfo != null) {
      ctx.declareBinding(paramInfo as Symbol, paramType);
    }
    if (param.pattern != null) {
      bindPattern(ctx, param.pattern as Pattern, paramType);
    }

    if (param.defaultValue != null) {
      hasInitializers = true;
      let initExp = param.defaultValue as Expression;
      let initType = checkExpression(ctx, initExp, paramType);
      if (!isAssignableTo(ctx, initType, paramType)) {
        ctx.error(
          "Type mismatch: default value of type '" + typeToString(initType) +
          "' is not assignable to parameter type '" + typeToString(paramType) + "'.",
          DiagnosticCode.TypeMismatch,
          initExp.loc
        );
      }
    }
    initializers.push(param.defaultValue);
    if (isOptional) {
      hasOptionals = true;
      // Only widen to T | null for ?-style optionals without a default value.
      // Params with default values keep their declared type.
      if (param.optional && param.defaultValue == null) {
        var alreadyNullable = false;
        match (paramType) {
          case NullType: { alreadyNullable = true; }
          case UnionT {types}: {
            var ui = 0;
            while (ui < types.length) {
              if (types[ui] is NullType) { alreadyNullable = true; }
              ui += 1;
            }
          }
          case _: {}
        }
        if (!alreadyNullable) {
          let unionTypes = new Array<Type>();
          unionTypes.push(paramType);
          unionTypes.push(new NullType());
          paramType = createUnionType(unionTypes);
        }
      }
    }

    paramTypes.push(paramType);
    i += 1;
  }

  // Resolve return type annotation.
  var retType: Type = new VoidType();
  var needsInference = false;
  if (returnTypeAnn != null) {
    retType = resolveTypeAnnotation(ctx, returnTypeAnn as TypeAnnotation, true);
  } else {
    needsInference = true;
  }

  // Generators: the annotation is the full Iterator<T> return type
  // (the call expression's type); T is the yield type. With no
  // annotation the yield type is inferred from the yield statements.
  // The body may only `yield` values and `return;` bare.
  let isGenerator = fe.isGenerator;
  var declaredYieldType: Type = new VoidType();
  var declaredIteratorType: Type | null = null;
  if (isGenerator) {
    if (returnTypeAnn != null) {
      let extracted = extractIteratorYieldType(ctx, retType);
      if (extracted == null) {
        ctx.error(
          "A generator's return type must be 'Iterator<T>', got '" +
          typeToString(retType) + "'.",
          DiagnosticCode.TypeMismatch,
          loc
        );
        declaredYieldType = new ErrorType();
        declaredIteratorType = new ErrorType();
      } else {
        declaredYieldType = extracted as Type;
        declaredIteratorType = retType;
      }
    }
    retType = new VoidType();
    needsInference = false;
  }

  // Async functions: the annotation is the full Future<T> return type
  // (the call expression's type); the body checks against T, and
  // `return e` may also adopt a Future<T> (async.md §1–§2). With no
  // annotation, T is inferred from the returns and wrapped.
  let isAsync = fe.isAsync;
  var declaredFutureType: Type | null = null;
  if (isAsync) {
    // step()'s failure-capture region is a try_br: an async body needs
    // the exception tag and payload global even when it never throws
    // in source (async.md §3).
    let asyncDeps = ctx.currentDependencies();
    if (asyncDeps != null) {
      asyncDeps.needsExceptionInfra = true;
    }
    if (returnTypeAnn != null) {
      let extracted = extractFutureValueType(ctx, retType);
      if (extracted == null) {
        ctx.error(
          "An async function's return type must be 'Future<T>', got '" +
          typeToString(retType) + "'.",
          DiagnosticCode.TypeMismatch,
          loc
        );
        retType = new ErrorType();
        declaredFutureType = new ErrorType();
      } else {
        declaredFutureType = retType;
        retType = extracted as Type;
      }
    }
    // Unannotated: retType stays VoidType with needsInference — the
    // ordinary return-inference machinery infers T (no adoption while
    // inferring: the returned expression's type is taken as-is).
  }

  // Set expected return type for return statements.
  // Save and reset inferred return types for this function.
  // Yield/async context and try depth are per-function: a plain
  // closure nested in a generator or async body must not inherit its
  // parent's suspension context, and a closure inside `try` is not
  // "in" the try.
  let prevReturnType = ctx.returnType;
  let prevInferredReturns = ctx.inferredReturnTypes;
  let prevYieldType = ctx.yieldType;
  let prevInferredYields = ctx.inferredYieldTypes;
  let prevAsyncValue = ctx.asyncValueType;
  let prevAsyncFuture = ctx.asyncFutureType;
  let prevTryDepth = ctx.tryDepth;
  ctx.setReturnType(retType);
  ctx.setInferredReturnTypes(new Array<Type>());
  var newYieldType: Type | null = null;
  if (isGenerator) {
    newYieldType = declaredYieldType;
  }
  ctx.setYieldType(newYieldType);
  ctx.setInferredYieldTypes(new Array<Type>());
  var newAsyncValue: Type | null = null;
  if (isAsync) {
    newAsyncValue = retType;
  }
  ctx.setAsyncValueType(newAsyncValue);
  ctx.setAsyncFutureType(if (isAsync) { declaredFutureType } else { null });
  ctx.setTryDepth(0);

  // Check the body.
  match (body) {
    case BlockStatement as block: {
      // A trailing expression statement in a non-void function is the
      // function's result (value-block bodies): check it WITH the
      // return type as context, so statement-position expressions
      // (a match with value arms) type as values, not void.
      var tailConforms = false;
      prescanPendingFunctions(ctx, block.body);
      let tailIndex = if (!needsInference && !(retType is VoidType) &&
          block.body.length > 0 &&
          block.body[block.body.length - 1] is ExpressionStatement) {
        block.body.length - 1
      } else {
        -1
      };
      var j = 0;
      while (j < block.body.length) {
        let stmtNode = block.body[j];
        if (j == tailIndex && !branchDefinitelyExits(stmtNode)) {
          let tailT = checkExpression(ctx,
              (stmtNode as ExpressionStatement).expression, retType);
          tailConforms = isAssignableTo(ctx, tailT, retType);
        } else {
          checkStatement(ctx, stmtNode);
        }
        if (branchDefinitelyExits(stmtNode) && j < block.body.length - 1) {
          ctx.error(
            "Unreachable code detected.",
            DiagnosticCode.UnreachableCode,
            block.body[j + 1].loc
          );
          break;
        }
        j = j + 1;
      }
      // After checking block body, infer return type from collected types.
      if (needsInference) {
        let inferred = ctx.inferredReturnTypes;
        if (inferred.length == 0) {
          retType = new VoidType();
        } else if (inferred.length == 1) {
          retType = inferred[0];
        } else {
          // Multiple return types - create union (or use first as approximation)
          // For now, just use the first type as a simple heuristic
          retType = inferred[0];
        }
      } else {
        // If it lacks a guaranteed return, a conforming trailing
        // expression (checked against the return type above) is the
        // function's result.
        if (!(retType is VoidType) && !branchDefinitelyExits(block) &&
            !tailConforms) {
          ctx.error(
            "A function with a non-void declared return type must return a value.",
            DiagnosticCode.MissingReturnType,
            loc
          );
        }
      }
    }
    case Expression as bodyExpr: {
      // If we don't have an expected type, don't pass retType (which is VoidType by default).
      let expectedBodyType = if (needsInference) { null } else { retType };
      let bodyType = checkExpression(ctx, bodyExpr, expectedBodyType);
      
      // Expression body: validate return type if annotated
      if (returnTypeAnn != null) {
        if (!isAssignableTo(ctx, bodyType, retType)) {
          // Async return-adoption: the body may produce the declared
          // Future<T> itself (forwarded, not double-wrapped), when T
          // is distinguishable from Future<T> (async.md §2).
          var adopted = false;
          if (declaredFutureType != null &&
              extractFutureValueType(ctx, retType) == null &&
              isAssignableTo(ctx, bodyType, declaredFutureType as Type)) {
            adopted = true;
          }
          if (!adopted) {
            ctx.error(
              "Type mismatch: expression body returns '" + typeToString(bodyType) +
              "' but function expects '" + typeToString(retType) + "'.",
              DiagnosticCode.TypeMismatch,
              loc
            );
          }
        }
      } else {
        // Infer return type from expression body.
        retType = bodyType;
      }
    }
  }

  // Generators: the declared Iterator<T> is the return type; with no
  // annotation, infer the yield type and wrap it.
  var finalRetType = retType;
  if (isGenerator) {
    if (declaredIteratorType != null) {
      finalRetType = declaredIteratorType as Type;
    } else {
      var yieldT: Type = new VoidType();
      let inferredYs = ctx.inferredYieldTypes;
      if (inferredYs.length == 0) {
        ctx.error(
          "Cannot infer the yield type of a generator that never yields; annotate the return type as 'Iterator<T>'.",
          DiagnosticCode.TypeMismatch,
          loc
        );
        yieldT = new ErrorType();
      } else {
        yieldT = inferredYs[0];
      }
      finalRetType = makeIteratorType(ctx, yieldT, loc);
    }
  }

  // Async: the declared Future<T> is the return type; with no
  // annotation, wrap the inferred value type.
  if (isAsync) {
    if (declaredFutureType != null) {
      finalRetType = declaredFutureType as Type;
    } else {
      finalRetType = makeFutureType(ctx, retType, loc);
    }
  }

  ctx.setReturnType(prevReturnType);
  ctx.setInferredReturnTypes(prevInferredReturns);
  ctx.setYieldType(prevYieldType);
  ctx.setInferredYieldTypes(prevInferredYields);
  ctx.setAsyncValueType(prevAsyncValue);
  ctx.setAsyncFutureType(prevAsyncFuture);
  ctx.setTryDepth(prevTryDepth);
  ctx.exitScope();

  let paramSymbols = new Array<SymbolId>();
  var pi = 0;
  while (pi < params.length) {
    let paramInfo = ctx.model.resolveDeclaration(params[pi].name);
    if (paramInfo != null) {
      let symId = (paramInfo as Symbol).id;
      // Mark as -1 if the parameter is never actually referenced in subsequent default parameters.
      let isReferenced = new Array<boolean>();
      isReferenced.push(false);
      var pi2 = pi + 1;
      while (pi2 < params.length) {
        if (params[pi2].defaultValue != null) {
           walkEnter(params[pi2].defaultValue as Node, (n: Node): void => {
             if (n is Identifier) {
               let nSym = ctx.model.resolve(n as Identifier);
               if (nSym != null) {
                 if ((nSym as Symbol).id == symId) {
                   isReferenced[0] = true;
                 }
               }
             }
           });
        }
        pi2 += 1;
      }
      if (isReferenced[0]) {
        paramSymbols.push(symId);
      } else {
        paramSymbols.push(-1 as SymbolId);
      }
    } else {
      paramSymbols.push(-1 as SymbolId);
    }
    pi += 1;
  }

  let fnType = new FunctionType(paramTypes, paramNames, finalRetType);
  fnType.parameterSymbols = paramSymbols;
  fnType.typeParameters = resolvedTypeParams;
  if (hasOptionals) {
    fnType.optionalParameters = optionals;
  }
  if (hasInitializers) {
    fnType.parameterInitializers = initializers;
  }
  let deps = ctx.currentDependencies();
  if (deps != null) {
    deps.referencedTypes.add(fnType);
  }
  if (isClosure) {
    let captureInfo = analyzeCaptures(fe, ctx.model);
    let capSyms = new Array<SymbolId>();
    for (let c in captureInfo.captures) {
      capSyms.push(c.id);
    }
    ctx.exitClosureReferrer(fe, captureInfo.capturesThis, capSyms, captureInfo.mutableCaptures);
  }
  let ignored = ctx.referrerStack.pop();
  return fnType;
};

let checkCallExpression = (
  ctx: CheckerContext,
  call: CallExpression,
  expectedType: Type | null
): Type => {
  let calleeType = checkExpression(ctx, call.callee, null);

  // Handle optional chaining on nullable callee.
  var baseCalleeType: Type = calleeType;
  var isNullable = false;
  match (calleeType) {
    case UnionT {types}: {
      let nonNull = new Array<Type>();
      var ui = 0;
      while (ui < types.length) {
        if (types[ui] is NullType) {
          isNullable = true;
        } else {
          nonNull.push(types[ui]);
        }
        ui = ui + 1;
      }
      if (nonNull.length == 1) {
        baseCalleeType = nonNull[0];
      } else if (nonNull.length > 1) {
        baseCalleeType = new UnionT(nonNull);
      }
    }
    case NullType: { isNullable = true; }
    case _: {}
  }

  // If optional and not nullable, proceed normally.
  // If optional and nullable, wrap result in union with null.
  let resultType = checkCallExpressionInner(ctx, call, baseCalleeType, expectedType);

  if (isNullable && call.optional) {
    if (isBoxablePrimitive(resultType) &&
        !ctx.nullishSanctioned.has((call as Node).id as i32)) {
      ctx.error(
        "Optional call yielding a primitive requires immediate coalescence: follow it with '?? <default>'.",
        DiagnosticCode.InvalidOperator,
        call.loc
      );
      return new ErrorType();
    }
    let types = new Array<Type>();
    types.push(resultType);
    types.push(new NullType());
    return createUnionType(types);
  }

  return resultType;
};

let checkCallExpressionInner = (
  ctx: CheckerContext,
  call: CallExpression,
  calleeType: Type,
  expectedType: Type | null
): Type => {
  let callee = call.callee;
  let args = call.args;
  let typeArguments = call.typeArguments;
  let loc = call.loc;
  match (calleeType) {
    case UnionT {types}: {
      var matchedFt: FunctionType | null = null;
      for (let t in types) {
        if (t is FunctionType) {
          let ft = t as FunctionType;
          var requiredCount = ft.parameters.length;
          if (ft.optionalParameters != null) {
            let optionals = ft.optionalParameters as Array<boolean>;
            requiredCount = 0;
            var oi = 0;
            while (oi < optionals.length) {
              if (!optionals[oi]) { requiredCount = requiredCount + 1; }
              oi += 1;
            }
          }
          if (args.length >= requiredCount && args.length <= ft.parameters.length) {
            matchedFt = ft;
            break;
          }
        }
      }
      
      if (matchedFt == null) {
        ctx.error("No matching signature in union type for call", DiagnosticCode.ArgumentCountMismatch, loc);
        return new ErrorType();
      }
      
      let effectiveFt = matchedFt as FunctionType;
      ctx.setNodeType(callee, effectiveFt);
      ctx.model.setUnionCallCalleeType(callee, calleeType as UnionT);

      // Args at or beyond the recorded caller-written count are defaults an
      // earlier pass spliced from the callee; they were checked in the
      // callee's scope at definition time and must not be re-checked here —
      // the caller's scope may not resolve them. Re-seed the fresh model's
      // record so codegen still lowers them under the callee's bindings.
      let previousOriginal = ctx.splicedArgCountOf(call);
      let callerArgCount = if (previousOriginal != -1 && previousOriginal < args.length) {
        previousOriginal
      } else {
        args.length
      };
      if (args.length > callerArgCount) {
        ctx.model.setOriginalArgCount(call, callerArgCount);
        if (effectiveFt.parameterNames != null) {
          ctx.model.setDefaultArgParamNames(call, effectiveFt.parameterNames as Array<String>);
        }
      }

      var j = 0;
      while (j < callerArgCount && j < effectiveFt.parameters.length) {
        let expectedParamType = effectiveFt.parameters[j];
        let argType = checkExpression(ctx, args[j], expectedParamType);
        if (!isAssignableTo(ctx, argType, expectedParamType)) {
          ctx.error(
            "Type mismatch: argument '" + typeToString(argType) +
            "' is not assignable to parameter '" + typeToString(expectedParamType) + "'.",
            DiagnosticCode.TypeMismatch,
            loc
          );
        } else {
          let instantiated = tryInstantiateGenericFunction(ctx, argType, expectedParamType);
          if (instantiated != argType) {
            ctx.setNodeType(args[j], instantiated);
          }
          checkAndRegisterInterfaceAdaptation(ctx, args[j], instantiated, expectedParamType);
        }
        j = j + 1;
      }
      
      return effectiveFt.returnType;
    }
    case FunctionType as ft: {
      var effectiveFt = ft;

      // Closure bodies can be checked more than once. If defaults were already
      // spliced into this call node's arguments on an earlier pass, args now
      // ends with the callee's initializer expressions. Those were checked in
      // the callee's scope at definition time and must not be re-checked here
      // (the caller's scope may not resolve them), so restore the recorded
      // caller-written argument count.
      let previousOriginal = ctx.splicedArgCountOf(call);
      let callerArgCount = if (previousOriginal != -1 && previousOriginal < args.length) {
        previousOriginal
      } else {
        args.length
      };

      // Evaluate argument types once for overload resolution. Arguments at or
      // beyond callerArgCount are previously-spliced defaults: use their
      // declared parameter type instead of re-checking them in caller scope.
      let argTypes = new Array<Type>();
      for (var i = 0; i < args.length; i += 1) {
        if (i >= callerArgCount && i < ft.parameters.length) {
          argTypes.push(ft.parameters[i]);
        } else {
          let expectedParamType = if (i < ft.parameters.length) {
            ft.parameters[i]
          } else {
            null
          };
          argTypes.push(checkExpression(ctx, args[i], expectedParamType));
        }
      }

      // Overload resolution
      let {overloads} = ft;
      if (overloads != null) {
        let candidates = new Array<FunctionType>();
        candidates.push(ft);
        for (let overload in overloads) {
          candidates.push(overload);
        }

        // Most-specific selection (member-lookup.md §5.1): collect
        // every applicable candidate, then pick the unique candidate
        // at least as specific as all others. Declaration order
        // carries no meaning; an applicable set with no unique
        // maximum is an ambiguity error.
        var bestMatch: FunctionType | null = null;
        let applicable = new Array<FunctionType>();
        for (let candidate in candidates) {
          let expectedCount = candidate.parameters.length;
          var requiredCount = expectedCount;
          let optionals = candidate.optionalParameters;
          if (optionals != null) {
            requiredCount = 0;
            for (let optional in optionals) {
              if (!optional) {
                requiredCount = requiredCount + 1;
              }
            }
          }

          if (args.length >= requiredCount && args.length <= expectedCount) {
            var matchOk = true;            
            for (var i = 0; i < args.length && i < expectedCount; i += 1) {
              if (!isAssignableTo(ctx, argTypes[i], candidate.parameters[i])) {
                matchOk = false;
              }
            }
            if (matchOk) {
              applicable.push(candidate);
            }
          }
        }
        let selIdx = selectMostSpecificIndex(ctx, applicable, args.length, call.loc);
        if (selIdx >= 0) {
          bestMatch = applicable[selIdx];
        }

        if (bestMatch != null) {
          effectiveFt = bestMatch as FunctionType;
          // Record the selection: overload choice is subtype-sensitive
          // and made exactly once, here. Codegen reads it back instead
          // of re-deriving from argument types.
          ctx.model.setResolvedOverload(call, bestMatch as FunctionType);
        }
      }

      // Handle generic function calls.
      let typeParams = effectiveFt.typeParameters;
      if (typeParams != null) {
        if (typeParams.length > 0) {
          if (typeArguments != null) {
            let typeArgs = new Array<Type>();
            for (let typeArg in typeArguments) {
              typeArgs.push(resolveTypeAnnotation(ctx, typeArg));
            }
            // Substitute type parameters in params and return type.
            let subParams = new Array<Type>();
            for (let param in effectiveFt.parameters) {
              subParams.push(substituteTypeParams(typeParams, typeArgs, param));
            }
            let subRet = substituteTypeParams(typeParams, typeArgs, effectiveFt.returnType);
            let newFt = new FunctionType(subParams, effectiveFt.parameterNames, subRet);
            newFt.typeParameters = effectiveFt.typeParameters;
            newFt.optionalParameters = effectiveFt.optionalParameters;
            newFt.parameterInitializers = effectiveFt.parameterInitializers;
            newFt.parameterSymbols = effectiveFt.parameterSymbols;
            newFt.typeArguments = typeArgs;
            newFt.genericSource = effectiveFt;
            newFt.functionSymbolId = effectiveFt.functionSymbolId;
            newFt.functionSymbolName = effectiveFt.functionSymbolName;
            effectiveFt = newFt;
          } else {
            // Infer type arguments from argument types.
            let inferred = new HashMap<String, Type>();
            for (var i = 0; i < args.length && i < effectiveFt.parameters.length; i += 1) {
              let argType = argTypes[i];
              inferTypeArg(effectiveFt.parameters[i], argType, inferred);
            }
            // Build type args array from inferred map.
            let typeArgs = typeParams.map((typeParam) => {
              let paramName = typeParam.name;
              return if (inferred.has(paramName)) {
                  inferred[paramName];
                } else {
                  // TODO: This is a bug that Array<Type | ErrorType> is not
                  // assignable to Array<Type>
                  new ErrorType() as Type;
                };
            });
            // Substitute type parameters in params and return type.
            let subParams = new Array<Type>();
            for (let param in effectiveFt.parameters) {
              subParams.push(substituteTypeParams(typeParams, typeArgs, param));
            }
            let subRet = substituteTypeParams(typeParams, typeArgs, effectiveFt.returnType);
            let newFt = new FunctionType(subParams, effectiveFt.parameterNames, subRet);
            newFt.typeParameters = effectiveFt.typeParameters;
            newFt.optionalParameters = effectiveFt.optionalParameters;
            newFt.parameterInitializers = effectiveFt.parameterInitializers;
            newFt.parameterSymbols = effectiveFt.parameterSymbols;
            newFt.typeArguments = typeArgs;
            newFt.genericSource = effectiveFt;
            newFt.functionSymbolId = effectiveFt.functionSymbolId;
            newFt.functionSymbolName = effectiveFt.functionSymbolName;
            effectiveFt = newFt;
          }
        }
      }

      // Check argument count.
      let expectedCount = effectiveFt.parameters.length;
      let originalActualCount = callerArgCount;

      // Fill in missing arguments with default values
      var hasDefaults = false;
      if (effectiveFt.parameterInitializers != null) {
        var a = args.length;
        while (a < effectiveFt.parameters.length) {
          let init = (effectiveFt.parameterInitializers as Array<Expression | null>)[a];
          if (init != null) {
            let initializer = init as Expression;
            match (initializer) {
              case Identifier {name}: {
                if (name == "__LOCATION__") {
                  if (ctx.emitLocations) {
                    let locStr = if (loc != null) {
                      `${ctx.filePath}:${(loc as SourceLocation).line}`
                    } else {
                      `${ctx.filePath}:0`
                    };
                    args.push(new StringLiteral(locStr, loc));
                  } else {
                    args.push(new NullLiteral(loc));
                  }
                } else {
                  args.push(initializer);
                }
              }
              case _: { args.push(initializer); }
            }
            hasDefaults = true;
          } else {
            // Optional but no default? Inject null.
            args.push(new NullLiteral(loc));
          }
          a += 1;
        }

        // Record when this pass spliced defaults OR when args already end
        // with defaults spliced by an earlier pass — a re-checked file
        // starts a fresh model, and codegen needs these records in the
        // final model to lower the injected defaults under the callee's
        // bindings.
        if (hasDefaults || args.length > originalActualCount) {
          ctx.model.setOriginalArgCount(call, originalActualCount);
          if (effectiveFt.parameterNames != null) {
            ctx.model.setDefaultArgParamNames(call, effectiveFt.parameterNames as Array<String>);
          }
          if (callee is MemberExpression) {
            let memberExpr = callee as MemberExpression;
            let objectType = checkExpression(ctx, memberExpr.object, null);
            match (objectType) {
              case ClassType: {
                ctx.model.setDefaultArgsOwner(call, objectType);
              }
              case _: {}
            }
          }
        }
      }


      let actualCount = args.length;

      // Count required parameters (not optional).
      var requiredCount = expectedCount;
      if (effectiveFt.optionalParameters != null) {
        let optionals = effectiveFt.optionalParameters as Array<boolean>;
        requiredCount = 0;
        var i = 0;
        while (i < optionals.length) {
          if (!optionals[i]) { requiredCount = requiredCount + 1; }
          i += 1;
        }
      }

      if (originalActualCount < requiredCount || originalActualCount > expectedCount) {
        // Show range for optional parameters, single count otherwise
        let expectedMsg = if (requiredCount == expectedCount) {
          `${expectedCount}`
        } else {
          `${requiredCount}-${expectedCount}`
        };
        // Revert actual count logic to match JS compiler, use original count
        ctx.error(
          `Expected ${expectedMsg} arguments, got ${originalActualCount}`,
          DiagnosticCode.ArgumentCountMismatch,
          loc
        );
      }

      ctx.setNodeType(callee, effectiveFt);

      // Check argument types (re-evaluating to apply generic substitutions and defaults).
      var j = 0;
      while (j < originalActualCount && j < expectedCount) {
        let expectedParamType = effectiveFt.parameters[j];
        let argType = checkExpression(ctx, args[j], expectedParamType);
        if (!isAssignableTo(ctx, argType, expectedParamType)) {
          ctx.error(
            "Type mismatch: argument '" + typeToString(argType) +
            "' is not assignable to parameter '" + typeToString(expectedParamType) + "'.",
            DiagnosticCode.TypeMismatch,
            loc
          );
        } else {
          let instantiated = tryInstantiateGenericFunction(ctx, argType, expectedParamType);
          if (instantiated != argType) {
            ctx.setNodeType(args[j], instantiated);
          }
          checkAndRegisterInterfaceAdaptation(ctx, args[j], instantiated, expectedParamType);
        }
        j = j + 1;
      }

      return effectiveFt.returnType;
    }
    case ErrorType: { return new ErrorType(); }
    case _: {
      ctx.error(
        "Type '" + typeToString(calleeType) + "' is not callable.",
        DiagnosticCode.NotCallable,
        loc
      );
      return new ErrorType();
    }
  }
};

/**
 * Validate that a condition expression has a boolean-compatible type.
 */
let validateConditionType = (ctx: CheckerContext, t: Type, expr: Expression): void => {
  if (!isBooleanLike(t)) {
    ctx.error(
      "Condition must be a boolean type, got '" + typeToString(t) + "'.",
      DiagnosticCode.TypeMismatch,
      expr.loc
    );
  }
};
