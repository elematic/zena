import { Module, VariableDeclaration } from './ast.zena';
import { Array } from 'zena:array';
import { SemanticModel } from './semantic-model.zena';

/**
 * An immutable snapshot of a single compilation state.
 * Encapsulates the modules, semantic model, and entry point.
 * 
 * TODO: In the future, this will also encapsulate caching and fast lookups
 * to support incremental compilation and Language Server (LSP) functionality.
 */
export class Program {
  modules: Array<Module>;
  model: SemanticModel;
  entryPoint: VariableDeclaration | null;

  new(this.modules, this.model, this.entryPoint = null);
}
