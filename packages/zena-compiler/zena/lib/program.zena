import { Module, VariableDeclaration, MixinDeclaration, DeclareFunction, IdentifierPattern, NodeId } from './ast.zena';
import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { SemanticModel, ProgramInterface, SemanticModelProgramUnit } from './semantic-model.zena';
import { Symbol, SymbolId } from './scope/symbol.zena';
import { SymbolMap } from './scope/scope-builder.zena';

export type CompilationUnit = {
  ast: Module,
  model: SemanticModel
};

/**
 * An immutable snapshot of a single compilation state.
 * Encapsulates the compilation units and entry point.
 */
export final class Program implements ProgramInterface {
  // This array maintains topological ordering guarantees from the compiler
  // pipeline, which is necessary for sequential WebAssembly code emission.
  // Although a tree walk (DFS) over a module dependency graph could derive
  // the order dynamically, doing the topological sort once up front and storing
  // it prevents redundant walks during code generation.
  units: Array<CompilationUnit>;
  unitsByPath = new HashMap<String, CompilationUnit>();
  entryPoint: CompilationUnit | null;

  nodeToModel = new HashMap<NodeId, SemanticModel>();
  symbolToModel = new HashMap<SymbolId, SemanticModel>();
  mixinDeclarations = new HashMap<String, MixinDeclaration>();
  exportedSymbols = new HashMap<String, Array<Symbol>>();
  exportedFunctions = new HashMap<String, Array<DeclareFunction>>();

  new(this.units, this.entryPoint = null) {
    for (let u in this.units) {
      this.unitsByPath[u.ast.path] = u;
      u.model.sourcePath = u.ast.path;
      u.model.program = this;

      // 1. Populate nodeToModel map from all node tables
      let ntKeys = u.model.nodeTypes.map.keys();
      while (let (true, k) = ntKeys.next()) { this.nodeToModel[k] = u.model; }

      let raKeys = u.model.recordAdaptations.map.keys();
      while (let (true, k) = raKeys.next()) { this.nodeToModel[k] = u.model; }

      let iaKeys = u.model.interfaceAdaptations.map.keys();
      while (let (true, k) = iaKeys.next()) { this.nodeToModel[k] = u.model; }

      let faKeys = u.model.functionAdaptations.map.keys();
      while (let (true, k) = faKeys.next()) { this.nodeToModel[k] = u.model; }

      let ucKeys = u.model.unionCallCalleeTypes.map.keys();
      while (let (true, k) = ucKeys.next()) { this.nodeToModel[k] = u.model; }

      let acKeys = u.model.originalArgCounts.map.keys();
      while (let (true, k) = acKeys.next()) { this.nodeToModel[k] = u.model; }

      let doKeys = u.model.defaultArgsOwners.map.keys();
      while (let (true, k) = doKeys.next()) { this.nodeToModel[k] = u.model; }

      let dpKeys = u.model.defaultArgParamNames.map.keys();
      while (let (true, k) = dpKeys.next()) { this.nodeToModel[k] = u.model; }

      let saKeys = u.model.staticAccesses.map.keys();
      while (let (true, k) = saKeys.next()) { this.nodeToModel[k] = u.model; }

      let pKeys = u.model.parents.map.keys();
      while (let (true, k) = pKeys.next()) { this.nodeToModel[k] = u.model; }

      if (u.model.symbols != null) {
        let symKeys = (u.model.symbols as SymbolMap).byNode.map.keys();
        while (let (true, k) = symKeys.next()) {
          this.nodeToModel[k] = u.model;
        }
      }

      // 2. Populate symbolToModel map
      let btKeys = u.model.bindingTypes.keys();
      while (let (true, k) = btKeys.next()) { this.symbolToModel[k] = u.model; }

      // 3. Precompute mixin declarations and export maps
      for (let stmt in u.ast.body) {
        match (stmt) {
          case MixinDeclaration as md: {
            this.mixinDeclarations[u.ast.path + "::" + md.name.name] = md;
          }
          case DeclareFunction as df: {
            let name = df.name.name;
            let key = u.ast.path + "::" + name;
            var arr = if (let (true, a) = this.exportedFunctions.get(key)) {
              a
            } else {
              let newArr = new Array<DeclareFunction>();
              this.exportedFunctions[key] = newArr;
              newArr
            };
            arr.push(df);

            let sym = u.model.resolveDeclaration(df);
            if (sym != null) {
              let symKey = u.ast.path + "::" + name;
              var symArr = if (let (true, sa) = this.exportedSymbols.get(symKey)) {
                sa
              } else {
                let newArr = new Array<Symbol>();
                this.exportedSymbols[symKey] = newArr;
                newArr
              };
              symArr.push(sym as Symbol);
            }
          }
          case VariableDeclaration as vd: {
            match (vd.pattern) {
              case IdentifierPattern {name} as pat: {
                let sym = u.model.resolve(pat);
                if (sym != null) {
                  let key = u.ast.path + "::" + name;
                  var arr = if (let (true, a) = this.exportedSymbols.get(key)) {
                    a
                  } else {
                    let newArr = new Array<Symbol>();
                    this.exportedSymbols[key] = newArr;
                    newArr
                  };
                  arr.push(sym as Symbol);
                }
              }
              case _: {}
            }
          }
          case _: {}
        }
      }
    }
  }

  getUnits(): Array<SemanticModelProgramUnit> {
    let result = new Array<SemanticModelProgramUnit>();
    for (let u in this.units) {
      result.push({ path: u.ast.path, model: u.model });
    }
    return result;
  }
}
