/**
 * Semantic Model for the Zena compiler.
 *
 * The SemanticModel is a single query surface for all semantic
 * information about a module. It combines:
 *
 *   1. Node types — the inferred type for any AST node (expression,
 *      declaration pattern, parameter, etc.).
 *   2. Binding types — the type carried by a named binding, keyed by
 *      Symbol.id so each destructured name gets its own entry.
 *   3. Name resolution — delegates to the ReferenceMap from scope
 *      analysis to find the Symbol for any identifier reference.
 *   4. Diagnostics collected during type checking.
 *
 * Two kinds of "type" live here, both accessible via getNodeType():
 *
 *   - **Binding type**: Stored on a declaration node (IdentifierPattern,
 *     Parameter, ClassDeclaration). This is the type the name carries —
 *     either from an explicit annotation or inferred from the initializer.
 *     Query: `getNodeType(symbolInfo.declaration)`.
 *
 *   - **Expression type**: Stored on an expression node (NumberLiteral,
 *     BinaryExpression, Identifier, etc.). This is the fully resolved
 *     type at that use site, including control-flow narrowing.
 *     Query: `getNodeType(someExpr)`.
 *
 * These share the same map keyed by source offset, since declaration
 * nodes and expression nodes have disjoint offsets. There is no separate
 * "declared vs inferred" API — the AST's TypeAnnotation tells you
 * whether the type was explicit; the SemanticModel just gives you the
 * resolved result.
 *
 * A future global analysis pass (e.g., monomorphization) would produce
 * its own result, not overwrite this model. No third type level is
 * needed for single-module checking.
 */
import { HashSet } from 'zena:set';
import { Iterable, Iterator } from 'zena:iterator';
import { IterableUtils } from 'zena:iterable-utils';
import {
  Type, ClassType, InterfaceType, FunctionType, TypeParameterType, RecordType, UnionType, typeToString, TypeId
} from './types.zena';
import { Diagnostic } from './diagnostics.zena';
import { Node, NodeId, SourceLocation, ClassDeclaration, InterfaceDeclaration, MixinDeclaration, EnumDeclaration, Identifier, IfExpression, IdGenerator } from './ast.zena';
import { Symbol, SymbolId } from './scope/symbol.zena';
import { SymbolMap } from './scope/scope-builder.zena';
import { NodeMap } from './node-map.zena';

export type SemanticModelProgramUnit = {
  path: String,
  model: SemanticModel,
};

/**
 * Which model owns each node and each binding.
 *
 * A model answers questions about its own file; a query about a node
 * from another file — cross-module inlining, a generic instantiated
 * from elsewhere — needs to find the model that owns it, and this is
 * that map.
 *
 * It belongs to the *check*, not to a compile. Every `Program` built
 * over the same `CheckResult`s would compute exactly the same index,
 * so building it per compile made each compile walk every node in the
 * program (which the execution suite then paid 465 times over), and
 * left `Program` writing a back-pointer into `SemanticModel`s it
 * shares with every other compile in the batch. `SharedCheckerState`
 * holds one of these for exactly as long as the models it indexes
 * live, and a model is registered once, when its check finishes.
 */
export final class ModelIndex {
  nodeToModel = new HashMap<NodeId, SemanticModel>();
  symbolToModel = new HashMap<SymbolId, SemanticModel>();

  /**
   * The model that currently speaks for each file.
   *
   * A cycle-driven re-check (`checkCompilation`'s second pass) replaces
   * a file's model, and the superseded one must stop answering: its
   * types were inferred before the back edge resolved, which is the
   * whole reason for the second pass. Re-registering the replacement
   * overwrites its claims node by node, but a node the first pass
   * typed and the second did not would otherwise be left pointing at
   * the dead model — so ownership is checked against this rather than
   * assumed from the map. Missing is the right answer there; a
   * superseded type is not.
   */
  currentByPath = new HashMap<String, SemanticModel>();

  /** The live model owning `id`, or null if nothing current owns it. */
  ownerOfNode(id: NodeId): SemanticModel | null {
    if (let (true, m) = this.nodeToModel.get(id)) {
      return this.#ifCurrent(m);
    }
    return null;
  }

  /** The live model owning the binding `id`, or null. */
  ownerOfBinding(id: SymbolId): SemanticModel | null {
    if (let (true, m) = this.symbolToModel.get(id)) {
      return this.#ifCurrent(m);
    }
    return null;
  }

  #ifCurrent(m: SemanticModel): SemanticModel | null {
    if (let (true, current) = this.currentByPath.get(m.sourcePath)) {
      if (current != m) {
        return null;
      }
    }
    return m;
  }

  /**
   * Claims every node and binding `model` knows about, and makes it the
   * model for its file. Nodes are keyed by the AST, which the parse
   * cache keeps stable across checks, so a re-check's claims land on
   * the same keys and the latest check wins.
   */
  register(model: SemanticModel): void {
    this.currentByPath[model.sourcePath] = model;

    let ntKeys = model.nodeTypes.map.keys();
    while (let (true, k) = ntKeys.next()) { this.nodeToModel[k] = model; }

    let raKeys = model.recordAdaptations.map.keys();
    while (let (true, k) = raKeys.next()) { this.nodeToModel[k] = model; }

    let iaKeys = model.interfaceAdaptations.map.keys();
    while (let (true, k) = iaKeys.next()) { this.nodeToModel[k] = model; }

    let faKeys = model.functionAdaptations.map.keys();
    while (let (true, k) = faKeys.next()) { this.nodeToModel[k] = model; }

    let ucKeys = model.unionCallCalleeTypes.map.keys();
    while (let (true, k) = ucKeys.next()) { this.nodeToModel[k] = model; }

    let acKeys = model.originalArgCounts.map.keys();
    while (let (true, k) = acKeys.next()) { this.nodeToModel[k] = model; }

    let doKeys = model.defaultArgsOwners.map.keys();
    while (let (true, k) = doKeys.next()) { this.nodeToModel[k] = model; }

    let dpKeys = model.defaultArgParamNames.map.keys();
    while (let (true, k) = dpKeys.next()) { this.nodeToModel[k] = model; }

    let saKeys = model.staticAccesses.map.keys();
    while (let (true, k) = saKeys.next()) { this.nodeToModel[k] = model; }

    let sdKeys = model.scopeExitDrops.map.keys();
    while (let (true, k) = sdKeys.next()) { this.nodeToModel[k] = model; }

    let edKeys = model.edgeDrops.map.keys();
    while (let (true, k) = edKeys.next()) { this.nodeToModel[k] = model; }

    let pKeys = model.parents.map.keys();
    while (let (true, k) = pKeys.next()) { this.nodeToModel[k] = model; }

    let symbols = model.symbols;
    if (symbols != null) {
      let symKeys = symbols.byNode.map.keys();
      while (let (true, k) = symKeys.next()) { this.nodeToModel[k] = model; }
    }

    let btKeys = model.bindingTypes.keys();
    while (let (true, k) = btKeys.next()) { this.symbolToModel[k] = model; }
  }
}

/**
 * One compensating drop at a branch join: release `symbolId` at the end
 * of the arm `onTrueArm` names, because the other arm moved it.
 */
export final class EdgeDrop {
  symbolId: SymbolId;
  onTrueArm: boolean;

  new(this.symbolId, this.onTrueArm);
}

export final class RecordAdaptation {
  source: RecordType;
  target: RecordType;

  new(this.source, this.target);
}

export final class InterfaceAdaptation {
  source: ClassType;
  target: InterfaceType;
  
  new(this.source, this.target);
}

export final class FunctionAdaptation {
  source: FunctionType;
  target: FunctionType;
  
  new(this.source, this.target);
}

export final class SemanticModel {
  var typeIdGenerator: IdGenerator<TypeId> | null = null;
  /**
   * The index that can name the owner of a node this model does not
   * own. Set once, when this model's check finishes; never by a
   * compile, which is why two compiles over these models cannot fight
   * over it.
   */
  var index: ModelIndex | null = null;
  var sourcePath: String = "";

  /**
   * Map from node.id → inferred Type.
   * Used for both expression types and declaration/binding types.
   */
  #nodeTypes = new NodeMap<Type>();

  /**
   * Map from node.id → RecordAdaptation for implicit fat pointer adaptation.
   */
  #recordAdaptations = new NodeMap<RecordAdaptation>();

  setRecordAdaptation(node: Node, source: RecordType, target: RecordType): void {
    this.#recordAdaptations[node] = new RecordAdaptation(source, target);
  }

  getRecordAdaptationDirect(node: Node): RecordAdaptation | null {
    if (let (true, t) = this.#recordAdaptations.get(node)) {
      return t;
    }
    return null;
  }

  getRecordAdaptation(node: Node): RecordAdaptation | null {
    let t = this.getRecordAdaptationDirect(node);
    if (t != null) return t;
    if (this.index != null) {
      let owner = (this.index as ModelIndex).ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.getRecordAdaptationDirect(node);
      }
    }
    return null;
  }

  /**
   * Map from node.id → InterfaceAdaptation for implicit interface fat pointer adaptation.
   */
  #interfaceAdaptations = new NodeMap<InterfaceAdaptation>();
  #resolvedOverloads = new NodeMap<FunctionType>();

  setInterfaceAdaptation(node: Node, source: ClassType, target: InterfaceType): void {
    this.#interfaceAdaptations[node] = new InterfaceAdaptation(source, target);
  }

  /**
   * The overload the checker selected for a call or index expression,
   * recorded ONLY when the callee had overloads. Codegen must consume
   * this instead of re-deriving the choice from argument node types:
   * overload selection is subtype-sensitive and belongs to the checker
   * alone (registration mangles overloaded members with the DECLARED
   * signature key, so the recorded FunctionType reproduces the exact
   * registration name).
   */
  setResolvedOverload(node: Node, ft: FunctionType): void {
    this.#resolvedOverloads[node] = ft;
  }

  getResolvedOverloadDirect(node: Node): FunctionType | null {
    if (let (true, t) = this.#resolvedOverloads.get(node)) {
      return t;
    }
    return null;
  }

  getResolvedOverload(node: Node): FunctionType | null {
    let t = this.getResolvedOverloadDirect(node);
    if (t != null) return t;
    if (this.index != null) {
      let owner = (this.index as ModelIndex).ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.getResolvedOverloadDirect(node);
      }
    }
    return null;
  }

  getInterfaceAdaptationDirect(node: Node): InterfaceAdaptation | null {
    if (let (true, t) = this.#interfaceAdaptations.get(node)) {
      return t;
    }
    return null;
  }

  getInterfaceAdaptation(node: Node): InterfaceAdaptation | null {
    let t = this.getInterfaceAdaptationDirect(node);
    if (t != null) return t;
    if (this.index != null) {
      let owner = (this.index as ModelIndex).ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.getInterfaceAdaptationDirect(node);
      }
    }
    return null;
  }

  /**
   * Map from node.id → FunctionAdaptation for implicit function argument adaptation.
   */
  #functionAdaptations = new NodeMap<FunctionAdaptation>();

  setFunctionAdaptation(node: Node, source: FunctionType, target: FunctionType): void {
    this.#functionAdaptations[node] = new FunctionAdaptation(source, target);
  }

  getFunctionAdaptationDirect(node: Node): FunctionAdaptation | null {
    if (let (true, t) = this.#functionAdaptations.get(node)) {
      return t;
    }
    return null;
  }

  getFunctionAdaptation(node: Node): FunctionAdaptation | null {
    let t = this.getFunctionAdaptationDirect(node);
    if (t != null) return t;
    if (this.index != null) {
      let owner = (this.index as ModelIndex).ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.getFunctionAdaptationDirect(node);
      }
    }
    return null;
  }

  /**
   * Map from node.id -> UnionType representing the original union type of a callee.
   */
  #unionCallCalleeTypes = new NodeMap<UnionType>();

  setUnionCallCalleeType(node: Node, type: UnionType): void {
    this.#unionCallCalleeTypes[node] = type;
  }

  getUnionCallCalleeTypeDirect(node: Node): UnionType | null {
    if (let (true, t) = this.#unionCallCalleeTypes.get(node)) {
      return t;
    }
    return null;
  }

  getUnionCallCalleeType(node: Node): UnionType | null {
    let t = this.getUnionCallCalleeTypeDirect(node);
    if (t != null) return t;
    let {index} = this;
    if (index != null) {
      let owner = index.ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.getUnionCallCalleeTypeDirect(node);
      }
    }
    return null;
  }

  /**
   * Map from node.id -> original argument count (before checker filled in defaults)
   */
  #originalArgCounts = new NodeMap<i32>();

  setOriginalArgCount(node: Node, count: i32): void {
    this.#originalArgCounts[node] = count;
  }

  getOriginalArgCountDirect(node: Node): i32 {
    if (let (true, count) = this.#originalArgCounts.get(node)) {
      return count;
    }
    return -1;
  }

  getOriginalArgCount(node: Node): i32 {
    let c = this.getOriginalArgCountDirect(node);
    if (c != -1) return c;
    let {index} = this;
    if (index != null) {
      let owner = index.ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.getOriginalArgCountDirect(node);
      }
    }
    return -1;
  }

  /**
   * Map from node.id -> ClassType of the class that owns the method defaults
   */
  #defaultArgsOwners = new NodeMap<Type>();

  setDefaultArgsOwner(node: Node, type: Type): void {
    this.#defaultArgsOwners[node] = type;
  }

  getDefaultArgsOwnerDirect(node: Node): Type | null {
    if (let (true, t) = this.#defaultArgsOwners.get(node)) {
      return t;
    }
    return null;
  }

  getDefaultArgsOwner(node: Node): Type | null {
    let t = this.getDefaultArgsOwnerDirect(node);
    if (t != null) return t;
    let {index} = this;
    if (index != null) {
      let owner = index.ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.getDefaultArgsOwnerDirect(node);
      }
    }
    return null;
  }

  /**
   * Map from node.id -> Parameter names
   */
  #defaultArgParamNames = new NodeMap<Array<String>>();

  setDefaultArgParamNames(node: Node, names: Array<String>): void {
    this.#defaultArgParamNames[node] = names;
  }

  getDefaultArgParamNamesDirect(node: Node): Array<String> | null {
    if (let (true, ns) = this.#defaultArgParamNames.get(node)) {
      return ns;
    }
    return null;
  }

  getDefaultArgParamNames(node: Node): Array<String> | null {
    let ns = this.getDefaultArgParamNamesDirect(node);
    if (ns != null) return ns;
    let {index} = this;
    if (index != null) {
      let owner = index.ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.getDefaultArgParamNamesDirect(node);
      }
    }
    return null;
  }

  /**
   * Map from node.id → boolean to record whether a member/call expression is a static access.
   */
  #staticAccesses = new NodeMap<boolean>();

  setStaticAccess(node: Node, isStatic: boolean): void {
    this.#staticAccesses[node] = isStatic;
  }

  isStaticAccessDirect(node: Node): boolean {
    if (let (true, s) = this.#staticAccesses.get(node)) {
      return s;
    }
    return false;
  }

  isStaticAccess(node: Node): boolean {
    if (this.isStaticAccessDirect(node)) return true;
    let {index} = this;
    if (index != null) {
      let owner = index.ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.isStaticAccessDirect(node);
      }
    }
    return false;
  }

  /**
   * Declarations (keyed by their IdentifierPattern node) whose binding
   * the compiler releases at scope exit: an `Own` of a resource class
   * that is never moved, reassigned, captured or otherwise escaped.
   * The checker decides (ownership.md §Implicit drop); ZIR lowering
   * materializes the release through the shared finally region. The
   * verdict is overwritten on a re-check, so stale trues cannot
   * survive a pass that reached a different conclusion.
   */
  #scopeExitDrops = new NodeMap<boolean>();

  setScopeExitDrop(node: Node, drop: boolean): void {
    this.#scopeExitDrops[node] = drop;
  }

  hasScopeExitDropDirect(node: Node): boolean {
    if (let (true, d) = this.#scopeExitDrops.get(node)) {
      return d;
    }
    return false;
  }

  hasScopeExitDrop(node: Node): boolean {
    if (this.hasScopeExitDropDirect(node)) return true;
    if (this.index != null) {
      let owner = (this.index as ModelIndex).ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.hasScopeExitDropDirect(node);
      }
    }
    return false;
  }

  /**
   * Compensating drops, keyed by an IfStatement node: bindings a branch
   * join must release at the end of one arm because the other arm moved
   * them (ownership.md §"The branch-join rule"). Lowering emits the
   * dispose at the flagged arm's end, before the merge.
   */
  #edgeDrops = new NodeMap<Array<EdgeDrop>>();

  setEdgeDrops(node: Node, drops: Array<EdgeDrop>): void {
    this.#edgeDrops[node] = drops;
  }

  edgeDropsOfDirect(node: Node): Array<EdgeDrop> | null {
    if (let (true, d) = this.#edgeDrops.get(node)) {
      return d;
    }
    return null;
  }

  edgeDropsOf(node: Node): Array<EdgeDrop> | null {
    let direct = this.edgeDropsOfDirect(node);
    if (direct != null) { return direct; }
    if (this.index != null) {
      let owner = (this.index as ModelIndex).ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.edgeDropsOfDirect(node);
      }
    }
    return null;
  }

  /**
   * Map from Symbol.id → Type for named bindings.
   * Parallel to #nodeTypes but keyed by binding identity, which is
   * stable across reference sites. The checker populates this when
   * processing declarations; identifier resolution looks up here.
   */
  #bindingTypes = new HashMap<SymbolId, Type>();

  /**
   * Scope analysis symbol map (nodes → Symbol).
   * Owned by the SemanticModel so consumers have a single object to query.
   */
  var #symbols: SymbolMap | null = null;

  /**
   * Parent pointer map from node → parent node.
   * Useful for analyses (like DCE) that need to walk up from a node.
   * Populated during scope analysis.
   */
  var #parents: NodeMap<Node> = new NodeMap<Node>();

  /**
   * All diagnostics from type checking.
   */
  #diagnostics = new Array<Diagnostic>();

  /**
   * Map from exported names to their resolved Type.
   * Used for cross-module type lookups, especially for built-in
   * primitives where Symbol ids may differ natively.
   */
  #exportTypes = new HashMap<String, Type>();

  // --- Reference and declaration maps ---

  symbols: SymbolMap | null {
    get { return this.#symbols; }
  }

  /**
   * Attach the scope analysis maps.
   */
  setSymbols(symbols: SymbolMap): void {
    this.#symbols = symbols;
  }

  /**
   * Bulk add parent pointers.
   */
  setParents(parents: NodeMap<Node>): void {
    this.#parents = parents;
  }

  /**
   * Set the parent of a node.
   */
  setParent(child: Node, parent: Node): void {
    this.#parents[child] = parent;
  }

  getParentDirect(child: Node): Node | null {
    if (let (true, parent) = this.#parents.get(child)) {
      return parent;
    }
    return null;
  }

  getParent(child: Node): Node | null {
    let p = this.getParentDirect(child);
    if (p != null) return p;
    let {index} = this;
    if (index != null) {
      let owner = index.ownerOfNode(child.id);
      if (owner != null && owner != this) {
        return owner.getParentDirect(child);
      }
    }
    return null;
  }

  resolveDirect(node: Node): Symbol | null {
    if (this.#symbols == null) {
      return null;
    }
    return (this.#symbols as SymbolMap).getByNode(node);
  }

  resolveByOffset(offset: i32): Symbol | null {
    if (this.#symbols == null) {
      return null;
    }
    return (this.#symbols as SymbolMap).getByOffset(offset);
  }

  resolve(node: Node): Symbol | null {
    let sym = this.resolveDirect(node);
    if (sym != null) return sym;
    let {index} = this;
    if (index != null) {
      let owner = index.ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.resolveDirect(node);
      }
    }
    return null;
  }

  /**
   * Find the Symbol for a declaration-site node.
   * Used at declaration-processing time (e.g., when the checker processes
   * a VariableDeclaration and needs to store the type for its binding).
   */
  resolveDeclaration(node: Node): Symbol | null {
    return this.resolve(node);
  }

  // --- Node types (expressions and declaration nodes) ---

  /**
   * Record the inferred type for an AST node.
   */
  setNodeType(node: Node, type: Type): void {
    this.#nodeTypes[node] = type;
  }

  getNodeTypeDirect(node: Node): Type | null {
    if (let (true, t) = this.#nodeTypes.get(node)) {
      return t;
    }
    return null;
  }

  getNodeType(node: Node): Type | null {
    let t = this.getNodeTypeDirect(node);
    if (t != null) return t;
    let {index} = this;
    if (index != null) {
      let owner = index.ownerOfNode(node.id);
      if (owner != null && owner != this) {
        return owner.getNodeTypeDirect(node);
      }
    }
    return null;
  }

  // --- Binding types (keyed by Symbol.id) ---

  /**
   * Store the type for a named binding.
   */
  setBindingType(info: Symbol, type: Type): void {
    this.#bindingTypes[info.id] = type;
  }

  getBindingTypeDirect(info: Symbol): Type | null {
    if (this.#bindingTypes.has(info.id)) {
      return this.#bindingTypes[info.id];
    }
    return null;
  }

  getBindingTypeById(id: SymbolId): Type | null {
    if (this.#bindingTypes.has(id)) {
      return this.#bindingTypes[id];
    }
    return null;
  }

  getBindingType(info: Symbol): Type | null {
    let t = this.getBindingTypeDirect(info);
    if (t != null) return t;
    let {index} = this;
    if (index != null) {
      let owner = index.ownerOfBinding(info.id);
      if (owner != null && owner != this) {
        return owner.getBindingTypeDirect(info);
      }
    }
    return null;
  }

  // --- Exports ---

  /**
   * Register a type as exported under the given name.
   */
  setExportType(name: String, type: Type): void {
    this.#exportTypes[name] = type;
  }

  /**
   * Get an exported type by name.
   */
  getExportType(name: String): Type | null {
    if (this.#exportTypes.has(name)) {
      return this.#exportTypes[name];
    }
    return null;
  }

  // --- Diagnostics ---

  addDiagnostic(diagnostic: Diagnostic): void {
    this.#diagnostics.push(diagnostic);
  }

  diagnostics: Array<Diagnostic> {
    get { return this.#diagnostics; }
  }

  nodeTypes: NodeMap<Type> {
    get { return this.#nodeTypes; }
  }

  #symbolDependencies = new HashMap<SymbolId, SymbolDependencies>();
  #nodeDependencies = new HashMap<i32, SymbolDependencies>();
  symbolNames = new HashMap<SymbolId, String>();

  #declaredClasses = new Array<SymbolId>();
  #declaredInterfaces = new Array<SymbolId>();
  #declaredMixins = new Array<SymbolId>();
  #declaredEnums = new Array<SymbolId>();
  #declaredGlobals = new Array<SymbolId>();

  #classDeclarations = new HashMap<SymbolId, ClassDeclaration>();
  #interfaceDeclarations = new HashMap<SymbolId, InterfaceDeclaration>();
  #mixinDeclarations = new HashMap<SymbolId, MixinDeclaration>();
  #enumDeclarations = new HashMap<SymbolId, EnumDeclaration>();
  #globalDeclarations = new HashMap<SymbolId, Node>();

  symbolDependencies: HashMap<SymbolId, SymbolDependencies> {
    get { return this.#symbolDependencies; }
  }

  nodeDependencies: HashMap<i32, SymbolDependencies> {
    get { return this.#nodeDependencies; }
  }

  declaredClasses: Array<SymbolId> {
    get { return this.#declaredClasses; }
  }

  declaredInterfaces: Array<SymbolId> {
    get { return this.#declaredInterfaces; }
  }

  declaredMixins: Array<SymbolId> {
    get { return this.#declaredMixins; }
  }

  declaredEnums: Array<SymbolId> {
    get { return this.#declaredEnums; }
  }

  declaredGlobals: Array<SymbolId> {
    get { return this.#declaredGlobals; }
  }

  classDeclarations: HashMap<SymbolId, ClassDeclaration> {
    get { return this.#classDeclarations; }
  }

  interfaceDeclarations: HashMap<SymbolId, InterfaceDeclaration> {
    get { return this.#interfaceDeclarations; }
  }

  mixinDeclarations: HashMap<SymbolId, MixinDeclaration> {
    get { return this.#mixinDeclarations; }
  }

  enumDeclarations: HashMap<SymbolId, EnumDeclaration> {
    get { return this.#enumDeclarations; }
  }

  globalDeclarations: HashMap<SymbolId, Node> {
    get { return this.#globalDeclarations; }
  }

  addDeclaredClass(id: SymbolId, cd: ClassDeclaration): void {
    this.#classDeclarations[id] = cd;
    this.#declaredClasses.push(id);
  }

  addDeclaredInterface(id: SymbolId, idDec: InterfaceDeclaration): void {
    this.#interfaceDeclarations[id] = idDec;
    this.#declaredInterfaces.push(id);
  }

  addDeclaredMixin(id: SymbolId, md: MixinDeclaration): void {
    this.#mixinDeclarations[id] = md;
    this.#declaredMixins.push(id);
  }

  addDeclaredEnum(id: SymbolId, ed: EnumDeclaration): void {
    this.#enumDeclarations[id] = ed;
    this.#declaredEnums.push(id);
  }

  addDeclaredGlobal(id: SymbolId, node: Node): void {
    this.#globalDeclarations[id] = node;
    this.#declaredGlobals.push(id);
  }

  setSymbolDependencies(id: SymbolId, deps: SymbolDependencies): void {
    this.#symbolDependencies[id] = deps;
  }

  setNodeDependencies(id: i32, deps: SymbolDependencies): void {
    this.#nodeDependencies[id] = deps;
  }

  recordAdaptations: NodeMap<RecordAdaptation> { get { return this.#recordAdaptations; } }
  interfaceAdaptations: NodeMap<InterfaceAdaptation> { get { return this.#interfaceAdaptations; } }
  functionAdaptations: NodeMap<FunctionAdaptation> { get { return this.#functionAdaptations; } }
  unionCallCalleeTypes: NodeMap<UnionType> { get { return this.#unionCallCalleeTypes; } }
  originalArgCounts: NodeMap<i32> { get { return this.#originalArgCounts; } }
  defaultArgsOwners: NodeMap<Type> { get { return this.#defaultArgsOwners; } }
  defaultArgParamNames: NodeMap<Array<String>> { get { return this.#defaultArgParamNames; } }
  staticAccesses: NodeMap<boolean> { get { return this.#staticAccesses; } }
  scopeExitDrops: NodeMap<boolean> { get { return this.#scopeExitDrops; } }
  edgeDrops: NodeMap<Array<EdgeDrop>> { get { return this.#edgeDrops; } }
  parents: NodeMap<Node> { get { return this.#parents; } }
  bindingTypes: HashMap<SymbolId, Type> { get { return this.#bindingTypes; } }
}

export final class ClosureDependency {
  id: i32;
  node: Node;
  capturesThis: boolean;
  captures: Array<SymbolId>;
  mutableCaptures: HashSet<SymbolId>;
  dependencies: SymbolDependencies;

  new(this.id, this.node, this.capturesThis, this.captures, this.mutableCaptures, this.dependencies);
}

export final class FunctionAdaptationDependency {
  node: Node;
  source: FunctionType;
  target: FunctionType;

  new(this.node, this.source, this.target);
}

/**
 * A set of types that iterates in the order they were added.
 *
 * Insertion order, not hash order. `Type.hashCode` is a process-global
 * uid handed out at construction and never reset — it cannot be, since
 * a long-lived compiler interns types across compiles, and restarting
 * the sequence would collide fresh types with cached ones. So a
 * `HashSet<Type>` iterates in an order that depends on how many types
 * the process had already built, which is to say on how many modules
 * were compiled before this one.
 *
 * That order reaches the emitted bytes: RTA walks this set to intern
 * wasm types and register function-value wrappers, so compiling one
 * file twice in a single process emitted two different (equally
 * correct, equally sized) modules — a permuted type section, and
 * whichever of two same-signature wrappers was registered first.
 * The checker adds types during a deterministic AST walk, so insertion
 * order is stable; hash order was the only thing that was not.
 */
export final class OrderedTypeSet with IterableUtils<Type> implements Iterable<Type> {
  #seen = new HashSet<Type>();
  #order = new Array<Type>();

  new();

  /** Adds `t` if it is not already present. Returns whether it was new. */
  add(t: Type): boolean {
    if (!this.#seen.add(t)) { return false; }
    this.#order.push(t);
    return true;
  }

  :Iterable.iterator(): Iterator<Type> {
    return this.#order.:Iterable.iterator();
  }
}

export final class SymbolDependencies {
  referencedSymbols = new HashSet<SymbolId>();
  referencedClassMethods = new HashSet<String>(); // Format: ClassSymbolId.methodName
  referencedInterfaceMembers = new HashSet<String>(); // Format: InterfaceSymbolId.memberName
  usedInterfaceAdaptations = new HashSet<String>(); // Format: ClassSymbolId::InterfaceSymbolId
  referencedTypes = new OrderedTypeSet();
  closures = new Array<ClosureDependency>();
  functionAdaptations = new Array<FunctionAdaptationDependency>();
  var needsExceptionInfra = false;
  /**
   * Enclosing locals assigned inside a `try` body. RTA cells them, so
   * the handler observes assignments the body completed before it
   * threw (see `analysis/capture.zena`).
   */
  tryMutatedSymbols = new HashSet<SymbolId>();

  new();
}
