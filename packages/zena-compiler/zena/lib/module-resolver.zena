// Module resolution for the Zena compiler.
//
// Resolves import specifiers to canonical module paths. Handles:
// - Relative imports (./foo, ../bar)
// - Package imports (package:module)
// - Virtual modules (target-conditional resolution)
// - Internal modules (package-private)
//
// Resolution is a pure function of configuration (packages + target).
// No I/O is performed.

import { Array } from 'zena:array';
import { HashMap } from 'zena:map';
import { Error } from 'zena:error';

// ============================================================================
// Package Configuration
// ============================================================================

// Configuration for a single module export within a package.
// For simple modules, `virtual` and `path` are null and the module resolves
// to `<name>.zena` in the package root.
// `path` overrides the entry file (relative to the package root).
// For target-conditional modules, `virtual` maps target names to entry file
// paths (relative to the package root).
export final class ModuleExport {
  virtual: HashMap<String, String> | null;
  path: String | null;

  new(virtual: HashMap<String, String> | null, path: String | null = null)
    : virtual = virtual, path = path;
}

// Configuration for a package in the package manifest.
//
// A package maps a name (e.g., "zena", "zena-compiler") to a root directory
// containing .zena source files. Packages can optionally restrict which
// modules are importable via `exports`; files not listed there are private
// to the package and reachable only via relative imports.
export final class PackageConfig {
  // Absolute path to the package root directory.
  root: String;

  // Explicit module exports. If null, all .zena files are importable (open
  // package). If present, only listed modules can be imported (closed package).
  exports: HashMap<String, ModuleExport> | null;

  // WIT-backed package: the path to a .wit file, or a directory of them,
  // declared with `{"wit": "./path"}` in the manifest. Its modules are
  // WIT interfaces — `import {now} from 'wasi:clocks/monotonic-clock'` —
  // and the compiler host synthesizes their Zena declarations from the
  // WIT source (docs/design/component-model.md, Part 2). Mutually
  // exclusive with `root`/`exports`.
  var witRoot: String | null = null;

  new(
    root: String,
    exports: HashMap<String, ModuleExport> | null
  ) : root = root, exports = exports;
}

// ============================================================================
// Resolution Result
// ============================================================================

// A resolved module with its canonical path and package info.
export final class ResolvedModule(
  // Canonical path. For stdlib, either a name id ("zena:string") for a
  // manifest module resolving to its default "<name>.zena" file, or a path
  // id ("zena:console/host.zena") for any other stdlib file.
  // For file modules: "/absolute/path/to/module.zena".
  path: String,

  // The package this module belongs to. Empty string for relative imports
  // that don't fall under any known package.
  packageName: String
)

// ============================================================================
// Module Resolver
// ============================================================================

// Resolves import specifiers to canonical module paths.
//
// The resolver does not perform any I/O. It operates purely on its
// configuration: a map of package names to PackageConfig, and a
// compilation target string.
//
// Usage:
//   let resolver = new ModuleResolver(packages, "host");
//   let resolved = resolver.resolve("zena:string", "/my/file.zena");
//   // resolved.path == "zena:string"
export final class ModuleResolver {
  #packages: HashMap<String, PackageConfig>;
  #target: String;

  new(packages: HashMap<String, PackageConfig>, target: String)
    : #packages = packages, #target = target;

  // The compilation target (e.g., "host", "wasi").
  target: String {
    get { return this.#target; }
  }

  // Resolve an import specifier relative to a referrer module.
  //
  // Specifier formats:
  // - Relative: "./foo.zena", "../bar.zena"
  // - Package:  "zena:string", "mypackage:module"
  resolve(specifier: String, referrer: String): ResolvedModule {
    if (specifier.startsWith("./") || specifier.startsWith("../")) {
      return this.resolveRelative(specifier, referrer);
    }

    let colonPos = indexOfByte(specifier, 58); // 58 = ':'
    if (colonPos < 0) {
      throw new Error(
        "Invalid specifier: '" + specifier + "' (expected package:path format)"
      );
    }

    let packageName = specifier.sliceBytes(0, colonPos);
    let moduleName = specifier.sliceBytes(colonPos + 1, specifier.length);
    return this.resolvePackage(packageName, moduleName, referrer);
  }

  // Resolve a relative import specifier.
  resolveRelative(specifier: String, referrer: String): ResolvedModule {
    // Relative imports between stdlib files resolve in the space of paths
    // relative to the stdlib source root and stay within it.
    if (referrer.startsWith("zena:")) {
      return this.#resolveStdlibRelative(specifier, referrer);
    }
    let dir = dirName(referrer);
    let resolved = normalizePath(dir + "/" + specifier);
    let packageName = this.findPackageForPath(resolved);
    return new ResolvedModule(resolved, packageName);
  }

  #resolveStdlibRelative(specifier: String, referrer: String): ResolvedModule {
    let refPath = this.#stdlibFilePath(referrer.sliceBytes(5, referrer.length));
    let resolved = normalizePath(dirName(refPath) + "/" + specifier);
    if (resolved == ".." || resolved.startsWith("../")) {
      throw new Error(
        "Cannot resolve '" + specifier + "' from " + referrer +
          " (escapes the stdlib)"
      );
    }
    return new ResolvedModule("zena:" + this.#stdlibIdForPath(resolved), "zena");
  }

  // Map a stdlib canonical id (without the "zena:" prefix) to its file path
  // relative to the stdlib source root.
  #stdlibFilePath(sub: String): String {
    if (sub.endsWith(".zena")) {
      return sub;
    }
    return sub + ".zena";
  }

  // Map a stdlib-root-relative file path back to a canonical id (without the
  // "zena:" prefix): the module name when the path is the default entry file
  // of a manifest module, otherwise the path itself. Modules with an explicit
  // `path` or a `virtual` mapping always canonicalize to path ids, so each
  // file has exactly one canonical id.
  #stdlibIdForPath(path: String): String {
    if (path.contains("/") || !path.endsWith(".zena")) {
      return path;
    }
    let name = path.sliceBytes(0, path.length - 5);
    if (let (true, config) = this.#packages.get("zena")) {
      if (config.exports != null) {
        let exports = config.exports as HashMap<String, ModuleExport>;
        if (let (true, moduleExport) = exports.get(name)) {
          if (moduleExport.virtual == null && moduleExport.path == null) {
            return name;
          }
        }
      }
    }
    return path;
  }

  // Resolve a package import specifier.
  resolvePackage(
    packageName: String,
    moduleName: String,
    referrer: String
  ): ResolvedModule {
    if (let (true, config) = this.#packages.get(packageName)) {

      // A WIT-backed package: the module is a WIT interface, and the
      // canonical path carries everything the host needs to synthesize
      // its declarations — where the WIT lives, and which interface.
      // The specifier has no version on purpose; the WIT declares it.
      let witRoot = config.witRoot;
      if (witRoot != null) {
        return new ResolvedModule(
            "wit:" + (witRoot as String) + "#" + packageName + ":" +
                moduleName,
            packageName);
      }

      // Check exports if the package has an explicit export list.
      if (config.exports != null) {
        let exports = config.exports as HashMap<String, ModuleExport>;
        if (!exports.has(moduleName)) {
          throw new Error(
            "Module '" + moduleName + "' not found in package '" + packageName + "'"
          );
        }

        let moduleExport = exports[moduleName];

        // Resolve virtual modules (target-conditional) to their entry file.
        // A module with no entry for the current target is not available
        // there, and says so: falling through would resolve to a default
        // entry file that does not exist, and report a missing file
        // instead of a missing capability.
        if (moduleExport.virtual != null) {
          let virtual = moduleExport.virtual as HashMap<String, String>;
          if (let (true, entryPath) = virtual.get(this.#target)) {
            return makeCanonicalFilePath(packageName, entryPath, config);
          }
          throw new Error(
            "Module '" + packageName + ":" + moduleName +
              "' is not available on target '" + this.#target + "'"
          );
        }

        // Modules with an explicit entry file resolve to it.
        if (moduleExport.path != null) {
          return makeCanonicalFilePath(
            packageName,
            moduleExport.path as String,
            config
          );
        }
      }

      return makeCanonicalPath(packageName, moduleName, config);
    }

    throw new Error("Unknown package: '" + packageName + "'");
  }

  // Find which package (if any) contains the given path.
  findPackageForPath(path: String): String {
    if (path.startsWith("zena:")) {
      return "zena";
    }
    let iter = this.#packages.keys();
    while (let (true, name) = iter.next()) {
      let config = this.#packages[name];
      if (path.startsWith(config.root)) {
        return name;
      }
    }
    return "";
  }
}

// ============================================================================
// Path Utilities
// ============================================================================

// Map a stdlib canonical id (with or without the "zena:" prefix) to its file
// path relative to the stdlib source root. Name ids ("zena:string") map to
// "<name>.zena"; path ids ("zena:console/host.zena") contain the file path.
export let stdlibIdToRelativeFile = (id: String): String => {
  var sub = id;
  if (id.startsWith("zena:")) {
    sub = id.sliceBytes(5, id.length);
  }
  if (sub.endsWith(".zena")) {
    return sub;
  }
  return sub + ".zena";
};

// Create a canonical path for a module resolving to its default
// "<name>.zena" entry file.
// Stdlib modules use the "zena:" prefix; other packages resolve to file paths.
let makeCanonicalPath = (
  packageName: String,
  moduleName: String,
  config: PackageConfig
): ResolvedModule => {
  if (packageName == "zena") {
    return new ResolvedModule("zena:" + moduleName, "zena");
  }
  let filePath = config.root + "/" + moduleName + ".zena";
  return new ResolvedModule(filePath, packageName);
};

// Create a canonical path for a module with an explicit entry file
// (from `path` or a `virtual` mapping), given relative to the package root.
// Stdlib entries become path ids ("zena:console/host.zena").
let makeCanonicalFilePath = (
  packageName: String,
  entryPath: String,
  config: PackageConfig
): ResolvedModule => {
  if (packageName == "zena") {
    return new ResolvedModule("zena:" + entryPath, "zena");
  }
  return new ResolvedModule(config.root + "/" + entryPath, packageName);
};

// Find the byte position of the first occurrence of a byte in a string.
// Returns -1 if not found.
export let indexOfByte = (s: String, byte: i32): i32 => {
  var i = 0;
  while (i < s.length) {
    if (s.getByteAt(i) == byte) {
      return i;
    }
    i += 1;
  }
  return 0 - 1;
};

// Get the directory portion of a path.
// e.g., "/foo/bar/baz.zena" → "/foo/bar"
// Returns "." if the path has no directory separator.
// Note: "zena:" canonical ids must not be passed here — the resolver maps
// them to stdlib-root-relative file paths first (see #resolveStdlibRelative).
export let dirName = (path: String): String => {
  var lastSlash = 0 - 1;
  var i = 0;
  while (i < path.length) {
    if (path.getByteAt(i) == 47) { // 47 = '/'
      lastSlash = i;
    }
    i += 1;
  }
  if (lastSlash < 0) {
    return ".";
  }
  return path.sliceBytes(0, lastSlash);
};

// Normalize a path by resolving "." and ".." segments.
// Preserves leading "/" for absolute paths.
export let normalizePath = (path: String): String => {
  let segments = splitByByte(path, 47); // 47 = '/'
  let result = new GrowableArray<String>();
  let isAbsolute = path.length > 0 && path.getByteAt(0) == 47;

  var i = 0;
  while (i < segments.length) {
    let seg = segments[i];
    if (seg == "." || seg == "") {
      // Skip "." and empty segments (from "//")
    } else if (seg == "..") {
      if (result.length > 0 && result[result.length - 1] != "..") {
        result.pop();
      } else if (!isAbsolute) {
        // Preserve leading ".." segments in relative paths so callers can
        // detect escapes above the base directory. (Above the root of an
        // absolute path, ".." is dropped as before.)
        result.push(seg);
      }
    } else {
      result.push(seg);
    }
    i += 1;
  }

  if (isAbsolute) {
    return "/" + joinBySlash(result);
  }
  if (result.length == 0) {
    return ".";
  }
  return joinBySlash(result);
};

// Split a string by a byte delimiter.
export let splitByByte = (s: String, delim: i32): Array<String> => {
  let parts = new GrowableArray<String>();
  var start = 0;
  var i = 0;
  while (i < s.length) {
    if (s.getByteAt(i) == delim) {
      parts.push(s.sliceBytes(start, i));
      start = i + 1;
    }
    i += 1;
  }
  parts.push(s.sliceBytes(start, s.length));
  return parts;
};

// Join an array of path segments with "/".
let joinBySlash = (segments: Array<String>): String => {
  if (segments.length == 0) {
    return "";
  }
  var result = segments[0];
  var i = 1;
  while (i < segments.length) {
    result = result + "/" + segments[i];
    i += 1;
  }
  return result;
};
