import { Array } from 'zena:array';
import { HashSet } from 'zena:set';
import { HashMap } from 'zena:map';
import { Type } from '../types.zena';
import { SymbolId } from '../scope/symbol.zena';
import { SourceLocation } from '../ast.zena';

/**
 * The checker's control-flow graph (docs/design/ownership.md, "The checker
 * flow graph").
 *
 * Flow nodes are built by the checker as it walks a function body, in the
 * style of TypeScript's binder: each node points backward at its
 * antecedents, so a query walks from a use toward the function entry. The
 * graph is a side structure — it never replaces the AST, and it exists
 * per checked body, not per instantiation, which is what lets it serve
 * checking of code RTA later drops.
 *
 * The first consumer is narrowing validity: a narrowing records the flow
 * node where its guard established it, and a read walks backward from the
 * reference to that node, failing if some path crosses an assignment that
 * no longer satisfies the narrowed type. Move checking builds on the same
 * nodes.
 *
 * Nodes compare by `id`, never by `==`: joins make the graph cyclic
 * through loop back edges, so structural equality must not be reachable.
 */
export sealed class FlowNode {
  case FlowStart, FlowAssign, FlowMove, FlowNarrowings, FlowJoin,
    FlowUnreachable

  /** Unique within one CheckerContext; minted by the checker. */
  var id: i32 = 0;
}

/**
 * Entry of a function body (or of the module's top level). `enclosing`
 * is the flow at the closure's creation site in the enclosing body, so
 * a walk can keep going for a captured binding — a closure sees the
 * narrowings that held where it was written.
 */
export final class FlowStart extends FlowNode {
  var enclosing: FlowNode | null = null;

  /**
   * Whether this body shares `this` with its enclosing body (a closure
   * inside a method does; a method, accessor or top-level body starts a
   * fresh `this`). A `this`-rooted path walk stops where `this` stops.
   */
  var sharesThis: boolean = false;
  new() : super();
}

/**
 * Follows code that cannot be reached — after `return`, `throw`,
 * `break`, `continue`. Joins drop unreachable antecedents.
 */
export final class FlowUnreachable extends FlowNode {
  new() : super();
}

/**
 * An assignment to a local binding. `assignedType` is the checked type of
 * the stored value; null means the type was unavailable, which a validity
 * walk must treat as incompatible.
 */
export final class FlowAssign extends FlowNode {
  antecedent: FlowNode;
  symbolId: SymbolId;
  assignedType: Type | null;
  new(this.antecedent, this.symbolId, this.assignedType) : super();
}

/**
 * A move of an owned binding: passed to an `Own` parameter, moved into
 * another binding, or consumed by a `this: Own<this>` method. The binding
 * is dead on every path through this node until a reassignment revives
 * it. `loc` is where the move happened, for the use-after-move message
 * and for the loop back-edge report.
 */
export final class FlowMove extends FlowNode {
  antecedent: FlowNode;
  symbolId: SymbolId;
  name: String;
  loc: SourceLocation | null;
  new(this.antecedent, this.symbolId, this.name, this.loc) : super();
}

/**
 * The narrowings a condition (or match pattern) establishes on the path
 * it guards: what the checker's condition engine computed for one
 * branch, attached to that branch's entry. A backward walk takes the
 * nearest node mentioning its binding or path — composition of nested
 * guards is already baked in, because the engine computes each map from
 * the types that held where the condition sits.
 */
export final class FlowNarrowings extends FlowNode {
  antecedent: FlowNode;
  bindings: HashMap<SymbolId, Type>;
  paths: HashMap<String, Type>;
  new(this.antecedent, this.bindings, this.paths) : super();
}

/**
 * A merge point: the end of an `if`, a loop header, a `match` join, the
 * short-circuit join of `&&`/`||`/`??`, or a `catch` entry (whose
 * antecedents include every assignment in the protected body). Loop
 * headers gain their back edge after the body is walked.
 */
export final class FlowJoin extends FlowNode {
  antecedents = new Array<FlowNode>();
  new() : super();

  /** Unreachable antecedents carry no paths, so they are not recorded. */
  add(node: FlowNode): void {
    if (node is FlowUnreachable) { return; }
    this.antecedents.push(node);
  }
}

/**
 * The checker's per-body flow state, saved and restored around nested
 * function bodies the way return/yield context is: a closure checked in
 * the middle of an enclosing body gets its own FlowStart and its own
 * loop and exception stacks.
 */
export final class FlowBodyState {
  current: FlowNode;
  start: FlowStart;
  loopHeads: Array<FlowJoin>;
  loopExits: Array<FlowJoin>;
  exceptionTargets: Array<FlowJoin>;
  loopMoves: Array<Array<FlowMove>>;
  loopDeclared: Array<HashSet<i32>>;
  new(this.current, this.start, this.loopHeads, this.loopExits,
      this.exceptionTargets, this.loopMoves, this.loopDeclared);
}

