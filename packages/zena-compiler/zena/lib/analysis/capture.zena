import { Array } from 'zena:array';
import { HashSet } from 'zena:set';
import {
  Node, Identifier, ThisExpression, AssignmentExpression, FunctionExpression, Parameter, VariableDeclaration, IdentifierPattern, Module, ClassDeclaration, InterfaceDeclaration, EnumDeclaration, MixinDeclaration, MethodDefinition, BlockStatement,
} from '../ast.zena';
import { SemanticModel } from '../semantic-model.zena';
import { Symbol, SymbolId } from '../scope/symbol.zena';
import { walkEnter } from '../visitor.zena';

export class CaptureInfo {
  captures = new GrowableArray<Symbol>();
  mutableCaptures = new HashSet<SymbolId>();
  var capturesThis: boolean = false;

  new();
}

let isLocalSymbol = (sym: Symbol, model: SemanticModel): boolean => {
  if (sym.declaration == null) { return false; }
  let decl = sym.declaration as Node;
  if (decl is Parameter) { return true; }

  var curr = decl;
  while (true) {
    let parent = model.getParent(curr);
    if (parent == null) { return false; }
    match (parent) {
      case Module: { return false; }
      case ClassDeclaration: { return false; }
      case InterfaceDeclaration: { return false; }
      case EnumDeclaration: { return false; }
      case MixinDeclaration: { return false; }
      case VariableDeclaration: {
        let varDeclParent = model.getParent(parent);
        if (varDeclParent == null) { return false; }
        match (varDeclParent) {
          case Module: { return false; }
          case ClassDeclaration: { return false; }
          case InterfaceDeclaration: { return false; }
          case MixinDeclaration: { return false; }
          case _: { return true; }
        }
      }
      case MethodDefinition: { return true; }
      case FunctionExpression: { return true; }
      case BlockStatement: { return true; }
      case _: {
        curr = parent;
      }
    }
  }
  return false;
};

let isDeclaredInClosure = (sym: Symbol, funcExpr: FunctionExpression, model: SemanticModel): boolean => {
  if (sym.declaration == null) { return false; }
  let decl = sym.declaration as Node;
  if (decl is Parameter) {
    for (let p in funcExpr.params) {
      if (p.id == decl.id) {
        return true;
      }
    }
  }
  var curr = decl;
  while (true) {
    let parent = model.getParent(curr);
    if (parent == null) { return false; }
    if (parent.id == funcExpr.id) {
      return true;
    }
    curr = parent;
  }
  return false;
};

/**
 * True when the symbol is captured before its binding initializes: its
 * declaration is the closure's own binding (`let visit = () => …
 * visit() …` — the closure sits inside the initializer) or a later
 * statement in the enclosing scope (`let a = () => b(); let b = …`).
 * Such captures must be celled: the cell exists (empty) before the
 * closure is created, and the declaration later writes through it.
 */
let isCapturedBeforeInit = (s: Symbol, func: FunctionExpression, model: SemanticModel): boolean => {
  if (s.declaration == null) { return false; }
  let decl = s.declaration as Node;
  if (decl is Parameter) { return false; }
  // Parser node ids are assigned in source order, so a declaration with
  // a larger id than the closure node is a forward reference.
  if ((decl.id as i32) > (func.id as i32)) { return true; }
  // Self-capture: the closure appears inside the symbol's own
  // initializer.
  var curr: Node = func;
  while (true) {
    let parent = model.getParent(curr);
    if (parent == null) { return false; }
    match (parent) {
      case VariableDeclaration {pattern}: {
        match (pattern) {
          case IdentifierPattern as pat: {
            let ps = model.resolveDeclaration(pat);
            if (ps != null && ps.id == s.id) { return true; }
          }
          case _: {}
        }
      }
      case _: {}
    }
    curr = parent;
  }
  return false;
};

/** True when `sym`'s declaration sits anywhere inside `root`'s subtree. */
let isDeclaredWithin = (sym: Symbol, root: Node, model: SemanticModel): boolean => {
  if (sym.declaration == null) { return false; }
  var curr = sym.declaration as Node;
  while (true) {
    if (curr.id == root.id) { return true; }
    let parent = model.getParent(curr);
    if (parent == null) { return false; }
    curr = parent;
  }
  return false;
};

/**
 * Locals assigned inside a `try` body that are declared OUTSIDE it.
 *
 * These must live in heap cells, for the same reason a closure-mutated
 * capture does. The handler is entered from an arbitrary point in the
 * body's dynamic extent, so a value threaded along the protected edge
 * can only carry the state at `try` entry — every assignment the body
 * completed before it threw would be invisible to the handler and to
 * the code after the `try`. A cell is written in place, so both see
 * the last value written.
 *
 * Consumed by RTA (which interns the cell struct and registers the
 * symbol as celled); lowering then routes reads and writes through the
 * cell with no further knowledge of `try`.
 */
export let analyzeTryBodyAssignments = (tryBody: Node, model: SemanticModel): Array<SymbolId> => {
  let out = new GrowableArray<SymbolId>();
  let seen = new HashSet<SymbolId>();
  walkEnter(tryBody, (n: Node): void => {
    if (!(n is AssignmentExpression)) { return; }
    if (!(n.left is Identifier)) { return; }
    let symOpt = model.resolve(n.left as Identifier);
    if (symOpt == null) { return; }
    // Lowering asks `isCelled` about the resolve TARGET, so the set has
    // to be keyed the same way.
    let sym = symOpt.resolveTarget();
    if (seen.has(sym.id)) { return; }
    if (!isLocalSymbol(sym, model)) { return; }
    if (isDeclaredWithin(sym, tryBody, model)) { return; }
    seen.add(sym.id);
    out.push(sym.id);
  });
  return out;
};

export let analyzeCaptures = (func: FunctionExpression, model: SemanticModel): CaptureInfo => {
  let info = new CaptureInfo();
  let seen = new HashSet<SymbolId>();

  // Traverse the body and collect referenced variables that are declared outside
  walkEnter(func.body, (n: Node): void => {
    match (n) {
      case Identifier as ident: {
        let sym = model.resolve(ident);
        if (sym != null && isLocalSymbol(sym, model)) {
          if (!isDeclaredInClosure(sym, func, model)) {
            if (!seen.has(sym.id)) {
              seen.add(sym.id);
              info.captures.push(sym);
            }
            if (isCapturedBeforeInit(sym, func, model)) {
              info.mutableCaptures.add(sym.id);
            }
          }
        }
      }
      case ThisExpression: {
        info.capturesThis = true;
      }
      case AssignmentExpression as assign: {
        if (assign.left is Identifier) {
          let ident = assign.left as Identifier;
          let sym = model.resolve(ident);
          if (sym != null && isLocalSymbol(sym, model)) {
            if (!isDeclaredInClosure(sym, func, model)) {
              if (!seen.has(sym.id)) {
                seen.add(sym.id);
                info.captures.push(sym);
              }
              info.mutableCaptures.add(sym.id);
            }
          }
        }
      }
      case _: {}
    }
  });

  return info;
};
