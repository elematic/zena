{
  "name": "zena-compiler",
  "version": "0.0.1-preview.1",
  "description": "The Zena self-hosted compiler",
  "license": "MIT",
  "source": "zena/lib",
  "files": ["zena/lib"],
  "main": "compiler",
  "exports": {
    "analysis/purity": {},
    "ast": {},
    "ast-json": {},
    "census": {},
    "checker": {},
    "code-template": {},
    "codegen/binary-generator": {},
    "codegen/component-emitter": {},
    "codegen/component-runtime": {},
    "codegen/wat-generator": {},
    "comment-attachment": {},
    "compile-file": {},
    "compiler": {},
    "compiler-options": {},
    "compiler-target": {},
    "component-entry": {},
    "diagnostics": {},
    "doc-comment": {},
    "extension-views": {},
    "fs-host": {},
    "intrinsics": {},
    "library-loader": {},
    "line-index": {},
    "module-resolver": {},
    "node-map": {},
    "package-manifest": {},
    "parser": {},
    "prelude": {},
    "program": {},
    "scope": {},
    "scope/scope": {},
    "scope/symbol": {},
    "semantic-model": {},
    "simd": {},
    "stdlib-manifest": {},
    "targets": {},
    "time": {},
    "tokenizer": {},
    "types": {},
    "visitor": {},
    "well-known": {},
    "wit-module-synth": {},
    "wit-source": {}
  },
  "dependencies": {
    "zena-lang:wit-parser": {
      "path": "../wit-parser"
    }
  },
  "locks": ["zena-lock.json", "package-lock.json"],
  "scripts": {
    "build": {
      "dependencies": ["build:cli", "build:tests"]
    },
    "build:scripts": {
      "command": "tsc",
      "files": ["src/**/*.ts", "tsconfig.json"],
      "output": ["scripts/**/*.js", "scripts/**/*.js.map"],
      "clean": "if-file-deleted",
      "dependencies": ["../runtime:build"]
    },
    "build:cli": {
      "#command": "The checked-in CLI module bootstrap compiles the compiler, run through zena-cli's binary with ZENA_CLI_MODULE pointing at packages/zena-cli/bootstrap/zena.wasm so this step waits only on cargo and never on packages/zena-cli/out/zena.wasm, which this compiler builds. ZENA_OPT_LEVEL=2 (the env form, which a bootstrap that predates the -O flag ignores rather than misreads) makes the working compiler an -O2 build: it compiles the zena module in 20s where the -O1 build takes 27s, and every build and test step downstream of this one runs it (docs/design/compiler-memory.md).",
      "command": "mkdir -p zena/out && ZENA_GC_RESERVE_MB=1536 ZENA_OPT_LEVEL=2 ZENA_CLI_MODULE=../zena-cli/bootstrap/zena.wasm ../../target/release/zena-cli build zena/cli/main.zena -o zena/out/cli.wasm",
      "files": ["zena/cli/**/*.zena", "../zena-cli/bootstrap/zena.wasm"],
      "output": ["zena/out/cli.wasm"],
      "dependencies": ["source", "../stdlib:lib", "../zena-cli:build:binary"]
    },
    "build:tests": {
      "#dependencies": "precompile:cli, not build:self-hosted: this program is built by stage A (see build-wasi-tests.ts), and precompiling it is what keeps running it off Cranelift. Depending on stage B put the four suites behind its 64s.",
      "command": "node scripts/build-wasi-tests.js",
      "files": [
        "zena/test/**/*.zena",
        "!zena/test/__all_tests__.zena",
        "zena/out/cli.wasm"
      ],
      "output": [
        "zena/out/test-self/__all_tests__.wasm",
        "zena/test/__all_tests__.zena"
      ],
      "dependencies": [
        "source",
        "../stdlib:lib",
        "build:scripts",
        {
          "script": "precompile:cli",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    },
    "build:self-hosted": {
      "command": "ZENA_GC_RESERVE_MB=1536 ZENA_TEMPLATE_CHECK=1 ZENA_COMPILER_WASM=zena/out/cli.wasm ../../target/release/zena-cli -g -O2 build zena/cli/main.zena -o zena/out/cli-self.wasm && ../../target/release/zena-cli precompile zena/out/cli-self.wasm",
      "files": ["zena/cli/**/*.zena", "zena/out/cli.wasm"],
      "output": ["zena/out/cli-self.wasm", "zena/out/cli-self.cwasm"],
      "dependencies": [
        "source",
        "../stdlib:lib",
        {
          "script": "precompile:cli",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    },
    "test": {
      "#": "Everything, which is what CI runs. `test:smoke` is this minus the fixpoint check, so the two cannot drift.",
      "dependencies": ["test:smoke", "test:fixpoint"]
    },
    "test:unit": {
      "command": "node scripts/run-wasmtime.js unit",
      "files": [
        "scripts/run-wasmtime.js",
        "zena/out/test-self/__all_tests__.wasm",
        "zena/cli/**/*.zena",
        "test-files/snapshots/**/*.snap",
        "test-files/**/*.zena"
      ],
      "dependencies": [
        "source",
        "../stdlib:lib",
        "build:scripts",
        {
          "script": "build:tests",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    },
    "test:syntax": {
      "command": "node scripts/run-wasmtime.js syntax",
      "files": [
        "../../tests/language/syntax/**/*.zena",
        "../../tests/language/syntax/**/*.ast.json",
        "scripts/run-wasmtime.js",
        "zena/out/test-self/__all_tests__.wasm"
      ],
      "dependencies": [
        "../stdlib:lib",
        "build:scripts",
        {
          "script": "build:tests",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    },
    "test:semantics": {
      "command": "node scripts/run-wasmtime.js semantics",
      "files": [
        "../../tests/language/semantics/**/*.zena",
        "scripts/run-wasmtime.js",
        "zena/out/test-self/__all_tests__.wasm",
        "../../zena-package.json"
      ],
      "dependencies": [
        "../stdlib:lib",
        "build:scripts",
        {
          "script": "build:tests",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    },
    "test:execution": {
      "command": "node scripts/run-wasmtime.js execution",
      "files": [
        "../../tests/language/execution/**/*.zena",
        "scripts/run-wasmtime.js",
        "zena/out/test-self/__all_tests__.wasm",
        "../../zena-package.json"
      ],
      "env": {
        "ZENA_TEST_OPT_LEVEL": {
          "external": true
        },
        "ZENA_PROPAGATE": {
          "external": true
        }
      },
      "dependencies": [
        "../stdlib:lib",
        "build:scripts",
        {
          "script": "build:tests",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    },
    "test:execution:o2": {
      "#": "The execution suite compiled at -O2, through the module loop the default level skips. It writes to zena/out/test-exec-O2, and runs after test:execution rather than beside it, which keeps CI's peak memory where it was.",
      "command": "node scripts/run-wasmtime.js execution",
      "files": [
        "../../tests/language/execution/**/*.zena",
        "scripts/run-wasmtime.js",
        "zena/out/test-self/__all_tests__.wasm",
        "../../zena-package.json"
      ],
      "env": {
        "ZENA_TEST_OPT_LEVEL": "2",
        "ZENA_PROPAGATE": {
          "external": true
        }
      },
      "dependencies": [
        "../stdlib:lib",
        "build:scripts",
        {
          "script": "build:tests",
          "cascade": false
        },
        "../zena-cli:build",
        "test:execution"
      ]
    },
    "test:interop": {
      "command": "node scripts/external-functions-test.js",
      "files": ["scripts/external-functions-test.js", "zena/out/cli.wasm"],
      "dependencies": [
        "build:scripts",
        "../zena-cli:build",
        "../runtime:build",
        {
          "script": "precompile:cli",
          "cascade": false
        },
        "../stdlib:lib"
      ]
    },
    "test:fixpoint": {
      "#dependencies": "test:execution:o2 without its fingerprint, so the 4.7 GiB stage-C compile never runs beside the 6.5 GiB execution suite and zena-cli:test:zena on CI's 16 GiB runner.",
      "command": "node scripts/check-fixpoint.js",
      "files": [
        "zena/cli/**/*.zena",
        "zena/out/cli-self.wasm",
        "scripts/check-fixpoint.js"
      ],
      "output": ["zena/out/cli-self2.wasm"],
      "dependencies": [
        "source",
        "../stdlib:lib",
        "build:scripts",
        {
          "script": "build:self-hosted",
          "cascade": false
        },
        {
          "script": "test:execution:o2",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    },
    "test:component": {
      "command": "node scripts/component-e2e.js",
      "files": [
        "scripts/component-e2e.js",
        "test-files/component/**/*.zena",
        "test-files/component/**/*.wit",
        "zena/out/cli.wasm"
      ],
      "output": ["zena/out/component/**/*.wasm"],
      "dependencies": [
        "build:scripts",
        {
          "script": "precompile:cli",
          "cascade": false
        },
        "../zena-cli:build",
        "../stdlib:lib"
      ]
    },
    "test:smoke": {
      "#": "Every compiler test but the fixpoint check. See the root package's test:smoke for when to reach for it.",
      "dependencies": [
        "test:unit",
        "test:component",
        "test:syntax",
        "test:semantics",
        "test:execution",
        "test:execution:o2",
        "test:interop"
      ]
    },
    "precompile:cli": {
      "command": "../../target/release/zena-cli precompile zena/out/cli.wasm",
      "files": ["zena/out/cli.wasm"],
      "output": ["zena/out/cli.cwasm"],
      "dependencies": [
        {
          "script": "build:cli",
          "cascade": false
        },
        "../zena-cli:build"
      ]
    }
  }
}
