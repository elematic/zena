/** String helpers the generator shares. */

import {StringBuilder} from 'zena:core';

/** `items` joined with `separator` between each pair. */
export function joinStrings(items: Array<String>, separator: String): String {
  let out = new StringBuilder();
  var first = true;
  for (let item in items) {
    if (!first) {
      out.append(separator);
    }
    out.append(item);
    first = false;
  }
  return out.toString();
}
