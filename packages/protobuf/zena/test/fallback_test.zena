/**
 * The fallback transport, end to end: a `zena:http` server in the same
 * program answers `$rpc` requests the way Google's front end does, and the
 * generated client calls it over `wasi:http`.
 */

import { suite, test } from 'zena:test';
import { equal, isTrue } from 'zena:assert';
import { AsyncIterable, AsyncIterator, Completer, Future, runFuture } from 'zena:async';
import { StreamWriter } from 'zena:stream';
import { App, Request, Response, Server } from 'zena:http';
import { FallbackTransport, RpcError, codeForHttpStatus, readStreamBody } from '../fallback.zena';
import { Credentials, ProtoView, ProtoWriter, RpcMetadata, RpcMethod } from '../runtime.zena';
import { Node, ThingsClient } from '../../test-files/generated/everything.zena';

/** An encoded `google.rpc.Status`. */
function statusOf(code: i32, message: String) {
  let w = new ProtoWriter();
  if (code != 0) {
    w.int32(1, code);
  }
  w.string(2, message);
  return w.finish();
}

/** A `google.rpc.StreamBody` holding `messages` and then `status`. */
function streamBodyOf(messages: Array<ProtoView>, status: ProtoView) {
  let w = new ProtoWriter();
  w.bytes(15, (new ProtoWriter()).finish().toByteArray());
  for (let m in messages) {
    w.message(1, m);
  }
  w.message(2, status);
  return w.finish();
}

function respond(res: Response, status: i32, body: ProtoView) {
  res.statusCode = status;
  res.type = 'application/x-protobuf';
  res.body = body.toByteArray() as FixedArray<u8>;
}

/**
 * Answers `/$rpc/zena.test.v1.Things/<method>` like the fallback protocol:
 * GetNode echoes the node with `!` appended and the authorization header
 * in `from`; ListNodes streams three nodes; Fail answers a
 * `google.rpc.Status`; FailStream streams one node and then an error.
 */
function rpcServer() {
  let app = new App();
  app.use(async (req, res, next): Future<void> => {
    let prefix = '/$rpc/zena.test.v1.Things/';
    if (req.method != 'POST' || !req.path.startsWith(prefix) ||
        req.getHeader('content-type') != 'application/x-protobuf') {
      res.statusCode = 404;
      res.type = 'text/html';
      res.body = '<html>not here</html>';
      return;
    }
    let method = req.path.sliceBytes(prefix.length, req.path.length);
    let request = Node.decode((await req.bytes()) as ByteArray);
    if (method == 'GetNode') {
      let auth = req.getHeader('authorization');
      let routing = req.getHeader('x-goog-request-params');
      respond(res, 200, Node.of({
        name: `${request.name}!`,
        from: auth ?? '',
        text: routing ?? '',
      }).protoView);
    } else if (method == 'ListNodes') {
      let nodes = new GrowableArray<ProtoView>();
      for (var i = 0; i < 3; i += 1) {
        nodes.push(Node.of({name: `${request.name}${i}`}).protoView);
      }
      respond(res, 200, streamBodyOf(nodes, statusOf(0, '')));
    } else if (method == 'Fail') {
      respond(res, 403, statusOf(7, 'permission denied'));
    } else if (method == 'FailStream') {
      let nodes = new GrowableArray<ProtoView>();
      nodes.push(Node.of({name: 'first'}).protoView);
      respond(res, 200, streamBodyOf(nodes, statusOf(9, 'precondition failed')));
    } else {
      res.statusCode = 501;
      res.body = 'unimplemented';
    }
  });
  let server = new Server(app, 0 as u16);
  server.start();
  return server;
}

/**
 * Writes the first `split` bytes of `bytes`, waits for `release`, then
 * writes the rest one byte at a time and closes.
 */
async function produce(
  writer: StreamWriter<u8>,
  bytes: FixedArray<u8>,
  split: i32,
  release: Future<void>
): Future<void> {
  for (var i = 0; i < split; i += 1) {
    await writer.write(bytes[i]);
  }
  await release;
  for (var i = split; i < bytes.length; i += 1) {
    await writer.write(bytes[i]);
  }
  writer.close();
}

/**
 * Reads a StreamBody whose producer holds back everything after the first
 * response until the reader has seen it, so it passes only if each response
 * is handed out as soon as its bytes are in.
 */
async function incrementalRead(): Future<String> {
  let first = Node.of({name: 'first'}).protoView;
  let nodes = new GrowableArray<ProtoView>();
  nodes.push(first);
  nodes.push(Node.of({name: 'second'}).protoView);
  let encoded = streamBodyOf(nodes, statusOf(0, '')).toByteArray() as FixedArray<u8>;
  // The padding field (2 bytes) and the first message's field.
  let split = 2 + 2 + first.byteLength;
  let writer = new StreamWriter<u8>();
  let release = new Completer<void>();
  produce(writer, encoded, split, release.future);
  var names = '';
  for await (let view in new StreamIterable(readStreamBody(writer.stream))) {
    names = `${names}${Node.decode(view.toByteArray()).name},`;
    release.tryComplete(unit());
  }
  return names;
}

function unit(): void {}

function originOf(server: Server) {
  return `http://127.0.0.1:${server.port as i32}`;
}

async function unaryCall(server: Server): Future<String> {
  let transport = new FallbackTransport(originOf(server));
  transport.setHeader('authorization', 'Bearer t0k3n');
  let client = new ThingsClient(transport);
  let node = await client.getNode({name: 'ping'});
  return `${node.name} ${node.from}`;
}

/** Hands out a token that changes on every call, as a refreshing token source might. */
final class CountingCredentials implements Credentials {
  var #calls: i32 = 0;
  async authorization(): Future<String | null> {
    this.#calls += 1;
    return `Bearer token-${this.#calls}`;
  }
}

async function credentialedCalls(server: Server): Future<String> {
  let client = new ThingsClient(new FallbackTransport(originOf(server), new CountingCredentials()));
  let first = await client.getNode({name: 'nodes/a'});
  let second = await client.getNode({name: 'nodes/b'});
  return `${first.from} ${first.text} | ${second.from} ${second.text}`;
}

async function streamingCall(server: Server): Future<String> {
  let client = new ThingsClient(new FallbackTransport(originOf(server)));
  var names = '';
  for await (let node in client.listNodes({name: 'n'})) {
    names = `${names}${node.name},`;
  }
  return names;
}

/** The code and message a failing call throws, as `code: message`. */
async function failure(call: () => Future<String>): Future<String> {
  try {
    await call();
  } catch (e) {
    if (e is RpcError) {
      let error = e;
      return `${error.code}: ${error.message}`;
    }
    return `not an RpcError: ${e.message}`;
  }
  return 'no error';
}

export let tests = suite('fallback transport', () => {
  test('calls a unary method, sending the headers set', () => {
    let server = rpcServer();
    equal(runFuture(unaryCall(server)), 'ping! Bearer t0k3n');
    server.close();
  });

  test('asks the credentials before each call and sends the routing header', () => {
    let server = rpcServer();
    equal(runFuture(credentialedCalls(server)),
        'Bearer token-1 name=nodes%2Fa | Bearer token-2 name=nodes%2Fb');
    server.close();
  });

  test('reads a server-streaming response as it arrives', () => {
    let server = rpcServer();
    equal(runFuture(streamingCall(server)), 'n0,n1,n2,');
    server.close();
  });

  test('hands out each streamed response once its bytes are in', () => {
    equal(runFuture(incrementalRead()), 'first,second,');
  });

  test('throws the status of a failed unary call', () => {
    let server = rpcServer();
    let transport = new FallbackTransport(originOf(server));
    let result = runFuture(failure(async (): Future<String> => {
      await transport.unary(new RpcMethod('zena.test.v1.Things', 'Fail'), Node.of({name: 'x'}).protoView, new RpcMetadata());
      return 'ok';
    }));
    equal(result, '7: permission denied');
    server.close();
  });

  test('throws the status that ends a failed stream, after its responses', () => {
    let server = rpcServer();
    let transport = new FallbackTransport(originOf(server));
    let result = runFuture(failure(async (): Future<String> => {
      var seen = '';
      let stream = transport.serverStream(new RpcMethod('zena.test.v1.Things', 'FailStream'), Node.of({name: 'x'}).protoView, new RpcMetadata());
      let reader = new StreamIterable(stream);
      for await (let view in reader) {
        seen = `${seen}${Node.decode(view.toByteArray()).name}`;
      }
      return seen;
    }));
    equal(result, '9: precondition failed');
    server.close();
  });

  test('maps an error response without a status by its HTTP code', () => {
    let server = rpcServer();
    let transport = new FallbackTransport(originOf(server));
    let result = runFuture(failure(async (): Future<String> => {
      await transport.unary(new RpcMethod('zena.test.v1.Elsewhere', 'Get'), Node.of({name: 'x'}).protoView, new RpcMetadata());
      return 'ok';
    }));
    equal(result, '5: the server answered with HTTP 404');
    server.close();
    equal(codeForHttpStatus(401), 16);
    equal(codeForHttpStatus(503), 14);
    equal(codeForHttpStatus(418), 2);
  });
});

/** Lets a bare `AsyncIterator` be the subject of a `for await`. */
final class StreamIterable implements AsyncIterable<ProtoView> {
  #iterator: AsyncIterator<ProtoView>;
  new(iterator: AsyncIterator<ProtoView>) : #iterator = iterator;
  [AsyncIterable.asyncIterator](): AsyncIterator<ProtoView> {
    return this.#iterator;
  }
}
