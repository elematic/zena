  "scripts": {
    "test": {
      "#command": "The lexer, parser, generator and runtime, and the generated code compiled and run. Runs from the repository root, which is what the paths inside the tests are relative to and where the compiler finds the package map. Regenerate the checked-in generated modules with UPDATE_PROTO_GOLDENS=1.",
      "command": "cd ../.. && ./target/release/zena-cli test \"packages/protobuf/test/*_test.zena\"",
      "files": [
        "test/**/*.zena",
        "bin/**/*.zena",
        "protos/**/*.proto",
        "test/fixtures/protos/**/*.proto",
        "test/fixtures/protoc/*.binpb"
      ],
      "dependencies": ["source", "../stdlib:lib", "../zena-cli:build"]
    }
