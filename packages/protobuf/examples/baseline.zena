/**
 * The standard library the Firestore examples use, without protobuf: a
 * future, a hash map and a console line. Subtracting its size from theirs
 * leaves what the generated code and the runtime cost.
 */

import {Future, runFuture} from 'zena:async';
import {HashMap} from 'zena:collections';

let lookup = async (fields: HashMap<String, String>): Future<String> => fields.getOr('title', '');

export let main = (): i32 => {
  let fields = new HashMap<String, String>();
  fields['title'] = 'Hello';
  console.log(runFuture(lookup(fields)));
  return 0;
};
