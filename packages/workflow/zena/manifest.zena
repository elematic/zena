import {Fingerprint} from './fingerprint.zena';

/**
 * One named output of a step. `dependsOn` optionally records which
 * inputs the output was derived from, by the engine's namespaced input
 * names ('leaf:src/a.ts', 'step:build'); null means it depends on all
 * of the step's inputs. The records are observations reported by the
 * step itself and drive fine-grained invalidation on the next run.
 */
export class OutputEntry {
  name: String;
  fingerprint: Fingerprint;
  dependsOn: Array<String>?;

  new(this.name, this.fingerprint, dependsOn: Array<String>? = null)
      : dependsOn = dependsOn;
}

/**
 * A step's result: its named outputs, each with a fingerprint. Plain
 * data — hosts store and serialize manifests; the library only compares
 * and fingerprints them.
 */
export class OutputManifest {
  outputs: Array<OutputEntry>;
  new(this.outputs);

  static empty(): OutputManifest {
    return new OutputManifest(new GrowableArray<OutputEntry>());
  }
}
