import {suite, test} from 'zena:test';
import {equal, fail, isFalse, isTrue} from 'zena:assert';
import {Completer, drainMicrotasks} from 'zena:async';
import {NullCache, StepCache} from '../cache.zena';
import {
  Engine,
  Failed,
  RunOptions,
  RunResult,
  Skipped,
  StepSource,
  Succeeded,
} from '../engine.zena';
import {CacheKey, Fingerprint} from '../fingerprint.zena';
import {Graph} from '../graph.zena';
import {OutputEntry, OutputManifest} from '../manifest.zena';
import {EngineState} from '../state.zena';
import {
  InputRef,
  LeafInput,
  LeafSet,
  RunContext,
  Step,
  StepKey,
  StepOrder,
  StepOutputs,
  TaskStep,
} from '../step.zena';

function digest(data: String) {
  return new Fingerprint('d#' + i32ToString(data.hashCode()));
}

/** A StepCache over a HashMap that counts lookups and stores. */
class InMemoryCache implements StepCache {
  entries = new HashMap<String, OutputManifest>();
  var gets: i32 = 0;
  var puts: i32 = 0;

  async get(step: StepKey, key: CacheKey): Future<OutputManifest?> {
    this.gets += 1;
    if (let (true, manifest) = this.entries.get(key.value)) {
      return manifest;
    }
    return null;
  }

  async put(step: StepKey, key: CacheKey, manifest: OutputManifest): Future<void> {
    this.puts += 1;
    this.entries[key.value] = manifest;
  }
}

/** Records run-callback invocations. */
class Runs {
  log = new GrowableArray<String>();

  record(name: String): void {
    this.log.push(name);
  }

  count(name: String): i32 {
    var n = 0;
    for (let entry in this.log) {
      if (entry == name) {
        n += 1;
      }
    }
    return n;
  }
}

let noStrings: Array<String> = new GrowableArray<String>();

function mkInputs(deps: Array<String>, leafNames: Array<String>): Array<InputRef> {
  let inputs = new GrowableArray<InputRef>();
  for (let leaf in leafNames) {
    inputs.push(new LeafInput(leaf));
  }
  for (let dep in deps) {
    inputs.push(new StepOutputs(new StepKey(dep)));
  }
  return inputs;
}

/** A step producing one output named after the step with fingerprint outFp. */
function mkStep(
  runs: Runs,
  key: String,
  deps: Array<String>,
  leafNames: Array<String>,
  outFp: String,
): Step {
  return new TaskStep(
    new StepKey(key),
    new Fingerprint('cfg:' + key),
    mkInputs(deps, leafNames),
    (ctx) => {
      runs.record(key);
      return Future.of(new OutputManifest([
        new OutputEntry('out/' + key, new Fingerprint(outFp)),
      ]));
    },
  );
}

function asStep(step: Step) {
  return step;
}

function sourceOf(result: RunResult, key: String): StepSource {
  let outcome = result.outcomeOf(new StepKey(key));
  if (outcome is Succeeded) {
    return outcome.source;
  }
  fail('step did not succeed: ' + key);
}

function isFailed(result: RunResult, key: String) {
  return result.outcomeOf(new StepKey(key)) is Failed;
}

function isSkipped(result: RunResult, key: String) {
  return result.outcomeOf(new StepKey(key)) is Skipped;
}

function isSucceeded(result: RunResult, key: String) {
  return result.outcomeOf(new StepKey(key)) is Succeeded;
}

function failureMessage(result: RunResult, key: String): String {
  let outcome = result.outcomeOf(new StepKey(key));
  if (outcome is Failed) {
    return outcome.error.message;
  }
  fail('expected step to fail: ' + key);
}

export let tests = suite('engine', () => {
  test('runs steps in dependency order', async (ctx) => {
    let runs = new Runs();
    let graph = new Graph([
      mkStep(runs, 'b', ['a'], noStrings, 'out-b'),
      mkStep(runs, 'a', noStrings, ['src'], 'out-a'),
    ]);
    let leaves: HashMap<String, Fingerprint> = {'src' => new Fingerprint('v1')};
    let engine = new Engine(digest, new NullCache());
    let result = await engine.run(graph, leaves, EngineState.empty());
    isTrue(result.allSucceeded);
    equal(runs.log.length, 2);
    equal(runs.log[0], 'a');
    equal(runs.log[1], 'b');
    isTrue(sourceOf(result, 'a') == StepSource.Ran);
    isTrue(sourceOf(result, 'b') == StepSource.Ran);
    equal(result.state.size, 2);
  });

  test('a second identical run is fresh and does nothing', async (ctx) => {
    let runs = new Runs();
    let graph = new Graph([
      mkStep(runs, 'a', noStrings, ['src'], 'out-a'),
      mkStep(runs, 'b', ['a'], noStrings, 'out-b'),
    ]);
    let leaves: HashMap<String, Fingerprint> = {'src' => new Fingerprint('v1')};
    let cache = new InMemoryCache();
    let engine = new Engine(digest, cache);
    let first = await engine.run(graph, leaves, EngineState.empty());
    let getsAfterFirst = cache.gets;
    let second = await engine.run(graph, leaves, first.state);
    isTrue(second.allSucceeded);
    equal(runs.count('a'), 1);
    equal(runs.count('b'), 1);
    isTrue(sourceOf(second, 'a') == StepSource.Fresh);
    isTrue(sourceOf(second, 'b') == StepSource.Fresh);
    // Fresh steps never consult the cache.
    equal(cache.gets, getsAfterFirst);
  });

  test('a leaf change reruns the reader; unchanged output cuts off there', async (ctx) => {
    let runs = new Runs();
    let mkGraph = () => new Graph([
      mkStep(runs, 'a', noStrings, ['src-a'], 'out-a'),
      mkStep(runs, 'b', noStrings, ['src-b'], 'out-b'),
      mkStep(runs, 'c', ['a', 'b'], noStrings, 'out-c'),
    ]);
    let leaves: HashMap<String, Fingerprint> = {
      'src-a' => new Fingerprint('v1'),
      'src-b' => new Fingerprint('v1'),
    };
    let engine = new Engine(digest, new NullCache());
    let first = await engine.run(mkGraph(), leaves, EngineState.empty());
    isTrue(first.allSucceeded);

    leaves['src-a'] = new Fingerprint('v2');
    let second = await engine.run(mkGraph(), leaves, first.state);
    isTrue(second.allSucceeded);
    equal(runs.count('a'), 2);
    equal(runs.count('b'), 1);
    // `a` reran but produced the same manifest, so `c` stayed fresh.
    equal(runs.count('c'), 1);
    isTrue(sourceOf(second, 'c') == StepSource.Fresh);
  });

  test('a changed dependency output reruns the dependent', async (ctx) => {
    let runs = new Runs();
    let leaves: HashMap<String, Fingerprint> = {'src' => new Fingerprint('v1')};
    let engine = new Engine(digest, new NullCache());
    let g1 = new Graph([
      mkStep(runs, 'a', noStrings, ['src'], 'out-a-v1'),
      mkStep(runs, 'c', ['a'], noStrings, 'out-c'),
    ]);
    let first = await engine.run(g1, leaves, EngineState.empty());

    leaves['src'] = new Fingerprint('v2');
    let g2 = new Graph([
      mkStep(runs, 'a', noStrings, ['src'], 'out-a-v2'),
      mkStep(runs, 'c', ['a'], noStrings, 'out-c'),
    ]);
    let second = await engine.run(g2, leaves, first.state);
    isTrue(second.allSucceeded);
    equal(runs.count('a'), 2);
    equal(runs.count('c'), 2);
  });

  test('the cache restores results when state is lost', async (ctx) => {
    let runs = new Runs();
    let mkGraph = () => new Graph([
      mkStep(runs, 'a', noStrings, ['src'], 'out-a'),
    ]);
    let leaves: HashMap<String, Fingerprint> = {'src' => new Fingerprint('v1')};
    let cache = new InMemoryCache();
    let engine = new Engine(digest, cache);
    await engine.run(mkGraph(), leaves, EngineState.empty());
    equal(cache.puts, 1);

    let second = await engine.run(mkGraph(), leaves, EngineState.empty());
    equal(runs.count('a'), 1);
    isTrue(sourceOf(second, 'a') == StepSource.Cache);
  });

  test('a failure skips dependents and spares the rest', async (ctx) => {
    let runs = new Runs();
    let bad: Step = new TaskStep(
      new StepKey('bad'),
      new Fingerprint('cfg:bad'),
      mkInputs(noStrings, noStrings),
      async (ctx): Future<OutputManifest> => {
        throw new Error('boom');
      },
    );
    let graph = new Graph([
      bad,
      mkStep(runs, 'child', ['bad'], noStrings, 'out'),
      mkStep(runs, 'other', noStrings, noStrings, 'out'),
    ]);
    let engine = new Engine(digest, new NullCache());
    let result = await engine.run(
      graph,
      new HashMap<String, Fingerprint>(),
      EngineState.empty(),
    );
    isFalse(result.allSucceeded);
    isTrue(isFailed(result, 'bad'));
    isTrue(isSkipped(result, 'child'));
    isTrue(isSucceeded(result, 'other'));
    equal(runs.count('child'), 0);
    equal(runs.count('other'), 1);
  });

  test('an unknown leaf fails the step', async (ctx) => {
    let runs = new Runs();
    let graph = new Graph([
      mkStep(runs, 'a', noStrings, ['ghost'], 'out'),
      mkStep(runs, 'b', ['a'], noStrings, 'out'),
    ]);
    let engine = new Engine(digest, new NullCache());
    let result = await engine.run(
      graph,
      new HashMap<String, Fingerprint>(),
      EngineState.empty(),
    );
    isTrue(failureMessage(result, 'a').contains('unknown leaf input "ghost"'));
    isTrue(isSkipped(result, 'b'));
  });

  test('a config change alone reruns the step', async (ctx) => {
    let runs = new Runs();
    let leaves: HashMap<String, Fingerprint> = {'src' => new Fingerprint('v1')};
    let engine = new Engine(digest, new NullCache());
    let mkWithConfig = (config: String) => new Graph([
      asStep(new TaskStep(
        new StepKey('a'),
        new Fingerprint(config),
        mkInputs(noStrings, ['src']),
        (ctx) => {
          runs.record('a');
          return Future.of(OutputManifest.empty());
        },
      )),
    ]);
    let first = await engine.run(mkWithConfig('c1'), leaves, EngineState.empty());
    let second = await engine.run(mkWithConfig('c2'), leaves, first.state);
    equal(runs.count('a'), 2);
    isTrue(sourceOf(second, 'a') == StepSource.Ran);
  });

  test('duplicate output names fail the producing step', async (ctx) => {
    let bad: Step = new TaskStep(
      new StepKey('bad'),
      new Fingerprint('cfg'),
      mkInputs(noStrings, noStrings),
      (ctx) => Future.of(new OutputManifest([
        new OutputEntry('x', new Fingerprint('1')),
        new OutputEntry('x', new Fingerprint('2')),
      ])),
    );
    let engine = new Engine(digest, new NullCache());
    let result = await engine.run(
      new Graph([bad]),
      new HashMap<String, Fingerprint>(),
      EngineState.empty(),
    );
    isTrue(failureMessage(result, 'bad').contains('duplicate output name'));
  });

  test('parallelism is bounded', async (ctx) => {
    var current = 0;
    var maxSeen = 0;
    let gate = new Completer<void>();
    let slow = (key: String): Step => new TaskStep(
      new StepKey(key),
      new Fingerprint('cfg:' + key),
      mkInputs(noStrings, noStrings),
      async (ctx): Future<OutputManifest> => {
        current += 1;
        if (current > maxSeen) {
          maxSeen = current;
        }
        await gate.future;
        current -= 1;
        return OutputManifest.empty();
      },
    );
    let graph = new Graph([slow('a'), slow('b'), slow('c')]);
    let engine = new Engine(digest, new NullCache());
    let running = engine.run(
      graph,
      new HashMap<String, Fingerprint>(),
      EngineState.empty(),
      new RunOptions(2),
    );
    drainMicrotasks();
    equal(current, 2);
    gate.complete();
    let result = await running;
    isTrue(result.allSucceeded);
    equal(maxSeen, 2);
  });

  test('StepOrder orders execution without contributing to cache keys, and LeafSet resolves after upstream runs', async (ctx) => {
    let runs = new Runs();
    var generatedFp = 'missing';
    var producerRun = 0;

    let mkGraph = () => {
      let producer: Step = new TaskStep(
        new StepKey('cargo'),
        // Changing config every run forces cargo to rerun with a new output manifest.
        new Fingerprint('cfg:' + i32ToString(producerRun)),
        new GrowableArray<InputRef>(),
        (ctx) => {
          producerRun += 1;
          runs.record('cargo');
          if (generatedFp == 'missing') {
            generatedFp = 'bin-v1';
          }
          return Future.of(new OutputManifest([
            new OutputEntry('$volatile', new Fingerprint('vol:' + i32ToString(producerRun))),
          ]));
        },
      );
      let bridgeInputs = new GrowableArray<InputRef>();
      bridgeInputs.push(new StepOrder(new StepKey('cargo')));
      bridgeInputs.push(new LeafSet('files', async (): Future<Array<(String, Fingerprint)>> => {
        let pairs = new GrowableArray<(String, Fingerprint)>();
        pairs.push(('target/bin', new Fingerprint(generatedFp)));
        return pairs;
      }));
      let bridge: Step = new TaskStep(
        new StepKey('binary'),
        new Fingerprint('cfg:binary'),
        bridgeInputs,
        (ctx) => {
          runs.record('binary');
          let out = new GrowableArray<OutputEntry>();
          for (let inp in ctx.inputs) {
            out.push(new OutputEntry('$in:' + inp.name, new Fingerprint('ref:' + inp.fingerprint.value)));
          }
          return Future.of(new OutputManifest(out));
        },
      );
      return new Graph([bridge, producer]);
    };

    let engine = new Engine(digest, new NullCache());
    let first = await engine.run(mkGraph(), new HashMap<String, Fingerprint>(), EngineState.empty());
    isTrue(first.allSucceeded);
    equal(runs.log[0], 'cargo');
    equal(runs.log[1], 'binary');

    // Second run: cargo reruns and produces a new manifest, but binary's
    // StepOrder ignores cargo's manifest and sees target/bin still at bin-v1.
    let second = await engine.run(mkGraph(), new HashMap<String, Fingerprint>(), first.state);
    isTrue(second.allSucceeded);
    equal(runs.count('cargo'), 2);
    equal(runs.count('binary'), 1);
    isTrue(sourceOf(second, 'binary') == StepSource.Fresh);

    // Third run: target/bin changes to bin-v2, so binary reruns.
    generatedFp = 'bin-v2';
    let third = await engine.run(mkGraph(), new HashMap<String, Fingerprint>(), second.state);
    isTrue(third.allSucceeded);
    equal(runs.count('binary'), 2);
    isTrue(sourceOf(third, 'binary') == StepSource.Ran);
  });

  test('StepOrder skips dependents without running LeafSet when upstream fails', async (ctx) => {
    var leafSetCalled = false;
    let bad: Step = new TaskStep(
      new StepKey('bad'),
      new Fingerprint('cfg:bad'),
      new GrowableArray<InputRef>(),
      async (ctx): Future<OutputManifest> => {
        throw new Error('compile failed');
      },
    );
    let childInputs = new GrowableArray<InputRef>();
    childInputs.push(new StepOrder(new StepKey('bad')));
    childInputs.push(new LeafSet('files', async (): Future<Array<(String, Fingerprint)>> => {
      leafSetCalled = true;
      return new GrowableArray<(String, Fingerprint)>();
    }));
    let child: Step = new TaskStep(
      new StepKey('child'),
      new Fingerprint('cfg:child'),
      childInputs,
      (ctx) => Future.of(OutputManifest.empty()),
    );
    let engine = new Engine(digest, new NullCache());
    let result = await engine.run(
      new Graph([bad, child]),
      new HashMap<String, Fingerprint>(),
      EngineState.empty(),
    );
    isTrue(isFailed(result, 'bad'));
    isTrue(isSkipped(result, 'child'));
    isFalse(leafSetCalled);
  });

  test('verifyOutputs falls back to cache or rerun while keeping prior manifest, and force bypasses both', async (ctx) => {
    var sawPriorOnRerun = false;
    var stepRuns = 0;
    let step: Step = new TaskStep(
      new StepKey('compile'),
      new Fingerprint('cfg:1'),
      [new LeafInput('src.zena')],
      (ctx) => {
        stepRuns += 1;
        if (ctx.previous != null) {
          sawPriorOnRerun = true;
        }
        return Future.of(new OutputManifest([
          new OutputEntry('out.wasm', new Fingerprint('fp:' + i32ToString(stepRuns))),
        ]));
      },
    );
    let graph = new Graph([step]);
    let leaves = {'src.zena' => new Fingerprint('in:1')};
    let cache = new InMemoryCache();
    let engine = new Engine(digest, cache);

    // Run 1 populates state and cache.
    let r1 = await engine.run(graph, leaves, EngineState.empty());
    isTrue(sourceOf(r1, 'compile') == StepSource.Ran);
    equal(stepRuns, 1);

    // Run 2 with verifyOutputs returning false restores from cache without rerunning.
    let optsMissing = new RunOptions(8, false, async (key, manifest): Future<boolean> => false);
    let r2 = await engine.run(graph, leaves, r1.state, optsMissing);
    isTrue(sourceOf(r2, 'compile') == StepSource.Cache);
    equal(stepRuns, 1);

    // Run 3 against an empty cache with verifyOutputs returning false reruns
    // the callback and still passes prior.manifest on RunContext.
    let uncachedEngine = new Engine(digest, new NullCache());
    let r3 = await uncachedEngine.run(graph, leaves, r2.state, optsMissing);
    isTrue(sourceOf(r3, 'compile') == StepSource.Ran);
    equal(stepRuns, 2);
    isTrue(sawPriorOnRerun);

    // Run 4 with force: true bypasses both Fresh and InMemoryCache.get,
    // executes the callback, and updates the cache.
    let putsBefore = cache.puts;
    let r4 = await engine.run(graph, leaves, r2.state, new RunOptions(8, true));
    isTrue(sourceOf(r4, 'compile') == StepSource.Ran);
    equal(stepRuns, 3);
    equal(cache.puts, putsBefore + 1);
  });

  test('onStepStart and onStepFinish observe task execution and freshness', async (ctx) => {
    let events = new GrowableArray<String>();
    let step: Step = new TaskStep(
      new StepKey('compile'),
      new Fingerprint('cfg:1'),
      [new LeafInput('src.zena')],
      (ctx) => {
        events.push('run:compile');
        return Future.of(new OutputManifest([
          new OutputEntry('out.wasm', new Fingerprint('fp:1')),
        ]));
      },
    );
    let graph = new Graph([step]);
    let leaves = {'src.zena' => new Fingerprint('in:1')};
    let engine = new Engine(digest, new NullCache());
    let opts = new RunOptions(
      8,
      false,
      null,
      null,
      (key) => {
        events.push('start:' + key.value);
      },
      (key, outcome) => {
        if (outcome is Succeeded) {
          let src = if (outcome.source == StepSource.Ran) 'ran' else 'fresh';
          events.push(`finish:${key.value}:${src}`);
        }
      },
    );

    let r1 = await engine.run(graph, leaves, EngineState.empty(), opts);
    isTrue(r1.allSucceeded);
    equal(events.length, 3);
    equal(events[0], 'start:compile');
    equal(events[1], 'run:compile');
    equal(events[2], 'finish:compile:ran');

    let r2 = await engine.run(graph, leaves, r1.state, opts);
    isTrue(r2.allSucceeded);
    equal(events.length, 4);
    equal(events[3], 'finish:compile:fresh');
  });
});
