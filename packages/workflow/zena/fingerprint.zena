/**
 * A digest of some content, produced by the host — typically a content
 * hash of a file, or a digest of configuration. The library compares
 * fingerprints and combines them into cache keys; it never computes one
 * from raw bytes.
 */
export class Fingerprint(value: String)

/**
 * Identifies a cached step result: a digest of the step's config
 * fingerprint and its resolved input fingerprints. Derived in
 * `canonical.zena`.
 */
export class CacheKey(value: String)

/**
 * A host-supplied digest function over canonical encodings. Hosts that
 * share a cache must use the same digest.
 */
export type Digest = (data: String) => Fingerprint;
