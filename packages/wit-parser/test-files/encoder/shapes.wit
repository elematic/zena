// Every structural type constructor the encoder handles, in one
// interface: records, variants, enums, flags, tuples, lists, options,
// results in all three arities, and `type` aliases of both a named type
// and a primitive.
package test:shapes@1.2.3;

interface geometry {
  record point {
    x: u32,
    y: u32,
  }

  type coord = point;
  type meters = u64;

  enum axis {
    x,
    y,
    z,
  }

  flags style {
    bold,
    italic,
  }

  variant shade {
    empty,
    gray(u8),
    rgb(point),
  }

  record label {
    text: string,
    at: point,
    tags: list<string>,
  }

  area: func(p: point) -> u32;
  find: func(name: string, limit: option<u32>) -> result<list<point>, string>;
  pick: func(which: axis, pair: tuple<point, point>) -> point;
  style-of: func(l: label) -> style;
  describe: func(s: shade) -> string;
  origin: func() -> coord;
  span-of: func(m: meters) -> result;
  clamp: func(v: s64, lo: f64, hi: f64) -> result<_, string>;
}

world shapes {
  import geometry;
}
