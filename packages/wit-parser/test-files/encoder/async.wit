// Streams and futures as value types — the C6 handle shapes. The
// element is optional (`future` alone signals bare completion), a
// named element resolves through the interface's own types, and the
// wasi 0.3 stdio idiom (a stream in, an outcome future back) round-
// trips as declared.
package test:events@0.1.0;

interface events {
  enum fail-code {
    overrun,
    closed,
  }

  poll: func() -> stream<u8>;
  publish: func(data: stream<u8>) -> future<result<_, fail-code>>;
  splice: func(sources: stream<stream<u8>>) -> tuple<stream<u8>, future>;
  watch: async func(interest: u32) -> future<fail-code>;
}

world event-host {
  import events;
}
