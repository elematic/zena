// Seventy named types in one instance type: indices past 63 in
// value-type position must be signed LEB128 (two bytes), because the
// primitive opcodes occupy the negative range. wasm-tools rejects the
// unsigned spelling, so this fixture is what keeps the encoding honest.
package test:wide@0.0.1;

interface many {
  record r0 { v0: u32, }
  record r1 { v1: u32, }
  record r2 { v2: u32, }
  record r3 { v3: u32, }
  record r4 { v4: u32, }
  record r5 { v5: u32, }
  record r6 { v6: u32, }
  record r7 { v7: u32, }
  record r8 { v8: u32, }
  record r9 { v9: u32, }
  record r10 { v10: u32, }
  record r11 { v11: u32, }
  record r12 { v12: u32, }
  record r13 { v13: u32, }
  record r14 { v14: u32, }
  record r15 { v15: u32, }
  record r16 { v16: u32, }
  record r17 { v17: u32, }
  record r18 { v18: u32, }
  record r19 { v19: u32, }
  record r20 { v20: u32, }
  record r21 { v21: u32, }
  record r22 { v22: u32, }
  record r23 { v23: u32, }
  record r24 { v24: u32, }
  record r25 { v25: u32, }
  record r26 { v26: u32, }
  record r27 { v27: u32, }
  record r28 { v28: u32, }
  record r29 { v29: u32, }
  record r30 { v30: u32, }
  record r31 { v31: u32, }
  record r32 { v32: u32, }
  record r33 { v33: u32, }
  record r34 { v34: u32, }
  record r35 { v35: u32, }
  record r36 { v36: u32, }
  record r37 { v37: u32, }
  record r38 { v38: u32, }
  record r39 { v39: u32, }
  record r40 { v40: u32, }
  record r41 { v41: u32, }
  record r42 { v42: u32, }
  record r43 { v43: u32, }
  record r44 { v44: u32, }
  record r45 { v45: u32, }
  record r46 { v46: u32, }
  record r47 { v47: u32, }
  record r48 { v48: u32, }
  record r49 { v49: u32, }
  record r50 { v50: u32, }
  record r51 { v51: u32, }
  record r52 { v52: u32, }
  record r53 { v53: u32, }
  record r54 { v54: u32, }
  record r55 { v55: u32, }
  record r56 { v56: u32, }
  record r57 { v57: u32, }
  record r58 { v58: u32, }
  record r59 { v59: u32, }
  record r60 { v60: u32, }
  record r61 { v61: u32, }
  record r62 { v62: u32, }
  record r63 { v63: u32, }
  record r64 { v64: u32, }
  record r65 { v65: u32, }
  record r66 { v66: u32, }
  record r67 { v67: u32, }
  record r68 { v68: u32, }
  record r69 { v69: u32, }

  last: func(a: r68) -> r69;
  spread: func(xs: list<r69>) -> option<r0>;
}

world wide {
  import many;
}
