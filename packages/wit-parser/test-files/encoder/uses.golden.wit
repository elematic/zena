package root:component;

world root {
  import test:web/types@2.0.0;
  import test:web/client@2.0.0;
  import test:web/pool@2.0.0;
}
package test:web@2.0.0 {
  interface types {
    record request {
      url: string,
      body: option<list<u8>>,
    }

    record response {
      status: u16,
      body: list<u8>,
    }

    resource session {
      constructor();
      send: func(r: request) -> response;
    }
  }
  interface client {
    use types.{request, response as reply, session};

    fetch: func(r: request) -> reply;

    fetch-with: func(s: borrow<session>, r: request) -> reply;
  }
  interface pool {
    use types.{session};

    acquire: func() -> session;
  }
}
