// World-level imports that are not interfaces: bare functions, whose
// types live at component level, and an inline interface. The export is
// skipped by a types-only encoding — the golden shows imports only.
package test:host@0.1.0;

world tools {
  import log: func(level: u8, message: string);
  import fetch-bytes: func(url: string) -> result<list<u8>, string>;
  import now: func() -> u64;
  import config: interface {
    get-flag: func(name: string) -> option<string>;
  }

  export run: func() -> u32;
}
