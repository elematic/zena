/**
 * Assembling and querying WIT documents, for the parser's consumers.
 *
 * The parser takes a source string; these are the steps just before
 * and after it that every consumer repeats — joining a package
 * directory's files into one document in a canonical way, and finding
 * an interface in the parsed result. They live here rather than in
 * each consumer because their behavior is contract: the compiler's
 * `--wit` flag and its WIT-backed packages must agree on what "a
 * directory of WIT" means, whether the host reads it from disk or
 * holds it in memory.
 *
 * Nothing here does I/O. The caller reads the files.
 */

import {
  Ast, AstItem, AstItemTag, InterfaceDef, PackageName
} from './parser.zena';

/** Byte-wise string order, for a listing that reads the same everywhere. */
let byteCompare = (a: String, b: String): i32 => {
  var minLen = a.length;
  if (b.length < minLen) {
    minLen = b.length;
  }
  for (var i = 0; i < minLen; i += 1) {
    let d = a.getByteAt(i) - b.getByteAt(i);
    if (d != 0) {
      return d;
    }
  }
  return a.length - b.length;
};

/** One file of a WIT package directory: its name and its text. */
export final class WitFile {
  name: String;
  source: String;
  new(this.name, this.source);
}

/**
 * The document a directory of WIT makes: its `.wit` files concatenated
 * in byte order of their names, each followed by a newline. Files with
 * other extensions are left out, and with no `.wit` files the document
 * is empty.
 */
export function joinWitFiles(files: Array<WitFile>): String {
  let wit = new GrowableArray<WitFile>();
  for (let file in files) {
    if (file.name.endsWith(".wit")) {
      wit.push(file);
    }
  }
  // Name order, so the document is the same however the host lists.
  for (var a = 0; a < wit.length; a += 1) {
    for (var b = a + 1; b < wit.length; b += 1) {
      if (byteCompare(wit[b].name, wit[a].name) < 0) {
        let t = wit[a];
        wit[a] = wit[b];
        wit[b] = t;
      }
    }
  }
  var source = "";
  for (let file in wit) {
    source = source + file.source + "\n";
  }
  return source;
}

/** One interface of a parsed document, with its package's name. */
export final class FoundInterface {
  def: InterfaceDef;
  packageName: PackageName;
  new(this.def, this.packageName);
}

/**
 * The interface `namespace:interfacePath` (`pkg/iface`) in `ast`, from
 * the main package or a nested one.
 *
 * Versions are the WIT's own business — callers resolve by unversioned
 * name — so matching ignores them, and two versions of one interface
 * in the same document is an error rather than a guess.
 */
export function findInterface(
  ast: Ast,
  namespace: String,
  interfacePath: String
): FoundInterface {
  let found = findInterfaceOrNull(ast, namespace, interfacePath);
  if (found == null) {
    throw new Error("WIT interface '" + namespace + ":" + interfacePath +
        "' is not declared by the package's WIT.");
  }
  return found as FoundInterface;
}

/** `findInterface`, but an absent interface is null rather than a
 * throw — for callers with their own way of saying no, like a `use`
 * hop reported as a per-member skip. A duplicate still throws. */
export function findInterfaceOrNull(
  ast: Ast,
  namespace: String,
  interfacePath: String
): FoundInterface | null {
  var found: FoundInterface | null = null;
  var matches = 0;
  let consider = (pkg: PackageName | null, items: Array<AstItem>): void => {
    if (pkg == null) {
      return;
    }
    let p = pkg as PackageName;
    for (let item in items) {
      if (item.tag != AstItemTag.Interface) {
        continue;
      }
      let def = item.interfaceDef as InterfaceDef;
      let path = p.name.name + "/" + def.name.name;
      if (p.namespace.name == namespace && path == interfacePath) {
        found = new FoundInterface(def, p);
        matches += 1;
      }
    }
  };
  consider(ast.packageName, ast.items);
  for (let nested in ast.nestedPackages) {
    consider(nested.name, nested.items);
  }
  if (matches > 1) {
    throw new Error("WIT interface '" + namespace + ":" + interfacePath +
        "' is declared more than once (differing versions?) — pin one.");
  }
  return found;
}
