/**
 * WIT AST to JSON Serializer
 * 
 * Test utility for serializing parsed WIT AST to the JSON format
 * used by the wit-parser test suite (matching wasm-tools output).
 */

import {JsonBuilder} from 'zena:json';
import {Array} from 'zena:growable-array';
import {HashMap} from 'zena:map';
import {Option, Some, some, none} from 'zena:option';
import {i32ToString, parseI32} from 'zena:string-convert';
import {Ast, AstItem, AstItemTag, PackageName, NestedPackage, Id, Use, UseName, UsePath, UsePathTag, Include, IncludeName, ToplevelUse} from './parser.zena';
import {InterfaceDef, InterfaceItem, InterfaceItemTag} from './parser.zena';
import {WorldDef, WorldItem, WorldItemTag, ExternKind, ExternKindTag, Import, Export} from './parser.zena';
import {TypeDef, TypeDefTag, Type, TypeTag, NamedFunc, Func, Param, Field} from './parser.zena';
import {Case, EnumCaseDef, FlagDef, ResourceFunc, ResourceFuncTag, Docs, Attribute, AttributeTag} from './parser.zena';
import {console} from 'zena:console';
import {normalizeId, compareStrings, isPurelyNumeric, stringToInt, getPreIdentifiers, compareVersions, formatPackageName, comparePackageNames, comparePackageNameStrings} from './helpers.zena';
import {TypeRef, PrimitiveRef, IndexRef, TypeOwner, InterfaceOwner, WorldOwner, ScopeTypeElement, TypeDefElement, UseElement, RecordField, VariantCase, EnumCase, TypeEntry, TypeKind, TypeAlias, ListKind, FixedLengthListKind, OptionKind, ResultKind, RecordKind, TupleKind, FlagsKind, VariantKind, EnumKind, HandleKind, MapKind, FutureKind, StreamKind, UnknownKind, ResourceKind, PackageEntry, serializeStability} from './ast-json-types.zena';



let isExcluded = (docs: Docs | null, pkgName: PackageName | null): boolean => {
  if (docs == null || docs.attributes == null) {
    return false;
  }
  let attrs = docs.attributes as Array<Attribute>;
  var hasUnstable = false;
  var unstableActive = false;
  var hasSince = false;
  var sincePassed = false;
  var hasStability = false;
  
  var i = 0;
  while (i < attrs.length) {
    let attr = attrs[i];
    if (attr.tag == AttributeTag.Unstable) {
      hasStability = true;
      hasUnstable = true;
      let featureName = (attr.feature as Id).name;
      if (featureName == "active") {
        unstableActive = true;
      }
    } else if (attr.tag == AttributeTag.Since) {
      hasStability = true;
      hasSince = true;
      if (pkgName != null && (pkgName as PackageName).version != null) {
        let pkgVer = (pkgName as PackageName).version as String;
        let sinceVer = attr.version as String;
        if (compareVersions(pkgVer, sinceVer) >= 0) {
          sincePassed = true;
        }
      } else {
        sincePassed = true;
      }
    } else if (attr.tag == AttributeTag.Deprecated) {
      hasStability = true;
    }
    i = i + 1;
  }
  
  if (hasUnstable && !unstableActive) {
    return true;
  }
  
  if (hasStability) {
    if (unstableActive) {
      return false;
    }
    if (hasSince) {
      return !sincePassed;
    }
    return true;
  }
  
  return false;
};

let filterInterfaceItems = (iface: InterfaceDef, pkgName: PackageName | null): void => {
  let filtered = new Array<InterfaceItem>();
  var idx = 0;
  while (idx < iface.items.length) {
    let item = iface.items[idx];
    var keep = true;
    if (item.tag == InterfaceItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      if (isExcluded(td.docs, pkgName)) {
        keep = false;
      }
    } else if (item.tag == InterfaceItemTag.Func) {
      let func = item.func as NamedFunc;
      if (isExcluded(func.docs, pkgName)) {
        keep = false;
      }
    } else if (item.tag == InterfaceItemTag.Use) {
      let u = item.use as Use;
      if (isExcluded(u.docs, pkgName)) {
        keep = false;
      }
    }
    if (keep) {
      filtered.push(item);
    }
    idx = idx + 1;
  }
  iface.items = filtered;
};

let filterWorldItems = (world: WorldDef, pkgName: PackageName | null): void => {
  let filtered = new Array<WorldItem>();
  var idx = 0;
  while (idx < world.items.length) {
    let item = world.items[idx];
    var keep = true;
    if (item.tag == WorldItemTag.Import) {
      let imp = item.importItem as Import;
      if (isExcluded(imp.docs, pkgName)) {
        keep = false;
      }
    } else if (item.tag == WorldItemTag.Export) {
      let exp = item.exportItem as Export;
      if (isExcluded(exp.docs, pkgName)) {
        keep = false;
      }
    } else if (item.tag == WorldItemTag.Use) {
      let u = item.use as Use;
      if (isExcluded(u.docs, pkgName)) {
        keep = false;
      }
    } else if (item.tag == WorldItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      if (isExcluded(td.docs, pkgName)) {
        keep = false;
      }
    } else if (item.tag == WorldItemTag.Include) {
      let inc = item.include as Include;
      if (isExcluded(inc.docs, pkgName)) {
        keep = false;
      }
    }
    if (keep) {
      filtered.push(item);
    }
    idx = idx + 1;
  }
  world.items = filtered;
};

let filterGatedItems = (ast: Ast): void => {
  let filteredItems = new Array<AstItem>();
  var idx = 0;
  while (idx < ast.items.length) {
    let item = ast.items[idx];
    var keep = true;
    if (item.tag == AstItemTag.Interface) {
      let iface = item.interfaceDef as InterfaceDef;
      if (isExcluded(iface.docs, ast.packageName)) {
        keep = false;
      } else {
        filterInterfaceItems(iface, ast.packageName);
      }
    } else if (item.tag == AstItemTag.World) {
      let world = item.worldDef as WorldDef;
      if (isExcluded(world.docs, ast.packageName)) {
        keep = false;
      } else {
        filterWorldItems(world, ast.packageName);
      }
    }
    if (keep) {
      filteredItems.push(item);
    }
    idx = idx + 1;
  }
  ast.items = filteredItems;
  
  var pIdx = 0;
  while (pIdx < ast.nestedPackages.length) {
    let np = ast.nestedPackages[pIdx];
    let npItems = new Array<AstItem>();
    var idx2 = 0;
    while (idx2 < np.items.length) {
      let item = np.items[idx2];
      var keep = true;
      if (item.tag == AstItemTag.Interface) {
        let iface = item.interfaceDef as InterfaceDef;
        if (isExcluded(iface.docs, np.name)) {
          keep = false;
        } else {
          filterInterfaceItems(iface, np.name);
        }
      } else if (item.tag == AstItemTag.World) {
        let world = item.worldDef as WorldDef;
        if (isExcluded(world.docs, np.name)) {
          keep = false;
        } else {
          filterWorldItems(world, np.name);
        }
      }
      if (keep) {
        npItems.push(item);
      }
      idx2 = idx2 + 1;
    }
    np.items = npItems;
    pIdx = pIdx + 1;
  }
};

// ============================================================================
// Helper Classes
// ============================================================================

/**
 * Context that tracks registered packages, interfaces, worlds, and types,
 * along with their resolved indices and aliases during JSON serialization.
 */
class SerializeContext {
  var interfaces = new Array<InterfaceDef>();
  var worlds = new Array<WorldDef>();
  var types = new Array<TypeEntry>();
  var packages = new Array<PackageEntry>();
  var interfaceIndices = new HashMap<String, i32>();
  var worldIndices = new HashMap<String, i32>();
  var typeIndices = new HashMap<String, i32>();
  // Maps to track borrow/own types by resource index
  var borrowTypeIndices = new HashMap<i32, i32>();
  var ownTypeIndices = new HashMap<i32, i32>();
  // Map to track complex anonymous types by canonical key
  var anonTypeIndices = new HashMap<String, i32>();
  // Track which type indices are resources (for bare resource name -> own<resource> conversion)
  var resourceTypeIndices = new HashMap<i32, i32>();
  // Map to track top-level use aliases by package key (pkgKey/aliasName -> resolvedName)
  var useAliases = new HashMap<String, String>();
  var currentPackageIndex = 0;
  var currentInterfaceName: String | null = null;
  var currentWorldName: String | null = null;
  var currentInterfacePackageIndex = -1;
  var currentWorldPackageIndex = -1;

  resolveInterfaceAlias(pkgName: String, name: String): String {
    var cur = name;
    var iterations = 0;
    while (iterations < 10) {
      let key = pkgName + "/" + cur;
      if (let (true, resolved) = this.useAliases.get(key)) {
        cur = resolved;
        iterations = iterations + 1;
      } else {
        break;
      }
    }
    return cur;
  }

  registerInterface(iface: InterfaceDef): i32 {
    let index = this.interfaces.length;
    this.interfaces.push(iface);
    this.interfaceIndices[iface.name.name] = index;
    return index;
  }

  registerWorld(world: WorldDef): i32 {
    let index = this.worlds.length;
    this.worlds.push(world);
    this.worldIndices[world.name.name] = index;
    return index;
  }

  registerType(entry: TypeEntry): i32 {
    let index = this.types.length;
    this.types.push(entry);
    if (entry.name != null) {
      this.typeIndices[entry.name as String] = index;
    }
    return index;
  }

  isResourceType(idx: i32): boolean {
    if (this.resourceTypeIndices.has(idx)) {
      return true;
    }
    if (idx >= 0 && idx < this.types.length) {
      let t = this.types[idx];
      match (t.kind) {
        case TypeAlias {inner}:
          if (inner.isIndex()) {
            return this.isResourceType(inner.indexValue());
          }
        case _: {}
      }
    }
    return false;
  }
  
  /** Get or create an anonymous type with the given key. */
  getOrCreateAnonType(key: String, kind: TypeKind): i32 {
    if (let (true, idx) = this.anonTypeIndices.get(key)) {
      return idx;
    }
    let entry = new TypeEntry(null, kind, none, null);
    let idx = this.registerType(entry);
    this.anonTypeIndices[key] = idx;
    return idx;
  }
  
  /** Get or create a borrow<resource> type for the given resource index. */
  getBorrowType(resourceIdx: i32): i32 {
    if (let (true, idx) = this.borrowTypeIndices.get(resourceIdx)) {
      return idx;
    }
    // Create new borrow type
    let kind = new HandleKind(resourceIdx, -1);
    
    var docs: Docs | null = null;
    if (resourceIdx >= 0 && resourceIdx < this.types.length) {
      docs = this.types[resourceIdx].docs;
    }
    
    let entry = new TypeEntry(null, kind, none, docs);
    let idx = this.registerType(entry);
    this.borrowTypeIndices[resourceIdx] = idx;
    return idx;
  }
  
  /** Get or create an own<resource> type for the given resource index. */
  getOwnType(resourceIdx: i32): i32 {
    if (let (true, idx) = this.ownTypeIndices.get(resourceIdx)) {
      return idx;
    }
    // Create new own type
    let kind = new HandleKind(-1, resourceIdx);
    let entry = new TypeEntry(null, kind, none, null);
    let idx = this.registerType(entry);
    this.ownTypeIndices[resourceIdx] = idx;
    return idx;
  }

  /** 
   * Get type reference for a function param or return type.
   * Handles bare resource names (converts them to own<resource>).
   */
  getParamTypeRef(t: Type): TypeRef {
    return this.getTypeRefEx(t, true);
  }

  /** Get a type reference: primitive as string, complex as index. */
  getTypeRef(t: Type): TypeRef {
    return this.getTypeRefEx(t, true);
  }

  getTypeRefEx(t: Type, resolveResourceAsOwn: boolean): TypeRef {
    // Check if primitive type
    if (t.tag == TypeTag.U8) { return TypeRef.str("u8"); }
    if (t.tag == TypeTag.U16) { return TypeRef.str("u16"); }
    if (t.tag == TypeTag.U32) { return TypeRef.str("u32"); }
    if (t.tag == TypeTag.U64) { return TypeRef.str("u64"); }
    if (t.tag == TypeTag.S8) { return TypeRef.str("s8"); }
    if (t.tag == TypeTag.S16) { return TypeRef.str("s16"); }
    if (t.tag == TypeTag.S32) { return TypeRef.str("s32"); }
    if (t.tag == TypeTag.S64) { return TypeRef.str("s64"); }
    if (t.tag == TypeTag.F32) { return TypeRef.str("f32"); }
    if (t.tag == TypeTag.F64) { return TypeRef.str("f64"); }
    if (t.tag == TypeTag.Char) { return TypeRef.str("char"); }
    if (t.tag == TypeTag.Bool) { return TypeRef.str("bool"); }
    if (t.tag == TypeTag.String) { return TypeRef.str("string"); }
    if (t.tag == TypeTag.ErrorContext) { return TypeRef.str("error-context"); }
    if (t.tag == TypeTag.Name) {
      let id = t.name as Id;
      let name = normalizeId(id.name);
      
      var foundIdx = -1;
      if (this.currentInterfaceName != null) {
        let key = "interface:" + (this.currentInterfaceName as String) + "/" + name;
        if (let (true, idx) = this.typeIndices.get(key)) {
          foundIdx = idx;
        }
      }
      if (foundIdx < 0 && this.currentWorldName != null) {
        let key = "world:" + (this.currentWorldName as String) + "/" + name;
        if (let (true, idx) = this.typeIndices.get(key)) {
          foundIdx = idx;
        }
      }
      if (foundIdx < 0) {
        if (let (true, idx) = this.typeIndices.get(name)) {
          foundIdx = idx;
        }
      }
      
      // Check if it's a user-defined type
      if (foundIdx >= 0) {
        if (resolveResourceAsOwn && this.isResourceType(foundIdx)) {
          return TypeRef.idx(this.getOwnType(foundIdx));
        }
        return TypeRef.idx(foundIdx);
      }
      // Not a registered type - return as string (shouldn't happen for valid WIT)
      return TypeRef.str(name);
    }
    // Complex type - register and return index
    let idx = this.registerAnonymousTypeEx(t, resolveResourceAsOwn);
    return TypeRef.idx(idx);
  }
  
  /** Get canonical key for a TypeRef. */
  typeRefToKey(ref: TypeRef): String {
    if (ref.isIndex()) {
      return "#" + i32ToString(ref.indexValue());
    } else {
      return ref.strValue();
    }
  }

  /** Register an anonymous complex type and return its index. */
  registerAnonymousType(t: Type): i32 {
    return this.registerAnonymousTypeEx(t, true);
  }

  registerAnonymousTypeEx(t: Type, resolveResourceAsOwn: boolean): i32 {
    if (t.tag == TypeTag.Tuple) {
      let types = t.types as Array<Type>;
      let refs = new Array<TypeRef>();
      var keyParts = "tuple:";
      var idx = 0;
      while (idx < types.length) {
        let ref = this.getTypeRefEx(types[idx], resolveResourceAsOwn);
        refs.push(ref);
        if (idx > 0) { keyParts = keyParts + ","; }
        keyParts = keyParts + this.typeRefToKey(ref);
        idx = idx + 1;
      }
      let kind = new TupleKind(refs);
      return this.getOrCreateAnonType(keyParts, kind);
    } else if (t.tag == TypeTag.Option) {
      let innerRef = this.getTypeRefEx(t.inner as Type, resolveResourceAsOwn);
      let key = "option:" + this.typeRefToKey(innerRef);
      let kind = new OptionKind(innerRef);
      return this.getOrCreateAnonType(key, kind);
    } else if (t.tag == TypeTag.Result) {
      var key = "result:";
      let ok = if (t.okType != null) {
        let okRef = this.getTypeRefEx(t.okType as Type, resolveResourceAsOwn);
        key = key + this.typeRefToKey(okRef);
        okRef
      } else {
        null
      };
      key = key + ",";
      let err = if (t.errType != null) {
        let errRef = this.getTypeRefEx(t.errType as Type, resolveResourceAsOwn);
        key = key + this.typeRefToKey(errRef);
        errRef
      } else {
        null
      };
      let kind = new ResultKind(ok, err);
      return this.getOrCreateAnonType(key, kind);
    } else if (t.tag == TypeTag.List) {
      let innerRef = this.getTypeRefEx(t.inner as Type, resolveResourceAsOwn);
      if (t.fixedLength >= 0) {
        let key = "fixed-length-list:" + this.typeRefToKey(innerRef) + ":" + i32ToString(t.fixedLength);
        let kind = new FixedLengthListKind(innerRef, t.fixedLength);
        return this.getOrCreateAnonType(key, kind);
      } else {
        let key = "list:" + this.typeRefToKey(innerRef);
        let kind = new ListKind(innerRef);
        return this.getOrCreateAnonType(key, kind);
      }
    } else if (t.tag == TypeTag.Future) {
      var key = "future:";
      let inner = if (t.inner != null) {
        let innerRef = this.getTypeRefEx(t.inner as Type, resolveResourceAsOwn);
        key = key + this.typeRefToKey(innerRef);
        innerRef
      } else {
        null
      };
      let kind = new FutureKind(inner);
      return this.getOrCreateAnonType(key, kind);
    } else if (t.tag == TypeTag.Stream) {
      var key = "stream:";
      let inner = if (t.inner != null) {
        let innerRef = this.getTypeRefEx(t.inner as Type, resolveResourceAsOwn);
        key = key + this.typeRefToKey(innerRef);
        innerRef
      } else {
        null
      };
      let kind = new StreamKind(inner);
      return this.getOrCreateAnonType(key, kind);
    } else if (t.tag == TypeTag.Own) {
      // Get the inner type index
      let innerRef = this.getTypeRefEx(t.inner as Type, false);
      var resourceIdx = -1;
      if (innerRef.isIndex()) {
        resourceIdx = innerRef.indexValue();
      } else {
        // Named resource - look up in typeIndices
        if (let (true, idx) = this.typeIndices.get(innerRef.strValue())) {
          resourceIdx = idx;
        }
      }
      if (resourceIdx >= 0) {
        // Use getOwnType to avoid duplicates
        return this.getOwnType(resourceIdx);
      }
      // Fallback if resource not found
      let kind = new HandleKind(-1, resourceIdx);
      let entry = new TypeEntry(null, kind, none, null);
      return this.registerType(entry);
    } else if (t.tag == TypeTag.Borrow) {
      // Get the inner type index
      let innerRef = this.getTypeRefEx(t.inner as Type, false);
      var resourceIdx = -1;
      if (innerRef.isIndex()) {
        resourceIdx = innerRef.indexValue();
      } else {
        // Named resource - look up in typeIndices
        if (let (true, idx) = this.typeIndices.get(innerRef.strValue())) {
          resourceIdx = idx;
        }
      }
      if (resourceIdx >= 0) {
        // Use getBorrowType to avoid duplicates
        return this.getBorrowType(resourceIdx);
      }
      // Fallback if resource not found
      let kind = new HandleKind(resourceIdx, -1);
      let entry = new TypeEntry(null, kind, none, null);
      return this.registerType(entry);
    } else if (t.tag == TypeTag.Map) {
      let keyRef = this.getTypeRefEx(t.keyType as Type, resolveResourceAsOwn);
      let valRef = this.getTypeRefEx(t.valueType as Type, resolveResourceAsOwn);
      let key = "map:" + this.typeRefToKey(keyRef) + ":" + this.typeRefToKey(valRef);
      let kind = new MapKind(keyRef, valRef);
      return this.getOrCreateAnonType(key, kind);
    }

    // Unknown type - should not reach here
    let kind = new UnknownKind();
    let entry = new TypeEntry(null, kind, none, null);
    return this.registerType(entry);
  }
}

// ============================================================================
// Helper Functions (defined before use)
// ============================================================================

let getUsePathInterfaceName = (path: UsePath): String => {
  if (path.tag == UsePathTag.Id) {
    return normalizeId((path.id as Id).name);
  }
  let pkg = path.packageId as PackageName;
  let name = (path.name as Id).name;
  var pkgName = normalizeId(pkg.namespace.name) + ":" + normalizeId(pkg.name.name);
  if (pkg.version != null) {
    pkgName = pkgName + "@" + (pkg.version as String);
  }
  return pkgName + "/" + normalizeId(name);
};



let isStabilityEqual = (d1: Docs | null, d2: Docs | null): boolean => {
  if (d1 == null && d2 == null) return true;
  if (d1 == null || d2 == null) return false;
  if (d1.attributes == null && d2.attributes == null) return true;
  if (d1.attributes == null || d2.attributes == null) return false;
  let attrs1 = d1.attributes as Array<Attribute>;
  let attrs2 = d2.attributes as Array<Attribute>;
  if (attrs1.length != attrs2.length) return false;
  
  var i = 0;
  while (i < attrs1.length) {
    let a1 = attrs1[i];
    let a2 = attrs2[i];
    if (a1.tag != a2.tag) return false;
    
    // Only omit since/stable attributes
    if (a1.tag != AttributeTag.Since) return false;
    
    if (a1.version != a2.version) return false;
    i = i + 1;
  }
  return true;
};

let resolveInterfaceIndex = (ctx: SerializeContext, name: String): i32 => {
  if (let (true, sIdx) = ctx.interfaceIndices.get(name)) {
    return sIdx;
  }
  
  var slashIdx = -1;
  var i = 0;
  while (i < name.length) {
    if (name.getByteAt(i) == 47) { // '/'
      slashIdx = i;
    }
    i = i + 1;
  }
  
  if (slashIdx >= 0) {
    var hasAt = false;
    var j = 0;
    while (j < slashIdx) {
      if (name.getByteAt(j) == 64) { // '@'
        hasAt = true;
      }
      j = j + 1;
    }
    
    if (!hasAt) {
      let pkgNamePart = name.sliceBytes(0, slashIdx);
      let interfaceNamePart = name.sliceBytes(slashIdx + 1, name.length);
      
      var pkgIdx = 0;
      while (pkgIdx < ctx.packages.length) {
        let pkg = ctx.packages[pkgIdx];
        let pkgName = pkg.name;
        if (pkgName == pkgNamePart || (pkgName.length > pkgNamePart.length && pkgName.sliceBytes(0, pkgNamePart.length) == pkgNamePart && pkgName.getByteAt(pkgNamePart.length) == 64)) {
          let lookupKey = pkg.name + "/" + interfaceNamePart;
          if (let (true, sIdx) = ctx.interfaceIndices.get(lookupKey)) {
            return sIdx;
          }
        }
        pkgIdx = pkgIdx + 1;
      }
    }
  }
  
  return -1;
};

let resolveInterfaceName = (ctx: SerializeContext, pkgName: String, path: UsePath): String => {
  let name = getUsePathInterfaceName(path);
  if (path.tag == UsePathTag.Id) {
    return ctx.resolveInterfaceAlias(pkgName, name);
  }
  return name;
};

let resolveInterfaceNameAndIndex = (ctx: SerializeContext, itemPkgName: String, path: UsePath): i32 => {
  let resolved = resolveInterfaceName(ctx, itemPkgName, path);
  var hasSlash = false;
  var sI = 0;
  while (sI < resolved.length) {
    if (resolved.getByteAt(sI) == 47) { // '/'
      hasSlash = true;
      break;
    }
    sI = sI + 1;
  }
  
  if (hasSlash) {
    return resolveInterfaceIndex(ctx, resolved);
  }
  return resolveInterfaceIndex(ctx, itemPkgName + "/" + resolved);
};

let findWorldItemDocs = (ctx: SerializeContext, world: WorldDef, ifaceIdx: i32, isImport: boolean, items: Array<WorldItem>): Docs | null => {
  let pkgName = ctx.packages[world.packageIndex].name;
  
  var combinedDocs: Docs | null = null;
  var hasMatch = false;
  var hasExplicitDocs = false;
  
  // Compute if the interface is purely included (only imported via includes with no direct references)
  var isPurelyIncluded = true;
  var checkIdx = 0;
  while (checkIdx < items.length) {
    let item = items[checkIdx];
    let itemPkgName = if (item.packageIndex >= 0) ctx.packages[item.packageIndex].name else pkgName;
    if (item.tag == WorldItemTag.Import || item.tag == WorldItemTag.Use) {
      var curIdx = -1;
      if (item.tag == WorldItemTag.Import) {
        let imp = item.importItem as Import;
        if (imp.kind.tag == ExternKindTag.Interface) {
          let name = normalizeId((imp.kind.name as Id).name);
          let inlineName = "[import]" + name;
          if (itemPkgName.length > 0) {
            let lookupKey = itemPkgName + "/inline/" + inlineName;
            curIdx = resolveInterfaceIndex(ctx, lookupKey);
          }
          if (curIdx < 0) {
            curIdx = resolveInterfaceIndex(ctx, inlineName);
          }
          if (curIdx < 0 && itemPkgName.length > 0) {
            let lookupKey = itemPkgName + "/" + name;
            curIdx = resolveInterfaceIndex(ctx, lookupKey);
          }
          if (curIdx < 0) {
            curIdx = resolveInterfaceIndex(ctx, name);
          }
        } else if (imp.kind.tag == ExternKindTag.Path) {
          curIdx = resolveInterfaceNameAndIndex(ctx, itemPkgName, imp.kind.path as UsePath);
        }
      } else {
        let u = item.use as Use;
        curIdx = resolveInterfaceNameAndIndex(ctx, itemPkgName, u.from);
      }
      
      if (curIdx == ifaceIdx && !item.isIncluded) {
        isPurelyIncluded = false;
      }
    }
    checkIdx = checkIdx + 1;
  }
  
  // Pass 1: Direct imports / exports, and included Use statements (which act as implicit interface imports)
  var idx = 0;
  while (idx < items.length) {
    let item = items[idx];
    let itemPkgName = if (item.packageIndex >= 0) ctx.packages[item.packageIndex].name else pkgName;
    if (isImport && (item.tag == WorldItemTag.Import || (item.tag == WorldItemTag.Use && item.isIncluded))) {
      var curIdx = -1;
      var docs: Docs | null = null;
      if (item.tag == WorldItemTag.Import) {
        let imp = item.importItem as Import;
        docs = imp.docs;
        if (imp.kind.tag == ExternKindTag.Interface) {
          let name = normalizeId((imp.kind.name as Id).name);
          let inlineName = "[import]" + name;
          if (itemPkgName.length > 0) {
            let lookupKey = itemPkgName + "/inline/" + inlineName;
            curIdx = resolveInterfaceIndex(ctx, lookupKey);
          }
          if (curIdx < 0) {
            curIdx = resolveInterfaceIndex(ctx, inlineName);
          }
          if (curIdx < 0 && itemPkgName.length > 0) {
            let lookupKey = itemPkgName + "/" + name;
            curIdx = resolveInterfaceIndex(ctx, lookupKey);
          }
          if (curIdx < 0) {
            curIdx = resolveInterfaceIndex(ctx, name);
          }
        } else if (imp.kind.tag == ExternKindTag.Path) {
          curIdx = resolveInterfaceNameAndIndex(ctx, itemPkgName, imp.kind.path as UsePath);
        }
      } else {
        let u = item.use as Use;
        docs = item.inheritedDocs;
        curIdx = resolveInterfaceNameAndIndex(ctx, itemPkgName, u.from);
      }
      
      if (curIdx == ifaceIdx) {
        hasMatch = true;
        combinedDocs = mergeDocs(combinedDocs, docs);
        if (item.isExplicit) {
          hasExplicitDocs = true;
        }
      }
    } else if (!isImport && item.tag == WorldItemTag.Export) {
      let exp = item.exportItem as Export;
      var curIdx = -1;
      var docs: Docs | null = exp.docs;
      if (exp.kind.tag == ExternKindTag.Interface) {
        let name = normalizeId((exp.kind.name as Id).name);
        let inlineName = "[export]" + name;
        if (itemPkgName.length > 0) {
          let lookupKey = itemPkgName + "/inline/" + inlineName;
          curIdx = resolveInterfaceIndex(ctx, lookupKey);
        }
        if (curIdx < 0) {
          curIdx = resolveInterfaceIndex(ctx, inlineName);
        }
        if (curIdx < 0 && itemPkgName.length > 0) {
          let lookupKey = itemPkgName + "/" + name;
          curIdx = resolveInterfaceIndex(ctx, lookupKey);
        }
        if (curIdx < 0) {
          curIdx = resolveInterfaceIndex(ctx, name);
        }
      } else if (exp.kind.tag == ExternKindTag.Path) {
        curIdx = resolveInterfaceNameAndIndex(ctx, itemPkgName, exp.kind.path as UsePath);
      }
      
      if (curIdx == ifaceIdx) {
        hasMatch = true;
        combinedDocs = mergeDocs(combinedDocs, docs);
        if (item.isExplicit) {
          hasExplicitDocs = true;
        }
      }
    }
    idx = idx + 1;
  }
  
  if (hasMatch) {
    let iface = ctx.interfaces[ifaceIdx];
    let isForeign = iface.packageIndex != world.packageIndex;
    
    if (!hasExplicitDocs || isForeign) {
      let ifaceDocs = iface.docs;
      if (ifaceDocs != null && isStabilityEqual(combinedDocs, ifaceDocs)) {
        return null;
      }
      
      let worldDocs = world.docs;
      if (worldDocs != null && isStabilityEqual(combinedDocs, worldDocs)) {
        return null;
      }
    }
    
    if (!hasExplicitDocs) {
      var isUnstable = false;
      if (combinedDocs != null && combinedDocs.attributes != null) {
        let attrs = combinedDocs.attributes as Array<Attribute>;
        var i = 0;
        while (i < attrs.length) {
          if (attrs[i].tag == AttributeTag.Unstable) {
            isUnstable = true;
          }
          i = i + 1;
        }
      }
      
      if (!isUnstable) {
        return null;
      }
    }
    return combinedDocs;
  }
  
  // Pass 2: Local type imports (direct/explicit Use statements) that act as implicit interface imports
  if (isImport) {
    idx = 0;
    while (idx < items.length) {
      let item = items[idx];
      let itemPkgName = if (item.packageIndex >= 0) ctx.packages[item.packageIndex].name else pkgName;
      if (item.tag == WorldItemTag.Use) {
        let u = item.use as Use;
        let name = getUsePathInterfaceName(u.from);
        var curIdx = -1;
        if (itemPkgName.length > 0) {
          let lookupKey = itemPkgName + "/" + name;
          if (let (true, sIdx) = ctx.interfaceIndices.get(lookupKey)) { curIdx = sIdx; }
        }
        if (curIdx < 0) {
          if (let (true, sIdx) = ctx.interfaceIndices.get(name)) { curIdx = sIdx; }
        }
        if (curIdx == ifaceIdx) {
          let worldDocs = world.docs;
          if (worldDocs != null && isStabilityEqual(u.docs, worldDocs)) {
            return null;
          }
          
          if (item.isExplicit) {
            return u.docs;
          }
          
          let iface = ctx.interfaces[ifaceIdx];
          let ifaceDocs = iface.docs;
          if (ifaceDocs != null && isStabilityEqual(u.docs, ifaceDocs)) {
            return null;
          }
          
          var isUnstable = false;
          let uDocs = u.docs;
          if (uDocs != null && uDocs.attributes != null) {
            let attrs = uDocs.attributes as Array<Attribute>;
            var i = 0;
            while (i < attrs.length) {
              if (attrs[i].tag == AttributeTag.Unstable) {
                isUnstable = true;
              }
              i = i + 1;
            }
          }
          
          if (!isUnstable) {
            return null;
          }
          return u.docs;
        }
      }
      idx = idx + 1;
    }
  }
  
  return null;
};

let collectTypeDeps = (t: Type, deps: Array<String>): void => {
  if (t.tag == TypeTag.Name) {
    let id = t.name as Id;
    deps.push(normalizeId(id.name));
  } else if (t.tag == TypeTag.Tuple) {
    let types = t.types as Array<Type>;
    var idx = 0;
    while (idx < types.length) {
      collectTypeDeps(types[idx], deps);
      idx = idx + 1;
    }
  } else if (t.tag == TypeTag.Result) {
    if (t.okType != null) {
      collectTypeDeps(t.okType as Type, deps);
    }
    if (t.errType != null) {
      collectTypeDeps(t.errType as Type, deps);
    }
  } else if (t.tag == TypeTag.Option || t.tag == TypeTag.List ||
             t.tag == TypeTag.Future || t.tag == TypeTag.Stream ||
             t.tag == TypeTag.Own || t.tag == TypeTag.Borrow) {
    if (t.inner != null) {
      collectTypeDeps(t.inner as Type, deps);
    }
  } else if (t.tag == TypeTag.Map) {
    if (t.keyType != null) {
      collectTypeDeps(t.keyType as Type, deps);
    }
    if (t.valueType != null) {
      collectTypeDeps(t.valueType as Type, deps);
    }
  }
};

let collectTypeDefDeps = (td: TypeDef, deps: Array<String>): void => {
  if (td.tag == TypeDefTag.Record) {
    let fields = td.fields as Array<Field>;
    var idx = 0;
    while (idx < fields.length) {
      collectTypeDeps(fields[idx].type, deps);
      idx = idx + 1;
    }
  } else if (td.tag == TypeDefTag.Alias) {
    collectTypeDeps(td.aliasType as Type, deps);
  } else if (td.tag == TypeDefTag.Variant) {
    let cases = td.cases as Array<Case>;
    var idx = 0;
    while (idx < cases.length) {
      let c = cases[idx];
      if (c.type != null) {
        collectTypeDeps(c.type as Type, deps);
      }
      idx = idx + 1;
    }
  }
};

let collectInterfaceDeps = (ctx: SerializeContext, iface: InterfaceDef, deps: Array<String>): void => {
  let pkgName = ctx.packages[iface.packageIndex].name;
  var idx = 0;
  while (idx < iface.items.length) {
    let item = iface.items[idx];
    if (item.tag == InterfaceItemTag.Use) {
      let u = item.use as Use;
      deps.push(resolveInterfaceName(ctx, pkgName, u.from));
    }
    idx = idx + 1;
  }
};

let sortInterfaces = (ctx: SerializeContext, interfaces: Array<InterfaceDef>): Array<InterfaceDef> => {
  let sorted = new Array<InterfaceDef>();
  let visited = new HashMap<String, i32>();
  
  let ifaceMap = new HashMap<String, InterfaceDef>();
  var idx = 0;
  while (idx < interfaces.length) {
    let iface = interfaces[idx];
    let key = if (iface.isInline) {
      i32ToString(iface.packageIndex) + "/inline/" + normalizeId(iface.name.name);
    } else {
      i32ToString(iface.packageIndex) + "/" + normalizeId(iface.name.name);
    };
    ifaceMap[key] = iface;
    idx = idx + 1;
  }
  
  let visit = (key: String): void => {
    if (let (true, status) = visited.get(key)) {
      if (status == 1 || status == 2) {
        return;
      }
    }
    
    if (let (true, ifaceObj) = ifaceMap.get(key)) {
      let iface = ifaceObj as InterfaceDef;
      visited[key] = 1;
      
      let deps = new Array<String>();
      collectInterfaceDeps(ctx, iface, deps);
      
      var dIdx = 0;
      while (dIdx < deps.length) {
        let dep = deps[dIdx];
        
        var hasSlash = false;
        var sIdx = 0;
        var slashIdx = -1;
        while (sIdx < dep.length) {
          if (dep.getByteAt(sIdx) == 47) { // '/'
            hasSlash = true;
            slashIdx = sIdx;
            break;
          }
          sIdx = sIdx + 1;
        }
        
        var depKey = dep;
        if (!hasSlash) {
          depKey = i32ToString(iface.packageIndex) + "/" + dep;
        } else {
          let pkgNamePart = dep.sliceBytes(0, slashIdx);
          let ifaceNamePart = dep.sliceBytes(slashIdx + 1, dep.length);
          var foundPkgIdx = -1;
          var p = 0;
          while (p < ctx.packages.length) {
            if (ctx.packages[p].name == pkgNamePart) {
              foundPkgIdx = p;
              break;
            }
            p = p + 1;
          }
          if (foundPkgIdx >= 0) {
            depKey = i32ToString(foundPkgIdx) + "/" + ifaceNamePart;
          }
        }
        
        if (ifaceMap.has(depKey)) {
          visit(depKey);
        }
        dIdx = dIdx + 1;
      }
      
      visited[key] = 2;
      sorted.push(iface);
    }
  };
  
  idx = 0;
  while (idx < interfaces.length) {
    let iface = interfaces[idx];
    let key = if (iface.isInline) {
      i32ToString(iface.packageIndex) + "/inline/" + normalizeId(iface.name.name);
    } else {
      i32ToString(iface.packageIndex) + "/" + normalizeId(iface.name.name);
    };
    visit(key);
    idx = idx + 1;
  }
  
  return sorted;
};

let collectWorldDeps = (world: WorldDef, deps: Array<String>): void => {
  var idx = 0;
  while (idx < world.items.length) {
    let item = world.items[idx];
    if (item.tag == WorldItemTag.Include) {
      let inc = item.include as Include;
      if (inc.from.tag == UsePathTag.Id) {
        deps.push(normalizeId((inc.from.id as Id).name));
      }
    }
    idx = idx + 1;
  }
};

let sortWorlds = (worlds: Array<WorldDef>): Array<WorldDef> => {
  let sorted = new Array<WorldDef>();
  let visited = new HashMap<String, i32>();
  
  let worldMap = new HashMap<String, WorldDef>();
  var idx = 0;
  while (idx < worlds.length) {
    let world = worlds[idx];
    let key = i32ToString(world.packageIndex) + "/" + normalizeId(world.name.name);
    worldMap[key] = world;
    idx = idx + 1;
  }
  
  let visit = (key: String): void => {
    if (let (true, status) = visited.get(key)) {
      if (status == 1 || status == 2) {
        return;
      }
    }
    
    if (let (true, worldObj) = worldMap.get(key)) {
      let world = worldObj as WorldDef;
      visited[key] = 1;
      
      let deps = new Array<String>();
      collectWorldDeps(world, deps);
      
      var dIdx = 0;
      while (dIdx < deps.length) {
        let dep = deps[dIdx];
        let depKey = i32ToString(world.packageIndex) + "/" + dep;
        if (worldMap.has(depKey)) {
          visit(depKey);
        }
        dIdx = dIdx + 1;
      }
      
      visited[key] = 2;
      sorted.push(world);
    }
  };
  
  idx = 0;
  while (idx < worlds.length) {
    let world = worlds[idx];
    let key = i32ToString(world.packageIndex) + "/" + normalizeId(world.name.name);
    visit(key);
    idx = idx + 1;
  }
  
  return sorted;
};

let registerInterfaceTypes = (ctx: SerializeContext, iface: InterfaceDef, ifaceIdx: i32): void => {
  let siblingTypes = new HashMap<String, ScopeTypeElement>();
  let ifaceName = normalizeId(iface.name.name);
  
  var idx = 0;
  while (idx < iface.items.length) {
    let item = iface.items[idx];
    if (item.tag == InterfaceItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      siblingTypes[normalizeId(td.name.name)] = ScopeTypeElement.fromTd(td);
    } else if (item.tag == InterfaceItemTag.Use) {
      let u = item.use as Use;
      var j = 0;
      while (j < u.names.length) {
        let un = u.names[j];
        let localName = normalizeId(if (un.asName != null) (un.asName as Id).name else un.name.name);
        siblingTypes[localName] = ScopeTypeElement.fromUse(u.from, un, u.docs);
        j = j + 1;
      }
    }
    idx = idx + 1;
  }

  let visited = new HashMap<String, i32>();
  let registeredIndices = new HashMap<String, i32>();

  let ensureRegistered = (name: String): i32 => {
    let normName = normalizeId(name);
    if (let (true, status) = visited.get(normName)) {
      if (status == 2) {
        if (let (true, registeredIdx) = registeredIndices.get(normName)) {
          return registeredIdx;
        }
        return -1;
      }
      if (status == 1) {
        return -1;
      }
    }

    if (let (true, elemObj) = siblingTypes.get(normName)) {
      visited[normName] = 1;
      let elem = elemObj as ScopeTypeElement;
      
      var typeIdx = -1;
      if (elem.isTypeDef()) {
        let td = elem.typeDef() as TypeDef;
        let deps = new Array<String>();
        collectTypeDefDeps(td, deps);

        var dIdx = 0;
        while (dIdx < deps.length) {
          let dep = deps[dIdx];
          if (siblingTypes.has(dep)) {
            ensureRegistered(dep);
          }
          dIdx = dIdx + 1;
        }

        typeIdx = registerTypeDef(ctx, td, TypeOwner.fromInterface(ifaceIdx));
      } else {
        let pkgName = ctx.packages[iface.packageIndex].name;
        let srcIfaceName = resolveInterfaceName(ctx, pkgName, elem.usePath() as UsePath);
        let srcTypeName = normalizeId((elem.useName() as UseName).name.name);
        
        var srcIdx = -1;
        let lookupKey = "interface:" + srcIfaceName + "/" + srcTypeName;
        if (let (true, sIdx) = ctx.typeIndices.get(lookupKey)) {
          srcIdx = sIdx;
        } else {
          if (let (true, sIdx) = ctx.typeIndices.get(srcTypeName)) {
            srcIdx = sIdx;
          }
        }
        
        if (srcIdx >= 0) {
          let kind = new TypeAlias(TypeRef.idx(srcIdx));
          
          let entry = new TypeEntry(normName, kind, some(TypeOwner.fromInterface(ifaceIdx)), elem.docs());
          typeIdx = ctx.registerType(entry);
        }
      }

      if (typeIdx >= 0) {
        registeredIndices[normName] = typeIdx;
        ctx.typeIndices["interface:" + ifaceName + "/" + normName] = typeIdx;
        let pkgName = ctx.packages[iface.packageIndex].name;
        if (pkgName.length > 0) {
          ctx.typeIndices["interface:" + pkgName + "/" + ifaceName + "/" + normName] = typeIdx;
        }
      }
      
      visited[normName] = 2;
      return typeIdx;
    }

    return -1;
  };

  idx = 0;
  while (idx < iface.items.length) {
    let item = iface.items[idx];
    if (item.tag == InterfaceItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      ensureRegistered(normalizeId(td.name.name));
    } else if (item.tag == InterfaceItemTag.Use) {
      let u = item.use as Use;
      var j = 0;
      while (j < u.names.length) {
        let un = u.names[j];
        let localName = normalizeId(if (un.asName != null) (un.asName as Id).name else un.name.name);
        ensureRegistered(localName);
        j = j + 1;
      }
    }
    idx = idx + 1;
  }
};

let findWorldByUsePath = (ctx: SerializeContext, path: UsePath): WorldDef | null => {
  if (path.tag == UsePathTag.Id) {
    let name = (path.id as Id).name;
    let currentPkg = ctx.packages[ctx.currentWorldPackageIndex];
    if (let (true, wIdx) = currentPkg.worlds.get(normalizeId(name))) {
      return ctx.worlds[wIdx];
    }
    var p = 0;
    while (p < ctx.packages.length) {
      if (let (true, wIdx) = ctx.packages[p].worlds.get(normalizeId(name))) {
        return ctx.worlds[wIdx];
      }
      p += 1;
    }
  } else if (path.tag == UsePathTag.Package) {
    let name = (path.name as Id).name;
    let pkg = path.packageId as PackageName;
    let pkgNameStr = formatPackageName(pkg);
    var p = 0;
    while (p < ctx.packages.length) {
      if (ctx.packages[p].name == pkgNameStr) {
        if (let (true, wIdx) = ctx.packages[p].worlds.get(normalizeId(name))) {
          return ctx.worlds[wIdx];
        }
      }
      p += 1;
    }
  }
  return null;
};

let applyRename = (name: String, renames: Array<IncludeName>): String => {
  var i = 0;
  while (i < renames.length) {
    let r = renames[i];
    if (r.name.name == name) {
      return r.asName.name;
    }
    i = i + 1;
  }
  return name;
};

let renameType = (t: Type, renames: Array<IncludeName>): Type => {
  if (t.tag == TypeTag.Name) {
    let originalName = (t.name as Id).name;
    let newName = applyRename(originalName, renames);
    if (newName != originalName) {
      let tClone = new Type(TypeTag.Name, t.span);
      tClone.name = new Id(newName, (t.name as Id).span);
      return tClone;
    }
    return t;
  }
  
  if (t.tag == TypeTag.List || t.tag == TypeTag.Option || t.tag == TypeTag.Future || t.tag == TypeTag.Stream || t.tag == TypeTag.Own || t.tag == TypeTag.Borrow) {
    if (t.inner != null) {
      let renamedInner = renameType(t.inner as Type, renames);
      if (renamedInner != t.inner) {
        let tClone = new Type(t.tag, t.span);
        tClone.inner = renamedInner;
        tClone.fixedLength = t.fixedLength;
        return tClone;
      }
    }
    return t;
  }
  
  if (t.tag == TypeTag.Result) {
    let newOk = if (t.okType != null) renameType(t.okType as Type, renames) else null;
    let newErr = if (t.errType != null) renameType(t.errType as Type, renames) else null;
    if (newOk != t.okType || newErr != t.errType) {
      let tClone = new Type(TypeTag.Result, t.span);
      tClone.okType = newOk;
      tClone.errType = newErr;
      return tClone;
    }
    return t;
  }
  
  if (t.tag == TypeTag.Tuple) {
    var changed = false;
    let newTypes = new Array<Type>();
    var idx = 0;
    while (idx < (t.types as Array<Type>).length) {
      let originalType = (t.types as Array<Type>)[idx];
      let renamedType = renameType(originalType, renames);
      if (renamedType != originalType) {
        changed = true;
      }
      newTypes.push(renamedType);
      idx = idx + 1;
    }
    if (changed) {
      let tClone = new Type(TypeTag.Tuple, t.span);
      tClone.types = newTypes;
      return tClone;
    }
    return t;
  }
  
  if (t.tag == TypeTag.Map) {
    let newKey = renameType(t.keyType as Type, renames);
    let newVal = renameType(t.valueType as Type, renames);
    if (newKey != t.keyType || newVal != t.valueType) {
      let tClone = new Type(TypeTag.Map, t.span);
      tClone.keyType = newKey;
      tClone.valueType = newVal;
      return tClone;
    }
    return t;
  }
  
  return t;
};

let renameParam = (p: Param, renames: Array<IncludeName>): Param => {
  let renamedType = renameType(p.type, renames);
  if (renamedType != p.type) {
    return new Param(p.name, renamedType);
  }
  return p;
};

let renameFunc = (f: Func, renames: Array<IncludeName>): Func => {
  var changed = false;
  let newParams = new Array<Param>();
  var idx = 0;
  while (idx < f.params.length) {
    let p = f.params[idx];
    let renamedParam = renameParam(p, renames);
    if (renamedParam != p) {
      changed = true;
    }
    newParams.push(renamedParam);
    idx = idx + 1;
  }
  let newResult = if (f.result != null) renameType(f.result as Type, renames) else null;
  if (newResult != f.result) {
    changed = true;
  }
  if (changed) {
    let fClone = new Func(f.span);
    fClone.isAsync = f.isAsync;
    fClone.params = newParams;
    fClone.result = newResult;
    return fClone;
  }
  return f;
};

let renameNamedFunc = (nf: NamedFunc, renames: Array<IncludeName>): NamedFunc => {
  let renamedFunc = renameFunc(nf.func, renames);
  if (renamedFunc != nf.func) {
    return new NamedFunc(nf.docs, nf.name, renamedFunc);
  }
  return nf;
};

let renameResourceFunc = (rf: ResourceFunc, renames: Array<IncludeName>): ResourceFunc => {
  let renamedFunc = renameNamedFunc(rf.func, renames);
  if (renamedFunc != rf.func) {
    return new ResourceFunc(rf.tag, renamedFunc);
  }
  return rf;
};

let renameTypeDef = (td: TypeDef, renames: Array<IncludeName>): TypeDef => {
  let newName = applyRename(td.name.name, renames);
  var changed = (newName != td.name.name);
  
  var newAlias = td.aliasType;
  if (td.tag == TypeDefTag.Alias && td.aliasType != null) {
    newAlias = renameType(td.aliasType as Type, renames);
    if (newAlias != td.aliasType) {
      changed = true;
    }
  }
  
  var newFields = td.fields;
  if (td.tag == TypeDefTag.Record && td.fields != null) {
    let oldFields = td.fields as Array<Field>;
    let fields = new Array<Field>();
    var idx = 0;
    while (idx < oldFields.length) {
      let f = oldFields[idx];
      let renamedType = renameType(f.type, renames);
      if (renamedType != f.type) {
        changed = true;
        fields.push(new Field(f.docs, f.name, renamedType));
      } else {
        fields.push(f);
      }
      idx = idx + 1;
    }
    newFields = fields;
  }
  
  var newCases = td.cases;
  if (td.tag == TypeDefTag.Variant && td.cases != null) {
    let oldCases = td.cases as Array<Case>;
    let cases = new Array<Case>();
    var idx = 0;
    while (idx < oldCases.length) {
      let c = oldCases[idx];
      var renamedType = c.type;
      if (c.type != null) {
        renamedType = renameType(c.type as Type, renames);
        if (renamedType != c.type) {
          changed = true;
        }
      }
      if (renamedType != c.type) {
        let cClone = new Case(c.docs, c.name);
        cClone.type = renamedType;
        cases.push(cClone);
      } else {
        cases.push(c);
      }
      idx = idx + 1;
    }
    newCases = cases;
  }
  
  var newResourceFuncs = td.resourceFuncs;
  if (td.tag == TypeDefTag.Resource && td.resourceFuncs != null) {
    let oldFuncs = td.resourceFuncs as Array<ResourceFunc>;
    let funcs = new Array<ResourceFunc>();
    var idx = 0;
    while (idx < oldFuncs.length) {
      let rf = oldFuncs[idx];
      let renamedRf = renameResourceFunc(rf, renames);
      if (renamedRf != rf) {
        changed = true;
      }
      funcs.push(renamedRf);
      idx = idx + 1;
    }
    newResourceFuncs = funcs;
  }
  
  if (changed) {
    let tdClone = new TypeDef(td.docs, td.tag, new Id(newName, td.name.span));
    tdClone.aliasType = newAlias;
    tdClone.fields = newFields;
    tdClone.flags = td.flags;
    tdClone.cases = newCases;
    tdClone.enumCases = td.enumCases;
    tdClone.resourceFuncs = newResourceFuncs;
    return tdClone;
  }
  
  return td;
};

let renameImport = (imp: Import, renames: Array<IncludeName>): Import => {
  let kind = imp.kind;
  var changed = false;
  var newName = kind.name;
  if (kind.name != null) {
    let originalName = (kind.name as Id).name;
    let nameStr = applyRename(originalName, renames);
    if (nameStr != originalName) {
      changed = true;
      newName = new Id(nameStr, (kind.name as Id).span);
    }
  }
  
  var newFuncDef = kind.funcDef;
  if (kind.tag == ExternKindTag.Func && kind.funcDef != null) {
    newFuncDef = renameFunc(kind.funcDef as Func, renames);
    if (newFuncDef != kind.funcDef) {
      changed = true;
    }
  }
  
  if (changed) {
    let kindClone = new ExternKind(kind.tag);
    kindClone.name = newName;
    kindClone.items = kind.items;
    kindClone.path = kind.path;
    kindClone.funcDef = newFuncDef;
    return new Import(imp.docs, kindClone);
  }
  return imp;
};

let renameExport = (exp: Export, renames: Array<IncludeName>): Export => {
  let kind = exp.kind;
  var changed = false;
  var newName = kind.name;
  if (kind.name != null) {
    let originalName = (kind.name as Id).name;
    let nameStr = applyRename(originalName, renames);
    if (nameStr != originalName) {
      changed = true;
      newName = new Id(nameStr, (kind.name as Id).span);
    }
  }
  
  var newFuncDef = kind.funcDef;
  if (kind.tag == ExternKindTag.Func && kind.funcDef != null) {
    newFuncDef = renameFunc(kind.funcDef as Func, renames);
    if (newFuncDef != kind.funcDef) {
      changed = true;
    }
  }
  
  if (changed) {
    let kindClone = new ExternKind(kind.tag);
    kindClone.name = newName;
    kindClone.items = kind.items;
    kindClone.path = kind.path;
    kindClone.funcDef = newFuncDef;
    return new Export(exp.docs, kindClone);
  }
  return exp;
};

let renameUse = (u: Use, renames: Array<IncludeName>): Use => {
  var changed = false;
  let newNames = new Array<UseName>();
  var idx = 0;
  while (idx < u.names.length) {
    let un = u.names[idx];
    let originalName = if (un.asName != null) (un.asName as Id).name else un.name.name;
    let newName = applyRename(originalName, renames);
    if (newName != originalName) {
      changed = true;
      let unClone = new UseName(un.name);
      unClone.asName = new Id(newName, un.name.span);
      newNames.push(unClone);
    } else {
      newNames.push(un);
    }
    idx = idx + 1;
  }
  if (changed) {
    return new Use(u.docs, u.from, newNames);
  }
  return u;
};

let renameWorldItem = (item: WorldItem, renames: Array<IncludeName>): WorldItem => {
  if (renames.length == 0) {
    return item;
  }
  if (item.tag == WorldItemTag.TypeDef) {
    let td = item.typeDef as TypeDef;
    let renamedTd = renameTypeDef(td, renames);
    if (renamedTd != td) {
      let clonedItem = new WorldItem(WorldItemTag.TypeDef);
      clonedItem.typeDef = renamedTd;
      return clonedItem;
    }
  } else if (item.tag == WorldItemTag.Import) {
    let imp = item.importItem as Import;
    let renamedImp = renameImport(imp, renames);
    if (renamedImp != imp) {
      let clonedItem = new WorldItem(WorldItemTag.Import);
      clonedItem.importItem = renamedImp;
      return clonedItem;
    }
  } else if (item.tag == WorldItemTag.Export) {
    let exp = item.exportItem as Export;
    let renamedExp = renameExport(exp, renames);
    if (renamedExp != exp) {
      let clonedItem = new WorldItem(WorldItemTag.Export);
      clonedItem.exportItem = renamedExp;
      return clonedItem;
    }
  } else if (item.tag == WorldItemTag.Use) {
    let u = item.use as Use;
    let renamedUse = renameUse(u, renames);
    if (renamedUse != u) {
      let clonedItem = new WorldItem(WorldItemTag.Use);
      clonedItem.use = renamedUse;
      return clonedItem;
    }
  }
  return item;
};



let combineDocs = (parent: Docs | null, child: Docs | null): Docs | null => {
  if (parent == null) return child;
  if (child == null) return parent;
  if (parent.attributes == null) return child;
  if (child.attributes == null) return parent;
  
  let pattrs = parent.attributes as Array<Attribute>;
  let cattrs = child.attributes as Array<Attribute>;
  
  let newAttrs = new Array<Attribute>();
  
  var parentUnstable: Attribute | null = null;
  var childUnstable: Attribute | null = null;
  var parentSince: Attribute | null = null;
  var childSince: Attribute | null = null;
  var parentDeprecated: Attribute | null = null;
  var childDeprecated: Attribute | null = null;
  
  var i = 0;
  while (i < pattrs.length) {
    let a = pattrs[i];
    if (a.tag == AttributeTag.Unstable) parentUnstable = a;
    else if (a.tag == AttributeTag.Since) parentSince = a;
    else if (a.tag == AttributeTag.Deprecated) parentDeprecated = a;
    i = i + 1;
  }
  
  i = 0;
  while (i < cattrs.length) {
    let a = cattrs[i];
    if (a.tag == AttributeTag.Unstable) childUnstable = a;
    else if (a.tag == AttributeTag.Since) childSince = a;
    else if (a.tag == AttributeTag.Deprecated) childDeprecated = a;
    i = i + 1;
  }
  
  let hasSinceAttr = parentSince != null || childSince != null;
  if (!hasSinceAttr) {
    if (parentUnstable != null) newAttrs.push(parentUnstable as Attribute);
    else if (childUnstable != null) newAttrs.push(childUnstable as Attribute);
  }
  
  if (parentSince != null && childSince != null) {
    let pv = (parentSince as Attribute).version as String;
    let cv = (childSince as Attribute).version as String;
    if (compareVersions(pv, cv) > 0) newAttrs.push(parentSince as Attribute);
    else newAttrs.push(childSince as Attribute);
  } else if (parentSince != null) {
    newAttrs.push(parentSince as Attribute);
  } else if (childSince != null) {
    newAttrs.push(childSince as Attribute);
  }
  
  if (parentDeprecated != null && childDeprecated != null) {
    let pv = (parentDeprecated as Attribute).version as String;
    let cv = (childDeprecated as Attribute).version as String;
    if (compareVersions(pv, cv) < 0) newAttrs.push(parentDeprecated as Attribute);
    else newAttrs.push(childDeprecated as Attribute);
  } else if (parentDeprecated != null) {
    newAttrs.push(parentDeprecated as Attribute);
  } else if (childDeprecated != null) {
    newAttrs.push(childDeprecated as Attribute);
  }
  
  let d = new Docs(parent.span);
  d.attributes = newAttrs;
  return d;
};

let mergeDocs = (parent: Docs | null, child: Docs | null): Docs | null => {
  if (parent == null) return child;
  if (child == null) return parent;
  if (parent.attributes == null) return child;
  if (child.attributes == null) return parent;
  
  let pattrs = parent.attributes as Array<Attribute>;
  let cattrs = child.attributes as Array<Attribute>;
  
  let newAttrs = new Array<Attribute>();
  
  var parentUnstable: Attribute | null = null;
  var childUnstable: Attribute | null = null;
  var parentSince: Attribute | null = null;
  var childSince: Attribute | null = null;
  var parentDeprecated: Attribute | null = null;
  var childDeprecated: Attribute | null = null;
  
  var i = 0;
  while (i < pattrs.length) {
    let a = pattrs[i];
    if (a.tag == AttributeTag.Unstable) parentUnstable = a;
    else if (a.tag == AttributeTag.Since) parentSince = a;
    else if (a.tag == AttributeTag.Deprecated) parentDeprecated = a;
    i = i + 1;
  }
  
  i = 0;
  while (i < cattrs.length) {
    let a = cattrs[i];
    if (a.tag == AttributeTag.Unstable) childUnstable = a;
    else if (a.tag == AttributeTag.Since) childSince = a;
    else if (a.tag == AttributeTag.Deprecated) childDeprecated = a;
    i = i + 1;
  }
  
  if (parentUnstable != null) {
    newAttrs.push(parentUnstable as Attribute);
  } else if (childUnstable != null) {
    newAttrs.push(childUnstable as Attribute);
  } else {
    if (parentSince != null && childSince != null) {
      let pv = (parentSince as Attribute).version as String;
      let cv = (childSince as Attribute).version as String;
      if (compareVersions(pv, cv) > 0) newAttrs.push(parentSince as Attribute);
      else newAttrs.push(childSince as Attribute);
    } else if (parentSince != null) {
      newAttrs.push(parentSince as Attribute);
    } else if (childSince != null) {
      newAttrs.push(childSince as Attribute);
    }
  }
  
  if (parentDeprecated != null && childDeprecated != null) {
    let pv = (parentDeprecated as Attribute).version as String;
    let cv = (childDeprecated as Attribute).version as String;
    if (compareVersions(pv, cv) < 0) newAttrs.push(parentDeprecated as Attribute);
    else newAttrs.push(childDeprecated as Attribute);
  } else if (parentDeprecated != null) {
    newAttrs.push(parentDeprecated as Attribute);
  } else if (childDeprecated != null) {
    newAttrs.push(childDeprecated as Attribute);
  }
  
  let d = new Docs(parent.span);
  d.attributes = newAttrs;
  return d;
};

let filterUnstableOnly = (docs: Docs | null): Docs | null => {
  if (docs == null || docs.attributes == null) return null;
  let attrs = docs.attributes as Array<Attribute>;
  let newAttrs = new Array<Attribute>();
  var i = 0;
  while (i < attrs.length) {
    let attr = attrs[i];
    if (attr.tag == AttributeTag.Unstable) {
      newAttrs.push(attr);
    }
    i = i + 1;
  }
  if (newAttrs.length == 0) return null;
  let d = new Docs(docs.span);
  d.attributes = newAttrs;
  return d;
};

let filterStableOnly = (docs: Docs | null): Docs | null => {
  if (docs == null || docs.attributes == null) return null;
  let attrs = docs.attributes as Array<Attribute>;
  let newAttrs = new Array<Attribute>();
  var i = 0;
  while (i < attrs.length) {
    let attr = attrs[i];
    if (attr.tag == AttributeTag.Since || attr.tag == AttributeTag.Deprecated) {
      newAttrs.push(attr);
    }
    i = i + 1;
  }
  if (newAttrs.length == 0) return null;
  let d = new Docs(docs.span);
  d.attributes = newAttrs;
  return d;
};

let expandWorldItems = (ctx: SerializeContext, world: WorldDef): Array<WorldItem> => {
  let result = new Array<WorldItem>();
  let visited = new HashMap<String, boolean>();
  
  let rec = (w: WorldDef, renames: Array<IncludeName>, inheritedDocs: Docs | null): void => {
    let key = i32ToString(w.packageIndex) + "/" + normalizeId(w.name.name);
    if (visited.has(key)) {
      return;
    }
    visited[key] = true;
    
    let worldUnstableDocs = if (visited.size > 1) filterUnstableOnly(w.docs) else null;
    let currentInheritedDocs = combineDocs(inheritedDocs, worldUnstableDocs);
    
    var idx = 0;
    while (idx < w.items.length) {
      let item = w.items[idx];
      if (item.tag == WorldItemTag.Include) {
        let inc = item.include as Include;
        let incWorld = findWorldByUsePath(ctx, inc.from);
        if (incWorld != null) {
          let nestedRenames = new Array<IncludeName>();
          var rIdx = 0;
          while (rIdx < inc.names.length) {
            let n = inc.names[rIdx];
            let renamedAs = applyRename(n.asName.name, renames);
            nestedRenames.push(new IncludeName(n.name, new Id(renamedAs, n.asName.span)));
            rIdx = rIdx + 1;
          }
          var pIdx = 0;
          while (pIdx < renames.length) {
            let pr = renames[pIdx];
            var found = false;
            var j = 0;
            while (j < nestedRenames.length) {
              if (nestedRenames[j].name.name == pr.name.name) {
                found = true;
              }
              j = j + 1;
            }
            if (!found) {
              nestedRenames.push(pr);
            }
            pIdx = pIdx + 1;
          }
          
          let includeInheritedDocs = if (visited.size == 1) combineDocs(currentInheritedDocs, filterStableOnly(inc.docs)) else currentInheritedDocs;
          rec(incWorld as WorldDef, nestedRenames, includeInheritedDocs);
        }
      } else {
        var renamedItem = renameWorldItem(item, renames);
        let cloned = new WorldItem(item.tag);
        cloned.packageIndex = w.packageIndex;
        if (renames.length > 0 || visited.size > 1) {
          cloned.isIncluded = true;
        }
        
        let combineWith = if (visited.size > 1) currentInheritedDocs else null;
        cloned.inheritedDocs = combineWith;
        
        if (item.tag == WorldItemTag.Import) {
          let imp = renamedItem.importItem as Import;
          cloned.importItem = new Import(combineDocs(combineWith, imp.docs), imp.kind);
          cloned.isExplicit = imp.docs != null;
        } else if (item.tag == WorldItemTag.Export) {
          let exp = renamedItem.exportItem as Export;
          cloned.exportItem = new Export(combineDocs(combineWith, exp.docs), exp.kind);
          cloned.isExplicit = exp.docs != null;
        } else if (item.tag == WorldItemTag.Use) {
          let u = renamedItem.use as Use;
          cloned.use = new Use(combineDocs(combineWith, u.docs), u.from, u.names);
          cloned.isExplicit = u.docs != null;
        } else {
          cloned.importItem = renamedItem.importItem;
          cloned.exportItem = renamedItem.exportItem;
          cloned.use = renamedItem.use;
          cloned.typeDef = renamedItem.typeDef;
          cloned.include = renamedItem.include;
        }
        
        result.push(cloned);
      }
      idx = idx + 1;
    }
  };
  
  let prevWorldPackageIndex = ctx.currentWorldPackageIndex;
  ctx.currentWorldPackageIndex = world.packageIndex;
  rec(world, new Array<IncludeName>(), null);
  ctx.currentWorldPackageIndex = prevWorldPackageIndex;
  return result;
};

let registerWorldTypes = (ctx: SerializeContext, world: WorldDef, worldIdx: i32, items: Array<WorldItem>): void => {
  let siblingTypes = new HashMap<String, ScopeTypeElement>();
  let worldName = normalizeId(world.name.name);
  
  var idx = 0;
  while (idx < items.length) {
    let item = items[idx];
    if (item.tag == WorldItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      siblingTypes[normalizeId(td.name.name)] = ScopeTypeElement.fromTd(td);
    } else if (item.tag == WorldItemTag.Use) {
      let u = item.use as Use;
      var j = 0;
      while (j < u.names.length) {
        let un = u.names[j];
        let localName = normalizeId(if (un.asName != null) (un.asName as Id).name else un.name.name);
        siblingTypes[localName] = ScopeTypeElement.fromUse(u.from, un, u.docs);
        j = j + 1;
      }
    }
    idx = idx + 1;
  }

  let visited = new HashMap<String, i32>();
  let registeredIndices = new HashMap<String, i32>();

  let ensureRegistered = (name: String): i32 => {
    let normName = normalizeId(name);
    if (let (true, status) = visited.get(normName)) {
      if (status == 2) {
        if (let (true, registeredIdx) = registeredIndices.get(normName)) {
          return registeredIdx;
        }
        return -1;
      }
      if (status == 1) {
        return -1;
      }
    }

    if (let (true, elemObj) = siblingTypes.get(normName)) {
      visited[normName] = 1;
      let elem = elemObj as ScopeTypeElement;
      
      var typeIdx = -1;
      if (elem.isTypeDef()) {
        let td = elem.typeDef() as TypeDef;
        let deps = new Array<String>();
        collectTypeDefDeps(td, deps);

        var dIdx = 0;
        while (dIdx < deps.length) {
          let dep = deps[dIdx];
          if (siblingTypes.has(dep)) {
            ensureRegistered(dep);
          }
          dIdx = dIdx + 1;
        }

        typeIdx = registerTypeDef(ctx, td, TypeOwner.fromWorld(worldIdx));
      } else {
        let pkgName = ctx.packages[world.packageIndex].name;
        let srcIfaceName = resolveInterfaceName(ctx, pkgName, elem.usePath() as UsePath);
        let srcTypeName = normalizeId((elem.useName() as UseName).name.name);
        
        var srcIdx = -1;
        let lookupKey = "interface:" + srcIfaceName + "/" + srcTypeName;
        if (let (true, sIdx) = ctx.typeIndices.get(lookupKey)) {
          srcIdx = sIdx;
        } else {
          if (let (true, sIdx) = ctx.typeIndices.get(srcTypeName)) {
            srcIdx = sIdx;
          }
        }
        
        if (srcIdx >= 0) {
          let kind = new TypeAlias(TypeRef.idx(srcIdx));
          
          let entry = new TypeEntry(normName, kind, some(TypeOwner.fromWorld(worldIdx)), elem.docs());
          typeIdx = ctx.registerType(entry);
        }
      }

      if (typeIdx >= 0) {
        registeredIndices[normName] = typeIdx;
        ctx.typeIndices["world:" + worldName + "/" + normName] = typeIdx;
      }
      
      visited[normName] = 2;
      return typeIdx;
    }

    return -1;
  };

  idx = 0;
  while (idx < items.length) {
    let item = items[idx];
    if (item.tag == WorldItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      ensureRegistered(normalizeId(td.name.name));
    } else if (item.tag == WorldItemTag.Use) {
      let u = item.use as Use;
      var j = 0;
      while (j < u.names.length) {
        let un = u.names[j];
        let localName = normalizeId(if (un.asName != null) (un.asName as Id).name else un.name.name);
        ensureRegistered(localName);
        j = j + 1;
      }
    }
    idx = idx + 1;
  }
};

let registerAllTypes = (ctx: SerializeContext): void => {
  var iIdx = 0;
  while (iIdx < ctx.interfaces.length) {
    ctx.currentInterfaceName = normalizeId(ctx.interfaces[iIdx].name.name);
    ctx.currentWorldName = null;
    registerInterfaceTypes(ctx, ctx.interfaces[iIdx], iIdx);
    iIdx = iIdx + 1;
  }

  var wIdx = 0;
  while (wIdx < ctx.worlds.length) {
    ctx.currentInterfaceName = null;
    ctx.currentWorldName = normalizeId(ctx.worlds[wIdx].name.name);
    let expandedItems = expandWorldItems(ctx, ctx.worlds[wIdx]);
    registerWorldTypes(ctx, ctx.worlds[wIdx], wIdx, expandedItems);
    wIdx = wIdx + 1;
  }
  
  ctx.currentInterfaceName = null;
  ctx.currentWorldName = null;
};

let typeContainsBorrowFor = (t: Type, resourceName: String): boolean => {
  if (t.tag == TypeTag.Borrow) {
    let inner = t.inner as Type;
    if (inner.tag == TypeTag.Name) {
      let id = inner.name as Id;
      return normalizeId(id.name) == resourceName;
    }
  }
  if (t.tag == TypeTag.Tuple) {
    let types = t.types as Array<Type>;
    var idx = 0;
    while (idx < types.length) {
      if (typeContainsBorrowFor(types[idx], resourceName)) {
        return true;
      }
      idx = idx + 1;
    }
  } else if (t.tag == TypeTag.Result) {
    if (t.okType != null && typeContainsBorrowFor(t.okType as Type, resourceName)) {
      return true;
    }
    if (t.errType != null && typeContainsBorrowFor(t.errType as Type, resourceName)) {
      return true;
    }
  } else if (t.tag == TypeTag.Option || t.tag == TypeTag.List ||
             t.tag == TypeTag.Future || t.tag == TypeTag.Stream) {
    if (t.inner != null) {
      return typeContainsBorrowFor(t.inner as Type, resourceName);
    }
  }
  return false;
};

let isNakedOwnOrResource = (ctx: SerializeContext, t: Type): boolean => {
  if (t.tag == TypeTag.Own) {
    return true;
  }
  if (t.tag == TypeTag.Name) {
    let id = t.name as Id;
    let name = normalizeId(id.name);
    var foundIdx = -1;
    if (ctx.currentInterfaceName != null) {
      let key = "interface:" + (ctx.currentInterfaceName as String) + "/" + name;
      if (let (true, idx) = ctx.typeIndices.get(key)) {
        foundIdx = idx;
      }
    }
    if (foundIdx < 0 && ctx.currentWorldName != null) {
      let key = "world:" + (ctx.currentWorldName as String) + "/" + name;
      if (let (true, idx) = ctx.typeIndices.get(key)) {
        foundIdx = idx;
      }
    }
    if (foundIdx < 0) {
      if (let (true, idx) = ctx.typeIndices.get(name)) {
        foundIdx = idx;
      }
    }
    if (foundIdx >= 0 && ctx.isResourceType(foundIdx)) {
      return true;
    }
  }
  return false;
};

let registerInterfaceAllScopeTypes = (ctx: SerializeContext, iface: InterfaceDef, ifaceIdx: i32): void => {
  ctx.currentInterfaceName = normalizeId(iface.name.name);
  ctx.currentWorldName = null;
  
  // Stage 1: Register all defined TypeDefs
  registerInterfaceTypes(ctx, iface, ifaceIdx);
  
  // Identify all local resources
  let resources = new Array<TypeDef>();
  var idx = 0;
  while (idx < iface.items.length) {
    let item = iface.items[idx];
    if (item.tag == InterfaceItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      if (td.tag == TypeDefTag.Resource) {
        resources.push(td);
      }
    }
    idx = idx + 1;
  }
  
  // Stage 3a: Process resource functions' explicit types FIRST
  idx = 0;
  while (idx < iface.items.length) {
    let item = iface.items[idx];
    if (item.tag == InterfaceItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      if (td.tag == TypeDefTag.Resource && td.resourceFuncs != null) {
        let funcs = td.resourceFuncs as Array<ResourceFunc>;
        var fIdx = 0;
        while (fIdx < funcs.length) {
          let rf = funcs[fIdx];
          
          // Prepend implicit self parameter (borrow<resource>) if it is a method
          if (rf.tag == ResourceFuncTag.Method) {
            let rName = normalizeId(td.name.name);
            var resourceTypeIdx = -1;
            let lookupKey = "interface:" + (ctx.currentInterfaceName as String) + "/" + rName;
            if (let (true, sIdx) = ctx.typeIndices.get(lookupKey)) {
              resourceTypeIdx = sIdx;
            }
            if (resourceTypeIdx >= 0) {
              ctx.getBorrowType(resourceTypeIdx);
            }
          }
          
          var pIdx = 0;
          while (pIdx < rf.func.func.params.length) {
            let paramType = rf.func.func.params[pIdx].type;
            if (!isNakedOwnOrResource(ctx, paramType)) {
              ctx.getParamTypeRef(paramType);
            }
            pIdx = pIdx + 1;
          }
          if (rf.func.func.result != null) {
            let resultType = rf.func.func.result as Type;
            if (!isNakedOwnOrResource(ctx, resultType)) {
              ctx.getParamTypeRef(resultType);
            }
          }
          fIdx = fIdx + 1;
        }
      }
    }
    idx = idx + 1;
  }
  
  // Stage 3b: Process freestanding functions' explicit types SECOND
  idx = 0;
  while (idx < iface.items.length) {
    let item = iface.items[idx];
    if (item.tag == InterfaceItemTag.Func) {
      let func = item.func as NamedFunc;
      var pIdx = 0;
      while (pIdx < func.func.params.length) {
        let paramType = func.func.params[pIdx].type;
        if (!isNakedOwnOrResource(ctx, paramType)) {
          ctx.getParamTypeRef(paramType);
        }
        pIdx = pIdx + 1;
      }
      if (func.func.result != null) {
        let resultType = func.func.result as Type;
        if (!isNakedOwnOrResource(ctx, resultType)) {
          ctx.getParamTypeRef(resultType);
        }
      }
    }
    idx = idx + 1;
  }
  
  ctx.currentInterfaceName = null;
  ctx.currentWorldName = null;
};

let registerWorldAllScopeTypes = (ctx: SerializeContext, world: WorldDef, worldIdx: i32): void => {
  ctx.currentInterfaceName = null;
  ctx.currentWorldName = normalizeId(world.name.name);
  
  let expandedItems = expandWorldItems(ctx, world);
  
  // Stage 1: Register all defined TypeDefs
  registerWorldTypes(ctx, world, worldIdx, expandedItems);
  
  // Identify all local/included resources
  let resources = new Array<WorldItem>();
  var idx = 0;
  while (idx < expandedItems.length) {
    let item = expandedItems[idx];
    if (item.tag == WorldItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      if (td.tag == TypeDefTag.Resource) {
        resources.push(item);
      }
    }
    idx = idx + 1;
  }
  
  // Stage 3a: Process world resource functions' explicit types FIRST (only local resources)
  var rFuncIdx = 0;
  while (rFuncIdx < resources.length) {
    let item = resources[rFuncIdx];
    if (!item.isIncluded) {
      let r = item.typeDef as TypeDef;
      if (r.resourceFuncs != null) {
        let funcs = r.resourceFuncs as Array<ResourceFunc>;
        var fIdx = 0;
        while (fIdx < funcs.length) {
          let rf = funcs[fIdx];
          
          // Prepend implicit self parameter (borrow<resource>) if it is a method
          if (rf.tag == ResourceFuncTag.Method) {
            let rName = normalizeId(r.name.name);
            var resourceTypeIdx = -1;
            let lookupKey = "world:" + (ctx.currentWorldName as String) + "/" + rName;
            if (let (true, sIdx) = ctx.typeIndices.get(lookupKey)) {
              resourceTypeIdx = sIdx;
            }
            if (resourceTypeIdx >= 0) {
              ctx.getBorrowType(resourceTypeIdx);
            }
          }
          
          var pIdx = 0;
          while (pIdx < rf.func.func.params.length) {
            let paramType = rf.func.func.params[pIdx].type;
            if (!isNakedOwnOrResource(ctx, paramType)) {
              ctx.getParamTypeRef(paramType);
            }
            pIdx = pIdx + 1;
          }
          if (rf.func.func.result != null) {
            let resultType = rf.func.func.result as Type;
            if (!isNakedOwnOrResource(ctx, resultType)) {
              ctx.getParamTypeRef(resultType);
            }
          }
          fIdx = fIdx + 1;
        }
      }
    }
    rFuncIdx = rFuncIdx + 1;
  }
  
  // Stage 3b: Process world import/export function explicit types SECOND
  idx = 0;
  while (idx < expandedItems.length) {
    let item = expandedItems[idx];
    if (item.tag == WorldItemTag.Import) {
      let imp = item.importItem as Import;
      if (imp.kind.tag == ExternKindTag.Func) {
        let func = imp.kind.funcDef as Func;
        var pIdx = 0;
        while (pIdx < func.params.length) {
          let paramType = func.params[pIdx].type;
          if (!isNakedOwnOrResource(ctx, paramType)) {
            ctx.getParamTypeRef(paramType);
          }
          pIdx = pIdx + 1;
        }
        if (func.result != null) {
          let resultType = func.result as Type;
          if (!isNakedOwnOrResource(ctx, resultType)) {
            ctx.getParamTypeRef(resultType);
          }
        }
      }
    } else if (item.tag == WorldItemTag.Export) {
      let exp = item.exportItem as Export;
      if (exp.kind.tag == ExternKindTag.Func) {
        let func = exp.kind.funcDef as Func;
        var pIdx = 0;
        while (pIdx < func.params.length) {
          let paramType = func.params[pIdx].type;
          if (!isNakedOwnOrResource(ctx, paramType)) {
            ctx.getParamTypeRef(paramType);
          }
          pIdx = pIdx + 1;
        }
        if (func.result != null) {
          let resultType = func.result as Type;
          if (!isNakedOwnOrResource(ctx, resultType)) {
            ctx.getParamTypeRef(resultType);
          }
        }
      }
    }
    idx = idx + 1;
  }
  
  // Stage 3c: Process world resource functions' explicit types THIRD (only included resources)
  rFuncIdx = 0;
  while (rFuncIdx < resources.length) {
    let item = resources[rFuncIdx];
    if (item.isIncluded) {
      let r = item.typeDef as TypeDef;
      if (r.resourceFuncs != null) {
        let funcs = r.resourceFuncs as Array<ResourceFunc>;
        var fIdx = 0;
        while (fIdx < funcs.length) {
          let rf = funcs[fIdx];
          
          // Prepend implicit self parameter (borrow<resource>) if it is a method
          if (rf.tag == ResourceFuncTag.Method) {
            let rName = normalizeId(r.name.name);
            var resourceTypeIdx = -1;
            let lookupKey = "world:" + (ctx.currentWorldName as String) + "/" + rName;
            if (let (true, sIdx) = ctx.typeIndices.get(lookupKey)) {
              resourceTypeIdx = sIdx;
            }
            if (resourceTypeIdx >= 0) {
              ctx.getBorrowType(resourceTypeIdx);
            }
          }
          
          var pIdx = 0;
          while (pIdx < rf.func.func.params.length) {
            let paramType = rf.func.func.params[pIdx].type;
            if (!isNakedOwnOrResource(ctx, paramType)) {
              ctx.getParamTypeRef(paramType);
            }
            pIdx = pIdx + 1;
          }
          if (rf.func.func.result != null) {
            let resultType = rf.func.func.result as Type;
            if (!isNakedOwnOrResource(ctx, resultType)) {
              ctx.getParamTypeRef(resultType);
            }
          }
          fIdx = fIdx + 1;
        }
      }
    }
    rFuncIdx = rFuncIdx + 1;
  }
  
  ctx.currentInterfaceName = null;
  ctx.currentWorldName = null;
};

let registerAllTypesAndScopeSignatures = (ctx: SerializeContext): void => {
  // First, process all interfaces Block-by-Block (one at a time)
  var iIdx = 0;
  while (iIdx < ctx.interfaces.length) {
    registerInterfaceAllScopeTypes(ctx, ctx.interfaces[iIdx], iIdx);
    iIdx = iIdx + 1;
  }
  
  // Second, process all worlds Block-by-Block (one at a time)
  var wIdx = 0;
  while (wIdx < ctx.worlds.length) {
    registerWorldAllScopeTypes(ctx, ctx.worlds[wIdx], wIdx);
    wIdx = wIdx + 1;
  }
};



let typeDefTagToString = (tag: TypeDefTag): String => {
  if (tag == TypeDefTag.Record) { return "record"; }
  if (tag == TypeDefTag.Flags) { return "flags"; }
  if (tag == TypeDefTag.Variant) { return "variant"; }
  if (tag == TypeDefTag.Enum) { return "enum"; }
  if (tag == TypeDefTag.Resource) { return "resource"; }
  return "type";
};

/** Check if a type is a primitive (outputs as string) vs complex (outputs as index). */
let isPrimitiveType = (t: Type): boolean => {
  if (t.tag == TypeTag.U8) { return true; }
  if (t.tag == TypeTag.U16) { return true; }
  if (t.tag == TypeTag.U32) { return true; }
  if (t.tag == TypeTag.U64) { return true; }
  if (t.tag == TypeTag.S8) { return true; }
  if (t.tag == TypeTag.S16) { return true; }
  if (t.tag == TypeTag.S32) { return true; }
  if (t.tag == TypeTag.S64) { return true; }
  if (t.tag == TypeTag.F32) { return true; }
  if (t.tag == TypeTag.F64) { return true; }
  if (t.tag == TypeTag.Char) { return true; }
  if (t.tag == TypeTag.Bool) { return true; }
  if (t.tag == TypeTag.String) { return true; }
  if (t.tag == TypeTag.ErrorContext) { return true; }
  if (t.tag == TypeTag.Name) { return true; }
  return false;
};

/** Get primitive type as string. Only valid for primitive types. */
let primitiveTypeToString = (t: Type): String => {
  if (t.tag == TypeTag.U8) { return "u8"; }
  if (t.tag == TypeTag.U16) { return "u16"; }
  if (t.tag == TypeTag.U32) { return "u32"; }
  if (t.tag == TypeTag.U64) { return "u64"; }
  if (t.tag == TypeTag.S8) { return "s8"; }
  if (t.tag == TypeTag.S16) { return "s16"; }
  if (t.tag == TypeTag.S32) { return "s32"; }
  if (t.tag == TypeTag.S64) { return "s64"; }
  if (t.tag == TypeTag.F32) { return "f32"; }
  if (t.tag == TypeTag.F64) { return "f64"; }
  if (t.tag == TypeTag.Char) { return "char"; }
  if (t.tag == TypeTag.Bool) { return "bool"; }
  if (t.tag == TypeTag.String) { return "string"; }
  if (t.tag == TypeTag.ErrorContext) { return "error-context"; }
  if (t.tag == TypeTag.Name) {
    let id = t.name as Id;
    return id.name;
  }
  return "unknown";
};



/** Build a TypeKind from a Type for use in type definitions (embeds complex types directly). */
let buildTypeKind = (ctx: SerializeContext, t: Type, resolveResourceAsOwn: boolean): TypeKind => {
  if (t.tag == TypeTag.Stream) {
    let innerRef = if (t.inner != null) ctx.getTypeRef(t.inner as Type) else null;
    return new StreamKind(innerRef);
  } else if (t.tag == TypeTag.Future) {
    let innerRef = if (t.inner != null) ctx.getTypeRef(t.inner as Type) else null;
    return new FutureKind(innerRef);
  } else if (t.tag == TypeTag.Option) {
    return new OptionKind(ctx.getTypeRef(t.inner as Type));
  } else if (t.tag == TypeTag.List) {
    if (t.fixedLength >= 0) {
      return new FixedLengthListKind(ctx.getTypeRef(t.inner as Type), t.fixedLength);
    } else {
      return new ListKind(ctx.getTypeRef(t.inner as Type));
    }
  } else if (t.tag == TypeTag.Result) {
    let ok = if (t.okType != null) ctx.getTypeRef(t.okType as Type) else null;
    let err = if (t.errType != null) ctx.getTypeRef(t.errType as Type) else null;
    return new ResultKind(ok, err);
  } else if (t.tag == TypeTag.Tuple) {
    let types = t.types as Array<Type>;
    let refs = new Array<TypeRef>();
    var idx = 0;
    while (idx < types.length) {
      refs.push(ctx.getTypeRef(types[idx]));
      idx = idx + 1;
    }
    return new TupleKind(refs);
  } else if (t.tag == TypeTag.Own) {
    let innerRef = ctx.getTypeRefEx(t.inner as Type, false);
    var ownIndex = -1;
    if (innerRef.isIndex()) {
      ownIndex = innerRef.indexValue();
    }
    return new HandleKind(-1, ownIndex);
  } else if (t.tag == TypeTag.Borrow) {
    let innerRef = ctx.getTypeRefEx(t.inner as Type, false);
    var borrowIndex = -1;
    if (innerRef.isIndex()) {
      borrowIndex = innerRef.indexValue();
    }
    return new HandleKind(borrowIndex, -1);
  } else if (t.tag == TypeTag.Map) {
    let key = ctx.getTypeRefEx(t.keyType as Type, resolveResourceAsOwn);
    let value = ctx.getTypeRefEx(t.valueType as Type, resolveResourceAsOwn);
    return new MapKind(key, value);
  } else {
    // Primitive or name reference - wrap it as "type"
    return new TypeAlias(ctx.getTypeRefEx(t, resolveResourceAsOwn));
  }
};

let registerTypeDef = (ctx: SerializeContext, td: TypeDef, owner: TypeOwner): i32 => {
  let kind = if (td.tag == TypeDefTag.Record) {
    let fieldsArr = new Array<RecordField>();
    let fields = td.fields as Array<Field>;
    var idx = 0;
    while (idx < fields.length) {
      let field = fields[idx];
      let typeRef = ctx.getTypeRef(field.type);
      fieldsArr.push(new RecordField(normalizeId(field.name.name), typeRef));
      idx = idx + 1;
    }
    new RecordKind(fieldsArr)
  } else if (td.tag == TypeDefTag.Alias) {
    buildTypeKind(ctx, td.aliasType as Type, false)
  } else if (td.tag == TypeDefTag.Enum) {
    let casesArr = new Array<EnumCase>();
    let cases = td.enumCases as Array<EnumCaseDef>;
    var idx = 0;
    while (idx < cases.length) {
      let ec = cases[idx];
      var docs: Docs | null = null;
      if (ec.docs.contents != null) {
        docs = ec.docs;
      }
      casesArr.push(new EnumCase(normalizeId(ec.name.name), docs));
      idx = idx + 1;
    }
    new EnumKind(casesArr)
  } else if (td.tag == TypeDefTag.Flags) {
    let flagsArr = new Array<String>();
    let flags = td.flags as Array<FlagDef>;
    var idx = 0;
    while (idx < flags.length) {
      flagsArr.push(normalizeId(flags[idx].name.name));
      idx = idx + 1;
    }
    new FlagsKind(flagsArr)
  } else if (td.tag == TypeDefTag.Variant) {
    let casesArr = new Array<VariantCase>();
    let cases = td.cases as Array<Case>;
    var idx = 0;
    while (idx < cases.length) {
      let c = cases[idx];
      var typeRef: TypeRef | null = null;
      if (c.type != null) {
        typeRef = ctx.getTypeRef(c.type as Type);
      }
      casesArr.push(new VariantCase(normalizeId(c.name.name), typeRef));
      idx = idx + 1;
    }
    new VariantKind(casesArr)
  } else if (td.tag == TypeDefTag.Resource) {
    new ResourceKind()
  } else {
    new UnknownKind()
  };

  let entry = new TypeEntry(normalizeId(td.name.name), kind, some(owner), td.docs);
  let typeIdx = ctx.registerType(entry);
  
  // Track resources for bare name -> own<resource> conversion
  if (td.tag == TypeDefTag.Resource) {
    ctx.resourceTypeIndices[typeIdx] = 1;
  }
  
  return typeIdx;
};

let serializeResourceFunc = (b: JsonBuilder, ctx: SerializeContext, rf: ResourceFunc, resourceName: String, ifaceIndex: i32): void => {
  b.beginObject();
    // Get the resource type index using current interface/world scope first
  var resourceTypeIdx = -1;
  if (ctx.currentInterfaceName != null) {
    let key = "interface:" + (ctx.currentInterfaceName as String) + "/" + resourceName;
    if (let (true, idx) = ctx.typeIndices.get(key)) {
      resourceTypeIdx = idx;
    }
  }
  if (resourceTypeIdx < 0 && ctx.currentWorldName != null) {
    let key = "world:" + (ctx.currentWorldName as String) + "/" + resourceName;
    if (let (true, idx) = ctx.typeIndices.get(key)) {
      resourceTypeIdx = idx;
    }
  }
  if (resourceTypeIdx < 0) {
    if (let (true, idx) = ctx.typeIndices.get(resourceName)) {
      resourceTypeIdx = idx;
    }
  }
  if (resourceTypeIdx < 0) {
    resourceTypeIdx = 0;
  }
  
  // name includes prefix (e.g., "[method]resource.method")
  if (rf.tag == ResourceFuncTag.Method) {
    b.key("name").string("[method]" + resourceName + "." + normalizeId(rf.func.name.name));
    b.key("kind").beginObject();
    if (rf.func.func.isAsync) {
      b.key("async-method").i32(resourceTypeIdx);
    } else {
      b.key("method").i32(resourceTypeIdx);
    }
    b.endObject();
  } else if (rf.tag == ResourceFuncTag.Static) {
    b.key("name").string("[static]" + resourceName + "." + normalizeId(rf.func.name.name));
    b.key("kind").beginObject();
    if (rf.func.func.isAsync) {
      b.key("async-static").i32(resourceTypeIdx);
    } else {
      b.key("static").i32(resourceTypeIdx);
    }
    b.endObject();
  } else if (rf.tag == ResourceFuncTag.Constructor) {
    b.key("name").string("[constructor]" + resourceName);
    b.key("kind").beginObject();
    b.key("constructor").i32(resourceTypeIdx);
    b.endObject();
  }
  
  // Serialize params
  b.key("params").beginArray();
  
  // For methods, prepend implicit "self" parameter (borrow<resource>)
  if (rf.tag == ResourceFuncTag.Method) {
    // Use existing borrow type or create if needed
    let borrowIdx = ctx.getBorrowType(resourceTypeIdx);
    
    b.beginObject();
    b.key("name").string("self");
    b.key("type").i32(borrowIdx);
    b.endObject();
  }
  
  var idx = 0;
  let nf = rf.func;
  while (idx < nf.func.params.length) {
    let param = nf.func.params[idx];
    b.beginObject();
    b.key("name").string(normalizeId(param.name.name));
    b.key("type");
    let typeRef = ctx.getParamTypeRef(param.type);
    typeRef.serialize(b);
    b.endObject();
    idx = idx + 1;
  }
  b.endArray();
  
  // Result
  // Constructors have an implicit own<resource> result
  if (rf.tag == ResourceFuncTag.Constructor) {
    // Check if there's an explicit result
    if (nf.func.result != null) {
      b.key("result");
      let resultRef = ctx.getParamTypeRef(nf.func.result as Type);
      resultRef.serialize(b);
    } else {
      // Use existing own type or create if needed
      let ownIdx = ctx.getOwnType(resourceTypeIdx);
      b.key("result").i32(ownIdx);
    }
  } else if (nf.func.result != null) {
    b.key("result");
    let resultRef = ctx.getParamTypeRef(nf.func.result as Type);
    resultRef.serialize(b);
  }
  
  serializeStability(b, rf.func.docs);
  b.endObject();
};

let serializeFunction = (b: JsonBuilder, ctx: SerializeContext, nf: NamedFunc): void => {
  b.beginObject();
  b.key("name").string(normalizeId(nf.name.name));
  if (nf.func.isAsync) {
    b.key("kind").string("async-freestanding");
  } else {
    b.key("kind").string("freestanding");
  }
  
  b.key("params").beginArray();
  var idx = 0;
  while (idx < nf.func.params.length) {
    let param = nf.func.params[idx];
    b.beginObject();
    b.key("name").string(normalizeId(param.name.name));
    b.key("type");
    let typeRef = ctx.getParamTypeRef(param.type);
    typeRef.serialize(b);
    b.endObject();
    idx = idx + 1;
  }
  b.endArray();
  
  if (nf.func.result != null) {
    b.key("result");
    let resultRef = ctx.getParamTypeRef(nf.func.result as Type);
    resultRef.serialize(b);
  }
  
  // Serialize docs if present
  if (nf.docs.contents != null) {
    b.key("docs").beginObject();
    b.key("contents").string(nf.docs.contents as String);
    b.endObject();
  }
  
  serializeStability(b, nf.docs);
  b.endObject();
};



/** Serialize a world function (for import/export). */
let serializeWorldFunction = (b: JsonBuilder, ctx: SerializeContext, name: String, func: Func, docs: Docs | null): void => {
  b.beginObject();
  b.key("name").string(name);
  
  // Determine kind
  if (func.isAsync) {
    b.key("kind").string("async-freestanding");
  } else {
    b.key("kind").string("freestanding");
  }
  
  // Params
  b.key("params").beginArray();
  var pIdx = 0;
  while (pIdx < func.params.length) {
    let param = func.params[pIdx];
    b.beginObject();
    b.key("name").string(normalizeId(param.name.name));
    b.key("type");
    let typeRef = ctx.getParamTypeRef(param.type);
    typeRef.serialize(b);
    b.endObject();
    pIdx = pIdx + 1;
  }
  b.endArray();
  
  // Result
  if (func.result != null) {
    let resultType = func.result as Type;
    b.key("result");
    let resultRef = ctx.getParamTypeRef(resultType);
    resultRef.serialize(b);
  }
  
  serializeStability(b, docs);
  b.endObject();
};

/** Serialize an extern kind (import/export item content). */
let serializeExternKind = (b: JsonBuilder, ctx: SerializeContext, kind: ExternKind, docs: Docs | null): void => {
  b.beginObject();
  if (kind.tag == ExternKindTag.Func) {
    b.key("function");
    let name = normalizeId((kind.name as Id).name);
    let func = kind.funcDef as Func;
    serializeWorldFunction(b, ctx, name, func, docs);
  } else if (kind.tag == ExternKindTag.Path) {
    // Interface reference - TODO: Resolve interface by path
    b.key("interface").beginObject();
    b.key("id").i32(0); // placeholder
    b.endObject();
  } else if (kind.tag == ExternKindTag.Interface) {
    // Inline interface - TODO: Create anonymous interface in interfaces array
    b.key("interface").beginObject();
    b.key("id").i32(0); // placeholder
    b.endObject();
  }
  b.endObject();
};

let collectWorldImports = (ctx: SerializeContext, world: WorldDef, items: Array<WorldItem>): HashMap<i32, boolean> => {
  let imports = new HashMap<i32, boolean>();
  let visited = new HashMap<i32, boolean>();

  // Worker to recursively traverse used interfaces
  let visit = (ifaceIdx: i32, isDirectExport: boolean): void => {
    if (visited.has(ifaceIdx)) return;
    visited[ifaceIdx] = true;
    
    // Any transitive dependency of an imported or exported interface is imported!
    if (!isDirectExport) {
      imports[ifaceIdx] = true;
    }
    
    // Now, find what this interface uses
    let iface = ctx.interfaces[ifaceIdx];
    var idx = 0;
    while (idx < iface.items.length) {
      let item = iface.items[idx];
      if (item.tag == InterfaceItemTag.Use) {
        let u = item.use as Use;
        let usePkgName = ctx.packages[iface.packageIndex].name;
        let depIdx = resolveInterfaceNameAndIndex(ctx, usePkgName, u.from);
        if (depIdx >= 0) {
          visit(depIdx, false);
        }
      }
      idx = idx + 1;
    }
  };

  // Now, seed the recursive traversal with direct imports/exports
  let pkgName = ctx.packages[world.packageIndex].name;
  var idx = 0;
  while (idx < items.length) {
    let item = items[idx];
    let itemPkgName = if (item.packageIndex >= 0) ctx.packages[item.packageIndex].name else pkgName;
    if (item.tag == WorldItemTag.Import) {
      let imp = item.importItem as Import;
      if (imp.kind.tag == ExternKindTag.Interface) {
        let name = "[import]" + normalizeId((imp.kind.name as Id).name);
        var ifaceIdx = -1;
        if (itemPkgName.length > 0) {
          let lookupKey = itemPkgName + "/inline/" + name;
          if (let (true, sIdx) = ctx.interfaceIndices.get(lookupKey)) {
            ifaceIdx = sIdx;
          }
        }
        if (ifaceIdx < 0) {
          if (let (true, sIdx) = ctx.interfaceIndices.get(name)) {
            ifaceIdx = sIdx;
          }
        }
        if (ifaceIdx >= 0) {
          visit(ifaceIdx, false);
        }
      } else if (imp.kind.tag == ExternKindTag.Path) {
        let ifaceIdx = resolveInterfaceNameAndIndex(ctx, itemPkgName, imp.kind.path as UsePath);
        if (ifaceIdx >= 0) {
          visit(ifaceIdx, false);
        }
      }
    } else if (item.tag == WorldItemTag.Export) {
      let exp = item.exportItem as Export;
      if (exp.kind.tag == ExternKindTag.Interface) {
        let name = "[export]" + normalizeId((exp.kind.name as Id).name);
        var ifaceIdx = -1;
        if (itemPkgName.length > 0) {
          let lookupKey = itemPkgName + "/inline/" + name;
          if (let (true, sIdx) = ctx.interfaceIndices.get(lookupKey)) {
            ifaceIdx = sIdx;
          }
        }
        if (ifaceIdx < 0) {
          if (let (true, sIdx) = ctx.interfaceIndices.get(name)) {
            ifaceIdx = sIdx;
          }
        }
        if (ifaceIdx >= 0) {
          visit(ifaceIdx, true);
        }
      } else if (exp.kind.tag == ExternKindTag.Path) {
        let ifaceIdx = resolveInterfaceNameAndIndex(ctx, itemPkgName, exp.kind.path as UsePath);
        if (ifaceIdx >= 0) {
          visit(ifaceIdx, true);
        }
      }
    } else if (item.tag == WorldItemTag.Use) {
      let u = item.use as Use;
      let ifaceIdx = resolveInterfaceNameAndIndex(ctx, itemPkgName, u.from);
      if (ifaceIdx >= 0) {
        visit(ifaceIdx, false);
      }
    }
    idx = idx + 1;
  }

  return imports;
};

let serializeWorld = (b: JsonBuilder, ctx: SerializeContext, world: WorldDef, index: i32): void => {
  let worldName = normalizeId(world.name.name);
  ctx.currentInterfaceName = null;
  ctx.currentWorldName = worldName;
  ctx.currentInterfacePackageIndex = -1;
  ctx.currentWorldPackageIndex = world.packageIndex;
  
  let expandedItems = expandWorldItems(ctx, world);
  
  b.beginObject();
  b.key("name").string(worldName);
  
  // Serialize imports
  b.key("imports").beginObject();
  
  // 1. Serialize any world TypeDefs (like resources/types defined on the world)
  let pkgName = ctx.packages[world.packageIndex].name;
  var idx = 0;
  while (idx < expandedItems.length) {
    let item = expandedItems[idx];
    let itemPkgName = if (item.packageIndex >= 0) ctx.packages[item.packageIndex].name else pkgName;
    if (item.tag == WorldItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      let tdName = normalizeId(td.name.name);
      b.key(tdName).beginObject();
      
      var typeIdx = -1;
      if (itemPkgName.length > 0) {
        let key = "world:" + itemPkgName + "/" + worldName + "/" + tdName;
        if (let (true, sIdx) = ctx.typeIndices.get(key)) {
          typeIdx = sIdx;
        }
      }
      if (typeIdx < 0) {
        let key = "world:" + worldName + "/" + tdName;
        if (let (true, sIdx) = ctx.typeIndices.get(key)) {
          typeIdx = sIdx;
        }
      }
      b.key("type").i32(typeIdx);
      b.endObject();
    } else if (item.tag == WorldItemTag.Use) {
      let u = item.use as Use;
      var j = 0;
      while (j < u.names.length) {
        let un = u.names[j];
        let name = normalizeId(if (un.asName != null) (un.asName as Id).name else un.name.name);
        b.key(name).beginObject();
        
        var typeIdx = -1;
        let key = "world:" + worldName + "/" + name;
        if (let (true, sIdx) = ctx.typeIndices.get(key)) {
          typeIdx = sIdx;
        }
        b.key("type").i32(typeIdx);
        b.endObject();
        j = j + 1;
      }
    }
    idx = idx + 1;
  }
  
  // 2. Serialize world resource functions as imports
  idx = 0;
  while (idx < expandedItems.length) {
    let item = expandedItems[idx];
    if (item.tag == WorldItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      if (td.tag == TypeDefTag.Resource && td.resourceFuncs != null) {
        let resourceName = normalizeId(td.name.name);
        let funcs = td.resourceFuncs as Array<ResourceFunc>;
        var fIdx = 0;
        while (fIdx < funcs.length) {
          let rf = funcs[fIdx];
          if (rf.tag == ResourceFuncTag.Method) {
            b.key("[method]" + resourceName + "." + normalizeId(rf.func.name.name)).beginObject();
            b.key("function");
            serializeResourceFunc(b, ctx, rf, resourceName, index);
            b.endObject();
          } else if (rf.tag == ResourceFuncTag.Static) {
            b.key("[static]" + resourceName + "." + normalizeId(rf.func.name.name)).beginObject();
            b.key("function");
            serializeResourceFunc(b, ctx, rf, resourceName, index);
            b.endObject();
          } else if (rf.tag == ResourceFuncTag.Constructor) {
            b.key("[constructor]" + resourceName).beginObject();
            b.key("function");
            serializeResourceFunc(b, ctx, rf, resourceName, index);
            b.endObject();
          }
          fIdx = fIdx + 1;
        }
      }
    }
    idx = idx + 1;
  }
  
  // 3. Serialize interface imports (both explicit inline, direct path, and transitives)
  let worldImports = collectWorldImports(ctx, world, expandedItems);
  let inlineImports = new HashMap<i32, String>();
  
  idx = 0;
  while (idx < expandedItems.length) {
    let item = expandedItems[idx];
    let itemPkgName = if (item.packageIndex >= 0) ctx.packages[item.packageIndex].name else pkgName;
    if (item.tag == WorldItemTag.Import) {
      let imp = item.importItem as Import;
      if (imp.kind.tag == ExternKindTag.Interface) {
        let name = normalizeId((imp.kind.name as Id).name);
        let inlineName = "[import]" + name;
        var ifaceIdx = -1;
        if (itemPkgName.length > 0) {
          let lookupKey = itemPkgName + "/inline/" + inlineName;
          if (let (true, sIdx) = ctx.interfaceIndices.get(lookupKey)) {
            ifaceIdx = sIdx;
          }
        }
        if (ifaceIdx < 0) {
          if (let (true, sIdx) = ctx.interfaceIndices.get(inlineName)) {
            ifaceIdx = sIdx;
          }
        }
        if (ifaceIdx >= 0) {
          inlineImports[ifaceIdx] = name;
        }
      }
    }
    idx = idx + 1;
  }
  
  worldImports.forEach((ifaceIdx: i32, val: boolean) => {
    if (let (true, inlineName) = inlineImports.get(ifaceIdx)) {
      b.key(inlineName).beginObject();
      b.key("interface").beginObject();
      b.key("id").i32(ifaceIdx);
      serializeStability(b, findWorldItemDocs(ctx, world, ifaceIdx, true, expandedItems));
      b.endObject();
      b.endObject();
    } else {
      b.key("interface-" + i32ToString(ifaceIdx)).beginObject();
      b.key("interface").beginObject();
      b.key("id").i32(ifaceIdx);
      serializeStability(b, findWorldItemDocs(ctx, world, ifaceIdx, true, expandedItems));
      b.endObject();
      b.endObject();
    }
  });
  
  // 4. Serialize regular freestanding function imports
  idx = 0;
  while (idx < expandedItems.length) {
    let item = expandedItems[idx];
    if (item.tag == WorldItemTag.Import) {
      let imp = item.importItem as Import;
      if (imp.kind.tag == ExternKindTag.Func) {
        let name = normalizeId((imp.kind.name as Id).name);
        b.key(name);
        serializeExternKind(b, ctx, imp.kind, imp.docs);
      }
    }
    idx = idx + 1;
  }
  b.endObject();
  
  // Serialize exports
  b.key("exports").beginObject();
  idx = 0;
  while (idx < expandedItems.length) {
    let item = expandedItems[idx];
    let itemPkgName = if (item.packageIndex >= 0) ctx.packages[item.packageIndex].name else pkgName;
    if (item.tag == WorldItemTag.Export) {
      let exp = item.exportItem as Export;
      if (exp.kind.tag == ExternKindTag.Interface) {
        let name = normalizeId((exp.kind.name as Id).name);
        let inlineName = "[export]" + name;
        b.key(name).beginObject();
        b.key("interface").beginObject();
        var inlineIdx = -1;
        if (itemPkgName.length > 0) {
          let lookupKey = itemPkgName + "/inline/" + inlineName;
          if (let (true, idxVal) = ctx.interfaceIndices.get(lookupKey)) {
            inlineIdx = idxVal;
          }
        }
        if (inlineIdx < 0) {
          if (let (true, idxVal) = ctx.interfaceIndices.get(inlineName)) {
            inlineIdx = idxVal;
          }
        }
        b.key("id").i32(inlineIdx);
        serializeStability(b, findWorldItemDocs(ctx, world, inlineIdx, false, expandedItems));
        b.endObject();
        b.endObject();
      } else if (exp.kind.tag == ExternKindTag.Path) {
        let path = exp.kind.path as UsePath;
        let pkgName = ctx.packages[world.packageIndex].name;
        let ifaceIdx = resolveInterfaceNameAndIndex(ctx, pkgName, path);
        if (ifaceIdx >= 0) {
          b.key("interface-" + i32ToString(ifaceIdx)).beginObject();
          b.key("interface").beginObject();
          b.key("id").i32(ifaceIdx);
          serializeStability(b, findWorldItemDocs(ctx, world, ifaceIdx, false, expandedItems));
          b.endObject();
          b.endObject();
        }
      } else if (exp.kind.tag == ExternKindTag.Func) {
        let name = normalizeId((exp.kind.name as Id).name);
        b.key(name);
        serializeExternKind(b, ctx, exp.kind, exp.docs);
      }
    }
    idx = idx + 1;
  }
  b.endObject();
  if (world.docs != null) {
    let d = world.docs as Docs;
    if (d.contents != null) {
      b.key("docs").beginObject();
      b.key("contents").string(d.contents as String);
      b.endObject();
    }
  }
  serializeStability(b, world.docs);
  b.key("package").i32(world.packageIndex);
  b.endObject();
};



let serializeInterface = (b: JsonBuilder, ctx: SerializeContext, iface: InterfaceDef, index: i32): void => {
  let ifaceName = normalizeId(iface.name.name);
  ctx.currentInterfaceName = ifaceName;
  ctx.currentWorldName = null;
  ctx.currentInterfacePackageIndex = iface.packageIndex;
  ctx.currentWorldPackageIndex = -1;
  
  b.beginObject();
  if (iface.isInline) {
    b.key("name").nullValue();
  } else {
    b.key("name").string(ifaceName);
  }
  
  b.key("types").beginObject();
  let pkgName = ctx.packages[iface.packageIndex].name;
  var idx = 0;
  while (idx < iface.items.length) {
    let item = iface.items[idx];
    if (item.tag == InterfaceItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      let name = normalizeId(td.name.name);
      
      var foundIdx = -1;
      if (pkgName.length > 0) {
        let key = "interface:" + pkgName + "/" + ifaceName + "/" + name;
        if (let (true, typeIdx) = ctx.typeIndices.get(key)) {
          foundIdx = typeIdx;
        }
      }
      if (foundIdx < 0) {
        let key = "interface:" + ifaceName + "/" + name;
        if (let (true, typeIdx) = ctx.typeIndices.get(key)) {
          foundIdx = typeIdx;
        }
      }
      if (foundIdx >= 0) {
        b.key(name).i32(foundIdx);
      }
    } else if (item.tag == InterfaceItemTag.Use) {
      let u = item.use as Use;
      var j = 0;
      while (j < u.names.length) {
        let un = u.names[j];
        let name = normalizeId(if (un.asName != null) (un.asName as Id).name else un.name.name);
        
        var foundIdx = -1;
        if (pkgName.length > 0) {
          let key = "interface:" + pkgName + "/" + ifaceName + "/" + name;
          if (let (true, typeIdx) = ctx.typeIndices.get(key)) {
            foundIdx = typeIdx;
          }
        }
        if (foundIdx < 0) {
          let key = "interface:" + ifaceName + "/" + name;
          if (let (true, typeIdx) = ctx.typeIndices.get(key)) {
            foundIdx = typeIdx;
          }
        }
        if (foundIdx >= 0) {
          b.key(name).i32(foundIdx);
        }
        j = j + 1;
      }
    }
    idx = idx + 1;
  }
  b.endObject();
  
  b.key("functions").beginObject();
  // First serialize resource methods (wasm-tools order: resource methods create types first)
  idx = 0;
  while (idx < iface.items.length) {
    let item = iface.items[idx];
    if (item.tag == InterfaceItemTag.TypeDef) {
      let td = item.typeDef as TypeDef;
      if (td.tag == TypeDefTag.Resource && td.resourceFuncs != null) {
        let resourceName = normalizeId(td.name.name);
        let funcs = td.resourceFuncs as Array<ResourceFunc>;
        var fIdx = 0;
        while (fIdx < funcs.length) {
          let rf = funcs[fIdx];
          if (rf.tag == ResourceFuncTag.Method) {
            b.key("[method]" + resourceName + "." + normalizeId(rf.func.name.name));
            serializeResourceFunc(b, ctx, rf, resourceName, index);
          } else if (rf.tag == ResourceFuncTag.Static) {
            b.key("[static]" + resourceName + "." + normalizeId(rf.func.name.name));
            serializeResourceFunc(b, ctx, rf, resourceName, index);
          } else if (rf.tag == ResourceFuncTag.Constructor) {
            b.key("[constructor]" + resourceName);
            serializeResourceFunc(b, ctx, rf, resourceName, index);
          }
          fIdx = fIdx + 1;
        }
      }
    }
    idx = idx + 1;
  }
  // Then serialize regular interface functions
  idx = 0;
  while (idx < iface.items.length) {
    let item = iface.items[idx];
    if (item.tag == InterfaceItemTag.Func) {
      let func = item.func as NamedFunc;
      b.key(normalizeId(func.name.name));
      serializeFunction(b, ctx, func);
    }
    idx = idx + 1;
  }
  b.endObject();
  
  if (iface.docs.contents != null) {
    b.key("docs").beginObject();
    b.key("contents").string(iface.docs.contents as String);
    b.endObject();
  }
  
  serializeStability(b, iface.docs);
  
  b.key("package").i32(iface.packageIndex);
  b.endObject();
};

let collectPackageDepFromUsePath = (aliases: HashMap<String, String>, pkgName: String, path: UsePath, deps: Array<String>): void => {
  if (path.tag == UsePathTag.Package) {
    let pkg = path.packageId as PackageName;
    deps.push(formatPackageName(pkg));
  } else {
    let key = pkgName + "/" + normalizeId((path.id as Id).name);
    var aliasTarget = (path.id as Id).name;
    if (let (true, resolved) = aliases.get(key)) {
      aliasTarget = resolved;
    }
    // Check if aliasTarget has a package prefix (contains a '/')
    var slashIdx = -1;
    var i = 0;
    while (i < aliasTarget.length) {
      if (aliasTarget.getByteAt(i) == 47) { // '/'
        slashIdx = i;
        break;
      }
      i = i + 1;
    }
    if (slashIdx >= 0) {
      deps.push(aliasTarget.sliceBytes(0, slashIdx));
    }
  }
};

let collectInterfaceDepsOnly = (aliases: HashMap<String, String>, pkgName: String, items: Array<InterfaceItem>, deps: Array<String>): void => {
  var j = 0;
  while (j < items.length) {
    let ifaceItem = items[j];
    if (ifaceItem.tag == InterfaceItemTag.Use) {
      let u = ifaceItem.use as Use;
      collectPackageDepFromUsePath(aliases, pkgName, u.from, deps);
    }
    j = j + 1;
  }
};

let collectPackageDeps = (aliases: HashMap<String, String>, pkgName: String, items: Array<AstItem>, deps: Array<String>): void => {
  var idx = 0;
  while (idx < items.length) {
    let item = items[idx];
    if (item.tag == AstItemTag.Interface) {
      let iface = item.interfaceDef as InterfaceDef;
      collectInterfaceDepsOnly(aliases, pkgName, iface.items, deps);
    } else if (item.tag == AstItemTag.World) {
      let world = item.worldDef as WorldDef;
      var j = 0;
      while (j < world.items.length) {
        let worldItem = world.items[j];
        if (worldItem.tag == WorldItemTag.Import) {
          let imp = worldItem.importItem as Import;
          if (imp.kind.tag == ExternKindTag.Path) {
            collectPackageDepFromUsePath(aliases, pkgName, imp.kind.path as UsePath, deps);
          } else if (imp.kind.tag == ExternKindTag.Interface) {
            let inlineItems = imp.kind.items as Array<InterfaceItem>;
            collectInterfaceDepsOnly(aliases, pkgName, inlineItems, deps);
          }
        } else if (worldItem.tag == WorldItemTag.Export) {
          let exp = worldItem.exportItem as Export;
          if (exp.kind.tag == ExternKindTag.Path) {
            collectPackageDepFromUsePath(aliases, pkgName, exp.kind.path as UsePath, deps);
          } else if (exp.kind.tag == ExternKindTag.Interface) {
            let inlineItems = exp.kind.items as Array<InterfaceItem>;
            collectInterfaceDepsOnly(aliases, pkgName, inlineItems, deps);
          }
        } else if (worldItem.tag == WorldItemTag.Use) {
          let u = worldItem.use as Use;
          collectPackageDepFromUsePath(aliases, pkgName, u.from, deps);
        } else if (worldItem.tag == WorldItemTag.Include) {
          let inc = worldItem.include as Include;
          collectPackageDepFromUsePath(aliases, pkgName, inc.from, deps);
        }
        j = j + 1;
      }
    }
    idx = idx + 1;
  }
};

let sortPackages = (pkgSources: Array<{name: PackageName | null, items: Array<AstItem>}>, pkgDeps: HashMap<String, Array<String>>, pkgOrder: Array<String>): Array<{name: PackageName | null, items: Array<AstItem>}> => {
  let sorted = new Array<{name: PackageName | null, items: Array<AstItem>}>();
  if (pkgSources.length == 0) {
    return sorted;
  }
  
  // First, map package names to their pkgSources elements
  let pkgMap = new HashMap<String, {name: PackageName | null, items: Array<AstItem>}>();
  let keys = new Array<String>();
  
  var idx = 0;
  while (idx < pkgSources.length) {
    let src = pkgSources[idx];
    let key = formatPackageName(src.name);
    pkgMap[key] = src;
    keys.push(key);
    idx = idx + 1;
  }
  
  // Sort the keys alphabetically/semver to ensure deterministic start order
  var i = 0;
  while (i < keys.length) {
    var j = i + 1;
    while (j < keys.length) {
      if (comparePackageNameStrings(pkgOrder, keys[i], keys[j]) > 0) {
        let temp = keys[i];
        keys[i] = keys[j];
        keys[j] = temp;
      }
      j = j + 1;
    }
    i = i + 1;
  }
  
  // Now do a topological sort using DFS.
  // visited maps key -> status (0 = unvisited, 1 = visiting, 2 = visited)
  let visited = new HashMap<String, i32>();
  
  let visit = (key: String): void => {
    if (let (true, status) = visited.get(key)) {
      if (status == 1 || status == 2) {
        return;
      }
    }
    
    visited[key] = 1;
    
    // Visit dependencies
    if (let (true, depsList) = pkgDeps.get(key)) {
      let deps = depsList as Array<String>;
      
      // Sort dependencies alphabetically/semver for deterministic visit order
      var dI = 0;
      while (dI < deps.length) {
        var dJ = dI + 1;
        while (dJ < deps.length) {
          if (comparePackageNameStrings(pkgOrder, deps[dI], deps[dJ]) > 0) {
            let temp = deps[dI];
            deps[dI] = deps[dJ];
            deps[dJ] = temp;
          }
          dJ = dJ + 1;
        }
        dI = dI + 1;
      }
      
      dI = 0;
      while (dI < deps.length) {
        let depKey = deps[dI];
        if (pkgMap.has(depKey)) {
          visit(depKey);
        }
        dI = dI + 1;
      }
    }
    
    visited[key] = 2;
    if (let (true, srcObj) = pkgMap.get(key)) {
      sorted.push(srcObj as {name: PackageName | null, items: Array<AstItem>});
    }
  };
  
  // Visit all keys in alphabetical order
  idx = 0;
  while (idx < keys.length) {
    visit(keys[idx]);
    idx = idx + 1;
  }
  
  return sorted;
};

let collectFromAst = (ctx: SerializeContext, ast: Ast, pkgDeps: HashMap<String, Array<String>>, pkgOrder: Array<String>): void => {
  let pkgSources = new Array<{name: PackageName | null, items: Array<AstItem>}>();
  pkgSources.push({name: ast.packageName, items: ast.items});
  
  var pIdx = 0;
  while (pIdx < ast.nestedPackages.length) {
    let np = ast.nestedPackages[pIdx];
    pkgSources.push({name: np.name, items: np.items});
    pIdx = pIdx + 1;
  }

  let finalPkgSources = sortPackages(pkgSources, pkgDeps, pkgOrder);
  
  let globalInterfaces = new Array<InterfaceDef>();
  let globalWorlds = new Array<WorldDef>();
  
  var pIdxVar = 0;
  while (pIdxVar < finalPkgSources.length) {
    let src = finalPkgSources[pIdxVar];
    let pkgName = formatPackageName(src.name);
    let pkg = new PackageEntry(pkgName);
    ctx.packages.push(pkg);
    
    let rawInterfaces = new Array<InterfaceDef>();
    let rawWorlds = new Array<WorldDef>();
    
    var idx = 0;
    while (idx < src.items.length) {
      let item = src.items[idx];
      if (item.tag == AstItemTag.Interface) {
        let iface = item.interfaceDef as InterfaceDef;
        iface.packageIndex = pIdxVar;
        rawInterfaces.push(iface);
      } else if (item.tag == AstItemTag.World) {
        let world = item.worldDef as WorldDef;
        world.packageIndex = pIdxVar;
        rawWorlds.push(world);
      }
      idx = idx + 1;
    }
    
    // Collect inline interfaces defined within the worlds of this package
    idx = 0;
    while (idx < rawWorlds.length) {
      let world = rawWorlds[idx];
      var j = 0;
      while (j < world.items.length) {
        let item = world.items[j];
        if (item.tag == WorldItemTag.Import) {
          let imp = item.importItem as Import;
          if (imp.kind.tag == ExternKindTag.Interface) {
            let kind = imp.kind;
            let name = kind.name as Id;
            let nameId = new Id("[import]" + name.name, name.span);
            let inlineIface = new InterfaceDef(imp.docs, nameId);
            inlineIface.items = kind.items as Array<InterfaceItem>;
            inlineIface.isInline = true;
            inlineIface.packageIndex = pIdxVar;
            rawInterfaces.push(inlineIface);
          }
        } else if (item.tag == WorldItemTag.Export) {
          let exp = item.exportItem as Export;
          if (exp.kind.tag == ExternKindTag.Interface) {
            let kind = exp.kind;
            let name = kind.name as Id;
            let nameId = new Id("[export]" + name.name, name.span);
            let inlineIface = new InterfaceDef(exp.docs, nameId);
            inlineIface.items = kind.items as Array<InterfaceItem>;
            inlineIface.isInline = true;
            inlineIface.packageIndex = pIdxVar;
            rawInterfaces.push(inlineIface);
          }
        }
        j = j + 1;
      }
      idx = idx + 1;
    }
    
    // Append package items to global list
    var rI = 0;
    while (rI < rawInterfaces.length) {
      globalInterfaces.push(rawInterfaces[rI]);
      rI = rI + 1;
    }
    
    var rW = 0;
    while (rW < rawWorlds.length) {
      globalWorlds.push(rawWorlds[rW]);
      rW = rW + 1;
    }
    
    pIdxVar = pIdxVar + 1;
  }
  
  let sortedInterfaces = sortInterfaces(ctx, globalInterfaces);
  let sortedWorlds = sortWorlds(globalWorlds);
  
  var i = 0;
  while (i < sortedInterfaces.length) {
    let iface = sortedInterfaces[i];
    let ifaceIdx = ctx.registerInterface(iface);
    let pkg = ctx.packages[iface.packageIndex];
    if (pkg.name.length > 0) {
      if (iface.isInline) {
        ctx.interfaceIndices[pkg.name + "/inline/" + normalizeId(iface.name.name)] = ifaceIdx;
      } else {
        ctx.interfaceIndices[pkg.name + "/" + normalizeId(iface.name.name)] = ifaceIdx;
      }
    }
    if (!iface.isInline) {
      pkg.interfaces[normalizeId(iface.name.name)] = ifaceIdx;
    }
    i = i + 1;
  }
  
  var w = 0;
  while (w < sortedWorlds.length) {
    let world = sortedWorlds[w];
    let worldIdx = ctx.registerWorld(world);
    let pkg = ctx.packages[world.packageIndex];
    pkg.worlds[normalizeId(world.name.name)] = worldIdx;
    w = w + 1;
  }
};

// ============================================================================
// Public API
// ============================================================================

/**
 * Serialize a parsed AST to JSON format matching wasm-tools output.
 */
export let serializeAstToJson = (ast: Ast, pkgOrderStr: String | null = null): String => {
  let aliases = new HashMap<String, String>();
  
  let pkgSources = new Array<{name: PackageName | null, items: Array<AstItem>}>();
  pkgSources.push({name: ast.packageName, items: ast.items});
  var pIdxVar = 0;
  while (pIdxVar < ast.nestedPackages.length) {
    let np = ast.nestedPackages[pIdxVar];
    pkgSources.push({name: np.name, items: np.items});
    pIdxVar = pIdxVar + 1;
  }
  
  var pI = 0;
  while (pI < pkgSources.length) {
    let src = pkgSources[pI];
    let pkgName = formatPackageName(src.name);
    var itemI = 0;
    while (itemI < src.items.length) {
      let item = src.items[itemI];
      if (item.tag == AstItemTag.Use) {
        let u = item.use as ToplevelUse;
        let alias = if (u.asName != null) (u.asName as Id).name else getUsePathInterfaceName(u.item);
        let target = getUsePathInterfaceName(u.item);
        
        let resolvedTarget = if (u.item.tag == UsePathTag.Id) {
          pkgName + "/" + target;
        } else {
          target;
        };
        
        aliases[pkgName + "/" + normalizeId(alias)] = resolvedTarget;
      }
      itemI = itemI + 1;
    }
    pI = pI + 1;
  }

  let pkgDeps = new HashMap<String, Array<String>>();
  
  let mainKey = formatPackageName(ast.packageName);
  let mainDeps = new Array<String>();
  collectPackageDeps(aliases, mainKey, ast.items, mainDeps);
  pkgDeps[mainKey] = mainDeps;
  
  var pkgDepIdx = 0;
  while (pkgDepIdx < ast.nestedPackages.length) {
    let np = ast.nestedPackages[pkgDepIdx];
    let key = formatPackageName(np.name);
    let deps = new Array<String>();
    collectPackageDeps(aliases, key, np.items, deps);
    pkgDeps[key] = deps;
    pkgDepIdx = pkgDepIdx + 1;
  }

  let pkgOrder = new Array<String>();
  if (pkgOrderStr != null) {
    let str = pkgOrderStr as String;
    var start = 0;
    var i = 0;
    while (i < str.length) {
      if (str.getByteAt(i) == 44) { // ','
        if (i > start) {
          pkgOrder.push(str.sliceBytes(start, i));
        }
        start = i + 1;
      }
      i = i + 1;
    }
    if (str.length > start) {
      pkgOrder.push(str.sliceBytes(start, str.length));
    }
  }

  filterGatedItems(ast);
  let ctx = new SerializeContext();
  ctx.useAliases = aliases;
  collectFromAst(ctx, ast, pkgDeps, pkgOrder);
  registerAllTypesAndScopeSignatures(ctx);
  
  let b = new JsonBuilder();
  b.beginObject();
  
  b.key("interfaces").beginArray();
  var iIdx = 0;
  while (iIdx < ctx.interfaces.length) {
    serializeInterface(b, ctx, ctx.interfaces[iIdx], iIdx);
    iIdx = iIdx + 1;
  }
  b.endArray();
  
  b.key("worlds").beginArray();
  var wIdx = 0;
  while (wIdx < ctx.worlds.length) {
    serializeWorld(b, ctx, ctx.worlds[wIdx], wIdx);
    wIdx = wIdx + 1;
  }
  b.endArray();
  
  b.key("types").beginArray();
  var tIdx = 0;
  while (tIdx < ctx.types.length) {
    ctx.types[tIdx].serialize(b);
    tIdx = tIdx + 1;
  }
  b.endArray();
  
  b.key("packages").beginArray();
  var pIdx = 0;
  while (pIdx < ctx.packages.length) {
    ctx.packages[pIdx].serialize(b);
    pIdx = pIdx + 1;
  }
  b.endArray();
  
  b.endObject();
  return b.toString();
};
