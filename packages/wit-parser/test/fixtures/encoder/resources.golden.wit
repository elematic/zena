package root:component;

world root {
  import test:store/kv@0.1.0;
}
package test:store@0.1.0 {
  interface kv {
    record entry {
      key: string,
      value: list<u8>,
    }

    resource bucket {
      constructor(name: string);
      get: func(key: string) -> option<entry>;
      put: func(e: entry) -> result<_, string>;
      size: static func() -> u64;
    }

    open: func(name: string) -> bucket;

    compare: func(a: borrow<bucket>, b: borrow<bucket>) -> s8;

    drain: func(b: bucket) -> list<entry>;
  }
}
