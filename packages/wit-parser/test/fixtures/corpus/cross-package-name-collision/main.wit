package test:sockets@1.0.0;

// Two packages each declare an `interface types`, and this one reaches into
// the other. Resolving `use test:clocks/monotonic-clock` recurses into that
// interface's own `use types.{duration}` — an unqualified name that must mean
// `test:clocks/types`, not the `types` being resolved here. Picking the
// nearest same-named interface on the scope stack instead makes the two look
// mutually dependent and reports a false cycle.
//
// This is the shape WASI p3 uses: `wasi:clocks` and `wasi:sockets` both
// declare `interface types`.

interface types {
  use test:clocks/monotonic-clock@1.0.0.{duration};

  wait: func(how-long: duration);
}
