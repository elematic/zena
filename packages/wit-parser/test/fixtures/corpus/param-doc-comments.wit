package test:param-doc-comments;

interface streams {
  /// Read bytes from a stream.
  read: func(
    /// The maximum number of bytes to read.
    len: u64,
    /// Whether to block.
    blocking: bool
  ) -> list<u8>;

  /// A doc comment on a single parameter.
  skip: func(
    /// How many bytes to skip.
    len: u64
  );
}
