package test:main;

/// Exercises a pre-release version inside a `use` path, and a versioned
/// interface path in world import/export position.
interface uses-versioned {
  use test:dep/types@1.0.0-rc.1.{duration};

  wait: func(how-long: duration);
}

world w {
  import test:dep/clock@1.0.0-rc.1;
  export uses-versioned;
}
