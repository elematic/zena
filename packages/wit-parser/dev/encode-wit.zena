/**
 * Encode a WIT world's imports as a types-only component.
 *
 * The test driver for the component encoder: `roundtrip-encoder.js`
 * runs this over each fixture and hands the bytes to
 * `wasm-tools component wit`, which prints the world back out — a
 * round-trip only correct type and import sections survive.
 *
 *     zena-cli run packages/wit-parser/dev/encode-wit.zena \
 *         <input.wit> <world> <out.wasm>
 */

import { getArguments, exit } from 'zena:cli';
import { readFile, writeFileBytes } from 'zena:fs';
import { parse } from 'zena-lang:wit-parser';
import { encodeTypesOnlyComponent } from 'zena-lang:wit-parser/component-encoder';

export async function main(): Future<i32> {
  let args = getArguments();
  if (args.length != 4) {
    console.error('Usage: encode-wit <input.wit> <world> <out.wasm>');
    exit(1);
  }
  try {
    let ast = parse(await readFile(args[1]));
    let result = encodeTypesOnlyComponent(ast, args[2]);
    await writeFileBytes(args[3], result.bytes.toByteArray() as FixedArray<u8>);
    for (let name in result.encoded.skippedExports) {
      // A types-only component has nothing to implement an export with;
      // the harness's goldens show the imports only.
      console.log('skipped export: ' + name);
    }
  } catch (e) {
    if (e is Error) {
      console.error('error: ' + e.message);
    }
    exit(1);
  }
  return 0;
}
