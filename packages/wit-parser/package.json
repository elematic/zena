{
  "name": "@zena-lang/wit-parser",
  "version": "0.0.1",
  "type": "module",
  "description": "WIT (WebAssembly Interface Types) parser for Zena",
  "private": true,
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "test:unit": "wireit",
    "test:interop": "wireit",
    "test:wit": "wireit",
    "test:real-wit": "wireit",
    "test:example": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc",
      "dependencies": [
        "../runtime:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "scripts/**",
        "test/**"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "dependencies": [
        "test:wit",
        "test:unit",
        "test:interop",
        "test:real-wit",
        "test:example"
      ]
    },
    "test:unit": {
      "command": "node --test --enable-source-maps test/lexer_test.js test/parser_test.js",
      "dependencies": [
        "build",
        "../zena-compiler:build:api",
        "../stdlib:build"
      ],
      "files": [
        "zena/**/*.zena"
      ],
      "output": []
    },
    "test:interop": {
      "command": "node --test --enable-source-maps test/echo_test.js",
      "dependencies": [
        "build",
        "../zena-compiler:build:api",
        "../stdlib:build"
      ],
      "files": [
        "zena/**/*.zena"
      ],
      "output": []
    },
    "test:wit": {
      "command": "node --enable-source-maps scripts/run-tests.js",
      "dependencies": [
        "build",
        "../zena-compiler:build:api",
        "../stdlib:build"
      ],
      "files": [
        "tests/**/*.wit",
        "tests/**/*.wit.json",
        "tests/**/*.wit.result",
        "tests/test-config.json",
        "zena/**/*.zena"
      ],
      "output": []
    },
    "test:real-wit": {
      "command": "node dev/parse-real-wit.js --check",
      "dependencies": [
        "build",
        "../zena-compiler:build:api",
        "../stdlib:build"
      ],
      "files": [
        "dev/parse-real-wit.js",
        "dev/wit-corpus.js",
        "wit-corpus.json",
        "zena/**/*.zena"
      ],
      "output": []
    },
    "test:example": {
      "command": "node ../cli/lib/cli.js check examples/parse-wit.zena",
      "dependencies": [
        "../compiler:build",
        "../stdlib:build"
      ],
      "files": [
        "examples/**/*.zena",
        "zena/**/*.zena",
        "../../zena-packages.json"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@zena-lang/runtime": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3"
  }
}
