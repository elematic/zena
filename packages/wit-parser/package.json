{
  "name": "@zena-lang/wit-parser",
  "version": "0.0.1",
  "type": "module",
  "description": "WIT (WebAssembly Interface Types) parser for Zena",
  "private": true,
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "test:unit": "wireit",
    "test:wit": "wireit",
    "test:real-wit": "wireit",
    "test:example": "wireit",
    "test:encoder": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc",
      "dependencies": [
        "../runtime:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "scripts/**",
        "test/**"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "dependencies": [
        "test:wit",
        "test:unit",
        "test:real-wit",
        "test:example",
        "test:encoder"
      ]
    },
    "test:encoder": {
      "#command": "Runs from the repo root for the same reason test:example does. Needs wasm-tools on PATH (the dev shell has it): the encoder's output is verified by validating it and round-tripping it back to WIT text against the goldens. Regenerate goldens with UPDATE_WIT_GOLDENS=1.",
      "command": "node dev/roundtrip-encoder.js",
      "dependencies": [
        "../zena-compiler:precompile:cli",
        "../zena-cli:build",
        "../stdlib:build"
      ],
      "files": [
        "dev/roundtrip-encoder.js",
        "dev/encode-wit.zena",
        "test-files/encoder/**",
        "zena/**/*.zena"
      ],
      "output": []
    },
    "test:unit": {
      "command": "node --test --enable-source-maps test/lexer_test.js test/parser_test.js",
      "dependencies": [
        "build",
        "../zena-compiler:build:api",
        "../stdlib:build"
      ],
      "files": [
        "zena/**/*.zena"
      ],
      "output": []
    },
    "test:wit": {
      "command": "node --enable-source-maps scripts/run-tests.js",
      "dependencies": [
        "build",
        "../zena-compiler:build:api",
        "../stdlib:build"
      ],
      "files": [
        "tests/**/*.wit",
        "tests/**/*.wit.json",
        "tests/**/*.wit.result",
        "tests/test-config.json",
        "zena/**/*.zena"
      ],
      "output": []
    },
    "test:real-wit": {
      "command": "node dev/parse-real-wit.js --check",
      "dependencies": [
        "build",
        "../zena-compiler:build:api",
        "../stdlib:build"
      ],
      "files": [
        "dev/parse-real-wit.js",
        "dev/wit-corpus.js",
        "wit-corpus.json",
        "zena/**/*.zena"
      ],
      "output": []
    },
    "test:example": {
      "#command": "Runs from the repo root because the compiler loads the package map from the working directory, and reaching the parser through that map is what this example exists to prove. Running it rather than only compiling it also exercises the parser end to end: it throws on a parse or resolve failure.",
      "command": "cd ../.. && ./target/release/zena-cli run packages/wit-parser/examples/parse-wit.zena",
      "dependencies": [
        "../zena-compiler:precompile:cli",
        "../zena-cli:build",
        "../stdlib:build"
      ],
      "files": [
        "examples/**/*.zena",
        "zena/**/*.zena",
        "../../zena-packages.json"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@zena-lang/runtime": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3"
  }
}
