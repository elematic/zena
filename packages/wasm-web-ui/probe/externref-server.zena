// Probe: does the zena-cli target accept externref-typed fields and an
// extension class over externref, as long as nothing imports or exports
// one? The server-side html library keeps HostValue and Event as they are.
export final class HostValue {
  handle: externref;
  new(this.handle);
}
export extension class Event on externref {
  key(): String {
    throw new Error('no events on a server');
  }
}
export type Listener = (event: Event) => void;
let listeners = new GrowableArray<Listener>();
export let main = (): i32 => {
  listeners.push((e) => {});
  let h: HostValue | null = null;
  return listeners.length + (if (h == null) 41 else 0);
};
