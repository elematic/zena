/**
 * Renders the demo's elements on the server target, the way the demo
 * server does, and prints the markup: the same `elements.zena` the
 * browser module is built from, compiled for `zena-cli`.
 *
 *     ./target/release/zena-cli run packages/wasm-web-ui/probe/ssr-harness.zena --invoke main
 */
import { renderElement } from 'zena:web-elements';
import { counterElement, todoElement, badgeElement } from '../demo/elements.zena';

export let main = (): i32 => {
  let counter = new Map<String, String>();
  counter['count'] = '10';
  counter['step'] = '5';
  console.log(renderElement(counterElement, counter));
  let todo = new Map<String, String>();
  todo['title'] = 'Things to do';
  console.log(renderElement(todoElement, todo));
  // Declared without a tag: the page names it, so the server does too.
  console.log(renderElement(badgeElement, new Map<String, String>(), 'page-badge'));
  return 0;
};
