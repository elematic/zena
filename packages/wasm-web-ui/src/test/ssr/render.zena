/**
 * The server side of `ssr_test.ts` and `hydrate_test.ts`: renders each
 * case of `elements.zena` with the elements library's renderer and
 * prints them, separated by a line of three dashes; the last section is
 * the counter element itself, as a server would write it into a page.
 * Run by the tests through `zena-cli run`.
 */
import { renderResult, renderElement } from 'zena:web-elements';
import { counterElement, attributes, list, nested, counterView } from './elements.zena';

export let main = (): i32 => {
  console.log(renderResult(attributes()));
  console.log('---');
  console.log(renderResult(list()));
  console.log('---');
  console.log(renderResult(nested()));
  console.log('---');
  console.log(renderResult(counterView(7)));
  console.log('---');
  let attrs = new Map<String, String>();
  attrs['count'] = '7';
  console.log(renderElement(counterElement, attrs));
  return 0;
};
