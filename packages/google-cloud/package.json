{
  "name": "@zena-lang/google-cloud",
  "version": "0.0.1",
  "type": "module",
  "description": "Google Cloud clients for Zena: credentials and Firestore",
  "private": true,
  "scripts": {
    "test": "wireit",
    "test:emulator": "wireit",
    "generate": "wireit"
  },
  "wireit": {
    "test": {
      "#command": "Runs from the repository root, which is what the paths inside the tests are relative to and where the compiler finds the package map.",
      "command": "cd ../.. && ./target/release/zena-cli test \"packages/google-cloud/zena/test/*_test.zena\"",
      "dependencies": [
        "../zena-compiler:precompile:cli",
        "../zena-cli:build",
        "../stdlib:lib"
      ],
      "files": [
        "zena/**/*.zena",
        "../protobuf/zena/**/*.zena",
        "../protobuf/protos/**/*.proto",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../zena-compiler/zena/**/*.zena",
        "../../zena-packages.json"
      ],
      "output": []
    },
    "test:emulator": {
      "#command": "The client against the Firestore emulator over gRPC. Not part of `test`: it needs Java and the emulator, which the script fetches through nix and firebase-tools when they are missing.",
      "command": "cd ../.. && packages/google-cloud/scripts/with-firestore-emulator.sh ./target/release/zena-cli test \"packages/google-cloud/zena/emulator/*_test.zena\"",
      "dependencies": [
        "../zena-compiler:precompile:cli",
        "../zena-cli:build",
        "../stdlib:lib"
      ],
      "files": [
        "zena/**/*.zena",
        "scripts/with-firestore-emulator.sh",
        "../protobuf/zena/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../zena-compiler/zena/**/*.zena",
        "../../zena-packages.json"
      ],
      "output": []
    },
    "generate": {
      "#command": "Regenerates the Firestore API module from the vendored protos. The test fails when it is out of date.",
      "command": "cd ../.. && ./target/release/zena-cli run --dir . packages/protobuf/bin/generate.zena -- -I packages/protobuf/protos -o packages/google-cloud/zena/firestore-v1.zena google/firestore/v1/firestore.proto",
      "dependencies": [
        "../zena-compiler:precompile:cli",
        "../zena-cli:build",
        "../stdlib:lib"
      ],
      "files": [
        "../protobuf/zena/**/*.zena",
        "../protobuf/bin/**/*.zena",
        "../protobuf/protos/**/*.proto"
      ],
      "output": [
        "zena/firestore-v1.zena"
      ]
    }
  }
}
