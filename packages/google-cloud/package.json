{
  "name": "@zena-lang/google-cloud",
  "version": "0.0.1",
  "type": "module",
  "description": "Google Cloud clients for Zena: credentials and Firestore",
  "private": true,
  "scripts": {
    "test": "wireit",
    "test:emulator": "wireit",
    "generate": "wireit"
  },
  "wireit": {
    "test": {
      "#command": "Runs from the repository root, which is what the paths inside the tests are relative to and where the compiler finds the package map.",
      "command": "cd ../.. && ./target/release/zena-cli test \"packages/google-cloud/zena/test/*_test.zena\"",
      "dependencies": [
        "../zena-compiler:precompile:cli",
        "../zena-cli:build",
        "../stdlib:lib"
      ],
      "files": [
        "zena/**/*.zena",
        "../protobuf/zena/**/*.zena",
        "../protobuf/protos/**/*.proto",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../zena-compiler/zena/**/*.zena",
        "../../zena-package.json",
        "../*/zena/**/zena-package.json"
      ],
      "output": []
    },
    "test:emulator": {
      "#command": "The client against the Firestore emulator over gRPC. Not part of `test`: the emulator needs the flake's `emulators` shell (firebase-tools and Java, about 2 GB), which the root `emulators:start` service enters itself.",
      "command": "cd ../.. && ./target/release/zena-cli test \"packages/google-cloud/zena/emulator/*_test.zena\"",
      "dependencies": [
        "../..:emulators:start",
        "../zena-compiler:precompile:cli",
        "../zena-cli:build",
        "../stdlib:lib"
      ],
      "files": [
        "zena/**/*.zena",
        "../protobuf/zena/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../zena-compiler/zena/**/*.zena",
        "../../zena-package.json",
        "../*/zena/**/zena-package.json"
      ],
      "output": [],
      "env": {
        "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8180"
      }
    },
    "generate": {
      "#command": "Regenerates the Firestore API module from the vendored protos. The test fails when it is out of date.",
      "command": "cd ../.. && ./target/release/zena-cli run --dir . packages/protobuf/bin/generate.zena -- -I packages/protobuf/protos -o packages/google-cloud/zena/firestore-v1.zena google/firestore/v1/firestore.proto",
      "dependencies": [
        "../zena-compiler:precompile:cli",
        "../zena-cli:build",
        "../stdlib:lib"
      ],
      "files": [
        "../protobuf/zena/**/*.zena",
        "../protobuf/bin/**/*.zena",
        "../protobuf/protos/**/*.proto"
      ],
      "output": [
        "zena/firestore-v1.zena"
      ]
    }
  }
}
