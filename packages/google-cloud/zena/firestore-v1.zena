  case ValueBooleanValue(value: boolean)
  case ValueIntegerValue(value: i64)
  case ValueDoubleValue(value: f64)
  case ValueTimestampValue(value: Timestamp)
  case ValueStringValue(value: String)
  case ValueBytesValue(value: ProtoBytes)
  case ValueReferenceValue(value: String)
  case ValueGeoPointValue(value: LatLng)
  case ValueArrayValue(value: ArrayValue)
  case ValueMapValue(value: MapValue)
  case ValueFieldReferenceValue(value: String)
  case ValueVariableReferenceValue(value: String)
  case ValueFunctionValue(value: Function)
  case ValuePipelineValue(value: Pipeline)
  case ValueValueTypeNotSet
