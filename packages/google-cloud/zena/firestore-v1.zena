  referenceValue?: String,
  geoPointValue?: LatLng,
  arrayValue?: ArrayValue,
  mapValue?: MapValue,
  fieldReferenceValue?: String,
  variableReferenceValue?: String,
  functionValue?: Function,
  pipelineValue?: Pipeline,
