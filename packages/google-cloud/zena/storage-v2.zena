    let r0 = request.parent;
    routing.match('bucket', '{bucket=**}', r0);
    routing.addTo(metadata);
    let response = await this.#transport.unary(new RpcMethod('google.storage.v2.Storage', 'ListObjects'), ListObjectsRequest.of(request).protoView, metadata);
    return new ListObjectsResponse(response);
