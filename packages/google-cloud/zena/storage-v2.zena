   */
  async writeObject(requests: Array<WriteObjectRequestInit>, metadata: RpcMetadata = new RpcMetadata()): Future<WriteObjectResponse> {
    let views = new GrowableArray<ProtoView>();
    for (let request in requests) {
      views.push(WriteObjectRequest.of(request).protoView);
