    let r1 = r0.bucket;
    routing.match('bucket', '{bucket=**}', r1);
    routing.addTo(metadata);
    let response = await this.#transport.unary(new RpcMethod('google.storage.v2.Storage', 'UpdateObject'), UpdateObjectRequest.of(request).protoView, metadata);
