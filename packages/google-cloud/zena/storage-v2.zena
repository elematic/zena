  /**
   * Rewrites a source object to a destination object. Optionally overrides
   * metadata.
   */
  async rewriteObject(request: RewriteObjectRequestInit): Future<RewriteResponse> {
    let metadata = new RpcMetadata();
    let routing = new RoutingHeader();
    let r0 = request.sourceBucket;
    routing.add('source_bucket', r0);
    let r1 = request.destinationBucket;
    routing.match('bucket', '{bucket=**}', r1);
    routing.addTo(metadata);
    let response = await this.#transport.unary(new RpcMethod('google.storage.v2.Storage', 'RewriteObject'), RewriteObjectRequest.of(request).protoView, metadata);
    return new RewriteResponse(response);
  }

  /**
   * Starts a resumable write operation. This
   * method is part of the Resumable
   * upload feature.
   * This allows you to upload large objects in multiple chunks, which is more
   * resilient to network interruptions than a single upload. The validity
   * duration of the write operation, and the consequences of it becoming
   * invalid, are service-dependent.
   *
