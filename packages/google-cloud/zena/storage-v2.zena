    let routing = new RoutingHeader();
    let r0 = request.uploadId;
    routing.match('bucket', '{bucket=projects/*/buckets/*}/**', r0);
    routing.addTo(metadata);
    let response = await this.#transport.unary(new RpcMethod('google.storage.v2.Storage', 'QueryWriteStatus'), QueryWriteStatusRequest.of(request).protoView, metadata);
    return new QueryWriteStatusResponse(response);
