    let routing = new RoutingHeader();
    let r0 = request.writeObjectSpec;
    let r1 = r0.resource;
    if (r1 != null) {
      let r2 = (r1 as Object).bucket;
      routing.match('bucket', '{bucket=**}', r2);
    }
    routing.addTo(metadata);
    let response = await this.#transport.unary(new RpcMethod('google.storage.v2.Storage', 'StartResumableWrite'), StartResumableWriteRequest.of(request).protoView, metadata);
    return new StartResumableWriteResponse(response);
  }

  /**
   * Determines the `persisted_size` of an object that is being written. This
   * method is part of the resumable
   * upload feature.
