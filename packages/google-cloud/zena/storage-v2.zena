    let metadata = new RpcMetadata();
    let routing = new RoutingHeader();
    let r0 = request.bucket;
    routing.match('bucket', '{bucket=**}', r0);
    routing.addTo(metadata);
    let response = await this.#transport.unary(new RpcMethod('google.storage.v2.Storage', 'MoveObject'), MoveObjectRequest.of(request).protoView, metadata);
    return new Object(response);
  }
}
