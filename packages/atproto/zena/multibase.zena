/**
 * The base encodings atproto uses, and multibase strings: an encoding
 * named by a one-character prefix (https://github.com/multiformats/multibase).
 *
 * - base32, lowercase RFC 4648 alphabet, no padding (prefix `b`): CIDs.
 * - base58btc, the Bitcoin alphabet (prefix `z`): `did:key` and multikey.
 * - base64, standard alphabet (prefix `m` unpadded): `$bytes` in atproto JSON.
 * - base64url (prefix `u` unpadded): JWTs.
 * - base16, lowercase (prefix `f`).
 *
 * Decoders reject characters outside the alphabet, and for base32 and
 * base64 a final character with bits set below the last whole byte, so that
 * each byte string has one encoding.
 */

import {ByteBuffer, StringBuilder, newByteArray} from 'zena:core';
import {div} from 'zena:math';
import {fromHex, toHex} from './bytes.zena';

/** Text that is not valid in the encoding it claims. */
export class MultibaseError extends Error {
  new(message: String) : super(message);
}

let BASE32_ALPHABET = 'abcdefghijklmnopqrstuvwxyz234567';
let BASE58_ALPHABET = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
let BASE64_ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
let BASE64URL_ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';

/** The multibase encodings this module reads and writes. */
export enum Base {
  Base16,
  Base32,
  Base58btc,
  Base64,
  Base64url
}

/**
 * The value of each byte in `alphabet`, or -1 for a byte that is not in it.
 */
function decodeTable(alphabet: String) {
  let table = new FixedArray<i32>(256, -1);
  for (var i = 0; i < alphabet.length; i += 1) {
    table[alphabet.getByteAt(i)] = i;
  }
  return table;
}

let base32Table = decodeTable(BASE32_ALPHABET);
let base58Table = decodeTable(BASE58_ALPHABET);
let base64Table = decodeTable(BASE64_ALPHABET);
let base64urlTable = decodeTable(BASE64URL_ALPHABET);

/**
 * Encodes `bytes` with an RFC 4648 alphabet of 2^bits characters, without
 * padding.
 */
function encodeRfc4648(bytes: ByteArray, alphabet: String, bits: i32) {
  let sb = new StringBuilder(div(bytes.length * 8 + bits - 1, bits) + 1);
  let mask = (1 << bits) - 1;
  var buffer = 0;
  var buffered = 0;
  for (var i = 0; i < bytes.length; i += 1) {
    buffer = ((buffer << 8) | (bytes[i] as i32)) & 0xffff;
    buffered += 8;
    while (buffered >= bits) {
      buffered -= bits;
      sb.appendByte(alphabet.getByteAt((buffer >> buffered) & mask));
    }
  }
  if (buffered > 0) {
    sb.appendByte(alphabet.getByteAt((buffer << (bits - buffered)) & mask));
  }
  return sb.toString();
}

/**
 * Decodes `text[start..end]`, unpadded, with an RFC 4648 alphabet of
 * 2^bits characters.
 */
function decodeRfc4648(
  text: String,
  start: i32,
  end: i32,
  table: FixedArray<i32>,
  bits: i32,
  name: String
) {
  let out = new ByteBuffer(((end - start) * bits) >> 3);
  var buffer = 0;
  var buffered = 0;
  for (var i = start; i < end; i += 1) {
    let value = table[text.getByteAt(i)];
    if (value < 0) {
      throw new MultibaseError(`invalid ${name} character at offset ${i}`);
    }
    buffer = ((buffer << bits) | value) & 0xffff;
    buffered += bits;
    if (buffered >= 8) {
      buffered -= 8;
      out.writeByte((buffer >> buffered) & 0xff);
    }
  }
  if (buffered >= bits || (buffer & ((1 << buffered) - 1)) != 0) {
    throw new MultibaseError(`${name} text ends in the middle of a byte`);
  }
  return out.toByteArray();
}

/** `bytes` in lowercase base32, without padding. */
export function encodeBase32(bytes: ByteArray): String {
  return encodeRfc4648(bytes, BASE32_ALPHABET, 5);
}

/** The bytes of unpadded lowercase base32 text. */
export function decodeBase32(text: String): ByteArray {
  return decodeRfc4648(text, 0, text.length, base32Table, 5, 'base32');
}

/** `bytes` in base64, with `=` padding when `pad` is set. */
export function encodeBase64(bytes: ByteArray, pad: boolean = false): String {
  let text = encodeRfc4648(bytes, BASE64_ALPHABET, 6);
  if (!pad) {
    return text;
  }
  return padBase64(text);
}

/** `bytes` in base64url, without padding. */
export function encodeBase64url(bytes: ByteArray): String {
  return encodeRfc4648(bytes, BASE64URL_ALPHABET, 6);
}

function padBase64(text: String): String {
  let rem = text.length % 4;
  if (rem == 0) {
    return text;
  }
  let sb = new StringBuilder(text.length + 4 - rem);
  sb.append(text);
  for (var i = rem; i < 4; i += 1) {
    sb.appendByte(61);
  }
  return sb.toString();
}

/** The length of `text` without trailing `=` padding. */
function unpaddedEnd(text: String, name: String) {
  var end = text.length;
  while (end > 0 && text.getByteAt(end - 1) == 61) {
    end -= 1;
  }
  if (end < text.length && text.length % 4 != 0) {
    throw new MultibaseError(`padded ${name} text is not a multiple of four characters`);
  }
  if (text.length - end > 2) {
    throw new MultibaseError(`too much padding in ${name} text`);
  }
  return end;
}

/** The bytes of base64 text, padded or not. */
export function decodeBase64(text: String): ByteArray {
  return decodeRfc4648(text, 0, unpaddedEnd(text, 'base64'), base64Table, 6, 'base64');
}

/** The bytes of base64url text, padded or not. */
export function decodeBase64url(text: String): ByteArray {
  return decodeRfc4648(text, 0, unpaddedEnd(text, 'base64url'), base64urlTable, 6, 'base64url');
}

/**
 * `bytes` in base58btc. Each leading zero byte becomes a leading `1`, and
 * the rest is the bytes read as one big-endian number, in base 58.
 */
export function encodeBase58btc(bytes: ByteArray): String {
  var zeros = 0;
  while (zeros < bytes.length && bytes[zeros] == 0) {
    zeros += 1;
  }
  // log(256) / log(58) is under 1.37, so 138 digits per 100 bytes suffice.
  let size = div((bytes.length - zeros) * 138, 100) + 1;
  let digits = new FixedArray<i32>(size, 0);
  var length = 0;
  for (var i = zeros; i < bytes.length; i += 1) {
    var carry = bytes[i] as i32;
    var j = 0;
    while (j < length || carry != 0) {
      if (j < length) {
        carry += digits[j] * 256;
      }
      digits[j] = carry % 58;
      carry = div(carry, 58);
      j += 1;
    }
    length = j;
  }
  let sb = new StringBuilder(zeros + length);
  for (var i = 0; i < zeros; i += 1) {
    sb.appendByte(49);
  }
  for (var i = length - 1; i >= 0; i -= 1) {
    sb.appendByte(BASE58_ALPHABET.getByteAt(digits[i]));
  }
  return sb.toString();
}

/** The bytes of base58btc text. */
export function decodeBase58btc(text: String): ByteArray {
  return decodeBase58Range(text, 0, text.length);
}

function decodeBase58Range(text: String, start: i32, end: i32): ByteArray {
  var zeros = 0;
  while (start + zeros < end && text.getByteAt(start + zeros) == 49) {
    zeros += 1;
  }
  // log(58) / log(256) is under 0.733, so 733 bytes per 1000 digits suffice.
  let size = div((end - start - zeros) * 733, 1000) + 1;
  let bytes = new FixedArray<i32>(size, 0);
  var length = 0;
  for (var i = start + zeros; i < end; i += 1) {
    var carry = base58Table[text.getByteAt(i)];
    if (carry < 0) {
      throw new MultibaseError(`invalid base58btc character at offset ${i}`);
    }
    var j = 0;
    while (j < length || carry != 0) {
      if (j < length) {
        carry += bytes[j] * 58;
      }
      bytes[j] = carry & 0xff;
      carry = carry >> 8;
      j += 1;
    }
    length = j;
  }
  let out = newByteArray(zeros + length);
  for (var i = 0; i < length; i += 1) {
    out[zeros + i] = bytes[length - 1 - i] as u8;
  }
  return out;
}

/** The prefix character of a multibase encoding. */
function prefixOf(base: Base): i32 {
  return match (base) {
    case Base.Base16: 102
    case Base.Base32: 98
    case Base.Base58btc: 122
    case Base.Base64: 109
    case Base.Base64url: 117
  };
}

/** `bytes` as a multibase string in `base`. */
export function encodeMultibase(base: Base, bytes: ByteArray): String {
  let body = match (base) {
    case Base.Base16: toHex(bytes)
    case Base.Base32: encodeBase32(bytes)
    case Base.Base58btc: encodeBase58btc(bytes)
    case Base.Base64: encodeBase64(bytes)
    case Base.Base64url: encodeBase64url(bytes)
  };
  let sb = new StringBuilder(body.length + 1);
  sb.appendByte(prefixOf(base));
  sb.append(body);
  return sb.toString();
}

/** The bytes of a multibase string in one of the encodings above. */
export function decodeMultibase(text: String): ByteArray {
  if (text.length == 0) {
    throw new MultibaseError('empty multibase string');
  }
  let body = text.sliceBytes(1, text.length);
  return match (text.getByteAt(0)) {
    case 102: decodeLowerHex(body)
    case 98: decodeBase32(body)
    case 122: decodeBase58btc(body)
    case 109: decodeBase64(body)
    case 117: decodeBase64url(body)
    case _: throw new MultibaseError(`unsupported multibase prefix '${text.sliceBytes(0, 1)}'`)
  };
}

function decodeLowerHex(text: String): ByteArray {
  for (var i = 0; i < text.length; i += 1) {
    let b = text.getByteAt(i);
    if (b >= 65 && b <= 70) {
      throw new MultibaseError(`uppercase base16 character at offset ${i}`);
    }
  }
  return fromHex(text);
}
