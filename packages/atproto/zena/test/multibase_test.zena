import {suite, test} from 'zena:test';
import {equal, isTrue, throws} from 'zena:assert';
import {hex} from 'zena:encoding';
import {Base, decodeBase58btc, decodeMultibase, encodeBase58btc, encodeMultibase} from 'atproto:multibase';

// draft-msporny-base58-03, section 5.
let base58: Array<(String, String)> = [
  ('48656c6c6f20576f726c6421', '2NEpo7TZRRrLZSi2U'),
  (
    '54686520717569636b2062726f776e20666f78206a756d7073206f76657220746865206c617a7920646f672e',
    'USm3fpXnKG5EUBx2ndxBDMPVciP5hGey2Jh4NDv6gmeo1LkMeiKrLJUUBk6Z'
  ),
  ('0000287fb4cd', '11233QC4'),
];

export let tests = suite('atproto:multibase', () => {
  test('base58btc matches the base58 draft', (ctx) => {
    for (let (bytes, encoded) in base58) {
      equal(encodeBase58btc(hex.decode(bytes)), encoded);
      equal(hex.encode(decodeBase58btc(encoded)), bytes);
    }
  });

  test('base58btc keeps leading zero bytes', (ctx) => {
    equal(encodeBase58btc(hex.decode('00')), '1');
    equal(encodeBase58btc(hex.decode('000000')), '111');
    equal(hex.encode(decodeBase58btc('111')), '000000');
    equal(encodeBase58btc(hex.decode('')), '');
  });

  test('multibase strings carry their prefix', (ctx) => {
    // From the multibase specification's test vectors.
    let bytes = 'yes mani !'.toBytes();
    equal(encodeMultibase(Base.Base16, bytes), 'f796573206d616e692021');
    equal(encodeMultibase(Base.Base32, bytes), 'bpfsxgidnmfxgsibb');
    equal(encodeMultibase(Base.Base58btc, bytes), 'z7paNL19xttacUY');
    equal(encodeMultibase(Base.Base64, bytes), 'meWVzIG1hbmkgIQ');
    equal(encodeMultibase(Base.Base64url, bytes), 'ueWVzIG1hbmkgIQ');
    for (let text in [
      'f796573206d616e692021',
      'bpfsxgidnmfxgsibb',
      'z7paNL19xttacUY',
      'meWVzIG1hbmkgIQ',
      'ueWVzIG1hbmkgIQ',
    ]) {
      isTrue(decodeMultibase(text).contentEquals(bytes));
    }
  });

  test('rejects text outside the encoding it names', (ctx) => {
    for (let text in [
      'z0OIl',
      'bMZXW6',
      'mZm9v-_',
      'uZm9v+/',
      'f0A',
      // Multibase text is unpadded.
      'mZg==',
      // A last character with bits set beyond the last byte.
      'bmz',
    ]) {
      throws(() => {
        decodeMultibase(text);
      });
    }
  });

  test('rejects an unknown multibase prefix', (ctx) => {
    throws(() => {
      decodeMultibase('Qmfoo');
    });
    throws(() => {
      decodeMultibase('');
    });
  });
});
