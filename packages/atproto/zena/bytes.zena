/**
 * Byte-array helpers the other modules and their tests share.
 */

import {StringBuilder, copyBytes, newByteArray} from 'zena:core';

/** Malformed text where bytes were expected. */
export class BytesError extends Error {
  new(message: String) : super(message);
}

let hexDigits = '0123456789abcdef';

function hexValue(b: i32): i32 {
  if (b >= 48 && b <= 57) {
    return b - 48;
  }
  if (b >= 97 && b <= 102) {
    return b - 87;
  }
  if (b >= 65 && b <= 70) {
    return b - 55;
  }
  return -1;
}

/** `bytes` as lowercase hexadecimal. */
export function toHex(bytes: ByteArray): String {
  let sb = new StringBuilder(bytes.length * 2);
  for (var i = 0; i < bytes.length; i += 1) {
    let b = bytes[i] as i32;
    sb.appendByte(hexDigits.getByteAt((b >> 4) & 0xf));
    sb.appendByte(hexDigits.getByteAt(b & 0xf));
  }
  return sb.toString();
}

/** The bytes a hexadecimal string spells, in either case. */
export function fromHex(hex: String): ByteArray {
  if (hex.length % 2 != 0) {
    throw new BytesError(`hex string of odd length ${hex.length}`);
  }
  let out = newByteArray(hex.length >> 1);
  for (var i = 0; i < out.length; i += 1) {
    let high = hexValue(hex.getByteAt(2 * i));
    let low = hexValue(hex.getByteAt(2 * i + 1));
    if (high < 0 || low < 0) {
      throw new BytesError(`not a hex digit at offset ${2 * i}`);
    }
    out[i] = ((high << 4) | low) as u8;
  }
  return out;
}

/** Whether `a` and `b` hold the same bytes. */
export function equalBytes(a: ByteArray, b: ByteArray): boolean {
  if (a.length != b.length) {
    return false;
  }
  for (var i = 0; i < a.length; i += 1) {
    if (a[i] != b[i]) {
      return false;
    }
  }
  return true;
}

/** `bytes[start..end]` as a new array. */
export function sliceBytes(bytes: ByteArray, start: i32, end: i32): ByteArray {
  let out = newByteArray(end - start);
  copyBytes(out, 0, bytes, start, end - start);
  return out;
}

/** `a` followed by `b`, as a new array. */
export function concatBytes(a: ByteArray, b: ByteArray): ByteArray {
  let out = newByteArray(a.length + b.length);
  copyBytes(out, 0, a, 0, a.length);
  copyBytes(out, a.length, b, 0, b.length);
  return out;
}
