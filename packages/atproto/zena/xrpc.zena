/**
 * A client for XRPC, atproto's HTTP API convention
 * (https://atproto.com/specs/xrpc).
 *
 * An XRPC method is named by an NSID and served at `/xrpc/<nsid>`. A query
 * is a GET with its parameters in the query string; a procedure is a POST
 * with a body. An error answer is JSON, `{"error": "<Name>", "message":
 * "..."}`, with a 4xx or 5xx status.
 */

import {StringBuilder} from 'zena:core';
import {Response, fetch} from 'zena:fetch';
import {JsonObject, JsonValue, parseJson, stringify} from 'zena:json';
import {EncodeSet, percentEncode} from 'zena:url';

/** An XRPC call that was answered with an error. */
export class XrpcError extends Error {
  /** The HTTP status. */
  status: i32;
  /** The error name the server gave, such as `RecordNotFound`, or an empty string. */
  error: String;

  new(status: i32, error: String, message: String) : status = status, error = error, super(message);
}

/** A client for the XRPC methods of one service, such as a PDS. */
export final class XrpcClient {
  /** The service's origin, such as `https://pds.example.com`. */
  service: String;
  /** The `authorization` header to send, or null. */
  var authorization: String | null = null;

  new(service: String) : service = service;

  #url(nsid: String, params: Array<(String, String)> | null): String {
    let sb = new StringBuilder();
    sb.append(this.service);
    sb.append('/xrpc/');
    sb.append(nsid);
    if (params != null) {
      var first = true;
      for (let (name, value) in params) {
        sb.append(if (first) '?' else '&');
        sb.append(percentEncode(name, EncodeSet.Component));
        sb.append('=');
        sb.append(percentEncode(value, EncodeSet.Component));
        first = false;
      }
    }
    return sb.toString();
  }

  #headers(contentType: String | null): GrowableArray<(String, String)> {
    let headers = new GrowableArray<(String, String)>();
    headers.push(('accept', 'application/json'));
    if (contentType != null) {
      headers.push(('content-type', contentType));
    }
    let authorization = this.authorization;
    if (authorization != null) {
      headers.push(('authorization', authorization));
    }
    return headers;
  }

  /**
   * Calls a query and returns the raw answer, for methods that answer with
   * something other than JSON, such as `com.atproto.sync.getRecord`.
   * Throws `XrpcError` for an error answer.
   */
  async queryRaw(nsid: String, params: Array<(String, String)> | null = null): Future<Response> {
    let response = await fetch(this.#url(nsid, params), {headers: this.#headers(null)});
    await checkAnswer(nsid, response);
    return response;
  }

  /** Calls a query that answers with JSON. Throws `XrpcError` for an error answer. */
  async query(nsid: String, params: Array<(String, String)> | null = null): Future<JsonValue> {
    let response = await this.queryRaw(nsid, params);
    return parseJson(await response.text());
  }

  /**
   * Calls a procedure with a JSON body, or none when `input` is null, and
   * returns its JSON answer, or null when it has none.
   */
  async procedure(nsid: String, input: JsonValue, params: Array<(String, String)> | null = null): Future<JsonValue> {
    let body: String | null = if (input == null) null else stringify(input);
    let contentType: String | null = if (input == null) null else 'application/json';
    let response = await fetch(this.#url(nsid, params), {
      method: 'POST',
      headers: this.#headers(contentType),
      body,
    });
    await checkAnswer(nsid, response);
    let text = await response.text();
    return if (text.length == 0) null else parseJson(text);
  }

  /** Calls a procedure whose body is bytes of type `mimeType`, such as `com.atproto.repo.uploadBlob`. */
  async upload(nsid: String, mimeType: String, bytes: FixedArray<u8>,
      params: Array<(String, String)> | null = null): Future<JsonValue> {
    let response = await fetch(this.#url(nsid, params), {
      method: 'POST',
      headers: this.#headers(mimeType),
      body: bytes,
    });
    await checkAnswer(nsid, response);
    return parseJson(await response.text());
  }
}

/** Throws `XrpcError` unless `response` is a success. */
async function checkAnswer(nsid: String, response: Response): Future<void> {
  if (response.ok) {
    return;
  }
  var error = '';
  var message = `${nsid} failed with HTTP ${response.status}`;
  try {
    let json = parseJson(await response.text());
    if (json is JsonObject) {
      let name = json['error'];
      if (name is String) {
        error = name;
        message = `${nsid} failed: ${name}`;
      }
      let detail = json['message'];
      if (detail is String) {
        message = `${message}: ${detail}`;
      }
    }
  } catch (e) {
    // Not JSON: keep the status alone.
  }
  throw new XrpcError(response.status, error, message);
}
