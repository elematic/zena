{
  "name": "@zena-lang/atproto",
  "version": "0.0.1",
  "type": "module",
  "description": "AT Protocol libraries for Zena",
  "private": true,
  "scripts": {
    "test": "wireit"
  },
  "wireit": {
    "test": {
      "#command": "Runs from the repository root, which is what the fixture paths inside the tests are relative to and where the compiler finds the package map.",
      "command": "cd ../.. && ./target/release/zena-cli test \"packages/atproto/zena/test/*_test.zena\"",
      "dependencies": [
        "../zena-cli:build",
        "../stdlib:lib"
      ],
      "files": [
        "zena/**/*.zena",
        "zena/test/fixtures/**",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../../zena-package.json",
        "zena/zena-package.json"
      ],
      "output": []
    }
  }
}
