{
  "locks": ["zena-lock.json", "package-lock.json"],
  "scripts": {
    "build": {
      "dependencies": ["build:ts", "build:stdlib", "build:wasm"]
    },
    "build:stdlib": {
      "command": "node scripts/copy-stdlib.js",
      "files": ["scripts/copy-stdlib.js"],
      "output": ["stdlib"],
      "dependencies": ["../stdlib:lib"]
    },
    "build:ts": {
      "command": "tsc",
      "files": ["ts/**/*.ts", "tsconfig.json"],
      "output": [
        "index.{js,d.ts,js.map,d.ts.map}",
        "test/*.{js,d.ts,js.map,d.ts.map}",
        "tsconfig.tsbuildinfo"
      ],
      "clean": "if-file-deleted",
      "dependencies": ["../runtime-js:build"]
    },
    "build:wasm": {
      "#command": "Compiled at -O2 for --target zena-js: shrinks the binary to ~2.1 MB (~904 KB gzip) while speeding up browser and editor checks.",
      "command": "cd ../.. && ZENA_GC_RESERVE_MB=512 ./target/release/zena-run --dir .::. --dir packages/stdlib/zena::/stdlib packages/compiler/out/cli.wasm packages/language-service/src/lsp.zena --target zena-js -O2 -o packages/compiler-js/compiler.wasm",
      "files": ["package.json", "../compiler/out/cli.wasm"],
      "output": ["compiler.wasm"],
      "dependencies": [
        "../language-service:source",
        "../stdlib:lib",
        "../zena-run:build",
        {
          "script": "../compiler:build:cli",
          "cascade": false
        }
      ]
    },
    "test": {
      "command": "node --test test/*_test.js",
      "files": [
        "test/*_test.js",
        "index.js",
        "stdlib/**/*.zena",
        "compiler.wasm",
        "package.json",
        "../runtime-js/package.json",
        "../codemirror/package.json",
        "../playground/package.json",
        "../wasm-web-ui/package.json"
      ],
      "dependencies": [
        "../stdlib:lib",
        "build:ts",
        "build:stdlib",
        {
          "script": "build:wasm",
          "cascade": false
        },
        "../codemirror:build",
        "../playground:build",
        "../wasm-web-ui:build"
      ]
    }
  }
}
