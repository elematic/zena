// ZenaFX interfaces. Two packages live in this one file so that both
// toolchains can read the directory: `wasm-tools` accepts one top-level
// package per directory plus nested ones, and Zena's `readWitSource`
// concatenates the directory's `.wit` files and registers nested
// packages from the result.
//
//   zenafx:ui    what a widget component imports, and what the runtime
//                component exports.
//   zenafx:host  the primitives `zfx` serves in Rust: the retained scene,
//                text, layout and the window. Rasterizing and presenting
//                are the host's alone — a component changes what is on
//                screen by changing its nodes, and never by handing over
//                pixels or a display list.
//
// Designed in docs/design/zenafx-ui.md.

package zenafx:ui@0.1.0;

interface geometry {
  record size { width: f32, height: f32 }
  record rect { x: f32, y: f32, width: f32, height: f32 }
}

interface style {
  /// Non-premultiplied sRGB; each channel runs 0..1.
  record color { r: f32, g: f32, b: f32, a: f32 }

  record box-style {
    background: option<color>,
    border-color: option<color>,
    border-width: f32,
    corner-radius: f32,
    opacity: f32,
  }

  record text-style {
    family: string,
    size: f32,
    weight: u16,
    italic: bool,
    color: color,
  }

  /// `percent` is a CSS percentage of the containing block: 100.0 is full,
  /// not 1.0.
  variant length { auto, px(f32), percent(f32) }
  enum axis { row, column }
  enum justify { start, center, end, space-between }
  enum align { start, center, end, stretch }
  record edges { top: f32, right: f32, bottom: f32, left: f32 }

  /// What becomes of content that does not fit in a box, on one axis.
  ///
  /// It is cut off at the box's edge in every case: nothing is drawn
  /// outside a box, and what is cut off is not under the pointer. The three
  /// values are CSS's, with CSS's meanings. CSS's fourth, `visible`, is left
  /// out.
  enum overflow {
    /// The default, for a box whose content is expected to fit. The box is
    /// never laid out smaller than its content. If the content still does
    /// not fit, because the box was given a size, it is cut off, and the
    /// host logs that it was.
    clip,
    /// For a box that is meant to hold more than fits. It may be laid out
    /// smaller than its content, which is what lets a flex item give up
    /// room.
    hidden,
    /// As `hidden`, and the box scrolls: the scroll wheel over the box
    /// moves the content, as far as its far edge and no further. The host
    /// keeps how far it has scrolled, and scrolling wakes no component.
    scroll,
  }

  /// A node's own box: its size, the room inside its edge, and what becomes
  /// of content that does not fit. Its parent's layout places it. Nothing
  /// in `box-style` or `text-style` affects measurement.
  record box {
    width: length,
    height: length,
    /// How much of the room left over in a flex container this box takes,
    /// and how readily it gives up room there is not enough of. They mean
    /// something when the parent lays out by `flex`.
    grow: f32,
    shrink: f32,
    padding: edges,
    overflow-x: overflow,
    overflow-y: overflow,
  }

  /// Children as items in a row or a column.
  record flex {
    axis: axis,
    justify-content: justify,
    align-items: align,
    gap: f32,
  }

  /// Where the lines of a flow container sit across its width, as
  /// `text-align` in CSS.
  enum text-align {
    /// The side a line of the text's own direction starts at.
    start,
    center,
    end,
    /// Every line but the last is spread to the full width.
    justify,
  }

  /// Children as text in lines.
  ///
  /// The texts of the node's text children are joined in order, each in
  /// its own style, and lines are broken across the whole. A word in bold
  /// in the middle of a sentence is a text child of its own, and the
  /// sentence still wraps as one. A word that is half in one child and half
  /// in the next is one word.
  ///
  /// A child that is not a text node is not shown. A text child's
  /// `editable` and `unselectable` do nothing, and a state style does not
  /// restyle one.
  record flow {
    align: text-align,
    /// The distance from one line to the next, as a multiple of the text
    /// size, as a `line-height` with no unit in CSS. `none` is what each
    /// font asks for.
    line-height: option<f32>,
  }

  /// How a node lays out its children.
  variant layout {
    flex(flex),
    flow(flow),
  }
}

interface scene {
  use geometry.{rect};
  use style.{box-style, text-style, box, layout, color, length};

  /// A node within one viewport, named by whoever holds that viewport.
  /// Node 0 is the viewport's own root and already exists. An id means
  /// nothing outside the viewport it is used with.
  type node = u32;

  record box-op { id: node, parent: node, box: box, layout: layout,
                  style: box-style }
  record text-op { id: node, parent: node, content: string, box: box,
                   style: text-style }
  record layout-op { target: node, box: box, layout: layout }
  record style-op { target: node, style: box-style }
  record content-op { target: node, content: string }

  /// A value that inherits down the tree, resolved at the nearest node
  /// at or above the reader that provides it. The set is closed on
  /// purpose: these are the things a theme carries. Anything richer is
  /// bound by the loader instead.
  variant inherited {
    color(color),
    length(length),
    scalar(f32),
    flag(bool),
    name(string),
  }

  /// Provide `key` at `target` for the subtree beneath it. `none`
  /// withdraws, so the subtree sees whatever an ancestor provides.
  record provide-op { target: node, key: string, value: option<inherited> }

  variant op {
    make-box(box-op),
    make-text(text-op),
    set-layout(layout-op),
    set-style(style-op),
    set-content(content-op),
    provide(provide-op),
    /// Removes the node and its descendants, and frees the ids.
    remove(node),
  }

  /// What a viewport permits. A derived viewport may drop grants and
  /// never add them.
  flags grants {
    pointer,
    keyboard,
  }

  /// The authority to build nodes under one node of the scene. Holding
  /// it is the only way to name a node; dropping it discards the
  /// subtree.
  resource viewport {
    /// Apply a batch of operations in order. Returns nothing, so the
    /// call may be delivered after the caller's own call returns.
    apply: func(ops: list<op>);

    /// The node's box after the most recent layout pass, in window
    /// coordinates. Zero-sized before the first pass.
    bounds: func(target: node) -> rect;

    /// The value of `key` in effect at `target`: from the nearest node at
    /// or above it that provides one, including nodes belonging to other
    /// components. `none` when nothing provides it.
    inherited: func(target: node, key: string) -> option<inherited>;

    /// A viewport rooted at one of this viewport's nodes, carrying at
    /// most the grants this one holds. Handing it to another component
    /// is how a parent gives a child somewhere to draw, and how a child
    /// offers a slot back to its parent.
    derive: func(container: node, permitted: grants) -> viewport;

    /// Mark this subtree as needing layout and paint, and ask the host
    /// for a frame.
    invalidate: func();
  }

  /// Solve layout for every dirty subtree and present one frame. Called
  /// once per frame by the root component, which drives the frame loop.
  flush: func();
}

/// How the root viewport enters the graph. Only the loader calls this —
/// no component imports it, which is what stops a component from
/// helping itself to the root instead of being handed a subtree.
interface session {
  use scene.{viewport};

  root-viewport: func() -> viewport;
}

package zenafx:host@0.1.0 {

  interface text {
    use zenafx:ui/style@0.1.0.{text-style};

    record measured { width: f32, height: f32, baseline: f32 }

    /// Shape `content` under `style` and keep it. The id is valid until
    /// `release-run`.
    register-run: func(content: string, style: text-style) -> u32;
    update-run: func(run: u32, content: string, style: text-style);
    release-run: func(run: u32);

    /// Shape at a width. `none` asks for the unconstrained size.
    measure-run: func(run: u32, available-width: option<f32>) -> measured;
  }

  interface layout {
    use zenafx:ui/style@0.1.0.{box, flex};
    use zenafx:ui/geometry@0.1.0.{size, rect};

    /// The space a solve offers on one axis.
    variant available {
      /// A specific number of pixels.
      definite(f32),
      /// The narrowest the content can be: every soft break taken.
      min-content,
      /// The widest it would like to be: no soft break taken.
      max-content,
    }

    /// One question a solve asks about a leaf.
    ///
    /// Layout is a recursive query rather than one pass down and one pass
    /// up, so a leaf is asked several times per solve and the questions
    /// depend on the styles above it. A `known` dimension is one the parent
    /// has already fixed: the solve is asking what the other dimension
    /// becomes at that size.
    record measure-request {
      known-width: option<f32>,
      known-height: option<f32>,
      available-width: available,
      available-height: available,
    }

    /// What a node holds. A box has no content of its own: it is sized by
    /// its own box and by its children, which it lays out by flex. Text is
    /// a leaf, measured as the solve goes.
    variant content {
      box(flex),
      /// A run registered with `zenafx:host/text`.
      text(u32),
    }

    /// One node of a flat tree. Index 0 is the root; a node's children are
    /// the `child-count` entries starting at `first-child`, and they must
    /// come after it. The tree is flat because WIT records cannot recurse.
    ///
    /// Breadth-first order always satisfies that. Pre-order does not: it
    /// only keeps siblings adjacent when no child but the last has
    /// children of its own, so it works for a chain and breaks for a tree.
    record node {
      box: box,
      content: content,
      first-child: u32,
      child-count: u32,
    }

    /// Solve one tree. The result is parallel to `nodes`, and each rect is
    /// in the root's coordinate space.
    solve: func(nodes: list<node>, available: size) -> list<rect>;
  }

  interface surface {
    record frame-event {
      /// Milliseconds on a monotonic clock since the window opened.
      time-ms: f64,
      width: u32,
      height: u32,
      /// Physical pixels per logical pixel.
      scale: f32,
    }
    record pointer-event { x: f32, y: f32, button: u8, down: bool }
    record key-event { code: u32, down: bool, text: string }

    /// One event per requested redraw, and none otherwise.
    frames: func() -> stream<frame-event>;
    pointer: func() -> stream<pointer-event>;
    keys: func() -> stream<key-event>;

    /// Ask for one more frame. Coalesced.
    request-redraw: func();
  }

  /// What the host tells a component about the pointer, how a component says
  /// which of it a node hears, and how a listener answers. `scene` registers
  /// a listener and hands back the stream its events arrive on.
  interface events {
    enum pointer-kind {
      /// A button went down over the target.
      down,
      /// A button came up over the target.
      up,
      /// The pointer moved, and the target is what it is now over.
      move,
      /// The target is now inside the listener's scope and was not before.
      enter,
      /// The target was inside the listener's scope and no longer is.
      leave,
    }

    /// Which targets a listener hears. The target of a pointer event is the
    /// node painted last under the pointer.
    enum scope {
      /// Only when the listening node is the target.
      node,
      /// When the listening node or any node beneath it is the target,
      /// content in its slots included.
      subtree,
      /// As `subtree`, and only while the pointer is captured for the
      /// target. What a drag's `move` and `up` listeners ask for: they hear
      /// the drag and nothing else, so a pointer crossing the node when
      /// nothing is being dragged does not wake the component. An `enter` or
      /// a `leave` is never in this scope.
      captured,
    }

    /// When a listener is offered a `down`, `up` or `move`. `enter` and `leave`
    /// go to every listener whose scope changed and ignore this.
    enum phase {
      /// After the target, walking up to the root.
      bubble,
      /// Before the target, walking down from the root.
      intercept,
    }

    record pointer-event {
      kind: pointer-kind,
      /// Where the pointer is, measured from the top left corner of the
      /// listening node's box. A slot has no box, so a listener on one is
      /// given the position in the box that contains the slot.
      x: f32,
      y: f32,
      /// 0 left, 1 middle, 2 right, 3 back, 4 forward. 0 for a kind that is
      /// not about a button.
      button: u8,
    }

    /// A listener's answer to one `down`, `up` or `move`, or to one key.
    ///
    /// Such an event is offered to one listener at a time, along the path
    /// between the root and its target. The host offers it to the next
    /// listener when this one has answered, so each listener sees the tree as
    /// the one before it left it. A listener answers by dropping the reply:
    /// the event goes on to the next listener, unless `stop-propagation` was
    /// called first.
    ///
    /// Nothing else answers. A listener that keeps a reply holds up the
    /// events behind it, for its own component and for no other.
    resource reply {
      /// Stop the event from propagating: no listener after this one is
      /// offered it. As `stopPropagation` in the DOM, it changes nothing
      /// else about the event.
      stop-propagation: func();

      /// Keep the host from doing what it otherwise does with the event
      /// once its listeners have answered, as `preventDefault` in the DOM.
      /// The host acts on one event so far: `Tab` going down moves the
      /// focus. On the reply to any other event this does nothing. Later
      /// listeners are still offered the event.
      prevent-default: func();

      /// Capture the pointer, as `setPointerCapture` does in the DOM. From
      /// this answer until the primary button comes up, the target of every
      /// `move` and `up` is the node this listener is on, wherever the
      /// pointer goes, and that node stays the one the pointer is over.
      ///
      /// What a drag needs: the pointer leaves a divider as soon as it
      /// moves, and may leave the window before the button comes up.
      ///
      /// It takes effect while the primary button is down. That is on the
      /// reply to a `down`, and on the reply to a `move` that follows one,
      /// which is how a press becomes a drag only once the pointer has
      /// moved some way. On any other reply it does nothing: an `up` has
      /// already released the button. The method is on every reply because
      /// one type of reply serves every event a listener answers.
      capture: func();
    }

    /// One event, as one listener receives it.
    ///
    /// The event is a record, so reading what happened costs no call. The
    /// reply is a resource because answering is an action, and there is one
    /// only when there is something to answer: `enter` and `leave` go to
    /// every listener whose scope changed, and nothing a listener does stops
    /// them.
    record delivery {
      event: pointer-event,
      reply: option<reply>,
    }

    /// The keys held with another key, as the platform reports them.
    record modifiers {
      shift: bool,
      control: bool,
      alt: bool,
      /// The Command key on a Mac, and the Windows or Super key elsewhere.
      meta: bool,
    }

    /// A key going down or coming up, named as the W3C's keyboard events
    /// name it.
    record key-event {
      /// Whether the key went down. It came up otherwise.
      down: bool,
      /// What the key means, with the keyboard's layout and the modifiers
      /// held: `a`, `A`, `é`, a space, or the name of a key that types
      /// nothing, such as `Enter`, `Tab`, `Escape` or `ArrowDown`. What a
      /// handler for a shortcut or for an activation reads.
      key: string,
      /// Which key it is on the keyboard, whatever it means on this layout:
      /// `KeyA`, `Space`, `Enter`. What a handler reads when the key's place
      /// is what matters, as in a game.
      code: string,
      modifiers: modifiers,
      /// Whether this is the key repeating because it is being held down.
      repeat: bool,
      /// The text this key press types, when it types any: `a`, `É`, a
      /// space. `none` for a key coming up, for a key that types nothing,
      /// and while `control` or `meta` is held, when a letter is a shortcut.
      ///
      /// What a text field inserts. `key` is not a substitute: nothing in it
      /// says whether `Enter` is a name or five characters. The W3C's
      /// keyboard events have no such field and report typed text in a
      /// separate `input` event, which is where text from an input method
      /// would arrive here too. That is not built.
      ///
      /// Pasting arrives here as well. When Control or Meta with `v` goes
      /// down, the host follows that key with one whose `key` is `Paste`
      /// and whose `text` is the text on the clipboard. A text field that
      /// inserts a key's `text` is pasted into with nothing more, and no
      /// component reads the clipboard.
      text: option<string>,
    }

    /// One key event, as one listener receives it.
    ///
    /// A key travels the path between the root and the node that has the
    /// focus, as a `down` travels the path to its target, and a listener
    /// answers it the same way. When the listeners have answered, the host
    /// does what it does with the key, unless one of them called
    /// `prevent-default`: `Tab` moves the focus.
    record key-delivery {
      event: key-event,
      reply: reply,
    }
  }

  /// The retained scene: a tree of trees the host holds and draws from.
  ///
  /// Every widget occupies exactly one node and owns the subtree beneath it —
  /// its **interior**. What a parent puts *into* a widget is its **content**,
  /// which lands in slots the interior marks. Those are a widget's two child
  /// axes and they never mix: a widget authors its interior, is handed its
  /// content, and can name neither inside another widget.
  ///
  /// A component installs a tree once and the host keeps it. A frame is then a
  /// solve and a paint over what the host already has, with no call into any
  /// component — which is what makes resizing free.
  interface scene {
    use zenafx:ui/style@0.1.0.{box, layout, box-style, text-style};
    use events.{pointer-kind, scope, phase, delivery, key-delivery};

    /// Chosen by the guest, so a template definition needs no round trip.
    type template-id = u32;

    record text-content {
      content: string,
      style: text-style,
    }

    /// What a node draws. A node's style travels with its geometry, so
    /// the host paints the same tree it solved and a component never builds a
    /// display list.
    variant node-style {
      /// Nothing of its own: a box that exists to lay out what is under it.
      nothing,
      fill(box-style),
      /// Text. The host shapes it and keeps the result for as long as the
      /// node lives, so a component never handles a shaped run.
      text(text-content),
    }

    /// What the pointer looks like while it is over a node. The names are
    /// CSS's `cursor` keywords, and each means what it means there.
    ///
    /// The platform draws the cursor. The host tells it which of its own
    /// cursors to show, so a cursor follows the person's settings for size
    /// and colour, and moves with the pointer whatever the window is busy
    /// with.
    enum cursor {
      /// The platform's ordinary arrow.
      default,
      context-menu,
      help,
      /// A hand, for something that is pressed to go somewhere.
      pointer,
      progress,
      wait,
      cell,
      crosshair,
      /// An I-beam, over text that can be selected or edited.
      text,
      vertical-text,
      alias,
      copy,
      move,
      no-drop,
      not-allowed,
      /// An open hand, over something that can be picked up.
      grab,
      /// A closed hand, while it is held.
      grabbing,
      e-resize,
      n-resize,
      ne-resize,
      nw-resize,
      s-resize,
      se-resize,
      sw-resize,
      w-resize,
      ew-resize,
      ns-resize,
      nesw-resize,
      nwse-resize,
      /// Arrows left and right, over a divider dragged sideways.
      col-resize,
      /// Arrows up and down, over a divider dragged up and down.
      row-resize,
      all-scroll,
      zoom-in,
      zoom-out,
    }

    /// One node of a template, in a flat list.
    ///
    /// Node 0 describes the node being rendered into — the widget's own box,
    /// what CSS would reach with `:host`. The rest are its interior and hang
    /// beneath it. So a widget is one box and not two: its template's root is
    /// its node rather than something inside it.
    ///
    /// `first-child` and `child-count` index that same list: they are
    /// positions in a description, never scene identities. WIT value types
    /// cannot recurse, and breadth-first order keeps a node's children
    /// contiguous and after it.
    record node-def {
      /// The node's own box, which its parent's layout places.
      box: box,
      /// How the node lays out its children: as items in a row or a
      /// column, or as text in lines. A node with `flow` is a flow
      /// container, and is one text to its parent's layout and to the
      /// selection. A text node has no children, and its `layout` does
      /// nothing.
      layout: layout,
      style: node-style,
      first-child: u32,
      child-count: u32,
      /// Whether content hangs here instead of interior. Slots are numbered by
      /// the order they appear in the list; node 0 is the widget's own box, so
      /// this is ignored there.
      ///
      /// A slot is not a box. Like `<slot>`'s own `display: contents`, it
      /// contributes no geometry: what hangs in it lays out as a child of
      /// whatever contains the slot. That is the other half of one box per
      /// widget — a widget's node is a box, and the slot it was placed in is
      /// not.
      is-slot: bool,
      /// The cursor to show while the pointer is over this node, or over
      /// anything beneath it that names none of its own. `none` leaves it
      /// to the node above, as `cursor` inherits in CSS, and the window
      /// shows `default` where no node names one.
      ///
      /// While the pointer is captured, the node it is captured for is the
      /// one the pointer counts as over, so a divider's cursor stays for the
      /// whole of a drag.
      cursor: option<cursor>,
      /// Whether this node can have the focus.
      ///
      /// One node in a window has the focus, or none does, and the keyboard
      /// goes to it. `Tab` moves the focus to the next node that can have it,
      /// in the order they come in the tree, and `Shift` with `Tab` to the
      /// one before, going round at the ends. A press gives the focus to the
      /// nearest such node at or above the node pressed, and takes it away
      /// when there is none.
      focusable: bool,
      /// Whether a person edits this node's text. It means something on a
      /// text node, and such a node inside a node that can have the focus
      /// makes that node a text field.
      ///
      /// A window has one selection, and the host keeps it, as it keeps the
      /// focus. In a text field the host does everything the pointer does
      /// to it, with no call to the component:
      ///
      /// - A press anywhere in the field puts the caret at the place in the
      ///   text nearest the pointer, and dragging from there selects.
      /// - A press with `Shift` held moves the end of the selection to the
      ///   pointer.
      /// - A second press in the same place selects the word there, and a
      ///   third selects all the text.
      /// - When a field gets the focus and the selection is somewhere else,
      ///   the caret goes to the end of the field's text.
      ///
      /// The host draws the caret and a highlight over what is selected,
      /// while the field has the focus, and scrolls the nearest box above
      /// the text that says `hidden` or `scroll` to keep the caret in sight.
      ///
      /// The text itself is the component's, in a `content` hole. The
      /// component edits it when it hears a key: it asks where the selection
      /// is with `node.selection`, writes the new text, and says where the
      /// caret now is with `node.select`.
      editable: bool,
      /// Whether the pointer cannot select this node's text, nor the text of
      /// anything beneath it, as `user-select: none` in CSS.
      ///
      /// Any other text in the window can be selected, as on a web page,
      /// with no call to a component. A press on text and a drag select
      /// from the one place to the other, through whatever text is between
      /// them in the order of the tree. A second press selects a word and a
      /// third the whole of a text node. Control or Meta with `a` selects
      /// all of it, and with `c` copies what is selected to the clipboard.
      ///
      /// A button's label is the usual thing to leave out: a press on it is
      /// then a press and nothing else, and what was selected stays
      /// selected.
      unselectable: bool,
    }

    /// Which property of a node a hole writes. The set is what the host can
    /// patch in place without rebuilding the node.
    ///
    /// A `layout` hole writes a layout of the kind the node has: the gap of
    /// a row, or the alignment of a flow container's lines. One of the other
    /// kind is not applied, since whether a node's children are items or
    /// text is the template's.
    enum binding-target { content, style, box, layout }

    /// What is selected in a text node's content, as two places counted in
    /// UTF-8 bytes from the start. `anchor` is where the selection began and
    /// `focus` is where it ends, which is where the caret is. The two are
    /// equal when nothing is selected, and `focus` is before `anchor` in a
    /// selection made backwards. The names are the DOM's.
    ///
    /// A place is always between two characters as a reader sees them. The
    /// host moves one that is given inside a character to the character's
    /// edge.
    record text-selection {
      anchor: u32,
      focus: u32,
    }

    /// One hole in a template, named by the interior node it belongs to and
    /// the property it sets. A hole is identified by its index in the
    /// template's list; nothing on the wire names it.
    record binding {
      node: u32,
      target: binding-target,
    }

    variant binding-value {
      content(string),
      style(box-style),
      text-style(text-style),
      box(box),
      layout(layout),
    }

    /// One hole and what to put in it.
    ///
    /// The guest holds each hole's last value and sends only the ones that
    /// changed, so this list is sparse. It diffs rather than the host because
    /// every value here is marshalled, where an in-process renderer compares
    /// for free.
    record hole {
      binding: u32,
      value: binding-value,
    }

    /// Something true of a node because of where the pointer is or where the
    /// focus is. The host works it out, since the host finds what the
    /// pointer is over and moves the focus.
    enum state {
      /// The node the pointer is over is this node or one beneath it,
      /// content in its slots included.
      hovered,
      /// The primary button went down while the node under the pointer was
      /// this node or one beneath it, and has not come up since.
      pressed,
      /// The node that has the focus is this node or one beneath it.
      focused,
    }

    /// How a node is styled while a state holds. A `fill` is for a box and a
    /// `text` for a text node, whose content it leaves alone.
    variant restyle {
      fill(box-style),
      text(text-style),
    }

    /// One node's style while a state holds, in place of the style it has
    /// otherwise.
    ///
    /// `node` is the node that changes and `of` the node whose state is
    /// read. Both are positions in the template, as in a `binding`. They are
    /// two fields because they often differ: a button's label changes colour
    /// while the button is pressed, so `node` is the label and `of` is 0, the
    /// button's own box.
    ///
    /// The host applies these when it draws. A component is not told that
    /// the pointer came or went, and a state that only changes a node's
    /// style costs a frame and wakes no component.
    ///
    /// When several hold for one node, the last in the template's list is
    /// the one shown, so `pressed` goes after `hovered`. A hole written to
    /// the node changes the style it has when no state holds.
    record state-style {
      node: u32,
      when: state,
      of: u32,
      style: restyle,
    }

    /// A template, the first time it is used.
    record template-def {
      id: template-id,
      nodes: list<node-def>,
      bindings: list<binding>,
      states: list<state-style>,
    }

    /// A template the host may not have seen.
    ///
    /// Nothing is registered up front: a definition travels with the first
    /// render that uses it, and afterwards only its id does. The guest tracks
    /// which it has sent, and the host's table lives and dies with the
    /// component instance, so the two cannot drift.
    variant template-ref {
      known(template-id),
      fresh(template-def),
    }

    /// A widget's place in the scene, and its authority over what is beneath.
    ///
    /// One per widget, held by it for as long as it lives. Dropping the handle
    /// releases only the handle: the node itself belongs to whoever's interior
    /// it sits in, so a child cannot delete a slot its parent declared.
    ///
    /// A node goes away when the interior holding it is rebuilt — its parent
    /// renders a template without that slot — so removal is a consequence of
    /// the parent's own render, never of a child dropping something.
    resource node {
      /// Show `template` here, with `holes` applied: node 0 of it becomes this
      /// node's own box, and the rest become its interior.
      ///
      /// One operation for creating and for updating, because the host can
      /// tell which is which: nothing there yet, it builds the template and
      /// fills every hole; the same template already there, it writes the
      /// holes it was given; a different template, it drops what was there
      /// and builds the new one. Template identity is what decides patch
      /// against replace, and the guest never says which it meant.
      ///
      /// A patch leaves the content hanging in this node's slots alone, since
      /// the slots are still there. Rebuilding takes that content with it —
      /// none of it belongs to a template that no longer exists.
      render: func(template: template-ref, holes: list<hole>);

      /// The nodes hanging in slot `slot` of this node's interior, made exactly
      /// `count` long, so a parent can give each of its children somewhere to
      /// render.
      ///
      /// Growing creates empty nodes, shrinking drops the ones past the end
      /// with everything beneath them, and the nodes that stay keep their
      /// identity and their subtrees. That is positional reconciliation, and
      /// the only place a parent ever adds or removes a child.
      ///
      /// The one way a node inside an interior is ever named, and a widget can
      /// reach only its own slots. That is the boundary selectors will scope to
      /// and the one a component cannot see across: a parent is handed a node
      /// to put a child in and can read nothing the child puts there.
      content: func(slot: u32, count: u32) -> list<own<node>>;

      /// Replace the children hanging in slot `slot` with `children`, in order.
      ///
      /// Any previous child not present in `children` is detached if it was
      /// created with `create-node` — keeping its interior and shaped text runs
      /// alive for as long as the guest holds its handle — or dropped if it was
      /// created by `content`. Each node in `children` is reparented into the
      /// slot (detaching it from any previous slot first).
      set-slot: func(slot: u32, children: list<borrow<node>>);

      /// Hear pointer events of one kind at a node of this node's interior.
      ///
      /// `target` is a position in the template this node shows, as in a
      /// `binding`: 0 is this node itself, and a slot's position is the slot,
      /// which with `subtree` scope hears the content hanging in it.
      ///
      /// The events arrive on the stream this returns, one stream for each
      /// listener. The host keeps the description on the node, so it knows
      /// which listeners an event reaches before it writes anything, and an
      /// event that reaches none wakes nobody.
      ///
      /// A component stops listening by dropping the stream, which removes
      /// the listener. The host removes the listener itself, and ends the
      /// stream, when the node it listens at goes away. That happens when
      /// the interior the node belongs to is replaced: a patch keeps the
      /// listener, and rendering a different template removes it with the
      /// rest of the old interior, so a widget listens again after a rebuild.
      ///
      /// This method is for pointer events only. A stream has one element
      /// type, so each family of events with a payload of its own gets a
      /// method of its own.
      listen-pointer: func(target: u32, kind: pointer-kind, in-scope: scope, at: phase)
          -> stream<delivery>;

      /// Hear the keyboard at a node of this node's interior, while the
      /// focus is on that node or on one beneath it.
      ///
      /// `target` is a position in the template, as for `listen-pointer`. A key
      /// travels from the root down to the node with the focus and back up,
      /// and `at` says on which leg this listener is offered it. A listener
      /// on the root hears every key, since every node is beneath it, and
      /// hears the keys pressed while nothing has the focus.
      ///
      /// The keys arrive on the stream this returns. As for `listen-pointer`,
      /// dropping the stream removes the listener, and the host removes the
      /// listener and ends the stream when the node goes away.
      listen-keys: func(target: u32, at: phase) -> stream<key-delivery>;

      /// Where the window's selection is in the text node at `target`, a
      /// position in the template this node shows. `none` when the selection
      /// is not in that text node, or the node is not text.
      ///
      /// What a text field asks when it hears a key, since the pointer may
      /// have moved the selection since the field last set it. The host is
      /// the one place the selection is kept, so a component keeps no copy
      /// to fall out of date.
      selection: func(target: u32) -> option<text-selection>;

      /// Put the window's selection in the text node at `target`. What a
      /// text field does after an edit, to put the caret after what was
      /// typed. The host brings the caret into sight.
      ///
      /// A place past the end of the text is moved to the end.
      select: func(target: u32, to: text-selection);
    }

    /// The scene's root. The first `render` on it installs the tree.
    root: func() -> own<node>;

    /// Create a detached node owned by the caller.
    ///
    /// A detached node can be rendered into and holds its interior and shaped
    /// text runs in the host while layout, paint, and hit testing skip it
    /// until a parent places it in a slot with `set-slot`. Dropping the
    /// returned handle frees the node and its interior.
    create-node: func() -> own<node>;

    /// Say that the tree is complete and worth drawing.
    ///
    /// Called once, when the component has finished building what it wants on
    /// screen. The host waits for it before the first frame, because it cannot
    /// wait for the entry to return: a component that keeps working never
    /// returns from it.
    ///
    /// Nothing else needs it. `render` marks the scene for redraw on its own,
    /// because the host performs the change and knows which node it touched.
    ready: func();
  }

  /// Properties, facts, conditions, scoped stylesheets, and reactive watchers
  /// served by the ZenaFX platform component (`docs/design/zenafx-styles.md`).
  interface style {
    use zenafx:ui/style@0.1.0.{color, length};
    use scene.{node};

    enum value-type {
      flag,
      number,
      length,
      color,
      keyword,
      text,
    }

    record property-def {
      kind: value-type,
      inherits: bool,
    }

    enum fact-kind {
      flag,
      number,
    }

    enum host-fact {
      text,
      box,
      hovered,
      pressed,
      focused,
      width,
      height,
      scroll-x,
      scroll-y,
      scroll-range-x,
      scroll-range-y,
      index,
    }

    enum builtin-property {
      width,
      height,
      grow,
      shrink,
      padding-top,
      padding-right,
      padding-bottom,
      padding-left,
      overflow-x,
      overflow-y,
      axis,
      justify,
      align,
      gap,
      text-align,
      line-height,
      background,
      border-color,
      border-width,
      corner-radius,
      opacity,
      text-family,
      text-size,
      text-weight,
      text-italic,
      text-color,
      cursor,
      user-select,
    }

    variant style-key {
      host(host-fact),
      builtin(builtin-property),
      custom(u32),
    }

    variant style-value {
      flag(bool),
      number(f32),
      length(length),
      color(color),
      keyword(u32),
      text(string),
      use-prop(style-key),
      use-fact(style-key),
    }

    record declaration {
      property: style-key,
      value: style-value,
      is-default: bool,
    }

    record range-test {
      key: style-key,
      min: option<f32>,
      min-inclusive: bool,
      max: option<f32>,
      max-inclusive: bool,
    }

    variant condition {
      flag(style-key),
      range(range-test),
      under(u32),
      within(u32),
      all(list<u32>),
      any(list<u32>),
      negate(u32),
    }

    record rule {
      when: option<u32>,
      then: list<declaration>,
    }

    enum reach {
      node,
      scope,
    }

    record stylesheet-def {
      id: u32,
      conditions: list<condition>,
      rules: list<rule>,
    }

    define-property: func(def: property-def) -> u32;
    define-fact: func(kind: fact-kind) -> u32;
    define-stylesheet: func(def: stylesheet-def);
    attach-stylesheet: func(target-node: borrow<node>, target: u32, stylesheet: u32, reach: reach) -> bool;
    detach-stylesheet: func(target-node: borrow<node>, target: u32, stylesheet: u32) -> bool;
    set-flag: func(target-node: borrow<node>, target: u32, key: u32, value: bool) -> bool;
    set-number: func(target-node: borrow<node>, target: u32, key: u32, value: option<f32>) -> bool;
    set-declarations: func(target-node: borrow<node>, target: u32, decls: list<declaration>) -> bool;
    set-scope-owner: func(target-node: borrow<node>, owner: borrow<node>) -> bool;
    resolved-property: func(target-node: borrow<node>, target: u32, key: style-key) -> option<style-value>;
    watch-condition: func(target-node: borrow<node>, target: u32, conditions: list<condition>, root: u32) -> stream<bool>;
    watch-property: func(target-node: borrow<node>, target: u32, key: style-key) -> stream<option<style-value>>;
  }

  /// How a component is started.
  ///
  /// One function and no types: a component builds its own tree through
  /// `zenafx:host/scene`, so nothing about what it draws crosses here.
  interface app {
    /// The component's entry.
    ///
    /// Called once. It builds its widgets and installs the tree it wants
    /// drawn through `zenafx:host/scene`, then returns; the host owns the
    /// tree from then on and a resize never enters the component again.
    ///
    /// `async func` so the lift carries a callback, which is the only way
    /// the host can re-enter the component to run work it started — a
    /// `sleep` from `zena:time`, a fetch, anything parked on a waitable.
    /// The program's own `main` may be an ordinary synchronous function:
    /// Zena lets one call an async function, it just cannot `await` the
    /// result, and the task the lift opens is what keeps the continuation
    /// reachable.
    main: async func();
  }

  world runtime {
    import text;
    import layout;
    import surface;

    export zenafx:ui/scene@0.1.0;
    /// Called by the loader only, to mint the root viewport it hands to
    /// the application.
    export zenafx:ui/session@0.1.0;
  }
}
