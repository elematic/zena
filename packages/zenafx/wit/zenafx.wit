// ZenaFX interfaces. Two packages live in this one file so that both
// toolchains can read the directory: `wasm-tools` accepts one top-level
// package per directory plus nested ones, and Zena's `readWitSource`
// concatenates the directory's `.wit` files and registers nested
// packages from the result.
//
//   zenafx:ui    what a widget component imports, and what the runtime
//                component exports.
//   zenafx:host  the primitives `zfx` serves in Rust: text, layout,
//                paint and the window.
//
// Designed in docs/design/zenafx-ui.md.

package zenafx:ui@0.1.0;

interface geometry {
  record size { width: f32, height: f32 }
  record rect { x: f32, y: f32, width: f32, height: f32 }
}

interface style {
  /// Non-premultiplied sRGB; each channel runs 0..1.
  record color { r: f32, g: f32, b: f32, a: f32 }

  record box-style {
    background: option<color>,
    border-color: option<color>,
    border-width: f32,
    corner-radius: f32,
    opacity: f32,
  }

  record text-style {
    family: string,
    size: f32,
    weight: u16,
    italic: bool,
    color: color,
  }

  /// `percent` is a CSS percentage of the containing block: 100.0 is full,
  /// not 1.0.
  variant length { auto, px(f32), percent(f32) }
  enum axis { row, column }
  enum justify { start, center, end, space-between }
  enum align { start, center, end, stretch }
  record edges { top: f32, right: f32, bottom: f32, left: f32 }

  /// Geometry only. Nothing here affects painting, and nothing in
  /// `box-style` or `text-style` affects measurement.
  record flex {
    axis: axis,
    justify-content: justify,
    align-items: align,
    gap: f32,
    padding: edges,
    width: length,
    height: length,
    grow: f32,
    shrink: f32,
  }
}

interface scene {
  use geometry.{rect};
  use style.{box-style, text-style, flex, color, length};

  /// A node within one viewport, named by whoever holds that viewport.
  /// Node 0 is the viewport's own root and already exists. An id means
  /// nothing outside the viewport it is used with.
  type node = u32;

  record box-op { id: node, parent: node, layout: flex, style: box-style }
  record text-op { id: node, parent: node, content: string, layout: flex,
                   style: text-style }
  record layout-op { target: node, layout: flex }
  record style-op { target: node, style: box-style }
  record content-op { target: node, content: string }

  /// A value that inherits down the tree, resolved at the nearest node
  /// at or above the reader that provides it. The set is closed on
  /// purpose: these are the things a theme carries. Anything richer is
  /// bound by the loader instead.
  variant inherited {
    color(color),
    length(length),
    scalar(f32),
    flag(bool),
    name(string),
  }

  /// Provide `key` at `target` for the subtree beneath it. `none`
  /// withdraws, so the subtree sees whatever an ancestor provides.
  record provide-op { target: node, key: string, value: option<inherited> }

  variant op {
    make-box(box-op),
    make-text(text-op),
    set-layout(layout-op),
    set-style(style-op),
    set-content(content-op),
    provide(provide-op),
    /// Removes the node and its descendants, and frees the ids.
    remove(node),
  }

  /// What a viewport permits. A derived viewport may drop grants and
  /// never add them.
  flags grants {
    pointer,
    keyboard,
  }

  /// The authority to build nodes under one node of the scene. Holding
  /// it is the only way to name a node; dropping it discards the
  /// subtree.
  resource viewport {
    /// Apply a batch of operations in order. Returns nothing, so the
    /// call may be delivered after the caller's own call returns.
    apply: func(ops: list<op>);

    /// The node's box after the most recent layout pass, in window
    /// coordinates. Zero-sized before the first pass.
    bounds: func(target: node) -> rect;

    /// The value of `key` in effect at `target`: from the nearest node at
    /// or above it that provides one, including nodes belonging to other
    /// components. `none` when nothing provides it.
    inherited: func(target: node, key: string) -> option<inherited>;

    /// A viewport rooted at one of this viewport's nodes, carrying at
    /// most the grants this one holds. Handing it to another component
    /// is how a parent gives a child somewhere to draw, and how a child
    /// offers a slot back to its parent.
    derive: func(container: node, permitted: grants) -> viewport;

    /// Mark this subtree as needing layout and paint, and ask the host
    /// for a frame.
    invalidate: func();
  }

  /// Solve layout for every dirty subtree and present one frame. Called
  /// once per frame by the root component, which drives the frame loop.
  flush: func();
}

/// How the root viewport enters the graph. Only the loader calls this —
/// no component imports it, which is what stops a component from
/// helping itself to the root instead of being handed a subtree.
interface session {
  use scene.{viewport};

  root-viewport: func() -> viewport;
}

package zenafx:host@0.1.0 {

  interface text {
    use zenafx:ui/style@0.1.0.{text-style};

    record measured { width: f32, height: f32, baseline: f32 }

    /// Shape `content` under `style` and keep it. The id is valid until
    /// `release-run`.
    register-run: func(content: string, style: text-style) -> u32;
    update-run: func(run: u32, content: string, style: text-style);
    release-run: func(run: u32);

    /// Shape at a width. `none` asks for the unconstrained size.
    measure-run: func(run: u32, available-width: option<f32>) -> measured;
  }

  interface layout {
    use zenafx:ui/style@0.1.0.{flex};
    use zenafx:ui/geometry@0.1.0.{size, rect};

    /// The space a solve offers on one axis.
    variant available {
      /// A specific number of pixels.
      definite(f32),
      /// The narrowest the content can be: every soft break taken.
      min-content,
      /// The widest it would like to be: no soft break taken.
      max-content,
    }

    /// One question a solve asks about a leaf.
    ///
    /// Layout is a recursive query rather than one pass down and one pass
    /// up, so a leaf is asked several times per solve and the questions
    /// depend on the styles above it. A `known` dimension is one the parent
    /// has already fixed: the solve is asking what the other dimension
    /// becomes at that size.
    record measure-request {
      known-width: option<f32>,
      known-height: option<f32>,
      available-width: available,
      available-height: available,
    }

    /// What a leaf holds. A box has no content of its own and is sized by
    /// its style and its children.
    variant content {
      box,
      /// A run registered with `zenafx:host/text`.
      text(u32),
    }

    /// One node of a flat tree. Index 0 is the root; a node's children are
    /// the `child-count` entries starting at `first-child`, and they must
    /// come after it. The tree is flat because WIT records cannot recurse.
    ///
    /// Breadth-first order always satisfies that. Pre-order does not: it
    /// only keeps siblings adjacent when no child but the last has
    /// children of its own, so it works for a chain and breaks for a tree.
    record node {
      layout: flex,
      content: content,
      first-child: u32,
      child-count: u32,
    }

    /// Solve one tree. The result is parallel to `nodes`, and each rect is
    /// in the root's coordinate space.
    solve: func(nodes: list<node>, available: size) -> list<rect>;
  }

  interface paint {
    use zenafx:ui/geometry@0.1.0.{rect};
    use zenafx:ui/style@0.1.0.{color};

    record quad {
      bounds: rect,
      background: option<color>,
      border-color: option<color>,
      border-width: f32,
      corner-radius: f32,
    }

    record glyphs { run: u32, x: f32, y: f32 }

    variant command {
      quad(quad),
      glyphs(glyphs),
      push-clip(rect),
      pop-clip,
    }

    /// Draw the frame and present it.
    present: func(commands: list<command>);
  }

  interface surface {
    record frame-event {
      /// Milliseconds on a monotonic clock since the window opened.
      time-ms: f64,
      width: u32,
      height: u32,
      /// Physical pixels per logical pixel.
      scale: f32,
    }
    record pointer-event { x: f32, y: f32, button: u8, down: bool }
    record key-event { code: u32, down: bool, text: string }

    /// One event per requested redraw, and none otherwise.
    frames: func() -> stream<frame-event>;
    pointer: func() -> stream<pointer-event>;
    keys: func() -> stream<key-event>;

    /// Ask for one more frame. Coalesced.
    request-redraw: func();
  }

  /// The retained scene: a tree of trees the host holds and draws from.
  ///
  /// Every widget occupies exactly one node and owns the subtree beneath it —
  /// its **interior**. What a parent puts *into* a widget is its **content**,
  /// which lands in slots the interior marks. Those are a widget's two child
  /// axes and they never mix: a widget authors its interior, is handed its
  /// content, and can name neither inside another widget.
  ///
  /// A component installs a tree once and the host keeps it. A frame is then a
  /// solve and a paint over what the host already has, with no call into any
  /// component — which is what makes resizing free.
  interface scene {
    use zenafx:ui/style@0.1.0.{flex, box-style, text-style};

    /// Chosen by the guest, so a template definition needs no round trip.
    type template-id = u32;

    record text-content {
      content: string,
      style: text-style,
    }

    /// What a node draws. A node's appearance travels with its geometry, so
    /// the host paints the same tree it solved and a component never builds a
    /// display list.
    variant appearance {
      /// Nothing of its own: a box that exists to lay out what is under it.
      nothing,
      fill(box-style),
      /// Text. The host shapes it and keeps the result for as long as the
      /// node lives, so a component never handles a shaped run.
      text(text-content),
    }

    /// One node of a template, in a flat list.
    ///
    /// Node 0 describes the node being rendered into — the widget's own box,
    /// what CSS would reach with `:host`. The rest are its interior and hang
    /// beneath it. So a widget is one box and not two: its template's root is
    /// its node rather than something inside it.
    ///
    /// `first-child` and `child-count` index that same list: they are
    /// positions in a description, never scene identities. WIT value types
    /// cannot recurse, and breadth-first order keeps a node's children
    /// contiguous and after it.
    record node-def {
      layout: flex,
      appearance: appearance,
      first-child: u32,
      child-count: u32,
      /// Whether content hangs here instead of interior. Slots are numbered by
      /// the order they appear in the list; node 0 is the widget's own box, so
      /// this is ignored there.
      ///
      /// A slot is not a box. Like `<slot>`'s own `display: contents`, it
      /// contributes no geometry: what hangs in it lays out as a child of
      /// whatever contains the slot. That is the other half of one box per
      /// widget — a widget's node is a box, and the slot it was placed in is
      /// not.
      is-slot: bool,
    }

    /// Which property of a node a hole writes. The set is what the host can
    /// patch in place without rebuilding the node.
    enum binding-target { content, style, layout }

    /// One hole in a template, named by the interior node it belongs to and
    /// the property it sets. A hole is identified by its index in the
    /// template's list; nothing on the wire names it.
    record binding {
      node: u32,
      target: binding-target,
    }

    variant binding-value {
      content(string),
      style(box-style),
      text-style(text-style),
      layout(flex),
    }

    /// One hole and what to put in it.
    ///
    /// The guest holds each hole's last value and sends only the ones that
    /// changed, so this list is sparse. It diffs rather than the host because
    /// every value here is marshalled, where an in-process renderer compares
    /// for free.
    record hole {
      binding: u32,
      value: binding-value,
    }

    /// A template, the first time it is used.
    record template-def {
      id: template-id,
      nodes: list<node-def>,
      bindings: list<binding>,
    }

    /// A template the host may not have seen.
    ///
    /// Nothing is registered up front: a definition travels with the first
    /// render that uses it, and afterwards only its id does. The guest tracks
    /// which it has sent, and the host's table lives and dies with the
    /// component instance, so the two cannot drift.
    variant template-ref {
      known(template-id),
      fresh(template-def),
    }

    /// A widget's place in the scene, and its authority over what is beneath.
    ///
    /// One per widget, held by it for as long as it lives. Dropping the handle
    /// releases only the handle: the node itself belongs to whoever's interior
    /// it sits in, so a child cannot delete a slot its parent declared.
    ///
    /// A node goes away when the interior holding it is rebuilt — its parent
    /// renders a template without that slot — so removal is a consequence of
    /// the parent's own render, never of a child dropping something.
    resource node {
      /// Show `template` here, with `holes` applied: node 0 of it becomes this
      /// node's own box, and the rest become its interior.
      ///
      /// One operation for creating and for updating, because the host can
      /// tell which is which: nothing there yet, it builds the template and
      /// fills every hole; the same template already there, it writes the
      /// holes it was given; a different template, it drops what was there
      /// and builds the new one. Template identity is what decides patch
      /// against replace, and the guest never says which it meant.
      ///
      /// A patch leaves the content hanging in this node's slots alone, since
      /// the slots are still there. Rebuilding takes that content with it —
      /// none of it belongs to a template that no longer exists.
      render: func(template: template-ref, holes: list<hole>);

      /// The nodes hanging in slot `slot` of this node's interior, made exactly
      /// `count` long, so a parent can give each of its children somewhere to
      /// render.
      ///
      /// Growing creates empty nodes, shrinking drops the ones past the end
      /// with everything beneath them, and the nodes that stay keep their
      /// identity and their subtrees. That is positional reconciliation, and
      /// the only place a parent ever adds or removes a child.
      ///
      /// The one way a node inside an interior is ever named, and a widget can
      /// reach only its own slots. That is the boundary selectors will scope to
      /// and the one a component cannot see across: a parent is handed a node
      /// to put a child in and can read nothing the child puts there.
      content: func(slot: u32, count: u32) -> list<own<node>>;
    }

    /// The scene's root. The first `render` on it installs the tree.
    root: func() -> own<node>;

    /// Say that the tree is complete and worth drawing.
    ///
    /// Called once, when the component has finished building what it wants on
    /// screen. The host waits for it before the first frame, because it cannot
    /// wait for the entry to return: a component that keeps working never
    /// returns from it.
    ///
    /// Nothing else needs it. `render` marks the scene for redraw on its own,
    /// because the host performs the change and knows which node it touched.
    ready: func();
  }

  /// How a component is started.
  ///
  /// One function and no types: a component builds its own tree through
  /// `zenafx:host/scene`, so nothing about what it draws crosses here.
  interface app {
    /// The component's entry.
    ///
    /// Called once. It builds its widgets and installs the tree it wants
    /// drawn through `zenafx:host/scene`, then returns; the host owns the
    /// tree from then on and a resize never enters the component again.
    ///
    /// `async func` so the lift carries a callback, which is the only way
    /// the host can re-enter the component to run work it started — a
    /// `sleep` from `zena:time`, a fetch, anything parked on a waitable.
    /// The program's own `main` may be an ordinary synchronous function:
    /// Zena lets one call an async function, it just cannot `await` the
    /// result, and the task the lift opens is what keeps the continuation
    /// reachable.
    main: async func();
  }

  world runtime {
    import text;
    import layout;
    import paint;
    import surface;

    export zenafx:ui/scene@0.1.0;
    /// Called by the loader only, to mint the root viewport it hands to
    /// the application.
    export zenafx:ui/session@0.1.0;
  }
}
