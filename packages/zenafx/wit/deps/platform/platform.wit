// Platform / scene runtime component for ZenaFX.
//
// Sits between user-authored app/widget components and the minimal Rust
// native core (`zenafx:core/render@0.1.0`). Owns templates, holes, slots,
// detached nodes, style resolution (stopgap state-styles first, then the full
// property/rule engine from docs/design/zenafx-styles.md), and logical event
// routing.
//
// Designed in docs/design/zenafx-platform-core.md.

package zenafx:platform@0.1.0;

interface runtime {
  use zenafx:core/render@0.1.0.{
    box,
    box-style,
    color,
    core-event,
    cursor,
    layout,
    length,
    node-style,
    text-selection,
    text-style,
  };

  record node-def {
    box: box,
    layout: layout,
    style: node-style,
    first-child: u32,
    child-count: u32,
    is-slot: bool,
    cursor: option<cursor>,
    focusable: bool,
    editable: bool,
    unselectable: bool,
  }

  enum binding-target {
    content,
    style,
    box,
    layout,
  }

  record binding {
    node: u32,
    target: binding-target,
  }

  variant binding-value {
    content(string),
    style(box-style),
    text-style(text-style),
    box(box),
    layout(layout),
  }

  record hole {
    binding: u32,
    value: binding-value,
  }

  enum state {
    hovered,
    pressed,
    focused,
  }

  variant restyle {
    fill(box-style),
    text(text-style),
  }

  record state-style {
    node: u32,
    when: state,
    of: u32,
    style: restyle,
  }

  record template-def {
    id: u32,
    nodes: list<node-def>,
    bindings: list<binding>,
    states: list<state-style>,
  }

  variant template-ref {
    known(u32),
    fresh(template-def),
  }

  enum pointer-kind {
    down,
    up,
    move,
    enter,
    leave,
  }

  enum scope {
    node,
    subtree,
    captured,
  }

  enum phase {
    bubble,
    intercept,
  }

  record pointer-event {
    kind: pointer-kind,
    x: f32,
    y: f32,
    button: u8,
  }

  record call {
    listener: u32,
    event: pointer-event,
  }

  record delivery {
    calls: list<call>,
    stops-when-handled: bool,
  }

  // --------------------------------------------------------------------------
  // Style Engine Types (`docs/design/zenafx-styles.md`)
  // --------------------------------------------------------------------------

  /// What kind of value a style property holds.
  enum value-type {
    flag,
    number,
    length,
    color,
    keyword,
    text,
  }

  /// Definition of an application-owned property.
  record property-def {
    kind: value-type,
    inherits: bool,
  }

  /// Whether an application-owned fact is a flag or a number.
  enum fact-kind {
    flag,
    number,
  }

  /// Built-in facts maintained by the platform component and native core.
  enum host-fact {
    text,
    box,
    hovered,
    pressed,
    focused,
    width,
    height,
    scroll-x,
    scroll-y,
    scroll-range-x,
    scroll-range-y,
    index,
  }

  /// Built-in layout, visual, typography, and interaction properties.
  ///
  /// Keyword ordinal encodings (for `style-value.keyword`):
  /// - `overflow-x` / `overflow-y`: 0=clip, 1=hidden, 2=scroll
  /// - `axis`: 0=row, 1=column
  /// - `justify`: 0=start, 1=center, 2=end, 3=space-between
  /// - `align`: 0=start, 1=center, 2=end, 3=stretch
  /// - `text-align`: 0=start, 1=center, 2=end, 3=justify
  /// - `user-select`: 0=text (selectable), 1=none (unselectable)
  /// - `cursor`: ordinal of `zenafx:core/render.cursor` (0=default .. 33=zoom-out)
  enum builtin-property {
    width,
    height,
    grow,
    shrink,
    padding-top,
    padding-right,
    padding-bottom,
    padding-left,
    overflow-x,
    overflow-y,
    axis,
    justify,
    align,
    gap,
    text-align,
    line-height,
    background,
    border-color,
    border-width,
    corner-radius,
    opacity,
    text-family,
    text-size,
    text-weight,
    text-italic,
    text-color,
    cursor,
    user-select,
  }

  /// Identity of a property or fact.
  variant style-key {
    host(host-fact),
    builtin(builtin-property),
    custom(u32),
  }

  /// Value assigned by a style declaration or read from a resolved property.
  variant style-value {
    flag(bool),
    number(f32),
    length(length),
    color(color),
    keyword(u32),
    text(string),
    /// Read another property's resolved value on the same node.
    use-prop(style-key),
    /// Read a fact's current value on the same node.
    use-fact(style-key),
  }

  /// One property assignment inside a rule or inline declaration list.
  record declaration {
    property: style-key,
    value: style-value,
    /// When true, yields to any ordinary declaration on the node or (for
    /// inheriting properties) on any ancestor; among defaults nearest wins.
    is-default: bool,
  }

  /// Numeric range test on a fact or inherited numeric property.
  record range-test {
    key: style-key,
    min: option<f32>,
    min-inclusive: bool,
    max: option<f32>,
    max-inclusive: bool,
  }

  /// One entry in a flat post-order condition table (`child < parent`).
  variant condition {
    flag(style-key),
    range(range-test),
    under(u32),
    within(u32),
    all(list<u32>),
    any(list<u32>),
    negate(u32),
  }

  /// A conditional (or unconditional when `when` is `none`) set of declarations.
  record rule {
    when: option<u32>,
    then: list<declaration>,
  }

  /// How far a stylesheet attached to a node applies.
  enum reach {
    /// Applies only to the node it is attached to.
    node,
    /// Applies to the subtree rooted at that node, stopping at nested widget
    /// interior boundaries.
    scope,
  }

  /// A standalone reusable stylesheet sent once and attachable to any node.
  record stylesheet-def {
    id: u32,
    conditions: list<condition>,
    rules: list<rule>,
  }

  record condition-update {
    watcher: u32,
    holds: bool,
  }

  record property-update {
    watcher: u32,
    value: option<style-value>,
  }

  variant watcher-update {
    condition(condition-update),
    property(property-update),
    ended(u32),
  }

  /// Return the scene's root logical node ID (creating it on first call).
  root: func() -> u32;

  /// Create a detached logical node owned by the caller's handle.
  create-node: func() -> u32;

  /// Drop a detached logical node handle. Returns whether the tree changed.
  drop-node: func(id: u32) -> bool;

  /// Render `template` with sparse `holes` into logical node `id`.
  render: func(id: u32, template: template-ref, holes: list<hole>);

  /// Resize slot `slot` of `id`'s interior to `count` children and return
  /// their logical node IDs, or `none` if `id` has no such slot.
  content: func(id: u32, slot: u32, count: u32) -> option<list<u32>>;

  /// Replace slot `slot` of `id`'s interior with `children`, in order.
  set-slot: func(id: u32, slot: u32, children: list<u32>) -> bool;

  /// Drain listener IDs whose logical nodes were dropped since the last call.
  take-ended-listeners: func() -> list<u32>;

  /// Register a pointer listener on template position `target` of `id`.
  listen-pointer: func(
    id: u32,
    target: u32,
    listener-id: u32,
    kind: pointer-kind,
    in-scope: scope,
    at: phase,
  ) -> bool;

  /// Register a keyboard listener on template position `target` of `id`.
  listen-keys: func(
    id: u32,
    target: u32,
    listener-id: u32,
    at: phase,
  ) -> bool;

  /// Remove a previously registered pointer or keyboard listener.
  unlisten: func(listener-id: u32);

  /// Query text selection inside template position `target` of `id`.
  selection: func(id: u32, target: u32) -> option<text-selection>;

  /// Set text selection inside template position `target` of `id`.
  select: func(id: u32, target: u32, to: text-selection) -> bool;

  /// Process watched-state notifications from `zenafx:core/render` on the
  /// window thread, recompute resolved styles, and flush ops to the core.
  /// Returns whether any style or layout changed.
  on-core-events: func(events: list<core-event>) -> bool;

  /// Route a pointer input at window `(x, y)` hitting `target` (a render ID)
  /// across the logical tree (slots included) and return listener deliveries.
  route-pointer: func(
    kind: pointer-kind,
    target: option<u32>,
    x: f32,
    y: f32,
    button: u8,
    captured: bool,
  ) -> list<delivery>;

  /// Route a keyboard event along the logical path from root to `focused`.
  route-key: func(focused: option<u32>) -> list<u32>;

  /// Return the render ID associated with `listener-id` for pointer capture.
  capture-target: func(listener-id: u32) -> option<u32>;

  // --------------------------------------------------------------------------
  // Style Engine Operations
  // --------------------------------------------------------------------------

  /// Register a custom property definition and return its unique key ID.
  define-property: func(def: property-def) -> u32;

  /// Register a custom fact definition and return its unique key ID.
  define-fact: func(kind: fact-kind) -> u32;

  /// Register (or replace) a standalone stylesheet by ID.
  define-stylesheet: func(def: stylesheet-def);

  /// Attach stylesheet `stylesheet` to template position `target` of `node`.
  attach-stylesheet: func(node: u32, target: u32, stylesheet: u32, reach: reach) -> bool;

  /// Detach stylesheet `stylesheet` from template position `target` of `node`.
  detach-stylesheet: func(node: u32, target: u32, stylesheet: u32) -> bool;

  /// Set a custom boolean flag fact on template position `target` of `node`.
  set-flag: func(node: u32, target: u32, key: u32, value: bool) -> bool;

  /// Set (or clear when `none`) a custom numeric fact on `target` of `node`.
  set-number: func(node: u32, target: u32, key: u32, value: option<f32>) -> bool;

  /// Replace the inline declarations (`reach: node`) on `target` of `node`.
  set-declarations: func(node: u32, target: u32, decls: list<declaration>) -> bool;

  /// Set the logical widget node that owns `node`'s scope (for content
  /// projected into another widget's slot). Pass `0` to use the parent's scope.
  set-scope-owner: func(node: u32, owner: u32) -> bool;

  /// Read the current resolved value of `key` at `target` of `node`.
  resolved-property: func(node: u32, target: u32, key: style-key) -> option<style-value>;

  /// Watch a condition at `target` of `node`. Returns the initial answer, or
  /// `none` if the target does not exist.
  watch-condition: func(
    node: u32,
    target: u32,
    watcher-id: u32,
    conditions: list<condition>,
    root: u32,
  ) -> option<bool>;

  /// Watch a property's resolved value at `target` of `node`. Returns the
  /// initial value (which may itself be `none` for an unset custom property).
  watch-property: func(
    node: u32,
    target: u32,
    watcher-id: u32,
    key: style-key,
  ) -> option<style-value>;

  /// Remove a previously registered condition or property watcher.
  unwatch: func(watcher-id: u32);

  /// Drain watcher updates queued since the last call.
  take-watcher-updates: func() -> list<watcher-update>;
}

world platform {
  import zenafx:core/render@0.1.0;

  export runtime;
}
