{
  "name": "@zena-lang/zenafx",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "test:gui": "wireit",
    "zfx": "wireit"
  },
  "wireit": {
    "zfx": {
      "command": "../../target/release/zfx",
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "command": "cargo build --release -p zenafx",
      "files": [
        "Cargo.toml",
        "src/**/*.rs",
        "../zena-runtime/Cargo.toml",
        "../zena-runtime/src/**/*.rs",
        "../../Cargo.toml",
        "../../Cargo.lock"
      ],
      "output": [],
      "dependencies": []
    },
    "test": {
      "command": "cargo test --release -p zenafx",
      "files": [
        "Cargo.toml",
        "src/**/*.rs",
        "tests/**/*.rs",
        "fixtures/**/*",
        "../zena-runtime/Cargo.toml",
        "../zena-runtime/src/**/*.rs",
        "../../Cargo.toml",
        "../../Cargo.lock"
      ],
      "output": [],
      "dependencies": [
        "build"
      ]
    },
    "test:gui": {
      "command": "cargo test --release -p zenafx -- --ignored",
      "files": [
        "Cargo.toml",
        "src/**/*.rs",
        "tests/**/*.rs",
        "fixtures/**/*",
        "../zena-runtime/Cargo.toml",
        "../zena-runtime/src/**/*.rs",
        "../../Cargo.toml",
        "../../Cargo.lock"
      ],
      "output": [],
      "dependencies": [
        "build"
      ]
    }
  }
}
