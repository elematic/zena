{
  "name": "@zena-lang/zenafx",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "test:gui": "wireit",
    "zfx": "wireit",
    "build:example": "wireit"
  },
  "wireit": {
    "zfx": {
      "command": "../../target/release/zfx",
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "command": "cargo build --release -p zenafx",
      "files": [
        "Cargo.toml",
        "src/**/*.rs",
        "../zena-runtime/Cargo.toml",
        "../zena-runtime/src/**/*.rs",
        "../../Cargo.toml",
        "../../Cargo.lock"
      ],
      "output": [],
      "dependencies": []
    },
    "test": {
      "command": "cargo test --release -p zenafx",
      "files": [
        "Cargo.toml",
        "src/**/*.rs",
        "tests/**/*.rs",
        "fixtures/**/*",
        "../zena-runtime/Cargo.toml",
        "../zena-runtime/src/**/*.rs",
        "../../Cargo.toml",
        "../../Cargo.lock",
        "out/hello.wasm"
      ],
      "output": [],
      "dependencies": [
        "build",
        "build:example"
      ]
    },
    "test:gui": {
      "command": "cargo test --release -p zenafx -- --ignored",
      "files": [
        "Cargo.toml",
        "src/**/*.rs",
        "tests/**/*.rs",
        "fixtures/**/*",
        "../zena-runtime/Cargo.toml",
        "../zena-runtime/src/**/*.rs",
        "../../Cargo.toml",
        "../../Cargo.lock",
        "out/hello.wasm"
      ],
      "output": [],
      "dependencies": [
        "build",
        "build:example"
      ]
    },
    "build:example": {
      "#": "The hello-world application component. `cargo test` loads it as a fixture and `zfx --app` runs it, so both go through this.",
      "command": "mkdir -p out && cd ../.. && ./target/release/zena-cli build examples/zenafx/hello.zena -o packages/zenafx/out/hello.wasm --target component --wit examples/zenafx/hello.wit --world app",
      "files": [
        "../../examples/zenafx/hello.zena",
        "../../examples/zenafx/hello.wit",
        "wit/*.wit",
        "../../zena-packages.json"
      ],
      "output": [
        "out/hello.wasm"
      ],
      "dependencies": [
        "../zena-cli:build"
      ]
    }
  }
}
