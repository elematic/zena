{
  "name": "@zena-lang/zenafx",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "wireit",
    "build:cargo": "wireit",
    "test": "wireit",
    "test:gui": "wireit",
    "zfx": "wireit",
    "build:example": "wireit"
  },
  "wireit": {
    "zfx": {
      "command": "../../target/release/zfx",
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "#": "Split the way packages/zena-cli's build:host is, and for the same reasons.",
      "files": [
        "../../target/release/zfx"
      ],
      "dependencies": [
        {
          "script": "build:cargo",
          "cascade": false
        }
      ]
    },
    "build:cargo": {
      "#": "Always runs; `build` is what dependents read.",
      "command": "cargo build --release -p zenafx",
      "output": [],
      "dependencies": []
    },
    "test": {
      "command": "cargo test --release -p zenafx",
      "files": [
        "Cargo.toml",
        "src/**/*.rs",
        "tests/**/*.rs",
        "fixtures/**/*",
        "../zena-runtime/Cargo.toml",
        "../zena-runtime/src/**/*.rs",
        "../../Cargo.toml",
        "../../Cargo.lock",
        "out/*.wasm"
      ],
      "output": [],
      "dependencies": [
        "build",
        "build:example"
      ]
    },
    "test:gui": {
      "command": "cargo test --release -p zenafx -- --ignored",
      "files": [
        "Cargo.toml",
        "src/**/*.rs",
        "tests/**/*.rs",
        "fixtures/**/*",
        "../zena-runtime/Cargo.toml",
        "../zena-runtime/src/**/*.rs",
        "../../Cargo.toml",
        "../../Cargo.lock",
        "out/*.wasm"
      ],
      "output": [],
      "dependencies": [
        "build",
        "build:example"
      ]
    },
    "build:example": {
      "#": "The example component. `cargo test` loads it as a fixture and `zfx --app` runs it.",
      "command": "mkdir -p out && cd ../.. && ./target/release/zena-cli build examples/zenafx/widgets/main.zena -o packages/zenafx/out/widgets.wasm --target component --wit examples/zenafx/widgets.wit --world app",
      "files": [
        "../../examples/zenafx/**/*.zena",
        "../../examples/zenafx/**/*.wit",
        "wit/*.wit",
        "../../zena-packages.json"
      ],
      "output": [
        "out/*.wasm"
      ],
      "dependencies": [
        "../zena-cli:build"
      ]
    }
  }
}
