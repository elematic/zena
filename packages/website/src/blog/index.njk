---
layout: base.njk
title: Blog
description: Updates, announcements, and deep dives from the Zena project.
---

<div class="site-content" id="site-content">
  <div class="blog-index">
    <div class="blog-index-container">
      <header class="blog-index-header">
        <div class="blog-index-header-row">
          <h1 class="blog-index-title">The Zena Blog</h1>
          <a
            href="/blog/feed.xml"
            class="blog-feed-link"
            title="Subscribe via RSS / Atom feed"
            aria-label="Subscribe via RSS / Atom feed"
          >
            <svg
              class="blog-feed-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 11a9 9 0 0 1 9 9" />
              <path d="M4 4a16 16 0 0 1 16 16" />
              <circle cx="5" cy="19" r="1" />
            </svg>
            <span>RSS Feed</span>
          </a>
        </div>
        <p class="blog-index-tagline">
          Updates, design deep dives, and announcements from the Zena programming language project.
        </p>
      </header>

      {% if collections.posts.length > 0 %}
        <div class="blog-grid">
          {% for post in collections.posts %}
            {% set authorId = post.data.author or 'justinfagnani' %}
            {% set authorData = authors[authorId] %}
            {% set heroImage = post.data.hero.image if post.data.hero and post.data.hero.image else post.data.hero %}
            {% set heroAlt = post.data.hero.alt if post.data.hero and post.data.hero.alt else post.data.title %}

            <article class="blog-card">
              <a href="{{ post.url }}" class="blog-card-link" aria-label="{{ post.data.title }}">
                {% if heroImage %}
                  <div class="blog-card-image-wrap">
                    <img
                      src="{{ heroImage }}"
                      alt="{{ heroAlt }}"
                      class="blog-card-image"
                      loading="lazy"
                    />
                  </div>
                {% endif %}

                <div class="blog-card-body">
                  <div class="blog-card-meta">
                    <time datetime="{{ post.date | isoDate }}">{{ post.date | date }}</time>
                    <span class="blog-card-dot" aria-hidden="true">·</span>
                    <span>{{ post.content | readingTime }}</span>
                  </div>

                  <h2 class="blog-card-title">{{ post.data.title }}</h2>

                  {% if post.data.description %}
                    <p class="blog-card-description">{{ post.data.description }}</p>
                  {% endif %}

                  {% if authorData %}
                    <div class="blog-card-author">
                      {% if authorData.avatar %}
                        <img
                          class="blog-card-author-avatar"
                          src="{{ authorData.avatar }}"
                          alt="{{ authorData.name }}"
                          width="32"
                          height="32"
                          loading="lazy"
                        />
                      {% endif %}
                      <span class="blog-card-author-name">{{ authorData.name }}</span>
                    </div>
                  {% endif %}
                </div>
              </a>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="blog-empty">
          <p>No blog posts published yet. Stay tuned!</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>

