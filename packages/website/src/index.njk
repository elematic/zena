      <div class="code-snippet-wrapper" id="snippet-functions">
        {% highlight "ts" %}
// Arrow syntax only. Parameters can have default values.
let greet = (name: String, prefix: String = "Hello") => {
  return `${prefix}, ${name}`;
};

// Closures can be contextually typed without parameter annotations
let names = ["Alice", "Bob", "Charlie"];
let upper = names.map(n => n.toUpperCase());
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-primitives">
        {% highlight "ts" %}
// Primitives map directly to native WASM types (no boxed numbers)
let count: i32 = 42;
let factor: f64 = 3.14159;

// FixedArray<T> is a fixed-size array backed directly by a WASM GC array
let nums: FixedArray<i32> = [10, 20, 30];
let first = nums[0]; // 10
nums[1] = 99; // mutate in place

// Array<T> is a growable array wrapper
let dynamic = Array.from([1, 2, 3]);
dynamic.push(4);
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-records">
        {% highlight "ts" %}
// Records have fixed structural shapes. Destructure them:
let { x, y } = { x: 10.0, y: 20.0 };

// Functions can return inline (unboxed) tuples. Destructure the call:
let getCoordinates = (): inline (f64, f64) => inline (37.77, -122.41);
let (lat, lng) = getCoordinates();

// Maps are dynamic. Map.get() returns a tuple (value, found).
let scores = {"Alice" => 95, "Bob" => 87};
if (let (score, true) = scores.get("Alice")) {
  console.log(`Alice scored: ${score}`);
}
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-classes">
        {% highlight "ts" %}
// Fields are immutable by default. Use 'var' to make them mutable.
class Cat implements Animal {
  id: String;                  // Public immutable field (default)
  #greeting = "Meow";          // Private immutable field
  var name = "Bob";            // Public mutable field
  var(#mood) mood = "grumpy";  // Public getter, private setter

  // Constructor with 'this.' params, initializer list, and body
  new(this.id, name) : name = name {
    console.log(`Created cat: ${this.name}`);
  }

  sayHi() {
    return `${this.#greeting}, I'm ${this.name}`;
  }
}
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-mixins">
        {% highlight "ts" %}
interface Animal {
  speak(): void;
}

mixin Friendly {
  greet(name: String): void {
    console.log(`Hello, ${name}!`);
  }
}

// Mixins restrict targets using 'on'. Classes can implement interfaces.
mixin ExtraUtilities<T> on Iterable<T> {
  printAll(): void {
    for (let item in this) {
      console.log(item.toString());
    }
  }
}

class Dog with Friendly implements Animal {
  speak(): void {
    console.log("Woof");
  }
}
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-pattern-matching">
        {% highlight "ts" %}
// Exhaustive match() expressions and conditions (if let / while let)
let describe = (shape: Shape): String => match (shape) {
  case Circle { radius } if radius > 10.0: "Large circle"
  case Circle { radius }: "Small circle"
  case Rectangle { width, height }: "Rectangle"
  case _: "Unknown shape" // Wildcard/fallthrough fallback
};

// Patterns in conditional blocks and loops
if (let Some { value } = maybeVal) {
  console.log(`Found value: ${value}`);
}

// Pattern matching in for-let loops
for (let {x, y} in points) {
  console.log(`Coordinates: ${x}, ${y}`);
}

// Pattern matching in while-let loops
while (let (true, item) = iterator.next()) {
  console.log(`Item: ${item}`);
}
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-expression-oriented">
        {% highlight "ts" %}
// Control flow constructs (if, try/catch, match) and throw are expressions
let result = if (success) "Completed" else throw new Error("Failed");

let value = try {
  parseJson(input)
} catch (e) {
  defaultConfig
};
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-extension-classes">
        {% highlight "ts" %}
// Add methods to types. Resolved based on the extension class static type.
extension class IntExtensions on i32 {
  isEven(): boolean {
    return this % 2 == 0;
  }
}

let checkEven = (val: IntExtensions): boolean => {
  return val.isEven(); // Extension method resolved on static IntExtensions type
};
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-modules">
        {% highlight "ts" %}
// Standard ES6 import/from syntax
import { Map, Set } from 'zena:collections';

// Python-style from/import syntax is also natively supported
from 'zena:math' import { min, max };

// Export variables, functions, or classes
export let pi = 3.14159;
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-types">
        {% highlight "ts" %}
// Type aliases define lightweight structural shapes
type Point = (f64, f64); // Tuple type
type Config = { host: String, port: i32 }; // Record type
type Status = "success" | "failure"; // Union type

// Distinct types define unique nominal type wrappers
distinct type UserId = i32;

let id: UserId = 123 as UserId; // Must use explicit 'as' cast
// let invalid: UserId = 123;   // Error: i32 is not assignable to UserId
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-enums">
        {% highlight "ts" %}
// Enums define nominal wrapper types (backed by integers or strings)
enum Color {
  Red,
  Green,
  Blue
}

let color: Color = Color.Red;
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-sealed-classes">
        {% highlight "ts" %}
// Sealed classes are like enums with state and methods. They are exhaustive in matches.
sealed class Expr {
  case Lit(value: i32)
  case Add(left: Expr, right: Expr)
}

let eval = (e: Expr): i32 => match (e) {
  case Lit { value }: value
  case Add { left, right }: eval(left) + eval(right)
};
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-pipelines">
        {% highlight "ts" %}
// Pipelines chain operations cleanly with placeholder syntax
let cleanTitle = (input: String) => input
  |> trim($)
  |> titleCase($)
  |> truncate($, 80);
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-regex">
        {% highlight "ts" %}
// Import regex template literal tag from standard library
import { regex } from "zena:regex";

let pattern = regex`^[a-z]+$`;
let isMatch = pattern.test("hello");
        {% endhighlight %}
      </div>

      <div class="code-snippet-wrapper hidden" id="snippet-loops">
        {% highlight "ts" %}
// Loop over arrays, lists, or any Iterable
let items = [10, 20, 30];
for (let item in items) {
  console.log(`Item: ${item}`);
}

// Iterator.next() returns inline (boolean, T) indicating (found, value)
let iterator = items.iterator();
while (let (true, item) = iterator.next()) {
  console.log(`Item: ${item}`);
}
        {% endhighlight %}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.feature-tab');
    const filenameEl = document.getElementById('code-filename');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        // Deactivate current tab
        document.querySelector('.feature-tab.active').classList.remove('active');
        // Activate clicked tab
        tab.classList.add('active');

        // Hide all snippet wrappers
        document.querySelectorAll('.code-snippet-wrapper').forEach(wrapper => {
          wrapper.classList.add('hidden');
        });

        // Show clicked snippet wrapper
        const feature = tab.getAttribute('data-feature');
        const targetWrapper = document.getElementById(`snippet-${feature}`);
        if (targetWrapper) {
          targetWrapper.classList.remove('hidden');
        }

        // Update filename
        filenameEl.textContent = `${feature.replace('-', '_')}.zena`;
      });
    });
  });
</script>

