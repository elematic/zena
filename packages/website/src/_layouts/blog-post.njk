---
layout: base.njk
---

<zena-code-copy class="site-content" id="site-content">
  <article class="blog-post">
    <div class="blog-post-container">
      <nav class="blog-post-nav" aria-label="Blog breadcrumb">
        <a href="/blog/" class="blog-back-link">
          <span class="blog-back-arrow" aria-hidden="true">←</span>
          <span>Back to Blog</span>
        </a>
      </nav>

      <main class="main">
        <header class="blog-post-header">
        <h1 class="blog-post-title">{{ title }}</h1>
        {% if description %}
          <p class="blog-post-lead">{{ description }}</p>
        {% endif %}

        {% set authorId = author or 'justinfagnani' %}
        {% set authorData = authors[authorId] %}
        <div class="blog-post-meta">
          {% if authorData %}
            <div class="blog-post-author">
              {% if authorData.avatar %}
                <img
                  class="blog-post-author-avatar"
                  src="{{ authorData.avatar }}"
                  alt="{{ authorData.name }}"
                  width="44"
                  height="44"
                  loading="lazy"
                />
              {% endif %}
              <div class="blog-post-author-details">
                <span class="blog-post-author-name">
                  {% if authorData.url %}
                    <a href="{{ authorData.url }}" target="_blank" rel="noopener">{{ authorData.name }}</a>
                  {% else %}
                    {{ authorData.name }}
                  {% endif %}
                </span>
                <div class="blog-post-time-row">
                  <time datetime="{{ page.date | isoDate }}">{{ page.date | date }}</time>
                  <span class="blog-post-dot" aria-hidden="true">·</span>
                  <span>{{ content | readingTime }}</span>
                </div>
              </div>
            </div>
          {% else %}
            <div class="blog-post-time-row">
              <time datetime="{{ page.date | isoDate }}">{{ page.date | date }}</time>
              <span class="blog-post-dot" aria-hidden="true">·</span>
              <span>{{ content | readingTime }}</span>
            </div>
          {% endif %}
        </div>

        {% set heroImage = hero.image if hero and hero.image else hero %}
        {% set heroAlt = hero.alt if hero and hero.alt else title %}
        {% set heroCredit = hero.credit if hero and hero.credit else heroCredit %}
        {% if heroImage %}
          <figure class="blog-post-hero">
            <img
              src="{{ heroImage }}"
              alt="{{ heroAlt }}"
              class="blog-post-hero-image"
              loading="eager"
            />
            {% if heroCredit %}
              <figcaption class="blog-post-hero-caption">{{ heroCredit }}</figcaption>
            {% endif %}
          </figure>
        {% endif %}
      </header>

      <div class="prose blog-post-prose">
        {{ content | safe }}
      </div>
      </main>

      <footer class="blog-post-footer">
        <a href="/blog/" class="blog-post-footer-back">
          <span class="blog-back-arrow" aria-hidden="true">←</span>
          <span>Back to all posts</span>
        </a>
      </footer>
    </div>
  </article>
</zena-code-copy>
