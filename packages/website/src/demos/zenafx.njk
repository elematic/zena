---
title: 'ZenaFX Web Demo'
layout: playground.njk
permalink: '/demos/zenafx/'
description: 'Interactive ZenaFX GUI runtime running unmodified WebAssembly components on Canvas 2D and WebGPU.'
---

<style>
  .zenafx-demo {
    flex: 1;
    min-height: 0;
    width: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: var(--rad-surface-inset);
    color: var(--rad-neutral-text-normal);
  }
  .zenafx-toolbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 10px 18px;
    background: var(--rad-surface-chrome);
    border-bottom: 1px solid var(--rad-neutral-stroke-faint);
  }
  .zenafx-brand {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: -0.01em;
    color: var(--rad-neutral-text-emphasis);
    margin-right: 6px;
  }
  .zenafx-brand span {
    color: var(--zena-c-brand-2);
  }
  .zenafx-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .zenafx-demo button,
  .zenafx-file-btn,
  .zenafx-demo select {
    font: inherit;
    font-size: 13px;
    line-height: 1.2;
    padding: 6px 12px;
    border-radius: 7px;
    border: 1px solid var(--rad-neutral-stroke-subtle);
    background: var(--rad-surface-raised);
    color: var(--rad-neutral-text-emphasis);
    cursor: pointer;
  }
  .zenafx-demo button:hover,
  .zenafx-file-btn:hover {
    border-color: var(--zena-c-brand-2);
  }
  .zenafx-demo button.active {
    background: var(--zena-c-brand-3);
    border-color: var(--zena-c-brand-3);
    color: #fff;
    font-weight: 600;
  }
  .zenafx-file-btn input {
    display: none;
  }
  .zenafx-spacer {
    flex: 1;
  }
  .zenafx-presenter-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--rad-neutral-text-muted);
  }
  .zenafx-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: 20px;
    overflow: hidden;
  }
  .zenafx-viewport-frame {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 1000px;
    max-height: 700px;
    resize: both;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--rad-neutral-stroke-subtle);
    background: #ffffff;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.22);
  }
  .zenafx-viewport-frame canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }
  .zenafx-status-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 17, 23, 0.78);
    color: #fff;
    font-size: 14px;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .zenafx-status-overlay.hidden {
    opacity: 0;
  }
  .zenafx-stats {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding: 9px 18px;
    background: var(--rad-surface-chrome);
    border-top: 1px solid var(--rad-neutral-stroke-faint);
    font-size: 12px;
    color: var(--rad-neutral-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .zenafx-stat strong {
    color: var(--rad-neutral-text-emphasis);
    font-weight: 600;
  }
</style>

<div class="zenafx-demo">
  <div class="zenafx-toolbar">
    <div class="zenafx-brand">Zena<span>FX</span> Web</div>
    <div class="zenafx-controls" id="zenafx-demo-buttons">
      <button type="button" data-demo="button" class="active">Button</button>
      <button type="button" data-demo="widgets">Widgets</button>
      <button type="button" data-demo="counter">Counter</button>
      <button type="button" data-demo="scroll">Scroll</button>
      <button type="button" data-demo="split">Split</button>
      <button type="button" data-demo="cursors">Cursors</button>
      <button type="button" data-demo="disclosure">Disclosure</button>
      <button type="button" data-demo="input">Input</button>
      <button type="button" data-demo="selection">Selection</button>
      <button type="button" data-demo="hello">Hello (Rust)</button>
    </div>
    <label class="zenafx-file-btn">
      Load .wasm…
      <input id="zenafx-file-input" type="file" accept=".wasm" />
    </label>
    <div class="zenafx-spacer"></div>
    <label class="zenafx-presenter-label">
      Presenter:
      <select id="zenafx-backend-select">
        <option value="canvas2d">Canvas 2D</option>
        <option value="webgpu">WebGPU</option>
      </select>
    </label>
  </div>

  <div class="zenafx-stage">
    <div class="zenafx-viewport-frame">
      <canvas id="zenafx-canvas"></canvas>
      <div class="zenafx-status-overlay" id="zenafx-status">
        Loading ZenaFX engine…
      </div>
    </div>
  </div>

  <div class="zenafx-stats">
    <div class="zenafx-stat">Demo: <strong id="zenafx-stat-demo">—</strong></div>
    <div class="zenafx-stat">
      Frames: <strong id="zenafx-stat-frames">0</strong>
    </div>
    <div class="zenafx-stat">
      Solves: <strong id="zenafx-stat-solves">0</strong>
    </div>
    <div class="zenafx-stat">
      Guest entries: <strong id="zenafx-stat-entries">0</strong>
    </div>
    <div class="zenafx-stat">
      Events: <strong id="zenafx-stat-events">0</strong>
    </div>
    <div class="zenafx-stat">
      Frame: <strong id="zenafx-stat-ms">—</strong>
    </div>
    <div class="zenafx-stat">
      Backend: <strong id="zenafx-stat-backend">—</strong>
    </div>
    <div class="zenafx-stat">
      Engine: <strong id="zenafx-stat-engine-size">—</strong>
    </div>
    <div class="zenafx-stat">
      Component: <strong id="zenafx-stat-comp-size">—</strong>
    </div>
  </div>
</div>

<script type="module" src="/demos/zenafx/demo.js"></script>
