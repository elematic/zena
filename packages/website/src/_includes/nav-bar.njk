{#
  Top navigation. Mirrors VitePress's nav / nav-bar / nav-screen markup so
  the ported CSS applies unchanged; `zena-layout` drives the mobile screen.
#}
{% set isHome = page.url == "/" %}

<header class="site-nav">
  <div
    class="nav-bar{% if hasSidebar %} has-sidebar{% endif %}{% if isHome %} home top{% endif %}"
  >
    <div class="wrapper">
      <div class="container">
        <div class="title">
          <div
            class="nav-bar-title{% if hasSidebar %} has-sidebar{% endif %}"
          >
            <a class="title" href="/">
              <img class="logo" src="/logo.svg" alt="" width="24" height="24" />
              <span>{{ site.title }}</span>
            </a>
          </div>
        </div>

        <div class="content">
          <div class="content-body">
            <zena-search class="nav-bar-search search"></zena-search>

            <nav class="nav-bar-menu menu" aria-labelledby="main-nav-aria-label">
              <span id="main-nav-aria-label" class="visually-hidden">
                Main Navigation
              </span>
              {% for item in nav %}
                <a
                  class="nav-bar-menu-link{% if page.url | isActive(item.link, item.match) %} active{% endif %}"
                  href="{{ item.link }}"
                >
                  <span>{{ item.text }}</span>
                </a>
              {% endfor %}
            </nav>

            <div class="nav-bar-appearance appearance">
              <zena-appearance></zena-appearance>
            </div>

            <div class="social-links nav-bar-social-links social-links">
              <a
                class="social-link no-icon"
                href="{{ site.repo }}"
                aria-label="Zena on GitHub"
                target="_blank"
                rel="noopener"
              >
                {% include "icon-github.njk" %}
              </a>
            </div>

            <button
              type="button"
              class="nav-bar-hamburger hamburger"
              aria-label="Toggle navigation"
              aria-expanded="false"
              aria-controls="nav-screen"
              data-toggle-nav-screen
            >
              <span class="container">
                <span class="top"></span>
                <span class="middle"></span>
                <span class="bottom"></span>
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="divider"><div class="divider-line"></div></div>
  </div>

  <div class="nav-screen" id="nav-screen">
    <div class="container">
      <nav class="nav-screen-menu menu">
        {% for item in nav %}
          <a class="nav-screen-menu-link" href="{{ item.link }}">
            <span>{{ item.text }}</span>
          </a>
        {% endfor %}
        <a class="nav-screen-menu-link" href="{{ site.repo }}">
          <span>GitHub</span>
        </a>
      </nav>

      <div class="nav-screen-appearance appearance">
        <p class="text">Appearance</p>
        <zena-appearance></zena-appearance>
      </div>
    </div>
  </div>
</header>
