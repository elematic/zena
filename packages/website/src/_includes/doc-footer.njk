{# Edit link plus the prev/next pager, driven by the sidebar order. #}
{% set editPath = page.inputPath | replace("./src/", "") %}

<footer class="doc-footer">
  <div class="edit-info">
    <div class="edit-link">
      <a
        class="edit-link-button link"
        href="{{ site.editLinkPattern | replace(':path', editPath) }}"
        target="_blank"
        rel="noreferrer"
      >
        <span class="icon-square-pen edit-link-icon"></span>
        Edit this page on GitHub
      </a>
    </div>
  </div>

  {% if pager.prev or pager.next %}
    <nav class="prev-next" aria-labelledby="doc-footer-aria-label">
      <span class="visually-hidden" id="doc-footer-aria-label">Pager</span>
      <div class="pager">
        {% if pager.prev %}
          <a class="pager-link prev" href="{{ pager.prev.link }}">
            <span class="desc">Previous page</span>
            <span class="title">{{ pager.prev.text }}</span>
          </a>
        {% endif %}
      </div>
      <div class="pager">
        {% if pager.next %}
          <a class="pager-link next" href="{{ pager.next.link }}">
            <span class="desc">Next page</span>
            <span class="title">{{ pager.next.text }}</span>
          </a>
        {% endif %}
      </div>
    </nav>
  {% endif %}
</footer>
