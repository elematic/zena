{#
  Shared markup for the "On this page" list: used by both the right-hand rail
  and the mobile dropdown.
#}
{% macro outlineList(headings, root) %}
  <ul class="doc-outline-item {{ "root" if root else "nested" }}">
    {% for heading in headings %}
      <li>
        <a class="outline-link" href="#{{ heading.id }}" title="{{ heading.title }}">
          {{- heading.title -}}
        </a>
        {% if heading.children.length %}
          {{ outlineList(heading.children, false) }}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}
