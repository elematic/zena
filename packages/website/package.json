{
  "name": "@zena-lang/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wireit",
    "serve": "wireit"
  },
  "wireit": {
    "build": {
      "command": "eleventy",
      "dependencies": [
        "../website-client:build",
        "../language-service:build"
      ],
      "files": [
        "src/**/*",
        "eleventy.config.js",
        "../website-client/lib/**/*",
        "../language-service/lsp.wasm"
      ],
      "output": [
        "_site/**/*"
      ]
    },
    "serve": {
      "command": "node server.js",
      "dependencies": [
        "build"
      ],
      "service": {
        "readyWhen": {
          "lineMatches": "server running"
        }
      }
    }
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@zipadee/javascript": "^0.0.24",
    "zipadee": "^0.0.22"
  },
  "dependencies": {
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@zena-lang/website-client": "*"
  }
}
