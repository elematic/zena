{
  "name": "@zena-lang/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wireit",
    "serve": "wireit",
    "scaffold": "node scripts/scaffold-docs.js && node scripts/print-outline.js",
    "outline": "node scripts/print-outline.js"
  },
  "wireit": {
    "build": {
      "command": "eleventy",
      "dependencies": [
        "../website-client:build",
        "../language-service:build"
      ],
      "files": [
        "src/**/*",
        "lib/**/*.js",
        "eleventy.config.js",
        "../website-client/src/**/*.ts",
        "../website-client/src/**/*.json",
        "../language-service/lsp.wasm",
        "../vscode-zena/syntaxes/zena.tmLanguage.json"
      ],
      "output": [
        "_site/**/*"
      ]
    },
    "serve": {
      "command": "node server.js",
      "dependencies": [
        "build"
      ],
      "service": {
        "readyWhen": {
          "lineMatches": "server running"
        }
      }
    }
  },
  "dependencies": {
    "@zena-lang/website-client": "*"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@zipadee/javascript": "^0.0.24",
    "esbuild": "^0.25.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-container": "^4.0.0",
    "shiki": "^3.0.0",
    "zipadee": "^0.0.22"
  }
}
