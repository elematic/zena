/**
 * An App View to try `zena` against on this machine. Nothing it makes
 * reaches the public PLC directory or real DNS, but real accounts resolve,
 * so a person can sign in to its pages and `zena` as themselves. It
 * starts:
 *
 * - a stand-in PLC directory, which records the demo's DIDs and reads
 *   every other DID from `plc.directory`, and the PDS of a maintainer,
 *   with an app password (`package-manager/testing/fake-pds`), on the
 *   port after the App View's (`PORT`, 2583 by default);
 * - the App View for `pkg.test`, built from the environment as
 *   `main.zena` builds it, so `PDS_STORAGE=firestore` and the rest work
 *   here too, with the Firestore emulator. Its handle records are in
 *   memory;
 * - a DNS-over-HTTPS resolver that answers from those records, and asks
 *   `APP_VIEW_DNS_OVER_HTTPS` (Cloudflare's, by default) about every other
 *   name, so handles on a person's own domain resolve, on the port after
 *   that.
 *
 * Fixed ports keep the variables it prints right from one start to the
 * next.
 *
 * `npm run demo` builds the web app (`packages/pds-web`) and gives it to
 * the demo as the directory `/web` (`--dir packages/pds-web/out::/web`,
 * `APP_VIEW_WEB_DIR=/web`), which the App View serves at its origin. It
 * gives it `.zena/demo` in the repository as `/demo`, and the repository's
 * path as `DEMO_REPO`.
 *
 * Then it writes the environment `zena` needs to `/demo/env.sh`, signs in
 * and publishes the packages `DEMO_PUBLISH` names, and prints the commands
 * of a first publish. Run from the repository root with
 * `npm run demo -w @zena-lang/registry`, or `npm run demo:publish` to have
 * the scope `zena-lang` and the repository's packages in it, and stop it
 * with Ctrl-C; everything in memory is gone then.
 */

import {Future} from 'zena:async';
import {HashMap} from 'zena:collections';
import {dedent, join} from 'zena:core';
import {exit, getEnv} from 'zena:cli';
import {mkdir, readFile, writeFile} from 'zena:fs';
import {Server} from 'zena:http';
import {JsonObject, parseJson} from 'zena:json';
import {runWith} from 'zena:process';
import {FakePds} from 'package-manager/testing/fake-pds';
import {MemoryHandleRecords, dnsOverHttpsApp, dnsOverHttpsUpstream} from 'registry/handles';
import {readPort} from 'pds/service';
import {configFromEnv, serve} from 'registry/service';
import {AppView, AppViewError} from 'registry/app-view';
import {nowMicros} from 'pds/xrpc/common';

let MAINTAINER = 'did:plc:maintainermaintainermain';
let PASSWORD = 'demo-app-password';

/** `.zena/demo` in the repository, as this program sees it. */
let STATE = '/demo';

/**
 * Runs this checkout's `zena` against the demo, with the environment
 * `/demo/env.sh` sets: the demo's PLC directory, resolver and registry,
 * and the sign-in kept in `.zena/demo/config`.
 */
final class DemoZena {
  /** The repository's path on this machine. */
  repo: String;
  /** The variables `zena` needs, as name and value. */
  env: Array<(String, String)>;

  new(repo: String, plc: String, dns: String, registry: String) : repo = repo, env = [
    ('ZENA_PLC_DIRECTORY', plc),
    ('ZENA_DNS_OVER_HTTPS', dns),
    ('ZENA_REGISTRY', registry),
    ('ZENA_CONFIG_DIR', `${repo}/.zena/demo/config`),
  ];

  /** The commands `/demo/env.sh` holds, to `source` in a shell. */
  script(): String {
    var text = '# The environment `zena` uses the demo with (packages/registry/dev/demo.zena).\n';
    for (let (name, value) in this.env) {
      text = `${text}export ${name}='${value}'\n`;
    }
    // A CI token would publish as its automation account, not as the
    // maintainer signed in here.
    return `${text}unset ZENA_REGISTRY_TOKEN\nalias zena='${this.repo}/target/release/zena-cli'\n`;
  }

  /**
   * Runs `zena` with `args` in `cwd`, a directory under `/demo`, with the
   * variables `extra` as well, printing what it prints. Returns whether it
   * succeeded.
   */
  async run(args: Array<String>, cwd: String, extra: Array<(String, String)> = []): Future<boolean> {
    let argv = new GrowableArray<String>();
    argv.push(`${this.repo}/target/release/zena-cli`);
    for (let arg in args) {
      argv.push(arg);
    }
    let env = new GrowableArray<(String, String)>();
    for (let pair in this.env) {
      env.push(pair);
    }
    for (let pair in extra) {
      env.push(pair);
    }
    let where = if (cwd == STATE) '' else ` (in .zena${cwd})`;
    console.log(`\n==> zena ${join(args, ' ')}${where}`);
    let result = await runWith(argv,
        {cwd: cwd, env: env, envRemove: ['ZENA_REGISTRY_TOKEN', 'ZENA_APP_PASSWORD'], inheritStdio: true});
    return result.succeeded();
  }

  /** Runs a command other than `zena`, printing what it prints. Returns whether it succeeded. */
  async shell(argv: Array<String>): Future<boolean> {
    return (await runWith(argv, {inheritStdio: true})).succeeded();
  }
}

/**
 * Signs in as the demo's maintainer and publishes the packages `dirs`
 * names, directories of the repository separated by spaces
 * (`DEMO_PUBLISH`), in order, with `zena pkg publish` as a person would.
 * Each is published from a fresh copy in `.zena/demo/packages`, since
 * publishing writes the new package's DID into its manifest, and the
 * repository's manifest must not name a DID that is gone when the demo
 * stops. Their scopes must exist, as `DEMO_SCOPES` makes them. Stops at
 * the first that fails; returns the directories it published.
 */
async function publishPackages(zena: DemoZena, dirs: String): Future<Array<String>> {
  let published = new GrowableArray<String>();
  let copies = `${zena.repo}/.zena/demo/packages`;
  if (!(await zena.shell(['rm', '-rf', copies]))) {
    return published;
  }
  await mkdir(`${STATE}/packages`);
  if (!(await zena.run(['pkg', 'login', MAINTAINER], STATE, [('ZENA_APP_PASSWORD', PASSWORD)]))) {
    return published;
  }
  for (let dir in dirs.split(' ')) {
    if (dir == '') {
      continue;
    }
    let parts = dir.split('/');
    let name = parts[parts.length - 1];
    if (dir.startsWith('/') || name == '' || dir.contains('..')) {
      console.error(`DEMO_PUBLISH: '${dir}' is not a directory of the repository, such as packages/wit-parser`);
      return published;
    }
    if (!(await zena.shell(['cp', '-R', `${zena.repo}/${dir}`, `${copies}/${name}`]))) {
      return published;
    }
    if (!(await zena.run(['pkg', 'publish', '--yes'], `${STATE}/packages/${name}`))) {
      console.error(`DEMO_PUBLISH: publishing ${dir} failed, above; the demo goes on without it.`);
      return published;
    }
    published.push(dir);
  }
  return published;
}

/**
 * Creates the scopes `pairs` names, `<scope>=<owner's DID or handle>`
 * separated by spaces (`DEMO_SCOPES`), as the operator's
 * `main.zena create-scope` would. That command acts on a server's store,
 * which for the demo is in this process, and only it takes a name the App
 * View reserves, such as `zena`.
 */
async function createScopes(appView: AppView, pairs: String): Future<void> {
  for (let pair in pairs.split(' ')) {
    if (pair == '') {
      continue;
    }
    let parts = pair.split('=');
    if (parts.length != 2 || parts[0] == '' || parts[1] == '') {
      console.error(`DEMO_SCOPES: '${pair}' is not <scope>=<owner's DID or handle>`);
      continue;
    }
    let owner = if (parts[1].startsWith('did:')) parts[1] else await appView.resolveHandle(parts[1]);
    if (owner == null) {
      console.error(`DEMO_SCOPES: ${parts[1]} does not resolve to a DID`);
      continue;
    }
    try {
      let created = await appView.createScopeAsOperator(owner, parts[0], [], nowMicros());
      console.log(`Created the scope ${created.handle}, owned by ${owner}.`);
    } catch (e) {
      if (e is AppViewError) {
        console.error(`DEMO_SCOPES: ${parts[0]}: ${e.message}`);
        continue;
      }
      throw e;
    }
  }
}

export async function main(): Future<void> {
  // The stand-ins listen on the two ports after the App View's, so that
  // the variables printed below are still right when the demo starts
  // again; another PORT moves all three.
  let appViewPort = readPort((name) => getEnv(name), new GrowableArray<String>()) as i32;
  let world = new FakePds();
  try {
    world.start(appViewPort + 1);
  } catch (e) {
    stopForPort('the stand-in PLC directory and PDS', appViewPort + 1, appViewPort, e);
    throw e;
  }
  world.account(MAINTAINER, null).password = PASSWORD;
  // Real accounts, such as one signing in to the web app, resolve through
  // the public directory; the demo's own accounts never reach it.
  world.upstreamPlc = 'https://plc.directory';

  let port = getEnv('PORT') ?? '2583';
  let defaults = new HashMap<String, String>();
  defaults['PORT'] = port;
  defaults['APP_VIEW_DOMAIN'] = 'pkg.test';
  defaults['PDS_PUBLIC_URL'] = `http://127.0.0.1:${port}`;
  // atproto allows a port in a did:web only for localhost, and a real PDS
  // refuses a service-auth token for any other, as when signing in to the
  // pages. `zena` takes it for the registry at 127.0.0.1 on the same port.
  defaults['APP_VIEW_DID'] = `did:web:localhost%3A${port}`;
  defaults['APP_VIEW_PLC_DIRECTORY'] = world.plcDirectory;
  defaults['PDS_PLC_DIRECTORY'] = world.plcDirectory;
  // The resolver below answers from records in memory, wherever the
  // accounts are kept.
  defaults['APP_VIEW_HANDLE_RECORDS'] = 'memory';
  // The demo maintainer's PDS is on this machine, and the App View reads
  // their attestations from it.
  defaults['APP_VIEW_PRIVATE_READS'] = '1';
  // TODO(#520): the return type is only for the compiler.
  let config = configFromEnv((name): String | null => {
    let fixed = name == 'APP_VIEW_HANDLE_RECORDS' || name == 'APP_VIEW_PLC_DIRECTORY' || name == 'PDS_PLC_DIRECTORY';
    let given = if (fixed) null else getEnv(name);
    if (given != null) {
      return given;
    }
    if (let (true, value) = defaults.get(name)) {
      return value;
    }
    return null;
  });
  let running = try {
    await serve(config)
  } catch (e) {
    stopForPort('the App View', appViewPort, appViewPort, e);
    throw e;
  };
  await createScopes(running.service.appView, getEnv('DEMO_SCOPES') ?? '');
  let upstream = dnsOverHttpsUpstream(getEnv('APP_VIEW_DNS_OVER_HTTPS') ?? 'https://cloudflare-dns.com/dns-query');
  let dns = try {
    new Server(dnsOverHttpsApp(running.service.records as MemoryHandleRecords, upstream), (appViewPort + 2) as u16)
  } catch (e) {
    stopForPort('the DNS-over-HTTPS resolver', appViewPort + 2, appViewPort, e);
    throw e;
  };
  dns.start();

  let dnsUrl = `http://127.0.0.1:${dns.port as i32}/dns-query`;
  let repo = getEnv('DEMO_REPO') ?? '';
  let zena = if (repo == '') null else new DemoZena(repo, world.plcDirectory, dnsUrl, running.origin);
  var environment = dedent`
    In another shell, set the variables zena needs to use it:

      export ZENA_PLC_DIRECTORY=${world.plcDirectory}
      export ZENA_DNS_OVER_HTTPS=${dnsUrl}
      export ZENA_REGISTRY=${running.origin}
      export ZENA_CONFIG_DIR=$(mktemp -d)   # keeps the demo's sign-in apart from yours
  `;
  if (zena != null) {
    await writeFile(`${STATE}/env.sh`, zena.script());
    environment = dedent`
      In another shell, from the repository root,

        source .zena/demo/env.sh

      sets the variables zena needs to use it (ZENA_REGISTRY, ZENA_PLC_DIRECTORY,
      ZENA_DNS_OVER_HTTPS, and ZENA_CONFIG_DIR, which keeps the demo's sign-in
      apart from yours), and makes \`zena\` this checkout's zena-cli.
    `;
  }
  console.log(dedent`
    An App View for pkg.test is listening on ${running.origin}, which
    serves its web pages there too.

    ${environment}
    Every shell that runs zena pkg needs them: without ZENA_REGISTRY it calls
    the Zena project's registry. Then, in a directory with a zena-package.json
    that has a name, a version, a description and a license (such as "MIT"),
    and the package's libraries in src/:

      echo ${PASSWORD} | zena pkg login ${MAINTAINER} --password-stdin
      zena pkg scope create acme --yes
      zena pkg publish --scope acme --yes

    In another workspace, \`zena pkg add acme:<name>\`, then import its libraries
    as 'acme:<name>/<library>', its main library as 'acme:<name>', and
    \`zena run\`.
    To see /admin when you sign in to the pages, start the demo with
    APP_VIEW_ADMIN_DIDS set to your DID. A scope the App View reserves, such
    as zena or zena-lang, is created only as the operator: start the demo with
    DEMO_SCOPES="zena=<your handle or DID>".
  `);

  let toPublish = getEnv('DEMO_PUBLISH') ?? '';
  if (toPublish != '') {
    if (zena == null) {
      console.error('DEMO_PUBLISH needs DEMO_REPO and .zena/demo as /demo: run npm run demo:publish -w @zena-lang/registry');
    } else {
      let published = await publishPackages(zena, toPublish);
      if (published.length > 0) {
        var added = '';
        for (let dir in published) {
          added = `${added}\n  zena pkg add ${await scopedName(dir)}`;
        }
        console.log(dedent`

          Published ${join(published, ', ')} as ${MAINTAINER}, who stays signed in
          in .zena/demo/config. To use them, after \`source .zena/demo/env.sh\`, in a
          new workspace (mkdir app && cd app && echo '{"name": "app"}' > zena-package.json):
        `);
        console.log(added.sliceBytes(1, added.length));
      }
    }
  }
  console.log('\nCtrl-C stops the App View and forgets everything it held in memory.');
  await world.done();
}

/**
 * Says why `what` could not start on `port`, and exits. Most often a demo
 * started before is still running and holds it, with the two ports
 * after `appViewPort`'s.
 */
function stopForPort(what: String, port: i32, appViewPort: i32, e: Error): void {
  console.error(dedent`
    Could not start ${what} on port ${`${port}`}: ${e.message}
    If another demo is running, it holds the port (npm run demo and npm run
    demo:publish each start one): stop it, or start this one with PORT set to
    another port, which moves all three the demo uses (${`${appViewPort}`}, ${`${appViewPort + 1}`} and
    ${`${appViewPort + 2}`} now).
  `);
  exit(1);
}

/** `scope:name` of the package published from the copy of `dir`, or its name. */
async function scopedName(dir: String): Future<String> {
  let parts = dir.split('/');
  let manifest = parseJson(await readFile(`${STATE}/packages/${parts[parts.length - 1]}/zena-package.json`)) as JsonObject;
  let name = manifest['name'] as String;
  let scope = manifest['scope'];
  return if (scope is String) `${scope}:${name}` else name;
}
