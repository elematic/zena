/** The App View's store conformance tests (`store-conformance.zena`) in memory. */

import {suite} from 'zena:test';
import {AppViewStore} from 'registry/app-view';
import {MemoryAppViewStore} from 'registry/memory-store';
import {MemoryPlcLog, PlcLog} from 'registry/plc-directory';
import {appViewStoreConformance, plcLogConformance} from './store-conformance.zena';

export let tests = suite('in-memory App View stores', () => {
  // TODO(#520): drop the return types.
  appViewStoreConformance((): AppViewStore => new MemoryAppViewStore());
  plcLogConformance((): PlcLog => new MemoryPlcLog());
});
