/**
 * The App View's store conformance tests (`../store-conformance.zena`)
 * against the Firestore emulator, and the App View on Firestore. Run with
 * `npm run test:emulator -w @zena-lang/registry`, which starts the
 * emulator and sets `FIRESTORE_EMULATOR_HOST`. Each test works in a
 * project of its own (`freshEmulatedDatabase`).
 */

import {suite, test} from 'zena:test';
import {equal, isTrue} from 'zena:assert';
import {HashMap} from 'zena:collections';
import {Request, Response} from 'zena:http';
import {JsonArray, JsonObject, parseJson} from 'zena:json';
import {getRandomU64} from 'wasi:random/random';
import {freshEmulatedDatabase} from 'google-cloud/testing/firestore-emulator';
import {AppViewStore} from 'registry/app-view';
import {FirestoreAppViewStore, FirestorePlcLog} from 'registry/firestore';
import {PlcLog} from 'registry/plc-directory';
import {buildService, configFromEnv} from 'registry/service';
import {appViewStoreConformance, plcLogConformance} from '../store-conformance.zena';

export let tests = suite('Firestore App View stores', () => {
  // TODO(#520): drop the return types.
  appViewStoreConformance((): AppViewStore => new FirestoreAppViewStore(freshEmulatedDatabase(), 'test'));
  plcLogConformance((): PlcLog => new FirestorePlcLog(freshEmulatedDatabase(), 'test'));

  test('keeps tenants apart', async (ctx) => {
    let db = freshEmulatedDatabase();
    let did = 'did:plc:alicealicealicealicealic';
    isTrue(await new FirestoreAppViewStore(db, 'one').claimScope('acme', did), 'claimed');
    isTrue(await new FirestoreAppViewStore(db, 'two').claimScope('acme', did), 'claimed in the other tenant');
  });

  test('serves the App View on Firestore, with its PDS, as the environment configures them', async (ctx) => {
    let env: HashMap<String, String> = {
      'PDS_STORAGE' => 'firestore',
      'PDS_TENANT' => `service-${getRandomU64() % (1000000000 as u64)}`,
      'PDS_BLOB_DIR' => '/tmp/registry-service-blobs',
      'PDS_JWT_SECRET' => '0101010101010101010101010101010101010101010101010101010101010101',
      'APP_VIEW_DOMAIN' => 'pkg.test',
      'APP_VIEW_ROTATION_KEY' => '0202020202020202020202020202020202020202020202020202020202020202',
      'APP_VIEW_HANDLE_RECORDS' => 'memory',
      // A test's accounts, which no one keeps.
      'APP_VIEW_ALLOW_NO_OFFLINE_KEY' => '1',
    };
    // TODO(#520): the return type is only for the compiler.
    let config = configFromEnv((name): String | null => {
      if (let (true, value) = env.get(name)) {
        return value;
      }
      return null;
    });
    let service = await buildService(config, 'http://127.0.0.1:1');
    // Its listings read its store, in the PDS's tenant, which holds no scope yet.
    let res = new Response();
    let app = service.app;
    await app.handleRequest(new Request.fromUrl('http://localhost/xrpc/dev.zena-lang.registry.listScopes', 'GET',
        new HashMap<String, String>()), res);
    equal(res.statusCode, 200);
    equal(((parseJson(res.body as String) as JsonObject)['scopes'] as JsonArray).length, 0);
  });

  test('serves the App View on Firestore, in a tenant of its own, with its PDS elsewhere', async (ctx) => {
    let env: HashMap<String, String> = {
      'APP_VIEW_PDS_URL' => 'https://padstone.test',
      'APP_VIEW_STORAGE' => 'firestore',
      'APP_VIEW_TENANT' => `app-view-${getRandomU64() % (1000000000 as u64)}`,
      'APP_VIEW_OBJECT_DIR' => '/tmp/registry-service-objects',
      'APP_VIEW_SESSION_SECRET' => '0101010101010101010101010101010101010101010101010101010101010101',
      'APP_VIEW_DOMAIN' => 'pkg.test',
      'APP_VIEW_ROTATION_KEY' => '0202020202020202020202020202020202020202020202020202020202020202',
      'APP_VIEW_SIGNING_KEY' => '0303030303030303030303030303030303030303030303030303030303030303',
      'APP_VIEW_HANDLE_RECORDS' => 'memory',
      // A test's accounts, which no one keeps.
      'APP_VIEW_ALLOW_NO_OFFLINE_KEY' => '1',
    };
    // TODO(#520): the return type is only for the compiler.
    let config = configFromEnv((name): String | null => {
      if (let (true, value) = env.get(name)) {
        return value;
      }
      return null;
    });
    let service = await buildService(config, 'http://127.0.0.1:1');
    isTrue(service.pds == null, 'no PDS of its own');
    let res = new Response();
    let app = service.app;
    await app.handleRequest(new Request.fromUrl('http://localhost/xrpc/dev.zena-lang.registry.listScopes', 'GET',
        new HashMap<String, String>()), res);
    equal(res.statusCode, 200);
    equal(((parseJson(res.body as String) as JsonObject)['scopes'] as JsonArray).length, 0);
  });
});
