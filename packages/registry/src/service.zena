/**
 * The App View as a server: its configuration, read from the environment
 * by `configFromEnv`, and `serve`, which builds the App View's stores, the
 * App View, and the PDS it keeps its accounts on when that runs in the
 * same process (`pds/service`), and listens. `main.zena` is the two
 * together.
 *
 * The App View keeps its accounts on a PDS in the same process, by
 * default, or on one elsewhere, which it reaches with its own tokens
 * (`APP_VIEW_PDS_URL`, `pds/pds-client`'s `XrpcPds`). A PDS in the same
 * process reads its own variables, `PDS_*` (see `pds/service`): its
 * storage, which the App View keeps its stores beside, under the same
 * tenant; its origin, which the accounts' DID documents name and where
 * the App View's methods are served too (`PDS_PUBLIC_URL`,
 * `https://<APP_VIEW_DOMAIN>` by default); and the rest. It trusts the App
 * View it runs with, beside any `PDS_TRUSTED_APP_VIEWS`. The App View's:
 *
 * - `APP_VIEW_DOMAIN`, required: the App View's domain, such as
 *   `pkg.zena-lang.dev`. A PDS with no App View starts from
 *   `packages/pds/src/main.zena`.
 * - `APP_VIEW_PDS_URL`: the origin of a PDS elsewhere that keeps the App
 *   View's accounts, such as `https://padstone.zena-lang.dev`, which must
 *   trust the App View (`PDS_TRUSTED_APP_VIEWS`). The server then runs no
 *   PDS of its own, and takes no `PDS_*` variable. With it:
 *   - `APP_VIEW_PDS_DID`: that PDS's DID, which the App View's tokens are
 *     addressed to, by default the `did:web` of its host.
 *   - `APP_VIEW_PUBLIC_URL`: the App View's own origin, where its methods
 *     are served, `https://<APP_VIEW_DOMAIN>` by default.
 *   - `APP_VIEW_STORAGE`: `memory` (the default) or `firestore`, where the
 *     App View keeps its stores; with `firestore`, `APP_VIEW_TENANT` and
 *     `APP_VIEW_FIRESTORE_DATABASE`, as `pds/service`'s `PDS_TENANT` and
 *     `PDS_FIRESTORE_DATABASE`, and `APP_VIEW_BUCKET`, the Cloud Storage
 *     bucket for what it derives from releases
 *     (`registry/release-contents`), or `APP_VIEW_OBJECT_DIR`, a directory
 *     for it, as `PDS_BLOB_BUCKET` and `PDS_BLOB_DIR`. With the PDS in the
 *     same process, it is kept beside the PDS's blobs.
 * - `APP_VIEW_SESSION_SECRET`: 32 bytes in hex, which signs the site's web
 *   sessions and the URLs of its avatars (`registry/web-sessions`).
 *   Required with Firestore, since every server of a deployment checks
 *   them, and otherwise made up at start.
 * - `APP_VIEW_ROTATION_KEY`: the App View's online PLC rotation key, a
 *   secp256k1 private key in hex; or `APP_VIEW_ROTATION_KMS_KEY`, a Cloud
 *   KMS key version, `projects/…/cryptoKeyVersions/<n>`, on secp256k1 or
 *   P-256, which signs without the key leaving Cloud KMS (`pds/signer`).
 *   One of them is required with Firestore (`PDS_STORAGE` or
 *   `APP_VIEW_STORAGE`), since the accounts it creates outlive the server.
 *   In memory, a missing key is made up at start.
 * - `APP_VIEW_SIGNING_KEY` or `APP_VIEW_SIGNING_KMS_KEY`: the App View's own
 *   signing key, given as the rotation key is, which signs its
 *   service-auth tokens to the PDSes of its accounts and which its DID
 *   document lists. Required with `APP_VIEW_PDS_URL` and
 *   `APP_VIEW_STORAGE=firestore`, since every server of a deployment signs
 *   with the one key its DID document lists. Otherwise a missing key is
 *   made up at start: a PDS in the same process needs no tokens.
 * - `APP_VIEW_OFFLINE_ROTATION_KEY`: the operator's offline rotation key,
 *   as a `did:key`, which every new account ranks above the online key, so
 *   that the operator can undo what a stolen online key signs. Required
 *   with Firestore when the App View makes accounts in the public PLC
 *   directory, since an account made without it never lists it.
 * - `APP_VIEW_ALLOW_NO_OFFLINE_KEY`: `1` starts such an App View without
 *   the offline key, on purpose.
 * - `APP_VIEW_DID`: the App View's DID, by default the `did:web` of the
 *   host where its methods are served: `APP_VIEW_PUBLIC_URL`'s with a PDS
 *   elsewhere, `PDS_PUBLIC_URL`'s otherwise.
 * - `APP_VIEW_SITE_URL`: the origin of the site, the App View's web pages,
 *   when it has a name of its own (docs/design/package-manager.md, "Names
 *   and addresses"). A request for the site's host name then gets the
 *   pages and what their sign-in calls, and a request for any other name
 *   gets the PDS: its XRPC methods, its DID document and its staging PLC
 *   directory. Without it, every name gets both, as on one machine.
 * - `APP_VIEW_ADMIN_DIDS`: the DIDs of the App View's admins, separated by
 *   commas or spaces, who sign in to the web app as themselves and may see
 *   every account the App View holds and every private entry. `deploy.sh`
 *   passes spaces, since `gcloud --set-env-vars` splits on commas.
 * - `APP_VIEW_RESERVED_SCOPES`: scope names no one may take,
 *   comma-separated, beside the App View's own.
 * - `APP_VIEW_SCOPE_CREATORS`: who may create a scope: `anyone`, the
 *   default, or `listed`, the admins and the accounts they list with
 *   `putScopeCreator` (`zena pkg admin allow`), as during a preview.
 * - `APP_VIEW_MIN_CLIENT_VERSION`: the oldest `zena` whose calls the App
 *   View's methods take, a version such as `0.2.0`: an older one is refused
 *   with `UpgradeRequired`, and `describeRegistry` names it, so `zena`
 *   stops before it calls. Any by default.
 * - `APP_VIEW_CLIENT_NOTICE`: a message `describeRegistry` gives, which
 *   `zena` prints before each command that calls the App View, such as one
 *   asking people to upgrade before the minimum rises.
 * - `APP_VIEW_PRIVATE_READS`: `1` lets the App View read PDSes at
 *   addresses on this machine or a private network, as a stack on one
 *   machine needs (tests, demos). Off by default, so a DID document cannot
 *   point the App View's reads at what is behind it.
 * - `APP_VIEW_HANDLE_RECORDS`: where the App View writes its handles' DNS
 *   records (`registry/handles`): `cloud-dns`, a Cloud DNS managed zone,
 *   or `memory`, for local runs. `memory` by default, but required with
 *   Firestore, so that no deployment keeps them in memory by leaving it
 *   out. With `cloud-dns`, `APP_VIEW_DNS_ZONE` names the zone,
 *   and `APP_VIEW_DNS_PROJECT` its project, by default the one the server
 *   runs in.
 * - `APP_VIEW_PLC_DIRECTORY` and `APP_VIEW_DNS_OVER_HTTPS`: where DIDs and
 *   handles are resolved, `https://plc.directory` and Cloudflare's
 *   resolver by default.
 * - `APP_VIEW_PLC`: `public` (the default), where the App View sends the
 *   operations of the accounts it makes to `APP_VIEW_PLC_DIRECTORY`; or
 *   `staging`, where the server is a PLC directory itself, at `/plc`
 *   (`registry/plc-directory`), that records them in its storage and reads
 *   every other DID from `APP_VIEW_PLC_DIRECTORY`, so nothing a staging
 *   App View makes reaches it.
 * - `APP_VIEW_WEB_DIR`: the directory of the web app's assets and static
 *   documentation (`packages/pds-web`'s build), which the server serves at
 *   `/assets/` and `/docs/`. The App View renders its pages
 *   (`registry/web/routes`) with or without it, but unstyled without.
 */

import {Future} from 'zena:async';
import {Unmanaged} from 'zena:core';
import {App, Server, mount, serve as serveFiles} from 'zena:http';
import {stringify} from 'zena:json';
import {randomBytes} from 'zena:random';
import {URL} from 'zena:url';
import {Version} from 'zena-lang:semver';
import {defaultProjectId} from 'google-cloud/auth';
import {CloudDns} from 'google-cloud/dns';
import {Firestore} from 'google-cloud/firestore';
import {CloudKms} from 'google-cloud/kms';
import {parseDidDocument} from 'atproto/did';
import {KeyType, PublicKey, parseDidKey} from 'atproto/didkey';
import {IdentityResolver, PUBLIC_PLC_DIRECTORY} from 'atproto/identity';
import {PlcOperation, fetchOperations, submitPlcOperation} from 'atproto/plc';
import {SigningKeyLookup} from 'atproto/service-auth';
import {PlcLogLookup, TrustedAppView} from 'pds/managed';
import {Pds} from 'pds/pds';
import {InProcessPds, PdsClient, XrpcPds} from 'pds/pds-client';
import {MemoryBlobs} from 'pds/firestore';
import {
  BlobChoice, InBucket, InDirectory, InFirestore, PDS_VARIABLES, PdsConfig, blobBytes, buildPds, decodeKey,
  didWebOfOrigin, listen, originOf, readPdsConfig, readPort, refuseProblems, valuesOf
} from 'pds/service';
import {Sessions} from 'pds/sessions';
import {KmsSigner, LocalSigner, Signer} from 'pds/signer';
import {SigningKey} from 'pds/storage';
import {REQUEST_BODY_LIMIT} from 'pds/xrpc/common';
import {AppViewConfig, AppViewStore, MemoryAppViewStore, AppView, ScopeCreation} from './app-view.zena';
import {FirestoreAppViewStore, FirestorePlcLog} from './firestore.zena';
import {DerivedObjects} from './release-contents.zena';
import {CloudDnsRecords, HandleRecords, MemoryHandleRecords} from './handles.zena';
import {MemoryPlcLog, PlcDirectory, PlcLog} from './plc-directory.zena';
import {AppPart, createApp} from './server.zena';
import {WebSessions} from './web-sessions.zena';

/** Where the App View writes its handles' DNS records. */
export sealed class RecordsChoice {
  case RecordsInMemory
  /** A Cloud DNS managed zone, of `project`, or the server's own when null. */
  case InCloudDns(project: String | null, zone: String)
}

/** The App View's settings. */
export final class AppViewSettings {
  domain: String;
  /**
   * The App View's DID, which callers' tokens are addressed to, or null for the
   * `did:web` of its endpoint (`did:web:127.0.0.1%3A2583`), which a server
   * that picks its port at start can only know then. `zena` refuses an App View
   * whose DID does not name its origin.
   */
  serviceDid: String | null;
  /**
   * The site's origin, when the pages have a host name of their own
   * (`APP_VIEW_SITE_URL`); null serves the pages and the PDS under every name.
   */
  var siteUrl: String | null = null;
  /** The App View's PLC rotation key, or null to make one up at start. */
  rotationKey: SigningKey | null;
  /** The Cloud KMS key version of the online rotation key, in place of `rotationKey`. */
  var rotationKmsKey: String | null = null;
  /** The App View's own signing key, or null to make one up at start. */
  var signingKey: SigningKey | null = null;
  /** The Cloud KMS key version of the App View's signing key, in place of `signingKey`. */
  var signingKmsKey: String | null = null;
  /** The operator's offline rotation key. */
  var offlineRotationKey: PublicKey | null = null;
  reservedScopes: Array<String>;
  /** The DIDs of the App View's admins. */
  var admins: Array<String> = [];
  /** Whether the App View may read PDSes on this machine or a private network (`APP_VIEW_PRIVATE_READS`). */
  var privateReads = false;
  /** Who may create a scope (`APP_VIEW_SCOPE_CREATORS`). */
  var scopeCreation = ScopeCreation.Anyone;
  /** The oldest `zena` the App View takes (`APP_VIEW_MIN_CLIENT_VERSION`), or null for any. */
  var minimumClientVersion: Version | null = null;
  /** The message for `zena`'s users (`APP_VIEW_CLIENT_NOTICE`), or null. */
  var clientNotice: String | null = null;
  records: RecordsChoice;

  new(this.domain, this.serviceDid, this.rotationKey, this.reservedScopes, this.records);
}

/** A PDS elsewhere, which keeps the App View's accounts: its origin, and its DID (`APP_VIEW_PDS_URL`). */
export final class RemotePds {
  url: String;
  did: String;

  new(this.url, this.did);
}

/** Where the App View keeps its stores when its PDS is elsewhere (`APP_VIEW_STORAGE`). */
export sealed class StoreChoice {
  case StoresInMemory
  /**
   * Firestore, for `tenant`, in the database `database`, or the project's
   * default one when null, with what the App View derives from releases
   * in `objects`.
   */
  case StoresInFirestore(tenant: String, database: String | null, objects: BlobChoice)
}

/** What the server is to be: the App View, and the PDS that keeps its accounts. */
export final class ServiceConfig {
  var port: u16;
  /** The PDS in the same process, or null for one elsewhere (`remotePds`). */
  pds: PdsConfig | null;
  /** The PDS elsewhere, when there is no PDS in the same process. */
  var remotePds: RemotePds | null = null;
  /** Where the App View keeps its stores, or null to keep them beside the PDS's in the same process. */
  var stores: StoreChoice | null = null;
  /**
   * The App View's own origin, where its methods are served, or null for
   * the PDS's in the same process, or else the server's own.
   */
  var publicUrl: String | null = null;
  /** The secret of the site's sessions, or null to make one up at start. */
  var sessionSecret: FixedArray<u8> | null = null;
  appView: AppViewSettings;
  plcDirectory: String;
  dnsOverHttps: String;
  /**
   * Whether the server is a staging PLC directory itself, reading the DIDs
   * it has not recorded from `plcDirectory` (`APP_VIEW_PLC=staging`).
   */
  var plcStaging: boolean = false;
  /** The web app's directory, or null to serve none. */
  var webDir: String | null = null;

  new(pds: PdsConfig | null, appView: AppViewSettings, plcDirectory: String, dnsOverHttps: String)
      : port = pds?.port ?? 2583 as u16, pds = pds, appView = appView,
        plcDirectory = plcDirectory, dnsOverHttps = dnsOverHttps;
}

/**
 * A built server, not yet listening: its application, the App View, the
 * PDS in the same process and its password sessions if it has them, where
 * the App View writes its handles' DNS records, and the staging PLC
 * directory it is, if it is one.
 */
export final class Service {
  app: App;
  pds: Pds | null;
  appView: AppView;
  records: HandleRecords;
  plc: PlcDirectory | null;
  sessions: Sessions | null;

  new(this.app, this.pds, this.appView, this.records, this.plc, this.sessions);
}

/**
 * The configuration the variables `env` gives (see the module comment and
 * `pds/service`'s). Throws `ConfigError` naming every variable that is
 * wrong.
 */
export function configFromEnv(env: (name: String) => String | null): ServiceConfig {
  let problems = new GrowableArray<String>();
  let value = valuesOf(env);

  var domain = value('APP_VIEW_DOMAIN');
  if (domain == null) {
    problems.push('APP_VIEW_DOMAIN is required: the App View\'s domain, such as pkg.zena-lang.dev; a PDS alone starts from packages/pds/src/main.zena');
    domain = 'invalid';
  }
  var sessionSecret: FixedArray<u8> | null = null;
  let secretText = value('APP_VIEW_SESSION_SECRET');
  if (secretText != null) {
    sessionSecret = decodeKey(secretText);
    if (sessionSecret == null) {
      problems.push('APP_VIEW_SESSION_SECRET is not 32 bytes of hex');
    }
  }

  // The PDS that keeps the App View's accounts: one elsewhere, or one in
  // the same process, which reads its own variables.
  var pds: PdsConfig | null = null;
  var remote: RemotePds | null = null;
  var stores: StoreChoice | null = null;
  var port = 2583 as u16;
  // The variable that keeps the App View's data in Firestore, as asked
  // for, whether or not the rest of its configuration is usable.
  var firestore: String | null = null;
  // The App View's own origin, and the variable it comes from.
  var appViewUrl = `https://${domain}`;
  var appViewUrlName = 'PDS_PUBLIC_URL';
  let pdsUrl = value('APP_VIEW_PDS_URL');
  if (pdsUrl != null) {
    port = readPort(value, problems);
    if (originOf(pdsUrl) == null) {
      problems.push(`APP_VIEW_PDS_URL is an origin, such as https://padstone.zena-lang.dev, not ${pdsUrl}`);
    } else {
      remote = new RemotePds(pdsUrl, value('APP_VIEW_PDS_DID') ?? didWebOfOrigin(pdsUrl));
    }
    for (let name in PDS_VARIABLES) {
      if (value(name) != null) {
        problems.push(`${name} is the PDS's, and APP_VIEW_PDS_URL keeps the App View's accounts on a PDS elsewhere`);
      }
    }
    let storageKind = value('APP_VIEW_STORAGE') ?? 'memory';
    let bucket = value('APP_VIEW_BUCKET');
    let objectDir = value('APP_VIEW_OBJECT_DIR');
    if (storageKind == 'firestore') {
      firestore = 'APP_VIEW_STORAGE';
      let tenant = value('APP_VIEW_TENANT');
      if (tenant == null) {
        problems.push('APP_VIEW_STORAGE=firestore needs APP_VIEW_TENANT');
      }
      if (bucket != null && objectDir != null) {
        problems.push('give APP_VIEW_BUCKET or APP_VIEW_OBJECT_DIR, not both');
      } else if (bucket == null && objectDir == null) {
        problems.push('APP_VIEW_STORAGE=firestore needs APP_VIEW_BUCKET or APP_VIEW_OBJECT_DIR');
      } else if (tenant != null) {
        let objects: BlobChoice = if (bucket != null) new InBucket(bucket) else new InDirectory(objectDir as String);
        stores = new StoresInFirestore(tenant, value('APP_VIEW_FIRESTORE_DATABASE'), objects);
      }
    } else if (storageKind == 'memory') {
      stores = new StoresInMemory();
      if (value('APP_VIEW_TENANT') != null || value('APP_VIEW_FIRESTORE_DATABASE') != null ||
          bucket != null || objectDir != null) {
        problems.push('APP_VIEW_TENANT, APP_VIEW_FIRESTORE_DATABASE, APP_VIEW_BUCKET and APP_VIEW_OBJECT_DIR need APP_VIEW_STORAGE=firestore');
      }
    } else {
      problems.push(`APP_VIEW_STORAGE is memory or firestore, not ${storageKind}`);
    }
    let given = value('APP_VIEW_PUBLIC_URL');
    if (given != null) {
      if (originOf(given) == null) {
        problems.push(`APP_VIEW_PUBLIC_URL is an origin, such as https://pkg.zena-lang.dev, not ${given}`);
      } else {
        appViewUrl = given;
      }
    }
    appViewUrlName = 'APP_VIEW_PUBLIC_URL';
  } else {
    let inProcess = readPdsConfig(value, problems);
    port = inProcess.port;
    if (value('PDS_STORAGE') == 'firestore') {
      firestore = 'PDS_STORAGE';
    }
    for (let name in ['APP_VIEW_PDS_DID', 'APP_VIEW_PUBLIC_URL', 'APP_VIEW_STORAGE', 'APP_VIEW_TENANT',
        'APP_VIEW_FIRESTORE_DATABASE', 'APP_VIEW_BUCKET', 'APP_VIEW_OBJECT_DIR']) {
      if (value(name) != null) {
        problems.push(`${name} needs APP_VIEW_PDS_URL: with the PDS in the same process, the App View is served at its name and keeps its stores beside its`);
      }
    }
    // The App View's methods are served at the PDS's name, so by default the
    // PDS's origin is the App View's domain.
    if (inProcess.publicUrl == null) {
      inProcess.publicUrl = appViewUrl;
    }
    appViewUrl = inProcess.publicUrl as String;
    pds = inProcess;
  }

  if (secretText == null && firestore != null) {
    problems.push(`${firestore}=firestore needs APP_VIEW_SESSION_SECRET`);
  }
  let (rotationKey, kmsKey) = keyFrom(value, problems, 'APP_VIEW_ROTATION_KEY', 'APP_VIEW_ROTATION_KMS_KEY');
  if (value('APP_VIEW_ROTATION_KEY') == null && kmsKey == null && firestore != null) {
    problems.push(`${firestore}=firestore needs APP_VIEW_ROTATION_KEY or APP_VIEW_ROTATION_KMS_KEY`);
  }
  let (signingKey, signingKmsKey) = keyFrom(value, problems, 'APP_VIEW_SIGNING_KEY', 'APP_VIEW_SIGNING_KMS_KEY');
  if (value('APP_VIEW_SIGNING_KEY') == null && signingKmsKey == null && pdsUrl != null && firestore != null) {
    problems.push('APP_VIEW_PDS_URL with APP_VIEW_STORAGE=firestore needs APP_VIEW_SIGNING_KEY or APP_VIEW_SIGNING_KMS_KEY, which the PDS checks its tokens with');
  }
  var offlineKey: PublicKey | null = null;
  let offlineText = value('APP_VIEW_OFFLINE_ROTATION_KEY');
  if (offlineText != null) {
    try {
      offlineKey = parseDidKey(offlineText);
    } catch (e) {
      problems.push('APP_VIEW_OFFLINE_ROTATION_KEY is not a did:key');
    }
  }
  let reserved = new GrowableArray<String>();
  let reservedText = value('APP_VIEW_RESERVED_SCOPES');
  if (reservedText != null) {
    for (let name in reservedText.split(',')) {
      let trimmed = name.trim();
      if (trimmed.length > 0) {
        reserved.push(trimmed);
      }
    }
  }
  var minimumClient: Version | null = null;
  let minimumText = value('APP_VIEW_MIN_CLIENT_VERSION');
  if (minimumText != null) {
    try {
      minimumClient = Version.parse(minimumText);
    } catch (e) {
      problems.push(`APP_VIEW_MIN_CLIENT_VERSION is a version, such as 0.2.0, not ${minimumText}`);
    }
  }
  let creatorsText = value('APP_VIEW_SCOPE_CREATORS') ?? 'anyone';
  if (creatorsText != 'anyone' && creatorsText != 'listed') {
    problems.push(`APP_VIEW_SCOPE_CREATORS is anyone or listed, not ${creatorsText}`);
  }
  let admins = new GrowableArray<String>();
  let adminText = value('APP_VIEW_ADMIN_DIDS');
  if (adminText != null) {
    for (let part in adminText.split(',')) {
      for (let did in part.split(' ')) {
        let trimmed = did.trim();
        if (trimmed.length == 0) {
          continue;
        }
        if (!trimmed.startsWith('did:')) {
          problems.push(`APP_VIEW_ADMIN_DIDS has '${trimmed}', which is not a DID`);
        }
        admins.push(trimmed);
      }
    }
  }
  let privateReads = value('APP_VIEW_PRIVATE_READS');
  if (privateReads != null && privateReads != '1' && privateReads != '0') {
    problems.push(`APP_VIEW_PRIVATE_READS is 1 or 0, not ${privateReads}`);
  }
  var records: RecordsChoice = new RecordsInMemory();
  let recordsKind = value('APP_VIEW_HANDLE_RECORDS');
  let zone = value('APP_VIEW_DNS_ZONE');
  let project = value('APP_VIEW_DNS_PROJECT');
  if (recordsKind == 'cloud-dns') {
    if (zone == null) {
      problems.push('APP_VIEW_HANDLE_RECORDS=cloud-dns needs APP_VIEW_DNS_ZONE');
    } else {
      records = new InCloudDns(project, zone);
    }
  } else if (recordsKind == null || recordsKind == 'memory') {
    if (recordsKind == null && firestore != null) {
      problems.push(`${firestore}=firestore needs APP_VIEW_HANDLE_RECORDS: cloud-dns, or memory`);
    }
    if (zone != null || project != null) {
      problems.push('APP_VIEW_DNS_ZONE and APP_VIEW_DNS_PROJECT need APP_VIEW_HANDLE_RECORDS=cloud-dns');
    }
  } else {
    problems.push(`APP_VIEW_HANDLE_RECORDS is cloud-dns or memory, not ${recordsKind}`);
  }
  let appViewOrigin = originOf(appViewUrl);
  var siteUrl: String | null = null;
  let siteText = value('APP_VIEW_SITE_URL');
  if (siteText != null) {
    let site = originOf(siteText);
    if (site == null) {
      problems.push(`APP_VIEW_SITE_URL is an origin, such as https://pkg.zena-lang.dev, not ${siteText}`);
    } else if (appViewOrigin != null && site.host() == appViewOrigin.host()) {
      problems.push(`APP_VIEW_SITE_URL names the App View's own host, ${site.host()}: leave it out to serve the site there too, or give ${appViewUrlName} another name`);
    } else {
      siteUrl = site.origin();
    }
  }
  let serviceDid = value('APP_VIEW_DID') ?? (if (appViewOrigin != null) didWebOfOrigin(appViewUrl) else null);
  let settings = new AppViewSettings(domain, serviceDid, rotationKey, reserved, records);
  settings.siteUrl = siteUrl;
  settings.rotationKmsKey = kmsKey;
  settings.signingKey = signingKey;
  settings.signingKmsKey = signingKmsKey;
  settings.admins = admins;
  settings.offlineRotationKey = offlineKey;
  settings.privateReads = privateReads == '1';
  settings.scopeCreation = if (creatorsText == 'listed') ScopeCreation.Listed else ScopeCreation.Anyone;
  settings.minimumClientVersion = minimumClient;
  settings.clientNotice = value('APP_VIEW_CLIENT_NOTICE');

  var plcStaging = false;
  let plcMode = value('APP_VIEW_PLC') ?? 'public';
  if (plcMode == 'staging') {
    plcStaging = true;
  } else if (plcMode != 'public') {
    problems.push(`APP_VIEW_PLC is public or staging, not ${plcMode}`);
  }
  // Every account the App View creates in the public directory lists the
  // offline key only if the App View had it then: one started without it
  // makes accounts no one can take back from a stolen online key.
  let plcDirectory = value('APP_VIEW_PLC_DIRECTORY') ?? PUBLIC_PLC_DIRECTORY;
  let allowNoOffline = value('APP_VIEW_ALLOW_NO_OFFLINE_KEY');
  if (allowNoOffline != null && allowNoOffline != '1' && allowNoOffline != '0') {
    problems.push(`APP_VIEW_ALLOW_NO_OFFLINE_KEY is 1 or 0, not ${allowNoOffline}`);
  }
  let publicDirectory = plcDirectory == PUBLIC_PLC_DIRECTORY || plcDirectory == `${PUBLIC_PLC_DIRECTORY}/`;
  if (firestore != null && !plcStaging && publicDirectory && offlineText == null && allowNoOffline != '1') {
    problems.push(`${firestore}=firestore with the public PLC directory needs APP_VIEW_OFFLINE_ROTATION_KEY, the did:key every account it creates ranks above the online key; APP_VIEW_ALLOW_NO_OFFLINE_KEY=1 starts without it on purpose`);
  }

  refuseProblems(problems);
  let config = new ServiceConfig(pds, settings, plcDirectory,
      value('APP_VIEW_DNS_OVER_HTTPS') ?? 'https://cloudflare-dns.com/dns-query');
  config.port = port;
  config.remotePds = remote;
  config.stores = stores;
  if (remote != null) {
    config.publicUrl = appViewUrl;
  }
  config.sessionSecret = sessionSecret;
  config.plcStaging = plcStaging;
  config.webDir = value('APP_VIEW_WEB_DIR');
  return config;
}

/**
 * A secp256k1 key the environment gives in hex as `keyName`, or the Cloud
 * KMS key version it gives as `kmsName`, each null when it gives none;
 * what is wrong with them goes in `problems`.
 */
function keyFrom(value: (name: String) => String | null, problems: GrowableArray<String>, keyName: String,
    kmsName: String): (SigningKey | null, String | null) {
  var key: SigningKey | null = null;
  let keyText = value(keyName);
  if (keyText != null) {
    let bytes = decodeKey(keyText);
    if (bytes == null) {
      problems.push(`${keyName} is not 32 bytes of hex`);
    } else {
      key = new SigningKey(KeyType.Secp256k1, bytes);
    }
  }
  let kmsKey = value(kmsName);
  if (keyText != null && kmsKey != null) {
    problems.push(`give ${keyName} or ${kmsName}, not both`);
  }
  if (kmsKey != null && !kmsKey.contains('/cryptoKeyVersions/')) {
    problems.push(`${kmsName} is a key version, projects/…/cryptoKeyVersions/<n>, not ${kmsKey}`);
  }
  return (key, kmsKey);
}

/**
 * The server `config` describes, not yet listening, with `endpoint` as
 * its origin when the configuration leaves it to the server: the PDS's
 * in the same process, or else the App View's.
 */
export async function buildService(config: ServiceConfig, endpoint: String): Future<Service> {
  var appViewStore: AppViewStore = new MemoryAppViewStore();
  var plcLog: PlcLog = new MemoryPlcLog();
  // The App View's stores are its own with a PDS elsewhere, and otherwise
  // beside the PDS's, under its tenant.
  let inProcess = config.pds;
  var tenant: String | null = null;
  var database: String | null = null;
  // What the App View derives from releases: beside the PDS's blobs, or in
  // its own bucket, under the tenant.
  var objects: BlobChoice | null = null;
  let stores = config.stores;
  if (stores != null) {
    if (let StoresInFirestore {tenant: given, database: givenDatabase, objects: givenObjects} = stores) {
      tenant = given;
      database = givenDatabase;
      objects = givenObjects;
    }
  } else if (inProcess != null) {
    if (let InFirestore {tenant: given, blobs, database: givenDatabase} = inProcess.storage) {
      tenant = given;
      database = givenDatabase;
      objects = blobs;
    }
  }
  var derived = new DerivedObjects(new MemoryBlobs(), '');
  if (tenant != null) {
    let db = if (database != null) await Firestore.connect({databaseId: database}) else await Firestore.connect();
    appViewStore = new FirestoreAppViewStore(db, tenant);
    plcLog = new FirestorePlcLog(db, tenant);
    if (objects != null) {
      derived = new DerivedObjects(blobBytes(objects), `${tenant}/app-view/`);
    }
  }
  let plc = if (config.plcStaging) new PlcDirectory(plcLog, config.plcDirectory) else null;
  let settings = config.appView;
  var records: HandleRecords = new MemoryHandleRecords();
  match (settings.records) {
    case RecordsInMemory {}: {}
    case InCloudDns {project, zone}: {
      let dnsProject = project ?? await defaultProjectId();
      records = new CloudDnsRecords(CloudDns.connect(dnsProject, zone));
    }
  }
  let rotationKey = await signerOf(settings.rotationKey, settings.rotationKmsKey);
  let appViewEndpoint = (if (inProcess != null) inProcess.publicUrl else config.publicUrl) ?? endpoint;
  let serviceDid = settings.serviceDid ?? didWebOfOrigin(appViewEndpoint);
  let appViewConfig = new AppViewConfig(serviceDid, settings.domain, appViewEndpoint, rotationKey);
  let signingKey = await signerOf(settings.signingKey, settings.signingKmsKey);
  appViewConfig.signingKey = signingKey;
  appViewConfig.siteUrl = settings.siteUrl;
  appViewConfig.offlineRotationKey = settings.offlineRotationKey;
  appViewConfig.privateReads = settings.privateReads;
  appViewConfig.scopeCreation = settings.scopeCreation;
  appViewConfig.minimumClientVersion = settings.minimumClientVersion;
  appViewConfig.clientNotice = settings.clientNotice;
  for (let did in settings.admins) {
    appViewConfig.admins.add(did);
  }
  for (let name in settings.reservedScopes) {
    appViewConfig.reservedScopes.add(name);
  }
  let resolver = new IdentityResolver();
  resolver.plcDirectory = config.plcDirectory;
  resolver.dnsOverHttps = config.dnsOverHttps;
  let upstream = config.plcDirectory;
  var keys = resolver.signingKeys();
  var submit = async (did: String, operation: PlcOperation): Future<void> => {
    await submitPlcOperation(upstream, did, operation);
  };
  var operations: PlcLogLookup = async (did: String): Future<Array<PlcOperation>> => {
    return await fetchOperations(upstream, did);
  };
  // A release's dependencies are resolved as a fetch of it would resolve
  // them: a staging App View's through its own directory, since they are its.
  var dependencies = resolver;
  if (plc != null) {
    keys = keysThrough(plc, keys);
    submit = async (did: String, operation: PlcOperation): Future<void> => {
      await plc.submit(did, operation);
    };
    operations = async (did: String): Future<Array<PlcOperation>> => {
      return await plc.operations(did);
    };
    dependencies = new IdentityResolver();
    dependencies.plcDirectory = `${appViewConfig.endpoint}/plc`;
    dependencies.dnsOverHttps = config.dnsOverHttps;
  }
  var pds: Pds | null = null;
  var sessions: Sessions | null = null;
  var client: PdsClient | null = null;
  if (inProcess != null) {
    // The PDS keeps managed accounts for the App View it runs with
    // (package-manager.md, "Managed accounts"), which writes to them in
    // process, reading their operations as the App View does.
    let pdsService = await buildPds(inProcess, endpoint, [new TrustedAppView(serviceDid, [rotationKey.publicKey()])],
        operations, keys);
    pds = pdsService.pds;
    sessions = pdsService.sessions;
    client = new InProcessPds(pdsService.pds, serviceDid);
  } else {
    // Without one, the configuration names a PDS elsewhere, which checks
    // the App View's tokens with the key its DID document lists.
    let remote = config.remotePds as RemotePds;
    appViewConfig.pdsEndpoint = remote.url;
    client = new XrpcPds(remote.url, remote.did, serviceDid, signingKey);
  }
  let appView = new AppView(client as PdsClient, appViewConfig, appViewStore, records, keys, submit,
      (count: i32) => randomBytes(count), dependencies);
  appView.derived = derived;
  // A JSON line on standard output, which Cloud Run gives Cloud Logging.
  appView.log = (entry) => {
    console.log(stringify(entry.toJson()));
  };
  let sessionSecret = config.sessionSecret ?? randomBytes(32);
  appView.sessions = new WebSessions(sessionSecret);
  // A DID document is written by whoever controls the DID, so the PDS it
  // names is read only where the App View may read (`AppView.mayRead`):
  // anywhere else, the document resolves with no PDS.
  let readable = (url: String) => appView.mayRead(url);
  resolver.allowsPds = readable;
  dependencies.allowsPds = readable;
  let site = settings.siteUrl;
  let app = if (site == null) withAssets(withPlc(createApp(pds, appView, sessions), plc), config.webDir)
      else byHostName(site, withAssets(createApp(pds, appView, sessions, AppPart.Site), config.webDir),
          withPlc(createApp(pds, appView, sessions, AppPart.Pds), plc));
  return new Service(withPolicy(app), pds, appView, records, plc, sessions);
}

/** The key `kmsKey` names in Cloud KMS, or else `key`, or else one made up now. */
async function signerOf(key: SigningKey | null, kmsKey: String | null): Future<Signer> {
  if (kmsKey != null) {
    return await KmsSigner.connect(CloudKms.connect(kmsKey));
  }
  return new LocalSigner(key ?? new SigningKey(KeyType.Secp256k1, randomBytes(32)));
}

/**
 * An application that gives a request for the host name of `siteUrl` to
 * `site`, and any other to `pds`: the PDS's own name, and the server's
 * address on Cloud Run.
 */
function byHostName(siteUrl: String, site: App, pds: App): App {
  let siteHost = (URL.parse(siteUrl) as URL).host();
  let both = new App();
  both.use(async (req, res, next): Future<void> => {
    if (req.url.host() == siteHost) {
      await site.handleRequest(req, res);
    } else {
      await pds.handleRequest(req, res);
    }
  });
  return both;
}

/**
 * `app`, with the web app's assets in `dir`, when there is one, at
 * `/assets/` and its static documentation pages at `/docs/`. The dynamic
 * pages are `app`'s (`registry/web/routes`).
 */
/**
 * The content security policy of every response the server sends, unless
 * a route sets a stricter one, as those that serve a publisher's bytes do
 * (a release's files, blobs, avatars). It backs up the sanitizing of what
 * pages show from packages and people (a README, a profile): a script the
 * sanitizing missed still cannot run.
 *
 * - Scripts only from the App View itself (`/assets/`), none inline: the
 *   theme script is `/assets/theme.js`.
 * - Styles from the App View and inline, for the `style` attributes of the
 *   docs' highlighted code. A style cannot run script.
 * - Images from the App View, any HTTPS site and `data:`, as a README
 *   shows them.
 * - Connections to the App View and any HTTPS site: signing in talks to
 *   the person's own PDS from the browser.
 * - No plugins, no `<base>`, forms only to the App View, and no framing.
 */
export let PAGE_POLICY = "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; " +
    "img-src 'self' https: data:; connect-src 'self' https:; object-src 'none'; base-uri 'none'; " +
    "form-action 'self'; frame-ancestors 'none';";

/** `app`, with `PAGE_POLICY` on every response that sets no policy of its own. */
function withPolicy(app: App): App {
  let both = new App();
  both.use(async (req, res, next): Future<void> => {
    res.setHeader('content-security-policy', PAGE_POLICY);
    await app.handleRequest(req, res);
  });
  return both;
}

function withAssets(app: App, dir: String | null): App {
  if (dir == null) {
    return app;
  }
  let both = new App();
  both.use(mount('/assets', serveFiles(dir)));
  both.use(mount('/docs', serveFiles(`${dir}/docs`)));
  both.use(async (req, res, next): Future<void> => {
    await app.handleRequest(req, res);
  });
  return both;
}

/** `app`, with `/plc/` answered by `plc` when there is one. */
function withPlc(app: App, plc: PlcDirectory | null): App {
  if (plc == null) {
    return app;
  }
  let directory = plc.app();
  let both = new App();
  both.use(async (req, res, next): Future<void> => {
    if (req.path.startsWith('/plc/')) {
      req.bodyLimit = REQUEST_BODY_LIMIT;
      await directory.handleRequest(req, res);
    } else {
      await app.handleRequest(req, res);
    }
  });
  return both;
}

/**
 * Signing keys for service auth that resolve a `did:plc` through `plc`,
 * which reads the DIDs it has not recorded from upstream, and any other
 * DID with `others`.
 */
function keysThrough(plc: PlcDirectory, others: SigningKeyLookup): SigningKeyLookup {
  return async (did: String, fresh: boolean): Future<PublicKey | null> => {
    if (!did.startsWith('did:plc:')) {
      return await others(did, fresh);
    }
    let document = await plc.document(did);
    return if (document == null) null else parseDidDocument(document, did).signingKey;
  };
}

/** A listening server, and the service it serves. */
export final class Running {
  /** Kept open: it runs until `close()`, or until its scope is cancelled. */
  server: Unmanaged<Server>;
  service: Service;
  /** The origin it listens on, `http://127.0.0.1:<port>`. */
  origin: String;

  new(this.server, this.service, this.origin);
}

/**
 * Builds the server `config` describes and listens on its port. When the
 * configuration leaves the server's origin to it, it is the listening
 * origin, known once the port is.
 */
export async function serve(config: ServiceConfig): Future<Running> {
  var built: Service | null = null;
  let listening = await listen(config.port, async (origin): Future<App> => {
    let service = await buildService(config, origin);
    built = service;
    return service.app;
  });
  return new Running(listening.server, built as Service, listening.origin);
}
