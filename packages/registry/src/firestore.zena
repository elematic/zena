/**
 * The App View's stores in Firestore, beside the PDS's (`pds/firestore`),
 * under the same `tenants/{tenant}`, or under a tenant of their own when
 * the PDS is elsewhere:
 *
 * - A staging PLC directory's (`FirestorePlcLog`): `plc/{did}`: `length`,
 *   the number of operations; and under it `ops/{index}`: `json`, each
 *   operation, with indexes padded to eight digits so they list in order.
 * - The App View's (`FirestoreAppViewStore`): `appViewAccounts/{did}`:
 *   `handle`, `kind`, `scope` and `name`, each account the App View made;
 *   `scopes/{scope}`: `org`;
 *   `names/{name}.{scope}`: `did`, `scope` and `name`;
 *   `summaries/{did}`: a package's summary, `handle`, `scope`, `name`,
 *   `description`, `license` and `latest` (each absent for none),
 *   `releases`, `bytes`, the bytes of their blobs, and `rev`, the revision
 *   of the commit it was made from;
 *   `mentions/{subject}/by/{account}`: `account`, for each account whose
 *   records or entries mention a person's DID or a team, `<org DID> <team>`;
 *   `entries/{did}/list/{id}`: `cbor`, a member entry's DAG-CBOR;
 *   `automationTokens/{did}`: `hash`, the SHA-256 of the token an
 *   automation account calls with, in hex; `limits/{did}`: the limits
 *   the operator set on an account, each an integer named for its limit
 *   (`limitName`); and `counts/{subject} {limit} {period}`: `count`, how
 *   many actions or creations a count has had, and for a day's count
 *   `expiresAt`, two days on, which the database's TTL policy deletes it
 *   at; `scopeCreators/{did}`: `addedBy` and `addedAt`, each account
 *   the admins listed as one that may create scopes;
 *   `publications/{pkg}/releases/{version}`: `cid`, `publisher`,
 *   `publisherClient`, `heldAt`, `completer`, `completerClient` and
 *   `completedAt`, how each release was published, with the clients'
 *   user-agents absent for none (a held release's `client` is its
 *   publisher's); and `activity/{id}`: `at`, `actor`, `method`, `kind`
 *   and `outcome`, with optional `scope`, `account`, `accountKind`,
 *   `handle`, `collection`, `rkey`, `before`, `after` and `detail`,
 *   under a reverse-timestamp ID (`activityEventId`) so `__name__`
 *   orders newest first with single-field indexes alone.
 */

import {Future} from 'zena:async';
import {Option, Some, some} from 'zena:core';
import {div} from 'zena:math';
import {parseJson, stringify} from 'zena:json';
import {
  CollectionReference, Fields, Firestore, Operator, DocumentReference, DocumentSnapshot, bytesValue, referenceValue,
  stringValue
} from 'google-cloud/firestore';
import {decodeCbor, encodeCbor} from 'atproto/cbor';
import {Cid} from 'atproto/cid';
import {compareKeys} from 'atproto/mst';
import {PlcOperation} from 'atproto/plc';
import {MemberEntry} from 'package-manager/records';
import {
  BATCH_WRITES, bytesAt, cidAt, claim, kindName, kindNamed, recordId, release, stringAt, tenantRoot
} from 'pds/firestore';
import {
  ALL_TIME, ActivityEvent, ActivityQuery, ClaimedName, ClaimedScope, AppViewAccount, AppViewStore, Count, LIMITS, Limit,
  Limits, PackageSummary, PendingChange, PendingRelease, Publication, ScopeCreator, limitName, matchesActivityQuery
} from './app-view.zena';
import {PlcLog} from './plc-directory.zena';

/** The App View's names and entries in Firestore, for `tenant`. */
export final class FirestoreAppViewStore implements AppViewStore {
  #db: Firestore;
  #root: DocumentReference;

  new(db: Firestore, tenant: String) : #db = db, #root = tenantRoot(db, tenant);

  async putAccount(account: AppViewAccount): Future<void> {
    await this.#root.collection('appViewAccounts').doc(account.did).set(new Fields()
      .string('handle', account.handle)
      .string('kind', kindName(account.kind))
      .string('scope', account.scope)
      .string('name', account.name));
  }

  async account(did: String): Future<AppViewAccount | null> {
    return appViewAccountFrom(await this.#root.collection('appViewAccounts').doc(did).get());
  }

  async accounts(): Future<Array<AppViewAccount>> {
    let all = new GrowableArray<AppViewAccount>();
    for (let snapshot in await this.#root.collection('appViewAccounts').get()) {
      let account = appViewAccountFrom(snapshot);
      if (account != null) {
        all.push(account);
      }
    }
    return all;
  }

  async scopeOwner(scope: String): Future<String | null> {
    return stringAt(await this.#root.collection('scopes').doc(scope).get(), 'org');
  }

  async claimScope(scope: String, org: String): Future<boolean> {
    return await claim(this.#db, this.#root.collection('scopes').doc(scope), new Fields().string('org', org));
  }

  async releaseScope(scope: String, org: String): Future<void> {
    await release(this.#db, this.#root.collection('scopes').doc(scope), 'org', org);
  }

  async nameInScope(scope: String, name: String): Future<String | null> {
    return stringAt(await this.#root.collection('names').doc(`${name}.${scope}`).get(), 'did');
  }

  async claimName(scope: String, name: String, did: String): Future<boolean> {
    return await claim(this.#db, this.#root.collection('names').doc(`${name}.${scope}`),
        new Fields().string('did', did).string('scope', scope).string('name', name));
  }

  async releaseName(scope: String, name: String, did: String): Future<void> {
    await release(this.#db, this.#root.collection('names').doc(`${name}.${scope}`), 'did', did);
  }

  async allScopes(): Future<Array<ClaimedScope>> {
    let all = new GrowableArray<ClaimedScope>();
    for (let snapshot in await this.#root.collection('scopes').get()) {
      let org = stringAt(snapshot, 'org');
      if (org != null) {
        all.push(new ClaimedScope(snapshot.id, org));
      }
    }
    return all;
  }

  async allNames(): Future<Array<ClaimedName>> {
    let all = new GrowableArray<ClaimedName>();
    for (let snapshot in await this.#root.collection('names').get()) {
      let scope = stringAt(snapshot, 'scope');
      let name = stringAt(snapshot, 'name');
      let did = stringAt(snapshot, 'did');
      if (scope != null && name != null && did != null) {
        all.push(new ClaimedName(scope, name, did));
      }
    }
    return all;
  }

  async putSummary(summary: PackageSummary, rev: String): Future<void> {
    let ref = this.#root.collection('summaries').doc(summary.did);
    await this.#db.runTransaction<boolean>(async (tx): Future<boolean> => {
      let kept = stringAt(await tx.get(ref), 'rev');
      if (kept != null && compareKeys(kept, rev) >= 0) {
        return false;
      }
      let fields = new Fields()
        .string('handle', summary.handle)
        .string('scope', summary.scope)
        .string('name', summary.name)
        .integer('releases', summary.releases as i64)
        .integer('bytes', summary.bytes)
        .string('rev', rev);
      if (summary.description != null) {
        fields.string('description', summary.description as String);
      }
      if (summary.license != null) {
        fields.string('license', summary.license as String);
      }
      if (summary.latest != null) {
        fields.string('latest', summary.latest as String);
      }
      tx.set(ref, fields);
      return true;
    });
  }

  async addMentions(account: String, subjects: Array<String>): Future<void> {
    var i = 0;
    while (i < subjects.length) {
      let batch = this.#db.batch();
      let end = if (subjects.length - i > BATCH_WRITES) i + BATCH_WRITES else subjects.length;
      for (var j = i; j < end; j += 1) {
        batch.set(this.#root.collection('mentions').doc(subjects[j]).collection('by').doc(account),
            new Fields().string('account', account));
      }
      await batch.commit();
      i = end;
    }
  }

  async mentionsOf(subject: String): Future<Array<String>> {
    let out = new GrowableArray<String>();
    for (let snapshot in await this.#root.collection('mentions').doc(subject).collection('by').get()) {
      out.push(snapshot.id);
    }
    return out;
  }

  async summaries(scope: String | null): Future<Array<PackageSummary>> {
    let collection = this.#root.collection('summaries');
    let snapshots = if (scope != null) await collection.where('scope', Operator.Equal, stringValue(scope)).get()
        else await collection.get();
    let out = new GrowableArray<PackageSummary>();
    for (let snapshot in snapshots) {
      let handle = stringAt(snapshot, 'handle');
      let inScope = stringAt(snapshot, 'scope');
      let name = stringAt(snapshot, 'name');
      if (handle == null || inScope == null || name == null) {
        continue;
      }
      let summary = new PackageSummary(snapshot.id, handle, inScope, name);
      summary.description = stringAt(snapshot, 'description');
      summary.license = stringAt(snapshot, 'license');
      summary.latest = stringAt(snapshot, 'latest');
      if (let (true, releases) = snapshot.getInteger('releases')) {
        summary.releases = releases as i32;
      }
      if (let (true, bytes) = snapshot.getInteger('bytes')) {
        summary.bytes = bytes;
      }
      summary.rev = stringAt(snapshot, 'rev');
      out.push(summary);
    }
    return out;
  }

  async entries(account: String): Future<Array<MemberEntry>> {
    let entries = new GrowableArray<MemberEntry>();
    for (let snapshot in await this.#root.collection('entries').doc(account).collection('list').get()) {
      let bytes = bytesAt(snapshot, 'cbor');
      if (bytes != null) {
        entries.push(MemberEntry.fromValue(decodeCbor(bytes)));
      }
    }
    return entries;
  }

  /** Held releases, at `pending/<pkg>/releases/<version>`. */
  #held(pkg: String): CollectionReference {
    return this.#root.collection('pending').doc(pkg).collection('releases');
  }

  async holdRelease(pkg: String, release: PendingRelease): Future<boolean> {
    let fields = new Fields()
        .set('cbor', bytesValue(release.record as ByteArray))
        .string('cid', release.cid.toString())
        .string('publisher', release.publisher)
        .integer('heldAt', release.heldAt);
    let client = release.client;
    if (client != null) {
      fields.string('client', client);
    }
    return await claim(this.#db, this.#held(pkg).doc(recordId(release.version)), fields);
  }

  /** Publications, at `publications/<pkg>/releases/<version>`. */
  #published(pkg: String): CollectionReference {
    return this.#root.collection('publications').doc(pkg).collection('releases');
  }

  async putPublication(pkg: String, publication: Publication): Future<void> {
    let fields = new Fields()
        .string('cid', publication.cid.toString())
        .string('publisher', publication.publisher)
        .integer('heldAt', publication.heldAt)
        .string('completer', publication.completer)
        .integer('completedAt', publication.completedAt);
    let publisherClient = publication.publisherClient;
    if (publisherClient != null) {
      fields.string('publisherClient', publisherClient);
    }
    let completerClient = publication.completerClient;
    if (completerClient != null) {
      fields.string('completerClient', completerClient);
    }
    await this.#published(pkg).doc(recordId(publication.version)).set(fields);
  }

  async publications(pkg: String): Future<Array<Publication>> {
    let all = new GrowableArray<Publication>();
    for (let snapshot in await this.#published(pkg).get()) {
      let publication = publicationAt(snapshot);
      if (publication != null) {
        all.push(publication);
      }
    }
    return all;
  }

  async heldRelease(pkg: String, version: String): Future<PendingRelease | null> {
    return pendingAt(await this.#held(pkg).doc(recordId(version)).get(), version);
  }

  async heldReleases(pkg: String): Future<Array<PendingRelease>> {
    let held = new GrowableArray<PendingRelease>();
    for (let snapshot in await this.#held(pkg).get()) {
      let release = pendingAt(snapshot, null);
      if (release != null) {
        held.push(release);
      }
    }
    return held;
  }

  async dropRelease(pkg: String, version: String): Future<void> {
    await this.#held(pkg).doc(recordId(version)).delete();
  }

  /** Held changes, at `pending/<account>/changes/<collection> <rkey>`. */
  #changes(account: String): CollectionReference {
    return this.#root.collection('pending').doc(account).collection('changes');
  }

  async holdChange(account: String, change: PendingChange): Future<void> {
    var fields = new Fields()
        .string('collection', change.collection)
        .string('rkey', change.rkey)
        .set('cbor', bytesValue(change.record as ByteArray))
        .string('cid', change.cid.toString())
        .string('proposer', change.proposer)
        .integer('heldAt', change.heldAt);
    let base = change.base;
    if (base != null) {
      fields = fields.string('base', base.toString());
    }
    await this.#changes(account).doc(changeId(change.collection, change.rkey)).set(fields);
  }

  async heldChange(account: String, collection: String, rkey: String): Future<PendingChange | null> {
    return changeAt(await this.#changes(account).doc(changeId(collection, rkey)).get());
  }

  async heldChanges(account: String): Future<Array<PendingChange>> {
    let held = new GrowableArray<PendingChange>();
    for (let snapshot in await this.#changes(account).get()) {
      let change = changeAt(snapshot);
      if (change != null) {
        held.push(change);
      }
    }
    return held;
  }

  async dropChange(account: String, collection: String, rkey: String, cid: Cid): Future<void> {
    await release(this.#db, this.#changes(account).doc(changeId(collection, rkey)), 'cid', cid.toString());
  }

  /** Adds `entries`, each under the base32 CID of its DAG-CBOR, its commitment. */
  async addEntries(account: String, entries: Array<MemberEntry>): Future<void> {
    let list = this.#root.collection('entries').doc(account).collection('list');
    let batch = this.#db.batch();
    for (let entry in entries) {
      let bytes = encodeCbor(entry.toValue());
      batch.set(list.doc(entry.commitment().toString()), new Fields().set('cbor', bytesValue(bytes as ByteArray)));
    }
    await batch.commit();
  }

  async setAutomationToken(did: String, hash: String): Future<void> {
    await this.#root.collection('automationTokens').doc(did).set(new Fields().string('hash', hash));
  }

  async automationAccountOf(hash: String): Future<String | null> {
    let found = await this.#root.collection('automationTokens').where('hash', Operator.Equal, stringValue(hash)).get();
    for (let snapshot in found) {
      return snapshot.id;
    }
    return null;
  }

  async limits(did: String): Future<Limits> {
    return limitsFrom(await this.#root.collection('limits').doc(did).get());
  }

  async setLimit(did: String, limit: Limit, value: Option<i64>): Future<void> {
    let ref = this.#root.collection('limits').doc(did);
    await this.#db.runTransaction<boolean>(async (tx): Future<boolean> => {
      let limits = limitsFrom(await tx.get(ref));
      limits.set(limit, value);
      let fields = new Fields();
      for (let each in LIMITS) {
        if (let Some {value: set} = limits.get(each)) {
          fields.integer(limitName(each), set);
        }
      }
      tx.set(ref, fields);
      return true;
    });
  }

  async addCounts(counts: Array<Count>, nowMicros: i64): Future<Count | null> {
    let refs = new GrowableArray<DocumentReference>();
    for (let count in counts) {
      refs.push(this.#root.collection('counts').doc(count.key));
    }
    // A day's count is kept two days past its time, which covers every
    // time zone's day; the TTL policy on `expiresAt` deletes it after.
    let expiresAt = div(nowMicros, 1000000 as i64) + ((2 * 24 * 60 * 60) as i64);
    return await this.#db.runTransaction<Count | null>(async (tx): Future<Count | null> => {
      let values = new GrowableArray<i64>();
      for (var i = 0; i < counts.length; i += 1) {
        let snapshot = await tx.get(refs[i]);
        let value = if (let (true, n) = snapshot.getInteger('count')) { n } else { 0 as i64 };
        if (value >= counts[i].max) {
          return counts[i];
        }
        values.push(value);
      }
      for (var i = 0; i < counts.length; i += 1) {
        let fields = new Fields().integer('count', values[i] + 1);
        if (counts[i].period != ALL_TIME) {
          fields.timestamp('expiresAt', expiresAt);
        }
        tx.set(refs[i], fields);
      }
      return null;
    });
  }

  async putScopeCreator(creator: ScopeCreator): Future<void> {
    await this.#root.collection('scopeCreators').doc(creator.did).set(new Fields()
      .string('addedBy', creator.addedBy)
      .integer('addedAt', creator.addedAt));
  }

  async deleteScopeCreator(did: String): Future<void> {
    await this.#root.collection('scopeCreators').doc(did).delete();
  }

  async scopeCreator(did: String): Future<ScopeCreator | null> {
    return scopeCreatorFrom(await this.#root.collection('scopeCreators').doc(did).get());
  }

  async scopeCreators(): Future<Array<ScopeCreator>> {
    let all = new GrowableArray<ScopeCreator>();
    for (let snapshot in await this.#root.collection('scopeCreators').get()) {
      let creator = scopeCreatorFrom(snapshot);
      if (creator != null) {
        all.push(creator);
      }
    }
    return all;
  }

  async appendActivity(event: ActivityEvent): Future<void> {
    let fields = new Fields()
      .integer('at', event.at)
      .string('actor', event.actor)
      .string('method', event.method)
      .string('kind', event.kind)
      .string('outcome', event.outcome);
    if (event.scope != null) {
      fields.string('scope', event.scope as String);
    }
    if (event.account != null) {
      fields.string('account', event.account as String);
    }
    if (event.accountKind != null) {
      fields.string('accountKind', event.accountKind as String);
    }
    if (event.handle != null) {
      fields.string('handle', event.handle as String);
    }
    if (event.collection != null) {
      fields.string('collection', event.collection as String);
    }
    if (event.rkey != null) {
      fields.string('rkey', event.rkey as String);
    }
    if (event.before != null) {
      fields.string('before', (event.before as Cid).toString());
    }
    if (event.after != null) {
      fields.string('after', (event.after as Cid).toString());
    }
    if (event.detail != null) {
      fields.string('detail', event.detail as String);
    }
    await this.#root.collection('activity').doc(event.id).set(fields);
  }

  async activity(query: ActivityQuery): Future<Array<ActivityEvent>> {
    let out = new GrowableArray<ActivityEvent>();
    if (query.limit <= 0) {
      return out;
    }
    let collection = this.#root.collection('activity');
    var primaryField: String | null = null;
    var primaryValue: String | null = null;
    var filterCount = 0;
    let consider = (field: String, value: String | null) => {
      if (value != null) {
        if (filterCount == 0) {
          primaryField = field;
          primaryValue = value;
        }
        filterCount += 1;
      }
    };
    consider('account', query.account);
    consider('actor', query.actor);
    consider('scope', query.scope);
    consider('outcome', query.outcome);
    consider('kind', query.kind);
    let base = if (primaryField != null && primaryValue != null)
        collection.where(primaryField, Operator.Equal, stringValue(primaryValue))
            .orderBy('__name__')
        else collection.orderBy('__name__');
    var cursor = query.after;
    if (cursor != null && (cursor.length == 0 || cursor.contains('/'))) {
      cursor = null;
    }
    if (filterCount <= 1) {
      var single = base;
      if (cursor != null) {
        single = single.startAfter([referenceValue(collection.doc(cursor))]);
      }
      for (let snapshot in await single.limit(query.limit).get()) {
        let event = activityFrom(snapshot);
        if (event != null) {
          out.push(event);
        }
      }
      return out;
    }
    let batchSize = if (query.limit > 50) query.limit else 50;
    while (out.length < query.limit) {
      var page = base;
      if (cursor != null) {
        page = page.startAfter([referenceValue(collection.doc(cursor))]);
      }
      let snapshots = await page.limit(batchSize).get();
      if (snapshots.length == 0) {
        break;
      }
      for (let snapshot in snapshots) {
        cursor = snapshot.id;
        let event = activityFrom(snapshot);
        if (event != null && matchesActivityQuery(event, query)) {
          out.push(event);
          if (out.length >= query.limit) {
            break;
          }
        }
      }
      if (snapshots.length < batchSize) {
        break;
      }
    }
    return out;
  }
}

/** The activity event `snapshot` holds, or null when it holds none. */
function activityFrom(snapshot: DocumentSnapshot): ActivityEvent | null {
  let actor = stringAt(snapshot, 'actor');
  let method = stringAt(snapshot, 'method');
  let kind = stringAt(snapshot, 'kind');
  let outcome = stringAt(snapshot, 'outcome');
  if (actor == null || method == null || kind == null || outcome == null) {
    return null;
  }
  var at = 0 as i64;
  if (let (true, micros) = snapshot.getInteger('at')) {
    at = micros;
  }
  let event = new ActivityEvent(snapshot.id, at, actor, method, kind, outcome);
  event.scope = stringAt(snapshot, 'scope');
  event.account = stringAt(snapshot, 'account');
  event.accountKind = stringAt(snapshot, 'accountKind');
  event.handle = stringAt(snapshot, 'handle');
  event.collection = stringAt(snapshot, 'collection');
  event.rkey = stringAt(snapshot, 'rkey');
  let before = stringAt(snapshot, 'before');
  if (before != null) {
    event.before = Cid.parse(before);
  }
  let after = stringAt(snapshot, 'after');
  if (after != null) {
    event.after = Cid.parse(after);
  }
  event.detail = stringAt(snapshot, 'detail');
  return event;
}

/** The limits a `limits/{did}` document sets, each a field named for its limit. */
function limitsFrom(snapshot: DocumentSnapshot): Limits {
  let limits = new Limits();
  for (let limit in LIMITS) {
    if (let (true, value) = snapshot.getInteger(limitName(limit))) {
      limits.set(limit, some(value));
    }
  }
  return limits;
}

/** The listing `snapshot` holds, or null when it holds none. */
function scopeCreatorFrom(snapshot: DocumentSnapshot): ScopeCreator | null {
  let addedBy = stringAt(snapshot, 'addedBy');
  if (addedBy == null) {
    return null;
  }
  if (let (true, addedAt) = snapshot.getInteger('addedAt')) {
    return new ScopeCreator(snapshot.id, addedBy, addedAt);
  }
  return null;
}

/** A staging PLC directory's operations in Firestore, for `tenant`. */
export final class FirestorePlcLog implements PlcLog {
  #db: Firestore;
  #root: DocumentReference;

  new(db: Firestore, tenant: String) : #db = db, #root = tenantRoot(db, tenant);

  async operations(did: String): Future<Array<PlcOperation>> {
    let operations = new GrowableArray<PlcOperation>();
    for (let snapshot in await this.#root.collection('plc').doc(did).collection('ops').get()) {
      let text = stringAt(snapshot, 'json');
      if (text != null) {
        operations.push(PlcOperation.fromJson(parseJson(text)));
      }
    }
    return operations;
  }

  async append(did: String, index: i32, operation: PlcOperation): Future<boolean> {
    let head = this.#root.collection('plc').doc(did);
    let entry = head.collection('ops').doc(padIndex(index));
    let json = stringify(operation.toJson());
    return await this.#db.runTransaction<boolean>(async (tx): Future<boolean> => {
      var length = 0 as i64;
      if (let (true, recorded) = (await tx.get(head)).getInteger('length')) {
        length = recorded;
      }
      if (length != index as i64) {
        return false;
      }
      tx.set(entry, new Fields().string('json', json));
      tx.set(head, new Fields().integer('length', (index + 1) as i64));
      return true;
    });
  }
}

/** `index` with zeros before it, to eight digits. */
function padIndex(index: i32): String {
  var text = `${index}`;
  while (text.length < 8) {
    text = `0${text}`;
  }
  return text;
}

/** The held release `snapshot` is, at `version` or its own ID's; null when it does not exist. */
function pendingAt(snapshot: DocumentSnapshot, version: String | null): PendingRelease | null {
  let record = bytesAt(snapshot, 'cbor');
  let cid = cidAt(snapshot);
  let publisher = stringAt(snapshot, 'publisher');
  if (record == null || cid == null || publisher == null) {
    return null;
  }
  var heldAt = 0 as i64;
  if (let (true, micros) = snapshot.getInteger('heldAt')) {
    heldAt = micros;
  }
  let id = snapshot.id;
  let key = version ?? (if (id.startsWith('%')) id.sliceBytes(1, id.length) else id);
  let held = new PendingRelease(key, record, cid, publisher, heldAt);
  held.client = stringAt(snapshot, 'client');
  return held;
}

/** The publication `snapshot` holds, at the version its ID names; null when it holds none. */
function publicationAt(snapshot: DocumentSnapshot): Publication | null {
  let cid = cidAt(snapshot);
  let publisher = stringAt(snapshot, 'publisher');
  let completer = stringAt(snapshot, 'completer');
  if (cid == null || publisher == null || completer == null) {
    return null;
  }
  var heldAt = 0 as i64;
  if (let (true, micros) = snapshot.getInteger('heldAt')) {
    heldAt = micros;
  }
  var completedAt = 0 as i64;
  if (let (true, micros) = snapshot.getInteger('completedAt')) {
    completedAt = micros;
  }
  let id = snapshot.id;
  let version = if (id.startsWith('%')) id.sliceBytes(1, id.length) else id;
  return new Publication(version, cid, publisher, stringAt(snapshot, 'publisherClient'), heldAt, completer,
      stringAt(snapshot, 'completerClient'), completedAt);
}

/** The document ID of the held change to the record at `collection/rkey`. */
function changeId(collection: String, rkey: String): String {
  return `${collection} ${rkey}`;
}

/** The held change `snapshot` is; null when it does not exist. */
function changeAt(snapshot: DocumentSnapshot): PendingChange | null {
  let collection = stringAt(snapshot, 'collection');
  let rkey = stringAt(snapshot, 'rkey');
  let record = bytesAt(snapshot, 'cbor');
  let cid = cidAt(snapshot);
  let proposer = stringAt(snapshot, 'proposer');
  if (collection == null || rkey == null || record == null || cid == null || proposer == null) {
    return null;
  }
  let base = stringAt(snapshot, 'base');
  var heldAt = 0 as i64;
  if (let (true, micros) = snapshot.getInteger('heldAt')) {
    heldAt = micros;
  }
  return new PendingChange(collection, rkey, record, cid,
      if (base == null) null else Cid.parse(base), proposer, heldAt);
}

/** The App View's account in `snapshot`, or null when there is none. */
function appViewAccountFrom(snapshot: DocumentSnapshot): AppViewAccount | null {
  let handle = stringAt(snapshot, 'handle');
  let kind = stringAt(snapshot, 'kind');
  let scope = stringAt(snapshot, 'scope');
  let name = stringAt(snapshot, 'name');
  if (handle == null || kind == null || scope == null || name == null) {
    return null;
  }
  return new AppViewAccount(snapshot.id, handle, kindNamed(kind), scope, name);
}
