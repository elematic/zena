/**
 * A scope's page: its profile, its packages, its owners and publishers, the
 * organization it belongs to, and, for an organization, its members, its
 * teams and the scopes that belong to it.
 */

import {GrowableArray} from 'zena:core';
import {Router, TemplateValue, html} from 'zena:http';
import {percentDecode} from 'zena:url';
import {ScopeMaintainers} from 'package-manager/records';
import {AppView, AppViewAccount, ScopeDetail} from '../../app-view.zena';
import {page} from '../layout.zena';
import {People} from '../people.zena';
import {contextOf} from '../session.zena';
import {count, each, externalLink, when} from '../partials/common.zena';
import {addTeamScopes, maintainerList, members, shownWith, visibleEntries} from '../partials/members.zena';
import {packageList} from '../partials/packages.zena';
import {notFound} from './not-found.zena';

/** Adds the scope page, `/scopes/<name>`, to `router`. */
export function scopePage(router: Router, appView: AppView, people: People): void {
  router.get('/scopes/:name', async (req, res, next, params) => {
    let context = await contextOf(req, appView, people);
    let name = percentDecode(params['name'] ?? '');
    let scope = await appView.getScope(name);
    if (scope == null) {
      notFound(res, context, `No scope here is named ${name}.`);
      return;
    }
    let found = scope;
    let packages = await appView.listPackages(name);
    let organization = found.organization;
    let belongsTo = found.belongsTo;
    // The entries the viewer may see, of the maintainers, the members and
    // every team, in one map: each commitment is a different hash.
    let entries = await visibleEntries(context, found.did, null);
    if (organization) {
      for (let memberEntry in await visibleEntries(context, found.did, null, true)) {
        entries[memberEntry.key] = memberEntry.value;
      }
    }
    for (let named in found.teams) {
      for (let teamEntry in await visibleEntries(context, found.did, named.name)) {
        entries[teamEntry.key] = teamEntry.value;
      }
    }
    let named = new GrowableArray<String>();
    let maintainers = found.maintainers;
    if (maintainers != null) {
      for (let maintainer in maintainers.maintainers) {
        if (maintainer.did != null) {
          named.push(maintainer.did as String);
        }
      }
    }
    let shown = await shownWith(context, entries, named);
    if (maintainers != null) {
      await addTeamScopes(shown, maintainers.maintainers);
    }
    let teams = new GrowableArray<TemplateValue>();
    for (let team in found.teams) {
      teams.push(html`
        <h3 class="mono">${team.name}</h3>
        ${members(team.team.members, shown, 'No members.')}`);
    }
    let profile = found.profile;
    let displayName = profile?.displayName;
    let description = profile?.description;
    let website = profile?.website;
    res.type = 'text/html; charset=utf-8';
    res.body = page(`${displayName ?? name} · Zena packages`, context, html`
      <div>
        <h1>${name}</h1>
        ${when(displayName != null, () => html`<p><strong>${displayName as String}</strong></p>`)}
        ${when(description != null, () => html`<p>${description as String}</p>`)}
        <div class="meta mono muted">
          <span>${found.handle}</span><span>${found.did}</span>
          ${when(organization, () => html`<span>organization</span>`)}
          ${externalLink(website, 'Website')}
        </div>
        ${when(belongsTo != null, () => html`
        <p>Part of the organization
          <a href="/scopes/${(belongsTo as AppViewAccount).scope}">${(belongsTo as AppViewAccount).scope}</a>.</p>`)}
      </div>
      <section>
        <h2>Packages</h2>
        ${packageList(packages, 'This scope has no packages yet.')}
      </section>
      <section>
        <h2>Maintainers</h2>
        ${if (maintainers == null) html`<p class="muted">No maintainers record.</p>` else html`
          ${maintainerList(maintainers.maintainers, shown)}
          <p>${ownerPolicy(maintainers)}</p>`}
      </section>
      ${when(organization, () => html`
      <section>
        <h2>Members</h2>
        ${members(found.members, shown, 'No members.')}
      </section>`)}
      ${when(found.scopes.length > 0, () => html`
      <section>
        <h2>Scopes</h2>
        <ul class="plain">${each(found.scopes, (scope) => html`
          <li><a href="/scopes/${scope.scope}">${scope.scope}</a> <span class="mono muted">${scope.handle}</span></li>`)}
        </ul>
      </section>`)}
      ${when(teams.length > 0, () => html`<section><h2>Teams</h2>${teams}</section>`)}
    `);
  });
}

/** How many owners a change to the scope needs. */
function ownerPolicy(record: ScopeMaintainers): TemplateValue {
  return html`
    Owners change the scope and every package's maintainers. A change counts once
    ${count(record.ownerThreshold as i32, 'owner')} ${if (record.ownerThreshold == 1 as i64) 'approves' else 'approve'}
    it. Publishers create packages, and start as owners of each.
  `;
}
