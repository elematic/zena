/** The page for a path no page has, or a thing that does not exist. */

import {Response, html} from 'zena:http';
import {page} from '../layout.zena';
import {PageContext} from '../session.zena';

/** Answers `res` with the not-found page, saying `message`. */
export function notFound(res: Response, context: PageContext, message: String): void {
  res.statusCode = 404;
  res.type = 'text/html; charset=utf-8';
  res.body = page('Not found · Zena packages', context, html`
    <h1>Not found</h1>
    <p>${message} <a href="/">See every package.</a></p>
  `);
}
