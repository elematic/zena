/**
 * The site's sessions: the token of the cookie that keeps a person signed
 * in to the App View's pages (`createWebSession`), and the signatures of
 * the URLs its pages make, such as an avatar's. Both are HMACs under the
 * App View's own secret (`APP_VIEW_SESSION_SECRET`), and stand for nothing
 * at a PDS: a web session is no account's session.
 */

import {constantTimeEquals} from 'zena:crypto';
import {base64Url} from 'zena:encoding';
import {JsonObject} from 'zena:json';
import {HmacTokens} from 'pds:sessions';

/**
 * How long a web session lasts, in seconds. A token in a cookie cannot be
 * revoked, so it is short; the page renews it from the person's own OAuth
 * session, which their PDS can revoke.
 */
export let WEB_SECONDS = (24 * 60 * 60) as i64;

/**
 * Who a web session is for: anyone with an atproto account, signed in to
 * the App View's pages, not an account of a PDS it holds.
 */
export final class WebCaller {
  did: String;
  /** The handle their DID document claims and that resolves back to it, when there is one. */
  handle: String | null;

  new(this.did, this.handle);

  /** What a page calls them: their handle, or their DID. */
  name(): String {
    return this.handle ?? this.did;
  }
}

/** The site's session tokens and URL signatures, under one secret. */
export final class WebSessions {
  #tokens: HmacTokens;

  new(secret: FixedArray<u8>) : #tokens = new HmacTokens(secret);

  /**
   * The token of a web session for `did`, shown as `handle`, for
   * `WEB_SECONDS`. Only `webCaller` accepts it, and it accepts nothing
   * else, so a token of another kind under the same secret never stands
   * for a web session.
   */
  webSession(did: String, handle: String | null, nowSeconds: i64): String {
    let claims = new JsonObject();
    claims['sub'] = did;
    if (handle != null) {
      claims['handle'] = handle;
    }
    claims['iat'] = new Box<f64>(nowSeconds as f64);
    claims['exp'] = new Box<f64>((nowSeconds + WEB_SECONDS) as f64);
    return this.#tokens.sign('web+jwt', claims);
  }

  /** Who `token` is a web session for; null when it is none, or has expired. */
  webCaller(token: String | null, nowSeconds: i64): WebCaller | null {
    if (token == null) {
      return null;
    }
    try {
      let claims = this.#tokens.verify(token, 'web+jwt', nowSeconds);
      let did = claims['sub'];
      let handle = claims['handle'];
      return if (did is String) new WebCaller(did, if (handle is String) handle else null) else null;
    } catch (e) {
      return null;
    }
  }

  /**
   * A signature of `value` for a URL the site makes, such as an avatar's:
   * 16 bytes of an HMAC, so that only URLs the site wrote check
   * (`checkUrlSignature`).
   */
  urlSignature(value: String): String {
    let mac = this.#tokens.mac(`url ${value}`.toBytes());
    let short = new FixedArray<u8>(16, 0 as u8);
    for (var i = 0; i < 16; i += 1) {
      short[i] = mac[i];
    }
    return base64Url.encode(short, false);
  }

  /** Whether `signature` is `urlSignature(value)`. */
  checkUrlSignature(value: String, signature: String | null): boolean {
    if (signature == null) {
      return false;
    }
    return constantTimeEquals(this.urlSignature(value).toBytes(), signature.toBytes());
  }
}
