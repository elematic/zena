let APP_VIEW = 'did:web:pkg.test';
/** The PDS's DID, when the App View reaches it by XRPC. */
let PDS_DID = 'did:web:padstone.test';
let ALICE = 'did:plc:alicealicealicealicealic';
let BOB = 'did:plc:bobbobbobbobbobbobbobbob';
let ALICE_KEY = hex.decode('c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721');
let BOB_KEY = hex.decode('9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60');

/** Storage in memory that counts the accounts and repositories read from it. */
final class CountingStorage implements Storage {
  #inner = new MemoryStorage();
  var reads = 0;

  async getAccount(did: String): Future<Account | null> {
    this.reads += 1;
    return await this.#inner.getAccount(did);
  }

  async accountByHandle(handle: String): Future<Account | null> {
    this.reads += 1;
    return await this.#inner.accountByHandle(handle);
  }

  async putAccount(account: Account): Future<void> {
    await this.#inner.putAccount(account);
  }

  store(did: String): AccountStore {
    this.reads += 1;
    return this.#inner.store(did);
  }

  async reserveKey(didKey: String, reserved: ReservedKey): Future<void> {
    await this.#inner.reserveKey(didKey, reserved);
  }

  async takeReservedKey(didKey: String, reservedFor: String, nowSeconds: i64): Future<ReservedKey | null> {
    return await this.#inner.takeReservedKey(didKey, reservedFor, nowSeconds);
  }
}

/** An App View on a PDS in memory, and the PLC operations it sent. */
final class Fixture {
  var app: App;
  var appView: AppView | null = null;
  pds: Pds;
  /** The PLC operations the App View sent for each DID, oldest first. */
  submitted = new HashMap<String, GrowableArray<PlcOperation>>();
  /** The handles' DNS records the App View wrote. */
  records = new MemoryHandleRecords();
  /** Whether the PLC directory refuses operations. */
  var plcDown = false;
  /**
   * The records in the repositories of callers this App View does not hold,
   * Alice's and Bob's, by `"<did> <collection> <rkey>"`: what the App View
   * reads from their PDSes.
   */
  remote = new HashMap<String, Value>();
  /** The PDS served on a port, when the App View reaches it by XRPC. */
  var #server: Unmanaged<Server> | null = null;
  var #jti = 0;
  var #random = 0;

  /**
   * An App View on `storage`'s PDS, in the same process; or, `overXrpc`, served
   * on a port as a PDS of its own, which trusts the App View's rotation key and
   * which the App View reaches with its own tokens (`XrpcPds`).
   */
  new(store: AppViewStore = new MemoryAppViewStore(), storage: Storage = new MemoryStorage(), overXrpc: boolean = false)
      : pds = new Pds(storage), app = new App() {
    let rotation = new SigningKey(KeyType.Secp256k1, filled(200));
    let config = new AppViewConfig(APP_VIEW, 'pkg.test', 'https://pkg.test', new LocalSigner(rotation));
    let callers: HashMap<String, PublicKey> = {
      ALICE => new SigningKey(KeyType.P256, ALICE_KEY).publicKey(),
      BOB => new SigningKey(KeyType.P256, BOB_KEY).publicKey(),
    };
    let submitted = this.submitted;
    let pds = this.pds;
    var client: PdsClient = new InProcessPds(this.pds, APP_VIEW);
    if (overXrpc) {
      let signing = new SigningKey(KeyType.Secp256k1, filled(199));
      config.signingKey = new LocalSigner(signing);
      pds.managed = new ManagedAccounts(PDS_DID, 'https://pkg.test', [new TrustedAppView(APP_VIEW, [rotation.publicKey()])],
          async (did: String): Future<Array<PlcOperation>> => {
            if (let (true, log) = submitted.get(did)) {
              return log;
            }
            return [];
          },
          async (did: String, fresh: boolean): Future<PublicKey | null> =>
              if (did == APP_VIEW) signing.publicKey() else null);
      let server = new Server(createPdsApp(pds), 0 as u16);
      server.start();
      client = new XrpcPds(`http://127.0.0.1:${server.port as i32}`, PDS_DID, APP_VIEW, new LocalSigner(signing));
      this.#server = server.keepOpen();
    }
    let appView = new AppView(client, config, store, this.records,
        async (did: String, fresh: boolean): Future<PublicKey | null> => {
          if (let (true, key) = callers.get(did)) {
            return key;
          }
          // An account this PDS holds, such as an automation account.
          let held = await pds.storage.getAccount(did);
          return if (held != null) (await held.signingKey()).publicKey() else null;
        },
        async (did: String, operation: PlcOperation): Future<void> => {
          if (this.plcDown) {
            throw new Error('the PLC directory is down');
          }
          if (!submitted.has(did)) {
            submitted[did] = new GrowableArray<PlcOperation>();
          }
          submitted[did].push(operation);
        },
        (count: i32) => {
          this.#random += 1;
          return filled(this.#random);
        },
        unreachableResolver());
    let remote = this.remote;
    appView.remoteRecords = async (did: String, collection: String, rkey: String): Future<Value | null> => {
      if (let (true, value) = remote.get(`${did} ${collection} ${rkey}`)) {
        return value;
      }
      return null;
    };
    this.appView = appView;
    var counter = 0;
    let sessions = new Sessions(this.pds.storage, new MemoryCredentialStore(), filled(77), (count: i32) => {
      counter += 1;
      return new FixedArray<u8>(count, (counter + 100) as u8);
    });
    appView.sessions = new WebSessions(filled(77));
    this.app = createApp(this.pds, appView, sessions);
  }

  /** Stops the PDS served on a port, if there is one. */
  close(): void {
    let server = this.#server;
    if (server != null) {
      server.close();
    }
  }

  /** The genesis operation the App View sent for `did`. */
  genesisOf(did: String): PlcOperation {
    return this.submitted[did][0];
  }

  /** The last operation the App View sent for `did`, which its DID document now follows. */
  latestOf(did: String): PlcOperation {
    let log = this.submitted[did];
    return log[log.length - 1];
  }

  /** An attestation by `caller`, Alice or Bob, of the record at `uri` whose CID is `cid`. */
  attest(caller: String, uri: String, cid: String): void {
    let attestation = new Attestation(uri, Cid.parse(cid), '2026-10-29T00:00:00.000Z');
    this.remote[`${caller} ${ATTESTATION_TYPE} ${attestation.recordKey()}`] = attestation.toValue();
  }

  /** A token from `caller`'s PDS for `method`. */
  token(caller: String, method: String): String {
    this.#jti += 1;
    let seconds = now().seconds;
    let key = if (caller == ALICE) ALICE_KEY else BOB_KEY;
    return createServiceAuthToken(new ServiceAuthClaims(caller, APP_VIEW, seconds + 60, seconds,
        method, `jti-${this.#jti}`), KeyType.P256, key);
  }

  /** Calls the App View method `name` as `caller` with a JSON body, or raw bytes. */
  async call(caller: String | null, name: String, body: String | FixedArray<u8>, query: String = '',
      contentType: String = 'application/json', authorization: String | null = null): Future<Response> {
    let method = `dev.zena-lang.registry.${name}`;
    let headers: HashMap<String, String> = {'content-type' => contentType};
    if (authorization != null) {
      headers['authorization'] = authorization;
    } else if (caller != null) {
      headers['authorization'] = `Bearer ${this.token(caller, method)}`;
    }
    let res = new Response();
    let app = this.app;
    let req = new Request.fromUrl(`http://localhost/xrpc/${method}${query}`, 'POST', headers,
        bytesStream(if (body is String) body.toBytes() else body));
    await app.handleRequest(req, res);
    return res;
  }

  /** Calls the registry query `name` as `caller`, with `query` after the method. */
  async query(caller: String, name: String, query: String): Future<Response> {
    let method = `dev.zena-lang.registry.${name}`;
    let headers: HashMap<String, String> = {
      'authorization' => `Bearer ${this.token(caller, method)}`,
    };
    let res = new Response();
    let app = this.app;
    let req = new Request.fromUrl(`http://localhost/xrpc/${method}${query}`, 'GET', headers);
    await app.handleRequest(req, res);
    return res;
  }

  /** POSTs JSON to `path`, with `token` as a Bearer token when there is one. */
  async post(path: String, body: String, token: String | null): Future<Response> {
    let headers: HashMap<String, String> = {
      'content-type' => 'application/json',
    };
    if (token != null) {
      headers['authorization'] = `Bearer ${token}`;
    }
    let res = new Response();
    let app = this.app;
    let req = new Request.fromUrl(`http://localhost${path}`, 'POST', headers, bytesStream(body.toBytes()));
    await app.handleRequest(req, res);
    return res;
  }

  /** GETs `path` with `token` as a Bearer token. */
  async getWith(path: String, token: String): Future<Response> {
    let headers: HashMap<String, String> = {
      'authorization' => `Bearer ${token}`,
    };
    let res = new Response();
    let app = this.app;
    let req = new Request.fromUrl(`http://localhost${path}`, 'GET', headers);
    await app.handleRequest(req, res);
    return res;
  }

  async get(path: String, cookie: String | null = null): Future<Response> {
    return await this.#send('GET', path, cookie);
  }

  /** A form post to `path`, with no body. */
  async post(path: String, cookie: String | null = null): Future<Response> {
    return await this.#send('POST', path, cookie);
  }

  async #send(method: String, path: String, cookie: String | null): Future<Response> {
    let headers = new HashMap<String, String>();
    if (cookie != null) {
      headers['cookie'] = cookie;
    }
    let res = new Response();
    let app = this.app;
    let req = new Request.fromUrl(`http://localhost${path}`, method, headers);
    await app.handleRequest(req, res);
    return res;
  }
}

/**
 * An App View store whose lookups always miss, as a read can that another
 * server's claim races past.
 */
final class StaleAppViewStore implements AppViewStore {
  #inner = new MemoryAppViewStore();

  async putAccount(account: AppViewAccount): Future<void> { await this.#inner.putAccount(account); }
  async account(did: String): Future<AppViewAccount | null> { return await this.#inner.account(did); }
  async accounts(): Future<Array<AppViewAccount>> { return await this.#inner.accounts(); }
  async scopeOwner(scope: String): Future<String | null> { return null; }
  async claimScope(scope: String, org: String): Future<boolean> { return await this.#inner.claimScope(scope, org); }
  async releaseScope(scope: String, org: String): Future<void> { await this.#inner.releaseScope(scope, org); }
  async nameInScope(scope: String, name: String): Future<String | null> { return null; }
  async claimName(scope: String, name: String, did: String): Future<boolean> {
    return await this.#inner.claimName(scope, name, did);
  }
  async releaseName(scope: String, name: String, did: String): Future<void> {
    await this.#inner.releaseName(scope, name, did);
  }
  async allScopes(): Future<Array<ClaimedScope>> { return await this.#inner.allScopes(); }
  async allNames(): Future<Array<ClaimedName>> { return await this.#inner.allNames(); }
  async putSummary(summary: PackageSummary, rev: String): Future<void> { await this.#inner.putSummary(summary, rev); }
  async summaries(scope: String | null): Future<Array<PackageSummary>> { return await this.#inner.summaries(scope); }
  async addMentions(account: String, subjects: Array<String>): Future<void> {
    await this.#inner.addMentions(account, subjects);
  }
  async mentionsOf(subject: String): Future<Array<String>> { return await this.#inner.mentionsOf(subject); }
  async entries(account: String): Future<Array<MemberEntry>> { return await this.#inner.entries(account); }
  async addEntries(account: String, entries: Array<MemberEntry>): Future<void> {
    await this.#inner.addEntries(account, entries);
  }
  async setAutomationToken(did: String, hash: String): Future<void> { await this.#inner.setAutomationToken(did, hash); }
  async automationAccountOf(hash: String): Future<String | null> { return await this.#inner.automationAccountOf(hash); }
  async holdRelease(pkg: String, release: PendingRelease): Future<boolean> {
    return await this.#inner.holdRelease(pkg, release);
  }
  async heldRelease(pkg: String, version: String): Future<PendingRelease | null> { return null; }
  async heldReleases(pkg: String): Future<Array<PendingRelease>> { return await this.#inner.heldReleases(pkg); }
  async dropRelease(pkg: String, version: String): Future<void> { await this.#inner.dropRelease(pkg, version); }
  async holdChange(account: String, change: PendingChange): Future<void> {
    await this.#inner.holdChange(account, change);
  }
  async heldChange(account: String, collection: String, rkey: String): Future<PendingChange | null> {
    return await this.#inner.heldChange(account, collection, rkey);
  }
  async heldChanges(account: String): Future<Array<PendingChange>> { return await this.#inner.heldChanges(account); }
  async dropChange(account: String, collection: String, rkey: String, cid: Cid): Future<void> {
    await this.#inner.dropChange(account, collection, rkey, cid);
  }
  async limits(did: String): Future<Limits> { return await this.#inner.limits(did); }
  async setLimit(did: String, limit: Limit, value: Option<i64>): Future<void> {
    await this.#inner.setLimit(did, limit, value);
  }
  async addCounts(counts: Array<Count>, nowMicros: i64): Future<Count | null> {
    return await this.#inner.addCounts(counts, nowMicros);
  }
}

/** A day, in microseconds. */
let DAY_MICROS = ((24 * 60 * 60) as i64) * (1000000 as i64);

/** The error the App View refuses `call` with, or '' when it does not. */
async function refusal<T>(call: () => Future<T>): Future<String> {
  try {
    await call();
  } catch (e) {
    if (e is AppViewError) {
      return e.error;
    }
    throw e;
  }
  return '';
}

function filled(value: i32): FixedArray<u8> {
  return new FixedArray<u8>(32, value as u8);
}

function json(res: Response) {
  return parseJson(res.body as String) as JsonObject;
}

function ok(res: Response) {
  isTrue(res.statusCode == 200, `${res.statusCode}: ${res.body as String}`);
  return json(res);
}

function errorOf(res: Response) {
  isTrue(res.statusCode >= 400, `${res.statusCode}`);
  return json(res)['error'] as String;
}

let RECOVERY = formatDidKey(new SigningKey(KeyType.P256, ALICE_KEY).publicKey());

async function createOrganization(fixture: Fixture, caller: String, name: String): Future<Response> {
  return await fixture.call(caller, 'createOrganization', `{"name": "${name}", "recoveryKeys": ["${RECOVERY}"]}`);
}

async function createPackage(fixture: Fixture, caller: String, org: String, name: String): Future<Response> {
  let profile = stringify(toJson(new Profile(name).toValue()));
  let maintainers = stringify(toJson(new Maintainers([Maintainer.ofDid(ALICE, OWNER)]).toValue()));
  return await fixture.call(caller, 'createPackage',
      `{"organization": "${org}", "recoveryKeys": ["${RECOVERY}"], "profile": ${profile}, "maintainers": ${maintainers}}`);
}

/** `caller`'s view of the entries behind `account`'s members, team or maintainers. */
async function entriesSeen(fixture: Fixture, caller: String, account: String, team: String | null = null)
    : Future<Array<MemberEntry>> {
  let query = if (team == null) `?account=${account}` else `?account=${account}&team=${team}`;
  let list = ok(await fixture.query(caller, 'getEntries', query))['entries'] as JsonArray;
  let entries = new GrowableArray<MemberEntry>();
  for (var i = 0; i < list.length; i += 1) {
    entries.push(MemberEntry.fromValue(fromJson(list[i])));
  }
  return entries;
}

/**
 * Scopes acme and zeta; in acme, router, with 1.0.0 and 1.1.0, which is
 * retracted, parser, unreleased, and the automation account ci. Returns
 * router's DID.
 */
async function seedBrowsable(fixture: Fixture): Future<String> {
  let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
  ok(await createOrganization(fixture, BOB, 'zeta'));
  let profile = stringify(toJson(new Profile('router', 'Routes requests', 'MIT').toValue()));
  let maintainers = stringify(toJson(new Maintainers([Maintainer.ofDid(ALICE, OWNER)]).toValue()));
  let router = ok(await fixture.call(ALICE, 'createPackage',
      `{"organization": "${orgDid}", "profile": ${profile}, "maintainers": ${maintainers}}`))['did'] as String;
  ok(await createPackage(fixture, ALICE, orgDid, 'parser'));
  ok(await fixture.call(ALICE, 'createAutomationAccount', `{"organization": "${orgDid}", "name": "ci"}`));
  for (let version in ['1.0.0', '1.1.0']) {
    await release(fixture, ALICE, router, version, await upload(fixture, router, archiveOf(router, version)));
  }
  ok(await fixture.call(ALICE, 'retract', `{"package": "${router}", "version": "1.1.0", "reason": "broken"}`));
  return router;
}

/** The cookie of a web session for `caller`, from `createWebSession`. */
async function webCookie(fixture: Fixture, caller: String): Future<String> {
  let res = await fixture.call(caller, 'createWebSession', '');
  ok(res);
  return (res.getHeader('set-cookie') ?? '').split(';')[0];
}

/** The HTML of a page `res` answered with. */
function pageOf(res: Response) {
  isTrue((res.type ?? '').contains('text/html'), res.type ?? 'no type');
  return (res.body as HTMLPartial).toString();
}

/** The JSON of `entries`, as a list. */
function entriesJson(entries: Array<MemberEntry>) {
  let list = new JsonArray();
  for (let entry in entries) {
    list.push(toJson(entry.toValue()));
  }
  return stringify(list);
}

function commitmentsOf(entries: Array<MemberEntry>) {
  let out = new FixedArray<Cid>(entries.length, Cid.forBlob(new FixedArray<u8>(0, 0 as u8)));
  for (var i = 0; i < entries.length; i += 1) {
    out[i] = entries[i].commitment();
  }
  return out;
}

/** The `swapRecord` member of a call's body, or nothing. */
function swapJson(swap: String | null) {
  return if (swap == null) '' else `, "swapRecord": "${swap}"`;
}

/** `putMembers` as `caller`: a members record committing to `members`, sending `sent`, then `approved`. */
async function putMembers(fixture: Fixture, caller: String, org: String, members: Array<MemberEntry>,
    sent: Array<MemberEntry>, swap: String | null, ownerThreshold: i64 = 1 as i64): Future<Response> {
  return await approved(fixture, caller, await proposeMembers(fixture, caller, org, members, sent, swap, ownerThreshold));
}

/** `putMembers` as `caller`, which only holds the change. */
async function proposeMembers(fixture: Fixture, caller: String, org: String, members: Array<MemberEntry>,
    sent: Array<MemberEntry>, swap: String | null, ownerThreshold: i64 = 1 as i64): Future<Response> {
  let record = stringify(toJson(new Members(commitmentsOf(members), ownerThreshold).toValue()));
  return await fixture.call(caller, 'putMembers',
      `{"organization": "${org}", "members": ${record}, "entries": ${entriesJson(sent)}${swapJson(swap)}}`);
}

/** `putTeam` as `caller`: `org`'s team `name`, committing to `members`, sending them all, then `approved`. */
async function putTeam(fixture: Fixture, caller: String, org: String, name: String, members: Array<MemberEntry>,
    swap: String | null, threshold: i64 = 1 as i64): Future<Response> {
  return await approved(fixture, caller, await proposeTeam(fixture, caller, org, name, members, swap, threshold));
}

/** `putTeam` as `caller`, which only holds the change. */
async function proposeTeam(fixture: Fixture, caller: String, org: String, name: String, members: Array<MemberEntry>,
    swap: String | null, threshold: i64 = 1 as i64): Future<Response> {
  let record = stringify(toJson(new Team(commitmentsOf(members), threshold).toValue()));
  return await fixture.call(caller, 'putTeam',
      `{"organization": "${org}", "name": "${name}", "team": ${record}, "entries": ${entriesJson(members)}${swapJson(swap)}}`);
}

/** `putMaintainers` as `caller`, sending `sent`, then `approved`. */
async function putMaintainers(fixture: Fixture, caller: String, pkg: String, maintainers: Maintainers,
    sent: Array<MemberEntry>, swap: String | null): Future<Response> {
  return await approved(fixture, caller, await proposeMaintainers(fixture, caller, pkg, maintainers, sent, swap));
}

/** `putMaintainers` as `caller`, which only holds the change. */
async function proposeMaintainers(fixture: Fixture, caller: String, pkg: String, maintainers: Maintainers,
    sent: Array<MemberEntry>, swap: String | null): Future<Response> {
  let record = stringify(toJson(maintainers.toValue()));
  return await fixture.call(caller, 'putMaintainers',
      `{"package": "${pkg}", "maintainers": ${record}, "entries": ${entriesJson(sent)}${swapJson(swap)}}`);
}

/**
 * After a put that `held` answered, `caller`'s attestation of the new
 * record and `completeChange`, whose answer it returns: `written` when the
 * record before it allowed `caller` alone. A put that failed is `held`.
 */
async function approved(fixture: Fixture, caller: String, held: Response): Future<Response> {
  if (held.statusCode != 200) {
    return held;
  }
  let body = json(held);
  fixture.attest(caller, body['uri'] as String, body['cid'] as String);
  return await completeChange(fixture, caller, body['uri'] as String, body['cid'] as String);
}

/** `completeChange` of the record at `uri`, as `caller`. */
async function completeChange(fixture: Fixture, caller: String, uri: String, cid: String): Future<Response> {
  return await fixture.call(caller, 'completeChange', `{"uri": "${uri}", "cid": "${cid}"}`);
}

/** `uploadArtifact` as `caller`, which only a maintainer may do. */
async function upload(fixture: Fixture, caller: String, pkg: String): Future<Response> {
  return await fixture.call(caller, 'uploadArtifact', new FixedArray<u8>(4, 1 as u8), `?package=${pkg}`,
      'application/octet-stream');
}

/**
 * A resolver whose directory is a closed port, so a release's dependencies
 * are never found and the tests reach no network.
 */
function unreachableResolver(): IdentityResolver {
  let resolver = new IdentityResolver();
  resolver.plcDirectory = 'http://127.0.0.1:1';
  resolver.dnsOverHttps = 'http://127.0.0.1:1';
  return resolver;
}

/** A source archive of `router` `version`, the package `did`, as `zena pkg publish` packs one. */
function archiveOf(did: String, version: String, manifest: String | null = null): FixedArray<u8> {
  let files: HashMap<String, FixedArray<u8>> = {
    'zena-package.json' => (manifest ?? `{"name": "router", "did": "${did}", "description": "A package for tests", "license": "MIT", "version": "${version}"}`)
      .toBytes(),
    'router.zena' => 'export let route = 1;\n'.toBytes(),
  };
  return packSource(files);
}

/** Uploads `archive` to `pkg` as Alice, and returns its blob. */
async function upload(fixture: Fixture, pkg: String, archive: FixedArray<u8>): Future<BlobRef> {
  return BlobRef.fromValue(fromJson(ok(await fixture.call(ALICE, 'uploadArtifact', archive, `?package=${pkg}`,
      'application/vnd.ipld.car'))['blob'] as JsonObject));
}

/**
 * Publishes `version` of `pkg` as `caller`, Alice or Bob, who attests it
 * and completes it, and returns what `completeRelease` answered.
 */
async function release(fixture: Fixture, caller: String, pkg: String, version: String, blob: BlobRef): Future<JsonObject> {
  let held = ok(await fixture.call(caller, 'publish', `{"package": "${pkg}", "release": ${releaseJson(version, blob)}}`));
  fixture.attest(caller, held['uri'] as String, held['cid'] as String);
  let completed = await complete(fixture, caller, pkg, version);
  equal(completed['state'] as String, 'published');
  return completed;
}

/** `completeRelease` of `version` of `pkg` as `caller`. */
async function complete(fixture: Fixture, caller: String, pkg: String, version: String): Future<JsonObject> {
  return ok(await fixture.call(caller, 'completeRelease', `{"package": "${pkg}", "version": "${version}"}`));
}

/** The DIDs `answer`'s `approvedBy` lists. */
function approvedBy(answer: JsonObject) {
  let list = answer['approvedBy'] as JsonArray;
  let dids = new GrowableArray<String>();
  for (var i = 0; i < list.length; i += 1) {
    dids.push(list[i] as String);
  }
  return join(dids, ' ');
}

function releaseJson(version: String, blob: BlobRef): String {
  let release = new Release(Version.parse(version), '2026-10-23T00:00:00.000Z',
      new FixedArray<Artifact>(1, Artifact.whole(SOURCE, blob)),
      new FixedArray<Dependency>(0, new Dependency('', Version.parse('0.0.0'), '')));
  return stringify(toJson(release.toValue()));
}

export let tests = suite('registry:app-view', () => {
  test('creates an organization and a package, and publishes a release a client verifies', async (ctx) => {
    let fixture = new Fixture();
    let org = ok(await createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    equal(org['handle'] as String, 'acme.pkg.test');
    // The App View sent the organization's genesis operation, which makes
    // its DID, with Alice's recovery key ranked above the App View's key.
    // It is the DID's only operation: it names the signing key the PDS
    // reserved and holds for the account, the PDS, and the App View as
    // `zena_registry`.
    let orgOperation = fixture.genesisOf(orgDid);
    equal(fixture.submitted[orgDid].length, 1);
    equal(didOfGenesis(orgOperation), orgDid);
    equal(orgOperation.rotationKeys[0], RECOVERY);
    equal(orgOperation.rotationKeys.length, 2);
    equal(orgOperation.alsoKnownAs[0], 'at://acme.pkg.test');
    let orgKey = (await ((await fixture.pds.storage.getAccount(orgDid)) as Account).signingKey()).publicKey();
    equal(orgOperation.verificationMethods['atproto'], formatDidKey(orgKey));
    equal(orgOperation.services['atproto_pds'].endpoint, 'https://pkg.test');
    equal(orgOperation.services['zena_registry'].kind, 'ZenaRegistry');
    equal(orgOperation.services['zena_registry'].endpoint, 'https://pkg.test');

    let pkg = ok(await createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    equal(pkg['handle'] as String, 'router.acme.pkg.test');
    // Both handles resolve, by the TXT records the App View wrote.
    equal(fixture.records.lookup('acme.pkg.test') as String, orgDid);
    equal(fixture.records.lookup('router.acme.pkg.test') as String, pkgDid);
    equal(((pkg['maintainers'] as JsonObject)['uri'] as String),
        `at://${pkgDid}/dev.zena-lang.package.maintainers/self`);

    let archive = archiveOf(pkgDid, '1.0.0');
    let uploaded = ok(await fixture.call(ALICE, 'uploadArtifact', archive, `?package=${pkgDid}`,
        'application/vnd.ipld.car'));
    let blobJson = uploaded['blob'] as JsonObject;
    equal(blobJson['mimeType'] as String, 'application/vnd.ipld.car');
    let blob = BlobRef.fromValue(fromJson(blobJson));

    let published = await release(fixture, ALICE, pkgDid, '1.0.0', blob);
    equal(published['uri'] as String, `at://${pkgDid}/${RELEASE_TYPE}/1.0.0`);

    // The release can be fetched with a proof that verifies with the signing
    // key the package's DID document names.
    let signingKey = parseDidKey(fixture.latestOf(pkgDid).verificationMethods['atproto']);
    let proof = await fixture.get(`/xrpc/com.atproto.sync.getRecord?did=${pkgDid}&collection=${RELEASE_TYPE}&rkey=1.0.0`);
    let verified = verifyRecordProof(readCar(proof.body as FixedArray<u8>), pkgDid, RELEASE_TYPE, '1.0.0',
        (signed, sig) => verifySignature(signingKey, signed, sig));
    equal((verified.cid as Cid).toString(), published['cid'] as String);
    let artifact = await fixture.get(`/xrpc/com.atproto.sync.getBlob?did=${pkgDid}&cid=${blob.cid.toString()}`);
    equal(Cid.forBlob(artifact.body as FixedArray<u8>).toString(), Cid.forBlob(archive).toString());

    // A package account is the App View's to write, and its PDS takes no
    // write to it from anyone else.
    let account = (await fixture.pds.storage.getAccount(pkgDid)) as Account;
    equal(account.manager as String, APP_VIEW);
    let post = await fixture.post('/xrpc/com.atproto.repo.putRecord',
        `{"repo": "${pkgDid}", "collection": "app.bsky.feed.post", "rkey": "x", "record": {"$type": "app.bsky.feed.post"}}`,
        fixture.token(ALICE, 'com.atproto.repo.putRecord'));
    equal(post.statusCode, 403);
  });

  test('holds a release out of the repository until its maintainers attest it', async (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkgDid = ok(await createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    let blob = await upload(fixture, pkgDid, archiveOf(pkgDid, '1.0.0'));
    let body = `{"package": "${pkgDid}", "release": ${releaseJson('1.0.0', blob)}}`;
    let held = ok(await fixture.call(ALICE, 'publish', body));
    equal(held['state'] as String, 'pending');
    let uri = held['uri'] as String;
    let cid = held['cid'] as String;
    equal(uri, `at://${pkgDid}/${RELEASE_TYPE}/1.0.0`);

    // Nothing is in the repository, so nothing is in the feed or listed.
    let store = fixture.pds.storage.store(pkgDid);
    isTrue(await store.getRecord(RELEASE_TYPE, '1.0.0') == null, 'not written');
    let listed = ok(await fixture.get('/xrpc/dev.zena-lang.registry.listPackages'))['packages'] as JsonArray;
    isTrue((listed[0] as JsonObject)['latest'] == null, 'no release listed');
    // Publishing it again answers the same; another release of 1.0.0 is refused.
    equal(ok(await fixture.call(ALICE, 'publish', body))['cid'] as String, cid);
    let other = new Release(Version.parse('1.0.0'), '2026-10-24T00:00:00.000Z',
        new FixedArray<Artifact>(1, Artifact.whole(SOURCE, blob)),
        new FixedArray<Dependency>(0, new Dependency('', Version.parse('0.0.0'), '')));
    let refused = await fixture.call(ALICE, 'publish', `{"package": "${pkgDid}", "release": ${stringify(toJson(other.toValue()))}}`);
    equal(errorOf(refused), 'VersionExists');

    // Unattested, it waits.
    let waiting = await complete(fixture, ALICE, pkgDid, '1.0.0');
    equal(waiting['state'] as String, 'pending');
    equal(approvedBy(waiting), '');
    equal((waiting['threshold'] as Box<f64>).value as i32, 1);
    let pending = ok(await fixture.query(ALICE, 'getPendingReleases', `?package=${pkgDid}`))['releases'] as JsonArray;
    equal(pending.length, 1);
    let entry = pending[0] as JsonObject;
    equal(entry['version'] as String, '1.0.0');
    equal(entry['cid'] as String, cid);
    equal(entry['publisher'] as String, ALICE);
    equal(((entry['release'] as JsonObject)['version'] as String), '1.0.0');
    equal(errorOf(await fixture.query(BOB, 'getPendingReleases', `?package=${pkgDid}`)), 'Forbidden');
    // An attestation of another CID, even at this release's key, counts for nothing.
    let otherCid = Cid.forDagCbor(new FixedArray<u8>(1, 0 as u8)).toString();
    let key = new Attestation(uri, Cid.parse(cid), '2026-10-29T00:00:00.000Z').recordKey();
    fixture.remote[`${ALICE} ${ATTESTATION_TYPE} ${key}`] =
        new Attestation(uri, Cid.parse(otherCid), '2026-10-29T00:00:00.000Z').toValue();
    equal((await complete(fixture, ALICE, pkgDid, '1.0.0'))['state'] as String, 'pending');

    // Alice's attestation meets the threshold of 1, and the App View writes it.
    fixture.attest(ALICE, uri, cid);
    let done = await complete(fixture, ALICE, pkgDid, '1.0.0');
    equal(done['state'] as String, 'published');
    equal(approvedBy(done), ALICE);
    equal(((await store.getRecord(RELEASE_TYPE, '1.0.0')) as Cid).toString(), cid);
    equal((await complete(fixture, ALICE, pkgDid, '1.0.0'))['state'] as String, 'published');
    equal((ok(await fixture.query(ALICE, 'getPendingReleases', `?package=${pkgDid}`))['releases'] as JsonArray).length, 0);
    equal(errorOf(await fixture.call(ALICE, 'publish', body)), 'VersionExists');
  });

  test('waits for the threshold of maintainers, and for people', async (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkg = ok(await createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    let robot = 'did:plc:robotrobotrobotrobotrobo';
    var maintainers = new Maintainers([Maintainer.ofDid(ALICE, OWNER), Maintainer.ofDid(BOB, PUBLISHER),
        new Maintainer(robot, null, null, null, PUBLISHER, true)], 2 as i64);
    maintainers.humans = 3 as i64;
    var swap = (pkg['maintainers'] as JsonObject)['cid'] as String;
    // Two people cannot meet humans: 3.
    equal(errorOf(await putMaintainers(fixture, ALICE, pkgDid, maintainers, [], swap)), 'InvalidRequest');
    maintainers.humans = 1 as i64;
    swap = ok(await putMaintainers(fixture, ALICE, pkgDid, maintainers, [], swap))['cid'] as String;

    let held = ok(await fixture.call(BOB, 'publish',
        `{"package": "${pkgDid}", "release": ${releaseJson('1.0.0', await upload(fixture, pkgDid, archiveOf(pkgDid, '1.0.0')))}}`));
    let uri = held['uri'] as String;
    let cid = held['cid'] as String;
    // Automation alone is not enough, however many: it needs a person.
    fixture.attest(robot, uri, cid);
    let one = await complete(fixture, BOB, pkgDid, '1.0.0');
    equal(one['state'] as String, 'pending');
    equal(approvedBy(one), robot);
    equal((one['humans'] as Box<f64>).value as i32, 1);
    // Bob and the robot make two, one of them a person.
    fixture.attest(BOB, uri, cid);
    let two = await complete(fixture, BOB, pkgDid, '1.0.0');
    equal(two['state'] as String, 'published');
    equal(approvedBy(two), `${BOB} ${robot}`);
  });

  test('counts automation the App View holds only together with a person', async (ctx) => {
    let fixture = new Fixture();
    let router = await seedBrowsable(fixture);
    let bot = (await fixture.pds.storage.accountByHandle('ci.acme.pkg.test')) as Account;
    let current = (await fixture.pds.storage.store(router).getRecord(MAINTAINERS_TYPE, 'self')) as Cid;
    ok(await putMaintainers(fixture, ALICE, router, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(bot.did, null, null, null, PUBLISHER, true)]), [], current.toString()));
    let held = ok(await fixture.call(ALICE, 'publish',
        `{"package": "${router}", "release": ${releaseJson('2.0.0', await upload(fixture, router, archiveOf(router, '2.0.0')))}}`));
    let uri = held['uri'] as String;
    let attestation = new Attestation(uri, Cid.parse(held['cid'] as String), '2026-10-29T00:00:00.000Z');
    await fixture.pds.repositoryOf(bot).applyWrites([new CreateRecord(ATTESTATION_TYPE, attestation.recordKey(),
        attestation.toValue()) as Write], 0 as i64);
    // The App View holds the bot's keys, so the bot alone could be the App View.
    let alone = await complete(fixture, ALICE, router, '2.0.0');
    equal(alone['state'] as String, 'pending');
    equal(approvedBy(alone), bot.did);
    fixture.attest(ALICE, uri, held['cid'] as String);
    equal((await complete(fixture, ALICE, router, '2.0.0'))['state'] as String, 'published');
  });

  test('frees a version its release was withdrawn from, or waited too long at', async (ctx): Future<void> => {
    let fixture = new Fixture();
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkg = ok(await createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    ok(await putMaintainers(fixture, ALICE, pkgDid, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        Maintainer.ofDid(BOB, PUBLISHER)]), [], (pkg['maintainers'] as JsonObject)['cid'] as String));
    let blob = await upload(fixture, pkgDid, archiveOf(pkgDid, '1.0.0'));
    let publish = (caller: String, created: String) => {
      let release = new Release(Version.parse('1.0.0'), created, new FixedArray<Artifact>(1, Artifact.whole(SOURCE, blob)),
          new FixedArray<Dependency>(0, new Dependency('', Version.parse('0.0.0'), '')));
      return fixture.call(caller, 'publish', `{"package": "${pkgDid}", "release": ${stringify(toJson(release.toValue()))}}`);
    };
    let withdraw = (caller: String) =>
        fixture.call(caller, 'withdrawRelease', `{"package": "${pkgDid}", "version": "1.0.0"}`);

    // Alice's release: Bob, a publisher, may not withdraw it; Alice may.
    ok(await publish(ALICE, '2026-10-24T00:00:00.000Z'));
    equal(errorOf(await publish(BOB, '2026-10-25T00:00:00.000Z')), 'VersionExists');
    equal(errorOf(await withdraw(BOB)), 'Forbidden');
    ok(await withdraw(ALICE));
    equal(errorOf(await withdraw(ALICE)), 'ReleaseNotFound');
    equal(errorOf(await fixture.call(ALICE, 'completeRelease', `{"package": "${pkgDid}", "version": "1.0.0"}`)),
        'ReleaseNotFound');

    // Bob's: Alice, an owner, may withdraw it too, and Bob may.
    ok(await publish(BOB, '2026-10-25T00:00:00.000Z'));
    ok(await withdraw(ALICE));
    ok(await publish(BOB, '2026-10-26T00:00:00.000Z'));

    // After seven days, it is gone, and the version is free.
    let appView = fixture.appView as AppView;
    let later = now().seconds * (1000000 as i64) + PENDING_MICROS + (1000000 as i64);
    equal((await appView.pendingReleases(ALICE, pkgDid, later)).length, 0);
    var missing = '';
    try {
      await appView.completeRelease(ALICE, pkgDid, '1.0.0', later);
    } catch (e) {
      missing = if (e is AppViewError) e.error else e.message;
    }
    equal(missing, 'ReleaseNotFound');
    ok(await publish(ALICE, '2026-10-27T00:00:00.000Z'));
  });

  test('holds an account alone when its owners give no recovery keys', async (ctx) => {
    let fixture = new Fixture();
    let appView = (fixture.appView as AppView).config.rotationKey.publicKey();
    let org = ok(await fixture.call(ALICE, 'createOrganization', '{"name": "acme"}'));
    let operation = fixture.genesisOf(org['did'] as String);
    equal(operation.rotationKeys.length, 1);
    equal(operation.rotationKeys[0], formatDidKey(appView));
    let none = ok(await fixture.call(ALICE, 'createOrganization', '{"name": "acme2", "recoveryKeys": []}'));
    equal(fixture.genesisOf(none['did'] as String).rotationKeys.length, 1);

    // The App View keeps two of PLC's five rotation keys for itself (#597).
    let four = `"${RECOVERY}", "${RECOVERY}", "${RECOVERY}", "${RECOVERY}"`;
    equal(errorOf(await fixture.call(ALICE, 'createOrganization', `{"name": "acme3", "recoveryKeys": [${four}]}`)),
        'InvalidRequest');
    equal(errorOf(await fixture.call(ALICE, 'createOrganization', '{"name": "acme3", "recoveryKeys": "no"}')),
        'InvalidRequest');
  });

  test("ranks recovery keys, then the operator's offline key, then the App View's online key", async (ctx) => {
    let fixture = new Fixture();
    let appView = fixture.appView as AppView;
    let offline = new SigningKey(KeyType.Secp256k1, filled(201)).publicKey();
    appView.config.offlineRotationKey = offline;
    let org = ok(await createOrganization(fixture, ALICE, 'acme'));
    let operation = fixture.genesisOf(org['did'] as String);
    equal(operation.rotationKeys.length, 3);
    equal(operation.rotationKeys[0], RECOVERY);
    equal(operation.rotationKeys[1], formatDidKey(offline));
    equal(operation.rotationKeys[2], formatDidKey(appView.config.rotationKey.publicKey()));
    // The online key signs it.
    isTrue(operation.isSignedBy(appView.config.rotationKey.publicKey()), 'signed by the online key');
    // Four recovery keys and the App View's two would pass PLC's five.
    let four = `"${RECOVERY}", "${RECOVERY}", "${RECOVERY}", "${RECOVERY}"`;
    equal(errorOf(await fixture.call(ALICE, 'createOrganization', `{"name": "acme2", "recoveryKeys": [${four}]}`)),
        'InvalidRequest');
  });

  test('lets the operator create a reserved scope, which no caller can', async (ctx): Future<void> => {
    let fixture = new Fixture();
    let appView = fixture.appView as AppView;
    equal(errorOf(await createOrganization(fixture, ALICE, 'zena')), 'NameTaken');
    let created = await appView.createScopeAsOperator(ALICE, 'zena', [], 0 as i64);
    equal(created.handle, 'zena.pkg.test');
    equal(fixture.genesisOf(created.did).rotationKeys.length, 1);
    // Its owner is Alice, who can create packages in it.
    ok(await createPackage(fixture, ALICE, created.did, 'wit-parser'));
    // Taken once, as any scope.
    var taken = '';
    try {
      await appView.createScopeAsOperator(BOB, 'zena', [], 0 as i64);
    } catch (e) {
      taken = if (e is AppViewError) e.error else e.message;
    }
    equal(taken, 'NameTaken');
  });

  test('changes an organization\'s members, and a role ends with the record that gave it', async (ctx) => {
    let fixture = new Fixture();
    let org = ok(await createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    var swap = (org['members'] as JsonObject)['cid'] as String;
    // Alice's own entry, which the App View made, is all she needs to keep.
    let alice = await entriesSeen(fixture, ALICE, orgDid);
    equal(alice.length, 1);
    equal(alice[0].role, OWNER);
    let bob = new MemberEntry(BOB, ADMIN, filled(150));

    // Only an owner changes the members.
    equal(errorOf(await putMembers(fixture, BOB, orgDid, [alice[0], bob], [bob], swap)), 'Forbidden');
    // Each entry is behind a commitment, each commitment has an entry, and
    // the record keeps owners enough for its thresholds.
    equal(errorOf(await putMembers(fixture, ALICE, orgDid, [alice[0]], [bob], swap)), 'InvalidRequest');
    equal(errorOf(await putMembers(fixture, ALICE, orgDid, [alice[0], bob], [], swap)), 'InvalidRequest');
    equal(errorOf(await putMembers(fixture, ALICE, orgDid, [bob], [bob], swap)), 'InvalidRequest');
    equal(errorOf(await putMembers(fixture, ALICE, orgDid, [alice[0], bob], [bob], swap, 2 as i64)), 'InvalidRequest');
    let pope = new MemberEntry(BOB, 'pope', filled(151));
    equal(errorOf(await putMembers(fixture, ALICE, orgDid, [alice[0], pope], [pope], swap)), 'InvalidRequest');
    equal(errorOf(await putMembers(fixture, ALICE, orgDid, [alice[0], bob], [bob], 'bafyreinotacid')), 'InvalidRequest');

    let added = ok(await putMembers(fixture, ALICE, orgDid, [alice[0], bob], [bob], swap));
    // A second change made from the same record is refused.
    equal(errorOf(await putMembers(fixture, ALICE, orgDid, [alice[0]], [], swap)), 'InvalidSwap');
    swap = added['cid'] as String;

    // Bob, an admin now, creates packages, sees every entry, and sees no
    // more than his own once he is removed.
    ok(await createPackage(fixture, BOB, orgDid, 'router'));
    equal((await entriesSeen(fixture, BOB, orgDid)).length, 2);
    ok(await putMembers(fixture, ALICE, orgDid, [alice[0]], [], swap));
    equal(errorOf(await createPackage(fixture, BOB, orgDid, 'parser')), 'Forbidden');
    equal((await entriesSeen(fixture, BOB, orgDid)).length, 0);
    equal((await entriesSeen(fixture, ALICE, orgDid)).length, 1);
  });

  test('gives a team a package, and takes it away with the team', async (ctx) => {
    let fixture = new Fixture();
    let org = ok(await createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let alice = await entriesSeen(fixture, ALICE, orgDid);
    let bobMember = new MemberEntry(BOB, MEMBER, filled(160));
    ok(await putMembers(fixture, ALICE, orgDid, [alice[0], bobMember], [bobMember],
        (org['members'] as JsonObject)['cid'] as String));
    let pkg = ok(await createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    var pkgSwap = (pkg['maintainers'] as JsonObject)['cid'] as String;

    // A member makes no team; an admin does, of members only.
    let bob = new MemberEntry(BOB, MAINTAINER, filled(161));
    equal(errorOf(await putTeam(fixture, BOB, orgDid, 'core', [bob], null)), 'Forbidden');
    let stranger = new MemberEntry('did:plc:strangerstrangerstranger', MEMBER, filled(162));
    equal(errorOf(await putTeam(fixture, ALICE, orgDid, 'core', [bob, stranger], null)), 'InvalidRequest');
    equal(errorOf(await putTeam(fixture, ALICE, orgDid, 'Core', [bob], null)), 'InvalidRequest');
    var teamSwap = ok(await putTeam(fixture, ALICE, orgDid, 'core', [bob], null))['cid'] as String;
    // The team's maintainer changes it after.
    teamSwap = ok(await putTeam(fixture, BOB, orgDid, 'core', [bob], teamSwap))['cid'] as String;
    equal((await entriesSeen(fixture, BOB, orgDid, 'core')).length, 1);

    // Bob publishes to the package through the team, and is no owner of it.
    equal(errorOf(await upload(fixture, BOB, pkgDid)), 'Forbidden');
    let withTeam = new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, null, orgDid, 'core', PUBLISHER)]);
    let missingTeam = new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, null, orgDid, 'nobody', PUBLISHER)]);
    equal(errorOf(await putMaintainers(fixture, ALICE, pkgDid, missingTeam, [], pkgSwap)), 'TeamNotFound');
    pkgSwap = ok(await putMaintainers(fixture, ALICE, pkgDid, withTeam, [], pkgSwap))['cid'] as String;
    ok(await upload(fixture, BOB, pkgDid));
    equal(errorOf(await putMaintainers(fixture, BOB, pkgDid, withTeam, [], pkgSwap)), 'Forbidden');

    // Only an admin deletes the team, and with it Bob's part in the package.
    equal(errorOf(await fixture.call(BOB, 'deleteTeam', `{"organization": "${orgDid}", "name": "core"}`)), 'Forbidden');
    ok(await fixture.call(ALICE, 'deleteTeam', `{"organization": "${orgDid}", "name": "core", "swapRecord": "${teamSwap}"}`));
    equal(errorOf(await upload(fixture, BOB, pkgDid)), 'Forbidden');
    equal(errorOf(await fixture.call(ALICE, 'deleteTeam', `{"organization": "${orgDid}", "name": "core"}`)), 'TeamNotFound');
  });

  test('changes a package\'s maintainers, with private entries in the roles they give', async (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkg = ok(await createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    var swap = (pkg['maintainers'] as JsonObject)['cid'] as String;
    let bob = new MemberEntry(BOB, OWNER, filled(170));
    let asOwner = new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, bob.commitment(), null, null, OWNER)]);
    // An entry in another role than the record gives it, too few owners for
    // the threshold, and too few maintainers for releases, are refused.
    let wrongRole = new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, bob.commitment(), null, null, PUBLISHER)]);
    equal(errorOf(await putMaintainers(fixture, ALICE, pkgDid, wrongRole, [bob], swap)), 'InvalidRequest');
    equal(errorOf(await putMaintainers(fixture, ALICE, pkgDid,
        new Maintainers(asOwner.maintainers, 1 as i64, 3 as i64), [bob], swap)), 'InvalidRequest');
    equal(errorOf(await putMaintainers(fixture, ALICE, pkgDid,
        new Maintainers(asOwner.maintainers, 3 as i64), [bob], swap)), 'InvalidRequest');
    equal(errorOf(await putMaintainers(fixture, ALICE, pkgDid, asOwner, [], swap)), 'InvalidRequest');

    swap = ok(await putMaintainers(fixture, ALICE, pkgDid, asOwner, [bob], swap))['cid'] as String;
    // Bob, an owner by commitment, sees the package's entries and changes
    // its maintainers; his entry stays private to the package's owners.
    equal((await entriesSeen(fixture, BOB, pkgDid)).length, 1);
    ok(await putMaintainers(fixture, BOB, pkgDid, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, bob.commitment(), null, null, OWNER)], 2 as i64), [], swap));
    ok(await upload(fixture, BOB, pkgDid));
  });

  test('holds a change to the members until enough owners of the record before it attest it', async (ctx) => {
    let fixture = new Fixture();
    let org = ok(await createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let alice = (await entriesSeen(fixture, ALICE, orgDid))[0];
    let bob = new MemberEntry(BOB, OWNER, filled(190));
    // Alice alone owns acme, so her attestation makes Bob an owner, and the
    // new record asks for two owners from then on.
    let swap = ok(await putMembers(fixture, ALICE, orgDid, [alice, bob], [bob],
        (org['members'] as JsonObject)['cid'] as String, 2 as i64))['cid'] as String;

    // Alice removes Bob: the change waits, and Bob is an owner until it is written.
    let held = ok(await proposeMembers(fixture, ALICE, orgDid, [alice], [], swap));
    equal(held['state'] as String, 'pending');
    let uri = held['uri'] as String;
    let cid = held['cid'] as String;
    equal(uri, `at://${orgDid}/dev.zena-lang.org.members/self`);
    fixture.attest(ALICE, uri, cid);
    let waiting = ok(await completeChange(fixture, ALICE, uri, cid));
    equal(waiting['state'] as String, 'pending');
    let requirement = (waiting['requirements'] as JsonArray)[0] as JsonObject;
    equal(requirement['role'] as String, OWNER);
    equal((requirement['threshold'] as Box<f64>).value as i32, 2);
    equal(approvedBy(requirement), ALICE);
    isTrue(((await fixture.pds.storage.store(orgDid).getRecord(MEMBERS_TYPE, 'self')) as Cid).toString() == swap,
        'the record is unchanged');
    equal((await entriesSeen(fixture, BOB, orgDid)).length, 2);

    // Bob sees the change, with the entries the new record commits to.
    let pending = ok(await fixture.query(BOB, 'getPendingChanges', `?account=${orgDid}`))['changes'] as JsonArray;
    equal(pending.length, 1);
    let change = pending[0] as JsonObject;
    equal(change['uri'] as String, uri);
    equal(change['cid'] as String, cid);
    equal(change['base'] as String, swap);
    equal(change['proposer'] as String, ALICE);
    equal((change['entries'] as JsonArray).length, 1);
    equal(((change['entries'] as JsonArray)[0] as JsonObject)['did'] as String, ALICE);
    equal(errorOf(await fixture.query(BOB, 'getPendingChanges', `?account=did:plc:nonenonenonenonenonenone`)),
        'InvalidRequest');

    // A later change to the record takes its place, and Alice's attestation
    // of the first counts for nothing toward it.
    let carol = new MemberEntry('did:plc:carolcarolcarolcarolcaro', MEMBER, filled(191));
    let later = ok(await proposeMembers(fixture, ALICE, orgDid, [alice, carol], [carol], swap));
    let laterCid = later['cid'] as String;
    let replaced = ok(await fixture.query(ALICE, 'getPendingChanges', `?account=${orgDid}`))['changes'] as JsonArray;
    equal(replaced.length, 1);
    equal((replaced[0] as JsonObject)['cid'] as String, laterCid);
    equal(approvedBy(((ok(await completeChange(fixture, ALICE, uri, laterCid))['requirements'] as JsonArray)[0])
        as JsonObject), '');

    // Both owners attest it, and it is written.
    fixture.attest(ALICE, uri, laterCid);
    fixture.attest(BOB, uri, laterCid);
    let written = ok(await completeChange(fixture, BOB, uri, laterCid));
    equal(written['state'] as String, 'written');
    equal(approvedBy((written['requirements'] as JsonArray)[0] as JsonObject), `${ALICE} ${BOB}`);
    equal(((await fixture.pds.storage.store(orgDid).getRecord(MEMBERS_TYPE, 'self')) as Cid).toString(), laterCid);
    // Bob is no member now; completing again answers as written.
    equal(errorOf(await fixture.query(BOB, 'getPendingChanges', `?account=${orgDid}`)), 'Forbidden');
    equal(ok(await completeChange(fixture, ALICE, uri, laterCid))['state'] as String, 'written');
    equal(errorOf(await completeChange(fixture, ALICE, uri, cid)), 'ChangeNotFound');
  });

  test('lets a team\'s maintainers, or enough admins, change a team', async (ctx) => {
    let fixture = new Fixture();
    let org = ok(await createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let alice = (await entriesSeen(fixture, ALICE, orgDid))[0];
    let bobMember = new MemberEntry(BOB, ADMIN, filled(200));
    let members = stringify(toJson(new Members(commitmentsOf([alice, bobMember]), 1 as i64, 2 as i64).toValue()));
    let put = await fixture.call(ALICE, 'putMembers', `{"organization": "${orgDid}", "members": ${members}, "entries": ${
        entriesJson([bobMember])}, "swapRecord": "${(org['members'] as JsonObject)['cid'] as String}"}`);
    isTrue(ok(await approved(fixture, ALICE, put))['state'] as String == 'written', 'Bob is an admin');

    // A new team needs two admins now.
    let bob = new MemberEntry(BOB, MAINTAINER, filled(201));
    let created = ok(await putTeam(fixture, ALICE, orgDid, 'core', [bob], null));
    equal(created['state'] as String, 'pending');
    let uri = created['uri'] as String;
    let requirements = created['requirements'] as JsonArray;
    equal(requirements.length, 1);
    equal(((requirements[0] as JsonObject)['role'] as String), ADMIN);
    isTrue((await fixture.pds.storage.store(orgDid).getRecord(TEAM_TYPE, 'core')) == null, 'no team yet');
    fixture.attest(BOB, uri, created['cid'] as String);
    var teamSwap = ok(await completeChange(fixture, BOB, uri, created['cid'] as String))['cid'] as String;

    // Bob, the team's maintainer, changes it alone: its threshold is 1.
    let carol = new MemberEntry('did:plc:carolcarolcarolcarolcaro', MEMBER, filled(202));
    let carolMember = new MemberEntry('did:plc:carolcarolcarolcarolcaro', MEMBER, filled(203));
    let swap = (await fixture.pds.storage.store(orgDid).getRecord(MEMBERS_TYPE, 'self')) as Cid;
    ok(await putMembers(fixture, ALICE, orgDid, [alice, bobMember, carolMember], [carolMember], swap.toString(),
        1 as i64));
    let byMaintainer = ok(await putTeam(fixture, BOB, orgDid, 'core', [bob, carol], teamSwap));
    equal(byMaintainer['state'] as String, 'written');
    teamSwap = byMaintainer['cid'] as String;

    // A change held to a team deleted since is dropped when completed.
    let held = ok(await proposeTeam(fixture, BOB, orgDid, 'core', [bob], teamSwap));
    fixture.attest(BOB, held['uri'] as String, held['cid'] as String);
    ok(await fixture.call(ALICE, 'deleteTeam', `{"organization": "${orgDid}", "name": "core"}`));
    equal(errorOf(await completeChange(fixture, BOB, held['uri'] as String, held['cid'] as String)), 'InvalidSwap');
    equal(errorOf(await completeChange(fixture, BOB, held['uri'] as String, held['cid'] as String)), 'ChangeNotFound');
  });

  test('holds a change of maintainers until enough owners attest it, and lets it be withdrawn', async (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkg = ok(await createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    let robot = 'did:plc:robotrobotrobotrobotrobo';
    let two = new Maintainers([Maintainer.ofDid(ALICE, OWNER), Maintainer.ofDid(BOB, OWNER),
        new Maintainer(robot, null, null, null, PUBLISHER, true)], 1 as i64, 2 as i64);
    let swap = ok(await putMaintainers(fixture, ALICE, pkgDid, two, [], (pkg['maintainers'] as JsonObject)['cid'] as String))
        ['cid'] as String;

    // Alice drops Bob: he stays an owner until he attests it too.
    let alone = new Maintainers([Maintainer.ofDid(ALICE, OWNER)]);
    let held = ok(await putMaintainers(fixture, ALICE, pkgDid, alone, [], swap));
    equal(held['state'] as String, 'pending');
    let uri = held['uri'] as String;
    let cid = held['cid'] as String;
    // The robot's attestation is not an owner's.
    fixture.attest(robot, uri, cid);
    equal(approvedBy((ok(await completeChange(fixture, ALICE, uri, cid))['requirements'] as JsonArray)[0] as JsonObject),
        ALICE);
    equal(((await fixture.pds.storage.store(pkgDid).getRecord(MAINTAINERS_TYPE, 'self')) as Cid).toString(), swap);
    ok(await upload(fixture, BOB, pkgDid));

    // Bob, an owner, withdraws it; a URI of no account here is refused.
    equal(errorOf(await fixture.call(BOB, 'withdrawChange', '{"uri": "at://did:plc:x/dev.zena-lang.org.team/core"}')),
        'InvalidRequest');
    ok(await fixture.call(BOB, 'withdrawChange', `{"uri": "${uri}"}`));
    equal(errorOf(await fixture.call(BOB, 'withdrawChange', `{"uri": "${uri}"}`)), 'ChangeNotFound');

    // Asked for again, it expires after seven days.
    ok(await proposeMaintainers(fixture, ALICE, pkgDid, alone, [], swap));
    let appView = fixture.appView as AppView;
    let later = now().seconds * (1000000 as i64) + PENDING_MICROS + (1000000 as i64);
    equal((await appView.pendingChanges(ALICE, pkgDid, later)).length, 0);
    fixture.attest(BOB, uri, cid);
    equal(errorOf(await completeChange(fixture, ALICE, uri, cid)), 'ChangeNotFound');
  });

  test('applies a scope\'s policy to its packages at once, and lets its creator teams create them', async (ctx) => {
    let fixture = new Fixture();
    let org = ok(await createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let alice = (await entriesSeen(fixture, ALICE, orgDid))[0];
    let bobMember = new MemberEntry(BOB, MEMBER, filled(210));
    ok(await putMembers(fixture, ALICE, orgDid, [alice, bobMember], [bobMember], (org['members'] as JsonObject)['cid'] as String));
    let bob = new MemberEntry(BOB, MEMBER, filled(211));
    ok(await putTeam(fixture, ALICE, orgDid, 'core', [bob], null));
    let pkgDid = ok(await createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    let policyCall = async (caller: String, policy: Policy): Future<Response> => await approved(fixture, caller,
        await fixture.call(caller, 'putPolicy', `{"organization": "${orgDid}", "policy": ${stringify(toJson(policy.toValue()))}}`));

    // Only an owner sets it; its teams must exist, and its defaults meet its minimums.
    let strict = new Policy();
    strict.minimumThreshold = 2 as i64;
    strict.defaultThreshold = 2 as i64;
    strict.defaultTeams = [new TeamRole('core', PUBLISHER)];
    strict.creators = ['core'];
    equal(errorOf(await policyCall(BOB, strict)), 'Forbidden');
    let missing = new Policy();
    missing.creators = ['nobody'];
    equal(errorOf(await policyCall(ALICE, missing)), 'TeamNotFound');
    let lax = new Policy();
    lax.minimumThreshold = 2 as i64;
    equal(errorOf(await policyCall(ALICE, lax)), 'InvalidRequest');
    equal(errorOf(await createPackage(fixture, BOB, orgDid, 'parser')), 'Forbidden');
    let set = ok(await policyCall(ALICE, strict));
    equal(set['state'] as String, 'written');

    // router, which Alice alone maintains, now needs two approvals to release.
    let held = ok(await fixture.call(ALICE, 'publish',
        `{"package": "${pkgDid}", "release": ${releaseJson('1.0.0', await upload(fixture, pkgDid, archiveOf(pkgDid, '1.0.0')))}}`));
    fixture.attest(ALICE, held['uri'] as String, held['cid'] as String);
    let waiting = await complete(fixture, ALICE, pkgDid, '1.0.0');
    equal(waiting['state'] as String, 'pending');
    equal((waiting['threshold'] as Box<f64>).value as i32, 2);
    // A record that could never meet that is refused; one with Bob can.
    let current = (await fixture.pds.storage.store(pkgDid).getRecord(MAINTAINERS_TYPE, 'self')) as Cid;
    equal(errorOf(await putMaintainers(fixture, ALICE, pkgDid, new Maintainers([Maintainer.ofDid(ALICE, OWNER)], 1 as i64),
        [], current.toString())), 'InvalidRequest');
    ok(await putMaintainers(fixture, ALICE, pkgDid, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        Maintainer.ofDid(BOB, PUBLISHER)]), [], current.toString()));
    fixture.attest(BOB, held['uri'] as String, held['cid'] as String);
    equal((await complete(fixture, BOB, pkgDid, '1.0.0'))['state'] as String, 'published');

    // Bob, on the creator team, creates a package; one maintainer alone
    // could not approve its releases, so it is created with the team.
    equal(errorOf(await createPackage(fixture, BOB, orgDid, 'parser')), 'InvalidRequest');
    let profile = stringify(toJson(new Profile('parser').toValue()));
    let withTeam = stringify(toJson(new Maintainers([Maintainer.ofDid(BOB, OWNER),
        new Maintainer(null, null, orgDid, 'core', PUBLISHER)], 2 as i64).toValue()));
    ok(await fixture.call(BOB, 'createPackage', `{"organization": "${orgDid}", "recoveryKeys": ["${RECOVERY}"], "profile": ${
        profile}, "maintainers": ${withTeam}}`));
  });

  test('creates an automation account that publishes with a token the App View issues, as a publisher only', async (ctx) => {
    let fixture = new Fixture();
    let org = ok(await createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let pkg = ok(await createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    var swap = (pkg['maintainers'] as JsonObject)['cid'] as String;

    let body = `{"organization": "${orgDid}", "name": "ci"}`;
    equal(errorOf(await fixture.call(BOB, 'createAutomationAccount', body)), 'Forbidden');
    let bot = ok(await fixture.call(ALICE, 'createAutomationAccount', body));
    let botDid = bot['did'] as String;
    equal(bot['handle'] as String, 'ci.acme.pkg.test');
    equal(fixture.records.lookup('ci.acme.pkg.test') as String, botDid);
    equal(fixture.genesisOf(botDid).rotationKeys.length, 1);
    // A managed account like the App View's others, which no one signs in to.
    equal(((await fixture.pds.storage.getAccount(botDid)) as Account).manager as String, APP_VIEW);
    isTrue(bot['appPassword'] == null, 'no app password');
    let token = bot['token'] as String;
    isTrue(token.startsWith('zena_ci_'), token);
    // Its name is taken in the scope, as a package's would be.
    equal(errorOf(await fixture.call(ALICE, 'createAutomationAccount', body)), 'NameTaken');
    equal(errorOf(await createPackage(fixture, ALICE, orgDid, 'ci')), 'NameTaken');

    // CI calls the App View's methods with the token, as the account.
    let withToken = async (name: String, input: String | FixedArray<u8>, query: String, contentType: String, given: String): Future<Response> =>
        await fixture.call(null, name, input, query, contentType, `Bearer ${given}`);
    let archive = archiveOf(pkgDid, '1.0.0');
    let car = 'application/vnd.ipld.car';
    equal(errorOf(await withToken('uploadArtifact', archive, `?package=${pkgDid}`, car, token)), 'Forbidden');
    equal(errorOf(await withToken('uploadArtifact', archive, `?package=${pkgDid}`, car, 'zena_ci_forged')), 'InvalidToken');

    // A package's owners add it as a publisher, marked as automation.
    let entry = new MemberEntry(botDid, PUBLISHER, filled(180), true);
    let unmarked = new MemberEntry(botDid, PUBLISHER, filled(181));
    let asBot = (role: String, marked: boolean, behind: MemberEntry) => new Maintainers([
        Maintainer.ofDid(ALICE, OWNER), new Maintainer(null, behind.commitment(), null, null, role, marked)]);
    equal(errorOf(await putMaintainers(fixture, ALICE, pkgDid, asBot(PUBLISHER, false, unmarked), [unmarked], swap)),
        'InvalidRequest');
    let ownerEntry = new MemberEntry(botDid, OWNER, filled(182), true);
    equal(errorOf(await putMaintainers(fixture, ALICE, pkgDid, asBot(OWNER, true, ownerEntry), [ownerEntry], swap)),
        'InvalidRequest');
    swap = ok(await putMaintainers(fixture, ALICE, pkgDid, asBot(PUBLISHER, true, entry), [entry], swap))['cid'] as String;
    let blob = BlobRef.fromValue(fromJson(ok(await withToken('uploadArtifact', archive, `?package=${pkgDid}`, car,
        token))['blob'] as JsonObject));
    let held = ok(await withToken('publish', `{"package": "${pkgDid}", "release": ${releaseJson('1.0.0', blob)}}`, '',
        'application/json', token));
    // The App View writes the account's attestation of the release itself,
    // which counts only together with a person's.
    let uri = held['uri'] as String;
    let cid = Cid.parse(held['cid'] as String);
    isTrue((await fixture.pds.storage.store(botDid).getRecord(ATTESTATION_TYPE, attestationKey(uri, cid))) != null,
        'its attestation');
    let completion = `{"package": "${pkgDid}", "version": "1.0.0"}`;
    let waiting = ok(await withToken('completeRelease', completion, '', 'application/json', token));
    equal(waiting['state'] as String, 'pending');
    equal(approvedBy(waiting), botDid);
    fixture.attest(ALICE, uri, cid.toString());
    equal((await complete(fixture, ALICE, pkgDid, '1.0.0'))['state'] as String, 'published');

    // An admin of its organization replaces its token, and the old one
    // stops working.
    let account = `{"account": "${botDid}"}`;
    equal(errorOf(await fixture.call(BOB, 'issueAutomationToken', account)), 'Forbidden');
    equal(errorOf(await fixture.call(ALICE, 'issueAutomationToken', `{"account": "${pkgDid}"}`)), 'InvalidRequest');
    let next = ok(await fixture.call(ALICE, 'issueAutomationToken', account))['token'] as String;
    isTrue(next != token && next.startsWith('zena_ci_'), next);
    equal(errorOf(await withToken('completeRelease', completion, '', 'application/json', token)), 'InvalidToken');
    equal(ok(await withToken('completeRelease', completion, '', 'application/json', next))['state'] as String, 'published');
  });

  test('lists the scopes and packages a visitor can browse, with their latest releases', async (ctx) => {
    let fixture = new Fixture();
    await seedBrowsable(fixture);

    let scopes = ok(await fixture.get('/xrpc/dev.zena-lang.registry.listScopes'))['scopes'] as JsonArray;
    equal(scopes.length, 2);
    let acme = scopes[0] as JsonObject;
    equal(acme['name'] as String, 'acme');
    equal(acme['handle'] as String, 'acme.pkg.test');
    // The automation account takes a name, and is no package.
    equal((acme['packages'] as Box<f64>).value as i32, 2);
    equal((scopes[1] as JsonObject)['name'] as String, 'zeta');

    let packages = ok(await fixture.get('/xrpc/dev.zena-lang.registry.listPackages'))['packages'] as JsonArray;
    equal(packages.length, 2);
    equal((packages[0] as JsonObject)['name'] as String, 'parser');
    isTrue((packages[0] as JsonObject)['latest'] == null, 'parser has no release');
    let listed = packages[1] as JsonObject;
    equal(listed['name'] as String, 'router');
    equal(listed['handle'] as String, 'router.acme.pkg.test');
    equal(listed['description'] as String, 'Routes requests');
    equal(listed['license'] as String, 'MIT');
    // 1.1.0 is retracted, so 1.0.0 is the latest; both are releases.
    equal(listed['latest'] as String, '1.0.0');
    equal((listed['releases'] as Box<f64>).value as i32, 2);
    equal((ok(await fixture.get('/xrpc/dev.zena-lang.registry.listPackages?scope=zeta'))['packages'] as JsonArray).length, 0);
  });

  test("lists packages from their summaries, reading no package's account or repository", async (ctx) => {
