  });

  test('writes again the indexes a commit the App View did not make left behind', async (ctx) => {
    let fixture = new Fixture();
    let router = await seedBrowsable(fixture);
    let account = (await fixture.pds.storage.getAccount(router)) as Account;
    let store = fixture.pds.storage.store(router);
    let current = (await store.getRecord(PROFILE_TYPE, 'self')) as Cid;
    // A write the App View did not make leaves its indexes as they were: as
    // another server, or this one before it kept summaries, would have
    // written.
    await new Repository(account, store, new TidClock(9)).applyWrites([new UpdateRecord(PROFILE_TYPE, 'self',
        new Profile('router', 'Routes everything', 'MIT').toValue(), current) as Write], 0 as i64);
    let listed = async (): Future<String> => {
      let packages = ok(await fixture.get('/xrpc/dev.zena-lang.registry.listPackages?scope=acme'))['packages'] as JsonArray;
      return (packages[1] as JsonObject)['description'] as String;
    };
    equal(await listed(), 'Routes requests');
    // Nor did one that names Bob a maintainer reach the index of mentions.
    let maintainers = (await store.getRecord(MAINTAINERS_TYPE, 'self')) as Cid;
    await new Repository(account, store, new TidClock(9)).applyWrites([new UpdateRecord(MAINTAINERS_TYPE, 'self',
        new Maintainers([Maintainer.ofDid(ALICE, OWNER), Maintainer.ofDid(BOB, PUBLISHER)]).toValue(), maintainers)
        as Write], 0 as i64);
    let bobs = async (): Future<boolean> => pageOf(await fixture.get(`/people/${BOB}`)).contains('href="/packages/router.acme.pkg.test"');
    isTrue(!(await bobs()), 'not yet indexed');
    // The two organizations and the two packages.
    equal(await (fixture.appView as AppView).syncIndexes(), 4);
    equal(await listed(), 'Routes everything');
    isTrue(await bobs(), "router on Bob's page");
  });

  test('lets a scope\'s admins say how it presents itself, which its page shows', async (ctx) => {
    let fixture = new Fixture();
    let org = ok(await createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let alice = (await entriesSeen(fixture, ALICE, orgDid))[0];
    let bob = new MemberEntry(BOB, MEMBER, filled(220));
    ok(await putMembers(fixture, ALICE, orgDid, [alice, bob], [bob], (org['members'] as JsonObject)['cid'] as String));
    let put = async (caller: String, profile: String): Future<Response> => await fixture.call(caller, 'putScopeProfile',
        `{"organization": "${orgDid}", "profile": {"$type": "dev.zena-lang.org.profile", ${profile}}}`);
    let wanted = '"displayName": "Acme Corp", "description": "Routers & more", "website": "https://acme.example/"';
    // Bob, a member, is no admin; a website must be a web address.
    equal(errorOf(await put(BOB, wanted)), 'Forbidden');
    equal(errorOf(await put(ALICE, '"website": "javascript:alert(1)"')), 'InvalidRequest');
    let written = ok(await put(ALICE, wanted));
    equal(written['uri'] as String, `at://${orgDid}/dev.zena-lang.org.profile/self`);

    let page = pageOf(await fixture.get('/scopes/acme'));
    isTrue(page.contains('<strong>Acme Corp</strong>') && page.contains('Routers &amp; more') &&
        page.contains('href="https://acme.example/"') && page.contains('<title>Acme Corp · Zena packages</title>'),
        page);
  });

  test('links a package\'s homepage and source only when they are web addresses', async (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let planted = new Profile('router', null, null, 'javascript:alert(document.cookie)', 'https://example.com/router');
    let maintainers = stringify(toJson(new Maintainers([Maintainer.ofDid(ALICE, OWNER)]).toValue()));
    // The App View refuses such a profile.
    equal(errorOf(await fixture.call(ALICE, 'createPackage', `{"organization": "${orgDid}", "profile": ${
        stringify(toJson(planted.toValue()))}, "maintainers": ${maintainers}}`)), 'InvalidRequest');
    // One written some other way still shows no such link.
    let pkgDid = ok(await createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    let account = (await fixture.pds.storage.getAccount(pkgDid)) as Account;
    let current = (await fixture.pds.storage.store(pkgDid).getRecord(PROFILE_TYPE, 'self')) as Cid;
    await fixture.pds.repositoryOf(account).applyWrites([new UpdateRecord(PROFILE_TYPE, 'self', planted.toValue(),
        current) as Write], 0 as i64);
    let page = pageOf(await fixture.get('/packages/router.acme.pkg.test'));
    isTrue(!page.contains('javascript:'), page);
    isTrue(page.contains('href="https://example.com/router"'), page);
  });

  test('stores only artifact types, and serves blobs so that none runs on the App View\'s origin', async (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkgDid = ok(await createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    let page = '<script>fetch("/me")</script>';
    for (let type in ['text/html', 'image/svg+xml', 'application/javascript']) {
      equal(errorOf(await fixture.call(ALICE, 'uploadArtifact', page, `?package=${pkgDid}`, type)), 'InvalidRequest', type);
    }
    // An artifact's own types are kept, without their parameters.
    let wit = BlobRef.fromValue(fromJson(ok(await fixture.call(ALICE, 'uploadArtifact', 'package a:b;', `?package=${pkgDid}`,
        'Text/Plain; charset=utf-8'))['blob'] as JsonObject));
    equal(wit.mimeType, 'text/plain');
    let served = await fixture.get(`/xrpc/com.atproto.sync.getBlob?did=${pkgDid}&cid=${wit.cid.toString()}`);
    equal(served.statusCode, 200);
    equal(served.type ?? '', 'text/plain');
    equal(served.getHeader('content-security-policy') ?? '', "default-src 'none'; sandbox");
    equal(served.getHeader('x-content-type-options') ?? '', 'nosniff');
  });

  test('refuses a request body larger than its method takes, before reading it all', async (ctx) => {
    let fixture = new Fixture();
    // A body before any authentication: 2 MiB of JSON for a session.
    let big = new FixedArray<u8>(2 * 1024 * 1024, 32 as u8);
    let session = await fixture.post('/xrpc/com.atproto.server.createSession', String.fromBytes(big), null);
    equal(session.statusCode, 413);
    equal(errorOf(session), 'PayloadTooLarge');
    // An artifact may be as large as the App View stores, and no larger.
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let pkgDid = ok(await createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    (fixture.appView as AppView).config.releaseBytes = 1000 as i64;
    let over = await fixture.call(ALICE, 'uploadArtifact', new FixedArray<u8>(2000, 1 as u8), `?package=${pkgDid}`,
        'application/octet-stream');
    equal(over.statusCode, 413);
    equal(errorOf(over), 'TooLarge');
    ok(await fixture.call(ALICE, 'uploadArtifact', new FixedArray<u8>(1000, 1 as u8), `?package=${pkgDid}`,
        'application/octet-stream'));
  });

  test('keeps releases, packages and scopes within their storage, which the operator can raise', async (ctx) => {
    let fixture = new Fixture();
    let appView = fixture.appView as AppView;
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let router = ok(await createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    // Room for one archive in a release, two in a package, and three in the scope.
    let size = archiveOf(router, '1.0.0').length as i64;
    appView.config.releaseBytes = size;
    appView.config.packageBytes = 2 * size;
    appView.config.scopeBytes = 3 * size;

    // Only source archives are stored, for now: no Wasm modules beside them.
    let source = await upload(fixture, router, archiveOf(router, '0.1.0'));
    let wasm = BlobRef.fromValue(fromJson(ok(await fixture.call(ALICE, 'uploadArtifact', new FixedArray<u8>(8, 0 as u8),
        `?package=${router}`, 'application/wasm'))['blob'] as JsonObject));
    let withModule = new Release(Version.parse('0.1.0'), '2026-11-09T00:00:00.000Z',
        [Artifact.whole(SOURCE, source), Artifact.whole('core-module', wasm)],
        new FixedArray<Dependency>(0, new Dependency('', Version.parse('0.0.0'), '')));
    let module = await fixture.call(ALICE, 'publish',
        `{"package": "${router}", "release": ${stringify(toJson(withModule.toValue()))}}`);
    equal(errorOf(module), 'InvalidRelease');

    // A release holds at most releaseBytes.
    let large = await fixture.call(ALICE, 'uploadArtifact', new FixedArray<u8>((size + 1) as i32, 1 as u8),
        `?package=${router}`, 'application/vnd.ipld.car');
    equal(errorOf(large), 'TooLarge');
    // A package holds at most packageBytes, counting the releases it holds
    // for approval.
    await release(fixture, ALICE, router, '1.0.0', await upload(fixture, router, archiveOf(router, '1.0.0')));
    let second = await upload(fixture, router, archiveOf(router, '1.0.1'));
    ok(await fixture.call(ALICE, 'publish', `{"package": "${router}", "release": ${releaseJson('1.0.1', second)}}`));
    let third = await fixture.call(ALICE, 'uploadArtifact', archiveOf(router, '1.0.2'), `?package=${router}`,
        'application/vnd.ipld.car');
    equal(errorOf(third), 'QuotaExceeded');
    // The operator allows the package more.
    await appView.setLimit(router, Limit.PackageBytes, some(3 * size));
    await release(fixture, ALICE, router, '1.0.2', await upload(fixture, router, archiveOf(router, '1.0.2')));

    // A scope holds at most scopeBytes, over the releases of all its
    // packages and the ones held of the package at hand.
    let cli = ok(await createPackage(fixture, ALICE, orgDid, 'cli'))['did'] as String;
    let cliArchive = (version: String) => archiveOf(cli, version,
        `{"name": "cli", "did": "${cli}", "description": "A package for tests", "license": "MIT", "version": "${version}"}`);
    await release(fixture, ALICE, cli, '1.0.0', await upload(fixture, cli, cliArchive('1.0.0')));
    let full = await fixture.call(ALICE, 'uploadArtifact', cliArchive('1.0.1'), `?package=${cli}`,
        'application/vnd.ipld.car');
    equal(errorOf(full), 'QuotaExceeded');
    await appView.setLimit(orgDid, Limit.ScopeBytes, some(10 * size));
    await release(fixture, ALICE, cli, '1.0.1', await upload(fixture, cli, cliArchive('1.0.1')));

    // A package, or every package of a scope, may be allowed larger releases.
    let json = ok(await createPackage(fixture, ALICE, orgDid, 'json'))['did'] as String;
    let uploadLarge = () => fixture.call(ALICE, 'uploadArtifact', new FixedArray<u8>((size + 1) as i32, 1 as u8),
        `?package=${json}`, 'application/vnd.ipld.car');
    await appView.setLimit(orgDid, Limit.ReleaseBytes, some(2 * size));
    ok(await uploadLarge());
    // Back to the default.
    await appView.setLimit(orgDid, Limit.ReleaseBytes, none);
    equal(errorOf(await uploadLarge()), 'TooLarge');
    await appView.setLimit(json, Limit.ReleaseBytes, some(2 * size));
    ok(await uploadLarge());
    // The operator names a limit as the App View does.
    equal(limitName(Limit.PackageBytes), 'packageBytes');
    if (let Some {value} = limitNamed('scopeBytes')) {
      isTrue(value == Limit.ScopeBytes);
    } else {
      isTrue(false, 'scopeBytes is not a limit');
    }
    isTrue(limitNamed('blobCount') is None);
  });

  test('counts the actions on each package and scope and by each caller apart, and the scopes and packages created', async (ctx) => {
    let fixture = new Fixture();
    let appView = fixture.appView as AppView;
    let config = appView.config;

    // A person creates one scope a day, and two in all.
    config.scopeCreations = 1;
    config.scopes = 2;
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let again = await createOrganization(fixture, ALICE, 'beta');
    equal(again.statusCode, 429);
    equal(errorOf(again), 'RateLimitExceeded');
    let tomorrow = nowMicros() + DAY_MICROS;
    await appView.createOrganization(ALICE, 'beta', [], tomorrow);
    equal(await refusal(() => appView.createOrganization(ALICE, 'gamma', [], tomorrow + DAY_MICROS)), 'QuotaExceeded');
    // Bob's count is his own, and the operator creates scopes uncounted.
    ok(await createOrganization(fixture, BOB, 'bobs'));
    await appView.createScopeAsOperator(ALICE, 'delta', [], nowMicros());
    await appView.setLimit(ALICE, Limit.Scopes, some(3 as i64));
    await appView.createOrganization(ALICE, 'gamma', [], tomorrow + DAY_MICROS);

    // A scope creates two packages a day, and three in all.
    config.packageCreations = 2;
    config.packages = 3;
    let router = ok(await createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    ok(await createPackage(fixture, ALICE, orgDid, 'cli'));
    equal(errorOf(await createPackage(fixture, ALICE, orgDid, 'json')), 'RateLimitExceeded');
    // Raising the day's count leaves the count in all as it was.
    await appView.setLimit(orgDid, Limit.PackageCreations, some(10 as i64));
    ok(await createPackage(fixture, ALICE, orgDid, 'json'));
    equal(errorOf(await createPackage(fixture, ALICE, orgDid, 'yaml')), 'QuotaExceeded');

    // So far today Alice has made four actions, all in acme, which has had three.
    config.packageActions = 2;
    config.scopeActions = 6;
    config.userActions = 8;
    ok(await upload(fixture, ALICE, router));
    ok(await upload(fixture, ALICE, router));
    // Under the counts of its scope and its caller, the package's is full.
    let third = await upload(fixture, ALICE, router);
    equal(errorOf(third), 'RateLimitExceeded');
    isTrue((json(third)['message'] as String).contains('packageActions'), json(third)['message'] as String);
    // Raising it lets the scope's fill.
    await appView.setLimit(router, Limit.PackageActions, some(10 as i64));
    ok(await upload(fixture, ALICE, router));
    let scopeFull = await upload(fixture, ALICE, router);
    isTrue((json(scopeFull)['message'] as String).contains('scopeActions'), json(scopeFull)['message'] as String);
    await appView.setLimit(orgDid, Limit.ScopeActions, some(100 as i64));
    ok(await upload(fixture, ALICE, router));
    let userFull = await upload(fixture, ALICE, router);
    isTrue((json(userFull)['message'] as String).contains('userActions'), json(userFull)['message'] as String);
    // A call the caller may not make counts against no one.
    equal(errorOf(await upload(fixture, BOB, router)), 'Forbidden');
    await appView.setLimit(ALICE, Limit.UserActions, some(100 as i64));
    ok(await upload(fixture, ALICE, router));
    // A day's counts start again the next day.
    await appView.setLimit(router, Limit.PackageActions, none);
    equal(await refusal(() => appView.uploadArtifact(ALICE, router, 'application/octet-stream',
        new FixedArray<u8>(4, 1 as u8), nowMicros())), 'RateLimitExceeded');
    await appView.uploadArtifact(ALICE, router, 'application/octet-stream', new FixedArray<u8>(4, 1 as u8), tomorrow);

    // A limit on a caller is set on a DID that calls, and no other.
    equal(await refusal(() => appView.setLimit(router, Limit.UserActions, some(1 as i64))), 'InvalidRequest');
    equal(await refusal(() => appView.setLimit(ALICE, Limit.PackageActions, some(1 as i64))), 'InvalidRequest');
  });

  test('lists the packages with a release, the one whose repository changed last first', async (ctx) => {
    let fixture = new Fixture();
    let appView = fixture.appView as AppView;
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let router = ok(await createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    let cli = ok(await createPackage(fixture, ALICE, orgDid, 'cli'))['did'] as String;
    ok(await createPackage(fixture, ALICE, orgDid, 'parser'));
    let cliArchive = (version: String) => archiveOf(cli, version,
        `{"name": "cli", "did": "${cli}", "description": "A package for tests", "license": "MIT", "version": "${version}"}`);
    let handles = async (count: i32) => {
      var text = '';
      for (let summary in await appView.recentPackages(count)) {
        text = `${text} ${summary.name}`;
      }
      return text;
    };
    equal(await handles(10), '');
    await release(fixture, ALICE, router, '1.0.0', await upload(fixture, router, archiveOf(router, '1.0.0')));
    await release(fixture, ALICE, cli, '1.0.0', await upload(fixture, cli, cliArchive('1.0.0')));
    // parser has no release, so it is not listed.
    equal(await handles(10), ' cli router');
    await release(fixture, ALICE, router, '1.0.1', await upload(fixture, router, archiveOf(router, '1.0.1')));
    equal(await handles(10), ' router cli');
    equal(await handles(1), ' router');
  });

  test("shows a package's README, and a page for each version with its files", async (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let router = ok(await createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    let withReadme = (version: String, readme: String) => {
      let files: HashMap<String, FixedArray<u8>> = {
        'zena-package.json' => `{"name": "router", "did": "${router}", "description": "A package for tests", "license": "MIT", "version": "${version}"}`
          .toBytes(),
        'router.zena' => 'export let route = 1;\n'.toBytes(),
        'README.md' => readme.toBytes(),
        'docs/guide.md' => '# Guide\n'.toBytes(),
        'logo.png' => new FixedArray<u8>(4, 137 as u8),
      };
      return packSource(files);
    };
    let links = '[guide](docs/guide.md#start) [up](../outside.md) [gone](nope.md) [source](/router.zena) ' +
        '![logo](./logo.png) ![badge](https://img.example/badge.svg) [top](#router)';
    await release(fixture, ALICE, router, '1.0.0', await upload(fixture, router,
        withReadme('1.0.0', `# Router\n\nRoutes **requests**.\n\n<script>alert(1)</script>\n\n${links}\n`)));
    await release(fixture, ALICE, router, '1.1.0', await upload(fixture, router,
        withReadme('1.1.0', '# Router\n\nNow with ~~fewer~~ more routes.\n')));
    ok(await fixture.call(ALICE, 'retract', `{"package": "${router}", "version": "1.1.0", "reason": "broken"}`));

    // The package page shows the README of the latest release that is not
    // retracted, without the raw HTML in it, and links each version.
    let packageHtml = pageOf(await fixture.get('/packages/router.acme.pkg.test'));
    isTrue(packageHtml.contains('<strong>requests</strong>') && !packageHtml.contains('<script>alert') &&
        !packageHtml.contains('fewer'), packageHtml);
    isTrue(packageHtml.contains('href="/packages/router.acme.pkg.test/versions/1.1.0"'), 'a link to 1.1.0');

    // The README's relative links and images point to the release's files,
    // from the package's root, by the package's DID; one that leaves the
    // root, or names no file, is left out, with its text. An image from
    // another site stays.
    let files = `/packages/${router}/versions/1.0.0/files`;
    for (let expected in [`<a href="${files}/docs/guide.md#start">guide</a>`, ' up ', ' gone ',
        `<a href="${files}/router.zena">source</a>`, `<img src="${files}/logo.png" alt="logo" />`,
        '<img src="https://img.example/badge.svg"', '<a href="#router">top</a>']) {
      isTrue(packageHtml.contains(expected), `${expected} in the README`);
    }
    isTrue(!packageHtml.contains('outside.md') && !packageHtml.contains('nope.md'), 'no link out of the package');
    // The App View serves those files, by DID or by handle: an image as its
    // type, anything else as text, and neither runs on its origin.
    let logo = await fixture.get(`${files}/logo.png`);
    equal(logo.statusCode, 200);
    equal(logo.type ?? '', 'image/png');
    equal(logo.getHeader('content-security-policy') ?? '', "default-src 'none'; sandbox");
    equal(logo.getHeader('x-content-type-options') ?? '', 'nosniff');
    let guide = await fixture.get('/packages/router.acme.pkg.test/versions/1.0.0/files/docs/guide.md');
    equal(guide.statusCode, 200);
    equal(guide.type ?? '', 'text/plain; charset=utf-8');
    equal((await fixture.get(`${files}/nope.md`)).statusCode, 404);

    // A version's page has its own README, its files with their sizes, and
    // the command that adds it.
    let versionResponse = await fixture.get('/packages/router.acme.pkg.test/versions/1.1.0');
    equal(versionResponse.statusCode, 200);
    let versionHtml = pageOf(versionResponse);
    for (let expected in ['<del>fewer</del>', 'README.md', 'router.zena', 'zena-package.json', '5 files', 'retracted',
        'broken', 'bytes', 'zena pkg add router.acme.pkg.test@1.1.0', 'href="/packages/router.acme.pkg.test/versions/1.1.0/files/docs/guide.md"']) {
      isTrue(versionHtml.contains(expected), `${expected} in the version page`);
    }
    // The side bar counts the dependencies, and says how many approve; the
    // tabs, which keep their place in the URL's fragment, count nothing.
    for (let expected in ['<dt>Dependencies</dt><dd>0</dd>', '<h4>Policy</h4>', '<h4>Approved 1.1.0</h4>', '<rad-tab-group data-fragment>',
        '<rad-tab slot="tabs" panel="files">Files</rad-tab>']) {
      isTrue(versionHtml.contains(expected), `${expected} in the version page`);
    }
    equal((await fixture.get('/packages/router.acme.pkg.test/versions/9.9.9')).statusCode, 404);
  });

  test("keeps a release's contents when it is published, and its pages show them from there", async (ctx) => {
    let fixture = new Fixture();
    let appView = fixture.appView as AppView;
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let router = ok(await createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    let archive = archiveOf(router, '1.0.0');
    await release(fixture, ALICE, router, '1.0.0', await upload(fixture, router, archive));
    let kept = (await appView.derived.read(router, '1.0.0')) as ReleaseContents;
    isTrue(kept.archive.equals(Cid.forBlob(archive)), 'from the archive published');
    equal(kept.files.length, 2);

    // The page shows what is kept, and does not derive it again.
    await appView.derived.write(router, '1.0.0',
        new ReleaseContents(kept.archive, kept.archiveBytes, kept.files, 'README.md', '<p>As kept</p>'));
    let html = pageOf(await fixture.get('/packages/router.acme.pkg.test'));
    isTrue(html.contains('<p>As kept</p>'), html);
  });

  test('derives the contents of a release again when they are missing or from another archive', async (ctx) => {
    let fixture = new Fixture();
    let appView = fixture.appView as AppView;
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    ok(await createPackage(fixture, ALICE, orgDid, 'router'));
    // Releases written straight to the repository, as before the App View
    // kept contents: nothing is kept for them.
    let account = (await fixture.pds.storage.accountByHandle('router.acme.pkg.test')) as Account;
    for (let version in ['1.0.0', '1.0.1']) {
      let archive = packSource({
        'zena-package.json' => `{"name": "router", "version": "${version}"}`.toBytes(),
        'README.md' => `# Router ${version}\n`.toBytes(),
      });
      let blob = await upload(fixture, account.did, archive);
      let record = new Release(Version.parse(version), '2026-11-10T00:00:00.000Z',
          new FixedArray<Artifact>(1, Artifact.whole(SOURCE, blob)), []);
      await fixture.pds.repositoryOf(account).applyWrites([new CreateRecord(RELEASE_TYPE, version,
          record.toValue()) as Write], 0 as i64);
    }
    isTrue((await appView.derived.read(account.did, '1.0.0')) == null, 'nothing kept');
    let missing = pageOf(await fixture.get('/packages/router.acme.pkg.test/versions/1.0.0'));
    isTrue(missing.contains('Router 1.0.0</h1>'), missing);
    isTrue((await appView.derived.read(account.did, '1.0.0')) != null, 'kept once derived');

    // Contents kept from another archive are derived again.
    let other = new ReleaseContents(Cid.forBlob('another archive'.toBytes()), 1 as i64,
        new FixedArray<ReleaseFile>(0, new ReleaseFile('', Cid.forBlob('x'.toBytes()), 0 as i64, 0 as i64)), 'README.md',
        '<p>From another archive</p>');
    await appView.derived.write(account.did, '1.0.1', other);
    let stale = pageOf(await fixture.get('/packages/router.acme.pkg.test/versions/1.0.1'));
    isTrue(stale.contains('Router 1.0.1</h1>') && !stale.contains('From another archive'), stale);
    let rewritten = (await appView.derived.read(account.did, '1.0.1')) as ReleaseContents;
    equal(rewritten.files.length, 2);
  });

  test("serves a file by reading its span of the archive, checked against the file's CID", async (ctx) => {
    let fixture = new Fixture();
    let appView = fixture.appView as AppView;
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let router = ok(await createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    for (let version in ['1.0.0', '1.0.1']) {
      await release(fixture, ALICE, router, version, await upload(fixture, router, archiveOf(router, version)));
    }
    let file = await fixture.get('/packages/router.acme.pkg.test/versions/1.0.0/files/router.zena');
    equal(file.statusCode, 200);
    equal(String.fromBytes(file.body as FixedArray<u8>), 'export let route = 1;\n');

    // Contents kept with the file one byte further on: the bytes read there
    // are not the file's, and are not served.
    let kept = (await appView.derived.read(router, '1.0.1')) as ReleaseContents;
    let moved = kept.files.map((f, i, all) => new ReleaseFile(f.path, f.cid, f.size, f.offset + (1 as i64)));
    await appView.derived.write(router, '1.0.1',
        new ReleaseContents(kept.archive, kept.archiveBytes, moved, kept.readmePath, kept.readmeHtml));
    equal((await fixture.get('/packages/router.acme.pkg.test/versions/1.0.1/files/router.zena')).statusCode, 404);
  });

  test('links to a README too large to render', async (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let router = ok(await createPackage(fixture, ALICE, orgDid, 'router'))['did'] as String;
    let archive = packSource({
      'zena-package.json' => `{"name": "router", "did": "${router}", "description": "A package for tests", "license": "MIT", "version": "1.0.0"}`
        .toBytes(),
      'README.md' => new FixedArray<u8>(MAX_README_BYTES + 1, 97 as u8),
    });
    await release(fixture, ALICE, router, '1.0.0', await upload(fixture, router, archive));
    let html = pageOf(await fixture.get('/packages/router.acme.pkg.test'));
    isTrue(html.contains('The README is too large to show here') &&
        html.contains('href="/packages/router.acme.pkg.test/versions/1.0.0/files/README.md"'), html);
  });

  test('renders the pages a visitor browses', async (ctx) => {
    let fixture = new Fixture();
    let router = await seedBrowsable(fixture);

    let home = await fixture.get('/');
    equal(home.statusCode, 200, 'home');
    let homeHtml = pageOf(home);
    for (let expected in ['Packages for Zena', 'href="/docs/"', 'href="/docs/installing/"', 'Installing Packages',
        'Decentralized', 'Recently updated', 'href="/packages/router.acme.pkg.test"', 'zena pkg add router.acme.pkg.test']) {
      isTrue(homeHtml.contains(expected), `${expected} in the home page`);
    }
    // Only packages with a release, and no made-up ones.
    isTrue(!homeHtml.contains('parser.acme.pkg.test') && !homeHtml.contains('@zena/http'), homeHtml);
    // The filter matches the description, ignoring case, and escapes the query.
    let found = pageOf(await fixture.get('/?q=ROUTES'));
    isTrue(found.contains('router.acme.pkg.test') && !found.contains('parser.acme.pkg.test'), found);
    let none = pageOf(await fixture.get('/?q=%3Cb%3E'));
    isTrue(none.contains('No packages match') && none.contains('&lt;b&gt;') && !none.contains('<b>'), none);

    let scope = pageOf(await fixture.get('/scopes/acme'));
    isTrue(scope.contains('@acme') && scope.contains('parser.acme.pkg.test'), scope);
    equal((await fixture.get('/scopes/nobody')).statusCode, 404, 'a missing scope');

    // A release of parser that depends on router, written straight to its
    // repository: publish would check the dependency against its source.
    let parser = (await fixture.pds.storage.accountByHandle('parser.acme.pkg.test')) as Account;
    let blob = await upload(fixture, parser.did, archiveOf(parser.did, '0.3.0'));
    let withDependency = new Release(Version.parse('0.3.0'), '2026-10-24T00:00:00.000Z',
        new FixedArray<Artifact>(1, Artifact.whole(SOURCE, blob)),
        [new Dependency(router, Version.parse('1.0.0'), 'router'),
         new Dependency('did:plc:elsewhereelsewhereelsewh', Version.parse('0.2.1'), 'other')]);
    await fixture.pds.repositoryOf(parser).applyWrites([new CreateRecord(RELEASE_TYPE, '0.3.0',
        withDependency.toValue()) as Write], 0 as i64);
    let parserHtml = pageOf(await fixture.get('/packages/parser.acme.pkg.test'));
    for (let expected in ['href="/scopes/acme"', 'href="/packages/router.acme.pkg.test">router</a>',
        '≥ 1.0.0 (1.x)', 'did:plc:elsewhereelsewhereelsewh', '≥ 0.2.1 (0.x)']) {
      isTrue(parserHtml.contains(expected), `${expected} in parser's page`);
    }

    let pkg = await fixture.get('/packages/router.acme.pkg.test');
    equal(pkg.statusCode, 200, 'package');
    let pkgHtml = pageOf(pkg);
    for (let expected in ['zena pkg add router.acme.pkg.test', router, '>MIT<', ALICE, 'broken',
        'class="retracted"']) {
      isTrue(pkgHtml.contains(expected), `${expected} in the package page`);
    }
    // 1.1.0 is retracted, so 1.0.0 is the latest, and listed after it.
    isTrue(pkgHtml.contains('chip-primary">1.0.0<'), 'the latest');
    isTrue(pkgHtml.split('>1.1.0<')[1].contains('/versions/1.0.0">1.0.0</a>'), 'newest first');

    let missing = await fixture.get('/packages/nothing.acme.pkg.test');
    equal(missing.statusCode, 404, 'a missing package');
    isTrue(pageOf(missing).contains('No package here'), 'the not-found page');
    equal((await fixture.get('/nowhere')).statusCode, 404, 'a path no page has');
  });

  test("lists a caller's memberships, a team's packages included", async (ctx) => {
    let fixture = new Fixture();
    let org = ok(await createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let alice = await entriesSeen(fixture, ALICE, orgDid);
    let bobAdmin = new MemberEntry(BOB, ADMIN, filled(190));
    ok(await putMembers(fixture, ALICE, orgDid, [alice[0], bobAdmin], [bobAdmin], (org['members'] as JsonObject)['cid'] as String));
    ok(await putTeam(fixture, ALICE, orgDid, 'core', [new MemberEntry(BOB, MAINTAINER, filled(191))], null));
    let pkg = ok(await createPackage(fixture, ALICE, orgDid, 'router'));
    let pkgDid = pkg['did'] as String;
    ok(await putMaintainers(fixture, ALICE, pkgDid, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, null, orgDid, 'core', PUBLISHER)]), [], (pkg['maintainers'] as JsonObject)['cid'] as String));
    ok(await createPackage(fixture, ALICE, orgDid, 'parser'));

    let bob = ok(await fixture.query(BOB, 'getMemberships', ''));
    equal(bob['did'] as String, BOB);
    let orgs = bob['orgs'] as JsonArray;
    equal(orgs.length, 1);
    equal((orgs[0] as JsonObject)['name'] as String, 'acme');
    equal((orgs[0] as JsonObject)['role'] as String, 'admin');
    let teams = bob['teams'] as JsonArray;
    equal(teams.length, 1);
    equal((teams[0] as JsonObject)['name'] as String, 'core');
    equal((teams[0] as JsonObject)['role'] as String, 'maintainer');
    // Through the team, Bob publishes router, and parser is none of his.
    let packages = bob['packages'] as JsonArray;
    equal(packages.length, 1);
    equal((packages[0] as JsonObject)['handle'] as String, 'router.acme.pkg.test');
    equal((packages[0] as JsonObject)['role'] as String, 'publisher');
    let mine = ok(await fixture.query(ALICE, 'getMemberships', ''));
    equal(((mine['orgs'] as JsonArray)[0] as JsonObject)['role'] as String, 'owner');
    equal((mine['teams'] as JsonArray).length, 0);
    equal((mine['packages'] as JsonArray).length, 2);
    // Without a token, nothing.
    equal(errorOf(await fixture.get('/xrpc/dev.zena-lang.registry.getMemberships')), 'AuthenticationRequired');
  });

  test('resolves handles, and describes the web app as an OAuth client', async (ctx) => {
    let fixture = new Fixture();
    let orgDid = ok(await createOrganization(fixture, ALICE, 'acme'))['did'] as String;
    let resolved = ok(await fixture.get('/xrpc/com.atproto.identity.resolveHandle?handle=ACME.pkg.test'));
    equal(resolved['did'] as String, orgDid);
    equal(errorOf(await fixture.get('/xrpc/com.atproto.identity.resolveHandle?handle=nobody.example.com')), 'HandleNotFound');
    let metadata = ok(await fixture.get('/oauth/client-metadata.json'));
    equal(metadata['client_id'] as String, 'https://pkg.test/oauth/client-metadata.json');
    equal(((metadata['redirect_uris'] as JsonArray)[0]) as String, 'https://pkg.test/oauth/callback');
    // Tokens for signing in to the pages, and nothing else.
    equal(metadata['scope'] as String, 'atproto rpc:dev.zena-lang.registry.createWebSession?aud=*');
    equal(metadata['token_endpoint_auth_method'] as String, 'none');
  });

  test('reads only the accounts that mention a caller, for their memberships and their page', async (ctx) => {
    let storage = new CountingStorage();
    let fixture = new Fixture(new MemoryAppViewStore(), storage);
    let org = ok(await createOrganization(fixture, ALICE, 'acme'));
    let orgDid = org['did'] as String;
    let alice = await entriesSeen(fixture, ALICE, orgDid);
    let bobAdmin = new MemberEntry(BOB, ADMIN, filled(190));
    ok(await putMembers(fixture, ALICE, orgDid, [alice[0], bobAdmin], [bobAdmin], (org['members'] as JsonObject)['cid'] as String));
    ok(await putTeam(fixture, ALICE, orgDid, 'core', [new MemberEntry(BOB, MAINTAINER, filled(191))], null));
    let router = ok(await createPackage(fixture, ALICE, orgDid, 'router'));
    ok(await putMaintainers(fixture, ALICE, router['did'] as String, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        new Maintainer(null, null, orgDid, 'core', PUBLISHER)]), [], (router['maintainers'] as JsonObject)['cid'] as String));
    let parser = ok(await createPackage(fixture, ALICE, orgDid, 'parser'));
    ok(await putMaintainers(fixture, ALICE, parser['did'] as String, new Maintainers([Maintainer.ofDid(ALICE, OWNER),
        Maintainer.ofDid(BOB, PUBLISHER)]), [], (parser['maintainers'] as JsonObject)['cid'] as String));

    storage.reads = 0;
    let before = stringify(ok(await fixture.query(BOB, 'getMemberships', '')));
    let membershipReads = storage.reads;
    isTrue(before.contains('router.acme.pkg.test') && before.contains('parser.acme.pkg.test'), before);
    // The first view fills the pages' cache of people.
    pageOf(await fixture.get(`/people/${BOB}`));
    storage.reads = 0;
    let page = pageOf(await fixture.get(`/people/${BOB}`));
    let pageReads = storage.reads;
    isTrue(page.contains('href="/packages/parser.acme.pkg.test"'), page);

    // Another scope, with packages, that names Bob nowhere.
    let zeta = ok(await createOrganization(fixture, ALICE, 'zeta'))['did'] as String;
    for (let name in ['one', 'two', 'three']) {
      ok(await createPackage(fixture, ALICE, zeta, name));
    }
    storage.reads = 0;
    equal(stringify(ok(await fixture.query(BOB, 'getMemberships', ''))), before);
    equal(storage.reads, membershipReads);
    storage.reads = 0;
    pageOf(await fixture.get(`/people/${BOB}`));
    equal(storage.reads, pageReads);
  });

  test("links maintainers to their pages, which list the packages that name them", async (ctx) => {
    let fixture = new Fixture();
