    // Alice's DID does not resolve here, so it stands in for her handle.
    let router = pageOf(await fixture.get('/packages/router.acme.pkg.test'));
    isTrue(router.contains(`href="/people/${ALICE}"`), router);

    let alice = await fixture.get(`/people/${ALICE}`);
    equal(alice.statusCode, 200, 'her page');
