/**
 * The site's sessions (`registry:web-sessions`): the tokens of its
 * cookies, which stand for nothing at the PDS, and its URL signatures.
 */

import {suite, test} from 'zena:test';
import {equal, isTrue} from 'zena:assert';
import {Future} from 'zena:async';
import {KeyType} from 'atproto:didkey';
import {Pds} from 'pds:pds';
import {MemoryCredentialStore, SessionError, Sessions} from 'pds:sessions';
import {MemoryStorage, SigningKey} from 'pds:storage';
import {WEB_SECONDS, WebCaller, WebSessions} from 'registry:web-sessions';

let DID = 'did:plc:botbotbotbotbotbotbotbotb';
let NOW = 1790000000 as i64;

function secret(byte: i32) {
  return new FixedArray<u8>(32, byte as u8);
}

export let tests = suite('registry:web-sessions', () => {
  test('signs web sessions that stand for nothing else', (ctx) => {
    let sessions = new WebSessions(secret(1));
    let person = 'did:plc:alicealicealicealicealic';
    let token = sessions.webSession(person, 'alice.example.com', NOW);
    let caller = sessions.webCaller(token, NOW + (60 as i64));
    isTrue(caller != null, 'a web session');
    equal((caller as WebCaller).did, person);
    equal((caller as WebCaller).name(), 'alice.example.com');
    // Without a handle, the DID stands in.
    equal((sessions.webCaller(sessions.webSession(person, null, NOW), NOW) as WebCaller).name(), person);

    // Expired, signed by another server, altered, or no token at all: nobody.
    isTrue(sessions.webCaller(token, NOW + WEB_SECONDS + (1 as i64)) == null, 'expired');
    isTrue(new WebSessions(secret(2)).webCaller(token, NOW) == null, 'another secret');
    let parts = token.split('.');
    let forged = sessions.webSession('did:plc:mallorymallorymallorymal', null, NOW).split('.');
    isTrue(sessions.webCaller(`${parts[0]}.${forged[1]}.${parts[2]}`, NOW) == null, 'altered');
    isTrue(sessions.webCaller(null, NOW) == null && sessions.webCaller('', NOW) == null, 'none');
  });

  test("is not the PDS's session under the same secret, either way", async (ctx): Future<void> => {
    // A PDS in the same process signs its sessions with the same secret by
    // default (`registry:service`).
    let pds = new Pds(new MemoryStorage());
    await pds.createAccount(DID, 'ci.acme.pkg.test', new SigningKey(KeyType.Secp256k1, new FixedArray<u8>(32, 9 as u8)),
        NOW * (1000000 as i64));
    var counter = 0;
    let accounts = new Sessions(pds.storage, new MemoryCredentialStore(), secret(1), (count: i32) => {
      counter += 1;
      return new FixedArray<u8>(count, counter as u8);
    });
    let password = await accounts.addAppPassword(DID, 'ci', '2026-10-27T00:00:00.000Z');
    let tokens = await accounts.create(DID, password, NOW);
    let sessions = new WebSessions(secret(1));
    isTrue(sessions.webCaller(tokens.accessJwt, NOW) == null, 'an access token');
    isTrue(sessions.webCaller(tokens.refreshJwt, NOW) == null, 'a refresh token');
    let web = sessions.webSession(DID, null, NOW);
    var refused = '';
    try {
      await accounts.authenticate(`Bearer ${web}`, NOW);
    } catch (e) {
      refused = if (e is SessionError) e.error else `another error: ${e.message}`;
    }
    equal(refused, 'InvalidToken');
  });

  test('signs URLs, and checks only what it signed', (ctx) => {
    let sessions = new WebSessions(secret(1));
    let signature = sessions.urlSignature(DID);
    isTrue(sessions.checkUrlSignature(DID, signature), 'its own');
    isTrue(!sessions.checkUrlSignature('did:plc:mallorymallorymallorymal', signature), 'another value');
    isTrue(!new WebSessions(secret(2)).checkUrlSignature(DID, signature), 'another secret');
    isTrue(!sessions.checkUrlSignature(DID, null) && !sessions.checkUrlSignature(DID, ''), 'none');
  });
});
