export let HOME_TEMPLATE = "<div class=\"home-page\">\n  <div class=\"hero hero-centered\">\n    <div class=\"container\">\n      <div class=\"main\">\n        <h1><span class=\"name clip\">Packages for Zena</span></h1>\n        <p class=\"title\">Find and share packages for the Zena programming language.</p>\n        <p class=\"tagline\">Add libraries and tools to your project with one command, or publish your own under a scope your team controls.</p>\n        <!--zena-slot-->search-form<!--zena-slot-->\n        <div class=\"actions\">\n          <div class=\"action\">\n            <a class=\"button brand\" href=\"/docs/installing/\">Install a Package</a>\n          </div>\n          <div class=\"action\">\n            <a class=\"button alt\" href=\"/docs/publishing/\">Publish a Package</a>\n          </div>\n          <div class=\"action\">\n            <a class=\"button alt\" href=\"/docs/\">Documentation</a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"features\">\n    <div class=\"container\">\n      <div class=\"items\">\n        <div class=\"item grid-3\">\n          <a class=\"feature link\" href=\"/docs/installing/\">\n            <article class=\"box\">\n              <div class=\"header\">\n                <div class=\"icon\">📦</div>\n                <h2 class=\"title\">Installing Packages</h2>\n              </div>\n              <p class=\"details\">Add a package to your project by name and import its libraries. Every dependency is pinned, so every machine builds the same code, and nothing updates until you ask.</p>\n              <div class=\"link-text\">\n                <p class=\"link-text-value\">Install a package <span class=\"icon-arrow-right link-text-icon\"></span></p>\n              </div>\n            </article>\n          </a>\n        </div>\n        <div class=\"item grid-3\">\n          <a class=\"feature link\" href=\"/docs/publishing/\">\n            <article class=\"box\">\n              <div class=\"header\">\n                <div class=\"icon\">🚀</div>\n                <h2 class=\"title\">Publishing Packages</h2>\n              </div>\n              <p class=\"details\">Sign in with the account you already have, define your package in its manifest, and publish a release under your scope.</p>\n              <div class=\"link-text\">\n                <p class=\"link-text-value\">Publish a package <span class=\"icon-arrow-right link-text-icon\"></span></p>\n              </div>\n            </article>\n          </a>\n        </div>\n        <div class=\"item grid-3\">\n          <a class=\"feature link\" href=\"/docs/security/\">\n            <article class=\"box\">\n              <div class=\"header\">\n                <div class=\"icon\">🛡️</div>\n                <h2 class=\"title\">Security</h2>\n              </div>\n              <p class=\"details\">Built to keep supply-chain attacks and malicious packages out of your project. Published versions never change, and a release can need approval from several maintainers.</p>\n              <div class=\"link-text\">\n                <p class=\"link-text-value\">How packages are protected <span class=\"icon-arrow-right link-text-icon\"></span></p>\n              </div>\n            </article>\n          </a>\n        </div>\n        <div class=\"item grid-3\">\n          <a class=\"feature link\" href=\"/docs/security/#planned\">\n            <article class=\"box\">\n              <div class=\"header\">\n                <div class=\"icon\">🏷️</div>\n                <h2 class=\"title\">Labels</h2>\n              </div>\n              <p class=\"details\">Coming soon. Anyone can run a labeler that marks packages as reviewed, deprecated or malicious, and you choose whose labels your projects follow.</p>\n              <div class=\"link-text\">\n                <p class=\"link-text-value\">Labels and what is planned <span class=\"icon-arrow-right link-text-icon\"></span></p>\n              </div>\n            </article>\n          </a>\n        </div>\n        <div class=\"item grid-3\">\n          <a class=\"feature link\" href=\"/docs/orgs-and-teams/\">\n            <article class=\"box\">\n              <div class=\"header\">\n                <div class=\"icon\">👥</div>\n                <h2 class=\"title\">Scopes, Orgs &amp; Teams</h2>\n              </div>\n              <p class=\"details\">Publish under a scope your organization owns, such as <code>@acme</code>. Give members and teams roles, and keep who belongs private until they act.</p>\n              <div class=\"link-text\">\n                <p class=\"link-text-value\">Orgs &amp; teams <span class=\"icon-arrow-right link-text-icon\"></span></p>\n              </div>\n            </article>\n          </a>\n        </div>\n        <div class=\"item grid-3\">\n          <a class=\"feature link\" href=\"/docs/decentralized/\">\n            <article class=\"box\">\n              <div class=\"header\">\n                <div class=\"icon\">🌐</div>\n                <h2 class=\"title\">Decentralized</h2>\n              </div>\n              <p class=\"details\">No registry owns your packages. Each keeps its own identity and data wherever it is hosted. Built on the AT Protocol, the network Bluesky runs on.</p>\n              <div class=\"link-text\">\n                <p class=\"link-text-value\">Decentralized packages <span class=\"icon-arrow-right link-text-icon\"></span></p>\n              </div>\n            </article>\n          </a>\n        </div>\n      </div>\n    </div>\n  </div>\n  <!--zena-slot-->featured-packages<!--zena-slot-->\n</div>\n";
