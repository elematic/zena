/**
 * A package's page, `/packages/<handle>`, and a page for each of its
 * versions, `/packages/<handle>/versions/<version>`, laid out alike: the
 * package page shows its latest release that is not retracted, and a
 * version's page that release. Under the name, the releases waiting for
 * approval, for its maintainers; then tabs (a Radica tab group) for the
 * release's README, its files, its dependencies, and every version; and
 * beside them a side bar with the command that adds it, when it was
 * published, who approved it, its size, its links and its maintainers.
 * A file's page, `/packages/<handle>/versions/<version>/files/<path>`, is
 * its version's page with the file shown in the Files tab; the file's
 * bytes are served at `.../raw/<path>`.
 */

import {HashMap, HashSet} from 'zena:collections';
import {GrowableArray, join} from 'zena:core';
import {isValidUtf8} from 'zena:encoding';
import {HTMLPartial, Response, Router, TemplateValue, html, unsafeHTML} from 'zena:http';
import {percentDecode} from 'zena:url';
import {Dependency, Maintainer, Maintainers, RELEASE_TYPE, Release} from 'package-manager/records';
import {PackageDetail, AppView} from '../../app-view.zena';
import {MAX_README_BYTES, ReleaseContents, ReleaseFile, fileUrl, rawUrl, renderMarkdown} from '../../release-contents.zena';
import {Approvals} from '../approvals.zena';
import {page} from '../layout.zena';
import {People} from '../people.zena';
import {PageContext, contextOf} from '../session.zena';
import {chip, count, each, externalLink, formatBytes, when} from '../partials/common.zena';
import {Shown, describe, shownWith, visibleEntries} from '../partials/members.zena';
import {PendingRow, pendingOf, pendingTable} from '../partials/pending.zena';
import {personLink} from '../partials/person.zena';
import {notFound} from './not-found.zena';

/** How many of a package's newest releases its page shows the approvers of. */
let APPROVALS_SHOWN = 10;

/** The largest file shown in its page, in bytes; a larger one is linked to. */
let MAX_FILE_SHOWN = 1024 * 1024;

/** The image types a package's file is served as, by its extension; any other file is plain text. */
let IMAGE_TYPES: HashMap<String, String> = {
  'png' => 'image/png',
  'jpg' => 'image/jpeg',
  'jpeg' => 'image/jpeg',
  'gif' => 'image/gif',
  'webp' => 'image/webp',
  'avif' => 'image/avif',
  'svg' => 'image/svg+xml',
  'ico' => 'image/x-icon',
};

/**
 * Adds the package page, `/packages/<handle>`, its versions' pages,
 * `/packages/<handle>/versions/<version>`, and their files' pages and
 * bytes to `router`.
 */
export function packagePage(router: Router, appView: AppView, people: People, approvals: Approvals): void {
  // By handle or by DID: a README's links name the package by its DID, so
  // that they keep working when it is renamed.
  router.get('/packages/:handle/versions/:version/raw/*', async (req, res, next, params) => {
    let handle = percentDecode(params['handle'] ?? '');
    let version = percentDecode(params['version'] ?? '');
    let detail = await appView.getPackage(handle);
    let path = percentDecode(params['*'] ?? '');
    let contents = if (detail != null) await appView.releaseFile(detail.did, version, path) else null;
    if (contents != null) {
      serveFile(res, path, contents);
      return;
    }
    let context = await contextOf(req, appView, people);
    notFound(res, context, `${handle} ${version} has no file ${path}.`);
  });
  router.get('/packages/:handle/versions/:version/files/*', async (req, res, next, params) => {
    let context = await contextOf(req, appView, people);
    // A Markdown file's page shows its source, numbered by line, with `?view=source`.
    await packageView(context, res, appView, approvals, percentDecode(params['handle'] ?? ''),
        percentDecode(params['version'] ?? ''), percentDecode(params['*'] ?? ''),
        req.url.searchParams().get('view') == 'source');
  });
  router.get('/packages/:handle/versions/:version', async (req, res, next, params) => {
    let context = await contextOf(req, appView, people);
    await packageView(context, res, appView, approvals, percentDecode(params['handle'] ?? ''),
        percentDecode(params['version'] ?? ''), null, false);
  });
  router.get('/packages/:handle', async (req, res, next, params) => {
    let context = await contextOf(req, appView, people);
    await packageView(context, res, appView, approvals, percentDecode(params['handle'] ?? ''), null, null, false);
  });
}

/**
 * Answers with the page of the package `handle` at `version`, or at its
 * latest release that is not retracted for null, showing the file at
 * `path` of that release in its Files tab when `path` is not null; or not
 * found.
 */
async function packageView(context: PageContext, res: Response, appView: AppView, approvals: Approvals,
    handle: String, version: String | null, path: String | null, source: boolean): Future<void> {
  let detail = await appView.getPackage(handle);
  if (detail == null) {
    notFound(res, context, `No package here has the handle ${handle}.`);
    return;
  }
  let found = detail;
  var release: Release | null = null;
  let wanted = version ?? latestVersion(found);
  for (let candidate in found.releases) {
    if (candidate.version.toString() == wanted) {
      release = candidate;
    }
  }
  if (version != null && release == null) {
    notFound(res, context, `${handle} has no release ${version}.`);
    return;
  }
  // The handles of the dependencies this App View holds, to link to them.
  let handles = new HashMap<String, String>();
  for (let listed in found.releases) {
    for (let dependency in listed.dependencies) {
      let account = await appView.accountOf(dependency.did);
      if (account != null) {
        handles[dependency.did] = account.handle;
      }
    }
  }
  let name = found.profile?.name ?? found.handle;
  let named = new GrowableArray<String>();
  let record = found.maintainers;
  if (record != null) {
    for (let maintainer in record.maintainers) {
      if (maintainer.did != null) {
        named.push(maintainer.did as String);
      }
    }
  }
  // Who approved the newest releases, and the one shown: each attester's
  // repository is asked once per release, so the oldest are left out.
  let attesters = await appView.attesters(found.did);
  let approvedBy = new HashMap<String, Array<String>>();
  var checked = 0;
  for (let candidate in found.releases) {
    let candidateVersion = candidate.version.toString();
    if (checked < APPROVALS_SHOWN || candidateVersion == wanted) {
      if (let (true, cid) = found.releaseCids.get(candidateVersion)) {
        let approvers = await approvals.of(`at://${found.did}/${RELEASE_TYPE}/${candidateVersion}`, cid, attesters);
        approvedBy[candidateVersion] = approvers;
        for (let did in approvers) {
          named.push(did);
        }
      }
    }
    checked += 1;
  }
  let shown = await shownWith(context, await visibleEntries(context, found.did, null), named);
  if (record != null) {
    for (let maintainer in record.maintainers) {
      let org = maintainer.org;
      if (org != null) {
        let account = await appView.accountOf(org);
        if (account != null) {
          shown.scopes[org] = account.scope;
        }
      }
    }
  }
  // A maintainer sees the releases waiting for approval.
  var waiting: HTMLPartial | null = null;
  let who = context.who;
  if (who != null) {
    let rows = new GrowableArray<PendingRow>();
    for (let held in await pendingOf(appView, who.did, found.did)) {
      rows.push(new PendingRow(found.handle, name, held));
    }
    if (rows.length > 0) {
      waiting = await pendingTable(context, rows, false);
    }
  }
  let contents = if (wanted != null) await appView.releaseContents(found.did, wanted) else null;
  var opened: HTMLPartial | null = null;
  var shownPath: String | null = null;
  if (path != null) {
    // A directory's path may end with `/`; its page's title does.
    let trimmed = if (path.endsWith('/')) path.sliceBytes(0, path.length - 1) else path;
    var listed: ReleaseFile | null = null;
    var directory = false;
    if (contents != null) {
      for (let candidate in contents.files) {
        if (candidate.path == trimmed) {
          listed = candidate;
        } else if (trimmed != '' && candidate.path.startsWith(`${trimmed}/`)) {
          directory = true;
        }
      }
    }
    if (listed != null) {
      // An image is shown from its bytes' URL, and a file too large to show is linked to; only text is read.
      let read = !IMAGE_TYPES.has(extensionOf(trimmed)) && listed.size <= MAX_FILE_SHOWN as i64;
      let bytes = if (read) await appView.releaseFile(found.did, wanted as String, trimmed) else null;
      opened = fileView(found.handle, found.did, name, wanted as String, contents as ReleaseContents, listed, bytes, source);
      shownPath = trimmed;
    } else if (directory) {
      opened = html`
        ${breadcrumb(found.handle, wanted as String, name, trimmed)}
        ${directoryList(found.handle, wanted as String, contents as ReleaseContents, trimmed)}
      `;
      shownPath = `${trimmed}/`;
    } else {
      notFound(res, context, `${handle} ${version ?? ''} has no file ${path}.`);
      return;
    }
  }
  let title = if (version != null) `${name} ${version}` else name;
  let fullTitle = if (shownPath != null) `${shownPath} · ${title}` else title;
  res.type = 'text/html; charset=utf-8';
  res.body = page(`${fullTitle} · Zena packages`, context,
      packageBody(found, release, version != null, contents, opened, handles, shown, approvedBy, waiting));
}

/**
 * The page of `detail` showing `release`, or no release when it has none
 * that is not retracted; `pinned` when the page is the release's own, whose
 * command adds that version. With `opened`, a file or a directory, the
 * Files tab is open and shows it in place of the package's root.
 */
function packageBody(detail: PackageDetail, release: Release | null, pinned: boolean, contents: ReleaseContents | null,
    opened: HTMLPartial | null, handles: HashMap<String, String>, shown: Shown, approvedBy: HashMap<String, Array<String>>,
    waiting: HTMLPartial | null): HTMLPartial {
  let profile = detail.profile;
  let name = profile?.name ?? detail.handle;
  let version = if (release != null) release.version.toString() else null;
  var reason: String | null = null;
  var retracted = false;
  if (version != null) {
    if (let (true, retraction) = detail.retractions.get(version)) {
      retracted = true;
      reason = retraction.reason;
    }
  }
  // TODO(#1031): `profile?.license ?? '—'` as one expression, once that no longer traps on a profile with no
  // license; apart, the two work.
  let licensed = profile?.license;
  let license = licensed ?? '—';
  let dependencyCount = if (release != null) release.dependencies.length else 0;
  return html`
    <div class="package-header">
      <h1 class="with-chips">
        ${if (pinned) html`<a href="/packages/${detail.handle}">${name}</a>` else name}
        ${when(version != null, () => chip(version as String, if (retracted) 'danger' else 'primary'))}
        ${when(retracted, () => chip('retracted', 'danger'))}
      </h1>
      ${when(profile?.description != null, () => html`<p>${profile?.description as String}</p>`)}
      ${when(reason != null, () => html`<p>Retracted: ${reason as String}</p>`)}
    </div>
    ${when(waiting != null, () => html`
    <section>
      <h2>Waiting for approval</h2>
      ${waiting}
    </section>`)}
    <div class="package-layout">
      <div class="package-main">
        <rad-tab-group data-fragment>
          <rad-tab slot="tabs" panel="readme"${if (opened == null) ' active' else ''}>Readme</rad-tab>
          <rad-tab slot="tabs" panel="files"${if (opened != null) ' active' else ''}>Files</rad-tab>
          <rad-tab slot="tabs" panel="dependencies">Dependencies</rad-tab>
          <rad-tab slot="tabs" panel="versions">Versions</rad-tab>
          <rad-tab-panel name="readme"${if (opened == null) ' active' else ''}>
            ${if (release == null) html`<p class="muted">Nothing is published yet.</p>`
                else readme(detail.handle, version as String, contents)}
          </rad-tab-panel>
          <rad-tab-panel name="files"${if (opened != null) ' active' else ''}>
            ${opened ?? if (contents == null) html`<p class="muted">${if (release == null) 'Nothing is published yet.' else 'The source archive could not be read.'}</p>`
                else rootList(detail.handle, version as String, contents)}
          </rad-tab-panel>
          <rad-tab-panel name="dependencies">
            ${if (release == null) html`<p class="muted">Nothing is published yet.</p>` else dependencies(release, handles)}
          </rad-tab-panel>
          <rad-tab-panel name="versions">
            ${if (detail.releases.length == 0) html`<p class="muted">Nothing is published yet.</p>`
                else versions(detail, handles, shown, approvedBy)}
          </rad-tab-panel>
        </rad-tab-group>
      </div>
      <aside class="package-sidebar">
        <section>
          <h3>Install</h3>
          <pre class="mono">zena pkg add ${detail.handle}${if (pinned && version != null) `@${version}` else ''}</pre>
        </section>
        ${when(release != null, () => html`
        <section>
          <dl class="pairs">
            <div><dt>Version</dt><dd class="mono">${version as String}</dd></div>
            <div><dt>License</dt><dd>${license}</dd></div>
            <div><dt>Published</dt><dd>${(release as Release).createdAt.sliceBytes(0, 10)}</dd></div>
            <div><dt>Dependencies</dt><dd>${`${dependencyCount}`}</dd></div>
            ${when(contents != null, () => html`
            <div><dt>Size</dt><dd>${formatBytes((contents as ReleaseContents).archiveBytes)}</dd></div>
            <div><dt>Files</dt><dd>${`${(contents as ReleaseContents).files.length}`}</dd></div>`)}
          </dl>
        </section>`)}
        <section>
          <h3>Package</h3>
          <p class="name"><a href="/scopes/${detail.scope}">${detail.scope}</a>:${detail.profile?.name ?? detail.handle}</p>
          <p class="mono muted small" title="Handle">${detail.handle}</p>
          <p class="mono muted small" title="DID">${detail.did}</p>
          ${when(profile?.homepage != null || profile?.source != null, () => html`
          <p class="links">${externalLink(profile?.homepage, 'Homepage')} ${externalLink(profile?.source, 'Source')}</p>`)}
        </section>
        <section>
          <h3>Maintainers</h3>
          ${if (detail.maintainers == null) html`<p class="muted">No maintainers record.</p>`
              else maintainerList(detail.maintainers as Maintainers, shown)}
          ${when(version != null, () => html`
          <h4>Approved ${version as String}</h4>
          ${approvers(version as String, shown, approvedBy)}`)}
          ${when(detail.maintainers != null, () => html`
          <h4>Policy</h4>
          <p>${approvalPolicy(detail.maintainers as Maintainers)}</p>`)}
        </section>
      </aside>
    </div>
  `;
}

/**
 * Answers with `contents`, the file at `path` in a release's archive: an
 * image as its type, so a README can show it, and anything else as plain
 * text. The publisher chose the bytes, so the answer may not be sniffed and
 * runs nothing (an SVG's script included); it never changes, since a
 * release never does.
 */
function serveFile(res: Response, path: String, contents: FixedArray<u8>): void {
  res.type = IMAGE_TYPES.getOr(extensionOf(path), 'text/plain; charset=utf-8');
  res.setHeader('cache-control', 'public, max-age=31536000, immutable');
  res.setHeader('x-content-type-options', 'nosniff');
  res.setHeader('content-security-policy', "default-src 'none'; sandbox");
  res.body = contents;
}

/** The extension of the file at `path`, in lower case, or `''`. */
function extensionOf(path: String): String {
  let dot = path.split('.');
  return if (dot.length > 1) dot[dot.length - 1].asciiLowerCase() else '';
}

/**
 * The Files tab's panel for `file` of release `version`, with `contents`,
 * of the package `handle`, whose DID is `did`: an image shown, Markdown up
 * to `MAX_README_BYTES` rendered as the README is, or numbered by line for
 * its `source`, other text numbered by line, and a link to anything else. `bytes` are the file's when they were
 * read, which they are not for an image or a file larger than
 * `MAX_FILE_SHOWN`.
 */
function fileView(handle: String, did: String, name: String, version: String, contents: ReleaseContents,
    file: ReleaseFile, bytes: FixedArray<u8> | null, source: boolean): HTMLPartial {
  let raw = rawUrl(handle, version, file.path);
  // A link between a Markdown file's rendering and its source, for one that can be rendered.
  var view: TemplateValue = null;
  var body: TemplateValue = html`<p class="muted">This file is too large to show here: <a href="${raw}">download it</a>.</p>`;
  if (IMAGE_TYPES.has(extensionOf(file.path))) {
    body = html`<img class="file-image" src="${raw}" alt="${file.path}">`;
  } else if (bytes != null) {
    let extension = extensionOf(file.path);
    if (!isText(bytes)) {
      body = html`<p class="muted">This file is not text: <a href="${raw}">download it</a>.</p>`;
    } else if ((extension == 'md' || extension == 'markdown') && bytes.length <= MAX_README_BYTES) {
      let page = fileUrl(handle, version, file.path);
      if (source) {
        view = html`<a href="${page}">Rendered</a>`;
        body = sourceLines(String.fromBytes(bytes));
      } else {
        view = html`<a href="${page}?view=source">Source</a>`;
        body = html`<div class="prose markdown-file">${unsafeHTML(markdownFile(did, version, contents, file.path, bytes))}</div>`;
      }
    } else {
      body = sourceLines(String.fromBytes(bytes));
    }
  } else if (file.size <= MAX_FILE_SHOWN as i64) {
    body = html`<p class="muted">The file could not be read: <a href="${raw}">download it</a>.</p>`;
  }
  return html`
    <div class="file-header">
      ${breadcrumb(handle, version, name, file.path)}
      <span class="muted">${formatBytes(file.size)}</span>
      ${view}
      <a href="${raw}">Raw</a>
    </div>
    ${body}
  `;
}

/**
 * The Markdown file at `path`, whose bytes are `bytes`, of release `version`
 * of the package `did`, as HTML in safe mode, with its links resolved from
 * its own directory and naming the package by its DID, as the README's do.
 */
function markdownFile(did: String, version: String, contents: ReleaseContents, path: String, bytes: FixedArray<u8>): String {
  let paths = new HashSet<String>();
  for (let listed in contents.files) {
    paths.add(listed.path);
  }
  let segments = path.split('/');
  let directory = new GrowableArray<String>();
  for (var i = 0; i < segments.length - 1; i += 1) {
    directory.push(segments[i]);
  }
  return renderMarkdown(String.fromBytes(bytes), did, version, paths, join(directory, '/'));
}

/** Whether `bytes` are UTF-8 with no NUL, which a binary file almost always has. */
function isText(bytes: FixedArray<u8>): boolean {
  for (let byte in bytes) {
    if (byte == 0 as u8) {
      return false;
    }
  }
  return isValidUtf8(bytes);
}

/** `text` in a `<pre>`, a span per line, which the stylesheet numbers. */
function sourceLines(text: String): HTMLPartial {
  let lines = text.split('\n');
  // A final newline ends the last line rather than starting another.
  let count = if (lines.length > 0 && lines[lines.length - 1] == '') lines.length - 1 else lines.length;
  let shown = new GrowableArray<String>();
  for (var i = 0; i < count; i += 1) {
    shown.push(lines[i]);
  }
  return html`<pre class="file-source"><code>${each(shown, (line) => html`<span class="line">${line}</span>
`)}</code></pre>`;
}

/**
 * The README of release `version` of the package `handle`, rendered when
 * its contents were derived, or a link to it when it was too large to
 * render. The HTML is the App View's own rendering, in safe mode
 * (`registry/release-contents`).
 */
function readme(handle: String, version: String, contents: ReleaseContents | null): TemplateValue {
  let path = contents?.readmePath;
  if (path == null) {
    return html`<p class="muted">This release has no README.</p>`;
  }
  let rendered = (contents as ReleaseContents).readmeHtml;
  if (rendered == null) {
    return html`<p class="muted">The README is too large to show here:
      <a href="${fileUrl(handle, version, path)}">${path}</a>.</p>`;
  }
  return html`<div class="prose readme">${unsafeHTML(rendered)}</div>`;
}

/** The newest version of `detail` that is not retracted, or null. */
function latestVersion(detail: PackageDetail): String | null {
  for (let release in detail.releases) {
    let version = release.version.toString();
    if (!detail.retractions.has(version)) {
      return version;
    }
  }
  return null;
}

/**
 * Who approved release `version`: its approvers, or a dash when none of
 * the maintainers' repositories holds an attestation of it, or it is too
 * old to have been looked for.
 */
function approvers(version: String, shown: Shown, approvedBy: HashMap<String, Array<String>>): TemplateValue {
  if (let (true, dids) = approvedBy.get(version)) {
    if (dids.length > 0) {
      return html`<ul class="plain">${each(dids, (did) => html`<li>${personLink(shown.context, shown.person(did))}</li>`)}</ul>`;
    }
  }
  return html`<span class="muted">—</span>`;
}

function versions(detail: PackageDetail, handles: HashMap<String, String>, shown: Shown,
    approvedBy: HashMap<String, Array<String>>): HTMLPartial {
  return html`
    <table>
      <thead><tr><th>Version</th><th>Published</th><th>Dependencies</th><th>Approved by</th></tr></thead>
      <tbody>${each(detail.releases, (release) => {
        let version = release.version.toString();
        var retracted = false;
        var reason: String | null = null;
        if (let (true, retraction) = detail.retractions.get(version)) {
          retracted = true;
          reason = retraction.reason;
        }
        return html`
        <tr class="${if (retracted) 'retracted' else ''}">
          <td>
            <a class="version mono" href="/packages/${detail.handle}/versions/${version}">${version}</a>
            ${when(retracted, () => chip('retracted', 'danger'))}
            ${when(reason != null, () => html`<div class="muted">${reason as String}</div>`)}
          </td>
          <td class="muted">${release.createdAt.sliceBytes(0, 10)}</td>
          <td>${dependencies(release, handles)}</td>
          <td>${approvers(version, shown, approvedBy)}</td>
        </tr>`;
      })}
      </tbody>
    </table>
  `;
}

function dependencies(release: Release, handles: HashMap<String, String>): TemplateValue {
  if (release.dependencies.length == 0) {
    return html`<span class="muted">none</span>`;
  }
  return html`<ul class="plain">${each(release.dependencies, (dependency: Dependency) => {
    // A package hosted here is named by its handle and linked; another by its DID.
    var target = html`<span class="mono">${dependency.name}</span> <span class="mono muted">${dependency.did}</span>`;
    if (let (true, handle) = handles.get(dependency.did)) {
      target = html`<a class="mono" href="/packages/${handle}">${dependency.name}</a>
        <span class="mono muted">${handle}</span>`;
    }
    return html`<li>${target} <span class="mono" title="${rangeTitle(dependency)}">${range(dependency)}</span></li>`;
  })}</ul>`;
}

/**
 * The versions a dependency accepts: its version or any later one of the
 * same major version, the one version selection picks from
 * (package-manager.md, "Version selection").
 */
function range(dependency: Dependency): String {
  return `≥ ${dependency.version.toString()} (${dependency.version.major}.x)`;
}

function rangeTitle(dependency: Dependency): String {
  return `${dependency.version.toString()} or any later ${dependency.version.major}.x release`;
}

function maintainerList(record: Maintainers, shown: Shown): HTMLPartial {
  return html`
    <ul class="plain">${each(record.maintainers, (maintainer: Maintainer) => html`
      <li>${describe(maintainer, shown)} ${chip(maintainer.role)}</li>`)}
    </ul>
  `;
}

/** How many maintainers approve a release, and how many owners a change of maintainers. */
function approvalPolicy(record: Maintainers): HTMLPartial {
  return html`
    A release counts once ${count(record.threshold as i32, 'maintainer')}
    ${if (record.threshold == 1 as i64) 'approves' else 'approve'} it, and a change of maintainers once
    ${count(record.ownerThreshold as i32, 'owner')} ${if (record.ownerThreshold == 1 as i64) 'does' else 'do'}.
  `;
}

/** The Files tab of release `version` of the package `handle`: its root directory, and the archive's size. */
function rootList(handle: String, version: String, contents: ReleaseContents): HTMLPartial {
  return html`
    ${directoryList(handle, version, contents, '')}
    <p class="muted file-summary">${count(contents.files.length, 'file')}, ${formatBytes(contents.archiveBytes)} as an archive.</p>
  `;
}

/**
 * What the directory at `path` (`''` for the root) of release `version`
 * holds: its directories first, each with how many files are under it and
 * their size, then its files, each linked to its page.
 */
function directoryList(handle: String, version: String, contents: ReleaseContents, path: String): HTMLPartial {
  let prefix = if (path == '') '' else `${path}/`;
  let directories = new GrowableArray<String>();
  let counts = new HashMap<String, i32>();
  let sizes = new HashMap<String, i64>();
  let files = new GrowableArray<ReleaseFile>();
  for (let file in contents.files) {
    if (!file.path.startsWith(prefix)) {
      continue;
    }
    let rest = file.path.sliceBytes(prefix.length, file.path.length);
    let segments = rest.split('/');
    if (segments.length == 1) {
      files.push(file);
      continue;
    }
    let directory = segments[0];
    if (!counts.has(directory)) {
      directories.push(directory);
    }
    counts[directory] = counts.getOr(directory, 0) + 1;
    sizes[directory] = sizes.getOr(directory, 0 as i64) + file.size;
  }
  return html`
    <table class="file-list">
      <thead><tr><th>Name</th><th>Size</th></tr></thead>
      <tbody>${each(directories, (directory) => html`
        <tr>
          <td class="mono"><a href="${fileUrl(handle, version, `${prefix}${directory}`)}">${directory}/</a>
            <span class="muted small">${count(counts.getOr(directory, 0), 'file')}</span></td>
          <td class="muted">${formatBytes(sizes.getOr(directory, 0 as i64))}</td>
        </tr>`)}${each(files, (file) => html`
        <tr>
          <td class="mono"><a href="${fileUrl(handle, version, file.path)}">${file.path.sliceBytes(prefix.length, file.path.length)}</a></td>
          <td class="muted">${formatBytes(file.size)}</td>
        </tr>`)}
      </tbody>
    </table>
  `;
}

/**
 * Where `path` is in release `version` of the package `handle`, named
 * `name`: the package, which links to the Files tab, then each directory
 * on the way, linked to its page, and the last segment, unlinked.
 */
function breadcrumb(handle: String, version: String, name: String, path: String): HTMLPartial {
  let segments = path.split('/');
  let parents = new GrowableArray<HTMLPartial>();
  for (var i = 0; i < segments.length - 1; i += 1) {
    let directory = new GrowableArray<String>();
    for (var j = 0; j <= i; j += 1) {
      directory.push(segments[j]);
    }
    parents.push(html`<a href="${fileUrl(handle, version, join(directory, '/'))}">${segments[i]}</a><span class="separator">/</span>`);
  }
  return html`<nav class="breadcrumb mono" aria-label="Path"><a href="/packages/${handle}/versions/${version}#files">${name}</a><span class="separator">/</span>${each(parents, (parent) => parent)}<span class="current">${segments[segments.length - 1]}</span></nav>`;
}
