/**
 * A package's README, rendered for its pages with its relative links
 * resolved into the package's files, and the sizes of its files.
 */

import {HashSet} from 'zena:collections';
import {join} from 'zena:core';
import {div} from 'zena:math';
import {TemplateValue, html, unsafeHTML} from 'zena:http';
import {EncodeSet, percentDecode, percentEncode} from 'zena:url';
import {UrlResolver, markdownToHtml} from 'markdown:index';
import {gfmExtensions} from 'markdown:plugins/gfm';
import {ReleaseFiles} from '../../app-view.zena';

/**
 * `text`, a README in Markdown, as HTML, with its URLs resolved by
 * `resolver`. It is rendered with GitHub's extensions and in safe mode
 * (`markdown:html`'s `isSafeUrl`), which leaves out raw HTML and URLs
 * whose scheme could run script: a README is the publisher's, and the
 * page is on the App View's origin.
 */
export function readmeHtml(text: String, resolver: UrlResolver): TemplateValue {
  let rendered = markdownToHtml(text, {safe: true, extensions: gfmExtensions(), resolver: resolver});
  return html`<div class="prose readme">${unsafeHTML(rendered)}</div>`;
}

/** Where the App View serves the file at `path` of release `version` of the package `handle`. */
export function fileUrl(handle: String, version: String, path: String): String {
  let segments = new GrowableArray<String>();
  for (let segment in path.split('/')) {
    segments.push(percentEncode(segment, EncodeSet.Path));
  }
  return `/packages/${handle}/versions/${version}/files/${join(segments, '/')}`;
}

/**
 * Resolves the links and images of a README at the root of release
 * `version` of the package `handle`. A URL with a scheme, or to another
 * host, and a link within the page (`#...`) stay as they are, so images
 * from other sites show. A relative path is resolved from the package's
 * root, as is one that starts with `/`, and points to the file the App
 * View serves from the release's archive (`fileUrl`). One that climbs out
 * of the package's root, or names no file in the archive, is left out.
 */
export final class PackageUrls implements UrlResolver {
  #handle: String;
  #version: String;
  #paths = new HashSet<String>();

  new(handle: String, version: String, files: ReleaseFiles) : #handle = handle, #version = version {
    for (let file in files.files) {
      this.#paths.add(file.path);
    }
  }

  resolve(url: String, isImage: boolean): String | null {
    if (url == '' || url.startsWith('#') || url.startsWith('//') || hasScheme(url)) {
      return url;
    }
    // The path, apart from its query and fragment, which are kept.
    var end = 0;
    while (end < url.length && url.getByteAt(end) != 63 && url.getByteAt(end) != 35) {
      end += 1;
    }
    let suffix = url.sliceBytes(end, url.length);
    let segments = new GrowableArray<String>();
    for (let segment in url.sliceBytes(0, end).split('/')) {
      if (segment == '' || segment == '.') {
        continue;
      }
      if (segment == '..') {
        if (segments.length == 0) {
          return null;
        }
        segments.pop();
        continue;
      }
      segments.push(percentDecode(segment));
    }
    let path = join(segments, '/');
    if (!this.#paths.has(path)) {
      return null;
    }
    return `${fileUrl(this.#handle, this.#version, path)}${suffix}`;
  }
}

/**
 * Whether `url` starts with a scheme: a letter, then letters, digits, `+`,
 * `-` or `.`, then `:`, before any `/`, `?` or `#`.
 */
function hasScheme(url: String): boolean {
  for (var i = 0; i < url.length; i += 1) {
    let byte = url.getByteAt(i);
    if (byte == 58) {
      return i > 0;
    }
    let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122);
    let other = (byte >= 48 && byte <= 57) || byte == 43 || byte == 45 || byte == 46;
    if (!letter && !(i > 0 && other)) {
      return false;
    }
  }
  return false;
}

/** `bytes` for people: bytes below a KiB, then KiB and MiB to a tenth. */
export function formatBytes(bytes: i64): String {
  let kib = 1024 as i64;
  if (bytes < kib) {
    return `${bytes} bytes`;
  }
  if (bytes < kib * kib) {
    return tenths(bytes, kib, 'KiB');
  }
  return tenths(bytes, kib * kib, 'MiB');
}

function tenths(bytes: i64, unit: i64, name: String): String {
  let count = div(bytes * (10 as i64), unit);
  return `${div(count, 10 as i64)}.${count - div(count, 10 as i64) * (10 as i64)} ${name}`;
}
