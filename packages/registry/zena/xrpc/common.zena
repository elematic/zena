/**
 * What the routes of the App View's methods (`dev.zena-lang.registry.*`,
 * `package-manager:registry-methods`) build from. `registryQuery` and
 * `registryProcedure` add a method's route at `/xrpc/<method>` and check that
 * the caller's service-auth token was issued for that same method, so the
 * two cannot disagree; then they answer with what the method returns, or
 * with the error a `AppViewError` names.
 */

import {Future} from 'zena:async';
import {Own} from 'zena:core';
import {Request, Response, Router} from 'zena:http';
import {JsonArray, JsonObject} from 'zena:json';
import {div} from 'zena:math';
import {Value, fromJson} from 'atproto:data';
import {xrpcPath} from 'atproto:methods';
import {Created, AppViewError, AppView} from '../app-view.zena';
import {fail, json, nowMicros} from 'pds:xrpc/common';

/**
 * An App View method's work, for the caller whose DID its token names: the
 * JSON to answer with, or null when it has answered already, as with an
 * error.
 */
export type RegistryMethod = (req: Own<Request>, res: Response, caller: String) => Future<JsonObject | null>;

/** Adds the registry query `method`, a GET, to `router`. */
export function registryQuery(router: Router, appView: AppView, method: String, call: RegistryMethod): void {
  router.get(xrpcPath(method), async (req, res, next, params) => {
    await registryCall(appView, req, res, method, call);
  });
}

/** Adds the registry procedure `method`, a POST, to `router`. */
export function registryProcedure(router: Router, appView: AppView, method: String, call: RegistryMethod): void {
  router.post(xrpcPath(method), async (req, res, next, params) => {
    await registryCall(appView, req, res, method, call);
  });
}

async function registryCall(appView: AppView, req: Own<Request>, res: Response, method: String, call: RegistryMethod)
    : Future<void> {
  var caller = '';
  try {
    caller = await appView.authenticate(req.getHeader('authorization'), method, div(nowMicros(), 1000000 as i64));
  } catch (e) {
    if (e is AppViewError) {
      let error = e;
      // TODO(#875): a zena:fetch client never gets an answer that comes
      // before the server reads its request's body, on a connection it
      // used before, so the body is read first. The request's body limit
      // bounds what that reads; a larger body is refused unread still.
      try {
        await req.bytes();
      } catch (unread) {
        // Too large: refused as it is.
      }
      fail(res, error.status, error.error, error.message);
      return;
    }
    throw e;
  }
  try {
    let answer = await call(req, res, caller);
    if (answer != null) {
      json(res, answer);
    }
  } catch (e) {
    if (e is AppViewError) {
      let error = e;
      fail(res, error.status, error.error, error.message);
      return;
    }
    throw e;
  }
}

/** The answer to a call that wrote a record: its AT-URI and CID. */
export function writtenJson(created: Created): JsonObject {
  let answer = new JsonObject();
  answer['uri'] = created.uri;
  answer['cid'] = created.cid.toString();
  return answer;
}

/** The `entries` a call gives, as values; none when it gives none. */
export function entriesOf(input: JsonObject): Array<Value> {
  let entries = new GrowableArray<Value>();
  let given = input['entries'];
  if (given is JsonArray) {
    let list = given;
    for (var i = 0; i < list.length; i += 1) {
      entries.push(fromJson(list[i]));
    }
  }
  return entries;
}

/** The `swapRecord` a call gives, or null. */
export function swapOf(input: JsonObject): String | null {
  let swap = input['swapRecord'];
  return if (swap is String) swap else null;
}
