/**
 * The App View's routes on the PDS, each area in its own module beside
 * this one: what a client finds the App View by (`identity.zena`), the
 * accounts it makes and lists (`accounts.zena`), releases
 * (`releases.zena`) and who belongs (`members.zena`). `pds/server` adds
 * them with `registryRoutes`. What the site's sign-in calls (`web.zena`) it
 * adds to the site's routes instead.
 */

import {Router} from 'zena:http';
import {AppView} from '../app-view.zena';
import {accountRoutes} from './accounts.zena';
import {identityRoutes} from './identity.zena';
import {memberRoutes} from './members.zena';
import {releaseRoutes} from './releases.zena';

/** Adds the App View's routes on the PDS to `router`. */
export function registryRoutes(router: Router, appView: AppView): void {
  identityRoutes(router, appView);
  accountRoutes(router, appView);
  releaseRoutes(router, appView);
  memberRoutes(router, appView);
}
