{
  "name": "@zena-lang/changes",
  "version": "0.0.1",
  "type": "module",
  "description": "Change files, changelogs and release notes for this repository's packages",
  "private": true,
  "scripts": {
    "test": "wireit"
  },
  "wireit": {
    "test": {
      "#command": "Runs from the repository root, where the compiler finds the package map.",
      "command": "cd ../.. && ./target/release/zena test \"packages/changes/test/*_test.zena\"",
      "dependencies": [
        "../cli:build",
        "../stdlib:lib"
      ],
      "files": [
        "src/**/*.zena",
        "bin/**/*.zena",
        "test/**/*.zena",
        "../semver/src/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../../zena-package.json",
        "zena-package.json",
        "../semver/zena-package.json"
      ],
      "output": []
    }
  }
}
