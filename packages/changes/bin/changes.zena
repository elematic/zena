/**
 * The `changes` command: `npm run changes -- <command>`, from the
 * repository root (docs/design/change-files.md, "Commands").
 *
 * - `status` prints the entries waiting in `.changes/` by unit, and the
 *   version each group and unit would be released at.
 * - `check` reports what is wrong with the configuration and the change
 *   files, and exits 1 when anything is.
 * - `version [<group or unit>...]` makes a release: it writes the new
 *   versions to the manifests, moves the entries into the changelogs,
 *   and takes them out of the change files.
 */

import {ArgParser, OptionType, ParsedArgs} from 'zena:args';
import {Future} from 'zena:async';
import {exit, getArguments} from 'zena:cli';
import {HashMap, HashSet} from 'zena:collections';
import {exists, listDir, mkdir, readFile, unlink, writeFile} from 'zena:fs';
import {join2} from 'zena:path';
import {run} from 'zena:process';
import {formatTimestamp} from 'zena:time';
import {now} from 'wasi:clocks/system-clock';
import {Version} from 'zena-lang:semver';
import {
  ChangeFile,
  Entry,
  Problem,
  checkChangeFile,
  formatProblem,
  parseChangeFile,
} from '../src/change-file.zena';
import {
  CHANGELOG_HEADER,
  NO_CHANGES,
  addRelease,
  dateHeading,
  hasUnreleasedEntries,
  releaseSection,
  versionHeading,
} from '../src/changelog.zena';
import {Config} from '../src/config.zena';
import {
  DependencyLink,
  UPDATED_DEPENDENCIES,
  pathDependencies,
  rangeProblem,
  setDependencyRange,
} from '../src/dependencies.zena';
import {rangeUpdates} from '../src/ranges.zena';
import {readUnitName, readUnitVersion} from '../src/manifests.zena';
import {notableChanges, notesPath, releaseNotes} from '../src/notes.zena';
import {ReleasePlan, formatStatus, planReleases} from '../src/plan.zena';
import {
  releaseVersions,
  selectReleases,
  setCargoManifestVersion,
  setJsonManifestVersion,
  withoutUnits,
} from '../src/release.zena';

let CHANGES_DIR = '.changes';
let CONFIG_PATH = '.changes/config.json';
/** The file in `.changes/` that says what the directory is for. */
let README = 'README.md';

async function readConfig(): Future<Config> {
  if (!await exists(CONFIG_PATH)) {
    throw new Error(
      `${CONFIG_PATH} is missing; run this from the repository root`
    );
  }
  try {
    return Config.parse(await readFile(CONFIG_PATH));
  } catch (e) {
    throw new Error(`${CONFIG_PATH}: ${e.message}`);
  };
}

/** The change files, in the order of their names, with what is wrong with them. */
async function readChangeFiles(config: Config, problems: GrowableArray<Problem>): Future<GrowableArray<ChangeFile>> {
  let names = new GrowableArray<String>();
  for (let entry in await listDir(CHANGES_DIR)) {
    if (entry.name.endsWith('.md') && entry.name != README) {
      names.push(entry.name);
    }
  }
  names.sort((a, b) => a.compareTo(b));
  let files = new GrowableArray<ChangeFile>();
  for (let name in names) {
    let path = `${CHANGES_DIR}/${name}`;
    let file = parseChangeFile(path, await readFile(path), problems);
    checkChangeFile(file, config, problems);
    files.push(file);
  }
  return files;
}

function report(problems: GrowableArray<Problem>) {
  for (let problem in problems) {
    console.error(formatProblem(problem));
  }
}

/** Each unit's version now, by its name, for the units that state one. */
async function readVersions(config: Config): Future<HashMap<String, Version>> {
  let versions = new HashMap<String, Version>();
  for (let {value as unit} in config.units) {
    let version = await readUnitVersion(unit.dir);
    if (version != null) {
      versions[unit.name] = version;
    }
  }
  return versions;
}

/** The units' dependencies on each other that state a range. */
async function readLinks(config: Config): Future<GrowableArray<DependencyLink>> {
  let byDir = new HashMap<String, String>();
  for (let {value as unit} in config.units) {
    byDir[unit.dir] = unit.name;
  }
  let links = new GrowableArray<DependencyLink>();
  for (let {value as unit} in config.units) {
    let manifest = `${unit.dir}/zena-package.json`;
    if (await exists(manifest)) {
      for (let dependency in pathDependencies(await readFile(manifest))) {
        if (let (true, target) = byDir.get(join2(unit.dir, dependency.path))) {
          links.push(
            new DependencyLink(
              unit.name,
              dependency.name,
              target,
              dependency.range
            )
          );
        }
      }
    }
  }
  return links;
}

/** The releases the change files call for. Throws when a change file has a problem. */
async function readReleases(config: Config, files: GrowableArray<ChangeFile>): Future<GrowableArray<ReleasePlan>> {
  return planReleases(
    config,
    files,
    await readVersions(config),
    await readLinks(config)
  );
}

async function status(): Future<i32> {
  let config = await readConfig();
  let problems = new GrowableArray<Problem>();
  let files = await readChangeFiles(config, problems);
  if (problems.length > 0) {
    report(problems);
    return 1;
  }
  console.log(formatStatus(await readReleases(config, files)).trim());
  return 0;
}

async function check(): Future<i32> {
  let config = await readConfig();
  let problems = new GrowableArray<Problem>();
  let files = await readChangeFiles(config, problems);
  for (let {value as unit} in config.units) {
    if (!await exists(unit.dir)) {
      problems.push(
        new Problem(
          CONFIG_PATH,
          1,
          `unit '${unit.name}' has no directory ${unit.dir}`
        )
      );
      continue;
    }
    // The ranges the unit publishes its dependencies in the repository
    // with: each admits the version at its path.
    let manifest = `${unit.dir}/zena-package.json`;
    if (await exists(manifest)) {
      for (let dependency in pathDependencies(await readFile(manifest))) {
        let version = await readUnitVersion(join2(unit.dir, dependency.path));
        if (version == null) {
          problems.push(
            new Problem(
              manifest,
              1,
              `dependency '${dependency.name}': ${dependency.path} states no version`
            )
          );
        } else {
          let problem = rangeProblem(dependency, version);
          if (problem != null) {
            problems.push(new Problem(manifest, 1, problem));
          }
        }
      }
    }
  }
  report(problems);
  if (problems.length > 0) {
    return 1;
  }
  console.log(
    `${files.length} change files, ${config.units.size} units: no problems`
  );
  return 0;
}

/** Today's date in UTC, as `2026-12-01`. */
function today() {
  let instant = now();
  let nanos = instant.seconds * (1000000000 as i64)
    + (instant.nanoseconds as i64);
  return formatTimestamp(nanos).sliceBytes(0, 10);
}

/** Writes `version` to each manifest in `dir` that states a version. */
async function writeManifests(dir: String, version: String): Future<void> {
  for (let name in ['zena-package.json', 'package.json']) {
    let path = `${dir}/${name}`;
    if (await exists(path)) {
      if (let (true, text) = setJsonManifestVersion(
        await readFile(path),
        version
      )) {
        await writeFile(path, text);
      }
    }
  }
  let path = `${dir}/Cargo.toml`;
  if (await exists(path)) {
    if (let (true, text) = setCargoManifestVersion(
      await readFile(path),
      version
    )) {
      await writeFile(path, text);
    }
  }
}

/** The changelog in `dir`, or the start of one when there is none. */
async function readChangelog(dir: String): Future<String> {
  let path = `${dir}/CHANGELOG.md`;
  return if (await exists(path)) await readFile(path) else CHANGELOG_HEADER;
}

/** Adds a release's section to the changelog in `dir`. */
async function writeChangelog(dir: String, heading: String, entries: Array<Entry>, empty: String): Future<void> {
  let changelog = await readChangelog(dir);
  await writeFile(
    `${dir}/CHANGELOG.md`,
    addRelease(changelog, releaseSection(heading, entries, empty))
  );
}

/** The directories of the units a release writes to. */
function releaseDirs(release: ReleasePlan, config: Config) {
  let dirs = new GrowableArray<String>();
  for (let plan in release.units) {
    dirs.push(plan.unit.dir);
  }
  for (let name in release.unchanged) {
    dirs.push(config.units[name].dir);
  }
  return dirs;
}

/**
 * Refuses a release that would leave entries behind under a changelog's
 * `## [Unreleased]`, before anything is written.
 */
async function refuseUnreleasedEntries(releases: Array<ReleasePlan>, config: Config): Future<void> {
  for (let release in releases) {
    for (let dir in releaseDirs(release, config)) {
      if (hasUnreleasedEntries(await readChangelog(dir))) {
        throw new Error(
          `${dir}/CHANGELOG.md has entries under '## [Unreleased]'; move them to a change file in ${CHANGES_DIR}/`
        );
      }
    }
  }
}

/** The repository's Git tags, or none when `git` cannot list them. */
async function readTags(): Future<FixedArray<String>> {
  try {
    let result = await run(['git', 'tag', '--list']);
    if (result.succeeded()) {
      return result.stdout.split('\n');
    };
    console.error(
      `warning: 'git tag --list' failed, so no preview counts as released: ${result.stderr.trim()}`
    );
  } catch (e) {
    console.error(`warning: ${e.message}, so no preview counts as released`);
  };
  return new FixedArray<String>(0, '');
}

/** The name people install each unit's package by, for the units that have one. */
async function readNames(config: Config): Future<HashMap<String, String>> {
  let names = new HashMap<String, String>();
  for (let {value as unit} in config.units) {
    let name = await readUnitName(unit.dir);
    if (name != null) {
      names[unit.name] = name;
    }
  }
  return names;
}

/** What `version` and `notes` both read before choosing versions. */
class Plan {
  config: Config;
  files: GrowableArray<ChangeFile>;
  current: HashMap<String, Version>;
  links: GrowableArray<DependencyLink>;
  releases: GrowableArray<ReleasePlan>;
  /** The version of each release that has one, by the release's name. */
  chosen: HashMap<String, Version>;
  preview: boolean;
  date: String;

  new(this.config, this.files, this.current, this.links, this.releases, this.chosen, this.preview, this.date) {}
}

/**
 * The releases the arguments ask for and the version of each, or null
 * when a change file has a problem, which is reported.
 */
async function readPlan(args: ParsedArgs): Future<Plan?> {
  let config = await readConfig();
  let problems = new GrowableArray<Problem>();
  let files = await readChangeFiles(config, problems);
  if (problems.length > 0) {
    report(problems);
    return null;
  }
  let current = await readVersions(config);
  let links = await readLinks(config);
  let releases = selectReleases(
    planReleases(config, files, current, links),
    args.rest
  );
  let preview = args.getFlag('preview');
  var named: Version? = null;
  if (let (true, text) = args.getOption('as')) {
    if (releases.length != 1 || !releases[0].versioned) {
      throw new Error(
        '--as needs the name of one group or unit that has a version'
      );
    }
    named = Version.parse(text);
  }
  let tags = if (preview
    && named == null) await readTags() else new FixedArray<String>(0, '');
  let chosen = releaseVersions(config, releases, preview, named, tags);
  return new Plan(
    config,
    files,
    current,
    links,
    releases,
    chosen,
    preview,
    args.getOption('date') ?? today()
  );
}

/**
 * Writes the notes of each of `releases` that is a group's with release
 * notes, and says where. Each lists every release in `releases`.
 */
async function writeNotes(plan: Plan, releases: GrowableArray<ReleasePlan>): Future<boolean> {
  let versions = new HashMap<String, String>();
  for (let {key, value} in plan.chosen) {
    versions[key] = value.toString();
  }
  let names = await readNames(plan.config);
  var wrote = false;
  for (let release in releases) {
    if (!release.isGroup) {
      continue;
    }
    let group = plan.config.groups[release.name];
    let dir = group.notesDir;
    if (dir == null) {
      continue;
    }
    if (let (true, version) = versions.get(release.name)) {
      if (!await exists(dir)) {
        await mkdir(dir);
      }
      let path = notesPath(dir, version);
      await writeFile(
        path,
        releaseNotes(
          group.notesTitle,
          version,
          plan.date,
          notableChanges(plan.files),
          releases,
          versions,
          names
        )
      );
      console.log(`release notes: ${path}`);
      wrote = true;
    }
  }
  return wrote;
}

/**
 * `notes [<group or unit>...]`: writes the release notes `version` would
 * write with the same arguments, and nothing else.
 */
async function notes(args: ParsedArgs): Future<i32> {
  let plan = await readPlan(args);
  if (plan == null) {
    return 1;
  }
  let made = new GrowableArray<ReleasePlan>();
  for (let release in plan.releases) {
    if (plan.chosen.has(release.name) || !release.versioned && !plan.preview) {
      made.push(release);
    }
  }
  if (!await writeNotes(plan, made)) {
    console.log('No group that has release notes has entries to release.');
  }
  return 0;
}

async function version(args: ParsedArgs): Future<i32> {
  let plan = await readPlan(args);
  if (plan == null) {
    return 1;
  }
  let config = plan.config;
  let files = plan.files;
  let preview = plan.preview;
  let date = plan.date;
  if (!preview) {
    await refuseUnreleasedEntries(plan.releases, config);
  }

  let none = new GrowableArray<Entry>();
  let released = new HashSet<String>();
  let made = new GrowableArray<ReleasePlan>();
  /** The new version of each unit a release writes a version to. */
  let written = new HashMap<String, Version>();
  for (let release in plan.releases) {
    var heading = dateHeading(date);
    var target: String? = null;
    var version: Version? = null;
    if (release.versioned) {
      if (let (true, chosen) = plan.chosen.get(release.name)) {
        version = chosen;
        target = chosen.toString();
        heading = versionHeading(chosen.toString(), date);
      } else {
        console.log(
          `${release.name}: not released, since only held units have entries`
        );
        continue;
      }
    } else if (preview) {
      continue;
    }
    for (let plan in release.units) {
      if (target != null && version != null) {
        await writeManifests(plan.unit.dir, target);
        written[plan.unit.name] = version;
      }
      if (!preview) {
        // A unit with no entries is released for its dependencies.
        await writeChangelog(
          plan.unit.dir,
          heading,
          plan.entries,
          UPDATED_DEPENDENCIES
        );
        released.add(plan.unit.name);
      }
    }
    for (let name in release.unchanged) {
      let dir = config.units[name].dir;
      if (target != null && version != null) {
        await writeManifests(dir, target);
        written[name] = version;
      }
      if (!preview) {
        await writeChangelog(dir, heading, none, NO_CHANGES);
      }
    }
    console.log(`${release.name} ${target ?? date}`);
    made.push(release);
  }
  if (made.length == 0) {
    console.log('Nothing to release.');
    return 0;
  }
  // The ranges the releases change, in the released units and in the
  // units that depend on them.
  for (let update in rangeUpdates(
    config,
    plan.links,
    made,
    written,
    plan.current,
    preview
  )) {
    let path = `${config.units[update.unit].dir}/zena-package.json`;
    if (let (true, text) = setDependencyRange(
      await readFile(path),
      update.name,
      update.range
    )) {
      await writeFile(path, text);
    } else {
      throw new Error(
        `${path}: could not set the range of '${update.name}' to ${update.range}; write its entry over several lines`
      );
    }
    console.log(`${update.unit}: ${update.name} ${update.range}`);
    if (!written.has(update.unit) && !preview) {
      console.log(
        `  ${update.unit} is not released here: release it for the range to be published`
      );
    }
  }
  // A release with notes takes the change files' prose with it.
  let wroteNotes = await writeNotes(plan, made);
  if (!preview) {
    for (let file in files) {
      if (let (true, text) = withoutUnits(file, released, !wroteNotes)) {
        await writeFile(file.path, text);
      } else {
        await unlink(file.path);
      }
    }
  }
  console.log(
    '\nNow run \'npm run versions\', \'npm install --package-lock-only\' and \'cargo update -w --offline\','
      + ' which this command does not do yet.'
  );
  return 0;
}

export async function main(): Future<void> {
  let parser = new ArgParser(
    {
      name: 'changes',
      help: 'Change files, changelogs and release notes (docs/design/change-files.md).',
      commands: {
        'status' => {
          help: 'Print the pending entries and the versions they would give'
        },
        'check' => {
          help: 'Report what is wrong with the configuration and the change files'
        },
        'version' => {
          help: 'Make a release of the named groups and units, or of everything with entries',
          options: {
            'preview' => {
              type: OptionType.Flag,
              help: 'Write <next version>-preview.N to the manifests and leave the entries where they are'
            },
            'as' => {
              help: 'The exact version to release, in place of the one the entries give'
            },
            'date' => {
              help: 'The release\'s date, as 2026-12-01 (default: today, UTC)'
            }
          }
        },
        'notes' => {
          help: 'Write the release notes that version would write with the same arguments, and nothing else',
          options: {
            'preview' => {
              type: OptionType.Flag,
              help: 'The notes of the next preview release'
            },
            'as' => {
              help: 'The exact version the notes are for, in place of the one the entries give'
            },
            'date' => {
              help: 'The release\'s date, as 2026-12-01 (default: today, UTC)'
            }
          }
        }
      }
    }
  );
  var code = 2;
  try {
    let parsed = parser.parse(getArguments(), 1);
    let command = parsed.commandName;
    let args = parsed.commandArgs;
    if (command == 'status') {
      code = await status();
    } else if (command == 'check') {
      code = await check();
    } else if (command == 'version' && args != null) {
      code = await version(args);
    } else if (command == 'notes' && args != null) {
      code = await notes(args);
    } else {
      console.error(parser.formatHelp());
    };
  } catch (e) {
    console.error(`Error: ${e.message}`);
    code = 1;
  };
  if (code != 0) {
    exit(code);
  }
}
