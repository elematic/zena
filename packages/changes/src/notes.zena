/**
 * Release notes: one document for each release of a group, with prose
 * about the notable changes above the entries of every unit
 * (docs/design/change-files.md, "Release notes").
 *
 * ```md
 * # Zena 0.0.3
 *
 * 2026-12-01
 *
 * ## Notable changes
 *
 * ### Prompts in the terminal
 *
 * A program can now ask a question and read the answer key by key.
 *
 * ## Packages
 *
 * ### cli 0.0.3
 *
 * #### Added
 *
 * - Raw mode.
 *
 * ### zena-lang:terminal 0.0.2
 *
 * #### Added
 *
 * - Prompts.
 * ```
 *
 * The prose is each change file's `## Release notes`, in the order of the
 * files. A person edits the document in the release's pull request.
 */

import {StringBuilder} from 'zena:core';
import {HashMap} from 'zena:collections';
import {join} from 'zena:string';
import {ChangeFile, Entry, SECTIONS, sectionName} from './change-file.zena';
import {UPDATED_DEPENDENCIES} from './dependencies.zena';
import {ReleasePlan} from './plan.zena';

/** The path of a release's notes: `docs/releases/0.0.3.md`. */
export function notesPath(dir: String, version: String): String {
  return `${dir}/${version}.md`;
}

/** The release notes' prose: every change file's, in the order given. */
export function notableChanges(files: Array<ChangeFile>): String {
  let parts = new GrowableArray<String>();
  for (let file in files) {
    if (!file.releaseNotes.isEmpty) {
      parts.push(file.releaseNotes);
    }
  }
  return join(parts, '\n\n');
}

/** A unit's entries under `####` headings, in a changelog's order. */
function appendEntries(out: StringBuilder, entries: Array<Entry>) {
  for (let section in SECTIONS) {
    let texts = new GrowableArray<String>();
    for (let entry in entries) {
      if (entry.section == section) {
        texts.push(entry.text);
      }
    }
    if (texts.length > 0) {
      out.append(`\n#### ${sectionName(section)}\n\n${join(texts, '\n')}\n`);
    }
  }
}

/**
 * The notes of a group's release, as `version` on `date`.
 *
 * `title` is what the document calls the release (`Zena`) and `notable`
 * the prose (`notableChanges`). `releases` are the group's release and
 * the others made with it, in the order to list them. Every package
 * released with entries is listed under one heading, by the name in
 * `names` for its unit, which is the name people install it by
 * (`zena-lang:semver`), or else its unit's name, and with the version in
 * `versions` for its release's name, or with none when it has none
 * there. A group's units with no entries of their own are left out, and
 * so are parts with nothing in them.
 */
export function releaseNotes(title: String, version: String, date: String, notable: String, releases: Array<ReleasePlan>, versions: HashMap<String, String>, names: HashMap<String, String>): String {
  let out = new StringBuilder();
  out.append(`# ${title} ${version}\n\n${date}\n`);
  if (!notable.isEmpty) {
    out.append(`\n## Notable changes\n\n${notable}\n`);
  }
  var first = true;
  for (let release in releases) {
    for (let unit in release.units) {
      if (first) {
        out.append('\n## Packages\n');
        first = false;
      }
      let name = names.get(unit.unit.name) ?? unit.unit.name;
      if (let (true, released) = versions.get(release.name)) {
        out.append(`\n### ${name} ${released}\n`);
      } else {
        out.append(`\n### ${name}\n`);
      }
      if (unit.entries.length == 0) {
        out.append(`\n${UPDATED_DEPENDENCIES}\n`);
      }
      appendEntries(out, unit.entries);
    }
  }
  return out.toString();
}
