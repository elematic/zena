{
  "name": "@zena-lang/playground",
  "version": "0.0.1",
  "description": "An embeddable Zena playground: a <zena-playground> element that checks, compiles, and runs Zena in the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elematic/zena.git",
    "directory": "packages/playground"
  },
  "keywords": [
    "zena",
    "playground",
    "web-component",
    "codemirror",
    "webassembly"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker": {
      "types": "./lib/worker/compiler-worker.d.ts",
      "default": "./lib/worker/compiler-worker.js"
    },
    "./lib/*": "./lib/*"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "wireit",
    "build:stdlib": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc",
      "dependencies": [
        "build:stdlib",
        "../codemirror:build",
        "../language-service:build"
      ],
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tsconfig.json"
      ],
      "output": [
        "lib",
        "tsconfig.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "build:stdlib": {
      "command": "node --experimental-strip-types src/scripts/build-stdlib-map.ts",
      "dependencies": [
        "../stdlib:build"
      ],
      "files": [
        "src/scripts/build-stdlib-map.ts",
        "../stdlib/zena/**/*.zena"
      ],
      "output": [
        "src/stdlib-data.json"
      ]
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.3",
    "@radica/ui": "^0.0.4",
    "@zena-lang/codemirror": "^0.0.1",
    "@zena-lang/language-service": "^0.0.1",
    "@zena-lang/runtime": "^0.0.1",
    "codemirror-elements": "^0.0.11",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3",
    "wireit": "^0.14.12"
  }
}
