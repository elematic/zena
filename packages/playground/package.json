{
  "name": "@zena-lang/playground",
  "version": "0.0.2-preview.1",
  "description": "An embeddable Zena playground: a <zena-playground> element that checks, compiles, and runs Zena in the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elematic/zena.git",
    "directory": "packages/playground"
  },
  "homepage": "https://zena-lang.dev",
  "bugs": {
    "url": "https://github.com/elematic/zena/issues"
  },
  "keywords": [
    "zena",
    "playground",
    "web-component",
    "codemirror",
    "webassembly"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker": {
      "types": "./lib/worker/compiler-worker.d.ts",
      "default": "./lib/worker/compiler-worker.js"
    },
    "./service-worker": {
      "types": "./lib/service-worker/service-worker.d.ts",
      "default": "./lib/service-worker/service-worker.js"
    },
    "./service-worker-proxy": {
      "types": "./lib/service-worker/service-worker-proxy.d.ts",
      "default": "./lib/service-worker/service-worker-proxy.js"
    },
    "./lib/*": "./lib/*"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "wireit",
    "build:stdlib": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc",
      "dependencies": [
        "build:stdlib",
        "../codemirror:build",
        "../compiler:build:ts",
        {
          "script": "../compiler:build:wasm",
          "cascade": false
        }
      ],
      "files": [
        "src/**/*.ts",
        "src/stdlib-data.json",
        "tsconfig.json"
      ],
      "output": [
        "lib",
        "tsconfig.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "build:stdlib": {
      "command": "node scripts/build-stdlib.js",
      "dependencies": [
        "../compiler:build:stdlib"
      ],
      "files": [
        "scripts/build-stdlib.js",
        "../compiler/stdlib/**/*.zena"
      ],
      "output": [
        "src/stdlib-data.json"
      ]
    },
    "test": {
      "command": "node --test test/*_test.ts",
      "dependencies": [
        "build"
      ],
      "files": [
        "test/**/*.ts",
        "../compiler/compiler.wasm"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.3",
    "@radica/ui": "^0.0.4",
    "@zena-lang/codemirror": "^0.0.2-preview.1",
    "@zena-lang/compiler": "^0.0.2-preview.1",
    "@zena-lang/runtime": "^0.0.2-preview.1",
    "codemirror-elements": "^0.0.11",
    "es-module-lexer": "^3.0.5",
    "lit": "^3.3.0",
    "supertalk": "^0.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "wireit": "^0.15.0"
  }
}
