{
  "locks": ["zena-lock.json", "package-lock.json"],
  "scripts": {
    "build": {
      "command": "tsc",
      "files": ["src/**/*.ts", "src/stdlib-data.json", "tsconfig.json"],
      "output": ["lib", "tsconfig.tsbuildinfo"],
      "clean": "if-file-deleted",
      "dependencies": [
        "build:stdlib",
        "../codemirror:build",
        "../compiler:build:ts",
        {
          "script": "../compiler:build:wasm",
          "cascade": false
        }
      ]
    },
    "build:stdlib": {
      "command": "node scripts/build-stdlib.js",
      "files": ["scripts/build-stdlib.js", "../compiler/stdlib/**/*.zena"],
      "output": ["src/stdlib-data.json"],
      "dependencies": ["../compiler:build:stdlib"]
    },
    "test": {
      "command": "node --test test/*_test.ts",
      "files": ["test/**/*.ts", "../compiler/compiler.wasm"],
      "dependencies": ["build"]
    }
  }
}
