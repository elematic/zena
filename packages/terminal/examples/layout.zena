/**
 * Prints a command's output on the rail: a title, a step of each kind,
 * a block of another program's output, a note, and a summary.
 *
 * ```sh
 * ./target/release/zena run packages/terminal/examples/layout.zena
 * ```
 */

import {RailLayout, StepKind} from 'terminal/layout';

export function main(): void {
  let rail = new RailLayout();
  console.log(rail.intro('zena pkg add'));
  console.log(rail.bar());
  console.log(rail.step(StepKind.Success, 'Resolved zena-lang:wit-parser', '0.0.1-preview.1'));
  console.log(rail.bar());
  console.log(rail.step(StepKind.Warning, 'zena-lang:markdown has no stable release:',
    'using 0.0.1-preview.1'));
  console.log(rail.bar());
  console.log(rail.step(StepKind.Success, 'Fetched 2 packages', 'in 120ms'));
  for (let line in rail.logBlock('zena-lang:wit-parser 0.0.1-preview.1\nzena-lang:markdown 0.0.1-preview.1')) {
    console.log(line);
  }
  console.log(rail.bar());
  console.log(rail.note('import {parse} from \'zena-lang:wit-parser\';', 'Next'));
  console.log(rail.bar());
  console.log(rail.outro('Added 2 packages'));
}
