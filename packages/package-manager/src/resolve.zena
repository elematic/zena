/**
 * Minimal version selection: for each package and major version, the
 * highest of the minimum versions a workspace's packages and their
 * dependencies require. A requirement is a range
 * (docs/design/package-manager.md, "Version ranges"), and until selection
 * reads ranges (#1087) its minimum is the version it requires.
 *
 * Resolution starts from the requirements in all of a workspace's
 * manifests, so that the workspace uses one version of each package and
 * major version. It reads the release record of every version any of them
 * names, following each release's own dependencies, as Go's modules do. A
 * version that a
 * higher minimum later overrides still contributes its dependencies'
 * minimums. The result is a `Resolution`: for each selected package, its
 * version, release and source CIDs and its own names for its dependencies.
 */

import {HashMap, HashSet, OrderedHashMap} from 'zena:collections';
import {Cid} from 'atproto/cid';
import {Release, SOURCE} from './records.zena';
import {Resolution, ResolutionError, ResolvedPackage, packageKey} from './resolution.zena';
import {Range, Version} from 'zena-lang:semver';

/** A published package a package depends on, and the versions it accepts. */
export final class Requirement {
  did: String;
  range: Range;
  /** The lowest version in the range, which minimal version selection requires. */
  minimum: Version;

  new(did: String, range: Range) : did = did, range = range, minimum = minimumOf(range, did);
}

/** The lowest version in `range`; throws `ResolutionError` when it has none. */
function minimumOf(range: Range, did: String): Version {
  let minimum = range.minimum();
  if (minimum == null) {
    throw new ResolutionError(`${did}: no version is in '${range.text}'`);
  }
  return minimum;
}

/** The selection's slot for `version` of `did`: one per package and major version. */
function slotOf(did: String, version: Version) {
  return `${did}@${version.major}`;
}

/** A release record, and its CID, fetched with its proof. */
export final class CheckedRelease {
  release: Release;
  cid: Cid;

  new(release: Release, cid: Cid) : release = release, cid = cid;
}

/**
 * Where resolution reads release records: `did`'s release `version`,
 * checked against the account's key. Throws when there is no such release.
 */
export type ReleaseSource = (did: String, version: Version) => Future<CheckedRelease>;

/**
 * Selects a version of every package `requirements` lead to, reading
 * release records from `source`. Throws `ResolutionError` for a selected
 * release with no source artifact, and whatever `source` throws.
 */
export async function resolve(requirements: Array<Requirement>,
    source: ReleaseSource): Future<Resolution> {
  let cache = new HashMap<String, CheckedRelease>();
  let read = async (did: String, version: Version): Future<CheckedRelease> => {
    let id = `${did} ${version.toString()}`;
    if (let (true, checked) = cache.get(id)) {
      return checked;
    }
    let checked = await source(did, version);
    cache[id] = checked;
    return checked;
  };

  let selected = new HashMap<String, Requirement>();
  let visited = new HashSet<String>();
  let queue = new GrowableArray<Requirement>();
  for (let requirement in requirements) {
    queue.push(requirement);
  }
  var next = 0;
  while (next < queue.length) {
    let requirement = queue[next];
    next += 1;
    let slot = slotOf(requirement.did, requirement.minimum);
    let id = `${slot} ${requirement.minimum.toString()}`;
    if (visited.has(id)) {
      continue;
    }
    visited.add(id);
    if (let (true, current) = selected.get(slot)) {
      if (requirement.minimum.compareTo(current.minimum) > 0) {
        selected[slot] = requirement;
      }
    } else {
      selected[slot] = requirement;
    }
    let checked = await read(requirement.did, requirement.minimum);
    for (let dependency in checked.release.dependencies) {
      queue.push(new Requirement(dependency.did, dependency.range));
    }
  }

  // The key each slot's selected version is pinned under.
  let keys = new HashMap<String, String>();
  for (let slot in selected.keys()) {
    let requirement = selected[slot];
    keys[slot] = packageKey(requirement.did, requirement.minimum);
  }
  let packages = new OrderedHashMap<String, ResolvedPackage>();
  for (let slot in sortedKeys(selected)) {
    let requirement = selected[slot];
    let key = keys[slot];
    let checked = await read(requirement.did, requirement.minimum);
    let artifact = checked.release.artifact(SOURCE);
    if (artifact == null) {
      throw new ResolutionError(`${key}: release ${requirement.minimum.toString()} has no source artifact`);
    }
    let dependencies = new OrderedHashMap<String, String>();
    for (let dependency in checked.release.dependencies) {
      let minimum = minimumOf(dependency.range, dependency.did);
      dependencies[dependency.name] = keys[slotOf(dependency.did, minimum)];
    }
    packages[key] = new ResolvedPackage(key, requirement.did, requirement.minimum, checked.cid,
        artifact.cid, dependencies);
  }
  return new Resolution(packages);
}

// TODO(#450): use the standard library's sort once it has one.
function sortedKeys(map: HashMap<String, Requirement>): FixedArray<String> {
  let keys = new FixedArray<String>(map.size, '');
  var n = 0;
  for (let key in map.keys()) {
    var j = n;
    while (j > 0 && keys[j - 1].compareTo(key) > 0) {
      keys[j] = keys[j - 1];
      j -= 1;
    }
    keys[j] = key;
    n += 1;
  }
  return keys;
}
