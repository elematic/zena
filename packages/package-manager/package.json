{
  "name": "@zena-lang/package-manager",
  "version": "0.0.1",
  "type": "module",
  "description": "The Zena package manager's records, versions and source archives",
  "private": true,
  "scripts": {
    "test": "wireit"
  },
  "wireit": {
    "test": {
      "#command": "Runs from the repository root, which is what the lexicon paths inside the tests are relative to and where the compiler finds the package map.",
      "command": "cd ../.. && ./target/release/zena-cli test \"packages/package-manager/test/*_test.zena\"",
      "dependencies": [
        "../zena-cli:build",
        "../stdlib:lib"
      ],
      "files": [
        "src/**/*.zena",
        "test/**/*.zena",
        "lexicons/**/*.json",
        "../atproto/src/**/*.zena",
        "../semver/src/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../../zena-package.json",
        "zena-package.json",
        "../atproto/zena-package.json",
        "../semver/zena-package.json"
      ],
      "output": []
    }
  }
}
