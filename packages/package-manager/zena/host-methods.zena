/**
 * The NSIDs of the package host's XRPC methods, whose lexicons are in
 * `packages/package-manager/lexicons/dev/zena-lang/host`. The host serves
 * them (`pds:xrpc/host`), and `zena` calls them, so both spell each name
 * the same way. `test/lexicons_test.zena` checks that every one has a
 * lexicon, and every host lexicon a constant here.
 */

export let COMPLETE_CHANGE = 'dev.zena-lang.host.completeChange';
export let COMPLETE_RELEASE = 'dev.zena-lang.host.completeRelease';
export let CREATE_AUTOMATION_ACCOUNT = 'dev.zena-lang.host.createAutomationAccount';
export let CREATE_ORGANIZATION = 'dev.zena-lang.host.createOrganization';
export let CREATE_PACKAGE = 'dev.zena-lang.host.createPackage';
export let CREATE_WEB_SESSION = 'dev.zena-lang.host.createWebSession';
export let DELETE_TEAM = 'dev.zena-lang.host.deleteTeam';
export let GET_ENTRIES = 'dev.zena-lang.host.getEntries';
export let GET_MEMBERSHIPS = 'dev.zena-lang.host.getMemberships';
export let GET_PENDING_CHANGES = 'dev.zena-lang.host.getPendingChanges';
export let GET_PENDING_RELEASES = 'dev.zena-lang.host.getPendingReleases';
export let LIST_PACKAGES = 'dev.zena-lang.host.listPackages';
export let LIST_SCOPES = 'dev.zena-lang.host.listScopes';
export let PUBLISH = 'dev.zena-lang.host.publish';
export let PUT_MAINTAINERS = 'dev.zena-lang.host.putMaintainers';
export let PUT_MEMBERS = 'dev.zena-lang.host.putMembers';
export let PUT_POLICY = 'dev.zena-lang.host.putPolicy';
export let PUT_PROFILE = 'dev.zena-lang.host.putProfile';
export let PUT_TEAM = 'dev.zena-lang.host.putTeam';
export let RENAME_PACKAGE = 'dev.zena-lang.host.renamePackage';
export let RETRACT = 'dev.zena-lang.host.retract';
export let UPLOAD_ARTIFACT = 'dev.zena-lang.host.uploadArtifact';
export let WITHDRAW_CHANGE = 'dev.zena-lang.host.withdrawChange';
export let WITHDRAW_RELEASE = 'dev.zena-lang.host.withdrawRelease';

/** Every method above. */
export let HOST_METHODS: Array<String> = [
  COMPLETE_CHANGE, COMPLETE_RELEASE, CREATE_AUTOMATION_ACCOUNT, CREATE_ORGANIZATION, CREATE_PACKAGE,
  CREATE_WEB_SESSION, DELETE_TEAM, GET_ENTRIES, GET_MEMBERSHIPS, GET_PENDING_CHANGES, GET_PENDING_RELEASES,
  LIST_PACKAGES, LIST_SCOPES, PUBLISH, PUT_MAINTAINERS, PUT_MEMBERS, PUT_POLICY, PUT_PROFILE, PUT_TEAM, RENAME_PACKAGE, RETRACT,
  UPLOAD_ARTIFACT, WITHDRAW_CHANGE, WITHDRAW_RELEASE
];
