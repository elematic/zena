/**
 * Package versions: semantic versions (https://semver.org) without build
 * metadata, since a release's version is its record key and a record key
 * cannot contain `+`.
 *
 * `compareTo` orders versions by semver precedence. The package manager
 * selects each major version of a package separately
 * (docs/design/package-manager.md, "Version selection"), so a resolution
 * file names a package by its DID and major version.
 */

/** Text that is not a package version. */
export class VersionError extends Error {
  new(message: String) : super(message);
}

/** 2^53 - 1, so that every version number reads the same in JSON. */
let MAX_NUMBER: i64 = 0x1fffffffffffff;

/** A semantic version without build metadata. */
export final class Version {
  major: i64;
  minor: i64;
  patch: i64;
  /**
   * The pre-release identifiers: `['rc', '1']` for `2.0.0-rc.1`, and none
   * for a release.
   */
  prerelease: FixedArray<String>;

  new(major: i64, minor: i64, patch: i64, prerelease: FixedArray<String>)
      : major = major, minor = minor, patch = patch, prerelease = prerelease;

  /**
   * Reads a version such as `1.4.2` or `2.0.0-rc.1`. Throws `VersionError`
   * for anything else, a version with build metadata (`+...`) included.
   */
  static parse(text: String): Version {
    var coreEnd = text.length;
    for (var i = 0; i < text.length; i += 1) {
      let b = text.getByteAt(i);
      if (b == 43) { // '+'
        throw new VersionError(`'${text}' has build metadata, which a package version cannot have`);
      }
      if (b == 45 && coreEnd == text.length) { // the first '-'
        coreEnd = i;
      }
    }
    let core = text.sliceBytes(0, coreEnd).split('.');
    if (core.length != 3) {
      throw new VersionError(`'${text}' is not a version: expected major.minor.patch`);
    }
    var prerelease = new FixedArray<String>(0, '');
    if (coreEnd < text.length) {
      prerelease = text.sliceBytes(coreEnd + 1, text.length).split('.');
      for (let identifier in prerelease) {
        checkIdentifier(identifier, text);
      }
    }
    return new Version(parseNumber(core[0], text), parseNumber(core[1], text),
        parseNumber(core[2], text), prerelease);
  }

  /** Whether this is a pre-release, such as `2.0.0-rc.1`. */
  isPrerelease: boolean {
    get {
      return this.prerelease.length > 0;
    }
  }

  /**
   * Negative when this version has lower precedence than `other`, zero
   * when they are equal, and positive when it has higher precedence.
   */
  compareTo(other: Version): i32 {
    if (this.major != other.major) {
      return if (this.major < other.major) -1 else 1;
    }
    if (this.minor != other.minor) {
      return if (this.minor < other.minor) -1 else 1;
    }
    if (this.patch != other.patch) {
      return if (this.patch < other.patch) -1 else 1;
    }
    let a = this.prerelease;
    let b = other.prerelease;
    // A release has higher precedence than its pre-releases.
    if (a.length == 0 || b.length == 0) {
      return b.length - a.length;
    }
    let n = if (a.length < b.length) a.length else b.length;
    for (var i = 0; i < n; i += 1) {
      let order = compareIdentifiers(a[i], b[i]);
      if (order != 0) {
        return order;
      }
    }
    return a.length - b.length;
  }

  toString(): String {
    var text = `${this.major}.${this.minor}.${this.patch}`;
    for (var i = 0; i < this.prerelease.length; i += 1) {
      text = `${text}${if (i == 0) '-' else '.'}${this.prerelease[i]}`;
    }
    return text;
  }
}

/** Reads a major, minor or patch number of `text`. */
function parseNumber(part: String, text: String): i64 {
  if (!isNumeric(part) || (part.length > 1 && part.getByteAt(0) == 48)) {
    throw new VersionError(`'${text}' is not a version: '${part}' is not a number without leading zeros`);
  }
  if (part.length > 16) {
    throw new VersionError(`'${text}' is not a version: '${part}' is too large`);
  }
  var n: i64 = 0;
  for (var i = 0; i < part.length; i += 1) {
    n = n * 10 + (part.getByteAt(i) - 48);
  }
  if (n > MAX_NUMBER) {
    throw new VersionError(`'${text}' is not a version: '${part}' is too large`);
  }
  return n;
}

/** Checks a pre-release identifier of `text`. */
function checkIdentifier(identifier: String, text: String): void {
  if (identifier.length == 0) {
    throw new VersionError(`'${text}' is not a version: a pre-release identifier is empty`);
  }
  for (var i = 0; i < identifier.length; i += 1) {
    let b = identifier.getByteAt(i);
    let alphanumeric = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
    if (!alphanumeric && b != 45) {
      throw new VersionError(`'${text}' is not a version: '${identifier}' has a character other than letters, digits and '-'`);
    }
  }
  if (isNumeric(identifier) && identifier.length > 1 && identifier.getByteAt(0) == 48) {
    throw new VersionError(`'${text}' is not a version: '${identifier}' has a leading zero`);
  }
}

/** Whether `text` is one or more ASCII digits. */
function isNumeric(text: String): boolean {
  if (text.length == 0) {
    return false;
  }
  for (var i = 0; i < text.length; i += 1) {
    let b = text.getByteAt(i);
    if (b < 48 || b > 57) {
      return false;
    }
  }
  return true;
}

/**
 * Semver precedence between two pre-release identifiers: numeric ones
 * compare as numbers and come before alphanumeric ones, which compare
 * byte by byte.
 */
function compareIdentifiers(a: String, b: String): i32 {
  let aNumeric = isNumeric(a);
  let bNumeric = isNumeric(b);
  if (aNumeric != bNumeric) {
    return if (aNumeric) -1 else 1;
  }
  // Numeric identifiers have no leading zeros, so the longer is larger.
  if (aNumeric && a.length != b.length) {
    return a.length - b.length;
  }
  let n = if (a.length < b.length) a.length else b.length;
  for (var i = 0; i < n; i += 1) {
    let diff = a.getByteAt(i) - b.getByteAt(i);
    if (diff != 0) {
      return diff;
    }
  }
  return a.length - b.length;
}
