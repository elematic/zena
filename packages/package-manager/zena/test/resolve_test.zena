import {suite, test} from 'zena:test';
import {equal, isTrue} from 'zena:assert';
import {Future, runFuture} from 'zena:async';
import {HashMap} from 'zena:collections';
import {growable} from 'zena:core';
import {encodeCbor} from 'atproto:cbor';
import {Cid} from 'atproto:cid';
import {BlobRef} from 'atproto:data';
import {Artifact, COMPONENT, Dependency, Release, SOURCE} from 'package-manager:records';
import {CheckedRelease, ReleaseSource, Requirement, resolve} from 'package-manager:resolve';
import {Resolution, ResolutionError} from 'package-manager:resolution';
import {Version} from 'package-manager:version';

let ROUTER = 'did:plc:routerrouterrouterrouter';
let JSON = 'did:web:json.example.com';
let LOG = 'did:plc:loglogloglogloglogloglogl';

function bytesOf(text: String) {
  let out = new FixedArray<u8>(text.length, 0 as u8);
  for (var i = 0; i < text.length; i += 1) {
    out[i] = text.getByteAt(i) as u8;
  }
  return out;
}

/** Releases by `<did> <version>`, and how often each was read. */
final class Registry {
  releases = new HashMap<String, Release>();
  reads = new HashMap<String, i32>();

  /** Adds `did`'s release `version`, depending on `dependencies`. */
  add(did: String, version: String, dependencies: Array<Dependency> = new GrowableArray<Dependency>(),
      kind: String = SOURCE): void {
    let artifact = Artifact.whole(kind, new BlobRef(Cid.forBlob(bytesOf(`${did} ${version}`)),
        'application/vnd.ipld.car', 1 as i64), if (kind == COMPONENT) 'wasi:cli/command' else null,
        if (kind == COMPONENT) new BlobRef(Cid.forBlob(bytesOf('wit')), 'text/plain', 3 as i64) else null);
    let list = new FixedArray<Dependency>(dependencies.length, new Dependency('', Version.parse('0.0.0'), ''));
    for (var i = 0; i < dependencies.length; i += 1) {
      list[i] = dependencies[i];
    }
    this.releases[`${did} ${version}`] = new Release(Version.parse(version), '2026-10-22T00:00:00.000Z',
        new FixedArray<Artifact>(1, artifact), list);
  }

  source(): ReleaseSource {
    return async (did: String, version: Version): Future<CheckedRelease> => {
      let id = `${did} ${version.toString()}`;
      this.reads[id] = this.reads.getOr(id, 0) + 1;
      if (let (true, release) = this.releases.get(id)) {
        return new CheckedRelease(release, Cid.forDagCbor(encodeCbor(release.toValue())));
      }
      throw new ResolutionError(`no release ${id}`);
    };
  }
}

function needs(did: String, version: String, name: String) {
  return new Dependency(did, Version.parse(version), name);
}

function requirements(entries: Array<(String, String)>) {
  let list = new GrowableArray<Requirement>();
  for (let (did, version) in entries) {
    list.push(new Requirement(did, Version.parse(version)));
  }
  return list;
}

function resolved(registry: Registry, entries: Array<(String, String)>): Resolution {
  return runFuture(resolve(requirements(entries), registry.source()));
}

export let tests = suite('package-manager:resolve', () => {
  test('selects the highest minimum anyone asks for, not the newest release', (ctx) => {
    let registry = new Registry();
    registry.add(ROUTER, '1.4.2', growable([needs(JSON, '2.1.0', 'json')]));
    registry.add(JSON, '2.0.1');
    registry.add(JSON, '2.1.0');
    registry.add(JSON, '2.3.0');
    let resolution = resolved(registry, [(ROUTER, '1.4.2'), (JSON, '2.0.1')]);

    equal(resolution.packages.size, 2);
    let json = resolution.packages[`${JSON}@2`];
    equal(json.version.toString(), '2.1.0');
    isTrue(json.source.equals(Cid.forBlob(bytesOf(`${JSON} 2.1.0`))));
    let router = resolution.packages[`${ROUTER}@1`];
    equal(router.dependencies['json'], `${JSON}@2`);
    isTrue(router.release.equals(Cid.forDagCbor(encodeCbor(registry.releases[`${ROUTER} 1.4.2`].toValue()))));
  });

  test('selects one version for the whole workspace', (ctx) => {
    let registry = new Registry();
    registry.add(JSON, '2.0.1');
    registry.add(JSON, '2.1.0');
    // Two workspace packages need json 2, at different minimums.
    let resolution = resolved(registry, [(JSON, '2.0.1'), (JSON, '2.1.0')]);
    equal(resolution.packages.size, 1);
    equal(resolution.packages[`${JSON}@2`].version.toString(), '2.1.0');
  });

  test('keeps a version that a higher minimum overrides, for its dependencies', (ctx) => {
    let registry = new Registry();
    // The package asks for router 1.4.2, which needs log 1.2.0; json asks
    // for router 1.5.0, which needs no log at all. Router 1.5.0 is
    // selected, and log 1.2.0 with it, as Go's minimal version selection
    // does.
    registry.add(ROUTER, '1.4.2', growable([needs(LOG, '1.2.0', 'log')]));
    registry.add(ROUTER, '1.5.0');
    registry.add(JSON, '2.0.0', growable([needs(ROUTER, '1.5.0', 'router')]));
    registry.add(LOG, '1.2.0');
    let resolution = resolved(registry, [(ROUTER, '1.4.2'), (JSON, '2.0.0')]);
    equal(resolution.packages[`${ROUTER}@1`].version.toString(), '1.5.0');
    equal(resolution.packages[`${LOG}@1`].version.toString(), '1.2.0');
  });

  test('selects each major version of a package on its own', (ctx) => {
    let registry = new Registry();
    registry.add(ROUTER, '1.4.2', growable([needs(JSON, '3.0.0', 'json3')]));
    registry.add(JSON, '2.1.0');
    registry.add(JSON, '3.0.0');
    let resolution = resolved(registry, [(ROUTER, '1.4.2'), (JSON, '2.1.0')]);
    equal(resolution.packages.size, 3);
    equal(resolution.packages[`${JSON}@2`].version.toString(), '2.1.0');
    equal(resolution.packages[`${JSON}@3`].version.toString(), '3.0.0');
    equal(resolution.packages[`${ROUTER}@1`].dependencies['json3'], `${JSON}@3`);
  });

  test('lists packages in key order', (ctx) => {
    let registry = new Registry();
    registry.add(ROUTER, '1.0.0', growable([needs(LOG, '1.0.0', 'log'), needs(JSON, '2.0.0', 'json')]));
    registry.add(LOG, '1.0.0');
    registry.add(JSON, '2.0.0');
    let keys = new GrowableArray<String>();
    for (let key in resolved(registry, [(ROUTER, '1.0.0')]).packages.keys()) {
      keys.push(key);
    }
    equal(keys.length, 3);
    equal(keys[0], `${LOG}@1`);
    equal(keys[1], `${ROUTER}@1`);
    equal(keys[2], `${JSON}@2`);
  });

  test('reads each release once', (ctx) => {
    let registry = new Registry();
    registry.add(ROUTER, '1.0.0', growable([needs(JSON, '2.0.0', 'json')]));
    registry.add(LOG, '1.0.0', growable([needs(JSON, '2.0.0', 'json')]));
    registry.add(JSON, '2.0.0');
    resolved(registry, [(ROUTER, '1.0.0'), (LOG, '1.0.0')]);
    equal(registry.reads[`${JSON} 2.0.0`], 1);
    equal(registry.reads[`${ROUTER} 1.0.0`], 1);
  });

  test('refuses a selected release with no source archive', (ctx) => {
    let registry = new Registry();
    registry.add(ROUTER, '1.0.0', new GrowableArray<Dependency>(), COMPONENT);
    var message = '';
    try {
      resolved(registry, [(ROUTER, '1.0.0')]);
    } catch (e) {
      message = if (e is ResolutionError) e.message else 'another error';
    }
    isTrue(message.contains('no source artifact'), message);
  });

  test('passes on a missing release', (ctx) => {
    let registry = new Registry();
    registry.add(ROUTER, '1.0.0', growable([needs(JSON, '2.0.0', 'json')]));
    var message = '';
    try {
      resolved(registry, [(ROUTER, '1.0.0')]);
    } catch (e) {
      message = e.message;
    }
    isTrue(message.contains(`no release ${JSON} 2.0.0`), message);
  });
});
