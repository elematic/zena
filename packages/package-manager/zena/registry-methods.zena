/**
 * The NSIDs of the package host's XRPC methods, whose lexicons are in
 * `packages/package-manager/lexicons/dev/zena-lang/registry`. The host serves
 * them (`pds:xrpc/registry`), and `zena` calls them, so both spell each name
 * the same way. `test/lexicons_test.zena` checks that every one has a
 * lexicon, and every host lexicon a constant here.
 */

export let COMPLETE_CHANGE = 'dev.zena-lang.registry.completeChange';
export let COMPLETE_RELEASE = 'dev.zena-lang.registry.completeRelease';
export let CREATE_AUTOMATION_ACCOUNT = 'dev.zena-lang.registry.createAutomationAccount';
export let CREATE_ORGANIZATION = 'dev.zena-lang.registry.createOrganization';
export let CREATE_PACKAGE = 'dev.zena-lang.registry.createPackage';
export let CREATE_WEB_SESSION = 'dev.zena-lang.registry.createWebSession';
export let DELETE_TEAM = 'dev.zena-lang.registry.deleteTeam';
export let DESCRIBE_REGISTRY = 'dev.zena-lang.registry.describeRegistry';
export let GET_ENTRIES = 'dev.zena-lang.registry.getEntries';
export let GET_MEMBERSHIPS = 'dev.zena-lang.registry.getMemberships';
export let GET_PENDING_CHANGES = 'dev.zena-lang.registry.getPendingChanges';
export let GET_PENDING_RELEASES = 'dev.zena-lang.registry.getPendingReleases';
export let LIST_PACKAGES = 'dev.zena-lang.registry.listPackages';
export let LIST_SCOPES = 'dev.zena-lang.registry.listScopes';
export let PUBLISH = 'dev.zena-lang.registry.publish';
export let PUT_MAINTAINERS = 'dev.zena-lang.registry.putMaintainers';
export let PUT_MEMBERS = 'dev.zena-lang.registry.putMembers';
export let PUT_POLICY = 'dev.zena-lang.registry.putPolicy';
export let PUT_PROFILE = 'dev.zena-lang.registry.putProfile';
export let PUT_SCOPE_PROFILE = 'dev.zena-lang.registry.putScopeProfile';
export let PUT_TEAM = 'dev.zena-lang.registry.putTeam';
export let RENAME_PACKAGE = 'dev.zena-lang.registry.renamePackage';
export let RETRACT = 'dev.zena-lang.registry.retract';
export let UPLOAD_ARTIFACT = 'dev.zena-lang.registry.uploadArtifact';
export let WITHDRAW_CHANGE = 'dev.zena-lang.registry.withdrawChange';
export let WITHDRAW_RELEASE = 'dev.zena-lang.registry.withdrawRelease';

/**
 * The service an account's DID document names its package host by, and
 * its type: a client finds the host's methods at its endpoint
 * (package-manager.md, "Finding a host"). A token for the host's methods
 * may name it as the fragment of the host's DID.
 */
export let REGISTRY_SERVICE = 'zena_registry';
export let REGISTRY_TYPE = 'ZenaRegistry';

/** Every method above. */
export let REGISTRY_METHODS: Array<String> = [
  COMPLETE_CHANGE, COMPLETE_RELEASE, CREATE_AUTOMATION_ACCOUNT, CREATE_ORGANIZATION, CREATE_PACKAGE,
  CREATE_WEB_SESSION, DELETE_TEAM, DESCRIBE_REGISTRY, GET_ENTRIES, GET_MEMBERSHIPS, GET_PENDING_CHANGES, GET_PENDING_RELEASES,
  LIST_PACKAGES, LIST_SCOPES, PUBLISH, PUT_MAINTAINERS, PUT_MEMBERS, PUT_POLICY, PUT_PROFILE, PUT_SCOPE_PROFILE, PUT_TEAM, RENAME_PACKAGE, RETRACT,
  UPLOAD_ARTIFACT, WITHDRAW_CHANGE, WITHDRAW_RELEASE
];
