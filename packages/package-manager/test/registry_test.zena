/**
 * Finding packages against `package-manager/testing/fake-pds`, which plays
 * the PLC directory, a DNS-over-HTTPS resolver and the packages' PDS.
 */

import {suite, test} from 'zena:test';
import {equal, isNull, isTrue} from 'zena:assert';
import {Future} from 'zena:async';
import {OrderedHashMap} from 'zena:collections';
import {Cid} from 'atproto/cid';
import {BlobRef} from 'atproto/data';
import {Artifact, Dependency, Profile, Release, SOURCE, Retraction} from 'package-manager/records';
import {
  RegistryError,
  fetchProfile,
  listVersions,
  NetworkSource,
  resolveIdentifier,
  scopedHandle,
  scopedName
} from 'package-manager/registry';
import {Requirement, resolve} from 'package-manager/resolve';
import {DID, FakeAccount, FakePds} from 'package-manager/testing/fake-pds';
import {Range, Version} from 'zena-lang:semver';

let JSON_DID = 'did:plc:jsonjsonjsonjsonjsonjson';

function bytesOf(text: String) {
  let out = new FixedArray<u8>(text.length, 0 as u8);
  for (var i = 0; i < text.length; i += 1) {
    out[i] = text.getByteAt(i) as u8;
  }
  return out;
}

/** Publishes `version` on `account`, depending on `dependencies`. */
function publish(account: FakeAccount, version: String,
    dependencies: FixedArray<Dependency> = new FixedArray<Dependency>(0,
        new Dependency('', Range.parse('0.0.0'), ''))) {
  let source = account.addBlob(bytesOf(`${account.did} ${version}`));
  let artifact = Artifact.whole(SOURCE, new BlobRef(source, 'application/vnd.ipld.car', 1 as i64));
  return account.publish(new Release(Version.parse(version), '2026-10-22T00:00:00.000Z',
      new FixedArray<Artifact>(1, artifact), dependencies));
}

function started() {
  let pds = new FakePds();
  pds.start();
  return pds;
}

function noScopes() {
  return new OrderedHashMap<String, String>();
}

export let tests = suite('package-manager/registry', () => {
  test('turns scope:name into a handle', (ctx) => {
    equal(scopedHandle('acme:router', noScopes()), 'router.acme.pkg.zena-lang.dev');
    equal(scopedHandle('acme:router', noScopes(), 'pkg.example.com'), 'router.acme.pkg.example.com');
    let scopes = new OrderedHashMap<String, String>();
    scopes['widgets'] = 'widgets.alt-pkg.org';
    equal(scopedHandle('widgets:foo', scopes), 'foo.widgets.alt-pkg.org');
    for (let bad in ['acme', 'acme:', ':router', 'acme:router:x']) {
      var caught = false;
      try {
        scopedHandle(bad, noScopes());
      } catch (e) {
        caught = e is RegistryError;
      }
      isTrue(caught, bad);
    }
  });

  test('names a handle in a scope scope:name, as scopedHandle reads it', (ctx) => {
    equal(scopedName('router.acme.pkg.zena-lang.dev', noScopes()) as String, 'acme:router');
    equal(scopedName('Router.ACME.pkg.zena-lang.dev', noScopes()) as String, 'acme:router');
    equal(scopedName('router.acme.pkg.example.com', noScopes(), 'pkg.example.com') as String, 'acme:router');
    let scopes = new OrderedHashMap<String, String>();
    scopes['widgets'] = 'widgets.alt-pkg.org';
    equal(scopedName('foo.widgets.alt-pkg.org', scopes) as String, 'widgets:foo');
    // A handle in no scope this workspace knows, or not a name in one.
    for (let handle in ['json.example.com', 'acme.pkg.zena-lang.dev', 'a.b.acme.pkg.zena-lang.dev',
        'router.acme.pkg.example.com', 'deep.foo.widgets.alt-pkg.org']) {
      isNull(scopedName(handle, scopes), handle);
    }
  });

  test('resolves a DID, a handle and scope:name to a DID', async (ctx): Future<void> => {
    let pds = started();
    pds.account(JSON_DID, 'json.acme.pkg.zena-lang.dev');
    let resolver = pds.resolver();
    equal(await resolveIdentifier(JSON_DID, noScopes(), resolver), JSON_DID);
    equal(await resolveIdentifier('json.acme.pkg.zena-lang.dev', noScopes(), resolver), JSON_DID);
    equal(await resolveIdentifier('acme:json', noScopes(), resolver), JSON_DID);
    var message = '';
    try {
      await resolveIdentifier('acme:nothing', noScopes(), resolver);
    } catch (e) {
      message = e.message;
    }
    isTrue(message.contains('does not resolve'), message);
    pds.close();
  });

  test('lists versions, and picks the latest that is not retracted', async (ctx): Future<void> => {
    let pds = started();
    let account = pds.main;
    for (let version in ['0.1.0', '0.1.4', '0.2.0', '1.0.0', '1.4.2', '1.5.0', '2.0.0-rc.1', '2.0.0', '2.1.0']) {
      publish(account, version);
    }
    account.retract(new Retraction(Version.parse('2.1.0'), 'broken'));
    let document = await pds.resolver().resolveDid(DID);
    let versions = await listVersions(document);
    equal(versions.releases.length, 9);
    equal((versions.latest() as Version).toString(), '2.0.0');
    equal((versions.latest('1') as Version).toString(), '1.5.0');
    equal((versions.latest('2', true) as Version).toString(), '2.0.0');
    isNull(versions.latest('3'));
    // Before 1.0, each minor version is a line of its own.
    equal((versions.latest('0.1') as Version).toString(), '0.1.4');
    equal((versions.latest('0.2') as Version).toString(), '0.2.0');
    isTrue(versions.has(Version.parse('1.4.2')));
    pds.close();
  });

  test('reads a profile with its proof', async (ctx): Future<void> => {
    let pds = started();
    let resolver = pds.resolver();
    isTrue(await fetchProfile(await resolver.resolveDid(DID)) == null);
    pds.main.setProfile(new Profile('router', 'Routing'));
    equal((await fetchProfile(await resolver.resolveDid(DID)) as Profile).name, 'router');
    pds.close();
  });

  test('resolves over the network, each release checked', async (ctx): Future<void> => {
    let pds = started();
    let json = pds.account(JSON_DID);
    publish(json, '2.0.0');
    publish(json, '2.1.0');
    let needsJson = new FixedArray<Dependency>(1, new Dependency(JSON_DID, Range.parse('2.1.0'), 'json'));
    let routerRecord = publish(pds.main, '1.4.2', needsJson);
    let requirements = new GrowableArray<Requirement>();
    requirements.push(new Requirement(DID, Range.parse('1.4.2')));
    requirements.push(new Requirement(JSON_DID, Range.parse('^2.0.0')));

    let resolution = await resolve(requirements, new NetworkSource(pds.resolver()));
    equal(resolution.packages[`${JSON_DID}@2.1.0`].version.toString(), '2.1.0');
    isTrue(resolution.packages[`${DID}@1.4.2`].release.equals(routerRecord));
    isTrue(resolution.packages[`${DID}@1.4.2`].source.equals(Cid.forBlob(bytesOf(`${DID} 1.4.2`))));

    var message = '';
    try {
      requirements[1] = new Requirement(JSON_DID, Range.parse('2.9.0'));
      await resolve(requirements, new NetworkSource(pds.resolver()));
    } catch (e) {
      message = e.message;
    }
    isTrue(message.contains(`no usable release of ${JSON_DID} is in '2.9.0'`), message);
    pds.close();
  });
});
