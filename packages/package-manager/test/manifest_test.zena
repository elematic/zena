import {suite, test} from 'zena:test';
import {equal, isNull, isTrue, jsonEqual} from 'zena:assert';
import {OrderedHashMap} from 'zena:collections';
import {join} from 'zena:core';
import {parseJson} from 'zena:json';
import {ManifestError, publishedRange, readManifest, writeDependencies, writeDid} from 'package-manager/manifest';
import {Requirement} from 'package-manager/resolve';
import {Range, Version} from 'zena-lang:semver';

let ROUTER = 'did:plc:routerrouterrouterrouter';

function rejects(text: String) {
  var caught = false;
  try {
    readManifest(text);
  } catch (e) {
    caught = e is ManifestError;
  }
  isTrue(caught, text);
}

/** The byte offset of `needle` in `text`, or -1. */
function offsetOf(text: String, needle: String): i32 {
  for (var i = 0; i + needle.length <= text.length; i += 1) {
    if (text.sliceBytes(i, i + needle.length) == needle) {
      return i;
    }
  }
  return -1;
}

export let tests = suite('package-manager/manifest', () => {
  test('reads a workspace root manifest', (ctx) => {
    let manifest = readManifest(`{
      "name": "app",
      "did": "did:plc:appappappappappappappapp",
      "exports": {"server": {}},
      "dependencies": {
        "router": {"did": "${ROUTER}", "version": "1.4.2"},
        "lib": {"path": "./packages/lib"},
        "json": {"did": "did:web:json.example.com", "version": "2.0.1"},
        "acme:http": {"did": "did:web:http.example.com", "version": "3.0.0"}
      },
      "workspace": {"packages": ["packages/*", "tools/gen"]},
      "scopes": {"widgets": "widgets.alt-pkg.org"}
    }`);
    equal(manifest.name as String, 'app');
    equal(manifest.did as String, 'did:plc:appappappappappappappapp');
    equal(manifest.requirements.size, 3);
    let names = new GrowableArray<String>();
    for (let name in manifest.requirements.keys()) {
      names.push(name);
    }
    equal(names[0], 'router');
    equal(names[1], 'json');
    equal(names[2], 'acme:http');
    equal(manifest.requirements['router'].did, ROUTER);
    equal(manifest.requirements['json'].range.text, '2.0.1');
    equal(manifest.paths['lib'], './packages/lib');
    equal(manifest.workspacePackages.length, 2);
    equal(manifest.workspacePackages[1], 'tools/gen');
    equal(manifest.scopes['widgets'], 'widgets.alt-pkg.org');
  });

  test('reads what to do about a package at two versions, allow by default', (ctx) => {
    equal(readManifest('{}').duplicates, 'allow');
    equal(readManifest('{"duplicates": "warn"}').duplicates, 'warn');
    equal(readManifest('{"duplicates": "error"}').duplicates, 'error');
    rejects('{"duplicates": "never"}');
    rejects('{"duplicates": true}');
  });

  test('gives names their scope unless scopedNames is false', (ctx) => {
    isTrue(readManifest('{}').scopedNames, 'by default');
    isTrue(!readManifest('{"scopedNames": false}').scopedNames, 'turned off');
  });

  test('reads main, the library an import of the name alone imports', (ctx) => {
    isNull(readManifest('{}').main);
    equal(readManifest('{"main": "server"}').main as String, 'server');
    equal(readManifest('{"main": "server", "exports": {"server": {}}}').main as String, 'server');
    rejects('{"main": 3}');
    rejects('{"main": "server.zena"}');
    rejects('{"main": "client", "exports": {"server": {}}}');
  });

  test("measures exports' files from the source directory, src by default", (ctx) => {
    let named = readManifest(`{"exports": {"server": {}, "client": {"path": "./web/client.zena"},
        "console": {"virtual": {"js": "console/js.zena"}}}}`);
    equal(named.source, 'src');
    equal(join(named.exportFiles, ' '), 'src/server.zena src/web/client.zena src/console/js.zena');
    let atRoot = readManifest('{"source": "./", "exports": {"server": {}}}');
    equal(atRoot.source, '.');
    equal(join(atRoot.exportFiles, ' '), 'server.zena');
    equal(readManifest('{"source": "lib/zena/"}').source, 'lib/zena');
    rejects('{"source": "../shared"}');
    rejects('{"source": "/abs"}');
    rejects('{"source": 3}');
  });

  test('reads a missing or minimal manifest as empty', (ctx) => {
    let empty = readManifest(null);
    isNull(empty.name);
    isNull(empty.did);
    equal(empty.requirements.size, 0);
    equal(empty.paths.size, 0);
    equal(empty.workspacePackages.length, 0);
    equal(readManifest('{"exports": {}}').requirements.size, 0);
  });

  test('rejects manifests it cannot use', (ctx) => {
    rejects('not json');
    rejects('[]');
    rejects('{"name": "App"}');
    rejects('{"did": "app"}');
    rejects('{"dependencies": []}');
    rejects(`{"dependencies": {"Router": {"did": "${ROUTER}", "version": "1.4.2"}}}`);
    for (let name in ['acme:', ':router', 'acme:router:x', 'acme/router', 'Acme:router', 'zena:router', '@acme/router']) {
      rejects(`{"dependencies": {"${name}": {"did": "${ROUTER}", "version": "1.4.2"}}}`);
    }
    for (let name in ['Acme:app', 'zena:app', 'acme:', ':app', 'acme:app:x', 'acme:zena']) {
      rejects(`{"name": "${name}"}`);
    }
    rejects('{"dependencies": {"router": {"did": "router", "version": "1.4.2"}}}');
    rejects(`{"dependencies": {"router": {"did": "${ROUTER}", "version": "one"}}}`);
    rejects(`{"dependencies": {"router": {"did": "${ROUTER}"}}}`);
    rejects('{"dependencies": {"router": "1.4.2"}}');
    rejects(`{"dependencies": {"lib": {"path": "./lib", "did": "${ROUTER}"}}}`);
    rejects('{"dependencies": {"lib": {"path": 3}}}');
    rejects('{"workspace": {"packages": "packages/*"}}');
    rejects('{"scopes": {"@widgets": "widgets.alt-pkg.org"}}');
    rejects('{"scopedNames": "no"}');
  });

  test('reads and keeps a WIT dependency, which it has nothing to fetch for', (ctx) => {
    let text = `{
      "name": "app",
      "dependencies": {
        "gfx": {"wit": "./wit/gfx.wit"},
        "router": {"did": "${ROUTER}", "version": "1.4.2"}
      }
    }`;
    let manifest = readManifest(text);
    equal(manifest.wits.size, 1);
    equal(manifest.wits['gfx'], './wit/gfx.wit');
    isTrue(!manifest.requirements.has('gfx') && !manifest.paths.has('gfx'), 'not a package to fetch');
    rejects(`{"dependencies": {"gfx": {"wit": "./wit", "did": "${ROUTER}"}}}`);
    rejects('{"dependencies": {"gfx": {"wit": "./wit", "path": "./lib"}}}');
    rejects('{"dependencies": {"gfx": {"wit": 3}}}');

    // Writing the published dependencies keeps it, where it was.
    manifest.requirements['router'] = new Requirement(ROUTER, Range.parse('1.5.0'));
    let written = writeDependencies(text, manifest.requirements, manifest.paths);
    jsonEqual(parseJson(written), parseJson(`{
      "name": "app",
      "dependencies": {
        "gfx": {"wit": "./wit/gfx.wit"},
        "router": {"did": "${ROUTER}", "version": "1.5.0"}
      }
    }`));
    isTrue(offsetOf(written, '"gfx"') < offsetOf(written, '"router"'));
  });

  test('writes dependencies in place, keeping the rest of the manifest', (ctx) => {
    let manifest = readManifest(`{
      "name": "app",
      "dependencies": {
        "lib": {"path": "./packages/lib"},
        "router": {"did": "${ROUTER}", "version": "1.4.2"}
      },
      "license": "MIT"
    }`);
    manifest.requirements['router'] = new Requirement(ROUTER, Range.parse('1.5.0'));
    manifest.requirements['json'] = new Requirement('did:web:json.example.com', Range.parse('2.1.0'));
    let text = writeDependencies(`{
      "name": "app",
      "dependencies": {
        "lib": {"path": "./packages/lib"},
        "router": {"did": "${ROUTER}", "version": "1.4.2"}
      },
      "license": "MIT"
    }`, manifest.requirements, manifest.paths);
    jsonEqual(parseJson(text), parseJson(`{
      "name": "app",
      "dependencies": {
        "lib": {"path": "./packages/lib"},
        "router": {"did": "${ROUTER}", "version": "1.5.0"},
        "json": {"did": "did:web:json.example.com", "version": "2.1.0"}
      },
      "license": "MIT"
    }`));
    // The existing entries keep their places, and the new one follows.
    isTrue(offsetOf(text, '"lib"') < offsetOf(text, '"router"'));
    isTrue(offsetOf(text, '"router"') < offsetOf(text, '"json"'));
    isTrue(offsetOf(text, '"json"') < offsetOf(text, '"license"'));
    let written = writeDependencies(null, manifest.requirements, new OrderedHashMap<String, String>());
    jsonEqual(parseJson(written), parseJson(`{"dependencies": {
      "router": {"did": "${ROUTER}", "version": "1.5.0"},
      "json": {"did": "did:web:json.example.com", "version": "2.1.0"}
    }}`));
  });

  test('reads the range a path dependency is published with, and keeps it', (ctx) => {
    let text = `{
      "name": "app",
      "dependencies": {
        "lib": {"path": "./packages/lib", "version": "~0.0.3"},
        "tools": {"path": "./packages/tools"},
        "router": {"did": "${ROUTER}", "version": "1.4.2"}
      }
    }`;
    let manifest = readManifest(text);
    equal(manifest.paths['lib'], './packages/lib');
    equal(manifest.paths['tools'], './packages/tools');
    equal(manifest.pathRanges.size, 1);
    equal(manifest.pathRanges['lib'].text, '~0.0.3');
    isTrue(manifest.pathRanges['lib'].includes(Version.parse('0.0.5')));
    isTrue(!manifest.requirements.has('lib'), 'a path dependency is not a published one');

    // Writing the dependencies again keeps the range beside its path.
    manifest.requirements['router'] = new Requirement(ROUTER, Range.parse('1.5.0'));
    jsonEqual(parseJson(writeDependencies(text, manifest.requirements, manifest.paths)), parseJson(`{
      "name": "app",
      "dependencies": {
        "lib": {"path": "./packages/lib", "version": "~0.0.3"},
        "tools": {"path": "./packages/tools"},
        "router": {"did": "${ROUTER}", "version": "1.5.0"}
      }
    }`));

    rejects('{"dependencies": {"lib": {"path": "./lib", "version": "one"}}}');
    rejects('{"dependencies": {"lib": {"path": "./lib", "version": 3}}}');
    rejects(`{"dependencies": {"lib": {"path": "./lib", "version": "~0.0.3", "did": "${ROUTER}"}}}`);
  });

  test('publishes a path dependency with its range, or else the caret of its version', (ctx) => {
    let manifest = readManifest(`{
      "name": "app",
      "dependencies": {
        "lib": {"path": "./packages/lib", "version": "~0.0.3"},
        "tools": {"path": "./packages/tools"},
        "early": {"path": "./packages/early", "version": "~0.0.1-preview.1"}
      }
    }`);
    equal(publishedRange(manifest, 'lib', Version.parse('0.0.3')).text, '~0.0.3');
    // The range stays where it is while the dependency moves within it.
    equal(publishedRange(manifest, 'lib', Version.parse('0.0.9')).text, '~0.0.3');
    equal(publishedRange(manifest, 'tools', Version.parse('1.4.2')).text, '^1.4.2');
    equal(publishedRange(manifest, 'early', Version.parse('0.0.1-preview.2')).text, '~0.0.1-preview.1');
    equal(publishedRange(manifest, 'early', Version.parse('0.0.4')).text, '~0.0.1-preview.1');

    // A range that leaves out the version at the path is refused.
    for (let version in ['0.0.2', '0.1.0', '0.0.4-preview.1']) {
      var message = '';
      try {
        publishedRange(manifest, 'lib', Version.parse(version));
      } catch (e) {
        isTrue(e is ManifestError);
        message = e.message;
      }
      equal(message,
          `zena-package.json: dependency 'lib' is published as ~0.0.3, which leaves out ${version}, the version at its path`);
    }
  });

  test('reads the version a package publishes next', (ctx) => {
    equal((readManifest('{"name": "router", "version": "1.4.2"}').version as Version).toString(), '1.4.2');
    isTrue(readManifest('{"name": "router"}').version == null);
    var message = '';
    try {
      readManifest('{"name": "router", "version": "one"}');
    } catch (e) {
      message = e.message;
    }
    isTrue(message.contains('version'), message);
  });

  test('writes the DID after the name, or where it was', (ctx) => {
    let did = 'did:plc:routerrouterrouterrouter';
    let written = writeDid('{"name": "router", "version": "1.0.0"}', did);
    equal(written, '{\n  "name": "router",\n  "did": "did:plc:routerrouterrouterrouter",\n  "version": "1.0.0"\n}\n');
    jsonEqual(parseJson(writeDid('{"did": "did:plc:old", "name": "router"}', did)),
        parseJson(`{"did": "${did}", "name": "router"}`));
    equal(readManifest(written).did as String, did);
  });

  test('reads the scope from the name', (ctx) => {
    let scoped = readManifest('{"name": "acme:router"}');
    equal(scoped.name as String, 'router');
    equal(scoped.scope as String, 'acme');
    isTrue(readManifest('{"name": "router"}').scope == null, 'no scope');
    // A field of another name, scope included, is no part of the name.
    isTrue(readManifest('{"name": "router", "scope": "acme"}').scope == null, 'a scope field');
  });

  test('writes the scope into the name', (ctx) => {
    let did = 'did:plc:routerrouterrouterrouter';
    let written = writeDid('{"name": "router", "version": "1.0.0"}', did, 'acme');
    equal(written,
        '{\n  "name": "acme:router",\n  "did": "did:plc:routerrouterrouterrouter",\n  "version": "1.0.0"\n}\n');
    equal(readManifest(written).scope as String, 'acme');
    // A scope already in the name is replaced.
    jsonEqual(parseJson(writeDid('{"name": "old:router"}', did, 'acme')),
        parseJson(`{"name": "acme:router", "did": "${did}"}`));
  });
});
