        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 640,
            "maxGraphemes": 64
          },
          "description": {
            "type": "string",
            "maxLength": 2560,
            "maxGraphemes": 256
          },
          "website": {
            "type": "string",
            "format": "uri",
            "maxLength": 512,
            "description": "An http: or https: URL."
          }
        }
      }
    }
  }
