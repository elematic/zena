{
  "lexicon": 1,
  "id": "dev.zena-lang.registry.listScopeCreators",
  "defs": {
    "main": {
      "type": "query",
      "description": "The accounts listed as ones that may create scopes (putScopeCreator), earliest listed first. The caller must be one of the registry's admins.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["creators"],
          "properties": {
            "creators": {
              "type": "array",
              "items": {"type": "ref", "ref": "#creator"}
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller is not one of the registry's admins."
        }
      ]
    },
    "creator": {
      "type": "object",
      "required": ["did", "addedBy", "addedAt"],
      "properties": {
        "did": {"type": "string", "format": "did"},
        "addedBy": {
          "type": "string",
          "format": "did",
          "description": "The admin who listed it."
        },
        "addedAt": {"type": "string", "format": "datetime"}
      }
    }
  }
}
