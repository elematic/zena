{
  "lexicon": 1,
  "id": "dev.zena-lang.registry.listScopes",
  "defs": {
    "main": {
      "type": "query",
      "description": "Every scope on this registry: its name, its organization, and how many packages it has. Public.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["scopes"],
          "properties": {
            "scopes": {
              "type": "array",
              "items": {"type": "ref", "ref": "#scope"}
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["name", "did", "handle", "packages"],
      "properties": {
        "name": {"type": "string"},
        "did": {"type": "string", "format": "did"},
        "handle": {"type": "string", "format": "handle"},
        "packages": {"type": "integer", "minimum": 0}
      }
    }
  }
}
