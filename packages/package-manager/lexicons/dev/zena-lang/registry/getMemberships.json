{
  "lexicon": 1,
  "id": "dev.zena-lang.registry.getMemberships",
  "defs": {
    "main": {
      "type": "query",
      "description": "The scopes, organizations, teams and packages on this registry that the caller has a role in, as the records stand now, each with the role. A scope or package the caller maintains through a team is listed with the team's role.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "scopes", "orgs", "teams", "packages"],
          "properties": {
            "did": {
              "type": "string",
              "format": "did",
              "description": "The caller."
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#membership"
              },
              "description": "Scopes the caller is an owner or a publisher of."
            },
            "orgs": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#membership"
              },
              "description": "Organizations the caller is a member of."
            },
            "teams": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#membership"
              }
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#membership"
              }
            }
          }
        }
      }
    },
    "membership": {
      "type": "object",
      "required": ["did", "handle", "scope", "name", "role"],
      "properties": {
        "did": {
          "type": "string",
          "format": "did",
          "description": "The scope, organization or package; for a team, its organization."
        },
        "handle": {
          "type": "string",
          "format": "handle"
        },
        "scope": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "The scope's or organization's name, the team's name, or the package's name."
        },
        "role": {
          "type": "string"
        }
      }
    }
  }
}
