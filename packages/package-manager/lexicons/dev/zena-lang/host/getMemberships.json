{
  "lexicon": 1,
  "id": "dev.zena-lang.host.getMemberships",
  "defs": {
    "main": {
      "type": "query",
      "description": "The organizations, teams and packages on this host that the caller has a role in, as the records stand now, each with the role. A package the caller maintains through a team is listed with the team's role.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "orgs", "teams", "packages"],
          "properties": {
            "did": {
              "type": "string",
              "format": "did",
              "description": "The caller."
            },
            "orgs": {
              "type": "array",
              "items": {"type": "ref", "ref": "#membership"}
            },
            "teams": {
              "type": "array",
              "items": {"type": "ref", "ref": "#membership"}
            },
            "packages": {
              "type": "array",
              "items": {"type": "ref", "ref": "#membership"}
            }
          }
        }
      }
    },
    "membership": {
      "type": "object",
      "required": ["did", "handle", "scope", "name", "role"],
      "properties": {
        "did": {
          "type": "string",
          "format": "did",
          "description": "The organization or package; for a team, its organization."
        },
        "handle": {"type": "string", "format": "handle"},
        "scope": {"type": "string"},
        "name": {
          "type": "string",
          "description": "The scope, the team's name, or the package's name."
        },
        "role": {"type": "string"}
      }
    }
  }
}
