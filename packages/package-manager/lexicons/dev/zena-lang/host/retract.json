{
  "lexicon": 1,
  "id": "dev.zena-lang.host.retract",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Writes a retraction record for a version of a package. The caller must be a maintainer of the package.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["package", "version"],
          "properties": {
            "package": {
              "type": "string",
              "format": "did",
              "description": "A package on this host."
            },
            "version": {"type": "string"},
            "reason": {"type": "string"}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid"],
          "properties": {
            "uri": {"type": "string", "format": "at-uri"},
            "cid": {"type": "string", "format": "cid"}
          }
        }
      },
      "errors": [
        {
          "name": "ReleaseNotFound",
          "description": "The package has no release of that version."
        }
      ]
    }
  }
}
