{
  "lexicon": 1,
  "id": "dev.zena-lang.host.listPackages",
  "defs": {
    "main": {
      "type": "query",
      "description": "The packages on this host, or in one of its scopes, ordered by scope and name, each with what its profile says and its latest release that is not retracted. Public.",
      "parameters": {
        "type": "params",
        "properties": {
          "scope": {
            "type": "string",
            "description": "Only the packages in this scope."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["packages"],
          "properties": {
            "packages": {
              "type": "array",
              "items": {"type": "ref", "ref": "#package"}
            }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "required": ["did", "handle", "scope", "name", "releases"],
      "properties": {
        "did": {"type": "string", "format": "did"},
        "handle": {"type": "string", "format": "handle"},
        "scope": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "license": {"type": "string"},
        "latest": {
          "type": "string",
          "description": "The highest version that is not retracted, if there is one."
        },
        "releases": {
          "type": "integer",
          "minimum": 0,
          "description": "How many releases it has, retracted ones included."
        }
      }
    }
  }
}
