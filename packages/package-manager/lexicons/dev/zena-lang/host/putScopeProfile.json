{
  "lexicon": 1,
  "id": "dev.zena-lang.host.putScopeProfile",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Writes how an organization presents its scope ('dev.zena-lang.org.profile'), at once: it decides no one's role. The caller must be an admin or owner of the organization.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["organization", "profile"],
          "properties": {
            "organization": {
              "type": "string",
              "format": "did",
              "description": "The organization, whose handle is a scope on this host."
            },
            "profile": {
              "type": "unknown",
              "description": "A 'dev.zena-lang.org.profile' record."
            },
            "swapRecord": {
              "type": "string",
              "format": "cid",
              "description": "The CID the record must have now; the write fails with 'InvalidSwap' otherwise."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid"],
          "properties": {
            "uri": {
              "type": "string",
              "format": "at-uri"
            },
            "cid": {
              "type": "string",
              "format": "cid"
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidSwap",
          "description": "The record's current CID is not 'swapRecord'."
        }
      ]
    }
  }
}
