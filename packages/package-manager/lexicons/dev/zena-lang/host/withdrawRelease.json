{
  "lexicon": 1,
  "id": "dev.zena-lang.host.withdrawRelease",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stops holding a release that is waiting for approval, which frees its version for another. Its publisher or an owner of the package may.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["package", "version"],
          "properties": {
            "package": {
              "type": "string",
              "format": "did",
              "description": "A package on this host."
            },
            "version": {
              "type": "string",
              "description": "The version of a release the host holds."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {"type": "object", "properties": {}}
      },
      "errors": [
        {
          "name": "ReleaseNotFound",
          "description": "The host holds no release of that version."
        }
      ]
    }
  }
}
