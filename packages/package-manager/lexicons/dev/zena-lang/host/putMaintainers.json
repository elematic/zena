{
  "lexicon": 1,
  "id": "dev.zena-lang.host.putMaintainers",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Writes a new maintainers record for a package, with the entries behind any commitments it lists. The caller must be an owner of the package. The record counts once the previous record's owners' threshold attests it.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["package", "maintainers"],
          "properties": {
            "package": {
              "type": "string",
              "format": "did",
              "description": "A package on this host."
            },
            "maintainers": {
              "type": "unknown",
              "description": "A 'dev.zena-lang.package.maintainers' record."
            },
            "entries": {
              "type": "array",
              "items": {"type": "ref", "ref": "dev.zena-lang.org.defs#entry"},
              "description": "The entries behind the record's commitments, which the host keeps private."
            },
            "swapRecord": {
              "type": "string",
              "format": "cid",
              "description": "The CID the record must have now; the write fails with 'InvalidSwap' otherwise."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid"],
          "properties": {
            "uri": {"type": "string", "format": "at-uri"},
            "cid": {"type": "string", "format": "cid"}
          }
        }
      },
      "errors": [
        {
          "name": "InvalidSwap",
          "description": "The record's current CID is not 'swapRecord'."
        }
      ]
    }
  }
}
