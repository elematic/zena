{
  "lexicon": 1,
  "id": "dev.zena-lang.host.getPendingReleases",
  "defs": {
    "main": {
      "type": "query",
      "description": "The releases of a package that the host holds, waiting for its maintainers to attest them. The caller must be a maintainer of the package.",
      "parameters": {
        "type": "params",
        "required": ["package"],
        "properties": {
          "package": {
            "type": "string",
            "format": "did",
            "description": "A package on this host."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["releases"],
          "properties": {
            "releases": {
              "type": "array",
              "items": {"type": "ref", "ref": "#pendingRelease"}
            }
          }
        }
      }
    },
    "pendingRelease": {
      "type": "object",
      "required": [
        "version",
        "uri",
        "cid",
        "publisher",
        "heldAt",
        "expiresAt",
        "release",
        "approvedBy",
        "people",
        "threshold",
        "humans"
      ],
      "properties": {
        "version": {"type": "string"},
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "Where the release record will be written, which an attestation names."
        },
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "The release record's CID, which an attestation names."
        },
        "publisher": {
          "type": "string",
          "format": "did",
          "description": "The maintainer who published it."
        },
        "heldAt": {"type": "string", "format": "datetime"},
        "expiresAt": {
          "type": "string",
          "format": "datetime",
          "description": "When the host stops holding it, which frees its version."
        },
        "release": {
          "type": "unknown",
          "description": "The 'dev.zena-lang.package.release' record."
        },
        "approvedBy": {
          "type": "array",
          "items": {"type": "string", "format": "did"},
          "description": "The maintainers who have attested it, in the maintainers record's order."
        },
        "people": {
          "type": "integer",
          "minimum": 0,
          "description": "How many of them are people, not automation."
        },
        "threshold": {"type": "integer", "minimum": 1},
        "humans": {"type": "integer", "minimum": 0}
      }
    }
  }
}
