{
  "lexicon": 1,
  "id": "dev.zena-lang.host.renamePackage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Gives a package another name in its scope: its handle, with a PLC operation the host signs, and its profile's 'name'. The caller must be an owner of the package. Its DID does not change, and the old name is free for the scope's admins to give to another package.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["package", "name"],
          "properties": {
            "package": {
              "type": "string",
              "format": "did",
              "description": "A package on this host."
            },
            "name": {
              "type": "string",
              "maxLength": 63,
              "description": "One DNS label, under the rules for a profile's 'name'."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["handle"],
          "properties": {
            "handle": {"type": "string", "format": "handle"}
          }
        }
      },
      "errors": [
        {"name": "NameTaken", "description": "The scope has the name."}
      ]
    }
  }
}
