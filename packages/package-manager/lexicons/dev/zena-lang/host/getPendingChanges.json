{
  "lexicon": 1,
  "id": "dev.zena-lang.host.getPendingChanges",
  "defs": {
    "main": {
      "type": "query",
      "description": "The changes to an organization's or package's members, team and maintainers records that the host holds, waiting for approval. The caller must have a role in the organization or package.",
      "parameters": {
        "type": "params",
        "required": ["account"],
        "properties": {
          "account": {
            "type": "string",
            "format": "did",
            "description": "An organization or package on this host."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["changes"],
          "properties": {
            "changes": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#pendingChange"
              }
            }
          }
        }
      }
    },
    "pendingChange": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "collection",
        "rkey",
        "proposer",
        "heldAt",
        "expiresAt",
        "record",
        "entries",
        "requirements"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "Where the new record will be written, which an attestation names."
        },
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "The new record's CID, which an attestation names."
        },
        "collection": {
          "type": "string",
          "format": "nsid"
        },
        "rkey": {
          "type": "string",
          "format": "record-key"
        },
        "base": {
          "type": "string",
          "format": "cid",
          "description": "The CID of the record it replaces; absent for a new team."
        },
        "proposer": {
          "type": "string",
          "format": "did",
          "description": "Who asked for it."
        },
        "heldAt": {
          "type": "string",
          "format": "datetime"
        },
        "expiresAt": {
          "type": "string",
          "format": "datetime",
          "description": "When the host stops holding it."
        },
        "record": {
          "type": "unknown",
          "description": "The new record."
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "dev.zena-lang.org.defs#entry"
          },
          "description": "The entries behind the new record's commitments that the caller may see, as 'dev.zena-lang.host.getEntries' would show them once it is written."
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "dev.zena-lang.host.completeChange#requirement"
          }
        }
      }
    }
  }
}
