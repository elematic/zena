{
  "lexicon": 1,
  "id": "dev.zena-lang.host.putProfile",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Replaces a package's profile. The caller must be an owner of the package. A profile whose 'name' differs from the package's handle is refused; 'dev.zena-lang.host.renamePackage' changes both.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["package", "profile"],
          "properties": {
            "package": {
              "type": "string",
              "format": "did",
              "description": "A package on this host."
            },
            "profile": {
              "type": "unknown",
              "description": "A 'dev.zena-lang.package.profile' record."
            },
            "swapRecord": {
              "type": "string",
              "format": "cid",
              "description": "The CID the record must have now; the write fails with 'InvalidSwap' otherwise."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid"],
          "properties": {
            "uri": {"type": "string", "format": "at-uri"},
            "cid": {"type": "string", "format": "cid"}
          }
        }
      },
      "errors": [
        {
          "name": "InvalidSwap",
          "description": "The record's current CID is not 'swapRecord'."
        }
      ]
    }
  }
}
