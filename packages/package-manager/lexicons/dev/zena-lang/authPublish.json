{
  "lexicon": 1,
  "id": "dev.zena-lang.authPublish",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Publish Zena packages",
      "detail": "Create and publish Zena packages on registries, and approve releases and changes of maintainers.",
      "permissions": [
        {
          "type": "permission",
          "resource": "repo",
          "collection": ["dev.zena-lang.package.attestation"]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "inheritAud": true,
          "lxm": [
            "dev.zena-lang.registry.completeChange",
            "dev.zena-lang.registry.completeRelease",
            "dev.zena-lang.registry.createAutomationAccount",
            "dev.zena-lang.registry.createOrganization",
            "dev.zena-lang.registry.createPackage",
            "dev.zena-lang.registry.createWebSession",
            "dev.zena-lang.registry.deleteTeam",
            "dev.zena-lang.registry.describeRegistry",
            "dev.zena-lang.registry.getEntries",
            "dev.zena-lang.registry.getMemberships",
            "dev.zena-lang.registry.getPendingChanges",
            "dev.zena-lang.registry.getPendingReleases",
            "dev.zena-lang.registry.issueAutomationToken",
            "dev.zena-lang.registry.listPackages",
            "dev.zena-lang.registry.listScopeCreators",
            "dev.zena-lang.registry.listScopes",
            "dev.zena-lang.registry.publish",
            "dev.zena-lang.registry.putMaintainers",
            "dev.zena-lang.registry.putMembers",
            "dev.zena-lang.registry.putPolicy",
            "dev.zena-lang.registry.putProfile",
            "dev.zena-lang.registry.putScopeCreator",
            "dev.zena-lang.registry.putScopeProfile",
            "dev.zena-lang.registry.putTeam",
            "dev.zena-lang.registry.renamePackage",
            "dev.zena-lang.registry.retireAutomationAccount",
            "dev.zena-lang.registry.uploadArtifact",
            "dev.zena-lang.registry.retract",
            "dev.zena-lang.registry.withdrawChange",
            "dev.zena-lang.registry.withdrawRelease"
          ]
        }
      ]
    }
  }
}
