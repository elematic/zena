{
  "lexicon": 1,
  "id": "dev.zena-lang.authPublish",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Publish Zena packages",
      "detail": "Create and publish Zena packages on package hosts, and approve releases and changes of maintainers.",
      "permissions": [
        {
          "type": "permission",
          "resource": "repo",
          "collection": ["dev.zena-lang.package.attestation"]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "inheritAud": true,
          "lxm": [
            "dev.zena-lang.host.completeChange",
            "dev.zena-lang.host.completeRelease",
            "dev.zena-lang.host.createAutomationAccount",
            "dev.zena-lang.host.createOrganization",
            "dev.zena-lang.host.createPackage",
            "dev.zena-lang.host.createWebSession",
            "dev.zena-lang.host.deleteTeam",
            "dev.zena-lang.host.getEntries",
            "dev.zena-lang.host.getMemberships",
            "dev.zena-lang.host.getPendingChanges",
            "dev.zena-lang.host.getPendingReleases",
            "dev.zena-lang.host.listPackages",
            "dev.zena-lang.host.listScopes",
            "dev.zena-lang.host.publish",
            "dev.zena-lang.host.putMaintainers",
            "dev.zena-lang.host.putMembers",
            "dev.zena-lang.host.putProfile",
            "dev.zena-lang.host.putTeam",
            "dev.zena-lang.host.renamePackage",
            "dev.zena-lang.host.uploadArtifact",
            "dev.zena-lang.host.retract",
            "dev.zena-lang.host.withdrawChange",
            "dev.zena-lang.host.withdrawRelease"
          ]
        }
      ]
    }
  }
}
