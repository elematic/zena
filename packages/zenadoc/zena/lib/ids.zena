/**
 * Naming a file inside a package.
 *
 * Stdlib files already carry a `zena:` id. Every other package resolves
 * to filesystem paths, and a path is not something a reader or a link
 * can use, so a path under the package root is rewritten to the same
 * `<package>:<path>` shape the stdlib's private files have.
 */
export final class Naming {
  #name: String;
  #root: String;

  new(name: String, root: String) : #name = name, #root = root;

  idOf(canonical: String): String {
    if (canonical.startsWith(this.#name + ':')) {
      return canonical;
    }
    let prefix = this.#root + '/';
    if (canonical.startsWith(prefix)) {
      return this.#name + ':' +
          canonical.sliceBytes(prefix.length, canonical.length);
    }
    return canonical;
  }
}
