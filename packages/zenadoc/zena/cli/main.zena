/**
 * zenadoc's command line.
 *
 * Reads a package, folder, or file and writes its API as JSON. Run it
 * directly until the `zena doc` subcommand exists:
 *
 *   zena-cli run --dir . packages/zenadoc/zena/cli/main.zena -- \
 *       packages/stdlib -o stdlib.json
 *
 * See docs/design/zenadoc.md.
 */

import { getArguments, exit } from 'zena:cli';
import { writeFile } from 'zena:fs';
import { DiagnosticSeverity, SourceSpan } from 'zena-compiler:diagnostics';
import { loadPackage } from '../lib/package.zena';
import { documentPackage, DocumentOptions } from '../lib/document.zena';
import { packageToJson } from '../lib/json.zena';

let USAGE =
    'Usage: zenadoc <path> [-o out.json] [--name <package>]\n' +
    '                [--include-private] [--target <target>]\n' +
    '                [--stdlib-root <dir>]';

export let main = (): i32 => {
  let args = getArguments();
  var path = '';
  var outPath = '';
  var name: String | null = null;
  let options = new DocumentOptions();

  var i = 1;
  while (i < args.length) {
    let arg = args[i];
    if (arg == '-o' && i + 1 < args.length) {
      outPath = args[i + 1];
      i += 1;
    } else if (arg == '--name' && i + 1 < args.length) {
      name = args[i + 1];
      i += 1;
    } else if (arg == '--target' && i + 1 < args.length) {
      options.target = args[i + 1];
      i += 1;
    } else if (arg == '--stdlib-root' && i + 1 < args.length) {
      options.stdlibRoot = args[i + 1];
      i += 1;
    } else if (arg == '--include-private') {
      options.includePrivate = true;
    } else if (arg == '-h' || arg == '--help') {
      console.log(USAGE);
      return 0;
    } else if (arg.startsWith('-')) {
      console.error('Unknown option: ' + arg);
      console.error(USAGE);
      exit(1);
    } else {
      path = arg;
    }
    i += 1;
  }

  if (path == '') {
    console.error(USAGE);
    exit(1);
  }

  let pkg = loadPackage(path, name, options.target);
  let result = documentPackage(pkg, options);

  for (let failure in result.failures) {
    console.error('Failed to document ' + failure);
  }
  for (let diagnostic in result.diagnostics) {
    if (diagnostic.severity == DiagnosticSeverity.Error) {
      console.error(where(diagnostic.location) + diagnostic.message);
    }
  }

  let json = packageToJson(result.docs);
  if (outPath == '') {
    console.log(json);
  } else {
    writeFile(outPath, json);
  }

  // The JSON is written either way: a package that does not check is
  // exactly when someone wants to read its docs.
  if (result.hasErrors()) {
    return 1;
  }
  return 0;
};

let where = (location: SourceSpan | null): String => {
  if (location == null) {
    return '';
  }
  return location.file + ':' + i32ToString(location.line) + ':' +
      i32ToString(location.column) + ' - ';
};
