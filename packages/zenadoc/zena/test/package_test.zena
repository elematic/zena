// Finding a package's modules, and documenting one end to end.
//
// Paths are relative to the repository root, which is where the test
// runner works from.

import { suite, test, TestContext, runAndReport } from 'zena:test';
import { equal } from 'zena:assert';
import {
  loadPackage, Package,
} from '../lib/package.zena';
import { join2 } from 'zena:path';
import { documentPackage, DocumentOptions } from '../lib/document.zena';
import { packageToJson } from '../lib/json.zena';

let FIXTURES = 'packages/zenadoc/zena/test/fixtures';

let moduleNames = (pkg: Package): String => {
  var out = '';
  for (let module in pkg.modules) {
    if (out.length > 0) {
      out = out + ',';
    }
    out = out + module.name;
  }
  return out;
};

let entryFile = (pkg: Package, name: String): String => {
  for (let module in pkg.modules) {
    if (module.name == name) {
      return module.file;
    }
  }
  return '';
};

let tests = suite('package', () => {
  test('reads a manifest package', (t: TestContext) => {
    let pkg = loadPackage(join2(FIXTURES, 'lib'));
    equal(pkg.name, 'fixture');
    equal(pkg.version, '1.2.3');
    equal(pkg.root, FIXTURES + '/lib');
  });

  test('lists exported modules in name order', (t: TestContext) => {
    let pkg = loadPackage(join2(FIXTURES, 'lib'));
    equal(moduleNames(pkg), 'console,facade,shapes,widgets');
  });

  test('uses the entry file the manifest names', (t: TestContext) => {
    let pkg = loadPackage(join2(FIXTURES, 'lib'));
    equal(entryFile(pkg, 'shapes'), 'shapes.zena');
    equal(entryFile(pkg, 'widgets'), 'nested/widgets.zena');
  });

  test('picks a virtual module entry by target', (t: TestContext) => {
    equal(entryFile(loadPackage(join2(FIXTURES, 'lib'), null, 'zena-cli'),
        'console'), 'nested/console-cli.zena');
    equal(entryFile(loadPackage(join2(FIXTURES, 'lib'), null, 'js'), 'console'),
        'nested/console-js.zena');
  });

  test('drops a module the target does not have', (t: TestContext) => {
    // `component-only` exists on the component target and nowhere else.
    equal(moduleNames(loadPackage(join2(FIXTURES, 'lib'), null, 'component')),
        'component-only,facade,shapes,widgets');
  });

  test('takes every file when there is no manifest', (t: TestContext) => {
    let pkg = loadPackage(join2(FIXTURES, 'open'));
    equal(pkg.name, 'open');
    equal(moduleNames(pkg), 'nested/deep,tools');
    equal(entryFile(pkg, 'nested/deep'), 'nested/deep.zena');
  });

  test('takes a single file as a package of one module', (t: TestContext) => {
    let pkg = loadPackage(join2(FIXTURES, 'open/tools.zena'));
    equal(pkg.name, 'tools');
    equal(pkg.root, FIXTURES + '/open');
    equal(moduleNames(pkg), 'tools');
  });

  test('honours a name override', (t: TestContext) => {
    equal(loadPackage(join2(FIXTURES, 'open'), 'renamed').name, 'renamed');
  });

  test('documents a package end to end', (t: TestContext) => {
    let pkg = loadPackage(join2(FIXTURES, 'lib'));
    let result = documentPackage(pkg, new DocumentOptions());
    equal(result.failures.length, 0);
    equal(result.hasErrors(), false);
    equal(result.docs.modules.length, 4);
    equal(result.docs.name, 'fixture');
    equal(result.docs.version, '1.2.3');
    let json = packageToJson(result.docs);
    equal(json.contains('"id": "fixture:shapes"'), true);
    equal(json.contains('"id": "fixture:shapes#Square"'), true);
    equal(json.contains('"signature": "class Square(side: f64)"'), true);
    equal(json.contains('"summary": "A square."'), true);
    // The virtual module documents the target's entry file.
    equal(json.contains('"file": "nested/console-cli.zena"'), true);
  });
});

export let main = (): i32 => runAndReport(tests, (s: String): void => {
  console.log(s);
});
