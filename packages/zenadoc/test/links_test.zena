// Type reference links, and the members a declaration inherits.
//
// Paths are relative to the repository root, which is where the test
// runner works from.

import { suite, test, TestContext } from 'zena:test';
import { equal } from 'zena:assert';
import { join2 } from 'zena:path';
import { loadPackage } from '../src/package.zena';
import {
  documentPackage, DocumentOptions, DocumentResult,
} from '../src/document.zena';
import { DocDeclaration, DocMember, DocModule, TypeRef } from '../src/model.zena';
import { packageToJson } from '../src/json.zena';

let FIXTURES = 'packages/zenadoc/test/fixtures';

async function documented() {
  return await documentPackage(await loadPackage(join2(FIXTURES, 'lib')), new DocumentOptions());
}

function moduleNamed(result: DocumentResult, name: String): DocModule {
  for (let module in result.docs.modules) {
    if (module.name == name) {
      return module;
    }
  }
  throw new Error('no module named ' + name);
}

function declaration(module: DocModule, name: String): DocDeclaration {
  for (let decl in module.declarations) {
    if (decl.name == name) {
      return decl;
    }
  }
  throw new Error('no declaration named ' + name);
}

function member(decl: DocDeclaration, name: String): DocMember {
  for (let entry in decl.members) {
    if (entry.name == name) {
      return entry;
    }
  }
  throw new Error('no member named ' + name);
}

let tests = suite('links', () => {
  test('links a supertype to the declaration it names', async (t) => {
    let circle = declaration(moduleNamed(await documented(), 'shapes'), 'Circle');
    equal(circle.interfaces.length, 1);
    let ref = circle.interfaces[0];
    equal(ref.text, 'Sized');
    equal(ref.links.length, 1);
    equal(ref.links[0].id, 'fixture/shapes#Sized');
    // The span covers the name, not the whole rendering.
    equal(ref.links[0].start, 0);
    equal(ref.links[0].end, 5);
  });

  test('links a type used in a member signature', async (t) => {
    let facade = moduleNamed(await documented(), 'facade');
    let gadget = declaration(facade, 'Gadget');
    equal(gadget.name, 'Gadget');
  });

  test('does not link a type parameter', async (t) => {
    // `Pair<A, B>`'s fields are its own type parameters, which name no
    // declaration a reader can open.
    let module = moduleNamed(await documented(), 'shapes');
    let square = declaration(module, 'Square');
    let side = member(square, 'side');
    let type = side.type;
    equal(type == null, false);
    if (type != null) {
      equal(type.text, 'f64');
      equal(type.links.length, 0);
    }
  });

  test('inherits members from an implemented interface', async (t) => {
    let boxed = declaration(moduleNamed(await documented(), 'shapes'), 'Boxed');
    equal(member(boxed, 'boxed').inheritedFrom == null, true);
    equal(member(boxed, 'size').inheritedFrom, 'fixture/shapes#Sized');
  });

  test('a declared member wins over an inherited one', async (t) => {
    // Circle declares `size` itself, so it is not marked inherited.
    let circle = declaration(moduleNamed(await documented(), 'shapes'), 'Circle');
    equal(member(circle, 'size').inheritedFrom == null, true);
  });

  test('serializes links and inheritance', async (t) => {
    let json = packageToJson((await documented()).docs);
    equal(json.contains('"id": "fixture/shapes#Sized"'), true);
    equal(json.contains('"inheritedFrom": "fixture/shapes#Sized"'), true);
  });

  test('produces the same bytes every run', async (t) => {
    equal(packageToJson((await documented()).docs), packageToJson((await documented()).docs));
  });
});
