/** Shapes. */

/** A square. */
export class Square(side: f64)

/** Something with a size. */
export interface Sized {
  size(): i32;
}

/** A circle. */
export class Circle implements Sized {
  radius: f64;
  new(this.radius);
  size(): i32 { return 1; }
  /** The area. */
  area(): f64 { return this.radius; }
}

/** A shape that is also sized. */
export interface Boxed extends Sized {
  boxed(): boolean;
}
