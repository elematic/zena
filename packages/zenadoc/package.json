        "../compiler/zena-package.json",
        "../wit-parser/zena-package.json"
      ],
      "output": [],
      "dependencies": [
        "../cli:build"
      ]
    }
  },
  "devDependencies": {
    "wireit": "^0.15.0"
  }
}
