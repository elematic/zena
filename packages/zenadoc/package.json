{
  "name": "@zena-lang/zenadoc",
  "version": "0.0.1-preview.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wireit"
  },
  "wireit": {
    "test": {
      "command": "../../target/release/zena-cli test \"test/*_test.zena\"",
