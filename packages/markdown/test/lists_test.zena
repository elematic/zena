/**
 * List tight/loose and indentation tests ported from `commonmark-java`
 * (`ListTightLooseTest` and `ListBlockParserTest`).
 */

import {suite, test, TestContext} from 'zena:test';
import {equal} from 'zena:assert';
import {markdownToHtml} from 'markdown:index';

export let tests = suite(
  'Lists (ported from commonmark-java)',
  () => {
    suite(
      'ListTightLooseTest',
      () => {
        test(
          'tight',
          (ctx) => {
            equal(
              markdownToHtml('- foo\n- bar\n+ baz\n'),
              '<ul>\n<li>foo</li>\n<li>bar</li>\n</ul>\n<ul>\n<li>baz</li>\n</ul>\n'
            );
          }
        );

        test(
          'loose',
          (ctx) => {
            equal(
              markdownToHtml('- foo\n\n- bar\n\n\n- baz\n'),
              '<ul>\n<li>\n<p>foo</p>\n</li>\n<li>\n<p>bar</p>\n</li>\n<li>\n<p>baz</p>\n</li>\n</ul>\n'
            );
          }
        );

        test(
          'looseNested',
          (ctx) => {
            equal(
              markdownToHtml('- foo\n  - bar\n\n\n    baz\n'),
              '<ul>\n<li>foo\n<ul>\n<li>\n<p>bar</p>\n<p>baz</p>\n</li>\n</ul>\n</li>\n</ul>\n'
            );
          }
        );

        test(
          'looseNested2',
          (ctx) => {
            equal(
              markdownToHtml('- a\n  - b\n\n    c\n- d\n'),
              '<ul>\n<li>a\n<ul>\n<li>\n<p>b</p>\n<p>c</p>\n</li>\n</ul>\n</li>\n<li>d</li>\n</ul>\n'
            );
          }
        );

        test(
          'looseOuter',
          (ctx) => {
            equal(
              markdownToHtml('- foo\n  - bar\n\n\n  baz\n'),
              '<ul>\n<li>\n<p>foo</p>\n<ul>\n<li>bar</li>\n</ul>\n<p>baz</p>\n</li>\n</ul>\n'
            );
          }
        );

        test(
          'looseListItem',
          (ctx) => {
            equal(
              markdownToHtml('- one\n\n  two\n'),
              '<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>\n'
            );
          }
        );

        test(
          'tightWithBlankLineAfter',
          (ctx) => {
            equal(
              markdownToHtml('- foo\n- bar\n\n'),
              '<ul>\n<li>foo</li>\n<li>bar</li>\n</ul>\n'
            );
          }
        );

        test(
          'tightListWithCodeBlock',
          (ctx) => {
            equal(
              markdownToHtml('- a\n- ```\n  b\n\n\n  ```\n- c\n'),
              '<ul>\n<li>a</li>\n<li>\n<pre><code>b\n\n\n</code></pre>\n</li>\n<li>c</li>\n</ul>\n'
            );
          }
        );

        test(
          'tightListWithCodeBlock2',
          (ctx) => {
            equal(
              markdownToHtml('* foo\n  ```\n  bar\n\n  ```\n  baz\n'),
              '<ul>\n<li>foo\n<pre><code>bar\n\n</code></pre>\nbaz</li>\n</ul>\n'
            );
          }
        );

        test(
          'looseEmptyListItem',
          (ctx) => {
            equal(
              markdownToHtml('* a\n*\n\n* c'),
              '<ul>\n<li>\n<p>a</p>\n</li>\n<li></li>\n<li>\n<p>c</p>\n</li>\n</ul>\n'
            );
          }
        );

        test(
          'looseBlankLineAfterCodeBlock',
          (ctx) => {
            equal(
              markdownToHtml('1. ```\n   foo\n   ```\n\n   bar\n'),
              '<ol>\n<li>\n<pre><code>foo\n</code></pre>\n<p>bar</p>\n</li>\n</ol>\n'
            );
          }
        );

        test(
          'looseBlankLineAfterHtmlBlock',
          (ctx) => {
            equal(
              markdownToHtml('- <!-- comment -->\n\n  bar\n'),
              '<ul>\n<li>\n<!-- comment -->\n<p>bar</p>\n</li>\n</ul>\n'
            );
          }
        );

        test(
          'looseBlankLineAfterIndentedCodeBlock',
          (ctx) => {
            equal(
              markdownToHtml('-     foo\n\n  bar\n'),
              '<ul>\n<li>\n<pre><code>foo\n</code></pre>\n<p>bar</p>\n</li>\n</ul>\n'
            );
          }
        );

        test(
          'looseBlankLineAfterSetextHeading',
          (ctx) => {
            equal(
              markdownToHtml('- foo\n  -\n\n  bar\n'),
              '<ul>\n<li>\n<h2>foo</h2>\n<p>bar</p>\n</li>\n</ul>\n'
            );
          }
        );

        test(
          'tightListWithIndentedCodeBlock',
          (ctx) => {
            equal(
              markdownToHtml('-     foo\n\n      bar\n  baz\n'),
              '<ul>\n<li>\n<pre><code>foo\n\nbar\n</code></pre>\nbaz</li>\n</ul>\n'
            );
          }
        );

        test(
          'tightOuterWithLooseNested',
          (ctx) => {
            equal(
              markdownToHtml('- a\n  - b\n\n    c\n  # d\n'),
              '<ul>\n<li>a\n<ul>\n<li>\n<p>b</p>\n<p>c</p>\n</li>\n</ul>\n<h1>d</h1>\n</li>\n</ul>\n'
            );
          }
        );
      }
    );

    suite(
      'ListBlockParserTest indentation',
      () => {
        test(
          'bullet and ordered list item continuation indents',
          (ctx) => {
            equal(
              markdownToHtml('   *    foo\n        bar\n'),
              '<ul>\n<li>foo\nbar</li>\n</ul>\n'
            );
            equal(
              markdownToHtml('*\tfoo\n    bar\n'),
              '<ul>\n<li>foo\nbar</li>\n</ul>\n'
            );
            equal(
              markdownToHtml('1.\tfoo\n    bar\n'),
              '<ol>\n<li>foo\nbar</li>\n</ol>\n'
            );
          }
        );
      }
    );
  }
);
