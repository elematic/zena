/**
 * GFM pipe table tests ported from `commonmark-java` (`TablesTest`).
 */

import {GrowableArray} from 'zena:core';
import {suite, test, TestContext} from 'zena:test';
import {equal} from 'zena:assert';
import {markdownToHtml, tablesExtension, MarkdownExtension} from 'markdown:index';

function renderTable(md: String) {
  let exts = new GrowableArray<MarkdownExtension>(1);
  exts.push(tablesExtension());
  return markdownToHtml(md, { extensions: exts });
}

export let tests = suite(
  'GFM Tables (ported from commonmark-java)',
  () => {
    test(
      'mustHaveHeaderAndSeparator',
      (ctx) => {
        equal(renderTable('Abc|Def'), '<p>Abc|Def</p>\n');
        equal(renderTable('Abc | Def'), '<p>Abc | Def</p>\n');
      }
    );

    test(
      'separatorMustBeOneOrMore',
      (ctx) => {
        let expected = '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n</table>\n';
        equal(renderTable('Abc|Def\n-|-\n'), expected);
        equal(renderTable('Abc|Def\n--|--\n'), expected);
      }
    );

    test(
      'separatorMustNotContainInvalidChars',
      (ctx) => {
        equal(renderTable('Abc|Def\n|-a-|---\n'), '<p>Abc|Def\n|-a-|---</p>\n');
        equal(
          renderTable('Abc|Def\n|:--a|---\n'),
          '<p>Abc|Def\n|:--a|---</p>\n'
        );
        equal(
          renderTable('Abc|Def\n|:--a--:|---\n'),
          '<p>Abc|Def\n|:--a--:|---</p>\n'
        );
      }
    );

    test(
      'separatorCanHaveLeadingSpaceThenPipe',
      (ctx) => {
        equal(
          renderTable('Abc|Def\n |---|---\n'),
          '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n</table>\n'
        );
      }
    );

    test(
      'separatorCanNotHaveAdjacentPipes',
      (ctx) => {
        equal(renderTable('Abc|Def\n---||---\n'), '<p>Abc|Def\n---||---</p>\n');
      }
    );

    test(
      'separatorNeedsPipes',
      (ctx) => {
        equal(renderTable('Abc|Def\n|--- ---\n'), '<p>Abc|Def\n|--- ---</p>\n');
      }
    );

    test(
      'oneHeadNoBody',
      (ctx) => {
        equal(
          renderTable('Abc|Def\n---|---\n'),
          '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n</table>\n'
        );
      }
    );

    test(
      'oneColumnOneHeadNoBody',
      (ctx) => {
        let expected = '<table>\n<thead>\n<tr>\n<th>Abc</th>\n</tr>\n</thead>\n</table>\n';
        equal(renderTable('|Abc\n|---\n'), expected);
        equal(renderTable('|Abc|\n|---|\n'), expected);
        equal(renderTable('Abc|\n---|\n'), expected);
        // Pipe required on separator
        equal(renderTable('|Abc\n---\n'), '<h2>|Abc</h2>\n');
        // Pipe required on head
        equal(renderTable('Abc\n|---\n'), '<p>Abc\n|---</p>\n');
      }
    );

    test(
      'oneColumnOneHeadOneBody',
      (ctx) => {
        let expected = '<table>\n<thead>\n<tr>\n<th>Abc</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n</tr>\n</tbody>\n</table>\n';
        equal(renderTable('|Abc\n|---\n|1\n'), expected);
        equal(renderTable('|Abc|\n|---|\n|1|\n'), expected);
        equal(renderTable('Abc|\n---|\n1|\n'), expected);
        equal(renderTable('|Abc\n---\n|1\n'), '<h2>|Abc</h2>\n<p>|1</p>\n');
      }
    );

    test(
      'oneHeadOneBody and spaceBeforeSeparator',
      (ctx) => {
        let expected = '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n';
        equal(renderTable('Abc|Def\n---|---\n1|2\n'), expected);
        equal(renderTable('  |Abc|Def|\n|---|---|\n|1|2|\n'), expected);
      }
    );

    test(
      'separatorMustNotHaveLessPartsThanHead',
      (ctx) => {
        equal(
          renderTable('Abc|Def|Ghi\n---|---\n1|2|3\n'),
          '<p>Abc|Def|Ghi\n---|---\n1|2|3</p>\n'
        );
      }
    );

    test(
      'padding and paddingWithCodeBlockIndentation',
      (ctx) => {
        let expected = '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n';
        equal(renderTable(' Abc  | Def \n --- | --- \n 1 | 2 \n'), expected);
        equal(renderTable('Abc|Def\n---|---\n    1|2\n'), expected);
        equal(renderTable('|Abc|Def|\n|---|---|\n|1|2|\n'), expected);
        equal(renderTable('|Abc|Def| \n|---|---|\n|1|2|\n'), expected);
      }
    );

    test(
      'pipesOnOutsideZeroLengthHeaders',
      (ctx) => {
        equal(
          renderTable(
            '||center header||\n-|-------------|-\n1|      2      |3\n'
          ),
          '<table>\n<thead>\n<tr>\n<th></th>\n<th>center header</th>\n<th></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n<td>3</td>\n</tr>\n</tbody>\n</table>\n'
        );
      }
    );

    test(
      'inlineElements',
      (ctx) => {
        equal(
          renderTable('*Abc*|Def\n---|---\n1|2\n'),
          '<table>\n<thead>\n<tr>\n<th><em>Abc</em></th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n'
        );
      }
    );

    test(
      'escapedPipe, escapedBackslash, escapedOther, and backslashAtEnd',
      (ctx) => {
        equal(
          renderTable('Abc|Def\n---|---\n1\\|2|20\n'),
          '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1|2</td>\n<td>20</td>\n</tr>\n</tbody>\n</table>\n'
        );
        equal(
          renderTable('Abc|Def\n---|---\n1\\\\|2\n'),
          '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1|2</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n'
        );
        equal(
          renderTable('Abc|Def\n---|---\n1|\\`not code`\n'),
          '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>`not code`</td>\n</tr>\n</tbody>\n</table>\n'
        );
        equal(
          renderTable('Abc|Def\n---|---\n1|2\\\n'),
          '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2\\</td>\n</tr>\n</tbody>\n</table>\n'
        );
      }
    );

    test(
      'alignLeft, alignRight, alignCenter, and alignLeftWithSpaces',
      (ctx) => {
        let leftExpected = '<table>\n<thead>\n<tr>\n<th align="left">Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align="left">1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n';
        equal(renderTable('Abc|Def\n:-|- \n1|2\n'), leftExpected);
        equal(renderTable('Abc|Def\n:---|---\n1|2\n'), leftExpected);
        equal(renderTable('Abc|Def\n :--- |---\n1|2\n'), leftExpected);

        let rightExpected = '<table>\n<thead>\n<tr>\n<th align="right">Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align="right">1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n';
        equal(renderTable('Abc|Def\n-:|-\n1|2\n'), rightExpected);
        equal(renderTable('Abc|Def\n--:|--\n1|2\n'), rightExpected);
        equal(renderTable('Abc|Def\n---:|---\n1|2\n'), rightExpected);

        let centerExpected = '<table>\n<thead>\n<tr>\n<th align="center">Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align="center">1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n';
        equal(renderTable('Abc|Def\n:-:|-\n1|2\n'), centerExpected);
        equal(renderTable('Abc|Def\n:--:|--\n1|2\n'), centerExpected);
        equal(renderTable('Abc|Def\n:---:|---\n1|2\n'), centerExpected);

        equal(
          renderTable('Abc|Def\n---|:---:\n1|2\n'),
          '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th align="center">Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td align="center">2</td>\n</tr>\n</tbody>\n</table>\n'
        );
      }
    );

    test(
      'alignmentMarkerMustBeNextToDashes',
      (ctx) => {
        equal(
          renderTable('Abc|Def\n: ---|---\n'),
          '<p>Abc|Def\n: ---|---</p>\n'
        );
        equal(
          renderTable('Abc|Def\n--- :|---\n'),
          '<p>Abc|Def\n--- :|---</p>\n'
        );
        equal(
          renderTable('Abc|Def\n---|: ---\n'),
          '<p>Abc|Def\n---|: ---</p>\n'
        );
        equal(
          renderTable('Abc|Def\n---|--- :\n'),
          '<p>Abc|Def\n---|--- :</p>\n'
        );
      }
    );

    test(
      'bodyCanNotHaveMoreColumnsThanHead and bodyWithFewerColumnsThanHead',
      (ctx) => {
        equal(
          renderTable('Abc|Def\n---|---\n1|2|3\n'),
          '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n'
        );
        equal(
          renderTable('Abc|Def|Ghi\n---|---|---\n1|2\n'),
          '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n<th>Ghi</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n'
        );
      }
    );

    test(
      'insideBlockQuote',
      (ctx) => {
        equal(
          renderTable('> Abc|Def\n> ---|---\n> 1|2\n'),
          '<blockquote>\n<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n</blockquote>\n'
        );
      }
    );

    test(
      'tableWithLazyContinuationLine',
      (ctx) => {
        equal(
          renderTable('Abc|Def\n---|---\n1|2\nlazy\n'),
          '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n<tr>\n<td>lazy</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n'
        );
      }
    );

    test(
      'issue142 empty leading cell and trailing empty cell',
      (ctx) => {
        equal(
          renderTable(
            '||Alveolar|Bilabial\n|:--|:-:|:-:\n|**Plosive**|t, d|b\n|**Tap**|ɾ|'
          ),
          '<table>\n<thead>\n<tr>\n<th align="left"></th>\n<th align="center">Alveolar</th>\n<th align="center">Bilabial</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align="left"><strong>Plosive</strong></td>\n<td align="center">t, d</td>\n<td align="center">b</td>\n</tr>\n<tr>\n<td align="left"><strong>Tap</strong></td>\n<td align="center">ɾ</td>\n<td align="center"></td>\n</tr>\n</tbody>\n</table>\n'
        );
      }
    );

    test(
      'danglingPipe',
      (ctx) => {
        let expected = '<table>\n<thead>\n<tr>\n<th>Abc</th>\n<th>Def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n<p>|</p>\n';
        equal(renderTable('Abc|Def\n---|---\n1|2\n|\n'), expected);
        equal(renderTable('Abc|Def\n---|---\n1|2\n  |  \n'), expected);
      }
    );

    test(
      'interruptsParagraph',
      (ctx) => {
        equal(
          renderTable('text\n|a  |\n|---|\n|b  |\n'),
          '<p>text</p>\n<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b</td>\n</tr>\n</tbody>\n</table>\n'
        );
      }
    );
  }
);
