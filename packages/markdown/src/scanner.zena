/**
 * UTF-8 byte-scanning helpers, CommonMark character classifications, HTML
 * character reference decoding, backslash unescaping, and link component
 * scanners.
 */

import { StringBuilder } from 'zena:core';

/**
 * Whether `b` is a space (`0x20`) or tab (`0x09`).
 */
export function isSpaceOrTab(b: i32): boolean {
  return b == 0x20 || b == 0x09;
}

/**
 * Whether `b` is an ASCII whitespace byte (` `, `\t`, `\n`, `\r`, `\f`, `\v`).
 */
export function isWhitespaceByte(b: i32): boolean {
  return b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0D || b == 0x0C || b == 0x0B;
}

/**
 * Whether `b` is a CommonMark ASCII punctuation character:
 * `! " # $ % & ' ( ) * + , - . / : ; < = > ? @ [ \ ] ^ _ ` { | } ~`
 */
export function isAsciiPunctuation(b: i32): boolean {
  return (b >= 0x21 && b <= 0x2F) ||
      (b >= 0x3A && b <= 0x40) ||
      (b >= 0x5B && b <= 0x60) ||
      (b >= 0x7B && b <= 0x7E);
}

/**
 * Whether `b` is an ASCII letter (`A-Z` or `a-z`).
 */
export function isAsciiLetter(b: i32): boolean {
  return (b >= 0x41 && b <= 0x5A) || (b >= 0x61 && b <= 0x7A);
}

/**
 * Whether `b` is an ASCII decimal digit (`0-9`).
 */
export function isAsciiDigit(b: i32): boolean {
  return b >= 0x30 && b <= 0x39;
}

/**
 * Whether `b` is an ASCII letter or digit.
 */
export function isAsciiAlphanumeric(b: i32): boolean {
  return isAsciiLetter(b) || isAsciiDigit(b);
}

/**
 * Whether `b` is an ASCII hexadecimal digit (`0-9`, `A-F`, `a-f`).
 */
export function isHexDigit(b: i32): boolean {
  return isAsciiDigit(b) || (b >= 0x41 && b <= 0x46) || (b >= 0x61 && b <= 0x66);
}

/**
 * Numeric value (`0..15`) of a valid hex digit byte `b`.
 */
export function hexValue(b: i32): i32 {
  if (b >= 0x30 && b <= 0x39) {
    return b - 0x30;
  }
  if (b >= 0x41 && b <= 0x46) {
    return b - 0x41 + 10;
  }
  return b - 0x61 + 10;
}

/**
 * Converts an uppercase ASCII letter byte to lowercase.
 */
export function toLowerAsciiByte(b: i32): i32 {
  if (b >= 0x41 && b <= 0x5A) {
    return b + 32;
  }
  return b;
}

/**
 * Returns `s` with uppercase ASCII letters converted to lowercase.
 */
export function toLowerAscii(s: String): String {
  let len = s.length;
  var hasUpper = false;
  var i = 0;
  while (i < len) {
    let b = s.getByteAt(i);
    if (b >= 0x41 && b <= 0x5A) {
      hasUpper = true;
      break;
    }
    i += 1;
  }
  if (!hasUpper) {
    return s;
  }
  let sb = new StringBuilder(len);
  var j = 0;
  while (j < len) {
    sb.appendByte(toLowerAsciiByte(s.getByteAt(j)));
    j += 1;
  }
  return sb.toString();
}

/**
 * Decodes the Unicode scalar value at byte offset `index` in `s`, or returns
 * `0x20` (space) when `index` is out of bounds.
 */
export function codePointAtByte(s: String, index: i32): i32 {
  let len = s.length;
  if (index < 0 || index >= len) {
    return 0x20;
  }
  let b0 = s.getByteAt(index);
  if ((b0 & 0x80) == 0) {
    return b0;
  }
  if ((b0 & 0xE0) == 0xC0 && index + 1 < len) {
    let b1 = s.getByteAt(index + 1);
    return ((b0 & 0x1F) << 6) | (b1 & 0x3F);
  }
  if ((b0 & 0xF0) == 0xE0 && index + 2 < len) {
    let b1 = s.getByteAt(index + 1);
    let b2 = s.getByteAt(index + 2);
    return ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
  }
  if ((b0 & 0xF8) == 0xF0 && index + 3 < len) {
    let b1 = s.getByteAt(index + 1);
    let b2 = s.getByteAt(index + 2);
    let b3 = s.getByteAt(index + 3);
    return ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F);
  }
  return b0;
}

/**
 * Decodes the Unicode scalar value ending at byte offset `index` in `s`, or
 * returns `0x20` (space) when `index <= 0`.
 */
export function codePointBeforeByte(s: String, index: i32): i32 {
  if (index <= 0 || index > s.length) {
    return 0x20;
  }
  var start = index - 1;
  while (start > 0 && (s.getByteAt(start) & 0xC0) == 0x80) {
    start -= 1;
  }
  return codePointAtByte(s, start);
}

/**
 * Whether `cp` is Unicode whitespace per CommonMark 2.1 (ASCII whitespace,
 * `U+00A0`, `U+1680`, `U+2000..U+200A`, `U+202F`, `U+205F`, `U+3000`).
 */
export function isUnicodeWhitespace(cp: i32): boolean {
  if (cp < 0x80) {
    return isWhitespaceByte(cp);
  }
  return cp == 0x00A0 ||
      cp == 0x1680 ||
      (cp >= 0x2000 && cp <= 0x200A) ||
      cp == 0x202F ||
      cp == 0x205F ||
      cp == 0x3000;
}

/**
 * Whether `cp` is ASCII or common Unicode punctuation or symbol for CommonMark
 * flanking delimiter rules.
 */
export function isUnicodePunctuation(cp: i32): boolean {
  if (cp < 0x80) {
    return isAsciiPunctuation(cp);
  }
  // Latin-1 punctuation and symbols (U+00A1..U+00BF, excluding U+00AA and U+00BA)
  if (cp >= 0x00A1 && cp <= 0x00BF) {
    return cp != 0x00AA && cp != 0x00B5 && cp != 0x00BA;
  }
  // General Punctuation (U+2010..U+2027, U+2030..U+205E)
  if ((cp >= 0x2010 && cp <= 0x2027) || (cp >= 0x2030 && cp <= 0x205E)) {
    return true;
  }
  // Currency, Supplemental Punctuation, CJK Punctuation
  return (cp >= 0x20A0 && cp <= 0x20CF) ||
      (cp >= 0x2E00 && cp <= 0x2E7F) ||
      (cp >= 0x3001 && cp <= 0x303F);
}

/**
 * Strips leading and trailing spaces (`0x20`) and tabs (`0x09`).
 */
export function trimSpaces(s: String): String {
  var start = 0;
  var end = s.length;
  while (start < end && isSpaceOrTab(s.getByteAt(start))) {
    start += 1;
  }
  while (end > start && isSpaceOrTab(s.getByteAt(end - 1))) {
    end -= 1;
  }
  if (start == 0 && end == s.length) {
    return s;
  }
  return s.sliceBytes(start, end);
}

/**
 * Strips leading and trailing ASCII whitespace (` `, `\t`, `\n`, `\r`).
 */
export function trimWhitespace(s: String): String {
  var start = 0;
  var end = s.length;
  while (start < end && isWhitespaceByte(s.getByteAt(start))) {
    start += 1;
  }
  while (end > start && isWhitespaceByte(s.getByteAt(end - 1))) {
    end -= 1;
  }
  if (start == 0 && end == s.length) {
    return s;
  }
  return s.sliceBytes(start, end);
}

/**
 * Advances `index` past spaces and tabs on a single line.
 */
export function skipSpacesAndTabs(s: String, index: i32, end: i32): i32 {
  var i = index;
  while (i < end && isSpaceOrTab(s.getByteAt(i))) {
    i += 1;
  }
  return i;
}

/**
 * Advances `index` past spaces, tabs, and at most one line ending (`\r\n` or `\n`).
 */
export function skipSpacesAndOneLineEnd(s: String, index: i32, end: i32): i32 {
  var i = skipSpacesAndTabs(s, index, end);
  if (i < end) {
    let b = s.getByteAt(i);
    if (b == 0x0D) {
      i += 1;
      if (i < end && s.getByteAt(i) == 0x0A) {
        i += 1;
      }
      i = skipSpacesAndTabs(s, i, end);
    } else if (b == 0x0A) {
      i += 1;
      i = skipSpacesAndTabs(s, i, end);
    }
  }
  return i;
}

/**
 * Normalizes a link reference label: trims surrounding whitespace, collapses
 * internal whitespace runs to a single space (`0x20`), and folds case.
 * Returns an empty string if the label contains no non-whitespace characters.
 */
export function normalizeLinkLabel(raw: String): String {
  let trimmed = trimWhitespace(raw);
  if (trimmed.length == 0) {
    return '';
  }
  let sb = new StringBuilder(trimmed.length);
  var inSpace = false;
  var i = 0;
  let len = trimmed.length;
  while (i < len) {
    let b = trimmed.getByteAt(i);
    if (isWhitespaceByte(b)) {
      if (!inSpace) {
        sb.appendByte(0x20);
        inSpace = true;
      }
    } else {
      sb.appendByte(toLowerAsciiByte(b));
      inSpace = false;
    }
    i += 1;
  }
  return sb.toString();
}

/**
 * Appends Unicode scalar value `codePoint` as UTF-8 bytes to `sb`.
 * Out-of-range, surrogate, and zero code points are replaced with `U+FFFD`.
 */
export function appendCodePointUtf8(sb: StringBuilder, codePoint: i32): void {
  var cp = codePoint;
  if (cp <= 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) {
    cp = 0xFFFD;
  }
  if (cp < 0x80) {
    sb.appendByte(cp);
  } else if (cp < 0x800) {
    sb.appendByte(0xC0 | (cp >> 6));
    sb.appendByte(0x80 | (cp & 0x3F));
  } else if (cp < 0x10000) {
    sb.appendByte(0xE0 | (cp >> 12));
    sb.appendByte(0x80 | ((cp >> 6) & 0x3F));
    sb.appendByte(0x80 | (cp & 0x3F));
  } else {
    sb.appendByte(0xF0 | (cp >> 18));
    sb.appendByte(0x80 | ((cp >> 12) & 0x3F));
    sb.appendByte(0x80 | ((cp >> 6) & 0x3F));
    sb.appendByte(0x80 | (cp & 0x3F));
  }
}

/**
 * Resolves common named HTML entities (`&name;`) to their UTF-8 string value,
 * or returns `null` when `name` is unrecognized.
 */
function lookupNamedEntity(name: String): String | null {
  if (name == 'amp' || name == 'AMP') { return '&'; }
  if (name == 'lt' || name == 'LT') { return '<'; }
  if (name == 'gt' || name == 'GT') { return '>'; }
  if (name == 'quot' || name == 'QUOT') { return '"'; }
  if (name == 'apos') { return "'"; }
  if (name == 'nbsp') { return String.fromCodePoint(0x00A0); }
  if (name == 'copy' || name == 'COPY') { return '©'; }
  if (name == 'reg' || name == 'REG') { return '®'; }
  if (name == 'trade' || name == 'TRADE') { return '™'; }
  if (name == 'mdash') { return '—'; }
  if (name == 'ndash') { return '–'; }
  if (name == 'hellip') { return '…'; }
  if (name == 'laquo') { return '«'; }
  if (name == 'raquo') { return '»'; }
  if (name == 'lsquo') { return '‘'; }
  if (name == 'rsquo') { return '’'; }
  if (name == 'ldquo') { return '“'; }
  if (name == 'rdquo') { return '”'; }
  if (name == 'bull') { return '•'; }
  if (name == 'middot') { return '·'; }
  if (name == 'sect') { return '§'; }
  if (name == 'para') { return '¶'; }
  if (name == 'deg') { return '°'; }
  if (name == 'plusmn') { return '±'; }
  if (name == 'times') { return '×'; }
  if (name == 'divide') { return '÷'; }
  if (name == 'euro') { return '€'; }
  if (name == 'pound') { return '£'; }
  if (name == 'yen') { return '¥'; }
  if (name == 'cent') { return '¢'; }
  if (name == 'larr') { return '←'; }
  if (name == 'rarr') { return '→'; }
  if (name == 'uarr') { return '↑'; }
  if (name == 'darr') { return '↓'; }
  if (name == 'harr') { return '↔'; }
  if (name == 'ZeroWidthSpace') { return String.fromCodePoint(0x200B); }
  if (name == 'ouml') { return 'ö'; }
  if (name == 'Ouml') { return 'Ö'; }
  if (name == 'auml') { return 'ä'; }
  if (name == 'Auml') { return 'Ä'; }
  if (name == 'uuml') { return 'ü'; }
  if (name == 'Uuml') { return 'Ü'; }
  if (name == 'eacute') { return 'é'; }
  if (name == 'Eacute') { return 'É'; }
  if (name == 'frac12') { return '½'; }
  if (name == 'frac14') { return '¼'; }
  if (name == 'frac34') { return '¾'; }
  return null;
}

/**
 * Attempts to decode an HTML character reference starting with `&` at `index`
 * in `s`. If valid, appends the decoded UTF-8 characters to `sb` and returns
 * the byte index past the closing `;`; otherwise returns `-1`.
 */
export function tryDecodeEntity(
  s: String,
  index: i32,
  sb: StringBuilder
): i32 {
  let len = s.length;
  if (index + 2 >= len || s.getByteAt(index) != 0x26) { // &
    return -1;
  }
  let next = s.getByteAt(index + 1);
  if (next == 0x23) { // #
    var i = index + 2;
    if (i >= len) {
      return -1;
    }
    let hexMarker = s.getByteAt(i);
    if (hexMarker == 0x78 || hexMarker == 0x58) { // x or X
      i += 1;
      let start = i;
      var value = 0;
      while (i < len && i - start < 6 && isHexDigit(s.getByteAt(i))) {
        value = (value << 4) | hexValue(s.getByteAt(i));
        i += 1;
      }
      if (i > start && i < len && s.getByteAt(i) == 0x3B) { // ;
        appendCodePointUtf8(sb, value);
        return i + 1;
      }
      return -1;
    }
    let start = i;
    var value = 0;
    while (i < len && i - start < 7 && isAsciiDigit(s.getByteAt(i))) {
      value = value * 10 + (s.getByteAt(i) - 0x30);
      i += 1;
    }
    if (i > start && i < len && s.getByteAt(i) == 0x3B) { // ;
      appendCodePointUtf8(sb, value);
      return i + 1;
    }
    return -1;
  }
  if (isAsciiLetter(next)) {
    var i = index + 1;
    while (i < len && i - (index + 1) < 32 && isAsciiAlphanumeric(s.getByteAt(i))) {
      i += 1;
    }
    if (i < len && s.getByteAt(i) == 0x3B) { // ;
      let name = s.sliceBytes(index + 1, i);
      let decoded = lookupNamedEntity(name);
      if (decoded != null) {
        sb.append(decoded);
        return i + 1;
      }
    }
  }
  return -1;
}

/**
 * Unescapes CommonMark backslash escapes (`\!`, `\*`, etc.) and HTML character
 * references (`&amp;`, `&#35;`, `&#x23;`) in `s`.
 */
export function unescapeString(s: String): String {
  let len = s.length;
  var hasEscapeOrEntity = false;
  var k = 0;
  while (k < len) {
    let b = s.getByteAt(k);
    if (b == 0x5C || b == 0x26) { // \ or &
      hasEscapeOrEntity = true;
      break;
    }
    k += 1;
  }
  if (!hasEscapeOrEntity) {
    return s;
  }
  let sb = new StringBuilder(len);
  var i = 0;
  while (i < len) {
    let b = s.getByteAt(i);
    if (b == 0x5C && i + 1 < len && isAsciiPunctuation(s.getByteAt(i + 1))) {
      sb.appendByte(s.getByteAt(i + 1));
      i += 2;
    } else if (b == 0x26) {
      let afterEntity = tryDecodeEntity(s, i, sb);
      if (afterEntity > i) {
        i = afterEntity;
      } else {
        sb.appendByte(b);
        i += 1;
      }
    } else {
      sb.appendByte(b);
      i += 1;
    }
  }
  return sb.toString();
}

/**
 * Scans a CommonMark link destination starting at `start` in `s`.
 * Returns `(matched, unescapedDestination, nextIndex)`.
 */
export function scanLinkDestination(
  s: String,
  start: i32,
  end: i32
): inline (boolean, String, i32) {
  if (start >= end) {
    return (false, '', start);
  }
  if (s.getByteAt(start) == 0x3C) { // <...>
    var i = start + 1;
    while (i < end) {
      let b = s.getByteAt(i);
      if (b == 0x0A || b == 0x0D || b == 0x3C) {
        return (false, '', start);
      }
      if (b == 0x3E) { // >
        let raw = s.sliceBytes(start + 1, i);
        return (true, unescapeString(raw), i + 1);
      }
      if (b == 0x5C && i + 1 < end && isAsciiPunctuation(s.getByteAt(i + 1))) {
        i += 2;
      } else {
        i += 1;
      }
    }
    return (false, '', start);
  }

  var i = start;
  var openParens = 0;
  while (i < end) {
    let b = s.getByteAt(i);
    if (b <= 0x20 || b == 0x7F) {
      break;
    }
    if (b == 0x5C && i + 1 < end && isAsciiPunctuation(s.getByteAt(i + 1))) {
      i += 2;
    } else if (b == 0x28) { // (
      openParens += 1;
      if (openParens > 32) {
        return (false, '', start);
      }
      i += 1;
    } else if (b == 0x29) { // )
      if (openParens == 0) {
        break;
      }
      openParens -= 1;
      i += 1;
    } else {
      i += 1;
    }
  }
  if (openParens != 0 || i == start) {
    return (false, '', start);
  }
  return (true, unescapeString(s.sliceBytes(start, i)), i);
}

/**
 * Scans a CommonMark link title (`"..."`, `'...'`, or `(...)`) starting at
 * `start` in `s`. Returns `(matched, unescapedTitle, nextIndex)`.
 */
export function scanLinkTitle(
  s: String,
  start: i32,
  end: i32
): inline (boolean, String, i32) {
  if (start >= end) {
    return (false, '', start);
  }
  let opener = s.getByteAt(start);
  var closer = 0;
  if (opener == 0x22) { // "
    closer = 0x22;
  } else if (opener == 0x27) { // '
    closer = 0x27;
  } else if (opener == 0x28) { // (
    closer = 0x29;
  } else {
    return (false, '', start);
  }

  var i = start + 1;
  while (i < end) {
    let b = s.getByteAt(i);
    if (b == closer) {
      let raw = s.sliceBytes(start + 1, i);
      return (true, unescapeString(raw), i + 1);
    }
    if (opener == 0x28 && b == 0x28) {
      // Unescaped '(' inside (...) title is disallowed
      return (false, '', start);
    }
    if (b == 0x5C && i + 1 < end && isAsciiPunctuation(s.getByteAt(i + 1))) {
      i += 2;
    } else {
      i += 1;
    }
  }
  return (false, '', start);
}

/**
 * Scans a link label `[...]` starting at `start` (where `s.getByteAt(start)`
 * is `[`). Returns `(matched, rawInterior, nextIndex)`.
 */
export function scanLinkLabel(
  s: String,
  start: i32,
  end: i32
): inline (boolean, String, i32) {
  if (start >= end || s.getByteAt(start) != 0x5B) { // [
    return (false, '', start);
  }
  var i = start + 1;
  while (i < end && i - (start + 1) <= 999) {
    let b = s.getByteAt(i);
    if (b == 0x5D) { // ]
      return (true, s.sliceBytes(start + 1, i), i + 1);
    }
    if (b == 0x5B) { // unescaped [
      return (false, '', start);
    }
    if (b == 0x5C && i + 1 < end && isAsciiPunctuation(s.getByteAt(i + 1))) {
      i += 2;
    } else {
      i += 1;
    }
  }
  return (false, '', start);
}
