/**
 * Convenience bundle combining the built-in GFM extensions, GitHub alerts, and
 * heading anchor slugs.
 */

import {GrowableArray} from 'zena:core';
import {MarkdownExtension} from '../plugin.zena';
import {strikethroughExtension} from './strikethrough.zena';
import {tablesExtension} from './tables.zena';
import {taskListExtension} from './task-list.zena';
import {autolinkExtension} from './autolink.zena';
import {alertsExtension} from './alerts.zena';
import {headingAnchorsExtension} from './heading-anchors.zena';

/**
 * Returns the standard GFM extensions (pipe tables, strikethrough, task list
 * items, and extended autolinks) plus GitHub alerts (`> [!NOTE]`, etc.).
 */
export function gfmExtensions(includeHeadingAnchors: boolean = false): GrowableArray<MarkdownExtension> {
  let exts = new GrowableArray<MarkdownExtension>(6);
  exts.push(tablesExtension());
  exts.push(strikethroughExtension());
  exts.push(taskListExtension());
  exts.push(autolinkExtension());
  exts.push(alertsExtension());
  if (includeHeadingAnchors) {
    exts.push(headingAnchorsExtension());
  }
  return exts;
}
