/**
 * Public entry point for `markdown`: CommonMark and GFM parser, AST, plugin
 * system, and HTML renderer.
 */

import { GrowableArray } from 'zena:core';
import { Document } from './ast.zena';
import { MarkdownExtension } from './plugin.zena';
import { parse } from './block-parser.zena';
import { HtmlRenderOptions, renderHtml } from './html.zena';

export * from './ast.zena';
export * from './plugin.zena';
export * from './block-parser.zena';
export * from './inline-parser.zena';
export * from './html.zena';
export * from './plugins/strikethrough.zena';
export * from './plugins/tables.zena';
export * from './plugins/task-list.zena';
export * from './plugins/autolink.zena';
export * from './plugins/alerts.zena';
export * from './plugins/heading-anchors.zena';
export * from './plugins/gfm.zena';

/**
 * Parses `source` as Markdown and renders it directly to HTML.
 */
export function markdownToHtml(
  source: String,
  options: HtmlRenderOptions = {}
): String {
  let {extensions = new GrowableArray<MarkdownExtension>(0)} = options;
  let doc = parse(source, extensions);
  return renderHtml(doc, options);
}
