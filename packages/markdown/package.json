{
  "name": "@zena-lang/markdown",
  "version": "0.0.1",
  "type": "module",
  "description": "CommonMark and GFM Markdown parser, AST, plugin system, and HTML renderer for Zena",
  "private": true,
  "scripts": {
    "test": "wireit"
  },
  "wireit": {
    "test": {
      "#command": "Runs the Markdown parser, plugin, and sanitization tests from the repository root.",
      "command": "cd ../.. && ./target/release/zena-cli test \"packages/markdown/zena/test/*_test.zena\"",
      "dependencies": [
        "../zena-cli:build",
        "../stdlib:lib"
      ],
      "files": [
        "zena/**/*.zena",
        "../stdlib/zena/**/*.zena",
        "../stdlib/stdlib-manifest.json",
        "../../zena-package.json",
        "zena/zena-package.json"
      ],
      "output": []
    }
  }
}
