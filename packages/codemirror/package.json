{
  "name": "@zena-lang/codemirror",
  "version": "0.0.1",
  "description": "Zena language support for CodeMirror 6: syntax highlighting, a hover tooltip, and themes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elematic/zena.git",
    "directory": "packages/codemirror"
  },
  "keywords": [
    "zena",
    "codemirror",
    "codemirror6",
    "syntax-highlighting"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/*"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc",
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "lib",
        "tsconfig.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    }
  },
  "dependencies": {
    "@codemirror/language": "^6.10.8",
    "@codemirror/view": "^6.36.3",
    "codemirror-elements": "^0.0.11",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "wireit": "^0.14.12"
  }
}
