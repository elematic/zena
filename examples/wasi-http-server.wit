// The world examples/wasi-http-server.zena is built against: the
// wasi:http service shape, the `handler` interface exported, with the
// interfaces the program calls imported by name. The stdlib's own
// `wasi:http/service` world reaches `types` only through what it
// `use`s, and a declared world must import what the program calls.
package example:wasi-http-server@1.0.0;

world wasi-http-server {
  import wasi:http/types@0.3.0;
  import wasi:cli/stdout@0.3.0;

  export wasi:http/handler@0.3.0;
}
