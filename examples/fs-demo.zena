/**
 * Filesystem Demo - Read and print a file
 *
 * Build:
 *   npm run zena -w @zena-lang/zena-cli -- build examples/fs-demo.zena --target component -o fs-demo.wasm
 *
 * Run:
 *   echo "Hello from the filesystem!" > hello.txt
 *   wasmtime run -S p3=y --dir . fs-demo.wasm
 *
 * Or in one step, on the zena host:
 *   npm run zena -w @zena-lang/zena-cli -- run examples/fs-demo.zena
 *
 * The --dir flag grants filesystem access. Syntax: --dir HOST_PATH[::GUEST_PATH]
 *   --dir .           Maps current dir to "." in guest
 *   --dir /tmp::/data Maps host /tmp to guest /data
 *
 * See: https://docs.wasmtime.dev/cli-options.html#--dir
 *
 * `zena:fs` is asynchronous: each call starts the host's file operation
 * and `await` resumes once it is done. The same functions exist with a
 * `Sync` suffix (`readFileSync`) for a synchronous `main`.
 */

import { readFile, exists } from 'zena:fs';

export async function main(): Future<i32> {
  let filename = "hello.txt";

  if (await exists(filename)) {
    let content = await readFile(filename);
    console.log("Contents of " + filename + ":");
    console.log(content);
  } else {
    console.log("File not found: " + filename);
    console.log("");
    console.log("Create it with: echo 'Hello from the filesystem!' > hello.txt");
    return 1;
  }

  return 0;
}
