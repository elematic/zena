{
  "name": "zena-hello",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // Without this rule wrangler has no loader for .wasm imports. The
  // module becomes a WebAssembly.Module, compiled at deploy time.
  "rules": [
    {"type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false},
  ],
  "durable_objects": {
    "bindings": [{"name": "COUNTER", "class_name": "Counter"}],
  },
  // SQLite-backed Durable Objects are the ones available on the free plan.
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Counter"]}],
}
