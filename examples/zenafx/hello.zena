// "Hello, world" in a card, centred in the window, drawn by a
// WebAssembly component.
//
// The component owns the tree and the text run, and the host owns the
// font engine, the flexbox solver and the rasterizer. Build it with
// `npm run build:example -w @zena-lang/zenafx`, which writes
// packages/zenafx/out/hello.wasm, and run it with `zfx --app` on that.
//
// Every `flex` value below writes all nine of its fields. That is what
// the WIT record costs today; docs/design/record-presence.md designs the
// presence-optional fields that would let a call site name the two it
// cares about.
import { Color, TextLook, Flex, Edges, BoxLook, Axis, Justify, Align,
         Length, LengthAuto, LengthPercent } from 'zenafx:ui/style';
import { Size, Rect } from 'zenafx:ui/geometry';
import { registerRun } from 'zenafx:host/text';
import { Node, solve, ContentBox, ContentText,
         MeasureRequest } from 'zenafx:host/layout';
import { Quad, Glyphs, Command, CommandQuad, CommandGlyphs,
         present } from 'zenafx:host/paint';
import { some, none } from 'zena:core';

let ink = new Color(0.10, 0.11, 0.13, 1.0);
let card = new Color(0.93, 0.95, 0.98, 1.0);
let edge = new Color(0.76, 0.81, 0.88, 1.0);

/// The text run, registered on the first frame and reused after it. A
/// run id stands for shaped text until it is released, so re-registering
/// it every frame would reshape the string for nothing.
var labelRun: u32 = 0;
var haveLabel = false;

/// Geometry with everything at its default but the fields named.
let box = (
  axis: Axis,
  justify: Justify,
  align: Align,
  padding: Edges,
  width: Length,
  height: Length,
): Flex => new Flex(axis, justify, align, 0.0, padding, width, height, 0.0, 1.0);

let noPadding = new Edges(0.0, 0.0, 0.0, 0.0);

export function render(width: f32, height: f32): void {
  if (!haveLabel) {
    labelRun = registerRun(
      'Hello, ZenaFX',
      new TextLook('system-ui', 32.0, 500 as u16, false, ink),
    );
    haveLabel = true;
  }

  // Three nodes in pre-order: a root filling the window and centring its
  // one child, a padded card, and the text.
  let nodes = [
    new Node(
      box(Axis.Column, Justify.Center, Align.Center, noPadding,
          new LengthPercent(100.0), new LengthPercent(100.0)),
      new ContentBox(),
      1,
      1,
    ),
    new Node(
      box(Axis.Column, Justify.Start, Align.Start,
          new Edges(24.0, 40.0, 24.0, 40.0), new LengthAuto(), new LengthAuto()),
      new ContentBox(),
      2,
      1,
    ),
    new Node(
      box(Axis.Column, Justify.Start, Align.Start, noPadding,
          new LengthAuto(), new LengthAuto()),
      new ContentText(labelRun),
      0,
      0,
    )
  ];

  let rects = solve(nodes, new Size(width, height));
  let text = rects[2];

  present([
    new CommandQuad(new Quad(
      rects[1],
      some(card),
      some(edge),
      1.0,
      12.0,
    )),
    new CommandGlyphs(new Glyphs(labelRun, text.x, text.y))
  ]);
}

/// A root is never embedded, so nothing calls this. The interface every
/// component exports has it, so it is answered honestly: the page fills
/// whatever it is given.
export function measure(request: MeasureRequest): Size {
  return new Size(0.0, 0.0);
}
