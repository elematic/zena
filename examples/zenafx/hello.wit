// The world of the ZenaFX hello-world application.
//
// `render` is scaffolding, not the design. §6.3 of
// docs/design/zenafx-ui.md has the root component driving the frame by
// awaiting `zenafx:host/surface`'s frame events, and the host entering
// only the root. Until there is a component tree to order updates
// across, the host calls `render` once per frame instead, which keeps
// this first component down to the three primitives it actually uses.
package example:hello@0.1.0;

world app {
  import zenafx:host/text@0.1.0;
  import zenafx:host/layout@0.1.0;
  import zenafx:host/paint@0.1.0;

  /// Draw one frame into a surface of this size, in physical pixels.
  export render: func(width: f32, height: f32);
}
