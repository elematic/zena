// The world of the ZenaFX hello-world application.
//
// `zenafx:host/widget`'s `render` is scaffolding, not the design. §6.3 of
// docs/design/zenafx-ui.md has the root component driving the frame by
// awaiting `zenafx:host/surface`'s frame events, and the host entering
// only the root. Until that exists the host calls `render` once per frame.
package example:hello@0.1.0;

world app {
  import zenafx:host/text@0.1.0;
  import zenafx:host/layout@0.1.0;
  import zenafx:host/paint@0.1.0;

  export zenafx:host/widget@0.1.0;
}
