/**
 * Two summaries, each showing and hiding the lines under it, worked from the
 * keyboard as well as with the pointer.
 */
import {
  ui, Widget, Box, Text, TemplateResult, Style,
  Justify, Align, Cursor, rgb, px, full, KeyAnswer, runApp,
} from '../ui.zena';
import { signal } from 'zena:signals';

let pageBg = rgb(0.98, 0.98, 0.99);
let ink = rgb(0.10, 0.11, 0.13);
let muted = rgb(0.36, 0.39, 0.46);
let paper = rgb(1.0, 1.0, 1.0);
let edge = rgb(0.80, 0.83, 0.89);
let hovered = rgb(0.94, 0.96, 1.0);
let pressed = rgb(0.88, 0.92, 1.0);
let ring = rgb(0.20, 0.38, 0.86);

let pageStyle: Style = {
  width: full,
  height: full,
  background: pageBg,
  justify: Justify.Center,
  align: Align.Center,
  gap: 16.0,
};

let disclosureStyle: Style = {
  width: px(320.0),
  align: Align.Stretch,
  gap: 6.0,
};

let summaryStyle: Style = {
  background: paper,
  borderColor: edge,
  borderWidth: 1.0,
  cornerRadius: 8.0,
  padding: { x: 16.0, y: 12.0 },
  cursor: Cursor.Pointer,
  hovered: { background: hovered },
  pressed: { background: pressed },
  focused: { borderColor: ring, borderWidth: 2.0 },
};

let bodyStyle: Style = {
  gap: 4.0,
  padding: { x: 16.0 },
};

let summaryText: Style = { fontSize: 16.0, fontWeight: 600, color: ink };
let lineText: Style = { fontSize: 15.0, color: muted };

/** One line of the content under a summary. */
class Line extends Widget {
  #says: String;

  new(says: String) : #says = says, super();

  build(): TemplateResult {
    return @ui Text(this.#says) { style: lineText };
  }
}

/** A summary, the lines under it, and whether they show. */
class Disclosure extends Widget {
  #summary: String;
  #lines: Array<Widget>;
  @signal var #open: boolean = false;

  new(summary: String, lines: Array<Widget>) : #summary = summary, #lines = lines, super();

  build(): TemplateResult {
    return @ui Box {
      style: disclosureStyle,

      Box {
        style: summaryStyle,
        focusable: true,
        onDown: () => { this.#toggle(); },
        onKey: (event) => {
          if (event.down && (event.key == 'Enter' || event.key == ' ')) {
            this.#toggle();
            return KeyAnswer.Used;
          }
          return KeyAnswer.Pass;
        },

        Text($(`${if (this.#open) '▾' else '▸'} ${this.#summary}`)) {
          style: summaryText,
        }
      }

      Box {
        style: bodyStyle,

        $(if (this.#open) { this.#lines } else { null })
      }
    };
  }

  #toggle(): void {
    this.#open = !this.#open;
  }
}

class Page extends Widget {
  build(): TemplateResult {
    return @ui Box {
      style: pageStyle,

      Disclosure('Shipping', [
        new Line('Sent within two working days.'),
        new Line('Tracked, and signed for on arrival.'),
      ])
      Disclosure('Returns', [
        new Line('Within thirty days, in its box.'),
      ])
    };
  }
}

export function main(): void {
  runApp(new Page());
}
