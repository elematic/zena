/**
 * A list longer than the box it is in, and a line saying which row was pressed.
 *
 * The list's box says that what does not fit in it scrolls. Scrolling and row
 * hover highlighting stay completely inside the native core + platform style
 * engine without waking the component.
 */
import {
  ui, Widget, Box, Text, TemplateResult,
  Style, When, hovered,
  Justify, Align, Overflow,
  rgb, px, full, runApp,
} from '../ui.zena';
import { signal } from 'zena:signals';

let pageBg = rgb(0.98, 0.98, 0.99);
let ink = rgb(0.10, 0.11, 0.13);
let muted = rgb(0.42, 0.45, 0.52);
let paper = rgb(1.0, 1.0, 1.0);
let edge = rgb(0.78, 0.82, 0.90);
let hoveredBg = rgb(0.90, 0.93, 0.99);

let rowCount = 40;

let pageStyle = Style {
  background: pageBg
  justify: Justify.Center
  align: Align.Center
  gap: 16.0
  width: full
  height: full
};

let listStyle = Style {
  background: paper
  borderColor: edge
  borderWidth: 1.0
  cornerRadius: 8.0
  align: Align.Stretch
  width: px(280.0)
  height: px(240.0)
  overflowY: Overflow.Scroll
};

let rowStyle = Style {
  background: paper
  padding: { y: 10.0, x: 16.0 }
  shrink: 0.0

  When(hovered) { background: hoveredBg }
};

let rowTextStyle = Style { fontSize: 16.0 fontWeight: 400 color: ink };
let chosenTextStyle = Style { fontSize: 15.0 fontWeight: 500 color: muted };

/** One row: a number, and what to do when it is pressed. */
class Row extends Widget {
  #number: i32;
  #pressed: (row: i32) => void;

  new(number: i32, pressed: (row: i32) => void)
      : #number = number, #pressed = pressed, super();

  build(): TemplateResult {
    return @ui Box {
      style: rowStyle,
      onDown: () => { this.#pressed(this.#number); },
      Text(`Row ${this.#number}`) { style: rowTextStyle }
    };
  }
}

class Page extends Widget {
  @signal var #chosen: i32 = 0;

  build(): TemplateResult {
    let rows = new GrowableArray<Widget>();
    for (let number in 1..(rowCount + 1)) {
      rows.push(new Row(number, (row) => {
        this.#chosen = row;
      }));
    }
    return @ui Box {
      style: pageStyle,
      Text($(if (this.#chosen == 0) { 'Nothing chosen' } else { `Chose row ${this.#chosen}` })) {
        style: chosenTextStyle
      }
      Box {
        style: listStyle,
        $(rows)
      }
    };
  }
}

export function main(): void {
  runApp(new Page());
}
