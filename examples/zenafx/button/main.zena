/**
 * A count, and a button that adds one to it.
 *
 * Pressing the button increments the reactive count above it, the button
 * changes colour while hovered or pressed entirely in the host, and pressing
 * anywhere else on the page sets the count back to zero.
 */
import {
  Color, BoxStyle, TextStyle, Edges, Justify, Align,
} from 'zenafx:ui/style';
import { ui, Widget, Box, Text, TemplateResult, full, runApp } from '../ui.zena';
import { signal } from 'zena:signals';
import { some, none } from 'zena:core';

let page = new Color(0.98, 0.98, 0.99, 1.0);
let ink = new Color(0.10, 0.11, 0.13, 1.0);
let paper = new Color(1.0, 1.0, 1.0, 1.0);
let resting = new Color(0.20, 0.38, 0.86, 1.0);
let hovered = new Color(0.31, 0.49, 0.95, 1.0);
let pressed = new Color(0.13, 0.27, 0.66, 1.0);

let pageStyle = new BoxStyle(some(page), none, 0.0, 0.0, 1.0);
let restingStyle = new BoxStyle(some(resting), none, 0.0, 10.0, 1.0);
let hoveredStyle = new BoxStyle(some(hovered), none, 0.0, 10.0, 1.0);
let pressedStyle = new BoxStyle(some(pressed), none, 0.0, 10.0, 1.0);
let countStyle = new TextStyle('system-ui', 64.0, 600 as u16, false, ink);
let labelStyle = new TextStyle('system-ui', 16.0, 600 as u16, false, paper);
let buttonPadding = new Edges(12.0, 24.0, 12.0, 24.0);

/**
 * A button: a label, and what to do when it is pressed.
 *
 * `hovered` and `pressed` fold into the template's state styles so the host
 * draws them without waking the component. `pressed` is listed after `hovered`
 * so it wins when both hold.
 */
class Button extends Widget {
  #label: String;
  #onPress: () => void;

  new(label: String, onPress: () => void) : #label = label, #onPress = onPress, super();

  build(): TemplateResult {
    return @ui Box {
      style: restingStyle,
      hovered: hoveredStyle,
      pressed: pressedStyle,
      padding: buttonPadding,
      justify: Justify.Center,
      align: Align.Center,
      onDown: () => { this.#onPress(); },

      Text(this.#label) { style: labelStyle }
    };
  }
}

/** The page: holds the reactive count and resets it on presses outside the button. */
class Page extends Widget {
  @signal var #count: i32 = 0;

  build(): TemplateResult {
    return @ui Box {
      width: full,
      height: full,
      style: pageStyle,
      justify: Justify.Center,
      align: Align.Center,
      gap: 24.0,
      onDown: () => { this.#count = 0; },

      Text($(`${this.#count}`)) { style: countStyle }
      Button('Add one', () => { this.#count += 1; })
    };
  }
}

export function main(): void {
  runApp(new Page());
}
