/**
 * A count, and a button that adds one to it.
 *
 * Pressing the button increments the reactive count above it, the button
 * changes colour while hovered or pressed entirely in the host, and pressing
 * anywhere else on the page sets the count back to zero.
 */
import {
  ui, Widget, Box, Text, TemplateResult,
  Style, When, hovered, pressed,
  Justify, Align, rgb, full, runApp,
} from '../ui.zena';
import { signal } from 'zena:signals';

let pageBg = rgb(0.98, 0.98, 0.99);
let ink = rgb(0.10, 0.11, 0.13);
let paper = rgb(1.0, 1.0, 1.0);
let resting = rgb(0.20, 0.38, 0.86);
let hoveredBg = rgb(0.31, 0.49, 0.95);
let pressedBg = rgb(0.13, 0.27, 0.66);

let centeredPage = Style {
  width: full
  height: full
  justify: Justify.Center
  align: Align.Center
};

let pageStyle = Style {
  ...centeredPage
  background: pageBg
  gap: 24.0
};

let buttonStyle = Style {
  background: resting
  cornerRadius: 10.0
  padding: { x: 24.0, y: 12.0 }
  justify: Justify.Center
  align: Align.Center

  When(hovered) { background: hoveredBg }
  When(pressed) { background: pressedBg }
};

let countStyle = Style { fontSize: 64.0 fontWeight: 600 color: ink };
let labelStyle = Style { fontSize: 16.0 fontWeight: 600 color: paper };

/**
 * A button: a label, and what to do when it is pressed.
 *
 * `When(hovered)` and `When(pressed)` inside `buttonStyle` fold into the
 * template's state styles so the host draws them without waking the component.
 */
class Button extends Widget {
  #label: String;
  #onPress: () => void;

  new(label: String, onPress: () => void) : #label = label, #onPress = onPress, super();

  build(): TemplateResult {
    return @ui Box {
      style: buttonStyle,
      onDown: () => { this.#onPress(); },

      Text(this.#label) { style: labelStyle }
    };
  }
}

/** The page: holds the reactive count and resets it on presses outside the button. */
class Page extends Widget {
  @signal var #count: i32 = 0;

  build(): TemplateResult {
    return @ui Box {
      style: pageStyle,
      onDown: () => { this.#count = 0; },

      Text($(`${this.#count}`)) { style: countStyle }
      Button('Add one', () => { this.#count += 1; })
    };
  }
}

export function main(): void {
  runApp(new Page());
}
