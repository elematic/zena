/**
 * A page of text that can be selected and copied, a button whose label
 * cannot, and a field to paste into.
 */
import {
  ui, Widget, Box, Text, TemplateResult,
  Style, When, hovered, pressed,
  Justify, Align, Cursor, rgb, px, full, runApp,
} from '../ui.zena';
import { signal } from 'zena:signals';
import { TextInput } from '../input/text-input.zena';

let pageBg = rgb(0.97, 0.97, 0.98);
let ink = rgb(0.10, 0.11, 0.13);
let muted = rgb(0.36, 0.39, 0.46);
let white = rgb(1.0, 1.0, 1.0);
let accent = rgb(0.20, 0.38, 0.86);
let accentHovered = rgb(0.26, 0.45, 0.93);
let accentPressed = rgb(0.15, 0.30, 0.72);

let pageStyle = Style {
  background: pageBg
  justify: Justify.Center
  align: Align.Center
  width: full
  height: full
};

let columnStyle = Style {
  align: Align.Stretch
  gap: 14.0
  width: px(460.0)
};

let buttonStyle = Style {
  background: accent
  cornerRadius: 6.0
  justify: Justify.Center
  align: Align.Center
  padding: { y: 9.0, x: 18.0 }
  cursor: Cursor.Pointer
  unselectable: true

  When(hovered) { background: accentHovered }
  When(pressed) { background: accentPressed }
};

let titleStyle = Style { fontSize: 22.0 fontWeight: 700 color: ink };
let bodyStyle = Style { fontSize: 16.0 fontWeight: 400 color: ink };
let noteStyle = Style { fontSize: 13.0 fontWeight: 600 color: muted };
let buttonTextStyle = Style { fontSize: 15.0 fontWeight: 600 color: white };

class Counter extends Widget {
  @signal var #count: i32 = 0;

  build(): TemplateResult {
    return @ui Box {
      style: buttonStyle,
      onDown: () => { this.#count += 1; },
      Text($(`Pressed ${this.#count} times`)) { style: buttonTextStyle }
    };
  }
}

class Page extends Widget {
  @signal var #echo: String = 'The field is empty.';

  build(): TemplateResult {
    return @ui Box {
      style: pageStyle,
      Box {
        style: columnStyle,
        Text('Select any of this') { style: titleStyle }
        Text(
          'Text in a ZenaFX window can be selected, as it can on a web page. ' +
          'Drag across it, or press twice on a word and three times for a paragraph.',
        ) { style: bodyStyle }
        Text(
          'Control with C copies what is selected, to paste anywhere. ' +
          'The component that drew this text is told none of it.',
        ) { style: bodyStyle }
        Counter {}
        Text('Paste here') { style: noteStyle }
        TextInput(
          'Control with V pastes',
          (said) => {
            this.#echo = if (said.isEmpty) { 'The field is empty.' } else { `The field says: ${said}` };
          },
          (said) => {},
        )
        Text($(this.#echo)) { style: noteStyle }
      }
    };
  }
}

export function main(): void {
  runApp(new Page());
}
