/**
 * A one-line text field built with `@ui` and the platform style engine.
 *
 * The text lives in a reactive `@signal`, keyboard edits query/update the
 * host's selection via `selectionAt` / `selectAt`, and hover/focus ring styles
 * run entirely in `zenafx:host/style`.
 */
import { KeyEvent } from 'zenafx:host/events';
import {
  ui, Widget, Box, Text, TemplateResult, KeyAnswer,
  Style, When, hovered, focused,
  Axis, Align, Overflow, Cursor, rgb,
} from '../ui.zena';
import { signal } from 'zena:signals';
import { Editing, oneLine } from './editing.zena';

let ink = rgb(0.10, 0.11, 0.13);
let faint = rgb(0.56, 0.59, 0.65);
let paper = rgb(1.0, 1.0, 1.0);
let edge = rgb(0.78, 0.81, 0.87);
let hoveredEdge = rgb(0.58, 0.62, 0.70);
let ring = rgb(0.20, 0.38, 0.86);

let fieldStyle = Style {
  background: paper
  borderColor: edge
  borderWidth: 1.0
  cornerRadius: 6.0
  axis: Axis.Row
  align: Align.Center
  padding: { y: 9.0, x: 12.0 }
  overflowX: Overflow.Hidden
  cursor: Cursor.Text

  When(hovered) { borderColor: hoveredEdge }
  When(focused) { borderColor: ring  borderWidth: 2.0 }
};

let valueStyle = Style { fontSize: 16.0 fontWeight: 400 color: ink shrink: 0.0 };
let placeholderStyle = Style { fontSize: 16.0 fontWeight: 400 color: faint shrink: 0.0 unselectable: true };

/** BFS position of the editable `Text` child inside `TextInput`'s template. */
let edited: u32 = 1;

/** A one-line text field. */
export class TextInput extends Widget {
  #placeholder: String;
  #onChange: (text: String) => void;
  #onSubmit: (text: String) => void;
  @signal var #text: String;

  new(
    placeholder: String,
    onChange: (text: String) => void,
    onSubmit: (text: String) => void,
    value: String = '',
  ) : #placeholder = placeholder,
      #onChange = onChange,
      #onSubmit = onSubmit,
      #text = value,
      super();

  value: String {
    get { return this.#text; }
  }

  build(): TemplateResult {
    return @ui Box {
      style: fieldStyle,
      focusable: true,
      onKey: (event) => this.#key(event),

      Text($(this.#text)) { editable: true, style: valueStyle }
      Text($(if (this.#text.isEmpty) { this.#placeholder } else { '' })) { style: placeholderStyle }
    };
  }

  #editing(): Editing {
    let end = this.#text.utf8.length;
    return match (this.selectionAt(edited)) {
      case (true, let anchor, let focus): new Editing(this.#text, anchor, focus)
      case (false, _, _): new Editing(this.#text, end, end)
    };
  }

  #key(event: KeyEvent): KeyAnswer {
    if (!event.down) {
      return KeyAnswer.Pass;
    }
    if (event.key == 'Enter') {
      this.#onSubmit(this.#text);
      return KeyAnswer.Used;
    }
    let held = event.modifiers;
    let before = this.#editing();
    var next: Editing | null = null;
    if (let Some {value} = event.text) {
      next = before.pressed({
        key: event.key,
        typed: oneLine(value),
        shift: held.shift,
        control: held.control,
        alt: held.alt,
        meta: held.meta,
      });
    } else {
      next = before.pressed({
        key: event.key,
        shift: held.shift,
        control: held.control,
        alt: held.alt,
        meta: held.meta,
      });
    }
    if (next == null) {
      return KeyAnswer.Pass;
    }
    if (next.text != before.text) {
      this.#text = next.text;
      this.#onChange(next.text);
    }
    this.selectAt(edited, next.anchor, next.focus);
    return KeyAnswer.Used;
  }
}
