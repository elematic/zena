/**
 * Two text fields and what was typed into them.
 *
 * The first field greets whoever is named in it, on every key. The second says
 * what was sent when Enter is pressed in it. `Tab` moves between the two, and
 * a press puts the caret where it lands.
 */
import {
  ui, Widget, Box, Text, TemplateResult,
  Style, Justify, Align, rgb, px, full, runApp,
} from '../ui.zena';
import { signal } from 'zena:signals';
import { TextInput } from './text-input.zena';

let pageBg = rgb(0.97, 0.97, 0.98);
let ink = rgb(0.10, 0.11, 0.13);
let muted = rgb(0.36, 0.39, 0.46);

let pageStyle = Style {
  background: pageBg
  justify: Justify.Center
  align: Align.Center
  width: full
  height: full
};

let formStyle = Style {
  align: Align.Stretch
  gap: 8.0
  width: px(320.0)
};

let labelStyle = Style { fontSize: 13.0 fontWeight: 600 color: muted };
let lineStyle = Style { fontSize: 16.0 fontWeight: 400 color: ink };

class Page extends Widget {
  @signal var #greeting: String = 'Hello.';
  @signal var #sent: String = 'Nothing sent yet.';

  build(): TemplateResult {
    return @ui Box {
      style: pageStyle,
      Box {
        style: formStyle,
        Text('Name') { style: labelStyle }
        TextInput(
          'Your name',
          (name) => {
            this.#greeting = if (name.isEmpty) { 'Hello.' } else { `Hello, ${name}.` };
          },
          (name) => {},
        )
        Text($(this.#greeting)) { style: lineStyle }
        Text('Message') { style: labelStyle }
        TextInput(
          'Enter sends it',
          (message) => {},
          (message) => {
            this.#sent = if (message.isEmpty) { 'Nothing to send.' } else { `Sent: ${message}` };
          },
        )
        Text($(this.#sent)) { style: lineStyle }
      }
    };
  }
}

export function main(): void {
  runApp(new Page());
}
