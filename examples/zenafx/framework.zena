/**
 * The in-component widget framework.
 *
 * A widget is one node of the scene and says what to show there: a template,
 * one value per hole in it, and the widgets to hang in its slots. Everything
 * else here is the bookkeeping that lets `render` be the only call — which
 * template has been sent, which hole values have changed, and which slot still
 * holds the children it held last time.
 *
 * Nothing in a widget refers to its parent. It is handed a node to live in and
 * never learns what contains it, which is what lets a tree of widgets be
 * described without a single parent pointer.
 *
 * The diff is here rather than in the host because every value crossing `render`
 * is marshalled: a value that compared equal is never encoded at all.
 *
 * A widget's handlers stay here too. A function cannot cross to the host, so
 * the host is told which node hears which kind of event and hands back a
 * stream, and a loop here reads each stream and calls the handler with what
 * arrives on it.
 */
import { Node, NodeDef, Binding, BindingValue, Hole, StateStyle, TemplateDef,
         TemplateRef, TemplateRefKnown, TemplateRefFresh, root,
         ready } from 'zenafx:host/scene';
import { PointerKind, PointerEvent, Delivery, Scope, Phase } from 'zenafx:host/events';
import { Stream } from 'zena:stream';
import { Disposable } from 'zena:core';

/**
 * A widget's interior, described once.
 *
 * Node 0 of `nodes` is the widget's own box — what CSS would reach with
 * `:host` — and the rest hang beneath it. `bindings` says which node and which
 * property each hole writes, so a hole on the wire is a number and nothing
 * more.
 *
 * Made once per widget class rather than once per instance: that is the whole
 * point of a template. Two widgets of the same class on screen share this and
 * differ only in what they write into it.
 */
export class Template {
  #id: u32;
  #nodes: Array<NodeDef>;
  #bindings: Array<Binding>;
  /**
   * How nodes look while the pointer is over something or pressing it. Part
   * of the template because it is the same for every instance, and because
   * the host applies it: a widget is not told the pointer came or went.
   */
  #states: Array<StateStyle>;
  /** Whether the host has the definition yet. */
  var #sent = false;

  new(nodes: Array<NodeDef>, bindings: Array<Binding>, states: Array<StateStyle> = [])
      : #nodes = nodes, #bindings = bindings, #states = states, #id = freshTemplateId();

  /**
   * How to name this template in a render: the definition the first time it is
   * used, and the id every time after.
   *
   * Nothing is registered up front, so a component with a dozen templates and
   * one on screen has sent one. The host's table lives and dies with this
   * instance, so the two cannot drift.
   */
  reference(): TemplateRef {
    if (this.#sent) {
      return new TemplateRefKnown(this.#id);
    }
    this.#sent = true;
    return new TemplateRefFresh(
        new TemplateDef(this.#id, this.#nodes, this.#bindings, this.#states));
  }
}

/** Template ids are the guest's, which is what lets a definition travel with
 *  the first render that uses it instead of needing a round trip. */
var lastTemplateId: u32 = 0;

let freshTemplateId = (): u32 => {
  lastTemplateId += 1;
  return lastTemplateId;
};

/** What a handler says about the event it was given. */
export enum Answer {
  /** It was not for this handler. Whoever is next on the path is offered it. */
  Pass,
  /** It is dealt with. Nobody further along the path is offered it. */
  StopPropagation,
  /**
   * It is dealt with, and the pointer is captured: its moves, and the button
   * coming up, go to the node this handler listens at wherever the pointer is
   * by then. It is how a drag starts. An answer to a press, or to a move
   * while the button is down, and the same as `StopPropagation` to anything
   * else.
   */
  Capture,
}

/** What a widget does with a pointer event. */
export type Handler = (event: PointerEvent) => Answer;

/**
 * One thing a widget hears: a kind of pointer event, at one node of its
 * template, and what to do about it.
 *
 * `position` is the node's index in the template, as in a `Binding`, and 0 is
 * the widget's own box. `scope` says whether the node hears events aimed at
 * what is beneath it, and `phase` whether it is offered a press before or after
 * the node the press landed on.
 */
export class Listener {
  kind: PointerKind;
  handler: Handler;
  position: u32;
  scope: Scope;
  phase: Phase;

  new(this.kind, this.handler, this.position = 0, this.scope = Scope.Subtree,
      this.phase = Phase.Bubble);
}

/**
 * Hear `kind` anywhere in the widget, the way a button hears a press on its
 * label. The handler has handled the event when it returns, so nothing further
 * up is offered it.
 */
export function on(kind: PointerKind, handler: () => void): Listener {
  return new Listener(kind, (event) => {
    handler();
    return Answer.StopPropagation;
  });
}

/**
 * Hear `kind` at one node of the template, with the event itself: where the
 * pointer is in that node's box, and which button. The handler has handled the
 * event when it returns.
 */
export function at(position: u32, kind: PointerKind,
                   handler: (event: PointerEvent) => void): Listener {
  return new Listener(kind, (event) => {
    handler(event);
    return Answer.StopPropagation;
  }, position);
}

/**
 * Hear `kind` at one node of the template, and only while the pointer is
 * captured for that node or one beneath it: the moves of a drag, and the
 * button coming up at the end of one. The pointer crossing the node at any
 * other time is not heard, and so does not wake the component.
 */
export function whileCaptured(position: u32, kind: PointerKind,
                              handler: (event: PointerEvent) => void): Listener {
  return new Listener(kind, (event) => {
    handler(event);
    return Answer.StopPropagation;
  }, position, Scope.Captured);
}

/**
 * Hear a press at one node of the template and capture the pointer for it,
 * which is how a drag starts. The moves that follow, and the button coming up, are
 * aimed at that node until then, so a listener at it or above it hears them
 * wherever the pointer goes.
 */
export function grab(position: u32, handler: (event: PointerEvent) => void): Listener {
  return new Listener(PointerKind.Down, (event) => {
    handler(event);
    return Answer.Capture;
  }, position);
}

/**
 * What a widget shows: which template, the value for each of its holes, the
 * widgets to hang in each of its slots, and what it hears.
 *
 * `content` is indexed by slot, in the order the template declares them. A slot
 * a rendering says nothing about keeps whatever is already in it.
 *
 * `listeners` are matched by their place in the list from one render to the
 * next, as `values` are. For one template the list keeps its length and each
 * place keeps its kind, node, scope and phase. Only the handler at a place may
 * change, and that costs no call: the listener's stream stays, and the loop
 * reading it calls whichever handler is there now.
 */
export class Rendering {
  template: Template;
  values: Array<BindingValue>;
  content: Array<Array<Widget>>;
  listeners: Array<Listener>;

  new(this.template, this.values, this.content, this.listeners);

  /** The same rendering, hearing `listeners`. */
  hearing(listeners: Array<Listener>): Rendering {
    return new Rendering(this.template, this.values, this.content, listeners);
  }
}

let noValues: Array<BindingValue> = [];
let noContent: Array<Array<Widget>> = [];
let noListeners: Array<Listener> = [];

/** A widget with holes to fill and no content. */
export function shows(template: Template, values: Array<BindingValue>): Rendering {
  return new Rendering(template, values, noContent, noListeners);
}

/** A widget that is pure structure: content in its slots and no holes at all. */
export function holds(template: Template, content: Array<Array<Widget>>): Rendering {
  return new Rendering(template, noValues, content, noListeners);
}

/**
 * The handler one listener's events go to.
 *
 * Kept apart from the stream so that a render can put a new handler here and
 * leave the stream, and the loop reading it, as they are.
 */
class Hearing {
  var handler: Handler;

  new(this.handler);
}

/**
 * Read one listener's events until there are no more, calling its handler with
 * each.
 *
 * Nothing ends this from here. The host ends the stream when the node the
 * listener is on goes away, which is when the widget's interior is replaced or
 * its parent stops showing it, and the loop finishes with it. So a widget keeps
 * no record of its listeners to clean up.
 *
 * A `down`, `up` or `move` comes with a reply. The host offers the event to the
 * next listener on its path only when the reply is dropped, so it is dropped
 * here as soon as the handler has returned, after `stopPropagation` if the
 * handler handled the event.
 */
async function pump(events: Stream<Delivery>, hearing: Hearing): Future<void> {
  for await (let delivery in events) {
    let answer = hearing.handler(delivery.event);
    if (let Some {value} = delivery.reply) {
      if (answer != Answer.Pass) {
        value.stopPropagation();
      }
      if (answer == Answer.Capture) {
        value.capture();
      }
      value.[Disposable.dispose]();
    }
  }
}

/** What a widget last hung in one slot: the widgets, and the nodes they got. */
class Hung {
  var children: Array<Widget>;
  var nodes: Array<Node>;

  new(this.children, this.nodes);
}

/**
 * A widget: one node of the scene, and what it shows there.
 *
 * A subclass writes `build` and nothing else. It never sees a node, a node id,
 * a template id or a hole number — and when its own state changes it calls
 * `refresh`, which works out what that costs.
 */
export abstract class Widget {
  /** Where this widget lives, once a parent has given it somewhere. */
  var #node: Node | null = null;
  /** What it last showed there. A different template is a rebuild. */
  var #showing: Template | null = null;
  /**
   * The value last sent for each hole, so only what changed is sent.
   *
   * Initialised from a shared empty array rather than written `= []`, because a
   * field at an interface type — and `Array<T>` is one — whose default is a
   * class value fails to lower: `zir unsupported: constructor field type`, which
   * `tests/language/execution/interfaces/interface-field-default.zena` records
   * as issue 475.
   */
  var #sent: Array<BindingValue> = noValues;
  /** What it last hung in each slot, so an unchanged slot is left alone. */
  var #hung = new GrowableArray<Hung>();
  /**
   * Where each listener of the template now showing finds its handler, in the
   * order the rendering lists them.
   */
  var #listening = new GrowableArray<Hearing>();

  /**
   * What to show: the template, its hole values, and the content for its slots.
   * Called on every render, so it is a description and not a side effect.
   */
  abstract build(): Rendering;

  /**
   * Give this widget a node to live in, forgetting whatever it showed before.
   *
   * Called by a parent, and only when the node is one this widget has not been
   * rendered into: a handle cannot be compared with another handle, so the
   * parent is the one that knows. Forgetting matters — a fresh node shows
   * nothing, and a widget that still believed its holes were sent would send
   * none of them.
   */
  placeIn(node: Node): void {
    this.#node = node;
    this.#showing = null;
    this.#sent = noValues;
    this.#hung = new GrowableArray<Hung>();
    this.#listening = new GrowableArray<Hearing>();
  }

  /**
   * Make the handlers `listeners` names the ones this widget's events reach.
   *
   * After a rebuild the host has none of this widget's listeners: they went
   * with the interior they were on, and their streams ended. So each one
   * listens again, and a loop is started on its stream. Otherwise the streams
   * are still being read, and the handler each loop calls is replaced without
   * a call to the host.
   */
  #hear(node: Node, listeners: Array<Listener>, rebuilt: boolean): void {
    if (rebuilt) {
      this.#listening = new GrowableArray<Hearing>();
      for (let listener in listeners) {
        let hearing = new Hearing(listener.handler);
        this.#listening.push(hearing);
        pump(node.listenPointer(listener.position, listener.kind, listener.scope,
                                listener.phase),
             hearing);
      }
      return;
    }
    var place = 0;
    for (let listener in listeners) {
      if (place < this.#listening.length) {
        this.#listening[place].handler = listener.handler;
      }
      place += 1;
    }
  }

  /**
   * Show what `build` describes, where this widget already lives.
   *
   * What a widget calls when its own state changes. A widget that is not placed
   * yet has nothing to render into and nothing to do; its parent will place it.
   */
  refresh(): void {
    let node = this.#node;
    if (node != null) {
      this.#renderInto(node);
    }
  }

  #renderInto(node: Node): void {
    let shown = this.build();
    // A template this widget was not already showing has to be built, and then
    // every hole is new and so is every slot.
    let showing = this.#showing;
    let rebuilt = showing == null || showing != shown.template;

    let holes = new GrowableArray<Hole>();
    var index = 0;
    for (let value in shown.values) {
      if (rebuilt || this.#sent[index] != value) {
        holes.push(new Hole(index as u32, value));
      }
      index += 1;
    }

    // Nothing to say is nothing to call: a widget whose values all compared
    // equal makes no call at all.
    if (rebuilt || holes.length > 0) {
      node.render(shown.template.reference(), holes);
    }
    this.#showing = shown.template;
    this.#sent = shown.values;
    if (rebuilt) {
      this.#hung = new GrowableArray<Hung>();
    }

    this.#hear(node, shown.listeners, rebuilt);
    this.#hang(node, shown.content, rebuilt);
  }

  /** Put each slot's children in it, and render them. */
  #hang(node: Node, content: Array<Array<Widget>>, rebuilt: boolean): void {
    var slot = 0;
    for (let children in content) {
      // The host hands back the same nodes when the count has not changed, so a
      // slot whose children are the same is left entirely alone — the children
      // keep their nodes and the diffing each one does still holds.
      var before: Hung | null = null;
      if (slot < this.#hung.length) {
        before = this.#hung[slot];
      }
      let remade = rebuilt || before == null ||
          before.children.length != children.length;

      var nodes: Array<Node> = [];
      if (remade) {
        nodes = node.content(slot as u32, children.length as u32);
      } else if (before != null) {
        nodes = before.nodes;
      }

      var position = 0;
      for (let child in children) {
        let moved = remade || before == null || before.children[position] != child;
        if (moved) {
          child.placeIn(nodes[position]);
        }
        child.refresh();
        position += 1;
      }

      let now = new Hung(children, nodes);
      if (slot < this.#hung.length) {
        this.#hung[slot] = now;
      } else {
        this.#hung.push(now);
      }
      slot += 1;
    }
  }
}

/**
 * Show `widget` as the application's root, and tell the host the tree is worth
 * drawing.
 *
 * The one call an application makes. `main` cannot simply return the widget:
 * `main` is the component's export and its result would have to cross WIT,
 * which a Zena class cannot do and the host is the wrong side to hold anyway.
 * So the handover is a call rather than a return, which is also where `ready`
 * belongs — the host has to be told when the tree is complete, because it
 * cannot wait for the entry to return. A component that keeps working never
 * does.
 */
export function runApp(widget: Widget): void {
  widget.placeIn(root());
  widget.refresh();
  ready();
}
