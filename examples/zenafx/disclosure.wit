package example:disclosure@0.1.0;

/// Two summaries that show and hide what is under them, from the pointer and
/// from the keyboard. Nothing in the world is about the keyboard: a key
/// arrives on a stream the scene hands out, as a press does.
world app {
  import zenafx:host/scene@0.1.0;
  import zenafx:host/style@0.1.0;

  export zenafx:host/app@0.1.0;
}
