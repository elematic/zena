// A card: a titled panel with a hole in it.
//
// The card draws its own chrome — a border, a heading, and an inset well —
// and leaves the well's interior to whoever embedded it. It never learns
// what went in there. The solve that sizes the card asks the host how big
// the hole is, and the host asks whatever the embedder filled it with, so
// the card's own size depends on a component it cannot see. That is
// projection, the way a shadow tree's `<slot>` takes its size from the
// light DOM content assigned to it.
//
// The well is drawn so the boundary is visible on screen: everything
// outside it belongs to this component, everything inside it does not.
import { Color, BoxLook, TextLook, Flex, Edges, Axis, Justify, Align,
         LengthAuto } from 'zenafx:ui/style';
import { Size } from 'zenafx:ui/geometry';
import { Node, solve, MeasureRequest, Content, ContentBox, ContentSlot,
         ContentText, Available, AvailableDefinite } from 'zenafx:host/layout';
import { registerRun } from 'zenafx:host/text';
import { Quad, Glyphs, Command, CommandQuad, CommandGlyphs,
         present } from 'zenafx:host/paint';
import { placeSlot } from 'zenafx:host/children';
import { Some, some, none } from 'zena:core';

let surface = new Color(0.94, 0.96, 0.99, 1.0);
let edge = new Color(0.68, 0.75, 0.86, 1.0);
let heading = new Color(0.18, 0.27, 0.45, 1.0);
/// The well is paler than the card, so the hole reads as a hole.
let wellFill = new Color(1.0, 1.0, 1.0, 1.0);
let wellEdge = new Color(0.78, 0.84, 0.91, 1.0);

let cardPadding = new Edges(18.0, 22.0, 22.0, 22.0);
let wellPadding = new Edges(16.0, 18.0, 16.0, 18.0);
let noPadding = new Edges(0.0, 0.0, 0.0, 0.0);

export class Card {
  #title: String;
  var #titleRun: u32 = 0;
  var #titled = false;

  new(title: String = 'Card widget — container') : #title = title;

  #ensureTitle(): u32 {
    if (!this.#titled) {
      this.#titleRun = registerRun(
        this.#title,
        new TextLook('system-ui', 15.0, 600 as u16, false, heading),
      );
      this.#titled = true;
    }
    return this.#titleRun;
  }

  // Four nodes in pre-order: the card, its heading, the well, and the hole
  // inside the well. Built one at a time and put in an array at each call
  // site, because returning an array literal from an arrow does not lower yet.
  #frame(): Node {
    return new Node(
      new Flex(Axis.Column, Justify.Start, Align.Stretch, 10.0, cardPadding,
               new LengthAuto(), new LengthAuto(), 0.0, 1.0),
      new ContentBox(),
      1,
      2,
    );
  }

  #headingNode(run: u32): Node {
    return new Node(
      new Flex(Axis.Column, Justify.Start, Align.Start, 0.0, noPadding,
               new LengthAuto(), new LengthAuto(), 0.0, 1.0),
      new ContentText(run),
      0,
      0,
    );
  }

  #well(): Node {
    return new Node(
      new Flex(Axis.Column, Justify.Start, Align.Start, 0.0, wellPadding,
               new LengthAuto(), new LengthAuto(), 0.0, 1.0),
      new ContentBox(),
      3,
      1,
    );
  }

  #hole(): Node {
    return new Node(
      new Flex(Axis.Column, Justify.Start, Align.Start, 0.0, noPadding,
               new LengthAuto(), new LengthAuto(), 0.0, 1.0),
      new ContentSlot('body'),
      0,
      0,
    );
  }

  /// How big the card wants to be. Solving its own tree is what asks the
  /// slot, so the chrome is added to whatever the embedder put there without
  /// the card knowing what that is.
  measure(request: MeasureRequest): Size {
    let space = request.availableWidth;
    // Nothing constrains the card unless the solve says so; a large box
    // stands in for "as much as you like".
    var width: f32 = 10000.0;
    if (request.knownWidth is Some<f32>) {
      width = (request.knownWidth as Some<f32>).value;
    } else if (space is AvailableDefinite) {
      width = (space as AvailableDefinite).value;
    }
    let rects = solve(
      [this.#frame(), this.#headingNode(this.#ensureTitle()), this.#well(), this.#hole()],
      new Size(width, 10000.0 as f32)
    );
    return new Size(rects[0].width, rects[0].height);
  }

  render(width: f32, height: f32): void {
    let rects = solve(
      [this.#frame(), this.#headingNode(this.#ensureTitle()), this.#well(), this.#hole()],
      new Size(width, height)
    );

    present([
      new CommandQuad(new Quad(
        rects[0], some(surface), some(edge), 1.0, 12.0)),
      new CommandGlyphs(new Glyphs(this.#ensureTitle(), rects[1].x, rects[1].y)),
      new CommandQuad(new Quad(
        rects[2], some(wellFill), some(wellEdge), 1.0, 8.0))
    ]);

    // The host draws whatever fills "body" into the rect the solve gave it,
    // clipped to that rect. Nothing happens if the slot is empty.
    placeSlot('body', rects[3]);
  }
}

let defaultCard = new Card();

export function measure(request: MeasureRequest): Size {
  return defaultCard.measure(request);
}

export function render(width: f32, height: f32): void {
  defaultCard.render(width, height);
}
