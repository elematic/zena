// A label: a line of text, sized by the text.
//
// The smallest thing that can be embedded, and in the slot demo it is the
// component the card makes room for without knowing anything about it. It
// implements `widget`, so it answers `measure` as well as drawing, and it
// never learns where it ended up — `render` is called with the box it was
// given, starting at its own origin.
import { Color, TextLook, Flex, Edges, Axis, Justify, Align,
         LengthAuto } from 'zenafx:ui/style';
import { Size } from 'zenafx:ui/geometry';
import { registerRun, measureRun } from 'zenafx:host/text';
import { MeasureRequest, Available, AvailableDefinite, AvailableMinContent,
         AvailableMaxContent } from 'zenafx:host/layout';
import { Quad, Glyphs, Command, CommandGlyphs, present } from 'zenafx:host/paint';
import { Some, some, none } from 'zena:core';

let ink = new Color(0.10, 0.11, 0.13, 1.0);

var run: u32 = 0;
var ready = false;

let ensureRun = (): u32 => {
  if (!ready) {
    run = registerRun(
      'This is a child widget inside of a slot',
      new TextLook('system-ui', 20.0, 400 as u16, false, ink),
    );
    ready = true;
  }
  return run;
};

/// The width to shape at for one query. A width the embedder's solve has
/// already fixed wins; otherwise `definite` is that width, `max-content` is
/// unconstrained, and `min-content` has no answer here — the host measures
/// the run itself for that case, so a label nested in a shrink-to-fit box
/// reports its unwrapped width.
let widthFor = (request: MeasureRequest): Option<f32> => {
  if (request.knownWidth is Some<f32>) {
    return request.knownWidth;
  }
  let space = request.availableWidth;
  if (space is AvailableDefinite) {
    return some((space as AvailableDefinite).value);
  }
  return none;
};

export function measure(request: MeasureRequest): Size {
  let id = ensureRun();
  let m = measureRun(id, widthFor(request));
  return new Size(m.width, m.height);
}

export function render(width: f32, height: f32): void {
  let id = ensureRun();
  // Shape at the width actually given, so the glyphs match the box the
  // embedder's layout settled on.
  measureRun(id, some(width));
  present([new CommandGlyphs(new Glyphs(id, 0.0, 0.0))]);
}
