package example:input@0.1.0;

/// Two text fields. The text is the component's, and so is what each key
/// does to it. The selection is the host's: the pointer moves it with no call
/// to the component, and the host draws the caret and keeps it in sight.
world app {
  import zenafx:host/scene@0.1.0;

  export zenafx:host/app@0.1.0;
}
