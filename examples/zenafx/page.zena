// A page that embeds a card and puts a label inside it.
//
// Three components in one window. The page spawns the other two and projects
// the label into the card's "body" slot; the card decides where that slot
// sits and the host sizes it by asking the label. Nobody holds anybody
// else's exports: the page has two opaque handles, and every call between
// components goes through the host.
//
// Build all three with `npm run build:example -w @zena-lang/zenafx`, then
// `zfx --app packages/zenafx/out/page.wasm`.
import { Color, BoxLook, Flex, Edges, Axis, Justify, Align,
         LengthAuto, LengthPercent } from 'zenafx:ui/style';
import { Size } from 'zenafx:ui/geometry';
import { Node, solve, Content, ContentBox, ContentChild,
         MeasureRequest } from 'zenafx:host/layout';
import { Quad, Command, CommandQuad, present } from 'zenafx:host/paint';
import { spawn, fillSlot, place } from 'zenafx:host/children';
import { some, none } from 'zena:core';

let page = new Color(0.98, 0.98, 0.99, 1.0);
let noPadding = new Edges(0.0, 0.0, 0.0, 0.0);

/// The handles the host promised. A spawn returns immediately with the
/// handle the component will occupy, but the component is not instantiated
/// until the frame ends, so the first frame draws the page alone.
var card: u32 = 0;
var label: u32 = 0;
var asked = false;

export function render(width: f32, height: f32): void {
  if (!asked) {
    // A WIT `result` arrives as a tuple of (ok, value, error) and has to be
    // destructured where it is produced; binding one to a variable does not
    // compile today.
    if (let (true, c, _) = spawn('card.wasm')) {
      if (let (true, l, _) = spawn('label.wasm')) {
        card = c;
        label = l;
        // Projection: the label goes in the card's "body". The card is
        // never told what it received.
        fillSlot(card, 'body', label);
        asked = true;
      }
    }
    return;
  }

  // A root that fills the window and centres the card, which is a child
  // component rather than a box — the solve asks it how big it is.
  let nodes = [
    new Node(
      new Flex(Axis.Column, Justify.Center, Align.Center, 0.0, noPadding,
               new LengthPercent(100.0), new LengthPercent(100.0), 0.0, 1.0),
      new ContentBox(),
      1,
      1,
    ),
    new Node(
      new Flex(Axis.Column, Justify.Start, Align.Start, 0.0, noPadding,
               new LengthAuto(), new LengthAuto(), 0.0, 1.0),
      new ContentChild(card),
      0,
      0,
    ),
  ];

  let rects = solve(nodes, new Size(width, height));

  let commands = new GrowableArray<Command>();
  commands.push(new CommandQuad(new Quad(
    rects[0],
    some(page),
    none,
    0.0,
    0.0,
  )));
  present(commands);

  place(card, rects[1]);
}

/// A root is never embedded, so nothing calls this.
export function measure(request: MeasureRequest): Size {
  return new Size(0.0, 0.0);
}
