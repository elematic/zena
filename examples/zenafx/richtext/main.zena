/**
 * Paragraphs of text in more than one style.
 *
 * A paragraph here is a flow container: a box whose `Text` children are laid
 * out together as one piece of text. A phrase in bold is a `Text` of its own,
 * with its own style, and the paragraph still wraps as one.
 */
import {
  ui, Widget, Box, Flow, Text, TemplateResult,
  Style, Align, TextAlign, rgb, px, full, runApp,
} from '../ui.zena';

let pageBg = rgb(0.97, 0.97, 0.98);
let paper = rgb(1.0, 1.0, 1.0);
let edge = rgb(0.86, 0.88, 0.92);
let ink = rgb(0.10, 0.11, 0.13);
let muted = rgb(0.36, 0.39, 0.46);
let accent = rgb(0.20, 0.38, 0.86);

let pageStyle = Style {
  background: pageBg
  align: Align.Center
  padding: { all: 32.0 }
  width: full
  height: full
};

let cardStyle = Style {
  background: paper
  borderColor: edge
  borderWidth: 1.0
  cornerRadius: 8.0
  align: Align.Stretch
  gap: 14.0
  padding: { y: 24.0, x: 28.0 }
  width: px(440.0)
};

let paragraphStyle = Style { lineHeight: 1.5 };
let centeredFlow = Style { textAlign: TextAlign.Center };

let titleStyle = Style { fontSize: 24.0 fontWeight: 700 color: ink };
let plainStyle = Style { fontSize: 16.0 fontWeight: 400 color: ink };
let boldStyle = Style { fontSize: 16.0 fontWeight: 700 color: ink };
let italicStyle = Style { fontSize: 16.0 fontWeight: 400 italic: true color: ink };
let colouredStyle = Style { fontSize: 16.0 fontWeight: 600 color: accent };
let largeStyle = Style { fontSize: 21.0 fontWeight: 400 color: ink };
let noteStyle = Style { fontSize: 13.0 fontWeight: 400 color: muted };
let noteBoldStyle = Style { fontSize: 13.0 fontWeight: 700 color: muted };

class Page extends Widget {
  build(): TemplateResult {
    return @ui Box {
      style: pageStyle,
      Box {
        style: cardStyle,
        Flow {
          Text('Rich text') { style: titleStyle }
        }
        Flow {
          style: paragraphStyle,
          Text('Text in a flow container is ') { style: plainStyle }
          Text('one piece of text') { style: boldStyle }
          Text('. A phrase can be ') { style: plainStyle }
          Text('set apart') { style: italicStyle }
          Text(', or be ') { style: plainStyle }
          Text('in another colour') { style: colouredStyle }
          Text(', or be ') { style: plainStyle }
          Text('larger') { style: largeStyle }
          Text(', and the lines still break across all of it.') { style: plainStyle }
        }
        Flow {
          style: paragraphStyle,
          Text('A word that is half bold, like un') { style: plainStyle }
          Text('believ') { style: boldStyle }
          Text('able, is still one word. Press on it twice.') { style: plainStyle }
        }
        Flow {
          style: centeredFlow,
          Text('This note is ') { style: noteStyle }
          Text('centred') { style: noteBoldStyle }
          Text('.') { style: noteStyle }
        }
      }
    };
  }
}

export function main(): void {
  runApp(new Page());
}
