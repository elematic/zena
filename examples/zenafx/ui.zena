/**
 * Signal-driven declarative UI runtime and `@ui` tag protocol for ZenaFX.
 *
 * A `@ui` node literal compiles into two phases:
 *
 *   1. Call-site template compilation (cached once per call site in a Wasm
 *      global): instantiates `Box`, `Flow`, `Text`, `Slot`, and placeholder
 *      child slots (`ui.slot()`), folds provably constant properties directly
 *      into the node tree, declares dynamic bindings via `.bind(propName)`,
 *      and flattens everything in breadth-first order via `ui.compile(root)`.
 *
 *   2. Per-instance instantiation (`build()` runs once per widget mount):
 *      creates a `TemplateResult` via `compiled.instantiate()`, applies
 *      one-shot dynamic properties and listeners via `Element.patch(inst, i)`,
 *      registers reactive `$(...)` thunks via `inst.react(...)` and
 *      `inst.bindSlot(...)`, and attaches child widgets and projected children.
 *
 * On mount, all initial values (one-shot and reactive) batch into a single
 * `node.render(...)` call. Subsequent `@signal` writes run only the affected
 * `Effect` and patch only that single binding without re-running `build()`.
 */
import {
  Box as OwnBox, Flex, Flow as FlowLayout, Layout, LayoutFlex, LayoutFlow,
  TextAlign, Edges, Axis, Justify, Align, Length, BoxStyle, TextStyle,
  LengthAuto, LengthPx, LengthPercent, Overflow, Color,
} from 'zenafx:ui/style';
import {
  Node, NodeDef, NodeStyle, NodeStyleNothing, NodeStyleFill, NodeStyleText,
  TextContent, Binding, BindingTarget, BindingValue, BindingValueContent,
  BindingValueStyle, BindingValueTextStyle, BindingValueBox, BindingValueLayout,
  Hole, State, Restyle, RestyleFill, RestyleText, StateStyle, Cursor, createNode,
} from 'zenafx:host/scene';
import { PointerKind, PointerEvent, KeyEvent } from 'zenafx:host/events';
import { Effect, hasSources, untrack } from 'zena:signals';
import { HashMap } from 'zena:collections';
import { Disposable, Hashable, some, none } from 'zena:core';
import {
  Template, WidgetBase, Mountable, Listener, KeyListener,
  Answer, KeyAnswer, Handler, KeyHandler, projectChildren,
  startPointerListener, startKeyListener, runApp,
} from './framework.zena';

export { runApp, Answer, KeyAnswer } from './framework.zena';
export { Axis, Justify, Align, Overflow, TextAlign, Color, Length } from 'zenafx:ui/style';
export { Cursor } from 'zenafx:host/scene';

/**
 * Base class for signal-driven `@ui` widgets.
 *
 * `build()` runs once when the widget is placed in a scene node and returns a
 * `TemplateResult`. All subsequent updates flow through `zena:signals`
 * `Effect`s directly to the affected bindings without re-running `build()`.
 */
export abstract class Widget extends WidgetBase {
  var #node: Node | null = null;
  var #mounted: TemplateResult | null = null;

  abstract build(): TemplateResult;

  placeIn(node: Node): void {
    this.dispose();
    this.#node = node;
  }

  refresh(): void {
    if (this.#mounted != null) {
      return;
    }
    let node = this.#node;
    if (node != null) {
      let result = this.build();
      this.#mounted = result;
      result.mount(node, this._projectedChildren());
    }
  }

  dispose(): void {
    let mounted = this.#mounted;
    if (mounted != null) {
      this.#mounted = null;
      mounted.unmount();
    }
  }

  pause(): void {
    let mounted = this.#mounted;
    if (mounted != null) {
      mounted.pause();
    }
  }

  resume(): void {
    let mounted = this.#mounted;
    if (mounted != null) {
      mounted.resume();
    }
  }
}

/** Edge insets (padding) in pixels: `all`, `x`/`y`, and per-side overrides. */
export type Insets = {
  all?: f32,
  x?: f32,
  y?: f32,
  top?: f32,
  right?: f32,
  bottom?: f32,
  left?: f32,
};

/**
 * Partial visual and typography overrides applied while a host state
 * (`hovered`, `pressed`, `focused`) holds. Omitted fields inherit from the
 * node's base `Style`.
 */
export type StateStyleProps = {
  background?: Color,
  borderColor?: Color,
  borderWidth?: f32,
  cornerRadius?: f32,
  opacity?: f32,
  fontFamily?: String,
  fontSize?: f32,
  fontWeight?: i32,
  italic?: boolean,
  color?: Color,
};

/**
 * Unified, composable style record for `Box`, `Flow`, and `Text`.
 *
 * Bundles box sizing, layout, visual fill/border, typography, interaction
 * (`cursor`, `unselectable`), and host-evaluated state overrides (`hovered`,
 * `pressed`, `focused`) into one value. Combine styles with record spread:
 * `{ ...baseLayout, ...cardSurface, gap: 12.0 }`.
 */
export type Style = {
  width?: Length,
  height?: Length,
  grow?: f32,
  shrink?: f32,
  padding?: Insets,
  overflow?: Overflow,
  overflowX?: Overflow,
  overflowY?: Overflow,

  axis?: Axis,
  justify?: Justify,
  align?: Align,
  gap?: f32,

  textAlign?: TextAlign,
  lineHeight?: f32,

  background?: Color,
  borderColor?: Color,
  borderWidth?: f32,
  cornerRadius?: f32,
  opacity?: f32,

  fontFamily?: String,
  fontSize?: f32,
  fontWeight?: i32,
  italic?: boolean,
  color?: Color,

  cursor?: Cursor,
  unselectable?: boolean,

  hovered?: StateStyleProps,
  pressed?: StateStyleProps,
  focused?: StateStyleProps,
};

/** Opaque non-premultiplied sRGB colour (channels in 0..1). */
export function rgb(r: f32, g: f32, b: f32): Color {
  return new Color(r, g, b, 1.0);
}

/** Non-premultiplied sRGB colour with alpha (channels in 0..1). */
export function rgba(r: f32, g: f32, b: f32, a: f32): Color {
  return new Color(r, g, b, a);
}

/** Fixed length in logical pixels. */
export function px(value: f32): Length {
  return new LengthPx(value);
}

/** Percentage of the containing block (100.0 is full). */
export function pct(value: f32): Length {
  return new LengthPercent(value);
}

export let auto: Length = new LengthAuto();
export let full: Length = new LengthPercent(100.0);
export let noPadding = new Edges(0.0, 0.0, 0.0, 0.0);

let defaultInk = new Color(0.0, 0.0, 0.0, 1.0);
let defaultTextStyle = new TextStyle('system-ui', 16.0, 400 as u16, false, defaultInk);

function resolveInsets(insets: Insets) {
  let base: f32 = insets.all ?? 0.0;
  let vx = insets.x ?? base;
  let vy = insets.y ?? base;
  return new Edges(
    insets.top ?? vy,
    insets.right ?? vx,
    insets.bottom ?? vy,
    insets.left ?? vx,
  );
}

function hasVisualBoxProps(s: Style): boolean {
  if (let {background} = s) { return true; }
  if (let {borderColor} = s) { return true; }
  if (let {borderWidth} = s) { return true; }
  if (let {cornerRadius} = s) { return true; }
  if (let {opacity} = s) { return true; }
  return false;
}

function resolveBoxStyle(s: Style) {
  let bg: Option<Color> = if (let {background} = s) { some(background) } else { none };
  let border: Option<Color> = if (let {borderColor} = s) { some(borderColor) } else { none };
  return new BoxStyle(
    bg,
    border,
    s.borderWidth ?? 0.0,
    s.cornerRadius ?? 0.0,
    s.opacity ?? 1.0,
  );
}

function mergeBoxStateStyle(base: BoxStyle, over: StateStyleProps) {
  let bg: Option<Color> = if (let {background} = over) { some(background) } else { base.background };
  let border: Option<Color> = if (let {borderColor} = over) { some(borderColor) } else { base.borderColor };
  return new BoxStyle(
    bg,
    border,
    over.borderWidth ?? base.borderWidth,
    over.cornerRadius ?? base.cornerRadius,
    over.opacity ?? base.opacity,
  );
}

function resolveTextStyle(s: Style) {
  return new TextStyle(
    s.fontFamily ?? 'system-ui',
    s.fontSize ?? 16.0,
    (s.fontWeight ?? 400) as u16,
    s.italic ?? false,
    s.color ?? defaultInk,
  );
}

function mergeTextStateStyle(base: TextStyle, over: StateStyleProps) {
  let weight: u16 = if (let {fontWeight} = over) { fontWeight as u16 } else { base.weight };
  return new TextStyle(
    over.fontFamily ?? base.family,
    over.fontSize ?? base.size,
    weight,
    over.italic ?? base.italic,
    over.color ?? base.color,
  );
}

/**
 * Stateful guest directive instance owned by a `SlotPart`.
 *
 * Directives live entirely in guest code on top of `createNode()` and
 * `node.setSlot(...)`. `pause` and `resume` cascade when an enclosing `cache`
 * parks or restores a subtree; `dispose` releases all owned host nodes.
 */
export interface Directive {
  pause(): void;
  resume(): void;
  dispose(): void;
}

/**
 * Value returned by a directive function (such as `cache(...)`, `cacheBy(...)`,
 * or `repeat(...)`) inside a dynamic `$(...)` child slot.
 */
export interface DirectiveResult {
  matches(active: Directive): boolean;
  create(): Directive;
  apply(active: Directive, part: SlotPart): void;
}

/** What a dynamic `$(...)` child expression may evaluate to. */
export type Child =
  Widget
  | TemplateResult
  | Mountable
  | DirectiveResult
  | GrowableArray<Widget>
  | GrowableArray<TemplateResult>
  | GrowableArray<Mountable>
  | Array<Widget>
  | Array<TemplateResult>
  | Array<Mountable>
  | null;

final class MountedNode {
  node: Node;
  child: Mountable;

  new(this.node, this.child);
}

/**
 * Guest controller for one dynamic `$(...)` child slot on a mounted
 * `TemplateResult`.
 *
 * Owns the slot's reactive `Effect`, any active `Directive`, and any
 * guest-owned `Node` handles mounted into the slot.
 */
export final class SlotPart {
  #parentNode: Node;
  #bfsSlot: i32;
  #thunk: () => Child;
  var #effect: Effect | null = null;
  var #isReactive: boolean = false;
  var #activeDirective: Directive | null = null;
  var #plainEntries = new GrowableArray<MountedNode>();

  new(parentNode: Node, bfsSlot: i32, thunk: () => Child)
    : #parentNode = parentNode, #bfsSlot = bfsSlot, #thunk = thunk;

  /** Create a detached host node owned by the caller. */
  createNode(): Node {
    return createNode();
  }

  /** Replace this slot's children with `nodes` in order. */
  setNodes(nodes: Array<Node>): void {
    this.#parentNode.setSlot(this.#bfsSlot as u32, nodes);
  }

  start(): void {
    let eff = new Effect(() => {
      let next = this.#thunk();
      untrack(() => {
        this.#apply(next);
      });
    });
    if (hasSources(eff)) {
      this.#effect = eff;
      this.#isReactive = true;
    } else {
      eff.dispose();
    }
  }

  #apply(value: Child): void {
    if (value is DirectiveResult) {
      this.#clearPlain();
      var active = this.#activeDirective;
      if (active == null || !value.matches(active)) {
        if (active != null) {
          active.dispose();
        }
        active = value.create();
        this.#activeDirective = active;
      }
      value.apply(active, this);
      return;
    }

    let prevDir = this.#activeDirective;
    if (prevDir != null) {
      this.#activeDirective = null;
      prevDir.dispose();
    }
    this.#clearPlain();

    let next = flattenChild(value);
    let handles = new GrowableArray<Node>();
    for (let child in next) {
      let n = createNode();
      child.mount(n, null);
      this.#plainEntries.push(new MountedNode(n, child));
      handles.push(n);
    }
    this.#parentNode.setSlot(this.#bfsSlot as u32, handles);
  }

  #clearPlain(): void {
    if (this.#plainEntries.length == 0) {
      return;
    }
    for (let entry in this.#plainEntries) {
      entry.child.unmount();
      entry.node.[Disposable.dispose]();
    }
    this.#plainEntries = new GrowableArray<MountedNode>();
  }

  pause(): void {
    let eff = this.#effect;
    if (eff != null) {
      this.#effect = null;
      eff.dispose();
    }
    let dir = this.#activeDirective;
    if (dir != null) {
      dir.pause();
    }
    for (let entry in this.#plainEntries) {
      entry.child.pause();
    }
  }

  resume(): void {
    let dir = this.#activeDirective;
    if (dir != null) {
      dir.resume();
    }
    for (let entry in this.#plainEntries) {
      entry.child.resume();
    }
    if (this.#isReactive && this.#effect == null) {
      this.start();
    }
  }

  dispose(): void {
    let eff = this.#effect;
    if (eff != null) {
      this.#effect = null;
      eff.dispose();
    }
    let dir = this.#activeDirective;
    if (dir != null) {
      this.#activeDirective = null;
      dir.dispose();
    }
    this.#clearPlain();
  }
}

// ---------------------------------------------------------------------------
// Guest directives: `cache`, `cacheBy`, `repeat`
// ---------------------------------------------------------------------------

final class ParkedBranch {
  template: CompiledTemplate;
  node: Node;
  mounted: TemplateResult;

  new(this.template, this.node, this.mounted);
}

final class CacheDirective implements Directive {
  var #branches = new GrowableArray<ParkedBranch>();
  var #active: ParkedBranch | null = null;

  applyValue(value: TemplateResult | null, part: SlotPart): void {
    if (value == null) {
      let prev = this.#active;
      if (prev != null) {
        prev.mounted.pause();
        this.#active = null;
      }
      part.setNodes([]);
      return;
    }

    let prev = this.#active;
    if (prev != null && prev.template === value.compiled) {
      return;
    }
    if (prev != null) {
      prev.mounted.pause();
    }

    for (let branch in this.#branches) {
      if (branch.template === value.compiled) {
        this.#active = branch;
        branch.mounted.resume();
        part.setNodes([branch.node]);
        return;
      }
    }

    let node = part.createNode();
    value.mount(node, null);
    let created = new ParkedBranch(value.compiled, node, value);
    this.#branches.push(created);
    this.#active = created;
    part.setNodes([node]);
  }

  pause(): void {
    let active = this.#active;
    if (active != null) {
      active.mounted.pause();
    }
  }

  resume(): void {
    let active = this.#active;
    if (active != null) {
      active.mounted.resume();
    }
  }

  dispose(): void {
    this.#active = null;
    for (let branch in this.#branches) {
      branch.mounted.unmount();
      branch.node.[Disposable.dispose]();
    }
    this.#branches = new GrowableArray<ParkedBranch>();
  }
}

final class CacheResult implements DirectiveResult {
  #value: TemplateResult | null;

  new(value: TemplateResult | null) : #value = value;

  matches(active: Directive): boolean {
    return active is CacheDirective;
  }

  create(): Directive {
    return new CacheDirective();
  }

  apply(active: Directive, part: SlotPart): void {
    (active as CacheDirective).applyValue(this.#value, part);
  }
}

/**
 * Park inactive branches of a conditional or `match` expression by template
 * identity so returning to a branch reattaches its host node and shaped text
 * runs with no rebuild and pauses its `Effect`s while parked.
 */
export function cache(value: TemplateResult | null): DirectiveResult {
  return new CacheResult(value);
}

final class ParkedKeyedBranch<K> {
  key: K;
  node: Node;
  mounted: Mountable;

  new(this.key, this.node, this.mounted);
}

final class CacheByDirective<K extends Hashable> implements Directive {
  var #branches = new HashMap<K, ParkedKeyedBranch<K>>();
  var #active: ParkedKeyedBranch<K> | null = null;

  applyKey(key: K, render: () => Mountable | null, part: SlotPart): void {
    let prev = this.#active;
    if (prev != null && prev.key == key) {
      return;
    }
    if (prev != null) {
      prev.mounted.pause();
      this.#active = null;
    }

    if (let (true, existing) = this.#branches.get(key)) {
      this.#active = existing;
      existing.mounted.resume();
      part.setNodes([existing.node]);
      return;
    }

    let rendered = render();
    if (rendered == null) {
      part.setNodes([]);
      return;
    }

    let node = part.createNode();
    rendered.mount(node, null);
    let created = new ParkedKeyedBranch<K>(key, node, rendered);
    this.#branches[key] = created;
    this.#active = created;
    part.setNodes([node]);
  }

  pause(): void {
    let active = this.#active;
    if (active != null) {
      active.mounted.pause();
    }
  }

  resume(): void {
    let active = this.#active;
    if (active != null) {
      active.mounted.resume();
    }
  }

  dispose(): void {
    this.#active = null;
    for (let k in this.#branches.keys()) {
      let branch = this.#branches[k];
      branch.mounted.unmount();
      branch.node.[Disposable.dispose]();
    }
    this.#branches = new HashMap<K, ParkedKeyedBranch<K>>();
  }
}

final class CacheByResult<K extends Hashable> implements DirectiveResult {
  #key: K;
  #render: () => Mountable | null;

  new(key: K, render: () => Mountable | null) : #key = key, #render = render;

  matches(active: Directive): boolean {
    return active is CacheByDirective<K>;
  }

  create(): Directive {
    return new CacheByDirective<K>();
  }

  apply(active: Directive, part: SlotPart): void {
    (active as CacheByDirective<K>).applyKey(this.#key, this.#render, part);
  }
}

/**
 * Like `cache`, but keyed by an explicit key `key` and lazy: `render` is only
 * invoked on the first visit to each key.
 */
export function cacheBy<K extends Hashable>(key: K, render: () => Mountable | null): DirectiveResult {
  return new CacheByResult<K>(key, render);
}

final class RepeatDirective<T, K extends Hashable> implements Directive {
  var #rows = new HashMap<K, MountedNode>();

  applyItems(
    items: Array<T>,
    keyFn: (item: T) => K,
    renderFn: (item: T) => Mountable,
    part: SlotPart,
  ): void {
    let nextRows = new HashMap<K, MountedNode>();
    let handles = new GrowableArray<Node>();

    for (let item in items) {
      let key = keyFn(item);
      if (let (true, existing) = this.#rows.get(key)) {
        nextRows[key] = existing;
        handles.push(existing.node);
      } else {
        let node = part.createNode();
        let mounted = renderFn(item);
        mounted.mount(node, null);
        let entry = new MountedNode(node, mounted);
        nextRows[key] = entry;
        handles.push(node);
      }
    }

    part.setNodes(handles);

    for (let oldKey in this.#rows.keys()) {
      if (!nextRows.has(oldKey)) {
        let gone = this.#rows[oldKey];
        gone.child.unmount();
        gone.node.[Disposable.dispose]();
      }
    }

    this.#rows = nextRows;
  }

  pause(): void {
    for (let k in this.#rows.keys()) {
      this.#rows[k].child.pause();
    }
  }

  resume(): void {
    for (let k in this.#rows.keys()) {
      this.#rows[k].child.resume();
    }
  }

  dispose(): void {
    for (let k in this.#rows.keys()) {
      let entry = this.#rows[k];
      entry.child.unmount();
      entry.node.[Disposable.dispose]();
    }
    this.#rows = new HashMap<K, MountedNode>();
  }
}

final class RepeatResult<T, K extends Hashable> implements DirectiveResult {
  #items: Array<T>;
  #keyFn: (item: T) => K;
  #renderFn: (item: T) => Mountable;

  new(items: Array<T>, keyFn: (item: T) => K, renderFn: (item: T) => Mountable)
    : #items = items, #keyFn = keyFn, #renderFn = renderFn;

  matches(active: Directive): boolean {
    return active is RepeatDirective<T, K>;
  }

  create(): Directive {
    return new RepeatDirective<T, K>();
  }

  apply(active: Directive, part: SlotPart): void {
    (active as RepeatDirective<T, K>).applyItems(
      this.#items,
      this.#keyFn,
      this.#renderFn,
      part,
    );
  }
}

/**
 * Keyed list directive backed by `createNode()` and `node.setSlot(...)`.
 * Reordering items permutes existing host nodes in place without rebuilding
 * rows or re-shaping their text.
 */
export function repeat<T, K extends Hashable>(
  items: Array<T>,
  keyFn: (item: T) => K,
  renderFn: (item: T) => Mountable,
): DirectiveResult {
  return new RepeatResult<T, K>(items, keyFn, renderFn);
}

final class PendingState {
  when: State;
  style: Restyle;

  new(this.when, this.style);
}

final class NodeBindings {
  content: i32;
  style: i32;
  box: i32;
  layout: i32;

  new(this.content, this.style, this.box, this.layout);
}

final class DynamicSlotEntry {
  bfsSlot: i32;
  fn: () => Child;

  new(this.bfsSlot, this.fn);
}

/**
 * A flattened, cached ZenaFX template paired with pre-order-to-BFS lookup
 * tables so per-instance patching can address nodes and slots by source order.
 */
export final class CompiledTemplate {
  template: Template;
  preToBfsNode: GrowableArray<i32>;
  preToBfsSlot: GrowableArray<i32>;
  projectionSlot: i32;
  nodeBindings: GrowableArray<NodeBindings>;
  initialNodes: GrowableArray<NodeDef>;

  new(
    this.template,
    this.preToBfsNode,
    this.preToBfsSlot,
    this.projectionSlot,
    this.nodeBindings,
    this.initialNodes,
  );

  instantiate(): TemplateResult {
    return new TemplateResult(this);
  }

  bfsNodeIndex(preIndex: i32): i32 {
    return this.preToBfsNode[preIndex];
  }

  bfsSlotIndex(preSlotIndex: i32): i32 {
    return this.preToBfsSlot[preSlotIndex];
  }

  bindingIndex(bfsNode: i32, target: BindingTarget): i32 {
    let entry = this.nodeBindings[bfsNode];
    return match (target) {
      case BindingTarget.Content: entry.content
      case BindingTarget.Style: entry.style
      case BindingTarget.Box: entry.box
      case BindingTarget.Layout: entry.layout
    };
  }
}

/**
 * Per-instance result of evaluating a `@ui` expression.
 *
 * Buffers initial one-shot and reactive binding writes so mount sends one
 * `node.render` call, then keeps live `Effect`s to patch individual bindings
 * and dynamic slots on subsequent `@signal` changes.
 */
export final class TemplateResult implements Mountable {
  compiled: CompiledTemplate;
  var #node: Node | null = null;
  var #mounting: boolean = true;
  var #pendingHoles = new GrowableArray<Hole>();
  #lastSent = new HashMap<i32, BindingValue>();
  var #reactThunks = new GrowableArray<() => void>();
  #liveThunks = new GrowableArray<() => void>();
  var #effects = new GrowableArray<Effect>();
  #listeners = new GrowableArray<Listener>();
  #keyListeners = new GrowableArray<KeyListener>();
  #staticSlots = new HashMap<i32, Mountable>();
  #dynamicSlots = new GrowableArray<DynamicSlotEntry>();
  var #slotParts = new GrowableArray<SlotPart>();
  var #mountedSlots = new HashMap<i32, GrowableArray<Mountable>>();

  new(this.compiled);

  /** Register a reactive thunk to run inside an `Effect` on mount. */
  react(fn: () => void): void {
    this.#reactThunks.push(fn);
  }

  /** Assign a static child (`Widget` or `TemplateResult`) to a pre-order slot. */
  setSlotChild(preSlotIndex: i32, child: Mountable): void {
    let bfsSlot = this.compiled.bfsSlotIndex(preSlotIndex);
    this.#staticSlots[bfsSlot] = child;
  }

  /** Bind a dynamic `$(...)` child expression to a pre-order slot. */
  bindSlot(preSlotIndex: i32, fn: () => Child): void {
    let bfsSlot = this.compiled.bfsSlotIndex(preSlotIndex);
    this.#dynamicSlots.push(new DynamicSlotEntry(bfsSlot, fn));
  }

  /** Attach parent-supplied children to a child widget for `Slot {}` projection. */
  project(widget: WidgetBase, children: Array<Mountable>): void {
    widget.[projectChildren](GrowableArray.from(children));
  }

  /** Record a pointer listener for a BFS node index. */
  addListener(listener: Listener): void {
    this.#listeners.push(listener);
  }

  /** Record a keyboard listener for a BFS node index. */
  addKeyListener(listener: KeyListener): void {
    this.#keyListeners.push(listener);
  }

  /**
   * Write a binding value for `bfsNode` / `target`.
   *
   * During mount, updates are coalesced into `#pendingHoles` so the initial
   * render crosses the host boundary once. After mount, unchanged values are
   * skipped and changed values patch the single binding in place.
   */
  writeBinding(bfsNode: i32, target: BindingTarget, value: BindingValue): void {
    let bindingIdx = this.compiled.bindingIndex(bfsNode, target);
    if (bindingIdx < 0) {
      return;
    }
    if (let (true, prev) = this.#lastSent.get(bindingIdx)) {
      if (prev == value) {
        return;
      }
    }
    this.#lastSent[bindingIdx] = value;

    if (this.#mounting) {
      let targetId = bindingIdx as u32;
      var i = 0;
      while (i < this.#pendingHoles.length) {
        if (this.#pendingHoles[i].binding == targetId) {
          this.#pendingHoles[i] = new Hole(targetId, value);
          return;
        }
        i += 1;
      }
      this.#pendingHoles.push(new Hole(targetId, value));
      return;
    }

    let node = this.#node;
    if (node != null) {
      node.render(this.compiled.template.reference(), [new Hole(bindingIdx as u32, value)]);
    }
  }

  mount(node: Node, projected: GrowableArray<Mountable> | null): void {
    this.#node = node;
    this.#mounting = true;

    for (let fn in this.#reactThunks) {
      let eff = new Effect(fn);
      if (hasSources(eff)) {
        this.#effects.push(eff);
        this.#liveThunks.push(fn);
      } else {
        eff.dispose();
      }
    }
    this.#reactThunks = new GrowableArray<() => void>();

    node.render(this.compiled.template.reference(), this.#pendingHoles);
    this.#pendingHoles = new GrowableArray<Hole>();
    this.#mounting = false;

    for (let listener in this.#listeners) {
      startPointerListener(node, listener);
    }
    for (let keyListener in this.#keyListeners) {
      startKeyListener(node, keyListener);
    }

    if (this.compiled.projectionSlot >= 0 && projected != null) {
      this.#mountSlot(node, this.compiled.projectionSlot, projected);
    }

    for (let bfsSlot in this.#staticSlots.keys()) {
      let list = new GrowableArray<Mountable>();
      list.push(this.#staticSlots[bfsSlot]);
      this.#mountSlot(node, bfsSlot, list);
    }

    for (let entry in this.#dynamicSlots) {
      let part = new SlotPart(node, entry.bfsSlot, entry.fn);
      this.#slotParts.push(part);
      part.start();
    }
  }

  #mountSlot(node: Node, bfsSlot: i32, next: GrowableArray<Mountable>): void {
    if (let (true, prev) = this.#mountedSlots.get(bfsSlot)) {
      for (let oldChild in prev) {
        oldChild.unmount();
      }
    }
    let nodes = node.content(bfsSlot as u32, next.length as u32);
    var i = 0;
    while (i < next.length) {
      next[i].mount(nodes[i], null);
      i += 1;
    }
    this.#mountedSlots[bfsSlot] = next;
  }

  pause(): void {
    for (let eff in this.#effects) {
      eff.dispose();
    }
    this.#effects = new GrowableArray<Effect>();
    for (let part in this.#slotParts) {
      part.pause();
    }
    for (let bfsSlot in this.#mountedSlots.keys()) {
      for (let child in this.#mountedSlots[bfsSlot]) {
        child.pause();
      }
    }
  }

  resume(): void {
    if (this.#node == null) {
      return;
    }
    if (this.#effects.length == 0) {
      for (let fn in this.#liveThunks) {
        let eff = new Effect(fn);
        if (hasSources(eff)) {
          this.#effects.push(eff);
        } else {
          eff.dispose();
        }
      }
    }
    for (let part in this.#slotParts) {
      part.resume();
    }
    for (let bfsSlot in this.#mountedSlots.keys()) {
      for (let child in this.#mountedSlots[bfsSlot]) {
        child.resume();
      }
    }
  }

  unmount(): void {
    for (let eff in this.#effects) {
      eff.dispose();
    }
    this.#effects = new GrowableArray<Effect>();
    for (let part in this.#slotParts) {
      part.dispose();
    }
    this.#slotParts = new GrowableArray<SlotPart>();
    for (let bfsSlot in this.#mountedSlots.keys()) {
      for (let child in this.#mountedSlots[bfsSlot]) {
        child.unmount();
      }
    }
    this.#mountedSlots = new HashMap<i32, GrowableArray<Mountable>>();
    this.#node = null;
  }
}

function flattenChild(child: Child): GrowableArray<Mountable> {
  let out = new GrowableArray<Mountable>();
  if (child == null) {
    return out;
  }
  if (child is Widget) {
    out.push(child);
  } else if (child is TemplateResult) {
    out.push(child);
  } else if (child is Mountable) {
    out.push(child);
  } else if (child is GrowableArray<Widget>) {
    for (let w in child) {
      out.push(w);
    }
  } else if (child is GrowableArray<TemplateResult>) {
    for (let t in child) {
      out.push(t);
    }
  } else if (child is GrowableArray<Mountable>) {
    for (let m in child) {
      out.push(m);
    }
  } else if (child is Array<Widget>) {
    for (let w in child) {
      out.push(w);
    }
  } else if (child is Array<TemplateResult>) {
    for (let t in child) {
      out.push(t);
    }
  } else if (child is Array<Mountable>) {
    for (let m in child) {
      out.push(m);
    }
  }
  return out;
}

function makeVoidListener(kind: PointerKind, handler: () => void, pos: u32) {
  return new Listener(kind, (event) => {
    handler();
    return Answer.StopPropagation;
  }, pos);
}

function makeMoveListener(handler: (event: PointerEvent) => void, pos: u32) {
  return new Listener(PointerKind.Move, (event) => {
    handler(event);
    return Answer.StopPropagation;
  }, pos);
}

/**
 * Base class for host element builders (`Box`, `Flow`, `Text`, `Slot`).
 *
 * Each element class serves both phases:
 *   - Phase 1 (template build): constructed with `new Box()` etc.; setters
 *     configure the static `NodeDef`, `bind(prop)` declares dynamic bindings.
 *   - Phase 2 (per-instance patch): constructed with `Box.patch(inst, preIdx)`;
 *     setters write directly to `inst.writeBinding(...)` or register listeners.
 */
export class HostElement {
  var _style: Style = {};

  var _width: Length = new LengthAuto();
  var _height: Length = new LengthAuto();
  var _grow: f32 = 0.0;
  var _shrink: f32 = 1.0;
  var _padding: Edges = noPadding;
  var _overflowX: Overflow = Overflow.Clip;
  var _overflowY: Overflow = Overflow.Clip;

  var _axis: Axis = Axis.Column;
  var _justify: Justify = Justify.Start;
  var _align: Align = Align.Start;
  var _gap: f32 = 0.0;

  var _isFlow: boolean = false;
  var _textAlign: TextAlign = TextAlign.Start;
  var _lineHeight: Option<f32> = none;

  var _isText: boolean = false;
  var _textContent: String = '';
  var _textStyle: TextStyle = defaultTextStyle;
  var _boxStyle: Option<BoxStyle> = none;

  var _isSlot: boolean = false;
  var _isProjection: boolean = false;
  var _cursor: Option<Cursor> = none;
  var _focusable: boolean = false;
  var _editable: boolean = false;
  var _unselectable: boolean = false;

  var _boundContent: boolean = false;
  var _boundStyle: boolean = false;
  var _boundBox: boolean = false;
  var _boundLayout: boolean = false;

  var _states = new GrowableArray<PendingState>();
  _children = new GrowableArray<HostElement>();

  /** Non-null when this object is a Phase 2 per-instance patcher. */
  var _patchTarget: TemplateResult | null = null;
  var _bfsNodeIndex: i32 = -1;

  /**
   * Declare that `propName` on this node will be supplied dynamically at mount
   * or updated reactively via `Effect`.
   */
  bind(propName: String): void {
    if (propName == 'content') {
      this._boundContent = true;
    } else if (propName == 'style') {
      this._boundStyle = true;
      this._boundBox = true;
      if (!this._isText) {
        this._boundLayout = true;
      }
    }
  }

  _initPatch(target: TemplateResult, preNodeIndex: i32): void {
    let bfsIdx = target.compiled.bfsNodeIndex(preNodeIndex);
    this._patchTarget = target;
    this._bfsNodeIndex = bfsIdx;
    let def = target.compiled.initialNodes[bfsIdx];
    this._width = def.box.width;
    this._height = def.box.height;
    this._grow = def.box.grow;
    this._shrink = def.box.shrink;
    this._padding = def.box.padding;
    this._overflowX = def.box.overflowX;
    this._overflowY = def.box.overflowY;
    match (def.layout) {
      case LayoutFlex {value}: {
        this._isFlow = false;
        this._axis = value.axis;
        this._justify = value.justifyContent;
        this._align = value.alignItems;
        this._gap = value.gap;
      }
      case LayoutFlow {value}: {
        this._isFlow = true;
        this._textAlign = value.align;
        this._lineHeight = value.lineHeight;
      }
    }
    match (def.style) {
      case NodeStyleFill {value}: { this._boxStyle = some(value); }
      case NodeStyleText {value}: {
        this._isText = true;
        this._textContent = value.content;
        this._textStyle = value.style;
      }
      case NodeStyleNothing: {}
    }
  }

  _ownBox(): OwnBox {
    return new OwnBox(
      this._width, this._height, this._grow, this._shrink,
      this._padding, this._overflowX, this._overflowY,
    );
  }

  _layout(): Layout {
    if (this._isFlow) {
      return new LayoutFlow(new FlowLayout(this._textAlign, this._lineHeight));
    }
    return new LayoutFlex(new Flex(this._axis, this._justify, this._align, this._gap));
  }

  _nodeStyle(): NodeStyle {
    if (this._isText) {
      return new NodeStyleText(new TextContent(this._textContent, this._textStyle));
    }
    if (let Some {value} = this._boxStyle) {
      return new NodeStyleFill(value);
    }
    return new NodeStyleNothing();
  }

  _applyStyle(s: Style): void {
    this._style = s;
    this._width = s.width ?? new LengthAuto();
    this._height = s.height ?? new LengthAuto();
    this._grow = s.grow ?? 0.0;
    this._shrink = s.shrink ?? 1.0;
    this._padding = if (let {padding} = s) { resolveInsets(padding) } else { noPadding };
    let ov = s.overflow ?? Overflow.Clip;
    this._overflowX = s.overflowX ?? ov;
    this._overflowY = s.overflowY ?? ov;
    this._cursor = if (let {cursor} = s) { some(cursor) } else { none };
    this._unselectable = s.unselectable ?? false;

    if (this._isText) {
      let textStyle = resolveTextStyle(s);
      this._textStyle = textStyle;
      let target = this._patchTarget;
      if (target != null) {
        target.writeBinding(this._bfsNodeIndex, BindingTarget.Box, new BindingValueBox(this._ownBox()));
        target.writeBinding(this._bfsNodeIndex, BindingTarget.Style, new BindingValueTextStyle(textStyle));
      } else {
        this._states = new GrowableArray<PendingState>();
        if (let {hovered} = s) {
          this._states.push(new PendingState(State.Hovered, new RestyleText(mergeTextStateStyle(textStyle, hovered))));
        }
        if (let {pressed} = s) {
          this._states.push(new PendingState(State.Pressed, new RestyleText(mergeTextStateStyle(textStyle, pressed))));
        }
        if (let {focused} = s) {
          this._states.push(new PendingState(State.Focused, new RestyleText(mergeTextStateStyle(textStyle, focused))));
        }
      }
      return;
    }

    if (this._isFlow) {
      this._textAlign = s.textAlign ?? TextAlign.Start;
      this._lineHeight = if (let {lineHeight} = s) { some(lineHeight) } else { none };
    } else {
      this._axis = s.axis ?? Axis.Column;
      this._justify = s.justify ?? Justify.Start;
      this._align = s.align ?? Align.Start;
      this._gap = s.gap ?? 0.0;
    }

    let boxStyle = resolveBoxStyle(s);
    this._boxStyle = if (hasVisualBoxProps(s)) { some(boxStyle) } else { none };
    let target = this._patchTarget;
    if (target != null) {
      target.writeBinding(this._bfsNodeIndex, BindingTarget.Box, new BindingValueBox(this._ownBox()));
      target.writeBinding(this._bfsNodeIndex, BindingTarget.Layout, new BindingValueLayout(this._layout()));
      target.writeBinding(this._bfsNodeIndex, BindingTarget.Style, new BindingValueStyle(boxStyle));
    } else {
      this._states = new GrowableArray<PendingState>();
      if (let {hovered} = s) {
        this._states.push(new PendingState(State.Hovered, new RestyleFill(mergeBoxStateStyle(boxStyle, hovered))));
      }
      if (let {pressed} = s) {
        this._states.push(new PendingState(State.Pressed, new RestyleFill(mergeBoxStateStyle(boxStyle, pressed))));
      }
      if (let {focused} = s) {
        this._states.push(new PendingState(State.Focused, new RestyleFill(mergeBoxStateStyle(boxStyle, focused))));
      }
    }
  }

  /** Unified style carrying sizing, layout, visual, typography, interaction, and state overrides. */
  style: Style {
    get { return this._style; }
    set(v) { this._applyStyle(v); }
  }

  /** Behavioral node capability: whether this node can receive keyboard focus. */
  focusable: boolean {
    get { return this._focusable; }
    set(v) { this._focusable = v; }
  }

  // Event listeners (always registered per-instance in Phase 2).
  onDown: () => void {
    get { return () => {}; }
    set(handler) {
      let target = this._patchTarget;
      if (target != null) {
        target.addListener(makeVoidListener(PointerKind.Down, handler, this._bfsNodeIndex as u32));
      }
    }
  }
  onUp: () => void {
    get { return () => {}; }
    set(handler) {
      let target = this._patchTarget;
      if (target != null) {
        target.addListener(makeVoidListener(PointerKind.Up, handler, this._bfsNodeIndex as u32));
      }
    }
  }
  onMove: (event: PointerEvent) => void {
    get { return (event: PointerEvent) => {}; }
    set(handler) {
      let target = this._patchTarget;
      if (target != null) {
        target.addListener(makeMoveListener(handler, this._bfsNodeIndex as u32));
      }
    }
  }
  onEnter: () => void {
    get { return () => {}; }
    set(handler) {
      let target = this._patchTarget;
      if (target != null) {
        target.addListener(makeVoidListener(PointerKind.Enter, handler, this._bfsNodeIndex as u32));
      }
    }
  }
  onLeave: () => void {
    get { return () => {}; }
    set(handler) {
      let target = this._patchTarget;
      if (target != null) {
        target.addListener(makeVoidListener(PointerKind.Leave, handler, this._bfsNodeIndex as u32));
      }
    }
  }
  onPointerDown: Handler {
    get { return (event: PointerEvent) => Answer.Pass; }
    set(handler) {
      let target = this._patchTarget;
      if (target != null) {
        target.addListener(new Listener(PointerKind.Down, handler, this._bfsNodeIndex as u32));
      }
    }
  }
  onKey: KeyHandler {
    get { return (event: KeyEvent) => KeyAnswer.Pass; }
    set(handler) {
      let target = this._patchTarget;
      if (target != null) {
        target.addKeyListener(new KeyListener(handler, this._bfsNodeIndex as u32));
      }
    }
  }
}

/** A flex container box. */
export final class Box extends HostElement {
  new() : super();

  static patch(result: TemplateResult, nodeIndex: i32): Box {
    let b = new Box();
    b._initPatch(result, nodeIndex);
    return b;
  }

  addChild(child: HostElement): void {
    this._children.push(child);
  }
}

/** A text-flow container whose `Text` children lay out as one run of lines. */
export final class Flow extends HostElement {
  new() : super() {
    this._isFlow = true;
  }

  static patch(result: TemplateResult, nodeIndex: i32): Flow {
    let f = new Flow();
    f._initPatch(result, nodeIndex);
    return f;
  }

  addChild(child: HostElement): void {
    this._children.push(child);
  }
}

/** A leaf text node. Positional argument sets `content`. */
export final class Text extends HostElement {
  new(content: String = '') : super() {
    this._isText = true;
    this._textContent = content;
  }

  static patch(result: TemplateResult, nodeIndex: i32): Text {
    let t = new Text();
    t._initPatch(result, nodeIndex);
    return t;
  }

  content: String {
    get { return this._textContent; }
    set(v) {
      this._textContent = v;
      let target = this._patchTarget;
      if (target != null) {
        target.writeBinding(this._bfsNodeIndex, BindingTarget.Content, new BindingValueContent(v));
      }
    }
  }

  editable: boolean {
    get { return this._editable; }
    set(v) { this._editable = v; }
  }
}

/**
 * Projection slot: splices whatever children the parent placed inside this
 * widget into the surrounding container.
 */
export final class Slot extends HostElement {
  new() : super() {
    this._isSlot = true;
    this._isProjection = true;
  }

  static isSlot(): boolean {
    return true;
  }

  static patch(result: TemplateResult, nodeIndex: i32): Slot {
    let s = new Slot();
    s._initPatch(result, nodeIndex);
    return s;
  }
}

/**
 * The `@ui` tag object. Implements the staged node-tree compiler protocol:
 * `compile(root)` flattens a static element tree into a cached
 * `CompiledTemplate`, and `slot()` creates a placeholder slot node for a
 * child widget or dynamic `$(...)` child binding.
 */
export final class UiTag {
  /** Create a placeholder slot node in the template for a child widget or `$(...)`. */
  slot(): HostElement {
    let el = new HostElement();
    el._isSlot = true;
    return el;
  }

  /** Wrap a root child widget in a transparent container with one slot. */
  wrapSlot(): HostElement {
    let root = new Box();
    root.addChild(this.slot());
    return root;
  }

  /** Wrap a dynamic `$(...)` projected child in a single-slot `TemplateResult`. */
  dynamicChild(fn: () => Child): TemplateResult {
    let tpl = dynamicChildTemplate();
    let inst = tpl.instantiate();
    inst.bindSlot(0, fn);
    return inst;
  }

  /** Flatten a static `HostElement` tree in BFS order into a `CompiledTemplate`. */
  compile(root: HostElement): CompiledTemplate {
    // 1. Pre-order walk to record source-order node & slot indices.
    let preNodes = new GrowableArray<HostElement>();
    let preSlots = new GrowableArray<HostElement>();
    let visitPre = (el: HostElement): void => {
      preNodes.push(el);
      if (el._isSlot) {
        preSlots.push(el);
      }
      for (let child in el._children) {
        visitPre(child);
      }
    };
    visitPre(root);

    // 2. Breadth-first flattening required by `zenafx:host/scene`.
    let order = new GrowableArray<HostElement>();
    let firstChildOf = new GrowableArray<i32>();
    order.push(root);
    var i = 0;
    while (i < order.length) {
      let el = order[i];
      firstChildOf.push(order.length);
      for (let child in el._children) {
        order.push(child);
      }
      i += 1;
    }

    // 3. Build NodeDefs, Bindings, StateStyles, and slot numbering (matching
    //    `scene.rs`: slots are `order[1..]` with `isSlot == true`).
    let nodes = new GrowableArray<NodeDef>();
    let bindings = new GrowableArray<Binding>();
    let states = new GrowableArray<StateStyle>();
    let nodeBindings = new GrowableArray<NodeBindings>();
    let bfsSlotOrder = new GrowableArray<HostElement>();
    var projectionSlot = -1;

    var n = 0;
    while (n < order.length) {
      let el = order[n];
      let def = new NodeDef(
        el._ownBox(),
        el._layout(),
        el._nodeStyle(),
        firstChildOf[n] as u32,
        el._children.length as u32,
        el._isSlot,
        el._cursor,
        el._focusable,
        el._editable,
        el._unselectable,
      );
      nodes.push(def);

      var bContent = -1;
      var bStyle = -1;
      var bBox = -1;
      var bLayout = -1;
      if (el._boundContent) {
        bContent = bindings.length;
        bindings.push(new Binding(n as u32, BindingTarget.Content));
      }
      if (el._boundStyle) {
        bStyle = bindings.length;
        bindings.push(new Binding(n as u32, BindingTarget.Style));
      }
      if (el._boundBox) {
        bBox = bindings.length;
        bindings.push(new Binding(n as u32, BindingTarget.Box));
      }
      if (el._boundLayout) {
        bLayout = bindings.length;
        bindings.push(new Binding(n as u32, BindingTarget.Layout));
      }
      nodeBindings.push(new NodeBindings(bContent, bStyle, bBox, bLayout));

      for (let st in el._states) {
        states.push(new StateStyle(n as u32, st.when, n as u32, st.style));
      }

      if (n > 0 && el._isSlot) {
        let slotIdx = bfsSlotOrder.length;
        bfsSlotOrder.push(el);
        if (el._isProjection) {
          projectionSlot = slotIdx;
        }
      }

      n += 1;
    }

    // 4. Compute pre-order -> BFS lookup maps.
    let preToBfsNode = new GrowableArray<i32>();
    for (let el in preNodes) {
      var found = -1;
      var k = 0;
      while (k < order.length) {
        if (order[k] === el) {
          found = k;
          break;
        }
        k += 1;
      }
      preToBfsNode.push(found);
    }

    let preToBfsSlot = new GrowableArray<i32>();
    for (let el in preSlots) {
      var found = -1;
      var k = 0;
      while (k < bfsSlotOrder.length) {
        if (bfsSlotOrder[k] === el) {
          found = k;
          break;
        }
        k += 1;
      }
      preToBfsSlot.push(found);
    }

    let tpl = new Template(nodes, bindings, states);
    return new CompiledTemplate(
      tpl,
      preToBfsNode,
      preToBfsSlot,
      projectionSlot,
      nodeBindings,
      nodes,
    );
  }
}

export let ui = new UiTag();

var cachedDynamicChildTemplate: CompiledTemplate | null = null;
function dynamicChildTemplate(): CompiledTemplate {
  let existing = cachedDynamicChildTemplate;
  if (existing != null) {
    return existing;
  }
  let compiled = ui.compile(ui.wrapSlot());
  cachedDynamicChildTemplate = compiled;
  return compiled;
}
