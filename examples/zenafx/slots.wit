// Worlds for the slotting example.
//
// Both a root and an embedded widget export `zenafx:host/widget`, so the
// host looks for one thing. A root's `measure` is never called; an embedded
// component's is, while its embedder is suspended inside its own `solve`.
package example:slots@0.1.0;

world page {
  import zenafx:host/text@0.1.0;
  import zenafx:host/layout@0.1.0;
  import zenafx:host/paint@0.1.0;
  import zenafx:host/children@0.1.0;

  export zenafx:host/widget@0.1.0;
}

world widget {
  import zenafx:host/text@0.1.0;
  import zenafx:host/layout@0.1.0;
  import zenafx:host/paint@0.1.0;
  import zenafx:host/children@0.1.0;

  export zenafx:host/widget@0.1.0;
}
