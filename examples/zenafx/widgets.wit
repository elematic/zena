// The world of the widget-composition demo.
//
// One component, several widgets. The host is handed one handle — the root
// — and everything below it composes in Zena. The component installs its
// tree once through `zenafx:host/scene` and is then off the frame path.
package example:widgets@0.1.0;

world app {
  import zenafx:host/scene@0.1.0;

  export zenafx:host/app@0.1.0;
}
