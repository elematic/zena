package example:widgets@0.1.0;

/// One component, several widgets, composed in Zena. `start` hands the host
/// the tree the root widget describes; the host installs it, and nothing
/// calls back in, so the component is off the frame path from then on.
world app {
  import zenafx:host/scene@0.1.0;

  export zenafx:host/app@0.1.0;
}
