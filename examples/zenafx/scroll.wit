package example:scroll@0.1.0;

/// A list that scrolls. Nothing in the world is about scrolling: the host
/// does it, so the component imports the scene and exports its entry, as
/// every ZenaFX component does.
world app {
  import zenafx:host/scene@0.1.0;
  import zenafx:host/style@0.1.0;

  export zenafx:host/app@0.1.0;
}
