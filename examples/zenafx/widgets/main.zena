/**
 * The component's root widget, and the entry point that hands it over.
 *
 * `Root` is a widget like any other: it describes a tree and does nothing
 * else. It installs nothing, learns nothing about being installed, and
 * holds no handle. The host asks for the tree and mounts it.
 */
import { Color, BoxLook, TextLook, Justify, Align } from 'zenafx:ui/style';
import { Node } from 'zenafx:host/scene';
import { Box, Widget, box, full, layoutTree } from './widget.zena';
import { card } from './card.zena';
import { label } from './label.zena';
import { some, none } from 'zena:core';

let page = new Color(0.98, 0.98, 0.99, 1.0);
let ink = new Color(0.10, 0.11, 0.13, 1.0);
let pageLook = new BoxLook(some(page), none, 0.0, 0.0, 1.0);
let bodyLook = new TextLook('system-ui', 20.0, 400 as u16, false, ink);

/**
 * The root of the widget tree. A widget like any other: it describes a
 * tree, and that is the whole of it.
 */
export class Root implements Widget {
  build(): Box {
    return box({look: pageLook, justify: Justify.Center, align: Align.Center,
                width: full, height: full}, [
      card('Card widget — container', [
        label('This is a child widget inside of a slot', bodyLook),
      ]),
    ]);
  }
}

/**
 * What the component draws. Pure: it builds the root widget and hands back
 * the tree it describes. The host installs it.
 */
export function start(): GrowableArray<Node> {
  return layoutTree(new Root());
}
