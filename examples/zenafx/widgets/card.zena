/**
 * A titled panel with a slot for projected children.
 *
 * The card declares where its children go (`Slot {}`) and has no field or
 * method to inspect them: the parent's children project straight through the
 * host into the well.
 */
import {
  ui, Widget, Box, Text, Slot, TemplateResult, Style,
  Color, Align, rgb,
} from '../ui.zena';

let surface = rgb(0.94, 0.96, 0.99);
let edge = rgb(0.68, 0.75, 0.86);
let wellFill = rgb(1.0, 1.0, 1.0);
let wellEdge = rgb(0.78, 0.84, 0.91);

let cardStyle = Style {
  background: surface
  borderColor: edge
  borderWidth: 1.0
  cornerRadius: 12.0
  align: Align.Stretch
  gap: 10.0
  padding: { top: 18.0, x: 22.0, bottom: 22.0 }
};

let wellStyle = Style {
  background: wellFill
  borderColor: wellEdge
  borderWidth: 1.0
  cornerRadius: 8.0
  align: Align.Stretch
  padding: { x: 18.0, y: 16.0 }
};

function titleStyle(accent: Color) {
  return Style { fontSize: 15.0 fontWeight: 600 color: accent };
}

export class Card extends Widget {
  #title: String;
  #accent: Color;

  new(title: String, accent: Color) : #title = title, #accent = accent, super();

  build(): TemplateResult {
    return @ui Box {
      style: cardStyle,

      Text(this.#title) { style: titleStyle(this.#accent) }
      Box {
        style: wellStyle,

        Slot {}
      }
    };
  }
}
