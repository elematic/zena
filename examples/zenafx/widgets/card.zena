/**
 * A titled panel with a hole in it.
 *
 * The card says where its content goes — inside the well, under the title —
 * and never sees what that content is. It has no reference to it, cannot
 * call it, and could not tell a label from a component it has never heard
 * of. The framework puts the children in the slot; one solve then sizes the
 * card around whatever they turned out to be.
 */
import { Color, BoxLook, TextLook, Edges, Align } from 'zenafx:ui/style';
import { Box, Widget, box, slot, text, expand } from './widget.zena';
import { some, none } from 'zena:core';

// Shared by every card, because every card draws them the same way. What
// varies per card lives on the instance instead.
let surface = new Color(0.94, 0.96, 0.99, 1.0);
let edge = new Color(0.68, 0.75, 0.86, 1.0);
/** The well is paler than the card, so the hole reads as a hole. */
let wellFill = new Color(1.0, 1.0, 1.0, 1.0);
let wellEdge = new Color(0.78, 0.84, 0.91, 1.0);

let cardLook = new BoxLook(some(surface), some(edge), 1.0, 12.0, 1.0);
let wellLook = new BoxLook(some(wellFill), some(wellEdge), 1.0, 8.0, 1.0);

export class Card implements Widget {
  #title: String;
  /**
   * The title's colour. On the instance rather than the module, so two
   * cards in one tree can differ.
   */
  #accent: Color;

  new(title: String, accent: Color) : #title = title, #accent = accent;

  build(): Box {
    return box({
      look: cardLook,
      align: Align.Stretch,
      gap: 10.0,
      padding: new Edges(18.0, 22.0, 22.0, 22.0)
    }, [
      text(this.#title, new TextLook('system-ui', 15.0, 600 as u16, false,
                                     this.#accent)),
      slot({
        look: wellLook,
        padding: new Edges(16.0, 18.0, 16.0, 18.0)
      }),
    ]);
  }
}

/** A card wrapped round some content. */
export function card(title: String, accent: Color, children: Array<Box>): Box {
  return expand(new Card(title, accent), children);
}
