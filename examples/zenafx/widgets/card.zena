/**
 * A titled panel with a slot for projected children.
 *
 * The card declares where its children go (`Slot {}`) and has no field or
 * method to inspect them: the parent's children project straight through the
 * host into the well.
 */
import { Color, BoxStyle, TextStyle, Edges, Align } from 'zenafx:ui/style';
import { ui, Widget, Box, Text, Slot, TemplateResult } from '../ui.zena';
import { some } from 'zena:core';

let surface = new Color(0.94, 0.96, 0.99, 1.0);
let edge = new Color(0.68, 0.75, 0.86, 1.0);
let wellFill = new Color(1.0, 1.0, 1.0, 1.0);
let wellEdge = new Color(0.78, 0.84, 0.91, 1.0);

let cardStyle = new BoxStyle(some(surface), some(edge), 1.0, 12.0, 1.0);
let wellStyle = new BoxStyle(some(wellFill), some(wellEdge), 1.0, 8.0, 1.0);
let cardPadding = new Edges(18.0, 22.0, 22.0, 22.0);
let wellPadding = new Edges(16.0, 18.0, 16.0, 18.0);

function titleStyle(accent: Color) {
  return new TextStyle('system-ui', 15.0, 600 as u16, false, accent);
}

export class Card extends Widget {
  #title: String;
  #accent: Color;

  new(title: String, accent: Color) : #title = title, #accent = accent, super();

  build(): TemplateResult {
    return @ui Box {
      style: cardStyle,
      align: Align.Stretch,
      gap: 10.0,
      padding: cardPadding,

      Text(this.#title) { style: titleStyle(this.#accent) }
      Box {
        style: wellStyle,
        align: Align.Stretch,
        padding: wellPadding,

        Slot {}
      }
    };
  }
}
