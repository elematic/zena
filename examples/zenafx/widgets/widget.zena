/**
 * Writing a template readably.
 *
 * A widget's interior is a flat list of nodes, and a flat list with child
 * indices in it is not something to write by hand. So a tree of `Box` is built
 * with nested calls and flattened into the list a template takes.
 *
 * Nothing here is per-instance. A template belongs to a widget *class* — two
 * cards on screen share one and differ only in what they write into its holes —
 * so these are called once, at module level, and never again.
 *
 * What is still written by hand is the binding list, which names holes by their
 * node's index in the flattened tree. That is the fragile part, and it is the
 * part a node block would remove: the grammar in
 * docs/design/zenafx-widget-authoring.md puts the hole where its value is
 * written and leaves the numbering to the compiler.
 */
import { Box as OwnBox, Flex, Flow, Layout, LayoutFlex, LayoutFlow, TextAlign, Edges,
         Axis, Justify, Align, Length, BoxStyle, TextStyle, LengthAuto, LengthPercent,
         Overflow } from 'zenafx:ui/style';
import { NodeDef, Appearance, AppearanceNothing, AppearanceFill, AppearanceText,
         TextContent, Binding, StateStyle, Cursor } from 'zenafx:host/scene';
import { Template } from '../framework.zena';
import { some, none } from 'zena:core';

export let noPadding = new Edges(0.0, 0.0, 0.0, 0.0);
export let full = new LengthPercent(100.0);

/**
 * What every node takes: its own box, and how it answers the pointer and the
 * keyboard.
 *
 * Every field is optional and the defaults are the common case: sized by its
 * content, with no padding. A call site names what it cares about and nothing
 * else.
 */
export type NodeOpts = {
  padding?: Edges,
  width?: Length,
  height?: Length,
  grow?: f32,
  /**
   * How readily the box gives up room it has no space for. 1 unless said
   * otherwise, and 0 for a row of a list, which keeps its height and lets the
   * list scroll.
   */
  shrink?: f32,
  /**
   * What becomes of content that does not fit, sideways and downwards. It is
   * cut off at the box in every case. `Clip`, the default, is for a box whose
   * content is expected to fit. `Hidden` and `Scroll` are for a box meant to
   * hold more than fits, which may then be laid out smaller than its content.
   */
  overflowX?: Overflow,
  overflowY?: Overflow,
  /**
   * The cursor to show while the pointer is over the node, or over anything
   * in it that names none of its own. Left out, the node shows the cursor of
   * whatever it is in.
   */
  cursor?: Cursor,
  /**
   * Whether the node can have the focus: `Tab` stops at it, a press on it
   * gives it the focus, and the keyboard goes to it while it has it.
   */
  focusable?: boolean,
  /**
   * Whether the pointer cannot select the node's text, nor the text of
   * anything in it. All other text can be selected, with no handler. A
   * button leaves its label out.
   */
  unselectable?: boolean,
};

/**
 * A `box`: a node that lays out its children as items in a column or a row.
 * A column packed to the start unless it says otherwise.
 */
export type BoxOpts = {
  ...NodeOpts,
  axis?: Axis,
  justify?: Justify,
  align?: Align,
  gap?: f32,
  style?: BoxStyle,
};

/** A `flow`: a node that lays out its children as text in lines. */
export type FlowOpts = {
  ...NodeOpts,
  /** Where the lines sit across the width. */
  textAlign?: TextAlign,
  /**
   * The distance from one line to the next, as a multiple of the text size.
   * Left out, it is what each font asks for.
   */
  lineHeight?: f32,
  style?: BoxStyle,
};

/** A `text`. */
export type TextOpts = {
  ...NodeOpts,
  /**
   * Whether a person edits the text. For a `text` inside a box that can have
   * the focus, which makes that box a text field: the host keeps a caret and
   * a selection in the text, and the pointer moves both with no handler.
   */
  editable?: boolean,
};

/** A node's own box, with what the options left out filled in. */
export function boxOf(opts: NodeOpts): OwnBox {
  return new OwnBox(
    opts.width ?? new LengthAuto(),
    opts.height ?? new LengthAuto(),
    opts.grow ?? 0.0,
    opts.shrink ?? 1.0,
    opts.padding ?? noPadding,
    opts.overflowX ?? Overflow.Clip,
    opts.overflowY ?? Overflow.Clip,
  );
}

/** How a `box` arranges its children, with what the options left out filled in. */
export function flexOf(opts: BoxOpts): Flex {
  return new Flex(
    opts.axis ?? Axis.Column,
    opts.justify ?? Justify.Start,
    opts.align ?? Align.Start,
    opts.gap ?? 0.0,
  );
}

function fillOf(style: Option<BoxStyle>): Appearance {
  if (let Some {value} = style) {
    return new AppearanceFill(value);
  }
  return new AppearanceNothing();
}

function cursorOf(opts: NodeOpts): Option<Cursor> {
  if (let {cursor} = opts) {
    return some(cursor);
  }
  return none;
}

/** A node of the tree a widget's template describes. */
export class Box {
  /** The node's own box: its size, padding and overflow. */
  ownBox: OwnBox;
  /** How the node lays out its children: as items, or as text in lines. */
  layout: Layout;
  appearance: Appearance;
  children: GrowableArray<Box>;
  /** The cursor the node names, if it names one. */
  cursor: Option<Cursor>;
  /** Whether the node can have the focus. */
  focusable: boolean;
  /** Whether a person edits the node's text. */
  editable: boolean;
  /** Whether the pointer cannot select the text here and beneath. */
  unselectable: boolean;
  /** Whether content hangs here. */
  isSlot: boolean;

  new(this.ownBox, this.layout, this.appearance, this.children, this.cursor,
      this.focusable = false, this.editable = false, this.unselectable = false,
      this.isSlot = false);
}

/** A node with no children has nothing to lay out. */
function noLayout(): Layout {
  return new LayoutFlex(flexOf({}));
}

/**
 * A flow container: its `text` children are laid out together as one piece of
 * text, each in its own style. Lines are broken across all of them, so a word
 * in bold in the middle of a sentence is a `text` of its own and the sentence
 * still wraps as one.
 *
 * It is a box in every other way: it takes a width, padding and a `style`.
 */
export function flow(opts: FlowOpts = {}, children: Array<Box> = []): Box {
  let {focusable = false, unselectable = false} = opts;
  let align = opts.textAlign ?? TextAlign.Start;
  var lineHeight: Option<f32> = none;
  if (let {lineHeight as height} = opts) {
    lineHeight = some(height);
  }
  var style: Option<BoxStyle> = none;
  if (let {style as fill} = opts) {
    style = some(fill);
  }
  return new Box(boxOf(opts), new LayoutFlow(new Flow(align, lineHeight)), fillOf(style),
                 GrowableArray.from(children), cursorOf(opts), focusable, false,
                 unselectable);
}

/** A box. Lays out its children, and draws a panel when given a `style`. */
export function box(opts: BoxOpts = {}, children: Array<Box> = []): Box {
  let {focusable = false, unselectable = false} = opts;
  var style: Option<BoxStyle> = none;
  if (let {style as fill} = opts) {
    style = some(fill);
  }
  return new Box(boxOf(opts), new LayoutFlex(flexOf(opts)), fillOf(style),
                 GrowableArray.from(children), cursorOf(opts), focusable, false,
                 unselectable);
}

/**
 * Where this widget's content hangs. A widget has at most one.
 *
 * A slot is not a box: it contributes no geometry, so what hangs in it lays out
 * as a child of whatever contains the slot. That is what keeps a widget one box
 * instead of two — and it is why a slot takes no options. To give the content a
 * panel of its own, put the slot inside a `box` and style that.
 */
export function slot(): Box {
  return new Box(boxOf({}), noLayout(), new AppearanceNothing(), new GrowableArray<Box>(),
                 none, false, false, false, true);
}

/**
 * Text. The host shapes it and keeps the result for as long as the node lives,
 * so nothing here handles a shaped run.
 *
 * In a template the content is usually a placeholder, because a hole supplies
 * it: what differs between two instances of a widget belongs in a hole and not
 * in the template they share.
 */
export function text(content: String, style: TextStyle, opts: TextOpts = {}): Box {
  let {focusable = false, editable = false, unselectable = false} = opts;
  return new Box(boxOf(opts), noLayout(),
                 new AppearanceText(new TextContent(content, style)),
                 new GrowableArray<Box>(), cursorOf(opts), focusable, editable,
                 unselectable);
}

/**
 * Flatten a box tree into the node list a template takes.
 *
 * Breadth first, because the host wants a node's children contiguous and after
 * it, and pre-order only manages that when no child except the last has children
 * of its own. Node 0 is the widget's own box.
 */
export function flatten(root: Box): Array<NodeDef> {
  let order = new GrowableArray<Box>();
  let firstChildOf = new GrowableArray<i32>();
  order.push(root);
  var i = 0;
  while (i < order.length) {
    let node = order[i];
    firstChildOf.push(order.length);
    for (let child in node.children) {
      order.push(child);
    }
    i += 1;
  }

  let nodes = new GrowableArray<NodeDef>();
  var n = 0;
  while (n < order.length) {
    let node = order[n];
    nodes.push(new NodeDef(node.ownBox, node.layout, node.appearance,
                           firstChildOf[n] as u32, node.children.length as u32,
                           node.isSlot, node.cursor, node.focusable, node.editable,
                           node.unselectable));
    n += 1;
  }
  return nodes;
}

/**
 * A template: a box tree, where its holes are, and how its nodes look while
 * the pointer is over them or pressing them.
 */
export function template(root: Box, bindings: Array<Binding>,
                         states: Array<StateStyle> = []): Template {
  return new Template(flatten(root), bindings, states);
}
