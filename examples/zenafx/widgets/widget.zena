/**
 * Writing a template readably.
 *
 * A widget's interior is a flat list of nodes, and a flat list with child
 * indices in it is not something to write by hand. So a tree of `Box` is built
 * with nested calls and flattened into the list a template takes.
 *
 * Nothing here is per-instance. A template belongs to a widget *class* — two
 * cards on screen share one and differ only in what they write into its holes —
 * so these are called once, at module level, and never again.
 *
 * What is still written by hand is the binding list, which names holes by their
 * node's index in the flattened tree. That is the fragile part, and it is the
 * part a node block would remove: the grammar in
 * docs/design/zenafx-widget-authoring.md puts the hole where its value is
 * written and leaves the numbering to the compiler.
 */
import { Flex, Edges, Axis, Justify, Align, Length, BoxStyle, TextStyle,
         LengthAuto, LengthPercent } from 'zenafx:ui/style';
import { NodeDef, Appearance, AppearanceNothing, AppearanceFill, AppearanceText,
         TextContent, Binding } from 'zenafx:host/scene';
import { Template } from '../framework.zena';

export let noPadding = new Edges(0.0, 0.0, 0.0, 0.0);
export let full = new LengthPercent(100.0);

/**
 * How a box lays out and how it looks.
 *
 * Every field is optional and the defaults are the common case: a column,
 * packed to the start, sized by its content, drawing nothing. A call site names
 * what it cares about and nothing else.
 */
export type BoxOpts = {
  axis?: Axis,
  justify?: Justify,
  align?: Align,
  gap?: f32,
  padding?: Edges,
  width?: Length,
  height?: Length,
  grow?: f32,
  style?: BoxStyle,
};

/** Read the options, filling in what was left out. */
let flexOf = (opts: BoxOpts): Flex => new Flex(
  opts.axis ?? Axis.Column,
  opts.justify ?? Justify.Start,
  opts.align ?? Align.Start,
  opts.gap ?? 0.0,
  opts.padding ?? noPadding,
  opts.width ?? new LengthAuto(),
  opts.height ?? new LengthAuto(),
  opts.grow ?? 0.0,
  1.0,
);

let appearanceOf = (opts: BoxOpts): Appearance => {
  if (let {style} = opts) {
    return new AppearanceFill(style);
  }
  return new AppearanceNothing();
};

/** A node of the tree a widget's template describes. */
export class Box {
  layout: Flex;
  appearance: Appearance;
  children: GrowableArray<Box>;
  /** Whether content hangs here. */
  isSlot: boolean;

  new(this.layout, this.appearance, this.children, this.isSlot = false);
}

/** A box. Lays out its children, and draws a panel when given a `style`. */
export function box(opts: BoxOpts = {}, children: Array<Box> = []): Box {
  return new Box(flexOf(opts), appearanceOf(opts), GrowableArray.from(children));
}

/**
 * Where this widget's content hangs. A widget has at most one.
 *
 * A slot is not a box: it contributes no geometry, so what hangs in it lays out
 * as a child of whatever contains the slot. That is what keeps a widget one box
 * instead of two — and it is why a slot takes no options. To give the content a
 * panel of its own, put the slot inside a `box` and style that.
 */
export function slot(): Box {
  return new Box(flexOf({}), new AppearanceNothing(), new GrowableArray<Box>(), true);
}

/**
 * Text. The host shapes it and keeps the result for as long as the node lives,
 * so nothing here handles a shaped run.
 *
 * In a template the content is usually a placeholder, because a hole supplies
 * it: what differs between two instances of a widget belongs in a hole and not
 * in the template they share.
 */
export function text(content: String, style: TextStyle, opts: BoxOpts = {}): Box {
  return new Box(flexOf(opts), new AppearanceText(new TextContent(content, style)),
                 new GrowableArray<Box>());
}

/**
 * Flatten a box tree into the node list a template takes.
 *
 * Breadth first, because the host wants a node's children contiguous and after
 * it, and pre-order only manages that when no child except the last has children
 * of its own. Node 0 is the widget's own box.
 */
export function flatten(root: Box): Array<NodeDef> {
  let order = new GrowableArray<Box>();
  let firstChildOf = new GrowableArray<i32>();
  order.push(root);
  var i = 0;
  while (i < order.length) {
    let node = order[i];
    firstChildOf.push(order.length);
    for (let child in node.children) {
      order.push(child);
    }
    i += 1;
  }

  let nodes = new GrowableArray<NodeDef>();
  var n = 0;
  while (n < order.length) {
    let node = order[n];
    nodes.push(new NodeDef(node.layout, node.appearance, firstChildOf[n] as u32,
                           node.children.length as u32, node.isSlot));
    n += 1;
  }
  return nodes;
}

/** A template: a box tree, and where its holes are. */
export function template(root: Box, bindings: Array<Binding>): Template {
  return new Template(flatten(root), bindings);
}
