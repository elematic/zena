// A line of text.
import { TextLook } from 'zenafx:ui/style';
import { Box, Widget, text } from './widget.zena';

export class Label implements Widget {
  #text: String;
  #look: TextLook;

  new(text: String, look: TextLook) : #text = text, #look = look;

  build(): Box {
    return text(this.#text, this.#look);
  }
}

/** A label, as a tree. A leaf, so it takes no children. */
export function label(content: String, look: TextLook): Box {
  return new Label(content, look).build();
}
