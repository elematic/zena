// A line of text.
//
// Two fields, one method, no state that outlives a frame. The host shapes
// the text and keeps the run for as long as the node lives.
import { TextLook, Axis, Justify, Align } from 'zenafx:ui/style';
import { Box, Widget, text, stack, noPadding } from './widget.zena';

export class Label implements Widget {
  #text: String;
  #look: TextLook;

  new(text: String, look: TextLook) : #text = text, #look = look;

  build(): Box {
    return text(stack(Axis.Column, Justify.Start, Align.Start, 0.0, noPadding),
                this.#text, this.#look);
  }
}
