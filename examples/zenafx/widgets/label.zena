/**
 * A line of text: one node, which is its own box, with one-shot content and
 * style bindings.
 */
import { TextStyle } from 'zenafx:ui/style';
import { ui, Widget, Text, TemplateResult } from '../ui.zena';

export class Label extends Widget {
  #text: String;
  #style: TextStyle;

  new(content: String, style: TextStyle) : #text = content, #style = style, super();

  build(): TemplateResult {
    return @ui Text(this.#text) { style: this.#style };
  }
}
