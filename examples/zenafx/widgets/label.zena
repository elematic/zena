/**
 * A line of text: one node, which is its own box, with one-shot content and
 * style bindings.
 */
import { ui, Widget, Text, TemplateResult, StyleInput } from '../ui.zena';

export class Label extends Widget {
  #text: String;
  #style: StyleInput;

  new(content: String, style: StyleInput) : #text = content, #style = style, super();

  build(): TemplateResult {
    return @ui Text(this.#text) { style: this.#style };
  }
}
