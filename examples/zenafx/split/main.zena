/**
 * Two panels and a divider between them that the pointer drags.
 *
 * The divider hears the press and captures the pointer. Captured moves travel
 * to the split, which updates the reactive left-panel width (sending a single
 * `box` hole per move). Divider hover/press styling runs in the platform style
 * engine without waking the component.
 */
import {
  ui, Widget, Box, Text, TemplateResult, Answer,
  Style, When, hovered, pressed,
  Axis, Align, Overflow, Cursor,
  rgb, px, full, runApp,
} from '../ui.zena';
import { signal } from 'zena:signals';

let ink = rgb(0.10, 0.11, 0.13);
let leftFill = rgb(0.95, 0.96, 0.99);
let rightFill = rgb(1.0, 1.0, 1.0);
let rule = rgb(0.80, 0.83, 0.89);
let ruleHovered = rgb(0.45, 0.58, 0.95);
let ruleHeld = rgb(0.20, 0.38, 0.86);

let dividerWidth: f32 = 8.0;
let narrowest: f32 = 120.0;

let splitStyle = Style {
  axis: Axis.Row
  align: Align.Stretch
  width: full
  height: full
};

let leftBaseStyle = Style {
  background: leftFill
  padding: { all: 20.0 }
  height: full
  overflow: Overflow.Hidden
};

function leftPanelStyle(width: f32) {
  return Style {
    ...leftBaseStyle
    width: px(width)
  };
}

let dividerStyle = Style {
  background: rule
  width: px(dividerWidth)
  height: full
  shrink: 0.0
  cursor: Cursor.ColResize

  When(hovered) { background: ruleHovered }
  When(pressed) { background: ruleHeld }
};

let rightStyle = Style {
  background: rightFill
  padding: { all: 20.0 }
  width: px(narrowest)
  height: full
  grow: 1.0
  shrink: 0.0
  overflow: Overflow.Hidden
};

let labelStyle = Style { fontSize: 16.0 fontWeight: 500 color: ink };

class Split extends Widget {
  @signal var #left: f32 = 240.0;
  var #held: f32 = 0.0;

  build(): TemplateResult {
    return @ui Box {
      style: splitStyle,
      onCapturedMove: (event) => {
        this.#moveTo(event.x - this.#held);
      },

      Box {
        style: $(leftPanelStyle(this.#left)),
        Text('Left') { style: labelStyle }
      }
      Box {
        style: dividerStyle,
        onPointerDown: (event) => {
          this.#held = event.x;
          return Answer.Capture;
        }
      }
      Box {
        style: rightStyle,
        Text('Right') { style: labelStyle }
      }
    };
  }

  #moveTo(left: f32): void {
    this.#left = if (left < narrowest) { narrowest } else { left };
  }
}

export function main(): void {
  runApp(new Split());
}
