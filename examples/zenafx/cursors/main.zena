/**
 * Every cursor, each over a tile of its own.
 *
 * A node names the cursor to show while the pointer is over it, as one of
 * CSS's `cursor` keywords. The platform draws the cursor: the host tells the
 * window which of the platform's cursors to show when the node under the
 * pointer changes, and no handler here hears the pointer at all.
 *
 * The page is one template. Its tiles are made in a loop, one for each
 * keyword, in the order the interface lists them.
 */
import { Color, BoxStyle, TextStyle, Edges, Axis, Justify, Align, LengthPx } from 'zenafx:ui/style';
import { StateStyle, State, RestyleFill, Cursor } from 'zenafx:host/scene';
import { Rendering, Widget, Template, shows, runApp } from '../framework.zena';
import { Box, box, text, full, flatten } from '../widgets/widget.zena';
import { some, none } from 'zena:core';
import { div } from 'zena:math';

let page = new Color(0.97, 0.97, 0.98, 1.0);
let ink = new Color(0.10, 0.11, 0.13, 1.0);
let paper = new Color(1.0, 1.0, 1.0, 1.0);
let edge = new Color(0.80, 0.83, 0.89, 1.0);
let lit = new Color(0.92, 0.95, 1.0, 1.0);

let pageStyle = new BoxStyle(some(page), none, 0.0, 0.0, 1.0);
let tileStyle = new BoxStyle(some(paper), some(edge), 1.0, 6.0, 1.0);
let hoveredStyle = new BoxStyle(some(lit), some(edge), 1.0, 6.0, 1.0);
let titleText = new TextStyle('system-ui', 20.0, 700 as u16, false, ink);
let nameText = new TextStyle('system-ui', 13.0, 500 as u16, false, ink);

/** A cursor and the keyword CSS has for it. */
class Kind(name: String, cursor: Cursor) {}

/** Every cursor, in the order the interface lists them. */
let kinds = [
  new Kind('default', Cursor.Default),
  new Kind('context-menu', Cursor.ContextMenu),
  new Kind('help', Cursor.Help),
  new Kind('pointer', Cursor.Pointer),
  new Kind('progress', Cursor.Progress),
  new Kind('wait', Cursor.Wait),
  new Kind('cell', Cursor.Cell),
  new Kind('crosshair', Cursor.Crosshair),
  new Kind('text', Cursor.Text),
  new Kind('vertical-text', Cursor.VerticalText),
  new Kind('alias', Cursor.Alias),
  new Kind('copy', Cursor.Copy),
  new Kind('move', Cursor.Move),
  new Kind('no-drop', Cursor.NoDrop),
  new Kind('not-allowed', Cursor.NotAllowed),
  new Kind('grab', Cursor.Grab),
  new Kind('grabbing', Cursor.Grabbing),
  new Kind('e-resize', Cursor.EResize),
  new Kind('n-resize', Cursor.NResize),
  new Kind('ne-resize', Cursor.NeResize),
  new Kind('nw-resize', Cursor.NwResize),
  new Kind('s-resize', Cursor.SResize),
  new Kind('se-resize', Cursor.SeResize),
  new Kind('sw-resize', Cursor.SwResize),
  new Kind('w-resize', Cursor.WResize),
  new Kind('ew-resize', Cursor.EwResize),
  new Kind('ns-resize', Cursor.NsResize),
  new Kind('nesw-resize', Cursor.NeswResize),
  new Kind('nwse-resize', Cursor.NwseResize),
  new Kind('col-resize', Cursor.ColResize),
  new Kind('row-resize', Cursor.RowResize),
  new Kind('all-scroll', Cursor.AllScroll),
  new Kind('zoom-in', Cursor.ZoomIn),
  new Kind('zoom-out', Cursor.ZoomOut),
];

/** How many tiles go in a row. */
let across = 6;

/** A tile: a box that names one cursor, and says which. */
function tile(kind: Kind) {
  return box({style: tileStyle, justify: Justify.Center, align: Align.Center,
              width: new LengthPx(112.0), height: new LengthPx(52.0),
              cursor: kind.cursor}, [
    text(kind.name, nameText),
  ]);
}

/** The page's box tree: a title, and under it the tiles in rows. */
function pageOf() {
  let lines = new GrowableArray<Box>();
  lines.push(text('Cursors', titleText));
  var row = new GrowableArray<Box>();
  for (let kind in kinds) {
    row.push(tile(kind));
    if (row.length == across) {
      lines.push(box({axis: Axis.Row, gap: 8.0}, row));
      row = new GrowableArray<Box>();
    }
  }
  if (row.length > 0) {
    lines.push(box({axis: Axis.Row, gap: 8.0}, row));
  }
  return box({style: pageStyle, justify: Justify.Center, align: Align.Center, gap: 8.0,
              padding: new Edges(16.0, 16.0, 16.0, 16.0), width: full, height: full}, lines);
}

/**
 * A look for each tile while the pointer is over it, so the tile under the
 * pointer can be seen as well as its cursor.
 *
 * A template's nodes are listed level by level: the page, then the title and
 * the rows, then every tile, then every tile's name. So the tiles start after
 * the page, the title and the rows.
 */
function looksOf(): Array<StateStyle> {
  let rows = div(kinds.length + across - 1, across);
  let first = 2 + rows;
  let looks = new GrowableArray<StateStyle>();
  for (let index in 0..kinds.length) {
    let at = (first + index) as u32;
    looks.push(new StateStyle(at, State.Hovered, at, new RestyleFill(hoveredStyle)));
  }
  return looks;
}

let pageTemplate = new Template(flatten(pageOf()), [], looksOf());

class Page extends Widget {
  build(): Rendering {
    return shows(pageTemplate, []);
  }
}

/** The component's entry: build the widget tree and show it. */
export function main(): void {
  runApp(new Page());
}
