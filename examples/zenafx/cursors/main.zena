/**
 * Every cursor, each over a tile of its own.
 *
 * A node names the cursor to show while the pointer is over it, as one of
 * CSS's `cursor` keywords. The platform draws the cursor, and hover styling
 * runs entirely in the platform style engine (`zenafx:host/style`).
 */
import {
  ui, Widget, Box, Text, TemplateResult,
  Style, When, hovered,
  Axis, Justify, Align, Cursor,
  rgb, px, full, runApp,
} from '../ui.zena';

let pageBg = rgb(0.97, 0.97, 0.98);
let ink = rgb(0.10, 0.11, 0.13);
let paper = rgb(1.0, 1.0, 1.0);
let edge = rgb(0.80, 0.83, 0.89);
let lit = rgb(0.92, 0.95, 1.0);

let pageStyle = Style {
  background: pageBg
  justify: Justify.Center
  align: Align.Center
  gap: 8.0
  padding: { all: 16.0 }
  width: full
  height: full
};

let rowStyle = Style {
  axis: Axis.Row
  gap: 8.0
};

let titleStyle = Style { fontSize: 20.0 fontWeight: 700 color: ink };
let nameStyle = Style { fontSize: 13.0 fontWeight: 500 color: ink };

let baseTileStyle = Style {
  background: paper
  borderColor: edge
  borderWidth: 1.0
  cornerRadius: 6.0
  justify: Justify.Center
  align: Align.Center
  width: px(112.0)
  height: px(52.0)

  When(hovered) { background: lit }
};

function tileStyle(cursor: Cursor) {
  return Style {
    ...baseTileStyle
    cursor: cursor
  };
}

/** A cursor and the keyword CSS has for it. */
class Kind(name: String, cursor: Cursor) {}

/** Every cursor, in the order the interface lists them. */
let kinds = [
  new Kind('default', Cursor.Default),
  new Kind('context-menu', Cursor.ContextMenu),
  new Kind('help', Cursor.Help),
  new Kind('pointer', Cursor.Pointer),
  new Kind('progress', Cursor.Progress),
  new Kind('wait', Cursor.Wait),
  new Kind('cell', Cursor.Cell),
  new Kind('crosshair', Cursor.Crosshair),
  new Kind('text', Cursor.Text),
  new Kind('vertical-text', Cursor.VerticalText),
  new Kind('alias', Cursor.Alias),
  new Kind('copy', Cursor.Copy),
  new Kind('move', Cursor.Move),
  new Kind('no-drop', Cursor.NoDrop),
  new Kind('not-allowed', Cursor.NotAllowed),
  new Kind('grab', Cursor.Grab),
  new Kind('grabbing', Cursor.Grabbing),
  new Kind('e-resize', Cursor.EResize),
  new Kind('n-resize', Cursor.NResize),
  new Kind('ne-resize', Cursor.NeResize),
  new Kind('nw-resize', Cursor.NwResize),
  new Kind('s-resize', Cursor.SResize),
  new Kind('se-resize', Cursor.SeResize),
  new Kind('sw-resize', Cursor.SwResize),
  new Kind('w-resize', Cursor.WResize),
  new Kind('ew-resize', Cursor.EwResize),
  new Kind('ns-resize', Cursor.NsResize),
  new Kind('nesw-resize', Cursor.NeswResize),
  new Kind('nwse-resize', Cursor.NwseResize),
  new Kind('col-resize', Cursor.ColResize),
  new Kind('row-resize', Cursor.RowResize),
  new Kind('all-scroll', Cursor.AllScroll),
  new Kind('zoom-in', Cursor.ZoomIn),
  new Kind('zoom-out', Cursor.ZoomOut),
];

/** How many tiles go in a row. */
let across = 6;

class Tile extends Widget {
  #kind: Kind;

  new(kind: Kind) : #kind = kind, super();

  build(): TemplateResult {
    return @ui Box {
      style: tileStyle(this.#kind.cursor),
      Text(this.#kind.name) { style: nameStyle }
    };
  }
}

class Row extends Widget {
  #tiles: Array<Widget>;

  new(tiles: Array<Widget>) : #tiles = tiles, super();

  build(): TemplateResult {
    return @ui Box {
      style: rowStyle,
      $(this.#tiles)
    };
  }
}

function buildRows(): Array<Widget> {
  let rows = new GrowableArray<Widget>();
  var current = new GrowableArray<Widget>();
  for (let kind in kinds) {
    current.push(new Tile(kind));
    if (current.length == across) {
      rows.push(new Row(current));
      current = new GrowableArray<Widget>();
    }
  }
  if (current.length > 0) {
    rows.push(new Row(current));
  }
  return rows;
}

class Page extends Widget {
  build(): TemplateResult {
    let rows = buildRows();
    return @ui Box {
      style: pageStyle,
      Text('Cursors') { style: titleStyle }
      $(rows)
    };
  }
}

export function main(): void {
  runApp(new Page());
}
