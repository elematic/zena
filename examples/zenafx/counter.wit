package example:counter@0.1.0;

/// One template, instantiated twice, each instance written on its own timer.
///
/// `main` registers the template, instantiates it per counter, installs the
/// tree and starts each counter's loop. It is an ordinary synchronous Zena
/// function; `async func` here is about the lift, which is what can report
/// WAIT and so the only way the host learns to re-enter and run a `sleep`'s
/// continuation.
///
/// The clock is `wasi:clocks`, which `zena:time`'s `sleep` parks on. ZenaFX
/// declares no timer interface of its own.
world app {
  import zenafx:host/scene@0.1.0;
  import wasi:clocks/monotonic-clock@0.3.0;

  export zenafx:host/app@0.1.0;
}
