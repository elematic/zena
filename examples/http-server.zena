/**
 * Example HTTP server application in Zena.
 *
 * Demonstrates:
 * - App and middleware composition (logging, error handling)
 * - Router with static routes and param matching (:name)
 * - Safe HTML rendering and streaming with the `html` template tag
 * - Running an HTTP server accessible via browser or curl
 *
 * Run with:
 *   ./target/release/zena-cli run examples/http-server.zena
 */

import { App, Router, HttpError, html, HTMLPartial, TemplateValue } from 'zena:http';

let page = (title: String, body: HTMLPartial) => html`
  <!doctype html>
  <html>
    <head>
      <meta charset="utf-8">
      <title>${title}</title>
    </head>
    <body>
      ${body}
    </body>
  </html>
`;

export function main(): void {
  let app = new App();
  let router = new Router();

  // 1. Logging middleware
  app.use(async (req, res, next) => {
    let path = req.path;
    await next();
    console.log(`${req.method} ${path} -> ${res.statusCode}`);
  });

  // 2. Define routes
  router.get('/', async (req, res, next, params) => {
    let links = ['/greet/world', '/greet/Zena', '/secret'];
    res.body = page('Zena HTTP Server', html`
      <h1>Welcome to the Zena HTTP server!</h1>
      <p>Try visiting:</p>
      <ul>
        ${links.map<TemplateValue>((href) =>
          html`<li><a href="${href}">${href}</a></li>`
        )}
      </ul>
    `);
  });

  router.get('/greet/:name', async (req, res, next, params) => {
    let name = params.getOr('name', 'friend');
    res.body = page(`Hello, ${name}!`, html`
      <h1>Hello, ${name}!</h1>
      <p><a href="/">Back to home</a></p>
    `);
  });

  router.get('/secret', async (req, res, next, params) => {
    throw new HttpError(403, 'Forbidden: VIP access only');
  });

  app.use(router.routes());

  // 3. Start the server
  console.log('=== Zena HTTP Server ===');
  console.log('Available routes:');
  console.log('  GET  http://127.0.0.1:8080/');
  console.log('  GET  http://127.0.0.1:8080/greet/:name');
  console.log('  GET  http://127.0.0.1:8080/secret');
  console.log('');

  app.listen(8080 as u16);
}

