/**
 * WASI HTTP 0.3 Service Component Example.
 *
 * Demonstrates exporting wasi:http/handler@0.3.0 from a Zena application:
 * the component's `handle` owns each request the host hands it and
 * passes it through the app's middleware.
 *
 * For self-hosted servers running under zena-cli, use
 * examples/http-server.zena instead.
 *
 * Build with:
 *   ./target/release/zena-cli build examples/wasi-http-server.zena --target component \
 *     --wit examples/wasi-http-server.wit --world wasi-http-server -o examples/wasi-http-server.wasm
 *
 * Serve with:
 *   wasmtime serve -W gc=y,function-references=y,exceptions=y -S p3=y -S http=y -S cli=y \
 *     --addr 127.0.0.1:8080 examples/wasi-http-server.wasm
 * then try:
 *   curl http://127.0.0.1:8080/greet/zena
 */

import { App, Router, handleWireRequest } from 'zena:http';
import { Request as WireRequest, Response as WireResponse, ErrorCode } from 'wasi:http/types';
import { Own, Result } from 'zena:core';

function createApp() {
  let app = new App();
  let router = new Router();

  // Logging middleware. `next` takes the request on to the rest of the
  // pipeline, so what the log line needs is read first.
  app.use(async (req, res, next) => {
    let method = req.method;
    let path = req.path;
    await next(req);
    console.log(`${method} ${path} -> ${res.statusCode}`);
  });

  router.get('/', async (req, res, next, params) => {
    res.type = 'text/plain; charset=utf-8';
    res.body = 'Hello from Zena WASI HTTP service!';
  });

  router.get('/greet/:name', async (req, res, next, params) => {
    let name = params.getOr('name', 'stranger');
    res.type = 'text/plain; charset=utf-8';
    res.body = `Hello, ${name}! Welcome to WebAssembly GC on WASI 0.3 HTTP.\n`;
  });

  app.use(router.routes());
  return app;
}

let app = createApp();

export async function handle(request: Own<WireRequest>): Future<Result<Own<WireResponse>, ErrorCode>> {
  return await handleWireRequest(app, request);
}
