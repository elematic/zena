import { console } from 'zena:console';
import { readFile, getPreopens } from 'zena:fs';

let main = (): i32 => {
  let preopens = getPreopens();
  
  if (preopens.length > 0) {
    console.log("Found preopened directories.");
  }

  console.log("Attempting to read a file from the repository root (relative to '.')");
  let readme = readFile("README.md");
  console.log("Read README.md successfully.");

  console.log("Attempting to read a file from the mapped '/stdlib' preopen");
  let fsZena = readFile("/stdlib/fs.zena");
  console.log("Read /stdlib/fs.zena successfully.");

  return 0;
};