import { App, Router } from 'zena:http';

export async function main(): Future<void> {
  let app1 = new App();
  let router1 = new Router();
  router1.get('/', async (req, res, next, params) => {
    res.type = 'text/plain; charset=utf-8';
    res.body = 'Response from Server 1 on port 8081\n';
  });
  app1.use(router1.routes());

  let app2 = new App();
  let router2 = new Router();
  router2.get('/', async (req, res, next, params) => {
    res.type = 'text/plain; charset=utf-8';
    res.body = 'Response from Server 2 on port 8082\n';
  });
  app2.use(router2.routes());

  console.log('Starting multi-server...');
  let s1 = await app1.listen(8081 as u16);
  console.log(`Server 1 listening on http://127.0.0.1:${s1.port}`);
  let s2 = await app2.listen(8082 as u16);
  console.log(`Server 2 listening on http://127.0.0.1:${s2.port}`);
}
