// A fixed array literal of three numbers, summed by a for-in loop.
// One step up from minimal.zena: this one genuinely needs an array
// type, its iterator, and `Iterable`/`Iterator` dispatch — so it is
// the smallest program that exercises generic specialization end to
// end. `binary-size_test.zena` holds it to a byte budget; see
// docs/design/binary-size.md.
export function main(): i32 {
  let xs = [1, 2, 3];
  var total = 0;
  for (let x in xs) {
    total += x;
  }
  return total;
}
