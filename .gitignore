node_modules/
.wireit/
_site/
# nix build outputs
/result
/.direnv/
/target

.DS_Store
.zena/
.nix-env.rc

# Real-world WIT corpus for packages/wit-parser: third-party, fetched not
# vendored (pinned by packages/wit-parser/wit-corpus.json). Nix users get it
# via ZENA_WASI_WIT instead and never create this.
packages/wit-parser/.wit-corpus/
packages/wit-parser/.wit-corpus.tmp-*/


# benchmark results are per-machine artifacts, not repo content
benchmarks/*.results.json
# scripts/mem-bench.sh output: compiler copies, their caches and logs
perf-out/

# precompiled module caches for benchmark milestones
benchmarks/**/*.cwasm

# wasmtime's AOT cache beside the bootstrap, written on first debug run
packages/zena-compiler/bootstrap/*.cwasm
packages/zena-compiler/bootstrap/*.lock

# differential-test corpora and one-off build outputs
/scratch/
*.__runner__.zena
/*.wasm
examples/*.wasm
# the spike's fixtures, compiled by hand (docs/design/runtime-components.md)
packages/zena-runtime/examples/components-spike/out/

# zb build state
.zb/

# Built by `npm run build:examples -w @zena-lang/zenafx`.
packages/zenafx/out/

# Written by the Firebase emulators (npm run emulators:start).
firebase-debug.log
firestore-debug.log
