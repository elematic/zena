#!/usr/bin/env node
/**
 * Claude Code PostToolUse hook for Edit and Write: runs prettier on the file
 * the tool changed, when it is a kind CI's Format job checks, so an edit
 * cannot leave a file that fails that job. A file prettier cannot parse is
 * reported back to the agent (exit 2) and left as it was.
 *
 * `.claude/settings.json` runs it for sessions started in this repository.
 * Sessions started in a parent directory do not read that file; a user-level
 * hook can run this one for them (docs/agents/README.md, "Hooks").
 */

import {spawnSync} from 'node:child_process';
import {existsSync, readFileSync} from 'node:fs';
import {dirname, relative, resolve} from 'node:path';
import {fileURLToPath} from 'node:url';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '../..');
const input = JSON.parse(readFileSync(0, 'utf8'));
const file = input.tool_input?.file_path;

const inRepo = (path) => {
  const rel = relative(root, path);
  return rel !== '' && !rel.startsWith('..');
};

if (
  typeof file === 'string' &&
  /\.(cjs|html|js|json|md|ts)$/.test(file) &&
  inRepo(resolve(file)) &&
  existsSync(file)
) {
  const prettier = resolve(root, 'node_modules/.bin/prettier');
  if (existsSync(prettier)) {
    const result = spawnSync(prettier, ['--write', '--log-level=warn', file], {
      cwd: root,
      encoding: 'utf8',
    });
    if (result.status !== 0) {
      process.stderr.write(
        `prettier could not format ${file}:\n${result.stderr}`,
      );
      process.exit(2);
    }
  }
}
