if [ -f .nix-env.rc ]; then
  source .nix-env.rc
else
  use flake
fi

if [ "$ANTIGRAVITY_AGENT" = "1" ]; then
  export CARGO_HOME=$(dirname "$PWD")/.cargo
  unset NIX_SSL_CERT_FILE
fi

export ZENA_PROJECT_CACHE=1
export PATH=$HOME/.nix-profile/bin:$PATH

# Preserve IDE terminal sandbox proxy and cert configuration. Only a
# variable that is set is exported: exporting an unset one defines it as
# empty, and OpenSSL and libcurl read an empty SSL_CERT_FILE or
# CURL_CA_BUNDLE as a file to load, so every HTTPS certificate check
# (git push, gh, cargo) fails.
for name in HTTP_PROXY HTTPS_PROXY http_proxy https_proxy SSL_CERT_FILE CURL_CA_BUNDLE; do
  if [ -n "${!name}" ]; then
    export "$name"
  fi
done
if [ -n "$SSL_CERT_FILE" ]; then
  export CARGO_HTTP_CAINFO=$SSL_CERT_FILE
fi
